import Submission.IntegerCutCertificates

/-! Exact prefix obstruction for one particular coefficient list.
This does not establish a global bound on Newman factors. -/
namespace Erdos406NineteenPrefix
open Erdos406IntegerCuts
set_option maxRecDepth 100000
set_option maxHeartbeats 0
def coefficients : Array ℤ := #[1, 0, -1, 0, 2, -1, -1, 1, 2, -1, -2, 2, 1, -2, 0, 0, 1, -1, 0, 1]
def tri (i j : Fin 64) : ℤ :=
  if j.val ≤ i.val then coefficients.getD (i.val - j.val) 0 else 0

def matrix (i : Fin 256) (j : Fin 64) : ℤ :=
  if h : i.val < 64 then tri ⟨i.val, h⟩ j
  else if h : i.val < 128 then -tri ⟨i.val - 64, by omega⟩ j
  else if i.val < 192 then (if j.val = i.val - 128 then 1 else 0)
  else (if j.val = i.val - 192 then -1 else 0)

def state0 (i : Fin 256) : ℤ :=
  if i.val < 64 then 1
  else if i.val < 128 then (if i.val = 64 then -1 else 0)
  else 28

def rows0 (i : Fin 1) : Fin 256 := ⟨(#[0] : Array ℕ).getD i.val 0 % 256, Nat.mod_lt _ (by decide)⟩
def weights0 (i : Fin 1) : ℤ := (#[4294967296] : Array ℤ).getD i.val 0
def state1 : Fin 256 → ℤ := Function.update state0 128 (1)
lemma step0 (r : Fin 64 → ℤ) (h : Valid matrix state0 r) :
    Valid matrix state1 r := by
  exact selected_cut_update matrix state0 rows0 weights0 r 128 4294967296 (1)
    (by decide +kernel) (by decide) (by decide +kernel) (by decide +kernel) h

