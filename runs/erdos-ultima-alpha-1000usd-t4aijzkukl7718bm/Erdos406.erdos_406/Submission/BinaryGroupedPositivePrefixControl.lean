def finishCheck (p : Fin 812) : Bool :=
  if carry p ∈ ([0,1,3,4] : List ℕ) ∧ F (source p) then
    decide (finish p ∈ ends p ∧ F (finish p) ∧ H p (finish p) ≤ 6000000)
  else true

