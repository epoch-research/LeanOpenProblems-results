lemma cheap_family_run (k : ℕ) :
    Run D D.start (Nat.digits 2 (7*2^(k+7))).reverse 42
      ((314799/500000:ℝ)*k+3390093/500000) ∧ F 42 := by
  have hword : (Nat.digits 2 (7*2^(k+7))).reverse =
      1::1::1::List.replicate (k+7) 0 := by
    have hh := Nat.digits_base_pow_mul (b:=2) (k:=k+7) (m:=7) (by decide) (by decide)
    have hr := congrArg List.reverse hh
    simpa [Nat.mul_comm,Nat.digits_of_two_le_of_pos] using hr
  have hrep : List.replicate (k+7) (0:ℕ) = List.replicate 7 0 ++ List.replicate k 0 := by
    rw [show k+7=7+k by omega,List.replicate_add]
  rw [hrep] at hword
  refine ⟨?_,by decide +kernel⟩
  rw [hword]
  have hr := (Run.cons (by decide : (1:Fin 72) ∈ D.next 0 1) (Run.cons (by decide : (3:Fin 72) ∈ D.next 1 1) (Run.cons (by decide : (9:Fin 72) ∈ D.next 3 1) (Run.cons (by decide : (24:Fin 72) ∈ D.next 9 0) (Run.cons (by decide : (48:Fin 72) ∈ D.next 24 0) (Run.cons (by decide : (19:Fin 72) ∈ D.next 48 0) (Run.cons (by decide : (42:Fin 72) ∈ D.next 19 0) (Run.cons (by decide : (42:Fin 72) ∈ D.next 42 0) (Run.cons (by decide : (42:Fin 72) ∈ D.next 42 0) (Run.cons (by decide : (42:Fin 72) ∈ D.next 42 0) (cheap_zeros k)))))))))))
  convert hr using 1
  have hh := cheap_prefix_weight
  linarith

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "/tmp/Erdos406GroupedControlLeanProgress.txt" "CONTROL_PROGRESS no_global_same_slope_lower"
lemma no_global_same_slope_lower : ¬ ∃ B : ℝ, ∀ n : ℕ, 0<n →
    ∀ t v, Run D D.start (Nat.digits 2 n).reverse t v → F t →
      (1888797/3000000:ℝ)*(Nat.digits 2 n).length-B ≤ v := by
  rintro ⟨B,hB⟩
  obtain ⟨k,hk⟩ := exists_nat_gt (1000000*(B+100))
  obtain ⟨hr,hf⟩ := cheap_family_run k
  have hh := hB (7*2^(k+7)) (by positivity) 42 _ hr hf
  have hlen : (Nat.digits 2 (7*2^(k+7))).length = k+10 := by
    have he := Nat.digits_base_pow_mul (b:=2) (k:=k+7) (m:=7) (by decide) (by decide)
    have hl := congrArg List.length he
    simpa [Nat.mul_comm,Nat.digits_of_two_le_of_pos,Nat.add_assoc] using hl
  rw [hlen] at hh
  push_cast at hh
  nlinarith

end
