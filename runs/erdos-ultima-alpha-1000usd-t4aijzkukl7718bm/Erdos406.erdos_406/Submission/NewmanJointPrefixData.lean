theorem saved_polynomial_not_dvd (c : Case) (hcase : c ∈ cases)
    (P : ℤ[X]) (hP : Binary P) (hP0 : P.coeff 0 = 1) : ¬ listPoly c.q ∣ P := by
  have hh := List.all_eq_true.mp table_checked c hcase
  have hc : Good c := by simpa using hh
  exact listPoly_exclude_of_empty_frontier c.q c.stages.length hc.1 hc.2.1
    (frontier_empty_of_follows _ _ _ hc.2.2) P hP hP0

/-- The same certificate excludes any polynomial with the same checked
windows at its two ends, whatever its middle coefficients and degree are. -/
theorem saved_end_pattern_not_dvd (c : Case) (hcase : c ∈ cases)
    (Q : ℤ[X]) (hq : ∀ i ≤ c.stages.length, Q.coeff i = c.q.getD i 0)
    (ha : ∀ i ≤ c.stages.length, Q.reverse.coeff i = c.q.reverse.getD i 0)
    (P : ℤ[X]) (hP : Binary P) (hP0 : P.coeff 0 = 1) : ¬ Q ∣ P := by
  have hh := List.all_eq_true.mp table_checked c hcase
  have hc : Good c := by simpa using hh
  have hlen : 0 < c.q.length := by
    by_contra hn
    have hz : c.q = [] := List.length_eq_zero_iff.mp (by omega)
    have hfirst := hc.1
    simp [hz] at hfirst
  apply exclude_of_empty_frontier c.q c.q.reverse c.stages.length hc.1 _
    (frontier_empty_of_follows _ _ _ hc.2.2) Q hq ha P hP hP0
  rw [List.getD_reverse 0 hlen]
  simpa using hc.2.1

