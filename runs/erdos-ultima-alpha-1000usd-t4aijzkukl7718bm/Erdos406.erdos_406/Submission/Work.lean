import FormalConjecturesUtil

/-! Elementary reductions for Erdős Problem 406; not a solution. -/

namespace Erdos406Work

lemma even_exponent {k : ℕ} (h : Nat.digits 3 (2 ^ k) ⊆ [0, 1]) : Even k := by
  have hpos : 0 < 2 ^ k := by positivity
  rw [Nat.digits_of_two_le_of_pos (by decide : 2 ≤ 3) hpos] at h
  have hmod : 2 ^ k % 3 = 0 ∨ 2 ^ k % 3 = 1 := by
    simpa using h (by simp : 2 ^ k % 3 ∈ (2 ^ k % 3 :: Nat.digits 3 (2 ^ k / 3)))
  rcases Nat.even_or_odd k with hk | ⟨j, rfl⟩
  · exact hk
  · simp [pow_add, pow_mul, Nat.mul_mod, Nat.pow_mod] at hmod

lemma finite_iff_exponent_cutoff :
    {n : ℕ | n.isPowerOfTwo ∧ Nat.digits 3 n ⊆ [0, 1]}.Finite ↔
      ∃ K : ℕ, ∀ k, K ≤ k → ¬ Nat.digits 3 (2 ^ k) ⊆ [0, 1] := by
  constructor
  · intro h
    obtain ⟨B, hB⟩ := h.bddAbove
    refine ⟨B + 1, ?_⟩
    intro k hk hd
    have hb : 2 ^ k ≤ B := hB ⟨⟨k, rfl⟩, hd⟩
    have hp : k < 2 ^ k := Nat.lt_two_pow_self
    omega
  · rintro ⟨K, hK⟩
    apply Set.finite_iff_bddAbove.mpr
    refine ⟨2 ^ K, ?_⟩
    rintro n ⟨⟨k, rfl⟩, hd⟩
    have hk : k < K := by
      by_contra hk
      exact hK k (by omega) hd
    exact Nat.pow_le_pow_right (by decide) (by omega)

lemma known_examples :
    ∀ n ∈ ([1, 4, 256] : List ℕ), n.isPowerOfTwo ∧ Nat.digits 3 n ⊆ [0, 1] := by
  intro n hn
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hn
  rcases hn with rfl | rfl | rfl
  · exact ⟨⟨0, rfl⟩, by norm_num [Nat.digits_of_two_le_of_pos]⟩
  · exact ⟨⟨2, rfl⟩, by norm_num [Nat.digits_of_two_le_of_pos]⟩
  · exact ⟨⟨8, rfl⟩, by norm_num [Nat.digits_of_two_le_of_pos]⟩

/-- No fixed number of low ternary digits suffices to bound the exponent. -/
lemma arbitrarily_large_good_tails (r M : ℕ) :
    ∃ k : ℕ, M ≤ k ∧ Nat.digits 3 (2 ^ k % 3 ^ (r + 1)) ⊆ [0, 1] := by
  have hmodulus : 1 < 3 ^ (r + 1) := by
    have hp : 0 < 3 ^ r := by positivity
    rw [pow_succ]
    omega
  have ht : 0 < (3 ^ (r + 1)).totient := Nat.totient_pos.mpr (by omega)
  refine ⟨(3 ^ (r + 1)).totient * (M + 1), by nlinarith, ?_⟩
  have hc : Nat.Coprime 2 (3 ^ (r + 1)) :=
    (by decide : Nat.Coprime 2 3).pow_right (r + 1)
  have hm := (Nat.ModEq.pow_totient hc).pow (M + 1)
  rw [← pow_mul, one_pow] at hm
  change 2 ^ ((3 ^ (r + 1)).totient * (M + 1)) % 3 ^ (r + 1) =
    1 % 3 ^ (r + 1) at hm
  rw [Nat.mod_eq_of_lt hmodulus] at hm
  rw [hm]
  norm_num [Nat.digits_of_two_le_of_pos]

/-- A counterexample to the proposed bound `v₂(P(3)) ≤ degree(P) + 1`
for digit polynomials with `P(-1) ≠ 0`. This does not refute Erdős's conjecture. -/
lemma valuation_bound_counterexample :
    Nat.digits 3 127204851712 ⊆ [0, 1] ∧
    (Nat.digits 3 127204851712).length = 24 ∧
    Nat.ofDigits (-1 : ℤ) (Nat.digits 3 127204851712) = -4 ∧
    (127204851712 : ℕ) = 2 ^ 25 * 3791 ∧ Odd (3791 : ℕ) := by
  norm_num [Nat.digits_of_two_le_of_pos, Nat.ofDigits]

/-- The exact order of `4` modulo a power of `3`, expressed as divisibility. -/
lemma four_pow_mod_eq_one_iff (r m : ℕ) :
    Nat.ModEq (3 ^ (r + 1)) (4 ^ m) 1 ↔ 3 ^ r ∣ m := by
  by_cases hm : m = 0
  · simp [hm, Nat.ModEq]
  have hp : 1 < 4 ^ m := one_lt_pow₀ (by decide) hm
  have hv : padicValNat 3 (4 ^ m - 1) = 1 + padicValNat 3 m := by
    simpa using padicValNat.pow_sub_pow (p := 3) (x := 4) (y := 1)
      (by decide) (by decide) (by decide) (by decide) hm
  rw [Nat.ModEq.comm, Nat.modEq_iff_dvd' (by omega : 1 ≤ 4 ^ m),
    padicValNat_dvd_iff_le (by omega : 4 ^ m - 1 ≠ 0),
    padicValNat_dvd_iff_le hm, hv]
  omega

lemma four_pow_mod_injective_le {r a b : ℕ} (_ha : a < 3 ^ r) (hb : b < 3 ^ r)
    (hle : a ≤ b) (h : 4 ^ a % 3 ^ (r + 1) = 4 ^ b % 3 ^ (r + 1)) : a = b := by
  obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le hle
  have hc : Nat.Coprime (3 ^ (r + 1)) (4 ^ a) :=
    ((by decide : Nat.Coprime 3 4).pow_left (r + 1)).pow_right a
  have hh : Nat.ModEq (3 ^ (r + 1)) (4 ^ a * 1) (4 ^ a * 4 ^ t) := by
    simpa only [mul_one, ← pow_add] using h
  have hd : 3 ^ r ∣ t :=
    (four_pow_mod_eq_one_iff r t).mp (hh.cancel_left_of_coprime hc).symm
  have ht : t = 0 := by
    by_contra ht
    have := Nat.le_of_dvd (by omega : 0 < t) hd
    omega
  omega

lemma four_pow_mod_injective {r a b : ℕ} (ha : a < 3 ^ r) (hb : b < 3 ^ r)
    (h : 4 ^ a % 3 ^ (r + 1) = 4 ^ b % 3 ^ (r + 1)) : a = b := by
  rcases le_total a b with hab | hba
  · exact four_pow_mod_injective_le ha hb hab h
  · exact (four_pow_mod_injective_le hb ha hba h.symm).symm

/-- A fixed-length ternary prefix, padded with zeroes. -/
def ternaryPrefix (r n : ℕ) : List ℕ :=
  (Nat.digits 3 n).take r ++ List.replicate (r - ((Nat.digits 3 n).take r).length) 0

lemma ternaryPrefix_length (r n : ℕ) : (ternaryPrefix r n).length = r := by
  have hh := List.length_take_le r (Nat.digits 3 n)
  simp only [ternaryPrefix, List.length_append, List.length_replicate]
  omega

lemma ternaryPrefix_lt_two {r n : ℕ} (h : Nat.digits 3 n ⊆ [0, 1]) :
    ∀ d ∈ ternaryPrefix r n, d < 2 := by
  intro d hd
  simp only [ternaryPrefix, List.mem_append, List.mem_replicate] at hd
  rcases hd with hd | ⟨_, rfl⟩
  · have hh := h (List.mem_of_mem_take hd)
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hh
    omega
  · decide

lemma ofDigits_ternaryPrefix (r n : ℕ) :
    Nat.ofDigits 3 (ternaryPrefix r n) = n % 3 ^ r := by
  rw [ternaryPrefix, Nat.ofDigits_append_replicate_zero,
    ← Nat.self_mod_pow_eq_ofDigits_take r n (by decide : 2 ≤ 3)]

lemma four_pow_eq_one_add (n : ℕ) : 4 ^ n = 1 + 3 * (4 ^ n / 3) := by
  have hm : 4 ^ n % 3 = 1 := by rw [Nat.pow_mod]; norm_num
  have hh := Nat.mod_add_div (4 ^ n) 3
  omega

/-- A sublinear counting bound, which is weaker than the desired finiteness. -/
lemma good_four_powers_card_le (r : ℕ) :
    ((Finset.range (3 ^ r)).filter (fun n => Nat.digits 3 (4 ^ n) ⊆ [0, 1])).card ≤ 2 ^ r := by
  classical
  calc
    _ ≤ (List.fixedLengthDigits (b := 2) (by decide) r).card := by
      apply Finset.card_le_card_of_injOn (fun n => ternaryPrefix r (4 ^ n / 3))
      · intro n hn
        simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hn
        have hd := hn.2
        rw [Nat.digits_of_two_le_of_pos (by decide : 2 ≤ 3)
          (by positivity : 0 < 4 ^ n)] at hd
        have hdt : Nat.digits 3 (4 ^ n / 3) ⊆ [0, 1] := by
          intro d hd'
          exact hd (List.mem_cons_of_mem _ hd')
        apply (List.mem_fixedLengthDigits_iff (by decide : 1 < 2)).mpr
        exact ⟨ternaryPrefix_length _ _, ternaryPrefix_lt_two hdt⟩
      · intro a ha b hb hab
        simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at ha hb
        have ham := ha.1
        have hbm := hb.1
        have hm := congrArg (Nat.ofDigits 3) hab
        rw [ofDigits_ternaryPrefix, ofDigits_ternaryPrefix] at hm
        change Nat.ModEq (3 ^ r) (4 ^ a / 3) (4 ^ b / 3) at hm
        have hh := (hm.mul_left' 3).add_left 1
        rw [← four_pow_eq_one_add, ← four_pow_eq_one_add, ← pow_succ'] at hh
        exact four_pow_mod_injective ham hbm hh
    _ = 2 ^ r := List.card_fixedLengthDigits (by decide) r

/-- Among the first `2 * 3^r` exponents, at most `2^r` can satisfy the conjecture's
ternary digit condition. This estimate still allows an infinite set of exponents. -/
lemma good_two_powers_card_le (r : ℕ) :
    ((Finset.range (2 * 3 ^ r)).filter (fun k => Nat.digits 3 (2 ^ k) ⊆ [0, 1])).card ≤
      2 ^ r := by
  classical
  calc
    _ ≤ ((Finset.range (3 ^ r)).filter (fun n => Nat.digits 3 (4 ^ n) ⊆ [0, 1])).card := by
      apply Finset.card_le_card_of_injOn (fun k => k / 2)
      · intro k hk
        simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hk ⊢
        obtain ⟨m, hm⟩ := even_exponent hk.2
        have hdiv : k / 2 = m := by omega
        have hpow : 4 ^ (k / 2) = 2 ^ k := by
          rw [hdiv, show k = 2 * m by omega, pow_mul]
          norm_num
        exact ⟨by omega, by simpa only [hpow] using hk.2⟩
      · intro a ha b hb hab
        simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at ha hb
        obtain ⟨i, hi⟩ := even_exponent ha.2
        obtain ⟨j, hj⟩ := even_exponent hb.2
        change a / 2 = b / 2 at hab
        omega
    _ ≤ 2 ^ r := good_four_powers_card_le r

/-- The value of a ternary digit string over `{0,1}` is less than half the next
power of `3`. -/
lemma twice_ofDigits_lt {L : List ℕ} (h : ∀ d ∈ L, d < 2) :
    2 * Nat.ofDigits 3 L < 3 ^ L.length := by
  induction L with
  | nil => norm_num [Nat.ofDigits]
  | cons d L ih =>
    have hd : d < 2 := h d (by simp)
    have ht : ∀ e ∈ L, e < 2 := fun e he => h e (by simp [he])
    have hh := ih ht
    simp only [Nat.ofDigits_cons, List.length_cons, pow_succ]
    omega

/-- The digit restriction is equivalent to having no carries in the ternary addition `n+n`. -/
lemma digits_iff_no_carries (n : ℕ) :
    Nat.digits 3 n ⊆ [0, 1] ↔ ∀ r : ℕ, 2 * (n % 3 ^ r) < 3 ^ r := by
  constructor
  · intro h r
    have hh := twice_ofDigits_lt (ternaryPrefix_lt_two (r := r) h)
    rwa [ternaryPrefix_length, ofDigits_ternaryPrefix] at hh
  · intro h
    induction n using Nat.strong_induction_on with
    | h n ih =>
      by_cases hn : n = 0
      · simp [hn]
      rw [Nat.digits_of_two_le_of_pos (by decide : 2 ≤ 3) (by omega : 0 < n)]
      have hr : n % 3 = 0 ∨ n % 3 = 1 := by
        have hh := h 1
        norm_num at hh
        omega
      have ht : Nat.digits 3 (n / 3) ⊆ [0, 1] := by
        apply ih (n / 3) (Nat.div_lt_self (by omega) (by decide))
        intro r
        have hh := h (r + 1)
        rw [pow_succ', Nat.mod_mul] at hh
        omega
      intro d hd
      rcases List.mem_cons.mp hd with rfl | hd
      · simpa using hr
      · exact ht hd

/-- A Kummer-theoretic reformulation of the digit condition. -/
lemma digits_iff_centralBinom_not_dvd (n : ℕ) :
    Nat.digits 3 n ⊆ [0, 1] ↔ ¬ 3 ∣ n.centralBinom := by
  rw [digits_iff_no_carries]
  have hz : (¬ 3 ∣ n.centralBinom) ↔ padicValNat 3 n.centralBinom = 0 := by
    rw [dvd_iff_padicValNat_ne_zero (Nat.centralBinom_ne_zero n), not_not]
  rw [hz]
  have hc := padicValNat_choose' (p := 3) (n := n) (k := n)
    (Nat.lt_succ_self (Nat.log 3 (n + n)))
  change padicValNat 3 ((n + n).choose n) = _ at hc
  have he : (n + n).choose n = n.centralBinom := by
    simp only [Nat.centralBinom, two_mul]
  rw [he] at hc
  rw [hc, Finset.card_eq_zero]
  constructor
  · intro h
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro r hr
    have hh := (Finset.mem_filter.mp hr).2
    have hb := h r
    omega
  · intro h r
    by_cases hr : r = 0
    · norm_num [hr, Nat.mod_one]
    by_cases hb : r < Nat.log 3 (n + n) + 1
    · have hn : r ∉ (Finset.Ico 1 (Nat.log 3 (n + n) + 1)).filter
          (fun i => 3 ^ i ≤ n % 3 ^ i + n % 3 ^ i) := by rw [h]; simp
      simp only [Finset.mem_filter, Finset.mem_Ico] at hn
      omega
    · have hp : n + n < 3 ^ r :=
        Nat.lt_pow_of_log_lt (by decide : 1 < 3) (by omega)
      have hm := Nat.mod_le n (3 ^ r)
      omega

/-- The original finiteness question is equivalent to eventual divisibility of central
binomial coefficients evaluated at powers of two. -/
lemma finite_iff_centralBinom_cutoff :
    {n : ℕ | n.isPowerOfTwo ∧ Nat.digits 3 n ⊆ [0, 1]}.Finite ↔
      ∃ K : ℕ, ∀ k, K ≤ k → 3 ∣ (2 ^ k).centralBinom := by
  rw [finite_iff_exponent_cutoff]
  simp only [digits_iff_centralBinom_not_dvd, not_not]

/-- The integer quotient `(2^(3^s)+1)/3^(s+1)`, given recursively. -/
def quotientSeq : ℕ → ℤ
  | 0 => 1
  | s + 1 => quotientSeq s - 3 ^ (s + 1) * quotientSeq s ^ 2 +
      3 ^ (2 * s + 1) * quotientSeq s ^ 3

lemma quotientSeq_identity (s : ℕ) :
    (2 : ℤ) ^ (3 ^ s) + 1 = 3 ^ (s + 1) * quotientSeq s := by
  induction s with
  | zero => norm_num [quotientSeq]
  | succ s ih =>
    have hp : (3 : ℤ) ^ (2 * s + 1) = 3 * (3 ^ s) ^ 2 := by
      rw [show 2 * s + 1 = s + s + 1 by omega, pow_succ, pow_add]
      ring
    have he : (2 : ℤ) ^ (3 ^ (s + 1)) = ((2 : ℤ) ^ (3 ^ s)) ^ 3 := by
      rw [Nat.pow_succ, pow_mul]
    have ha : (2 : ℤ) ^ (3 ^ s) = 3 ^ (s + 1) * quotientSeq s - 1 := by omega
    rw [he, ha, quotientSeq, hp]
    simp only [pow_succ]
    ring

lemma quotientSeq_mod_stable (s : ℕ) : quotientSeq (s + 4) % 243 = 154 := by
  induction s with
  | zero => norm_num [quotientSeq]
  | succ s ih =>
    have h1 : (3 : ℤ) ^ (s + 4 + 1) % 243 = 0 := by
      apply Int.emod_eq_zero_of_dvd
      change (3 : ℤ) ^ 5 ∣ 3 ^ (s + 4 + 1)
      exact pow_dvd_pow 3 (by omega)
    have h2 : (3 : ℤ) ^ (2 * (s + 4) + 1) % 243 = 0 := by
      apply Int.emod_eq_zero_of_dvd
      change (3 : ℤ) ^ 5 ∣ 3 ^ (2 * (s + 4) + 1)
      exact pow_dvd_pow 3 (by omega)
    rw [show s + 1 + 4 = (s + 4) + 1 by omega, quotientSeq]
    simp only [Int.add_emod, Int.sub_emod, Int.mul_emod, Int.emod_emod, h1, h2, ih, zero_mul, Int.zero_emod, sub_zero, add_zero]
    norm_num

lemma not_digits_of_quotient {n t : ℕ} {q : ℤ}
    (hrel : (2 : ℤ) * n + 1 = 3 ^ (t + 1) * q) (hq : q % 243 = 154) :
    ¬ Nat.digits 3 n ⊆ [0, 1] := by
  intro hd
  let M := 3 ^ (t + 1) * 243
  have hp : 0 < 3 ^ (t + 1) := by positivity
  have hs : Nat.ModEq M (2 * n + 1) (3 ^ (t + 1) * 154) := by
    apply Int.natCast_modEq_iff.mp
    have hqi : Int.ModEq 243 q 154 := by
      change q % 243 = 154 % 243
      norm_num
      exact hq
    have hh : Int.ModEq ((3 : ℤ) ^ (t + 1) * 243)
        ((3 : ℤ) ^ (t + 1) * q) ((3 : ℤ) ^ (t + 1) * 154) := hqi.mul_left'
    rw [← hrel] at hh
    simpa [M] using hh
  have hm : 3 ^ (t + 6) = M := by
    dsimp [M]
    rw [show t + 6 = t + 1 + 5 by omega, pow_add]
    norm_num
  have hu := (digits_iff_no_carries n).mp hd (t + 6)
  rw [hm] at hu
  have hnu : Nat.ModEq M (n % M) n := Nat.mod_modEq n M
  have hh := ((hnu.mul_left 2).add_right 1).trans hs
  change (2 * (n % M) + 1) % M = (3 ^ (t + 1) * 154) % M at hh
  have hrhs : 3 ^ (t + 1) * 154 < M := by dsimp [M]; omega
  rw [Nat.mod_eq_of_lt hrhs] at hh
  by_cases hlt : 2 * (n % M) + 1 < M
  · rw [Nat.mod_eq_of_lt hlt] at hh
    omega
  · have he : 2 * (n % M) + 1 = M := by omega
    rw [he, Nat.mod_self] at hh
    omega

lemma power_family_bad (s : ℕ) :
    ¬ Nat.digits 3 (2 ^ (3 ^ (s + 4) - 1)) ⊆ [0, 1] := by
  apply not_digits_of_quotient (t := s + 4) (q := quotientSeq (s + 4))
  · have hp : 0 < 3 ^ (s + 4) := by positivity
    have he : (2 : ℤ) * 2 ^ (3 ^ (s + 4) - 1) = 2 ^ (3 ^ (s + 4)) := by
      rw [← pow_succ']
      congr 1
      omega
    push_cast
    rw [he]
    exact quotientSeq_identity (s + 4)
  · exact quotientSeq_mod_stable s

/-- Within the infinite family of exponents `3^s-1`, exactly `s=0,1,2` work.
This does not show that all solutions belong to this family. -/
lemma power_family_good_iff (s : ℕ) :
    Nat.digits 3 (2 ^ (3 ^ s - 1)) ⊆ [0, 1] ↔ s ≤ 2 := by
  by_cases hs : s < 4
  · interval_cases s <;> norm_num [Nat.digits_of_two_le_of_pos]
  · have he : s - 4 + 4 = s := by omega
    have hb := power_family_bad (s - 4)
    rw [he] at hb
    exact iff_of_false hb (by omega)

/-- A counterexample to unrestricted cubic descent. It is not a counterexample to Erdős 406. -/
lemma cubic_descent_counterexample :
    Nat.digits 3 (4 * 871070230939 ^ 3) ⊆ [0, 1] ∧
    ¬ Nat.digits 3 871070230939 ⊆ [0, 1] := by
  decide +kernel

set_option maxHeartbeats 2000000 in
set_option maxRecDepth 4096 in
/-- Evenness of the root alone does not repair the unrestricted cubic descent claim. -/
lemma even_cubic_descent_counterexample :
    let a : ℕ := 871070230939 * (3 ^ 80 + 1)
    Even a ∧ Nat.digits 3 (4 * a ^ 3) ⊆ [0, 1] ∧ ¬ Nat.digits 3 a ⊆ [0, 1] := by
  decide +kernel


/-- `(4^(3^s)-1)/3^(s+1)`, defined without division. -/
def positiveQuotientSeq : ℕ → ℕ
  | 0 => 1
  | s + 1 => positiveQuotientSeq s + 3 ^ (s + 1) * positiveQuotientSeq s ^ 2 +
      3 ^ (2 * s + 1) * positiveQuotientSeq s ^ 3

lemma positiveQuotientSeq_identity (s : ℕ) :
    4 ^ (3 ^ s) = 1 + 3 ^ (s + 1) * positiveQuotientSeq s := by
  induction s with
  | zero => norm_num [positiveQuotientSeq]
  | succ s ih =>
    have hp : (3 : ℕ) ^ (2 * s + 1) = 3 * (3 ^ s) ^ 2 := by
      rw [show 2 * s + 1 = s + s + 1 by omega, pow_succ, pow_add]
      ring
    rw [Nat.pow_succ, pow_mul, ih, positiveQuotientSeq, hp]
    simp only [pow_succ]
    ring

lemma positiveQuotientSeq_mod_stable (s : ℕ) :
    positiveQuotientSeq (s + 1) % 9 = 7 := by
  induction s with
  | zero => norm_num [positiveQuotientSeq]
  | succ s ih =>
    have h1 : (3 : ℕ) ^ (s + 1 + 1) % 9 = 0 := by
      apply Nat.mod_eq_zero_of_dvd
      change (3 : ℕ) ^ 2 ∣ 3 ^ (s + 1 + 1)
      exact pow_dvd_pow 3 (by omega)
    have h2 : (3 : ℕ) ^ (2 * (s + 1) + 1) % 9 = 0 := by
      apply Nat.mod_eq_zero_of_dvd
      change (3 : ℕ) ^ 2 ∣ 3 ^ (2 * (s + 1) + 1)
      exact pow_dvd_pow 3 (by omega)
    rw [positiveQuotientSeq]
    simp only [Nat.add_mod, Nat.mul_mod, Nat.mod_mod, h1, h2, ih,
      zero_mul, Nat.zero_mod, add_zero]

lemma positive_power_family_bad (s : ℕ) :
    ¬ Nat.digits 3 (4 ^ (3 ^ (s + 1))) ⊆ [0, 1] := by
  intro hd
  let A := 3 ^ (s + 2)
  have hp : 0 < A := by dsimp [A]; positivity
  have hm : 3 ^ (s + 4) = A * 9 := by
    dsimp [A]
    rw [show s + 4 = (s + 2) + 2 by omega, pow_add]
    norm_num
  have hrel : Nat.ModEq (A * 9) (4 ^ (3 ^ (s + 1))) (1 + A * 7) := by
    have hq : Nat.ModEq 9 (positiveQuotientSeq (s + 1)) 7 := by
      change positiveQuotientSeq (s + 1) % 9 = 7 % 9
      exact positiveQuotientSeq_mod_stable s
    have hh := (hq.mul_left' A).add_left 1
    rw [positiveQuotientSeq_identity]
    exact hh
  have hlt : 1 + A * 7 < A * 9 := by omega
  have he : 4 ^ (3 ^ (s + 1)) % (A * 9) = 1 + A * 7 := by
    change 4 ^ (3 ^ (s + 1)) % (A * 9) = (1 + A * 7) % (A * 9) at hrel
    rwa [Nat.mod_eq_of_lt hlt] at hrel
  have hu := (digits_iff_no_carries _).mp hd (s + 4)
  rw [hm, he] at hu
  omega

lemma positive_power_family_good_iff (s : ℕ) :
    Nat.digits 3 (2 ^ (2 * 3 ^ s)) ⊆ [0, 1] ↔ s = 0 := by
  rw [pow_mul]
  change Nat.digits 3 (4 ^ (3 ^ s)) ⊆ [0, 1] ↔ s = 0
  cases s with
  | zero => norm_num [Nat.digits_of_two_le_of_pos]
  | succ s => exact iff_of_false (positive_power_family_bad s) (by omega)



lemma ternary_digit_bound {n : ℕ} (h : Nat.digits 3 n ⊆ [0, 1]) (r : ℕ) :
    n / 3 ^ r % 3 ≤ 1 := by
  have hh := (digits_iff_no_carries n).mp h (r + 1)
  rw [pow_succ, Nat.mod_mul] at hh
  have hp : 0 < 3 ^ r := by positivity
  by_contra hn
  have h2 : 2 ≤ n / 3 ^ r % 3 := by omega
  have hm := Nat.mul_le_mul_left (3 ^ r) h2
  omega

/-- Three ternary `{0,1}` integers coprime to three cannot form a nonconstant
geometric progression. -/
lemma good_units_threeGPFree :
    ThreeGPFree {n : ℕ | n % 3 = 1 ∧ Nat.digits 3 n ⊆ [0, 1]} := by
  intro a ha b hb c hc heq
  have hprecision : ∀ r : ℕ,
      a % 3 ^ (r + 1) = b % 3 ^ (r + 1) ∧
      c % 3 ^ (r + 1) = b % 3 ^ (r + 1) := by
    intro r
    induction r with
    | zero => simpa using And.intro (ha.1.trans hb.1.symm) (hc.1.trans hb.1.symm)
    | succ r ih =>
      let A := 3 ^ (r + 1)
      let q := b % A
      have hp : 0 < A := by dsimp [A]; positivity
      have hA3 : A % 3 = 0 := by
        dsimp [A]
        rw [pow_succ]
        simp
      have hq3 : q % 3 = 1 := by
        dsimp [q]
        rw [Nat.mod_mod_of_dvd b (Nat.dvd_of_mod_eq_zero hA3)]
        exact hb.1
      have haeq : a = q + A * (a / A) := by
        change a = b % A + A * (a / A)
        rw [← ih.1]
        exact (Nat.mod_add_div a A).symm
      have hbeq : b = q + A * (b / A) := (Nat.mod_add_div b A).symm
      have hceq : c = q + A * (c / A) := by
        change c = b % A + A * (c / A)
        rw [← ih.2]
        exact (Nat.mod_add_div c A).symm
      have hlarge :
          A * (q * (a / A + c / A) + A * (a / A * (c / A))) =
          A * (q * (b / A + b / A) + A * (b / A * (b / A))) := by
        conv_lhs at heq => rw [haeq, hceq]
        conv_rhs at heq => rw [hbeq]
        nlinarith only [heq]
      have hsmall := Nat.eq_of_mul_eq_mul_left hp hlarge
      have hm := congrArg (fun x : ℕ => x % 3) hsmall
      simp only [Nat.add_mod, Nat.mul_mod, hq3, hA3, zero_mul, one_mul,
        Nat.zero_mod, add_zero, Nat.mod_mod] at hm
      simp only [Nat.mod_mod] at hm
      have hab := ternary_digit_bound ha.2 (r + 1)
      have hbb := ternary_digit_bound hb.2 (r + 1)
      have hcb := ternary_digit_bound hc.2 (r + 1)
      change a / A % 3 ≤ 1 at hab
      change b / A % 3 ≤ 1 at hbb
      change c / A % 3 ≤ 1 at hcb
      rw [Nat.mod_eq_of_lt (by omega : a / A % 3 + c / A % 3 < 3),
        Nat.mod_eq_of_lt (by omega : b / A % 3 + b / A % 3 < 3)] at hm
      have hda : a / A % 3 = b / A % 3 := by omega
      have hdc : c / A % 3 = b / A % 3 := by omega
      change a % (A * 3) = b % (A * 3) ∧ c % (A * 3) = b % (A * 3)
      simp only [Nat.mod_mul, hda, hdc]
      exact ⟨by rw [ih.1], by rw [ih.2]⟩
  have hp : a + b + 1 < 3 ^ (a + b + 1) := Nat.lt_pow_self (by decide)
  have hh := (hprecision (a + b)).1
  rw [Nat.mod_eq_of_lt (by omega : a < 3 ^ (a + b + 1)),
    Nat.mod_eq_of_lt (by omega : b < 3 ^ (a + b + 1))] at hh
  exact hh

lemma good_exponents_threeAPFree :
    ThreeAPFree {k : ℕ | Nat.digits 3 (2 ^ k) ⊆ [0, 1]} := by
  intro a ha b hb c hc habc
  have hunit {k : ℕ} (hk : Nat.digits 3 (2 ^ k) ⊆ [0, 1]) : 2 ^ k % 3 = 1 := by
    obtain ⟨m, rfl⟩ := even_exponent hk
    rw [← two_mul, pow_mul]
    norm_num [Nat.pow_mod]
  have heq : 2 ^ a * 2 ^ c = 2 ^ b * 2 ^ b := by
    rw [← pow_add, ← pow_add, habc]
  have hh := good_units_threeGPFree ⟨hunit ha, ha⟩ ⟨hunit hb, hb⟩ ⟨hunit hc, hc⟩ heq
  exact (pow_right_injective₀ (by decide : (0 : ℕ) < 2) (by decide : (2 : ℕ) ≠ 1)) hh



lemma irrational_log_two_div_log_three :
    Irrational (Real.log 2 / Real.log 3) := by
  rintro ⟨q, hq⟩
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hqp : (0 : ℚ) < q := by
    have hh : (0 : ℝ) < q := by rw [hq]; positivity
    exact_mod_cast hh
  have hqn : 0 ≤ q.num := le_of_lt (Rat.num_pos.mpr hqp)
  have hqd : (0 : ℝ) < q.den := by exact_mod_cast q.den_pos
  have hrel : (q.den : ℝ) * Real.log 2 = (q.num : ℝ) * Real.log 3 := by
    rw [Rat.cast_def] at hq
    field_simp at hq
    nlinarith
  have hn : (q.num.natAbs : ℝ) = (q.num : ℝ) := by
    simpa only [Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg hqn)
  have he : (2 : ℝ) ^ q.den = (3 : ℝ) ^ q.num.natAbs := by
    apply Real.log_injOn_pos (show 0 < (2 : ℝ) ^ q.den by positivity)
      (show 0 < (3 : ℝ) ^ q.num.natAbs by positivity)
    rw [Real.log_pow, Real.log_pow, hn]
    exact hrel
  have hen : (2 : ℕ) ^ q.den = (3 : ℕ) ^ q.num.natAbs := by exact_mod_cast he
  have hmod := congrArg (fun n : ℕ => n % 2) hen
  simp [Nat.pow_mod, q.den_ne_zero] at hmod

lemma small_fract_arbitrarily_late {α ε : ℝ} (hα : Irrational α)
    (hε : 0 < ε) (hε1 : ε ≤ 1) (M : ℕ) :
    ∃ n : ℕ, M ≤ n ∧ 0 < Int.fract (n * α) ∧ Int.fract (n * α) < ε := by
  let a : AddCircle (1 : ℝ) := α
  have hdZ : DenseRange (fun n : ℤ => n • a) := by
    apply AddCircle.denseRange_zsmul_coe_iff.mpr
    simpa using hα
  have hdN : DenseRange (fun n : ℕ => n • a) := denseRange_zsmul_iff_nsmul.mp hdZ
  let H := Homeomorph.addRight (M • a)
  have hd : DenseRange (fun n : ℕ => n • a + M • a) :=
    H.surjective.denseRange.comp hdN H.continuous
  let U := ((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Ioo 0 ε
  have ho : IsOpen U := QuotientAddGroup.isOpenMap_coe _ isOpen_Ioo
  have hne : U.Nonempty := Set.Nonempty.image _ (Set.nonempty_Ioo.mpr hε)
  obtain ⟨n, x, hx, heq⟩ := hd.exists_mem_open ho hne
  have he : Int.fract ((n + M : ℕ) * α) = x := by
    apply (AddCircle.coe_eq_coe_iff_of_mem_Ico
      (a := (0 : ℝ)) (p := (1 : ℝ))
      ⟨Int.fract_nonneg _, by simpa using Int.fract_lt_one ((n + M : ℕ) * α)⟩
      ⟨le_of_lt hx.1, by linarith [hx.2]⟩).mp
    rw [AddCircle.coe_fract]
    simp only [← nsmul_eq_mul, add_nsmul]
    exact heq.symm
  exact ⟨n + M, by omega, by rw [he]; exact hx⟩


lemma leading_zeros_in_progression (T : ℕ) (hT : 0 < T) (r M : ℕ) :
    ∃ n L : ℕ, M ≤ n ∧ 2 ^ (T * n) / 3 ^ L = 3 ^ r := by
  let α : ℝ := T * (Real.log 2 / Real.log 3)
  let ε : ℝ := Real.log (1 + 1 / (3 : ℝ) ^ r) / Real.log 3
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hα : 0 < α := by dsimp [α]; positivity
  have hi : Irrational α := irrational_log_two_div_log_three.natCast_mul (by omega)
  have hp : (0 : ℝ) < 3 ^ r := by positivity
  have hp1 : (1 : ℝ) ≤ 3 ^ r := one_le_pow₀ (by norm_num)
  have hε : 0 < ε := by
    dsimp [ε]
    apply div_pos _ h3
    apply Real.log_pos
    have hh : (0 : ℝ) < 1 / 3 ^ r := by positivity
    linarith
  have hε1 : ε ≤ 1 := by
    dsimp [ε]
    rw [div_le_iff₀ h3, one_mul]
    apply Real.log_le_log (by positivity)
    have hh := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1) hp1
    norm_num at hh
    simp only [one_div]
    linarith
  obtain ⟨N, hN⟩ := exists_nat_gt ((r : ℝ) / α)
  obtain ⟨n, hn, _, hnf⟩ := small_fract_arbitrarily_late hi hε hε1 (M + N)
  have hnN : (N : ℝ) ≤ n := by exact_mod_cast (show N ≤ n by omega)
  have hnr : (r : ℝ) < n * α := by
    have hh := (div_lt_iff₀ hα).mp hN
    nlinarith
  have hn0 : 0 ≤ (n : ℝ) * α := by positivity
  let D := Nat.floor ((n : ℝ) * α)
  have hrD : r ≤ D := (Nat.le_floor_iff hn0).mpr (le_of_lt hnr)
  have hD : (D : ℝ) ≤ n * α := Nat.floor_le hn0
  have hfract : Int.fract ((n : ℝ) * α) = n * α - D := by
    rw [Int.fract]
    have hh := congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_floor_eq_floor hn0)
    simpa only [Int.cast_natCast] using congrArg (fun x : ℝ => n * α - x) hh.symm
  rw [hfract] at hnf
  have hlog : Real.log ((2 : ℝ) ^ (T * n)) = (n * α) * Real.log 3 := by
    rw [Real.log_pow]
    dsimp [α]
    push_cast
    field_simp
  have hlo : (3 : ℝ) ^ D ≤ 2 ^ (T * n) := by
    apply (Real.log_le_log_iff (by positivity) (by positivity)).mp
    rw [Real.log_pow, hlog]
    exact mul_le_mul_of_nonneg_right hD (le_of_lt h3)
  have hhi : (2 : ℝ) ^ (T * n) < 3 ^ D * (1 + 1 / (3 : ℝ) ^ r) := by
    apply (Real.log_lt_log_iff (by positivity) (by positivity)).mp
    rw [hlog, Real.log_mul (by positivity) (by positivity), Real.log_pow]
    have hh := mul_lt_mul_of_pos_right hnf h3
    dsimp [ε] at hh
    rw [div_mul_cancel₀ _ (ne_of_gt h3)] at hh
    nlinarith
  have hpow : (3 : ℝ) ^ D = 3 ^ r * 3 ^ (D - r) := by
    rw [← pow_add, Nat.add_sub_of_le hrD]
  have hloN : 3 ^ r * 3 ^ (D - r) ≤ 2 ^ (T * n) := by
    rw [hpow] at hlo
    exact_mod_cast hlo
  have hhiN : 2 ^ (T * n) < (3 ^ r + 1) * 3 ^ (D - r) := by
    have he : (3 : ℝ) ^ D * (1 + 1 / (3 : ℝ) ^ r) =
        (3 ^ r + 1) * 3 ^ (D - r) := by
      rw [hpow]
      field_simp
    rw [he] at hhi
    exact_mod_cast hhi
  exact ⟨n, D - r, by omega, Nat.div_eq_of_lt_le hloN hhiN⟩

/-- For every fixed depth there are arbitrarily large powers of two with a `1`
followed by that many zeroes at the leading end, and the analogous trailing block.
This does not constrain the digits between these blocks. -/
lemma arbitrarily_large_good_ends (r M : ℕ) :
    ∃ k L : ℕ, M ≤ k ∧
      2 ^ k % 3 ^ (r + 1) = 1 ∧ 2 ^ k / 3 ^ L = 3 ^ r := by
  let T := (3 ^ (r + 1)).totient
  have hT : 0 < T := Nat.totient_pos.mpr (by positivity)
  obtain ⟨n, L, hn, hL⟩ := leading_zeros_in_progression T hT r M
  refine ⟨T * n, L, ?_, ?_, hL⟩
  · have hh : 1 * n ≤ T * n := Nat.mul_le_mul_right n (by omega)
    omega
  · have hc : Nat.Coprime 2 (3 ^ (r + 1)) :=
      (by decide : Nat.Coprime 2 3).pow_right (r + 1)
    have hm := (Nat.ModEq.pow_totient hc).pow n
    rw [← pow_mul, one_pow] at hm
    have hmodulus : 1 < 3 ^ (r + 1) := one_lt_pow₀ (by decide) (by omega)
    change 2 ^ (T * n) % 3 ^ (r + 1) = 1 % 3 ^ (r + 1) at hm
    rwa [Nat.mod_eq_of_lt hmodulus] at hm



lemma pow_two_power_odd_quotient {b q₀ : ℕ} (hq₀ : Odd q₀)
    (hb : b ^ 2 = 1 + 8 * q₀) (s : ℕ) :
    ∃ q : ℕ, Odd q ∧ b ^ (2 ^ (s + 1)) = 1 + 2 ^ (s + 3) * q := by
  induction s with
  | zero => exact ⟨q₀, hq₀, by simpa using hb⟩
  | succ s ih =>
    obtain ⟨q, hq, he⟩ := ih
    refine ⟨q + 2 ^ (s + 2) * q ^ 2, ?_, ?_⟩
    · exact hq.add_even (((by decide : Even (2 : ℕ)).pow_of_ne_zero (by omega)).mul_right _)
    · rw [show s + 1 + 1 = (s + 1) + 1 by omega, pow_succ, pow_mul, he]
      have hp : (2 : ℕ) ^ (s + 3) = 2 ^ (s + 2) * 2 := by rw [pow_succ]
      rw [show s + 1 + 3 = (s + 3) + 1 by omega, pow_succ, hp]
      ring

lemma three_pow_five_two_power_odd_quotient (s : ℕ) :
    ∃ q : ℕ, Odd q ∧ 3 ^ (5 * 2 ^ (s + 1)) = 1 + 2 ^ (s + 3) * q := by
  obtain ⟨q, hq, he⟩ := pow_two_power_odd_quotient (b := 3 ^ 5) (q₀ := 7381)
    (by decide) (by norm_num) s
  exact ⟨q, hq, by simpa only [pow_mul] using he⟩

lemma four_digit_divisibility_lift (s : ℕ) :
    ∃ c : ℕ, 5 ≤ c ∧ c % 5 = 2 ∧ 2 ^ (s + 3) ∣ 3 ^ c + 13 := by
  induction s with
  | zero => exact ⟨7, by omega, by norm_num, by norm_num⟩
  | succ s ih =>
    obtain ⟨c, hc, hc5, t, ht⟩ := ih
    obtain ⟨q, hq, hqeq⟩ := three_pow_five_two_power_odd_quotient s
    rcases Nat.even_or_odd t with ⟨u, hu⟩ | htodd
    · refine ⟨c, hc, hc5, u, ?_⟩
      rw [ht, hu, show s + 1 + 3 = (s + 3) + 1 by omega, pow_succ]
      ring
    · have hodd : Odd (3 ^ c * q) := ((by decide : Odd (3 : ℕ)).pow).mul hq
      obtain ⟨u, hu⟩ := htodd.add_odd hodd
      refine ⟨c + 5 * 2 ^ (s + 1), hc.trans (Nat.le_add_right _ _), ?_, u, ?_⟩
      · simp [Nat.add_mod, hc5]
      · calc
          3 ^ (c + 5 * 2 ^ (s + 1)) + 13 =
              (3 ^ c + 13) + 3 ^ c * 2 ^ (s + 3) * q := by
            rw [pow_add, hqeq]
            ring
          _ = 2 ^ (s + 3) * (t + 3 ^ c * q) := by rw [ht]; ring
          _ = 2 ^ (s + 1 + 3) * u := by
            rw [hu, show s + 1 + 3 = (s + 3) + 1 by omega, pow_succ]
            ring

lemma four_digit_formula {c : ℕ} (hc : 3 ≤ c) :
    Nat.digits 3 (3 ^ c + 13) = [1, 1, 1] ++ List.replicate (c - 3) 0 ++ [1] := by
  have h13 : Nat.digits 3 13 = [1, 1, 1] := by decide +kernel
  have h1 : Nat.digits 3 1 = [1] := by decide +kernel
  have hlen : (Nat.digits 3 13).length = 3 := by rw [h13]; rfl
  have he := Nat.digits_append_zeroes_append_digits (b := 3) (n := 13)
    (k := c - 3) (m := 1) (by decide) (by decide)
  rw [hlen, show 3 + (c - 3) = c by omega, mul_one, h13, h1] at he
  simpa only [Nat.add_comm] using he.symm

/-- Even with exactly four `1` digits, ternary `{0,1}` numbers can be divisible
by arbitrarily large powers of two, while also being divisible by eleven. -/
lemma unbounded_two_divisibility_four_ones (K : ℕ) :
    ∃ n : ℕ, 0 < n ∧ 2 ^ K ∣ n ∧ 11 ∣ n ∧
      Nat.digits 3 n ⊆ [0, 1] ∧ (Nat.digits 3 n).sum = 4 := by
  obtain ⟨c, hc, hc5, hd⟩ := four_digit_divisibility_lift K
  refine ⟨3 ^ c + 13, by positivity, (pow_dvd_pow 2 (by omega : K ≤ K + 3)).trans hd, ?_, ?_, ?_⟩
  · apply Nat.dvd_of_mod_eq_zero
    have he : c = 5 * (c / 5) + 2 := by omega
    rw [he, pow_add, pow_mul]
    norm_num [Nat.add_mod, Nat.mul_mod, Nat.pow_mod]
  · rw [four_digit_formula (by omega : 3 ≤ c)]
    intro d hd
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
      List.mem_replicate] at hd ⊢
    aesop
  · rw [four_digit_formula (by omega : 3 ≤ c)]
    simp


/-- There is no bound on the valuation that depends only on the digit sum,
even if numbers that are themselves powers of two are excluded. -/
lemma no_valuation_bound_by_digit_sum :
    ¬ ∃ F : ℕ → ℕ, ∀ n : ℕ, 0 < n → ¬ n.isPowerOfTwo →
      Nat.digits 3 n ⊆ [0, 1] → padicValNat 2 n ≤ F (Nat.digits 3 n).sum := by
  rintro ⟨F, hF⟩
  obtain ⟨n, hn, hdiv, h11, hd, hs⟩ := unbounded_two_divisibility_four_ones (F 4 + 1)
  have hnp : ¬ n.isPowerOfTwo := by
    rintro ⟨k, rfl⟩
    have hh := (by decide : Nat.Prime 11).dvd_of_dvd_pow h11
    norm_num at hh
  have hv : F 4 + 1 ≤ padicValNat 2 n :=
    (padicValNat_dvd_iff_le (by omega : n ≠ 0)).mp hdiv
  have hb := hF n hn hnp hd
  rw [hs] at hb
  omega



lemma four_digit_divisibility_large (K C : ℕ) :
    ∃ c : ℕ, C ≤ c ∧ 5 ≤ c ∧ c % 5 = 2 ∧ 2 ^ K ∣ 3 ^ c + 13 := by
  obtain ⟨c, hc, hc5, hd⟩ := four_digit_divisibility_lift K
  have hd' : 2 ^ K ∣ 3 ^ c + 13 := (pow_dvd_pow 2 (by omega : K ≤ K + 3)).trans hd
  let T := (2 ^ K).totient
  have hT : 0 < T := Nat.totient_pos.mpr (by positivity)
  let d := T * (5 * (C + 1))
  have hCd : C ≤ d := by
    have hh := Nat.le_mul_of_pos_left (5 * (C + 1)) hT
    dsimp [d]
    omega
  have hmod : Nat.ModEq (2 ^ K) (3 ^ d) 1 := by
    have hh := (Nat.ModEq.pow_totient
      ((by decide : Nat.Coprime 3 2).pow_right K)).pow (5 * (C + 1))
    simpa only [← pow_mul, one_pow] using hh
  refine ⟨c + d, hCd.trans (Nat.le_add_left _ _), hc.trans (Nat.le_add_right _ _), ?_, ?_⟩
  · dsimp [d]
    simp [Nat.add_mod, Nat.mul_mod, hc5]
  · have hh := ((Nat.ModEq.refl (n := 2 ^ K) (3 ^ c)).mul hmod).add_right 13
    rw [mul_one, ← pow_add] at hh
    exact Nat.modEq_zero_iff_dvd.mp (hh.trans (Nat.modEq_zero_iff_dvd.mpr hd'))

/-- A reciprocal of a suitable power of four, scaled by a power of three,
can lie strictly between two consecutive integers just below a power of three. -/
lemma powers_between_near_all_twos (r : ℕ) :
    ∃ t E : ℕ, 0 < t ∧
      (3 ^ (r + 1) - 1) * 4 ^ t < 3 ^ E ∧ 3 ^ E < 3 ^ (r + 1) * 4 ^ t := by
  obtain ⟨t, L, ht, hL⟩ := leading_zeros_in_progression 2 (by decide) (r + 1) 1
  rw [pow_mul] at hL
  change 4 ^ t / 3 ^ L = 3 ^ (r + 1) at hL
  let A := 3 ^ (r + 1)
  let S := 3 ^ L
  have hA : 0 < A := by dsimp [A]; positivity
  have hA1 : 1 < A := by dsimp [A]; exact one_lt_pow₀ (by decide) (by omega)
  have hS : 0 < S := by dsimp [S]; positivity
  have hlo : A * S ≤ 4 ^ t :=
    (Nat.le_div_iff_mul_le hS).mp (by rw [hL])
  have hhi : 4 ^ t < (A + 1) * S :=
    (Nat.div_lt_iff_lt_mul hS).mp (by rw [hL]; omega)
  have hne : A * S ≠ 4 ^ t := by
    intro he
    have hh := congrArg (fun n : ℕ => n % 2) he
    simp [A, S, Nat.mul_mod, Nat.pow_mod, show t ≠ 0 by omega] at hh
  have hlo' : A * S < 4 ^ t := lt_of_le_of_ne hlo hne
  let E := L + (r + 1) + (r + 1)
  have hE : 3 ^ E = A * (A * S) := by dsimp [E, A, S]; simp only [pow_add]; ring
  refine ⟨t, E, by omega, ?_, ?_⟩
  · rw [hE]
    change (A - 1) * 4 ^ t < A * (A * S)
    have hm := Nat.mul_lt_mul_of_pos_left hhi (by omega : 0 < A - 1)
    have he : (A - 1) * ((A + 1) * S) + S = A * (A * S) := by
      have hh : A - 1 + 1 = A := by omega
      generalize A - 1 = p at hh ⊢
      rw [← hh]
      ring
    omega
  · rw [hE]
    exact Nat.mul_lt_mul_of_pos_left hlo' hA


lemma digits_three_pow_sub_one (r : ℕ) :
    Nat.digits 3 (3 ^ r - 1) = List.replicate r 2 := by
  induction r with
  | zero => simp
  | succ r ih =>
    have hp : 0 < 3 ^ r := by positivity
    have he : 3 ^ (r + 1) - 1 = 2 + 3 * (3 ^ r - 1) := by
      rw [pow_succ]
      omega
    rw [he, Nat.digits_add 3 (by decide) 2 (3 ^ r - 1) (by decide) (Or.inl (by decide)),
      ih, List.replicate_succ]

/-- A general integer may have an arbitrarily long leading run of ternary `2`s
and still become a ternary `{0,1}` integer after multiplication by a power of four.
These examples have a factor eleven, so they do not disprove Erdős 406. -/
lemma arbitrarily_long_twos_can_disappear (r : ℕ) :
    ∃ t n L : ℕ, 0 < t ∧ Nat.digits 3 (n / 3 ^ L) = List.replicate (r + 1) 2 ∧
      Nat.digits 3 (4 ^ t * n) ⊆ [0, 1] ∧ 11 ∣ 4 ^ t * n := by
  obtain ⟨t, E, ht, hlo, hhi⟩ := powers_between_near_all_twos r
  obtain ⟨c, hcE, hc, hc5, hdiv⟩ := four_digit_divisibility_large (2 * t) (E + 3)
  rw [pow_mul] at hdiv
  change 4 ^ t ∣ 3 ^ c + 13 at hdiv
  obtain ⟨n, hn⟩ := hdiv
  let L := c - E
  have hL : 3 ≤ L := by dsimp [L]; omega
  have hpow : 3 ^ c = 3 ^ E * 3 ^ L := by
    rw [← pow_add]
    congr 1
    dsimp [L]
    omega
  have hS : 13 < 3 ^ L := by
    have hh := Nat.pow_le_pow_right (by decide : 0 < 3) hL
    norm_num at hh
    omega
  have hQ : 0 < 4 ^ t := by positivity
  have hnlo : (3 ^ (r + 1) - 1) * 3 ^ L ≤ n := by
    apply Nat.le_of_mul_le_mul_left (c := 4 ^ t) _ hQ
    calc
      4 ^ t * ((3 ^ (r + 1) - 1) * 3 ^ L) =
          ((3 ^ (r + 1) - 1) * 4 ^ t) * 3 ^ L := by ring
      _ ≤ 3 ^ E * 3 ^ L := Nat.mul_le_mul_right _ (le_of_lt hlo)
      _ ≤ 4 ^ t * n := by rw [← hpow, ← hn]; omega
  have hnhi : n < ((3 ^ (r + 1) - 1) + 1) * 3 ^ L := by
    have hA : 1 ≤ 3 ^ (r + 1) := Nat.one_le_pow _ _ (by decide)
    rw [Nat.sub_add_cancel hA]
    apply Nat.lt_of_mul_lt_mul_left (a := 4 ^ t)
    have hh := Nat.mul_le_mul_right (3 ^ L) (Nat.succ_le_of_lt hhi)
    calc
      4 ^ t * n = 3 ^ E * 3 ^ L + 13 := by rw [← hn, hpow]
      _ < (3 ^ E + 1) * 3 ^ L := by nlinarith
      _ ≤ (3 ^ (r + 1) * 4 ^ t) * 3 ^ L := hh
      _ = 4 ^ t * (3 ^ (r + 1) * 3 ^ L) := by ring
  refine ⟨t, n, L, ht, ?_, ?_, ?_⟩
  · rw [Nat.div_eq_of_lt_le hnlo hnhi, digits_three_pow_sub_one]
  · rw [← hn, four_digit_formula (by omega : 3 ≤ c)]
    intro d hd
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
      List.mem_replicate] at hd ⊢
    aesop
  · rw [← hn]
    apply Nat.dvd_of_mod_eq_zero
    have he : c = 5 * (c / 5) + 2 := by omega
    rw [he, pow_add, pow_mul]
    norm_num [Nat.add_mod, Nat.mul_mod, Nat.pow_mod]


end Erdos406Work

