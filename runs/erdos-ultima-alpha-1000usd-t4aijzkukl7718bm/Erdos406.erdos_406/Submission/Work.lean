/-- A certified bounded result only: it does not imply finiteness of all solutions. -/
lemma good_four_exponents_below_million {m : ℕ} (hm : m < 1000000) :
    Nat.digits 3 (4 ^ m) ⊆ [0, 1] ↔ m = 0 ∨ m = 1 ∨ m = 4 := by
  constructor
  · intro hd
    have hh := good_exponent_mem_paired_sieve (R := 36) hm hd 36 (by omega)
    rw [Nat.mod_eq_of_lt (lt_of_lt_of_le hm (by norm_num : 1000000 ≤ 3 ^ 36)),
      paired_sieve_cert_36] at hh
    have hf := List.mem_map_of_mem (f := Prod.fst) hh
    simpa only [List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] using hf
  · rintro (rfl | rfl | rfl) <;> decide +kernel

lemma good_two_exponents_below_two_million {k : ℕ} (hk : k < 2000000) :
    Nat.digits 3 (2 ^ k) ⊆ [0, 1] ↔ k = 0 ∨ k = 2 ∨ k = 8 := by
  constructor
  · intro hd
    obtain ⟨m, he⟩ := even_exponent hd
    have hpow : 2 ^ k = 4 ^ m := by
      rw [he, ← two_mul, pow_mul]
      norm_num
    rw [hpow] at hd
    have hm : m < 1000000 := by omega
    have hh := (good_four_exponents_below_million hm).mp hd
    omega
  · rintro (rfl | rfl | rfl) <;> decide +kernel

end Erdos406Work



/- A conditional valuation approach to Erdős 406, not a proof of the conjecture. -/
namespace Erdos406Work

lemma eight_nine_bernoulli (L : ℕ) : 8 ^ L * (L + 8) ≤ 8 * 9 ^ L := by
  induction L with
  | zero => norm_num
  | succ L ih =>
    have hp : 8 ^ L ≤ 9 ^ L := Nat.pow_le_pow_left (by decide) _
    simp only [pow_succ]
    nlinarith

/-- A uniform valuation gap would give an exponent cutoff. The gap itself
is an unproved hypothesis here. -/
lemma valuation_gap_exponent_bound (C : ℕ)
    (hgap : ∀ n : ℕ, 0 < n → Nat.digits 3 n ⊆ [0, 1] →
      2 * padicValNat 2 n ≤ 3 * (Nat.digits 3 n).length + C)
    {k : ℕ} (hd : Nat.digits 3 (2 ^ k) ⊆ [0, 1]) :
    k ≤ 216 * 2 ^ C + C := by
  let L := (Nat.digits 3 (2 ^ k)).length
  have hk : 2 * k ≤ 3 * L + C := by
    simpa only [padicValNat.prime_pow] using hgap (2 ^ k) (by positivity) hd
  have hbase : 3 ^ L ≤ 3 * 2 ^ k := by
    exact Nat.base_pow_length_digits_le 3 (2 ^ k) (by decide) (by positivity)
  have hsq : 9 ^ L ≤ 9 * 2 ^ (2 * k) := by
    calc
      9 ^ L = (3 ^ L) ^ 2 := by rw [← pow_mul, Nat.mul_comm, pow_mul]; norm_num
      _ ≤ (3 * 2 ^ k) ^ 2 := Nat.pow_le_pow_left hbase _
      _ = 9 * 2 ^ (2 * k) := by rw [mul_pow, ← pow_mul, Nat.mul_comm k 2]; norm_num
  have hpow : 2 ^ (2 * k) ≤ 8 ^ L * 2 ^ C := by
    calc
      2 ^ (2 * k) ≤ 2 ^ (3 * L + C) := Nat.pow_le_pow_right (by decide) hk
      _ = 8 ^ L * 2 ^ C := by rw [pow_add, pow_mul]; norm_num
  have hb := eight_nine_bernoulli L
  have hL : L ≤ 72 * 2 ^ C := by
    have hh : 8 ^ L * (L + 8) ≤ 8 ^ L * (72 * 2 ^ C) := by nlinarith
    have hc := Nat.le_of_mul_le_mul_left hh (by positivity : 0 < 8 ^ L)
    omega
  omega

lemma valuation_gap_implies_finite
    (hgap : ∃ C : ℕ, ∀ n : ℕ, 0 < n → Nat.digits 3 n ⊆ [0, 1] →
      2 * padicValNat 2 n ≤ 3 * (Nat.digits 3 n).length + C) :
    {n : ℕ | n.isPowerOfTwo ∧ Nat.digits 3 n ⊆ [0, 1]}.Finite := by
  obtain ⟨C, hC⟩ := hgap
  apply finite_iff_exponent_cutoff.mpr
  refine ⟨216 * 2 ^ C + C + 1, ?_⟩
  intro k hk hd
  have := valuation_gap_exponent_bound C hC hd
  omega

end Erdos406Work



/- Ternary-gap obstructions for exponents; not a solution to Erdős 406. -/
namespace Erdos406Work

def scaledQuotient (u : ℕ) : ℕ → ℕ
  | 0 => 4 ^ u / 3
  | s + 1 => scaledQuotient u s + 3 ^ (s + 1) * scaledQuotient u s ^ 2 +
      3 ^ (2 * s + 1) * scaledQuotient u s ^ 3

lemma scaledQuotient_identity (u s : ℕ) :
    4 ^ (u * 3 ^ s) = 1 + 3 ^ (s + 1) * scaledQuotient u s := by
  induction s with
  | zero => simpa [scaledQuotient] using four_pow_eq_one_add u
  | succ s ih =>
    have hp : (3 : ℕ) ^ (2 * s + 1) = 3 * (3 ^ s) ^ 2 := by
      rw [show 2 * s + 1 = s + s + 1 by omega, pow_succ, pow_add]
      ring
    rw [pow_succ, ← Nat.mul_assoc, pow_mul, ih, scaledQuotient, hp]
    simp only [pow_succ]
    ring

lemma scaledQuotient_stable (u h s : ℕ) :
    scaledQuotient u (s + h) % 3 ^ (h + 1) = scaledQuotient u h % 3 ^ (h + 1) := by
  induction s with
  | zero => simp
  | succ s ih =>
    have h1 : (3 : ℕ) ^ (s + h + 1) % 3 ^ (h + 1) = 0 :=
      Nat.mod_eq_zero_of_dvd (pow_dvd_pow 3 (by omega))
    have h2 : (3 : ℕ) ^ (2 * (s + h) + 1) % 3 ^ (h + 1) = 0 :=
      Nat.mod_eq_zero_of_dvd (pow_dvd_pow 3 (by omega))
    rw [show s + 1 + h = s + h + 1 by omega, scaledQuotient]
    simp only [Nat.add_mod, Nat.mul_mod, Nat.mod_mod, h1, h2, ih,
      zero_mul, Nat.zero_mod, add_zero, Nat.mod_mod]

lemma not_good_of_high_residue (a t b h : ℕ) (ha : a < 3 ^ t)
    (hb : 3 ^ h ≤ 2 * (b % 3 ^ h)) :
    ¬ Nat.digits 3 (a + 3 ^ t * b) ⊆ [0, 1] := by
  intro hd
  have hh := (digits_iff_no_carries _).mp hd (t + h)
  rw [pow_add, Nat.mod_mul] at hh
  have hmod : (a + 3 ^ t * b) % 3 ^ t = a := by
    simp [Nat.add_mod, Nat.mod_eq_of_lt ha]
  have hdiv : (a + 3 ^ t * b) / 3 ^ t = b := by
    rw [Nat.add_mul_div_left a b (by positivity : 0 < 3 ^ t), Nat.div_eq_of_lt ha]
    omega
  rw [hmod, hdiv] at hh
  have hh' := Nat.mul_le_mul_left (3 ^ t) hb
  nlinarith

lemma bad_scaled_exponent_of_residue (u s h : ℕ)
    (hb : 3 ^ h ≤ 2 * (scaledQuotient u s % 3 ^ h)) :
    ¬ Nat.digits 3 (4 ^ (u * 3 ^ s)) ⊆ [0, 1] := by
  rw [scaledQuotient_identity]
  apply not_good_of_high_residue 1 (s + 1) _ h
  · exact one_lt_pow₀ (by decide) (by omega)
  · exact hb


lemma scaled_power_mod (u s r : ℕ) :
    4 ^ (u * 3 ^ s) % 3 ^ r = towerMod (3 ^ r) s ^ u % 3 ^ r := by
  rw [towerMod_eq, ← Nat.pow_mod, ← pow_mul, Nat.mul_comm (3 ^ s) u]

lemma scaledQuotient_mod (u s h : ℕ) :
    scaledQuotient u s % 3 ^ h =
      (towerMod (3 ^ (s + 1 + h)) s ^ u % 3 ^ (s + 1 + h)) / 3 ^ (s + 1) := by
  rw [← scaled_power_mod, pow_add, Nat.mod_mul_right_div_self,
    scaledQuotient_identity, Nat.add_mul_div_left 1 _ (by positivity : 0 < 3 ^ (s + 1))]
  rw [Nat.div_eq_of_lt (one_lt_pow₀ (by decide : 1 < (3 : ℕ)) (by omega : s + 1 ≠ 0)), zero_add]

lemma bad_scaled_power_test (u s r : ℕ)
    (hb : 3 ^ r ≤ 2 * (towerMod (3 ^ r) s ^ u % 3 ^ r)) :
    ¬ Nat.digits 3 (4 ^ (u * 3 ^ s)) ⊆ [0, 1] := by
  intro hd
  have hh := (digits_iff_no_carries _).mp hd r
  rw [scaled_power_mod] at hh
  omega

lemma scaled_four_family (s : ℕ) :
    Nat.digits 3 (4 ^ (4 * 3 ^ s)) ⊆ [0, 1] ↔ s = 0 := by
  by_cases hs : s < 3
  · interval_cases s <;> decide +kernel
  · have hc : scaledQuotient 4 3 % 81 = 64 := by
      change scaledQuotient 4 3 % 3 ^ 4 = 64
      rw [scaledQuotient_mod]
      decide +kernel
    have hq : scaledQuotient 4 s % 81 = 64 := by
      have hh := scaledQuotient_stable 4 3 (s - 3)
      rw [show s - 3 + 3 = s by omega] at hh
      exact hh.trans hc
    have hb : ¬ Nat.digits 3 (4 ^ (4 * 3 ^ s)) ⊆ [0, 1] := by
      apply bad_scaled_exponent_of_residue 4 s 4
      change 81 ≤ 2 * (scaledQuotient 4 s % 81)
      rw [hq]
      norm_num
    exact iff_of_false hb (by omega)

lemma scaled_seven_family_bad (s : ℕ) :
    ¬ Nat.digits 3 (4 ^ (7 * 3 ^ s)) ⊆ [0, 1] := by
  by_cases hs : s ≤ 10
  · have hm : 7 * 3 ^ s < 1000000 := by
      have hp : 3 ^ s ≤ 3 ^ 10 := Nat.pow_le_pow_right (by decide) hs
      norm_num at hp
      omega
    intro hd
    have hh := (good_four_exponents_below_million hm).mp hd
    have hp : 0 < 3 ^ s := by positivity
    omega
  by_cases hs' : s < 14
  · have hh : s = 11 ∨ s = 12 ∨ s = 13 := by omega
    rcases hh with rfl | rfl | rfl
    · apply bad_scaled_power_test 7 11 28; decide +kernel
    · apply bad_scaled_power_test 7 12 28; decide +kernel
    · apply bad_scaled_power_test 7 13 32; decide +kernel
  · have hc : scaledQuotient 7 14 % 14348907 = 11691976 := by
      change scaledQuotient 7 14 % 3 ^ 15 = 11691976
      rw [scaledQuotient_mod]
      decide +kernel
    have hq : scaledQuotient 7 s % 14348907 = 11691976 := by
      have hh := scaledQuotient_stable 7 14 (s - 14)
      rw [show s - 14 + 14 = s by omega] at hh
      exact hh.trans hc
    apply bad_scaled_exponent_of_residue 7 s 15
    change 14348907 ≤ 2 * (scaledQuotient 7 s % 14348907)
    rw [hq]
    norm_num


lemma high_block_mod (a t b h : ℕ) (ha : a < 3 ^ t) :
    (a + 3 ^ t * b) % 3 ^ (t + h) = a + 3 ^ t * (b % 3 ^ h) := by
  rw [pow_add, Nat.mod_mul, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt ha,
    Nat.add_mul_div_left a b (by positivity : 0 < 3 ^ t), Nat.div_eq_of_lt ha, zero_add]

lemma scaled_obstruction_persists (u a h t : ℕ)
    (hb : 3 ^ h ≤ 2 * (scaledQuotient u a % 3 ^ h)) :
    ¬ Nat.digits 3 (4 ^ (u * 3 ^ a + 3 ^ (a + h) * t)) ⊆ [0, 1] := by
  intro hd
  have hbase : 3 ^ (a + 1 + h) ≤ 2 * (4 ^ (u * 3 ^ a) % 3 ^ (a + 1 + h)) := by
    rw [scaledQuotient_identity, high_block_mod 1 (a + 1) _ h
      (one_lt_pow₀ (by decide) (by omega)), pow_add]
    have hp := Nat.mul_le_mul_left (3 ^ (a + 1)) hb
    nlinarith
  have he := Nat.add_mul_mod_self_left (u * 3 ^ a) (3 ^ (a + h)) t
  have hm := congrArg (fun e : ℕ => 4 ^ e % 3 ^ (a + h + 1)) he
  dsimp only at hm
  rw [four_pow_reduce_exponent, four_pow_reduce_exponent] at hm
  have hh := (digits_iff_no_carries _).mp hd (a + h + 1)
  rw [hm] at hh
  rw [show a + 1 + h = a + h + 1 by omega] at hbase
  omega

lemma scaledQuotient_one_mod_nine {a : ℕ} (ha : 1 ≤ a) :
    scaledQuotient 1 a % 9 = 7 := by
  have hh := scaledQuotient_stable 1 1 (a - 1)
  rw [show a - 1 + 1 = a by omega] at hh
  norm_num [scaledQuotient] at hh
  exact hh

lemma scaledQuotient_two_mod_three (a : ℕ) :
    scaledQuotient 2 a % 3 = 2 := by
  have hh := scaledQuotient_stable 2 0 a
  norm_num [scaledQuotient] at hh
  exact hh

lemma lowest_two_exponent_bad (a t : ℕ) :
    ¬ Nat.digits 3 (4 ^ (2 * 3 ^ a + 3 ^ (a + 1) * t)) ⊆ [0, 1] := by
  apply scaled_obstruction_persists 2 a 1 t
  change 3 ≤ 2 * (scaledQuotient 2 a % 3)
  rw [scaledQuotient_two_mod_three]
  norm_num

lemma separated_exponent_bad (a b d : ℕ) (ha : 1 ≤ a) (hab : a + 2 ≤ b) :
    ¬ Nat.digits 3 (4 ^ (3 ^ a + d * 3 ^ b)) ⊆ [0, 1] := by
  have hv : 3 ^ (a + 2) ∣ d * 3 ^ b := dvd_mul_of_dvd_right (pow_dvd_pow 3 hab) d
  obtain ⟨t, ht⟩ := hv
  rw [ht]
  have hh := scaled_obstruction_persists 1 a 2 t
  simp only [one_mul] at hh
  apply hh
  change 9 ≤ 2 * (scaledQuotient 1 a % 9)
  rw [scaledQuotient_one_mod_nine ha]
  norm_num

lemma offset_scaled_identity (u b : ℕ) :
    4 ^ (1 + u * 3 ^ b) = 4 + 3 ^ (b + 1) * (4 * scaledQuotient u b) := by
  rw [pow_add, pow_one, scaledQuotient_identity]
  ring

lemma one_plus_three_power_iff (b : ℕ) :
    Nat.digits 3 (4 ^ (1 + 3 ^ b)) ⊆ [0, 1] ↔ b = 1 := by
  by_cases hb : b < 3
  · interval_cases b <;> decide +kernel
  · have hc : scaledQuotient 1 3 % 81 = 16 := by
      change scaledQuotient 1 3 % 3 ^ 4 = 16
      rw [scaledQuotient_mod]
      decide +kernel
    have hq : scaledQuotient 1 b % 81 = 16 := by
      have hh := scaledQuotient_stable 1 3 (b - 3)
      rw [show b - 3 + 3 = b by omega] at hh
      exact hh.trans hc
    have ha : 4 < 3 ^ (b + 1) := by
      have hh : 3 ^ 2 ≤ 3 ^ (b + 1) := Nat.pow_le_pow_right (by decide) (by omega)
      norm_num at hh
      omega
    have hbad : ¬ Nat.digits 3 (4 ^ (1 + 3 ^ b)) ⊆ [0, 1] := by
      rw [show 1 + 3 ^ b = 1 + 1 * 3 ^ b by omega, offset_scaled_identity]
      apply not_good_of_high_residue 4 (b + 1) _ 4 ha
      change 81 ≤ 2 * ((4 * scaledQuotient 1 b) % 81)
      rw [Nat.mul_mod, hq]
      norm_num
    exact iff_of_false hbad (by omega)

lemma one_plus_twice_three_power_bad (b : ℕ) :
    ¬ Nat.digits 3 (4 ^ (1 + 2 * 3 ^ b)) ⊆ [0, 1] := by
  by_cases hb : b = 0
  · subst b; decide +kernel
  rw [offset_scaled_identity]
  have ha : 4 < 3 ^ (b + 1) := by
    have hh : 3 ^ 2 ≤ 3 ^ (b + 1) := Nat.pow_le_pow_right (by decide) (by omega)
    norm_num at hh
    omega
  apply not_good_of_high_residue 4 (b + 1) _ 1 ha
  change 3 ≤ 2 * ((4 * scaledQuotient 2 b) % 3)
  rw [Nat.mul_mod, scaledQuotient_two_mod_three]
  norm_num

lemma two_ones_exponent_iff (a b : ℕ) (hab : a < b) :
    Nat.digits 3 (4 ^ (3 ^ a + 3 ^ b)) ⊆ [0, 1] ↔ a = 0 ∧ b = 1 := by
  constructor
  · intro hd
    by_cases ha : a = 0
    · subst a
      simp only [pow_zero] at hd
      exact ⟨rfl, (one_plus_three_power_iff b).mp hd⟩
    by_cases hg : a + 2 ≤ b
    · exact False.elim (separated_exponent_bad a b 1 (by omega) hg (by simpa using hd))
    have hb : b = a + 1 := by omega
    have he : 3 ^ a + 3 ^ b = 4 * 3 ^ a := by rw [hb, pow_succ]; ring
    rw [he] at hd
    exact False.elim (ha ((scaled_four_family a).mp hd))
  · rintro ⟨rfl, rfl⟩
    decide +kernel

lemma one_then_two_exponent_bad (a b : ℕ) (hab : a < b) :
    ¬ Nat.digits 3 (4 ^ (3 ^ a + 2 * 3 ^ b)) ⊆ [0, 1] := by
  by_cases ha : a = 0
  · subst a
    simpa using one_plus_twice_three_power_bad b
  by_cases hg : a + 2 ≤ b
  · exact separated_exponent_bad a b 2 (by omega) hg
  have hb : b = a + 1 := by omega
  have he : 3 ^ a + 2 * 3 ^ b = 7 * 3 ^ a := by rw [hb, pow_succ]; ring
  rw [he]
  exact scaled_seven_family_bad a


/-- Complete classification for an exponent with exactly two nonzero ternary digits. -/
lemma two_nonzero_exponent_iff (a b d e : ℕ) (hab : a < b)
    (hd : d = 1 ∨ d = 2) (he : e = 1 ∨ e = 2) :
    Nat.digits 3 (4 ^ (d * 3 ^ a + e * 3 ^ b)) ⊆ [0, 1] ↔
      d = 1 ∧ e = 1 ∧ a = 0 ∧ b = 1 := by
  rcases hd with rfl | rfl
  · rcases he with rfl | rfl
    · simpa using two_ones_exponent_iff a b hab
    · simpa using iff_of_false (one_then_two_exponent_bad a b hab) (by decide : ¬ (2 : ℕ) = 1)
  · have hv : 3 ^ (a + 1) ∣ e * 3 ^ b :=
      dvd_mul_of_dvd_right (pow_dvd_pow 3 (by omega)) e
    obtain ⟨t, ht⟩ := hv
    have hb : ¬ Nat.digits 3 (4 ^ (2 * 3 ^ a + e * 3 ^ b)) ⊆ [0, 1] := by
      rw [ht]
      exact lowest_two_exponent_bad a t
    simp only [show ¬ (2 : ℕ) = 1 by decide, false_and, iff_false]
    exact hb



lemma ofDigits_zero_of_nonzero_count_zero (L : List ℕ)
    (h : L.countP (fun d => d != 0) = 0) : Nat.ofDigits 3 L = 0 := by
  induction L with
  | nil => rfl
  | cons d L ih =>
    by_cases hd : d = 0
    · subst d
      simp only [List.countP_cons, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte,
        Nat.add_zero] at h
      simp [Nat.ofDigits_cons, ih h]
    · simp [hd] at h

lemma ofDigits_one_sparse (L : List ℕ) (hL : ∀ d ∈ L, d < 3)
    (hc : L.countP (fun d => d != 0) ≤ 1) :
    Nat.ofDigits 3 L = 0 ∨
      ∃ a d : ℕ, (d = 1 ∨ d = 2) ∧ Nat.ofDigits 3 L = d * 3 ^ a := by
  induction L with
  | nil => exact Or.inl rfl
  | cons d L ih =>
    have hdlt : d < 3 := hL d (by simp)
    have htail : ∀ e ∈ L, e < 3 := fun e he => hL e (by simp [he])
    by_cases hd : d = 0
    · subst d
      simp only [List.countP_cons, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte,
        Nat.add_zero] at hc
      rcases ih htail hc with hv | ⟨a, e, he, hv⟩
      · left; simp [Nat.ofDigits_cons, hv]
      · right
        refine ⟨a + 1, e, he, ?_⟩
        rw [Nat.ofDigits_cons, hv, pow_succ]
        ring
    · have hz : L.countP (fun d => d != 0) = 0 := by
        simp only [List.countP_cons] at hc
        simp [hd] at hc
        simpa using hc
      have hv := ofDigits_zero_of_nonzero_count_zero L hz
      right
      refine ⟨0, d, by omega, ?_⟩
      simp [Nat.ofDigits_cons, hv]

lemma ofDigits_two_sparse (L : List ℕ) (hL : ∀ d ∈ L, d < 3)
    (hc : L.countP (fun d => d != 0) ≤ 2) :
    Nat.ofDigits 3 L = 0 ∨
      (∃ a d : ℕ, (d = 1 ∨ d = 2) ∧ Nat.ofDigits 3 L = d * 3 ^ a) ∨
      ∃ a b d e : ℕ, a < b ∧ (d = 1 ∨ d = 2) ∧ (e = 1 ∨ e = 2) ∧
        Nat.ofDigits 3 L = d * 3 ^ a + e * 3 ^ b := by
  induction L with
  | nil => exact Or.inl rfl
  | cons d L ih =>
    have hdlt : d < 3 := hL d (by simp)
    have htail : ∀ e ∈ L, e < 3 := fun e he => hL e (by simp [he])
    by_cases hd : d = 0
    · subst d
      simp only [List.countP_cons, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte,
        Nat.add_zero] at hc
      rcases ih htail hc with hv | ⟨a, e, he, hv⟩ | ⟨a, b, e, f, hab, he, hf, hv⟩
      · left; simp [Nat.ofDigits_cons, hv]
      · right; left
        refine ⟨a + 1, e, he, ?_⟩
        rw [Nat.ofDigits_cons, hv, pow_succ]
        ring
      · right; right
        refine ⟨a + 1, b + 1, e, f, by omega, he, hf, ?_⟩
        rw [Nat.ofDigits_cons, hv, pow_succ, pow_succ]
        ring
    · have ht : L.countP (fun d => d != 0) ≤ 1 := by
        simp only [List.countP_cons] at hc
        simp [hd] at hc
        omega
      rcases ofDigits_one_sparse L htail ht with hv | ⟨b, e, he, hv⟩
      · right; left
        refine ⟨0, d, by omega, ?_⟩
        simp [Nat.ofDigits_cons, hv]
      · right; right
        refine ⟨0, b + 1, d, e, by omega, by omega, he, ?_⟩
        rw [Nat.ofDigits_cons, hv, pow_succ]
        simp only [pow_zero, mul_one]
        ring

/-- Classification when the exponent, not the power itself, has at most two
nonzero ternary digits. No such sparsity assumption is known for every solution. -/
lemma sparse_exponent_classification {m : ℕ}
    (hm : (Nat.digits 3 m).countP (fun d => d != 0) ≤ 2) :
    Nat.digits 3 (4 ^ m) ⊆ [0, 1] ↔ m = 0 ∨ m = 1 ∨ m = 4 := by
  constructor
  · intro hd
    have hrep := ofDigits_two_sparse (Nat.digits 3 m)
      (fun d h => Nat.digits_lt_base (by decide) h) hm
    rw [Nat.ofDigits_digits] at hrep
    rcases hrep with hz | ⟨a, d, he, hv⟩ | ⟨a, b, d, e, hab, hd', he, hv⟩
    · exact Or.inl hz
    · rcases he with rfl | rfl
      · simp only [one_mul] at hv
        rw [hv] at hd
        cases a with
        | zero => simp_all
        | succ a => exact False.elim (positive_power_family_bad a hd)
      · rw [hv] at hd
        have hh := lowest_two_exponent_bad a 0
        simp only [mul_zero, add_zero] at hh
        exact False.elim (hh hd)
    · rw [hv] at hd
      obtain ⟨rfl, rfl, rfl, rfl⟩ := (two_nonzero_exponent_iff a b d e hab hd' he).mp hd
      norm_num at hv
      exact Or.inr (Or.inr hv)
  · rintro (rfl | rfl | rfl) <;> decide +kernel

end Erdos406Work


/- Further obstructions to fixed finite-prime sieves; not a solution. -/

namespace Erdos406Work

/-- The ternary repunit with `r` digits. -/
def ternaryRepunit (r : ℕ) : ℕ := Nat.ofDigits 3 (List.replicate r 1)

lemma ternaryRepunit_succ (r : ℕ) :
    ternaryRepunit (r + 1) = 1 + 3 * ternaryRepunit r := by
  simp [ternaryRepunit, List.replicate_succ, Nat.ofDigits_cons]

lemma ternaryRepunit_identity (r : ℕ) : 2 * ternaryRepunit r + 1 = 3 ^ r := by
  induction r with
  | zero => simp [ternaryRepunit]
  | succ r ih => rw [ternaryRepunit_succ, pow_succ]; nlinarith

lemma ternaryRepunit_digits (r : ℕ) :
    Nat.digits 3 (ternaryRepunit r) = List.replicate r 1 := by
  apply Nat.digits_ofDigits 3 (by decide)
  · intro d hd
    simp only [List.mem_replicate] at hd
    omega
  · intro h
    simp

lemma ternaryRepunit_good (r : ℕ) :
    Nat.digits 3 (ternaryRepunit r) ⊆ [0, 1] := by
  rw [ternaryRepunit_digits]
  intro d hd
  simp only [List.mem_replicate] at hd
  simp [hd.2]

lemma ternaryRepunit_ge (r : ℕ) : r ≤ ternaryRepunit r := by
  induction r with
  | zero => omega
  | succ r ih => rw [ternaryRepunit_succ]; omega

lemma ternaryRepunit_mod_two (r : ℕ) : ternaryRepunit r % 2 = r % 2 := by
  induction r with
  | zero => simp [ternaryRepunit]
  | succ r ih =>
    rw [ternaryRepunit_succ]
    omega

/-- Every prime factor of a ternary repunit of odd prime length is larger
than that length. In particular these digit-restricted numbers can have no
prime factor in any prescribed finite range. -/
lemma prime_length_repunit_prime_factor {q p : ℕ} (hq : q.Prime) (hq2 : 2 < q)
    (hp : p.Prime) (hpn : p ∣ ternaryRepunit q) : q < p := by
  have hodd : q % 2 = 1 := hq.mod_two_eq_one_iff_ne_two.mpr (by omega)
  have hp2 : p ≠ 2 := by
    intro he
    subst p
    have hz := Nat.mod_eq_zero_of_dvd hpn
    rw [ternaryRepunit_mod_two, hodd] at hz
    contradiction
  letI : Fact p.Prime := ⟨hp⟩
  have hn : (ternaryRepunit q : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr hpn
  have hid := congrArg (fun n : ℕ => (n : ZMod p)) (ternaryRepunit_identity q)
  have hpow : (3 : ZMod p) ^ q = 1 := by
    push_cast at hid
    simpa [hn] using hid.symm
  have h3 : (3 : ZMod p) ≠ 0 := by
    intro hzero
    simp [hzero, Nat.ne_of_gt hq.pos] at hpow
  have hdivq : orderOf (3 : ZMod p) ∣ q := orderOf_dvd_iff_pow_eq_one.mpr hpow
  rcases hq.eq_one_or_self_of_dvd _ hdivq with ho | ho
  · have he : (3 : ZMod p) = 1 := orderOf_eq_one_iff.mp ho
    have he2 : (2 : ZMod p) = 0 := by linear_combination he
    have hpd : p ∣ 2 := (ZMod.natCast_eq_zero_iff 2 p).mp he2
    exact (hp2 ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd)).elim
  · have hdiv := ZMod.orderOf_dvd_card_sub_one h3
    rw [ho] at hdiv
    have hpge := hp.two_le
    have hle := Nat.le_of_dvd (by omega : 0 < p - 1) hdiv
    omega

/-- An elementary obstruction to a fixed finite-prime covering argument.
These examples are odd, and hence are not additional powers of two. -/
lemma arbitrarily_large_rough_good_numbers (B M : ℕ) :
    ∃ n : ℕ, M < n ∧ Nat.digits 3 n ⊆ [0, 1] ∧ ¬ n.isPowerOfTwo ∧
      ∀ p : ℕ, p.Prime → p ≤ B → ¬ p ∣ n := by
  obtain ⟨q, hq, hpq⟩ := Nat.exists_infinite_primes (max (max B M) 2 + 1)
  have hq2 : 2 < q := by omega
  refine ⟨ternaryRepunit q, lt_of_lt_of_le (by omega) (ternaryRepunit_ge q),
    ternaryRepunit_good q, ?_, ?_⟩
  · rintro ⟨k, hk⟩
    have ho := hpq.mod_two_eq_one_iff_ne_two.mpr (by omega : q ≠ 2)
    have hm : ternaryRepunit q % 2 = 1 := by rw [ternaryRepunit_mod_two, ho]
    rw [hk] at hm
    cases k with
    | zero => have := ternaryRepunit_ge q; simp at hk; omega
    | succ k => simp [pow_succ] at hm
  · intro p hp hpB hpd
    have := prime_length_repunit_prime_factor hpq hq2 hp hpd
    omega

/-- An odd prime factor of `3^q + 1`, for an odd prime `q`, is larger than `q`. -/
lemma prime_length_plus_one_prime_factor {q p : ℕ} (hq : q.Prime)
    (hp : p.Prime) (hp2 : p ≠ 2) (hpn : p ∣ 3 ^ q + 1) : q < p := by
  letI : Fact p.Prime := ⟨hp⟩
  have hn : ((3 ^ q + 1 : ℕ) : ZMod p) = 0 :=
    (ZMod.natCast_eq_zero_iff _ _).mpr hpn
  push_cast at hn
  have hneg : (3 : ZMod p) ^ q = -1 := eq_neg_of_add_eq_zero_left hn
  have hpow : (9 : ZMod p) ^ q = 1 := by
    rw [show (9 : ZMod p) = 3 ^ 2 by ring, pow_right_comm, hneg]
    ring
  have h9 : (9 : ZMod p) ≠ 0 := by
    intro hz
    simp [hz, Nat.ne_of_gt hq.pos] at hpow
  have hdivq : orderOf (9 : ZMod p) ∣ q := orderOf_dvd_iff_pow_eq_one.mpr hpow
  rcases hq.eq_one_or_self_of_dvd _ hdivq with ho | ho
  · have he : (9 : ZMod p) = 1 := orderOf_eq_one_iff.mp ho
    have he8 : (8 : ZMod p) = 0 := by linear_combination he
    have hpd : p ∣ 2 ^ 3 := (ZMod.natCast_eq_zero_iff 8 p).mp he8
    have hpd2 := hp.dvd_of_dvd_pow hpd
    exact (hp2 ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd2)).elim
  · have hdiv := ZMod.orderOf_dvd_card_sub_one h9
    rw [ho] at hdiv
    have hpge := hp.two_le
    have hle := Nat.le_of_dvd (by omega : 0 < p - 1) hdiv
    omega

lemma four_dvd_three_pow_odd_add_one {q : ℕ} (hq : Odd q) : 4 ∣ 3 ^ q + 1 := by
  obtain ⟨a, rfl⟩ := hq
  apply Nat.dvd_of_mod_eq_zero
  simp [pow_add, pow_mul, Nat.add_mod, Nat.mul_mod, Nat.pow_mod]

lemma good_mul_one_add_three_pow {n q : ℕ} (hn : 0 < n)
    (hd : Nat.digits 3 n ⊆ [0, 1]) (hq : (Nat.digits 3 n).length ≤ q) :
    Nat.digits 3 (n * (3 ^ q + 1)) ⊆ [0, 1] := by
  have he := Nat.digits_append_zeroes_append_digits (b := 3) (n := n) (m := n)
    (k := q - (Nat.digits 3 n).length) (by decide) hn
  rw [Nat.add_sub_of_le hq] at he
  have hv : n * (3 ^ q + 1) = n + 3 ^ q * n := by ring
  rw [hv, ← he]
  intro d hm
  simp only [List.mem_append, List.mem_replicate] at hm
  rcases hm with (hd' | ⟨_, rfl⟩) | hd'
  · exact hd hd'
  · simp
  · exact hd hd'

/-- Even among multiples of arbitrarily high powers of two, admissible
ternary words need not have any odd prime factor in a prescribed finite range.
The construction retains a nontrivial odd divisor, so gives no disproof of 406. -/
lemma rough_good_multiples_of_two (B K M : ℕ) :
    ∃ n : ℕ, M < n ∧ Nat.digits 3 n ⊆ [0, 1] ∧ 4 ^ K ∣ n ∧
      ¬ n.isPowerOfTwo ∧ ∀ p : ℕ, p.Prime → p ≠ 2 → p ≤ B → ¬ p ∣ n := by
  induction K with
  | zero =>
    obtain ⟨n, hn, hd, hnp, hrough⟩ := arbitrarily_large_rough_good_numbers B M
    refine ⟨n, hn, hd, by simp, hnp, ?_⟩
    intro p hp _ hpB
    exact hrough p hp hpB
  | succ K ih =>
    obtain ⟨n, hn, hd, hdiv, hnp, hrough⟩ := ih
    obtain ⟨q, hq, hpq⟩ := Nat.exists_infinite_primes
      (max (max B (Nat.digits 3 n).length) 2 + 1)
    have hq2 : 2 < q := by omega
    have hqodd : Odd q := hpq.odd_of_ne_two (by omega)
    have hfdiv := four_dvd_three_pow_odd_add_one hqodd
    have hfpos : 0 < 3 ^ q + 1 := by positivity
    refine ⟨n * (3 ^ q + 1), ?_, good_mul_one_add_three_pow (by omega) hd (by omega),
      ?_, ?_, ?_⟩
    · have : n ≤ n * (3 ^ q + 1) := by nlinarith
      omega
    · simpa [pow_succ] using Nat.mul_dvd_mul hdiv hfdiv
    · rintro ⟨k, hk⟩
      have hdn : n ∣ 2 ^ k := hk ▸ dvd_mul_right n (3 ^ q + 1)
      obtain ⟨j, _, hj⟩ := (Nat.dvd_prime_pow (by decide : Nat.Prime 2)).mp hdn
      exact hnp ⟨j, hj⟩
    · intro p hp hp2 hpB hpn
      rcases hp.dvd_mul.mp hpn with hpn | hpf
      · exact hrough p hp hp2 hpB hpn
      · have := prime_length_plus_one_prime_factor hpq hp hp2 hpf
        omega

end Erdos406Work


/-! A limitation of globally length-like potentials. This does not settle Erdős 406. -/

namespace Erdos406Work

lemma ternary_length_pow_log_le (q m : ℕ) (hq : 0 < q) :
    ((Nat.digits 3 (q ^ m)).length : ℝ) * Real.log 3 ≤
      Real.log 3 + (m : ℝ) * Real.log q := by
  have hb := Nat.base_pow_length_digits_le 3 (q ^ m) (by decide) (ne_of_gt (pow_pos hq _))
  have hb' : (3 : ℝ) ^ (Nat.digits 3 (q ^ m)).length ≤ 3 * (q : ℝ) ^ m := by
    exact_mod_cast hb
  have hl := Real.log_le_log (by positivity) hb'
  rw [Real.log_pow, Real.log_mul (by positivity) (by positivity), Real.log_pow] at hl
  exact hl

/-- If a potential grows by at least one along each multiplication by `q`,
then a *global* linear upper bound in ternary length cannot have subcritical
slope. A bound that holds only on `{0,1}` words is a different hypothesis. -/
lemma global_length_potential_slope_bound (q : ℕ) (hq : 0 < q)
    (V : ℕ → ℝ) (c C : ℝ) (hc : 0 ≤ c)
    (hupper : ∀ n : ℕ, 0 < n → V n ≤ c * (Nat.digits 3 n).length + C)
    (hgrow : ∀ m : ℕ, V (q ^ m) + 1 ≤ V (q ^ (m + 1))) :
    Real.log 3 ≤ c * Real.log q := by
  have hg : ∀ m : ℕ, V 1 + (m : ℝ) ≤ V (q ^ m) := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      have hh := hgrow m
      push_cast
      linarith
  have hlog : 0 < Real.log 3 := Real.log_pos (by norm_num)
  by_contra hbad
  have hd : 0 < Real.log 3 - c * Real.log q := by linarith
  obtain ⟨m, hm⟩ := exists_nat_gt
    (((C - V 1 + c) * Real.log 3) / (Real.log 3 - c * Real.log q))
  have hlarge : (C - V 1 + c) * Real.log 3 <
      (m : ℝ) * (Real.log 3 - c * Real.log q) := (div_lt_iff₀ hd).mp hm
  have hbound := (hg m).trans (hupper (q ^ m) (pow_pos hq m))
  have hlen := ternary_length_pow_log_le q m hq
  have hbound' := mul_le_mul_of_nonneg_right hbound (le_of_lt hlog)
  have hlen' := mul_le_mul_of_nonneg_left hlen hc
  nlinarith

/-- Bounded endpoint corrections cannot turn a uniformly subcritical length
potential into a strict ranking function along all powers of `q`. -/
lemma bounded_correction_potential_slope_bound (q : ℕ) (hq : 0 < q)
    (V E : ℕ → ℝ) (c C : ℝ) (hc : 0 ≤ c)
    (hform : ∀ n : ℕ, 0 < n → V n = c * (Nat.digits 3 n).length + E n)
    (herror : ∀ n : ℕ, 0 < n → |E n| ≤ C)
    (hgrow : ∀ m : ℕ, V (q ^ m) + 1 ≤ V (q ^ (m + 1))) :
    Real.log 3 ≤ c * Real.log q := by
  apply global_length_potential_slope_bound q hq V c C hc ?_ hgrow
  intro n hn
  rw [hform n hn]
  have he := (le_abs_self (E n)).trans (herror n hn)
  linarith

end Erdos406Work
