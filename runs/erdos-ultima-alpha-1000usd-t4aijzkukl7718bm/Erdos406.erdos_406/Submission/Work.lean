/-- `4^(3^r)` modulo a fixed modulus, computed by repeated cubing. -/
def towerMod (q : ℕ) : ℕ → ℕ
  | 0 => 4 % q
  | r + 1 => towerMod q r ^ 3 % q

lemma towerMod_eq (q r : ℕ) : towerMod q r = 4 ^ (3 ^ r) % q := by
  induction r with
  | zero => simp [towerMod]
  | succ r ih =>
    rw [towerMod, ih, show 3 ^ (r + 1) = 3 ^ r * 3 from pow_succ _ _, pow_mul]
    exact (Nat.pow_mod _ _ _).symm

/-- A modular sieve retaining one fixed-precision residue with each exponent. -/
def pairedExponentSieve (B R : ℕ) : ℕ → List (ℕ × ℕ)
  | 0 => [(0, 1)]
  | r + 1 =>
      let q := 3 ^ (R + 1)
      let t := towerMod q r
      ((pairedExponentSieve B R r).flatMap fun (a, c) =>
        [(a, c), (a + 3 ^ r, c * t % q), (a + 2 * 3 ^ r, c * t ^ 2 % q)]).filter
        fun (a, c) => decide (a < B ∧ 2 * (c % 3 ^ (r + 2)) < 3 ^ (r + 2))


lemma four_pow_reduce_exponent (r m : ℕ) :
    4 ^ (m % 3 ^ r) % 3 ^ (r + 1) = 4 ^ m % 3 ^ (r + 1) := by
  have hq : 1 < 3 ^ (r + 1) := one_lt_pow₀ (by decide) (by omega)
  have hp : Nat.ModEq (3 ^ (r + 1)) (4 ^ (3 ^ r)) 1 :=
    (four_pow_mod_eq_one_iff r (3 ^ r)).mpr (dvd_refl _)
  have hpp := hp.pow (m / 3 ^ r)
  rw [one_pow] at hpp
  change (4 ^ (3 ^ r)) ^ (m / 3 ^ r) % 3 ^ (r + 1) = 1 % 3 ^ (r + 1) at hpp
  have he : 4 ^ m = 4 ^ (m % 3 ^ r) * (4 ^ (3 ^ r)) ^ (m / 3 ^ r) := by
    rw [← pow_mul, ← pow_add, Nat.mod_add_div]
  rw [he, Nat.mul_mod, hpp, Nat.mod_eq_of_lt hq, mul_one, Nat.mod_mod]


lemma good_exponent_mem_paired_sieve {B R m : ℕ} (hmB : m < B)
    (hgood : Nat.digits 3 (4 ^ m) ⊆ [0, 1]) (r : ℕ) (hr : r ≤ R) :
    (m % 3 ^ r, 4 ^ (m % 3 ^ r) % 3 ^ (R + 1)) ∈ pairedExponentSieve B R r := by
  induction r with
  | zero =>
    have hq : 1 < 3 ^ (R + 1) := one_lt_pow₀ (by decide) (by omega)
    simp [pairedExponentSieve, Nat.mod_one, Nat.mod_eq_of_lt hq]
  | succ r ih =>
    rw [pairedExponentSieve, List.mem_filter]
    constructor
    · apply List.mem_flatMap.mpr
      refine ⟨(m % 3 ^ r, 4 ^ (m % 3 ^ r) % 3 ^ (R + 1)), ih (by omega), ?_⟩
      have he : m % 3 ^ (r + 1) = m % 3 ^ r + 3 ^ r * (m / 3 ^ r % 3) := by
        rw [pow_succ, Nat.mod_mul]
      have ht : m / 3 ^ r % 3 = 0 ∨ m / 3 ^ r % 3 = 1 ∨ m / 3 ^ r % 3 = 2 := by omega
      rcases ht with ht | ht | ht
      · simp [he, ht]
      · rw [ht, mul_one] at he
        rw [he]
        apply List.mem_cons_of_mem
        apply List.mem_cons.mpr
        left
        congr 1
        rw [towerMod_eq, pow_add]
        simp only [Nat.mul_mod, Nat.mod_mod]
      · rw [ht, Nat.mul_comm (3 ^ r) 2] at he
        rw [he]
        apply List.mem_cons_of_mem
        apply List.mem_cons_of_mem
        apply List.mem_cons.mpr
        left
        congr 1
        rw [towerMod_eq, pow_add, Nat.mul_comm 2 (3 ^ r), pow_mul]
        simp only [Nat.mul_mod, Nat.pow_mod, Nat.mod_mod]
    · simp only [decide_eq_true_eq]
      refine ⟨lt_of_le_of_lt (Nat.mod_le _ _) hmB, ?_⟩
      rw [Nat.mod_mod_of_dvd _ (pow_dvd_pow 3 (by omega : r + 2 ≤ R + 1))]
      rw [show r + 2 = (r + 1) + 1 by omega, four_pow_reduce_exponent]
      exact (digits_iff_no_carries (4 ^ m)).mp hgood (r + 1 + 1)

end Erdos406Work

