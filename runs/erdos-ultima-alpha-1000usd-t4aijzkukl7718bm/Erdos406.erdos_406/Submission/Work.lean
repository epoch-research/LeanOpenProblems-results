/-- The proposed pure-power cubic descent is equivalent to the stronger
classification conjecture. This lemma does not establish either side. -/
lemma classification_iff_pure_power_descent :
    (∀ m : ℕ, Nat.digits 3 (4 ^ m) ⊆ [0, 1] ↔ m = 0 ∨ m = 1 ∨ m = 4) ↔
    (∀ m : ℕ, Nat.digits 3 (4 ^ m) ⊆ [0, 1] →
      Nat.digits 3 (4 ^ (m / 3)) ⊆ [0, 1]) := by
  have hsmall : ∀ m : ℕ, m ≤ 14 →
      (Nat.digits 3 (4 ^ m) ⊆ [0, 1] ↔ m = 0 ∨ m = 1 ∨ m = 4) := by
    intro m hm
    interval_cases m <;> decide +kernel
  constructor
  · intro hc m hm
    apply (hc (m / 3)).mpr
    rcases (hc m).mp hm with rfl | rfl | rfl <;> decide
  · intro hd
    have hc : ∀ m : ℕ, Nat.digits 3 (4 ^ m) ⊆ [0, 1] →
        m = 0 ∨ m = 1 ∨ m = 4 := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro hm
        by_cases hzero : m = 0
        · exact Or.inl hzero
        have hlt : m / 3 < m := Nat.div_lt_self (Nat.pos_of_ne_zero hzero) (by decide)
        have hp := ih (m / 3) hlt (hd m hm)
        have hb : m ≤ 14 := by omega
        exact (hsmall m hb).mp hm
    intro m
    constructor
    · exact hc m
    · intro hm
      have hb : m ≤ 14 := by omega
      exact (hsmall m hb).mpr hm

end Erdos406Work

