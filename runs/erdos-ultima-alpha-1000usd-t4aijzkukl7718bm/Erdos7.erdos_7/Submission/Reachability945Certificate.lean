def Reach (j : ℕ) (x : ZMod 945) : Prop := (rows j).testBit x.val = true

lemma initial : Reach 0 0 := by unfold Reach; decide +kernel

lemma stay : ∀ i : Fin 15, ∀ x : ZMod 945,
    Reach i.val x → Reach (i.val+1) x := by
  unfold Reach
  decide +kernel

lemma move : ∀ i : Fin 15, ∀ x : ZMod 945,
    Reach i.val x → Reach (i.val+1) (x+frequency i) := by
  unfold Reach
  decide +kernel

lemma avoid : ∀ i : Fin 15, ¬ Reach i.val (-frequency i) := by
  unfold Reach
  decide +kernel

lemma arithmetic_data : Function.Injective modulus ∧
    (∀ i, 1 < modulus i ∧ Odd (modulus i) ∧ modulus i ∣ 945) ∧
    (∀ i, (modulus i : ZMod 945)*frequency i=0) := by
  decide +kernel

theorem zero_free : ∀ s : Finset (Fin 15), s.Nonempty → ∑ i ∈ s, frequency i ≠ 0 :=
  zero_free_of_reachability frequency Reach initial stay move avoid

theorem no_cover (a : Fin 15 → ℤ) :
    ¬ (∀ x : ℤ, ∃ i, (modulus i : ℤ) ∣ x-a i) :=
  not_arithmetic_cover modulus a frequency arithmetic_data.2.2 Reach initial stay move avoid

#print axioms zero_free
#print axioms no_cover
end Erdos7Reachability945
