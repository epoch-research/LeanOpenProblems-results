  have hlo := block_offset_mono (Nat.zero_le b) hb.le
  have hhi := block_offset_mono (show b+1 ≤ blockLength by omega) le_rfl
  rw [block_offset_zero] at hlo
  rw [block_offset_last,block_offset_succ b hb] at hhi
  omega

