    ∃ v : ℕ×ℕ,v.1 < blockLength ∧ v.2 < (blockControl v.1).count ∧ t=blockOffset v.1+v.2 := by
  obtain ⟨b,j,hb,hj,he⟩ := small_index_block t ht0 ht1
