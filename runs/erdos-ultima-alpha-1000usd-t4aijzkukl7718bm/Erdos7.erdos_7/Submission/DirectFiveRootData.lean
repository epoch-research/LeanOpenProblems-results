import Submission.NoFiveScalarData

/-! Exact candidate root row with one additional pure modulus-five class. -/
namespace Erdos7DirectFiveScalar
open Erdos7NoFiveScalar (State)
set_option maxRecDepth 200000
noncomputable def rootState : State :=
  ⟨(fun k => (((Nat.shiftRight  (64*k.val)) % 18446744073709551616 : ℕ) : ℚ)/1000000000000),
    6700729939313/1000000000000, (-1837)/20⟩
end Erdos7DirectFiveScalar
