lemma terminal_certificate :
    (∀ x : Fin 501, (states 366).values x=0) ∧
    (states 366).slope=0 ∧ (states 366).intercept=0 := by
  decide +kernel

lemma certificate :
    (∀ i : Fin 366, 3 ≤ primes i ∧ primes i ≤ 2503 ∧
      Row (primes i) (states i.castSucc) (states i.succ)) ∧
    (∀ x : Fin 501, (states 366).values x=0) ∧
    (states 366).slope=0 ∧ (states 366).intercept=0 := by
  refine ⟨?_,terminal_certificate⟩
  intro i
  fin_cases i
