def w (i : Fin 287) : ℚ := weight i

lemma modulus_injective : Function.Injective m := by
  have hs : StrictMono m := Fin.strictMono_iff_lt_succ.mpr (by decide +kernel)
  exact hs.injective
lemma odd_nontrivial : ∀ i, Odd (m i) ∧ 1 < m i := by decide +kernel
lemma modulus_dvd : ∀ i, m i ∣ 72747675 := by decide +kernel
lemma normalized_primes : ∀ i, (m i).Prime → a i = 0 := by decide +kernel
lemma unit_baseline : ∀ i, IsUnit (a i : ZMod (m i)) ↔ ¬ (m i).Prime := by
  simp only [ZMod.coe_int_isUnit_iff_isCoprime, Int.isCoprime_iff_nat_coprime,
    Int.natAbs_natCast]
  decide +kernel
lemma uncovered : ∀ i, (71166136 : ℤ) % m i ≠ a i := by decide +kernel

lemma contains_prime_factors : ∀ p ∈ Nat.primeFactors 72747675, ∃ i, m i = p := by
  decide +kernel
lemma prime_closed : ∀ j p, p.Prime → p ∣ m j → ∃ i, m i = p := by
  intro j p hp hpm
  exact contains_prime_factors p (Nat.mem_primeFactors.mpr
    ⟨hp,hpm.trans (modulus_dvd j),by decide⟩)

lemma totient_table : ∀ i, (m i).totient = totientTable i := by
  simp_rw [Nat.totient_eq_div_primeFactors_mul]
  decide +kernel
lemma weight_cross : ∀ i, weight i * totientTable i = 24883200 := by decide +kernel
lemma totient_positive : ∀ i, 0 < totientTable i := by decide +kernel

/-- Finite root-column checks, including the zero column. -/
lemma row_checks : ∀ i, (m i).Prime → ∀ t : Fin (m i),
    row m a w i t.val ≤ if t.val = 0 then 0 else w i := by
  unfold row composite w
  decide +kernel

lemma zero_global_minimum (c : ℤ) : score m a w 0 ≤ score m a w c := by
  exact zero_minimizes m a w (fun i => by unfold w; positivity) prime_closed
    unit_baseline (row_bound_of_finite m a w normalized_primes row_checks) c

lemma zero_score : score m a w 0 = 28871660 := by
  simp only [score, sub_zero, unit_baseline]
  decide +kernel

lemma weight_ratio (i : Fin 287) : w i / 24883200 = 1/((m i).totient : ℚ) := by
  rw [totient_table]
  have hh : (weight i : ℚ) * totientTable i = 24883200 := by exact_mod_cast weight_cross i
  have ht : (totientTable i : ℚ) ≠ 0 := by exact_mod_cast (totient_positive i).ne'
  unfold w
  apply (div_eq_div_iff (by norm_num : (24883200 : ℚ) ≠ 0) ht).mpr
  simpa using hh

attribute [local instance] Classical.propDecidable

/-- Every integer centre has unit-density score strictly greater than one.
This rules out a universal affine first-moment test for partial families. -/
theorem every_center_above_one (c : ℤ) :
    (1 : ℚ) < ∑ i : Fin 287,
      if IsUnit ((a i-c : ℤ) : ZMod (m i)) then 1/((m i).totient : ℚ) else 0 := by
  classical
  have hh := zero_global_minimum c
  rw [zero_score] at hh
  have hdiv : (1 : ℚ) < score m a w c / 24883200 := by
    apply (lt_div_iff₀ (by norm_num : (0 : ℚ) < 24883200)).mpr
    norm_num
    linarith
  rw [score, Finset.sum_div] at hdiv
  convert hdiv using 1
  apply Finset.sum_congr rfl
  intro i _
  by_cases hu : IsUnit ((a i-c : ℤ) : ZMod (m i))
  · simp only [if_pos hu]
    exact (weight_ratio i).symm
  · simp only [if_neg hu, zero_div]


#print axioms zero_global_minimum
#print axioms every_center_above_one
end Erdos7CenterDensityExample
