structure Control where
  p : ℕ
  A : ℕ
  B : ℕ
  R : ℕ
  cut : ℕ
  lossIndex : ℕ
  deriving BEq,ReflBEq,LawfulBEq,DecidableEq,Repr,Inhabited

structure State where
  mass : ℕ
  cubic : ℕ
  values : List ℕ
  deriving BEq,ReflBEq,LawfulBEq,DecidableEq,Repr,Inhabited

def ceilDiv (n d : ℕ) : ℕ := (n+d-1)/d

def initial : State := ⟨scale,scale,grid.map (fun g => (1-g)*scale)⟩

def denominator (p : ℕ) : ℕ := if p=3 then 3 else p-1

def loss (a : Control) (h : List ℕ) : ℕ :=
  let q := denominator a.p
  let j := a.lossIndex
  let l := grid.getD j 0
  let v := grid.getD (j+1) 0
  let u := q*(a.A-a.B)
  ceilDiv ((a.A*v-u)*(h.getD j 0)+(u-a.A*l)*(h.getD (j+1) 0)) (a.B*q*(v-l))

def interpNumerator (h : List ℕ) (d j : ℕ) : ℕ :=
  let v := ((cells.getD d []).getD j default)
  v.left*(h.getD v.lo 0)+v.right*(h.getD (v.lo+1) 0)

def rawValue (a : Control) (h : List ℕ) (j : ℕ) : ℕ :=
  let v := ceilDiv ((a.B*a.p-a.A)*(h.getD j 0)) (a.B*a.p)
  if a.p=3 then
    v+ceilDiv (a.A*interpNumerator h 2 j) (a.B*a.p*(((cells.getD 2 []).getD j default)).width)
  else
    let v := (List.range (a.R-1)).foldl (fun v g =>
      let d := g+2
      v+ceilDiv (a.A*(a.p-1)*interpNumerator h d j)
        (a.B*a.p^d*(((cells.getD d []).getD j default)).width)) v
    let q := denominator a.p
    v+ceilDiv (a.A*((a.R+1)*q+1)*(h.getD 0 0)) (a.B*a.p^a.R*q)

def rawValues (a : Control) (h : List ℕ) : List ℕ :=
  grid.mapIdx (fun j _ => rawValue a h j)

def step (a : Control) (s : State) : State :=
  let m := s.mass-loss a s.values
  let cutValue := rawValue a s.values a.cut
  let V := grid.mapIdx (fun j gj =>
    let v := rawValue a s.values j
    if j ≤ a.cut then min v (cutValue+((grid.getD a.cut 0)-gj)*m) else v)
  let q := denominator a.p
  let C := if a.p=3 then ceilDiv (s.cubic*(a.B*a.p+7*a.A)) (a.B*a.p)
    else ceilDiv (s.cubic*(a.B*q^3+a.A*(7*a.p*a.p-2*a.p+1))) (a.B*q^3)
  ⟨m,C,V⟩

end Erdos7GridCertificate
