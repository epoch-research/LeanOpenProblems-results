def hallSet (t : Fin 28) (r : Fin 3) (u : Fin 4) (s : Fin 5) : Finset (Fin 96) :=
  Finset.univ.filter (fun i => Active t r u s i ∧
    drop t.val (exponent3 i) ≤ upper3 t r u s ∧
    drop u.val (exponent5 i) ≤ upper5 t r u s)

/-- Each policy has a concrete rectangular Hall deficit. This finite check
never enumerates the astronomical period or its integers. -/
lemma hall_count : ∀ t : Fin 28, ∀ r : Fin 3, ∀ u : Fin 4, ∀ s : Fin 5,
    (upper3 t r u s+1)*(upper5 t r u s+1) ≤ (hallSet t r u s).card := by
  decide +kernel

/-- No constant simultaneous deletion at 3 and 5 admits an injective assignment
of ALL active classes to nontrivial divisors of their projected moduli. -/
theorem no_constant_divisor_assignment
    (t : Fin 28) (r : Fin 3) (u : Fin 4) (s : Fin 5) :
    ¬ ∃ f : Fin 96 → ℕ,
      (∀ i, Active t r u s i → 1 < f i ∧ f i ∣ projected t u i) ∧
      (∀ i j, Active t r u s i → Active t r u s j → f i=f j → i=j) := by
  apply Erdos7JointDivisorCapacity.no_assignment (hallSet t r u s)
    (Active t r u s) (projected t u)
    (by norm_num : Nat.Prime 3) (by norm_num : Nat.Prime 5)
    (by decide : Nat.Coprime 3 5) (upper3 t r u s) (upper5 t r u s)
  · intro i hi
    obtain ⟨_,ha,h3,h5⟩ := Finset.mem_filter.mp hi
    exact ⟨ha,Nat.mul_dvd_mul (Nat.pow_dvd_pow 3 h3) (Nat.pow_dvd_pow 5 h5)⟩
  · exact hall_count t r u s

/- The obstruction above is specifically to CONSTANT deletion policies.
The following branch-dependent simultaneous policy has a strict image. -/

def position5 (x : Fin 4 → Fin 5) : Fin 4 := if x 0=4 then 1 else 2
def value5 (x : Fin 4 → Fin 5) : Fin 5 := if x 0=4 then 2 else 0

/-- Position and retained value depend only on a digit already read. -/
theorem policy_predictable (x y : Fin 4 → Fin 5)
    (h : ∀ j : Fin 4, j.val < (position5 x).val → x j=y j) :
    position5 x=position5 y ∧ value5 x=value5 y := by
  have h0 : 0 < (position5 x).val := by
    unfold position5
    split <;> decide
  have he := h 0 h0
  simp [position5,value5,he]

def word5 (a : ℕ) : Fin 4 → Fin 5 :=
  fun j => ⟨a/5^j.val%5,Nat.mod_lt _ (by decide)⟩

def adaptiveActive (i : Fin 96) : Prop :=
  (exponent3 i=0 ∨ residueN i%3=2) ∧
  (exponent5 i ≤ (position5 (word5 (residueN i))).val ∨
    residueN i / 5^(position5 (word5 (residueN i))).val % 5 =
      (value5 (word5 (residueN i))).val)

instance (i : Fin 96) : Decidable (adaptiveActive i) :=
  inferInstanceAs (Decidable (_ ∧ _))

def adaptiveProjected (i : Fin 96) : ℕ :=
  3^(drop 0 (exponent3 i))*
    5^(drop (position5 (word5 (residueN i))).val (exponent5 i))

lemma adaptive_active_exact : ∀ i : Fin 96,
    adaptiveActive i ↔ i.val=0 ∨ 24 ≤ i.val := by decide +kernel

/-- This policy leaves exactly the old 5-class and the 72 new classes active.
Their projected moduli are already distinct; no divisor repair is needed. -/
theorem adaptive_image_strict :
    (∀ i, adaptiveActive i → 1 < adaptiveProjected i ∧
      Odd (adaptiveProjected i) ∧ adaptiveProjected i ∣ 3^27*5^3) ∧
    (∀ i j, adaptiveActive i → adaptiveActive j →
      adaptiveProjected i=adaptiveProjected j → i=j) := by
  decide +kernel

