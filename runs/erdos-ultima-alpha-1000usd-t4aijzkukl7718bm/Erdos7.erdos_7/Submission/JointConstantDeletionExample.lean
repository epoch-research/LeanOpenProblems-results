def residue (i : Fin 96) : ℤ := residueN i
def privatePoint (i : Fin 96) : ℤ := privateN i

theorem arithmetic_data :
    Function.Injective modulus ∧
    (∀ i, 1 < modulus i ∧ Odd (modulus i) ∧ modulus i ∣ 3^28*5^4) ∧
    (∀ i j, (modulus j : ℤ) ∣ privatePoint i-residue j ↔ j=i) ∧
    (∀ i, ¬ (modulus i : ℤ) ∣ 2-residue i) ∧
    (∀ i, modulus i = 3^exponent3 i*5^exponent5 i) := by
  decide +kernel

lemma shape_bounds : ∀ k : Fin 96,
    exponent3 k ≤ 28 ∧ exponent5 k ≤ 4 ∧
      (exponent3 k ≤ 4 ∨ exponent5 k ≤ 2) := by decide +kernel

lemma shape_index : ∀ a : Fin 29, ∀ b : Fin 5,
    0 < a.val+b.val → (a.val ≤ 4 ∨ b.val ≤ 2) →
    ∃ k : Fin 96, exponent3 k=a.val ∧ exponent5 k=b.val := by decide +kernel

theorem divisor_closed (i : Fin 96) (d : ℕ) (hd : d ∣ modulus i) (h1 : 1 < d) :
    ∃ k : Fin 96, modulus k=d := by
  have hpow := arithmetic_data.2.2.2.2 i
  rw [hpow] at hd
  obtain ⟨a,ha,b,hb,he⟩ := Erdos7JointDivisorCapacity.divisor_rectangle
    (by norm_num : Nat.Prime 3) (by norm_num : Nat.Prime 5) hd
  obtain ⟨ha28,hb4,hshape⟩ := shape_bounds i
  have ha' : a < 29 := by omega
  have hb' : b < 5 := by omega
  have hp : 0 < a+b := by
    by_contra! h
    have ha0 : a=0 := by omega
    have hb0 : b=0 := by omega
    simp only [ha0,hb0,pow_zero,mul_one] at he
    omega
  have hs : a ≤ 4 ∨ b ≤ 2 := by rcases hshape with h | h <;> omega
  obtain ⟨k,hk3,hk5⟩ := shape_index ⟨a,ha'⟩ ⟨b,hb'⟩ hp hs
  refine ⟨k,?_⟩
  rw [arithmetic_data.2.2.2.2 k,hk3,hk5,←he]

/-- Constant deletion at one position in each prime coordinate. -/
def Active (t : Fin 28) (r : Fin 3) (u : Fin 4) (s : Fin 5) (i : Fin 96) : Prop :=
  (exponent3 i ≤ t.val ∨ residueN i / 3^t.val % 3 = r.val) ∧
  (exponent5 i ≤ u.val ∨ residueN i / 5^u.val % 5 = s.val)

instance (t : Fin 28) (r : Fin 3) (u : Fin 4) (s : Fin 5) (i : Fin 96) :
    Decidable (Active t r u s i) := inferInstanceAs (Decidable (_ ∧ _))

def drop (t e : ℕ) : ℕ := if t < e then e-1 else e

def projected (t : Fin 28) (u : Fin 4) (i : Fin 96) : ℕ :=
  3^(drop t.val (exponent3 i))*5^(drop u.val (exponent5 i))

