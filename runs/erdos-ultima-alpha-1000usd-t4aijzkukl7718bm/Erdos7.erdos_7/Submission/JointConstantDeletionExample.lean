#print axioms divisor_closed
#print axioms hall_count
#print axioms no_constant_divisor_assignment
#print axioms policy_predictable
#print axioms adaptive_active_exact
#print axioms adaptive_image_strict
end Erdos7JointConstantDeletionExample
