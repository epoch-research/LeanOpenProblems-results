def hole : ℤ := 6432229774

theorem finite_check : classes.all (fun ma => decide
    (1 < ma.1 ∧ Odd ma.1 ∧ ¬ 3 ∣ ma.1 ∧
     ¬ (ma.1 : ℤ) ∣ hole - ma.2)) = true := by
  decide +kernel

theorem misses_every_class (m : ℕ) (a : ℤ) (h : (m,a) ∈ classes) :
    ¬ (m : ℤ) ∣ hole-a := by
  have hh := (List.all_eq_true.mp finite_check) (m,a) h
  exact (of_decide_eq_true hh).2.2.2

theorem not_cover :
    ¬ (∀ x : ℤ, ∃ ma ∈ classes, (ma.1 : ℤ) ∣ x-ma.2) := by
  intro hc
  obtain ⟨⟨m,a⟩,hmem,hcover⟩ := hc hole
  exact misses_every_class m a hmem hcover

#print axioms finite_check
#print axioms misses_every_class
#print axioms not_cover
end Erdos7TwofoldPrefixHole
