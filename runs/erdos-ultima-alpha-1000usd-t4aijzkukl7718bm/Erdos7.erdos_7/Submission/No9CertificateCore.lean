structure PrefixControl where
  p : ℕ
  A : ℕ
  B : ℕ
  R : ℕ
  cut : ℕ
  lossIndex : ℕ
  deriving BEq,ReflBEq,LawfulBEq,DecidableEq,Repr,Inhabited

structure State where
  mass : ℕ
  cubic : ℕ
  values : ℕ → ℕ

def ceilDiv (n d : ℕ) : ℕ := (n+d-1)/d
def initial : State := ⟨scale,scale,fun j => (1-grid j)*scale⟩
def denominator (p : ℕ) : ℕ := if p=3 then 3 else p-1

def loss (a : PrefixControl) (h : ℕ → ℕ) : ℕ :=
  let q := denominator a.p
  let j := a.lossIndex
  let l := grid j
  let v := grid (j+1)
  let u := q*(a.A-a.B)
  ceilDiv ((a.A*v-u)*h j+(u-a.A*l)*h (j+1)) (a.B*q*(v-l))

def interpNumerator (h : ℕ → ℕ) (d j : ℕ) : ℕ :=
  let v := cells d j
  v.left*h v.lo+v.right*h (v.lo+1)

def offdiag (p R A B : ℕ) (h : ℕ → ℕ) (j : ℕ) : ℕ :=
  let v := (List.range (R-1)).foldl (fun v g =>
    let d := g+2
    v+ceilDiv (A*(p-1)*interpNumerator h d j) (B*p^d*(cells d j).width)) 0
  v+ceilDiv (A*((R+1)*(p-1)+1)*h 0) (B*p^R*(p-1))

def rawValue (a : PrefixControl) (h : ℕ → ℕ) (j : ℕ) : ℕ :=
  let v := ceilDiv ((a.B*a.p-a.A)*h j) (a.B*a.p)
  if a.p=3 then
    v+ceilDiv (a.A*interpNumerator h 2 j) (a.B*a.p*(cells 2 j).width)
  else v+offdiag a.p a.R a.A a.B h j

def step (a : PrefixControl) (s : State) : State :=
  let m := s.mass-loss a s.values
  let cutValue := rawValue a s.values a.cut
  let V := fun j =>
    let v := rawValue a s.values j
    if j ≤ a.cut then min v (cutValue+(grid a.cut-grid j)*m) else v
  let q := denominator a.p
  let C := if a.p=3 then ceilDiv (s.cubic*(a.B*a.p+7*a.A)) (a.B*a.p)
    else ceilDiv (s.cubic*(a.B*q^3+a.A*(7*a.p*a.p-2*a.p+1))) (a.B*q^3)
  ⟨m,C,V⟩

def checkState (s v : State) : Bool :=
  s.mass==v.mass && s.cubic==v.cubic && (List.range nodes).all (fun j => s.values j==v.values j)


structure BlockControl where
  lo : ℕ
  hi : ℕ
  count : ℕ
  R : ℕ
  cut : ℕ
  lossIndex : ℕ
  a0 : ℕ
  a1 : ℕ
  a2 : ℕ
  a3 : ℕ
  remainder : ℕ
  deriving BEq,ReflBEq,LawfulBEq,DecidableEq,Repr,Inhabited

def blockUniform (b : BlockControl) (h y1 y2 y3 : ℕ → ℕ) (j : ℕ) : ℕ :=
  h j+b.count*y1 j+(b.count.choose 2)*y2 j+(b.count.choose 3)*y3 j+
    ceilDiv (b.remainder*h 0) coefficientScale

def blockRaw (b : BlockControl) (h y1 y2 y3 : ℕ → ℕ) (j : ℕ) : ℕ :=
  ceilDiv (b.a0*h j) coefficientScale+ceilDiv (b.a1*y1 j) coefficientScale+
    ceilDiv (b.a2*y2 j) coefficientScale+ceilDiv (b.a3*y3 j) coefficientScale+
    ceilDiv (b.remainder*h 0) coefficientScale

def blockLoss (b : BlockControl) (h y1 y2 y3 : ℕ → ℕ) : ℕ :=
  let j := b.lossIndex
  let l := grid j
  let v := grid (j+1)
  let q := b.lo-1
  let U := blockUniform b h y1 y2 y3
  ceilDiv ((5*v-q)*U j+(q-5*l)*U (j+1)) (4*q*(v-l))

def blockStep (b : BlockControl) (s : State) (y1 y2 y3 : ℕ → ℕ) : State :=
  let m := s.mass-b.count*blockLoss b s.values y1 y2 y3
  let raw := blockRaw b s.values y1 y2 y3
  let V := fun j => if j ≤ b.cut then min (raw j) (raw b.cut+(grid b.cut-grid j)*m) else raw j
  let q := b.lo-1
  let fn := 4*q^3+5*(7*b.lo*b.lo-2*b.lo+1)
  let fd := 4*q^3
  ⟨m,ceilDiv (s.cubic*fn^b.count) (fd^b.count),V⟩

def checkValues (h v : ℕ → ℕ) (start count : ℕ) : Bool :=
  (List.range' start count).all (fun j => h j==v j)

