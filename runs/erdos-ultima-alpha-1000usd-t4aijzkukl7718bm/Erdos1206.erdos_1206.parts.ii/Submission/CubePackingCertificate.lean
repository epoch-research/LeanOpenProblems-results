lemma packing31_harmonic_bound : SmoothCubeHarmonicBound packing31Primes
    (smoothReciprocalMass packing31Primes - (6559361803 : ℝ) / 10000000000) := by
  have hm : cubePackingMass packing31Edges = 6559361803 := by decide +kernel
  have hh := smooth_harmonic_bound_of_cube_packing packing31Primes 10000000000
    (by norm_num) packing31Edges (fun e he => (packing31_valid e he).1)
    (fun e he n hn => Nat.mem_factoredNumbers_of_dvd packing31_factorBase_smooth
      ((packing31_valid e he).2 n hn)) packing31_capacity
  simpa only [hm] using hh

lemma totient_prod_distinct_primes (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p) :
    (P.prod id).totient = ∏ p ∈ P, (p-1) := by
  induction P using Finset.induction_on with
  | empty => simp
  | @insert p P hp ih =>
    have hpr := hP p (by simp)
    have hPr : ∀ q ∈ P, Nat.Prime q := fun q hq => hP q (by simp [hq])
    have hc : Nat.Coprime p (P.prod id) := by
      apply Nat.coprime_prod_right_iff.mpr
      intro q hq
      apply hpr.coprime_iff_not_dvd.mpr
      intro hd
      have heq := (Nat.prime_dvd_prime_iff_eq hpr (hPr q hq)).mp hd
      exact hp (heq ▸ hq)
    rw [prod_insert hp,prod_insert hp]
    change (p * P.prod id).totient = _
    rw [Nat.totient_mul hc,Nat.totient_prime hpr,ih hPr]

lemma cube_sidon_lowerDensity_le_nine_tenths {A : Set ℕ}
    (hA : IsSidon ((fun n : ℕ => n^3) '' A)) : A.lowerDensity ≤ (9 : ℝ) / 10 := by
  have hp : ∀ p ∈ packing31Primes, Nat.Prime p := by norm_num [packing31Primes]
  have hprod : packing31Primes.prod id = 200560490130 := by
    norm_num [packing31Primes,Finset.prod_insert,Finset.prod_singleton]
  have ht : (packing31Primes.prod id).totient = 30656102400 := by
    rw [totient_prod_distinct_primes packing31Primes hp]
    norm_num [packing31Primes,Finset.prod_insert,Finset.prod_singleton]
  have he : smoothReciprocalMass packing31Primes = (86822723 : ℝ) / 13271040 := by
    unfold smoothReciprocalMass
    rw [Finset.filter_eq_self.mpr hp]
    norm_num [packing31Primes,Finset.prod_insert,Finset.prod_singleton]
  have hh := cube_sidon_lowerDensity_le_totient_smooth_bound hA packing31Primes hp
    packing31_harmonic_bound
  rw [ht,hprod,he] at hh
  exact hh.trans (by norm_num)

