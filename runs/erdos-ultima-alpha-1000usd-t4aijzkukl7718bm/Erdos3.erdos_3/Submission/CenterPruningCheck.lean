import Submission.Reduction

/-! Exact finite testing of an attempted logarithmic center-pruning bound.
The disproof below concerns only that auxiliary bound, not Erdős 3. -/

namespace Erdos3CenterPruningCheck

open Erdos3Reduction
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def core (S : Finset ℕ) : Finset ℕ :=
  S.filter (fun b ↦ ∃ a ∈ S, a < b ∧ 2 * b - a ∈ S)

lemma mem_core {S : Finset ℕ} {b : ℕ} :
    b ∈ core S ↔ b ∈ S ∧ ∃ a ∈ S, a < b ∧ 2 * b - a ∈ S := by
  simp only [core, Finset.mem_filter]

lemma core_mono : Monotone core := by
  intro S T h b hb
  obtain ⟨hbS, a, haS, hab, hcS⟩ := mem_core.mp hb
  exact mem_core.mpr ⟨h hbS, a, h haS, hab, h hcS⟩

/-- Each layer removed by center-pruning is 3-AP-free. -/
lemma removed_layer_threeAPFree (S : Finset ℕ) :
    ThreeAPFree ((S \ core S : Finset ℕ) : Set ℕ) := by
  intro a ha b hb c hc heq
  obtain ⟨haS, _⟩ := Finset.mem_sdiff.mp ha
  obtain ⟨hbS, hbnot⟩ := Finset.mem_sdiff.mp hb
  obtain ⟨hcS, _⟩ := Finset.mem_sdiff.mp hc
  by_contra hne
  apply hbnot
  apply mem_core.mpr
  refine ⟨hbS, ?_⟩
  rcases lt_or_gt_of_ne hne with hab | hba
  · refine ⟨a, haS, hab, ?_⟩
    have : 2 * b - a = c := by omega
    simpa only [this] using hcS
  · refine ⟨c, hcS, by omega, ?_⟩
    have : 2 * b - c = a := by omega
    simpa only [this] using haS

def prune (S : Finset ℕ) : ℕ → Finset ℕ
  | 0 => S
  | j + 1 => core (prune S j)

def FourFree (S : Finset ℕ) : Prop :=
  ∀ a ∈ S, ∀ b ∈ S, a < b → (2 * b - a ∉ S ∨ 3 * b - 2 * a ∉ S)

instance (S : Finset ℕ) : Decidable (FourFree S) := by
  unfold FourFree
  infer_instance

lemma FourFree.free {S : Finset ℕ} (h : FourFree S) :
    (S : Set ℕ).IsAPOfLengthFree (4 : ℕ) := by
  rw [free_iff_not_hasNatAP (by norm_num : 2 ≤ 4)]
  rintro ⟨a, d, hd, hmem⟩
  have ha := hmem 0 (by norm_num)
  have hb := hmem 1 (by norm_num)
  simp only [zero_mul, add_zero, one_mul] at ha hb
  rcases h a ha (a + d) hb (by omega) with hc | he
  · apply hc
    have : 2 * (a + d) - a = a + 2 * d := by omega
    simpa only [this] using hmem 2 (by norm_num)
  · apply he
    have : 3 * (a + d) - 2 * a = a + 3 * d := by omega
    simpa only [this] using hmem 3 (by norm_num)

