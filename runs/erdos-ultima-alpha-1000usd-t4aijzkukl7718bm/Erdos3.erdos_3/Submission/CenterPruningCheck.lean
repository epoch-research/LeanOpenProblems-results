lemma layer_subset_prune : ∀ j ≤ 13, layer j ⊆ prune (layer 0) j := by
  intro j
  induction j with
  | zero => intro hj; exact Finset.Subset.refl _
  | succ j ih =>
    intro hj
    exact (certificate ⟨j, by omega⟩).trans (core_mono (ih (by omega)))

lemma thirteen_rounds_nonempty : (prune (layer 0) 13).Nonempty :=
  ⟨1334, layer_subset_prune 13 le_rfl root_mem⟩

/-- A 4-AP-free set below N can survive j center-pruning rounds with 2^j>N.
This refutes the proposed binary-depth estimate only, not all O(log N) estimates. -/
theorem binary_depth_bound_fails :
    ¬ (∀ S : Finset ℕ, ∀ N j : ℕ,
      (∀ x ∈ S, x < N) → (S : Set ℕ).IsAPOfLengthFree (4 : ℕ) →
      (prune S j).Nonempty → 2 ^ j ≤ N) := by
  intro h
  have hbad := h (layer 0) 4096 13 witness_bound witness_free.free thirteen_rounds_nonempty
  norm_num at hbad

