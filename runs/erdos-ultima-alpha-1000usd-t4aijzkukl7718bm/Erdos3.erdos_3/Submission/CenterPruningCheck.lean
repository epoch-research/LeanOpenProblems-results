def layer (j : ℕ) : Finset ℕ := (layerList j).toFinset

def freeTest (L : List ℕ) (mask : ℕ) : Bool :=
  L.all (fun a ↦ mask.testBit a) &&
    L.all (fun a ↦ L.all (fun b ↦ decide (b ≤ a) ||
      !(mask.testBit (2*b-a)) || !(mask.testBit (3*b-2*a))))

lemma freeTest_correct {L : List ℕ} {mask : ℕ} (h : freeTest L mask = true) :
    FourFree L.toFinset := by
  simp only [freeTest, Bool.and_eq_true, List.all_eq_true, Bool.or_eq_true,
    decide_eq_true_eq, Bool.not_eq_true', Bool.eq_false_iff] at h
  intro a ha b hb hab
  have hh := h.2 a (List.mem_toFinset.mp ha) b (List.mem_toFinset.mp hb)
  simp only [List.mem_toFinset]
  rcases hh with (hh | hh) | hh
  · omega
  · exact Or.inl (fun hm ↦ hh (h.1 _ hm))
  · exact Or.inr (fun hm ↦ hh (h.1 _ hm))

def witnessMask : ℕ := 

lemma witness_free : FourFree (layer 0) := by
  apply freeTest_correct (mask := witnessMask)
  decide +kernel

def stepTest (L : List ℕ) (pairs : List (ℕ × ℕ)) : Bool :=
  pairs.all (fun (b,a) ↦ L.contains b && L.contains a &&
    decide (a < b) && L.contains (2*b-a))

lemma stepTest_correct {L : List ℕ} {pairs : List (ℕ × ℕ)}
    (h : stepTest L pairs = true) :
    (pairs.map Prod.fst).toFinset ⊆ core L.toFinset := by
  simp only [stepTest, List.all_eq_true, Bool.and_eq_true, List.contains_eq_mem,
    decide_eq_true_eq] at h
  intro b hb
  obtain ⟨⟨b', a⟩, hp, heq⟩ := List.mem_map.mp (List.mem_toFinset.mp hb)
  dsimp only at heq
  subst b'
  obtain ⟨⟨⟨hbL, haL⟩, hab⟩, hcL⟩ := h (b,a) hp
  exact mem_core.mpr ⟨List.mem_toFinset.mpr hbL, a,
    List.mem_toFinset.mpr haL, hab, List.mem_toFinset.mpr hcL⟩

