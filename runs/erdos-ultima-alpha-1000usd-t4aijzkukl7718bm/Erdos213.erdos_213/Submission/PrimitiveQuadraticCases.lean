def lineType (ax ay bx byy cx cy : ℝ) : Prop :=
  ax*byy-ay*bx=0 ∧ ax*cy-ay*cx=0 ∧ bx*cy-byy*cx=0
def nullType (ax ay bx byy cx cy : ℝ) : Prop :=
  bx^2-byy^2-4*(ax*cx-ay*cy)=0 ∧ 2*bx*byy-4*(ax*cy+ay*cx)=0

