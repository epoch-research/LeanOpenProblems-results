  have hT0 : (4*cx^4 + 9*cx^2 : ℝ)=0 := by
    linear_combination (1/128*bx*cx^2 + 1/128*byy*cx*cy + 5/256*byy*cx - 1/8*cx^2)*h00 + (-1/128*byy*cx^2 - 1/16*cx*cy - 5/32*cx)*h01 + (-1/128*bx*cx^2 - 1/128*byy*cx*cy - 5/256*byy*cx - 1/8*cx^2)*h10 + (1/128*byy*cx^2 - 1/16*cx*cy - 5/32*cx)*h11 + (-1/3*cx^3 - 2/3*cx*cy - 5/12*cx)*h21 + (1/3*cx^3 + 1/6*cx*cy + 5/3*cx)*h31
  have hT1 : (ax - 4*cx : ℝ)=0 := by
    linear_combination (1/3)*h21 + (-1/3)*h31
  have hT2 : (bx : ℝ)=0 := by
    linear_combination (1/32)*h00 + (-1/32)*h10
  have hc : cx=0 := by nlinarith only [hT0,sq_nonneg cx,sq_nonneg (cx^2)]
  exact Or.inl ⟨by linarith only [hT1,hc],hT2,hc⟩

lemma case_QQLQ (ax ay bx byy cx cy : ℝ)
    (h0 : nullType (ax) (ay) (bx + 8) (byy) (cx) (cy))
    (h1 : nullType (ax) (ay) (bx - 8) (byy) (cx) (cy))
    (h2 : lineType (ax) (ay - 4) (bx) (byy) (cx) (cy + 4))
    (h3 : nullType (ax) (ay - 16) (bx) (byy) (cx) (cy + 1))
    : (ax=0 ∧ bx=0 ∧ cx=0) ∨ (ay=0 ∧ byy=0 ∧ cy=0) := by
  rcases h0 with ⟨h00,h01⟩
  rcases h1 with ⟨h10,h11⟩
  rcases h2 with ⟨h20,h21,h22⟩
  rcases h3 with ⟨h30,h31⟩
  have hT0 : (ax : ℝ)=0 := by
    linear_combination (-1/18*cx)*h00 + (-1/18*cy - 7/72)*h01 + (-1/18*cx)*h10 + (-1/18*cy - 7/72)*h11 + (4/9)*h21 + (1/9*cx)*h30 + (1/9*cy + 7/36)*h31
  have hT1 : (bx : ℝ)=0 := by
    linear_combination (1/32)*h00 + (-1/32)*h10
  have hT2 : (cx : ℝ)=0 := by
    linear_combination (-1/288*cx)*h00 + (-1/288*cy - 1/72)*h01 + (-1/288*cx)*h10 + (-1/288*cy - 1/72)*h11 + (1/36)*h21 + (1/144*cx)*h30 + (1/144*cy + 1/36)*h31
  exact Or.inl ⟨hT0,hT1,hT2⟩

lemma case_QQQL (ax ay bx byy cx cy : ℝ)
    (h0 : nullType (ax) (ay) (bx + 8) (byy) (cx) (cy))
    (h1 : nullType (ax) (ay) (bx - 8) (byy) (cx) (cy))
    (h2 : nullType (ax) (ay - 4) (bx) (byy) (cx) (cy + 4))
    (h3 : lineType (ax) (ay - 16) (bx) (byy) (cx) (cy + 1))
    : (ax=0 ∧ bx=0 ∧ cx=0) ∨ (ay=0 ∧ byy=0 ∧ cy=0) := by
  rcases h0 with ⟨h00,h01⟩
  rcases h1 with ⟨h10,h11⟩
  rcases h2 with ⟨h20,h21⟩
  rcases h3 with ⟨h30,h31,h32⟩
  have hT0 : (ax : ℝ)=0 := by
    linear_combination (-1/288*cx)*h00 + (-1/288*cy + 1/36)*h01 + (-1/288*cx)*h10 + (-1/288*cy + 1/36)*h11 + (1/144*cx)*h20 + (1/144*cy - 1/18)*h21 + (1/9)*h31
  have hT1 : (bx : ℝ)=0 := by
    linear_combination (1/32)*h00 + (-1/32)*h10
  have hT2 : (cx : ℝ)=0 := by
    linear_combination (-1/288*cx)*h00 + (-1/288*cy - 1/288)*h01 + (-1/288*cx)*h10 + (-1/288*cy - 1/288)*h11 + (1/144*cx)*h20 + (1/144*cy + 1/144)*h21 + (1/9)*h31
  exact Or.inl ⟨hT0,hT1,hT2⟩

lemma case_QQQQ (ax ay bx byy cx cy : ℝ)
    (h0 : nullType (ax) (ay) (bx + 8) (byy) (cx) (cy))
    (h1 : nullType (ax) (ay) (bx - 8) (byy) (cx) (cy))
    (h2 : nullType (ax) (ay - 4) (bx) (byy) (cx) (cy + 4))
    (h3 : nullType (ax) (ay - 16) (bx) (byy) (cx) (cy + 1))
    : (ax=0 ∧ bx=0 ∧ cx=0) ∨ (ay=0 ∧ byy=0 ∧ cy=0) := by
  rcases h0 with ⟨h00,h01⟩
  rcases h1 with ⟨h10,h11⟩
  rcases h2 with ⟨h20,h21⟩
  rcases h3 with ⟨h30,h31⟩
  have hT0 : (1 : ℝ)=0 := by
    linear_combination (-25/18432*bx + 5/1152*cy + 17/1152)*h00 + (25/18432*byy + 5/1152*cx)*h01 + (25/18432*bx + 5/1152*cy + 17/1152)*h10 + (-25/18432*byy + 5/1152*cx)*h11 + (-5/432*cy - 1/216)*h20 + (-5/432*cx)*h21 + (5/1728*cy + 1/54)*h30 + (5/1728*cx)*h31
  exfalso
  norm_num at hT0

theorem extension_types_axes (ax ay bx byy cx cy : ℝ)
    (h0 : lineType ax ay (bx+8) byy cx cy ∨ nullType ax ay (bx+8) byy cx cy)
    (h1 : lineType ax ay (bx-8) byy cx cy ∨ nullType ax ay (bx-8) byy cx cy)
    (h2 : lineType ax (ay-4) bx byy cx (cy+4) ∨ nullType ax (ay-4) bx byy cx (cy+4))
    (h3 : lineType ax (ay-16) bx byy cx (cy+1) ∨ nullType ax (ay-16) bx byy cx (cy+1)) :
    (ax=0 ∧ bx=0 ∧ cx=0) ∨ (ay=0 ∧ byy=0 ∧ cy=0) := by
  rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;>
    rcases h2 with h2 | h2 <;> rcases h3 with h3 | h3
  · exact case_LLLL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LLLQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LLQL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LLQQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LQLL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LQLQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LQQL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_LQQQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QLLL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QLLQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QLQL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QLQQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QQLL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QQLQ ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QQQL ax ay bx byy cx cy h0 h1 h2 h3
  · exact case_QQQQ ax ay bx byy cx cy h0 h1 h2 h3

#print axioms extension_types_axes
end Erdos213.PrimitiveQuadraticCases
