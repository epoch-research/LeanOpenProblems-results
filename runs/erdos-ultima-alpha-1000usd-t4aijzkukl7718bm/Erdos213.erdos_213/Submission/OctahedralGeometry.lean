def point (a b c : ℤ) : Fin 48 → Fin 3 → ℤ :=
  ![![a,b,c],![a,b,-c],![a,-b,c],![a,-b,-c],![-a,b,c],![-a,b,-c],![-a,-b,c],![-a,-b,-c],![a,c,b],![a,c,-b],![a,-c,b],![a,-c,-b],![-a,c,b],![-a,c,-b],![-a,-c,b],![-a,-c,-b],![b,a,c],![b,a,-c],![b,-a,c],![b,-a,-c],![-b,a,c],![-b,a,-c],![-b,-a,c],![-b,-a,-c],![b,c,a],![b,c,-a],![b,-c,a],![b,-c,-a],![-b,c,a],![-b,c,-a],![-b,-c,a],![-b,-c,-a],![c,a,b],![c,a,-b],![c,-a,b],![c,-a,-b],![-c,a,b],![-c,a,-b],![-c,-a,b],![-c,-a,-b],![c,b,a],![c,b,-a],![c,-b,a],![c,-b,-a],![-c,b,a],![-c,b,-a],![-c,-b,a],![-c,-b,-a]]

def normSq (a b c : ℤ) (i j : Fin 48) : ℤ :=
  (point a b c i 0-point a b c j 0)^2 +
  (point a b c i 1-point a b c j 1)^2 +
  (point a b c i 2-point a b c j 2)^2

def factorIndex (i j : Fin 48) : Fin 12 :=
  ⟨(( >>> (4*(48*i.val+j.val)))%16)%12, Nat.mod_lt _ (by norm_num)⟩

def squareFactor (a b c : ℤ) (i j : Fin 48) : ℤ :=
  (![0,2*c,2*b,2,2*a,b - c,1,b + c,a - b,a + b,a - c,a + c] : Fin 12 → ℤ) (factorIndex i j)

