lemma code_symm : ∀ i j : Fin 48, edgeCode i j = edgeCode j i := by decide
lemma factor_symm : ∀ i j : Fin 48, factorIndex i j = factorIndex j i := by decide
lemma factor_diag : ∀ i : Fin 48, factorIndex i i = 0 := by decide

lemma norm_factor (a b c : ℤ) (i j : Fin 48) :
    normSq a b c i j = intCodeValue a b c (edgeCode i j)*(squareFactor a b c i j)^2 := by
  rcases lt_trichotomy i j with h | rfl | h
  · exact norm_factor_lt a b c i j h
  · simp [normSq,squareFactor,factor_diag]
  · rw [show normSq a b c i j=normSq a b c j i by unfold normSq; ring,
      code_symm i j,show squareFactor a b c i j=squareFactor a b c j i by
        unfold squareFactor; rw [factor_symm i j]]
    exact norm_factor_lt a b c j i h

#print axioms norm_factor
