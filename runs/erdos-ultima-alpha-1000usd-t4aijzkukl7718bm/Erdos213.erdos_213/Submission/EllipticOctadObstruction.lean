lemma reduction_identity {R : Type*} [CommRing R] (j : Fin 6 → R) :
    integralEquations j = equations j + fun i => (13 : R)*modRemainder j i := by
  ext i
  fin_cases i <;> dsimp [integralEquations,equations,modRemainder] <;> ring

lemma integralEquations_mod (j : Fin 6 → F) : integralEquations j = equations j := by
  rw [reduction_identity]
  have hp : (13 : F) = 0 := by decide
  ext i
  simp [hp]

lemma integral_root_divisible (j : Fin 6 → ℤ) (h : integralEquations j = 0) :
    ∀ i, (13 : ℤ) ∣ j i := by
  have hc : equations (fun i => (j i : F)) = 0 := by
    rw [← integralEquations_mod]
    change integralEquations (fun i => (Int.castRingHom F) (j i)) = 0
    rw [integralEquations_map, h]
    rfl
  have hz := no_nonzero_root _ hc
  intro i
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd (j i) 13).mp (congrFun hz i)

/-- Infinite descent for predicates on integral vectors that admit division
by a fixed integer greater than one. -/
lemma descent_zero {ι : Type*} (R : (ι → ℤ) → Prop) (p : ℕ) (hp : 1 < p)
    (hdiv : ∀ j, R j → ∃ k, R k ∧ j = fun i => (p : ℤ)*k i)
    (j : ι → ℤ) (hj : R j) : j = 0 := by
  ext i
  have hc : ∀ N : ℕ, ∀ k : ι → ℤ, (k i).natAbs = N → R k → k i = 0 := by
    intro N
    induction N using Nat.strong_induction_on with
    | h N ih =>
      intro k hkN hk
      obtain ⟨l,hl,hkl⟩ := hdiv k hk
      by_cases hi : l i = 0
      · rw [hkl]
        simp [hi]
      have hlpos : 0 < (l i).natAbs := Int.natAbs_pos.mpr hi
      have hn : (l i).natAbs < N := by
        rw [hkl] at hkN
        simp only [Int.natAbs_mul,Int.natAbs_natCast] at hkN
        nlinarith
      exact (hi (ih _ hn l rfl hl)).elim
  exact hc _ j rfl hj

lemma integral_no_nonzero_root (j : Fin 6 → ℤ) (h : integralEquations j = 0) : j = 0 := by
  apply descent_zero (fun k => integralEquations k = 0) 13 (by norm_num) _ j h
  intro k hk
  choose l hl using integral_root_divisible k hk
  have he : k = fun i => (13 : ℤ)*l i := funext hl
  refine ⟨l,?_,he⟩
  rw [he,integralEquations_smul] at hk
  ext i
  have hc := congrFun hk i
  exact (mul_eq_zero.mp hc).resolve_left (by norm_num)

lemma rational_no_nonzero_root (j : Fin 6 → ℚ) (h : integralEquations j = 0) : j = 0 := by
  obtain ⟨b,hb⟩ := IsLocalization.exist_integer_multiples_of_finite
    (nonZeroDivisors ℤ) j
  change ∀ i, ∃ k : ℤ, (k : ℚ) = (b : ℤ) • j i at hb
  choose k hk using hb
  have he : (fun i => (k i : ℚ)) = fun i => ((b : ℤ) : ℚ)*j i := by
    ext i
    simpa only [zsmul_eq_mul] using hk i
  have hc : integralEquations (fun i => (k i : ℚ)) = 0 := by
    rw [he,integralEquations_smul,h]
    ext i
    simp
  have hi : integralEquations k = 0 := by
    change integralEquations (fun i => (Int.castRingHom ℚ) (k i)) = 0 at hc
    rw [integralEquations_map] at hc
    ext i
    have hh := congrFun hc i
    change ((integralEquations k i : ℤ) : ℚ) = 0 at hh
    exact_mod_cast hh
  have hz := integral_no_nonzero_root k hi
  have hb0 : (b : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.property
  ext i
  have hh := congrFun he i
  rw [hz] at hh
  have hbQ : ((b : ℤ) : ℚ) ≠ 0 := by exact_mod_cast hb0
  exact (mul_eq_zero.mp hh.symm).resolve_left hbQ

