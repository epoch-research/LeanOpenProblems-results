import FormalConjecturesUtil

/-! A local obstruction for the equations from one rational elliptic octad.
This does not obstruct arbitrary rational-distance configurations. -/
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
namespace Erdos213.EllipticOctadObstruction

abbrev F := ZMod 13
instance : Fact (Nat.Prime 13) := ⟨by norm_num⟩

def equations {R : Type*} [CommRing R] (j : Fin 6 → R) : Fin 6 → R :=
  ![-5*(j 1)^2 + 5*(j 0)*(j 2) - (j 4)^2 + 4*(j 3)*(j 5),
    -3*(j 0)^2 + 3*(j 0)*(j 1) - 5*(j 1)^2 + 3*(j 0)*(j 2) + 3*(j 1)*(j 2) + (j 2)^2 - 3*(j 1)*(j 3) + 5*(j 2)*(j 3) + 5*(j 3)^2 - 5*(j 0)*(j 4) + 4*(j 3)*(j 4) + 4*(j 4)^2 - 5*(j 0)*(j 5) - 4*(j 3)*(j 5) + 4*(j 4)*(j 5) - 6*(j 5)^2,
    -4*(j 0)^2 - 2*(j 3)^2 + (j 2)*(j 4) - 2*(j 1)*(j 5),
    (j 0)^2 + 2*(j 0)*(j 1) + (j 1)^2 + 3*(j 0)*(j 3) + 4*(j 3)^2 + (j 0)*(j 4) + (j 1)*(j 4) + 5*(j 2)*(j 4) - 5*(j 3)*(j 4) + 6*(j 4)^2 + (j 0)*(j 5) + (j 1)*(j 5) + 5*(j 2)*(j 5) - 2*(j 4)*(j 5) - (j 5)^2,
    -5*(j 0)*(j 2) - 5*(j 1)*(j 2) - 3*(j 0)*(j 3) - 4*(j 3)^2 - 5*(j 0)*(j 4) - 4*(j 1)*(j 4) - 4*(j 2)*(j 4) + 5*(j 3)*(j 4) + 6*(j 4)^2 - 4*(j 0)*(j 5) - 4*(j 1)*(j 5) - 4*(j 2)*(j 5),
    -(j 2)^2 + 4*(j 0)*(j 4)]

lemma equations_smul (j : Fin 6 → F) (c : F) :
    equations (fun i => c*j i) = fun i => c^2*equations j i := by
  ext i
  fin_cases i <;> dsimp [equations] <;> ring

lemma root_smul {j : Fin 6 → F} (h : equations j = 0) (c : F) :
    equations (fun i => c*j i) = 0 := by
  rw [equations_smul,h]
  ext i
  simp

lemma chart0_check : ∀ a b c : F, a ≠ 0 →
    equations ![1,a,b,c,b^2/4,(-4-2*c^2+b*(b^2/4))/(2*a)] ≠ 0 := by decide

lemma chart0_check_zero : ∀ b c e : F,
    equations ![1,0,b,c,b^2/4,e] ≠ 0 := by decide

lemma chart0 (a b c d e : F) (h : equations ![1,a,b,c,d,e] = 0) : False := by
  have h5 := congrFun h 5
  change -b^2+4*d=0 at h5
  have hd : d=b^2/4 := by
    apply (eq_div_iff (by decide : (4:F) ≠ 0)).mpr
    linear_combination h5
  subst d
  by_cases ha : a=0
  · subst a
    exact chart0_check_zero b c e h
  · have h2 := congrFun h 2
    change -4-2*c^2+b*(b^2/4)-2*a*e=0 at h2
    have he : e=(-4-2*c^2+b*(b^2/4))/(2*a) := by
      apply (eq_div_iff (mul_ne_zero (by decide : (2:F) ≠ 0) ha)).mpr
      linear_combination -h2
    subst e
    exact chart0_check a b c ha h

lemma chart1_check : ∀ c d : F, equations ![0,1,0,c,d,-c^2] ≠ 0 := by decide
lemma chart1 (a b c d : F) (h : equations ![0,1,a,b,c,d] = 0) : False := by
  have h5 := congrFun h 5
  have ha : a=0 := by
    change -a^2+4*0*c=0 at h5
    have hz : a^2=0 := by linear_combination -h5
    exact eq_zero_of_pow_eq_zero hz
  subst a
  have h2 := congrFun h 2
  change -4*0^2-2*b^2+0*c-2*1*d=0 at h2
  have hd : d = -b^2 := by
    have he : (2:F)*(d+b^2)=0 := by linear_combination -h2
    have he' := (mul_eq_zero.mp he).resolve_left (by decide : (2:F)≠0)
    exact eq_neg_of_add_eq_zero_left he'
  subst d
  exact chart1_check b c h

lemma chart2_check : ∀ a b c : F, equations ![0,0,1,a,b,c] ≠ 0 := by decide
lemma chart3_check : ∀ a b : F, equations ![0,0,0,1,a,b] ≠ 0 := by decide
lemma chart4_check : ∀ a : F, equations ![0,0,0,0,1,a] ≠ 0 := by decide
lemma chart5_check : equations (![0,0,0,0,0,1] : Fin 6 → F) ≠ 0 := by decide


lemma chart2 (j3 j4 j5 : F) (h : equations (![0,0,1,j3,j4,j5] : Fin 6 → F) = 0) : False := chart2_check j3 j4 j5 h
lemma chart3 (j4 j5 : F) (h : equations (![0,0,0,1,j4,j5] : Fin 6 → F) = 0) : False := chart3_check j4 j5 h
lemma chart4 (j5 : F) (h : equations (![0,0,0,0,1,j5] : Fin 6 → F) = 0) : False := chart4_check j5 h
lemma chart5 (h : equations (![0,0,0,0,0,1] : Fin 6 → F) = 0) : False := chart5_check  h

theorem no_nonzero_root (j : Fin 6 → F) (h : equations j = 0) : j = 0 := by
  by_cases h0 : j 0 = 0
  · by_cases h1 : j 1 = 0
    · by_cases h2 : j 2 = 0
      · by_cases h3 : j 3 = 0
        · by_cases h4 : j 4 = 0
          · by_cases h5 : j 5 = 0
            · ext i
              fin_cases i <;> simp [h0,h1,h2,h3,h4,h5]
            · have hv : (fun i => (j 5)⁻¹*j i) = (![0,0,0,0,0,1] : Fin 6 → F) := by
                ext i
                fin_cases i <;> simp [h0,h1,h2,h3,h4,h5]
              have hh := root_smul h (j 5)⁻¹
              rw [hv] at hh
              exact (chart5 hh).elim
          · have hv : (fun i => (j 4)⁻¹*j i) = (![0,0,0,0,1,(j 4)⁻¹*j 5] : Fin 6 → F) := by
              ext i
              fin_cases i <;> simp [h0,h1,h2,h3,h4]
            have hh := root_smul h (j 4)⁻¹
            rw [hv] at hh
            exact (chart4 ((j 4)⁻¹*j 5) hh).elim
        · have hv : (fun i => (j 3)⁻¹*j i) = (![0,0,0,1,(j 3)⁻¹*j 4,(j 3)⁻¹*j 5] : Fin 6 → F) := by
            ext i
            fin_cases i <;> simp [h0,h1,h2,h3]
          have hh := root_smul h (j 3)⁻¹
          rw [hv] at hh
          exact (chart3 ((j 3)⁻¹*j 4) ((j 3)⁻¹*j 5) hh).elim
      · have hv : (fun i => (j 2)⁻¹*j i) = (![0,0,1,(j 2)⁻¹*j 3,(j 2)⁻¹*j 4,(j 2)⁻¹*j 5] : Fin 6 → F) := by
          ext i
          fin_cases i <;> simp [h0,h1,h2]
        have hh := root_smul h (j 2)⁻¹
        rw [hv] at hh
        exact (chart2 ((j 2)⁻¹*j 3) ((j 2)⁻¹*j 4) ((j 2)⁻¹*j 5) hh).elim
    · have hv : (fun i => (j 1)⁻¹*j i) = (![0,1,(j 1)⁻¹*j 2,(j 1)⁻¹*j 3,(j 1)⁻¹*j 4,(j 1)⁻¹*j 5] : Fin 6 → F) := by
        ext i
        fin_cases i <;> simp [h0,h1]
      have hh := root_smul h (j 1)⁻¹
      rw [hv] at hh
      exact (chart1 ((j 1)⁻¹*j 2) ((j 1)⁻¹*j 3) ((j 1)⁻¹*j 4) ((j 1)⁻¹*j 5) hh).elim
  · have hv : (fun i => (j 0)⁻¹*j i) = (![1,(j 0)⁻¹*j 1,(j 0)⁻¹*j 2,(j 0)⁻¹*j 3,(j 0)⁻¹*j 4,(j 0)⁻¹*j 5] : Fin 6 → F) := by
      ext i
      fin_cases i <;> simp [h0]
    have hh := root_smul h (j 0)⁻¹
    rw [hv] at hh
    exact (chart0 ((j 0)⁻¹*j 1) ((j 0)⁻¹*j 2) ((j 0)⁻¹*j 3) ((j 0)⁻¹*j 4) ((j 0)⁻¹*j 5) hh).elim


