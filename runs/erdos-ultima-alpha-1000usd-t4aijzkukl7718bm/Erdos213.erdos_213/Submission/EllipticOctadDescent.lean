    -5*(j 0)^2 - 12*(j 0)*(j 1) - 10*(j 1)^2 + 5*(j 0)*(j 2) - 50*(j 1)*(j 2) - 2*(j 2)^2 + 10*(j 1)*(j 3) + 10*(j 2)*(j 3) + 48*(j 3)^2 - 5*(j 0)*(j 4) - 3*(j 3)*(j 4) - 24*(j 4)^2 - 10*(j 0)*(j 5) + 43*(j 3)*(j 5) + 38*(j 4)*(j 5) - (j 5)^2,
    -4*(j 0)^2 - 2*(j 3)^2 + (j 2)*(j 4) - 2*(j 1)*(j 5),
    -25*(j 0)^2 + (j 0)*(j 1) + (j 1)^2 + 20*(j 0)*(j 3) + 10*(j 1)*(j 3) - 49*(j 2)*(j 3) - 47*(j 3)^2 - 38*(j 0)*(j 4) - 24*(j 1)*(j 4) - 10*(j 2)*(j 4) - 31*(j 3)*(j 4) - 18*(j 4)^2 + 25*(j 0)*(j 5) - 48*(j 1)*(j 5) - 20*(j 2)*(j 5) + 37*(j 3)*(j 5) + 12*(j 4)*(j 5) - 25*(j 5)^2,
    -5*(j 0)*(j 2) - 10*(j 1)*(j 2) + 20*(j 0)*(j 3) + 5*(j 3)^2 - 48*(j 0)*(j 4) + 3*(j 1)*(j 4) + 24*(j 2)*(j 4) + 25*(j 3)*(j 4) + (j 4)^2 + 3*(j 0)*(j 5) + 5*(j 1)*(j 5) - 38*(j 2)*(j 5),
    -(j 2)^2 + 4*(j 0)*(j 4)]


