import FormalConjecturesUtil

/-! A finite-field obstruction for one explicit rational elliptic octad.
This does not obstruct arbitrary rational-distance configurations. -/

set_option maxHeartbeats 20000000
set_option maxRecDepth 100000
namespace Erdos213.EllipticOctadObstruction

abbrev F := ZMod 101

instance : Fact (Nat.Prime 101) := ⟨by norm_num⟩

def equations {R : Type*} [CommRing R] (j : Fin 6 → R) : Fin 6 → R :=
