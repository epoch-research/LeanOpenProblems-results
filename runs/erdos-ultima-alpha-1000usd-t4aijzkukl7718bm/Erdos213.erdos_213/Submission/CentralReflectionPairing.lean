import Submission.CentralReflection

/-! Completeness and a metric-input wrapper for the central-heptad reflection
obstruction. No unrestricted bound on integral point sets is asserted. -/
namespace Erdos213.CentralReflection
noncomputable section
set_option Elab.async false
set_option maxRecDepth 200000
set_option maxHeartbeats 100000000

def permPair (σ : Fin 7 → Fin 7) (k : Fin 3) (j : Fin 2) : Fin 7 :=
  σ (!![0,1;2,3;4,5] k j)

def SamePair (a b c d : Fin 7) : Prop := (a=c ∧ b=d) ∨ (a=d ∧ b=c)

def Matches (f : Fin 7 → Fin 7) (m : Fin 105) : Prop :=
  single m=f 6 ∧ ∀ k : Fin 3, ∃ j : Fin 3,
    SamePair (pair m k 0) (pair m k 1) (permPair f j 0) (permPair f j 1)

instance (f : Fin 7 → Fin 7) (m : Fin 105) : Decidable (Matches f m) := by
  unfold Matches SamePair
  infer_instance

def listFunction (l : List (Fin 7)) (i : Fin 7) : Fin 7 := l.getD i.val 0

private def checkEntry (e : List (Fin 7) × Fin 105) : Bool :=
  decide (Matches (listFunction e.1) e.2)

