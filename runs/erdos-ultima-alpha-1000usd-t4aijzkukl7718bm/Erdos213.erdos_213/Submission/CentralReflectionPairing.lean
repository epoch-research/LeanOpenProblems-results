lemma listFunction_map (σ : Equiv.Perm (Fin 7)) :
    listFunction ((List.finRange 7).map σ)=σ := by
  funext i
  fin_cases i <;> rfl

/-- All 7! labellings, together with their matching witnesses, are checked
in Lean's kernel. The list completeness is independently kernel checked. -/
lemma matching_certificate (σ : Equiv.Perm (Fin 7)) : ∃ m : Fin 105, Matches σ m := by
  have hm := List.mem_permutations'.mpr σ.map_finRange_perm
  rw [permutations_eq_chunks] at hm
  obtain ⟨e,he,hel⟩ := List.mem_map.mp hm
  have hh := (List.all_eq_true.mp list_certificate) e he
  have hr : Matches (listFunction e.1) e.2 := of_decide_eq_true hh
  exact ⟨e.2,by simpa only [hel,listFunction_map] using hr⟩

lemma matching_complete (σ : Equiv.Perm (Fin 7)) :
    ∃ m : Fin 105, single m=σ 6 ∧ ∀ k : Fin 3, ∃ j : Fin 3,
      SamePair (pair m k 0) (pair m k 1) (permPair σ j 0) (permPair σ j 1) :=
  matching_certificate σ

/-- Any permutation can specify the three pairs; no particular matching is
privileged. The reflected singleton cannot be a new eighth point. -/
theorem no_reflection_permutation (t w : ℂ) (u v : ℚ)
    (hq : t^2-(u : ℂ)*t+(v : ℂ)=0)
    (hi : Function.Injective (points t w)) (σ : Equiv.Perm (Fin 7)) (C : ℂ)
    (hp : ∀ k : Fin 3,
      points t w (permPair σ k 0)+points t w (permPair σ k 1)=C)
    (hn : C-points t w (σ 6)≠points t w (σ 6)) : False := by
  obtain ⟨m,hm,hm'⟩ := matching_complete σ
  have hs (k : Fin 3) : points t w (pair m k 0)+points t w (pair m k 1)=C := by
    obtain ⟨j,hj⟩ := hm' k
    rcases hj with ⟨h0,h1⟩ | ⟨h0,h1⟩
    · simpa only [h0,h1] using hp j
    · simpa only [h0,h1,add_comm] using hp j
  apply no_reflection_case t w u v hq hi m
    ⟨(hs 0).trans (hs 1).symm,(hs 0).trans (hs 2).symm⟩
  simpa only [reflected,hs 0,hm] using hn

lemma quadratic_of_two_rational_norms (t : ℂ)
    (ht : CentralQuadratic.RationalNorm t)
    (hs : CentralQuadratic.RationalNorm (1-t)) :
    ∃ u v : ℚ, t^2-(u : ℂ)*t+(v : ℂ)=0 := by
  obtain ⟨r,hr⟩ := ht
  obtain ⟨s,hs⟩ := hs
  have hr' : Complex.normSq t=(r : ℝ)^2 := by
    rw [Complex.normSq_eq_norm_sq,hr]
  have hs' : Complex.normSq (1-t)=(s : ℝ)^2 := by
    rw [Complex.normSq_eq_norm_sq,hs]
  have he : Complex.normSq (1-t)=1-2*t.re+Complex.normSq t := by
    simp [Complex.normSq_apply]
    ring
  have hu : ((r^2+1-s^2 : ℚ) : ℝ)=2*t.re := by
    push_cast
    rw [hr',hs'] at he
    linarith
  have hq : t^2-((2*t.re : ℝ) : ℂ)*t+((Complex.normSq t : ℝ) : ℂ)=0 := by
    apply Complex.ext <;> simp [pow_two,Complex.normSq_apply] <;> ring
  rw [← hu,hr'] at hq
  refine ⟨r^2+1-s^2,r^2,?_⟩
  simpa only [Complex.ofReal_ratCast,Complex.ofReal_pow,Rat.cast_pow] using hq

/-- For the normalized central construction, only the two indicated source
norms are used. The other seven rational-norm hypotheses are unnecessary for
this obstruction. -/
theorem rational_source_no_reflection (t w : ℂ)
    (ht : CentralQuadratic.RationalNorm t)
    (hs : CentralQuadratic.RationalNorm (1-t))
    (hi : Function.Injective (points t w)) (σ : Equiv.Perm (Fin 7)) (C : ℂ)
    (hp : ∀ k : Fin 3,
      points t w (permPair σ k 0)+points t w (permPair σ k 1)=C)
    (hn : C-points t w (σ 6)≠points t w (σ 6)) : False := by
  obtain ⟨u,v,hq⟩ := quadratic_of_two_rational_norms t ht hs
  exact no_reflection_permutation t w u v hq hi σ C hp hn

/-- If six outputs are centrally paired, the remaining output is their center.
Thus reflection fixes that output rather than producing an eighth point. -/
theorem paired_singleton_fixed (t w : ℂ)
    (ht : CentralQuadratic.RationalNorm t)
    (hs : CentralQuadratic.RationalNorm (1-t))
    (hi : Function.Injective (points t w)) (σ : Equiv.Perm (Fin 7)) (C : ℂ)
    (hp : ∀ k : Fin 3,
      points t w (permPair σ k 0)+points t w (permPair σ k 1)=C) :
    C-points t w (σ 6)=points t w (σ 6) := by
  by_contra hn
  exact rational_source_no_reflection t w ht hs hi σ C hp hn

lemma collinear_of_pair_sum (a b c : ℂ) (h : a+b=2*c) :
    Collinear ℝ ({a,b,c} : Set ℂ) := by
  rw [collinear_iff_exists_forall_eq_smul_vadd]
  refine ⟨c,a-c,?_⟩
  intro p hp
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hp
  rcases hp with rfl | rfl | rfl
  · exact ⟨1,by simp⟩
  · refine ⟨-1,?_⟩
    simp only [neg_smul,one_smul,vadd_eq_add]
    linear_combination h
  · exact ⟨0,by simp⟩

/-- A general-position output of this construction has no centrally paired
six-point subset. This is still a statement about this construction only. -/
theorem nontrilinear_no_paired_six (t w : ℂ)
    (ht : CentralQuadratic.RationalNorm t)
    (hs : CentralQuadratic.RationalNorm (1-t))
    (hi : Function.Injective (points t w))
    (hgp : EuclideanGeometry.NonTrilinear (Set.range (points t w)))
    (σ : Equiv.Perm (Fin 7)) (C : ℂ)
    (hp : ∀ k : Fin 3,
      points t w (permPair σ k 0)+points t w (permPair σ k 1)=C) : False := by
  have hf := paired_singleton_fixed t w ht hs hi σ C hp
  have h0 := hp 0
  change points t w (σ 0)+points t w (σ 1)=C at h0
  have he : points t w (σ 0)+points t w (σ 1)=2*points t w (σ 6) := by
    linear_combination h0+hf
  have hne (i j : Fin 7) (hij : i≠j) : points t w (σ i)≠points t w (σ j) :=
    fun hh => hij (σ.injective (hi hh))
  exact hgp (Set.mem_range_self (σ 0)) (Set.mem_range_self (σ 1))
    (Set.mem_range_self (σ 6)) (hne 0 1 (by decide)) (hne 1 6 (by decide))
    (hne 0 6 (by decide)) (collinear_of_pair_sum _ _ _ he)

