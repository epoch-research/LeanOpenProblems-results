import Submission.OrthogonalGlobal

/-! Median iteration does not automatically complete the oblique 3-by-3 grid.
The diagonal-flipped triangle is outside the orbit generated by rational
similarities, side permutations, and taking median triangles. This is an
obstruction to a growth rule, not to arbitrary rational-distance sets. -/
namespace Erdos213.MedianFlipClosure
open scoped BigOperators
noncomputable section
set_option maxHeartbeats 2000000

abbrev Triple := Fin 3 → ℚ

def total (x : Triple) : ℚ := ∑ i, x i

def heron (x : Triple) : ℚ := total x^2-2*∑ i, (x i)^2

/-- Squared lengths of the three doubled medians. -/
def median (x : Triple) : Triple := fun i => 2*total x-3*x i

/-- Switch the diagonal of a parallelogram, retaining the two side lengths. -/
def flip (x : Triple) : Triple := ![x 0,x 1,2*x 0+2*x 1-x 2]

/-- A rational length-scale r multiplies squared sides by r². -/
def scale (r : ℚ) (x : Triple) : Triple := fun i => r^2*x i

lemma total_permute (p : Equiv.Perm (Fin 3)) (x : Triple) : total (x ∘ p)=total x := by
  exact Equiv.sum_comp p x

lemma heron_permute (p : Equiv.Perm (Fin 3)) (x : Triple) : heron (x ∘ p)=heron x := by
  unfold heron
  rw [total_permute]
  have hs : (∑ i, ((x ∘ p) i)^2)=∑ i, (x i)^2 :=
    Equiv.sum_comp p (fun i => (x i)^2)
  rw [hs]

lemma total_scale (r : ℚ) (x : Triple) : total (scale r x)=r^2*total x := by
  simp [total,scale,Finset.mul_sum]

lemma heron_scale (r : ℚ) (x : Triple) : heron (scale r x)=r^4*heron x := by
  simp [heron,total_scale,scale,Fin.sum_univ_three]
  ring

lemma heron_expanded (x : Triple) : heron x=
    2*x 0*x 1+2*x 0*x 2+2*x 1*x 2-(x 0)^2-(x 1)^2-(x 2)^2 := by
  simp [heron,total,Fin.sum_univ_three]
  ring

lemma heron_flip (x : Triple) : heron (flip x)=heron x := by
  simp [heron_expanded,flip,Matrix.cons_val_two]
  ring

lemma heron_median (x : Triple) : heron (median x)=9*heron x := by
  simp [heron_expanded,median,total,Fin.sum_univ_three]
  ring

lemma median_twice (x : Triple) : median (median x)=scale 3 x := by
  ext i
  simp [median,total,scale,Fin.sum_univ_three]
  ring

lemma median_permute (p : Equiv.Perm (Fin 3)) (x : Triple) :
    median (x ∘ p)=(median x) ∘ p := by
  ext i
  change 2*total (x ∘ p)-3*x (p i)=2*total x-3*x (p i)
  rw [total_permute]

lemma median_scale (r : ℚ) (x : Triple) : median (scale r x)=scale r (median x) := by
  ext i
  simp [median,total_scale,scale]
  ring

/-- No equal-area nondegenerate triangle can be rationally similar to the
median triangle. This is a square-class obstruction, with no parameter bound. -/
theorem flip_ne_scaled_median {x : Triple} (hx : heron x ≠ 0)
    (r : ℚ) (p : Equiv.Perm (Fin 3)) : flip x ≠ scale r ((median x) ∘ p) := by
  intro he
  have h := congrArg heron he
  rw [heron_flip,heron_scale,heron_permute,heron_median] at h
  have hr : 1=9*r^4 := by
    apply mul_right_cancel₀ hx
    linear_combination h
  have hs : 3*r^2=1 := by nlinarith [sq_nonneg (3*r^2+1),sq_nonneg r]
  have hbad : IsSquare (3 : ℚ) := ⟨3*r,by nlinarith only [hs]⟩
  exact (by decide +kernel : ¬IsSquare (3 : ℚ)) hbad

lemma flip_similarity_right {x : Triple} (hx : heron x ≠ 0)
    (r : ℚ) (p : Equiv.Perm (Fin 3)) (he : flip x=scale r (x ∘ p)) :
    x 2=x 0+x 1 := by
  have h := congrArg heron he
  rw [heron_flip,heron_scale,heron_permute] at h
  have hr : 1=r^4 := by
    apply mul_right_cancel₀ hx
    linear_combination h
  have hs : r^2=1 := by nlinarith [sq_nonneg r]
  have ht := congrArg total he
  rw [total_scale,total_permute,hs,one_mul] at ht
  simp [total,flip,Fin.sum_univ_three,Matrix.cons_val_two] at ht
  linarith

def RationalMedians (x : Triple) : Prop :=
  (∀ i, IsSquare (x i)) ∧ ∀ i, IsSquare (median x i)

lemma right_impossible {x : Triple} (hx : heron x ≠ 0) (hq : RationalMedians x)
    (hr : x 2=x 0+x 1) : False := by
  obtain ⟨a,ha⟩ := hq.1 0
  obtain ⟨b,hb⟩ := hq.1 1
  have ha' : x 0=a^2 := by simpa only [pow_two] using ha
  have hb' : x 1=b^2 := by simpa only [pow_two] using hb
  have hh : heron x=4*a^2*b^2 := by rw [heron_expanded,hr,ha',hb']; ring
  have ha0 : a ≠ 0 := by intro h; apply hx; simp [h] at hh; exact hh
  have hb0 : b ≠ 0 := by intro h; apply hx; simp [h] at hh; exact hh
  have hm : IsSquare (a^2+4*b^2) := by
    convert hq.2 0 using 1
    simp [median,total,Fin.sum_univ_three,hr,ha',hb']
    ring
  apply OrthogonalGlobal.no_simultaneous_squares (div_ne_zero ha0 hb0)
  constructor
  · convert (hq.1 2).div (IsSquare.sq b) using 1
    rw [hr,ha',hb']
    field_simp
  · convert hm.div (IsSquare.sq b) using 1
    field_simp

lemma RationalMedians.scaling {x : Triple} (h : RationalMedians x) (r : ℚ) :
    RationalMedians (scale r x) := by
  constructor
  · intro i
    exact (IsSquare.sq r).mul (h.1 i)
  · intro i
    rw [median_scale]
    exact (IsSquare.sq r).mul (h.2 i)

lemma RationalMedians.permuting {x : Triple} (h : RationalMedians x)
    (p : Equiv.Perm (Fin 3)) : RationalMedians (x ∘ p) := by
  constructor
  · intro i; exact h.1 (p i)
  · intro i
    rw [median_permute]
    exact h.2 (p i)

lemma RationalMedians.medians {x : Triple} (h : RationalMedians x) :
    RationalMedians (median x) := by
  refine ⟨h.2,?_⟩
  intro i
  rw [median_twice]
  exact (IsSquare.sq (3 : ℚ)).mul (h.1 i)

/-- All finite words in the three usual arithmetic-preserving operations. -/
inductive Reach (x : Triple) : Triple → Prop
  | base : Reach x x
  | scaling {y : Triple} (h : Reach x y) (r : ℚ) : Reach x (scale r y)
  | permuting {y : Triple} (h : Reach x y) (p : Equiv.Perm (Fin 3)) : Reach x (y ∘ p)
  | medians {y : Triple} (h : Reach x y) : Reach x (median y)

theorem reach_preserves {x y : Triple} (hx : RationalMedians x) (h : Reach x y) :
    RationalMedians y := by
  induction h with
  | base => exact hx
  | scaling h r ih => exact ih.scaling r
  | permuting h p ih => exact ih.permuting p
  | medians h ih => exact ih.medians

/-- Up to rational similarity and permutation, all iterations give only the
original triangle or its median triangle. No word-length cutoff is imposed. -/
theorem reach_normal_form {x y : Triple} (h : Reach x y) :
    ∃ r : ℚ, ∃ p : Equiv.Perm (Fin 3),
      y=scale r (x ∘ p) ∨ y=scale r ((median x) ∘ p) := by
  induction h with
  | base => exact ⟨1,Equiv.refl _,Or.inl (by ext i; simp [scale])⟩
  | @scaling y h r ih =>
    obtain ⟨s,p,he | he⟩ := ih
    · refine ⟨r*s,p,Or.inl ?_⟩
      rw [he]
      ext i
      simp [scale]
      ring
    · refine ⟨r*s,p,Or.inr ?_⟩
      rw [he]
      ext i
      simp [scale]
      ring
  | @permuting y h p ih =>
    obtain ⟨s,q,he | he⟩ := ih
    · refine ⟨s,p.trans q,Or.inl ?_⟩
      rw [he]
      rfl
    · refine ⟨s,p.trans q,Or.inr ?_⟩
      rw [he]
      rfl
  | @medians y h ih =>
    obtain ⟨s,p,he | he⟩ := ih
    · refine ⟨s,p,Or.inr ?_⟩
      rw [he,median_scale,median_permute]
    · refine ⟨3*s,p,Or.inl ?_⟩
      rw [he,median_scale,median_permute,median_twice]
      ext i
      simp [scale]
      ring

/-- A nondegenerate rational-median triangle cannot supply its opposite-diagonal
triangle by any finite sequence of median operations, permutations, and rational
similarities. A separate arithmetic construction would be needed. -/
theorem flip_not_reachable {x : Triple} (hx : heron x ≠ 0) (hq : RationalMedians x) :
    ¬Reach x (flip x) := by
  intro h
  obtain ⟨r,p,he | he⟩ := reach_normal_form h
  · exact right_impossible hx hq (flip_similarity_right hx r p he)
  · exact flip_ne_scaled_median hx r p he

#print axioms median_twice
#print axioms flip_ne_scaled_median
#print axioms right_impossible
#print axioms reach_preserves
#print axioms reach_normal_form
#print axioms flip_not_reachable
end
end Erdos213.MedianFlipClosure
