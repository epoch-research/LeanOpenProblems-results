def pf6 (M : Fin 6 → Fin 6 → ℤ) : ℤ :=
  M 0 1*(M 2 3*M 4 5-M 2 4*M 3 5+M 2 5*M 3 4) -
  M 0 2*(M 1 3*M 4 5-M 1 4*M 3 5+M 1 5*M 3 4) +
  M 0 3*(M 1 2*M 4 5-M 1 4*M 2 5+M 1 5*M 2 4) -
  M 0 4*(M 1 2*M 3 5-M 1 3*M 2 5+M 1 5*M 2 3) +
  M 0 5*(M 1 2*M 3 4-M 1 3*M 2 4+M 1 4*M 2 3)

def sign (b : Bool) : ℤ := if b then -1 else 1
def extensionColumn (s : Fin 7 → Bool) : Fin 8 → ℤ :=
  ![952*sign (s 0),1904*sign (s 1),2752*sign (s 2),4488*sign (s 3),1352*sign (s 4),2023*sign (s 5),6698*sign (s 6),-1]

theorem distances_correct : ∀ i j : Fin 8,
    (points i 0-points j 0)^2+(points i 1-points j 1)^2=distances i j^2 := by
  decide +kernel

theorem models_alternating : ∀ b : Fin 42, ∀ i j : Fin 8,
    models b i j= -models b j i := by
  decide +kernel

theorem models_finite_lengths : ∀ b : Fin 42, ∀ i j : Fin 7,
    (models b i.castSucc j.castSucc)^2=(distances i.castSucc j.castSucc)^2 := by
  decide +kernel

theorem models_infinity_normalized : ∀ b : Fin 42, ∀ i : Fin 7,
    models b i.castSucc 7=1 := by
  decide +kernel

theorem kernel0_annihilates : ∀ b : Fin 42, ∀ i : Fin 8,
    (∑ j : Fin 8, models b i j*kernel0 b j)=0 := by
  decide +kernel

theorem kernel1_annihilates : ∀ b : Fin 42, ∀ i : Fin 8,
    (∑ j : Fin 8, models b i j*kernel1 b j)=0 := by
  decide +kernel

theorem pivot_pfaffian_nonzero : ∀ b : Fin 42,
    pf6 (fun i j => models b (pivots b i) (pivots b j))≠0 := by
  decide +kernel

/-- No signing of the new distance column is orthogonal to both displayed
kernel vectors, for any of the 42 explicit base matrices. -/
theorem no_kernel_compatible_extension : ∀ b : Fin 42, ∀ s : Fin 7 → Bool,
    (∑ i : Fin 8, kernel0 b i*extensionColumn s i)≠0 ∨
    (∑ i : Fin 8, kernel1 b i*extensionColumn s i)≠0 := by
  decide +kernel

