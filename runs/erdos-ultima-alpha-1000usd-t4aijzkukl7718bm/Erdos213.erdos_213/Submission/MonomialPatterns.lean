private def certs : Fin 22 → Fin 6 → Fin 6 → Fin 6 → Certificate :=
![cert0,
cert1,
cert2,
cert3,
cert4,
cert5,
cert6,
cert7,
cert8,
cert9,
cert10,
cert11,
cert12,
cert13,
cert14,
cert15,
cert16,
cert17,
cert18,
cert19,
cert20,
cert21]

private def cert (c : Fin 22) (o : Fin 3 → Fin 6) : Certificate := certs c (o 0) (o 1) (o 2)

private def Valid (c : Fin 22) (o : Fin 3 → Fin 6) : Prop :=
  (bad c (cert c o).badIndex).1=true ∧ (cert c o).scale ≠ 0 ∧
  ∀ k : Fin 9, (cert c o).scale*(bad c (cert c o).badIndex).2 k =
    ∑ j : Fin 9, (cert c o).coeff j * equations c o j k

private def dot9 (v w : Fin 9 → ℤ) : ℤ :=
  v 0*w 0 + v 1*w 1 + v 2*w 2 + v 3*w 3 + v 4*w 4 + v 5*w 5 + v 6*w 6 + v 7*w 7 + v 8*w 8

private lemma dot9_eq_sum (v w : Fin 9 → ℤ) : dot9 v w = ∑ j, v j*w j := by
  simp [dot9,Fin.sum_univ_succ]
  ring

private def checkBool (c : Fin 22) (o : Fin 3 → Fin 6) : Bool :=
  (bad c (cert c o).badIndex).1 && decide ((cert c o).scale≠0) &&
  (List.finRange 9).all (fun k =>
    (cert c o).scale*(bad c (cert c o).badIndex).2 k ==
      dot9 (cert c o).coeff (fun j => equations c o j k))

private def checkRow (c : Fin 22) (i : Fin 6) : Bool :=
  (List.finRange 6).all (fun j =>
    (List.finRange 6).all (fun k => checkBool c ![i,j,k]))

private lemma valid_of_bool (c : Fin 22) (o : Fin 3 → Fin 6)
    (h : checkBool c o=true) : Valid c o := by
  simpa [checkBool,Valid,List.all_eq_true,and_assoc,dot9_eq_sum] using h

