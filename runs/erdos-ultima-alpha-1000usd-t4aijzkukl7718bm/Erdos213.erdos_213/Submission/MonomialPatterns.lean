private lemma all_valid (c : Fin 22) (o : Fin 3 → Fin 6) : Valid c o := by
  have h := all_rows c (o 0)
  simp only [checkRow,List.all_eq_true,List.mem_finRange,forall_true_left] at h
  apply valid_of_bool
  have he : o=![o 0,o 1,o 2] := by funext i; fin_cases i <;> rfl
  rw [he]
  exact h _ _

/-- The checked pattern systems always force one of their listed degeneracies.
There is no bound on the integer exponents x in this theorem. -/
theorem no_nondegenerate_pattern (c : Fin 22) (o : Fin 3 → Fin 6) (x : Fin 9 → ℤ)
    (hx : equations c o *ᵥ x=0) : ¬Nondegenerate c x := by
  intro hg
  obtain ⟨ha,hd,hcert⟩ := all_valid c o
  have hv : (cert c o).scale • (bad c (cert c o).badIndex).2 =
      (cert c o).coeff ᵥ* equations c o := by
    funext k
    exact hcert k
  have he := congrArg (fun v : Fin 9 → ℤ => v ⬝ᵥ x) hv
  change ((cert c o).scale • (bad c (cert c o).badIndex).2) ⬝ᵥ x =
    ((cert c o).coeff ᵥ* equations c o) ⬝ᵥ x at he
  rw [smul_dotProduct,← dotProduct_mulVec,hx,dotProduct_zero] at he
  exact hg _ ha ((mul_eq_zero.mp he).resolve_left hd)

