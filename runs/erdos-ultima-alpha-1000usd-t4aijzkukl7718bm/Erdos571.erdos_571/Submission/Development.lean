open Filter SimpleGraph Finset

universe u v

namespace Erdos571

private theorem star_free_iff {V : Type*} [Fintype V]
    (H : SimpleGraph V) [DecidableRel H.Adj] (k : ℕ) :
    (completeBipartiteGraph (Fin 1) (Fin k)).Free H ↔ ∀ v, H.degree v < k := by
  classical
  constructor
  · intro hf v
    by_contra hv
    have hk : k ≤ (H.neighborFinset v).card := by simpa only [card_neighborFinset_eq_degree] using (Nat.le_of_not_gt hv)
    obtain ⟨s, hs, hsc⟩ := Finset.exists_subset_card_eq hk
    apply hf
    apply completeBipartiteGraph_isContained_iff.mpr
    refine ⟨{v}, s, by simp, by simpa using hsc, ?_⟩
    intro x hx y hy
    have hxv : x = v := by simpa using hx
    subst x
    exact (H.mem_neighborFinset _ _).mp (hs hy)
  · intro hd hc
    obtain ⟨l, r, hl, hr, h⟩ := completeBipartiteGraph_isContained_iff.mp hc
    have hl' : l.card = 1 := by simpa using hl
    obtain ⟨v, hv⟩ := Finset.card_eq_one.mp hl'
    have hsub : r ⊆ H.neighborFinset v := by
      intro w hw
      apply (H.mem_neighborFinset _ _).mpr
      apply h
      · simp [hv]
      · exact hw
    have hcard := Finset.card_le_card hsub
    have hr' : r.card = k := by simpa using hr
    have := hd v
    simp only [hr', card_neighborFinset_eq_degree] at hcard
    omega

private theorem extremal_star_three (n : ℕ) (hn : 3 ≤ n) :
    extremalNumber n (completeBipartiteGraph (Fin 1) (Fin 3)) = n := by
  classical
  apply Nat.le_antisymm
  · rw [← Fintype.card_fin n, extremalNumber_le_iff]
    intro H _ hH
    have hd := (star_free_iff H 3).mp hH
    have hsum : ∑ v, H.degree v ≤ ∑ _v : Fin n, 2 := by
      apply Finset.sum_le_sum
      intro v hv
      exact Nat.le_of_lt_succ (hd v)
    rw [H.sum_degrees_eq_twice_card_edges] at hsum
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hsum
    simp only [Fintype.card_fin]
    omega
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le' hn
    have hd : ∀ v, (cycleGraph (m + 3)).degree v = 2 := by
      intro v
      exact cycleGraph_degree_three_le
    have hf : (completeBipartiteGraph (Fin 1) (Fin 3)).Free (cycleGraph (m + 3)) := by
      apply (star_free_iff _ _).mpr
      intro v
      rw [hd]
      omega
    have hc : (cycleGraph (m + 3)).edgeFinset.card = m + 3 := by
      have hsum := (cycleGraph (m + 3)).sum_degrees_eq_twice_card_edges
      simp only [hd, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hsum
      omega
    simpa only [Fintype.card_fin, hc] using card_edgeFinset_le_extremalNumber hf


/-- The endpoint of the rational-exponent assertion, witnessed by the claw. -/
theorem endpoint_one :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta atTop
        (fun n : ℕ => (extremalNumber n G : ℝ))
        (fun n : ℕ => (n : ℝ) ^ ((1 : ℚ) : ℝ)) := by
  let S := completeBipartiteGraph (Fin 1) (Fin 3)
  let e : (Fin 1 ⊕ Fin 3) ≃ Fin 4 := finSumFinEquiv
  refine ⟨4, S.map e.toEmbedding, ?_, ?_⟩
  · have hS : S.IsBipartite := by
      have h := (CompleteBipartiteGraph.bicoloring (Fin 1) (Fin 3)).colorable
      simpa only [Fintype.card_bool] using h
    exact hS.map e.toEmbedding
  · apply Filter.EventuallyEq.isTheta
    filter_upwards [eventually_ge_atTop 3] with n hn
    rw [← extremalNumber_congr_right (SimpleGraph.Iso.map e S)]
    simp only [S, extremal_star_three n hn, Rat.cast_one, Real.rpow_one]

private abbrev FourCycle := completeBipartiteGraph (Fin 2) (Fin 2)

private def UniqueCommon {V : Type*} (G : SimpleGraph V) : Prop :=
  ∀ u v, u ≠ v → ∀ a b, G.Adj u a → G.Adj v a → G.Adj u b → G.Adj v b → a = b

private theorem four_free_iff {V : Type*} (G : SimpleGraph V) :
    FourCycle.Free G ↔ UniqueCommon G := by
  classical
  constructor
  · intro hf u v huv a b hua hva hub hvb
    by_contra hab
    apply hf
    apply completeBipartiteGraph_isContained_iff.mpr
    refine ⟨{u,v}, {a,b}, by simp [huv], by simp [hab], ?_⟩
    intro x hx y hy
    simp only [mem_coe, mem_insert, mem_singleton] at hx hy
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> assumption
  · intro h ⟨f⟩
    have huv : f (Sum.inl 0) ≠ f (Sum.inl 1) :=
      fun he => (by decide : (0 : Fin 2) ≠ 1) (Sum.inl.inj (f.injective he))
    have hab : f (Sum.inr 0) ≠ f (Sum.inr 1) :=
      fun he => (by decide : (0 : Fin 2) ≠ 1) (Sum.inr.inj (f.injective he))
    apply hab
    apply h _ _ huv
    all_goals exact f.toHom.map_adj (by simp [FourCycle])

private theorem uniqueCommon_map {V W : Type*} {G : SimpleGraph V}
    (h : UniqueCommon G) (f : V ↪ W) : UniqueCommon (G.map f) := by
  intro u v huv a b hua hva hub hvb
  rcases hua with ⟨u', a', hua', rfl, rfl⟩
  rcases hva with ⟨v', a'', hva', rfl, ha⟩
  have hea : a'' = a' := f.injective ha
  subst a''
  rcases hub with ⟨u'', b', hub', hu, rfl⟩
  have heu : u'' = u' := f.injective hu
  subst u''
  rcases hvb with ⟨v'', b'', hvb', hv, hb⟩
  have hev : v'' = v' := f.injective hv
  have heb : b'' = b' := f.injective hb
  subst v'' b''
  exact congrArg f (h _ _ (fun he => huv (congrArg f he)) _ _ hua' hva' hub' hvb')

private theorem sum_degree_sq_bound {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (h : UniqueCommon G) :
    ∑ v, G.degree v ^ 2 ≤ Fintype.card V ^ 2 + 2 * G.edgeFinset.card := by
  classical
  let T := Σ v : V, (G.neighborSet v) × (G.neighborSet v)
  let f : T → (V × V) ⊕ G.Dart := fun t =>
    if ht : t.2.1.val = t.2.2.val then
      Sum.inr ⟨(t.1, t.2.1.val), t.2.1.prop⟩
    else Sum.inl (t.2.1.val, t.2.2.val)
  have hinj : Function.Injective f := by
    rintro ⟨x, a, b⟩ ⟨y, c, d⟩ he
    dsimp [f] at he
    split_ifs at he with hab hcd hcd
    · have he' := Sum.inr.inj he
      have hxy : x = y := congrArg (fun z : G.Dart => z.fst) he'
      have hac : a.val = c.val := congrArg (fun z : G.Dart => z.snd) he'
      subst y
      have ha : a = c := Subtype.ext hac
      have hb : b = d := Subtype.ext (by simpa [← hab, ← hcd] using hac)
      subst c d
      rfl
    · have he' := Sum.inl.inj he
      have hac : a.val = c.val := congrArg Prod.fst he'
      have hbd : b.val = d.val := congrArg Prod.snd he'
      have hxy : x = y := by
        apply h a.val b.val hab x y a.prop.symm b.prop.symm
        · simpa [hac] using c.prop.symm
        · simpa [hbd] using d.prop.symm
      subst y
      have ha : a = c := Subtype.ext hac
      have hb : b = d := Subtype.ext hbd
      subst c d
      rfl
  have hc := Fintype.card_le_of_injective f hinj
  simpa only [T, Fintype.card_sigma, Fintype.card_prod, Fintype.card_sum,
    card_neighborSet_eq_degree, G.dart_card_eq_twice_card_edges, pow_two] using hc

private theorem four_edge_upper {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (hf : FourCycle.Free G) :
    (G.edgeFinset.card : ℝ) ≤ (Fintype.card V : ℝ) * Real.sqrt (Fintype.card V) := by
  have h := sum_degree_sq_bound G ((four_free_iff G).mp hf)
  have hs : ∑ v, (G.degree v : ℝ) ^ 2 ≤ (Fintype.card V : ℝ) ^ 2 + 2 * G.edgeFinset.card := by
    exact_mod_cast h
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset V)) (f := fun v => (G.degree v : ℝ))
  have hdeg : ∑ v, (G.degree v : ℝ) = 2 * G.edgeFinset.card := by
    exact_mod_cast G.sum_degrees_eq_twice_card_edges
  rw [hdeg] at hc
  simp only [card_univ] at hc
  have hsq : (2 * (G.edgeFinset.card : ℝ)) ^ 2 ≤
      (Fintype.card V : ℝ) * ((Fintype.card V : ℝ) ^ 2 + 2 * G.edgeFinset.card) :=
    hc.trans (mul_le_mul_of_nonneg_left hs (Nat.cast_nonneg _))
  have hn := Nat.cast_nonneg (α := ℝ) (Fintype.card V)
  have hm := Nat.cast_nonneg (α := ℝ) G.edgeFinset.card
  have hsqrt := Real.sq_sqrt hn
  have hsqrt0 := Real.sqrt_nonneg (Fintype.card V : ℝ)
  by_cases hz : Fintype.card V = 0
  · have hn0 : (Fintype.card V : ℝ) = 0 := by simp [hz]
    rw [hn0] at hsq ⊢
    nlinarith
  have hn1 : (1 : ℝ) ≤ Fintype.card V := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hz
  have hr1 : (1 : ℝ) ≤ Real.sqrt (Fintype.card V) := by nlinarith
  by_contra hnot
  have hlt : (Fintype.card V : ℝ) * Real.sqrt (Fintype.card V) < G.edgeFinset.card :=
    lt_of_not_ge hnot
  have hmgt : (Fintype.card V : ℝ) < G.edgeFinset.card := by nlinarith
  have hprod := mul_nonneg (sub_nonneg.mpr (le_of_lt hlt))
    (add_nonneg hm (mul_nonneg hn hsqrt0))
  nlinarith [sq_nonneg ((G.edgeFinset.card : ℝ) - Fintype.card V)]

private def affineIncidence (K : Type*) [Field K] : SimpleGraph ((K × K) ⊕ (K × K)) where
  Adj u v := match u, v with
    | Sum.inl p, Sum.inr l => p.2 = l.1 * p.1 + l.2
    | Sum.inr l, Sum.inl p => p.2 = l.1 * p.1 + l.2
    | _, _ => False
  symm := by intro u v; cases u <;> cases v <;> simp
  loopless := by intro u; cases u <;> simp

private instance {K : Type*} [Field K] [DecidableEq K] :
    DecidableRel (affineIncidence K).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [affineIncidence] <;> infer_instance

private theorem line_unique {K : Type*} [Field K] (p q l m : K × K)
    (hpq : p ≠ q)
    (hpl : p.2 = l.1 * p.1 + l.2) (hql : q.2 = l.1 * q.1 + l.2)
    (hpm : p.2 = m.1 * p.1 + m.2) (hqm : q.2 = m.1 * q.1 + m.2) : l = m := by
  have hx : p.1 ≠ q.1 := by
    intro he
    apply hpq
    apply Prod.ext he
    rw [hpl, hql, he]
  have hprod : (l.1 - m.1) * (p.1 - q.1) = 0 := by
    linear_combination -hpl + hql + hpm - hqm
  have ha : l.1 = m.1 := sub_eq_zero.mp ((mul_eq_zero.mp hprod).resolve_right (sub_ne_zero.mpr hx))
  apply Prod.ext ha
  rw [ha] at hpl
  linear_combination -hpl + hpm

private theorem affine_unique (K : Type*) [Field K] : UniqueCommon (affineIncidence K) := by
  intro u v huv a b hua hva hub hvb
  cases u <;> cases v <;> cases a <;> cases b <;>
    simp only [affineIncidence, Sum.inl.injEq, Sum.inr.injEq] at *
  · exact line_unique _ _ _ _ (fun he => huv (congrArg Sum.inl he)) hua hva hub hvb
  · by_contra hab
    exact huv (congrArg Sum.inr (line_unique _ _ _ _ hab hua hub hva hvb))

private theorem affine_edges_lower (K : Type*) [Field K] [Fintype K] [DecidableEq K] :
    Fintype.card K ^ 3 ≤ (affineIncidence K).edgeFinset.card := by
  classical
  let f : K × K × K → (affineIncidence K).edgeSet := fun t =>
    ⟨s(Sum.inl (t.1,t.2.1), Sum.inr (t.2.2, t.2.1 - t.2.2 * t.1)), by
      change t.2.1 = t.2.2 * t.1 + (t.2.1 - t.2.2 * t.1)
      ring⟩
  have hinj : Function.Injective f := by
    rintro ⟨x,y,a⟩ ⟨x',y',a'⟩ he
    have he' := congrArg Subtype.val he
    dsimp [f] at he'
    simp only [Sym2.eq_iff, Sum.inl.injEq, Sum.inr.injEq, Prod.mk.injEq,
      Sum.inl_ne_inr, false_and, or_false] at he'
    rcases he' with ⟨⟨rfl,rfl⟩, rfl, hb⟩
    rfl
  have hc := Fintype.card_le_of_injective f hinj
  simpa only [Fintype.card_prod, card_edgeSet, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using hc

private theorem affine_extremal_lower (p n : ℕ) (hp : p.Prime) (hn : 2 * p ^ 2 ≤ n) :
    p ^ 3 ≤ extremalNumber n FourCycle := by
  classical
  letI : Fact p.Prime := ⟨hp⟩
  let K := ZMod p
  let V := (K × K) ⊕ (K × K)
  have hcard : Fintype.card V ≤ Fintype.card (Fin n) := by
    simpa only [V, K, Fintype.card_sum, Fintype.card_prod, ZMod.card, Fintype.card_fin,
      ← two_mul, pow_two] using hn
  let f : V ↪ Fin n := (Function.Embedding.nonempty_of_card_le hcard).some
  let G := (affineIncidence K).map f
  have hfree : FourCycle.Free G := (four_free_iff G).mpr (uniqueCommon_map (affine_unique K) f)
  have he := card_edgeFinset_le_extremalNumber hfree
  have hl := affine_edges_lower K
  rw [card_edgeFinset_map] at he
  calc
    p ^ 3 ≤ (affineIncidence K).edgeFinset.card := by simpa only [K, ZMod.card] using hl
    _ ≤ extremalNumber n FourCycle := by simpa only [Fintype.card_fin] using he

private theorem prime_at_square_scale (n : ℕ) (hn : 16 ≤ n) :
    ∃ p : ℕ, p.Prime ∧ 2 * p ^ 2 ≤ n ∧ n ≤ 16 * p ^ 2 := by
  let k := n.sqrt / 4
  have hs4 : 4 ≤ n.sqrt := Nat.le_sqrt'.mpr hn
  have hk : k ≠ 0 := by dsimp [k]; omega
  obtain ⟨p, hp, hkp, hpk⟩ := Nat.exists_prime_lt_and_le_two_mul k hk
  refine ⟨p, hp, ?_, ?_⟩
  · have hks : 4 * k ≤ n.sqrt := by
      simpa only [k, Nat.mul_comm] using Nat.div_mul_le_self n.sqrt 4
    have hpsq := Nat.pow_le_pow_left hpk 2
    have hksq := (Nat.pow_le_pow_left hks 2).trans (Nat.sqrt_le' n)
    nlinarith
  · have hkupper : n.sqrt < 4 * (k + 1) := Nat.lt_mul_div_succ n.sqrt (by decide)
    have hps : n.sqrt + 1 ≤ 4 * p := by omega
    have hpsq := Nat.pow_le_pow_left hps 2
    have hnlt := Nat.lt_succ_sqrt' n
    nlinarith

private theorem four_extremal_bounds (n : ℕ) (hn : 16 ≤ n) :
    (extremalNumber n FourCycle : ℝ) ≤ (n : ℝ) * Real.sqrt n ∧
    (n : ℝ) * Real.sqrt n ≤ 64 * (extremalNumber n FourCycle : ℝ) := by
  constructor
  · have hn0 : (0 : ℝ) ≤ (n : ℝ) * Real.sqrt n := by positivity
    have h := (extremalNumber_le_iff_of_nonneg (V := Fin n) FourCycle hn0).mpr (by
      intro G _ hG
      simpa only [Fintype.card_fin] using four_edge_upper G hG)
    simpa only [Fintype.card_fin] using h
  · obtain ⟨p, hp, hpn, hnp⟩ := prime_at_square_scale n hn
    have hex : (p : ℝ) ^ 3 ≤ (extremalNumber n FourCycle : ℝ) := by
      exact_mod_cast affine_extremal_lower p n hp hpn
    have hnp' : (n : ℝ) ≤ 16 * (p : ℝ) ^ 2 := by exact_mod_cast hnp
    have hs : Real.sqrt (n : ℝ) ≤ 4 * p := by
      apply Real.sqrt_le_iff.mpr
      refine ⟨by positivity, ?_⟩
      nlinarith
    calc
      (n : ℝ) * Real.sqrt n ≤ (16 * (p : ℝ) ^ 2) * (4 * p) := by gcongr
      _ = 64 * (p : ℝ) ^ 3 := by ring
      _ ≤ 64 * (extremalNumber n FourCycle : ℝ) := by gcongr

private theorem rpow_three_halves (n : ℕ) (hn : 0 < n) :
    (n : ℝ) ^ ((3 / 2 : ℚ) : ℝ) = (n : ℝ) * Real.sqrt n := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hpow : ((3 / 2 : ℚ) : ℝ) = 1 + 1 / 2 := by norm_num
  rw [hpow, Real.rpow_add hn', Real.rpow_one, ← Real.sqrt_eq_rpow]

/-- The rational exponent 3/2 is witnessed by the four-cycle. -/
theorem exponent_three_halves :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta atTop
        (fun n : ℕ => (extremalNumber n G : ℝ))
        (fun n : ℕ => (n : ℝ) ^ ((3 / 2 : ℚ) : ℝ)) := by
  let e : (Fin 2 ⊕ Fin 2) ≃ Fin 4 := finSumFinEquiv
  let G := FourCycle.map e.toEmbedding
  refine ⟨4, G, ?_, ?_⟩
  · have hC : FourCycle.IsBipartite := by
      have h := (CompleteBipartiteGraph.bicoloring (Fin 2) (Fin 2)).colorable
      simpa only [Fintype.card_bool] using h
    exact hC.map e.toEmbedding
  · have heq : ∀ n, extremalNumber n G = extremalNumber n FourCycle := fun _ =>
      (extremalNumber_congr_right (SimpleGraph.Iso.map e FourCycle)).symm
    constructor
    · apply Asymptotics.IsBigO.of_bound 1
      filter_upwards [eventually_ge_atTop 16] with n hn
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _),
        abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), one_mul,
        rpow_three_halves n (by omega), heq]
      exact (four_extremal_bounds n hn).1
    · apply Asymptotics.IsBigO.of_bound 64
      filter_upwards [eventually_ge_atTop 16] with n hn
      rw [Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), abs_of_nonneg (Nat.cast_nonneg _),
        rpow_three_halves n (by omega), heq]
      exact (four_extremal_bounds n hn).2

/-- The two transformations generate all positive rational numbers at most one. -/
theorem rational_deficit_induction (P : ℚ → Prop)
    (hbase : P 1)
    (hlift : ∀ d : ℚ, 0 < d → d ≤ 1 → P d → P (d / (1 + d)))
    (hsub : ∀ d : ℚ, 0 < d → d ≤ 1 → P d → P ((1 + d) / 2)) :
    ∀ d : ℚ, 0 < d → d ≤ 1 → P d := by
  have hfrac : ∀ k : ℕ, ∀ p q : ℕ, p + q = k → 0 < p → p ≤ q → P (p / q) := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro p q hk hp hpq
      have hq : 0 < q := lt_of_lt_of_le hp hpq
      have hp' : (0 : ℚ) < p := by exact_mod_cast hp
      have hq' : (0 : ℚ) < q := by exact_mod_cast hq
      have hpq' : (p : ℚ) ≤ q := by exact_mod_cast hpq
      by_cases heq : p = q
      · subst q
        simpa only [div_self (ne_of_gt hp')] using hbase
      have hlt : p < q := lt_of_le_of_ne hpq heq
      by_cases hhalf : 2 * p ≤ q
      · have hpred : P ((p : ℚ) / (q - p : ℕ)) :=
          ih (p + (q - p)) (by omega) p (q - p) rfl hp (by omega)
        have hdiff : (0 : ℚ) < (q - p : ℕ) := by exact_mod_cast (show 0 < q - p by omega)
        have hle : (p : ℚ) / (q - p : ℕ) ≤ 1 := by
          apply (div_le_one hdiff).mpr
          exact_mod_cast (show p ≤ q - p by omega)
        have h := hlift _ (div_pos hp' hdiff) hle hpred
        convert h using 1
        rw [one_add_div (ne_of_gt hdiff), div_div_div_cancel_right₀ (ne_of_gt hdiff)]
        congr 1
        rw [← Nat.cast_add, Nat.sub_add_cancel hpq]
      · have hpred : P ((2 * p - q : ℕ) / (q : ℚ)) :=
          ih ((2 * p - q) + q) (by omega) (2 * p - q) q rfl (by omega) (by omega)
        have hdiff : (0 : ℚ) < (2 * p - q : ℕ) := by exact_mod_cast (show 0 < 2 * p - q by omega)
        have hle : ((2 * p - q : ℕ) : ℚ) / q ≤ 1 := by
          apply (div_le_one hq').mpr
          exact_mod_cast (show 2 * p - q ≤ q by omega)
        have h := hsub _ (div_pos hdiff hq') hle hpred
        convert h using 1
        rw [Nat.cast_sub (show q ≤ 2 * p by omega), Nat.cast_mul, Nat.cast_ofNat]
        field_simp
        <;> ring
  intro d hd hd1
  have hnum : 0 < d.num := Rat.num_pos.mpr hd
  have hnum_nat : ((d.num.natAbs : ℕ) : ℚ) = d.num := by
    rw [← Int.cast_natCast, Int.natAbs_of_nonneg (le_of_lt hnum)]
  have hrep : (d.num.natAbs : ℚ) / d.den = d := by
    rw [hnum_nat, Rat.num_div_den]
  have hp : 0 < d.num.natAbs := Int.natAbs_pos.mpr (ne_of_gt hnum)
  have hpq : d.num.natAbs ≤ d.den := by
    have hden : (0 : ℚ) < d.den := by exact_mod_cast d.den_pos
    have h := (div_le_one hden).mp (hrep ▸ hd1)
    exact_mod_cast h
  rw [← hrep]
  exact hfrac _ _ _ rfl hp hpq

/-- Distinct real powers on the naturals have strictly different growth rates. -/
theorem nat_rpow_not_isBigO_of_lt {a b : ℝ} (hab : a < b) :
    ¬ Asymptotics.IsBigO atTop (fun n : ℕ => (n : ℝ) ^ b)
      (fun n : ℕ => (n : ℝ) ^ a) := by
  intro h
  obtain ⟨c, hc⟩ := Asymptotics.isBigO_iff.mp h
  have ht : Tendsto (fun n : ℕ => (n : ℝ) ^ (b - a)) atTop atTop :=
    (tendsto_rpow_atTop (sub_pos.mpr hab)).comp tendsto_natCast_atTop_atTop
  have hg : ∀ᶠ n : ℕ in atTop, c < (n : ℝ) ^ (b - a) :=
    ht.eventually (eventually_gt_atTop c)
  obtain ⟨n, hn, hc, hg⟩ := ((eventually_ge_atTop 1).and (hc.and hg)).exists
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hpow : (n : ℝ) ^ b = (n : ℝ) ^ (b - a) * (n : ℝ) ^ a := by
    rw [← Real.rpow_add hn0, sub_add_cancel]
  simp only [Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hn0 _)] at hc
  rw [hpow] at hc
  exact (not_le_of_gt hg) ((mul_le_mul_iff_left₀ (Real.rpow_pos_of_pos hn0 a)).mp
    (by simpa only [mul_comm] using hc))

/-- A graph realizing an exponent below 3/2 cannot contain a four-cycle. -/
theorem fourCycle_free_of_small_exponent {V : Type*} (G : SimpleGraph V) (a : ℚ)
    (ha : a < 3 / 2)
    (hG : Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n G : ℝ))
      (fun n : ℕ => (n : ℝ) ^ (a : ℝ))) :
    (completeBipartiteGraph (Fin 2) (Fin 2)).Free G := by
  intro hcontains
  have hlower : Asymptotics.IsBigO atTop
      (fun n : ℕ => (n : ℝ) ^ ((3 / 2 : ℚ) : ℝ))
      (fun n : ℕ => (extremalNumber n G : ℝ)) := by
    apply Asymptotics.IsBigO.of_bound 64
    filter_upwards [eventually_ge_atTop 16] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _),
      abs_of_nonneg (Nat.cast_nonneg _), rpow_three_halves n (by omega)]
    calc
      (n : ℝ) * Real.sqrt n ≤ 64 * (extremalNumber n FourCycle : ℝ) :=
        (four_extremal_bounds n hn).2
      _ ≤ 64 * (extremalNumber n G : ℝ) := by
        gcongr
        exact_mod_cast hcontains.extremalNumber_le (n := n)
  exact nat_rpow_not_isBigO_of_lt (by exact_mod_cast ha) (hlower.trans hG.1)

private theorem tree_copy_of_degree {V : Type v} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {W : Type u} [Fintype W] (H : SimpleGraph W) (hH : H.IsTree)
    (hdeg : ∀ x, Fintype.card W ≤ G.degree x) : H ⊑ G := by
  classical
  generalize hn : Fintype.card W = n at *
  induction n using Nat.strong_induction_on generalizing W with
  | h n ih =>
    rcases subsingleton_or_nontrivial W with hW | hW
    · letI := hW
      refine ⟨⟨⟨fun _ => Classical.choice (inferInstance : Nonempty V), ?_⟩, ?_⟩⟩
      · intro x y hxy
        exact False.elim (hxy.ne (Subsingleton.elim _ _))
      · intro x y _
        exact Subsingleton.elim _ _
    letI := hW
    obtain ⟨z, hz⟩ := hH.exists_vert_degree_one_of_nontrivial
    obtain ⟨w, hzw, hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz
    let S : Set W := {z}ᶜ
    have hS : (H.induce S).IsTree :=
      ⟨hH.isConnected.induce_compl_singleton_of_degree_eq_one hz, hH.IsAcyclic.induce S⟩
    have hcS : Fintype.card S = n - 1 := by
      simp only [S, Fintype.card_compl_set, Fintype.card_unique, hn]
    have hnpos : 0 < n := by
      rw [← hn]
      exact Fintype.card_pos_iff.mpr hH.isConnected.nonempty
    have hSm : Fintype.card S < n := by omega
    obtain ⟨f⟩ := ih (Fintype.card S) hSm (H.induce S) hS
      rfl (fun x => by have := hdeg x; omega)
    let wS : S := ⟨w, by simpa only [S, Set.mem_compl_iff, Set.mem_singleton_iff] using hzw.ne'⟩
    let used : Finset V := univ.image f
    have hused : used.card < (G.neighborFinset (f wS)).card := by
      have hu : used.card ≤ Fintype.card S := by
        simpa only [used, card_univ] using card_image_le (f := f) (s := univ)
      have hd := hdeg (f wS)
      rw [card_neighborFinset_eq_degree]
      omega
    obtain ⟨y, hy, hyused⟩ := exists_mem_notMem_of_card_lt_card hused
    have hyadj : G.Adj (f wS) y := (G.mem_neighborFinset _ _).mp hy
    have hyne : ∀ x : S, y ≠ f x := by
      intro x hx
      apply hyused
      simp only [used, mem_image, mem_univ, true_and]
      exact ⟨x, hx.symm⟩
    let g : W → V := fun x => if h : x = z then y else f ⟨x, h⟩
    have g_z : g z = y := by simp [g]
    have g_ne (x : W) (hx : x ≠ z) : g x = f ⟨x, hx⟩ := by simp [g, hx]
    have hginj : Function.Injective g := by
      intro x x' he
      by_cases hx : x = z
      · subst x
        by_cases hx' : x' = z
        · exact hx'.symm
        · rw [g_z, g_ne _ hx'] at he
          exact False.elim (hyne _ he)
      · by_cases hx' : x' = z
        · subst x'
          rw [g_ne _ hx, g_z] at he
          exact False.elim (hyne _ he.symm)
        · rw [g_ne _ hx, g_ne _ hx'] at he
          exact congrArg Subtype.val (f.injective he)
    refine ⟨⟨⟨g, ?_⟩, hginj⟩⟩
    intro x x' hxx'
    by_cases hx : x = z
    · subst x
      have hx' : x' = w := hw x' hxx'
      subst x'
      rw [g_z, g_ne _ hzw.ne']
      exact hyadj.symm
    · by_cases hx' : x' = z
      · subst x'
        have hxw : x = w := hw x hxx'.symm
        subst x
        rw [g_ne _ hzw.ne', g_z]
        exact hyadj
      · rw [g_ne _ hx, g_ne _ hx']
        exact f.toHom.map_adj hxx'

private theorem forest_copy_of_degree {V : Type v} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {W : Type u} [Fintype W] (H : SimpleGraph W) (hH : H.IsAcyclic)
    (hdeg : ∀ x, Fintype.card W ≤ G.degree x) : H ⊑ G := by
  classical
  rcases isEmpty_or_nonempty W with hW | hW
  · letI := hW
    exact IsContained.of_isEmpty
  letI := hW
  obtain ⟨T, hHT, hT⟩ := exists_maximal_isAcyclic_of_le_isAcyclic
    (G := (⊤ : SimpleGraph W)) le_top hH
  have htree : T.IsTree := connected_top.maximal_le_isAcyclic_iff_isTree hT.prop.1 |>.mp hT
  exact (IsContained.of_le hHT).trans (tree_copy_of_degree G T htree hdeg)

private theorem forest_edge_bound {W : Type u} [Fintype W]
    (H : SimpleGraph W) (hH : H.IsAcyclic)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hf : H.Free G) : G.edgeFinset.card ≤ Fintype.card W * Fintype.card V := by
  classical
  generalize hn : Fintype.card V = n at *
  induction n using Nat.strong_induction_on generalizing V with
  | h n ih =>
    rcases isEmpty_or_nonempty V with hV | hV
    · letI := hV
      rw [← card_edgeSet]
      simp only [Fintype.card_of_isEmpty, Nat.zero_le]
    letI := hV
    have hnpos : 0 < n := by rw [← hn]; exact Fintype.card_pos
    have hlow : ∃ z, G.degree z < Fintype.card W := by
      by_contra! h
      exact hf (forest_copy_of_degree G H hH h)
    obtain ⟨z, hz⟩ := hlow
    let S : Set V := {z}ᶜ
    have hSfree : H.Free (G.induce S) := fun hh => hf (hh.trans ⟨Copy.induce G S⟩)
    have hcS : Fintype.card S = n - 1 := by
      simp only [S, Fintype.card_compl_set, Fintype.card_unique, hn]
    have hSm : Fintype.card S < n := by omega
    have hI := ih (Fintype.card S) hSm (G.induce S) hSfree rfl
    rw [hcS] at hI
    have he : (G.induce S).edgeFinset.card + G.degree z = G.edgeFinset.card := by
      rw [card_edgeFinset_induce_compl_singleton, card_edgeFinset_deleteIncidenceSet,
        Nat.sub_add_cancel (G.degree_le_card_edgeFinset z)]
    have hsub : n - 1 + 1 = n := by omega
    nlinarith

/-- A finite forest has an at-most-linear extremal number. -/
theorem extremalNumber_forest_le {W : Type u} [Fintype W]
    (H : SimpleGraph W) (hH : H.IsAcyclic) (n : ℕ) :
    extremalNumber n H ≤ Fintype.card W * n := by
  rw [← Fintype.card_fin n, extremalNumber_le_iff]
  intro G _ hf
  exact forest_edge_bound H hH G hf

/-- Any finite graph realizing a superlinear exponent contains a cycle. -/
theorem not_isAcyclic_of_superlinear {W : Type u} [Fintype W]
    (H : SimpleGraph W) (a : ℚ) (ha : 1 < a)
    (hH : Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n H : ℝ))
      (fun n : ℕ => (n : ℝ) ^ (a : ℝ))) : ¬ H.IsAcyclic := by
  intro hforest
  have hlin : Asymptotics.IsBigO atTop
      (fun n : ℕ => (extremalNumber n H : ℝ)) (fun n : ℕ => (n : ℝ) ^ (1 : ℝ)) := by
    apply Asymptotics.IsBigO.of_bound (Fintype.card W)
    apply Filter.Eventually.of_forall
    intro n
    rw [Real.rpow_one, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Nat.cast_nonneg _), abs_of_nonneg (Nat.cast_nonneg _)]
    exact_mod_cast extremalNumber_forest_le H hforest n
  exact nat_rpow_not_isBigO_of_lt (by exact_mod_cast ha) (hH.2.trans hlin)

/-- A rational number is realized by a single finite bipartite forbidden graph. -/
def RealizableExponent (a : ℚ) : Prop :=
  ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
    Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n G : ℝ))
      (fun n : ℕ => (n : ℝ) ^ (a : ℝ))

/-- The full rational-exponent assertion follows from these two closure properties.
Neither closure property is asserted here. -/
theorem rational_turan_of_closure
    (hlift : ∀ a : ℚ, 1 ≤ a → a < 2 → RealizableExponent a →
      RealizableExponent ((4 - a) / (3 - a)))
    (hsub : ∀ a : ℚ, 1 ≤ a → a < 2 → RealizableExponent a →
      RealizableExponent ((1 + a) / 2)) :
    ∀ a : ℚ, 1 ≤ a → a < 2 → RealizableExponent a := by
  have hdef : ∀ d : ℚ, 0 < d → d ≤ 1 → RealizableExponent (2 - d) := by
    apply rational_deficit_induction
    · simpa only [show (2 : ℚ) - 1 = 1 by norm_num] using endpoint_one
    · intro d hd hd1 h
      have ha1 : (1 : ℚ) ≤ 2 - d := by linarith
      have ha2 : (2 : ℚ) - d < 2 := by linarith
      have heq : (2 : ℚ) - d / (1 + d) = (4 - (2 - d)) / (3 - (2 - d)) := by
        have hpos : (0 : ℚ) < 1 + d := by linarith
        have hpos' : (0 : ℚ) < 3 - (2 - d) := by linarith
        field_simp
        ring
      rw [heq]
      exact hlift (2 - d) ha1 ha2 h
    · intro d hd hd1 h
      have heq : (2 : ℚ) - (1 + d) / 2 = (1 + (2 - d)) / 2 := by ring
      rw [heq]
      exact hsub (2 - d) (by linarith) (by linarith) h
  intro a ha1 ha2
  have h := hdef (2 - a) (by linarith) (by linarith)
  simpa only [sub_sub_cancel] using h

/-- The two closure claims together are equivalent to the full assertion. -/
theorem rational_turan_iff_closure :
    (∀ a : ℚ, 1 ≤ a → a < 2 → RealizableExponent a) ↔
      (∀ a : ℚ, 1 ≤ a → a < 2 → RealizableExponent a →
        RealizableExponent ((4 - a) / (3 - a))) ∧
      (∀ a : ℚ, 1 ≤ a → a < 2 → RealizableExponent a →
        RealizableExponent ((1 + a) / 2)) := by
  constructor
  · intro h
    constructor
    · intro a ha1 ha2 _
      have hp : (0 : ℚ) < 3 - a := by linarith
      apply h
      · apply (le_div_iff₀ hp).mpr
        linarith
      · apply (div_lt_iff₀ hp).mpr
        linarith
    · intro a ha1 ha2 _
      apply h <;> linarith
  · rintro ⟨hlift, hsub⟩
    exact rational_turan_of_closure hlift hsub

namespace RandomDeletion

variable {I : Type*} [Fintype I] [DecidableEq I]

def weight (p : ℝ) (b : I → Bool) : ℝ := ∏ i, if b i then p else 1 - p

omit [DecidableEq I] in
lemma weight_nonneg {p : ℝ} (hp : 0 ≤ p) (hp1 : p ≤ 1) (b : I → Bool) :
    0 ≤ weight p b := by
  apply prod_nonneg
  intro i _
  split_ifs
  · exact hp
  · exact sub_nonneg.mpr hp1

lemma sum_weight (p : ℝ) : ∑ b : I → Bool, weight p b = 1 := by
  simp only [weight]
  rw [← Fintype.prod_sum (fun (_ : I) (t : Bool) => if t then p else 1 - p)]
  simp

lemma pattern_weight (p : ℝ) (S : Finset I) :
    ∑ b : I → Bool, weight p b * (if ∀ i ∈ S, b i = true then 1 else 0) = p ^ S.card := by
  have hprod (b : I → Bool) :
      weight p b * (if ∀ i ∈ S, b i = true then 1 else 0) =
      ∏ i, if i ∈ S then (if b i then p else 0) else (if b i then p else 1 - p) := by
    rw [show (if ∀ i ∈ S, b i = true then (1 : ℝ) else 0) =
        ∏ i ∈ S, if b i then (1 : ℝ) else 0 by
          by_cases h : ∀ i ∈ S, b i = true <;> simp [prod_boole, h]]
    rw [← prod_ite_mem_eq S (fun i => if b i then (1 : ℝ) else 0)]
    rw [weight, ← prod_mul_distrib]
    apply prod_congr rfl
    intro i _
    by_cases hi : i ∈ S <;> cases b i <;> simp [hi]
  simp_rw [hprod]
  rw [← Fintype.prod_sum (fun (i : I) (t : Bool) =>
    if i ∈ S then (if t then p else 0) else (if t then p else 1 - p))]
  simp only [Fintype.sum_bool, ↓reduceIte, Bool.false_eq_true]
  have he : (fun i => (if i ∈ S then p else p) + (if i ∈ S then 0 else 1 - p)) =
      (fun i => if i ∈ S then p else 1) := by
    funext i
    by_cases hi : i ∈ S <;> simp [hi]
  simp only [he]
  rw [prod_ite_mem_eq, prod_const]

lemma weighted_max (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) (f : (I → Bool) → ℝ) :
    ∃ b : I → Bool, (∑ c : I → Bool, weight p c * f c) ≤ f b := by
  obtain ⟨b, _, hb⟩ := exists_max_image univ f univ_nonempty
  refine ⟨b, ?_⟩
  calc
    (∑ c : I → Bool, weight p c * f c) ≤ ∑ c : I → Bool, weight p c * f b := by
      apply sum_le_sum
      intro c _
      exact mul_le_mul_of_nonneg_left (hb c (mem_univ _)) (weight_nonneg hp hp1 c)
    _ = f b := by rw [← sum_mul, sum_weight, one_mul]


def selected (b : I → Bool) : Finset I := univ.filter (fun i => b i = true)

lemma expected_selected_card (p : ℝ) :
    ∑ b : I → Bool, weight p b * (selected b).card = p * Fintype.card I := by
  have hc (b : I → Bool) : ((selected b).card : ℝ) = ∑ i, if b i then 1 else 0 := by
    exact (sum_boole (fun i => b i = true) univ).symm
  simp_rw [hc, mul_sum]
  rw [sum_comm]
  calc
    (∑ i, ∑ b : I → Bool, weight p b * (if b i then 1 else 0)) = ∑ _i : I, p := by
      apply sum_congr rfl
      intro i _
      simpa only [mem_singleton, forall_eq, card_singleton, pow_one] using pattern_weight p {i}
    _ = p * Fintype.card I := by simp [mul_comm]

def active {J : Type*} [Fintype J] (P : J → Finset I) (b : I → Bool) : Finset J :=
  univ.filter (fun j => P j ⊆ selected b)

lemma expected_active_card {J : Type*} [Fintype J] (P : J → Finset I) (p : ℝ) :
    ∑ b : I → Bool, weight p b * (active P b).card = ∑ j, p ^ (P j).card := by
  have hc (b : I → Bool) : ((active P b).card : ℝ) =
      ∑ j, if ∀ i ∈ P j, b i = true then 1 else 0 := by
    simp only [active, ← sum_boole]
    apply sum_congr rfl
    intro j _
    have he : P j ⊆ selected b ↔ ∀ i ∈ P j, b i = true := by
      simp only [subset_iff, selected, mem_filter, mem_univ, true_and]
    simp only [he]
  simp_rw [hc, mul_sum]
  rw [sum_comm]
  exact sum_congr rfl (fun j _ => pattern_weight p (P j))

/-- The elementary random-deletion bound for a finite family of nonempty patterns. -/
theorem exists_avoiding_patterns {J : Type*} [Fintype J]
    (P : J → Finset I) (hne : ∀ j, (P j).Nonempty)
    (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) :
    ∃ S : Finset I, p * Fintype.card I - ∑ j, p ^ (P j).card ≤ S.card ∧
      ∀ j, ¬ P j ⊆ S := by
  classical
  obtain ⟨b, hb⟩ := weighted_max p hp hp1
    (fun b => ((selected b).card : ℝ) - (active P b).card)
  simp_rw [mul_sub, sum_sub_distrib, expected_selected_card, expected_active_card] at hb
  choose del hdel using hne
  let K := active P b
  let D := K.image del
  let S := selected b \ D
  refine ⟨S, ?_, ?_⟩
  · have hD : D.card ≤ K.card := card_image_le
    have hsplit : S.card + (selected b ∩ D).card = (selected b).card :=
      card_sdiff_add_card_inter _ _
    have hi : (selected b ∩ D).card ≤ D.card := card_le_card inter_subset_right
    have hc : (selected b).card ≤ S.card + K.card := by omega
    have hcr : ((selected b).card : ℝ) ≤ S.card + K.card := by exact_mod_cast hc
    change p * Fintype.card I - ∑ j, p ^ (P j).card ≤ (S.card : ℝ)
    change p * Fintype.card I - ∑ j, p ^ (P j).card ≤
      ((selected b).card : ℝ) - K.card at hb
    linarith
  · intro j hj
    have hjs : P j ⊆ selected b := hj.trans sdiff_subset
    have hjK : j ∈ K := mem_filter.mpr ⟨mem_univ _, hjs⟩
    have hdS := hj (hdel j)
    exact (mem_sdiff.mp hdS).2 (mem_image.mpr ⟨j, hjK, rfl⟩)


open SimpleGraph

/-- The standard random-deletion inequality for avoiding one finite graph. -/
theorem exists_free_subgraph {V W : Type*} [Fintype V] [Fintype W]
    (B : SimpleGraph V) (H : SimpleGraph W) (hH : H ≠ ⊥)
    (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) :
    ∃ G : SimpleGraph V, G ≤ B ∧ H.Free G ∧
      p * (Nat.card B.edgeSet : ℝ) - (B.labelledCopyCount H : ℝ) * p ^ Nat.card H.edgeSet ≤
        (Nat.card G.edgeSet : ℝ) := by
  classical
  let P : H.Copy B → Finset B.edgeSet := fun f => univ.map f.mapEdgeSet
  have hP (f : H.Copy B) : (P f).Nonempty := by
    obtain ⟨e, he⟩ := edgeSet_nonempty.mpr hH
    exact ⟨f.mapEdgeSet ⟨e, he⟩, mem_map.mpr ⟨⟨e, he⟩, mem_univ _, rfl⟩⟩
  obtain ⟨S, hSc, hS⟩ := exists_avoiding_patterns P hP p hp hp1
  let G := fromEdgeSet (Subtype.val '' (S : Set B.edgeSet))
  have hGe : G.edgeSet = Subtype.val '' (S : Set B.edgeSet) := by
    rw [edgeSet_fromEdgeSet]
    ext e
    constructor
    · exact And.left
    · intro he
      refine ⟨he, ?_⟩
      obtain ⟨e', he', rfl⟩ := he
      exact B.edgeSet_subset_setOf_not_isDiag e'.prop
  have hle : G ≤ B := by
    intro u v huv
    have he : s(u, v) ∈ G.edgeSet := huv
    rw [hGe] at he
    obtain ⟨e, he, hev⟩ := he
    change s(u, v) ∈ B.edgeSet
    rw [← hev]
    exact e.prop
  have hfree : H.Free G := by
    rintro ⟨g⟩
    let f : H.Copy B := (Copy.ofLE G B hle).comp g
    apply hS f
    intro e he
    obtain ⟨a, ha, rfl⟩ := mem_map.mp he
    have hga : Sym2.map g a.val ∈ G.edgeSet := g.toHom.map_mem_edgeSet a.prop
    rw [hGe] at hga
    obtain ⟨d, hd, hda⟩ := hga
    have hdf : d = f.mapEdgeSet a := by
      apply Subtype.ext
      exact hda
    rw [← hdf]
    exact hd
  have hcard : Nat.card G.edgeSet = S.card := by
    let g : S → G.edgeSet := fun e => ⟨e.val.val, by
      rw [hGe]
      exact ⟨e.val, e.prop, rfl⟩⟩
    have hg : Function.Bijective g := by
      constructor
      · intro e f h
        apply Subtype.ext
        apply Subtype.ext
        exact congrArg (fun x : G.edgeSet => x.val) h
      · rintro ⟨e, he⟩
        rw [hGe] at he
        obtain ⟨e', he', rfl⟩ := he
        exact ⟨⟨e', he'⟩, rfl⟩
    have hc := Nat.card_congr (Equiv.ofBijective g hg)
    simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using hc.symm
  refine ⟨G, hle, hfree, ?_⟩
  rw [hcard]
  simpa only [P, card_map, card_univ, sum_const, nsmul_eq_mul,
    labelledCopyCount, ← Nat.card_eq_fintype_card] using hSc

/-- A convenient version using only the number of vertices and edges of the forbidden graph. -/
theorem extremal_random_lower {W : Type*} [Fintype W]
    (H : SimpleGraph W) (hH : H ≠ ⊥) (n : ℕ)
    (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) :
    p * (n.choose 2 : ℝ) - (n : ℝ) ^ Fintype.card W * p ^ Nat.card H.edgeSet ≤
      (extremalNumber n H : ℝ) := by
  classical
  obtain ⟨G, hG, hfree, hbound⟩ := exists_free_subgraph (⊤ : SimpleGraph (Fin n)) H hH p hp hp1
  have hc : (⊤ : SimpleGraph (Fin n)).labelledCopyCount H ≤ n ^ Fintype.card W := by
    have h := Fintype.card_le_of_injective (fun f : H.Copy (⊤ : SimpleGraph (Fin n)) => ⇑f)
      DFunLike.coe_injective
    rw [Fintype.card_fun, Fintype.card_fin] at h
    simp only [labelledCopyCount, ← Nat.card_eq_fintype_card]
    simpa only [← Nat.card_eq_fintype_card] using h
  have he : (Nat.card G.edgeSet : ℝ) ≤ extremalNumber n H := by
    have he := card_edgeFinset_le_extremalNumber hfree
    simp only [Fintype.card_fin] at he
    simpa only [Fintype.card_fin, Nat.card_eq_fintype_card, card_edgeSet] using
      (show (G.edgeFinset.card : ℝ) ≤ extremalNumber n H by exact_mod_cast he)
  have htop : Nat.card (⊤ : SimpleGraph (Fin n)).edgeSet = n.choose 2 := by
    rw [Nat.card_eq_fintype_card, card_edgeSet, card_edgeFinset_top_eq_card_choose_two,
      Fintype.card_fin]
  rw [htop] at hbound
  have hcr : ((⊤ : SimpleGraph (Fin n)).labelledCopyCount H : ℝ) ≤ (n : ℝ) ^ Fintype.card W := by
    exact_mod_cast hc
  apply le_trans _ (hbound.trans he)
  apply sub_le_sub_left
  exact mul_le_mul_of_nonneg_right hcr (pow_nonneg hp _)


/-- The random-deletion exponent for a graph with at least two edges. -/
theorem random_exponent_bound {W : Type*} [Fintype W]
    (H : SimpleGraph W) (hv : 2 ≤ Fintype.card W) (he : 2 ≤ Nat.card H.edgeSet)
    (n : ℕ) (hn : 2 ≤ n) :
    (n : ℝ) ^ (2 - ((Fintype.card W : ℝ) - 2) / ((Nat.card H.edgeSet : ℝ) - 1)) ≤
      64 * (extremalNumber n H : ℝ) := by
  have hH : H ≠ ⊥ := by
    intro h
    subst H
    simp at he
  let v := Fintype.card W
  let e := Nat.card H.edgeSet
  let d : ℝ := ((v : ℝ) - 2) / ((e : ℝ) - 1)
  have hv' : (2 : ℝ) ≤ v := by exact_mod_cast hv
  have he' : (2 : ℝ) ≤ e := by exact_mod_cast he
  have hd : 0 ≤ d := div_nonneg (by linarith) (by linarith)
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hn0 : (0 : ℝ) < n := by linarith
  have hneg : (n : ℝ) ^ (-d) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
  let p : ℝ := (1 / 8) * (n : ℝ) ^ (-d)
  have hp : 0 ≤ p := by dsimp [p]; positivity
  have hp1 : p ≤ 1 := by dsimp [p]; linarith
  have hbound := extremal_random_lower H hH n p hp hp1
  have hexp : (v : ℝ) + (-d) * (e : ℝ) = 2 - d := by
    have hd' : d * ((e : ℝ) - 1) = (v : ℝ) - 2 :=
      div_mul_cancel₀ _ (by linarith)
    nlinarith
  have hpower : (n : ℝ) ^ v * p ^ e = (1 / 8 : ℝ) ^ e * (n : ℝ) ^ (2 - d) := by
    calc
      (n : ℝ) ^ v * p ^ e = (1 / 8 : ℝ) ^ e *
          ((n : ℝ) ^ (v : ℝ) * ((n : ℝ) ^ (-d)) ^ e) := by
        rw [Real.rpow_natCast]
        dsimp [p]
        rw [mul_pow]
        ring
      _ = (1 / 8 : ℝ) ^ e * (n : ℝ) ^ ((v : ℝ) + (-d) * (e : ℝ)) := by
        rw [← Real.rpow_mul_natCast hn0.le, ← Real.rpow_add hn0]
      _ = (1 / 8 : ℝ) ^ e * (n : ℝ) ^ (2 - d) := by rw [hexp]
  have hc : (1 / 8 : ℝ) ^ e ≤ 1 / 64 := by
    calc
      (1 / 8 : ℝ) ^ e ≤ (1 / 8 : ℝ) ^ 2 := pow_le_pow_of_le_one (by norm_num)
        (by norm_num) he
      _ = 1 / 64 := by norm_num
  have hcopy : (n : ℝ) ^ v * p ^ e ≤ (1 / 64) * (n : ℝ) ^ (2 - d) := by
    rw [hpower]
    exact mul_le_mul_of_nonneg_right hc (Real.rpow_nonneg hn0.le _)
  have hchoose : (n : ℝ) ^ 2 / 4 ≤ (n.choose 2 : ℝ) := by
    rw [Nat.cast_choose_two]
    nlinarith
  have hedges : (1 / 32) * (n : ℝ) ^ (2 - d) ≤ p * (n.choose 2 : ℝ) := by
    calc
      (1 / 32) * (n : ℝ) ^ (2 - d) = p * ((n : ℝ) ^ 2 / 4) := by
        rw [sub_eq_add_neg, Real.rpow_add hn0, Real.rpow_two]
        dsimp [p]
        ring
      _ ≤ p * (n.choose 2 : ℝ) := mul_le_mul_of_nonneg_left hchoose hp
  change (n : ℝ) ^ (2 - d) ≤ 64 * (extremalNumber n H : ℝ)
  change p * (n.choose 2 : ℝ) - (n : ℝ) ^ v * p ^ e ≤ (extremalNumber n H : ℝ) at hbound
  linarith


/-- The elementary random lower bound obstructs an upper exponent whenever
this edge-to-vertex density inequality is strict. -/
theorem not_isBigO_of_random_density {W : Type*} [Fintype W]
    (H : SimpleGraph W) (hv : 2 ≤ Fintype.card W) (he : 2 ≤ Nat.card H.edgeSet)
    (a : ℝ) (hgap : (Fintype.card W : ℝ) - 2 <
      (2 - a) * ((Nat.card H.edgeSet : ℝ) - 1)) :
    ¬ Asymptotics.IsBigO atTop (fun n : ℕ => (extremalNumber n H : ℝ))
      (fun n : ℕ => (n : ℝ) ^ a) := by
  intro hupper
  let b : ℝ := 2 - ((Fintype.card W : ℝ) - 2) / ((Nat.card H.edgeSet : ℝ) - 1)
  have he' : (0 : ℝ) < (Nat.card H.edgeSet : ℝ) - 1 := by
    have : (2 : ℝ) ≤ Nat.card H.edgeSet := by exact_mod_cast he
    linarith
  have hab : a < b := by
    have hdiv := (div_lt_iff₀ he').mpr hgap
    change a < 2 - ((Fintype.card W : ℝ) - 2) / ((Nat.card H.edgeSet : ℝ) - 1)
    linarith
  have hlower : Asymptotics.IsBigO atTop (fun n : ℕ => (n : ℝ) ^ b)
      (fun n : ℕ => (extremalNumber n H : ℝ)) := by
    apply Asymptotics.IsBigO.of_bound 64
    filter_upwards [eventually_ge_atTop 2] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), abs_of_nonneg (Nat.cast_nonneg _)]
    exact random_exponent_bound H hv he n hn
  exact nat_rpow_not_isBigO_of_lt hab (hlower.trans hupper)

end RandomDeletion


namespace TreeCount


noncomputable def extendLeaf {W : Type u} {V : Type v}
    (H : SimpleGraph W) (G : SimpleGraph V) (z w : W) (hzw : H.Adj z w)
    (hw : ∀ x, H.Adj z x → x = w)
    (f : (H.induce ({z}ᶜ : Set W)).Copy G) (y : V)
    (hyadj : G.Adj (f ⟨w, hzw.ne'⟩) y)
    (hyne : ∀ x, y ≠ f x) : H.Copy G := by
  classical
  let g : W → V := fun x => if h : x = z then y else f ⟨x, h⟩
  have g_z : g z = y := by simp [g]
  have g_ne (x : W) (hx : x ≠ z) : g x = f ⟨x, hx⟩ := by simp [g, hx]
  have hginj : Function.Injective g := by
    intro x x' he
    by_cases hx : x = z
    · subst x
      by_cases hx' : x' = z
      · exact hx'.symm
      · rw [g_z, g_ne _ hx'] at he
        exact False.elim (hyne _ he)
    · by_cases hx' : x' = z
      · subst x'
        rw [g_ne _ hx, g_z] at he
        exact False.elim (hyne _ he.symm)
      · rw [g_ne _ hx, g_ne _ hx'] at he
        exact congrArg Subtype.val (f.injective he)
  refine ⟨⟨g, ?_⟩, hginj⟩
  intro x x' hxx'
  by_cases hx : x = z
  · subst x
    have hx' : x' = w := hw x' hxx'
    subst x'
    rw [g_z, g_ne _ hzw.ne']
    exact hyadj.symm
  · by_cases hx' : x' = z
    · subst x'
      have hxw : x = w := hw x hxx'.symm
      subst x
      rw [g_ne _ hzw.ne', g_z]
      exact hyadj
    · rw [g_ne _ hx, g_ne _ hx']
      exact f.toHom.map_adj hxx'

@[simp] lemma extendLeaf_at_leaf {W : Type u} {V : Type v}
    (H : SimpleGraph W) (G : SimpleGraph V) (z w : W) (hzw : H.Adj z w)
    (hw : ∀ x, H.Adj z x → x = w)
    (f : (H.induce ({z}ᶜ : Set W)).Copy G) (y : V) (hyadj) (hyne) :
    extendLeaf H G z w hzw hw f y hyadj hyne z = y := by
  classical
  simp [extendLeaf]

@[simp] lemma extendLeaf_at_old {W : Type u} {V : Type v}
    (H : SimpleGraph W) (G : SimpleGraph V) (z w : W) (hzw : H.Adj z w)
    (hw : ∀ x, H.Adj z x → x = w)
    (f : (H.induce ({z}ᶜ : Set W)).Copy G) (y : V) (hyadj) (hyne)
    (x : ({z}ᶜ : Set W)) :
    extendLeaf H G z w hzw hw f y hyadj hyne x = f x := by
  classical
  simp [extendLeaf, show x.val ≠ z from x.prop]

set_option maxHeartbeats 400000 in
lemma leaf_count_step {W : Type u} [Fintype W] [DecidableEq W] {V : Type v} [Fintype V]
    (H : SimpleGraph W) (G : SimpleGraph V) [DecidableRel G.Adj]
    (z w : W) (hzw : H.Adj z w) (hw : ∀ x, H.Adj z x → x = w)
    (D : ℕ) (hdeg : ∀ x, D + Fintype.card ({z}ᶜ : Set W) ≤ G.degree x) :
    D * G.labelledCopyCount (H.induce ({z}ᶜ : Set W)) ≤ G.labelledCopyCount H := by
  classical
  let S : Set W := {z}ᶜ
  let wS : S := ⟨w, hzw.ne'⟩
  let C := (H.induce S).Copy G
  let avail : C → Finset V := fun f => G.neighborFinset (f wS) \ univ.image f
  have hcard (f : C) : D ≤ (avail f).card := by
    have hc : (univ.image f).card ≤ Fintype.card S := by
      simpa only [card_univ] using card_image_le (f := f) (s := univ)
    have hd := hdeg (f wS)
    simp only [← Nat.card_eq_fintype_card, S] at hc hd
    have hs := card_sdiff_add_card_inter (G.neighborFinset (f wS)) (univ.image f)
    have hi : ((G.neighborFinset (f wS)) ∩ univ.image f).card ≤ (univ.image f).card :=
      card_le_card inter_subset_right
    rw [card_neighborFinset_eq_degree] at hs
    change D ≤ (G.neighborFinset (f wS) \ univ.image f).card
    omega
  have adj (f : C) (y : avail f) : G.Adj (f wS) y :=
    (G.mem_neighborFinset _ _).mp (mem_sdiff.mp y.prop).1
  have fresh (f : C) (y : avail f) : ∀ x, y.val ≠ f x := by
    intro x hx
    apply (mem_sdiff.mp y.prop).2
    exact mem_image.mpr ⟨x, mem_univ _, hx.symm⟩
  let ext : (Σ f : C, avail f) → H.Copy G := fun t =>
    extendLeaf H G z w hzw hw t.1 t.2 (adj t.1 t.2) (fresh t.1 t.2)
  have hinj : Function.Injective ext := by
    rintro ⟨f, y⟩ ⟨g, y'⟩ he
    have hf : f = g := by
      apply Copy.ext
      intro x
      have hh := congrArg (fun c : H.Copy G => c x) he
      simpa only [ext, extendLeaf_at_old] using hh
    subst g
    have hy : y = y' := by
      apply Subtype.ext
      have hh := congrArg (fun c : H.Copy G => c z) he
      simpa only [ext, extendLeaf_at_leaf] using hh
    subst y'
    rfl
  have hsum : D * Fintype.card C ≤ Fintype.card (Σ f : C, avail f) := by
    rw [Fintype.card_sigma]
    calc
      D * Fintype.card C = ∑ _f : C, D := by simp [mul_comm]
      _ ≤ ∑ f : C, Fintype.card (avail f) := by
        apply sum_le_sum
        intro f _
        simpa only [Fintype.card_coe] using hcard f
  have h := hsum.trans (Fintype.card_le_of_injective ext hinj)
  simp only [labelledCopyCount, ← Nat.card_eq_fintype_card]
  simpa only [← Nat.card_eq_fintype_card] using h


/-- A greedy lower bound for labelled copies of any tree. -/
theorem tree_count_of_degree {V : Type v} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {W : Type u} [Fintype W] (H : SimpleGraph W) (hH : H.IsTree)
    (D : ℕ) (hdeg : ∀ x, D + Fintype.card W ≤ G.degree x) :
    Fintype.card V * D ^ (Fintype.card W - 1) ≤ G.labelledCopyCount H := by
  classical
  generalize hn : Fintype.card W = n at *
  induction n using Nat.strong_induction_on generalizing W with
  | h n ih =>
    letI : Nonempty W := hH.isConnected.nonempty
    rcases subsingleton_or_nontrivial W with hW | hW
    · letI := hW
      letI : Unique W := uniqueOfSubsingleton (Classical.choice (inferInstance : Nonempty W))
      let f : V → H.Copy G := fun v =>
        ⟨⟨fun _ => v, fun {a b} h => (h.ne (Subsingleton.elim a b)).elim⟩,
          fun _ _ _ => Subsingleton.elim _ _⟩
      have hf : Function.Injective f := by
        intro v w h
        exact congrArg (fun c : H.Copy G => c default) h
      have hc := Fintype.card_le_of_injective f hf
      have hn1 : n = 1 := by rw [← hn]; exact Fintype.card_unique
      rw [hn1, Nat.sub_self, pow_zero, mul_one]
      simp only [labelledCopyCount, ← Nat.card_eq_fintype_card]
      simpa only [← Nat.card_eq_fintype_card] using hc
    · letI := hW
      obtain ⟨z, hz⟩ := hH.exists_vert_degree_one_of_nontrivial
      obtain ⟨w, hzw, hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz
      let S : Set W := {z}ᶜ
      have hS : (H.induce S).IsTree :=
        ⟨hH.isConnected.induce_compl_singleton_of_degree_eq_one hz, hH.IsAcyclic.induce S⟩
      have hcS : Fintype.card S = n - 1 := by
        simp only [S, Fintype.card_compl_set, Fintype.card_unique, hn]
      have hn2 : 2 ≤ n := by rw [← hn]; exact Fintype.one_lt_card_iff_nontrivial.mpr hW
      have hSm : Fintype.card S < n := by omega
      have hI := ih (Fintype.card S) hSm (H.induce S) hS rfl
        (fun x => by have := hdeg x; omega)
      have hstep := leaf_count_step H G z w hzw hw D
        (fun x => by have := hdeg x; simpa only [← hcS] using
          (show D + (n - 1) ≤ G.degree x by omega))
      have hp : n - 1 = (n - 1 - 1) + 1 := by omega
      rw [hcS] at hI
      calc
        Fintype.card V * D ^ (n - 1) = D * (Fintype.card V * D ^ (n - 1 - 1)) := by
          conv_lhs => rw [hp, pow_succ]
          ring
        _ ≤ D * G.labelledCopyCount (H.induce S) := Nat.mul_le_mul_left D hI
        _ ≤ G.labelledCopyCount H := hstep


/-- Distinct copies sharing their root images. Their nonroot images may overlap. -/
def CommonRootCopies {A R V : Type*} (H : SimpleGraph (A ⊕ R))
    (G : SimpleGraph V) (p : ℕ) : Prop :=
  ∃ r : R ↪ V, ∃ f : Fin p → H.Copy G, Function.Injective f ∧
    ∀ i x, f i (.inr x) = r x

lemma CommonRootCopies.mono {A R V W : Type*}
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph V} {G' : SimpleGraph W} {p : ℕ}
    (h : CommonRootCopies H G p) (g : G.Copy G') : CommonRootCopies H G' p := by
  obtain ⟨r, f, hf, hr⟩ := h
  refine ⟨r.trans g.toEmbedding, fun i => g.comp (f i), ?_, ?_⟩
  · intro i j he
    apply hf
    apply Copy.ext
    intro x
    apply g.injective
    exact congrArg (fun c : H.Copy G' => c x) he
  · intro i x
    change g (f i (.inr x)) = g (r x)
    rw [hr]

/-- Pigeonhole on the root tuple. This produces distinct, not internally disjoint, copies. -/
lemma commonRootCopies_of_count {A R V : Type*} [Fintype A] [Fintype R] [Fintype V]
    (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph V) (p : ℕ)
    (hcount : p * Fintype.card V ^ Fintype.card R < G.labelledCopyCount H) :
    CommonRootCopies H G (p + 1) := by
  classical
  let roots : H.Copy G → (R → V) := fun f x => f (.inr x)
  have hc : Fintype.card (R → V) * p < Fintype.card (H.Copy G) := by
    rw [Fintype.card_fun]
    simpa only [mul_comm, labelledCopyCount, ← Nat.card_eq_fintype_card] using hcount
  obtain ⟨r, hr⟩ := Fintype.exists_lt_card_fiber_of_mul_lt_card roots hc
  let F := univ.filter (fun f => roots f = r)
  have hFc : p + 1 ≤ F.card := by exact hr
  obtain ⟨S, hSF, hSc⟩ := exists_subset_card_eq hFc
  have hFne : F.Nonempty := card_pos.mp (by omega)
  obtain ⟨f₀, hf₀⟩ := hFne
  have hr₀ : roots f₀ = r := (mem_filter.mp hf₀).2
  have hrinj : Function.Injective r := by
    intro x y he
    apply Sum.inr_injective
    apply f₀.injective
    change roots f₀ x = roots f₀ y
    rw [hr₀, he]
  let e : Fin (p + 1) ≃ S := Fintype.equivOfCardEq (by
    simpa only [Fintype.card_fin, Fintype.card_coe] using hSc.symm)
  refine ⟨⟨r, hrinj⟩, fun i => (e i).val, ?_, ?_⟩
  · intro i j he
    exact e.injective (Subtype.ext he)
  · intro i x
    have hi : roots (e i).val = r := (mem_filter.mp (hSF (e i).prop)).2
    exact congrFun hi x

/-- A minimum-degree criterion forcing many copies of a tree with common roots. -/
theorem commonRootCopies_of_degree {A R V : Type*}
    [Fintype A] [Fintype R] [Nonempty R] [Fintype V] [Nonempty V]
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree)
    (G : SimpleGraph V) [DecidableRel G.Adj] (D p N : ℕ)
    (hsize : Fintype.card V ≤ N)
    (hdeg : ∀ x, D + Fintype.card (A ⊕ R) ≤ G.degree x)
    (hpow : p * N ^ (Fintype.card R - 1) < D ^ (Fintype.card (A ⊕ R) - 1)) :
    CommonRootCopies H G (p + 1) := by
  apply commonRootCopies_of_count H G p
  have hlo := tree_count_of_degree G H hH D hdeg
  have hpow' : p * Fintype.card V ^ (Fintype.card R - 1) <
      D ^ (Fintype.card (A ⊕ R) - 1) :=
    lt_of_le_of_lt (Nat.mul_le_mul_left p (Nat.pow_le_pow_left hsize _)) hpow
  have hn : 0 < Fintype.card V := Fintype.card_pos
  have hr : 0 < Fintype.card R := Fintype.card_pos
  have hr' : Fintype.card R = (Fintype.card R - 1) + 1 := by omega
  have hh := Nat.mul_lt_mul_of_pos_left hpow' hn
  apply lt_of_lt_of_le _ hlo
  convert hh using 1
  conv_lhs => rw [hr', pow_succ]
  ring


/-- Global edge bound when sufficiently many distinct common-root copies are forbidden.
This concerns a finite family of possible overlap patterns, not one tree power. -/
theorem edge_bound_of_no_commonRootCopies {A R : Type u}
    [Fintype A] [Fintype R] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree) (D p N : ℕ)
    (hpow : p * N ^ (Fintype.card R - 1) < D ^ (Fintype.card (A ⊕ R) - 1))
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hsize : Fintype.card V ≤ N) (hfree : ¬ CommonRootCopies H G (p + 1)) :
    G.edgeFinset.card ≤ (D + Fintype.card (A ⊕ R)) * Fintype.card V := by
  classical
  generalize hn : Fintype.card V = n at *
  induction n using Nat.strong_induction_on generalizing V with
  | h n ih =>
    rcases isEmpty_or_nonempty V with hV | hV
    · letI := hV
      rw [← card_edgeSet]
      simp only [Fintype.card_of_isEmpty, Nat.zero_le]
    · letI := hV
      have hnpos : 0 < n := by rw [← hn]; exact Fintype.card_pos
      have hlow : ∃ z, G.degree z < D + Fintype.card (A ⊕ R) := by
        by_contra! h
        exact hfree (commonRootCopies_of_degree H hH G D p N (by omega) h hpow)
      obtain ⟨z, hz⟩ := hlow
      let S : Set V := {z}ᶜ
      have hSfree : ¬ CommonRootCopies H (G.induce S) (p + 1) := by
        intro hc
        exact hfree (hc.mono (Copy.induce G S))
      have hcS : Fintype.card S = n - 1 := by
        simp only [S, Fintype.card_compl_set, Fintype.card_unique, hn]
      have hSm : Fintype.card S < n := by omega
      have hI := ih (Fintype.card S) hSm (G.induce S) hSfree rfl (by omega)
      rw [hcS] at hI
      have he : (G.induce S).edgeFinset.card + G.degree z = G.edgeFinset.card := by
        rw [card_edgeFinset_induce_compl_singleton, card_edgeFinset_deleteIncidenceSet,
          Nat.sub_add_cancel (G.degree_le_card_edgeFinset z)]
      have hsub : n - 1 + 1 = n := by omega
      nlinarith


/-- Choose an integer degree scale with a strict power inequality and a uniform real bound. -/
lemma scaled_power_threshold (N b r p : ℕ) (hN : 1 ≤ N) (hb : 1 ≤ b) :
    ∃ D : ℕ, p * N ^ r < D ^ b ∧
      (D : ℝ) ≤ 2 * (p + 1) * (N : ℝ) ^ ((r : ℝ) / b) := by
  let x : ℝ := (N : ℝ) ^ ((r : ℝ) / b)
  let c := ⌈x⌉₊
  let D := (p + 1) * c
  have hx : 1 ≤ x := Real.one_le_rpow (by exact_mod_cast hN) (by positivity)
  have hb0 : (b : ℝ) ≠ 0 := by exact_mod_cast (by omega : b ≠ 0)
  have hxb : x ^ b = (N : ℝ) ^ r := by
    rw [← Real.rpow_mul_natCast (by positivity)]
    simp only [div_mul_cancel₀ _ hb0, Real.rpow_natCast]
  have hc : N ^ r ≤ c ^ b := by
    have hh : (N : ℝ) ^ r ≤ (c : ℝ) ^ b := by
      rw [← hxb]
      gcongr
      exact Nat.le_ceil x
    exact_mod_cast hh
  have hp : p < (p + 1) ^ b :=
    (Nat.lt_succ_self p).trans_le (Nat.le_self_pow (by omega) _)
  refine ⟨D, ?_, ?_⟩
  · calc
      p * N ^ r < (p + 1) ^ b * N ^ r :=
        Nat.mul_lt_mul_of_pos_right hp (Nat.pow_pos (by omega))
      _ ≤ (p + 1) ^ b * c ^ b := Nat.mul_le_mul_left _ hc
      _ = D ^ b := by simp only [D, mul_pow]
  · have hceil : (c : ℝ) < x + 1 := Nat.ceil_lt_add_one (by positivity)
    have hc2 : (c : ℝ) ≤ 2 * x := by linarith
    calc
      (D : ℝ) = ((p : ℝ) + 1) * c := by simp [D]
      _ ≤ ((p : ℝ) + 1) * (2 * x) := by gcongr
      _ = 2 * (p + 1) * (N : ℝ) ^ ((r : ℝ) / b) := by dsimp [x]; ring

/-- The finite-family upper bound at the exponent given by the rooted-tree density. -/
theorem edge_bound_real {A R : Type u}
    [Fintype A] [Nonempty A] [Fintype R] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree) (p : ℕ)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V) (hfree : ¬ CommonRootCopies H G (p + 1)) :
    (G.edgeFinset.card : ℝ) ≤ (2 * (p + 1) + Fintype.card (A ⊕ R)) *
      (Fintype.card V : ℝ) ^
        (1 + ((Fintype.card R - 1 : ℕ) : ℝ) / (Fintype.card (A ⊕ R) - 1 : ℕ)) := by
  have ha : 0 < Fintype.card A := Fintype.card_pos
  have hr : 0 < Fintype.card R := Fintype.card_pos
  have hb : 1 ≤ Fintype.card (A ⊕ R) - 1 := by rw [Fintype.card_sum]; omega
  obtain ⟨D, hD, hDreal⟩ := scaled_power_threshold (Fintype.card V)
    (Fintype.card (A ⊕ R) - 1) (Fintype.card R - 1) p hn hb
  have he := edge_bound_of_no_commonRootCopies H hH D p (Fintype.card V) hD G le_rfl hfree
  have her : (G.edgeFinset.card : ℝ) ≤ (D + Fintype.card (A ⊕ R)) * (Fintype.card V : ℝ) := by
    exact_mod_cast he
  let β : ℝ := ((Fintype.card R - 1 : ℕ) : ℝ) / (Fintype.card (A ⊕ R) - 1 : ℕ)
  have hx : 1 ≤ (Fintype.card V : ℝ) ^ β :=
    Real.one_le_rpow (by exact_mod_cast hn) (by dsimp [β]; positivity)
  have hv : (Fintype.card (A ⊕ R) : ℝ) ≤ Fintype.card (A ⊕ R) *
      (Fintype.card V : ℝ) ^ β := by
    calc
      (Fintype.card (A ⊕ R) : ℝ) = Fintype.card (A ⊕ R) * 1 := by ring
      _ ≤ Fintype.card (A ⊕ R) * (Fintype.card V : ℝ) ^ β := by gcongr
  have hnp : (0 : ℝ) < Fintype.card V := by exact_mod_cast (by omega : 0 < Fintype.card V)
  calc
    (G.edgeFinset.card : ℝ) ≤ (D + Fintype.card (A ⊕ R)) * (Fintype.card V : ℝ) := her
    _ ≤ ((2 * (p + 1) + Fintype.card (A ⊕ R)) * (Fintype.card V : ℝ) ^ β) *
        (Fintype.card V : ℝ) := by
      apply mul_le_mul_of_nonneg_right _ (Nat.cast_nonneg _)
      dsimp [β] at hv ⊢
      nlinarith
    _ = (2 * (p + 1) + Fintype.card (A ⊕ R)) * (Fintype.card V : ℝ) ^ (1 + β) := by
      rw [Real.rpow_add hnp, Real.rpow_one]
      ring

end TreeCount


namespace LeafPeeling

open SimpleGraph Finset Filter

/-- Extend a partial injection between finite sets when the target is large enough. -/
lemma extend_embedding {A B : Type*} [Fintype A] [Fintype B]
    (S : Set A) (f : S ↪ B) (hcard : Fintype.card A ≤ Fintype.card B) :
    ∃ g : A ↪ B, ∀ x : S, g x = f x := by
  classical
  let T : Set B := Set.range f
  let e : S ≃ T := Equiv.ofInjective f f.injective
  have hc : Fintype.card ↥(Sᶜ) ≤ Fintype.card ↥(Tᶜ) := by
    rw [Fintype.card_compl_set, Fintype.card_compl_set, ← Fintype.card_congr e]
    exact Nat.sub_le_sub_right hcard _
  let j : ↥(Sᶜ) ↪ ↥(Tᶜ) := (Function.Embedding.nonempty_of_card_le hc).some
  let g : A ↪ B := (Equiv.sumCompl S).symm.toEmbedding.trans
    ((e.toEmbedding.sumMap j).trans (Equiv.sumCompl T).toEmbedding)
  refine ⟨g, ?_⟩
  intro x
  simp [g, e, Function.Embedding.sumMap]
  rfl

/-- Padding by isolated vertices preserves freeness once the original host has
at least as many vertices as the forbidden graph. This size condition matters. -/
lemma free_map_of_card_le {U V W : Type*} [Fintype U] [Fintype V]
    {H : SimpleGraph U} {G : SimpleGraph V}
    (hcard : Fintype.card U ≤ Fintype.card V) (hfree : H.Free G) (f : V ↪ W) :
    H.Free (G.map f) := by
  classical
  rintro ⟨c⟩
  let S : Set U := {u | ∃ v, f v = c u}
  have hs (u v : U) (h : H.Adj u v) : u ∈ S := by
    obtain ⟨x, y, hxy, hx, hy⟩ := c.toHom.map_adj h
    exact ⟨x, hx⟩
  let g : S ↪ V :=
    { toFun := fun u => Classical.choose u.prop
      inj' := by
        intro u v he
        apply Subtype.ext
        apply c.injective
        change c u = c v
        have hu := Classical.choose_spec u.prop
        have hv := Classical.choose_spec v.prop
        exact hu.symm.trans ((congrArg f he).trans hv) }
  have hg (u : S) : f (g u) = c u := Classical.choose_spec u.prop
  obtain ⟨e, he⟩ := extend_embedding S g hcard
  apply hfree
  refine ⟨{ toHom := { toFun := e, map_rel' := ?_ }, injective' := e.injective }⟩
  intro u v huv
  have heu : f (e u) = c u := by rw [he ⟨u, hs u v huv⟩]; exact hg _
  have hev : f (e v) = c v := by rw [he ⟨v, hs v u huv.symm⟩]; exact hg _
  apply (map_adj_apply (G := G) (f := f)).mp
  rw [heu, hev]
  exact c.toHom.map_adj huv

/-- Extremal numbers are monotone above the order of the forbidden graph. -/
lemma extremalNumber_mono_above_order {W : Type*} [Fintype W]
    (H : SimpleGraph W) {m n : ℕ} (hm : Fintype.card W ≤ m) (hmn : m ≤ n) :
    extremalNumber m H ≤ extremalNumber n H := by
  classical
  rw [← Fintype.card_fin m, extremalNumber_le_iff]
  intro G _ hfree
  let f : Fin m ↪ Fin n := Fin.castLEEmb hmn
  have hf := free_map_of_card_le (by simpa only [Fintype.card_fin] using hm) hfree f
  have he := card_edgeFinset_le_extremalNumber hf
  have hmap := card_edgeFinset_map f G
  simp only [← card_edgeSet, ← Nat.card_eq_fintype_card] at he hmap ⊢
  rw [hmap] at he
  simpa only [Nat.card_fin] using he

/-- A copy extends across a vertex of degree at most one inside a host of
sufficiently high minimum degree. -/
lemma extend_low_degree {W : Type u} [Fintype W] (H : SimpleGraph W) [DecidableRel H.Adj]
    (z : W) (hz : H.degree z ≤ 1)
    {V : Type v} [Fintype V] [Nonempty V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hdeg : ∀ x, Fintype.card W ≤ G.degree x)
    (f : (H.induce ({z}ᶜ : Set W)).Copy G) : H.IsContained G := by
  classical
  by_cases hz0 : H.degree z = 0
  · have hno (u : W) : ¬H.Adj z u := by
      intro h
      have hd := (H.degree_pos_iff_exists_adj z).mpr ⟨u, h⟩
      omega
    have hcard : Fintype.card W ≤ Fintype.card V :=
      (hdeg (Classical.choice (inferInstance : Nonempty V))).trans
        (G.degree_lt_card_verts _).le
    obtain ⟨e, he⟩ := extend_embedding ({z}ᶜ : Set W) f.toEmbedding hcard
    refine ⟨{ toHom := { toFun := e, map_rel' := ?_ }, injective' := e.injective }⟩
    intro u v huv
    have hu : u ≠ z := by intro h; subst u; exact hno v huv
    have hv : v ≠ z := by intro h; subst v; exact hno u huv.symm
    have heu : e u = f ⟨u, hu⟩ := he ⟨u, hu⟩
    have hev : e v = f ⟨v, hv⟩ := he ⟨v, hv⟩
    rw [heu, hev]
    exact f.toHom.map_adj huv
  · have hz1 : H.degree z = 1 := by omega
    obtain ⟨w, hzw, hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz1
    let wS : ({z}ᶜ : Set W) := ⟨w, hzw.ne'⟩
    let used : Finset V := univ.image f
    have hused : used.card < (G.neighborFinset (f wS)).card := by
      have hu : used.card ≤ Fintype.card ({z}ᶜ : Set W) := by
        simpa only [used, card_univ] using card_image_le (f := f) (s := univ)
      have hd := hdeg (f wS)
      have hpos : 0 < Fintype.card W := Fintype.card_pos_iff.mpr ⟨z⟩
      rw [Fintype.card_compl_set, Fintype.card_unique (α := ({z} : Set W))] at hu
      rw [card_neighborFinset_eq_degree]
      omega
    obtain ⟨y, hy, hyused⟩ := exists_mem_notMem_of_card_lt_card hused
    have hyadj : G.Adj (f wS) y := (G.mem_neighborFinset _ _).mp hy
    have hyne : ∀ x : ({z}ᶜ : Set W), y ≠ f x := by
      intro x hx
      apply hyused
      exact mem_image.mpr ⟨x, mem_univ _, hx.symm⟩
    exact ⟨TreeCount.extendLeaf H G z w hzw hw f y hyadj hyne⟩


/-- Deleting a low-degree vertex from the forbidden graph changes the edge
bound by at most a linear term. The ambient order `N` stays fixed during peeling. -/
lemma edge_bound_delete_low_degree {W : Type u} [Fintype W]
    (H : SimpleGraph W) [DecidableRel H.Adj] (z : W) (hz : H.degree z ≤ 1) (N : ℕ)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hsize : Fintype.card V ≤ N) (hfree : H.Free G) :
    G.edgeFinset.card ≤ extremalNumber N (H.induce ({z}ᶜ : Set W)) +
      Fintype.card W * Fintype.card V := by
  classical
  generalize hn : Fintype.card V = n at *
  induction n using Nat.strong_induction_on generalizing V with
  | h n ih =>
    by_cases hsmall : n ≤ Fintype.card W
    · have hsum : ∑ x : V, G.degree x ≤ ∑ _x : V, Fintype.card W := by
        apply sum_le_sum
        intro x _
        exact (G.degree_lt_card_verts x).le.trans (by omega)
      rw [G.sum_degrees_eq_twice_card_edges] at hsum
      simp only [sum_const, card_univ, smul_eq_mul, hn] at hsum
      nlinarith
    · have hnpos : 0 < Fintype.card V := by omega
      letI : Nonempty V := Fintype.card_pos_iff.mp hnpos
      by_cases hdeg : ∀ x, Fintype.card W ≤ G.degree x
      · have hpred : (H.induce ({z}ᶜ : Set W)).Free G := by
          rintro ⟨f⟩
          exact hfree (extend_low_degree H z hz G hdeg f)
        have hm : Fintype.card ({z}ᶜ : Set W) ≤ Fintype.card V := by
          rw [Fintype.card_compl_set, Fintype.card_unique (α := ({z} : Set W))]
          omega
        have hmono := extremalNumber_mono_above_order (H.induce ({z}ᶜ : Set W)) hm (by omega : Fintype.card V ≤ N)
        have he := (card_edgeFinset_le_extremalNumber hpred).trans hmono
        omega
      · push_neg at hdeg
        obtain ⟨x, hx⟩ := hdeg
        let S : Set V := {x}ᶜ
        have hSfree : H.Free (G.induce S) := fun hc => hfree (hc.trans ⟨Copy.induce G S⟩)
        have hSc : Fintype.card S = n - 1 := by
          simp only [S, Fintype.card_compl_set, Fintype.card_unique, hn]
        have hSn : Fintype.card S < n := by omega
        have hI := ih (Fintype.card S) hSn (G.induce S) hSfree rfl (by omega)
        rw [hSc] at hI
        have he : (G.induce S).edgeFinset.card + G.degree x = G.edgeFinset.card := by
          rw [card_edgeFinset_induce_compl_singleton, card_edgeFinset_deleteIncidenceSet,
            Nat.sub_add_cancel (G.degree_le_card_edgeFinset x)]
        have hnp : n - 1 + 1 = n := by omega
        nlinarith

theorem extremalNumber_delete_low_degree {W : Type*} [Fintype W]
    (H : SimpleGraph W) [DecidableRel H.Adj] (z : W) (hz : H.degree z ≤ 1) (n : ℕ) :
    extremalNumber n (H.induce ({z}ᶜ : Set W)) ≤ extremalNumber n H ∧
      extremalNumber n H ≤ extremalNumber n (H.induce ({z}ᶜ : Set W)) + Fintype.card W * n := by
  constructor
  · exact (show (H.induce ({z}ᶜ : Set W)).IsContained H from ⟨Copy.induce H _⟩).extremalNumber_le
  · rw [← Fintype.card_fin n, extremalNumber_le_iff]
    intro G _ hfree
    exact edge_bound_delete_low_degree H z hz _ G le_rfl hfree

/-- An additive linear error does not affect an exponent strictly greater than one. -/
lemma isTheta_of_linear_error {f g : ℕ → ℝ} (a C : ℝ) (ha : 1 < a)
    (hf : ∀ n, 0 ≤ f n) (hg : ∀ n, 0 ≤ g n)
    (hle : ∀ n, g n ≤ f n) (herror : ∀ n, f n ≤ g n + C * n)
    (hΘ : Asymptotics.IsTheta atTop f (fun n : ℕ => (n : ℝ) ^ a)) :
    Asymptotics.IsTheta atTop g (fun n : ℕ => (n : ℝ) ^ a) := by
  constructor
  · have hgf : Asymptotics.IsBigO atTop g f := by
      apply Asymptotics.IsBigO.of_bound 1
      apply Filter.Eventually.of_forall
      intro n
      simpa only [Real.norm_eq_abs, abs_of_nonneg (hf n), abs_of_nonneg (hg n), one_mul] using hle n
    exact hgf.trans hΘ.1
  · obtain ⟨c, hc, hcb⟩ := hΘ.2.exists_pos
    have hgrow : Tendsto (fun n : ℕ => (n : ℝ) ^ (a - 1)) atTop atTop :=
      (tendsto_rpow_atTop (sub_pos.mpr ha)).comp tendsto_natCast_atTop_atTop
    have hbig : ∀ᶠ n : ℕ in atTop, 2 * c * C ≤ (n : ℝ) ^ (a - 1) :=
      hgrow.eventually (eventually_ge_atTop _)
    apply Asymptotics.IsBigO.of_bound (2 * c)
    filter_upwards [eventually_ge_atTop 1, hcb.bound, hbig] with n hn hbound hbig
    have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _),
      abs_of_nonneg (hg n)]
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _),
      abs_of_nonneg (hf n)] at hbound
    have hp : (n : ℝ) ^ a = (n : ℝ) ^ (a - 1) * n := by
      calc
        (n : ℝ) ^ a = (n : ℝ) ^ ((a - 1) + 1) := by congr 1; ring
        _ = (n : ℝ) ^ (a - 1) * n := by rw [Real.rpow_add hn0, Real.rpow_one]
    have hsmall := mul_le_mul_of_nonneg_right hbig (Nat.cast_nonneg n)
    have he := mul_le_mul_of_nonneg_left (herror n) hc.le
    rw [hp] at hbound ⊢
    nlinarith

/-- Removing a leaf or an isolated vertex preserves any superlinear exponent. -/
theorem isTheta_delete_low_degree {W : Type*} [Fintype W]
    (H : SimpleGraph W) [DecidableRel H.Adj] (z : W) (hz : H.degree z ≤ 1)
    (a : ℝ) (ha : 1 < a)
    (hΘ : Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n H : ℝ)) (fun n : ℕ => (n : ℝ) ^ a)) :
    Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n (H.induce ({z}ᶜ : Set W)) : ℝ))
      (fun n : ℕ => (n : ℝ) ^ a) := by
  apply isTheta_of_linear_error a (Fintype.card W) ha
    (fun _ => Nat.cast_nonneg _) (fun _ => Nat.cast_nonneg _) _ _ hΘ
  · intro n
    exact_mod_cast (extremalNumber_delete_low_degree H z hz n).1
  · intro n
    exact_mod_cast (extremalNumber_delete_low_degree H z hz n).2


lemma isTheta_map {W V : Type*} (H : SimpleGraph W) (e : W ≃ V) (a : ℝ)
    (hΘ : Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n H : ℝ)) (fun n : ℕ => (n : ℝ) ^ a)) :
    Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n (H.map e.toEmbedding) : ℝ))
      (fun n : ℕ => (n : ℝ) ^ a) := by
  have heq : ∀ n, extremalNumber n (H.map e.toEmbedding) = extremalNumber n H := fun _ =>
    (extremalNumber_congr_right (SimpleGraph.Iso.map e H)).symm
  simpa only [heq] using hΘ

/-- Every superlinear bipartite witness contains a witness with minimum degree
at least two. Minimality avoids committing to a particular order of leaf peeling. -/
theorem exists_min_degree_two_witness {W : Type*} [Fintype W]
    (H : SimpleGraph W) (hH : H.IsBipartite) (a : ℝ) (ha : 1 < a)
    (hΘ : Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n H : ℝ)) (fun n : ℕ => (n : ℝ) ^ a)) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsContained H ∧ G.IsBipartite ∧
      (∀ z, 2 ≤ Nat.card (G.neighborSet z)) ∧
      Asymptotics.IsTheta atTop
        (fun n : ℕ => (extremalNumber n G : ℝ)) (fun n : ℕ => (n : ℝ) ^ a) := by
  classical
  let P : ℕ → Prop := fun q => ∃ G : SimpleGraph (Fin q), G.IsContained H ∧ G.IsBipartite ∧
    Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n G : ℝ)) (fun n : ℕ => (n : ℝ) ^ a)
  have hex : ∃ q, P q := by
    let e := Fintype.equivFin W
    refine ⟨Fintype.card W, H.map e.toEmbedding, ?_, hH.map e.toEmbedding, isTheta_map H e a hΘ⟩
    exact ⟨(SimpleGraph.Iso.map e H).symm.toCopy⟩
  let q := Nat.find hex
  obtain ⟨G, hGH, hbip, hGΘ⟩ := Nat.find_spec hex
  refine ⟨q, G, hGH, hbip, ?_, hGΘ⟩
  intro z
  by_contra hlow
  have hz : G.degree z ≤ 1 := by
    rw [← card_neighborSet_eq_degree, ← Nat.card_eq_fintype_card]
    omega
  let S : Set (Fin q) := {z}ᶜ
  let e := Fintype.equivFin S
  let J := (G.induce S).map e.toEmbedding
  have hJG : J.IsContained G :=
    (show J.IsContained (G.induce S) from ⟨(SimpleGraph.Iso.map e (G.induce S)).symm.toCopy⟩).trans
      ⟨Copy.induce G S⟩
  have hJbip : J.IsBipartite :=
    (hbip.of_hom (Copy.induce G S).toHom).map e.toEmbedding
  have hJΘ : Asymptotics.IsTheta atTop
      (fun n : ℕ => (extremalNumber n J : ℝ)) (fun n : ℕ => (n : ℝ) ^ a) :=
    isTheta_map (G.induce S) e a (isTheta_delete_low_degree G z hz a ha hGΘ)
  have hP : P (Fintype.card S) := ⟨J, hJG.trans hGH, hJbip, hJΘ⟩
  have hmin : q ≤ Fintype.card S := Nat.find_min' hex hP
  have hcard : Fintype.card S = q - 1 := by
    simp only [S, Fintype.card_compl_set, Fintype.card_unique, Fintype.card_fin]
  have hq : 0 < q := lt_of_le_of_lt (Nat.zero_le z.val) z.isLt
  omega

end LeafPeeling



/-- For superlinear exponents, requiring minimum degree two does not change
which exponents are realizable by a single bipartite forbidden graph. -/
theorem realizable_iff_min_degree_two (a : ℚ) (ha : 1 < a) :
    RealizableExponent a ↔
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        (∀ z, 2 ≤ Nat.card (G.neighborSet z)) ∧
        Asymptotics.IsTheta atTop
          (fun n : ℕ => (extremalNumber n G : ℝ))
          (fun n : ℕ => (n : ℝ) ^ (a : ℝ)) := by
  constructor
  · rintro ⟨q, G, hbip, hΘ⟩
    obtain ⟨q', G', _, hbip', hdegree, hΘ'⟩ :=
      LeafPeeling.exists_min_degree_two_witness G hbip (a : ℝ) (by exact_mod_cast ha) hΘ
    exact ⟨q', G', hbip', hdegree, hΘ'⟩
  · rintro ⟨q, G, hbip, _, hΘ⟩
    exact ⟨q, G, hbip, hΘ⟩

namespace RootedPacking

/-- A bounded collision relation permits greedy packing. -/
lemma greedy_packing {I : Type*} [DecidableEq I] (R : I → I → Prop) [DecidableRel R]
    (hrefl : Reflexive R) (hsymm : Symmetric R)
    (M : ℕ) (hM : 0 < M) (p : ℕ) (F : Finset I)
    (hload : ∀ i ∈ F, (F.filter (R i)).card ≤ M)
    (hcard : p * M ≤ F.card) :
    ∃ S ⊆ F, S.card = p ∧ ∀ i ∈ S, ∀ j ∈ S, i ≠ j → ¬R i j := by
  classical
  induction p generalizing F with
  | zero => exact ⟨∅, empty_subset F, rfl, by simp⟩
  | succ p ih =>
    have hFpos : 0 < F.card := by nlinarith
    obtain ⟨i, hi⟩ := card_pos.mp hFpos
    let E := F.filter (fun j => ¬R i j)
    have hEF : E ⊆ F := filter_subset _ _
    have hsplit : (F.filter (R i)).card + E.card = F.card := by
      exact card_filter_add_card_filter_not (R i)
    have hEcard : p * M ≤ E.card := by have := hload i hi; nlinarith
    obtain ⟨S, hSE, hSc, hS⟩ := ih E (by
      intro j hj
      exact (card_le_card (filter_subset_filter (R j) hEF)).trans (hload j (hEF hj))) hEcard
    have hni : i ∉ S := by
      intro hiS
      exact (mem_filter.mp (hSE hiS)).2 (hrefl i)
    refine ⟨insert i S, insert_subset hi (hSE.trans hEF), ?_, ?_⟩
    · rw [card_insert_of_notMem hni, hSc]
    · intro a ha b hb hab
      rcases mem_insert.mp ha with hai | haS
      · subst a
        rcases mem_insert.mp hb with hbi | hbS
        · exact (hab hbi.symm).elim
        · exact (mem_filter.mp (hSE hbS)).2
      · rcases mem_insert.mp hb with hbi | hbS
        · subst b
          exact fun h => (mem_filter.mp (hSE haS)).2 (hsymm h)
        · exact hS a haS b hbS hab

/-- If each vertex lies in at most `B` footprints of size at most `a`,
then `p*a*B` footprints suffice to pack `p` disjoint ones. -/
lemma disjoint_footprints {I W : Type*} [DecidableEq I] [DecidableEq W]
    (F : Finset I) (foot : I → Finset W) (a B p : ℕ)
    (ha : 0 < a) (hB : 0 < B)
    (hne : ∀ i ∈ F, (foot i).Nonempty)
    (hsize : ∀ i ∈ F, (foot i).card ≤ a)
    (hload : ∀ w, (F.filter (fun i => w ∈ foot i)).card ≤ B)
    (hcard : p * a * B ≤ F.card) :
    ∃ S ⊆ F, S.card = p ∧ ∀ i ∈ S, ∀ j ∈ S, i ≠ j → Disjoint (foot i) (foot j) := by
  classical
  let R : I → I → Prop := fun i j => i = j ∨ ¬Disjoint (foot i) (foot j)
  have hR : Reflexive R := fun i => Or.inl rfl
  have hRs : Symmetric R := by
    intro i j h
    rcases h with h | h
    · exact Or.inl h.symm
    · exact Or.inr (fun hd => h hd.symm)
  have hbound : ∀ i ∈ F, (F.filter (R i)).card ≤ a * B := by
    intro i hi
    have hsub : F.filter (R i) ⊆ (foot i).biUnion
        (fun w => F.filter (fun j => w ∈ foot j)) := by
      intro j hj
      obtain ⟨hjF, hjR⟩ := mem_filter.mp hj
      obtain ⟨w, hwi, hwj⟩ : ∃ w ∈ foot i, w ∈ foot j := by
        rcases hjR with rfl | hjR
        · obtain ⟨w, hw⟩ := hne i hi
          exact ⟨w, hw, hw⟩
        · simpa only [Finset.disjoint_left, not_forall, not_not, exists_prop] using hjR
      exact mem_biUnion.mpr ⟨w, hwi, mem_filter.mpr ⟨hjF, hwj⟩⟩
    calc
      (F.filter (R i)).card ≤ ((foot i).biUnion
          (fun w => F.filter (fun j => w ∈ foot j))).card := card_le_card hsub
      _ ≤ ∑ w ∈ foot i, (F.filter (fun j => w ∈ foot j)).card := card_biUnion_le
      _ ≤ ∑ _w ∈ foot i, B := sum_le_sum (fun w _ => hload w)
      _ = (foot i).card * B := by simp
      _ ≤ a * B := Nat.mul_le_mul_right B (hsize i hi)
  obtain ⟨S, hSF, hSc, hS⟩ := greedy_packing R hR hRs (a * B) (Nat.mul_pos ha hB)
    p F hbound (by simpa only [mul_assoc] using hcard)
  refine ⟨S, hSF, hSc, ?_⟩
  intro i hi j hj hij
  by_contra hd
  exact hS i hi j hj hij (Or.inr hd)


open SimpleGraph

/-- Copies of the nonroots are disjoint; only the roots are identified. -/
def power {A R : Type*} (H : SimpleGraph (A ⊕ R)) (p : ℕ) :
    SimpleGraph ((Fin p × A) ⊕ R) where
  Adj u v := match u, v with
    | .inl x, .inl y => x.1 = y.1 ∧ H.Adj (.inl x.2) (.inl y.2)
    | .inl x, .inr r => H.Adj (.inl x.2) (.inr r)
    | .inr r, .inl x => H.Adj (.inr r) (.inl x.2)
    | .inr _, .inr _ => False
  symm := by
    intro u v h
    cases u <;> cases v
    · exact ⟨h.1.symm, h.2.symm⟩
    · exact h.symm
    · exact h.symm
    · exact h
  loopless := by
    intro u
    cases u
    · exact fun h => H.loopless _ h.2
    · exact not_false

noncomputable def interior {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} (f : H.Copy G) : Finset W := by
  classical
  exact univ.image (fun a => f (.inl a))

lemma mem_interior {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} (f : H.Copy G) (a : A) :
    f (.inl a) ∈ interior f := by
  classical
  exact mem_image.mpr ⟨a, mem_univ _, rfl⟩

lemma interior_card {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} (f : H.Copy G) :
    (interior f).card = Fintype.card A := by
  classical
  rw [interior, card_image_of_injective]
  · exact card_univ
  · exact f.injective.comp Sum.inl_injective

/-- The disjointness condition is exactly what turns rooted copies into a power. -/
def powerCopy {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}
    (p : ℕ) (r : R ↪ W) (f : Fin p → H.Copy G)
    (hroot : ∀ i x, f i (.inr x) = r x)
    (hdis : ∀ i j, i ≠ j → Disjoint (interior (f i)) (interior (f j))) :
    (power H p).Copy G where
  toHom :=
    { toFun := Sum.elim (fun x => f x.1 (.inl x.2)) r
      map_rel' := by
        intro u v h
        cases u with
        | inl x =>
          cases v with
          | inl y =>
            obtain ⟨hxy, hadj⟩ := h
            dsimp
            rw [hxy]
            exact (f y.1).toHom.map_adj hadj
          | inr y =>
            dsimp
            rw [← hroot x.1 y]
            exact (f x.1).toHom.map_adj h
        | inr x =>
          cases v with
          | inl y =>
            dsimp
            rw [← hroot y.1 x]
            exact (f y.1).toHom.map_adj h
          | inr y => exact h.elim }
  injective' := by
    intro u v h
    cases u with
    | inl x =>
      cases v with
      | inl y =>
        change f x.1 (.inl x.2) = f y.1 (.inl y.2) at h
        by_cases hxy : x.1 = y.1
        · have he : x.2 = y.2 := by
            rw [hxy] at h
            exact Sum.inl.inj ((f y.1).injective h)
          exact congrArg Sum.inl (Prod.ext hxy he)
        · exact False.elim ((Finset.disjoint_left.mp (hdis x.1 y.1 hxy))
            (mem_interior (f x.1) x.2) (h ▸ mem_interior (f y.1) y.2))
      | inr y =>
        change f x.1 (.inl x.2) = r y at h
        rw [← hroot x.1 y] at h
        exact False.elim (Sum.inl_ne_inr ((f x.1).injective h))
    | inr x =>
      cases v with
      | inl y =>
        change r x = f y.1 (.inl y.2) at h
        rw [← hroot y.1 x] at h
        exact False.elim (Sum.inr_ne_inl ((f y.1).injective h))
      | inr y =>
        change r x = r y at h
        exact congrArg Sum.inr (r.injective h)

/-- Transfer a packing indexed by a finite set to an injective graph copy. -/
theorem power_contained_of_packing
    {I A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}
    (S : Finset I) (f : I → H.Copy G) (r : R ↪ W) (p : ℕ)
    (hroot : ∀ i ∈ S, ∀ x, f i (.inr x) = r x)
    (hSc : S.card = p)
    (hS : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → Disjoint (interior (f i)) (interior (f j))) :
    (power H p).IsContained G := by
  classical
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by simpa only [Fintype.card_fin,
    Fintype.card_coe] using hSc.symm)
  refine ⟨powerCopy p r (fun i => f (e i)) ?_ ?_⟩
  · intro i x
    exact hroot (e i) (e i).prop x
  · intro i j hij
    apply hS (e i) (e i).prop (e j) (e j).prop
    intro he
    apply hij
    exact e.injective (Subtype.ext he)

/-- A finite family of rooted copies with bounded vertex loads contains a power.
The load hypothesis is an additional assumption, not a consequence of balancedness. -/
theorem power_contained_of_bounded_load
    {I A R W : Type*} [DecidableEq I] [DecidableEq W] [Fintype A] [Nonempty A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}
    (F : Finset I) (f : I → H.Copy G) (r : R ↪ W)
    (hroot : ∀ i ∈ F, ∀ x, f i (.inr x) = r x)
    (B p : ℕ) (hB : 0 < B)
    (hload : ∀ w, (F.filter (fun i => w ∈ interior (f i))).card ≤ B)
    (hcard : p * Fintype.card A * B ≤ F.card) : (power H p).IsContained G := by
  classical
  have ha : 0 < Fintype.card A := Fintype.card_pos
  obtain ⟨S, hSF, hSc, hS⟩ := disjoint_footprints F (fun i => interior (f i))
    (Fintype.card A) B p ha hB
    (by intro i _; rw [← card_pos, interior_card]; exact ha)
    (by intro i _; exact (interior_card _).le) hload hcard
  exact power_contained_of_packing S f r p
    (fun i hi x => hroot i (hSF hi) x) hSc hS

/-- A family without a packing of size `p` has a vertex cover of size at most
`a*(p-1)`. This does not impose any bound on the number of members of the family. -/
theorem small_cover_of_no_packing {I W : Type*} [DecidableEq I] [DecidableEq W]
    (F : Finset I) (foot : I → Finset W) (a p : ℕ)
    (hne : ∀ i ∈ F, (foot i).Nonempty)
    (hsize : ∀ i ∈ F, (foot i).card ≤ a)
    (hno : ¬∃ S ⊆ F, S.card = p ∧
      ∀ i ∈ S, ∀ j ∈ S, i ≠ j → Disjoint (foot i) (foot j)) :
    ∃ U : Finset W, U.card ≤ a * (p - 1) ∧
      ∀ i ∈ F, ∃ w ∈ foot i, w ∈ U := by
  classical
  let P : Finset (Finset I) := F.powerset.filter (fun S =>
    ∀ i ∈ S, ∀ j ∈ S, i ≠ j → Disjoint (foot i) (foot j))
  have hP : P.Nonempty := ⟨∅, by simp [P]⟩
  obtain ⟨S, hSP, hmax⟩ := exists_max_image P Finset.card hP
  have hSF : S ⊆ F := mem_powerset.mp (mem_filter.mp hSP).1
  have hS := (mem_filter.mp hSP).2
  have hSc : S.card < p := by
    by_contra h
    have hpS : p ≤ S.card := by omega
    obtain ⟨T, hTS, hTc⟩ := exists_subset_card_eq hpS
    exact hno ⟨T, hTS.trans hSF, hTc, fun i hi j hj hij =>
      hS i (hTS hi) j (hTS hj) hij⟩
  refine ⟨S.biUnion foot, ?_, ?_⟩
  · calc
      (S.biUnion foot).card ≤ ∑ i ∈ S, (foot i).card := card_biUnion_le
      _ ≤ ∑ _i ∈ S, a := sum_le_sum (fun i hi => hsize i (hSF hi))
      _ = S.card * a := by simp
      _ ≤ a * (p - 1) := by
        have : S.card ≤ p - 1 := by omega
        nlinarith
  · intro i hi
    by_contra hmeet
    have hni : i ∉ S := by
      intro hiS
      obtain ⟨w, hw⟩ := hne i hi
      exact hmeet ⟨w, hw, mem_biUnion.mpr ⟨i, hiS, hw⟩⟩
    have hdis : ∀ j ∈ S, Disjoint (foot i) (foot j) := by
      intro j hj
      apply Finset.disjoint_left.mpr
      intro w hwi hwj
      exact hmeet ⟨w, hwi, mem_biUnion.mpr ⟨j, hj, hwj⟩⟩
    have hnew : insert i S ∈ P := by
      apply mem_filter.mpr
      refine ⟨mem_powerset.mpr (insert_subset hi hSF), ?_⟩
      intro j hj k hk hjk
      rcases mem_insert.mp hj with hji | hjS
      · subst j
        rcases mem_insert.mp hk with hki | hkS
        · exact (hjk hki.symm).elim
        · exact hdis k hkS
      · rcases mem_insert.mp hk with hki | hkS
        · subst k
          exact (hdis j hjS).symm
        · exact hS j hjS k hkS hjk
    have hc := hmax (insert i S) hnew
    rw [card_insert_of_notMem hni] at hc
    omega


/-- In a power-free graph, every rooted-copy family has a small interior hitting set. -/
theorem small_interior_cover_of_power_free
    {I A R W : Type*} [DecidableEq I] [DecidableEq W] [Fintype A] [Nonempty A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}
    (F : Finset I) (f : I → H.Copy G) (r : R ↪ W) (p : ℕ)
    (hroot : ∀ i ∈ F, ∀ x, f i (.inr x) = r x) (hfree : (power H p).Free G) :
    ∃ U : Finset W, U.card ≤ Fintype.card A * (p - 1) ∧
      ∀ i ∈ F, ∃ w ∈ interior (f i), w ∈ U := by
  apply small_cover_of_no_packing F (fun i => interior (f i)) (Fintype.card A) p
  · intro i _
    rw [← card_pos, interior_card]
    exact Fintype.card_pos
  · intro i _
    exact (interior_card _).le
  · rintro ⟨S, hSF, hSc, hS⟩
    exact hfree (power_contained_of_packing S f r p
      (fun i hi x => hroot i (hSF hi) x) hSc hS)

end RootedPacking


/- Labelled sunflower extraction and explicit shared-core powers. -/

namespace RootedSunflower

open Finset
universe w

/-- Every collision between different embeddings occurs at the same label,
which is then fixed throughout the selected family. -/
def Canonical {I A W : Type*} (f : I → A ↪ W) (S : Finset I) : Prop :=
  ∀ i ∈ S, ∀ j ∈ S, i ≠ j → ∀ a b, f i a = f j b →
    a = b ∧ ∀ k ∈ S, f k a = f i a

/-- A labelled version of the elementary sunflower bound. -/
def bound (a p : ℕ) : ℕ := a.factorial ^ 2 * (p - 1) ^ a

lemma bound_succ (a p : ℕ) :
    bound (a + 1) p = (a + 1) * ((a + 1) * (p - 1)) * bound a p := by
  simp only [bound, Nat.factorial_succ, pow_succ]
  ring

lemma exists_large_fiber {I A W : Type*} [DecidableEq I] [DecidableEq W] [Fintype A]
    (F : Finset I) (f : I → A ↪ W) (U : Finset W) (M : ℕ)
    (hcover : ∀ i ∈ F, ∃ a, f i a ∈ U)
    (hcard : Fintype.card A * U.card * M < F.card) :
    ∃ a, ∃ w ∈ U, M < (F.filter (fun i => f i a = w)).card := by
  classical
  by_contra! h
  have hsub : F ⊆ (univ : Finset A).biUnion
      (fun a => U.biUnion (fun w => F.filter (fun i => f i a = w))) := by
    intro i hi
    obtain ⟨a, ha⟩ := hcover i hi
    exact mem_biUnion.mpr ⟨a, mem_univ _, mem_biUnion.mpr
      ⟨f i a, ha, mem_filter.mpr ⟨hi, rfl⟩⟩⟩
  have hh : F.card ≤ Fintype.card A * U.card * M := by
    calc
      F.card ≤ ((univ : Finset A).biUnion
          (fun a => U.biUnion (fun w => F.filter (fun i => f i a = w)))).card := card_le_card hsub
      _ ≤ ∑ a : A, (U.biUnion (fun w => F.filter (fun i => f i a = w))).card := card_biUnion_le
      _ ≤ ∑ a : A, ∑ w ∈ U, (F.filter (fun i => f i a = w)).card :=
        sum_le_sum (fun _ _ => card_biUnion_le)
      _ ≤ ∑ _a : A, ∑ _w ∈ U, M := sum_le_sum (fun a _ => sum_le_sum (fun w hw => h a w hw))
      _ = Fintype.card A * U.card * M := by simp; ring
  omega

set_option maxRecDepth 2048 in
/-- Sufficiently many injectively labelled sets contain a canonical sunflower. -/
theorem labelled_sunflower (a : ℕ) :
    ∀ {A : Type u} [Fintype A] {W : Type v} {I : Type w} [DecidableEq I]
      (F : Finset I) (f : I → A ↪ W) (p : ℕ),
      Fintype.card A = a → 2 ≤ p → Set.InjOn f F → bound a p < F.card →
      ∃ S ⊆ F, S.card = p ∧ Canonical f S := by
  induction a with
  | zero =>
    intro A _ W I _ F f p hA hp hf hcard
    have hAempty : IsEmpty A := Fintype.card_eq_zero_iff.mp hA
    letI := hAempty
    have hle : F.card ≤ 1 := by
      apply card_le_one.mpr
      intro i hi j hj
      apply hf hi hj
      ext x
      exact isEmptyElim x
    simp only [bound, Nat.factorial_zero, one_pow, pow_zero, mul_one] at hcard
    omega
  | succ a ih =>
    intro A _ W I _ F f p hA hp hf hcard
    classical
    let foot : I → Finset W := fun i => univ.image (f i)
    have hfoot (i : I) : (foot i).card = a + 1 := by
      dsimp [foot]
      rw [card_image_of_injective _ (f i).injective, card_univ, hA]
    by_cases hpack : ∃ S ⊆ F, S.card = p ∧ ∀ i ∈ S, ∀ j ∈ S, i ≠ j → Disjoint (foot i) (foot j)
    · obtain ⟨S, hSF, hSc, hS⟩ := hpack
      refine ⟨S, hSF, hSc, ?_⟩
      intro i hi j hj hij x y heq
      exfalso
      apply Finset.disjoint_left.mp (hS i hi j hj hij)
      · exact mem_image.mpr ⟨x, mem_univ _, rfl⟩
      · exact mem_image.mpr ⟨y, mem_univ _, heq.symm⟩
    obtain ⟨U, hUc, hU⟩ := RootedPacking.small_cover_of_no_packing F foot (a + 1) p
      (fun i _ => card_pos.mp (by rw [hfoot]; omega))
      (fun i _ => (hfoot i).le) hpack
    have hlarge : Fintype.card A * U.card * bound a p < F.card := by
      apply lt_of_le_of_lt _ hcard
      rw [hA, bound_succ]
      exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hUc)
    obtain ⟨x, w, hwU, hw⟩ := exists_large_fiber F f U (bound a p) (by
      intro i hi
      obtain ⟨w, hwi, hwU⟩ := hU i hi
      obtain ⟨x, _, rfl⟩ := mem_image.mp hwi
      exact ⟨x, hwU⟩) hlarge
    let F' := F.filter (fun i => f i x = w)
    let A' := {y : A // y ≠ x}
    let f' : I → A' ↪ W := fun i => ⟨fun y => f i y, (f i).injective.comp Subtype.val_injective⟩
    have hA' : Fintype.card A' = a := by
      change Fintype.card {y : A // ¬ y = x} = a
      rw [Fintype.card_subtype_compl, hA, Fintype.card_unique (α := {y : A // y = x})]
      omega
    have hf' : Set.InjOn f' F' := by
      intro i hi j hj heq
      obtain ⟨hiF, hix⟩ := mem_filter.mp hi
      obtain ⟨hjF, hjx⟩ := mem_filter.mp hj
      apply hf hiF hjF
      ext y
      by_cases hy : y = x
      · subst y
        exact hix.trans hjx.symm
      · exact congrArg (fun g : A' ↪ W => g ⟨y, hy⟩) heq
    obtain ⟨S, hSF', hSc, hS⟩ := ih F' f' p hA' hp hf' hw
    have hfix : ∀ i ∈ S, f i x = w := fun i hi => (mem_filter.mp (hSF' hi)).2
    refine ⟨S, hSF'.trans (filter_subset _ _), hSc, ?_⟩
    intro i hi j hj hij y z heq
    by_cases hy : y = x
    · subst y
      have hz : z = x := (f j).injective (by rw [← heq, hfix i hi, hfix j hj])
      refine ⟨hz.symm, ?_⟩
      intro k hk
      rw [hfix k hk, hfix i hi]
    · have hz : z ≠ x := by
        intro hz
        subst z
        apply hy
        apply (f i).injective
        rw [heq, hfix j hj, hfix i hi]
      obtain ⟨hyz, hfixed⟩ := hS i hi j hj hij ⟨y, hy⟩ ⟨z, hz⟩ heq
      exact ⟨congrArg Subtype.val hyz, hfixed⟩


open SimpleGraph

/-- Vertices in `C` are shared, while all other nonroots are copied separately. -/
abbrev CoreVertex (A R : Type*) (C : Finset A) (p : ℕ) :=
  (Fin p × {a : A // a ∉ C}) ⊕ ({a : A // a ∈ C} ⊕ R)

def projection {A R : Type*} {C : Finset A} {p : ℕ} : CoreVertex A R C p → A ⊕ R
  | .inl x => .inl x.2
  | .inr (.inl x) => .inl x
  | .inr (.inr r) => .inr r

/-- The union of `p` copies with the original roots and `C` identified.
Unlike `RootedPacking.power`, edges between the enlarged roots are retained. -/
def corePower {A R : Type*} (H : SimpleGraph (A ⊕ R)) (C : Finset A) (p : ℕ) :
    SimpleGraph (CoreVertex A R C p) where
  Adj u v := H.Adj (projection u) (projection v) ∧
    match u, v with
    | .inl x, .inl y => x.1 = y.1
    | _, _ => True
  symm := by
    intro u v h
    refine ⟨h.1.symm, ?_⟩
    cases u <;> cases v <;> simp_all
  loopless u h := H.loopless _ h.1

/-- A canonical family gives a graph copy with its core pinned. -/
theorem corePower_contained {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} {p : ℕ} (hp : 2 ≤ p)
    (r : R ↪ W) (f : Fin p → H.Copy G)
    (hf : Function.Injective f) (hr : ∀ i x, f i (.inr x) = r x)
    (hcan : Canonical (fun i => (Function.Embedding.inl : A ↪ A ⊕ R).trans (f i).toEmbedding) univ) :
    ∃ C : Finset A, C ≠ univ ∧ (corePower H C p).IsContained G := by
  classical
  let i₀ : Fin p := ⟨0, by omega⟩
  let C : Finset A := univ.filter (fun a => ∀ i, f i (.inl a) = f i₀ (.inl a))
  have hC (a : A) : a ∈ C ↔ ∀ i, f i (.inl a) = f i₀ (.inl a) := by simp only [C, mem_filter, mem_univ, true_and]
  have hCne : C ≠ univ := by
    intro hfull
    have heq : f ⟨1, by omega⟩ = f i₀ := by
      apply Copy.ext
      intro v
      cases v with
      | inl a => exact (hC a).mp (by rw [hfull]; exact mem_univ _) _
      | inr x => rw [hr, hr]
    have hi := congrArg Fin.val (hf heq)
    change 1 = 0 at hi
    omega
  let g : CoreVertex A R C p → W := fun v => match v with
    | .inl x => f x.1 (.inl x.2)
    | .inr (.inl x) => f i₀ (.inl x)
    | .inr (.inr x) => r x
  have hgroot (i : Fin p) (v : {a : A // a ∈ C} ⊕ R) :
      g (.inr v) = f i (projection (p := p) (.inr v)) := by
    cases v with
    | inl a => exact ((hC a).mp a.prop i).symm
    | inr x => exact (hr i x).symm
  have hgcopy : ∀ i : Fin p, ∀ v : CoreVertex A R C p,
      (∀ x, v = .inl x → x.1 = i) → g v = f i (projection v) := by
    intro i v hv
    cases v with
    | inl x =>
      have hxi := hv x rfl
      simp only [g, projection, hxi]
    | inr v => exact hgroot i v
  refine ⟨C, hCne, ⟨{ toHom := { toFun := g, map_rel' := ?_ }, injective' := ?_ }⟩⟩
  · intro u v h
    obtain ⟨hadj, hcompat⟩ := h
    cases u with
    | inl x =>
      have huv : ∀ y, v = .inl y → y.1 = x.1 := by
        intro y hy
        subst v
        exact hcompat.symm
      rw [hgcopy x.1 (.inl x) (by intro y hy; cases hy; rfl), hgcopy x.1 v huv]
      exact (f x.1).toHom.map_adj hadj
    | inr u =>
      cases v with
      | inl y =>
        rw [hgroot y.1 u, hgcopy y.1 (.inl y) (by intro z hz; cases hz; rfl)]
        exact (f y.1).toHom.map_adj hadj
      | inr v =>
        rw [hgroot i₀ u, hgroot i₀ v]
        exact (f i₀).toHom.map_adj hadj
  · intro u v heq
    change g u = g v at heq
    cases u with
    | inl x =>
      cases v with
      | inl y =>
        change f x.1 (.inl x.2.val) = f y.1 (.inl y.2.val) at heq
        by_cases hij : x.1 = y.1
        · have hxy : x.2 = y.2 := by
            apply Subtype.ext
            apply Sum.inl_injective
            apply (f y.1).injective
            simpa only [hij] using heq
          exact congrArg Sum.inl (Prod.ext hij hxy)
        · obtain ⟨hxy, hfixed⟩ := hcan x.1 (mem_univ _) y.1 (mem_univ _) hij x.2 y.2 heq
          exfalso
          apply x.2.prop
          apply (hC x.2).mpr
          intro i
          exact (hfixed i (mem_univ _)).trans (hfixed i₀ (mem_univ _)).symm
      | inr y =>
        rw [hgroot x.1 y] at heq
        have hxy := (f x.1).injective heq
        cases y with
        | inl y =>
          have hval : x.2.val = y.val := Sum.inl.inj hxy
          exact False.elim (x.2.prop (hval ▸ y.prop))
        | inr y => exact False.elim (Sum.inl_ne_inr hxy)
    | inr x =>
      cases v with
      | inl y =>
        rw [hgroot y.1 x] at heq
        have hxy := (f y.1).injective heq
        cases x with
        | inl x =>
          have hval : x.val = y.2.val := Sum.inl.inj hxy
          exact False.elim (y.2.prop (hval ▸ x.prop))
        | inr x => exact False.elim (Sum.inr_ne_inl hxy)
      | inr y =>
        rw [hgroot i₀ x, hgroot i₀ y] at heq
        have hxy := (f i₀).injective heq
        cases x <;> cases y
        · exact congrArg (fun z => Sum.inr (Sum.inl z)) (Subtype.ext (Sum.inl.inj hxy))
        · exact False.elim (Sum.inl_ne_inr hxy)
        · exact False.elim (Sum.inr_ne_inl hxy)
        · exact congrArg (fun z => Sum.inr (Sum.inr z)) (Sum.inr.inj hxy)

/-- Every sufficiently large family of common-root copies contains a power with
some (possibly nonempty) additional internal core. -/
theorem corePower_of_many_copies {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} {N p : ℕ} (hp : 2 ≤ p)
    (r : R ↪ W) (f : Fin N → H.Copy G) (hf : Function.Injective f)
    (hr : ∀ i x, f i (.inr x) = r x) (hN : bound (Fintype.card A) p < N) :
    ∃ C : Finset A, C ≠ univ ∧ (corePower H C p).IsContained G := by
  classical
  let g : Fin N → A ↪ W := fun i => Function.Embedding.inl.trans (f i).toEmbedding
  have hg : Function.Injective g := by
    intro i j heq
    apply hf
    apply Copy.ext
    intro v
    cases v with
    | inl a => exact congrArg (fun e : A ↪ W => e a) heq
    | inr x => rw [hr, hr]
  obtain ⟨S, hSF, hSc, hcan⟩ := labelled_sunflower (Fintype.card A) univ g p rfl hp hg.injOn
    (by simpa only [card_univ, Fintype.card_fin] using hN)
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by
    simp only [Fintype.card_fin, Fintype.card_coe, hSc])
  apply corePower_contained hp r (fun i => f (e i).val)
  · exact hf.comp (Subtype.val_injective.comp e.injective)
  · intro i x
    exact hr _ _
  · intro i _ j _ hij a b heq
    have heij : (e i).val ≠ (e j).val := by
      intro he
      exact hij (e.injective (Subtype.ext he))
    obtain ⟨hab, hfix⟩ := hcan (e i).val (e i).prop (e j).val (e j).prop heij a b heq
    exact ⟨hab, fun k _ => hfix (e k).val (e k).prop⟩


/-- Pinning vertices does not destroy bipartiteness. -/
lemma corePower_bipartite {A R : Type*} {H : SimpleGraph (A ⊕ R)}
    (hH : H.IsBipartite) (C : Finset A) (p : ℕ) : (corePower H C p).IsBipartite :=
  hH.of_hom (show corePower H C p →g H from ⟨projection, fun h => h.1⟩)

/-- With an empty additional core, the original rooted power embeds. -/
def powerCopyCoreEmpty {A R : Type*} (H : SimpleGraph (A ⊕ R)) (p : ℕ) :
    (RootedPacking.power H p).Copy (corePower H ∅ p) where
  toHom :=
    { toFun := Sum.elim (fun x => .inl (x.1, ⟨x.2, by simp⟩)) (fun r => .inr (.inr r))
      map_rel' := by
        intro u v h
        cases u <;> cases v
        · exact ⟨h.2, h.1⟩
        · exact ⟨h, trivial⟩
        · exact ⟨h, trivial⟩
        · exact h.elim }
  injective' := by
    intro u v heq
    cases u with
    | inl x =>
      cases v with
      | inl y =>
        have he := Sum.inl.inj heq
        have hidx : x.1 = y.1 := congrArg (fun z : Fin p × {a : A // a ∉ (∅ : Finset A)} => z.1) he
        have hval : x.2 = y.2 := congrArg (fun z : Fin p × {a : A // a ∉ (∅ : Finset A)} => z.2.val) he
        exact congrArg Sum.inl (Prod.ext hidx hval)
      | inr y => exact False.elim (Sum.inl_ne_inr heq)
    | inr x =>
      cases v with
      | inl y => exact False.elim (Sum.inr_ne_inl heq)
      | inr y => exact congrArg Sum.inr (Sum.inr.inj (Sum.inr.inj heq))

/-- A power-free host can only produce a nonempty additional core in the
sunflower extraction. This is the residual overlap obstruction. -/
theorem nonempty_core_of_power_free {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} {N p : ℕ} (hp : 2 ≤ p)
    (r : R ↪ W) (f : Fin N → H.Copy G) (hf : Function.Injective f)
    (hr : ∀ i x, f i (.inr x) = r x) (hN : bound (Fintype.card A) p < N)
    (hfree : (RootedPacking.power H p).Free G) :
    ∃ C : Finset A, C.Nonempty ∧ C ≠ univ ∧ (corePower H C p).IsContained G := by
  obtain ⟨C, hC, hc⟩ := corePower_of_many_copies hp r f hf hr hN
  refine ⟨C, ?_, hC, hc⟩
  by_contra hne
  have hempty : C = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
  subst C
  exact hfree ((show (RootedPacking.power H p).IsContained (corePower H ∅ p) from
    ⟨powerCopyCoreEmpty H p⟩).trans hc)


/-- The common-root counting conclusion can be replaced by an explicit finite
family indexed only by proper subsets of the nonroot labels. -/
theorem corePower_of_commonRootCopies {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} {p : ℕ} (hp : 2 ≤ p)
    (h : TreeCount.CommonRootCopies H G (bound (Fintype.card A) p + 1)) :
    ∃ C : Finset A, C ≠ univ ∧ (corePower H C p).IsContained G := by
  obtain ⟨r, f, hf, hr⟩ := h
  exact corePower_of_many_copies hp r f hf hr (Nat.lt_succ_self _)

/-- The expected tree exponent is an upper bound when every proper-core power
is forbidden. It does not assert that forbidding the empty-core power suffices. -/
theorem core_family_edge_bound {A R : Type u}
    [Fintype A] [Fintype R] [Nonempty A] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree) (p : ℕ) (hp : 2 ≤ p)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V)
    (hfree : ∀ C : Finset A, C ≠ univ → (corePower H C p).Free G) :
    (G.edgeFinset.card : ℝ) ≤
      (2 * (bound (Fintype.card A) p + 1) + Fintype.card (A ⊕ R)) *
        (Fintype.card V : ℝ) ^
          ((1 : ℝ) + ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ)) := by
  apply TreeCount.edge_bound_real H hH (bound (Fintype.card A) p) G hn
  intro hc
  obtain ⟨C, hC, hcopy⟩ := corePower_of_commonRootCopies hp hc
  exact hfree C hC hcopy


/-- A precise sufficient sparsification condition for the single-power upper
bound: retain a fixed fraction of edges while excluding every nonempty proper
core. The existence of this sparsification is an additional hypothesis. -/
theorem power_edge_bound_of_core_sparsification {A R : Type u}
    [Fintype A] [Fintype R] [Nonempty A] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree) (p : ℕ) (hp : 2 ≤ p)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V) (hfree : (RootedPacking.power H p).Free G)
    (L : ℝ) (hL : 0 ≤ L)
    (hthin : ∃ G' : SimpleGraph V, G' ≤ G ∧
      (G.edgeFinset.card : ℝ) ≤ L * (Nat.card G'.edgeSet : ℝ) ∧
      ∀ C : Finset A, C.Nonempty → C ≠ univ → (corePower H C p).Free G') :
    (G.edgeFinset.card : ℝ) ≤
      L * (2 * (bound (Fintype.card A) p + 1) + Fintype.card (A ⊕ R)) *
        (Fintype.card V : ℝ) ^
          ((1 : ℝ) + ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ)) := by
  classical
  obtain ⟨G', hsub, he, hcore⟩ := hthin
  have hfamily : ∀ C : Finset A, C ≠ univ → (corePower H C p).Free G' := by
    intro C hC
    rcases C.eq_empty_or_nonempty with rfl | hne
    · intro hc
      have hpower : (RootedPacking.power H p).IsContained G' :=
        (show (RootedPacking.power H p).IsContained (corePower H ∅ p) from
          ⟨powerCopyCoreEmpty H p⟩).trans hc
      exact hfree (hpower.mono_right hsub)
    · exact hcore C hne hC
  have hb := core_family_edge_bound H hH p hp G' hn hfamily
  rw [← card_edgeSet, ← Nat.card_eq_fintype_card (α := G'.edgeSet)] at hb
  calc
    (G.edgeFinset.card : ℝ) ≤ L * (Nat.card G'.edgeSet : ℝ) := he
    _ ≤ L * ((2 * (bound (Fintype.card A) p + 1) + Fintype.card (A ⊕ R)) *
        (Fintype.card V : ℝ) ^
          ((1 : ℝ) + ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ))) :=
      mul_le_mul_of_nonneg_left hb hL
    _ = _ := by ring

/-- With only one nonroot label there is no nonempty proper core, so the
sunflower argument does give a single-forbidden-graph upper bound. -/
theorem power_edge_bound_single_nonroot {A R : Type u}
    [Fintype A] [Fintype R] [Nonempty A] [Nonempty R]
    (hA : Fintype.card A = 1)
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree) (p : ℕ) (hp : 2 ≤ p)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V) (hfree : (RootedPacking.power H p).Free G) :
    (G.edgeFinset.card : ℝ) ≤ (2 * (p : ℝ) + Fintype.card (A ⊕ R)) *
        (Fintype.card V : ℝ) ^
          ((1 : ℝ) + ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ)) := by
  classical
  have hcore : ∀ C : Finset A, C ≠ univ → (corePower H C p).Free G := by
    intro C hC
    have hzero : C = ∅ := by
      by_contra he
      have hpos : 1 ≤ C.card := card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr he)
      apply hC
      exact eq_of_subset_of_card_le (subset_univ C) (by simpa only [card_univ, hA] using hpos)
    subst C
    intro hc
    exact hfree ((show (RootedPacking.power H p).IsContained (corePower H ∅ p) from
      ⟨powerCopyCoreEmpty H p⟩).trans hc)
  have hbound : bound (Fintype.card A) p + 1 = p := by
    simp only [hA, bound, Nat.factorial_one, one_pow, pow_one, one_mul]
    omega
  have hbound' : (bound (Fintype.card A) p : ℝ) + 1 = p := by exact_mod_cast hbound
  have hb := core_family_edge_bound H hH p hp G hn hcore
  rwa [hbound'] at hb


/-- An additive linear loss is harmless for the tree upper exponent, which is
at least one. Unlike a fixed-fraction requirement, this criterion accommodates
sparse hosts such as the stars in `SparsificationObstruction`. -/
theorem power_edge_bound_of_core_sparsification_additive {A R : Type u}
    [Fintype A] [Fintype R] [Nonempty A] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) (hH : H.IsTree) (p : ℕ) (hp : 2 ≤ p)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V) (hfree : (RootedPacking.power H p).Free G)
    (L B : ℝ) (hL : 0 ≤ L) (hB : 0 ≤ B)
    (hthin : ∃ G' : SimpleGraph V, G' ≤ G ∧
      (G.edgeFinset.card : ℝ) ≤ L * (Nat.card G'.edgeSet : ℝ) + B * Fintype.card V ∧
      ∀ C : Finset A, C.Nonempty → C ≠ univ → (corePower H C p).Free G') :
    (G.edgeFinset.card : ℝ) ≤
      (L * (2 * (bound (Fintype.card A) p + 1) + Fintype.card (A ⊕ R)) + B) *
        (Fintype.card V : ℝ) ^
          ((1 : ℝ) + ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ)) := by
  classical
  obtain ⟨G', hsub, he, hcore⟩ := hthin
  have hfamily : ∀ C : Finset A, C ≠ univ → (corePower H C p).Free G' := by
    intro C hC
    rcases C.eq_empty_or_nonempty with rfl | hne
    · intro hc
      have hpower : (RootedPacking.power H p).IsContained G' :=
        (show (RootedPacking.power H p).IsContained (corePower H ∅ p) from
          ⟨powerCopyCoreEmpty H p⟩).trans hc
      exact hfree (hpower.mono_right hsub)
    · exact hcore C hne hC
  have hb := core_family_edge_bound H hH p hp G' hn hfamily
  rw [← card_edgeSet, ← Nat.card_eq_fintype_card (α := G'.edgeSet)] at hb
  let β : ℝ := 1 + ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ)
  have hβ : 1 ≤ β := by
    dsimp [β]
    have hdiv : (0 : ℝ) ≤ ((Fintype.card R - 1 : ℕ) : ℝ) / ((Fintype.card (A ⊕ R) - 1 : ℕ) : ℝ) := by positivity
    linarith
  have hnβ : (Fintype.card V : ℝ) ≤ (Fintype.card V : ℝ) ^ β := by
    calc
      (Fintype.card V : ℝ) = (Fintype.card V : ℝ) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ (Fintype.card V : ℝ) ^ β := Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hn) hβ
  have hb' := mul_le_mul_of_nonneg_left hb hL
  have hn' := mul_le_mul_of_nonneg_left hnβ hB
  change (G.edgeFinset.card : ℝ) ≤
    (L * (2 * (bound (Fintype.card A) p + 1) + Fintype.card (A ⊕ R)) + B) *
      (Fintype.card V : ℝ) ^ β
  change L * (Nat.card G'.edgeSet : ℝ) ≤ L *
    ((2 * (bound (Fintype.card A) p + 1) + Fintype.card (A ⊕ R)) * (Fintype.card V : ℝ) ^ β) at hb'
  nlinarith

end RootedSunflower


namespace SparsificationObstruction

open SimpleGraph Finset

/-- A length-two path, with just one endpoint designated as a root. -/
def H : SimpleGraph (Fin 2 ⊕ Fin 1) where
  Adj u v := match u, v with
    | .inl i, .inl j => i ≠ j
    | .inl i, .inr _ => i = 0
    | .inr _, .inl j => j = 0
    | .inr _, .inr _ => False
  symm := by intro u v h; cases u <;> cases v <;> simp_all [ne_comm]
  loopless := by intro u; cases u <;> simp

instance : DecidableRel H.Adj := by
  intro u v
  dsimp [H]
  split <;> infer_instance

lemma H_tree : H.IsTree := by
  rw [isTree_iff_connected_and_card]
  constructor
  · apply (connected_iff_exists_forall_reachable H).mpr
    refine ⟨.inl 0, ?_⟩
    intro v
    cases v with
    | inl i =>
      fin_cases i
      · exact Reachable.refl _
      · exact (show H.Adj (.inl 0) (.inl 1) by decide).reachable
    | inr i => exact (show H.Adj (.inl 0) (.inr i) from rfl).reachable
  · rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    decide

lemma H_card_edges : Nat.card H.edgeSet = 2 := by
  rw [Nat.card_eq_fintype_card]
  decide

/-- This example is balanced at density one, not merely an arbitrary rooted tree. -/
lemma H_balanced (S : Finset (Fin 2)) :
    S.card ≤ ((univ : Finset H.edgeSet).filter
      (fun e => ∃ i ∈ S, Sum.inl i ∈ e.val)).card := by
  revert S
  decide

abbrev Host (n : ℕ) := completeBipartiteGraph (Fin 1) (Fin n)

lemma host_adj {n : ℕ} {u v : Fin 1 ⊕ Fin n} (h : (Host n).Adj u v) :
    u = .inl 0 ∨ v = .inl 0 := by
  cases u with
  | inl i => exact Or.inl (congrArg Sum.inl (Subsingleton.elim _ _))
  | inr i =>
    cases v with
    | inl j => exact Or.inr (congrArg Sum.inl (Subsingleton.elim _ _))
    | inr j => simp [Host, completeBipartiteGraph] at h

lemma host_power_free (n : ℕ) : (RootedPacking.power H 2).Free (Host n) := by
  rintro ⟨f⟩
  have h₀ : (Host n).Adj (f (.inl (0, 0))) (f (.inl (0, 1))) :=
    f.toHom.map_adj ⟨rfl, by decide⟩
  have h₁ : (Host n).Adj (f (.inl (1, 0))) (f (.inl (1, 1))) :=
    f.toHom.map_adj ⟨rfl, by decide⟩
  rcases host_adj h₀ with ha | hb <;> rcases host_adj h₁ with hc | hd
  · have he := f.injective (ha.trans hc.symm)
    simp at he
  · have he := f.injective (ha.trans hd.symm)
    simp at he
  · have he := f.injective (hb.trans hc.symm)
    simp at he
  · have he := f.injective (hb.trans hd.symm)
    simp at he

abbrev Core := RootedSunflower.corePower H ({0} : Finset (Fin 2)) 2
abbrev Claw := completeBipartiteGraph (Fin 1) (Fin 3)

def coreMap : RootedSunflower.CoreVertex (Fin 2) (Fin 1) {0} 2 → Fin 1 ⊕ Fin 3
  | .inl x => .inr x.1.castSucc
  | .inr (.inl _) => .inl 0
  | .inr (.inr _) => .inr 2

instance : DecidableRel Core.Adj := by
  intro u v
  rcases u with x | (x | x) <;> rcases v with y | (y | y) <;>
    dsimp [Core, RootedSunflower.corePower, RootedSunflower.projection, H] <;> infer_instance

instance : DecidableRel Claw.Adj := by
  intro u v
  dsimp [Claw, completeBipartiteGraph]
  infer_instance

def coreCopyClaw : Core.Copy Claw where
  toHom := { toFun := coreMap, map_rel' := by decide }
  injective' := by decide

lemma host_edges_degree (n : ℕ) (G : SimpleGraph (Fin 1 ⊕ Fin n))
    [DecidableRel G.Adj] (hG : G ≤ Host n) : G.edgeFinset.card = G.degree (.inl 0) := by
  classical
  rw [← card_incidenceFinset_eq_degree]
  congr 1
  apply Finset.ext
  intro e
  induction e using Sym2.inductionOn with
  | _ u v =>
    rw [mem_edgeFinset, mem_incidenceFinset, mk'_mem_incidenceSet_iff]
    constructor
    · intro h
      refine ⟨h, ?_⟩
      exact (host_adj (hG h)).imp Eq.symm Eq.symm
    · exact And.left

lemma host_card_edges (n : ℕ) : Nat.card (Host n).edgeSet = n := by
  classical
  rw [Nat.card_eq_fintype_card, card_edgeSet, host_edges_degree n _ le_rfl]
  have he : (Host n).neighborFinset (.inl 0) = univ.image Sum.inr := by
    ext v
    cases v <;> simp [Host, completeBipartiteGraph]
  rw [← card_neighborFinset_eq_degree, he, card_image_of_injective _ Sum.inr_injective,
    card_univ, Fintype.card_fin]

lemma core_free_subgraph_small (n : ℕ) (G : SimpleGraph (Fin 1 ⊕ Fin n))
    (hG : G ≤ Host n) (hfree : Core.Free G) : Nat.card G.edgeSet ≤ 2 := by
  classical
  have hclaw : Claw.Free G := fun hc => hfree ((show Core.IsContained Claw from ⟨coreCopyClaw⟩).trans hc)
  have hdeg : G.degree (.inl 0) < 3 := by
    by_contra hn
    have hsize : 3 ≤ (G.neighborFinset (.inl 0)).card := by
      rw [card_neighborFinset_eq_degree]
      omega
    obtain ⟨S, hS, hSc⟩ := exists_subset_card_eq hsize
    apply hclaw
    apply completeBipartiteGraph_isContained_iff.mpr
    refine ⟨{.inl 0}, S, by simp, by simpa using hSc, ?_⟩
    intro u hu v hv
    have hu' : u = .inl 0 := mem_singleton.mp hu
    subst u
    exact (G.mem_neighborFinset _ _).mp (hS hv)
  rw [Nat.card_eq_fintype_card, card_edgeSet, host_edges_degree n G hG]
  omega

/-- No uniform fixed-fraction deletion can remove the pinned-core obstruction
from every power-free host. This is not a disproof of the rational-exponent conjecture. -/
theorem no_uniform_fraction :
    ¬ ∃ L : ℝ, 0 ≤ L ∧ ∀ n : ℕ,
      ∃ G : SimpleGraph (Fin 1 ⊕ Fin n), G ≤ Host n ∧ Core.Free G ∧
        (Nat.card (Host n).edgeSet : ℝ) ≤ L * (Nat.card G.edgeSet : ℝ) := by
  rintro ⟨L, hL, h⟩
  obtain ⟨n, hn⟩ := exists_nat_gt (2 * L)
  obtain ⟨G, hG, hfree, he⟩ := h n
  rw [host_card_edges] at he
  have hsmall : (Nat.card G.edgeSet : ℝ) ≤ 2 := by exact_mod_cast core_free_subgraph_small n G hG hfree
  have hle := he.trans (mul_le_mul_of_nonneg_left hsmall hL)
  nlinarith

end SparsificationObstruction


namespace RootedSunflower

open SimpleGraph Finset

variable {A R : Type*} [DecidableEq A]

def slice (C : Finset A) {p : ℕ} (i : Fin p) : A ⊕ R → CoreVertex A R C p
  | .inl a => if ha : a ∈ C then .inr (.inl ⟨a, ha⟩) else .inl (i, ⟨a, ha⟩)
  | .inr r => .inr (.inr r)

@[simp] lemma projection_slice (C : Finset A) {p : ℕ} (i : Fin p) (v : A ⊕ R) :
    projection (slice C i v) = v := by
  cases v with
  | inl a => by_cases ha : a ∈ C <;> simp [slice, projection, ha]
  | inr r => rfl

def sliceCopy (H : SimpleGraph (A ⊕ R)) (C : Finset A) {p : ℕ} (i : Fin p) :
    H.Copy (corePower H C p) where
  toHom :=
    { toFun := slice C i
      map_rel' := by
        intro u v h
        refine ⟨by simpa only [projection_slice] using h, ?_⟩
        cases u with
        | inl a =>
          cases v with
          | inl b => by_cases ha : a ∈ C <;> by_cases hb : b ∈ C <;> simp [slice, ha, hb]
          | inr r => by_cases ha : a ∈ C <;> simp [slice, ha]
        | inr r =>
          cases v with
          | inl b => by_cases hb : b ∈ C <;> simp [slice, hb]
          | inr s => trivial }
  injective' := (show Function.LeftInverse projection (slice C i) from projection_slice C i).injective

/-- Edges incident to a nonroot that has not been pinned. -/
abbrev PetalEdge (H : SimpleGraph (A ⊕ R)) (C : Finset A) :=
  {e : H.edgeSet // ∃ a, a ∉ C ∧ Sum.inl a ∈ e.val}

def petalEdge (H : SimpleGraph (A ⊕ R)) (C : Finset A) (p : ℕ)
    (x : Fin p × PetalEdge H C) : (corePower H C p).edgeSet :=
  (sliceCopy H C x.1).mapEdgeSet x.2.val

lemma project_edge (C : Finset A) {p : ℕ} (i : Fin p) (e : Sym2 (A ⊕ R)) :
    Sym2.map projection (Sym2.map (slice C i) e) = e := by
  have he : projection (R := R) ∘ slice C i = id := funext (projection_slice C i)
  rw [Sym2.map_map, he, Sym2.map_id]
  rfl

lemma petalEdge_injective (H : SimpleGraph (A ⊕ R)) (C : Finset A) (p : ℕ) :
    Function.Injective (petalEdge H C p) := by
  rintro ⟨i, e⟩ ⟨j, d⟩ heq
  have he : Sym2.map (slice C i) e.val.val = Sym2.map (slice C j) d.val.val :=
    congrArg Subtype.val heq
  have hed : e = d := by
    apply Subtype.ext
    apply Subtype.ext
    have hh := congrArg (Sym2.map projection) he
    simpa only [project_edge] using hh
  subst d
  obtain ⟨a, haC, hae⟩ := e.prop
  have hmem : slice C i (.inl a : A ⊕ R) ∈ Sym2.map (slice C j) e.val.val := by
    rw [← he]
    exact Sym2.mem_map.mpr ⟨.inl a, hae, rfl⟩
  obtain ⟨v, hv, hvi⟩ := Sym2.mem_map.mp hmem
  have hij : i = j := by
    cases v with
    | inl b =>
      by_cases hbC : b ∈ C
      · simp [slice, haC, hbC] at hvi
      · have hpair : (j, (⟨b, hbC⟩ : {a : A // a ∉ C})) = (i, ⟨a, haC⟩) := by
          simpa only [slice, dif_neg haC, dif_neg hbC, Sum.inl.injEq] using hvi
        exact (congrArg Prod.fst hpair).symm
    | inr r => simp [slice, haC] at hvi
  exact Prod.ext hij rfl

/-- Every edge meeting a petal has one distinct lift in each copy. -/
lemma corePower_card_edges_lower [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (C : Finset A) (p : ℕ) :
    p * Nat.card (PetalEdge H C) ≤ Nat.card (corePower H C p).edgeSet := by
  classical
  have h := Nat.card_le_card_of_injective (petalEdge H C p) (petalEdge_injective H C p)
  simpa only [Nat.card_prod, Nat.card_fin] using h

lemma corePower_card_vertices [Fintype A] [Fintype R] (C : Finset A) (p : ℕ) :
    Nat.card (CoreVertex A R C p) = p * (Fintype.card A - C.card) + C.card + Fintype.card R := by
  classical
  have hc : Fintype.card {a : A // a ∈ C} = C.card := Fintype.card_coe _
  have hn : Fintype.card {a : A // a ∉ C} = Fintype.card A - C.card := by
    rw [Fintype.card_subtype_compl, hc]
  simp only [Nat.card_eq_fintype_card, CoreVertex, Fintype.card_sum, Fintype.card_prod,
    Fintype.card_fin, hc, hn, add_assoc]


/-- If the unpinned part has density strictly above the target rooted density,
then sufficiently large core powers cannot have the target upper exponent.
This is a lower-bound obstruction, not a bound for the original empty-core power. -/
theorem corePower_eventually_not_isBigO [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (C : Finset A) (hC : C ≠ univ)
    (a : ℝ) (ha : a < 2)
    (hgap : ((Fintype.card A - C.card : ℕ) : ℝ) <
      (2 - a) * (Nat.card (PetalEdge H C) : ℝ)) :
    ∃ P : ℕ, 2 ≤ P ∧ ∀ p : ℕ, P ≤ p →
      ¬ Asymptotics.IsBigO atTop
        (fun n : ℕ => (extremalNumber n (corePower H C p) : ℝ))
        (fun n : ℕ => (n : ℝ) ^ a) := by
  classical
  let s : ℕ := Fintype.card A - C.card
  let d : ℕ := Nat.card (PetalEdge H C)
  let δ : ℝ := 2 - a
  let γ : ℝ := δ * d - s
  have hs : 0 < s := by
    have hc : C.card < Fintype.card A := by
      simpa only [card_univ] using card_lt_card (ssubset_univ_iff.mpr hC)
    dsimp [s]
    omega
  have hδ : 0 < δ := by dsimp [δ]; linarith
  have hγ : 0 < γ := sub_pos.mpr hgap
  have hd : 0 < d := by
    by_contra hd
    have hd0 : d = 0 := by omega
    change (s : ℝ) < δ * d at hgap
    rw [hd0, Nat.cast_zero, mul_zero] at hgap
    exact (Nat.cast_nonneg s).not_gt hgap
  obtain ⟨P, hP⟩ := exists_nat_gt ((δ + C.card + Fintype.card R) / γ + 2)
  have hratio : 0 ≤ (δ + C.card + Fintype.card R) / γ := by positivity
  have hP2 : 2 ≤ P := by
    have : (2 : ℝ) < P := by linarith
    exact_mod_cast this.le
  refine ⟨P, hP2, ?_⟩
  intro p hp
  have hp2 : 2 ≤ p := hP2.trans hp
  have hlarge : δ + C.card + Fintype.card R < (p : ℝ) * γ := by
    apply (div_lt_iff₀ hγ).mp
    have hp' : (P : ℝ) ≤ p := by exact_mod_cast hp
    linarith
  have hV : Fintype.card (CoreVertex A R C p) = p * s + C.card + Fintype.card R := by
    simpa only [Nat.card_eq_fintype_card] using corePower_card_vertices (R := R) C p
  have hE : p * d ≤ Nat.card (corePower H C p).edgeSet := corePower_card_edges_lower H C p
  have hv : 2 ≤ Fintype.card (CoreVertex A R C p) := by rw [hV]; nlinarith
  have he : 2 ≤ Nat.card (corePower H C p).edgeSet := by nlinarith
  apply RandomDeletion.not_isBigO_of_random_density (corePower H C p) hv he a
  have hV' : (Fintype.card (CoreVertex A R C p) : ℝ) =
      (p : ℝ) * s + C.card + Fintype.card R := by exact_mod_cast hV
  have hE' : (p : ℝ) * d ≤ (Nat.card (corePower H C p).edgeSet : ℝ) := by exact_mod_cast hE
  have hδE := mul_le_mul_of_nonneg_left hE' hδ.le
  rw [hV']
  change (p : ℝ) * s + C.card + Fintype.card R - 2 <
    δ * ((Nat.card (corePower H C p).edgeSet : ℝ) - 1)
  change δ + C.card + Fintype.card R < (p : ℝ) * (δ * d - s) at hlarge
  nlinarith

end RootedSunflower


namespace BalancedTree

abbrev Leaf {k : ℕ} (c : Fin (k + 1) → ℕ) := Σ i, Fin (c i)
abbrev Vertex {k : ℕ} (c : Fin (k + 1) → ℕ) := Fin (k + 1) ⊕ Leaf c
abbrev EdgeIndex {k : ℕ} (c : Fin (k + 1) → ℕ) := Fin k ⊕ Leaf c

def graph {k : ℕ} (c : Fin (k + 1) → ℕ) : SimpleGraph (Vertex c) where
  Adj u v := match u, v with
    | .inl i, .inl j => (pathGraph (k + 1)).Adj i j
    | .inl i, .inr l => i = l.1
    | .inr l, .inl i => l.1 = i
    | .inr _, .inr _ => False
  symm := by
    intro u v h
    cases u <;> cases v
    · exact h.symm
    · exact h.symm
    · exact h.symm
    · exact h
  loopless := by
    intro u
    cases u
    · exact (pathGraph _).loopless _
    · exact not_false

def edge {k : ℕ} {c : Fin (k + 1) → ℕ} (e : EdgeIndex c) : (graph c).edgeSet :=
  match e with
  | .inl i => ⟨s(.inl i.castSucc, .inl i.succ), by
      change (pathGraph (k + 1)).Adj i.castSucc i.succ
      simp [pathGraph_adj]⟩
  | .inr l => ⟨s(.inl l.1, .inr l), rfl⟩

lemma edge_injective {k : ℕ} {c : Fin (k + 1) → ℕ} :
    Function.Injective (@edge k c) := by
  intro e f h
  have h' := congrArg Subtype.val h
  cases e with
  | inl i =>
    cases f with
    | inl j =>
      simp only [edge, Sym2.eq_iff, Sum.inl.injEq] at h'
      rcases h' with ⟨h, _⟩ | ⟨h₁, h₂⟩
      · simpa using h
      · have h₁' := congrArg Fin.val h₁
        have h₂' := congrArg Fin.val h₂
        simp only [Fin.val_castSucc, Fin.val_succ] at h₁' h₂'
        omega
    | inr l => simp [edge] at h'
  | inr l =>
    cases f with
    | inl i => simp [edge] at h'
    | inr m =>
      simp only [edge, Sym2.eq_iff, Sum.inl.injEq, Sum.inr.injEq, Sum.inl_ne_inr,
        Sum.inr_ne_inl, false_and, or_false] at h'
      exact congrArg Sum.inr h'.2

lemma edge_surjective {k : ℕ} {c : Fin (k + 1) → ℕ} :
    Function.Surjective (@edge k c) := by
  rintro ⟨e, he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl i =>
      cases v with
      | inl j =>
        change (pathGraph (k + 1)).Adj i j at he
        rw [pathGraph_adj] at he
        rcases he with hij | hji
        · have hi : i.val < k := by omega
          refine ⟨.inl ⟨i.val, hi⟩, ?_⟩
          apply Subtype.ext
          simp only [edge]
          apply Sym2.eq_iff.mpr
          exact Or.inl ⟨congrArg Sum.inl (Fin.ext rfl), congrArg Sum.inl (Fin.ext hij)⟩
        · have hj : j.val < k := by omega
          refine ⟨.inl ⟨j.val, hj⟩, ?_⟩
          apply Subtype.ext
          simp only [edge]
          apply Sym2.eq_iff.mpr
          exact Or.inr ⟨congrArg Sum.inl (Fin.ext rfl), congrArg Sum.inl (Fin.ext hji)⟩
      | inr l =>
        change i = l.1 at he
        subst i
        exact ⟨.inr l, rfl⟩
    | inr l =>
      cases v with
      | inl i =>
        change l.1 = i at he
        subst i
        refine ⟨.inr l, ?_⟩
        apply Subtype.ext
        exact Sym2.eq_swap
      | inr m => exact he.elim

noncomputable def edgeEquiv {k : ℕ} (c : Fin (k + 1) → ℕ) :
    EdgeIndex c ≃ (graph c).edgeSet := Equiv.ofBijective edge ⟨edge_injective, edge_surjective⟩

lemma card_edges {k : ℕ} (c : Fin (k + 1) → ℕ) :
    Nat.card (graph c).edgeSet = k + ∑ i, c i := by
  classical
  rw [← Nat.card_congr (edgeEquiv c)]
  simp [Nat.card_eq_fintype_card, EdgeIndex, Leaf, Fintype.card_sigma]

lemma connected {k : ℕ} (c : Fin (k + 1) → ℕ) : (graph c).Connected := by
  let f : pathGraph (k + 1) →g graph c := ⟨Sum.inl, fun h => h⟩
  apply (connected_iff_exists_forall_reachable (graph c)).mpr
  refine ⟨.inl 0, ?_⟩
  intro v
  cases v with
  | inl i => exact ((pathGraph_connected k) 0 i).map f
  | inr l =>
    exact (((pathGraph_connected k) 0 l.1).map f).trans
      (show (graph c).Adj (.inl l.1) (.inr l) from rfl).reachable

lemma isTree {k : ℕ} (c : Fin (k + 1) → ℕ) : (graph c).IsTree := by
  rw [isTree_iff_connected_and_card]
  refine ⟨connected c, ?_⟩
  rw [card_edges]
  simp [Nat.card_eq_fintype_card, Vertex, Leaf, Fintype.card_sigma]
  omega

def slope (k m : ℕ) : ℚ := m / (k + 1)
def rounding (k m i : ℕ) : ℕ := ⌈slope k m * i⌉₊
def potential (k m i : ℕ) : ℚ := (rounding k m i : ℚ) - slope k m * i
def leafCount (k m : ℕ) (i : Fin (k + 1)) : ℕ :=
  rounding k m (i.val + 1) - rounding k m i.val + if i = Fin.last k then 1 else 0

lemma slope_nonneg (k m : ℕ) : 0 ≤ slope k m := by unfold slope; positivity

lemma rounding_mono (k m : ℕ) : Monotone (rounding k m) := by
  intro i j hij
  apply Nat.ceil_mono
  exact mul_le_mul_of_nonneg_left (by exact_mod_cast hij) (slope_nonneg k m)

@[simp] lemma rounding_zero (k m : ℕ) : rounding k m 0 = 0 := by simp [rounding]

@[simp] lemma rounding_end (k m : ℕ) : rounding k m (k + 1) = m := by
  have hk : (k : ℚ) + 1 ≠ 0 := by positivity
  simp [rounding, slope, div_mul_cancel₀ _ hk]

lemma potential_bounds (k m i : ℕ) :
    0 ≤ potential k m i ∧ potential k m i < 1 := by
  have hlo := Nat.le_ceil (slope k m * i)
  have hhi := Nat.ceil_lt_add_one (mul_nonneg (slope_nonneg k m) (Nat.cast_nonneg i))
  dsimp [potential, rounding]
  constructor <;> linarith

@[simp] lemma potential_zero (k m : ℕ) : potential k m 0 = 0 := by simp [potential]

@[simp] lemma potential_end (k m : ℕ) : potential k m (k + 1) = 0 := by
  have hk : (k : ℚ) + 1 ≠ 0 := by positivity
  simp [potential, slope, div_mul_cancel₀ _ hk]

lemma leafCount_formula (k m : ℕ) (i : Fin (k + 1)) :
    (leafCount k m i : ℚ) = slope k m + potential k m (i.val + 1) -
      potential k m i.val + if i = Fin.last k then 1 else 0 := by
  have h := rounding_mono k m (Nat.le_succ i.val)
  simp only [leafCount, Nat.cast_add, Nat.cast_sub h, Nat.cast_ite, Nat.cast_one,
    Nat.cast_zero, potential, Nat.cast_add, Nat.cast_one]
  ring

lemma sum_leafCount (k m : ℕ) : ∑ i, leafCount k m i = m + 1 := by
  have hs : (∑ i : Fin (k + 1),
      (rounding k m (i.val + 1) - rounding k m i.val)) = m := by
    rw [Fin.sum_univ_eq_sum_range (fun j => rounding k m (j + 1) - rounding k m j) (k + 1)]
    rw [sum_range_tsub (rounding_mono k m)]
    simp
  simp only [leafCount, sum_add_distrib, hs, sum_ite_eq', mem_univ, if_true]

/-- The weight of an edge allocated to a nonroot vertex. -/
def weight {k : ℕ} {c : Fin (k + 1) → ℕ} (p : ℕ → ℚ)
    (i : Fin (k + 1)) (e : EdgeIndex c) : ℚ :=
  match e with
  | .inl j => (if i = j.castSucc then 1 - p (j.val + 1) else 0) +
      (if i = j.succ then p (j.val + 1) else 0)
  | .inr l => if i = l.1 then 1 else 0

lemma weight_nonneg {k : ℕ} {c : Fin (k + 1) → ℕ} (p : ℕ → ℚ)
    (hp : ∀ i, 0 ≤ p i ∧ p i ≤ 1) (i : Fin (k + 1)) (e : EdgeIndex c) :
    0 ≤ weight p i e := by
  cases e with
  | inl j =>
    have hlo := (hp (j.val + 1)).1
    have hhi := (hp (j.val + 1)).2
    dsimp [weight]
    apply add_nonneg
    · split_ifs
      · exact sub_nonneg.mpr hhi
      · exact le_rfl
    · split_ifs
      · exact hlo
      · exact le_rfl
  | inr l => simp only [weight]; positivity

lemma sum_weight_column {k : ℕ} {c : Fin (k + 1) → ℕ}
    (p : ℕ → ℚ) (e : EdgeIndex c) : ∑ i, weight p i e = 1 := by
  cases e <;> simp [weight, sum_add_distrib]

lemma sum_weight_row {k : ℕ} {c : Fin (k + 1) → ℕ}
    (p : ℕ → ℚ) (h0 : p 0 = 0) (hend : p (k + 1) = 0) (i : Fin (k + 1)) :
    ∑ e : EdgeIndex c, weight p i e =
      (c i : ℚ) + 1 - p (i.val + 1) + p i.val - if i = Fin.last k then 1 else 0 := by
  have hout := Fin.sum_univ_castSucc (fun j : Fin (k + 1) =>
    if i = j then 1 - p (j.val + 1) else 0)
  simp only [sum_ite_eq, mem_univ, if_true, Fin.val_castSucc, Fin.val_last,
    hend, sub_zero] at hout
  have hin := Fin.sum_univ_succ (fun j : Fin (k + 1) =>
    if i = j then p j.val else 0)
  simp only [sum_ite_eq, mem_univ, if_true, Fin.val_zero, h0, ite_self,
    zero_add, Fin.val_succ] at hin
  have hleaf : (∑ l : Leaf c, if i = l.1 then (1 : ℚ) else 0) = c i := by
    rw [Fintype.sum_sigma]
    change (∑ j : Fin (k + 1), ∑ _ : Fin (c j), if i = j then (1 : ℚ) else 0) = c i
    simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, mul_ite,
      mul_one, mul_zero, sum_ite_eq, mem_univ, if_true]
  simp only [Fintype.sum_sum_type, weight, sum_add_distrib, hleaf]
  linarith

lemma sum_weight_row_potential (k m : ℕ) (i : Fin (k + 1)) :
    ∑ e : EdgeIndex (leafCount k m), weight (potential k m) i e = 1 + slope k m := by
  rw [sum_weight_row _ (potential_zero k m) (potential_end k m), leafCount_formula]
  ring

noncomputable def incidentEdges {k : ℕ} (c : Fin (k + 1) → ℕ)
    (S : Finset (Fin (k + 1))) : Finset (graph c).edgeSet := by
  classical
  exact univ.filter fun e => ∃ i ∈ S, Sum.inl i ∈ e.val

lemma weight_eq_zero_of_not_incident {k : ℕ} {c : Fin (k + 1) → ℕ}
    (p : ℕ → ℚ) (i : Fin (k + 1)) (e : EdgeIndex c)
    (hi : Sum.inl i ∉ (edge e).val) : weight p i e = 0 := by
  cases e with
  | inl j =>
    simp only [edge, Sym2.mem_iff, Sum.inl.injEq, not_or] at hi
    simp [weight, hi.1, hi.2]
  | inr l =>
    simp only [edge, Sym2.mem_iff, Sum.inl.injEq, Sum.inl_ne_inr, or_false] at hi
    simp [weight, hi]

lemma incidentEdges_card {k : ℕ} (c : Fin (k + 1) → ℕ)
    (S : Finset (Fin (k + 1))) :
    (incidentEdges c S).card =
      (univ.filter fun e : EdgeIndex c => ∃ i ∈ S, Sum.inl i ∈ (edge e).val).card := by
  classical
  have heq : incidentEdges c S =
      (univ.filter fun e : EdgeIndex c => ∃ i ∈ S, Sum.inl i ∈ (edge e).val).image edge := by
    ext e
    simp only [incidentEdges, mem_filter, mem_univ, true_and, mem_image]
    constructor
    · intro h
      obtain ⟨j, rfl⟩ := edge_surjective e
      exact ⟨j, h, rfl⟩
    · rintro ⟨j, h, rfl⟩
      exact h
  rw [heq, card_image_of_injective _ edge_injective]

/-- Every set of nonroots meets at least its size times the density many edges. -/
lemma balanced (k m : ℕ) (S : Finset (Fin (k + 1))) :
    (1 + slope k m) * S.card ≤ ((incidentEdges (leafCount k m) S).card : ℚ) := by
  classical
  have hnonneg : ∀ i e, 0 ≤ weight (potential k m) i (e : EdgeIndex (leafCount k m)) := by
    intro i e
    apply weight_nonneg
    intro j
    exact ⟨(potential_bounds k m j).1, (potential_bounds k m j).2.le⟩
  have hbound : ∀ e : EdgeIndex (leafCount k m),
      (∑ i ∈ S, weight (potential k m) i e) ≤
        if ∃ i ∈ S, Sum.inl i ∈ (edge e).val then (1 : ℚ) else 0 := by
    intro e
    split_ifs with he
    · rw [← sum_weight_column (potential k m) e]
      apply sum_le_sum_of_subset_of_nonneg (subset_univ S)
      intro i _ _
      exact hnonneg i e
    · apply le_of_eq
      apply sum_eq_zero
      intro i hi
      apply weight_eq_zero_of_not_incident
      intro hh
      exact he ⟨i, hi, hh⟩
  have h := sum_le_sum (s := (univ : Finset (EdgeIndex (leafCount k m)))) (fun e _ => hbound e)
  rw [sum_comm] at h
  simp only [sum_weight_row_potential, sum_const, nsmul_eq_mul] at h
  rw [incidentEdges_card]
  simpa only [mul_comm, sum_boole] using h

lemma density_eq (k m : ℕ) :
    1 + slope k m = (Nat.card (graph (leafCount k m)).edgeSet : ℚ) / (k + 1) := by
  rw [card_edges, sum_leafCount]
  dsimp [slope]
  push_cast
  field_simp
  ring

lemma roots_independent {k : ℕ} (c : Fin (k + 1) → ℕ) (l l' : Leaf c) :
    ¬ (graph c).Adj (.inr l) (.inr l') := not_false

lemma every_density (ρ : ℚ) (hρ : 1 ≤ ρ) :
    ∃ k m : ℕ, 1 + slope k m = ρ := by
  let d := ρ - 1
  have hd : 0 ≤ d := sub_nonneg.mpr hρ
  let k := d.den - 1
  let m := d.num.natAbs
  have hk : k + 1 = d.den := by dsimp [k]; have := d.den_pos; omega
  have hnum : (m : ℚ) = d.num := by
    dsimp [m]
    rw [← Int.cast_natCast, Int.natAbs_of_nonneg (Rat.num_nonneg.mpr hd)]
  refine ⟨k, m, ?_⟩
  have hs : slope k m = d := by
    dsimp [slope]
    have hk' : (k : ℚ) + 1 = d.den := by exact_mod_cast hk
    rw [hk', hnum, Rat.num_div_den]
  rw [hs]
  dsimp [d]
  ring

/-- For every rational density at least one, the explicit construction is a
balanced rooted tree with exactly that edge-to-nonroot ratio. -/
theorem exists_balanced_rooted_tree (ρ : ℚ) (hρ : 1 ≤ ρ) :
    ∃ k m : ℕ, (graph (leafCount k m)).IsTree ∧
      ρ = (Nat.card (graph (leafCount k m)).edgeSet : ℚ) / (k + 1) ∧
      (∀ l l' : Leaf (leafCount k m),
        ¬ (graph (leafCount k m)).Adj (.inr l) (.inr l')) ∧
      ∀ S : Finset (Fin (k + 1)),
        ρ * S.card ≤ ((incidentEdges (leafCount k m) S).card : ℚ) := by
  obtain ⟨k, m, hkm⟩ := every_density ρ hρ
  refine ⟨k, m, isTree _, ?_, roots_independent _, ?_⟩
  · rw [← hkm]
    exact density_eq k m
  · intro S
    rw [← hkm]
    exact balanced k m S

/-- Multiplying a rational by a positive integer smaller than its reduced
denominator cannot yield an integer. -/
lemma mul_ne_nat_of_lt_den (ρ : ℚ) (s e : ℕ) (hs : 0 < s) (hden : s < ρ.den) :
    ρ * s ≠ e := by
  intro heq
  have hs' : (s : ℚ) ≠ 0 := by exact_mod_cast hs.ne'
  have hrep : (e : ℚ) / s = ρ := (div_eq_iff hs').mpr heq.symm
  have hrep' : Rat.divInt (e : ℤ) (s : ℤ) = ρ := by
    simpa only [Rat.divInt_eq_div, Int.cast_natCast] using hrep
  have hd := Rat.den_dvd (e : ℤ) (s : ℤ)
  rw [hrep'] at hd
  have hds : ρ.den ∣ s := Int.natCast_dvd_natCast.mp hd
  exact hden.not_ge (Nat.le_of_dvd hs hds)

/-- Choose the number of nonroots to be exactly the reduced denominator. -/
lemma every_density_reduced (ρ : ℚ) (hρ : 1 ≤ ρ) :
    ∃ k m : ℕ, 1 + slope k m = ρ ∧ k + 1 = ρ.den := by
  let d := ρ - 1
  have hd : 0 ≤ d := sub_nonneg.mpr hρ
  let k := d.den - 1
  let m := d.num.natAbs
  have hk : k + 1 = d.den := by dsimp [k]; have := d.den_pos; omega
  have hnum : (m : ℚ) = d.num := by
    dsimp [m]
    rw [← Int.cast_natCast, Int.natAbs_of_nonneg (Rat.num_nonneg.mpr hd)]
  refine ⟨k, m, ?_, ?_⟩
  · have hs : slope k m = d := by
      dsimp [slope]
      have hk' : (k : ℚ) + 1 = d.den := by exact_mod_cast hk
      rw [hk', hnum, Rat.num_div_den]
    rw [hs]
    dsimp [d]
    ring
  · simpa only [d, Rat.sub_ofNat_den] using hk

/-- The reduced-denominator construction is strictly balanced on every
nonempty proper subset of nonroot vertices. -/
lemma strictly_balanced (k m : ℕ) (hden : (1 + slope k m).den = k + 1)
    (S : Finset (Fin (k + 1))) (hne : S.Nonempty) (hproper : S ≠ univ) :
    (1 + slope k m) * S.card < ((incidentEdges (leafCount k m) S).card : ℚ) := by
  apply lt_of_le_of_ne (balanced k m S)
  have hlt : S.card < (1 + slope k m).den := by
    simpa only [card_univ, Fintype.card_fin, hden] using
      card_lt_card (ssubset_univ_iff.mpr hproper)
  exact mul_ne_nat_of_lt_den _ _ _ (card_pos.mpr hne) hlt

/-- All rational densities at least one admit this explicit strictly balanced
rooted tree. Strictness is vacuous when there is just one nonroot. -/
theorem exists_strictly_balanced_rooted_tree (ρ : ℚ) (hρ : 1 ≤ ρ) :
    ∃ k m : ℕ, (graph (leafCount k m)).IsTree ∧
      ρ = (Nat.card (graph (leafCount k m)).edgeSet : ℚ) / (k + 1) ∧
      k + 1 = ρ.den ∧
      ∀ S : Finset (Fin (k + 1)), S.Nonempty → S ≠ univ →
        ρ * S.card < ((incidentEdges (leafCount k m) S).card : ℚ) := by
  obtain ⟨k, m, hkm, hden⟩ := every_density_reduced ρ hρ
  refine ⟨k, m, isTree _, ?_, hden, ?_⟩
  · rw [← hkm]
    exact density_eq k m
  · intro S hne hproper
    rw [← hkm]
    apply strictly_balanced k m _ S hne hproper
    rw [hkm, hden]



/-- In the reduced-denominator construction, every nonempty proper-core power
has an extremal number growing faster than the target once its power is large
enough. Thus one cannot select such a core as the desired single witness. -/
theorem proper_core_eventually_not_isBigO (k m : ℕ)
    (hden : (1 + slope k m).den = k + 1)
    (C : Finset (Fin (k + 1))) (hne : C.Nonempty) (hproper : C ≠ univ) :
    ∃ P : ℕ, 2 ≤ P ∧ ∀ p : ℕ, P ≤ p →
      ¬ Asymptotics.IsBigO atTop
        (fun n : ℕ => (extremalNumber n
          (RootedSunflower.corePower (graph (leafCount k m)) C p) : ℝ))
        (fun n : ℕ => (n : ℝ) ^ (2 - ((1 + slope k m : ℚ) : ℝ)⁻¹)) := by
  classical
  let ρ : ℚ := 1 + slope k m
  let S : Finset (Fin (k + 1)) := univ \ C
  have hSc : S.card = Fintype.card (Fin (k + 1)) - C.card := by
    dsimp [S]
    rw [card_sdiff_of_subset (subset_univ C), card_univ]
  have hSne : S.Nonempty := by
    apply card_pos.mp
    rw [hSc]
    have hc : C.card < Fintype.card (Fin (k + 1)) := by
      simpa only [card_univ] using card_lt_card (ssubset_univ_iff.mpr hproper)
    omega
  have hSproper : S ≠ univ := by
    intro hS
    obtain ⟨x, hx⟩ := hne
    have hxS : x ∈ S := by rw [hS]; exact mem_univ _
    exact (mem_sdiff.mp hxS).2 hx
  have hρ : (0 : ℝ) < ρ := by
    have hρq : (0 : ℚ) < ρ := by dsimp [ρ]; have := slope_nonneg k m; linarith
    exact_mod_cast hρq
  have hstrict : (ρ : ℝ) * S.card < (incidentEdges (leafCount k m) S).card := by
    exact_mod_cast strictly_balanced k m hden S hSne hSproper
  have hpetal : Nat.card (RootedSunflower.PetalEdge (graph (leafCount k m)) C) =
      (incidentEdges (leafCount k m) S).card := by
    simp only [RootedSunflower.PetalEdge, Nat.card_eq_fintype_card, Fintype.card_subtype]
    congr 1
    ext e
    simp [incidentEdges, S]
  apply RootedSunflower.corePower_eventually_not_isBigO (graph (leafCount k m)) C hproper
    (2 - (ρ : ℝ)⁻¹)
  · have : (0 : ℝ) < (ρ : ℝ)⁻¹ := inv_pos.mpr hρ
    linarith
  · rw [← hSc, hpetal, sub_sub_cancel]
    calc
      (S.card : ℝ) < (incidentEdges (leafCount k m) S).card / (ρ : ℝ) :=
        (lt_div_iff₀ hρ).mpr (by nlinarith)
      _ = (ρ : ℝ)⁻¹ * (incidentEdges (leafCount k m) S).card := by ring


/-- There are finitely many cores, so one threshold works for all nonempty
proper cores simultaneously. -/
theorem all_proper_cores_eventually_not_isBigO (k m : ℕ)
    (hden : (1 + slope k m).den = k + 1) :
    ∃ P : ℕ, 2 ≤ P ∧ ∀ p : ℕ, P ≤ p →
      ∀ C : Finset (Fin (k + 1)), C.Nonempty → C ≠ univ →
      ¬ Asymptotics.IsBigO atTop
        (fun n : ℕ => (extremalNumber n
          (RootedSunflower.corePower (graph (leafCount k m)) C p) : ℝ))
        (fun n : ℕ => (n : ℝ) ^ (2 - ((1 + slope k m : ℚ) : ℝ)⁻¹)) := by
  classical
  have h : ∀ C : Finset (Fin (k + 1)), ∃ P : ℕ, ∀ p : ℕ, P ≤ p →
      C.Nonempty → C ≠ univ →
      ¬ Asymptotics.IsBigO atTop
        (fun n : ℕ => (extremalNumber n
          (RootedSunflower.corePower (graph (leafCount k m)) C p) : ℝ))
        (fun n : ℕ => (n : ℝ) ^ (2 - ((1 + slope k m : ℚ) : ℝ)⁻¹)) := by
    intro C
    by_cases hc : C.Nonempty ∧ C ≠ univ
    · obtain ⟨P, _, hP⟩ := proper_core_eventually_not_isBigO k m hden C hc.1 hc.2
      exact ⟨P, fun p hp _ _ => hP p hp⟩
    · exact ⟨0, fun _ _ hne hproper => (hc ⟨hne, hproper⟩).elim⟩
  choose P hP using h
  refine ⟨2 + (univ : Finset (Finset (Fin (k + 1)))).sup P, by omega, ?_⟩
  intro p hp C hne hproper
  apply hP C p _ hne hproper
  have hCP := Finset.le_sup (f := P) (mem_univ C)
  omega

/-- The power consists of disjoint copies of the nonroots, with all roots identified. -/
def power {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    SimpleGraph ((Fin p × Fin (k + 1)) ⊕ Leaf c) where
  Adj u v := match u, v with
    | .inl x, .inl y => x.1 = y.1 ∧ (pathGraph (k + 1)).Adj x.2 y.2
    | .inl x, .inr l => x.2 = l.1
    | .inr l, .inl x => l.1 = x.2
    | .inr _, .inr _ => False
  symm := by
    intro u v h
    cases u <;> cases v
    · exact ⟨h.1.symm, h.2.symm⟩
    · exact h.symm
    · exact h.symm
    · exact h
  loopless := by
    intro u
    cases u
    · exact fun h => (pathGraph _).loopless _ h.2
    · exact not_false

def projection {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) : power c p →g graph c where
  toFun := Sum.map Prod.snd id
  map_rel' := by
    intro u v h
    cases u <;> cases v
    · exact h.2
    · exact h
    · exact h
    · exact h

lemma power_bipartite {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    (power c p).IsBipartite :=
  Colorable.of_hom (projection c p) (isTree c).isBipartite

def powerEdge {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ)
    (t : Fin p × EdgeIndex c) : (power c p).edgeSet :=
  match t.2 with
  | .inl j => ⟨s(Sum.inl (t.1, j.castSucc), Sum.inl (t.1, j.succ)), by
      refine ⟨rfl, ?_⟩
      simp [pathGraph_adj]⟩
  | .inr l => ⟨s(Sum.inl (t.1, l.1), Sum.inr l), rfl⟩

lemma powerEdge_project {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ)
    (t : Fin p × EdgeIndex c) :
    (projection c p).mapEdgeSet (powerEdge c p t) = edge t.2 := by
  rcases t with ⟨i, e⟩
  cases e <;> rfl

lemma powerEdge_injective {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    Function.Injective (powerEdge c p) := by
  rintro ⟨i, e⟩ ⟨j, e'⟩ h
  have he := congrArg (projection c p).mapEdgeSet h
  rw [powerEdge_project, powerEdge_project] at he
  have he' := edge_injective he
  change e = e' at he'
  subst e'
  have hv := congrArg Subtype.val h
  suffices hij : i = j from congrArg (fun a => (a, e)) hij
  cases e with
  | inl a =>
    simp only [powerEdge, Sym2.eq_iff, Sum.inl.injEq, Prod.mk.injEq] at hv
    rcases hv with h | h
    · exact h.1.1
    · exact h.1.1
  | inr l =>
    simpa only [powerEdge, Sym2.eq_iff, Sum.inl.injEq, Prod.mk.injEq,
      and_true, Sum.inl_ne_inr, Sum.inr_ne_inl, false_and, or_false] using hv

lemma powerEdge_surjective {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    Function.Surjective (powerEdge c p) := by
  rintro ⟨e, he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl x =>
      cases v with
      | inl y =>
        obtain ⟨hxy, hpath⟩ := he
        rw [pathGraph_adj] at hpath
        rcases hpath with hnext | hprev
        · have hi : x.2.val < k := by omega
          refine ⟨(x.1, .inl ⟨x.2.val, hi⟩), ?_⟩
          apply Subtype.ext
          apply Sym2.eq_iff.mpr
          left
          exact ⟨congrArg Sum.inl (Prod.ext rfl (Fin.ext rfl)),
            congrArg Sum.inl (Prod.ext hxy (Fin.ext hnext))⟩
        · have hi : y.2.val < k := by omega
          refine ⟨(y.1, .inl ⟨y.2.val, hi⟩), ?_⟩
          apply Subtype.ext
          apply Sym2.eq_iff.mpr
          right
          exact ⟨congrArg Sum.inl (Prod.ext rfl (Fin.ext rfl)),
            congrArg Sum.inl (Prod.ext hxy.symm (Fin.ext hprev))⟩
      | inr l =>
        change x.2 = l.1 at he
        refine ⟨(x.1, .inr l), ?_⟩
        apply Subtype.ext
        apply Sym2.eq_iff.mpr
        exact Or.inl ⟨congrArg Sum.inl (Prod.ext rfl he.symm), rfl⟩
    | inr l =>
      cases v with
      | inl x =>
        change l.1 = x.2 at he
        refine ⟨(x.1, .inr l), ?_⟩
        apply Subtype.ext
        apply Sym2.eq_iff.mpr
        exact Or.inr ⟨congrArg Sum.inl (Prod.ext rfl he), rfl⟩
      | inr l' => exact he.elim

lemma power_card_edges {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    Nat.card (power c p).edgeSet = p * (k + ∑ i, c i) := by
  classical
  have h := Nat.card_congr (Equiv.ofBijective (powerEdge c p)
    ⟨powerEdge_injective c p, powerEdge_surjective c p⟩)
  simpa only [Nat.card_eq_fintype_card, Fintype.card_prod, Fintype.card_fin,
    EdgeIndex, Leaf, Fintype.card_sum, Fintype.card_sigma] using h.symm

lemma power_card_vertices {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    Fintype.card ((Fin p × Fin (k + 1)) ⊕ Leaf c) = p * (k + 1) + ∑ i, c i := by
  simp only [Fintype.card_sum, Fintype.card_prod, Fintype.card_fin,
    Leaf, Fintype.card_sigma]


/-- The explicit caterpillar power is an instance of the general rooted power. -/
lemma power_eq_rootedPacking {k : ℕ} (c : Fin (k + 1) → ℕ) (p : ℕ) :
    power c p = RootedPacking.power (graph c) p := by
  ext u v
  cases u <;> cases v <;> rfl

/-- A valid sufficient packing criterion for a copy of an explicit tree power. -/
theorem power_contained_of_bounded_load {k : ℕ} (c : Fin (k + 1) → ℕ)
    {I W : Type*} [DecidableEq I] [DecidableEq W]
    {G : SimpleGraph W} (F : Finset I) (f : I → (graph c).Copy G) (r : Leaf c ↪ W)
    (hroot : ∀ i ∈ F, ∀ l, f i (.inr l) = r l)
    (B p : ℕ) (hB : 0 < B)
    (hload : ∀ w, (F.filter (fun i => w ∈ RootedPacking.interior (f i))).card ≤ B)
    (hcard : p * (k + 1) * B ≤ F.card) : (power c p).IsContained G := by
  rw [power_eq_rootedPacking]
  exact RootedPacking.power_contained_of_bounded_load F f r hroot B p hB hload
    (by simpa only [Fintype.card_fin] using hcard)

/-- Power-freeness forces each rooted-copy family to have a bounded interior cover.
It does not bound the number of rooted copies. -/
theorem small_interior_cover_of_power_free {k : ℕ} (c : Fin (k + 1) → ℕ)
    {I W : Type*} [DecidableEq I] [DecidableEq W]
    {G : SimpleGraph W} (F : Finset I) (f : I → (graph c).Copy G) (r : Leaf c ↪ W)
    (p : ℕ) (hroot : ∀ i ∈ F, ∀ l, f i (.inr l) = r l)
    (hfree : (power c p).Free G) :
    ∃ U : Finset W, U.card ≤ (k + 1) * (p - 1) ∧
      ∀ i ∈ F, ∃ w ∈ RootedPacking.interior (f i), w ∈ U := by
  rw [power_eq_rootedPacking] at hfree
  simpa only [Fintype.card_fin] using
    RootedPacking.small_interior_cover_of_power_free F f r p hroot hfree

lemma card_roots (k m : ℕ) : Fintype.card (Leaf (leafCount k m)) = m + 1 := by
  simp only [Leaf, Fintype.card_sigma, Fintype.card_fin, sum_leafCount]

/-- The expected upper exponent holds for the family of all overlap patterns.
This is not an upper bound for forbidding only `power (leafCount k m) p`. -/
theorem root_family_edge_bound (k m p : ℕ)
    {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V)
    (hfree : ¬ TreeCount.CommonRootCopies (graph (leafCount k m)) G (p + 1)) :
    (G.edgeFinset.card : ℝ) ≤ (2 * (p + 1) + (k + m + 2)) *
      (Fintype.card V : ℝ) ^ ((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ) := by
  have hr : 0 < Fintype.card (Leaf (leafCount k m)) := by rw [card_roots]; omega
  letI : Nonempty (Leaf (leafCount k m)) := Fintype.card_pos_iff.mp hr
  have h := TreeCount.edge_bound_real (graph (leafCount k m)) (isTree _) p G hn hfree
  have ht : Fintype.card (Fin (k + 1) ⊕ Leaf (leafCount k m)) = k + m + 2 := by
    rw [Fintype.card_sum, Fintype.card_fin, card_roots]
    omega
  rw [ht, card_roots] at h
  simp only [Nat.add_sub_cancel, show k + m + 2 - 1 = k + m + 1 by omega] at h
  have he : (1 : ℝ) + (m : ℝ) / (k + m + 1) =
      ((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ) := by
    dsimp [slope]
    push_cast
    have hk : (k : ℝ) + 1 ≠ 0 := by positivity
    have hkm : (k : ℝ) + m + 1 ≠ 0 := by positivity
    have hpos : (1 : ℝ) + m / ((k : ℝ) + 1) ≠ 0 := by positivity
    field_simp
    ring
  push_cast at h
  rw [he] at h
  exact h

/-- Every requested exponent is an upper exponent for a finite family of rooted
configurations. Interior overlaps are allowed, so this does not settle the
single-forbidden-graph assertion. -/
theorem rational_root_family_upper (a : ℚ) (ha1 : 1 ≤ a) (ha2 : a < 2) :
    ∃ k m : ℕ, ∀ p : ℕ, ∃ C : ℝ, 0 < C ∧
      ∀ {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj],
        1 ≤ Fintype.card V →
        C * (Fintype.card V : ℝ) ^ (a : ℝ) < G.edgeFinset.card →
        TreeCount.CommonRootCopies (graph (leafCount k m)) G (p + 1) := by
  have hd : (0 : ℚ) < 2 - a := by linarith
  have hρ : (1 : ℚ) ≤ (2 - a)⁻¹ := (one_le_inv₀ hd).mpr (by linarith)
  obtain ⟨k, m, hkm⟩ := every_density ((2 - a)⁻¹) hρ
  have he : (2 : ℚ) - (1 + slope k m)⁻¹ = a := by rw [hkm, inv_inv]; ring
  refine ⟨k, m, fun p => ⟨2 * (p + 1) + (k + m + 2), by positivity, ?_⟩⟩
  intro V _ G _ hn hG
  by_contra hfree
  have h := root_family_edge_bound k m p G hn hfree
  rw [he] at h
  exact (not_lt_of_ge h) hG


/-- For every requested rational exponent, high density forces one graph from
an explicit finite family of proper-core powers of a balanced caterpillar. -/
theorem rational_core_family_upper (a : ℚ) (ha1 : 1 ≤ a) (ha2 : a < 2) :
    ∃ k m : ℕ, ∀ p : ℕ, 2 ≤ p → ∃ C : ℝ, 0 < C ∧
      ∀ {V : Type v} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj],
        1 ≤ Fintype.card V →
        C * (Fintype.card V : ℝ) ^ (a : ℝ) < G.edgeFinset.card →
        ∃ S : Finset (Fin (k + 1)), S ≠ univ ∧
          (RootedSunflower.corePower (graph (leafCount k m)) S p).IsContained G := by
  obtain ⟨k, m, hkm⟩ := rational_root_family_upper a ha1 ha2
  refine ⟨k, m, ?_⟩
  intro p hp
  obtain ⟨C, hC, hbound⟩ := hkm (RootedSunflower.bound (k + 1) p)
  refine ⟨C, hC, ?_⟩
  intro V _ G _ hn hG
  apply RootedSunflower.corePower_of_commonRootCopies hp
  simpa only [Fintype.card_fin] using hbound G hn hG

/-- The exponent obtained by elementary random deletion for a fixed tree power. -/
noncomputable def deletionExponent (k m p : ℕ) : ℝ :=
  2 - ((p : ℝ) * (k + 1) + m - 1) / ((p : ℝ) * (k + m + 1) - 1)

theorem power_random_lower (k m p : ℕ) (hp : 2 ≤ p) (n : ℕ) (hn : 2 ≤ n) :
    (n : ℝ) ^ deletionExponent k m p ≤
      64 * (extremalNumber n (power (leafCount k m) p) : ℝ) := by
  have hv : 2 ≤ Fintype.card ((Fin p × Fin (k + 1)) ⊕ Leaf (leafCount k m)) := by
    rw [power_card_vertices, sum_leafCount]
    nlinarith
  have he : 2 ≤ Nat.card (power (leafCount k m) p).edgeSet := by
    rw [power_card_edges, sum_leafCount]
    nlinarith
  have h := RandomDeletion.random_exponent_bound (power (leafCount k m) p) hv he n hn
  rw [power_card_vertices, power_card_edges, sum_leafCount] at h
  push_cast at h
  dsimp [deletionExponent]
  convert h using 1
  congr 1
  ring

/-- The exact gap between the target exponent and the elementary deletion estimate. -/
theorem deletion_exponent_gap (k m p : ℕ) (hp : 2 ≤ p) :
    ((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ) - deletionExponent k m p =
      (m : ℝ) * (k + m) / ((k + m + 1) * ((p : ℝ) * (k + m + 1) - 1)) := by
  have hp' : (2 : ℝ) ≤ p := by exact_mod_cast hp
  have hk : (k : ℝ) + 1 ≠ 0 := by positivity
  have hB : (k : ℝ) + m + 1 ≠ 0 := by positivity
  have hpos : (1 : ℝ) + m / ((k : ℝ) + 1) ≠ 0 := by positivity
  have hd : (p : ℝ) * (k + m + 1) - 1 ≠ 0 := by
    have : (0 : ℝ) ≤ (p : ℝ) * (k + m) := by positivity
    nlinarith
  dsimp [slope, deletionExponent]
  push_cast
  field_simp
  ring

/-- For every nontrivial target exponent this particular deletion bound is strictly weaker. -/
theorem deletion_exponent_lt_target (k m p : ℕ) (hm : 0 < m) (hp : 2 ≤ p) :
    deletionExponent k m p < ((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ) := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hp' : (2 : ℝ) ≤ p := by exact_mod_cast hp
  have hd : (0 : ℝ) < (p : ℝ) * (k + m + 1) - 1 := by
    have : (0 : ℝ) ≤ (p : ℝ) * (k + m) := by positivity
    nlinarith
  have hgap : (0 : ℝ) < (m : ℝ) * (k + m) /
      ((k + m + 1) * ((p : ℝ) * (k + m + 1) - 1)) := by positivity
  rw [← deletion_exponent_gap k m p hp] at hgap
  linarith

/-- The deletion exponents approach the target, although no fixed nontrivial power
attains it by this estimate. -/
theorem deletion_exponent_approx (k m : ℕ) (ε : ℝ) (hε : 0 < ε) :
    ∃ p : ℕ, 2 ≤ p ∧
      ((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ) - ε < deletionExponent k m p := by
  let N : ℝ := (m : ℝ) * (k + m)
  have hN : 0 ≤ N := by dsimp [N]; positivity
  obtain ⟨p, hp⟩ := exists_nat_gt (N / ε + 2)
  have hp' : (2 : ℝ) < p := by have : 0 ≤ N / ε := div_nonneg hN hε.le; linarith
  have hp2 : 2 ≤ p := by exact_mod_cast hp'.le
  have hB : (1 : ℝ) ≤ k + m + 1 := by
    have : (0 : ℝ) ≤ (k : ℝ) + m := by positivity
    linarith
  have hPB : (p : ℝ) - 1 ≤ (p : ℝ) * (k + m + 1) - 1 := by
    have hh := mul_le_mul_of_nonneg_left hB (Nat.cast_nonneg p)
    linarith
  have hden : (p : ℝ) - 1 ≤ (k + m + 1) * ((p : ℝ) * (k + m + 1) - 1) := by
    have hQ : (0 : ℝ) ≤ (p : ℝ) * (k + m + 1) - 1 := by linarith
    have hh := mul_le_mul_of_nonneg_right hB hQ
    nlinarith
  have hden0 : (0 : ℝ) < (k + m + 1) * ((p : ℝ) * (k + m + 1) - 1) := by linarith
  have hsmall : N < ε * ((p : ℝ) - 1) := by
    have hh : N / ε < (p : ℝ) - 2 := by linarith
    have hh' := (div_lt_iff₀ hε).mp hh
    nlinarith
  have hfrac : N / ((k + m + 1) * ((p : ℝ) * (k + m + 1) - 1)) < ε := by
    apply (div_lt_iff₀ hden0).mpr
    exact hsmall.trans_le (mul_le_mul_of_nonneg_left hden hε.le)
  change (m : ℝ) * (k + m) /
    ((k + m + 1) * ((p : ℝ) * (k + m + 1) - 1)) < ε at hfrac
  rw [← deletion_exponent_gap k m p hp2] at hfrac
  exact ⟨p, hp2, by linarith⟩

/-- A fixed power supplies each slightly smaller lower exponent. The power may
depend on `ε`; this quantifier order does not supply the target lower bound. -/
theorem power_lower_near_target (k m : ℕ) (ε : ℝ) (hε : 0 < ε) :
    ∃ p : ℕ, 2 ≤ p ∧ ∀ n : ℕ, 2 ≤ n →
      (n : ℝ) ^ (((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ) - ε) ≤
        64 * (extremalNumber n (power (leafCount k m) p) : ℝ) := by
  obtain ⟨p, hp, happrox⟩ := deletion_exponent_approx k m ε hε
  refine ⟨p, hp, fun n hn => ?_⟩
  apply le_trans _ (power_random_lower k m p hp n hn)
  exact Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast (by omega : 1 ≤ n)) happrox.le

/-- A sufficient extremal-bound hypothesis for this explicit family. The hypothesis
is not proved here; balancedness alone does not supply it. -/
theorem rational_turan_of_power_bounds
    (hbound : ∀ k m : ℕ, ∃ p : ℕ,
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n (power (leafCount k m) p) : ℝ))
        (fun n : ℕ => (n : ℝ) ^ ((2 - (1 + slope k m)⁻¹ : ℚ) : ℝ))) :
    ∀ a : ℚ, 1 ≤ a → a < 2 →
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        Asymptotics.IsTheta Filter.atTop
          (fun n : ℕ => (extremalNumber n G : ℝ))
          (fun n : ℕ => (n : ℝ) ^ (a : ℝ)) := by
  intro a ha1 ha2
  have hd : (0 : ℚ) < 2 - a := by linarith
  have hρ : (1 : ℚ) ≤ (2 - a)⁻¹ := (one_le_inv₀ hd).mpr (by linarith)
  obtain ⟨k, m, hkm⟩ := every_density ((2 - a)⁻¹) hρ
  obtain ⟨p, hp⟩ := hbound k m
  have he : (2 : ℚ) - (1 + slope k m)⁻¹ = a := by rw [hkm, inv_inv]; ring
  rw [he] at hp
  let T := power (leafCount k m) p
  let e := Fintype.equivFin ((Fin p × Fin (k + 1)) ⊕ Leaf (leafCount k m))
  refine ⟨_, T.map e.toEmbedding, (power_bipartite _ _).map e.toEmbedding, ?_⟩
  have heq : (fun n : ℕ => (extremalNumber n (T.map e.toEmbedding) : ℝ)) =
      (fun n : ℕ => (extremalNumber n T : ℝ)) := by
    funext n
    rw [← extremalNumber_congr_right (SimpleGraph.Iso.map e T)]
  rw [heq]
  exact hp

end BalancedTree

/- A verified overlap-elimination lemma for the six-cycle case. -/

namespace BipartiteCycleExtraction

variable {L R : Type*} [DecidableEq L] [DecidableEq R]

def NoFour (E : Finset (L × R)) : Prop :=
  ∀ a b x y, a ≠ b → x ≠ y → (a, x) ∈ E → (b, x) ∈ E →
    (b, y) ∈ E → (a, y) ∈ E → False

def NoSix (E : Finset (L × R)) : Prop :=
  ∀ a b c x y z, a ≠ b → b ≠ c → c ≠ a → x ≠ y → y ≠ z → z ≠ x →
    (a, x) ∈ E → (b, x) ∈ E → (b, y) ∈ E → (c, y) ∈ E →
    (c, z) ∈ E → (a, z) ∈ E → False

structure MaxBiclique (E : Finset (L × R)) (A : Finset L) (B : Finset R) : Prop where
  complete : A ×ˢ B ⊆ E
  left_card : 2 ≤ A.card
  right_card : 2 ≤ B.card
  left_max : ∀ a, (∀ b ∈ B, (a, b) ∈ E) → a ∈ A
  right_max : ∀ b, (∀ a ∈ A, (a, b) ∈ E) → b ∈ B

omit [DecidableEq L] [DecidableEq R] in
lemma NoSix.mono {E F : Finset (L × R)} (h : NoSix E) (hFE : F ⊆ E) : NoSix F := by
  intro a b c x y z hab hbc hca hxy hyz hzx hax hbx hby hcy hcz haz
  exact h a b c x y z hab hbc hca hxy hyz hzx
    (hFE hax) (hFE hbx) (hFE hby) (hFE hcy) (hFE hcz) (hFE haz)

lemma NoSix.transpose {E : Finset (L × R)} (h : NoSix E) :
    NoSix (E.image Prod.swap) := by
  intro x y z a b c hxy hyz hzx hab hbc hca hxa hya hyb hzb hzc hxc
  have hs : ∀ r l, (r, l) ∈ E.image Prod.swap ↔ (l, r) ∈ E := by
    intro r l
    simp only [mem_image]
    constructor
    · rintro ⟨⟨u, v⟩, huv, he⟩
      cases he
      exact huv
    · intro h
      exact ⟨(l, r), h, rfl⟩
  exact h a b c y z x hab hbc hca hyz hzx hxy
    ((hs y a).mp hya) ((hs y b).mp hyb) ((hs z b).mp hzb)
    ((hs z c).mp hzc) ((hs x c).mp hxc) ((hs x a).mp hxa)

lemma MaxBiclique.transpose {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h : MaxBiclique E A B) : MaxBiclique (E.image Prod.swap) B A := by
  have hs : ∀ r l, (r, l) ∈ E.image Prod.swap ↔ (l, r) ∈ E := by
    intro r l
    simp only [mem_image]
    constructor
    · rintro ⟨⟨u, v⟩, huv, he⟩
      cases he
      exact huv
    · intro h
      exact ⟨(l, r), h, rfl⟩
  refine ⟨?_, h.right_card, h.left_card, ?_, ?_⟩
  · intro e he
    obtain ⟨b, a⟩ := e
    exact (hs b a).mpr (h.complete (by simpa [and_comm] using he))
  · intro b hb
    exact h.right_max b (fun a ha => (hs b a).mp (hb a ha))
  · intro a ha
    exact h.left_max a (fun b hb => (hs b a).mp (ha b hb))

/-- Two vertices of one side of a maximal biclique have no extra common neighbor. -/
lemma common_right {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h6 : NoSix E) (hM : MaxBiclique E A B)
    {a c : L} (ha : a ∈ A) (hc : c ∈ A) (hac : a ≠ c)
    {y : R} (hay : (a, y) ∈ E) (hcy : (c, y) ∈ E) : y ∈ B := by
  by_contra hy
  obtain ⟨x, hx, z, hz, hxz⟩ := Finset.one_lt_card.mp (by have := hM.right_card; omega : 1 < B.card)
  apply hy
  apply hM.right_max
  intro b hb
  by_cases hba : b = a
  · simpa [hba] using hay
  by_cases hbc : b = c
  · simpa [hbc] using hcy
  have hyx : y ≠ x := fun h => hy (h ▸ hx)
  have hzy : z ≠ y := fun h => hy (h ▸ hz)
  exact False.elim (h6 a c b y x z hac (Ne.symm hbc) hba hyx hxz hzy
    hay hcy (hM.complete (by simp [hc, hx])) (hM.complete (by simp [hb, hx]))
    (hM.complete (by simp [hb, hz])) (hM.complete (by simp [ha, hz])))

lemma common_left {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h6 : NoSix E) (hM : MaxBiclique E A B)
    {x y : R} (hx : x ∈ B) (hy : y ∈ B) (hxy : x ≠ y)
    {c : L} (hcx : (c, x) ∈ E) (hcy : (c, y) ∈ E) : c ∈ A := by
  apply common_right h6.transpose hM.transpose hx hy hxy
  · exact mem_image.mpr ⟨(c, x), hcx, rfl⟩
  · exact mem_image.mpr ⟨(c, y), hcy, rfl⟩

/-- Every four-cycle sharing an edge with a maximal biclique lies in that biclique. -/
lemma four_closed {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h6 : NoSix E) (hM : MaxBiclique E A B)
    {a c : L} {x y : R} (ha : a ∈ A) (hx : x ∈ B)
    (hac : a ≠ c) (hxy : x ≠ y)
    (hcx : (c, x) ∈ E) (hcy : (c, y) ∈ E) (hay : (a, y) ∈ E) :
    c ∈ A ∧ y ∈ B := by
  by_cases hc : c ∈ A
  · exact ⟨hc, common_right h6 hM ha hc hac hay hcy⟩
  by_cases hy : y ∈ B
  · exact ⟨common_left h6 hM hx hy hxy hcx hcy, hy⟩
  obtain ⟨b, hb, hba⟩ := Finset.exists_mem_ne (by have := hM.left_card; omega : 1 < A.card) a
  obtain ⟨z, hz, hzx⟩ := Finset.exists_mem_ne (by have := hM.right_card; omega : 1 < B.card) x
  have hcb : c ≠ b := fun h => hc (h ▸ hb)
  have hyx : y ≠ x := hxy.symm
  have hzy : z ≠ y := fun h => hy (h ▸ hz)
  exact False.elim (h6 a c b y x z hac hcb hba hyx hzx.symm hzy
    hay hcy hcx (hM.complete (by simp [hb, hx]))
    (hM.complete (by simp [hb, hz])) (hM.complete (by simp [ha, hz])))

omit [DecidableEq L] [DecidableEq R] in
lemma small_side {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h6 : NoSix E) (hM : MaxBiclique E A B) : A.card = 2 ∨ B.card = 2 := by
  by_contra h
  push_neg at h
  have ha3 : 2 < A.card := by have := hM.left_card; omega
  have hb3 : 2 < B.card := by have := hM.right_card; omega
  obtain ⟨a, ha, b, hb, c, hc, hab, hac, hbc⟩ := Finset.two_lt_card.mp ha3
  obtain ⟨x, hx, y, hy, z, hz, hxy, hxz, hyz⟩ := Finset.two_lt_card.mp hb3
  exact h6 a b c x y z hab hbc hac.symm hxy hyz hxz.symm
    (hM.complete (by simp [ha, hx])) (hM.complete (by simp [hb, hx]))
    (hM.complete (by simp [hb, hy])) (hM.complete (by simp [hc, hy]))
    (hM.complete (by simp [hc, hz])) (hM.complete (by simp [ha, hz]))

lemma exists_maxBiclique [Fintype L] [Fintype R] {E : Finset (L × R)} (h : ¬ NoFour E) :
    ∃ A B, MaxBiclique E A B := by
  classical
  unfold NoFour at h
  push_neg at h
  obtain ⟨a, b, x, y, hab, hxy, hax, hbx, hby, hay, _⟩ := h
  let S : Finset (Finset L × Finset R) := univ.filter fun P =>
    2 ≤ P.1.card ∧ 2 ≤ P.2.card ∧ P.1 ×ˢ P.2 ⊆ E
  have hS : S.Nonempty := by
    refine ⟨({a, b}, {x, y}), ?_⟩
    simp only [S, mem_filter, mem_univ, true_and]
    refine ⟨by simp [hab], by simp [hxy], ?_⟩
    rintro ⟨u, v⟩ huv
    simp only [mem_product, mem_insert, mem_singleton] at huv
    rcases huv with ⟨rfl | rfl, rfl | rfl⟩ <;> assumption
  obtain ⟨⟨A, B⟩, hAB, hmax⟩ := exists_max_image S (fun P => P.1.card + P.2.card) hS
  simp only [S, mem_filter, mem_univ, true_and] at hAB
  refine ⟨A, B, hAB.2.2, hAB.1, hAB.2.1, ?_, ?_⟩
  · intro u hu
    by_contra huA
    have hnew : (insert u A, B) ∈ S := by
      simp only [S, mem_filter, mem_univ, true_and]
      refine ⟨hAB.1.trans (card_le_card (subset_insert _ _)), hAB.2.1, ?_⟩
      rintro ⟨v, z⟩ hvz
      rcases mem_product.mp hvz with ⟨hv, hz⟩
      rcases mem_insert.mp hv with rfl | hv
      · exact hu z hz
      · exact hAB.2.2 (mem_product.mpr ⟨hv, hz⟩)
    have hh := hmax (insert u A, B) hnew
    simp only [card_insert_of_notMem huA] at hh
    omega
  · intro v hv
    by_contra hvB
    have hnew : (A, insert v B) ∈ S := by
      simp only [S, mem_filter, mem_univ, true_and]
      refine ⟨hAB.1, hAB.2.1.trans (card_le_card (subset_insert _ _)), ?_⟩
      rintro ⟨u, z⟩ huz
      rcases mem_product.mp huz with ⟨hu, hz⟩
      rcases mem_insert.mp hz with rfl | hz
      · exact hv u hu
      · exact hAB.2.2 (mem_product.mpr ⟨hu, hz⟩)
    have hh := hmax (A, insert v B) hnew
    simp only [card_insert_of_notMem hvB] at hh
    omega

omit [DecidableEq L] [DecidableEq R] in
lemma thin_biclique {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h6 : NoSix E) (hM : MaxBiclique E A B) :
    ∃ D : Finset (L × R), D ⊆ A ×ˢ B ∧ NoFour D ∧ (A ×ˢ B).card ≤ 2 * D.card := by
  rcases small_side h6 hM with hA | hB
  · obtain ⟨a, ha⟩ := card_pos.mp (by omega : 0 < A.card)
    refine ⟨{a} ×ˢ B, ?_, ?_, ?_⟩
    · exact product_subset_product (singleton_subset_iff.mpr ha) subset_rfl
    · intro u v x y huv hxy hux hvx hvy huy
      have hu : u = a := by simpa using (mem_product.mp hux).1
      have hv : v = a := by simpa using (mem_product.mp hvx).1
      exact huv (hu.trans hv.symm)
    · simp [card_product, hA]
  · obtain ⟨b, hb⟩ := card_pos.mp (by omega : 0 < B.card)
    refine ⟨A ×ˢ {b}, ?_, ?_, ?_⟩
    · exact product_subset_product subset_rfl (singleton_subset_iff.mpr hb)
    · intro u v x y huv hxy hux hvx hvy huy
      have hx : x = b := by simpa using (mem_product.mp hux).2
      have hy : y = b := by simpa using (mem_product.mp huy).2
      exact hxy (hx.trans hy.symm)
    · simp [card_product, hB, mul_comm]

lemma patch_noFour {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (h6 : NoSix E) (hM : MaxBiclique E A B)
    {F D : Finset (L × R)} (hF : F ⊆ E \ (A ×ˢ B)) (hF4 : NoFour F)
    (hD : D ⊆ A ×ˢ B) (hD4 : NoFour D) : NoFour (F ∪ D) := by
  have hUE : F ∪ D ⊆ E := union_subset (hF.trans sdiff_subset) (hD.trans hM.complete)
  have hUD : ∀ e, e ∈ F ∪ D → e ∈ A ×ˢ B → e ∈ D := by
    intro e he hAB
    rcases mem_union.mp he with he | he
    · exact False.elim ((mem_sdiff.mp (hF he)).2 hAB)
    · exact he
  have corner : ∀ a b x y, a ≠ b → x ≠ y →
      (a, x) ∈ F ∪ D → (b, x) ∈ F ∪ D → (b, y) ∈ F ∪ D → (a, y) ∈ F ∪ D →
      (a, x) ∈ D → False := by
    intro a b x y hab hxy hax hbx hby hay haxD
    obtain ⟨ha, hx⟩ := mem_product.mp (hD haxD)
    obtain ⟨hb, hy⟩ := four_closed h6 hM ha hx hab hxy (hUE hbx) (hUE hby) (hUE hay)
    exact hD4 a b x y hab hxy haxD (hUD _ hbx (mem_product.mpr ⟨hb, hx⟩))
      (hUD _ hby (mem_product.mpr ⟨hb, hy⟩)) (hUD _ hay (mem_product.mpr ⟨ha, hy⟩))
  intro a b x y hab hxy hax hbx hby hay
  rcases mem_union.mp hax with haxF | haxD
  swap
  · exact corner a b x y hab hxy hax hbx hby hay haxD
  rcases mem_union.mp hbx with hbxF | hbxD
  swap
  · exact corner b a x y hab.symm hxy hbx hax hay hby hbxD
  rcases mem_union.mp hby with hbyF | hbyD
  swap
  · exact corner b a y x hab.symm hxy.symm hby hay hax hbx hbyD
  rcases mem_union.mp hay with hayF | hayD
  · exact hF4 a b x y hab hxy haxF hbxF hbyF hayF
  · exact corner a b y x hab hxy.symm hay hby hbx hax hayD

/-- At least half the edges of a six-cycle-free bipartite relation can be retained
while removing every four-cycle. -/
theorem exists_noFour_half [Fintype L] [Fintype R] (E : Finset (L × R)) (h6 : NoSix E) :
    ∃ F ⊆ E, NoFour F ∧ E.card ≤ 2 * F.card := by
  generalize hn : E.card = n
  induction n using Nat.strong_induction_on generalizing E with
  | h n ih =>
    by_cases h4 : NoFour E
    · exact ⟨E, subset_rfl, h4, by omega⟩
    obtain ⟨A, B, hM⟩ := exists_maxBiclique h4
    obtain ⟨D, hD, hD4, hDc⟩ := thin_biclique h6 hM
    have hABpos : 0 < (A ×ˢ B).card := by
      rw [card_product]
      have := hM.left_card
      have := hM.right_card
      positivity
    have hcard : (E \ (A ×ˢ B)).card + (A ×ˢ B).card = E.card := by
      exact card_sdiff_add_card_eq_card hM.complete
    have hlt : (E \ (A ×ˢ B)).card < n := by omega
    obtain ⟨F, hF, hF4, hFc⟩ := ih _ hlt (E \ (A ×ˢ B)) (h6.mono sdiff_subset) rfl
    refine ⟨F ∪ D, union_subset (hF.trans sdiff_subset) (hD.trans hM.complete),
      patch_noFour h6 hM hF hF4 hD hD4, ?_⟩
    have hdis : Disjoint F D := by
      apply Finset.disjoint_left.mpr
      intro e heF heD
      exact (mem_sdiff.mp (hF heF)).2 (hD heD)
    rw [card_union_of_disjoint hdis]
    omega

end BipartiteCycleExtraction

namespace BipartiteCycleBounds

open BipartiteCycleExtraction

variable {L R : Type*} [DecidableEq L] [DecidableEq R]

def nr (E : Finset (L × R)) (B : Finset R) (a : L) : Finset R :=
  B.filter fun b => (a, b) ∈ E

def nl (E : Finset (L × R)) (A : Finset L) (b : R) : Finset L :=
  A.filter fun a => (a, b) ∈ E

def paths (E : Finset (L × R)) (A : Finset L) (B : Finset R) (a : L) :
    Finset (Σ _ : R, Σ _ : L, R) :=
  (nr E B a).sigma fun x => ((nl E A x).erase a).sigma fun b => (nr E B b).erase x

lemma mem_paths {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L}
    (t : Σ _ : R, Σ _ : L, R) :
    t ∈ paths E A B a ↔
      t.1 ∈ B ∧ t.2.1 ∈ A ∧ t.2.2 ∈ B ∧ t.2.1 ≠ a ∧ t.2.2 ≠ t.1 ∧
      (a, t.1) ∈ E ∧ (t.2.1, t.1) ∈ E ∧ (t.2.1, t.2.2) ∈ E := by
  simp only [paths, mem_sigma, mem_erase, nr, nl, mem_filter]
  tauto

omit [DecidableEq L] [DecidableEq R] in
lemma path_unique {E : Finset (L × R)} (h4 : NoFour E) (h6 : NoSix E)
    {a b c : L} {x y z : R} (hba : b ≠ a) (hca : c ≠ a)
    (hyx : y ≠ x) (hyz : y ≠ z)
    (hax : (a, x) ∈ E) (hbx : (b, x) ∈ E) (hby : (b, y) ∈ E)
    (haz : (a, z) ∈ E) (hcz : (c, z) ∈ E) (hcy : (c, y) ∈ E) :
    b = c ∧ x = z := by
  by_cases hbc : b = c
  · refine ⟨hbc, ?_⟩
    by_contra hxz
    exact h4 a b x z hba.symm hxz hax hbx (hbc ▸ hcz) haz
  by_cases hxz : x = z
  · exact False.elim (h4 b c x y hbc hyx.symm hbx (hxz ▸ hcz) hcy hby)
  exact False.elim (h6 a b c x y z hba.symm hbc hca hyx.symm hyz (Ne.symm hxz)
    hax hbx hby hcy hcz haz)

lemma paths_card_le {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L}
    (h4 : NoFour E) (h6 : NoSix E) : (paths E A B a).card ≤ B.card := by
  apply card_le_card_of_injOn (fun t => t.2.2)
  · intro t ht
    exact ((mem_paths t).mp ht).2.2.1
  · intro t ht u hu htu
    rcases t with ⟨x, b, y⟩
    rcases u with ⟨z, c, w⟩
    dsimp only at htu
    subst w
    rcases (mem_paths _).mp ht with ⟨hxB, hbA, hyB, hba, hyx, hax, hbx, hby⟩
    rcases (mem_paths _).mp hu with ⟨hzB, hcA, _, hca, hyz, haz, hcz, hcy⟩
    obtain ⟨rfl, rfl⟩ := path_unique h4 h6 hba hca hyx hyz hax hbx hby haz hcz hcy
    rfl

lemma paths_card_ge {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L}
    (ha : a ∈ A) (d : ℕ)
    (hdL : ∀ a ∈ A, d ≤ (nr E B a).card) (hdR : ∀ b ∈ B, d ≤ (nl E A b).card) :
    d * (d - 1) ^ 2 ≤ (paths E A B a).card := by
  rw [paths, card_sigma]
  have hinner : ∀ x ∈ nr E B a,
      (d - 1) ^ 2 ≤ (((nl E A x).erase a).sigma fun b => (nr E B b).erase x).card := by
    intro x hx
    have hxB := (mem_filter.mp hx).1
    have hn : d - 1 ≤ ((nl E A x).erase a).card :=
      (Nat.sub_le_sub_right (hdR x hxB) 1).trans (pred_card_le_card_erase)
    rw [card_sigma]
    calc
      (d - 1) ^ 2 ≤ ((nl E A x).erase a).card * (d - 1) := by
        rw [pow_two]
        exact Nat.mul_le_mul_right _ hn
      _ = ∑ b ∈ (nl E A x).erase a, (d - 1) := by simp
      _ ≤ ∑ b ∈ (nl E A x).erase a, ((nr E B b).erase x).card := by
        apply sum_le_sum
        intro b hb
        have hbA := (mem_filter.mp (mem_erase.mp hb).2).1
        exact (Nat.sub_le_sub_right (hdL b hbA) 1).trans pred_card_le_card_erase
  calc
    d * (d - 1) ^ 2 ≤ (nr E B a).card * (d - 1) ^ 2 := Nat.mul_le_mul_right _ (hdL a ha)
    _ = ∑ x ∈ nr E B a, (d - 1) ^ 2 := by simp
    _ ≤ _ := sum_le_sum hinner

/-- The Moore-type bound in the absence of four- and six-cycles. -/
theorem min_degree_bound {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L}
    (h4 : NoFour E) (h6 : NoSix E) (ha : a ∈ A) (d : ℕ)
    (hdL : ∀ a ∈ A, d ≤ (nr E B a).card) (hdR : ∀ b ∈ B, d ≤ (nl E A b).card) :
    d * (d - 1) ^ 2 ≤ B.card :=
  (paths_card_ge ha d hdL hdR).trans (paths_card_le h4 h6)

omit [DecidableEq L] [DecidableEq R] in
lemma noFour_mono {E F : Finset (L × R)} (h : NoFour E) (hFE : F ⊆ E) : NoFour F := by
  intro a b x y hab hxy hax hbx hby hay
  exact h a b x y hab hxy (hFE hax) (hFE hbx) (hFE hby) (hFE hay)

lemma delete_left_card {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) (a : L) :
    (E.filter fun e => e.1 ≠ a).card + (nr E B a).card = E.card := by
  have heq : (E.filter fun e => e.1 = a).card = (nr E B a).card := by
    apply card_bij (fun e _ => e.2)
    · rintro ⟨u, v⟩ he
      rcases mem_filter.mp he with ⟨he, hua⟩
      dsimp at hua
      subst u
      exact mem_filter.mpr ⟨(mem_product.mp (hE he)).2, he⟩
    · intro e he f hf hh
      apply Prod.ext
      · exact (mem_filter.mp he).2.trans (mem_filter.mp hf).2.symm
      · exact hh
    · intro b hb
      exact ⟨(a, b), mem_filter.mpr ⟨(mem_filter.mp hb).2, rfl⟩, rfl⟩
  have h := card_filter_add_card_filter_not (s := E) (fun e => e.1 = a)
  rw [heq] at h
  simpa only [ne_eq, add_comm] using h

lemma delete_right_card {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) (b : R) :
    (E.filter fun e => e.2 ≠ b).card + (nl E A b).card = E.card := by
  have heq : (E.filter fun e => e.2 = b).card = (nl E A b).card := by
    apply card_bij (fun e _ => e.1)
    · rintro ⟨u, v⟩ he
      rcases mem_filter.mp he with ⟨he, hvb⟩
      dsimp at hvb
      subst v
      exact mem_filter.mpr ⟨(mem_product.mp (hE he)).1, he⟩
    · intro e he f hf hh
      apply Prod.ext
      · exact hh
      · exact (mem_filter.mp he).2.trans (mem_filter.mp hf).2.symm
    · intro a ha
      exact ⟨(a, b), mem_filter.mpr ⟨(mem_filter.mp ha).2, rfl⟩, rfl⟩
  have h := card_filter_add_card_filter_not (s := E) (fun e => e.2 = b)
  rw [heq] at h
  simpa only [ne_eq, add_comm] using h

/-- A quantitative edge bound obtained by peeling low-degree vertices. -/
theorem edge_bound_noFour_noSix (N d : ℕ) (hd : N < d * (d - 1) ^ 2)
    {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hsize : A.card + B.card ≤ N) (hE : E ⊆ A ×ˢ B)
    (h4 : NoFour E) (h6 : NoSix E) : E.card ≤ (d - 1) * (A.card + B.card) := by
  have haux : ∀ n : ℕ, ∀ A : Finset L, ∀ B : Finset R, ∀ E : Finset (L × R),
      A.card + B.card = n → n ≤ N → E ⊆ A ×ˢ B → NoFour E → NoSix E →
      E.card ≤ (d - 1) * n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro A B E hn hN hE h4 h6
      by_cases ha : A.Nonempty
      swap
      · have hA : A = ∅ := not_nonempty_iff_eq_empty.mp ha
        have hE0 : E = ∅ := subset_empty.mp (by simpa [hA] using hE)
        simp [hE0]
      obtain ⟨a, ha⟩ := ha
      have hlow : (∃ a ∈ A, (nr E B a).card < d) ∨ (∃ b ∈ B, (nl E A b).card < d) := by
        by_contra! hh
        have hc := min_degree_bound h4 h6 ha d hh.1 hh.2
        omega
      rcases hlow with ⟨u, hu, hdu⟩ | ⟨v, hv, hdv⟩
      · let E' := E.filter fun e => e.1 ≠ u
        have hE'E : E' ⊆ E := filter_subset _ _
        have hE' : E' ⊆ A.erase u ×ˢ B := by
          rintro ⟨w, z⟩ hwz
          rcases mem_filter.mp hwz with ⟨he, hwu⟩
          rcases mem_product.mp (hE he) with ⟨hw, hz⟩
          exact mem_product.mpr ⟨mem_erase.mpr ⟨hwu, hw⟩, hz⟩
        have hcA := card_erase_add_one hu
        have hlt : (A.erase u).card + B.card < n := by omega
        have hi := ih _ hlt (A.erase u) B E' rfl (by omega) hE'
          (noFour_mono h4 hE'E) (h6.mono hE'E)
        have hcE := delete_left_card hE u
        change E'.card + (nr E B u).card = E.card at hcE
        have hdu' : (nr E B u).card ≤ d - 1 := by omega
        nlinarith
      · let E' := E.filter fun e => e.2 ≠ v
        have hE'E : E' ⊆ E := filter_subset _ _
        have hE' : E' ⊆ A ×ˢ B.erase v := by
          rintro ⟨w, z⟩ hwz
          rcases mem_filter.mp hwz with ⟨he, hzv⟩
          rcases mem_product.mp (hE he) with ⟨hw, hz⟩
          exact mem_product.mpr ⟨hw, mem_erase.mpr ⟨hzv, hz⟩⟩
        have hcB := card_erase_add_one hv
        have hlt : A.card + (B.erase v).card < n := by omega
        have hi := ih _ hlt A (B.erase v) E' rfl (by omega) hE'
          (noFour_mono h4 hE'E) (h6.mono hE'E)
        have hcE := delete_right_card hE v
        change E'.card + (nl E A v).card = E.card at hcE
        have hdv' : (nl E A v).card ≤ d - 1 := by omega
        nlinarith
  exact haux _ A B E rfl hsize hE h4 h6

/-- A six-cycle-free bipartite relation satisfies the cubic-threshold edge bound. -/
theorem edge_bound_noSix [Fintype L] [Fintype R] (N d : ℕ) (hd : N < d * (d - 1) ^ 2)
    {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hsize : A.card + B.card ≤ N) (hE : E ⊆ A ×ˢ B) (h6 : NoSix E) :
    E.card ≤ 2 * (d - 1) * (A.card + B.card) := by
  obtain ⟨F, hFE, hF4, hFc⟩ := exists_noFour_half E h6
  have hF := edge_bound_noFour_noSix N d hd hsize (hFE.trans hE) hF4 (h6.mono hFE)
  nlinarith

/-- The cubic threshold gives the standard four-thirds power bound. -/
theorem edge_bound_real [Fintype L] [Fintype R] (N : ℕ) (hN : 1 ≤ N)
    {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hsize : A.card + B.card ≤ N) (hE : E ⊆ A ×ˢ B) (h6 : NoSix E) :
    (E.card : ℝ) ≤ 6 * (N : ℝ) ^ ((4 : ℝ) / 3) := by
  let r : ℝ := (N : ℝ) ^ ((1 : ℝ) / 3)
  let c : ℕ := ⌈r⌉₊
  have hr0 : 0 ≤ r := Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hr1 : 1 ≤ r := Real.one_le_rpow (by exact_mod_cast hN) (by norm_num)
  have hr3 : r ^ 3 = N := by
    dsimp [r]
    rw [← Real.rpow_mul_natCast (Nat.cast_nonneg N)]
    norm_num
  have hc : r ≤ (c : ℝ) := Nat.le_ceil r
  have hcN : N ≤ c ^ 3 := by
    have h := pow_le_pow_left₀ hr0 hc 3
    rw [hr3] at h
    exact_mod_cast h
  have hth : N < (c + 2) * (c + 2 - 1) ^ 2 := by
    have : c ^ 3 < (c + 2) * (c + 1) ^ 2 := by nlinarith
    have he : c + 2 - 1 = c + 1 := by omega
    rw [he]
    omega
  have hbound := edge_bound_noSix N (c + 2) hth hsize hE h6
  have he : c + 2 - 1 = c + 1 := by omega
  rw [he] at hbound
  have hbn : E.card ≤ 2 * (c + 1) * N :=
    hbound.trans (Nat.mul_le_mul_left _ hsize)
  have hbn' : (E.card : ℝ) ≤ 2 * ((c : ℝ) + 1) * N := by exact_mod_cast hbn
  have hchi : (c : ℝ) < r + 1 := Nat.ceil_lt_add_one hr0
  have hc3 : (c : ℝ) + 1 ≤ 3 * r := by linarith
  have hrpow : (N : ℝ) ^ ((4 : ℝ) / 3) = N * r := by
    rw [show (4 : ℝ) / 3 = 1 + 1 / 3 by norm_num,
      Real.rpow_add (by exact_mod_cast (show 0 < N by omega)), Real.rpow_one]
  rw [hrpow]
  nlinarith [mul_nonneg (Nat.cast_nonneg (α := ℝ) N) (sub_nonneg.mpr hc3)]

end BipartiteCycleBounds

open Finset SimpleGraph

namespace MaxCut

variable {V : Type*} [DecidableEq V]

lemma weighted_cut (W : V → V → ℕ) (hsym : ∀ x y, W x y = W y x)
    (hdiag : ∀ x, W x x = 0) (S : Finset V) :
    ∃ A B : Finset V, Disjoint A B ∧ A ∪ B = S ∧
      (∑ u ∈ S, ∑ v ∈ S, W u v) ≤ 4 * (∑ u ∈ A, ∑ v ∈ B, W u v) := by
  induction S using Finset.induction_on with
  | empty => exact ⟨∅, ∅, by simp, by simp, by simp⟩
  | @insert x S hx ih =>
    obtain ⟨A, B, hdis, hAB, hcut⟩ := ih
    have hxA : x ∉ A := fun h => hx (hAB ▸ mem_union_left B h)
    have hxB : x ∉ B := fun h => hx (hAB ▸ mem_union_right A h)
    let sa := ∑ u ∈ A, W x u
    let sb := ∑ u ∈ B, W x u
    have hsplit : (∑ u ∈ S, W x u) = sa + sb := by
      rw [← hAB, sum_union hdis]
    have hswap : (∑ u ∈ S, W u x) = ∑ u ∈ S, W x u := by
      apply sum_congr rfl
      intro u _
      exact hsym u x
    have hmass : (∑ u ∈ insert x S, ∑ v ∈ insert x S, W u v) =
        (∑ u ∈ S, ∑ v ∈ S, W u v) + 2 * (sa + sb) := by
      rw [sum_insert hx]
      simp_rw [sum_insert hx]
      rw [hdiag, zero_add, sum_add_distrib, hswap, hsplit]
      omega
    by_cases hab : sa ≤ sb
    · refine ⟨insert x A, B, ?_, ?_, ?_⟩
      · exact Finset.disjoint_left.mpr (by
          intro v hvA hvB
          rcases mem_insert.mp hvA with rfl | hvA
          · exact hxB hvB
          · exact Finset.disjoint_left.mp hdis hvA hvB)
      · rw [insert_union, hAB]
      · rw [hmass, sum_insert hxA]
        change _ ≤ 4 * (sb + _)
        omega
    · refine ⟨A, insert x B, ?_, ?_, ?_⟩
      · exact Finset.disjoint_left.mpr (by
          intro v hvA hvB
          rcases mem_insert.mp hvB with rfl | hvB
          · exact hxA hvA
          · exact Finset.disjoint_left.mp hdis hvA hvB)
      · rw [union_insert, hAB]
      · rw [hmass]
        simp_rw [sum_insert hxB]
        rw [sum_add_distrib]
        have hswapA : (∑ u ∈ A, W u x) = sa := by
          apply sum_congr rfl
          intro u _
          exact hsym u x
        rw [hswapA]
        omega

lemma graph_cut [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∃ A B : Finset V, Disjoint A B ∧ A ∪ B = univ ∧
      G.edgeFinset.card ≤ 2 * ((A ×ˢ B).filter fun e => G.Adj e.1 e.2).card := by
  obtain ⟨A, B, hdis, hAB, hcut⟩ := weighted_cut (fun u v => if G.Adj u v then 1 else 0)
    (by intro u v; simp only [G.adj_comm u v]) (by intro u; simp) univ
  refine ⟨A, B, hdis, hAB, ?_⟩
  have hmass : (∑ u : V, ∑ v : V, if G.Adj u v then 1 else 0) = 2 * G.edgeFinset.card := by
    simpa only [← G.degree_eq_sum_if_adj] using G.sum_degrees_eq_twice_card_edges
  have hbet : (∑ u ∈ A, ∑ v ∈ B, if G.Adj u v then 1 else 0) =
      ((A ×ˢ B).filter fun e => G.Adj e.1 e.2).card := by
    rw [← sum_product A B (fun e : V × V => if G.Adj e.1 e.2 then (1 : ℕ) else 0), sum_boole]
    simp
  rw [hmass, hbet] at hcut
  omega

end MaxCut


namespace SixCycleCase

open BipartiteCycleExtraction

def bipGraph {L R : Type*} (r : L → R → Prop) : SimpleGraph (L ⊕ R) where
  Adj u v := match u, v with
    | .inl a, .inr b => r a b
    | .inr b, .inl a => r a b
    | _, _ => False
  symm := by intro u v h; cases u <;> cases v <;> exact h
  loopless := by intro u; cases u <;> exact not_false

def Six : SimpleGraph (Fin 3 ⊕ Fin 3) := bipGraph (fun i j => i ≠ j)

lemma six_bipartite : Six.IsBipartite := by
  let f : Six →g completeBipartiteGraph (Fin 3) (Fin 3) :=
    { toFun := id
      map_rel' := by
        intro u v h
        cases u <;> cases v <;> simp_all [Six, bipGraph, completeBipartiteGraph] }
  apply Colorable.of_hom f
  simpa only [Fintype.card_bool] using (CompleteBipartiteGraph.bicoloring (Fin 3) (Fin 3)).colorable

lemma cut_noSix {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (hf : Six.Free G)
    (A B : Finset V) (hdis : Disjoint A B) :
    NoSix ((A ×ˢ B).filter fun e => G.Adj e.1 e.2) := by
  intro a b c x y z hab hbc hca hxy hyz hzx hax hbx hby hcy hcz haz
  simp only [mem_filter, mem_product] at hax hbx hby hcy hcz haz
  have hcross : ∀ u ∈ A, ∀ v ∈ B, u ≠ v := by
    intro u hu v hv he
    exact Finset.disjoint_left.mp hdis (he ▸ hu) hv
  apply hf
  refine ⟨{ toHom := { toFun := Sum.elim ![a, b, c] ![y, z, x], map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v huv
    clear hcross hf
    cases u with
    | inl i =>
      cases v with
      | inl j => exact huv.elim
      | inr j =>
        fin_cases i <;> fin_cases j <;> simp_all [Six, bipGraph, G.adj_comm]
    | inr i =>
      cases v with
      | inl j =>
        fin_cases i <;> fin_cases j <;> simp_all [Six, bipGraph, G.adj_comm]
      | inr j => exact huv.elim
  · apply Sum.elim_injective.mpr
    refine ⟨?_, ?_, ?_⟩
    · intro i j he
      fin_cases i <;> fin_cases j <;> simp [hab, hbc, hca, Ne.symm hab, Ne.symm hbc, Ne.symm hca] at he ⊢
    · intro i j he
      fin_cases i <;> fin_cases j <;> simp [hxy, hyz, hzx, Ne.symm hxy, Ne.symm hyz, Ne.symm hzx] at he ⊢
    · intro i j
      apply hcross
      · fin_cases i <;> first | exact hax.1.1 | exact hbx.1.1 | exact hcy.1.1
      · fin_cases j <;> first | exact hby.1.2 | exact haz.1.2 | exact hax.1.2

lemma six_edge_upper {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (hf : Six.Free G)
    (hn : 1 ≤ Fintype.card V) :
    (G.edgeFinset.card : ℝ) ≤ 12 * (Fintype.card V : ℝ) ^ ((4 : ℝ) / 3) := by
  classical
  obtain ⟨A, B, hdis, hAB, hcut⟩ := MaxCut.graph_cut G
  have hsize : A.card + B.card = Fintype.card V := by
    rw [← card_union_of_disjoint hdis, hAB, card_univ]
  have hb := BipartiteCycleBounds.edge_bound_real (Fintype.card V) hn hsize.le
    (filter_subset (fun e : V × V => G.Adj e.1 e.2) (A ×ˢ B)) (cut_noSix G hf A B hdis)
  have hc : (G.edgeFinset.card : ℝ) ≤ 2 * (((A ×ˢ B).filter fun e => G.Adj e.1 e.2).card : ℝ) := by
    exact_mod_cast hcut
  linarith

lemma six_extremal_upper (n : ℕ) (hn : 1 ≤ n) :
    (extremalNumber n Six : ℝ) ≤ 12 * (n : ℝ) ^ ((4 : ℝ) / 3) := by
  rw [← Fintype.card_fin n, extremalNumber_le_iff_of_nonneg Six (by positivity)]
  intro G _ hf
  exact six_edge_upper G hf (by simpa using hn)

lemma exists_inr_of_adj_inl {L R : Type*} {r : L → R → Prop} {a : L} {v : L ⊕ R}
    (h : (bipGraph r).Adj (.inl a) v) : ∃ b, v = Sum.inr b := by
  cases v with
  | inl v => exact h.elim
  | inr b => exact ⟨b, rfl⟩

lemma exists_inl_of_adj_inr {L R : Type*} {r : L → R → Prop} {b : R} {v : L ⊕ R}
    (h : (bipGraph r).Adj (.inr b) v) : ∃ a, v = Sum.inl a := by
  cases v with
  | inl a => exact ⟨a, rfl⟩
  | inr v => exact h.elim

lemma no_copy_left {L R : Type*} (E : Finset (L × R)) (h6 : NoSix E)
    (f : Six.Copy (bipGraph fun a b => (a, b) ∈ E))
    (a : L) (ha : f (.inl 0) = .inl a) : False := by
  have h01 := f.toHom.map_adj (show Six.Adj (.inl 0) (.inr 1) by dsimp [Six, bipGraph]; decide)
  have h02 := f.toHom.map_adj (show Six.Adj (.inl 0) (.inr 2) by dsimp [Six, bipGraph]; decide)
  have h10 := f.toHom.map_adj (show Six.Adj (.inl 1) (.inr 0) by dsimp [Six, bipGraph]; decide)
  have h12 := f.toHom.map_adj (show Six.Adj (.inl 1) (.inr 2) by dsimp [Six, bipGraph]; decide)
  have h20 := f.toHom.map_adj (show Six.Adj (.inl 2) (.inr 0) by dsimp [Six, bipGraph]; decide)
  have h21 := f.toHom.map_adj (show Six.Adj (.inl 2) (.inr 1) by dsimp [Six, bipGraph]; decide)
  obtain ⟨x, hx⟩ := exists_inr_of_adj_inl (ha ▸ h01)
  obtain ⟨y, hy⟩ := exists_inr_of_adj_inl (ha ▸ h02)
  obtain ⟨b, hb⟩ := exists_inl_of_adj_inr (hy ▸ h12.symm)
  obtain ⟨c, hc⟩ := exists_inl_of_adj_inr (hx ▸ h21.symm)
  obtain ⟨z, hz⟩ := exists_inr_of_adj_inl (hb ▸ h10)
  apply h6 a b c y z x
  · simpa only [Copy.toHom_apply, ha, hb, ne_eq, Sum.inl.injEq] using
      f.injective.ne (by decide : (Sum.inl (0 : Fin 3) : Fin 3 ⊕ Fin 3) ≠ .inl 1)
  · simpa only [Copy.toHom_apply, hb, hc, ne_eq, Sum.inl.injEq] using
      f.injective.ne (by decide : (Sum.inl (1 : Fin 3) : Fin 3 ⊕ Fin 3) ≠ .inl 2)
  · simpa only [Copy.toHom_apply, hc, ha, ne_eq, Sum.inl.injEq] using
      f.injective.ne (by decide : (Sum.inl (2 : Fin 3) : Fin 3 ⊕ Fin 3) ≠ .inl 0)
  · simpa only [Copy.toHom_apply, hy, hz, ne_eq, Sum.inr.injEq] using
      f.injective.ne (by decide : (Sum.inr (2 : Fin 3) : Fin 3 ⊕ Fin 3) ≠ .inr 0)
  · simpa only [Copy.toHom_apply, hz, hx, ne_eq, Sum.inr.injEq] using
      f.injective.ne (by decide : (Sum.inr (0 : Fin 3) : Fin 3 ⊕ Fin 3) ≠ .inr 1)
  · simpa only [Copy.toHom_apply, hx, hy, ne_eq, Sum.inr.injEq] using
      f.injective.ne (by decide : (Sum.inr (1 : Fin 3) : Fin 3 ⊕ Fin 3) ≠ .inr 2)
  · simpa only [Copy.toHom_apply, ha, hy, bipGraph] using h02
  · simpa only [Copy.toHom_apply, hb, hy, bipGraph] using h12
  · simpa only [Copy.toHom_apply, hb, hz, bipGraph] using h10
  · simpa only [Copy.toHom_apply, hc, hz, bipGraph] using h20
  · simpa only [Copy.toHom_apply, hc, hx, bipGraph] using h21
  · simpa only [Copy.toHom_apply, ha, hx, bipGraph] using h01

def swapCopy {L R : Type*} [DecidableEq L] [DecidableEq R] (E : Finset (L × R)) :
    (bipGraph fun a b => (a, b) ∈ E).Copy
      (bipGraph fun b a => (b, a) ∈ E.image Prod.swap) where
  toHom :=
    { toFun := Sum.swap
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b => exact h.elim
          | inr b => exact mem_image.mpr ⟨(a, b), h, rfl⟩
        | inr b =>
          cases v with
          | inl a => exact mem_image.mpr ⟨(a, b), h, rfl⟩
          | inr a => exact h.elim }
  injective' := by
    intro u v h
    have hh := congrArg Sum.swap h
    simpa using hh

lemma free_of_noSix {L R : Type*} [DecidableEq L] [DecidableEq R]
    (E : Finset (L × R)) (h6 : NoSix E) : Six.Free (bipGraph fun a b => (a, b) ∈ E) := by
  rintro ⟨f⟩
  cases ha : f (.inl 0) with
  | inl a => exact no_copy_left E h6 f a ha
  | inr b =>
    apply no_copy_left (E.image Prod.swap) h6.transpose ((swapCopy E).comp f) b
    change Sum.swap (f (.inl 0)) = Sum.inl b
    rw [ha]
    rfl

lemma bip_edge_count {L R : Type*} [Fintype L] [Fintype R] (E : Finset (L × R)) :
    Nat.card (bipGraph fun a b => (a, b) ∈ E).edgeSet = E.card := by
  classical
  let f : E → (bipGraph fun a b => (a, b) ∈ E).edgeSet :=
    fun e => ⟨s(Sum.inl e.val.1, Sum.inr e.val.2), e.prop⟩
  have hinj : Function.Injective f := by
    intro e e' h
    have hh := congrArg Subtype.val h
    simp only [f, Sym2.eq_iff, Sum.inl.injEq, Sum.inr.injEq, Sum.inl_ne_inr,
      Sum.inr_ne_inl, false_and, or_false] at hh
    exact Subtype.ext (Prod.ext hh.1 hh.2)
  have hsurj : Function.Surjective f := by
    rintro ⟨e, he⟩
    induction e using Sym2.inductionOn with
    | hf u v =>
      cases u with
      | inl a =>
        cases v with
        | inl b => exact he.elim
        | inr b => exact ⟨⟨(a, b), he⟩, rfl⟩
      | inr b =>
        cases v with
        | inl a =>
          refine ⟨⟨(a, b), he⟩, ?_⟩
          apply Subtype.ext
          exact Sym2.eq_swap
        | inr a => exact he.elim
  have h := Nat.card_congr (Equiv.ofBijective f ⟨hinj, hsurj⟩)
  simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using h.symm

end SixCycleCase


namespace SixCycleCase

open BipartiteCycleExtraction

variable {K : Type*} [Field K]

def wengerRel (p l : K × K × K) : Prop :=
  p.2.1 + l.2.1 = p.1 * l.1 ∧ p.2.2 + l.2.2 = p.1 * l.2.1

lemma wenger_x_ne {p q l : K × K × K} (hp : wengerRel p l) (hq : wengerRel q l)
    (hne : p ≠ q) : p.1 ≠ q.1 := by
  intro hx
  apply hne
  apply Prod.ext hx
  apply Prod.ext
  · dsimp [wengerRel] at hp hq
    rw [hx] at hp
    linear_combination hp.1 - hq.1
  · dsimp [wengerRel] at hp hq
    rw [hx] at hp
    linear_combination hp.2 - hq.2

lemma wenger_pair {p q l : K × K × K} (hp : wengerRel p l) (hq : wengerRel q l) :
    p.2.2 - q.2.2 = q.1 * p.2.1 - p.1 * q.2.1 := by
  dsimp [wengerRel] at hp hq
  linear_combination hp.2 - hq.2 - q.1 * hp.1 + p.1 * hq.1

lemma wenger_no_six (p q r l m n : K × K × K)
    (hpq : p ≠ q) (hqr : q ≠ r) (hlm : l ≠ m)
    (hpl : wengerRel p l) (hql : wengerRel q l)
    (hqm : wengerRel q m) (hrm : wengerRel r m)
    (hrn : wengerRel r n) (hpn : wengerRel p n) : False := by
  have hpqx := sub_ne_zero.mpr (wenger_x_ne hpl hql hpq)
  have hqrx := sub_ne_zero.mpr (wenger_x_ne hqm hrm hqr)
  have h1 := wenger_pair hpl hql
  have h2 := wenger_pair hqm hrm
  have h3 := wenger_pair hrn hpn
  have hz : (p.1 - q.1) * (q.2.1 - r.2.1) -
      (q.1 - r.1) * (p.2.1 - q.2.1) = 0 := by
    linear_combination h1 + h2 + h3
  have hprod : (p.1 - q.1) * (q.1 - r.1) * (m.1 - l.1) = 0 := by
    dsimp [wengerRel] at hpl hql hqm hrm
    linear_combination hz - (p.1 - q.1) * (hqm.1 - hrm.1) +
      (q.1 - r.1) * (hpl.1 - hql.1)
  have hml : m.1 = l.1 := sub_eq_zero.mp
    ((mul_eq_zero.mp hprod).resolve_left (mul_ne_zero hpqx hqrx))
  apply hlm
  apply Prod.ext hml.symm
  apply Prod.ext
  · dsimp [wengerRel] at hql hqm
    rw [hml] at hqm
    linear_combination hql.1 - hqm.1
  · have hb : l.2.1 = m.2.1 := by
      dsimp [wengerRel] at hql hqm
      rw [hml] at hqm
      linear_combination hql.1 - hqm.1
    dsimp [wengerRel] at hql hqm
    rw [hb] at hql
    linear_combination hql.2 - hqm.2

noncomputable def wengerEdges (K : Type*) [Field K] [Fintype K] :
    Finset ((K × K × K) × (K × K × K)) := by
  classical
  exact univ.filter (fun e => wengerRel e.1 e.2)

lemma mem_wengerEdges [Fintype K] (p l : K × K × K) :
    (p, l) ∈ wengerEdges K ↔ wengerRel p l := by
  classical
  simp [wengerEdges]

lemma wengerEdges_noSix [Fintype K] [DecidableEq K] : NoSix (wengerEdges K) := by
  intro p q r l m n hpq hqr hrp hlm hmn hnl hpl hql hqm hrm hrn hpn
  simp only [mem_wengerEdges] at hpl hql hqm hrm hrn hpn
  exact wenger_no_six p q r l m n hpq hqr hlm hpl hql hqm hrm hrn hpn

lemma wengerEdges_lower [Fintype K] : Fintype.card K ^ 4 ≤ (wengerEdges K).card := by
  classical
  let f : (K × K × K) × K → wengerEdges K := fun t =>
    ⟨(t.1, (t.2, t.1.1 * t.2 - t.1.2.1,
        t.1.1 * (t.1.1 * t.2 - t.1.2.1) - t.1.2.2)), by
      rw [mem_wengerEdges]
      constructor <;> dsimp <;> ring⟩
  have hf : Function.Injective f := by
    intro s t h
    have hv := congrArg Subtype.val h
    apply Prod.ext
    · exact congrArg (fun e : (K × K × K) × (K × K × K) => e.1) hv
    · exact congrArg (fun e => e.2.1) hv
  have h := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_prod, Fintype.card_coe, pow_succ, pow_zero, mul_one, one_mul, mul_assoc]
    using h

end SixCycleCase


namespace SixCycleCase

open SimpleGraph

lemma free_map_of_no_isolated {U V W : Type*} {H : SimpleGraph U} {G : SimpleGraph V}
    (hH : ∀ u, ∃ v, H.Adj u v) (hfree : H.Free G) (f : V ↪ W) : H.Free (G.map f) := by
  classical
  rintro ⟨c⟩
  have hrange : ∀ u, ∃ v, f v = c u := by
    intro u
    obtain ⟨u', hu'⟩ := hH u
    obtain ⟨v, w, hvw, hv, hw⟩ := c.toHom.map_adj hu'
    exact ⟨v, hv⟩
  choose g hg using hrange
  apply hfree
  refine ⟨{ toHom := { toFun := g, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    apply (map_adj_apply (G := G) (f := f)).mp
    rw [hg, hg]
    exact c.toHom.map_adj h
  · intro u v h
    apply c.injective
    change c u = c v
    change g u = g v at h
    rw [← hg, ← hg, h]


lemma six_no_isolated (v : Fin 3 ⊕ Fin 3) : ∃ w, Six.Adj v w := by
  cases v with
  | inl i =>
    fin_cases i
    · exact ⟨.inr 1, by dsimp [Six, bipGraph]; decide⟩
    · exact ⟨.inr 0, by dsimp [Six, bipGraph]; decide⟩
    · exact ⟨.inr 0, by dsimp [Six, bipGraph]; decide⟩
  | inr i =>
    fin_cases i
    · exact ⟨.inl 1, by dsimp [Six, bipGraph]; decide⟩
    · exact ⟨.inl 0, by dsimp [Six, bipGraph]; decide⟩
    · exact ⟨.inl 0, by dsimp [Six, bipGraph]; decide⟩

lemma wenger_extremal_lower (p n : ℕ) (hp : p.Prime) (hn : 2 * p ^ 3 ≤ n) :
    p ^ 4 ≤ extremalNumber n Six := by
  classical
  letI : Fact p.Prime := ⟨hp⟩
  let K := ZMod p
  let V := (K × K × K) ⊕ (K × K × K)
  let G := bipGraph fun a b => (a,b) ∈ wengerEdges K
  have hcard : Fintype.card V ≤ Fintype.card (Fin n) := by
    simpa only [V, K, Fintype.card_sum, Fintype.card_prod, ZMod.card, Fintype.card_fin,
      ← two_mul, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using hn
  let f : V ↪ Fin n := (Function.Embedding.nonempty_of_card_le hcard).some
  have hfree : Six.Free (G.map f) := free_map_of_no_isolated six_no_isolated
    (free_of_noSix (wengerEdges K) wengerEdges_noSix) f
  have he := card_edgeFinset_le_extremalNumber hfree
  have hmap := card_edgeFinset_map f G
  simp only [← card_edgeSet, ← Nat.card_eq_fintype_card] at he hmap
  rw [hmap] at he
  rw [Nat.card_eq_fintype_card, card_edgeSet] at he
  have hc : G.edgeFinset.card = (wengerEdges K).card := by
    rw [← card_edgeSet, ← Nat.card_eq_fintype_card]
    exact bip_edge_count _
  rw [hc] at he
  exact (show p ^ 4 ≤ (wengerEdges K).card by simpa [K] using (wengerEdges_lower (K := K))).trans
    (by simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using he)

end SixCycleCase


namespace SixCycleCase

open Filter SimpleGraph


lemma prime_at_cube_scale (n : ℕ) (hn : 64 ≤ n) :
    ∃ p : ℕ, p.Prime ∧ 2 * p ^ 3 ≤ n ∧ n ≤ 64 * p ^ 3 := by
  let k := (Nat.nthRoot 3 n) / 4
  have hs4 : 4 ≤ (Nat.nthRoot 3 n) := by
    apply (Nat.le_nthRoot_iff (by decide)).mpr
    exact hn
  have hk : k ≠ 0 := by dsimp [k]; omega
  obtain ⟨p, hp, hkp, hpk⟩ := Nat.exists_prime_lt_and_le_two_mul k hk
  refine ⟨p, hp, ?_, ?_⟩
  · have hks : 4 * k ≤ (Nat.nthRoot 3 n) := by
      simpa only [k, Nat.mul_comm] using Nat.div_mul_le_self ((Nat.nthRoot 3 n)) 4
    have hpc := Nat.pow_le_pow_left hpk 3
    have hkc := (Nat.pow_le_pow_left hks 3).trans (Nat.pow_nthRoot_le (Or.inl (by decide : 3 ≠ 0)))
    nlinarith
  · have hkupper : (Nat.nthRoot 3 n) < 4 * (k + 1) := Nat.lt_mul_div_succ _ (by decide)
    have hps : (Nat.nthRoot 3 n) + 1 ≤ 4 * p := by omega
    have hpc := Nat.pow_le_pow_left hps 3
    have hnlt := Nat.lt_pow_nthRoot_add_one (by decide : 3 ≠ 0) n
    nlinarith

lemma rpow_four_thirds_bound {n p : ℕ} (h : n ≤ 64 * p ^ 3) :
    (n : ℝ) ^ ((4 : ℝ) / 3) ≤ 256 * (p : ℝ) ^ 4 := by
  have hnp : (n : ℝ) ≤ (4 * p : ℝ) ^ 3 := by
    have hh : (n : ℝ) ≤ 64 * (p : ℝ) ^ 3 := by exact_mod_cast h
    nlinarith
  have hpow := Real.rpow_le_rpow (by positivity : (0 : ℝ) ≤ n) hnp
    (by norm_num : (0 : ℝ) ≤ 4 / 3)
  rw [← Real.rpow_natCast_mul (by positivity)] at hpow
  norm_num at hpow
  convert hpow using 1
  ring

lemma six_extremal_bounds (n : ℕ) (hn : 64 ≤ n) :
    (extremalNumber n Six : ℝ) ≤ 12 * (n : ℝ) ^ ((4 : ℝ) / 3) ∧
    (n : ℝ) ^ ((4 : ℝ) / 3) ≤ 256 * (extremalNumber n Six : ℝ) := by
  constructor
  · exact six_extremal_upper n (by omega)
  · obtain ⟨p, hp, hpn, hnp⟩ := prime_at_cube_scale n hn
    have hex : (p : ℝ) ^ 4 ≤ (extremalNumber n Six : ℝ) := by
      exact_mod_cast wenger_extremal_lower p n hp hpn
    exact (rpow_four_thirds_bound hnp).trans (by gcongr)

/-- The six-cycle witnesses the rational exponent 4/3. -/
theorem exponent_four_thirds :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta atTop
        (fun n : ℕ => (extremalNumber n G : ℝ))
        (fun n : ℕ => (n : ℝ) ^ ((4 / 3 : ℚ) : ℝ)) := by
  let e : (Fin 3 ⊕ Fin 3) ≃ Fin 6 := finSumFinEquiv
  let G := Six.map e.toEmbedding
  refine ⟨6, G, six_bipartite.map e.toEmbedding, ?_⟩
  have heq : ∀ n, extremalNumber n G = extremalNumber n Six := fun _ =>
    (extremalNumber_congr_right (SimpleGraph.Iso.map e Six)).symm
  have hpow : ((4 / 3 : ℚ) : ℝ) = (4 : ℝ) / 3 := by norm_num
  constructor
  · apply Asymptotics.IsBigO.of_bound 12
    filter_upwards [eventually_ge_atTop 64] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _),
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), heq, hpow]
    exact (six_extremal_bounds n hn).1
  · apply Asymptotics.IsBigO.of_bound 256
    filter_upwards [eventually_ge_atTop 64] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), abs_of_nonneg (Nat.cast_nonneg _),
      heq, hpow]
    exact (six_extremal_bounds n hn).2

end SixCycleCase


/- The no-line property of a three-dimensional unit sphere over a field
in which -1 is not a square. -/

namespace BrownAlgebra

variable {K : Type*} [Field K]

abbrev Point (K : Type*) := Fin 3 → K

def quad (x : Point K) : K := x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2
def dot (x y : Point K) : K := x 0 * y 0 + x 1 * y 1 + x 2 * y 2

lemma perp_coord_zero (hs : ∀ t : K, t ^ 2 ≠ -1)
    (a b c x y z : K) (hv : a ^ 2 + b ^ 2 + c ^ 2 = 0)
    (hx : x ^ 2 + y ^ 2 + z ^ 2 = 1) (hd : a*x + b*y + c*z = 0) : c = 0 := by
  by_contra hc
  have hsq : (a*y - b*x)^2 + c^2 = 0 := by
    linear_combination (x^2 + y^2) * hv - (a*x+b*y+c*z-2*c*z) * hd - c^2 * hx
  apply hs ((a*y-b*x)/c)
  field_simp
  linear_combination hsq

/-- A unit vector has no nonzero isotropic vector perpendicular to it. -/
lemma no_isotropic_perp (hs : ∀ t : K, t ^ 2 ≠ -1)
    (x v : Point K) (hx : quad x = 1) (hv : quad v = 0) (hd : dot v x = 0) : v = 0 := by
  funext i
  fin_cases i
  · apply perp_coord_zero hs (v 1) (v 2) (v 0) (x 1) (x 2) (x 0)
    · dsimp [quad] at hv
      linear_combination hv
    · dsimp [quad] at hx
      linear_combination hx
    · dsimp [dot] at hd
      linear_combination hd
  · apply perp_coord_zero hs (v 2) (v 0) (v 1) (x 2) (x 0) (x 1)
    · dsimp [quad] at hv
      linear_combination hv
    · dsimp [quad] at hx
      linear_combination hx
    · dsimp [dot] at hd
      linear_combination hd
  · exact perp_coord_zero hs (v 0) (v 1) (v 2) (x 0) (x 1) (x 2) hv hx hd

lemma quad_add_smul (x v : Point K) (t : K) :
    quad (x + t • v) = quad x + 2*t*dot v x + t^2*quad v := by
  simp only [quad, dot, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  ring

lemma two_ne_zero (hs : ∀ t : K, t ^ 2 ≠ -1) : (2 : K) ≠ 0 := by
  intro h
  apply hs 1
  linear_combination h

/-- A line meets the unit sphere in at most two points. -/
lemma line_sphere_two (hs : ∀ t : K, t ^ 2 ≠ -1)
    (x v : Point K) (t : K) (hx : quad x = 1)
    (hv : quad (x + v) = 1) (ht : quad (x + t • v) = 1)
    (ht0 : t ≠ 0) (ht1 : t ≠ 1) : v = 0 := by
  have hv' : 2 * dot v x + quad v = 0 := by
    have h := quad_add_smul x v 1
    simp only [one_smul, mul_one, one_pow, one_mul] at h
    linear_combination hv - hx - h
  have ht' : 2*t*dot v x + t^2*quad v = 0 := by
    have h := quad_add_smul x v t
    linear_combination ht - hx - h
  have hprod : t*(t-1)*quad v = 0 := by
    linear_combination ht' - t*hv'
  have hq : quad v = 0 :=
    (mul_eq_zero.mp hprod).resolve_left (mul_ne_zero ht0 (sub_ne_zero.mpr ht1))
  have hd : dot v x = 0 := by
    rw [hq, add_zero] at hv'
    exact (mul_eq_zero.mp hv').resolve_left (two_ne_zero hs)
  exact no_isotropic_perp hs x v hx hq hd

/-- Three distinct points on the unit sphere are not affinely collinear. -/
lemma sphere_triple_independent (hs : ∀ t : K, t ^ 2 ≠ -1)
    (x y z : Point K) (hx : quad x = 1) (hy : quad y = 1) (hz : quad z = 1)
    (hxy : x ≠ y) (hyz : y ≠ z) (hxz : x ≠ z) :
    LinearIndependent K ![y-x, z-x] := by
  rw [linearIndependent_fin2]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  refine ⟨sub_ne_zero.mpr hxz.symm, ?_⟩
  intro t ht
  have ht0 : t ≠ 0 := by
    intro h
    subst t
    rw [zero_smul] at ht
    exact hxy (sub_eq_zero.mp ht.symm).symm
  have ht1 : t ≠ 1 := by
    intro h
    subst t
    rw [one_smul] at ht
    have hh := congrArg (fun v : Point K => v + x) ht
    have hzy : z = y := by simpa only [sub_add_cancel] using hh
    exact hyz hzy.symm
  have hxv : x + (z - x) = z := by abel
  have hxtv : x + t • (z - x) = y := by rw [ht]; abel
  have hzero := line_sphere_two hs x (z - x) t hx (by rw [hxv]; exact hz) (by rw [hxtv]; exact hy) ht0 ht1
  exact hxz (sub_eq_zero.mp hzero).symm


lemma quad_sub_comm (x y : Point K) : quad (x-y) = quad (y-x) := by
  simp only [quad, Pi.sub_apply]
  ring

lemma sub_ne_sub (x y c : Point K) (h : x ≠ y) : x-c ≠ y-c := by
  intro he
  apply h
  simpa only [sub_add_cancel] using congrArg (fun v : Point K => v+c) he

lemma translated_triple_independent (hs : ∀ t : K, t ^ 2 ≠ -1)
    (x y z c : Point K) (hx : quad (x-c) = 1) (hy : quad (y-c) = 1)
    (hz : quad (z-c) = 1) (hxy : x ≠ y) (hyz : y ≠ z) (hxz : x ≠ z) :
    LinearIndependent K ![y-x, z-x] := by
  have h := sphere_triple_independent hs (x-c) (y-c) (z-c) hx hy hz
    (sub_ne_sub x y c hxy) (sub_ne_sub y z c hyz) (sub_ne_sub x z c hxz)
  have he : ![(y-c)-(x-c), (z-c)-(x-c)] = ![y-x, z-x] := by
    congr 1 <;> abel
  rwa [he] at h

noncomputable def bilin : LinearMap.BilinForm K (Point K) :=
  Matrix.toBilin' (1 : Matrix (Fin 3) (Fin 3) K)

lemma bilin_apply (x y : Point K) : bilin x y = dot x y := by
  simp [bilin, Matrix.toBilin'_apply', dotProduct, Fin.sum_univ_three, dot]

lemma bilin_symm : (bilin (K := K)).IsSymm := by
  constructor
  intro x y
  simp only [bilin_apply, dot]
  ring

lemma bilin_nondegenerate : (bilin (K := K)).Nondegenerate :=
  LinearMap.BilinForm.nondegenerate_toBilin'_of_det_ne_zero' _ (by simp)

lemma independent_pairs_not_orthogonal (u v : Fin 2 → Point K)
    (hu : LinearIndependent K u) (hv : LinearIndependent K v)
    (horth : ∀ i j, dot (u i) (v j) = 0) : False := by
  let U := Submodule.span K (Set.range u)
  let V := Submodule.span K (Set.range v)
  have hsub : U ≤ (bilin (K := K)).orthogonal V := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change ∀ w ∈ V, bilin w (u i) = 0
    intro w hw
    have hker : V ≤ LinearMap.ker ((bilin (K := K)).flip (u i)) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      change bilin (v j) (u i) = 0
      rw [bilin_symm.eq (v j) (u i), bilin_apply]
      exact horth i j
    exact hker hw
  have hdim := Submodule.finrank_mono hsub
  rw [LinearMap.BilinForm.finrank_orthogonal bilin_nondegenerate bilin_symm.isRefl] at hdim
  dsimp [U, V, Point] at hdim
  rw [finrank_span_eq_card hu, finrank_span_eq_card hv, Module.finrank_pi] at hdim
  norm_num at hdim

lemma four_distances_orthogonal (hs : ∀ t : K, t ^ 2 ≠ -1)
    (a b x y : Point K) (hax : quad (a-x) = 1) (hay : quad (a-y) = 1)
    (hbx : quad (b-x) = 1) (hby : quad (b-y) = 1) : dot (b-a) (y-x) = 0 := by
  have h : 2 * dot (b-a) (y-x) = 0 := by
    simp only [quad, dot, Pi.sub_apply] at *
    linear_combination hbx + hay - hby - hax
  exact (mul_eq_zero.mp h).resolve_left (two_ne_zero hs)

/-- Six distinct points cannot form two triples with every cross-distance equal to one. -/
theorem no_three_by_three (hs : ∀ t : K, t ^ 2 ≠ -1)
    (a b : Fin 3 → Point K) (ha : Function.Injective a) (hb : Function.Injective b)
    (hab : ∀ i j, quad (a i-b j) = 1) : False := by
  have hA := translated_triple_independent hs (a 0) (a 1) (a 2) (b 0)
    (hab 0 0) (hab 1 0) (hab 2 0)
    (ha.ne (by decide)) (ha.ne (by decide)) (ha.ne (by decide))
  have hB := translated_triple_independent hs (b 0) (b 1) (b 2) (a 0)
    (by rw [quad_sub_comm]; exact hab 0 0)
    (by rw [quad_sub_comm]; exact hab 0 1)
    (by rw [quad_sub_comm]; exact hab 0 2)
    (hb.ne (by decide)) (hb.ne (by decide)) (hb.ne (by decide))
  apply independent_pairs_not_orthogonal _ _ hA hB
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] <;>
    apply four_distances_orthogonal hs <;> exact hab _ _

def graph : SimpleGraph (Point K) where
  Adj x y := quad (x-y) = 1
  symm := by intro x y h; rwa [quad_sub_comm]
  loopless := by intro x h; simp [quad] at h

theorem graph_free (hs : ∀ t : K, t ^ 2 ≠ -1) :
    (completeBipartiteGraph (Fin 3) (Fin 3)).Free (graph (K := K)) := by
  rintro ⟨f⟩
  apply no_three_by_three hs (fun i => f (.inl i)) (fun j => f (.inr j))
    (f.injective.comp Sum.inl_injective) (f.injective.comp Sum.inr_injective)
  intro i j
  exact f.toHom.map_adj (by simp [completeBipartiteGraph])


open Finset SimpleGraph

def denominator (t : K × K) : K := 1 + t.1^2 + t.2^2

def stereo (t : K × K) : Point K :=
  ![2*t.1 / denominator t, 2*t.2 / denominator t, (1-t.1^2-t.2^2) / denominator t]

lemma stereo_quad (t : K × K) (ht : denominator t ≠ 0) : quad (stereo t) = 1 := by
  dsimp [stereo, quad]
  field_simp
  dsimp [denominator]
  ring

lemma stereo_last (t : K × K) (ht : denominator t ≠ 0) :
    1 + stereo t 2 = 2 / denominator t := by
  dsimp [stereo]
  field_simp
  dsimp [denominator]
  ring

lemma stereo_first (t : K × K) (ht : denominator t ≠ 0) :
    stereo t 0 = t.1 * (1 + stereo t 2) ∧ stereo t 1 = t.2 * (1 + stereo t 2) := by
  rw [stereo_last t ht]
  constructor <;> dsimp [stereo] <;> ring

lemma stereo_injective (hs : ∀ t : K, t^2 ≠ -1) :
    Function.Injective (fun t : {t : K × K // denominator t ≠ 0} => stereo t.val) := by
  intro t s he
  change stereo t.val = stereo s.val at he
  have h2 : 1 + stereo t.val 2 ≠ 0 := by
    rw [stereo_last t.val t.prop]
    exact div_ne_zero (two_ne_zero hs) t.prop
  have h0 := congrFun he 0
  have h1 := congrFun he 1
  have hlast := congrFun he 2
  rw [(stereo_first t.val t.prop).1, (stereo_first s.val s.prop).1, ← hlast] at h0
  rw [(stereo_first t.val t.prop).2, (stereo_first s.val s.prop).2, ← hlast] at h1
  apply Subtype.ext
  exact Prod.ext (mul_right_cancel₀ h2 h0) (mul_right_cancel₀ h2 h1)


lemma card_square_eq [Fintype K] [DecidableEq K] (a : K) :
    (univ.filter (fun x : K => x^2 = a)).card ≤ 2 := by
  let S := univ.filter (fun x : K => x^2 = a)
  by_cases hS : S.Nonempty
  · obtain ⟨x, hx⟩ := hS
    have hsub : S ⊆ {x, -x} := by
      intro y hy
      have hsq : y^2 = x^2 := (mem_filter.mp hy).2.trans (mem_filter.mp hx).2.symm
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h | h
      · simp [h]
      · simp [h]
    calc
      S.card ≤ ({x, -x} : Finset K).card := card_le_card hsub
      _ ≤ ({-x} : Finset K).card + 1 := card_insert_le _ _
      _ = 2 := by simp
  · have : S = ∅ := not_nonempty_iff_eq_empty.mp hS
    change S.card ≤ 2
    rw [this]
    simp

lemma parameter_count [Fintype K] :
    Fintype.card K ^ 2 ≤ Nat.card {t : K × K // denominator t ≠ 0} + 2 * Fintype.card K := by
  classical
  let B := univ.filter (fun t : K × K => denominator t = 0)
  have hfib (u : K) : (B.filter (fun t => t.1 = u)).card ≤ 2 := by
    apply le_trans _ (card_square_eq (-1-u^2))
    apply card_le_card_of_injOn Prod.snd
    · intro t ht
      have hd := (mem_filter.mp (mem_filter.mp ht).1).2
      have ht1 := (mem_filter.mp ht).2
      apply mem_filter.mpr
      refine ⟨mem_univ _, ?_⟩
      dsimp [denominator] at hd
      rw [ht1] at hd
      linear_combination hd
    · intro s hs t ht he
      exact Prod.ext ((mem_filter.mp hs).2.trans (mem_filter.mp ht).2.symm) he
  have hB : B.card ≤ 2 * Fintype.card K := by
    have h := card_le_mul_card_image_of_maps_to (s := B) (t := univ) (f := Prod.fst)
      (fun _ _ => mem_univ _) 2 (fun u _ => hfib u)
    simpa only [card_univ] using h
  have hsplit := card_filter_add_card_filter_not (s := (univ : Finset (K × K)))
    (fun t => denominator t = 0)
  rw [card_univ, Fintype.card_prod] at hsplit
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  change Fintype.card K ^ 2 ≤ (univ.filter (fun t : K × K => denominator t ≠ 0)).card + 2 * Fintype.card K
  change (univ.filter (fun t : K × K => denominator t = 0)).card ≤ 2 * Fintype.card K at hB
  nlinarith

lemma quad_neg (v : Point K) : quad (-v) = quad v := by
  simp [quad]

lemma neighbor_count [Fintype K] (hs : ∀ t : K, t^2 ≠ -1)
    (hq : 3 ≤ Fintype.card K) (x : Point K) :
    Fintype.card K ^ 2 ≤ 3 * Nat.card ((graph (K := K)).neighborSet x) := by
  classical
  let f : {t : K × K // denominator t ≠ 0} → (graph (K := K)).neighborSet x := fun t =>
    ⟨x + stereo t.val, by
      change quad (x-(x+stereo t.val)) = 1
      rw [show x-(x+stereo t.val) = -stereo t.val by abel, quad_neg]
      exact stereo_quad t.val t.prop⟩
  have hf : Function.Injective f := by
    intro s t he
    apply stereo_injective hs
    have hv := congrArg Subtype.val he
    change x + stereo s.val = x + stereo t.val at hv
    exact add_left_cancel hv
  have hc := Nat.card_le_card_of_injective f hf
  have hp := parameter_count (K := K)
  have hq2 : 3 * Fintype.card K ≤ Fintype.card K ^ 2 := by nlinarith
  nlinarith

/-- The structured construction has the required density for exponent 5/3. -/
theorem edge_count [Fintype K] (hs : ∀ t : K, t^2 ≠ -1) (hq : 3 ≤ Fintype.card K) :
    Fintype.card K ^ 5 ≤ 6 * Nat.card (graph (K := K)).edgeSet := by
  classical
  have h := sum_le_sum (s := (univ : Finset (Point K))) (fun x _ => neighbor_count hs hq x)
  simp only [Nat.card_eq_fintype_card, card_neighborSet_eq_degree, ← mul_sum,
    sum_const, card_univ, nsmul_eq_mul] at h
  rw [sum_degrees_eq_twice_card_edges] at h
  have hV : Fintype.card (Point K) = Fintype.card K ^ 3 := by
    simp only [Point, Fintype.card_fun, Fintype.card_fin]
  rw [hV] at h
  rw [Nat.card_eq_fintype_card, card_edgeSet]
  nlinarith


lemma neg_one_not_square [Fintype K] (hcard : Fintype.card K % 4 = 3)
    (htwo : (2 : K) ≠ 0) : ∀ t : K, t^2 ≠ -1 := by
  intro t ht
  have ht0 : t ≠ 0 := by intro h; subst t; simpa using ht
  have ht4 : t^4 = 1 := by
    calc
      t^4 = (t^2)^2 := by ring
      _ = 1 := by rw [ht]; simp
  have he : Fintype.card K - 1 = 4 * (Fintype.card K / 4) + 2 := by
    have := Nat.mod_add_div (Fintype.card K) 4
    omega
  have h := FiniteField.pow_card_sub_one_eq_one t ht0
  rw [he, pow_add, pow_mul, ht4, one_pow, one_mul, ht] at h
  apply htwo
  linear_combination -h

lemma three_odd_power_mod_four (k : ℕ) : 3 ^ (2*k+1) % 4 = 3 := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [show 2*(k+1)+1 = (2*k+1)+2 by omega, pow_add, Nat.mul_mod, ih]
    norm_num

lemma field_exists (k : ℕ) : ∃ (K : Type) (_ : Field K) (_ : Fintype K),
    Fintype.card K = 3 ^ (2*k+1) ∧ ∀ t : K, t^2 ≠ -1 := by
  letI : Fact (Nat.Prime 3) := ⟨by decide⟩
  let K := GaloisField 3 (2*k+1)
  letI : Fintype K := Fintype.ofFinite K
  refine ⟨K, inferInstance, inferInstance, ?_, ?_⟩
  · rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 3 (2*k+1) (by omega)
  · apply neg_one_not_square
    · rw [← Nat.card_eq_fintype_card, GaloisField.card 3 _ (by omega)]
      exact three_odd_power_mod_four k
    · have h : ¬(3 : ℕ) ∣ 2 := by decide
      simpa only [← CharP.cast_eq_zero_iff K 3, Nat.cast_ofNat] using h

lemma cube_scale (n : ℕ) (hn : 27 ≤ n) :
    ∃ k : ℕ, (3 ^ (2*k+1))^3 ≤ n ∧ n ≤ 729 * (3 ^ (2*k+1))^3 := by
  let N := n / 27
  let k := Nat.log 729 N
  have hN : N ≠ 0 := by dsimp [N]; omega
  have hq : (3 ^ (2*k+1))^3 = 27 * 729^k := by
    calc
      (3 ^ (2*k+1))^3 = 3^((2*k+1)*3) := (pow_mul _ _ _).symm
      _ = 3^(3+6*k) := by congr 1; omega
      _ = 3^3 * (3^6)^k := by rw [pow_add, pow_mul]
      _ = 27 * 729^k := by norm_num
  have hlo : 729^k ≤ N := Nat.pow_log_le_self 729 hN
  have hhi : N < 729^(k+1) := Nat.lt_pow_succ_log_self (by decide) N
  have hdiv : 27 * N ≤ n := by simpa only [N, mul_comm] using Nat.div_mul_le_self n 27
  have hdiv' : n < 27 * (N+1) := Nat.lt_mul_div_succ n (by decide)
  refine ⟨k, ?_, ?_⟩ <;> rw [hq]
  · nlinarith
  · rw [pow_succ] at hhi
    nlinarith


lemma free_map_of_no_isolated {U V W : Type*} {H : SimpleGraph U} {G : SimpleGraph V}
    (hH : ∀ u, ∃ v, H.Adj u v) (hfree : H.Free G) (f : V ↪ W) : H.Free (G.map f) := by
  classical
  rintro ⟨c⟩
  have hrange : ∀ u, ∃ v, f v = c u := by
    intro u
    obtain ⟨u', hu'⟩ := hH u
    obtain ⟨v, w, hvw, hv, hw⟩ := c.toHom.map_adj hu'
    exact ⟨v, hv⟩
  choose g hg using hrange
  apply hfree
  refine ⟨{ toHom := { toFun := g, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    apply (map_adj_apply (G := G) (f := f)).mp
    rw [hg, hg]
    exact c.toHom.map_adj h
  · intro u v h
    apply c.injective
    change c u = c v
    change g u = g v at h
    rw [← hg, ← hg, h]


lemma field_extremal_lower (k n : ℕ) (hn : (3 ^ (2*k+1))^3 ≤ n) :
    (3 ^ (2*k+1))^5 ≤ 6 * extremalNumber n (completeBipartiteGraph (Fin 3) (Fin 3)) := by
  classical
  obtain ⟨K, hField, hFintype, hK, hs⟩ := field_exists k
  letI := hField
  letI := hFintype
  have hq : 3 ≤ Fintype.card K := by
    rw [hK]
    exact Nat.le_self_pow (by omega) 3
  have hcard : Fintype.card (Point K) ≤ Fintype.card (Fin n) := by
    simpa only [Point, Fintype.card_fun, Fintype.card_fin, hK] using hn
  let f : Point K ↪ Fin n := (Function.Embedding.nonempty_of_card_le hcard).some
  have hno : ∀ v : Fin 3 ⊕ Fin 3, ∃ w, (completeBipartiteGraph (Fin 3) (Fin 3)).Adj v w := by
    intro v
    cases v with
    | inl i => exact ⟨.inr 0, by simp [completeBipartiteGraph]⟩
    | inr i => exact ⟨.inl 0, by simp [completeBipartiteGraph]⟩
  have hfree := free_map_of_no_isolated hno (graph_free hs) f
  have he := card_edgeFinset_le_extremalNumber hfree
  have hmap := card_edgeFinset_map f (graph (K := K))
  simp only [← card_edgeSet, ← Nat.card_eq_fintype_card] at he hmap
  rw [hmap] at he
  have he' : Nat.card (graph (K := K)).edgeSet ≤
      extremalNumber n (completeBipartiteGraph (Fin 3) (Fin 3)) := by
    simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using he
  have hl := edge_count hs hq
  rw [hK] at hl
  exact hl.trans (Nat.mul_le_mul_left 6 he')

theorem extremal_lower (n : ℕ) (hn : 27 ≤ n) :
    (n : ℝ) ^ ((5 : ℝ)/3) ≤
      354294 * (extremalNumber n (completeBipartiteGraph (Fin 3) (Fin 3)) : ℝ) := by
  obtain ⟨k, hkn, hnk⟩ := cube_scale n hn
  let q := 3 ^ (2*k+1)
  have hlow : (q : ℝ)^5 ≤ 6 * (extremalNumber n (completeBipartiteGraph (Fin 3) (Fin 3)) : ℝ) := by
    exact_mod_cast field_extremal_lower k n hkn
  have hnp : (n : ℝ) ≤ (9*q : ℝ)^3 := by
    have hh : (n : ℝ) ≤ 729 * (q : ℝ)^3 := by exact_mod_cast hnk
    nlinarith
  have hpow := Real.rpow_le_rpow (by positivity : (0 : ℝ) ≤ n) hnp
    (by norm_num : (0 : ℝ) ≤ 5/3)
  rw [← Real.rpow_natCast_mul (by positivity)] at hpow
  norm_num at hpow
  nlinarith

end BrownAlgebra


namespace K33Upper

open SimpleGraph

abbrev Star := completeBipartiteGraph (Fin 1) (Fin 3)
abbrev ThreeThree := completeBipartiteGraph (Fin 3) (Fin 3)

lemma star_tree : Star.IsTree := by
  letI : DecidableRel Star.Adj := fun u v => by
    dsimp [Star, completeBipartiteGraph]
    infer_instance
  rw [isTree_iff_connected_and_card]
  constructor
  · apply (connected_iff_exists_forall_reachable Star).mpr
    refine ⟨.inl 0, ?_⟩
    intro v
    cases v with
    | inl i =>
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      exact Reachable.refl _
    | inr j => exact (show Star.Adj (.inl 0) (.inr j) by simp [Star, completeBipartiteGraph]).reachable
  · rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, card_edgeSet]
    decide

lemma contained_of_common_roots {V : Type*} (G : SimpleGraph V)
    (h : TreeCount.CommonRootCopies Star G 3) : ThreeThree.IsContained G := by
  obtain ⟨r, f, hf, hr⟩ := h
  have hcent : Function.Injective (fun i : Fin 3 => f i (.inl 0)) := by
    intro i j he
    apply hf
    apply Copy.ext
    intro v
    cases v with
    | inl a =>
      have ha : a = 0 := Subsingleton.elim _ _
      subst a
      exact he
    | inr a => rw [hr, hr]
  have hcross (i j : Fin 3) : f i (.inl 0) ≠ r j := by
    intro he
    rw [← hr i j] at he
    exact Sum.inl_ne_inr ((f i).injective he)
  refine ⟨{ toHom := { toFun := Sum.elim (fun i => f i (.inl 0)) r, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    cases u with
    | inl i =>
      cases v with
      | inl j => simp [ThreeThree, completeBipartiteGraph] at h
      | inr j =>
        change G.Adj (f i (.inl 0)) (r j)
        rw [← hr i j]
        exact (f i).toHom.map_adj (by simp [Star, completeBipartiteGraph])
    | inr i =>
      cases v with
      | inl j =>
        change G.Adj (r i) (f j (.inl 0))
        rw [← hr j i]
        exact (f j).toHom.map_adj (by simp [Star, completeBipartiteGraph])
      | inr j => simp [ThreeThree, completeBipartiteGraph] at h
  · exact Sum.elim_injective.mpr ⟨hcent, r.injective, hcross⟩

theorem edge_upper {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hn : 1 ≤ Fintype.card V) (hfree : ThreeThree.Free G) :
    (G.edgeFinset.card : ℝ) ≤ 10 * (Fintype.card V : ℝ) ^ ((5 : ℝ)/3) := by
  have h := TreeCount.edge_bound_real Star star_tree 2 G hn
    (fun hc => hfree (contained_of_common_roots G hc))
  norm_num only [Fintype.card_sum, Fintype.card_fin] at h
  exact h

theorem extremal_upper (n : ℕ) (hn : 1 ≤ n) :
    (extremalNumber n ThreeThree : ℝ) ≤ 10 * (n : ℝ) ^ ((5 : ℝ)/3) := by
  have h := (extremalNumber_le_iff_of_nonneg (V := Fin n) ThreeThree
    (show (0 : ℝ) ≤ 10 * (n : ℝ)^((5 : ℝ)/3) by positivity)).mpr (by
      intro G _ hfree
      simpa only [Fintype.card_fin] using edge_upper G (by simpa using hn) hfree)
  simpa only [Fintype.card_fin] using h

end K33Upper



namespace K33Case

/-- The complete bipartite graph K₃,₃ witnesses the exponent 5/3. -/
theorem exponent_five_thirds :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta atTop
        (fun n : ℕ => (extremalNumber n G : ℝ))
        (fun n : ℕ => (n : ℝ) ^ ((5 / 3 : ℚ) : ℝ)) := by
  let H := completeBipartiteGraph (Fin 3) (Fin 3)
  let e : (Fin 3 ⊕ Fin 3) ≃ Fin 6 := finSumFinEquiv
  let G := H.map e.toEmbedding
  have hbip : H.IsBipartite := by
    have h := (CompleteBipartiteGraph.bicoloring (Fin 3) (Fin 3)).colorable
    simpa only [Fintype.card_bool] using h
  refine ⟨6, G, hbip.map e.toEmbedding, ?_⟩
  have heq : ∀ n, extremalNumber n G = extremalNumber n H := fun _ =>
    (extremalNumber_congr_right (SimpleGraph.Iso.map e H)).symm
  have hpow : ((5 / 3 : ℚ) : ℝ) = (5 : ℝ) / 3 := by norm_num
  constructor
  · apply Asymptotics.IsBigO.of_bound 10
    filter_upwards [eventually_ge_atTop 27] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _),
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), heq, hpow]
    exact K33Upper.extremal_upper n (by omega)
  · apply Asymptotics.IsBigO.of_bound 354294
    filter_upwards [eventually_ge_atTop 27] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), abs_of_nonneg (Nat.cast_nonneg _),
      heq, hpow]
    exact BrownAlgebra.extremal_lower n hn

end K33Case

namespace NormSystem

open Finset

/-- A pole in one coordinate would require a distinct small factor for each row,
but the pole coordinate is unavailable. -/
theorem valuation_le_one_of_product_system {I K Γ : Type*}
    [Fintype I] [Field K] [LinearOrderedCommGroupWithZero Γ]
    (v : Valuation K Γ) (a : I → I → K) (b : I → K) (x : I → K)
    (ha : ∀ i j, v (a i j) ≤ 1)
    (hdiff : ∀ i i' j, i ≠ i' → v (a i j - a i' j) = 1)
    (hb : ∀ i, v (b i) = 1)
    (heq : ∀ i, ∏ j, (x j - a i j) = b i) :
    ∀ j, v (x j) ≤ 1 := by
  classical
  intro j₀
  by_contra hj₀
  have hpole : 1 < v (x j₀) := lt_of_not_ge hj₀
  have hlarge (i : I) : 1 < v (x j₀ - a i j₀) := by
    rw [v.map_sub_eq_of_lt_left ((ha i j₀).trans_lt hpole)]
    exact hpole
  have hprod (i : I) : (∏ j, v (x j - a i j)) = 1 := by
    rw [← map_prod, heq, hb]
  have hsmall : ∀ i, ∃ j, v (x j - a i j) < 1 := by
    intro i
    by_contra! hn
    have ht : 1 < ∏ j, v (x j - a i j) :=
      (one_lt_prod_iff_of_one_le (fun j _ => hn j)).mpr ⟨j₀, mem_univ _, hlarge i⟩
    rw [hprod] at ht
    exact lt_irrefl _ ht
  choose f hf using hsmall
  have hfinj : Function.Injective f := by
    intro i i' hfi
    by_contra hii'
    have hi := hf i
    have hi' := hf i'
    rw [← hfi] at hi'
    have hlt := v.map_sub_lt hi hi'
    have hid : (x (f i) - a i (f i)) - (x (f i) - a i' (f i)) =
        a i' (f i) - a i (f i) := by ring
    rw [hid, hdiff i' i (f i) (Ne.symm hii')] at hlt
    exact lt_irrefl _ hlt
  obtain ⟨i, hi⟩ := (Finite.surjective_of_injective hfinj) j₀
  have hs := hf i
  rw [hi] at hs
  exact (not_lt_of_ge (hlarge i).le) hs

/-- Separated coefficients and unit right-hand sides force every solution
coordinate to be integral over the coefficient ring. -/
theorem isIntegral_of_product_system {I R K : Type*}
    [Fintype I] [CommRing R] [Field K] [Algebra R K]
    (a : I → I → R) (b : I → R) (x : I → K)
    (hdiff : ∀ i i' j, i ≠ i' → IsUnit (a i j - a i' j))
    (hb : ∀ i, IsUnit (b i))
    (heq : ∀ i, ∏ j, (x j - algebraMap R K (a i j)) = algebraMap R K (b i)) :
    ∀ j, IsIntegral R (x j) := by
  classical
  intro j
  by_contra hj
  have hnot : x j ∉ (integralClosure R K).toSubring := hj
  obtain ⟨O, hO, hxO⟩ := Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hnot
  have hcoeff (r : R) : algebraMap R K r ∈ O := hO ((integralClosure R K).algebraMap_mem r)
  let f : R →+* O := (algebraMap R K).codRestrict O.toSubring hcoeff
  have hunit (r : R) (hr : IsUnit r) : O.valuation (algebraMap R K r) = 1 :=
    (O.valuation_eq_one_iff (f r)).mp (hr.map f)
  have hbound := valuation_le_one_of_product_system O.valuation
    (fun i j => algebraMap R K (a i j)) (fun i => algebraMap R K (b i)) x
    (fun i j => (O.valuation_le_one_iff _).mpr (hcoeff _))
    (by
      intro i i' j hij
      rw [← map_sub]
      exact hunit _ (hdiff i i' j hij))
    (fun i => hunit _ (hb i)) heq
  exact hxO ((O.valuation_le_one_iff _).mp (hbound j))


/-- In a noetherian algebra, integrality can be checked modulo its minimal
primes. Multiplying the finitely many monic relations gives a nilpotent value. -/
lemma isIntegral_of_mod_minimalPrimes {R A : Type*}
    [CommRing R] [CommRing A] [Algebra R A] [IsNoetherianRing A]
    (x : A) (h : ∀ p ∈ minimalPrimes A, IsIntegral R (Ideal.Quotient.mk p x)) :
    IsIntegral R x := by
  classical
  letI : Fintype (minimalPrimes A) := (minimalPrimes.finite_of_isNoetherianRing A).fintype
  have hp : ∀ p : minimalPrimes A, ∃ f : Polynomial R, f.Monic ∧ Polynomial.aeval x f ∈ p.val := by
    intro p
    obtain ⟨f, hf, hfx⟩ := h p.val p.prop
    refine ⟨f, hf, Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
    have he := Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ R p.val) x f
    rw [Polynomial.aeval_def] at he
    exact he.symm.trans hfx
  choose f hf hfx using hp
  let g : Polynomial R := ∏ p : minimalPrimes A, f p
  have hg : g.Monic := Polynomial.monic_prod_of_monic _ _ (fun p _ => hf p)
  have hnil : Polynomial.aeval x g ∈ (⊥ : Ideal A).radical := by
    rw [← Ideal.sInf_minimalPrimes, Ideal.mem_sInf]
    intro p hp
    let p' : minimalPrimes A := ⟨p, hp⟩
    change Polynomial.aeval x (∏ p : minimalPrimes A, f p) ∈ p
    rw [map_prod, ← mul_prod_erase univ (fun q : minimalPrimes A => Polynomial.aeval x (f q)) (mem_univ p')]
    exact p.mul_mem_right _ (hfx p')
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hnil
  refine ⟨g ^ n, hg.pow n, ?_⟩
  rw [← Polynomial.aeval_def, map_pow]
  exact Ideal.mem_bot.mp hn

/-- The valuation argument also applies to noetherian algebras with zero divisors,
by passing through the fraction fields of their prime quotients. -/
theorem isIntegral_of_product_system_noetherian {I R A : Type*}
    [Fintype I] [CommRing R] [CommRing A] [Algebra R A] [IsNoetherianRing A]
    (a : I → I → R) (b : I → R) (x : I → A)
    (hdiff : ∀ i i' j, i ≠ i' → IsUnit (a i j - a i' j))
    (hb : ∀ i, IsUnit (b i))
    (heq : ∀ i, ∏ j, (x j - algebraMap R A (a i j)) = algebraMap R A (b i)) :
    ∀ j, IsIntegral R (x j) := by
  intro j
  apply isIntegral_of_mod_minimalPrimes (x j)
  intro p hp
  letI : p.IsPrime := Ideal.minimalPrimes_isPrime hp
  let Q := A ⧸ p
  let K := FractionRing Q
  let f : A →ₐ[R] K := (IsScalarTower.toAlgHom R Q K).comp (Ideal.Quotient.mkₐ R p)
  have hx : ∀ j, IsIntegral R (f (x j)) :=
    isIntegral_of_product_system a b (fun j => f (x j)) hdiff hb (by
      intro i
      have h := congrArg f (heq i)
      simpa only [map_prod, map_sub, AlgHom.commutes] using h)
  exact (isIntegral_algebraMap_iff (R := R) (IsFractionRing.injective Q K)).mp (hx j)


namespace Universal

noncomputable section

abbrev ParamIndex (t : ℕ) := (Fin t × Fin t) ⊕ Fin t
abbrev ParamRing (t : ℕ) := MvPolynomial (ParamIndex t) ℤ
abbrev DiffIndex (t : ℕ) := {d : (Fin t × Fin t) × Fin t // d.1.1 ≠ d.1.2}

def paramA (t : ℕ) (i j : Fin t) : ParamRing t := MvPolynomial.X (.inl (i, j))
def paramB (t : ℕ) (i : Fin t) : ParamRing t := MvPolynomial.X (.inr i)

def denominator (t : ℕ) : ParamRing t :=
  (∏ i, paramB t i) * ∏ d : DiffIndex t, (paramA t d.val.1.1 d.val.2 - paramA t d.val.1.2 d.val.2)

abbrev CoeffRing (t : ℕ) := Localization.Away (denominator t)

instance (t : ℕ) : CommRing (CoeffRing t) := inferInstanceAs (CommRing (Localization.Away (denominator t)))

def coeffA (t : ℕ) (i j : Fin t) : CoeffRing t := algebraMap (ParamRing t) (CoeffRing t) (paramA t i j)
def coeffB (t : ℕ) (i : Fin t) : CoeffRing t := algebraMap (ParamRing t) (CoeffRing t) (paramB t i)

lemma coeff_units (t : ℕ) :
    (∀ i, IsUnit (coeffB t i)) ∧ (∀ i i' j, i ≠ i' → IsUnit (coeffA t i j - coeffA t i' j)) := by
  have h := IsLocalization.Away.algebraMap_isUnit (S := CoeffRing t) (denominator t)
  change IsUnit ((algebraMap (ParamRing t) (CoeffRing t))
    ((∏ i, paramB t i) * ∏ d : DiffIndex t,
      (paramA t d.val.1.1 d.val.2 - paramA t d.val.1.2 d.val.2))) at h
  rw [map_mul, IsUnit.mul_iff, map_prod, map_prod] at h
  constructor
  · intro i
    exact IsUnit.prod_iff.mp h.1 i (mem_univ _)
  · intro i i' j hij
    have hd := IsUnit.prod_iff.mp h.2 (⟨((i, i'), j), hij⟩ : DiffIndex t) (mem_univ _)
    simpa only [map_sub] using hd

def relation (t : ℕ) (i : Fin t) : MvPolynomial (Fin t) (CoeffRing t) :=
  (∏ j, (MvPolynomial.X j - MvPolynomial.C (coeffA t i j))) - MvPolynomial.C (coeffB t i)

def relationIdeal (t : ℕ) : Ideal (MvPolynomial (Fin t) (CoeffRing t)) :=
  Ideal.span (Set.range (relation t))

abbrev SolutionRing (t : ℕ) := MvPolynomial (Fin t) (CoeffRing t) ⧸ relationIdeal t

def coord (t : ℕ) (j : Fin t) : SolutionRing t := Ideal.Quotient.mk (relationIdeal t) (MvPolynomial.X j)

lemma relations_hold (t : ℕ) (i : Fin t) :
    ∏ j, (coord t j - algebraMap (CoeffRing t) (SolutionRing t) (coeffA t i j)) =
      algebraMap (CoeffRing t) (SolutionRing t) (coeffB t i) := by
  have hzero : (Ideal.Quotient.mkₐ (CoeffRing t) (relationIdeal t)) (relation t i) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
  simp only [relation, map_sub, map_prod] at hzero
  exact sub_eq_zero.mp hzero

lemma coord_integral (t : ℕ) (j : Fin t) : IsIntegral (CoeffRing t) (coord t j) :=
  isIntegral_of_product_system_noetherian (coeffA t) (coeffB t) (coord t)
    (coeff_units t).2 (coeff_units t).1 (relations_hold t) j

noncomputable def eliminant (t : ℕ) (j : Fin t) : Polynomial (CoeffRing t) :=
  Classical.choose (coord_integral t j)

lemma eliminant_monic (t : ℕ) (j : Fin t) : (eliminant t j).Monic :=
  (Classical.choose_spec (coord_integral t j)).1

lemma eliminant_zero (t : ℕ) (j : Fin t) :
    Polynomial.eval₂ (algebraMap (CoeffRing t) (SolutionRing t)) (coord t j) (eliminant t j) = 0 :=
  (Classical.choose_spec (coord_integral t j)).2


section Specialize

variable {t : ℕ} {K : Type*} [Field K]
    (a : Fin t → Fin t → K) (b : Fin t → K)

def evalParams : ParamRing t →+* K :=
  MvPolynomial.eval₂Hom (Int.castRingHom K) (Sum.elim (fun ij => a ij.1 ij.2) b)

@[simp] lemma evalParams_A (i j : Fin t) : evalParams a b (paramA t i j) = a i j := by
  simp [evalParams, paramA]

@[simp] lemma evalParams_B (i : Fin t) : evalParams a b (paramB t i) = b i := by
  simp [evalParams, paramB]

variable (hdiff : ∀ i i' j, i ≠ i' → a i j ≠ a i' j) (hb : ∀ i, b i ≠ 0)

include hdiff hb in
lemma eval_denominator_ne : evalParams a b (denominator t) ≠ 0 := by
  simp only [denominator, map_mul, map_prod, map_sub, evalParams_A, evalParams_B]
  exact mul_ne_zero (prod_ne_zero_iff.mpr (fun i _ => hb i))
    (prod_ne_zero_iff.mpr (fun d _ => sub_ne_zero.mpr (hdiff _ _ _ d.prop)))

def specialize : CoeffRing t →+* K :=
  IsLocalization.Away.lift (denominator t) (isUnit_iff_ne_zero.mpr (eval_denominator_ne a b hdiff hb))

@[simp] lemma specialize_A (i j : Fin t) : specialize a b hdiff hb (coeffA t i j) = a i j := by
  simp only [specialize, coeffA, IsLocalization.Away.lift_eq, evalParams_A]

@[simp] lemma specialize_B (i : Fin t) : specialize a b hdiff hb (coeffB t i) = b i := by
  simp only [specialize, coeffB, IsLocalization.Away.lift_eq, evalParams_B]

variable (x : Fin t → K) (heq : ∀ i, ∏ j, (x j - a i j) = b i)

include heq in
lemma relationIdeal_le_ker :
    relationIdeal t ≤ RingHom.ker (MvPolynomial.eval₂Hom (specialize a b hdiff hb) x) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  change MvPolynomial.eval₂Hom (specialize a b hdiff hb) x (relation t i) = 0
  simp [relation, heq]

def evalSolution : SolutionRing t →+* K :=
  Ideal.Quotient.lift (relationIdeal t) (MvPolynomial.eval₂Hom (specialize a b hdiff hb) x)
    (fun _ hz => relationIdeal_le_ker a b hdiff hb x heq hz)

@[simp] lemma evalSolution_coord (j : Fin t) : evalSolution a b hdiff hb x heq (coord t j) = x j := by
  simp [evalSolution, coord]

@[simp] lemma evalSolution_coeff (r : CoeffRing t) :
    evalSolution a b hdiff hb x heq (algebraMap (CoeffRing t) (SolutionRing t) r) =
      specialize a b hdiff hb r := by
  change (Ideal.Quotient.lift _ _ _) (Ideal.Quotient.mk _ (MvPolynomial.C r)) = _
  simp

include heq in
lemma eliminant_specialized_zero (j : Fin t) :
    Polynomial.eval (x j) ((eliminant t j).map (specialize a b hdiff hb)) = 0 := by
  have h := congrArg (evalSolution a b hdiff hb x heq) (eliminant_zero t j)
  rw [Polynomial.hom_eval₂, map_zero, evalSolution_coord] at h
  have hf : (evalSolution a b hdiff hb x heq).comp (algebraMap (CoeffRing t) (SolutionRing t)) =
      specialize a b hdiff hb := by
    ext r
    exact evalSolution_coeff a b hdiff hb x heq r
  rw [hf] at h
  simpa only [Polynomial.eval_map] using h

end Specialize

/-- A field-independent bound. Its size is immaterial for the extremal applications. -/
def bound (t : ℕ) : ℕ := ∏ j : Fin t, (eliminant t j).natDegree

/-- A finite set of solutions of a separated product system has bounded size,
uniformly over all fields and all choices of coefficients. -/
theorem card_solutions_le {t : ℕ} {K : Type*} [Field K]
    (a : Fin t → Fin t → K) (b : Fin t → K)
    (hdiff : ∀ i i' j, i ≠ i' → a i j ≠ a i' j) (hb : ∀ i, b i ≠ 0)
    (S : Finset (Fin t → K)) (hS : ∀ x ∈ S, ∀ i, ∏ j, (x j - a i j) = b i) :
    S.card ≤ bound t := by
  classical
  let P (j : Fin t) := (eliminant t j).map (specialize a b hdiff hb)
  let roots (j : Fin t) := (P j).roots.toFinset
  have hm (j : Fin t) : (P j).Monic := (eliminant_monic t j).map _
  have hr (x : S) (j : Fin t) : x.val j ∈ roots j := by
    rw [Multiset.mem_toFinset, Polynomial.mem_roots (hm j).ne_zero]
    exact eliminant_specialized_zero a b hdiff hb x.val (hS x.val x.prop) j
  let f : S → (∀ j, ↥(roots j)) := fun x j => ⟨x.val j, hr x j⟩
  have hfi : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    funext j
    exact congrArg Subtype.val (congrFun h j)
  have hc := Fintype.card_le_of_injective f hfi
  rw [Fintype.card_coe, Fintype.card_pi] at hc
  refine hc.trans (Finset.prod_le_prod' (fun j _ => ?_))
  rw [Fintype.card_coe]
  exact (Multiset.toFinset_card_le _).trans (Polynomial.card_roots_map_le_natDegree _)

end

end Universal


namespace NormGraphAlgebra

noncomputable section

variable {t : ℕ} {K : Type*} [Field K]

def norm (σ : Fin t → K →+* K) (x : K) : K := ∏ j, σ j x

lemma norm_mul (σ : Fin t → K →+* K) (x y : K) : norm σ (x * y) = norm σ x * norm σ y := by
  simp [norm, map_mul, prod_mul_distrib]

lemma norm_div (σ : Fin t → K →+* K) (x y : K) : norm σ (x / y) = norm σ x / norm σ y := by
  simp [norm, map_div₀, prod_div_distrib]

lemma norm_ne_zero (σ : Fin t → K →+* K) {x : K} (hx : x ≠ 0) : norm σ x ≠ 0 := by
  classical
  exact prod_ne_zero_iff.mpr (fun j _ => (map_ne_zero (σ j)).mpr hx)

lemma norm_zero (σ : Fin t → K →+* K) (ht : 0 < t) : norm σ 0 = 0 := by
  haveI : Nonempty (Fin t) := ⟨⟨0, ht⟩⟩
  simp [norm, Nat.ne_of_gt ht]

/-- A common neighbor forces distinct first coordinates among distinct vertices. -/
lemma first_injective_of_common_neighbor (σ : Fin t → K →+* K)
    (v : Fin (t+1) → K × Kˣ) (hv : Function.Injective v) (w : K × Kˣ)
    (hw : ∀ i, norm σ (w.1 + (v i).1) = ((v i).2 : K) * (w.2 : K)) :
    Function.Injective (fun i => (v i).1) := by
  intro i i' hii'
  have h := (hw i).symm.trans ((congrArg (fun a => norm σ (w.1 + a)) hii').trans (hw i'))
  have h' : (v i).2 = (v i').2 := Units.ext (mul_right_cancel₀ (Units.ne_zero w.2) h)
  exact hv (Prod.ext hii' h')

/-- The fractional-linear normalization underlying the norm-graph bound. -/
lemma normalized_product (σ : Fin t → K →+* K) (x y y₀ : K)
    (hxy : x + y₀ ≠ 0) (hδ : y - y₀ ≠ 0) :
    (∏ j, (σ j ((x + y₀)⁻¹) - -(σ j (y-y₀))⁻¹)) =
      norm σ (x + y) / (norm σ (x + y₀) * norm σ (y-y₀)) := by
  have heq : (x+y₀)⁻¹ + (y-y₀)⁻¹ = (x+y) / ((x+y₀)*(y-y₀)) := by
    field_simp
    ring
  calc
    _ = norm σ ((x+y₀)⁻¹ + (y-y₀)⁻¹) := by simp [norm, map_add, map_inv₀]
    _ = _ := by rw [heq, norm_div, norm_mul]

/-- A norm graph has at most a uniformly bounded number of common neighbors
of `t+1` distinct vertices. The bound depends only on `t`, not on the field. -/
theorem card_common_neighbors_le (σ : Fin t → K →+* K) (ht : 0 < t)
    (v : Fin (t+1) → K × Kˣ) (hv : Function.Injective v)
    (S : Finset (K × Kˣ))
    (hS : ∀ w ∈ S, ∀ i, norm σ (w.1 + (v i).1) = ((v i).2 : K) * (w.2 : K)) :
    S.card ≤ Universal.bound t := by
  classical
  obtain hSempty | ⟨w₀, hw₀⟩ := S.eq_empty_or_nonempty
  · simp [hSempty]
  have hv₁ := first_injective_of_common_neighbor σ v hv w₀ (hS w₀ hw₀)
  let δ (i : Fin t) := (v i.succ).1 - (v 0).1
  have hδ (i : Fin t) : δ i ≠ 0 := sub_ne_zero.mpr (hv₁.ne (Fin.succ_ne_zero i))
  let a (i j : Fin t) := -(σ j (δ i))⁻¹
  let b (i : Fin t) := ((v i.succ).2 : K) / (((v 0).2 : K) * norm σ (δ i))
  have hb (i : Fin t) : b i ≠ 0 :=
    div_ne_zero (Units.ne_zero _) (mul_ne_zero (Units.ne_zero _) (norm_ne_zero σ (hδ i)))
  have ha (i i' j : Fin t) (hii' : i ≠ i') : a i j ≠ a i' j := by
    intro h
    apply hii'
    apply Fin.succ_injective
    apply hv₁
    have hd : δ i = δ i' := (σ j).injective (inv_injective (neg_injective h))
    exact sub_left_injective hd
  let sol (w : K × Kˣ) (j : Fin t) := σ j ((w.1 + (v 0).1)⁻¹)
  have heq (w : K × Kˣ) (hw : w ∈ S) (i : Fin t) : ∏ j, (sol w j - a i j) = b i := by
    have hn0 : norm σ (w.1 + (v 0).1) ≠ 0 := by
      rw [hS w hw 0]
      exact mul_ne_zero (Units.ne_zero _) (Units.ne_zero _)
    have hx0 : w.1 + (v 0).1 ≠ 0 := by
      intro h
      exact hn0 (h ▸ norm_zero σ ht)
    change (∏ j, (σ j ((w.1 + (v 0).1)⁻¹) - -(σ j ((v i.succ).1 - (v 0).1))⁻¹)) = _
    rw [normalized_product σ _ _ _ hx0 (hδ i), hS w hw i.succ, hS w hw 0]
    dsimp only [b, δ]
    field_simp
  have hsol : Set.InjOn sol ↑S := by
    intro w hw z hz he
    have hfirst : w.1 = z.1 := by
      have hh := congrFun he ⟨0, ht⟩
      exact add_right_cancel (inv_injective ((σ ⟨0, ht⟩).injective hh))
    have hprod : ((v 0).2 : K) * (w.2 : K) = ((v 0).2 : K) * (z.2 : K) := by
      rw [← hS w hw 0, ← hS z hz 0, hfirst]
    exact Prod.ext hfirst (Units.ext (mul_left_cancel₀ (Units.ne_zero _) hprod))
  rw [← Finset.card_image_of_injOn hsol]
  apply Universal.card_solutions_le a b ha hb
  rintro _ hx i
  obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hx
  exact heq w hw i

end

end NormGraphAlgebra


namespace FiniteNormGraph

open SimpleGraph

noncomputable section

variable (F E : Type*) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E]

def graph : SimpleGraph (E × Fˣ) where
  Adj x y := x ≠ y ∧ Algebra.norm F (x.1+y.1) = (x.2 : F) * (y.2 : F)
  symm := by
    intro x y h
    exact ⟨Ne.symm h.1, by simpa only [add_comm, mul_comm] using h.2⟩
  loopless := by intro x h; exact h.1 rfl

/-- Norm graphs avoid a fixed complete bipartite graph. -/
theorem graph_free [IsGalois F E] {t : ℕ} (ht : 0 < t) (hdim : Module.finrank F E = t) :
    (completeBipartiteGraph (Fin (t+1)) (Fin (Universal.bound t + 1))).Free (graph F E) := by
  classical
  let e : Fin t ≃ (E ≃ₐ[F] E) := Fintype.equivOfCardEq (by
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank, hdim])
  let σ : Fin t → E →+* E := fun j => (e j).toRingEquiv.toRingHom
  have hnorm (x : E) : NormGraphAlgebra.norm σ x = algebraMap F E (Algebra.norm F x) := by
    rw [Algebra.norm_eq_prod_automorphisms]
    exact e.prod_comp (fun a => a x)
  let lift : E × Fˣ → E × Eˣ := Prod.map id (Units.map (algebraMap F E).toMonoidHom)
  have hlift : Function.Injective lift := Prod.map_injective.mpr
    ⟨Function.injective_id, Units.map_injective (algebraMap F E).injective⟩
  rintro ⟨f⟩
  let v : Fin (t+1) → E × Eˣ := fun i => lift (f (.inl i))
  let w : Fin (Universal.bound t + 1) → E × Eˣ := fun j => lift (f (.inr j))
  have hv : Function.Injective v := hlift.comp (f.injective.comp Sum.inl_injective)
  have hw : Function.Injective w := hlift.comp (f.injective.comp Sum.inr_injective)
  have hadj (i : Fin (t+1)) (j : Fin (Universal.bound t+1)) :
      (graph F E).Adj (f (.inl i)) (f (.inr j)) := f.toHom.map_adj (by simp)
  have hprod (i : Fin (t+1)) (j : Fin (Universal.bound t+1)) :
      NormGraphAlgebra.norm σ ((w j).1 + (v i).1) = ((v i).2 : E) * ((w j).2 : E) := by
    have h := congrArg (algebraMap F E) (hadj i j).2
    rw [map_mul] at h
    simpa only [hnorm, lift, v, w, Prod.map_fst, Prod.map_snd, id_eq,
      Units.coe_map, MonoidHom.coe_coe, add_comm] using h
  have hc := NormGraphAlgebra.card_common_neighbors_le σ ht v hv (univ.image w) (by
    intro z hz i
    obtain ⟨j, _, rfl⟩ := mem_image.mp hz
    exact hprod i j)
  rw [card_image_of_injective _ hw, card_univ, Fintype.card_fin] at hc
  omega

variable [Fintype F] [Fintype E]

open Classical in
/-- All but at most two field elements give different neighbors of a vertex. -/
theorem degree_lower (x : E × Fˣ) : Fintype.card E - 2 ≤ (graph F E).degree x := by
  classical
  let S : Finset E := univ \ {-x.1, x.1}
  have hcard : Fintype.card E - 2 ≤ S.card := by
    have h := @card_le_card_sdiff_add_card E univ {-x.1, x.1} _
    have ht : ({-x.1, x.1} : Finset E).card ≤ 2 := by
      simpa using (card_insert_le (-x.1) {x.1})
    change Fintype.card E ≤ S.card + ({-x.1, x.1} : Finset E).card at h
    omega
  have hsum (y : S) : x.1 + y.val ≠ 0 := by
    have hy : y.val ≠ -x.1 ∧ y.val ≠ x.1 := by
          simpa only [S, Finset.mem_sdiff, mem_univ, true_and, mem_insert, mem_singleton, not_or] using y.prop
    intro h
    exact hy.1 (eq_neg_of_add_eq_zero_right h)
  let f : S → (graph F E).neighborSet x := fun y =>
    ⟨(y.val, Units.mk0 (Algebra.norm F (x.1+y.val) / (x.2 : F))
      (div_ne_zero (Algebra.norm_ne_zero_iff.mpr (hsum y)) (Units.ne_zero _))), by
      constructor
      · intro he
        have hfirst := congrArg Prod.fst he
        have hy : y.val ≠ -x.1 ∧ y.val ≠ x.1 := by
          simpa only [S, Finset.mem_sdiff, mem_univ, true_and, mem_insert, mem_singleton, not_or] using y.prop
        exact hy.2 hfirst.symm
      · dsimp
        field_simp⟩
  have hfi : Function.Injective f := by
    intro y z he
    exact Subtype.ext (congrArg (fun u => u.val.1) he)
  have hc := Fintype.card_le_of_injective f hfi
  rw [Fintype.card_coe, card_neighborSet_eq_degree] at hc
  exact hcard.trans hc


/-- The norm graph has the expected order of magnitude of edges. -/
theorem edge_count (hE : 4 ≤ Fintype.card E) (hF : 2 ≤ Fintype.card F) :
    Fintype.card E ^ 2 * Fintype.card F ≤ 8 * Nat.card (graph F E).edgeSet := by
  classical
  have h := sum_le_sum (s := (univ : Finset (E × Fˣ))) (fun x _ => degree_lower F E x)
  simp only [sum_const, card_univ, smul_eq_mul] at h
  rw [sum_degrees_eq_twice_card_edges, Fintype.card_prod, Fintype.card_units] at h
  have hE' : Fintype.card E ≤ 2 * (Fintype.card E - 2) := by omega
  have hF' : Fintype.card F ≤ 2 * (Fintype.card F - 1) := by omega
  rw [Nat.card_eq_fintype_card, card_edgeSet]
  calc
    Fintype.card E ^ 2 * Fintype.card F =
        Fintype.card E * Fintype.card F * Fintype.card E := by ring
    _ ≤ Fintype.card E * (2 * (Fintype.card F-1)) * (2 * (Fintype.card E-2)) := by gcongr
    _ = 4 * (Fintype.card E * (Fintype.card F-1) * (Fintype.card E-2)) := by ring
    _ ≤ 8 * (graph F E).edgeFinset.card := by omega

end

end FiniteNormGraph

end NormSystem


namespace KstUpper

open SimpleGraph

abbrev Star (s : ℕ) := completeBipartiteGraph (Fin 1) (Fin s)

lemma star_tree (s : ℕ) : (Star s).IsTree := by
  classical
  rw [isTree_iff_connected_and_card]
  constructor
  · apply (connected_iff_exists_forall_reachable _).mpr
    refine ⟨.inl 0, ?_⟩
    intro v
    cases v with
    | inl i =>
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      exact Reachable.refl _
    | inr j => exact (show (Star s).Adj (.inl 0) (.inr j) by simp [Star, completeBipartiteGraph]).reachable
  · have hl (i : Fin 1) : (Star s).degree (.inl i) = s := by
      have h := (Star s).degree_eq_sum_if_adj (R := ℕ) (.inl i)
      rw [Fintype.sum_sum_type] at h
      simpa [Star, completeBipartiteGraph] using h
    have hr (j : Fin s) : (Star s).degree (.inr j) = 1 := by
      have h := (Star s).degree_eq_sum_if_adj (R := ℕ) (.inr j)
      rw [Fintype.sum_sum_type] at h
      simpa [Star, completeBipartiteGraph] using h
    have h := (Star s).sum_degrees_eq_twice_card_edges
    simp only [Fintype.sum_sum_type, hl, hr, sum_const, card_univ, Fintype.card_fin,
      smul_eq_mul, one_mul, mul_one] at h
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, card_edgeSet, Fintype.card_sum,
      Fintype.card_fin, Fintype.card_fin]
    omega

lemma contained_of_common_roots {s t : ℕ} {V : Type*} (G : SimpleGraph V)
    (h : TreeCount.CommonRootCopies (Star s) G t) :
    (completeBipartiteGraph (Fin s) (Fin t)).IsContained G := by
  obtain ⟨r, f, hf, hr⟩ := h
  have hcent : Function.Injective (fun i : Fin t => f i (.inl 0)) := by
    intro i j he
    apply hf
    apply Copy.ext
    intro v
    cases v with
    | inl a =>
      have ha : a = 0 := Subsingleton.elim _ _
      subst a
      exact he
    | inr a => rw [hr, hr]
  have hcross (j : Fin s) (i : Fin t) : r j ≠ f i (.inl 0) := by
    intro he
    rw [← hr i j] at he
    exact Sum.inr_ne_inl ((f i).injective he)
  refine ⟨{ toHom := { toFun := Sum.elim r (fun i => f i (.inl 0)), map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    cases u with
    | inl i =>
      cases v with
      | inl j => simp [completeBipartiteGraph] at h
      | inr j =>
        change G.Adj (r i) (f j (.inl 0))
        rw [← hr j i]
        exact (f j).toHom.map_adj (by simp [Star, completeBipartiteGraph])
    | inr i =>
      cases v with
      | inl j =>
        change G.Adj (f i (.inl 0)) (r j)
        rw [← hr i j]
        exact (f i).toHom.map_adj (by simp [Star, completeBipartiteGraph])
      | inr j => simp [completeBipartiteGraph] at h
  · exact Sum.elim_injective.mpr ⟨r.injective, hcent, hcross⟩

theorem edge_upper {s t : ℕ} (hs : 1 ≤ s) {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (hn : 1 ≤ Fintype.card V)
    (hfree : (completeBipartiteGraph (Fin s) (Fin (t+1))).Free G) :
    (G.edgeFinset.card : ℝ) ≤ (2 * (t + 1) + (s+1)) *
      (Fintype.card V : ℝ) ^ (2 - 1 / (s : ℝ)) := by
  haveI : Nonempty (Fin s) := ⟨⟨0, by omega⟩⟩
  have h := TreeCount.edge_bound_real (Star s) (star_tree s) t G hn
    (fun hc => hfree (contained_of_common_roots G hc))
  simp only [Fintype.card_sum, Fintype.card_fin, Nat.add_sub_cancel_left] at h
  have hsr : (0 : ℝ) < s := by exact_mod_cast (by omega : 0 < s)
  have hexp : 1 + ((s-1 : ℕ) : ℝ) / s = 2 - 1 / (s : ℝ) := by
    rw [Nat.cast_sub hs, Nat.cast_one]
    field_simp
    ring
  rw [hexp] at h
  convert h using 1 <;> push_cast <;> ring

theorem extremal_upper (s t n : ℕ) (hs : 1 ≤ s) (hn : 1 ≤ n) :
    (extremalNumber n (completeBipartiteGraph (Fin s) (Fin (t+1))) : ℝ) ≤
      (2 * (t + 1) + (s+1)) * (n : ℝ) ^ (2 - 1 / (s : ℝ)) := by
  have h := (extremalNumber_le_iff_of_nonneg (V := Fin n) _
    (show (0 : ℝ) ≤ (2 * (t + 1) + (s+1)) * (n : ℝ) ^ (2 - 1 / (s : ℝ)) by positivity)).mpr (by
      intro G _ hfree
      simpa only [Fintype.card_fin] using edge_upper hs G (by simpa using hn) hfree)
  simpa only [Fintype.card_fin] using h

end KstUpper


namespace NormCase

open Filter SimpleGraph Finset

lemma free_map_of_no_isolated {U V W : Type*} {H : SimpleGraph U} {G : SimpleGraph V}
    (hH : ∀ u, ∃ v, H.Adj u v) (hfree : H.Free G) (f : V ↪ W) : H.Free (G.map f) := by
  classical
  rintro ⟨c⟩
  have hrange : ∀ u, ∃ v, f v = c u := by
    intro u
    obtain ⟨u', hu'⟩ := hH u
    obtain ⟨v, w, hvw, hv, hw⟩ := c.toHom.map_adj hu'
    exact ⟨v, hv⟩
  choose g hg using hrange
  apply hfree
  refine ⟨{ toHom := { toFun := g, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    apply (map_adj_apply (G := G) (f := f)).mp
    rw [hg, hg]
    exact c.toHom.map_adj h
  · intro u v h
    apply c.injective
    change c u = c v
    change g u = g v at h
    rw [← hg, ← hg, h]



abbrev Forbidden (t : ℕ) :=
  completeBipartiteGraph (Fin (t+1)) (Fin (NormSystem.Universal.bound t+1))

lemma field_extremal_lower (t p n : ℕ) (ht : 1 ≤ t) (hp : p.Prime) (hp4 : 4 ≤ p)
    (hn : p^(t+1) ≤ n) : p^(2*t+1) ≤ 8 * extremalNumber n (Forbidden t) := by
  classical
  letI : Fact p.Prime := ⟨hp⟩
  let F := ZMod p
  let E := GaloisField p t
  letI : Fintype E := Fintype.ofFinite E
  have hF : Fintype.card F = p := ZMod.card p
  have hE : Fintype.card E = p^t := by
    rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card p t (by omega)
  have hdim : Module.finrank F E = t := GaloisField.finrank p (by omega)
  have hE4 : 4 ≤ Fintype.card E := by
    rw [hE]
    exact hp4.trans (Nat.le_self_pow (by omega) p)
  have hF2 : 2 ≤ Fintype.card F := by rw [hF]; omega
  let G := NormSystem.FiniteNormGraph.graph F E
  have hfree : (Forbidden t).Free G := NormSystem.FiniteNormGraph.graph_free F E (by omega) hdim
  have he := NormSystem.FiniteNormGraph.edge_count F E hE4 hF2
  rw [hE, hF] at he
  have hcard : Fintype.card (E × Fˣ) ≤ Fintype.card (Fin n) := by
    rw [Fintype.card_fin, Fintype.card_prod, Fintype.card_units, hE, hF]
    calc
      p^t * (p-1) ≤ p^t * p := Nat.mul_le_mul_left _ (Nat.sub_le ..)
      _ = p^(t+1) := (pow_succ ..).symm
      _ ≤ n := hn
  let f : E × Fˣ ↪ Fin n := (Function.Embedding.nonempty_of_card_le hcard).some
  have hno : ∀ v, ∃ w, (Forbidden t).Adj v w := by
    intro v
    cases v with
    | inl i => exact ⟨.inr 0, by simp [Forbidden, completeBipartiteGraph]⟩
    | inr j => exact ⟨.inl 0, by simp [Forbidden, completeBipartiteGraph]⟩
  have hpad := card_edgeFinset_le_extremalNumber (free_map_of_no_isolated hno hfree f)
  have hmap := card_edgeFinset_map f G
  simp only [← card_edgeSet, ← Nat.card_eq_fintype_card] at hpad hmap
  rw [hmap] at hpad
  have hpad' : Nat.card G.edgeSet ≤ extremalNumber n (Forbidden t) := by
    simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using hpad
  have hexp : (p^t)^2 * p = p^(2*t+1) := by
    rw [← pow_mul, ← pow_succ]
    congr 1
    omega
  rw [hexp] at he
  exact he.trans (Nat.mul_le_mul_left 8 hpad')

lemma prime_at_power_scale (d n : ℕ) (hd : 1 ≤ d) (hn : 16^d ≤ n) :
    ∃ p : ℕ, p.Prime ∧ 4 ≤ p ∧ p^d ≤ n ∧ n ≤ (4*p)^d := by
  let k := (Nat.nthRoot d n) / 4
  have hs16 : 16 ≤ Nat.nthRoot d n := (Nat.le_nthRoot_iff (by omega)).mpr hn
  have hk4 : 4 ≤ k := by dsimp [k]; omega
  obtain ⟨p, hp, hkp, hpk⟩ := Nat.exists_prime_lt_and_le_two_mul k (by omega)
  refine ⟨p, hp, by omega, ?_, ?_⟩
  · have hks : 4*k ≤ Nat.nthRoot d n := by
      simpa only [k, Nat.mul_comm] using Nat.div_mul_le_self (Nat.nthRoot d n) 4
    exact (Nat.pow_le_pow_left (by omega : p ≤ Nat.nthRoot d n) d).trans
      (Nat.pow_nthRoot_le (Or.inl (by omega)))
  · have hkupper : Nat.nthRoot d n < 4*(k+1) := Nat.lt_mul_div_succ _ (by decide)
    have hps : Nat.nthRoot d n + 1 ≤ 4*p := by omega
    exact (Nat.lt_pow_nthRoot_add_one (by omega) n).le.trans (Nat.pow_le_pow_left hps d)

lemma rpow_bound (t n p : ℕ) (h : n ≤ (4*p)^(t+1)) :
    (n : ℝ) ^ (2 - 1 / (t+1 : ℝ)) ≤ (4 : ℝ)^(2*t+1) * (p : ℝ)^(2*t+1) := by
  have ht : (0 : ℝ) < (t+1 : ℝ) := by positivity
  have ha : 0 ≤ (2 : ℝ) - 1 / (t+1 : ℝ) := by
    have : 1 / (t+1 : ℝ) ≤ 1 := (div_le_one ht).mpr (by have := Nat.cast_nonneg (α := ℝ) t; linarith)
    linarith
  have hnp : (n : ℝ) ≤ (4*(p : ℝ))^(t+1) := by exact_mod_cast h
  have hpow := Real.rpow_le_rpow (Nat.cast_nonneg _) hnp ha
  rw [← Real.rpow_natCast_mul (by positivity)] at hpow
  have hexp : ((t+1 : ℕ) : ℝ) * (2 - 1 / (t+1 : ℝ)) = ((2*t+1 : ℕ) : ℝ) := by
    push_cast
    field_simp
    ring
  rw [hexp, Real.rpow_natCast, mul_pow] at hpow
  exact hpow

theorem extremal_lower (t n : ℕ) (ht : 1 ≤ t) (hn : 16^(t+1) ≤ n) :
    (n : ℝ) ^ (2 - 1 / (t+1 : ℝ)) ≤
      (8 * (4 : ℝ)^(2*t+1)) * (extremalNumber n (Forbidden t) : ℝ) := by
  obtain ⟨p, hp, hp4, hpn, hnp⟩ := prime_at_power_scale (t+1) n (by omega) hn
  have hl : (p : ℝ)^(2*t+1) ≤ 8 * (extremalNumber n (Forbidden t) : ℝ) := by
    exact_mod_cast field_extremal_lower t p n ht hp hp4 hpn
  calc
    _ ≤ (4 : ℝ)^(2*t+1) * (p : ℝ)^(2*t+1) := rpow_bound t n p hnp
    _ ≤ (4 : ℝ)^(2*t+1) * (8 * (extremalNumber n (Forbidden t) : ℝ)) := by gcongr
    _ = _ := by ring

theorem exponent (t : ℕ) (ht : 1 ≤ t) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta atTop
        (fun n : ℕ => (extremalNumber n G : ℝ))
        (fun n : ℕ => (n : ℝ) ^ ((2 - 1 / (t+1 : ℚ) : ℚ) : ℝ)) := by
  classical
  let T := NormSystem.Universal.bound t
  let e : (Fin (t+1) ⊕ Fin (T+1)) ≃ Fin ((t+1)+(T+1)) :=
    Fintype.equivFinOfCardEq (by simp)
  let G := (Forbidden t).map e.toEmbedding
  have hbip : (Forbidden t).IsBipartite := by
    simpa only [Fintype.card_bool] using
      (CompleteBipartiteGraph.bicoloring (Fin (t+1)) (Fin (T+1))).colorable
  refine ⟨(t+1)+(T+1), G, hbip.map e.toEmbedding, ?_⟩
  have heq : ∀ n, extremalNumber n G = extremalNumber n (Forbidden t) := fun _ =>
    (extremalNumber_congr_right (SimpleGraph.Iso.map e (Forbidden t))).symm
  have hpow : ((2 - 1 / (t+1 : ℚ) : ℚ) : ℝ) = 2 - 1 / (t+1 : ℝ) := by push_cast; rfl
  constructor
  · apply Asymptotics.IsBigO.of_bound (2 * (T+1) + ((t+1)+1) : ℝ)
    filter_upwards [eventually_ge_atTop 1] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _),
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), heq, hpow]
    simpa only [Nat.cast_add, Nat.cast_one] using KstUpper.extremal_upper (t+1) T n (by omega) hn
  · apply Asymptotics.IsBigO.of_bound (8 * (4 : ℝ)^(2*t+1))
    filter_upwards [eventually_ge_atTop (16^(t+1))] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), abs_of_nonneg (Nat.cast_nonneg _),
      heq, hpow]
    exact extremal_lower t n ht hn

end NormCase



end Erdos571


/- ## GenericAlgebraic -/

/- Finite interpolation for random algebraic graph constructions. -/

namespace GenericAlgebraic

open Finset MvPolynomial

open Classical in
/-- Distinct points admit delta interpolation with degree at most one less than
 the number of points. No hypothesis on the size of the field is needed. -/
theorem exists_lagrange {I σ K : Type*} [Fintype I] [Field K]
    (x : I → σ → K) (hx : Function.Injective x) (i : I) :
    ∃ p : MvPolynomial σ K, p.totalDegree ≤ Fintype.card I - 1 ∧
      ∀ j, eval (x j) p = if j = i then 1 else 0 := by
  classical
  let S := (univ : Finset I).erase i
  have hcoord (j : S) : ∃ k, x i k ≠ x j.val k := by
    have hne : x i ≠ x j.val := hx.ne (Ne.symm (mem_erase.mp j.prop).1)
    by_contra! hn
    exact hne (funext hn)
  choose k hk using hcoord
  let f (j : S) : MvPolynomial σ K :=
    C ((x i (k j) - x j.val (k j))⁻¹) * (X (k j) - C (x j.val (k j)))
  refine ⟨∏ j : S, f j, ?_, ?_⟩
  · have hd (j : S) : (f j).totalDegree ≤ 1 := by
      have h := totalDegree_mul (C ((x i (k j) - x j.val (k j))⁻¹))
        (X (k j) - C (x j.val (k j)))
      have hs := totalDegree_sub (X (k j) : MvPolynomial σ K) (C (x j.val (k j)))
      simp only [totalDegree_C, totalDegree_X, max_eq_left (by omega : 0 ≤ 1), zero_add] at h hs
      exact h.trans hs
    calc
      _ ≤ ∑ j : S, (f j).totalDegree := totalDegree_finset_prod _ _
      _ ≤ ∑ _j : S, 1 := sum_le_sum (fun j _ => hd j)
      _ = Fintype.card I - 1 := by simp [S]
  · intro j
    by_cases hji : j = i
    · subst j
      simp only [if_pos rfl, eval_prod, f, eval_mul, eval_C, eval_sub, eval_X]
      apply prod_eq_one
      intro j _
      exact inv_mul_cancel₀ (sub_ne_zero.mpr (hk j))
    · rw [if_neg hji, eval_prod]
      let j' : S := ⟨j, by simp [S, hji]⟩
      apply prod_eq_zero (mem_univ j')
      simp [f, j']

/-- Evaluation on any `r` distinct points is surjective in degree at least `r-1`. -/
theorem eval_surjective {I σ K : Type*} [Fintype I] [Field K]
    (x : I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : Fintype.card I - 1 ≤ d) :
    Function.Surjective (fun p : restrictTotalDegree σ K d => fun i => eval (x i) p.val) := by
  classical
  intro y
  choose p hp he using exists_lagrange x hx
  let q : MvPolynomial σ K := ∑ i, C (y i) * p i
  have hq : q.totalDegree ≤ d := totalDegree_finsetSum_le (fun i _ => by
    have h := totalDegree_mul (C (y i)) (p i)
    simp only [totalDegree_C, zero_add] at h
    exact h.trans ((hp i).trans hd))
  refine ⟨⟨q, (mem_restrictTotalDegree σ d q).mpr hq⟩, ?_⟩
  funext j
  simp [q, eval_sum, he]


noncomputable def evaluation {I σ K : Type*} [Field K]
    (x : I → σ → K) (d : ℕ) : restrictTotalDegree σ K d →ₗ[K] (I → K) :=
  LinearMap.pi (fun i => (aeval (x i)).toLinearMap.comp (restrictTotalDegree σ K d).subtype)

@[simp] lemma evaluation_apply {I σ K : Type*} [Field K]
    (x : I → σ → K) (d : ℕ) (p : restrictTotalDegree σ K d) (i : I) :
    evaluation x d p i = eval (x i) p.val := by
  rfl

/-- Every fiber of a surjective homomorphism of finite additive groups has the
same cardinality. This form avoids division and is convenient for averaging. -/
lemma card_fiber_mul_card {U V : Type*} [AddGroup U] [AddCommGroup V]
    [Finite U] [Finite V] (f : U →+ V) (hf : Function.Surjective f) (y : V) :
    Nat.card {u : U // f u = y} * Nat.card V = Nat.card U := by
  classical
  letI : Fintype U := Fintype.ofFinite U
  letI : Fintype V := Fintype.ofFinite V
  have hsame (z : V) : (univ.filter (fun u : U => f u = z)).card =
      (univ.filter (fun u : U => f u = y)).card :=
    AddMonoidHom.card_fiber_eq_of_mem_range f (hf z) (hf y)
  have hsum := sum_card_fiberwise_eq_card_filter (univ : Finset U) (univ : Finset V) f
  simp only [hsame, sum_const, card_univ, smul_eq_mul, mem_univ, filter_true] at hsum
  simpa only [Nat.card_eq_fintype_card, Fintype.card_subtype, mul_comm] using hsum

/-- Exact uniform distribution of low-degree polynomial evaluations at distinct
points. In particular, prescribed values on `r` points have probability `q⁻ʳ`. -/
theorem card_eval_fiber {I σ K : Type*} [Fintype I] [Finite σ] [Field K] [Finite K]
    (x : I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : Fintype.card I - 1 ≤ d) (y : I → K) :
    Nat.card {p : restrictTotalDegree σ K d // ∀ i, eval (x i) p.val = y i} *
      (Nat.card K) ^ Fintype.card I = Nat.card (restrictTotalDegree σ K d) := by
  letI : Finite (restrictTotalDegree σ K d) := Module.finite_of_finite K
  have hs : Function.Surjective (evaluation x d) := by
    intro z
    obtain ⟨p, hp⟩ := eval_surjective x hx d hd z
    refine ⟨p, ?_⟩
    funext i
    rw [evaluation_apply]
    exact congrFun hp i
  have h := card_fiber_mul_card (evaluation x d).toAddMonoidHom hs y
  simpa only [LinearMap.toAddMonoidHom_coe, _root_.funext_iff, evaluation_apply, Nat.card_fun,
    Nat.card_eq_fintype_card (α := I)] using h

end GenericAlgebraic



/- ## GenericDimension -/

/- Transcendence-degree constraints for generic algebraic graphs. -/

namespace GenericDimension

open Algebra Cardinal
open scoped IntermediateField.algebraAdjoinAdjoin in

lemma trdeg_field_adjoin_le {F E I : Type} [Field F] [Field E] [Algebra F E]
    (x : I → E) : trdeg F (IntermediateField.adjoin F (Set.range x)) ≤ Cardinal.mk I := by
  have hAlg : trdeg F (Algebra.adjoin F (Set.range x)) ≤ Cardinal.mk I := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    have h := trdeg_le_of_surjective (MvPolynomial.aeval (R := F) x).rangeRestrict
      (MvPolynomial.aeval (R := F) x).rangeRestrict_surjective
    simpa using h
  have h := trdeg_add_eq F (Algebra.adjoin F (Set.range x))
    (A := IntermediateField.adjoin F (Set.range x))
  have hz : trdeg (Algebra.adjoin F (Set.range x))
      (IntermediateField.adjoin F (Set.range x)) = 0 := trdeg_eq_zero
  rw [hz, add_zero] at h
  exact h ▸ hAlg

/-- Algebraic independence gives a cardinal lower bound on any set of field
 generators containing the independent family. -/
lemma card_le_of_mem_adjoin {F E I J : Type} [Field F] [Field E] [Algebra F E]
    [Fintype I] [Fintype J] (x : I → E) (hx : AlgebraicIndependent F x) (y : J → E)
    (hxy : ∀ i, x i ∈ IntermediateField.adjoin F (Set.range y)) :
    Fintype.card I ≤ Fintype.card J := by
  let L := IntermediateField.adjoin F (Set.range y)
  let x' : I → L := fun i => ⟨x i, hxy i⟩
  have hx' : AlgebraicIndependent F x' := AlgebraicIndependent.of_comp L.val hx
  have h := hx'.cardinalMk_le_trdeg.trans (trdeg_field_adjoin_le y)
  simpa only [Cardinal.mk_fintype, Nat.cast_le] using h


/-- Extending scalars by `n` field generators can decrease the linear rank of
an algebraically independent family by at most `n`. -/
theorem card_le_generators_add_spanrank {F E I J : Type}
    [Field F] [Field E] [Algebra F E] [Fintype I] [Fintype J]
    (x : I → E) (hx : AlgebraicIndependent F x) (z : J → E) :
    Fintype.card I ≤ Fintype.card J +
      Module.finrank (IntermediateField.adjoin F (Set.range z))
        (Submodule.span (IntermediateField.adjoin F (Set.range z)) (Set.range x)) := by
  classical
  let K := IntermediateField.adjoin F (Set.range z)
  let S := Submodule.span K (Set.range x)
  letI : FiniteDimensional K S := FiniteDimensional.span_of_finite K (Set.finite_range x)
  let b := Module.finBasis K S
  let y : J ⊕ Fin (Module.finrank K S) → E := Sum.elim z (fun i => (b i).val)
  let L := IntermediateField.adjoin F (Set.range y)
  have hK : K ≤ L := IntermediateField.adjoin_le_iff.mpr (by
    rintro _ ⟨j, rfl⟩
    exact IntermediateField.subset_adjoin F _ ⟨Sum.inl j, rfl⟩)
  have hB (i : Fin (Module.finrank K S)) : (b i).val ∈ L :=
    IntermediateField.subset_adjoin F _ ⟨Sum.inr i, rfl⟩
  have hS (v : S) : v.val ∈ L := by
    have hrep := congrArg (fun u : S => u.val) (b.sum_repr v)
    simp only [Submodule.coe_sum, Submodule.coe_smul, Algebra.smul_def,
      IntermediateField.algebraMap_apply] at hrep
    rw [← hrep]
    exact L.sum_mem (fun i _ => L.mul_mem (hK ((b.repr v) i).prop) (hB i))
  have h := card_le_of_mem_adjoin x hx y (fun i =>
    hS ⟨x i, Submodule.subset_span (Set.mem_range_self i)⟩)
  simpa only [Fintype.card_sum, Fintype.card_fin] using h


local instance {F E : Type} [Field F] [Field E] [Algebra F E]
    (K : IntermediateField F E) : Module K K := Semiring.toModule

/-- Independent linear relations on an algebraically independent coefficient
family require at least as many independent vertex parameters. -/
theorem relation_count_le_generators {F E I J R : Type}
    [Field F] [Field E] [Algebra F E] [Fintype I] [Fintype J] [Fintype R]
    (x : I → E) (hx : AlgebraicIndependent F x) (z : J → E)
    (w : R → I → IntermediateField.adjoin F (Set.range z))
    (hw : LinearIndependent (IntermediateField.adjoin F (Set.range z)) w)
    (hrel : ∀ r, ∑ i, (w r i : E) * x i = 0) :
    Fintype.card R ≤ Fintype.card J := by
  classical
  let K := IntermediateField.adjoin F (Set.range z)
  let f := Fintype.linearCombination K x
  have hker (r : R) : w r ∈ f.ker := by
    change f (w r) = 0
    simpa only [f, Fintype.linearCombination_apply, Algebra.smul_def,
      IntermediateField.algebraMap_apply] using hrel r
  let w' : R → f.ker := fun r => ⟨w r, hker r⟩
  have hw' : LinearIndependent K w' := LinearIndependent.of_comp f.ker.subtype hw
  have hr := hw'.fintype_card_le_finrank
  have hdim := f.finrank_range_add_finrank_ker
  rw [Module.finrank_pi] at hdim
  have hxcard := card_le_generators_add_spanrank x hx z
  change Fintype.card I ≤ Fintype.card J + Module.finrank K (Submodule.span K (Set.range x)) at hxcard
  have hrange : f.range = Submodule.span K (Set.range x) := Fintype.range_linearCombination K x
  rw [hrange] at hdim
  omega


lemma spanrank_add_relations_le_card {K E I R : Type*}
    [Field K] [Field E] [Algebra K E] [Fintype I] [Fintype R]
    (x : I → E) (w : R → I → K) (hw : LinearIndependent K w)
    (hrel : ∀ r, ∑ i, algebraMap K E (w r i) * x i = 0) :
    Module.finrank K (Submodule.span K (Set.range x)) + Fintype.card R ≤ Fintype.card I := by
  classical
  let f := Fintype.linearCombination K x
  have hker (r : R) : w r ∈ f.ker := by
    change f (w r) = 0
    simpa only [f, Fintype.linearCombination_apply, Algebra.smul_def] using hrel r
  let w' : R → f.ker := fun r => ⟨w r, hker r⟩
  have hw' : LinearIndependent K w' := LinearIndependent.of_comp f.ker.subtype hw
  have hr := hw'.fintype_card_le_finrank
  have hdim := f.finrank_range_add_finrank_ker
  rw [Module.finrank_pi] at hdim
  have hrange : f.range = Submodule.span K (Set.range x) := Fintype.range_linearCombination K x
  rw [hrange] at hdim
  omega

/-- The parameter count strengthens when some vertex coordinates themselves
are independent over the coefficient field. -/
theorem relation_count_add_independent_le_generators {F E I J R T : Type}
    [Field F] [Field E] [Algebra F E] [Fintype I] [Fintype J] [Fintype R] [Fintype T]
    (x : I → E) (z : J → E) (y : T → E)
    (hxy : AlgebraicIndependent F (Sum.elim x y))
    (hy : ∀ t, y t ∈ IntermediateField.adjoin F (Set.range z))
    (w : R → I → IntermediateField.adjoin F (Set.range z))
    (hw : LinearIndependent (IntermediateField.adjoin F (Set.range z)) w)
    (hrel : ∀ r, ∑ i, (w r i : E) * x i = 0) :
    Fintype.card R + Fintype.card T ≤ Fintype.card J + 1 := by
  classical
  let K := IntermediateField.adjoin F (Set.range z)
  let S := Submodule.span K (Set.range x)
  let S₁ := Submodule.span K ({1} : Set E)
  let S' := Submodule.span K (Set.range (Sum.elim x y))
  letI : FiniteDimensional K S := FiniteDimensional.span_of_finite K (Set.finite_range x)
  have hspan : S' ≤ S ⊔ S₁ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    cases i with
    | inl i => exact Submodule.mem_sup_left (Submodule.subset_span (Set.mem_range_self i))
    | inr t =>
      apply Submodule.mem_sup_right
      have h := S₁.smul_mem (⟨y t, hy t⟩ : K) (Submodule.subset_span (Set.mem_singleton 1))
      simpa only [Algebra.smul_def, IntermediateField.algebraMap_apply, mul_one] using h
  have hs := Submodule.finrank_mono hspan
  have hsup := S.finrank_sup_add_finrank_inf_eq S₁
  have h₁ : Module.finrank K S₁ = 1 := finrank_span_singleton (one_ne_zero : (1 : E) ≠ 0)
  have hc := card_le_generators_add_spanrank (Sum.elim x y) hxy z
  change Fintype.card (I ⊕ T) ≤ Fintype.card J + Module.finrank K S' at hc
  rw [Fintype.card_sum] at hc
  have hr := spanrank_add_relations_le_card x w hw hrel
  change Module.finrank K S + Fintype.card R ≤ Fintype.card I at hr
  omega

end GenericDimension





/- ## GenericPolynomial -/

/- Independent polynomial constraints and generic algebraic graph patterns. -/

namespace GenericPolynomial

open Finset MvPolynomial

abbrev Monomials (σ : Type*) (d : ℕ) := {m : σ →₀ ℕ // m.sum (fun _ e => e) ≤ d}

instance {σ : Type*} [Finite σ] (d : ℕ) : Finite (Monomials σ d) := by
  let b : Module.Basis (Monomials σ d) ℚ (restrictTotalDegree σ ℚ d) :=
    basisRestrictSupport ℚ _
  exact Module.Finite.finite_basis b

noncomputable instance {σ : Type*} [Finite σ] (d : ℕ) : Fintype (Monomials σ d) :=
  Fintype.ofFinite _

noncomputable def monomialBasis (σ K : Type*) [Field K] (d : ℕ) :
    Module.Basis (Monomials σ d) K (restrictTotalDegree σ K d) := basisRestrictSupport K _

lemma monomialBasis_apply {σ K : Type*} [Field K] (d : ℕ) (m : Monomials σ d) :
    (monomialBasis σ K d m).val = monomial m.val 1 := by
  classical
  exact Finsupp.supportedEquivFinsupp_symm_single _ m 1

/-- A surjective evaluation map gives linearly independent rows in every basis. -/
lemma evaluation_rows_independent {I σ K M : Type*} [Fintype I] [Fintype M] [Field K]
    (x : I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : Fintype.card I - 1 ≤ d) (b : Module.Basis M K (restrictTotalDegree σ K d)) :
    LinearIndependent K (fun i m => eval (x i) (b m).val) := by
  classical
  let f := GenericAlgebraic.evaluation x d
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨p, hp⟩ := GenericAlgebraic.eval_surjective x hx d hd y
    exact ⟨p, hp⟩
  have h₁ := (Pi.basisFun K I).dualBasis.linearIndependent.map' f.dualMap
    (LinearMap.ker_eq_bot.mpr (LinearMap.dualMap_injective_of_surjective hf))
  have h₂ := h₁.map' b.dualBasis.equivFun.toLinearMap
    (LinearMap.ker_eq_bot.mpr b.dualBasis.equivFun.injective)
  convert h₂ using 1
  ext i m
  simp only [Function.comp_def, LinearEquiv.coe_coe, Module.Basis.dualBasis_equivFun,
    LinearMap.dualMap_apply, Module.Basis.dualBasis_apply, Pi.basisFun_repr,
    GenericAlgebraic.evaluation_apply, f]

lemma monomial_rows_independent {I σ K : Type*} [Fintype I] [Finite σ] [Field K]
    (x : I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : Fintype.card I - 1 ≤ d) :
    LinearIndependent K (fun i (m : Monomials σ d) => eval (x i) (monomial m.val 1)) := by
  simpa only [monomialBasis_apply] using
    evaluation_rows_independent x hx d hd (monomialBasis σ K d)


open Classical in
noncomputable def blockRow {A R M K : Type*} [Field K] (v : R → M → K)
    (r : A × R) (m : A × M) : K := if r.1 = m.1 then v r.2 m.2 else 0

lemma blockRow_independent {A R M K : Type*} [Fintype A] [Fintype R] [Field K]
    (v : R → M → K) (hv : LinearIndependent K v) :
    LinearIndependent K (blockRow (A := A) v) := by
  classical
  apply Fintype.linearIndependent_iff.mpr
  intro g hg r
  have hrow : ∑ i : R, g (r.1, i) • v i = 0 := by
    funext m
    have h := congrFun hg (r.1, m)
    simpa only [Fintype.sum_prod_type, sum_apply, Pi.smul_apply, Pi.zero_apply,
      blockRow, smul_eq_mul, mul_ite, mul_zero, sum_ite_irrel, sum_const_zero,
      sum_ite_eq', mem_univ, if_true] using h
  exact (Fintype.linearIndependent_iff.mp hv) _ hrow r.2

noncomputable def polynomial {A σ K : Type*} [Finite σ] [CommSemiring K] {d : ℕ}
    (c : A × Monomials σ d → K) (a : A) : MvPolynomial σ K :=
  ∑ m, C (c (a,m)) * monomial m.val 1

local instance {F E : Type} [Field F] [Field E] [Algebra F E]
    (K : IntermediateField F E) : Module K K := Semiring.toModule

/-- Each point imposes one independent constraint on each generic polynomial.
Consequently their number is bounded by the number of vertex parameters. -/
theorem constraints_le_parameters {F E A R J σ : Type}
    [Field F] [Field E] [Algebra F E] [Fintype A] [Fintype R] [Fintype J] [Finite σ]
    (d : ℕ) (hd : Fintype.card R - 1 ≤ d)
    (c : A × Monomials σ d → E) (hc : AlgebraicIndependent F c) (z : J → E)
    (x : R → σ → IntermediateField.adjoin F (Set.range z)) (hx : Function.Injective x)
    (heq : ∀ a r, eval (fun j => (x r j : E)) (polynomial c a) = 0) :
    Fintype.card A * Fintype.card R ≤ Fintype.card J := by
  classical
  let K := IntermediateField.adjoin F (Set.range z)
  let v (r : R) (m : Monomials σ d) : K := eval (x r) (monomial m.val 1)
  have hv : LinearIndependent K v := monomial_rows_independent x hx d hd
  have hw := blockRow_independent (A := A) v hv
  have hrel (r : A × R) : ∑ m : A × Monomials σ d, ((blockRow v r m : K) : E) * c m = 0 := by
    have hmap (m : Monomials σ d) : (v r.2 m : E) =
        eval (fun j => (x r.2 j : E)) (monomial m.val (1 : E)) := by
      have h := MvPolynomial.map_eval (algebraMap K E) (x r.2) (monomial m.val (1 : K))
      simpa only [map_monomial, map_one, IntermediateField.algebraMap_apply] using h
    simp only [Fintype.sum_prod_type, blockRow, ite_eq_left_iff, apply_ite Subtype.val,
      IntermediateField.coe_zero, ite_mul, zero_mul, sum_ite_irrel, sum_const_zero,
      sum_ite_eq, mem_univ, if_true]
    have h := heq r.1 r.2
    simpa only [polynomial, eval_sum, eval_mul, eval_C, hmap, mul_comm] using h
  have h := GenericDimension.relation_count_le_generators c hc z (blockRow v) hw hrel
  simpa only [Fintype.card_prod] using h


/-- A bipartite configuration in a generic polynomial graph cannot have more
independent edge constraints than vertex parameters. -/
theorem bipartite_pattern_density {F E A L R : Type}
    [Field F] [Field E] [Algebra F E] [Fintype A] [Fintype L] [Fintype R]
    (b d : ℕ) (P : L → R → Prop) [DecidableRel P]
    (hd : Fintype.card {e : L × R // P e.1 e.2} - 1 ≤ d)
    (c : A × Monomials (Fin b ⊕ Fin b) d → E) (hc : AlgebraicIndependent F c)
    (z : L ⊕ R → Fin b → E)
    (hL : Function.Injective (fun l => z (.inl l)))
    (hR : Function.Injective (fun r => z (.inr r)))
    (heq : ∀ a (e : {e : L × R // P e.1 e.2}),
      eval (Sum.elim (z (.inl e.val.1)) (z (.inr e.val.2))) (polynomial c a) = 0) :
    Fintype.card A * Fintype.card {e : L × R // P e.1 e.2} ≤
      b * (Fintype.card L + Fintype.card R) := by
  classical
  let Z : (L ⊕ R) × Fin b → E := fun t => z t.1 t.2
  let K := IntermediateField.adjoin F (Set.range Z)
  let coord (v : L ⊕ R) (j : Fin b) : K :=
    ⟨z v j, IntermediateField.subset_adjoin F _ ⟨(v,j), rfl⟩⟩
  let x (e : {e : L × R // P e.1 e.2}) : Fin b ⊕ Fin b → K :=
    Sum.elim (coord (.inl e.val.1)) (coord (.inr e.val.2))
  have hx : Function.Injective x := by
    intro e f h
    apply Subtype.ext
    apply Prod.ext
    · apply hL
      funext j
      exact congrArg Subtype.val (congrFun h (.inl j))
    · apply hR
      funext j
      exact congrArg Subtype.val (congrFun h (.inr j))
  have heq' (a : A) (e : {e : L × R // P e.1 e.2}) :
      eval (fun j => (x e j : E)) (polynomial c a) = 0 := by
    have hfun : (fun j => (x e j : E)) = Sum.elim (z (.inl e.val.1)) (z (.inr e.val.2)) := by
      funext j
      cases j <;> rfl
    rw [hfun]
    exact heq a e
  have h := constraints_le_parameters d hd c hc Z x hx heq'
  simpa only [Fintype.card_prod, Fintype.card_sum, Fintype.card_fin, mul_comm] using h

end GenericPolynomial




/- ## GenericSymmetric -/

/- Symmetric polynomial constraints for uncoloured simple graphs. -/

namespace GenericSymmetric

open Finset MvPolynomial GenericPolynomial

lemma pair_sums_independent {I V K : Type*} [Fintype I] [Field K]
    [AddCommGroup V] [Module K V] (v : Bool × I → V) (hv : LinearIndependent K v) :
    LinearIndependent K (fun i => v (false,i) + v (true,i)) := by
  classical
  apply Fintype.linearIndependent_iff.mpr
  intro g hg i
  have hs : ∑ j : Bool × I, g j.2 • v j = 0 := by
    rw [Fintype.sum_prod_type, Fintype.sum_bool]
    simp only [smul_add, sum_add_distrib] at hg
    simpa only [add_comm] using hg
  exact (Fintype.linearIndependent_iff.mp hv) (fun j => g j.2) hs (false,i)

set_option maxHeartbeats 800000 in
lemma paired_rows_independent {I σ K : Type*} [Fintype I] [Finite σ] [Field K]
    (x : Bool × I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : 2 * Fintype.card I - 1 ≤ d) :
    LinearIndependent K (fun i (m : Monomials σ d) =>
      eval (x (false,i)) (monomial m.val 1) + eval (x (true,i)) (monomial m.val 1)) := by
  have h := monomial_rows_independent x hx d (by
    simpa only [Fintype.card_prod, Fintype.card_bool] using hd)
  exact pair_sums_independent (fun j (m : Monomials σ d) => eval (x j) (monomial m.val 1)) h

local instance {F E : Type} [Field F] [Field E] [Algebra F E]
    (K : IntermediateField F E) : Module K K := Semiring.toModule

/-- A version of the parameter inequality for symmetric edge equations, with
an additional independent family of vertex coordinates. -/
theorem constraints_add_independent_le_parameters {F E A R J σ T : Type}
    [Field F] [Field E] [Algebra F E] [Fintype A] [Fintype R] [Fintype J]
    [Finite σ] [Fintype T]
    (d : ℕ) (hd : 2 * Fintype.card R - 1 ≤ d)
    (c : A × Monomials σ d → E) (z : J → E) (y : T → E)
    (hcy : AlgebraicIndependent F (Sum.elim c y))
    (hy : ∀ t, y t ∈ IntermediateField.adjoin F (Set.range z))
    (x : Bool × R → σ → IntermediateField.adjoin F (Set.range z))
    (hx : Function.Injective x)
    (heq : ∀ a r,
      eval (fun j => (x (false,r) j : E)) (polynomial c a) +
      eval (fun j => (x (true,r) j : E)) (polynomial c a) = 0) :
    Fintype.card A * Fintype.card R + Fintype.card T ≤ Fintype.card J + 1 := by
  classical
  let K := IntermediateField.adjoin F (Set.range z)
  let v (r : R) (m : Monomials σ d) : K :=
    eval (x (false,r)) (monomial m.val 1) + eval (x (true,r)) (monomial m.val 1)
  have hv : LinearIndependent K v := paired_rows_independent x hx d hd
  have hw := blockRow_independent (A := A) v hv
  have hrel (r : A × R) : ∑ m : A × Monomials σ d, ((blockRow v r m : K) : E) * c m = 0 := by
    have hmap (s : Bool) (m : Monomials σ d) :
        ((eval (x (s,r.2)) (monomial m.val 1) : K) : E) =
          eval (fun j => (x (s,r.2) j : E)) (monomial m.val (1 : E)) := by
      have h := MvPolynomial.map_eval (algebraMap K E) (x (s,r.2)) (monomial m.val (1 : K))
      simpa only [map_monomial, map_one, IntermediateField.algebraMap_apply] using h
    simp only [Fintype.sum_prod_type, blockRow, apply_ite Subtype.val,
      IntermediateField.coe_zero, ite_mul, zero_mul, sum_ite_irrel, sum_const_zero,
      sum_ite_eq, mem_univ, if_true]
    have h := heq r.1 r.2
    simpa only [polynomial, eval_sum, eval_mul, eval_C, v,
      IntermediateField.coe_add, hmap, add_mul, mul_add, sum_add_distrib, mul_comm] using h
  have h := GenericDimension.relation_count_add_independent_le_generators c z y hcy hy
    (blockRow v) hw hrel
  simpa only [Fintype.card_prod] using h


noncomputable def orientedPair {V : Type*} (H : SimpleGraph V) (e : Bool × H.edgeSet) : V × V :=
  if e.1 then e.2.val.out.swap else e.2.val.out

lemma orientedPair_sym2 {V : Type*} (H : SimpleGraph V) (e : Bool × H.edgeSet) :
    s((orientedPair H e).1, (orientedPair H e).2) = e.2.val := by
  rcases e with ⟨b,e⟩
  cases b
  · exact e.val.out_eq
  · exact Sym2.eq_swap.trans e.val.out_eq

lemma orientedPair_adj {V : Type*} (H : SimpleGraph V) (e : Bool × H.edgeSet) :
    H.Adj (orientedPair H e).1 (orientedPair H e).2 := by
  change s((orientedPair H e).1, (orientedPair H e).2) ∈ H.edgeSet
  rw [orientedPair_sym2]
  exact e.2.prop

lemma orientedPair_injective {V : Type*} (H : SimpleGraph V) : Function.Injective (orientedPair H) := by
  classical
  rintro ⟨b,e⟩ ⟨c,f⟩ h
  have hef : e = f := by
    apply Subtype.ext
    have h' := congrArg (fun v : V × V => s(v.1,v.2)) h
    simpa only [orientedPair_sym2] using h'
  subst f
  cases b <;> cases c
  · rfl
  · have hne := (orientedPair_adj H (false,e)).ne
    exact (hne (congrArg Prod.fst h)).elim
  · have hne := (orientedPair_adj H (true,e)).ne
    exact (hne (congrArg Prod.fst h)).elim
  · rfl

/-- The generic dimension inequality for an arbitrary finite simple graph. -/
theorem graph_parameter_bound {F E A V T : Type}
    [Field F] [Field E] [Algebra F E] [Fintype A] [Fintype V] [Fintype T]
    (H : SimpleGraph V) (b d : ℕ) (hd : 2 * Nat.card H.edgeSet - 1 ≤ d)
    (c : A × Monomials (Fin b ⊕ Fin b) d → E) (z : V → Fin b → E) (y : T → E)
    (hcy : AlgebraicIndependent F (Sum.elim c y)) (hz : Function.Injective z)
    (hy : ∀ t, y t ∈ IntermediateField.adjoin F (Set.range (fun v : V × Fin b => z v.1 v.2)))
    (heq : ∀ a u v, H.Adj u v →
      eval (Sum.elim (z u) (z v)) (polynomial c a) +
        eval (Sum.elim (z v) (z u)) (polynomial c a) = 0) :
    Fintype.card A * Nat.card H.edgeSet + Fintype.card T ≤ b * Fintype.card V + 1 := by
  classical
  let Z : V × Fin b → E := fun t => z t.1 t.2
  let K := IntermediateField.adjoin F (Set.range Z)
  let coord (v : V) (j : Fin b) : K :=
    ⟨z v j, IntermediateField.subset_adjoin F _ ⟨(v,j), rfl⟩⟩
  let x (e : Bool × H.edgeSet) : Fin b ⊕ Fin b → K :=
    Sum.elim (coord (orientedPair H e).1) (coord (orientedPair H e).2)
  have hx : Function.Injective x := by
    intro e f h
    apply orientedPair_injective H
    apply Prod.ext
    · apply hz
      funext j
      exact congrArg Subtype.val (congrFun h (.inl j))
    · apply hz
      funext j
      exact congrArg Subtype.val (congrFun h (.inr j))
  have heq' (a : A) (e : H.edgeSet) :
      eval (fun j => (x (false,e) j : E)) (polynomial c a) +
      eval (fun j => (x (true,e) j : E)) (polynomial c a) = 0 := by
    have hfalse : (fun j => (x (false,e) j : E)) = Sum.elim (z e.val.out.1) (z e.val.out.2) := by
      funext j
      cases j <;> rfl
    have htrue : (fun j => (x (true,e) j : E)) = Sum.elim (z e.val.out.2) (z e.val.out.1) := by
      funext j
      cases j <;> rfl
    rw [hfalse, htrue]
    exact heq a _ _ (orientedPair_adj H (false,e))
  have h := constraints_add_independent_le_parameters d
    (by simpa only [Nat.card_eq_fintype_card] using hd) c Z y hcy hy x hx heq'
  simpa only [Nat.card_eq_fintype_card, Fintype.card_prod, Fintype.card_fin, mul_comm] using h


/-- The host need not be bipartite; only the forbidden graph in the conjecture is. -/
noncomputable def graph {E A : Type*} [Field E] {b d : ℕ}
    (c : A × Monomials (Fin b ⊕ Fin b) d → E) : SimpleGraph (Fin b → E) where
  Adj x y := x ≠ y ∧ ∀ a,
    eval (Sum.elim x y) (polynomial c a) + eval (Sum.elim y x) (polynomial c a) = 0
  symm := by
    intro x y h
    exact ⟨Ne.symm h.1, fun a => by simpa only [add_comm] using h.2 a⟩
  loopless := by intro x h; exact h.1 rfl

lemma polynomial_map {E Ω A σ : Type*} [CommSemiring E] [CommSemiring Ω] [Finite σ]
    {d : ℕ} (g : E →+* Ω) (c : A × Monomials σ d → E) (a : A) :
    MvPolynomial.map g (polynomial c a) = polynomial (g ∘ c) a := by
  simp only [polynomial, map_sum, map_mul, map_C, map_monomial, map_one, Function.comp_apply]

noncomputable def fieldCopy {E Ω A : Type*} [Field E] [Field Ω]
    {b d : ℕ} (g : E →+* Ω) (c : A × Monomials (Fin b ⊕ Fin b) d → E) :
    (graph c).Copy (graph (g ∘ c)) where
  toHom :=
    { toFun := fun x => g ∘ x
      map_rel' := by
        intro x y h
        refine ⟨?_, fun a => ?_⟩
        · intro he
          exact h.1 (funext (fun j => g.injective (congrFun he j)))
        · have hcomp (x y : Fin b → E) : g ∘ Sum.elim x y = Sum.elim (g ∘ x) (g ∘ y) := by
            funext j
            cases j <;> rfl
          have h' := congrArg g (h.2 a)
          simpa only [map_add, map_zero, MvPolynomial.map_eval, polynomial_map, hcomp] using h' }
  injective' := by
    intro x y h
    exact funext (fun j => g.injective (congrFun h j))

end GenericSymmetric





/- ## IndependentCopies -/

/- Independent copies of a field extension. -/

namespace IndependentCopies

open MvPolynomial

/-- An assignment of a transcendence basis to an independent family extends
 to a field embedding into an algebraically closed field. -/
theorem exists_hom_on_basis {F E Ω I : Type*} [Field F] [Field E] [Field Ω]
    [Algebra F E] [Algebra F Ω] [IsAlgClosed Ω]
    (x : I → E) (hx : IsTranscendenceBasis F x)
    (y : I → Ω) (hy : AlgebraicIndependent F y) :
    ∃ g : E →ₐ[F] Ω, ∀ i, g (x i) = y i := by
  let K := IntermediateField.adjoin F (Set.range x)
  let L := IntermediateField.adjoin F (Set.range y)
  let f : K →ₐ[F] Ω := L.val.comp (hy.aevalEquivField.toAlgHom.comp hx.1.reprField)
  have hgen (i : I) : f ⟨x i, IntermediateField.subset_adjoin F _ (Set.mem_range_self i)⟩ = y i := by
    let u := algebraMap (MvPolynomial I F) (FractionRing (MvPolynomial I F)) (X i)
    have hux : hx.1.aevalEquivField u =
        ⟨x i, IntermediateField.subset_adjoin F _ (Set.mem_range_self i)⟩ := by
      apply Subtype.ext
      simpa only [u, aeval_X] using hx.1.aevalEquivField_algebraMap_apply_coe (X i)
    rw [← hux]
    change (hy.aevalEquivField (hx.1.aevalEquivField.symm (hx.1.aevalEquivField u))).val = y i
    rw [AlgEquiv.symm_apply_apply]
    simpa only [u, aeval_X] using hy.aevalEquivField_algebraMap_apply_coe (X i)
  letI : Algebra.IsAlgebraic K E := hx.isAlgebraic_field
  obtain ⟨g, hg⟩ := IsAlgClosed.surjective_restrictDomain_of_isAlgebraic
    (K := F) (L := K) (M := Ω) (E := E) f
  refine ⟨g, fun i => ?_⟩
  have h := congrArg (fun h : K →ₐ[F] Ω =>
    h ⟨x i, IntermediateField.subset_adjoin F _ (Set.mem_range_self i)⟩) hg
  exact h.trans (hgen i)

/-- A transcendental element admits arbitrarily many algebraically independent
images under embeddings of its whole field extension. -/
theorem exists_independent_images {F E : Type} [Field F] [Field E] [Algebra F E]
    (x : E) (hx : Transcendental F x) (p : ℕ) :
    ∃ (Ω : Type) (_ : Field Ω) (_ : Algebra F Ω) (_ : IsAlgClosed Ω),
      ∃ g : Fin p → E →ₐ[F] Ω, AlgebraicIndependent F (fun i => g i x) := by
  classical
  have hs : AlgebraicIndepOn F id ({x} : Set E) := by
    apply (algebraicIndependent_singleton_iff (⟨x, Set.mem_singleton x⟩ : ({x} : Set E))).mpr
    exact hx
  obtain ⟨B, hxB, hB⟩ := exists_isTranscendenceBasis_superset hs
  let i₀ : B := ⟨x, hxB (Set.mem_singleton x)⟩
  let P := MvPolynomial (Fin p × B) F
  let Q := FractionRing P
  let Ω := AlgebraicClosure Q
  let c : Fin p × B → Ω := fun i => algebraMap P Ω (X i)
  have hc : AlgebraicIndependent F c :=
    (MvPolynomial.algebraicIndependent_X (Fin p × B) F).map'
      (f := IsScalarTower.toAlgHom F P Ω) (by
        change Function.Injective (algebraMap P Ω)
        rw [IsScalarTower.algebraMap_eq P Q Ω]
        exact (algebraMap Q Ω).injective.comp (IsFractionRing.injective P Q))
  have hrow (i : Fin p) : AlgebraicIndependent F (fun b : B => c (i,b)) :=
    hc.comp (fun b => (i,b)) (fun b b' h => congrArg Prod.snd h)
  have hemb (i : Fin p) : ∃ g : E →ₐ[F] Ω, ∀ b : B, g b.val = c (i,b) :=
    exists_hom_on_basis Subtype.val hB (fun b => c (i,b)) (hrow i)
  choose g hg using hemb
  refine ⟨Ω, inferInstance, inferInstance, inferInstance, g, ?_⟩
  have hgi : (fun i : Fin p => g i x) = (fun i : Fin p => c (i,i₀)) := by
    funext i
    exact hg i i₀
  rw [hgi]
  exact hc.comp (fun i => (i,i₀)) (fun i j h => congrArg Prod.fst h)

end IndependentCopies


/- ## GenericRooted -/

/- Generic rooted-copy fibers. -/

namespace GenericRooted

open Finset SimpleGraph Erdos571.RootedSunflower

open Classical in
theorem corePower_contained_with_slices {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W} {p : ℕ} (hp : 2 ≤ p)
    (r : R ↪ W) (f : Fin p → H.Copy G)
    (hf : Function.Injective f) (hr : ∀ i x, f i (.inr x) = r x)
    (hcan : Canonical (fun i => (Function.Embedding.inl : A ↪ A ⊕ R).trans (f i).toEmbedding) univ) :
    ∃ C : Finset A, C ≠ univ ∧ ∃ g : (corePower H C p).Copy G,
      ∀ i v, g (Erdos571.RootedSunflower.slice C i v) = f i v := by
  classical
  let i₀ : Fin p := ⟨0, by omega⟩
  let C : Finset A := univ.filter (fun a => ∀ i, f i (.inl a) = f i₀ (.inl a))
  have hC (a : A) : a ∈ C ↔ ∀ i, f i (.inl a) = f i₀ (.inl a) := by simp only [C, mem_filter, mem_univ, true_and]
  have hCne : C ≠ univ := by
    intro hfull
    have heq : f ⟨1, by omega⟩ = f i₀ := by
      apply Copy.ext
      intro v
      cases v with
      | inl a => exact (hC a).mp (by rw [hfull]; exact mem_univ _) _
      | inr x => rw [hr, hr]
    have hi := congrArg Fin.val (hf heq)
    change 1 = 0 at hi
    omega
  let g : CoreVertex A R C p → W := fun v => match v with
    | .inl x => f x.1 (.inl x.2)
    | .inr (.inl x) => f i₀ (.inl x)
    | .inr (.inr x) => r x
  have hgroot (i : Fin p) (v : {a : A // a ∈ C} ⊕ R) :
      g (.inr v) = f i (projection (p := p) (.inr v)) := by
    cases v with
    | inl a => exact ((hC a).mp a.prop i).symm
    | inr x => exact (hr i x).symm
  have hgcopy : ∀ i : Fin p, ∀ v : CoreVertex A R C p,
      (∀ x, v = .inl x → x.1 = i) → g v = f i (projection v) := by
    intro i v hv
    cases v with
    | inl x =>
      have hxi := hv x rfl
      simp only [g, projection, hxi]
    | inr v => exact hgroot i v
  let gc : (corePower H C p).Copy G := by
    refine { toHom := { toFun := g, map_rel' := ?_ }, injective' := ?_ }
    · intro u v h
      obtain ⟨hadj, hcompat⟩ := h
      cases u with
      | inl x =>
        have huv : ∀ y, v = .inl y → y.1 = x.1 := by
          intro y hy
          subst v
          exact hcompat.symm
        rw [hgcopy x.1 (.inl x) (by intro y hy; cases hy; rfl), hgcopy x.1 v huv]
        exact (f x.1).toHom.map_adj hadj
      | inr u =>
        cases v with
        | inl y =>
          rw [hgroot y.1 u, hgcopy y.1 (.inl y) (by intro z hz; cases hz; rfl)]
          exact (f y.1).toHom.map_adj hadj
        | inr v =>
          rw [hgroot i₀ u, hgroot i₀ v]
          exact (f i₀).toHom.map_adj hadj
    · intro u v heq
      change g u = g v at heq
      cases u with
      | inl x =>
        cases v with
        | inl y =>
          change f x.1 (.inl x.2.val) = f y.1 (.inl y.2.val) at heq
          by_cases hij : x.1 = y.1
          · have hxy : x.2 = y.2 := by
              apply Subtype.ext
              apply Sum.inl_injective
              apply (f y.1).injective
              simpa only [hij] using heq
            exact congrArg Sum.inl (Prod.ext hij hxy)
          · obtain ⟨hxy, hfixed⟩ := hcan x.1 (mem_univ _) y.1 (mem_univ _) hij x.2 y.2 heq
            exfalso
            apply x.2.prop
            apply (hC x.2).mpr
            intro i
            exact (hfixed i (mem_univ _)).trans (hfixed i₀ (mem_univ _)).symm
        | inr y =>
          rw [hgroot x.1 y] at heq
          have hxy := (f x.1).injective heq
          cases y with
          | inl y =>
            have hval : x.2.val = y.val := Sum.inl.inj hxy
            exact False.elim (x.2.prop (hval ▸ y.prop))
          | inr y => exact False.elim (Sum.inl_ne_inr hxy)
      | inr x =>
        cases v with
        | inl y =>
          rw [hgroot y.1 x] at heq
          have hxy := (f y.1).injective heq
          cases x with
          | inl x =>
            have hval : x.val = y.2.val := Sum.inl.inj hxy
            exact False.elim (y.2.prop (hval ▸ x.prop))
          | inr x => exact False.elim (Sum.inr_ne_inl hxy)
        | inr y =>
          rw [hgroot i₀ x, hgroot i₀ y] at heq
          have hxy := (f i₀).injective heq
          cases x <;> cases y
          · exact congrArg (fun z => Sum.inr (Sum.inl z)) (Subtype.ext (Sum.inl.inj hxy))
          · exact False.elim (Sum.inl_ne_inr hxy)
          · exact False.elim (Sum.inr_ne_inl hxy)
          · exact congrArg (fun z => Sum.inr (Sum.inr z)) (Sum.inr.inj hxy)
  
  refine ⟨C, hCne, gc, ?_⟩
  intro i v
  cases v with
  | inl a =>
    by_cases ha : a ∈ C
    · change g (Erdos571.RootedSunflower.slice C i (.inl a)) = _
      simp only [Erdos571.RootedSunflower.slice, dif_pos ha, g]
      exact ((hC a).mp ha i).symm
    · change g (Erdos571.RootedSunflower.slice C i (.inl a)) = _
      simp only [Erdos571.RootedSunflower.slice, dif_neg ha, g]
  | inr x =>
    change r x = f i (.inr x)
    exact (hr i x).symm



open Classical in
lemma slice_projection {A R : Type*} (C : Finset A) {p : ℕ} (i : Fin p)
    (v : CoreVertex A R C p) (hv : ∀ x, v = .inl x → x.1 = i) :
    Erdos571.RootedSunflower.slice C i (projection v) = v := by
  cases v with
  | inl x =>
    have hi := hv x rfl
    simp only [projection, Erdos571.RootedSunflower.slice, dif_neg x.2.prop]
    exact congrArg Sum.inl (Prod.ext hi.symm rfl)
  | inr v =>
    cases v with
    | inl a => simp only [projection, Erdos571.RootedSunflower.slice, dif_pos a.prop]
    | inr r => rfl

open Classical in
lemma edge_in_slice {A R : Type*} (H : SimpleGraph (A ⊕ R)) (C : Finset A)
    {p : ℕ} (hp : 0 < p) {u v : CoreVertex A R C p} (h : (corePower H C p).Adj u v) :
    ∃ i : Fin p, Erdos571.RootedSunflower.slice C i (projection u) = u ∧
      Erdos571.RootedSunflower.slice C i (projection v) = v := by
  have hi : ∃ i : Fin p, (∀ x, u = .inl x → x.1 = i) ∧ (∀ x, v = .inl x → x.1 = i) := by
    cases u with
    | inl x =>
      refine ⟨x.1, ?_, ?_⟩
      · intro y hy; cases hy; rfl
      · intro y hy; subst v; exact h.2.symm
    | inr x =>
      cases v with
      | inl y =>
        refine ⟨y.1, ?_, ?_⟩
        · intro z hz; cases hz
        · intro z hz; cases hz; rfl
      | inr y =>
        refine ⟨⟨0,hp⟩, ?_, ?_⟩ <;> intro z hz <;> cases hz
  obtain ⟨i, hu, hv⟩ := hi
  exact ⟨i, slice_projection C i u hu, slice_projection C i v hv⟩

/-- Every edge of the core power is inherited from one of its slices. -/
lemma corePower_card_edges_upper {A R : Type*} [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (C : Finset A) (p : ℕ) (hp : 0 < p) :
    Nat.card (corePower H C p).edgeSet ≤ p * Nat.card H.edgeSet := by
  classical
  let f : Fin p × H.edgeSet → (corePower H C p).edgeSet :=
    fun x => (sliceCopy H C x.1).mapEdgeSet x.2
  have hf : Function.Surjective f := by
    rintro ⟨e, he⟩
    induction e using Sym2.inductionOn with
    | hf u v =>
      obtain ⟨i, hu, hv⟩ := edge_in_slice H C hp he
      refine ⟨(i, ⟨s(projection u, projection v), he.1⟩), ?_⟩
      apply Subtype.ext
      change s(Erdos571.RootedSunflower.slice C i (projection u),
        Erdos571.RootedSunflower.slice C i (projection v)) = s(u,v)
      rw [hu, hv]
  have h := Nat.card_le_card_of_surjective f hf
  simpa only [Nat.card_prod, Nat.card_fin] using h


open GenericPolynomial GenericSymmetric in
/-- A nonalgebraic rooted-copy coordinate produces many common-root copies
whose chosen coordinates are independent even over the generic coefficients. -/
theorem independent_rooted_copies {F E Q A R : Type} [Field F] [Field E] [Algebra F E]
    {b d : ℕ} (H : SimpleGraph (A ⊕ R))
    (c : Q × Monomials (Fin b ⊕ Fin b) d → E) (hc : AlgebraicIndependent F c)
    (f : H.Copy (graph c)) (a : A) (j : Fin b) (N : ℕ) (hN : 0 < N)
    (hx : Transcendental
      (IntermediateField.adjoin F (Set.range c ∪ Set.range (fun r : R × Fin b => f (.inr r.1) r.2)))
      (f (.inl a) j)) :
    ∃ (Ω : Type) (_ : Field Ω) (_ : Algebra F Ω),
      ∃ c' : Q × Monomials (Fin b ⊕ Fin b) d → Ω,
      ∃ g : Fin N → H.Copy (graph c'), ∃ r : R ↪ (Fin b → Ω),
        (∀ i x, g i (.inr x) = r x) ∧
        AlgebraicIndependent F (Sum.elim c' (fun i => g i (.inl a) j)) := by
  classical
  let K := IntermediateField.adjoin F
    (Set.range c ∪ Set.range (fun r : R × Fin b => f (.inr r.1) r.2))
  have hcK (m : Q × Monomials (Fin b ⊕ Fin b) d) : c m ∈ K :=
    IntermediateField.subset_adjoin F _ (Or.inl (Set.mem_range_self m))
  have hrK (r : R) (k : Fin b) : f (.inr r) k ∈ K :=
    IntermediateField.subset_adjoin F _ (Or.inr ⟨(r,k), rfl⟩)
  let cK : Q × Monomials (Fin b ⊕ Fin b) d → K := fun m => ⟨c m, hcK m⟩
  have hcKind : AlgebraicIndependent F cK := AlgebraicIndependent.of_comp K.val hc
  obtain ⟨Ω, hField, hAlg, hClosed, g, hg⟩ :=
    IndependentCopies.exists_independent_images (F := K) (f (.inl a) j) hx N
  letI := hField
  letI := hAlg
  letI := hClosed
  letI : Algebra F Ω := Algebra.compHom Ω (algebraMap F K)
  letI : IsScalarTower F K Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let c' : Q × Monomials (Fin b ⊕ Fin b) d → Ω := fun m => algebraMap K Ω (cK m)
  have hgcoeff (i : Fin N) : (g i).toRingHom ∘ c = c' := by
    funext m
    exact (g i).commutes (cK m)
  have hgroot (i i' : Fin N) (r : R) (k : Fin b) :
      g i (f (.inr r) k) = g i' (f (.inr r) k) := by
    exact ((g i).commutes (⟨f (.inr r) k, hrK r k⟩ : K)).trans
      ((g i').commutes (⟨f (.inr r) k, hrK r k⟩ : K)).symm
  let copies (i : Fin N) : H.Copy (graph c') :=
    { toHom :=
        { toFun := fun v k => g i (f v k)
          map_rel' := by
            intro u v huv
            have h := ((fieldCopy (g i).toRingHom c).comp f).toHom.map_adj huv
            change (graph ((g i).toRingHom ∘ c)).Adj (fun k => g i (f u k))
              (fun k => g i (f v k)) at h
            rwa [hgcoeff i] at h }
      injective' := by
        intro u v h
        apply f.injective
        exact funext (fun k => (g i).injective (congrFun h k)) }
  let i₀ : Fin N := ⟨0,hN⟩
  let r : R ↪ (Fin b → Ω) := Function.Embedding.inr.trans (copies i₀).toEmbedding
  refine ⟨Ω, inferInstance, inferInstance, c', copies, r, ?_, ?_⟩
  · intro i r
    funext k
    exact hgroot i i₀ r k
  · have h := hcKind.sumElim_comp hg
    have h' := h.comp (Equiv.sumComm _ _) (Equiv.sumComm _ _).injective
    convert h' using 1
    funext v
    cases v <;> rfl


open GenericPolynomial GenericSymmetric in
/-- In a generic polynomial graph of sufficiently high fixed degree, balanced
rooted templates have algebraic nonroot coordinates over their roots and the
coefficient field. This is an algebraic-fiber statement, not yet a finite-field
extremal estimate. -/
theorem rooted_coordinate_isAlgebraic {F E Q A R : Type}
    [Field F] [Field E] [Algebra F E] [Fintype Q] [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (b d p : ℕ)
    (hp : b * (Fintype.card A + Fintype.card R) + 2 ≤ p)
    (hd : 2 * p * Nat.card H.edgeSet - 1 ≤ d)
    (hbal : ∀ C : Finset A, b * (Fintype.card A - C.card) ≤
      Fintype.card Q * Nat.card (PetalEdge H C))
    (c : Q × Monomials (Fin b ⊕ Fin b) d → E) (hc : AlgebraicIndependent F c)
    (f : H.Copy (graph c)) (a : A) (j : Fin b) :
    IsAlgebraic
      (IntermediateField.adjoin F (Set.range c ∪ Set.range (fun r : R × Fin b => f (.inr r.1) r.2)))
      (f (.inl a) j) := by
  classical
  by_contra hx
  let N := bound (Fintype.card A) p + 1
  obtain ⟨Ω, hField, hAlg, c', copies, r, hroot, hind⟩ :=
    independent_rooted_copies H c hc f a j N (by dsimp [N]; omega) hx
  letI := hField
  letI := hAlg
  have hindcoord : AlgebraicIndependent F (fun i => copies i (.inl a) j) :=
    hind.comp Sum.inr Sum.inr_injective
  let emb (i : Fin N) : A ↪ (Fin b → Ω) := Function.Embedding.inl.trans (copies i).toEmbedding
  have hemb : Function.Injective emb := by
    intro i i' h
    apply hindcoord.injective
    exact congrArg (fun e : A ↪ (Fin b → Ω) => e a j) h
  obtain ⟨S, hS, hSc, hcan⟩ := labelled_sunflower (Fintype.card A) univ emb p rfl
    (by omega) hemb.injOn (by simp only [card_univ, Fintype.card_fin, N]; omega)
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by simp only [Fintype.card_fin, Fintype.card_coe, hSc])
  let sel : Fin p ↪ Fin N := ⟨fun i => (e i).val, Subtype.val_injective.comp e.injective⟩
  let fs (i : Fin p) := copies (sel i)
  have hfs : Function.Injective fs := by
    intro i i' h
    apply sel.injective
    apply hindcoord.injective
    exact congrArg (fun f : H.Copy (graph c') => f (.inl a) j) h
  have hfscan : Canonical
      (fun i => Function.Embedding.inl.trans (fs i).toEmbedding) univ := by
    intro i _ i' _ hii' u v huv
    obtain ⟨huv', hfix⟩ := hcan (sel i) (e i).prop (sel i') (e i').prop
      (sel.injective.ne hii') u v huv
    exact ⟨huv', fun k _ => hfix (sel k) (e k).prop⟩
  obtain ⟨C, hC, g, hg⟩ := corePower_contained_with_slices (by omega) r fs hfs
    (fun i v => hroot (sel i) v) hfscan
  let Y : Fin p → Ω := fun i => fs i (.inl a) j
  have hcy : AlgebraicIndependent F (Sum.elim c' Y) := by
    have hi : Function.Injective (Sum.map (id : Q × Monomials (Fin b ⊕ Fin b) d → _) sel) :=
      Sum.map_injective.mpr ⟨Function.injective_id, sel.injective⟩
    have h := hind.comp (Sum.map (id : Q × Monomials (Fin b ⊕ Fin b) d → _) sel) hi
    convert h using 1
    funext v
    cases v <;> rfl
  have hy (i : Fin p) : Y i ∈ IntermediateField.adjoin F
      (Set.range (fun v : CoreVertex A R C p × Fin b => g v.1 v.2)) := by
    have hgi := congrArg (fun x : Fin b → Ω => x j) (hg i (.inl a))
    apply IntermediateField.subset_adjoin
    exact ⟨(Erdos571.RootedSunflower.slice C i (.inl a), j), hgi⟩
  have hupper := corePower_card_edges_upper H C p (by omega)
  have hdegree : 2 * Nat.card (corePower H C p).edgeSet - 1 ≤ d := by
    have hh := Nat.mul_le_mul_left 2 hupper
    rw [Nat.mul_assoc] at hd
    omega
  have hparam := graph_parameter_bound (corePower H C p) b d hdegree c' g Y hcy g.injective hy
    (fun q u v huv => (g.toHom.map_adj huv).2 q)
  rw [Fintype.card_fin, ← Nat.card_eq_fintype_card (α := CoreVertex A R C p),
    corePower_card_vertices] at hparam
  have hmass : b * (p * (Fintype.card A - C.card)) ≤
      Fintype.card Q * Nat.card (corePower H C p).edgeSet := by
    calc
      _ = p * (b * (Fintype.card A - C.card)) := by ring
      _ ≤ p * (Fintype.card Q * Nat.card (PetalEdge H C)) := Nat.mul_le_mul_left p (hbal C)
      _ = Fintype.card Q * (p * Nat.card (PetalEdge H C)) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ (corePower_card_edges_lower H C p)
  have hcard : C.card ≤ Fintype.card A := card_le_univ C
  have hmul := Nat.mul_le_mul_left b hcard
  nlinarith


open GenericPolynomial GenericSymmetric in
/-- Over a countable coefficient base, a generic rooted-copy fiber is countable.
This form will also apply to ultraproduct fields, without any finiteness
assumption on the ambient field. -/
theorem countable_rooted_fiber {F E Q A R : Type}
    [Field F] [Countable F] [Field E] [Algebra F E] [Fintype Q] [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (b d p : ℕ)
    (hp : b * (Fintype.card A + Fintype.card R) + 2 ≤ p)
    (hd : 2 * p * Nat.card H.edgeSet - 1 ≤ d)
    (hbal : ∀ C : Finset A, b * (Fintype.card A - C.card) ≤
      Fintype.card Q * Nat.card (PetalEdge H C))
    (c : Q × Monomials (Fin b ⊕ Fin b) d → E) (hc : AlgebraicIndependent F c)
    (r : R ↪ (Fin b → E)) :
    Countable {f : H.Copy (graph c) // ∀ x, f (.inr x) = r x} := by
  classical
  let U := Set.range c ∪ Set.range (fun x : R × Fin b => r x.1 x.2)
  let K := IntermediateField.adjoin F U
  have hU : U.Countable := ((Set.finite_range c).union (Set.finite_range _)).countable
  letI : Countable K := Cardinal.mk_le_aleph0_iff.mp
    ((IntermediateField.cardinalMk_adjoin_le F U).trans
      (max_le (max_le Cardinal.mk_le_aleph0 hU.le_aleph0) le_rfl))
  let S := {x : E // IsAlgebraic K x}
  letI : Countable S := (Algebraic.countable K E).to_subtype
  let Fiber := {f : H.Copy (graph c) // ∀ x, f (.inr x) = r x}
  have hcoord (f : Fiber) (a : A) (j : Fin b) : IsAlgebraic K (f.val (.inl a) j) := by
    have h := rooted_coordinate_isAlgebraic H b d p hp hd hbal c hc f.val a j
    have hfield : IntermediateField.adjoin F
        (Set.range c ∪ Set.range (fun x : R × Fin b => f.val (.inr x.1) x.2)) = K := by
      congr 3
      funext x
      rw [f.prop]
    rw [hfield] at h
    exact h
  let coords : Fiber → A × Fin b → S := fun f x => ⟨f.val (.inl x.1) x.2, hcoord f x.1 x.2⟩
  have hcoords : Function.Injective coords := by
    intro f g h
    apply Subtype.ext
    apply Copy.ext
    intro v
    cases v with
    | inl a =>
      funext j
      exact congrArg Subtype.val (congrFun h (a,j))
    | inr x => rw [f.prop, g.prop]
  exact hcoords.countable

end GenericRooted






/- ## FieldUltraproduct -/

/- An algebraic construction of ultraproduct fields, with coordinatewise
polynomial evaluation and a binary-prefix uncountability argument. -/
namespace FieldUltraproduct

open Filter

variable {ι : Type*} (u : Ultrafilter ι) (K : ι → Type*) [∀ i, Field (K i)]

/-- The ideal of sequences vanishing almost everywhere. -/
def vanishing : Ideal (∀ i, K i) where
  carrier := {f | ∀ᶠ i in u, f i = 0}
  zero_mem' := Eventually.of_forall (fun _ => rfl)
  add_mem' := by
    intro f g hf hg
    filter_upwards [hf, hg] with i hi hj
    exact show f i + g i = 0 by rw [hi, hj, add_zero]
  smul_mem' := by
    intro a f hf
    filter_upwards [hf] with i hi
    exact show a i * f i = 0 by rw [hi, mul_zero]

@[simp] lemma mem_vanishing (f : ∀ i, K i) :
    f ∈ vanishing u K ↔ ∀ᶠ i in u, f i = 0 := Iff.rfl

instance : (vanishing u K).IsMaximal := by
  classical
  apply Ideal.isMaximal_iff.mpr
  constructor
  · simp only [mem_vanishing, Pi.one_apply, one_ne_zero, eventually_const, not_false_eq_true]
  · intro J x hIJ hx hxJ
    have hxn : ∀ᶠ i in u, x i ≠ 0 := Ultrafilter.eventually_not.mpr hx
    let y : ∀ i, K i := fun i => (x i)⁻¹
    have hxy : x * y - 1 ∈ vanishing u K := by
      filter_upwards [hxn] with i hi
      exact sub_eq_zero.mpr (mul_inv_cancel₀ hi)
    have hm : x * y ∈ J := J.mul_mem_right _ hxJ
    have hs := J.sub_mem hm (hIJ hxy)
    simpa only [sub_sub_cancel] using hs

abbrev FieldProduct := (∀ i, K i) ⧸ vanishing u K

noncomputable instance : Field (FieldProduct u K) := Ideal.Quotient.field _

abbrev mk : (∀ i, K i) →+* FieldProduct u K := Ideal.Quotient.mk _

lemma mk_eq_iff (f g : ∀ i, K i) :
    mk u K f = mk u K g ↔ ∀ᶠ i in u, f i = g i := by
  rw [Ideal.Quotient.eq]
  simp only [mem_vanishing, Pi.sub_apply, sub_eq_zero]

lemma mk_eq_zero_iff (f : ∀ i, K i) :
    mk u K f = 0 ↔ ∀ᶠ i in u, f i = 0 := Ideal.Quotient.eq_zero_iff_mem

lemma mk_ne_zero_iff (f : ∀ i, K i) :
    mk u K f ≠ 0 ↔ ∀ᶠ i in u, f i ≠ 0 := by
  exact (mk_eq_zero_iff u K f).not.trans Ultrafilter.eventually_not.symm

lemma mk_eval {σ : Type*} (c : σ → ∀ i, K i) (P : MvPolynomial σ ℤ) :
    mk u K (fun i => MvPolynomial.eval₂ (Int.castRingHom (K i)) (fun s => c s i) P) =
      MvPolynomial.eval₂ (Int.castRingHom (FieldProduct u K)) (fun s => mk u K (c s)) P := by
  induction P using MvPolynomial.induction_on with
  | C a =>
    simp only [MvPolynomial.eval₂_C]
    change mk u K (a : ∀ i, K i) = (a : FieldProduct u K)
    exact map_intCast (mk u K) a
  | add P Q hP hQ =>
    simp only [MvPolynomial.eval₂_add]
    change mk u K ((fun i => _) + (fun i => _)) = _
    rw [map_add, hP, hQ]
  | mul_X P s hP =>
    simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
    change mk u K ((fun i => _) * c s) = _
    rw [map_mul, hP]

lemma algebraicIndependent_of_eventual {σ : Type*} (c : σ → ∀ i, K i)
    (hc : ∀ P : MvPolynomial σ ℤ, P ≠ 0 →
      ∀ᶠ i in u, MvPolynomial.eval₂ (Int.castRingHom (K i)) (fun s => c s i) P ≠ 0) :
    AlgebraicIndependent ℤ (fun s => mk u K (c s)) := by
  apply algebraicIndependent_iff.mpr
  intro P hP
  by_contra h
  have hh := (mk_ne_zero_iff u K _).mpr (hc P h)
  rw [mk_eval] at hh
  exact hh hP

lemma mk_tuple_eq_iff {σ : Type*} [Finite σ] (f g : σ → ∀ i, K i) :
    (fun s => mk u K (f s)) = (fun s => mk u K (g s)) ↔
      ∀ᶠ i in u, (fun s => f s i) = (fun s => g s i) := by
  simp only [funext_iff, mk_eq_iff, eventually_all]

lemma binary_uncountable : Uncountable (ℕ → Bool) := by
  apply uncountable_iff_forall_not_surjective.mpr
  intro f hf
  obtain ⟨n, hn⟩ := hf (fun i => !(f i i))
  have h := congrFun hn n
  cases hfn : f n n <;> simp [hfn] at h

/-- Distinct finite tuples indexed by binary prefixes yield continuum many
ultralimit tuples. -/
lemma prefix_injective (u : Ultrafilter ℕ) (hu : (u : Filter ℕ) ≤ atTop)
    (K : ℕ → Type*) [∀ n, Field (K n)] {σ : Type*} [Finite σ]
    (f : ∀ n, (Fin n → Bool) ↪ (σ → K n)) :
    Function.Injective (fun s : ℕ → Bool =>
      fun j => mk u K (fun n => f n (fun i => s i.val) j)) := by
  intro s t h
  have he := (mk_tuple_eq_iff u K _ _).mp h
  funext m
  have hm : ∀ᶠ n in u, m < n := hu (eventually_gt_atTop m)
  obtain ⟨n, hn, heq⟩ := (hm.and he).exists
  exact congrFun ((f n).injective heq) ⟨m,hn⟩

end FieldUltraproduct

/- ## GraphUltraproduct -/

/- Ultralimits of generic polynomial graphs and their rooted-copy fibers. -/
namespace GraphUltraproduct

open Filter Finset SimpleGraph GenericPolynomial GenericSymmetric FieldUltraproduct

variable {ι : Type*} (u : Ultrafilter ι) (K : ι → Type*) [∀ i, Field (K i)]

lemma eval_polynomial_pi {A σ : Type*} [Finite σ] {d : ℕ}
    (c : A × Monomials σ d → ∀ i, K i) (x : σ → ∀ i, K i) (a : A) (i : ι) :
    MvPolynomial.eval x (polynomial c a) i =
      MvPolynomial.eval (fun s => x s i) (polynomial (fun t => c t i) a) := by
  have h := MvPolynomial.map_eval (Pi.evalRingHom K i) x (polynomial c a)
  simpa only [polynomial_map, Pi.evalRingHom_apply, Function.comp_def] using h

lemma mk_eval_polynomial {A σ : Type*} [Finite σ] {d : ℕ}
    (c : A × Monomials σ d → ∀ i, K i) (x : σ → ∀ i, K i) (a : A) :
    mk u K (fun i => MvPolynomial.eval (fun s => x s i) (polynomial (fun t => c t i) a)) =
      MvPolynomial.eval (fun s => mk u K (x s))
        (polynomial (fun t => mk u K (c t)) a) := by
  have h := MvPolynomial.map_eval (mk u K) x (polynomial c a)
  simp only [polynomial_map, Function.comp_def] at h
  rw [← h]
  congr 1
  funext i
  exact (eval_polynomial_pi K c x a i).symm

/-- The coordinatewise ultralimit of a family of vertex embeddings. -/
noncomputable def limitEmbedding {V : Type*} {b : ℕ}
    (f : ∀ i, V ↪ (Fin b → K i)) : V ↪ (Fin b → FieldProduct u K) where
  toFun v j := mk u K (fun i => f i v j)
  inj' := by
    intro v w h
    have he := (mk_tuple_eq_iff u K _ _).mp h
    obtain ⟨i, hi⟩ := he.exists
    exact (f i).injective hi

@[simp] lemma limitEmbedding_apply {V : Type*} {b : ℕ}
    (f : ∀ i, V ↪ (Fin b → K i)) (v : V) (j : Fin b) :
    limitEmbedding u K f v j = mk u K (fun i => f i v j) := rfl

noncomputable def limitCopy {V Q : Type*} {b d : ℕ} (H : SimpleGraph V)
    (c : ∀ i, Q × Monomials (Fin b ⊕ Fin b) d → K i)
    (f : ∀ i, H.Copy (graph (c i))) :
    H.Copy (graph (fun t => mk u K (fun i => c i t))) where
  toHom :=
    { toFun := limitEmbedding u K (fun i => (f i).toEmbedding)
      map_rel' := by
        intro v w hvw
        refine ⟨fun h => H.ne_of_adj hvw ((limitEmbedding u K _).injective h), fun a => ?_⟩
        let x : Fin b ⊕ Fin b → ∀ i, K i := Sum.elim (fun j i => f i v j) (fun j i => f i w j)
        let y : Fin b ⊕ Fin b → ∀ i, K i := Sum.elim (fun j i => f i w j) (fun j i => f i v j)
        have he : mk u K (fun i =>
            MvPolynomial.eval (fun s => x s i) (polynomial (c i) a) +
            MvPolynomial.eval (fun s => y s i) (polynomial (c i) a)) = 0 := by
          apply (mk_eq_zero_iff u K _).mpr
          apply Eventually.of_forall
          intro i
          have hx : (fun s => x s i) = Sum.elim (f i v) (f i w) := by
            funext s; cases s <;> rfl
          have hy : (fun s => y s i) = Sum.elim (f i w) (f i v) := by
            funext s; cases s <;> rfl
          rw [hx, hy]
          exact ((f i).toHom.map_adj hvw).2 a
        change mk u K ((fun i => _) + (fun i => _)) = 0 at he
        rw [map_add, mk_eval_polynomial, mk_eval_polynomial] at he
        have hx : (fun s => mk u K (x s)) = Sum.elim
            (limitEmbedding u K (fun i => (f i).toEmbedding) v)
            (limitEmbedding u K (fun i => (f i).toEmbedding) w) := by
          funext s; cases s <;> rfl
        have hy : (fun s => mk u K (y s)) = Sum.elim
            (limitEmbedding u K (fun i => (f i).toEmbedding) w)
            (limitEmbedding u K (fun i => (f i).toEmbedding) v) := by
          funext s; cases s <;> rfl
        rwa [hx, hy] at he }
  injective' := (limitEmbedding u K _).injective

@[simp] lemma limitCopy_apply {V Q : Type*} {b d : ℕ} (H : SimpleGraph V)
    (c : ∀ i, Q × Monomials (Fin b ⊕ Fin b) d → K i)
    (f : ∀ i, H.Copy (graph (c i))) (v : V) (j : Fin b) :
    limitCopy u K H c f v j = mk u K (fun i => f i v j) := rfl

/-- An unbounded sequence of finite rooted fibers gives an uncountable fiber
in a nonprincipal ultraproduct. -/
theorem uncountable_rooted_fiber (u : Ultrafilter ℕ) (hu : (u : Filter ℕ) ≤ atTop)
    (K : ℕ → Type) [∀ n, Field (K n)] {A R Q : Type}
    [Finite A] [Finite R] {b d : ℕ} (H : SimpleGraph (A ⊕ R))
    (c : ∀ n, Q × Monomials (Fin b ⊕ Fin b) d → K n)
    (r : ∀ n, R ↪ (Fin b → K n))
    (f : ∀ n, (Fin n → Bool) ↪
      {g : H.Copy (graph (c n)) // ∀ x, g (.inr x) = r n x}) :
    Uncountable {g : H.Copy (graph (fun t => mk u K (fun n => c n t))) //
      ∀ x, g (.inr x) = limitEmbedding u K r x} := by
  classical
  letI := binary_uncountable
  let F (s : ℕ → Bool) :
      {g : H.Copy (graph (fun t => mk u K (fun n => c n t))) //
        ∀ x, g (.inr x) = limitEmbedding u K r x} :=
    ⟨limitCopy u K H c (fun n => (f n (fun i => s i.val)).val), by
      intro x
      funext j
      change mk u K (fun n => (f n (fun i => s i.val)).val (.inr x) j) =
        mk u K (fun n => r n x j)
      apply congrArg (mk u K)
      funext n
      exact congrFun ((f n (fun i => s i.val)).prop x) j⟩
  apply Function.Injective.uncountable (f := F)
  let e (n : ℕ) : (Fin n → Bool) ↪ ((A ⊕ R) × Fin b → K n) :=
    ⟨fun s t => (f n s).val t.1 t.2, by
      intro s t h
      apply (f n).injective
      apply Subtype.ext
      apply Copy.ext
      intro v
      funext j
      exact congrFun h (v,j)⟩
  intro s t h
  apply prefix_injective u hu K e
  funext v
  exact congrArg (fun g => g.val v.1 v.2) h

end GraphUltraproduct


/- ## GenericUniform -/

/- Uniform control of rooted copies on an open set of polynomial coefficients. -/
namespace GenericUniform

open Filter Finset SimpleGraph GenericPolynomial GenericSymmetric FieldUltraproduct
open Erdos571.RootedSunflower GraphUltraproduct

/-- A generic balanced rooted graph has uniformly bounded rooted fibers after
excluding the zero set of one nonzero polynomial in the coefficients. -/
theorem exists_uniform_bound {Q A R : Type} [Fintype Q] [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (b d p : ℕ)
    (hp : b * (Fintype.card A + Fintype.card R) + 2 ≤ p)
    (hd : 2 * p * Nat.card H.edgeSet - 1 ≤ d)
    (hbal : ∀ C : Finset A, b * (Fintype.card A - C.card) ≤
      Fintype.card Q * Nat.card (PetalEdge H C)) :
    ∃ P : MvPolynomial (Q × Monomials (Fin b ⊕ Fin b) d) ℤ, P ≠ 0 ∧
      ∃ N : ℕ, ∀ (E : Type) [Field E]
        (c : Q × Monomials (Fin b ⊕ Fin b) d → E),
        MvPolynomial.eval₂ (Int.castRingHom E) c P ≠ 0 →
        ¬∃ r : R ↪ (Fin b → E), Nonempty ((Fin N → Bool) ↪
          {f : H.Copy (graph c) // ∀ x, f (.inr x) = r x}) := by
  classical
  by_contra h
  push_neg at h
  letI : Countable (MvPolynomial (Q × Monomials (Fin b ⊕ Fin b) d) ℤ) :=
    inferInstanceAs (Countable (((Q × Monomials (Fin b ⊕ Fin b) d) →₀ ℕ) →₀ ℤ))
  let Z := {P : MvPolynomial (Q × Monomials (Fin b ⊕ Fin b) d) ℤ // P ≠ 0}
  letI : Nonempty Z := ⟨⟨1, one_ne_zero⟩⟩
  obtain ⟨enum, henum⟩ := exists_surjective_nat Z
  let P (n : ℕ) := ∏ i ∈ range (n+1), (enum i).val
  have hP (n : ℕ) : P n ≠ 0 := prod_ne_zero_iff.mpr (fun i _ => (enum i).prop)
  have hh (n : ℕ) := h (P n) (hP n) n
  choose K hK c hc r hf using hh
  letI : ∀ n, Field (K n) := hK
  let f n := Classical.choice (hf n)
  let u := Ultrafilter.of (atTop : Filter ℕ)
  have hu : (u : Filter ℕ) ≤ atTop := Ultrafilter.of_le _
  let Ω := FieldProduct u K
  let c' (t : Q × Monomials (Fin b ⊕ Fin b) d) : Ω := mk u K (fun n => c n t)
  have hc' : AlgebraicIndependent ℤ c' := by
    apply algebraicIndependent_of_eventual u K
    intro P₀ hP₀
    obtain ⟨m, hm⟩ := henum ⟨P₀, hP₀⟩
    apply hu
    filter_upwards [eventually_ge_atTop m] with n hn
    have hprod := hc n
    change (MvPolynomial.eval₂Hom (Int.castRingHom (K n)) (c n)) (P n) ≠ 0 at hprod
    dsimp only [P] at hprod
    rw [map_prod] at hprod
    have hv := prod_ne_zero_iff.mp hprod m (mem_range.mpr (by omega))
    have hm' : (enum m).val = P₀ := congrArg Subtype.val hm
    simpa only [hm', MvPolynomial.coe_eval₂Hom] using hv
  letI : CharZero Ω := charZero_of_injective_algebraMap hc'.algebraMap_injective
  letI : Algebra.IsAlgebraic ℤ ℚ := IsLocalization.isAlgebraic ℚ (nonZeroDivisors ℤ)
  have hcQ : AlgebraicIndependent ℚ c' := hc'.extendScalars ℚ
  have hcount := GenericRooted.countable_rooted_fiber H b d p hp hd hbal c' hcQ
    (limitEmbedding u K r)
  have huncount := uncountable_rooted_fiber u hu K H c r f
  exact huncount.not_countable hcount

end GenericUniform


/- ## FiniteAveraging -/

/- A finite second-moment lemma with an exceptional set. -/
namespace FiniteAveraging

open Finset

lemma exists_good_large {X : Type*} [Fintype X] [Nonempty X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (μ : ℝ) (hμ : 0 < μ)
    (hsum : ∑ x, w x = Fintype.card X * μ)
    (hsq : ∑ x, (w x)^2 ≤ 2 * Fintype.card X * μ^2)
    (bad : Finset X) (hbad : 16 * (bad.card : ℝ) ≤ Fintype.card X) :
    ∃ x, x ∉ bad ∧ μ / 2 ≤ w x := by
  classical
  by_contra! h
  let good := univ \ bad
  have hgood : ∑ x ∈ good, w x ≤ Fintype.card X * (μ/2) := by
    calc
      _ ≤ ∑ _x ∈ good, μ/2 := sum_le_sum (fun x hx => (h x (mem_sdiff.mp hx).2).le)
      _ = (good.card : ℝ) * (μ/2) := by simp
      _ ≤ Fintype.card X * (μ/2) := by gcongr; exact card_le_card (sdiff_subset : good ⊆ univ)
  have hsplit : ∑ x ∈ bad, w x + ∑ x ∈ good, w x = Fintype.card X * μ := by
    rw [add_comm, sum_sdiff (subset_univ bad), hsum]
  have hhalf : Fintype.card X * μ / 2 ≤ ∑ x ∈ bad, w x := by linarith
  have hcs := sum_mul_sq_le_sq_mul_sq bad (fun _ : X => (1 : ℝ)) w
  simp only [one_mul, one_pow, sum_const, nsmul_eq_mul, mul_one] at hcs
  have hsbad : ∑ x ∈ bad, (w x)^2 ≤ 2 * Fintype.card X * μ^2 :=
    (sum_le_sum_of_subset_of_nonneg (subset_univ bad) (fun _ _ _ => sq_nonneg _)).trans hsq
  have hsmall : 8 * (∑ x ∈ bad, w x)^2 ≤ (Fintype.card X * μ)^2 := by
    have h₁ := mul_le_mul_of_nonneg_left hsbad (Nat.cast_nonneg bad.card : (0 : ℝ) ≤ bad.card)
    have h₂ := mul_le_mul_of_nonneg_right hbad
      (show 0 ≤ (Fintype.card X : ℝ) * μ^2 by positivity)
    nlinarith
  have hc : (0 : ℝ) < Fintype.card X := by exact_mod_cast Fintype.card_pos
  have hpos : 0 < (Fintype.card X : ℝ) * μ := mul_pos hc hμ
  have hnonneg : 0 ≤ ∑ x ∈ bad, w x := sum_nonneg (fun x _ => hw x)
  have hh := mul_self_le_mul_self (by positivity : (0 : ℝ) ≤ Fintype.card X * μ / 2) hhalf
  nlinarith [sq_pos_of_pos hpos]

open Classical in
/-- The first two moments of a sum of pairwise independent indicators. -/
lemma event_moments {X E : Type*} [Fintype X] [Fintype E]
    (B : X → E → Prop) (ρ : ℝ) (hρ : 0 ≤ ρ)
    (hone : ∀ e, (∑ x, if B x e then (1 : ℝ) else 0) = Fintype.card X * ρ)
    (htwo : ∀ e f, e ≠ f → (∑ x, if B x e ∧ B x f then (1 : ℝ) else 0) =
      Fintype.card X * ρ^2) :
    let w := fun x => ∑ e, if B x e then (1 : ℝ) else 0
    (∑ x, w x = Fintype.card X * (Fintype.card E * ρ)) ∧
      ∑ x, (w x)^2 ≤ Fintype.card X * ((Fintype.card E * ρ)^2 + Fintype.card E * ρ) := by
  classical
  dsimp only
  constructor
  · rw [sum_comm]
    simp only [hone, sum_const, card_univ, nsmul_eq_mul]
    ring
  · have he (e f : E) : (∑ x, (if B x e then (1 : ℝ) else 0) *
        (if B x f then (1 : ℝ) else 0)) ≤
        Fintype.card X * ρ^2 + if e = f then Fintype.card X * ρ else 0 := by
      have hi (x : X) : (if B x e then (1 : ℝ) else 0) *
          (if B x f then (1 : ℝ) else 0) = if B x e ∧ B x f then 1 else 0 := by
        split_ifs <;> simp_all
      simp_rw [hi]
      by_cases hef : e = f
      · subst f
        simp only [and_self, hone, if_true]
        nlinarith [sq_nonneg ρ, Nat.cast_nonneg (Fintype.card X) (α := ℝ)]
      · rw [htwo e f hef, if_neg hef, add_zero]
    calc
      _ = ∑ e, ∑ f, ∑ x, (if B x e then (1 : ℝ) else 0) *
          (if B x f then (1 : ℝ) else 0) := by
        simp only [pow_two, sum_mul_sum]
        rw [sum_comm]
        congr 1
        funext e
        rw [sum_comm]
      _ ≤ ∑ e : E, ∑ f : E, (Fintype.card X * ρ^2 +
          if e = f then Fintype.card X * ρ else 0) :=
        sum_le_sum (fun e _ => sum_le_sum (fun f _ => he e f))
      _ = _ := by
        simp only [sum_add_distrib, sum_const, card_univ, nsmul_eq_mul,
          sum_ite_eq, mem_univ, if_true]
        ring

end FiniteAveraging

/- ## SymmetricCounting -/

/- Exact counting of symmetric polynomial edge events. -/
namespace SymmetricCounting

open Finset MvPolynomial GenericPolynomial GenericSymmetric

lemma polynomial_zero {A σ K : Type*} [Finite σ] [CommSemiring K] {d : ℕ} (a : A) :
    polynomial (0 : A × Monomials σ d → K) a = 0 := by
  simp [polynomial]

lemma polynomial_add {A σ K : Type*} [Finite σ] [CommSemiring K] {d : ℕ}
    (c e : A × Monomials σ d → K) (a : A) :
    polynomial (c+e) a = polynomial c a + polynomial e a := by
  simp [polynomial, add_mul, sum_add_distrib]

noncomputable def pairedEvaluation {A I σ K : Type*} [Finite σ] [Field K]
    (x : Bool × I → σ → K) (d : ℕ) :
    (A × Monomials σ d → K) →+ (A × I → K) where
  toFun c t := eval (x (false,t.2)) (polynomial c t.1) +
    eval (x (true,t.2)) (polynomial c t.1)
  map_zero' := by ext t; simp [polynomial_zero]
  map_add' := by
    intro c e
    ext t
    simp only [polynomial_add, eval_add, Pi.add_apply]
    ring

lemma polynomial_repr {A σ K : Type*} [Finite σ] [Field K] {d : ℕ}
    (p : A → restrictTotalDegree σ K d) (a : A) :
    polynomial (fun t : A × Monomials σ d => monomialBasis σ K d |>.repr (p t.1) t.2) a =
      (p a).val := by
  have h := congrArg Subtype.val ((monomialBasis σ K d).sum_repr (p a))
  simpa only [polynomial, Submodule.coe_sum, Submodule.coe_smul, monomialBasis_apply,
    smul_eq_C_mul] using h

lemma pairedEvaluation_surjective {A I σ K : Type*} [Fintype I] [Finite σ] [Field K]
    (x : Bool × I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : 2 * Fintype.card I - 1 ≤ d) :
    Function.Surjective (pairedEvaluation (A := A) x d) := by
  classical
  intro y
  have hp (a : A) : ∃ p : restrictTotalDegree σ K d,
      (fun i => eval (x i) p.val) = (fun i : Bool × I => if i.1 then 0 else y (a,i.2)) :=
    GenericAlgebraic.eval_surjective x hx d (by simpa only [Fintype.card_prod,
      Fintype.card_bool] using hd) _
  choose p hp using hp
  refine ⟨fun t => (monomialBasis σ K d).repr (p t.1) t.2, ?_⟩
  funext t
  change eval (x (false,t.2)) (polynomial _ t.1) + eval (x (true,t.2)) (polynomial _ t.1) = _
  rw [polynomial_repr p, congrFun (hp t.1) (false,t.2), congrFun (hp t.1) (true,t.2)]
  simp

/-- Any prescribed symmetric edge equations have the expected uniform fiber
size, in every finite field. -/
theorem card_paired_fiber {A I σ K : Type*} [Fintype A] [Fintype I]
    [Finite σ] [Field K] [Finite K]
    (x : Bool × I → σ → K) (hx : Function.Injective x) (d : ℕ)
    (hd : 2 * Fintype.card I - 1 ≤ d) (y : A × I → K) :
    Nat.card {c : A × Monomials σ d → K // ∀ t : A × I,
      eval (x (false,t.2)) (polynomial c t.1) +
        eval (x (true,t.2)) (polynomial c t.1) = y t} *
      (Nat.card K) ^ (Fintype.card A * Fintype.card I) =
        Nat.card (A × Monomials σ d → K) := by
  have h := GenericAlgebraic.card_fiber_mul_card (pairedEvaluation (A := A) x d)
    (pairedEvaluation_surjective x hx d hd) y
  simpa only [Nat.card_fun, Nat.card_prod, Nat.card_eq_fintype_card (α := A),
    Nat.card_eq_fintype_card (α := I), funext_iff, pairedEvaluation, AddMonoidHom.coe_mk,
    ZeroHom.coe_mk] using h

open SimpleGraph

abbrev Edge (V : Type*) := (⊤ : SimpleGraph V).edgeSet

def edgeEvent {A K : Type*} [Field K] {b d : ℕ}
    (c : A × Monomials (Fin b ⊕ Fin b) d → K) (e : Edge (Fin b → K)) : Prop :=
  e.val ∈ (graph c).edgeSet

lemma edgeEvent_iff {A K : Type*} [Field K] {b d : ℕ}
    (c : A × Monomials (Fin b ⊕ Fin b) d → K) (e : Edge (Fin b → K)) :
    edgeEvent c e ↔ ∀ a,
      eval (Sum.elim e.val.out.1 e.val.out.2) (polynomial c a) +
        eval (Sum.elim e.val.out.2 e.val.out.1) (polynomial c a) = 0 := by
  have hne : e.val.out.1 ≠ e.val.out.2 := (orientedPair_adj ⊤ (false,e)).ne
  change e.val ∈ (graph c).edgeSet ↔ _
  conv_lhs => rw [← e.val.out_eq]
  change (e.val.out.1 ≠ e.val.out.2 ∧ _) ↔ _
  exact and_iff_right hne

noncomputable def edgePoint {K : Type*} [Field K] {b : ℕ}
    (e : Bool × Edge (Fin b → K)) : Fin b ⊕ Fin b → K :=
  Sum.elim (orientedPair ⊤ e).1 (orientedPair ⊤ e).2

lemma edgePoint_injective {K : Type*} [Field K] {b : ℕ} :
    Function.Injective (edgePoint (K := K) (b := b)) := by
  intro e f h
  apply orientedPair_injective ⊤
  apply Prod.ext
  · funext j; exact congrFun h (.inl j)
  · funext j; exact congrFun h (.inr j)

lemma card_edge_events {A K : Type*} [Fintype A] [Field K] [Finite K] {b d : ℕ}
    (S : Finset (Edge (Fin b → K))) (hd : 2 * S.card - 1 ≤ d) :
    Nat.card {c : A × Monomials (Fin b ⊕ Fin b) d → K // ∀ e ∈ S, edgeEvent c e} *
      (Nat.card K) ^ (Fintype.card A * S.card) =
        Nat.card (A × Monomials (Fin b ⊕ Fin b) d → K) := by
  classical
  let x (t : Bool × S) := edgePoint (t.1,t.2.val)
  have hx : Function.Injective x := by
    intro e f h
    have h' := edgePoint_injective h
    apply Prod.ext
    · exact congrArg (fun t : Bool × Edge (Fin b → K) => t.1) h'
    · apply Subtype.ext
      exact congrArg (fun t : Bool × Edge (Fin b → K) => t.2) h'
  have h := card_paired_fiber (A := A) x hx d (by simpa using hd) 0
  have heq : (fun c : A × Monomials (Fin b ⊕ Fin b) d → K =>
      ∀ t : A × S, eval (x (false,t.2)) (polynomial c t.1) +
        eval (x (true,t.2)) (polynomial c t.1) = (0 : A × S → K) t) =
      (fun c => ∀ e ∈ S, edgeEvent c e) := by
    funext c
    apply propext
    constructor
    · intro h e he
      apply (edgeEvent_iff c e).mpr
      intro a
      exact h (a,⟨e,he⟩)
    · intro h t
      exact (edgeEvent_iff c t.2.val).mp (h t.2.val t.2.prop) t.1
  simpa only [heq, Fintype.card_coe] using h

open Classical in
lemma edge_events_mean {A K : Type*} [Fintype A] [Field K] [Fintype K] {b d : ℕ}
    (S : Finset (Edge (Fin b → K))) (hd : 2 * S.card - 1 ≤ d) :
    (∑ c : A × Monomials (Fin b ⊕ Fin b) d → K,
      if ∀ e ∈ S, edgeEvent c e then (1 : ℝ) else 0) =
      Fintype.card (A × Monomials (Fin b ⊕ Fin b) d → K) /
        (Fintype.card K : ℝ) ^ (Fintype.card A * S.card) := by
  classical
  letI : Fintype {c : A × Monomials (Fin b ⊕ Fin b) d → K // ∀ e ∈ S, edgeEvent c e} :=
    Fintype.ofFinite _
  have h := card_edge_events (A := A) S hd
  simp only [Nat.card_eq_fintype_card, Fintype.card_subtype] at h
  rw [sum_boole]
  apply (eq_div_iff (pow_ne_zero _ (by exact_mod_cast Fintype.card_ne_zero (α := K)))).mpr
  exact_mod_cast h

end SymmetricCounting

/- ## SchwartzFinite -/

/- Cardinal forms of Schwartz-Zippel, including reduction modulo large primes. -/
namespace SchwartzFinite

open Finset MvPolynomial

lemma card_zeros_mul_card_le {σ K : Type*} [Fintype σ] [Field K] [Fintype K]
    (P : MvPolynomial σ K) (hP : P ≠ 0) :
    Nat.card {x : σ → K // eval x P = 0} * Nat.card K ≤
      P.totalDegree * Nat.card (σ → K) := by
  classical
  let e := Fintype.equivFin σ
  let Q := renameEquiv K e P
  have hQ : Q ≠ 0 := (map_ne_zero_iff (renameEquiv K e) (renameEquiv K e).injective).mpr hP
  let E : {x : σ → K // eval x P = 0} ≃
      {x : Fin (Fintype.card σ) → K // eval x Q = 0} :=
    { toFun := fun x => ⟨x.val ∘ e.symm, by
        simpa only [Q, renameEquiv_apply, eval_rename, Function.comp_assoc,
          Equiv.symm_comp_self, Function.comp_id] using x.prop⟩
      invFun := fun x => ⟨x.val ∘ e, by
        simpa only [Q, renameEquiv_apply, eval_rename] using x.prop⟩
      left_inv := by intro x; ext s; simp
      right_inv := by intro x; ext s; simp }
  have h := schwartz_zippel_totalDegree hQ (univ : Finset K)
  simp only [Fintype.piFinset_univ, card_univ, ← Fintype.card_subtype] at h
  have hq : (0 : ℚ≥0) < Fintype.card K := by exact_mod_cast Fintype.card_pos
  have hh := (div_le_div_iff₀ (pow_pos hq _) hq).mp h
  have ht : Q.totalDegree = P.totalDegree := totalDegree_renameEquiv e P
  rw [ht] at hh
  rw [Nat.card_congr E, Nat.card_fun]
  simp only [Nat.card_eq_fintype_card]
  exact_mod_cast hh

/-- A nonzero integer polynomial stays nonzero modulo every sufficiently
large modulus. -/
lemma eventually_map_zmod_ne_zero {σ : Type*} (P : MvPolynomial σ ℤ) (hP : P ≠ 0) :
    ∃ B : ℕ, ∀ n : ℕ, B < n → MvPolynomial.map (Int.castRingHom (ZMod n)) P ≠ 0 := by
  obtain ⟨m, hm⟩ := exists_coeff_ne_zero hP
  refine ⟨(coeff m P).natAbs, fun n hn he => ?_⟩
  have hc := congrArg (coeff m) he
  simp only [coeff_map, coeff_zero] at hc
  have hd := Int.natCast_dvd.mp ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hc)
  exact (not_le_of_gt hn) (Nat.le_of_dvd (Int.natAbs_pos.mpr hm) hd)

lemma totalDegree_map_le {σ R S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (P : MvPolynomial σ R) : (MvPolynomial.map f P).totalDegree ≤ P.totalDegree := by
  classical
  exact Finset.sup_mono (support_map_subset f P)

end SchwartzFinite

/- ## FiniteGenericGraph -/

/- Dense specializations of a generic polynomial graph over finite fields. -/
set_option maxHeartbeats 1200000

namespace FiniteGenericGraph

open Finset SimpleGraph GenericPolynomial GenericSymmetric SymmetricCounting MvPolynomial

open Classical in
lemma sum_edgeEvents {A K : Type*} [Field K] [Fintype K] {b d : ℕ}
    (c : A × Monomials (Fin b ⊕ Fin b) d → K) :
    (∑ e : Edge (Fin b → K), if edgeEvent c e then (1 : ℝ) else 0) =
      Nat.card (graph c).edgeSet := by
  classical
  let E : {e : Edge (Fin b → K) // edgeEvent c e} ≃ (graph c).edgeSet :=
    { toFun := fun e => ⟨e.val.val, e.prop⟩
      invFun := fun e => ⟨⟨e.val, edgeSet_mono le_top e.prop⟩, e.prop⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  rw [sum_boole, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card, Nat.card_congr E]

/-- If the average edge count is at least one and the field is large compared
with the exceptional polynomial's degree, some nonexceptional coefficient
tuple has at least half the average number of edges. -/
theorem exists_dense {A K : Type*} [Fintype A] [Field K] [Fintype K] {b d : ℕ}
    (hd : 3 ≤ d) (P : MvPolynomial (A × Monomials (Fin b ⊕ Fin b) d) K)
    (hP : P ≠ 0) (hsize : 16 * P.totalDegree ≤ Fintype.card K)
    (hmean : 1 ≤ (Nat.card (Edge (Fin b → K)) : ℝ) / (Fintype.card K : ℝ)^Fintype.card A) :
    ∃ c : A × Monomials (Fin b ⊕ Fin b) d → K, eval c P ≠ 0 ∧
      (Nat.card (Edge (Fin b → K)) : ℝ) / (2 * (Fintype.card K : ℝ)^Fintype.card A) ≤
        Nat.card (graph c).edgeSet := by
  classical
  let X := A × Monomials (Fin b ⊕ Fin b) d → K
  let E := Edge (Fin b → K)
  let ρ : ℝ := 1 / (Fintype.card K : ℝ)^Fintype.card A
  let μ : ℝ := Fintype.card E * ρ
  let w (c : X) : ℝ := ∑ e : E, if edgeEvent c e then 1 else 0
  have hq : (0 : ℝ) < Fintype.card K := by exact_mod_cast Fintype.card_pos
  have hρ : 0 < ρ := one_div_pos.mpr (pow_pos hq _)
  have hμ : 1 ≤ μ := by simpa only [μ, ρ, mul_one_div, Nat.card_eq_fintype_card] using hmean
  have hone (e : E) : (∑ c : X, if edgeEvent c e then (1 : ℝ) else 0) = Fintype.card X * ρ := by
    have h := edge_events_mean (A := A) (d := d) {e} (by simp; omega)
    simpa only [mem_singleton, forall_eq, card_singleton, mul_one, mul_one_div, ρ, X] using h
  have htwo (e f : E) (hef : e ≠ f) :
      (∑ c : X, if edgeEvent c e ∧ edgeEvent c f then (1 : ℝ) else 0) =
        Fintype.card X * ρ^2 := by
    have h := edge_events_mean (A := A) (d := d) {e,f} (by simp [hef]; omega)
    simp only [forall_mem_insert, mem_singleton, forall_eq, card_pair hef] at h
    rw [h]
    simp only [ρ, div_pow, one_pow, pow_mul, mul_one_div, ← Nat.card_eq_fintype_card]
    rfl
  have hm := FiniteAveraging.event_moments edgeEvent ρ hρ.le hone htwo
  change (∑ c, w c = Fintype.card X * μ) ∧
    (∑ c, (w c)^2 ≤ Fintype.card X * (μ^2 + μ)) at hm
  have hsquare : ∑ c, (w c)^2 ≤ 2 * Fintype.card X * μ^2 := by
    calc
      _ ≤ Fintype.card X * (μ^2 + μ) := hm.2
      _ ≤ _ := by
        have hh := mul_nonneg (Nat.cast_nonneg (Fintype.card X) : (0 : ℝ) ≤ _)
          (show 0 ≤ μ^2 - μ by nlinarith)
        nlinarith [hh]
  let bad : Finset X := univ.filter (fun c => eval c P = 0)
  have hbad : 16 * (bad.card : ℝ) ≤ Fintype.card X := by
    letI : Fintype {x : X // eval x P = 0} := Fintype.ofFinite _
    have hz := SchwartzFinite.card_zeros_mul_card_le P hP
    simp only [Nat.card_eq_fintype_card, Fintype.card_subtype] at hz
    have hz' : (bad.card : ℝ) * Fintype.card K ≤ P.totalDegree * (Fintype.card X : ℝ) := by
      exact_mod_cast hz
    have hsize' : 16 * (P.totalDegree : ℝ) ≤ Fintype.card K := by exact_mod_cast hsize
    have hc : (0 : ℝ) ≤ Fintype.card X := Nat.cast_nonneg _
    have hh := mul_le_mul_of_nonneg_right hsize' hc
    have hbb : 0 ≤ (bad.card : ℝ) := Nat.cast_nonneg _
    nlinarith
  obtain ⟨c, hc, hw⟩ := FiniteAveraging.exists_good_large w
    (fun c => sum_nonneg (fun e _ => by split_ifs <;> norm_num)) μ (by linarith)
    hm.1 hsquare bad hbad
  refine ⟨c, ?_, ?_⟩
  · simpa only [bad, mem_filter, mem_univ, true_and] using hc
  · rw [show μ / 2 = (Nat.card E : ℝ) / (2 * (Fintype.card K : ℝ)^Fintype.card A) by
      simp only [μ, ρ, Nat.card_eq_fintype_card, mul_one_div, div_div]; ring] at hw
    have hwe : w c = (Nat.card (graph c).edgeSet : ℝ) := sum_edgeEvents c
    rwa [hwe] at hw

lemma complete_edges_real {K : Type*} [Field K] [Fintype K] (b : ℕ) :
    (Nat.card (Edge (Fin b → K)) : ℝ) =
      (Fintype.card K : ℝ)^b * ((Fintype.card K : ℝ)^b - 1) / 2 := by
  classical
  rw [Nat.card_eq_fintype_card, card_edgeSet, card_edgeFinset_top_eq_card_choose_two,
    Nat.cast_choose_two]
  simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow]

/-- A convenient power-form lower bound, with an absolute constant. -/
theorem exists_dense_power {A K : Type*} [Fintype A] [Field K] [Fintype K] {b d : ℕ}
    (hb : 1 ≤ b) (hA : Fintype.card A ≤ b) (hd : 3 ≤ d)
    (hq : 4 ≤ Fintype.card K)
    (P : MvPolynomial (A × Monomials (Fin b ⊕ Fin b) d) K)
    (hP : P ≠ 0) (hsize : 16 * P.totalDegree ≤ Fintype.card K) :
    ∃ c : A × Monomials (Fin b ⊕ Fin b) d → K, eval c P ≠ 0 ∧
      (Fintype.card K : ℝ)^(2*b) ≤ 8 * (Fintype.card K : ℝ)^Fintype.card A *
        Nat.card (graph c).edgeSet := by
  have hq' : (4 : ℝ) ≤ Fintype.card K := by exact_mod_cast hq
  have hq1 : (1 : ℝ) ≤ Fintype.card K := by linarith
  have hqb : (4 : ℝ) ≤ (Fintype.card K : ℝ)^b := by
    calc
      _ ≤ (Fintype.card K : ℝ) := hq'
      _ = (Fintype.card K : ℝ)^1 := (pow_one _).symm
      _ ≤ _ := pow_le_pow_right₀ hq1 hb
  have hab : (Fintype.card K : ℝ)^Fintype.card A ≤ (Fintype.card K : ℝ)^b :=
    pow_le_pow_right₀ hq1 hA
  have hE := complete_edges_real (K := K) b
  have hmean : 1 ≤ (Nat.card (Edge (Fin b → K)) : ℝ) /
      (Fintype.card K : ℝ)^Fintype.card A := by
    apply (le_div_iff₀ (pow_pos (by linarith) _)).mpr
    nlinarith
  obtain ⟨c, hc, he⟩ := exists_dense hd P hP hsize hmean
  refine ⟨c, hc, ?_⟩
  have he' := (div_le_iff₀ (show 0 < 2 * (Fintype.card K : ℝ)^Fintype.card A by positivity)).mp he
  rw [mul_comm 2 b, pow_mul]
  nlinarith

end FiniteGenericGraph


/- ## GenericLower -/

/- Exact lower-bound constructions for balanced rooted graph powers. -/
namespace GenericLower

open Finset SimpleGraph GenericPolynomial GenericSymmetric
open Erdos571.RootedSunflower

lemma corePower_fiber_embedding {A R W I : Type*} [DecidableEq A]
    (H : SimpleGraph (A ⊕ R)) (C : Finset A) (a : A) (ha : a ∉ C)
    (p : ℕ) (e : I ↪ Fin p) {G : SimpleGraph W} (g : (corePower H C p).Copy G) :
    ∃ r : R ↪ W, Nonempty (I ↪ {f : H.Copy G // ∀ x, f (.inr x) = r x}) := by
  let r : R ↪ W :=
    { toFun := fun x => g (.inr (.inr x))
      inj' := fun x y h => Sum.inr.inj (Sum.inr.inj (g.injective h)) }
  let f (i : I) : {f : H.Copy G // ∀ x, f (.inr x) = r x} :=
    ⟨g.comp (sliceCopy H C (e i)), fun _ => rfl⟩
  refine ⟨r, ⟨⟨f, ?_⟩⟩⟩
  intro i j h
  have he := congrArg (fun f => f.val (.inl a)) h
  have hs := g.injective he
  change Erdos571.RootedSunflower.slice C (e i) (.inl a) =
    Erdos571.RootedSunflower.slice C (e j) (.inl a) at hs
  simp only [Erdos571.RootedSunflower.slice, dif_neg ha, Sum.inl.injEq, Prod.mk.injEq] at hs
  exact e.injective hs.1

lemma corePower_no_isolated {A R : Type*}
    (H : SimpleGraph (A ⊕ R)) (hH : ∀ u, ∃ v, H.Adj u v)
    (C : Finset A) (p : ℕ) (hp : 0 < p) :
    ∀ u, ∃ v, (corePower H C p).Adj u v := by
  classical
  intro u
  have hi : ∃ i : Fin p, ∀ x, u = .inl x → x.1 = i := by
    cases u with
    | inl x => exact ⟨x.1, fun _ h => by cases h; rfl⟩
    | inr x => exact ⟨⟨0,hp⟩, fun _ h => by cases h⟩
  obtain ⟨i, hi⟩ := hi
  obtain ⟨v, hv⟩ := hH (projection u)
  refine ⟨Erdos571.RootedSunflower.slice C i v, ?_⟩
  have h := (sliceCopy H C i).toHom.map_adj hv
  change (corePower H C p).Adj
    (Erdos571.RootedSunflower.slice C i (projection u)) _ at h
  rwa [GenericRooted.slice_projection C i u hi] at h

/-- One fixed power threshold works at all sufficiently large primes. In fact,
every proper-core power is avoided simultaneously. -/
theorem exists_dense_core_free {A R : Type} [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (a b : ℕ) (hb : 1 ≤ b) (hab : a ≤ b)
    (hbal : ∀ C : Finset A, b * (Fintype.card A - C.card) ≤
      a * Nat.card (PetalEdge H C)) :
    ∃ M B : ℕ, 2 ≤ M ∧ 4 ≤ B ∧ ∀ q : ℕ, q.Prime → B ≤ q →
      ∃ G : SimpleGraph (Fin b → ZMod q),
        (∀ C : Finset A, C ≠ univ → (corePower H C M).Free G) ∧
        (q : ℝ)^(2*b) ≤ 8 * (q : ℝ)^a * Nat.card G.edgeSet := by
  classical
  let p := b * (Fintype.card A + Fintype.card R) + 2
  let d := max 3 (2 * p * Nat.card H.edgeSet)
  obtain ⟨P, hP, N, hN⟩ := GenericUniform.exists_uniform_bound (Q := Fin a) H b d p le_rfl
    (by dsimp [d]; omega) (by simpa only [Fintype.card_fin] using hbal)
  obtain ⟨B₀, hB₀⟩ := SchwartzFinite.eventually_map_zmod_ne_zero P hP
  let M := Fintype.card (Fin N → Bool) + 1
  let B := max 4 (max (B₀+1) (16 * P.totalDegree))
  have hM : 2 ≤ M := by have := Fintype.card_pos (α := Fin N → Bool); dsimp [M]; omega
  refine ⟨M, B, hM, by dsimp [B]; omega, ?_⟩
  intro q hq hB
  letI : Fact q.Prime := ⟨hq⟩
  have hq4 : 4 ≤ q := by dsimp [B] at hB; omega
  have hnonzero := hB₀ q (by dsimp [B] at hB; omega)
  have hsize : 16 * (MvPolynomial.map (Int.castRingHom (ZMod q)) P).totalDegree ≤
      Fintype.card (ZMod q) := by
    rw [ZMod.card]
    have := SchwartzFinite.totalDegree_map_le (Int.castRingHom (ZMod q)) P
    dsimp [B] at hB
    omega
  obtain ⟨c, hc, he⟩ := FiniteGenericGraph.exists_dense_power (A := Fin a) hb
    (by simpa only [Fintype.card_fin] using hab) (by dsimp [d]; omega)
    (by simpa only [ZMod.card] using hq4) _ hnonzero hsize
  refine ⟨graph c, ?_, ?_⟩
  · intro C hC
    rintro ⟨g⟩
    obtain ⟨x, hx⟩ : ∃ x : A, x ∉ C := by
      by_contra! hh
      exact hC (eq_univ_iff_forall.mpr hh)
    let e : (Fin N → Bool) ↪ Fin M :=
      (Fintype.equivFin _).toEmbedding.trans (Fin.castAddEmb 1)
    exact hN (ZMod q) c (by simpa only [MvPolynomial.eval_map] using hc)
      (corePower_fiber_embedding H C x hx M e g)
  · simpa only [ZMod.card, Fintype.card_fin] using he

lemma prime_at_large_power_scale (b B n : ℕ) (hb : 1 ≤ b) (hB : 4 ≤ B)
    (hn : (4*B)^b ≤ n) :
    ∃ q : ℕ, q.Prime ∧ B ≤ q ∧ q^b ≤ n ∧ n ≤ (4*q)^b := by
  have hn' : 16^b ≤ n := (Nat.pow_le_pow_left (by omega : 16 ≤ 4*B) b).trans hn
  obtain ⟨q, hq, hq4, hqn, hnq⟩ := Erdos571.NormCase.prime_at_power_scale b n hb hn'
  refine ⟨q, hq, ?_, hqn, hnq⟩
  by_contra h
  have hlt := Nat.pow_lt_pow_left (by omega : 4*q < 4*B) (by omega : b ≠ 0)
  omega

lemma rpow_scale (a b n q : ℕ) (hb : 1 ≤ b) (hab : a ≤ b) (hn : n ≤ (4*q)^b) :
    (n : ℝ)^(2 - (a : ℝ)/(b : ℝ)) ≤ (4 : ℝ)^(2*b-a) * (q : ℝ)^(2*b-a) := by
  have hb' : (0 : ℝ) < b := by exact_mod_cast (show 0 < b by omega)
  have ha' : (a : ℝ)/(b : ℝ) ≤ 1 := (div_le_one hb').mpr (by exact_mod_cast hab)
  have h := Real.rpow_le_rpow (Nat.cast_nonneg n)
    (show (n : ℝ) ≤ (4*(q : ℝ))^b by exact_mod_cast hn) (by linarith : 0 ≤ 2 - (a : ℝ)/(b : ℝ))
  rw [← Real.rpow_natCast_mul (by positivity)] at h
  have he : (b : ℝ) * (2 - (a : ℝ)/(b : ℝ)) = ((2*b-a : ℕ) : ℝ) := by
    rw [Nat.cast_sub (by omega : a ≤ 2*b)]
    push_cast
    field_simp
  rw [he, Real.rpow_natCast, mul_pow] at h
  exact h

/-- Every balanced rooted template with no isolated vertices has a fixed
rooted power with the exact predicted lower exponent. -/
theorem exists_power_exact_lower {A R : Type} [Fintype A] [Fintype R] [Nonempty A]
    (H : SimpleGraph (A ⊕ R)) (hH : ∀ u, ∃ v, H.Adj u v)
    (a b : ℕ) (hb : 1 ≤ b) (hab : a ≤ b)
    (hbal : ∀ C : Finset A, b * (Fintype.card A - C.card) ≤
      a * Nat.card (PetalEdge H C)) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n : ℝ)^(2 - (a : ℝ)/(b : ℝ)))
      (fun n : ℕ => (extremalNumber n (corePower H ∅ M) : ℝ)) := by
  classical
  obtain ⟨M, B, hM, hB, hgood⟩ := exists_dense_core_free H a b hb hab hbal
  refine ⟨M, hM, Asymptotics.IsBigO.of_bound (8 * (4 : ℝ)^(2*b-a)) ?_⟩
  filter_upwards [Filter.eventually_ge_atTop ((4*B)^b)] with n hn
  rw [Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _), abs_of_nonneg (Nat.cast_nonneg _)]
  obtain ⟨q, hq, hBq, hqn, hnq⟩ := prime_at_large_power_scale b B n hb hB hn
  letI : Fact q.Prime := ⟨hq⟩
  obtain ⟨G, hfree, he⟩ := hgood q hq hBq
  let f : (Fin b → ZMod q) ↪ Fin n :=
    (Function.Embedding.nonempty_of_card_le (by
      simpa only [Fintype.card_fun, Fintype.card_fin, ZMod.card] using hqn)).some
  have hf := Erdos571.NormCase.free_map_of_no_isolated
    (corePower_no_isolated H hH ∅ M (by omega)) (hfree ∅ (by
      intro he
      have hempty : (∅ : Finset A).Nonempty := he.symm ▸ univ_nonempty
      exact not_nonempty_empty hempty)) f
  have hpad := card_edgeFinset_le_extremalNumber hf
  have hmap := card_edgeFinset_map f G
  simp only [← card_edgeSet, ← Nat.card_eq_fintype_card] at hpad hmap
  rw [hmap] at hpad
  have hpad' : (Nat.card G.edgeSet : ℝ) ≤ extremalNumber n (corePower H ∅ M) := by
    exact_mod_cast (show Nat.card G.edgeSet ≤ extremalNumber n (corePower H ∅ M) by
      simpa only [Nat.card_fin] using hpad)
  have hqpos : (0 : ℝ) < q := by exact_mod_cast hq.pos
  have he' : (q : ℝ)^(2*b-a) ≤ 8 * Nat.card G.edgeSet := by
    apply (mul_le_mul_iff_left₀ (pow_pos hqpos a)).mp
    rw [← pow_add, Nat.sub_add_cancel (by omega : a ≤ 2*b)]
    nlinarith [he]
  calc
    _ ≤ (4 : ℝ)^(2*b-a) * (q : ℝ)^(2*b-a) := rpow_scale a b n q hb hab hnq
    _ ≤ (4 : ℝ)^(2*b-a) * (8 * (extremalNumber n (corePower H ∅ M) : ℝ)) := by
      gcongr
      exact he'.trans (mul_le_mul_of_nonneg_left hpad' (by norm_num))
    _ = _ := by ring

end GenericLower



/- ## BalancedExactLower -/

/- Exact lower exponents for the explicit balanced rooted caterpillars. -/
namespace Erdos571.BalancedExactLower

open Finset SimpleGraph BalancedTree RootedSunflower

lemma petal_balance (k m : ℕ) (C : Finset (Fin (k+1))) :
    (k+m+1) * (Fintype.card (Fin (k+1)) - C.card) ≤
      (k+1) * Nat.card (PetalEdge (graph (leafCount k m)) C) := by
  classical
  let S := univ \ C
  have hSc : S.card = Fintype.card (Fin (k+1)) - C.card := by simp only [S, card_sdiff_of_subset (subset_univ C), card_univ]
  have hpetal : Nat.card (PetalEdge (graph (leafCount k m)) C) =
      (incidentEdges (leafCount k m) S).card := by
    simp only [PetalEdge, Nat.card_eq_fintype_card, Fintype.card_subtype]
    congr 1
    ext e
    simp [incidentEdges, S]
  have h := balanced k m S
  have hk : (0 : ℚ) < k+1 := by positivity
  have hρ : (k+1 : ℚ) * (1+slope k m) = k+m+1 := by
    dsimp [BalancedTree.slope]
    field_simp
    ring
  have hm := mul_le_mul_of_nonneg_left h hk.le
  rw [← mul_assoc, hρ] at hm
  rw [← hSc, hpetal]
  exact_mod_cast hm

lemma no_isolated (k m : ℕ) : ∀ u, ∃ v, (graph (leafCount k m)).Adj u v := by
  letI : Nontrivial (Vertex (leafCount k m)) := Fintype.one_lt_card_iff_nontrivial.mp (by
    simp only [Vertex, Fintype.card_sum, Fintype.card_fin, card_roots]
    omega)
  exact (isTree (leafCount k m)).isConnected.preconnected.exists_adj_of_nontrivial

lemma exponent_eq (k m : ℕ) :
    (2 : ℝ) - ((k+1 : ℕ) : ℝ) / ((k+m+1 : ℕ) : ℝ) =
      ((2 - (1+slope k m)⁻¹ : ℚ) : ℝ) := by
  have hd := congrArg (fun q : ℚ => (q : ℝ)) (density_eq k m)
  rw [card_edges, sum_leafCount] at hd
  push_cast at hd ⊢
  rw [hd, inv_div]
  congr 2 <;> ring

/-- The graph and the multiplicative constant are fixed: there is no
`epsilon`-dependent loss in the exponent. -/
theorem lower (k m : ℕ) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n : ℝ)^((2 - (1+slope k m)⁻¹ : ℚ) : ℝ))
      (fun n : ℕ => (extremalNumber n (corePower (graph (leafCount k m)) ∅ M) : ℝ)) := by
  obtain ⟨M, hM, h⟩ := GenericLower.exists_power_exact_lower (graph (leafCount k m))
    (no_isolated k m) (k+1) (k+m+1) (by omega) (by omega) (petal_balance k m)
  exact ⟨M, hM, by simpa only [exponent_eq] using h⟩

/-- Every rational target exponent has an exact lower bound for a fixed power
of its balanced rooted caterpillar. The matching single-graph upper bound is
not asserted here. -/
theorem rational_lower (α : ℚ) (hα : 1 ≤ α) (hα2 : α < 2) :
    ∃ k m M : ℕ, 2 ≤ M ∧ α = 2 - (1+slope k m)⁻¹ ∧
      Asymptotics.IsBigO Filter.atTop (fun n : ℕ => (n : ℝ)^(α : ℝ))
        (fun n : ℕ => (extremalNumber n (corePower (graph (leafCount k m)) ∅ M) : ℝ)) := by
  have hd : (0 : ℚ) < 2-α := by linarith
  obtain ⟨k, m, hkm⟩ := every_density ((2-α)⁻¹) ((one_le_inv₀ hd).mpr (by linarith))
  have he : α = 2 - (1+slope k m)⁻¹ := by rw [hkm, inv_inv]; ring
  obtain ⟨M, hM, hlower⟩ := lower k m
  exact ⟨k, m, M, hM, he, by simpa only [← he] using hlower⟩

end Erdos571.BalancedExactLower



/- With the exact lower construction established, only the rooted-power
upper bound is needed to prove the rational-exponent statement. -/
namespace Erdos571.BalancedExactLower

open Finset SimpleGraph BalancedTree RootedSunflower

noncomputable def coreEmptyEquiv {A R : Type*} (p : ℕ) :
    CoreVertex A R ∅ p ≃ ((Fin p × A) ⊕ R) where
  toFun := fun x => match x with
    | .inl x => .inl (x.1,x.2.val)
    | .inr (.inl x) => False.elim (notMem_empty x.val x.prop)
    | .inr (.inr r) => .inr r
  invFun := fun x => match x with
    | .inl x => .inl (x.1,⟨x.2,notMem_empty _⟩)
    | .inr r => .inr (.inr r)
  left_inv := by
    intro x
    cases x with
    | inl x => rfl
    | inr x => cases x with
      | inl x => exact False.elim (notMem_empty x.val x.prop)
      | inr x => rfl
  right_inv := by intro x; cases x <;> rfl

noncomputable def coreEmptyIso {A R : Type*} (H : SimpleGraph (A ⊕ R))
    (hr : ∀ r s : R, ¬ H.Adj (.inr r) (.inr s)) (p : ℕ) :
    corePower H ∅ p ≃g RootedPacking.power H p where
  toEquiv := coreEmptyEquiv p
  map_rel_iff' := by
    intro x y
    cases x with
    | inl x =>
      cases y with
      | inl y => exact and_comm
      | inr y =>
        cases y with
        | inl y => exact False.elim (notMem_empty y.val y.prop)
        | inr y => exact ⟨fun h => ⟨h, trivial⟩, fun h => h.1⟩
    | inr x =>
      cases x with
      | inl x => exact False.elim (notMem_empty x.val x.prop)
      | inr x =>
        cases y with
        | inl y => exact ⟨fun h => ⟨h, trivial⟩, fun h => h.1⟩
        | inr y =>
          cases y with
          | inl y => exact False.elim (notMem_empty y.val y.prop)
          | inr y =>
            change False ↔ H.Adj (.inr x) (.inr y) ∧ True
            simp only [hr, false_and]

/-- Exact lower bound expressed using the original caterpillar-power type. -/
theorem power_lower (k m : ℕ) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n : ℝ)^((2 - (1+BalancedTree.slope k m)⁻¹ : ℚ) : ℝ))
      (fun n : ℕ => (extremalNumber n (power (leafCount k m) M) : ℝ)) := by
  obtain ⟨M, hM, h⟩ := lower k m
  have he (n : ℕ) : extremalNumber n (corePower (graph (leafCount k m)) ∅ M) =
      extremalNumber n (power (leafCount k m) M) :=
    by
      have hp : RootedPacking.power (graph (leafCount k m)) M = power (leafCount k m) M := by
        ext u v
        cases u <;> cases v <;> rfl
      rw [← hp]
      exact extremalNumber_congr_right (coreEmptyIso (graph (leafCount k m)) (roots_independent _) M)
  exact ⟨M, hM, by simpa only [he] using h⟩

/-- A matching upper bound for powers of the explicit balanced caterpillars
would now suffice on its own; the exact lower bound is already proved. -/
theorem rational_turan_of_power_upper
    (hupper : ∀ k m M : ℕ, 2 ≤ M → Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (power (leafCount k m) M) : ℝ))
      (fun n : ℕ => (n : ℝ)^((2 - (1+BalancedTree.slope k m)⁻¹ : ℚ) : ℝ))) :
    ∀ α : ℚ, 1 ≤ α → α < 2 →
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        Asymptotics.IsTheta Filter.atTop
          (fun n : ℕ => (extremalNumber n G : ℝ))
          (fun n : ℕ => (n : ℝ)^(α : ℝ)) := by
  apply rational_turan_of_power_bounds
  intro k m
  obtain ⟨M, hM, hl⟩ := power_lower k m
  exact ⟨M, ⟨hupper k m M hM, hl⟩⟩

end Erdos571.BalancedExactLower



/-! A bounded directed conflict list permits constant-fraction thinning. -/
namespace LocalConflict

open Finset

/-- A directed relation of maximum outdegree D has an independent subset of
size at least a 1/(2D+1) fraction. No bound on indegrees is required. -/
theorem exists_independent_fraction {V : Type*} [DecidableEq V]
    (r : V → V → Prop) [DecidableRel r] (D : ℕ) (F : Finset V)
    (hout : ∀ v ∈ F, (F.filter (r v)).card ≤ D) :
    ∃ S ⊆ F, F.card ≤ (2*D+1) * S.card ∧
      ∀ v ∈ S, ∀ w ∈ S, v ≠ w → ¬r v w := by
  classical
  induction hcard : F.card using Nat.strong_induction_on generalizing F with
  | h n ih =>
    by_cases hF : F.Nonempty
    swap
    · refine ⟨∅, empty_subset _, ?_, by simp⟩
      have hz : F = ∅ := not_nonempty_iff_eq_empty.mp hF
      simp only [hz, card_empty] at hcard
      simp only [card_empty, mul_zero]; omega
    let nb (v : V) := F.filter (fun w => r v w ∨ r w v)
    have hsum : ∑ v ∈ F, (nb v).card ≤ ∑ _v ∈ F, 2*D := by
      have hswap : (∑ v ∈ F, (F.filter (fun w => r w v)).card) =
          ∑ v ∈ F, (F.filter (r v)).card :=
        (sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow r).symm
      calc
        _ ≤ ∑ v ∈ F, ((F.filter (r v)).card + (F.filter (fun w => r w v)).card) := by
          apply sum_le_sum
          intro v _
          dsimp only [nb]
          rw [filter_or]
          exact card_union_le _ _
        _ = 2 * ∑ v ∈ F, (F.filter (r v)).card := by rw [sum_add_distrib, hswap]; omega
        _ ≤ 2 * ∑ _v ∈ F, D := Nat.mul_le_mul_left 2 (sum_le_sum hout)
        _ = _ := by simp; ring
    obtain ⟨v, hv, hd⟩ := exists_le_of_sum_le hF hsum
    let N := insert v (nb v)
    have hNF : N ⊆ F := insert_subset hv (filter_subset _ _)
    have hN : N.card ≤ 2*D+1 := (card_insert_le _ _).trans (by omega)
    let F' := F \ N
    have hFF : F' ⊆ F := sdiff_subset
    have hlt : F'.card < n := by
      have hpos : 0 < N.card := card_pos.mpr ⟨v, mem_insert_self _ _⟩
      have hsplit := card_sdiff_add_card_eq_card hNF
      dsimp [F']
      omega
    obtain ⟨S, hSF, hSc, hS⟩ := ih F'.card hlt F' (by
      intro w hw
      exact (card_le_card (filter_subset_filter (r w) hFF)).trans (hout w (hFF hw))) rfl
    have hvS : v ∉ S := by
      intro hs
      exact (mem_sdiff.mp (hSF hs)).2 (mem_insert_self _ _)
    refine ⟨insert v S, insert_subset hv (hSF.trans hFF), ?_, ?_⟩
    · have hsplit := card_sdiff_add_card_eq_card hNF
      change F'.card + N.card = F.card at hsplit
      rw [card_insert_of_notMem hvS]
      nlinarith
    · intro x hx y hy hxy
      rcases mem_insert.mp hx with hxeq | hxS
      · subst x
        rcases mem_insert.mp hy with hyeq | hyS
        · exact (hxy hyeq.symm).elim
        · intro h
          exact (mem_sdiff.mp (hSF hyS)).2
            (mem_insert_of_mem (mem_filter.mpr ⟨hFF (hSF hyS), Or.inl h⟩))
      · rcases mem_insert.mp hy with hyeq | hyS
        · subst y
          intro h
          exact (mem_sdiff.mp (hSF hxS)).2
            (mem_insert_of_mem (mem_filter.mpr ⟨hFF (hSF hxS), Or.inr h⟩))
        · exact hS x hxS y hyS hxy

/-- If every forbidden configuration through v meets a bounded list of other
vertices, the configurations can be removed by constant-fraction thinning. -/
theorem thin_local_covers {V : Type*} [DecidableEq V] (F : Finset V)
    (Bad : Finset V → Prop) (D : ℕ) (cover : V → Finset V)
    (hsize : ∀ v ∈ F, (cover v).card ≤ D)
    (hcover : ∀ B ⊆ F, Bad B → ∃ v ∈ B, ∃ w ∈ B, w ≠ v ∧ w ∈ cover v) :
    ∃ S ⊆ F, F.card ≤ (2*D+1) * S.card ∧ ∀ B ⊆ S, ¬Bad B := by
  classical
  obtain ⟨S, hSF, hSc, hS⟩ := exists_independent_fraction (fun v w => w ∈ cover v) D F (by
    intro v hv
    exact (card_le_card (show F.filter (fun w => w ∈ cover v) ⊆ cover v from fun w hw => (mem_filter.mp hw).2)).trans (hsize v hv))
  refine ⟨S, hSF, hSc, ?_⟩
  intro B hBS hB
  obtain ⟨v, hv, w, hw, hwv, hwc⟩ := hcover B (hBS.trans hSF) hB
  exact hS v (hBS hv) w (hBS hw) hwv.symm hwc

end LocalConflict

/-! Three-edge theta graphs: local conflict thinning and bounded path fibers. -/
namespace Erdos571.ThetaThree

open Finset SimpleGraph BipartiteCycleExtraction BipartiteCycleBounds

variable {L R : Type*} [DecidableEq L] [DecidableEq R]

/-- Interior edges of simple three-edge paths from a to z. -/
def link (E : Finset (L × R)) (a : L) (z : R) : Finset (L × R) :=
  E.filter (fun e => e.1 ≠ a ∧ e.2 ≠ z ∧ (a,e.2) ∈ E ∧ (e.1,z) ∈ E)

lemma mem_link {E : Finset (L × R)} {a b : L} {x z : R} :
    (b,x) ∈ link E a z ↔ (b,x) ∈ E ∧ b ≠ a ∧ x ≠ z ∧ (a,x) ∈ E ∧ (b,z) ∈ E := by
  simp only [link, mem_filter]

/-- No p internally disjoint three-edge paths have common endpoints. -/
def NoTheta (E : Finset (L × R)) (p : ℕ) : Prop :=
  ∀ a z, ¬∃ S ⊆ link E a z, S.card = p ∧ Set.InjOn Prod.fst (S : Set (L × R)) ∧
    Set.InjOn Prod.snd (S : Set (L × R))

lemma link_mono {E F : Finset (L × R)} (hFE : F ⊆ E) (a : L) (z : R) :
    link F a z ⊆ link E a z := by
  rintro ⟨b,x⟩ h
  rcases mem_link.mp h with ⟨hbx,hba,hxz,hax,hbz⟩
  exact mem_link.mpr ⟨hFE hbx,hba,hxz,hFE hax,hFE hbz⟩

lemma NoTheta.mono {E F : Finset (L × R)} {p : ℕ} (h : NoTheta E p) (hFE : F ⊆ E) :
    NoTheta F p := by
  intro a z hs
  obtain ⟨S,hS,hc,hL,hR⟩ := hs
  exact h a z ⟨S,hS.trans (link_mono hFE a z),hc,hL,hR⟩

def foot (e : L × R) : Finset (L ⊕ R) := {.inl e.1, .inr e.2}

lemma foot_disjoint {e f : L × R} :
    Disjoint (foot e) (foot f) ↔ e.1 ≠ f.1 ∧ e.2 ≠ f.2 := by
  simp [foot, Finset.disjoint_left]

lemma link_small_cover {E : Finset (L × R)} {p : ℕ} (h : NoTheta E p) (a : L) (z : R) :
    ∃ U : Finset (L ⊕ R), U.card ≤ 2*(p-1) ∧
      ∀ e ∈ link E a z, ∃ w ∈ foot e, w ∈ U := by
  apply RootedPacking.small_cover_of_no_packing (link E a z) foot 2 p
  · intro e _; exact ⟨.inl e.1, mem_insert_self _ _⟩
  · intro e _; simp [foot]
  · rintro ⟨S,hS,hc,hdis⟩
    apply h a z
    refine ⟨S,hS,hc,?_,?_⟩
    · intro e he f hf heq
      by_contra hef
      exact (foot_disjoint.mp (hdis e he f hf hef)).1 heq
    · intro e he f hf heq
      by_contra hef
      exact (foot_disjoint.mp (hdis e he f hf hef)).2 heq

/-- Constant-fraction four-cycle removal in a three-edge-theta-free relation. -/
theorem exists_noFour_fraction (E : Finset (L × R)) (p : ℕ) (h : NoTheta E p) :
    ∃ F ⊆ E, NoFour F ∧ E.card ≤ (4*(p-1)+1) * F.card := by
  classical
  choose U hUc hU using fun e : L × R => link_small_cover h e.1 e.2
  let spoke (e : L × R) : L ⊕ R → L × R := Sum.elim (fun b => (b,e.2)) (fun x => (e.1,x))
  let cover (e : L × R) := (U e).image (spoke e)
  obtain ⟨F,hFE,hFc,hF⟩ := LocalConflict.exists_independent_fraction
    (fun e f => f ∈ cover e) (2*(p-1)) E (by
      intro e he
      calc
        _ ≤ (cover e).card := card_le_card (fun f hf => (mem_filter.mp hf).2)
        _ ≤ (U e).card := card_image_le
        _ ≤ _ := hUc e)
  refine ⟨F,hFE,?_,by nlinarith [hFc]⟩
  intro a b x y hab hxy hax hbx hby hay
  have hl : (b,y) ∈ link E a x := mem_link.mpr
    ⟨hFE hby,hab.symm,hxy.symm,hFE hay,hFE hbx⟩
  obtain ⟨w,hw,hwu⟩ := hU (a,x) (b,y) hl
  have hcov : spoke (a,x) w ∈ cover (a,x) := mem_image.mpr ⟨w,hwu,rfl⟩
  simp only [foot, mem_insert, mem_singleton] at hw
  rcases hw with rfl | rfl
  · exact hF (a,x) hax (b,x) hbx (fun he => hab (congrArg Prod.fst he)) hcov
  · exact hF (a,x) hax (a,y) hay (fun he => hxy (congrArg Prod.snd he)) hcov

/-- Four-cycle freeness makes the entire three-path fiber a matching. -/
lemma link_matching {E : Finset (L × R)} (h4 : NoFour E) (a : L) (z : R) :
    Set.InjOn Prod.fst (link E a z : Set (L × R)) ∧
      Set.InjOn Prod.snd (link E a z : Set (L × R)) := by
  constructor
  · rintro ⟨b,x⟩ he ⟨c,y⟩ hf hbc
    dsimp only at hbc
    subst c
    suffices x = y by cases this; rfl
    by_contra hxy
    rcases mem_link.mp he with ⟨hbx,hba,hxz,hax,hbz⟩
    rcases mem_link.mp hf with ⟨hby,_,hyz,hay,_⟩
    exact h4 a b x y hba.symm hxy hax hbx hby hay
  · rintro ⟨b,x⟩ he ⟨c,y⟩ hf hxy
    dsimp only at hxy
    subst y
    suffices b = c by cases this; rfl
    by_contra hbc
    rcases mem_link.mp he with ⟨hbx,hba,hxz,hax,hbz⟩
    rcases mem_link.mp hf with ⟨hcx,hca,_,_,hcz⟩
    exact h4 b c x z hbc hxz hbx hcx hcz hbz

lemma link_card_lt {E : Finset (L × R)} {p : ℕ} (h4 : NoFour E) (h : NoTheta E p)
    (a : L) (z : R) : (link E a z).card < p := by
  by_contra hn
  obtain ⟨S,hS,hc⟩ := exists_subset_card_eq (Nat.le_of_not_gt hn)
  exact h a z ⟨S,hS,hc,(link_matching h4 a z).1.mono hS,(link_matching h4 a z).2.mono hS⟩

lemma paths_card_le_theta {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L}
    {p : ℕ} (h4 : NoFour E) (h : NoTheta E p) :
    (paths E A B a).card ≤ B.card * (p-1) := by
  have hinj : (paths E A B a).card ≤ (B.sigma (fun z => link E a z)).card := by
    apply card_le_card_of_injOn (fun t : Σ _ : R, Σ _ : L, R => ⟨t.2.2,(t.2.1,t.1)⟩)
    · intro t ht
      rcases mem_paths t |>.mp ht with ⟨hx,hb,hz,hba,hzx,hax,hbx,hbz⟩
      exact mem_sigma.mpr ⟨hz,mem_link.mpr ⟨hbx,hba,hzx.symm,hax,hbz⟩⟩
    · rintro ⟨x,b,z⟩ ht ⟨y,c,w⟩ hu he
      cases he
      rfl
  apply hinj.trans
  rw [card_sigma]
  calc
    _ ≤ ∑ _z ∈ B, (p-1) := sum_le_sum (fun z _ => by have := link_card_lt h4 h a z; omega)
    _ = _ := by simp

end Erdos571.ThetaThree

/-! Rectangular extremal estimates for three-edge theta graphs. -/
namespace Erdos571.ThetaThree

open Finset SimpleGraph BipartiteCycleExtraction BipartiteCycleBounds

variable {L R : Type*} [DecidableEq L] [DecidableEq R]

lemma paths_card_ge_asymmetric {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L}
    (ha : a ∈ A) (dL dR : ℕ)
    (hdL : ∀ a ∈ A, dL ≤ (nr E B a).card) (hdR : ∀ b ∈ B, dR ≤ (nl E A b).card) :
    dL * (dR-1) * (dL-1) ≤ (paths E A B a).card := by
  rw [paths, card_sigma]
  have hinner : ∀ x ∈ nr E B a,
      (dR-1)*(dL-1) ≤ (((nl E A x).erase a).sigma fun b => (nr E B b).erase x).card := by
    intro x hx
    have hxB := (mem_filter.mp hx).1
    have hn : dR-1 ≤ ((nl E A x).erase a).card :=
      (Nat.sub_le_sub_right (hdR x hxB) 1).trans pred_card_le_card_erase
    rw [card_sigma]
    calc
      _ ≤ ((nl E A x).erase a).card * (dL-1) := Nat.mul_le_mul_right _ hn
      _ = ∑ _b ∈ (nl E A x).erase a, (dL-1) := by simp
      _ ≤ _ := sum_le_sum (fun b hb =>
        (Nat.sub_le_sub_right (hdL b (mem_filter.mp (mem_erase.mp hb).2).1) 1).trans
          pred_card_le_card_erase)
  calc
    _ = dL * ((dR-1)*(dL-1)) := by ring
    _ ≤ (nr E B a).card * ((dR-1)*(dL-1)) := Nat.mul_le_mul_right _ (hdL a ha)
    _ = ∑ _x ∈ nr E B a, ((dR-1)*(dL-1)) := by simp
    _ ≤ _ := sum_le_sum hinner

/-- Asymmetric peeling with separate degree thresholds on the two sides. -/
theorem edge_bound_threshold (N p dL dR : ℕ)
    (hd : N*(p-1) < dL*(dR-1)*(dL-1))
    {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hsize : B.card ≤ N) (hE : E ⊆ A ×ˢ B) (h4 : NoFour E) (h : NoTheta E p) :
    E.card ≤ (dL-1)*A.card + (dR-1)*B.card := by
  have aux : ∀ n : ℕ, ∀ A : Finset L, ∀ B : Finset R, ∀ E : Finset (L × R),
      A.card+B.card = n → B.card ≤ N → E ⊆ A ×ˢ B → NoFour E → NoTheta E p →
      E.card ≤ (dL-1)*A.card + (dR-1)*B.card := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro A B E hn hN hE h4 h
      by_cases ha : A.Nonempty
      swap
      · have hA := not_nonempty_iff_eq_empty.mp ha
        have hE0 : E = ∅ := subset_empty.mp (by simpa [hA] using hE)
        simp [hE0]
      obtain ⟨a, ha⟩ := ha
      have hlow : (∃ a ∈ A, (nr E B a).card < dL) ∨ (∃ b ∈ B, (nl E A b).card < dR) := by
        by_contra! hh
        have hc := (paths_card_ge_asymmetric ha dL dR hh.1 hh.2).trans (paths_card_le_theta h4 h)
        have hBN := Nat.mul_le_mul_right (p-1) hN
        omega
      rcases hlow with ⟨u,hu,hdu⟩ | ⟨v,hv,hdv⟩
      · let E' := E.filter (fun e => e.1 ≠ u)
        have hsub : E' ⊆ E := filter_subset _ _
        have hE' : E' ⊆ A.erase u ×ˢ B := by
          rintro ⟨w,z⟩ hwz
          rcases mem_filter.mp hwz with ⟨he,hwu⟩
          rcases mem_product.mp (hE he) with ⟨hw,hz⟩
          exact mem_product.mpr ⟨mem_erase.mpr ⟨hwu,hw⟩,hz⟩
        have hcA := card_erase_add_one hu
        have hi := ih ((A.erase u).card+B.card) (by omega) (A.erase u) B E' rfl hN hE'
          (noFour_mono h4 hsub) (h.mono hsub)
        have hcE := delete_left_card hE u
        change E'.card+(nr E B u).card=E.card at hcE
        have hdu' : (nr E B u).card ≤ dL-1 := by omega
        nlinarith
      · let E' := E.filter (fun e => e.2 ≠ v)
        have hsub : E' ⊆ E := filter_subset _ _
        have hE' : E' ⊆ A ×ˢ B.erase v := by
          rintro ⟨w,z⟩ hwz
          rcases mem_filter.mp hwz with ⟨he,hzv⟩
          rcases mem_product.mp (hE he) with ⟨hw,hz⟩
          exact mem_product.mpr ⟨hw,mem_erase.mpr ⟨hzv,hz⟩⟩
        have hcB := card_erase_add_one hv
        have hi := ih (A.card+(B.erase v).card) (by omega) A (B.erase v) E' rfl (by omega) hE'
          (noFour_mono h4 hsub) (h.mono hsub)
        have hcE := delete_right_card hE v
        change E'.card+(nl E A v).card=E.card at hcE
        have hdv' : (nl E A v).card ≤ dR-1 := by omega
        nlinarith
  exact aux _ A B E rfl hsize hE h4 h

lemma rectangular_thresholds (m n p : ℕ) (hm : 0 < m) (hn : 0 < n) :
    ∃ dL dR : ℕ, n*(p-1) < dL*(dR-1)*(dL-1) ∧
      ((dL-1)*m+(dR-1)*n : ℕ) ≤
        2*((p : ℝ)+1)*((m : ℝ)*n)^((2 : ℝ)/3)+2*m+2*n := by
  let r : ℝ := ((p : ℝ)+1)*((m : ℝ)*n)^((2 : ℝ)/3)
  let x : ℕ := ⌈r / m⌉₊
  let y : ℕ := ⌈r / n⌉₊
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hr : 0 ≤ r := by dsimp [r]; positivity
  have hx : r / m ≤ (x : ℝ) := Nat.le_ceil _
  have hy : r / n ≤ (y : ℝ) := Nat.le_ceil _
  have hx' : (x : ℝ) < r / m + 1 := Nat.ceil_lt_add_one (div_nonneg hr hm'.le)
  have hy' : (y : ℝ) < r / n + 1 := Nat.ceil_lt_add_one (div_nonneg hr hn'.le)
  have hr3 : r^3 = ((p : ℝ)+1)^3 * ((m : ℝ)*n)^2 := by
    dsimp [r]
    rw [mul_pow, ← Real.rpow_mul_natCast (by positivity : (0 : ℝ) ≤ m*n)]
    norm_num
  have hdiv : (r / m)^2 * (r / n) = ((p : ℝ)+1)^3 * n := by
    field_simp
    nlinarith [hr3]
  have hpow : (n : ℝ)*p ≤ (x : ℝ)^2*y := by
    calc
      _ ≤ ((p : ℝ)+1)^3*n := by
        have hp : (0 : ℝ) ≤ p := Nat.cast_nonneg _
        nlinarith [mul_nonneg hn'.le (show 0 ≤ ((p : ℝ)+1)^3-p by nlinarith [sq_nonneg (p : ℝ)])]
      _ = (r / m)^2 * (r / n) := hdiv.symm
      _ ≤ _ := by gcongr
  have hnat : n*p ≤ x^2*y := by exact_mod_cast hpow
  refine ⟨x+2,y+2,?_,?_⟩
  · have hsubL : x+2-1=x+1 := by omega
    have hsubR : y+2-1=y+1 := by omega
    rw [hsubL,hsubR]
    have hlt : x^2*y < (x+2)*(y+1)*(x+1) := by nlinarith
    have hpred := Nat.mul_le_mul_left n (Nat.sub_le p 1)
    omega
  · rw [show x+2-1=x+1 by omega, show y+2-1=y+1 by omega]
    push_cast
    have hxm := (le_div_iff₀ hm').mp (show (x : ℝ)-1 ≤ r/m by linarith)
    have hyn := (le_div_iff₀ hn').mp (show (y : ℝ)-1 ≤ r/n by linarith)
    dsimp only [r] at hxm hyn
    nlinarith

/-- The rectangular four-thirds bound before constant-fraction thinning. -/
theorem edge_bound_rectangular_noFour {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    {p : ℕ} (hE : E ⊆ A ×ˢ B) (h4 : NoFour E) (h : NoTheta E p) :
    (E.card : ℝ) ≤ 2*((p : ℝ)+1)*((A.card : ℝ)*B.card)^((2 : ℝ)/3)+2*A.card+2*B.card := by
  by_cases hm : 0 < A.card
  swap
  · have hA : A = ∅ := card_eq_zero.mp (by omega)
    have hE0 : E = ∅ := subset_empty.mp (by simpa [hA] using hE)
    rw [hE0,card_empty,Nat.cast_zero]
    positivity
  by_cases hn : 0 < B.card
  swap
  · have hB : B = ∅ := card_eq_zero.mp (by omega)
    have hE0 : E = ∅ := subset_empty.mp (by simpa [hB] using hE)
    rw [hE0,card_empty,Nat.cast_zero]
    positivity
  obtain ⟨dL,dR,hd,hbound⟩ := rectangular_thresholds A.card B.card p hm hn
  exact (show (E.card : ℝ) ≤ ((dL-1)*A.card+(dR-1)*B.card : ℕ) by
    exact_mod_cast edge_bound_threshold B.card p dL dR hd le_rfl hE h4 h).trans hbound

/-- A three-edge theta of any fixed multiplicity has the standard rectangular
four-thirds upper bound. -/
theorem edge_bound_rectangular {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    {p : ℕ} (hE : E ⊆ A ×ˢ B) (h : NoTheta E p) :
    (E.card : ℝ) ≤ (4*((p-1 : ℕ) : ℝ)+1) *
      (2*((p : ℝ)+1)*((A.card : ℝ)*B.card)^((2 : ℝ)/3)+2*A.card+2*B.card) := by
  obtain ⟨F,hFE,h4,hcard⟩ := exists_noFour_fraction E p h
  have hbound := edge_bound_rectangular_noFour (hFE.trans hE) h4 (h.mono hFE)
  have hc : (E.card : ℝ) ≤ (4*((p-1 : ℕ) : ℝ)+1)*F.card := by exact_mod_cast hcard
  exact hc.trans (mul_le_mul_of_nonneg_left hbound (by positivity))

end Erdos571.ThetaThree

/-! Bipartite pattern containment and a universal-vertex upper-bound operation. -/
namespace Erdos571.PatternCone

open Finset SimpleGraph BipartiteCycleBounds

/-- A part-preserving copy in a finite rectangular relation. -/
def Contains {U V L R : Type*} (P : U → V → Prop) (E : Finset (L × R))
    (A : Finset L) (B : Finset R) : Prop :=
  ∃ f : U → L, ∃ g : V → R, Function.Injective f ∧ Function.Injective g ∧
    (∀ u, f u ∈ A) ∧ (∀ v, g v ∈ B) ∧ ∀ u v, P u v → (f u,g v) ∈ E

def coneLeft {U V : Type*} (P : U → V → Prop) : Option U → V → Prop
  | none, _ => True
  | some u, v => P u v

def coneRight {U V : Type*} (P : U → V → Prop) : U → Option V → Prop
  | _, none => True
  | u, some v => P u v

variable {L R : Type*} [DecidableEq L] [DecidableEq R]

/-- Delete a and retain the edges into its neighborhood. -/
def localEdges (E : Finset (L × R)) (a : L) : Finset (L × R) :=
  E.filter (fun e => e.1 ≠ a ∧ (a,e.2) ∈ E)

lemma localEdges_subset {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) (a : L) : localEdges E a ⊆ A.erase a ×ˢ nr E B a := by
  intro e he
  rcases mem_filter.mp he with ⟨he,hne,hae⟩
  rcases mem_product.mp (hE he) with ⟨hL,hR⟩
  exact mem_product.mpr ⟨mem_erase.mpr ⟨hne,hL⟩,mem_filter.mpr ⟨hR,hae⟩⟩

lemma contains_coneLeft_of_local {U V : Type*} {P : U → V → Prop}
    {E : Finset (L × R)} {A : Finset L} {B : Finset R} {a : L} (ha : a ∈ A)
    (h : Contains P (localEdges E a) (A.erase a) (nr E B a)) :
    Contains (coneLeft P) E A B := by
  obtain ⟨f,g,hf,hg,hfA,hgB,he⟩ := h
  let f' : Option U → L := Option.elim' a f
  refine ⟨f',g,?_,hg,?_,?_,?_⟩
  · intro u v huv
    cases u with
    | none =>
      cases v with
      | none => rfl
      | some v => exact False.elim ((mem_erase.mp (hfA v)).1 huv.symm)
    | some u =>
      cases v with
      | none => exact False.elim ((mem_erase.mp (hfA u)).1 huv)
      | some v => exact congrArg some (hf huv)
  · intro u
    cases u with
    | none => exact ha
    | some u => exact (mem_erase.mp (hfA u)).2
  · intro v; exact (mem_filter.mp (hgB v)).1
  · intro u v huv
    cases u with
    | none => exact (mem_filter.mp (hgB v)).2
    | some u => exact (mem_filter.mp (he u v huv)).1

lemma card_right_fiber {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) (b : R) : (E.filter (fun e => e.2 = b)).card = (nl E A b).card := by
  apply card_bij (fun e _ => e.1)
  · intro e he
    rcases mem_filter.mp he with ⟨he,heb⟩
    exact mem_filter.mpr ⟨(mem_product.mp (hE he)).1,by simpa only [← heb] using he⟩
  · intro e he f hf heq
    exact Prod.ext heq ((mem_filter.mp he).2.trans (mem_filter.mp hf).2.symm)
  · intro x hx
    exact ⟨(x,b),mem_filter.mpr ⟨(mem_filter.mp hx).2,rfl⟩,rfl⟩

lemma sum_right_degrees {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) : ∑ b ∈ B, (nl E A b).card = E.card := by
  have h := sum_fiberwise_of_maps_to (fun e he => (mem_product.mp (hE he)).2) (fun _ => (1 : ℕ))
  simpa only [sum_const, nsmul_eq_mul, mul_one, card_right_fiber hE] using h

/-- The local rectangles count every ordered two-star except the diagonal. -/
lemma sum_localEdges {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) :
    E.card + ∑ a ∈ A, (localEdges E a).card = ∑ b ∈ B, (nl E A b).card^2 := by
  have hswap : (∑ a ∈ A, (localEdges E a).card) =
      ∑ e ∈ E, (A.filter (fun a => e.1 ≠ a ∧ (a,e.2) ∈ E)).card :=
    sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (fun a (e : L × R) => e.1 ≠ a ∧ (a,e.2) ∈ E)
  have hc (e : L × R) (he : e ∈ E) :
      (A.filter (fun a => e.1 ≠ a ∧ (a,e.2) ∈ E)).card + 1 = (nl E A e.2).card := by
    have hmem : e.1 ∈ nl E A e.2 := mem_filter.mpr ⟨(mem_product.mp (hE he)).1,he⟩
    have heq : A.filter (fun a => e.1 ≠ a ∧ (a,e.2) ∈ E) = (nl E A e.2).erase e.1 := by
      ext a
      simp only [mem_filter, mem_erase, nl]
      tauto
    rw [heq]
    exact card_erase_add_one hmem
  have hdeg := sum_fiberwise_of_maps_to (fun e he => (mem_product.mp (hE he)).2)
    (fun e : L × R => (nl E A e.2).card)
  have hfiber (b : R) : (∑ e ∈ E.filter (fun e => e.2=b), (nl E A e.2).card) = (nl E A b).card^2 := by
    calc
      _ = ∑ _e ∈ E.filter (fun e => e.2=b), (nl E A b).card :=
        sum_congr rfl (fun e he => by rw [(mem_filter.mp he).2])
      _ = _ := by simp only [sum_const, nsmul_eq_mul, card_right_fiber hE, pow_two, Nat.cast_id]
  rw [hswap, add_comm, show E.card = ∑ _e ∈ E, (1 : ℕ) by simp, ← sum_add_distrib]
  rw [sum_congr rfl hc]
  rw [← hdeg]
  exact sum_congr rfl (fun b _ => hfiber b)

/-- A universal-vertex-free graph has bounded second degree moment whenever
its neighborhood rectangles satisfy a bound. -/
theorem coneLeft_moment {U V : Type*} {P : U → V → Prop}
    {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) (hfree : ¬Contains (coneLeft P) E A B)
    (F : ℕ → ℝ)
    (hbound : ∀ a ∈ A, ¬Contains P (localEdges E a) (A.erase a) (nr E B a) →
      ((localEdges E a).card : ℝ) ≤ F (nr E B a).card) :
    (∑ b ∈ B, ((nl E A b).card : ℝ)^2) ≤ E.card + ∑ a ∈ A, F (nr E B a).card := by
  have heq : (E.card : ℝ) + ∑ a ∈ A, ((localEdges E a).card : ℝ) =
      ∑ b ∈ B, ((nl E A b).card : ℝ)^2 := by exact_mod_cast sum_localEdges hE
  rw [← heq]
  apply add_le_add le_rfl
  apply sum_le_sum
  intro a ha
  exact hbound a ha (fun h => hfree (contains_coneLeft_of_local ha h))

end Erdos571.PatternCone

/-! Concave degree moments and inversion of the cone upper-bound inequality. -/
namespace Erdos571.ConeNumerics

open Finset

lemma sum_rpow_concave {I : Type*} (S : Finset I) (f : I → ℝ)
    (hf : ∀ i ∈ S, 0 ≤ f i) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∑ i ∈ S, (f i)^q ≤ (S.card : ℝ)^(1-q) * (∑ i ∈ S, f i)^q := by
  by_cases hS : S.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hS]
    simp only [sum_empty, card_empty, Nat.cast_zero]
    positivity
  have hm : (0 : ℝ) < S.card := by exact_mod_cast card_pos.mpr hS
  have hj := (Real.concaveOn_rpow hq0 hq1).le_map_sum
    (t := S) (w := fun _ => (S.card : ℝ)⁻¹) (p := f)
    (fun _ _ => inv_nonneg.mpr hm.le) (by simp [ne_of_gt hm]) hf
  simp only [smul_eq_mul, ← mul_sum] at hj
  have h := mul_le_mul_of_nonneg_left hj hm.le
  rw [← mul_assoc, mul_inv_cancel₀ hm.ne', one_mul] at h
  have he : (S.card : ℝ) * ((S.card : ℝ)⁻¹ * (∑ i ∈ S, f i))^q =
      (S.card : ℝ)^(1-q) * (∑ i ∈ S, f i)^q := by
    rw [Real.mul_rpow (inv_nonneg.mpr hm.le) (sum_nonneg hf), Real.inv_rpow hm.le,
      Real.rpow_sub hm, Real.rpow_one]
    ring
  rwa [he] at h

lemma monomial_solve {x C m n l q : ℝ} (hx : 0 < x) (hC : 1 ≤ C)
    (hm : 0 ≤ m) (hn : 0 ≤ n) (hq : q ≤ 1)
    (h : x^2 ≤ C * m^l * n * x^q) :
    x ≤ C * m^(l/(2-q)) * n^(1/(2-q)) := by
  have h2 : 0 < 2-q := by linarith
  have hi : 0 < (2-q)⁻¹ := inv_pos.mpr h2
  have hpow : x^(2-q) ≤ C*m^l*n := by
    rw [Real.rpow_sub hx]
    apply (div_le_iff₀ (Real.rpow_pos_of_pos hx q)).mpr
    simpa only [Real.rpow_two] using h
  have hh := Real.rpow_le_rpow (Real.rpow_nonneg hx.le _) hpow hi.le
  rw [← Real.rpow_mul hx.le, mul_inv_cancel₀ h2.ne', Real.rpow_one] at hh
  have hC0 : 0 ≤ C := by linarith
  rw [Real.mul_rpow (mul_nonneg hC0 (Real.rpow_nonneg hm l)) hn,
    Real.mul_rpow hC0 (Real.rpow_nonneg hm l), ← Real.rpow_mul hm] at hh
  have hile : (2-q)⁻¹ ≤ 1 := (inv_le_one₀ h2).mpr (by linarith)
  have hCpow := Real.rpow_le_self_of_one_le hC hile
  calc
    x ≤ C^((2-q)⁻¹) * m^(l*(2-q)⁻¹) * n^((2-q)⁻¹) := hh
    _ ≤ C * m^(l*(2-q)⁻¹) * n^((2-q)⁻¹) := by gcongr
    _ = _ := by simp only [div_eq_mul_inv, one_mul]

/-- Select one summand carrying the second moment, then solve its monomial
inequality. The constant is uniform over a finite list of exponents. -/
lemma sum_monomial_solve {I : Type*} [Fintype I] [Nonempty I]
    (l q : I → ℝ) (hq : ∀ i, q i ≤ 1)
    (x C m n : ℝ) (hx : 0 < x) (hC : 1 ≤ C) (hm : 0 ≤ m) (hn : 0 ≤ n)
    (h : x^2 ≤ C * ∑ i, m^(l i)*n*x^(q i)) :
    x ≤ (C*Fintype.card I) * ∑ i, m^(l i/(2-q i))*n^(1/(2-q i)) := by
  have hcard : (1 : ℝ) ≤ Fintype.card I := by exact_mod_cast Fintype.card_pos (α := I)
  have hs : (∑ _i : I, x^2) ≤ ∑ i, (C*Fintype.card I)*m^(l i)*n*x^(q i) := by
    simp only [sum_const, card_univ, nsmul_eq_mul]
    have hh := mul_le_mul_of_nonneg_left h (show (0 : ℝ) ≤ Fintype.card I by positivity)
    simp only [mul_sum] at hh
    convert hh using 1
    congr 1
    funext i
    ring
  obtain ⟨i, _, hi⟩ := exists_le_of_sum_le (univ_nonempty : (univ : Finset I).Nonempty) hs
  have hCi : 1 ≤ C*Fintype.card I := by nlinarith [mul_nonneg (sub_nonneg.mpr hC) (sub_nonneg.mpr hcard)]
  have hb := monomial_solve hx hCi hm hn (hq i) hi
  exact hb.trans (by
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left
      (single_le_sum (f := fun j => m^(l j/(2-q j))*n^(1/(2-q j)))
        (fun j _ => mul_nonneg (Real.rpow_nonneg hm _) (Real.rpow_nonneg hn _)) (mem_univ i))
      (by linarith))

end Erdos571.ConeNumerics

/-! Universal-vertex closure for finite lists of rectangular exponent terms. -/
namespace Erdos571.ConeBounds

open Finset SimpleGraph PatternCone BipartiteCycleBounds ConeNumerics

/-- A finite-sum rectangular bound, with separate exponents on the two sides. -/
structure Bound {U V I : Type} [Fintype I] (P : U → V → Prop) (β γ : I → ℝ) (C : ℝ) : Prop where
  estimate : ∀ {L R : Type} [DecidableEq L] [DecidableEq R]
    {E : Finset (L × R)} {A : Finset L} {B : Finset R},
    E ⊆ A ×ˢ B → ¬Contains P E A B →
      (E.card : ℝ) ≤ C * ∑ i, (A.card : ℝ)^(β i)*(B.card : ℝ)^(γ i)

def leftNumerator {I : Type} (β γ : I → ℝ) : Option I → ℝ
  | none => 0
  | some i => β i + 1 - γ i

def leftPower {I : Type} (γ : I → ℝ) : Option I → ℝ
  | none => 1
  | some i => γ i

noncomputable def leftBeta {I : Type} (β γ : I → ℝ) (i : Option I) : ℝ :=
  leftNumerator β γ i / (2-leftPower γ i)

noncomputable def leftGamma {I : Type} (γ : I → ℝ) (i : Option I) : ℝ :=
  1 / (2-leftPower γ i)

lemma sum_left_degrees {L R : Type*} [DecidableEq L] [DecidableEq R]
    {E : Finset (L × R)} {A : Finset L} {B : Finset R} (hE : E ⊆ A ×ˢ B) :
    ∑ a ∈ A, (nr E B a).card = E.card := by
  have h : (∑ a ∈ A, (nr E B a).card) = ∑ b ∈ B, (nl E A b).card :=
    sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (fun a b => (a,b) ∈ E)
  exact h.trans (sum_right_degrees hE)

set_option maxHeartbeats 1200000 in
/-- Adding a universal vertex on the left transforms each rectangular exponent
pair, and adds the linear term corresponding to the second-moment diagonal. -/
theorem coneLeft_bound {U V I : Type} [Fintype I] (P : U → V → Prop)
    (β γ : I → ℝ) (C : ℝ) (hC : 1 ≤ C)
    (hβ : ∀ i, 0 ≤ β i) (hγ0 : ∀ i, 0 ≤ γ i) (hγ1 : ∀ i, γ i ≤ 1)
    (hbound : Bound P β γ C) :
    Bound (coneLeft P) (leftBeta β γ) (leftGamma γ) (C*(Fintype.card I+1)) := by
  classical
  constructor
  intro L R _ _ E A B hE hfree
  have hC0 : 0 ≤ C := by linarith
  by_cases hzero : E.card = 0
  · rw [hzero,Nat.cast_zero]
    positivity
  have hepos : (0 : ℝ) < E.card := by exact_mod_cast (show 0 < E.card by omega)
  have hApos : (0 : ℝ) < A.card := by
    obtain ⟨e,he⟩ := card_pos.mp (show 0 < E.card by omega)
    exact_mod_cast card_pos.mpr ⟨e.1,(mem_product.mp (hE he)).1⟩
  have hleft : (∑ a ∈ A, ((nr E B a).card : ℝ)) = E.card := by
    exact_mod_cast sum_left_degrees hE
  have hright : (∑ b ∈ B, ((nl E A b).card : ℝ)) = E.card := by
    exact_mod_cast sum_right_degrees hE
  have hm := coneLeft_moment hE hfree
    (fun d => C * ∑ i, (A.card : ℝ)^(β i)*(d : ℝ)^(γ i)) (by
      intro a ha hlocal
      have h := hbound.estimate (localEdges_subset hE a) hlocal
      apply h.trans
      apply mul_le_mul_of_nonneg_left _ hC0
      apply sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg (Nat.cast_nonneg _) _)
      exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast card_erase_le) (hβ i))
  have hconc (i : I) : (∑ a ∈ A, ((nr E B a).card : ℝ)^(γ i)) ≤
      (A.card : ℝ)^(1-γ i) * (E.card : ℝ)^(γ i) := by
    simpa only [hleft] using sum_rpow_concave A
      (fun a => ((nr E B a).card : ℝ)) (fun _ _ => Nat.cast_nonneg _) (γ i) (hγ0 i) (hγ1 i)
  have hsum : (∑ a ∈ A, C * ∑ i, (A.card : ℝ)^(β i)*((nr E B a).card : ℝ)^(γ i)) ≤
      C * ∑ i, (A.card : ℝ)^(β i+1-γ i) * (E.card : ℝ)^(γ i) := by
    rw [← mul_sum, sum_comm]
    apply mul_le_mul_of_nonneg_left _ hC0
    apply sum_le_sum
    intro i _
    rw [← mul_sum]
    have h := mul_le_mul_of_nonneg_left (hconc i) (Real.rpow_nonneg hApos.le (β i))
    rw [← mul_assoc, ← Real.rpow_add hApos] at h
    convert h using 2 <;> ring
  have hcs := sum_mul_sq_le_sq_mul_sq B (fun _ => (1 : ℝ)) (fun b => ((nl E A b).card : ℝ))
  simp only [one_mul,one_pow,sum_const,nsmul_eq_mul,mul_one,hright] at hcs
  have hmoment : (E.card : ℝ)^2 ≤ C * ∑ i : Option I,
      (A.card : ℝ)^(leftNumerator β γ i) * B.card * (E.card : ℝ)^(leftPower γ i) := by
    have h₁ := mul_le_mul_of_nonneg_left (hm.trans (add_le_add le_rfl hsum))
      (Nat.cast_nonneg B.card : (0 : ℝ) ≤ B.card)
    have h₂ : (B.card : ℝ)*E.card ≤ C*((B.card : ℝ)*E.card) := by
      have := mul_le_mul_of_nonneg_right hC (show 0 ≤ (B.card : ℝ)*E.card by positivity)
      simpa only [one_mul] using this
    rw [Fintype.sum_option]
    simp only [leftNumerator,leftPower,Real.rpow_zero,Real.rpow_one,one_mul]
    have heq : (∑ i, (A.card : ℝ)^(β i+1-γ i)*B.card*(E.card : ℝ)^(γ i)) =
        (B.card : ℝ)*∑ i, (A.card : ℝ)^(β i+1-γ i)*(E.card : ℝ)^(γ i) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro i _
      ring
    rw [heq]
    nlinarith [hcs]
  have hp : ∀ i : Option I, leftPower γ i ≤ 1 := by intro i; cases i <;> simp [leftPower,hγ1]
  have h := sum_monomial_solve (leftNumerator β γ) (leftPower γ) hp
    E.card C A.card B.card hepos hC (Nat.cast_nonneg _) (Nat.cast_nonneg _) hmoment
  simpa only [Fintype.card_option,Nat.cast_add,Nat.cast_one,leftBeta,leftGamma] using h

lemma mem_swap {L R : Type*} [DecidableEq L] [DecidableEq R]
    (E : Finset (L × R)) (a : L) (b : R) :
    (b,a) ∈ E.image Prod.swap ↔ (a,b) ∈ E := by
  simp only [mem_image]
  constructor
  · rintro ⟨⟨x,y⟩,hxy,he⟩
    cases he
    exact hxy
  · intro h
    exact ⟨(a,b),h,rfl⟩

lemma contains_swap {U V L R : Type*} [DecidableEq L] [DecidableEq R]
    (P : U → V → Prop) (E : Finset (L × R)) (A : Finset L) (B : Finset R) :
    Contains (fun v u => P u v) (E.image Prod.swap) B A ↔ Contains P E A B := by
  constructor
  · rintro ⟨g,f,hg,hf,hgB,hfA,h⟩
    exact ⟨f,g,hf,hg,hfA,hgB,fun u v huv => (mem_swap E _ _).mp (h v u huv)⟩
  · rintro ⟨f,g,hf,hg,hfA,hgB,h⟩
    exact ⟨g,f,hg,hf,hgB,hfA,fun v u huv => (mem_swap E _ _).mpr (h u v huv)⟩

lemma Bound.transpose {U V I : Type} [Fintype I] {P : U → V → Prop}
    {β γ : I → ℝ} {C : ℝ} (h : Bound P β γ C) : Bound (fun v u => P u v) γ β C := by
  classical
  constructor
  intro L R _ _ E A B hE hf
  have hsub : E.image Prod.swap ⊆ B ×ˢ A := by
    rintro _ he
    obtain ⟨⟨x,y⟩,hxy,rfl⟩ := mem_image.mp he
    exact mem_product.mpr ⟨(mem_product.mp (hE hxy)).2,(mem_product.mp (hE hxy)).1⟩
  have hfree : ¬Contains P (E.image Prod.swap) B A := by
    intro hc
    exact hf ((contains_swap (fun v u => P u v) E A B).mp hc)
  have hb := h.estimate hsub hfree
  rw [card_image_of_injective _ Prod.swap_injective] at hb
  convert hb using 2
  apply sum_congr rfl
  intro i _
  exact mul_comm _ _

noncomputable def rightBeta {I : Type} (β : I → ℝ) := leftGamma β

noncomputable def rightGamma {I : Type} (β γ : I → ℝ) := leftBeta γ β

/-- The analogous operation on the right side. -/
theorem coneRight_bound {U V I : Type} [Fintype I] (P : U → V → Prop)
    (β γ : I → ℝ) (C : ℝ) (hC : 1 ≤ C)
    (hβ0 : ∀ i, 0 ≤ β i) (hβ1 : ∀ i, β i ≤ 1) (hγ : ∀ i, 0 ≤ γ i)
    (hbound : Bound P β γ C) :
    Bound (coneRight P) (rightBeta β) (rightGamma β γ) (C*(Fintype.card I+1)) := by
  have h := (coneLeft_bound (fun v u => P u v) γ β C hC hγ hβ0 hβ1 hbound.transpose).transpose
  have heq : (fun u v => coneLeft (fun v u => P u v) v u) = coneRight P := by
    funext u v; cases v <;> rfl
  rwa [heq] at h

lemma left_exponents_interval {I : Type} (β γ : I → ℝ)
    (hβ : ∀ i, 0 ≤ β i ∧ β i ≤ 1) (hγ : ∀ i, 0 ≤ γ i ∧ γ i ≤ 1) :
    (∀ i, 0 ≤ leftBeta β γ i ∧ leftBeta β γ i ≤ 1) ∧
      (∀ i, 0 ≤ leftGamma γ i ∧ leftGamma γ i ≤ 1) := by
  constructor
  · intro i
    cases i with
    | none => norm_num [leftBeta,leftNumerator,leftPower]
    | some i =>
      have hb := hβ i
      have hg := hγ i
      have hd : 0 < 2-γ i := by linarith
      simp only [leftBeta,leftNumerator,leftPower]
      exact ⟨div_nonneg (by linarith) hd.le,(div_le_one hd).mpr (by linarith)⟩
  · intro i
    cases i with
    | none => norm_num [leftGamma,leftPower]
    | some i =>
      have hg := hγ i
      have hd : 0 < 2-γ i := by linarith
      simp only [leftGamma,leftPower]
      exact ⟨div_nonneg (by norm_num) hd.le,(div_le_one hd).mpr (by linarith)⟩

noncomputable def pairBeta {I : Type} (β γ : I → ℝ) := rightBeta (leftBeta β γ)
noncomputable def pairGamma {I : Type} (β γ : I → ℝ) := rightGamma (leftBeta β γ) (leftGamma γ)

/-- Adding one universal vertex on each side is a genuine rectangular
upper-bound closure. -/
theorem paired_bound {U V I : Type} [Fintype I] (P : U → V → Prop)
    (β γ : I → ℝ) (C : ℝ) (hC : 1 ≤ C)
    (hβ : ∀ i, 0 ≤ β i ∧ β i ≤ 1) (hγ : ∀ i, 0 ≤ γ i ∧ γ i ≤ 1)
    (hbound : Bound P β γ C) :
    Bound (coneRight (coneLeft P)) (pairBeta β γ) (pairGamma β γ)
      (C*(Fintype.card I+1)*(Fintype.card I+2)) := by
  have hleft := coneLeft_bound P β γ C hC (fun i => (hβ i).1)
    (fun i => (hγ i).1) (fun i => (hγ i).2) hbound
  have hinterval := left_exponents_interval β γ hβ hγ
  have hC' : 1 ≤ C*(Fintype.card I+1) := by
    have : (0 : ℝ) ≤ Fintype.card I := Nat.cast_nonneg _
    nlinarith
  have h := coneRight_bound (coneLeft P) (leftBeta β γ) (leftGamma γ)
    (C*(Fintype.card I+1)) hC' (fun i => (hinterval.1 i).1)
    (fun i => (hinterval.1 i).2) (fun i => (hinterval.2 i).1) hleft
  simpa only [Fintype.card_option,Nat.cast_add,Nat.cast_one,add_assoc,one_add_one_eq_two,
    pairBeta,pairGamma] using h

lemma paired_exponents_interval {I : Type} (β γ : I → ℝ)
    (hβ : ∀ i, 0 ≤ β i ∧ β i ≤ 1) (hγ : ∀ i, 0 ≤ γ i ∧ γ i ≤ 1) :
    (∀ i, 0 ≤ pairBeta β γ i ∧ pairBeta β γ i ≤ 1) ∧
      (∀ i, 0 ≤ pairGamma β γ i ∧ pairGamma β γ i ≤ 1) := by
  have hL := left_exponents_interval β γ hβ hγ
  have hR := left_exponents_interval (leftGamma γ) (leftBeta β γ) hL.2 hL.1
  exact ⟨hR.2,hR.1⟩

lemma paired_exponent_sum {I : Type} (β γ : I → ℝ)
    (hβ : ∀ i, 0 ≤ β i ∧ β i ≤ 1) (hγ : ∀ i, 0 ≤ γ i ∧ γ i ≤ 1)
    (α : ℝ) (hα1 : 1 ≤ α) (hα2 : α < 2) (hsum : ∀ i, β i+γ i ≤ α) :
    ∀ i, pairBeta β γ i + pairGamma β γ i ≤ (4-α)/(3-α) := by
  have hden : 0 < 3-α := by linarith
  intro i
  cases i with
  | none =>
    norm_num [pairBeta,pairGamma,rightBeta,rightGamma,leftBeta,leftGamma,leftPower,leftNumerator]
    apply (le_div_iff₀ hden).mpr
    linarith
  | some i =>
    cases i with
    | none =>
      norm_num [pairBeta,pairGamma,rightBeta,rightGamma,leftBeta,leftGamma,leftPower,leftNumerator]
      apply (le_div_iff₀ hden).mpr
      linarith
    | some i =>
      have hb := hβ i
      have hg := hγ i
      have hs := hsum i
      have hD : 0 < 3-β i-γ i := by linarith
      have hG : 0 < 2-γ i := by linarith
      have heq : pairBeta β γ (some (some i)) + pairGamma β γ (some (some i)) =
          (4-β i-γ i)/(3-β i-γ i) := by
        dsimp [pairBeta,pairGamma,rightBeta,rightGamma,leftBeta,leftGamma,leftPower,leftNumerator]
        have hd : 2-(β i+1-γ i)/(2-γ i) = (3-β i-γ i)/(2-γ i) := by
          field_simp
          ring
        rw [hd]
        field_simp
        ring
      rw [heq]
      apply (div_le_div_iff₀ hD hden).mpr
      nlinarith

/-- A finite list of rectangular estimates with exponent sum at most alpha
has the expected diagonal upper bound. -/
lemma Bound.diagonal {U V I : Type} [Fintype I] {P : U → V → Prop}
    {β γ : I → ℝ} {C α : ℝ} (h : Bound P β γ C) (hC : 0 ≤ C)
    (hβ : ∀ i, 0 ≤ β i) (hγ : ∀ i, 0 ≤ γ i) (hsum : ∀ i, β i+γ i ≤ α)
    {L R : Type} [DecidableEq L] [DecidableEq R]
    {E : Finset (L × R)} {A : Finset L} {B : Finset R} (n : ℕ) (hn : 1 ≤ n)
    (hA : A.card ≤ n) (hB : B.card ≤ n) (hE : E ⊆ A ×ˢ B) (hfree : ¬Contains P E A B) :
    (E.card : ℝ) ≤ (C*Fintype.card I)*(n : ℝ)^α := by
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hnpos : (0 : ℝ) < n := by linarith
  have hterm (i : I) : (A.card : ℝ)^(β i)*(B.card : ℝ)^(γ i) ≤ (n : ℝ)^α := by
    calc
      _ ≤ (n : ℝ)^(β i)*(n : ℝ)^(γ i) := by
        apply mul_le_mul
        · exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hA) (hβ i)
        · exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hB) (hγ i)
        · exact Real.rpow_nonneg (Nat.cast_nonneg _) _
        · exact Real.rpow_nonneg (Nat.cast_nonneg _) _
      _ = (n : ℝ)^(β i+γ i) := (Real.rpow_add hnpos _ _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hn' (hsum i)
  calc
    _ ≤ C*∑ i, (A.card : ℝ)^(β i)*(B.card : ℝ)^(γ i) := h.estimate hE hfree
    _ ≤ C*∑ _i : I, (n : ℝ)^α := mul_le_mul_of_nonneg_left (sum_le_sum (fun i _ => hterm i)) hC
    _ = _ := by simp; ring

end Erdos571.ConeBounds

namespace Erdos571.DoubleStarCones
open Finset SimpleGraph PatternCone ConeBounds

/-- A three-edge theta, with its two original roots not adjacent. -/
def thetaRel (M : ℕ) : (Fin M ⊕ Unit) → (Fin M ⊕ Unit) → Prop
  | .inl i, .inl j => i = j
  | .inl _, .inr _ => True
  | .inr _, .inl _ => True
  | .inr _, .inr _ => False

lemma noTheta_of_not_contains {L R : Type} [DecidableEq L] [DecidableEq R]
    {M : ℕ} (hM : 1 ≤ M) {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hE : E ⊆ A ×ˢ B) (hf : ¬Contains (thetaRel M) E A B) :
    ThetaThree.NoTheta E M := by
  classical
  intro a z h
  obtain ⟨S,hS,hcard,hfst,hsnd⟩ := h
  let e : Fin M ≃ S := (Fintype.equivFinOfCardEq (by simpa using hcard)).symm
  have he (i : Fin M) := ThetaThree.mem_link.mp (hS (e i).property)
  have he₀ := he ⟨0,by omega⟩
  have ha : a ∈ A := (mem_product.mp (hE he₀.2.2.2.1)).1
  have hz : z ∈ B := (mem_product.mp (hE he₀.2.2.2.2)).2
  let f : Fin M ⊕ Unit → L := Sum.elim (fun i => (e i).val.1) (fun _ => a)
  let g : Fin M ⊕ Unit → R := Sum.elim (fun i => (e i).val.2) (fun _ => z)
  apply hf
  refine ⟨f,g,?_,?_,?_,?_,?_⟩
  · intro u v huv
    cases u with
    | inl i =>
      cases v with
      | inl j =>
        apply congrArg Sum.inl
        apply e.injective
        apply Subtype.ext
        exact hfst (e i).property (e j).property huv
      | inr j => exact False.elim ((he i).2.1 huv)
    | inr i =>
      cases v with
      | inl j => exact False.elim ((he j).2.1 huv.symm)
      | inr j => congr
  · intro u v huv
    cases u with
    | inl i =>
      cases v with
      | inl j =>
        apply congrArg Sum.inl
        apply e.injective
        apply Subtype.ext
        exact hsnd (e i).property (e j).property huv
      | inr j => exact False.elim ((he i).2.2.1 huv)
    | inr i =>
      cases v with
      | inl j => exact False.elim ((he j).2.2.1 huv.symm)
      | inr j => congr
  · intro u
    cases u with
    | inl i => exact (mem_product.mp (hE (he i).1)).1
    | inr i => exact ha
  · intro v
    cases v with
    | inl i => exact (mem_product.mp (hE (he i).1)).2
    | inr i => exact hz
  · intro u v huv
    cases u with
    | inl i =>
      cases v with
      | inl j => cases huv; exact (he i).1
      | inr j => exact (he i).2.2.2.2
    | inr i =>
      cases v with
      | inl j => exact (he j).2.2.2.1
      | inr j => exact False.elim huv

noncomputable def baseBeta : Fin 3 → ℝ := ![2/3,1,0]
noncomputable def baseGamma : Fin 3 → ℝ := ![2/3,0,1]

lemma base_bound (M : ℕ) (hM : 1 ≤ M) :
    Bound (thetaRel M) baseBeta baseGamma ((4*(M:ℝ)+1)*(2*((M:ℝ)+1))) := by
  constructor
  intro L R _ _ E A B hE hf
  have h := ThetaThree.edge_bound_rectangular hE (noTheta_of_not_contains hM hE hf)
  have hpred : ((M-1:ℕ):ℝ) ≤ M := by exact_mod_cast Nat.sub_le M 1
  have hC : 0 ≤ (4*((M-1:ℕ):ℝ)+1) := by positivity
  have hm : (0:ℝ) ≤ M := Nat.cast_nonneg _
  have hA : (0:ℝ) ≤ A.card := Nat.cast_nonneg _
  have hB : (0:ℝ) ≤ B.card := Nat.cast_nonneg _
  have hp : 0 ≤ (A.card:ℝ)^(2/3:ℝ)*(B.card:ℝ)^(2/3:ℝ) := by positivity
  rw [Real.mul_rpow hA hB] at h
  simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero,baseBeta,baseGamma,
    Matrix.cons_val_zero,Matrix.cons_val_succ,Real.rpow_one,Real.rpow_zero,mul_one,one_mul]
  calc
    _ ≤ (4*((M-1:ℕ):ℝ)+1) *
        (2*((M:ℝ)+1)*((A.card:ℝ)^(2/3:ℝ)*(B.card:ℝ)^(2/3:ℝ))+2*A.card+2*B.card) := h
    _ ≤ (4*(M:ℝ)+1) *
        (2*((M:ℝ)+1)*((A.card:ℝ)^(2/3:ℝ)*(B.card:ℝ)^(2/3:ℝ))+2*A.card+2*B.card) := by gcongr
    _ ≤ _ := by nlinarith [mul_nonneg hm hA,mul_nonneg hm hB]

def Side (M : ℕ) : ℕ → Type
  | 0 => Fin M ⊕ Unit
  | t+1 => Option (Side M t)

instance sideFintype (M : ℕ) : (t : ℕ) → Fintype (Side M t)
  | 0 => inferInstanceAs (Fintype (Fin M ⊕ Unit))
  | t+1 => letI := sideFintype M t; inferInstanceAs (Fintype (Option (Side M t)))

def Rel (M : ℕ) : (t : ℕ) → Side M t → Side M t → Prop
  | 0 => thetaRel M
  | t+1 => coneRight (coneLeft (Rel M t))

noncomputable def exponent (t : ℕ) : ℝ := 2 - 2/(2*t+3)

lemma exponent_interval (t : ℕ) : 1 ≤ exponent t ∧ exponent t < 2 := by
  have ht : (0:ℝ) ≤ t := Nat.cast_nonneg _
  have hd : (0:ℝ) < 2*t+3 := by linarith
  dsimp [exponent]
  constructor
  · have := (div_le_one hd).mpr (show (2:ℝ) ≤ 2*t+3 by linarith)
    linarith
  · have := div_pos (by norm_num : (0:ℝ) < 2) hd
    linarith

lemma exponent_succ (t : ℕ) : (4-exponent t)/(3-exponent t) = exponent (t+1) := by
  have ht : (0:ℝ) ≤ t := Nat.cast_nonneg _
  have h₁ : (2*(t:ℝ)+3) ≠ 0 := by positivity
  have h₂ : (2*(t:ℝ)+5) ≠ 0 := by positivity
  dsimp [exponent]
  push_cast
  have heq : 3-(2-2/(2*(t:ℝ)+3)) = (2*(t:ℝ)+5)/(2*(t:ℝ)+3) := by field_simp; ring
  rw [heq]
  field_simp
  ring

/-- A finite rectangular estimate for every member of the explicit cone family. -/
theorem iterated_bound (M : ℕ) (hM : 1 ≤ M) (t : ℕ) :
    ∃ (I : Type) (_ : Fintype I) (β γ : I → ℝ) (C : ℝ),
      1 ≤ C ∧ Bound (Rel M t) β γ C ∧
      (∀ i, 0 ≤ β i ∧ β i ≤ 1) ∧ (∀ i, 0 ≤ γ i ∧ γ i ≤ 1) ∧
      (∀ i, β i+γ i ≤ exponent t) := by
  induction t with
  | zero =>
    refine ⟨Fin 3,inferInstance,baseBeta,baseGamma,(4*(M:ℝ)+1)*(2*((M:ℝ)+1)),?_,
      base_bound M hM,?_,?_,?_⟩
    · have : (0:ℝ) ≤ M := Nat.cast_nonneg _
      nlinarith
    · intro i; fin_cases i <;> norm_num [baseBeta]
    · intro i; fin_cases i <;> norm_num [baseGamma]
    · intro i; fin_cases i <;> norm_num [baseBeta,baseGamma,exponent]
  | succ t ih =>
    obtain ⟨I,hI,β,γ,C,hC,hb,hβ,hγ,hs⟩ := ih
    letI := hI
    have hi := paired_exponents_interval β γ hβ hγ
    refine ⟨Option (Option I),inferInstance,pairBeta β γ,pairGamma β γ,
      C*(Fintype.card I+1)*(Fintype.card I+2),?_,paired_bound (Rel M t) β γ C hC hβ hγ hb,
      hi.1,hi.2,?_⟩
    · have hn : (0:ℝ) ≤ Fintype.card I := Nat.cast_nonneg _
      have : 1 ≤ C*(Fintype.card I+1) := by nlinarith
      nlinarith
    · intro i
      rw [← exponent_succ]
      exact paired_exponent_sum β γ hβ hγ _ (exponent_interval t).1 (exponent_interval t).2 hs i

end Erdos571.DoubleStarCones

/-! The balanced double-star power inside the iterated cone pattern. -/
namespace Erdos571.DoubleStarCones
open Finset SimpleGraph PatternCone ConeBounds BalancedTree SixCycleCase

def petal (M : ℕ) : (t : ℕ) → Fin M → Side M t
  | 0 => Sum.inl
  | t+1 => fun i => some (petal M t i)

def root (M : ℕ) : (t : ℕ) → Fin (t+1) → Side M t
  | 0 => fun _ => Sum.inr ()
  | t+1 => fun j => (finSuccEquiv (t+1) j).map (root M t)

lemma petal_injective (M t : ℕ) : Function.Injective (petal M t) := by
  induction t with
  | zero => exact Sum.inl_injective
  | succ t ih => intro i j h; exact ih (Option.some.inj h)

lemma root_injective (M t : ℕ) : Function.Injective (root M t) := by
  induction t with
  | zero => intro i j _; fin_cases i; fin_cases j; rfl
  | succ t ih => exact (Option.map_injective ih).comp (finSuccEquiv (t+1)).injective

lemma petal_ne_root (M t : ℕ) (i : Fin M) (j : Fin (t+1)) : petal M t i ≠ root M t j := by
  induction t with
  | zero => exact Sum.inl_ne_inr
  | succ t ih =>
    dsimp [petal,root]
    cases hj : finSuccEquiv (t+1) j with
    | none => simp
    | some j => intro h; exact ih j (Option.some.inj h)

lemma rel_petal (M t : ℕ) (i : Fin M) : Rel M t (petal M t i) (petal M t i) := by
  induction t with
  | zero => rfl
  | succ t ih => exact ih

lemma rel_root_petal (M t : ℕ) (j : Fin (t+1)) (i : Fin M) :
    Rel M t (root M t j) (petal M t i) := by
  induction t with
  | zero => trivial
  | succ t ih =>
    dsimp [root,petal,Rel,coneRight]
    cases hj : finSuccEquiv (t+1) j with
    | none => trivial
    | some j => exact ih j

lemma rel_petal_root (M t : ℕ) (i : Fin M) (j : Fin (t+1)) :
    Rel M t (petal M t i) (root M t j) := by
  induction t with
  | zero => trivial
  | succ t ih =>
    dsimp [root,petal,Rel]
    cases hj : finSuccEquiv (t+1) j with
    | none => trivial
    | some j => exact ih j

lemma doubleStar_leafCount (t : ℕ) : leafCount 1 (2*t+1) = fun _ : Fin 2 => t+1 := by
  have hceil : rounding 1 (2*t+1) 1 = t+1 := by
    dsimp [rounding,BalancedTree.slope]
    norm_num only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,Nat.cast_one,mul_one]
    apply (Nat.ceil_eq_iff (by omega)).mpr
    rw [show t+1-1=t by omega]
    push_cast
    constructor <;> linarith
  funext i
  fin_cases i
  · simp [leafCount,hceil]
  · change rounding 1 (2*t+1) 2 - rounding 1 (2*t+1) 1 + 1 = t+1
    rw [show rounding 1 (2*t+1) 2=2*t+1 from rounding_end 1 (2*t+1),hceil]
    omega

def doubleStarMap (M t : ℕ) : ((Fin M × Fin 2) ⊕ Leaf (fun _ : Fin 2 => t+1)) →
    (Side M t ⊕ Side M t) :=
  Sum.elim
    (fun x => if x.2 = 0 then .inl (petal M t x.1) else .inr (petal M t x.1))
    (fun l => if l.1 = 0 then .inr (root M t l.2) else .inl (root M t l.2))

lemma doubleStarMap_injective (M t : ℕ) : Function.Injective (doubleStarMap M t) := by
  intro u v huv
  cases u with
  | inl x =>
    cases v with
    | inl y =>
      obtain ⟨i,a⟩ := x
      obtain ⟨j,b⟩ := y
      fin_cases a <;> fin_cases b <;> simp [doubleStarMap] at huv ⊢
      · exact petal_injective M t huv
      · exact petal_injective M t huv
    | inr l =>
      obtain ⟨i,a⟩ := x
      obtain ⟨b,j⟩ := l
      fin_cases a <;> fin_cases b <;> simp [doubleStarMap] at huv
      · exact False.elim (petal_ne_root M t i j huv)
      · exact False.elim (petal_ne_root M t i j huv)
  | inr l =>
    cases v with
    | inl x =>
      obtain ⟨a,i⟩ := l
      obtain ⟨j,b⟩ := x
      fin_cases a <;> fin_cases b <;> simp [doubleStarMap] at huv
      · exact False.elim (petal_ne_root M t j i huv.symm)
      · exact False.elim (petal_ne_root M t j i huv.symm)
    | inr l' =>
      obtain ⟨a,i⟩ := l
      obtain ⟨b,j⟩ := l'
      fin_cases a <;> fin_cases b <;> simp [doubleStarMap] at huv ⊢
      · exact root_injective M t huv
      · exact root_injective M t huv

lemma doubleStarMap_adj (M t : ℕ) {u v}
    (h : (power (fun _ : Fin 2 => t+1) M).Adj u v) :
    (bipGraph (Rel M t)).Adj (doubleStarMap M t u) (doubleStarMap M t v) := by
  cases u with
  | inl x =>
    cases v with
    | inl y =>
      obtain ⟨i,a⟩ := x
      obtain ⟨j,b⟩ := y
      obtain ⟨hij,hab⟩ := h
      dsimp at hij
      subst j
      fin_cases a <;> fin_cases b <;> simp [pathGraph_adj] at hab
      · exact rel_petal M t i
      · exact rel_petal M t i
    | inr l =>
      obtain ⟨i,a⟩ := x
      obtain ⟨b,j⟩ := l
      change a=b at h
      subst b
      fin_cases a
      · exact rel_petal_root M t i j
      · exact rel_root_petal M t j i
  | inr l =>
    cases v with
    | inl x =>
      obtain ⟨a,j⟩ := l
      obtain ⟨i,b⟩ := x
      change a=b at h
      subst b
      fin_cases a
      · exact rel_petal_root M t i j
      · exact rel_root_petal M t j i
    | inr l' => exact False.elim h

lemma power_contained (M t : ℕ) :
    (power (leafCount 1 (2*t+1)) M).IsContained (bipGraph (Rel M t)) := by
  rw [doubleStar_leafCount]
  exact ⟨{ toHom := { toFun := doubleStarMap M t, map_rel' := doubleStarMap_adj M t }
           injective' := doubleStarMap_injective M t }⟩

end Erdos571.DoubleStarCones

/-! Passing rectangular pattern bounds to ordinary extremal numbers. -/
namespace Erdos571.PatternCone
open Finset SimpleGraph SixCycleCase ConeBounds

lemma bipGraph_bipartite {U V : Type*} (P : U → V → Prop) : (bipGraph P).IsBipartite := by
  let f : bipGraph P →g completeBipartiteGraph U V :=
    { toFun := id
      map_rel' := by
        intro u v h
        cases u <;> cases v <;> simp_all [bipGraph,completeBipartiteGraph] }
  apply Colorable.of_hom f
  simpa only [Fintype.card_bool] using (CompleteBipartiteGraph.bicoloring U V).colorable

lemma cut_not_contains {U W V : Type*} [DecidableEq V]
    (P : U → W → Prop) (G : SimpleGraph V) [DecidableRel G.Adj]
    (hf : (bipGraph P).Free G) (A B : Finset V) (hdis : Disjoint A B) :
    ¬Contains P ((A ×ˢ B).filter (fun e => G.Adj e.1 e.2)) A B := by
  rintro ⟨f,g,hf',hg,hfA,hgB,hE⟩
  apply hf
  refine ⟨{ toHom := { toFun := Sum.elim f g, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v huv
    cases u with
    | inl u =>
      cases v with
      | inl v => exact huv.elim
      | inr v => exact (mem_filter.mp (hE u v huv)).2
    | inr u =>
      cases v with
      | inl v => exact (mem_filter.mp (hE v u huv)).2.symm
      | inr v => exact huv.elim
  · apply Sum.elim_injective.mpr
    refine ⟨hf',hg,?_⟩
    intro u v he
    exact Finset.disjoint_left.mp hdis (he ▸ hfA u) (hgB v)

lemma edge_bound {U W I : Type} [Fintype I] {P : U → W → Prop}
    {β γ : I → ℝ} {C α : ℝ} (h : Bound P β γ C) (hC : 0 ≤ C)
    (hβ : ∀ i, 0 ≤ β i) (hγ : ∀ i, 0 ≤ γ i) (hsum : ∀ i, β i+γ i ≤ α)
    {V : Type} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hf : (bipGraph P).Free G) (hn : 1 ≤ Fintype.card V) :
    (G.edgeFinset.card : ℝ) ≤ (2*C*Fintype.card I)*(Fintype.card V : ℝ)^α := by
  classical
  obtain ⟨A,B,hdis,hAB,hcut⟩ := MaxCut.graph_cut G
  have hA : A.card ≤ Fintype.card V := card_le_univ _
  have hB : B.card ≤ Fintype.card V := card_le_univ _
  have hb := h.diagonal hC hβ hγ hsum _ hn hA hB (filter_subset _ _)
    (cut_not_contains P G hf A B hdis)
  have hc : (G.edgeFinset.card : ℝ) ≤ 2*(((A ×ˢ B).filter fun e => G.Adj e.1 e.2).card : ℝ) := by
    exact_mod_cast hcut
  nlinarith

lemma extremal_isBigO {U W I : Type} [Fintype I] {P : U → W → Prop}
    {β γ : I → ℝ} {C α : ℝ} (h : Bound P β γ C) (hC : 0 ≤ C)
    (hβ : ∀ i, 0 ≤ β i) (hγ : ∀ i, 0 ≤ γ i) (hsum : ∀ i, β i+γ i ≤ α) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (bipGraph P) : ℝ)) (fun n : ℕ => (n:ℝ)^α) := by
  apply Asymptotics.IsBigO.of_bound (2*C*Fintype.card I)
  filter_upwards [Filter.eventually_ge_atTop 1] with n hn
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Nat.cast_nonneg _),
    abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _)]
  rw [← Fintype.card_fin n,extremalNumber_le_iff_of_nonneg (bipGraph P) (by positivity)]
  intro G _ hf
  exact edge_bound h hC hβ hγ hsum G hf (by simpa using hn)

end Erdos571.PatternCone

namespace Erdos571.DoubleStarCones
open Finset SimpleGraph PatternCone ConeBounds SixCycleCase

lemma graph_isBigO (M t : ℕ) (hM : 1 ≤ M) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (bipGraph (Rel M t)) : ℝ))
      (fun n : ℕ => (n:ℝ)^(exponent t)) := by
  obtain ⟨I,hI,β,γ,C,hC,hb,hβ,hγ,hs⟩ := iterated_bound M hM t
  letI := hI
  exact extremal_isBigO hb (by linarith) (fun i => (hβ i).1) (fun i => (hγ i).1) hs

lemma exponent_cast (t : ℕ) : ((2-2/(2*t+3):ℚ):ℝ) = exponent t := by
  push_cast
  rfl

lemma exponent_density (t : ℕ) :
    ((2-(1+BalancedTree.slope 1 (2*t+1))⁻¹:ℚ):ℝ) = exponent t := by
  dsimp [BalancedTree.slope,exponent]
  push_cast
  have h₁ : (2*(t:ℝ)+3) ≠ 0 := by positivity
  have h₂ : (1+(2*(t:ℝ)+1)/2) ≠ 0 := by positivity
  field_simp
  <;> ring

/-- Exact exponents 4/3, 8/5, 12/7, ... . -/
theorem exact_family (t : ℕ) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G : ℝ))
        (fun n : ℕ => (n:ℝ)^((2-2/(2*t+3):ℚ):ℝ)) := by
  classical
  obtain ⟨M,hM,hl⟩ := BalancedExactLower.power_lower 1 (2*t+1)
  simp only [exponent_density] at hl
  have hl' : Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (BalancedTree.power (BalancedTree.leafCount 1 (2*t+1)) M):ℝ))
      (fun n : ℕ => (extremalNumber n (bipGraph (Rel M t)):ℝ)) := by
    apply Asymptotics.IsBigO.of_bound 1
    filter_upwards [] with n
    rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Nat.cast_nonneg _),
      abs_of_nonneg (Nat.cast_nonneg _),one_mul]
    exact_mod_cast (power_contained M t).extremalNumber_le (n:=n)
  let H := bipGraph (Rel M t)
  let e := Fintype.equivFin (Side M t ⊕ Side M t)
  refine ⟨_,H.map e.toEmbedding,(bipGraph_bipartite _).map e.toEmbedding,?_⟩
  simp only [exponent_cast]
  exact LeafPeeling.isTheta_map H e (exponent t) ⟨graph_isBigO M t (by omega),hl.trans hl'⟩

end Erdos571.DoubleStarCones



/- Balanced rooted templates are preserved by paired universal roots. -/
namespace Erdos571.RootedCone
open Finset SimpleGraph RootedSunflower

/-- The old vertices, with the two new vertices designated as roots. -/
def old {A R : Type*} : A ⊕ R ↪ A ⊕ (R ⊕ Bool) :=
  Function.Embedding.sumMap (Function.Embedding.refl _) Function.Embedding.inl

/-- Add one new root of each color, adjacent to every vertex of the other color. -/
def graph {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) :
    SimpleGraph (A ⊕ (R ⊕ Bool)) where
  Adj u v := match u,v with
    | .inl a, .inl b => H.Adj (.inl a) (.inl b)
    | .inl a, .inr (.inl r) => H.Adj (.inl a) (.inr r)
    | .inr (.inl r), .inl a => H.Adj (.inr r) (.inl a)
    | .inr (.inl r), .inr (.inl s) => H.Adj (.inr r) (.inr s)
    | .inl a, .inr (.inr b) => c (.inl a) ≠ b
    | .inr (.inr b), .inl a => b ≠ c (.inl a)
    | .inr (.inl r), .inr (.inr b) => c (.inr r) ≠ b
    | .inr (.inr b), .inr (.inl r) => b ≠ c (.inr r)
    | .inr (.inr b), .inr (.inr d) => b ≠ d
  symm := by
    intro u v h
    rcases u with a | (r | b) <;> rcases v with a' | (r' | b')
    all_goals first | exact h.symm | exact Ne.symm h
  loopless := by
    intro u
    rcases u with a | (r | b)
    · exact H.loopless _
    · exact H.loopless _
    · exact fun h => h rfl

lemma adj_old {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (u v : A ⊕ R) : (graph H c).Adj (old u) (old v) ↔ H.Adj u v := by
  cases u <;> cases v <;> rfl

def oldCopy {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) : H.Copy (graph H c) where
  toHom := { toFun := old, map_rel' := fun {u v} h => (adj_old H c u v).mpr h }
  injective' := old.injective

lemma no_isolated {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (hH : ∀ u, ∃ v, H.Adj u v) : ∀ u, ∃ v, (graph H c).Adj u v := by
  intro u
  rcases u with a | (r | b)
  · obtain ⟨v,hv⟩ := hH (.inl a)
    exact ⟨old v,(oldCopy H c).toHom.map_adj hv⟩
  · obtain ⟨v,hv⟩ := hH (.inr r)
    exact ⟨old v,(oldCopy H c).toHom.map_adj hv⟩
  · refine ⟨.inr (.inr (!b)),?_⟩
    change b ≠ !b
    cases b <;> decide

def color {A R : Type*} (c : A ⊕ R → Bool) : A ⊕ (R ⊕ Bool) → Bool
  | .inl a => c (.inl a)
  | .inr (.inl r) => c (.inr r)
  | .inr (.inr b) => b

lemma color_proper {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (hc : ∀ {u v}, H.Adj u v → c u ≠ c v) :
    ∀ {u v}, (graph H c).Adj u v → color c u ≠ color c v := by
  intro u v h
  rcases u with a | (r | b) <;> rcases v with a' | (r' | b')
  all_goals first | exact hc h | exact h

/-- Every old petal edge remains a petal edge. -/
def oldPetal {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (C : Finset A) :
    PetalEdge H C → PetalEdge (graph H c) C := fun e =>
  ⟨(oldCopy H c).toHom.mapEdgeSet e.val,by
    obtain ⟨a,ha,hae⟩ := e.property
    refine ⟨a,ha,?_⟩
    exact Sym2.mem_map.mpr ⟨.inl a,hae,rfl⟩⟩

/-- One additional petal edge for every unpinned nonroot. -/
def newPetal {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (C : Finset A) :
    {a : A // a ∉ C} → PetalEdge (graph H c) C := fun a =>
  ⟨⟨s(.inl a.val,.inr (.inr (!(c (.inl a.val))))),by
    change c (.inl a.val) ≠ !(c (.inl a.val))
    cases c (.inl a.val) <;> decide⟩,a.val,a.property,by simp⟩

lemma petal_injective {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (C : Finset A) :
    Function.Injective (Sum.elim (oldPetal H c C) (newPetal H c C)) := by
  apply Sum.elim_injective.mpr
  refine ⟨?_,?_,?_⟩
  · intro e f he
    apply Subtype.ext
    exact Hom.mapEdgeSet.injective (oldCopy H c).toHom old.injective (congrArg Subtype.val he)
  · intro a b he
    have h := congrArg (fun e => e.val.val) he
    simp only [newPetal,Sym2.eq_iff,Sum.inl.injEq,Sum.inl_ne_inr,false_and,or_false] at h
    exact Subtype.ext h.1
  · intro e a he
    have hm : Sum.inr (Sum.inr (!(c (.inl a.val)))) ∈ (oldPetal H c C e).val.val := by
      rw [he]
      simp [newPetal]
    obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp hm
    cases v <;> simp [oldCopy,old] at he

lemma petal_card {A R : Type*} [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (C : Finset A) :
    Nat.card (PetalEdge H C) + (Fintype.card A - C.card) ≤ Nat.card (PetalEdge (graph H c) C) := by
  classical
  have h := Nat.card_le_card_of_injective _ (petal_injective H c C)
  simpa [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_subtype_compl] using h

/-- In deficit parameters a/b, paired coning changes the denominator to b+a. -/
theorem balance {A R : Type*} [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (a b : ℕ)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∀ C : Finset A, (b+a)*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge (graph H c) C) := by
  intro C
  have h := hbal C
  have h' := Nat.mul_le_mul_left a (petal_card H c C)
  nlinarith

/-- A color-preserving copy extends over the two new universal roots. -/
def mapVertex {A R B S : Type*} (f : A ⊕ R → B ⊕ S) : A ⊕ (R ⊕ Bool) → B ⊕ (S ⊕ Bool)
  | .inl a => old (f (.inl a))
  | .inr (.inl r) => old (f (.inr r))
  | .inr (.inr b) => .inr (.inr b)

lemma mapVertex_old {A R B S : Type*} (f : A ⊕ R → B ⊕ S) (v : A ⊕ R) :
    mapVertex f (old v) = old (f v) := by cases v <;> rfl

lemma old_ne_new {A R : Type*} (v : A ⊕ R) (b : Bool) : old v ≠ .inr (.inr b) := by
  cases v <;> simp [old]

lemma mapVertex_injective {A R B S : Type*} (f : A ⊕ R → B ⊕ S) (hf : Function.Injective f) :
    Function.Injective (mapVertex f) := by
  have h₁ {u v : A ⊕ R} (h : old (f u) = old (f v)) : u=v := hf (old.injective h)
  intro u v huv
  rcases u with a | (r | b) <;> rcases v with a' | (r' | b')
  · exact congrArg Sum.inl (Sum.inl.inj (h₁ huv))
  · exact False.elim (Sum.inl_ne_inr (h₁ huv))
  · exact False.elim (old_ne_new _ _ huv)
  · exact False.elim (Sum.inr_ne_inl (h₁ huv))
  · exact congrArg (fun x => Sum.inr (Sum.inl x)) (Sum.inr.inj (h₁ huv))
  · exact False.elim (old_ne_new _ _ huv)
  · exact False.elim (old_ne_new _ _ huv.symm)
  · exact False.elim (old_ne_new _ _ huv.symm)
  · exact congrArg (fun x => Sum.inr (Sum.inr x)) (Sum.inr.inj (Sum.inr.inj huv))

lemma adj_old_new {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (v : A ⊕ R) (b : Bool) : (graph H c).Adj (old v) (.inr (.inr b)) ↔ c v ≠ b := by
  cases v <;> rfl

lemma color_old {A R : Type*} (c : A ⊕ R → Bool) (v : A ⊕ R) : color c (old v) = c v := by
  cases v <;> rfl

def mapCopy {A R B S : Type*} {H : SimpleGraph (A ⊕ R)} {K : SimpleGraph (B ⊕ S)}
    {c : A ⊕ R → Bool} {d : B ⊕ S → Bool} (f : H.Copy K)
    (hc : ∀ v, d (f v) = c v) : (graph H c).Copy (graph K d) where
  toHom :=
    { toFun := mapVertex f
      map_rel' := by
        have hOld {u v : A ⊕ R} (h : H.Adj u v) : (graph K d).Adj (old (f u)) (old (f v)) :=
          (adj_old K d _ _).mpr (f.toHom.map_adj h)
        have hNew {u : A ⊕ R} {b : Bool} (h : c u ≠ b) :
            (graph K d).Adj (old (f u)) (.inr (.inr b)) :=
          (adj_old_new K d _ _).mpr (by rwa [hc])
        intro u v h
        rcases u with a | (r | b) <;> rcases v with a' | (r' | b')
        · exact hOld h
        · exact hOld h
        · exact hNew h
        · exact hOld h
        · exact hOld h
        · exact hNew h
        · exact (hNew h.symm).symm
        · exact (hNew h.symm).symm
        · exact h }
  injective' := mapVertex_injective f f.injective

lemma mapCopy_color {A R B S : Type*} {H : SimpleGraph (A ⊕ R)} {K : SimpleGraph (B ⊕ S)}
    {c : A ⊕ R → Bool} {d : B ⊕ S → Bool} (f : H.Copy K)
    (hc : ∀ v, d (f v) = c v) (v : A ⊕ (R ⊕ Bool)) :
    color d (mapCopy f hc v) = color c v := by
  rcases v with a | (r | b)
  · exact (color_old d (f (.inl a))).trans (hc (.inl a))
  · exact (color_old d (f (.inr r))).trans (hc (.inr r))
  · rfl

end Erdos571.RootedCone

/- Powers which retain edges between the designated roots. -/
namespace Erdos571.FullRootedPower
open Finset SimpleGraph RootedSunflower

def graph {A R : Type*} (H : SimpleGraph (A ⊕ R)) (M : ℕ) :
    SimpleGraph ((Fin M × A) ⊕ R) where
  Adj u v := match u,v with
    | .inl x,.inl y => x.1=y.1 ∧ H.Adj (.inl x.2) (.inl y.2)
    | .inl x,.inr r => H.Adj (.inl x.2) (.inr r)
    | .inr r,.inl x => H.Adj (.inr r) (.inl x.2)
    | .inr r,.inr s => H.Adj (.inr r) (.inr s)
  symm := by
    intro u v h
    cases u <;> cases v
    · exact ⟨h.1.symm,h.2.symm⟩
    · exact h.symm
    · exact h.symm
    · exact h.symm
  loopless := by
    intro u
    cases u with
    | inl u => exact fun h => H.loopless _ h.2
    | inr r => exact H.loopless _

noncomputable def coreEmptyIso {A R : Type*} (H : SimpleGraph (A ⊕ R)) (p : ℕ) :
    corePower H ∅ p ≃g graph H p where
  toEquiv := BalancedExactLower.coreEmptyEquiv p
  map_rel_iff' := by
    intro x y
    cases x with
    | inl x =>
      cases y with
      | inl y => exact and_comm
      | inr y =>
        cases y with
        | inl y => exact False.elim (notMem_empty y.val y.prop)
        | inr y => exact ⟨fun h => ⟨h,trivial⟩,fun h => h.1⟩
    | inr x =>
      cases x with
      | inl x => exact False.elim (notMem_empty x.val x.prop)
      | inr x =>
        cases y with
        | inl y => exact ⟨fun h => ⟨h,trivial⟩,fun h => h.1⟩
        | inr y =>
          cases y with
          | inl y => exact False.elim (notMem_empty y.val y.prop)
          | inr y => exact ⟨fun h => ⟨h,trivial⟩,fun h => h.1⟩

def color {A R : Type*} (c : A ⊕ R → Bool) (M : ℕ) : (Fin M × A) ⊕ R → Bool :=
  Sum.elim (fun x => c (.inl x.2)) (fun r => c (.inr r))

lemma color_proper {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (M : ℕ)
    (hc : ∀ {u v}, H.Adj u v → c u ≠ c v) :
    ∀ {u v}, (graph H M).Adj u v → color c M u ≠ color c M v := by
  intro u v h
  cases u <;> cases v
  · exact hc h.2
  · exact hc h
  · exact hc h
  · exact hc h

lemma cone_graph {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (M : ℕ) :
    graph (RootedCone.graph H c) M = RootedCone.graph (graph H M) (color c M) := by
  ext u v
  rcases u with a | (r | b) <;> rcases v with a' | (r' | b') <;> rfl

lemma cone_color {A R : Type*} (c : A ⊕ R → Bool) (M : ℕ) :
    color (RootedCone.color c) M = RootedCone.color (color c M) := by
  funext v
  rcases v with a | (r | b) <;> rfl

/-- The generic lower theorem in a vertex type convenient for cone operations. -/
theorem exact_lower {A R : Type} [Fintype A] [Fintype R] [Nonempty A]
    (H : SimpleGraph (A ⊕ R)) (hH : ∀ u, ∃ v, H.Adj u v)
    (a b : ℕ) (hb : 1 ≤ b) (hab : a ≤ b)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(a:ℝ)/(b:ℝ)))
      (fun n : ℕ => (extremalNumber n (graph H M):ℝ)) := by
  obtain ⟨M,hM,h⟩ := GenericLower.exists_power_exact_lower H hH a b hb hab hbal
  have he (n : ℕ) := extremalNumber_congr_right (coreEmptyIso H M) (n:=n)
  refine ⟨M,hM,?_⟩
  simpa only [he] using h

/-- The lower exponent changes exactly as predicted by the paired upper bound. -/
theorem cone_exact_lower {A R : Type} [Fintype A] [Fintype R] [Nonempty A]
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (hH : ∀ u, ∃ v, H.Adj u v)
    (a b : ℕ) (hb : 1 ≤ b) (hab : a ≤ b)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(a:ℝ)/(b+a:ℕ)))
      (fun n : ℕ => (extremalNumber n (RootedCone.graph (graph H M) (color c M)):ℝ)) := by
  have h := exact_lower (RootedCone.graph H c) (RootedCone.no_isolated H c hH)
    a (b+a) (by omega) (by omega) (RootedCone.balance H c a b hbal)
  simpa only [cone_graph] using h

end Erdos571.FullRootedPower

/- The rooted graph cone and the rectangular pattern cone are the same operation. -/
namespace Erdos571.ConePatternIso
open SimpleGraph PatternCone SixCycleCase

def color {L R : Type*} : L ⊕ R → Bool := Sum.elim (fun _ => false) (fun _ => true)

lemma proper {L R : Type*} (P : L → R → Prop) :
    ∀ {u v}, (bipGraph P).Adj u v → color u ≠ color v := by
  intro u v h
  cases u <;> cases v <;> simp_all [bipGraph,color]

def equiv {L R : Type*} : L ⊕ (R ⊕ Bool) ≃ Option L ⊕ Option R where
  toFun := fun v => match v with
    | .inl l => .inl (some l)
    | .inr (.inl r) => .inr (some r)
    | .inr (.inr false) => .inl none
    | .inr (.inr true) => .inr none
  invFun := fun v => match v with
    | .inl (some l) => .inl l
    | .inr (some r) => .inr (.inl r)
    | .inl none => .inr (.inr false)
    | .inr none => .inr (.inr true)
  left_inv := by
    intro v
    rcases v with l | (r | b)
    · rfl
    · rfl
    · cases b <;> rfl
  right_inv := by
    intro v
    cases v with
    | inl l => cases l <;> rfl
    | inr r => cases r <;> rfl

def iso {L R : Type*} (P : L → R → Prop) :
    RootedCone.graph (bipGraph P) color ≃g bipGraph (coneRight (coneLeft P)) where
  toEquiv := equiv
  map_rel_iff' := by
    intro u v
    rcases u with a | (r | b) <;> rcases v with a' | (r' | b')
    all_goals try (cases b)
    all_goals try (cases b')
    all_goals simp [equiv,RootedCone.graph,bipGraph,coneLeft,coneRight,color]

lemma iso_color {L R : Type*} (P : L → R → Prop) (v : L ⊕ (R ⊕ Bool)) :
    color (iso P v) = RootedCone.color color v := by
  rcases v with a | (r | b)
  · rfl
  · rfl
  · cases b <;> rfl

/-- A supported template copy remains supported after coning both objects. -/
def liftCopy {A R L S : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (P : L → S → Prop) (M : ℕ) (f : (FullRootedPower.graph H M).Copy (bipGraph P))
    (hc : ∀ v, color (f v) = FullRootedPower.color c M v) :
    (FullRootedPower.graph (RootedCone.graph H c) M).Copy (bipGraph (coneRight (coneLeft P))) where
  toHom :=
    { toFun := fun v => iso P (RootedCone.mapCopy f hc v)
      map_rel' := by
        intro u v h
        rw [FullRootedPower.cone_graph] at h
        exact (iso P).toHom.map_adj ((RootedCone.mapCopy f hc).toHom.map_adj h) }
  injective' := (iso P).injective.comp (RootedCone.mapCopy f hc).injective

lemma liftCopy_color {A R L S : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (P : L → S → Prop) (M : ℕ) (f : (FullRootedPower.graph H M).Copy (bipGraph P))
    (hc : ∀ v, color (f v) = FullRootedPower.color c M v)
    (v : (Fin M × A) ⊕ (R ⊕ Bool)) :
    color (liftCopy H c P M f hc v) = FullRootedPower.color (RootedCone.color c) M v := by
  rw [FullRootedPower.cone_color]
  exact (iso_color P _).trans (RootedCone.mapCopy_color f hc v)

end Erdos571.ConePatternIso

/- Rectangular upper bounds supported by balanced rooted templates. -/
namespace Erdos571.SupportedBounds
open SimpleGraph Finset PatternCone ConeBounds SixCycleCase RootedSunflower

/-- Data for a finite pattern, including a rectangular upper estimate. -/
structure Pattern (α : ℝ) where
  L : Type
  R : Type
  I : Type
  [finL : Fintype L]
  [finR : Fintype R]
  [finI : Fintype I]
  rel : L → R → Prop
  β : I → ℝ
  γ : I → ℝ
  C : ℝ
  C_one : 1 ≤ C
  bound : Bound rel β γ C
  β_interval : ∀ i, 0 ≤ β i ∧ β i ≤ 1
  γ_interval : ∀ i, 0 ≤ γ i ∧ γ i ≤ 1
  sum_le : ∀ i, β i+γ i ≤ α

attribute [instance] Pattern.finL Pattern.finR Pattern.finI

noncomputable def Pattern.cone {α : ℝ} (P : Pattern α) (hα1 : 1 ≤ α) (hα2 : α < 2) :
    Pattern ((4-α)/(3-α)) where
  L := Option P.L
  R := Option P.R
  I := Option (Option P.I)
  rel := coneRight (coneLeft P.rel)
  β := pairBeta P.β P.γ
  γ := pairGamma P.β P.γ
  C := P.C*(Fintype.card P.I+1)*(Fintype.card P.I+2)
  C_one := by
    have hC := P.C_one
    have hn : (0:ℝ) ≤ Fintype.card P.I := Nat.cast_nonneg _
    have : 1 ≤ P.C*(Fintype.card P.I+1) := by nlinarith
    nlinarith
  bound := paired_bound P.rel P.β P.γ P.C P.C_one P.β_interval P.γ_interval P.bound
  β_interval := (paired_exponents_interval P.β P.γ P.β_interval P.γ_interval).1
  γ_interval := (paired_exponents_interval P.β P.γ P.β_interval P.γ_interval).2
  sum_le := paired_exponent_sum P.β P.γ P.β_interval P.γ_interval α hα1 hα2 P.sum_le

/-- Every multiplicity admits an upper-bounded pattern containing the template
power with the prescribed bipartite colors. -/
def Supported {A R : Type} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (α : ℝ) : Prop :=
  ∀ M : ℕ, 2 ≤ M → ∃ P : Pattern α,
    ∃ f : (FullRootedPower.graph H M).Copy (bipGraph P.rel),
      ∀ v, ConePatternIso.color (f v) = FullRootedPower.color c M v

/-- The paired-cone upper closure, with enough compatibility to transport
exact algebraic lower bounds as well. -/
theorem Supported.cone {A R : Type} {H : SimpleGraph (A ⊕ R)} {c : A ⊕ R → Bool}
    {α : ℝ} (h : Supported H c α) (hα1 : 1 ≤ α) (hα2 : α < 2) :
    Supported (RootedCone.graph H c) (RootedCone.color c) ((4-α)/(3-α)) := by
  intro M hM
  obtain ⟨P,f,hf⟩ := h M hM
  refine ⟨P.cone hα1 hα2,ConePatternIso.liftCopy H c P.rel M f hf,?_⟩
  exact ConePatternIso.liftCopy_color H c P.rel M f hf

/-- Upper and lower hypotheses are attached to the same pattern, so no
finite-family-to-single-graph inference is needed. -/
theorem Supported.realizes {A R : Type} [Fintype A] [Fintype R] [Nonempty A]
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (hH : ∀ u, ∃ v, H.Adj u v)
    (a b : ℕ) (hb : 1 ≤ b) (hab : a ≤ b)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C))
    (h : Supported H c (2-(a:ℝ)/(b:ℝ))) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^(2-(a:ℝ)/(b:ℝ))) := by
  classical
  obtain ⟨M,hM,hl⟩ := FullRootedPower.exact_lower H hH a b hb hab hbal
  obtain ⟨P,f,hf⟩ := h M hM
  have hu := PatternCone.extremal_isBigO P.bound (by have := P.C_one; linarith)
    (fun i => (P.β_interval i).1) (fun i => (P.γ_interval i).1) P.sum_le
  have hmono : Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (FullRootedPower.graph H M):ℝ))
      (fun n : ℕ => (extremalNumber n (bipGraph P.rel):ℝ)) := by
    apply Asymptotics.IsBigO.of_bound 1
    filter_upwards [] with n
    rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Nat.cast_nonneg _),
      abs_of_nonneg (Nat.cast_nonneg _),one_mul]
    exact_mod_cast (show (FullRootedPower.graph H M).IsContained (bipGraph P.rel) from ⟨f⟩).extremalNumber_le (n:=n)
  let e := Fintype.equivFin (P.L ⊕ P.R)
  refine ⟨_,(bipGraph P.rel).map e.toEmbedding,(bipGraph_bipartite _).map e.toEmbedding,?_⟩
  exact LeafPeeling.isTheta_map _ e _ ⟨hu,hl.trans hmono⟩

/-- A fully supported density certificate. -/
def Certificate (a b : ℕ) : Prop :=
  ∃ (A R : Type) (_ : Fintype A) (_ : Fintype R) (_ : Nonempty A)
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool),
    (∀ {u v}, H.Adj u v → c u ≠ c v) ∧
    (∀ u, ∃ v, H.Adj u v) ∧
    (∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) ∧
    Supported H c (2-(a:ℝ)/(b:ℝ))

lemma deficit_interval (a b : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) :
    1 ≤ 2-(a:ℝ)/(b:ℝ) ∧ 2-(a:ℝ)/(b:ℝ) < 2 := by
  have ha' : (0:ℝ) < a := by exact_mod_cast (show 0 < a by omega)
  have hb' : (0:ℝ) < b := by exact_mod_cast (show 0 < b by omega)
  have hab' : (a:ℝ)/(b:ℝ) ≤ 1 := (div_le_one hb').mpr (by exact_mod_cast hab)
  have hpos := div_pos ha' hb'
  constructor <;> linarith

lemma deficit_cone (a b : ℕ) (hb : 1 ≤ b) :
    (4-(2-(a:ℝ)/(b:ℝ)))/(3-(2-(a:ℝ)/(b:ℝ))) = 2-(a:ℝ)/(b+a:ℕ) := by
  have hb' : (b:ℝ) ≠ 0 := by exact_mod_cast (show b ≠ 0 by omega)
  have hba : ((b+a:ℕ):ℝ) ≠ 0 := by exact_mod_cast (show b+a ≠ 0 by omega)
  push_cast at hba ⊢
  have hd : 3-(2-(a:ℝ)/(b:ℝ)) = ((b:ℝ)+a)/b := by field_simp; ring
  rw [hd]
  field_simp
  <;> ring

/-- Both sides of the extremal estimate survive the paired-cone operation. -/
theorem Certificate.cone {a b : ℕ} (h : Certificate a b) (ha : 1 ≤ a) (hab : a ≤ b) :
    Certificate a (b+a) := by
  obtain ⟨A,R,hA,hR,hne,H,c,hc,hH,hbal,hs⟩ := h
  letI := hA
  letI := hR
  letI := hne
  refine ⟨A,R ⊕ Bool,inferInstance,inferInstance,inferInstance,RootedCone.graph H c,RootedCone.color c,
    RootedCone.color_proper H c hc,RootedCone.no_isolated H c hH,RootedCone.balance H c a b hbal,?_⟩
  have hi := deficit_interval a b ha hab
  have h := hs.cone hi.1 hi.2
  rwa [deficit_cone a b (by omega)] at h

lemma Certificate.realizes {a b : ℕ} (h : Certificate a b) (ha : 1 ≤ a) (hab : a ≤ b) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(a:ℚ)/(b:ℚ):ℚ):ℝ)) := by
  obtain ⟨A,R,hA,hR,hne,H,c,hc,hH,hbal,hs⟩ := h
  letI := hA
  letI := hR
  letI := hne
  push_cast
  exact hs.realizes H c hH a b (by omega) hab hbal

end Erdos571.SupportedBounds

/- The base supported certificate, from a single rooted edge. -/
namespace Erdos571.SupportedBounds
open Finset SimpleGraph PatternCone ConeBounds SixCycleCase RootedSunflower BipartiteCycleBounds

def base : SimpleGraph (Unit ⊕ Unit) := bipGraph (fun _ _ => True)

instance : DecidableRel base.Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [base,bipGraph] <;> infer_instance

lemma base_no_isolated : ∀ u, ∃ v, base.Adj u v := by
  intro u
  cases u with
  | inl _ => exact ⟨.inr (),trivial⟩
  | inr _ => exact ⟨.inl (),trivial⟩

lemma base_balanced : ∀ C : Finset Unit,
    1*(Fintype.card Unit-C.card) ≤ 1*Nat.card (PetalEdge base C) := by
  simp only [Nat.card_eq_fintype_card]
  decide

lemma star_not_contains_degree {M : ℕ} {L R : Type} [DecidableEq L] [DecidableEq R]
    {E : Finset (L × R)} {A : Finset L} {B : Finset R}
    (hf : ¬Contains (fun (_ : Fin M) (_ : Unit) => True) E A B) (b : R) (hb : b ∈ B) :
    (nl E A b).card < M := by
  classical
  by_contra hn
  obtain ⟨S,hS,hcard⟩ := exists_subset_card_eq (show M ≤ (nl E A b).card by omega)
  let e : Fin M ≃ S := (Fintype.equivFinOfCardEq (by simpa using hcard)).symm
  apply hf
  refine ⟨fun i => (e i).val,fun _ => b,?_,?_,?_,fun _ => hb,?_⟩
  · exact Subtype.val_injective.comp e.injective
  · intro u v _; exact Subsingleton.elim _ _
  · intro i; exact (mem_filter.mp (hS (e i).property)).1
  · intro i _ _; exact (mem_filter.mp (hS (e i).property)).2

lemma base_bound (M : ℕ) :
    Bound (fun (_ : Fin M) (_ : Unit) => True) (fun _ : Unit => (0:ℝ))
      (fun _ : Unit => (1:ℝ)) ((M:ℝ)+1) := by
  constructor
  intro L R _ _ E A B hE hf
  have hs := PatternCone.sum_right_degrees hE
  have hdeg : E.card ≤ B.card*(M-1) := by
    calc
      _ = ∑ b ∈ B, (nl E A b).card := hs.symm
      _ ≤ ∑ _b ∈ B, (M-1) := sum_le_sum (fun b hb => by have := star_not_contains_degree hf b hb; omega)
      _ = _ := by simp
  have hpred : ((M-1:ℕ):ℝ) ≤ (M:ℝ)+1 := by exact_mod_cast (show M-1 ≤ M+1 by omega)
  simp only [Real.rpow_zero,Real.rpow_one,one_mul,Fintype.sum_unique]
  calc
    _ ≤ (B.card:ℝ)*((M-1:ℕ):ℝ) := by exact_mod_cast hdeg
    _ ≤ (B.card:ℝ)*((M:ℝ)+1) := mul_le_mul_of_nonneg_left hpred (Nat.cast_nonneg _)
    _ = _ := mul_comm _ _

noncomputable def basePattern (M : ℕ) : Pattern 1 where
  L := Fin M
  R := Unit
  I := Unit
  rel := fun _ _ => True
  β := fun _ => 0
  γ := fun _ => 1
  C := (M:ℝ)+1
  C_one := by have : (0:ℝ) ≤ M := Nat.cast_nonneg _; linarith
  bound := base_bound M
  β_interval := by intro _; norm_num
  γ_interval := by intro _; norm_num
  sum_le := by intro _; norm_num

def baseCopy (M : ℕ) : (FullRootedPower.graph base M).Copy (bipGraph (basePattern M).rel) where
  toHom :=
    { toFun := Sum.map Prod.fst id
      map_rel' := by
        intro u v h
        cases u <;> cases v
        · exact h.2.elim
        · trivial
        · trivial
        · exact h.elim }
  injective' := by
    apply Sum.map_injective.mpr
    constructor
    · intro ⟨i,u⟩ ⟨j,v⟩ h
      simp only [Prod.mk.injEq]
      exact ⟨h,trivial⟩
    · exact Function.injective_id

lemma base_supported : Supported base ConePatternIso.color 1 := by
  intro M _
  refine ⟨basePattern M,baseCopy M,?_⟩
  intro v
  cases v <;> rfl

/-- A one-edge rooted tree starts the supported closure at density one. -/
theorem base_certificate : Certificate 1 1 := by
  refine ⟨Unit,Unit,inferInstance,inferInstance,inferInstance,base,ConePatternIso.color,
    ConePatternIso.proper _,base_no_isolated,base_balanced,?_⟩
  norm_num
  exact base_supported

/-- Every positive integer density has a supported certificate, not just a
standalone graph witness. -/
theorem integer_certificate (t : ℕ) : Certificate 1 (t+1) := by
  induction t with
  | zero => exact base_certificate
  | succ t ih => exact ih.cone (by omega) (by omega)

end Erdos571.SupportedBounds

/- A single remaining closure condition sufficient for the rational assertion. -/
namespace Erdos571.SupportedBounds
open SimpleGraph Finset

/-- This is the unproved subdivision-transfer condition. It is stated as a
hypothesis below, not assumed as an axiom or supplied as a theorem. -/
def SubdivisionClosure : Prop := ∀ a b : ℕ, 1 ≤ a → a ≤ b → Certificate a b →
  Certificate (a+b) (2*b)

lemma certificate_fraction (hsub : SubdivisionClosure) (d : ℚ) (hd : 0 < d) (hd1 : d ≤ 1) :
    ∃ a b : ℕ, 1 ≤ a ∧ a ≤ b ∧ d = (a:ℚ)/(b:ℚ) ∧ Certificate a b := by
  apply rational_deficit_induction
    (P := fun d => ∃ a b : ℕ, 1 ≤ a ∧ a ≤ b ∧ d = (a:ℚ)/(b:ℚ) ∧ Certificate a b) ?_ ?_ ?_ d hd hd1
  · exact ⟨1,1,by omega,by omega,by norm_num,base_certificate⟩
  · intro d hd hd1 h
    obtain ⟨a,b,ha,hab,rfl,h⟩ := h
    refine ⟨a,b+a,ha,by omega,?_,h.cone ha hab⟩
    have hb : (b:ℚ) ≠ 0 := by exact_mod_cast (show b ≠ 0 by omega)
    have hba : (b:ℚ)+(a:ℚ) ≠ 0 := by positivity
    push_cast
    rw [one_add_div hb,div_div_div_cancel_right₀ hb]
  · intro d hd hd1 h
    obtain ⟨a,b,ha,hab,rfl,h⟩ := h
    refine ⟨a+b,2*b,by omega,by omega,?_,hsub a b ha hab h⟩
    have hb : (b:ℚ) ≠ 0 := by exact_mod_cast (show b ≠ 0 by omega)
    push_cast
    field_simp
    ring

/-- Paired coning, including its exact lower-bound compatibility, is proved.
A compatible subdivision transfer would finish the remaining rational cases. -/
theorem rational_turan_of_supported_subdivision (hsub : SubdivisionClosure) :
    ∀ α : ℚ, 1 ≤ α → α < 2 →
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        Asymptotics.IsTheta Filter.atTop
          (fun n : ℕ => (extremalNumber n G:ℝ))
          (fun n : ℕ => (n:ℝ)^(α:ℝ)) := by
  intro α hα hα2
  obtain ⟨a,b,ha,hab,he,h⟩ := certificate_fraction hsub (2-α) (by linarith) (by linarith)
  have hex : (2:ℚ)-(a:ℚ)/(b:ℚ) = α := by linarith
  simpa only [hex] using h.realizes ha hab

end Erdos571.SupportedBounds


/-! Heavy codegrees lift ordinary copies to subdivisions. -/
namespace Erdos571.ProjectionHeavy
open Finset SimpleGraph PatternCone SixCycleCase BipartiteCycleBounds

lemma injective_selection {I R : Type*} [Fintype I] [DecidableEq R]
    (F : I → Finset R) (h : ∀ i, Fintype.card I ≤ (F i).card) :
    ∃ g : I → R, Function.Injective g ∧ ∀ i, g i ∈ F i := by
  classical
  apply (Finset.all_card_le_biUnion_card_iff_exists_injective F).mp
  intro S
  rcases S.eq_empty_or_nonempty with rfl | hS
  · simp
  · obtain ⟨i,hi⟩ := hS
    exact (card_le_univ S).trans ((h i).trans (card_le_card (subset_biUnion_of_mem F hi)))

def incidence {V : Type*} (H : SimpleGraph V) (v : V) (e : H.edgeSet) : Prop := v ∈ e.val

def subdivision {V : Type*} (H : SimpleGraph V) := bipGraph (incidence H)

variable {L R : Type*} [DecidableEq L] [DecidableEq R]

def common (E : Finset (L × R)) (B : Finset R) (u v : L) : Finset R :=
  B.filter (fun b => (u,b) ∈ E ∧ (v,b) ∈ E)

lemma common_symm (E : Finset (L × R)) (B : Finset R) (u v : L) : common E B u v = common E B v u := by
  ext b
  simp [common,and_comm]

def heavy (E : Finset (L × R)) (B : Finset R) (t : ℕ) : SimpleGraph L where
  Adj u v := u ≠ v ∧ t ≤ (common E B u v).card
  symm := by
    intro u v h
    exact ⟨h.1.symm,by simpa only [common_symm E B v u] using h.2⟩
  loopless := by intro u h; exact h.1 rfl

/-- The candidate middle vertices for the image of an old edge. -/
noncomputable def middles {V : Type*} (H : SimpleGraph V) (E : Finset (L × R)) (B : Finset R)
    (f : V → L) (e : H.edgeSet) : Finset R := by
  classical
  exact B.filter (fun b => ∀ v ∈ e.val, (f v,b) ∈ E)

lemma mem_middles {V : Type*} (H : SimpleGraph V) (E : Finset (L × R)) (B : Finset R)
    (f : V → L) (e : H.edgeSet) (b : R) :
    b ∈ middles H E B f e ↔ b ∈ B ∧ ∀ v ∈ e.val, (f v,b) ∈ E := by
  classical
  simp only [middles,mem_filter]

lemma middles_card {V : Type*} (H : SimpleGraph V) (E : Finset (L × R)) (B : Finset R)
    (t : ℕ) (f : H.Copy (heavy E B t)) (e : H.edgeSet) : t ≤ (middles H E B f e).card := by
  classical
  obtain ⟨e,he⟩ := e
  induction e using Sym2.inductionOn with
  | hf u v =>
    have h := f.toHom.map_adj (show H.Adj u v from he)
    have heq : middles H E B f ⟨s(u,v),he⟩ = common E B (f u) (f v) := by
      ext b
      simp [middles,common,Sym2.mem_iff]
    rw [heq]
    exact h.2

/-- A copy in the heavy-pair graph has distinct middle vertices for all its
edges, and therefore lifts to a part-preserving subdivision copy. -/
theorem contains_incidence_of_heavy {V : Type*} [Fintype V]
    (H : SimpleGraph V) (E : Finset (L × R)) (A : Finset L) (B : Finset R)
    (f : H.Copy (heavy E B (Nat.card H.edgeSet))) (hfA : ∀ v, f v ∈ A) :
    Contains (incidence H) E A B := by
  classical
  obtain ⟨g,hg,hgF⟩ := injective_selection (middles H E B f) (by
    intro e
    simpa only [Nat.card_eq_fintype_card] using middles_card H E B _ f e)
  refine ⟨f,g,f.injective,hg,hfA,?_,?_⟩
  · intro e; exact ((mem_middles H E B f e _).mp (hgF e)).1
  · intro v e hve
    exact ((mem_middles H E B f e _).mp (hgF e)).2 v hve

end Erdos571.ProjectionHeavy

/-! Heavy/light two-path counting for the subdivision problem. -/
namespace Erdos571.ProjectionHeavy
open Finset SimpleGraph PatternCone SixCycleCase BipartiteCycleBounds

/-- An ordinary extremal bound, expressed for arbitrary finite hosts. -/
structure EdgeBound {V : Type} (H : SimpleGraph V) (α C : ℝ) : Prop where
  estimate : ∀ {W : Type} [Fintype W] (G : SimpleGraph W), H.Free G →
    (Nat.card G.edgeSet : ℝ) ≤ C*(Fintype.card W : ℝ)^α

lemma edgeBound_of_pattern {α : ℝ} (P : SupportedBounds.Pattern α) :
    EdgeBound (bipGraph P.rel) α (2*P.C*Fintype.card P.I) := by
  classical
  constructor
  intro W _ G hf
  by_cases hW : Fintype.card W=0
  · letI : IsEmpty W := Fintype.card_eq_zero_iff.mp hW
    have hG : G = ⊥ := by ext u v; exact (IsEmpty.false u).elim
    rw [hG,Nat.card_eq_fintype_card,card_edgeSet,edgeFinset_bot,card_empty,Nat.cast_zero]
    have hC : 0 ≤ P.C := by have := P.C_one; linarith
    positivity
  · have h := PatternCone.edge_bound P.bound (by have := P.C_one; linarith)
      (fun i => (P.β_interval i).1) (fun i => (P.γ_interval i).1) P.sum_le G hf (by omega)
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using h

variable {L R : Type} [DecidableEq L] [DecidableEq R]

lemma heavy_induced_free {V : Type} [Fintype V] (H : SimpleGraph V)
    (E : Finset (L × R)) (A : Finset L) (B : Finset R)
    (hf : ¬Contains (incidence H) E A B) (S : Finset L) (hS : S ⊆ A) :
    H.Free ((heavy E B (Nat.card H.edgeSet)).induce (S : Set L)) := by
  rintro ⟨f⟩
  exact hf (contains_incidence_of_heavy H E A B
    ((Copy.induce (heavy E B (Nat.card H.edgeSet)) (S : Set L)).comp f)
    (fun v => hS (f v).property))

noncomputable def heavyPairs (E : Finset (L × R)) (B : Finset R) (t : ℕ) (S : Finset L) : Finset (L × L) := by
  classical
  exact (S ×ˢ S).filter (fun p => (heavy E B t).Adj p.1 p.2)

lemma mem_heavyPairs (E : Finset (L × R)) (B : Finset R) (t : ℕ) (S : Finset L) (u v : L) :
    (u,v) ∈ heavyPairs E B t S ↔ u ∈ S ∧ v ∈ S ∧ u ≠ v ∧ t ≤ (common E B u v).card := by
  classical
  simp only [heavyPairs,mem_filter,mem_product,heavy]
  tauto

lemma heavyPairs_card (E : Finset (L × R)) (B : Finset R) (t : ℕ) (S : Finset L) :
    (heavyPairs E B t S).card = 2*Nat.card ((heavy E B t).induce (S : Set L)).edgeSet := by
  classical
  let G := (heavy E B t).induce (S : Set L)
  let e : (heavyPairs E B t S) ≃ G.Dart :=
    { toFun := fun p =>
        { toProd := (⟨p.val.1,(mem_heavyPairs E B t S _ _).mp p.property |>.1⟩,
            ⟨p.val.2,(mem_heavyPairs E B t S _ _).mp p.property |>.2.1⟩)
          adj := (mem_heavyPairs E B t S _ _).mp p.property |>.2.2 }
      invFun := fun d => ⟨(d.fst.val,d.snd.val),
        (mem_heavyPairs E B t S _ _).mpr ⟨d.fst.property,d.snd.property,d.adj⟩⟩
      left_inv := by intro p; apply Subtype.ext; rfl
      right_inv := by intro d; apply Dart.ext; rfl }
  have h := Fintype.card_congr e
  rw [Fintype.card_coe,G.dart_card_eq_twice_card_edges] at h
  simpa only [Nat.card_eq_fintype_card,card_edgeSet] using h

lemma heavyPairs_bound {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hbound : EdgeBound H α C) (E : Finset (L × R)) (A : Finset L) (B : Finset R)
    (hf : ¬Contains (incidence H) E A B) (S : Finset L) (hS : S ⊆ A) :
    ((heavyPairs E B (Nat.card H.edgeSet) S).card : ℝ) ≤ 2*C*(S.card : ℝ)^α := by
  classical
  have h := hbound.estimate _ (heavy_induced_free H E A B hf S hS)
  rw [heavyPairs_card]
  push_cast
  rw [Fintype.card_of_finset' (p:=(S:Set L)) S (fun _ => Iff.rfl)] at h
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left h (by norm_num : (0:ℝ) ≤ 2)

noncomputable def lightPairs (E : Finset (L × R)) (B : Finset R) (t : ℕ) (S : Finset L) : Finset (L × L) := by
  classical
  exact (S ×ˢ S).filter (fun p => p.1 ≠ p.2 ∧ (common E B p.1 p.2).card < t)

lemma mem_lightPairs (E : Finset (L × R)) (B : Finset R) (t : ℕ) (S : Finset L) (u v : L) :
    (u,v) ∈ lightPairs E B t S ↔ u ∈ S ∧ v ∈ S ∧ u ≠ v ∧ (common E B u v).card < t := by
  classical
  simp only [lightPairs,mem_filter,mem_product]
  tauto

lemma pair_partition (E : Finset (L × R)) (B : Finset R) (t : ℕ) (S : Finset L) :
    S.card + (heavyPairs E B t S).card + (lightPairs E B t S).card = S.card^2 := by
  classical
  let diag := (S ×ˢ S).filter (fun p => p.1=p.2)
  let off := (S ×ˢ S).filter (fun p => p.1≠p.2)
  have hdiag : diag.card = S.card := by
    apply card_bij (fun p _ => p.1)
    · intro p hp; exact (mem_product.mp (mem_filter.mp hp).1).1
    · intro p hp q hq he
      apply Prod.ext he
      exact (mem_filter.mp hp).2.symm.trans (he.trans (mem_filter.mp hq).2)
    · intro u hu
      exact ⟨(u,u),mem_filter.mpr ⟨mem_product.mpr ⟨hu,hu⟩,rfl⟩,rfl⟩
  have htotal := card_filter_add_card_filter_not (s:=S ×ˢ S) (fun p : L × L => p.1=p.2)
  change diag.card+off.card=(S ×ˢ S).card at htotal
  rw [hdiag,card_product] at htotal
  have hsplit := card_filter_add_card_filter_not
    (s:=off) (fun p : L × L => t ≤ (common E B p.1 p.2).card)
  have hh : off.filter (fun p : L × L => t ≤ (common E B p.1 p.2).card) = heavyPairs E B t S := by
    ext p
    simp [off,heavyPairs,heavy,and_assoc]
  have hl : off.filter (fun p : L × L => ¬ t ≤ (common E B p.1 p.2).card) = lightPairs E B t S := by
    ext p
    simp [off,lightPairs,and_assoc]
  rw [hh,hl] at hsplit
  nlinarith

/-- The exact partition of the second degree moment into diagonal, heavy,
and light two-paths. -/
lemma moment_partition (E : Finset (L × R)) (A : Finset L) (B : Finset R)
    (hE : E ⊆ A ×ˢ B) (t : ℕ) :
    E.card + (∑ b ∈ B, (heavyPairs E B t (nl E A b)).card) +
      (∑ b ∈ B, (lightPairs E B t (nl E A b)).card) =
      ∑ b ∈ B, (nl E A b).card^2 := by
  rw [← sum_right_degrees hE,← sum_add_distrib,← sum_add_distrib]
  exact sum_congr rfl (fun b _ => pair_partition E B t (nl E A b))

/-- An upper bound for the old pattern bounds the heavy part of the two-path
moment inside every neighborhood of a subdivision-free graph. -/
theorem light_moment_bound {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hbound : EdgeBound H α C) (E : Finset (L × R)) (A : Finset L) (B : Finset R)
    (hE : E ⊆ A ×ˢ B) (hf : ¬Contains (incidence H) E A B) :
    (∑ b ∈ B, ((nl E A b).card : ℝ)^2) ≤ (E.card : ℝ) +
      2*C*(∑ b ∈ B, ((nl E A b).card : ℝ)^α) +
      ∑ b ∈ B, ((lightPairs E B (Nat.card H.edgeSet) (nl E A b)).card : ℝ) := by
  have hp : (E.card : ℝ) +
      (∑ b ∈ B, ((heavyPairs E B (Nat.card H.edgeSet) (nl E A b)).card : ℝ)) +
      (∑ b ∈ B, ((lightPairs E B (Nat.card H.edgeSet) (nl E A b)).card : ℝ)) =
      ∑ b ∈ B, ((nl E A b).card : ℝ)^2 := by
    exact_mod_cast moment_partition E A B hE (Nat.card H.edgeSet)
  rw [← hp]
  suffices hh : (∑ b ∈ B, ((heavyPairs E B (Nat.card H.edgeSet) (nl E A b)).card : ℝ)) ≤
      2*C*(∑ b ∈ B, ((nl E A b).card : ℝ)^α) by linarith
  rw [mul_sum]
  exact sum_le_sum (fun b _ => heavyPairs_bound H hbound E A B hf (nl E A b) (filter_subset _ _))

end Erdos571.ProjectionHeavy

/-! Finite averaging and induced-density regularization. -/
namespace Erdos571.DensityRegularization
open Finset SimpleGraph

/-- A prescribed-size subset captures at least its proportional share of any
real weight, with no positivity assumption on the weights. -/
lemma exists_subset_weight {V : Type*} [DecidableEq V] (U : Finset V) (k : ℕ)
    (hk : k ≤ U.card) (f : V → ℝ) :
    ∃ T ⊆ U, T.card=k ∧ (k:ℝ)*(∑v∈U,f v) ≤ (U.card:ℝ)*(∑v∈T,f v) := by
  classical
  obtain ⟨T,hT,hTk⟩ := exists_subset_card_eq hk
  have hne : (U.powersetCard k).Nonempty := ⟨T,mem_powersetCard.mpr ⟨hT,hTk⟩⟩
  obtain ⟨T,hT,hmax⟩ := exists_max_image (U.powersetCard k) (fun T => ∑v∈T,f v) hne
  obtain ⟨hTU,hTk⟩ := mem_powersetCard.mp hT
  have hswap (u : V) (hu : u ∈ T) (v : V) (hv : v ∈ U \ T) : f v ≤ f u := by
    have hvT : v ∉ T := (mem_sdiff.mp hv).2
    have hnot : v ∉ T.erase u := fun h => hvT (mem_of_mem_erase h)
    have hsub : insert v (T.erase u) ⊆ U := insert_subset (mem_sdiff.mp hv).1 ((erase_subset _ _).trans hTU)
    have hcard : (insert v (T.erase u)).card = k := by
      rw [card_insert_of_notMem hnot,card_erase_of_mem hu]
      have := card_pos.mpr ⟨u,hu⟩
      omega
    have h := hmax _ (mem_powersetCard.mpr ⟨hsub,hcard⟩)
    rw [sum_insert hnot] at h
    have he := sum_erase_add T f hu
    linarith
  have hs : (∑u∈T, ∑v∈U \ T, f v) ≤ ∑u∈T, ∑v∈U \ T, f u := by
    exact sum_le_sum (fun u hu => sum_le_sum (fun v hv => hswap u hu v hv))
  simp only [sum_const,nsmul_eq_mul,← mul_sum] at hs
  have hsum := sum_sdiff hTU (f:=f)
  have hcard := card_sdiff_add_card_eq_card hTU
  have hcard' : ((U \ T).card:ℝ)+(T.card:ℝ)=U.card := by exact_mod_cast hcard
  refine ⟨T,hTU,hTk,?_⟩
  rw [← hTk]
  rw [← hsum,← hcard',mul_add,add_mul]
  exact add_le_add hs le_rfl

variable {V : Type*} [DecidableEq V]

def neighbors (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) (v : V) : Finset V :=
  U.filter (G.Adj v)

def arcs (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) : Finset (V × V) :=
  (U ×ˢ U).filter (fun p => G.Adj p.1 p.2)

lemma mem_arcs {G : SimpleGraph V} [DecidableRel G.Adj] {U : Finset V} {u v : V} :
    (u,v) ∈ arcs G U ↔ u ∈ U ∧ v ∈ U ∧ G.Adj u v := by
  simp only [arcs,mem_filter,mem_product]
  tauto

lemma arcs_mono (G : SimpleGraph V) [DecidableRel G.Adj] {U W : Finset V} (h : U ⊆ W) :
    arcs G U ⊆ arcs G W := by
  rintro ⟨u,v⟩ hp
  obtain ⟨hu,hv,huv⟩ := mem_arcs.mp hp
  exact mem_arcs.mpr ⟨h hu,h hv,huv⟩

lemma neighbors_mono (G : SimpleGraph V) [DecidableRel G.Adj] {U W : Finset V} (h : U ⊆ W) (v : V) :
    neighbors G U v ⊆ neighbors G W v := filter_subset_filter _ h

lemma rectangle_card (G : SimpleGraph V) [DecidableRel G.Adj] (A B : Finset V) :
    ((A ×ˢ B).filter (fun p => G.Adj p.1 p.2)).card = ∑u∈A, (neighbors G B u).card := by
  have h₁ : ((A ×ˢ B).filter (fun p => G.Adj p.1 p.2)).card =
      ∑p∈A ×ˢ B, if G.Adj p.1 p.2 then (1:ℕ) else 0 := by
    simpa only [Nat.cast_id] using (sum_boole (R:=ℕ) (fun p : V × V => G.Adj p.1 p.2) (A ×ˢ B)).symm
  rw [h₁,sum_product]
  apply sum_congr rfl
  intro u _
  simpa only [neighbors,Nat.cast_id] using sum_boole (R:=ℕ) (G.Adj u) B

lemma arcs_sum (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) :
    (arcs G U).card = ∑v∈U, (neighbors G U v).card := rectangle_card G U U

lemma arcs_card (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) :
    (arcs G U).card = 2*Nat.card (G.induce (U:Set V)).edgeSet := by
  classical
  let H := G.induce (U:Set V)
  let e : (arcs G U) ≃ H.Dart :=
    { toFun := fun p =>
        { toProd := (⟨p.val.1,(mem_arcs.mp p.property).1⟩,⟨p.val.2,(mem_arcs.mp p.property).2.1⟩)
          adj := (mem_arcs.mp p.property).2.2 }
      invFun := fun d => ⟨(d.fst.val,d.snd.val),mem_arcs.mpr ⟨d.fst.property,d.snd.property,d.adj⟩⟩
      left_inv := by intro p; apply Subtype.ext; rfl
      right_inv := by intro d; apply Dart.ext; rfl }
  have h := Fintype.card_congr e
  rw [Fintype.card_coe,H.dart_card_eq_twice_card_edges] at h
  simpa only [Nat.card_eq_fintype_card,card_edgeSet] using h

/-- The total weight into S can be captured on a second small vertex set. -/
lemma exists_small_rectangle (G : SimpleGraph V) [DecidableRel G.Adj] (U S : Finset V)
    (hS : S ⊆ U) :
    ∃ T ⊆ U, T.card=S.card ∧
      (S.card:ℝ)*(∑u∈S, ((neighbors G U u).card:ℝ)) ≤
        (U.card:ℝ)*(arcs G (S ∪ T)).card := by
  obtain ⟨T,hTU,hcard,hw⟩ := exists_subset_weight U S.card (card_le_card hS)
    (fun v => ((neighbors G S v).card:ℝ))
  have hswap : (∑v∈U, (neighbors G S v).card) = ∑u∈S, (neighbors G U u).card := by
    have h := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (s:=U) (t:=S) G.Adj
    simpa only [neighbors,bipartiteAbove,bipartiteBelow,G.adj_comm] using h
  have hswap' : (∑v∈U, ((neighbors G S v).card:ℝ)) = ∑u∈S, ((neighbors G U u).card:ℝ) := by
    exact_mod_cast hswap
  rw [hswap'] at hw
  have hrect : (∑v∈T, (neighbors G S v).card) ≤ (arcs G (S ∪ T)).card := by
    have hsub : (T ×ˢ S).filter (fun p => G.Adj p.1 p.2) ⊆ arcs G (S ∪ T) := by
      rintro ⟨v,u⟩ hp
      obtain ⟨⟨hv,hu⟩,hvu⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
      exact mem_arcs.mpr ⟨mem_union_right _ hv,mem_union_left _ hu,hvu⟩
    have hc := card_le_card hsub
    rwa [rectangle_card] at hc
  have hrect' : (∑v∈T, ((neighbors G S v).card:ℝ)) ≤ (arcs G (S ∪ T)).card := by exact_mod_cast hrect
  exact ⟨T,hTU,hcard,hw.trans (mul_le_mul_of_nonneg_left hrect' (Nat.cast_nonneg _))⟩

/-- Local density bounds control the degree mass of every small vertex set. -/
lemma local_degree_mass (G : SimpleGraph V) [DecidableRel G.Adj] (U S : Finset V)
    (hS : S ⊆ U) {β C : ℝ} (hβ : 0 ≤ β) (hC : 0 ≤ C)
    (hlocal : ∀ W ⊆ U, ((arcs G W).card:ℝ) ≤ C*(W.card:ℝ)^β) :
    (S.card:ℝ)*(∑u∈S, ((neighbors G U u).card:ℝ)) ≤
      (U.card:ℝ)*C*(2*(S.card:ℝ))^β := by
  obtain ⟨T,hTU,hcard,h⟩ := exists_small_rectangle G U S hS
  have hb := hlocal (S ∪ T) (union_subset hS hTU)
  have hsize : ((S ∪ T).card:ℝ) ≤ 2*(S.card:ℝ) := by
    have := card_union_le S T
    have h' : (S ∪ T).card ≤ 2*S.card := by omega
    exact_mod_cast h'
  have hpow := Real.rpow_le_rpow (Nat.cast_nonneg _) hsize hβ
  calc
    _ ≤ (U.card:ℝ)*(arcs G (S ∪ T)).card := h
    _ ≤ (U.card:ℝ)*(C*(S ∪ T).card^β) := mul_le_mul_of_nonneg_left hb (Nat.cast_nonneg _)
    _ ≤ (U.card:ℝ)*(C*(2*(S.card:ℝ))^β) := by gcongr
    _ = _ := by ring

lemma mass_numeric {n k m C K β w : ℝ} (hn : 0 < n) (hk : 0 < k) (hm : 0 < m)
    (hC : 0 ≤ C) (hK : 0 < K) (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2)
    (hw : 0 ≤ w) (hmC : m=C*n^β) (hkK : k*K ≤ n)
    (hKpow : 16 ≤ K^(β-1)) (hmass : k*w ≤ n*C*(2*k)^β) : 4*w ≤ m := by
  have hr : 0 ≤ β-1 := by linarith
  have hkp : 0 < K^(β-1) := Real.rpow_pos_of_pos hK _
  have hpow : k^(β-1)*K^(β-1) ≤ n^(β-1) := by
    rw [← Real.mul_rpow hk.le hK.le]
    exact Real.rpow_le_rpow (mul_nonneg hk.le hK.le) hkK hr
  have hkadd : k*k^(β-1)=k^β := by
    calc
      _ = k^(1:ℝ)*k^(β-1) := by rw [Real.rpow_one]
      _ = k^(1+(β-1)) := (Real.rpow_add hk _ _).symm
      _ = _ := by congr 1; ring
  have hnadd : n*n^(β-1)=n^β := by
    calc
      _ = n^(1:ℝ)*n^(β-1) := by rw [Real.rpow_one]
      _ = n^(1+(β-1)) := (Real.rpow_add hn _ _).symm
      _ = _ := by congr 1; ring
  have hbase : w ≤ (2:ℝ)^β*C*n*k^(β-1) := by
    apply (mul_le_mul_iff_right₀ hk).mp
    have heq : k*((2:ℝ)^β*C*n*k^(β-1)) = n*C*(2*k)^β := by
      rw [Real.mul_rpow (by norm_num : (0:ℝ) ≤ 2) hk.le]
      calc
        _ = (2:ℝ)^β*C*n*(k*k^(β-1)) := by ring
        _ = _ := by rw [hkadd]; ring
    simpa only [heq] using hmass
  have hprod : w*K^(β-1) ≤ (2:ℝ)^β*m := by
    calc
      _ ≤ ((2:ℝ)^β*C*n*k^(β-1))*K^(β-1) := mul_le_mul_of_nonneg_right hbase hkp.le
      _ = (2:ℝ)^β*C*n*(k^(β-1)*K^(β-1)) := by ring
      _ ≤ (2:ℝ)^β*C*n*n^(β-1) := by gcongr
      _ = (2:ℝ)^β*m := by rw [hmC]; rw [mul_assoc ((2:ℝ)^β*C),hnadd]; ring
  have htwo : (2:ℝ)^β ≤ 4 := by
    calc
      _ ≤ (2:ℝ)^(2:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hβ2
      _ = _ := by norm_num
  have hh := mul_le_mul_of_nonneg_right hKpow hw
  have hh' := mul_le_mul_of_nonneg_right htwo hm.le
  nlinarith

set_option maxHeartbeats 1000000 in
/-- Vertices whose degrees are much larger than the average carry only a
small fraction of the total degree mass in a density-maximal graph. -/
lemma high_degree_mass (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V)
    {β C K : ℝ} (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2) (hC : 0 ≤ C) (hK : 0 < K)
    (hKpow : 16 ≤ K^(β-1)) (hm : 0 < (arcs G U).card)
    (hdensity : ((arcs G U).card:ℝ)=C*(U.card:ℝ)^β)
    (hlocal : ∀ W ⊆ U, ((arcs G W).card:ℝ) ≤ C*(W.card:ℝ)^β) :
    let S := U.filter (fun v => K*(arcs G U).card < (U.card:ℝ)*(neighbors G U v).card)
    4*(∑v∈S, ((neighbors G U v).card:ℝ)) ≤ (arcs G U).card := by
  classical
  intro S
  have hS : S ⊆ U := filter_subset _ _
  have hall : (∑v∈U, ((neighbors G U v).card:ℝ)) = (arcs G U).card := by
    exact_mod_cast (arcs_sum G U).symm
  have hmass : (∑v∈S, ((neighbors G U v).card:ℝ)) ≤ (arcs G U).card := by
    rw [← hall]
    exact sum_le_sum_of_subset_of_nonneg hS (fun _ _ _ => Nat.cast_nonneg _)
  have hm' : (0:ℝ) < (arcs G U).card := by exact_mod_cast hm
  have hU : (0:ℝ) < U.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hm
    exact_mod_cast card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  by_cases hzero : S.card=0
  · have he : S=∅ := card_eq_zero.mp hzero
    rw [he,sum_empty,mul_zero]
    exact hm'.le
  have hk : (0:ℝ) < S.card := by exact_mod_cast (show 0<S.card by omega)
  have hsum : (S.card:ℝ)*(K*(arcs G U).card) ≤ (U.card:ℝ)*(∑v∈S, ((neighbors G U v).card:ℝ)) := by
    rw [mul_sum]
    calc
      _ = ∑_v∈S, K*(arcs G U).card := by simp only [sum_const,nsmul_eq_mul]
      _ ≤ _ := sum_le_sum (fun v hv => (mem_filter.mp hv).2.le)
  have hkK : (S.card:ℝ)*K ≤ U.card := by
    apply (mul_le_mul_iff_left₀ hm').mp
    calc
      _ = (S.card:ℝ)*(K*(arcs G U).card) := by ring
      _ ≤ (U.card:ℝ)*(∑v∈S, ((neighbors G U v).card:ℝ)) := hsum
      _ ≤ (U.card:ℝ)*(arcs G U).card := mul_le_mul_of_nonneg_left hmass hU.le
  exact mass_numeric hU hk hm' hC hK hβ1 hβ2 (by positivity) hdensity hkK hKpow
    (local_degree_mass G U S hS (by linarith) hC hlocal)

/-- Removing vertices loses at most twice their original degree mass. -/
lemma arcs_remove_bound (G : SimpleGraph V) [DecidableRel G.Adj] (U S : Finset V)
    (hS : S ⊆ U) :
    (arcs G U).card ≤ (arcs G (U \ S)).card + 2*∑u∈S, (neighbors G U u).card := by
  classical
  let row := (arcs G U).filter (fun p => p.1 ∈ S)
  let col := (arcs G U).filter (fun p => p.2 ∈ S)
  have hrow : row = (S ×ˢ U).filter (fun p => G.Adj p.1 p.2) := by
    ext ⟨u,v⟩
    simp only [row,mem_filter,mem_arcs,mem_product]
    constructor
    · rintro ⟨⟨_,hv,huv⟩,hu⟩; exact ⟨⟨hu,hv⟩,huv⟩
    · rintro ⟨⟨hu,hv⟩,huv⟩; exact ⟨⟨hS hu,hv,huv⟩,hu⟩
  have hrc : row.card = ∑u∈S, (neighbors G U u).card := by rw [hrow,rectangle_card]
  have hcc : col.card = row.card := by
    apply card_bij (fun p _ => p.swap)
    · rintro ⟨u,v⟩ hp
      obtain ⟨⟨hu,hv,huv⟩,hvS⟩ := mem_filter.mp hp |>.imp_left mem_arcs.mp
      exact mem_filter.mpr ⟨mem_arcs.mpr ⟨hv,hu,huv.symm⟩,hvS⟩
    · intro p _ q _ h; exact Prod.swap_injective h
    · rintro ⟨u,v⟩ hp
      obtain ⟨⟨hu,hv,huv⟩,huS⟩ := mem_filter.mp hp |>.imp_left mem_arcs.mp
      exact ⟨(v,u),mem_filter.mpr ⟨mem_arcs.mpr ⟨hv,hu,huv.symm⟩,huS⟩,rfl⟩
  have hsub : arcs G U ⊆ arcs G (U \ S) ∪ (row ∪ col) := by
    rintro ⟨u,v⟩ hp
    obtain ⟨hu,hv,huv⟩ := mem_arcs.mp hp
    by_cases huS : u ∈ S
    · exact mem_union_right _ (mem_union_left _ (mem_filter.mpr ⟨hp,huS⟩))
    by_cases hvS : v ∈ S
    · exact mem_union_right _ (mem_union_right _ (mem_filter.mpr ⟨hp,hvS⟩))
    exact mem_union_left _ (mem_arcs.mpr ⟨mem_sdiff.mpr ⟨hu,huS⟩,mem_sdiff.mpr ⟨hv,hvS⟩,huv⟩)
  have h₁ := card_le_card hsub
  have h₂ := card_union_le (arcs G (U \ S)) (row ∪ col)
  have h₃ := card_union_le row col
  omega

/-- Maximizing an edge-minus-vertex potential performs finite low-degree peeling. -/
lemma exists_min_degree_subset (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) (d : ℝ) :
    ∃ T ⊆ U,
      ((arcs G U).card:ℝ)-d*U.card ≤ (arcs G T).card-d*T.card ∧
      ∀v∈T, d ≤ 2*((neighbors G T v).card:ℝ) := by
  classical
  obtain ⟨T,hT,hmax⟩ := exists_max_image U.powerset
    (fun T => ((arcs G T).card:ℝ)-d*T.card) ⟨U,mem_powerset.mpr Subset.rfl⟩
  have hTU := mem_powerset.mp hT
  refine ⟨T,hTU,hmax U (mem_powerset.mpr Subset.rfl),?_⟩
  intro v hv
  have he := hmax (T.erase v) (mem_powerset.mpr ((erase_subset v T).trans hTU))
  have hl := arcs_remove_bound G T {v} (singleton_subset_iff.mpr hv)
  simp only [sdiff_singleton_eq_erase,sum_singleton] at hl
  have hl' : ((arcs G T).card:ℝ) ≤ (arcs G (T.erase v)).card + 2*((neighbors G T v).card:ℝ) := by
    exact_mod_cast hl
  have hc : ((T.erase v).card:ℝ)+1=T.card := by exact_mod_cast card_erase_add_one hv
  nlinarith

set_option maxHeartbeats 1000000 in
/-- High- and low-degree pruning in a density-maximal finite graph. -/
theorem regularize_local (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V)
    {β C K : ℝ} (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2) (hC : 0 ≤ C) (hK : 0 < K)
    (hKpow : 16 ≤ K^(β-1)) (hm : 0 < (arcs G U).card)
    (hdensity : ((arcs G U).card:ℝ)=C*(U.card:ℝ)^β)
    (hlocal : ∀ W ⊆ U, ((arcs G W).card:ℝ) ≤ C*(W.card:ℝ)^β) :
    ∃ T ⊆ U, ((arcs G U).card:ℝ) ≤ 4*(arcs G T).card ∧
      ∀v∈T, ((arcs G U).card:ℝ) ≤ 8*(U.card:ℝ)*(neighbors G T v).card ∧
        (U.card:ℝ)*(neighbors G T v).card ≤ K*(arcs G U).card := by
  classical
  let m : ℝ := (arcs G U).card
  let n : ℝ := U.card
  have hm' : 0 < m := by dsimp [m]; exact_mod_cast hm
  have hn : 0 < n := by
    dsimp [n]
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hm
    exact_mod_cast card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  let S := U.filter (fun v => K*m < n*(neighbors G U v).card)
  have hS : S ⊆ U := filter_subset _ _
  have hmass : 4*(∑v∈S, ((neighbors G U v).card:ℝ)) ≤ m :=
    high_degree_mass G U hβ1 hβ2 hC hK hKpow hm hdensity hlocal
  have hrem : m ≤ ((arcs G (U \ S)).card:ℝ) + 2*(∑v∈S, ((neighbors G U v).card:ℝ)) := by
    dsimp [m]
    exact_mod_cast arcs_remove_bound G U S hS
  have hrem' : m ≤ 2*((arcs G (U \ S)).card:ℝ) := by linarith
  obtain ⟨T,hTW,hpot,hmin⟩ := exists_min_degree_subset G (U \ S) (m/(4*n))
  have hTU : T ⊆ U := hTW.trans sdiff_subset
  have hd : 0 ≤ m/(4*n) := div_nonneg hm'.le (by positivity)
  have hcard : ((U \ S).card:ℝ) ≤ n := by
    dsimp [n]
    exact_mod_cast card_le_card (sdiff_subset (s := U) (t := S))
  have hdn : m/(4*n)*n = m/4 := by field_simp
  have hpenalty := mul_le_mul_of_nonneg_left hcard hd
  rw [hdn] at hpenalty
  have hTpos : 0 ≤ m/(4*n)*(T.card:ℝ) := by positivity
  refine ⟨T,hTU,?_,?_⟩
  · change m ≤ _
    nlinarith
  · intro v hv
    constructor
    · have h := (div_le_iff₀ (by positivity : 0 < 4*n)).mp (hmin v hv)
      change m ≤ 8*n*(neighbors G T v).card
      nlinarith
    · have hvW := hTW hv
      have hnot : ¬ K*m < n*(neighbors G U v).card := by
        intro h
        exact (mem_sdiff.mp hvW).2 (mem_filter.mpr ⟨hTU hv,h⟩)
      have hdeg : ((neighbors G T v).card:ℝ) ≤ (neighbors G U v).card := by
        exact_mod_cast card_le_card (neighbors_mono G hTU v)
      exact (mul_le_mul_of_nonneg_left hdeg hn.le).trans (le_of_not_gt hnot)

/-- A finite density-maximizing induced subgraph, including the empty-subset
case in its local upper bound. -/
lemma exists_density_max (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V)
    {β : ℝ} (hβ : 0 < β) (hm : 0 < (arcs G S).card) :
    ∃ U ⊆ S, ∃ C : ℝ, 0 < C ∧ 0 < (arcs G U).card ∧
      ((arcs G U).card:ℝ) = C*(U.card:ℝ)^β ∧
      ((arcs G S).card:ℝ) ≤ C*(S.card:ℝ)^β ∧
      ∀ W ⊆ U, ((arcs G W).card:ℝ) ≤ C*(W.card:ℝ)^β := by
  classical
  let f : Finset V → ℝ := fun T => (arcs G T).card / (T.card:ℝ)^β
  have hS : 0 < S.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hm
    exact card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  have hSpow : 0 < (S.card:ℝ)^β := Real.rpow_pos_of_pos (by exact_mod_cast hS) _
  have hfS : 0 < f S := div_pos (by exact_mod_cast hm) hSpow
  obtain ⟨U,hU,hmax⟩ := exists_max_image S.powerset f ⟨S,mem_powerset.mpr Subset.rfl⟩
  have hUS := mem_powerset.mp hU
  have hfU : 0 < f U := hfS.trans_le (hmax S (mem_powerset.mpr Subset.rfl))
  have hUm : 0 < (arcs G U).card := by
    by_contra hn
    have hz : (arcs G U).card=0 := by omega
    simp only [f,hz,Nat.cast_zero,zero_div] at hfU
    exact lt_irrefl _ hfU
  have hUc : 0 < U.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hUm
    exact card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  have hUpow : 0 < (U.card:ℝ)^β := Real.rpow_pos_of_pos (by exact_mod_cast hUc) _
  have hbound (W : Finset V) (hW : W ⊆ S) :
      ((arcs G W).card:ℝ) ≤ f U*(W.card:ℝ)^β := by
    by_cases hz : W.card=0
    · have he : W=∅ := card_eq_zero.mp hz
      subst W
      simp [arcs,Real.zero_rpow (ne_of_gt hβ)]
    · have hw : 0 < (W.card:ℝ)^β := Real.rpow_pos_of_pos (by exact_mod_cast (show 0<W.card by omega)) _
      exact (div_le_iff₀ hw).mp (hmax W (mem_powerset.mpr hW))
  refine ⟨U,hUS,f U,hfU,hUm,?_,hbound S Subset.rfl,fun W hW => hbound W (hW.trans hUS)⟩
  dsimp [f]
  rw [div_mul_cancel₀ _ hUpow.ne']

/-- Regularization retains a fixed fraction of normalized density; its minimum
and maximum degrees differ by at most `8*K`. -/
theorem exists_almost_regular (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V)
    {β K : ℝ} (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2) (hK : 0 < K)
    (hKpow : 16 ≤ K^(β-1)) (hm : 0 < (arcs G S).card) :
    ∃ T ⊆ S, ∃ C d : ℝ, 0 < C ∧ 0 < d ∧ 0 < (arcs G T).card ∧
      ((arcs G S).card:ℝ) ≤ C*(S.card:ℝ)^β ∧
      C*(T.card:ℝ)^β ≤ 4*(arcs G T).card ∧
      ∀ v ∈ T, d ≤ ((neighbors G T v).card:ℝ) ∧
        ((neighbors G T v).card:ℝ) ≤ 8*K*d := by
  classical
  obtain ⟨U,hUS,C,hC,hUm,hden,hSden,hlocal⟩ := exists_density_max G S (β := β) (by linarith) hm
  obtain ⟨T,hTU,harcs,hreg⟩ := regularize_local G U hβ1 hβ2 hC.le hK hKpow hUm hden hlocal
  have hUc : (0:ℝ) < U.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hUm
    exact_mod_cast card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  have hUm' : (0:ℝ) < (arcs G U).card := by exact_mod_cast hUm
  let d : ℝ := (arcs G U).card/(8*(U.card:ℝ))
  have hd : 0 < d := div_pos hUm' (by positivity)
  have hTpos : 0 < (arcs G T).card := by
    have : (0:ℝ) < (arcs G T).card := by linarith
    exact_mod_cast this
  refine ⟨T,hTU.trans hUS,C,d,hC,hd,hTpos,hSden,?_,?_⟩
  · have hcard : (T.card:ℝ) ≤ U.card := by exact_mod_cast card_le_card hTU
    calc
      _ ≤ C*(U.card:ℝ)^β := by gcongr
      _ = (arcs G U).card := hden.symm
      _ ≤ _ := harcs
  · intro v hv
    obtain ⟨hlo,hhi⟩ := hreg v hv
    constructor
    · apply (div_le_iff₀ (by positivity : (0:ℝ) < 8*(U.card:ℝ))).mpr
      nlinarith
    · apply (mul_le_mul_iff_right₀ hUc).mp
      have he : (U.card:ℝ)*(8*K*d) = K*(arcs G U).card := by
        dsimp [d]
        field_simp
        <;> ring
      rw [he]
      simpa only [mul_comm] using hhi

/-- To prove a power-law upper bound it suffices to prove it on almost-regular
induced subgraphs, at the cost of a factor four in the constant. -/
theorem bound_of_almost_regular (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V)
    {β K D : ℝ} (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2) (hK : 0 < K)
    (hKpow : 16 ≤ K^(β-1)) (hD : 0 ≤ D)
    (hbound : ∀ T ⊆ S, ∀ d : ℝ, 0 < d →
      (∀ v ∈ T, d ≤ ((neighbors G T v).card:ℝ) ∧ ((neighbors G T v).card:ℝ) ≤ 8*K*d) →
      ((arcs G T).card:ℝ) ≤ D*(T.card:ℝ)^β) :
    ((arcs G S).card:ℝ) ≤ 4*D*(S.card:ℝ)^β := by
  by_cases hz : (arcs G S).card=0
  · rw [hz,Nat.cast_zero]
    positivity
  obtain ⟨T,hTS,C,d,hC,hd,hTm,hSden,hTden,hreg⟩ :=
    exists_almost_regular G S hβ1 hβ2 hK hKpow (by omega)
  have hTm' : (0:ℝ) < (arcs G T).card := by exact_mod_cast hTm
  have hTpos : (0:ℝ) < T.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hTm
    exact_mod_cast card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  have hTpow := Real.rpow_pos_of_pos hTpos β
  have hb := hbound T hTS d hd hreg
  have hCD : C ≤ 4*D := by nlinarith
  exact hSden.trans (mul_le_mul_of_nonneg_right hCD (Real.rpow_nonneg (Nat.cast_nonneg _) _))

end Erdos571.DensityRegularization

/-! Fourth-walk moments and punctured edge-neighborhoods. -/
namespace Erdos571.FourthMoment
open Finset SimpleGraph DensityRegularization
variable {V : Type*} [DecidableEq V]

def common (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) (u v : V) : Finset V :=
  U.filter (fun w => G.Adj u w ∧ G.Adj v w)

def link (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) (a b : V) : Finset (V × V) :=
  ((neighbors G U b).erase a ×ˢ (neighbors G U a).erase b).filter (fun p => G.Adj p.1 p.2)

def fullLink (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) (a b : V) : Finset (V × V) :=
  (neighbors G U b ×ˢ neighbors G U a).filter (fun p => G.Adj p.1 p.2)

lemma common_moment (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) :
    (∑ p ∈ U ×ˢ U, (common G U p.1 p.2).card) = ∑ v ∈ U, (neighbors G U v).card^2 := by
  have he := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
    (s := U ×ˢ U) (t := U) (fun p v => G.Adj p.1 v ∧ G.Adj p.2 v)
  change (∑ p ∈ U ×ˢ U, (common G U p.1 p.2).card) = _ at he
  rw [he]
  apply sum_congr rfl
  intro v hv
  simp only [bipartiteBelow,filter_product,G.adj_comm,neighbors,card_product,pow_two]

lemma fourth_moment (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) :
    (∑ p ∈ U ×ˢ U, (common G U p.1 p.2).card^2) =
      ∑ e ∈ arcs G U, (fullLink G U e.1 e.2).card := by
  have hc (u v : V) : (common G U u v).card^2 =
      ∑ a ∈ U, ∑ b ∈ U,
        if G.Adj u a ∧ G.Adj v a ∧ G.Adj u b ∧ G.Adj v b then (1:ℕ) else 0 := by
    rw [pow_two,← card_product,common,← filter_product,card_filter,sum_product]
    simp only [and_assoc]
  have hf (a b : V) : (fullLink G U a b).card =
      ∑ u ∈ U, ∑ v ∈ U,
        if G.Adj u b ∧ G.Adj v a ∧ G.Adj u v then (1:ℕ) else 0 := by
    unfold fullLink neighbors
    rw [← filter_product,filter_filter,card_filter,sum_product]
    apply sum_congr rfl
    intro u hu
    apply sum_congr rfl
    intro v hv
    simp only [G.adj_comm b u,G.adj_comm a v,and_assoc]
  simp_rw [hc]
  rw [sum_product]
  conv_lhs => arg 2; ext u; rw [sum_comm]
  rw [sum_comm]
  conv_lhs => arg 2; ext a; arg 2; ext u; rw [sum_comm]
  rw [arcs,sum_filter,sum_product]
  simp_rw [hf]
  apply sum_congr rfl
  intro a ha
  apply sum_congr rfl
  intro u hu
  by_cases h : G.Adj a u
  · simp only [h,ite_true]
    apply sum_congr rfl
    intro b hb
    apply sum_congr rfl
    intro v hv
    simp only [G.adj_comm u a,h,true_and,G.adj_comm v a,G.adj_comm v b,G.adj_comm u b]
    congr 1
    apply propext
    tauto
  · simp only [h,ite_false]
    apply sum_eq_zero
    intro b hb
    apply sum_eq_zero
    intro v hv
    simp [G.adj_comm u a,h]

lemma fullLink_bound (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) (a b : V) :
    (fullLink G U a b).card ≤ (link G U a b).card +
      (neighbors G U a).card + (neighbors G U b).card := by
  let row := {a} ×ˢ neighbors G U a
  let col := neighbors G U b ×ˢ {b}
  have hsub : fullLink G U a b ⊆ link G U a b ∪ (row ∪ col) := by
    rintro ⟨u,v⟩ hp
    obtain ⟨⟨hu,hv⟩,huv⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    by_cases hua : u=a
    · subst u
      exact mem_union_right _ (mem_union_left _ (mem_product.mpr ⟨mem_singleton_self _,hv⟩))
    by_cases hvb : v=b
    · subst v
      exact mem_union_right _ (mem_union_right _ (mem_product.mpr ⟨hu,mem_singleton_self _⟩))
    exact mem_union_left _ (mem_filter.mpr ⟨mem_product.mpr ⟨mem_erase.mpr ⟨hua,hu⟩,mem_erase.mpr ⟨hvb,hv⟩⟩,huv⟩)
  have h₁ := card_le_card hsub
  have h₂ := card_union_le (link G U a b) (row ∪ col)
  have h₃ := card_union_le row col
  have hr : row.card=(neighbors G U a).card := by simp [row]
  have hc : col.card=(neighbors G U b).card := by simp [col]
  omega

lemma sum_arc_degrees (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) :
    (∑ e ∈ arcs G U, ((neighbors G U e.1).card + (neighbors G U e.2).card)) =
      2*∑v∈U, (neighbors G U v).card^2 := by
  have hleft : (∑e∈arcs G U, (neighbors G U e.1).card) = ∑v∈U, (neighbors G U v).card^2 := by
    rw [arcs,sum_filter,sum_product]
    apply sum_congr rfl
    intro v hv
    dsimp only [Prod.fst,Prod.snd]
    rw [← sum_filter,sum_const]
    simp only [neighbors,nsmul_eq_mul,pow_two,Nat.cast_id]
  have hright : (∑e∈arcs G U, (neighbors G U e.2).card) = ∑v∈U, (neighbors G U v).card^2 := by
    rw [arcs,sum_filter,sum_product,sum_comm]
    apply sum_congr rfl
    intro v hv
    simp_rw [G.adj_comm _ v]
    rw [← sum_filter,sum_const]
    simp only [neighbors,nsmul_eq_mul,pow_two,Nat.cast_id]
  rw [sum_add_distrib,hleft,hright,two_mul]

lemma punctured_moment (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V) :
    (∑ p ∈ U ×ˢ U, (common G U p.1 p.2).card^2) ≤
      (∑ e ∈ arcs G U, (link G U e.1 e.2).card) + 2*∑v∈U, (neighbors G U v).card^2 := by
  rw [fourth_moment]
  have h := sum_le_sum (fun e (he : e ∈ arcs G U) => fullLink_bound G U e.1 e.2)
  simp_rw [add_assoc] at h
  rw [sum_add_distrib,sum_arc_degrees] at h
  exact h

/-- Two applications of the second-moment inequality lower-bound the number
of closed four-walks by the fourth power of the minimum degree. -/
lemma fourth_lower (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V)
    (hU : U.Nonempty) {d : ℝ} (hd : 0 ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ)) :
    d^4 ≤ ∑p∈U ×ˢ U, ((common G U p.1 p.2).card:ℝ)^2 := by
  have hcard : (0:ℝ) < U.card := by exact_mod_cast card_pos.mpr hU
  have hsum : (U.card:ℝ)*d^2 ≤ ∑v∈U, ((neighbors G U v).card:ℝ)^2 := by
    calc
      _ = ∑v∈U, d^2 := by simp
      _ ≤ _ := sum_le_sum (fun v hv => pow_le_pow_left₀ hd (hmin v hv) 2)
  have heq : (∑p∈U ×ˢ U, ((common G U p.1 p.2).card:ℝ)) = ∑v∈U, ((neighbors G U v).card:ℝ)^2 := by
    exact_mod_cast common_moment G U
  have hcs := sq_sum_le_card_mul_sum_sq (s := U ×ˢ U)
    (f := fun p => ((common G U p.1 p.2).card:ℝ))
  rw [heq,card_product,Nat.cast_mul] at hcs
  have hsq := pow_le_pow_left₀ (mul_nonneg hcard.le (sq_nonneg d)) hsum 2
  have hfin : (U.card:ℝ)^2*d^4 ≤ (U.card:ℝ)^2*(∑p∈U ×ˢ U, ((common G U p.1 p.2).card:ℝ)^2) := by
    nlinarith
  exact (mul_le_mul_iff_right₀ (sq_pos_of_pos hcard)).mp hfin

/-- An almost-regular host has a fourth-moment bound in terms of its punctured
edge links and a controlled degenerate-walk error. -/
lemma regular_moment (G : SimpleGraph V) [DecidableRel G.Adj] (U : Finset V)
    (hU : U.Nonempty) {d D F : ℝ} (hd : 0 ≤ d) (hD : 0 ≤ D) (hF : 0 ≤ F)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ D)
    (hlink : ∀ e ∈ arcs G U, ((link G U e.1 e.2).card:ℝ) ≤ F) :
    d^4 ≤ (U.card:ℝ)*D*F + 2*(U.card:ℝ)*D^2 := by
  have hlow := fourth_lower G U hU hd (fun v hv => (hdeg v hv).1)
  have hpunct : (∑p∈U ×ˢ U, ((common G U p.1 p.2).card:ℝ)^2) ≤
      (∑e∈arcs G U, ((link G U e.1 e.2).card:ℝ)) + 2*∑v∈U, ((neighbors G U v).card:ℝ)^2 := by
    exact_mod_cast punctured_moment G U
  have he : ((arcs G U).card:ℝ) ≤ U.card*D := by
    have hs : ((arcs G U).card:ℝ) = ∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
    rw [hs]
    calc
      _ ≤ ∑v∈U, D := sum_le_sum (fun v hv => (hdeg v hv).2)
      _ = _ := by simp
  have hl : (∑e∈arcs G U, ((link G U e.1 e.2).card:ℝ)) ≤ (U.card:ℝ)*D*F := by
    calc
      _ ≤ ∑e∈arcs G U, F := sum_le_sum hlink
      _ = (arcs G U).card*F := by simp
      _ ≤ _ := mul_le_mul_of_nonneg_right he hF
  have hs : (∑v∈U, ((neighbors G U v).card:ℝ)^2) ≤ (U.card:ℝ)*D^2 := by
    calc
      _ ≤ ∑v∈U, D^2 := sum_le_sum (fun v hv => pow_le_pow_left₀ (Nat.cast_nonneg _) (hdeg v hv).2 2)
      _ = _ := by simp
  linarith

end Erdos571.FourthMoment

/-! Paired coning for connected, ordinarily forbidden bipartite graphs. -/
set_option maxHeartbeats 1000000

namespace Erdos571.OrdinaryCone
open Finset SimpleGraph DensityRegularization FourthMoment SixCycleCase

def graph {V : Type*} (H : SimpleGraph V) (c : V → Bool) : SimpleGraph (V ⊕ Bool) where
  Adj u v := match u,v with
    | .inl x,.inl y => H.Adj x y
    | .inl x,.inr b => c x ≠ b
    | .inr b,.inl x => b ≠ c x
    | .inr b,.inr d => b ≠ d
  symm := by intro u v h; cases u <;> cases v <;> exact h.symm
  loopless := by intro u; cases u <;> simp

def notEquiv : Bool ≃ Bool where
  toFun := Bool.not
  invFun := Bool.not
  left_inv := Bool.not_not
  right_inv := Bool.not_not

/-- Connected bipartite graphs have a unique two-coloring up to permutation. -/
lemma color_unique {V : Type*} (H : SimpleGraph V) (hH : H.Connected)
    (c d : V → Bool) (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    (hd : ∀{u v}, H.Adj u v → d u ≠ d v) :
    ∃e : Bool ≃ Bool, ∀v, d v=e (c v) := by
  have hadj {u v : V} (h : H.Adj u v) : c u=d u ↔ c v=d v := by
    have h₁ := hc h
    have h₂ := hd h
    cases hcu : c u <;> cases hdu : d u <;> cases hcv : c v <;> cases hdv : d v <;> simp_all
  have hw {u v : V} (p : H.Walk u v) : c u=d u ↔ c v=d v := by
    induction p with
    | nil => rfl
    | cons h p ih => exact (hadj h).trans ih
  obtain ⟨u⟩ := hH.nonempty
  by_cases hu : c u=d u
  · refine ⟨Equiv.refl _,?_⟩
    intro v
    obtain ⟨p⟩ := hH.preconnected u v
    exact ((hw p).mp hu).symm
  · refine ⟨notEquiv,?_⟩
    intro v
    obtain ⟨p⟩ := hH.preconnected u v
    have hv : c v≠d v := fun h => hu ((hw p).mpr h)
    cases hc : c v <;> cases hd : d v <;> simp_all [notEquiv]

/-- A copy in a punctured edge-neighborhood extends to the paired cone.
The copy can occur in either orientation. -/
lemma contains_of_rectangle {V W : Type*} [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    (G : SimpleGraph W) (a b : W) (hab : G.Adj a b)
    (A B : Finset W) (hdis : Disjoint A B)
    (hA : ∀x∈A, x≠a ∧ G.Adj x b) (hB : ∀y∈B, y≠b ∧ G.Adj y a)
    (hf : H ⊑ bipGraph (fun x : A => fun y : B => G.Adj x.val y.val)) :
    graph H c ⊑ G := by
  classical
  obtain ⟨f⟩ := hf
  let P := fun x : A => fun y : B => G.Adj x.val y.val
  let d : V → Bool := fun v => ConePatternIso.color (f v)
  have hd : ∀{u v}, H.Adj u v → d u ≠ d v := fun h => ConePatternIso.proper P (f.toHom.map_adj h)
  obtain ⟨e,he⟩ := color_unique H hH c d hc hd
  let val : A ⊕ B → W := Sum.elim Subtype.val Subtype.val
  have hinj : Function.Injective val := by
    intro x y h
    cases x with
    | inl x =>
      cases y with
      | inl y => exact congrArg Sum.inl (Subtype.ext h)
      | inr y =>
        change x.val=y.val at h
        exact (Finset.disjoint_left.mp hdis x.property (h.symm ▸ y.property)).elim
    | inr x =>
      cases y with
      | inl y =>
        change x.val=y.val at h
        exact (Finset.disjoint_left.mp hdis y.property (h ▸ x.property)).elim
      | inr y => exact congrArg Sum.inr (Subtype.ext h)
  have hnot (x : A ⊕ B) : val x≠a ∧ val x≠b := by
    cases x with
    | inl x => exact ⟨(hA x.val x.property).1,(hA x.val x.property).2.ne⟩
    | inr y => exact ⟨(hB y.val y.property).2.ne,(hB y.val y.property).1⟩
  let root : Bool → W := fun t => if e t then b else a
  have hrinj : Function.Injective root := by
    intro t s h
    apply e.injective
    cases ht : e t <;> cases hs : e s <;> simp_all [root,hab.ne,hab.ne.symm]
  have hroot (x : A ⊕ B) (t : Bool) : val x≠root t := by
    dsimp [root]
    split
    · exact (hnot x).2
    · exact (hnot x).1
  have hcross (v : V) (t : Bool) (h : c v≠t) : G.Adj (val (f v)) (root t) := by
    have hn : d v≠e t := fun heq => h (e.injective ((he v).symm.trans heq))
    dsimp [d] at hn
    cases hf : f v with
    | inl x =>
      have het : e t=true := by
        cases ht : e t <;> simp_all [ConePatternIso.color]
      simpa [root,het,hf,val] using (hA x.val x.property).2
    | inr y =>
      have het : e t=false := by
        cases ht : e t <;> simp_all [ConePatternIso.color]
      simpa [root,het,hf,val] using (hB y.val y.property).2
  refine ⟨{ toHom := { toFun := Sum.elim (fun v => val (f v)) root, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    cases u with
    | inl x =>
      cases v with
      | inl y =>
        have hxy := f.toHom.map_adj h
        change (bipGraph P).Adj (f x) (f y) at hxy
        cases hx : f x <;> cases hy : f y <;>
          simp only [bipGraph,hx,hy] at hxy <;>
          simp only [Sum.elim_inl,val,Sum.elim_inr,hx,hy] <;>
          first | exact hxy | exact hxy.symm | exact hxy.elim
      | inr t => exact hcross x t h
    | inr s =>
      cases v with
      | inl y => exact (hcross y s h.symm).symm
      | inr t =>
        have hn : e s≠e t := fun heq => h (e.injective heq)
        cases hs : e s <;> cases ht : e t <;> simp_all [root,G.adj_comm]
  · apply Sum.elim_injective.mpr
    exact ⟨hinj.comp f.injective,hrinj,fun v t => hroot (f v) t⟩

/-- Ordinary extremal bounds apply to a punctured edge-neighborhood, without
a part-preserving hypothesis on the forbidden graph. -/
lemma link_bound {V W : Type} [Fintype V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    {α C D : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C)
    (hbound : ProjectionHeavy.EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u ≠ g v)
    (hf : (graph H c).Free G) (U : Finset W) (a b : W) (hab : G.Adj a b)
    (hDa : ((neighbors G U a).card:ℝ) ≤ D) (hDb : ((neighbors G U b).card:ℝ) ≤ D) :
    ((link G U a b).card:ℝ) ≤ C*(2*D)^α := by
  classical
  let A := (neighbors G U b).erase a
  let B := (neighbors G U a).erase b
  let P := fun x : A => fun y : B => G.Adj x.val y.val
  have hA (x : W) (hx : x∈A) : x≠a ∧ G.Adj x b :=
    ⟨(mem_erase.mp hx).1,((mem_filter.mp (mem_erase.mp hx).2).2).symm⟩
  have hB (y : W) (hy : y∈B) : y≠b ∧ G.Adj y a :=
    ⟨(mem_erase.mp hy).1,((mem_filter.mp (mem_erase.mp hy).2).2).symm⟩
  have hdis : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro x hxA hxB
    have h₁ := hg ((hA x hxA).2)
    have h₂ := hg ((hB x hxB).2)
    have h₃ := hg hab
    cases hga : g a <;> cases hgb : g b <;> cases hgx : g x <;> simp_all
  have hfree : H.Free (bipGraph P) := fun h => hf (contains_of_rectangle H hH c hc G a b hab A B hdis hA hB h)
  have he := hbound.estimate _ hfree
  have hcard : (Fintype.card (A ⊕ B):ℝ) ≤ 2*D := by
    simp only [Fintype.card_sum,Fintype.card_coe,Nat.cast_add]
    have h₁ : (A.card:ℝ) ≤ (neighbors G U b).card := by exact_mod_cast card_le_card (erase_subset a (neighbors G U b))
    have h₂ : (B.card:ℝ) ≤ (neighbors G U a).card := by exact_mod_cast card_le_card (erase_subset b (neighbors G U a))
    linarith
  let f : (link G U a b) → (bipGraph P).edgeSet := fun p =>
    ⟨s(.inl ⟨p.val.1,(mem_product.mp (mem_filter.mp p.property).1).1⟩,
       .inr ⟨p.val.2,(mem_product.mp (mem_filter.mp p.property).1).2⟩),(mem_filter.mp p.property).2⟩
  have hinj : Function.Injective f := by
    intro p q h
    have heq := congrArg (fun e => e.val) h
    simp only [f,Sym2.eq_iff,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,false_and,or_false] at heq
    apply Subtype.ext
    exact Prod.ext (congrArg Subtype.val heq.1) (congrArg Subtype.val heq.2)
  have hlow : (link G U a b).card ≤ Nat.card (bipGraph P).edgeSet := by
    simpa only [Nat.card_eq_fintype_card,Fintype.card_coe] using Nat.card_le_card_of_injective f hinj
  calc
    _ ≤ (Nat.card (bipGraph P).edgeSet:ℝ) := by exact_mod_cast hlow
    _ ≤ C*(Fintype.card (A ⊕ B):ℝ)^α := he
    _ ≤ _ := mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) hcard hα) hC

end Erdos571.OrdinaryCone

/-! Analytic bounds for paired cones from ordinary extremal bounds. -/
namespace Erdos571.OrdinaryCone
open Finset SimpleGraph DensityRegularization FourthMoment

noncomputable def coefficient (α C Q : ℝ) : ℝ := C*Q*(2*Q)^α+2*Q^2+1

lemma coefficient_one {α C Q : ℝ} (hC : 0 ≤ C) (hQ : 0 ≤ Q) :
    1 ≤ coefficient α C Q := by
  have h := mul_nonneg (mul_nonneg hC hQ) (Real.rpow_nonneg (by positivity : 0 ≤ 2*Q) α)
  unfold coefficient
  nlinarith [sq_nonneg Q]

lemma degree_bound {n d α C Q : ℝ} (hn : 1 ≤ n) (hd : 0 ≤ d)
    (hα1 : 1 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C) (hQ : 0 ≤ Q)
    (hmoment : d^4 ≤ n*(Q*d)*(C*(2*(Q*d))^α) + 2*n*(Q*d)^2) :
    d ≤ (coefficient α C Q)^((3-α)⁻¹)*n^((3-α)⁻¹) := by
  let B := coefficient α C Q
  have hB1 : 1 ≤ B := coefficient_one hC hQ
  have hB : 0 < B := by linarith
  have hn0 : 0 < n := by linarith
  have hr : 0 < 3-α := by linarith
  have he : 0 ≤ (3-α)⁻¹ := (inv_pos.mpr hr).le
  by_cases hd1 : d ≤ 1
  · have h₁ := Real.one_le_rpow hB1 he
    have h₂ := Real.one_le_rpow hn he
    change d ≤ B^((3-α)⁻¹)*n^((3-α)⁻¹)
    nlinarith
  have hd0 : 0 < d := by linarith
  have hd1' : 1 ≤ d := le_of_not_ge hd1
  have hpow : d^2 ≤ d^(α+1) := by
    calc
      _ = d^(2:ℝ) := (Real.rpow_natCast d 2).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hd1' (by linarith)
  have hfirst : n*(Q*d)*(C*(2*(Q*d))^α) = n*(C*Q*(2*Q)^α)*d^(α+1) := by
    rw [show 2*(Q*d)=(2*Q)*d by ring,Real.mul_rpow (by positivity : 0 ≤ 2*Q) hd,
      Real.rpow_add hd0,Real.rpow_one]
    ring
  have hfour : d^4 = d^(α+1)*d^(3-α) := by
    rw [← Real.rpow_add hd0,show α+1+(3-α)=(4:ℝ) by ring]
    norm_num
  have hsecond : 2*n*(Q*d)^2 ≤ n*(2*Q^2)*d^(α+1) := by
    calc
      _ = n*(2*Q^2)*d^2 := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hpow (by positivity)
  have hscalar : d^(3-α) ≤ n*B := by
    apply (mul_le_mul_iff_right₀ (Real.rpow_pos_of_pos hd0 (α+1))).mp
    rw [hfour,hfirst] at hmoment
    have hextra : 0 ≤ n*d^(α+1) := by positivity
    dsimp [B,coefficient]
    nlinarith
  have hh := Real.rpow_le_rpow (Real.rpow_nonneg hd _) hscalar he
  rw [Real.rpow_rpow_inv hd hr.ne',Real.mul_rpow hn0.le hB.le] at hh
  simpa only [mul_comm] using hh

/-- The desired paired-cone exponent follows in an almost-regular bipartite host. -/
theorem regular_bound {V W : Type} [Fintype V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    {α C Q d : ℝ} (hα1 : 1 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C) (hQ : 0 ≤ Q) (hd : 0 < d)
    (hbound : ProjectionHeavy.EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u ≠ g v)
    (hf : (graph H c).Free G) (U : Finset W)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) :
    ((arcs G U).card:ℝ) ≤ Q*(coefficient α C Q)^((3-α)⁻¹)*(U.card:ℝ)^(1+(3-α)⁻¹) := by
  classical
  have hcoef : 0 ≤ coefficient α C Q := (by norm_num : (0:ℝ) ≤ 1).trans (coefficient_one hC hQ)
  by_cases hU : U=∅
  · subst U
    simp only [arcs,product_empty,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hUne : U.Nonempty := nonempty_iff_ne_empty.mpr hU
  have hn : (1:ℝ) ≤ U.card := by exact_mod_cast (show 1≤U.card from card_pos.mpr hUne)
  have hn0 : (0:ℝ) < U.card := by linarith
  have hlinks (e : W × W) (he : e∈arcs G U) :
      ((link G U e.1 e.2).card:ℝ) ≤ C*(2*(Q*d))^α := by
    obtain ⟨ha,hb,hab⟩ := mem_arcs.mp he
    exact link_bound H hH c hc (by linarith) hC hbound G g hg hf U e.1 e.2 hab (hdeg _ ha).2 (hdeg _ hb).2
  have hm := regular_moment G U hUne hd.le (mul_nonneg hQ hd.le) (by positivity) hdeg hlinks
  have hdmax := degree_bound hn hd.le hα1 hα2 hC hQ hm
  have hsum : ((arcs G U).card:ℝ) = ∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  calc
    _ = ∑v∈U, ((neighbors G U v).card:ℝ) := hsum
    _ ≤ ∑v∈U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((coefficient α C Q)^((3-α)⁻¹)*(U.card:ℝ)^((3-α)⁻¹)) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [Real.rpow_add hn0,Real.rpow_one]; ring

/-- Global bipartite paired-cone upper bound. -/
theorem bipartite_bound {V W : Type} [Fintype V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    {α C K : ℝ} (hα1 : 1 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C) (hK : 0 < K)
    (hKpow : 16 ≤ K^((3-α)⁻¹))
    (hbound : ProjectionHeavy.EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u ≠ g v)
    (hf : (graph H c).Free G) (U : Finset W) :
    ((arcs G U).card:ℝ) ≤
      4*(8*K)*(coefficient α C (8*K))^((3-α)⁻¹)*(U.card:ℝ)^(1+(3-α)⁻¹) := by
  have hcoef : 0 ≤ coefficient α C (8*K) := (by norm_num : (0:ℝ) ≤ 1).trans (coefficient_one hC (by positivity))
  have hr : 1 < 3-α := by linarith
  have he : 0 < (3-α)⁻¹ := inv_pos.mpr (by linarith)
  have he1 : (3-α)⁻¹ ≤ 1 := (inv_le_one₀ (by linarith)).mpr hr.le
  have h := bound_of_almost_regular G U
    (β := 1+(3-α)⁻¹) (K := K) (D := (8*K)*(coefficient α C (8*K))^((3-α)⁻¹))
    (by linarith) (by linarith) hK (by simpa using hKpow) (by positivity) ?_
  · convert h using 1 <;> ring
  · intro T hT d hd hdeg
    exact regular_bound H hH c hc hα1 hα2 hC (by positivity) hd hbound G g hg hf T hdeg

/-- A bipartite subgraph keeps at least half the edges. -/
lemma exists_colored_subgraph {W : Type} [Fintype W]
    (G : SimpleGraph W) :
    ∃ F : SimpleGraph W, F ≤ G ∧ ∃g : W → Bool,
      (∀{u v}, F.Adj u v → g u≠g v) ∧
      Nat.card G.edgeSet ≤ 2*Nat.card F.edgeSet := by
  classical
  obtain ⟨A,B,hdis,hAB,hcut⟩ := MaxCut.graph_cut G
  let F := G.between A B
  let E := (A ×ˢ B).filter (fun p => G.Adj p.1 p.2)
  let f : E → F.edgeSet := fun e =>
    ⟨s(e.val.1,e.val.2),⟨(mem_filter.mp e.property).2,
      Or.inl (mem_product.mp (mem_filter.mp e.property).1)⟩⟩
  have hinj : Function.Injective f := by
    intro e f' h
    have he := congrArg Subtype.val h
    simp only [f,Sym2.eq_iff] at he
    rcases he with ⟨h₁,h₂⟩ | ⟨h₁,h₂⟩
    · exact Subtype.ext (Prod.ext h₁ h₂)
    · have hea := (mem_product.mp (mem_filter.mp e.property).1).1
      have hfb := (mem_product.mp (mem_filter.mp f'.property).1).2
      exact (Finset.disjoint_left.mp hdis hea (h₁.symm ▸ hfb)).elim
  have hc : E.card ≤ Nat.card F.edgeSet := by
    simpa only [Nat.card_eq_fintype_card,Fintype.card_coe] using Nat.card_le_card_of_injective f hinj
  refine ⟨F,between_le,(fun w => if w∈A then false else true),?_,?_⟩
  · intro u v h
    rcases h.2 with ⟨hu,hv⟩ | ⟨hu,hv⟩
    · have hvA : v∉A := fun hv' => Finset.disjoint_left.mp hdis hv' hv
      change u∈A at hu
      simp [hu,hvA]
    · have huA : u∉A := fun hu' => Finset.disjoint_left.mp hdis hu' hu
      change v∈A at hv
      simp [huA,hv]
  · have hg : Nat.card G.edgeSet = G.edgeFinset.card := by simp only [Nat.card_eq_fintype_card,card_edgeSet]
    rw [hg]
    exact hcut.trans (Nat.mul_le_mul_left 2 hc)

/-- Paired cones preserve ordinary power-law extremal bounds, with exponent
`α ↦ 1 + 1/(3-α)`. Connectedness permits either orientation in each edge link. -/
theorem edge_bound {V : Type} [Fintype V]
    (H : SimpleGraph V) (hH : H.Connected) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    {α C : ℝ} (hα1 : 1 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C)
    (hbound : ProjectionHeavy.EdgeBound H α C) :
    ∃ D : ℝ, 0 ≤ D ∧ ProjectionHeavy.EdgeBound (graph H c) (1+(3-α)⁻¹) D := by
  let K : ℝ := 16^(3-α)
  have hK : 0 < K := Real.rpow_pos_of_pos (by norm_num) _
  have hr : 0 < 3-α := by linarith
  have hKpow : 16 ≤ K^((3-α)⁻¹) := by
    dsimp [K]
    rw [Real.rpow_rpow_inv (by norm_num) hr.ne']
  let D := 4*(8*K)*(coefficient α C (8*K))^((3-α)⁻¹)
  have hcoef : 0 ≤ coefficient α C (8*K) := (by norm_num : (0:ℝ) ≤ 1).trans (coefficient_one hC (by positivity))
  have hD : 0 ≤ D := by dsimp [D]; positivity
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := exists_colored_subgraph G
  have hfree : (graph H c).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bipartite_bound H hH c hc hα1 hα2 hC hK hKpow hbound F g hg hfree univ
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hneigh (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v
      simp [neighbors]
    simp_rw [hneigh,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.OrdinaryCone

/-! Exact density certificates with ordinary upper bounds on rooted powers. -/
namespace Erdos571
open SimpleGraph Finset

namespace ProjectionHeavy.EdgeBound

lemma mono {V W : Type} {H : SimpleGraph V} {K : SimpleGraph W} {α C : ℝ}
    (h : EdgeBound H α C) (hKH : K ⊑ H) : EdgeBound K α C := by
  constructor
  intro U _ G hf
  exact h.estimate G (fun hHG => hf (hKH.trans hHG))

lemma congr {V W : Type} {H : SimpleGraph V} {K : SimpleGraph W} {α C : ℝ}
    (h : EdgeBound H α C) (e : H ≃g K) : EdgeBound K α C := h.mono e.symm.isContained

lemma extremal_isBigO {V : Type} (H : SimpleGraph V) {α C : ℝ}
    (hC : 0 ≤ C) (h : EdgeBound H α C) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n H:ℝ)) (fun n : ℕ => (n:ℝ)^α) := by
  apply Asymptotics.IsBigO.of_bound C
  filter_upwards [] with n
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Nat.cast_nonneg _),
    abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _)]
  rw [← Fintype.card_fin n,extremalNumber_le_iff_of_nonneg H (by positivity)]
  intro G _ hf
  simpa only [Nat.card_eq_fintype_card,card_edgeSet] using h.estimate G hf

end ProjectionHeavy.EdgeBound

namespace FullRootedPower

def copy {A R : Type*} (H : SimpleGraph (A ⊕ R)) {M : ℕ} (i : Fin M) : H.Copy (graph H M) where
  toHom :=
    { toFun := Sum.map (fun a => (i,a)) id
      map_rel' := by
        intro u v h
        cases u <;> cases v
        · exact ⟨rfl,h⟩
        · exact h
        · exact h
        · exact h }
  injective' := Sum.map_injective.mpr ⟨fun _ _ h => congrArg Prod.snd h,Function.injective_id⟩

lemma connected {A R : Type*} [Nonempty R] (H : SimpleGraph (A ⊕ R))
    (hH : H.Connected) {M : ℕ} (hM : 0 < M) : (graph H M).Connected := by
  obtain ⟨r⟩ := ‹Nonempty R›
  let i : Fin M := ⟨0,hM⟩
  have hroot (v : (Fin M × A) ⊕ R) : (graph H M).Reachable v (.inr r) := by
    cases v with
    | inl x => exact (hH.preconnected (.inl x.2) (.inr r)).map (copy H x.1).toHom
    | inr s => exact (hH.preconnected (.inr s) (.inr r)).map (copy H i).toHom
  exact { preconnected := fun u v => (hroot u).trans (hroot v).symm, nonempty := ⟨.inr r⟩ }

end FullRootedPower

namespace RootedCone

def ordinaryIso {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) :
    OrdinaryCone.graph H c ≃g graph H c where
  toEquiv := Equiv.sumAssoc A R Bool
  map_rel_iff' := by
    intro u v
    rcases u with (a | r) | b <;> rcases v with (a' | r') | b' <;> rfl

lemma connected {A R : Type*} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) :
    (graph H c).Connected := by
  have hroot (v : A ⊕ (R ⊕ Bool)) : (graph H c).Reachable v (.inr (.inr false)) := by
    rcases v with a | (r | b)
    · cases hc : c (.inl a) with
      | false =>
        exact (show (graph H c).Adj (.inl a) (.inr (.inr true)) by simp [graph,hc]).reachable.trans
          (show (graph H c).Adj (.inr (.inr true)) (.inr (.inr false)) by change true ≠ false; decide).reachable
      | true => exact (show (graph H c).Adj (.inl a) (.inr (.inr false)) by simp [graph,hc]).reachable
    · cases hc : c (.inr r) with
      | false =>
        exact (show (graph H c).Adj (.inr (.inl r)) (.inr (.inr true)) by simp [graph,hc]).reachable.trans
          (show (graph H c).Adj (.inr (.inr true)) (.inr (.inr false)) by change true ≠ false; decide).reachable
      | true => exact (show (graph H c).Adj (.inr (.inl r)) (.inr (.inr false)) by simp [graph,hc]).reachable
    · cases b
      · exact Reachable.rfl
      · exact (show (graph H c).Adj (.inr (.inr true)) (.inr (.inr false)) by change true ≠ false; decide).reachable
  exact { preconnected := fun u v => (hroot u).trans (hroot v).symm, nonempty := ⟨.inr (.inr false)⟩ }

end RootedCone

namespace OrdinaryRooted
open RootedSunflower ProjectionHeavy

/-- Upper bounds are required directly for each fixed full rooted power. -/
def Supported {A R : Type} (H : SimpleGraph (A ⊕ R)) (α : ℝ) : Prop :=
  ∀ M : ℕ, 2 ≤ M → ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (FullRootedPower.graph H M) α C

lemma of_rectangular {A R : Type} (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {α : ℝ} (h : SupportedBounds.Supported H c α) : Supported H α := by
  intro M hM
  obtain ⟨P,f,hf⟩ := h M hM
  refine ⟨2*P.C*Fintype.card P.I,?_,(edgeBound_of_pattern P).mono ⟨f⟩⟩
  have hC : 0 ≤ P.C := by have := P.C_one; linarith
  positivity

theorem Supported.cone {A R : Type} [Fintype A] [Fintype R] [Nonempty R]
    {H : SimpleGraph (A ⊕ R)} {c : A ⊕ R → Bool}
    (hH : H.Connected) (hc : ∀{u v}, H.Adj u v → c u ≠ c v)
    {α : ℝ} (h : Supported H α) (hα1 : 1 ≤ α) (hα2 : α < 2) :
    Supported (RootedCone.graph H c) (1+(3-α)⁻¹) := by
  intro M hM
  obtain ⟨C,hC,hbound⟩ := h M hM
  obtain ⟨D,hD,hcone⟩ := OrdinaryCone.edge_bound (FullRootedPower.graph H M)
    (FullRootedPower.connected H hH (by omega)) (FullRootedPower.color c M)
    (FullRootedPower.color_proper H c M hc) hα1 hα2 hC hbound
  rw [FullRootedPower.cone_graph]
  exact ⟨D,hD,hcone.congr (RootedCone.ordinaryIso _ _)⟩

def Certificate (a b : ℕ) : Prop :=
  ∃ (A R : Type) (_ : Fintype A) (_ : Fintype R) (_ : Nonempty A) (_ : Nonempty R)
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool),
    (∀{u v}, H.Adj u v → c u ≠ c v) ∧ H.Connected ∧
    (∀u, ∃v, H.Adj u v) ∧
    (∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) ∧
    Supported H (2-(a:ℝ)/(b:ℝ))

theorem Certificate.cone {a b : ℕ} (h : Certificate a b) (ha : 1 ≤ a) (hab : a ≤ b) :
    Certificate a (b+a) := by
  obtain ⟨A,R,hA,hR,hAn,hRn,H,c,hc,hH,hni,hbal,hs⟩ := h
  letI := hA
  letI := hR
  letI := hAn
  letI := hRn
  refine ⟨A,R ⊕ Bool,inferInstance,inferInstance,inferInstance,inferInstance,
    RootedCone.graph H c,RootedCone.color c,RootedCone.color_proper H c hc,
    RootedCone.connected H c,RootedCone.no_isolated H c hni,RootedCone.balance H c a b hbal,?_⟩
  have hi := SupportedBounds.deficit_interval a b ha hab
  have hs' := hs.cone hH hc hi.1 hi.2
  have he : 1+(3-(2-(a:ℝ)/(b:ℝ)))⁻¹ = 2-(a:ℝ)/(b+a:ℕ) := by
    rw [show 1+(3-(2-(a:ℝ)/(b:ℝ)))⁻¹ = (4-(2-(a:ℝ)/(b:ℝ)))/(3-(2-(a:ℝ)/(b:ℝ))) by
      have hden : 3-(2-(a:ℝ)/(b:ℝ))≠0 := by linarith [hi.2]
      field_simp
      <;> ring]
    exact SupportedBounds.deficit_cone a b (by omega)
  rwa [he] at hs'

theorem Certificate.realizes {a b : ℕ} (h : Certificate a b) (ha : 1 ≤ a) (hab : a ≤ b) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(a:ℚ)/(b:ℚ):ℚ):ℝ)) := by
  classical
  obtain ⟨A,R,hA,hR,hAn,hRn,H,c,hc,hH,hni,hbal,hs⟩ := h
  letI := hA
  letI := hR
  letI := hAn
  letI := hRn
  obtain ⟨M,hM,hl⟩ := FullRootedPower.exact_lower H hni a b (by omega) hab hbal
  obtain ⟨C,hC,hu⟩ := hs M hM
  have hbig := hu.extremal_isBigO _ hC
  let F := FullRootedPower.graph H M
  have hbip : F.IsBipartite := by
    let col : F.Coloring Bool := ⟨FullRootedPower.color c M,FullRootedPower.color_proper H c M hc⟩
    simpa only [Fintype.card_bool] using col.colorable
  let e := Fintype.equivFin ((Fin M × A) ⊕ R)
  refine ⟨_,F.map e.toEmbedding,hbip.map e.toEmbedding,?_⟩
  push_cast
  exact LeafPeeling.isTheta_map F e _ ⟨hbig,hl⟩

theorem base_certificate : Certificate 1 1 := by
  have hconn : SupportedBounds.base.Connected := by
    have hroot (u : Unit ⊕ Unit) : SupportedBounds.base.Reachable u (.inr ()) := by
      cases u with
      | inl u => exact (show SupportedBounds.base.Adj (.inl u) (.inr ()) from trivial).reachable
      | inr u => cases u; exact Reachable.rfl
    exact { preconnected := fun u v => (hroot u).trans (hroot v).symm, nonempty := inferInstance }
  refine ⟨Unit,Unit,inferInstance,inferInstance,inferInstance,inferInstance,
    SupportedBounds.base,ConePatternIso.color,ConePatternIso.proper _,hconn,
    SupportedBounds.base_no_isolated,SupportedBounds.base_balanced,?_⟩
  norm_num
  exact of_rectangular _ _ SupportedBounds.base_supported

end OrdinaryRooted
end Erdos571

/-! Rooted subdivision, retaining subdivisions of root-root edges as roots. -/
namespace Erdos571.RootedSubdivision
open Finset SimpleGraph RootedSunflower

variable {A R : Type*}

abbrev Petal (H : SimpleGraph (A ⊕ R)) := PetalEdge H ∅
abbrev RootEdge (H : SimpleGraph (A ⊕ R)) :=
  {e : H.edgeSet // ¬∃a, a∉(∅:Finset A) ∧ Sum.inl a∈e.val}
abbrev Nonroot (H : SimpleGraph (A ⊕ R)) := A ⊕ Petal H
abbrev Root (H : SimpleGraph (A ⊕ R)) := R ⊕ RootEdge H
abbrev Vertex (H : SimpleGraph (A ⊕ R)) := Nonroot H ⊕ Root H

def toVertex (H : SimpleGraph (A ⊕ R)) : Vertex H → (A ⊕ R) ⊕ H.edgeSet
  | .inl (.inl a) => .inl (.inl a)
  | .inr (.inl r) => .inl (.inr r)
  | .inl (.inr e) => .inr e.val
  | .inr (.inr e) => .inr e.val

noncomputable def vertexEquiv (H : SimpleGraph (A ⊕ R)) : Vertex H ≃ (A ⊕ R) ⊕ H.edgeSet := by
  classical
  exact (Equiv.sumSumSumComm A (Petal H) R (RootEdge H)).trans
    (Equiv.sumCongr (Equiv.refl _) (Equiv.sumCompl (fun e : H.edgeSet => ∃a, a∉(∅:Finset A) ∧ Sum.inl a∈e.val)))

lemma vertexEquiv_apply (H : SimpleGraph (A ⊕ R)) (v : Vertex H) : vertexEquiv H v=toVertex H v := by
  rcases v with (a | e) | (r | e) <;> rfl

lemma toVertex_injective (H : SimpleGraph (A ⊕ R)) : Function.Injective (toVertex H) := by
  intro u v h
  apply (vertexEquiv H).injective
  simpa only [vertexEquiv_apply] using h

def graph (H : SimpleGraph (A ⊕ R)) : SimpleGraph (Vertex H) :=
  (ProjectionHeavy.subdivision H).comap (toVertex H)

noncomputable def iso (H : SimpleGraph (A ⊕ R)) : graph H ≃g ProjectionHeavy.subdivision H where
  toEquiv := vertexEquiv H
  map_rel_iff' := by intro u v; simp only [vertexEquiv_apply]; rfl

def old (H : SimpleGraph (A ⊕ R)) : A ⊕ R → Vertex H
  | .inl a => .inl (.inl a)
  | .inr r => .inr (.inl r)

noncomputable def middle (H : SimpleGraph (A ⊕ R)) (e : H.edgeSet) : Vertex H := by
  classical
  exact if h : ∃a, a∉(∅:Finset A) ∧ Sum.inl a∈e.val then .inl (.inr ⟨e,h⟩) else .inr (.inr ⟨e,h⟩)

lemma toVertex_old (H : SimpleGraph (A ⊕ R)) (v : A ⊕ R) : toVertex H (old H v)=.inl v := by
  cases v <;> rfl

lemma toVertex_middle (H : SimpleGraph (A ⊕ R)) (e : H.edgeSet) : toVertex H (middle H e)=.inr e := by
  classical
  unfold middle
  split <;> rfl

lemma old_injective (H : SimpleGraph (A ⊕ R)) : Function.Injective (old H) := by
  intro u v h
  have h' := congrArg (toVertex H) h
  simpa only [toVertex_old,Sum.inl.injEq] using h'

lemma middle_injective (H : SimpleGraph (A ⊕ R)) : Function.Injective (middle H) := by
  intro e f h
  have h' := congrArg (toVertex H) h
  simpa only [toVertex_middle,Sum.inr.injEq] using h'

lemma old_ne_middle (H : SimpleGraph (A ⊕ R)) (v : A ⊕ R) (e : H.edgeSet) : old H v ≠ middle H e := by
  intro h
  have h' := congrArg (toVertex H) h
  simp only [toVertex_old,toVertex_middle,Sum.inl_ne_inr] at h'

lemma middle_petal (H : SimpleGraph (A ⊕ R)) (e : Petal H) : middle H e.val=.inl (.inr e) := by
  classical
  simp only [middle,dif_pos e.property]

lemma middle_root (H : SimpleGraph (A ⊕ R)) (e : RootEdge H) : middle H e.val=.inr (.inr e) := by
  classical
  simp only [middle,dif_neg e.property]

lemma adj_old_middle (H : SimpleGraph (A ⊕ R)) (v : A ⊕ R) (e : H.edgeSet) :
    (graph H).Adj (old H v) (middle H e) ↔ v∈e.val := by
  change (ProjectionHeavy.subdivision H).Adj (toVertex H (old H v)) (toVertex H (middle H e)) ↔ _
  rw [toVertex_old,toVertex_middle]
  rfl

/-- Each old incidence gives one new edge, with a unique old endpoint and middle vertex. -/
noncomputable def incidenceEdge (H : SimpleGraph (A ⊕ R)) (p : {p : H.edgeSet × (A ⊕ R) // p.2∈p.1.val}) :
    (graph H).edgeSet := ⟨s(old H p.val.2,middle H p.val.1),(adj_old_middle H _ _).mpr p.property⟩

lemma incidenceEdge_injective (H : SimpleGraph (A ⊕ R)) : Function.Injective (incidenceEdge H) := by
  intro p q h
  have he := congrArg Subtype.val h
  simp only [incidenceEdge,Sym2.eq_iff] at he
  rcases he with ⟨hu,he⟩ | ⟨hu,he⟩
  · exact Subtype.ext (Prod.ext (middle_injective H he) (old_injective H hu))
  · exact (old_ne_middle H _ _ hu).elim

lemma exists_endpoint {V : Type*} (e : Sym2 V) : ∃v, v∈e := by
  induction e using Sym2.inductionOn with
  | hf u v => exact ⟨u,by simp⟩

lemma no_isolated (H : SimpleGraph (A ⊕ R)) (hH : ∀u, ∃v, H.Adj u v) :
    ∀u, ∃v, (graph H).Adj u v := by
  intro u
  have hold (v : A ⊕ R) : ∃w, (graph H).Adj (old H v) w := by
    obtain ⟨w,hw⟩ := hH v
    exact ⟨middle H ⟨s(v,w),hw⟩,(adj_old_middle H _ _).mpr (by simp)⟩
  have hmiddle (e : H.edgeSet) : ∃w, (graph H).Adj (middle H e) w := by
    obtain ⟨v,hv⟩ := exists_endpoint e.val
    exact ⟨old H v,((adj_old_middle H _ _).mpr hv).symm⟩
  rcases u with (a | e) | (r | e)
  · exact hold (.inl a)
  · simpa only [middle_petal] using hmiddle e.val
  · exact hold (.inr r)
  · simpa only [middle_root] using hmiddle e.val

noncomputable def color (H : SimpleGraph (A ⊕ R)) : Vertex H → Bool :=
  fun v => ConePatternIso.color (toVertex H v)

lemma color_proper (H : SimpleGraph (A ⊕ R)) :
    ∀{u v}, (graph H).Adj u v → color H u≠color H v := by
  intro u v h
  exact ConePatternIso.proper (ProjectionHeavy.incidence H) h

lemma old_reachable (H : SimpleGraph (A ⊕ R)) {u v : A ⊕ R} (h : H.Reachable u v) :
    (graph H).Reachable (old H u) (old H v) := by
  obtain ⟨p⟩ := h
  induction p with
  | nil => exact Reachable.rfl
  | @cons u w v hu p ih =>
    let e : H.edgeSet := ⟨s(u,w),hu⟩
    have h₁ : (graph H).Adj (old H u) (middle H e) := (adj_old_middle H _ _).mpr (by simp [e])
    have h₂ : (graph H).Adj (old H w) (middle H e) := (adj_old_middle H _ _).mpr (by simp [e])
    exact (h₁.reachable.trans h₂.symm.reachable).trans ih

lemma connected (H : SimpleGraph (A ⊕ R)) (hH : H.Connected) : (graph H).Connected := by
  obtain ⟨r⟩ := hH.nonempty
  have hroot (v : Vertex H) : (graph H).Reachable v (old H r) := by
    have hm (e : H.edgeSet) : (graph H).Reachable (middle H e) (old H r) := by
      obtain ⟨u,hu⟩ := exists_endpoint e.val
      have he := ((adj_old_middle H u e).mpr hu).symm.reachable
      exact he.trans (old_reachable H (hH.preconnected u r))
    rcases v with (a | e) | (s | e)
    · exact old_reachable H (hH.preconnected (.inl a) r)
    · simpa only [middle_petal] using hm e.val
    · exact old_reachable H (hH.preconnected (.inr s) r)
    · simpa only [middle_root] using hm e.val
  exact { preconnected := fun u v => (hroot u).trans (hroot v).symm,nonempty := ⟨old H r⟩ }

end Erdos571.RootedSubdivision

/-! Balance is preserved under subdivision with the correct root assignment. -/
set_option maxHeartbeats 1500000
namespace Erdos571.RootedSubdivision
open Finset SimpleGraph RootedSunflower
attribute [local instance] Classical.propDecidable

variable {A R : Type} [Fintype A] [Fintype R]

lemma endpoints_card (H : SimpleGraph (A ⊕ R)) (e : H.edgeSet) :
    Nat.card {v : A ⊕ R // v∈e.val}=2 := by
  classical
  obtain ⟨e,he⟩ := e
  induction e using Sym2.inductionOn with
  | hf u v =>
    have huv : u≠v := (show H.Adj u v from he).ne
    let f : Bool → {x : A ⊕ R // x∈s(u,v)} := fun t =>
      if t then ⟨u,by simp⟩ else ⟨v,by simp⟩
    have hinj : Function.Injective f := by
      intro t s h
      have h' := congrArg Subtype.val h
      cases t <;> cases s <;> simp_all [f,huv,huv.symm]
    have hsurj : Function.Surjective f := by
      intro x
      rcases Sym2.mem_iff.mp x.property with hx | hx
      · exact ⟨true,Subtype.ext hx.symm⟩
      · exact ⟨false,Subtype.ext hx.symm⟩
    simpa using (Nat.card_congr (Equiv.ofBijective f ⟨hinj,hsurj⟩)).symm

/-- Separate the unpinned old vertices and the unpinned new middle vertices. -/
lemma unpinned_card {B : Type} [Fintype B] (C : Finset (A ⊕ B)) :
    Fintype.card (A ⊕ B)-C.card =
      (univ.filter (fun a : A => Sum.inl a∉C)).card +
      (univ.filter (fun b : B => Sum.inr b∉C)).card := by
  classical
  have h := Fintype.card_congr (Equiv.subtypeSum (p := fun x : A ⊕ B => x∉C))
  rw [Fintype.card_subtype_compl,Fintype.card_coe] at h
  simpa only [Fintype.card_sum,Fintype.card_subtype] using h

lemma old_balance (H : SimpleGraph (A ⊕ R)) (a b : ℕ)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C))
    (C : Finset (Nonroot H)) :
    let X := univ.filter (fun x : A => Sum.inl x∉C)
    let I := univ.filter (fun e : Petal H => ∃x, Sum.inl x∉C ∧ Sum.inl x∈e.val.val)
    b*X.card ≤ a*I.card := by
  classical
  intro X I
  let C₀ := univ.filter (fun x : A => Sum.inl x∈C)
  have hX : Fintype.card A-C₀.card=X.card := by
    have h := card_filter_add_card_filter_not (s:=univ) (fun x : A => Sum.inl x∈C)
    change C₀.card+X.card=univ.card at h
    rw [card_univ] at h
    omega
  let f : I → PetalEdge H C₀ := fun e =>
    ⟨e.val.val,by
      obtain ⟨x,hx,hxe⟩ := (mem_filter.mp e.property).2
      exact ⟨x,by simpa only [C₀,mem_filter,mem_univ,true_and] using hx,hxe⟩⟩
  have hinj : Function.Injective f := by
    intro e f' h
    have hh : e.val.val=f'.val.val := congrArg (fun x : PetalEdge H C₀ => x.val) h
    exact Subtype.ext (Subtype.ext hh)
  have hsurj : Function.Surjective f := by
    intro e
    obtain ⟨x,hx,hxe⟩ := e.property
    have hx' : Sum.inl x∉C := by simpa only [C₀,mem_filter,mem_univ,true_and] using hx
    let ep : Petal H := ⟨e.val,⟨x,notMem_empty x,hxe⟩⟩
    have hep : ep∈I := mem_filter.mpr ⟨mem_univ _,⟨x,hx',hxe⟩⟩
    exact ⟨⟨ep,hep⟩,Subtype.ext rfl⟩
  have he : Nat.card (PetalEdge H C₀)=I.card := by
    have h := Nat.card_congr (Equiv.ofBijective f ⟨hinj,hsurj⟩)
    simpa only [Nat.card_eq_fintype_card,Fintype.card_coe] using h.symm
  simpa only [hX,he] using hbal C₀

lemma new_petal_bound (H : SimpleGraph (A ⊕ R)) (C : Finset (Nonroot H)) :
    let Y := univ.filter (fun e : Petal H => Sum.inr e∉C)
    let I := univ.filter (fun e : Petal H => ∃x, Sum.inl x∉C ∧ Sum.inl x∈e.val.val)
    2*Y.card+(I\Y).card ≤ Nat.card (PetalEdge (graph H) C) := by
  classical
  intro Y I
  let Inc : Petal H → Type := fun e =>
    {v : A ⊕ R // v∈e.val.val ∧ (e∈Y ∨ ∃x, v=Sum.inl x ∧ Sum.inl x∉C)}
  let f : (Σe : Petal H, Inc e) → PetalEdge (graph H) C := fun p =>
    ⟨incidenceEdge H ⟨(p.1.val,p.2.val),p.2.property.1⟩,by
      rcases p.2.property.2 with he | ⟨x,hx,hxC⟩
      · refine ⟨.inr p.1,(mem_filter.mp he).2,?_⟩
        change Sum.inl (Sum.inr p.1)∈s(old H p.2.val,middle H p.1.val)
        rw [middle_petal]
        simp
      · refine ⟨.inl x,hxC,?_⟩
        change Sum.inl (Sum.inl x)∈s(old H p.2.val,middle H p.1.val)
        rw [hx]
        exact Sym2.mem_iff.mpr (Or.inl rfl)⟩
  have hinj : Function.Injective f := by
    rintro ⟨e,v⟩ ⟨e',v'⟩ h
    have h' := incidenceEdge_injective H (congrArg Subtype.val h)
    have he : e=e' := Subtype.ext (congrArg (fun p => p.val.1) h')
    have hv := congrArg (fun p => p.val.2) h'
    subst e'
    exact Sigma.ext rfl (heq_of_eq (Subtype.ext hv))
  have hcard : (∑e : Petal H, Nat.card (Inc e)) ≤ Nat.card (PetalEdge (graph H) C) := by
    simpa only [Nat.card_eq_fintype_card,Fintype.card_sigma] using Nat.card_le_card_of_injective f hinj
  have hY (e : Petal H) (he : e∈Y) : 2 ≤ Nat.card (Inc e) := by
    let eqv : Inc e ≃ {v : A ⊕ R // v∈e.val.val} :=
      { toFun := fun v => ⟨v.val,v.property.1⟩
        invFun := fun v => ⟨v.val,v.property,Or.inl he⟩
        left_inv := by intro v; rfl
        right_inv := by intro v; rfl }
    rw [Nat.card_congr eqv,endpoints_card]
  have hI (e : Petal H) (he : e∈I) : 1 ≤ Nat.card (Inc e) := by
    obtain ⟨x,hxC,hxe⟩ := (mem_filter.mp he).2
    let v : Inc e := ⟨.inl x,hxe,Or.inr ⟨x,rfl,hxC⟩⟩
    letI : Nonempty (Inc e) := ⟨v⟩
    simpa only [Nat.card_eq_fintype_card] using Fintype.card_pos (α := Inc e)
  have hdis : Disjoint Y (I\Y) := disjoint_sdiff_self_right
  calc
    _ = (∑e∈Y, (2:ℕ)) + ∑e∈I\Y, (1:ℕ) := by simp [mul_comm]
    _ ≤ (∑e∈Y, Nat.card (Inc e)) + ∑e∈I\Y, Nat.card (Inc e) :=
      add_le_add (sum_le_sum hY) (sum_le_sum (fun e he => hI e (mem_sdiff.mp he).1))
    _ = ∑e∈Y ∪ (I\Y), Nat.card (Inc e) := (sum_union hdis).symm
    _ ≤ ∑e : Petal H, Nat.card (Inc e) := sum_le_sum_of_subset (subset_univ _)
    _ ≤ _ := hcard

/-- Full subdivision changes balance parameters `(a,b)` to `(a+b,2*b)`. -/
theorem balance (H : SimpleGraph (A ⊕ R)) (a b : ℕ) (hab : a ≤ b)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∀ C : Finset (Nonroot H),
      (2*b)*(Fintype.card (Nonroot H)-C.card) ≤ (a+b)*Nat.card (PetalEdge (graph H) C) := by
  classical
  intro C
  let X := univ.filter (fun x : A => Sum.inl x∉C)
  let Y := univ.filter (fun e : Petal H => Sum.inr e∉C)
  let I := univ.filter (fun e : Petal H => ∃x, Sum.inl x∉C ∧ Sum.inl x∈e.val.val)
  have hOld : b*X.card ≤ a*I.card := old_balance H a b hbal C
  have hNew : 2*Y.card+(I\Y).card ≤ Nat.card (PetalEdge (graph H) C) := new_petal_bound H C
  have hcount : Fintype.card (Nonroot H)-C.card=X.card+Y.card := by
    simpa only [X,Y,← Fintype.card_subtype,← Nat.card_eq_fintype_card] using (unpinned_card C)
  have hI : I.card=(I\Y).card+(I∩Y).card := by
    exact (card_sdiff_add_card_inter I Y).symm
  have ht : (I∩Y).card ≤ Y.card := card_le_card inter_subset_right
  have h₁ := Nat.mul_le_mul_right (I\Y).card hab
  have h₂ := Nat.mul_le_mul_left a ht
  have h₃ := Nat.mul_le_mul_left (a+b) hNew
  rw [hcount]
  rw [hI] at hOld
  nlinarith

end Erdos571.RootedSubdivision

/-! Rooted subdivision powers embed in subdivisions of slightly larger powers. -/
namespace Erdos571.RootedSubdivision
open Finset SimpleGraph RootedSunflower

variable {A R : Type*}

def project (H : SimpleGraph (A ⊕ R)) (M : ℕ) : ((Fin M × A) ⊕ R) → A ⊕ R :=
  Sum.elim (fun x => .inl x.2) Sum.inr

lemma project_copy (H : SimpleGraph (A ⊕ R)) {M : ℕ} (i : Fin M) (v : A ⊕ R) :
    project H M (FullRootedPower.copy H i v)=v := by cases v <;> rfl

def liftEdge (H : SimpleGraph (A ⊕ R)) {M : ℕ} (i : Fin M) (e : H.edgeSet) :
    (FullRootedPower.graph H M).edgeSet := (FullRootedPower.copy H i).toHom.mapEdgeSet e

lemma project_lift (H : SimpleGraph (A ⊕ R)) {M : ℕ} (i : Fin M) (e : H.edgeSet) :
    Sym2.map (project H M) (liftEdge H i e).val=e.val := by
  change Sym2.map (project H M) (Sym2.map (FullRootedPower.copy H i) e.val)=_
  rw [Sym2.map_map]
  have he : project H M ∘ FullRootedPower.copy H i=id := funext (project_copy H i)
  rw [he,Sym2.map_id]
  rfl

lemma lift_project_eq (H : SimpleGraph (A ⊕ R)) {M : ℕ} {i j : Fin M} {e f : H.edgeSet}
    (h : liftEdge H i e=liftEdge H j f) : e=f := by
  apply Subtype.ext
  have h' := congrArg (fun e => Sym2.map (project H M) e.val) h
  simpa only [project_lift] using h'

lemma petal_lift_index (H : SimpleGraph (A ⊕ R)) {M : ℕ} {i j : Fin M} (e f : Petal H)
    (h : liftEdge H i e.val=liftEdge H j f.val) : i=j := by
  obtain ⟨a,_,ha⟩ := e.property
  have hmem : Sum.inl (i,a)∈(liftEdge H j f.val).val := by
    rw [← h]
    exact Sym2.mem_map.mpr ⟨.inl a,ha,rfl⟩
  obtain ⟨v,hv,hvEq⟩ := Sym2.mem_map.mp hmem
  cases v with
  | inl b =>
    change Sum.inl (j,b)=Sum.inl (i,a) at hvEq
    exact (congrArg Prod.fst (Sum.inl.inj hvEq)).symm
  | inr r => exact (Sum.inr_ne_inl hvEq).elim

lemma petal_root_lift_ne (H : SimpleGraph (A ⊕ R)) {M : ℕ} (i j : Fin M)
    (e : Petal H) (f : RootEdge H) : liftEdge H i e.val≠liftEdge H j f.val := by
  intro h
  have he := lift_project_eq H h
  exact f.property (he ▸ e.property)

lemma lift_mem_nonroot (H : SimpleGraph (A ⊕ R)) {M : ℕ} (i j : Fin M) (a : A) (e : H.edgeSet) :
    Sum.inl (i,a)∈(liftEdge H j e).val ↔ i=j ∧ Sum.inl a∈e.val := by
  change Sum.inl (i,a)∈Sym2.map (FullRootedPower.copy H j) e.val ↔ _
  rw [Sym2.mem_map]
  constructor
  · rintro ⟨v,hv,hEq⟩
    cases v with
    | inl b =>
      change Sum.inl (j,b)=Sum.inl (i,a) at hEq
      have he := Sum.inl.inj hEq
      have hij := congrArg Prod.fst he
      have hba : b=a := congrArg Prod.snd he
      exact ⟨hij.symm,hba ▸ hv⟩
    | inr r => exact (Sum.inr_ne_inl hEq).elim
  · rintro ⟨rfl,ha⟩
    exact ⟨.inl a,ha,rfl⟩

lemma lift_mem_root (H : SimpleGraph (A ⊕ R)) {M : ℕ} (j : Fin M) (r : R) (e : H.edgeSet) :
    Sum.inr r∈(liftEdge H j e).val ↔ Sum.inr r∈e.val := by
  change Sum.inr r∈Sym2.map (FullRootedPower.copy H j) e.val ↔ _
  rw [Sym2.mem_map]
  constructor
  · rintro ⟨v,hv,hEq⟩
    cases v with
    | inl b => exact (Sum.inl_ne_inr hEq).elim
    | inr s => exact (Sum.inr.inj hEq) ▸ hv
  · intro hr
    exact ⟨.inr r,hr,rfl⟩

def powerMap (H : SimpleGraph (A ⊕ R)) (M : ℕ) :
    ((Fin M × Nonroot H) ⊕ Root H) → (((Fin (M+1) × A) ⊕ R) ⊕ (FullRootedPower.graph H (M+1)).edgeSet)
  | .inl (i,.inl a) => .inl (.inl (i.succ,a))
  | .inl (i,.inr e) => .inr (liftEdge H i.succ e.val)
  | .inr (.inl r) => .inl (.inr r)
  | .inr (.inr e) => .inr (liftEdge H 0 e.val)

lemma powerMap_injective (H : SimpleGraph (A ⊕ R)) (M : ℕ) : Function.Injective (powerMap H M) := by
  intro u v h
  rcases u with ⟨i,a | e⟩ | (r | e) <;> rcases v with ⟨j,b | f⟩ | (s | f)
  all_goals simp only [powerMap,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,Sum.inr_ne_inl] at h
  all_goals try exact h.elim
  · have hij := Fin.succ_inj.mp (congrArg Prod.fst h)
    have hab : a=b := congrArg Prod.snd h
    subst j b
    rfl
  · have hij := Fin.succ_inj.mp (petal_lift_index H e f h)
    have hef : e=f := Subtype.ext (lift_project_eq H h)
    subst j f
    rfl
  · exact (petal_root_lift_ne H _ _ e f h).elim
  · exact congrArg (fun r => Sum.inr (Sum.inl r)) h
  · exact (petal_root_lift_ne H _ _ f e h.symm).elim
  · exact congrArg (fun e => Sum.inr (Sum.inr e)) (Subtype.ext (lift_project_eq H h))

def powerCopy (H : SimpleGraph (A ⊕ R)) (M : ℕ) :
    (FullRootedPower.graph (graph H) M).Copy (ProjectionHeavy.subdivision (FullRootedPower.graph H (M+1))) where
  toHom :=
    { toFun := powerMap H M
      map_rel' := by
        intro u v h
        rcases u with ⟨i,a | e⟩ | (r | e) <;> rcases v with ⟨j,b | f⟩ | (s | f)
        all_goals change (ProjectionHeavy.subdivision _).Adj (powerMap H M _) (powerMap H M _)
        all_goals simp only [FullRootedPower.graph,graph,SimpleGraph.comap_adj,toVertex,
          ProjectionHeavy.subdivision,SixCycleCase.bipGraph,ProjectionHeavy.incidence] at h
        all_goals try exact h.elim
        all_goals try exact h.2.elim
        · change Sum.inl (i.succ,a)∈(liftEdge H j.succ f.val).val
          exact (lift_mem_nonroot H _ _ _ _).mpr ⟨congrArg Fin.succ h.1,h.2⟩
        · exact (f.property ⟨a,notMem_empty a,h⟩).elim
        · change Sum.inl (j.succ,b)∈(liftEdge H i.succ e.val).val
          exact (lift_mem_nonroot H _ _ _ _).mpr ⟨congrArg Fin.succ h.1.symm,h.2⟩
        · change Sum.inr s∈(liftEdge H i.succ e.val).val
          exact (lift_mem_root H _ _ _).mpr h
        · change Sum.inr r∈(liftEdge H j.succ f.val).val
          exact (lift_mem_root H _ _ _).mpr h
        · change Sum.inr r∈(liftEdge H 0 f.val).val
          exact (lift_mem_root H _ _ _).mpr h
        · exact (e.property ⟨b,notMem_empty b,h⟩).elim
        · change Sum.inr s∈(liftEdge H 0 e.val).val
          exact (lift_mem_root H _ _ _).mpr h }
  injective' := powerMap_injective H M

end Erdos571.RootedSubdivision

/-! The rational-exponent problem reduces to an ordinary subdivision upper bound.
No such upper bound is assumed as an axiom or claimed unconditionally. -/
namespace Erdos571.OrdinaryRooted
open Finset SimpleGraph ProjectionHeavy RootedSunflower

/-- The still-unproved ordinary subdivision upper-bound condition. -/
def SubdivisionUpper : Prop :=
  ∀ (V : Type) (_ : Fintype V) (H : SimpleGraph V) (c : V → Bool),
    H.Connected → (∀{u v}, H.Adj u v → c u≠c v) →
    ∀ α C : ℝ, 1 ≤ α → α < 2 → 0 ≤ C → EdgeBound H α C →
      ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (subdivision H) ((1+α)/2) D

theorem Supported.subdivision (hsub : SubdivisionUpper)
    {A R : Type} [Fintype A] [Fintype R] [Nonempty R]
    {H : SimpleGraph (A ⊕ R)} {c : A ⊕ R → Bool}
    (hH : H.Connected) (hc : ∀{u v}, H.Adj u v → c u≠c v)
    {α : ℝ} (hs : Supported H α) (hα1 : 1 ≤ α) (hα2 : α < 2) :
    Supported (RootedSubdivision.graph H) ((1+α)/2) := by
  classical
  intro M hM
  obtain ⟨C,hC,hbound⟩ := hs (M+1) (by omega)
  obtain ⟨D,hD,hnew⟩ := hsub _ inferInstance (FullRootedPower.graph H (M+1))
    (FullRootedPower.color c (M+1)) (FullRootedPower.connected H hH (by omega))
    (FullRootedPower.color_proper H c (M+1) hc) α C hα1 hα2 hC hbound
  exact ⟨D,hD,hnew.mono ⟨RootedSubdivision.powerCopy H M⟩⟩

theorem Certificate.subdivision (hsub : SubdivisionUpper) {a b : ℕ}
    (h : Certificate a b) (ha : 1 ≤ a) (hab : a ≤ b) : Certificate (a+b) (2*b) := by
  classical
  obtain ⟨A,R,hA,hR,hAn,hRn,H,c,hc,hH,hni,hbal,hs⟩ := h
  letI := hA
  letI := hR
  letI := hAn
  letI := hRn
  refine ⟨RootedSubdivision.Nonroot H,RootedSubdivision.Root H,
    inferInstance,inferInstance,inferInstance,inferInstance,
    RootedSubdivision.graph H,RootedSubdivision.color H,RootedSubdivision.color_proper H,
    RootedSubdivision.connected H hH,RootedSubdivision.no_isolated H hni,
    RootedSubdivision.balance H a b hab hbal,?_⟩
  have hi := SupportedBounds.deficit_interval a b ha hab
  have hs' := hs.subdivision hsub hH hc hi.1 hi.2
  have he : (1+(2-(a:ℝ)/(b:ℝ)))/2 = 2-((a+b:ℕ):ℝ)/((2*b:ℕ):ℝ) := by
    have hb : (b:ℝ)≠0 := by exact_mod_cast (show b≠0 by omega)
    push_cast
    field_simp
    <;> ring
  rwa [he] at hs'

theorem certificate_fraction (hsub : SubdivisionUpper) (d : ℚ) (hd : 0 < d) (hd1 : d ≤ 1) :
    ∃a b : ℕ, 1 ≤ a ∧ a ≤ b ∧ d=(a:ℚ)/(b:ℚ) ∧ Certificate a b := by
  apply rational_deficit_induction
    (P := fun d => ∃a b : ℕ, 1 ≤ a ∧ a ≤ b ∧ d=(a:ℚ)/(b:ℚ) ∧ Certificate a b) ?_ ?_ ?_ d hd hd1
  · exact ⟨1,1,by omega,by omega,by norm_num,base_certificate⟩
  · intro d hd hd1 h
    obtain ⟨a,b,ha,hab,rfl,h⟩ := h
    refine ⟨a,b+a,ha,by omega,?_,h.cone ha hab⟩
    have hb : (b:ℚ)≠0 := by exact_mod_cast (show b≠0 by omega)
    have hba : (b:ℚ)+(a:ℚ)≠0 := by positivity
    push_cast
    rw [one_add_div hb,div_div_div_cancel_right₀ hb]
  · intro d hd hd1 h
    obtain ⟨a,b,ha,hab,rfl,h⟩ := h
    refine ⟨a+b,2*b,by omega,by omega,?_,h.subdivision hsub ha hab⟩
    have hb : (b:ℚ)≠0 := by exact_mod_cast (show b≠0 by omega)
    push_cast
    field_simp
    ring

/-- A conditional reduction to ordinary connected bipartite subdivisions. The
subdivision hypothesis remains a genuine unresolved mathematical input. -/
theorem rational_turan_of_subdivision_upper (hsub : SubdivisionUpper) :
    ∀ α : ℚ, 1 ≤ α → α < 2 →
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        Asymptotics.IsTheta Filter.atTop
          (fun n : ℕ => (extremalNumber n G:ℝ))
          (fun n : ℕ => (n:ℝ)^(α:ℝ)) := by
  intro α hα hα2
  obtain ⟨a,b,ha,hab,he,h⟩ := certificate_fraction hsub (2-α) (by linarith) (by linarith)
  have hex : (2:ℚ)-(a:ℚ)/(b:ℚ)=α := by linarith
  simpa only [hex] using h.realizes ha hab

end Erdos571.OrdinaryRooted


/-! A matching-of-representatives bound for traces of subdivision-free incidences. -/
namespace Erdos571.IncidenceTrace
open Finset SimpleGraph ProjectionHeavy PatternCone SixCycleCase BipartiteCycleBounds

lemma maximal_matching {L R : Type*} [DecidableEq L] [DecidableEq R]
    (E : Finset (L × R)) :
    ∃ M ⊆ E, Set.InjOn Prod.fst (M : Set (L × R)) ∧
      Set.InjOn Prod.snd (M : Set (L × R)) ∧
      ∀ l r, (l,r)∈E → r∉M.image Prod.snd → l∈M.image Prod.fst := by
  classical
  let F : Finset (Finset (L × R)) := E.powerset.filter (fun M : Finset (L × R) => Set.InjOn Prod.fst (M : Set (L × R)) ∧
    Set.InjOn Prod.snd (M : Set (L × R)))
  have hF : F.Nonempty := ⟨∅,by simp [F,Set.InjOn]⟩
  obtain ⟨M,hM,hmax⟩ := exists_max_image F Finset.card hF
  obtain ⟨hME,hL,hR⟩ : M ⊆ E ∧ Set.InjOn Prod.fst (M : Set (L × R)) ∧
      Set.InjOn Prod.snd (M : Set (L × R)) := by
    simpa only [F,mem_filter,mem_powerset] using hM
  refine ⟨M,hME,hL,hR,?_⟩
  intro l r hlr hr
  by_contra hl
  have hnot : (l,r)∉M := fun h => hl (mem_image.mpr ⟨(l,r),h,rfl⟩)
  have hiL : Set.InjOn Prod.fst ((insert (l,r) M : Finset (L × R)) : Set (L × R)) := by
    intro p hp q hq heq
    rcases mem_insert.mp hp with rfl | hp
    · rcases mem_insert.mp hq with rfl | hq
      · rfl
      · exact (hl (mem_image.mpr ⟨q,hq,heq.symm⟩)).elim
    · rcases mem_insert.mp hq with rfl | hq
      · exact (hl (mem_image.mpr ⟨p,hp,heq⟩)).elim
      · exact hL hp hq heq
  have hiR : Set.InjOn Prod.snd ((insert (l,r) M : Finset (L × R)) : Set (L × R)) := by
    intro p hp q hq heq
    rcases mem_insert.mp hp with rfl | hp
    · rcases mem_insert.mp hq with rfl | hq
      · rfl
      · exact (hr (mem_image.mpr ⟨q,hq,heq.symm⟩)).elim
    · rcases mem_insert.mp hq with rfl | hq
      · exact (hr (mem_image.mpr ⟨p,hp,heq⟩)).elim
      · exact hR hp hq heq
  have hc := hmax (insert (l,r) M) (mem_filter.mpr ⟨mem_powerset.mpr (insert_subset hlr hME),hiL,hiR⟩)
  rw [card_insert_of_notMem hnot] at hc
  omega

set_option maxHeartbeats 1200000 in
/-- In a subdivision-free incidence relation, each middle vertex with at least
`|V(H)|` neighbors requires its own edge in an `H`-free representative graph. -/
theorem trace_bound {V L R : Type} [Fintype V] [Fintype L] [DecidableEq L] [DecidableEq R]
    (H : SimpleGraph V) {α C : ℝ} (hbound : EdgeBound H α C)
    (E : Finset (L × R)) (B : Finset R)
    (hf : ¬Contains (incidence H) E univ B) :
    ((B.filter (fun b => Fintype.card V ≤ (nl E univ b).card)).card:ℝ) ≤ C*(Fintype.card L:ℝ)^α := by
  classical
  let O := ((univ : Finset (Sym2 L)) ×ˢ B).filter
    (fun p => ¬p.1.IsDiag ∧ ∀v∈p.1, (v,p.2)∈E)
  obtain ⟨M,hMO,hL,hR,hmax⟩ := maximal_matching O
  let S := M.image Prod.fst
  let Q := fromEdgeSet (S : Set (Sym2 L))
  have hS (e : Sym2 L) (he : e∈S) : ¬e.IsDiag := by
    obtain ⟨p,hp,rfl⟩ := mem_image.mp he
    exact (mem_filter.mp (hMO hp)).2.1
  have hQE : Q.edgeSet=(S : Set (Sym2 L)) := by
    ext e
    simp only [Q,edgeSet_fromEdgeSet,Set.mem_diff,Sym2.mem_diagSet_iff_isDiag]
    exact ⟨fun h => h.1,fun h => ⟨h,hS e h⟩⟩
  have hfind (e : Q.edgeSet) : ∃b, (e.val,b)∈M := by
    have he : e.val∈S := by
      change e.val∈(S:Set (Sym2 L))
      rw [← hQE]
      exact e.property
    obtain ⟨⟨e',b⟩,hp,he⟩ := mem_image.mp he
    dsimp only [Prod.fst] at he
    subst e'
    exact ⟨b,hp⟩
  choose col hcol using hfind
  have hcolinj : Function.Injective col := by
    intro e f h
    have hpair := hR (hcol e) (hcol f) h
    exact Subtype.ext (congrArg Prod.fst hpair)
  have hcolB (e : Q.edgeSet) : col e∈B := (mem_product.mp (mem_filter.mp (hMO (hcol e))).1).2
  have hcolE (e : Q.edgeSet) (v : L) (hv : v∈e.val) : (v,col e)∈E :=
    (mem_filter.mp (hMO (hcol e))).2.2 v hv
  have hQfree : H.Free Q := by
    rintro ⟨f⟩
    let edge := f.toHom.mapEdgeSet
    apply hf
    refine ⟨f,fun e => col (edge e),f.injective,?_,fun _ => mem_univ _,?_,?_⟩
    · exact hcolinj.comp (Hom.mapEdgeSet.injective f.toHom f.injective)
    · exact fun e => hcolB (edge e)
    · intro v e hve
      exact hcolE (edge e) (f v) (Sym2.mem_map.mpr ⟨v,hve,rfl⟩)
  have hgood (b : R) (hb : b∈B) (hdeg : Fintype.card V ≤ (nl E univ b).card) :
      b∈M.image Prod.snd := by
    by_contra hnot
    have hclique (u v : L) (hu : u∈nl E univ b) (hv : v∈nl E univ b) (huv : u≠v) : Q.Adj u v := by
      have ho : (s(u,v),b)∈O := by
        apply mem_filter.mpr
        refine ⟨mem_product.mpr ⟨mem_univ _,hb⟩,?_,?_⟩
        · simpa only [Sym2.isDiag_iff_proj_eq] using huv
        · intro w hw
          rcases Sym2.mem_iff.mp hw with rfl | rfl
          · exact (mem_filter.mp hu).2
          · exact (mem_filter.mp hv).2
      have hs : s(u,v)∈S := hmax _ b ho hnot
      change s(u,v)∈Q.edgeSet
      rw [hQE]
      exact hs
    have hcard : Fintype.card V ≤ Fintype.card (nl E univ b) := by simpa only [Fintype.card_coe] using hdeg
    let f : V ↪ (nl E univ b) := (Function.Embedding.nonempty_of_card_le hcard).some
    apply hQfree
    exact ⟨{ toHom :=
               { toFun := fun v => (f v).val
                 map_rel' := fun {u v} huv => hclique _ _ (f u).property (f v).property
                   (fun he => huv.ne (f.injective (Subtype.ext he))) }
             injective' := Subtype.val_injective.comp f.injective }⟩
  have hcard : (B.filter (fun b => Fintype.card V ≤ (nl E univ b).card)).card ≤ Nat.card Q.edgeSet := by
    have hs : B.filter (fun b => Fintype.card V ≤ (nl E univ b).card) ⊆ M.image Prod.snd := by
      intro b hb
      exact hgood b (mem_filter.mp hb).1 (mem_filter.mp hb).2
    have hcQ : Nat.card Q.edgeSet=S.card := by
      rw [hQE,Nat.card_eq_fintype_card]
      exact Fintype.card_of_finset' (p := (S : Set (Sym2 L))) S (fun _ => Iff.rfl)
    rw [hcQ,show S.card=M.card by exact card_image_of_injOn hL]
    exact (card_le_card hs).trans card_image_le
  exact (show ((B.filter (fun b => Fintype.card V ≤ (nl E univ b).card)).card:ℝ) ≤ Nat.card Q.edgeSet by exact_mod_cast hcard).trans
    (hbound.estimate Q hQfree)

end Erdos571.IncidenceTrace


/-! Weighted vertex sampling for the ordinary subdivision trace bound. -/
namespace Erdos571.IncidenceSampling
open Finset RandomDeletion

lemma weighted_events {X I : Type*} [Fintype X] [DecidableEq I]
    (w : X → ℝ) (S : Finset I) (B : X → I → Prop) [DecidableRel B]
    (ρ : ℝ) (hρ : 0 ≤ ρ)
    (hone : ∀e∈S, (∑x, w x*(if B x e then (1:ℝ) else 0))=ρ)
    (htwo : ∀e∈S, ∀f∈S, e≠f → (∑x, w x*(if B x e ∧ B x f then (1:ℝ) else 0))=ρ^2) :
    let count := fun x => ∑e∈S, if B x e then (1:ℝ) else 0
    (∑x, w x*count x) = S.card*ρ ∧
    (∑x, w x*(count x)^2) ≤ (S.card*ρ)^2+S.card*ρ := by
  classical
  intro count
  constructor
  · dsimp only [count]
    simp_rw [mul_sum]
    rw [sum_comm]
    calc
      _ = ∑e∈S, ρ := sum_congr rfl (fun e he => hone e he)
      _ = _ := by simp
  · have hpair (e : I) (he : e∈S) (f : I) (hf : f∈S) :
        (∑x, w x*(if B x e then (1:ℝ) else 0)*(if B x f then (1:ℝ) else 0)) ≤
          ρ^2+(if e=f then ρ else 0) := by
      have hi (x : X) : w x*(if B x e then (1:ℝ) else 0)*(if B x f then (1:ℝ) else 0) =
          w x*(if B x e ∧ B x f then (1:ℝ) else 0) := by split_ifs <;> simp_all
      simp_rw [hi]
      by_cases hef : e=f
      · subst f
        simp only [and_self,hone e he,if_true]
        nlinarith [sq_nonneg ρ]
      · rw [htwo e he f hf hef,if_neg hef,add_zero]
    have heq (x : X) : w x*(count x)^2 =
        ∑e∈S, ∑f∈S, w x*(if B x e then (1:ℝ) else 0)*(if B x f then (1:ℝ) else 0) := by
      dsimp [count]
      rw [pow_two]
      simp only [mul_sum,sum_mul,mul_assoc]
      exact sum_congr rfl (fun _ _ => sum_congr rfl (fun _ _ => by ring))
    simp_rw [heq]
    rw [sum_comm]
    conv_lhs => arg 2; ext e; rw [sum_comm]
    calc
      _ ≤ ∑e∈S, ∑f∈S, (ρ^2+(if e=f then ρ else 0)) :=
        sum_le_sum (fun e he => sum_le_sum (fun f hf => hpair e he f hf))
      _ = _ := by
        simp only [sum_add_distrib,sum_const,nsmul_eq_mul,sum_ite_eq]
        simp only [sum_ite_mem,inter_self,sum_const,nsmul_eq_mul]
        ring

lemma sampled_moments {I : Type*} [Fintype I] [DecidableEq I]
    (p : ℝ) (hp : 0 ≤ p) (S : Finset I) :
    (∑b : I → Bool, weight p b*((S.filter (fun i => b i=true)).card:ℝ))=S.card*p ∧
    (∑b : I → Bool, weight p b*((S.filter (fun i => b i=true)).card:ℝ)^2) ≤
      (S.card*p)^2+S.card*p := by
  classical
  have h := weighted_events (weight p) S (fun b i => b i=true) p hp ?_ ?_
  · have hc (b : I → Bool) : ((S.filter (fun i => b i=true)).card:ℝ) =
        ∑i∈S, if b i=true then (1:ℝ) else 0 := by
      exact (sum_boole (fun i => b i=true) S).symm
    simpa only [← hc] using h
  · intro e he
    simpa only [mem_singleton,forall_eq,card_singleton,pow_one] using pattern_weight p {e}
  · intro e he f _hf hef
    simpa only [mem_insert,mem_singleton,forall_eq_or_imp,forall_eq,card_insert_of_notMem
      (show e∉({f}:Finset I) by simpa using hef),card_singleton] using pattern_weight p {e,f}

/-- Weighted Paley--Zygmund at a fixed threshold. -/
lemma mass_large {X : Type*} [Fintype X] (w f : X → ℝ) (hw : ∀x, 0 ≤ w x)
    (hws : ∑x,w x=1) {μ : ℝ} (hμ : 0 < μ) (hf : ∀x, 0 ≤ f x)
    (hfirst : ∑x,w x*f x=μ) (hsecond : ∑x,w x*(f x)^2 ≤ 2*μ^2) :
    (1:ℝ)/8 ≤ ∑x, w x*(if μ/2 ≤ f x then (1:ℝ) else 0) := by
  classical
  let A := univ.filter (fun x => μ/2 ≤ f x)
  let s : ℝ := ∑x∈A, w x
  let t : ℝ := ∑x∈A, w x*f x
  have hs : 0 ≤ s := sum_nonneg (fun x _ => hw x)
  have ht : μ/2 ≤ t := by
    have hsmall : ∑x∈univ\A, w x*f x ≤ μ/2 := by
      calc
        _ ≤ ∑x∈univ\A, w x*(μ/2) := sum_le_sum (fun x hx => by
          apply mul_le_mul_of_nonneg_left _ (hw x)
          have hn : ¬μ/2 ≤ f x := fun h => (mem_sdiff.mp hx).2 (mem_filter.mpr ⟨mem_univ _,h⟩)
          exact (lt_of_not_ge hn).le)
        _ ≤ ∑x, w x*(μ/2) := sum_le_sum_of_subset_of_nonneg (subset_univ _)
          (fun x _ _ => mul_nonneg (hw x) (by positivity))
        _ = μ/2 := by rw [← sum_mul,hws,one_mul]
    have hsplit := sum_sdiff (subset_univ A) (f:=fun x => w x*f x)
    rw [hfirst] at hsplit
    dsimp [t]
    linarith
  have hcs : t^2 ≤ s*(∑x∈A,w x*(f x)^2) := by
    have h := sum_mul_sq_le_sq_mul_sq A (fun x => Real.sqrt (w x)) (fun x => Real.sqrt (w x)*f x)
    have h₁ (x : X) : Real.sqrt (w x)*(Real.sqrt (w x)*f x)=w x*f x := by
      rw [← mul_assoc,← pow_two,Real.sq_sqrt (hw x)]
    have h₂ (x : X) : (Real.sqrt (w x)*f x)^2=w x*(f x)^2 := by rw [mul_pow,Real.sq_sqrt (hw x)]
    simpa only [h₁,h₂,Real.sq_sqrt (hw _)] using h
  have hb : ∑x∈A,w x*(f x)^2 ≤ 2*μ^2 :=
    (sum_le_sum_of_subset_of_nonneg (subset_univ A) (fun x _ _ => mul_nonneg (hw x) (sq_nonneg _))).trans hsecond
  have hprod := mul_le_mul_of_nonneg_left hb hs
  have hs8 : (1:ℝ)/8 ≤ s := by
    have hsq := pow_le_pow_left₀ (by positivity : 0 ≤ μ/2) ht 2
    nlinarith [sq_pos_of_pos hμ]
  have heq : (∑x,w x*(if μ/2 ≤ f x then (1:ℝ) else 0))=s := by
    dsimp [s,A]
    rw [sum_filter]
    apply sum_congr rfl
    intro x _
    split_ifs <;> simp
  rwa [heq]

/-- Every set with expected sampled size at least `2*k` exceeds `k` with
probability at least one eighth. -/
lemma sampled_large {I : Type*} [Fintype I] [DecidableEq I]
    (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) (S : Finset I) (k : ℕ)
    (hk : 1 ≤ k) (hmean : 2*(k:ℝ) ≤ S.card*p) :
    (1:ℝ)/8 ≤ ∑b : I → Bool, weight p b*(if k ≤ (S.filter (fun i => b i=true)).card then (1:ℝ) else 0) := by
  classical
  let μ : ℝ := S.card*p
  have hμ1 : 1 ≤ μ := by
    have hk' : (1:ℝ) ≤ k := by exact_mod_cast hk
    dsimp [μ]
    linarith
  obtain ⟨hfirst,hsecond⟩ := sampled_moments p hp S
  have hsecond' : (∑b : I → Bool, weight p b*((S.filter (fun i => b i=true)).card:ℝ)^2) ≤ 2*μ^2 := by
    have hμpos : 0 ≤ μ := by linarith
    dsimp [μ] at *
    nlinarith
  have h := mass_large (weight p) (fun b => ((S.filter (fun i => b i=true)).card:ℝ))
    (weight_nonneg hp hp1) (sum_weight p) (by linarith : 0 < μ) (fun _ => Nat.cast_nonneg _) hfirst hsecond'
  apply h.trans
  apply sum_le_sum
  intro b hb
  apply mul_le_mul_of_nonneg_left _ (weight_nonneg hp hp1 b)
  split_ifs with hreal hnat hnat
  · rfl
  · exfalso
    apply hnat
    have : (k:ℝ) ≤ (S.filter (fun i => b i=true)).card := by dsimp [μ] at hreal; linarith
    exact_mod_cast this
  · norm_num
  · rfl

/-- The sampled size has a controlled moment of every order between zero and two. -/
lemma sampled_rpow {I : Type*} [Fintype I] [DecidableEq I]
    (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) (S : Finset I) {α : ℝ}
    (hα0 : 0 ≤ α) (hα2 : α ≤ 2) (hmean : 1 ≤ S.card*p) :
    (∑b : I → Bool, weight p b*((S.filter (fun i => b i=true)).card:ℝ)^α) ≤
      2*(S.card*p)^α := by
  classical
  let μ : ℝ := S.card*p
  have hμ : 0 < μ := by dsimp [μ]; linarith
  have hsecond := (sampled_moments p hp S).2
  have hsecond' : (∑b : I → Bool, weight p b*((S.filter (fun i => b i=true)).card:ℝ)^2) ≤ 2*μ^2 := by
    dsimp [μ] at *
    nlinarith
  have hj := (Real.concaveOn_rpow (show 0 ≤ α/2 by linarith) (show α/2 ≤ 1 by linarith)).le_map_sum
    (t:=univ) (w:=weight p) (p:=fun b : I → Bool => ((S.filter (fun i => b i=true)).card:ℝ)^2)
    (fun b _ => weight_nonneg hp hp1 b) (sum_weight p) (fun b _ => by
      exact Set.mem_Ici.mpr (sq_nonneg _))
  simp only [smul_eq_mul] at hj
  have he (b : I → Bool) : (((S.filter (fun i => b i=true)).card:ℝ)^2)^(α/2) =
      ((S.filter (fun i => b i=true)).card:ℝ)^α := by
    rw [← Real.rpow_natCast_mul (Nat.cast_nonneg _)]
    congr 1
    push_cast
    ring
  simp only [he] at hj
  have hh := Real.rpow_le_rpow (sum_nonneg (fun b _ => mul_nonneg (weight_nonneg hp hp1 b) (sq_nonneg _)))
    hsecond' (show 0 ≤ α/2 by linarith)
  have hbound : (2*μ^2)^(α/2) ≤ 2*μ^α := by
    rw [Real.mul_rpow (by norm_num : (0:ℝ) ≤ 2) (sq_nonneg _),← Real.rpow_natCast_mul hμ.le]
    have hexp : (2:ℝ)*(α/2)=α := by ring
    norm_num only [Nat.cast_ofNat] at *
    rw [hexp]
    have htwo : (2:ℝ)^(α/2) ≤ 2 := Real.rpow_le_self_of_one_le (by norm_num) (by linarith)
    exact mul_le_mul_of_nonneg_right htwo (Real.rpow_nonneg hμ.le _)
  exact hj.trans (hh.trans hbound)

end Erdos571.IncidenceSampling


/-! Unconditional degree bounds from incidence traces and vertex sampling. -/
namespace Erdos571.IncidenceDegreeBound
open Finset SimpleGraph ProjectionHeavy PatternCone BipartiteCycleBounds IncidenceSampling RandomDeletion

lemma trace_on {V L R : Type} [Fintype V] [DecidableEq L] [DecidableEq R]
    (H : SimpleGraph V) {α C : ℝ} (hbound : EdgeBound H α C)
    (E : Finset (L × R)) (A S : Finset L) (B : Finset R) (hS : S ⊆ A)
    (hf : ¬Contains (incidence H) E A B) :
    ((B.filter (fun b => Fintype.card V ≤ (nl E S b).card)).card:ℝ) ≤ C*(S.card:ℝ)^α := by
  classical
  let E' : Finset (S × R) := (univ ×ˢ B).filter (fun p => (p.1.val,p.2)∈E)
  have hf' : ¬Contains (incidence H) E' univ B := by
    rintro ⟨f,g,hfinj,hginj,hfA,hgB,hadj⟩
    apply hf
    refine ⟨fun v => (f v).val,g,Subtype.val_injective.comp hfinj,hginj,
      fun v => hS (f v).property,hgB,?_⟩
    intro v e hve
    exact (mem_filter.mp (hadj v e hve)).2
  have hc (b : R) (hb : b∈B) : (nl E' univ b).card=(nl E S b).card := by
    apply card_bij (fun p _ => p.val)
    · intro p hp
      exact mem_filter.mpr ⟨p.property,(mem_filter.mp (mem_filter.mp hp).2).2⟩
    · intro p hp q hq he
      exact Subtype.ext he
    · intro p hp
      refine ⟨⟨p,(mem_filter.mp hp).1⟩,?_,rfl⟩
      exact mem_filter.mpr ⟨mem_univ _,mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,hb⟩,(mem_filter.mp hp).2⟩⟩
  have hgood : B.filter (fun b => Fintype.card V ≤ (nl E' univ b).card) =
      B.filter (fun b => Fintype.card V ≤ (nl E S b).card) := by
    apply filter_congr
    intro b hb
    rw [hc b hb]
  have h := IncidenceTrace.trace_bound H hbound E' B hf'
  rw [hgood,Fintype.card_coe] at h
  exact h

/-- If every middle vertex has at least `d` neighbors, sampling the left side
at rate `2 |V(H)| / d` turns the trace bound into a cardinality estimate. -/
theorem degree_inequality {V L R : Type} [Fintype V] [Nonempty V] [Fintype L]
    [DecidableEq L] [DecidableEq R]
    (H : SimpleGraph V) {α C d : ℝ} (hbound : EdgeBound H α C)
    (hα0 : 0 ≤ α) (hα2 : α ≤ 2) (hC : 0 ≤ C)
    (E : Finset (L × R)) (A : Finset L) (B : Finset R)
    (hf : ¬Contains (incidence H) E A B)
    (hd : 2*(Fintype.card V:ℝ) ≤ d)
    (hdeg : ∀b∈B, d ≤ (nl E A b).card) :
    (B.card:ℝ) ≤ 16*C*(2*(Fintype.card V:ℝ)*(A.card:ℝ)/d)^α := by
  classical
  have hh : (1:ℝ) ≤ Fintype.card V := by exact_mod_cast Fintype.card_pos
  have hd0 : 0 < d := by linarith
  let p : ℝ := 2*(Fintype.card V:ℝ)/d
  have hp : 0 ≤ p := by dsimp [p]; positivity
  have hp1 : p ≤ 1 := by dsimp [p]; exact (div_le_one hd0).mpr hd
  by_cases hB : B.Nonempty
  swap
  · have hBe : B=∅ := not_nonempty_iff_eq_empty.mp hB
    rw [hBe,card_empty,Nat.cast_zero]
    positivity
  obtain ⟨b₀,hb₀⟩ := hB
  have hmean (b : R) (hb : b∈B) : 2*(Fintype.card V:ℝ) ≤ (nl E A b).card*p := by
    dsimp [p]
    rw [← mul_div_assoc]
    apply (le_div_iff₀ hd0).mpr
    nlinarith [hdeg b hb]
  have hA : d ≤ A.card := (hdeg b₀ hb₀).trans (by exact_mod_cast card_le_card (filter_subset (fun a => (a,b₀)∈E) A))
  have hmeanA : 1 ≤ A.card*p := by
    have hle : ((nl E A b₀).card:ℝ)*p ≤ A.card*p := mul_le_mul_of_nonneg_right
      (by exact_mod_cast card_le_card (filter_subset (fun a => (a,b₀)∈E) A)) hp
    have hm := hmean b₀ hb₀
    linarith
  let S : (L → Bool) → Finset L := fun f => A.filter (fun a => f a=true)
  have hneigh (f : L → Bool) (b : R) : nl E (S f) b = (nl E A b).filter (fun a => f a=true) := by
    ext a
    simp only [nl,S,mem_filter]
    tauto
  have hlarge (b : R) (hb : b∈B) : (1:ℝ)/8 ≤ ∑f : L → Bool, weight p f*
      (if Fintype.card V ≤ (nl E (S f) b).card then (1:ℝ) else 0) := by
    simp_rw [hneigh]
    exact sampled_large p hp hp1 (nl E A b) (Fintype.card V) (by exact_mod_cast hh) (hmean b hb)
  have hgood (f : L → Bool) : ((B.filter (fun b => Fintype.card V ≤ (nl E (S f) b).card)).card:ℝ) =
      ∑b∈B, if Fintype.card V ≤ (nl E (S f) b).card then (1:ℝ) else 0 :=
    (sum_boole _ _).symm
  have hcount : (B.card:ℝ)/8 ≤ ∑f : L → Bool, weight p f*
      ((B.filter (fun b => Fintype.card V ≤ (nl E (S f) b).card)).card:ℝ) := by
    calc
      _ = ∑b∈B, (1:ℝ)/8 := by simp; ring
      _ ≤ ∑b∈B, ∑f : L → Bool, weight p f*
          (if Fintype.card V ≤ (nl E (S f) b).card then (1:ℝ) else 0) := sum_le_sum hlarge
      _ = _ := by simp_rw [hgood,mul_sum]; rw [sum_comm]
  have hupper : (∑f : L → Bool, weight p f*
      ((B.filter (fun b => Fintype.card V ≤ (nl E (S f) b).card)).card:ℝ)) ≤
      C*(2*(A.card*p)^α) := by
    calc
      _ ≤ ∑f : L → Bool, weight p f*(C*(S f).card^α) := sum_le_sum (fun f _ =>
        mul_le_mul_of_nonneg_left (trace_on H hbound E A (S f) B (filter_subset _ _) hf) (weight_nonneg hp hp1 f))
      _ = C*(∑f : L → Bool, weight p f*(S f).card^α) := by rw [mul_sum]; congr 1; funext f; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (sampled_rpow p hp hp1 A hα0 hα2 hmeanA) hC
  have he : A.card*p=2*(Fintype.card V:ℝ)*(A.card:ℝ)/d := by dsimp [p]; ring
  rw [he] at hupper
  linarith

/-- A numerical form of the degree estimate, uniform also at `α = 1`. -/
lemma degree_bound {h n a b d α C : ℝ} (hh : 1 ≤ h) (hn : 1 ≤ n)
    (ha0 : 0 ≤ a) (han : a ≤ n) (hb : n ≤ 2*b) (hd : 0 ≤ d)
    (hα1 : 1 ≤ α) (hC : 0 ≤ C)
    (htrace : 2*h ≤ d → b ≤ 16*C*(2*h*a/d)^α) :
    d ≤ (2*h+(32*C*(2*h)^α)^(α⁻¹))*n^(1-α⁻¹) := by
  have hn0 : 0 < n := by linarith
  have hα0 : 0 < α := by linarith
  have hi0 : 0 ≤ α⁻¹ := (inv_pos.mpr hα0).le
  have hi1 : α⁻¹ ≤ 1 := (inv_le_one₀ hα0).mpr hα1
  have hnγ : 1 ≤ n^(1-α⁻¹) := Real.one_le_rpow hn (by linarith)
  have hcoeff : 0 ≤ (32*C*(2*h)^α)^(α⁻¹) := by positivity
  by_cases hdsmall : d ≤ 2*h
  · nlinarith
  have hd0 : 0 < d := by linarith
  have htr := htrace (by linarith)
  have hnpow : b ≤ 16*C*(2*h*n/d)^α := by
    apply htr.trans
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    apply Real.rpow_le_rpow (by positivity) _ hα0.le
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left han (by positivity)) hd
  have heq : (2*h*n/d)^α = (2*h)^α*n^α/d^α := by
    rw [Real.div_rpow (by positivity) hd,Real.mul_rpow (by positivity) hn0.le]
  rw [heq,← mul_div_assoc] at hnpow
  have hmul := (le_div_iff₀ (Real.rpow_pos_of_pos hd0 α)).mp hnpow
  have hnex : n^α=n*n^(α-1) := by
    calc
      _ = n^(1+(α-1)) := by congr 1; ring
      _ = _ := by rw [Real.rpow_add hn0,Real.rpow_one]
  have hmain : d^α ≤ (32*C*(2*h)^α)*n^(α-1) := by
    apply (mul_le_mul_iff_right₀ hn0).mp
    have hbmul := mul_le_mul_of_nonneg_right hb (Real.rpow_nonneg hd α)
    rw [hnex] at hmul
    nlinarith
  have hroot := Real.rpow_le_rpow (Real.rpow_nonneg hd α) hmain hi0
  rw [Real.rpow_rpow_inv hd hα0.ne',Real.mul_rpow (by positivity) (by positivity),
    ← Real.rpow_mul hn0.le] at hroot
  have hex : (α-1)*α⁻¹=1-α⁻¹ := by field_simp
  rw [hex] at hroot
  have : 0 ≤ 2*h*n^(1-α⁻¹) := by positivity
  nlinarith

end Erdos571.IncidenceDegreeBound


/-! Turning minimum-degree obstructions into global edge bounds. -/
namespace Erdos571.DensityRegularization
open Finset SimpleGraph

/-- Low-degree peeling transfers an induced-subgraph minimum-degree bound to a
global bound. Unlike almost-regular reduction, this also works at exponent one. -/
theorem bound_of_min_degree {V : Type*} [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V)
    {γ D : ℝ} (hγ : 0 ≤ γ) (hD : 0 ≤ D)
    (hbound : ∀T ⊆ S, T.Nonempty → ∀d : ℝ, 0 < d →
      (∀v∈T, d ≤ ((neighbors G T v).card:ℝ)) →
      d ≤ D*(T.card:ℝ)^γ) :
    ((arcs G S).card:ℝ) ≤ 4*D*(S.card:ℝ)^(1+γ) := by
  by_cases hm : (arcs G S).card=0
  · rw [hm,Nat.cast_zero]
    positivity
  have hm0 : (0:ℝ) < (arcs G S).card := by exact_mod_cast (show 0<(arcs G S).card by omega)
  have hn0 : (0:ℝ) < S.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp (show 0<(arcs G S).card by omega)
    exact_mod_cast card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  let d : ℝ := (arcs G S).card/(4*S.card)
  have hd : 0 < d := by dsimp [d]; positivity
  obtain ⟨T,hTS,hpot,hdeg⟩ := exists_min_degree_subset G S (2*d)
  have hdEq : 4*(S.card:ℝ)*d=(arcs G S).card := by
    dsimp [d]
    field_simp
  have hT : T.Nonempty := by
    by_contra hnot
    have he : T=∅ := not_nonempty_iff_eq_empty.mp hnot
    have harcs : arcs G T=∅ := by simp [he,arcs]
    rw [harcs,he,card_empty,Nat.cast_zero] at hpot
    nlinarith
  have hb := hbound T hTS hT d hd (fun v hv => by have h := hdeg v hv; linarith)
  have hn : (T.card:ℝ) ≤ S.card := by exact_mod_cast card_le_card hTS
  have hdN : d ≤ D*(S.card:ℝ)^γ := hb.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow (Nat.cast_nonneg _) hn hγ) hD)
  rw [Real.rpow_add hn0,Real.rpow_one]
  nlinarith

end Erdos571.DensityRegularization


/-! An unconditional but nonsharp ordinary subdivision upper transfer. -/
namespace Erdos571.WeakSubdivisionUpper
open Finset SimpleGraph ProjectionHeavy PatternCone BipartiteCycleBounds DensityRegularization

noncomputable def coefficient (h : ℕ) (α C : ℝ) : ℝ :=
  2*h+(32*C*(2*h)^α)^(α⁻¹)

lemma coefficient_nonneg {h : ℕ} {α C : ℝ} (hC : 0 ≤ C) : 0 ≤ coefficient h α C := by
  unfold coefficient
  positivity

lemma exists_large_color {W : Type*} [DecidableEq W] (T : Finset W) (g : W → Bool) :
    ∃t : Bool, T.card ≤ 2*(T.filter (fun v => g v=t)).card := by
  have h := card_filter_add_card_filter_not (s:=T) (fun v => g v=true)
  simp only [Bool.eq_false_eq_not_eq_true] at h
  by_cases ht : T.card ≤ 2*(T.filter (fun v => g v=true)).card
  · exact ⟨true,ht⟩
  · exact ⟨false,by omega⟩

/-- The trace bound controls the minimum degree of every nonempty induced
subgraph, with no upper-degree or connectedness hypotheses. -/
theorem min_degree {V W : Type} [Fintype V] [Nonempty V] [Fintype W]
    [DecidableEq W] (H : SimpleGraph V) {α C d : ℝ}
    (hα1 : 1 ≤ α) (hα2 : α ≤ 2) (hC : 0 ≤ C)
    (hbound : EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (subdivision H).Free G)
    (T : Finset W) (hT : T.Nonempty) (hd : 0 ≤ d)
    (hdeg : ∀v∈T, d ≤ ((neighbors G T v).card:ℝ)) :
    d ≤ coefficient (Fintype.card V) α C*(T.card:ℝ)^(1-α⁻¹) := by
  classical
  obtain ⟨t,ht⟩ := exists_large_color T g
  let A := T.filter (fun v => g v≠t)
  let B := T.filter (fun v => g v=t)
  let E := (A ×ˢ B).filter (fun p => G.Adj p.1 p.2)
  have hdis : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro v hv hv'
    exact (mem_filter.mp hv).2 (mem_filter.mp hv').2
  have hfree : ¬Contains (incidence H) E A B := cut_not_contains (incidence H) G hf A B hdis
  have hnei (v : W) (hv : v∈B) : nl E A v=neighbors G T v := by
    ext u
    have hvcol : g v=t := (mem_filter.mp hv).2
    have hucol : G.Adj v u → g u≠t := by
      intro hadj he
      exact hg hadj (hvcol.trans he.symm)
    simp only [nl,neighbors,E,A,mem_filter,mem_product]
    constructor
    · rintro ⟨⟨hu,huc⟩,⟨_,_⟩,huv⟩
      exact ⟨hu,huv.symm⟩
    · rintro ⟨hu,huv⟩
      exact ⟨⟨hu,hucol huv⟩,⟨⟨hu,hucol huv⟩,hv⟩,huv.symm⟩
  apply IncidenceDegreeBound.degree_bound
    (h:=Fintype.card V) (a:=A.card) (b:=B.card)
    (by exact_mod_cast Fintype.card_pos) (by exact_mod_cast card_pos.mpr hT)
    (Nat.cast_nonneg _) (by exact_mod_cast card_le_card (filter_subset (fun v => g v≠t) T))
    (by exact_mod_cast ht) hd hα1 hC
  intro hdlarge
  exact IncidenceDegreeBound.degree_inequality H hbound (by linarith) hα2 hC E A B hfree hdlarge
    (fun v hv => by rw [hnei v hv]; exact hdeg v (mem_filter.mp hv).1)

/-- A global upper bound in a properly two-colored host. -/
theorem bipartite_bound {V W : Type} [Fintype V] [Nonempty V] [Fintype W]
    [DecidableEq W] (H : SimpleGraph V) {α C : ℝ}
    (hα1 : 1 ≤ α) (hα2 : α ≤ 2) (hC : 0 ≤ C)
    (hbound : EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (subdivision H).Free G)
    (S : Finset W) :
    ((arcs G S).card:ℝ) ≤ 4*coefficient (Fintype.card V) α C*(S.card:ℝ)^(2-α⁻¹) := by
  have hα0 : 0 < α := by linarith
  have hi1 : α⁻¹ ≤ 1 := (inv_le_one₀ hα0).mpr hα1
  have h := bound_of_min_degree G S (γ:=1-α⁻¹) (D:=coefficient (Fintype.card V) α C) (by linarith) (coefficient_nonneg hC) ?_
  · simpa only [show (1:ℝ)+(1-α⁻¹)=2-α⁻¹ by ring] using h
  · intro T hTS hT d hd hdeg
    exact min_degree H hα1 hα2 hC hbound G g hg hf T hT hd.le hdeg

/-- Subdivision preserves ordinary upper bounds with the nonsharp transform
`α ↦ 2 - 1/α`. This is NOT the sharp transform needed in `erdos_571`. -/
theorem edge_bound {V : Type} [Fintype V] [Nonempty V]
    (H : SimpleGraph V) {α C : ℝ} (hα1 : 1 ≤ α) (hα2 : α ≤ 2) (hC : 0 ≤ C)
    (hbound : EdgeBound H α C) :
    EdgeBound (subdivision H) (2-α⁻¹) (4*coefficient (Fintype.card V) α C) := by
  constructor
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (subdivision H).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bipartite_bound H hα1 hα2 hC hbound F g hg hfree univ
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hneigh (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v
      simp [neighbors]
    simp_rw [hneigh,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

/-- On the interior of the exponent range the new estimate is strictly weaker
than the sharp subdivision estimate required by the rational-exponent reduction. -/
lemma sharp_lt_weak {α : ℝ} (hα1 : 1 < α) (hα2 : α < 2) :
    (1+α)/2 < 2-α⁻¹ := by
  have hα : 0 < α := by linarith
  have hpos : 0 < (α-1)*(2-α) := mul_pos (by linarith) (by linarith)
  have hi : α*α⁻¹=1 := mul_inv_cancel₀ hα.ne'
  nlinarith

end Erdos571.WeakSubdivisionUpper


/- Rooted spiders with one short arm and the others of length two. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph RootedSunflower DensityRegularization ProjectionHeavy

/-- The nonroots form a star, and each has its own private root leaf. -/
def template (s : ℕ) : SimpleGraph (Option (Fin s) ⊕ Option (Fin s)) where
  Adj u v := match u,v with
    | .inl a,.inl b => match a,b with
        | none,some _ => True
        | some _,none => True
        | _,_ => False
    | .inl a,.inr r => a=r
    | .inr r,.inl a => r=a
    | .inr _,.inr _ => False
  symm := by
    intro u v h
    cases u with
    | inl a =>
      cases v with
      | inl b => cases a <;> cases b <;> exact h
      | inr r => exact h.symm
    | inr r =>
      cases v with
      | inl a => exact h.symm
      | inr r' => exact h
  loopless := by
    intro u
    cases u with
    | inl a => cases a <;> exact not_false
    | inr r => exact not_false

def graph (s M : ℕ) := FullRootedPower.graph (template s) M

lemma no_isolated (s : ℕ) : ∀u, ∃v, (template s).Adj u v := by
  intro u
  cases u with
  | inl a => exact ⟨.inr a,rfl⟩
  | inr r => exact ⟨.inl r,rfl⟩

def color {s : ℕ} : Option (Fin s) ⊕ Option (Fin s) → Bool
  | .inl none => false
  | .inl (some _) => true
  | .inr none => true
  | .inr (some _) => false

lemma color_proper (s : ℕ) : ∀{u v}, (template s).Adj u v → color u ≠ color v := by
  intro u v huv
  cases u with
  | inl a =>
    cases v with
    | inl b => cases a <;> cases b <;> simp_all [template,color]
    | inr r => change a=r at huv; subst r; cases a <;> simp [color]
  | inr r =>
    cases v with
    | inl a => change r=a at huv; subst a; cases r <;> simp [color]
    | inr r' => exact huv.elim

/-- Simultaneous choices from large common neighborhoods avoid a finite
blacklist, as well as all other choices. -/
lemma select_avoiding {I W : Type*} [Fintype I] [DecidableEq W]
    (F : I → Finset W) (Z : Finset W)
    (hF : ∀i, Fintype.card I+Z.card ≤ (F i).card) :
    ∃g : I → W, Function.Injective g ∧ ∀i, g i∈F i ∧ g i∉Z := by
  obtain ⟨g,hg,hgF⟩ := injective_selection (fun i => F i\Z) (by
    intro i
    change Fintype.card I ≤ (F i\Z).card
    have h := card_sdiff_add_card_inter (F i) Z
    have hi := card_le_card (inter_subset_right : F i∩Z ⊆ Z)
    have hh := hF i
    omega)
  exact ⟨g,hg,fun i => mem_sdiff.mp (hgF i)⟩

/-- A complete bipartite graph in the heavy shadow of one neighborhood lifts
to the spider power. The vertex defining the neighborhood is its short root. -/
theorem contains_of_heavy {W : Type} [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (v : W)
    (s M : ℕ)
    (f : (completeBipartiteGraph (Fin s) (Fin M)).Copy
      ((heavy (arcs G U) U (M*s+M+s+1)).induce (neighbors G U v : Set W))) :
    graph s M ⊑ G := by
  classical
  let old : Fin s ⊕ Fin M → W := fun a => (f a).val
  have holdinj : Function.Injective old := Subtype.val_injective.comp f.injective
  have holdv (a : Fin s ⊕ Fin M) : G.Adj v (old a) := (mem_filter.mp (f a).property).2
  let Z : Finset W := insert v (univ.image old)
  have hZ : Z.card ≤ M+s+1 := by
    have h₁ := card_insert_le v (univ.image old)
    change (insert v (univ.image old)).card ≤ M+s+1
    have h₂ := card_image_le (f:=old) (s:=univ)
    simp only [card_univ,Fintype.card_sum,Fintype.card_fin] at h₂
    omega
  let F : Fin M × Fin s → Finset W := fun p =>
    ProjectionHeavy.common (arcs G U) U (old (.inl p.2)) (old (.inr p.1))
  have hF (p : Fin M × Fin s) : Fintype.card (Fin M × Fin s)+Z.card ≤ (F p).card := by
    have h := f.toHom.map_adj (show (completeBipartiteGraph (Fin s) (Fin M)).Adj (.inl p.2) (.inr p.1) by simp [completeBipartiteGraph])
    change old (.inl p.2)≠old (.inr p.1) ∧ M*s+M+s+1 ≤ (F p).card at h
    simp only [Fintype.card_prod,Fintype.card_fin]
    omega
  obtain ⟨mid,hmid,hmidF⟩ := select_avoiding F Z hF
  have hmidold (p : Fin M × Fin s) (a : Fin s ⊕ Fin M) : mid p≠old a := by
    intro h
    exact (hmidF p).2 (mem_insert_of_mem (mem_image.mpr ⟨a,mem_univ _,h.symm⟩))
  have hmidv (p : Fin M × Fin s) : mid p≠v := by
    intro h
    exact (hmidF p).2 (h.symm ▸ mem_insert_self v (univ.image old))
  have hmidAdj (p : Fin M × Fin s) : G.Adj (old (.inl p.2)) (mid p) ∧ G.Adj (old (.inr p.1)) (mid p) := by
    obtain ⟨_,h₁,h₂⟩ := mem_filter.mp (hmidF p).1
    exact ⟨(mem_arcs.mp h₁).2.2,(mem_arcs.mp h₂).2.2⟩
  let g : (Fin M × Option (Fin s)) ⊕ Option (Fin s) → W
    | .inl (i,none) => old (.inr i)
    | .inl (i,some j) => mid (i,j)
    | .inr none => v
    | .inr (some j) => old (.inl j)
  have hginj : Function.Injective g := by
    intro x y hxy
    rcases x with ⟨i,a⟩ | a <;> rcases y with ⟨j,b⟩ | b
    · cases a with
      | none =>
        cases b with
        | none => exact congrArg (fun i => Sum.inl (i,none)) (Sum.inr.inj (holdinj hxy))
        | some b => exact (hmidold (j,b) (.inr i) hxy.symm).elim
      | some a =>
        cases b with
        | none => exact (hmidold (i,a) (.inr j) hxy).elim
        | some b =>
          have h := hmid hxy
          exact congrArg (fun p : Fin M × Fin s => Sum.inl (p.1,some p.2)) h
    · cases a with
      | none =>
        cases b with
        | none => exact ((holdv (.inr i)).ne' hxy).elim
        | some b => exact (Sum.inr_ne_inl (holdinj hxy)).elim
      | some a =>
        cases b with
        | none => exact (hmidv (i,a) hxy).elim
        | some b => exact (hmidold (i,a) (.inl b) hxy).elim
    · cases a with
      | none =>
        cases b with
        | none => exact ((holdv (.inr j)).ne hxy).elim
        | some b => exact (hmidv (j,b) hxy.symm).elim
      | some a =>
        cases b with
        | none => exact (Sum.inl_ne_inr (holdinj hxy)).elim
        | some b => exact (hmidold (j,b) (.inl a) hxy.symm).elim
    · cases a with
      | none =>
        cases b with
        | none => rfl
        | some b => exact ((holdv (.inl b)).ne hxy).elim
      | some a =>
        cases b with
        | none => exact ((holdv (.inl a)).ne' hxy).elim
        | some b => exact congrArg (fun j => Sum.inr (some j)) (Sum.inl.inj (holdinj hxy))
  refine ⟨{ toHom := {toFun:=g, map_rel':=?_}, injective':=hginj }⟩
  intro x y hxy
  rcases x with ⟨i,a⟩ | a <;> rcases y with ⟨j,b⟩ | b
  · obtain ⟨hij,hab⟩ := hxy
    change i=j at hij
    subst j
    cases a with
    | none => cases b with
      | none => exact hab.elim
      | some b => exact (hmidAdj (i,b)).2
    | some a => cases b with
      | none => exact (hmidAdj (i,a)).2.symm
      | some b => exact hab.elim
  · change a=b at hxy
    subst b
    cases a with
    | none => exact (holdv (.inr i)).symm
    | some a => exact (hmidAdj (i,a)).1.symm
  · change a=b at hxy
    subst b
    cases a with
    | none => exact holdv (.inr j)
    | some a => exact (hmidAdj (j,a)).1
  · exact hxy.elim

end Erdos571.ShortSpider


/- Rooted balance and exact lower bounds for the short-root spider family. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph RootedSunflower

def edge {s : ℕ} : Option (Fin s) ⊕ Fin s → (template s).edgeSet
  | .inl a => ⟨s(Sum.inl a,Sum.inr a),rfl⟩
  | .inr j => ⟨s(Sum.inl none,Sum.inl (some j)),trivial⟩

lemma edge_injective (s : ℕ) : Function.Injective (@edge s) := by
  intro e f h
  have he := congrArg Subtype.val h
  cases e with
  | inl a =>
    cases f with
    | inl b => simpa [edge,Sym2.eq_iff] using he
    | inr j => simp [edge,Sym2.eq_iff] at he
  | inr i =>
    cases f with
    | inl a => simp [edge,Sym2.eq_iff] at he
    | inr j => simpa [edge,Sym2.eq_iff] using he

lemma petal_bound (s : ℕ) (C : Finset (Option (Fin s))) :
    (univ\C).card + (univ.filter (fun j : Fin s => none∉C ∨ some j∉C)).card ≤
      Nat.card (PetalEdge (template s) C) := by
  classical
  let A : Finset (Option (Fin s)) := univ\C
  let B : Finset (Fin s) := univ.filter (fun j => none∉C ∨ some j∉C)
  let f : A ⊕ B → PetalEdge (template s) C
    | .inl a => ⟨edge (.inl a.val),⟨a.val,(mem_sdiff.mp a.property).2,by simp [edge]⟩⟩
    | .inr j => ⟨edge (.inr j.val),by
        rcases (mem_filter.mp j.property).2 with hn | hj
        · exact ⟨none,hn,by simp [edge]⟩
        · exact ⟨some j.val,hj,by simp [edge]⟩⟩
  have hinj : Function.Injective f := by
    intro x y h
    have he : Sum.map Subtype.val Subtype.val x = Sum.map Subtype.val Subtype.val y := by
      cases x <;> cases y <;> exact edge_injective s (congrArg Subtype.val h)
    cases x with
    | inl a =>
      cases y with
      | inl b => exact congrArg Sum.inl (Subtype.ext (Sum.inl.inj he))
      | inr j => exact (Sum.inl_ne_inr he).elim
    | inr i =>
      cases y with
      | inl a => exact (Sum.inr_ne_inl he).elim
      | inr j => exact congrArg Sum.inr (Subtype.ext (Sum.inr.inj he))
  have hc := Nat.card_le_card_of_injective f hinj
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_coe] using hc

/-- Each nonroot has a private root. If the center is unpinned, every core edge
is a petal; otherwise each unpinned arm supplies an additional petal edge. -/
theorem balance (s : ℕ) : ∀ C : Finset (Option (Fin s)),
    (2*s+1)*(Fintype.card (Option (Fin s))-C.card) ≤
      (s+1)*Nat.card (PetalEdge (template s) C) := by
  classical
  intro C
  let A : Finset (Option (Fin s)) := univ\C
  have hc : A.card=Fintype.card (Option (Fin s))-C.card := by
    simp only [A,card_sdiff_of_subset (subset_univ C),card_univ]
  have ha : A.card ≤ s+1 := by
    have h := card_le_univ A
    simpa only [Fintype.card_option,Fintype.card_fin] using h
  have hp := petal_bound s C
  rw [← hc]
  by_cases hn : none∈C
  · have he : (univ.filter (fun j : Fin s => none∉C ∨ some j∉C)).card=A.card := by
      apply card_bij (fun j _ => some j)
      · intro j hj
        exact mem_sdiff.mpr ⟨mem_univ _,(mem_filter.mp hj).2.resolve_left (not_not.mpr hn)⟩
      · intro i hi j hj hij
        exact Option.some.inj hij
      · intro a ha
        cases a with
        | none => exact ((mem_sdiff.mp ha).2 hn).elim
        | some j => exact ⟨j,mem_filter.mpr ⟨mem_univ _,Or.inr (mem_sdiff.mp ha).2⟩,rfl⟩
    rw [he] at hp
    change A.card+A.card ≤ _ at hp
    nlinarith
  · have he : (univ.filter (fun j : Fin s => none∉C ∨ some j∉C)).card=s := by simp [hn]
    rw [he] at hp
    change A.card+s ≤ _ at hp
    nlinarith

lemma connected (s : ℕ) : (template s).Connected := by
  have hreach (u : Option (Fin s) ⊕ Option (Fin s)) : (template s).Reachable u (.inl none) := by
    cases u with
    | inl a =>
      cases a with
      | none => exact Reachable.rfl
      | some j => exact (show (template s).Adj (.inl (some j)) (.inl none) from trivial).reachable
    | inr r =>
      cases r with
      | none => exact (show (template s).Adj (.inr none) (.inl none) from rfl).reachable
      | some j =>
        exact (show (template s).Adj (.inr (some j)) (.inl (some j)) from rfl).reachable.trans
          (show (template s).Adj (.inl (some j)) (.inl none) from trivial).reachable
  exact { preconnected := fun u v => (hreach u).trans (hreach v).symm, nonempty := inferInstance }

/-- The exact lower exponent is available for a fixed power. -/
theorem exists_lower (s : ℕ) : ∃ M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-((s+1:ℕ):ℝ)/((2*s+1:ℕ):ℝ)))
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ)) := by
  exact FullRootedPower.exact_lower (template s) (no_isolated s) (s+1) (2*s+1)
    (by omega) (by omega) (balance s)

end Erdos571.ShortSpider


/- Heavy pairs inside neighborhoods of a spider-free graph. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph ProjectionHeavy DensityRegularization

lemma heavy_induced_free {W : Type} [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (v : W)
    (s M : ℕ) (hf : (graph s M).Free G) :
    (completeBipartiteGraph (Fin s) (Fin M)).Free
      ((heavy (arcs G U) U (M*s+M+s+1)).induce (neighbors G U v : Set W)) := by
  rintro ⟨f⟩
  exact hf (contains_of_heavy G U v s M f)

lemma kst_bound (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) :
    EdgeBound (completeBipartiteGraph (Fin s) (Fin M)) (2-1/(s:ℝ)) (2*M+(s+1)) := by
  constructor
  intro W _ G hf
  classical
  by_cases hW : Fintype.card W=0
  · letI : IsEmpty W := Fintype.card_eq_zero_iff.mp hW
    have hG : G=⊥ := by ext u v; exact (IsEmpty.false u).elim
    simp only [hG,Nat.card_eq_fintype_card,card_edgeSet,edgeFinset_bot,card_empty,Nat.cast_zero]
    positivity
  · have hn : 1 ≤ Fintype.card W := by omega
    have he : M=M-1+1 := by omega
    rw [he] at hf
    have h := KstUpper.edge_upper hs G hn hf
    have hm : ((M-1:ℕ):ℝ)+1=M := by exact_mod_cast he.symm
    rw [hm] at h
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using h

/-- Even though the whole heavy shadow need not avoid a complete bipartite
graph, its restriction to every neighborhood does. -/
theorem heavy_pairs_bound {W : Type} [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (v : W)
    (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) (hf : (graph s M).Free G) :
    ((heavyPairs (arcs G U) U (M*s+M+s+1) (neighbors G U v)).card:ℝ) ≤
      2*(2*M+(s+1)) * ((neighbors G U v).card:ℝ)^(2-1/(s:ℝ)) := by
  classical
  have h := (kst_bound s M hs hM).estimate _ (heavy_induced_free G U v s M hf)
  rw [heavyPairs_card]
  push_cast
  rw [Fintype.card_of_finset' (p:=(neighbors G U v:Set W)) _ (fun _ => Iff.rfl)] at h
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left h (by norm_num : (0:ℝ) ≤ 2)

/-- Summed over centers, the heavy two-path contribution is lower order than
all two-paths in an almost-regular graph. -/
theorem heavy_sum_bound {W : Type} [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) (hf : (graph s M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    (∑v∈U, ((heavyPairs (arcs G U) U (M*s+M+s+1) (neighbors G U v)).card:ℝ)) ≤
      (U.card:ℝ)*(2*(2*M+(s+1))*D^(2-1/(s:ℝ))) := by
  have hs0 : (0:ℝ) < s := by exact_mod_cast (show 0<s by omega)
  have hsi : 1/(s:ℝ) ≤ 1 := (div_le_one hs0).mpr (by exact_mod_cast hs)
  calc
    _ ≤ ∑v∈U, 2*(2*M+(s+1))*D^(2-1/(s:ℝ)) := sum_le_sum (fun v hv =>
      (heavy_pairs_bound G U v s M hs hM hf).trans (mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow (Nat.cast_nonneg _) (hdeg v hv) (by linarith)) (by positivity)))
    _ = _ := by simp

end Erdos571.ShortSpider


/- Counting tuples whose entries avoid a bounded symmetric conflict relation. -/
namespace Erdos571.ConflictTupleCount
open Finset

abbrev Good {X : Type*} (R : X → X → Prop) (k : ℕ) :=
  {f : Fin k → X // Pairwise (fun i j => ¬R (f i) (f j))}

/-- Greedy extension counts all choices, instead of merely finding one packing. -/
theorem lower {X : Type*} [Fintype X] (R : X → X → Prop) (hR : Symmetric R)
    (B : ℕ) (hB : ∀x, Nat.card {y // R x y} ≤ B)
    (k L : ℕ) (hL : L+k*B ≤ Fintype.card X) :
    L^k ≤ Nat.card (Good R k) := by
  classical
  induction k with
  | zero =>
    let f : Good R 0 := ⟨Fin.elim0,by intro i; exact Fin.elim0 i⟩
    letI : Nonempty (Good R 0) := ⟨f⟩
    simpa only [pow_zero,Nat.card_eq_fintype_card] using Fintype.card_pos (α:=Good R 0)
  | succ k ih =>
    have hLk : L+k*B ≤ Fintype.card X := by nlinarith
    have hprev := ih hLk
    let bad (f : Good R k) : Finset X := univ.biUnion (fun i => univ.filter (R (f.val i)))
    let avail (f : Good R k) : Finset X := univ\bad f
    have hbad (f : Good R k) : (bad f).card ≤ k*B := by
      calc
        _ ≤ ∑i : Fin k, (univ.filter (R (f.val i))).card := card_biUnion_le
        _ ≤ ∑_i : Fin k, B := sum_le_sum (fun i _ => by
          simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype] using hB (f.val i))
        _ = _ := by simp
    have havail (f : Good R k) : L ≤ (avail f).card := by
      have he := card_sdiff_add_card_eq_card (subset_univ (bad f))
      rw [card_univ] at he
      have hb := hbad f
      change L ≤ (univ\bad f).card
      nlinarith
    have hnot (f : Good R k) (x : avail f) (i : Fin k) : ¬R (f.val i) x.val := by
      intro h
      exact (mem_sdiff.mp x.property).2 (mem_biUnion.mpr ⟨i,mem_univ _,mem_filter.mpr ⟨mem_univ _,h⟩⟩)
    let ext : (Σf : Good R k, avail f) → Good R (k+1) := fun p =>
      ⟨Fin.cons p.2.val p.1.val,by
        intro i j hij
        induction i using Fin.cases with
        | zero =>
          induction j using Fin.cases with
          | zero => exact (hij rfl).elim
          | succ j => exact fun h => hnot p.1 p.2 j (hR h)
        | succ i =>
          induction j using Fin.cases with
          | zero => exact hnot p.1 p.2 i
          | succ j => exact p.1.property (fun h => hij (congrArg Fin.succ h))⟩
    have hinj : Function.Injective ext := by
      rintro ⟨f,x⟩ ⟨g,y⟩ h
      have hfg : f=g := by
        apply Subtype.ext
        funext i
        have he := congrArg (fun z : Good R (k+1) => z.val i.succ) h
        simpa only [ext,Fin.cons_succ] using he
      subst g
      have hxy : x=y := by
        apply Subtype.ext
        have he := congrArg (fun z : Good R (k+1) => z.val 0) h
        simpa only [ext,Fin.cons_zero] using he
      subst y
      rfl
    have hcount : L*Nat.card (Good R k) ≤ Nat.card (Σf : Good R k, avail f) := by
      simp only [Nat.card_eq_fintype_card,Fintype.card_sigma,Fintype.card_coe]
      calc
        _ = ∑_f : Good R k, L := by simp [mul_comm]
        _ ≤ _ := sum_le_sum (fun f _ => havail f)
    calc
      L^(k+1) = L*L^k := by rw [pow_succ]; ring
      _ ≤ L*Nat.card (Good R k) := Nat.mul_le_mul_left L hprev
      _ ≤ Nat.card (Σf : Good R k, avail f) := hcount
      _ ≤ Nat.card (Good R (k+1)) := Nat.card_le_card_of_injective ext hinj

/-- With a loss of at most half the choices per step, the normalized tuple
count is at least `(|X|/2)^k`. -/
theorem half_lower {X : Type*} [Fintype X] (R : X → X → Prop) (hR : Symmetric R)
    (B : ℕ) (hB : ∀x, Nat.card {y // R x y} ≤ B)
    (k : ℕ) (hk : 2*k*B ≤ Fintype.card X) :
    ((Fintype.card X:ℝ)/2)^k ≤ Nat.card (Good R k) := by
  classical
  have hkn : k*B ≤ Fintype.card X := by nlinarith
  have h := lower R hR B hB k (Fintype.card X-k*B) (Nat.sub_add_cancel hkn).le
  have hc : ((Fintype.card X-k*B:ℕ):ℝ) = Fintype.card X-(k:ℝ)*B := by
    rw [Nat.cast_sub hkn,Nat.cast_mul]
  have hhalf : (Fintype.card X:ℝ)/2 ≤ ((Fintype.card X-k*B:ℕ):ℝ) := by
    have hk' : 2*(k:ℝ)*B ≤ Fintype.card X := by exact_mod_cast hk
    rw [hc]
    linarith
  exact (pow_le_pow_left₀ (by positivity) hhalf k).trans (by exact_mod_cast h)

end Erdos571.ConflictTupleCount


/- Many ordered matchings in a finite relation with bounded row and column sizes. -/
namespace Erdos571.ConflictTupleCount
open Finset

abbrev Matching {L R : Type*} (P : Finset (L × R)) (k : ℕ) :=
  Good (fun p q : P => p.val.1=q.val.1 ∨ p.val.2=q.val.2) k

lemma matching_first_injective {L R : Type*} {P : Finset (L × R)} {k : ℕ} (f : Matching P k) :
    Function.Injective (fun i => (f.val i).val.1) := by
  intro i j he
  by_contra hij
  exact f.property hij (Or.inl he)

lemma matching_second_injective {L R : Type*} {P : Finset (L × R)} {k : ℕ} (f : Matching P k) :
    Function.Injective (fun i => (f.val i).val.2) := by
  intro i j he
  by_contra hij
  exact f.property hij (Or.inr he)

lemma matching_lower {L R : Type*} [DecidableEq L] [DecidableEq R]
    (P : Finset (L × R)) (k : ℕ) {D : ℝ} (hD : 0 ≤ D)
    (hrow : ∀p∈P, ((P.filter (fun q => q.1=p.1)).card:ℝ) ≤ D)
    (hcol : ∀p∈P, ((P.filter (fun q => q.2=p.2)).card:ℝ) ≤ D)
    (hsize : 4*k*D ≤ P.card) : ((P.card:ℝ)/2)^k ≤ Nat.card (Matching P k) := by
  classical
  let conflict := fun p q : P => p.val.1=q.val.1 ∨ p.val.2=q.val.2
  have hconf : Symmetric conflict := by
    intro p q h
    exact h.elim (fun h => Or.inl h.symm) (fun h => Or.inr h.symm)
  have hb (p : P) : Nat.card {q : P // conflict p q} ≤ 2*⌊D⌋₊ := by
    have he : (univ.filter (fun q : P => conflict p q)).card =
        (P.filter (fun q => p.val.1=q.1 ∨ p.val.2=q.2)).card := by
      apply card_bij (fun q _ => q.val)
      · intro q hq; exact mem_filter.mpr ⟨q.property,(mem_filter.mp hq).2⟩
      · intro q hq q' hq' he; exact Subtype.ext he
      · intro q hq; exact ⟨⟨q,(mem_filter.mp hq).1⟩,mem_filter.mpr ⟨mem_univ _,(mem_filter.mp hq).2⟩,rfl⟩
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype,he,filter_or]
    have h₁ := Nat.le_floor (hrow p.val p.property)
    have h₂ := Nat.le_floor (hcol p.val p.property)
    have hu := card_union_le (P.filter (fun q => p.val.1=q.1)) (P.filter (fun q => p.val.2=q.2))
    simp only [eq_comm] at hu ⊢
    omega
  have hk : 2*k*(2*⌊D⌋₊) ≤ Fintype.card P := by
    rw [Fintype.card_coe]
    have hh : 2*(k:ℝ)*(2*⌊D⌋₊) ≤ (P.card:ℝ) := by
      have hd := Nat.floor_le hD
      have hk : (0:ℝ) ≤ k := Nat.cast_nonneg _
      nlinarith
    exact_mod_cast hh
  simpa only [Fintype.card_coe] using half_lower conflict hconf (2*⌊D⌋₊) hb k hk

end Erdos571.ConflictTupleCount


/- Bounded loads for short-spider copies with light two-paths. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization

/-- Both two-edge subpaths of each long arm are light. -/
def GoodCopy {W : Type*} [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s : ℕ) (f : (template s).Copy G) : Prop :=
  (∀v, f v∈U) ∧ ∀j : Fin s,
    (FourthMoment.common G U (f (.inr none)) (f (.inl (some j)))).card < t ∧
    (FourthMoment.common G U (f (.inl none)) (f (.inr (some j)))).card < t

lemma center_count {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t s f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (hcent : ∀f∈F, f (.inl none)=w) : F.card ≤ t^s := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]
    omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C : Fin s → Finset W := fun j => FourthMoment.common G U w (r (some j))
  have hC (j : Fin s) : (C j).card ≤ t := by
    have h := ((hgood f₀ hf₀).2 j).2
    rw [hcent f₀ hf₀,hroot f₀ hf₀] at h
    exact h.le
  let g : F → ((j : Fin s) → C j) := fun f j =>
    ⟨f.val (.inl (some j)),mem_filter.mpr ⟨(hgood f.val f.property).1 _,by
      constructor
      · rw [← hcent f.val f.property]
        exact f.val.toHom.map_adj (show (template s).Adj (.inl none) (.inl (some j)) from trivial)
      · rw [← hroot f.val f.property]
        exact f.val.toHom.map_adj (show (template s).Adj (.inr (some j)) (.inl (some j)) from rfl)⟩⟩
  have hg : Function.Injective g := by
    intro f f' he
    apply Subtype.ext
    apply Copy.ext
    intro v
    cases v with
    | inl a =>
      cases a with
      | none => exact (hcent f.val f.property).trans (hcent f'.val f'.property).symm
      | some j => exact congrArg Subtype.val (congrFun he j)
    | inr r' => exact (hroot f.val f.property r').trans (hroot f'.val f'.property r').symm
  have hc := Fintype.card_le_of_injective g hg
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  calc
    _ ≤ ∏j : Fin s, Fintype.card (C j) := hc
    _ ≤ ∏_j : Fin s, t := prod_le_prod' (fun j _ => by simpa only [Fintype.card_coe] using hC j)
    _ = _ := by simp

lemma arm_count {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W) (j : Fin s) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t s f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (harm : ∀f∈F, f (.inl (some j))=w) : F.card ≤ t^(s+1) := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]
    omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := FourthMoment.common G U (r none) w
  have hC : C.card ≤ t := by
    have h := ((hgood f₀ hf₀).2 j).1
    rw [hroot f₀ hf₀,harm f₀ hf₀] at h
    exact h.le
  let center := fun f : (template s).Copy G => f (.inl none)
  have hsub : F.image center ⊆ C := by
    intro c hc
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hc
    refine mem_filter.mpr ⟨(hgood f hf).1 _,?_,?_⟩
    · rw [← hroot f hf]
      exact f.toHom.map_adj (show (template s).Adj (.inr none) (.inl none) from rfl)
    · rw [← harm f hf]
      exact f.toHom.map_adj (show (template s).Adj (.inl (some j)) (.inl none) from trivial)
  have hb : F.card ≤ t^s*(F.image center).card := card_le_mul_card_image F (t^s) (by
    intro c hc
    apply center_count G U t s _ r c
    · intro f hf; exact hgood f (mem_filter.mp hf).1
    · intro f hf; exact hroot f (mem_filter.mp hf).1
    · intro f hf; exact (mem_filter.mp hf).2)
  calc
    _ ≤ t^s*(F.image center).card := hb
    _ ≤ t^s*t := Nat.mul_le_mul_left _ ((card_le_card hsub).trans hC)
    _ = _ := (pow_succ _ _).symm

/-- A fixed interior vertex lies in only constantly many good copies with
prescribed roots. The short arm is essential for the middle-vertex bound. -/
theorem interior_load {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ) (ht : 1 ≤ t)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W)
    (hgood : ∀f∈F, GoodCopy G U t s f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤ (s+1)*t^(s+1) := by
  classical
  let A := F.filter (fun f => f (.inl none)=w)
  let B (j : Fin s) := F.filter (fun f => f (.inl (some j))=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f) ⊆ A ∪ univ.biUnion B := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,he⟩ := hw
    cases a with
    | none => exact mem_union_left _ (mem_filter.mpr ⟨(mem_filter.mp hf).1,he⟩)
    | some j => exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨(mem_filter.mp hf).1,he⟩⟩)
  have hA : A.card ≤ t^s := center_count G U t s A r w
    (fun f hf => hgood f (mem_filter.mp hf).1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hB (j : Fin s) : (B j).card ≤ t^(s+1) := arm_count G U t s (B j) r j w
    (fun f hf => hgood f (mem_filter.mp hf).1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hpow : t^s ≤ t^(s+1) := Nat.pow_le_pow_right ht (by omega)
  calc
    _ ≤ (A ∪ univ.biUnion B).card := card_le_card hsub
    _ ≤ A.card+(univ.biUnion B).card := card_union_le _ _
    _ ≤ t^s+∑j : Fin s, (B j).card := Nat.add_le_add hA card_biUnion_le
    _ ≤ t^(s+1)+∑_j : Fin s, t^(s+1) := Nat.add_le_add hpow (sum_le_sum (fun j _ => hB j))
    _ = _ := by simp; ring

/-- A spider-free graph has bounded good fibers for every prescribed root tuple. -/
theorem rooted_count {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (ht : 1 ≤ t) (hM : 1 ≤ M) (hf : (graph s M).Free G)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) ↪ W)
    (hgood : ∀f∈F, GoodCopy G U t s f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x) :
    F.card < M*(s+1)^2*t^(s+1) := by
  classical
  by_contra h
  have hc : M*Fintype.card (Option (Fin s))*((s+1)*t^(s+1)) ≤ F.card := by
    simp only [Fintype.card_option,Fintype.card_fin]
    nlinarith
  have hcopy := RootedPacking.power_contained_of_bounded_load F id r hroot
    ((s+1)*t^(s+1)) M (by positivity) (interior_load G U t s ht F r hgood hroot) hc
  apply hf
  have he : RootedPacking.power (template s) M=graph s M := by
    ext u v
    cases u <;> cases v <;> rfl
  rwa [← he]

/-- Counting root tuples turns the load bound into a global upper bound on all
good spider copies. -/
theorem good_count {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (ht : 1 ≤ t) (hM : 1 ≤ M) (hf : (graph s M).Free G)
    (F : Finset ((template s).Copy G)) (hgood : ∀f∈F, GoodCopy G U t s f) :
    F.card ≤ (M*(s+1)^2*t^(s+1))*U.card^(s+1) := by
  classical
  let roots : (template s).Copy G → (Option (Fin s) → W) := fun f r => f (.inr r)
  have hbound (r : Option (Fin s) → W) : (F.filter (fun f => roots f=r)).card ≤ M*(s+1)^2*t^(s+1) := by
    by_cases hne : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · simp only [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hne
    have hr : Function.Injective r := by
      have he := (mem_filter.mp hf₀).2
      rw [← he]
      exact f₀.injective.comp Sum.inr_injective
    exact (rooted_count G U t s M ht hM hf _ ⟨r,hr⟩
      (fun f hf => hgood f (mem_filter.mp hf).1)
      (fun f hf x => congrFun (mem_filter.mp hf).2 x)).le
  have hc := card_le_mul_card_image F (M*(s+1)^2*t^(s+1)) (fun r _ => hbound r)
  have hi : (F.image roots).card ≤ U.card^(s+1) := by
    let f : (F.image roots) → (Option (Fin s) → U) := fun r x =>
      ⟨r.val x,by
        obtain ⟨g,hg,he⟩ := mem_image.mp r.property
        rw [← he]
        exact (hgood g hg).1 _⟩
    have hinj : Function.Injective f := by
      intro r r' h
      apply Subtype.ext
      funext x
      exact congrArg Subtype.val (congrFun h x)
    have h := Fintype.card_le_of_injective f hinj
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_option,Fintype.card_fin] using h
  exact hc.trans (Nat.mul_le_mul_left _ hi)

end Erdos571.ShortSpider


/- Counting length-three walks after excluding heavy or diagonal two-paths. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [DecidableEq W]

def Bad (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (u v : W) : Prop :=
  u=v ∨ t ≤ (FourthMoment.common G U u v).card

instance (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : DecidableRel (Bad G U t) :=
  fun _ _ => inferInstanceAs (Decidable (_ ∨ _))

lemma bad_symm (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) {u v : W} :
    Bad G U t u v ↔ Bad G U t v u := by
  have he : FourthMoment.common G U u v=FourthMoment.common G U v u := by
    ext x; simp [FourthMoment.common,and_comm]
  simp only [Bad,he,eq_comm]

def fullArms (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (c : W) : Finset (W × W) :=
  ((neighbors G U c) ×ˢ U).filter (fun p => G.Adj p.1 p.2)

def arms (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (z c : W) : Finset (W × W) :=
  (fullArms G U c).filter (fun p => ¬Bad G U t z p.1 ∧ ¬Bad G U t c p.2)

def threeWalks (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) : Finset ((W × W) × (W × W)) :=
  (arcs G U ×ˢ arcs G U).filter (fun p => G.Adj p.1.2 p.2.1)

def goodWalks (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : Finset ((W × W) × (W × W)) :=
  (threeWalks G U).filter (fun p => ¬Bad G U t p.1.1 p.2.1 ∧ ¬Bad G U t p.1.2 p.2.2)

lemma mem_threeWalks {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {z c a x : W} :
    ((z,c),(a,x))∈threeWalks G U ↔ z∈U ∧ c∈U ∧ a∈U ∧ x∈U ∧ G.Adj z c ∧ G.Adj c a ∧ G.Adj a x := by
  simp only [threeWalks,mem_filter,mem_product,mem_arcs]
  tauto

lemma mem_arms {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t : ℕ} {z c a x : W} :
    (a,x)∈arms G U t z c ↔ a∈U ∧ x∈U ∧ G.Adj c a ∧ G.Adj a x ∧
      ¬Bad G U t z a ∧ ¬Bad G U t c x := by
  simp only [arms,fullArms,neighbors,mem_filter,mem_product]
  tauto

lemma fullArms_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (c : W) :
    (fullArms G U c).card=∑a∈neighbors G U c, (neighbors G U a).card := by
  rw [fullArms,card_filter,sum_product]
  apply sum_congr rfl
  intro a ha
  exact sum_boole (R:=ℕ) (G.Adj a) U

lemma threeWalks_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) :
    (threeWalks G U).card=∑e∈arcs G U, (fullArms G U e.2).card := by
  have he := card_eq_sum_card_fiberwise (f:=Prod.fst) (s:=threeWalks G U) (t:=arcs G U)
    (fun p hp => (mem_product.mp (mem_filter.mp hp).1).1)
  rw [he]
  apply sum_congr rfl
  intro e he
  apply card_bij (fun p _ => p.2)
  · intro p hp
    obtain ⟨hp,hpe⟩ := mem_filter.mp hp
    obtain ⟨⟨_,hap⟩,hca⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨(mem_arcs.mp hap).1,by simpa only [hpe] using hca⟩,
      (mem_arcs.mp hap).2.1⟩,(mem_arcs.mp hap).2.2⟩
  · intro p hp q hq hpq
    exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) hpq
  · intro p hp
    obtain ⟨⟨ha,hx⟩,hax⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    refine ⟨(e,p),mem_filter.mpr ⟨?_,rfl⟩,rfl⟩
    exact mem_filter.mpr ⟨mem_product.mpr ⟨he,mem_arcs.mpr ⟨(mem_filter.mp ha).1,hx,hax⟩⟩,(mem_filter.mp ha).2⟩

lemma goodWalks_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    (goodWalks G U t).card=∑e∈arcs G U, (arms G U t e.1 e.2).card := by
  have he := card_eq_sum_card_fiberwise (f:=Prod.fst) (s:=goodWalks G U t) (t:=arcs G U)
    (fun p hp => (mem_product.mp (mem_filter.mp (mem_filter.mp hp).1).1).1)
  rw [he]
  apply sum_congr rfl
  intro e he
  apply card_bij (fun p _ => p.2)
  · intro p hp
    obtain ⟨hp,hpe⟩ := mem_filter.mp hp
    obtain ⟨hp,hbad⟩ := mem_filter.mp hp
    obtain ⟨⟨_,hap⟩,hca⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    apply mem_arms.mpr
    exact ⟨(mem_arcs.mp hap).1,(mem_arcs.mp hap).2.1,by simpa only [hpe] using hca,
      (mem_arcs.mp hap).2.2,by simpa only [hpe] using hbad.1,by simpa only [hpe] using hbad.2⟩
  · intro p hp q hq hpq
    exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) hpq
  · intro p hp
    obtain ⟨ha,hx,hca,hax,h₁,h₂⟩ := mem_arms.mp hp
    refine ⟨(e,p),mem_filter.mpr ⟨mem_filter.mpr ⟨?_,h₁,h₂⟩,rfl⟩,rfl⟩
    exact mem_filter.mpr ⟨mem_product.mpr ⟨he,mem_arcs.mpr ⟨ha,hx,hax⟩⟩,hca⟩

lemma threeWalks_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {d : ℝ} (hd : 0 ≤ d) (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ)) :
    (U.card:ℝ)*d^3 ≤ (threeWalks G U).card := by
  have hfull (c : W) (hc : c∈U) : d^2 ≤ (fullArms G U c).card := by
    have he : ((fullArms G U c).card:ℝ)=∑a∈neighbors G U c, ((neighbors G U a).card:ℝ) := by
      exact_mod_cast fullArms_card G U c
    rw [he]
    have hsum : ∑a∈neighbors G U c, d ≤ ∑a∈neighbors G U c, ((neighbors G U a).card:ℝ) :=
      sum_le_sum (fun a ha => hdeg a (mem_filter.mp ha).1)
    simp only [sum_const,nsmul_eq_mul] at hsum
    nlinarith [hdeg c hc]
  have hsum : (U.card:ℝ)*d ≤ (arcs G U).card := by
    have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
    rw [he]
    calc
      _ = ∑_v∈U,d := by simp
      _ ≤ _ := sum_le_sum hdeg
  have he : ((threeWalks G U).card:ℝ)=∑e∈arcs G U, ((fullArms G U e.2).card:ℝ) := by
    exact_mod_cast threeWalks_card G U
  rw [he]
  have hb : ∑_e∈arcs G U,d^2 ≤ ∑e∈arcs G U, ((fullArms G U e.2).card:ℝ) :=
    sum_le_sum (fun e he => hfull e.2 (mem_arcs.mp he).2.1)
  simp only [sum_const,nsmul_eq_mul] at hb
  nlinarith [mul_le_mul_of_nonneg_right hsum (sq_nonneg d)]

def badPairs (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (c : W) : Finset (W × W) :=
  ((neighbors G U c) ×ˢ (neighbors G U c)).filter (fun p => Bad G U t p.1 p.2)

lemma common_eq (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) {u v : W} (hu : u∈U) (hv : v∈U) :
    ProjectionHeavy.common (arcs G U) U u v=FourthMoment.common G U u v := by
  ext x
  simp only [ProjectionHeavy.common,FourthMoment.common,mem_filter,mem_arcs,hu,hv,true_and]
  tauto

lemma badPairs_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (c : W) :
    (badPairs G U t c).card ≤ (neighbors G U c).card+
      (heavyPairs (arcs G U) U t (neighbors G U c)).card := by
  classical
  let diag := (neighbors G U c).image (fun v => (v,v))
  have hsub : badPairs G U t c ⊆ diag ∪ heavyPairs (arcs G U) U t (neighbors G U c) := by
    rintro ⟨z,a⟩ hp
    obtain ⟨⟨hz,ha⟩,hb⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    by_cases hza : z=a
    · subst a
      exact mem_union_left _ (mem_image.mpr ⟨z,hz,rfl⟩)
    · apply mem_union_right
      apply (mem_heavyPairs (arcs G U) U t (neighbors G U c) z a).mpr
      refine ⟨hz,ha,hza,?_⟩
      rw [common_eq G U (mem_filter.mp hz).1 (mem_filter.mp ha).1]
      exact hb.resolve_left hza
  exact (card_le_card hsub).trans ((card_union_le _ _).trans (Nat.add_le_add_right card_image_le _))

lemma first_bad_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    (((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card:ℝ) ≤
      D*(∑c∈U, ((badPairs G U t c).card:ℝ)) := by
  classical
  let F := (threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)
  let Z : Finset (W × (W × W)) := U.biUnion (fun c => (badPairs G U t c).image (fun p => (c,p)))
  let pre := fun p : (W × W) × (W × W) => (p.1.2,(p.1.1,p.2.1))
  have hmap : Set.MapsTo pre F Z := by
    rintro ⟨⟨z,c⟩,⟨a,x⟩⟩ hp
    obtain ⟨hp,hbad⟩ := mem_filter.mp hp
    obtain ⟨hz,hc,ha,hx,hzc,hca,hax⟩ := mem_threeWalks.mp hp
    apply mem_biUnion.mpr
    refine ⟨c,hc,mem_image.mpr ⟨(z,a),?_,rfl⟩⟩
    exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hz,hzc.symm⟩,mem_filter.mpr ⟨ha,hca⟩⟩,hbad⟩
  have hfiber (q : W × (W × W)) (hq : q∈Z) : ((F.filter (fun p => pre p=q)).card:ℝ) ≤ D := by
    have ha : q.2.2∈U := by
      obtain ⟨c,hc,hq⟩ := mem_biUnion.mp hq
      obtain ⟨p,hp,he⟩ := mem_image.mp hq
      subst q
      exact (mem_filter.mp (mem_product.mp (mem_filter.mp hp).1).2).1
    have hc : (F.filter (fun p => pre p=q)).card ≤ (neighbors G U q.2.2).card := by
      apply card_le_card_of_injOn (fun p => p.2.2)
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        have h := mem_threeWalks.mp (mem_filter.mp hp).1
        refine mem_filter.mpr ⟨h.2.2.2.1,?_⟩
        have haeq := congrArg (fun q : W × (W × W) => q.2.2) he
        change p.2.1=q.2.2 at haeq
        rw [← haeq]
        exact h.2.2.2.2.2.2
      · intro p hp p' hp' he
        have hpre : pre p=pre p' := (mem_filter.mp hp).2.trans (mem_filter.mp hp').2.symm
        exact Prod.ext
          (Prod.ext (congrArg (fun q : W × (W × W) => q.2.1) hpre) (congrArg Prod.fst hpre))
          (Prod.ext (congrArg (fun q : W × (W × W) => q.2.2) hpre) he)
    exact (show ((F.filter (fun p => pre p=q)).card:ℝ) ≤ (neighbors G U q.2.2).card by exact_mod_cast hc).trans (hdeg _ ha)
  have hF : (F.card:ℝ) ≤ Z.card*D := by
    have he : (F.card:ℝ)=∑q∈Z, ((F.filter (fun p => pre p=q)).card:ℝ) := by
      exact_mod_cast card_eq_sum_card_fiberwise hmap
    rw [he]
    calc
      _ ≤ ∑_q∈Z,D := sum_le_sum hfiber
      _ = _ := by simp
  have hZ : (Z.card:ℝ) ≤ ∑c∈U, ((badPairs G U t c).card:ℝ) := by
    have h : Z.card ≤ ∑c∈U, (badPairs G U t c).card := card_biUnion_le.trans
      (sum_le_sum (fun c _ => card_image_le))
    exact_mod_cast h
  exact hF.trans (by simpa only [mul_comm] using mul_le_mul_of_nonneg_left hZ hD)

lemma second_bad_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    ((threeWalks G U).filter (fun p => Bad G U t p.1.2 p.2.2)).card =
      ((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card := by
  apply card_bij (fun p _ => ((p.2.2,p.2.1),(p.1.2,p.1.1)))
  · rintro ⟨⟨z,c⟩,⟨a,x⟩⟩ hp
    obtain ⟨hp,hbad⟩ := mem_filter.mp hp
    obtain ⟨hz,hc,ha,hx,hzc,hca,hax⟩ := mem_threeWalks.mp hp
    exact mem_filter.mpr ⟨mem_threeWalks.mpr ⟨hx,ha,hc,hz,hax.symm,hca.symm,hzc.symm⟩,(bad_symm G U t).mp hbad⟩
  · intro p hp q hq he
    have h := congrArg (fun p : (W × W) × (W × W) => ((p.2.2,p.2.1),(p.1.2,p.1.1))) he
    simpa only [Prod.mk.eta] using h
  · rintro ⟨⟨z,c⟩,⟨a,x⟩⟩ hp
    obtain ⟨hp,hbad⟩ := mem_filter.mp hp
    obtain ⟨hz,hc,ha,hx,hzc,hca,hax⟩ := mem_threeWalks.mp hp
    exact ⟨((x,a),(c,z)),mem_filter.mpr ⟨mem_threeWalks.mpr ⟨hx,ha,hc,hz,hax.symm,hca.symm,hzc.symm⟩,
      (bad_symm G U t).mp hbad⟩,rfl⟩

/-- Only two bad two-path positions need to be discarded from a three-walk. -/
theorem goodWalks_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {d D : ℝ} (hd : 0 ≤ d) (hD : 0 ≤ D)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ D) :
    (U.card:ℝ)*d^3 ≤ (goodWalks G U t).card +
      2*D*((U.card:ℝ)*D+∑v∈U, ((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ)) := by
  classical
  have hbad := first_bad_bound G U t hD (fun v hv => (hdeg v hv).2)
  have hsplit : (threeWalks G U).card ≤ (goodWalks G U t).card+
      ((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card+
      ((threeWalks G U).filter (fun p => Bad G U t p.1.2 p.2.2)).card := by
    have hs : threeWalks G U ⊆ goodWalks G U t ∪
        (threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1) ∪
        (threeWalks G U).filter (fun p => Bad G U t p.1.2 p.2.2) := by
      intro p hp
      by_cases h₁ : Bad G U t p.1.1 p.2.1
      · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hp,h₁⟩))
      by_cases h₂ : Bad G U t p.1.2 p.2.2
      · exact mem_union_right _ (mem_filter.mpr ⟨hp,h₂⟩)
      exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hp,h₁,h₂⟩))
    exact (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  rw [second_bad_card] at hsplit
  have hbadsum : (∑v∈U, ((badPairs G U t v).card:ℝ)) ≤
      (U.card:ℝ)*D+∑v∈U, ((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ) := by
    calc
      _ ≤ ∑v∈U, (((neighbors G U v).card:ℝ)+(heavyPairs (arcs G U) U t (neighbors G U v)).card) :=
        sum_le_sum (fun v _ => by exact_mod_cast badPairs_bound G U t v)
      _ ≤ ∑v∈U, (D+((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ)) :=
        sum_le_sum (fun v hv => by linarith [(hdeg v hv).2])
      _ = _ := by rw [sum_add_distrib]; simp
  have hlower := threeWalks_lower G U hd (fun v hv => (hdeg v hv).1)
  have hsplit' : ((threeWalks G U).card:ℝ) ≤ (goodWalks G U t).card+
      2*(((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card:ℝ) := by
    have hh : (threeWalks G U).card ≤ (goodWalks G U t).card+
        2*((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card := by omega
    exact_mod_cast hh
  nlinarith [mul_le_mul_of_nonneg_left hbadsum hD]

end Erdos571.ShortSpider


/- Many light arms give many good short-spider copies. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization ConflictTupleCount
variable {W : Type} [DecidableEq W]

lemma same_color_of_two_steps (G : SimpleGraph W) (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) {u v w : W}
    (huv : G.Adj u v) (hvw : G.Adj v w) : g u=g w := by
  have h₁ := hg huv
  have h₂ := hg hvw
  cases hu : g u <;> cases hv : g v <;> cases hw : g w <;> simp_all

noncomputable def tupleCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (z c : W) (he : (z,c)∈arcs G U) (f : Matching (arms G U t z c) s) :
    (template s).Copy G := by
  classical
  let a := fun j => (f.val j).val.1
  let x := fun j => (f.val j).val.2
  have hm (j : Fin s) := mem_arms.mp (f.val j).property
  have hca (j : Fin s) : G.Adj c (a j) := (hm j).2.2.1
  have hax (j : Fin s) : G.Adj (a j) (x j) := (hm j).2.2.2.1
  have hzc := (mem_arcs.mp he).2.2
  have hxcol (j : Fin s) : g (x j)=g c := (same_color_of_two_steps G g hg (hca j) (hax j)).symm
  have haz (j : Fin s) : a j≠z := fun h => (hm j).2.2.2.2.1 (Or.inl h.symm)
  have hxc (j : Fin s) : x j≠c := fun h => (hm j).2.2.2.2.2 (Or.inl h.symm)
  have hzx (j : Fin s) : z≠x j := by
    intro h
    exact hg hzc ((congrArg g h).trans (hxcol j))
  have hcross (i j : Fin s) : a i≠x j := by
    intro h
    exact hg (hca i) (((congrArg g h).trans (hxcol j)).symm)
  let f' : Option (Fin s) ⊕ Option (Fin s) → W
    | .inl none => c
    | .inl (some j) => a j
    | .inr none => z
    | .inr (some j) => x j
  have hinj : Function.Injective f' := by
    intro u v huv
    cases u with
    | inl i =>
      cases v with
      | inl j =>
        cases i with
        | none => cases j with
          | none => rfl
          | some j => exact ((hca j).ne huv).elim
        | some i => cases j with
          | none => exact ((hca i).ne' huv).elim
          | some j => exact congrArg (fun i => Sum.inl (some i)) (matching_first_injective f huv)
      | inr j =>
        cases i with
        | none => cases j with
          | none => exact (hzc.ne' huv).elim
          | some j => exact (hxc j huv.symm).elim
        | some i => cases j with
          | none => exact (haz i huv).elim
          | some j => exact (hcross i j huv).elim
    | inr i =>
      cases v with
      | inl j =>
        cases i with
        | none => cases j with
          | none => exact (hzc.ne huv).elim
          | some j => exact (haz j huv.symm).elim
        | some i => cases j with
          | none => exact (hxc i huv).elim
          | some j => exact (hcross j i huv.symm).elim
      | inr j =>
        cases i with
        | none => cases j with
          | none => rfl
          | some j => exact (hzx j huv).elim
        | some i => cases j with
          | none => exact (hzx i huv.symm).elim
          | some j => exact congrArg (fun i => Sum.inr (some i)) (matching_second_injective f huv)
  refine ⟨{toFun:=f',map_rel':=?_},hinj⟩
  intro u v huv
  cases u with
  | inl a' =>
    cases v with
    | inl b' =>
      cases a' with
      | none => cases b' with
        | none => exact huv.elim
        | some j => exact hca j
      | some i => cases b' with
        | none => exact (hca i).symm
        | some j => exact huv.elim
    | inr r =>
      change a'=r at huv
      subst r
      cases a' with
      | none => exact hzc.symm
      | some j => exact hax j
  | inr r =>
    cases v with
    | inl a' =>
      change r=a' at huv
      subst a'
      cases r with
      | none => exact hzc
      | some j => exact (hax j).symm
    | inr r' => exact huv.elim

lemma tupleCopy_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (z c : W) (he : (z,c)∈arcs G U) (f : Matching (arms G U t z c) s) :
    GoodCopy G U t s (tupleCopy G U t s g hg z c he f) := by
  constructor
  · intro v
    cases v with
    | inl a =>
      cases a with
      | none => exact (mem_arcs.mp he).2.1
      | some j => exact (mem_arms.mp (f.val j).property).1
    | inr r =>
      cases r with
      | none => exact (mem_arcs.mp he).1
      | some j => exact (mem_arms.mp (f.val j).property).2.1
  · intro j
    have h := mem_arms.mp (f.val j).property
    exact ⟨lt_of_not_ge (fun hle => h.2.2.2.2.1 (Or.inr hle)),
      lt_of_not_ge (fun hle => h.2.2.2.2.2 (Or.inr hle))⟩

lemma arms_row (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (z c : W)
    {D : ℝ} (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) (p : W × W) (hp : p∈arms G U t z c) :
    (((arms G U t z c).filter (fun q => q.1=p.1)).card:ℝ) ≤ D := by
  have hc : ((arms G U t z c).filter (fun q => q.1=p.1)).card ≤ (neighbors G U p.1).card := by
    apply card_le_card_of_injOn Prod.snd
    · intro q hq
      obtain ⟨hq,he⟩ := mem_filter.mp hq
      have h := mem_arms.mp hq
      exact mem_filter.mpr ⟨h.2.1,he ▸ h.2.2.2.1⟩
    · intro q hq q' hq' he
      exact Prod.ext ((mem_filter.mp hq).2.trans (mem_filter.mp hq').2.symm) he
  exact (show (((arms G U t z c).filter (fun q => q.1=p.1)).card:ℝ) ≤ (neighbors G U p.1).card by exact_mod_cast hc).trans
    (hdeg _ (mem_arms.mp hp).1)

lemma arms_col (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (z c : W)
    {D : ℝ} (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) (p : W × W) (hp : p∈arms G U t z c) :
    (((arms G U t z c).filter (fun q => q.2=p.2)).card:ℝ) ≤ D := by
  have hc : ((arms G U t z c).filter (fun q => q.2=p.2)).card ≤ (neighbors G U p.2).card := by
    apply card_le_card_of_injOn Prod.fst
    · intro q hq
      obtain ⟨hq,he⟩ := mem_filter.mp hq
      have h := mem_arms.mp hq
      exact mem_filter.mpr ⟨h.1,he ▸ h.2.2.2.1.symm⟩
    · intro q hq q' hq' he
      exact Prod.ext he ((mem_filter.mp hq).2.trans (mem_filter.mp hq').2.symm)
  exact (show (((arms G U t z c).filter (fun q => q.2=p.2)).card:ℝ) ≤ (neighbors G U p.2).card by exact_mod_cast hc).trans
    (hdeg _ (mem_arms.mp hp).2.1)

/-- The ordered matchings of light arms give distinct good copies, even when
the central edge varies. -/
theorem arm_moment_bound [Fintype W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (ht : 1 ≤ t) (hM : 1 ≤ M) (hf : (graph s M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (E : Finset (W × W)) (hE : E ⊆ arcs G U)
    (hlarge : ∀e∈E, 4*s*D ≤ (arms G U t e.1 e.2).card) :
    (∑e∈E, (((arms G U t e.1 e.2).card:ℝ)/2)^s) ≤
      (M*(s+1)^2*t^(s+1):ℕ)*((U.card:ℝ)^(s+1)) := by
  classical
  let F : Finset ((template s).Copy G) := univ.filter (GoodCopy G U t s)
  let I := (Σe : E, Matching (arms G U t e.val.1 e.val.2) s)
  let f : I → F := fun p =>
    ⟨tupleCopy G U t s g hg p.1.val.1 p.1.val.2 (hE p.1.property) p.2,
      mem_filter.mpr ⟨mem_univ _,tupleCopy_good G U t s g hg _ _ (hE p.1.property) p.2⟩⟩
  have hinj : Function.Injective f := by
    rintro ⟨e,p⟩ ⟨e',p'⟩ h
    have he : e=e' := by
      apply Subtype.ext
      apply Prod.ext
      · exact congrArg (fun f : F => f.val (.inr none)) h
      · exact congrArg (fun f : F => f.val (.inl none)) h
    subst e'
    have hp : p=p' := by
      apply Subtype.ext
      funext j
      apply Subtype.ext
      apply Prod.ext
      · exact congrArg (fun f : F => f.val (.inl (some j))) h
      · exact congrArg (fun f : F => f.val (.inr (some j))) h
    subst p'
    rfl
  have hI : (Nat.card I:ℝ) ≤ (M*(s+1)^2*t^(s+1):ℕ)*(U.card:ℝ)^(s+1) := by
    have hc := (Nat.card_le_card_of_injective f hinj).trans (show Nat.card F ≤ M*(s+1)^2*t^(s+1)*U.card^(s+1) by
      simpa only [Nat.card_eq_fintype_card,Fintype.card_coe] using good_count G U t s M ht hM hf F
        (fun f hf => (mem_filter.mp hf).2))
    exact_mod_cast hc
  apply le_trans _ hI
  have hsum : Nat.card I = ∑e∈E, Nat.card (Matching (arms G U t e.1 e.2) s) := by
    simp only [I,Nat.card_sigma]
    exact (sum_subtype E (fun _ => Iff.rfl) (fun e => Nat.card (Matching (arms G U t e.1 e.2) s))).symm
  rw [hsum,Nat.cast_sum]
  apply sum_le_sum
  intro e he
  exact matching_lower _ s hD (arms_row G U t e.1 e.2 hdeg) (arms_col G U t e.1 e.2 hdeg) (hlarge e he)

end Erdos571.ShortSpider


/- Analytic estimates for the short-root spider family. -/
namespace Erdos571.ShortSpider
open Finset Filter

/-- The two error terms in the three-walk count are negligible at large degree. -/
lemma exists_error_threshold (s : ℕ) (hs : 1 ≤ s) (Q C : ℝ) (hQ : 1 ≤ Q) (hC : 0 ≤ C) :
    ∃L : ℝ, 1 ≤ L ∧ 16*s*Q^2 ≤ L ∧ ∀d : ℝ, L ≤ d →
      2*(Q*d)*(Q*d+C*(Q*d)^(2-1/(s:ℝ))) ≤ d^3/2 := by
  have hs0 : (0:ℝ) < s := by exact_mod_cast (show 0<s by omega)
  have hQ0 : 0 < Q := by linarith
  have hev : ∀ᶠ d : ℝ in atTop, 8*C*Q^(3-1/(s:ℝ)) ≤ d^(1/(s:ℝ)) :=
    (tendsto_rpow_atTop (by positivity : (0:ℝ) < 1/(s:ℝ))).eventually (eventually_ge_atTop _)
  obtain ⟨L₀,hL₀⟩ := eventually_atTop.mp hev
  let L := max 1 (max (16*s*Q^2) (max (8*Q^2) L₀))
  refine ⟨L,le_max_left _ _,(le_max_left _ _).trans (le_max_right _ _),?_⟩
  intro d hd
  have hd1 : 1 ≤ d := (le_max_left _ _).trans hd
  have hd0 : 0 < d := by linarith
  have hdQ : 8*Q^2 ≤ d := (le_max_left _ _).trans ((le_max_right _ _).trans ((le_max_right _ _).trans hd))
  have hdL : L₀ ≤ d := (le_max_right _ _).trans ((le_max_right _ _).trans ((le_max_right _ _).trans hd))
  have hpow := hL₀ d hdL
  have he : d^(1/(s:ℝ))*d^(3-1/(s:ℝ))=d^3 := by
    rw [← Real.rpow_add hd0,show 1/(s:ℝ)+(3-1/(s:ℝ))=3 by ring]
    norm_num
  have hh := mul_le_mul_of_nonneg_right hpow (Real.rpow_nonneg hd0.le (3-1/(s:ℝ)))
  rw [he] at hh
  have hterm : 2*(Q*d)*(C*(Q*d)^(2-1/(s:ℝ))) =
      2*C*Q^(3-1/(s:ℝ))*d^(3-1/(s:ℝ)) := by
    rw [Real.mul_rpow hQ0.le hd0.le,
      show 3-1/(s:ℝ)=1+(2-1/(s:ℝ)) by ring,
      Real.rpow_add hQ0,Real.rpow_add hd0,Real.rpow_one,Real.rpow_one]
    ring
  rw [mul_add,hterm]
  nlinarith [mul_le_mul_of_nonneg_right hdQ (sq_nonneg d)]

/-- At least a proportional number of central edges have many admissible arms. -/
lemma rich_count {I : Type*} [DecidableEq I] (E : Finset I) (f : I → ℝ)
    {n Q d : ℝ} (hn : 0 ≤ n) (hQ : 0 < Q) (hd : 0 < d)
    (hE : (E.card:ℝ) ≤ n*Q*d) (hupper : ∀e∈E, f e ≤ (Q*d)^2)
    (hsum : n*d^3/2 ≤ ∑e∈E, f e) :
    n*d ≤ 4*Q^2*((E.filter (fun e => d^2/(4*Q) ≤ f e)).card:ℝ) := by
  classical
  let R := E.filter (fun e => d^2/(4*Q) ≤ f e)
  let S := E.filter (fun e => ¬d^2/(4*Q) ≤ f e)
  have hsplit : (∑e∈R,f e)+(∑e∈S,f e)=∑e∈E,f e := sum_filter_add_sum_filter_not _ _ _
  have hr : ∑e∈R,f e ≤ (R.card:ℝ)*(Q*d)^2 := by
    calc
      _ ≤ ∑_e∈R,(Q*d)^2 := sum_le_sum (fun e he => hupper e (mem_filter.mp he).1)
      _ = _ := by simp
  have hl : ∑e∈S,f e ≤ n*d^3/4 := by
    have hs : (S.card:ℝ) ≤ E.card := by exact_mod_cast card_le_card (filter_subset _ _)
    calc
      _ ≤ ∑_e∈S,d^2/(4*Q) := sum_le_sum (fun e he => (lt_of_not_ge (mem_filter.mp he).2).le)
      _ = (S.card:ℝ)*(d^2/(4*Q)) := by simp
      _ ≤ (n*Q*d)*(d^2/(4*Q)) := mul_le_mul_of_nonneg_right (hs.trans hE) (by positivity)
      _ = _ := by field_simp
  change n*d ≤ 4*Q^2*(R.card:ℝ)
  apply (mul_le_mul_iff_right₀ (sq_pos_of_pos hd)).mp
  nlinarith

/-- Inverting the final integer-power inequality produces the desired exponent. -/
lemma degree_of_power (s : ℕ) {n d B : ℝ} (hn : 0 ≤ n) (hd : 0 ≤ d) (hB : 0 ≤ B)
    (h : d^(2*s+1) ≤ B*n^s) :
    d ≤ B^(((2*s+1:ℕ):ℝ)⁻¹)*n^((s:ℝ)/((2*s+1:ℕ):ℝ)) := by
  have hp : (0:ℝ) < ((2*s+1:ℕ):ℝ) := by positivity
  have hh := Real.rpow_le_rpow (pow_nonneg hd _) h (inv_nonneg.mpr hp.le)
  rw [← Real.rpow_natCast d (2*s+1),Real.rpow_rpow_inv hd hp.ne',
    Real.mul_rpow hB (pow_nonneg hn _),← Real.rpow_natCast_mul hn] at hh
  simpa only [div_eq_mul_inv] using hh

/-- The moment of the rich central-edge fibers controls the degree. -/
lemma power_of_rich_moment {I : Type*} [DecidableEq I] (E : Finset I) (f : I → ℝ)
    (s : ℕ) {n Q d K : ℝ} (hn : 0 < n) (hQ : 0 < Q) (hd : 0 < d)
    (hcount : n*d ≤ 4*Q^2*(E.card:ℝ))
    (hlarge : ∀e∈E, d^2/(4*Q) ≤ f e)
    (hmoment : (∑e∈E,(f e/2)^s) ≤ K*n^(s+1)) :
    d^(2*s+1) ≤ (4*Q^2*(8*Q)^s*K)*n^s := by
  have hsmall : (E.card:ℝ)*(d^2/(8*Q))^s ≤ K*n^(s+1) := by
    calc
      _ = ∑_e∈E,(d^2/(8*Q))^s := by simp
      _ ≤ ∑e∈E,(f e/2)^s := sum_le_sum (fun e he =>
        pow_le_pow_left₀ (by positivity) (by
          rw [show d^2/(8*Q)=(d^2/(4*Q))/2 by field_simp <;> norm_num]
          exact div_le_div_of_nonneg_right (hlarge e he) (by norm_num)) _)
      _ ≤ _ := hmoment
  have hmain := mul_le_mul_of_nonneg_right hcount (pow_nonneg (by positivity : 0 ≤ d^2/(8*Q)) s)
  have hsmall' := mul_le_mul_of_nonneg_left hsmall (by positivity : 0 ≤ 4*Q^2)
  have hh : n*d*(d^2/(8*Q))^s ≤ 4*Q^2*K*n^(s+1) := by nlinarith
  have hqp : 0 < (8*Q)^s := by positivity
  have hh' := mul_le_mul_of_nonneg_right hh hqp.le
  have he : n*d*(d^2/(8*Q))^s*(8*Q)^s=n*d^(2*s+1) := by
    rw [div_pow]
    field_simp
    rw [pow_add,pow_one,pow_mul]
    ring
  rw [he,pow_succ n s] at hh'
  apply (mul_le_mul_iff_right₀ hn).mp
  nlinarith

end Erdos571.ShortSpider


/- Sharp ordinary upper bounds for spiders with one short root arm. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeCoefficient (s M : ℕ) (Q : ℝ) : ℝ :=
  (4*Q^2*(8*Q)^s*(M*(s+1)^2*(M*s+M+s+1)^(s+1):ℕ))^(((2*s+1:ℕ):ℝ)⁻¹)

lemma degreeCoefficient_nonneg (s M : ℕ) {Q : ℝ} (hQ : 0 ≤ Q) : 0 ≤ degreeCoefficient s M Q := by
  unfold degreeCoefficient
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) (hf : (graph s M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 0 < d) (hdlarge : 16*s*Q^2 ≤ d)
    (herr : 2*(Q*d)*(Q*d+(2*(2*M+(s+1)))*(Q*d)^(2-1/(s:ℝ))) ≤ d^3/2)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) :
    d ≤ degreeCoefficient s M Q*(U.card:ℝ)^((s:ℝ)/((2*s+1:ℕ):ℝ)) := by
  classical
  let t := M*s+M+s+1
  have ht : 1 ≤ t := by dsimp [t]; omega
  have hn : (0:ℝ) < U.card := by exact_mod_cast card_pos.mpr hU
  have hQ0 : 0 < Q := by linarith
  have hD : 0 ≤ Q*d := by positivity
  have hh := heavy_sum_bound G U s M hs hM hf hD (fun v hv => (hdeg v hv).2)
  have hp := goodWalks_lower G U t hd.le hD hdeg
  have hgcount : (U.card:ℝ)*d^3/2 ≤ (goodWalks G U t).card := by
    have h₁ := mul_le_mul_of_nonneg_left hh (show 0 ≤ 2*(Q*d) by positivity)
    have h₂ := mul_le_mul_of_nonneg_left herr hn.le
    dsimp [t] at hp ⊢
    nlinarith
  have harcs : ((arcs G U).card:ℝ) ≤ (U.card:ℝ)*Q*d := by
    have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
    rw [he]
    calc
      _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
      _ = _ := by simp; ring
  have harms (e : W × W) (he : e∈arcs G U) : ((arms G U t e.1 e.2).card:ℝ) ≤ (Q*d)^2 := by
    have hs : (arms G U t e.1 e.2).card ≤ (fullArms G U e.2).card := card_le_card (filter_subset _ _)
    have hf : ((fullArms G U e.2).card:ℝ)=∑a∈neighbors G U e.2, ((neighbors G U a).card:ℝ) := by
      exact_mod_cast fullArms_card G U e.2
    have hne : ∑a∈neighbors G U e.2, ((neighbors G U a).card:ℝ) ≤ (neighbors G U e.2).card*(Q*d) := by
      calc
        _ ≤ ∑_a∈neighbors G U e.2,Q*d := sum_le_sum (fun a ha => (hdeg a (mem_filter.mp ha).1).2)
        _ = _ := by simp
    have hnmax := (hdeg e.2 (mem_arcs.mp he).2.1).2
    have hs' : ((arms G U t e.1 e.2).card:ℝ) ≤ (fullArms G U e.2).card := by exact_mod_cast hs
    rw [hf] at hs'
    nlinarith [mul_le_mul_of_nonneg_right hnmax hD]
  have hsum : (U.card:ℝ)*d^3/2 ≤ ∑e∈arcs G U, ((arms G U t e.1 e.2).card:ℝ) := by
    have he : ((goodWalks G U t).card:ℝ)=∑e∈arcs G U, ((arms G U t e.1 e.2).card:ℝ) := by
      exact_mod_cast goodWalks_card G U t
    rwa [← he]
  let E := (arcs G U).filter (fun e => d^2/(4*Q) ≤ ((arms G U t e.1 e.2).card:ℝ))
  have hcount : (U.card:ℝ)*d ≤ 4*Q^2*(E.card:ℝ) := rich_count (arcs G U)
    (fun e => ((arms G U t e.1 e.2).card:ℝ)) hn.le hQ0 hd harcs harms hsum
  have hthreshold : 4*(s:ℝ)*(Q*d) ≤ d^2/(4*Q) := by
    apply (le_div_iff₀ (by positivity : 0 < 4*Q)).mpr
    nlinarith [mul_le_mul_of_nonneg_right hdlarge hd.le]
  have hlarge (e : W × W) (he : e∈E) : 4*(s:ℝ)*(Q*d) ≤ (arms G U t e.1 e.2).card :=
    hthreshold.trans (mem_filter.mp he).2
  have hmoment := arm_moment_bound G U t s M ht hM hf g hg hD (fun v hv => (hdeg v hv).2)
    E (filter_subset _ _) hlarge
  have hpower := power_of_rich_moment E (fun e => ((arms G U t e.1 e.2).card:ℝ)) s
    hn hQ0 hd hcount (fun e he => (mem_filter.mp he).2) hmoment
  exact degree_of_power s hn.le hd.le (by positivity) hpower

/-- For each fixed degree ratio, the sharp estimate holds in all almost-regular
properly two-colored hosts. -/
theorem exists_regular_bound (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj)
        (g : W → Bool), (∀{u v}, G.Adj u v → g u≠g v) → (graph s M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+(s:ℝ)/((2*s+1:ℕ):ℝ)) := by
  obtain ⟨L,hL,hLs,herr⟩ := exists_error_threshold s hs Q (2*(2*M+(s+1))) hQ (by positivity)
  let B := degreeCoefficient s M Q
  have hB : 0 ≤ B := degreeCoefficient_nonneg s M (by linarith)
  refine ⟨Q*(L+B),by positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^((s:ℝ)/((2*s+1:ℕ):ℝ)) := Real.one_le_rpow hn1 (by positivity)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^((s:ℝ)/((2*s+1:ℕ):ℝ)) := by
    by_cases hdl : d ≤ L
    · nlinarith
    · have hl := large_degree_bound G U hU s M hs hM hf g hg hQ hd
        (hLs.trans (le_of_not_ge hdl)) (herr d (le_of_not_ge hdl)) hdeg
      have hnn : 0 ≤ (U.card:ℝ)^((s:ℝ)/((2*s+1:ℕ):ℝ)) := by positivity
      change d ≤ (L+B)*_ 
      change d ≤ B*_ at hl
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^((s:ℝ)/((2*s+1:ℕ):ℝ))) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp upper bound for every fixed power of the short-root spider. -/
theorem edge_bound (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph s M) (1+(s:ℝ)/((2*s+1:ℕ):ℝ)) D := by
  let γ : ℝ := (s:ℝ)/((2*s+1:ℕ):ℝ)
  have hγ : 0 < γ := by
    have hs0 : (0:ℝ) < s := by exact_mod_cast (show 0<s by omega)
    dsimp [γ]
    positivity
  have hγ1 : γ ≤ 1 := by
    dsimp [γ]
    apply (div_le_one (by positivity)).mpr
    exact_mod_cast (show s ≤ 2*s+1 by omega)
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+γ)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left,Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound s M hs hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph s M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+γ) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.ShortSpider


/- New exact rational exponents from short-root spiders and paired cones. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (s : ℕ) :
    1+(s:ℝ)/((2*s+1:ℕ):ℝ)=2-((s+1:ℕ):ℝ)/((2*s+1:ℕ):ℝ) := by
  have hden : ((2*s+1:ℕ):ℝ)≠0 := by positivity
  push_cast
  field_simp
  <;> ring

theorem supported (s : ℕ) (hs : 1 ≤ s) :
    Supported (template s) (2-((s+1:ℕ):ℝ)/((2*s+1:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound s M hs (by omega)
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (s : ℕ) (hs : 1 ≤ s) : Certificate (s+1) (2*s+1) :=
  ⟨Option (Fin s),Option (Fin s),inferInstance,inferInstance,inferInstance,inferInstance,
    template s,color,color_proper s,connected s,no_isolated s,balance s,supported s hs⟩

theorem iterated_certificate (s t : ℕ) (hs : 1 ≤ s) :
    Certificate (s+1) (2*s+1+t*(s+1)) := by
  induction t with
  | zero => simpa using certificate s hs
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 2*s+1+(t+1)*(s+1)=2*s+1+t*(s+1)+(s+1) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- All exponents `2 - (s+1)/(2s+1+t(s+1))`, including `7/5` at `s=2,t=0`. -/
theorem exact_family (s t : ℕ) (hs : 1 ≤ s) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(s+1:ℚ)/(2*s+1+t*(s+1):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate s t hs).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_seven_fifths :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((7/5:ℚ):ℝ)) := by
  have h := exact_family 2 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.ShortSpider

/-! Choosing one footprint from each large family, with all choices disjoint. -/
namespace Erdos571.DisjointChoice
open Finset

/-- Greedy transversal packing. Each separate family has enough choices to
avoid the blacklist and all the footprints selected from the other families. -/
theorem exists_choice {P W : Type*} [DecidableEq P] [DecidableEq W]
    (a B n : ℕ) (foot : P → Finset W) (F : Fin n → Finset P) (Z : Finset W)
    (hsize : ∀i, ∀p∈F i, (foot p).card ≤ a)
    (hload : ∀i w, ((F i).filter (fun p => w∈foot p)).card ≤ B)
    (hlarge : ∀i, (Z.card+a*n)*B < (F i).card) :
    ∃f : Fin n → P, (∀i, f i∈F i) ∧ (∀i, Disjoint (foot (f i)) Z) ∧
      Pairwise (fun i j => Disjoint (foot (f i)) (foot (f j))) := by
  classical
  induction n with
  | zero => exact ⟨Fin.elim0,by intro i; exact Fin.elim0 i,by intro i; exact Fin.elim0 i,
      by intro i; exact Fin.elim0 i⟩
  | succ n ih =>
    obtain ⟨f,hf,hfZ,hfdis⟩ := ih (fun i => F i.succ)
      (fun i => hsize i.succ) (fun i => hload i.succ) (fun i => by
        have h := hlarge i.succ
        nlinarith)
    let Z' := Z ∪ univ.biUnion (fun i => foot (f i))
    have hZ' : Z'.card ≤ Z.card+a*n := by
      calc
        _ ≤ Z.card+(univ.biUnion (fun i => foot (f i))).card := card_union_le _ _
        _ ≤ Z.card+∑i : Fin n, (foot (f i)).card := Nat.add_le_add_left card_biUnion_le _
        _ ≤ Z.card+∑_i : Fin n, a := Nat.add_le_add_left (sum_le_sum (fun i _ => hsize i.succ _ (hf i))) _
        _ = _ := by simp [mul_comm]
    let Bad := Z'.biUnion (fun w => (F 0).filter (fun p => w∈foot p))
    have hBad : Bad.card ≤ (Z.card+a*n)*B := by
      calc
        _ ≤ ∑w∈Z', ((F 0).filter (fun p => w∈foot p)).card := card_biUnion_le
        _ ≤ ∑_w∈Z', B := sum_le_sum (fun w _ => hload 0 w)
        _ = Z'.card*B := by simp
        _ ≤ _ := Nat.mul_le_mul_right B hZ'
    have hex : ∃p∈F 0, p∉Bad := by
      by_contra! h
      have hc := card_le_card h
      have hl := hlarge 0
      nlinarith
    obtain ⟨p,hp,hpbad⟩ := hex
    have hpdis : Disjoint (foot p) Z' := by
      apply Finset.disjoint_left.mpr
      intro w hw hwZ
      exact hpbad (mem_biUnion.mpr ⟨w,hwZ,mem_filter.mpr ⟨hp,hw⟩⟩)
    refine ⟨Fin.cons p f,?_,?_,?_⟩
    · intro i
      induction i using Fin.cases with
      | zero => exact hp
      | succ i => exact hf i
    · intro i
      induction i using Fin.cases with
      | zero => exact hpdis.mono_right subset_union_left
      | succ i => exact hfZ i
    · intro i j hij
      induction i using Fin.cases with
      | zero =>
        induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j => exact hpdis.mono_right ((subset_biUnion_of_mem (fun i => foot (f i)) (mem_univ j)).trans subset_union_right)
      | succ i =>
        induction j using Fin.cases with
        | zero => exact (hpdis.mono_right ((subset_biUnion_of_mem (fun i => foot (f i)) (mem_univ i)).trans subset_union_right)).symm
        | succ j => exact hfdis (fun he => hij (congrArg Fin.succ he))

end Erdos571.DisjointChoice

/-! A rooted path of length four and its theta powers. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph RootedSunflower

/-- Rooted at the ends, this is a path of length four. -/
def template : SimpleGraph (Option (Fin 2) ⊕ Fin 2) where
  Adj u v := match u,v with
    | .inl a,.inl b => match a,b with
        | none,some _ => True
        | some _,none => True
        | _,_ => False
    | .inl a,.inr r => a=some r
    | .inr r,.inl a => some r=a
    | .inr _,.inr _ => False
  symm := by
    intro u v h
    cases u with
    | inl a =>
      cases v with
      | inl b => cases a <;> cases b <;> exact h
      | inr r => exact h.symm
    | inr r =>
      cases v with
      | inl a => exact h.symm
      | inr r' => exact h
  loopless := by
    intro u
    cases u with
    | inl a => cases a <;> exact not_false
    | inr r => exact not_false

instance : DecidableRel template.Adj := by
  intro u v
  cases u with
  | inl a =>
    cases v with
    | inl b => cases a <;> cases b <;> dsimp [template] <;> infer_instance
    | inr r => dsimp [template]; infer_instance
  | inr r => cases v <;> dsimp [template] <;> infer_instance

def graph (M : ℕ) := FullRootedPower.graph template M

/-- Deleting the short root of the two-arm spider leaves this theta graph. -/
def spiderCopy (M : ℕ) : (graph M).Copy (ShortSpider.graph 2 M) where
  toHom :=
    { toFun := Sum.map id some
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b =>
            rcases a with ⟨i,a⟩
            rcases b with ⟨j,b⟩
            cases a <;> cases b <;> exact h
          | inr r => exact h
        | inr r =>
          cases v with
          | inl a => exact h
          | inr r' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Function.injective_id,Option.some_injective _⟩

lemma spider_free {W : Type*} {G : SimpleGraph W} (M : ℕ) (hf : (graph M).Free G) :
    (ShortSpider.graph 2 M).Free G := fun h => hf ((show graph M ⊑ ShortSpider.graph 2 M from ⟨spiderCopy M⟩).trans h)

lemma no_isolated : ∀u, ∃v, template.Adj u v := by
  intro u
  cases u with
  | inl a =>
    cases a with
    | none => exact ⟨.inl (some 0),trivial⟩
    | some j => exact ⟨.inr j,rfl⟩
  | inr r => exact ⟨.inl (some r),rfl⟩

lemma balance : ∀C : Finset (Option (Fin 2)),
    4*(Fintype.card (Option (Fin 2))-C.card) ≤ 3*Nat.card (PetalEdge template C) := by
  simp only [Nat.card_eq_fintype_card]
  decide

lemma exists_lower : ∃M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(5/4:ℝ))
      (fun n : ℕ => (extremalNumber n (graph M):ℝ)) := by
  have h := FullRootedPower.exact_lower template no_isolated 3 4 (by omega) (by omega) balance
  norm_num at h
  exact h

end Erdos571.ThetaFour

/-! Light three-path fibers have uniformly bounded interior-vertex loads. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

def threeFiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (u x : W) : Finset (W × W) :=
  (U ×ˢ U).filter (fun p => ((u,p.1),(p.2,x))∈ShortSpider.goodWalks G U t)

lemma mem_threeFiber {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t : ℕ} {u x a b : W} :
    (a,b)∈threeFiber G U t u x ↔ u∈U ∧ a∈U ∧ b∈U ∧ x∈U ∧ G.Adj u a ∧ G.Adj a b ∧ G.Adj b x ∧
      ¬ShortSpider.Bad G U t u b ∧ ¬ShortSpider.Bad G U t a x := by
  simp only [threeFiber,ShortSpider.goodWalks,mem_filter,mem_product,ShortSpider.mem_threeWalks]
  tauto

def foot (p : W × W) : Finset W := {p.1,p.2}

lemma threeFiber_row (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (u x w : W) :
    ((threeFiber G U t u x).filter (fun p => p.1=w)).card ≤ t := by
  classical
  let F := (threeFiber G U t u x).filter (fun p => p.1=w)
  by_cases hF : F.Nonempty
  swap
  · rw [show (threeFiber G U t u x).filter (fun p => p.1=w)=∅ from not_nonempty_iff_eq_empty.mp hF,card_empty]
    omega
  obtain ⟨p,hp⟩ := hF
  have hlight : (FourthMoment.common G U w x).card < t := by
    have h := mem_threeFiber.mp (mem_filter.mp hp).1
    have he := (mem_filter.mp hp).2
    exact lt_of_not_ge (fun hh => h.2.2.2.2.2.2.2.2 (Or.inr (he.symm ▸ hh)))
  apply le_trans _ hlight.le
  apply card_le_card_of_injOn Prod.snd
  · intro p hp
    obtain ⟨hp,he⟩ := mem_filter.mp hp
    have h := mem_threeFiber.mp hp
    exact mem_filter.mpr ⟨h.2.2.1,he ▸ h.2.2.2.2.2.1,h.2.2.2.2.2.2.1.symm⟩
  · intro p hp q hq he
    exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) he

lemma threeFiber_col (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (u x w : W) :
    ((threeFiber G U t u x).filter (fun p => p.2=w)).card ≤ t := by
  classical
  let F := (threeFiber G U t u x).filter (fun p => p.2=w)
  by_cases hF : F.Nonempty
  swap
  · rw [show (threeFiber G U t u x).filter (fun p => p.2=w)=∅ from not_nonempty_iff_eq_empty.mp hF,card_empty]
    omega
  obtain ⟨p,hp⟩ := hF
  have hlight : (FourthMoment.common G U u w).card < t := by
    have h := mem_threeFiber.mp (mem_filter.mp hp).1
    have he := (mem_filter.mp hp).2
    exact lt_of_not_ge (fun hh => h.2.2.2.2.2.2.2.1 (Or.inr (he.symm ▸ hh)))
  apply le_trans _ hlight.le
  apply card_le_card_of_injOn Prod.fst
  · intro p hp
    obtain ⟨hp,he⟩ := mem_filter.mp hp
    have h := mem_threeFiber.mp hp
    exact mem_filter.mpr ⟨h.2.1,h.2.2.2.2.1,he ▸ h.2.2.2.2.2.1.symm⟩
  · intro p hp q hq he
    exact Prod.ext he ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm)

lemma threeFiber_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (u x w : W) :
    ((threeFiber G U t u x).filter (fun p => w∈foot p)).card ≤ 2*t := by
  have he : (threeFiber G U t u x).filter (fun p => w∈foot p) =
      ((threeFiber G U t u x).filter (fun p => p.1=w)) ∪
      ((threeFiber G U t u x).filter (fun p => p.2=w)) := by
    ext p; simp only [foot,mem_filter,mem_union,mem_insert,mem_singleton]; tauto
  rw [he]
  have h₁ := threeFiber_row G U t u x w
  have h₂ := threeFiber_col G U t u x w
  have h := card_union_le ((threeFiber G U t u x).filter (fun p => p.1=w)) ((threeFiber G U t u x).filter (fun p => p.2=w))
  omega

lemma threeFiber_endpoints_ne (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {u x : W} (h : (threeFiber G U t u x).Nonempty) : u≠x := by
  obtain ⟨⟨a,b⟩,hab⟩ := h
  obtain ⟨_,_,_,_,hua,hab,hbx,_,_⟩ := mem_threeFiber.mp hab
  have he := ShortSpider.same_color_of_two_steps G g hg hua hab
  intro hux
  exact hg hbx (he.symm.trans (congrArg g hux))

end Erdos571.ThetaFour

/-! Encoding the rooted theta template as an ordinary four-edge path. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph

def pathIndex : Option (Fin 2) ⊕ Fin 2 → Fin 5
  | .inl none => 2
  | .inl (some j) => if j=0 then 1 else 3
  | .inr j => if j=0 then 0 else 4

def pathEquiv : (Option (Fin 2) ⊕ Fin 2) ≃ Fin 5 where
  toFun := pathIndex
  invFun := ![Sum.inr 0,Sum.inl (some 0),Sum.inl none,Sum.inl (some 1),Sum.inr 1]
  left_inv := by decide
  right_inv := by decide

def pathIso : template ≃g pathGraph 5 where
  toEquiv := pathEquiv
  map_rel_iff' := by
    intro a b
    fin_cases a <;> fin_cases b <;> norm_num [pathGraph_adj, pathEquiv, pathIndex, template] <;> decide

def pathCopy {W : Type*} (G : SimpleGraph W) (z u a b x : W)
    (hzu : G.Adj z u) (hua : G.Adj u a) (hab : G.Adj a b) (hbx : G.Adj b x)
    (hza : z≠a) (hzb : z≠b) (hzx : z≠x) (hub : u≠b) (hux : u≠x) (hax : a≠x) :
    template.Copy G := by
  let f : (pathGraph 5).Copy G :=
    { toHom :=
        { toFun := ![z,u,a,b,x]
          map_rel' := by
            intro i j h
            have := hzu.symm
            have := hua.symm
            have := hab.symm
            have := hbx.symm
            fin_cases i <;> fin_cases j <;> simp_all [pathGraph_adj] }
      injective' := by
        intro i j h
        have hzu' := hzu.ne
        have hua' := hua.ne
        have hab' := hab.ne
        have hbx' := hbx.ne
        fin_cases i <;> fin_cases j <;> simp_all }
  exact f.comp pathIso.toCopy

lemma pathCopy_root {W : Type*} (G : SimpleGraph W) (z u a b x : W)
    (hzu) (hua) (hab) (hbx) (hza) (hzb) (hzx) (hub) (hux) (hax) (j : Fin 2) :
    pathCopy G z u a b x hzu hua hab hbx hza hzb hzx hub hux hax (.inr j)=![z,x] j := by
  fin_cases j <;> rfl

lemma pathCopy_center {W : Type*} (G : SimpleGraph W) (z u a b x : W)
    (hzu) (hua) (hab) (hbx) (hza) (hzb) (hzx) (hub) (hux) (hax) :
    pathCopy G z u a b x hzu hua hab hbx hza hzb hzx hub hux hax (.inl none)=a := rfl

lemma pathCopy_mid_zero {W : Type*} (G : SimpleGraph W) (z u a b x : W)
    (hzu) (hua) (hab) (hbx) (hza) (hzb) (hzx) (hub) (hux) (hax) :
    pathCopy G z u a b x hzu hua hab hbx hza hzb hzx hub hux hax (.inl (some 0))=u := rfl

lemma pathCopy_mid_one {W : Type*} (G : SimpleGraph W) (z u a b x : W)
    (hzu) (hua) (hab) (hbx) (hza) (hzb) (hzx) (hub) (hux) (hax) :
    pathCopy G z u a b x hzu hua hab hbx hza hzb hzx hub hux hax (.inl (some 1))=b := rfl

end Erdos571.ThetaFour

/-! Rich light three-path fibers cannot cluster inside a neighborhood. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

lemma contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (z x : W) (hzx : z≠x)
    (u : Fin M ↪ W) (hu : ∀i, G.Adj z (u i))
    (hrich : ∀i, (3*M+2)*(2*t) < (threeFiber G U t (u i) x).card) :
    (graph M).IsContained G := by
  classical
  let Z : Finset W := {z,x} ∪ univ.image u
  have hZ : Z.card ≤ M+2 := by
    change ({z,x} ∪ univ.image u).card ≤ M+2
    have h := card_union_le ({z,x} : Finset W) (univ.image u)
    have hpair : ({z,x} : Finset W).card ≤ 2 := card_le_two
    have hi : (univ.image u).card ≤ M := by simpa using card_image_le (s:=univ) (f:=u)
    omega
  obtain ⟨p,hp,hpZ,hpdis⟩ := DisjointChoice.exists_choice 2 (2*t) M foot
    (fun i => threeFiber G U t (u i) x) Z
    (by intro i p hp; exact card_le_two)
    (fun i w => threeFiber_load G U t (u i) x w)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by omega)) (hrich i))
  have hzne : ∀i w, w∈Z → w≠(p i).1 ∧ w≠(p i).2 := by
    intro i w hw
    constructor <;> intro he <;> apply Finset.disjoint_left.mp (hpZ i) _ hw
    · simp [foot,← he]
    · simp [foot,← he]
  have hz (i) := hzne i z (mem_union_left _ (by simp))
  have hx (i) := hzne i x (mem_union_left _ (by simp))
  have hui (i j : Fin M) := hzne i (u j) (mem_union_right _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩))
  have hux (i : Fin M) : u i≠x := threeFiber_endpoints_ne G U t g hg ⟨p i,hp i⟩
  let f : Fin M → template.Copy G := fun i =>
    pathCopy G z (u i) (p i).1 (p i).2 x (hu i)
      (mem_threeFiber.mp (hp i)).2.2.2.2.1
      (mem_threeFiber.mp (hp i)).2.2.2.2.2.1
      (mem_threeFiber.mp (hp i)).2.2.2.2.2.2.1
      (hz i).1 (hz i).2 hzx (hui i i).2 (hux i) (hx i).1.symm
  let r : Fin 2 ↪ W := ⟨![z,x],by
    intro i j he
    fin_cases i <;> fin_cases j <;> simp_all [Ne.symm hzx]⟩
  have hroot : ∀i j, f i (.inr j)=r j := by
    intro i j
    exact pathCopy_root ..
  have hinside (i) : RootedPacking.interior (f i) ⊆ insert (u i) (foot (p i)) := by
    intro w hw
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,rfl⟩ := hw
    fin_cases a <;> simp [f,pathCopy_center,pathCopy_mid_zero,pathCopy_mid_one,foot]
  have hdis : ∀i j, i≠j → Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j)) := by
    intro i j hij
    apply Disjoint.mono (hinside i) (hinside j)
    apply Finset.disjoint_left.mpr
    intro w hw hw'
    simp only [mem_insert,foot,mem_singleton] at hw hw'
    rcases hw with rfl|he|he <;> rcases hw' with he'|he'|he'
    · exact hij (u.injective he')
    · exact (hui j i).1 he'
    · exact (hui j i).2 he'
    · exact (hui i j).1 (he'.symm.trans he)
    · exact Finset.disjoint_left.mp (hpdis hij) (show w∈foot (p i) by simp [foot,he]) (show w∈foot (p j) by simp [foot,he'])
    · exact Finset.disjoint_left.mp (hpdis hij) (show w∈foot (p i) by simp [foot,he]) (show w∈foot (p j) by simp [foot,he'])
    · exact (hui i j).2 (he'.symm.trans he)
    · exact Finset.disjoint_left.mp (hpdis hij) (show w∈foot (p i) by simp [foot,he]) (show w∈foot (p j) by simp [foot,he'])
    · exact Finset.disjoint_left.mp (hpdis hij) (show w∈foot (p i) by simp [foot,he]) (show w∈foot (p j) by simp [foot,he'])
  have he : RootedPacking.power template M=graph M := by
    ext a b
    cases a <;> cases b <;> rfl
  rw [← he]
  exact ⟨RootedPacking.powerCopy M r f hroot hdis⟩

/-- If theta-four is forbidden, there are fewer than `M` rich endpoints in
any neighborhood other than the target endpoint's own neighborhood. -/
theorem rich_neighbors_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G)
    (z x : W) (hzx : z≠x) :
    ((neighbors G U z).filter (fun u => (3*M+2)*(2*t) < (threeFiber G U t u x).card)).card < M := by
  classical
  by_contra! hc
  obtain ⟨S,hS,hSc⟩ := exists_subset_card_eq hc
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let u : Fin M ↪ W := ⟨fun i => e i,fun i j h => e.injective (Subtype.ext h)⟩
  apply hf (contains_of_rich_neighbors G U t M g hg z x hzx u ?_ ?_)
  · intro i
    exact (mem_filter.mp (mem_filter.mp (hS (e i).property)).1).2
  · intro i
    exact (mem_filter.mp (hS (e i).property)).2

end Erdos571.ThetaFour

namespace Erdos571.RealFiberCount
open Finset

theorem bound {A B : Type*} [DecidableEq A] [DecidableEq B]
    (F : Finset A) (Z : Finset B) (f : A → B) {D : ℝ}
    (hf : Set.MapsTo f F Z) (hD : ∀b∈Z, ((F.filter (fun a => f a=b)).card:ℝ) ≤ D) :
    (F.card:ℝ) ≤ Z.card*D := by
  have he : (F.card:ℝ)=∑b∈Z, ((F.filter (fun a => f a=b)).card:ℝ) := by
    exact_mod_cast card_eq_sum_card_fiberwise hf
  rw [he]
  calc
    _ ≤ ∑_b∈Z,D := sum_le_sum hD
    _ = _ := by simp

end Erdos571.RealFiberCount

namespace Erdos571.ThetaFour
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

lemma fullArms_upper (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    {x : W} (hx : x∈U) : ((ShortSpider.fullArms G U x).card:ℝ) ≤ D^2 := by
  have he : ((ShortSpider.fullArms G U x).card:ℝ)=∑b∈neighbors G U x, ((neighbors G U b).card:ℝ) := by
    exact_mod_cast ShortSpider.fullArms_card G U x
  rw [he]
  calc
    _ ≤ ∑_b∈neighbors G U x,D := sum_le_sum (fun b hb => hdeg b (mem_filter.mp hb).1)
    _ = (neighbors G U x).card*D := by simp
    _ ≤ D^2 := by nlinarith [mul_le_mul_of_nonneg_right (hdeg x hx) hD]

def Rich (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) (u x : W) : Prop :=
  (3*M+2)*(2*t) < (threeFiber G U t u x).card

instance (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) : DecidableRel (Rich G U t M) :=
  fun _ _ => inferInstanceAs (Decidable (_ < _))

def richWalks (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) : Finset ((W × W) × (W × W)) :=
  (ShortSpider.goodWalks G U t).filter (fun p => Rich G U t M p.1.1 p.2.2)

lemma richWalks_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    ((richWalks G U t M).card:ℝ) ≤ (M:ℝ)*U.card*D^2 := by
  classical
  let F := richWalks G U t M
  let Z := U.biUnion (fun x => (ShortSpider.fullArms G U x).image (fun p => (x,p)))
  let pre := fun p : (W × W) × (W × W) => (p.2.2,(p.2.1,p.1.2))
  have hmap : Set.MapsTo pre F Z := by
    rintro ⟨⟨u,a⟩,⟨b,x⟩⟩ hp
    obtain ⟨hp,hr⟩ := mem_filter.mp hp
    obtain ⟨hp,hl⟩ := mem_filter.mp hp
    obtain ⟨hu,ha,hb,hx,hua,hab,hbx⟩ := ShortSpider.mem_threeWalks.mp hp
    exact mem_biUnion.mpr ⟨x,hx,mem_image.mpr ⟨(b,a),mem_filter.mpr
      ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hb,hbx.symm⟩,ha⟩,hab.symm⟩,rfl⟩⟩
  have hfiber (q : W × (W × W)) (hq : q∈Z) : ((F.filter (fun p => pre p=q)).card:ℝ) ≤ M := by
    by_cases hne : (F.filter (fun p => pre p=q)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hne,card_empty,Nat.cast_zero]; positivity
    obtain ⟨p₀,hp₀⟩ := hne
    have hax : q.2.2≠q.1 := by
      obtain ⟨hp₀,he⟩ := mem_filter.mp hp₀
      have hl := (mem_filter.mp (mem_filter.mp hp₀).1).2.2
      have he' := congrArg (fun q : W × (W × W) => (q.2.2,q.1)) he
      change (p₀.1.2,p₀.2.2)=(q.2.2,q.1) at he'
      have hne : p₀.1.2≠p₀.2.2 := fun h => hl (Or.inl h)
      simpa only [Prod.mk.injEq] using (show q.2.2≠q.1 by
        rw [← (Prod.mk.inj he').1,← (Prod.mk.inj he').2]; exact hne)
    have hc : (F.filter (fun p => pre p=q)).card ≤
        ((neighbors G U q.2.2).filter (fun u => Rich G U t M u q.1)).card := by
      apply card_le_card_of_injOn (fun p => p.1.1)
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        obtain ⟨hp,hr⟩ := mem_filter.mp hp
        have hw := ShortSpider.mem_threeWalks.mp (mem_filter.mp hp).1
        have haeq := congrArg (fun q : W × (W × W) => q.2.2) he
        have hxeq := congrArg Prod.fst he
        change p.1.2=q.2.2 at haeq
        change p.2.2=q.1 at hxeq
        exact mem_filter.mpr ⟨mem_filter.mpr ⟨hw.1,haeq ▸ hw.2.2.2.2.1.symm⟩,hxeq ▸ hr⟩
      · intro p hp p' hp' he
        have hpre := (mem_filter.mp hp).2.trans (mem_filter.mp hp').2.symm
        exact Prod.ext (Prod.ext he (congrArg (fun q : W × (W × W) => q.2.2) hpre))
          (Prod.ext (congrArg (fun q : W × (W × W) => q.2.1) hpre) (congrArg Prod.fst hpre))
    exact_mod_cast hc.trans (rich_neighbors_bound G U t M g hg hf q.2.2 q.1 hax).le
  have hF := RealFiberCount.bound F Z pre hmap hfiber
  have hZ : (Z.card:ℝ) ≤ U.card*D^2 := by
    have h : Z.card ≤ ∑x∈U, (ShortSpider.fullArms G U x).card := card_biUnion_le.trans
      (sum_le_sum (fun x _ => card_image_le))
    calc
      _ ≤ ∑x∈U, ((ShortSpider.fullArms G U x).card:ℝ) := by exact_mod_cast h
      _ ≤ ∑_x∈U,D^2 := sum_le_sum (fun x hx => fullArms_upper G U hD hdeg hx)
      _ = _ := by simp
  exact hF.trans (by nlinarith [mul_le_mul_of_nonneg_right hZ (Nat.cast_nonneg M : (0:ℝ) ≤ M)])

end Erdos571.ThetaFour

/-! Bounded loads for four-paths with light two-subpaths and nonrich three-subpaths. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph
variable {W : Type} [DecidableEq W]

structure GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (f : template.Copy G) : Prop where
  mem : ∀v, f v∈U
  left : ¬ShortSpider.Bad G U t (f (.inr 0)) (f (.inl none))
  middle : ¬ShortSpider.Bad G U t (f (.inl (some 0))) (f (.inl (some 1)))
  right : ¬ShortSpider.Bad G U t (f (.inl none)) (f (.inr 1))
  first : ¬Rich G U t M (f (.inr 0)) (f (.inl (some 1)))
  last : ¬Rich G U t M (f (.inl (some 0))) (f (.inr 1))

lemma center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t M f) (hroot : ∀f∈F, ∀j, f (.inr j)=r j)
    (hcenter : ∀f∈F, f (.inl none)=w) : F.card ≤ t^2 := by
  classical
  by_cases hne : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hne
  let A := FourthMoment.common G U (r 0) w
  let B := FourthMoment.common G U w (r 1)
  have hA : A.card ≤ t := by
    have h := (hgood f₀ hf₀).left
    rw [hroot f₀ hf₀,hcenter f₀ hf₀] at h
    exact (lt_of_not_ge (fun hh => h (Or.inr hh))).le
  have hB : B.card ≤ t := by
    have h := (hgood f₀ hf₀).right
    rw [hroot f₀ hf₀,hcenter f₀ hf₀] at h
    exact (lt_of_not_ge (fun hh => h (Or.inr hh))).le
  have hc : F.card ≤ (A ×ˢ B).card := by
    apply card_le_card_of_injOn (fun f => (f (.inl (some 0)),f (.inl (some 1))))
    · intro f hf
      apply mem_product.mpr
      constructor
      · exact mem_filter.mpr ⟨(hgood f hf).mem _,by
          rw [← hroot f hf,← hcenter f hf]
          exact ⟨f.toHom.map_adj (by decide),f.toHom.map_adj (by decide)⟩⟩
      · exact mem_filter.mpr ⟨(hgood f hf).mem _,by
          rw [← hroot f hf,← hcenter f hf]
          exact ⟨f.toHom.map_adj (by decide),f.toHom.map_adj (by decide)⟩⟩
    · intro f hf f' hf' he
      apply Copy.ext
      intro v
      fin_cases v
      · exact (hcenter f hf).trans (hcenter f' hf').symm
      · exact congrArg Prod.fst he
      · exact congrArg Prod.snd he
      · exact (hroot f hf 0).trans (hroot f' hf' 0).symm
      · exact (hroot f hf 1).trans (hroot f' hf' 1).symm
  rw [card_product] at hc
  nlinarith

lemma first_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t M f) (hroot : ∀f∈F, ∀j, f (.inr j)=r j)
    (hfirst : ∀f∈F, f (.inl (some 0))=w) : F.card ≤ (3*M+2)*(2*t) := by
  classical
  by_cases hne : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hne
  have hc : (threeFiber G U t w (r 1)).card ≤ (3*M+2)*(2*t) := by
    have h := (hgood f₀ hf₀).last
    rw [hroot f₀ hf₀,hfirst f₀ hf₀] at h
    exact le_of_not_gt h
  apply le_trans _ hc
  apply card_le_card_of_injOn (fun f => (f (.inl none),f (.inl (some 1))))
  · intro f hf
    rw [← hroot f hf,← hfirst f hf]
    exact mem_threeFiber.mpr ⟨(hgood f hf).mem _,(hgood f hf).mem _,(hgood f hf).mem _,
      (hgood f hf).mem _,f.toHom.map_adj (by decide),f.toHom.map_adj (by decide),
      f.toHom.map_adj (by decide),(hgood f hf).middle,(hgood f hf).right⟩
  · intro f hf f' hf' he
    apply Copy.ext
    intro v
    fin_cases v
    · exact congrArg Prod.fst he
    · exact (hfirst f hf).trans (hfirst f' hf').symm
    · exact congrArg Prod.snd he
    · exact (hroot f hf 0).trans (hroot f' hf' 0).symm
    · exact (hroot f hf 1).trans (hroot f' hf' 1).symm

lemma last_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t M f) (hroot : ∀f∈F, ∀j, f (.inr j)=r j)
    (hlast : ∀f∈F, f (.inl (some 1))=w) : F.card ≤ (3*M+2)*(2*t) := by
  classical
  by_cases hne : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hne
  have hc : (threeFiber G U t (r 0) w).card ≤ (3*M+2)*(2*t) := by
    have h := (hgood f₀ hf₀).first
    rw [hroot f₀ hf₀,hlast f₀ hf₀] at h
    exact le_of_not_gt h
  apply le_trans _ hc
  apply card_le_card_of_injOn (fun f => (f (.inl (some 0)),f (.inl none)))
  · intro f hf
    rw [← hroot f hf,← hlast f hf]
    exact mem_threeFiber.mpr ⟨(hgood f hf).mem _,(hgood f hf).mem _,(hgood f hf).mem _,
      (hgood f hf).mem _,f.toHom.map_adj (by decide),f.toHom.map_adj (by decide),
      f.toHom.map_adj (by decide),(hgood f hf).left,(hgood f hf).middle⟩
  · intro f hf f' hf' he
    apply Copy.ext
    intro v
    fin_cases v
    · exact congrArg Prod.snd he
    · exact congrArg Prod.fst he
    · exact (hlast f hf).trans (hlast f' hf').symm
    · exact (hroot f hf 0).trans (hroot f' hf' 0).symm
    · exact (hroot f hf 1).trans (hroot f' hf' 1).symm

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W)
    (hgood : ∀f∈F, GoodCopy G U t M f) (hroot : ∀f∈F, ∀j, f (.inr j)=r j) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤ t^2+2*((3*M+2)*(2*t)) := by
  classical
  let A := F.filter (fun f => f (.inl none)=w)
  let B := F.filter (fun f => f (.inl (some 0))=w)
  let C := F.filter (fun f => f (.inl (some 1))=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f) ⊆ A ∪ B ∪ C := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    have hf := (mem_filter.mp hf).1
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,he⟩ := hw
    fin_cases a
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,he⟩))
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,he⟩))
    · exact mem_union_right _ (mem_filter.mpr ⟨hf,he⟩)
  have hA := center_count G U t M A r w (fun f hf => hgood f (mem_filter.mp hf).1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hB := first_count G U t M B r w (fun f hf => hgood f (mem_filter.mp hf).1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hC := last_count G U t M C r w (fun f hf => hgood f (mem_filter.mp hf).1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hc := (card_le_card hsub).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  omega

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1 ≤ t) (hf : (graph M).Free G)
    (F : Finset (template.Copy G)) (r : Fin 2 ↪ W)
    (hgood : ∀f∈F, GoodCopy G U t M f) (hroot : ∀f∈F, ∀j, f (.inr j)=r j) :
    F.card < 3*M*(t^2+2*((3*M+2)*(2*t))) := by
  classical
  by_contra! hc
  have hcopy := RootedPacking.power_contained_of_bounded_load F id r hroot
    (t^2+2*((3*M+2)*(2*t))) M (by positivity)
    (interior_load G U t M F r hgood hroot) (by simpa [mul_comm M 3] using hc)
  apply hf
  have he : RootedPacking.power template M=graph M := by
    ext u v
    cases u <;> cases v <;> rfl
  rwa [← he]

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1 ≤ t) (hf : (graph M).Free G)
    (F : Finset (template.Copy G)) (hgood : ∀f∈F, GoodCopy G U t M f) :
    F.card ≤ 3*M*(t^2+2*((3*M+2)*(2*t)))*U.card^2 := by
  classical
  let roots : template.Copy G → (Fin 2 → W) := fun f r => f (.inr r)
  have hbound (r : Fin 2 → W) : (F.filter (fun f => roots f=r)).card ≤ 3*M*(t^2+2*((3*M+2)*(2*t))) := by
    by_cases hne : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · simp only [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hne
    have hr : Function.Injective r := by
      have he := (mem_filter.mp hf₀).2
      rw [← he]
      exact f₀.injective.comp Sum.inr_injective
    exact (rooted_count G U t M ht hf _ ⟨r,hr⟩
      (fun f hf => hgood f (mem_filter.mp hf).1)
      (fun f hf x => congrFun (mem_filter.mp hf).2 x)).le
  have hc := card_le_mul_card_image F (3*M*(t^2+2*((3*M+2)*(2*t)))) (fun r _ => hbound r)
  have hi : (F.image roots).card ≤ U.card^2 := by
    let f : (F.image roots) → (Fin 2 → U) := fun r x =>
      ⟨r.val x,by
        obtain ⟨g,hg,he⟩ := mem_image.mp r.property
        rw [← he]
        exact (hgood g hg).mem _⟩
    have hinj : Function.Injective f := by
      intro r r' h
      apply Subtype.ext
      funext x
      exact congrArg Subtype.val (congrFun h x)
    have h := Fintype.card_le_of_injective f hinj
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using h
  exact hc.trans (Nat.mul_le_mul_left _ hi)

end Erdos571.ThetaFour

/-! Counting light length-four walks using light three-walk extensions. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [DecidableEq W]

abbrev Four (W : Type) := W × ((W × W) × (W × W))

def extend (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (S : Finset ((W × W) × (W × W))) : Finset (Four W) :=
  (U ×ˢ S).filter (fun p => G.Adj p.1 p.2.1.1)

lemma extend_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (S : Finset ((W × W) × (W × W))) :
    (extend G U S).card=∑p∈S, (neighbors G U p.1.1).card := by
  simp only [extend,card_filter,sum_product]
  rw [sum_comm]
  apply sum_congr rfl
  intro p hp
  calc
    _ = ∑z∈U, if G.Adj p.1.1 z then 1 else 0 := by
      apply sum_congr rfl
      intro z hz
      by_cases h : G.Adj z p.1.1
      · simp only [if_pos h,if_pos h.symm]
      · have h' : ¬G.Adj p.1.1 z := fun hh => h hh.symm
        simp only [if_neg h,if_neg h']
    _ = _ := sum_boole (R:=ℕ) (G.Adj p.1.1) U

lemma extend_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (S : Finset ((W × W) × (W × W))) (hS : ∀p∈S, p.1.1∈U)
    {d D : ℝ} (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ D) :
    S.card*d ≤ ((extend G U S).card:ℝ) ∧ ((extend G U S).card:ℝ) ≤ S.card*D := by
  have he : ((extend G U S).card:ℝ)=∑p∈S, ((neighbors G U p.1.1).card:ℝ) := by
    exact_mod_cast extend_card G U S
  rw [he]
  constructor
  · simpa using sum_le_sum (s:=S) (f:=fun _ => d) (fun p hp => (hdeg _ (hS p hp)).1)
  · simpa using sum_le_sum (s:=S) (g:=fun _ => D) (fun p hp => (hdeg _ (hS p hp)).2)

def lightFour (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : Finset (Four W) :=
  (extend G U (ShortSpider.goodWalks G U t)).filter (fun p => ¬ShortSpider.Bad G U t p.1 p.2.1.2)

lemma mem_lightFour {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t : ℕ} {z u a b x : W} :
    (z,((u,a),(b,x)))∈lightFour G U t ↔
      z∈U ∧ u∈U ∧ a∈U ∧ b∈U ∧ x∈U ∧ G.Adj z u ∧ G.Adj u a ∧ G.Adj a b ∧ G.Adj b x ∧
        ¬ShortSpider.Bad G U t z a ∧ ¬ShortSpider.Bad G U t u b ∧ ¬ShortSpider.Bad G U t a x := by
  simp only [lightFour,extend,ShortSpider.goodWalks,mem_filter,mem_product,ShortSpider.mem_threeWalks]
  tauto

lemma extended_bad_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    (((extend G U (ShortSpider.goodWalks G U t)).filter (fun p => ShortSpider.Bad G U t p.1 p.2.1.2)).card:ℝ) ≤
      D^2*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ)) := by
  classical
  let F := (extend G U (ShortSpider.goodWalks G U t)).filter (fun p => ShortSpider.Bad G U t p.1 p.2.1.2)
  let S := (ShortSpider.threeWalks G U).filter (fun p => ShortSpider.Bad G U t p.1.1 p.2.1)
  let pre : Four W → (W × W) × (W × W) := fun p => ((p.1,p.2.1.1),(p.2.1.2,p.2.2.1))
  have hmap : Set.MapsTo pre F S := by
    rintro ⟨z,⟨⟨u,a⟩,⟨b,x⟩⟩⟩ hp
    obtain ⟨hp,hbad⟩ := mem_filter.mp hp
    obtain ⟨⟨hz,hp⟩,hzu⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    obtain ⟨hu,ha,hb,hx,hua,hab,hbx⟩ := ShortSpider.mem_threeWalks.mp (mem_filter.mp hp).1
    exact mem_filter.mpr ⟨ShortSpider.mem_threeWalks.mpr ⟨hz,hu,ha,hb,hzu,hua,hab⟩,hbad⟩
  have hfiber (q : (W × W) × (W × W)) (hq : q∈S) : ((F.filter (fun p => pre p=q)).card:ℝ) ≤ D := by
    have hc : (F.filter (fun p => pre p=q)).card ≤ (neighbors G U q.2.2).card := by
      apply card_le_card_of_injOn (fun p => p.2.2.2)
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        have hp := (mem_product.mp (mem_filter.mp (mem_filter.mp hp).1).1).2
        have hw := ShortSpider.mem_threeWalks.mp (mem_filter.mp hp).1
        have hbeq := congrArg (fun q : (W × W) × (W × W) => q.2.2) he
        change p.2.2.1=q.2.2 at hbeq
        exact mem_filter.mpr ⟨hw.2.2.2.1,hbeq ▸ hw.2.2.2.2.2.2⟩
      · intro p hp p' hp' he
        have hpq := (mem_filter.mp hp).2.trans (mem_filter.mp hp').2.symm
        exact Prod.ext (congrArg (fun q : (W × W) × (W × W) => q.1.1) hpq)
          (Prod.ext (Prod.ext (congrArg (fun q : (W × W) × (W × W) => q.1.2) hpq)
            (congrArg (fun q : (W × W) × (W × W) => q.2.1) hpq))
            (Prod.ext (congrArg (fun q : (W × W) × (W × W) => q.2.2) hpq) he))
    exact (show ((F.filter (fun p => pre p=q)).card:ℝ) ≤ (neighbors G U q.2.2).card by exact_mod_cast hc).trans
      (hdeg _ (ShortSpider.mem_threeWalks.mp (mem_filter.mp hq).1).2.2.2.1)
  have hF := RealFiberCount.bound F S pre hmap hfiber
  have hS := ShortSpider.first_bad_bound G U t hD hdeg
  calc
    _ ≤ S.card*D := hF
    _ ≤ (D*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ)))*D := mul_le_mul_of_nonneg_right hS hD
    _ = _ := by ring

lemma badPairs_sum_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    (∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ)) ≤
      (U.card:ℝ)*D+∑v∈U, ((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ) := by
  calc
    _ ≤ ∑v∈U, (((neighbors G U v).card:ℝ)+(heavyPairs (arcs G U) U t (neighbors G U v)).card) :=
      sum_le_sum (fun v _ => by exact_mod_cast ShortSpider.badPairs_bound G U t v)
    _ ≤ ∑v∈U, (D+((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ)) :=
      sum_le_sum (fun v hv => by linarith [hdeg v hv])
    _ = _ := by rw [sum_add_distrib]; simp

lemma lightFour_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {d D : ℝ} (hd : 0 ≤ d) (hD : 0 ≤ D)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ D) :
    (U.card:ℝ)*d^4 ≤ (lightFour G U t).card +
      (2*d*D+D^2)*((U.card:ℝ)*D+∑v∈U, ((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ)) := by
  have hthree := ShortSpider.goodWalks_lower G U t hd hD hdeg
  have hext := (extend_bound G U (ShortSpider.goodWalks G U t)
    (fun p hp => (ShortSpider.mem_threeWalks.mp (mem_filter.mp hp).1).1) hdeg).1
  have hbad := extended_bad_bound G U t hD (fun v hv => (hdeg v hv).2)
  have hsum := badPairs_sum_bound G U t (fun v hv => (hdeg v hv).2)
  have he : (lightFour G U t).card+
      ((extend G U (ShortSpider.goodWalks G U t)).filter (fun p => ShortSpider.Bad G U t p.1 p.2.1.2)).card =
      (extend G U (ShortSpider.goodWalks G U t)).card := by
    simpa only [lightFour,not_not] using card_filter_add_card_filter_not
      (s:=extend G U (ShortSpider.goodWalks G U t))
      (p:=fun p => ¬ShortSpider.Bad G U t p.1 p.2.1.2)
  have he' : ((lightFour G U t).card:ℝ)+
      ((extend G U (ShortSpider.goodWalks G U t)).filter (fun p => ShortSpider.Bad G U t p.1 p.2.1.2)).card =
      (extend G U (ShortSpider.goodWalks G U t)).card := by exact_mod_cast he
  nlinarith [mul_le_mul_of_nonneg_right hthree hd,mul_le_mul_of_nonneg_left hsum (sq_nonneg D)]

end Erdos571.ThetaFour

/-! Reversal of light three-paths. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph
variable {W : Type} [DecidableEq W]

lemma threeFiber_card_symm (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (u x : W) :
    (threeFiber G U t u x).card=(threeFiber G U t x u).card := by
  apply card_bij (fun p _ => p.swap)
  · rintro ⟨a,b⟩ hp
    obtain ⟨hu,ha,hb,hx,hua,hab,hbx,hl,hr⟩ := mem_threeFiber.mp hp
    exact mem_threeFiber.mpr ⟨hx,hb,ha,hu,hbx.symm,hab.symm,hua.symm,
      fun h => hr ((ShortSpider.bad_symm G U t).mpr h),fun h => hl ((ShortSpider.bad_symm G U t).mpr h)⟩
  · intro p hp q hq he
    exact Prod.swap_injective he
  · rintro ⟨a,b⟩ hp
    obtain ⟨hx,ha,hb,hu,hxa,hab,hbu,hl,hr⟩ := mem_threeFiber.mp hp
    exact ⟨(b,a),mem_threeFiber.mpr ⟨hu,hb,ha,hx,hbu.symm,hab.symm,hxa.symm,
      fun h => hr ((ShortSpider.bad_symm G U t).mpr h),fun h => hl ((ShortSpider.bad_symm G U t).mpr h)⟩,rfl⟩

lemma rich_symm (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) (u x : W) :
    Rich G U t M u x ↔ Rich G U t M x u := by
  unfold Rich
  rw [threeFiber_card_symm G U t u x]

end Erdos571.ThetaFour

/-! Discarding rich three-subpaths and closed light four-walks. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [DecidableEq W]

def reverseFour (p : Four W) : Four W := (p.2.2.2,((p.2.2.1,p.2.1.2),(p.2.1.1,p.1)))

lemma reverseFour_involutive : Function.Involutive (reverseFour : Four W → Four W) := by
  intro p; rfl

lemma mem_lightFour_reverse (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {p : Four W} (hp : p∈lightFour G U t) : reverseFour p∈lightFour G U t := by
  rcases p with ⟨z,⟨⟨u,a⟩,⟨b,x⟩⟩⟩
  obtain ⟨hz,hu,ha,hb,hx,hzu,hua,hab,hbx,hl,hm,hr⟩ := mem_lightFour.mp hp
  exact mem_lightFour.mpr ⟨hx,hb,ha,hu,hz,hbx.symm,hab.symm,hua.symm,hzu.symm,
    fun h => hr ((ShortSpider.bad_symm G U t).mpr h),
    fun h => hm ((ShortSpider.bad_symm G U t).mpr h),
    fun h => hl ((ShortSpider.bad_symm G U t).mpr h)⟩

lemma right_rich_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    (((lightFour G U t).filter (fun p => Rich G U t M p.2.1.1 p.2.2.2)).card:ℝ) ≤
      (M:ℝ)*U.card*D^3 := by
  have hsub : (lightFour G U t).filter (fun p => Rich G U t M p.2.1.1 p.2.2.2) ⊆
      extend G U (richWalks G U t M) := by
    intro p hp
    obtain ⟨hp,hr⟩ := mem_filter.mp hp
    obtain ⟨hp,hl⟩ := mem_filter.mp hp
    obtain ⟨⟨hz,hp⟩,hzu⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    exact mem_filter.mpr ⟨mem_product.mpr ⟨hz,mem_filter.mpr ⟨hp,hr⟩⟩,hzu⟩
  have hext := (extend_bound G U (richWalks G U t M)
    (fun p hp => (ShortSpider.mem_threeWalks.mp (mem_filter.mp (mem_filter.mp hp).1).1).1)
    (d:=0) (fun v hv => ⟨by positivity,hdeg v hv⟩)).2
  have hr := richWalks_bound G U t M g hg hf hD hdeg
  have hc : (((lightFour G U t).filter (fun p => Rich G U t M p.2.1.1 p.2.2.2)).card:ℝ) ≤
      (extend G U (richWalks G U t M)).card := by exact_mod_cast card_le_card hsub
  nlinarith [mul_le_mul_of_nonneg_right hr hD]

lemma left_rich_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) :
    ((lightFour G U t).filter (fun p => Rich G U t M p.1 p.2.2.1)).card=
      ((lightFour G U t).filter (fun p => Rich G U t M p.2.1.1 p.2.2.2)).card := by
  apply card_bij (fun p _ => reverseFour p)
  · intro p hp
    exact mem_filter.mpr ⟨mem_lightFour_reverse G U t (mem_filter.mp hp).1,
      (rich_symm G U t M _ _).mp (mem_filter.mp hp).2⟩
  · intro p hp q hq he
    exact reverseFour_involutive.injective he
  · intro p hp
    refine ⟨reverseFour p,mem_filter.mpr ⟨mem_lightFour_reverse G U t (mem_filter.mp hp).1,?_⟩,rfl⟩
    exact (rich_symm G U t M _ _).mp (mem_filter.mp hp).2

def twoSteps (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) : Finset (W × (W × W)) :=
  U.biUnion (fun x => (ShortSpider.fullArms G U x).image (fun p => (x,p)))

lemma twoSteps_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    ((twoSteps G U).card:ℝ) ≤ U.card*D^2 := by
  have h : (twoSteps G U).card ≤ ∑x∈U, (ShortSpider.fullArms G U x).card := card_biUnion_le.trans
    (sum_le_sum (fun x _ => card_image_le))
  calc
    _ ≤ ∑x∈U, ((ShortSpider.fullArms G U x).card:ℝ) := by exact_mod_cast h
    _ ≤ ∑_x∈U,D^2 := sum_le_sum (fun x hx => fullArms_upper G U hD hdeg hx)
    _ = _ := by simp

lemma closed_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    (((lightFour G U t).filter (fun p => p.1=p.2.2.2)).card:ℝ) ≤ (t:ℝ)*U.card*D^2 := by
  classical
  let F := (lightFour G U t).filter (fun p => p.1=p.2.2.2)
  let pre : Four W → W × (W × W) := fun p => (p.1,p.2.1)
  have hmap : Set.MapsTo pre F (twoSteps G U) := by
    rintro ⟨z,⟨⟨u,a⟩,⟨b,x⟩⟩⟩ hp
    obtain ⟨hz,hu,ha,hb,hx,hzu,hua,hab,hbx,hl,hm,hr⟩ := mem_lightFour.mp (mem_filter.mp hp).1
    exact mem_biUnion.mpr ⟨z,hz,mem_image.mpr ⟨(u,a),mem_filter.mpr
      ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hu,hzu⟩,ha⟩,hua⟩,rfl⟩⟩
  have hfiber (q : W × (W × W)) (hq : q∈twoSteps G U) : ((F.filter (fun p => pre p=q)).card:ℝ) ≤ t := by
    by_cases hne : (F.filter (fun p => pre p=q)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hne,card_empty,Nat.cast_zero]; positivity
    obtain ⟨p₀,hp₀⟩ := hne
    have hcommon : (FourthMoment.common G U q.1 q.2.2).card ≤ t := by
      have hpre := (mem_filter.mp hp₀).2
      have hl := (mem_lightFour.mp (mem_filter.mp (mem_filter.mp hp₀).1).1).2.2.2.2.2.2.2.2.2.1
      have h₁ := congrArg Prod.fst hpre
      have h₂ := congrArg (fun q : W × (W × W) => q.2.2) hpre
      change p₀.1=q.1 at h₁
      change p₀.2.1.2=q.2.2 at h₂
      rw [h₁,h₂] at hl
      exact (lt_of_not_ge (fun hh => hl (Or.inr hh))).le
    have hc : (F.filter (fun p => pre p=q)).card ≤ (FourthMoment.common G U q.1 q.2.2).card := by
      apply card_le_card_of_injOn (fun p => p.2.2.1)
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        obtain ⟨hp,hclosed⟩ := mem_filter.mp hp
        have hw := mem_lightFour.mp hp
        have h₁ := congrArg Prod.fst he
        have h₂ := congrArg (fun q : W × (W × W) => q.2.2) he
        change p.1=q.1 at h₁
        change p.2.1.2=q.2.2 at h₂
        refine mem_filter.mpr ⟨hw.2.2.2.1,?_,?_⟩
        · rw [← h₁,hclosed]
          exact hw.2.2.2.2.2.2.2.2.1.symm
        · rw [← h₂]
          exact hw.2.2.2.2.2.2.2.1
      · intro p hp p' hp' he
        have hpre := (mem_filter.mp hp).2.trans (mem_filter.mp hp').2.symm
        have hclosed := (mem_filter.mp (mem_filter.mp hp).1).2
        have hclosed' := (mem_filter.mp (mem_filter.mp hp').1).2
        have hz := congrArg Prod.fst hpre
        exact Prod.ext hz (Prod.ext (congrArg Prod.snd hpre) (Prod.ext he (hclosed.symm.trans (hz.trans hclosed'))))
    exact_mod_cast hc.trans hcommon
  have hF := RealFiberCount.bound F (twoSteps G U) pre hmap hfiber
  have hZ := twoSteps_bound G U hD hdeg
  nlinarith [mul_le_mul_of_nonneg_right hZ (Nat.cast_nonneg t : (0:ℝ) ≤ t)]

def goodFour (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) : Finset (Four W) :=
  (lightFour G U t).filter (fun p => ¬Rich G U t M p.1 p.2.2.1 ∧
    ¬Rich G U t M p.2.1.1 p.2.2.2 ∧ p.1≠p.2.2.2)

lemma goodFour_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G)
    {d D : ℝ} (hd : 0 ≤ d) (hD : 0 ≤ D)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ D) :
    (U.card:ℝ)*d^4 ≤ (goodFour G U t M).card +
      (2*d*D+D^2)*((U.card:ℝ)*D+∑v∈U, ((heavyPairs (arcs G U) U t (neighbors G U v)).card:ℝ))+
      (2*(M:ℝ)*D+t)*U.card*D^2 := by
  classical
  let A := (lightFour G U t).filter (fun p => Rich G U t M p.1 p.2.2.1)
  let B := (lightFour G U t).filter (fun p => Rich G U t M p.2.1.1 p.2.2.2)
  let C := (lightFour G U t).filter (fun p => p.1=p.2.2.2)
  have hsub : lightFour G U t ⊆ goodFour G U t M ∪ A ∪ B ∪ C := by
    intro p hp
    by_cases h₁ : Rich G U t M p.1 p.2.2.1
    · exact mem_union_left _ (mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hp,h₁⟩)))
    by_cases h₂ : Rich G U t M p.2.1.1 p.2.2.2
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hp,h₂⟩))
    by_cases h₃ : p.1=p.2.2.2
    · exact mem_union_right _ (mem_filter.mpr ⟨hp,h₃⟩)
    exact mem_union_left _ (mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hp,h₁,h₂,h₃⟩)))
  have hc := (card_le_card hsub).trans ((card_union_le _ _).trans
    (Nat.add_le_add_right ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _)) _))
  have hc' : ((lightFour G U t).card:ℝ) ≤ (goodFour G U t M).card+A.card+B.card+C.card := by exact_mod_cast hc
  have hAB : A.card=B.card := left_rich_card G U t M
  have hAB' : (A.card:ℝ)=B.card := by exact_mod_cast hAB
  have hB : (B.card:ℝ) ≤ (M:ℝ)*U.card*D^3 := right_rich_bound G U t M g hg hf hD (fun v hv => (hdeg v hv).2)
  have hC : (C.card:ℝ) ≤ (t:ℝ)*U.card*D^2 := closed_bound G U t hD (fun v hv => (hdeg v hv).2)
  have hL := lightFour_lower G U t hd hD hdeg
  nlinarith

end Erdos571.ThetaFour

/-! Simple good four-walks are distinct good rooted-template copies. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph
variable {W : Type} [DecidableEq W]

def walkCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (p : Four W) (hp : p∈goodFour G U t M) : template.Copy G := by
  let z := p.1
  let u := p.2.1.1
  let a := p.2.1.2
  let b := p.2.2.1
  let x := p.2.2.2
  have hw := mem_lightFour.mp (mem_filter.mp hp).1
  have hzu : G.Adj z u := hw.2.2.2.2.2.1
  have hua : G.Adj u a := hw.2.2.2.2.2.2.1
  have hab : G.Adj a b := hw.2.2.2.2.2.2.2.1
  have hbx : G.Adj b x := hw.2.2.2.2.2.2.2.2.1
  have hza : z≠a := fun h => hw.2.2.2.2.2.2.2.2.2.1 (Or.inl h)
  have hub : u≠b := fun h => hw.2.2.2.2.2.2.2.2.2.2.1 (Or.inl h)
  have hax : a≠x := fun h => hw.2.2.2.2.2.2.2.2.2.2.2 (Or.inl h)
  have hzb : z≠b := by
    have hcol := ShortSpider.same_color_of_two_steps G g hg hzu hua
    intro he
    exact hg hab (hcol.symm.trans (congrArg g he))
  have hux : u≠x := by
    have hcol := ShortSpider.same_color_of_two_steps G g hg hua hab
    intro he
    exact hg hbx (hcol.symm.trans (congrArg g he))
  exact pathCopy G z u a b x hzu hua hab hbx hza hzb (mem_filter.mp hp).2.2.2 hub hux hax

lemma walkCopy_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (p : Four W) (hp : p∈goodFour G U t M) : GoodCopy G U t M (walkCopy G U t M g hg p hp) := by
  rcases p with ⟨z,⟨⟨u,a⟩,⟨b,x⟩⟩⟩
  obtain ⟨hp',hfirst,hlast,hzx⟩ := mem_filter.mp hp
  obtain ⟨hz,hu,ha,hb,hx,hzu,hua,hab,hbx,hl,hm,hr⟩ := mem_lightFour.mp hp'
  refine ⟨?_,hl,hm,hr,hfirst,hlast⟩
  intro v
  fin_cases v
  · exact ha
  · exact hu
  · exact hb
  · exact hz
  · exact hx

lemma walkCopy_injective (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    Function.Injective (fun p : goodFour G U t M => walkCopy G U t M g hg p.val p.property) := by
  intro p q he
  apply Subtype.ext
  refine Prod.ext ?_ (Prod.ext (Prod.ext ?_ ?_) (Prod.ext ?_ ?_))
  · exact congrArg (fun f : template.Copy G => f (.inr 0)) he
  · exact congrArg (fun f : template.Copy G => f (.inl (some 0))) he
  · exact congrArg (fun f : template.Copy G => f (.inl none)) he
  · exact congrArg (fun f : template.Copy G => f (.inl (some 1))) he
  · exact congrArg (fun f : template.Copy G => f (.inr 1)) he

lemma goodFour_upper (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1 ≤ t) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G) :
    (goodFour G U t M).card ≤ 3*M*(t^2+2*((3*M+2)*(2*t)))*U.card^2 := by
  classical
  let f := fun p : goodFour G U t M => walkCopy G U t M g hg p.val p.property
  let F := (goodFour G U t M).attach.image f
  have hcard : F.card=(goodFour G U t M).card := by
    rw [card_image_of_injective _ (walkCopy_injective G U t M g hg),card_attach]
  rw [← hcard]
  apply good_count G U t M ht hf F
  intro f' hf'
  obtain ⟨p,hp,rfl⟩ := mem_image.mp hf'
  exact walkCopy_good G U t M g hg p.val p.property

end Erdos571.ThetaFour

/-! Large-degree absorption of lower-order walk-counting errors. -/
namespace Erdos571.ThetaFour
open Filter Asymptotics

lemma rpow_littleO {a b : ℝ} (hab : a<b) :
    (fun x : ℝ => x^a) =o[atTop] (fun x : ℝ => x^b) := by
  apply (isLittleO_iff_tendsto' ?_).mpr
  · refine (tendsto_rpow_neg_atTop (sub_pos.mpr hab)).congr' ?_
    filter_upwards [eventually_gt_atTop (0:ℝ)] with x hx
    rw [neg_sub,Real.rpow_sub hx]
  · filter_upwards [eventually_gt_atTop (0:ℝ)] with x hx
    intro h
    exact (ne_of_gt (Real.rpow_pos_of_pos hx b) h).elim

lemma exists_error_threshold (Q C M t : ℝ) (hQ : 1 ≤ Q) :
    ∃L : ℝ, 1 ≤ L ∧ ∀d : ℝ, L ≤ d →
      (2*d*(Q*d)+(Q*d)^2)*(Q*d+C*(Q*d)^(3/2:ℝ))+
        (2*M*(Q*d)+t)*(Q*d)^2 ≤ d^4/2 := by
  let A := (2*Q+Q^2)*Q+2*M*Q^3
  let B := (2*Q+Q^2)*C*Q^(3/2:ℝ)
  let T := t*Q^2
  have ho : (fun d : ℝ => A*d^(3:ℝ)+B*d^(7/2:ℝ)+T*d^(2:ℝ)) =o[atTop] (fun d : ℝ => d^(4:ℝ)) :=
    (((rpow_littleO (by norm_num : (3:ℝ)<4)).const_mul_left A).add
      ((rpow_littleO (by norm_num : (7/2:ℝ)<4)).const_mul_left B)).add
      ((rpow_littleO (by norm_num : (2:ℝ)<4)).const_mul_left T)
  obtain ⟨L₀,hL₀⟩ := eventually_atTop.mp (ho.def (c:=1/2) (by norm_num))
  refine ⟨max 1 L₀,le_max_left _ _,?_⟩
  intro d hd
  have hd1 : 1 ≤ d := (le_max_left _ _).trans hd
  have hd0 : 0 < d := by linarith
  have he := hL₀ d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hd0.le _)] at he
  have heq : (2*d*(Q*d)+(Q*d)^2)*(Q*d+C*(Q*d)^(3/2:ℝ))+
      (2*M*(Q*d)+t)*(Q*d)^2=A*d^(3:ℝ)+B*d^(7/2:ℝ)+T*d^(2:ℝ) := by
    rw [Real.mul_rpow (by linarith : 0 ≤ Q) hd0.le,
      show (7/2:ℝ)=2+3/2 by norm_num,Real.rpow_add hd0]
    norm_num
    dsimp [A,B,T]
    ring
  rw [heq]
  have h := (le_abs_self (A*d^(3:ℝ)+B*d^(7/2:ℝ)+T*d^(2:ℝ))).trans he
  norm_num at h ⊢
  linarith

lemma degree_of_power {n d B : ℝ} (hn : 0 ≤ n) (hd : 0 ≤ d) (hB : 0 ≤ B)
    (h : d^4 ≤ B*n) : d ≤ B^(1/4:ℝ)*n^(1/4:ℝ) := by
  have hh := Real.rpow_le_rpow (pow_nonneg hd _) h (by norm_num : (0:ℝ) ≤ 1/4)
  rw [← Real.rpow_natCast d 4] at hh
  norm_num only [Nat.cast_ofNat] at hh
  rw [show (1/4:ℝ)=(4:ℝ)⁻¹ by norm_num,
    Real.rpow_rpow_inv hd (by norm_num),Real.mul_rpow hB hn] at hh
  simpa only [one_div] using hh

end Erdos571.ThetaFour

/-! The sharp ordinary upper bound for theta graphs with four-edge branches. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeCoefficient (M : ℕ) : ℝ :=
  (2*(3*M*((M*2+M+2+1)^2+2*((3*M+2)*(2*(M*2+M+2+1)))):ℕ):ℝ)^(1/4:ℝ)

lemma degreeCoefficient_nonneg (M : ℕ) : 0 ≤ degreeCoefficient M := by
  unfold degreeCoefficient
  positivity

lemma large_degree_bound {W : Type} [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (M : ℕ) (hM : 1 ≤ M) (hf : (graph M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 0 < d)
    (herr : (2*d*(Q*d)+(Q*d)^2)*(Q*d+(2*(2*M+3))*(Q*d)^(3/2:ℝ))+
      (2*(M:ℝ)*(Q*d)+(M*2+M+2+1:ℕ))*(Q*d)^2 ≤ d^4/2)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) :
    d ≤ degreeCoefficient M*(U.card:ℝ)^(1/4:ℝ) := by
  classical
  let t := M*2+M+2+1
  have ht : 1 ≤ t := by dsimp [t]; omega
  have hn : (0:ℝ) < U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0 ≤ Q*d := by positivity
  have hh := ShortSpider.heavy_sum_bound G U 2 M (by omega) hM (spider_free M hf) hD
    (fun v hv => (hdeg v hv).2)
  norm_num only [Nat.cast_ofNat,show (2-1/(2:ℝ))=3/2 by norm_num] at hh
  have hp := goodFour_lower G U t M g hg hf hd.le hD hdeg
  have hgcount : (U.card:ℝ)*d^4/2 ≤ (goodFour G U t M).card := by
    have h₁ := mul_le_mul_of_nonneg_left hh (show 0 ≤ 2*d*(Q*d)+(Q*d)^2 by positivity)
    have h₂ := mul_le_mul_of_nonneg_left herr hn.le
    dsimp [t] at hp ⊢
    nlinarith
  have hc : ((goodFour G U t M).card:ℝ) ≤
      (3*M*(t^2+2*((3*M+2)*(2*t))):ℕ)*(U.card:ℝ)^2 := by
    exact_mod_cast goodFour_upper G U t M ht g hg hf
  have hpower : d^4 ≤ (2*(3*M*(t^2+2*((3*M+2)*(2*t))):ℕ):ℝ)*U.card := by
    apply (mul_le_mul_iff_right₀ hn).mp
    nlinarith
  exact degree_of_power hn.le hd.le (by positivity) hpower

/-- Every fixed almost-regular degree ratio admits the sharp exponent. -/
theorem exists_regular_bound (M : ℕ) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj)
        (g : W → Bool), (∀{u v}, G.Adj u v → g u≠g v) → (graph M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(5/4:ℝ) := by
  obtain ⟨L,hL,herr⟩ := exists_error_threshold Q (2*(2*M+3)) M (M*2+M+2+1:ℕ) hQ
  let B := degreeCoefficient M
  have hB : 0 ≤ B := degreeCoefficient_nonneg M
  refine ⟨Q*(L+B),by positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^(1/4:ℝ) := Real.one_le_rpow hn1 (by norm_num)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^(1/4:ℝ) := by
    by_cases hdl : d ≤ L
    · nlinarith
    · have hl := large_degree_bound G U hU M hM hf g hg hQ hd (herr d (le_of_not_ge hdl)) hdeg
      have hnn : 0 ≤ (U.card:ℝ)^(1/4:ℝ) := by positivity
      change d ≤ B*_ at hl
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^(1/4:ℝ)) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [show (5/4:ℝ)=1+1/4 by norm_num,Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp upper bound for every fixed theta-four multiplicity. -/
theorem edge_bound (M : ℕ) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph M) (5/4:ℝ) D := by
  let γ : ℝ := 1/4
  have hγ : 0 < γ := by norm_num [γ]
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((5/4:ℝ)-1) := by
    dsimp [K]
    rw [show (5/4:ℝ)-1=γ by norm_num [γ],Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound M hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=5/4) (K:=K) (D:=D)
    (by norm_num) (by norm_num) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.ThetaFour

/-! Exact rational exponents from theta-four and its paired cones. -/
namespace Erdos571.ThetaFour
open Finset SimpleGraph OrdinaryRooted

def color : Option (Fin 2) ⊕ Fin 2 → Bool
  | .inl none => false
  | .inl (some _) => true
  | .inr _ => false

lemma color_proper : ∀{u v}, template.Adj u v → color u≠color v := by
  intro u v
  fin_cases u <;> fin_cases v <;> decide

lemma connected : template.Connected := by
  have hreach (u : Option (Fin 2) ⊕ Fin 2) : template.Reachable u (.inl none) := by
    cases u with
    | inl a =>
      cases a with
      | none => exact Reachable.rfl
      | some j => exact (show template.Adj (.inl (some j)) (.inl none) from trivial).reachable
    | inr j =>
      exact (show template.Adj (.inr j) (.inl (some j)) from rfl).reachable.trans
        (show template.Adj (.inl (some j)) (.inl none) from trivial).reachable
  exact { preconnected := fun u v => (hreach u).trans (hreach v).symm, nonempty := inferInstance }

theorem supported : Supported template (2-(3:ℝ)/4) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound M (by omega)
  norm_num
  exact ⟨D,hD,hbound⟩

theorem certificate : Certificate 3 4 :=
  ⟨Option (Fin 2),Fin 2,inferInstance,inferInstance,inferInstance,inferInstance,
    template,color,color_proper,connected,no_isolated,balance,supported⟩

theorem iterated_certificate (t : ℕ) : Certificate 3 (4+3*t) := by
  induction t with
  | zero => simpa using certificate
  | succ t ih =>
    have h := ih.cone (by omega) (by omega)
    convert h using 1 <;> omega

/-- The theta-four family includes the exact exponent `5/4`. -/
theorem exact_family (t : ℕ) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-3/(4+3*t:ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate t).realizes (by omega) (by omega)
  push_cast at h ⊢
  exact h

theorem exponent_five_fourths :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((5/4:ℚ):ℝ)) := by
  have h := exact_family 0
  norm_num at h ⊢
  exact h

end Erdos571.ThetaFour

/- Rooted graphs with independent roots, split into core and incidence edges. -/
namespace Erdos571.RootedIncidence
open Finset SimpleGraph RootedSunflower
variable {A R : Type*}

def graph (K : SimpleGraph A) (E : A → R → Prop) : SimpleGraph (A ⊕ R) where
  Adj u v := match u,v with
    | .inl a,.inl b => K.Adj a b
    | .inl a,.inr r => E a r
    | .inr r,.inl a => E a r
    | .inr _,.inr _ => False
  symm := by
    intro u v h
    cases u <;> cases v
    · exact h.symm
    all_goals exact h
  loopless := by
    intro u
    cases u
    · exact K.loopless _
    · exact not_false

instance (K : SimpleGraph A) (E : A → R → Prop) [DecidableRel K.Adj] [DecidableRel E] :
    DecidableRel (graph K E).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [graph] <;> infer_instance

def coreCopy (K : SimpleGraph A) (E : A → R → Prop) : K.Copy (graph K E) where
  toHom := { toFun := Sum.inl, map_rel' := fun h => h }
  injective' := Sum.inl_injective

abbrev CorePetal (K : SimpleGraph A) (C : Finset A) :=
  {e : K.edgeSet // ∃a, a∉C ∧ a∈e.val}

abbrev RootPetal (E : A → R → Prop) (C : Finset A) :=
  {p : A × R // p.1∉C ∧ E p.1 p.2}

def corePetal (K : SimpleGraph A) (E : A → R → Prop) (C : Finset A) :
    CorePetal K C → PetalEdge (graph K E) C := fun e =>
  ⟨(coreCopy K E).toHom.mapEdgeSet e.val,by
    obtain ⟨a,ha,hae⟩ := e.property
    exact ⟨a,ha,Sym2.mem_map.mpr ⟨a,hae,rfl⟩⟩⟩

def rootPetal (K : SimpleGraph A) (E : A → R → Prop) (C : Finset A) :
    RootPetal E C → PetalEdge (graph K E) C := fun p =>
  ⟨⟨s(.inl p.val.1,.inr p.val.2),p.property.2⟩,p.val.1,p.property.1,by simp⟩

lemma petal_injective (K : SimpleGraph A) (E : A → R → Prop) (C : Finset A) :
    Function.Injective (Sum.elim (corePetal K E C) (rootPetal K E C)) := by
  apply Sum.elim_injective.mpr
  refine ⟨?_,?_,?_⟩
  · intro e f he
    apply Subtype.ext
    exact Hom.mapEdgeSet.injective (coreCopy K E).toHom Sum.inl_injective (congrArg Subtype.val he)
  · intro p q he
    have h := congrArg (fun e => e.val.val) he
    simp only [rootPetal,Sym2.eq_iff,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,false_and,or_false] at h
    exact Subtype.ext (Prod.ext h.1 h.2)
  · intro e p he
    have hm : Sum.inr p.val.2∈(corePetal K E C e).val.val := by
      rw [he]
      simp [rootPetal]
    obtain ⟨a,ha,he⟩ := Sym2.mem_map.mp hm
    exact Sum.inl_ne_inr he

lemma petal_surjective (K : SimpleGraph A) (E : A → R → Prop) (C : Finset A) :
    Function.Surjective (Sum.elim (corePetal K E C) (rootPetal K E C)) := by
  intro e
  obtain ⟨a,ha,hae⟩ := e.property
  obtain ⟨v,hv⟩ := Sym2.mem_iff_exists.mp hae
  have he : (graph K E).Adj (.inl a) v := by
    have h := e.val.property
    rwa [hv] at h
  cases v with
  | inl b =>
    let f : CorePetal K C := ⟨⟨s(a,b),he⟩,a,ha,by simp⟩
    refine ⟨.inl f,?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact hv.symm
  | inr r =>
    let p : RootPetal E C := ⟨(a,r),ha,he⟩
    refine ⟨.inr p,?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact hv.symm

lemma petal_card [Fintype A] [Fintype R] (K : SimpleGraph A) (E : A → R → Prop) (C : Finset A) :
    Nat.card (PetalEdge (graph K E) C)=Nat.card (CorePetal K C)+Nat.card (RootPetal E C) := by
  classical
  have h := Nat.card_congr (Equiv.ofBijective _ ⟨petal_injective K E C,petal_surjective K E C⟩)
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum] using h.symm

/-- Keeping only the distinguished root incidences defines the anchor graph. -/
def anchor (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) : SimpleGraph (A ⊕ R) :=
  graph K (fun a r => E a r ∧ r=r₀)

/-- Every set of nonroots touches at least as many anchor edges as vertices. -/
def Anchored [Fintype A] (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) : Prop :=
  ∀C : Finset A, Fintype.card A-C.card ≤ Nat.card (PetalEdge (anchor K E r₀) C)

end Erdos571.RootedIncidence

/- Subdivide all root incidences except those at one distinguished root. -/
namespace Erdos571.RootStretch
open Finset SimpleGraph RootedSunflower RootedIncidence
variable {A R : Type*}

abbrev Middle (E : A → R → Prop) (r₀ : R) := {p : A × R // E p.1 p.2 ∧ p.2≠r₀}
abbrev Nonroot (E : A → R → Prop) (r₀ : R) := A ⊕ Middle E r₀

def core (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) : SimpleGraph (Nonroot E r₀) :=
  RootedIncidence.graph K (fun a p => a=p.val.1)

def incidence (E : A → R → Prop) (r₀ : R) : Nonroot E r₀ → R → Prop
  | .inl a,r => E a r ∧ r=r₀
  | .inr p,r => p.val.2=r

def graph (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) : SimpleGraph (Nonroot E r₀ ⊕ R) :=
  RootedIncidence.graph (core K E r₀) (incidence E r₀)

def old (E : A → R → Prop) (r₀ : R) : A ⊕ R ↪ Nonroot E r₀ ⊕ R :=
  Function.Embedding.sumMap Function.Embedding.inl (Function.Embedding.refl _)

def middle (E : A → R → Prop) (r₀ : R) (p : Middle E r₀) : Nonroot E r₀ ⊕ R :=
  .inl (.inr p)

def color [DecidableEq R] (c : A ⊕ R → Bool) (E : A → R → Prop) (r₀ : R) : Nonroot E r₀ ⊕ R → Bool
  | .inl (.inl a) => c (.inl a)
  | .inl (.inr p) => !(c (.inl p.val.1))
  | .inr r => if r=r₀ then c (.inr r) else !(c (.inr r))

lemma color_proper [DecidableEq R] (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (c : A ⊕ R → Bool) (hc : ∀{u v}, (RootedIncidence.graph K E).Adj u v → c u≠c v) :
    ∀{u v}, (graph K E r₀).Adj u v → color c E r₀ u≠color c E r₀ v := by
  intro u v h
  rcases u with (a | p) | r <;> rcases v with (b | q) | s
  · exact hc h
  · change a=q.val.1 at h
    subst a
    change c (.inl q.val.1)≠!(c (.inl q.val.1))
    cases c (.inl q.val.1) <;> decide
  · change E a s ∧ s=r₀ at h
    simpa only [color,if_pos h.2] using hc (show (RootedIncidence.graph K E).Adj (.inl a) (.inr s) from h.1)
  · change b=p.val.1 at h
    subst b
    change (!(c (.inl p.val.1)))≠c (.inl p.val.1)
    cases c (.inl p.val.1) <;> decide
  · exact h.elim
  · change p.val.2=s at h
    subst s
    have he := hc (show (RootedIncidence.graph K E).Adj (.inl p.val.1) (.inr p.val.2) from p.property.1)
    simp only [color,if_neg p.property.2]
    cases h₁ : c (.inl p.val.1) <;> cases h₂ : c (.inr p.val.2) <;> simp_all
  · change E b r ∧ r=r₀ at h
    simpa only [color,if_pos h.2] using hc (show (RootedIncidence.graph K E).Adj (.inr r) (.inl b) from h.1)
  · change q.val.2=r at h
    subst r
    have he := hc (show (RootedIncidence.graph K E).Adj (.inr q.val.2) (.inl q.val.1) from q.property.1)
    simp only [color,if_neg q.property.2]
    cases h₁ : c (.inr q.val.2) <;> cases h₂ : c (.inl q.val.1) <;> simp_all
  · exact h.elim

lemma old_adj_reachable (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    {u v : A ⊕ R} (h : (RootedIncidence.graph K E).Adj u v) :
    (graph K E r₀).Reachable (old E r₀ u) (old E r₀ v) := by
  classical
  have hcross {a : A} {r : R} (h : E a r) :
      (graph K E r₀).Reachable (old E r₀ (.inl a)) (old E r₀ (.inr r)) := by
    by_cases hr : r=r₀
    · exact (show (graph K E r₀).Adj (old E r₀ (.inl a)) (old E r₀ (.inr r)) from ⟨h,hr⟩).reachable
    · let p : Middle E r₀ := ⟨(a,r),h,hr⟩
      exact (show (graph K E r₀).Adj (old E r₀ (.inl a)) (middle E r₀ p) from rfl).reachable.trans
        (show (graph K E r₀).Adj (middle E r₀ p) (old E r₀ (.inr r)) from rfl).reachable
  cases u with
  | inl a =>
    cases v with
    | inl b => exact (show (graph K E r₀).Adj (old E r₀ (.inl a)) (old E r₀ (.inl b)) from h).reachable
    | inr r => exact hcross h
  | inr r =>
    cases v with
    | inl a => exact (hcross h).symm
    | inr s => exact h.elim

lemma old_reachable (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    {u v : A ⊕ R} (h : (RootedIncidence.graph K E).Reachable u v) :
    (graph K E r₀).Reachable (old E r₀ u) (old E r₀ v) := by
  obtain ⟨p⟩ := h
  induction p with
  | nil => exact Reachable.rfl
  | cons h p ih => exact (old_adj_reachable K E r₀ h).trans ih

lemma connected (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (hH : (RootedIncidence.graph K E).Connected) : (graph K E r₀).Connected := by
  have hroot (v : Nonroot E r₀ ⊕ R) : (graph K E r₀).Reachable v (old E r₀ (.inr r₀)) := by
    rcases v with (a | p) | r
    · exact old_reachable K E r₀ (hH.preconnected (.inl a) (.inr r₀))
    · exact (show (graph K E r₀).Adj (middle E r₀ p) (old E r₀ (.inl p.val.1)) from rfl).reachable.trans
        (old_reachable K E r₀ (hH.preconnected _ _))
    · exact old_reachable K E r₀ (hH.preconnected (.inr r) (.inr r₀))
  exact { preconnected := fun u v => (hroot u).trans (hroot v).symm,nonempty := ⟨.inr r₀⟩ }

lemma no_isolated (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (hH : ∀u, ∃v, (RootedIncidence.graph K E).Adj u v) :
    ∀u, ∃v, (graph K E r₀).Adj u v := by
  classical
  intro u
  rcases u with (a | p) | r
  · obtain ⟨v,hv⟩ := hH (.inl a)
    cases v with
    | inl b => exact ⟨old E r₀ (.inl b),hv⟩
    | inr s =>
      by_cases hs : s=r₀
      · exact ⟨old E r₀ (.inr s),hv,hs⟩
      · exact ⟨middle E r₀ ⟨(a,s),hv,hs⟩,rfl⟩
  · exact ⟨old E r₀ (.inl p.val.1),rfl⟩
  · obtain ⟨v,hv⟩ := hH (.inr r)
    cases v with
    | inl a =>
      by_cases hr : r=r₀
      · exact ⟨old E r₀ (.inl a),hv,hr⟩
      · exact ⟨middle E r₀ ⟨(a,r),hv,hr⟩,rfl⟩
    | inr s => exact hv.elim

end Erdos571.RootStretch

/- Balance and the anchor inequality are preserved by selective root subdivision. -/
set_option maxHeartbeats 1500000
namespace Erdos571.RootStretch
open Finset SimpleGraph RootedSunflower RootedIncidence
variable {A R : Type} [Fintype A] [Fintype R]
attribute [local instance] Classical.propDecidable

noncomputable def oldPins (E : A → R → Prop) (r₀ : R) (C : Finset (Nonroot E r₀)) : Finset A :=
  univ.filter (fun a => Sum.inl a∈C)

lemma mem_oldPins (E : A → R → Prop) (r₀ : R) (C : Finset (Nonroot E r₀)) (a : A) :
    a∈oldPins E r₀ C ↔ Sum.inl a∈C := by
  classical
  simp [oldPins]

lemma old_root_card (E : A → R → Prop) (r₀ : R) (C₀ : Finset A) :
    Nat.card (RootPetal E C₀)=Nat.card (RootPetal (fun a r => E a r ∧ r=r₀) C₀)+
      Nat.card {p : Middle E r₀ // p.val.1∉C₀} := by
  classical
  let f : RootPetal (fun a r => E a r ∧ r=r₀) C₀ ⊕ {p : Middle E r₀ // p.val.1∉C₀} → RootPetal E C₀
    | .inl p => ⟨p.val,p.property.1,p.property.2.1⟩
    | .inr p => ⟨p.val.val,p.property,p.val.property.1⟩
  have hinj : Function.Injective f := by
    intro p q he
    have h := congrArg Subtype.val he
    cases p with
    | inl p =>
      cases q with
      | inl q => exact congrArg Sum.inl (Subtype.ext h)
      | inr q => exact (q.val.property.2 ((congrArg Prod.snd h).symm.trans p.property.2.2)).elim
    | inr p =>
      cases q with
      | inl q => exact (p.val.property.2 ((congrArg Prod.snd h).trans q.property.2.2)).elim
      | inr q => exact congrArg Sum.inr (Subtype.ext (Subtype.ext h))
  have hsurj : Function.Surjective f := by
    intro p
    by_cases hr : p.val.2=r₀
    · exact ⟨.inl ⟨p.val,p.property.1,p.property.2,hr⟩,rfl⟩
    · exact ⟨.inr ⟨⟨p.val,p.property.2,hr⟩,p.property.1⟩,rfl⟩
  have h := Nat.card_congr (Equiv.ofBijective f ⟨hinj,hsurj⟩)
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum] using h.symm

lemma old_petal_card (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) (C₀ : Finset A) :
    Nat.card (PetalEdge (RootedIncidence.graph K E) C₀)=
      Nat.card (PetalEdge (anchor K E r₀) C₀)+Nat.card {p : Middle E r₀ // p.val.1∉C₀} := by
  rw [RootedIncidence.petal_card,old_root_card E r₀ C₀]
  change _=Nat.card (PetalEdge (RootedIncidence.graph K (fun a r => E a r ∧ r=r₀)) C₀)+_
  rw [RootedIncidence.petal_card]
  omega

def anchorCopy (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) :
    (anchor K E r₀).Copy (graph K E r₀) where
  toHom :=
    { toFun := old E r₀
      map_rel' := by
        intro u v h
        cases u <;> cases v <;> exact h }
  injective' := (old E r₀).injective

noncomputable def stablePetal (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    PetalEdge (anchor K E r₀) (oldPins E r₀ C) → PetalEdge (graph K E r₀) C := fun e =>
  ⟨(anchorCopy K E r₀).toHom.mapEdgeSet e.val,by
    obtain ⟨a,ha,hae⟩ := e.property
    exact ⟨.inl a,fun h => ha ((mem_oldPins E r₀ C a).mpr h),Sym2.mem_map.mpr ⟨.inl a,hae,rfl⟩⟩⟩

noncomputable def leftPetal (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    {p : Middle E r₀ // Sum.inl p.val.1∉C ∨ Sum.inr p∉C} → PetalEdge (graph K E r₀) C := fun p =>
  ⟨⟨s(old E r₀ (.inl p.val.val.1),middle E r₀ p.val),rfl⟩,by
    rcases p.property with h|h
    · exact ⟨.inl p.val.val.1,h,by simp [old]⟩
    · exact ⟨.inr p.val,h,by simp [middle]⟩⟩

noncomputable def rightPetal (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    {p : Middle E r₀ // Sum.inr p∉C} → PetalEdge (graph K E r₀) C := fun p =>
  ⟨⟨s(middle E r₀ p.val,old E r₀ (.inr p.val.val.2)),rfl⟩,.inr p.val,p.property,by simp [middle]⟩

lemma left_right_injective (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    Function.Injective (Sum.elim (leftPetal K E r₀ C) (rightPetal K E r₀ C)) := by
  apply Sum.elim_injective.mpr
  refine ⟨?_,?_,?_⟩
  · intro p q he
    have h := congrArg (fun e => e.val.val) he
    change s((Sum.inl (Sum.inl p.val.val.1) : Nonroot E r₀ ⊕ R),Sum.inl (Sum.inr p.val))=
      s(Sum.inl (Sum.inl q.val.val.1),Sum.inl (Sum.inr q.val)) at h
    simp only [Sym2.eq_iff,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,false_and,or_false] at h
    exact Subtype.ext h.2
  · intro p q he
    have h := congrArg (fun e => e.val.val) he
    change s((Sum.inl (Sum.inr p.val) : Nonroot E r₀ ⊕ R),Sum.inr p.val.val.2)=
      s(Sum.inl (Sum.inr q.val),Sum.inr q.val.val.2) at h
    simp only [Sym2.eq_iff,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,false_and,or_false] at h
    exact Subtype.ext h.1
  · intro p q he
    have hm : Sum.inr q.val.val.2∈(leftPetal K E r₀ C p).val.val := by
      rw [he]
      simp [rightPetal,old]
    simp [leftPetal,old,middle] at hm

lemma petal_injective (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    Function.Injective (Sum.elim (stablePetal K E r₀ C)
      (Sum.elim (leftPetal K E r₀ C) (rightPetal K E r₀ C))) := by
  apply Sum.elim_injective.mpr
  refine ⟨?_,left_right_injective K E r₀ C,?_⟩
  · intro e f he
    apply Subtype.ext
    exact Hom.mapEdgeSet.injective (anchorCopy K E r₀).toHom (old E r₀).injective (congrArg Subtype.val he)
  · intro e p he
    have hex : ∃q : Middle E r₀, middle E r₀ q∈(stablePetal K E r₀ C e).val.val := by
      rw [he]
      cases p with
      | inl p => exact ⟨p.val,by simp [leftPetal,middle]⟩
      | inr p => exact ⟨p.val,by simp [rightPetal,middle]⟩
    obtain ⟨q,hq⟩ := hex
    obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp hq
    cases v <;> simp [anchorCopy,old,middle] at he

lemma new_petal_bound (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    let Y := univ.filter (fun p : Middle E r₀ => Sum.inr p∉C)
    let Z := univ.filter (fun p : Middle E r₀ => Sum.inl p.val.1∉C)
    Nat.card (PetalEdge (anchor K E r₀) (oldPins E r₀ C))+(Y ∪ Z).card+Y.card ≤
      Nat.card (PetalEdge (graph K E r₀) C) := by
  classical
  intro Y Z
  have h := Nat.card_le_card_of_injective _ (petal_injective K E r₀ C)
  have he : (univ.filter (fun p : Middle E r₀ => Sum.inl p.val.1∉C ∨ Sum.inr p∉C))=Y ∪ Z := by
    ext p; simp only [Y,Z,mem_filter,mem_univ,true_and,mem_union]; tauto
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_subtype,he,Y,add_assoc] using h

/-- The useful parameter change is `(a,b) -> (b,2b-a)`, provided the retained
core and distinguished-root edges satisfy the anchor inequality. -/
theorem balance (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) (a b : ℕ) (hab : a ≤ b)
    (hanchor : Anchored K E r₀)
    (hbal : ∀C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge (RootedIncidence.graph K E) C)) :
    ∀C : Finset (Nonroot E r₀),
      (2*b-a)*(Fintype.card (Nonroot E r₀)-C.card) ≤ b*Nat.card (PetalEdge (graph K E r₀) C) := by
  classical
  intro C
  let X := univ.filter (fun x : A => Sum.inl x∉C)
  let Y := univ.filter (fun p : Middle E r₀ => Sum.inr p∉C)
  let Z := univ.filter (fun p : Middle E r₀ => Sum.inl p.val.1∉C)
  let S := Nat.card (PetalEdge (anchor K E r₀) (oldPins E r₀ C))
  have hX : Fintype.card A-(oldPins E r₀ C).card=X.card := by
    have h := card_filter_add_card_filter_not (s:=univ) (fun x : A => Sum.inl x∈C)
    change (oldPins E r₀ C).card+X.card=univ.card at h
    rw [card_univ] at h
    omega
  have hZ : Nat.card {p : Middle E r₀ // p.val.1∉oldPins E r₀ C}=Z.card := by
    simp only [Nat.card_eq_fintype_card,Fintype.card_subtype,mem_oldPins,Z]
  have hOld : b*X.card ≤ a*(S+Z.card) := by
    have h := hbal (oldPins E r₀ C)
    rwa [hX,old_petal_card K E r₀,hZ] at h
  have hAnchor : X.card ≤ S := by simpa only [hX] using hanchor (oldPins E r₀ C)
  have hNew := new_petal_bound K E r₀ C
  change S+(Y ∪ Z).card+Y.card ≤ _ at hNew
  have hcount : Fintype.card (Nonroot E r₀)-C.card=X.card+Y.card := by
    have h := Fintype.card_congr (Equiv.subtypeSum (p := fun x : Nonroot E r₀ => x∉C))
    rw [Fintype.card_subtype_compl,Fintype.card_coe] at h
    simpa only [Fintype.card_sum,Fintype.card_subtype,X,Y] using h
  have hUnion : (Y ∪ Z).card=Z.card+(Y\Z).card := by
    simpa only [add_comm] using (card_sdiff_add_card Y Z).symm
  have hY : Y.card ≤ Z.card+(Y\Z).card := by
    rw [← hUnion]
    exact card_le_card subset_union_left
  have hd : b-a+a=b := Nat.sub_add_cancel hab
  have hd' : 2*b-a+a=2*b := Nat.sub_add_cancel (by omega)
  have h₁ := Nat.mul_le_mul_left (b-a) hAnchor
  have h₂ := Nat.mul_le_mul_left (b-a) hY
  have h₃ := Nat.mul_le_mul_left b hNew
  rw [hcount]
  rw [hUnion] at h₃
  nlinarith

end Erdos571.RootStretch

/- Selective subdivision preserves the retained anchor inequality. -/
namespace Erdos571.RootStretch
open Finset SimpleGraph RootedSunflower RootedIncidence
variable {A R : Type} [Fintype A] [Fintype R]
attribute [local instance] Classical.propDecidable
set_option maxHeartbeats 1500000

def retainedCopy (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) :
    (anchor K E r₀).Copy (anchor (core K E r₀) (incidence E r₀) r₀) where
  toHom :=
    { toFun := old E r₀
      map_rel' := by
        intro u v h
        cases u <;> cases v
        · exact h
        · exact ⟨h,h.2⟩
        · exact ⟨h,h.2⟩
        · exact h }
  injective' := (old E r₀).injective

noncomputable def stableAnchorPetal (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    PetalEdge (anchor K E r₀) (oldPins E r₀ C) → PetalEdge (anchor (core K E r₀) (incidence E r₀) r₀) C := fun e =>
  ⟨(retainedCopy K E r₀).toHom.mapEdgeSet e.val,by
    obtain ⟨a,ha,hae⟩ := e.property
    exact ⟨.inl a,fun h => ha ((mem_oldPins E r₀ C a).mpr h),Sym2.mem_map.mpr ⟨.inl a,hae,rfl⟩⟩⟩

noncomputable def leafAnchorPetal (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    {p : Middle E r₀ // Sum.inr p∉C} → PetalEdge (anchor (core K E r₀) (incidence E r₀) r₀) C := fun p =>
  ⟨⟨s(old E r₀ (.inl p.val.val.1),middle E r₀ p.val),rfl⟩,.inr p.val,p.property,by simp [middle]⟩

lemma anchor_petal_injective (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R)
    (C : Finset (Nonroot E r₀)) :
    Function.Injective (Sum.elim (stableAnchorPetal K E r₀ C) (leafAnchorPetal K E r₀ C)) := by
  have hle : anchor (core K E r₀) (incidence E r₀) r₀ ≤ graph K E r₀ := by
    intro u v h
    cases u <;> cases v
    · exact h
    · exact h.1
    · exact h.1
    · exact h
  let forget : PetalEdge (anchor (core K E r₀) (incidence E r₀) r₀) C → PetalEdge (graph K E r₀) C := fun e =>
    ⟨⟨e.val.val,edgeSet_mono hle e.val.property⟩,e.property⟩
  let i : PetalEdge (anchor K E r₀) (oldPins E r₀ C) ⊕ {p : Middle E r₀ // Sum.inr p∉C} →
      PetalEdge (anchor K E r₀) (oldPins E r₀ C) ⊕
        ({p : Middle E r₀ // Sum.inl p.val.1∉C ∨ Sum.inr p∉C} ⊕ {p : Middle E r₀ // Sum.inr p∉C}) :=
    Sum.map id (fun p => Sum.inl ⟨p.val,Or.inr p.property⟩)
  have hi : Function.Injective i := Sum.map_injective.mpr ⟨Function.injective_id,by
    intro p q he
    exact Subtype.ext (congrArg (fun t : {p : Middle E r₀ // Sum.inl p.val.1∉C ∨ Sum.inr p∉C} => t.val) (Sum.inl.inj he))⟩
  intro p q he
  apply hi
  apply petal_injective K E r₀ C
  cases p <;> cases q <;> exact congrArg forget he

lemma anchored (K : SimpleGraph A) (E : A → R → Prop) (r₀ : R) (h : Anchored K E r₀) :
    Anchored (core K E r₀) (incidence E r₀) r₀ := by
  classical
  intro C
  let X := univ.filter (fun x : A => Sum.inl x∉C)
  let Y := univ.filter (fun p : Middle E r₀ => Sum.inr p∉C)
  have hX : Fintype.card A-(oldPins E r₀ C).card=X.card := by
    have h := card_filter_add_card_filter_not (s:=univ) (fun x : A => Sum.inl x∈C)
    change (oldPins E r₀ C).card+X.card=univ.card at h
    rw [card_univ] at h
    omega
  have hcount : Fintype.card (Nonroot E r₀)-C.card=X.card+Y.card := by
    have h := Fintype.card_congr (Equiv.subtypeSum (p := fun x : Nonroot E r₀ => x∉C))
    rw [Fintype.card_subtype_compl,Fintype.card_coe] at h
    simpa only [Fintype.card_sum,Fintype.card_subtype,X,Y] using h
  have hbound : Nat.card (PetalEdge (anchor K E r₀) (oldPins E r₀ C))+Y.card ≤
      Nat.card (PetalEdge (anchor (core K E r₀) (incidence E r₀) r₀) C) := by
    have hb := Nat.card_le_card_of_injective _ (anchor_petal_injective K E r₀ C)
    simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_subtype,Y] using hb
  have hOld := h (oldPins E r₀ C)
  rw [hX] at hOld
  rw [hcount]
  omega

end Erdos571.RootStretch

/- Paired coning with independent roots and no unused new root vertices. -/
namespace Erdos571.IncidenceCone
open Finset SimpleGraph RootedSunflower RootedIncidence OrdinaryRooted
variable {A R : Type*}

abbrev NewRoot (c : A ⊕ R → Bool) := {b : Bool // ∃a : A, c (.inl a)≠b}

def incidence (E : A → R → Prop) (c : A ⊕ R → Bool) : A → R ⊕ NewRoot c → Prop
  | a,.inl r => E a r
  | a,.inr b => c (.inl a)≠b.val

def graph (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) : SimpleGraph (A ⊕ (R ⊕ NewRoot c)) :=
  RootedIncidence.graph K (incidence E c)

def old (c : A ⊕ R → Bool) : A ⊕ R ↪ A ⊕ (R ⊕ NewRoot c) :=
  Function.Embedding.sumMap (Function.Embedding.refl _) Function.Embedding.inl

def oldCopy (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) :
    (RootedIncidence.graph K E).Copy (graph K E c) where
  toHom :=
    { toFun := old c
      map_rel' := by intro u v h; cases u <;> cases v <;> exact h }
  injective' := (old c).injective

def color (c : A ⊕ R → Bool) : A ⊕ (R ⊕ NewRoot c) → Bool
  | .inl a => c (.inl a)
  | .inr (.inl r) => c (.inr r)
  | .inr (.inr b) => b.val

lemma color_proper (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool)
    (hc : ∀{u v}, (RootedIncidence.graph K E).Adj u v → c u≠c v) :
    ∀{u v}, (graph K E c).Adj u v → color c u≠color c v := by
  intro u v h
  rcases u with a | (r | b) <;> rcases v with a' | (r' | b')
  · exact hc h
  · exact hc h
  · exact h
  · exact hc h
  · exact h.elim
  · exact h.elim
  · exact Ne.symm h
  · exact h.elim
  · exact h.elim

lemma connected (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) (r₀ : R)
    (hH : (RootedIncidence.graph K E).Connected) : (graph K E c).Connected := by
  have hroot (v : A ⊕ (R ⊕ NewRoot c)) : (graph K E c).Reachable v (old c (.inr r₀)) := by
    rcases v with a | (r | b)
    · exact (hH.preconnected (.inl a) (.inr r₀)).map (oldCopy K E c).toHom
    · exact (hH.preconnected (.inr r) (.inr r₀)).map (oldCopy K E c).toHom
    · obtain ⟨a,ha⟩ := b.property
      exact (show (graph K E c).Adj (.inr (.inr b)) (old c (.inl a)) from ha).reachable.trans
        ((hH.preconnected (.inl a) (.inr r₀)).map (oldCopy K E c).toHom)
  exact { preconnected := fun u v => (hroot u).trans (hroot v).symm,nonempty := ⟨old c (.inr r₀)⟩ }

lemma no_isolated (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool)
    (hH : ∀u, ∃v, (RootedIncidence.graph K E).Adj u v) : ∀u, ∃v, (graph K E c).Adj u v := by
  intro u
  rcases u with a | (r | b)
  · obtain ⟨v,hv⟩ := hH (.inl a)
    exact ⟨old c v,(oldCopy K E c).toHom.map_adj hv⟩
  · obtain ⟨v,hv⟩ := hH (.inr r)
    exact ⟨old c v,(oldCopy K E c).toHom.map_adj hv⟩
  · obtain ⟨a,ha⟩ := b.property
    exact ⟨.inl a,ha⟩

def oldPetal (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) (C : Finset A) :
    PetalEdge (RootedIncidence.graph K E) C → PetalEdge (graph K E c) C := fun e =>
  ⟨(oldCopy K E c).toHom.mapEdgeSet e.val,by
    obtain ⟨a,ha,hae⟩ := e.property
    exact ⟨a,ha,Sym2.mem_map.mpr ⟨.inl a,hae,rfl⟩⟩⟩

def opposite (c : A ⊕ R → Bool) (a : A) : NewRoot c :=
  ⟨!(c (.inl a)),a,by cases c (.inl a) <;> decide⟩

def newPetal (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) (C : Finset A) :
    {a : A // a∉C} → PetalEdge (graph K E c) C := fun a =>
  ⟨⟨s(.inl a.val,.inr (.inr (opposite c a.val))),by
    change c (.inl a.val)≠!(c (.inl a.val))
    cases c (.inl a.val) <;> decide⟩,a.val,a.property,by simp⟩

lemma petal_injective (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) (C : Finset A) :
    Function.Injective (Sum.elim (oldPetal K E c C) (newPetal K E c C)) := by
  apply Sum.elim_injective.mpr
  refine ⟨?_,?_,?_⟩
  · intro e f he
    apply Subtype.ext
    exact Hom.mapEdgeSet.injective (oldCopy K E c).toHom (old c).injective (congrArg Subtype.val he)
  · intro a b he
    have h := congrArg (fun e => e.val.val) he
    simp only [newPetal,Sym2.eq_iff,Sum.inl.injEq,Sum.inl_ne_inr,false_and,or_false] at h
    exact Subtype.ext h.1
  · intro e a he
    have hm : Sum.inr (Sum.inr (opposite c a.val))∈(oldPetal K E c C e).val.val := by
      rw [he]
      simp [newPetal]
    obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp hm
    cases v <;> simp [oldCopy,old] at he

lemma petal_bound [Fintype A] [Fintype R] (K : SimpleGraph A) (E : A → R → Prop)
    (c : A ⊕ R → Bool) (C : Finset A) :
    Nat.card (PetalEdge (RootedIncidence.graph K E) C)+(Fintype.card A-C.card) ≤
      Nat.card (PetalEdge (graph K E c) C) := by
  classical
  have h := Nat.card_le_card_of_injective _ (petal_injective K E c C)
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_subtype_compl,Fintype.card_coe] using h

lemma balance [Fintype A] [Fintype R] (K : SimpleGraph A) (E : A → R → Prop)
    (c : A ⊕ R → Bool) (a b : ℕ)
    (hbal : ∀C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge (RootedIncidence.graph K E) C)) :
    ∀C : Finset A, (b+a)*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge (graph K E c) C) := by
  intro C
  have h := hbal C
  have h' := Nat.mul_le_mul_left a (petal_bound K E c C)
  nlinarith

def anchorCopy (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) (r₀ : R) :
    (anchor K E r₀).Copy (anchor K (incidence E c) (.inl r₀)) where
  toHom :=
    { toFun := old c
      map_rel' := by
        intro u v h
        cases u <;> cases v
        · exact h
        · exact ⟨h.1,congrArg Sum.inl h.2⟩
        · exact ⟨h.1,congrArg Sum.inl h.2⟩
        · exact h }
  injective' := (old c).injective

lemma anchored [Fintype A] [Fintype R] (K : SimpleGraph A) (E : A → R → Prop)
    (c : A ⊕ R → Bool) (r₀ : R) (h : Anchored K E r₀) : Anchored K (incidence E c) (.inl r₀) := by
  classical
  intro C
  let f : PetalEdge (anchor K E r₀) C → PetalEdge (anchor K (incidence E c) (.inl r₀)) C := fun e =>
    ⟨(anchorCopy K E c r₀).toHom.mapEdgeSet e.val,by
      obtain ⟨a,ha,hae⟩ := e.property
      exact ⟨a,ha,Sym2.mem_map.mpr ⟨.inl a,hae,rfl⟩⟩⟩
  have hf : Function.Injective f := by
    intro e f he
    apply Subtype.ext
    exact Hom.mapEdgeSet.injective (anchorCopy K E c r₀).toHom (old c).injective (congrArg Subtype.val he)
  exact (h C).trans (Nat.card_le_card_of_injective f hf)

/-- The new power is a subgraph of the ordinary paired-cone power. -/
def powerCopy (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool) (M : ℕ) :
    (FullRootedPower.graph (graph K E c) M).Copy
      (FullRootedPower.graph (RootedCone.graph (RootedIncidence.graph K E) c) M) where
  toHom :=
    { toFun := Sum.map id (Sum.map id Subtype.val)
      map_rel' := by
        intro u v h
        rcases u with ⟨i,a⟩ | (r | b) <;> rcases v with ⟨j,a'⟩ | (r' | b')
        · exact h
        · exact h
        · exact h
        · exact h
        · exact h.elim
        · exact h.elim
        · exact Ne.symm h
        · exact h.elim
        · exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Function.injective_id,
    Sum.map_injective.mpr ⟨Function.injective_id,Subtype.val_injective⟩⟩

lemma supported {A R : Type} [Fintype A] [Fintype R] [Nonempty R]
    (K : SimpleGraph A) (E : A → R → Prop) (c : A ⊕ R → Bool)
    (hc : ∀{u v}, (RootedIncidence.graph K E).Adj u v → c u≠c v)
    (hconn : (RootedIncidence.graph K E).Connected) {α : ℝ}
    (hs : Supported (RootedIncidence.graph K E) α) (hα : 1 ≤ α) (hα2 : α < 2) :
    Supported (graph K E c) (1+(3-α)⁻¹) := by
  have h := hs.cone hconn hc hα hα2
  intro M hM
  obtain ⟨D,hD,hb⟩ := h M hM
  exact ⟨D,hD,hb.mono ⟨powerCopy K E c M⟩⟩

end Erdos571.IncidenceCone

/- Two elementary density moves generate every rational deficit in `(0,1]`. -/
namespace Erdos571.RationalTwoMoves

/-- No coprimality assumption is needed: diagonal pairs are the starting cases. -/
theorem generate (P : ℕ → ℕ → Prop)
    (hbase : ∀a, 1 ≤ a → P a a)
    (hcone : ∀a b, 1 ≤ a → a ≤ b → P a b → P a (b+a))
    (hstretch : ∀a b, 1 ≤ a → a ≤ b → P a b → P b (2*b-a)) :
    ∀a b, 1 ≤ a → a ≤ b → P a b := by
  intro a b
  induction b using Nat.strong_induction_on generalizing a with
  | h b ih =>
    intro ha hab
    by_cases he : a=b
    · subst b
      exact hbase a ha
    by_cases hc : 2*a ≤ b
    · have hsmall : b-a < b := by omega
      have hprev := ih (b-a) hsmall a ha (by omega)
      have h := hcone a (b-a) ha (by omega) hprev
      simpa only [Nat.sub_add_cancel hab] using h
    · have hsmall : a<b := by omega
      have hprev := ih a hsmall (2*a-b) (by omega) (by omega)
      have h := hstretch (2*a-b) a (by omega) (by omega) hprev
      convert h using 1 <;> omega

lemma cone_exponent (a b : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) :
    1+(3-(2-(a:ℝ)/(b:ℝ)))⁻¹=2-(a:ℝ)/(b+a:ℕ) := by
  have ha0 : (0:ℝ)<a := by exact_mod_cast (show 0<a by omega)
  have hb0 : (0:ℝ)<b := by exact_mod_cast (show 0<b by omega)
  have hba : (0:ℝ)<b+a := by positivity
  push_cast
  have he : 3-(2-(a:ℝ)/(b:ℝ))=((b:ℝ)+a)/b := by
    field_simp
    <;> ring
  rw [he,inv_div]
  field_simp [ne_of_gt hba]
  <;> ring

lemma stretch_exponent (a b : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) :
    2-(2-(a:ℝ)/(b:ℝ))⁻¹=2-(b:ℝ)/(2*b-a:ℕ) := by
  have ha0 : (0:ℝ)<a := by exact_mod_cast (show 0<a by omega)
  have hb0 : (0:ℝ)<b := by exact_mod_cast (show 0<b by omega)
  have hab' : (a:ℝ) ≤ b := by exact_mod_cast hab
  have hden : 2*(b:ℝ)-a≠0 := by linarith
  rw [Nat.cast_sub (by omega : a ≤ 2*b)]
  push_cast
  field_simp
  <;> ring

end Erdos571.RationalTwoMoves

/- A pointed rooted-template interface for composing the two density moves. -/
namespace Erdos571.PointedLower
open Finset SimpleGraph RootedSunflower RootedIncidence

structure Template (a b : ℕ) where
  A : Type
  R : Type
  [finA : Fintype A]
  [finR : Fintype R]
  K : SimpleGraph A
  E : A → R → Prop
  r₀ : R
  a₀ : A
  c : A ⊕ R → Bool
  proper : ∀{u v}, (RootedIncidence.graph K E).Adj u v → c u≠c v
  connected : (RootedIncidence.graph K E).Connected
  no_isolated : ∀u, ∃v, (RootedIncidence.graph K E).Adj u v
  leaf : ∀a, E a r₀ ↔ a=a₀
  anchored : Anchored K E r₀
  balance : ∀C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge (RootedIncidence.graph K E) C)

attribute [instance] Template.finA Template.finR

noncomputable def Template.cone {a b : ℕ} (T : Template a b) : Template a (b+a) where
  A := T.A
  R := T.R ⊕ IncidenceCone.NewRoot T.c
  K := T.K
  E := IncidenceCone.incidence T.E T.c
  r₀ := .inl T.r₀
  a₀ := T.a₀
  c := IncidenceCone.color T.c
  proper := IncidenceCone.color_proper T.K T.E T.c T.proper
  connected := IncidenceCone.connected T.K T.E T.c T.r₀ T.connected
  no_isolated := IncidenceCone.no_isolated T.K T.E T.c T.no_isolated
  leaf := T.leaf
  anchored := IncidenceCone.anchored T.K T.E T.c T.r₀ T.anchored
  balance := IncidenceCone.balance T.K T.E T.c a b T.balance

noncomputable def Template.stretch {a b : ℕ} (T : Template a b) (hab : a ≤ b) : Template b (2*b-a) := by
  classical
  exact
    { A := RootStretch.Nonroot T.E T.r₀
      R := T.R
      K := RootStretch.core T.K T.E T.r₀
      E := RootStretch.incidence T.E T.r₀
      r₀ := T.r₀
      a₀ := .inl T.a₀
      c := RootStretch.color T.c T.E T.r₀
      proper := RootStretch.color_proper T.K T.E T.r₀ T.c T.proper
      connected := RootStretch.connected T.K T.E T.r₀ T.connected
      no_isolated := RootStretch.no_isolated T.K T.E T.r₀ T.no_isolated
      leaf := by
        intro v
        cases v with
        | inl x => simpa only [RootStretch.incidence,and_true,Sum.inl.injEq] using T.leaf x
        | inr p => simp only [RootStretch.incidence,Sum.inr_ne_inl,iff_false]; exact p.property.2
      anchored := RootStretch.anchored T.K T.E T.r₀ T.anchored
      balance := RootStretch.balance T.K T.E T.r₀ a b hab T.anchored T.balance }

noncomputable def base (k : ℕ) : Template (k+1) (k+1) := by
  classical
  let K : SimpleGraph Unit := ⊥
  let E : Unit → Unit → Prop := fun _ _ => True
  have hanchor : Anchored K E () := by
    intro C
    by_cases hc : ()∈C
    · have hcard : 1 ≤ C.card := card_pos.mpr ⟨(),hc⟩
      simp only [Fintype.card_unique]
      omega
    · letI : Nonempty (PetalEdge (anchor K E ()) C) :=
        ⟨⟨⟨s(Sum.inl (),Sum.inr ()),⟨trivial,rfl⟩⟩,(),hc,by simp⟩⟩
      have hp : 1 ≤ Nat.card (PetalEdge (anchor K E ()) C) := by
        rw [Nat.card_eq_fintype_card]
        exact Fintype.card_pos
      simp only [Fintype.card_unique]
      omega
  have hbal : ∀C : Finset Unit, (k+1)*(Fintype.card Unit-C.card) ≤
      (k+1)*Nat.card (PetalEdge (RootedIncidence.graph K E) C) := by
    intro C
    have he : anchor K E ()=RootedIncidence.graph K E := by
      ext u v
      cases u <;> cases v <;> simp [anchor,RootedIncidence.graph,E]
    have h := hanchor C
    rw [he] at h
    exact Nat.mul_le_mul_left (k+1) h
  refine
    { A := Unit
      R := Unit
      K := K
      E := E
      r₀ := ()
      a₀ := ()
      c := Sum.elim (fun _ => false) (fun _ => true)
      proper := ?_
      connected := ?_
      no_isolated := ?_
      leaf := by intro x; cases x; exact ⟨fun _ => rfl,fun _ => trivial⟩
      anchored := hanchor
      balance := hbal }
  · intro u v h
    cases u <;> cases v <;> simp_all [RootedIncidence.graph,K,E]
  · have hroot (u : Unit ⊕ Unit) : (RootedIncidence.graph K E).Reachable u (.inr ()) := by
      cases u with
      | inl a => exact (show (RootedIncidence.graph K E).Adj (.inl a) (.inr ()) from trivial).reachable
      | inr r => cases r; exact Reachable.rfl
    exact { preconnected := fun u v => (hroot u).trans (hroot v).symm,nonempty := inferInstance }
  · intro u
    cases u with
    | inl a => exact ⟨.inr (),trivial⟩
    | inr r => exact ⟨.inl (),trivial⟩

lemma Template.exists_lower {a b : ℕ} (T : Template a b) (ha : 1 ≤ a) (hab : a ≤ b) :
    ∃M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(a:ℝ)/(b:ℝ)))
      (fun n : ℕ => (extremalNumber n (FullRootedPower.graph (RootedIncidence.graph T.K T.E) M):ℝ)) := by
  letI : Nonempty T.A := ⟨T.a₀⟩
  letI : Nonempty T.R := ⟨T.r₀⟩
  exact FullRootedPower.exact_lower _ T.no_isolated a b (by omega) hab T.balance

end Erdos571.PointedLower

/- A fixed family of pointed templates realizing every rational lower exponent. -/
namespace Erdos571.PointedLower
open Finset SimpleGraph

inductive Scheme where
  | base (k : ℕ)
  | cone (s : Scheme)
  | stretch (s : Scheme)

def Scheme.parameters : Scheme → ℕ × ℕ
  | .base k => (k+1,k+1)
  | .cone s => (s.parameters.1,s.parameters.2+s.parameters.1)
  | .stretch s => (s.parameters.2,2*s.parameters.2-s.parameters.1)

lemma Scheme.interval (s : Scheme) : 1 ≤ s.parameters.1 ∧ s.parameters.1 ≤ s.parameters.2 := by
  induction s with
  | base k => simp only [parameters]; omega
  | cone s ih => simp only [parameters]; omega
  | stretch s ih => simp only [parameters]; omega

noncomputable def Scheme.template : (s : Scheme) → Template s.parameters.1 s.parameters.2
  | .base k => PointedLower.base k
  | .cone s => s.template.cone
  | .stretch s => s.template.stretch s.interval.2

theorem exists_scheme (a b : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) :
    ∃s : Scheme, s.parameters=(a,b) := by
  apply RationalTwoMoves.generate (fun a b => ∃s : Scheme, s.parameters=(a,b)) ?_ ?_ ?_ a b ha hab
  · intro a ha
    exact ⟨.base (a-1),by simp only [Scheme.parameters]; congr 1 <;> omega⟩
  · intro a b ha hab hs
    obtain ⟨s,hs⟩ := hs
    exact ⟨.cone s,by simp [Scheme.parameters,hs]⟩
  · intro a b ha hab hs
    obtain ⟨s,hs⟩ := hs
    exact ⟨.stretch s,by simp [Scheme.parameters,hs]⟩

/-- The two moves cover every density ratio, with a single canonical expression
specifying each rooted graph. This result supplies lower bounds, not upper bounds. -/
theorem all_lower (a b : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) :
    ∃s : Scheme, s.parameters=(a,b) ∧ ∃M : ℕ, 2 ≤ M ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(2-(a:ℝ)/(b:ℝ)))
        (fun n : ℕ => (extremalNumber n
          (FullRootedPower.graph (RootedIncidence.graph s.template.K s.template.E) M):ℝ)) := by
  obtain ⟨s,hs⟩ := exists_scheme a b ha hab
  refine ⟨s,hs,?_⟩
  have h := s.template.exists_lower s.interval.1 s.interval.2
  simpa only [hs] using h

end Erdos571.PointedLower

/- The remaining upper-bound problem, restricted to the explicitly generated templates. -/
namespace Erdos571.PointedLower
open Finset SimpleGraph OrdinaryRooted

def Template.Upper {a b : ℕ} (T : Template a b) : Prop :=
  Supported (RootedIncidence.graph T.K T.E) (2-(a:ℝ)/(b:ℝ))

lemma base_upper (k : ℕ) : (base k).Upper := by
  have h : Supported SupportedBounds.base 1 := OrdinaryRooted.of_rectangular _ _ SupportedBounds.base_supported
  have he : RootedIncidence.graph (base k).K (base k).E=SupportedBounds.base := by
    ext u v
    cases u <;> cases v <;> rfl
  unfold Template.Upper
  rw [he]
  have hk : (k+1:ℝ)≠0 := by positivity
  norm_num [hk]
  exact h

lemma Template.Upper.cone {a b : ℕ} {T : Template a b} (h : T.Upper) (ha : 1 ≤ a) (hab : a ≤ b) :
    T.cone.Upper := by
  letI : Nonempty T.R := ⟨T.r₀⟩
  have hi := SupportedBounds.deficit_interval a b ha hab
  have hc := IncidenceCone.supported T.K T.E T.c T.proper T.connected h hi.1 hi.2
  rw [RationalTwoMoves.cone_exponent a b ha hab] at hc
  exact hc

lemma Template.Upper.certificate {a b : ℕ} {T : Template a b} (h : T.Upper) : Certificate a b := by
  letI : Nonempty T.A := ⟨T.a₀⟩
  letI : Nonempty T.R := ⟨T.r₀⟩
  exact ⟨T.A,T.R,inferInstance,inferInstance,inferInstance,inferInstance,
    RootedIncidence.graph T.K T.E,T.c,T.proper,T.connected,T.no_isolated,T.balance,h⟩

/-- This is an unresolved hypothesis, not an asserted upper theorem. Unlike a
universal subdivision principle it refers only to these recursively generated
pointed templates. -/
def StretchUpper : Prop := ∀s : Scheme, s.template.Upper → (Scheme.stretch s).template.Upper

theorem all_upper_of_stretch (h : StretchUpper) : ∀s : Scheme, s.template.Upper := by
  intro s
  induction s with
  | base k => exact base_upper k
  | cone s ih => exact ih.cone s.interval.1 s.interval.2
  | stretch s ih => exact h s ih

theorem all_certificates_of_stretch (h : StretchUpper) (a b : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) :
    Certificate a b := by
  obtain ⟨s,hs⟩ := exists_scheme a b ha hab
  have hc := (all_upper_of_stretch h s).certificate
  simpa only [hs] using hc

/-- The original rational-exponent statement follows from this one remaining
closure property. The hypothesis is not proved here. -/
theorem rational_turan_of_stretch_upper (h : StretchUpper) :
    ∀ α : ℚ, 1 ≤ α → α < 2 →
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        Asymptotics.IsTheta Filter.atTop
          (fun n : ℕ => (extremalNumber n G:ℝ))
          (fun n : ℕ => (n:ℝ)^(α:ℝ)) := by
  intro α hα hα2
  let d : ℚ := 2-α
  have hd : 0<d := by dsimp [d]; linarith
  have hd1 : d ≤ 1 := by dsimp [d]; linarith
  have hnum : 0<d.num := Rat.num_pos.mpr hd
  have hnum_nat : (d.num.natAbs:ℚ)=d.num := by
    rw [← Int.cast_natCast,Int.natAbs_of_nonneg (le_of_lt hnum)]
  have hrep : (d.num.natAbs:ℚ)/d.den=d := by
    rw [hnum_nat,Rat.num_div_den]
  have ha : 1 ≤ d.num.natAbs := Int.natAbs_pos.mpr (ne_of_gt hnum)
  have hab : d.num.natAbs ≤ d.den := by
    have hden : (0:ℚ)<d.den := by exact_mod_cast d.den_pos
    have hb := (div_le_one hden).mp (hrep ▸ hd1)
    exact_mod_cast hb
  have hc := all_certificates_of_stretch h d.num.natAbs d.den ha hab
  have he : (2:ℚ)-(d.num.natAbs:ℚ)/d.den=α := by rw [hrep]; dsimp [d]; ring
  simpa only [he] using hc.realizes ha hab

/-- The first mixed cone/stretch example after a three-edge rooted path. -/
def mixedScheme : Scheme := .stretch (.cone (.stretch (.cone (.base 0))))

lemma mixedScheme_parameters : mixedScheme.parameters=(5,8) := rfl

lemma mixedScheme_lower : ∃M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(11/8:ℝ))
      (fun n : ℕ => (extremalNumber n
        (FullRootedPower.graph (RootedIncidence.graph mixedScheme.template.K mixedScheme.template.E) M):ℝ)) := by
  have h := mixedScheme.template.exists_lower mixedScheme.interval.1 mixedScheme.interval.2
  norm_num only [mixedScheme_parameters] at h
  exact h

end Erdos571.PointedLower

/-! Degree bounds for extensions of a partially prescribed connected graph copy. -/
namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization

lemma boundary {V : Type*} [Fintype V] [DecidableEq V] (H : SimpleGraph V) (hH : H.Connected)
    (C : Finset V) (hC : C.Nonempty) (hproper : C≠univ) :
    ∃u∈C, ∃v∉C, H.Adj u v := by
  obtain ⟨u,hu⟩ := hC
  have hex : ∃v, v∉C := by
    by_contra! hh
    exact hproper (eq_univ_of_forall hh)
  obtain ⟨v,hv⟩ := hex
  obtain ⟨p⟩ := hH.preconnected u v
  obtain ⟨d,hd,h₁,h₂⟩ := p.exists_boundary_dart (C:Set V) hu hv
  exact ⟨d.fst,h₁,d.snd,h₂,d.adj⟩

/-- Every unspecified vertex costs at most one factor of the maximum degree.
No tree assumption is needed once the prescribed vertex set is nonempty. -/
theorem bound_nat {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (D : ℕ) (hdeg : ∀v∈U, (neighbors G U v).card ≤ D)
    (C : Finset V) (hC : C.Nonempty) (r : V → W)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hfix : ∀f∈F, ∀v∈C, f v=r v) : F.card ≤ D^(Fintype.card V-C.card) := by
  classical
  generalize hn : Fintype.card V-C.card=n
  induction n using Nat.strong_induction_on generalizing C r F with
  | h n ih =>
    by_cases hfull : C=univ
    · have hsub : (F : Set (H.Copy G)).Subsingleton := by
        intro f hf g hg
        apply Copy.ext
        intro v
        exact (hfix f hf v (hfull ▸ mem_univ v)).trans (hfix g hg v (hfull ▸ mem_univ v)).symm
      have hn0 : n=0 := by simp [hfull] at hn; omega
      simpa only [hn0,pow_zero] using card_le_one.mpr hsub
    obtain ⟨u,hu,v,hv,huv⟩ := boundary H hH C hC hfull
    let ev := fun f : H.Copy G => f v
    have hi : (F.image ev).card ≤ D := by
      by_cases hne : F.Nonempty
      swap
      · rw [not_nonempty_iff_eq_empty.mp hne,image_empty,card_empty]; omega
      obtain ⟨f₀,hf₀⟩ := hne
      have hru : r u∈U := (hfix f₀ hf₀ u hu) ▸ hmem f₀ hf₀ u
      apply le_trans _ (hdeg _ hru)
      apply card_le_card
      intro w hw
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hw
      exact mem_filter.mpr ⟨hmem f hf v,by
        rw [← hfix f hf u hu]
        exact f.toHom.map_adj huv⟩
    have hc : (insert v C).card=C.card+1 := card_insert_of_notMem hv
    have hlt : Fintype.card V-(insert v C).card<n := by
      have hcard := card_le_univ (insert v C)
      omega
    have hfiber (w : W) (hw : w∈F.image ev) :
        (F.filter (fun f => ev f=w)).card ≤ D^(Fintype.card V-(insert v C).card) := by
      apply ih _ hlt (insert v C) (insert_nonempty _ _) (Function.update r v w) _ ?_ ?_ rfl
      · intro f hf; exact hmem f (mem_filter.mp hf).1
      · intro f hf x hx
        rcases mem_insert.mp hx with rfl|hx
        · simpa only [Function.update_self] using (mem_filter.mp hf).2
        · have hxv : x≠v := fun he => hv (he ▸ hx)
          rw [Function.update_of_ne hxv]
          exact hfix f (mem_filter.mp hf).1 x hx
    have hb := card_le_mul_card_image F (D^(Fintype.card V-(insert v C).card)) hfiber
    have he : n=Fintype.card V-(insert v C).card+1 := by
      have hcard := card_le_univ (insert v C)
      omega
    calc
      _ ≤ D^(Fintype.card V-(insert v C).card)*(F.image ev).card := hb
      _ ≤ D^(Fintype.card V-(insert v C).card)*D := Nat.mul_le_mul_left _ hi
      _ = D^n := by rw [he,pow_succ]

theorem bound {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (C : Finset V) (hC : C.Nonempty) (r : V → W)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hfix : ∀f∈F, ∀v∈C, f v=r v) : (F.card:ℝ) ≤ D^(Fintype.card V-C.card) := by
  have h := bound_nat H hH G U ⌊D⌋₊ (fun v hv => Nat.le_floor (hdeg v hv)) C hC r F hmem hfix
  calc
    _ ≤ (⌊D⌋₊:ℝ)^(Fintype.card V-C.card) := by exact_mod_cast h
    _ ≤ _ := pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le hD) _

end Erdos571.ConnectedCopyBound


/-! A real minimum-degree lower bound for tree copies inside a finite vertex set. -/
set_option maxHeartbeats 1500000
namespace Erdos571.TreeCopiesIn
open Finset SimpleGraph DensityRegularization

noncomputable def copies {V W : Type} [Fintype V] [Fintype W]
    (H : SimpleGraph V) (G : SimpleGraph W) (U : Finset W) : Finset (H.Copy G) := by
  classical
  exact univ.filter (fun f => ∀v, f v∈U)

lemma mem_copies {V W : Type} [Fintype V] [Fintype W]
    (H : SimpleGraph V) (G : SimpleGraph W) (U : Finset W) (f : H.Copy G) :
    f∈copies H G U ↔ ∀v, f v∈U := by
  classical
  simp only [copies,mem_filter,mem_univ,true_and]

def toAmbient {V W : Type} (H : SimpleGraph V) (G : SimpleGraph W) (U : Finset W)
    (f : H.Copy (G.induce (U:Set W))) : H.Copy G where
  toHom := { toFun := fun v => (f v).val, map_rel' := fun h => f.toHom.map_adj h }
  injective' := Subtype.val_injective.comp f.injective

lemma toAmbient_injective {V W : Type} (H : SimpleGraph V) (G : SimpleGraph W) (U : Finset W) :
    Function.Injective (toAmbient H G U) := by
  intro f g he
  apply Copy.ext
  intro v
  exact Subtype.ext (congrArg (fun f : H.Copy G => f v) he)

lemma induce_degree {W : Type} [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (v : U) : (G.induce (U:Set W)).degree v=(neighbors G U v.val).card := by
  classical
  rw [← card_neighborFinset_eq_degree]
  apply card_bij (fun p _ => p.val)
  · intro p hp
    exact mem_filter.mpr ⟨p.property,((G.induce (U:Set W)).mem_neighborFinset v p).mp hp⟩
  · intro p hp q hq he
    exact Subtype.ext he
  · intro p hp
    exact ⟨⟨p,(mem_filter.mp hp).1⟩,((G.induce (U:Set W)).mem_neighborFinset v ⟨p,(mem_filter.mp hp).1⟩).mpr (mem_filter.mp hp).2,rfl⟩

lemma lower_nat {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.IsTree) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (D : ℕ) (hdeg : ∀v∈U, D+Fintype.card V ≤ (neighbors G U v).card) :
    U.card*D^(Fintype.card V-1) ≤ (copies H G U).card := by
  classical
  let F : H.Copy (G.induce (U:Set W)) → copies H G U := fun f =>
    ⟨toAmbient H G U f,(mem_copies H G U _).mpr (fun v => (f v).property)⟩
  have hF : Function.Injective F := by
    intro f g he
    exact toAmbient_injective H G U (congrArg Subtype.val he)
  have h := TreeCount.tree_count_of_degree (G.induce (U:Set W)) H hH D (fun v => by
    rw [induce_degree]
    exact hdeg v.val v.property)
  have hc := Nat.card_le_card_of_injective F hF
  rw [Nat.card_eq_fintype_card (α:=↥(copies H G U)),Fintype.card_coe] at hc
  have h' : U.card*D^(Fintype.card V-1) ≤ Nat.card (H.Copy (G.induce (U:Set W))) := by
    simpa only [labelledCopyCount,← Nat.card_eq_fintype_card,Nat.card_coe_set_eq,Set.ncard_coe_finset] using h
  exact h'.trans hc

lemma lower {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.IsTree) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) {d : ℝ} (hd : 4*(Fintype.card V+1:ℝ) ≤ d)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ)) :
    (U.card:ℝ)*(d/4)^(Fintype.card V-1) ≤ (copies H G U).card := by
  have hn : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hd0 : 0 ≤ d := by linarith
  have hflo : (⌊d/2⌋₊:ℝ) ≤ d/2 := Nat.floor_le (by linarith)
  have hfhi := Nat.lt_floor_add_one (d/2)
  have hflower : d/4 ≤ (⌊d/2⌋₊:ℝ) := by linarith
  have h := lower_nat H hH G U ⌊d/2⌋₊ (fun v hv => by
    have hb : (⌊d/2⌋₊:ℝ)+Fintype.card V ≤ (neighbors G U v).card := by linarith [hdeg v hv]
    exact_mod_cast hb)
  have h' : (U.card:ℝ)*(⌊d/2⌋₊:ℝ)^(Fintype.card V-1) ≤ (copies H G U).card := by exact_mod_cast h
  exact (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hflower _) (Nat.cast_nonneg _)).trans h'

end Erdos571.TreeCopiesIn


/-! Counting connected copies with a prescribed bad two-edge subpath. -/
set_option maxHeartbeats 1500000
namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization
variable {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]

lemma total (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ) ≤ U.card*D^(Fintype.card V-1) := by
  classical
  obtain ⟨v⟩ := hH.nonempty
  apply RealFiberCount.bound F U (fun f => f v) (fun f hf => hmem f hf v)
  intro w hw
  simpa only [card_singleton] using bound H hH G U hD hdeg {v} (singleton_nonempty _) (fun _ => w)
    (F.filter (fun f => f v=w))
    (fun f hf => hmem f (mem_filter.mp hf).1)
    (by intro f hf x hx; obtain rfl := mem_singleton.mp hx; exact (mem_filter.mp hf).2)

lemma fixed_two_path (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) {D : ℝ} (hD : 0 ≤ D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (u v w : V) (huv : H.Adj u v) (hvw : H.Adj v w) (huw : u≠w)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀x, f x∈U)
    (hbad : ∀f∈F, ShortSpider.Bad G U t (f u) (f w)) :
    (F.card:ℝ) ≤ (∑c∈U, ((ShortSpider.badPairs G U t c).card:ℝ))*D^(Fintype.card V-3) := by
  classical
  have huv' := H.ne_of_adj huv
  have hvw' := H.ne_of_adj hvw
  let C : Finset V := {u,v,w}
  have hC : C.card=3 := by simp [C,huv',hvw',huw]
  let center : H.Copy G → W := fun f => f v
  have he : (F.card:ℝ)=∑c∈U, ((F.filter (fun f => center f=c)).card:ℝ) := by
    exact_mod_cast card_eq_sum_card_fiberwise (show Set.MapsTo center F U from fun f hf => hmem f hf v)
  rw [he,sum_mul]
  apply sum_le_sum
  intro c hc
  let F₁ := F.filter (fun f => center f=c)
  let ev : H.Copy G → W × W := fun f => (f u,f w)
  apply RealFiberCount.bound F₁ (ShortSpider.badPairs G U t c) ev
  · intro f hf
    have hfF := (mem_filter.mp hf).1
    have hfc : f v=c := (mem_filter.mp hf).2
    apply mem_filter.mpr
    refine ⟨mem_product.mpr ⟨?_,?_⟩,hbad f hfF⟩
    · exact mem_filter.mpr ⟨hmem f hfF u, hfc ▸ f.toHom.map_adj huv.symm⟩
    · exact mem_filter.mpr ⟨hmem f hfF w, hfc ▸ f.toHom.map_adj hvw⟩
  · intro p hp
    let F₂ := F₁.filter (fun f => ev f=p)
    change (F₂.card:ℝ) ≤ _
    by_cases hn : F₂.Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
    obtain ⟨f₀,hf₀⟩ := hn
    have hfix : ∀f∈F₂, ∀x∈C, f x=f₀ x := by
      intro f hf x hx
      have he : ev f=ev f₀ := (mem_filter.mp hf).2.trans (mem_filter.mp hf₀).2.symm
      have hec : f v=f₀ v := (mem_filter.mp (mem_filter.mp hf).1).2.trans
        (mem_filter.mp (mem_filter.mp hf₀).1).2.symm
      simp only [C,mem_insert,mem_singleton] at hx
      rcases hx with rfl|rfl|rfl
      · exact congrArg Prod.fst he
      · exact hec
      · exact congrArg Prod.snd he
    simpa only [hC] using bound H hH G U hD hdeg C (by simp [C]) f₀ F₂
      (fun f hf => hmem f (mem_filter.mp (mem_filter.mp hf).1).1) hfix

/-- All nonbacktracking two-edge subpaths have light endpoint pairs. -/
def Light (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (f : H.Copy G) : Prop :=
  ∀u v w, H.Adj u v → H.Adj v w → u≠w →
    (FourthMoment.common G U (f u) (f w)).card < t

lemma nonlight_bound (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) {D : ℝ} (hD : 0 ≤ D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀x, f x∈U)
    (hbad : ∀f∈F, ¬ Light H G U t f) :
    (F.card:ℝ) ≤ (Fintype.card V:ℝ)^3*
      ((∑c∈U, ((ShortSpider.badPairs G U t c).card:ℝ))*D^(Fintype.card V-3)) := by
  classical
  let B (p : V × V × V) := F.filter (fun f => H.Adj p.1 p.2.1 ∧ H.Adj p.2.1 p.2.2 ∧
    p.1≠p.2.2 ∧ ShortSpider.Bad G U t (f p.1) (f p.2.2))
  have hsub : F ⊆ univ.biUnion B := by
    intro f hf
    have hh := hbad f hf
    simp only [Light,not_forall,not_lt] at hh
    obtain ⟨u,v,w,huv,hvw,huw,hh⟩ := hh
    exact mem_biUnion.mpr ⟨(u,v,w),mem_univ _,mem_filter.mpr ⟨hf,huv,hvw,huw,Or.inr hh⟩⟩
  have hb (p : V × V × V) : ((B p).card:ℝ) ≤
      (∑c∈U, ((ShortSpider.badPairs G U t c).card:ℝ))*D^(Fintype.card V-3) := by
    by_cases hn : (B p).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
    obtain ⟨f₀,hf₀⟩ := hn
    have hh := (mem_filter.mp hf₀).2
    exact fixed_two_path H hH G U t hD hdeg p.1 p.2.1 p.2.2 hh.1 hh.2.1 hh.2.2.1 (B p)
      (fun f hf => hmem f (mem_filter.mp hf).1)
      (fun f hf => (mem_filter.mp hf).2.2.2.2)
  calc
    _ ≤ ((univ.biUnion B).card:ℝ) := by exact_mod_cast card_le_card hsub
    _ ≤ ∑p : V × V × V, ((B p).card:ℝ) := by exact_mod_cast card_biUnion_le
    _ ≤ ∑_p : V × V × V, (∑c∈U, ((ShortSpider.badPairs G U t c).card:ℝ))*D^(Fintype.card V-3) := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp [Fintype.card_prod,pow_succ,mul_assoc]

end Erdos571.ConnectedCopyBound


/-! Rooted spiders with all arms of length two. -/
namespace Erdos571.LongSpider
open Finset SimpleGraph RootedSunflower

/-- The center is `none`, each middle is `some j`, and roots index the arms. -/
def template (s : ℕ) : SimpleGraph (Option (Fin s) ⊕ Fin s) where
  Adj u v := match u,v with
    | .inl a,.inl b => match a,b with
        | none,some _ => True
        | some _,none => True
        | _,_ => False
    | .inl a,.inr r => a=some r
    | .inr r,.inl a => some r=a
    | .inr _,.inr _ => False
  symm := by
    intro u v h
    cases u with
    | inl a =>
      cases v with
      | inl b => cases a <;> cases b <;> exact h
      | inr r => exact h.symm
    | inr r =>
      cases v with
      | inl a => exact h.symm
      | inr r' => exact h
  loopless := by
    intro u
    cases u with
    | inl a => cases a <;> exact not_false
    | inr r => exact not_false

instance (s : ℕ) : DecidableRel (template s).Adj := by
  intro u v
  cases u with
  | inl a =>
    cases v with
    | inl b => cases a <;> cases b <;> dsimp [template] <;> infer_instance
    | inr r => dsimp [template]; infer_instance
  | inr r => cases v <;> dsimp [template] <;> infer_instance

def graph (s M : ℕ) := FullRootedPower.graph (template s) M

def color {s : ℕ} : Option (Fin s) ⊕ Fin s → Bool
  | .inl none => false
  | .inl (some _) => true
  | .inr _ => false

lemma color_proper (s : ℕ) : ∀{u v}, (template s).Adj u v → color u≠color v := by
  intro u v h
  cases u with
  | inl a =>
    cases v with
    | inl b => cases a <;> cases b <;> simp_all [template,color]
    | inr r => cases a <;> simp_all [template,color]
  | inr r => cases v with
    | inl a => cases a <;> simp_all [template,color]
    | inr r' => exact h.elim

lemma connected (s : ℕ) : (template s).Connected := by
  have hreach (u : Option (Fin s) ⊕ Fin s) : (template s).Reachable u (.inl none) := by
    cases u with
    | inl a =>
      cases a with
      | none => exact Reachable.rfl
      | some j => exact (show (template s).Adj (.inl (some j)) (.inl none) from trivial).reachable
    | inr j =>
      exact (show (template s).Adj (.inr j) (.inl (some j)) from rfl).reachable.trans
        (show (template s).Adj (.inl (some j)) (.inl none) from trivial).reachable
  exact { preconnected := fun u v => (hreach u).trans (hreach v).symm,nonempty := inferInstance }

lemma no_isolated (s : ℕ) (hs : 1 ≤ s) : ∀u, ∃v, (template s).Adj u v := by
  intro u
  cases u with
  | inl a =>
    cases a with
    | none => exact ⟨.inl (some ⟨0,by omega⟩),trivial⟩
    | some j => exact ⟨.inr j,rfl⟩
  | inr j => exact ⟨.inl (some j),rfl⟩

def spiderCopy (s M : ℕ) : (graph s M).Copy (ShortSpider.graph s M) where
  toHom :=
    { toFun := Sum.map id some
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b =>
            rcases a with ⟨i,a⟩
            rcases b with ⟨j,b⟩
            cases a <;> cases b <;> exact h
          | inr r => exact h
        | inr r =>
          cases v with
          | inl a => exact h
          | inr r' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Function.injective_id,Option.some_injective _⟩

lemma spider_free {W : Type*} {G : SimpleGraph W} (s M : ℕ) (hf : (graph s M).Free G) :
    (ShortSpider.graph s M).Free G := fun h => hf ((show graph s M ⊑ ShortSpider.graph s M from ⟨spiderCopy s M⟩).trans h)

def edge {s : ℕ} : Fin s ⊕ Fin s → (template s).edgeSet
  | .inl j => ⟨s(Sum.inl (some j),Sum.inr j),rfl⟩
  | .inr j => ⟨s(Sum.inl none,Sum.inl (some j)),trivial⟩

lemma edge_injective (s : ℕ) : Function.Injective (@edge s) := by
  intro e f h
  have he := congrArg Subtype.val h
  cases e with
  | inl i =>
    cases f with
    | inl j => simpa [edge,Sym2.eq_iff] using he
    | inr j => simp [edge,Sym2.eq_iff] at he
  | inr i =>
    cases f with
    | inl j => simp [edge,Sym2.eq_iff] at he
    | inr j => simpa [edge,Sym2.eq_iff] using he

lemma edge_surjective (s : ℕ) : Function.Surjective (@edge s) := by
  rintro ⟨e,he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl a =>
      cases v with
      | inl b =>
        cases a with
        | none =>
          cases b with
          | none => exact he.elim
          | some j => exact ⟨.inr j,rfl⟩
        | some i =>
          cases b with
          | none => exact ⟨.inr i,Subtype.ext (Sym2.eq_swap)⟩
          | some j => exact he.elim
      | inr j =>
        change a=some j at he
        subst a
        exact ⟨.inl j,rfl⟩
    | inr i =>
      cases v with
      | inl a =>
        change some i=a at he
        subst a
        exact ⟨.inl i,Subtype.ext (Sym2.eq_swap)⟩
      | inr j => exact he.elim

lemma edge_card (s : ℕ) : Nat.card (template s).edgeSet=2*s := by
  have h := Nat.card_congr (Equiv.ofBijective (@edge s) ⟨edge_injective s,edge_surjective s⟩)
  simpa only [Nat.card_sum,Nat.card_fin,two_mul] using h.symm

lemma isTree (s : ℕ) : (template s).IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected s,?_⟩
  rw [edge_card]
  simp only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_option,Fintype.card_fin]
  omega

lemma petal_bound (s : ℕ) (C : Finset (Option (Fin s))) :
    (univ.filter (fun j : Fin s => some j∉C)).card+
      (univ.filter (fun j : Fin s => none∉C ∨ some j∉C)).card ≤
      Nat.card (PetalEdge (template s) C) := by
  classical
  let A : Finset (Fin s) := univ.filter (fun j => some j∉C)
  let B : Finset (Fin s) := univ.filter (fun j => none∉C ∨ some j∉C)
  let f : A ⊕ B → PetalEdge (template s) C
    | .inl a => ⟨edge (.inl a.val),some a.val,(mem_filter.mp a.property).2,by simp [edge]⟩
    | .inr j => ⟨edge (.inr j.val),by
        rcases (mem_filter.mp j.property).2 with hn | hj
        · exact ⟨none,hn,by simp [edge]⟩
        · exact ⟨some j.val,hj,by simp [edge]⟩⟩
  have hinj : Function.Injective f := by
    intro x y h
    have he : Sum.map Subtype.val Subtype.val x=Sum.map Subtype.val Subtype.val y := by
      cases x <;> cases y <;> exact edge_injective s (congrArg Subtype.val h)
    exact (Sum.map_injective.mpr ⟨Subtype.val_injective,Subtype.val_injective⟩) he
  have hc := Nat.card_le_card_of_injective f hinj
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_coe] using hc

lemma balance (s : ℕ) (hs : 1 ≤ s) : ∀C : Finset (Option (Fin s)),
    (2*s)*(Fintype.card (Option (Fin s))-C.card) ≤ (s+1)*Nat.card (PetalEdge (template s) C) := by
  classical
  intro C
  let A := univ.filter (fun j : Fin s => some j∉C)
  have hc : Fintype.card (Option (Fin s))-C.card=A.card+(if none∈C then 0 else 1) := by
    have he : univ\C = A.image some ∪ (if none∈C then ∅ else {none}) := by
      ext a
      cases a <;> by_cases hn : none∈C <;> simp [A,hn]
    rw [← card_univ (α:=Option (Fin s)),← card_sdiff_of_subset (subset_univ C),he]
    have hd : Disjoint (A.image some) (if none∈C then ∅ else {none}) := by
      split <;> simp
    rw [card_union_of_disjoint hd,card_image_of_injective _ (Option.some_injective _)]
    split <;> simp
  have ha : A.card ≤ s := by simpa using card_le_univ A
  have hp := petal_bound s C
  rw [hc]
  by_cases hn : none∈C
  · have he : (univ.filter (fun j : Fin s => none∉C ∨ some j∉C))=A := by simp only [hn,not_true_eq_false,false_or,A]
    rw [he] at hp
    change A.card+A.card ≤ _ at hp
    simp only [if_pos hn,add_zero]
    nlinarith
  · have he : (univ.filter (fun j : Fin s => none∉C ∨ some j∉C)).card=s := by simp [hn]
    rw [he] at hp
    change A.card+s ≤ _ at hp
    simp only [if_neg hn]
    nlinarith

lemma exists_lower (s : ℕ) (hs : 1 ≤ s) : ∃M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-((s+1:ℕ):ℝ)/((2*s:ℕ):ℝ)))
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ)) := by
  have hs0 : 0<s := by omega
  letI : NeZero s := ⟨by omega⟩
  exact FullRootedPower.exact_lower (template s) (no_isolated s hs) (s+1) (2*s)
    (by omega) (by omega) (balance s hs)

end Erdos571.LongSpider


/-! Deleting one root arm produces either a smaller long spider or a short spider. -/
namespace Erdos571.LongSpider
open SimpleGraph Finset

/-- Omit the indexed arm entirely. -/
def omitCopy (s : ℕ) (j : Fin (s+1)) : (template s).Copy (template (s+1)) where
  toHom :=
    { toFun := Sum.map (Option.map j.succAbove) j.succAbove
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b => cases a <;> cases b <;> exact h
          | inr r => exact congrArg (Option.map j.succAbove) h
        | inr r =>
          cases v with
          | inl a => exact congrArg (Option.map j.succAbove) h
          | inr r' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Option.map_injective j.succAbove_right_injective,j.succAbove_right_injective⟩

/-- Remove root `j` but retain its middle as the new short root. -/
def shortVertex (s : ℕ) (j : Fin (s+1)) : Option (Fin s) ⊕ Option (Fin s) → Option (Fin (s+1)) ⊕ Fin (s+1)
  | .inl a => .inl (a.map j.succAbove)
  | .inr none => .inl (some j)
  | .inr (some k) => .inr (j.succAbove k)

lemma shortVertex_injective (s : ℕ) (j : Fin (s+1)) : Function.Injective (shortVertex s j) := by
  intro u v he
  cases u with
  | inl a =>
    cases v with
    | inl b => exact congrArg Sum.inl (Option.map_injective j.succAbove_right_injective (Sum.inl.inj he))
    | inr b =>
      cases b with
      | none =>
        cases a with
        | none => simp [shortVertex] at he
        | some i => exact (Fin.succAbove_ne j i (Option.some.inj (Sum.inl.inj he))).elim
      | some k => exact (Sum.inl_ne_inr he).elim
  | inr a =>
    cases a with
    | none =>
      cases v with
      | inl b =>
        cases b with
        | none => simp [shortVertex] at he
        | some k => exact (Fin.succAbove_ne j k (Option.some.inj (Sum.inl.inj he)).symm).elim
      | inr b => cases b with
        | none => rfl
        | some k => exact (Sum.inl_ne_inr he).elim
    | some i =>
      cases v with
      | inl b => exact (Sum.inr_ne_inl he).elim
      | inr b => cases b with
        | none => exact (Sum.inr_ne_inl he).elim
        | some k => exact congrArg (fun i => Sum.inr (some i)) (j.succAbove_right_injective (Sum.inr.inj he))

def shortCopy (s : ℕ) (j : Fin (s+1)) : (ShortSpider.template s).Copy (template (s+1)) where
  toHom :=
    { toFun := shortVertex s j
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b => cases a <;> cases b <;> exact h
          | inr b =>
            cases b with
            | none =>
              change a=none at h
              subst a
              trivial
            | some k => exact congrArg (Option.map j.succAbove) h
        | inr a =>
          cases a with
          | none =>
            cases v with
            | inl b =>
              change none=b at h
              subst b
              trivial
            | inr b => exact h.elim
          | some i =>
            cases v with
            | inl b => exact congrArg (Option.map j.succAbove) h
            | inr b => exact h.elim }
  injective' := shortVertex_injective s j

def extensionCode (s : ℕ) : Option (Fin (s+1)) ⊕ Fin (s+1) → Option (Option (Fin s) ⊕ Option (Fin s))
  | .inl none => some (.inl none)
  | .inl (some j) => Fin.cases (some (.inr none)) (fun k => some (.inl (some k))) j
  | .inr j => Fin.cases none (fun k => some (.inr (some k))) j

def extensionDecode (s : ℕ) : Option (Option (Fin s) ⊕ Option (Fin s)) → Option (Fin (s+1)) ⊕ Fin (s+1)
  | none => .inr 0
  | some (.inl none) => .inl none
  | some (.inl (some k)) => .inl (some k.succ)
  | some (.inr none) => .inl (some 0)
  | some (.inr (some k)) => .inr k.succ

lemma extensionCode_injective (s : ℕ) : Function.Injective (extensionCode s) := by
  have h : Function.LeftInverse (extensionDecode s) (extensionCode s) := by
    intro v
    cases v with
    | inl a =>
      cases a with
      | none => rfl
      | some j => induction j using Fin.cases <;> rfl
    | inr j => induction j using Fin.cases <;> rfl
  exact h.injective

/-- Add one new root at the short root, converting the latter to a middle. -/
def extendCopy {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz : G.Adj z (f (.inr none))) (hf : ∀v, z≠f v) : (template (s+1)).Copy G := by
  let F : Option (Option (Fin s) ⊕ Option (Fin s)) → W := fun p => p.elim z f
  have hF : Function.Injective F := by
    intro u v he
    cases u with
    | none => cases v with
      | none => rfl
      | some v => exact (hf v he).elim
    | some u => cases v with
      | none => exact (hf u he.symm).elim
      | some v => exact congrArg some (f.injective he)
  refine
    { toHom := { toFun := F ∘ extensionCode s, map_rel' := ?_ }
      injective' := hF.comp (extensionCode_injective s) }
  intro u v h
  cases u with
  | inl a =>
    cases v with
    | inl b =>
      cases a with
      | none =>
        cases b with
        | none => exact h.elim
        | some j =>
          induction j using Fin.cases with
          | zero => exact f.toHom.map_adj (show (ShortSpider.template s).Adj (.inl none) (.inr none) from rfl)
          | succ j => exact f.toHom.map_adj (show (ShortSpider.template s).Adj (.inl none) (.inl (some j)) from trivial)
      | some i =>
        cases b with
        | none =>
          induction i using Fin.cases with
          | zero => exact f.toHom.map_adj (show (ShortSpider.template s).Adj (.inr none) (.inl none) from rfl)
          | succ i => exact f.toHom.map_adj (show (ShortSpider.template s).Adj (.inl (some i)) (.inl none) from trivial)
        | some j => exact h.elim
    | inr j =>
      change a=some j at h
      subst a
      induction j using Fin.cases with
      | zero => exact hz.symm
      | succ j => exact f.toHom.map_adj (show (ShortSpider.template s).Adj (.inl (some j)) (.inr (some j)) from rfl)
  | inr i =>
    cases v with
    | inl a =>
      change some i=a at h
      subst a
      induction i using Fin.cases with
      | zero => exact hz
      | succ i => exact f.toHom.map_adj (show (ShortSpider.template s).Adj (.inr (some i)) (.inl (some i)) from rfl)
    | inr j => exact h.elim

@[simp] lemma extendCopy_center {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz) (hf) : extendCopy G s f z hz hf (.inl none)=f (.inl none) := rfl
@[simp] lemma extendCopy_mid_zero {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz) (hf) : extendCopy G s f z hz hf (.inl (some 0))=f (.inr none) := rfl
@[simp] lemma extendCopy_mid_succ {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz) (hf) (j : Fin s) : extendCopy G s f z hz hf (.inl (some j.succ))=f (.inl (some j)) := rfl
@[simp] lemma extendCopy_root_zero {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz) (hf) : extendCopy G s f z hz hf (.inr 0)=z := rfl
@[simp] lemma extendCopy_root_succ {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz) (hf) (j : Fin s) : extendCopy G s f z hz hf (.inr j.succ)=f (.inr (some j)) := rfl

end Erdos571.LongSpider


/-! Rich short-spider root fibers force long-spider powers. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LongSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def shortFiber (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s : ℕ) (w : W) (r : Fin s → W) :
    Finset ((ShortSpider.template s).Copy G) := by
  classical
  exact univ.filter (fun f => ShortSpider.GoodCopy G U t s f ∧
    f (.inr none)=w ∧ ∀j, f (.inr (some j))=r j)

lemma mem_shortFiber (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s : ℕ) (w : W) (r : Fin s → W) (f : (ShortSpider.template s).Copy G) :
    f∈shortFiber G U t s w r ↔ ShortSpider.GoodCopy G U t s f ∧
    f (.inr none)=w ∧ ∀j, f (.inr (some j))=r j := by
  classical
  simp only [shortFiber,mem_filter,mem_univ,true_and]

lemma shortFiber_load (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s : ℕ) (ht : 1 ≤ t) (w : W) (r : Fin s → W) (v : W) :
    ((shortFiber G U t s w r).filter (fun f => v∈RootedPacking.interior f)).card ≤
      (s+1)*t^(s+1) := by
  apply ShortSpider.interior_load G U t s ht _ (fun a => a.elim w r)
  · intro f hf; exact (mem_shortFiber G U t s w r f).mp hf |>.1
  · intro f hf a
    have h := (mem_shortFiber G U t s w r f).mp hf
    cases a with
    | none => exact h.2.1
    | some j => exact h.2.2 j

/-- Size threshold allowing all chosen interiors and their additional middles
 to be avoided in the greedy packing. -/
def richThreshold (t s M : ℕ) : ℕ :=
  (s+M+1+(s+1)*M)*((s+1)*t^(s+1))

lemma contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s M : ℕ) (ht : 1 ≤ t)
    (r : Fin s ↪ W) (z : W) (hzr : ∀j, z≠r j)
    (u : Fin M ↪ W) (hu : ∀i, G.Adj z (u i))
    (hrich : ∀i, richThreshold t s M < (shortFiber G U t s (u i) r).card) :
    (graph (s+1) M).IsContained G := by
  classical
  let Z : Finset W := insert z (univ.image r ∪ univ.image u)
  have hZ : Z.card ≤ s+M+1 := by
    have h₁ := card_insert_le z (univ.image r ∪ univ.image u)
    have h₂ := card_union_le (univ.image r) (univ.image u)
    have h₃ : (univ.image r).card ≤ s := by simpa using card_image_le (s:=univ) (f:=r)
    have h₄ : (univ.image u).card ≤ M := by simpa using card_image_le (s:=univ) (f:=u)
    dsimp [Z]; omega
  obtain ⟨p,hp,hpZ,hpdis⟩ := DisjointChoice.exists_choice (s+1) ((s+1)*t^(s+1)) M
    RootedPacking.interior (fun i => shortFiber G U t s (u i) r) Z
    (by intro i p hp; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card p).le)
    (fun i w => shortFiber_load G U t s ht (u i) r w)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by omega)) (hrich i))
  have hroot (i : Fin M) := (mem_shortFiber G U t s (u i) r (p i)).mp (hp i)
  have havoid (i : Fin M) (w : W) (hw : w∈Z) (a : Option (Fin s)) : w≠p i (.inl a) := by
    intro he
    exact Finset.disjoint_left.mp (hpZ i).symm hw (by simp [RootedPacking.interior,he])
  have hz (i : Fin M) : ∀v, z≠p i v := by
    intro v
    cases v with
    | inl a => exact havoid i z (mem_insert_self _ _) a
    | inr a =>
      cases a with
      | none => rw [(hroot i).2.1]; exact G.ne_of_adj (hu i)
      | some j => rw [(hroot i).2.2 j]; exact hzr j
  let f : Fin M → (template (s+1)).Copy G := fun i =>
    extendCopy G s (p i) z (by rw [(hroot i).2.1]; exact hu i) (hz i)
  let r' : Fin (s+1) ↪ W := ⟨Fin.cases z r,by
    intro i j he
    induction i using Fin.cases with
    | zero =>
      induction j using Fin.cases with
      | zero => rfl
      | succ j => exact (hzr j he).elim
    | succ i =>
      induction j using Fin.cases with
      | zero => exact (hzr i he.symm).elim
      | succ j => exact congrArg Fin.succ (r.injective he)⟩
  have hfroot : ∀i j, f i (.inr j)=r' j := by
    intro i j
    induction j using Fin.cases with
    | zero => rfl
    | succ j => exact (hroot i).2.2 j
  have hinside (i : Fin M) :
      RootedPacking.interior (f i) ⊆ insert (u i) (RootedPacking.interior (p i)) := by
    intro w hw
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,rfl⟩ := hw
    cases a with
    | none => exact mem_insert_of_mem (by simp [f,RootedPacking.interior])
    | some j =>
      induction j using Fin.cases with
      | zero => simpa only [f,extendCopy_mid_zero,(hroot i).2.1] using mem_insert_self (u i) (RootedPacking.interior (p i))
      | succ j => exact mem_insert_of_mem (by simp [f,RootedPacking.interior])
  have huidis (i j : Fin M) : u i∉RootedPacking.interior (p j) := by
    intro h
    apply Finset.disjoint_left.mp (hpZ j).symm _ h
    exact mem_insert_of_mem (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))
  have hdis : ∀i j, i≠j → Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j)) := by
    intro i j hij
    apply Disjoint.mono (hinside i) (hinside j)
    rw [disjoint_insert_left,disjoint_insert_right]
    exact ⟨by simp [u.injective.ne hij,huidis],huidis j i,hpdis hij⟩
  have he : RootedPacking.power (template (s+1)) M=graph (s+1) M := by
    ext a b
    cases a <;> cases b <;> rfl
  rw [← he]
  exact ⟨RootedPacking.powerCopy M r' f hfroot hdis⟩

/-- Fewer than `M` rich short roots lie in a neighborhood not containing a
prescribed long root as its center. -/
theorem rich_neighbors_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s M : ℕ) (ht : 1 ≤ t) (hf : (graph (s+1) M).Free G)
    (r : Fin s ↪ W) (z : W) (hzr : ∀j, z≠r j) :
    ((neighbors G U z).filter (fun w => richThreshold t s M < (shortFiber G U t s w r).card)).card < M := by
  classical
  by_contra! hc
  obtain ⟨S,hS,hSc⟩ := exists_subset_card_eq hc
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let u : Fin M ↪ W := ⟨fun i => e i,fun i j h => e.injective (Subtype.ext h)⟩
  apply hf (contains_of_rich_neighbors G U t s M ht r z hzr u ?_ ?_)
  · intro i
    exact (mem_filter.mp (mem_filter.mp (hS (e i).property)).1).2
  · intro i
    exact (mem_filter.mp (hS (e i).property)).2

end Erdos571.LongSpider


/-! Light copies with no rich omitted-root fiber have bounded interior loads. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LongSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma short_ext (G : SimpleGraph W) (s : ℕ) (j : Fin (s+1))
    (f g : (template (s+1)).Copy G)
    (he : f.comp (shortCopy s j)=g.comp (shortCopy s j))
    (hr : f (.inr j)=g (.inr j)) : f=g := by
  apply Copy.ext
  intro v
  have heval (v) := congrArg (fun h : (ShortSpider.template s).Copy G => h v) he
  cases v with
  | inl a =>
    cases a with
    | none => exact heval (.inl none)
    | some k =>
      by_cases hk : k=j
      · subst k; exact heval (.inr none)
      · obtain ⟨i,rfl⟩ := Fin.exists_succAbove_eq hk
        exact heval (.inl (some i))
  | inr k =>
    by_cases hk : k=j
    · subst k; exact hr
    · obtain ⟨i,rfl⟩ := Fin.exists_succAbove_eq hk
      exact heval (.inr (some i))

lemma omit_ext (G : SimpleGraph W) (s : ℕ) (j : Fin (s+1))
    (f g : (template (s+1)).Copy G)
    (he : f.comp (omitCopy s j)=g.comp (omitCopy s j))
    (hm : f (.inl (some j))=g (.inl (some j)))
    (hr : f (.inr j)=g (.inr j)) : f=g := by
  apply Copy.ext
  intro v
  have heval (v) := congrArg (fun h : (template s).Copy G => h v) he
  cases v with
  | inl a =>
    cases a with
    | none => exact heval (.inl none)
    | some k =>
      by_cases hk : k=j
      · subst k; exact hm
      · obtain ⟨i,rfl⟩ := Fin.exists_succAbove_eq hk
        exact heval (.inl (some i))
  | inr k =>
    by_cases hk : k=j
    · subst k; exact hr
    · obtain ⟨i,rfl⟩ := Fin.exists_succAbove_eq hk
      exact heval (.inr i)

lemma short_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s : ℕ) (j : Fin (s+1)) (f : (template (s+1)).Copy G)
    (hmem : ∀v, f v∈U) (hl : ConnectedCopyBound.Light (template (s+1)) G U t f) :
    ShortSpider.GoodCopy G U t s (f.comp (shortCopy s j)) := by
  refine ⟨fun v => hmem _,fun k => ⟨?_,?_⟩⟩
  · exact hl (.inl (some j)) (.inl none) (.inl (some (j.succAbove k))) trivial trivial
      (by intro he; exact Fin.succAbove_ne j k (Option.some.inj (Sum.inl.inj he)).symm)
  · exact hl (.inl none) (.inl (some (j.succAbove k))) (.inr (j.succAbove k)) trivial rfl Sum.inl_ne_inr

/-- Exclude both heavy two-paths and rich short-spider fibers. -/
def GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (f : (template (s+1)).Copy G) : Prop :=
  (∀v, f v∈U) ∧ ConnectedCopyBound.Light (template (s+1)) G U t f ∧
  ∀j, (shortFiber G U t s (f (.inl (some j))) (fun k => f (.inr (j.succAbove k)))).card ≤ richThreshold t s M

lemma center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t n : ℕ)
    (F : Finset ((template n).Copy G)) (r : Fin n → W) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template n) G U t f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (hcent : ∀f∈F, f (.inl none)=w) : F.card ≤ t^n := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C : Fin n → Finset W := fun j => FourthMoment.common G U w (r j)
  have hC (j : Fin n) : (C j).card ≤ t := by
    have h := hl f₀ hf₀ (.inl none) (.inl (some j)) (.inr j) trivial rfl Sum.inl_ne_inr
    rw [hcent f₀ hf₀,hroot f₀ hf₀] at h
    exact h.le
  let g : F → ((j : Fin n) → C j) := fun f j =>
    ⟨f.val (.inl (some j)),mem_filter.mpr ⟨hmem f.val f.property _,by
      constructor
      · rw [← hcent f.val f.property]
        exact f.val.toHom.map_adj (show (template n).Adj (.inl none) (.inl (some j)) from trivial)
      · rw [← hroot f.val f.property]
        exact f.val.toHom.map_adj (show (template n).Adj (.inr j) (.inl (some j)) from rfl)⟩⟩
  have hg : Function.Injective g := by
    intro f f' he
    apply Subtype.ext
    apply Copy.ext
    intro v
    cases v with
    | inl a =>
      cases a with
      | none => exact (hcent f.val f.property).trans (hcent f'.val f'.property).symm
      | some j => exact congrArg Subtype.val (congrFun he j)
    | inr j => exact (hroot f.val f.property j).trans (hroot f'.val f'.property j).symm
  have hc := Fintype.card_le_of_injective g hg
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  calc
    _ ≤ ∏j : Fin n, Fintype.card (C j) := hc
    _ ≤ ∏_j : Fin n, t := prod_le_prod' (fun j _ => by simpa only [Fintype.card_coe] using hC j)
    _ = _ := by simp

lemma arm_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template (s+1)).Copy G)) (r : Fin (s+1) → W) (j : Fin (s+1)) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t s M f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (harm : ∀f∈F, f (.inl (some j))=w) : F.card ≤ richThreshold t s M := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let r' := fun k => r (j.succAbove k)
  have hsize : (shortFiber G U t s w r').card ≤ richThreshold t s M := by
    have h := (hgood f₀ hf₀).2.2 j
    simpa only [harm f₀ hf₀,hroot f₀ hf₀] using h
  let g : F → shortFiber G U t s w r' := fun f =>
    ⟨f.val.comp (shortCopy s j),(mem_shortFiber G U t s w r' _).mpr
      ⟨short_good G U t s j f.val (hgood f.val f.property).1 (hgood f.val f.property).2.1,
       harm f.val f.property,fun k => hroot f.val f.property _⟩⟩
  have hg : Function.Injective g := by
    intro f f' he
    apply Subtype.ext
    exact short_ext G s j f.val f'.val (congrArg Subtype.val he)
      ((hroot f.val f.property j).trans (hroot f'.val f'.property j).symm)
  have hc : F.card ≤ (shortFiber G U t s w r').card := by
    simpa only [Fintype.card_coe] using Fintype.card_le_of_injective g hg
  exact hc.trans hsize

def loadBound (t s M : ℕ) : ℕ := t^(s+1)+(s+1)*richThreshold t s M

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template (s+1)).Copy G)) (r : Fin (s+1) → W)
    (hgood : ∀f∈F, GoodCopy G U t s M f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤ loadBound t s M := by
  classical
  let A := F.filter (fun f => f (.inl none)=w)
  let B (j : Fin (s+1)) := F.filter (fun f => f (.inl (some j))=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f) ⊆ A ∪ univ.biUnion B := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,he⟩ := hw
    cases a with
    | none => exact mem_union_left _ (mem_filter.mpr ⟨(mem_filter.mp hf).1,he⟩)
    | some j => exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨(mem_filter.mp hf).1,he⟩⟩)
  have hA : A.card ≤ t^(s+1) := center_count G U t (s+1) A r w
    (fun f hf => (hgood f (mem_filter.mp hf).1).1)
    (fun f hf => (hgood f (mem_filter.mp hf).1).2.1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hB (j : Fin (s+1)) : (B j).card ≤ richThreshold t s M := arm_count G U t s M (B j) r j w
    (fun f hf => hgood f (mem_filter.mp hf).1)
    (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  calc
    _ ≤ (A ∪ univ.biUnion B).card := card_le_card hsub
    _ ≤ A.card+(univ.biUnion B).card := card_union_le _ _
    _ ≤ t^(s+1)+∑j : Fin (s+1), (B j).card := Nat.add_le_add hA card_biUnion_le
    _ ≤ t^(s+1)+∑_j : Fin (s+1), richThreshold t s M := Nat.add_le_add_left (sum_le_sum (fun j _ => hB j)) _
    _ = _ := by simp [loadBound,mul_comm]

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (ht : 1 ≤ t) (hM : 1 ≤ M) (hf : (graph (s+1) M).Free G)
    (F : Finset ((template (s+1)).Copy G)) (r : Fin (s+1) ↪ W)
    (hgood : ∀f∈F, GoodCopy G U t s M f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x) :
    F.card < M*(s+2)*loadBound t s M := by
  classical
  by_contra h
  have hc : M*Fintype.card (Option (Fin (s+1)))*loadBound t s M ≤ F.card := by
    simpa only [Fintype.card_option,Fintype.card_fin] using Nat.le_of_not_gt h
  have hcopy := RootedPacking.power_contained_of_bounded_load F id r hroot
    (loadBound t s M) M (by unfold loadBound; positivity) (interior_load G U t s M F r hgood hroot) hc
  apply hf
  have he : RootedPacking.power (template (s+1)) M=graph (s+1) M := by
    ext u v
    cases u <;> cases v <;> rfl
  rwa [← he]

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (ht : 1 ≤ t) (hM : 1 ≤ M) (hf : (graph (s+1) M).Free G)
    (F : Finset ((template (s+1)).Copy G)) (hgood : ∀f∈F, GoodCopy G U t s M f) :
    F.card ≤ (M*(s+2)*loadBound t s M)*U.card^(s+1) := by
  classical
  let roots : (template (s+1)).Copy G → (Fin (s+1) → W) := fun f r => f (.inr r)
  have hbound (r : Fin (s+1) → W) : (F.filter (fun f => roots f=r)).card ≤ M*(s+2)*loadBound t s M := by
    by_cases hne : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · simp only [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hne
    have hr : Function.Injective r := by
      have he := (mem_filter.mp hf₀).2
      rw [← he]
      exact f₀.injective.comp Sum.inr_injective
    exact (rooted_count G U t s M ht hM hf _ ⟨r,hr⟩
      (fun f hf => hgood f (mem_filter.mp hf).1)
      (fun f hf x => congrFun (mem_filter.mp hf).2 x)).le
  have hc := card_le_mul_card_image F (M*(s+2)*loadBound t s M) (fun r _ => hbound r)
  have hi : (F.image roots).card ≤ U.card^(s+1) := by
    let f : (F.image roots) → (Fin (s+1) → U) := fun r x =>
      ⟨r.val x,by
        obtain ⟨g,hg,he⟩ := mem_image.mp r.property
        rw [← he]
        exact (hgood g hg).1 _⟩
    have hinj : Function.Injective f := by
      intro r r' h
      apply Subtype.ext
      funext x
      exact congrArg Subtype.val (congrFun h x)
    have h := Fintype.card_le_of_injective f hinj
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using h
  exact hc.trans (Nat.mul_le_mul_left _ hi)

end Erdos571.LongSpider


/-! Rich-arm exclusions and the resulting total-copy inequality. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LongSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_arm_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (ht : 1 ≤ t) (hf : (graph (s+1) M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (j : Fin (s+1)) (F : Finset ((template (s+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, richThreshold t s M <
      (shortFiber G U t s (f (.inl (some j))) (fun k => f (.inr (j.succAbove k)))).card) :
    (F.card:ℝ) ≤ (M:ℝ)*U.card*D^(2*s+1) := by
  classical
  let S := TreeCopiesIn.copies (template s) G U
  let pre : (template (s+1)).Copy G → (template s).Copy G := fun f => f.comp (omitCopy s j)
  have hmap : Set.MapsTo pre F S := by
    intro f hf
    exact (TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hmem f hf _)
  have hfiber (g : (template s).Copy G) (hg : g∈S) :
      ((F.filter (fun f => pre f=g)).card:ℝ) ≤ (M:ℝ)*D := by
    let F₁ := F.filter (fun f => pre f=g)
    let r : Fin s ↪ W := ⟨fun k => g (.inr k),g.injective.comp Sum.inr_injective⟩
    let R := (neighbors G U (g (.inl none))).filter (fun w => richThreshold t s M < (shortFiber G U t s w r).card)
    have hR : R.card ≤ M := (rich_neighbors_bound G U t s M ht hf r (g (.inl none))
      (fun k he => Sum.inl_ne_inr (g.injective he))).le
    let ev : (template (s+1)).Copy G → W := fun f => f (.inl (some j))
    have hRmap : Set.MapsTo ev F₁ R := by
      intro f hf₁
      have hfF := (mem_filter.mp hf₁).1
      have he : ∀v, f (omitCopy s j v)=g v := fun v => congrArg (fun f : (template s).Copy G => f v) (mem_filter.mp hf₁).2
      apply mem_filter.mpr
      constructor
      · apply mem_filter.mpr
        refine ⟨hmem f hfF _,?_⟩
        rw [← he (.inl none)]
        exact f.toHom.map_adj (show (template (s+1)).Adj (.inl none) (.inl (some j)) from trivial)
      · have hh := hrich f hfF
        have her : (fun k => f (.inr (j.succAbove k)))=r := by funext k; exact he (.inr k)
        rwa [her] at hh
    have hinner (w : W) (hw : w∈R) : ((F₁.filter (fun f => ev f=w)).card:ℝ) ≤ D := by
      let F₂ := F₁.filter (fun f => ev f=w)
      have hcard : F₂.card ≤ (neighbors G U w).card := by
        apply card_le_card_of_injOn (fun f => f (.inr j))
        · intro f hf₂
          have hh := (mem_filter.mp hf₂).2
          refine mem_filter.mpr ⟨hmem f (mem_filter.mp (mem_filter.mp hf₂).1).1 _,?_⟩
          rw [← hh]
          exact f.toHom.map_adj (show (template (s+1)).Adj (.inl (some j)) (.inr j) from rfl)
        · intro f hf₂ f' hf₂' he
          apply omit_ext G s j f f'
          · exact (mem_filter.mp (mem_filter.mp hf₂).1).2.trans (mem_filter.mp (mem_filter.mp hf₂').1).2.symm
          · exact (mem_filter.mp hf₂).2.trans (mem_filter.mp hf₂').2.symm
          · exact he
      exact (show (F₂.card:ℝ) ≤ (neighbors G U w).card by exact_mod_cast hcard).trans
        (hdeg w (mem_filter.mp (mem_filter.mp hw).1).1)
    have hb := RealFiberCount.bound F₁ R ev hRmap hinner
    exact hb.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hR) hD)
  have hb := RealFiberCount.bound F S pre hmap hfiber
  have hs := ConnectedCopyBound.total (template s) (connected s) G U hD hdeg S
    (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have he : Fintype.card (Option (Fin s) ⊕ Fin s)-1=2*s := by
    simp only [Fintype.card_sum,Fintype.card_option,Fintype.card_fin]; omega
  rw [he] at hs
  calc
    _ ≤ (S.card:ℝ)*((M:ℝ)*D) := hb
    _ ≤ (U.card:ℝ)*D^(2*s)*((M:ℝ)*D) := mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [pow_succ]; ring

lemma all_count_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (ht : 1 ≤ t) (hM : 1 ≤ M) (hf : (graph (s+1) M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (s+1)).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ) ≤ (M*(s+2)*loadBound t s M:ℕ)*(U.card:ℝ)^(s+1)+
      ((2*s+3:ℕ):ℝ)^3*(∑c∈U, ((ShortSpider.badPairs G U t c).card:ℝ))*D^(2*s)+
      (s+1:ℕ)*(M:ℝ)*U.card*D^(2*s+1) := by
  classical
  let A := F.filter (GoodCopy G U t s M)
  let B := F.filter (fun f => ¬ ConnectedCopyBound.Light (template (s+1)) G U t f)
  let C (j : Fin (s+1)) := F.filter (fun f => richThreshold t s M <
    (shortFiber G U t s (f (.inl (some j))) (fun k => f (.inr (j.succAbove k)))).card)
  have hsub : F ⊆ A ∪ B ∪ univ.biUnion C := by
    intro f hf
    by_cases hgood : GoodCopy G U t s M f
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hgood⟩))
    by_cases hl : ConnectedCopyBound.Light (template (s+1)) G U t f
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩))
    have hh : ∃j, richThreshold t s M <
        (shortFiber G U t s (f (.inl (some j))) (fun k => f (.inr (j.succAbove k)))).card := by
      simpa only [GoodCopy,hmem f hf,hl,forall_const,true_and,not_forall,not_le] using hgood
    obtain ⟨j,hj⟩ := hh
    exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨hf,hj⟩⟩)
  have hcard : F.card ≤ A.card+B.card+∑j : Fin (s+1), (C j).card := by
    exact (card_le_card hsub).trans ((card_union_le _ _).trans
      (Nat.add_le_add (card_union_le _ _) card_biUnion_le))
  have hA : (A.card:ℝ) ≤ (M*(s+2)*loadBound t s M:ℕ)*(U.card:ℝ)^(s+1) := by
    exact_mod_cast good_count G U t s M ht hM hf A (fun f hf => (mem_filter.mp hf).2)
  have hB := ConnectedCopyBound.nonlight_bound (template (s+1)) (connected _) G U t hD hdeg B
    (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hcardV : Fintype.card (Option (Fin (s+1)) ⊕ Fin (s+1))=2*s+3 := by simp; omega
  rw [hcardV,show 2*s+3-3=2*s by omega] at hB
  have hC : (∑j : Fin (s+1), ((C j).card:ℝ)) ≤ (s+1:ℕ)*(M:ℝ)*U.card*D^(2*s+1) := by
    calc
      _ ≤ ∑_j : Fin (s+1), (M:ℝ)*U.card*D^(2*s+1) := sum_le_sum (fun j _ =>
        rich_arm_bound G U t s M ht hf hD hdeg j (C j)
          (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
      _ = _ := by simp; ring
  have hc : (F.card:ℝ) ≤ (A.card:ℝ)+B.card+∑j : Fin (s+1), ((C j).card:ℝ) := by exact_mod_cast hcard
  nlinarith

/-- All tree copies supply the main term. The two excluded types contribute
strictly lower-order degree powers. -/
lemma copy_inequality (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (s M : ℕ) (hM : 1 ≤ M) (hf : (graph (s+1) M).Free G)
    {d D : ℝ} (hd : 4*(2*s+4:ℕ) ≤ d) (hD : 0 ≤ D)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ D) :
    (U.card:ℝ)*(d/4)^(2*(s+1)) ≤
      (M*(s+2)*loadBound (M*(s+1)+M+(s+1)+1) s M:ℕ)*(U.card:ℝ)^(s+1)+
      (U.card:ℝ)*(((2*s+3:ℕ):ℝ)^3*(D+(2*(2*M+(s+2)))*D^(2-1/((s+1:ℕ):ℝ)))*D^(2*s)+
      (s+1:ℕ)*(M:ℝ)*D^(2*s+1)) := by
  classical
  let t := M*(s+1)+M+(s+1)+1
  have ht : 1 ≤ t := by dsimp [t]; omega
  let F := TreeCopiesIn.copies (template (s+1)) G U
  have hcardV : Fintype.card (Option (Fin (s+1)) ⊕ Fin (s+1))=2*s+3 := by simp; omega
  have hl := TreeCopiesIn.lower (template (s+1)) (isTree _) G U (d:=d) (by rw [hcardV]; push_cast at hd ⊢; linarith)
    (fun v hv => (hdeg v hv).1)
  rw [hcardV,show 2*s+3-1=2*(s+1) by omega] at hl
  have hc := all_count_bound G U t s M ht hM hf hD (fun v hv => (hdeg v hv).2) F
    (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have hh := ShortSpider.heavy_sum_bound G U (s+1) M (by omega) hM (spider_free (s+1) M hf) hD
    (fun v hv => (hdeg v hv).2)
  have hb := ThetaFour.badPairs_sum_bound G U t (fun v hv => (hdeg v hv).2)
  have hsum : (∑c∈U, ((ShortSpider.badPairs G U t c).card:ℝ)) ≤
      (U.card:ℝ)*(D+(2*(2*M+(s+2)))*D^(2-1/((s+1:ℕ):ℝ))) := by
    dsimp [t] at hb ⊢
    push_cast at hh hb ⊢
    nlinarith
  have hb' := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsum
    (show 0 ≤ ((2*s+3:ℕ):ℝ)^3 by positivity)) (pow_nonneg hD (2*s))
  dsimp [t] at hc
  change (U.card:ℝ)*(d/4)^(2*(s+1)) ≤ (F.card:ℝ) at hl
  nlinarith

end Erdos571.LongSpider


/-! Absorbing the two lower-order error powers. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LongSpider
open Filter Asymptotics

noncomputable def countError (s M : ℕ) (D : ℝ) : ℝ :=
  ((2*s+3:ℕ):ℝ)^3*(D+(2*(2*M+(s+2)))*D^(2-1/((s+1:ℕ):ℝ)))*D^(2*s)+
    (s+1:ℕ)*(M:ℝ)*D^(2*s+1)

lemma countError_eq (s M : ℕ) {D : ℝ} (hD : 0 < D) :
    countError s M D = (((2*s+3:ℕ):ℝ)^3+(s+1:ℕ)*(M:ℝ))*D^((2*s+1:ℕ):ℝ)+
      (((2*s+3:ℕ):ℝ)^3*(2*(2*M+(s+2))))*D^(2-1/((s+1:ℕ):ℝ)+((2*s:ℕ):ℝ)) := by
  rw [Real.rpow_add hD]
  simp only [Real.rpow_natCast,countError,pow_succ]
  ring

lemma exists_error_threshold (s M : ℕ) (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃L : ℝ, 1 ≤ L ∧ 4*(2*s+4:ℕ) ≤ L ∧ ∀d : ℝ, L ≤ d →
      countError s M (Q*d) ≤ (d/4)^(2*(s+1))/2 := by
  let k := 2*(s+1)
  let p : ℝ := ((2*s+1:ℕ):ℝ)
  let e : ℝ := 2-1/((s+1:ℕ):ℝ)+((2*s:ℕ):ℝ)
  let A : ℝ := (((2*s+3:ℕ):ℝ)^3+(s+1:ℕ)*(M:ℝ))*Q^p
  let B : ℝ := (((2*s+3:ℕ):ℝ)^3*(2*(2*M+(s+2))))*Q^e
  have hpk : p<(k:ℝ) := by dsimp [p,k]; push_cast; linarith
  have hek : e<(k:ℝ) := by
    have hi : 0 < 1/((s+1:ℕ):ℝ) := by positivity
    dsimp [e,k]
    push_cast at hi ⊢
    linarith
  have ho : (fun d : ℝ => A*d^p+B*d^e) =o[atTop] (fun d : ℝ => d^(k:ℝ)) :=
    ((ThetaFour.rpow_littleO hpk).const_mul_left A).add ((ThetaFour.rpow_littleO hek).const_mul_left B)
  obtain ⟨L₀,hL₀⟩ := eventually_atTop.mp (ho.def (c:=1/(2*4^k)) (by positivity))
  refine ⟨max (max 1 (4*(2*s+4:ℕ))) L₀,?_,?_,?_⟩
  · exact (le_max_left _ _).trans (le_max_left _ _)
  · exact (le_max_right _ _).trans (le_max_left _ _)
  · intro d hd
    have hd1 : 1 ≤ d := (le_max_left _ _).trans ((le_max_left _ _).trans hd)
    have hd0 : 0 < d := by linarith
    have hQ0 : 0 < Q := by linarith
    have he := hL₀ d ((le_max_right _ _).trans hd)
    rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hd0.le _)] at he
    have h := (le_abs_self (A*d^p+B*d^e)).trans he
    have heq : countError s M (Q*d)=A*d^p+B*d^e := by
      rw [countError_eq s M (mul_pos hQ0 hd0),Real.mul_rpow hQ0.le hd0.le,Real.mul_rpow hQ0.le hd0.le]
      dsimp [A,B,p,e]
      ring
    rw [heq]
    convert h using 1
    rw [Real.rpow_natCast,div_pow]
    dsimp [k]
    ring

lemma degree_of_power (k s : ℕ) (hk : 0 < k) {n d B : ℝ}
    (hn : 0 ≤ n) (hd : 0 ≤ d) (hB : 0 ≤ B) (h : d^k ≤ B*n^s) :
    d ≤ B^((k:ℝ)⁻¹)*n^((s:ℝ)/(k:ℝ)) := by
  have hp : (0:ℝ)<k := by exact_mod_cast hk
  have hh := Real.rpow_le_rpow (pow_nonneg hd _) h (inv_nonneg.mpr hp.le)
  rw [← Real.rpow_natCast d k,Real.rpow_rpow_inv hd hp.ne',
    Real.mul_rpow hB (pow_nonneg hn _),← Real.rpow_natCast_mul hn] at hh
  simpa only [div_eq_mul_inv] using hh

end Erdos571.LongSpider


/-! Sharp ordinary upper bounds for subdivisions of complete bipartite graphs. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LongSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeBase (s M : ℕ) : ℝ :=
  2*4^(2*(s+1))*(M*(s+2)*loadBound (M*(s+1)+M+(s+1)+1) s M:ℕ)

noncomputable def degreeCoefficient (s M : ℕ) : ℝ :=
  (degreeBase s M)^(((2*(s+1):ℕ):ℝ)⁻¹)

lemma degreeCoefficient_nonneg (s M : ℕ) : 0 ≤ degreeCoefficient s M := by
  unfold degreeCoefficient degreeBase
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (s M : ℕ) (hM : 1 ≤ M) (hf : (graph (s+1) M).Free G)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 0 < d) (hdlarge : 4*(2*s+4:ℕ) ≤ d)
    (herr : countError s M (Q*d) ≤ (d/4)^(2*(s+1))/2)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) :
    d ≤ degreeCoefficient s M*(U.card:ℝ)^((s:ℝ)/((2*(s+1):ℕ):ℝ)) := by
  classical
  have hn : (0:ℝ) < U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0 ≤ Q*d := by positivity
  have hc := copy_inequality G U s M hM hf hdlarge hD hdeg
  have herr' := mul_le_mul_of_nonneg_left herr hn.le
  change _ ≤ _+(U.card:ℝ)*countError s M (Q*d) at hc
  let K : ℝ := (M*(s+2)*loadBound (M*(s+1)+M+(s+1)+1) s M:ℕ)
  have hm : (U.card:ℝ)*(d/4)^(2*(s+1)) ≤ 2*K*(U.card:ℝ)^(s+1) := by
    dsimp [K]; linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0 ≤ (4:ℝ)^(2*(s+1)) by positivity)
  have he : (U.card:ℝ)*(d/4)^(2*(s+1))*4^(2*(s+1))=U.card*d^(2*(s+1)) := by
    rw [div_pow]; field_simp
  rw [he,pow_succ (U.card:ℝ) s] at hm'
  have hpower : d^(2*(s+1)) ≤ degreeBase s M*(U.card:ℝ)^s := by
    apply (mul_le_mul_iff_left₀ hn).mp
    dsimp [degreeBase]
    dsimp [K] at hm'
    nlinarith
  exact degree_of_power (2*(s+1)) s (by omega) hn.le hd.le (by unfold degreeBase; positivity) hpower

/-- The almost-regular estimate needs no host coloring assumption. -/
theorem exists_regular_bound (s M : ℕ) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (graph (s+1) M).Free G → ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+(s:ℝ)/((2*(s+1):ℕ):ℝ)) := by
  obtain ⟨L,hL,hLs,herr⟩ := exists_error_threshold s M Q hQ
  let B := degreeCoefficient s M
  have hB : 0 ≤ B := degreeCoefficient_nonneg s M
  refine ⟨Q*(L+B),by positivity,?_⟩
  intro W _ _ G _ hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^((s:ℝ)/((2*(s+1):ℕ):ℝ)) := Real.one_le_rpow hn1 (by positivity)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^((s:ℝ)/((2*(s+1):ℕ):ℝ)) := by
    by_cases hdl : d ≤ L
    · nlinarith
    · have hl := large_degree_bound G U hU s M hM hf hQ hd
        (hLs.trans (le_of_not_ge hdl)) (herr d (le_of_not_ge hdl)) hdeg
      have hnn : 0 ≤ (U.card:ℝ)^((s:ℝ)/((2*(s+1):ℕ):ℝ)) := by positivity
      change d ≤ B*_ at hl
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^((s:ℝ)/((2*(s+1):ℕ):ℝ))) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [Real.rpow_add hn,Real.rpow_one]; ring

/-- The extremal exponent of every fixed power is at most `(3n-1)/(2n)`. -/
theorem edge_bound (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph (s+1) M) (1+(s:ℝ)/((2*(s+1):ℕ):ℝ)) D := by
  let γ : ℝ := (s:ℝ)/((2*(s+1):ℕ):ℝ)
  have hγ : 0 < γ := by
    have hs0 : (0:ℝ)<s := by exact_mod_cast (show 0<s by omega)
    dsimp [γ]
    positivity
  have hγ1 : γ ≤ 1 := by
    dsimp [γ]
    apply (div_le_one (by positivity)).mpr
    exact_mod_cast (show s ≤ 2*(s+1) by omega)
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+γ)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left,Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound s M hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  have hb := bound_of_almost_regular G univ (β:=1+γ) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance G inferInstance hf T d hd hdeg)
  have harcs : (arcs G univ).card=2*Nat.card G.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors G univ w=G.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using G.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card G.edgeSet:ℝ) by nlinarith [(show (0:ℝ) ≤ Nat.card G.edgeSet from Nat.cast_nonneg _)]).trans hb

end Erdos571.LongSpider


/-! Exact exponents from long-root spiders and paired cones. -/
namespace Erdos571.LongSpider
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (s : ℕ) :
    1+(s:ℝ)/((2*(s+1):ℕ):ℝ)=2-((s+2:ℕ):ℝ)/((2*(s+1):ℕ):ℝ) := by
  have hden : ((2*(s+1):ℕ):ℝ)≠0 := by positivity
  push_cast
  field_simp
  <;> ring

theorem supported (s : ℕ) (hs : 1 ≤ s) :
    Supported (template (s+1)) (2-((s+2:ℕ):ℝ)/((2*(s+1):ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound s M hs (by omega)
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (s : ℕ) (hs : 1 ≤ s) : Certificate (s+2) (2*(s+1)) :=
  ⟨Option (Fin (s+1)),Fin (s+1),inferInstance,inferInstance,inferInstance,inferInstance,
    template (s+1),color,color_proper (s+1),connected (s+1),no_isolated (s+1) (by omega),
    balance (s+1) (by omega),supported s hs⟩

theorem iterated_certificate (s t : ℕ) (hs : 1 ≤ s) :
    Certificate (s+2) (2*(s+1)+t*(s+2)) := by
  induction t with
  | zero => simpa using certificate s hs
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 2*(s+1)+(t+1)*(s+2)=2*(s+1)+t*(s+2)+(s+2) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- Subdivided complete bipartite graphs give all exponents
`2-(s+2)/(2*(s+1)+t*(s+2))`, including `11/8` at `s=3,t=0`. -/
theorem exact_family (s t : ℕ) (hs : 1 ≤ s) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(s+2:ℚ)/(2*(s+1)+t*(s+2):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate s t hs).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_eleven_eighths :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((11/8:ℚ):ℝ)) := by
  have h := exact_family 3 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.LongSpider

/-! Rooted double spiders: two adjacent centers, each with length-two root arms. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph RootedSunflower

abbrev Arms (p q : ℕ) := Fin p ⊕ Fin q
abbrev Interior (p q : ℕ) := Bool ⊕ Arms p q

def side {p q : ℕ} : Arms p q → Bool
  | .inl _ => false
  | .inr _ => true

def core (p q : ℕ) : SimpleGraph (Interior p q) where
  Adj u v := match u,v with
    | .inl c,.inl d => c≠d
    | .inl c,.inr r => c=side r
    | .inr r,.inl c => side r=c
    | .inr _,.inr _ => False
  symm := by intro u v h; cases u <;> cases v <;> first | exact h.symm | exact h
  loopless := by intro u; cases u <;> simp

def template (p q : ℕ) : SimpleGraph (Interior p q ⊕ Arms p q) :=
  RootedIncidence.graph (core p q) (fun a r => a=.inr r)

def graph (p q M : ℕ) := FullRootedPower.graph (template p q) M

instance (p q : ℕ) : DecidableRel (template p q).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [template,RootedIncidence.graph]
  · rename_i a b
    cases a <;> cases b <;> dsimp [core] <;> infer_instance
  all_goals infer_instance

def color {p q : ℕ} : Interior p q ⊕ Arms p q → Bool
  | .inl (.inl c) => c
  | .inl (.inr r) => !(side r)
  | .inr r => side r

lemma color_proper (p q : ℕ) : ∀{u v}, (template p q).Adj u v → color u≠color v := by
  intro u v h
  cases u with
  | inl a =>
    cases v with
    | inl b =>
      cases a with
      | inl c =>
        cases b with
        | inl d => exact h
        | inr r =>
          change c=side r at h
          subst c
          simp [color]
      | inr r =>
        cases b with
        | inl c =>
          change side r=c at h
          subst c
          simp [color]
        | inr r' => exact h.elim
    | inr r =>
      change a=.inr r at h
      subst a
      simp [color]
  | inr r =>
    cases v with
    | inl a =>
      change a=.inr r at h
      subst a
      simp [color]
    | inr r' => exact h.elim

lemma connected (p q : ℕ) : (template p q).Connected := by
  have hcent (c : Bool) : (template p q).Reachable (.inl (.inl c)) (.inl (.inl false)) := by
    cases c
    · exact Reachable.rfl
    · exact (show (template p q).Adj (.inl (.inl true)) (.inl (.inl false)) from Bool.noConfusion).reachable
  have hreach (u : Interior p q ⊕ Arms p q) : (template p q).Reachable u (.inl (.inl false)) := by
    cases u with
    | inl a =>
      cases a with
      | inl c => exact hcent c
      | inr r => exact (show (template p q).Adj (.inl (.inr r)) (.inl (.inl (side r))) from rfl).reachable.trans (hcent _)
    | inr r =>
      exact (show (template p q).Adj (.inr r) (.inl (.inr r)) from rfl).reachable.trans
        ((show (template p q).Adj (.inl (.inr r)) (.inl (.inl (side r))) from rfl).reachable.trans (hcent _))
  exact {preconnected := fun u v => (hreach u).trans (hreach v).symm,nonempty := inferInstance}

lemma no_isolated (p q : ℕ) : ∀u, ∃v, (template p q).Adj u v := by
  intro u
  cases u with
  | inl a =>
    cases a with
    | inl c => exact ⟨.inl (.inl (!c)),by change c≠!c; cases c <;> decide⟩
    | inr r => exact ⟨.inr r,rfl⟩
  | inr r => exact ⟨.inl (.inr r),rfl⟩

/-- Core edge, the center--middle edges, and the middle--root edges. -/
def edge {p q : ℕ} : Unit ⊕ (Arms p q ⊕ Arms p q) → (template p q).edgeSet
  | .inl _ => ⟨s(Sum.inl (Sum.inl false),Sum.inl (Sum.inl true)),by change false≠true; decide⟩
  | .inr (.inl r) => ⟨s(Sum.inl (Sum.inl (side r)),Sum.inl (Sum.inr r)),rfl⟩
  | .inr (.inr r) => ⟨s(Sum.inl (Sum.inr r),Sum.inr r),rfl⟩

lemma edge_injective (p q : ℕ) : Function.Injective (@edge p q) := by
  intro e f he
  have hh := congrArg Subtype.val he
  cases e with
  | inl u =>
    cases f with
    | inl v => rfl
    | inr r => cases r <;> simp [edge,Sym2.eq_iff] at hh
  | inr e =>
    cases f with
    | inl u => cases e <;> simp [edge,Sym2.eq_iff] at hh
    | inr f =>
      cases e <;> cases f <;> simp_all [edge,Sym2.eq_iff]

lemma edge_surjective (p q : ℕ) : Function.Surjective (@edge p q) := by
  rintro ⟨e,he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl a =>
      cases v with
      | inl b =>
        cases a with
        | inl c =>
          cases b with
          | inl d =>
            change c≠d at he
            cases c <;> cases d
            · exact (he rfl).elim
            · exact ⟨.inl (),rfl⟩
            · exact ⟨.inl (),Subtype.ext Sym2.eq_swap⟩
            · exact (he rfl).elim
          | inr r =>
            change c=side r at he
            subst c
            exact ⟨.inr (.inl r),rfl⟩
        | inr r =>
          cases b with
          | inl c =>
            change side r=c at he
            subst c
            exact ⟨.inr (.inl r),Subtype.ext Sym2.eq_swap⟩
          | inr r' => exact he.elim
      | inr r =>
        change a=.inr r at he
        subst a
        exact ⟨.inr (.inr r),rfl⟩
    | inr r =>
      cases v with
      | inl a =>
        change a=.inr r at he
        subst a
        exact ⟨.inr (.inr r),Subtype.ext Sym2.eq_swap⟩
      | inr r' => exact he.elim

lemma edge_card (p q : ℕ) : Nat.card (template p q).edgeSet=2*(p+q)+1 := by
  have h := Nat.card_congr (Equiv.ofBijective (@edge p q) ⟨edge_injective p q,edge_surjective p q⟩)
  rw [← h]
  simp [Arms,Nat.card_eq_fintype_card]
  omega

lemma isTree (p q : ℕ) : (template p q).IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected p q,?_⟩
  rw [edge_card]
  simp only [Interior,Arms,Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_fin,Fintype.card_bool]
  omega

/-- The touched edges can be indexed without quotient-cardinality calculations. -/
lemma petal_bound (p q : ℕ) (C : Finset (Interior p q)) :
    (univ.filter (fun r : Arms p q => Sum.inr r∉C)).card+
    (univ.filter (fun r : Arms p q => Sum.inl (side r)∉C ∨ Sum.inr r∉C)).card+
    (if Sum.inl false∉C ∨ Sum.inl true∉C then 1 else 0) ≤
      Nat.card (PetalEdge (template p q) C) := by
  classical
  let A := univ.filter (fun r : Arms p q => Sum.inr r∉C)
  let B := univ.filter (fun r : Arms p q => Sum.inl (side r)∉C ∨ Sum.inr r∉C)
  let Z := (univ : Finset Unit).filter (fun _ => Sum.inl false∉C ∨ Sum.inl true∉C)
  let f : A ⊕ (B ⊕ Z) → PetalEdge (template p q) C
    | .inl r => ⟨edge (.inr (.inr r.val)),.inr r.val,(mem_filter.mp r.property).2,by simp [edge]⟩
    | .inr (.inl r) => ⟨edge (.inr (.inl r.val)),by
        rcases (mem_filter.mp r.property).2 with hc|hr
        · exact ⟨.inl (side r.val),hc,by simp [edge]⟩
        · exact ⟨.inr r.val,hr,by simp [edge]⟩⟩
    | .inr (.inr z) => ⟨edge (.inl ()),by
        rcases (mem_filter.mp z.property).2 with hf|ht
        · exact ⟨.inl false,hf,by simp [edge]⟩
        · exact ⟨.inl true,ht,by simp [edge]⟩⟩
  let code : A ⊕ (B ⊕ Z) → Unit ⊕ (Arms p q ⊕ Arms p q)
    | .inl r => .inr (.inr r.val)
    | .inr (.inl r) => .inr (.inl r.val)
    | .inr (.inr z) => .inl z.val
  have hcode : Function.Injective code := by
    intro x y he
    cases x with
    | inl r =>
      cases y with
      | inl r' => exact congrArg Sum.inl (Subtype.ext (Sum.inr.inj (Sum.inr.inj he)))
      | inr y => cases y <;> simp [code] at he
    | inr x =>
      cases y with
      | inl r => cases x <;> simp [code] at he
      | inr y =>
        cases x with
        | inl r => cases y with
          | inl r' => exact congrArg (fun z => Sum.inr (Sum.inl z)) (Subtype.ext (Sum.inl.inj (Sum.inr.inj he)))
          | inr z => exact (Sum.inr_ne_inl he).elim
        | inr z => cases y with
          | inl r => exact (Sum.inl_ne_inr he).elim
          | inr z' => exact congrArg (fun z => Sum.inr (Sum.inr z)) (Subtype.ext (Sum.inl.inj he))
  have hedge (x) : (f x).val=edge (code x) := by
    cases x with
    | inl r => rfl
    | inr x => cases x with
      | inl r => rfl
      | inr z => rcases z with ⟨⟨⟩,hz⟩; rfl
  have hf : Function.Injective f := by
    intro x y he
    apply hcode
    apply edge_injective p q
    rw [← hedge x,← hedge y]
    exact congrArg Subtype.val he
  have h := Nat.card_le_card_of_injective f hf
  have hZ : Z.card=(if Sum.inl false∉C ∨ Sum.inl true∉C then 1 else 0) := by
    by_cases hz : Sum.inl false∉C ∨ Sum.inl true∉C <;> simp [Z,hz]
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_coe,hZ,Nat.add_assoc] using h

end Erdos571.DoubleSpider


/-! The exact balance inequalities for a two-center rooted tree. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph RootedSunflower

lemma card_filter_sum {A B : Type*} [Fintype A] [Fintype B] (P : A ⊕ B → Prop) [DecidablePred P] :
    (univ.filter P).card=(univ.filter (fun a => P (.inl a))).card+(univ.filter (fun b => P (.inr b))).card := by
  classical
  have he : univ.filter P=(univ.filter (fun a => P (.inl a))).disjSum (univ.filter (fun b => P (.inr b))) := by
    ext x; cases x <;> simp
  rw [he,card_disjSum]

lemma unpinned_card (p q : ℕ) (C : Finset (Interior p q)) :
    Fintype.card (Interior p q)-C.card =
      (univ.filter (fun i : Fin p => Sum.inr (Sum.inl i)∉C)).card+
      (univ.filter (fun j : Fin q => Sum.inr (Sum.inr j)∉C)).card+
      (if Sum.inl false∈C then 0 else 1)+(if Sum.inl true∈C then 0 else 1) := by
  classical
  rw [← card_compl]
  have he : Cᶜ=univ.filter (fun a => a∉C) := by ext a; simp
  rw [he]
  rw [card_filter_sum,card_filter_sum]
  have he : (univ.filter (fun c : Bool => Sum.inl c∉C)).card=
      (if Sum.inl false∈C then 0 else 1)+(if Sum.inl true∈C then 0 else 1) := by
    by_cases hf : Sum.inl false∈C <;> by_cases ht : Sum.inl true∈C <;>
      simp [Finset.filter_insert,Finset.filter_singleton,hf,ht]
  rw [he]
  omega

/-- Balance is exactly governed by the two possible one-center pieces.
In particular, two arms on one side and three on the other are balanced. -/
lemma balance (p q : ℕ) (hpq : q ≤ 2*p+1) (hqp : p ≤ 2*q+1) :
    ∀C : Finset (Interior p q),
      (2*(p+q)+1)*(Fintype.card (Interior p q)-C.card) ≤
        (p+q+2)*Nat.card (PetalEdge (template p q) C) := by
  classical
  intro C
  let X := univ.filter (fun i : Fin p => Sum.inr (Sum.inl i)∉C)
  let Y := univ.filter (fun j : Fin q => Sum.inr (Sum.inr j)∉C)
  have hx : X.card ≤ p := by simpa using card_le_univ X
  have hy : Y.card ≤ q := by simpa using card_le_univ Y
  have hb := petal_bound p q C
  rw [card_filter_sum,card_filter_sum] at hb
  change X.card+Y.card+_+_ ≤ _ at hb
  rw [unpinned_card]
  change (2*(p+q)+1)*(X.card+Y.card+_+_) ≤ _
  by_cases hf : Sum.inl false∈C <;> by_cases ht : Sum.inl true∈C
  · have h₁ : (univ.filter (fun i : Fin p => Sum.inl (side (p:=p) (q:=q) (.inl i))∉C ∨ Sum.inr (.inl i)∉C))=X := by simp [side,hf,X]
    have h₂ : (univ.filter (fun j : Fin q => Sum.inl (side (p:=p) (q:=q) (.inr j))∉C ∨ Sum.inr (.inr j)∉C))=Y := by simp [side,ht,Y]
    rw [h₁,h₂] at hb
    simp only [hf,ht,not_true_eq_false,or_self,if_false,if_true,add_zero] at hb ⊢
    nlinarith
  · have h₁ : (univ.filter (fun i : Fin p => Sum.inl (side (p:=p) (q:=q) (.inl i))∉C ∨ Sum.inr (.inl i)∉C))=X := by simp [side,hf,X]
    have h₂ : (univ.filter (fun j : Fin q => Sum.inl (side (p:=p) (q:=q) (.inr j))∉C ∨ Sum.inr (.inr j)∉C)).card=q := by simp [side,ht]
    rw [h₁,h₂] at hb
    simp only [hf,ht,not_true_eq_false,not_false_eq_true,false_or,if_true,if_false,add_zero] at hb ⊢
    have hmul := Nat.mul_le_mul_left (p+q) hy
    nlinarith
  · have h₁ : (univ.filter (fun i : Fin p => Sum.inl (side (p:=p) (q:=q) (.inl i))∉C ∨ Sum.inr (.inl i)∉C)).card=p := by simp [side,hf]
    have h₂ : (univ.filter (fun j : Fin q => Sum.inl (side (p:=p) (q:=q) (.inr j))∉C ∨ Sum.inr (.inr j)∉C))=Y := by simp [side,ht,Y]
    rw [h₁,h₂] at hb
    simp only [hf,ht,not_true_eq_false,not_false_eq_true,true_or,if_true,if_false,add_zero] at hb ⊢
    have hmul := Nat.mul_le_mul_left (p+q) hx
    nlinarith
  · have h₁ : (univ.filter (fun i : Fin p => Sum.inl (side (p:=p) (q:=q) (.inl i))∉C ∨ Sum.inr (.inl i)∉C)).card=p := by simp [side,hf]
    have h₂ : (univ.filter (fun j : Fin q => Sum.inl (side (p:=p) (q:=q) (.inr j))∉C ∨ Sum.inr (.inr j)∉C)).card=q := by simp [side,ht]
    rw [h₁,h₂] at hb
    simp only [hf,ht,not_false_eq_true,or_self,if_true,if_false] at hb ⊢
    have hm := Nat.mul_le_mul_left (p+q) (Nat.add_le_add hx hy)
    nlinarith

lemma exists_lower (p q : ℕ) (hsum : 1 ≤ p+q) (hpq : q ≤ 2*p+1) (hqp : p ≤ 2*q+1) :
    ∃M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-((p+q+2:ℕ):ℝ)/((2*(p+q)+1:ℕ):ℝ)))
      (fun n : ℕ => (extremalNumber n (graph p q M):ℝ)) := by
  letI : Nonempty (Arms p q) := by
    by_cases hp : 0<p
    · exact ⟨.inl ⟨0,hp⟩⟩
    · exact ⟨.inr ⟨0,by omega⟩⟩
  exact FullRootedPower.exact_lower (template p q) (no_isolated p q) (p+q+2) (2*(p+q)+1)
    (by omega) (by omega) (balance p q hpq hqp)

lemma fifteen_eleven_lower : ∃M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (n:ℝ)^(15/11:ℝ))
    (fun n : ℕ => (extremalNumber n (graph 2 3 M):ℝ)) := by
  have h := exists_lower 2 3 (by omega) (by omega) (by omega)
  norm_num at h
  exact h

end Erdos571.DoubleSpider


/-! A double spider is the union of a long spider and a short spider sharing a center. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph

/-- Swap the two sides of the core edge. -/
def swap (p q : ℕ) : (template p q).Copy (template q p) where
  toHom :=
    { toFun := Sum.map (Sum.map not Sum.swap) Sum.swap
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b =>
            cases a with
            | inl c =>
              cases b with
              | inl d => exact Bool.not_injective.ne h
              | inr r => cases r <;> cases c <;> simp_all [template,RootedIncidence.graph,core,side]
            | inr r => cases b with
              | inl c => cases r <;> cases c <;> simp_all [template,RootedIncidence.graph,core,side]
              | inr r' => exact h.elim
          | inr r => exact congrArg (Sum.map not Sum.swap) h
        | inr r => cases v with
          | inl a => exact congrArg (Sum.map not Sum.swap) h
          | inr r' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Sum.map_injective.mpr ⟨Bool.not_injective,(Equiv.sumComm _ _).injective⟩,(Equiv.sumComm _ _).injective⟩

def leftVertex (p q : ℕ) : Option (Fin p) ⊕ Fin p → Interior p q ⊕ Arms p q
  | .inl none => .inl (.inl false)
  | .inl (some i) => .inl (.inr (.inl i))
  | .inr i => .inr (.inl i)

lemma leftVertex_injective (p q : ℕ) : Function.Injective (leftVertex p q) := by
  intro u v he
  cases u with
  | inl a =>
    cases v with
    | inl b => cases a <;> cases b <;> simpa [leftVertex] using he
    | inr i => cases a <;> simp [leftVertex] at he
  | inr i => cases v with
    | inl a => cases a <;> simp [leftVertex] at he
    | inr j => simpa [leftVertex] using he

def leftCopy (p q : ℕ) : (LongSpider.template p).Copy (template p q) where
  toHom :=
    { toFun := leftVertex p q
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b => cases a <;> cases b <;> simp_all [template,RootedIncidence.graph,core,side,leftVertex,LongSpider.template,ShortSpider.template]
          | inr r => change a=some r at h; subst a; rfl
        | inr r => cases v with
          | inl a => change some r=a at h; subst a; rfl
          | inr r' => exact h.elim }
  injective' := leftVertex_injective p q

def leftShortVertex (p q : ℕ) : Option (Fin p) ⊕ Option (Fin p) → Interior p q ⊕ Arms p q
  | .inl none => .inl (.inl false)
  | .inl (some i) => .inl (.inr (.inl i))
  | .inr none => .inl (.inl true)
  | .inr (some i) => .inr (.inl i)

lemma leftShortVertex_injective (p q : ℕ) : Function.Injective (leftShortVertex p q) := by
  intro u v he
  cases u with
  | inl a =>
    cases v with
    | inl b => cases a <;> cases b <;> simpa [leftShortVertex] using he
    | inr b => cases a <;> cases b <;> simp [leftShortVertex] at he
  | inr a =>
    cases v with
    | inl b => cases a <;> cases b <;> simp [leftShortVertex] at he
    | inr b => cases a <;> cases b <;> simpa [leftShortVertex] using he

def leftShortCopy (p q : ℕ) : (ShortSpider.template p).Copy (template p q) where
  toHom :=
    { toFun := leftShortVertex p q
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b => cases a <;> cases b <;> simp_all [template,RootedIncidence.graph,core,side,leftVertex,leftShortVertex,LongSpider.template,ShortSpider.template]
          | inr r =>
            change a=r at h
            subst a
            cases r
            · exact Bool.noConfusion
            · rfl
        | inr r => cases v with
          | inl a =>
            change r=a at h
            subst a
            cases r
            · exact Bool.noConfusion
            · rfl
          | inr r' => exact h.elim }
  injective' := leftShortVertex_injective p q

def rightCopy (p q : ℕ) : (LongSpider.template q).Copy (template p q) :=
  (swap q p).comp (leftCopy q p)

def rightShortCopy (p q : ℕ) : (ShortSpider.template q).Copy (template p q) :=
  (swap q p).comp (leftShortCopy q p)

lemma pair_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (f g : (template p q).Copy G)
    (hL : f.comp (leftCopy p q)=g.comp (leftCopy p q))
    (hR : f.comp (rightCopy p q)=g.comp (rightCopy p q)) : f=g := by
  apply Copy.ext
  intro v
  have hl (v) := congrArg (fun h : (LongSpider.template p).Copy G => h v) hL
  have hr (v) := congrArg (fun h : (LongSpider.template q).Copy G => h v) hR
  cases v with
  | inl a =>
    cases a with
    | inl c =>
      cases c
      · exact hl (.inl none)
      · exact hr (.inl none)
    | inr r => cases r with
      | inl i => exact hl (.inl (some i))
      | inr j => exact hr (.inl (some j))
  | inr r => cases r with
    | inl i => exact hl (.inr i)
    | inr j => exact hr (.inr j)

lemma short_pair_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (f g : (template p q).Copy G)
    (hL : f.comp (leftCopy p q)=g.comp (leftCopy p q))
    (hR : f.comp (rightShortCopy p q)=g.comp (rightShortCopy p q)) : f=g := by
  apply pair_ext G p q f g hL
  apply Copy.ext
  intro v
  have hr (v) := congrArg (fun h : (ShortSpider.template q).Copy G => h v) hR
  cases v with
  | inl a =>
    cases a with
    | none => exact hr (.inl none)
    | some j => exact hr (.inl (some j))
  | inr j => exact hr (.inr (some j))

end Erdos571.DoubleSpider


/-! Bounded loads for double-spider copies with explicitly bounded local fibers.
No claim that the exclusions are negligible is made here. -/
set_option maxHeartbeats 2000000
namespace Erdos571.FiberLoad
open Finset

/-- Loads on an image family lift through a uniformly bounded projection. -/
lemma bound {I J W : Type*} [DecidableEq I] [DecidableEq J] [DecidableEq W]
    (F : Finset I) (g : I → J) (foot : J → Finset W) (L B : ℕ)
    (hcomp : ∀j, (F.filter (fun i => g i=j)).card ≤ L)
    (hload : ∀w, ((F.image g).filter (fun j => w∈foot j)).card ≤ B) (w : W) :
    (F.filter (fun i => w∈foot (g i))).card ≤ L*B := by
  let A := F.filter (fun i => w∈foot (g i))
  have hc : A.card ≤ L*(A.image g).card := card_le_mul_card_image A L (by
    intro j hj
    exact (card_le_card (filter_subset_filter _ (filter_subset _ _))).trans (hcomp j))
  have hi : A.image g ⊆ (F.image g).filter (fun j => w∈foot j) := by
    intro j hj
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hj
    exact mem_filter.mpr ⟨mem_image.mpr ⟨i,(mem_filter.mp hi).1,rfl⟩,(mem_filter.mp hi).2⟩
  exact hc.trans (Nat.mul_le_mul_left L ((card_le_card hi).trans (hload w)))

end Erdos571.FiberLoad

namespace Erdos571.ConnectedCopyBound
open SimpleGraph

lemma Light.comp {V V' W : Type} [Fintype V] [Fintype V'] [DecidableEq V] [DecidableEq V'] [DecidableEq W]
    {H : SimpleGraph V} {H' : SimpleGraph V'} {G : SimpleGraph W} [DecidableRel G.Adj]
    {U : Finset W} {t : ℕ} {f : H.Copy G} (h : Light H G U t f) (g : H'.Copy H) :
    Light H' G U t (f.comp g) := by
  intro u v w huv hvw huw
  exact h (g u) (g v) (g w) (g.toHom.map_adj huv) (g.toHom.map_adj hvw) (g.injective.ne huw)

end Erdos571.ConnectedCopyBound

namespace Erdos571.ShortSpider
open SimpleGraph

lemma good_of_light {W : Type} [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s : ℕ) (f : (template s).Copy G) (hm : ∀v, f v∈U)
    (hl : ConnectedCopyBound.Light (template s) G U t f) : GoodCopy G U t s f := by
  refine ⟨hm,fun j => ⟨?_,?_⟩⟩
  · exact hl (.inr none) (.inl none) (.inl (some j)) rfl trivial Sum.inr_ne_inl
  · exact hl (.inl none) (.inl (some j)) (.inr (some j)) trivial rfl Sum.inl_ne_inr

end Erdos571.ShortSpider

namespace Erdos571.DoubleSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

/-- `L` bounds the short-spider completion fibers across the core edge.
The two long-spider conditions also exclude their own rich omitted-arm fibers. -/
def GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (f : (template (p+1) (q+1)).Copy G) : Prop :=
  (∀v, f v∈U) ∧ ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f ∧
  LongSpider.GoodCopy G U t p M (f.comp (leftCopy (p+1) (q+1))) ∧
  LongSpider.GoodCopy G U t q M (f.comp (rightCopy (p+1) (q+1))) ∧
  (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L ∧
  (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L

lemma left_short_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (f : (template (p+1) (q+1)).Copy G) (hf : GoodCopy G U t L p q M f) :
    ShortSpider.GoodCopy G U t (p+1) (f.comp (leftShortCopy (p+1) (q+1))) :=
  ShortSpider.good_of_light G U t (p+1) _ (fun v => hf.1 _) (hf.2.1.comp _)

lemma right_short_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (f : (template (p+1) (q+1)).Copy G) (hf : GoodCopy G U t L p q M f) :
    ShortSpider.GoodCopy G U t (q+1) (f.comp (rightShortCopy (p+1) (q+1))) :=
  ShortSpider.good_of_light G U t (q+1) _ (fun v => hf.1 _) (hf.2.1.comp _)

lemma left_completion (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) → W)
    (hgood : ∀f∈F, GoodCopy G U t L p q M f)
    (hroot : ∀f∈F, ∀r', f (.inr r')=r r') (g : (LongSpider.template (p+1)).Copy G) :
    (F.filter (fun f => f.comp (leftCopy (p+1) (q+1))=g)).card ≤ L := by
  classical
  let A := F.filter (fun f => f.comp (leftCopy (p+1) (q+1))=g)
  change A.card ≤ L
  by_cases hA : A.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hA,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hA
  let z := g (.inl none)
  let r' : Fin (q+1) → W := fun j => r (.inr j)
  have hcent : ∀f∈A, f (.inl (.inl false))=z := by
    intro f hf
    exact congrArg (fun h : (LongSpider.template (p+1)).Copy G => h (.inl none)) (mem_filter.mp hf).2
  have hsize : (LongSpider.shortFiber G U t (q+1) z r').card ≤ L := by
    have h := (hgood f₀ (mem_filter.mp hf₀).1).2.2.2.2.2
    simpa only [hcent f₀ hf₀,hroot f₀ (mem_filter.mp hf₀).1] using h
  let proj : (template (p+1) (q+1)).Copy G → (ShortSpider.template (q+1)).Copy G := fun f => f.comp (rightShortCopy (p+1) (q+1))
  have hc : A.card ≤ (LongSpider.shortFiber G U t (q+1) z r').card := by
    apply card_le_card_of_injOn proj
    · intro f hf
      exact (LongSpider.mem_shortFiber G U t (q+1) z r' _).mpr
        ⟨right_short_good G U t L p q M f (hgood f (mem_filter.mp hf).1),
          hcent f hf,fun j => hroot f (mem_filter.mp hf).1 _⟩
    · intro f hf f' hf' he
      exact short_pair_ext G (p+1) (q+1) f f'
        ((mem_filter.mp hf).2.trans (mem_filter.mp hf').2.symm) he
  exact hc.trans hsize

lemma right_completion (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) → W)
    (hgood : ∀f∈F, GoodCopy G U t L p q M f)
    (hroot : ∀f∈F, ∀r', f (.inr r')=r r') (g : (LongSpider.template (q+1)).Copy G) :
    (F.filter (fun f => f.comp (rightCopy (p+1) (q+1))=g)).card ≤ L := by
  classical
  let A := F.filter (fun f => f.comp (rightCopy (p+1) (q+1))=g)
  change A.card ≤ L
  by_cases hA : A.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hA,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hA
  let z := g (.inl none)
  let r' : Fin (p+1) → W := fun i => r (.inl i)
  have hcent : ∀f∈A, f (.inl (.inl true))=z := by
    intro f hf
    exact congrArg (fun h : (LongSpider.template (q+1)).Copy G => h (.inl none)) (mem_filter.mp hf).2
  have hsize : (LongSpider.shortFiber G U t (p+1) z r').card ≤ L := by
    have h := (hgood f₀ (mem_filter.mp hf₀).1).2.2.2.2.1
    simpa only [hcent f₀ hf₀,hroot f₀ (mem_filter.mp hf₀).1] using h
  let proj : (template (p+1) (q+1)).Copy G → (ShortSpider.template (p+1)).Copy G := fun f => f.comp (leftShortCopy (p+1) (q+1))
  have hc : A.card ≤ (LongSpider.shortFiber G U t (p+1) z r').card := by
    apply card_le_card_of_injOn proj
    · intro f hf
      exact (LongSpider.mem_shortFiber G U t (p+1) z r' _).mpr
        ⟨left_short_good G U t L p q M f (hgood f (mem_filter.mp hf).1),
          hcent f hf,fun j => hroot f (mem_filter.mp hf).1 _⟩
    · intro f hf f' hf' he
      apply pair_ext G (p+1) (q+1) f f' ?_ ((mem_filter.mp hf).2.trans (mem_filter.mp hf').2.symm)
      apply Copy.ext
      intro v
      have heval (v) := congrArg (fun h : (ShortSpider.template (p+1)).Copy G => h v) he
      cases v with
      | inl a => cases a with
        | none => exact heval (.inl none)
        | some i => exact heval (.inl (some i))
      | inr i => exact heval (.inr (some i))
  exact hc.trans hsize

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) → W)
    (hgood : ∀f∈F, GoodCopy G U t L p q M f)
    (hroot : ∀f∈F, ∀r', f (.inr r')=r r') (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤
      L*(LongSpider.loadBound t p M+LongSpider.loadBound t q M) := by
  classical
  let left : (template (p+1) (q+1)).Copy G → (LongSpider.template (p+1)).Copy G := fun f => f.comp (leftCopy (p+1) (q+1))
  let right : (template (p+1) (q+1)).Copy G → (LongSpider.template (q+1)).Copy G := fun f => f.comp (rightCopy (p+1) (q+1))
  have hleft : ∀w, ((F.image left).filter (fun g => w∈RootedPacking.interior g)).card ≤ LongSpider.loadBound t p M := by
    apply LongSpider.interior_load G U t p M (F.image left) (fun i => r (.inl i))
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact (hgood f hf).2.2.1
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      intro i
      exact hroot f hf _
  have hright : ∀w, ((F.image right).filter (fun g => w∈RootedPacking.interior g)).card ≤ LongSpider.loadBound t q M := by
    apply LongSpider.interior_load G U t q M (F.image right) (fun j => r (.inr j))
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact (hgood f hf).2.2.2.1
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      intro j
      exact hroot f hf _
  have hl := FiberLoad.bound F left RootedPacking.interior L (LongSpider.loadBound t p M)
    (left_completion G U t L p q M F r hgood hroot) hleft w
  have hr := FiberLoad.bound F right RootedPacking.interior L (LongSpider.loadBound t q M)
    (right_completion G U t L p q M F r hgood hroot) hright w
  have hsub : F.filter (fun f => w∈RootedPacking.interior f) ⊆
      F.filter (fun f => w∈RootedPacking.interior (left f)) ∪ F.filter (fun f => w∈RootedPacking.interior (right f)) := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,rfl⟩ := hw
    have hfl : ∀b, f (leftCopy (p+1) (q+1) (.inl b))∈RootedPacking.interior (left f) := fun b => RootedPacking.mem_interior (left f) b
    have hfr : ∀b, f (rightCopy (p+1) (q+1) (.inl b))∈RootedPacking.interior (right f) := fun b => RootedPacking.mem_interior (right f) b
    cases a with
    | inl c =>
      cases c
      · exact mem_union_left _ (mem_filter.mpr ⟨(mem_filter.mp hf).1,hfl none⟩)
      · exact mem_union_right _ (mem_filter.mpr ⟨(mem_filter.mp hf).1,hfr none⟩)
    | inr r => cases r with
      | inl i => exact mem_union_left _ (mem_filter.mpr ⟨(mem_filter.mp hf).1,hfl (some i)⟩)
      | inr j => exact mem_union_right _ (mem_filter.mpr ⟨(mem_filter.mp hf).1,hfr (some j)⟩)
  exact (card_le_card hsub).trans ((card_union_le _ _).trans (by rw [Nat.mul_add]; exact Nat.add_le_add hl hr))

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (ht : 1 ≤ t) (hL : 1 ≤ L) (hf : (graph (p+1) (q+1) M).Free G)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) ↪ W)
    (hgood : ∀f∈F, GoodCopy G U t L p q M f)
    (hroot : ∀f∈F, ∀r', f (.inr r')=r r') :
    F.card < M*(p+q+4)*(L*(LongSpider.loadBound t p M+LongSpider.loadBound t q M)) := by
  classical
  by_contra hc
  have hcard : M*Fintype.card (Interior (p+1) (q+1))*(L*(LongSpider.loadBound t p M+LongSpider.loadBound t q M)) ≤ F.card := by
    have he : Fintype.card (Interior (p+1) (q+1))=p+q+4 := by simp [Interior,Arms]; omega
    simpa only [he] using Nat.le_of_not_gt hc
  have hcopy := RootedPacking.power_contained_of_bounded_load F id r hroot
    (L*(LongSpider.loadBound t p M+LongSpider.loadBound t q M)) M
    (by unfold LongSpider.loadBound; positivity)
    (interior_load G U t L p q M F r hgood hroot) hcard
  apply hf
  have he : RootedPacking.power (template (p+1) (q+1)) M=graph (p+1) (q+1) M := by
    ext u v; cases u <;> cases v <;> rfl
  rwa [← he]

end Erdos571.DoubleSpider


/-! Global counting consequences of the checked double-spider packing step. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def fiberBound (t L p q M : ℕ) : ℕ :=
  M*(p+q+4)*(L*(LongSpider.loadBound t p M+LongSpider.loadBound t q M))

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t L p q M : ℕ)
    (ht : 1 ≤ t) (hL : 1 ≤ L) (hf : (graph (p+1) (q+1) M).Free G)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (hgood : ∀f∈F, GoodCopy G U t L p q M f) :
    F.card ≤ fiberBound t L p q M*U.card^(p+q+2) := by
  classical
  let roots : (template (p+1) (q+1)).Copy G → (Arms (p+1) (q+1) → W) := fun f r => f (.inr r)
  have hbound (r : Arms (p+1) (q+1) → W) : (F.filter (fun f => roots f=r)).card ≤ fiberBound t L p q M := by
    by_cases hne : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · simp only [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hne
    have hr : Function.Injective r := by
      have he := (mem_filter.mp hf₀).2
      rw [← he]
      exact f₀.injective.comp Sum.inr_injective
    exact (rooted_count G U t L p q M ht hL hf _ ⟨r,hr⟩
      (fun f hf => hgood f (mem_filter.mp hf).1)
      (fun f hf x => congrFun (mem_filter.mp hf).2 x)).le
  have hc := card_le_mul_card_image F (fiberBound t L p q M) (fun r _ => hbound r)
  have hi : (F.image roots).card ≤ U.card^(p+q+2) := by
    let f : (F.image roots) → (Arms (p+1) (q+1) → U) := fun r x =>
      ⟨r.val x,by
        obtain ⟨g,hg,he⟩ := mem_image.mp r.property
        rw [← he]
        exact (hgood g hg).1 _⟩
    have hinj : Function.Injective f := by
      intro r r' h
      apply Subtype.ext
      funext x
      exact congrArg Subtype.val (congrFun h x)
    have h := Fintype.card_le_of_injective f hinj
    have he : Fintype.card (Arms (p+1) (q+1))=p+q+2 := by simp [Arms]; omega
    simpa only [Fintype.card_coe,Fintype.card_fun,he] using h
  exact hc.trans (Nat.mul_le_mul_left _ hi)

/-- The minimum-degree lower bound counts all copies. It does not assert that
these copies satisfy the local fiber exclusions. -/
lemma all_copies_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (p q : ℕ)
    {d : ℝ} (hd : 4*(2*p+2*q+7:ℕ) ≤ d)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ)) :
    (U.card:ℝ)*(d/4)^(2*p+2*q+5) ≤ (TreeCopiesIn.copies (template (p+1) (q+1)) G U).card := by
  have hV : Fintype.card (Interior (p+1) (q+1) ⊕ Arms (p+1) (q+1))=2*p+2*q+6 := by simp [Interior,Arms]; omega
  have h := TreeCopiesIn.lower (template (p+1) (q+1)) (isTree _ _) G U (d:=d)
    (by rw [hV]; push_cast at hd ⊢; linarith) hdeg
  simpa only [hV,show 2*p+2*q+6-1=2*p+2*q+5 by omega] using h

/-- Once a fixed positive fraction of the tree copies survives cleaning, the
sharp exponent follows from the packing bound. The lower-count hypothesis is
explicit: it is the remaining combinatorial issue, not a consequence of freeness
proved in this file. -/
lemma degree_of_many_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t L p q M : ℕ) (ht : 1 ≤ t) (hL : 1 ≤ L) (hf : (graph (p+1) (q+1) M).Free G)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (hgood : ∀f∈F, GoodCopy G U t L p q M f)
    {d : ℝ} (hd : 0 ≤ d) (hlower : (U.card:ℝ)*(d/4)^(2*p+2*q+5)/2 ≤ F.card) :
    d ≤ (2*4^(2*p+2*q+5)*(fiberBound t L p q M:ℝ))^(((2*p+2*q+5:ℕ):ℝ)⁻¹)*
      (U.card:ℝ)^(((p+q+1:ℕ):ℝ)/((2*p+2*q+5:ℕ):ℝ)) := by
  have hn : (0:ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  have hu : (F.card:ℝ) ≤ (fiberBound t L p q M:ℝ)*(U.card:ℝ)^(p+q+2) := by
    exact_mod_cast good_count G U t L p q M ht hL hf F hgood
  have hm : (U.card:ℝ)*(d/4)^(2*p+2*q+5) ≤ 2*(fiberBound t L p q M:ℝ)*(U.card:ℝ)^(p+q+2) := by linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0 ≤ (4:ℝ)^(2*p+2*q+5) by positivity)
  have he : (U.card:ℝ)*(d/4)^(2*p+2*q+5)*4^(2*p+2*q+5)=U.card*d^(2*p+2*q+5) := by
    rw [div_pow]; field_simp
  rw [he,show p+q+2=(p+q+1)+1 by omega,pow_succ (U.card:ℝ) (p+q+1)] at hm'
  have hp : d^(2*p+2*q+5) ≤ (2*4^(2*p+2*q+5)*(fiberBound t L p q M:ℝ))*(U.card:ℝ)^(p+q+1) := by
    apply (mul_le_mul_iff_left₀ hn).mp
    nlinarith
  exact LongSpider.degree_of_power (2*p+2*q+5) (p+q+1) (by omega) hn.le hd (by positivity) hp

end Erdos571.DoubleSpider


/-! A precise obstruction to reusing the short-spider heavy-pair argument. -/
namespace Erdos571.Branching
open Finset SimpleGraph

def At {V : Type*} (H : SimpleGraph V) (v : V) : Prop :=
  ∃u : Fin 3 ↪ V, ∀i, H.Adj v (u i)

lemma map {V W : Type*} {H : SimpleGraph V} {G : SimpleGraph W} (f : H.Copy G) {v : V}
    (h : At H v) : At G (f v) := by
  obtain ⟨u,hu⟩ := h
  exact ⟨⟨fun i => f (u i),f.injective.comp u.injective⟩,fun i => f.toHom.map_adj (hu i)⟩

lemma not_at_of_pair {V : Type*} (H : SimpleGraph V) (v a b : V)
    (h : ∀w, H.Adj v w → w=a ∨ w=b) : ¬ At H v := by
  classical
  rintro ⟨u,hu⟩
  have hs : univ.image u ⊆ ({a,b} : Finset V) := by
    intro w hw
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hw
    simpa only [mem_insert,mem_singleton] using h (u i) (hu i)
  have hc : (univ.image u).card=3 := by rw [card_image_of_injective _ u.injective]; simp
  have hb : ({a,b} : Finset V).card ≤ 2 := card_le_two
  have hn := card_le_card hs
  omega

end Erdos571.Branching

namespace Erdos571.ShortSpider
open SimpleGraph

lemma middle_not_branching (s M : ℕ) (i : Fin M) (j : Fin s) :
    ¬ Branching.At (graph s M) (.inl (i,some j)) := by
  apply Branching.not_at_of_pair _ _ (.inl (i,none)) (.inr (some j))
  intro v hv
  cases v with
  | inl a =>
    rcases a with ⟨k,a⟩
    change i=k ∧ (template s).Adj (.inl (some j)) (.inl a) at hv
    obtain ⟨rfl,ha⟩ := hv
    cases a with
    | none => exact Or.inl rfl
    | some k => exact ha.elim
  | inr r =>
    change some j=r at hv
    exact Or.inr (congrArg Sum.inr hv.symm)

/-- Every edge whose endpoints both branch is incident with the one short root. -/
lemma branch_edge_covered (s M : ℕ) {u v : (Fin M × Option (Fin s)) ⊕ Option (Fin s)}
    (h : (graph s M).Adj u v) (hu : Branching.At (graph s M) u) (hv : Branching.At (graph s M) v) :
    u=.inr none ∨ v=.inr none := by
  cases u with
  | inl a =>
    rcases a with ⟨i,a⟩
    cases a with
    | some j => exact (middle_not_branching s M i j hu).elim
    | none =>
      cases v with
      | inl a =>
        rcases a with ⟨k,a⟩
        cases a with
        | some j => exact (middle_not_branching s M k j hv).elim
        | none => exact h.2.elim
      | inr r =>
        change none=r at h
        exact Or.inr (congrArg Sum.inr h.symm)
  | inr r =>
    cases r with
    | none => exact Or.inl rfl
    | some j =>
      cases v with
      | inl a =>
        rcases a with ⟨i,a⟩
        change some j=a at h
        subst a
        exact (middle_not_branching s M i j hv).elim
      | inr r' => exact h.elim

end Erdos571.ShortSpider

namespace Erdos571.DoubleSpider
open SimpleGraph

lemma left_center_branching (p q M : ℕ) (hp : 2 ≤ p) (i : Fin M) :
    Branching.At (graph p q M) (.inl (i,.inl false)) := by
  let a : Fin p := ⟨0,by omega⟩
  let b : Fin p := ⟨1,by omega⟩
  refine ⟨⟨![Sum.inl (i,Sum.inl true),Sum.inl (i,Sum.inr (Sum.inl a)),Sum.inl (i,Sum.inr (Sum.inl b))],?_⟩,?_⟩
  · intro j k he
    fin_cases j <;> fin_cases k <;> simp_all [a,b,Fin.ext_iff]
  · intro j
    fin_cases j
    · exact ⟨rfl,Bool.noConfusion⟩
    · exact ⟨rfl,rfl⟩
    · exact ⟨rfl,rfl⟩

lemma right_center_branching (p q M : ℕ) (hq : 2 ≤ q) (i : Fin M) :
    Branching.At (graph p q M) (.inl (i,.inl true)) := by
  let a : Fin q := ⟨0,by omega⟩
  let b : Fin q := ⟨1,by omega⟩
  refine ⟨⟨![Sum.inl (i,Sum.inl false),Sum.inl (i,Sum.inr (Sum.inr a)),Sum.inl (i,Sum.inr (Sum.inr b))],?_⟩,?_⟩
  · intro j k he
    fin_cases j <;> fin_cases k <;> simp_all [a,b,Fin.ext_iff]
  · intro j
    fin_cases j
    · exact ⟨rfl,Bool.noConfusion⟩
    · exact ⟨rfl,rfl⟩
    · exact ⟨rfl,rfl⟩

/-- No short-spider power can contain a nontrivial double-spider power.
Thus double-spider-freeness does not imply the short-spider-freeness needed
by the earlier heavy-pair estimate. -/
theorem not_contained_shortSpider (p q M : ℕ) (hp : 2 ≤ p) (hq : 2 ≤ q) (hM : 2 ≤ M)
    (s N : ℕ) : ¬ (graph p q M).IsContained (ShortSpider.graph s N) := by
  rintro ⟨f⟩
  let i₀ : Fin M := ⟨0,by omega⟩
  let i₁ : Fin M := ⟨1,by omega⟩
  have hh (i : Fin M) : f (.inl (i,.inl false))=.inr none ∨ f (.inl (i,.inl true))=.inr none :=
    ShortSpider.branch_edge_covered s N
      (f.toHom.map_adj (show (graph p q M).Adj (.inl (i,.inl false)) (.inl (i,.inl true)) from ⟨rfl,Bool.noConfusion⟩))
      (Branching.map f (left_center_branching p q M hp i))
      (Branching.map f (right_center_branching p q M hq i))
  rcases hh i₀ with h₀|h₀ <;> rcases hh i₁ with h₁|h₁
  all_goals
    have he := f.injective (h₀.trans h₁.symm)
    simp [i₀,i₁,Fin.ext_iff] at he

end Erdos571.DoubleSpider

/-! Gluing a long spider and a short spider along the latter's short root. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open SimpleGraph Finset

def glueCode (p q : ℕ) : Interior p q ⊕ Arms p q →
    (Option (Fin p) ⊕ Fin p) ⊕ (Option (Fin q) ⊕ Fin q)
  | .inl (.inl false) => .inl (.inl none)
  | .inl (.inl true) => .inr (.inl none)
  | .inl (.inr (.inl i)) => .inl (.inl (some i))
  | .inl (.inr (.inr j)) => .inr (.inl (some j))
  | .inr (.inl i) => .inl (.inr i)
  | .inr (.inr j) => .inr (.inr j)

lemma glueCode_injective (p q : ℕ) : Function.Injective (glueCode p q) := by
  let back : (Option (Fin p) ⊕ Fin p) ⊕ (Option (Fin q) ⊕ Fin q) → Interior p q ⊕ Arms p q :=
    Sum.elim (leftCopy p q) (rightCopy p q)
  have h : Function.LeftInverse back (glueCode p q) := by
    intro v
    cases v with
    | inl a => cases a with
      | inl c => cases c <;> rfl
      | inr r => cases r <;> rfl
    | inr r => cases r <;> rfl
  exact h.injective

/-- Only the short root is shared. The cross-range hypothesis says all other
vertices of the right copy are disjoint from the whole left copy. -/
def glueCopy {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G)
    (hcent : g (.inr none)=f (.inl none))
    (hcross : ∀u v, f u≠g (Sum.map id some v)) : (template p q).Copy G := by
  let right : Option (Fin q) ⊕ Fin q → W := fun v => g (Sum.map id some v)
  let val := Sum.elim f right
  have hr : Function.Injective right := g.injective.comp (Sum.map_injective.mpr ⟨Function.injective_id,Option.some_injective _⟩)
  have hv : Function.Injective val := by
    intro u v he
    cases u with
    | inl u => cases v with
      | inl v => exact congrArg Sum.inl (f.injective he)
      | inr v => exact (hcross u v he).elim
    | inr u => cases v with
      | inl v => exact (hcross v u he.symm).elim
      | inr v => exact congrArg Sum.inr (hr he)
  refine {toHom := {toFun := val ∘ glueCode p q,map_rel' := ?_},injective' := hv.comp (glueCode_injective p q)}
  intro u v h
  cases u with
  | inl a =>
    cases v with
    | inl b =>
      cases a with
      | inl c =>
        cases b with
        | inl d =>
          change c≠d at h
          cases c <;> cases d
          · exact (h rfl).elim
          · change G.Adj (f (.inl none)) (g (.inl none))
            rw [← hcent]
            exact g.toHom.map_adj (show (ShortSpider.template q).Adj (.inr none) (.inl none) from rfl)
          · change G.Adj (g (.inl none)) (f (.inl none))
            rw [← hcent]
            exact g.toHom.map_adj (show (ShortSpider.template q).Adj (.inl none) (.inr none) from rfl)
          · exact (h rfl).elim
        | inr r =>
          change c=side r at h
          subst c
          cases r with
          | inl i => exact f.toHom.map_adj (show (LongSpider.template p).Adj (.inl none) (.inl (some i)) from trivial)
          | inr j => exact g.toHom.map_adj (show (ShortSpider.template q).Adj (.inl none) (.inl (some j)) from trivial)
      | inr r =>
        cases b with
        | inl c =>
          change side r=c at h
          subst c
          cases r with
          | inl i => exact f.toHom.map_adj (show (LongSpider.template p).Adj (.inl (some i)) (.inl none) from trivial)
          | inr j => exact g.toHom.map_adj (show (ShortSpider.template q).Adj (.inl (some j)) (.inl none) from trivial)
        | inr r' => exact h.elim
    | inr r =>
      change a=.inr r at h
      subst a
      cases r with
      | inl i => exact f.toHom.map_adj (show (LongSpider.template p).Adj (.inl (some i)) (.inr i) from rfl)
      | inr j => exact g.toHom.map_adj (show (ShortSpider.template q).Adj (.inl (some j)) (.inr (some j)) from rfl)
  | inr r =>
    cases v with
    | inl a =>
      change a=.inr r at h
      subst a
      cases r with
      | inl i => exact f.toHom.map_adj (show (LongSpider.template p).Adj (.inr i) (.inl (some i)) from rfl)
      | inr j => exact g.toHom.map_adj (show (ShortSpider.template q).Adj (.inr (some j)) (.inl (some j)) from rfl)
    | inr r' => exact h.elim

@[simp] lemma glueCopy_left_center {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) :
    glueCopy G p q f g hc hx (.inl (.inl false))=f (.inl none) := rfl
@[simp] lemma glueCopy_right_center {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) :
    glueCopy G p q f g hc hx (.inl (.inl true))=g (.inl none) := rfl
@[simp] lemma glueCopy_left_middle {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) (i : Fin p) :
    glueCopy G p q f g hc hx (.inl (.inr (.inl i)))=f (.inl (some i)) := rfl
@[simp] lemma glueCopy_right_middle {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) (j : Fin q) :
    glueCopy G p q f g hc hx (.inl (.inr (.inr j)))=g (.inl (some j)) := rfl
@[simp] lemma glueCopy_left_root {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) (i : Fin p) :
    glueCopy G p q f g hc hx (.inr (.inl i))=f (.inr i) := rfl
@[simp] lemma glueCopy_right_root {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) (j : Fin q) :
    glueCopy G p q f g hc hx (.inr (.inr j))=g (.inr (some j)) := rfl

lemma glueCopy_interior {W : Type*} [DecidableEq W] (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (ShortSpider.template q).Copy G) (hc) (hx) :
    RootedPacking.interior (glueCopy G p q f g hc hx)=RootedPacking.interior f ∪ RootedPacking.interior g := by
  classical
  ext w
  simp only [RootedPacking.interior,mem_image,mem_univ,true_and,mem_union]
  constructor
  · rintro ⟨a,rfl⟩
    cases a with
    | inl c =>
      cases c
      · exact Or.inl ⟨none,rfl⟩
      · exact Or.inr ⟨none,rfl⟩
    | inr r => cases r with
      | inl i => exact Or.inl ⟨some i,rfl⟩
      | inr j => exact Or.inr ⟨some j,rfl⟩
  · rintro (⟨a,rfl⟩|⟨b,rfl⟩)
    · cases a with
      | none => exact ⟨.inl false,rfl⟩
      | some i => exact ⟨.inr (.inl i),rfl⟩
    · cases b with
      | none => exact ⟨.inl true,rfl⟩
      | some j => exact ⟨.inr (.inr j),rfl⟩

end Erdos571.DoubleSpider


/-! Completing an already packed family along the common core edge. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

/-- Threshold for the right-hand fibers. -/
def completionThreshold (t p q M : ℕ) : ℕ :=
  (p+q+M*(p+q+2))*((q+1)*t^(q+1))

lemma contains_of_packed_rich (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1 ≤ t)
    (f : Fin M → (LongSpider.template p).Copy G) (r : Arms p q ↪ W)
    (hroot : ∀i j, f i (.inr j)=r (.inl j))
    (havoid : ∀i a j, f i (.inl a)≠r (.inr j))
    (hfdis : Pairwise (fun i j => Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j))))
    (hrich : ∀i, completionThreshold t p q M <
      (LongSpider.shortFiber G U t q (f i (.inl none)) (fun j => r (.inr j))).card) :
    (graph p q M).IsContained G := by
  classical
  let Z : Finset W := univ.image r ∪ univ.biUnion (fun i => RootedPacking.interior (f i))
  have hZ : Z.card ≤ (p+q)+M*(p+1) := by
    have hroots : (univ.image r).card ≤ p+q := by
      simpa only [Arms,card_univ,Fintype.card_sum,Fintype.card_fin] using card_image_le (s:=univ) (f:=r)
    have hfoot : (univ.biUnion (fun i => RootedPacking.interior (f i))).card ≤ M*(p+1) := by
      calc
        _ ≤ ∑i : Fin M, (RootedPacking.interior (f i)).card := card_biUnion_le
        _ = _ := by simp only [RootedPacking.interior_card,Fintype.card_option,Fintype.card_fin]; simp
    exact (card_union_le _ _).trans (Nat.add_le_add hroots hfoot)
  obtain ⟨g,hg,hgZ,hgdis⟩ := DisjointChoice.exists_choice (q+1) ((q+1)*t^(q+1)) M
    RootedPacking.interior (fun i => LongSpider.shortFiber G U t q (f i (.inl none)) (fun j => r (.inr j))) Z
    (by intro i g hg; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card g).le)
    (fun i w => LongSpider.shortFiber_load G U t q ht (f i (.inl none)) (fun j => r (.inr j)) w)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by
      change Z.card+(q+1)*M ≤ p+q+M*(p+q+2)
      nlinarith)) (hrich i))
  have hgroot (i) := (LongSpider.mem_shortFiber G U t q (f i (.inl none)) (fun j => r (.inr j)) (g i)).mp (hg i)
  have hleftZ (i) : RootedPacking.interior (f i) ⊆ Z := by
    intro w hw
    exact mem_union_right _ (mem_biUnion.mpr ⟨i,mem_univ _,hw⟩)
  have hrootZ (j) : r j∈Z := mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩)
  have hcross (i : Fin M) : ∀u v, f i u≠g i (Sum.map id some v) := by
    intro u v he
    cases u with
    | inl a =>
      cases v with
      | inl b =>
        exact Finset.disjoint_left.mp (hgZ i).symm (hleftZ i (RootedPacking.mem_interior (f i) a))
          (he ▸ RootedPacking.mem_interior (g i) b)
      | inr j =>
        change f i (.inl a)=g i (.inr (some j)) at he
        rw [(hgroot i).2.2 j] at he
        exact havoid i a j he
    | inr k =>
      have hk := hroot i k
      cases v with
      | inl b =>
        exact Finset.disjoint_left.mp (hgZ i).symm (hk ▸ hrootZ (.inl k))
          (he ▸ RootedPacking.mem_interior (g i) b)
      | inr j =>
        change f i (.inr k)=g i (.inr (some j)) at he
        rw [hk,(hgroot i).2.2 j] at he
        exact Sum.inl_ne_inr (r.injective he)
  let c : Fin M → (template p q).Copy G := fun i =>
    glueCopy G p q (f i) (g i) (hgroot i).2.1 (hcross i)
  have hcroot : ∀i j, c i (.inr j)=r j := by
    intro i j
    cases j with
    | inl k => exact hroot i k
    | inr j => exact (hgroot i).2.2 j
  have hfg (i j : Fin M) : Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (g j)) :=
    Disjoint.mono_left (hleftZ i) (hgZ j).symm
  have hcdis : ∀i j, i≠j → Disjoint (RootedPacking.interior (c i)) (RootedPacking.interior (c j)) := by
    intro i j hij
    simp only [c,glueCopy_interior,disjoint_union_left,disjoint_union_right]
    exact ⟨⟨hfdis hij,(hfg j i).symm⟩,⟨hfg i j,hgdis hij⟩⟩
  have he : RootedPacking.power (template p q) M=graph p q M := by
    ext u v; cases u <;> cases v <;> rfl
  rw [← he]
  exact ⟨RootedPacking.powerCopy M r c hcroot hcdis⟩

end Erdos571.DoubleSpider


/-! Rich completion fibers force a double-spider power after projection packing. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

lemma contains_of_rich_completions (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1 ≤ t)
    (F : Finset ((LongSpider.template (p+1)).Copy G)) (r : Arms (p+1) q ↪ W)
    (hgood : ∀f∈F, LongSpider.GoodCopy G U t p M f)
    (hroot : ∀f∈F, ∀i, f (.inr i)=r (.inl i))
    (havoid : ∀f∈F, ∀a j, f (.inl a)≠r (.inr j))
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl none)) (fun j => r (.inr j))).card)
    (hcard : M*(p+2)*LongSpider.loadBound t p M ≤ F.card) :
    (graph (p+1) q M).IsContained G := by
  classical
  obtain ⟨S,hSF,hSc,hS⟩ := RootedPacking.disjoint_footprints F RootedPacking.interior
    (p+2) (LongSpider.loadBound t p M) M (by omega) (by unfold LongSpider.loadBound; positivity)
    (by intro f hf; rw [← card_pos,RootedPacking.interior_card]; simp)
    (by intro f hf; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card f).le)
    (LongSpider.interior_load G U t p M F (fun i => r (.inl i)) hgood hroot) hcard
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa only [Fintype.card_fin,Fintype.card_coe] using hSc.symm)
  let f : Fin M → (LongSpider.template (p+1)).Copy G := fun i => (e i).val
  have hf (i : Fin M) : f i∈F := hSF (e i).property
  have hfdis : Pairwise (fun i j => Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j))) := by
    intro i j hij
    apply hS (f i) (e i).property (f j) (e j).property
    intro he
    exact hij (e.injective (Subtype.ext he))
  exact contains_of_packed_rich G U t (p+1) q M ht f r
    (fun i => hroot (f i) (hf i)) (fun i => havoid (f i) (hf i)) hfdis
    (fun i => hrich (f i) (hf i))

/-- The forbidden graph bounds the number of distinct good left projections
with rich right completions. This does not bound the multiplicity of a projection. -/
theorem rich_projection_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    (F : Finset ((LongSpider.template (p+1)).Copy G)) (r : Arms (p+1) q ↪ W)
    (hgood : ∀f∈F, LongSpider.GoodCopy G U t p M f)
    (hroot : ∀f∈F, ∀i, f (.inr i)=r (.inl i))
    (havoid : ∀f∈F, ∀a j, f (.inl a)≠r (.inr j))
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl none)) (fun j => r (.inr j))).card) :
    F.card < M*(p+2)*LongSpider.loadBound t p M := by
  by_contra! hc
  exact hf (contains_of_rich_completions G U t p q M ht F r hgood hroot havoid hrich hc)

end Erdos571.DoubleSpider


/-! Quantifying the multiplicity left over after rich-projection packing. -/
set_option maxHeartbeats 1500000
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- With all roots prescribed, there are at most `t^s` choices per neighbor
of the short root. This is a maximum-degree bound, not a constant bound. -/
lemma rooted_degree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W)
    (hgood : ∀f∈F, GoodCopy G U t s f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) :
    F.card ≤ t^s*(neighbors G U (r none)).card := by
  classical
  let center : (template s).Copy G → W := fun f => f (.inl none)
  have hc : F.card ≤ t^s*(F.image center).card := card_le_mul_card_image F (t^s) (by
    intro w hw
    apply center_count G U t s _ r w
    · intro f hf; exact hgood f (mem_filter.mp hf).1
    · intro f hf; exact hroot f (mem_filter.mp hf).1
    · intro f hf; exact (mem_filter.mp hf).2)
  have hs : F.image center ⊆ neighbors G U (r none) := by
    intro w hw
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hw
    refine mem_filter.mpr ⟨(hgood f hf).1 _,?_⟩
    rw [← hroot f hf none]
    exact f.toHom.map_adj (show (template s).Adj (.inr none) (.inl none) from rfl)
  exact hc.trans (Nat.mul_le_mul_left _ (card_le_card hs))

end Erdos571.ShortSpider

namespace Erdos571.LongSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma shortFiber_degree_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s : ℕ) (w : W) (r : Fin s → W) :
    (shortFiber G U t s w r).card ≤ t^s*(neighbors G U w).card := by
  apply ShortSpider.rooted_degree_count G U t s _ (fun a => a.elim w r)
  · intro f hf; exact ((mem_shortFiber G U t s w r f).mp hf).1
  · intro f hf a
    have h := (mem_shortFiber G U t s w r f).mp hf
    cases a with
    | none => exact h.2.1
    | some j => exact h.2.2 j

end Erdos571.LongSpider

namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- A fixed left projection has at most a degree factor times `t^q` light
right completions. Unlike `left_completion`, no nonrichness assumption is used. -/
lemma left_completion_degree (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) {D : ℝ} (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template p q).Copy G)) (r : Arms p q → W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hshort : ∀f∈F, ShortSpider.GoodCopy G U t q (f.comp (rightShortCopy p q)))
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (g : (LongSpider.template p).Copy G)
    (hg : g∈F.image (fun f => f.comp (leftCopy p q))) :
    ((F.filter (fun f => f.comp (leftCopy p q)=g)).card:ℝ) ≤ (t:ℝ)^q*D := by
  classical
  let A := F.filter (fun f => f.comp (leftCopy p q)=g)
  obtain ⟨f₀,hf₀,he₀⟩ := mem_image.mp hg
  let z := g (.inl none)
  let r' : Fin q → W := fun j => r (.inr j)
  have hcent : ∀f∈A, f (.inl (.inl false))=z := by
    intro f hf
    exact congrArg (fun h : (LongSpider.template p).Copy G => h (.inl none)) (mem_filter.mp hf).2
  have hz : z∈U := by
    dsimp [z]
    rw [← he₀]
    exact hmem f₀ hf₀ _
  have hc : A.card ≤ (LongSpider.shortFiber G U t q z r').card := by
    apply card_le_card_of_injOn (fun f => f.comp (rightShortCopy p q))
    · intro f hf
      exact (LongSpider.mem_shortFiber G U t q z r' _).mpr
        ⟨hshort f (mem_filter.mp hf).1,hcent f hf,fun j => hroot f (mem_filter.mp hf).1 _⟩
    · intro f hf f' hf' he
      exact short_pair_ext G p q f f' ((mem_filter.mp hf).2.trans (mem_filter.mp hf').2.symm) he
  have hb := hc.trans (LongSpider.shortFiber_degree_bound G U t q z r')
  calc
    _ ≤ (t:ℝ)^q*(neighbors G U z).card := by exact_mod_cast hb
    _ ≤ _ := mul_le_mul_of_nonneg_left (hdeg z hz) (by positivity)

/-- The exact consequence of rich-projection packing for full copies has an
extra factor `D`. Dropping it would assert an unjustified stronger bound. -/
theorem rich_copies_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) q).Copy G)) (r : Arms (p+1) q ↪ W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hleft : ∀f∈F, LongSpider.GoodCopy G U t p M (f.comp (leftCopy (p+1) q)))
    (hshort : ∀f∈F, ShortSpider.GoodCopy G U t q (f.comp (rightShortCopy (p+1) q)))
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a)
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => r (.inr j))).card) :
    (F.card:ℝ) ≤ (M*(p+2)*LongSpider.loadBound t p M:ℕ)*((t:ℝ)^q*D) := by
  classical
  let proj : (template (p+1) q).Copy G → (LongSpider.template (p+1)).Copy G := fun f => f.comp (leftCopy (p+1) q)
  have hb : (F.image proj).card < M*(p+2)*LongSpider.loadBound t p M := by
    apply rich_projection_bound G U t p q M ht hf (F.image proj) r
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact hleft f hf
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact fun i => hroot f hf _
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      intro a j he
      have hh : f (leftCopy (p+1) q (.inl a))=r (.inr j) := he
      rw [← hroot f hf (.inr j)] at hh
      have hv := f.injective hh
      cases a <;> exact Sum.inl_ne_inr hv
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact hrich f hf
  have hc := RealFiberCount.bound F (F.image proj) proj
    (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩)
    (fun g hg => left_completion_degree G U t (p+1) q hdeg F r hmem hshort hroot g hg)
  exact hc.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hb.le) (by positivity))

end Erdos571.DoubleSpider


/-! Nested rich fibers: retain only left short-spider copies that already
support rich right-hand completions. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def nestedFiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (w : W) (r : Arms p q → W) : Finset ((ShortSpider.template p).Copy G) := by
  classical
  exact (LongSpider.shortFiber G U t p w (fun i => r (.inl i))).filter (fun f =>
    (∀j, w≠r (.inr j)) ∧ (∀a j, f (.inl a)≠r (.inr j)) ∧
    completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl none)) (fun j => r (.inr j))).card)

lemma mem_nestedFiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (w : W) (r : Arms p q → W) (f : (ShortSpider.template p).Copy G) :
    f∈nestedFiber G U t p q M w r ↔
      f∈LongSpider.shortFiber G U t p w (fun i => r (.inl i)) ∧
      (∀j, w≠r (.inr j)) ∧ (∀a j, f (.inl a)≠r (.inr j)) ∧
      completionThreshold t (p+1) q M <
        (LongSpider.shortFiber G U t q (f (.inl none)) (fun j => r (.inr j))).card := by
  classical
  exact mem_filter

lemma nestedFiber_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (w : W) (r : Arms p q → W) (v : W) :
    ((nestedFiber G U t p q M w r).filter (fun f => v∈RootedPacking.interior f)).card ≤ (p+1)*t^(p+1) := by
  classical
  exact (card_le_card (filter_subset_filter _ (filter_subset _ _))).trans
    (LongSpider.shortFiber_load G U t p ht w (fun i => r (.inl i)) v)

def nestedThreshold (t p q M : ℕ) : ℕ :=
  (p+q+M+1+(p+1)*M)*((p+1)*t^(p+1))

lemma contains_of_nested_neighbors (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (r : Arms p q ↪ W) (z : W) (hzr : ∀a, z≠r a)
    (w : Fin M ↪ W) (hw : ∀i, G.Adj z (w i))
    (hrich : ∀i, nestedThreshold t p q M < (nestedFiber G U t p q M (w i) r).card) :
    (graph (p+1) q M).IsContained G := by
  classical
  let Z : Finset W := insert z (univ.image r ∪ univ.image w)
  have hZ : Z.card ≤ p+q+M+1 := by
    have h₁ := card_insert_le z (univ.image r ∪ univ.image w)
    have h₂ := card_union_le (univ.image r) (univ.image w)
    have h₃ : (univ.image r).card ≤ p+q := by simpa only [Arms,card_univ,Fintype.card_sum,Fintype.card_fin] using card_image_le (s:=univ) (f:=r)
    have h₄ : (univ.image w).card ≤ M := by simpa using card_image_le (s:=univ) (f:=w)
    dsimp [Z]; omega
  obtain ⟨a,ha,haZ,hadis⟩ := DisjointChoice.exists_choice (p+1) ((p+1)*t^(p+1)) M
    RootedPacking.interior (fun i => nestedFiber G U t p q M (w i) r) Z
    (by intro i a ha; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card a).le)
    (fun i v => nestedFiber_load G U t p q M ht (w i) r v)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by omega)) (hrich i))
  have hnest (i) := (mem_nestedFiber G U t p q M (w i) r (a i)).mp (ha i)
  have hshort (i) := (LongSpider.mem_shortFiber G U t p (w i) (fun j => r (.inl j)) (a i)).mp (hnest i).1
  have havoid (i : Fin M) (v : W) (hv : v∈Z) (b : Option (Fin p)) : v≠a i (.inl b) := by
    intro he
    exact Finset.disjoint_left.mp (haZ i).symm hv (he ▸ RootedPacking.mem_interior (a i) b)
  have hz (i : Fin M) : ∀v, z≠a i v := by
    intro v
    cases v with
    | inl b => exact havoid i z (mem_insert_self _ _) b
    | inr b => cases b with
      | none => rw [(hshort i).2.1]; exact G.ne_of_adj (hw i)
      | some j => rw [(hshort i).2.2 j]; exact hzr (.inl j)
  let f : Fin M → (LongSpider.template (p+1)).Copy G := fun i =>
    LongSpider.extendCopy G p (a i) z (by rw [(hshort i).2.1]; exact hw i) (hz i)
  let r' : Arms (p+1) q ↪ W := ⟨Sum.elim (Fin.cases z (fun j => r (.inl j))) (fun j => r (.inr j)),by
    intro u v he
    cases u with
    | inl u =>
      cases v with
      | inl v =>
        induction u using Fin.cases with
        | zero => induction v using Fin.cases with
          | zero => rfl
          | succ v => exact (hzr (.inl v) he).elim
        | succ u => induction v using Fin.cases with
          | zero => exact (hzr (.inl u) he.symm).elim
          | succ v => exact congrArg (fun i => Sum.inl i.succ) (Sum.inl.inj (r.injective he))
      | inr v =>
        induction u using Fin.cases with
        | zero => exact (hzr (.inr v) he).elim
        | succ u => exact (Sum.inl_ne_inr (r.injective he)).elim
    | inr u =>
      cases v with
      | inl v =>
        induction v using Fin.cases with
        | zero => exact (hzr (.inr u) he.symm).elim
        | succ v => exact (Sum.inr_ne_inl (r.injective he)).elim
      | inr v => exact congrArg Sum.inr (Sum.inr.inj (r.injective he))⟩
  have hfroot : ∀i j, f i (.inr j)=r' (.inl j) := by
    intro i j
    induction j using Fin.cases with
    | zero => rfl
    | succ j => exact (hshort i).2.2 j
  have hfavoid : ∀i b j, f i (.inl b)≠r' (.inr j) := by
    intro i b j
    cases b with
    | none => exact (hnest i).2.2.1 none j
    | some k => induction k using Fin.cases with
      | zero => simpa only [f,LongSpider.extendCopy_mid_zero,(hshort i).2.1] using (hnest i).2.1 j
      | succ k => exact (hnest i).2.2.1 (some k) j
  have hinside (i : Fin M) : RootedPacking.interior (f i) ⊆ insert (w i) (RootedPacking.interior (a i)) := by
    intro v hv
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hv
    obtain ⟨b,rfl⟩ := hv
    cases b with
    | none => exact mem_insert_of_mem (by simp [f,RootedPacking.interior])
    | some j => induction j using Fin.cases with
      | zero => simpa only [f,LongSpider.extendCopy_mid_zero,(hshort i).2.1] using mem_insert_self (w i) (RootedPacking.interior (a i))
      | succ j => exact mem_insert_of_mem (by simp [f,RootedPacking.interior])
  have hwd (i j : Fin M) : w i∉RootedPacking.interior (a j) := by
    intro h
    apply Finset.disjoint_left.mp (haZ j).symm _ h
    exact mem_insert_of_mem (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))
  have hfdis : Pairwise (fun i j => Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j))) := by
    intro i j hij
    apply Disjoint.mono (hinside i) (hinside j)
    rw [disjoint_insert_left,disjoint_insert_right]
    exact ⟨by simp [w.injective.ne hij,hwd],hwd j i,hadis hij⟩
  exact contains_of_packed_rich G U t (p+1) q M ht f r' hfroot hfavoid hfdis
    (fun i => (hnest i).2.2.2)

/-- Only constantly many nested-rich short roots can lie in a neighborhood.
The roots outside that neighborhood are prescribed; its center becomes the new root. -/
theorem nested_neighbors_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    (r : Arms p q ↪ W) (z : W) (hzr : ∀a, z≠r a) :
    ((neighbors G U z).filter (fun w => nestedThreshold t p q M < (nestedFiber G U t p q M w r).card)).card < M := by
  classical
  by_contra! hc
  obtain ⟨S,hS,hSc⟩ := exists_subset_card_eq hc
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let w : Fin M ↪ W := ⟨fun i => e i,fun i j h => e.injective (Subtype.ext h)⟩
  apply hf (contains_of_nested_neighbors G U t p q M ht r z hzr w ?_ ?_)
  · intro i
    exact (mem_filter.mp (mem_filter.mp (hS (e i).property)).1).2
  · intro i
    exact (mem_filter.mp (hS (e i).property)).2

end Erdos571.DoubleSpider


/-! Removing one entire left arm from a double spider. -/
namespace Erdos571.DoubleSpider
open SimpleGraph

def leftArmMap (p q : ℕ) (j : Fin (p+1)) : Arms p q → Arms (p+1) q := Sum.map j.succAbove id

lemma leftArmMap_injective (p q : ℕ) (j : Fin (p+1)) : Function.Injective (leftArmMap p q j) :=
  Sum.map_injective.mpr ⟨j.succAbove_right_injective,Function.injective_id⟩

lemma side_leftArmMap (p q : ℕ) (j : Fin (p+1)) (r : Arms p q) : side (leftArmMap p q j r)=side r := by
  cases r <;> rfl

def omitLeftCopy (p q : ℕ) (j : Fin (p+1)) : (template p q).Copy (template (p+1) q) where
  toHom :=
    { toFun := Sum.map (Sum.map id (leftArmMap p q j)) (leftArmMap p q j)
      map_rel' := by
        intro u v h
        cases u with
        | inl a =>
          cases v with
          | inl b =>
            cases a with
            | inl c =>
              cases b with
              | inl d => exact h
              | inr r =>
                change c=side (leftArmMap p q j r)
                rw [side_leftArmMap]
                exact h
            | inr r =>
              cases b with
              | inl c =>
                change side (leftArmMap p q j r)=c
                rw [side_leftArmMap]
                exact h
              | inr r' => exact h.elim
          | inr r => exact congrArg (Sum.map id (leftArmMap p q j)) h
        | inr r => cases v with
          | inl a => exact congrArg (Sum.map id (leftArmMap p q j)) h
          | inr r' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Sum.map_injective.mpr ⟨Function.injective_id,leftArmMap_injective p q j⟩,leftArmMap_injective p q j⟩

lemma omitLeft_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (j : Fin (p+1))
    (f g : (template (p+1) q).Copy G)
    (he : f.comp (omitLeftCopy p q j)=g.comp (omitLeftCopy p q j))
    (hm : f (.inl (.inr (.inl j)))=g (.inl (.inr (.inl j))))
    (hr : f (.inr (.inl j))=g (.inr (.inl j))) : f=g := by
  apply Copy.ext
  intro v
  have hev (v) := congrArg (fun h : (template p q).Copy G => h v) he
  cases v with
  | inl a =>
    cases a with
    | inl c => exact hev (.inl (.inl c))
    | inr r =>
      cases r with
      | inl k =>
        by_cases hk : k=j
        · subst k; exact hm
        · obtain ⟨i,rfl⟩ := Fin.exists_succAbove_eq hk
          exact hev (.inl (.inr (.inl i)))
      | inr k => exact hev (.inl (.inr (.inr k)))
  | inr r =>
    cases r with
    | inl k =>
      by_cases hk : k=j
      · subst k; exact hr
      · obtain ⟨i,rfl⟩ := Fin.exists_succAbove_eq hk
        exact hev (.inr (.inl i))
    | inr k => exact hev (.inr (.inr k))

end Erdos571.DoubleSpider


/-! Nested-rich left-arm copies are a genuinely lower-order error. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- The nested-rich neighbor bound costs one degree factor less than the total
number of tree copies. No lightness assumption on the full family is needed. -/
theorem nested_arm_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (j : Fin (p+1)) (F : Finset ((template (p+1) q).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, nestedThreshold t p q M <
      (nestedFiber G U t p q M (f (.inl (.inr (.inl j)))) (fun r => f (.inr (leftArmMap p q j r)))).card) :
    (F.card:ℝ) ≤ (M:ℝ)*U.card*D^(2*(p+q)+2) := by
  classical
  let S := TreeCopiesIn.copies (template p q) G U
  let pre : (template (p+1) q).Copy G → (template p q).Copy G := fun f => f.comp (omitLeftCopy p q j)
  have hmap : Set.MapsTo pre F S := by
    intro f hf
    exact (TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hmem f hf _)
  have hfiber (g : (template p q).Copy G) (hg : g∈S) :
      ((F.filter (fun f => pre f=g)).card:ℝ) ≤ (M:ℝ)*D := by
    let F₁ := F.filter (fun f => pre f=g)
    let r : Arms p q ↪ W := ⟨fun a => g (.inr a),g.injective.comp Sum.inr_injective⟩
    let R := (neighbors G U (g (.inl (.inl false)))).filter (fun w => nestedThreshold t p q M < (nestedFiber G U t p q M w r).card)
    have hR : R.card ≤ M := (nested_neighbors_bound G U t p q M ht hf r (g (.inl (.inl false)))
      (fun a he => Sum.inl_ne_inr (g.injective he))).le
    let ev : (template (p+1) q).Copy G → W := fun f => f (.inl (.inr (.inl j)))
    have hRmap : Set.MapsTo ev F₁ R := by
      intro f hf₁
      have hfF := (mem_filter.mp hf₁).1
      have he : ∀v, f (omitLeftCopy p q j v)=g v := fun v => congrArg (fun h : (template p q).Copy G => h v) (mem_filter.mp hf₁).2
      apply mem_filter.mpr
      constructor
      · apply mem_filter.mpr
        refine ⟨hmem f hfF _,?_⟩
        rw [← he (.inl (.inl false))]
        exact f.toHom.map_adj (show (template (p+1) q).Adj (.inl (.inl false)) (.inl (.inr (.inl j))) from rfl)
      · have hh := hrich f hfF
        have her : (fun a => f (.inr (leftArmMap p q j a)))=r := by funext a; exact he (.inr a)
        rwa [her] at hh
    have hinner (w : W) (hw : w∈R) : ((F₁.filter (fun f => ev f=w)).card:ℝ) ≤ D := by
      let F₂ := F₁.filter (fun f => ev f=w)
      have hcard : F₂.card ≤ (neighbors G U w).card := by
        apply card_le_card_of_injOn (fun f => f (.inr (.inl j)))
        · intro f hf₂
          have hh := (mem_filter.mp hf₂).2
          refine mem_filter.mpr ⟨hmem f (mem_filter.mp (mem_filter.mp hf₂).1).1 _,?_⟩
          rw [← hh]
          exact f.toHom.map_adj (show (template (p+1) q).Adj (.inl (.inr (.inl j))) (.inr (.inl j)) from rfl)
        · intro f hf₂ f' hf₂' he
          apply omitLeft_ext G p q j f f'
          · exact (mem_filter.mp (mem_filter.mp hf₂).1).2.trans (mem_filter.mp (mem_filter.mp hf₂').1).2.symm
          · exact (mem_filter.mp hf₂).2.trans (mem_filter.mp hf₂').2.symm
          · exact he
      exact (show (F₂.card:ℝ) ≤ (neighbors G U w).card by exact_mod_cast hcard).trans
        (hdeg w (mem_filter.mp (mem_filter.mp hw).1).1)
    have hb := RealFiberCount.bound F₁ R ev hRmap hinner
    exact hb.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hR) hD)
  have hb := RealFiberCount.bound F S pre hmap hfiber
  have hs := ConnectedCopyBound.total (template p q) (connected p q) G U hD hdeg S
    (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have he : Fintype.card (Interior p q ⊕ Arms p q)-1=2*(p+q)+1 := by
    simp only [Interior,Arms,Fintype.card_sum,Fintype.card_bool,Fintype.card_fin]; omega
  rw [he] at hs
  calc
    _ ≤ (S.card:ℝ)*((M:ℝ)*D) := hb
    _ ≤ (U.card:ℝ)*D^(2*(p+q)+1)*((M:ℝ)*D) := mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [show 2*(p+q)+2=(2*(p+q)+1)+1 by omega,pow_succ]; ring

end Erdos571.DoubleSpider


/-! Bounded loads using the selective, nested exclusions rather than the
stronger unconditional LongSpider.GoodCopy predicate. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def NestedGoodLeft (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (rR : Fin q → W) (g : (LongSpider.template (p+1)).Copy G) : Prop :=
  (∀v, g v∈U) ∧ ConnectedCopyBound.Light (LongSpider.template (p+1)) G U t g ∧
  (∀a j, g (.inl a)≠rR j) ∧
  completionThreshold t (p+1) q M < (LongSpider.shortFiber G U t q (g (.inl none)) rR).card ∧
  ∀j, (nestedFiber G U t p q M (g (.inl (some j)))
    (Sum.elim (fun i => g (.inr (j.succAbove i))) rR)).card ≤ nestedThreshold t p q M

lemma nested_arm_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (rR : Fin q → W) (F : Finset ((LongSpider.template (p+1)).Copy G))
    (rL : Fin (p+1) → W) (j : Fin (p+1)) (w : W)
    (hgood : ∀g∈F, NestedGoodLeft G U t p q M rR g)
    (hroot : ∀g∈F, ∀i, g (.inr i)=rL i)
    (harm : ∀g∈F, g (.inl (some j))=w) : F.card ≤ nestedThreshold t p q M := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨g₀,hg₀⟩ := hn
  let r := Sum.elim (fun i => rL (j.succAbove i)) rR
  have hsize : (nestedFiber G U t p q M w r).card ≤ nestedThreshold t p q M := by
    have hh := (hgood g₀ hg₀).2.2.2.2 j
    simpa only [harm g₀ hg₀,hroot g₀ hg₀] using hh
  let proj : (LongSpider.template (p+1)).Copy G → (ShortSpider.template p).Copy G := fun g => g.comp (LongSpider.shortCopy p j)
  have hc : F.card ≤ (nestedFiber G U t p q M w r).card := by
    apply card_le_card_of_injOn proj
    · intro g hg
      apply (mem_nestedFiber G U t p q M w r _).mpr
      refine ⟨?_,?_,?_,?_⟩
      · apply (LongSpider.mem_shortFiber G U t p w (fun i => r (.inl i)) _).mpr
        exact ⟨LongSpider.short_good G U t p j g (hgood g hg).1 (hgood g hg).2.1,
          harm g hg,fun i => hroot g hg _⟩
      · intro k
        rw [← harm g hg]
        exact (hgood g hg).2.2.1 (some j) k
      · intro a k
        cases a with
        | none => exact (hgood g hg).2.2.1 none k
        | some i => exact (hgood g hg).2.2.1 (some (j.succAbove i)) k
      · exact (hgood g hg).2.2.2.1
    · intro g hg g' hg' he
      exact LongSpider.short_ext G p j g g' he ((hroot g hg j).trans (hroot g' hg' j).symm)
  exact hc.trans hsize

def nestedLoad (t p q M : ℕ) : ℕ := t^(p+1)+(p+1)*nestedThreshold t p q M

lemma nested_interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (rR : Fin q → W) (F : Finset ((LongSpider.template (p+1)).Copy G))
    (rL : Fin (p+1) → W)
    (hgood : ∀g∈F, NestedGoodLeft G U t p q M rR g)
    (hroot : ∀g∈F, ∀i, g (.inr i)=rL i) (w : W) :
    (F.filter (fun g => w∈RootedPacking.interior g)).card ≤ nestedLoad t p q M := by
  classical
  let A := F.filter (fun g => g (.inl none)=w)
  let B (j : Fin (p+1)) := F.filter (fun g => g (.inl (some j))=w)
  have hsub : F.filter (fun g => w∈RootedPacking.interior g) ⊆ A ∪ univ.biUnion B := by
    intro g hg
    have hw := (mem_filter.mp hg).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,he⟩ := hw
    cases a with
    | none => exact mem_union_left _ (mem_filter.mpr ⟨(mem_filter.mp hg).1,he⟩)
    | some j => exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨(mem_filter.mp hg).1,he⟩⟩)
  have hA : A.card ≤ t^(p+1) := LongSpider.center_count G U t (p+1) A rL w
    (fun g hg => (hgood g (mem_filter.mp hg).1).1)
    (fun g hg => (hgood g (mem_filter.mp hg).1).2.1)
    (fun g hg => hroot g (mem_filter.mp hg).1) (fun g hg => (mem_filter.mp hg).2)
  have hB (j : Fin (p+1)) : (B j).card ≤ nestedThreshold t p q M := nested_arm_load G U t p q M rR (B j) rL j w
    (fun g hg => hgood g (mem_filter.mp hg).1)
    (fun g hg => hroot g (mem_filter.mp hg).1) (fun g hg => (mem_filter.mp hg).2)
  calc
    _ ≤ (A ∪ univ.biUnion B).card := card_le_card hsub
    _ ≤ A.card+(univ.biUnion B).card := card_union_le _ _
    _ ≤ t^(p+1)+∑j : Fin (p+1), (B j).card := Nat.add_le_add hA card_biUnion_le
    _ ≤ t^(p+1)+∑_j : Fin (p+1), nestedThreshold t p q M := Nat.add_le_add_left (sum_le_sum (fun j _ => hB j)) _
    _ = _ := by simp [nestedLoad]

lemma nested_projection_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    (F : Finset ((LongSpider.template (p+1)).Copy G)) (r : Arms (p+1) q ↪ W)
    (hgood : ∀g∈F, NestedGoodLeft G U t p q M (fun j => r (.inr j)) g)
    (hroot : ∀g∈F, ∀i, g (.inr i)=r (.inl i)) :
    F.card < M*(p+2)*nestedLoad t p q M := by
  classical
  by_contra! hc
  obtain ⟨S,hSF,hSc,hS⟩ := RootedPacking.disjoint_footprints F RootedPacking.interior
    (p+2) (nestedLoad t p q M) M (by omega) (by unfold nestedLoad; positivity)
    (by intro g hg; rw [← card_pos,RootedPacking.interior_card]; simp)
    (by intro g hg; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card g).le)
    (nested_interior_load G U t p q M (fun j => r (.inr j)) F (fun i => r (.inl i)) hgood hroot) hc
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa only [Fintype.card_fin,Fintype.card_coe] using hSc.symm)
  let f : Fin M → (LongSpider.template (p+1)).Copy G := fun i => (e i).val
  have hmem (i : Fin M) : f i∈F := hSF (e i).property
  apply hf (contains_of_packed_rich G U t (p+1) q M ht f r
    (fun i => hroot (f i) (hmem i))
    (fun i => (hgood (f i) (hmem i)).2.2.1) ?_
    (fun i => (hgood (f i) (hmem i)).2.2.2.1))
  intro i j hij
  apply hS (f i) (e i).property (f j) (e j).property
  intro he
  exact hij (e.injective (Subtype.ext he))

/-- For rich-core copies, the stronger unconditional long-spider exclusions
can be replaced by nested exclusions, whose discarded copies were bounded above. -/
theorem rich_copies_after_nested (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) q).Copy G)) (r : Arms (p+1) q ↪ W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) q) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a)
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => r (.inr j))).card)
    (hcap : ∀f∈F, ∀j, (nestedFiber G U t p q M (f (.inl (.inr (.inl j))))
      (fun a => f (.inr (leftArmMap p q j a)))).card ≤ nestedThreshold t p q M) :
    (F.card:ℝ) ≤ (M*(p+2)*nestedLoad t p q M:ℕ)*((t:ℝ)^q*D) := by
  classical
  let proj : (template (p+1) q).Copy G → (LongSpider.template (p+1)).Copy G := fun f => f.comp (leftCopy (p+1) q)
  have hb : (F.image proj).card < M*(p+2)*nestedLoad t p q M := by
    apply nested_projection_bound G U t p q M ht hf (F.image proj) r
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      refine ⟨fun v => hmem f hf _,(hl f hf).comp _,?_,hrich f hf,?_⟩
      · intro a j he
        have hh : f (leftCopy (p+1) q (.inl a))=r (.inr j) := he
        rw [← hroot f hf (.inr j)] at hh
        have hv := f.injective hh
        cases a <;> exact Sum.inl_ne_inr hv
      · intro j
        have he : (fun a => f (.inr (leftArmMap p q j a)))=
            Sum.elim (fun i => proj f (.inr (j.succAbove i))) (fun j => r (.inr j)) := by
          funext a
          cases a with
          | inl i => rfl
          | inr k => exact hroot f hf _
        have h := hcap f hf j
        rwa [he] at h
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact fun i => hroot f hf _
  have hc := RealFiberCount.bound F (F.image proj) proj
    (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩)
    (fun g hg => left_completion_degree G U t (p+1) q hdeg F r hmem
      (fun f hf => ShortSpider.good_of_light G U t q _ (fun v => hmem f hf _) ((hl f hf).comp _)) hroot g hg)
  exact hc.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hb.le) (by positivity))

end Erdos571.DoubleSpider

/-! Two-neighbor propagation gives degree-free bounds for light graph copies. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LightExtension
open Finset SimpleGraph

/-- Every proper extension of the seed has an unknown vertex with two distinct
known neighbors. -/
def Spans {V : Type} [Fintype V] (H : SimpleGraph V) (C₀ : Finset V) : Prop :=
  ∀C : Finset V, C₀⊆C → C≠univ → ∃v∉C, ∃u∈C, ∃w∈C, u≠w ∧ H.Adj u v ∧ H.Adj v w

lemma bound {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (C₀ : Finset V) (hspan : Spans H C₀) (C : Finset V) (hC : C₀⊆C) (r : V → W)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light H G U t f)
    (hfix : ∀f∈F, ∀v∈C, f v=r v) : F.card ≤ t^(Fintype.card V-C.card) := by
  classical
  generalize hn : Fintype.card V-C.card=n
  induction n using Nat.strong_induction_on generalizing C r F with
  | h n ih =>
    by_cases hfull : C=univ
    · have hsub : (F : Set (H.Copy G)).Subsingleton := by
        intro f hf g hg
        apply Copy.ext
        intro v
        exact (hfix f hf v (hfull ▸ mem_univ v)).trans (hfix g hg v (hfull ▸ mem_univ v)).symm
      have hn0 : n=0 := by simp [hfull] at hn; omega
      simpa only [hn0,pow_zero] using card_le_one.mpr hsub
    obtain ⟨v,hv,u,hu,w,hw,huw,huv,hvw⟩ := hspan C hC hfull
    let ev : H.Copy G → W := fun f => f v
    have hi : (F.image ev).card ≤ t := by
      by_cases hne : F.Nonempty
      swap
      · rw [not_nonempty_iff_eq_empty.mp hne,image_empty,card_empty]; omega
      obtain ⟨f₀,hf₀⟩ := hne
      have hlight := hl f₀ hf₀ u v w huv hvw huw
      rw [hfix f₀ hf₀ u hu,hfix f₀ hf₀ w hw] at hlight
      apply le_trans _ hlight.le
      apply card_le_card
      intro z hz
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hz
      apply mem_filter.mpr
      refine ⟨hmem f hf v,?_,?_⟩
      · rw [← hfix f hf u hu]; exact f.toHom.map_adj huv
      · rw [← hfix f hf w hw]; exact f.toHom.map_adj hvw.symm
    have hc : (insert v C).card=C.card+1 := card_insert_of_notMem hv
    have hlt : Fintype.card V-(insert v C).card<n := by
      have hb := card_le_univ (insert v C)
      omega
    have hfiber (z : W) (hz : z∈F.image ev) :
        (F.filter (fun f => ev f=z)).card ≤ t^(Fintype.card V-(insert v C).card) := by
      apply ih _ hlt (insert v C) (hC.trans (subset_insert _ _)) (Function.update r v z) _ ?_ ?_ ?_ rfl
      · intro f hf; exact hmem f (mem_filter.mp hf).1
      · intro f hf; exact hl f (mem_filter.mp hf).1
      · intro f hf x hx
        rcases mem_insert.mp hx with rfl|hx
        · simpa only [Function.update_self] using (mem_filter.mp hf).2
        · rw [Function.update_of_ne (show x≠v from fun he => hv (he ▸ hx))]
          exact hfix f (mem_filter.mp hf).1 x hx
    have hb := card_le_mul_card_image F (t^(Fintype.card V-(insert v C).card)) hfiber
    have he : n=Fintype.card V-(insert v C).card+1 := by
      have hb := card_le_univ (insert v C)
      omega
    calc
      _ ≤ t^(Fintype.card V-(insert v C).card)*(F.image ev).card := hb
      _ ≤ t^(Fintype.card V-(insert v C).card)*t := Nat.mul_le_mul_left _ hi
      _ = t^n := by rw [he,pow_succ]

/-- A connected core with a root adjacent to every core vertex propagates
from all roots and any one core vertex. -/
lemma rooted_spans {A R : Type} [Fintype A] [Fintype R] [DecidableEq A] [DecidableEq R]
    (K : SimpleGraph A) (hK : K.Connected) (E : A → R → Prop) (hE : ∀a, ∃r, E a r) (a₀ : A) :
    Spans (RootedIncidence.graph K E) (insert (.inl a₀) (univ.image Sum.inr)) := by
  classical
  intro C hC hproper
  let X := univ.filter (fun a : A => Sum.inl a∈C)
  have hX : X.Nonempty := ⟨a₀,mem_filter.mpr ⟨mem_univ _,hC (mem_insert_self _ _)⟩⟩
  have hroot (r : R) : Sum.inr r∈C := hC (mem_insert_of_mem (mem_image.mpr ⟨r,mem_univ _,rfl⟩))
  have hXp : X≠univ := by
    intro he
    apply hproper
    apply eq_univ_of_forall
    intro v
    cases v with
    | inl a =>
      have haX : a ∈ X := by rw [he]; exact mem_univ a
      exact (mem_filter.mp haX).2
    | inr r => exact hroot r
  obtain ⟨u,hu,v,hv,huv⟩ := ConnectedCopyBound.boundary K hK X hX hXp
  have hvC : Sum.inl v∉C := by simpa [X] using hv
  obtain ⟨r,hr⟩ := hE v
  exact ⟨.inl v,hvC,.inl u,(mem_filter.mp hu).2,.inr r,hroot r,Sum.inl_ne_inr,huv,hr⟩

lemma rooted_vertex_count {A R W : Type} [Fintype A] [Fintype R]
    [DecidableEq A] [DecidableEq R] [DecidableEq W]
    (K : SimpleGraph A) (hK : K.Connected) (E : A → R → Prop) (hE : ∀a, ∃r, E a r)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (F : Finset ((RootedIncidence.graph K E).Copy G)) (r : R → W) (a₀ : A) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (RootedIncidence.graph K E) G U t f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (hpin : ∀f∈F, f (.inl a₀)=w) : F.card ≤ t^(Fintype.card A-1) := by
  classical
  let C := insert (Sum.inl a₀) (univ.image (@Sum.inr A R))
  have hcard : C.card=Fintype.card R+1 := by simp [C,card_image_of_injective _ Sum.inr_injective]
  have hb := bound (RootedIncidence.graph K E) G U t C (rooted_spans K hK E hE a₀) C (Subset.refl _)
    (Sum.elim (fun _ => w) r) F hmem hl (by
      intro f hf v hv
      rcases mem_insert.mp hv with rfl|hv
      · exact hpin f hf
      · obtain ⟨x,hx,rfl⟩ := mem_image.mp hv
        exact hroot f hf x)
  have he : Fintype.card A + Fintype.card R - (Fintype.card R+1) = Fintype.card A-1 := by omega
  simpa only [Fintype.card_sum,hcard,he] using hb

lemma rooted_interior_load {A R W : Type} [Fintype A] [Fintype R]
    [DecidableEq A] [DecidableEq R] [DecidableEq W]
    (K : SimpleGraph A) (hK : K.Connected) (E : A → R → Prop) (hE : ∀a, ∃r, E a r)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (F : Finset ((RootedIncidence.graph K E).Copy G)) (r : R → W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (RootedIncidence.graph K E) G U t f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤
      Fintype.card A*t^(Fintype.card A-1) := by
  classical
  let B (a : A) := F.filter (fun f => f (.inl a)=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f) ⊆ univ.biUnion B := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨(mem_filter.mp hf).1,ha⟩⟩
  calc
    _ ≤ (univ.biUnion B).card := card_le_card hsub
    _ ≤ ∑a : A, (B a).card := card_biUnion_le
    _ ≤ ∑_a : A, t^(Fintype.card A-1) := sum_le_sum (fun a _ => rooted_vertex_count K hK E hE G U t (B a) r a w
      (fun f hf => hmem f (mem_filter.mp hf).1)
      (fun f hf => hl f (mem_filter.mp hf).1)
      (fun f hf => hroot f (mem_filter.mp hf).1)
      (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by simp

end Erdos571.LightExtension

/-! The double-spider core with one private root adjacent to every nonroot. -/
namespace Erdos571.TwoShortSpider
open Finset SimpleGraph DoubleSpider

/-- Bool roots are the two short tips; arm roots are the old long tips. -/
def template (p q : ℕ) : SimpleGraph (Interior p q ⊕ Interior p q) :=
  RootedIncidence.graph (core p q) (fun a r => a=r)

instance (p q : ℕ) : DecidableRel (template p q).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [template,RootedIncidence.graph]
  · rename_i a b
    cases a <;> cases b <;> dsimp [core] <;> infer_instance
  all_goals infer_instance

lemma core_connected (p q : ℕ) : (core p q).Connected := by
  have hc (c : Bool) : (core p q).Reachable (.inl c) (.inl false) := by
    cases c
    · exact Reachable.rfl
    · exact (show (core p q).Adj (.inl true) (.inl false) from Bool.noConfusion).reachable
  have hr (a : Interior p q) : (core p q).Reachable a (.inl false) := by
    cases a with
    | inl c => exact hc c
    | inr r => exact (show (core p q).Adj (.inr r) (.inl (side r)) from rfl).reachable.trans (hc _)
  exact {preconnected := fun a b => (hr a).trans (hr b).symm,nonempty := inferInstance}

def leftVertex (p q : ℕ) : Option (Fin p) ⊕ Option (Fin p) → Interior p q ⊕ Interior p q
  | .inl none => .inl (.inl false)
  | .inl (some i) => .inl (.inr (.inl i))
  | .inr none => .inr (.inl false)
  | .inr (some i) => .inr (.inr (.inl i))

lemma leftVertex_injective (p q : ℕ) : Function.Injective (leftVertex p q) := by
  intro u v he
  cases u with
  | inl a => cases v with
    | inl b => cases a <;> cases b <;> simpa [leftVertex] using he
    | inr b => cases a <;> cases b <;> simp [leftVertex] at he
  | inr a => cases v with
    | inl b => cases a <;> cases b <;> simp [leftVertex] at he
    | inr b => cases a <;> cases b <;> simpa [leftVertex] using he

def leftCopy (p q : ℕ) : (ShortSpider.template p).Copy (template p q) where
  toHom :=
    { toFun := leftVertex p q
      map_rel' := by
        intro u v h
        cases u with
        | inl a => cases v with
          | inl b => cases a <;> cases b <;> simp_all [leftVertex,template,RootedIncidence.graph,core,side,ShortSpider.template]
          | inr b => change a=b at h; subst b; cases a <;> rfl
        | inr a => cases v with
          | inl b => change a=b at h; subst b; cases a <;> rfl
          | inr b => exact h.elim }
  injective' := leftVertex_injective p q

def rightVertex (p q : ℕ) : Option (Fin q) ⊕ Option (Fin q) → Interior p q ⊕ Interior p q
  | .inl none => .inl (.inl true)
  | .inl (some j) => .inl (.inr (.inr j))
  | .inr none => .inr (.inl true)
  | .inr (some j) => .inr (.inr (.inr j))

lemma rightVertex_injective (p q : ℕ) : Function.Injective (rightVertex p q) := by
  intro u v he
  cases u with
  | inl a => cases v with
    | inl b => cases a <;> cases b <;> simpa [rightVertex] using he
    | inr b => cases a <;> cases b <;> simp [rightVertex] at he
  | inr a => cases v with
    | inl b => cases a <;> cases b <;> simp [rightVertex] at he
    | inr b => cases a <;> cases b <;> simpa [rightVertex] using he

def rightCopy (p q : ℕ) : (ShortSpider.template q).Copy (template p q) where
  toHom :=
    { toFun := rightVertex p q
      map_rel' := by
        intro u v h
        cases u with
        | inl a => cases v with
          | inl b => cases a <;> cases b <;> simp_all [rightVertex,template,RootedIncidence.graph,core,side,ShortSpider.template]
          | inr b => change a=b at h; subst b; cases a <;> rfl
        | inr a => cases v with
          | inl b => change a=b at h; subst b; cases a <;> rfl
          | inr b => exact h.elim }
  injective' := rightVertex_injective p q

end Erdos571.TwoShortSpider

namespace Erdos571.TwoShortSpider
open Finset SimpleGraph DoubleSpider
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def fiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) (w : Bool → W) (r : Arms p q → W) : Finset ((template p q).Copy G) := by
  classical
  exact univ.filter (fun f => (∀v, f v∈U) ∧ ConnectedCopyBound.Light (template p q) G U t f ∧
    ∀a, f (.inr a)=Sum.elim w r a)

lemma mem_fiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) (w : Bool → W) (r : Arms p q → W) (f : (template p q).Copy G) :
    f∈fiber G U t p q w r ↔ (∀v, f v∈U) ∧ ConnectedCopyBound.Light (template p q) G U t f ∧
    ∀a, f (.inr a)=Sum.elim w r a := by
  classical
  simp only [fiber,mem_filter,mem_univ,true_and]

lemma fiber_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) (w : Bool → W) (r : Arms p q → W) (v : W) :
    ((fiber G U t p q w r).filter (fun f => v∈RootedPacking.interior f)).card ≤
      (p+q+2)*t^(p+q+1) := by
  classical
  have hb := LightExtension.rooted_interior_load (core p q) (core_connected p q)
    (fun a r => a=r) (fun a => ⟨a,rfl⟩) G U t (fiber G U t p q w r) (Sum.elim w r)
    (fun f hf => ((mem_fiber G U t p q w r f).mp hf).1)
    (fun f hf => ((mem_fiber G U t p q w r f).mp hf).2.1)
    (fun f hf => ((mem_fiber G U t p q w r f).mp hf).2.2) v
  have hc : Fintype.card (Interior p q)=p+q+2 := by simp [Interior,Arms]; omega
  simpa only [hc,Nat.add_sub_cancel] using hb

end Erdos571.TwoShortSpider

/-! Joining long spiders at an edge, and range control for short-root extension. -/
set_option maxHeartbeats 1500000
namespace Erdos571.ShortSpider
open SimpleGraph

def addShortCopy {W : Type*} (G : SimpleGraph W) (s : ℕ)
    (f : (LongSpider.template s).Copy G) (z : W) (hz : G.Adj (f (.inl none)) z)
    (hf : ∀v, z≠f v) : (template s).Copy G := by
  let val : Option (Fin s) ⊕ Option (Fin s) → W :=
    Sum.elim (fun a => f (.inl a)) (fun a => a.elim z (fun i => f (.inr i)))
  have hi : Function.Injective val := by
    intro u v he
    cases u with
    | inl a => cases v with
      | inl b => exact congrArg Sum.inl (Sum.inl.inj (f.injective he))
      | inr b => cases b with
        | none => exact (hf _ he.symm).elim
        | some j => exact (Sum.inl_ne_inr (f.injective he)).elim
    | inr a => cases v with
      | inl b => cases a with
        | none => exact (hf _ he).elim
        | some i => exact (Sum.inr_ne_inl (f.injective he)).elim
      | inr b => cases a with
        | none => cases b with
          | none => rfl
          | some j => exact (hf _ he).elim
        | some i => cases b with
          | none => exact (hf _ he.symm).elim
          | some j => exact congrArg (fun k => Sum.inr (some k)) (Sum.inr.inj (f.injective he))
  refine {toHom := {toFun := val,map_rel' := ?_},injective' := hi}
  intro u v h
  cases u with
  | inl a => cases v with
    | inl b => exact f.toHom.map_adj h
    | inr b =>
      change a=b at h
      subst b
      cases a with
      | none => exact hz
      | some i => exact f.toHom.map_adj (show (LongSpider.template s).Adj (.inl (some i)) (.inr i) from rfl)
  | inr a => cases v with
    | inl b =>
      change a=b at h
      subst b
      cases a with
      | none => exact hz.symm
      | some i => exact f.toHom.map_adj (show (LongSpider.template s).Adj (.inr i) (.inl (some i)) from rfl)
    | inr b => exact h.elim

@[simp] lemma addShortCopy_old {W : Type*} (G : SimpleGraph W) (s : ℕ)
    (f : (LongSpider.template s).Copy G) (z : W) (hz) (hf) (v) :
    addShortCopy G s f z hz hf (Sum.map id some v)=f v := by
  cases v <;> rfl

end Erdos571.ShortSpider

namespace Erdos571.DoubleSpider
open SimpleGraph Finset

def joinCopy {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G)
    (he : G.Adj (f (.inl none)) (g (.inl none)))
    (hcross : ∀u v, f u≠g v) : (template p q).Copy G :=
  glueCopy G p q f (ShortSpider.addShortCopy G q g (f (.inl none)) he.symm (hcross (.inl none)))
    rfl (by intro u v; simpa only [ShortSpider.addShortCopy_old] using hcross u v)

@[simp] lemma joinCopy_left_center {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) :
    joinCopy G p q f g he hx (.inl (.inl false))=f (.inl none) := rfl
@[simp] lemma joinCopy_right_center {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) :
    joinCopy G p q f g he hx (.inl (.inl true))=g (.inl none) := rfl
@[simp] lemma joinCopy_left_middle {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) (i : Fin p) :
    joinCopy G p q f g he hx (.inl (.inr (.inl i)))=f (.inl (some i)) := rfl
@[simp] lemma joinCopy_right_middle {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) (j : Fin q) :
    joinCopy G p q f g he hx (.inl (.inr (.inr j)))=g (.inl (some j)) := rfl
@[simp] lemma joinCopy_left_root {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) (i : Fin p) :
    joinCopy G p q f g he hx (.inr (.inl i))=f (.inr i) := rfl
@[simp] lemma joinCopy_right_root {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) (j : Fin q) :
    joinCopy G p q f g he hx (.inr (.inr j))=g (.inr j) := rfl

lemma joinCopy_interior {W : Type*} [DecidableEq W] (G : SimpleGraph W) (p q : ℕ)
    (f : (LongSpider.template p).Copy G) (g : (LongSpider.template q).Copy G) (he) (hx) :
    RootedPacking.interior (joinCopy G p q f g he hx)=RootedPacking.interior f ∪ RootedPacking.interior g := by
  rw [joinCopy,glueCopy_interior]
  rfl

end Erdos571.DoubleSpider

namespace Erdos571.LongSpider
open SimpleGraph Finset

lemma extendCopy_range {W : Type*} (G : SimpleGraph W) (s : ℕ) (f : (ShortSpider.template s).Copy G)
    (z : W) (hz) (hf) (v) : extendCopy G s f z hz hf v=z ∨ ∃u, extendCopy G s f z hz hf v=f u := by
  cases v with
  | inl a => cases a with
    | none => exact Or.inr ⟨.inl none,rfl⟩
    | some i => induction i using Fin.cases with
      | zero => exact Or.inr ⟨.inr none,rfl⟩
      | succ i => exact Or.inr ⟨.inl (some i),rfl⟩
  | inr i => induction i using Fin.cases with
    | zero => exact Or.inl rfl
    | succ i => exact Or.inr ⟨.inr (some i),rfl⟩

lemma extendCopy_interior {W : Type*} [DecidableEq W] (G : SimpleGraph W) (s : ℕ)
    (f : (ShortSpider.template s).Copy G) (z : W) (hz) (hf) :
    RootedPacking.interior (extendCopy G s f z hz hf)=insert (f (.inr none)) (RootedPacking.interior f) := by
  classical
  ext w
  simp only [RootedPacking.interior,mem_image,mem_univ,true_and,mem_insert]
  constructor
  · rintro ⟨a,rfl⟩
    cases a with
    | none => exact Or.inr ⟨none,rfl⟩
    | some i => induction i using Fin.cases with
      | zero => exact Or.inl rfl
      | succ i => exact Or.inr ⟨some i,rfl⟩
  · rintro (rfl|⟨a,rfl⟩)
    · exact ⟨some 0,rfl⟩
    · cases a with
      | none => exact ⟨none,rfl⟩
      | some i => exact ⟨some i.succ,rfl⟩

end Erdos571.LongSpider

/-! Extend both short roots, obtaining an ordinary double spider. -/
set_option maxHeartbeats 2000000
namespace Erdos571.TwoShortSpider
open Finset SimpleGraph DoubleSpider

lemma left_right_disjoint (p q : ℕ) (u) (v) : leftVertex p q u≠rightVertex p q v := by
  cases u with
  | inl a => cases v with
    | inl b => cases a <;> cases b <;> simp [leftVertex,rightVertex]
    | inr b => cases a <;> cases b <;> simp [leftVertex,rightVertex]
  | inr a => cases v with
    | inl b => cases a <;> cases b <;> simp [leftVertex,rightVertex]
    | inr b => cases a <;> cases b <;> simp [leftVertex,rightVertex]

def extendCopy {W : Type*} (G : SimpleGraph W) (p q : ℕ) (f : (template p q).Copy G)
    (z : Bool → W) (hz : Function.Injective z)
    (hadj : ∀c, G.Adj (z c) (f (.inr (.inl c))))
    (hf : ∀c v, z c≠f v) : (DoubleSpider.template (p+1) (q+1)).Copy G := by
  let fL := f.comp (leftCopy p q)
  let fR := f.comp (rightCopy p q)
  let gL := LongSpider.extendCopy G p fL (z false) (hadj false) (fun v => hf false _)
  let gR := LongSpider.extendCopy G q fR (z true) (hadj true) (fun v => hf true _)
  have hcross : ∀u v, gL u≠gR v := by
    intro u v he
    rcases LongSpider.extendCopy_range G p fL (z false) (hadj false) (fun v => hf false _) u with hL|⟨a,hL⟩ <;>
      rcases LongSpider.extendCopy_range G q fR (z true) (hadj true) (fun v => hf true _) v with hR|⟨b,hR⟩
    · exact Bool.false_ne_true (hz (hL.symm.trans (he.trans hR)))
    · exact hf false _ (hL.symm.trans (he.trans hR))
    · exact hf true _ (hR.symm.trans (he.symm.trans hL))
    · exact left_right_disjoint p q a b (f.injective (hL.symm.trans (he.trans hR)))
  exact joinCopy G (p+1) (q+1) gL gR
    (f.toHom.map_adj (show (template p q).Adj (.inl (.inl false)) (.inl (.inl true)) from Bool.false_ne_true)) hcross

@[simp] lemma extendCopy_left_root_zero {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : Bool → W) (hz) (ha) (hf) :
    extendCopy G p q f z hz ha hf (.inr (.inl 0))=z false := rfl
@[simp] lemma extendCopy_right_root_zero {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : Bool → W) (hz) (ha) (hf) :
    extendCopy G p q f z hz ha hf (.inr (.inr 0))=z true := rfl
@[simp] lemma extendCopy_left_root_succ {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : Bool → W) (hz) (ha) (hf) (i : Fin p) :
    extendCopy G p q f z hz ha hf (.inr (.inl i.succ))=f (.inr (.inr (.inl i))) := rfl
@[simp] lemma extendCopy_right_root_succ {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : Bool → W) (hz) (ha) (hf) (j : Fin q) :
    extendCopy G p q f z hz ha hf (.inr (.inr j.succ))=f (.inr (.inr (.inr j))) := rfl

lemma extendCopy_interior {W : Type*} [DecidableEq W] (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : Bool → W) (hz) (ha) (hf) :
    RootedPacking.interior (extendCopy G p q f z hz ha hf)=
      {f (.inr (.inl false)),f (.inr (.inl true))} ∪ RootedPacking.interior f := by
  classical
  unfold extendCopy
  dsimp only
  rw [joinCopy_interior,LongSpider.extendCopy_interior,LongSpider.extendCopy_interior]
  have he : RootedPacking.interior (f.comp (leftCopy p q)) ∪
      RootedPacking.interior (f.comp (rightCopy p q))=RootedPacking.interior f := by
    ext w
    simp only [RootedPacking.interior,mem_union,mem_image,mem_univ,true_and]
    constructor
    · rintro (⟨a,rfl⟩|⟨b,rfl⟩)
      · cases a with
        | none => exact ⟨.inl false,rfl⟩
        | some i => exact ⟨.inr (.inl i),rfl⟩
      · cases b with
        | none => exact ⟨.inl true,rfl⟩
        | some j => exact ⟨.inr (.inr j),rfl⟩
    · rintro ⟨a,rfl⟩
      cases a with
      | inl c =>
        cases c
        · exact Or.inl ⟨none,rfl⟩
        · exact Or.inr ⟨none,rfl⟩
      | inr r => cases r with
        | inl i => exact Or.inl ⟨some i,rfl⟩
        | inr j => exact Or.inr ⟨some j,rfl⟩
  change insert (f (.inr (.inl false))) _ ∪ insert (f (.inr (.inl true))) _=_
  rw [← he]
  ext w
  simp only [mem_union,mem_insert,mem_singleton]
  tauto

def armCode (p q : ℕ) : Arms (p+1) (q+1) → Interior p q :=
  Sum.elim (Fin.cases (.inl false) (fun i => .inr (.inl i)))
    (Fin.cases (.inl true) (fun j => .inr (.inr j)))

lemma armCode_injective (p q : ℕ) : Function.Injective (armCode p q) := by
  let back : Interior p q → Arms (p+1) (q+1) :=
    Sum.elim (fun c => if c then .inr 0 else .inl 0) (Sum.map Fin.succ Fin.succ)
  have h : Function.LeftInverse back (armCode p q) := by
    intro v
    cases v with
    | inl i => induction i using Fin.cases <;> rfl
    | inr j => induction j using Fin.cases <;> rfl
  exact h.injective

def extendedRoots {W : Type*} (p q : ℕ) (z : Bool ↪ W) (r : Arms p q ↪ W)
    (hzr : ∀c a, z c≠r a) : Arms (p+1) (q+1) ↪ W :=
  ⟨Sum.elim z r ∘ armCode p q,by
    apply Function.Injective.comp _ (armCode_injective p q)
    intro u v he
    cases u with
    | inl c => cases v with
      | inl d => exact congrArg Sum.inl (z.injective he)
      | inr a => exact (hzr c a he).elim
    | inr a => cases v with
      | inl c => exact (hzr c a he.symm).elim
      | inr b => exact congrArg Sum.inr (r.injective he)⟩

end Erdos571.TwoShortSpider

/-! Rich fibers at disjoint endpoint pairs force double-spider powers. -/
set_option maxHeartbeats 2000000
namespace Erdos571.TwoShortSpider
open Finset SimpleGraph DoubleSpider
variable {W : Type} [Fintype W] [DecidableEq W]

def richThreshold (t p q M : ℕ) : ℕ :=
  (p+q+2+(p+q+4)*M)*((p+q+2)*t^(p+q+1))

lemma contains_of_rich_matching (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (r : Arms p q ↪ W) (z : Bool ↪ W) (hzr : ∀c a, z c≠r a)
    (w : Fin M × Bool ↪ W) (hwz : ∀i c d, w (i,c)≠z d)
    (ha : ∀i c, G.Adj (z c) (w (i,c)))
    (hrich : ∀i, richThreshold t p q M < (fiber G U t p q (fun c => w (i,c)) r).card) :
    (DoubleSpider.graph (p+1) (q+1) M).IsContained G := by
  classical
  let Z : Finset W := (univ.image r ∪ univ.image z) ∪ univ.image w
  have hZ : Z.card ≤ p+q+2+2*M := by
    have h₁ := card_union_le (univ.image r ∪ univ.image z) (univ.image w)
    have h₂ := card_union_le (univ.image r) (univ.image z)
    have h₃ : (univ.image r).card ≤ p+q := by
      simpa only [Arms,card_univ,Fintype.card_sum,Fintype.card_fin] using card_image_le (s:=univ) (f:=r)
    have h₄ : (univ.image z).card ≤ 2 := by simpa using card_image_le (s:=univ) (f:=z)
    have h₅ : (univ.image w).card ≤ 2*M := by
      simpa [Nat.mul_comm] using card_image_le (s:=univ) (f:=w)
    dsimp only [Z]; omega
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice (p+q+2) ((p+q+2)*t^(p+q+1)) M
    RootedPacking.interior (fun i => fiber G U t p q (fun c => w (i,c)) r) Z
    (by intro i f hf; simpa [Interior,Arms,Nat.add_comm,Nat.add_left_comm,Nat.add_assoc] using (RootedPacking.interior_card f).le)
    (fun i v => fiber_load G U t p q (fun c => w (i,c)) r v)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by
      change Z.card+(p+q+2)*M ≤ p+q+2+(p+q+4)*M
      nlinarith)) (hrich i))
  have hroot (i) := ((mem_fiber G U t p q (fun c => w (i,c)) r (f i)).mp (hf i)).2.2
  have hzZ (c) : z c∈Z := mem_union_left _ (mem_union_right _ (mem_image.mpr ⟨c,mem_univ _,rfl⟩))
  have hwZ (i) (c) : w (i,c)∈Z := mem_union_right _ (mem_image.mpr ⟨(i,c),mem_univ _,rfl⟩)
  have hfresh (i) : ∀c v, z c≠f i v := by
    intro c v he
    cases v with
    | inl a => exact Finset.disjoint_left.mp (hfZ i).symm (hzZ c) (he ▸ RootedPacking.mem_interior (f i) a)
    | inr a =>
      rw [hroot i a] at he
      cases a with
      | inl d => exact hwz i d c he.symm
      | inr a => exact hzr c a he
  let g : Fin M → (DoubleSpider.template (p+1) (q+1)).Copy G := fun i =>
    extendCopy G p q (f i) z z.injective (by intro c; rw [hroot i (.inl c)]; exact ha i c) (hfresh i)
  have hgroot : ∀i a, g i (.inr a)=extendedRoots p q z r hzr a := by
    intro i a
    cases a with
    | inl a => induction a using Fin.cases with
      | zero => rfl
      | succ a => exact hroot i (.inr (.inl a))
    | inr a => induction a using Fin.cases with
      | zero => rfl
      | succ a => exact hroot i (.inr (.inr a))
  have hgint (i) : RootedPacking.interior (g i)={w (i,false),w (i,true)} ∪ RootedPacking.interior (f i) := by
    simp only [g,extendCopy_interior,hroot,Sum.elim_inl]
  have hwi (i j) : Disjoint ({w (i,false),w (i,true)} : Finset W) (RootedPacking.interior (f j)) := by
    apply Disjoint.mono_left _ (hfZ j).symm
    intro v hv
    rcases mem_insert.mp hv with rfl|hv
    · exact hwZ i false
    · rw [mem_singleton] at hv; subst v; exact hwZ i true
  have hww (i j : Fin M) (hij : i≠j) : Disjoint ({w (i,false),w (i,true)} : Finset W) {w (j,false),w (j,true)} := by
    have hn (c d : Bool) : w (i,c)≠w (j,d) := fun he => hij (congrArg Prod.fst (w.injective he))
    simp [hij,Ne.symm hij]
  have hgdis : ∀i j, i≠j → Disjoint (RootedPacking.interior (g i)) (RootedPacking.interior (g j)) := by
    intro i j hij
    simp only [hgint,disjoint_union_left,disjoint_union_right]
    exact ⟨⟨hww i j hij,(hwi j i).symm⟩,⟨hwi i j,hfdis hij⟩⟩
  have he : RootedPacking.power (DoubleSpider.template (p+1) (q+1)) M=DoubleSpider.graph (p+1) (q+1) M := by
    ext u v; cases u <;> cases v <;> rfl
  rw [← he]
  exact ⟨RootedPacking.powerCopy M (extendedRoots p q z r hzr) g hgroot hgdis⟩

end Erdos571.TwoShortSpider

/-! A bounded-degree family of ordered pairs contains a large vertex-disjoint matching. -/
namespace Erdos571.PairMatching
open Finset

lemma exists_matching {W : Type*} [DecidableEq W] (F : Finset (W × W))
    (A B : Finset W) (D M : ℕ) (hD : 0 < D) (hA : A.card ≤ D) (hB : B.card ≤ D)
    (hmem : ∀v∈F, v.1∈A ∧ v.2∈B) (hne : ∀v∈F, v.1≠v.2)
    (hcard : M*2*(2*D) ≤ F.card) :
    ∃w : Fin M × Bool ↪ W, ∀i, (w (i,false),w (i,true))∈F := by
  classical
  let foot (v : W × W) : Finset W := {v.1,v.2}
  have hload (x : W) : (F.filter (fun v => x∈foot v)).card ≤ 2*D := by
    have h₁ : (F.filter (fun v => v.1=x)).card ≤ B.card := by
      apply card_le_card_of_injOn Prod.snd
      · intro v hv; exact (hmem v (mem_filter.mp hv).1).2
      · intro u hu v hv he
        exact Prod.ext ((mem_filter.mp hu).2.trans (mem_filter.mp hv).2.symm) he
    have h₂ : (F.filter (fun v => v.2=x)).card ≤ A.card := by
      apply card_le_card_of_injOn Prod.fst
      · intro v hv; exact (hmem v (mem_filter.mp hv).1).1
      · intro u hu v hv he
        exact Prod.ext he ((mem_filter.mp hu).2.trans (mem_filter.mp hv).2.symm)
    have he : F.filter (fun v => x∈foot v)=F.filter (fun v => v.1=x) ∪ F.filter (fun v => v.2=x) := by
      simp only [foot,mem_insert,mem_singleton,eq_comm,filter_or]
    rw [he]
    have hb := card_union_le (F.filter (fun v => v.1=x)) (F.filter (fun v => v.2=x))
    omega
  obtain ⟨S,hSF,hSc,hS⟩ := RootedPacking.disjoint_footprints F foot 2 (2*D) M
    (by omega) (by omega) (by intro v hv; exact ⟨v.1,mem_insert_self _ _⟩)
    (by intro v hv; exact (card_insert_le _ _).trans (by simp)) hload hcard
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let val (i : Fin M) (c : Bool) : W := if c then (e i).val.2 else (e i).val.1
  have hval (i) (c) : val i c∈foot (e i).val := by cases c <;> simp [val,foot]
  have hi : Function.Injective (fun u : Fin M × Bool => val u.1 u.2) := by
    rintro ⟨i,c⟩ ⟨j,d⟩ he
    by_cases hij : i=j
    · subst j
      have hn := hne (e i).val (hSF (e i).property)
      have hc : c=d := by cases c <;> cases d <;> simp_all [val]
      exact Prod.ext rfl hc
    · have hd := hS (e i).val (e i).property (e j).val (e j).property
        (fun he => hij (e.injective (Subtype.ext he)))
      exact (Finset.disjoint_left.mp hd (hval i c) (by change val i c∈foot (e j).val; change val i c=val j d at he; rw [he]; exact hval j d)).elim
  refine ⟨⟨fun u => val u.1 u.2,hi⟩,?_⟩
  intro i
  change ((e i).val.1,(e i).val.2)∈F
  exact hSF (e i).property

end Erdos571.PairMatching

/-! Rich two-short-root endpoint pairs are sparse in a product of neighborhoods. -/
set_option maxHeartbeats 1500000
namespace Erdos571.TwoShortSpider
open Finset SimpleGraph DoubleSpider DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_pairs_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (hf : (DoubleSpider.graph (p+1) (q+1) M).Free G)
    (r : Arms p q ↪ W) (z : Bool ↪ W) (hzr : ∀c a, z c≠r a)
    (D : ℕ) (hD : 0 < D) (hdeg : ∀c, (neighbors G U (z c)).card ≤ D)
    (F : Finset (W × W))
    (hmem : ∀v∈F, v.1∈neighbors G U (z false) ∧ v.2∈neighbors G U (z true))
    (hz : ∀v∈F, ∀c, v.1≠z c ∧ v.2≠z c)
    (hrich : ∀v∈F, richThreshold t p q M <
      (fiber G U t p q (fun c => if c then v.2 else v.1) r).card) : F.card < M*2*(2*D) := by
  classical
  by_contra! hc
  have hne (v) (hv : v∈F) : v.1≠v.2 := by
    have hn := hrich v hv
    obtain ⟨f,hf⟩ := card_pos.mp (show 0 < (fiber G U t p q (fun c => if c then v.2 else v.1) r).card by omega)
    have hr := ((mem_fiber G U t p q (fun c => if c then v.2 else v.1) r f).mp hf).2.2
    intro he
    have he' : f (.inr (.inl false))=f (.inr (.inl true)) := by simpa only [hr,Sum.elim_inl,Bool.false_eq_true,if_false,if_true] using he
    exact Bool.false_ne_true (Sum.inl.inj (Sum.inr.inj (f.injective he')))
  obtain ⟨w,hw⟩ := PairMatching.exists_matching F (neighbors G U (z false)) (neighbors G U (z true)) D M hD
    (hdeg false) (hdeg true) hmem hne hc
  apply hf (contains_of_rich_matching G U t p q M r z hzr w ?_ ?_ ?_)
  · intro i c d
    cases c
    · exact (hz _ (hw i) d).1
    · exact (hz _ (hw i) d).2
  · intro i c
    cases c
    · exact (mem_filter.mp (hmem _ (hw i)).1).2
    · exact (mem_filter.mp (hmem _ (hw i)).2).2
  · intro i
    have he : (fun c : Bool => if c then w (i,true) else w (i,false))=(fun c => w (i,c)) := by funext c; cases c <;> rfl
    simpa only [he] using hrich _ (hw i)

lemma rich_pairs_bound_real (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (hf : (DoubleSpider.graph (p+1) (q+1) M).Free G)
    (r : Arms p q ↪ W) (z : Bool ↪ W) (hzr : ∀c a, z c≠r a)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀c, ((neighbors G U (z c)).card:ℝ) ≤ D)
    (F : Finset (W × W))
    (hmem : ∀v∈F, v.1∈neighbors G U (z false) ∧ v.2∈neighbors G U (z true))
    (hz : ∀v∈F, ∀c, v.1≠z c ∧ v.2≠z c)
    (hrich : ∀v∈F, richThreshold t p q M <
      (fiber G U t p q (fun c => if c then v.2 else v.1) r).card) :
    (F.card:ℝ) ≤ 4*M*D := by
  have hb := (rich_pairs_bound G U t p q M hf r z hzr ⌊D⌋₊ (Nat.floor_pos.mpr hD)
    (fun c => Nat.le_floor (hdeg c)) F hmem hz hrich).le
  have hb' : (F.card:ℝ) ≤ M*2*(2*(⌊D⌋₊:ℝ)) := by exact_mod_cast hb
  have hd := Nat.floor_le (show 0 ≤ D by linarith)
  nlinarith [mul_le_mul_of_nonneg_left hd (show 0 ≤ (M:ℝ) by positivity)]

end Erdos571.TwoShortSpider

/-! Delete one complete arm on each side of a double spider. -/
namespace Erdos571.DoubleSpider
open SimpleGraph

def bothArmMap (p q : ℕ) (i : Fin (p+1)) (j : Fin (q+1)) : Arms p q → Arms (p+1) (q+1) :=
  Sum.map i.succAbove j.succAbove

lemma bothArmMap_injective (p q : ℕ) (i : Fin (p+1)) (j : Fin (q+1)) :
    Function.Injective (bothArmMap p q i j) :=
  Sum.map_injective.mpr ⟨i.succAbove_right_injective,j.succAbove_right_injective⟩

lemma side_bothArmMap (p q : ℕ) (i : Fin (p+1)) (j : Fin (q+1)) (r : Arms p q) :
    side (bothArmMap p q i j r)=side r := by cases r <;> rfl

def omitBothCopy (p q : ℕ) (i : Fin (p+1)) (j : Fin (q+1)) :
    (template p q).Copy (template (p+1) (q+1)) where
  toHom :=
    {toFun := Sum.map (Sum.map id (bothArmMap p q i j)) (bothArmMap p q i j)
     map_rel' := by
      intro u v h
      cases u with
      | inl a => cases v with
        | inl b => cases a with
          | inl c => cases b with
            | inl d => exact h
            | inr r =>
              change c=side (bothArmMap p q i j r)
              rw [side_bothArmMap]; exact h
          | inr r => cases b with
            | inl c =>
              change side (bothArmMap p q i j r)=c
              rw [side_bothArmMap]; exact h
            | inr r' => exact h.elim
        | inr r => exact congrArg (Sum.map id (bothArmMap p q i j)) h
      | inr r => cases v with
        | inl a => exact congrArg (Sum.map id (bothArmMap p q i j)) h
        | inr r' => exact h.elim}
  injective' := Sum.map_injective.mpr ⟨Sum.map_injective.mpr ⟨Function.injective_id,bothArmMap_injective p q i j⟩,
    bothArmMap_injective p q i j⟩

lemma omitBoth_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (i : Fin (p+1)) (j : Fin (q+1))
    (f g : (template (p+1) (q+1)).Copy G)
    (he : f.comp (omitBothCopy p q i j)=g.comp (omitBothCopy p q i j))
    (hmL : f (.inl (.inr (.inl i)))=g (.inl (.inr (.inl i))))
    (hmR : f (.inl (.inr (.inr j)))=g (.inl (.inr (.inr j))))
    (hrL : f (.inr (.inl i))=g (.inr (.inl i)))
    (hrR : f (.inr (.inr j))=g (.inr (.inr j))) : f=g := by
  apply Copy.ext
  intro v
  have hev (v) := congrArg (fun h : (template p q).Copy G => h v) he
  cases v with
  | inl a => cases a with
    | inl c => exact hev (.inl (.inl c))
    | inr r => cases r with
      | inl k =>
        by_cases hk : k=i
        · subst k; exact hmL
        · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hk
          exact hev (.inl (.inr (.inl a)))
      | inr k =>
        by_cases hk : k=j
        · subst k; exact hmR
        · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hk
          exact hev (.inl (.inr (.inr a)))
  | inr r => cases r with
    | inl k =>
      by_cases hk : k=i
      · subst k; exact hrL
      · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hk
        exact hev (.inr (.inl a))
    | inr k =>
      by_cases hk : k=j
      · subst k; exact hrR
      · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hk
        exact hev (.inr (.inr a))

end Erdos571.DoubleSpider

/-! Copies with a rich two-short-root restriction form a lower-order error. -/
set_option maxHeartbeats 2500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- Deleting one arm on each side saves one degree factor for two-short-rich copies. -/
theorem two_short_arms_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (hf : (graph (p+1) (q+1) M).Free G)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (i : Fin (p+1)) (j : Fin (q+1)) (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, TwoShortSpider.richThreshold t p q M <
      (TwoShortSpider.fiber G U t p q
        (fun c => if c then f (.inl (.inr (.inr j))) else f (.inl (.inr (.inl i))))
        (fun a => f (.inr (bothArmMap p q i j a)))).card) :
    (F.card:ℝ) ≤ 4*M*U.card*D^(2*(p+q)+4) := by
  classical
  have hD0 : 0 ≤ D := by linarith
  let S := TreeCopiesIn.copies (template p q) G U
  let pre : (template (p+1) (q+1)).Copy G → (template p q).Copy G := fun f => f.comp (omitBothCopy p q i j)
  have hmap : Set.MapsTo pre F S := by
    intro f hf
    exact (TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hmem f hf _)
  have hfiber (g : (template p q).Copy G) (hg : g∈S) :
      ((F.filter (fun f => pre f=g)).card:ℝ) ≤ 4*M*D^3 := by
    let F₁ := F.filter (fun f => pre f=g)
    let ev : (template (p+1) (q+1)).Copy G → W × W :=
      fun f => (f (.inl (.inr (.inl i))),f (.inl (.inr (.inr j))))
    let R := F₁.image ev
    let r : Arms p q ↪ W := ⟨fun a => g (.inr a),g.injective.comp Sum.inr_injective⟩
    let z : Bool ↪ W := ⟨fun c => g (.inl (.inl c)),g.injective.comp (Sum.inl_injective.comp Sum.inl_injective)⟩
    have hzr : ∀c a, z c≠r a := fun c a he => Sum.inl_ne_inr (g.injective he)
    have hev (f) (hf₁ : f∈F₁) (v) : f (omitBothCopy p q i j v)=g v :=
      congrArg (fun h : (template p q).Copy G => h v) (mem_filter.mp hf₁).2
    have hRmem : ∀v∈R, v.1∈neighbors G U (z false) ∧ v.2∈neighbors G U (z true) := by
      intro v hv
      obtain ⟨f,hf₁,rfl⟩ := mem_image.mp hv
      have hh := (mem_filter.mp hf₁).1
      constructor
      · refine mem_filter.mpr ⟨hmem f hh _,?_⟩
        change G.Adj (g (.inl (.inl false))) (f (.inl (.inr (.inl i))))
        rw [← hev f hf₁ (.inl (.inl false))]
        exact f.toHom.map_adj (show (template (p+1) (q+1)).Adj (.inl (.inl false)) (.inl (.inr (.inl i))) from rfl)
      · refine mem_filter.mpr ⟨hmem f hh _,?_⟩
        change G.Adj (g (.inl (.inl true))) (f (.inl (.inr (.inr j))))
        rw [← hev f hf₁ (.inl (.inl true))]
        exact f.toHom.map_adj (show (template (p+1) (q+1)).Adj (.inl (.inl true)) (.inl (.inr (.inr j))) from rfl)
    have hRz : ∀v∈R, ∀c, v.1≠z c ∧ v.2≠z c := by
      intro v hv c
      obtain ⟨f,hf₁,rfl⟩ := mem_image.mp hv
      change f (.inl (.inr (.inl i)))≠g (.inl (.inl c)) ∧ f (.inl (.inr (.inr j)))≠g (.inl (.inl c))
      rw [← hev f hf₁ (.inl (.inl c))]
      exact ⟨fun he => Sum.inr_ne_inl (Sum.inl.inj (f.injective he)),fun he => Sum.inr_ne_inl (Sum.inl.inj (f.injective he))⟩
    have hRrich : ∀v∈R, TwoShortSpider.richThreshold t p q M <
        (TwoShortSpider.fiber G U t p q (fun c => if c then v.2 else v.1) r).card := by
      intro v hv
      obtain ⟨f,hf₁,rfl⟩ := mem_image.mp hv
      have hh := hrich f (mem_filter.mp hf₁).1
      have her : (fun a => f (.inr (bothArmMap p q i j a)))=r := by funext a; exact hev f hf₁ (.inr a)
      rwa [her] at hh
    have hR : (R.card:ℝ) ≤ 4*M*D := TwoShortSpider.rich_pairs_bound_real G U t p q M hf r z hzr hD
      (fun c => hdeg (z c) ((TreeCopiesIn.mem_copies _ _ _ _).mp hg _)) R hRmem hRz hRrich
    have hinner (w : W × W) (hw : w∈R) : ((F₁.filter (fun f => ev f=w)).card:ℝ) ≤ D^2 := by
      let F₂ := F₁.filter (fun f => ev f=w)
      have hcard : F₂.card ≤ ((neighbors G U w.1) ×ˢ (neighbors G U w.2)).card := by
        apply card_le_card_of_injOn (fun f => (f (.inr (.inl i)),f (.inr (.inr j))))
        · intro f hf₂
          have hh := (mem_filter.mp hf₂).2
          have hm₁ : f (.inl (.inr (.inl i)))=w.1 := congrArg Prod.fst hh
          have hm₂ : f (.inl (.inr (.inr j)))=w.2 := congrArg Prod.snd hh
          apply mem_product.mpr
          constructor
          · refine mem_filter.mpr ⟨hmem f (mem_filter.mp (mem_filter.mp hf₂).1).1 _,?_⟩
            rw [← hm₁]
            exact f.toHom.map_adj (show (template (p+1) (q+1)).Adj (.inl (.inr (.inl i))) (.inr (.inl i)) from rfl)
          · refine mem_filter.mpr ⟨hmem f (mem_filter.mp (mem_filter.mp hf₂).1).1 _,?_⟩
            rw [← hm₂]
            exact f.toHom.map_adj (show (template (p+1) (q+1)).Adj (.inl (.inr (.inr j))) (.inr (.inr j)) from rfl)
        · intro f hf₂ f' hf₂' he
          apply omitBoth_ext G p q i j f f'
          · exact (mem_filter.mp (mem_filter.mp hf₂).1).2.trans (mem_filter.mp (mem_filter.mp hf₂').1).2.symm
          · exact congrArg Prod.fst ((mem_filter.mp hf₂).2.trans (mem_filter.mp hf₂').2.symm)
          · exact congrArg Prod.snd ((mem_filter.mp hf₂).2.trans (mem_filter.mp hf₂').2.symm)
          · exact congrArg Prod.fst he
          · exact congrArg Prod.snd he
      rw [card_product] at hcard
      have hd₁ := hdeg w.1 (mem_filter.mp (hRmem w hw).1).1
      have hd₂ := hdeg w.2 (mem_filter.mp (hRmem w hw).2).1
      calc
        _ ≤ ((neighbors G U w.1).card:ℝ)*(neighbors G U w.2).card := by exact_mod_cast hcard
        _ ≤ D*D := mul_le_mul hd₁ hd₂ (by positivity) hD0
        _ = _ := (pow_two D).symm
    have hb := RealFiberCount.bound F₁ R ev (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩) hinner
    calc
      _ ≤ (R.card:ℝ)*D^2 := hb
      _ ≤ (4*M*D)*D^2 := mul_le_mul_of_nonneg_right hR (by positivity)
      _ = _ := by ring
  have hb := RealFiberCount.bound F S pre hmap hfiber
  have hs := ConnectedCopyBound.total (template p q) (connected p q) G U hD0 hdeg S
    (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have he : Fintype.card (Interior p q ⊕ Arms p q)-1=2*(p+q)+1 := by
    simp only [Interior,Arms,Fintype.card_sum,Fintype.card_bool,Fintype.card_fin]; omega
  rw [he] at hs
  calc
    _ ≤ (S.card:ℝ)*(4*M*D^3) := hb
    _ ≤ (U.card:ℝ)*D^(2*(p+q)+1)*(4*M*D^3) := mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [show 2*(p+q)+4=(2*(p+q)+1)+3 by omega,pow_add]; ring

end Erdos571.DoubleSpider

/-! Light propagation when only the pinned vertex may lack an adjacent root. -/
namespace Erdos571.LightExtension
open Finset SimpleGraph

lemma rooted_spans_except {A R : Type} [Fintype A] [Fintype R] [DecidableEq A] [DecidableEq R]
    (K : SimpleGraph A) (hK : K.Connected) (E : A → R → Prop) (a₀ : A) (hE : ∀a, a≠a₀ → ∃r, E a r) :
    Spans (RootedIncidence.graph K E) (insert (.inl a₀) (univ.image Sum.inr)) := by
  classical
  intro C hC hproper
  let X := univ.filter (fun a : A => Sum.inl a∈C)
  have hX : X.Nonempty := ⟨a₀,mem_filter.mpr ⟨mem_univ _,hC (mem_insert_self _ _)⟩⟩
  have hroot (r : R) : Sum.inr r∈C := hC (mem_insert_of_mem (mem_image.mpr ⟨r,mem_univ _,rfl⟩))
  have hXp : X≠univ := by
    intro he
    apply hproper
    apply eq_univ_of_forall
    intro v
    cases v with
    | inl a =>
      have haX : a ∈ X := by rw [he]; exact mem_univ a
      exact (mem_filter.mp haX).2
    | inr r => exact hroot r
  obtain ⟨u,hu,v,hv,huv⟩ := ConnectedCopyBound.boundary K hK X hX hXp
  have hvC : Sum.inl v∉C := by simpa [X] using hv
  obtain ⟨r,hr⟩ := hE v (by intro he; subst v; exact hvC (hC (mem_insert_self _ _)))
  exact ⟨.inl v,hvC,.inl u,(mem_filter.mp hu).2,.inr r,hroot r,Sum.inl_ne_inr,huv,hr⟩

lemma rooted_vertex_count_except {A R W : Type} [Fintype A] [Fintype R]
    [DecidableEq A] [DecidableEq R] [DecidableEq W]
    (K : SimpleGraph A) (hK : K.Connected) (E : A → R → Prop)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (F : Finset ((RootedIncidence.graph K E).Copy G)) (r : R → W) (a₀ : A) (hE : ∀a, a≠a₀ → ∃r, E a r) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (RootedIncidence.graph K E) G U t f)
    (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (hpin : ∀f∈F, f (.inl a₀)=w) : F.card ≤ t^(Fintype.card A-1) := by
  classical
  let C := insert (Sum.inl a₀) (univ.image (@Sum.inr A R))
  have hcard : C.card=Fintype.card R+1 := by simp [C,card_image_of_injective _ Sum.inr_injective]
  have hb := bound (RootedIncidence.graph K E) G U t C (rooted_spans_except K hK E a₀ hE) C (Subset.refl _)
    (Sum.elim (fun _ => w) r) F hmem hl (by
      intro f hf v hv
      rcases mem_insert.mp hv with rfl|hv
      · exact hpin f hf
      · obtain ⟨x,hx,rfl⟩ := mem_image.mp hv
        exact hroot f hf x)
  have he : Fintype.card A + Fintype.card R - (Fintype.card R+1) = Fintype.card A-1 := by omega
  simpa only [Fintype.card_sum,hcard,he] using hb


end Erdos571.LightExtension

/-! A double spider with one additional short root at its left center. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OneShortSpider
open Finset SimpleGraph DoubleSpider

def incidence (p q : ℕ) : Interior p q → Option (Arms p q) → Prop
  | a,none => a=.inl false
  | a,some r => a=.inr r

def template (p q : ℕ) : SimpleGraph (Interior p q ⊕ Option (Arms p q)) :=
  RootedIncidence.graph (core p q) (incidence p q)

instance (p q : ℕ) : DecidableRel (template p q).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [template,RootedIncidence.graph]
  · rename_i a b
    cases a <;> cases b <;> dsimp [core] <;> infer_instance
  · rename_i a r; cases r <;> dsimp [incidence] <;> infer_instance
  · rename_i r a; cases r <;> dsimp [incidence] <;> infer_instance
  · infer_instance

def baseCopy (p q : ℕ) : (DoubleSpider.template p q).Copy (template p q) where
  toHom := {toFun := Sum.map id some,map_rel' := by intro u v h; cases u <;> cases v <;> exact h}
  injective' := Sum.map_injective.mpr ⟨Function.injective_id,Option.some_injective _⟩

def leftVertex (p q : ℕ) : Option (Fin p) ⊕ Option (Fin p) → Interior p q ⊕ Option (Arms p q)
  | .inl none => .inl (.inl false)
  | .inl (some i) => .inl (.inr (.inl i))
  | .inr none => .inr none
  | .inr (some i) => .inr (some (.inl i))

lemma leftVertex_injective (p q : ℕ) : Function.Injective (leftVertex p q) := by
  intro u v he
  cases u with
  | inl a => cases v with
    | inl b => cases a <;> cases b <;> simpa [leftVertex] using he
    | inr b => cases a <;> cases b <;> simp [leftVertex] at he
  | inr a => cases v with
    | inl b => cases a <;> cases b <;> simp [leftVertex] at he
    | inr b => cases a <;> cases b <;> simpa [leftVertex] using he

def leftCopy (p q : ℕ) : (ShortSpider.template p).Copy (template p q) where
  toHom :=
    { toFun := leftVertex p q
      map_rel' := by
        intro u v h
        cases u with
        | inl a => cases v with
          | inl b => cases a <;> cases b <;> simp_all [leftVertex,template,RootedIncidence.graph,core,side,ShortSpider.template]
          | inr b => change a=b at h; subst b; cases a <;> rfl
        | inr a => cases v with
          | inl b => change a=b at h; subst b; cases a <;> rfl
          | inr b => exact h.elim}
  injective' := leftVertex_injective p q

def rightCopy (p q : ℕ) : (LongSpider.template q).Copy (template p q) :=
  (baseCopy p q).comp (DoubleSpider.rightCopy p q)

def rightShortCopy (p q : ℕ) : (ShortSpider.template q).Copy (template p q) :=
  (baseCopy p q).comp (DoubleSpider.rightShortCopy p q)

lemma pair_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (f g : (template p q).Copy G)
    (hL : f.comp (leftCopy p q)=g.comp (leftCopy p q))
    (hR : f.comp (rightCopy p q)=g.comp (rightCopy p q)) : f=g := by
  apply Copy.ext
  intro v
  have hleft (v) := congrArg (fun h : (ShortSpider.template p).Copy G => h v) hL
  have hright (v) := congrArg (fun h : (LongSpider.template q).Copy G => h v) hR
  cases v with
  | inl a => cases a with
    | inl c =>
      cases c
      · exact hleft (.inl none)
      · exact hright (.inl none)
    | inr r => cases r with
      | inl i => exact hleft (.inl (some i))
      | inr j => exact hright (.inl (some j))
  | inr r => cases r with
    | none => exact hleft (.inr none)
    | some a => cases a with
      | inl i => exact hleft (.inr (some i))
      | inr j => exact hright (.inr j)

lemma short_pair_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (f g : (template p q).Copy G)
    (hL : f.comp (leftCopy p q)=g.comp (leftCopy p q))
    (hR : f.comp (rightShortCopy p q)=g.comp (rightShortCopy p q)) : f=g := by
  apply pair_ext G p q f g hL
  apply Copy.ext
  intro v
  cases v with
  | inl a => cases a with
    | none => exact congrArg (fun h : (ShortSpider.template q).Copy G => h (.inl none)) hR
    | some i => exact congrArg (fun h : (ShortSpider.template q).Copy G => h (.inl (some i))) hR
  | inr j => exact congrArg (fun h : (ShortSpider.template q).Copy G => h (.inr (some j))) hR

end Erdos571.OneShortSpider

/-! Pinning counts for one-short-root double-spider fibers. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OneShortSpider
open Finset SimpleGraph DoubleSpider
variable {W : Type} [Fintype W] [DecidableEq W]

lemma right_center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Option (Arms p q) → W) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inl true))=w) :
    F.card ≤ t^(p+q+1) := by
  have hb := LightExtension.rooted_vertex_count_except (core p q) (TwoShortSpider.core_connected p q)
    (incidence p q) G U t F r (.inl true) (by
      intro a ha
      cases a with
      | inl c =>
        cases c
        · exact ⟨none,rfl⟩
        · exact (ha rfl).elim
      | inr a => exact ⟨some a,rfl⟩) w hmem hl hroot hpin
  have he : Fintype.card (Interior p q)-1=p+q+1 := by
    simp only [Interior,Arms,Fintype.card_sum,Fintype.card_bool,Fintype.card_fin]; omega
  simpa only [he] using hb

lemma left_center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Option (Arms p q) → W) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inl false))=w)
    (hcap : ∀f∈F, (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => r (some (.inr j)))).card ≤ L) :
    F.card ≤ t^p*L := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  let pr : (template p q).Copy G → (ShortSpider.template q).Copy G := fun f => f.comp (rightShortCopy p q)
  let pl : (template p q).Copy G → (ShortSpider.template p).Copy G := fun f => f.comp (leftCopy p q)
  have him : F.image pr ⊆ LongSpider.shortFiber G U t q w (fun j => r (some (.inr j))) := by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    apply (LongSpider.mem_shortFiber _ _ _ _ _ _ _).mpr
    refine ⟨ShortSpider.good_of_light G U t q (pr f) (fun v => hmem f hf _) ((hl f hf).comp _),hpin f hf,?_⟩
    intro j
    exact hroot f hf (some (.inr j))
  have hic : (F.image pr).card ≤ L := by
    have hh := hcap f₀ hf₀
    rw [hpin f₀ hf₀] at hh
    exact (card_le_card him).trans hh
  have hfi (g : (ShortSpider.template q).Copy G) (hg : g∈F.image pr) :
      (F.filter (fun f => pr f=g)).card ≤ t^p := by
    let A := F.filter (fun f => pr f=g)
    have hi : Set.InjOn pl A := by
      intro f hf f' hf' he
      exact short_pair_ext G p q f f' he ((mem_filter.mp hf).2.trans (mem_filter.mp hf').2.symm)
    have he : (A.image pl).card=A.card := card_image_of_injOn hi
    rw [← he]
    apply ShortSpider.center_count G U t p (A.image pl) (fun a => a.elim (r none) (fun i => r (some (.inl i)))) w
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact ShortSpider.good_of_light G U t p (pl f) (fun v => hmem f (mem_filter.mp hf).1 _)
        ((hl f (mem_filter.mp hf).1).comp _)
    · intro g hg a
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      cases a with
      | none => exact hroot f (mem_filter.mp hf).1 none
      | some i => exact hroot f (mem_filter.mp hf).1 (some (.inl i))
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact hpin f (mem_filter.mp hf).1
  exact (card_le_mul_card_image F (t^p) hfi).trans (Nat.mul_le_mul_left _ hic)

lemma left_arm_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Option (Arms p q) → W) (i : Fin p) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inr (.inl i)))=w)
    (hcap : ∀f∈F, (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => r (some (.inr j)))).card ≤ L) :
    F.card ≤ t^(p+1)*L := by
  classical
  let ev : (template p q).Copy G → W := fun f => f (.inl (.inl false))
  let C := FourthMoment.common G U (r none) w
  have hc : (F.image ev).card ≤ t := by
    by_cases hn : F.Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,image_empty,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hn
    have hb := hl f₀ hf₀ (.inr none) (.inl (.inl false)) (.inl (.inr (.inl i)))
      (show (template p q).Adj (.inr none) (.inl (.inl false)) from rfl)
      (show (template p q).Adj (.inl (.inl false)) (.inl (.inr (.inl i))) from rfl) Sum.inr_ne_inl
    rw [hroot f₀ hf₀ none,hpin f₀ hf₀] at hb
    apply le_trans _ hb.le
    apply card_le_card
    intro x hx
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hx
    refine mem_filter.mpr ⟨hmem f hf _,?_,?_⟩
    · rw [← hroot f hf none]
      exact f.toHom.map_adj (show (template p q).Adj (.inr none) (.inl (.inl false)) from rfl)
    · rw [← hpin f hf]
      exact f.toHom.map_adj (show (template p q).Adj (.inl (.inr (.inl i))) (.inl (.inl false)) from rfl)
  have hfi (x) (hx : x∈F.image ev) : (F.filter (fun f => ev f=x)).card ≤ t^p*L :=
    left_center_count G U t p q L _ r x (fun f hf => hmem f (mem_filter.mp hf).1)
      (fun f hf => hl f (mem_filter.mp hf).1) (fun f hf => hroot f (mem_filter.mp hf).1)
      (fun f hf => (mem_filter.mp hf).2) (fun f hf => hcap f (mem_filter.mp hf).1)
  calc
    _ ≤ (t^p*L)*(F.image ev).card := card_le_mul_card_image F _ hfi
    _ ≤ (t^p*L)*t := Nat.mul_le_mul_left _ hc
    _ = _ := by rw [pow_succ]; ring

end Erdos571.OneShortSpider

/-! Turning a right arm middle into a short root by removing its tip. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OneShortSpider
open Finset SimpleGraph DoubleSpider

def rightArmMap (p q : ℕ) (j : Fin (q+1)) : Arms p q → Arms p (q+1) := Sum.map id j.succAbove

lemma rightArmMap_injective (p q : ℕ) (j : Fin (q+1)) : Function.Injective (rightArmMap p q j) :=
  Sum.map_injective.mpr ⟨Function.injective_id,j.succAbove_right_injective⟩

lemma rightArmMap_ne (p q : ℕ) (j : Fin (q+1)) (a : Arms p q) : rightArmMap p q j a≠.inr j := by
  cases a with
  | inl i => exact Sum.inl_ne_inr
  | inr k => exact fun he => Fin.succAbove_ne j k (Sum.inr.inj he)

lemma side_rightArmMap (p q : ℕ) (j : Fin (q+1)) (a : Arms p q) : side (rightArmMap p q j a)=side a := by
  cases a <;> rfl

def shortenedVertex (p q : ℕ) (j : Fin (q+1)) : Interior p q ⊕ Interior p q → Interior p (q+1) ⊕ Option (Arms p (q+1))
  | .inl a => .inl (Sum.map id (rightArmMap p q j) a)
  | .inr (.inl false) => .inr none
  | .inr (.inl true) => .inl (.inr (.inr j))
  | .inr (.inr a) => .inr (some (rightArmMap p q j a))

lemma shortenedVertex_injective (p q : ℕ) (j : Fin (q+1)) : Function.Injective (shortenedVertex p q j) := by
  intro u v he
  have hi := rightArmMap_injective p q j
  have hn := rightArmMap_ne p q j
  have hn' (a) := Ne.symm (hn a)
  rcases u with (c|a)|(c|a) <;> rcases v with (d|b)|(d|b)
  all_goals try cases c
  all_goals try cases d
  all_goals simp_all [shortenedVertex,hi.eq_iff,hn,hn']
  all_goals first | exact rightArmMap_ne p q j _ he | exact rightArmMap_ne p q j _ he.symm

def shortenedCopy (p q : ℕ) (j : Fin (q+1)) : (TwoShortSpider.template p q).Copy (template p (q+1)) where
  toHom :=
    { toFun := shortenedVertex p q j
      map_rel' := by
        intro u v h
        cases u with
        | inl a => cases v with
          | inl b => cases a with
            | inl c => cases b with
              | inl d => exact h
              | inr r =>
                change c=side (rightArmMap p q j r)
                rw [side_rightArmMap]; exact h
            | inr r => cases b with
              | inl c =>
                change side (rightArmMap p q j r)=c
                rw [side_rightArmMap]; exact h
              | inr r' => exact h.elim
          | inr r =>
            change a=r at h
            subst a
            cases r with
            | inl c => cases c <;> rfl
            | inr r => rfl
        | inr r => cases v with
          | inl a =>
            change a=r at h
            subst a
            cases r with
            | inl c => cases c <;> rfl
            | inr r => rfl
          | inr r' => exact h.elim }
  injective' := shortenedVertex_injective p q j

lemma shortened_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (j : Fin (q+1))
    (f g : (template p (q+1)).Copy G)
    (he : f.comp (shortenedCopy p q j)=g.comp (shortenedCopy p q j))
    (hroot : f (.inr (some (.inr j)))=g (.inr (some (.inr j)))) : f=g := by
  apply Copy.ext
  intro v
  have hev (v) := congrArg (fun h : (TwoShortSpider.template p q).Copy G => h v) he
  cases v with
  | inl a => cases a with
    | inl c => exact hev (.inl (.inl c))
    | inr r => cases r with
      | inl i => exact hev (.inl (.inr (.inl i)))
      | inr k =>
        by_cases hk : k=j
        · subst k; exact hev (.inr (.inl true))
        · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hk
          exact hev (.inl (.inr (.inr a)))
  | inr r => cases r with
    | none => exact hev (.inr (.inl false))
    | some a => cases a with
      | inl i => exact hev (.inr (.inr (.inl i)))
      | inr k =>
        by_cases hk : k=j
        · subst k; exact hroot
        · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hk
          exact hev (.inr (.inr (.inr a)))

end Erdos571.OneShortSpider

/-! Bounded interior loads for selectively capped one-short-root fibers. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OneShortSpider
open Finset SimpleGraph DoubleSpider
variable {W : Type} [Fintype W] [DecidableEq W]

lemma right_arm_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q B : ℕ)
    (F : Finset ((template p (q+1)).Copy G)) (r : Option (Arms p (q+1)) → W) (j : Fin (q+1)) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template p (q+1)) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inr (.inr j)))=w)
    (hcap : ∀f∈F, (TwoShortSpider.fiber G U t p q
      (fun c => if c then f (.inl (.inr (.inr j))) else r none)
      (fun a => r (some (rightArmMap p q j a)))).card ≤ B) : F.card ≤ B := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  let pr : (template p (q+1)).Copy G → (TwoShortSpider.template p q).Copy G := fun f => f.comp (shortenedCopy p q j)
  have hi : Set.InjOn pr F := by
    intro f hf g hg he
    exact shortened_ext G p q j f g he ((hroot f hf _).trans (hroot g hg _).symm)
  have him : F.image pr ⊆ TwoShortSpider.fiber G U t p q (fun c => if c then w else r none)
      (fun a => r (some (rightArmMap p q j a))) := by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    apply (TwoShortSpider.mem_fiber _ _ _ _ _ _ _ _).mpr
    refine ⟨(fun v => hmem f hf _),(hl f hf).comp _,?_⟩
    intro a
    cases a with
    | inl c =>
      cases c
      · exact hroot f hf none
      · exact hpin f hf
    | inr a => exact hroot f hf (some (rightArmMap p q j a))
  have hh := hcap f₀ hf₀
  rw [hpin f₀ hf₀] at hh
  rw [← card_image_of_injOn hi]
  exact (card_le_card him).trans hh

/-- Core completion and two-short restrictions are capped only where needed. -/
def GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B : ℕ)
    (f : (template p (q+1)).Copy G) : Prop :=
  (∀v, f v∈U) ∧ ConnectedCopyBound.Light (template p (q+1)) G U t f ∧
  (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (some (.inr j))))).card ≤ L ∧
  ∀j : Fin (q+1), (TwoShortSpider.fiber G U t p q
    (fun c => if c then f (.inl (.inr (.inr j))) else f (.inr none))
    (fun a => f (.inr (some (rightArmMap p q j a))))).card ≤ B

def loadBound (t p q L B : ℕ) : ℕ :=
  (p+q+3)*((t^p+t^(p+1))*L+t^(p+q+2)+B)

lemma vertex_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B : ℕ)
    (F : Finset ((template p (q+1)).Copy G)) (r : Option (Arms p (q+1)) → W)
    (hgood : ∀f∈F, GoodCopy G U t p q L B f) (hroot : ∀f∈F, ∀a, f (.inr a)=r a)
    (a : Interior p (q+1)) (w : W) (hpin : ∀f∈F, f (.inl a)=w) :
    F.card ≤ (t^p+t^(p+1))*L+t^(p+q+2)+B := by
  have hmem := fun f hf => (hgood f hf).1
  have hl := fun f hf => (hgood f hf).2.1
  have hcap : ∀f∈F, (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => r (some (.inr j)))).card ≤ L := by
    intro f hf
    simpa only [hroot f hf] using (hgood f hf).2.2.1
  cases a with
  | inl c =>
    cases c
    · have hb := left_center_count G U t p (q+1) L F r w hmem hl hroot hpin hcap
      rw [add_mul]; omega
    · have hb := right_center_count G U t p (q+1) F r w hmem hl hroot hpin
      have he : p+(q+1)+1=p+q+2 := by omega
      rw [he] at hb
      omega
  | inr a => cases a with
    | inl i =>
      have hb := left_arm_count G U t p (q+1) L F r i w hmem hl hroot hpin hcap
      rw [add_mul]; omega
    | inr j =>
      have hb := right_arm_count G U t p q B F r j w hmem hl hroot hpin (by
        intro f hf
        simpa only [hroot f hf] using (hgood f hf).2.2.2 j)
      omega

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B : ℕ)
    (F : Finset ((template p (q+1)).Copy G)) (r : Option (Arms p (q+1)) → W)
    (hgood : ∀f∈F, GoodCopy G U t p q L B f) (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤ loadBound t p q L B := by
  classical
  let A (a : Interior p (q+1)) := F.filter (fun f => f (.inl a)=w)
  have hs : F.filter (fun f => w∈RootedPacking.interior f) ⊆ univ.biUnion A := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨(mem_filter.mp hf).1,ha⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hs
    _ ≤ ∑a : Interior p (q+1), (A a).card := card_biUnion_le
    _ ≤ ∑_a : Interior p (q+1), ((t^p+t^(p+1))*L+t^(p+q+2)+B) := sum_le_sum (fun a _ =>
      vertex_count G U t p q L B (A a) r (fun f hf => hgood f (mem_filter.mp hf).1)
        (fun f hf => hroot f (mem_filter.mp hf).1) a w (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by
      simp only [sum_const,card_univ,Interior,Arms,Fintype.card_sum,Fintype.card_bool,Fintype.card_fin,nsmul_eq_mul,loadBound]
      simp only [Nat.cast_id]
      congr 1 <;> omega

end Erdos571.OneShortSpider

/-! Extending the short root of a one-short-root double spider. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OneShortSpider
open Finset SimpleGraph DoubleSpider

lemma left_right_disjoint (p q : ℕ) (u) (v) : leftCopy p q u≠rightCopy p q v := by
  cases u with
  | inl a => cases v with
    | inl b => cases a <;> cases b <;> simp [leftCopy,leftVertex,rightCopy,baseCopy,DoubleSpider.rightCopy,swap,DoubleSpider.leftCopy,DoubleSpider.leftVertex]
    | inr b => cases a <;> simp [leftCopy,leftVertex,rightCopy,baseCopy,DoubleSpider.rightCopy,swap,DoubleSpider.leftCopy,DoubleSpider.leftVertex]
  | inr a => cases v with
    | inl b => cases a <;> cases b <;> simp [leftCopy,leftVertex,rightCopy,baseCopy,DoubleSpider.rightCopy,swap,DoubleSpider.leftCopy,DoubleSpider.leftVertex]
    | inr b => cases a <;> simp [leftCopy,leftVertex,rightCopy,baseCopy,DoubleSpider.rightCopy,swap,DoubleSpider.leftCopy,DoubleSpider.leftVertex]

def extendCopy {W : Type*} (G : SimpleGraph W) (p q : ℕ) (f : (template p q).Copy G)
    (z : W) (ha : G.Adj z (f (.inr none))) (hf : ∀v, z≠f v) : (DoubleSpider.template (p+1) q).Copy G := by
  let fL := f.comp (leftCopy p q)
  let fR := f.comp (rightCopy p q)
  let gL := LongSpider.extendCopy G p fL z ha (fun v => hf _)
  have hc : ∀u v, gL u≠fR v := by
    intro u v he
    rcases LongSpider.extendCopy_range G p fL z ha (fun v => hf _) u with hh|⟨a,hh⟩
    · exact hf _ (hh.symm.trans he)
    · exact left_right_disjoint p q a v (f.injective (hh.symm.trans he))
  exact joinCopy G (p+1) q gL fR
    (f.toHom.map_adj (show (template p q).Adj (.inl (.inl false)) (.inl (.inl true)) from Bool.false_ne_true)) hc

@[simp] lemma extendCopy_left_root_zero {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : W) (ha) (hf) : extendCopy G p q f z ha hf (.inr (.inl 0))=z := rfl
@[simp] lemma extendCopy_left_root_succ {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : W) (ha) (hf) (i : Fin p) :
    extendCopy G p q f z ha hf (.inr (.inl i.succ))=f (.inr (some (.inl i))) := rfl
@[simp] lemma extendCopy_right_root {W : Type*} (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : W) (ha) (hf) (j : Fin q) :
    extendCopy G p q f z ha hf (.inr (.inr j))=f (.inr (some (.inr j))) := rfl

lemma extendCopy_interior {W : Type*} [DecidableEq W] (G : SimpleGraph W) (p q : ℕ)
    (f : (template p q).Copy G) (z : W) (ha) (hf) :
    RootedPacking.interior (extendCopy G p q f z ha hf)=insert (f (.inr none)) (RootedPacking.interior f) := by
  classical
  unfold extendCopy
  dsimp only
  rw [joinCopy_interior,LongSpider.extendCopy_interior]
  have he : RootedPacking.interior (f.comp (leftCopy p q)) ∪ RootedPacking.interior (f.comp (rightCopy p q))=
      RootedPacking.interior f := by
    ext w
    simp only [RootedPacking.interior,mem_union,mem_image,mem_univ,true_and]
    constructor
    · rintro (⟨a,rfl⟩|⟨a,rfl⟩)
      · cases a with
        | none => exact ⟨.inl false,rfl⟩
        | some i => exact ⟨.inr (.inl i),rfl⟩
      · cases a with
        | none => exact ⟨.inl true,rfl⟩
        | some j => exact ⟨.inr (.inr j),rfl⟩
    · rintro ⟨a,rfl⟩
      cases a with
      | inl c =>
        cases c
        · exact Or.inl ⟨none,rfl⟩
        · exact Or.inr ⟨none,rfl⟩
      | inr a => cases a with
        | inl i => exact Or.inl ⟨some i,rfl⟩
        | inr j => exact Or.inr ⟨some j,rfl⟩
  rw [insert_union,he]
  rfl

def rootCode (p q : ℕ) : Arms (p+1) q → Option (Arms p q) :=
  Sum.elim (Fin.cases none (fun i => some (.inl i))) (fun j => some (.inr j))

lemma rootCode_injective (p q : ℕ) : Function.Injective (rootCode p q) := by
  let back : Option (Arms p q) → Arms (p+1) q := fun a => a.elim (.inl 0) (Sum.map Fin.succ id)
  have he : Function.LeftInverse back (rootCode p q) := by
    intro a
    cases a with
    | inl i => induction i using Fin.cases <;> rfl
    | inr j => rfl
  exact he.injective

def extendedRoots {W : Type*} (p q : ℕ) (z : W) (r : Arms p q ↪ W) (hz : ∀a, z≠r a) :
    Arms (p+1) q ↪ W :=
  ⟨(fun a => a.elim z r) ∘ rootCode p q,by
    apply Function.Injective.comp _ (rootCode_injective p q)
    intro a b he
    cases a with
    | none => cases b with
      | none => rfl
      | some b => exact (hz b he).elim
    | some a => cases b with
      | none => exact (hz a he.symm).elim
      | some b => exact congrArg some (r.injective he)⟩

end Erdos571.OneShortSpider

/-! Rich selectively capped one-short-root fibers force double-spider powers. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OneShortSpider
open Finset SimpleGraph DoubleSpider DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def fiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B : ℕ) (w : W) (r : Arms p (q+1) → W) : Finset ((template p (q+1)).Copy G) := by
  classical
  exact univ.filter (fun f => GoodCopy G U t p q L B f ∧ f (.inr none)=w ∧ ∀a, f (.inr (some a))=r a)

lemma mem_fiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B : ℕ) (w : W) (r : Arms p (q+1) → W) (f : (template p (q+1)).Copy G) :
    f∈fiber G U t p q L B w r ↔ GoodCopy G U t p q L B f ∧ f (.inr none)=w ∧ ∀a, f (.inr (some a))=r a := by
  classical
  simp only [fiber,mem_filter,mem_univ,true_and]

lemma fiber_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B : ℕ) (w : W) (r : Arms p (q+1) → W) (v : W) :
    ((fiber G U t p q L B w r).filter (fun f => v∈RootedPacking.interior f)).card ≤ loadBound t p q L B := by
  apply interior_load G U t p q L B _ (fun a => a.elim w r)
  · intro f hf; exact ((mem_fiber _ _ _ _ _ _ _ _ _ _).mp hf).1
  · intro f hf a
    have hh := (mem_fiber _ _ _ _ _ _ _ _ _ _).mp hf
    cases a with
    | none => exact hh.2.1
    | some a => exact hh.2.2 a

def richThreshold (t p q L B M : ℕ) : ℕ :=
  (p+q+2+(p+q+4)*M)*loadBound t p q L B

lemma contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B M : ℕ) (r : Arms p (q+1) ↪ W) (z : W) (hzr : ∀a, z≠r a)
    (w : Fin M ↪ W) (ha : ∀i, G.Adj z (w i))
    (hrich : ∀i, richThreshold t p q L B M < (fiber G U t p q L B (w i) r).card) :
    (DoubleSpider.graph (p+1) (q+1) M).IsContained G := by
  classical
  let Z : Finset W := insert z (univ.image r ∪ univ.image w)
  have hZ : Z.card ≤ p+q+2+M := by
    have h₁ := card_insert_le z (univ.image r ∪ univ.image w)
    have h₂ := card_union_le (univ.image r) (univ.image w)
    have h₃ : (univ.image r).card ≤ p+q+1 := by
      simpa only [Arms,card_univ,Fintype.card_sum,Fintype.card_fin,Nat.add_assoc] using card_image_le (s:=univ) (f:=r)
    have h₄ : (univ.image w).card ≤ M := by simpa using card_image_le (s:=univ) (f:=w)
    dsimp only [Z]; omega
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice (p+q+3) (loadBound t p q L B) M
    RootedPacking.interior (fun i => fiber G U t p q L B (w i) r) Z
    (by intro i f hf; simpa [Interior,Arms,Nat.add_comm,Nat.add_left_comm,Nat.add_assoc] using (RootedPacking.interior_card f).le)
    (fun i v => fiber_load G U t p q L B (w i) r v)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by
      change Z.card+(p+q+3)*M ≤ p+q+2+(p+q+4)*M
      nlinarith)) (hrich i))
  have hroot (i) := ((mem_fiber G U t p q L B (w i) r (f i)).mp (hf i)).2
  have hfresh (i) : ∀v, z≠f i v := by
    intro v he
    cases v with
    | inl a => exact Finset.disjoint_left.mp (hfZ i).symm (mem_insert_self _ _) (he ▸ RootedPacking.mem_interior (f i) a)
    | inr a => cases a with
      | none => rw [(hroot i).1] at he; exact G.ne_of_adj (ha i) he
      | some a => rw [(hroot i).2 a] at he; exact hzr a he
  let g : Fin M → (DoubleSpider.template (p+1) (q+1)).Copy G := fun i =>
    extendCopy G p (q+1) (f i) z (by rw [(hroot i).1]; exact ha i) (hfresh i)
  have hgroot : ∀i a, g i (.inr a)=extendedRoots p (q+1) z r hzr a := by
    intro i a
    cases a with
    | inl a => induction a using Fin.cases with
      | zero => rfl
      | succ a => exact (hroot i).2 (.inl a)
    | inr a => exact (hroot i).2 (.inr a)
  have hgint (i) : RootedPacking.interior (g i)=insert (w i) (RootedPacking.interior (f i)) := by
    simp only [g,extendCopy_interior,(hroot i).1]
  have hwi (i j) : w i∉RootedPacking.interior (f j) := by
    intro hw
    exact Finset.disjoint_left.mp (hfZ j).symm (mem_insert_of_mem (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))) hw
  have hgdis : ∀i j, i≠j → Disjoint (RootedPacking.interior (g i)) (RootedPacking.interior (g j)) := by
    intro i j hij
    rw [hgint,hgint,disjoint_insert_left,disjoint_insert_right]
    exact ⟨by simp [w.injective.ne hij,hwi],hwi j i,hfdis hij⟩
  have he : RootedPacking.power (DoubleSpider.template (p+1) (q+1)) M=DoubleSpider.graph (p+1) (q+1) M := by
    ext u v; cases u <;> cases v <;> rfl
  rw [← he]
  exact ⟨RootedPacking.powerCopy M (extendedRoots p (q+1) z r hzr) g hgroot hgdis⟩

lemma rich_neighbors_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B M : ℕ) (hf : (DoubleSpider.graph (p+1) (q+1) M).Free G)
    (r : Arms p (q+1) ↪ W) (z : W) (hzr : ∀a, z≠r a) :
    ((neighbors G U z).filter (fun w => richThreshold t p q L B M < (fiber G U t p q L B w r).card)).card < M := by
  classical
  by_contra! hc
  obtain ⟨S,hS,hSc⟩ := exists_subset_card_eq hc
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let w : Fin M ↪ W := ⟨fun i => e i,fun i j h => e.injective (Subtype.ext h)⟩
  apply hf (contains_of_rich_neighbors G U t p q L B M r z hzr w ?_ ?_)
  · intro i; exact (mem_filter.mp (mem_filter.mp (hS (e i).property)).1).2
  · intro i; exact (mem_filter.mp (hS (e i).property)).2

end Erdos571.OneShortSpider

/-! Rich selectively capped one-short-root fibers give a lower-order exclusion. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- The nested-rich neighbor bound costs one degree factor less than the total
number of tree copies. No lightness assumption on the full family is needed. -/
theorem one_short_arm_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B M : ℕ) (hf : (graph (p+1) (q+1) M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (j : Fin (p+1)) (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, OneShortSpider.richThreshold t p q L B M <
      (OneShortSpider.fiber G U t p q L B (f (.inl (.inr (.inl j)))) (fun r => f (.inr (leftArmMap p (q+1) j r)))).card) :
    (F.card:ℝ) ≤ (M:ℝ)*U.card*D^(2*(p+q)+4) := by
  classical
  let S := TreeCopiesIn.copies (template p (q+1)) G U
  let pre : (template (p+1) (q+1)).Copy G → (template p (q+1)).Copy G := fun f => f.comp (omitLeftCopy p (q+1) j)
  have hmap : Set.MapsTo pre F S := by
    intro f hf
    exact (TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hmem f hf _)
  have hfiber (g : (template p (q+1)).Copy G) (hg : g∈S) :
      ((F.filter (fun f => pre f=g)).card:ℝ) ≤ (M:ℝ)*D := by
    let F₁ := F.filter (fun f => pre f=g)
    let r : Arms p (q+1) ↪ W := ⟨fun a => g (.inr a),g.injective.comp Sum.inr_injective⟩
    let R := (neighbors G U (g (.inl (.inl false)))).filter (fun w => OneShortSpider.richThreshold t p q L B M < (OneShortSpider.fiber G U t p q L B w r).card)
    have hR : R.card ≤ M := (OneShortSpider.rich_neighbors_bound G U t p q L B M hf r (g (.inl (.inl false)))
      (fun a he => Sum.inl_ne_inr (g.injective he))).le
    let ev : (template (p+1) (q+1)).Copy G → W := fun f => f (.inl (.inr (.inl j)))
    have hRmap : Set.MapsTo ev F₁ R := by
      intro f hf₁
      have hfF := (mem_filter.mp hf₁).1
      have he : ∀v, f (omitLeftCopy p (q+1) j v)=g v := fun v => congrArg (fun h : (template p (q+1)).Copy G => h v) (mem_filter.mp hf₁).2
      apply mem_filter.mpr
      constructor
      · apply mem_filter.mpr
        refine ⟨hmem f hfF _,?_⟩
        rw [← he (.inl (.inl false))]
        exact f.toHom.map_adj (show (template (p+1) (q+1)).Adj (.inl (.inl false)) (.inl (.inr (.inl j))) from rfl)
      · have hh := hrich f hfF
        have her : (fun a => f (.inr (leftArmMap p (q+1) j a)))=r := by funext a; exact he (.inr a)
        rwa [her] at hh
    have hinner (w : W) (hw : w∈R) : ((F₁.filter (fun f => ev f=w)).card:ℝ) ≤ D := by
      let F₂ := F₁.filter (fun f => ev f=w)
      have hcard : F₂.card ≤ (neighbors G U w).card := by
        apply card_le_card_of_injOn (fun f => f (.inr (.inl j)))
        · intro f hf₂
          have hh := (mem_filter.mp hf₂).2
          refine mem_filter.mpr ⟨hmem f (mem_filter.mp (mem_filter.mp hf₂).1).1 _,?_⟩
          rw [← hh]
          exact f.toHom.map_adj (show (template (p+1) (q+1)).Adj (.inl (.inr (.inl j))) (.inr (.inl j)) from rfl)
        · intro f hf₂ f' hf₂' he
          apply omitLeft_ext G p (q+1) j f f'
          · exact (mem_filter.mp (mem_filter.mp hf₂).1).2.trans (mem_filter.mp (mem_filter.mp hf₂').1).2.symm
          · exact (mem_filter.mp hf₂).2.trans (mem_filter.mp hf₂').2.symm
          · exact he
      exact (show (F₂.card:ℝ) ≤ (neighbors G U w).card by exact_mod_cast hcard).trans
        (hdeg w (mem_filter.mp (mem_filter.mp hw).1).1)
    have hb := RealFiberCount.bound F₁ R ev hRmap hinner
    exact hb.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hR) hD)
  have hb := RealFiberCount.bound F S pre hmap hfiber
  have hs := ConnectedCopyBound.total (template p (q+1)) (connected p (q+1)) G U hD hdeg S
    (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have he : Fintype.card (Interior p (q+1) ⊕ Arms p (q+1))-1=2*(p+q)+3 := by
    simp only [Interior,Arms,Fintype.card_sum,Fintype.card_bool,Fintype.card_fin]; omega
  rw [he] at hs
  calc
    _ ≤ (S.card:ℝ)*((M:ℝ)*D) := hb
    _ ≤ (U.card:ℝ)*D^(2*(p+q)+3)*((M:ℝ)*D) := mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [show 2*(p+q)+4=(2*(p+q)+3)+1 by omega,pow_succ]; ring

end Erdos571.DoubleSpider

/-! One-short-root restrictions of a full double spider. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph

lemma leftArmMap_ne (p q : ℕ) (j : Fin (p+1)) (a : Arms p q) : leftArmMap p q j a≠.inl j := by
  cases a with
  | inl i => exact fun he => Fin.succAbove_ne j i (Sum.inl.inj he)
  | inr k => exact Sum.inr_ne_inl

def oneShortVertex (p q : ℕ) (j : Fin (p+1)) : Interior p q ⊕ Option (Arms p q) → Interior (p+1) q ⊕ Arms (p+1) q
  | .inl a => .inl (Sum.map id (leftArmMap p q j) a)
  | .inr none => .inl (.inr (.inl j))
  | .inr (some a) => .inr (leftArmMap p q j a)

lemma oneShortVertex_injective (p q : ℕ) (j : Fin (p+1)) : Function.Injective (oneShortVertex p q j) := by
  intro u v he
  have hi := leftArmMap_injective p q j
  cases u with
  | inl a => cases v with
    | inl b =>
      exact congrArg Sum.inl ((Sum.map_injective.mpr ⟨Function.injective_id,hi⟩) (Sum.inl.inj he))
    | inr b => cases b with
      | none =>
        cases a with
        | inl c => exact (Sum.inl_ne_inr (Sum.inl.inj he)).elim
        | inr a => exact (leftArmMap_ne p q j a (Sum.inr.inj (Sum.inl.inj he))).elim
      | some b => exact (Sum.inl_ne_inr he).elim
  | inr a => cases a with
    | none => cases v with
      | inl b => cases b with
        | inl c => exact (Sum.inr_ne_inl (Sum.inl.inj he)).elim
        | inr b => exact (leftArmMap_ne p q j b (Sum.inr.inj (Sum.inl.inj he.symm))).elim
      | inr b => cases b with
        | none => rfl
        | some b => exact (Sum.inl_ne_inr he).elim
    | some a => cases v with
      | inl b => exact (Sum.inr_ne_inl he).elim
      | inr b => cases b with
        | none => exact (Sum.inr_ne_inl he).elim
        | some b => exact congrArg (fun a => Sum.inr (some a)) (hi (Sum.inr.inj he))

def oneShortCopy (p q : ℕ) (j : Fin (p+1)) : (OneShortSpider.template p q).Copy (template (p+1) q) where
  toHom :=
    { toFun := oneShortVertex p q j
      map_rel' := by
        intro u v h
        cases u with
        | inl a => cases v with
          | inl b => cases a with
            | inl c => cases b with
              | inl d => exact h
              | inr r =>
                change c=side (leftArmMap p q j r)
                rw [side_leftArmMap]; exact h
            | inr r => cases b with
              | inl c =>
                change side (leftArmMap p q j r)=c
                rw [side_leftArmMap]; exact h
              | inr r' => exact h.elim
          | inr r => cases r with
            | none => change a=.inl false at h; subst a; rfl
            | some r => change a=.inr r at h; subst a; rfl
        | inr r => cases v with
          | inl a => cases r with
            | none => change a=.inl false at h; subst a; rfl
            | some r => change a=.inr r at h; subst a; rfl
          | inr r' => exact h.elim }
  injective' := oneShortVertex_injective p q j

lemma oneShort_ext {W : Type*} (G : SimpleGraph W) (p q : ℕ) (j : Fin (p+1))
    (f g : (template (p+1) q).Copy G)
    (he : f.comp (oneShortCopy p q j)=g.comp (oneShortCopy p q j))
    (hroot : f (.inr (.inl j))=g (.inr (.inl j))) : f=g := by
  apply Copy.ext
  intro v
  have hev (v) := congrArg (fun h : (OneShortSpider.template p q).Copy G => h v) he
  cases v with
  | inl a => cases a with
    | inl c => exact hev (.inl (.inl c))
    | inr a => cases a with
      | inl i =>
        by_cases hi : i=j
        · subst i; exact hev (.inr none)
        · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hi
          exact hev (.inl (.inr (.inl a)))
      | inr k => exact hev (.inl (.inr (.inr k)))
  | inr a => cases a with
    | inl i =>
      by_cases hi : i=j
      · subst i; exact hroot
      · obtain ⟨a,rfl⟩ := Fin.exists_succAbove_eq hi
        exact hev (.inr (some (.inl a)))
    | inr k => exact hev (.inr (some (.inr k)))

lemma left_rightArmMap (p q : ℕ) (i : Fin (p+1)) (j : Fin (q+1)) (a : Arms p q) :
    leftArmMap p (q+1) i (OneShortSpider.rightArmMap p q j a)=bothArmMap p q i j a := by
  cases a <;> rfl

lemma oneShort_good {W : Type} [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q L B : ℕ) (f : (template (p+1) (q+1)).Copy G) (i : Fin (p+1))
    (hmem : ∀v, f v∈U) (hl : ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f)
    (hcore : (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L)
    (htwo : ∀j : Fin (q+1), (TwoShortSpider.fiber G U t p q
      (fun c => if c then f (.inl (.inr (.inr j))) else f (.inl (.inr (.inl i))))
      (fun a => f (.inr (bothArmMap p q i j a)))).card ≤ B) :
    OneShortSpider.GoodCopy G U t p q L B (f.comp (oneShortCopy p (q+1) i)) := by
  refine ⟨(fun v => hmem _),hl.comp _,hcore,?_⟩
  intro j
  have he : (fun a => (f.comp (oneShortCopy p (q+1) i)) (.inr (some (OneShortSpider.rightArmMap p q j a))))=
      (fun a => f (.inr (bothArmMap p q i j a))) := by
    funext a
    change f (.inr (leftArmMap p (q+1) i (OneShortSpider.rightArmMap p q j a)))=_
    rw [left_rightArmMap]
  change (TwoShortSpider.fiber G U t p q _ _).card ≤ B
  rw [he]
  exact htwo j

end Erdos571.DoubleSpider

/-! Rooted counts for core-nonrich double-spider copies. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

lemma core_left_center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Arms p q → W) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inl false))=w)
    (hcap : ∀f∈F, (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => r (.inr j))).card ≤ L) :
    F.card ≤ t^p*L := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  let pr : (template p q).Copy G → (ShortSpider.template q).Copy G := fun f => f.comp (rightShortCopy p q)
  let pl : (template p q).Copy G → (LongSpider.template p).Copy G := fun f => f.comp (leftCopy p q)
  have him : F.image pr ⊆ LongSpider.shortFiber G U t q w (fun j => r (.inr j)) := by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    apply (LongSpider.mem_shortFiber _ _ _ _ _ _ _).mpr
    refine ⟨ShortSpider.good_of_light G U t q (pr f) (fun v => hmem f hf _) ((hl f hf).comp _),hpin f hf,?_⟩
    intro j
    exact hroot f hf (.inr j)
  have hic : (F.image pr).card ≤ L := by
    have hh := hcap f₀ hf₀
    rw [hpin f₀ hf₀] at hh
    exact (card_le_card him).trans hh
  have hfi (g : (ShortSpider.template q).Copy G) (hg : g∈F.image pr) :
      (F.filter (fun f => pr f=g)).card ≤ t^p := by
    let A := F.filter (fun f => pr f=g)
    have hi : Set.InjOn pl A := by
      intro f hf f' hf' he
      exact short_pair_ext G p q f f' he ((mem_filter.mp hf).2.trans (mem_filter.mp hf').2.symm)
    have he : (A.image pl).card=A.card := card_image_of_injOn hi
    rw [← he]
    apply LongSpider.center_count G U t p (A.image pl) (fun i => r (.inl i)) w
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact fun v => hmem f (mem_filter.mp hf).1 _
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact (hl f (mem_filter.mp hf).1).comp _
    · intro g hg i
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact hroot f (mem_filter.mp hf).1 (.inl i)
    · intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact hpin f (mem_filter.mp hf).1
  exact (card_le_mul_card_image F (t^p) hfi).trans (Nat.mul_le_mul_left _ hic)


lemma swap_twice (p q : ℕ) (v : Interior p q ⊕ Arms p q) : swap q p (swap p q v)=v := by
  cases v with
  | inl a => cases a with
    | inl c => cases c <;> rfl
    | inr a => cases a <;> rfl
  | inr a => cases a <;> rfl

lemma comp_swap_injective (G : SimpleGraph W) (p q : ℕ) :
    Function.Injective (fun f : (template p q).Copy G => f.comp (swap q p)) := by
  intro f g he
  apply Copy.ext
  intro v
  have hh := congrArg (fun h : (template q p).Copy G => h (swap p q v)) he
  simpa only [Copy.comp_apply,swap_twice] using hh

lemma core_right_center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Arms p q → W) (w : W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inl true))=w)
    (hcap : ∀f∈F, (LongSpider.shortFiber G U t p (f (.inl (.inl true))) (fun i => r (.inl i))).card ≤ L) :
    F.card ≤ t^q*L := by
  classical
  let sw : (template p q).Copy G → (template q p).Copy G := fun f => f.comp (swap q p)
  rw [← card_image_of_injective F (comp_swap_injective G p q)]
  apply core_left_center_count G U t q p L (F.image sw) (fun a => r a.swap) w
  · intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact fun v => hmem f hf _
  · intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact (hl f hf).comp _
  · intro g hg a
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact hroot f hf a.swap
  · intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact hpin f hf
  · intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact hcap f hf

lemma oneShort_arm_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) → W) (i : Fin (p+1)) (w : W)
    (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (hpin : ∀f∈F, f (.inl (.inr (.inl i)))=w)
    (hgood : ∀f∈F, OneShortSpider.GoodCopy G U t p q L B (f.comp (oneShortCopy p (q+1) i)))
    (hcap : ∀f∈F, (OneShortSpider.fiber G U t p q L B (f (.inl (.inr (.inl i))))
      (fun a => r (leftArmMap p (q+1) i a))).card ≤ T) : F.card ≤ T := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  let pr : (template (p+1) (q+1)).Copy G → (OneShortSpider.template p (q+1)).Copy G :=
    fun f => f.comp (oneShortCopy p (q+1) i)
  have hi : Set.InjOn pr F := by
    intro f hf g hg he
    exact oneShort_ext G p (q+1) i f g he ((hroot f hf _).trans (hroot g hg _).symm)
  have him : F.image pr ⊆ OneShortSpider.fiber G U t p q L B w (fun a => r (leftArmMap p (q+1) i a)) := by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact (OneShortSpider.mem_fiber _ _ _ _ _ _ _ _ _ _).mpr ⟨hgood f hf,hpin f hf,fun a => hroot f hf _⟩
  have hh := hcap f₀ hf₀
  rw [hpin f₀ hf₀] at hh
  rw [← card_image_of_injOn hi]
  exact (card_le_card him).trans hh

end Erdos571.DoubleSpider

/-! Degree-free loads for double spiders after selective nonrich exclusions. -/
set_option maxHeartbeats 2500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

structure CappedSide (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (f : (template (p+1) (q+1)).Copy G) : Prop where
  core : (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L
  arms : ∀i : Fin (p+1), OneShortSpider.GoodCopy G U t p q L B (f.comp (oneShortCopy p (q+1) i)) ∧
    (OneShortSpider.fiber G U t p q L B (f (.inl (.inr (.inl i))))
      (fun a => f (.inr (leftArmMap p (q+1) i a)))).card ≤ T

structure NonrichGoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (f : (template (p+1) (q+1)).Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f
  right : CappedSide G U t p q L B T f
  left : CappedSide G U t q p L B T (f.comp (swap (q+1) (p+1)))

def nonrichLoad (t p q L T : ℕ) : ℕ := (p+q+4)*(t^(p+1)*L+t^(q+1)*L+T+1)

lemma nonrich_vertex_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) → W)
    (hgood : ∀f∈F, NonrichGoodCopy G U t p q L B T f) (hroot : ∀f∈F, ∀a, f (.inr a)=r a)
    (a : Interior (p+1) (q+1)) (w : W) (hpin : ∀f∈F, f (.inl a)=w) :
    F.card ≤ t^(p+1)*L+t^(q+1)*L+T+1 := by
  classical
  cases a with
  | inl c =>
    cases c
    · have hb := core_left_center_count G U t (p+1) (q+1) L F r w
        (fun f hf => (hgood f hf).mem) (fun f hf => (hgood f hf).light) hroot hpin (by
          intro f hf
          simpa only [hroot f hf] using (hgood f hf).right.core)
      omega
    · have hb := core_right_center_count G U t (p+1) (q+1) L F r w
        (fun f hf => (hgood f hf).mem) (fun f hf => (hgood f hf).light) hroot hpin (by
          intro f hf
          have hh := (hgood f hf).left.core
          change (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L at hh
          simpa only [hroot f hf] using hh)
      omega
  | inr a => cases a with
    | inl i =>
      have hb := oneShort_arm_count G U t p q L B T F r i w hroot hpin
        (fun f hf => ((hgood f hf).right.arms i).1) (by
          intro f hf
          simpa only [hroot f hf] using ((hgood f hf).right.arms i).2)
      omega
    | inr j =>
      let sw : (template (p+1) (q+1)).Copy G → (template (q+1) (p+1)).Copy G := fun f => f.comp (swap (q+1) (p+1))
      have hb : (F.image sw).card ≤ T := by
        apply oneShort_arm_count G U t q p L B T (F.image sw) (fun a => r a.swap) j w
        · intro g hg a
          obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
          exact hroot f hf a.swap
        · intro g hg
          obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
          exact hpin f hf
        · intro g hg
          obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
          exact ((hgood f hf).left.arms j).1
        · intro g hg
          obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
          have hh := ((hgood f hf).left.arms j).2
          have he : (fun a => (sw f) (.inr (leftArmMap q (p+1) j a)))=(fun a => r (leftArmMap q (p+1) j a).swap) := by
            funext a; exact hroot f hf _
          change (OneShortSpider.fiber G U t q p L B _ (fun a => (sw f) (.inr (leftArmMap q (p+1) j a)))).card ≤ T at hh
          rwa [he] at hh
      rw [card_image_of_injective F (comp_swap_injective G (p+1) (q+1))] at hb
      omega

lemma nonrich_interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) → W)
    (hgood : ∀f∈F, NonrichGoodCopy G U t p q L B T f) (hroot : ∀f∈F, ∀a, f (.inr a)=r a) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card ≤ nonrichLoad t p q L T := by
  classical
  let A (a : Interior (p+1) (q+1)) := F.filter (fun f => f (.inl a)=w)
  have hs : F.filter (fun f => w∈RootedPacking.interior f) ⊆ univ.biUnion A := by
    intro f hf
    have hw := (mem_filter.mp hf).2
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨(mem_filter.mp hf).1,ha⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hs
    _ ≤ ∑a : Interior (p+1) (q+1), (A a).card := card_biUnion_le
    _ ≤ ∑_a : Interior (p+1) (q+1), (t^(p+1)*L+t^(q+1)*L+T+1) := sum_le_sum (fun a _ =>
      nonrich_vertex_count G U t p q L B T (A a) r (fun f hf => hgood f (mem_filter.mp hf).1)
        (fun f hf => hroot f (mem_filter.mp hf).1) a w (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by
      simp only [sum_const,card_univ,Interior,Arms,Fintype.card_sum,Fintype.card_bool,Fintype.card_fin,nsmul_eq_mul,nonrichLoad,Nat.cast_id]
      congr 1; omega

lemma nonrich_rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T M : ℕ)
    (hf : (graph (p+1) (q+1) M).Free G)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (r : Arms (p+1) (q+1) ↪ W)
    (hgood : ∀f∈F, NonrichGoodCopy G U t p q L B T f) (hroot : ∀f∈F, ∀a, f (.inr a)=r a) :
    F.card < M*(p+q+4)*nonrichLoad t p q L T := by
  classical
  by_contra! hc
  have hcard : M*Fintype.card (Interior (p+1) (q+1))*nonrichLoad t p q L T ≤ F.card := by
    have he : Fintype.card (Interior (p+1) (q+1))=p+q+4 := by simp [Interior,Arms]; omega
    simpa only [he] using hc
  have hcopy := RootedPacking.power_contained_of_bounded_load F id r hroot
    (nonrichLoad t p q L T) M (by unfold nonrichLoad; positivity)
    (nonrich_interior_load G U t p q L B T F r hgood hroot) hcard
  apply hf
  have he : RootedPacking.power (template (p+1) (q+1)) M=graph (p+1) (q+1) M := by
    ext u v; cases u <;> cases v <;> rfl
  rwa [← he]

end Erdos571.DoubleSpider

/-! The sharp global count for selectively capped nonrich double spiders. -/
namespace Erdos571.DoubleSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

lemma nonrich_good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T M : ℕ) (hf : (graph (p+1) (q+1) M).Free G)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (hgood : ∀f∈F, NonrichGoodCopy G U t p q L B T f) :
    F.card ≤ (M*(p+q+4)*nonrichLoad t p q L T)*U.card^(p+q+2) := by
  classical
  let roots : (template (p+1) (q+1)).Copy G → (Arms (p+1) (q+1) → W) := fun f r => f (.inr r)
  have hbound (r : Arms (p+1) (q+1) → W) : (F.filter (fun f => roots f=r)).card ≤ (M*(p+q+4)*nonrichLoad t p q L T) := by
    by_cases hne : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · simp only [not_nonempty_iff_eq_empty.mp hne,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hne
    have hr : Function.Injective r := by
      have he := (mem_filter.mp hf₀).2
      rw [← he]
      exact f₀.injective.comp Sum.inr_injective
    exact (nonrich_rooted_count G U t p q L B T M hf _ ⟨r,hr⟩
      (fun f hf => hgood f (mem_filter.mp hf).1)
      (fun f hf x => congrFun (mem_filter.mp hf).2 x)).le
  have hc := card_le_mul_card_image F ((M*(p+q+4)*nonrichLoad t p q L T)) (fun r _ => hbound r)
  have hi : (F.image roots).card ≤ U.card^(p+q+2) := by
    let f : (F.image roots) → (Arms (p+1) (q+1) → U) := fun r x =>
      ⟨r.val x,by
        obtain ⟨g,hg,he⟩ := mem_image.mp r.property
        rw [← he]
        exact (hgood g hg).mem _⟩
    have hinj : Function.Injective f := by
      intro r r' h
      apply Subtype.ext
      funext x
      exact congrArg Subtype.val (congrFun h x)
    have h := Fintype.card_le_of_injective f hinj
    have he : Fintype.card (Arms (p+1) (q+1))=p+q+2 := by simp [Arms]; omega
    simpa only [Fintype.card_coe,Fintype.card_fun,he] using h
  exact hc.trans (Nat.mul_le_mul_left _ hi)

end Erdos571.DoubleSpider

/-! Side exchange for double-spider powers. -/
namespace Erdos571.DoubleSpider
open SimpleGraph

def swapPower (p q M : ℕ) : (graph p q M).Copy (graph q p M) where
  toHom :=
    { toFun := Sum.map (Prod.map id (Sum.map not Sum.swap)) Sum.swap
      map_rel' := by
        intro u v h
        cases u with
        | inl u => cases v with
          | inl v => exact ⟨h.1,(swap p q).toHom.map_adj h.2⟩
          | inr r => exact (swap p q).toHom.map_adj (show (template p q).Adj (.inl u.2) (.inr r) from h)
        | inr r => cases v with
          | inl v => exact (swap p q).toHom.map_adj (show (template p q).Adj (.inr r) (.inl v.2) from h)
          | inr r' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨Function.injective_id.prodMap
    (Sum.map_injective.mpr ⟨Bool.not_injective,(Equiv.sumComm _ _).injective⟩),(Equiv.sumComm _ _).injective⟩

lemma free_swap {W : Type*} (G : SimpleGraph W) (p q M : ℕ) (hf : (graph p q M).Free G) :
    (graph q p M).Free G := by
  rintro ⟨f⟩
  exact hf ⟨f.comp (swapPower p q M)⟩

end Erdos571.DoubleSpider

/-! The two selective exclusion counts on the opposite side. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma swapped_two_short_arms_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (hf : (graph (p+1) (q+1) M).Free G)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (i : Fin (q+1)) (j : Fin (p+1)) (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, TwoShortSpider.richThreshold t q p M <
      (TwoShortSpider.fiber G U t q p
        (fun c => if c then (f.comp (swap (q+1) (p+1))) (.inl (.inr (.inr j)))
          else (f.comp (swap (q+1) (p+1))) (.inl (.inr (.inl i))))
        (fun a => (f.comp (swap (q+1) (p+1))) (.inr (bothArmMap q p i j a)))).card) :
    (F.card:ℝ) ≤ 4*M*U.card*D^(2*(p+q)+4) := by
  classical
  let sw : (template (p+1) (q+1)).Copy G → (template (q+1) (p+1)).Copy G := fun f => f.comp (swap (q+1) (p+1))
  have hb := two_short_arms_bound G U t q p M (free_swap G (p+1) (q+1) M hf) hD hdeg i j (F.image sw)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact fun v => hmem f hf _)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact hrich f hf)
  rw [card_image_of_injective F (comp_swap_injective G (p+1) (q+1))] at hb
  simpa only [Nat.add_comm q p] using hb

lemma swapped_one_short_arm_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B M : ℕ) (hf : (graph (p+1) (q+1) M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (j : Fin (q+1)) (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, OneShortSpider.richThreshold t q p L B M <
      (OneShortSpider.fiber G U t q p L B ((f.comp (swap (q+1) (p+1))) (.inl (.inr (.inl j))))
        (fun a => (f.comp (swap (q+1) (p+1))) (.inr (leftArmMap q (p+1) j a)))).card) :
    (F.card:ℝ) ≤ (M:ℝ)*U.card*D^(2*(p+q)+4) := by
  classical
  let sw : (template (p+1) (q+1)).Copy G → (template (q+1) (p+1)).Copy G := fun f => f.comp (swap (q+1) (p+1))
  have hb := one_short_arm_bound G U t q p L B M (free_swap G (p+1) (q+1) M hf) hD hdeg j (F.image sw)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact fun v => hmem f hf _)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact hrich f hf)
  rw [card_image_of_injective F (comp_swap_injective G (p+1) (q+1))] at hb
  simpa only [Nat.add_comm q p] using hb

end Erdos571.DoubleSpider

/-! A finite-family cleaning inequality with explicit error bounds. -/
namespace Erdos571.FinsetCleaning
open Finset

lemma bound {I A : Type*} [Fintype I] [DecidableEq A] (F : Finset A) (P : I → A → Prop)
    [∀i, DecidablePred (P i)] [DecidablePred (fun a => ∀i, P i a)] {E : ℝ}
    (hb : ∀i, ((F.filter (fun a => ¬P i a)).card:ℝ) ≤ E) :
    (F.card:ℝ) ≤ (F.filter (fun a => ∀i, P i a)).card+Fintype.card I*E := by
  classical
  let good := F.filter (fun a => ∀i, P i a)
  let bad (i : I) := F.filter (fun a => ¬P i a)
  have hs : F ⊆ good ∪ univ.biUnion bad := by
    intro a ha
    by_cases h : ∀i, P i a
    · exact mem_union_left _ (mem_filter.mpr ⟨ha,h⟩)
    · push_neg at h
      obtain ⟨i,hi⟩ := h
      exact mem_union_right _ (mem_biUnion.mpr ⟨i,mem_univ _,mem_filter.mpr ⟨ha,hi⟩⟩)
  have hc : F.card ≤ good.card+∑i : I, (bad i).card :=
    (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_left card_biUnion_le _))
  have hr : (F.card:ℝ) ≤ (good.card:ℝ)+∑i : I, ((bad i).card:ℝ) := by exact_mod_cast hc
  have hb' : (∑i : I, ((bad i).card:ℝ)) ≤ Fintype.card I*E := by
    calc
      _ ≤ ∑_i : I, E := sum_le_sum (fun i _ => hb i)
      _ = _ := by simp
  exact hr.trans (add_le_add (le_refl _) hb')

end Erdos571.FinsetCleaning

/-! All light copies with both core completions capped admit sharp counting plus a lower-order error. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

abbrev CleanIndex (p q : ℕ) := ((Fin (p+1) × Fin (q+1)) ⊕ Fin (p+1)) ⊕ ((Fin (q+1) × Fin (p+1)) ⊕ Fin (q+1))

def Accept (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (f : (template (p+1) (q+1)).Copy G) : CleanIndex p q → Prop
  | .inl (.inl (i,j)) => (TwoShortSpider.fiber G U t p q
      (fun c => if c then f (.inl (.inr (.inr j))) else f (.inl (.inr (.inl i))))
      (fun a => f (.inr (bothArmMap p q i j a)))).card ≤ B
  | .inl (.inr i) => (OneShortSpider.fiber G U t p q L B (f (.inl (.inr (.inl i))))
      (fun a => f (.inr (leftArmMap p (q+1) i a)))).card ≤ T
  | .inr (.inl (i,j)) => (TwoShortSpider.fiber G U t q p
      (fun c => if c then (f.comp (swap (q+1) (p+1))) (.inl (.inr (.inr j)))
        else (f.comp (swap (q+1) (p+1))) (.inl (.inr (.inl i))))
      (fun a => (f.comp (swap (q+1) (p+1))) (.inr (bothArmMap q p i j a)))).card ≤ B
  | .inr (.inr j) => (OneShortSpider.fiber G U t q p L B ((f.comp (swap (q+1) (p+1))) (.inl (.inr (.inl j))))
      (fun a => (f.comp (swap (q+1) (p+1))) (.inr (leftArmMap q (p+1) j a)))).card ≤ T

lemma nonrich_good_of_accept (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T : ℕ)
    (f : (template (p+1) (q+1)).Copy G) (hmem : ∀v, f v∈U)
    (hl : ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f)
    (hR : (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L)
    (hL : (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L)
    (ha : ∀idx, Accept G U t p q L B T f idx) : NonrichGoodCopy G U t p q L B T f := by
  refine ⟨hmem,hl,⟨hR,?_⟩,⟨hL,?_⟩⟩
  · intro i
    exact ⟨oneShort_good G U t p q L B f i hmem hl hR (fun j => ha (.inl (.inl (i,j)))),ha (.inl (.inr i))⟩
  · intro j
    exact ⟨oneShort_good G U t q p L B (f.comp (swap (q+1) (p+1))) j (fun v => hmem _) (hl.comp _) hL
      (fun i => ha (.inr (.inl (j,i)))),ha (.inr (.inr j))⟩

/-- This theorem has no assumed survival of selective exclusions. It applies
 to all light copies with nonrich core completions on both sides. -/
theorem nonrich_light_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T M : ℕ)
    (hf : (graph (p+1) (q+1) M).Free G)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f)
    (hR : ∀f∈F, (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L)
    (hL : ∀f∈F, (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L) :
    (F.card:ℝ) ≤ ((M*(p+q+4)*nonrichLoad t p q L T:ℕ):ℝ)*U.card^(p+q+2)+
      ((2*(p+1)*(q+1)+p+q+2:ℕ):ℝ)*(4*M*U.card*D^(2*(p+q)+4)) := by
  classical
  have hD0 : 0 ≤ D := by linarith
  have hb (idx : CleanIndex p q) :
      ((F.filter (fun f => ¬Accept G U t p q L B T f idx)).card:ℝ) ≤ 4*M*U.card*D^(2*(p+q)+4) := by
    cases idx with
    | inl idx => cases idx with
      | inl ij =>
        exact two_short_arms_bound G U t p q M hf hD hdeg ij.1 ij.2 _
          (fun f hf => hmem f (mem_filter.mp hf).1)
          (fun f hf => lt_of_le_of_lt hB (Nat.lt_of_not_ge (mem_filter.mp hf).2))
      | inr i =>
        have he := one_short_arm_bound G U t p q L B M hf hD0 hdeg i (F.filter (fun f => ¬Accept G U t p q L B T f (.inl (.inr i))))
          (fun f hf => hmem f (mem_filter.mp hf).1)
          (fun f hf => lt_of_le_of_lt hT (Nat.lt_of_not_ge (mem_filter.mp hf).2))
        apply he.trans
        have hn : 0 ≤ (M:ℝ)*U.card*D^(2*(p+q)+4) := by positivity
        nlinarith
    | inr idx => cases idx with
      | inl ij =>
        exact swapped_two_short_arms_bound G U t p q M hf hD hdeg ij.1 ij.2 _
          (fun f hf => hmem f (mem_filter.mp hf).1)
          (fun f hf => lt_of_le_of_lt hB' (Nat.lt_of_not_ge (mem_filter.mp hf).2))
      | inr j =>
        have he := swapped_one_short_arm_bound G U t p q L B M hf hD0 hdeg j (F.filter (fun f => ¬Accept G U t p q L B T f (.inr (.inr j))))
          (fun f hf => hmem f (mem_filter.mp hf).1)
          (fun f hf => lt_of_le_of_lt hT' (Nat.lt_of_not_ge (mem_filter.mp hf).2))
        apply he.trans
        have hn : 0 ≤ (M:ℝ)*U.card*D^(2*(p+q)+4) := by positivity
        nlinarith
  let F₀ := F.filter (fun f => ∀idx, Accept G U t p q L B T f idx)
  have hg := nonrich_good_count G U t p q L B T M hf F₀ (by
    intro f hf
    have hff := (mem_filter.mp hf).1
    exact nonrich_good_of_accept G U t p q L B T f (hmem f hff) (hl f hff) (hR f hff) (hL f hff) (mem_filter.mp hf).2)
  have hg' : (F₀.card:ℝ) ≤ ((M*(p+q+4)*nonrichLoad t p q L T:ℕ):ℝ)*U.card^(p+q+2) := by exact_mod_cast hg
  have hc := FinsetCleaning.bound F (fun idx f => Accept G U t p q L B T f idx) hb
  have hi : Fintype.card (CleanIndex p q)=2*(p+1)*(q+1)+p+q+2 := by
    simp only [CleanIndex,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    ring
  rw [hi] at hc
  exact hc.trans (add_le_add hg' (le_refl _))

end Erdos571.DoubleSpider

/-! Absorbing one lower degree power in an almost-regular copy count. -/
namespace Erdos571.LowerOrderAbsorption

lemma power_bound (k s : ℕ) {n d A E c : ℝ} (hn : 0 < n) (hd : 0 ≤ d) (hc : 0 < c)
    (hlarge : 2*E ≤ c*d)
    (hcount : c*n*d^(k+1) ≤ A*n^(s+1)+E*n*d^k) :
    d^(k+1) ≤ (2*A/c)*n^s := by
  have he := mul_le_mul_of_nonneg_right hlarge (show 0 ≤ n*d^k by positivity)
  have hp : c*n*d^(k+1) ≤ 2*A*n^(s+1) := by
    rw [pow_succ] at hcount ⊢
    nlinarith
  apply (mul_le_mul_iff_right₀ (mul_pos hc hn)).mp
  have hr : (2*A/c)*n^s*(c*n)=2*A*n^(s+1) := by rw [pow_succ]; field_simp
  rw [← hr] at hp
  nlinarith

lemma degree_bound (k s : ℕ) {n d A E c : ℝ} (hn : 0 < n) (hd : 0 ≤ d) (hA : 0 ≤ A) (hc : 0 < c)
    (hlarge : 2*E ≤ c*d)
    (hcount : c*n*d^(k+1) ≤ A*n^(s+1)+E*n*d^k) :
    d ≤ (2*A/c)^(((k+1:ℕ):ℝ)⁻¹)*n^((s:ℝ)/((k+1:ℕ):ℝ)) := by
  exact LongSpider.degree_of_power (k+1) s (by omega) hn.le hd (by positivity)
    (power_bound k s hn hd hc hlarge hcount)

end Erdos571.LowerOrderAbsorption

/-! A sharp degree estimate when sufficiently many core-nonrich light copies occur. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def nonrichErrorCoeff (p q M : ℕ) (Q : ℝ) : ℝ :=
  ((2*(p+1)*(q+1)+p+q+2:ℕ):ℝ)*4*M*Q^(2*(p+q)+4)

lemma degree_of_many_nonrich (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t p q L B T M : ℕ) (hf : (graph (p+1) (q+1) M).Free G)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 1 ≤ d)
    (hlarge : 4*4^(2*(p+q)+5)*nonrichErrorCoeff p q M Q ≤ d)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f)
    (hR : ∀f∈F, (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L)
    (hL : ∀f∈F, (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L)
    (hmany : (U.card:ℝ)*(d/4)^(2*(p+q)+5)/2 ≤ F.card) :
    d ≤ (4*4^(2*(p+q)+5)*(M*(p+q+4)*nonrichLoad t p q L T:ℕ))^(((2*(p+q)+5:ℕ):ℝ)⁻¹)*
      (U.card:ℝ)^(((p+q+1:ℕ):ℝ)/((2*(p+q)+5:ℕ):ℝ)) := by
  have hn : (0:ℝ) < U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 1 ≤ Q*d := by nlinarith
  have hu := nonrich_light_count G U t p q L B T M hf hB hB' hT hT' hD hdeg F hmem hl hR hL
  let A : ℝ := (M*(p+q+4)*nonrichLoad t p q L T:ℕ)
  let E := nonrichErrorCoeff p q M Q
  let c : ℝ := 1/(2*4^(2*(p+q)+5))
  have hc : 0 < c := by dsimp [c]; positivity
  have hbig : 2*E ≤ c*d := by
    dsimp only [c,E]
    rw [one_div_mul_eq_div,le_div_iff₀ (by positivity : 0 < (2:ℝ)*4^(2*(p+q)+5))]
    nlinarith
  have he : ((2*(p+1)*(q+1)+p+q+2:ℕ):ℝ)*(4*M*U.card*(Q*d)^(2*(p+q)+4))=
      E*U.card*d^(2*(p+q)+4) := by rw [mul_pow]; dsimp [E,nonrichErrorCoeff]; ring
  rw [he] at hu
  have hlower : c*U.card*d^(2*(p+q)+5) ≤ F.card := by
    convert hmany using 1
    dsimp [c]
    rw [div_pow]
    field_simp
  have hh : c*U.card*d^((2*(p+q)+4)+1) ≤ A*(U.card:ℝ)^((p+q+1)+1)+E*U.card*d^(2*(p+q)+4) := by
    simpa only [show 2*(p+q)+4+1=2*(p+q)+5 by omega,show p+q+1+1=p+q+2 by omega] using hlower.trans hu
  have hb := LowerOrderAbsorption.degree_bound (2*(p+q)+4) (p+q+1) hn (show 0 ≤ d by linarith)
    (show 0 ≤ A by dsimp [A]; positivity) hc hbig hh
  have hcoef : 2*A/c=4*4^(2*(p+q)+5)*(M*(p+q+4)*nonrichLoad t p q L T:ℕ) := by
    dsimp [A,c]; field_simp; ring
  simpa only [hcoef,show 2*(p+q)+4+1=2*(p+q)+5 by omega] using hb

end Erdos571.DoubleSpider

/-! Global real-valued copy counts from uniform rooted-fiber bounds. -/
namespace Erdos571.RootedFiberCount
open Finset SimpleGraph

lemma bound {A R W : Type} [Fintype R] [DecidableEq W]
    (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W) (U : Finset W) (F : Finset (H.Copy G))
    (hmem : ∀f∈F, ∀r, f (.inr r)∈U) {B : ℝ} (hB : 0 ≤ B)
    (hbound : ∀r : R ↪ W, ∀F' : Finset (H.Copy G), F'⊆F →
      (∀f∈F', ∀a, f (.inr a)=r a) → (F'.card:ℝ) ≤ B) :
    (F.card:ℝ) ≤ B*(U.card:ℝ)^(Fintype.card R) := by
  classical
  let roots : H.Copy G → R → W := fun f r => f (.inr r)
  have hfiber (r : R → W) (hr : r∈F.image roots) : ((F.filter (fun f => roots f=r)).card:ℝ) ≤ B := by
    obtain ⟨f₀,hf₀,he⟩ := mem_image.mp hr
    have hi : Function.Injective r := by rw [← he]; exact f₀.injective.comp Sum.inr_injective
    exact hbound ⟨r,hi⟩ _ (filter_subset _ _) (fun f hf a => congrFun (mem_filter.mp hf).2 a)
  have hc := RealFiberCount.bound F (F.image roots) roots (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩) hfiber
  have hi : (F.image roots).card ≤ U.card^(Fintype.card R) := by
    let val : (F.image roots) → (R → U) := fun r a => ⟨r.val a,by
      obtain ⟨f,hf,he⟩ := mem_image.mp r.property
      rw [← he]
      exact hmem f hf a⟩
    have hinj : Function.Injective val := by
      intro r r' he
      apply Subtype.ext
      funext a
      exact congrArg Subtype.val (congrFun he a)
    simpa only [Fintype.card_coe,Fintype.card_fun] using Fintype.card_le_of_injective val hinj
  have hi' : ((F.image roots).card:ℝ) ≤ (U.card:ℝ)^Fintype.card R := by exact_mod_cast hi
  calc
    _ ≤ ((F.image roots).card:ℝ)*B := hc
    _ ≤ (U.card:ℝ)^Fintype.card R*B := mul_le_mul_of_nonneg_right hi' hB
    _ = _ := mul_comm _ _

end Erdos571.RootedFiberCount

/-! Global rich-core counts, with the unresolved degree factor kept explicit. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_global_after_nested (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) q).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) q) G U t f)
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card)
    (hcap : ∀f∈F, ∀j, (nestedFiber G U t p q M (f (.inl (.inr (.inl j))))
      (fun a => f (.inr (leftArmMap p q j a)))).card ≤ nestedThreshold t p q M) :
    (F.card:ℝ) ≤ (M*(p+2)*nestedLoad t p q M:ℕ)*((t:ℝ)^q*D)*(U.card:ℝ)^(p+q+1) := by
  have hb := RootedFiberCount.bound (template (p+1) q) G U F (fun f hf a => hmem f hf _)
    (show 0 ≤ ((M*(p+2)*nestedLoad t p q M:ℕ):ℝ)*((t:ℝ)^q*D) by positivity) (by
      intro r F' hsub hroot
      apply rich_copies_after_nested G U t p q M ht hf hD hdeg F' r
        (fun f hf => hmem f (hsub hf)) (fun f hf => hl f (hsub hf)) hroot
      · intro f hf
        simpa only [hroot f hf] using hrich f (hsub hf)
      · intro f hf; exact hcap f (hsub hf))
  have he : Fintype.card (Arms (p+1) q)=p+q+1 := by simp only [Arms,Fintype.card_sum,Fintype.card_fin]; omega
  simpa only [he] using hb

/-- Nested exclusions have a proved lower-order loss. Only the leading
rich-completion term still carries a maximum-degree factor. -/
theorem rich_light_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) q).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) q) G U t f)
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card) :
    (F.card:ℝ) ≤ (M*(p+2)*nestedLoad t p q M:ℕ)*((t:ℝ)^q*D)*(U.card:ℝ)^(p+q+1)+
      (p+1:ℕ)*((M:ℝ)*U.card*D^(2*(p+q)+2)) := by
  classical
  let P (j : Fin (p+1)) (f : (template (p+1) q).Copy G) : Prop :=
    (nestedFiber G U t p q M (f (.inl (.inr (.inl j))))
      (fun a => f (.inr (leftArmMap p q j a)))).card ≤ nestedThreshold t p q M
  let F₀ := F.filter (fun f => ∀j, P j f)
  have hb (j : Fin (p+1)) : ((F.filter (fun f => ¬P j f)).card:ℝ) ≤ (M:ℝ)*U.card*D^(2*(p+q)+2) :=
    nested_arm_bound G U t p q M ht hf hD hdeg j _
      (fun f hf => hmem f (mem_filter.mp hf).1)
      (fun f hf => Nat.lt_of_not_ge (mem_filter.mp hf).2)
  have hc := FinsetCleaning.bound F P hb
  have hg := rich_global_after_nested G U t p q M ht hf hD hdeg F₀
    (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
    (fun f hf => hrich f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  simpa only [Fintype.card_fin] using hc.trans (add_le_add hg (le_refl _))

end Erdos571.DoubleSpider

/-! A count of every light double-spider copy, keeping the rich-core loss explicit. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def lightMainCoeff (t p q L T M : ℕ) : ℕ :=
  M*(p+q+4)*nonrichLoad t p q L T+
  M*(p+2)*nestedLoad t p (q+1) M*t^(q+1)+
  M*(q+2)*nestedLoad t q (p+1) M*t^(p+1)

def lightErrorCoeff (p q M : ℕ) : ℕ :=
  (4*(2*(p+1)*(q+1)+p+q+2)+(p+q+2))*M

lemma swapped_rich_light_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f)
    (hrich : ∀f∈F, completionThreshold t (q+1) (p+1) M <
      (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card) :
    (F.card:ℝ) ≤ (M*(q+2)*nestedLoad t q (p+1) M:ℕ)*((t:ℝ)^(p+1)*D)*(U.card:ℝ)^(p+q+2)+
      (q+1:ℕ)*((M:ℝ)*U.card*D^(2*(p+q)+4)) := by
  classical
  let sw : (template (p+1) (q+1)).Copy G → (template (q+1) (p+1)).Copy G := fun f => f.comp (swap (q+1) (p+1))
  have hb := rich_light_count G U t q (p+1) M ht (free_swap G (p+1) (q+1) M hf) hD hdeg (F.image sw)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact fun v => hmem f hf _)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact (hl f hf).comp _)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact hrich f hf)
  rw [card_image_of_injective F (comp_swap_injective G (p+1) (q+1))] at hb
  simpa only [show q+(p+1)+1=p+q+2 by omega,show 2*(q+(p+1))+2=2*(p+q)+4 by omega] using hb

/-- No core cap or selective-exclusion assumption is imposed on `F` here.
The leading term is still one maximum-degree factor larger than the sharp count. -/
theorem all_light_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q L B T M : ℕ)
    (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    (hL : completionThreshold t (p+1) (q+1) M ≤ L) (hL' : completionThreshold t (q+1) (p+1) M ≤ L)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f) :
    (F.card:ℝ) ≤ (lightMainCoeff t p q L T M:ℝ)*D*(U.card:ℝ)^(p+q+2)+
      (lightErrorCoeff p q M:ℝ)*U.card*D^(2*(p+q)+4) := by
  classical
  have hD0 : 0 ≤ D := by linarith
  let R (f : (template (p+1) (q+1)).Copy G) :=
    (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L
  let Lf (f : (template (p+1) (q+1)).Copy G) :=
    (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L
  let F₀ := F.filter (fun f => R f ∧ Lf f)
  let FR := F.filter (fun f => ¬R f)
  let FL := F.filter (fun f => ¬Lf f)
  have hs : F ⊆ F₀ ∪ FR ∪ FL := by
    intro f hf
    by_cases hr : R f
    · by_cases hl : Lf f
      · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hr,hl⟩))
      · exact mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩)
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hr⟩))
  have hcard : F.card ≤ F₀.card+FR.card+FL.card := (card_le_card hs).trans
    ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hcard' : (F.card:ℝ) ≤ (F₀.card:ℝ)+FR.card+FL.card := by exact_mod_cast hcard
  have h₀ := nonrich_light_count G U t p q L B T M hf hB hB' hT hT' hD hdeg F₀
    (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
    (fun f hf => (mem_filter.mp hf).2.1) (fun f hf => (mem_filter.mp hf).2.2)
  have hR := rich_light_count G U t p (q+1) M ht hf hD0 hdeg FR
    (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
    (fun f hf => lt_of_le_of_lt hL (Nat.lt_of_not_ge (mem_filter.mp hf).2))
  rw [show p+(q+1)+1=p+q+2 by omega,show 2*(p+(q+1))+2=2*(p+q)+4 by omega] at hR
  have hLr := swapped_rich_light_count G U t p q M ht hf hD0 hdeg FL
    (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
    (fun f hf => lt_of_le_of_lt hL' (Nat.lt_of_not_ge (mem_filter.mp hf).2))
  have hmain : ((M*(p+q+4)*nonrichLoad t p q L T:ℕ):ℝ)*(U.card:ℝ)^(p+q+2) ≤
      ((M*(p+q+4)*nonrichLoad t p q L T:ℕ):ℝ)*D*(U.card:ℝ)^(p+q+2) := by
    nlinarith [mul_le_mul_of_nonneg_left hD
      (show 0 ≤ ((M*(p+q+4)*nonrichLoad t p q L T:ℕ):ℝ)*(U.card:ℝ)^(p+q+2) by positivity)]
  dsimp only [lightMainCoeff,lightErrorCoeff]
  push_cast at h₀ hR hLr hmain ⊢
  nlinarith

end Erdos571.DoubleSpider

/-! The unconditional degree estimate obtainable from the current all-light count. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- The denominator here is one smaller than the conjectured sharp denominator.
This explicitly records the remaining rich-core degree loss. -/
lemma degree_of_many_light (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t p q L B T M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    (hL : completionThreshold t (p+1) (q+1) M ≤ L) (hL' : completionThreshold t (q+1) (p+1) M ≤ L)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 1 ≤ d)
    (hlarge : 4*4^(2*(p+q)+5)*(lightErrorCoeff p q M:ℝ)*Q^(2*(p+q)+4) ≤ d)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (F : Finset ((template (p+1) (q+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f)
    (hmany : (U.card:ℝ)*(d/4)^(2*(p+q)+5)/2 ≤ F.card) :
    d ≤ (4*4^(2*(p+q)+5)*(lightMainCoeff t p q L T M:ℝ)*Q)^(((2*(p+q)+4:ℕ):ℝ)⁻¹)*
      (U.card:ℝ)^(((p+q+1:ℕ):ℝ)/((2*(p+q)+4:ℕ):ℝ)) := by
  have hn : (0:ℝ) < U.card := by exact_mod_cast card_pos.mpr hU
  have hd0 : 0 < d := by linarith
  have hD : 1 ≤ Q*d := by nlinarith
  have hu := all_light_count G U t p q L B T M ht hf hL hL' hB hB' hT hT' hD hdeg F hmem hl
  let A : ℝ := (lightMainCoeff t p q L T M:ℝ)*Q
  let E : ℝ := (lightErrorCoeff p q M:ℝ)*Q^(2*(p+q)+4)
  let c : ℝ := 1/(2*4^(2*(p+q)+5))
  have hc : 0 < c := by dsimp [c]; positivity
  have hbig : 2*E ≤ c*d := by
    dsimp only [c,E]
    rw [one_div_mul_eq_div,le_div_iff₀ (by positivity : 0 < (2:ℝ)*4^(2*(p+q)+5))]
    nlinarith
  have hlower : c*U.card*d^(2*(p+q)+5) ≤ F.card := by
    convert hmany using 1
    dsimp [c]; rw [div_pow]; field_simp
  have hh : c*U.card*d^((2*(p+q)+3)+1) ≤ A*(U.card:ℝ)^((p+q+1)+1)+E*U.card*d^(2*(p+q)+3) := by
    apply (mul_le_mul_iff_right₀ hd0).mp
    have he₁ : c*U.card*d^((2*(p+q)+3)+1)*d=c*U.card*d^(2*(p+q)+5) := by
      rw [show 2*(p+q)+5=((2*(p+q)+3)+1)+1 by omega,pow_succ]; ring
    have he₂ : (A*(U.card:ℝ)^((p+q+1)+1)+E*U.card*d^(2*(p+q)+3))*d=
        (lightMainCoeff t p q L T M:ℝ)*(Q*d)*(U.card:ℝ)^(p+q+2)+
          (lightErrorCoeff p q M:ℝ)*U.card*(Q*d)^(2*(p+q)+4) := by
      dsimp [A,E]
      rw [mul_pow,show 2*(p+q)+4=(2*(p+q)+3)+1 by omega,pow_succ d,show p+q+1+1=p+q+2 by omega]
      ring
    conv_lhs => rw [mul_comm]
    conv_rhs => rw [mul_comm]
    rw [he₁,he₂]
    exact hlower.trans hu
  have hb := LowerOrderAbsorption.degree_bound (2*(p+q)+3) (p+q+1) hn hd0.le
    (show 0 ≤ A by dsimp [A]; positivity) hc hbig hh
  have hcoef : 2*A/c=4*4^(2*(p+q)+5)*(lightMainCoeff t p q L T M:ℝ)*Q := by dsimp [A,c]; field_simp; ring
  simpa only [hcoef,show 2*(p+q)+3+1=2*(p+q)+4 by omega] using hb

lemma bounded_codegree_degree_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t p q L B T M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    (hL : completionThreshold t (p+1) (q+1) M ≤ L) (hL' : completionThreshold t (q+1) (p+1) M ≤ L)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 1 ≤ d) (hdsize : 4*(2*p+2*q+7:ℕ) ≤ d)
    (hlarge : 4*4^(2*(p+q)+5)*(lightErrorCoeff p q M:ℝ)*Q^(2*(p+q)+4) ≤ d)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card < t) :
    d ≤ (4*4^(2*(p+q)+5)*(lightMainCoeff t p q L T M:ℝ)*Q)^(((2*(p+q)+4:ℕ):ℝ)⁻¹)*
      (U.card:ℝ)^(((p+q+1:ℕ):ℝ)/((2*(p+q)+4:ℕ):ℝ)) := by
  let F := TreeCopiesIn.copies (template (p+1) (q+1)) G U
  have hmem : ∀f∈F, ∀v, f v∈U := fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf
  apply degree_of_many_light G U hU t p q L B T M ht hf hL hL' hB hB' hT hT' hQ hd hlarge
    (fun v hv => (hdeg v hv).2) F hmem
  · intro f hf u v w huv hvw huw
    exact hcodeg (f u) (hmem f hf u) (f w) (hmem f hf w) (f.injective.ne huw)
  · have hb := all_copies_lower G U p q hdsize (fun v hv => (hdeg v hv).1)
    have he : 2*p+2*q+5=2*(p+q)+5 := by omega
    rw [he] at hb
    have hn : 0 ≤ (U.card:ℝ)*(d/4)^(2*(p+q)+5) := by positivity
    change _ ≤ (F.card:ℝ)
    linarith

end Erdos571.DoubleSpider

/-! Short-spider powers have no four-cycle: distinct vertices have at most one common neighbor. -/
set_option maxHeartbeats 4000000
namespace Erdos571.ShortSpider
open Finset SimpleGraph
attribute [local instance] Classical.propDecidable

lemma adj_short_iff (s N : ℕ) (v : (Fin N × Option (Fin s)) ⊕ Option (Fin s)) :
    (graph s N).Adj (.inr none) v ↔ ∃i, v=.inl (i,none) := by
  rcases v with ⟨i,a⟩|r
  · cases a <;> simp [graph,FullRootedPower.graph,template]
  · cases r <;> simp [graph,FullRootedPower.graph,template]

lemma adj_center_iff (s N : ℕ) (i : Fin N) (v : (Fin N × Option (Fin s)) ⊕ Option (Fin s)) :
    (graph s N).Adj (.inl (i,none)) v ↔ v=.inr none ∨ ∃j, v=.inl (i,some j) := by
  rcases v with ⟨k,a⟩|r
  · cases a <;> simp [graph,FullRootedPower.graph,template,eq_comm]
  · cases r <;> simp [graph,FullRootedPower.graph,template,eq_comm]

lemma adj_middle_iff (s N : ℕ) (i : Fin N) (j : Fin s) (v : (Fin N × Option (Fin s)) ⊕ Option (Fin s)) :
    (graph s N).Adj (.inl (i,some j)) v ↔ v=.inl (i,none) ∨ v=.inr (some j) := by
  rcases v with ⟨k,a⟩|r
  · cases a <;> simp [graph,FullRootedPower.graph,template,eq_comm]
  · cases r <;> simp [graph,FullRootedPower.graph,template,eq_comm]

lemma adj_long_iff (s N : ℕ) (j : Fin s) (v : (Fin N × Option (Fin s)) ⊕ Option (Fin s)) :
    (graph s N).Adj (.inr (some j)) v ↔ ∃i, v=.inl (i,some j) := by
  rcases v with ⟨i,a⟩|r
  · cases a <;> simp [graph,FullRootedPower.graph,template,eq_comm]
  · cases r <;> simp [graph,FullRootedPower.graph,template]

lemma unique_common (s N : ℕ) (u v w z : (Fin N × Option (Fin s)) ⊕ Option (Fin s))
    (huv : u≠v) (huw : (graph s N).Adj u w) (hvw : (graph s N).Adj v w)
    (huz : (graph s N).Adj u z) (hvz : (graph s N).Adj v z) : w=z := by
  rcases u with ⟨i,a⟩|r
  · cases a with
    | none =>
      rw [adj_center_iff] at huw huz
      rcases huw with rfl|⟨j,rfl⟩ <;> rcases huz with rfl|⟨k,rfl⟩
      all_goals rcases v with ⟨l,b⟩|r
      all_goals first | cases b | cases r
      all_goals simp_all [graph,FullRootedPower.graph,template]
    | some a =>
      rw [adj_middle_iff] at huw huz
      rcases huw with rfl|rfl <;> rcases huz with rfl|rfl
      all_goals rcases v with ⟨l,b⟩|r
      all_goals first | cases b | cases r
      all_goals simp_all [graph,FullRootedPower.graph,template]
  · cases r with
    | none =>
      obtain ⟨j,rfl⟩ := (adj_short_iff s N w).mp huw
      obtain ⟨k,rfl⟩ := (adj_short_iff s N z).mp huz
      rcases v with ⟨l,b⟩|r
      all_goals first | cases b | cases r
      all_goals simp_all [graph,FullRootedPower.graph,template]
    | some r =>
      obtain ⟨j,rfl⟩ := (adj_long_iff s N r w).mp huw
      obtain ⟨k,rfl⟩ := (adj_long_iff s N r z).mp huz
      rcases v with ⟨l,b⟩|r'
      all_goals first | cases b | cases r'
      all_goals simp_all [graph,FullRootedPower.graph,template]

lemma common_card_le_one (s N : ℕ) (U : Finset ((Fin N × Option (Fin s)) ⊕ Option (Fin s)))
    (u v : (Fin N × Option (Fin s)) ⊕ Option (Fin s)) (huv : u≠v) :
    (FourthMoment.common (graph s N) U u v).card ≤ 1 := by
  classical
  apply card_le_one.mpr
  intro w hw z hz
  exact unique_common s N u v w z huv (mem_filter.mp hw).2.1 (mem_filter.mp hw).2.2
    (mem_filter.mp hz).2.1 (mem_filter.mp hz).2.2

end Erdos571.ShortSpider

/-! A structural obstruction to degree-free bounds on every fixed-root fiber. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpider.FiberObstruction
open Finset SimpleGraph
attribute [local instance] Classical.propDecidable

abbrev Host (p q N : ℕ) := (Fin (p+N) × Option (Fin q)) ⊕ Option (Fin q)

def value (p q N : ℕ) (a₀ : Fin q) (k : Fin N) : Interior p q ⊕ Arms p q → Host p q N
  | .inl (.inl false) => .inr none
  | .inl (.inl true) => .inl (finSumFinEquiv (.inr k),none)
  | .inl (.inr (.inl i)) => .inl (finSumFinEquiv (.inl i),none)
  | .inl (.inr (.inr j)) => .inl (finSumFinEquiv (.inr k),some j)
  | .inr (.inl i) => .inl (finSumFinEquiv (.inl i),some a₀)
  | .inr (.inr j) => .inr (some j)

lemma value_injective (p q N : ℕ) (a₀ : Fin q) (k : Fin N) : Function.Injective (value p q N a₀ k) := by
  intro u v he
  have hi := (finSumFinEquiv (m:=p) (n:=N)).injective
  rcases u with (c|(i|j))|(i|j) <;> rcases v with (d|(i'|j'))|(i'|j')
  all_goals try cases c
  all_goals try cases d
  all_goals simp_all only [value,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,Sum.inr_ne_inl,
    Prod.mk.injEq,Option.some.injEq,Option.some_ne_none,hi.eq_iff,
    and_true,true_and,and_false,false_and]
  all_goals simp_all

def copy (p q N : ℕ) (a₀ : Fin q) (k : Fin N) : (template p q).Copy (ShortSpider.graph q (p+N)) where
  toHom :=
    { toFun := value p q N a₀ k
      map_rel' := by
        intro u v h
        cases u with
        | inl a => cases v with
          | inl b => cases a with
            | inl c => cases b with
              | inl d =>
                change c≠d at h
                cases c <;> cases d
                · exact (h rfl).elim
                · rfl
                · rfl
                · exact (h rfl).elim
              | inr r =>
                change c=side r at h
                subst c
                cases r with
                | inl i => rfl
                | inr j => exact ⟨rfl,trivial⟩
            | inr r => cases b with
              | inl c =>
                change side r=c at h
                subst c
                cases r with
                | inl i => rfl
                | inr j => exact ⟨rfl,trivial⟩
              | inr r' => exact h.elim
          | inr r =>
            change a=.inr r at h
            subst a
            cases r with
            | inl i => exact ⟨rfl,trivial⟩
            | inr j => rfl
        | inr r => cases v with
          | inl a =>
            change a=.inr r at h
            subst a
            cases r with
            | inl i => exact ⟨rfl,trivial⟩
            | inr j => rfl
          | inr r' => exact h.elim }
  injective' := value_injective p q N a₀ k

lemma copy_injective (p q N : ℕ) (a₀ : Fin q) : Function.Injective (copy p q N a₀) := by
  intro k l he
  have hh := congrArg (fun f : (template p q).Copy (ShortSpider.graph q (p+N)) => f (.inl (.inl true))) he
  exact Sum.inr.inj ((finSumFinEquiv (m:=p) (n:=N)).injective (congrArg Prod.fst (Sum.inl.inj hh)))

def roots (p q N : ℕ) (a₀ : Fin q) : Arms p q ↪ Host p q N :=
  ⟨Sum.elim (fun i => .inl (finSumFinEquiv (.inl i),some a₀)) (fun j => .inr (some j)),by
    intro a b he
    cases a with
    | inl i => cases b with
      | inl j => exact congrArg Sum.inl (Sum.inl.inj ((finSumFinEquiv (m:=p) (n:=N)).injective (congrArg Prod.fst (Sum.inl.inj he))))
      | inr j => exact (Sum.inl_ne_inr he).elim
    | inr i => cases b with
      | inl j => exact (Sum.inr_ne_inl he).elim
      | inr j => exact congrArg Sum.inr (Option.some.inj (Sum.inr.inj he))⟩

lemma copy_root (p q N : ℕ) (a₀ : Fin q) (k : Fin N) (a : Arms p q) :
    copy p q N a₀ k (.inr a)=roots p q N a₀ a := by cases a <;> rfl

lemma copy_left_eq (p q N : ℕ) (a₀ : Fin q) (k l : Fin N) :
    (copy p q N a₀ k).comp (leftCopy p q)=(copy p q N a₀ l).comp (leftCopy p q) := by
  apply Copy.ext
  intro v
  cases v with
  | inl a => cases a <;> rfl
  | inr i => rfl

/-- Arbitrarily large fixed-root fibers exist even when every pair has at most
one common neighbor and the forbidden double-spider power is absent. -/
theorem large_light_fiber (p q M N : ℕ) (hp : 2 ≤ p) (hq : 2 ≤ q) (hM : 2 ≤ M) :
    ∃r : Arms p q ↪ Host p q N, ∃F : Finset ((template p q).Copy (ShortSpider.graph q (p+N))),
      (graph p q M).Free (ShortSpider.graph q (p+N)) ∧ F.card=N ∧
      (∀f∈F, ∀a, f (.inr a)=r a) ∧
      (∀f∈F, ConnectedCopyBound.Light (template p q) (ShortSpider.graph q (p+N)) univ 2 f) ∧
      (∀f∈F, ∀g∈F, f.comp (leftCopy p q)=g.comp (leftCopy p q)) ∧
      (∀u v : Host p q N, u≠v → (FourthMoment.common (ShortSpider.graph q (p+N)) univ u v).card ≤ 1) := by
  classical
  let a₀ : Fin q := ⟨0,by omega⟩
  refine ⟨roots p q N a₀,univ.image (copy p q N a₀),not_contained_shortSpider p q M hp hq hM q (p+N),?_,?_,?_,?_,?_⟩
  · rw [card_image_of_injective _ (copy_injective p q N a₀),card_univ,Fintype.card_fin]
  · intro f hf a
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hf
    exact copy_root p q N a₀ k a
  · intro f hf u v w huv hvw huw
    exact lt_of_le_of_lt (ShortSpider.common_card_le_one q (p+N) univ (f u) (f w) (f.injective.ne huw)) (by omega)
  · intro f hf g hg
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hf
    obtain ⟨l,hl,rfl⟩ := mem_image.mp hg
    exact copy_left_eq p q N a₀ k l
  · exact fun u v huv => ShortSpider.common_card_le_one q (p+N) univ u v huv

theorem no_uniform_light_fiber_bound (p q M : ℕ) (hp : 2 ≤ p) (hq : 2 ≤ q) (hM : 2 ≤ M) :
    ¬∃C : ℕ, ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W),
      (graph p q M).Free G → ∀r : Arms p q ↪ W, ∀F : Finset ((template p q).Copy G),
      (∀f∈F, ∀a, f (.inr a)=r a) →
      (∀f∈F, ConnectedCopyBound.Light (template p q) G univ 2 f) → F.card ≤ C := by
  classical
  rintro ⟨C,hC⟩
  obtain ⟨r,F,hf,hcard,hroot,hl,hleft,hcodeg⟩ := large_light_fiber p q M (C+1) hp hq hM
  have hb := hC (Host p q (C+1)) inferInstance inferInstance (ShortSpider.graph q (p+(C+1))) hf r F hroot hl
  omega

end Erdos571.DoubleSpider.FiberObstruction


/-! Greedy tree-copy counts with a prescribed image of one vertex. -/
namespace Erdos571.TreeCount
open SimpleGraph Finset

lemma leaf_ne_root {V : Type u} [Fintype V] [Nontrivial V]
    (H : SimpleGraph V) [DecidableRel H.Adj] (hH : H.IsTree) (r : V) :
    ∃ z, z ≠ r ∧ H.degree z = 1 := by
  classical
  by_contra! hn
  have hpos (v : V) : 1 ≤ H.degree v :=
    (hH.minDegree_eq_one_of_nontrivial ▸ H.minDegree_le_degree v)
  have htwo (v : V) (hv : v ∈ univ.erase r) : 2 ≤ H.degree v := by
    have := hpos v
    have := hn v (mem_erase.mp hv).1
    omega
  have hs : 2 * (Fintype.card V - 1) ≤ ∑ v ∈ univ.erase r, H.degree v := by
    calc
      _ = ∑ _v ∈ univ.erase r, 2 := by simp [card_erase_of_mem, mul_comm]
      _ ≤ _ := sum_le_sum htwo
  have he := sum_erase_add univ (fun v => H.degree v) (mem_univ r)
  have ht : H.edgeFinset.card + 1 = Fintype.card V := hH.card_edgeFinset
  have hd := H.sum_degrees_eq_twice_card_edges
  dsimp only at he
  rw [hd] at he
  have hr := hpos r
  have hc : 1 ≤ Fintype.card V := Fintype.card_pos
  omega

abbrev Pinned {W : Type u} {V : Type v} (H : SimpleGraph W) (G : SimpleGraph V)
    (r : W) (x : V) := {f : H.Copy G // f r = x}

set_option maxHeartbeats 800000 in
lemma pinned_leaf_step {W : Type u} [Fintype W] [DecidableEq W]
    {V : Type v} [Fintype V] (H : SimpleGraph W) (G : SimpleGraph V)
    [DecidableRel G.Adj] (r z w : W) (hzr : z ≠ r) (hzw : H.Adj z w)
    (hw : ∀ a, H.Adj z a → a = w) (x : V) (D : ℕ)
    (hdeg : ∀ y, D + Fintype.card ({z}ᶜ : Set W) ≤ G.degree y) :
    D * Nat.card (Pinned (H.induce ({z}ᶜ : Set W)) G ⟨r, hzr.symm⟩ x) ≤
      Nat.card (Pinned H G r x) := by
  classical
  let S : Set W := {z}ᶜ
  let rS : S := ⟨r, hzr.symm⟩
  let wS : S := ⟨w, hzw.ne'⟩
  let C := Pinned (H.induce S) G rS x
  let avail (f : C) := G.neighborFinset (f.val wS) \ univ.image f.val
  have hcard (f : C) : D ≤ (avail f).card := by
    have hc : (univ.image f.val).card ≤ Fintype.card S := by
      simpa only [card_univ] using card_image_le (f := f.val) (s := univ)
    have hd := hdeg (f.val wS)
    have hs := card_sdiff_add_card_inter (G.neighborFinset (f.val wS)) (univ.image f.val)
    have hi := card_le_card (inter_subset_right :
      G.neighborFinset (f.val wS) ∩ univ.image f.val ⊆ univ.image f.val)
    rw [card_neighborFinset_eq_degree] at hs
    change D ≤ (G.neighborFinset (f.val wS) \ univ.image f.val).card
    change D + Fintype.card S ≤ _ at hd
    omega
  have adj (f : C) (y : avail f) : G.Adj (f.val wS) y :=
    (G.mem_neighborFinset _ _).mp (mem_sdiff.mp y.prop).1
  have fresh (f : C) (y : avail f) : ∀ a, y.val ≠ f.val a := by
    intro a he
    exact (mem_sdiff.mp y.prop).2 (mem_image.mpr ⟨a, mem_univ _, he.symm⟩)
  let ext : (Σ f : C, avail f) → Pinned H G r x := fun p =>
    ⟨extendLeaf H G z w hzw hw p.1.val p.2 (adj p.1 p.2) (fresh p.1 p.2), by
      change extendLeaf H G z w hzw hw p.1.val p.2 (adj p.1 p.2) (fresh p.1 p.2) rS = x
      rw [extendLeaf_at_old]
      exact p.1.property⟩
  have hinj : Function.Injective ext := by
    rintro ⟨f,y⟩ ⟨g,y'⟩ he
    have hfg : f = g := by
      apply Subtype.ext
      apply Copy.ext
      intro a
      have hh := congrArg (fun c : Pinned H G r x => c.val a) he
      simpa only [ext, extendLeaf_at_old] using hh
    subst g
    have hy : y = y' := by
      apply Subtype.ext
      have hh := congrArg (fun c : Pinned H G r x => c.val z) he
      simpa only [ext, extendLeaf_at_leaf] using hh
    subst y'
    rfl
  have hsum : D * Nat.card C ≤ Nat.card (Σ f : C, avail f) := by
    simp only [Nat.card_eq_fintype_card, Fintype.card_sigma, Fintype.card_coe]
    calc
      _ = ∑ _f : C, D := by simp [mul_comm]
      _ ≤ _ := sum_le_sum (fun f _ => hcard f)
  exact hsum.trans (Nat.card_le_card_of_injective ext hinj)

/-- Pinning one tree vertex removes exactly the initial host-order factor. -/
theorem pinned_count_of_degree {W : Type u} [Fintype W]
    (H : SimpleGraph W) (hH : H.IsTree) {V : Type v} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (r : W) (x : V)
    (D : ℕ) (hdeg : ∀ y, D + Fintype.card W ≤ G.degree y) :
    D ^ (Fintype.card W - 1) ≤ Nat.card (Pinned H G r x) := by
  classical
  generalize hn : Fintype.card W = n at *
  induction n using Nat.strong_induction_on generalizing W with
  | h n ih =>
    rcases subsingleton_or_nontrivial W with hW | hW
    · letI := hW
      letI : Unique W := uniqueOfSubsingleton r
      let f : Pinned H G r x := ⟨⟨⟨fun _ => x,
        fun {a b} h => (h.ne (Subsingleton.elim a b)).elim⟩,
        fun _ _ _ => Subsingleton.elim _ _⟩, rfl⟩
      letI : Nonempty (Pinned H G r x) := ⟨f⟩
      have hn1 : n = 1 := by rw [← hn]; exact Fintype.card_unique
      rw [hn1, Nat.sub_self, pow_zero]
      exact Nat.card_pos
    · letI := hW
      obtain ⟨z, hzr, hz⟩ := leaf_ne_root H hH r
      obtain ⟨w, hzw, hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz
      let S : Set W := {z}ᶜ
      have hS : (H.induce S).IsTree :=
        ⟨hH.isConnected.induce_compl_singleton_of_degree_eq_one hz, hH.IsAcyclic.induce S⟩
      have hcS : Fintype.card S = n - 1 := by
        simp only [S, Fintype.card_compl_set, Fintype.card_unique, hn]
      have hn2 : 2 ≤ n := by rw [← hn]; exact Fintype.one_lt_card_iff_nontrivial.mpr hW
      have hSm : Fintype.card S < n := by omega
      have hI := ih (Fintype.card S) hSm (H.induce S) hS ⟨r, hzr.symm⟩ rfl
        (fun y => by have := hdeg y; omega)
      have hstep := pinned_leaf_step H G r z w hzr hzw hw x D
        (fun y => by have := hdeg y; change D + Fintype.card S ≤ _; omega)
      rw [hcS] at hI
      calc
        D ^ (n - 1) = D * D ^ (n - 1 - 1) := by
          conv_lhs => rw [show n - 1 = (n - 1 - 1) + 1 by omega, pow_succ]
          ring
        _ ≤ D * Nat.card (Pinned (H.induce S) G ⟨r, hzr.symm⟩ x) := Nat.mul_le_mul_left D hI
        _ ≤ _ := hstep

end Erdos571.TreeCount


/-! Tree embeddings rooted in a selected vertex set and avoiding a blacklist. -/
namespace Erdos571.TreeCopiesIn
open Finset SimpleGraph DensityRegularization

noncomputable def centeredAvoiding {V W : Type} [Fintype V] [Fintype W]
    (H : SimpleGraph V) (G : SimpleGraph W) (U S Z : Finset W) (r : V) : Finset (H.Copy G) := by
  classical
  exact (copies H G U).filter (fun f => f r∈S ∧ ∀v, f v∉Z)

lemma mem_centeredAvoiding {V W : Type} [Fintype V] [Fintype W]
    (H : SimpleGraph V) (G : SimpleGraph W) (U S Z : Finset W) (r : V) (f : H.Copy G) :
    f∈centeredAvoiding H G U S Z r ↔ (∀v, f v∈U) ∧ f r∈S ∧ ∀v, f v∉Z := by
  classical
  simp only [centeredAvoiding, mem_filter, mem_copies]

lemma neighbors_sdiff {W : Type} [DecidableEq W] (G : SimpleGraph W)
    [DecidableRel G.Adj] (U Z : Finset W) (y : W) :
    neighbors G (U\Z) y = neighbors G U y \ Z := by
  ext v
  simp only [DensityRegularization.neighbors, Finset.mem_filter, Finset.mem_sdiff]
  tauto

set_option maxHeartbeats 800000 in
lemma centered_avoiding_lower_nat {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.IsTree) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S Z : Finset W) (r : V) (hSU : S⊆U) (hSZ : Disjoint S Z) (D : ℕ)
    (hdeg : ∀y∈U, D+Fintype.card V+Z.card ≤ (neighbors G U y).card) :
    S.card*D^(Fintype.card V-1) ≤ (centeredAvoiding H G U S Z r).card := by
  classical
  let U' := U\Z
  let pin (x : S) : U' := ⟨x.val,mem_sdiff.mpr ⟨hSU x.property,
    fun hz => Finset.disjoint_left.mp hSZ x.property hz⟩⟩
  let C (x : S) := TreeCount.Pinned H (G.induce (U':Set W)) r (pin x)
  have hd (y : U') : D+Fintype.card V ≤ (G.induce (U':Set W)).degree y := by
    rw [induce_degree]
    change D+Fintype.card V ≤ (neighbors G (U\Z) y.val).card
    rw [neighbors_sdiff]
    have h := hdeg y.val (mem_sdiff.mp y.property).1
    have hs := card_sdiff_add_card_inter (neighbors G U y.val) Z
    have hi := card_le_card (inter_subset_right : neighbors G U y.val ∩ Z ⊆ Z)
    omega
  have hc (x : S) : D^(Fintype.card V-1) ≤ Nat.card (C x) :=
    TreeCount.pinned_count_of_degree H hH (G.induce (U':Set W)) r (pin x) D hd
  let val : (Σ x : S, C x) → centeredAvoiding H G U S Z r := fun p =>
    ⟨toAmbient H G U' p.2.val,(mem_centeredAvoiding H G U S Z r _).mpr ⟨
      fun v => (mem_sdiff.mp (p.2.val v).property).1,
      by change (p.2.val r).val∈S; rw [p.2.property]; exact p.1.property,
      fun v => (mem_sdiff.mp (p.2.val v).property).2⟩⟩
  have hinj : Function.Injective val := by
    rintro ⟨x,f⟩ ⟨y,g⟩ he
    have hfg : toAmbient H G U' f.val = toAmbient H G U' g.val := congrArg Subtype.val he
    have hxy : x = y := by
      apply Subtype.ext
      have hh := congrArg (fun c : H.Copy G => c r) hfg
      change (f.val r).val = (g.val r).val at hh
      simpa only [f.property,g.property] using hh
    subst y
    have hh : f = g := Subtype.ext (toAmbient_injective H G U' hfg)
    subst g
    rfl
  have hsum : S.card*D^(Fintype.card V-1) ≤ Nat.card (Σ x : S, C x) := by
    simp only [Nat.card_eq_fintype_card,Fintype.card_sigma] at hc ⊢
    calc
      _ = ∑_x : S, D^(Fintype.card V-1) := by simp
      _ ≤ _ := sum_le_sum (fun x _ => hc x)
  have hi := Nat.card_le_card_of_injective val hinj
  simpa only [Nat.card_eq_fintype_card,Fintype.card_coe] using hsum.trans hi

lemma centered_avoiding_lower {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.IsTree) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S Z : Finset W) (r : V) (hSU : S⊆U) (hSZ : Disjoint S Z) {d : ℝ}
    (hd : 4*(Fintype.card V+Z.card+1:ℝ) ≤ d)
    (hdeg : ∀y∈U, d ≤ ((neighbors G U y).card:ℝ)) :
    (S.card:ℝ)*(d/4)^(Fintype.card V-1) ≤ (centeredAvoiding H G U S Z r).card := by
  have hn : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hz : (0:ℝ) ≤ Z.card := Nat.cast_nonneg _
  have hd0 : 0 ≤ d := by linarith
  have hflo : (⌊d/2⌋₊:ℝ) ≤ d/2 := Nat.floor_le (by linarith)
  have hfhi := Nat.lt_floor_add_one (d/2)
  have hflower : d/4 ≤ (⌊d/2⌋₊:ℝ) := by linarith
  have h := centered_avoiding_lower_nat H hH G U S Z r hSU hSZ ⌊d/2⌋₊ (fun y hy => by
    have hb : (⌊d/2⌋₊:ℝ)+Fintype.card V+Z.card ≤ (neighbors G U y).card := by linarith [hdeg y hy]
    exact_mod_cast hb)
  have h' : (S.card:ℝ)*(⌊d/2⌋₊:ℝ)^(Fintype.card V-1) ≤ (centeredAvoiding H G U S Z r).card := by exact_mod_cast h
  exact (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hflower _) (Nat.cast_nonneg _)).trans h'

/-- An upper bound for copies whose specified vertex lies in `S`. -/
lemma centered_upper {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (r : V) {D : ℝ} (hD : 0 ≤ D)
    (hdeg : ∀y∈U, ((neighbors G U y).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U) (hcenter : ∀f∈F, f r∈S) :
    (F.card:ℝ) ≤ S.card*D^(Fintype.card V-1) := by
  classical
  apply RealFiberCount.bound F S (fun f => f r) hcenter
  intro x hx
  simpa only [card_singleton] using ConnectedCopyBound.bound H hH G U hD hdeg
    {r} (singleton_nonempty _) (fun _ => x) (F.filter (fun f => f r=x))
    (fun f hf => hmem f (mem_filter.mp hf).1) (by
      intro f hf v hv
      have hv : v=r := mem_singleton.mp hv
      subst v
      exact (mem_filter.mp hf).2)

end Erdos571.TreeCopiesIn


/-! Global support counting for centers admitting rich short-spider completions. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- Deleting a nested-rich arm loses one degree factor, even with a prescribed
set of centers and fixed right roots. -/
lemma support_nested_arm_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    (rR : Fin q ↪ W) {D : ℝ} (hD : 0 ≤ D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (j : Fin (p+1)) (F : Finset ((LongSpider.template (p+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hcenter : ∀f∈F, f (.inl none)∈S)
    (havoid : ∀f∈F, ∀v k, f v≠rR k)
    (hrich : ∀f∈F, nestedThreshold t p q M <
      (nestedFiber G U t p q M (f (.inl (some j)))
        (Sum.elim (fun i => f (.inr (j.succAbove i))) rR)).card) :
    (F.card:ℝ) ≤ (M:ℝ)*S.card*D^(2*p+1) := by
  classical
  let pre : (LongSpider.template (p+1)).Copy G → (LongSpider.template p).Copy G :=
    fun f => f.comp (LongSpider.omitCopy p j)
  let F₀ := F.image pre
  have hfiber (g : (LongSpider.template p).Copy G) (hg : g∈F₀) :
      ((F.filter (fun f => pre f=g)).card:ℝ) ≤ (M:ℝ)*D := by
    obtain ⟨g₀,hg₀,hgpre⟩ := mem_image.mp hg
    let F₁ := F.filter (fun f => pre f=g)
    have hav (v) (k) : g v≠rR k := by
      rw [← hgpre]
      exact havoid g₀ hg₀ _ k
    let r : Arms p q ↪ W := ⟨Sum.elim (fun i => g (.inr i)) rR,by
      apply (g.injective.comp Sum.inr_injective).sumElim rR.injective
      intro i k
      exact hav (.inr i) k⟩
    let R := (neighbors G U (g (.inl none))).filter (fun w =>
      nestedThreshold t p q M < (nestedFiber G U t p q M w r).card)
    have hR : R.card ≤ M := (nested_neighbors_bound G U t p q M ht hf r (g (.inl none)) (by
      intro a
      cases a with
      | inl i => exact fun he => Sum.inl_ne_inr (g.injective he)
      | inr k => exact hav (.inl none) k)).le
    let ev : (LongSpider.template (p+1)).Copy G → W := fun f => f (.inl (some j))
    have hmap : Set.MapsTo ev F₁ R := by
      intro f hf₁
      have hfF := (mem_filter.mp hf₁).1
      have he : ∀v, f (LongSpider.omitCopy p j v)=g v :=
        fun v => congrArg (fun h : (LongSpider.template p).Copy G => h v) (mem_filter.mp hf₁).2
      apply mem_filter.mpr
      constructor
      · apply mem_filter.mpr
        refine ⟨hmem f hfF _,?_⟩
        rw [← he (.inl none)]
        exact f.toHom.map_adj (show (LongSpider.template (p+1)).Adj (.inl none) (.inl (some j)) from trivial)
      · have hh := hrich f hfF
        have her : (Sum.elim (fun i => f (.inr (j.succAbove i))) rR) = r := by
          funext a
          cases a with
          | inl i => exact he (.inr i)
          | inr k => rfl
        rwa [her] at hh
    have hinner (w : W) (hw : w∈R) : ((F₁.filter (fun f => ev f=w)).card:ℝ) ≤ D := by
      let F₂ := F₁.filter (fun f => ev f=w)
      have hcard : F₂.card ≤ (neighbors G U w).card := by
        apply card_le_card_of_injOn (fun f => f (.inr j))
        · intro f hf₂
          have hh := (mem_filter.mp hf₂).2
          refine mem_filter.mpr ⟨hmem f (mem_filter.mp (mem_filter.mp hf₂).1).1 _,?_⟩
          rw [← hh]
          exact f.toHom.map_adj (show (LongSpider.template (p+1)).Adj (.inl (some j)) (.inr j) from rfl)
        · intro f hf₂ f' hf₂' he
          apply LongSpider.omit_ext G p j f f'
          · exact (mem_filter.mp (mem_filter.mp hf₂).1).2.trans (mem_filter.mp (mem_filter.mp hf₂').1).2.symm
          · exact (mem_filter.mp hf₂).2.trans (mem_filter.mp hf₂').2.symm
          · exact he
      exact (show (F₂.card:ℝ) ≤ (neighbors G U w).card by exact_mod_cast hcard).trans
        (hdeg w (mem_filter.mp (mem_filter.mp hw).1).1)
    have hb := RealFiberCount.bound F₁ R ev hmap hinner
    exact hb.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hR) hD)
  have hb := RealFiberCount.bound F F₀ pre (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩) hfiber
  have hs : (F₀.card:ℝ) ≤ S.card*D^(2*p) := by
    have hh := TreeCopiesIn.centered_upper (LongSpider.template p) (LongSpider.connected p) G U S
      (.inl none) hD hdeg F₀ (by
        intro g hg
        obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
        exact fun v => hmem f hf _) (by
        intro g hg
        obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
        exact hcenter f hf)
    have he : Fintype.card (Option (Fin p) ⊕ Fin p)-1=2*p := by simp; omega
    simpa only [he] using hh
  calc
    _ ≤ (F₀.card:ℝ)*((M:ℝ)*D) := hb
    _ ≤ (S.card:ℝ)*D^(2*p)*((M:ℝ)*D) := mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [pow_succ]; ring

/-- Good left spiders have a constant bound for each left-root tuple. -/
lemma support_good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    (F : Finset ((LongSpider.template (p+1)).Copy G))
    (hgood : ∀f∈F, NestedGoodLeft G U t p q M rR f)
    (havoid : ∀f∈F, ∀i k, f (.inr i)≠rR k) :
    (F.card:ℝ) ≤ (M*(p+2)*nestedLoad t p q M:ℕ)*(U.card:ℝ)^(p+1) := by
  classical
  have hb := RootedFiberCount.bound (LongSpider.template (p+1)) G U F
    (fun f hf i => (hgood f hf).1 _) (show (0:ℝ) ≤ (M*(p+2)*nestedLoad t p q M:ℕ) by positivity) (by
      intro rL F' hsub hroot
      by_cases hne : F'.Nonempty
      swap
      · rw [not_nonempty_iff_eq_empty.mp hne,card_empty,Nat.cast_zero]; positivity
      obtain ⟨f₀,hf₀⟩ := hne
      let r : Arms (p+1) q ↪ W := ⟨Sum.elim rL rR,by
        apply rL.injective.sumElim rR.injective
        intro i k
        rw [← hroot f₀ hf₀ i]
        exact havoid f₀ (hsub hf₀) i k⟩
      exact_mod_cast (nested_projection_bound G U t p q M ht hf F' r
        (fun f hf => hgood f (hsub hf)) hroot).le)
  simpa only [Fintype.card_fin] using hb

/-- All light left spiders centered in `S` with rich right completions satisfy a
support-sensitive bound. Nested exclusions are charged, not assumed. -/
theorem support_light_count (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((LongSpider.template (p+1)).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hcenter : ∀f∈F, f (.inl none)∈S)
    (hl : ∀f∈F, ConnectedCopyBound.Light (LongSpider.template (p+1)) G U t f)
    (havoid : ∀f∈F, ∀v k, f v≠rR k)
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl none)) rR).card) :
    (F.card:ℝ) ≤ (M*(p+2)*nestedLoad t p q M:ℕ)*(U.card:ℝ)^(p+1)+
      (p+1:ℕ)*((M:ℝ)*S.card*D^(2*p+1)) := by
  classical
  let P (j : Fin (p+1)) (f : (LongSpider.template (p+1)).Copy G) : Prop :=
    (nestedFiber G U t p q M (f (.inl (some j)))
      (Sum.elim (fun i => f (.inr (j.succAbove i))) rR)).card ≤ nestedThreshold t p q M
  let F₀ := F.filter (fun f => ∀j, P j f)
  have hb (j : Fin (p+1)) : ((F.filter (fun f => ¬P j f)).card:ℝ) ≤ (M:ℝ)*S.card*D^(2*p+1) :=
    support_nested_arm_bound G U S t p q M ht hf rR hD hdeg j _
      (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hcenter f (mem_filter.mp hf).1)
      (fun f hf => havoid f (mem_filter.mp hf).1) (fun f hf => Nat.lt_of_not_ge (mem_filter.mp hf).2)
  have hc := FinsetCleaning.bound F P hb
  have hg := support_good_count G U t p q M ht hf rR F₀ (by
    intro f hf₀
    have hfF := (mem_filter.mp hf₀).1
    exact ⟨hmem f hfF,hl f hfF,fun a k => havoid f hfF _ k,hrich f hfF,(mem_filter.mp hf₀).2⟩)
    (fun f hf₀ i k => havoid f (mem_filter.mp hf₀).1 _ k)
  simpa only [Fintype.card_fin] using hc.trans (add_le_add hg (le_refl _))

end Erdos571.DoubleSpider


/-! Rich-center support bounds in almost regular graphs with bounded codegrees. -/
namespace Erdos571.LowerOrderAbsorption

/-- Absorb a lower-order error weighted by the same support size as the lower
bound. Unlike the host-order version, the support may be empty. -/
lemma support_bound (k : ℕ) {s d A E c : ℝ} (hs : 0 ≤ s) (hd : 0 ≤ d) (hc : 0 < c)
    (hbig : 2*E ≤ c*d)
    (hcount : c*s*d^(k+1) ≤ A+E*s*d^k) : s*d^(k+1) ≤ 2*A/c := by
  have he := mul_le_mul_of_nonneg_right hbig (show 0 ≤ s*d^k by positivity)
  rw [le_div_iff₀ hc]
  rw [pow_succ] at hcount ⊢
  nlinarith

end Erdos571.LowerOrderAbsorption

set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- A fixed right-root tuple can have only a small support of rich centers.
The assertion is global over left-root tuples, not a constant fixed-root-fiber
bound (which is false). -/
theorem rich_center_support (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    (hSU : S⊆U) (havoid : ∀x∈S, ∀j, x≠rR j)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+q+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t)
    (hrich : ∀x∈S, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q x rR).card) :
    (S.card:ℝ)*d^(2*p+2) ≤
      2*4^(2*p+2)*(M*(p+2)*nestedLoad t p q M:ℕ)*(U.card:ℝ)^(p+1) := by
  classical
  let Z := univ.image rR
  have hZ : Z.card=q := by simp [Z,card_image_of_injective _ rR.injective]
  let F := TreeCopiesIn.centeredAvoiding (LongSpider.template (p+1)) G U S Z (.inl none)
  have hm (f) (hf : f∈F) := (TreeCopiesIn.mem_centeredAvoiding _ _ _ _ _ _ _).mp hf
  have hcardV : Fintype.card (Option (Fin (p+1)) ⊕ Fin (p+1))=2*p+3 := by simp; omega
  have hSZ : Disjoint S Z := by
    apply Finset.disjoint_left.mpr
    intro x hx hz
    obtain ⟨j,hj,he⟩ := mem_image.mp hz
    exact havoid x hx j he.symm
  have hd0 : 0 ≤ d := by
    have : (0:ℝ) ≤ (2*p+q+4:ℕ) := Nat.cast_nonneg _
    linarith
  have hlow : (S.card:ℝ)*(d/4)^(2*p+2) ≤ F.card := by
    have hh := TreeCopiesIn.centered_avoiding_lower (LongSpider.template (p+1)) (LongSpider.isTree _)
      G U S Z (.inl none) hSU hSZ (d:=d) (by
        rw [hcardV,hZ]
        push_cast at hd ⊢
        linarith) hmin
    simpa only [hcardV,show 2*p+3-1=2*p+2 by omega] using hh
  have hup := support_light_count G U S t p q M ht hf rR (show 0 ≤ Q*d by positivity) hmax F
    (fun f hf => (hm f hf).1) (fun f hf => (hm f hf).2.1) (by
      intro f hf u v w huv hvw huw
      exact hcodeg _ ((hm f hf).1 u) _ ((hm f hf).1 w) (f.injective.ne huw)) (by
      intro f hf v j he
      exact (hm f hf).2.2 v (mem_image.mpr ⟨j,mem_univ _,he.symm⟩))
    (fun f hf => hrich _ (hm f hf).2.1)
  let A : ℝ := (M*(p+2)*nestedLoad t p q M:ℕ)*(U.card:ℝ)^(p+1)
  let E : ℝ := (p+1:ℕ)*M*Q^(2*p+1)
  let c : ℝ := 1/4^(2*p+2)
  have hc : 0<c := by dsimp [c]; positivity
  have hbig : 2*E ≤ c*d := by
    dsimp only [E,c]
    rw [one_div_mul_eq_div,le_div_iff₀ (by positivity : 0<(4:ℝ)^(2*p+2))]
    nlinarith [hlarge]
  have he : (p+1:ℕ)*((M:ℝ)*S.card*(Q*d)^(2*p+1))=E*S.card*d^(2*p+1) := by
    rw [mul_pow]
    dsimp [E]
    ring
  rw [he] at hup
  have hlower : c*S.card*d^(2*p+2) ≤ F.card := by
    convert hlow using 1
    dsimp [c]
    rw [div_pow]
    field_simp
  have hh : c*S.card*d^((2*p+1)+1) ≤ A+E*S.card*d^(2*p+1) := by
    simpa only [show 2*p+1+1=2*p+2 by omega] using hlower.trans hup
  have hb := LowerOrderAbsorption.support_bound (2*p+1) (Nat.cast_nonneg S.card) hd0 hc hbig hh
  have hcoef : 2*A/c=2*4^(2*p+2)*(M*(p+2)*nestedLoad t p q M:ℕ)*(U.card:ℝ)^(p+1) := by
    dsimp [A,c]
    field_simp
  simpa only [hcoef,show 2*p+1+1=2*p+2 by omega] using hb

end Erdos571.DoubleSpider


/-! Rectangular edge bounds from bounded codegrees. The two vertex sets may overlap. -/
namespace Erdos571.BoundedCodegreeCross
open Finset SimpleGraph DensityRegularization FourthMoment
variable {W : Type*} [DecidableEq W]

def edges (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) : Finset (W×W) :=
  (S×ˢY).filter (fun e => G.Adj e.1 e.2)

lemma card_edges_left (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) :
    (edges G S Y).card = ∑x∈S, (neighbors G Y x).card := by
  simp only [edges,card_filter,sum_product,neighbors,card_filter]

lemma card_edges_right (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) :
    (edges G S Y).card = ∑y∈Y, (neighbors G S y).card := by
  rw [card_edges_left]
  simpa only [bipartiteAbove,bipartiteBelow,neighbors,G.adj_comm] using
    sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (s:=S) (t:=Y) G.Adj

lemma moment (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) :
    (∑x∈S, (neighbors G Y x).card^2) = ∑p∈Y×ˢY, (common G S p.1 p.2).card := by
  have he := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
    (s:=Y×ˢY) (t:=S) (fun p x => G.Adj p.1 x ∧ G.Adj p.2 x)
  change (∑p∈Y×ˢY, (common G S p.1 p.2).card) = _ at he
  rw [he]
  apply sum_congr rfl
  intro x hx
  simp only [bipartiteBelow,filter_product,G.adj_comm,neighbors,card_product,pow_two]

lemma moment_bound (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W)
    (t : ℕ) (hcodeg : ∀y∈Y, ∀z∈Y, y≠z → (common G S y z).card ≤ t) :
    (∑x∈S, (neighbors G Y x).card^2) ≤ t*Y.card^2+(edges G S Y).card := by
  classical
  rw [moment,sum_product]
  have hp (y : W) (hy : y∈Y) (z : W) (hz : z∈Y) :
      (common G S y z).card ≤ t + if y=z then (neighbors G S y).card else 0 := by
    by_cases he : y=z
    · subst z
      have hec : common G S y y = neighbors G S y := by ext v; simp [common,neighbors]
      rw [hec,if_pos rfl]
      omega
    · simpa only [he,ite_false,add_zero] using hcodeg y hy z hz he
  calc
    _ ≤ ∑y∈Y, ∑z∈Y, (t + if y=z then (neighbors G S y).card else 0) :=
      sum_le_sum (fun y hy => sum_le_sum (fun z hz => hp y hy z hz))
    _ = t*Y.card^2+(edges G S Y).card := by
      simp only [sum_add_distrib,sum_const,nsmul_eq_mul]
      simp only [sum_ite_eq,card_edges_right]
      simp only [sum_ite_mem,inter_self,Nat.cast_id]
      ring

lemma quadratic_bound {e s z : ℝ} (hs : 0 ≤ s) (hz : 0 ≤ z)
    (h : e^2 ≤ s*e+z^2) : e ≤ s+z := by
  by_contra! he
  have he0 : 0<e := by linarith
  have h₁ := mul_nonneg hz (show 0 ≤ e-z by linarith)
  have h₂ := mul_pos (show 0 < e-s-z by linarith) he0
  nlinarith

/-- The support term is additive, not multiplied by the opposite set size. -/
theorem bound (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W)
    (t : ℕ) (hcodeg : ∀y∈Y, ∀z∈Y, y≠z → (common G S y z).card ≤ t) :
    ((edges G S Y).card:ℝ) ≤ S.card+Real.sqrt ((t:ℝ)*S.card)*Y.card := by
  have hm : (∑x∈S, ((neighbors G Y x).card:ℝ)^2) ≤ (t:ℝ)*(Y.card:ℝ)^2+(edges G S Y).card := by
    exact_mod_cast moment_bound G S Y t hcodeg
  have he : (∑x∈S, ((neighbors G Y x).card:ℝ)) = (edges G S Y).card := by
    exact_mod_cast (card_edges_left G S Y).symm
  have hc := sq_sum_le_card_mul_sum_sq (s:=S) (f:=fun x => ((neighbors G Y x).card:ℝ))
  rw [he] at hc
  have hh := hc.trans (mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg S.card))
  have hsqrt : (Real.sqrt ((t:ℝ)*S.card)*Y.card)^2=(t:ℝ)*S.card*(Y.card:ℝ)^2 := by
    rw [mul_pow,Real.sq_sqrt (by positivity)]
  apply quadratic_bound (Nat.cast_nonneg S.card) (by positivity)
  rw [hsqrt]
  nlinarith [hh]

end Erdos571.BoundedCodegreeCross


/-! Count full double-spider copies by incidences between the two core centers. -/
set_option maxHeartbeats 1500000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma fixed_centers_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template p q).Copy G)) (rR : Fin q → W) (x y : W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀j, f (.inr (.inr j))=rR j)
    (hx : ∀f∈F, f (.inl (.inl false))=x) (hy : ∀f∈F, f (.inl (.inl true))=y) :
    (F.card:ℝ) ≤ D^(2*p)*(t:ℝ)^q := by
  classical
  let L := F.image (fun f => f.comp (leftCopy p q))
  let R := F.image (fun f => f.comp (rightCopy p q))
  have hL : (L.card:ℝ) ≤ D^(2*p) := by
    have hh := ConnectedCopyBound.bound (LongSpider.template p) (LongSpider.connected p)
      G U hD hdeg {Sum.inl none} (singleton_nonempty _) (fun _ => x) L (by
        intro g hg
        obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
        exact fun v => hmem f hf _) (by
        intro g hg v hv
        obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
        have hv : v=Sum.inl none := mem_singleton.mp hv
        subst v
        exact hx f hf)
    have he : Fintype.card (Option (Fin p) ⊕ Fin p)-1=2*p := by simp; omega
    simpa only [card_singleton,he] using hh
  have hR : R.card ≤ t^q := LongSpider.center_count G U t q R rR y (by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact fun v => hmem f hf _) (by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact (hl f hf).comp _) (by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact fun j => hroot f hf j) (by
    intro g hg
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
    exact hy f hf)
  have hc : F.card ≤ L.card*R.card := by
    rw [← card_product]
    apply card_le_card_of_injOn (fun f => (f.comp (leftCopy p q),f.comp (rightCopy p q)))
    · intro f hf
      exact mem_product.mpr ⟨mem_image.mpr ⟨f,hf,rfl⟩,mem_image.mpr ⟨f,hf,rfl⟩⟩
    · intro f hf g hg he
      exact pair_ext G p q f g (congrArg Prod.fst he) (congrArg Prod.snd he)
  have hc' : (F.card:ℝ) ≤ (L.card:ℝ)*R.card := by exact_mod_cast hc
  exact hc'.trans (mul_le_mul hL (by exact_mod_cast hR) (Nat.cast_nonneg _) (by positivity))

lemma core_incidence_count (G : SimpleGraph W) [DecidableRel G.Adj] (U S Y : Finset W)
    (t p q : ℕ) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template p q).Copy G)) (rR : Fin q → W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀j, f (.inr (.inr j))=rR j)
    (hS : ∀f∈F, f (.inl (.inl false))∈S) (hY : ∀f∈F, f (.inl (.inl true))∈Y)
    (hcodeg : ∀y∈Y, ∀z∈Y, y≠z → (FourthMoment.common G S y z).card ≤ t) :
    (F.card:ℝ) ≤ (S.card+Real.sqrt ((t:ℝ)*S.card)*Y.card)*(D^(2*p)*(t:ℝ)^q) := by
  classical
  let ev : (template p q).Copy G → W×W := fun f => (f (.inl (.inl false)),f (.inl (.inl true)))
  have hm : Set.MapsTo ev F (BoundedCodegreeCross.edges G S Y) := by
    intro f hf
    apply mem_filter.mpr
    refine ⟨mem_product.mpr ⟨hS f hf,hY f hf⟩,?_⟩
    exact f.toHom.map_adj (show (template p q).Adj (.inl (.inl false)) (.inl (.inl true)) from Bool.noConfusion)
  have hb := RealFiberCount.bound F (BoundedCodegreeCross.edges G S Y) ev hm (by
    intro e he
    apply fixed_centers_count G U t p q hD hdeg _ rR e.1 e.2
      (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
      (fun f hf => hroot f (mem_filter.mp hf).1)
    · intro f hf; exact congrArg Prod.fst (mem_filter.mp hf).2
    · intro f hf; exact congrArg Prod.snd (mem_filter.mp hf).2)
  exact hb.trans (mul_le_mul_of_nonneg_right (BoundedCodegreeCross.bound G S Y t hcodeg) (by positivity))

end Erdos571.DoubleSpider


/-! Summing incidence bounds over right-root tuples without losing a degree factor. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- A uniform rich-center support bound can be combined with the global right
spider count. The opposite-center sets are summed, not bounded by host order
separately for each root tuple. -/
theorem global_incidence_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) {D B : ℝ} (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (hcodeg : ∀y∈U, ∀z∈U, y≠z → (FourthMoment.common G U y z).card ≤ t)
    (F : Finset ((template p q).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hsupport : ∀r : Fin q ↪ W, ∀F' : Finset ((template p q).Copy G), F'⊆F →
      (∀f∈F', ∀j, f (.inr (.inr j))=r j) →
      ((F'.image (fun f => f (.inl (.inl false)))).card:ℝ) ≤ B) :
    (F.card:ℝ) ≤ (D^(2*p)*(t:ℝ)^q)*
      (B*(U.card:ℝ)^q+Real.sqrt ((t:ℝ)*B)*U.card*D^(2*q)) := by
  classical
  let root : (template p q).Copy G → Fin q → W := fun f j => f (.inr (.inr j))
  let rproj : (template p q).Copy G → (LongSpider.template q).Copy G := fun f => f.comp (rightCopy p q)
  let roots : (LongSpider.template q).Copy G → Fin q → W := fun g j => g (.inr j)
  let R := F.image root
  let A := F.image rproj
  let Fr (r : Fin q → W) := F.filter (fun f => root f=r)
  let Ar (r : Fin q → W) := A.filter (fun g => roots g=r)
  let S (r : Fin q → W) := (Fr r).image (fun f => f (.inl (.inl false)))
  let Y (r : Fin q → W) := (Ar r).image (fun g => g (.inl none))
  have hRU : R.card ≤ U.card^q := by
    let val : R → (Fin q → U) := fun r j => ⟨r.val j,by
      obtain ⟨f,hf,he⟩ := mem_image.mp r.property
      rw [← he]
      exact hmem f hf _⟩
    have hinj : Function.Injective val := by
      intro r r' he
      apply Subtype.ext
      funext j
      exact congrArg Subtype.val (congrFun he j)
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using Fintype.card_le_of_injective val hinj
  have hSU (r : Fin q → W) : S r⊆U := by
    intro x hx
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hx
    exact hmem f (mem_filter.mp hf).1 _
  have hYU (r : Fin q → W) : Y r⊆U := by
    intro y hy
    obtain ⟨g,hg,rfl⟩ := mem_image.mp hy
    obtain ⟨f,hf,rfl⟩ := mem_image.mp (mem_filter.mp hg).1
    exact hmem f hf _
  have hS (r : Fin q → W) (hr : r∈R) : ((S r).card:ℝ) ≤ B := by
    obtain ⟨f₀,hf₀,he⟩ := mem_image.mp hr
    have hi : Function.Injective r := by
      rw [← he]
      exact f₀.injective.comp (Sum.inr_injective.comp Sum.inr_injective)
    exact hsupport ⟨r,hi⟩ (Fr r) (filter_subset _ _)
      (fun f hf j => congrFun (mem_filter.mp hf).2 j)
  have hsumY : (∑r∈R, ((Y r).card:ℝ)) ≤ (U.card:ℝ)*D^(2*q) := by
    have hmap : Set.MapsTo roots A R := by
      intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact mem_image.mpr ⟨f,hf,rfl⟩
    have hsumA : (∑r∈R, ((Ar r).card:ℝ)) = A.card := by
      exact_mod_cast (card_eq_sum_card_fiberwise hmap).symm
    have htotal : (A.card:ℝ) ≤ (U.card:ℝ)*D^(2*q) := by
      have hh := ConnectedCopyBound.total (LongSpider.template q) (LongSpider.connected q) G U hD hdeg A (by
        intro g hg
        obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
        exact fun v => hmem f hf _)
      have he : Fintype.card (Option (Fin q) ⊕ Fin q)-1=2*q := by simp; omega
      simpa only [he] using hh
    calc
      _ ≤ ∑r∈R, ((Ar r).card:ℝ) := sum_le_sum (fun r hr => by exact_mod_cast card_image_le (s:=Ar r) (f:=fun g => g (.inl none)))
      _ = A.card := hsumA
      _ ≤ _ := htotal
  have hfiber (r : Fin q → W) (hr : r∈R) :
      ((Fr r).card:ℝ) ≤ (B+Real.sqrt ((t:ℝ)*B)*(Y r).card)*(D^(2*p)*(t:ℝ)^q) := by
    have hb := core_incidence_count G U (S r) (Y r) t p q hD hdeg (Fr r) r
      (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
      (fun f hf j => congrFun (mem_filter.mp hf).2 j)
      (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩) (by
        intro f hf
        apply mem_image.mpr
        refine ⟨rproj f,mem_filter.mpr ⟨mem_image.mpr ⟨f,(mem_filter.mp hf).1,rfl⟩,(mem_filter.mp hf).2⟩,rfl⟩) (by
        intro y hy z hz hyz
        apply le_trans _ (hcodeg y (hYU r hy) z (hYU r hz) hyz)
        apply card_le_card
        exact filter_subset_filter _ (hSU r))
    apply hb.trans
    apply mul_le_mul_of_nonneg_right _ (by positivity)
    exact add_le_add (hS r hr) (mul_le_mul_of_nonneg_right
      (Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left (hS r hr) (Nat.cast_nonneg _))) (Nat.cast_nonneg _))
  have hcount : (F.card:ℝ) = ∑r∈R, ((Fr r).card:ℝ) := by
    exact_mod_cast card_eq_sum_card_fiberwise (show Set.MapsTo root F R from fun f hf => mem_image.mpr ⟨f,hf,rfl⟩)
  have hcardR : (R.card:ℝ) ≤ (U.card:ℝ)^q := by exact_mod_cast hRU
  calc
    _ = ∑r∈R, ((Fr r).card:ℝ) := hcount
    _ ≤ ∑r∈R, (B+Real.sqrt ((t:ℝ)*B)*(Y r).card)*(D^(2*p)*(t:ℝ)^q) := sum_le_sum hfiber
    _ = (D^(2*p)*(t:ℝ)^q)*(B*R.card+Real.sqrt ((t:ℝ)*B)*∑r∈R, ((Y r).card:ℝ)) := by
      rw [← sum_mul,sum_add_distrib,sum_const,nsmul_eq_mul,← mul_sum]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (add_le_add (mul_le_mul_of_nonneg_left hcardR hB)
      (by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hsumY (Real.sqrt_nonneg _))) (by positivity)

end Erdos571.DoubleSpider


/-! Explicit global rich-copy estimates from rich-center support and codegrees. -/
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization

noncomputable def supportConstant (t p q M : ℕ) : ℝ :=
  2*4^(2*p+2)*(M*(p+2)*nestedLoad t p q M:ℕ)

lemma supportConstant_nonneg (t p q M : ℕ) : 0 ≤ supportConstant t p q M := by
  unfold supportConstant
  positivity

lemma incidence_support_expression (P q t : ℕ) {C n d Q : ℝ}
    (hC : 0 ≤ C) (hn : 0 ≤ n) (hd : 0 < d) :
    ((Q*d)^(2*P)*(t:ℝ)^q)*
      ((C*n^P/d^(2*P))*n^q+Real.sqrt ((t:ℝ)*(C*n^P/d^(2*P)))*n*(Q*d)^(2*q)) =
    Q^(2*P)*(t:ℝ)^q*(C*n^(P+q)+
      Real.sqrt ((t:ℝ)*C)*Real.sqrt (n^P)*n*Q^(2*q)*d^(P+2*q)) := by
  have hp : d^(2*P)=(d^P)^2 := by rw [← pow_mul]; congr 1; omega
  have hs : Real.sqrt ((t:ℝ)*(C*n^P/d^(2*P))) =
      Real.sqrt ((t:ℝ)*C)*Real.sqrt (n^P)/d^P := by
    have he : (t:ℝ)*(C*n^P/d^(2*P))=((t:ℝ)*C*n^P)/(d^P)^2 := by rw [hp]; ring
    rw [he,Real.sqrt_div (by positivity),Real.sqrt_mul (by positivity),Real.sqrt_sq (pow_nonneg hd.le _)]
  rw [hs,mul_pow,mul_pow,pow_add,pow_add,hp]
  field_simp

set_option maxHeartbeats 2000000 in
/-- A rich-core global count with no independent maximum-degree loss. The
remaining incidence term has a different exponent and must still be checked
against the target degree scale. -/
theorem rich_global_support_count {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+q+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t)
    (F : Finset ((template (p+1) q).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card) :
    (F.card:ℝ) ≤ Q^(2*(p+1))*(t:ℝ)^q*
      (supportConstant t p q M*(U.card:ℝ)^(p+1+q)+
        Real.sqrt ((t:ℝ)*supportConstant t p q M)*Real.sqrt ((U.card:ℝ)^(p+1))*U.card*
          Q^(2*q)*d^(p+1+2*q)) := by
  classical
  have hdpos : 0<d := by
    have hh : (0:ℝ) ≤ (p:ℝ) := Nat.cast_nonneg p
    have hh' : (0:ℝ) ≤ (q:ℝ) := Nat.cast_nonneg q
    push_cast at hd
    linarith
  let B := supportConstant t p q M*(U.card:ℝ)^(p+1)/d^(2*(p+1))
  have hB : 0 ≤ B := by dsimp [B]; exact div_nonneg (mul_nonneg (supportConstant_nonneg _ _ _ _) (by positivity)) (by positivity)
  have hs : ∀r : Fin q ↪ W, ∀F' : Finset ((template (p+1) q).Copy G), F'⊆F →
      (∀f∈F', ∀j, f (.inr (.inr j))=r j) →
      ((F'.image (fun f => f (.inl (.inl false)))).card:ℝ) ≤ B := by
    intro r F' hsub hroot
    let S := F'.image (fun f => f (.inl (.inl false)))
    have hSU : S⊆U := by
      intro x hx
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hx
      exact hmem f (hsub hf) _
    have hav : ∀x∈S, ∀j, x≠r j := by
      intro x hx j he
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hx
      rw [← hroot f hf j] at he
      exact Sum.inl_ne_inr (f.injective he)
    have hr : ∀x∈S, completionThreshold t (p+1) q M < (LongSpider.shortFiber G U t q x r).card := by
      intro x hx
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hx
      simpa only [hroot f hf] using hrich f (hsub hf)
    have hb := rich_center_support G U S t p q M ht hf r hSU hav hQ hd hlarge hmin hmax hcodeg hr
    change (S.card:ℝ) ≤ supportConstant t p q M*(U.card:ℝ)^(p+1)/d^(2*(p+1))
    rw [le_div_iff₀ (pow_pos hdpos _)]
    simpa only [supportConstant,show 2*(p+1)=2*p+2 by omega] using hb
  have hb := global_incidence_count G U t (p+1) q (show 0 ≤ Q*d by positivity) hB hmax
    (fun u hu v hv huv => (hcodeg u hu v hv huv).le) F hmem (by
      intro f hf u v w huv hvw huw
      exact hcodeg _ (hmem f hf u) _ (hmem f hf w) (f.injective.ne huw)) hs
  exact hb.trans_eq (incidence_support_expression (p+1) q t (supportConstant_nonneg _ _ _ _) (Nat.cast_nonneg U.card) hdpos)

end Erdos571.DoubleSpider


/-! All-copy counts with global bounded codegrees, using both support estimates. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def supportMainCoeff (t p q L T M : ℕ) (Q : ℝ) : ℝ :=
  (M*(p+q+4)*nonrichLoad t p q L T:ℕ)+
  Q^(2*(p+1))*(t:ℝ)^(q+1)*supportConstant t p (q+1) M+
  Q^(2*(q+1))*(t:ℝ)^(p+1)*supportConstant t q (p+1) M

noncomputable def supportIncidenceCoeff (t p q M : ℕ) (Q : ℝ) : ℝ :=
  Q^(2*(p+q)+4)*(t:ℝ)^(q+1)*Real.sqrt ((t:ℝ)*supportConstant t p (q+1) M)

lemma swapped_rich_support_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*q+(p+1)+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*q+2)*(q+1:ℕ)*M*Q^(2*q+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hrich : ∀f∈F, completionThreshold t (q+1) (p+1) M <
      (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun j => f (.inr (.inl j)))).card) :
    (F.card:ℝ) ≤ Q^(2*(q+1))*(t:ℝ)^(p+1)*
      (supportConstant t q (p+1) M*(U.card:ℝ)^(p+q+2)+
        Real.sqrt ((t:ℝ)*supportConstant t q (p+1) M)*Real.sqrt ((U.card:ℝ)^(q+1))*U.card*
          Q^(2*(p+1))*d^(q+2*p+3)) := by
  classical
  let sw : (template (p+1) (q+1)).Copy G → (template (q+1) (p+1)).Copy G := fun f => f.comp (swap (q+1) (p+1))
  have hb := rich_global_support_count G U t q (p+1) M ht (free_swap G (p+1) (q+1) M hf)
    hQ hd hlarge hmin hmax hcodeg (F.image sw)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact fun v => hmem f hf _)
    (by intro g hg; obtain ⟨f,hf,rfl⟩ := mem_image.mp hg; exact hrich f hf)
  rw [card_image_of_injective F (comp_swap_injective G (p+1) (q+1))] at hb
  simpa only [show q+1+(p+1)=p+q+2 by omega,show q+1+2*(p+1)=q+2*p+3 by omega] using hb

/-- Every full copy is counted. There are no assumed selective exclusions or
light-copy survival hypotheses. Bounded codegree is still an explicit assumption. -/
theorem all_bounded_codegree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q L B T M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    (hL : completionThreshold t (p+1) (q+1) M ≤ L) (hL' : completionThreshold t (q+1) (p+1) M ≤ L)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+2*q+7:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hlarge' : 2*4^(2*q+2)*(q+1:ℕ)*M*Q^(2*q+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t)
    (F : Finset ((template (p+1) (q+1)).Copy G)) (hmem : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ) ≤ supportMainCoeff t p q L T M Q*(U.card:ℝ)^(p+q+2)+
      nonrichErrorCoeff p q M Q*U.card*d^(2*(p+q)+4)+
      supportIncidenceCoeff t p q M Q*Real.sqrt ((U.card:ℝ)^(p+1))*U.card*d^(p+2*q+3)+
      supportIncidenceCoeff t q p M Q*Real.sqrt ((U.card:ℝ)^(q+1))*U.card*d^(q+2*p+3) := by
  classical
  have hd1 : 1 ≤ d := by
    have hp : (0:ℝ) ≤ p := Nat.cast_nonneg p
    have hq : (0:ℝ) ≤ q := Nat.cast_nonneg q
    push_cast at hd
    linarith
  have hD : 1 ≤ Q*d := by nlinarith
  have hl : ∀f∈F, ConnectedCopyBound.Light (template (p+1) (q+1)) G U t f := by
    intro f hf u v w huv hvw huw
    exact hcodeg _ (hmem f hf u) _ (hmem f hf w) (f.injective.ne huw)
  let R (f : (template (p+1) (q+1)).Copy G) :=
    (LongSpider.shortFiber G U t (q+1) (f (.inl (.inl false))) (fun j => f (.inr (.inr j)))).card ≤ L
  let Lf (f : (template (p+1) (q+1)).Copy G) :=
    (LongSpider.shortFiber G U t (p+1) (f (.inl (.inl true))) (fun i => f (.inr (.inl i)))).card ≤ L
  let F₀ := F.filter (fun f => R f ∧ Lf f)
  let FR := F.filter (fun f => ¬R f)
  let FL := F.filter (fun f => ¬Lf f)
  have hs : F ⊆ F₀ ∪ FR ∪ FL := by
    intro f hf
    by_cases hr : R f
    · by_cases hl : Lf f
      · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hr,hl⟩))
      · exact mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩)
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hr⟩))
  have hcard : F.card ≤ F₀.card+FR.card+FL.card := (card_le_card hs).trans
    ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hcard' : (F.card:ℝ) ≤ (F₀.card:ℝ)+FR.card+FL.card := by exact_mod_cast hcard
  have h₀ := nonrich_light_count G U t p q L B T M hf hB hB' hT hT' hD hmax F₀
    (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
    (fun f hf => (mem_filter.mp hf).2.1) (fun f hf => (mem_filter.mp hf).2.2)
  have hR := rich_global_support_count G U t p (q+1) M ht hf hQ (by
    push_cast at hd ⊢
    have hq : (0:ℝ) ≤ q := Nat.cast_nonneg q
    linarith) hlarge hmin hmax hcodeg FR
    (fun f hf => hmem f (mem_filter.mp hf).1)
    (fun f hf => lt_of_le_of_lt hL (Nat.lt_of_not_ge (mem_filter.mp hf).2))
  rw [show p+1+(q+1)=p+q+2 by omega,show p+1+2*(q+1)=p+2*q+3 by omega] at hR
  have hLr := swapped_rich_support_count G U t p q M ht hf hQ (by
    push_cast at hd ⊢
    have hp : (0:ℝ) ≤ p := Nat.cast_nonneg p
    linarith) hlarge' hmin hmax hcodeg FL
    (fun f hf => hmem f (mem_filter.mp hf).1)
    (fun f hf => lt_of_le_of_lt hL' (Nat.lt_of_not_ge (mem_filter.mp hf).2))
  have he : Q^(2*(p+q)+4)=Q^(2*(p+1))*Q^(2*(q+1)) := by
    rw [← pow_add]
    congr 1
    omega
  have he' : Q^(2*(q+p)+4)=Q^(2*(p+1))*Q^(2*(q+1)) := by
    rw [← pow_add]
    congr 1
    omega
  apply hcard'.trans (add_le_add (add_le_add h₀ hR) hLr) |>.trans_eq
  dsimp only [supportMainCoeff,supportIncidenceCoeff,nonrichErrorCoeff]
  rw [he,he',mul_pow]
  ring

end Erdos571.DoubleSpider


/-! Degree estimates from finite sums of lower-degree monomials. -/
namespace Erdos571.MonomialDegree
open Finset

lemma power_dominates {n d K β a : ℝ} (b : ℕ) (hb : 1 ≤ b)
    (hn : 1 ≤ n) (hK : 1 ≤ K) (hd : K*n^β<d) (hscale : a ≤ β*b) :
    K*n^a ≤ d^b := by
  have hK0 : 0 ≤ K := by linarith
  have hn0 : 0 < n := by linarith
  have hbase : 0 ≤ K*n^β := by positivity
  have hp := pow_le_pow_left₀ hbase hd.le b
  have hKpow : K ≤ K^b := by
    obtain ⟨k,hk⟩ := Nat.exists_eq_add_of_le' hb
    subst b
    rw [pow_succ]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (one_le_pow₀ hK) hK0
  have he : (n^β)^b=n^(β*b) := (Real.rpow_mul_natCast hn0.le β b).symm
  rw [mul_pow,he] at hp
  exact (mul_le_mul hKpow (Real.rpow_le_rpow_of_exponent_le hn hscale)
    (Real.rpow_nonneg hn0.le _) (by positivity)).trans hp

/-- If each monomial has the appropriate exponent deficit, a linear expression
in the sum of its coefficients is a sufficient degree constant. -/
theorem bound {I : Type*} [Fintype I] (e : ℕ) (A a : I → ℝ) (b : I → ℕ)
    (hA : ∀i, 0 ≤ A i) (hb : ∀i, b i<e) {n d c β : ℝ}
    (hn : 1 ≤ n) (hc : 0<c) (hscale : ∀i, a i ≤ β*(e-b i:ℕ))
    (hcount : c*d^e ≤ ∑i, A i*n^(a i)*d^(b i)) :
    d ≤ (1+(∑i, A i)/c)*n^β := by
  let K := 1+(∑i, A i)/c
  have hK : 1 ≤ K := by
    have hs : 0 ≤ ∑i, A i := sum_nonneg (fun i _ => hA i)
    dsimp [K]
    linarith [div_nonneg hs hc.le]
  by_contra! hd
  have hn0 : 0<n := by linarith
  have hK0 : 0<K := by linarith
  have hd0 : 0<d := lt_trans (by positivity : 0<K*n^β) hd
  have hm (i : I) : K*(n^(a i)*d^(b i)) ≤ d^e := by
    have hh := mul_le_mul_of_nonneg_right
      (power_dominates (e-b i) (by have := hb i; omega) hn hK hd (hscale i))
      (pow_nonneg hd0.le (b i))
    rw [← pow_add,Nat.sub_add_cancel (hb i).le] at hh
    simpa only [mul_assoc] using hh
  have hsum : K*(∑i, A i*n^(a i)*d^(b i)) ≤ (∑i, A i)*d^e := by
    rw [mul_sum,sum_mul]
    apply sum_le_sum
    intro i hi
    have hh := mul_le_mul_of_nonneg_left (hm i) (hA i)
    nlinarith [hh]
  have hh := (mul_le_mul_of_nonneg_left hcount hK0.le).trans hsum
  have hcoef : K*c ≤ ∑i, A i := by
    apply (mul_le_mul_iff_left₀ (pow_pos hd0 e)).mp
    nlinarith [hh]
  have hkc : K*c=c+∑i, A i := by dsimp [K]; field_simp
  rw [hkc] at hcoef
  linarith

end Erdos571.MonomialDegree


/-! Degree exponents obtained from the support-incidence copy count. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def supportTotalCoeff (t p q L T M : ℕ) (Q : ℝ) : ℝ :=
  supportMainCoeff t p q L T M Q+nonrichErrorCoeff p q M Q+
    supportIncidenceCoeff t p q M Q+supportIncidenceCoeff t q p M Q

/-- A degree bound at any exponent dominating the three remaining monomial
exponents. This does not remove the bounded-codegree hypothesis. -/
theorem support_degree_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t p q L B T M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    (hL : completionThreshold t (p+1) (q+1) M ≤ L) (hL' : completionThreshold t (q+1) (p+1) M ≤ L)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {Q d β : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+2*q+7:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hlarge' : 2*4^(2*q+2)*(q+1:ℕ)*M*Q^(2*q+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t)
    (hβ0 : 0 ≤ β) (hβmain : (p+q+1:ℕ) ≤ β*(2*(p+q)+5:ℕ))
    (hβleft : (p+1:ℕ)/2 ≤ β*(p+2:ℕ)) (hβright : (q+1:ℕ)/2 ≤ β*(q+2:ℕ)) :
    d ≤ (1+4^(2*(p+q)+5)*supportTotalCoeff t p q L T M Q)*(U.card:ℝ)^β := by
  classical
  let n : ℝ := U.card
  let e := 2*(p+q)+5
  let c : ℝ := 1/4^e
  let A : Fin 4 → ℝ := ![supportMainCoeff t p q L T M Q,nonrichErrorCoeff p q M Q,
    supportIncidenceCoeff t p q M Q,supportIncidenceCoeff t q p M Q]
  let a : Fin 4 → ℝ := ![(p+q+1:ℕ),0,(p+1:ℕ)/2,(q+1:ℕ)/2]
  let b : Fin 4 → ℕ := ![0,2*(p+q)+4,p+2*q+3,q+2*p+3]
  have hn : 1 ≤ n := by
    dsimp [n]
    exact_mod_cast (show 1 ≤ U.card from card_pos.mpr hU)
  have hnpos : 0<n := by linarith
  have hc : 0<c := by dsimp [c]; positivity
  have hA : ∀i, 0 ≤ A i := by
    intro i
    fin_cases i <;> simp only [A,Matrix.cons_val_zero,Matrix.cons_val_succ,Matrix.head_cons]
    · dsimp [supportMainCoeff,supportConstant]; positivity
    · dsimp [nonrichErrorCoeff]; positivity
    · dsimp [supportIncidenceCoeff]; positivity
    · dsimp [supportIncidenceCoeff]; positivity
  have hb : ∀i, b i<e := by intro i; fin_cases i <;> simp [b,e] <;> omega
  have hscale : ∀i, a i ≤ β*(e-b i:ℕ) := by
    intro i
    fin_cases i
    · simpa [a,b,e] using hβmain
    · simpa [a,b,e,show 2*(p+q)+5-(2*(p+q)+4)=1 by omega] using hβ0
    · simpa [a,b,e,show 2*(p+q)+5-(p+2*q+3)=p+2 by omega] using hβleft
    · simpa [a,b,e,show 2*(p+q)+5-(q+2*p+3)=q+2 by omega] using hβright
  let F := TreeCopiesIn.copies (template (p+1) (q+1)) G U
  have hmem : ∀f∈F, ∀v, f v∈U := fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf
  have hu := all_bounded_codegree_count G U t p q L B T M ht hf hL hL' hB hB' hT hT'
    hQ hd hlarge hlarge' hmin hmax hcodeg F hmem
  have hl : c*n*d^e ≤ F.card := by
    have hh := all_copies_lower G U p q hd hmin
    rw [show 2*p+2*q+5=2*(p+q)+5 by omega] at hh
    convert hh using 1
    dsimp [c,n,e]
    rw [div_pow]
    field_simp
  have hsqrt (k : ℕ) : Real.sqrt (n^k)=n^((k:ℝ)/2) := by
    rw [Real.sqrt_eq_rpow,← Real.rpow_natCast,← Real.rpow_mul hnpos.le]
    congr 1
    ring
  have hcount : c*d^e ≤ ∑i, A i*n^(a i)*d^(b i) := by
    apply (mul_le_mul_iff_left₀ hnpos).mp
    have hh := hl.trans hu
    change c*n*d^e ≤ _ at hh
    change c*n*d^e ≤ supportMainCoeff t p q L T M Q*n^(p+q+2)+
      nonrichErrorCoeff p q M Q*n*d^(2*(p+q)+4)+
      supportIncidenceCoeff t p q M Q*Real.sqrt (n^(p+1))*n*d^(p+2*q+3)+
      supportIncidenceCoeff t q p M Q*Real.sqrt (n^(q+1))*n*d^(q+2*p+3) at hh
    convert hh using 1
    · ring
    · rw [hsqrt,hsqrt]
      simp only [Fin.sum_univ_succ,A,a,b,Matrix.cons_val_zero,Matrix.cons_val_succ,
        Matrix.head_cons,Fin.sum_univ_zero,add_zero,Real.rpow_natCast,Real.rpow_zero,pow_zero,mul_one,
        show p+q+2=(p+q+1)+1 by omega,pow_succ n]
      ring
  have hh := MonomialDegree.bound e A a b hA hb hn hc hscale hcount
  have hcoef : 1+(∑i, A i)/c=1+4^(2*(p+q)+5)*supportTotalCoeff t p q L T M Q := by
    simp only [Fin.sum_univ_succ,A,Matrix.cons_val_zero,Matrix.cons_val_succ,Matrix.head_cons,
      Fin.sum_univ_zero,add_zero]
    dsimp [c,e,supportTotalCoeff]
    field_simp
    ring
  simpa only [hcoef] using hh

end Erdos571.DoubleSpider


/-! Sharp bounded-codegree exponents for double spiders with sufficiently balanced arms. -/
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization

lemma support_sharp_scales (p q : ℕ) (hpq : p+1 ≤ 2*q) (hqp : q+1 ≤ 2*p) :
    let β : ℝ := (p+q+1:ℕ)/(2*(p+q)+5:ℕ)
    0 ≤ β ∧ (p+q+1:ℕ) ≤ β*(2*(p+q)+5:ℕ) ∧
      (p+1:ℕ)/2 ≤ β*(p+2:ℕ) ∧ (q+1:ℕ)/2 ≤ β*(q+2:ℕ) := by
  dsimp only
  have hden : (0:ℝ)<(2*(p+q)+5:ℕ) := by positivity
  have hpq' : (p:ℝ)+1 ≤ 2*q := by exact_mod_cast hpq
  have hqp' : (q:ℝ)+1 ≤ 2*p := by exact_mod_cast hqp
  refine ⟨by positivity,?_,?_,?_⟩
  · rw [div_mul_cancel₀ _ hden.ne']
  · rw [div_mul_eq_mul_div,le_div_iff₀ hden]
    push_cast
    nlinarith
  · rw [div_mul_eq_mul_div,le_div_iff₀ hden]
    push_cast
    nlinarith

/-- The sharp rooted-density degree exponent is proved under bounded codegrees
when each side has at least half the other side's arms plus one. -/
theorem sharp_bounded_codegree_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t p q L B T M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) (q+1) M).Free G)
    (hpq : p+1 ≤ 2*q) (hqp : q+1 ≤ 2*p)
    (hL : completionThreshold t (p+1) (q+1) M ≤ L) (hL' : completionThreshold t (q+1) (p+1) M ≤ L)
    (hB : TwoShortSpider.richThreshold t p q M ≤ B) (hB' : TwoShortSpider.richThreshold t q p M ≤ B)
    (hT : OneShortSpider.richThreshold t p q L B M ≤ T) (hT' : OneShortSpider.richThreshold t q p L B M ≤ T)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+2*q+7:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hlarge' : 2*4^(2*q+2)*(q+1:ℕ)*M*Q^(2*q+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t) :
    d ≤ (1+4^(2*(p+q)+5)*supportTotalCoeff t p q L T M Q)*
      (U.card:ℝ)^((p+q+1:ℕ)/(2*(p+q)+5:ℕ):ℝ) := by
  have hb := support_sharp_scales p q hpq hqp
  exact support_degree_bound G U hU t p q L B T M ht hf hL hL' hB hB' hT hT'
    hQ hd hlarge hlarge' hmin hmax hcodeg hb.1 hb.2.1 hb.2.2.1 hb.2.2.2

/-- For the asymmetric `(2,3)` double spider the new bounded-codegree degree
exponent is `3/8`, improving the previous `2/5` but not reaching `4/11`. -/
theorem two_three_bounded_codegree_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (t L B T M : ℕ) (ht : 1 ≤ t) (hf : (graph 2 3 M).Free G)
    (hL : completionThreshold t 2 3 M ≤ L) (hL' : completionThreshold t 3 2 M ≤ L)
    (hB : TwoShortSpider.richThreshold t 1 2 M ≤ B) (hB' : TwoShortSpider.richThreshold t 2 1 M ≤ B)
    (hT : OneShortSpider.richThreshold t 1 2 L B M ≤ T) (hT' : OneShortSpider.richThreshold t 2 1 L B M ≤ T)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 52 ≤ d)
    (hlarge : 1024*M*Q^3 ≤ d) (hlarge' : 24576*M*Q^5 ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hcodeg : ∀u∈U, ∀v∈U, u≠v → (FourthMoment.common G U u v).card<t) :
    d ≤ (1+4^11*supportTotalCoeff t 1 2 L T M Q)*(U.card:ℝ)^(3/8:ℝ) := by
  apply support_degree_bound G U hU t 1 2 L B T M ht hf hL hL' hB hB' hT hT' hQ
    (by norm_num; exact hd) (by norm_num; exact hlarge) (by norm_num; exact hlarge') hmin hmax hcodeg
  all_goals norm_num

end Erdos571.DoubleSpider


/-! Incidence bounds retaining the off-diagonal codegree excess explicitly. -/
namespace Erdos571.BoundedCodegreeCross
open Finset SimpleGraph DensityRegularization FourthMoment
variable {W : Type*} [DecidableEq W]

noncomputable def excess (G : SimpleGraph W) [DecidableRel G.Adj]
    (S Y : Finset W) (t : ℕ) : ℕ := by
  classical
  exact ∑y∈Y, ∑z∈Y, if y=z then 0 else (common G S y z).card-t

lemma moment_bound_excess (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) (t : ℕ) :
    (∑x∈S, (neighbors G Y x).card^2) ≤
      t*Y.card^2+(edges G S Y).card+excess G S Y t := by
  classical
  rw [moment,sum_product]
  have hp (y z : W) : (common G S y z).card ≤
      t+(if y=z then (neighbors G S y).card else 0)+
        (if y=z then 0 else (common G S y z).card-t) := by
    by_cases he : y=z
    · subst z
      have hc : common G S y y=neighbors G S y := by ext v; simp [common,neighbors]
      rw [hc,if_pos rfl,if_pos rfl]
      omega
    · simp only [he,ite_false,add_zero,zero_add]
      omega
  calc
    _ ≤ ∑y∈Y, ∑z∈Y, (t+(if y=z then (neighbors G S y).card else 0)+
        (if y=z then 0 else (common G S y z).card-t)) :=
      sum_le_sum (fun y hy => sum_le_sum (fun z hz => hp y z))
    _ = _ := by
      simp only [sum_add_distrib,sum_const,nsmul_eq_mul]
      simp only [sum_ite_eq,card_edges_right,excess]
      simp only [sum_ite_mem,inter_self,Nat.cast_id]
      ring

/-- Without any codegree assumption, the failure of the rectangular bound is
measured by one square root of the off-diagonal excess. -/
theorem bound_excess (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) (t : ℕ) :
    ((edges G S Y).card:ℝ) ≤ S.card+Real.sqrt ((t:ℝ)*S.card)*Y.card+
      Real.sqrt ((S.card:ℝ)*excess G S Y t) := by
  have hm : (∑x∈S, ((neighbors G Y x).card:ℝ)^2) ≤
      (t:ℝ)*(Y.card:ℝ)^2+(edges G S Y).card+excess G S Y t := by
    exact_mod_cast moment_bound_excess G S Y t
  have he : (∑x∈S, ((neighbors G Y x).card:ℝ))=(edges G S Y).card := by
    exact_mod_cast (card_edges_left G S Y).symm
  have hc := sq_sum_le_card_mul_sum_sq (s:=S) (f:=fun x => ((neighbors G Y x).card:ℝ))
  rw [he] at hc
  have hh := hc.trans (mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg S.card))
  have hs₁ : (Real.sqrt ((t:ℝ)*S.card)*Y.card)^2=(t:ℝ)*S.card*(Y.card:ℝ)^2 := by
    rw [mul_pow,Real.sq_sqrt (by positivity)]
  have hs₂ : (Real.sqrt ((S.card:ℝ)*excess G S Y t))^2=(S.card:ℝ)*excess G S Y t :=
    Real.sq_sqrt (by positivity)
  have hcross : 0 ≤ (Real.sqrt ((t:ℝ)*S.card)*Y.card)*Real.sqrt ((S.card:ℝ)*excess G S Y t) := by positivity
  have hb := quadratic_bound (s:=(S.card:ℝ)) (z:=Real.sqrt ((t:ℝ)*S.card)*Y.card+
    Real.sqrt ((S.card:ℝ)*excess G S Y t)) (Nat.cast_nonneg _) (by positivity) (by nlinarith [hh])
  simpa only [add_assoc] using hb

lemma excess_eq_zero (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W) (t : ℕ)
    (h : ∀y∈Y, ∀z∈Y, y≠z → (common G S y z).card≤t) : excess G S Y t=0 := by
  classical
  unfold excess
  apply sum_eq_zero
  intro y hy
  apply sum_eq_zero
  intro z hz
  split_ifs with he
  · rfl
  · exact Nat.sub_eq_zero_of_le (h y hy z hz he)

end Erdos571.BoundedCodegreeCross


/-! Rich-center support with an explicit nonlight-extension error. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def supportNonlight (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t p q : ℕ) (rR : Fin q → W) :
    Finset ((LongSpider.template (p+1)).Copy G) := by
  classical
  exact (TreeCopiesIn.centeredAvoiding (LongSpider.template (p+1)) G U S (univ.image rR) (.inl none)).filter
    (fun f => ¬ConnectedCopyBound.Light (LongSpider.template (p+1)) G U t f)

/-- The support estimate without any host codegree assumption. All discarded
nonlight left extensions are retained as an additive error. -/
theorem rich_center_support_with_nonlight (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    (hSU : S⊆U) (havoid : ∀x∈S, ∀j, x≠rR j)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+q+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hrich : ∀x∈S, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q x rR).card) :
    (S.card:ℝ)*d^(2*p+2) ≤ supportConstant t p q M*(U.card:ℝ)^(p+1)+
      2*4^(2*p+2)*(supportNonlight G U S t p q rR).card := by
  classical
  let Z := univ.image rR
  have hZ : Z.card=q := by simp [Z,card_image_of_injective _ rR.injective]
  let F := TreeCopiesIn.centeredAvoiding (LongSpider.template (p+1)) G U S Z (.inl none)
  let FL := F.filter (ConnectedCopyBound.Light (LongSpider.template (p+1)) G U t)
  let FB := supportNonlight G U S t p q rR
  have hm (f) (hf : f∈F) := (TreeCopiesIn.mem_centeredAvoiding _ _ _ _ _ _ _).mp hf
  have hcardV : Fintype.card (Option (Fin (p+1)) ⊕ Fin (p+1))=2*p+3 := by simp; omega
  have hSZ : Disjoint S Z := by
    apply Finset.disjoint_left.mpr
    intro x hx hz
    obtain ⟨j,hj,he⟩ := mem_image.mp hz
    exact havoid x hx j he.symm
  have hd0 : 0 ≤ d := by
    have : (0:ℝ) ≤ (2*p+q+4:ℕ) := Nat.cast_nonneg _
    linarith
  have hlow : (S.card:ℝ)*(d/4)^(2*p+2) ≤ F.card := by
    have hh := TreeCopiesIn.centered_avoiding_lower (LongSpider.template (p+1)) (LongSpider.isTree _)
      G U S Z (.inl none) hSU hSZ (d:=d) (by
        rw [hcardV,hZ]
        push_cast at hd ⊢
        linarith) hmin
    simpa only [hcardV,show 2*p+3-1=2*p+2 by omega] using hh
  have hup := support_light_count G U S t p q M ht hf rR (show 0 ≤ Q*d by positivity) hmax FL
    (fun f hf => (hm f (mem_filter.mp hf).1).1) (fun f hf => (hm f (mem_filter.mp hf).1).2.1)
    (fun f hf => (mem_filter.mp hf).2) (by
      intro f hf v j he
      exact (hm f (mem_filter.mp hf).1).2.2 v (mem_image.mpr ⟨j,mem_univ _,he.symm⟩))
    (fun f hf => hrich _ (hm f (mem_filter.mp hf).1).2.1)
  have hsplit : (F.card:ℝ)=(FL.card:ℝ)+FB.card := by
    exact_mod_cast (card_filter_add_card_filter_not
      (s:=F) (p:=ConnectedCopyBound.Light (LongSpider.template (p+1)) G U t)).symm
  let A : ℝ := (M*(p+2)*nestedLoad t p q M:ℕ)*(U.card:ℝ)^(p+1)+FB.card
  let E : ℝ := (p+1:ℕ)*M*Q^(2*p+1)
  let c : ℝ := 1/4^(2*p+2)
  have hc : 0<c := by dsimp [c]; positivity
  have hbig : 2*E ≤ c*d := by
    dsimp only [E,c]
    rw [one_div_mul_eq_div,le_div_iff₀ (by positivity : 0<(4:ℝ)^(2*p+2))]
    nlinarith [hlarge]
  have he : (p+1:ℕ)*((M:ℝ)*S.card*(Q*d)^(2*p+1))=E*S.card*d^(2*p+1) := by
    rw [mul_pow]
    dsimp [E]
    ring
  rw [he] at hup
  have hlower : c*S.card*d^(2*p+2) ≤ F.card := by
    convert hlow using 1
    dsimp [c]
    rw [div_pow]
    field_simp
  have hh : c*S.card*d^((2*p+1)+1) ≤ A+E*S.card*d^(2*p+1) := by
    rw [hsplit] at hlower
    change c*S.card*d^(2*p+2) ≤ _
    dsimp only [A]
    linarith
  have hb := LowerOrderAbsorption.support_bound (2*p+1) (Nat.cast_nonneg S.card) hd0 hc hbig hh
  have hcoef : 2*A/c=supportConstant t p q M*(U.card:ℝ)^(p+1)+2*4^(2*p+2)*FB.card := by
    dsimp [A,c,supportConstant]
    field_simp
  simpa only [hcoef,show 2*p+1+1=2*p+2 by omega] using hb

/-- It suffices to bound the discarded nonlight extensions by one quarter of
the greedy lower count; codegrees need not be globally bounded. -/
theorem rich_center_support_of_sparse_nonlight (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    (hSU : S⊆U) (havoid : ∀x∈S, ∀j, x≠rR j)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+q+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hrich : ∀x∈S, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q x rR).card)
    (hbad : 4*4^(2*p+2)*(supportNonlight G U S t p q rR).card ≤ (S.card:ℝ)*d^(2*p+2)) :
    (S.card:ℝ)*d^(2*p+2) ≤ 2*supportConstant t p q M*(U.card:ℝ)^(p+1) := by
  have hb := rich_center_support_with_nonlight G U S t p q M ht hf rR hSU havoid hQ hd hlarge hmin hmax hrich
  nlinarith

end Erdos571.DoubleSpider


/-! Local heavy two-path masses, at their middle and at an endpoint. -/
namespace Erdos571.HeavyPathMass
open Finset SimpleGraph DensityRegularization FourthMoment
variable {W : Type} [DecidableEq W]

noncomputable def forwardPairs (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (x : W) : Finset (W×W) := by
  classical
  exact (U×ˢU).filter (fun p => G.Adj x p.1 ∧ G.Adj p.1 p.2 ∧ ShortSpider.Bad G U t x p.2)

noncomputable def middleMass (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t : ℕ) : ℕ := ∑x∈S, (ShortSpider.badPairs G U t x).card

noncomputable def forwardMass (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t : ℕ) : ℕ := ∑x∈S, (forwardPairs G U t x).card

lemma common_mono (G : SimpleGraph W) [DecidableRel G.Adj] {S U : Finset W}
    (hSU : S⊆U) (y z : W) : common G S y z ⊆ common G U y z := filter_subset_filter _ hSU

/-- Codegree excess across arbitrary center sets is charged to heavy two-paths
whose middle belongs to the support set. -/
lemma excess_le_middleMass (G : SimpleGraph W) [DecidableRel G.Adj] (U S Y : Finset W)
    (t : ℕ) (hSU : S⊆U) (hYU : Y⊆U) :
    BoundedCodegreeCross.excess G S Y t ≤ middleMass G U S t := by
  classical
  let R (p : W×W) (x : W) := G.Adj p.1 x ∧ G.Adj p.2 x ∧ ShortSpider.Bad G U t p.1 p.2
  have hp (p : W×W) : (if p.1=p.2 then 0 else (common G S p.1 p.2).card-t) ≤
      (bipartiteAbove R S p).card := by
    by_cases he : p.1=p.2
    · simp only [he,ite_true]; omega
    by_cases hb : ShortSpider.Bad G U t p.1 p.2
    · have hc : bipartiteAbove R S p=common G S p.1 p.2 := by
        ext x
        simp only [bipartiteAbove,R,common,mem_filter,hb,and_true]
      rw [hc,if_neg he]
      exact Nat.sub_le _ _
    · have hsmall : (common G U p.1 p.2).card<t := by
        have hh : ¬(p.1=p.2 ∨ t≤(common G U p.1 p.2).card) := hb
        omega
      have hc := card_le_card (common_mono G hSU p.1 p.2)
      rw [if_neg he,Nat.sub_eq_zero_of_le (by omega)]
      omega
  have hcount := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (s:=Y×ˢY) (t:=S) R
  calc
    _ = ∑p∈Y×ˢY, (if p.1=p.2 then 0 else (common G S p.1 p.2).card-t) := by
      simp only [BoundedCodegreeCross.excess,sum_product]
    _ ≤ ∑p∈Y×ˢY, (bipartiteAbove R S p).card := sum_le_sum (fun p hp' => hp p)
    _ = ∑x∈S, (bipartiteBelow R (Y×ˢY) x).card := hcount
    _ ≤ ∑x∈S, (ShortSpider.badPairs G U t x).card := by
      apply sum_le_sum
      intro x hx
      apply card_le_card
      intro p hp'
      have hm := (mem_filter.mp hp').1
      have hr : R p x := (mem_filter.mp hp').2
      apply mem_filter.mpr
      refine ⟨mem_product.mpr ⟨?_,?_⟩,hr.2.2⟩
      · exact mem_filter.mpr ⟨hYU (mem_product.mp hm).1,hr.1.symm⟩
      · exact mem_filter.mpr ⟨hYU (mem_product.mp hm).2,hr.2.1.symm⟩
    _ = _ := rfl

lemma cross_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U S Y : Finset W)
    (t : ℕ) (hSU : S⊆U) (hYU : Y⊆U) :
    ((BoundedCodegreeCross.edges G S Y).card:ℝ) ≤
      S.card+Real.sqrt ((t:ℝ)*S.card)*Y.card+Real.sqrt ((S.card:ℝ)*middleMass G U S t) := by
  exact (BoundedCodegreeCross.bound_excess G S Y t).trans (add_le_add (le_refl _)
    (Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left (show (BoundedCodegreeCross.excess G S Y t:ℝ) ≤ middleMass G U S t by
      exact_mod_cast excess_le_middleMass G U S Y t hSU hYU)
      (Nat.cast_nonneg S.card))))

/-- Reversing a two-path preserves its endpoint heaviness. -/
lemma bad_symm (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) {x y : W}
    (h : ShortSpider.Bad G U t x y) : ShortSpider.Bad G U t y x := by
  rcases h with he|hh
  · exact Or.inl he.symm
  · right
    have hc : common G U x y=common G U y x := by ext z; simp [common,and_comm]
    rwa [← hc]

end Erdos571.HeavyPathMass


/-! Nonlight-copy counts retaining the selected center set. -/
set_option maxHeartbeats 1500000
namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization HeavyPathMass
variable {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]

/-- Prescribing three vertices, one in `S` and the other two in a pair family,
leaves exactly `|V|-3` maximum-degree factors. -/
lemma fixed_three_over (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (pairs : W → Finset (W×W))
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (r a b : V) (hra : r≠a) (hrb : r≠b) (hab : a≠b)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U)
    (hcenter : ∀f∈F, f r∈S) (hpair : ∀f∈F, (f a,f b)∈pairs (f r)) :
    (F.card:ℝ) ≤ (∑x∈S, ((pairs x).card:ℝ))*D^(Fintype.card V-3) := by
  classical
  let C : Finset V := {r,a,b}
  have hC : C.card=3 := by simp [C,hra,hrb,hab]
  let center : H.Copy G → W := fun f => f r
  have he : (F.card:ℝ)=∑x∈S, ((F.filter (fun f => center f=x)).card:ℝ) := by
    exact_mod_cast card_eq_sum_card_fiberwise (show Set.MapsTo center F S from hcenter)
  rw [he,sum_mul]
  apply sum_le_sum
  intro x hx
  let F₁ := F.filter (fun f => center f=x)
  let ev : H.Copy G → W×W := fun f => (f a,f b)
  apply RealFiberCount.bound F₁ (pairs x) ev
  · intro f hf
    have hh := hpair f (mem_filter.mp hf).1
    have hfx : f r=x := (mem_filter.mp hf).2
    rwa [hfx] at hh
  · intro p hp
    let F₂ := F₁.filter (fun f => ev f=p)
    change (F₂.card:ℝ) ≤ _
    by_cases hn : F₂.Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
    obtain ⟨f₀,hf₀⟩ := hn
    have hfix : ∀f∈F₂, ∀v∈C, f v=f₀ v := by
      intro f hf v hv
      have he : ev f=ev f₀ := (mem_filter.mp hf).2.trans (mem_filter.mp hf₀).2.symm
      have hcenter : f r=f₀ r := (mem_filter.mp (mem_filter.mp hf).1).2.trans
        (mem_filter.mp (mem_filter.mp hf₀).1).2.symm
      simp only [C,mem_insert,mem_singleton] at hv
      rcases hv with rfl|rfl|rfl
      · exact hcenter
      · exact congrArg Prod.fst he
      · exact congrArg Prod.snd he
    simpa only [hC] using bound H hH G U hD hdeg C (by simp [C]) f₀ F₂
      (fun f hf => hmem f (mem_filter.mp (mem_filter.mp hf).1).1) hfix

lemma fixed_two_path_middle (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t : ℕ) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (u v w : V) (huv : H.Adj u v) (hvw : H.Adj v w) (huw : u≠w)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀x, f x∈U)
    (hcenter : ∀f∈F, f v∈S) (hbad : ∀f∈F, ShortSpider.Bad G U t (f u) (f w)) :
    (F.card:ℝ) ≤ (middleMass G U S t:ℝ)*D^(Fintype.card V-3) := by
  have hb := fixed_three_over H hH G U S (ShortSpider.badPairs G U t) hD hdeg v u w
    huv.ne' hvw.ne huw F hmem hcenter (by
      intro f hf
      apply mem_filter.mpr
      refine ⟨mem_product.mpr ⟨?_,?_⟩,hbad f hf⟩
      · exact mem_filter.mpr ⟨hmem f hf u,f.toHom.map_adj huv.symm⟩
      · exact mem_filter.mpr ⟨hmem f hf w,f.toHom.map_adj hvw⟩)
  simpa only [middleMass,Nat.cast_sum] using hb

lemma fixed_two_path_endpoint (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t : ℕ) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (u v w : V) (huv : H.Adj u v) (hvw : H.Adj v w) (huw : u≠w)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀x, f x∈U)
    (hcenter : ∀f∈F, f u∈S) (hbad : ∀f∈F, ShortSpider.Bad G U t (f u) (f w)) :
    (F.card:ℝ) ≤ (forwardMass G U S t:ℝ)*D^(Fintype.card V-3) := by
  classical
  have hb := fixed_three_over H hH G U S (forwardPairs G U t) hD hdeg u v w
    huv.ne huw hvw.ne F hmem hcenter (by
      intro f hf
      exact mem_filter.mpr ⟨mem_product.mpr ⟨hmem f hf v,hmem f hf w⟩,
        f.toHom.map_adj huv,f.toHom.map_adj hvw,hbad f hf⟩)
  simpa only [forwardMass,Nat.cast_sum] using hb

/-- A two-path-central vertex belongs to every nonbacktracking two-edge path.
For such templates, nonlight errors can be counted locally at the chosen center. -/
def TwoPathCentral (H : SimpleGraph V) (r : V) : Prop :=
  ∀u v w, H.Adj u v → H.Adj v w → u≠w → r=u ∨ r=v ∨ r=w

lemma centered_nonlight_bound (H : SimpleGraph V) (hH : H.Connected) (r : V) (hr : TwoPathCentral H r)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U) (hcenter : ∀f∈F, f r∈S)
    (hbad : ∀f∈F, ¬Light H G U t f) :
    (F.card:ℝ) ≤ (Fintype.card V:ℝ)^3*(middleMass G U S t+forwardMass G U S t:ℕ)*D^(Fintype.card V-3) := by
  classical
  let B (p : V×V×V) := F.filter (fun f => H.Adj p.1 p.2.1 ∧ H.Adj p.2.1 p.2.2 ∧
    p.1≠p.2.2 ∧ ShortSpider.Bad G U t (f p.1) (f p.2.2))
  have hsub : F⊆univ.biUnion B := by
    intro f hf
    have hh := hbad f hf
    simp only [Light,not_forall,not_lt] at hh
    obtain ⟨u,v,w,huv,hvw,huw,hh⟩ := hh
    exact mem_biUnion.mpr ⟨(u,v,w),mem_univ _,mem_filter.mpr ⟨hf,huv,hvw,huw,Or.inr hh⟩⟩
  have hb (p : V×V×V) : ((B p).card:ℝ) ≤ (middleMass G U S t+forwardMass G U S t:ℕ)*D^(Fintype.card V-3) := by
    by_cases hn : (B p).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
    obtain ⟨f₀,hf₀⟩ := hn
    have hh := (mem_filter.mp hf₀).2
    have hm : ∀f∈B p, ∀v, f v∈U := fun f hf => hmem f (mem_filter.mp hf).1
    have hbad' : ∀f∈B p, ShortSpider.Bad G U t (f p.1) (f p.2.2) := fun f hf => (mem_filter.mp hf).2.2.2.2
    have hfm : (forwardMass G U S t:ℝ) ≤ (middleMass G U S t+forwardMass G U S t:ℕ) := by
      exact_mod_cast Nat.le_add_left (forwardMass G U S t) (middleMass G U S t)
    have hmm : (middleMass G U S t:ℝ) ≤ (middleMass G U S t+forwardMass G U S t:ℕ) := by
      exact_mod_cast Nat.le_add_right (middleMass G U S t) (forwardMass G U S t)
    rcases hr p.1 p.2.1 p.2.2 hh.1 hh.2.1 hh.2.2.1 with hru|hrv|hrw
    · have h := fixed_two_path_endpoint H hH G U S t hD hdeg p.1 p.2.1 p.2.2 hh.1 hh.2.1 hh.2.2.1
        (B p) hm (fun f hf => hru ▸ hcenter f (mem_filter.mp hf).1) hbad'
      exact h.trans (mul_le_mul_of_nonneg_right hfm (by positivity))
    · have h := fixed_two_path_middle H hH G U S t hD hdeg p.1 p.2.1 p.2.2 hh.1 hh.2.1 hh.2.2.1
        (B p) hm (fun f hf => hrv ▸ hcenter f (mem_filter.mp hf).1) hbad'
      exact h.trans (mul_le_mul_of_nonneg_right hmm (by positivity))
    · have h := fixed_two_path_endpoint H hH G U S t hD hdeg p.2.2 p.2.1 p.1 hh.2.1.symm hh.1.symm hh.2.2.1.symm
        (B p) hm (fun f hf => hrw ▸ hcenter f (mem_filter.mp hf).1)
        (fun f hf => HeavyPathMass.bad_symm G U t (hbad' f hf))
      exact h.trans (mul_le_mul_of_nonneg_right hfm (by positivity))
  calc
    _ ≤ ((univ.biUnion B).card:ℝ) := by exact_mod_cast card_le_card hsub
    _ ≤ ∑p : V×V×V, ((B p).card:ℝ) := by exact_mod_cast card_biUnion_le
    _ ≤ ∑_p : V×V×V, ((middleMass G U S t+forwardMass G U S t:ℕ):ℝ)*D^(Fintype.card V-3) := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp [Fintype.card_prod,pow_succ,mul_assoc]

end Erdos571.ConnectedCopyBound


/-! Rich-center support reduced to local heavy two-path masses. -/
namespace Erdos571.LongSpider
open SimpleGraph

lemma noncentral_neighbor_unique (s : ℕ) (v : Option (Fin s) ⊕ Fin s) (hv : v≠.inl none) :
    ∀u w, (template s).Adj v u → (template s).Adj v w →
      u≠.inl none → w≠.inl none → u=w := by
  intro u w hvu hvw hu hw
  cases v with
  | inl a =>
    cases a with
    | none => exact (hv rfl).elim
    | some j =>
      have hu' : u=Sum.inr j := by
        cases u with
        | inl b => cases b with
          | none => exact (hu rfl).elim
          | some k => exact hvu.elim
        | inr k => exact congrArg Sum.inr (Option.some.inj hvu).symm
      have hw' : w=Sum.inr j := by
        cases w with
        | inl b => cases b with
          | none => exact (hw rfl).elim
          | some k => exact hvw.elim
        | inr k => exact congrArg Sum.inr (Option.some.inj hvw).symm
      exact hu'.trans hw'.symm
  | inr j =>
    have hu' : u=Sum.inl (some j) := by
      cases u with
      | inl a => exact congrArg Sum.inl hvu.symm
      | inr k => exact hvu.elim
    have hw' : w=Sum.inl (some j) := by
      cases w with
      | inl a => exact congrArg Sum.inl hvw.symm
      | inr k => exact hvw.elim
    exact hu'.trans hw'.symm

lemma twoPathCentral (s : ℕ) : ConnectedCopyBound.TwoPathCentral (template s) (.inl none) := by
  intro u v w huv hvw huw
  by_cases hv : v=Sum.inl none
  · exact Or.inr (Or.inl hv.symm)
  by_cases hu : u=Sum.inl none
  · exact Or.inl hu.symm
  by_cases hw : w=Sum.inl none
  · exact Or.inr (Or.inr hw.symm)
  exact (huw (noncentral_neighbor_unique s v hv u w huv.symm hvw hu hw)).elim

end Erdos571.LongSpider

namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization HeavyPathMass
variable {W : Type} [Fintype W] [DecidableEq W]

lemma supportNonlight_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q : ℕ) (rR : Fin q → W) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    ((supportNonlight G U S t p q rR).card:ℝ) ≤
      (2*p+3:ℕ)^3*(middleMass G U S t+forwardMass G U S t:ℕ)*D^(2*p) := by
  classical
  have hm (f) (hf : f∈supportNonlight G U S t p q rR) :=
    (TreeCopiesIn.mem_centeredAvoiding _ _ _ _ _ _ _).mp (mem_filter.mp hf).1
  have hb := ConnectedCopyBound.centered_nonlight_bound (LongSpider.template (p+1))
    (LongSpider.connected _) (.inl none) (LongSpider.twoPathCentral _) G U S t hD hdeg
    (supportNonlight G U S t p q rR) (fun f hf => (hm f hf).1)
    (fun f hf => (hm f hf).2.1) (fun f hf => (mem_filter.mp hf).2)
  have he : Fintype.card (Option (Fin (p+1)) ⊕ Fin (p+1))=2*p+3 := by simp; omega
  simpa only [he,show 2*p+3-3=2*p by omega] using hb

/-- No bounded-codegree assumption: the error depends only on heavy two-paths
at, or starting at, the rich-center support. -/
theorem rich_center_support_with_mass (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    (hSU : S⊆U) (havoid : ∀x∈S, ∀j, x≠rR j)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+q+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hrich : ∀x∈S, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q x rR).card) :
    (S.card:ℝ)*d^(2*p+2) ≤ supportConstant t p q M*(U.card:ℝ)^(p+1)+
      2*4^(2*p+2)*(2*p+3:ℕ)^3*Q^(2*p)*(middleMass G U S t+forwardMass G U S t:ℕ)*d^(2*p) := by
  have hd0 : 0 ≤ d := by
    have : (0:ℝ) ≤ (2*p+q+4:ℕ) := Nat.cast_nonneg _
    linarith
  have hb := rich_center_support_with_nonlight G U S t p q M ht hf rR hSU havoid hQ hd hlarge hmin hmax hrich
  have hbad := supportNonlight_bound G U S t p q rR (show 0 ≤ Q*d by positivity) hmax
  have hh := mul_le_mul_of_nonneg_left hbad (show 0 ≤ (2:ℝ)*4^(2*p+2) by positivity)
  apply hb.trans (add_le_add (le_refl _) hh) |>.trans_eq
  rw [mul_pow]
  ring

/-- A local heavy-path density condition suffices for the constant support
estimate, even when some host codegrees are arbitrarily large. -/
theorem rich_center_support_of_sparse_mass (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hf : (graph (p+1) q M).Free G) (rR : Fin q ↪ W)
    (hSU : S⊆U) (havoid : ∀x∈S, ∀j, x≠rR j)
    {Q d : ℝ} (hQ : 1 ≤ Q) (hd : 4*(2*p+q+4:ℕ) ≤ d)
    (hlarge : 2*4^(2*p+2)*(p+1:ℕ)*M*Q^(2*p+1) ≤ d)
    (hmin : ∀v∈U, d ≤ ((neighbors G U v).card:ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ Q*d)
    (hrich : ∀x∈S, completionThreshold t (p+1) q M <
      (LongSpider.shortFiber G U t q x rR).card)
    (hmass : 4*4^(2*p+2)*(2*p+3:ℕ)^3*Q^(2*p)*(middleMass G U S t+forwardMass G U S t:ℕ) ≤ (S.card:ℝ)*d^2) :
    (S.card:ℝ)*d^(2*p+2) ≤ 2*supportConstant t p q M*(U.card:ℝ)^(p+1) := by
  have hd0 : 0 ≤ d := by
    have : (0:ℝ) ≤ (2*p+q+4:ℕ) := Nat.cast_nonneg _
    linarith
  have hb := rich_center_support_with_mass G U S t p q M ht hf rR hSU havoid hQ hd hlarge hmin hmax hrich
  have hh := mul_le_mul_of_nonneg_right hmass (pow_nonneg hd0 (2*p))
  have he : d^2*d^(2*p)=d^(2*p+2) := by rw [← pow_add]; congr 1; omega
  rw [mul_assoc (S.card:ℝ),he] at hh
  nlinarith

end Erdos571.DoubleSpider


/-! Core-incidence counting with no codegree assumption. -/
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma core_incidence_excess_count (G : SimpleGraph W) [DecidableRel G.Adj] (U S Y : Finset W)
    (t p q : ℕ) {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template p q).Copy G)) (rR : Fin q → W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hroot : ∀f∈F, ∀j, f (.inr (.inr j))=rR j)
    (hS : ∀f∈F, f (.inl (.inl false))∈S) (hY : ∀f∈F, f (.inl (.inl true))∈Y) :
    (F.card:ℝ) ≤ (S.card+Real.sqrt ((t:ℝ)*S.card)*Y.card+Real.sqrt ((S.card:ℝ)*BoundedCodegreeCross.excess G S Y t))*(D^(2*p)*(t:ℝ)^q) := by
  classical
  let ev : (template p q).Copy G → W×W := fun f => (f (.inl (.inl false)),f (.inl (.inl true)))
  have hm : Set.MapsTo ev F (BoundedCodegreeCross.edges G S Y) := by
    intro f hf
    apply mem_filter.mpr
    refine ⟨mem_product.mpr ⟨hS f hf,hY f hf⟩,?_⟩
    exact f.toHom.map_adj (show (template p q).Adj (.inl (.inl false)) (.inl (.inl true)) from Bool.noConfusion)
  have hb := RealFiberCount.bound F (BoundedCodegreeCross.edges G S Y) ev hm (by
    intro e he
    apply fixed_centers_count G U t p q hD hdeg _ rR e.1 e.2
      (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
      (fun f hf => hroot f (mem_filter.mp hf).1)
    · intro f hf; exact congrArg Prod.fst (mem_filter.mp hf).2
    · intro f hf; exact congrArg Prod.snd (mem_filter.mp hf).2)
  exact hb.trans (mul_le_mul_of_nonneg_right (BoundedCodegreeCross.bound_excess G S Y t) (by positivity))

end Erdos571.DoubleSpider


/-! A global incidence estimate retaining the rooted core-codegree excess. -/
set_option maxHeartbeats 2000000
namespace Erdos571.DoubleSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def rootedCoreExcess (G : SimpleGraph W) [DecidableRel G.Adj]
    (t p q : ℕ) (F : Finset ((template p q).Copy G)) : ℕ := by
  classical
  let root : (template p q).Copy G → Fin q → W := fun f j => f (.inr (.inr j))
  let A := F.image (fun f => f.comp (rightCopy p q))
  exact ∑r∈F.image root, BoundedCodegreeCross.excess G
    ((F.filter (fun f => root f=r)).image (fun f => f (.inl (.inl false))))
    ((A.filter (fun g => (fun j => g (.inr j))=r)).image (fun g => g (.inl none))) t

lemma sum_sqrt_product_bound {I : Type*} (R : Finset I) (E : I → ℝ) (hE : ∀i, 0≤E i)
    {B : ℝ} (hB : 0≤B) :
    (∑i∈R, Real.sqrt (B*E i)) ≤ Real.sqrt (B*R.card*(∑i∈R, E i)) := by
  have hc := sq_sum_le_card_mul_sum_sq (s:=R) (f:=fun i => Real.sqrt (B*E i))
  have he : (∑i∈R, (Real.sqrt (B*E i))^2)=B*∑i∈R, E i := by
    rw [mul_sum]
    exact sum_congr rfl (fun i hi => Real.sq_sqrt (mul_nonneg hB (hE i)))
  rw [he] at hc
  apply Real.le_sqrt_of_sq_le
  nlinarith [hc]

/-- The uniform codegree assumption is replaced by a single explicit sum of
excesses for the root-conditioned core-center sets. -/
theorem global_incidence_excess_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q : ℕ) {D B : ℝ} (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset ((template p q).Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template p q) G U t f)
    (hsupport : ∀r : Fin q ↪ W, ∀F' : Finset ((template p q).Copy G), F'⊆F →
      (∀f∈F', ∀j, f (.inr (.inr j))=r j) →
      ((F'.image (fun f => f (.inl (.inl false)))).card:ℝ) ≤ B) :
    (F.card:ℝ) ≤ (D^(2*p)*(t:ℝ)^q)*
      (B*(U.card:ℝ)^q+Real.sqrt ((t:ℝ)*B)*U.card*D^(2*q)+
        Real.sqrt (B*(U.card:ℝ)^q*rootedCoreExcess G t p q F)) := by
  classical
  let root : (template p q).Copy G → Fin q → W := fun f j => f (.inr (.inr j))
  let rproj : (template p q).Copy G → (LongSpider.template q).Copy G := fun f => f.comp (rightCopy p q)
  let roots : (LongSpider.template q).Copy G → Fin q → W := fun g j => g (.inr j)
  let R := F.image root
  let A := F.image rproj
  let Fr (r : Fin q → W) := F.filter (fun f => root f=r)
  let Ar (r : Fin q → W) := A.filter (fun g => roots g=r)
  let S (r : Fin q → W) := (Fr r).image (fun f => f (.inl (.inl false)))
  let Y (r : Fin q → W) := (Ar r).image (fun g => g (.inl none))
  let E (r : Fin q → W) := BoundedCodegreeCross.excess G (S r) (Y r) t
  have hRU : R.card ≤ U.card^q := by
    let val : R → (Fin q → U) := fun r j => ⟨r.val j,by
      obtain ⟨f,hf,he⟩ := mem_image.mp r.property
      rw [← he]
      exact hmem f hf _⟩
    have hinj : Function.Injective val := by
      intro r r' he
      apply Subtype.ext
      funext j
      exact congrArg Subtype.val (congrFun he j)
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using Fintype.card_le_of_injective val hinj
  have hSU (r : Fin q → W) : S r⊆U := by
    intro x hx
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hx
    exact hmem f (mem_filter.mp hf).1 _
  have hYU (r : Fin q → W) : Y r⊆U := by
    intro y hy
    obtain ⟨g,hg,rfl⟩ := mem_image.mp hy
    obtain ⟨f,hf,rfl⟩ := mem_image.mp (mem_filter.mp hg).1
    exact hmem f hf _
  have hS (r : Fin q → W) (hr : r∈R) : ((S r).card:ℝ) ≤ B := by
    obtain ⟨f₀,hf₀,he⟩ := mem_image.mp hr
    have hi : Function.Injective r := by
      rw [← he]
      exact f₀.injective.comp (Sum.inr_injective.comp Sum.inr_injective)
    exact hsupport ⟨r,hi⟩ (Fr r) (filter_subset _ _)
      (fun f hf j => congrFun (mem_filter.mp hf).2 j)
  have hsumY : (∑r∈R, ((Y r).card:ℝ)) ≤ (U.card:ℝ)*D^(2*q) := by
    have hmap : Set.MapsTo roots A R := by
      intro g hg
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
      exact mem_image.mpr ⟨f,hf,rfl⟩
    have hsumA : (∑r∈R, ((Ar r).card:ℝ)) = A.card := by
      exact_mod_cast (card_eq_sum_card_fiberwise hmap).symm
    have htotal : (A.card:ℝ) ≤ (U.card:ℝ)*D^(2*q) := by
      have hh := ConnectedCopyBound.total (LongSpider.template q) (LongSpider.connected q) G U hD hdeg A (by
        intro g hg
        obtain ⟨f,hf,rfl⟩ := mem_image.mp hg
        exact fun v => hmem f hf _)
      have he : Fintype.card (Option (Fin q) ⊕ Fin q)-1=2*q := by simp; omega
      simpa only [he] using hh
    calc
      _ ≤ ∑r∈R, ((Ar r).card:ℝ) := sum_le_sum (fun r hr => by exact_mod_cast card_image_le (s:=Ar r) (f:=fun g => g (.inl none)))
      _ = A.card := hsumA
      _ ≤ _ := htotal
  have hfiber (r : Fin q → W) (hr : r∈R) :
      ((Fr r).card:ℝ) ≤ (B+Real.sqrt ((t:ℝ)*B)*(Y r).card+Real.sqrt (B*E r))*(D^(2*p)*(t:ℝ)^q) := by
    have hb := core_incidence_excess_count G U (S r) (Y r) t p q hD hdeg (Fr r) r
      (fun f hf => hmem f (mem_filter.mp hf).1) (fun f hf => hl f (mem_filter.mp hf).1)
      (fun f hf j => congrFun (mem_filter.mp hf).2 j)
      (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩) (by
        intro f hf
        apply mem_image.mpr
        refine ⟨rproj f,mem_filter.mpr ⟨mem_image.mpr ⟨f,(mem_filter.mp hf).1,rfl⟩,(mem_filter.mp hf).2⟩,rfl⟩)
    apply hb.trans
    apply mul_le_mul_of_nonneg_right _ (by positivity)
    exact add_le_add (add_le_add (hS r hr) (mul_le_mul_of_nonneg_right
      (Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left (hS r hr) (Nat.cast_nonneg _))) (Nat.cast_nonneg _)))
      (Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_right (hS r hr) (Nat.cast_nonneg (E r))))
  have hcount : (F.card:ℝ) = ∑r∈R, ((Fr r).card:ℝ) := by
    exact_mod_cast card_eq_sum_card_fiberwise (show Set.MapsTo root F R from fun f hf => mem_image.mpr ⟨f,hf,rfl⟩)
  have hcardR : (R.card:ℝ) ≤ (U.card:ℝ)^q := by exact_mod_cast hRU
  have hE : (∑r∈R, (E r:ℝ))=(rootedCoreExcess G t p q F:ℝ) := by
    simp only [rootedCoreExcess,Nat.cast_sum]
    rfl
  have hsumE : (∑r∈R, Real.sqrt (B*E r)) ≤ Real.sqrt (B*(U.card:ℝ)^q*rootedCoreExcess G t p q F) := by
    have hh := sum_sqrt_product_bound R (fun r => (E r:ℝ)) (fun r => Nat.cast_nonneg _) hB
    rw [hE] at hh
    apply hh.trans (Real.sqrt_le_sqrt _)
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hcardR hB) (Nat.cast_nonneg _)
  calc
    _ = ∑r∈R, ((Fr r).card:ℝ) := hcount
    _ ≤ ∑r∈R, (B+Real.sqrt ((t:ℝ)*B)*(Y r).card+Real.sqrt (B*E r))*(D^(2*p)*(t:ℝ)^q) := sum_le_sum hfiber
    _ = (D^(2*p)*(t:ℝ)^q)*(B*R.card+Real.sqrt ((t:ℝ)*B)*(∑r∈R, ((Y r).card:ℝ))+
        ∑r∈R, Real.sqrt (B*E r)) := by
      rw [← sum_mul,sum_add_distrib,sum_add_distrib,sum_const,nsmul_eq_mul,← mul_sum]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (add_le_add (add_le_add (mul_le_mul_of_nonneg_left hcardR hB)
      (by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hsumY (Real.sqrt_nonneg _))) hsumE) (by positivity)

end Erdos571.DoubleSpider


/-! Two-path mass conservation and local cleaning of candidate centers. -/
namespace Erdos571.HeavyPathMass
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

lemma forwardMass_eq_middleMass (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    forwardMass G U U t=middleMass G U U t := by
  classical
  unfold forwardMass middleMass forwardPairs ShortSpider.badPairs
  simp only [neighbors,← filter_product,filter_filter,card_filter,sum_product]
  rw [sum_comm]
  apply sum_congr rfl
  intro a ha
  apply sum_congr rfl
  intro x hx
  apply sum_congr rfl
  intro y hy
  simp only [G.adj_comm x a,and_assoc]

noncomputable def localMass (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (x : W) : ℕ :=
  (ShortSpider.badPairs G U t x).card+(forwardPairs G U t x).card

lemma sum_localMass (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W) (t : ℕ) :
    (∑x∈S, localMass G U t x)=middleMass G U S t+forwardMass G U S t := by
  simp only [localMass,middleMass,forwardMass,sum_add_distrib]

noncomputable def cleanCenters (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (h : ℝ) : Finset W := by
  classical
  exact U.filter (fun x => (localMass G U t x:ℝ)≤h)

/-- A global heavy-path bound bounds the number of exceptional centers. No
vertices are removed from the host graph when selecting these centers. -/
lemma unclean_card_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (h : ℝ) :
    ((U\cleanCenters G U t h).card:ℝ)*h ≤ 2*(middleMass G U U t:ℝ) := by
  classical
  let B := U\cleanCenters G U t h
  have he : (B.card:ℝ)*h=∑x∈B, h := by simp
  have hs : (∑x∈B, (localMass G U t x:ℝ)) ≤ ∑x∈U, (localMass G U t x:ℝ) :=
    sum_le_sum_of_subset_of_nonneg sdiff_subset (fun _ _ _ => Nat.cast_nonneg _)
  have hall : (∑x∈U, (localMass G U t x:ℝ))=2*(middleMass G U U t:ℝ) := by
    rw [← Nat.cast_sum,sum_localMass,forwardMass_eq_middleMass,Nat.cast_add]
    ring
  change (B.card:ℝ)*h ≤ _
  rw [he]
  apply le_trans _ (hs.trans_eq hall)
  apply sum_le_sum
  intro x hx
  have hmem := (mem_sdiff.mp hx).1
  have hnot := (mem_sdiff.mp hx).2
  have hb : ¬(localMass G U t x:ℝ)≤h := by
    intro hh
    exact hnot (mem_filter.mpr ⟨hmem,hh⟩)
  linarith

lemma clean_mass_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W) (t : ℕ) (h : ℝ)
    (hS : S⊆cleanCenters G U t h) :
    (middleMass G U S t+forwardMass G U S t:ℕ) ≤ (S.card:ℝ)*h := by
  classical
  rw [← sum_localMass,Nat.cast_sum]
  calc
    _ ≤ ∑_x∈S, h := sum_le_sum (fun x hx => (mem_filter.mp (hS hx)).2)
    _ = _ := by simp

end Erdos571.HeavyPathMass


/-! Uncolored heavy shadows and light-copy abundance for subdivisions. -/


open Finset SimpleGraph

namespace Erdos571.HostHeavyShadow
open DensityRegularization ProjectionHeavy
variable {W : Type} [DecidableEq W]

/-- The heavy-pair graph does not impose a bipartition on the host. -/
def graph (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : SimpleGraph W where
  Adj u v := u ≠ v ∧ t ≤ (FourthMoment.common G U u v).card
  symm := by
    intro u v h
    refine ⟨h.1.symm, ?_⟩
    have he : FourthMoment.common G U u v = FourthMoment.common G U v u := by
      ext w; simp [FourthMoment.common, and_comm]
    simpa only [← he] using h.2
  loopless := by intro u h; exact h.1 rfl

instance (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    DecidableRel (graph G U t).Adj := fun _ _ => inferInstanceAs (Decidable (_ ∧ _))

noncomputable def middles {V : Type} (H : SimpleGraph V) (G : SimpleGraph W)
    [DecidableRel G.Adj] (U : Finset W) (f : V → W) (e : H.edgeSet) : Finset W := by
  classical
  exact U.filter (fun w => ∀ v ∈ e.val, G.Adj (f v) w)

lemma middles_card {V : Type} (H : SimpleGraph V) (G : SimpleGraph W)
    [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (f : H.Copy (graph G U t))
    (e : H.edgeSet) : t ≤ (middles H G U f e).card := by
  classical
  obtain ⟨e,he⟩ := e
  induction e using Sym2.inductionOn with
  | hf u v =>
    have h := f.toHom.map_adj (show H.Adj u v from he)
    have heq : middles H G U f ⟨s(u,v),he⟩ = FourthMoment.common G U (f u) (f v) := by
      ext w
      simp [middles,FourthMoment.common,Sym2.mem_iff]
    rw [heq]
    exact h.2

/-- Branch vertices and middle vertices are disjoint, even in an uncolored host. -/
theorem contains_subdivision {V : Type} [Fintype V] (H : SimpleGraph V)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (f : H.Copy (graph G U (Fintype.card V + Nat.card H.edgeSet))) :
    subdivision H ⊑ G := by
  classical
  let Z : Finset W := univ.image f
  have hZ : Z.card ≤ Fintype.card V := (card_image_le).trans (by simp)
  obtain ⟨g,hg,hgF⟩ := ShortSpider.select_avoiding (middles H G U f) Z (by
    intro e
    have h := middles_card H G U _ f e
    have hc : Nat.card H.edgeSet = Fintype.card H.edgeSet := Nat.card_eq_fintype_card
    omega)
  have hgf (e : H.edgeSet) (v : V) : g e ≠ f v := by
    intro he
    apply (hgF e).2
    exact mem_image.mpr ⟨v, mem_univ _, he.symm⟩
  have hadj (v : V) (e : H.edgeSet) (he : v ∈ e.val) : G.Adj (f v) (g e) :=
    (show g e ∈ U ∧ ∀ v ∈ e.val, G.Adj (f v) (g e) by
      simpa only [middles,mem_filter] using (hgF e).1).2 v he
  refine ⟨{ toHom := { toFun := Sum.elim f g, map_rel' := ?_ }, injective' := ?_ }⟩
  · intro u v h
    cases u with
    | inl u =>
      cases v with
      | inl v => exact h.elim
      | inr e => exact hadj u e h
    | inr e =>
      cases v with
      | inl v => exact (hadj v e h).symm
      | inr e' => exact h.elim
  · intro u v h
    cases u with
    | inl u =>
      cases v with
      | inl v => exact congrArg Sum.inl (f.injective h)
      | inr e => exact (hgf e u h.symm).elim
    | inr e =>
      cases v with
      | inl v => exact (hgf e v h).elim
      | inr e' => exact congrArg Sum.inr (hg h)

lemma free {V : Type} [Fintype V] (H : SimpleGraph V)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (hf : (subdivision H).Free G) :
    H.Free (graph G U (Fintype.card V + Nat.card H.edgeSet)) := by
  rintro ⟨f⟩
  exact hf (contains_subdivision H G U f)

lemma induced_free {V : Type} [Fintype V] (H : SimpleGraph V)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (hf : (subdivision H).Free G) :
    H.Free ((graph G U (Fintype.card V + Nat.card H.edgeSet)).induce (S : Set W)) := by
  intro h
  exact free H G U hf (h.trans ⟨Copy.induce _ _⟩)

lemma arcs_bound {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hbound : EdgeBound H α C) (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (hf : (subdivision H).Free G) :
    ((arcs (graph G U (Fintype.card V + Nat.card H.edgeSet)) S).card : ℝ) ≤
      2*C*(S.card : ℝ)^α := by
  classical
  have h := hbound.estimate _ (induced_free H G U S hf)
  rw [arcs_card]
  push_cast
  rw [Fintype.card_of_finset' (p := (S : Set W)) S (fun _ => Iff.rfl)] at h
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left h (by norm_num : (0 : ℝ) ≤ 2)

lemma badPairs_le (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (x : W) :
    (ShortSpider.badPairs G U t x).card ≤ (neighbors G U x).card +
      (arcs (graph G U t) (neighbors G U x)).card := by
  classical
  let diag := (neighbors G U x).image (fun v => (v,v))
  have hs : ShortSpider.badPairs G U t x ⊆ diag ∪ arcs (graph G U t) (neighbors G U x) := by
    rintro ⟨u,v⟩ hp
    obtain ⟨⟨hu,hv⟩,hb⟩ := mem_filter.mp hp |>.imp_left mem_product.mp
    by_cases he : u=v
    · subst v
      exact mem_union_left _ (mem_image.mpr ⟨u,hu,rfl⟩)
    · exact mem_union_right _ (mem_arcs.mpr ⟨hu,hv,he,hb.resolve_left he⟩)
  exact (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right card_image_le _))

lemma badPairs_bound {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hbound : EdgeBound H α C) (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (hf : (subdivision H).Free G) (x : W) :
    ((ShortSpider.badPairs G U (Fintype.card V + Nat.card H.edgeSet) x).card : ℝ) ≤
      (neighbors G U x).card + 2*C*((neighbors G U x).card : ℝ)^α := by
  have h : ((ShortSpider.badPairs G U (Fintype.card V + Nat.card H.edgeSet) x).card : ℝ) ≤
      (neighbors G U x).card +
      (arcs (graph G U (Fintype.card V + Nat.card H.edgeSet)) (neighbors G U x)).card := by
    exact_mod_cast badPairs_le G U (Fintype.card V + Nat.card H.edgeSet) x
  exact h.trans (add_le_add (le_refl _) (arcs_bound H hbound G U (neighbors G U x) hf))

/-- An ordinary upper bound for the unsubdivided graph controls all heavy two-paths. -/
lemma middleMass_bound {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (hf : (subdivision H).Free G) {D : ℝ}
    (hdeg : ∀ x∈S, ((neighbors G U x).card : ℝ) ≤ D) :
    (HeavyPathMass.middleMass G U S (Fintype.card V + Nat.card H.edgeSet) : ℝ) ≤
      S.card*(D + 2*C*D^α) := by
  classical
  rw [HeavyPathMass.middleMass,Nat.cast_sum]
  calc
    _ ≤ ∑_x∈S, (D + 2*C*D^α) := by
      apply sum_le_sum
      intro x hx
      exact (badPairs_bound H hbound G U hf x).trans (add_le_add (hdeg x hx)
        (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) (hdeg x hx) hα)
          (by positivity)))
    _ = _ := by simp [mul_add]

end Erdos571.HostHeavyShadow


/-! Abundant light tree copies in almost-regular subdivision-free hosts. -/
namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph DensityRegularization ProjectionHeavy Filter Asymptotics

lemma nonlight_bound {V A W : Type} [Fintype V] [Fintype A] [DecidableEq A] [DecidableEq W]
    (H : SimpleGraph V) {α C : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (T : SimpleGraph A) (hT : T.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (hf : (subdivision H).Free G) {D : ℝ} (hD : 0 ≤ D)
    (hdeg : ∀ x∈U, ((neighbors G U x).card : ℝ) ≤ D)
    (F : Finset (T.Copy G)) (hmem : ∀f∈F, ∀x, f x∈U)
    (hbad : ∀f∈F, ¬ConnectedCopyBound.Light T G U (Fintype.card V + Nat.card H.edgeSet) f) :
    (F.card : ℝ) ≤ (Fintype.card A : ℝ)^3*U.card*(D+2*C*D^α)*D^(Fintype.card A-3) := by
  have h := ConnectedCopyBound.nonlight_bound T hT G U _ hD hdeg F hmem hbad
  have hm := middleMass_bound H hα hC hbound G U U hf hdeg
  simp only [HeavyPathMass.middleMass,Nat.cast_sum] at hm
  have hh := mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_right hm (pow_nonneg hD (Fintype.card A-3)))
    (show (0 : ℝ) ≤ (Fintype.card A : ℝ)^3 by positivity)
  exact h.trans (by convert hh using 1 <;> ring)

/-- With α<2, the two error powers are strictly lower than the greedy tree power. -/
lemma exists_nonlight_threshold (k : ℕ) (hk : 3 ≤ k) (Q C α : ℝ) (hQ : 1 ≤ Q) (hα : α < 2) :
    ∃ L : ℝ, 1 ≤ L ∧ 4*((k : ℝ)+1) ≤ L ∧ ∀d : ℝ, L ≤ d →
      (k : ℝ)^3*(Q*d+2*C*(Q*d)^α)*(Q*d)^(k-3) ≤ (d/4)^(k-1)/2 := by
  let a : ℝ := (k-2 : ℕ)
  let b : ℝ := α+(k-3 : ℕ)
  let A : ℝ := (k : ℝ)^3*Q^a
  let B : ℝ := 2*(k : ℝ)^3*C*Q^b
  have he1 : k-3+1=k-2 := by omega
  have he2 : k-2+1=k-1 := by omega
  have he3 : k-3+2=k-1 := by omega
  have ha : a < (k-1 : ℕ) := by dsimp [a]; exact_mod_cast (show k-2 < k-1 by omega)
  have hb : b < (k-1 : ℕ) := by
    dsimp [b]
    rw [← he3,Nat.cast_add,Nat.cast_ofNat]
    linarith
  have ho : (fun d : ℝ => A*d^a+B*d^b) =o[atTop] (fun d : ℝ => d^((k-1 : ℕ) : ℝ)) :=
    ((ThetaFour.rpow_littleO ha).const_mul_left A).add ((ThetaFour.rpow_littleO hb).const_mul_left B)
  obtain ⟨L₀,hL₀⟩ := eventually_atTop.mp (ho.def (c := 1/(2*4^(k-1))) (by positivity))
  refine ⟨max (max 1 (4*((k : ℝ)+1))) L₀,
    (le_max_left _ _).trans (le_max_left _ _),
    (le_max_right _ _).trans (le_max_left _ _), ?_⟩
  intro d hd
  have hd1 : 1 ≤ d := (le_max_left _ _).trans ((le_max_left _ _).trans hd)
  have hd0 : 0 < d := by linarith
  have hQ0 : 0 < Q := by linarith
  have h := hL₀ d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hd0.le _)] at h
  have hh := (le_abs_self (A*d^a+B*d^b)).trans h
  have heq : (k : ℝ)^3*(Q*d+2*C*(Q*d)^α)*(Q*d)^(k-3)=A*d^a+B*d^b := by
    dsimp [A,B,a,b]
    rw [Real.rpow_add hQ0,Real.rpow_add hd0,Real.rpow_natCast,Real.rpow_natCast,
      Real.rpow_natCast,Real.rpow_natCast,Real.mul_rpow hQ0.le hd0.le,
      ← he1,pow_succ,pow_succ,mul_pow]
    ring
  rw [heq]
  convert hh using 1
  rw [Real.rpow_natCast,div_pow]
  ring

noncomputable def lightCopies {A W : Type} [Fintype A] [Fintype W] [DecidableEq W]
    (T : SimpleGraph A) (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    Finset (T.Copy G) := by
  classical
  exact (TreeCopiesIn.copies T G U).filter (ConnectedCopyBound.Light T G U t)

/-- No global bounded-codegree assumption is needed here: subdivision-freeness
and an upper bound for the original graph suffice to discard the nonlight copies. -/
theorem light_tree_abundance {V A : Type} [Fintype V] [Fintype A] [DecidableEq A]
    (H : SimpleGraph V) {α C : ℝ} (hα0 : 0 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C)
    (hbound : EdgeBound H α C) (T : SimpleGraph A) (hT : T.IsTree)
    (hk : 3 ≤ Fintype.card A) (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ L : ℝ, 1 ≤ L ∧ ∀ {W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hf : (subdivision H).Free G)
      (d : ℝ), L ≤ d →
      (∀x∈U, d ≤ ((neighbors G U x).card : ℝ)) →
      (∀x∈U, ((neighbors G U x).card : ℝ) ≤ Q*d) →
      (U.card : ℝ)*(d/4)^(Fintype.card A-1)/2 ≤
        (lightCopies T G U (Fintype.card V + Nat.card H.edgeSet)).card := by
  classical
  obtain ⟨L,hL,hLlarge,herr⟩ := exists_nonlight_threshold (Fintype.card A) hk Q C α hQ hα2
  refine ⟨L,hL,?_⟩
  intro W _ _ G _ U hf d hd hmin hmax
  have hd0 : 0 ≤ d := by linarith
  have hQ0 : 0 ≤ Q := by linarith
  let F := TreeCopiesIn.copies T G U
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light T G U (Fintype.card V+Nat.card H.edgeSet) f)
  have hb := nonlight_bound H hα0 hC hbound T hT.1 G U hf (mul_nonneg hQ0 hd0) hmax B
    (fun f hf => (TreeCopiesIn.mem_copies T G U f).mp (mem_filter.mp hf).1)
    (fun f hf => (mem_filter.mp hf).2)
  have he := mul_le_mul_of_nonneg_left (herr d hd) (Nat.cast_nonneg U.card)
  have hsmall : (B.card : ℝ) ≤ (U.card : ℝ)*(d/4)^(Fintype.card A-1)/2 := by
    nlinarith [hb,he]
  have hl := TreeCopiesIn.lower T hT G U (hLlarge.trans hd) hmin
  have hsplit : (lightCopies T G U (Fintype.card V+Nat.card H.edgeSet)).card+B.card=F.card := by
    exact card_filter_add_card_filter_not _
  have hsplit' : ((lightCopies T G U (Fintype.card V+Nat.card H.edgeSet)).card : ℝ)+(B.card : ℝ)=F.card := by
    exact_mod_cast hsplit
  change (U.card : ℝ)*(d/4)^(Fintype.card A-1) ≤ F.card at hl
  linarith

end Erdos571.HostHeavyShadow


/-! Heavy-path cleaning from subdivision-freeness, without a host coloring. -/
namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph DensityRegularization ProjectionHeavy Filter Asymptotics HeavyPathMass

lemma exists_mass_threshold (Q C α η : ℝ) (hQ : 1 ≤ Q) (hα : α < 2) (hη : 0 < η) :
    ∃ L : ℝ, 1 ≤ L ∧ ∀d : ℝ, L ≤ d → Q*d+2*C*(Q*d)^α ≤ η*d^2 := by
  have ho : (fun d : ℝ => Q*d^(1 : ℝ)+(2*C*Q^α)*d^α) =o[atTop] (fun d : ℝ => d^(2 : ℝ)) :=
    ((ThetaFour.rpow_littleO (by norm_num : (1 : ℝ)<2)).const_mul_left Q).add
      ((ThetaFour.rpow_littleO hα).const_mul_left (2*C*Q^α))
  obtain ⟨L₀,hL₀⟩ := eventually_atTop.mp (ho.def hη)
  refine ⟨max 1 L₀,le_max_left _ _,?_⟩
  intro d hd
  have hd0 : 0 ≤ d := (by norm_num : (0 : ℝ)≤1).trans ((le_max_left _ _).trans hd)
  have hQ0 : 0 ≤ Q := by linarith
  have he := hL₀ d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hd0 _)] at he
  have hh := (le_abs_self (Q*d^(1 : ℝ)+(2*C*Q^α)*d^α)).trans he
  simpa only [Real.rpow_one,Real.rpow_two,Real.mul_rpow hQ0 hd0,mul_assoc] using hh

/-- Almost all centers have small combined endpoint and middle heavy-path mass.
This chooses centers only; the ambient vertex set in the codegrees is unchanged. -/
theorem clean_centers_large {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hα0 : 0 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (Q ε η : ℝ) (hQ : 1 ≤ Q) (hε : 0 < ε) (hη : 0 < η) :
    ∃ L : ℝ, 1 ≤ L ∧ ∀ {W : Type} [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hf : (subdivision H).Free G)
      (d : ℝ), L ≤ d →
      (∀x∈U, ((neighbors G U x).card : ℝ) ≤ Q*d) →
      ((U\cleanCenters G U (Fintype.card V + Nat.card H.edgeSet) (η*d^2)).card : ℝ) ≤ ε*U.card := by
  obtain ⟨L,hL,herr⟩ := exists_mass_threshold Q C α (ε*η/2) hQ hα2 (by positivity)
  refine ⟨L,hL,?_⟩
  intro W _ G _ U hf d hd hmax
  have hd0 : 0 < d := by linarith
  have hm := middleMass_bound H hα0 hC hbound G U U hf hmax
  have he := mul_le_mul_of_nonneg_left (herr d hd) (Nat.cast_nonneg U.card)
  have hu := unclean_card_bound G U (Fintype.card V + Nat.card H.edgeSet) (η*d^2)
  apply (mul_le_mul_iff_left₀ (show 0 < η*d^2 by positivity)).mp
  nlinarith [hu,hm,he]

/-- Upper bounds for every rooted power give light-tree abundance in hosts
avoiding any fixed rooted subdivision power. No sharp subdivision transfer is used. -/
theorem rooted_light_tree_abundance {A R B : Type} [Fintype A] [Fintype R]
    [Fintype B] [DecidableEq B] (H : SimpleGraph (A ⊕ R)) {α : ℝ}
    (hs : OrdinaryRooted.Supported H α) (hα0 : 0 ≤ α) (hα2 : α < 2)
    (M : ℕ) (hM : 1 ≤ M) (T : SimpleGraph B) (hT : T.IsTree)
    (hk : 3 ≤ Fintype.card B) (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ t : ℕ, ∃ L : ℝ, 1 ≤ L ∧ ∀ {W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
      (hf : (FullRootedPower.graph (RootedSubdivision.graph H) M).Free G)
      (d : ℝ), L ≤ d →
      (∀x∈U, d ≤ ((neighbors G U x).card : ℝ)) →
      (∀x∈U, ((neighbors G U x).card : ℝ) ≤ Q*d) →
      (U.card : ℝ)*(d/4)^(Fintype.card B-1)/2 ≤ (lightCopies T G U t).card := by
  classical
  obtain ⟨C,hC,hbound⟩ := hs (M+1) (by omega)
  obtain ⟨L,hL,hcount⟩ := light_tree_abundance (FullRootedPower.graph H (M+1))
    hα0 hα2 hC hbound T hT hk Q hQ
  refine ⟨Fintype.card ((Fin (M+1) × A) ⊕ R) + Nat.card (FullRootedPower.graph H (M+1)).edgeSet,L,hL,?_⟩
  intro W _ _ G _ U hf d hd hmin hmax
  have hfree : (subdivision (FullRootedPower.graph H (M+1))).Free G := by
    intro h
    exact hf ((show FullRootedPower.graph (RootedSubdivision.graph H) M ⊑
      subdivision (FullRootedPower.graph H (M+1)) from ⟨RootedSubdivision.powerCopy H M⟩).trans h)
  exact hcount G U hfree d hd hmin hmax

/-- The analogous rooted-subdivision corollary for local heavy-path cleaning. -/
theorem rooted_clean_centers_large {A R : Type} [Fintype A] [Fintype R]
    (H : SimpleGraph (A ⊕ R)) {α : ℝ} (hs : OrdinaryRooted.Supported H α)
    (hα0 : 0 ≤ α) (hα2 : α < 2) (M : ℕ) (hM : 1 ≤ M)
    (Q ε η : ℝ) (hQ : 1 ≤ Q) (hε : 0 < ε) (hη : 0 < η) :
    ∃t : ℕ, ∃ L : ℝ, 1 ≤ L ∧ ∀ {W : Type} [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
      (hf : (FullRootedPower.graph (RootedSubdivision.graph H) M).Free G)
      (d : ℝ), L ≤ d → (∀x∈U, ((neighbors G U x).card : ℝ) ≤ Q*d) →
      ((U\cleanCenters G U t (η*d^2)).card : ℝ) ≤ ε*U.card := by
  classical
  obtain ⟨C,hC,hbound⟩ := hs (M+1) (by omega)
  obtain ⟨L,hL,hclean⟩ := clean_centers_large (FullRootedPower.graph H (M+1))
    hα0 hα2 hC hbound Q ε η hQ hε hη
  refine ⟨Fintype.card ((Fin (M+1) × A) ⊕ R) + Nat.card (FullRootedPower.graph H (M+1)).edgeSet,L,hL,?_⟩
  intro W _ G _ U hf d hd hmax
  have hfree : (subdivision (FullRootedPower.graph H (M+1))).Free G := by
    intro h
    exact hf ((show FullRootedPower.graph (RootedSubdivision.graph H) M ⊑
      subdivision (FullRootedPower.graph H (M+1)) from ⟨RootedSubdivision.powerCopy H M⟩).trans h)
  exact hclean G U hfree d hd hmax

end Erdos571.HostHeavyShadow


/-! A concrete subdivision witness with a gap between its proved exponents. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ConedShortSubdivision
open Finset SimpleGraph RootedSunflower OrdinaryRooted ProjectionHeavy

/-- These are paired cones with shared roots, not private-leaf extensions. -/
def once := RootedCone.graph (ShortSpider.template 2) ShortSpider.color

def twice := RootedCone.graph once (RootedCone.color ShortSpider.color)

def template := RootedSubdivision.graph twice

def graph (M : ℕ) := FullRootedPower.graph template M

lemma twice_no_isolated : ∀u, ∃v, twice.Adj u v :=
  RootedCone.no_isolated once (RootedCone.color ShortSpider.color)
    (RootedCone.no_isolated (ShortSpider.template 2) ShortSpider.color (ShortSpider.no_isolated 2))

lemma twice_balance : ∀ C : Finset (Option (Fin 2)),
    11*(Fintype.card (Option (Fin 2))-C.card) ≤ 3*Nat.card (PetalEdge twice C) := by
  have h0 := ShortSpider.balance 2
  norm_num only at h0
  have h1 := RootedCone.balance (ShortSpider.template 2) ShortSpider.color 3 5 h0
  have h2 := RootedCone.balance once (RootedCone.color ShortSpider.color) 3 8 h1
  exact h2

lemma twice_supported : Supported twice (19/11 : ℝ) := by
  have h0 : Supported (ShortSpider.template 2) (7/5 : ℝ) := by
    convert ShortSpider.supported 2 (by omega) using 1 <;> norm_num
  have h1 : Supported once (13/8 : ℝ) := by
    have hh := h0.cone (ShortSpider.connected 2) (ShortSpider.color_proper 2) (by norm_num) (by norm_num)
    norm_num at hh
    exact hh
  have h2 := h1.cone (RootedCone.connected (ShortSpider.template 2) ShortSpider.color)
    (RootedCone.color_proper (ShortSpider.template 2) ShortSpider.color (ShortSpider.color_proper 2))
    (by norm_num) (by norm_num)
  norm_num at h2
  exact h2

lemma template_balance : ∀ C : Finset (RootedSubdivision.Nonroot twice),
    22*(Fintype.card (RootedSubdivision.Nonroot twice)-C.card) ≤
      14*Nat.card (PetalEdge template C) :=
  by
    classical
    simpa only [← Nat.card_eq_fintype_card] using
      RootedSubdivision.balance twice 3 11 (by omega) twice_balance

lemma exists_lower : ∃M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (n : ℝ)^(15/11 : ℝ))
    (fun n : ℕ => (extremalNumber n (graph M) : ℝ)) := by
  classical
  have h := FullRootedPower.exact_lower template
    (RootedSubdivision.no_isolated twice twice_no_isolated) 14 22 (by omega) (by omega) (by
      simpa only [← Nat.card_eq_fintype_card] using template_balance)
  norm_num at h
  exact h

/-- The proved weak transfer yields 27/19, not the desired 15/11. -/
lemma weak_supported : Supported template (27/19 : ℝ) := by
  classical
  intro M hM
  obtain ⟨C,hC,hbound⟩ := twice_supported (M+1) (by omega)
  have hb := WeakSubdivisionUpper.edge_bound (FullRootedPower.graph twice (M+1))
    (by norm_num : (1 : ℝ) ≤ 19/11) (by norm_num : (19/11 : ℝ) ≤ 2) hC hbound
  have hcoef := WeakSubdivisionUpper.coefficient_nonneg
    (h := Fintype.card ((Fin (M+1) × Option (Fin 2)) ⊕ ((Option (Fin 2) ⊕ Bool) ⊕ Bool)))
    (α := (19/11 : ℝ)) hC
  refine ⟨4*WeakSubdivisionUpper.coefficient
    (Fintype.card ((Fin (M+1) × Option (Fin 2)) ⊕ ((Option (Fin 2) ⊕ Bool) ⊕ Bool)))
    (19/11) C,by positivity,?_⟩
  have h := hb.mono ⟨RootedSubdivision.powerCopy twice M⟩
  norm_num at h
  simpa using h

lemma lower_and_weak_upper : ∃M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop (fun n : ℕ => (n : ℝ)^(15/11 : ℝ))
      (fun n : ℕ => (extremalNumber n (graph M) : ℝ)) ∧
    Asymptotics.IsBigO Filter.atTop (fun n : ℕ => (extremalNumber n (graph M) : ℝ))
      (fun n : ℕ => (n : ℝ)^(27/19 : ℝ)) := by
  obtain ⟨M,hM,hl⟩ := exists_lower
  obtain ⟨C,hC,hu⟩ := weak_supported M hM
  exact ⟨M,hM,hl,EdgeBound.extremal_isBigO _ hC hu⟩

end Erdos571.ConedShortSubdivision

/-! Removing edges between designated roots preserves all petal edge sets. -/
namespace Erdos571.RootEdgeDeletion
open SimpleGraph Finset RootedSunflower
variable {A R : Type*}

def graph (H : SimpleGraph (A ⊕ R)) : SimpleGraph (A ⊕ R) where
  Adj u v := match u,v with
    | .inl a,.inl b => H.Adj (.inl a) (.inl b)
    | .inl a,.inr r => H.Adj (.inl a) (.inr r)
    | .inr r,.inl a => H.Adj (.inr r) (.inl a)
    | .inr _,.inr _ => False
  symm := by intro u v h; cases u <;> cases v <;> first | exact h.symm | exact h.elim
  loopless := by intro u; cases u <;> first | exact H.loopless _ | exact not_false

lemma le (H : SimpleGraph (A ⊕ R)) : graph H ≤ H := by
  intro u v h; cases u <;> cases v <;> first | exact h | exact h.elim

lemma petal_edge (H : SimpleGraph (A ⊕ R)) (C : Finset A) (e : PetalEdge H C) :
    e.val.val ∈ (graph H).edgeSet := by
  obtain ⟨⟨e,he⟩,hp⟩ := e
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl a => cases v <;> exact he
    | inr r =>
      cases v with
      | inl a => exact he
      | inr s =>
        obtain ⟨a,ha,hm⟩ := hp
        simpa only [Sym2.mem_iff,Sum.inl_ne_inr,or_self] using hm

def petalEquiv (H : SimpleGraph (A ⊕ R)) (C : Finset A) :
    PetalEdge (graph H) C ≃ PetalEdge H C where
  toFun := fun e => ⟨⟨e.val.val,(SimpleGraph.edgeSet_mono (le H)) e.val.property⟩,e.property⟩
  invFun := fun e => ⟨⟨e.val.val,petal_edge H C e⟩,e.property⟩
  left_inv := by intro e; rfl
  right_inv := by intro e; rfl

lemma petal_card (H : SimpleGraph (A ⊕ R)) (C : Finset A) :
    Nat.card (PetalEdge (graph H) C)=Nat.card (PetalEdge H C) := Nat.card_congr (petalEquiv H C)

lemma balance [Fintype A] (H : SimpleGraph (A ⊕ R)) (a b : ℕ)
    (hb : ∀C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∀C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge (graph H) C) := by
  intro C; rw [petal_card]; exact hb C

lemma power_le (H : SimpleGraph (A ⊕ R)) (M : ℕ) :
    FullRootedPower.graph (graph H) M ≤ FullRootedPower.graph H M := by
  intro u v h
  cases u <;> cases v
  · exact ⟨h.1,le H h.2⟩
  · exact le H h
  · exact le H h
  · exact h.elim

lemma no_isolated (H : SimpleGraph (A ⊕ R)) (hH : ∀u, ∃v, H.Adj u v)
    (hroot : ∀r : R, ∃a : A, H.Adj (.inr r) (.inl a)) : ∀u, ∃v, (graph H).Adj u v := by
  intro u
  cases u with
  | inl a =>
    obtain ⟨v,hv⟩ := hH (.inl a)
    refine ⟨v,?_⟩
    cases v <;> exact hv
  | inr r =>
    obtain ⟨a,ha⟩ := hroot r
    exact ⟨.inl a,ha⟩

lemma supported {A R : Type} (H : SimpleGraph (A ⊕ R)) {α : ℝ}
    (hs : OrdinaryRooted.Supported H α) : OrdinaryRooted.Supported (graph H) α := by
  intro M hM
  obtain ⟨C,hC,hb⟩ := hs M hM
  exact ⟨C,hC,hb.mono (IsContained.of_le (power_le H M))⟩

end Erdos571.RootEdgeDeletion

/-! A root-independent version of the two-cone subdivision candidate. -/
set_option maxHeartbeats 2000000
namespace Erdos571
open SimpleGraph Finset ProjectionHeavy

lemma OrdinaryRooted.Supported.weak_subdivision {A R : Type} [Fintype A] [Fintype R] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) {α : ℝ} (hs : OrdinaryRooted.Supported H α)
    (hα1 : 1 ≤ α) (hα2 : α ≤ 2) :
    OrdinaryRooted.Supported (RootedSubdivision.graph H) (2-α⁻¹) := by
  classical
  intro M hM
  obtain ⟨C,hC,hb⟩ := hs (M+1) (by omega)
  have h := WeakSubdivisionUpper.edge_bound (FullRootedPower.graph H (M+1)) hα1 hα2 hC hb
  have hc := WeakSubdivisionUpper.coefficient_nonneg
    (h := Fintype.card ((Fin (M+1) × A) ⊕ R)) (α := α) hC
  exact ⟨4*WeakSubdivisionUpper.coefficient (Fintype.card ((Fin (M+1) × A) ⊕ R)) α C,
    by positivity,h.mono ⟨RootedSubdivision.powerCopy H M⟩⟩

namespace SlimConedSubdivision
open RootedSunflower OrdinaryRooted ConedShortSubdivision

def base := RootEdgeDeletion.graph twice

def template := RootedSubdivision.graph base

def graph (M : ℕ) := FullRootedPower.graph template M

lemma root_neighbor (r : (Option (Fin 2) ⊕ Bool) ⊕ Bool) :
    ∃a : Option (Fin 2), twice.Adj (.inr r) (.inl a) := by
  rcases r with (a | b) | b
  · exact ⟨a,rfl⟩
  · cases b
    · exact ⟨some 0,by change false ≠ true; decide⟩
    · exact ⟨none,by change true ≠ false; decide⟩
  · cases b
    · exact ⟨some 0,by change false ≠ true; decide⟩
    · exact ⟨none,by change true ≠ false; decide⟩

lemma no_isolated : ∀u, ∃v, base.Adj u v :=
  RootEdgeDeletion.no_isolated twice twice_no_isolated root_neighbor

lemma balance : ∀C : Finset (Option (Fin 2)),
    11*(Fintype.card (Option (Fin 2))-C.card) ≤ 3*Nat.card (PetalEdge base C) :=
  RootEdgeDeletion.balance twice 3 11 twice_balance

lemma supported : Supported base (19/11 : ℝ) := RootEdgeDeletion.supported twice twice_supported

lemma template_balance : ∀C : Finset (RootedSubdivision.Nonroot base),
    22*(Fintype.card (RootedSubdivision.Nonroot base)-C.card) ≤
      14*Nat.card (PetalEdge template C) := by
  classical
  simpa only [← Nat.card_eq_fintype_card] using RootedSubdivision.balance base 3 11 (by omega) balance

lemma exists_lower : ∃M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (n : ℝ)^(15/11 : ℝ))
    (fun n : ℕ => (extremalNumber n (graph M) : ℝ)) := by
  classical
  have h := FullRootedPower.exact_lower template (RootedSubdivision.no_isolated base no_isolated)
    14 22 (by omega) (by omega) (by simpa only [← Nat.card_eq_fintype_card] using template_balance)
  norm_num at h
  exact h

lemma weak_supported : Supported template (27/19 : ℝ) := by
  have h := supported.weak_subdivision base (by norm_num) (by norm_num)
  norm_num at h
  exact h

end SlimConedSubdivision
end Erdos571

/-! Counting disjoint triples in families with bounded vertex load. -/
namespace Erdos571.DisjointTripleCount
open Finset
variable {P W : Type*} [DecidableEq P] [DecidableEq W]

noncomputable def triples (F : Finset P) (foot : P → Finset W) : Finset (P × P × P) := by
  classical
  exact (F ×ˢ (F ×ˢ F)).filter (fun p => Disjoint (foot p.1) (foot p.2.1) ∧
    Disjoint (foot p.1) (foot p.2.2) ∧ Disjoint (foot p.2.1) (foot p.2.2))

lemma neighbor_bound (F : Finset P) (foot : P → Finset W) (a : ℕ) {B : ℝ}
    (hB : 0 ≤ B) (hsize : ∀p∈F, (foot p).card ≤ a)
    (hload : ∀w, ((F.filter (fun p => w∈foot p)).card : ℝ) ≤ B) (p : P) (hp : p∈F) :
    ((F.filter (fun q => ¬Disjoint (foot p) (foot q))).card : ℝ) ≤ a*B := by
  classical
  have hs : F.filter (fun q => ¬Disjoint (foot p) (foot q)) ⊆
      (foot p).biUnion (fun w => F.filter (fun q => w∈foot q)) := by
    intro q hq
    obtain ⟨hq,hdis⟩ := mem_filter.mp hq
    rw [Finset.disjoint_left] at hdis
    push_neg at hdis
    obtain ⟨w,hw,hwq⟩ := hdis
    exact mem_biUnion.mpr ⟨w,hw,mem_filter.mpr ⟨hq,hwq⟩⟩
  calc
    _ ≤ (((foot p).biUnion (fun w => F.filter (fun q => w∈foot q))).card : ℝ) := by exact_mod_cast card_le_card hs
    _ ≤ ∑w∈foot p, ((F.filter (fun q => w∈foot q)).card : ℝ) := by exact_mod_cast card_biUnion_le
    _ ≤ ∑_w∈foot p, B := sum_le_sum (fun w _ => hload w)
    _ = (foot p).card*B := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (by exact_mod_cast hsize p hp) hB

lemma pair_bound (F : Finset P) (foot : P → Finset W) (a : ℕ) {B : ℝ}
    (hB : 0 ≤ B) (hsize : ∀p∈F, (foot p).card ≤ a)
    (hload : ∀w, ((F.filter (fun p => w∈foot p)).card : ℝ) ≤ B) :
    (((F×ˢF).filter (fun p => ¬Disjoint (foot p.1) (foot p.2))).card : ℝ) ≤ F.card*(a*B) := by
  classical
  let S := (F×ˢF).filter (fun p => ¬Disjoint (foot p.1) (foot p.2))
  apply RealFiberCount.bound S F Prod.fst
  · intro p hp; exact (mem_product.mp (mem_filter.mp hp).1).1
  · intro p hp
    have hc : (S.filter (fun q => q.1=p)).card ≤ (F.filter (fun q => ¬Disjoint (foot p) (foot q))).card := by
      apply card_le_card_of_injOn Prod.snd
      · intro q hq
        obtain ⟨hq,he⟩ := mem_filter.mp hq
        obtain ⟨hq,hd⟩ := mem_filter.mp hq
        exact mem_filter.mpr ⟨(mem_product.mp hq).2,he ▸ hd⟩
      · intro q hq r hr he
        exact Prod.ext ((mem_filter.mp hq).2.trans (mem_filter.mp hr).2.symm) he
    exact (show ((S.filter (fun q => q.1=p)).card : ℝ) ≤ _ by exact_mod_cast hc).trans
      (neighbor_bound F foot a hB hsize hload p hp)

lemma triple_error (F : Finset P) (foot : P → Finset W) (a : ℕ) {B : ℝ}
    (hB : 0 ≤ B) (hsize : ∀p∈F, (foot p).card ≤ a)
    (hload : ∀w, ((F.filter (fun p => w∈foot p)).card : ℝ) ≤ B) :
    (F.card : ℝ)^3 ≤ (triples F foot).card + 3*a*B*(F.card : ℝ)^2 := by
  classical
  let Bad := ((F×ˢF).filter (fun p => ¬Disjoint (foot p.1) (foot p.2)))×ˢF
  let e1 : (P×P)×P → P×P×P := fun p => (p.1.1,p.1.2,p.2)
  let e2 : (P×P)×P → P×P×P := fun p => (p.1.1,p.2,p.1.2)
  let e3 : (P×P)×P → P×P×P := fun p => (p.2,p.1.1,p.1.2)
  have hs : F×ˢ(F×ˢF) ⊆ triples F foot ∪ Bad.image e1 ∪ Bad.image e2 ∪ Bad.image e3 := by
    rintro ⟨p,q,r⟩ hpqr
    obtain ⟨hp,hq,hr⟩ := mem_product.mp hpqr |>.imp_right mem_product.mp
    by_cases h1 : Disjoint (foot p) (foot q)
    swap
    · exact mem_union_left _ (mem_union_left _ (mem_union_right _ (mem_image.mpr
        ⟨((p,q),r),mem_product.mpr ⟨mem_filter.mpr ⟨mem_product.mpr ⟨hp,hq⟩,h1⟩,hr⟩,rfl⟩)))
    by_cases h2 : Disjoint (foot p) (foot r)
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_image.mpr
        ⟨((p,r),q),mem_product.mpr ⟨mem_filter.mpr ⟨mem_product.mpr ⟨hp,hr⟩,h2⟩,hq⟩,rfl⟩))
    by_cases h3 : Disjoint (foot q) (foot r)
    swap
    · exact mem_union_right _ (mem_image.mpr
        ⟨((q,r),p),mem_product.mpr ⟨mem_filter.mpr ⟨mem_product.mpr ⟨hq,hr⟩,h3⟩,hp⟩,rfl⟩)
    exact mem_union_left _ (mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hpqr,h1,h2,h3⟩)))
  have hc : F.card^3 ≤ (triples F foot).card+3*Bad.card := by
    have h := card_le_card hs
    have h1 := card_union_le (triples F foot) (Bad.image e1)
    have h2 := card_union_le (triples F foot ∪ Bad.image e1) (Bad.image e2)
    have h3 := card_union_le (triples F foot ∪ Bad.image e1 ∪ Bad.image e2) (Bad.image e3)
    have hi1 := card_image_le (s := Bad) (f := e1)
    have hi2 := card_image_le (s := Bad) (f := e2)
    have hi3 := card_image_le (s := Bad) (f := e3)
    simp only [card_product] at h
    nlinarith
  have hb : (Bad.card : ℝ) ≤ (F.card : ℝ)^2*(a*B) := by
    have h := mul_le_mul_of_nonneg_right (pair_bound F foot a hB hsize hload) (Nat.cast_nonneg F.card)
    simp only [Bad,card_product,Nat.cast_mul]
    nlinarith [h]
  have hc' : (F.card : ℝ)^3 ≤ (triples F foot).card+3*(Bad.card : ℝ) := by exact_mod_cast hc
  nlinarith

lemma half_lower (F : Finset P) (foot : P → Finset W) (a : ℕ) {B : ℝ}
    (hB : 0 ≤ B) (hsize : ∀p∈F, (foot p).card ≤ a)
    (hload : ∀w, ((F.filter (fun p => w∈foot p)).card : ℝ) ≤ B)
    (hlarge : 6*a*B ≤ (F.card : ℝ)) :
    (F.card : ℝ)^3/2 ≤ (triples F foot).card := by
  have h := triple_error F foot a hB hsize hload
  have hh := mul_le_mul_of_nonneg_right hlarge (sq_nonneg (F.card : ℝ))
  nlinarith

/-- Small fibers cost only a linear error; the remaining fibers contribute a cubic moment. -/
lemma sum_lower {I : Type*} [DecidableEq I] (S : Finset I) (F : I → Finset P)
    (foot : P → Finset W) (a : ℕ) {B L : ℝ} (hB : 0 ≤ B) (hL : 0 ≤ L)
    (hsize : ∀i∈S, ∀p∈F i, (foot p).card ≤ a)
    (hload : ∀i∈S, ∀w, (((F i).filter (fun p => w∈foot p)).card : ℝ) ≤ B)
    (htotal : L+6*a*B*S.card ≤ ∑i∈S, ((F i).card : ℝ)) :
    L^3 ≤ 2*(S.card : ℝ)^2*∑i∈S, ((triples (F i) foot).card : ℝ) := by
  classical
  let R := S.filter (fun i => 6*a*B ≤ ((F i).card : ℝ))
  let P := S.filter (fun i => ¬6*a*B ≤ ((F i).card : ℝ))
  have he : (∑i∈R, ((F i).card : ℝ))+(∑i∈P, ((F i).card : ℝ))=∑i∈S, ((F i).card : ℝ) :=
    sum_filter_add_sum_filter_not S _ _
  have hp : ∑i∈P, ((F i).card : ℝ) ≤ 6*a*B*S.card := by
    calc
      _ ≤ ∑_i∈P, 6*a*B := sum_le_sum (fun i hi => le_of_lt (lt_of_not_ge (mem_filter.mp hi).2))
      _ = (P.card : ℝ)*(6*a*B) := by simp
      _ ≤ (S.card : ℝ)*(6*a*B) := mul_le_mul_of_nonneg_right
        (by exact_mod_cast card_le_card (filter_subset _ S)) (by positivity)
      _ = _ := by ring
  have hl : L ≤ ∑i∈R, ((F i).card : ℝ) := by linarith
  have hc := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg R (f := fun i => ((F i).card : ℝ))
    (p := (3 : ℝ)) (by norm_num) (fun i _ => Nat.cast_nonneg _)
  norm_num only [show (3 : ℝ)-1=2 by norm_num,Real.rpow_ofNat] at hc
  have hh : (∑i∈R, ((F i).card : ℝ)^3) ≤ 2*∑i∈R, ((triples (F i) foot).card : ℝ) := by
    rw [mul_sum]
    apply sum_le_sum
    intro i hi
    have h := half_lower (F i) foot a hB (hsize i (mem_filter.mp hi).1)
      (hload i (mem_filter.mp hi).1) (mem_filter.mp hi).2
    linarith
  have hr : (R.card : ℝ)^2 ≤ (S.card : ℝ)^2 := pow_le_pow_left₀ (Nat.cast_nonneg _)
    (by exact_mod_cast card_le_card (filter_subset _ S)) _
  have ht : (∑i∈R, ((triples (F i) foot).card : ℝ)) ≤ ∑i∈S, ((triples (F i) foot).card : ℝ) :=
    sum_le_sum_of_subset_of_nonneg (filter_subset _ S) (fun _ _ _ => Nat.cast_nonneg _)
  calc
    _ ≤ (∑i∈R, ((F i).card : ℝ))^3 := pow_le_pow_left₀ hL hl _
    _ ≤ (R.card : ℝ)^2*∑i∈R, ((F i).card : ℝ)^3 := hc
    _ ≤ (S.card : ℝ)^2*(2*∑i∈S, ((triples (F i) foot).card : ℝ)) :=
      mul_le_mul hr (hh.trans (mul_le_mul_of_nonneg_left ht (by norm_num)))
        (sum_nonneg (fun _ _ => by positivity)) (sq_nonneg _)
    _ = _ := by ring

end Erdos571.DisjointTripleCount

/-! Four-path fibers with polynomial vertex loads, without nonrich-subpath assumptions. -/
namespace Erdos571.LightFourFibers
open SimpleGraph Finset DensityRegularization
variable {W : Type} [DecidableEq W]

abbrev Interior (W : Type) := W × W × W

def foot (p : Interior W) : Finset W := {p.1,p.2.1,p.2.2}

lemma foot_card (p : Interior W) : (foot p).card ≤ 3 := by
  have h1 := card_insert_le p.1 ({p.2.1,p.2.2} : Finset W)
  have h2 : ({p.2.1,p.2.2} : Finset W).card ≤ 2 := card_le_two
  unfold foot
  omega

def fiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (z x : W) :
    Finset (Interior W) := (U ×ˢ (U×ˢU)).filter
      (fun p => (z,((p.1,p.2.1),(p.2.2,x)))∈ThetaFour.lightFour G U t)

lemma mem_fiber {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t : ℕ} {z x u a b : W} :
    (u,a,b)∈fiber G U t z x ↔ z∈U ∧ u∈U ∧ a∈U ∧ b∈U ∧ x∈U ∧
      G.Adj z u ∧ G.Adj u a ∧ G.Adj a b ∧ G.Adj b x ∧
      ¬ShortSpider.Bad G U t z a ∧ ¬ShortSpider.Bad G U t u b ∧ ¬ShortSpider.Bad G U t a x := by
  simp only [fiber,mem_filter,mem_product,ThetaFour.mem_lightFour]
  tauto

lemma three_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ) ≤ D) (z x : W) :
    ((ThetaFour.threeFiber G U t z x).card : ℝ) ≤ (t : ℝ)*D := by
  classical
  by_cases hn : (ThetaFour.threeFiber G U t z x).Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
  obtain ⟨p,hp⟩ := hn
  have hz := (ThetaFour.mem_threeFiber.mp hp).1
  have hb := RealFiberCount.bound (ThetaFour.threeFiber G U t z x) (neighbors G U z) Prod.fst (D := (t : ℝ))
    (by intro p hp; have h := ThetaFour.mem_threeFiber.mp hp; exact mem_filter.mpr ⟨h.2.1,h.2.2.2.2.1⟩)
    (by intro w hw; exact_mod_cast ThetaFour.threeFiber_row G U t z x w)
  have hh := mul_le_mul_of_nonneg_right (hdeg z hz) (Nat.cast_nonneg t : (0 : ℝ)≤t)
  nlinarith

lemma first_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ) ≤ D) (z x w : W) :
    (((fiber G U t z x).filter (fun p => p.1=w)).card : ℝ) ≤ (t : ℝ)*D := by
  classical
  have hc : ((fiber G U t z x).filter (fun p => p.1=w)).card ≤ (ThetaFour.threeFiber G U t w x).card := by
    apply card_le_card_of_injOn Prod.snd
    · rintro ⟨u,a,b⟩ hp
      obtain ⟨hp,he⟩ := mem_filter.mp hp
      change u=w at he
      subst u
      obtain ⟨hz,hw,ha,hb,hx,hzw,hwa,hab,hbx,hl,hm,hr⟩ := mem_fiber.mp hp
      exact ThetaFour.mem_threeFiber.mpr ⟨hw,ha,hb,hx,hwa,hab,hbx,hm,hr⟩
    · intro p hp q hq he
      exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) he
  exact (show _ ≤ ((ThetaFour.threeFiber G U t w x).card : ℝ) by exact_mod_cast hc).trans
    (three_bound G U t hD hdeg w x)

lemma last_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ) ≤ D) (z x w : W) :
    (((fiber G U t z x).filter (fun p => p.2.2=w)).card : ℝ) ≤ (t : ℝ)*D := by
  classical
  have hc : ((fiber G U t z x).filter (fun p => p.2.2=w)).card ≤ (ThetaFour.threeFiber G U t w z).card := by
    apply card_le_card_of_injOn (fun p : Interior W => (p.2.1,p.1))
    · rintro ⟨u,a,b⟩ hp
      obtain ⟨hp,he⟩ := mem_filter.mp hp
      change b=w at he
      subst b
      obtain ⟨hz,hu,ha,hw,hx,hzu,hua,haw,hwx,hl,hm,hr⟩ := mem_fiber.mp hp
      exact ThetaFour.mem_threeFiber.mpr ⟨hw,ha,hu,hz,haw.symm,hua.symm,hzu.symm,
        fun h => hm ((ShortSpider.bad_symm G U t).mpr h),
        fun h => hl ((ShortSpider.bad_symm G U t).mpr h)⟩
    · intro p hp q hq he
      have he' : p.2.1=q.2.1 ∧ p.1=q.1 := Prod.mk.inj he
      exact Prod.ext he'.2 (Prod.ext he'.1
        ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm))
  exact (show _ ≤ ((ThetaFour.threeFiber G U t w z).card : ℝ) by exact_mod_cast hc).trans
    (three_bound G U t hD hdeg w z)

lemma center_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (z x w : W) :
    ((fiber G U t z x).filter (fun p => p.2.1=w)).card ≤ t^2 := by
  classical
  let F := (fiber G U t z x).filter (fun p => p.2.1=w)
  by_cases hn : F.Nonempty
  swap
  · rw [show (fiber G U t z x).filter (fun p => p.2.1=w)=∅ from not_nonempty_iff_eq_empty.mp hn,card_empty]
    omega
  obtain ⟨p,hp⟩ := hn
  have he : p.2.1=w := (mem_filter.mp hp).2
  have hh := mem_fiber.mp (mem_filter.mp hp).1
  have hl : ¬ShortSpider.Bad G U t z w := he ▸ hh.2.2.2.2.2.2.2.2.2.1
  have hr : ¬ShortSpider.Bad G U t w x := he ▸ hh.2.2.2.2.2.2.2.2.2.2.2
  have hL : (FourthMoment.common G U z w).card ≤ t := (lt_of_not_ge (fun h => hl (Or.inr h))).le
  have hR : (FourthMoment.common G U w x).card ≤ t := (lt_of_not_ge (fun h => hr (Or.inr h))).le
  have hc : F.card ≤ ((FourthMoment.common G U z w) ×ˢ (FourthMoment.common G U w x)).card := by
    apply card_le_card_of_injOn (fun p : Interior W => (p.1,p.2.2))
    · rintro ⟨u,a,b⟩ hp
      obtain ⟨hp,he⟩ := mem_filter.mp hp
      change a=w at he
      subst a
      obtain ⟨hz,hu,hw,hb,hx,hzu,huw,hwb,hbx,hl,hm,hr⟩ := mem_fiber.mp hp
      exact mem_product.mpr ⟨mem_filter.mpr ⟨hu,hzu,huw.symm⟩,mem_filter.mpr ⟨hb,hwb,hbx.symm⟩⟩
    · intro p hp q hq he
      have he' : p.1=q.1 ∧ p.2.2=q.2.2 := Prod.mk.inj he
      exact Prod.ext he'.1 (Prod.ext
        ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) he'.2)
  exact hc.trans (by rw [card_product,pow_two]; exact Nat.mul_le_mul hL hR)

lemma load_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ) ≤ D) (z x w : W) :
    (((fiber G U t z x).filter (fun p => w∈foot p)).card : ℝ) ≤ (t : ℝ)^2+2*t*D := by
  classical
  let F := fiber G U t z x
  have hs : F.filter (fun p => w∈foot p) ⊆
      F.filter (fun p => p.1=w) ∪ F.filter (fun p => p.2.1=w) ∪ F.filter (fun p => p.2.2=w) := by
    intro p hp
    obtain ⟨hp,hm⟩ := mem_filter.mp hp
    simp only [foot,mem_insert,mem_singleton] at hm
    rcases hm with hm|hm|hm
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hp,hm.symm⟩))
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hp,hm.symm⟩))
    · exact mem_union_right _ (mem_filter.mpr ⟨hp,hm.symm⟩)
  have hc := (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hc' : ((F.filter (fun p => w∈foot p)).card : ℝ) ≤
      ((F.filter (fun p => p.1=w)).card : ℝ)+((F.filter (fun p => p.2.1=w)).card : ℝ)+
        ((F.filter (fun p => p.2.2=w)).card : ℝ) := by exact_mod_cast hc
  have h1 := first_bound G U t hD hdeg z x w
  have h2 : (((F.filter (fun p => p.2.1=w)).card) : ℝ) ≤ (t : ℝ)^2 := by exact_mod_cast center_bound G U t z x w
  have h3 := last_bound G U t hD hdeg z x w
  dsimp [F] at hc' h2
  linarith

def endpoints (p : ThetaFour.Four W) : W×W := (p.1,p.2.2.2)

def pairs (U : Finset W) : Finset (W×W) := (U×ˢU).filter (fun p => p.1≠p.2)

def openFour (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : Finset (ThetaFour.Four W) :=
  (ThetaFour.lightFour G U t).filter (fun p => p.1≠p.2.2.2)

lemma fiber_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) (z x : W) :
    ((ThetaFour.lightFour G U t).filter (fun p => endpoints p=(z,x))).card=(fiber G U t z x).card := by
  apply card_bij (fun p _ => (p.2.1.1,p.2.1.2,p.2.2.1))
  · rintro ⟨z',⟨⟨u,a⟩,⟨b,x'⟩⟩⟩ hp
    have hl := (mem_filter.mp hp).1
    have he' : z'=z ∧ x'=x := Prod.mk.inj (mem_filter.mp hp).2
    rcases he' with ⟨rfl,rfl⟩
    exact mem_fiber.mpr (ThetaFour.mem_lightFour.mp hl)
  · intro p hp q hq he
    have hp' : p.1=z ∧ p.2.2.2=x := Prod.mk.inj (mem_filter.mp hp).2
    have hq' : q.1=z ∧ q.2.2.2=x := Prod.mk.inj (mem_filter.mp hq).2
    have he' : p.2.1.1=q.2.1.1 ∧ p.2.1.2=q.2.1.2 ∧ p.2.2.1=q.2.2.1 := by
      simpa only [Prod.mk.injEq] using he
    exact Prod.ext (hp'.1.trans hq'.1.symm) (Prod.ext (Prod.ext he'.1 he'.2.1)
      (Prod.ext he'.2.2 (hp'.2.trans hq'.2.symm)))
  · rintro ⟨u,a,b⟩ hp
    exact ⟨(z,((u,a),(b,x))),mem_filter.mpr ⟨ThetaFour.mem_lightFour.mpr (mem_fiber.mp hp),rfl⟩,rfl⟩

lemma open_fiber_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (z x : W) (hzx : z≠x) :
    ((openFour G U t).filter (fun p => endpoints p=(z,x))).card=(fiber G U t z x).card := by
  have he : (openFour G U t).filter (fun p => endpoints p=(z,x)) =
      (ThetaFour.lightFour G U t).filter (fun p => endpoints p=(z,x)) := by
    ext p
    simp only [openFour,mem_filter]
    constructor
    · exact fun h => ⟨h.1.1,h.2⟩
    · intro h
      have hh : p.1=z ∧ p.2.2.2=x := Prod.mk.inj h.2
      exact ⟨⟨h.1,by rw [hh.1,hh.2]; exact hzx⟩,h.2⟩
  rw [he,fiber_card]

lemma sum_fiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    (∑p∈pairs U, (fiber G U t p.1 p.2).card)=(openFour G U t).card := by
  have hm : Set.MapsTo (endpoints : ThetaFour.Four W → W×W) (openFour G U t) (pairs U) := by
    intro p hp
    have hh := ThetaFour.mem_lightFour.mp (mem_filter.mp hp).1
    exact mem_filter.mpr ⟨mem_product.mpr ⟨hh.1,hh.2.2.2.2.1⟩,(mem_filter.mp hp).2⟩
  rw [card_eq_sum_card_fiberwise hm]
  apply sum_congr rfl
  intro p hp
  exact (open_fiber_card G U t p.1 p.2 (mem_filter.mp hp).2).symm

lemma pairs_card (U : Finset W) : (pairs U).card ≤ U.card^2 := by
  exact (card_le_card (filter_subset _ (U×ˢU))).trans_eq (by rw [card_product,pow_two])

end Erdos571.LightFourFibers

/-! Abundant triples of internally disjoint light four-paths in subdivision-free hosts. -/
namespace Erdos571.LightFourFibers
open SimpleGraph Finset DensityRegularization ProjectionHeavy HostHeavyShadow

lemma heavy_pairs_bound {V W : Type} [Fintype V] [DecidableEq W] (H : SimpleGraph V) {α C : ℝ}
    (hbound : EdgeBound H α C) (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (hSU : S⊆U) (hf : (subdivision H).Free G) :
    ((heavyPairs (arcs G U) U (Fintype.card V+Nat.card H.edgeSet) S).card : ℝ) ≤
      2*C*(S.card : ℝ)^α := by
  classical
  have he : heavyPairs (arcs G U) U (Fintype.card V+Nat.card H.edgeSet) S =
      arcs (HostHeavyShadow.graph G U (Fintype.card V+Nat.card H.edgeSet)) S := by
    ext ⟨u,v⟩
    rw [mem_heavyPairs,mem_arcs]
    by_cases hu : u∈S
    swap
    · simp [hu]
    by_cases hv : v∈S
    swap
    · simp [hv]
    simp only [hu,hv,true_and,HostHeavyShadow.graph,ShortSpider.common_eq G U (hSU hu) (hSU hv)]
  rw [he]
  exact HostHeavyShadow.arcs_bound H hbound G U S hf

lemma open_lower_with_error {V W : Type} [Fintype V] [DecidableEq W] (H : SimpleGraph V) {α C : ℝ}
    (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hf : (subdivision H).Free G)
    {d D : ℝ} (hd : 0 ≤ d) (hD : 0 ≤ D)
    (hdeg : ∀v∈U, d ≤ ((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ) ≤ D) :
    (U.card : ℝ)*d^4 ≤ (openFour G U (Fintype.card V+Nat.card H.edgeSet)).card+
      U.card*((2*d*D+D^2)*(D+2*C*D^α)+(Fintype.card V+Nat.card H.edgeSet : ℕ)*D^2) := by
  classical
  let t := Fintype.card V+Nat.card H.edgeSet
  have hh : (∑x∈U, ((heavyPairs (arcs G U) U t (neighbors G U x)).card : ℝ)) ≤ U.card*(2*C*D^α) := by
    calc
      _ ≤ ∑_x∈U, 2*C*D^α := by
        apply sum_le_sum
        intro x hx
        exact (heavy_pairs_bound H hbound G U (neighbors G U x) (filter_subset _ _) hf).trans
          (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) (hdeg x hx).2 hα) (by positivity))
      _ = _ := by simp
  have hl := ThetaFour.lightFour_lower G U t hd hD hdeg
  have hc := ThetaFour.closed_bound G U t hD (fun v hv => (hdeg v hv).2)
  have hs : (openFour G U t).card+((ThetaFour.lightFour G U t).filter (fun p => p.1=p.2.2.2)).card =
      (ThetaFour.lightFour G U t).card := by
    simpa only [openFour,not_not] using card_filter_add_card_filter_not
      (s := ThetaFour.lightFour G U t) (fun p => p.1≠p.2.2.2)
  have hs' : ((openFour G U t).card : ℝ)+((ThetaFour.lightFour G U t).filter (fun p => p.1=p.2.2.2)).card =
      (ThetaFour.lightFour G U t).card := by exact_mod_cast hs
  have hmul := mul_le_mul_of_nonneg_left hh (show 0 ≤ 2*d*D+D^2 by positivity)
  change (U.card : ℝ)*d^4 ≤ (openFour G U t).card+
    U.card*((2*d*D+D^2)*(D+2*C*D^α)+(t : ℝ)*D^2)
  nlinarith

lemma exists_open_threshold (Q C α : ℝ) (t : ℕ) (hQ : 1 ≤ Q) (hα : α<2) :
    ∃L : ℝ, 1 ≤ L ∧ ∀d : ℝ, L ≤ d →
      (2*d*(Q*d)+(Q*d)^2)*(Q*d+2*C*(Q*d)^α)+(t : ℝ)*(Q*d)^2 ≤ d^4/2 := by
  let A := 2*Q+Q^2
  have hA : 0<A := by dsimp [A]; nlinarith [sq_nonneg Q]
  obtain ⟨L₀,hL₀,herr⟩ := HostHeavyShadow.exists_mass_threshold Q C α (1/(4*A)) hQ hα (by positivity)
  refine ⟨max (max 1 (4*t*Q^2)) L₀,(le_max_left _ _).trans (le_max_left _ _),?_⟩
  intro d hd
  have hd1 : 1≤d := (le_max_left _ _).trans ((le_max_left _ _).trans hd)
  have hd0 : 0≤d := by linarith
  have ht : 4*t*Q^2 ≤ d := (le_max_right _ _).trans ((le_max_left _ _).trans hd)
  have ht' : 4*t*Q^2 ≤ d^2 := ht.trans (by nlinarith [mul_le_mul_of_nonneg_right hd1 hd0])
  have hm := herr d ((le_max_right _ _).trans hd)
  have he := mul_le_mul_of_nonneg_right ht' (sq_nonneg d)
  calc
    _ = A*d^2*(Q*d+2*C*(Q*d)^α)+(t : ℝ)*Q^2*d^2 := by dsimp [A]; ring
    _ ≤ A*d^2*((1/(4*A))*d^2)+d^4/4 := add_le_add
      (mul_le_mul_of_nonneg_left hm (by positivity)) (by nlinarith [he])
    _ = _ := by field_simp; ring

lemma open_abundance {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hα0 : 0 ≤ α) (hα2 : α<2) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃L : ℝ, 1 ≤ L ∧ ∀{W : Type} [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj]
      (U : Finset W), (subdivision H).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d ≤ ((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ) ≤ Q*d) →
      (U.card : ℝ)*d^4/2 ≤ (openFour G U (Fintype.card V+Nat.card H.edgeSet)).card := by
  obtain ⟨L,hL,herr⟩ := exists_open_threshold Q C α (Fintype.card V+Nat.card H.edgeSet) hQ hα2
  refine ⟨L,hL,?_⟩
  intro W _ G _ U hf d hd hdeg
  have hd0 : 0≤d := by linarith
  have hQ0 : 0≤Q := by linarith
  have h := open_lower_with_error H hα0 hC hbound G U hf hd0 (mul_nonneg hQ0 hd0) hdeg
  have he := mul_le_mul_of_nonneg_left (herr d hd) (Nat.cast_nonneg U.card)
  nlinarith

variable {W : Type} [DecidableEq W]

noncomputable def totalTriples (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : ℕ :=
  ∑p∈pairs U, (DisjointTripleCount.triples (fiber G U t p.1 p.2) foot).card

/-- Cubic averaging gives the expected d^12/n count, provided d^3 is large compared with n. -/
lemma triple_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty) (t : ℕ)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 1≤d)
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ) ≤ Q*d)
    (hopen : (U.card : ℝ)*d^4/2 ≤ (openFour G U t).card)
    (hscale : 72*((t : ℝ)^2+2*t*Q)*U.card ≤ d^3) :
    d^12 ≤ 128*(U.card : ℝ)*totalTriples G U t := by
  classical
  have hd0 : 0≤d := by linarith
  have hQ0 : 0≤Q := by linarith
  have hn : 0<(U.card : ℝ) := by exact_mod_cast hU.card_pos
  let B := (t : ℝ)^2+2*t*(Q*d)
  have hB : 0≤B := by dsimp [B]; positivity
  have hB' : B ≤ ((t : ℝ)^2+2*t*Q)*d := by
    have hh := mul_le_mul_of_nonneg_left hd (sq_nonneg (t : ℝ))
    dsimp [B]
    nlinarith
  have hsmall : 18*B*(pairs U).card ≤ (U.card : ℝ)*d^4/4 := by
    have hp : ((pairs U).card : ℝ) ≤ (U.card : ℝ)^2 := by exact_mod_cast pairs_card U
    have h1 := mul_le_mul_of_nonneg_left hp (show 0≤18*B by positivity)
    have h2 := mul_le_mul_of_nonneg_right hB' (show 0≤18*(U.card : ℝ)^2 by positivity)
    have h3 := mul_le_mul_of_nonneg_right hscale (show 0≤(U.card : ℝ)*d by positivity)
    nlinarith [h1,h2,h3]
  have htotal : (U.card : ℝ)*d^4/4+6*3*B*(pairs U).card ≤ ∑p∈pairs U, ((fiber G U t p.1 p.2).card : ℝ) := by
    rw [← Nat.cast_sum,sum_fiber]
    nlinarith
  have hh := DisjointTripleCount.sum_lower (pairs U) (fun p => fiber G U t p.1 p.2) foot 3 hB
    (show 0≤(U.card : ℝ)*d^4/4 by positivity)
    (fun p hp q hq => foot_card q)
    (fun p hp w => load_bound G U t (mul_nonneg hQ0 hd0) hmax p.1 p.2 w) htotal
  have hp : ((pairs U).card : ℝ)^2 ≤ (U.card : ℝ)^4 := by
    have h := pow_le_pow_left₀ (Nat.cast_nonneg (pairs U).card)
      (show ((pairs U).card : ℝ) ≤ (U.card : ℝ)^2 by exact_mod_cast pairs_card U) 2
    nlinarith [h]
  have hc : (0 : ℝ)≤totalTriples G U t := Nat.cast_nonneg _
  have he : (∑p∈pairs U, ((DisjointTripleCount.triples (fiber G U t p.1 p.2) foot).card : ℝ)) =
      (totalTriples G U t : ℝ) := by simp only [totalTriples,Nat.cast_sum]
  rw [he] at hh
  have hmul := mul_le_mul_of_nonneg_right hp (show 0≤2*(totalTriples G U t : ℝ) by positivity)
  have hh' : (U.card : ℝ)^3*d^12 ≤ 128*(U.card : ℝ)^4*totalTriples G U t := by nlinarith [hh,hmul]
  apply (mul_le_mul_iff_right₀ (pow_pos hn 3)).mp
  nlinarith [hh']

end Erdos571.LightFourFibers

/-! Disjoint light four-path triples give injective copies of a three-path theta graph. -/
namespace Erdos571.LightFourFibers
open SimpleGraph Finset DensityRegularization
variable {W : Type} [DecidableEq W]

def pathCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (z x : W) (hzx : z≠x) (p : Interior W) (hp : p∈fiber G U t z x) : ThetaFour.template.Copy G := by
  have hw := mem_fiber.mp hp
  have hzu := hw.2.2.2.2.2.1
  have hua := hw.2.2.2.2.2.2.1
  have hab := hw.2.2.2.2.2.2.2.1
  have hbx := hw.2.2.2.2.2.2.2.2.1
  have hza : z≠p.2.1 := fun h => hw.2.2.2.2.2.2.2.2.2.1 (Or.inl h)
  have hub : p.1≠p.2.2 := fun h => hw.2.2.2.2.2.2.2.2.2.2.1 (Or.inl h)
  have hax : p.2.1≠x := fun h => hw.2.2.2.2.2.2.2.2.2.2.2 (Or.inl h)
  have hzb : z≠p.2.2 := by
    have hcol := ShortSpider.same_color_of_two_steps G g hg hzu hua
    intro he
    exact hg hab (hcol.symm.trans (congrArg g he))
  have hux : p.1≠x := by
    have hcol := ShortSpider.same_color_of_two_steps G g hg hua hab
    intro he
    exact hg hbx (hcol.symm.trans (congrArg g he))
  exact ThetaFour.pathCopy G z p.1 p.2.1 p.2.2 x hzu hua hab hbx hza hzb hzx hub hux hax

lemma pathCopy_root (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (z x : W) (hzx : z≠x) (p : Interior W) (hp : p∈fiber G U t z x) (j : Fin 2) :
    pathCopy G U t g hg z x hzx p hp (.inr j)=![z,x] j := by fin_cases j <;> rfl

lemma pathCopy_interior (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (z x : W) (hzx : z≠x) (p : Interior W) (hp : p∈fiber G U t z x) :
    RootedPacking.interior (pathCopy G U t g hg z x hzx p hp)=foot p := by
  classical
  ext w
  simp only [RootedPacking.interior,mem_image,mem_univ,true_and,foot,mem_insert,mem_singleton]
  constructor
  · rintro ⟨a,ha⟩
    fin_cases a
    · exact Or.inr (Or.inl ha.symm)
    · exact Or.inl ha.symm
    · exact Or.inr (Or.inr ha.symm)
  · rintro (h|h|h)
    · exact ⟨some 0,h.symm⟩
    · exact ⟨none,h.symm⟩
    · exact ⟨some 1,h.symm⟩

abbrev Data (W : Type) := (p : W×W) × (Interior W × Interior W × Interior W)

noncomputable def data (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) : Finset (Data W) :=
  (pairs U).sigma (fun p => DisjointTripleCount.triples (fiber G U t p.1 p.2) foot)

lemma data_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    (data G U t).card=totalTriples G U t := card_sigma _ _

def paths (p : Interior W × Interior W × Interior W) : Fin 3 → Interior W := ![p.1,p.2.1,p.2.2]

lemma paths_mem (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (p : Data W) (hp : p∈data G U t) (i : Fin 3) : paths p.2 i∈fiber G U t p.1.1 p.1.2 := by
  have hh := (mem_filter.mp (mem_sigma.mp hp).2).1
  have h1 := (mem_product.mp hh).1
  have h2 := (mem_product.mp (mem_product.mp hh).2).1
  have h3 := (mem_product.mp (mem_product.mp hh).2).2
  fin_cases i <;> assumption

lemma paths_disjoint (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (p : Data W) (hp : p∈data G U t) : Pairwise (fun i j : Fin 3 => Disjoint (foot (paths p.2 i)) (foot (paths p.2 j))) := by
  have hh := (mem_filter.mp (mem_sigma.mp hp).2).2
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp_all [paths,Disjoint.symm]

def copy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (p : Data W) (hp : p∈data G U t) : (ThetaFour.graph 3).Copy G := by
  have hzx := (mem_filter.mp (mem_sigma.mp hp).1).2
  let r : Fin 2 ↪ W := ⟨![p.1.1,p.1.2],by
    intro i j he
    fin_cases i <;> fin_cases j <;> simp_all⟩
  let f (i : Fin 3) := pathCopy G U t g hg p.1.1 p.1.2 hzx (paths p.2 i) (paths_mem G U t p hp i)
  exact RootedPacking.powerCopy 3 r f
    (fun i j => pathCopy_root G U t g hg _ _ hzx _ _ j)
    (fun i j hij => by
      rw [pathCopy_interior,pathCopy_interior]
      exact paths_disjoint G U t p hp hij)

def readCopy {G : SimpleGraph W} (f : (ThetaFour.graph 3).Copy G) : Data W :=
  ⟨(f (.inr 0),f (.inr 1)),
    ((f (.inl (0,some 0)),f (.inl (0,none)),f (.inl (0,some 1))),
     (f (.inl (1,some 0)),f (.inl (1,none)),f (.inl (1,some 1))),
     (f (.inl (2,some 0)),f (.inl (2,none)),f (.inl (2,some 1))))⟩

lemma read_copy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (p : Data W) (hp : p∈data G U t) :
    readCopy (copy G U t g hg p hp)=p := rfl

lemma copy_injective (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    Function.Injective (fun p : data G U t => copy G U t g hg p.val p.property) := by
  intro p q he
  apply Subtype.ext
  simpa only [read_copy] using congrArg readCopy he

lemma copy_mem (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (p : Data W) (hp : p∈data G U t) :
    ∀v, copy G U t g hg p hp v∈U := by
  intro v
  have he := (mem_product.mp (mem_filter.mp (mem_sigma.mp hp).1).1)
  cases v with
  | inl v =>
    obtain ⟨i,a⟩ := v
    have hh := mem_fiber.mp (paths_mem G U t p hp i)
    fin_cases a
    · exact hh.2.2.1
    · exact hh.2.1
    · exact hh.2.2.2.1
  | inr j => fin_cases j <;> first | exact he.1 | exact he.2

lemma totalTriples_le_copies [Fintype W] (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    totalTriples G U t ≤ (TreeCopiesIn.copies (ThetaFour.graph 3) G U).card := by
  classical
  let f : data G U t → TreeCopiesIn.copies (ThetaFour.graph 3) G U := fun p =>
    ⟨copy G U t g hg p.val p.property,(TreeCopiesIn.mem_copies _ _ _ _).mpr (copy_mem G U t g hg p.val p.property)⟩
  have hinj : Function.Injective f := by
    intro p q he
    exact copy_injective G U t g hg (congrArg Subtype.val he)
  have hc := Fintype.card_le_of_injective f hinj
  simpa only [Fintype.card_coe,data_card] using hc

/-- A quantitative cyclic-core count. Only the individual four-paths are required
  to be light; no claim of lightness across different paths is made. -/
theorem theta_abundance {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hα0 : 0≤α) (hα2 : α<2) (hC : 0≤C) (hbound : ProjectionHeavy.EdgeBound H α C)
    (Q : ℝ) (hQ : 1≤Q) :
    ∃L : ℝ, 1≤L ∧ ∀{W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W), U.Nonempty →
      (g : W → Bool) → (∀{u v}, G.Adj u v → g u≠g v) →
      (ProjectionHeavy.subdivision H).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) →
      72*((Fintype.card V+Nat.card H.edgeSet : ℕ)^2+
        2*(Fintype.card V+Nat.card H.edgeSet : ℕ)*Q)*U.card ≤ d^3 →
      d^12 ≤ 128*(U.card : ℝ)*(TreeCopiesIn.copies (ThetaFour.graph 3) G U).card := by
  obtain ⟨L,hL,hopen⟩ := open_abundance H hα0 hα2 hC hbound Q hQ
  refine ⟨L,hL,?_⟩
  intro W _ _ G _ U hU g hg hf d hd hdeg hscale
  have ht := triple_lower G U hU (Fintype.card V+Nat.card H.edgeSet) hQ (hL.trans hd)
    (fun v hv => (hdeg v hv).2) (hopen G U hf d hd hdeg) (by exact_mod_cast hscale)
  have hc : (totalTriples G U (Fintype.card V+Nat.card H.edgeSet) : ℝ) ≤
      (TreeCopiesIn.copies (ThetaFour.graph 3) G U).card := by exact_mod_cast totalTriples_le_copies G U _ g hg
  exact ht.trans (mul_le_mul_of_nonneg_left hc (by positivity))

end Erdos571.LightFourFibers

/-! Identifying and counting the cyclic core of the slim subdivision template. -/
set_option maxHeartbeats 3000000
namespace Erdos571.SlimConedSubdivision
open SimpleGraph Finset DensityRegularization ProjectionHeavy

abbrev Old := Option (Fin 2) ⊕ ((Option (Fin 2) ⊕ Bool) ⊕ Bool)

def endpoint (j : Fin 2) : Old := .inl (some j)

def center : Fin 3 → Old := ![.inl none,.inr (.inl (.inr false)),.inr (.inr false)]

lemma core_adj (i : Fin 3) (j : Fin 2) : base.Adj (endpoint j) (center i) := by
  fin_cases i <;> fin_cases j <;>
    simp [base,RootEdgeDeletion.graph,ConedShortSubdivision.twice,ConedShortSubdivision.once,
      RootedCone.graph,RootedCone.color,ShortSpider.template,ShortSpider.color,endpoint,center]

def coreEdge (i : Fin 3) (j : Fin 2) : base.edgeSet := ⟨s(endpoint j,center i),core_adj i j⟩

noncomputable def coreMap : (Fin 3 × Option (Fin 2)) ⊕ Fin 2 → RootedSubdivision.Vertex base
  | .inl (i,none) => RootedSubdivision.old base (center i)
  | .inl (i,some j) => RootedSubdivision.middle base (coreEdge i j)
  | .inr j => RootedSubdivision.old base (endpoint j)

lemma coreMap_injective : Function.Injective coreMap := by
  intro u v h
  have he := congrArg (RootedSubdivision.toVertex base) h
  clear h
  fin_cases u <;> fin_cases v <;>
    simp_all [coreMap,RootedSubdivision.toVertex_old,RootedSubdivision.toVertex_middle,
      coreEdge,endpoint,center,Subtype.mk.injEq,Sym2.eq_iff]

noncomputable def coreCopy : (ThetaFour.graph 3).Copy template where
  toHom :=
    { toFun := coreMap
      map_rel' := by
        intro u v h
        fin_cases u <;> fin_cases v <;>
          simp_all [ThetaFour.graph,FullRootedPower.graph,ThetaFour.template,
            template,RootedSubdivision.graph,SimpleGraph.comap_adj,coreMap,
            RootedSubdivision.toVertex_old,RootedSubdivision.toVertex_middle,
            ProjectionHeavy.subdivision,SixCycleCase.bipGraph,ProjectionHeavy.incidence,
            coreEdge,endpoint,center,Sym2.mem_iff] }
  injective' := coreMap_injective

/-- The theta core is abundant at the target degree scale. This does not yet
  pack full rooted copies of the decorated cyclic template. -/
theorem core_abundance (M : ℕ) (hM : 1≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃t : ℕ, ∃L : ℝ, 1≤L ∧ ∀{W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W), U.Nonempty →
      (g : W → Bool) → (∀{u v}, G.Adj u v → g u≠g v) →
      (graph M).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) →
      72*((t : ℝ)^2+2*t*Q)*U.card ≤ d^3 →
      d^12 ≤ 128*(U.card : ℝ)*(TreeCopiesIn.copies (ThetaFour.graph 3) G U).card := by
  classical
  obtain ⟨C,hC,hbound⟩ := supported (M+1) (by omega)
  obtain ⟨L,hL,hcount⟩ := LightFourFibers.theta_abundance (FullRootedPower.graph base (M+1))
    (by norm_num : (0 : ℝ)≤19/11) (by norm_num : (19/11 : ℝ)<2) hC hbound Q hQ
  refine ⟨Fintype.card ((Fin (M+1) × Option (Fin 2)) ⊕ ((Option (Fin 2) ⊕ Bool) ⊕ Bool))+
    Nat.card (FullRootedPower.graph base (M+1)).edgeSet,L,hL,?_⟩
  intro W _ _ G _ U hU g hg hf d hd hdeg hscale
  have hfree : (subdivision (FullRootedPower.graph base (M+1))).Free G := by
    intro h
    exact hf ((show graph M ⊑ subdivision (FullRootedPower.graph base (M+1)) from
      ⟨RootedSubdivision.powerCopy base M⟩).trans h)
  exact hcount G U hU g hg hfree d hd hdeg (by exact_mod_cast hscale)

end Erdos571.SlimConedSubdivision

/-! Greedy copy counts after attaching leaves to an arbitrary, possibly cyclic, graph. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LeafAttachments
open SimpleGraph Finset
variable {V : Type u}

def graph (H : SimpleGraph V) (w : V) : SimpleGraph (Option V) where
  Adj u v := match u,v with
    | none,none => False
    | none,some v => w=v
    | some u,none => u=w
    | some u,some v => H.Adj u v
  symm := by intro u v h; cases u <;> cases v <;> first | exact h.symm | exact h.elim
  loopless := by intro u; cases u <;> first | exact H.loopless _ | exact not_false

def oldIso (H : SimpleGraph V) (w : V) :
    (graph H w).induce ({none}ᶜ : Set (Option V)) ≃g H where
  toEquiv :=
    { toFun := fun x => x.val.get (Option.isSome_iff_ne_none.mpr x.property)
      invFun := fun x => ⟨some x,by simp⟩
      left_inv := by
        rintro ⟨x,hx⟩
        cases x with
        | none => exact (hx rfl).elim
        | some x => rfl
      right_inv := by intro x; rfl }
  map_rel_iff' := by
    rintro ⟨x,hx⟩ ⟨y,hy⟩
    cases x with
    | none => exact (hx rfl).elim
    | some x =>
      cases y with
      | none => exact (hy rfl).elim
      | some y => rfl

def copyEquiv {X : Type*} {H : SimpleGraph V} {K : SimpleGraph X} (e : H ≃g K)
    {W : Type*} (G : SimpleGraph W) : H.Copy G ≃ K.Copy G where
  toFun := fun f => f.comp e.symm.toCopy
  invFun := fun f => f.comp e.toCopy
  left_inv := by intro f; ext v; simp
  right_inv := by intro f; ext v; simp

lemma count_congr [Fintype V] {X : Type*} [Fintype X] {H : SimpleGraph V} {K : SimpleGraph X}
    (e : H ≃g K) {W : Type*} [Fintype W] (G : SimpleGraph W) :
    G.labelledCopyCount H=G.labelledCopyCount K := by
  classical
  exact Fintype.card_congr (copyEquiv e G)

lemma count_step [Fintype V] [DecidableEq V] {W : Type v} [Fintype W]
    (H : SimpleGraph V) (w : V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℕ) (hdeg : ∀x, D+Fintype.card V ≤ G.degree x) :
    D*G.labelledCopyCount H ≤ G.labelledCopyCount (graph H w) := by
  classical
  have hc : Fintype.card ({none}ᶜ : Set (Option V))=Fintype.card V := Fintype.card_congr (oldIso H w).toEquiv
  have he : G.labelledCopyCount ((graph H w).induce ({none}ᶜ : Set (Option V)))=G.labelledCopyCount H :=
    count_congr (oldIso H w) G
  have h := TreeCount.leaf_count_step (graph H w) G none (some w) (by rfl)
    (by intro x hx; cases x with | none => exact hx.elim | some x => exact congrArg some hx.symm)
    D (by intro x; simpa only [hc] using hdeg x)
  rwa [he] at h

/-- Each stage attaches a new path of length two to an old core vertex. -/
def Vertex (V : Type u) : ℕ → Type u
  | 0 => V
  | n+1 => Option (Option (Vertex V n))

instance instFintypeVertex [Fintype V] (n : ℕ) : Fintype (Vertex V n) := by
  induction n with
  | zero => exact ‹Fintype V›
  | succ n ih => exact inferInstanceAs (Fintype (Option (Option (Vertex V n))))

instance instDecidableEqVertex [DecidableEq V] (n : ℕ) : DecidableEq (Vertex V n) := by
  induction n with
  | zero => exact ‹DecidableEq V›
  | succ n ih => exact inferInstanceAs (DecidableEq (Option (Option (Vertex V n))))

def old : (n : ℕ) → V → Vertex V n
  | 0,v => v
  | n+1,v => some (some (old n v))

def tails (H : SimpleGraph V) (attach : ℕ → V) : (n : ℕ) → SimpleGraph (Vertex V n)
  | 0 => H
  | n+1 => graph (graph (tails H attach n) (old n (attach n))) none

lemma vertex_card [Fintype V] (n : ℕ) : Fintype.card (Vertex V n)=Fintype.card V+2*n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change Fintype.card (Option (Option (Vertex V n)))=_
    simp only [Fintype.card_option,ih]
    omega

lemma tails_count [Fintype V] [DecidableEq V] {W : Type v} [Fintype W]
    (H : SimpleGraph V) (attach : ℕ → V) (n : ℕ)
    (G : SimpleGraph W) [DecidableRel G.Adj] (D : ℕ)
    (hdeg : ∀x, D+Fintype.card V+2*n ≤ G.degree x) :
    D^(2*n)*G.labelledCopyCount H ≤ G.labelledCopyCount (tails H attach n) := by
  induction n with
  | zero => simpa only [Nat.mul_zero,pow_zero,one_mul] using le_refl (G.labelledCopyCount H)
  | succ n ih =>
    have hi := ih (fun x => by have h := hdeg x; omega)
    have h1 := count_step (tails H attach n) (old n (attach n)) G D (fun x => by
      rw [vertex_card]
      have h := hdeg x
      omega)
    have h2 := count_step (graph (tails H attach n) (old n (attach n))) none G D (fun x => by
      rw [Fintype.card_option,vertex_card]
      have h := hdeg x
      omega)
    calc
      _ = D*(D*(D^(2*n)*G.labelledCopyCount H)) := by rw [show 2*(n+1)=2*n+2 by omega,pow_add]; ring
      _ ≤ D*(D*G.labelledCopyCount (tails H attach n)) := Nat.mul_le_mul_left D (Nat.mul_le_mul_left D hi)
      _ ≤ D*G.labelledCopyCount (graph (tails H attach n) (old n (attach n))) := Nat.mul_le_mul_left D h1
      _ ≤ _ := h2

def inEquiv {V W : Type} [Fintype V] [Fintype W] (H : SimpleGraph V) (G : SimpleGraph W)
    (U : Finset W) : H.Copy (G.induce (U : Set W)) ≃ TreeCopiesIn.copies H G U where
  toFun := fun f => ⟨TreeCopiesIn.toAmbient H G U f,(TreeCopiesIn.mem_copies H G U _).mpr (fun v => (f v).property)⟩
  invFun := fun f =>
    { toHom :=
        { toFun := fun v => ⟨f.val v,(TreeCopiesIn.mem_copies H G U f.val).mp f.property v⟩
          map_rel' := fun h => f.val.toHom.map_adj h }
      injective' := by intro u v h; exact f.val.injective (congrArg Subtype.val h) }
  left_inv := by intro f; ext v; rfl
  right_inv := by intro f; apply Subtype.ext; ext v; rfl

lemma copies_card {V W : Type} [Fintype V] [Fintype W] (H : SimpleGraph V) (G : SimpleGraph W)
    (U : Finset W) : (TreeCopiesIn.copies H G U).card=(G.induce (U : Set W)).labelledCopyCount H := by
  classical
  letI : DecidableEq (U : Set W) := fun _ _ => Classical.propDecidable _
  calc
    _ = Fintype.card (H.Copy (G.induce (U : Set W))) := by
      simpa only [Fintype.card_coe] using (Fintype.card_congr (inEquiv H G U)).symm
    _ = _ := by
      unfold labelledCopyCount
      exact @Fintype.card_congr _ _ _ _ (Equiv.refl _)

lemma tails_lower {V W : Type} [Fintype V] [DecidableEq V] [Fintype W] [DecidableEq W]
    (H : SimpleGraph V) (attach : ℕ → V) (n : ℕ) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) {d : ℝ} (hd : 4*((Fintype.card V : ℝ)+2*n+1)≤d)
    (hdeg : ∀v∈U, d≤((DensityRegularization.neighbors G U v).card : ℝ)) :
    (d/4)^(2*n)*(TreeCopiesIn.copies H G U).card ≤ (TreeCopiesIn.copies (tails H attach n) G U).card := by
  classical
  have hd0 : 0≤d := by have h := Nat.cast_nonneg (Fintype.card V) (α := ℝ); have h' := Nat.cast_nonneg n (α := ℝ); linarith
  have hlo : (⌊d/2⌋₊ : ℝ)≤d/2 := Nat.floor_le (by linarith)
  have hhi := Nat.lt_floor_add_one (d/2)
  have hfloor : d/4≤(⌊d/2⌋₊ : ℝ) := by
    have h := Nat.cast_nonneg (Fintype.card V) (α := ℝ)
    have h' := Nat.cast_nonneg n (α := ℝ)
    linarith
  have hb := tails_count H attach n (G.induce (U : Set W)) ⌊d/2⌋₊ (fun v => by
    rw [TreeCopiesIn.induce_degree]
    have hh := hdeg v.val v.property
    have hx : (⌊d/2⌋₊ : ℝ)+Fintype.card V+2*n ≤ (DensityRegularization.neighbors G U v.val).card := by linarith
    exact_mod_cast hx)
  rw [← copies_card,← copies_card] at hb
  have hb' : (⌊d/2⌋₊ : ℝ)^(2*n)*(TreeCopiesIn.copies H G U).card ≤
      (TreeCopiesIn.copies (tails H attach n) G U).card := by exact_mod_cast hb
  exact (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hfloor _) (Nat.cast_nonneg _)).trans hb'

end Erdos571.LeafAttachments

/-! The slim template is exactly a theta core with five two-edge tails. -/
set_option maxHeartbeats 8000000
set_option maxRecDepth 4096
set_option synthInstance.maxSize 65536
namespace Erdos571.SlimConedSubdivision
open SimpleGraph Finset

abbrev CoreVertex := (Fin 3 × Option (Fin 2)) ⊕ Fin 2

def attach : ℕ → CoreVertex
  | 0 => .inl (0,none)
  | 1 => .inl (0,none)
  | 2 => .inl (0,none)
  | 3 => .inr 0
  | _ => .inr 1

def model := LeafAttachments.tails (ThetaFour.graph 3) attach 5

abbrev ModelVertex := LeafAttachments.Vertex CoreVertex 5

def tailRoot : Fin 5 → Old :=
  ![.inr (.inl (.inl none)),.inr (.inl (.inr true)),.inr (.inr true),
    .inr (.inl (.inl (some 0))),.inr (.inl (.inl (some 1)))]

def tailParent : Fin 5 → Old := ![center 0,center 0,center 0,endpoint 0,endpoint 1]

lemma tail_adj (i : Fin 5) : base.Adj (tailParent i) (tailRoot i) := by
  fin_cases i <;>
    simp [tailParent,tailRoot,center,endpoint,base,RootEdgeDeletion.graph,
      ConedShortSubdivision.twice,ConedShortSubdivision.once,RootedCone.graph,RootedCone.color,
      ShortSpider.template,ShortSpider.color]

def tailEdge (i : Fin 5) : base.edgeSet := ⟨s(tailParent i,tailRoot i),tail_adj i⟩

def edges : Fin 11 → base.edgeSet :=
  ![coreEdge 0 0,coreEdge 0 1,coreEdge 1 0,coreEdge 1 1,coreEdge 2 0,coreEdge 2 1,
    tailEdge 0,tailEdge 1,tailEdge 2,tailEdge 3,tailEdge 4]

lemma edges_injective : Function.Injective edges := by
  intro i j h
  have he := congrArg Subtype.val h
  clear h
  fin_cases i <;> fin_cases j <;>
    simp_all [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]

lemma edges_surjective : Function.Surjective edges := by
  rintro ⟨e,he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    change base.Adj u v at he
    fin_cases u <;> fin_cases v
    all_goals have hcheck := he
    all_goals simp [base,RootEdgeDeletion.graph,ConedShortSubdivision.twice,ConedShortSubdivision.once,
      RootedCone.graph,RootedCone.color,ShortSpider.template,ShortSpider.color] at hcheck
    all_goals first
      | solve | refine ⟨0,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨1,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨2,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨3,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨4,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨5,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨6,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨7,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨8,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨9,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]
      | solve | refine ⟨10,?_⟩; apply Subtype.ext; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint,Sym2.eq_iff]

lemma base_edge_card : Nat.card base.edgeSet=11 := by
  have h := Nat.card_congr (Equiv.ofBijective edges ⟨edges_injective,edges_surjective⟩)
  simpa using h.symm

lemma template_vertex_card : Nat.card (RootedSubdivision.Vertex base)=21 := by
  classical
  rw [Nat.card_congr (RootedSubdivision.vertexEquiv base),Nat.card_sum,base_edge_card]
  simp [Old,Nat.card_eq_fintype_card]

noncomputable def modelMap : ModelVertex → RootedSubdivision.Vertex base
  | none => RootedSubdivision.old base (tailRoot 4)
  | some (none) => RootedSubdivision.middle base (tailEdge 4)
  | some (some (none)) => RootedSubdivision.old base (tailRoot 3)
  | some (some (some (none))) => RootedSubdivision.middle base (tailEdge 3)
  | some (some (some (some (none)))) => RootedSubdivision.old base (tailRoot 2)
  | some (some (some (some (some (none))))) => RootedSubdivision.middle base (tailEdge 2)
  | some (some (some (some (some (some (none)))))) => RootedSubdivision.old base (tailRoot 1)
  | some (some (some (some (some (some (some (none))))))) => RootedSubdivision.middle base (tailEdge 1)
  | some (some (some (some (some (some (some (some (none)))))))) => RootedSubdivision.old base (tailRoot 0)
  | some (some (some (some (some (some (some (some (some (none))))))))) => RootedSubdivision.middle base (tailEdge 0)
  | some (some (some (some (some (some (some (some (some (some (v)))))))))) => coreMap v

def corePlainMap : CoreVertex → Old ⊕ base.edgeSet
  | .inl (i,none) => .inl (center i)
  | .inl (i,some j) => .inr (coreEdge i j)
  | .inr j => .inl (endpoint j)

def plainMap : ModelVertex → Old ⊕ base.edgeSet
  | none => .inl (tailRoot 4)
  | some (none) => .inr (tailEdge 4)
  | some (some (none)) => .inl (tailRoot 3)
  | some (some (some (none))) => .inr (tailEdge 3)
  | some (some (some (some (none)))) => .inl (tailRoot 2)
  | some (some (some (some (some (none))))) => .inr (tailEdge 2)
  | some (some (some (some (some (some (none)))))) => .inl (tailRoot 1)
  | some (some (some (some (some (some (some (none))))))) => .inr (tailEdge 1)
  | some (some (some (some (some (some (some (some (none)))))))) => .inl (tailRoot 0)
  | some (some (some (some (some (some (some (some (some (none))))))))) => .inr (tailEdge 0)
  | some (some (some (some (some (some (some (some (some (some (v)))))))))) => corePlainMap v

lemma toVertex_modelMap (v : ModelVertex) : RootedSubdivision.toVertex base (modelMap v)=plainMap v := by
  fin_cases v <;> simp [modelMap,plainMap,coreMap,corePlainMap,
    RootedSubdivision.toVertex_old,RootedSubdivision.toVertex_middle]

lemma plainMap_injective : Function.Injective plainMap := by decide

lemma modelMap_injective : Function.Injective modelMap := by
  intro u v h
  apply plainMap_injective
  simpa only [toVertex_modelMap] using congrArg (RootedSubdivision.toVertex base) h

lemma modelMap_bijective : Function.Bijective modelMap := by
  classical
  apply (Fintype.bijective_iff_injective_and_card modelMap).mpr
  refine ⟨modelMap_injective,?_⟩
  have h : Fintype.card ModelVertex=21 := by
    rw [LeafAttachments.vertex_card]
    simp [CoreVertex]
  have h' : Fintype.card (RootedSubdivision.Vertex base)=21 := by
    simpa only [Nat.card_eq_fintype_card] using template_vertex_card
  omega

local instance leafDecidable {V : Type} [DecidableEq V] (H : SimpleGraph V) [DecidableRel H.Adj] (w : V) :
    DecidableRel (LeafAttachments.graph H w).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [LeafAttachments.graph] <;> infer_instance

local instance powerDecidable {A R : Type} [DecidableEq A] [DecidableEq R]
    (H : SimpleGraph (A ⊕ R)) [DecidableRel H.Adj] (M : ℕ) : DecidableRel (FullRootedPower.graph H M).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [FullRootedPower.graph] <;> infer_instance

local instance thetaDecidable : DecidableRel (ThetaFour.graph 3).Adj := by
  unfold ThetaFour.graph
  infer_instance

local instance modelDecidable : DecidableRel model.Adj := by
  unfold model
  dsimp [LeafAttachments.tails]
  infer_instance

local instance subdivisionDecidable : DecidableRel (ProjectionHeavy.subdivision base).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [ProjectionHeavy.subdivision,SixCycleCase.bipGraph,ProjectionHeavy.incidence] <;> infer_instance

lemma plainMap_adj : ∀u v : ModelVertex, (ProjectionHeavy.subdivision base).Adj (plainMap u) (plainMap v) ↔ model.Adj u v := by
  decide

lemma modelMap_adj (u v : ModelVertex) : template.Adj (modelMap u) (modelMap v) ↔ model.Adj u v := by
  change (ProjectionHeavy.subdivision base).Adj (RootedSubdivision.toVertex base (modelMap u))
    (RootedSubdivision.toVertex base (modelMap v)) ↔ _
  rw [toVertex_modelMap,toVertex_modelMap]
  exact plainMap_adj u v

noncomputable def modelIso : model ≃g template where
  toEquiv := Equiv.ofBijective modelMap modelMap_bijective
  map_rel_iff' := fun {u v} => modelMap_adj u v

end Erdos571.SlimConedSubdivision

/-! The cyclic core and leaf-extension counts combine at the predicted density. -/
set_option synthInstance.maxSize 4096
namespace Erdos571.SlimConedSubdivision
attribute [local instance] Classical.propDecidable
open SimpleGraph Finset DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma model_copies_card (G : SimpleGraph W) (U : Finset W) :
    (TreeCopiesIn.copies model G U).card=(TreeCopiesIn.copies template G U).card := by
  rw [LeafAttachments.copies_card,LeafAttachments.copies_card]
  exact LeafAttachments.count_congr modelIso _

lemma tails_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {d : ℝ} (hd : 88≤d) (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ)) :
    (d/4)^10*(TreeCopiesIn.copies (ThetaFour.graph 3) G U).card ≤
      (TreeCopiesIn.copies template G U).card := by
  have h := LeafAttachments.tails_lower (ThetaFour.graph 3) attach 5 G U (d := d)
    (by norm_num; exact hd) hmin
  change (d/4)^10*(TreeCopiesIn.copies (ThetaFour.graph 3) G U).card ≤ (TreeCopiesIn.copies model G U).card at h
  rwa [model_copies_card] at h

lemma count_lower_from_core (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {d : ℝ} (hd : 88≤d) (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hcore : d^12 ≤ 128*(U.card : ℝ)*(TreeCopiesIn.copies (ThetaFour.graph 3) G U).card) :
    d^22 ≤ (128*4^10 : ℝ)*U.card*(TreeCopiesIn.copies template G U).card := by
  have hd0 : 0≤d := by linarith
  have ht := tails_lower G U hd hmin
  have h1 := mul_le_mul_of_nonneg_right hcore (pow_nonneg hd0 10)
  have h2 := mul_le_mul_of_nonneg_left ht (show (0 : ℝ)≤(128*4^10 : ℝ)*U.card by positivity)
  norm_num [div_pow] at h2
  nlinarith [h1,h2]

/-- An unconditional lower count for the full cyclic petal template in a
  subdivision-power-free almost-regular host. The remaining upper/packing
  estimate is not part of this theorem. -/
theorem copy_abundance (M : ℕ) (hM : 1≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃t : ℕ, ∃L : ℝ, 88≤L ∧ ∀{W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W), U.Nonempty →
      (g : W → Bool) → (∀{u v}, G.Adj u v → g u≠g v) →
      (graph M).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) →
      72*((t : ℝ)^2+2*t*Q)*U.card ≤ d^3 →
      d^22 ≤ (128*4^10 : ℝ)*U.card*(TreeCopiesIn.copies template G U).card := by
  obtain ⟨t,L,hL,hcore⟩ := core_abundance M hM Q hQ
  refine ⟨t,max 88 L,le_max_left _ _,?_⟩
  intro W _ _ G _ U hU g hg hf d hd hdeg hscale
  exact count_lower_from_core G U ((le_max_left _ _).trans hd) (fun v hv => (hdeg v hv).1)
    (hcore G U hU g hg hf d ((le_max_right _ _).trans hd) hdeg hscale)

end Erdos571.SlimConedSubdivision

/-! Exact vertex and root counts for the root-independent cyclic candidate. -/
namespace Erdos571.SlimConedSubdivision
open Finset SimpleGraph RootedSunflower

lemma all_petal (e : base.edgeSet) : ∃a : Option (Fin 2), Sum.inl a∈e.val := by
  obtain ⟨i,rfl⟩ := edges_surjective e
  fin_cases i
  all_goals first
    | solve | refine ⟨none,?_⟩; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint]
    | solve | refine ⟨some 0,?_⟩; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint]
    | solve | refine ⟨some 1,?_⟩; simp [edges,coreEdge,tailEdge,tailParent,tailRoot,center,endpoint]

def petalEquivAll : PetalEdge base ∅ ≃ base.edgeSet where
  toFun := Subtype.val
  invFun := fun e => ⟨e,by obtain ⟨a,ha⟩ := all_petal e; exact ⟨a,notMem_empty a,ha⟩⟩
  left_inv := by intro e; rfl
  right_inv := by intro e; rfl

instance rootEdge_isEmpty : IsEmpty (RootedSubdivision.RootEdge base) :=
  ⟨fun e => e.property (by obtain ⟨a,ha⟩ := all_petal e.val; exact ⟨a,notMem_empty a,ha⟩)⟩

lemma nonroot_card : Nat.card (RootedSubdivision.Nonroot base)=14 := by
  classical
  change Nat.card (Option (Fin 2) ⊕ PetalEdge base ∅)=14
  rw [Nat.card_sum,Nat.card_congr petalEquivAll,base_edge_card]
  norm_num [Nat.card_eq_fintype_card]

lemma root_card : Nat.card (RootedSubdivision.Root base)=7 := by
  classical
  change Nat.card (((Option (Fin 2) ⊕ Bool) ⊕ Bool) ⊕ RootedSubdivision.RootEdge base)=7
  rw [Nat.card_sum]
  simp [Nat.card_eq_fintype_card]

end Erdos571.SlimConedSubdivision

/-! Removing heavy-path exceptional vertices while retaining a high-degree induced host. -/
set_option maxHeartbeats 1000000
namespace Erdos571.DensityRegularization
open Finset SimpleGraph
variable {W : Type} [DecidableEq W]

/-- A small exceptional vertex set can be removed before low-degree peeling.
The resulting set retains a positive fraction of the original vertex count. -/
theorem retain_clean_core (G : SimpleGraph W) [DecidableRel G.Adj]
    (U C : Finset W) (hU : U.Nonempty) (hCU : C⊆U) {Q d : ℝ}
    (hQ : 1≤Q) (hd : 0<d)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d)
    (hsmall : 8*Q*((U\C).card : ℝ)≤U.card) :
    ∃T⊆C, T.Nonempty ∧ (U.card : ℝ)≤4*Q*T.card ∧
      ∀v∈T, d/4≤((neighbors G T v).card : ℝ) ∧ ((neighbors G T v).card : ℝ)≤Q*d := by
  have hQ0 : 0≤Q := by linarith
  have hn : 0<(U.card : ℝ) := by exact_mod_cast hU.card_pos
  have harcs : (U.card : ℝ)*d≤(arcs G U).card := by
    rw [arcs_sum,Nat.cast_sum]
    calc
      _ = ∑_v∈U, d := by simp
      _ ≤ _ := sum_le_sum (fun v hv => (hdeg v hv).1)
  have hmass : (∑v∈U\C, ((neighbors G U v).card : ℝ)) ≤ (U\C).card*(Q*d) := by
    calc
      _ ≤ ∑_v∈U\C, Q*d := sum_le_sum (fun v hv => (hdeg v (mem_sdiff.mp hv).1).2)
      _ = _ := by simp
  have hremove : ((arcs G U).card : ℝ)≤(arcs G C).card+2*∑v∈U\C, ((neighbors G U v).card : ℝ) := by
    have h := arcs_remove_bound G U (U\C) sdiff_subset
    rw [sdiff_sdiff_right_self,inf_eq_right.mpr hCU] at h
    exact_mod_cast h
  have hsmall' := mul_le_mul_of_nonneg_right hsmall hd.le
  have hret : 3*(U.card : ℝ)*d/4 ≤ (arcs G C).card := by nlinarith
  obtain ⟨T,hTC,hpot,hmin⟩ := exists_min_degree_subset G C (d/2)
  have hTU : T⊆U := hTC.trans hCU
  have hcard : (C.card : ℝ)≤U.card := by exact_mod_cast card_le_card hCU
  have hpen := mul_le_mul_of_nonneg_left hcard (show 0≤d/2 by positivity)
  have hpos : 0≤d/2*(T.card : ℝ) := by positivity
  have hmany : (U.card : ℝ)*d/4≤(arcs G T).card := by nlinarith
  have hT : T.Nonempty := by
    by_contra h
    have he := not_nonempty_iff_eq_empty.mp h
    simp [he,arcs] at hmany
    nlinarith
  have hmax (v : W) (hv : v∈T) : ((neighbors G T v).card : ℝ)≤Q*d :=
    (show ((neighbors G T v).card : ℝ)≤(neighbors G U v).card by
      exact_mod_cast card_le_card (neighbors_mono G hTU v)).trans (hdeg v (hTU hv)).2
  have hupper : ((arcs G T).card : ℝ)≤T.card*(Q*d) := by
    rw [arcs_sum,Nat.cast_sum]
    calc
      _ ≤ ∑_v∈T, Q*d := sum_le_sum hmax
      _ = _ := by simp
  refine ⟨T,hTC,hT,?_,fun v hv => ⟨by have h := hmin v hv; linarith,hmax v hv⟩⟩
  apply (mul_le_mul_iff_right₀ hd).mp
  nlinarith

end Erdos571.DensityRegularization

namespace Erdos571.HeavyPathMass
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

lemma bad_mono (G : SimpleGraph W) [DecidableRel G.Adj] {T U : Finset W}
    (hTU : T⊆U) (t : ℕ) {x y : W} (h : ShortSpider.Bad G T t x y) :
    ShortSpider.Bad G U t x y := by
  rcases h with h|h
  · exact Or.inl h
  · exact Or.inr (h.trans (card_le_card (common_mono G hTU x y)))

lemma badPairs_mono (G : SimpleGraph W) [DecidableRel G.Adj] {T U : Finset W}
    (hTU : T⊆U) (t : ℕ) (x : W) : ShortSpider.badPairs G T t x⊆ShortSpider.badPairs G U t x := by
  intro p hp
  obtain ⟨hp,hb⟩ := mem_filter.mp hp
  exact mem_filter.mpr ⟨mem_product.mpr
    ⟨neighbors_mono G hTU x (mem_product.mp hp).1,neighbors_mono G hTU x (mem_product.mp hp).2⟩,
    bad_mono G hTU t hb⟩

lemma forwardPairs_mono (G : SimpleGraph W) [DecidableRel G.Adj] {T U : Finset W}
    (hTU : T⊆U) (t : ℕ) (x : W) : forwardPairs G T t x⊆forwardPairs G U t x := by
  classical
  intro p hp
  obtain ⟨hp,h1,h2,hb⟩ := mem_filter.mp hp
  exact mem_filter.mpr ⟨mem_product.mpr ⟨hTU (mem_product.mp hp).1,hTU (mem_product.mp hp).2⟩,
    h1,h2,bad_mono G hTU t hb⟩

lemma localMass_mono (G : SimpleGraph W) [DecidableRel G.Adj] {T U : Finset W}
    (hTU : T⊆U) (t : ℕ) (x : W) : localMass G T t x≤localMass G U t x :=
  Nat.add_le_add (card_le_card (badPairs_mono G hTU t x)) (card_le_card (forwardPairs_mono G hTU t x))

end Erdos571.HeavyPathMass

namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph DensityRegularization HeavyPathMass ProjectionHeavy

/-- Subdivision-freeness permits an induced almost-regular core in which every
vertex, not merely almost every vertex, has small local heavy-path mass. -/
theorem exists_clean_core {V : Type} [Fintype V] (H : SimpleGraph V) {α C : ℝ}
    (hα0 : 0≤α) (hα2 : α<2) (hC : 0≤C) (hbound : EdgeBound H α C)
    (Q η : ℝ) (hQ : 1≤Q) (hη : 0<η) :
    ∃L : ℝ, 1≤L ∧ ∀{W : Type} [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj]
      (U : Finset W), U.Nonempty → (subdivision H).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) →
      ∃T⊆U, T.Nonempty ∧ (U.card : ℝ)≤4*Q*T.card ∧
        ∀v∈T, d/4≤((neighbors G T v).card : ℝ) ∧ ((neighbors G T v).card : ℝ)≤Q*d ∧
          (localMass G T (Fintype.card V+Nat.card H.edgeSet) v : ℝ)≤η*(d/4)^2 := by
  have hQ0 : 0<Q := by linarith
  obtain ⟨L,hL,hclean⟩ := clean_centers_large H hα0 hα2 hC hbound Q (1/(8*Q)) (η/16)
    hQ (by positivity) (by positivity)
  refine ⟨L,hL,?_⟩
  intro W _ G _ U hU hf d hd hdeg
  let t := Fintype.card V+Nat.card H.edgeSet
  let C' := cleanCenters G U t ((η/16)*d^2)
  have hCU : C'⊆U := filter_subset _ _
  have hsmall : 8*Q*((U\C').card : ℝ)≤U.card := by
    have h := hclean G U hf d hd (fun v hv => (hdeg v hv).2)
    have hh := mul_le_mul_of_nonneg_left h (show 0≤8*Q by positivity)
    change 8*Q*((U\C').card : ℝ)≤_ at hh
    convert hh using 1 <;> field_simp <;> ring
  obtain ⟨T,hTC,hT,hcard,hdegT⟩ := retain_clean_core G U C' hU hCU hQ (by linarith) hdeg hsmall
  refine ⟨T,hTC.trans hCU,hT,hcard,?_⟩
  intro v hv
  refine ⟨(hdegT v hv).1,(hdegT v hv).2,?_⟩
  have hm : (localMass G U t v : ℝ)≤(η/16)*d^2 := (mem_filter.mp (hTC hv)).2
  have hmono : (localMass G T t v : ℝ)≤localMass G U t v := by
    exact_mod_cast localMass_mono G (hTC.trans hCU) t v
  change (localMass G T t v : ℝ)≤_
  nlinarith

end Erdos571.HostHeavyShadow

/-! Uniform local cleaning controls rectangular codegree excess for every support set. -/
namespace Erdos571.HeavyPathMass
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

lemma middleMass_bound_of_local (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t : ℕ) {h : ℝ}
    (hlocal : ∀x∈S, (localMass G U t x : ℝ)≤h) :
    (middleMass G U S t : ℝ)≤S.card*h := by
  classical
  have hs (x : W) (hx : x∈S) : ((ShortSpider.badPairs G U t x).card : ℝ)≤h := by
    have hh : (ShortSpider.badPairs G U t x).card≤localMass G U t x := Nat.le_add_right _ _
    exact (show ((ShortSpider.badPairs G U t x).card : ℝ)≤localMass G U t x by exact_mod_cast hh).trans (hlocal x hx)
  simp only [middleMass,Nat.cast_sum]
  exact (sum_le_sum hs).trans_eq (by simp)

/-- The additive error from all large codegrees is at most a prescribed small
fraction of the full degree mass, uniformly for arbitrary support sets. -/
theorem cross_bound_of_local (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S Y : Finset W) (t : ℕ) (hSU : S⊆U) (hYU : Y⊆U) {ε d : ℝ}
    (hε : 0≤ε) (hd : 0≤d)
    (hlocal : ∀x∈S, (localMass G U t x : ℝ)≤ε^2*d^2) :
    ((BoundedCodegreeCross.edges G S Y).card : ℝ)≤
      S.card+Real.sqrt ((t : ℝ)*S.card)*Y.card+ε*S.card*d := by
  have hm := middleMass_bound_of_local G U S t hlocal
  have hmul := mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg S.card)
  have he : (S.card : ℝ)*(S.card*(ε^2*d^2))=(ε*S.card*d)^2 := by ring
  rw [he] at hmul
  have hh := Real.sqrt_le_sqrt hmul
  rw [Real.sqrt_sq (show 0≤ε*S.card*d by positivity)] at hh
  have hb := cross_bound G U S Y t hSU hYU
  linarith

/-- On a uniformly clean host, a dense rectangle has the same quadratic
support-size estimate as under a globally bounded codegree hypothesis. -/
theorem support_bound_of_local (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S Y : Finset W) (t : ℕ) (hSU : S⊆U) (hYU : Y⊆U) {d : ℝ}
    (hd : 8≤d)
    (hlocal : ∀x∈S, (localMass G U t x : ℝ)≤d^2/16)
    (hdense : (S.card : ℝ)*d/2≤(BoundedCodegreeCross.edges G S Y).card) :
    (S.card : ℝ)*d^2≤64*t*(Y.card : ℝ)^2 := by
  have hd0 : 0≤d := by linarith
  have hs0 := Nat.cast_nonneg S.card (α := ℝ)
  have hy0 := Nat.cast_nonneg Y.card (α := ℝ)
  have hb := cross_bound_of_local G U S Y t hSU hYU (ε := 1/4) (by norm_num) hd0
    (fun x hx => by have h := hlocal x hx; norm_num; linarith)
  have hs : 8*(S.card : ℝ)≤S.card*d := by nlinarith
  have he : (S.card : ℝ)*d≤8*(Real.sqrt ((t : ℝ)*S.card)*Y.card) := by linarith
  have hr0 : 0≤Real.sqrt ((t : ℝ)*S.card)*Y.card := by positivity
  have hsq := mul_self_le_mul_self (show 0≤(S.card : ℝ)*d by positivity) he
  have hr : (Real.sqrt ((t : ℝ)*S.card)*Y.card)^2=(t : ℝ)*S.card*(Y.card : ℝ)^2 := by
    rw [mul_pow,Real.sq_sqrt (by positivity)]
  by_cases hS : S.card=0
  · simp [hS]; positivity
  have hspos : 0<(S.card : ℝ) := by exact_mod_cast (Nat.pos_of_ne_zero hS)
  apply (mul_le_mul_iff_left₀ hspos).mp
  nlinarith [hsq,hr]

end Erdos571.HeavyPathMass

/-! Light two-edge extensions outside a finite forbidden vertex set. -/
set_option maxHeartbeats 1000000
namespace Erdos571.LightTailExtensions
open Finset SimpleGraph DensityRegularization HeavyPathMass
variable {W : Type} [DecidableEq W]

noncomputable def walks (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (v : W) : Finset (W×W) :=
  ((neighbors G U v)×ˢU).filter (fun p => G.Adj p.1 p.2)

lemma mem_walks (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (v y z : W) :
    (y,z)∈walks G U v ↔ y∈U ∧ z∈U ∧ G.Adj v y ∧ G.Adj y z := by
  simp only [walks,neighbors,mem_filter,mem_product]
  tauto

noncomputable def allowed (G : SimpleGraph W) [DecidableRel G.Adj]
    (U Z : Finset W) (t : ℕ) (v : W) : Finset (W×W) := by
  classical
  exact (walks G U v).filter (fun p => p.1∉Z ∧ p.2∉Z ∧ ¬ShortSpider.Bad G U t v p.2)

lemma mem_allowed (G : SimpleGraph W) [DecidableRel G.Adj]
    (U Z : Finset W) (t : ℕ) (v y z : W) :
    (y,z)∈allowed G U Z t v ↔
      y∈U ∧ z∈U ∧ G.Adj v y ∧ G.Adj y z ∧ y∉Z ∧ z∉Z ∧ ¬ShortSpider.Bad G U t v z := by
  classical
  simp only [allowed,mem_filter,mem_walks]
  tauto

lemma walk_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {d : ℝ} (hd : 0≤d) (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (v : W) (hv : v∈U) : d^2≤(walks G U v).card := by
  have hvd := hmin v hv
  have hsum : ((neighbors G U v).card : ℝ)*d≤(walks G U v).card := by
    unfold walks
    rw [rectangle_card,Nat.cast_sum]
    calc
      _ = ∑_y∈neighbors G U v, d := by simp
      _ ≤ _ := sum_le_sum (fun y hy => hmin y (mem_filter.mp hy).1)
  nlinarith [mul_le_mul_of_nonneg_right hvd hd]

lemma forbidden_first (G : SimpleGraph W) [DecidableRel G.Adj] (U Z : Finset W) (v : W)
    {D : ℝ} (hD : 0≤D) (hmax : ∀x∈U, ((neighbors G U x).card : ℝ)≤D) :
    (((walks G U v).filter (fun p => p.1∈Z)).card : ℝ)≤Z.card*D := by
  classical
  have hc : ((walks G U v).filter (fun p => p.1∈Z)).card≤
      (((U∩Z)×ˢU).filter (fun p => G.Adj p.1 p.2)).card := by
    apply card_le_card
    intro p hp
    obtain ⟨hp,hz⟩ := mem_filter.mp hp
    obtain ⟨hy,hu,hvy,hyu⟩ := (mem_walks G U v p.1 p.2).mp hp
    exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_inter.mpr ⟨hy,hz⟩,hu⟩,hyu⟩
  have hb : ((((U∩Z)×ˢU).filter (fun p => G.Adj p.1 p.2)).card : ℝ)≤(U∩Z).card*D := by
    rw [rectangle_card,Nat.cast_sum]
    exact (sum_le_sum (fun x hx => hmax x (mem_inter.mp hx).1)).trans_eq (by simp)
  have hcard : ((U∩Z).card : ℝ)≤Z.card := by exact_mod_cast card_le_card (inter_subset_right : U∩Z⊆Z)
  exact (show _≤((((U∩Z)×ˢU).filter (fun p => G.Adj p.1 p.2)).card : ℝ) by exact_mod_cast hc).trans
    (hb.trans (mul_le_mul_of_nonneg_right hcard hD))

lemma forbidden_last (G : SimpleGraph W) [DecidableRel G.Adj] (U Z : Finset W) (v : W)
    {D : ℝ} (hD : 0≤D) (hmax : ∀x∈U, ((neighbors G U x).card : ℝ)≤D) :
    (((walks G U v).filter (fun p => p.2∈Z)).card : ℝ)≤Z.card*D := by
  classical
  have hc : ((walks G U v).filter (fun p => p.2∈Z)).card≤
      (((U∩Z)×ˢU).filter (fun p => G.Adj p.1 p.2)).card := by
    apply card_le_card_of_injOn Prod.swap
    · intro p hp
      obtain ⟨hp,hz⟩ := mem_filter.mp hp
      obtain ⟨hy,hu,hvy,hyu⟩ := (mem_walks G U v p.1 p.2).mp hp
      exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_inter.mpr ⟨hu,hz⟩,hy⟩,hyu.symm⟩
    · exact fun _ _ _ _ h => Prod.swap_injective h
  have hb : ((((U∩Z)×ˢU).filter (fun p => G.Adj p.1 p.2)).card : ℝ)≤(U∩Z).card*D := by
    rw [rectangle_card,Nat.cast_sum]
    exact (sum_le_sum (fun x hx => hmax x (mem_inter.mp hx).1)).trans_eq (by simp)
  have hcard : ((U∩Z).card : ℝ)≤Z.card := by exact_mod_cast card_le_card (inter_subset_right : U∩Z⊆Z)
  exact (show _≤((((U∩Z)×ˢU).filter (fun p => G.Adj p.1 p.2)).card : ℝ) by exact_mod_cast hc).trans
    (hb.trans (mul_le_mul_of_nonneg_right hcard hD))

lemma allowed_lower_with_error (G : SimpleGraph W) [DecidableRel G.Adj]
    (U Z : Finset W) (t : ℕ) {d D : ℝ} (hd : 0≤d) (hD : 0≤D)
    (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤D) (v : W) (hv : v∈U) :
    d^2≤(allowed G U Z t v).card+2*Z.card*D+localMass G U t v := by
  classical
  have hsub : walks G U v⊆allowed G U Z t v ∪
      ((walks G U v).filter (fun p => p.1∈Z) ∪ (walks G U v).filter (fun p => p.2∈Z)) ∪
      forwardPairs G U t v := by
    intro p hp
    by_cases h1 : p.1∈Z
    · exact mem_union_left _ (mem_union_right _ (mem_union_left _ (mem_filter.mpr ⟨hp,h1⟩)))
    by_cases h2 : p.2∈Z
    · exact mem_union_left _ (mem_union_right _ (mem_union_right _ (mem_filter.mpr ⟨hp,h2⟩)))
    by_cases hb : ShortSpider.Bad G U t v p.2
    · obtain ⟨hy,hz,hvy,hyz⟩ := (mem_walks G U v p.1 p.2).mp hp
      exact mem_union_right _ (mem_filter.mpr ⟨mem_product.mpr ⟨hy,hz⟩,hvy,hyz,hb⟩)
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hp,h1,h2,hb⟩))
  have hc := (card_le_card hsub).trans ((card_union_le _ _).trans
    (Nat.add_le_add_right ((card_union_le _ _).trans (Nat.add_le_add_left (card_union_le _ _) _)) _))
  have hc' : ((walks G U v).card : ℝ)≤(allowed G U Z t v).card+
      (((walks G U v).filter (fun p => p.1∈Z)).card : ℝ)+
      (((walks G U v).filter (fun p => p.2∈Z)).card : ℝ)+(forwardPairs G U t v).card := by
    exact_mod_cast (by simpa only [← Nat.add_assoc] using hc)
  have h1 := forbidden_first G U Z v hD hmax
  have h2 := forbidden_last G U Z v hD hmax
  have hl := walk_lower G U hd hmin v hv
  have hm : ((forwardPairs G U t v).card : ℝ)≤localMass G U t v := by
    exact_mod_cast (Nat.le_add_left (forwardPairs G U t v).card (ShortSpider.badPairs G U t v).card)
  linarith

lemma allowed_lower (G : SimpleGraph W) [DecidableRel G.Adj]
    (U Z : Finset W) (t : ℕ) {Q d : ℝ} (hQ : 0≤Q) (hd : 0≤d)
    (hlarge : 8*Q*Z.card≤d)
    (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤Q*d) (v : W) (hv : v∈U)
    (hlocal : (localMass G U t v : ℝ)≤d^2/4) :
    d^2/2≤(allowed G U Z t v).card := by
  have h := allowed_lower_with_error G U Z t hd (mul_nonneg hQ hd) hmin hmax v hv
  have hh := mul_le_mul_of_nonneg_right hlarge hd
  nlinarith

end Erdos571.LightTailExtensions

/-! Injective copy extensions by light two-edge tails. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LightTailCopies
open Finset SimpleGraph DensityRegularization HeavyPathMass LightTailExtensions
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]

noncomputable def vertices {H : SimpleGraph V} {G : SimpleGraph W} (f : H.Copy G) : Finset W :=
  univ.image f

lemma vertices_card {H : SimpleGraph V} {G : SimpleGraph W} (f : H.Copy G) :
    (vertices f).card=Fintype.card V := by
  unfold vertices
  have hi : Function.Injective (fun v => f v) := f.injective
  rw [card_image_of_injective _ hi,card_univ]

def oldCopy (H : SimpleGraph V) (w : V) :
    H.Copy (LeafAttachments.graph (LeafAttachments.graph H w) none) where
  toHom := {toFun := fun v => some (some v),map_rel' := fun h => h}
  injective' := by intro a b h; exact Option.some.inj (Option.some.inj h)

def extendMap {H : SimpleGraph V} {G : SimpleGraph W} (f : H.Copy G) (y z : W) : Option (Option V) → W
  | none => z
  | some none => y
  | some (some v) => f v

noncomputable def extendCopy {H : SimpleGraph V} {G : SimpleGraph W} [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (f : H.Copy G) (p : W×W)
    (hp : p∈allowed G U (vertices f) t (f w)) :
    (LeafAttachments.graph (LeafAttachments.graph H w) none).Copy G where
  toHom :=
    { toFun := extendMap f p.1 p.2
      map_rel' := by
        obtain ⟨hy,hz,haw,hwz,hyout,hzout,hl⟩ := (mem_allowed G U (vertices f) t (f w) p.1 p.2).mp hp
        rintro (_|(_|a)) (_|(_|b)) h
        all_goals simp_all [LeafAttachments.graph,extendMap]
        all_goals first | exact hwz.symm | exact hwz | exact haw.symm | exact haw | exact f.toHom.map_adj h }
  injective' := by
    obtain ⟨hy,hz,haw,hwz,hyout,hzout,hl⟩ := (mem_allowed G U (vertices f) t (f w) p.1 p.2).mp hp
    have hfy (v : V) : f v≠p.1 := fun he => hyout (mem_image.mpr ⟨v,mem_univ _,he⟩)
    have hfz (v : V) : f v≠p.2 := fun he => hzout (mem_image.mpr ⟨v,mem_univ _,he⟩)
    have hyz := G.ne_of_adj hwz
    intro a b he
    change extendMap f p.1 p.2 a = extendMap f p.1 p.2 b at he
    rcases a with _|(_|a) <;> rcases b with _|(_|b)
    all_goals dsimp only [extendMap] at he
    all_goals first
      | rfl
      | exact (hyz he).elim
      | exact (hyz he.symm).elim
      | exact (hfy _ he).elim
      | exact (hfy _ he.symm).elim
      | exact (hfz _ he).elim
      | exact (hfz _ he.symm).elim
      | exact congrArg (fun v => some (some v)) (f.injective he)

@[simp] lemma extendCopy_apply {H : SimpleGraph V} {G : SimpleGraph W} [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (f : H.Copy G) (p : W×W)
    (hp : p∈allowed G U (vertices f) t (f w)) (v : Option (Option V)) :
    extendCopy w U t f p hp v=extendMap f p.1 p.2 v := rfl

noncomputable def Data (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) :=
  Σf : F, allowed G U (vertices f.val) t (f.val w)

noncomputable instance (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) : Fintype (Data H G w U t F) := by
  unfold Data
  infer_instance

noncomputable def dataCopy (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G))
    (p : Data H G w U t F) : (LeafAttachments.graph (LeafAttachments.graph H w) none).Copy G :=
  extendCopy w U t p.1.val p.2.val p.2.property

lemma dataCopy_injective (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) : Function.Injective (dataCopy H G w U t F) := by
  rintro ⟨f,p⟩ ⟨g,q⟩ he
  have hfg : f=g := by
    apply Subtype.ext
    apply Copy.ext
    intro v
    exact congrArg (fun c : (LeafAttachments.graph (LeafAttachments.graph H w) none).Copy G => c (some (some v))) he
  subst g
  have hpq : p=q := by
    apply Subtype.ext
    apply Prod.ext
    · exact congrArg (fun c : (LeafAttachments.graph (LeafAttachments.graph H w) none).Copy G => c (some none)) he
    · exact congrArg (fun c : (LeafAttachments.graph (LeafAttachments.graph H w) none).Copy G => c none) he
  subst q
  rfl

noncomputable def extensionFamily (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) :
    Finset ((LeafAttachments.graph (LeafAttachments.graph H w) none).Copy G) :=
  univ.map ⟨dataCopy H G w U t F,dataCopy_injective H G w U t F⟩

lemma extension_card (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) :
    (extensionFamily H G w U t F).card=∑f : F, (allowed G U (vertices f.val) t (f.val w)).card := by
  simp [extensionFamily,Data,Fintype.card_sigma]

lemma extension_mem (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) :
    ∀f∈extensionFamily H G w U t F, ∀v, f v∈U := by
  intro f hf v
  obtain ⟨p,hp,rfl⟩ := mem_map.mp hf
  obtain ⟨hy,hz,ha,hb,hout,hout',hl⟩ := (mem_allowed G U (vertices p.1.val) t (p.1.val w) p.2.val.1 p.2.val.2).mp p.2.property
  rcases v with _|(_|v)
  · exact hz
  · exact hy
  · exact hmem p.1.val p.1.property v

lemma extension_lower (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (w : V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) {Q d : ℝ} (hQ : 0≤Q) (hd : 0≤d)
    (hlarge : 8*Q*Fintype.card V≤d)
    (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤Q*d)
    (hlocal : ∀v∈U, (localMass G U t v : ℝ)≤d^2/4) :
    (d^2/2)*F.card≤(extensionFamily H G w U t F).card := by
  rw [extension_card,Nat.cast_sum]
  calc
    _ = ∑_f : F, d^2/2 := by simp; ring
    _ ≤ _ := sum_le_sum (fun f hf => allowed_lower G U (vertices f.val) t hQ hd
      (by rwa [vertices_card]) hmin hmax (f.val w) (hmem f.val f.property w) (hlocal _ (hmem f.val f.property w)))

end Erdos571.LightTailCopies

/-! Iteration preserves lightness of every newly attached two-edge tail. -/
set_option maxHeartbeats 1500000
namespace Erdos571.LightTailCopies
open Finset SimpleGraph DensityRegularization HeavyPathMass LightTailExtensions
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]

noncomputable def family (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (attach : ℕ → V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) :
    (n : ℕ) → Finset ((LeafAttachments.tails H attach n).Copy G)
  | 0 => F
  | n+1 => extensionFamily (LeafAttachments.tails H attach n) G
      (LeafAttachments.old n (attach n)) U t (family H G attach U t F n)

def coreCopy (H : SimpleGraph V) (attach : ℕ → V) :
    (n : ℕ) → H.Copy (LeafAttachments.tails H attach n)
  | 0 => Copy.id H
  | n+1 => (oldCopy (LeafAttachments.tails H attach n) (LeafAttachments.old n (attach n))).comp (coreCopy H attach n)

@[simp] lemma coreCopy_apply (H : SimpleGraph V) (attach : ℕ → V) (n : ℕ) (v : V) :
    coreCopy H attach n v=LeafAttachments.old n v := by
  induction n with
  | zero => rfl
  | succ n ih => change some (some (coreCopy H attach n v))=some (some (LeafAttachments.old n v)); rw [ih]

def TailLight (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (attach : ℕ → V) (U : Finset W) (t : ℕ) :
    (n : ℕ) → (LeafAttachments.tails H attach n).Copy G → Prop
  | 0,_ => True
  | n+1,f => TailLight H G attach U t n
      (f.comp (oldCopy (LeafAttachments.tails H attach n) (LeafAttachments.old n (attach n)))) ∧
      ¬ShortSpider.Bad G U t (f (some (some (LeafAttachments.old n (attach n))))) (f none)

lemma family_mem (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (attach : ℕ → V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (n : ℕ) :
    ∀f∈family H G attach U t F n, ∀v, f v∈U := by
  induction n with
  | zero => exact hmem
  | succ n ih => exact extension_mem _ G _ U t _ ih

lemma family_restrict (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (attach : ℕ → V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) (n : ℕ) :
    ∀f∈family H G attach U t F n, f.comp (coreCopy H attach n)∈F := by
  induction n with
  | zero => intro f hf; exact hf
  | succ n ih =>
    intro f hf
    obtain ⟨p,hp,rfl⟩ := mem_map.mp hf
    convert ih p.1.val p.1.property using 1

lemma family_light (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (attach : ℕ → V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G)) (n : ℕ) :
    ∀f∈family H G attach U t F n, TailLight H G attach U t n f := by
  induction n with
  | zero => intro f hf; trivial
  | succ n ih =>
    intro f hf
    obtain ⟨p,hp,rfl⟩ := mem_map.mp hf
    change TailLight H G attach U t n p.1.val ∧ _
    refine ⟨ih p.1.val p.1.property,?_⟩
    exact ((mem_allowed G U (vertices p.1.val) t (p.1.val (LeafAttachments.old n (attach n)))
      p.2.val.1 p.2.val.2).mp p.2.property).2.2.2.2.2.2

/-- Each step has at least `d²/2` light extensions. Only the endpoint pair of
each new tail is asserted light; cross-arm two-paths are not covered. -/
lemma family_lower (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (attach : ℕ → V) (U : Finset W) (t : ℕ) (F : Finset (H.Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (n : ℕ) {Q d : ℝ} (hQ : 0≤Q) (hd : 0≤d)
    (hlarge : 8*Q*((Fintype.card V : ℝ)+2*n)≤d)
    (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤Q*d)
    (hlocal : ∀v∈U, (localMass G U t v : ℝ)≤d^2/4) :
    (d^2/2)^n*F.card≤(family H G attach U t F n).card := by
  induction n with
  | zero => simp [family]
  | succ n ih =>
    have hsmall : 8*Q*((Fintype.card V : ℝ)+2*n)≤d := by
      push_cast at hlarge
      nlinarith
    have hi := ih hsmall
    have hs := extension_lower (LeafAttachments.tails H attach n) G
      (LeafAttachments.old n (attach n)) U t (family H G attach U t F n)
      (family_mem H G attach U t F hmem n) hQ hd
      (by rw [LeafAttachments.vertex_card]; push_cast; exact hsmall) hmin hmax hlocal
    calc
      _ = (d^2/2)*((d^2/2)^n*F.card) := by rw [pow_succ]; ring
      _ ≤ (d^2/2)*(family H G attach U t F n).card := mul_le_mul_of_nonneg_left hi (by positivity)
      _ ≤ _ := hs

end Erdos571.LightTailCopies

set_option maxHeartbeats 3000000
set_option synthInstance.maxSize 4096
/-! Retaining the pathwise lightness in the cyclic-core counting construction. -/
namespace Erdos571.LightFourFibers
open SimpleGraph Finset DensityRegularization
variable {W : Type} [DecidableEq W]

def CoreLight (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : (ThetaFour.graph 3).Copy G) : Prop :=
  ∀i : Fin 3, ∀j : Fin 2, ¬ShortSpider.Bad G U t (f (.inr j)) (f (.inl (i,none)))

lemma copy_coreLight (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (p : Data W) (hp : p∈data G U t) :
    CoreLight G U t (copy G U t g hg p hp) := by
  intro i j
  have hh := mem_fiber.mp (paths_mem G U t p hp i)
  fin_cases j
  · exact hh.2.2.2.2.2.2.2.2.2.1
  · exact fun h => hh.2.2.2.2.2.2.2.2.2.2.2 ((ShortSpider.bad_symm G U t).mpr h)

noncomputable def thetaFamily (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) : Finset ((ThetaFour.graph 3).Copy G) :=
  univ.map ⟨fun p : data G U t => copy G U t g hg p.val p.property,copy_injective G U t g hg⟩

lemma thetaFamily_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    (thetaFamily G U t g hg).card=totalTriples G U t := by
  simp only [thetaFamily,card_map,card_univ,Fintype.card_coe,data_card]

lemma thetaFamily_mem (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    ∀f∈thetaFamily G U t g hg, (∀v, f v∈U) ∧ CoreLight G U t f := by
  intro f hf
  obtain ⟨p,hp,rfl⟩ := mem_map.mp hf
  exact ⟨copy_mem G U t g hg p.val p.property,copy_coreLight G U t g hg p.val p.property⟩

lemma thetaFamily_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (hU : U.Nonempty) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 1≤d)
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤Q*d)
    (hopen : (U.card : ℝ)*d^4/2≤(openFour G U t).card)
    (hscale : 72*((t : ℝ)^2+2*t*Q)*U.card≤d^3) :
    d^12≤128*(U.card : ℝ)*(thetaFamily G U t g hg).card := by
  rw [thetaFamily_card]
  exact triple_lower G U hU t hQ hd hmax hopen hscale

end Erdos571.LightFourFibers

namespace Erdos571.SlimConedSubdivision
attribute [local irreducible] LightTailCopies.family
open SimpleGraph Finset DensityRegularization HeavyPathMass LightFourFibers
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def lightModelFamily (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) : Finset (model.Copy G) :=
  LightTailCopies.family (ThetaFour.graph 3) G attach U t (thetaFamily G U t g hg) 5

lemma lightModelFamily_mem (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    ∀f∈lightModelFamily G U t g hg, (∀v, f v∈U) ∧
      CoreLight G U t (f.comp (LightTailCopies.coreCopy (ThetaFour.graph 3) attach 5)) ∧
      LightTailCopies.TailLight (ThetaFour.graph 3) G attach U t 5 f := by
  intro f hf
  refine ⟨LightTailCopies.family_mem (ThetaFour.graph 3) G attach U t (thetaFamily G U t g hg) (fun f hf => (thetaFamily_mem G U t g hg f hf).1) 5 f hf,?_,
    LightTailCopies.family_light (ThetaFour.graph 3) G attach U t (thetaFamily G U t g hg) 5 f hf⟩
  exact (thetaFamily_mem G U t g hg _ (LightTailCopies.family_restrict (ThetaFour.graph 3) G attach U t (thetaFamily G U t g hg) 5 f hf)).2

lemma lightModelFamily_lower (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 0≤Q) (hd : 0≤d) (hlarge : 168*Q≤d)
    (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤Q*d)
    (hlocal : ∀v∈U, (localMass G U t v : ℝ)≤d^2/4)
    (hcore : d^12≤128*(U.card : ℝ)*(thetaFamily G U t g hg).card) :
    d^22≤4096*(U.card : ℝ)*(lightModelFamily G U t g hg).card := by
  have ht := LightTailCopies.family_lower (ThetaFour.graph 3) G attach U t (thetaFamily G U t g hg)
    (fun f hf => (thetaFamily_mem G U t g hg f hf).1) 5 hQ hd (by norm_num; nlinarith [hlarge]) hmin hmax hlocal
  change (d^2/2)^5*(thetaFamily G U t g hg).card≤(lightModelFamily G U t g hg).card at ht
  have h1 := mul_le_mul_of_nonneg_right hcore (pow_nonneg hd 10)
  have h2 := mul_le_mul_of_nonneg_left ht (show (0 : ℝ)≤4096*U.card by positivity)
  norm_num [div_pow,← pow_mul] at h2
  nlinarith [h1,h2]

end Erdos571.SlimConedSubdivision

/-! Every original edge of the slim base has a light endpoint pair in the constructed subdivision copies. -/
set_option maxHeartbeats 3000000
set_option maxRecDepth 4096
set_option synthInstance.maxSize 4096
namespace Erdos571.SlimConedSubdivision
open SimpleGraph Finset DensityRegularization HeavyPathMass LightFourFibers
variable {W : Type} [Fintype W] [DecidableEq W]

def tailTip : Fin 5 → ModelVertex :=
  ![some (some (some (some (some (some (some (some none))))))),
    some (some (some (some (some (some none))))),some (some (some (some none))),some (some none),none]

def oldModel : Old → ModelVertex
  | .inl none => LeafAttachments.old 5 (.inl (0,none))
  | .inl (some j) => LeafAttachments.old 5 (.inr j)
  | .inr (.inl (.inl none)) => tailTip 0
  | .inr (.inl (.inl (some j))) => if j=0 then tailTip 3 else tailTip 4
  | .inr (.inl (.inr false)) => LeafAttachments.old 5 (.inl (1,none))
  | .inr (.inl (.inr true)) => tailTip 1
  | .inr (.inr false) => LeafAttachments.old 5 (.inl (2,none))
  | .inr (.inr true) => tailTip 2

lemma modelMap_oldModel (v : Old) : modelMap (oldModel v)=RootedSubdivision.old base v := by
  fin_cases v <;> rfl

lemma core_light_oldModel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : model.Copy G)
    (hc : CoreLight G U t (f.comp (LightTailCopies.coreCopy (ThetaFour.graph 3) attach 5)))
    (i : Fin 3) (j : Fin 2) : ¬ShortSpider.Bad G U t (f (oldModel (endpoint j))) (f (oldModel (center i))) := by
  have h := hc i j
  fin_cases i <;> exact h

lemma tails_light_oldModel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : model.Copy G) (ht : LightTailCopies.TailLight (ThetaFour.graph 3) G attach U t 5 f)
    (i : Fin 5) : ¬ShortSpider.Bad G U t (f (oldModel (tailParent i))) (f (oldModel (tailRoot i))) := by
  fin_cases i
  · exact ht.1.1.1.1.2
  · exact ht.1.1.1.2
  · exact ht.1.1.2
  · exact ht.1.2
  · exact ht.2

lemma model_edgeLight (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : model.Copy G)
    (hc : CoreLight G U t (f.comp (LightTailCopies.coreCopy (ThetaFour.graph 3) attach 5)))
    (ht : LightTailCopies.TailLight (ThetaFour.graph 3) G attach U t 5 f) :
    ∀u v : Old, base.Adj u v → ¬ShortSpider.Bad G U t (f (oldModel u)) (f (oldModel v)) := by
  have hc' := core_light_oldModel G U t f hc
  have ht' := tails_light_oldModel G U t f ht
  intro u v huv
  obtain ⟨i,he⟩ := edges_surjective ⟨s(u,v),huv⟩
  have hs := congrArg Subtype.val he
  clear he
  fin_cases i
  all_goals simp only [edges,coreEdge,tailEdge,Matrix.cons_val_zero,Matrix.cons_val_succ,Matrix.head_cons,Sym2.eq_iff] at hs
  all_goals replace hs := Sym2.eq_iff.mp hs
  all_goals rcases hs with ⟨rfl,rfl⟩|⟨rfl,rfl⟩
  all_goals first
    | exact hc' _ _
    | exact ht' _
    | exact fun h => hc' _ _ ((ShortSpider.bad_symm G U t).mpr h)
    | exact fun h => ht' _ ((ShortSpider.bad_symm G U t).mpr h)

def EdgeLight (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : template.Copy G) : Prop :=
  ∀u v : Old, base.Adj u v →
    ¬ShortSpider.Bad G U t (f (RootedSubdivision.old base u)) (f (RootedSubdivision.old base v))

noncomputable def asTemplate (G : SimpleGraph W) (f : model.Copy G) : template.Copy G :=
  f.comp modelIso.symm.toCopy

lemma asTemplate_old (G : SimpleGraph W) (f : model.Copy G) (v : Old) :
    asTemplate G f (RootedSubdivision.old base v)=f (oldModel v) := by
  have h : modelIso (oldModel v)=RootedSubdivision.old base v := modelMap_oldModel v
  rw [← h]
  simp [asTemplate]

lemma asTemplate_injective (G : SimpleGraph W) : Function.Injective (asTemplate G) := by
  intro f g he
  apply Copy.ext
  intro v
  have h := congrArg (fun c : template.Copy G => c (modelIso v)) he
  simpa [asTemplate] using h

lemma asTemplate_edgeLight (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : model.Copy G)
    (hc : CoreLight G U t (f.comp (LightTailCopies.coreCopy (ThetaFour.graph 3) attach 5)))
    (ht : LightTailCopies.TailLight (ThetaFour.graph 3) G attach U t 5 f) :
    EdgeLight G U t (asTemplate G f) := by
  intro u v huv
  rw [asTemplate_old,asTemplate_old]
  exact model_edgeLight G U t f hc ht u v huv

end Erdos571.SlimConedSubdivision

/-! Edge-light subdivision copies are abundant in uniformly cleaned hosts. -/
set_option maxHeartbeats 3000000
set_option synthInstance.maxSize 4096
namespace Erdos571.SlimConedSubdivision
open SimpleGraph Finset DensityRegularization HeavyPathMass LightFourFibers ProjectionHeavy
attribute [local instance] Classical.propDecidable
attribute [local irreducible] LightTailCopies.family lightModelFamily
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def edgeLightCopies (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ) :
    Finset (template.Copy G) :=
  (TreeCopiesIn.copies template G U).filter (EdgeLight G U t)

lemma lightModelFamily_le_edgeLightCopies (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) :
    (lightModelFamily G U t g hg).card≤(edgeLightCopies G U t).card := by
  apply card_le_card_of_injOn (asTemplate G)
  · intro f hf
    have h := lightModelFamily_mem G U t g hg f hf
    refine mem_filter.mpr ⟨(TreeCopiesIn.mem_copies template G U _).mpr ?_,asTemplate_edgeLight G U t f h.2.1 h.2.2⟩
    intro v
    exact h.1 (modelIso.symm v)
  · intro f hf g hg he
    exact asTemplate_injective G he

lemma edgeLightCopies_lower (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 0≤Q) (hd : 0≤d) (hlarge : 168*Q≤d)
    (hmin : ∀v∈U, d≤((neighbors G U v).card : ℝ))
    (hmax : ∀v∈U, ((neighbors G U v).card : ℝ)≤Q*d)
    (hlocal : ∀v∈U, (localMass G U t v : ℝ)≤d^2/4)
    (hcore : d^12≤128*(U.card : ℝ)*(thetaFamily G U t g hg).card) :
    d^22≤4096*(U.card : ℝ)*(edgeLightCopies G U t).card := by
  exact (lightModelFamily_lower G U t g hg hQ hd hlarge hmin hmax hlocal hcore).trans
    (mul_le_mul_of_nonneg_left (show ((lightModelFamily G U t g hg).card : ℝ)≤(edgeLightCopies G U t).card by
      exact_mod_cast lightModelFamily_le_edgeLightCopies G U t g hg) (by positivity))

noncomputable def heavyThreshold (M : ℕ) : ℕ :=
  Fintype.card ((Fin (M+1) × Option (Fin 2)) ⊕ ((Option (Fin 2) ⊕ Bool) ⊕ Bool))+
    Nat.card (FullRootedPower.graph base (M+1)).edgeSet

/-- The lightness here concerns the eleven original base edges only. It does
not assert lightness of all two-edge paths in the subdivision template. -/
theorem edge_light_abundance (M : ℕ) (hM : 1≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃L : ℝ, 1≤L ∧ 168*Q≤L ∧ ∀{W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W), U.Nonempty →
      (g : W → Bool) → (∀{u v}, G.Adj u v → g u≠g v) →
      (graph M).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) →
      (∀v∈U, (localMass G U (heavyThreshold M) v : ℝ)≤d^2/4) →
      72*((heavyThreshold M : ℝ)^2+2*(heavyThreshold M)*Q)*U.card≤d^3 →
      d^22≤4096*(U.card : ℝ)*(edgeLightCopies G U (heavyThreshold M)).card := by
  obtain ⟨C,hC,hbound⟩ := supported (M+1) (by omega)
  obtain ⟨L,hL,hopen⟩ := open_abundance (FullRootedPower.graph base (M+1))
    (by norm_num : (0 : ℝ)≤19/11) (by norm_num : (19/11 : ℝ)<2) hC hbound Q hQ
  refine ⟨max L (168*Q),hL.trans (le_max_left _ _),le_max_right _ _,?_⟩
  intro W _ _ G _ U hU g hg hf d hd hdeg hlocal hscale
  have hd1 : 1≤d := hL.trans ((le_max_left _ _).trans hd)
  have hfree : (subdivision (FullRootedPower.graph base (M+1))).Free G := by
    intro h
    exact hf ((show graph M ⊑ subdivision (FullRootedPower.graph base (M+1)) from
      ⟨RootedSubdivision.powerCopy base M⟩).trans h)
  have ho : (U.card : ℝ)*d^4/2≤(openFour G U (heavyThreshold M)).card :=
    hopen G U hfree d ((le_max_left _ _).trans hd) hdeg
  have hcore := thetaFamily_lower G U hU (heavyThreshold M) g hg hQ hd1
    (fun v hv => (hdeg v hv).2) ho hscale
  exact edgeLightCopies_lower G U (heavyThreshold M) g hg (by linarith) (by linarith)
    ((le_max_right _ _).trans hd) (fun v hv => (hdeg v hv).1) (fun v hv => (hdeg v hv).2) hlocal hcore

/-- An unconditional induced-core abundance statement for the cyclic candidate.
The sharp upper bound still requires a packing estimate for these edge-light copies. -/
theorem clean_edge_light_abundance (M : ℕ) (hM : 1≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃L : ℝ, 1≤L ∧ ∀{W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W), U.Nonempty →
      (g : W → Bool) → (∀{u v}, G.Adj u v → g u≠g v) →
      (graph M).Free G → ∀d : ℝ, L≤d →
      (∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) →
      4608*((heavyThreshold M : ℝ)^2+8*(heavyThreshold M)*Q)*U.card≤d^3 →
      ∃T⊆U, T.Nonempty ∧ (U.card : ℝ)≤4*Q*T.card ∧
        (∀v∈T, d/4≤((neighbors G T v).card : ℝ) ∧ ((neighbors G T v).card : ℝ)≤Q*d ∧
          (localMass G T (heavyThreshold M) v : ℝ)≤(d/4)^2/4) ∧
        (d/4)^22≤4096*(T.card : ℝ)*(edgeLightCopies G T (heavyThreshold M)).card := by
  obtain ⟨C,hC,hbound⟩ := supported (M+1) (by omega)
  obtain ⟨L₀,hL₀,hclean⟩ := HostHeavyShadow.exists_clean_core (FullRootedPower.graph base (M+1))
    (by norm_num : (0 : ℝ)≤19/11) (by norm_num : (19/11 : ℝ)<2) hC hbound Q (1/4) hQ (by norm_num)
  obtain ⟨L₁,hL₁,hLlarge,hcount⟩ := edge_light_abundance M hM (4*Q) (by linarith)
  refine ⟨max L₀ (4*L₁),hL₀.trans (le_max_left _ _),?_⟩
  intro W _ _ G _ U hU g hg hf d hd hdeg hscale
  have hfree : (subdivision (FullRootedPower.graph base (M+1))).Free G := by
    intro h
    exact hf ((show graph M ⊑ subdivision (FullRootedPower.graph base (M+1)) from
      ⟨RootedSubdivision.powerCopy base M⟩).trans h)
  obtain ⟨T,hTU,hT,hcard,hdegT⟩ := hclean G U hU hfree d ((le_max_left _ _).trans hd) hdeg
  have hdT : L₁≤d/4 := by have h := (le_max_right _ _).trans hd; linarith
  have hmax : ∀v∈T, ((neighbors G T v).card : ℝ)≤(4*Q)*(d/4) := by
    intro v hv
    have h := (hdegT v hv).2.1
    nlinarith
  have hlocal : ∀v∈T, (localMass G T (heavyThreshold M) v : ℝ)≤(d/4)^2/4 := by
    intro v hv
    have h := (hdegT v hv).2.2
    change (localMass G T (heavyThreshold M) v : ℝ)≤(1/4)*(d/4)^2 at h
    linarith
  have hscaleT : 72*((heavyThreshold M : ℝ)^2+2*(heavyThreshold M)*(4*Q))*T.card≤(d/4)^3 := by
    have hc : (T.card : ℝ)≤U.card := by exact_mod_cast card_le_card hTU
    have hh := mul_le_mul_of_nonneg_left hc
      (show (0 : ℝ)≤4608*((heavyThreshold M : ℝ)^2+8*(heavyThreshold M)*Q) by positivity)
    norm_num [div_pow]
    nlinarith [hh,hscale]
  exact ⟨T,hTU,hT,hcard,fun v hv => ⟨(hdegT v hv).1,(hdegT v hv).2.1,hlocal v hv⟩,
    hcount G T hT g hg hf (d/4) hdT (fun v hv => ⟨(hdegT v hv).1,hmax v hv⟩) hlocal hscaleT⟩

end Erdos571.SlimConedSubdivision

/-! The only multiplicity after fixing all old vertices is the choice of subdivision middles. -/
set_option maxHeartbeats 2000000
set_option synthInstance.maxSize 4096
namespace Erdos571.RootedSubdivision
open SimpleGraph Finset DensityRegularization FourthMoment
variable {A R W : Type} [Fintype A] [Fintype R] [DecidableEq W]

lemma old_or_middle (H : SimpleGraph (A ⊕ R)) (v : Vertex H) :
    (∃u, v=old H u) ∨ ∃e, v=middle H e := by
  rcases v with (a|e)|(r|e)
  · exact Or.inl ⟨.inl a,rfl⟩
  · exact Or.inr ⟨e.val,(middle_petal H e).symm⟩
  · exact Or.inl ⟨.inr r,rfl⟩
  · exact Or.inr ⟨e.val,(middle_root H e).symm⟩

lemma copy_ext_old_middle (H : SimpleGraph (A ⊕ R)) {G : SimpleGraph W}
    {f g : (graph H).Copy G} (hold : ∀u, f (old H u)=g (old H u))
    (hmid : ∀e, f (middle H e)=g (middle H e)) : f=g := by
  apply Copy.ext
  intro v
  rcases old_or_middle H v with ⟨u,rfl⟩|⟨e,rfl⟩
  · exact hold u
  · exact hmid e

lemma exists_pair {V : Type*} (e : Sym2 V) : ∃u v, e=s(u,v) := by
  induction e using Sym2.inductionOn with
  | hf u v => exact ⟨u,v,rfl⟩

noncomputable def ends {V : Type*} {H : SimpleGraph V} (e : H.edgeSet) : V×V :=
  ⟨(exists_pair e.val).choose,(exists_pair e.val).choose_spec.choose⟩

lemma ends_spec {V : Type*} {H : SimpleGraph V} (e : H.edgeSet) : e.val=s((ends e).1,(ends e).2) :=
  (exists_pair e.val).choose_spec.choose_spec

lemma ends_adj {V : Type*} {H : SimpleGraph V} (e : H.edgeSet) : H.Adj (ends e).1 (ends e).2 := by
  have h := e.property
  rw [ends_spec e] at h
  exact h

lemma ends_mem_left {V : Type*} {H : SimpleGraph V} (e : H.edgeSet) : (ends e).1∈e.val := by
  rw [ends_spec]
  exact Sym2.mem_mk_left (ends e).1 (ends e).2

lemma ends_mem_right {V : Type*} {H : SimpleGraph V} (e : H.edgeSet) : (ends e).2∈e.val := by
  rw [ends_spec]
  exact Sym2.mem_mk_right (ends e).1 (ends e).2

/-- Fixing the images of all old vertices leaves at most `t^|E(H)|` edge-light
subdivision copies. This does not fix only the roots: old nonroots are also pinned. -/
lemma fixed_old_count (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (F : Finset ((graph H).Copy G)) (r : A ⊕ R → W)
    (hmem : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ∀u v, H.Adj u v → (common G U (f (old H u)) (f (old H v))).card<t)
    (hpin : ∀f∈F, ∀u, f (old H u)=r u) : F.card≤t^Nat.card H.edgeSet := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]
    omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C (e : H.edgeSet) := common G U (r (ends e).1) (r (ends e).2)
  have hC (e : H.edgeSet) : (C e).card≤t := by
    have h := hl f₀ hf₀ _ _ (ends_adj e)
    rw [hpin f₀ hf₀,hpin f₀ hf₀] at h
    exact h.le
  let val : F → ((e : H.edgeSet) → C e) := fun f e =>
    ⟨f.val (middle H e),mem_filter.mpr ⟨hmem f.val f.property _,by
      rw [← hpin f.val f.property]
      exact f.val.toHom.map_adj ((adj_old_middle H _ e).mpr (ends_mem_left e)),by
      rw [← hpin f.val f.property]
      exact f.val.toHom.map_adj ((adj_old_middle H _ e).mpr (ends_mem_right e))⟩⟩
  have hi : Function.Injective val := by
    intro f g he
    apply Subtype.ext
    apply copy_ext_old_middle H
    · intro u
      exact (hpin f.val f.property u).trans (hpin g.val g.property u).symm
    · intro e
      exact congrArg Subtype.val (congrFun he e)
  have hc := Fintype.card_le_of_injective val hi
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  calc
    _ ≤ ∏e : H.edgeSet, Fintype.card (C e) := hc
    _ ≤ ∏_e : H.edgeSet, t := prod_le_prod' (fun e he => by simpa only [Fintype.card_coe] using hC e)
    _ = _ := by simp [Nat.card_eq_fintype_card]

end Erdos571.RootedSubdivision

namespace Erdos571.SlimConedSubdivision
open SimpleGraph Finset
variable {W : Type} [Fintype W] [DecidableEq W]

lemma fixed_old_count (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (F : Finset (template.Copy G)) (r : Old → W)
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, EdgeLight G U t f)
    (hpin : ∀f∈F, ∀u, f (RootedSubdivision.old base u)=r u) : F.card≤t^11 := by
  have h := RootedSubdivision.fixed_old_count base G U t F r hmem (fun f hf u v huv => by
    have h := hl f hf u v huv
    exact lt_of_not_ge (fun hc => h (Or.inr hc))) hpin
  rwa [base_edge_card] at h

lemma old_image_count (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (F : Finset (template.Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hl : ∀f∈F, EdgeLight G U t f) :
    F.card≤t^11*(F.image (fun f => fun u : Old => f (RootedSubdivision.old base u))).card := by
  classical
  apply card_le_mul_card_image F (t^11)
  intro r hr
  exact fixed_old_count G U t _ r
    (fun f hf => hmem f (mem_filter.mp hf).1)
    (fun f hf => hl f (mem_filter.mp hf).1)
    (fun f hf u => congrFun (mem_filter.mp hf).2 u)

end Erdos571.SlimConedSubdivision

/-! Structural facts used to test rooted-copy packing in subdivision hosts. -/
namespace Erdos571.ProjectionHeavy
open SimpleGraph Finset

variable {V W : Type} {H : SimpleGraph V} {K : SimpleGraph W}

def liftCopy (f : H.Copy K) : (subdivision H).Copy (subdivision K) where
  toHom :=
    { toFun := Sum.map f f.mapEdgeSet
      map_rel' := by
        intro u v h
        cases u with
        | inl u => cases v with
          | inl v => exact h.elim
          | inr e => exact Sym2.mem_map.mpr ⟨u,h,rfl⟩
        | inr e => cases v with
          | inl v => exact Sym2.mem_map.mpr ⟨v,h,rfl⟩
          | inr e' => exact h.elim }
  injective' := Sum.map_injective.mpr ⟨f.injective,f.mapEdgeSet.injective⟩

lemma common_unique (H : SimpleGraph V) {u v a b : V ⊕ H.edgeSet}
    (huv : u≠v) (hua : (subdivision H).Adj u a) (hva : (subdivision H).Adj v a)
    (hub : (subdivision H).Adj u b) (hvb : (subdivision H).Adj v b) : a=b := by
  cases u with
  | inl u => cases v with
    | inl v =>
      cases a with
      | inl a => exact hua.elim
      | inr a => cases b with
        | inl b => exact hub.elim
        | inr b => exact congrArg Sum.inr (Subtype.ext (Sym2.eq_of_ne_mem
            (fun h => huv (congrArg Sum.inl h)) hua hva hub hvb))
    | inr v => cases a <;> first | exact hua.elim | exact hva.elim
  | inr u => cases v with
    | inl v => cases a <;> first | exact hua.elim | exact hva.elim
    | inr v =>
      cases a with
      | inr a => exact hua.elim
      | inl a => cases b with
        | inr b => exact hub.elim
        | inl b =>
          by_cases hab : a=b
          · exact congrArg Sum.inl hab
          · exact (huv (congrArg Sum.inr (Subtype.ext (Sym2.eq_of_ne_mem hab hua hub hva hvb)))).elim

lemma common_card_le_one [DecidableEq V] (H : SimpleGraph V)
    [DecidableRel (subdivision H).Adj] (U : Finset (V ⊕ H.edgeSet)) (u v : V ⊕ H.edgeSet) (huv : u≠v) :
    (FourthMoment.common (subdivision H) U u v).card≤1 := by
  classical
  apply card_le_one.mpr
  intro a ha b hb
  exact common_unique H huv (mem_filter.mp ha).2.1 (mem_filter.mp ha).2.2
    (mem_filter.mp hb).2.1 (mem_filter.mp hb).2.2

/-- Five distinct neighbors, formulated without degree instances. -/
def FiveNeighbors (G : SimpleGraph V) (v : V) : Prop :=
  ∃f : Fin 5 ↪ V, ∀i, G.Adj v (f i)

lemma FiveNeighbors.map {v : V} (h : FiveNeighbors H v) (f : H.Copy K) :
    FiveNeighbors K (f v) := by
  obtain ⟨e,he⟩ := h
  exact ⟨e.trans f.toEmbedding,fun i => f.toHom.map_adj (he i)⟩

lemma FiveNeighbors.card_le [DecidableEq V] {v : V} (h : FiveNeighbors H v)
    (S : Finset V) (hS : ∀w, H.Adj v w → w∈S) : 5≤S.card := by
  classical
  obtain ⟨e,he⟩ := h
  have hi : univ.image e ⊆ S := by
    intro w hw
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hw
    exact hS _ (he i)
  simpa only [card_image_of_injective _ e.injective,card_univ,Fintype.card_fin] using card_le_card hi

lemma fiveNeighbors_old (H : SimpleGraph V) {v : V}
    (h : FiveNeighbors (subdivision H) (.inl v)) : FiveNeighbors H v := by
  classical
  obtain ⟨f,hf⟩ := h
  have hex (i : Fin 5) : ∃e : H.edgeSet, f i=.inr e ∧ v∈e.val := by
    cases he : f i with
    | inl w => have hh := hf i; rw [he] at hh; exact hh.elim
    | inr e => exact ⟨e,rfl,by have hh := hf i; rwa [he] at hh⟩
  let e (i : Fin 5) : H.edgeSet := (hex i).choose
  have he (i : Fin 5) : f i=.inr (e i) ∧ v∈(e i).val := (hex i).choose_spec
  let g (i : Fin 5) : V := Sym2.Mem.other (he i).2
  have hg (i : Fin 5) : s(v,g i)=(e i).val := Sym2.other_spec (he i).2
  refine ⟨⟨g,?_⟩,?_⟩
  · intro i j hij
    apply f.injective
    rw [(he i).1,(he j).1]
    exact congrArg Sum.inr (Subtype.ext (by rw [← hg i,← hg j,hij]))
  · intro i
    have hh := (e i).property
    rwa [← hg i] at hh

lemma not_fiveNeighbors_middle [DecidableEq V] (H : SimpleGraph V) (e : H.edgeSet) :
    ¬FiveNeighbors (subdivision H) (.inr e) := by
  classical
  intro h
  have hh := h.card_le (e.val.toFinset.image Sum.inl) (by
    intro w hw
    cases w with
    | inl w => exact mem_image.mpr ⟨w,by simpa using hw,rfl⟩
    | inr w => exact hw.elim)
  have hcard : (e.val.toFinset.image (Sum.inl : V → V ⊕ H.edgeSet)).card≤2 := by
    calc
      _ ≤ e.val.toFinset.card := card_image_le
      _ ≤ 2 := by rw [Sym2.card_toFinset]; split <;> omega
  omega

end Erdos571.ProjectionHeavy


/-! A subdivision host sharing the central old vertex of the slim template. -/
set_option maxHeartbeats 4000000
set_option synthInstance.maxSize 4096
namespace Erdos571.SlimConedSubdivision.FiberObstruction
open Finset SimpleGraph ProjectionHeavy
attribute [local instance] Classical.propDecidable

abbrev HostOld (N : ℕ) := (Fin N × Fin 2) ⊕ Fin 8

def fixed : Fin 8 → Old :=
  ![center 0,center 1,center 2,tailRoot 0,tailRoot 1,tailRoot 2,tailRoot 3,tailRoot 4]

def projection (N : ℕ) : HostOld N → Old
  | .inl p => endpoint p.2
  | .inr j => fixed j

def hostBase (N : ℕ) : SimpleGraph (HostOld N) := base.comap (projection N)

def host (N : ℕ) := subdivision (hostBase N)

abbrev Host (N : ℕ) := HostOld N ⊕ (hostBase N).edgeSet

def value {N : ℕ} (k : Fin N) : Old → HostOld N
  | .inl none => .inr 0
  | .inl (some j) => .inl (k,j)
  | .inr (.inl (.inl none)) => .inr 3
  | .inr (.inl (.inl (some j))) => if j=0 then .inr 6 else .inr 7
  | .inr (.inl (.inr false)) => .inr 1
  | .inr (.inl (.inr true)) => .inr 4
  | .inr (.inr false) => .inr 2
  | .inr (.inr true) => .inr 5

lemma projection_value {N : ℕ} (k : Fin N) (v : Old) : projection N (value k v)=v := by
  fin_cases v <;> rfl

lemma value_fixed {N : ℕ} (k : Fin N) (j : Fin 8) : value k (fixed j)=.inr j := by
  fin_cases j <;> rfl

lemma value_injective {N : ℕ} (k : Fin N) : Function.Injective (value k) := by
  intro u v h
  simpa only [projection_value] using congrArg (projection N) h

def baseCopy {N : ℕ} (k : Fin N) : base.Copy (hostBase N) where
  toHom :=
    { toFun := value k
      map_rel' := by
        intro u v h
        change base.Adj (projection N (value k u)) (projection N (value k v))
        simpa only [projection_value] using h }
  injective' := value_injective k

noncomputable def copy {N : ℕ} (k : Fin N) : template.Copy (host N) :=
  (liftCopy (baseCopy k)).comp (RootedSubdivision.iso base).toCopy

lemma copy_old {N : ℕ} (k : Fin N) (v : Old) :
    copy k (RootedSubdivision.old base v)=.inl (value k v) := by
  change Sum.map (baseCopy k) (baseCopy k).mapEdgeSet
    (RootedSubdivision.vertexEquiv base (RootedSubdivision.old base v))=_
  rw [RootedSubdivision.vertexEquiv_apply,RootedSubdivision.toVertex_old]
  rfl

lemma copy_injective (N : ℕ) : Function.Injective (copy (N := N)) := by
  intro k l h
  have hh := congrArg (fun f : template.Copy (host N) =>
    f (RootedSubdivision.old base (endpoint 0))) h
  change copy k (RootedSubdivision.old base (endpoint 0))=
    copy l (RootedSubdivision.old base (endpoint 0)) at hh
  rw [copy_old,copy_old] at hh
  exact congrArg Prod.fst (Sum.inl.inj (Sum.inl.inj hh))

/-- Only five old vertices can have five distinct neighbors. -/
def high (N : ℕ) : Finset (HostOld N) := {.inr 0,.inr 1,.inr 2,.inr 6,.inr 7}

lemma high_card (N : ℕ) : (high N).card=5 := by simp [high]

lemma endpoint_neighbors (N : ℕ) (i : Fin N) (j : Fin 2) (w : HostOld N)
    (h : (hostBase N).Adj (.inl (i,j)) w) :
    w∈({.inr 0,.inr 1,.inr 2,.inr (if j=0 then 6 else 7)} : Finset (HostOld N)) := by
  cases w with
  | inl p =>
    rcases p with ⟨k,l⟩
    have hh : ¬base.Adj (endpoint j) (endpoint l) := by
      fin_cases j <;> fin_cases l <;>
        simp [base,RootEdgeDeletion.graph,ConedShortSubdivision.twice,ConedShortSubdivision.once,
          RootedCone.graph,ShortSpider.template,endpoint]
    exact (hh h).elim
  | inr r =>
    change base.Adj (endpoint j) (fixed r) at h
    fin_cases j <;> fin_cases r
    all_goals simp [base,RootEdgeDeletion.graph,ConedShortSubdivision.twice,ConedShortSubdivision.once,
      RootedCone.graph,RootedCone.color,ShortSpider.template,ShortSpider.color,endpoint,fixed,center,tailRoot] at h ⊢

lemma low_fixed_neighbors (N : ℕ) (r : Fin 8) (hr : r=3 ∨ r=4 ∨ r=5) (w : HostOld N)
    (h : (hostBase N).Adj (.inr r) w) : w=.inr 0 := by
  rcases hr with rfl|rfl|rfl
  all_goals cases w with
    | inl p =>
      rcases p with ⟨k,l⟩
      simp only [hostBase,SimpleGraph.comap_adj,projection] at h
      fin_cases l
      all_goals simp [base,RootEdgeDeletion.graph,ConedShortSubdivision.twice,ConedShortSubdivision.once,
        RootedCone.graph,RootedCone.color,ShortSpider.template,ShortSpider.color,projection,endpoint,fixed,center,tailRoot] at h
    | inr j =>
      change base.Adj _ (fixed j) at h
      fin_cases j
      all_goals simp [base,RootEdgeDeletion.graph,ConedShortSubdivision.twice,ConedShortSubdivision.once,
        RootedCone.graph,RootedCone.color,ShortSpider.template,ShortSpider.color,projection,endpoint,fixed,center,tailRoot] at h ⊢

lemma base_five_high (N : ℕ) {v : HostOld N} (h : FiveNeighbors (hostBase N) v) : v∈high N := by
  classical
  cases v with
  | inl p =>
    rcases p with ⟨k,l⟩
    have hc := h.card_le _ (endpoint_neighbors N k l)
    have hs : ({.inr 0,.inr 1,.inr 2,.inr (if l=0 then 6 else 7)} : Finset (HostOld N)).card≤4 := by
      fin_cases l <;> simp
    omega
  | inr r =>
    by_cases hr : r=3 ∨ r=4 ∨ r=5
    · have hc := h.card_le ({.inr 0} : Finset (HostOld N)) (by
        intro w hw
        simpa using low_fixed_neighbors N r hr w hw)
      simp only [card_singleton] at hc
      omega
    · fin_cases r <;> simp_all [high]

lemma host_five_high (N : ℕ) {v : Host N} (h : FiveNeighbors (host N) v) :
    v∈(high N).image Sum.inl := by
  cases v with
  | inl v => exact mem_image.mpr ⟨v,base_five_high N (fiveNeighbors_old (hostBase N) h),rfl⟩
  | inr e => exact (not_fiveNeighbors_middle (hostBase N) e h).elim

end Erdos571.SlimConedSubdivision.FiberObstruction


/-! The slim template has arbitrarily large light root fibers in power-free hosts. -/
set_option maxHeartbeats 3000000
set_option synthInstance.maxSize 4096
namespace Erdos571.SlimConedSubdivision.FiberObstruction
open Finset SimpleGraph ProjectionHeavy
attribute [local instance] Classical.propDecidable

def centerEdgeIndex : Fin 5 → Fin 11 := ![0,1,6,7,8]

lemma centerEdgeIndex_injective : Function.Injective centerEdgeIndex := by decide

lemma center_mem (i : Fin 5) : center 0∈(edges (centerEdgeIndex i)).val := by
  fin_cases i <;> simp [centerEdgeIndex,edges,coreEdge,tailEdge,tailParent,center,endpoint]

lemma template_five : FiveNeighbors template (RootedSubdivision.old base (center 0)) := by
  refine ⟨⟨fun i => RootedSubdivision.middle base (edges (centerEdgeIndex i)),?_⟩,?_⟩
  · intro i j h
    apply centerEdgeIndex_injective
    apply edges_injective
    have hh := congrArg (RootedSubdivision.toVertex base) h
    simpa only [RootedSubdivision.toVertex_middle,Sum.inr.injEq] using hh
  · intro i
    exact (RootedSubdivision.adj_old_middle base _ _).mpr (center_mem i)

/-- Every petal of the target power contributes a different degree-five center.
The host has at most five such vertices. -/
lemma free (M N : ℕ) (hM : 6≤M) : (graph M).Free (host N) := by
  classical
  rintro ⟨f⟩
  let c (i : Fin M) := (FullRootedPower.copy template i) (RootedSubdivision.old base (center 0))
  have hc (i : Fin M) : FiveNeighbors (graph M) (c i) :=
    template_five.map (FullRootedPower.copy template i)
  have hi : Function.Injective c := by
    intro i j h
    change Sum.inl (i,Sum.inl (none : Option (Fin 2)))=Sum.inl (j,Sum.inl none) at h
    exact congrArg Prod.fst (Sum.inl.inj h)
  have hsub : univ.image (fun i => f (c i)) ⊆ (high N).image Sum.inl := by
    intro v hv
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hv
    exact host_five_high N ((hc i).map f)
  have hcard := card_le_card hsub
  have hfi : Function.Injective (fun i => f (c i)) := by
    intro i j h
    exact hi (f.injective h)
  rw [card_image_of_injective _ hfi,card_univ,Fintype.card_fin,
    card_image_of_injective _ Sum.inl_injective,high_card] at hcard
  omega

/-- All seven original roots have fixed images throughout this family. -/
def rootValue (N : ℕ) : ((Option (Fin 2) ⊕ Bool) ⊕ Bool) → HostOld N
  | .inl (.inl none) => .inr 3
  | .inl (.inl (some j)) => if j=0 then .inr 6 else .inr 7
  | .inl (.inr false) => .inr 1
  | .inl (.inr true) => .inr 4
  | .inr false => .inr 2
  | .inr true => .inr 5

lemma rootValue_injective (N : ℕ) : Function.Injective (rootValue N) := by
  intro r s h
  fin_cases r <;> fin_cases s <;> simp_all [rootValue]

def roots (N : ℕ) : RootedSubdivision.Root base ↪ Host N :=
  ⟨Sum.elim (fun r => .inl (rootValue N r)) isEmptyElim,by
    intro r s h
    cases r with
    | inl r => cases s with
      | inl s => exact congrArg Sum.inl (rootValue_injective N (Sum.inl.inj h))
      | inr s => exact isEmptyElim s
    | inr r => exact isEmptyElim r⟩

lemma copy_root {N : ℕ} (k : Fin N) (r : RootedSubdivision.Root base) : copy k (.inr r)=roots N r := by
  cases r with
  | inl r =>
    have h := copy_old k (.inr r)
    change copy k (.inr (.inl r))=.inl (rootValue N r)
    rw [show (.inr (.inl r) : RootedSubdivision.Vertex base)=RootedSubdivision.old base (.inr r) by rfl,copy_old]
    fin_cases r <;> rfl
  | inr r => exact isEmptyElim r

lemma copy_light {N : ℕ} (k : Fin N) : EdgeLight (host N) univ 2 (copy k) := by
  intro u v huv
  have hne : copy k (RootedSubdivision.old base u)≠copy k (RootedSubdivision.old base v) :=
    (copy k).injective.ne ((RootedSubdivision.old_injective base).ne huv.ne)
  have hb := common_card_le_one (hostBase N) univ _ _ hne
  rintro (he|hc)
  · exact hne he
  · dsimp only [host] at hc
    omega

/-- This counterexample concerns a tempting intermediate assertion, not the
rational-exponent conjecture. Even globally bounded codegrees do not give a
uniform constant bound for each fixed-root fiber of the slim template. -/
theorem large_light_fiber (M N : ℕ) (hM : 6≤M) :
    ∃r : RootedSubdivision.Root base ↪ Host N, ∃F : Finset (template.Copy (host N)),
      (graph M).Free (host N) ∧ F.card=N ∧
      (∀f∈F, ∀a, f (.inr a)=r a) ∧
      (∀f∈F, EdgeLight (host N) univ 2 f) ∧
      (∀f∈F, f (RootedSubdivision.old base (center 0))=.inl (.inr 0)) ∧
      (∀u v : Host N, u≠v → (FourthMoment.common (host N) univ u v).card≤1) := by
  classical
  refine ⟨roots N,univ.image copy,free M N hM,?_,?_,?_,?_,?_⟩
  · rw [card_image_of_injective _ (copy_injective N),card_univ,Fintype.card_fin]
  · intro f hf a
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hf
    exact copy_root k a
  · intro f hf
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hf
    exact copy_light k
  · intro f hf
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hf
    rw [copy_old]
    rfl
  · exact fun u v huv => common_card_le_one (hostBase N) univ u v huv

theorem no_uniform_light_fiber_bound (M : ℕ) (hM : 6≤M) :
    ¬∃C : ℕ, ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W)
      (_ : DecidableRel G.Adj), (graph M).Free G →
      ∀r : RootedSubdivision.Root base ↪ W, ∀F : Finset (template.Copy G),
      (∀f∈F, ∀a, f (.inr a)=r a) → (∀f∈F, EdgeLight G univ 2 f) → F.card≤C := by
  classical
  rintro ⟨C,hC⟩
  obtain ⟨r,F,hf,hcard,hroot,hl,hcenter,hcodeg⟩ := large_light_fiber M (C+1) hM
  have hb := hC (Host (C+1)) inferInstance inferInstance (host (C+1)) inferInstance hf r F hroot hl
  omega

/-- The obstruction persists even after imposing a global codegree bound. -/
theorem no_uniform_bounded_codegree_fiber_bound (M : ℕ) (hM : 6≤M) :
    ¬∃C : ℕ, ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W)
      (_ : DecidableRel G.Adj), (graph M).Free G →
      (∀u v : W, u≠v → (FourthMoment.common G univ u v).card≤1) →
      ∀r : RootedSubdivision.Root base ↪ W, ∀F : Finset (template.Copy G),
      (∀f∈F, ∀a, f (.inr a)=r a) → (∀f∈F, EdgeLight G univ 2 f) → F.card≤C := by
  classical
  rintro ⟨C,hC⟩
  obtain ⟨r,F,hf,hcard,hroot,hl,hcenter,hcodeg⟩ := large_light_fiber M (C+1) hM
  have hb := hC (Host (C+1)) inferInstance inferInstance (host (C+1)) inferInstance
    hf hcodeg r F hroot hl
  omega

end Erdos571.SlimConedSubdivision.FiberObstruction

/-! Counting connected graph copies by restriction to a nonempty embedded vertex set. -/
namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization

lemma restriction_bound {V I W : Type} [Fintype V] [Fintype I] [Nonempty I]
    [DecidableEq V] [DecidableEq W] (H : SimpleGraph V) (hH : H.Connected)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (e : I ↪ V) (F : Finset (H.Copy G)) (B : Finset (I → W))
    (hmem : ∀f∈F, ∀v, f v∈U) (hmap : ∀f∈F, (fun i => f (e i))∈B) :
    (F.card : ℝ)≤B.card*D^(Fintype.card V-Fintype.card I) := by
  classical
  let ev : H.Copy G → I → W := fun f i => f (e i)
  apply RealFiberCount.bound F B ev hmap
  intro q hq
  let F' := F.filter (fun f => ev f=q)
  by_cases hn : F'.Nonempty
  swap
  · rw [show F.filter (fun f => ev f=q)=∅ from not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]
    positivity
  obtain ⟨f₀,hf₀⟩ := hn
  have hb := bound H hH G U hD hdeg (univ.image e) (univ_nonempty.image e) f₀ F'
    (fun f hf => hmem f (mem_filter.mp hf).1) (by
      intro f hf v hv
      obtain ⟨i,hi,rfl⟩ := mem_image.mp hv
      exact (congrFun (mem_filter.mp hf).2 i).trans (congrFun (mem_filter.mp hf₀).2 i).symm)
  simpa only [card_image_of_injective _ e.injective,card_univ] using hb

lemma copy_restriction_bound {V I W : Type} [Fintype V] [Fintype I] [Nonempty I]
    [DecidableEq V] [DecidableEq W] (H : SimpleGraph V) (hH : H.Connected)
    (K : SimpleGraph I) (e : K.Copy H) (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (F : Finset (H.Copy G)) (B : Finset (K.Copy G))
    (hmem : ∀f∈F, ∀v, f v∈U) (hmap : ∀f∈F, f.comp e∈B) :
    (F.card : ℝ)≤B.card*D^(Fintype.card V-Fintype.card I) := by
  classical
  let vals : K.Copy G → I → W := fun f i => f i
  have hi : Function.Injective vals := by
    intro f g h
    exact Copy.ext (fun i => congrFun h i)
  have hb := restriction_bound H hH G U hD hdeg e.toEmbedding F (B.image vals) hmem
    (fun f hf => mem_image.mpr ⟨f.comp e,hmap f hf,rfl⟩)
  simpa only [card_image_of_injective _ hi] using hb

end Erdos571.ConnectedCopyBound


/-! The rooted path of length five, its powers, and a spider host. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph RootedSunflower

abbrev Vertex := Fin 4 ⊕ Fin 2

def index : Vertex → Fin 6
  | .inl i => ⟨i.val+1,by omega⟩
  | .inr j => if j=0 then 0 else 5

def position : Fin 6 → Vertex := ![.inr 0,.inl 0,.inl 1,.inl 2,.inl 3,.inr 1]

def equiv : Vertex ≃ Fin 6 where
  toFun := index
  invFun := position
  left_inv := by decide
  right_inv := by decide

def template : SimpleGraph Vertex := (pathGraph 6).comap index

instance : DecidableRel template.Adj := by
  intro u v
  change Decidable ((pathGraph 6).Adj (index u) (index v))
  exact decidable_of_iff _ pathGraph_adj.symm

def pathIso : template ≃g pathGraph 6 where
  toEquiv := equiv
  map_rel_iff' := Iff.rfl

lemma position_injective : Function.Injective position := equiv.symm.injective

@[simp] lemma index_position (i : Fin 6) : index (position i)=i := equiv.apply_symm_apply i
@[simp] lemma position_index (v : Vertex) : position (index v)=v := equiv.symm_apply_apply v

lemma adj_position (i j : Fin 6) : template.Adj (position i) (position j) ↔ (pathGraph 6).Adj i j := by
  change (pathGraph 6).Adj (index (position i)) (index (position j)) ↔ _
  rw [index_position,index_position]

lemma connected : template.Connected := by
  have hc := pathGraph_connected 5
  exact pathIso.connected_iff.mpr hc

lemma isTree : template.IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected,?_⟩
  change Nat.card template.edgeSet+1=Nat.card Vertex
  simp only [Nat.card_eq_fintype_card]
  decide

lemma no_isolated : ∀v, ∃w, template.Adj v w := by decide

lemma balance : ∀C : Finset (Fin 4),
    5*(Fintype.card (Fin 4)-C.card) ≤ 4*Nat.card (PetalEdge template C) := by
  simp only [Nat.card_eq_fintype_card]
  decide

def color (v : Vertex) : Bool := decide ((index v).val%2=0)

lemma color_proper : ∀{u v}, template.Adj u v → color u≠color v := by decide

def graph (M : ℕ) := FullRootedPower.graph template M

lemma exists_lower : ∃M : ℕ, 2≤M ∧ Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (n : ℝ)^(6/5 : ℝ))
    (fun n : ℕ => (extremalNumber n (graph M) : ℝ)) := by
  have h := FullRootedPower.exact_lower template no_isolated 4 5 (by omega) (by omega) balance
  norm_num at h
  exact h

def pathCopy {W : Type} (G : SimpleGraph W) (v : Fin 6 → W)
    (hadj : ∀i : Fin 5, G.Adj (v i.castSucc) (v i.succ)) (hinj : Function.Injective v) : template.Copy G where
  toHom :=
    { toFun := fun a => v (index a)
      map_rel' := by
        intro a b hab
        change (pathGraph 6).Adj (index a) (index b) at hab
        obtain ⟨i,hi⟩ := (show ∃i : Fin 5, (index a=i.castSucc ∧ index b=i.succ) ∨
          (index a=i.succ ∧ index b=i.castSucc) by
            generalize ha : index a=x at hab ⊢
            generalize hb : index b=y at hab ⊢
            fin_cases x <;> fin_cases y <;> simp_all [pathGraph_adj]
            all_goals decide)
        rcases hi with ⟨ha,hb⟩|⟨ha,hb⟩
        · rw [ha,hb]; exact hadj i
        · rw [ha,hb]; exact (hadj i).symm }
  injective' := hinj.comp equiv.injective

@[simp] lemma pathCopy_position {W : Type} (G : SimpleGraph W) (v : Fin 6 → W)
    (hadj) (hinj) (i : Fin 6) : pathCopy G v hadj hinj (position i)=v i := by
  change v (index (position i))=v i
  rw [index_position]

/-- The short-spider power contains a theta with five-edge branches. -/
def spiderValue (M : ℕ) : (Fin M × Fin 4) ⊕ Fin 2 →
    (Fin (M+1) × Option (Fin M)) ⊕ Option (Fin M)
  | .inl (i,j) => ![.inl (i.succ,none),.inl (i.succ,some i),.inr (some i),.inl (0,some i)] j
  | .inr j => if j=0 then .inr none else .inl (0,none)

lemma spiderValue_injective (M : ℕ) : Function.Injective (spiderValue M) := by
  intro a b h
  cases a with
  | inl a => cases b with
    | inl b =>
      rcases a with ⟨i,j⟩
      rcases b with ⟨k,l⟩
      fin_cases j <;> fin_cases l <;> simp_all [spiderValue,Fin.succ_ne_zero,Ne.symm (Fin.succ_ne_zero i),Ne.symm (Fin.succ_ne_zero k)]
    | inr j =>
      rcases a with ⟨i,k⟩
      fin_cases k <;> fin_cases j <;> simp_all [spiderValue,Fin.succ_ne_zero]
  | inr i => cases b with
    | inl b =>
      rcases b with ⟨j,k⟩
      fin_cases i <;> fin_cases k <;> simp_all [spiderValue,Fin.succ_ne_zero,Ne.symm (Fin.succ_ne_zero j)]
    | inr j => fin_cases i <;> fin_cases j <;> simp_all [spiderValue]

def spiderCopy (M : ℕ) : (graph M).Copy (ShortSpider.graph M (M+1)) where
  toHom :=
    { toFun := spiderValue M
      map_rel' := by
        intro u v h
        cases u with
        | inl u => cases v with
          | inl v =>
            rcases u with ⟨i,j⟩
            rcases v with ⟨k,l⟩
            obtain ⟨hik,hjl⟩ := h
            change i=k at hik
            subst k
            fin_cases j <;> fin_cases l
            all_goals simp_all [template,index,pathGraph_adj,spiderValue,ShortSpider.graph,FullRootedPower.graph,ShortSpider.template]
          | inr r =>
            rcases u with ⟨i,j⟩
            change template.Adj (.inl j) (.inr r) at h
            fin_cases j <;> fin_cases r
            all_goals simp_all [template,index,pathGraph_adj,spiderValue,ShortSpider.graph,FullRootedPower.graph,ShortSpider.template]
        | inr r => cases v with
          | inl v =>
            rcases v with ⟨i,j⟩
            change template.Adj (.inr r) (.inl j) at h
            fin_cases j <;> fin_cases r
            all_goals simp_all [template,index,pathGraph_adj,spiderValue,ShortSpider.graph,FullRootedPower.graph,ShortSpider.template]
          | inr s =>
            change template.Adj (.inr r) (.inr s) at h
            fin_cases r <;> fin_cases s <;> simp [template,index,pathGraph_adj] at h }
  injective' := spiderValue_injective M

lemma spider_free {W : Type} {G : SimpleGraph W} (M : ℕ) (hf : (graph M).Free G) :
    (ShortSpider.graph M (M+1)).Free G :=
  fun h => hf ((show graph M ⊑ ShortSpider.graph M (M+1) from ⟨spiderCopy M⟩).trans h)

end Erdos571.ThetaFive


/-! Packing five-edge paths assembled from disjoint short prefixes and rich suffixes. -/
set_option maxHeartbeats 4000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

lemma power_eq (M : ℕ) : RootedPacking.power template M=graph M := by
  ext u v
  cases u <;> cases v
  · rfl
  · rfl
  · rfl
  · rename_i r s
    change False ↔ template.Adj (.inr r) (.inr s)
    fin_cases r <;> fin_cases s <;> decide

lemma contains_paths (G : SimpleGraph W) (M : ℕ) (z x : W) (hzx : z≠x)
    (v : Fin M → Fin 6 → W)
    (hadj : ∀i, ∀j : Fin 5, G.Adj (v i j.castSucc) (v i j.succ))
    (hinj : ∀i, Function.Injective (v i)) (hzero : ∀i, v i 0=z) (hlast : ∀i, v i 5=x)
    (hdis : ∀i j, i≠j → Disjoint (univ.image (fun k : Fin 4 => v i ⟨k.val+1,by omega⟩))
      (univ.image (fun k : Fin 4 => v j ⟨k.val+1,by omega⟩))) : (graph M).IsContained G := by
  classical
  let f (i : Fin M) := pathCopy G (v i) (hadj i) (hinj i)
  let r : Fin 2 ↪ W := ⟨![z,x],by
    intro a b h
    fin_cases a <;> fin_cases b <;> simp_all [Ne.symm hzx]⟩
  rw [← power_eq]
  refine ⟨RootedPacking.powerCopy M r f ?_ ?_⟩
  · intro i k
    fin_cases k
    · exact hzero i
    · exact hlast i
  · intro i j hij
    have hs (i : Fin M) : RootedPacking.interior (f i) ⊆
        univ.image (fun k : Fin 4 => v i ⟨k.val+1,by omega⟩) := by
      intro w hw
      simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
      obtain ⟨a,rfl⟩ := hw
      exact mem_image.mpr ⟨a,mem_univ _,rfl⟩
    exact (hdis i j hij).mono (hs i) (hs j)

/-- Three-path richness is measured using the already established light fibers. -/
def Rich3 (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) (u x : W) : Prop :=
  ThetaFour.Rich G U t (2*M) u x

lemma contains_of_rich3_prefixes (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (z x : W) (hzx : z≠x) (p : Fin M → W×W)
    (hp : ∀i, G.Adj z (p i).1 ∧ G.Adj (p i).1 (p i).2)
    (havoid : ∀i, Disjoint (ThetaFour.foot (p i)) {z,x})
    (hdis : Pairwise (fun i j => Disjoint (ThetaFour.foot (p i)) (ThetaFour.foot (p j))))
    (hrich : ∀i, Rich3 G U t M (p i).2 x) : (graph M).IsContained G := by
  classical
  let Z : Finset W := {z,x} ∪ univ.biUnion (fun i => ThetaFour.foot (p i))
  have hZ : Z.card≤2+2*M := by
    have hh := card_biUnion_le (s := (univ : Finset (Fin M))) (t := fun i => ThetaFour.foot (p i))
    have hh' : (∑i : Fin M, (ThetaFour.foot (p i)).card)≤2*M := by
      calc
        _ ≤ ∑_i : Fin M, 2 := sum_le_sum (fun i hi => card_le_two)
        _ = _ := by simp [mul_comm]
    have hpair : ({z,x} : Finset W).card≤2 := card_le_two
    have hc := card_union_le ({z,x} : Finset W) (univ.biUnion (fun i => ThetaFour.foot (p i)))
    dsimp only [Z]
    omega
  obtain ⟨q,hq,hqZ,hqdis⟩ := DisjointChoice.exists_choice 2 (2*t) M ThetaFour.foot
    (fun i => ThetaFour.threeFiber G U t (p i).2 x) Z
    (fun i q hq => card_le_two) (fun i w => ThetaFour.threeFiber_load G U t (p i).2 x w)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by omega)) (hrich i))
  have hqavoid (i : Fin M) (w : W) (hw : w∈Z) : w≠(q i).1 ∧ w≠(q i).2 := by
    constructor <;> intro he <;> apply Finset.disjoint_left.mp (hqZ i) _ hw
    · simp [ThetaFour.foot,←he]
    · simp [ThetaFour.foot,←he]
  have hzq (i) := hqavoid i z (mem_union_left _ (by simp))
  have hxq (i) := hqavoid i x (mem_union_left _ (by simp))
  have hpq (i j : Fin M) :
      (p j).1≠(q i).1 ∧ (p j).1≠(q i).2 ∧ (p j).2≠(q i).1 ∧ (p j).2≠(q i).2 := by
    have h₁ := hqavoid i (p j).1 (mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,by simp [ThetaFour.foot]⟩))
    have h₂ := hqavoid i (p j).2 (mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,by simp [ThetaFour.foot]⟩))
    tauto
  have hpa (i : Fin M) : z≠(p i).1 ∧ z≠(p i).2 ∧ x≠(p i).1 ∧ x≠(p i).2 := by
    have hh := havoid i
    constructor
    · intro he; exact Finset.disjoint_left.mp hh (show z∈ThetaFour.foot (p i) by simp [ThetaFour.foot,he]) (by simp)
    constructor
    · intro he; exact Finset.disjoint_left.mp hh (show z∈ThetaFour.foot (p i) by simp [ThetaFour.foot,he]) (by simp)
    constructor
    · intro he; exact Finset.disjoint_left.mp hh (show x∈ThetaFour.foot (p i) by simp [ThetaFour.foot,he]) (by simp)
    · intro he; exact Finset.disjoint_left.mp hh (show x∈ThetaFour.foot (p i) by simp [ThetaFour.foot,he]) (by simp)
  let v (i : Fin M) : Fin 6 → W := ![z,(p i).1,(p i).2,(q i).1,(q i).2,x]
  have hqa (i : Fin M) := ThetaFour.mem_threeFiber.mp (hq i)
  have hadj : ∀i, ∀j : Fin 5, G.Adj (v i j.castSucc) (v i j.succ) := by
    intro i j
    have h := hqa i
    fin_cases j
    · exact (hp i).1
    · exact (hp i).2
    · exact h.2.2.2.2.1
    · exact h.2.2.2.2.2.1
    · exact h.2.2.2.2.2.2.1
  have hinj : ∀i, Function.Injective (v i) := by
    intro i a b he
    have h₁ := hpa i
    have h₂ := hpq i i
    have h₃ := hzq i
    have h₄ := hxq i
    have h₅ := (hp i).2.ne
    have h₆ := (hqa i).2.2.2.2.2.1.ne
    fin_cases a <;> fin_cases b <;> simp_all [v,eq_comm]
  have hins (i : Fin M) : (univ.image (fun k : Fin 4 => v i ⟨k.val+1,by omega⟩))⊆
      ThetaFour.foot (p i) ∪ ThetaFour.foot (q i) := by
    intro w hw
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hw
    fin_cases k <;> simp [v,ThetaFour.foot]
  apply contains_paths G M z x hzx v hadj hinj (fun i => rfl) (fun i => rfl)
  intro i j hij
  apply Disjoint.mono (hins i) (hins j)
  rw [disjoint_union_left,disjoint_union_right,disjoint_union_right]
  refine ⟨⟨hdis hij,?_⟩,⟨?_,hqdis hij⟩⟩
  · exact (hqZ j).symm.mono_left ((subset_biUnion_of_mem (fun i => ThetaFour.foot (p i)) (mem_univ i)).trans subset_union_right)
  · exact (hqZ i).mono_right ((subset_biUnion_of_mem (fun i => ThetaFour.foot (p i)) (mem_univ j)).trans subset_union_right)

end Erdos571.ThetaFive


/-! Rich three-paths are a lower-order family in a theta-five-free host. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization
variable {W : Type} [DecidableEq W]

noncomputable def threeLink (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (z x : W) : Finset (W×W) := by
  classical
  exact (U×ˢU).filter (fun p => ((p.2,p.1),(z,x))∈ThetaFour.richWalks G U t (2*M))

lemma mem_threeLink {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t M : ℕ} {z x a u : W} : (a,u)∈threeLink G U t M z x ↔
      u∈U ∧ a∈U ∧ z∈U ∧ x∈U ∧ G.Adj u a ∧ G.Adj a z ∧ G.Adj z x ∧
      ¬ShortSpider.Bad G U t u z ∧ ¬ShortSpider.Bad G U t a x ∧ Rich3 G U t M u x := by
  classical
  simp only [threeLink,ThetaFour.richWalks,ShortSpider.goodWalks,mem_filter,mem_product,
    ShortSpider.mem_threeWalks,Rich3]
  tauto

lemma threeLink_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M D : ℕ) (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z x w : W) :
    ((threeLink G U t M z x).filter (fun p => w∈ThetaFour.foot p)).card≤D+t := by
  classical
  let F := threeLink G U t M z x
  have hfirst : (F.filter (fun p => p.1=w)).card≤D := by
    by_cases hn : (F.filter (fun p => p.1=w)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
    obtain ⟨p₀,hp₀⟩ := hn
    have hw : w∈U := (mem_filter.mp hp₀).2 ▸ (mem_threeLink.mp (mem_filter.mp hp₀).1).2.1
    apply le_trans _ (hdeg w hw)
    apply card_le_card_of_injOn Prod.snd
    · intro p hp
      have h := mem_threeLink.mp (mem_filter.mp hp).1
      exact mem_filter.mpr ⟨h.1,(mem_filter.mp hp).2 ▸ h.2.2.2.2.1.symm⟩
    · intro p hp q hq he
      exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) he
  have hlast : (F.filter (fun p => p.2=w)).card≤t := by
    by_cases hn : (F.filter (fun p => p.2=w)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
    obtain ⟨p₀,hp₀⟩ := hn
    have hl : ¬ShortSpider.Bad G U t w z :=
      (mem_filter.mp hp₀).2 ▸ (mem_threeLink.mp (mem_filter.mp hp₀).1).2.2.2.2.2.2.2.1
    have hc : (FourthMoment.common G U w z).card≤t :=
      (lt_of_not_ge (fun h => hl (Or.inr h))).le
    apply le_trans _ hc
    apply card_le_card_of_injOn Prod.fst
    · intro p hp
      have h := mem_threeLink.mp (mem_filter.mp hp).1
      exact mem_filter.mpr ⟨h.2.1,(mem_filter.mp hp).2 ▸ h.2.2.2.2.1,h.2.2.2.2.2.1.symm⟩
    · intro p hp q hq he
      exact Prod.ext he ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm)
  have hsub : F.filter (fun p => w∈ThetaFour.foot p) ⊆
      F.filter (fun p => p.1=w) ∪ F.filter (fun p => p.2=w) := by
    intro p hp
    obtain ⟨hp,hw⟩ := mem_filter.mp hp
    simp only [ThetaFour.foot,mem_insert,mem_singleton] at hw
    rcases hw with hw|hw
    · exact mem_union_left _ (mem_filter.mpr ⟨hp,hw.symm⟩)
    · exact mem_union_right _ (mem_filter.mpr ⟨hp,hw.symm⟩)
  exact (card_le_card hsub).trans ((card_union_le _ _).trans (Nat.add_le_add hfirst hlast))

lemma threeLink_bound_nat (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M D : ℕ) (hM : 1≤M) (hdeg : ∀v∈U, (neighbors G U v).card≤D)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G) (z x : W) :
    (threeLink G U t M z x).card<2*M*(D+t+1) := by
  classical
  let F := threeLink G U t M z x
  by_contra! hlarge
  have hF : F.Nonempty := card_pos.mp (by
    dsimp [F]
    have hpos : 0<2*M*(D+t+1) := by positivity
    omega)
  obtain ⟨p₀,hp₀⟩ := hF
  have hzx := (mem_threeLink.mp hp₀).2.2.2.2.2.2.1.ne
  obtain ⟨S,hSF,hSc,hS⟩ := RootedPacking.disjoint_footprints F ThetaFour.foot 2 (D+t+1) M
    (by omega) (by omega) (fun p hp => by simp [ThetaFour.foot]) (fun p hp => card_le_two)
    (fun w => (threeLink_load G U t M D hdeg z x w).trans (by omega)) (by nlinarith)
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let p (i : Fin M) : W×W := e i
  have hm (i) := mem_threeLink.mp (hSF (e i).property)
  apply hf (contains_of_rich3_prefixes G U t M z x hzx p
    (fun i => ⟨(hm i).2.2.2.2.2.1.symm,(hm i).2.2.2.2.1.symm⟩) ?_ ?_ (fun i => (hm i).2.2.2.2.2.2.2.2.2))
  · intro i
    have hh := hm i
    have haz : (p i).1≠z := hh.2.2.2.2.2.1.ne
    have huz : (p i).2≠z := fun he => hh.2.2.2.2.2.2.2.1 (Or.inl he)
    have hax : (p i).1≠x := fun he => hh.2.2.2.2.2.2.2.2.1 (Or.inl he)
    have hux : (p i).2≠x := ThetaFour.threeFiber_endpoints_ne G U t g hg
      ⟨((p i).1,z),ThetaFour.mem_threeFiber.mpr
        ⟨hh.1,hh.2.1,hh.2.2.1,hh.2.2.2.1,hh.2.2.2.2.1,hh.2.2.2.2.2.1,hh.2.2.2.2.2.2.1,
          hh.2.2.2.2.2.2.2.1,hh.2.2.2.2.2.2.2.2.1⟩⟩
    simp [ThetaFour.foot,Finset.disjoint_left,haz,huz,hax,hux]
  · intro i j hij
    exact hS (e i) (e i).property (e j) (e j).property
      (fun he => hij (e.injective (Subtype.ext he)))

lemma threeLink_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (hM : 1≤M) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G) (z x : W) :
    ((threeLink G U t M z x).card : ℝ)≤2*M*(D+t+1) := by
  have hn := (threeLink_bound_nat G U t M ⌊D⌋₊ hM (fun v hv => Nat.le_floor (hdeg v hv)) g hg hf z x).le
  have hn' : ((threeLink G U t M z x).card : ℝ)≤2*M*((⌊D⌋₊ : ℝ)+t+1) := by exact_mod_cast hn
  have hd := Nat.floor_le hD
  nlinarith [Nat.cast_nonneg M (α := ℝ)]

/-- Bad three-paths cost only two factors of the maximum degree. -/
lemma richThree_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (hM : 1≤M) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v) (hf : (graph M).Free G) :
    ((ThetaFour.richWalks G U t (2*M)).card : ℝ)≤2*M*(D+t+1)*U.card*D := by
  classical
  let F := ThetaFour.richWalks G U t (2*M)
  have hmap : Set.MapsTo (Prod.snd : (W×W)×(W×W) → W×W) (F : Set ((W×W)×(W×W))) (arcs G U : Set (W×W)) := by
    intro p hp
    have h := ShortSpider.mem_threeWalks.mp (mem_filter.mp (mem_filter.mp hp).1).1
    exact mem_arcs.mpr ⟨h.2.2.1,h.2.2.2.1,h.2.2.2.2.2.2⟩
  have hcount := RealFiberCount.bound F (arcs G U) Prod.snd hmap (D := 2*(M : ℝ)*(D+t+1)) (by
    intro q hq
    have hc : (F.filter (fun p => p.2=q)).card≤(threeLink G U t M q.1 q.2).card := by
      apply card_le_card_of_injOn (fun p => (p.1.2,p.1.1))
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        apply mem_filter.mpr
        have h := ShortSpider.mem_threeWalks.mp (mem_filter.mp (mem_filter.mp hp).1).1
        refine ⟨mem_product.mpr ⟨h.2.1,h.1⟩,?_⟩
        simpa only [←he] using hp
      · intro p hp p' hp' he
        exact Prod.ext (Prod.ext (congrArg Prod.snd he) (congrArg Prod.fst he))
          ((mem_filter.mp hp).2.trans (mem_filter.mp hp').2.symm)
    exact (show _≤((threeLink G U t M q.1 q.2).card : ℝ) by exact_mod_cast hc).trans
      (threeLink_bound G U t M hM hD hdeg g hg hf q.1 q.2))
  have ha : ((arcs G U).card : ℝ)≤U.card*D := by
    rw [arcs_sum,Nat.cast_sum]
    exact (sum_le_sum hdeg).trans_eq (by simp)
  nlinarith [mul_le_mul_of_nonneg_right ha (show 0≤2*(M : ℝ)*(D+t+1) by positivity)]

end Erdos571.ThetaFive


/-! Rich four-paths can be prefixed by distinct neighbors to create theta-five. -/
set_option maxHeartbeats 4000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def fourLoad (t M : ℕ) : ℕ := t^2+2*((3*(2*M)+2)*(2*t))
def fourThreshold (t M : ℕ) : ℕ := (4*M+2)*fourLoad t M

noncomputable def fourFiber (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (u x : W) : Finset (ThetaFour.template.Copy G) := by
  classical
  exact (TreeCopiesIn.copies ThetaFour.template G U).filter
    (fun f => ThetaFour.GoodCopy G U t (2*M) f ∧ f (.inr 0)=u ∧ f (.inr 1)=x)

lemma mem_fourFiber {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t M : ℕ}
    {u x : W} {f : ThetaFour.template.Copy G} : f∈fourFiber G U t M u x ↔
      ThetaFour.GoodCopy G U t (2*M) f ∧ f (.inr 0)=u ∧ f (.inr 1)=x := by
  classical
  simp only [fourFiber,mem_filter,TreeCopiesIn.mem_copies]
  exact ⟨fun h => h.2,fun h => ⟨h.1.mem,h⟩⟩

lemma fourFiber_load (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (u x w : W) :
    ((fourFiber G U t M u x).filter (fun f => w∈RootedPacking.interior f)).card≤fourLoad t M := by
  apply ThetaFour.interior_load G U t (2*M) _ ![u,x]
  · intro f hf; exact (mem_fourFiber.mp hf).1
  · intro f hf j
    fin_cases j
    · exact (mem_fourFiber.mp hf).2.1
    · exact (mem_fourFiber.mp hf).2.2

def Rich4 (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) (u x : W) : Prop :=
  fourThreshold t M < (fourFiber G U t M u x).card

noncomputable instance (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) :
    DecidableRel (Rich4 G U t M) := fun u x => inferInstanceAs (Decidable (_ < _))

lemma contains_of_rich4_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (z x : W) (hzx : z≠x) (u : Fin M ↪ W)
    (hu : ∀i, G.Adj z (u i)) (hrich : ∀i, Rich4 G U t M (u i) x) : (graph M).IsContained G := by
  classical
  let Z : Finset W := {z,x} ∪ univ.image u
  have hZ : Z.card≤M+2 := by
    have hp : ({z,x} : Finset W).card≤2 := card_le_two
    have hc := card_union_le ({z,x} : Finset W) (univ.image u)
    have hi : (univ.image u).card≤M := by simpa using card_image_le (s := univ) (f := u)
    dsimp [Z]
    omega
  obtain ⟨p,hp,hpZ,hpdis⟩ := DisjointChoice.exists_choice 3 (fourLoad t M) M RootedPacking.interior
    (fun i => fourFiber G U t M (u i) x) Z
    (fun i f hf => by rw [RootedPacking.interior_card]; simp)
    (fun i w => fourFiber_load G U t M (u i) x w)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by omega)) (hrich i))
  have hroot (i) := (mem_fourFiber.mp (hp i)).2
  have havoid (i : Fin M) (w : W) (hw : w∈Z) (a : Option (Fin 2)) : w≠p i (.inl a) := by
    intro he
    exact Finset.disjoint_left.mp (hpZ i) (he ▸ RootedPacking.mem_interior (p i) a) hw
  have hz (i) := havoid i z (mem_union_left _ (by simp))
  have hui (i j : Fin M) := havoid i (u j) (mem_union_right _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩))
  let v (i : Fin M) : Fin 6 → W := ![z,u i,p i (.inl (some 0)),p i (.inl none),p i (.inl (some 1)),x]
  have hpair (i : Fin M) : Function.Injective (![u i,p i (.inl (some 0)),p i (.inl none),p i (.inl (some 1)),x] : Fin 5 → W) := by
    have he : (![u i,p i (.inl (some 0)),p i (.inl none),p i (.inl (some 1)),x] : Fin 5 → W)=
        fun j => p i (ThetaFour.pathEquiv.symm j) := by
      funext j
      fin_cases j
      · exact (hroot i).1.symm
      · rfl
      · rfl
      · rfl
      · exact (hroot i).2.symm
    rw [he]
    exact (p i).injective.comp ThetaFour.pathEquiv.symm.injective
  have hinj : ∀i, Function.Injective (v i) := by
    intro i a b he
    induction a using Fin.cases with
    | zero =>
      induction b using Fin.cases with
      | zero => rfl
      | succ b =>
        exfalso
        fin_cases b
        · exact (hu i).ne he
        · exact hz i (some 0) he
        · exact hz i none he
        · exact hz i (some 1) he
        · exact hzx he
    | succ a =>
      induction b using Fin.cases with
      | zero =>
        exfalso
        fin_cases a
        · exact (hu i).ne he.symm
        · exact hz i (some 0) he.symm
        · exact hz i none he.symm
        · exact hz i (some 1) he.symm
        · exact hzx he.symm
      | succ b => exact congrArg Fin.succ (hpair i he)
  have hadj : ∀i, ∀j : Fin 5, G.Adj (v i j.castSucc) (v i j.succ) := by
    intro i j
    fin_cases j
    · exact hu i
    · change G.Adj (u i) (p i (.inl (some 0)))
      rw [←(hroot i).1]
      exact (p i).toHom.map_adj (by decide)
    · exact (p i).toHom.map_adj (by decide)
    · exact (p i).toHom.map_adj (by decide)
    · change G.Adj (p i (.inl (some 1))) x
      rw [←(hroot i).2]
      exact (p i).toHom.map_adj (by decide)
  have hins (i : Fin M) : (univ.image (fun k : Fin 4 => v i ⟨k.val+1,by omega⟩))⊆
      insert (u i) (RootedPacking.interior (p i)) := by
    intro w hw
    obtain ⟨k,hk,rfl⟩ := mem_image.mp hw
    fin_cases k
    · exact mem_insert_self _ _
    · exact mem_insert_of_mem (RootedPacking.mem_interior (p i) (some 0))
    · exact mem_insert_of_mem (RootedPacking.mem_interior (p i) none)
    · exact mem_insert_of_mem (RootedPacking.mem_interior (p i) (some 1))
  apply contains_paths G M z x hzx v hadj hinj (fun i => rfl) (fun i => rfl)
  intro i j hij
  apply Disjoint.mono (hins i) (hins j)
  apply Finset.disjoint_left.mpr
  intro w hw hw'
  rcases mem_insert.mp hw with rfl|hw
  · rcases mem_insert.mp hw' with he|hw'
    · exact hij (u.injective he)
    · exact Finset.disjoint_left.mp (hpZ j) hw' (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))
  · rcases mem_insert.mp hw' with rfl|hw'
    · exact Finset.disjoint_left.mp (hpZ i) hw (mem_union_right _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩))
    · exact Finset.disjoint_left.mp (hpdis hij) hw hw'

lemma rich4_neighbors_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (hf : (graph M).Free G) (z x : W) (hzx : z≠x) :
    ((neighbors G U z).filter (fun u => Rich4 G U t M u x)).card<M := by
  classical
  by_contra! hc
  obtain ⟨S,hS,hSc⟩ := exists_subset_card_eq hc
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hSc.symm)
  let u : Fin M ↪ W := ⟨fun i => e i,fun i j h => e.injective (Subtype.ext h)⟩
  exact hf (contains_of_rich4_neighbors G U t M z x hzx u
    (fun i => (mem_filter.mp (mem_filter.mp (hS (e i).property)).1).2)
    (fun i => (mem_filter.mp (hS (e i).property)).2))

end Erdos571.ThetaFive


/-! Four-path families and the lower-order count for rich endpoint pairs. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def fourGood (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) : Finset (ThetaFour.template.Copy G) := by
  classical
  exact (TreeCopiesIn.copies ThetaFour.template G U).filter (ThetaFour.GoodCopy G U t (2*M))

lemma mem_fourGood {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t M : ℕ} {f : ThetaFour.template.Copy G} : f∈fourGood G U t M ↔ ThetaFour.GoodCopy G U t (2*M) f := by
  classical
  simp only [fourGood,mem_filter,TreeCopiesIn.mem_copies]
  exact ⟨fun h => h.2,fun h => ⟨h.mem,h⟩⟩

noncomputable def fourRich (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) : Finset (ThetaFour.template.Copy G) :=
  (fourGood G U t M).filter (fun f => Rich4 G U t M (f (.inr 0)) (f (.inr 1)))

lemma threeWalks_upper (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D) :
    ((ShortSpider.threeWalks G U).card : ℝ)≤U.card*D^3 := by
  have hs : (∑e∈arcs G U, ((ShortSpider.fullArms G U e.2).card : ℝ))≤
      (arcs G U).card*D^2 := by
    simpa using sum_le_sum (s := arcs G U) (g := fun _ => D^2)
      (fun e he => ThetaFour.fullArms_upper G U hD hdeg (mem_arcs.mp he).2.1)
  have ha : ((arcs G U).card : ℝ)≤U.card*D := by
    rw [arcs_sum,Nat.cast_sum]
    exact (sum_le_sum hdeg).trans_eq (by simp)
  rw [ShortSpider.threeWalks_card,Nat.cast_sum]
  nlinarith [mul_le_mul_of_nonneg_right ha (sq_nonneg D)]

lemma fourRich_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (hf : (graph M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D) :
    ((fourRich G U t M).card : ℝ)≤M*U.card*D^3 := by
  classical
  let F := fourRich G U t M
  let pre (f : ThetaFour.template.Copy G) :=
    ((f (.inl (some 0)),f (.inl none)),(f (.inl (some 1)),f (.inr 1)))
  have hgood (f) (hf : f∈F) := mem_fourGood.mp (mem_filter.mp hf).1
  have hmap : Set.MapsTo pre (F : Set (ThetaFour.template.Copy G))
      (ShortSpider.threeWalks G U : Set ((W×W)×(W×W))) := by
    intro f hf
    exact ShortSpider.mem_threeWalks.mpr ⟨(hgood f hf).mem _,(hgood f hf).mem _,
      (hgood f hf).mem _,(hgood f hf).mem _,f.toHom.map_adj (by decide),
      f.toHom.map_adj (by decide),f.toHom.map_adj (by decide)⟩
  have hb := RealFiberCount.bound F (ShortSpider.threeWalks G U) pre hmap (D := (M : ℝ)) (by
    intro q hq
    by_cases hn : (F.filter (fun f => pre f=q)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
    obtain ⟨f₀,hf₀⟩ := hn
    have he₀ := (mem_filter.mp hf₀).2
    have hzx : q.1.1≠q.2.2 := by
      have h₁ := congrArg (fun q : (W×W)×(W×W) => q.1.1) he₀
      have h₂ := congrArg (fun q : (W×W)×(W×W) => q.2.2) he₀
      change f₀ (.inl (some 0))=q.1.1 at h₁
      change f₀ (.inr 1)=q.2.2 at h₂
      rw [←h₁,←h₂]
      exact f₀.injective.ne (by decide)
    have hc : (F.filter (fun f => pre f=q)).card≤
        ((neighbors G U q.1.1).filter (fun u => Rich4 G U t M u q.2.2)).card := by
      apply card_le_card_of_injOn (fun f => f (.inr 0))
      · intro f hf
        obtain ⟨hf,he⟩ := mem_filter.mp hf
        have h₁ := congrArg (fun q : (W×W)×(W×W) => q.1.1) he
        have h₂ := congrArg (fun q : (W×W)×(W×W) => q.2.2) he
        change f (.inl (some 0))=q.1.1 at h₁
        change f (.inr 1)=q.2.2 at h₂
        refine mem_filter.mpr ⟨mem_filter.mpr ⟨(hgood f hf).mem _,?_⟩,?_⟩
        · rw [←h₁]
          exact f.toHom.map_adj (by decide)
        · rw [←h₂]
          exact (mem_filter.mp hf).2
      · intro f hf f' hf' he
        have hh := (mem_filter.mp hf).2.trans (mem_filter.mp hf').2.symm
        apply Copy.ext
        intro v
        fin_cases v
        · exact congrArg (fun q : (W×W)×(W×W) => q.1.2) hh
        · exact congrArg (fun q : (W×W)×(W×W) => q.1.1) hh
        · exact congrArg (fun q : (W×W)×(W×W) => q.2.1) hh
        · exact he
        · exact congrArg (fun q : (W×W)×(W×W) => q.2.2) hh
    exact_mod_cast hc.trans (rich4_neighbors_bound G U t M hf q.1.1 q.2.2 hzx).le)
  have hc := threeWalks_upper G U hD hdeg
  nlinarith [mul_le_mul_of_nonneg_right hc (Nat.cast_nonneg M (α := ℝ))]

end Erdos571.ThetaFive


/-! Consecutive subpaths of the five-edge template and their good-copy conditions. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization

def threeEmb (j : Fin 3) : Fin 4 ↪ Vertex :=
  ⟨fun i => position ⟨j.val+i.val,by omega⟩,by
    intro a b h
    have hh := congrArg Fin.val (position_injective h)
    apply Fin.ext
    dsimp at hh
    omega⟩

def fourValue (j : Fin 2) (v : Option (Fin 2) ⊕ Fin 2) : Vertex :=
  position ⟨j.val+(ThetaFour.pathIndex v).val,by have := (ThetaFour.pathIndex v).isLt; omega⟩

lemma fourValue_injective (j : Fin 2) : Function.Injective (fourValue j) := by
  intro a b h
  apply ThetaFour.pathEquiv.injective
  have hh := congrArg Fin.val (position_injective h)
  apply Fin.ext
  dsimp [fourValue] at hh
  change (ThetaFour.pathIndex a).val=(ThetaFour.pathIndex b).val
  omega

def fourCopy (j : Fin 2) : ThetaFour.template.Copy template where
  toHom :=
    { toFun := fourValue j
      map_rel' := by
        intro a b hab
        fin_cases j <;> fin_cases a <;> fin_cases b <;>
          simp_all [ThetaFour.template,fourValue,ThetaFour.pathIndex,position,template,index,pathGraph_adj] }
  injective' := fourValue_injective j

variable {W : Type} [Fintype W] [DecidableEq W]

structure GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (f : template.Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light template G U t f
  three : ∀j : Fin 3, ¬Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3))
  four : ∀j : Fin 2, ¬Rich4 G U t M (f (fourCopy j (.inr 0))) (f (fourCopy j (.inr 1)))

lemma light_two (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : template.Copy G) (hl : ConnectedCopyBound.Light template G U t f)
    (u v w : Vertex) (huv : template.Adj u v) (hvw : template.Adj v w) (huw : u≠w) :
    ¬ShortSpider.Bad G U t (f u) (f w) := by
  rintro (he|hc)
  · exact huw (f.injective he)
  · exact (not_le_of_gt (hl u v w huv hvw huw)) hc

lemma fourCopy_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (f : template.Copy G) (hm : ∀v, f v∈U) (hl : ConnectedCopyBound.Light template G U t f)
    (hthree : ∀j : Fin 3, ¬Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3))) (j : Fin 2) :
    ThetaFour.GoodCopy G U t (2*M) (f.comp (fourCopy j)) := by
  refine ⟨fun v => hm _,?_,?_,?_,?_,?_⟩
  · apply light_two G U t f hl _ (fourCopy j (.inl (some 0))) _
    · exact (fourCopy j).toHom.map_adj (by decide)
    · exact (fourCopy j).toHom.map_adj (by decide)
    · exact (fourCopy j).injective.ne (by decide)
  · apply light_two G U t f hl _ (fourCopy j (.inl none)) _
    · exact (fourCopy j).toHom.map_adj (by decide)
    · exact (fourCopy j).toHom.map_adj (by decide)
    · exact (fourCopy j).injective.ne (by decide)
  · apply light_two G U t f hl _ (fourCopy j (.inl (some 1))) _
    · exact (fourCopy j).toHom.map_adj (by decide)
    · exact (fourCopy j).toHom.map_adj (by decide)
    · exact (fourCopy j).injective.ne (by decide)
  · have h := hthree j.castSucc
    fin_cases j <;> exact h
  · have h := hthree j.succ
    fin_cases j <;> exact h

lemma GoodCopy.four_good {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t M : ℕ}
    {f : template.Copy G} (h : GoodCopy G U t M f) (j : Fin 2) :
    ThetaFour.GoodCopy G U t (2*M) (f.comp (fourCopy j)) :=
  fourCopy_good G U t M f h.mem h.light h.three j

def vecThree (p : (W×W)×(W×W)) : Fin 4 → W := ![p.1.1,p.1.2,p.2.1,p.2.2]

lemma vecThree_injective : Function.Injective (vecThree (W := W)) := by
  intro p q h
  exact Prod.ext (Prod.ext (congrFun h 0) (congrFun h 1)) (Prod.ext (congrFun h 2) (congrFun h 3))

lemma rich_three_subpath_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (j : Fin 3) (F : Finset (template.Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light template G U t f)
    (hr : ∀f∈F, Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3))) :
    (F.card : ℝ)≤2*M*(D+t+1)*U.card*D^3 := by
  classical
  let R := ThetaFour.richWalks G U t (2*M)
  let B := R.image vecThree
  have hB : B.card=R.card := card_image_of_injective _ vecThree_injective
  have hmap (f) (hmem : f∈F) : (fun i => f (threeEmb j i))∈B := by
    let p := ((f (threeEmb j 0),f (threeEmb j 1)),(f (threeEmb j 2),f (threeEmb j 3)))
    refine mem_image.mpr ⟨p,?_,?_⟩
    · apply mem_filter.mpr
      refine ⟨mem_filter.mpr ⟨ShortSpider.mem_threeWalks.mpr ⟨hm f hmem _,hm f hmem _,hm f hmem _,hm f hmem _,?_,?_,?_⟩,?_,?_⟩,hr f hmem⟩
      · exact f.toHom.map_adj (by fin_cases j <;> decide)
      · exact f.toHom.map_adj (by fin_cases j <;> decide)
      · exact f.toHom.map_adj (by fin_cases j <;> decide)
      · apply light_two G U t f (hl f hmem) _ (threeEmb j 1) _
        all_goals fin_cases j <;> decide
      · apply light_two G U t f (hl f hmem) _ (threeEmb j 2) _
        all_goals fin_cases j <;> decide
    · funext i
      fin_cases i <;> rfl
  have hb := ConnectedCopyBound.restriction_bound template connected G U hD hdeg (threeEmb j) F B hm hmap
  rw [hB] at hb
  norm_num [Vertex] at hb
  have hr := richThree_bound G U t M hM hD hdeg g hg hf
  have hh := mul_le_mul_of_nonneg_right hr (sq_nonneg D)
  change (F.card : ℝ)≤_
  dsimp [R] at hb
  nlinarith

lemma rich_four_subpath_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (hf : (graph M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (j : Fin 2) (F : Finset (template.Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light template G U t f)
    (hthree : ∀f∈F, ∀j : Fin 3, ¬Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3)))
    (hr : ∀f∈F, Rich4 G U t M (f (fourCopy j (.inr 0))) (f (fourCopy j (.inr 1)))) :
    (F.card : ℝ)≤M*U.card*D^4 := by
  classical
  have hb := ConnectedCopyBound.copy_restriction_bound template connected ThetaFour.template (fourCopy j)
    G U hD hdeg F (fourRich G U t M) hm (by
      intro f hmem
      exact mem_filter.mpr ⟨mem_fourGood.mpr (fourCopy_good G U t M f (hm f hmem) (hl f hmem) (hthree f hmem) j),hr f hmem⟩)
  norm_num [Vertex] at hb
  have hr := fourRich_bound G U t M hf hD hdeg
  nlinarith [mul_le_mul_of_nonneg_right hr hD]

end Erdos571.ThetaFive


/-! Bounded root fibers for five-paths whose proper subpaths are light and nonrich. -/
set_option maxHeartbeats 4000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def threeThreshold (t M : ℕ) : ℕ := (3*(2*M)+2)*(2*t)
def fiveLoad (t M : ℕ) : ℕ := 4*(fourThreshold t M+t*threeThreshold t M)

lemma four_pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r s : Fin 2 → W) (j : Fin 2)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hs : ∀f∈F, ∀a, f (fourCopy j (.inr a))=s a) : F.card≤fourThreshold t M := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  have hb : (fourFiber G U t M (s 0) (s 1)).card≤fourThreshold t M := by
    have h := (hg f₀ hf₀).four j
    rw [hs f₀ hf₀,hs f₀ hf₀] at h
    exact le_of_not_gt h
  apply le_trans _ hb
  apply card_le_card_of_injOn (fun f => f.comp (fourCopy j))
  · intro f hf
    exact mem_fourFiber.mpr ⟨(hg f hf).four_good j,hs f hf 0,hs f hf 1⟩
  · intro f hf f' hf' he
    apply Copy.ext
    intro v
    have hcover : (∃a : Fin 2, v=.inr a) ∨ ∃a, fourCopy j a=v := by
      have h : ∀(k : Fin 2) (w : Vertex), (∃a : Fin 2, w=.inr a) ∨ ∃a, fourCopy k a=w := by decide
      exact h j v
    rcases hcover with ⟨a,rfl⟩|⟨a,rfl⟩
    · exact (hr f hf a).trans (hr f' hf' a).symm
    · exact congrArg (fun f : ThetaFour.template.Copy G => f a) he

lemma middle_left_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W) (w : W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (.inl 1)=w) : F.card≤t*threeThreshold t M := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  let A := FourthMoment.common G U (r 0) w
  let B := ThetaFour.threeFiber G U t w (r 1)
  have hA : A.card≤t := by
    have h := light_two G U t f₀ (hg f₀ hf₀).light (.inr 0) (.inl 0) (.inl 1) (by decide) (by decide) (by decide)
    rw [hr f₀ hf₀,hw f₀ hf₀] at h
    exact (lt_of_not_ge (fun hc => h (Or.inr hc))).le
  have hB : B.card≤threeThreshold t M := by
    have h := (hg f₀ hf₀).three 2
    change ¬Rich3 G U t M (f₀ (.inl 1)) (f₀ (.inr 1)) at h
    rw [hr f₀ hf₀,hw f₀ hf₀] at h
    exact le_of_not_gt h
  have hc : F.card≤(A×ˢB).card := by
    apply card_le_card_of_injOn (fun f => (f (.inl 0),(f (.inl 2),f (.inl 3))))
    · intro f hf
      have hh := hg f hf
      apply mem_product.mpr
      constructor
      · apply mem_filter.mpr
        refine ⟨hh.mem _,?_,?_⟩
        · rw [←hr f hf]; exact f.toHom.map_adj (by decide)
        · rw [←hw f hf]; exact f.toHom.map_adj (by decide)
      · rw [show B=ThetaFour.threeFiber G U t w (r 1) from rfl,←hr f hf,←hw f hf]
        apply ThetaFour.mem_threeFiber.mpr
        refine ⟨hh.mem _,hh.mem _,hh.mem _,hh.mem _,f.toHom.map_adj (by decide),
          f.toHom.map_adj (by decide),f.toHom.map_adj (by decide),?_,?_⟩
        · exact light_two G U t f hh.light (.inl 1) (.inl 2) (.inl 3) (by decide) (by decide) (by decide)
        · exact light_two G U t f hh.light (.inl 2) (.inl 3) (.inr 1) (by decide) (by decide) (by decide)
    · intro f hf f' hf' he
      apply Copy.ext
      intro v
      fin_cases v
      · exact congrArg Prod.fst he
      · exact (hw f hf).trans (hw f' hf').symm
      · exact congrArg (fun p : W×(W×W) => p.2.1) he
      · exact congrArg (fun p : W×(W×W) => p.2.2) he
      · exact (hr f hf 0).trans (hr f' hf' 0).symm
      · exact (hr f hf 1).trans (hr f' hf' 1).symm
  rw [card_product] at hc
  exact hc.trans (Nat.mul_le_mul hA hB)

lemma middle_right_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W) (w : W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (.inl 2)=w) : F.card≤t*threeThreshold t M := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hn
  let A := ThetaFour.threeFiber G U t (r 0) w
  let B := FourthMoment.common G U w (r 1)
  have hB : B.card≤t := by
    have h := light_two G U t f₀ (hg f₀ hf₀).light (.inl 2) (.inl 3) (.inr 1) (by decide) (by decide) (by decide)
    rw [hr f₀ hf₀,hw f₀ hf₀] at h
    exact (lt_of_not_ge (fun hc => h (Or.inr hc))).le
  have hA : A.card≤threeThreshold t M := by
    have h := (hg f₀ hf₀).three 0
    change ¬Rich3 G U t M (f₀ (.inr 0)) (f₀ (.inl 2)) at h
    rw [hr f₀ hf₀,hw f₀ hf₀] at h
    exact le_of_not_gt h
  have hc : F.card≤(A×ˢB).card := by
    apply card_le_card_of_injOn (fun f => ((f (.inl 0),f (.inl 1)),f (.inl 3)))
    · intro f hf
      have hh := hg f hf
      apply mem_product.mpr
      constructor
      · rw [show A=ThetaFour.threeFiber G U t (r 0) w from rfl,←hr f hf,←hw f hf]
        apply ThetaFour.mem_threeFiber.mpr
        refine ⟨hh.mem _,hh.mem _,hh.mem _,hh.mem _,f.toHom.map_adj (by decide),
          f.toHom.map_adj (by decide),f.toHom.map_adj (by decide),?_,?_⟩
        · exact light_two G U t f hh.light (.inr 0) (.inl 0) (.inl 1) (by decide) (by decide) (by decide)
        · exact light_two G U t f hh.light (.inl 0) (.inl 1) (.inl 2) (by decide) (by decide) (by decide)
      · apply mem_filter.mpr
        refine ⟨hh.mem _,?_,?_⟩
        · rw [←hw f hf]; exact f.toHom.map_adj (by decide)
        · rw [←hr f hf]; exact f.toHom.map_adj (by decide)
    · intro f hf f' hf' he
      apply Copy.ext
      intro v
      fin_cases v
      · exact congrArg (fun p : (W×W)×W => p.1.1) he
      · exact congrArg (fun p : (W×W)×W => p.1.2) he
      · exact (hw f hf).trans (hw f' hf').symm
      · exact congrArg Prod.snd he
      · exact (hr f hf 0).trans (hr f' hf' 0).symm
      · exact (hr f hf 1).trans (hr f' hf' 1).symm
  rw [card_product] at hc
  exact hc.trans (by nlinarith [Nat.mul_le_mul hA hB])

lemma pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W) (w : W) (i : Fin 4)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (.inl i)=w) : F.card≤fourThreshold t M+t*threeThreshold t M := by
  fin_cases i
  · apply le_trans (four_pinned_count G U t M F r ![w,r 1] 1 hg hr ?_) (Nat.le_add_right _ _)
    intro f hf a
    fin_cases a
    · exact hw f hf
    · exact hr f hf 1
  · exact (middle_left_count G U t M F r w hg hr hw).trans (Nat.le_add_left _ _)
  · exact (middle_right_count G U t M F r w hg hr hw).trans (Nat.le_add_left _ _)
  · apply le_trans (four_pinned_count G U t M F r ![r 0,w] 0 hg hr ?_) (Nat.le_add_right _ _)
    intro f hf a
    fin_cases a
    · exact hr f hf 0
    · exact hw f hf

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 2 → W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤fiveLoad t M := by
  classical
  let A (i : Fin 4) := F.filter (fun f => f (.inl i)=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨i,hi⟩ := hw
    exact mem_biUnion.mpr ⟨i,mem_univ _,mem_filter.mpr ⟨hf,hi⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hsub
    _ ≤ ∑i : Fin 4, (A i).card := card_biUnion_le
    _ ≤ ∑_i : Fin 4, (fourThreshold t M+t*threeThreshold t M) := sum_le_sum (fun i hi =>
      pinned_count G U t M (A i) r w i (fun f hf => hg f (mem_filter.mp hf).1)
        (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by simp [fiveLoad,mul_comm]

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1≤t) (hf : (graph M).Free G) (F : Finset (template.Copy G)) (r : Fin 2 ↪ W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a) :
    F.card<4*M*fiveLoad t M := by
  classical
  by_contra! hc
  have hB : 0<fiveLoad t M := by dsimp [fiveLoad,fourThreshold,fourLoad]; positivity
  have hh := RootedPacking.power_contained_of_bounded_load F id r hr (fiveLoad t M) M hB
    (interior_load G U t M F r hg hr) (by simpa [mul_comm M 4] using hc)
  rw [power_eq] at hh
  exact hf hh

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1≤t) (hf : (graph M).Free G) (F : Finset (template.Copy G))
    (hg : ∀f∈F, GoodCopy G U t M f) : F.card≤4*M*fiveLoad t M*U.card^2 := by
  classical
  let roots : template.Copy G → Fin 2 → W := fun f a => f (.inr a)
  have hb (r : Fin 2 → W) : (F.filter (fun f => roots f=r)).card≤4*M*fiveLoad t M := by
    by_cases hn : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hn
    have hi : Function.Injective r := by
      rw [←(mem_filter.mp hf₀).2]
      exact f₀.injective.comp Sum.inr_injective
    exact (rooted_count G U t M ht hf _ ⟨r,hi⟩ (fun f hf => hg f (mem_filter.mp hf).1)
      (fun f hf a => congrFun (mem_filter.mp hf).2 a)).le
  have hc := card_le_mul_card_image F (4*M*fiveLoad t M) (fun r hr => hb r)
  have hi : (F.image roots).card≤U.card^2 := by
    let v : (F.image roots) → Fin 2 → U := fun r a => ⟨r.val a,by
      obtain ⟨f,hf,he⟩ := mem_image.mp r.property
      rw [←he]
      exact (hg f hf).mem _⟩
    have hv : Function.Injective v := by
      intro r s h
      apply Subtype.ext
      funext a
      exact congrArg Subtype.val (congrFun h a)
    have hh := Fintype.card_le_of_injective v hv
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using hh
  exact hc.trans (Nat.mul_le_mul_left _ hi)

end Erdos571.ThetaFive


/-! All theta-five template copies: good root fibers plus lower-order errors. -/
set_option maxHeartbeats 4000000
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def heavyThreshold (M : ℕ) : ℕ := (M+1)*M+(M+1)+M+1

noncomputable def heavyExponent (M : ℕ) : ℝ := 2-1/(M : ℝ)
def heavyCoefficient (M : ℕ) : ℝ := 2*((M : ℝ)+1)+((M : ℝ)+1)

lemma all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card : ℝ)≤D)
    (F : Finset (template.Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card : ℝ)≤(4*M*fiveLoad (heavyThreshold M) M : ℕ)*(U.card : ℝ)^2+
      216*U.card*(D+2*heavyCoefficient M*D^(heavyExponent M))*D^3+
      6*M*(D+heavyThreshold M+1)*U.card*D^3+2*M*U.card*D^4 := by
  classical
  let t := heavyThreshold M
  let A := F.filter (GoodCopy G U t M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light template G U t f)
  let C (j : Fin 3) := F.filter (fun f => ConnectedCopyBound.Light template G U t f ∧
    Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3)))
  let E (j : Fin 2) := F.filter (fun f => ConnectedCopyBound.Light template G U t f ∧
    (∀j : Fin 3, ¬Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3))) ∧
    Rich4 G U t M (f (fourCopy j (.inr 0))) (f (fourCopy j (.inr 1))))
  have hsub : F⊆A ∪ B ∪ univ.biUnion C ∪ univ.biUnion E := by
    intro f hmem
    by_cases hl : ConnectedCopyBound.Light template G U t f
    swap
    · exact mem_union_left _ (mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hmem,hl⟩)))
    by_cases hthree : ∀j : Fin 3, ¬Rich3 G U t M (f (threeEmb j 0)) (f (threeEmb j 3))
    swap
    · simp only [not_forall,not_not] at hthree
      obtain ⟨j,hj⟩ := hthree
      exact mem_union_left _ (mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨hmem,hl,hj⟩⟩))
    by_cases hfour : ∀j : Fin 2, ¬Rich4 G U t M (f (fourCopy j (.inr 0))) (f (fourCopy j (.inr 1)))
    swap
    · simp only [not_forall,not_not] at hfour
      obtain ⟨j,hj⟩ := hfour
      exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨hmem,hl,hthree,hj⟩⟩)
    exact mem_union_left _ (mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hmem,hm f hmem,hl,hthree,hfour⟩)))
  have hA : (A.card : ℝ)≤(4*M*fiveLoad t M : ℕ)*(U.card : ℝ)^2 := by
    exact_mod_cast good_count G U t M (by dsimp [t,heavyThreshold]; omega) hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card : ℝ)≤216*U.card*(D+2*heavyCoefficient M*D^(heavyExponent M))*D^3 := by
    have hb := ConnectedCopyBound.nonlight_bound template connected G U t hD hdeg B
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    norm_num [Vertex] at hb
    have hmass := ThetaFour.badPairs_sum_bound G U t hdeg
    have hh := ShortSpider.heavy_sum_bound G U M (M+1) hM (by omega) (spider_free M hf) hD hdeg
    push_cast at hh
    change (∑v∈U, ((ProjectionHeavy.heavyPairs (arcs G U) U t (neighbors G U v)).card : ℝ))≤
      U.card*(2*heavyCoefficient M*D^(heavyExponent M)) at hh
    have hmass' : (∑v∈U, ((ShortSpider.badPairs G U t v).card : ℝ))≤
        U.card*(D+2*heavyCoefficient M*D^(heavyExponent M)) := by linarith
    nlinarith [mul_le_mul_of_nonneg_right hmass' (show 0≤216*D^3 by positivity)]
  have hC : ((univ.biUnion C).card : ℝ)≤6*M*(D+t+1)*U.card*D^3 := by
    have hc : ((univ.biUnion C).card : ℝ)≤∑j : Fin 3, ((C j).card : ℝ) := by exact_mod_cast card_biUnion_le
    have hh : (∑j : Fin 3, ((C j).card : ℝ))≤∑_j : Fin 3, (2*(M : ℝ)*(D+t+1)*U.card*D^3) :=
      sum_le_sum (fun j hj => rich_three_subpath_count G U t M hM g hg hf hD hdeg j (C j)
        (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2.1)
        (fun f hf => (mem_filter.mp hf).2.2))
    simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,Nat.cast_ofNat] at hh
    nlinarith
  have hE : ((univ.biUnion E).card : ℝ)≤2*M*U.card*D^4 := by
    have hc : ((univ.biUnion E).card : ℝ)≤∑j : Fin 2, ((E j).card : ℝ) := by exact_mod_cast card_biUnion_le
    have hh : (∑j : Fin 2, ((E j).card : ℝ))≤∑_j : Fin 2, ((M : ℝ)*U.card*D^4) :=
      sum_le_sum (fun j hj => rich_four_subpath_count G U t M hf hD hdeg j (E j)
        (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2.1)
        (fun f hf => (mem_filter.mp hf).2.2.1) (fun f hf => (mem_filter.mp hf).2.2.2))
    simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,Nat.cast_ofNat] at hh
    linarith
  have hc := (card_le_card hsub).trans ((card_union_le _ _).trans
    (Nat.add_le_add_right ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _)) _))
  have hc' : (F.card : ℝ)≤A.card+B.card+(univ.biUnion C).card+(univ.biUnion E).card := by exact_mod_cast hc
  dsimp [t] at hA hC
  linarith

end Erdos571.ThetaFive


/-! Absorbing the lower-degree error terms for theta-five. -/
namespace Erdos571.ThetaFive
open Filter Asymptotics

lemma heavyExponent_lt (M : ℕ) (hM : 1≤M) : heavyExponent M<2 := by
  have hpos : (0 : ℝ)<M := by exact_mod_cast (show 0<M by omega)
  dsimp [heavyExponent]
  linarith [one_div_pos.mpr hpos]

lemma exists_error_threshold (Q C α : ℝ) (M t : ℕ) (hQ : 1≤Q) (hα : α<2) :
    ∃L : ℝ, 28≤L ∧ ∀d : ℝ, L≤d →
      216*(Q*d+2*C*(Q*d)^α)*(Q*d)^3+
        6*M*(Q*d+t+1)*(Q*d)^3+2*M*(Q*d)^4≤(d/4)^5/2 := by
  let A : ℝ := (216+8*M)*Q^4
  let B : ℝ := 6*M*(t+1)*Q^3
  let E : ℝ := 432*C*Q^(α+3)
  have ho : (fun d : ℝ => A*d^(4 : ℝ)+B*d^(3 : ℝ)+E*d^(α+3))=o[atTop]
      (fun d : ℝ => d^(5 : ℝ)) :=
    (((ThetaFour.rpow_littleO (by norm_num : (4 : ℝ)<5)).const_mul_left A).add
      ((ThetaFour.rpow_littleO (by norm_num : (3 : ℝ)<5)).const_mul_left B)).add
      ((ThetaFour.rpow_littleO (by linarith : α+3<5)).const_mul_left E)
  obtain ⟨L,hL⟩ := eventually_atTop.mp (ho.def (c := 1/(2*4^5)) (by norm_num))
  refine ⟨max 28 L,le_max_left _ _,?_⟩
  intro d hd
  have hd0 : 0<d := lt_of_lt_of_le (by norm_num : (0 : ℝ)<28) ((le_max_left _ _).trans hd)
  have hQ0 : 0<Q := by linarith
  have h := hL d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hd0.le _)] at h
  have hh := (le_abs_self (A*d^(4 : ℝ)+B*d^(3 : ℝ)+E*d^(α+3))).trans h
  have he : 216*(Q*d+2*C*(Q*d)^α)*(Q*d)^3+
      6*M*(Q*d+t+1)*(Q*d)^3+2*M*(Q*d)^4=
      A*d^(4 : ℝ)+B*d^(3 : ℝ)+E*d^(α+3) := by
    dsimp [A,B,E]
    rw [Real.rpow_add hQ0,Real.rpow_add hd0]
    norm_num only [Real.rpow_ofNat,Real.rpow_natCast]
    rw [Real.mul_rpow hQ0.le hd0.le]
    ring
  rw [he]
  convert hh using 1
  norm_num only [Real.rpow_ofNat,Real.rpow_natCast]
  ring

lemma degree_of_power {n d A : ℝ} (hn : 0≤n) (hd : 0≤d) (hA : 0≤A)
    (h : d^5≤A*n) : d≤A^(1/5 : ℝ)*n^(1/5 : ℝ) := by
  have hh := Real.rpow_le_rpow (show 0≤d^5 by positivity) h (by norm_num : (0 : ℝ)≤1/5)
  rw [Real.mul_rpow hA hn] at hh
  have he : (d^5)^(1/5 : ℝ)=d := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hd]
    norm_num
  rwa [he] at hh

end Erdos571.ThetaFive


/-! Sharp ordinary upper bounds for theta graphs with five-edge branches. -/
namespace Erdos571.ThetaFive
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeCoefficient (M : ℕ) : ℝ :=
  ((2*4^5*(4*M*fiveLoad (heavyThreshold M) M) : ℕ) : ℝ)^(1/5 : ℝ)

lemma degreeCoefficient_nonneg (M : ℕ) : 0≤degreeCoefficient M := by
  unfold degreeCoefficient
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (M : ℕ) (hM : 1≤M) (hf : (graph M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 28≤d)
    (herr : 216*(Q*d+2*heavyCoefficient M*(Q*d)^(heavyExponent M))*(Q*d)^3+
      6*M*(Q*d+heavyThreshold M+1)*(Q*d)^3+2*M*(Q*d)^4≤(d/4)^5/2)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) :
    d≤degreeCoefficient M*(U.card : ℝ)^(1/5 : ℝ) := by
  classical
  have hd0 : 0≤d := by linarith
  have hD : 0≤Q*d := by positivity
  have hn : (0 : ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  let F := TreeCopiesIn.copies template G U
  have hl : (U.card : ℝ)*(d/4)^5≤F.card := by
    have hh := TreeCopiesIn.lower template isTree G U (d := d) (by norm_num [Vertex]; exact hd)
      (fun v hv => (hdeg v hv).1)
    simpa [Vertex] using hh
  have hu := all_count G U M hM g hg hf hD (fun v hv => (hdeg v hv).2) F
    (fun f hf => (TreeCopiesIn.mem_copies template G U f).mp hf)
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (d/4)^5≤2*(4*M*fiveLoad (heavyThreshold M) M : ℕ)*(U.card : ℝ) := by
    apply (mul_le_mul_iff_right₀ hn).mp
    nlinarith
  have hpower : d^5≤((2*4^5*(4*M*fiveLoad (heavyThreshold M) M) : ℕ) : ℝ)*U.card := by
    norm_num only [div_pow] at hm
    push_cast
    norm_num at hm ⊢
    nlinarith
  exact degree_of_power hn.le hd0 (by positivity) hpower

/-- Every fixed almost-regular degree ratio admits the sharp exponent. -/
theorem exists_regular_bound (M : ℕ) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj)
        (g : W → Bool), (∀{u v}, G.Adj u v → g u≠g v) → (graph M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(6/5:ℝ) := by
  obtain ⟨L,hL,herr⟩ := exists_error_threshold Q (heavyCoefficient M) (heavyExponent M) M (heavyThreshold M) hQ (heavyExponent_lt M hM)
  let B := degreeCoefficient M
  have hB : 0 ≤ B := degreeCoefficient_nonneg M
  refine ⟨Q*(L+B),by positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^(1/5:ℝ) := Real.one_le_rpow hn1 (by norm_num)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^(1/5:ℝ) := by
    by_cases hdl : d ≤ L
    · nlinarith
    · have hl := large_degree_bound G U hU M hM hf g hg hQ (hL.trans (le_of_not_ge hdl)) (herr d (le_of_not_ge hdl)) hdeg
      have hnn : 0 ≤ (U.card:ℝ)^(1/5:ℝ) := by positivity
      change d ≤ B*_ at hl
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^(1/5:ℝ)) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [show (6/5:ℝ)=1+1/5 by norm_num,Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp upper bound for every fixed theta-five multiplicity. -/
theorem edge_bound (M : ℕ) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph M) (6/5:ℝ) D := by
  let γ : ℝ := 1/5
  have hγ : 0 < γ := by norm_num [γ]
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((6/5:ℝ)-1) := by
    dsimp [K]
    rw [show (6/5:ℝ)-1=γ by norm_num [γ],Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound M hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=6/5) (K:=K) (D:=D)
    (by norm_num) (by norm_num) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.ThetaFive


/-! Exact rational exponents from theta-five and its paired cones. -/
namespace Erdos571.ThetaFive
open Finset SimpleGraph OrdinaryRooted

theorem supported : Supported template (2-(4:ℝ)/5) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound M (by omega)
  norm_num
  exact ⟨D,hD,hbound⟩

theorem certificate : Certificate 4 5 :=
  ⟨Fin 4,Fin 2,inferInstance,inferInstance,inferInstance,inferInstance,
    template,color,color_proper,connected,no_isolated,balance,supported⟩

theorem iterated_certificate (t : ℕ) : Certificate 4 (5+4*t) := by
  induction t with
  | zero => simpa using certificate
  | succ t ih =>
    have h := ih.cone (by omega) (by omega)
    convert h using 1 <;> omega

/-- The theta-five family includes the exact exponent `6/5`. -/
theorem exact_family (t : ℕ) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-4/(5+4*t:ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate t).realizes (by omega) (by omega)
  push_cast at h ⊢
  exact h

theorem exponent_six_fifths :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((6/5:ℚ):ℝ)) := by
  have h := exact_family 0
  norm_num at h ⊢
  exact h

end Erdos571.ThetaFive


/-! A second-moment bound allowing a bounded number of exceptional partners. -/
namespace Erdos571.ConflictedIncidence
open Finset
variable {L R : Type*} [DecidableEq L] [DecidableEq R]

def edges (A : Finset L) (B : Finset R) (E : L → R → Prop) [DecidableRel E] : Finset (L×R) :=
  (A×ˢB).filter (fun p => E p.1 p.2)

def common (A : Finset L) (E : L → R → Prop) [DecidableRel E] (r s : R) : Finset L :=
  A.filter (fun x => E x r ∧ E x s)

lemma moment (A : Finset L) (B : Finset R) (E : L → R → Prop) [DecidableRel E] :
    (∑x∈A, (B.filter (E x)).card^2) = ∑p∈B×ˢB, (common A E p.1 p.2).card := by
  have h := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
    (s := B×ˢB) (t := A) (fun p x => E x p.1 ∧ E x p.2)
  change (∑p∈B×ˢB, (common A E p.1 p.2).card) = _ at h
  rw [h]
  apply sum_congr rfl
  intro x hx
  simp only [bipartiteBelow,filter_product,card_product,pow_two]

lemma card_edges (A : Finset L) (B : Finset R) (E : L → R → Prop) [DecidableRel E] :
    (edges A B E).card = ∑x∈A, (B.filter (E x)).card := by
  simp only [edges,card_filter,sum_product]

lemma moment_bound (A : Finset L) (B : Finset R) (E : L → R → Prop) [DecidableRel E]
    (C : R → R → Prop) [DecidableRel C] (m c : ℕ)
    (hC : ∀r∈B, (B.filter (C r)).card ≤ c)
    (hE : ∀r∈B, ∀s∈B, ¬C r s → (common A E r s).card ≤ m) :
    (∑x∈A, (B.filter (E x)).card^2) ≤ m*B.card^2+A.card*B.card*c := by
  rw [moment,sum_product]
  have hpoint (r) (hr : r∈B) (s) (hs : s∈B) :
      (common A E r s).card ≤ m+if C r s then A.card else 0 := by
    by_cases h : C r s
    · simp only [h,ite_true]
      exact (card_le_card (filter_subset _ _)).trans (Nat.le_add_left _ _)
    · simpa only [h,ite_false,add_zero] using hE r hr s hs h
  calc
    _ ≤ ∑r∈B, ∑s∈B, (m+if C r s then A.card else 0) :=
      sum_le_sum (fun r hr => sum_le_sum (fun s hs => hpoint r hr s hs))
    _ = m*B.card^2+A.card*∑r∈B, (B.filter (C r)).card := by
      simp only [sum_add_distrib,sum_const,nsmul_eq_mul,← sum_filter]
      rw [← sum_mul]
      simp only [Nat.cast_id]
      ring
    _ ≤ _ := by
      have hs : (∑r∈B, (B.filter (C r)).card) ≤ B.card*c := by
        simpa using sum_le_sum (fun r hr => hC r hr)
      nlinarith [Nat.mul_le_mul_left A.card hs]

theorem square_bound (A : Finset L) (B : Finset R) (E : L → R → Prop) [DecidableRel E]
    (C : R → R → Prop) [DecidableRel C] (m c : ℕ)
    (hC : ∀r∈B, (B.filter (C r)).card ≤ c)
    (hE : ∀r∈B, ∀s∈B, ¬C r s → (common A E r s).card ≤ m) :
    ((edges A B E).card:ℝ)^2 ≤
      A.card*((m:ℝ)*(B.card:ℝ)^2+A.card*B.card*c) := by
  have hm : (∑x∈A, ((B.filter (E x)).card:ℝ)^2) ≤
      (m:ℝ)*(B.card:ℝ)^2+A.card*B.card*c := by
    exact_mod_cast moment_bound A B E C m c hC hE
  have hc := sq_sum_le_card_mul_sum_sq (s := A) (f := fun x => ((B.filter (E x)).card:ℝ))
  have he : (∑x∈A, ((B.filter (E x)).card:ℝ))=(edges A B E).card := by
    exact_mod_cast (card_edges A B E).symm
  rw [he] at hc
  exact hc.trans (mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg _))

end Erdos571.ConflictedIncidence


/-! Local boxes of root pairs: intersecting pairs are the only exceptions. -/
namespace Erdos571.ConflictedBox
open Finset
variable {W : Type*} [DecidableEq W]

def Conflict (p q : W×W) : Prop := p.1=q.1 ∨ p.1=q.2 ∨ p.2=q.1 ∨ p.2=q.2
instance : DecidableRel (Conflict (W := W)) := fun _ _ => inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ _))

lemma conflict_bound (Y Z : Finset W) (p : W×W) :
    ((Y×ˢZ).filter (Conflict p)).card ≤ 2*(Y.card+Z.card) := by
  let P : Finset W := {p.1,p.2}
  have hP : P.card ≤ 2 := card_le_two
  have hsub : (Y×ˢZ).filter (Conflict p) ⊆ (P×ˢZ) ∪ (Y×ˢP) := by
    intro q hq
    obtain ⟨⟨hy,hz⟩,h⟩ := (show (q.1∈Y ∧ q.2∈Z) ∧ Conflict p q from
      ⟨mem_product.mp (mem_filter.mp hq).1,(mem_filter.mp hq).2⟩)
    rcases h with h|h|h|h
    · exact mem_union_left _ (mem_product.mpr ⟨by simp [P,h],hz⟩)
    · exact mem_union_right _ (mem_product.mpr ⟨hy,by simp [P,h]⟩)
    · exact mem_union_left _ (mem_product.mpr ⟨by simp [P,h],hz⟩)
    · exact mem_union_right _ (mem_product.mpr ⟨hy,by simp [P,h]⟩)
  calc
    _ ≤ ((P×ˢZ) ∪ (Y×ˢP)).card := card_le_card hsub
    _ ≤ (P×ˢZ).card+(Y×ˢP).card := card_union_le _ _
    _ = P.card*Z.card+Y.card*P.card := by rw [card_product,card_product]
    _ ≤ 2*Z.card+Y.card*2 := Nat.add_le_add (Nat.mul_le_mul_right _ hP) (Nat.mul_le_mul_left _ hP)
    _ = _ := by ring

theorem square_bound (A Y Z : Finset W) (E : W → W×W → Prop) [DecidableRel E]
    (m : ℕ) (hE : ∀p∈Y×ˢZ, ∀q∈Y×ˢZ, ¬Conflict p q →
      (ConflictedIncidence.common A E p q).card ≤ m)
    {D : ℝ} (hD : 0≤D) (hA : (A.card:ℝ)≤D) (hY : (Y.card:ℝ)≤D) (hZ : (Z.card:ℝ)≤D) :
    ((ConflictedIncidence.edges A (Y×ˢZ) E).card:ℝ)^2 ≤ ((m:ℝ)+4)*D^5 := by
  have h := ConflictedIncidence.square_bound A (Y×ˢZ) E Conflict m (2*(Y.card+Z.card))
    (fun p _ => conflict_bound Y Z p) hE
  rw [card_product] at h
  push_cast at h
  have hB : (Y.card:ℝ)*Z.card≤D^2 := by nlinarith [mul_le_mul hY hZ (Nat.cast_nonneg _) hD]
  have hC : 2*((Y.card:ℝ)+Z.card)≤4*D := by linarith
  calc
    _ ≤ A.card*((m:ℝ)*((Y.card:ℝ)*Z.card)^2+A.card*((Y.card:ℝ)*Z.card)*(2*((Y.card:ℝ)+Z.card))) := h
    _ ≤ D*((m:ℝ)*(D^2)^2+D*(D^2)*(4*D)) := by gcongr
    _ = _ := by ring

theorem bound (A Y Z : Finset W) (E : W → W×W → Prop) [DecidableRel E]
    (m : ℕ) (hE : ∀p∈Y×ˢZ, ∀q∈Y×ˢZ, ¬Conflict p q →
      (ConflictedIncidence.common A E p q).card ≤ m)
    {D : ℝ} (hD : 0≤D) (hA : (A.card:ℝ)≤D) (hY : (Y.card:ℝ)≤D) (hZ : (Z.card:ℝ)≤D) :
    ((ConflictedIncidence.edges A (Y×ˢZ) E).card:ℝ) ≤ Real.sqrt ((m:ℝ)+4)*D^2*Real.sqrt D := by
  have h := square_bound A Y Z E m hE hD hA hY hZ
  have he : (Real.sqrt ((m:ℝ)+4)*D^2*Real.sqrt D)^2=((m:ℝ)+4)*D^5 := by
    rw [mul_pow,mul_pow,Real.sq_sqrt (by positivity),Real.sq_sqrt hD]
    ring
  have hn : 0≤Real.sqrt ((m:ℝ)+4)*D^2*Real.sqrt D := by positivity
  nlinarith [sq_nonneg (((ConflictedIncidence.edges A (Y×ˢZ) E).card:ℝ)-Real.sqrt ((m:ℝ)+4)*D^2*Real.sqrt D)]

end Erdos571.ConflictedBox


/-! A symmetric rooted tree with seven nonroots and eleven edges. -/
set_option maxHeartbeats 4000000
set_option maxRecDepth 10000
set_option synthInstance.maxSize 4096
namespace Erdos571.MirrorSpider
open Finset SimpleGraph RootedSunflower

abbrev Vertex := Fin 7 ⊕ Fin 5

def parent : Fin 11 → Vertex :=
  ![.inl 0,.inl 0,.inl 0,.inl 1,.inl 1,.inl 2,.inl 2,.inl 3,.inl 4,.inl 5,.inl 6]

def child : Fin 11 → Vertex :=
  ![.inl 1,.inl 2,.inr 0,.inl 3,.inl 4,.inl 5,.inl 6,.inr 1,.inr 2,.inr 3,.inr 4]

def template : SimpleGraph Vertex where
  Adj u v := ∃i, (u=parent i ∧ v=child i) ∨ (u=child i ∧ v=parent i)
  symm := by rintro u v ⟨i,h|h⟩ <;> exact ⟨i,by tauto⟩
  loopless := by
    intro u
    have h : ∀v : Vertex, ¬(∃i, (v=parent i ∧ v=child i) ∨ (v=child i ∧ v=parent i)) := by decide
    exact h u

instance : DecidableRel template.Adj := fun u v => inferInstanceAs
  (Decidable (∃i, (u=parent i ∧ v=child i) ∨ (u=child i ∧ v=parent i)))

lemma edge_adj (i : Fin 11) : template.Adj (parent i) (child i) := ⟨i,Or.inl ⟨rfl,rfl⟩⟩

lemma connected : template.Connected := by
  have h1 : template.Reachable (.inl 1) (.inl 0) := (edge_adj 0).symm.reachable
  have h2 : template.Reachable (.inl 2) (.inl 0) := (edge_adj 1).symm.reachable
  have h3 : template.Reachable (.inl 3) (.inl 0) := (edge_adj 3).symm.reachable.trans h1
  have h4 : template.Reachable (.inl 4) (.inl 0) := (edge_adj 4).symm.reachable.trans h1
  have h5 : template.Reachable (.inl 5) (.inl 0) := (edge_adj 5).symm.reachable.trans h2
  have h6 : template.Reachable (.inl 6) (.inl 0) := (edge_adj 6).symm.reachable.trans h2
  have hreach (v : Vertex) : template.Reachable v (.inl 0) := by
    fin_cases v
    · exact Reachable.rfl
    · exact h1
    · exact h2
    · exact h3
    · exact h4
    · exact h5
    · exact h6
    · exact (edge_adj 2).symm.reachable
    · exact (edge_adj 7).symm.reachable.trans h3
    · exact (edge_adj 8).symm.reachable.trans h4
    · exact (edge_adj 9).symm.reachable.trans h5
    · exact (edge_adj 10).symm.reachable.trans h6
  constructor
  · intro u v
    exact (hreach u).trans (hreach v).symm

lemma isTree : template.IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected,?_⟩
  change Nat.card template.edgeSet+1=Nat.card Vertex
  simp only [Nat.card_eq_fintype_card]
  decide

lemma no_isolated : ∀v, ∃w, template.Adj v w := by decide

lemma balance : ∀C : Finset (Fin 7),
    11*(Fintype.card (Fin 7)-C.card) ≤ 7*Nat.card (PetalEdge template C) := by
  simp only [Nat.card_eq_fintype_card]
  decide

def color : Vertex → Bool
  | .inl i => decide (i = 0 ∨ 3 ≤ i.val)
  | .inr _ => false

lemma color_proper : ∀{u v}, template.Adj u v → color u≠color v := by decide

def graph (M : ℕ) := FullRootedPower.graph template M

lemma exists_lower : ∃M : ℕ, 2≤M ∧ Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (n:ℝ)^(15/11:ℝ))
    (fun n : ℕ => (extremalNumber n (graph M):ℝ)) := by
  have h := FullRootedPower.exact_lower template no_isolated 7 11 (by omega) (by omega) balance
  norm_num at h
  exact h

end Erdos571.MirrorSpider


/-! Six short-spider subtrees, including the four rerooted ones. -/
namespace Erdos571.MirrorSpider
open Finset SimpleGraph
abbrev BranchVertex := Option (Fin 2) ⊕ Option (Fin 2)

def branchValue (j : Fin 6) : BranchVertex → Vertex :=
  Sum.elim
    (fun a => match a with
      | none => ![.inl 1,.inl 2,.inl 1,.inl 1,.inl 2,.inl 2] j
      | some i => ![![.inl 3,.inl 4],![.inl 5,.inl 6],![.inl 0,.inl 4],
          ![.inl 0,.inl 3],![.inl 0,.inl 6],![.inl 0,.inl 5]] j i)
    (fun r => match r with
      | none => ![.inl 0,.inl 0,.inl 3,.inl 4,.inl 5,.inl 6] j
      | some i => ![![.inr 1,.inr 2],![.inr 3,.inr 4],![.inr 0,.inr 2],
          ![.inr 0,.inr 1],![.inr 0,.inr 4],![.inr 0,.inr 3]] j i)

local instance : DecidableRel (ShortSpider.template 2).Adj := by
  intro u v
  cases u with
  | inl a => cases v with
    | inl b => cases a <;> cases b <;> dsimp [ShortSpider.template] <;> infer_instance
    | inr r => exact inferInstanceAs (Decidable (a=r))
  | inr r => cases v with
    | inl a => exact inferInstanceAs (Decidable (r=a))
    | inr s => exact inferInstanceAs (Decidable False)

def branchCopy (j : Fin 6) : (ShortSpider.template 2).Copy template where
  toHom :=
    { toFun := branchValue j
      map_rel' := by
        have h : ∀k u v, (ShortSpider.template 2).Adj u v → template.Adj (branchValue k u) (branchValue k v) := by decide
        exact h j }
  injective' := by
    have h : ∀k, Function.Injective (branchValue k) := by decide
    exact h j

lemma power_eq (M : ℕ) : RootedPacking.power template M=graph M := by
  ext u v
  cases u <;> cases v
  · rfl
  · rfl
  · rfl
  · have h : ∀r s : Fin 5, False ↔ template.Adj (.inr r) (.inr s) := by decide
    exact h _ _

end Erdos571.MirrorSpider


/-! Glue two disjoint short-spider branches to a common top vertex. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph

def leafIndex (j k : Fin 2) : Fin 5 := ![![1,2],![3,4]] j k

def interiorIndex (j : Fin 2) : Option (Fin 2) → Fin 7
  | none => ![1,2] j
  | some k => ![![3,4],![5,6]] j k

def amalgamValue {W : Type} (v : W) (r : Fin 5 → W)
    (f : Fin 2 → BranchVertex → W) : Vertex → W :=
  Sum.elim (fun a => ![v,f 0 (.inl none),f 1 (.inl none),f 0 (.inl (some 0)),
    f 0 (.inl (some 1)),f 1 (.inl (some 0)),f 1 (.inl (some 1))] a) r

@[simp] lemma amalgam_top {W : Type} (v : W) (r : Fin 5 → W)
    (f : Fin 2 → BranchVertex → W) : amalgamValue v r f (.inl 0)=v := rfl

@[simp] lemma amalgam_root {W : Type} (v : W) (r : Fin 5 → W)
    (f : Fin 2 → BranchVertex → W) (i : Fin 5) : amalgamValue v r f (.inr i)=r i := rfl

@[simp] lemma amalgam_interior {W : Type} (v : W) (r : Fin 5 → W)
    (f : Fin 2 → BranchVertex → W) (j : Fin 2) (a : Option (Fin 2)) :
    amalgamValue v r f (.inl (interiorIndex j a))=f j (.inl a) := by
  fin_cases j <;> fin_cases a <;> rfl

lemma vertex_cover (w : Vertex) :
    w=.inl 0 ∨ (∃i, w=.inr i) ∨ ∃j a, w=.inl (interiorIndex j a) := by
  have h : ∀w : Vertex, w=.inl 0 ∨ (∃i, w=.inr i) ∨ ∃j a, w=.inl (interiorIndex j a) := by decide
  exact h w

def amalgamCopy {W : Type} [DecidableEq W] (G : SimpleGraph W)
    (v : W) (r : Fin 5 ↪ W) (f : Fin 2 → (ShortSpider.template 2).Copy G)
    (hv : G.Adj v (r 0)) (hvroot : ∀i, v≠r i)
    (hanchor : ∀j, f j (.inr none)=v)
    (hroots : ∀j k, f j (.inr (some k))=r (leafIndex j k))
    (havoid : ∀j i, r i∉RootedPacking.interior (f j))
    (hdis : Pairwise (fun j k => Disjoint (RootedPacking.interior (f j)) (RootedPacking.interior (f k)))) :
    template.Copy G where
  toHom :=
    { toFun := amalgamValue v r (fun j => f j)
      map_rel' := by
        have he (i : Fin 11) : G.Adj (amalgamValue v r (fun j => f j) (parent i))
            (amalgamValue v r (fun j => f j) (child i)) := by
          have ha (j : Fin 2) : G.Adj v (f j (.inl none)) := by
            rw [← hanchor j]
            exact (f j).toHom.map_adj (show (ShortSpider.template 2).Adj (.inr none) (.inl none) from rfl)
          have hb (j k : Fin 2) : G.Adj (f j (.inl none)) (f j (.inl (some k))) :=
            (f j).toHom.map_adj trivial
          have hc (j k : Fin 2) : G.Adj (f j (.inl (some k))) (r (leafIndex j k)) := by
            rw [← hroots j k]
            exact (f j).toHom.map_adj rfl
          fin_cases i
          · exact ha 0
          · exact ha 1
          · exact hv
          · exact hb 0 0
          · exact hb 0 1
          · exact hb 1 0
          · exact hb 1 1
          · exact hc 0 0
          · exact hc 0 1
          · exact hc 1 0
          · exact hc 1 1
        intro x y hxy
        obtain ⟨i,⟨rfl,rfl⟩|⟨rfl,rfl⟩⟩ := hxy
        · exact he i
        · exact (he i).symm }
  injective' := by
    have hvi (j : Fin 2) (a : Option (Fin 2)) : v≠f j (.inl a) := by
      rw [← hanchor j]
      exact fun h => Sum.inr_ne_inl ((f j).injective h)
    have hri (j : Fin 2) (a : Option (Fin 2)) (i : Fin 5) : f j (.inl a)≠r i := by
      intro h
      exact havoid j i (h ▸ RootedPacking.mem_interior (f j) a)
    intro x y he
    change amalgamValue v r (fun j => f j) x=amalgamValue v r (fun j => f j) y at he
    rcases vertex_cover x with rfl|⟨i,rfl⟩|⟨j,a,rfl⟩ <;>
      rcases vertex_cover y with rfl|⟨i',rfl⟩|⟨j',a',rfl⟩
    · rfl
    · exact (hvroot i' he).elim
    · exact (hvi j' a' (by simpa only [amalgam_top,amalgam_interior] using he)).elim
    · exact (hvroot i he.symm).elim
    · exact congrArg Sum.inr (r.injective he)
    · exact (hri j' a' i (by simpa only [amalgam_root,amalgam_interior] using he.symm)).elim
    · exact (hvi j a (by simpa only [amalgam_top,amalgam_interior] using he.symm)).elim
    · exact (hri j a i' (by simpa only [amalgam_root,amalgam_interior] using he)).elim
    · simp only [amalgam_interior] at he
      by_cases hj : j=j'
      · subst j'
        have haa := Sum.inl.inj ((f j).injective he)
        subst a'
        rfl
      · exact (Finset.disjoint_left.mp (hdis hj) (RootedPacking.mem_interior (f j) a)
          (he.symm ▸ RootedPacking.mem_interior (f j') a')).elim

end Erdos571.MirrorSpider


namespace Erdos571.DisjointChoice
open Finset

theorem exists_choice_finite {I P W : Type*} [Fintype I] [DecidableEq P] [DecidableEq W]
    (a B : ℕ) (foot : P → Finset W) (F : I → Finset P) (Z : Finset W)
    (hsize : ∀i, ∀p∈F i, (foot p).card ≤ a)
    (hload : ∀i w, ((F i).filter (fun p => w∈foot p)).card ≤ B)
    (hlarge : ∀i, (Z.card+a*Fintype.card I)*B < (F i).card) :
    ∃f : I → P, (∀i, f i∈F i) ∧ (∀i, Disjoint (foot (f i)) Z) ∧
      Pairwise (fun i j => Disjoint (foot (f i)) (foot (f j))) := by
  classical
  let e := Fintype.equivFin I
  obtain ⟨f,hf,hz,hdis⟩ := exists_choice a B (Fintype.card I) foot (fun i => F (e.symm i)) Z
    (fun i => hsize _) (fun i => hload _) (fun i => hlarge _)
  exact ⟨fun i => f (e i),by simpa only [Equiv.symm_apply_apply] using fun i => hf (e i),
    fun i => hz (e i),fun i j hij => hdis (fun h => hij (e.injective h))⟩

end Erdos571.DisjointChoice


/-! Robust short-spider root fibers, without any freeness assumption. -/
namespace Erdos571.MirrorSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def branchRoots (v x y : W) : Option (Fin 2) → W
  | none => v
  | some k => ![x,y] k

noncomputable def branchFiber (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t : ℕ) (v x y : W) : Finset ((ShortSpider.template 2).Copy G) := by
  classical
  exact univ.filter (fun f => ShortSpider.GoodCopy G U t 2 f ∧
    ∀r, f (.inr r)=branchRoots v x y r)

lemma mem_branchFiber {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t : ℕ} {v x y : W} {f : (ShortSpider.template 2).Copy G} :
    f∈branchFiber G U t v x y ↔ ShortSpider.GoodCopy G U t 2 f ∧
      ∀r, f (.inr r)=branchRoots v x y r := by
  classical
  simp [branchFiber]

lemma branchFiber_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t : ℕ) (ht : 1≤t) (v x y w : W) :
    ((branchFiber G U t v x y).filter (fun f => w∈RootedPacking.interior f)).card ≤ 3*t^3 := by
  simpa only [show 2+1=3 from rfl] using
    ShortSpider.interior_load G U t 2 ht (branchFiber G U t v x y) (branchRoots v x y)
      (fun f hf => (mem_branchFiber.mp hf).1) (fun f hf => (mem_branchFiber.mp hf).2) w

def branchThreshold (t M : ℕ) := (7*M+5)*(3*t^3)

def RichBranch (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (v x y : W) : Prop := branchThreshold t M < (branchFiber G U t v x y).card

noncomputable instance (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ) :
    DecidablePred (fun p : W×(W×W) => RichBranch G U t M p.1 p.2.1 p.2.2) := Classical.decPred _

lemma rich_distinct {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t M : ℕ} {v x y : W} (h : RichBranch G U t M v x y) : v≠x ∧ v≠y ∧ x≠y := by
  obtain ⟨f,hf⟩ := card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) h)
  have hr := (mem_branchFiber.mp hf).2
  have hvx : f (.inr none)≠f (.inr (some 0)) := fun he => by
    have h := f.injective he
    cases h
  have hvy : f (.inr none)≠f (.inr (some 1)) := fun he => by
    have h := f.injective he
    cases h
  have hxy : f (.inr (some 0))≠f (.inr (some 1)) := fun he => by
    have h := f.injective he
    cases h
  simp only [hr,branchRoots,Matrix.cons_val_zero,Matrix.cons_val_succ,Matrix.head_cons] at hvx hvy hxy
  exact ⟨hvx,hvy,hxy⟩

end Erdos571.MirrorSpider


/-! Rich branches over distinct neighbors force the symmetric tree power. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

theorem contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) (ht : 1≤t) (r : Fin 5 ↪ W) (v : Fin M ↪ W)
    (hv : ∀i, G.Adj (v i) (r 0)) (hvr : ∀i j, v i≠r j)
    (hrich : ∀i j, RichBranch G U t M (v i) (r (leafIndex j 0)) (r (leafIndex j 1))) :
    graph M ⊑ G := by
  classical
  let Z := (univ.image r) ∪ (univ.image v)
  have hZ : Z.card≤5+M := by
    exact (card_union_le _ _).trans (by
      simpa only [card_univ,Fintype.card_fin] using
        Nat.add_le_add (card_image_le (s := univ) (f := r)) (card_image_le (s := univ) (f := v)))
  have hrZ (j : Fin 5) : r j∈Z := mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩)
  have hvZ (i : Fin M) : v i∈Z := mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩)
  let F (p : Fin M×Fin 2) := branchFiber G U t (v p.1) (r (leafIndex p.2 0)) (r (leafIndex p.2 1))
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice_finite 3 (3*t^3)
    (fun f : (ShortSpider.template 2).Copy G => RootedPacking.interior f) F Z
    (by intro p f hf; simp only [RootedPacking.interior_card,Fintype.card_option,Fintype.card_fin]; omega)
    (fun p w => branchFiber_load G U t ht _ _ _ w) (by
      intro p
      have h := hrich p.1 p.2
      change branchThreshold t M < (F p).card at h
      apply lt_of_le_of_lt _ h
      dsimp [branchThreshold]
      simp only [Fintype.card_prod,Fintype.card_fin]
      exact Nat.mul_le_mul_right _ (by omega))
  have hanchor (i : Fin M) (j : Fin 2) : f (i,j) (.inr none)=v i :=
    (mem_branchFiber.mp (hf (i,j))).2 none
  have hroots (i : Fin M) (j k : Fin 2) : f (i,j) (.inr (some k))=r (leafIndex j k) := by
    have h := (mem_branchFiber.mp (hf (i,j))).2 (some k)
    fin_cases k <;> exact h
  have havoid (i : Fin M) (j : Fin 2) (k : Fin 5) : r k∉RootedPacking.interior (f (i,j)) :=
    fun h => Finset.disjoint_left.mp (hfZ (i,j)) h (hrZ k)
  have hdis (i : Fin M) : Pairwise (fun j k : Fin 2 =>
      Disjoint (RootedPacking.interior (f (i,j))) (RootedPacking.interior (f (i,k)))) := by
    intro j k hjk
    exact hfdis (fun h => hjk (congrArg Prod.snd h))
  let g (i : Fin M) := amalgamCopy G (v i) r (fun j => f (i,j)) (hv i) (hvr i)
    (hanchor i) (hroots i) (havoid i) (hdis i)
  have hgroot (i : Fin M) (j : Fin 5) : g i (.inr j)=r j := rfl
  have hcover (i : Fin M) (w : W) (hw : w∈RootedPacking.interior (g i)) :
      w=v i ∨ ∃j : Fin 2, w∈RootedPacking.interior (f (i,j)) := by
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    have hc : a=0 ∨ ∃j b, a=interiorIndex j b := by
      have h : ∀a : Fin 7, a=0 ∨ ∃j b, a=interiorIndex j b := by decide
      exact h a
    rcases hc with rfl|⟨j,b,rfl⟩
    · exact Or.inl ha.symm
    · right
      refine ⟨j,?_⟩
      have he : g i (.inl (interiorIndex j b))=f (i,j) (.inl b) := by
        change amalgamValue (v i) r (fun j => f (i,j)) (.inl (interiorIndex j b))=_
        exact amalgam_interior _ _ _ _ _
      exact (he.symm.trans ha) ▸ RootedPacking.mem_interior (f (i,j)) b
  have hgdis (i j : Fin M) (hij : i≠j) :
      Disjoint (RootedPacking.interior (g i)) (RootedPacking.interior (g j)) := by
    apply Finset.disjoint_left.mpr
    intro w hwi hwj
    rcases hcover i w hwi with hi|⟨k,hk⟩ <;> rcases hcover j w hwj with h|⟨l,hl⟩
    · exact hij (v.injective (hi.symm.trans h))
    · exact Finset.disjoint_left.mp (hfZ (j,l)) hl (hi.symm ▸ hvZ i)
    · exact Finset.disjoint_left.mp (hfZ (i,k)) hk (h.symm ▸ hvZ j)
    · exact Finset.disjoint_left.mp (hfdis (fun he => hij (congrArg Prod.fst he))) hk hl
  rw [←power_eq]
  exact ⟨RootedPacking.powerCopy M r g hgroot hgdis⟩

end Erdos571.MirrorSpider


/-! Rich branch incidence in local boxes is a lower-order term. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def boxRel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (z v : W) (p : W×W) : Prop :=
  RichBranch G U t M v p.1 p.2 ∧ p.1≠z ∧ p.2≠z

lemma box_common_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph M).Free G) (z : W) (p q : W×W)
    (hpq : ¬ConflictedBox.Conflict p q) :
    letI : DecidableRel (boxRel G U t M z) := fun _ _ => Classical.propDecidable _
    (ConflictedIncidence.common (neighbors G U z) (boxRel G U t M z) p q).card < M := by
  classical
  let A := ConflictedIncidence.common (neighbors G U z) (boxRel G U t M z) p q
  change A.card<M
  by_contra! hcard
  obtain ⟨S,hSA,hS⟩ := exists_subset_card_eq hcard
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa using hS.symm)
  let v : Fin M ↪ W := e.toEmbedding.trans (Function.Embedding.subtype _)
  have hvA (i : Fin M) : v i∈A := hSA (e i).property
  have hvadj (i : Fin M) : G.Adj (v i) z := ((mem_filter.mp (mem_filter.mp (hvA i)).1).2).symm
  have hp (i : Fin M) : boxRel G U t M z (v i) p := (mem_filter.mp (hvA i)).2.1
  have hq (i : Fin M) : boxRel G U t M z (v i) q := (mem_filter.mp (hvA i)).2.2
  let i₀ : Fin M := ⟨0,by omega⟩
  have hpp := rich_distinct (hp i₀).1
  have hqq := rich_distinct (hq i₀).1
  have hpz := (hp i₀).2
  have hqz := (hq i₀).2
  let rr : Fin 5 → W := ![z,p.1,p.2,q.1,q.2]
  have hrinj : Function.Injective rr := by
    intro i j he
    fin_cases i <;> fin_cases j <;> simp_all [rr,ConflictedBox.Conflict]
  let r : Fin 5 ↪ W := ⟨rr,hrinj⟩
  apply hf
  apply contains_of_rich_neighbors G U t M ht r v
  · intro i; exact hvadj i
  · intro i j
    have hpi := rich_distinct (hp i).1
    have hqi := rich_distinct (hq i).1
    fin_cases j
    · exact G.ne_of_adj (hvadj i)
    · exact hpi.1
    · exact hpi.2.1
    · exact hqi.1
    · exact hqi.2.1
  · intro i j
    fin_cases j
    · exact (hp i).1
    · exact (hq i).1

theorem box_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph M).Free G) (z a b : W)
    {D : ℝ} (hD : 0≤D) (hz : ((neighbors G U z).card:ℝ)≤D)
    (ha : ((neighbors G U a).card:ℝ)≤D) (hb : ((neighbors G U b).card:ℝ)≤D) :
    letI : DecidableRel (boxRel G U t M z) := fun _ _ => Classical.propDecidable _
    ((ConflictedIncidence.edges (neighbors G U z) ((neighbors G U a)×ˢ(neighbors G U b))
      (boxRel G U t M z)).card:ℝ) ≤ Real.sqrt ((M:ℝ)+4)*D^2*Real.sqrt D := by
  classical
  exact ConflictedBox.bound _ _ _ _ M (fun p hp q hq hpq =>
    (box_common_bound G U t M ht hM hf z p q hpq).le) hD hz ha hb

end Erdos571.MirrorSpider


/-! Rich short-spider copies lose a square root of the maximum degree. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def richBranches (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t M : ℕ) : Finset ((ShortSpider.template 2).Copy G) := by
  classical
  exact (TreeCopiesIn.copies (ShortSpider.template 2) G U).filter (fun f =>
    RichBranch G U t M (f (.inr none)) (f (.inr (some 0))) (f (.inr (some 1))))

def branchCores (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) : Finset (W×(W×W)) :=
  (U×ˢ(U×ˢU)).filter (fun p => G.Adj p.1 p.2.1 ∧ G.Adj p.1 p.2.2)

lemma branchCores_card (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) :
    (branchCores G U).card=∑z∈U, (neighbors G U z).card^2 := by
  simp only [branchCores,card_filter,sum_product,neighbors,card_filter]
  apply sum_congr rfl
  intro z hz
  rw [sq,Finset.sum_mul]
  apply sum_congr rfl
  intro a ha
  rw [Finset.mul_sum]
  apply sum_congr rfl
  intro b hb
  by_cases hza : G.Adj z a <;> by_cases hzb : G.Adj z b <;> simp [hza,hzb]

lemma branchCores_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((branchCores G U).card:ℝ)≤U.card*D^2 := by
  rw [branchCores_card,Nat.cast_sum]
  push_cast
  exact (sum_le_sum (fun z hz => pow_le_pow_left₀ (Nat.cast_nonneg _) (hdeg z hz) 2)).trans_eq (by simp)

theorem richBranches_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((richBranches G U t M).card:ℝ) ≤ Real.sqrt ((M:ℝ)+4)*U.card*D^4*Real.sqrt D := by
  classical
  let F := richBranches G U t M
  let pre : (ShortSpider.template 2).Copy G → W×(W×W) := fun f =>
    (f (.inl none),(f (.inl (some 0)),f (.inl (some 1))))
  have hm (f) (hf : f∈F) : ∀v, f v∈U :=
    (TreeCopiesIn.mem_copies _ _ _ _).mp (mem_filter.mp hf).1
  have hmap (f) (hf : f∈F) : pre f∈branchCores G U := by
    refine mem_filter.mpr ⟨mem_product.mpr ⟨hm f hf _,mem_product.mpr ⟨hm f hf _,hm f hf _⟩⟩,?_,?_⟩
    · exact f.toHom.map_adj trivial
    · exact f.toHom.map_adj trivial
  have hcount := RealFiberCount.bound F (branchCores G U) pre hmap
    (D := Real.sqrt ((M:ℝ)+4)*D^2*Real.sqrt D) (by
      intro p hp
      have hpU := mem_product.mp (mem_filter.mp hp).1
      let B := ConflictedIncidence.edges (neighbors G U p.1)
        ((neighbors G U p.2.1)×ˢ(neighbors G U p.2.2)) (boxRel G U t M p.1)
      have hc : (F.filter (fun f => pre f=p)).card≤B.card := by
        apply card_le_card_of_injOn (fun f => (f (.inr none),(f (.inr (some 0)),f (.inr (some 1)))))
        · intro f hf'
          obtain ⟨hf',he⟩ := mem_filter.mp hf'
          have hz : f (.inl none)=p.1 := congrArg Prod.fst he
          have ha : f (.inl (some 0))=p.2.1 := congrArg (fun q => q.2.1) he
          have hb : f (.inl (some 1))=p.2.2 := congrArg (fun q => q.2.2) he
          apply mem_filter.mpr
          refine ⟨mem_product.mpr ⟨?_,mem_product.mpr ⟨?_,?_⟩⟩,?_,?_,?_⟩
          · refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←hz]
            exact f.toHom.map_adj rfl
          · refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←ha]
            exact f.toHom.map_adj rfl
          · refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←hb]
            exact f.toHom.map_adj rfl
          · exact (mem_filter.mp hf').2
          · rw [←hz]
            exact fun h => Sum.inr_ne_inl (f.injective h)
          · rw [←hz]
            exact fun h => Sum.inr_ne_inl (f.injective h)
        · intro f hf' g hg' he
          have hpre : pre f=pre g := (mem_filter.mp hf').2.trans (mem_filter.mp hg').2.symm
          apply Copy.ext
          intro v
          fin_cases v
          · exact congrArg Prod.fst hpre
          · exact congrArg (fun p => p.2.1) hpre
          · exact congrArg (fun p => p.2.2) hpre
          · exact congrArg Prod.fst he
          · exact congrArg (fun p => p.2.1) he
          · exact congrArg (fun p => p.2.2) he
      exact (show _≤(B.card:ℝ) by exact_mod_cast hc).trans
        (box_bound G U t M ht hM hf p.1 p.2.1 p.2.2 hD (hdeg _ hpU.1)
          (hdeg _ (mem_product.mp hpU.2).1) (hdeg _ (mem_product.mp hpU.2).2)))
  have hb := mul_le_mul_of_nonneg_right (branchCores_bound G U hD hdeg)
    (show 0≤Real.sqrt ((M:ℝ)+4)*D^2*Real.sqrt D by positivity)
  exact hcount.trans (hb.trans_eq (by ring))

end Erdos571.MirrorSpider


/-! Light copies whose six short-spider subtrees have nonrich root fibers. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

structure GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (f : template.Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light template G U t f
  branch : ∀j : Fin 6, ¬RichBranch G U t M
    (f (branchCopy j (.inr none))) (f (branchCopy j (.inr (some 0))))
    (f (branchCopy j (.inr (some 1))))

lemma branch_good (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    (f : template.Copy G) (hm : ∀v, f v∈U) (hl : ConnectedCopyBound.Light template G U t f)
    (j : Fin 6) : ShortSpider.GoodCopy G U t 2 (f.comp (branchCopy j)) := by
  refine ⟨fun v => hm _,?_⟩
  intro k
  constructor
  · exact hl _ _ _ ((branchCopy j).toHom.map_adj (show (ShortSpider.template 2).Adj (.inr none) (.inl none) from rfl))
      ((branchCopy j).toHom.map_adj (show (ShortSpider.template 2).Adj (.inl none) (.inl (some k)) from trivial))
      ((branchCopy j).injective.ne Sum.inr_ne_inl)
  · exact hl _ _ _ ((branchCopy j).toHom.map_adj (show (ShortSpider.template 2).Adj (.inl none) (.inl (some k)) from trivial))
      ((branchCopy j).toHom.map_adj (show (ShortSpider.template 2).Adj (.inl (some k)) (.inr (some k)) from rfl))
      ((branchCopy j).injective.ne Sum.inl_ne_inr)

lemma GoodCopy.branch_good {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t M : ℕ}
    {f : template.Copy G} (h : GoodCopy G U t M f) (j : Fin 6) :
    ShortSpider.GoodCopy G U t 2 (f.comp (branchCopy j)) := MirrorSpider.branch_good G U t f h.mem h.light j

lemma branch_image_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (F : Finset (template.Copy G)) (j : Fin 6) (s : Option (Fin 2) → W)
    (hg : ∀f∈F, GoodCopy G U t M f)
    (hs : ∀f∈F, ∀r, f (branchCopy j (.inr r))=s r) :
    (F.image (fun f => f.comp (branchCopy j))).card ≤ branchThreshold t M := by
  classical
  by_cases hF : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hF,image_empty,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  have hb : (branchFiber G U t (s none) (s (some 0)) (s (some 1))).card≤branchThreshold t M := by
    have h := (hg f₀ hf₀).branch j
    simp only [hs f₀ hf₀] at h
    exact le_of_not_gt h
  apply le_trans _ hb
  apply card_le_card
  intro g hg'
  obtain ⟨f,hf,rfl⟩ := mem_image.mp hg'
  apply mem_branchFiber.mpr
  refine ⟨(hg f hf).branch_good j,?_⟩
  intro r
  change f (branchCopy j (.inr r))=_
  rw [hs f hf]
  fin_cases r <;> rfl

lemma restriction_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M B : ℕ) (F : Finset (template.Copy G)) (p q : Fin 6) (r : Fin 5 → W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (himage : (F.image (fun f => f.comp (branchCopy p))).card≤B)
    (hroots : ∀a : Option (Fin 2), (∃i, branchCopy q (.inr a)=Sum.inr i) ∨
      ∃v, branchCopy q (.inr a)=branchCopy p v)
    (hcover : ∀v : Vertex, (∃i, v=Sum.inr i) ∨ (∃a, v=branchCopy p a) ∨ ∃a, v=branchCopy q a) :
    F.card ≤ branchThreshold t M*B := by
  classical
  let pre := fun f : template.Copy G => f.comp (branchCopy p)
  have hF : F.card≤branchThreshold t M*(F.image pre).card := card_le_mul_card_image F _ (by
    intro g hgf
    obtain ⟨f₀,hf₀,hfg⟩ := mem_image.mp hgf
    let F' := F.filter (fun f => pre f=g)
    let s := fun a => f₀ (branchCopy q (.inr a))
    have hs (f) (hf : f∈F') (a) : f (branchCopy q (.inr a))=s a := by
      rcases hroots a with ⟨i,hi⟩|⟨v,hv⟩
      · dsimp [s]
        rw [hi]
        exact (hr f (mem_filter.mp hf).1 i).trans (hr f₀ hf₀ i).symm
      · rw [hv]
        change f (branchCopy p v)=f₀ (branchCopy q (.inr a))
        rw [hv]
        exact congrArg (fun h : (ShortSpider.template 2).Copy G => h v)
          ((mem_filter.mp hf).2.trans hfg.symm)
    have hb := branch_image_bound G U t M F' q s
      (fun f hf => hg f (mem_filter.mp hf).1) hs
    apply le_trans _ hb
    apply card_le_card_of_injOn (fun f => f.comp (branchCopy q))
    · intro f hf; exact mem_image.mpr ⟨f,hf,rfl⟩
    · intro f hf g' hg' he
      apply Copy.ext
      intro v
      rcases hcover v with ⟨i,rfl⟩|⟨a,rfl⟩|⟨a,rfl⟩
      · exact (hr f (mem_filter.mp hf).1 i).trans (hr g' (mem_filter.mp hg').1 i).symm
      · exact congrArg (fun h : (ShortSpider.template 2).Copy G => h a)
          ((mem_filter.mp hf).2.trans (mem_filter.mp hg').2.symm)
      · exact congrArg (fun h : (ShortSpider.template 2).Copy G => h a) he)
  exact hF.trans (Nat.mul_le_mul_left _ himage)

end Erdos571.MirrorSpider


/-! Every interior pin has a constant load after rerooted branch cleaning. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def simplePin : Fin 5 → Fin 7 := ![0,3,4,5,6]
def firstBranch : Fin 5 → Fin 6 := ![0,2,3,4,5]
def secondBranch : Fin 5 → Fin 6 := ![1,1,1,0,0]

lemma simple_pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (F : Finset (template.Copy G)) (r : Fin 5 → W) (w : W) (j : Fin 5)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (.inl (simplePin j))=w) : F.card≤(branchThreshold t M)^2 := by
  classical
  by_cases hF : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  have hs (f) (hf : f∈F) (a : Option (Fin 2)) :
      f (branchCopy (firstBranch j) (.inr a))=f₀ (branchCopy (firstBranch j) (.inr a)) := by
    have hc : branchCopy (firstBranch j) (.inr a)=Sum.inl (simplePin j) ∨
        ∃i, branchCopy (firstBranch j) (.inr a)=Sum.inr i := by
      have h : ∀j : Fin 5, ∀a : Option (Fin 2),
          branchCopy (firstBranch j) (.inr a)=Sum.inl (simplePin j) ∨
          ∃i, branchCopy (firstBranch j) (.inr a)=Sum.inr i := by decide
      exact h j a
    rcases hc with h|⟨i,h⟩
    · rw [h,hw f hf,hw f₀ hf₀]
    · rw [h,hr f hf,hr f₀ hf₀]
  have himage := branch_image_bound G U t M F (firstBranch j)
    (fun a => f₀ (branchCopy (firstBranch j) (.inr a))) hg hs
  have hbound := restriction_bound G U t M (branchThreshold t M) F (firstBranch j) (secondBranch j) r hg hr himage
    (by
      have h : ∀j : Fin 5, ∀a : Option (Fin 2),
          (∃i, branchCopy (secondBranch j) (.inr a)=Sum.inr i) ∨
          ∃v, branchCopy (secondBranch j) (.inr a)=branchCopy (firstBranch j) v := by decide
      exact h j)
    (by
      have h : ∀j : Fin 5, ∀v : Vertex,
          (∃i, v=Sum.inr i) ∨ (∃a, v=branchCopy (firstBranch j) a) ∨
          ∃a, v=branchCopy (secondBranch j) a := by decide
      exact h j)
  simpa only [pow_two] using hbound

lemma center_pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (F : Finset (template.Copy G)) (r : Fin 5 → W) (w : W) (j : Fin 2)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (.inl (interiorIndex j none))=w) :
    F.card≤branchThreshold t M*t^3 := by
  classical
  by_cases hF : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let p : Fin 6 := ![0,1] j
  let q : Fin 6 := ![1,0] j
  let I := F.image (fun f => f.comp (branchCopy p))
  let C := FourthMoment.common G U w (r 0)
  have hc : C.card≤t := by
    have h := (hg f₀ hf₀).light (.inl (interiorIndex j none)) (.inl 0) (.inr 0)
      (by fin_cases j <;> decide) (by decide) Sum.inl_ne_inr
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact h.le
  have hcent (g) (hgi : g∈I) : g (.inl none)=w := by
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hgi
    have h : branchCopy p (.inl none)=Sum.inl (interiorIndex j none) := by fin_cases j <;> rfl
    change f (branchCopy p (.inl none))=w
    rw [h]
    exact hw f hf
  have hlong (g) (hgi : g∈I) (k : Fin 2) : g (.inr (some k))=r (leafIndex j k) := by
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hgi
    have h : branchCopy p (.inr (some k))=Sum.inr (leafIndex j k) := by fin_cases j <;> fin_cases k <;> rfl
    change f (branchCopy p (.inr (some k)))=r (leafIndex j k)
    rw [h]
    exact hr f hf _
  have higood (g) (hgi : g∈I) : ShortSpider.GoodCopy G U t 2 g := by
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hgi
    exact (hg f hf).branch_good p
  let anchor : (ShortSpider.template 2).Copy G → W := fun g => g (.inr none)
  have hanc : I.image anchor ⊆ C := by
    intro a ha
    obtain ⟨g,hg',rfl⟩ := mem_image.mp ha
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hg'
    have he : branchCopy p (.inr none)=Sum.inl 0 := by fin_cases j <;> rfl
    change f (branchCopy p (.inr none))∈C
    rw [he]
    apply mem_filter.mpr
    refine ⟨(hg f hf).mem _,?_,?_⟩
    · rw [← hw f hf]
      exact f.toHom.map_adj (by fin_cases j <;> decide)
    · rw [← hr f hf]
      exact f.toHom.map_adj (by decide)
  have hi : I.card≤t^2*(I.image anchor).card := card_le_mul_card_image I _ (by
    intro a ha
    apply ShortSpider.center_count G U t 2 _ (branchRoots a (r (leafIndex j 0)) (r (leafIndex j 1))) w
    · intro g hg'; exact higood g (mem_filter.mp hg').1
    · intro g hg' k
      cases k with
      | none => exact (mem_filter.mp hg').2
      | some k => fin_cases k <;> exact hlong g (mem_filter.mp hg').1 _
    · intro g hg'; exact hcent g (mem_filter.mp hg').1)
  have himage : I.card≤t^3 := by
    have h := hi.trans (Nat.mul_le_mul_left _ ((card_le_card hanc).trans hc))
    simpa only [pow_succ] using h
  apply restriction_bound G U t M (t^3) F p q r hg hr himage
  · have h : ∀j : Fin 2, ∀a : Option (Fin 2),
        (∃i, branchCopy (![1,0] j) (.inr a)=Sum.inr i) ∨
        ∃v, branchCopy (![1,0] j) (.inr a)=branchCopy (![0,1] j) v := by decide
    exact h j
  · have h : ∀j : Fin 2, ∀v : Vertex,
        (∃i, v=Sum.inr i) ∨ (∃a, v=branchCopy (![0,1] j) a) ∨ ∃a, v=branchCopy (![1,0] j) a := by decide
    exact h j

end Erdos571.MirrorSpider


/-! Constant interior loads give a global O(n^5) bound for good copies. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def copyLoad (t M : ℕ) := 7*(branchThreshold t M^2+branchThreshold t M*t^3)

lemma pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 5 → W) (w : W) (i : Fin 7)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (.inl i)=w) : F.card≤branchThreshold t M^2+branchThreshold t M*t^3 := by
  fin_cases i
  · exact (simple_pinned_count G U t M F r w 0 hg hr hw).trans (Nat.le_add_right _ _)
  · exact (center_pinned_count G U t M F r w 0 hg hr hw).trans (Nat.le_add_left _ _)
  · exact (center_pinned_count G U t M F r w 1 hg hr hw).trans (Nat.le_add_left _ _)
  · exact (simple_pinned_count G U t M F r w 1 hg hr hw).trans (Nat.le_add_right _ _)
  · exact (simple_pinned_count G U t M F r w 2 hg hr hw).trans (Nat.le_add_right _ _)
  · exact (simple_pinned_count G U t M F r w 3 hg hr hw).trans (Nat.le_add_right _ _)
  · exact (simple_pinned_count G U t M F r w 4 hg hr hw).trans (Nat.le_add_right _ _)

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (F : Finset (template.Copy G)) (r : Fin 5 → W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤copyLoad t M := by
  classical
  let A (i : Fin 7) := F.filter (fun f => f (.inl i)=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨i,hi⟩ := hw
    exact mem_biUnion.mpr ⟨i,mem_univ _,mem_filter.mpr ⟨hf,hi⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hsub
    _ ≤ ∑i : Fin 7, (A i).card := card_biUnion_le
    _ ≤ ∑_i : Fin 7, (branchThreshold t M^2+branchThreshold t M*t^3) := sum_le_sum (fun i hi =>
      pinned_count G U t M (A i) r w i (fun f hf => hg f (mem_filter.mp hf).1)
        (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by simp [copyLoad,mul_comm]

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1≤t) (hf : (graph M).Free G) (F : Finset (template.Copy G)) (r : Fin 5 ↪ W)
    (hg : ∀f∈F, GoodCopy G U t M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a) :
    F.card<7*M*copyLoad t M := by
  classical
  by_contra! hc
  have hB : 0<copyLoad t M := by dsimp [copyLoad,branchThreshold]; positivity
  have hh := RootedPacking.power_contained_of_bounded_load F id r hr (copyLoad t M) M hB
    (interior_load G U t M F r hg hr) (by simpa [mul_comm M 7] using hc)
  rw [power_eq] at hh
  exact hf hh

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t M : ℕ)
    (ht : 1≤t) (hf : (graph M).Free G) (F : Finset (template.Copy G))
    (hg : ∀f∈F, GoodCopy G U t M f) : F.card≤7*M*copyLoad t M*U.card^5 := by
  classical
  let roots : template.Copy G → Fin 5 → W := fun f a => f (.inr a)
  have hb (r : Fin 5 → W) : (F.filter (fun f => roots f=r)).card≤7*M*copyLoad t M := by
    by_cases hn : (F.filter (fun f => roots f=r)).Nonempty
    swap
    · rw [not_nonempty_iff_eq_empty.mp hn,card_empty]; omega
    obtain ⟨f₀,hf₀⟩ := hn
    have hi : Function.Injective r := by
      rw [←(mem_filter.mp hf₀).2]
      exact f₀.injective.comp Sum.inr_injective
    exact (rooted_count G U t M ht hf _ ⟨r,hi⟩ (fun f hf => hg f (mem_filter.mp hf).1)
      (fun f hf a => congrFun (mem_filter.mp hf).2 a)).le
  have hc := card_le_mul_card_image F (7*M*copyLoad t M) (fun r hr => hb r)
  have hi : (F.image roots).card≤U.card^5 := by
    let v : (F.image roots) → Fin 5 → U := fun r a => ⟨r.val a,by
      obtain ⟨f,hf,he⟩ := mem_image.mp r.property
      rw [←he]
      exact (hg f hf).mem _⟩
    have hv : Function.Injective v := by
      intro r s h
      apply Subtype.ext
      funext a
      exact congrArg Subtype.val (congrFun h a)
    have hh := Fintype.card_le_of_injective v hv
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using hh
  exact hc.trans (Nat.mul_le_mul_left _ hi)

end Erdos571.MirrorSpider


/-! The remaining error in the symmetric-tree count is the heavy two-path mass. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_subtree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (j : Fin 6) (F : Finset (template.Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, RichBranch G U t M
      (f (branchCopy j (.inr none))) (f (branchCopy j (.inr (some 0))))
      (f (branchCopy j (.inr (some 1))))) :
    (F.card:ℝ) ≤ Real.sqrt ((M:ℝ)+4)*U.card*D^10*Real.sqrt D := by
  classical
  have hb := ConnectedCopyBound.copy_restriction_bound template connected (ShortSpider.template 2)
    (branchCopy j) G U hD hdeg F (richBranches G U t M) hm (by
      intro f hf
      apply mem_filter.mpr
      exact ⟨(TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hm f hf _),hr f hf⟩)
  norm_num [Vertex] at hb
  have hh := mul_le_mul_of_nonneg_right (richBranches_bound G U t M ht hM hf hD hdeg)
    (show 0≤D^6 by positivity)
  exact hb.trans (hh.trans_eq (by ring))

theorem all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (F : Finset (template.Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ) ≤ (7*M*copyLoad t M:ℕ)*(U.card:ℝ)^5+
      1728*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^9+
      6*Real.sqrt ((M:ℝ)+4)*U.card*D^10*Real.sqrt D := by
  classical
  let A := F.filter (GoodCopy G U t M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light template G U t f)
  let C (j : Fin 6) := F.filter (fun f => RichBranch G U t M
    (f (branchCopy j (.inr none))) (f (branchCopy j (.inr (some 0))))
    (f (branchCopy j (.inr (some 1)))))
  have hsub : F⊆A ∪ B ∪ univ.biUnion C := by
    intro f hf
    by_cases hl : ConnectedCopyBound.Light template G U t f
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩))
    by_cases hb : ∀j : Fin 6, ¬RichBranch G U t M
      (f (branchCopy j (.inr none))) (f (branchCopy j (.inr (some 0))))
      (f (branchCopy j (.inr (some 1))))
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hm f hf,hl,hb⟩))
    · simp only [not_forall,not_not] at hb
      obtain ⟨j,hj⟩ := hb
      exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,mem_filter.mpr ⟨hf,hj⟩⟩)
  have hA : (A.card:ℝ)≤(7*M*copyLoad t M:ℕ)*(U.card:ℝ)^5 := by
    exact_mod_cast good_count G U t M ht hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card:ℝ)≤1728*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^9 := by
    have h := ConnectedCopyBound.nonlight_bound template connected G U t hD hdeg B
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    norm_num [Vertex] at h
    simpa only [mul_assoc] using h
  have hC : ((univ.biUnion C).card:ℝ)≤6*Real.sqrt ((M:ℝ)+4)*U.card*D^10*Real.sqrt D := by
    have hc : ((univ.biUnion C).card:ℝ)≤∑j : Fin 6, ((C j).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun j hj => rich_subtree_count G U t M ht hM hf hD hdeg j (C j)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,Nat.cast_ofNat] at hh
    nlinarith
  have hc := (card_le_card hsub).trans ((card_union_le _ _).trans
    (Nat.add_le_add_right (card_union_le _ _) _))
  have hc' : (F.card:ℝ)≤A.card+B.card+(univ.biUnion C).card := by exact_mod_cast hc
  linarith

end Erdos571.MirrorSpider


/-! Greedy packing of two-edge stars in a directed incidence relation. -/
namespace Erdos571.CherryPacking
open Finset
variable {W : Type*} [DecidableEq W]

def foot (p : W×(W×W)) : Finset W := {p.1,p.2.1,p.2.2}
def Valid (E : Finset (W×W)) (p : W×(W×W)) : Prop :=
  (p.2.1,p.1)∈E ∧ (p.2.2,p.1)∈E ∧ p.2.1≠p.2.2

def avoid (E : Finset (W×W)) (Z : Finset W) : Finset (W×W) :=
  E.filter (fun e => e.1∉Z ∧ e.2∉Z)

lemma remove_bound (E : Finset (W×W)) (Z : Finset W) (D : ℕ)
    (hl : ∀w, (E.filter (fun e => e.1=w)).card≤D)
    (hr : ∀w, (E.filter (fun e => e.2=w)).card≤D) :
    E.card≤(avoid E Z).card+2*Z.card*D := by
  let B := Z.biUnion (fun w => E.filter (fun e => e.1=w) ∪ E.filter (fun e => e.2=w))
  have hB : B.card≤2*Z.card*D := by
    calc
      _ ≤ ∑w∈Z, (E.filter (fun e => e.1=w) ∪ E.filter (fun e => e.2=w)).card := card_biUnion_le
      _ ≤ ∑_w∈Z, (D+D) := sum_le_sum (fun w hw => (card_union_le _ _).trans (Nat.add_le_add (hl w) (hr w)))
      _ = _ := by simp; ring
  have hsub : E⊆avoid E Z ∪ B := by
    intro e he
    by_cases h1 : e.1∈Z
    · exact mem_union_right _ (mem_biUnion.mpr ⟨e.1,h1,mem_union_left _ (mem_filter.mpr ⟨he,rfl⟩)⟩)
    by_cases h2 : e.2∈Z
    · exact mem_union_right _ (mem_biUnion.mpr ⟨e.2,h2,mem_union_right _ (mem_filter.mpr ⟨he,rfl⟩)⟩)
    exact mem_union_left _ (mem_filter.mpr ⟨he,h1,h2⟩)
  exact (card_le_card hsub).trans ((card_union_le _ _).trans (Nat.add_le_add_left hB _))

lemma exists_cherry (E : Finset (W×W)) (D : ℕ) (hB : (E.image Prod.snd).card≤D)
    (hE : D<E.card) : ∃p, Valid E p := by
  obtain ⟨e,he,f,hf,hne,hef⟩ := exists_ne_map_eq_of_card_image_lt (hB.trans_lt hE)
  refine ⟨(e.2,(e.1,f.1)),he,?_,?_⟩
  · simpa only [hef] using hf
  · intro h
    exact hne (Prod.ext h hef)

theorem pack (E : Finset (W×W)) (D M : ℕ)
    (hl : ∀w, (E.filter (fun e => e.1=w)).card≤D)
    (hr : ∀w, (E.filter (fun e => e.2=w)).card≤D)
    (hB : (E.image Prod.snd).card≤D) (hE : (6*M+1)*D<E.card) :
    ∃f : Fin M → W×(W×W), (∀i, Valid E (f i)) ∧
      Pairwise (fun i j => Disjoint (foot (f i)) (foot (f j))) := by
  induction M generalizing E with
  | zero => exact ⟨Fin.elim0,by intro i; exact Fin.elim0 i,by intro i; exact Fin.elim0 i⟩
  | succ M ih =>
    obtain ⟨p,hp⟩ := exists_cherry E D hB (by nlinarith)
    let E' := avoid E (foot p)
    have hsub : E'⊆E := filter_subset _ _
    have hfoot : (foot p).card≤3 := by exact card_le_three
    have hremove := remove_bound E (foot p) D hl hr
    have hcard : (6*M+1)*D<E'.card := by
      have h := Nat.mul_le_mul_right D (Nat.mul_le_mul_left 2 hfoot)
      change E.card≤E'.card+_ at hremove
      nlinarith
    obtain ⟨f,hf,hdis⟩ := ih E' (fun w => (card_le_card (filter_subset_filter _ hsub)).trans (hl w))
      (fun w => (card_le_card (filter_subset_filter _ hsub)).trans (hr w))
      ((card_le_card (image_subset_image hsub)).trans hB) hcard
    have hfE (i : Fin M) : Valid E (f i) := ⟨hsub (hf i).1,hsub (hf i).2.1,(hf i).2.2⟩
    have hfp (i : Fin M) : Disjoint (foot (f i)) (foot p) := by
      have h1 := (mem_filter.mp (hf i).1).2
      have h2 := (mem_filter.mp (hf i).2.1).2
      simp only [foot,Finset.disjoint_left,mem_insert,mem_singleton]
      intro w hw
      rcases hw with rfl|rfl|rfl
      · simpa only [foot,mem_insert,mem_singleton] using h1.2
      · simpa only [foot,mem_insert,mem_singleton] using h1.1
      · simpa only [foot,mem_insert,mem_singleton] using h2.1
    refine ⟨Fin.cons p f,?_,?_⟩
    · intro i
      induction i using Fin.cases with
      | zero => exact hp
      | succ i => exact hfE i
    · intro i j hij
      induction i using Fin.cases with
      | zero => induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j => exact (hfp j).symm
      | succ i => induction j using Fin.cases with
        | zero => exact hfp i
        | succ j => exact hdis (fun he => hij (congrArg Fin.succ he))

end Erdos571.CherryPacking


/-! Disjoint loopless cherries give an embedding of all their core vertices. -/
namespace Erdos571.CherryPacking
open Finset
variable {W : Type*} [DecidableEq W]

def coreValue (p : W×(W×W)) : Fin 3 → W := ![p.1,p.2.1,p.2.2]

lemma coreValue_mem (p : W×(W×W)) (j : Fin 3) : coreValue p j∈foot p := by
  fin_cases j <;> simp [coreValue,foot]

lemma coreValue_injective {E : Finset (W×W)} (hloop : ∀e∈E, e.1≠e.2)
    {p : W×(W×W)} (hp : Valid E p) : Function.Injective (coreValue p) := by
  have h1 := hloop _ hp.1
  have h2 := hloop _ hp.2.1
  have h3 := hp.2.2
  intro i j h
  fin_cases i <;> fin_cases j <;> simp_all [coreValue]

def coreEmbedding {E : Finset (W×W)} (hloop : ∀e∈E, e.1≠e.2) {M : ℕ}
    (f : Fin M → W×(W×W)) (hf : ∀i, Valid E (f i))
    (hdis : Pairwise (fun i j => Disjoint (foot (f i)) (foot (f j)))) : Fin M×Fin 3 ↪ W where
  toFun := fun p => coreValue (f p.1) p.2
  inj' := by
    rintro ⟨i,j⟩ ⟨i',j'⟩ h
    change coreValue (f i) j=coreValue (f i') j' at h
    by_cases hi : i=i'
    · subst i'
      exact Prod.ext rfl (coreValue_injective hloop (hf i) h)
    · exact (Finset.disjoint_left.mp (hdis hi) (coreValue_mem (f i) j)
        (h.symm ▸ coreValue_mem (f i') j')).elim

end Erdos571.CherryPacking


/-! Coordinate fiber bounds for a subrelation of the arcs in a bounded-degree host. -/
namespace Erdos571.DirectedDegreeBounds
open Finset SimpleGraph DensityRegularization
variable {W : Type*} [DecidableEq W]

lemma left (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (E : Finset (W×W)) (hE : E⊆arcs G U) (D : ℕ)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (w : W) :
    (E.filter (fun e => e.1=w)).card≤D := by
  by_cases hw : w∈U
  · apply le_trans _ (hdeg w hw)
    apply card_le_card_of_injOn Prod.snd
    · intro e he
      obtain ⟨he,hew⟩ := mem_filter.mp he
      have ha := mem_arcs.mp (hE he)
      exact mem_filter.mpr ⟨ha.2.1,hew ▸ ha.2.2⟩
    · intro e he f hf hef
      exact Prod.ext ((mem_filter.mp he).2.trans (mem_filter.mp hf).2.symm) hef
  · have he : E.filter (fun e => e.1=w)=∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro e he
      exact hw ((mem_filter.mp he).2 ▸ (mem_arcs.mp (hE (mem_filter.mp he).1)).1)
    rw [he,card_empty]
    omega

lemma right (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (E : Finset (W×W)) (hE : E⊆arcs G U) (D : ℕ)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (w : W) :
    (E.filter (fun e => e.2=w)).card≤D := by
  by_cases hw : w∈U
  · apply le_trans _ (hdeg w hw)
    apply card_le_card_of_injOn Prod.fst
    · intro e he
      obtain ⟨he,hew⟩ := mem_filter.mp he
      have ha := mem_arcs.mp (hE he)
      exact mem_filter.mpr ⟨ha.1,hew ▸ ha.2.2.symm⟩
    · intro e he f hf hef
      exact Prod.ext hef ((mem_filter.mp he).2.trans (mem_filter.mp hf).2.symm)
  · have he : E.filter (fun e => e.2=w)=∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro e he
      exact hw ((mem_filter.mp he).2 ▸ (mem_arcs.mp (hE (mem_filter.mp he).1)).2.1)
    rw [he,card_empty]
    omega

end Erdos571.DirectedDegreeBounds


/-! A core-and-arm layout directly embeds a full mirror-spider power. -/
namespace Erdos571.MirrorSpider
open Finset SimpleGraph

abbrev PowerVertex (M : ℕ) := (Fin M×Fin 7) ⊕ Fin 5

def petalVertex {M : ℕ} (i : Fin M) : Vertex → PowerVertex M :=
  Sum.elim (fun a => .inl (i,a)) Sum.inr

def modelCopy {W : Type} (G : SimpleGraph W) (M : ℕ) (f : PowerVertex M ↪ W)
    (hedge : ∀i : Fin M, ∀e : Fin 11, G.Adj (f (petalVertex i (parent e))) (f (petalVertex i (child e)))) :
    (graph M).Copy G where
  toHom :=
    { toFun := f
      map_rel' := by
        have hp (i : Fin M) {u v : Vertex} (h : template.Adj u v) :
            G.Adj (f (petalVertex i u)) (f (petalVertex i v)) := by
          obtain ⟨e,⟨rfl,rfl⟩|⟨rfl,rfl⟩⟩ := h
          · exact hedge i e
          · exact (hedge i e).symm
        intro u v h
        rw [←power_eq] at h
        cases u with
        | inl a => cases v with
          | inl b =>
            obtain ⟨hidx,h⟩ := h
            obtain ⟨i,a⟩ := a
            obtain ⟨j,b⟩ := b
            change i=j at hidx
            subst j
            exact hp i h
          | inr r => exact hp a.1 h
        | inr r => cases v with
          | inl a => exact hp a.1 h
          | inr s => exact h.elim }
  injective' := f.injective

def layoutEquiv (M : ℕ) : PowerVertex M ≃ ((Fin M×Fin 3) ⊕ (Fin M×Fin 4)) ⊕ Fin 5 :=
  Equiv.sumCongr ((Equiv.prodCongr (Equiv.refl (Fin M))
    (finSumFinEquiv (m := 3) (n := 4)).symm).trans (Equiv.prodSumDistrib _ _ _)) (Equiv.refl _)

def armCenter : Fin 4 → Fin 3 := ![1,1,2,2]

theorem contains_of_layout {W : Type} (G : SimpleGraph W) (M : ℕ)
    (c : Fin M×Fin 3 ↪ W) (a : Fin M×Fin 4 ↪ W) (r : Fin 5 ↪ W)
    (hca : ∀i j, c i≠a j) (hcr : ∀i j, c i≠r j) (har : ∀i j, a i≠r j)
    (htop : ∀i, G.Adj (c (i,0)) (r 0))
    (hcore : ∀i, ∀j : Fin 2, G.Adj (c (i,0)) (c (i,j.succ)))
    (harm : ∀i k, G.Adj (c (i,armCenter k)) (a (i,k)))
    (hroot : ∀i k, G.Adj (a (i,k)) (r k.succ)) : graph M ⊑ G := by
  let ca : (Fin M×Fin 3) ⊕ (Fin M×Fin 4) ↪ W :=
    ⟨Sum.elim c a,Sum.elim_injective.mpr ⟨c.injective,a.injective,hca⟩⟩
  let car : ((Fin M×Fin 3) ⊕ (Fin M×Fin 4)) ⊕ Fin 5 ↪ W :=
    ⟨Sum.elim ca r,Sum.elim_injective.mpr ⟨ca.injective,r.injective,by
      intro i j
      cases i with
      | inl i => exact hcr i j
      | inr i => exact har i j⟩⟩
  let f : PowerVertex M ↪ W := (layoutEquiv M).toEmbedding.trans car
  refine ⟨modelCopy G M f ?_⟩
  intro i e
  fin_cases e
  · exact hcore i 0
  · exact hcore i 1
  · exact htop i
  · exact harm i 0
  · exact harm i 1
  · exact harm i 2
  · exact harm i 3
  · exact hroot i 0
  · exact hroot i 1
  · exact hroot i 2
  · exact hroot i 3

end Erdos571.MirrorSpider


/-! A large five-root common neighborhood in the heavy shadow forces the target. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

theorem contains_of_heavy_roots (G : SimpleGraph W) [DecidableRel G.Adj]
    (U S : Finset W) (t M D : ℕ) (ht : 7*M+5≤t)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (hSU : S⊆U)
    (r : Fin 5 ↪ W) (hrU : ∀j, r j∈U)
    (hheavy : ∀u∈S, ∀j, t≤(FourthMoment.common G U u (r j)).card)
    (hlarge : (6*M+11)*D<t*S.card) : graph M ⊑ G := by
  classical
  let Y := neighbors G U (r 0)
  let E := (S×ˢY).filter (fun p => G.Adj p.1 p.2)
  have hE : E⊆arcs G U := by
    intro e he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨hSU hs,(mem_filter.mp hy).1,ha⟩
  have hl := DirectedDegreeBounds.left G U E hE D hdeg
  have hh := DirectedDegreeBounds.right G U E hE D hdeg
  have hcount : t*S.card≤E.card := by
    rw [rectangle_card]
    have hC (u : W) : neighbors G Y u=FourthMoment.common G U u (r 0) := by
      ext v
      simp only [neighbors,Y,FourthMoment.common,mem_filter]
      tauto
    simp_rw [hC]
    exact (show t*S.card=∑_u∈S,t by simp [mul_comm]).trans_le
      (sum_le_sum (fun u hu => hheavy u hu 0))
  let Z := univ.image r
  have hZ : Z.card=5 := by simp [Z,card_image_of_injective _ r.injective]
  let E' := CherryPacking.avoid E Z
  have hE'E : E'⊆E := filter_subset _ _
  have hE' : E'⊆arcs G U := hE'E.trans hE
  have hrem := CherryPacking.remove_bound E Z D hl hh
  have hcard : (6*M+1)*D<E'.card := by
    change E.card≤E'.card+2*Z.card*D at hrem
    rw [hZ] at hrem
    nlinarith
  have hB : (E'.image Prod.snd).card≤D := by
    apply le_trans _ (hdeg _ (hrU 0))
    apply card_le_card
    intro v hv
    obtain ⟨e,he,rfl⟩ := mem_image.mp hv
    exact (mem_product.mp (mem_filter.mp (hE'E he)).1).2
  obtain ⟨f,hf,hdis⟩ := CherryPacking.pack E' D M
    (DirectedDegreeBounds.left G U E' hE' D hdeg)
    (DirectedDegreeBounds.right G U E' hE' D hdeg) hB hcard
  have hloop : ∀e∈E', e.1≠e.2 := fun e he => G.ne_of_adj (mem_arcs.mp (hE' he)).2.2
  let c := CherryPacking.coreEmbedding hloop f hf hdis
  have hrZ (j : Fin 5) : r j∈Z := mem_image.mpr ⟨j,mem_univ _,rfl⟩
  have hcavoid (i : Fin M×Fin 3) : c i∉Z := by
    obtain ⟨i,j⟩ := i
    have h1 := (mem_filter.mp (hf i).1).2
    have h2 := (mem_filter.mp (hf i).2.1).2
    fin_cases j
    · exact h1.2
    · exact h1.1
    · exact h2.1
  have hcS (i : Fin M) (k : Fin 4) : c (i,armCenter k)∈S := by
    have h1 := (mem_product.mp (mem_filter.mp (hE'E (hf i).1)).1).1
    have h2 := (mem_product.mp (mem_filter.mp (hE'E (hf i).2.1)).1).1
    fin_cases k
    · exact h1
    · exact h1
    · exact h2
    · exact h2
  let Z' := (univ.image c) ∪ Z
  have hZ' : Z'.card≤3*M+5 := by
    have h1 := card_union_le (univ.image c) Z
    have h2 := card_image_le (s := univ) (f := c)
    simp only [card_univ,Fintype.card_prod,Fintype.card_fin] at h2
    dsimp [Z']
    nlinarith
  let A (p : Fin M×Fin 4) := FourthMoment.common G U (c (p.1,armCenter p.2)) (r p.2.succ)
  obtain ⟨a,ha,haA⟩ := ShortSpider.select_avoiding A Z' (by
    intro p
    have h := hheavy _ (hcS p.1 p.2) p.2.succ
    change t≤(A p).card at h
    simp only [Fintype.card_prod,Fintype.card_fin]
    omega)
  let ae : Fin M×Fin 4 ↪ W := ⟨a,ha⟩
  apply contains_of_layout G M c ae r
  · intro i j he
    exact (haA j).2 (mem_union_left _ (mem_image.mpr ⟨i,mem_univ _,he⟩))
  · intro i j he
    exact hcavoid i (he.symm ▸ hrZ j)
  · intro i j he
    change a i=r j at he
    exact (haA i).2 (mem_union_right _ (he.symm ▸ hrZ j))
  · intro i
    have h := (mem_product.mp (mem_filter.mp (hE'E (hf i).1)).1).2
    exact ((mem_filter.mp h).2).symm
  · intro i j
    fin_cases j
    · exact ((mem_arcs.mp (hE' (hf i).1)).2.2).symm
    · exact ((mem_arcs.mp (hE' (hf i).2.1)).2.2).symm
  · intro i k
    exact (mem_filter.mp (haA (i,k)).1).2.1
  · intro i k
    exact (mem_filter.mp (haA (i,k)).1).2.2.symm

end Erdos571.MirrorSpider


/-! A bounded common-root fiber for the local heavy shadow. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]

def heavyThreshold (M K : ℕ) : ℕ := (6*M+11)*K^5+7*M+5

lemma heavy_induced_free (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (M K D : ℕ) (hK : 1≤K) (hf : (graph M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) :
    (completeBipartiteGraph (Fin 5) (Fin (D/K^5+1))).Free
      ((heavy (arcs G U) U (heavyThreshold M K)).induce (neighbors G U z : Set W)) := by
  classical
  rintro ⟨f⟩
  let p := D/K^5+1
  let old : Fin 5 ⊕ Fin p ↪ W := f.toEmbedding.trans (Function.Embedding.subtype _)
  let r : Fin 5 ↪ W := Function.Embedding.inl.trans old
  let S := univ.image (fun i : Fin p => old (.inr i))
  have holdU (a : Fin 5 ⊕ Fin p) : old a∈U := (mem_filter.mp (f a).property).1
  have hSU : S⊆U := by
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdU _
  have hrU (j : Fin 5) : r j∈U := holdU _
  have hS : S.card=p := by
    have hi : Function.Injective (fun i : Fin p => old (.inr i)) := old.injective.comp Sum.inr_injective
    simp only [S,card_image_of_injective _ hi,card_univ,Fintype.card_fin]
  have hheavy (u) (hu : u∈S) (j : Fin 5) :
      heavyThreshold M K≤(FourthMoment.common G U u (r j)).card := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    have h := f.toHom.map_adj (show (completeBipartiteGraph (Fin 5) (Fin p)).Adj (.inr i) (.inl j) by simp [completeBipartiteGraph])
    change old (.inr i)≠r j ∧ heavyThreshold M K≤(common (arcs G U) U (old (.inr i)) (r j)).card at h
    rw [ShortSpider.common_eq G U (holdU (.inr i)) (hrU j)] at h
    exact h.2
  have hmass : heavyThreshold M K*S.card≤(6*M+11)*D := by
    apply le_of_not_gt
    intro h
    exact hf (contains_of_heavy_roots G U S (heavyThreshold M K) M D
      (by dsimp [heavyThreshold]; omega) hdeg hSU r hrU hheavy h)
  have hscale : K^5*p≤D := by
    rw [hS] at hmass
    have hm : (6*M+11)*(K^5*p)≤(6*M+11)*D := by
      dsimp [heavyThreshold] at hmass
      nlinarith
    exact (mul_le_mul_iff_right₀ (by omega : 0<6*M+11)).mp hm
  have hKpos : 0<K^5 := pow_pos (by omega) _
  have hp : D<K^5*p := Nat.lt_mul_div_succ D hKpos
  omega

end Erdos571.MirrorSpider


/-! Arbitrarily small quadratic heavy-path mass, with a linear remainder. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]

lemma scale_power (D K : ℕ) (hK : 1≤K) : (D/K^5)*D^4<(D/K+1)^5 := by
  have hKpos : 0<K := by omega
  have h1 : ((D/K^5)*D^4)*K^5≤D^5 := by
    calc
      _ = ((D/K^5)*K^5)*D^4 := by ring
      _ ≤ D*D^4 := Nat.mul_le_mul_right _ (Nat.div_mul_le_self _ _)
      _ = _ := by ring
  have h2 := Nat.pow_lt_pow_left (Nat.lt_mul_div_succ D hKpos) (by decide : 5≠0)
  have h3 : ((D/K^5)*D^4)*K^5<(D/K+1)^5*K^5 := by
    simpa only [mul_pow,mul_comm (K^5)] using h1.trans_lt h2
  exact (mul_lt_mul_iff_left₀ (pow_pos hKpos 5)).mp h3

lemma heavy_pairs_nat (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (M K D : ℕ) (hK : 1≤K) (hf : (graph M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (heavyPairs (arcs G U) U (heavyThreshold M K) (neighbors G U z)).card≤
      2*(D/K+7)*D := by
  classical
  let H := (heavy (arcs G U) U (heavyThreshold M K)).induce (neighbors G U z : Set W)
  have hn : Fintype.card (neighbors G U z : Set W)=(neighbors G U z).card :=
    Fintype.card_of_finset' (p := (neighbors G U z : Set W)) _ (fun _ => Iff.rfl)
  have hsize : Fintype.card (neighbors G U z : Set W)≤D := by
    simpa only [hn] using hdeg z hz
  have hpow := scale_power D K hK
  have hb := TreeCount.edge_bound_of_no_commonRootCopies (KstUpper.Star 5) (KstUpper.star_tree 5)
    (D/K+1) (D/K^5) D (by simpa only [Fintype.card_fin,Fintype.card_sum] using hpow) H hsize
    (fun h => heavy_induced_free G U M K D hK hf hdeg z (KstUpper.contained_of_common_roots H h))
  have hb' : Nat.card H.edgeSet≤(D/K+7)*(neighbors G U z).card := by
    simpa only [Nat.card_eq_fintype_card,card_edgeSet,Fintype.card_sum,Fintype.card_fin,
      hn,show 1+5=6 from rfl,show D/K+1+6=D/K+7 by omega] using hb
  rw [heavyPairs_card]
  exact (Nat.mul_le_mul_left 2 hb').trans (by nlinarith [Nat.mul_le_mul_left (2*(D/K+7)) (hdeg z hz)])

lemma heavy_pairs_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (M K : ℕ) (hK : 1≤K) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) (z : W) (hz : z∈U) :
    ((heavyPairs (arcs G U) U (heavyThreshold M K) (neighbors G U z)).card:ℝ)≤
      2/(K:ℝ)*D^2+14*D := by
  have hb := heavy_pairs_nat G U M K ⌊D⌋₊ hK hf (fun v hv => Nat.le_floor (hdeg v hv)) z hz
  have hb' : ((heavyPairs (arcs G U) U (heavyThreshold M K) (neighbors G U z)).card:ℝ)≤
      2*((⌊D⌋₊/K:ℕ)+7:ℝ)*(⌊D⌋₊:ℝ) := by exact_mod_cast hb
  have hKpos : (0:ℝ)<K := by exact_mod_cast (show 0<K by omega)
  have hdiv : (⌊D⌋₊/K:ℕ)*(K:ℝ)≤D := by
    have h : (⌊D⌋₊/K:ℕ)*(K:ℝ)≤(⌊D⌋₊:ℝ) := by exact_mod_cast Nat.div_mul_le_self ⌊D⌋₊ K
    exact h.trans (Nat.floor_le hD)
  have hquot := (le_div_iff₀ hKpos).mpr hdiv
  calc
    _ ≤ 2*((⌊D⌋₊/K:ℕ)+7:ℝ)*(⌊D⌋₊:ℝ) := hb'
    _ ≤ 2*(D/(K:ℝ)+7)*D := by gcongr; exact Nat.floor_le hD
    _ = _ := by ring

theorem badPairs_sum_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (M K : ℕ) (hK : 1≤K) (hf : (graph M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold M K) v).card:ℝ))≤
      U.card*(2/(K:ℝ)*D^2+15*D) := by
  have hh : (∑v∈U, ((heavyPairs (arcs G U) U (heavyThreshold M K) (neighbors G U v)).card:ℝ))≤
      U.card*(2/(K:ℝ)*D^2+14*D) := by
    exact (sum_le_sum (fun v hv => heavy_pairs_bound G U M K hK hf hD hdeg v hv)).trans_eq (by simp [mul_add])
  have h := ThetaFour.badPairs_sum_bound G U (heavyThreshold M K) hdeg
  nlinarith

end Erdos571.MirrorSpider


/-! Choose the heavy scale first, then absorb lower-degree errors. -/
namespace Erdos571.MirrorSpider
open Filter Asymptotics

lemma exists_error_threshold (Q : ℝ) (M : ℕ) (hQ : 1≤Q) :
    ∃K : ℕ, 1≤K ∧ ∃L : ℝ, 52≤L ∧ ∀d : ℝ, L≤d →
      1728*(2/(K:ℝ)*(Q*d)^2+15*(Q*d))*(Q*d)^9+
      6*Real.sqrt ((M:ℝ)+4)*(Q*d)^10*Real.sqrt (Q*d)≤(d/4)^11/2 := by
  obtain ⟨K,hK⟩ := exists_nat_gt (13824*4^11*Q^11)
  have hQpos : 0<Q := by linarith
  have hKpos : (0:ℝ)<K := lt_trans (by positivity) hK
  have hK1 : 1≤K := by exact_mod_cast (show 0<K by exact_mod_cast hKpos)
  have hsmall : 3456*Q^11/(K:ℝ)≤1/(4*4^11) := by
    apply (div_le_iff₀ hKpos).mpr
    norm_num at hK ⊢
    nlinarith
  let A : ℝ := 25920*Q^10
  let B : ℝ := 6*Real.sqrt ((M:ℝ)+4)*Q^10*Real.sqrt Q
  have ho : (fun d : ℝ => A*d^(10:ℝ)+B*d^(21/2:ℝ))=o[atTop] (fun d => d^(11:ℝ)) :=
    ((ThetaFour.rpow_littleO (by norm_num : (10:ℝ)<11)).const_mul_left A).add
      ((ThetaFour.rpow_littleO (by norm_num : (21/2:ℝ)<11)).const_mul_left B)
  obtain ⟨L,hL⟩ := eventually_atTop.mp (ho.def (c := 1/(4*4^11)) (by norm_num))
  refine ⟨K,hK1,max 52 L,le_max_left _ _,?_⟩
  intro d hd
  have hdpos : 0<d := lt_of_lt_of_le (by norm_num : (0:ℝ)<52) ((le_max_left _ _).trans hd)
  have h := hL d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hdpos.le _)] at h
  have herr := (le_abs_self (A*d^(10:ℝ)+B*d^(21/2:ℝ))).trans h
  have hmain := mul_le_mul_of_nonneg_right hsmall (pow_nonneg hdpos.le 11)
  have he : 1728*(2/(K:ℝ)*(Q*d)^2+15*(Q*d))*(Q*d)^9+
      6*Real.sqrt ((M:ℝ)+4)*(Q*d)^10*Real.sqrt (Q*d)=
      A*d^(10:ℝ)+B*d^(21/2:ℝ)+(3456*Q^11/(K:ℝ))*d^11 := by
    dsimp [A,B]
    rw [show (21/2:ℝ)=10+1/2 by norm_num,Real.rpow_add hdpos,Real.sqrt_mul hQpos.le,
      Real.sqrt_eq_rpow d]
    norm_num only [Real.rpow_ofNat,Real.rpow_natCast]
    ring
  rw [he]
  norm_num only [Real.rpow_ofNat,Real.rpow_natCast,div_pow] at herr ⊢
  nlinarith

lemma degree_of_power {n d A : ℝ} (hn : 0≤n) (hd : 0≤d) (hA : 0≤A)
    (h : d^11≤A*n^4) : d≤A^(1/11:ℝ)*n^(4/11:ℝ) := by
  have hh := Real.rpow_le_rpow (show 0≤d^11 by positivity) h (by norm_num : (0:ℝ)≤1/11)
  rw [Real.mul_rpow hA (pow_nonneg hn _)] at hh
  have hd' : (d^11)^(1/11:ℝ)=d := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hd]
    norm_num
  have hn' : (n^4)^(1/11:ℝ)=n^(4/11:ℝ) := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hn]
    congr 1
    norm_num
  rwa [hd',hn'] at hh

end Erdos571.MirrorSpider


/-! Sharp ordinary upper bounds for the symmetric mirror-spider powers. -/
namespace Erdos571.MirrorSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeCoefficient (M K : ℕ) : ℝ :=
  ((2*4^11*(7*M*copyLoad (heavyThreshold M K) M) : ℕ) : ℝ)^(1/11 : ℝ)

lemma degreeCoefficient_nonneg (M K : ℕ) : 0≤degreeCoefficient M K := by
  unfold degreeCoefficient
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (M K : ℕ) (hM : 1≤M) (hK : 1≤K) (hf : (graph M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 52≤d)
    (herr : 1728*(2/(K:ℝ)*(Q*d)^2+15*(Q*d))*(Q*d)^9+
      6*Real.sqrt ((M:ℝ)+4)*(Q*d)^10*Real.sqrt (Q*d)≤(d/4)^11/2)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card : ℝ) ∧ ((neighbors G U v).card : ℝ)≤Q*d) :
    d≤degreeCoefficient M K*(U.card : ℝ)^(4/11 : ℝ) := by
  classical
  have hd0 : 0≤d := by linarith
  have hD : 0≤Q*d := by positivity
  have hn : (0 : ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  let F := TreeCopiesIn.copies template G U
  have hl : (U.card : ℝ)*(d/4)^11≤F.card := by
    have hh := TreeCopiesIn.lower template isTree G U (d := d) (by norm_num [Vertex]; exact hd)
      (fun v hv => (hdeg v hv).1)
    simpa [Vertex] using hh
  have hu := all_count G U (heavyThreshold M K) M (by dsimp [heavyThreshold]; omega) hM hf hD
    (fun v hv => (hdeg v hv).2) F (fun f hf => (TreeCopiesIn.mem_copies template G U f).mp hf)
  have hbad := badPairs_sum_bound G U M K hK hf hD (fun v hv => (hdeg v hv).2)
  have hbad' := mul_le_mul_of_nonneg_right hbad (show 0≤1728*(Q*d)^9 by positivity)
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (d/4)^11≤2*(7*M*copyLoad (heavyThreshold M K) M : ℕ)*(U.card:ℝ)^4 := by
    apply (mul_le_mul_iff_right₀ hn).mp
    nlinarith
  have hpower : d^11≤((2*4^11*(7*M*copyLoad (heavyThreshold M K) M) : ℕ) : ℝ)*(U.card:ℝ)^4 := by
    norm_num only [div_pow] at hm
    push_cast
    norm_num at hm ⊢
    nlinarith
  exact degree_of_power hn.le hd0 (by positivity) hpower

/-- Every fixed almost-regular degree ratio admits the sharp exponent. -/
theorem exists_regular_bound (M : ℕ) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj)
        (g : W → Bool), (∀{u v}, G.Adj u v → g u≠g v) → (graph M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(15/11:ℝ) := by
  obtain ⟨K,hK,L,hL,herr⟩ := exists_error_threshold Q M hQ
  let B := degreeCoefficient M K
  have hB : 0 ≤ B := degreeCoefficient_nonneg M K
  refine ⟨Q*(L+B),by positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^(4/11:ℝ) := Real.one_le_rpow hn1 (by norm_num)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^(4/11:ℝ) := by
    by_cases hdl : d ≤ L
    · nlinarith
    · have hl := large_degree_bound G U hU M K hM hK hf g hg hQ (hL.trans (le_of_not_ge hdl)) (herr d (le_of_not_ge hdl)) hdeg
      have hnn : 0 ≤ (U.card:ℝ)^(4/11:ℝ) := by positivity
      change d ≤ B*_ at hl
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^(4/11:ℝ)) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [show (15/11:ℝ)=1+4/11 by norm_num,Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp upper bound for every fixed mirror-spider multiplicity. -/
theorem edge_bound (M : ℕ) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph M) (15/11:ℝ) D := by
  let γ : ℝ := 4/11
  have hγ : 0 < γ := by norm_num [γ]
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((15/11:ℝ)-1) := by
    dsimp [K]
    rw [show (15/11:ℝ)-1=γ by norm_num [γ],Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound M hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=15/11) (K:=K) (D:=D)
    (by norm_num) (by norm_num) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.MirrorSpider


/-! Exact rational exponents from mirror-spider and its paired cones. -/
namespace Erdos571.MirrorSpider
open Finset SimpleGraph OrdinaryRooted

theorem supported : Supported template (2-(7:ℝ)/11) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound M (by omega)
  norm_num
  exact ⟨D,hD,hbound⟩

theorem certificate : Certificate 7 11 :=
  ⟨Fin 7,Fin 5,inferInstance,inferInstance,inferInstance,inferInstance,
    template,color,color_proper,connected,no_isolated,balance,supported⟩

theorem iterated_certificate (t : ℕ) : Certificate 7 (11+7*t) := by
  induction t with
  | zero => simpa using certificate
  | succ t ih =>
    have h := ih.cone (by omega) (by omega)
    convert h using 1 <;> omega

/-- The mirror-spider family includes the exact exponent `15/11`. -/
theorem exact_family (t : ℕ) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-7/(11+7*t:ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate t).realizes (by omega) (by omega)
  push_cast at h ⊢
  exact h

theorem exponent_fifteen_elevenths :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((15/11:ℚ):ℝ)) := by
  have h := exact_family 0
  norm_num at h ⊢
  exact h

end Erdos571.MirrorSpider


/-! Vertex-disjoint, color-preserving tree copies from a minimum-degree bound. -/
namespace Erdos571.ColoredTreePacking
open Finset SimpleGraph DensityRegularization
variable {A W : Type} [Fintype A] [Fintype W] [DecidableEq W]

lemma colors_eq (H : SimpleGraph A) (hH : H.Connected) (c d : A → Bool)
    (hc : ∀{u v}, H.Adj u v → c u≠c v) (hd : ∀{u v}, H.Adj u v → d u≠d v)
    (a : A) (ha : c a=d a) : ∀v, c v=d v := by
  have he {u v} (h : H.Adj u v) : c u=d u ↔ c v=d v := by
    have h1 := hc h
    have h2 := hd h
    cases hcu : c u <;> cases hcv : c v <;> cases hdu : d u <;> cases hdv : d v <;> simp_all
  have hw {u v : A} (p : H.Walk u v) : c u=d u ↔ c v=d v := by
    clear ha
    induction p with
    | nil => rfl
    | cons h p ih => exact (he h).trans ih
  intro v
  obtain ⟨p⟩ := hH.preconnected a v
  exact (hw p).mp ha

lemma exists_pinned_avoiding (H : SimpleGraph A) (hH : H.IsTree)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U Z : Finset W) (a : A) (x : W)
    (hx : x∈U) (hxZ : x∉Z)
    (hdeg : ∀v∈U, 1+Fintype.card A+Z.card≤(neighbors G U v).card) :
    ∃f : H.Copy G, f a=x ∧ (∀v, f v∈U) ∧ ∀v, f v∉Z := by
  classical
  have h := TreeCopiesIn.centered_avoiding_lower_nat H hH G U {x} Z a
    (by simpa) (by simpa using hxZ) 1 hdeg
  simp only [card_singleton,one_pow,mul_one] at h
  obtain ⟨f,hf⟩ := card_pos.mp (lt_of_lt_of_le (by omega : 0<1) h)
  obtain ⟨hfU,hfx,hfZ⟩ := (TreeCopiesIn.mem_centeredAvoiding _ _ _ _ _ _ _).mp hf
  exact ⟨f,mem_singleton.mp hfx,hfU,hfZ⟩

theorem pack (H : SimpleGraph A) (hH : H.IsTree) (c : A → Bool)
    (hc : ∀{u v}, H.Adj u v → c u≠c v) (a : A) (ha : c a=true)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U Y Z : Finset W)
    (hYU : Y⊆U) (hY : ∀y∈Y, g y=true) (M : ℕ)
    (hcard : M*Fintype.card A+Z.card<Y.card)
    (hdeg : ∀v∈U, M*Fintype.card A+Z.card+1≤(neighbors G U v).card) :
    ∃f : Fin M → H.Copy G,
      (∀i v, f i v∈U ∧ f i v∉Z ∧ g (f i v)=c v) ∧
      Pairwise (fun i j => Disjoint (univ.image (f i)) (univ.image (f j))) := by
  classical
  induction M generalizing Z with
  | zero => exact ⟨Fin.elim0,by intro i; exact Fin.elim0 i,by intro i; exact Fin.elim0 i⟩
  | succ M ih =>
    obtain ⟨x,hxY,hxZ⟩ := exists_mem_notMem_of_card_lt_card (show Z.card<Y.card by omega)
    obtain ⟨f,hfa,hfU,hfZ⟩ := exists_pinned_avoiding H hH G U Z a x (hYU hxY) hxZ (by
      intro v hv
      have h := hdeg v hv
      nlinarith)
    have hfc : ∀v, g (f v)=c v := fun v =>
      (colors_eq H hH.isConnected c (fun v => g (f v)) hc
        (fun h => hg (f.toHom.map_adj h)) a (by change c a = g (f a); rw [hfa,ha,hY x hxY]) v).symm
    let Z' := Z ∪ univ.image f
    have hZ' : Z'.card≤Z.card+Fintype.card A :=
      (card_union_le _ _).trans (Nat.add_le_add_left (by simpa using card_image_le (s := univ) (f := f)) _)
    obtain ⟨fs,hfs,hdis⟩ := ih Z' (by nlinarith) (by intro v hv; have h := hdeg v hv; nlinarith)
    refine ⟨Fin.cons f fs,?_,?_⟩
    · intro i v
      induction i using Fin.cases with
      | zero => exact ⟨hfU v,hfZ v,hfc v⟩
      | succ i => exact ⟨(hfs i v).1,fun h => (hfs i v).2.1 (mem_union_left _ h),(hfs i v).2.2⟩
    · have hfsdis (i : Fin M) : Disjoint (univ.image f) (univ.image (fs i)) := by
        apply Finset.disjoint_left.mpr
        intro w hw hw'
        obtain ⟨v,hv,rfl⟩ := mem_image.mp hw'
        exact (hfs i v).2.1 (mem_union_right _ hw)
      intro i j hij
      induction i using Fin.cases with
      | zero => induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j => exact hfsdis j
      | succ i => induction j using Fin.cases with
        | zero => exact (hfsdis i).symm
        | succ j => exact hdis (fun he => hij (congrArg Fin.succ he))

end Erdos571.ColoredTreePacking


/-! Color-preserving disjoint tree packing from a density hypothesis. -/
namespace Erdos571.ColoredTreePacking
open Finset SimpleGraph DensityRegularization
variable {A W : Type} [Fintype A] [Fintype W] [DecidableEq W]

lemma pack_of_arcs (H : SimpleGraph A) (hH : H.IsTree) (c : A → Bool)
    (hc : ∀{u v}, H.Adj u v → c u≠c v) (a : A) (ha : c a=true)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W) (M : ℕ)
    (hm : 2*(M*Fintype.card A+1)*U.card < (arcs G U).card) :
    ∃f : Fin M → H.Copy G,
      (∀i v, f i v∈U ∧ g (f i v)=c v) ∧
      Pairwise (fun i j => Disjoint (univ.image (f i)) (univ.image (f j))) := by
  classical
  let δ : ℕ := M*Fintype.card A+1
  obtain ⟨T,hTU,hpot,hmin⟩ := exists_min_degree_subset G U (2*(δ:ℝ))
  have hpos : 0 < ((arcs G T).card:ℝ)-2*(δ:ℝ)*T.card := by
    have h : (2:ℝ)*δ*U.card < (arcs G U).card := by exact_mod_cast hm
    linarith
  have hdeg (v) (hv : v∈T) : δ ≤ (neighbors G T v).card := by
    have h := hmin v hv
    exact_mod_cast (show (δ:ℝ)≤(neighbors G T v).card by linarith)
  have hE : 0 < (arcs G T).card := by
    have hnon : 0 ≤ 2*(δ:ℝ)*T.card := by positivity
    exact_mod_cast (show (0:ℝ)<(arcs G T).card by linarith)
  obtain ⟨⟨u,v⟩,huv⟩ := card_pos.mp hE
  obtain ⟨hu,hv,hadj⟩ := mem_arcs.mp huv
  have hw : ∃w∈T, g w=false := by
    cases hgu : g u with
    | false => exact ⟨u,hu,hgu⟩
    | true =>
      refine ⟨v,hv,?_⟩
      have h := hg hadj
      cases hgv : g v <;> simp_all
  obtain ⟨w,hw,hwg⟩ := hw
  let Y := T.filter (fun x => g x=true)
  have hY : neighbors G T w⊆Y := by
    intro x hx
    obtain ⟨hx,hadj⟩ := mem_filter.mp hx
    refine mem_filter.mpr ⟨hx,?_⟩
    have h := hg hadj
    cases hgx : g x <;> simp_all
  have hcard : M*Fintype.card A+(∅:Finset W).card<Y.card := by
    have h := (hdeg w hw).trans (card_le_card hY)
    simp only [card_empty,add_zero]
    dsimp [δ] at h
    omega
  obtain ⟨f,hf,hdis⟩ := pack H hH c hc a ha G g hg T Y ∅
    (filter_subset _ _) (fun y hy => (mem_filter.mp hy).2) M hcard (by
      intro v hv
      simpa only [card_empty,add_zero] using hdeg v hv)
  exact ⟨f,fun i v => ⟨hTU (hf i v).1,(hf i v).2.2⟩,hdis⟩

end Erdos571.ColoredTreePacking


/-! Rooted trees with a distinguished short root and two-edge root arms. -/
namespace Erdos571.AnchoredArms
open Finset SimpleGraph
variable {A I W : Type} [Fintype A] [Fintype I] [Fintype W]

abbrev Vertex (A I : Type) := (A ⊕ I) ⊕ (Unit ⊕ I)

def template (K : SimpleGraph A) (a₀ : A) (attach : I → A) : SimpleGraph (Vertex A I) where
  Adj x y := match x,y with
    | .inl (.inl a), .inl (.inl b) => K.Adj a b
    | .inl (.inl a), .inl (.inr i) => a=attach i
    | .inl (.inr i), .inl (.inl a) => attach i=a
    | .inl (.inl a), .inr (.inl _) => a=a₀
    | .inr (.inl _), .inl (.inl a) => a₀=a
    | .inl (.inr i), .inr (.inr j) => i=j
    | .inr (.inr j), .inl (.inr i) => j=i
    | _,_ => False
  symm := by
    rintro ((a|i)|(u|j)) ((b|k)|(v|l)) h <;> first | exact h.symm | exact h
  loopless := by
    rintro ((a|i)|(u|j)) <;> first | exact K.loopless _ | exact id

def color (c : A → Bool) : Vertex A I → Bool
  | .inl (.inl a) => c a
  | .inl (.inr _) => true
  | .inr _ => false

lemma color_proper (K : SimpleGraph A) (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{a b}, K.Adj a b → c a≠c b) (ha₀ : c a₀=true)
    (hattach : ∀i, c (attach i)=false) :
    ∀{u v}, (template K a₀ attach).Adj u v → color c u≠color c v := by
  rintro ((a|i)|(u|j)) ((b|k)|(v|l)) h <;>
    simp only [template] at h <;> simp only [color]
  all_goals first
    | exact hc h
    | exact h.elim
    | subst a; simp [ha₀,hattach]
    | subst b; simp [ha₀,hattach]
    | simp

abbrev graph (K : SimpleGraph A) (a₀ : A) (attach : I → A) (M : ℕ) :=
  FullRootedPower.graph (template K a₀ attach) M

lemma contains_of_layout (K : SimpleGraph A) (a₀ : A) (attach : I → A)
    (G : SimpleGraph W) (M : ℕ) (f : Fin M×A ↪ W) (m : Fin M×I ↪ W)
    (r : Unit⊕I ↪ W)
    (hfm : ∀p q, f p≠m q) (hfr : ∀p q, f p≠r q) (hmr : ∀p q, m p≠r q)
    (hf : ∀i a b, K.Adj a b → G.Adj (f (i,a)) (f (i,b)))
    (hroot : ∀i, G.Adj (f (i,a₀)) (r (.inl ())))
    (harm : ∀i j, G.Adj (f (i,attach j)) (m (i,j)) ∧ G.Adj (m (i,j)) (r (.inr j))) :
    graph K a₀ attach M ⊑ G := by
  let e : ((Fin M×(A⊕I))⊕(Unit⊕I)) → W
    | .inl (i,.inl a) => f (i,a)
    | .inl (i,.inr j) => m (i,j)
    | .inr q => r q
  have he : Function.Injective e := by
    rintro ((⟨i,a|j⟩)|q) ((⟨i',a'|j'⟩)|q') h
    · have h' := f.injective h
      cases h'
      rfl
    · exact (hfm _ _ h).elim
    · exact (hfr _ _ h).elim
    · exact (hfm _ _ h.symm).elim
    · have h' := m.injective h
      cases h'
      rfl
    · exact (hmr _ _ h).elim
    · exact (hfr _ _ h.symm).elim
    · exact (hmr _ _ h.symm).elim
    · exact congrArg Sum.inr (r.injective h)
  refine ⟨{toHom := {toFun := e, map_rel' := ?_}, injective' := he}⟩
  rintro ((⟨i,a|j⟩)|(u|q)) ((⟨i',a'|j'⟩)|(u'|q')) h <;>
    simp only [graph,FullRootedPower.graph,template] at h <;> simp only [e]
  all_goals first
    | exact h.elim
    | exact h.2.elim
    | rcases h with ⟨rfl,h⟩; exact hf _ _ _ h
    | rcases h with ⟨rfl,rfl⟩; exact (harm _ _).1
    | rcases h with ⟨rfl,rfl⟩; exact (harm _ _).1.symm
    | subst a; cases u'; exact hroot _
    | subst a'; cases u; exact (hroot _).symm
    | subst j; exact (harm _ _).2
    | cases h; exact (harm _ _).2.symm

end Erdos571.AnchoredArms


/-! A generic heavy-root embedding lemma for an anchored tree core. -/
set_option maxHeartbeats 2000000
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization
variable {A I W : Type} [Fintype A] [Fintype I] [Fintype W] [DecidableEq W]

def massCoeff (A I : Type) [Fintype A] [Fintype I] (M : ℕ) : ℕ :=
  4*(M*Fintype.card A+1)+2*(Fintype.card I+1)

def vertexCount (A I : Type) [Fintype A] [Fintype I] (M : ℕ) : ℕ :=
  M*(Fintype.card A+Fintype.card I)+(Fintype.card I+1)

theorem contains_of_heavy_roots (K : SimpleGraph A) (hK : K.IsTree)
    (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (ha₀ : c a₀=true)
    (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (U S : Finset W) (t M D : ℕ) (ht : vertexCount A I M≤t)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (hSU : S⊆U) (hS : S.card≤D)
    (hSg : ∀s∈S, g s=false)
    (r : Unit⊕I ↪ W) (hrU : ∀j, r j∈U) (hrg : ∀j, g (r j)=false)
    (hheavy : ∀u∈S, ∀j, t≤(FourthMoment.common G U u (r j)).card)
    (hlarge : massCoeff A I M*D<t*S.card) : graph K a₀ attach M ⊑ G := by
  classical
  let Y := neighbors G U (r (.inl ()))
  have hY : Y.card≤D := hdeg _ (hrU _)
  have hYg (y) (hy : y∈Y) : g y=true := by
    have h := hg (mem_filter.mp hy).2
    have hr := hrg (.inl ())
    cases hgy : g y <;> simp_all
  let E := (S×ˢY).filter (fun p => G.Adj p.1 p.2)
  have hE : E⊆arcs G U := by
    intro e he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨hSU hs,(mem_filter.mp hy).1,ha⟩
  have hl := DirectedDegreeBounds.left G U E hE D hdeg
  have hh := DirectedDegreeBounds.right G U E hE D hdeg
  have hcount : t*S.card≤E.card := by
    rw [rectangle_card]
    have hC (u : W) : neighbors G Y u=FourthMoment.common G U u (r (.inl ())) := by
      ext v
      simp only [neighbors,Y,FourthMoment.common,mem_filter]
      tauto
    simp_rw [hC]
    exact (show t*S.card=∑_u∈S,t by simp [mul_comm]).trans_le
      (sum_le_sum (fun u hu => hheavy u hu (.inl ())))
  let Z := univ.image r
  have hZ : Z.card=Fintype.card I+1 := by
    simp [Z,card_image_of_injective _ r.injective,Nat.add_comm]
  let E' := CherryPacking.avoid E Z
  let U' := (S∪Y)\Z
  have hU' : U'.card≤2*D := by
    have h1 := card_le_card (sdiff_subset (s:=S∪Y) (t:=Z))
    have h2 := card_union_le S Y
    dsimp [U']
    omega
  have hrem := CherryPacking.remove_bound E Z D hl hh
  have hcard : 4*(M*Fintype.card A+1)*D<E'.card := by
    change E.card≤E'.card+2*Z.card*D at hrem
    rw [hZ] at hrem
    dsimp [massCoeff] at hlarge
    nlinarith
  have hE' : E'⊆arcs G U' := by
    intro e he
    obtain ⟨he,havoid⟩ := mem_filter.mp he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨mem_sdiff.mpr ⟨mem_union_left _ hs,havoid.1⟩,
      mem_sdiff.mpr ⟨mem_union_right _ hy,havoid.2⟩,ha⟩
  have hmass : 2*(M*Fintype.card A+1)*U'.card<(arcs G U').card := by
    have h1 := card_le_card hE'
    have h2 := Nat.mul_le_mul_left (2*(M*Fintype.card A+1)) hU'
    nlinarith
  obtain ⟨f,hf,hdis⟩ := ColoredTreePacking.pack_of_arcs K hK c hc a₀ ha₀ G g hg U' M hmass
  let core : Fin M×A ↪ W :=
    { toFun := fun p => f p.1 p.2
      inj' := by
        rintro ⟨i,a⟩ ⟨j,b⟩ he
        change f i a=f j b at he
        by_cases hij : i=j
        · subst j
          exact Prod.ext rfl ((f i).injective he)
        · exact (Finset.disjoint_left.mp (hdis hij) (mem_image.mpr ⟨a,mem_univ _,rfl⟩)
            (mem_image.mpr ⟨b,mem_univ _,he.symm⟩)).elim }
  have hcore (p : Fin M×A) : core p∈U' ∧ g (core p)=c p.2 := hf p.1 p.2
  have hcavoid (p : Fin M×A) : core p∉Z := (mem_sdiff.mp (hcore p).1).2
  have hcS (i : Fin M) (j : I) : core (i,attach j)∈S := by
    obtain hs|hy := mem_union.mp (mem_sdiff.mp (hcore (i,attach j)).1).1
    · exact hs
    · have h := hYg _ hy
      have h' := (hcore (i,attach j)).2
      rw [hattach] at h'
      simp_all
  have hcY (i : Fin M) : core (i,a₀)∈Y := by
    obtain hs|hy := mem_union.mp (mem_sdiff.mp (hcore (i,a₀)).1).1
    · have h := hSg _ hs
      have h' := (hcore (i,a₀)).2
      rw [ha₀] at h'
      simp_all
    · exact hy
  have hrZ (j : Unit⊕I) : r j∈Z := mem_image.mpr ⟨j,mem_univ _,rfl⟩
  let Z' := (univ.image core) ∪ Z
  have hZ' : Z'.card≤M*Fintype.card A+(Fintype.card I+1) := by
    have h1 := card_union_le (univ.image core) Z
    have h2 := card_image_le (s := univ) (f := core)
    simp only [card_univ,Fintype.card_prod,Fintype.card_fin] at h2
    dsimp [Z']
    omega
  let F (p : Fin M×I) := FourthMoment.common G U (core (p.1,attach p.2)) (r (.inr p.2))
  obtain ⟨m,hm,hmF⟩ := ShortSpider.select_avoiding F Z' (by
    intro p
    have h := hheavy _ (hcS p.1 p.2) (.inr p.2)
    change t≤(F p).card at h
    simp only [Fintype.card_prod,Fintype.card_fin]
    dsimp [vertexCount] at ht
    nlinarith)
  let mid : Fin M×I ↪ W := ⟨m,hm⟩
  apply contains_of_layout K a₀ attach G M core mid r
  · intro i j he
    exact (hmF j).2 (mem_union_left _ (mem_image.mpr ⟨i,mem_univ _,he⟩))
  · intro i j he
    exact hcavoid i (he.symm ▸ hrZ j)
  · intro i j he
    change m i=r j at he
    exact (hmF i).2 (mem_union_right _ (he.symm ▸ hrZ j))
  · intro i a b hab
    exact (f i).toHom.map_adj hab
  · intro i
    exact ((mem_filter.mp (hcY i)).2).symm
  · intro i j
    exact ⟨(mem_filter.mp (hmF (i,j)).1).2.1,(mem_filter.mp (hmF (i,j)).1).2.2.symm⟩

end Erdos571.AnchoredArms


/-! Local heavy shadows for arbitrary anchored tree cores. -/
set_option maxHeartbeats 2000000
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {A I W : Type} [Fintype A] [Fintype I] [Fintype W] [DecidableEq W]

def heavyThreshold (A I : Type) [Fintype A] [Fintype I] (M L : ℕ) : ℕ :=
  massCoeff A I M*L^(Fintype.card I+1)+vertexCount A I M

lemma heavy_induced_free (K : SimpleGraph A) (hK : K.IsTree)
    (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (ha₀ : c a₀=true)
    (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
    (M L D : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (completeBipartiteGraph (Fin (Fintype.card I+1)) (Fin (D/L^(Fintype.card I+1)+1))).Free
      ((heavy (arcs G U) U (heavyThreshold A I M L)).induce (neighbors G U z : Set W)) := by
  classical
  rintro ⟨f⟩
  let n := Fintype.card I+1
  let p := D/L^n+1
  let e : Unit⊕I ≃ Fin n := Fintype.equivOfCardEq (by simp [n,Nat.add_comm])
  let old : Fin n⊕Fin p ↪ W := f.toEmbedding.trans (Function.Embedding.subtype _)
  let r : Unit⊕I ↪ W := e.toEmbedding.trans (Function.Embedding.inl.trans old)
  let S := univ.image (fun i : Fin p => old (.inr i))
  have holdN (a : Fin n⊕Fin p) : old a∈neighbors G U z := (f a).property
  have holdU (a : Fin n⊕Fin p) : old a∈U := (mem_filter.mp (holdN a)).1
  have hSU : S⊆U := by
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdU _
  have hrU (j : Unit⊕I) : r j∈U := holdU _
  have hS : S.card=p := by
    have hi : Function.Injective (fun i : Fin p => old (.inr i)) := old.injective.comp Sum.inr_injective
    simp only [S,card_image_of_injective _ hi,card_univ,Fintype.card_fin]
  have hsize : S.card≤D := by
    apply le_trans _ (hdeg z hz)
    apply card_le_card
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdN _
  let g' : W → Bool := fun w => if g w=g z then true else false
  have hg' {u v} (h : G.Adj u v) : g' u≠g' v := by
    have h' := hg h
    cases hgu : g u <;> cases hgv : g v <;> cases hgz : g z <;> simp_all [g']
  have hNz (w) (hw : w∈neighbors G U z) : g' w=false := by
    have h := hg (mem_filter.mp hw).2
    simp [g',Ne.symm h]
  have hSg (w) (hw : w∈S) : g' w=false := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hw
    exact hNz _ (holdN _)
  have hrg (j : Unit⊕I) : g' (r j)=false := hNz _ (holdN _)
  have hheavy (u) (hu : u∈S) (j : Unit⊕I) :
      heavyThreshold A I M L≤(FourthMoment.common G U u (r j)).card := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    have h := f.toHom.map_adj (show (completeBipartiteGraph (Fin n) (Fin p)).Adj (.inr i) (.inl (e j)) by simp [completeBipartiteGraph])
    change old (.inr i)≠r j ∧ heavyThreshold A I M L≤(common (arcs G U) U (old (.inr i)) (r j)).card at h
    rw [ShortSpider.common_eq G U (holdU (.inr i)) (hrU j)] at h
    exact h.2
  have hmass : heavyThreshold A I M L*S.card≤ massCoeff A I M*D := by
    apply le_of_not_gt
    intro h
    exact hf (contains_of_heavy_roots K hK a₀ attach c hc ha₀ hattach G g' hg' U S
      (heavyThreshold A I M L) M D (by dsimp [heavyThreshold]; omega)
      hdeg hSU hsize hSg r hrU hrg hheavy h)
  have hscale : L^n*p≤D := by
    rw [hS] at hmass
    have hm : massCoeff A I M*(L^n*p)≤ massCoeff A I M*D := by
      dsimp [heavyThreshold] at hmass
      change (massCoeff A I M*L^n+vertexCount A I M)*p≤ massCoeff A I M*D at hmass
      nlinarith
    exact (mul_le_mul_iff_right₀ (by dsimp [massCoeff]; omega : 0< massCoeff A I M)).mp hm
  have hLpos : 0<L^n := pow_pos (by omega) _
  have hp : D<L^n*p := Nat.lt_mul_div_succ D hLpos
  omega

end Erdos571.AnchoredArms


/-! Arbitrarily small quadratic heavy-path mass for any anchored tree core. -/
set_option maxHeartbeats 2000000
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {A I W : Type} [Fintype A] [Fintype I] [Fintype W] [DecidableEq W]

lemma scale_power (D L k : ℕ) (hL : 1≤L) : (D/L^(k+1))*D^k<(D/L+1)^(k+1) := by
  have hLpos : 0<L := by omega
  have h1 : ((D/L^(k+1))*D^k)*L^(k+1)≤D^(k+1) := by
    calc
      _ = ((D/L^(k+1))*L^(k+1))*D^k := by ring
      _ ≤ D*D^k := Nat.mul_le_mul_right _ (Nat.div_mul_le_self _ _)
      _ = _ := by ring
  have h2 := Nat.pow_lt_pow_left (Nat.lt_mul_div_succ D hLpos) (by omega : k+1≠0)
  have h3 : ((D/L^(k+1))*D^k)*L^(k+1)<(D/L+1)^(k+1)*L^(k+1) := by
    simpa only [mul_pow,mul_comm (L^(k+1))] using h1.trans_lt h2
  exact (mul_lt_mul_iff_left₀ (pow_pos hLpos (k+1))).mp h3

variable (K : SimpleGraph A) (hK : K.IsTree) (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (ha₀ : c a₀=true)
    (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
include hK hc ha₀ hattach hg

lemma heavy_pairs_nat (M L D : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (heavyPairs (arcs G U) U (heavyThreshold A I M L) (neighbors G U z)).card≤
      2*(D/L+Fintype.card I+3)*D := by
  classical
  let H := (heavy (arcs G U) U (heavyThreshold A I M L)).induce (neighbors G U z : Set W)
  have hn : Fintype.card (neighbors G U z : Set W)=(neighbors G U z).card :=
    Fintype.card_of_finset' (p := (neighbors G U z : Set W)) _ (fun _ => Iff.rfl)
  have hsize : Fintype.card (neighbors G U z : Set W)≤D := by
    simpa only [hn] using hdeg z hz
  have hpow := scale_power D L (Fintype.card I) hL
  have hb := TreeCount.edge_bound_of_no_commonRootCopies (KstUpper.Star (Fintype.card I+1))
    (KstUpper.star_tree _) (D/L+1) (D/L^(Fintype.card I+1)) D
    (by simpa only [Fintype.card_fin,Fintype.card_sum,Nat.add_sub_cancel,Nat.add_sub_cancel_left] using hpow) H hsize
    (fun h => heavy_induced_free K hK a₀ attach c hc ha₀ hattach G g hg U M L D hL hf hdeg z hz
      (KstUpper.contained_of_common_roots H h))
  have hb' : Nat.card H.edgeSet≤(D/L+Fintype.card I+3)*(neighbors G U z).card := by
    convert hb using 1 <;> simp only [Nat.card_eq_fintype_card,card_edgeSet,
      Fintype.card_sum,Fintype.card_fin,hn] <;> congr 1 <;> omega
  rw [heavyPairs_card]
  exact (Nat.mul_le_mul_left 2 hb').trans (by
    nlinarith [Nat.mul_le_mul_left (2*(D/L+Fintype.card I+3)) (hdeg z hz)])

lemma heavy_pairs_bound (M L : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) (z : W) (hz : z∈U) :
    ((heavyPairs (arcs G U) U (heavyThreshold A I M L) (neighbors G U z)).card:ℝ)≤
      2/(L:ℝ)*D^2+2*(Fintype.card I+3:ℝ)*D := by
  have hb := heavy_pairs_nat K hK a₀ attach c hc ha₀ hattach G g hg U M L ⌊D⌋₊ hL hf
    (fun v hv => Nat.le_floor (hdeg v hv)) z hz
  have hb' : ((heavyPairs (arcs G U) U (heavyThreshold A I M L) (neighbors G U z)).card:ℝ)≤
      2*((⌊D⌋₊/L:ℕ)+(Fintype.card I:ℝ)+3)*(⌊D⌋₊:ℝ) := by exact_mod_cast hb
  have hLpos : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  have hdiv : (⌊D⌋₊/L:ℕ)*(L:ℝ)≤D := by
    have h : (⌊D⌋₊/L:ℕ)*(L:ℝ)≤(⌊D⌋₊:ℝ) := by exact_mod_cast Nat.div_mul_le_self ⌊D⌋₊ L
    exact h.trans (Nat.floor_le hD)
  have hquot := (le_div_iff₀ hLpos).mpr hdiv
  calc
    _ ≤ 2*((⌊D⌋₊/L:ℕ)+(Fintype.card I:ℝ)+3)*(⌊D⌋₊:ℝ) := hb'
    _ ≤ 2*(D/(L:ℝ)+(Fintype.card I:ℝ)+3)*D := by gcongr; exact Nat.floor_le hD
    _ = _ := by ring

theorem badPairs_sum_bound (M L : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold A I M L) v).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+(2*(Fintype.card I:ℝ)+7)*D) := by
  have hh : (∑v∈U, ((heavyPairs (arcs G U) U (heavyThreshold A I M L) (neighbors G U v)).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+2*(Fintype.card I+3:ℝ)*D) := by
    exact (sum_le_sum (fun v hv => heavy_pairs_bound K hK a₀ attach c hc ha₀ hattach
      G g hg U M L hL hf hD hdeg v hv)).trans_eq (by simp [mul_add])
  have h := ThetaFour.badPairs_sum_bound G U (heavyThreshold A I M L) hdeg
  nlinarith

end Erdos571.AnchoredArms


/-! A density packing lemma with either orientation at the chosen tree vertex. -/
namespace Erdos571.ColoredTreePacking
open Finset SimpleGraph DensityRegularization
variable {A W : Type} [Fintype A] [Fintype W] [DecidableEq W]

lemma pack_of_arcs_any (H : SimpleGraph A) (hH : H.IsTree) (c : A → Bool)
    (hc : ∀{u v}, H.Adj u v → c u≠c v) (a : A)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W) (M : ℕ)
    (hm : 2*(M*Fintype.card A+1)*U.card < (arcs G U).card) :
    ∃f : Fin M → H.Copy G,
      (∀i v, f i v∈U ∧ g (f i v)=c v) ∧
      Pairwise (fun i j => Disjoint (univ.image (f i)) (univ.image (f j))) := by
  cases ha : c a with
  | true => exact pack_of_arcs H hH c hc a ha G g hg U M hm
  | false =>
    have hc' {u v} (h : H.Adj u v) : (!c u)≠(!c v) := by simpa using hc h
    have hg' {u v} (h : G.Adj u v) : (!g u)≠(!g v) := by simpa using hg h
    obtain ⟨f,hf,hdis⟩ := pack_of_arcs H hH (fun v => !c v) hc' a (by simp [ha])
      G (fun w => !g w) hg' U M hm
    exact ⟨f,fun i v => ⟨(hf i v).1,by simpa using (hf i v).2⟩,hdis⟩

end Erdos571.ColoredTreePacking


/-! Heavy cleaning when the short root has the opposite color to the other roots. -/
set_option maxHeartbeats 2000000
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization
variable {A I W : Type} [Fintype A] [Fintype I] [Fintype W] [DecidableEq W]

theorem contains_of_heavy_arms (K : SimpleGraph A) (hK : K.IsTree)
    (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (ha₀ : c a₀=false)
    (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (U S : Finset W) (i₀ : I) (t M D : ℕ) (ht : vertexCount A I M≤t)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (hSU : S⊆U) (hS : S.card≤D)
    (hSg : ∀s∈S, g s=false)
    (r : Unit⊕I ↪ W) (hrU : ∀j, r j∈U) (hrg : ∀j : I, g (r (.inr j))=false)
    (hanchor : ∀s∈S, G.Adj (r (.inl ())) s)
    (hheavy : ∀u∈S, ∀j : I, t≤(FourthMoment.common G U u (r (.inr j))).card)
    (hlarge : massCoeff A I M*D<t*S.card) : graph K a₀ attach M ⊑ G := by
  classical
  let Y := neighbors G U (r (.inr i₀))
  have hY : Y.card≤D := hdeg _ (hrU _)
  have hYg (y) (hy : y∈Y) : g y=true := by
    have h := hg (mem_filter.mp hy).2
    have hr := hrg i₀
    cases hgy : g y <;> simp_all
  let E := (S×ˢY).filter (fun p => G.Adj p.1 p.2)
  have hE : E⊆arcs G U := by
    intro e he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨hSU hs,(mem_filter.mp hy).1,ha⟩
  have hl := DirectedDegreeBounds.left G U E hE D hdeg
  have hh := DirectedDegreeBounds.right G U E hE D hdeg
  have hcount : t*S.card≤E.card := by
    rw [rectangle_card]
    have hC (u : W) : neighbors G Y u=FourthMoment.common G U u (r (.inr i₀)) := by
      ext v
      simp only [neighbors,Y,FourthMoment.common,mem_filter]
      tauto
    simp_rw [hC]
    exact (show t*S.card=∑_u∈S,t by simp [mul_comm]).trans_le
      (sum_le_sum (fun u hu => hheavy u hu i₀))
  let Z := univ.image r
  have hZ : Z.card=Fintype.card I+1 := by
    simp [Z,card_image_of_injective _ r.injective,Nat.add_comm]
  let E' := CherryPacking.avoid E Z
  let U' := (S∪Y)\Z
  have hU' : U'.card≤2*D := by
    have h1 := card_le_card (sdiff_subset (s:=S∪Y) (t:=Z))
    have h2 := card_union_le S Y
    dsimp [U']
    omega
  have hrem := CherryPacking.remove_bound E Z D hl hh
  have hcard : 4*(M*Fintype.card A+1)*D<E'.card := by
    change E.card≤E'.card+2*Z.card*D at hrem
    rw [hZ] at hrem
    dsimp [massCoeff] at hlarge
    nlinarith
  have hE' : E'⊆arcs G U' := by
    intro e he
    obtain ⟨he,havoid⟩ := mem_filter.mp he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨mem_sdiff.mpr ⟨mem_union_left _ hs,havoid.1⟩,
      mem_sdiff.mpr ⟨mem_union_right _ hy,havoid.2⟩,ha⟩
  have hmass : 2*(M*Fintype.card A+1)*U'.card<(arcs G U').card := by
    have h1 := card_le_card hE'
    have h2 := Nat.mul_le_mul_left (2*(M*Fintype.card A+1)) hU'
    nlinarith
  obtain ⟨f,hf,hdis⟩ := ColoredTreePacking.pack_of_arcs_any K hK c hc a₀ G g hg U' M hmass
  let core : Fin M×A ↪ W :=
    { toFun := fun p => f p.1 p.2
      inj' := by
        rintro ⟨i,a⟩ ⟨j,b⟩ he
        change f i a=f j b at he
        by_cases hij : i=j
        · subst j
          exact Prod.ext rfl ((f i).injective he)
        · exact (Finset.disjoint_left.mp (hdis hij) (mem_image.mpr ⟨a,mem_univ _,rfl⟩)
            (mem_image.mpr ⟨b,mem_univ _,he.symm⟩)).elim }
  have hcore (p : Fin M×A) : core p∈U' ∧ g (core p)=c p.2 := hf p.1 p.2
  have hcavoid (p : Fin M×A) : core p∉Z := (mem_sdiff.mp (hcore p).1).2
  have hcS (i : Fin M) (j : I) : core (i,attach j)∈S := by
    obtain hs|hy := mem_union.mp (mem_sdiff.mp (hcore (i,attach j)).1).1
    · exact hs
    · have h := hYg _ hy
      have h' := (hcore (i,attach j)).2
      rw [hattach] at h'
      simp_all
  have hcTop (i : Fin M) : core (i,a₀)∈S := by
    obtain hs|hy := mem_union.mp (mem_sdiff.mp (hcore (i,a₀)).1).1
    · exact hs
    · have h := hYg _ hy
      have h' := (hcore (i,a₀)).2
      rw [ha₀] at h'
      simp_all
  have hrZ (j : Unit⊕I) : r j∈Z := mem_image.mpr ⟨j,mem_univ _,rfl⟩
  let Z' := (univ.image core) ∪ Z
  have hZ' : Z'.card≤M*Fintype.card A+(Fintype.card I+1) := by
    have h1 := card_union_le (univ.image core) Z
    have h2 := card_image_le (s := univ) (f := core)
    simp only [card_univ,Fintype.card_prod,Fintype.card_fin] at h2
    dsimp [Z']
    omega
  let F (p : Fin M×I) := FourthMoment.common G U (core (p.1,attach p.2)) (r (.inr p.2))
  obtain ⟨m,hm,hmF⟩ := ShortSpider.select_avoiding F Z' (by
    intro p
    have h := hheavy _ (hcS p.1 p.2) p.2
    change t≤(F p).card at h
    simp only [Fintype.card_prod,Fintype.card_fin]
    dsimp [vertexCount] at ht
    nlinarith)
  let mid : Fin M×I ↪ W := ⟨m,hm⟩
  apply contains_of_layout K a₀ attach G M core mid r
  · intro i j he
    exact (hmF j).2 (mem_union_left _ (mem_image.mpr ⟨i,mem_univ _,he⟩))
  · intro i j he
    exact hcavoid i (he.symm ▸ hrZ j)
  · intro i j he
    change m i=r j at he
    exact (hmF i).2 (mem_union_right _ (he.symm ▸ hrZ j))
  · intro i a b hab
    exact (f i).toHom.map_adj hab
  · intro i
    exact (hanchor _ (hcTop i)).symm
  · intro i j
    exact ⟨(mem_filter.mp (hmF (i,j)).1).2.1,(mem_filter.mp (hmF (i,j)).1).2.2.symm⟩

end Erdos571.AnchoredArms


/-! The mixed-color anchored template also has sparse local heavy shadows. -/
set_option maxHeartbeats 2000000
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {A I W : Type} [Fintype A] [Fintype I] [Nonempty I] [Fintype W] [DecidableEq W]

def mixedHeavyThreshold (A I : Type) [Fintype A] [Fintype I] (M L : ℕ) : ℕ :=
  massCoeff A I M*L^(Fintype.card I)+vertexCount A I M

lemma mixed_heavy_induced_free (K : SimpleGraph A) (hK : K.IsTree)
    (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (ha₀ : c a₀=false)
    (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
    (M L D : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (completeBipartiteGraph (Fin (Fintype.card I)) (Fin (D/L^(Fintype.card I)+1))).Free
      ((heavy (arcs G U) U (mixedHeavyThreshold A I M L)).induce (neighbors G U z : Set W)) := by
  classical
  rintro ⟨f⟩
  let n := Fintype.card I
  let p := D/L^n+1
  let e : I ≃ Fin n := Fintype.equivFin I
  let old : Fin n⊕Fin p ↪ W := f.toEmbedding.trans (Function.Embedding.subtype _)
  have holdN (a : Fin n⊕Fin p) : old a∈neighbors G U z := (f a).property
  have holdU (a : Fin n⊕Fin p) : old a∈U := (mem_filter.mp (holdN a)).1
  have holdZ (a : Fin n⊕Fin p) : old a≠z := ((mem_filter.mp (holdN a)).2).ne'
  let r : Unit⊕I ↪ W :=
    { toFun := Sum.elim (fun _ => z) (fun j => old (.inl (e j)))
      inj' := Sum.elim_injective.mpr ⟨fun _ _ _ => Subsingleton.elim _ _,
        old.injective.comp (Sum.inl_injective.comp e.injective),fun _ j => (holdZ _).symm⟩ }
  let S := univ.image (fun i : Fin p => old (.inr i))
  have hSU : S⊆U := by
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdU _
  have hrU (j : Unit⊕I) : r j∈U := by
    cases j
    · exact hz
    · exact holdU _
  have hS : S.card=p := by
    have hi : Function.Injective (fun i : Fin p => old (.inr i)) := old.injective.comp Sum.inr_injective
    simp only [S,card_image_of_injective _ hi,card_univ,Fintype.card_fin]
  have hsize : S.card≤D := by
    apply le_trans _ (hdeg z hz)
    apply card_le_card
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdN _
  let g' : W → Bool := fun w => if g w=g z then true else false
  have hg' {u v} (h : G.Adj u v) : g' u≠g' v := by
    have h' := hg h
    cases hgu : g u <;> cases hgv : g v <;> cases hgz : g z <;> simp_all [g']
  have hNz (w) (hw : w∈neighbors G U z) : g' w=false := by
    have h := hg (mem_filter.mp hw).2
    simp [g',Ne.symm h]
  have hSg (w) (hw : w∈S) : g' w=false := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hw
    exact hNz _ (holdN _)
  have hrg (j : I) : g' (r (.inr j))=false := hNz _ (holdN _)
  have hanchor (w) (hw : w∈S) : G.Adj (r (.inl ())) w := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hw
    exact (mem_filter.mp (holdN _)).2
  have hheavy (u) (hu : u∈S) (j : I) :
      mixedHeavyThreshold A I M L≤(FourthMoment.common G U u (r (.inr j))).card := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    have h := f.toHom.map_adj (show (completeBipartiteGraph (Fin n) (Fin p)).Adj (.inr i) (.inl (e j)) by simp [completeBipartiteGraph])
    change old (.inr i)≠r (.inr j) ∧ mixedHeavyThreshold A I M L≤(common (arcs G U) U (old (.inr i)) (r (.inr j))).card at h
    rw [ShortSpider.common_eq G U (holdU (.inr i)) (hrU (.inr j))] at h
    exact h.2
  have hmass : mixedHeavyThreshold A I M L*S.card≤ massCoeff A I M*D := by
    apply le_of_not_gt
    intro h
    exact hf (contains_of_heavy_arms K hK a₀ attach c hc ha₀ hattach G g' hg' U S
      (Classical.choice (inferInstance : Nonempty I)) (mixedHeavyThreshold A I M L) M D
      (by dsimp [mixedHeavyThreshold]; omega) hdeg hSU hsize hSg r hrU hrg hanchor hheavy h)
  have hscale : L^n*p≤D := by
    rw [hS] at hmass
    have hm : massCoeff A I M*(L^n*p)≤ massCoeff A I M*D := by
      dsimp [mixedHeavyThreshold] at hmass
      change (massCoeff A I M*L^n+vertexCount A I M)*p≤ massCoeff A I M*D at hmass
      nlinarith
    exact (mul_le_mul_iff_right₀ (by dsimp [massCoeff]; omega : 0< massCoeff A I M)).mp hm
  have hLpos : 0<L^n := pow_pos (by omega) _
  have hp : D<L^n*p := Nat.lt_mul_div_succ D hLpos
  omega

end Erdos571.AnchoredArms


/-! Heavy-pair counting for the mixed-color anchored template. -/
set_option maxHeartbeats 2000000
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {A I W : Type} [Fintype A] [Fintype I] [Nonempty I] [Fintype W] [DecidableEq W]

variable (K : SimpleGraph A) (hK : K.IsTree) (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (ha₀ : c a₀=false)
    (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
include hK hc ha₀ hattach hg

lemma mixed_heavy_pairs_nat (M L D : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (heavyPairs (arcs G U) U (mixedHeavyThreshold A I M L) (neighbors G U z)).card≤
      2*(D/L+Fintype.card I+2)*D := by
  classical
  let H := (heavy (arcs G U) U (mixedHeavyThreshold A I M L)).induce (neighbors G U z : Set W)
  have hn : Fintype.card (neighbors G U z : Set W)=(neighbors G U z).card :=
    Fintype.card_of_finset' (p := (neighbors G U z : Set W)) _ (fun _ => Iff.rfl)
  have hsize : Fintype.card (neighbors G U z : Set W)≤D := by
    simpa only [hn] using hdeg z hz
  have hnpos : 1≤Fintype.card I := Fintype.card_pos
  have hnsub : Fintype.card I-1+1=Fintype.card I := Nat.sub_add_cancel hnpos
  have hpow := scale_power D L (Fintype.card I-1) hL
  rw [hnsub] at hpow
  have hb := TreeCount.edge_bound_of_no_commonRootCopies (KstUpper.Star (Fintype.card I))
    (KstUpper.star_tree _) (D/L+1) (D/L^(Fintype.card I)) D
    (by simpa only [Fintype.card_fin,Fintype.card_sum,Nat.add_sub_cancel,Nat.add_sub_cancel_left] using hpow) H hsize
    (fun h => mixed_heavy_induced_free K hK a₀ attach c hc ha₀ hattach G g hg U M L D hL hf hdeg z hz
      (KstUpper.contained_of_common_roots H h))
  have hb' : Nat.card H.edgeSet≤(D/L+Fintype.card I+2)*(neighbors G U z).card := by
    convert hb using 1 <;> simp only [Nat.card_eq_fintype_card,card_edgeSet,
      Fintype.card_sum,Fintype.card_fin,hn] <;> congr 1 <;> omega
  rw [heavyPairs_card]
  exact (Nat.mul_le_mul_left 2 hb').trans (by
    nlinarith [Nat.mul_le_mul_left (2*(D/L+Fintype.card I+2)) (hdeg z hz)])

lemma mixed_heavy_pairs_bound (M L : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) (z : W) (hz : z∈U) :
    ((heavyPairs (arcs G U) U (mixedHeavyThreshold A I M L) (neighbors G U z)).card:ℝ)≤
      2/(L:ℝ)*D^2+2*(Fintype.card I+2:ℝ)*D := by
  have hb := mixed_heavy_pairs_nat K hK a₀ attach c hc ha₀ hattach G g hg U M L ⌊D⌋₊ hL hf
    (fun v hv => Nat.le_floor (hdeg v hv)) z hz
  have hb' : ((heavyPairs (arcs G U) U (mixedHeavyThreshold A I M L) (neighbors G U z)).card:ℝ)≤
      2*((⌊D⌋₊/L:ℕ)+(Fintype.card I:ℝ)+2)*(⌊D⌋₊:ℝ) := by exact_mod_cast hb
  have hLpos : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  have hdiv : (⌊D⌋₊/L:ℕ)*(L:ℝ)≤D := by
    have h : (⌊D⌋₊/L:ℕ)*(L:ℝ)≤(⌊D⌋₊:ℝ) := by exact_mod_cast Nat.div_mul_le_self ⌊D⌋₊ L
    exact h.trans (Nat.floor_le hD)
  have hquot := (le_div_iff₀ hLpos).mpr hdiv
  calc
    _ ≤ 2*((⌊D⌋₊/L:ℕ)+(Fintype.card I:ℝ)+2)*(⌊D⌋₊:ℝ) := hb'
    _ ≤ 2*(D/(L:ℝ)+(Fintype.card I:ℝ)+2)*D := by gcongr; exact Nat.floor_le hD
    _ = _ := by ring

theorem mixed_badPairs_sum_bound (M L : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (mixedHeavyThreshold A I M L) v).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+(2*(Fintype.card I:ℝ)+5)*D) := by
  have hh : (∑v∈U, ((heavyPairs (arcs G U) U (mixedHeavyThreshold A I M L) (neighbors G U v)).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+2*(Fintype.card I+2:ℝ)*D) := by
    exact (sum_le_sum (fun v hv => mixed_heavy_pairs_bound K hK a₀ attach c hc ha₀ hattach
      G g hg U M L hL hf hD hdeg v hv)).trans_eq (by simp [mul_add])
  have h := ThetaFour.badPairs_sum_bound G U (mixedHeavyThreshold A I M L) hdeg
  nlinarith

end Erdos571.AnchoredArms


/-! Finite nondecreasing Engel expansions of nonnegative rational numbers. -/
namespace Erdos571.EngelExpansion

def value : List ℕ → ℚ
  | [] => 0
  | k::l => (1+value l)/(k:ℚ)

/-- The greedy Engel algorithm terminates because its numerator decreases. -/
theorem exists_nat (p b : ℕ) (hb : 0<b) (hpb : p≤b) :
    ∃l : List ℕ, l.Pairwise (·≤·) ∧
      (∀k∈l, (b-1)/p+1≤k) ∧ value l=(p:ℚ)/(b:ℚ) := by
  induction p using Nat.strong_induction_on with
  | h p ih =>
    by_cases hp : p=0
    · subst p
      exact ⟨[],by simp,by simp,by simp [value]⟩
    have hpp : 0<p := by omega
    let k := (b-1)/p+1
    have hkpos : 0<k := Nat.succ_pos _
    have hlo : b≤k*p := by
      have h := Nat.lt_mul_div_succ (b-1) hpp
      dsimp [k]
      nlinarith [Nat.sub_add_cancel (show 1≤b by omega)]
    have hhi : k*p<b+p := by
      have h := Nat.div_mul_le_self (b-1) p
      dsimp [k]
      nlinarith [Nat.sub_add_cancel (show 1≤b by omega)]
    let n := k*p-b
    have hnadd : n+b=k*p := Nat.sub_add_cancel hlo
    have hnp : n<p := by dsimp [n]; omega
    by_cases hn : n=0
    · refine ⟨[k],by simp,?_,?_⟩
      · intro j hj
        have hjk : j=k := List.mem_singleton.mp hj
        subst j
        exact le_rfl
      · simp only [value,add_zero]
        have hbk : b=k*p := by omega
        have hbq : (b:ℚ)≠0 := by exact_mod_cast (show b≠0 by omega)
        have hkq : (k:ℚ)≠0 := by exact_mod_cast hkpos.ne'
        have hbkq : (b:ℚ)=(k:ℚ)*(p:ℚ) := by exact_mod_cast hbk
        field_simp
        nlinarith
    · obtain ⟨l,hs,hl,hv⟩ := ih n hnp (by omega)
      have hnpos : 0<n := by omega
      have hdiv : (b-1)/p≤(b-1)/n := Nat.div_le_div_left hnp.le hnpos
      have hkl : ∀j∈l, k≤j := by
        intro j hj
        have h := hl j hj
        dsimp [k]
        omega
      refine ⟨k::l,List.pairwise_cons.mpr ⟨hkl,hs⟩,?_,?_⟩
      · intro j hj
        rcases List.mem_cons.mp hj with rfl|hj
        · rfl
        · exact hkl j hj
      · simp only [value,hv]
        have hbq : (b:ℚ)≠0 := by exact_mod_cast (show b≠0 by omega)
        have hkq : (k:ℚ)≠0 := by exact_mod_cast hkpos.ne'
        have hnq : (n:ℚ)+(b:ℚ)=(k:ℚ)*(p:ℚ) := by exact_mod_cast hnadd
        field_simp
        nlinarith

theorem exists_expansion (x : ℚ) (hx : 0≤x) (hx1 : x≤1) :
    ∃l : List ℕ, l.Pairwise (·≤·) ∧ (∀k∈l, 1≤k) ∧ value l=x := by
  let p := x.num.natAbs
  have hp : (p:ℚ)=x.num := by
    dsimp [p]
    rw [← Int.cast_natCast,Int.natAbs_of_nonneg (Rat.num_nonneg.mpr hx)]
  have he : (p:ℚ)/(x.den:ℚ)=x := by rw [hp,Rat.num_div_den]
  have hb : (0:ℚ)<x.den := by exact_mod_cast x.den_pos
  have hpb : p≤x.den := by
    have h := (div_le_one hb).mp (he ▸ hx1)
    exact_mod_cast h
  obtain ⟨l,hs,hl,hv⟩ := exists_nat p x.den x.den_pos hpb
  exact ⟨l,hs,fun k hk => (Nat.le_add_left 1 _).trans (hl k hk),hv.trans he⟩

lemma value_replicate_append (m : ℕ) (l : List ℕ) :
    value (List.replicate m 1 ++ l)=(m:ℚ)+value l := by
  induction m with
  | zero => simp [value]
  | succ m ih => simp [List.replicate_succ,value,ih]; ring

/-- Integer parts correspond to initial factors equal to one. -/
theorem exists_nonneg (x : ℚ) (hx : 0≤x) :
    ∃l : List ℕ, l.Pairwise (·≤·) ∧ (∀k∈l, 1≤k) ∧ value l=x := by
  let m := ⌊x⌋₊
  have hlo : (m:ℚ)≤x := Nat.floor_le hx
  have hhi : x<(m:ℚ)+1 := Nat.lt_floor_add_one x
  obtain ⟨l,hs,hl,hv⟩ := exists_expansion (x-m) (by linarith) (by linarith)
  refine ⟨List.replicate m 1 ++ l,?_,?_,?_⟩
  · apply List.pairwise_append.mpr
    refine ⟨by simp,hs,?_⟩
    intro a ha b hb
    have ha1 := (List.mem_replicate.mp ha).2
    simpa only [ha1] using hl b hb
  · intro k hk
    rcases List.mem_append.mp hk with hk|hk
    · exact ((List.mem_replicate.mp hk).2 ▸ le_rfl)
    · exact hl k hk
  · rw [value_replicate_append,hv]
    ring

end Erdos571.EngelExpansion


/-! Fractional edge allocations certify rooted balance. -/
namespace Erdos571.WeightedBalance
open Finset SimpleGraph RootedSunflower
variable {A R : Type} [Fintype A] [Fintype R]

/-- Any nonnegative allocation of edge capacity to incident nonroots proves
all rooted balance inequalities at once. -/
lemma density_bound (H : SimpleGraph (A⊕R)) [DecidableRel H.Adj] (w : A → H.edgeSet → ℚ) (ρ : ℚ)
    (hw : ∀a e, 0≤w a e)
    (hsupport : ∀a e, Sum.inl a∉e.val → w a e=0)
    (hrow : ∀a, ρ≤∑e, w a e)
    (hcol : ∀e, (∑a, w a e)≤1) (C : Finset A) :
    ρ*(Fintype.card A-C.card:ℕ) ≤ (Nat.card (PetalEdge H C):ℚ) := by
  classical
  let S : Finset A := univ\C
  have hS : S.card=Fintype.card A-C.card := by simp only [S,card_sdiff,inter_univ,card_univ]
  have hbound (e : H.edgeSet) : (∑a∈S, w a e)≤
      if ∃a, a∉C ∧ Sum.inl a∈e.val then (1:ℚ) else 0 := by
    split_ifs with he
    · exact (sum_le_sum_of_subset_of_nonneg (subset_univ S) (fun a _ _ => hw a e)).trans (hcol e)
    · apply le_of_eq
      apply sum_eq_zero
      intro a ha
      apply hsupport
      intro hmem
      exact he ⟨a,(mem_sdiff.mp ha).2,hmem⟩
  have h := sum_le_sum (s:=univ) (fun e _ => hbound e)
  rw [sum_comm] at h
  have h' : (∑a∈S, ρ)≤∑a∈S, ∑e, w a e := sum_le_sum (fun a _ => hrow a)
  have hc : (∑e : H.edgeSet, if ∃a, a∉C ∧ Sum.inl a∈e.val then (1:ℚ) else 0)=
      (Nat.card (PetalEdge H C):ℚ) := by
    simp only [Nat.card_eq_fintype_card,PetalEdge,Fintype.card_subtype,sum_boole]
  simpa only [sum_const,nsmul_eq_mul,hS,mul_comm,hc] using h'.trans h

lemma balance (H : SimpleGraph (A⊕R)) [DecidableRel H.Adj] (w : A → H.edgeSet → ℚ) (a b : ℕ)
    (ha : 0<a) (hw : ∀v e, 0≤w v e)
    (hsupport : ∀v e, Sum.inl v∉e.val → w v e=0)
    (hrow : ∀v, (b:ℚ)/(a:ℚ)≤∑e, w v e)
    (hcol : ∀e, (∑v, w v e)≤1) :
    ∀C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C) := by
  intro C
  have h := density_bound H w ((b:ℚ)/(a:ℚ)) hw hsupport hrow hcol C
  have haq : (0:ℚ)<a := by exact_mod_cast ha
  have h' := mul_le_mul_of_nonneg_left h haq.le
  rw [← mul_assoc,mul_div_cancel₀ _ haq.ne'] at h'
  exact_mod_cast h'

end Erdos571.WeightedBalance


/-! Trees with an arbitrary finite family of attached root leaves. -/
namespace Erdos571.LeafRooted
open Finset SimpleGraph RootedSunflower
variable {A R : Type} [Fintype A] [Fintype R]

def graph (K : SimpleGraph A) (attach : R → A) : SimpleGraph (A⊕R) :=
  RootedIncidence.graph K (fun a r => a=attach r)

instance (K : SimpleGraph A) (attach : R → A) [DecidableEq A] [DecidableRel K.Adj] :
    DecidableRel (graph K attach).Adj := inferInstanceAs (DecidableRel (RootedIncidence.graph _ _).Adj)

lemma connected (K : SimpleGraph A) (hK : K.Connected) (attach : R → A) :
    (graph K attach).Connected := by
  obtain ⟨a⟩ := hK.nonempty
  apply (connected_iff_exists_forall_reachable _).mpr
  refine ⟨.inl a,?_⟩
  let f : K →g graph K attach := ⟨Sum.inl,fun h => h⟩
  intro v
  cases v with
  | inl b => exact (hK a b).map f
  | inr r => exact ((hK a (attach r)).map f).trans (show (graph K attach).Adj (.inl (attach r)) (.inr r) from rfl).reachable

def edge (K : SimpleGraph A) (attach : R → A) : K.edgeSet⊕R → (graph K attach).edgeSet
  | .inl e => (RootedIncidence.coreCopy K (fun a r => a=attach r)).toHom.mapEdgeSet e
  | .inr r => ⟨s(.inl (attach r),.inr r),rfl⟩

lemma edge_injective (K : SimpleGraph A) (attach : R → A) : Function.Injective (edge K attach) := by
  intro e f h
  cases e with
  | inl e => cases f with
    | inl f =>
      exact congrArg Sum.inl (Hom.mapEdgeSet.injective _ Sum.inl_injective h)
    | inr r =>
      have hm : Sum.inr r∈(edge K attach (.inl e)).val := by rw [h]; simp [edge]
      obtain ⟨a,ha,he⟩ := Sym2.mem_map.mp hm
      exact (Sum.inl_ne_inr he).elim
  | inr r => cases f with
    | inl f =>
      have hm : Sum.inr r∈(edge K attach (.inl f)).val := by rw [←h]; simp [edge]
      obtain ⟨a,ha,he⟩ := Sym2.mem_map.mp hm
      exact (Sum.inl_ne_inr he).elim
    | inr s =>
      have h' := congrArg Subtype.val h
      simp only [edge,Sym2.eq_iff,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,
        false_and,or_false] at h'
      exact congrArg Sum.inr h'.2

lemma edge_surjective (K : SimpleGraph A) (attach : R → A) : Function.Surjective (edge K attach) := by
  rintro ⟨e,he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl a => cases v with
      | inl b => exact ⟨.inl ⟨s(a,b),he⟩,rfl⟩
      | inr r =>
        change a=attach r at he
        subst a
        exact ⟨.inr r,rfl⟩
    | inr r => cases v with
      | inl a =>
        change a=attach r at he
        subst a
        exact ⟨.inr r,Subtype.ext Sym2.eq_swap⟩
      | inr s => exact he.elim

lemma card_edges (K : SimpleGraph A) (attach : R → A) :
    Nat.card (graph K attach).edgeSet=Nat.card K.edgeSet+Fintype.card R := by
  have h := Nat.card_congr (Equiv.ofBijective (edge K attach)
    ⟨edge_injective K attach,edge_surjective K attach⟩)
  simpa only [Nat.card_sum,Nat.card_eq_fintype_card,Fintype.card_sum] using h.symm

lemma isTree (K : SimpleGraph A) (hK : K.IsTree) (attach : R → A) :
    (graph K attach).IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected K hK.isConnected attach,?_⟩
  have h := (isTree_iff_connected_and_card.mp hK).2
  rw [card_edges]
  simp only [Nat.card_sum,Nat.card_eq_fintype_card,Fintype.card_sum] at h ⊢
  omega

end Erdos571.LeafRooted


/-! A new hub joining any finite number of disjoint copies of a tree. -/
namespace Erdos571.TreeFan
open Finset SimpleGraph
variable {A : Type} [Fintype A]

def graph (K : SimpleGraph A) (a₀ : A) (k : ℕ) : SimpleGraph (Option (Fin k×A)) where
  Adj u v := match u,v with
    | none,none => False
    | none,some b => b.2=a₀
    | some a,none => a.2=a₀
    | some a,some b => a.1=b.1 ∧ K.Adj a.2 b.2
  symm := by
    intro u v h
    cases u <;> cases v
    · exact h
    · exact h
    · exact h
    · exact ⟨h.1.symm,h.2.symm⟩
  loopless := by
    intro v
    cases v
    · exact not_false
    · exact fun h => K.loopless _ h.2

instance (K : SimpleGraph A) (a₀ : A) (k : ℕ) [DecidableEq A] [DecidableRel K.Adj] :
    DecidableRel (graph K a₀ k).Adj := by
  intro u v
  cases u <;> cases v <;> dsimp [graph] <;> infer_instance

def branchCopy (K : SimpleGraph A) (a₀ : A) {k : ℕ} (i : Fin k) : K.Copy (graph K a₀ k) where
  toHom := {toFun := fun a => some (i,a), map_rel' := fun h => ⟨rfl,h⟩}
  injective' := fun _ _ h => (Prod.mk.inj (Option.some.inj h)).2

lemma connected (K : SimpleGraph A) (hK : K.Connected) (a₀ : A) (k : ℕ) :
    (graph K a₀ k).Connected := by
  apply (connected_iff_exists_forall_reachable _).mpr
  refine ⟨none,?_⟩
  intro v
  cases v with
  | none => exact Reachable.rfl
  | some p =>
    have h : (graph K a₀ k).Adj none (some (p.1,a₀)) := rfl
    exact h.reachable.trans ((hK a₀ p.2).map (branchCopy K a₀ p.1).toHom)

def edge (K : SimpleGraph A) (a₀ : A) (k : ℕ) :
    Fin k⊕(Fin k×K.edgeSet) → (graph K a₀ k).edgeSet
  | .inl i => ⟨s(none,some (i,a₀)),rfl⟩
  | .inr (i,e) => (branchCopy K a₀ i).toHom.mapEdgeSet e

lemma edge_injective (K : SimpleGraph A) (a₀ : A) (k : ℕ) :
    Function.Injective (edge K a₀ k) := by
  classical
  intro e f h
  cases e with
  | inl i => cases f with
    | inl j =>
      have h' := congrArg Subtype.val h
      simp [edge,Sym2.eq_iff] at h'
      exact congrArg Sum.inl h'
    | inr f =>
      have hm : none∈(edge K a₀ k (.inr f)).val := by rw [←h]; simp [edge]
      obtain ⟨a,ha,he⟩ := Sym2.mem_map.mp hm
      simpa [branchCopy] using he
  | inr e => cases f with
    | inl j =>
      have hm : none∈(edge K a₀ k (.inr e)).val := by rw [h]; simp [edge]
      obtain ⟨a,ha,he⟩ := Sym2.mem_map.mp hm
      simpa [branchCopy] using he
    | inr f =>
      obtain ⟨i,e⟩ := e
      obtain ⟨j,f⟩ := f
      let a := e.val.out.1
      have hm : some (i,a)∈(edge K a₀ k (.inr (i,e))).val :=
        Sym2.mem_map.mpr ⟨a,Sym2.out_fst_mem e.val,rfl⟩
      rw [h] at hm
      obtain ⟨b,hb,he⟩ := Sym2.mem_map.mp hm
      change some (j,b)=some (i,a) at he
      have hij := congrArg Prod.fst (Option.some.inj he)
      change j=i at hij
      subst j
      have hef := Hom.mapEdgeSet.injective (branchCopy K a₀ i).toHom
        (branchCopy K a₀ i).injective h
      exact congrArg (fun e => Sum.inr (i,e)) hef

lemma edge_surjective (K : SimpleGraph A) (a₀ : A) (k : ℕ) :
    Function.Surjective (edge K a₀ k) := by
  rintro ⟨e,he⟩
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | none => cases v with
      | none => exact he.elim
      | some b =>
        obtain ⟨i,b⟩ := b
        change b=a₀ at he
        subst b
        exact ⟨.inl i,rfl⟩
    | some a => cases v with
      | none =>
        obtain ⟨i,a⟩ := a
        change a=a₀ at he
        subst a
        exact ⟨.inl i,Subtype.ext Sym2.eq_swap⟩
      | some b =>
        obtain ⟨i,a⟩ := a
        obtain ⟨j,b⟩ := b
        obtain ⟨hij,hab⟩ := he
        change i=j at hij
        subst j
        exact ⟨.inr (i,⟨s(a,b),hab⟩),rfl⟩

lemma card_edges (K : SimpleGraph A) (a₀ : A) (k : ℕ) :
    Nat.card (graph K a₀ k).edgeSet=k+k*Nat.card K.edgeSet := by
  have h := Nat.card_congr (Equiv.ofBijective (edge K a₀ k)
    ⟨edge_injective K a₀ k,edge_surjective K a₀ k⟩)
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin] using h.symm

lemma isTree (K : SimpleGraph A) (hK : K.IsTree) (a₀ : A) (k : ℕ) :
    (graph K a₀ k).IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected K hK.isConnected a₀ k,?_⟩
  have h := (isTree_iff_connected_and_card.mp hK).2
  rw [card_edges]
  simp only [Nat.card_eq_fintype_card,Fintype.card_option,Fintype.card_prod,Fintype.card_fin] at h ⊢
  nlinarith

end Erdos571.TreeFan


/-! Fractional incidence allocations for an iterated tree fan. -/
namespace Erdos571.FanAllocation
open Finset
variable {A E : Type} [Fintype A] [Fintype E] [DecidableEq E]

def weight (e₀ : E) (w₁ w₀ : A → E → ℚ) (k : ℕ) (x y : ℚ) :
    Option (Fin k×A) → Option (Fin k×E) → ℚ
  | none,none => y
  | none,some p => if p.2=e₀ then x else 0
  | some _,none => 0
  | some p,some q => if p.1=q.1 then (1-x)*w₁ p.2 q.2+x*w₀ p.2 q.2 else 0

lemma nonneg (e₀ : E) (w₁ w₀ : A → E → ℚ) (k : ℕ) (x y : ℚ)
    (hx : 0≤x) (hx1 : x≤1) (hy : 0≤y)
    (hw₁ : ∀a e, 0≤w₁ a e) (hw₀ : ∀a e, 0≤w₀ a e) :
    ∀a e, 0≤weight e₀ w₁ w₀ k x y a e := by
  intro a e
  cases a <;> cases e <;> simp only [weight]
  · exact hy
  · split_ifs <;> positivity
  · exact le_rfl
  · split_ifs
    · exact add_nonneg (mul_nonneg (sub_nonneg.mpr hx1) (hw₁ _ _)) (mul_nonneg hx (hw₀ _ _))
    · exact le_rfl

lemma sum_column (e₀ : E) (w₁ w₀ : A → E → ℚ) (k : ℕ) (x y : ℚ)
    (hw₁ : ∀e, (∑a, w₁ a e)=1) (hw₀ : ∀e, (∑a, w₀ a e)=if e=e₀ then 0 else 1)
    (e : Option (Fin k×E)) :
    (∑a, weight e₀ w₁ w₀ k x y a e)=match e with | none => y | some _ => 1 := by
  cases e with
  | none => simp [weight]
  | some p =>
    simp only [Fintype.sum_option,weight,Fintype.sum_prod_type]
    have hs : (∑i : Fin k, ∑a : A,
        if i=p.1 then (1-x)*w₁ a p.2+x*w₀ a p.2 else 0)=
        (1-x)*(∑a, w₁ a p.2)+x*(∑a, w₀ a p.2) := by
      simp only [sum_ite_irrel,sum_const_zero,sum_ite_eq',mem_univ,if_true,
        sum_add_distrib,←mul_sum]
    rw [hs,hw₁,hw₀]
    split_ifs <;> ring

lemma sum_top_row (e₀ : E) (w₁ w₀ : A → E → ℚ) (k : ℕ) (x y : ℚ) :
    (∑e, weight e₀ w₁ w₀ k x y none e)=y+k*x := by
  simp [Fintype.sum_option,Fintype.sum_prod_type,weight]

lemma sum_branch_row (e₀ : E) (w₁ w₀ : A → E → ℚ) (k : ℕ) (x y : ℚ)
    (p : Fin k×A) :
    (∑e, weight e₀ w₁ w₀ k x y (some p) e)=
      (1-x)*(∑e, w₁ p.2 e)+x*(∑e, w₀ p.2 e) := by
  simp only [Fintype.sum_option,weight,Fintype.sum_prod_type,zero_add]
  simp only [sum_ite_irrel,sum_const_zero,sum_ite_eq,mem_univ,if_true,
    sum_add_distrib,←mul_sum]

lemma full_rows (e₀ : E) (w₁ w₀ : A → E → ℚ) (k a b : ℕ) (ha : 0<a)
    (hw₁ : ∀v, (∑e, w₁ v e)=(b:ℚ)/a)
    (hw₀ : ∀v, (∑e, w₀ v e)=((b:ℚ)-1)/a)
    (v : Option (Fin k×A)) :
    (∑e, weight e₀ w₁ w₀ k (((b:ℚ)-a)/(k*a+1)) 1 v e)=
      ((k:ℚ)*b+1)/(k*a+1) := by
  have haq : (a:ℚ)≠0 := by exact_mod_cast ha.ne'
  have hden : (k:ℚ)*a+1≠0 := by positivity
  cases v with
  | none => rw [sum_top_row]; field_simp; ring
  | some p => rw [sum_branch_row,hw₁,hw₀]; field_simp; ring

lemma removed_rows (e₀ : E) (w₁ w₀ : A → E → ℚ) (k a b : ℕ) (ha : 0<a)
    (hw₁ : ∀v, (∑e, w₁ v e)=(b:ℚ)/a)
    (hw₀ : ∀v, (∑e, w₀ v e)=((b:ℚ)-1)/a)
    (v : Option (Fin k×A)) :
    (∑e, weight e₀ w₁ w₀ k ((b:ℚ)/(k*a+1)) 0 v e)=
      ((k:ℚ)*b)/(k*a+1) := by
  have haq : (a:ℚ)≠0 := by exact_mod_cast ha.ne'
  have hden : (k:ℚ)*a+1≠0 := by positivity
  cases v with
  | none => rw [sum_top_row]; ring
  | some p => rw [sum_branch_row,hw₁,hw₀]; field_simp; ring

lemma parameters (k a b : ℕ) (hab : a≤b) (hb : b≤k*a+1) :
    0≤((b:ℚ)-a)/(k*a+1) ∧ ((b:ℚ)-a)/(k*a+1)≤1 ∧
      0≤(b:ℚ)/(k*a+1) ∧ (b:ℚ)/(k*a+1)≤1 := by
  have hden : (0:ℚ)<(k:ℚ)*a+1 := by positivity
  have habq : (a:ℚ)≤b := by exact_mod_cast hab
  have hbq : (b:ℚ)≤(k:ℚ)*a+1 := by exact_mod_cast hb
  exact ⟨div_nonneg (sub_nonneg.mpr habq) hden.le,
    (div_le_one hden).mpr (by linarith),by positivity,(div_le_one hden).mpr hbq⟩

def incident (e₀ : E) (inc : A → E → Prop) (k : ℕ) :
    Option (Fin k×A) → Option (Fin k×E) → Prop
  | none,none => True
  | none,some p => p.2=e₀
  | some _,none => False
  | some p,some q => p.1=q.1 ∧ inc p.2 q.2

lemma support (e₀ : E) (w₁ w₀ : A → E → ℚ) (inc : A → E → Prop)
    (k : ℕ) (x y : ℚ)
    (hw₁ : ∀a e, ¬inc a e → w₁ a e=0) (hw₀ : ∀a e, ¬inc a e → w₀ a e=0) :
    ∀a e, ¬incident e₀ inc k a e → weight e₀ w₁ w₀ k x y a e=0 := by
  intro a e h
  cases a with
  | none => cases e with
    | none => exact (h trivial).elim
    | some e => exact if_neg h
  | some a => cases e with
    | none => rfl
    | some e =>
      change ¬(a.1=e.1 ∧ inc a.2 e.2) at h
      by_cases hae : a.1=e.1
      · have hn : ¬inc a.2 e.2 := fun he => h ⟨hae,he⟩
        simp [weight,hae,hw₁ _ _ hn,hw₀ _ _ hn]
      · simp [weight,hae]

end Erdos571.FanAllocation


/-! A single heavy-pair estimate for either color of the distinguished root. -/
namespace Erdos571.AnchoredArms
open Finset SimpleGraph DensityRegularization
variable {A I W : Type} [Fintype A] [Fintype I] [Nonempty I] [Fintype W] [DecidableEq W]

theorem badPairs_sum_bound_any (K : SimpleGraph A) (hK : K.IsTree)
    (a₀ : A) (attach : I → A) (c : A → Bool)
    (hc : ∀{u v}, K.Adj u v → c u≠c v) (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
    (M L : ℕ) (hL : 1≤L) (hf : (graph K a₀ attach M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold A I M L) v).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+(2*(Fintype.card I:ℝ)+7)*D) := by
  cases ha : c a₀ with
  | true => exact badPairs_sum_bound K hK a₀ attach c hc ha hattach G g hg U M L hL hf hD hdeg
  | false =>
    have ht : mixedHeavyThreshold A I M L≤heavyThreshold A I M L := by
      have hp : L^(Fintype.card I)≤L^(Fintype.card I+1) := by
        rw [pow_succ]
        exact Nat.le_mul_of_pos_right _ (by omega)
      exact Nat.add_le_add_right (Nat.mul_le_mul_left _ hp) _
    have hsub (v) : ShortSpider.badPairs G U (heavyThreshold A I M L) v ⊆
        ShortSpider.badPairs G U (mixedHeavyThreshold A I M L) v := by
      intro p hp
      obtain ⟨hp,hbad⟩ := mem_filter.mp hp
      apply mem_filter.mpr
      refine ⟨hp,?_⟩
      rcases hbad with h|h
      · exact Or.inl h
      · exact Or.inr (ht.trans h)
    have hsum : (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold A I M L) v).card:ℝ))≤
        ∑v∈U, ((ShortSpider.badPairs G U (mixedHeavyThreshold A I M L) v).card:ℝ) :=
      sum_le_sum (fun v _ => by exact_mod_cast card_le_card (hsub v))
    have h := mixed_badPairs_sum_bound K hK a₀ attach c hc ha hattach G g hg U M L hL hf hD hdeg
    nlinarith

end Erdos571.AnchoredArms


/-! A finite tree obtained by repeatedly joining identical branches at a hub. -/
namespace Erdos571.LayeredTrees
open Finset SimpleGraph

def Interior : List ℕ → Type
  | [] => Unit
  | k::l => Option (Fin k×Interior l)

def Leaves : List ℕ → Type
  | [] => Unit
  | k::l => Fin k×Leaves l

instance (l : List ℕ) : Fintype (Interior l) := by
  induction l with
  | nil => exact inferInstanceAs (Fintype Unit)
  | cons k l ih => exact inferInstanceAs (Fintype (Option (Fin k×Interior l)))

instance (l : List ℕ) : Fintype (Leaves l) := by
  induction l with
  | nil => exact inferInstanceAs (Fintype Unit)
  | cons k l ih => exact inferInstanceAs (Fintype (Fin k×Leaves l))

instance (l : List ℕ) : DecidableEq (Interior l) := by
  induction l with
  | nil => exact inferInstanceAs (DecidableEq Unit)
  | cons k l ih => exact inferInstanceAs (DecidableEq (Option (Fin k×Interior l)))

instance (l : List ℕ) : DecidableEq (Leaves l) := by
  induction l with
  | nil => exact inferInstanceAs (DecidableEq Unit)
  | cons k l ih => exact inferInstanceAs (DecidableEq (Fin k×Leaves l))

def anchor : (l : List ℕ) → Interior l
  | [] => ()
  | _::_ => none

def attach : (l : List ℕ) → Leaves l → Interior l
  | [],_ => ()
  | _::l,p => some (p.1,attach l p.2)

def core : (l : List ℕ) → SimpleGraph (Interior l)
  | [] => ⊥
  | k::l => TreeFan.graph (core l) (anchor l) k

instance (l : List ℕ) : DecidableRel (core l).Adj := by
  induction l with
  | nil => exact inferInstanceAs (DecidableRel (⊥:SimpleGraph Unit).Adj)
  | cons k l ih => exact inferInstanceAs (DecidableRel (TreeFan.graph (core l) (anchor l) k).Adj)

def rootAttach (l : List ℕ) : Option (Leaves l) → Interior l :=
  fun r => r.elim (anchor l) (attach l)

def template (l : List ℕ) : SimpleGraph (Interior l⊕Option (Leaves l)) :=
  LeafRooted.graph (core l) (rootAttach l)

instance (l : List ℕ) : DecidableRel (template l).Adj :=
  inferInstanceAs (DecidableRel (LeafRooted.graph (core l) (rootAttach l)).Adj)

lemma core_tree (l : List ℕ) : (core l).IsTree := by
  induction l with
  | nil =>
    change (⊥:SimpleGraph Unit).IsTree
    exact IsTree.of_subsingleton
  | cons k l ih => exact TreeFan.isTree _ ih _ _

lemma isTree (l : List ℕ) : (template l).IsTree := LeafRooted.isTree _ (core_tree l) _

def nonroots : List ℕ → ℕ
  | [] => 1
  | k::l => 1+k*nonroots l

def edges : List ℕ → ℕ
  | [] => 2
  | k::l => 1+k*edges l

lemma card_interior (l : List ℕ) : Fintype.card (Interior l)=nonroots l := by
  induction l with
  | nil => rfl
  | cons k l ih => simp only [Interior,Fintype.card_option,Fintype.card_prod,Fintype.card_fin,ih,nonroots]; omega

lemma card_leaves (l : List ℕ) : Fintype.card (Leaves l)=l.prod := by
  induction l with
  | nil => rfl
  | cons k l ih => simp only [Leaves,Fintype.card_prod,Fintype.card_fin,ih,List.prod_cons]

lemma edges_eq (l : List ℕ) : edges l=nonroots l+l.prod := by
  induction l with
  | nil => rfl
  | cons k l ih => simp only [edges,nonroots,List.prod_cons,ih]; ring

lemma card_edges (l : List ℕ) : Nat.card (template l).edgeSet=edges l := by
  have h := (isTree_iff_connected_and_card.mp (isTree l)).2
  simp only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_option,card_interior,card_leaves] at h
  rw [edges_eq]
  simp only [Nat.card_eq_fintype_card]
  omega

lemma prod_le_nonroots (l : List ℕ) : l.prod≤nonroots l := by
  induction l with
  | nil => rfl
  | cons k l ih => simp only [List.prod_cons,nonroots]; nlinarith [Nat.mul_le_mul_left k ih]

lemma nonroots_pos (l : List ℕ) : 0<nonroots l := by cases l <;> simp [nonroots]

lemma edges_le_twice (l : List ℕ) : edges l≤2*nonroots l := by
  rw [edges_eq]
  have h := prod_le_nonroots l
  omega

def color : (l : List ℕ) → Interior l → Bool
  | [],_ => false
  | _::l,none => !color l (anchor l)
  | _::l,some p => color l p.2

lemma core_proper (l : List ℕ) : ∀{u v}, (core l).Adj u v → color l u≠color l v := by
  induction l with
  | nil => intro u v h; exact h.elim
  | cons k l ih =>
    intro u v h
    cases u with
    | none => cases v with
      | none => exact h.elim
      | some p =>
        change p.2=anchor l at h
        simpa only [color,h] using Bool.not_ne_self (color l (anchor l))
    | some p => cases v with
      | none =>
        change p.2=anchor l at h
        simpa only [color,h] using (Bool.not_ne_self (color l (anchor l))).symm
      | some q => exact ih h.2

end Erdos571.LayeredTrees


/-! Exact rational densities of the homogeneous branching trees. -/
namespace Erdos571.LayeredTrees
open EngelExpansion

lemma prod_pos (l : List ℕ) (hl : ∀k∈l, 0<k) : 0<l.prod := by
  induction l with
  | nil => simp
  | cons k l ih =>
    exact Nat.mul_pos (hl k (by simp)) (ih (fun j hj => hl j (by simp [hj])))

lemma value_append (l r : List ℕ) (hl : ∀k∈l, 0<k) :
    value (l++r)=value l+value r/(l.prod:ℚ) := by
  induction l with
  | nil => simp [value]
  | cons k l ih =>
    have hk : (k:ℚ)≠0 := by exact_mod_cast (hl k (by simp)).ne'
    have htail : ∀j∈l, 0<j := fun j hj => hl j (by simp [hj])
    have hp : (l.prod:ℚ)≠0 := by exact_mod_cast (prod_pos l htail).ne'
    simp only [List.cons_append,value,ih htail,List.prod_cons,Nat.cast_mul]
    field_simp
    ring

lemma reciprocal_excess (l : List ℕ) (hl : ∀k∈l, 0<k) :
    (edges l:ℚ)/(l.prod:ℚ)=2+value l.reverse := by
  induction l with
  | nil => simp [edges,value]
  | cons k l ih =>
    have hk : (k:ℚ)≠0 := by exact_mod_cast (hl k (by simp)).ne'
    have htail : ∀j∈l, 0<j := fun j hj => hl j (by simp [hj])
    have hp : (l.prod:ℚ)≠0 := by exact_mod_cast (prod_pos l htail).ne'
    have hh := ih htail
    rw [List.reverse_cons,value_append _ _ (fun j hj => htail j (List.mem_reverse.mp hj))]
    simp only [edges,List.prod_cons,Nat.cast_add,Nat.cast_one,Nat.cast_mul,
      value,List.prod_reverse,add_zero,List.prod_singleton]
    field_simp at hh ⊢
    nlinarith

/-- Every rational reciprocal excess at least two comes from a finite list of
branch factors. The reverse list is nondecreasing. This is only a parameter
representation, not an ordinary extremal upper bound. -/
theorem represents (β : ℚ) (hβ : 2≤β) :
    ∃l : List ℕ, l.reverse.Pairwise (·≤·) ∧ (∀k∈l, 0<k) ∧
      (edges l:ℚ)/(l.prod:ℚ)=β := by
  obtain ⟨l,hs,hl,hv⟩ := EngelExpansion.exists_nonneg (β-2) (by linarith)
  have hpos : ∀k∈l.reverse, 0<k := fun k hk => hl k (List.mem_reverse.mp hk)
  refine ⟨l.reverse,by simpa only [List.reverse_reverse] using hs,hpos,?_⟩
  rw [reciprocal_excess _ hpos,List.reverse_reverse,hv]
  ring

end Erdos571.LayeredTrees


/-! Recursive edge indices and incidence for homogeneous branching trees. -/
namespace Erdos571.LayeredTrees
open Finset SimpleGraph

def EdgeIndex : List ℕ → Type
  | [] => Bool
  | k::l => Option (Fin k×EdgeIndex l)

instance (l : List ℕ) : Fintype (EdgeIndex l) := by
  induction l with
  | nil => exact inferInstanceAs (Fintype Bool)
  | cons k l ih => exact inferInstanceAs (Fintype (Option (Fin k×EdgeIndex l)))

instance (l : List ℕ) : DecidableEq (EdgeIndex l) := by
  induction l with
  | nil => exact inferInstanceAs (DecidableEq Bool)
  | cons k l ih => exact inferInstanceAs (DecidableEq (Option (Fin k×EdgeIndex l)))

def anchorEdge : (l : List ℕ) → EdgeIndex l
  | [] => false
  | _::_ => none

def incidence : (l : List ℕ) → Interior l → EdgeIndex l → Prop
  | [],_,_ => True
  | k::l,a,e => FanAllocation.incident (anchorEdge l) (incidence l) k a e

lemma card_edgeIndex (l : List ℕ) : Fintype.card (EdgeIndex l)=edges l := by
  induction l with
  | nil => rfl
  | cons k l ih => simp only [EdgeIndex,Fintype.card_option,Fintype.card_prod,Fintype.card_fin,ih,edges]; omega

def branchVertex {k : ℕ} (l : List ℕ) (i : Fin k) :
    Interior l⊕Option (Leaves l) → Interior (k::l)⊕Option (Leaves (k::l))
  | .inl a => .inl (some (i,a))
  | .inr none => .inl none
  | .inr (some r) => .inr (some (i,r))

lemma branchVertex_injective {k : ℕ} (l : List ℕ) (i : Fin k) :
    Function.Injective (branchVertex l i) := by
  rintro (a|(_|r)) (b|(_|s)) h <;> simp_all [branchVertex,Interior,Leaves]

def branchCopy {k : ℕ} (l : List ℕ) (i : Fin k) : (template l).Copy (template (k::l)) where
  toHom :=
    { toFun := branchVertex l i
      map_rel' := by
        rintro (a|(_|r)) (b|(_|s)) h <;>
          simp only [template,LeafRooted.graph,RootedIncidence.graph,rootAttach,Option.elim,
            core,TreeFan.graph,branchVertex,attach,anchor,Interior,Leaves] at h ⊢
        all_goals first | exact h.elim | exact ⟨rfl,h⟩ | exact ⟨trivial,h⟩ | exact h | exact congrArg (fun a => some (i,a)) h }
  injective' := branchVertex_injective l i

def edgeMap : (l : List ℕ) → EdgeIndex l → (template l).edgeSet
  | [],false => LeafRooted.edge (core []) (rootAttach []) (.inr none)
  | [],true => LeafRooted.edge (core []) (rootAttach []) (.inr (some ()))
  | k::l,none => LeafRooted.edge (core (k::l)) (rootAttach (k::l)) (.inr none)
  | _::l,some p => (branchCopy l p.1).toHom.mapEdgeSet (edgeMap l p.2)

lemma new_root_not_in_branch {k : ℕ} (l : List ℕ) (i : Fin k) (e : (template l).edgeSet) :
    Sum.inr none∉((branchCopy l i).toHom.mapEdgeSet e).val := by
  intro h
  obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp h
  rcases v with a|(_|r) <;> simp [branchCopy,branchVertex] at he

lemma edge_nonroot (l : List ℕ) (e : (template l).edgeSet) :
    ∃a, Sum.inl a∈e.val := by
  obtain ⟨e,he⟩ := e
  induction e using Sym2.inductionOn with
  | hf u v =>
    cases u with
    | inl a => exact ⟨a,by simp⟩
    | inr r => cases v with
      | inl a => exact ⟨a,by simp⟩
      | inr s => exact he.elim

lemma edgeMap_injective (l : List ℕ) : Function.Injective (edgeMap l) := by
  induction l with
  | nil =>
    intro e f h
    cases e <;> cases f <;> simp_all [edgeMap,LeafRooted.edge,rootAttach,anchor,attach]
  | cons k l ih =>
    intro e f h
    cases e with
    | none => cases f with
      | none => rfl
      | some p =>
        have hm : Sum.inr none∈(edgeMap (k::l) none).val := by simp [edgeMap,LeafRooted.edge]
        rw [h] at hm
        exact (new_root_not_in_branch l p.1 _ hm).elim
    | some p => cases f with
      | none =>
        have hm : Sum.inr none∈(edgeMap (k::l) none).val := by simp [edgeMap,LeafRooted.edge]
        rw [←h] at hm
        exact (new_root_not_in_branch l p.1 _ hm).elim
      | some q =>
        obtain ⟨i,e⟩ := p
        obtain ⟨j,f⟩ := q
        obtain ⟨a,ha⟩ := edge_nonroot l (edgeMap l e)
        have hm : Sum.inl (some (i,a))∈(edgeMap (k::l) (some (i,e))).val :=
          Sym2.mem_map.mpr ⟨Sum.inl a,ha,rfl⟩
        rw [h] at hm
        obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp hm
        have hij : j=i := by
          rcases v with b|(_|r)
          · change Sum.inl (some (j,b))=Sum.inl (some (i,a)) at he
            exact congrArg Prod.fst (Option.some.inj (Sum.inl.inj he))
          · simp [branchCopy,branchVertex] at he
          · simp [branchCopy,branchVertex] at he
        subst j
        have hef := Hom.mapEdgeSet.injective (branchCopy l i).toHom
          (branchCopy l i).injective h
        exact congrArg (fun e => some (i,e)) (ih hef)

lemma edgeMap_bijective (l : List ℕ) : Function.Bijective (edgeMap l) := by
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  refine ⟨edgeMap_injective l,?_⟩
  rw [card_edgeIndex,←Nat.card_eq_fintype_card]
  exact (card_edges l).symm

noncomputable def edgeEquiv (l : List ℕ) : EdgeIndex l ≃ (template l).edgeSet :=
  Equiv.ofBijective (edgeMap l) (edgeMap_bijective l)

lemma root_mem_iff (l : List ℕ) (e : EdgeIndex l) :
    Sum.inr none∈(edgeMap l e).val ↔ e=anchorEdge l := by
  cases l with
  | nil => cases e <;> simp [edgeMap,LeafRooted.edge,rootAttach,anchor,attach,anchorEdge]
  | cons k l => cases e with
    | none => simp [edgeMap,LeafRooted.edge,rootAttach,anchor,anchorEdge]
    | some p =>
      have h := new_root_not_in_branch l p.1 (edgeMap l p.2)
      exact iff_of_false h (by simp [anchorEdge,EdgeIndex])

lemma mem_branch_top {k : ℕ} (l : List ℕ) (i : Fin k) (e : (template l).edgeSet) :
    Sum.inl none∈((branchCopy l i).toHom.mapEdgeSet e).val ↔ Sum.inr none∈e.val := by
  constructor
  · intro h
    obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp h
    rcases v with a|(_|r)
    · simp [branchCopy,branchVertex] at he
    · exact hv
    · simp [branchCopy,branchVertex] at he
  · intro h
    exact Sym2.mem_map.mpr ⟨Sum.inr none,h,rfl⟩

lemma mem_branch_nonroot {k : ℕ} (l : List ℕ) (i j : Fin k) (a : Interior l)
    (e : (template l).edgeSet) :
    Sum.inl (some (j,a))∈((branchCopy l i).toHom.mapEdgeSet e).val ↔ j=i ∧ Sum.inl a∈e.val := by
  constructor
  · intro h
    obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp h
    rcases v with b|(_|r)
    · change Sum.inl (some (i,b))=Sum.inl (some (j,a)) at he
      obtain ⟨hij,hba⟩ := Prod.mk.inj (Option.some.inj (Sum.inl.inj he))
      subst j
      subst b
      exact ⟨rfl,hv⟩
    · simp [branchCopy,branchVertex] at he
    · simp [branchCopy,branchVertex] at he
  · rintro ⟨rfl,h⟩
    exact Sym2.mem_map.mpr ⟨Sum.inl a,h,rfl⟩

lemma incidence_iff (l : List ℕ) (a : Interior l) (e : EdgeIndex l) :
    incidence l a e ↔ Sum.inl a∈(edgeMap l e).val := by
  induction l with
  | nil => cases a; cases e <;> simp [incidence,edgeMap,LeafRooted.edge,rootAttach,anchor,attach]
  | cons k l ih =>
    cases a with
    | none => cases e with
      | none => simp [incidence,FanAllocation.incident,edgeMap,LeafRooted.edge,rootAttach,anchor]
      | some p =>
        change p.2=anchorEdge l ↔ Sum.inl none∈((branchCopy l p.1).toHom.mapEdgeSet (edgeMap l p.2)).val
        rw [mem_branch_top,root_mem_iff]
    | some p => cases e with
      | none => simp [incidence,FanAllocation.incident,edgeMap,LeafRooted.edge,rootAttach,anchor,Interior]
      | some q =>
        change p.1=q.1 ∧ incidence l p.2 q.2 ↔ _
        rw [ih,edgeMap,mem_branch_nonroot]

end Erdos571.LayeredTrees


/-! Full and short-edge-removed allocations for the homogeneous tree family. -/
namespace Erdos571.LayeredTrees
open Finset SimpleGraph

mutual
  def fullWeight : (l : List ℕ) → Interior l → EdgeIndex l → ℚ
    | [],_,_ => 1
    | k::l,a,e => FanAllocation.weight (anchorEdge l) (fullWeight l) (removedWeight l) k
        (((edges l:ℚ)-nonroots l)/(k*nonroots l+1)) 1 a e

  def removedWeight : (l : List ℕ) → Interior l → EdgeIndex l → ℚ
    | [],_,e => if e=false then 0 else 1
    | k::l,a,e => FanAllocation.weight (anchorEdge l) (fullWeight l) (removedWeight l) k
        ((edges l:ℚ)/(k*nonroots l+1)) 0 a e
end

lemma weight_columns (l : List ℕ) :
    (∀e, (∑a, fullWeight l a e)=1) ∧
    (∀e, (∑a, removedWeight l a e)=if e=anchorEdge l then 0 else 1) := by
  induction l with
  | nil => constructor <;> intro e <;> cases e <;> simp [fullWeight,removedWeight,anchorEdge,Interior]
  | cons k l ih =>
    constructor
    · intro e
      have h := FanAllocation.sum_column (anchorEdge l) (fullWeight l) (removedWeight l)
        k (((edges l:ℚ)-nonroots l)/(k*nonroots l+1)) 1 ih.1 ih.2 e
      cases e <;> exact h
    · intro e
      have h := FanAllocation.sum_column (anchorEdge l) (fullWeight l) (removedWeight l)
        k ((edges l:ℚ)/(k*nonroots l+1)) 0 ih.1 ih.2 e
      cases e <;> simpa only [anchorEdge,EdgeIndex,Option.some_ne_none,if_pos rfl,if_false] using h

lemma weight_rows (l : List ℕ) :
    (∀a, (∑e, fullWeight l a e)=(edges l:ℚ)/nonroots l) ∧
    (∀a, (∑e, removedWeight l a e)=((edges l:ℚ)-1)/nonroots l) := by
  induction l with
  | nil => constructor <;> intro a <;> simp [fullWeight,removedWeight,nonroots,edges,EdgeIndex] <;> norm_num
  | cons k l ih =>
    constructor
    · intro a
      have h := FanAllocation.full_rows (anchorEdge l) (fullWeight l) (removedWeight l)
        k (nonroots l) (edges l) (nonroots_pos l) ih.1 ih.2 a
      simpa only [fullWeight,edges,nonroots,Nat.cast_add,Nat.cast_mul,Nat.cast_one,add_comm] using h
    · intro a
      have h := FanAllocation.removed_rows (anchorEdge l) (fullWeight l) (removedWeight l)
        k (nonroots l) (edges l) (nonroots_pos l) ih.1 ih.2 a
      simpa only [removedWeight,edges,nonroots,Nat.cast_add,Nat.cast_mul,Nat.cast_one,
        add_sub_cancel_left,add_comm] using h

def Valid : List ℕ → Prop
  | [] => True
  | k::l => Valid l ∧ edges l≤k*nonroots l+1

lemma weight_nonneg (l : List ℕ) (hl : Valid l) :
    (∀a e, 0≤fullWeight l a e) ∧ (∀a e, 0≤removedWeight l a e) := by
  induction l with
  | nil => constructor <;> intro a e <;> simp only [fullWeight,removedWeight] <;> positivity
  | cons k l ih =>
    obtain ⟨hfull,hrem⟩ := ih hl.1
    have hab : nonroots l≤edges l := by rw [edges_eq]; omega
    have hp := FanAllocation.parameters k (nonroots l) (edges l) hab hl.2
    exact ⟨FanAllocation.nonneg _ _ _ _ _ _ hp.1 hp.2.1 (by norm_num) hfull hrem,
      FanAllocation.nonneg _ _ _ _ _ _ hp.2.2.1 hp.2.2.2 (by norm_num) hfull hrem⟩

lemma weight_support (l : List ℕ) :
    (∀a e, ¬incidence l a e → fullWeight l a e=0) ∧
    (∀a e, ¬incidence l a e → removedWeight l a e=0) := by
  induction l with
  | nil => constructor <;> intro a e h <;> exact (h trivial).elim
  | cons k l ih =>
    exact ⟨FanAllocation.support _ _ _ _ _ _ _ ih.1 ih.2,
      FanAllocation.support _ _ _ _ _ _ _ ih.1 ih.2⟩

end Erdos571.LayeredTrees


/-! Balancedness of the homogeneous trees, with a distinguished short-root invariant. -/
namespace Erdos571.LayeredTrees
open Finset SimpleGraph RootedSunflower

noncomputable def actualWeight (l : List ℕ) (a : Interior l) (e : (template l).edgeSet) : ℚ :=
  fullWeight l a ((edgeEquiv l).symm e)

lemma actualWeight_row (l : List ℕ) (a : Interior l) :
    (∑e, actualWeight l a e)=(edges l:ℚ)/nonroots l := by
  rw [←(edgeEquiv l).sum_comp (actualWeight l a)]
  simp only [actualWeight,Equiv.symm_apply_apply]
  exact (weight_rows l).1 a

lemma actualWeight_support (l : List ℕ) (a : Interior l) (e : (template l).edgeSet)
    (ha : Sum.inl a∉e.val) : actualWeight l a e=0 := by
  apply (weight_support l).1
  intro h
  have hh := (incidence_iff l a ((edgeEquiv l).symm e)).mp h
  have he : edgeMap l ((edgeEquiv l).symm e)=e := (edgeEquiv l).apply_symm_apply e
  rw [he] at hh
  exact ha hh

theorem balance (l : List ℕ) (hl : Valid l) :
    ∀C : Finset (Interior l), edges l*(Fintype.card (Interior l)-C.card) ≤
      nonroots l*Nat.card (PetalEdge (template l) C) := by
  exact WeightedBalance.balance (template l) (actualWeight l) (nonroots l) (edges l)
    (nonroots_pos l) (fun a e => (weight_nonneg l hl).1 a _) (actualWeight_support l)
    (fun a => (actualWeight_row l a).ge) (fun e => ((weight_columns l).1 _).le)

lemma valid_of_sorted (l : List ℕ) (hs : l.Pairwise (·≥·)) (hp : ∀k∈l, 1≤k) : Valid l := by
  induction l with
  | nil => trivial
  | cons k l ih =>
    obtain ⟨hhead,htail⟩ := List.pairwise_cons.mp hs
    have hpl : ∀j∈l, 1≤j := fun j hj => hp j (by simp [hj])
    refine ⟨ih htail hpl,?_⟩
    have hk : 1≤k := hp k (by simp)
    by_cases hk1 : k=1
    · have hones : ∀j∈l, j=1 := by
        intro j hj
        have h1 := hhead j hj
        have h2 := hpl j hj
        omega
      rw [edges_eq,List.prod_eq_one hones,hk1,one_mul]
    · have hk2 : 2≤k := by omega
      have h := edges_le_twice l
      nlinarith [Nat.mul_le_mul_right (nonroots l) hk2]

lemma valid_of_reverse_sorted (l : List ℕ) (hs : l.reverse.Pairwise (·≤·))
    (hp : ∀k∈l, 1≤k) : Valid l :=
  valid_of_sorted l (List.pairwise_reverse.mp hs) hp

/-- The layered tree models supply balanced rooted trees for every reciprocal
excess at least two. This statement makes no upper-bound assertion. -/
theorem balanced_represents (β : ℚ) (hβ : 2≤β) :
    ∃l : List ℕ, Valid l ∧ (∀k∈l, 0<k) ∧ (edges l:ℚ)/(l.prod:ℚ)=β ∧
      (template l).IsTree ∧ ∀C : Finset (Interior l),
        edges l*(Fintype.card (Interior l)-C.card) ≤
          nonroots l*Nat.card (PetalEdge (template l) C) := by
  obtain ⟨l,hs,hp,hβ⟩ := represents β hβ
  have hv : Valid l := valid_of_reverse_sorted l hs hp
  exact ⟨l,hv,hp,hβ,isTree l,balance l hv⟩

end Erdos571.LayeredTrees


/-! Exact random-algebraic lower bounds for the homogeneous tree templates. -/
namespace Erdos571.LayeredTrees
open Finset SimpleGraph

instance (l : List ℕ) : Nonempty (Interior l) := ⟨anchor l⟩
instance (l : List ℕ) : Nontrivial (Interior l⊕Option (Leaves l)) :=
  ⟨⟨.inl (anchor l),.inr none,Sum.inl_ne_inr⟩⟩

def fullColor (l : List ℕ) : Interior l⊕Option (Leaves l) → Bool :=
  Sum.elim (color l) (fun r => !color l (rootAttach l r))

lemma fullColor_proper (l : List ℕ) :
    ∀{u v}, (template l).Adj u v → fullColor l u≠fullColor l v := by
  rintro (a|r) (b|s) h
  · exact core_proper l h
  · change a=rootAttach l s at h
    subst a
    exact (Bool.not_ne_self _).symm
  · change b=rootAttach l r at h
    subst b
    exact Bool.not_ne_self _
  · exact h.elim

lemma no_isolated (l : List ℕ) : ∀u, ∃v, (template l).Adj u v :=
  (isTree l).isConnected.preconnected.exists_adj_of_nontrivial

def graph (l : List ℕ) (M : ℕ) := FullRootedPower.graph (template l) M

lemma graph_bipartite (l : List ℕ) (M : ℕ) : (graph l M).IsBipartite := by
  let c : (graph l M).Coloring Bool :=
    ⟨FullRootedPower.color (fullColor l) M,FullRootedPower.color_proper _ _ _ (fullColor_proper l)⟩
  simpa only [Fintype.card_bool] using c.colorable

theorem exists_lower (l : List ℕ) (hl : Valid l) :
    ∃M : ℕ, 2≤M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(nonroots l:ℝ)/(edges l:ℝ)))
      (fun n : ℕ => (extremalNumber n (graph l M):ℝ)) := by
  have hab : nonroots l≤edges l := by rw [edges_eq]; omega
  exact FullRootedPower.exact_lower (template l) (no_isolated l) (nonroots l) (edges l)
    ((nonroots_pos l).trans_le hab) hab (balance l hl)

end Erdos571.LayeredTrees

/-! Root-preserving relabelings commute with full rooted powers. -/
namespace Erdos571.FullRootedPower
open SimpleGraph

def isoOfRelabel {A R B S : Type} (H : SimpleGraph (A⊕R)) (K : SimpleGraph (B⊕S))
    (a : A ≃ B) (r : R ≃ S)
    (h : ∀u v, H.Adj u v ↔ K.Adj (Sum.map a r u) (Sum.map a r v)) (M : ℕ) :
    graph H M ≃g graph K M where
  toEquiv := Equiv.sumCongr (Equiv.prodCongr (Equiv.refl _) a) r
  map_rel_iff' := by
    rintro (⟨i,u⟩|u) (⟨j,v⟩|v) <;>
      simp only [graph,Equiv.sumCongr_apply,Equiv.prodCongr_apply,Equiv.refl_apply]
    · exact (and_congr Iff.rfl (h (.inl u) (.inl v))).symm
    · exact (h (.inl u) (.inr v)).symm
    · exact (h (.inr u) (.inl v)).symm
    · exact (h (.inr u) (.inr v)).symm

end Erdos571.FullRootedPower


/-! Spiders with one short root and three-edge long arms. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph

abbrev Core (s : ℕ) := Fin 1⊕Fin s
abbrev Interior (s : ℕ) := Core s⊕Fin s
abbrev Root (s : ℕ) := Unit⊕Fin s
abbrev Vertex (s : ℕ) := Interior s⊕Root s

def template (s : ℕ) := AnchoredArms.template (KstUpper.Star s) (.inl 0) (Sum.inr : Fin s → Core s)
def graph (s M : ℕ) := FullRootedPower.graph (template s) M

def center (s : ℕ) : Vertex s := .inl (.inl (.inl 0))
def first {s : ℕ} (i : Fin s) : Vertex s := .inl (.inl (.inr i))
def second {s : ℕ} (i : Fin s) : Vertex s := .inl (.inr i)
def short (s : ℕ) : Vertex s := .inr (.inl ())
def root {s : ℕ} (i : Fin s) : Vertex s := .inr (.inr i)

instance (s : ℕ) : DecidableRel (template s).Adj := by
  rintro (((a|i)|j)|(u|k)) (((b|i')|j')|(u'|k')) <;>
    dsimp [template,AnchoredArms.template,KstUpper.Star,completeBipartiteGraph] <;> infer_instance

def coreColor {s : ℕ} : Core s → Bool := Sum.elim (fun _ => true) (fun _ => false)

lemma coreColor_proper (s : ℕ) :
    ∀{u v}, (KstUpper.Star s).Adj u v → coreColor u≠coreColor v := by
  intro u v h
  cases u <;> cases v <;> simp_all [KstUpper.Star,completeBipartiteGraph,coreColor]

def color {s : ℕ} : Vertex s → Bool := AnchoredArms.color (@coreColor s)

lemma color_proper (s : ℕ) : ∀{u v}, (template s).Adj u v → color u≠color v :=
  AnchoredArms.color_proper _ _ _ _ (coreColor_proper s) rfl (fun _ => rfl)

lemma adjacent_short (s : ℕ) : (template s).Adj (center s) (short s) := rfl
lemma adjacent_first {s : ℕ} (i : Fin s) : (template s).Adj (center s) (first i) := by simp [template,AnchoredArms.template,center,first,KstUpper.Star,completeBipartiteGraph]
lemma adjacent_second {s : ℕ} (i : Fin s) : (template s).Adj (first i) (second i) := rfl
lemma adjacent_root {s : ℕ} (i : Fin s) : (template s).Adj (second i) (root i) := rfl

lemma connected (s : ℕ) : (template s).Connected := by
  apply (connected_iff_exists_forall_reachable _).mpr
  refine ⟨center s,?_⟩
  rintro (((a|i)|j)|(u|k))
  · have ha : a=0 := Subsingleton.elim _ _
    subst a
    exact Reachable.rfl
  · exact (adjacent_first i).reachable
  · exact (adjacent_first j).reachable.trans (adjacent_second j).reachable
  · cases u
    exact (adjacent_short s).reachable
  · exact ((adjacent_first k).reachable.trans (adjacent_second k).reachable).trans (adjacent_root k).reachable

lemma no_isolated (s : ℕ) : ∀u, ∃v, (template s).Adj u v := by
  rintro (((a|i)|j)|(u|k))
  · have ha : a=0 := Subsingleton.elim _ _
    subst a
    exact ⟨short s,adjacent_short s⟩
  · exact ⟨center s,(adjacent_first i).symm⟩
  · exact ⟨first j,(adjacent_second j).symm⟩
  · cases u
    exact ⟨center s,(adjacent_short s).symm⟩
  · exact ⟨second k,(adjacent_root k).symm⟩

end Erdos571.CubicSpider


/-! Identification with the already balanced homogeneous tree [s,1]. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph

noncomputable def nonrootEquiv (s : ℕ) : Interior s ≃ LayeredTrees.Interior [s,1] where
  toFun
    | .inl (.inl _) => none
    | .inl (.inr i) => some (i,none)
    | .inr j => some (j,some (0,()))
  invFun
    | none => .inl (.inl 0)
    | some (i,none) => .inl (.inr i)
    | some (i,some _) => .inr i
  left_inv := by
    rintro ((a|i)|j)
    · fin_cases a; rfl
    · rfl
    · rfl
  right_inv := by
    rintro (_|⟨i,_|⟨j,u⟩⟩)
    · rfl
    · rfl
    · fin_cases j; cases u; rfl

noncomputable def rootEquiv (s : ℕ) : Root s ≃ Option (LayeredTrees.Leaves [s,1]) where
  toFun
    | .inl _ => none
    | .inr i => some (i,(0,()))
  invFun
    | none => .inl ()
    | some (i,_) => .inr i
  left_inv := by
    rintro (u|i)
    · cases u; rfl
    · rfl
  right_inv := by
    rintro (_|⟨i,j,u⟩)
    · rfl
    · fin_cases j; cases u; rfl

noncomputable def modelIso (s : ℕ) : template s ≃g LayeredTrees.template [s,1] where
  toEquiv := Equiv.sumCongr (nonrootEquiv s) (rootEquiv s)
  map_rel_iff' := by
    rintro (((a|i)|j)|(u|k)) (((b|i')|j')|(u'|k'))
    all_goals first | fin_cases a | skip
    all_goals first | fin_cases b | skip
    all_goals first | cases u | skip
    all_goals first | cases u' | skip
    all_goals simp [template,AnchoredArms.template,KstUpper.Star,completeBipartiteGraph,
      LayeredTrees.template,LeafRooted.graph,RootedIncidence.graph,LayeredTrees.core,
      TreeFan.graph,LayeredTrees.anchor,LayeredTrees.rootAttach,LayeredTrees.attach,
      LayeredTrees.Interior,LayeredTrees.Leaves,nonrootEquiv,rootEquiv]
    all_goals exact eq_comm

noncomputable def powerIso (s M : ℕ) : graph s M ≃g LayeredTrees.graph [s,1] M :=
  FullRootedPower.isoOfRelabel (template s) (LayeredTrees.template [s,1]) (nonrootEquiv s)
    (rootEquiv s) (fun u v => (modelIso s).map_rel_iff.symm) M

lemma isTree (s : ℕ) : (template s).IsTree :=
  (modelIso s).isTree_iff.mpr (LayeredTrees.isTree [s,1])

end Erdos571.CubicSpider


/-! Balanced-tree lower bound for three-edge-arm spiders. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph

lemma valid (s : ℕ) (hs : 1≤s) : LayeredTrees.Valid [s,1] := by
  norm_num [LayeredTrees.Valid,LayeredTrees.edges,LayeredTrees.nonroots]
  omega

lemma counts (s : ℕ) : LayeredTrees.nonroots [s,1]=2*s+1 ∧
    LayeredTrees.edges [s,1]=3*s+1 := by
  simp only [LayeredTrees.nonroots,LayeredTrees.edges]
  constructor <;> omega

lemma exists_lower (s : ℕ) (hs : 1≤s) : ∃M : ℕ, 2≤M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(2*(s:ℝ)+1)/(3*(s:ℝ)+1)))
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ)) := by
  obtain ⟨M,hM,h⟩ := LayeredTrees.exists_lower [s,1] (valid s hs)
  refine ⟨M,hM,?_⟩
  have he (n : ℕ) : extremalNumber n (graph s M)=extremalNumber n (LayeredTrees.graph [s,1] M) :=
    extremalNumber_congr_right (powerIso s M)
  simpa only [he,(counts s).1,(counts s).2,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,Nat.cast_one] using h

lemma graph_bipartite (s M : ℕ) : (graph s M).IsBipartite := by
  exact (LayeredTrees.graph_bipartite [s,1] M).of_hom (powerIso s M).toHom

end Erdos571.CubicSpider


/-! Heavy two-path cleaning for three-edge-arm spiders. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def heavyThreshold (s M L : ℕ) := AnchoredArms.heavyThreshold (Core s) (Fin s) M L

lemma badPairs_sum_bound (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
    (s M L : ℕ) (hL : 1≤L) (hf : (graph s M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold s M L) v).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+(2*(s:ℝ)+7)*D) := by
  have h := AnchoredArms.badPairs_sum_bound (KstUpper.Star s) (KstUpper.star_tree s)
    (.inl 0) (Sum.inr : Fin s → Core s) coreColor (coreColor_proper s) rfl (fun _ => rfl)
    G g hg U M L hL hf hD hdeg
  simpa only [heavyThreshold,Fintype.card_fin] using h

end Erdos571.CubicSpider


/-! Direct layouts for powers of the three-edge-arm spider. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W]

lemma contains_of_layout (G : SimpleGraph W) (s M : ℕ)
    (u : Fin M ↪ W) (a b : Fin M×Fin s ↪ W) (r : Root s ↪ W)
    (hua : ∀i j, u i≠a j) (hub : ∀i j, u i≠b j) (hur : ∀i j, u i≠r j)
    (hab : ∀i j, a i≠b j) (har : ∀i j, a i≠r j) (hbr : ∀i j, b i≠r j)
    (hshort : ∀i, G.Adj (u i) (r (.inl ())))
    (hfirst : ∀i j, G.Adj (u i) (a (i,j)))
    (hsecond : ∀i j, G.Adj (a (i,j)) (b (i,j)))
    (hroot : ∀i j, G.Adj (b (i,j)) (r (.inr j))) : graph s M ⊑ G := by
  let core : Fin M×Core s ↪ W :=
    { toFun := fun p => match p.2 with | .inl _ => u p.1 | .inr j => a (p.1,j)
      inj' := by
        rintro ⟨i,v|j⟩ ⟨i',v'|j'⟩ he
        · exact Prod.ext (u.injective he) (congrArg Sum.inl (Subsingleton.elim v v'))
        · exact (hua _ _ he).elim
        · exact (hua _ _ he.symm).elim
        · have hh := a.injective he
          have hii : i=i' := congrArg Prod.fst hh
          have hjj : j=j' := congrArg Prod.snd hh
          subst i'
          subst j'
          rfl }
  apply AnchoredArms.contains_of_layout (KstUpper.Star s) (.inl 0) Sum.inr G M core b r
  · rintro ⟨i,v|j⟩ q he
    · exact hub _ _ he
    · exact hab _ _ he
  · rintro ⟨i,v|j⟩ q he
    · exact hur _ _ he
    · exact har _ _ he
  · exact hbr
  · rintro i (v|j) (v'|j') h
    · simp [KstUpper.Star,completeBipartiteGraph] at h
    · exact hfirst _ _
    · exact (hfirst _ _).symm
    · simp [KstUpper.Star,completeBipartiteGraph] at h
  · exact hshort
  · intro i j
    exact ⟨hsecond i j,hroot i j⟩

end Erdos571.CubicSpider


/-! Combining pairwise disjoint two-vertex footprints into one embedding. -/
namespace Erdos571.PairPacking
open Finset
variable {I W : Type} [DecidableEq W]

def value (p : W×W) (b : Bool) : W := if b then p.2 else p.1

lemma value_mem (p : W×W) (b : Bool) : value p b∈ThetaFour.foot p := by
  cases b <;> simp [value,ThetaFour.foot]

lemma value_injective (p : W×W) (hp : p.1≠p.2) : Function.Injective (value p) := by
  intro a b h
  cases a <;> cases b <;> simp_all [value]

def embedding (p : I → W×W) (hp : ∀i, (p i).1≠(p i).2)
    (hdis : Pairwise (fun i j => Disjoint (ThetaFour.foot (p i)) (ThetaFour.foot (p j)))) : I×Bool ↪ W where
  toFun := fun q => value (p q.1) q.2
  inj' := by
    rintro ⟨i,a⟩ ⟨j,b⟩ he
    change value (p i) a=value (p j) b at he
    by_cases hij : i=j
    · subst j
      exact Prod.ext rfl (value_injective (p i) (hp i) he)
    · exact (Finset.disjoint_left.mp (hdis hij) (value_mem (p i) a) (he.symm ▸ value_mem (p j) b)).elim

def first (p : I → W×W) (hp : ∀i, (p i).1≠(p i).2)
    (hdis : Pairwise (fun i j => Disjoint (ThetaFour.foot (p i)) (ThetaFour.foot (p j)))) : I ↪ W :=
  (⟨fun i => (i,false),fun _ _ h => congrArg Prod.fst h⟩ : I ↪ I×Bool).trans (embedding p hp hdis)

def second (p : I → W×W) (hp : ∀i, (p i).1≠(p i).2)
    (hdis : Pairwise (fun i j => Disjoint (ThetaFour.foot (p i)) (ThetaFour.foot (p j)))) : I ↪ W :=
  (⟨fun i => (i,true),fun _ _ h => congrArg Prod.fst h⟩ : I ↪ I×Bool).trans (embedding p hp hdis)

lemma first_second_ne (p : I → W×W) (hp : ∀i, (p i).1≠(p i).2)
    (hdis : Pairwise (fun i j => Disjoint (ThetaFour.foot (p i)) (ThetaFour.foot (p j)))) (i j : I) :
    first p hp hdis i≠second p hp hdis j := by
  intro h
  change embedding p hp hdis (i,false)=embedding p hp hdis (j,true) at h
  have he := (embedding p hp hdis).injective h
  have hb := congrArg Prod.snd he
  contradiction

end Erdos571.PairPacking


/-! Rich light three-path fibers can be amalgamated into the spider power. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def richThreshold (t s M : ℕ) : ℕ := (2*M*s+M+s+1)*(2*t)

def Rich (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ) (u v : W) : Prop :=
  richThreshold t s M<(ThetaFour.threeFiber G U t u v).card

lemma contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s M : ℕ) (r : Root s ↪ W) (u : Fin M ↪ W)
    (hu : ∀i, G.Adj (u i) (r (.inl ()))) (hur : ∀i j, u i≠r j)
    (hrich : ∀i j, Rich G U t s M (u i) (r (.inr j))) : graph s M ⊑ G := by
  classical
  let Z := (univ.image r) ∪ (univ.image u)
  have hZ : Z.card≤M+s+1 := by
    have h := card_union_le (univ.image r) (univ.image u)
    have hr := card_image_le (s := univ) (f := r)
    have hu := card_image_le (s := univ) (f := u)
    simp only [card_univ,Fintype.card_fin,Fintype.card_sum,Fintype.card_unit] at hr hu
    dsimp [Z]
    omega
  obtain ⟨p,hp,hpZ,hpdis⟩ := DisjointChoice.exists_choice_finite 2 (2*t) ThetaFour.foot
    (fun q : Fin M×Fin s => ThetaFour.threeFiber G U t (u q.1) (r (.inr q.2))) Z
    (by intro q p hp; exact card_le_two)
    (fun q w => ThetaFour.threeFiber_load G U t (u q.1) (r (.inr q.2)) w)
    (by
      intro q
      have h := hrich q.1 q.2
      dsimp [Rich,richThreshold] at h
      simp only [Fintype.card_prod,Fintype.card_fin]
      exact lt_of_le_of_lt (Nat.mul_le_mul_right _ (by nlinarith)) h)
  have hpair (q : Fin M×Fin s) : (p q).1≠(p q).2 :=
    (ThetaFour.mem_threeFiber.mp (hp q)).2.2.2.2.2.1.ne
  let a := PairPacking.first p hpair hpdis
  let b := PairPacking.second p hpair hpdis
  have hnot (q : Fin M×Fin s) (w : W) (hw : w∈Z) : w∉ThetaFour.foot (p q) :=
    fun hh => Finset.disjoint_left.mp (hpZ q) hh hw
  have hua (i : Fin M) (q : Fin M×Fin s) : u i≠a q := by
    intro h
    apply hnot q (u i) (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))
    change u i=(p q).1 at h
    simp [ThetaFour.foot,h]
  have hub (i : Fin M) (q : Fin M×Fin s) : u i≠b q := by
    intro h
    apply hnot q (u i) (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))
    change u i=(p q).2 at h
    simp [ThetaFour.foot,h]
  have har (q : Fin M×Fin s) (j : Root s) : a q≠r j := by
    intro h
    apply hnot q (r j) (mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩))
    change (p q).1=r j at h
    simp [ThetaFour.foot,←h]
  have hbr (q : Fin M×Fin s) (j : Root s) : b q≠r j := by
    intro h
    apply hnot q (r j) (mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩))
    change (p q).2=r j at h
    simp [ThetaFour.foot,←h]
  apply contains_of_layout G s M u a b r hua hub hur (PairPacking.first_second_ne p hpair hpdis) har hbr hu
  · intro i j
    exact (ThetaFour.mem_threeFiber.mp (hp (i,j))).2.2.2.2.1
  · intro i j
    exact (ThetaFour.mem_threeFiber.mp (hp (i,j))).2.2.2.2.2.1
  · intro i j
    exact (ThetaFour.mem_threeFiber.mp (hp (i,j))).2.2.2.2.2.2.1

end Erdos571.CubicSpider


/-! Square complete bipartite copies yield a prescribed part-respecting rectangle. -/
namespace Erdos571.SquareKstRectangle
open Finset SimpleGraph SixCycleCase
variable {A B : Type}

lemma square_rectangle (P : A → B → Prop) (N : ℕ) (hN : 1≤N)
    (f : (completeBipartiteGraph (Fin N) (Fin N)).Copy (bipGraph P)) :
    ∃a : Fin N ↪ A, ∃b : Fin N ↪ B, ∀i j, P (a i) (b j) := by
  let z : Fin N := ⟨0,by omega⟩
  have hadj (i j : Fin N) : (bipGraph P).Adj (f (.inl i)) (f (.inr j)) :=
    f.toHom.map_adj (by simp [completeBipartiteGraph])
  cases hfz : f (.inl z) with
  | inl x =>
    have hr (j : Fin N) : ∃b : B, f (.inr j)=.inr b := by
      have h := hadj z j
      cases hj : f (.inr j) with
      | inl y => simp [hfz,hj,bipGraph] at h
      | inr y => exact ⟨y,rfl⟩
    choose b hb using hr
    have hl (i : Fin N) : ∃a : A, f (.inl i)=.inl a := by
      have h := hadj i z
      cases hi : f (.inl i) with
      | inl y => exact ⟨y,rfl⟩
      | inr y => simp [hi,hb,bipGraph] at h
    choose a ha using hl
    have hai : Function.Injective a := by
      intro i j h
      exact Sum.inl.inj (f.injective ((ha i).trans ((congrArg Sum.inl h).trans (ha j).symm)))
    have hbi : Function.Injective b := by
      intro i j h
      exact Sum.inr.inj (f.injective ((hb i).trans ((congrArg Sum.inr h).trans (hb j).symm)))
    refine ⟨⟨a,hai⟩,⟨b,hbi⟩,?_⟩
    intro i j
    simpa only [ha,hb,bipGraph] using hadj i j
  | inr y =>
    have hl (i : Fin N) : ∃a : A, f (.inr i)=.inl a := by
      have h := hadj z i
      cases hi : f (.inr i) with
      | inl x => exact ⟨x,rfl⟩
      | inr x => simp [hfz,hi,bipGraph] at h
    choose a ha using hl
    have hr (j : Fin N) : ∃b : B, f (.inl j)=.inr b := by
      have h := hadj j z
      cases hj : f (.inl j) with
      | inl x => simp [hj,ha,bipGraph] at h
      | inr x => exact ⟨x,rfl⟩
    choose b hb using hr
    have hai : Function.Injective a := by
      intro i j h
      exact Sum.inr.inj (f.injective ((ha i).trans ((congrArg Sum.inl h).trans (ha j).symm)))
    have hbi : Function.Injective b := by
      intro i j h
      exact Sum.inl.inj (f.injective ((hb i).trans ((congrArg Sum.inr h).trans (hb j).symm)))
    refine ⟨⟨a,hai⟩,⟨b,hbi⟩,?_⟩
    intro i j
    simpa only [ha,hb,bipGraph] using hadj j i

lemma rectangle (P : A → B → Prop) (m n N : ℕ) (hN : 1≤N) (hm : m≤N) (hn : n≤N)
    (hf : completeBipartiteGraph (Fin N) (Fin N) ⊑ bipGraph P) :
    ∃a : Fin m ↪ A, ∃b : Fin n ↪ B, ∀i j, P (a i) (b j) := by
  obtain ⟨f⟩ := hf
  obtain ⟨a,b,hab⟩ := square_rectangle P N hN f
  exact ⟨(Fin.castLEEmb hm).trans a,(Fin.castLEEmb hn).trans b,fun i j => hab _ _⟩

lemma edge_card_le [Fintype A] [Fintype B] (P : A → B → Prop) [DecidableRel P] :
    (univ.filter (fun p : A×B => P p.1 p.2)).card≤Nat.card (bipGraph P).edgeSet := by
  classical
  let f : {p : A×B // P p.1 p.2} → (bipGraph P).edgeSet :=
    fun p => ⟨s(Sum.inl p.val.1,Sum.inr p.val.2),(mem_edgeSet _).mpr p.property⟩
  have hi : Function.Injective f := by
    intro p q he
    have he' := congrArg Subtype.val he
    change s(Sum.inl p.val.1,Sum.inr p.val.2)=s(Sum.inl q.val.1,Sum.inr q.val.2) at he'
    simp only [Sym2.eq_iff,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,false_and,or_false] at he'
    exact Subtype.ext (Prod.ext he'.1 he'.2)
  have h := Nat.card_le_card_of_injective f hi
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype] using h

lemma bound [Fintype A] [Fintype B] (P : A → B → Prop) [DecidableRel P]
    (m n N : ℕ) (hN : 1≤N) (hm : m≤N) (hn : n≤N)
    (hfree : ¬∃a : Fin m ↪ A, ∃b : Fin n ↪ B, ∀i j, P (a i) (b j)) :
    ((univ.filter (fun p : A×B => P p.1 p.2)).card:ℝ)≤
      (3*(N:ℝ)+1)*(Fintype.card A+Fintype.card B:ℝ)^(2-1/(N:ℝ)) := by
  classical
  have hf : (completeBipartiteGraph (Fin N) (Fin N)).Free (bipGraph P) :=
    fun h => hfree (rectangle P m n N hN hm hn h)
  have hb := (ShortSpider.kst_bound N N hN hN).estimate (bipGraph P) hf
  have hb' : (Nat.card (bipGraph P).edgeSet:ℝ)≤
      (3*(N:ℝ)+1)*(Fintype.card A+Fintype.card B:ℝ)^(2-1/(N:ℝ)) := by
    convert hb using 1 <;> simp only [Fintype.card_sum,Nat.cast_add] <;> ring
  exact (show _≤(Nat.card (bipGraph P).edgeSet:ℝ) by exact_mod_cast edge_card_le P).trans hb'

end Erdos571.SquareKstRectangle


/-! Rich three-paths are sparse in every scalar neighborhood rectangle. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_ne (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {u v : W} (h : Rich G U t s M u v) : u≠v :=
  ThetaFour.threeFiber_endpoints_ne G U t g hg (card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) h))

def boxRel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (z u v : W) : Prop := Rich G U t s M u v ∧ v≠z

lemma box_free (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph s M).Free G) (z v : W) :
    ¬∃a : Fin M ↪ (neighbors G U z), ∃b : Fin s ↪ (neighbors G U v),
      ∀i j, boxRel G U t s M z (a i) (b j) := by
  rintro ⟨a,b,hab⟩
  let u : Fin M ↪ W := a.trans (Function.Embedding.subtype _)
  let r : Root s ↪ W :=
    { toFun := Sum.elim (fun _ => z) (fun j => b j)
      inj' := by
        rintro (x|i) (y|j) he
        · exact congrArg Sum.inl (Subsingleton.elim _ _)
        · exact ((hab ⟨0,by omega⟩ j).2 he.symm).elim
        · exact ((hab ⟨0,by omega⟩ i).2 he).elim
        · exact congrArg Sum.inr (b.injective (Subtype.ext he)) }
  apply hf (contains_of_rich_neighbors G U t s M r u ?_ ?_ ?_)
  · intro i
    exact (mem_filter.mp (a i).property).2.symm
  · intro i j
    cases j with
    | inl x => exact G.ne_of_adj (mem_filter.mp (a i).property).2.symm
    | inr j => exact rich_ne G U t s M g hg (hab i j).1
  · intro i j
    exact (hab i j).1

lemma box_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph s M).Free G) (z v : W) :
    letI : DecidableRel (boxRel G U t s M z) := fun _ _ => Classical.propDecidable _
    (((neighbors G U z×ˢneighbors G U v).filter (fun p => boxRel G U t s M z p.1 p.2)).card:ℝ)≤
      (3*(max s M:ℝ)+1)*((neighbors G U z).card+(neighbors G U v).card:ℝ)^(2-1/(max s M:ℝ)) := by
  classical
  let A := neighbors G U z
  let B := neighbors G U v
  let P : A → B → Prop := fun a b => boxRel G U t s M z a b
  have hb := SquareKstRectangle.bound P M s (max s M) (hM.trans (le_max_right _ _))
    (le_max_right _ _) (le_max_left _ _) (box_free G U t s M hM g hg hf z v)
  have he : ((A×ˢB).filter (fun p => boxRel G U t s M z p.1 p.2)).card=
      (univ.filter (fun p : A×B => P p.1 p.2)).card := by
    symm
    apply card_bij (fun p _ => (p.1.val,p.2.val))
    · intro p hp
      exact mem_filter.mpr ⟨mem_product.mpr ⟨p.1.property,p.2.property⟩,(mem_filter.mp hp).2⟩
    · intro p hp q hq he
      exact Prod.ext (Subtype.ext (congrArg Prod.fst he)) (Subtype.ext (congrArg Prod.snd he))
    · intro p hp
      obtain ⟨hp,hr⟩ := mem_filter.mp hp
      obtain ⟨ha,hb⟩ := mem_product.mp hp
      exact ⟨(⟨p.1,ha⟩,⟨p.2,hb⟩),mem_filter.mpr ⟨mem_univ _,hr⟩,rfl⟩
  simpa only [Fintype.card_coe,←he,Nat.cast_max] using hb

end Erdos571.CubicSpider


/-! Rich three-path copies have a positive saving in the degree exponent. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def richGain (s M : ℕ) : ℝ := 1/(max s M : ℕ)
noncomputable def richCoeff (s M : ℕ) : ℝ := (3*(max s M : ℕ)+1)*2^(2-richGain s M)

lemma richGain_pos (s M : ℕ) (hM : 1≤M) : 0<richGain s M := by
  have h : 0<(max s M:ℕ) := lt_of_lt_of_le (by omega : 0<M) (le_max_right _ _)
  exact one_div_pos.mpr (by exact_mod_cast h)

lemma richGain_le_one (s M : ℕ) (hM : 1≤M) : richGain s M≤1 := by
  have h : (1:ℝ)≤(max s M:ℕ) := by exact_mod_cast hM.trans (le_max_right s M)
  exact (div_le_one (by linarith)).mpr h

noncomputable def richWalks (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t s M : ℕ) : Finset ((W×W)×(W×W)) := by
  classical
  exact (ShortSpider.goodWalks G U t).filter (fun p => Rich G U t s M p.1.1 p.2.2)

lemma richWalks_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph s M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((richWalks G U t s M).card:ℝ)≤richCoeff s M*U.card*D^(3-richGain s M) := by
  classical
  let F := richWalks G U t s M
  let pre : (W×W)×(W×W) → W×W := fun p => (p.1.2,p.2.1)
  have hm (p) (hp : p∈F) := ShortSpider.mem_threeWalks.mp (mem_filter.mp (mem_filter.mp hp).1).1
  have hmap (p) (hp : p∈F) : pre p∈arcs G U :=
    mem_arcs.mpr ⟨(hm p hp).2.1,(hm p hp).2.2.1,(hm p hp).2.2.2.2.2.1⟩
  have hpow : 0≤2-richGain s M := by linarith [richGain_le_one s M hM]
  have hfiber (q) (hq : q∈arcs G U) :
      ((F.filter (fun p => pre p=q)).card:ℝ)≤richCoeff s M*D^(2-richGain s M) := by
    let B := ((neighbors G U q.1)×ˢ(neighbors G U q.2)).filter
      (fun p => boxRel G U t s M q.1 p.1 p.2)
    have hc : (F.filter (fun p => pre p=q)).card≤B.card := by
      apply card_le_card_of_injOn (fun p => (p.1.1,p.2.2))
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        have he1 : p.1.2=q.1 := congrArg Prod.fst he
        have he2 : p.2.1=q.2 := congrArg Prod.snd he
        have hw := hm p hp
        refine mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hw.1,?_⟩,
          mem_filter.mpr ⟨hw.2.2.2.1,?_⟩⟩,(mem_filter.mp hp).2,?_⟩
        · rw [←he1]; exact hw.2.2.2.2.1.symm
        · rw [←he2]; exact hw.2.2.2.2.2.2
        · rw [←he1]
          intro h
          exact (mem_filter.mp (mem_filter.mp hp).1).2.2 (Or.inl h.symm)
      · intro p hp p' hp' he
        have hpre : pre p=pre p' := (mem_filter.mp hp).2.trans (mem_filter.mp hp').2.symm
        change (p.1.1,p.2.2)=(p'.1.1,p'.2.2) at he
        change (p.1.2,p.2.1)=(p'.1.2,p'.2.1) at hpre
        exact Prod.ext (Prod.ext (Prod.mk.inj he).1 (Prod.mk.inj hpre).1)
          (Prod.ext (Prod.mk.inj hpre).2 (Prod.mk.inj he).2)
    have hb := box_bound G U t s M hM g hg hf q.1 q.2
    have hn : ((neighbors G U q.1).card+(neighbors G U q.2).card:ℝ)≤2*D := by
      linarith [hdeg _ (mem_arcs.mp hq).1,hdeg _ (mem_arcs.mp hq).2.1]
    have he : (3*(max s M:ℝ)+1)*(2*D)^(2-1/(max s M:ℝ))=
        richCoeff s M*D^(2-richGain s M) := by
      rw [Real.mul_rpow (by norm_num) hD]
      simp only [richCoeff,richGain,Nat.cast_max]
      ring
    calc
      _ ≤ (B.card:ℝ) := by exact_mod_cast hc
      _ ≤ (3*(max s M:ℝ)+1)*((neighbors G U q.1).card+(neighbors G U q.2).card:ℝ)^(2-1/(max s M:ℝ)) := hb
      _ ≤ (3*(max s M:ℝ)+1)*(2*D)^(2-1/(max s M:ℝ)) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        apply Real.rpow_le_rpow (by positivity) hn
        simpa only [richGain,Nat.cast_max] using hpow
      _ = _ := he
  have hcount := RealFiberCount.bound F (arcs G U) pre hmap hfiber
  have ha : ((arcs G U).card:ℝ)≤U.card*D := by
    rw [arcs_sum,Nat.cast_sum]
    exact (sum_le_sum hdeg).trans_eq (by simp)
  have hc0 : 0≤richCoeff s M*D^(2-richGain s M) := by dsimp [richCoeff]; positivity
  have hprod : D*D^(2-richGain s M)=D^(3-richGain s M) := by
    calc
      _ = D^(1:ℝ)*D^(2-richGain s M) := by rw [Real.rpow_one]
      _ = D^((1:ℝ)+(2-richGain s M)) := (Real.rpow_add' hD (by linarith)).symm
      _ = _ := by congr 1; ring
  exact hcount.trans ((mul_le_mul_of_nonneg_right ha hc0).trans_eq (by
    calc
      _ = richCoeff s M*U.card*(D*D^(2-richGain s M)) := by ring
      _ = _ := by rw [hprod]))

end Erdos571.CubicSpider


/-! Light spiders with bounded long and reversed-short three-path fibers. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

structure GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (f : (template s).Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light (template s) G U t f
  long : ∀i, ¬Rich G U t s M (f (center s)) (f (root i))
  short : ∀i, ¬Rich G U t s M (f (second i)) (f (CubicSpider.short s))

lemma GoodCopy.path {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t s M : ℕ}
    {f : (template s).Copy G} (h : GoodCopy G U t s M f)
    {u a b v : Vertex s} (hua : (template s).Adj u a) (hab : (template s).Adj a b)
    (hbv : (template s).Adj b v) (hub : u≠b) (hav : a≠v) :
    (f a,f b)∈ThetaFour.threeFiber G U t (f u) (f v) := by
  apply ThetaFour.mem_threeFiber.mpr
  exact ⟨h.mem _,h.mem _,h.mem _,h.mem _,f.toHom.map_adj hua,f.toHom.map_adj hab,
    f.toHom.map_adj hbv,not_or.mpr ⟨f.injective.ne hub,not_le.mpr (h.light _ _ _ hua hab hub)⟩,
    not_or.mpr ⟨f.injective.ne hav,not_le.mpr (h.light _ _ _ hab hbv hav)⟩⟩

lemma GoodCopy.long_mem {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t s M : ℕ}
    {f : (template s).Copy G} (h : GoodCopy G U t s M f) (i : Fin s) :
    (f (first i),f (second i))∈ThetaFour.threeFiber G U t (f (center s)) (f (root i)) :=
  h.path (adjacent_first i) (adjacent_second i) (adjacent_root i)
    (by simp [center,second]) (by simp [first,root])

lemma GoodCopy.short_mem {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t s M : ℕ}
    {f : (template s).Copy G} (h : GoodCopy G U t s M f) (i : Fin s) :
    (f (first i),f (center s))∈ThetaFour.threeFiber G U t (f (second i)) (f (CubicSpider.short s)) :=
  h.path (adjacent_second i).symm (adjacent_first i).symm (adjacent_short s)
    (by simp [center,second]) (by simp [first,CubicSpider.short])

lemma center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template s).Copy G)) (r : Root s → W) (w : W)
    (hg : ∀f∈F, GoodCopy G U t s M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (center s)=w) : F.card≤(richThreshold t s M)^s := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C : Fin s → Finset (W×W) := fun i => ThetaFour.threeFiber G U t w (r (.inr i))
  have hC (i) : (C i).card≤richThreshold t s M := by
    have h := (hg f₀ hf₀).long i
    change ¬richThreshold t s M < (ThetaFour.threeFiber G U t (f₀ (center s)) (f₀ (.inr (.inr i)))).card at h
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact le_of_not_gt h
  let ev : F → ((i : Fin s) → C i) := fun f i =>
    ⟨(f.val (first i),f.val (second i)),by
      have h := (hg f.val f.property).long_mem i
      change _∈ThetaFour.threeFiber G U t (f.val (center s)) (f.val (.inr (.inr i))) at h
      simpa only [hw f.val f.property,hr f.val f.property] using h⟩
  have hi : Function.Injective ev := by
    intro f f' he
    apply Subtype.ext
    apply Copy.ext
    rintro (((a|i)|j)|x)
    · have ha : a=0 := Subsingleton.elim _ _
      subst a
      exact (hw f.val f.property).trans (hw f'.val f'.property).symm
    · exact (Prod.mk.inj (congrArg Subtype.val (congrFun he i))).1
    · exact (Prod.mk.inj (congrArg Subtype.val (congrFun he j))).2
    · exact (hr f.val f.property x).trans (hr f'.val f'.property x).symm
  have hc := Fintype.card_le_of_injective ev hi
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  calc
    _ ≤ ∏i : Fin s, Fintype.card (C i) := hc
    _ ≤ ∏_i : Fin s, richThreshold t s M := prod_le_prod' (fun i _ => by simpa using hC i)
    _ = _ := by simp

lemma first_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template s).Copy G)) (r : Root s → W) (w : W) (i : Fin s)
    (hg : ∀f∈F, GoodCopy G U t s M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (first i)=w) : F.card≤t*(richThreshold t s M)^s := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := FourthMoment.common G U w (r (.inl ()))
  have hC : C.card≤t := by
    have h := (hg f₀ hf₀).light (first i) (center s) (short s)
      (adjacent_first i).symm (adjacent_short s) (by simp [first,short])
    change _<t at h
    change (FourthMoment.common G U (f₀ (first i)) (f₀ (.inr (.inl ())))).card<t at h
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact h.le
  let ev : (template s).Copy G → W := fun f => f (center s)
  have hs : F.image ev⊆C := by
    intro c hc
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hc
    refine mem_filter.mpr ⟨(hg f hf).mem _,?_,?_⟩
    · rw [←hw f hf]
      exact f.toHom.map_adj (adjacent_first i).symm
    · rw [←hr f hf]
      exact f.toHom.map_adj (adjacent_short s).symm
  have hb : F.card≤(richThreshold t s M)^s*(F.image ev).card := card_le_mul_card_image F _ (by
    intro c hc
    exact center_count G U t s M _ r c (fun f hf => hg f (mem_filter.mp hf).1)
      (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hs).trans hC))).trans_eq (mul_comm _ _)

lemma second_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template s).Copy G)) (r : Root s → W) (w : W) (i : Fin s)
    (hg : ∀f∈F, GoodCopy G U t s M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (second i)=w) : F.card≤richThreshold t s M*(richThreshold t s M)^s := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := ThetaFour.threeFiber G U t w (r (.inl ()))
  have hC : C.card≤richThreshold t s M := by
    have h := (hg f₀ hf₀).short i
    change ¬richThreshold t s M < (ThetaFour.threeFiber G U t (f₀ (second i)) (f₀ (.inr (.inl ())))).card at h
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact le_of_not_gt h
  let ev : (template s).Copy G → W := fun f => f (center s)
  have hs : F.image ev⊆C.image Prod.snd := by
    intro c hc
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hc
    refine mem_image.mpr ⟨(f (first i),f (center s)),?_,rfl⟩
    have h := (hg f hf).short_mem i
    change _∈ThetaFour.threeFiber G U t (f (second i)) (f (.inr (.inl ()))) at h
    simpa only [hw f hf,hr f hf] using h
  have hb : F.card≤(richThreshold t s M)^s*(F.image ev).card := card_le_mul_card_image F _ (by
    intro c hc
    exact center_count G U t s M _ r c (fun f hf => hg f (mem_filter.mp hf).1)
      (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hs).trans (card_image_le.trans hC)))).trans_eq (mul_comm _ _)

end Erdos571.CubicSpider


/-! Uniform interior-pin loads and global good-spider copy counts. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def pinBound (t s M : ℕ) := (t+richThreshold t s M+1)*(richThreshold t s M+1)^s
def copyLoad (t s M : ℕ) := (2*s+1)*pinBound t s M

lemma pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template s).Copy G)) (r : Root s → W) (w : W) (a : Interior s)
    (hg : ∀f∈F, GoodCopy G U t s M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (.inl a)=w) : F.card≤pinBound t s M := by
  have hp : richThreshold t s M^s≤(richThreshold t s M+1)^s := Nat.pow_le_pow_left (by omega) s
  dsimp [pinBound]
  rcases a with (a|i)|j
  · have ha : a=0 := Subsingleton.elim _ _
    subst a
    have h := center_count G U t s M F r w hg hr hw
    exact (h.trans hp).trans (Nat.le_mul_of_pos_left _ (by omega))
  · have h := first_count G U t s M F r w i hg hr hw
    exact h.trans (Nat.mul_le_mul (by omega) hp)
  · have h := second_count G U t s M F r w j hg hr hw
    exact h.trans (Nat.mul_le_mul (by omega) hp)

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (F : Finset ((template s).Copy G)) (r : Root s → W)
    (hg : ∀f∈F, GoodCopy G U t s M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤copyLoad t s M := by
  classical
  let A (a : Interior s) := F.filter (fun f => f (.inl a)=w)
  have hs : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨hf,ha⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hs
    _ ≤ ∑a : Interior s, (A a).card := card_biUnion_le
    _ ≤ ∑_a : Interior s, pinBound t s M := sum_le_sum (fun a ha =>
      pinned_count G U t s M (A a) r w a (fun f hf => hg f (mem_filter.mp hf).1)
        (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by
      simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_fin,nsmul_eq_mul,Nat.cast_id]
      unfold copyLoad
      congr 1
      omega

lemma power_eq (s M : ℕ) : RootedPacking.power (template s) M=graph s M := by
  ext u v
  cases u <;> cases v
  · rfl
  · rfl
  · rfl
  · simp [RootedPacking.power,graph,FullRootedPower.graph,template,AnchoredArms.template]

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (hf : (graph s M).Free G) (F : Finset ((template s).Copy G)) (r : Root s ↪ W)
    (hg : ∀f∈F, GoodCopy G U t s M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) :
    F.card<M*(2*s+1)*copyLoad t s M := by
  classical
  by_contra! hc
  have hB : 0<copyLoad t s M := by dsimp [copyLoad,pinBound]; positivity
  have hh := RootedPacking.power_contained_of_bounded_load F id r hr (copyLoad t s M) M hB
    (interior_load G U t s M F r hg hr) (by
      simpa only [Fintype.card_sum,Fintype.card_fin,show 1+s+s=2*s+1 by omega] using hc)
  rw [power_eq] at hh
  exact hf hh

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s M : ℕ)
    (hf : (graph s M).Free G) (F : Finset ((template s).Copy G))
    (hg : ∀f∈F, GoodCopy G U t s M f) :
    (F.card:ℝ)≤(M*(2*s+1)*copyLoad t s M:ℕ)*(U.card:ℝ)^(s+1) := by
  have h := RootedFiberCount.bound (template s) G U F (fun f hf r => (hg f hf).mem _)
    (B := (M*(2*s+1)*copyLoad t s M:ℕ)) (by positivity) (by
      intro r F' hF' hr
      exact_mod_cast (rooted_count G U t s M hf F' r (fun f hf => hg f (hF' hf)) hr).le)
  simpa only [Fintype.card_sum,Fintype.card_unit,Fintype.card_fin,Nat.add_comm 1 s] using h

end Erdos571.CubicSpider


/-! Restricting a connected copy to four prescribed distinct vertices. -/
namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization
variable {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]

lemma four_walk_restriction (H : SimpleGraph V) (hH : H.Connected)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (e : Fin 4 ↪ V) (F : Finset (H.Copy G)) (B : Finset ((W×W)×(W×W)))
    (hm : ∀f∈F, ∀v, f v∈U) (hb : ∀f∈F, ((f (e 0),f (e 1)),(f (e 2),f (e 3)))∈B) :
    (F.card:ℝ)≤B.card*D^(Fintype.card V-4) := by
  classical
  let vals : (W×W)×(W×W) → Fin 4 → W := fun p => ![p.1.1,p.1.2,p.2.1,p.2.2]
  have h := restriction_bound H hH G U hD hdeg e F (B.image vals) hm (by
    intro f hf
    refine mem_image.mpr ⟨((f (e 0),f (e 1)),(f (e 2),f (e 3))),hb f hf,?_⟩
    funext i
    fin_cases i <;> rfl)
  simp only [Fintype.card_fin] at h
  exact h.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast card_image_le (s := B) (f := vals)) (by positivity))

end Erdos571.ConnectedCopyBound


/-! The long arms and the reversed paths to the distinguished short root. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph

def longPath {s : ℕ} (i : Fin s) : Fin 4 ↪ Vertex s :=
  ⟨![center s,first i,second i,root i],by
    intro a b he
    fin_cases a <;> fin_cases b <;> simp_all [center,first,second,root]⟩

def shortPath {s : ℕ} (i : Fin s) : Fin 4 ↪ Vertex s :=
  ⟨![second i,first i,center s,short s],by
    intro a b he
    fin_cases a <;> fin_cases b <;> simp_all [center,first,second,short]⟩

def path {s : ℕ} (p : Fin s⊕Fin s) : Fin 4 ↪ Vertex s :=
  p.elim longPath shortPath

lemma path_adj {s : ℕ} (p : Fin s⊕Fin s) :
    (template s).Adj (path p 0) (path p 1) ∧
    (template s).Adj (path p 1) (path p 2) ∧
    (template s).Adj (path p 2) (path p 3) := by
  cases p with
  | inl i => exact ⟨adjacent_first i,adjacent_second i,adjacent_root i⟩
  | inr i => exact ⟨(adjacent_second i).symm,(adjacent_first i).symm,adjacent_short s⟩

end Erdos571.CubicSpider


/-! Every spider copy is good, nonlight, or contains a rich three-path. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma card_vertex (s : ℕ) : Fintype.card (Vertex s)=3*s+2 := by
  simp only [Fintype.card_sum,Fintype.card_fin,Fintype.card_unit]
  omega

lemma rich_subpath_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph s M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (p : Fin s⊕Fin s) (F : Finset ((template s).Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hl : ∀f∈F, ConnectedCopyBound.Light (template s) G U t f)
    (hr : ∀f∈F, Rich G U t s M (f (path p 0)) (f (path p 3))) :
    (F.card:ℝ)≤richCoeff s M*U.card*D^(3-richGain s M)*D^(3*s-2) := by
  classical
  have hb := ConnectedCopyBound.four_walk_restriction (template s) (connected s) G U hD hdeg
    (path p) F (richWalks G U t s M) hm (by
      intro f hf
      refine mem_filter.mpr ⟨mem_filter.mpr ⟨?_,?_,?_⟩,hr f hf⟩
      · exact ShortSpider.mem_threeWalks.mpr ⟨hm f hf _,hm f hf _,hm f hf _,hm f hf _,
          f.toHom.map_adj (path_adj p).1,f.toHom.map_adj (path_adj p).2.1,
          f.toHom.map_adj (path_adj p).2.2⟩
      · exact not_or.mpr ⟨f.injective.ne ((path p).injective.ne (by decide)),
          not_le.mpr (hl f hf _ _ _ (path_adj p).1 (path_adj p).2.1 ((path p).injective.ne (by decide)))⟩
      · exact not_or.mpr ⟨f.injective.ne ((path p).injective.ne (by decide)),
          not_le.mpr (hl f hf _ _ _ (path_adj p).2.1 (path_adj p).2.2 ((path p).injective.ne (by decide)))⟩)
  rw [card_vertex,show 3*s+2-4=3*s-2 by omega] at hb
  exact hb.trans (mul_le_mul_of_nonneg_right (richWalks_bound G U t s M hM g hg hf hD hdeg) (by positivity))

theorem all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t s M : ℕ) (hM : 1≤M) (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (hf : (graph s M).Free G) {D : ℝ} (hD : 0≤D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (F : Finset ((template s).Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ)≤(M*(2*s+1)*copyLoad t s M:ℕ)*(U.card:ℝ)^(s+1)+
      (3*(s:ℝ)+2)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(3*s-1)+
      2*s*richCoeff s M*U.card*D^(3-richGain s M)*D^(3*s-2) := by
  classical
  let A := F.filter (GoodCopy G U t s M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light (template s) G U t f)
  let C (p : Fin s⊕Fin s) := F.filter (fun f => ConnectedCopyBound.Light (template s) G U t f ∧
    Rich G U t s M (f (path p 0)) (f (path p 3)))
  have hs : F⊆A∪B∪univ.biUnion C := by
    intro f hf
    by_cases hl : ConnectedCopyBound.Light (template s) G U t f
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩))
    by_cases hp : ∀p : Fin s⊕Fin s, ¬Rich G U t s M (f (path p 0)) (f (path p 3))
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hm f hf,hl,
        fun i => hp (.inl i),fun i => hp (.inr i)⟩))
    · simp only [not_forall,not_not] at hp
      obtain ⟨p,hp⟩ := hp
      exact mem_union_right _ (mem_biUnion.mpr ⟨p,mem_univ _,mem_filter.mpr ⟨hf,hl,hp⟩⟩)
  have hA := good_count G U t s M hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card:ℝ)≤(3*(s:ℝ)+2)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(3*s-1) := by
    have h := ConnectedCopyBound.nonlight_bound (template s) (connected s) G U t hD hdeg B
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    simpa only [card_vertex,show 3*s+2-3=3*s-1 by omega,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,mul_assoc] using h
  have hC : ((univ.biUnion C).card:ℝ)≤2*s*richCoeff s M*U.card*D^(3-richGain s M)*D^(3*s-2) := by
    have hc : ((univ.biUnion C).card:ℝ)≤∑p : Fin s⊕Fin s, ((C p).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun p hp => rich_subpath_count G U t s M hM g hg hf hD hdeg p (C p)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2.1)
      (fun f hf => (mem_filter.mp hf).2.2))
    simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_fin,nsmul_eq_mul,Nat.cast_add] at hh
    exact hc.trans (hh.trans_eq (by ring))
  have hc := (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hc' : (F.card:ℝ)≤A.card+B.card+(univ.biUnion C).card := by exact_mod_cast hc
  linarith

end Erdos571.CubicSpider


/-! The heavy leading coefficient is made small; all other powers are lower order. -/
namespace Erdos571.CubicSpider
open Filter Asymptotics

noncomputable def countError (s M K : ℕ) (D : ℝ) : ℝ :=
  (3*(s:ℝ)+2)^3*(2/(K:ℝ)*D^2+(2*(s:ℝ)+7)*D)*D^(3*s-1)+
    2*s*richCoeff s M*D^(3-richGain s M)*D^(3*s-2)

lemma countError_eq (s M K : ℕ) (hs : 1≤s) {D : ℝ} (hD : 0<D) :
    countError s M K D = (2*(3*(s:ℝ)+2)^3/(K:ℝ))*D^(3*s+1)+
      ((3*(s:ℝ)+2)^3*(2*(s:ℝ)+7))*D^(3*s)+
      (2*s*richCoeff s M)*D^(3-richGain s M+((3*s-2:ℕ):ℝ)) := by
  have hmain : D^2*D^(3*s-1)=D^(3*s+1) := by rw [←pow_add]; congr 1; omega
  have hlin : D*D^(3*s-1)=D^(3*s) := by rw [←pow_succ']; congr 1; omega
  have hrich : D^(3-richGain s M)*D^(3*s-2)=D^(3-richGain s M+((3*s-2:ℕ):ℝ)) := by
    rw [Real.rpow_add hD,Real.rpow_natCast]
  calc
    _ = (2*(3*(s:ℝ)+2)^3/(K:ℝ))*(D^2*D^(3*s-1))+
        ((3*(s:ℝ)+2)^3*(2*(s:ℝ)+7))*(D*D^(3*s-1))+
        (2*s*richCoeff s M)*(D^(3-richGain s M)*D^(3*s-2)) := by unfold countError; ring
    _ = _ := by rw [hmain,hlin,hrich]

lemma exists_error_threshold (s M : ℕ) (hs : 1≤s) (hM : 1≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃K : ℕ, 1≤K ∧ ∃L : ℝ, 4*(3*s+3:ℕ)≤L ∧ ∀d : ℝ, L≤d →
      countError s M K (Q*d)≤(d/4)^(3*s+1)/2 := by
  let k := 3*s+1
  let p := 3*s
  let e : ℝ := 3-richGain s M+((3*s-2:ℕ):ℝ)
  let A : ℝ := (3*(s:ℝ)+2)^3
  obtain ⟨K,hK⟩ := exists_nat_gt (8*A*4^k*Q^k)
  have hQpos : 0<Q := by linarith
  have hApos : 0<A := by dsimp [A]; positivity
  have hKpos : (0:ℝ)<K := lt_trans (by positivity) hK
  have hK1 : 1≤K := by exact_mod_cast (show 0<K by exact_mod_cast hKpos)
  have h4 : (0:ℝ)<4*4^k := by positivity
  have hsmall : 2*A*Q^k/(K:ℝ)≤1/(4*4^k) := by
    apply (div_le_div_iff₀ hKpos h4).mpr
    nlinarith
  let B : ℝ := A*(2*(s:ℝ)+7)*Q^p
  let C : ℝ := 2*s*richCoeff s M*Q^e
  have hpk : (p:ℝ)<k := by dsimp [p,k]; push_cast; linarith
  have hek : e<(k:ℝ) := by
    have hg := richGain_pos s M hM
    have he : ((3*s-2:ℕ):ℝ)=3*(s:ℝ)-2 := by
      rw [Nat.cast_sub (by omega),Nat.cast_mul]; norm_num
    dsimp [e,k]
    rw [he]
    push_cast
    linarith
  have ho : (fun d : ℝ => B*d^(p:ℝ)+C*d^e)=o[atTop] (fun d => d^(k:ℝ)) :=
    ((ThetaFour.rpow_littleO hpk).const_mul_left B).add ((ThetaFour.rpow_littleO hek).const_mul_left C)
  obtain ⟨L,hL⟩ := eventually_atTop.mp (ho.def (c := 1/(4*4^k)) (by positivity))
  refine ⟨K,hK1,max (4*(3*s+3:ℕ)) L,le_max_left _ _,?_⟩
  intro d hd
  have hdl : (4*(3*s+3:ℕ):ℝ)≤d := (le_max_left _ _).trans hd
  have hdpos : 0<d := lt_of_lt_of_le (by positivity) hdl
  have h := hL d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hdpos.le _)] at h
  have herr := (le_abs_self (B*d^(p:ℝ)+C*d^e)).trans h
  have hmain := mul_le_mul_of_nonneg_right hsmall (pow_nonneg hdpos.le k)
  have heq : countError s M K (Q*d)=B*d^(p:ℝ)+C*d^e+(2*A*Q^k/(K:ℝ))*d^k := by
    rw [countError_eq s M K hs (mul_pos hQpos hdpos),Real.mul_rpow hQpos.le hdpos.le]
    simp only [Real.rpow_natCast]
    dsimp [A,B,C,p,e,k]
    rw [mul_pow,mul_pow]
    ring
  rw [heq]
  simp only [Real.rpow_natCast] at herr
  have hsum : B*d^(p:ℝ)+C*d^e+(2*A*Q^k/(K:ℝ))*d^k≤2*(1/(4*4^k)*d^k) := by
    simpa only [Real.rpow_natCast,two_mul] using add_le_add herr hmain
  exact hsum.trans_eq (by dsimp [k]; rw [div_pow]; ring)

end Erdos571.CubicSpider


/-! Sharp ordinary upper bounds for three-edge-arm spider powers. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeBase (s M K : ℕ) : ℝ :=
  2*4^(3*s+1)*(M*(2*s+1)*copyLoad (heavyThreshold s M K) s M:ℕ)

noncomputable def degreeCoefficient (s M K : ℕ) : ℝ :=
  (degreeBase s M K)^(((3*s+1:ℕ):ℝ)⁻¹)

lemma degreeCoefficient_nonneg (s M K : ℕ) : 0≤degreeCoefficient s M K := by
  unfold degreeCoefficient degreeBase
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (s M K : ℕ) (hM : 1≤M) (hf : (graph s M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 0<d) (hdlarge : 4*(3*s+3:ℕ)≤d)
    (herr : countError s M K (Q*d)≤(d/4)^(3*s+1)/2) (hK : 1≤K)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) :
    d≤degreeCoefficient s M K*(U.card:ℝ)^((s:ℝ)/((3*s+1:ℕ):ℝ)) := by
  classical
  have hn : (0:ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0≤Q*d := by positivity
  let F := TreeCopiesIn.copies (template s) G U
  have hl : (U.card:ℝ)*(d/4)^(3*s+1)≤F.card := by
    have hh := TreeCopiesIn.lower (template s) (isTree s) G U (d := d) (by
      simp only [card_vertex,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat]
      push_cast at hdlarge
      linarith)
      (fun v hv => (hdeg v hv).1)
    simpa only [card_vertex,Nat.add_sub_cancel] using hh
  have hu := all_count G U (heavyThreshold s M K) s M hM g hg hf hD
    (fun v hv => (hdeg v hv).2) F (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have hbad := badPairs_sum_bound G g hg U s M K hK hf hD (fun v hv => (hdeg v hv).2)
  have hb := mul_le_mul_of_nonneg_right hbad (show 0≤(3*(s:ℝ)+2)^3*(Q*d)^(3*s-1) by positivity)
  let C : ℝ := (M*(2*s+1)*copyLoad (heavyThreshold s M K) s M:ℕ)
  have hc : (U.card:ℝ)*(d/4)^(3*s+1)≤C*(U.card:ℝ)^(s+1)+U.card*countError s M K (Q*d) := by
    dsimp [C,countError]
    nlinarith
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (U.card:ℝ)*(d/4)^(3*s+1)≤2*C*(U.card:ℝ)^(s+1) := by linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0≤(4:ℝ)^(3*s+1) by positivity)
  have heq : (U.card:ℝ)*(d/4)^(3*s+1)*4^(3*s+1)=U.card*d^(3*s+1) := by
    rw [div_pow]; field_simp
  rw [heq,pow_succ (U.card:ℝ) s] at hm'
  have hpower : d^(3*s+1)≤degreeBase s M K*(U.card:ℝ)^s := by
    apply (mul_le_mul_iff_left₀ hn).mp
    dsimp [degreeBase]
    dsimp [C] at hm'
    nlinarith
  exact LongSpider.degree_of_power (3*s+1) s (by omega) hn.le hd.le (by unfold degreeBase; positivity) hpower

/-- The almost-regular estimate for a properly colored host. -/
theorem exists_regular_bound (s M : ℕ) (hs : 1≤s) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀{u v}, G.Adj u v → g u≠g v) → (graph s M).Free G → ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+(s:ℝ)/((3*s+1:ℕ):ℝ)) := by
  obtain ⟨K,hK,L,hLs,herr⟩ := exists_error_threshold s M hs hM Q hQ
  let B := degreeCoefficient s M K
  have hB : 0 ≤ B := degreeCoefficient_nonneg s M K
  have hL : 0≤L := le_trans (by positivity) hLs
  refine ⟨Q*(L+B),by have hL : 0≤L := le_trans (by positivity) hLs; positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^((s:ℝ)/((3*s+1:ℕ):ℝ)) := Real.one_le_rpow hn1 (by positivity)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^((s:ℝ)/((3*s+1:ℕ):ℝ)) := by
    by_cases hdl : d ≤ L
    · have hL : 0≤L := le_trans (by positivity) hLs
      nlinarith
    · have hl := large_degree_bound G U hU s M K hM hf g hg hQ hd
        (hLs.trans (le_of_not_ge hdl)) (herr d (le_of_not_ge hdl)) hK hdeg
      have hnn : 0 ≤ (U.card:ℝ)^((s:ℝ)/((3*s+1:ℕ):ℝ)) := by positivity
      change d ≤ B*_ at hl
      have hL : 0≤L := le_trans (by positivity) hLs
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^((s:ℝ)/((3*s+1:ℕ):ℝ))) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp ordinary upper bound for each fixed spider power. -/
theorem edge_bound (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph s M) (1+(s:ℝ)/((3*s+1:ℕ):ℝ)) D := by
  let γ : ℝ := (s:ℝ)/((3*s+1:ℕ):ℝ)
  have hγ : 0 < γ := by
    have hs0 : (0:ℝ)<s := by exact_mod_cast (show 0<s by omega)
    dsimp [γ]
    positivity
  have hγ1 : γ ≤ 1 := by
    dsimp [γ]
    apply (div_le_one (by positivity)).mpr
    exact_mod_cast (show s ≤ 3*s+1 by omega)
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+γ)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left,Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound s M hs hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph s M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+γ) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.CubicSpider


/-! Exact cubic-spider exponents, including 13/10, and their paired cones. -/
namespace Erdos571.CubicSpider
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (s : ℕ) :
    1+(s:ℝ)/((3*s+1:ℕ):ℝ)=2-((2*s+1:ℕ):ℝ)/((3*s+1:ℕ):ℝ) := by
  have hden : ((3*s+1:ℕ):ℝ)≠0 := by positivity
  push_cast
  field_simp
  <;> ring

theorem layered_supported (s : ℕ) (hs : 1≤s) :
    Supported (LayeredTrees.template [s,1]) (2-((2*s+1:ℕ):ℝ)/((3*s+1:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound s M hs (by omega)
  rw [exponent_eq] at hbound
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  apply hbound.estimate G
  intro h
  exact hf ((powerIso s M).symm.isContained.trans h)

theorem certificate (s : ℕ) (hs : 1≤s) : Certificate (2*s+1) (3*s+1) :=
  ⟨LayeredTrees.Interior [s,1],Option (LayeredTrees.Leaves [s,1]),
    inferInstance,inferInstance,inferInstance,inferInstance,
    LayeredTrees.template [s,1],LayeredTrees.fullColor [s,1],LayeredTrees.fullColor_proper [s,1],
    (LayeredTrees.isTree [s,1]).isConnected,LayeredTrees.no_isolated [s,1],
    by simpa only [(counts s).1,(counts s).2] using LayeredTrees.balance [s,1] (valid s hs),
    layered_supported s hs⟩

theorem iterated_certificate (s t : ℕ) (hs : 1≤s) :
    Certificate (2*s+1) (3*s+1+t*(2*s+1)) := by
  induction t with
  | zero => simpa using certificate s hs
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 3*s+1+(t+1)*(2*s+1)=3*s+1+t*(2*s+1)+(2*s+1) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

theorem exact_family (s t : ℕ) (hs : 1≤s) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(2*s+1:ℚ)/(3*s+1+t*(2*s+1):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate s t hs).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_thirteen_tenths :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((13/10:ℚ):ℝ)) := by
  have h := exact_family 3 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.CubicSpider

/-! Rectangular Kővári–Sós–Turán moments with an arbitrary common-fiber bound. -/
namespace Erdos571.RectangularKstMoment
open Finset
variable {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]

lemma embedding_filter_card (P : A → Prop) [DecidablePred P] (M : ℕ) :
    letI := Classical.decEq (Fin M ↪ A)
    (univ.filter (fun f : Fin M ↪ A => ∀i, P (f i))).card=
      (univ.filter P).card.descFactorial M := by
  classical
  let e : {f : Fin M ↪ A // ∀i, P (f i)} ≃ (Fin M ↪ {a : A // P a}) :=
    { toFun := fun f => ⟨fun i => ⟨f.val i,f.property i⟩,fun i j h => f.val.injective (congrArg Subtype.val h)⟩
      invFun := fun f => ⟨f.trans (Function.Embedding.subtype P),fun i => (f i).property⟩
      left_inv := by intro f; apply Subtype.ext; ext i; rfl
      right_inv := by intro f; ext i; rfl }
  have h := Fintype.card_congr e
  simpa only [Fintype.card_subtype,Fintype.card_embedding_eq,Fintype.card_fin] using h

def common (P : A → B → Prop) [DecidableRel P] (M : ℕ) (f : Fin M ↪ A) : Finset B :=
  univ.filter (fun b => ∀i, P (f i) b)

lemma desc_moment (P : A → B → Prop) [DecidableRel P] (M T : ℕ)
    (hT : ∀f : Fin M ↪ A, (common P M f).card≤T) :
    (∑b : B, (univ.filter (fun a => P a b)).card.descFactorial M)≤T*(Fintype.card A)^M := by
  classical
  have he : (∑b : B, (univ.filter (fun a => P a b)).card.descFactorial M)=
      ∑f : Fin M ↪ A, (common P M f).card := by
    calc
      _ = ∑b : B, (univ.filter (fun f : Fin M ↪ A => ∀i, P (f i) b)).card :=
        sum_congr rfl (fun b _ => (embedding_filter_card (fun a => P a b) M).symm)
      _ = _ := by
        simpa only [bipartiteAbove,bipartiteBelow,common] using
          (sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
            (s := (univ : Finset B)) (t := (univ : Finset (Fin M ↪ A)))
            (fun b (f : Fin M ↪ A) => ∀i, P (f i) b))
  rw [he]
  calc
    _ ≤ ∑_f : Fin M ↪ A, T := sum_le_sum (fun f _ => hT f)
    _ = T*(Fintype.card A).descFactorial M := by simp [Fintype.card_embedding_eq,mul_comm]
    _ ≤ _ := Nat.mul_le_mul_left _ (Nat.descFactorial_le_pow _ _)

lemma pow_le_desc (n M : ℕ) : n^M≤2^M*n.descFactorial M+(2*M)^M := by
  by_cases h : 2*M≤n
  · have hp : n≤2*(n+1-M) := by omega
    have hpow := Nat.pow_le_pow_left hp M
    rw [mul_pow] at hpow
    exact (hpow.trans (Nat.mul_le_mul_left _ (Nat.pow_sub_le_descFactorial n M))).trans (Nat.le_add_right _ _)
  · exact (Nat.pow_le_pow_left (by omega : n≤2*M) M).trans (Nat.le_add_left _ _)

lemma moment (P : A → B → Prop) [DecidableRel P] (M T : ℕ)
    (hT : ∀f : Fin M ↪ A, (common P M f).card≤T) :
    (∑b : B, (univ.filter (fun a => P a b)).card^M)≤
      2^M*T*(Fintype.card A)^M+(2*M)^M*Fintype.card B := by
  have hd := desc_moment P M T hT
  calc
    _ ≤ ∑b : B, (2^M*(univ.filter (fun a => P a b)).card.descFactorial M+(2*M)^M) :=
      sum_le_sum (fun b _ => pow_le_desc _ _)
    _ = 2^M*(∑b : B, (univ.filter (fun a => P a b)).card.descFactorial M)+(2*M)^M*Fintype.card B := by
      simp [sum_add_distrib,←mul_sum,mul_comm]
    _ ≤ _ := by nlinarith [Nat.mul_le_mul_left (2^M) hd]

lemma edge_moment (P : A → B → Prop) [DecidableRel P] (M T : ℕ) (hM : 1≤M)
    (hT : ∀f : Fin M ↪ A, (common P M f).card≤T) :
    ((univ.filter (fun p : A×B => P p.1 p.2)).card:ℝ)^M≤
      (Fintype.card B:ℝ)^(M-1)*
        ((2:ℝ)^M*T*(Fintype.card A:ℝ)^M+(2*M)^M*Fintype.card B) := by
  classical
  have hj := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg (s := (univ : Finset B))
    (f := fun b => ((univ.filter (fun a => P a b)).card:ℝ))
    (p := (M:ℝ)) (by exact_mod_cast hM) (fun b _ => Nat.cast_nonneg _)
  have he : (univ.filter (fun p : A×B => P p.1 p.2)).card=
      ∑b : B, (univ.filter (fun a => P a b)).card := by
    simp only [card_filter,Fintype.sum_prod_type]
    rw [sum_comm]
  have hs : (∑b : B, ((univ.filter (fun a => P a b)).card:ℝ))=
      ((univ.filter (fun p : A×B => P p.1 p.2)).card:ℝ) := by exact_mod_cast he.symm
  have hex : (M:ℝ)-1=((M-1:ℕ):ℝ) := by rw [Nat.cast_sub hM,Nat.cast_one]
  simp only [hs,card_univ,hex,Real.rpow_natCast] at hj
  have hm : (∑b : B, ((univ.filter (fun a => P a b)).card:ℝ)^M)≤
      (2:ℝ)^M*T*(Fintype.card A:ℝ)^M+(2*M)^M*Fintype.card B := by
    exact_mod_cast moment P M T hT
  exact hj.trans (mul_le_mul_of_nonneg_left hm (by positivity))

end Erdos571.RectangularKstMoment


/-! A product box without a disjoint tuple packing has codimension-one size. -/
namespace Erdos571.TupleBoxPacking
open Finset
variable {I W : Type} [Fintype I] [DecidableEq I] [DecidableEq W]

def foot (f : I → W) : Finset W := univ.image f

lemma foot_card (f : I → W) : (foot f).card≤Fintype.card I := by
  simpa only [foot,card_univ] using card_image_le (s := (univ : Finset I)) (f := f)

lemma foot_nonempty [Nonempty I] (f : I → W) : (foot f).Nonempty := univ_nonempty.image f

lemma box_card (X : I → Finset W) (D : ℕ) (hD : ∀i, (X i).card≤D) :
    (Fintype.piFinset X).card≤D^(Fintype.card I) := by
  rw [Fintype.card_piFinset]
  exact (prod_le_prod' (fun i _ => hD i)).trans_eq (by simp)

lemma coordinate_load (X : I → Finset W) (D : ℕ) (hD : ∀i, (X i).card≤D) (i : I) (w : W) :
    ((Fintype.piFinset X).filter (fun f => f i=w)).card≤D^(Fintype.card I-1) := by
  rw [Fintype.card_filter_piFinset_eq X i w]
  split_ifs
  · exact (prod_le_prod' (fun j _ => hD j)).trans_eq (by simp)
  · omega

lemma box_load (X : I → Finset W) (D : ℕ) (hD : ∀i, (X i).card≤D) (w : W) :
    ((Fintype.piFinset X).filter (fun f => w∈foot f)).card≤
      Fintype.card I*D^(Fintype.card I-1) := by
  have hs : (Fintype.piFinset X).filter (fun f => w∈foot f)⊆
      univ.biUnion (fun i => (Fintype.piFinset X).filter (fun f => f i=w)) := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    obtain ⟨i,hi,he⟩ := mem_image.mp hw
    exact mem_biUnion.mpr ⟨i,hi,mem_filter.mpr ⟨hf,he⟩⟩
  exact ((card_le_card hs).trans card_biUnion_le).trans ((sum_le_sum (fun i _ => coordinate_load X D hD i w)).trans_eq (by simp))

lemma cover_bound (X : I → Finset W) (D : ℕ) (hD : ∀i, (X i).card≤D)
    (F : Finset (I → W)) (hF : F⊆Fintype.piFinset X) (Z : Finset W)
    (hZ : ∀f∈F, ∃w∈foot f, w∈Z) :
    F.card≤Z.card*Fintype.card I*D^(Fintype.card I-1) := by
  have hs : F⊆Z.biUnion (fun w => (Fintype.piFinset X).filter (fun f => w∈foot f)) := by
    intro f hf
    obtain ⟨w,hw,hZ⟩ := hZ f hf
    exact mem_biUnion.mpr ⟨w,hZ,mem_filter.mpr ⟨hF hf,hw⟩⟩
  exact ((card_le_card hs).trans card_biUnion_le).trans ((sum_le_sum (fun w _ => box_load X D hD w)).trans_eq (by simp; ring))

lemma no_packing_bound [Nonempty I] (X : I → Finset W) (D p : ℕ) (hD : ∀i, (X i).card≤D)
    (F : Finset (I → W)) (hF : F⊆Fintype.piFinset X)
    (hno : ¬∃S⊆F, S.card=p ∧ ∀f∈S, ∀g∈S, f≠g → Disjoint (foot f) (foot g)) :
    F.card≤(Fintype.card I)^2*p*D^(Fintype.card I-1) := by
  obtain ⟨Z,hZ,hcover⟩ := RootedPacking.small_cover_of_no_packing F foot (Fintype.card I) p
    (fun f _ => foot_nonempty f) (fun f _ => foot_card f) hno
  have h := cover_bound X D hD F hF Z hcover
  have hz : Z.card≤Fintype.card I*p := hZ.trans (Nat.mul_le_mul_left _ (Nat.sub_le _ _))
  exact h.trans (by nlinarith [Nat.mul_le_mul_right (Fintype.card I*D^(Fintype.card I-1)) hz])

end Erdos571.TupleBoxPacking


/-! A codimension-one common-fiber bound gives a positive degree saving. -/
namespace Erdos571.RectangularKstMoment
open Finset
variable {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]

lemma scaled_moment (P : A → B → Prop) [DecidableRel P] (M q : ℕ) (hM : 1≤M) (hq : 1≤q)
    {C D : ℝ} (hC : 0≤C) (hD : 1≤D) (hA : (Fintype.card A:ℝ)≤D)
    (hB : (Fintype.card B:ℝ)≤D^q)
    (hT : ∀f : Fin M ↪ A, ((common P M f).card:ℝ)≤C*D^(q-1)) :
    ((univ.filter (fun p : A×B => P p.1 p.2)).card:ℝ)^M≤
      ((2:ℝ)^M*C+(2*M)^M)*D^(q*(M-1)+(q-1+M)) := by
  classical
  let T := ⌊C*D^(q-1)⌋₊
  have hTf (f : Fin M ↪ A) : (common P M f).card≤T := Nat.le_floor (hT f)
  have ht : (T:ℝ)≤C*D^(q-1) := Nat.floor_le (by positivity)
  have hm := edge_moment P M T hM hTf
  have hbp : (Fintype.card B:ℝ)^(M-1)≤D^(q*(M-1)) := by
    simpa only [pow_mul] using pow_le_pow_left₀ (Nat.cast_nonneg _) hB (M-1)
  have h1 : (2:ℝ)^M*T*(Fintype.card A:ℝ)^M≤(2:ℝ)^M*(C*D^(q-1))*D^M := by
    gcongr
  have h2 : (2*(M:ℝ))^M*Fintype.card B≤(2*(M:ℝ))^M*D^(q-1+M) := by
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    exact hB.trans (pow_le_pow_right₀ hD (by omega))
  have hi : (2:ℝ)^M*T*(Fintype.card A:ℝ)^M+(2*M)^M*Fintype.card B≤
      ((2:ℝ)^M*C+(2*M)^M)*D^(q-1+M) := by
    rw [pow_add] at h2 ⊢
    nlinarith
  exact hm.trans ((mul_le_mul hbp hi (by positivity) (by positivity)).trans_eq (by
    rw [pow_add] at h2 ⊢
    ring))

lemma scaled_bound (P : A → B → Prop) [DecidableRel P] (M q : ℕ) (hM : 1≤M) (hq : 1≤q)
    {C D : ℝ} (hC : 0≤C) (hD : 1≤D) (hA : (Fintype.card A:ℝ)≤D)
    (hB : (Fintype.card B:ℝ)≤D^q)
    (hT : ∀f : Fin M ↪ A, ((common P M f).card:ℝ)≤C*D^(q-1)) :
    ((univ.filter (fun p : A×B => P p.1 p.2)).card:ℝ)≤
      ((2:ℝ)^M*C+(2*M)^M)^((M:ℝ)⁻¹)*D^((q:ℝ)+1-1/(M:ℝ)) := by
  have hm := scaled_moment P M q hM hq hC hD hA hB hT
  have h := LongSpider.degree_of_power M (q*(M-1)+(q-1+M)) (by omega)
    (by linarith : 0≤D) (Nat.cast_nonneg _) (by positivity) hm
  have hM0 : (M:ℝ)≠0 := by exact_mod_cast (show M≠0 by omega)
  have he : ((q*(M-1)+(q-1+M):ℕ):ℝ)/(M:ℝ)=(q:ℝ)+1-1/(M:ℝ) := by
    push_cast
    rw [Nat.cast_sub hM,Nat.cast_sub hq]
    push_cast
    field_simp
    ring
  simpa only [he] using h

end Erdos571.RectangularKstMoment


/-! Scalar-versus-tuple incidence bounds with vertex-disjoint root tuples. -/
namespace Erdos571.TupleBoxKst
open Finset
variable {A I W : Type} [Fintype A] [Fintype I] [Nonempty I]
  [DecidableEq A] [DecidableEq I] [DecidableEq W]

noncomputable def coefficient (q p M : ℕ) : ℝ :=
  ((2:ℝ)^M*(q:ℝ)^2*p+(2*M)^M)^((M:ℝ)⁻¹)

lemma bound (X : I → Finset W) (P : A → (I → W) → Prop) [DecidableRel P]
    (p M : ℕ) (hM : 1≤M) {D : ℝ} (hD : 1≤D)
    (hA : (Fintype.card A:ℝ)≤D) (hX : ∀i, ((X i).card:ℝ)≤D)
    (hno : ∀a : Fin M ↪ A, ¬∃S⊆Fintype.piFinset X, S.card=p ∧
      (∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g)) ∧
      ∀f∈S, ∀i, P (a i) f) :
    (((univ×ˢFintype.piFinset X).filter (fun e => P e.1 e.2)).card:ℝ)≤
      coefficient (Fintype.card I) p M*D^((Fintype.card I:ℝ)+1-1/(M:ℝ)) := by
  classical
  let B := Fintype.piFinset X
  let Q : A → B → Prop := fun a b => P a b.val
  have hq : 1≤Fintype.card I := Fintype.card_pos
  have hXn : ∀i, (X i).card≤⌊D⌋₊ := fun i => Nat.le_floor (hX i)
  have hB : (Fintype.card B:ℝ)≤D^(Fintype.card I) := by
    rw [Fintype.card_coe]
    exact (show (B.card:ℝ)≤(⌊D⌋₊:ℝ)^(Fintype.card I) by
      exact_mod_cast TupleBoxPacking.box_card X ⌊D⌋₊ hXn).trans
      (pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le (by linarith)) _)
  have hT (a : Fin M ↪ A) :
      ((RectangularKstMoment.common Q M a).card:ℝ)≤(Fintype.card I:ℝ)^2*p*D^(Fintype.card I-1) := by
    let F := B.filter (fun f => ∀i, P (a i) f)
    have hnoF : ¬∃S⊆F, S.card=p ∧ ∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g) := by
      rintro ⟨S,hSF,hS,hdis⟩
      exact hno a ⟨S,hSF.trans (filter_subset _ _),hS,hdis,fun f hf => (mem_filter.mp (hSF hf)).2⟩
    have hb := TupleBoxPacking.no_packing_bound X ⌊D⌋₊ p hXn F (filter_subset _ _) hnoF
    have he : (RectangularKstMoment.common Q M a).card=F.card := by
      apply card_bij (fun b _ => b.val)
      · intro b hb
        exact mem_filter.mpr ⟨b.property,(mem_filter.mp hb).2⟩
      · intro b hb c hc he
        exact Subtype.ext he
      · intro f hf
        exact ⟨⟨f,(mem_filter.mp hf).1⟩,mem_filter.mpr ⟨mem_univ _,(mem_filter.mp hf).2⟩,rfl⟩
    rw [he]
    calc
      _ ≤ (Fintype.card I:ℝ)^2*p*(⌊D⌋₊:ℝ)^(Fintype.card I-1) := by exact_mod_cast hb
      _ ≤ _ := mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le (by linarith)) _) (by positivity)
  have hb := RectangularKstMoment.scaled_bound Q M (Fintype.card I) hM hq (by positivity) hD hA hB hT
  have he : (univ.filter (fun e : A×B => Q e.1 e.2)).card=
      ((univ×ˢB).filter (fun e => P e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1,e.2.val))
    · intro e he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,e.2.property⟩,(mem_filter.mp he).2⟩
    · intro e he f hf hef
      exact Prod.ext (Prod.mk.inj hef).1 (Subtype.ext (Prod.mk.inj hef).2)
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(e.1,⟨e.2,(mem_product.mp he).2⟩),mem_filter.mpr ⟨mem_univ _,hP⟩,rfl⟩
  simpa only [he,coefficient,mul_assoc] using hb

end Erdos571.TupleBoxKst


/-! Pairwise disjoint copy interiors form a single injective layout. -/
namespace Erdos571.RootedPacking
open Finset SimpleGraph
variable {I A R W : Type} [Fintype A] [DecidableEq W]

def packedInterior {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}
    (f : I → H.Copy G) (hdis : Pairwise (fun i j => Disjoint (interior (f i)) (interior (f j)))) :
    I×A ↪ W :=
  ⟨fun p => f p.1 (.inl p.2),by
    rintro ⟨i,a⟩ ⟨j,b⟩ he
    change f i (.inl a)=f j (.inl b) at he
    by_cases hij : i=j
    · subst j
      exact Prod.ext rfl (Sum.inl.inj ((f i).injective he))
    · exact (Finset.disjoint_left.mp (hdis hij) (mem_interior (f i) a)
        (he.symm ▸ mem_interior (f j) b)).elim⟩

end Erdos571.RootedPacking


/-! Homogeneous fans of short spiders, with two independent branching parameters. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph

abbrev Core (p : ℕ) := Fin 1⊕Fin p
abbrev Arms (p q : ℕ) := Fin p×Fin q
abbrev Interior (p q : ℕ) := Core p⊕Arms p q
abbrev Root (p q : ℕ) := Unit⊕Arms p q
abbrev Vertex (p q : ℕ) := Interior p q⊕Root p q

def template (p q : ℕ) := AnchoredArms.template (KstUpper.Star p) (.inl 0)
  (fun i : Arms p q => .inr i.1)
def graph (p q M : ℕ) := FullRootedPower.graph (template p q) M

def center (p q : ℕ) : Vertex p q := .inl (.inl (.inl 0))
def hub {p q : ℕ} (i : Fin p) : Vertex p q := .inl (.inl (.inr i))
def middle {p q : ℕ} (i : Fin p) (j : Fin q) : Vertex p q := .inl (.inr (i,j))
def short (p q : ℕ) : Vertex p q := .inr (.inl ())
def root {p q : ℕ} (i : Fin p) (j : Fin q) : Vertex p q := .inr (.inr (i,j))

def coreColor {p : ℕ} : Core p → Bool := Sum.elim (fun _ => true) (fun _ => false)
def color {p q : ℕ} : Vertex p q → Bool := AnchoredArms.color (@coreColor p)

lemma coreColor_proper (p : ℕ) : ∀{u v}, (KstUpper.Star p).Adj u v → coreColor u≠coreColor v := by
  intro u v h
  cases u <;> cases v <;> simp_all [KstUpper.Star,completeBipartiteGraph,coreColor]

lemma color_proper (p q : ℕ) : ∀{u v}, (template p q).Adj u v → color u≠color v :=
  AnchoredArms.color_proper _ _ _ _ (coreColor_proper p) rfl (fun _ => rfl)

lemma adj_short (p q : ℕ) : (template p q).Adj (center p q) (short p q) := rfl
lemma adj_hub {p q : ℕ} (i : Fin p) : (template p q).Adj (center p q) (hub i) := by
  simp [template,AnchoredArms.template,center,hub,KstUpper.Star,completeBipartiteGraph]
lemma adj_middle {p q : ℕ} (i : Fin p) (j : Fin q) : (template p q).Adj (hub i) (middle i j) := rfl
lemma adj_root {p q : ℕ} (i : Fin p) (j : Fin q) : (template p q).Adj (middle i j) (root i j) := rfl

def nonrootEquiv (p q : ℕ) : Interior p q ≃ LayeredTrees.Interior [p,q] where
  toFun
    | .inl (.inl _) => none
    | .inl (.inr i) => some (i,none)
    | .inr (i,j) => some (i,some (j,()))
  invFun
    | none => .inl (.inl 0)
    | some (i,none) => .inl (.inr i)
    | some (i,some (j,_)) => .inr (i,j)
  left_inv := by
    rintro ((a|i)|⟨i,j⟩)
    · fin_cases a; rfl
    · rfl
    · rfl
  right_inv := by
    rintro (_|⟨i,_|⟨j,u⟩⟩)
    · rfl
    · rfl
    · cases u; rfl

def rootEquiv (p q : ℕ) : Root p q ≃ Option (LayeredTrees.Leaves [p,q]) where
  toFun
    | .inl _ => none
    | .inr (i,j) => some (i,(j,()))
  invFun
    | none => .inl ()
    | some (i,j,_) => .inr (i,j)
  left_inv := by
    rintro (u|⟨i,j⟩)
    · cases u; rfl
    · rfl
  right_inv := by
    rintro (_|⟨i,j,u⟩)
    · rfl
    · cases u; rfl

def modelIso (p q : ℕ) : template p q ≃g LayeredTrees.template [p,q] where
  toEquiv := Equiv.sumCongr (nonrootEquiv p q) (rootEquiv p q)
  map_rel_iff' := by
    rintro (((a|i)|⟨j,k⟩)|(u|⟨m,n⟩)) (((b|i')|⟨j',k'⟩)|(u'|⟨m',n'⟩))
    all_goals first | fin_cases a | skip
    all_goals first | fin_cases b | skip
    all_goals first | cases u | skip
    all_goals first | cases u' | skip
    all_goals simp [template,AnchoredArms.template,KstUpper.Star,completeBipartiteGraph,
      LayeredTrees.template,LeafRooted.graph,RootedIncidence.graph,LayeredTrees.core,
      TreeFan.graph,LayeredTrees.anchor,LayeredTrees.rootAttach,LayeredTrees.attach,
      LayeredTrees.Interior,LayeredTrees.Leaves,nonrootEquiv,rootEquiv]
    all_goals simp only [eq_comm,and_comm]

def powerIso (p q M : ℕ) : graph p q M ≃g LayeredTrees.graph [p,q] M :=
  FullRootedPower.isoOfRelabel (template p q) (LayeredTrees.template [p,q])
    (nonrootEquiv p q) (rootEquiv p q) (fun u v => (modelIso p q).map_rel_iff.symm) M

lemma isTree (p q : ℕ) : (template p q).IsTree :=
  (modelIso p q).isTree_iff.mpr (LayeredTrees.isTree [p,q])
lemma connected (p q : ℕ) : (template p q).Connected := (isTree p q).isConnected
lemma no_isolated (p q : ℕ) : ∀v, ∃w, (template p q).Adj v w := by
  rintro (((a|i)|⟨i,j⟩)|(u|⟨i,j⟩))
  · have ha : a=0 := Subsingleton.elim _ _
    subst a
    exact ⟨short p q,adj_short p q⟩
  · exact ⟨center p q,(adj_hub i).symm⟩
  · exact ⟨hub i,(adj_middle i j).symm⟩
  · cases u
    exact ⟨center p q,(adj_short p q).symm⟩
  · exact ⟨middle i j,(adj_root i j).symm⟩

lemma card_vertex (p q : ℕ) : Fintype.card (Vertex p q)=p+2*p*q+2 := by
  simp only [Fintype.card_sum,Fintype.card_fin,Fintype.card_unit,Fintype.card_prod]
  ring

end Erdos571.FanSpider


/-! Uniform heavy two-path cleaning for every homogeneous fan. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def heavyThreshold (p q M L : ℕ) := AnchoredArms.heavyThreshold (Core p) (Arms p q) M L

lemma badPairs_sum_bound (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
    (p q M L : ℕ) (hL : 1≤L) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold p q M L) v).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+(2*(p:ℝ)*q+7)*D) := by
  have h := AnchoredArms.badPairs_sum_bound (KstUpper.Star p) (KstUpper.star_tree p)
    (.inl 0) (fun i : Arms p q => .inr i.1) coreColor (coreColor_proper p) rfl (fun _ => rfl)
    G g hg U M L hL hf hD hdeg
  simpa only [heavyThreshold,Fintype.card_prod,Fintype.card_fin,Nat.cast_mul,mul_assoc] using h

end Erdos571.FanSpider


/-! Balanced lower bounds for fans with at least two branches. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph

lemma counts (p q : ℕ) : LayeredTrees.nonroots [p,q]=p+p*q+1 ∧
    LayeredTrees.edges [p,q]=p+2*p*q+1 := by
  simp only [LayeredTrees.nonroots,LayeredTrees.edges]
  constructor <;> ring

lemma valid (p q : ℕ) (hp : 2≤p) (hq : 1≤q) : LayeredTrees.Valid [p,q] := by
  norm_num [LayeredTrees.Valid,LayeredTrees.edges,LayeredTrees.nonroots]
  constructor
  · omega
  · nlinarith

lemma exists_lower (p q : ℕ) (hp : 2≤p) (hq : 1≤q) : ∃M : ℕ, 2≤M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^((2:ℝ)-(p+p*q+1:ℕ)/(p+2*p*q+1:ℕ)))
      (fun n : ℕ => (extremalNumber n (graph p q M):ℝ)) := by
  obtain ⟨M,hM,h⟩ := LayeredTrees.exists_lower [p,q] (valid p q hp hq)
  refine ⟨M,hM,?_⟩
  have he (n : ℕ) : extremalNumber n (graph p q M)=extremalNumber n (LayeredTrees.graph [p,q] M) :=
    extremalNumber_congr_right (powerIso p q M)
  simpa only [he,(counts p q).1,(counts p q).2] using h

end Erdos571.FanSpider


/-! Original and rerooted short-spider subtemplates in a homogeneous fan. -/
namespace Erdos571.FanSpider
set_option maxHeartbeats 2000000
open Finset SimpleGraph

def branchCopy {p q : ℕ} (i : Fin p) : (ShortSpider.template q).Copy (template p q) where
  toHom :=
    { toFun := Sum.elim (fun a => a.elim (hub i) (middle i)) (fun r => r.elim (center p q) (root i))
      map_rel' := by
        rintro (a|r) (b|s) h
        all_goals first | cases a | skip
        all_goals first | cases b | skip
        all_goals first | cases r | skip
        all_goals first | cases s | skip
        all_goals simp_all [ShortSpider.template,template,AnchoredArms.template,hub,middle,center,root,
          KstUpper.Star,completeBipartiteGraph] }
  injective' := by
    rintro (a|r) (b|s) h
    all_goals first | cases a | skip
    all_goals first | cases b | skip
    all_goals first | cases r | skip
    all_goals first | cases s | skip
    all_goals simp_all [hub,middle,center,root]

def rerootCopy {p q : ℕ} (i : Fin p) (j : Fin q) : (ShortSpider.template q).Copy (template p q) where
  toHom :=
    { toFun := Sum.elim
        (fun a => a.elim (hub i) (fun k => if k=j then center p q else middle i k))
        (fun r => r.elim (middle i j) (fun k => if k=j then short p q else root i k))
      map_rel' := by
        rintro (a|r) (b|s) h
        all_goals first | cases a | skip
        all_goals first | cases b | skip
        all_goals first | cases r | skip
        all_goals first | cases s | skip
        all_goals simp only [ShortSpider.template] at h
        all_goals simp only [Sum.elim_inl,Sum.elim_inr,Option.elim_none,Option.elim_some]
        all_goals (try split_ifs) <;> simp_all [template,AnchoredArms.template,hub,middle,center,short,root,
          KstUpper.Star,completeBipartiteGraph] }
  injective' := by
    rintro (a|r) (b|s) h
    all_goals first | cases a | skip
    all_goals first | cases b | skip
    all_goals first | cases r | skip
    all_goals first | cases s | skip
    all_goals simp_all [hub,middle,center,short,root]
    all_goals split_ifs at h <;> simp_all

end Erdos571.FanSpider


/-! Direct layouts for powers of the homogeneous two-level fan. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W]

lemma contains_of_layout (G : SimpleGraph W) (p q M : ℕ)
    (u : Fin M ↪ W) (a : Fin M×Fin p ↪ W) (b : Fin M×Arms p q ↪ W) (r : Root p q ↪ W)
    (hua : ∀i j, u i≠a j) (hub : ∀i j, u i≠b j) (hur : ∀i j, u i≠r j)
    (hab : ∀i j, a i≠b j) (har : ∀i j, a i≠r j) (hbr : ∀i j, b i≠r j)
    (hshort : ∀i, G.Adj (u i) (r (.inl ())))
    (hfirst : ∀i j, G.Adj (u i) (a (i,j)))
    (hsecond : ∀i j k, G.Adj (a (i,j)) (b (i,(j,k))))
    (hroot : ∀i j k, G.Adj (b (i,(j,k))) (r (.inr (j,k)))) : graph p q M ⊑ G := by
  let core : Fin M×Core p ↪ W :=
    { toFun := fun p => match p.2 with | .inl _ => u p.1 | .inr j => a (p.1,j)
      inj' := by
        rintro ⟨i,v|j⟩ ⟨i',v'|j'⟩ he
        · exact Prod.ext (u.injective he) (congrArg Sum.inl (Subsingleton.elim v v'))
        · exact (hua _ _ he).elim
        · exact (hua _ _ he.symm).elim
        · have hh := a.injective he
          have hii : i=i' := congrArg Prod.fst hh
          have hjj : j=j' := congrArg Prod.snd hh
          subst i'
          subst j'
          rfl }
  apply AnchoredArms.contains_of_layout (KstUpper.Star p) (.inl 0) (fun j : Arms p q => .inr j.1) G M core b r
  · rintro ⟨i,v|j⟩ q he
    · exact hub _ _ he
    · exact hab _ _ he
  · rintro ⟨i,v|j⟩ q he
    · exact hur _ _ he
    · exact har _ _ he
  · exact hbr
  · rintro i (v|j) (v'|j') h
    · simp [KstUpper.Star,completeBipartiteGraph] at h
    · exact hfirst _ _
    · exact (hfirst _ _).symm
    · simp [KstUpper.Star,completeBipartiteGraph] at h
  · exact hshort
  · intro i j
    exact ⟨hsecond i j.1 j.2,hroot i j.1 j.2⟩

end Erdos571.FanSpider


/-! Rich short-spider fibers can be amalgamated into a full homogeneous fan power. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def branchLoad (t q : ℕ) := (q+1)*t^(q+1)
def richThreshold (t p q M : ℕ) := (p*q+1+M+(q+1)*M*p)*branchLoad t q

noncomputable def Rich (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (u : W) (r : Fin q → W) : Prop :=
  richThreshold t p q M<(LongSpider.shortFiber G U t q u r).card

lemma contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1≤t) (r : Root p q ↪ W) (u : Fin M ↪ W)
    (hu : ∀i, G.Adj (u i) (r (.inl ()))) (hur : ∀i j, u i≠r j)
    (hrich : ∀i j, Rich G U t p q M (u i) (fun k => r (.inr (j,k)))) : graph p q M ⊑ G := by
  classical
  let Z := univ.image r ∪ univ.image u
  have hZ : Z.card≤p*q+1+M := by
    have h := card_union_le (univ.image r) (univ.image u)
    have hr := card_image_le (s := univ) (f := r)
    have hu := card_image_le (s := univ) (f := u)
    simp only [card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,Fintype.card_unit] at hr hu
    dsimp [Z]
    omega
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice_finite (q+1) (branchLoad t q)
    RootedPacking.interior
    (fun z : Fin M×Fin p => LongSpider.shortFiber G U t q (u z.1) (fun k => r (.inr (z.2,k)))) Z
    (by intro z f hf; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card f).le)
    (fun z w => LongSpider.shortFiber_load G U t q ht (u z.1) (fun k => r (.inr (z.2,k))) w)
    (by
      intro z
      have h := hrich z.1 z.2
      change richThreshold t p q M<_ at h
      simp only [Fintype.card_prod,Fintype.card_fin]
      apply lt_of_le_of_lt _ h
      dsimp [richThreshold]
      exact Nat.mul_le_mul_right _ (by nlinarith))
  let E := RootedPacking.packedInterior f hfdis
  let a : Fin M×Fin p ↪ W :=
    { toFun := fun z => E (z,none)
      inj' := fun _ _ h => congrArg Prod.fst (E.injective h) }
  let b : Fin M×Arms p q ↪ W :=
    { toFun := fun z => E ((z.1,z.2.1),some z.2.2)
      inj' := by
        rintro ⟨i,j,k⟩ ⟨i',j',k'⟩ he
        have h := E.injective he
        have hij := (Prod.mk.inj h).1
        have hk := Option.some.inj (Prod.mk.inj h).2
        exact Prod.ext (Prod.mk.inj hij).1 (Prod.ext (Prod.mk.inj hij).2 hk) }
  have havoid (z : Fin M×Fin p) (v : Option (Fin q)) (w : W) (hw : w∈Z) : f z (.inl v)≠w := by
    intro he
    exact Finset.disjoint_left.mp (hfZ z) (RootedPacking.mem_interior (f z) v) (he.symm ▸ hw)
  have huZ (i : Fin M) : u i∈Z := mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩)
  have hrZ (j : Root p q) : r j∈Z := mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩)
  have hroots (z : Fin M×Fin p) := (LongSpider.mem_shortFiber G U t q (u z.1) (fun k => r (.inr (z.2,k))) (f z)).mp (hf z)
  apply contains_of_layout G p q M u a b r
  · intro i z
    exact (havoid z none (u i) (huZ i)).symm
  · intro i z
    exact (havoid (z.1,z.2.1) (some z.2.2) (u i) (huZ i)).symm
  · exact hur
  · intro z z' he
    have h := E.injective he
    have hh := (Prod.mk.inj h).2
    simp at hh
  · intro z j
    exact havoid z none (r j) (hrZ j)
  · intro z j
    exact havoid (z.1,z.2.1) (some z.2.2) (r j) (hrZ j)
  · exact hu
  · intro i j
    change G.Adj (u i) (f (i,j) (.inl none))
    rw [←(hroots (i,j)).2.1]
    exact (f (i,j)).toHom.map_adj rfl
  · intro i j k
    exact (f (i,j)).toHom.map_adj trivial
  · intro i j k
    change G.Adj (f (i,j) (.inl (some k))) (r (.inr (j,k)))
    rw [←(hroots (i,j)).2.2 k]
    exact (f (i,j)).toHom.map_adj rfl

end Erdos571.FanSpider


/-! Rich short-spider tuples are sparse in every product neighborhood box. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_distinct {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t p q M : ℕ} {u : W} {r : Fin q → W} (h : Rich G U t p q M u r) :
    Function.Injective r ∧ ∀j, u≠r j := by
  obtain ⟨f,hf⟩ := card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) h)
  have hr := (LongSpider.mem_shortFiber G U t q u r f).mp hf
  constructor
  · intro j k he
    have hfk : f (.inr (some j))=f (.inr (some k)) := (hr.2.2 j).trans (he.trans (hr.2.2 k).symm)
    exact Option.some.inj (Sum.inr.inj (f.injective hfk))
  · intro j he
    have hfk : f (.inr none)=f (.inr (some j)) := hr.2.1.trans (he.trans (hr.2.2 j).symm)
    have hh := Sum.inr.inj (f.injective hfk)
    simp at hh

def boxRel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (z u : W) (r : Fin q → W) : Prop :=
  Rich G U t p q M u r ∧ ∀j, r j≠z

lemma box_no_packing (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph p q M).Free G)
    (z : W) (X : Fin q → Finset W) (a : Fin M ↪ neighbors G U z) :
    ¬∃S⊆Fintype.piFinset X, S.card=p ∧
      (∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g)) ∧
      ∀f∈S, ∀i, boxRel G U t p q M z (a i) f := by
  rintro ⟨S,hSX,hS,hdis,hrel⟩
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by simpa using hS.symm)
  let u : Fin M ↪ W := a.trans (Function.Embedding.subtype _)
  let i₀ : Fin M := ⟨0,by omega⟩
  have hroot (j : Fin p) := rich_distinct (hrel (e j) (e j).property i₀).1
  let r : Root p q ↪ W :=
    { toFun := Sum.elim (fun _ => z) (fun x => (e x.1).val x.2)
      inj' := by
        rintro (v|⟨j,k⟩) (v'|⟨j',k'⟩) he
        · exact congrArg Sum.inl (Subsingleton.elim _ _)
        · exact ((hrel (e j') (e j').property i₀).2 k' he.symm).elim
        · exact ((hrel (e j) (e j).property i₀).2 k he).elim
        · by_cases hj : j=j'
          · subst j'
            exact congrArg Sum.inr (Prod.ext rfl ((hroot j).1 he))
          · have he' : (e j).val≠(e j').val := fun hh => hj (e.injective (Subtype.ext hh))
            exact (Finset.disjoint_left.mp (hdis (e j) (e j).property (e j') (e j').property he')
              (mem_image.mpr ⟨k,mem_univ _,rfl⟩) (mem_image.mpr ⟨k',mem_univ _,he.symm⟩)).elim }
  apply hf (contains_of_rich_neighbors G U t p q M ht r u ?_ ?_ ?_)
  · intro i
    exact (mem_filter.mp (a i).property).2.symm
  · intro i j
    cases j with
    | inl v => exact G.ne_of_adj (mem_filter.mp (a i).property).2.symm
    | inr x => exact (rich_distinct (hrel (e x.1) (e x.1).property i).1).2 x.2
  · intro i j
    exact (hrel (e j) (e j).property i).1

lemma box_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (z : W) (v : Fin q → W) {D : ℝ} (hD : 1≤D)
    (hz : ((neighbors G U z).card:ℝ)≤D) (hv : ∀j, ((neighbors G U (v j)).card:ℝ)≤D) :
    letI : DecidableRel (boxRel G U t p q M z) := fun _ _ => Classical.propDecidable _
    (((neighbors G U z×ˢFintype.piFinset (fun j => neighbors G U (v j))).filter
      (fun e => boxRel G U t p q M z e.1 e.2)).card:ℝ)≤
      TupleBoxKst.coefficient q p M*D^((q:ℝ)+1-1/(M:ℝ)) := by
  classical
  letI : Nonempty (Fin q) := ⟨⟨0,by omega⟩⟩
  let A := neighbors G U z
  let X : Fin q → Finset W := fun j => neighbors G U (v j)
  let P : A → (Fin q → W) → Prop := fun a r => boxRel G U t p q M z a.val r
  have hb := TupleBoxKst.bound X P p M hM hD (by simpa only [Fintype.card_coe] using hz) hv
    (box_no_packing G U t p q M ht hM hf z X)
  have he : ((univ×ˢFintype.piFinset X).filter (fun e : A×(Fin q → W) => P e.1 e.2)).card=
      ((A×ˢFintype.piFinset X).filter (fun e => boxRel G U t p q M z e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1.val,e.2))
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨e.1.property,(mem_product.mp he).2⟩,hP⟩
    · intro e he f hf hef
      exact Prod.ext (Subtype.ext (Prod.mk.inj hef).1) (Prod.mk.inj hef).2
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(⟨e.1,(mem_product.mp he).1⟩,e.2),
        mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,(mem_product.mp he).2⟩,hP⟩,rfl⟩
  simpa only [he,Fintype.card_fin] using hb

end Erdos571.FanSpider


/-! Counting rich short-spider copies by their fixed interior stars. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def richBranches (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) : Finset ((ShortSpider.template q).Copy G) := by
  classical
  exact (TreeCopiesIn.copies (ShortSpider.template q) G U).filter
    (fun f => Rich G U t p q M (f (.inr none)) (fun j => f (.inr (some j))))

def branchCores (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (q : ℕ) : Finset (W×(Fin q → W)) :=
  U.biUnion (fun z => (Fintype.piFinset (fun _ : Fin q => neighbors G U z)).image (fun v => (z,v)))

lemma branchCores_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (q : ℕ)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((branchCores G U q).card:ℝ)≤U.card*D^q := by
  have h : (branchCores G U q).card≤∑z∈U, (neighbors G U z).card^q := by
    exact card_biUnion_le.trans (sum_le_sum (fun z hz => card_image_le.trans_eq (by
      simp only [Fintype.card_piFinset,prod_const,card_univ,Fintype.card_fin])))
  calc
    _ ≤ ∑z∈U, ((neighbors G U z).card:ℝ)^q := by exact_mod_cast h
    _ ≤ ∑_z∈U, D^q := sum_le_sum (fun z hz => pow_le_pow_left₀ (Nat.cast_nonneg _) (hdeg z hz) q)
    _ = _ := by simp

lemma richBranches_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((richBranches G U t p q M).card:ℝ)≤
      TupleBoxKst.coefficient q p M*U.card*D^q*D^((q:ℝ)+1-1/(M:ℝ)) := by
  classical
  let F := richBranches G U t p q M
  let pre : (ShortSpider.template q).Copy G → W×(Fin q → W) :=
    fun f => (f (.inl none),fun j => f (.inl (some j)))
  have hm (f) (hf : f∈F) : ∀v, f v∈U :=
    (TreeCopiesIn.mem_copies _ _ _ _).mp (mem_filter.mp hf).1
  have hmap (f) (hf : f∈F) : pre f∈branchCores G U q := by
    refine mem_biUnion.mpr ⟨f (.inl none),hm f hf _,mem_image.mpr ⟨(fun j => f (.inl (some j))),?_,rfl⟩⟩
    exact Fintype.mem_piFinset.mpr (fun j => mem_filter.mpr ⟨hm f hf _,f.toHom.map_adj trivial⟩)
  have hcount := RealFiberCount.bound F (branchCores G U q) pre hmap
    (D := TupleBoxKst.coefficient q p M*D^((q:ℝ)+1-1/(M:ℝ))) (by
      intro v hv
      obtain ⟨z,hz,hv⟩ := mem_biUnion.mp hv
      obtain ⟨v',hv',he⟩ := mem_image.mp hv
      subst v
      let B := ((neighbors G U z)×ˢFintype.piFinset (fun j => neighbors G U (v' j))).filter
        (fun e => boxRel G U t p q M z e.1 e.2)
      have hc : (F.filter (fun f => pre f=(z,v'))).card≤B.card := by
        apply card_le_card_of_injOn (fun f => (f (.inr none),fun j => f (.inr (some j))))
        · intro f hf'
          obtain ⟨hf',he⟩ := mem_filter.mp hf'
          have hez : f (.inl none)=z := congrArg Prod.fst he
          have hev : (fun j => f (.inl (some j)))=v' := congrArg Prod.snd he
          refine mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hm f hf' _,?_⟩,?_⟩,
            (mem_filter.mp hf').2,?_⟩
          · rw [←hez]
            exact f.toHom.map_adj rfl
          · apply Fintype.mem_piFinset.mpr
            intro j
            refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←congrFun hev j]
            exact f.toHom.map_adj rfl
          · intro j
            rw [←hez]
            exact f.injective.ne Sum.inr_ne_inl
        · intro f hf' f' hf'' he
          have hp := (mem_filter.mp hf').2.trans (mem_filter.mp hf'').2.symm
          have hz : f (.inl none)=f' (.inl none) := congrArg Prod.fst hp
          have hv : (fun j => f (.inl (some j)))=(fun j => f' (.inl (some j))) := congrArg Prod.snd hp
          have hr := Prod.mk.inj he
          apply Copy.ext
          rintro (a|r)
          · cases a with
            | none => exact hz
            | some j => exact congrFun hv j
          · cases r with
            | none => exact hr.1
            | some j => exact congrFun hr.2 j
      exact (show _≤(B.card:ℝ) by exact_mod_cast hc).trans
        (box_bound G U t p q M ht hq hM hf z v' hD (hdeg z hz)
          (fun j => hdeg _ (mem_filter.mp (Fintype.mem_piFinset.mp hv' j)).1)))
  have hh := mul_le_mul_of_nonneg_right (branchCores_bound G U q (by linarith) hdeg)
    (show 0≤TupleBoxKst.coefficient q p M*D^((q:ℝ)+1-1/(M:ℝ)) by unfold TupleBoxKst.coefficient; positivity)
  exact hcount.trans (hh.trans_eq (by ring))

end Erdos571.FanSpider


/-! Good homogeneous fan copies and their bounded center fibers. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

abbrev Branch (p q : ℕ) := Fin p⊕(Fin p×Fin q)
def subCopy {p q : ℕ} (b : Branch p q) : (ShortSpider.template q).Copy (template p q) :=
  b.elim branchCopy (fun x => rerootCopy x.1 x.2)

structure GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (f : (template p q).Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light (template p q) G U t f
  branch : ∀b : Branch p q, ¬Rich G U t p q M (f (subCopy b (.inr none)))
    (fun j => f (subCopy b (.inr (some j))))

lemma GoodCopy.child_good {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t p q M : ℕ}
    {f : (template p q).Copy G} (h : GoodCopy G U t p q M f) (b : Branch p q) :
    ShortSpider.GoodCopy G U t q (f.comp (subCopy b)) := by
  refine ⟨fun v => h.mem _,?_⟩
  intro j
  constructor
  · exact h.light _ _ _ ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inr none) (.inl none) from rfl))
      ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inl none) (.inl (some j)) from trivial))
      ((subCopy b).injective.ne Sum.inr_ne_inl)
  · exact h.light _ _ _ ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inl none) (.inl (some j)) from trivial))
      ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inl (some j)) (.inr (some j)) from rfl))
      ((subCopy b).injective.ne Sum.inl_ne_inr)

lemma branch_image_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (b : Branch p q) (r : Option (Fin q) → W)
    (hg : ∀f∈F, GoodCopy G U t p q M f)
    (hr : ∀f∈F, ∀a, f (subCopy b (.inr a))=r a) :
    (F.image (fun f => f.comp (subCopy b))).card≤richThreshold t p q M := by
  classical
  by_cases hF : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hF,image_empty,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  have hb : (LongSpider.shortFiber G U t q (r none) (fun j => r (some j))).card≤richThreshold t p q M := by
    have h := (hg f₀ hf₀).branch b
    simp only [hr f₀ hf₀] at h
    exact le_of_not_gt h
  apply le_trans _ hb
  apply card_le_card
  intro f hf
  obtain ⟨g,hg',rfl⟩ := mem_image.mp hf
  apply (LongSpider.mem_shortFiber _ _ _ _ _ _ _).mpr
  exact ⟨(hg g hg').child_good b,hr g hg' none,fun j => hr g hg' (some j)⟩

lemma center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (center p q)=w) : F.card≤richThreshold t p q M^p := by
  classical
  let C (i : Fin p) := F.image (fun f => f.comp (branchCopy i))
  have hC (i : Fin p) : (C i).card≤richThreshold t p q M :=
    branch_image_bound G U t p q M F (.inl i) (fun a => a.elim w (fun j => r (.inr (i,j)))) hg (by
      intro f hf a
      cases a with
      | none => exact hw f hf
      | some j => exact hr f hf (.inr (i,j)))
  let ev : F → ((i : Fin p) → C i) := fun f i => ⟨f.val.comp (branchCopy i),mem_image.mpr ⟨f.val,f.property,rfl⟩⟩
  have hi : Function.Injective ev := by
    intro f f' he
    have hchild (i : Fin p) : f.val.comp (branchCopy i)=f'.val.comp (branchCopy i) := congrArg Subtype.val (congrFun he i)
    apply Subtype.ext
    apply Copy.ext
    rintro (((a|i)|⟨i,j⟩)|x)
    · have ha : a=0 := Subsingleton.elim _ _
      subst a
      exact (hw f.val f.property).trans (hw f'.val f'.property).symm
    · exact congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl none)) (hchild i)
    · exact congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl (some j))) (hchild i)
    · exact (hr f.val f.property x).trans (hr f'.val f'.property x).symm
  have hc := Fintype.card_le_of_injective ev hi
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  calc
    _ ≤ ∏i : Fin p, Fintype.card (C i) := hc
    _ ≤ ∏_i : Fin p, richThreshold t p q M := prod_le_prod' (fun i _ => by simpa using hC i)
    _ = _ := by simp

end Erdos571.FanSpider


/-! Pinning any fan interior vertex gives a constant rooted-copy load. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

lemma hub_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W) (i : Fin p)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (hub i)=w) : F.card≤t*richThreshold t p q M^p := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := FourthMoment.common G U w (r (.inl ()))
  have hC : C.card≤t := by
    have h := (hg f₀ hf₀).light (hub i) (center p q) (short p q)
      (adj_hub i).symm (adj_short p q) (by simp [hub,short])
    change (FourthMoment.common G U (f₀ (hub i)) (f₀ (.inr (.inl ())))).card<t at h
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact h.le
  let ev : (template p q).Copy G → W := fun f => f (center p q)
  have hs : F.image ev⊆C := by
    intro c hc
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hc
    refine mem_filter.mpr ⟨(hg f hf).mem _,?_,?_⟩
    · rw [←hw f hf]
      exact f.toHom.map_adj (adj_hub i).symm
    · rw [←hr f hf]
      exact f.toHom.map_adj (adj_short p q).symm
  have hb : F.card≤richThreshold t p q M^p*(F.image ev).card := card_le_mul_card_image F _ (by
    intro c hc
    exact center_count G U t p q M _ r c (fun f hf => hg f (mem_filter.mp hf).1)
      (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hs).trans hC))).trans_eq (mul_comm _ _)

lemma middle_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W) (i : Fin p) (j : Fin q)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (middle i j)=w) : F.card≤richThreshold t p q M*richThreshold t p q M^p := by
  classical
  let rr : Option (Fin q) → W := fun a => a.elim w (fun k => if k=j then r (.inl ()) else r (.inr (i,k)))
  have hroot (f) (hf : f∈F) (a : Option (Fin q)) : f (subCopy (.inr (i,j)) (.inr a))=rr a := by
    cases a with
    | none => exact hw f hf
    | some k =>
      change f (if k=j then short p q else root i k)=(if k=j then r (.inl ()) else r (.inr (i,k)))
      by_cases hk : k=j
      · rw [if_pos hk,if_pos hk]
        exact hr f hf (.inl ())
      · rw [if_neg hk,if_neg hk]
        exact hr f hf (.inr (i,k))
  let C := F.image (fun f => f.comp (rerootCopy i j))
  have hC : C.card≤richThreshold t p q M := branch_image_bound G U t p q M F (.inr (i,j)) rr hg hroot
  let ev : (template p q).Copy G → W := fun f => f (center p q)
  have hs : F.image ev⊆C.image (fun g => g (.inl (some j))) := by
    intro c hc
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hc
    refine mem_image.mpr ⟨f.comp (rerootCopy i j),mem_image.mpr ⟨f,hf,rfl⟩,?_⟩
    change f (if j=j then center p q else middle i j)=f (center p q)
    simp only [ite_true]
  have hb : F.card≤richThreshold t p q M^p*(F.image ev).card := card_le_mul_card_image F _ (by
    intro c hc
    exact center_count G U t p q M _ r c (fun f hf => hg f (mem_filter.mp hf).1)
      (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hs).trans (card_image_le.trans hC)))).trans_eq (mul_comm _ _)

end Erdos571.FanSpider


/-! Uniform interior-pin loads and global good-fan copy counts. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def pinBound (t p q M : ℕ) := (t+richThreshold t p q M+1)*(richThreshold t p q M+1)^p
def copyLoad (t p q M : ℕ) := (p+p*q+1)*pinBound t p q M

lemma pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W) (a : Interior p q)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (.inl a)=w) : F.card≤pinBound t p q M := by
  have hp : richThreshold t p q M^p≤(richThreshold t p q M+1)^p := Nat.pow_le_pow_left (by omega) p
  dsimp [pinBound]
  rcases a with (a|i)|j
  · have ha : a=0 := Subsingleton.elim _ _
    subst a
    have h := center_count G U t p q M F r w hg hr hw
    exact (h.trans hp).trans (Nat.le_mul_of_pos_left _ (by omega))
  · have h := hub_count G U t p q M F r w i hg hr hw
    exact h.trans (Nat.mul_le_mul (by omega) hp)
  · have h := middle_count G U t p q M F r w j.1 j.2 hg hr hw
    exact h.trans (Nat.mul_le_mul (by omega) hp)

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤copyLoad t p q M := by
  classical
  let A (a : Interior p q) := F.filter (fun f => f (.inl a)=w)
  have hs : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨hf,ha⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hs
    _ ≤ ∑a : Interior p q, (A a).card := card_biUnion_le
    _ ≤ ∑_a : Interior p q, pinBound t p q M := sum_le_sum (fun a ha =>
      pinned_count G U t p q M (A a) r w a (fun f hf => hg f (mem_filter.mp hf).1)
        (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by
      simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul,Nat.cast_id]
      unfold copyLoad
      congr 1
      omega

lemma power_eq (p q M : ℕ) : RootedPacking.power (template p q) M=graph p q M := by
  ext u v
  cases u <;> cases v
  · rfl
  · rfl
  · rfl
  · simp [RootedPacking.power,graph,FullRootedPower.graph,template,AnchoredArms.template]

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (hf : (graph p q M).Free G) (F : Finset ((template p q).Copy G)) (r : Root p q ↪ W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) :
    F.card<M*(p+p*q+1)*copyLoad t p q M := by
  classical
  by_contra! hc
  have hB : 0<copyLoad t p q M := by dsimp [copyLoad,pinBound]; positivity
  have hh := RootedPacking.power_contained_of_bounded_load F id r hr (copyLoad t p q M) M hB
    (interior_load G U t p q M F r hg hr) (by
      simpa only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,show 1+p+p*q=p+p*q+1 by omega] using hc)
  rw [power_eq] at hh
  exact hf hh

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (hf : (graph p q M).Free G) (F : Finset ((template p q).Copy G))
    (hg : ∀f∈F, GoodCopy G U t p q M f) :
    (F.card:ℝ)≤(M*(p+p*q+1)*copyLoad t p q M:ℕ)*(U.card:ℝ)^(p*q+1) := by
  have h := RootedFiberCount.bound (template p q) G U F (fun f hf r => (hg f hf).mem _)
    (B := (M*(p+p*q+1)*copyLoad t p q M:ℕ)) (by positivity) (by
      intro r F' hF' hr
      exact_mod_cast (rooted_count G U t p q M hf F' r (fun f hf => hg f (hF' hf)) hr).le)
  simpa only [Fintype.card_sum,Fintype.card_prod,Fintype.card_unit,Fintype.card_fin,Nat.add_comm 1 (p*q)] using h

end Erdos571.FanSpider


/-! Global fan copy counts with heavy and rich-subtree errors separated. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_subtree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (b : Branch p q) (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))) :
    (F.card:ℝ)≤TupleBoxKst.coefficient q p M*U.card*D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(M:ℝ)) := by
  classical
  have hb := ConnectedCopyBound.copy_restriction_bound (template p q) (connected p q) (ShortSpider.template q)
    (subCopy b) G U (by linarith) hdeg F (richBranches G U t p q M) hm (by
      intro f hf
      exact mem_filter.mpr ⟨(TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hm f hf _),hr f hf⟩)
  rw [card_vertex p q] at hb
  simp only [Fintype.card_sum,Fintype.card_option,Fintype.card_fin] at hb
  have he : p+2*p*q+2-(q+1+(q+1))=p+2*p*q-2*q := by omega
  rw [he] at hb
  have hh := mul_le_mul_of_nonneg_right (richBranches_bound G U t p q M ht hq hM hf hD hdeg)
    (show 0≤D^(p+2*p*q-2*q) by positivity)
  have hpq : q≤p*q := by simpa using Nat.mul_le_mul_right q hp
  have hmul : D^q*D^(p+2*p*q-2*q)=D^(p+2*p*q-q) := by
    rw [←pow_add]
    congr 1
    simp only [Nat.mul_assoc]
    omega
  exact hb.trans (hh.trans_eq (by
    calc
      _ = TupleBoxKst.coefficient q p M*U.card*(D^q*D^(p+2*p*q-2*q))*D^((q:ℝ)+1-1/(M:ℝ)) := by ring
      _ = _ := by rw [hmul]))

theorem all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ)≤(M*(p+p*q+1)*copyLoad t p q M:ℕ)*(U.card:ℝ)^(p*q+1)+
      ((p+2*p*q+2:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q-1)+
      (p+p*q:ℕ)*TupleBoxKst.coefficient q p M*U.card*D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(M:ℝ)) := by
  classical
  let A := F.filter (GoodCopy G U t p q M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light (template p q) G U t f)
  let C (b : Branch p q) := F.filter (fun f => Rich G U t p q M
    (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j)))))
  have hs : F⊆A∪B∪univ.biUnion C := by
    intro f hf
    by_cases hl : ConnectedCopyBound.Light (template p q) G U t f
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩))
    by_cases hb : ∀b : Branch p q, ¬Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hm f hf,hl,hb⟩))
    · simp only [not_forall,not_not] at hb
      obtain ⟨b,hb⟩ := hb
      exact mem_union_right _ (mem_biUnion.mpr ⟨b,mem_univ _,mem_filter.mpr ⟨hf,hb⟩⟩)
  have hA := good_count G U t p q M hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card:ℝ)≤((p+2*p*q+2:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q-1) := by
    have h := ConnectedCopyBound.nonlight_bound (template p q) (connected p q) G U t (by linarith) hdeg B
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    simpa only [card_vertex p q,show p+2*p*q+2-3=p+2*p*q-1 by omega,mul_assoc] using h
  have hC : ((univ.biUnion C).card:ℝ)≤
      (p+p*q:ℕ)*TupleBoxKst.coefficient q p M*U.card*D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(M:ℝ)) := by
    have hc : ((univ.biUnion C).card:ℝ)≤∑b : Branch p q, ((C b).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun b hb => rich_subtree_count G U t p q M ht hp hq hM hf hD hdeg b (C b)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul] at hh
    exact hc.trans (hh.trans_eq (by ring))
  have hc := (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hc' : (F.card:ℝ)≤A.card+B.card+(univ.biUnion C).card := by exact_mod_cast hc
  linarith

end Erdos571.FanSpider


/-! Absorbing the two lower-order fan errors after choosing a heavy scale. -/
namespace Erdos571.FanSpider
open Filter Asymptotics

noncomputable def countError (p q M K : ℕ) (D : ℝ) : ℝ :=
  ((p+2*p*q+2:ℕ):ℝ)^3*(2/(K:ℝ)*D^2+(2*(p:ℝ)*q+7)*D)*D^(p+2*p*q-1)+
    (p+p*q:ℕ)*TupleBoxKst.coefficient q p M*D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(M:ℝ))

lemma countError_eq (p q M K : ℕ) (hp : 1≤p) {D : ℝ} (hD : 0<D) :
    countError p q M K D = (2*((p+2*p*q+2:ℕ):ℝ)^3/(K:ℝ))*D^(p+2*p*q+1)+
      (((p+2*p*q+2:ℕ):ℝ)^3*(2*(p:ℝ)*q+7))*D^(p+2*p*q)+
      ((p+p*q:ℕ)*TupleBoxKst.coefficient q p M)*D^((q:ℝ)+1-1/(M:ℝ)+((p+2*p*q-q:ℕ):ℝ)) := by
  have hmain : D^2*D^(p+2*p*q-1)=D^(p+2*p*q+1) := by rw [←pow_add]; congr 1; omega
  have hlin : D*D^(p+2*p*q-1)=D^(p+2*p*q) := by rw [←pow_succ']; congr 1; omega
  have hrich : D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(M:ℝ))=D^((q:ℝ)+1-1/(M:ℝ)+((p+2*p*q-q:ℕ):ℝ)) := by
    rw [Real.rpow_add hD,Real.rpow_natCast,mul_comm]
  calc
    _ = (2*((p+2*p*q+2:ℕ):ℝ)^3/(K:ℝ))*(D^2*D^(p+2*p*q-1))+
        (((p+2*p*q+2:ℕ):ℝ)^3*(2*(p:ℝ)*q+7))*(D*D^(p+2*p*q-1))+
        ((p+p*q:ℕ)*TupleBoxKst.coefficient q p M)*(D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(M:ℝ))) := by unfold countError; ring
    _ = _ := by rw [hmain,hlin,hrich]

lemma exists_error_threshold (p q M : ℕ) (hp : 1≤p) (hM : 1≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃K : ℕ, 1≤K ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧ ∀d : ℝ, L≤d →
      countError p q M K (Q*d)≤(d/4)^(p+2*p*q+1)/2 := by
  let k := p+2*p*q+1
  let h := p+2*p*q
  let e : ℝ := (q:ℝ)+1-1/(M:ℝ)+((p+2*p*q-q:ℕ):ℝ)
  let A : ℝ := ((p+2*p*q+2:ℕ):ℝ)^3
  obtain ⟨K,hK⟩ := exists_nat_gt (8*A*4^k*Q^k)
  have hQpos : 0<Q := by linarith
  have hApos : 0<A := by dsimp [A]; positivity
  have hKpos : (0:ℝ)<K := lt_trans (by positivity) hK
  have hK1 : 1≤K := by exact_mod_cast (show 0<K by exact_mod_cast hKpos)
  have h4 : (0:ℝ)<4*4^k := by positivity
  have hsmall : 2*A*Q^k/(K:ℝ)≤1/(4*4^k) := by
    apply (div_le_div_iff₀ hKpos h4).mpr
    nlinarith
  let B : ℝ := A*(2*(p:ℝ)*q+7)*Q^h
  let C : ℝ := (p+p*q:ℕ)*TupleBoxKst.coefficient q p M*Q^e
  have hhk : (h:ℝ)<k := by dsimp [h,k]; push_cast; linarith
  have hek : e<(k:ℝ) := by
    have hMpos : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
    have hn : q≤p+2*p*q := by nlinarith
    have he : ((p+2*p*q-q:ℕ):ℝ)=(p+2*p*q:ℕ)-(q:ℝ) := Nat.cast_sub hn
    dsimp [e,k]
    rw [he]
    push_cast
    linarith [one_div_pos.mpr hMpos]
  have ho : (fun d : ℝ => B*d^(h:ℝ)+C*d^e)=o[atTop] (fun d => d^(k:ℝ)) :=
    ((ThetaFour.rpow_littleO hhk).const_mul_left B).add ((ThetaFour.rpow_littleO hek).const_mul_left C)
  obtain ⟨L,hL⟩ := eventually_atTop.mp (ho.def (c := 1/(4*4^k)) (by positivity))
  refine ⟨K,hK1,max (4*(p+2*p*q+3:ℕ)) L,le_max_left _ _,?_⟩
  intro d hd
  have hdl : (4*(p+2*p*q+3:ℕ):ℝ)≤d := (le_max_left _ _).trans hd
  have hdpos : 0<d := lt_of_lt_of_le (by positivity) hdl
  have hbound := hL d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hdpos.le _)] at hbound
  have herr := (le_abs_self (B*d^(h:ℝ)+C*d^e)).trans hbound
  have hmain := mul_le_mul_of_nonneg_right hsmall (pow_nonneg hdpos.le k)
  have heq : countError p q M K (Q*d)=B*d^(h:ℝ)+C*d^e+(2*A*Q^k/(K:ℝ))*d^k := by
    rw [countError_eq p q M K hp (mul_pos hQpos hdpos),Real.mul_rpow hQpos.le hdpos.le]
    simp only [Real.rpow_natCast]
    dsimp [A,B,C,h,e,k]
    rw [mul_pow,mul_pow]
    ring
  rw [heq]
  simp only [Real.rpow_natCast] at herr
  have hsum : B*d^(h:ℝ)+C*d^e+(2*A*Q^k/(K:ℝ))*d^k≤2*(1/(4*4^k)*d^k) := by
    simpa only [Real.rpow_natCast,two_mul] using add_le_add herr hmain
  exact hsum.trans_eq (by dsimp [k]; rw [div_pow]; ring)

end Erdos571.FanSpider


/-! Sharp ordinary upper bounds for homogeneous fan powers. -/
namespace Erdos571.FanSpider
set_option maxHeartbeats 2000000
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeBase (p q M K : ℕ) : ℝ :=
  2*4^(p+2*p*q+1)*(M*(p+p*q+1)*copyLoad (heavyThreshold p q M K) p q M:ℕ)

noncomputable def degreeCoefficient (p q M K : ℕ) : ℝ :=
  (degreeBase p q M K)^(((p+2*p*q+1:ℕ):ℝ)⁻¹)

lemma degreeCoefficient_nonneg (p q M K : ℕ) : 0≤degreeCoefficient p q M K := by
  unfold degreeCoefficient degreeBase
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (p q M K : ℕ) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 0<d) (hdlarge : 4*(p+2*p*q+3:ℕ)≤d)
    (herr : countError p q M K (Q*d)≤(d/4)^(p+2*p*q+1)/2) (hK : 1≤K)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) :
    d≤degreeCoefficient p q M K*(U.card:ℝ)^(((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) := by
  classical
  have hn : (0:ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0≤Q*d := by positivity
  let F := TreeCopiesIn.copies (template p q) G U
  have hl : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤F.card := by
    have hh := TreeCopiesIn.lower (template p q) (isTree p q) G U (d := d) (by
      simp only [card_vertex p q,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat]
      push_cast at hdlarge
      linarith)
      (fun v hv => (hdeg v hv).1)
    simpa only [card_vertex p q,Nat.add_sub_cancel] using hh
  have hd1 : 1≤d := (show (1:ℝ)≤4*(p+2*p*q+3:ℕ) by norm_cast; omega).trans hdlarge
  have hD1 : 1≤Q*d := by nlinarith
  have ht : 1≤heavyThreshold p q M K := by
    have hpos : 0<heavyThreshold p q M K := by
      dsimp [heavyThreshold,AnchoredArms.heavyThreshold,AnchoredArms.vertexCount]
      positivity
    omega
  have hu := all_count G U (heavyThreshold p q M K) p q M ht hp hq hM hf hD1
    (fun v hv => (hdeg v hv).2) F (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have hbad := badPairs_sum_bound G g hg U p q M K hK hf hD (fun v hv => (hdeg v hv).2)
  have hb := mul_le_mul_of_nonneg_right hbad (show 0≤(((p+2*p*q+2:ℕ):ℝ))^3*(Q*d)^(p+2*p*q-1) by positivity)
  let C : ℝ := (M*(p+p*q+1)*copyLoad (heavyThreshold p q M K) p q M:ℕ)
  have hc : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤C*(U.card:ℝ)^(p*q+1)+U.card*countError p q M K (Q*d) := by
    dsimp [C,countError]
    nlinarith
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤2*C*(U.card:ℝ)^(p*q+1) := by linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0≤(4:ℝ)^(p+2*p*q+1) by positivity)
  have heq : (U.card:ℝ)*(d/4)^(p+2*p*q+1)*4^(p+2*p*q+1)=U.card*d^(p+2*p*q+1) := by
    rw [div_pow]; field_simp
  rw [heq,pow_succ (U.card:ℝ) (p*q)] at hm'
  have hpower : d^(p+2*p*q+1)≤degreeBase p q M K*(U.card:ℝ)^(p*q) := by
    apply (mul_le_mul_iff_left₀ hn).mp
    dsimp [degreeBase]
    dsimp [C] at hm'
    nlinarith
  exact LongSpider.degree_of_power (p+2*p*q+1) (p*q) (by omega) hn.le hd.le (by unfold degreeBase; positivity) hpower

/-- The almost-regular estimate for a properly colored host. -/
theorem exists_regular_bound (p q M : ℕ) (hp : 1≤p) (hq : 1≤q) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀{u v}, G.Adj u v → g u≠g v) → (graph p q M).Free G → ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) := by
  obtain ⟨K,hK,L,hLs,herr⟩ := exists_error_threshold p q M hp hM Q hQ
  let B := degreeCoefficient p q M K
  have hB : 0 ≤ B := degreeCoefficient_nonneg p q M K
  have hL : 0≤L := le_trans (by positivity) hLs
  refine ⟨Q*(L+B),by have hL : 0≤L := le_trans (by positivity) hLs; positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^(((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) := Real.one_le_rpow hn1 (by positivity)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^(((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) := by
    by_cases hdl : d ≤ L
    · have hL : 0≤L := le_trans (by positivity) hLs
      nlinarith
    · have hl := large_degree_bound G U hU p q M K hp hq hM hf g hg hQ hd
        (hLs.trans (le_of_not_ge hdl)) (herr d (le_of_not_ge hdl)) hK hdeg
      have hnn : 0 ≤ (U.card:ℝ)^(((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) := by positivity
      change d ≤ B*_ at hl
      have hL : 0≤L := le_trans (by positivity) hLs
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^(((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ))) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp ordinary upper bound for each fixed spider power. -/
theorem edge_bound (p q M : ℕ) (hp : 1≤p) (hq : 1≤q) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph p q M) (1+((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) D := by
  let γ : ℝ := ((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)
  have hγ : 0 < γ := by
    have hs0 : (0:ℝ)<(p*q:ℕ) := by exact_mod_cast Nat.mul_pos (by omega : 0<p) (by omega : 0<q)
    dsimp [γ]
    positivity
  have hγ1 : γ ≤ 1 := by
    dsimp [γ]
    apply (div_le_one (by positivity)).mpr
    exact_mod_cast (show p*q ≤ p+2*p*q+1 by nlinarith)
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+γ)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left,Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound p q M hp hq hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph p q M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+γ) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.FanSpider


/-! Exact two-level fan exponents, and their paired cones. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (p q : ℕ) :
    1+((p*q:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)=2-((p+p*q+1:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ) := by
  have hden : ((p+2*p*q+1:ℕ):ℝ)≠0 := by positivity
  push_cast
  field_simp
  <;> ring

theorem layered_supported (p q : ℕ) (hp : 2≤p) (hq : 1≤q) :
    Supported (LayeredTrees.template [p,q]) (2-((p+p*q+1:ℕ):ℝ)/((p+2*p*q+1:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound p q M (by omega) hq (by omega)
  rw [exponent_eq] at hbound
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  apply hbound.estimate G
  intro h
  exact hf ((powerIso p q M).symm.isContained.trans h)

theorem certificate (p q : ℕ) (hp : 2≤p) (hq : 1≤q) : Certificate (p+p*q+1) (p+2*p*q+1) :=
  ⟨LayeredTrees.Interior [p,q],Option (LayeredTrees.Leaves [p,q]),
    inferInstance,inferInstance,inferInstance,inferInstance,
    LayeredTrees.template [p,q],LayeredTrees.fullColor [p,q],LayeredTrees.fullColor_proper [p,q],
    (LayeredTrees.isTree [p,q]).isConnected,LayeredTrees.no_isolated [p,q],
    by simpa only [(counts p q).1,(counts p q).2] using LayeredTrees.balance [p,q] (valid p q hp hq),
    layered_supported p q hp hq⟩

theorem iterated_certificate (p q t : ℕ) (hp : 2≤p) (hq : 1≤q) :
    Certificate (p+p*q+1) (p+2*p*q+1+t*(p+p*q+1)) := by
  induction t with
  | zero => simpa using certificate p q hp hq
  | succ t ih =>
    have h := ih.cone (by omega) (by simp only [Nat.mul_assoc]; omega)
    have he : p+2*p*q+1+(t+1)*(p+p*q+1)=p+2*p*q+1+t*(p+p*q+1)+(p+p*q+1) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

theorem exact_family (p q t : ℕ) (hp : 2≤p) (hq : 1≤q) :
    ∃N : ℕ, ∃G : SimpleGraph (Fin N), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(p+p*q+1:ℚ)/(p+2*p*q+1+t*(p+p*q+1):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate p q t hp hq).realizes (by omega) (by simp only [Nat.mul_assoc]; omega)
  push_cast at h ⊢
  exact h

theorem exponent_thirty_one_twenty_seconds :
    ∃N : ℕ, ∃G : SimpleGraph (Fin N), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((31/22:ℚ):ℝ)) := by
  have h := exact_family 3 3 0 (by omega) (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.FanSpider

/-! A quadratic packing bound that does not require uniform vertex loads. -/
namespace Erdos571.PackingEnergy
open Finset SimpleGraph

variable {I : Type*} [DecidableEq I]

/-- Ordered intersecting pairs, including the diagonal when the relation is reflexive. -/
def pairs (F : Finset I) (R : I → I → Prop) [DecidableRel R] : Finset (I × I) :=
  (F ×ˢ F).filter (fun p => R p.1 p.2)

/-- Turán's theorem applied to the graph of nonconflicting pairs.
Unlike a maximum-load packing bound, this remains useful when a few fibers
have very large loads. -/
theorem bound (F : Finset I) (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀ i ∈ F, R i i) (hsymm : ∀ i ∈ F, ∀ j ∈ F, R i j → R j i)
    (p : ℕ) (hp : 2 ≤ p)
    (hno : ¬∃ S ⊆ F, S.card = p ∧
      ∀ i ∈ S, ∀ j ∈ S, i ≠ j → ¬R i j) :
    F.card ^ 2 ≤ (p-1) * (pairs F R).card := by
  classical
  let K : SimpleGraph F :=
    { Adj := fun i j => ¬R i.val j.val
      symm := by
        intro i j hij hji
        exact hij (hsymm j.val j.property i.val i.property hji)
      loopless := by
        intro i hii
        exact hii (hrefl i.val i.property) }
  have hfree : K.CliqueFree p := by
    intro S hS
    apply hno
    refine ⟨S.image Subtype.val, ?_, ?_, ?_⟩
    · intro i hi
      obtain ⟨j,hj,rfl⟩ := mem_image.mp hi
      exact j.property
    · rw [card_image_of_injective _ Subtype.val_injective]
      exact hS.card_eq
    · intro i hi j hj hij
      obtain ⟨u,hu,rfl⟩ := mem_image.mp hi
      obtain ⟨v,hv,rfl⟩ := mem_image.mp hj
      exact hS.isClique hu hv (fun he => hij (congrArg Subtype.val he))
  have hfree' : K.CliqueFree ((p-1)+1) := by simpa [Nat.sub_add_cancel (by omega : 1 ≤ p)] using hfree
  have ht : 2*(p-1)*K.edgeFinset.card ≤ (p-2)*F.card^2 := by
    have h₁ := hfree'.card_edgeFinset_le
    dsimp only at h₁
    rw [← card_edgeFinset_turanGraph] at h₁
    have h₂ := mul_card_edgeFinset_turanGraph_le (n:=Fintype.card F) (r:=p-1)
    have h₃ := Nat.mul_le_mul_left (2*(p-1)) h₁
    simpa only [Fintype.card_coe,show p-1-1=p-2 by omega] using h₃.trans h₂
  have hdegree (i : F) : K.degree i = (F.filter (fun j => ¬R i.val j)).card := by
    rw [← K.card_neighborFinset_eq_degree i]
    apply card_bij (fun j _ => j.val)
    · intro j hj
      exact mem_filter.mpr ⟨j.property, (K.mem_neighborFinset _ _).mp hj⟩
    · intro j hj k hk he
      exact Subtype.ext he
    · intro j hj
      refine ⟨⟨j,(mem_filter.mp hj).1⟩, ?_, rfl⟩
      exact (K.mem_neighborFinset _ _).mpr (mem_filter.mp hj).2
  have he : (pairs F (fun i j => ¬R i j)).card = 2*K.edgeFinset.card := by
    have hsum := K.sum_degrees_eq_twice_card_edges
    simp_rw [hdegree] at hsum
    have he : (univ : Finset F)=F.attach := rfl
    rw [he] at hsum
    rw [sum_attach F (fun i : I => (F.filter (fun j => ¬R i j)).card)] at hsum
    simpa only [pairs,card_filter,sum_product] using hsum
  have hsplit : (pairs F R).card + (pairs F (fun i j => ¬R i j)).card = F.card^2 := by
    simpa only [pairs,card_product,pow_two] using
      (card_filter_add_card_filter_not (s:=F×ˢF) (fun x : I×I => R x.1 x.2))
  rw [he] at hsplit
  have hp' : p-1=(p-2)+1 := by omega
  nlinarith


/-- Conflicting ordered pairs that have the same fiber label. -/
def fiberPairs {J : Type*} [DecidableEq J] (F : Finset I) (label : I → J)
    (R : I → I → Prop) [DecidableRel R] : Finset (I × I) :=
  (F ×ˢ F).filter (fun p => label p.1=label p.2 ∧ R p.1 p.2)

lemma pairs_fiber {J : Type*} [DecidableEq J] (F : Finset I) (label : I → J)
    (R : I → I → Prop) [DecidableRel R] (r : J) :
    pairs (F.filter (fun i => label i=r)) R =
      (fiberPairs F label R).filter (fun p => label p.1=r) := by
  ext p
  simp only [pairs,fiberPairs,mem_filter,mem_product]
  constructor
  · rintro ⟨⟨⟨h₁,e₁⟩,h₂,e₂⟩,hR⟩
    exact ⟨⟨⟨h₁,h₂⟩,e₁.trans e₂.symm,hR⟩,e₁⟩
  · rintro ⟨⟨⟨h₁,h₂⟩,e,hR⟩,e₁⟩
    exact ⟨⟨⟨h₁,e₁⟩,h₂,e.symm.trans e₁⟩,hR⟩

lemma sum_fiber_pairs {J : Type*} [DecidableEq J] (F : Finset I) (label : I → J)
    (R : I → I → Prop) [DecidableRel R] :
    (∑r∈F.image label, (pairs (F.filter (fun i => label i=r)) R).card) =
      (fiberPairs F label R).card := by
  simp_rw [pairs_fiber]
  rw [sum_card_fiberwise_eq_card_filter]
  congr 1
  apply filter_true_of_mem
  intro p hp
  exact mem_image.mpr ⟨p.1,(mem_product.mp (mem_filter.mp hp).1).1,rfl⟩

/-- A global quadratic bound using only within-fiber nonpacking.
It does not assume a uniform bound for any individual fiber or vertex. -/
theorem fiber_bound {J : Type*} [DecidableEq J] (F : Finset I) (label : I → J)
    (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀ i ∈ F, R i i) (hsymm : ∀ i ∈ F, ∀ j ∈ F, R i j → R j i)
    (p : ℕ) (hp : 2 ≤ p)
    (hno : ∀r : J, ¬∃ S ⊆ F.filter (fun i => label i=r), S.card=p ∧
      ∀ i ∈ S, ∀ j ∈ S, i ≠ j → ¬R i j) :
    F.card^2 ≤ (p-1)*(F.image label).card*(fiberPairs F label R).card := by
  have hsum : (∑r∈F.image label, (F.filter (fun i => label i=r)).card)=F.card := by
    rw [sum_card_fiberwise_eq_card_filter]
    congr 1
    exact filter_true_of_mem (fun i hi => mem_image.mpr ⟨i,hi,rfl⟩)
  have hsq := sq_sum_le_card_mul_sum_sq (s:=F.image label)
    (f:=fun r => (F.filter (fun i => label i=r)).card)
  rw [hsum] at hsq
  have hb : (∑r∈F.image label, (F.filter (fun i => label i=r)).card^2) ≤
      (p-1)*(fiberPairs F label R).card := by
    rw [← sum_fiber_pairs, mul_sum]
    apply sum_le_sum
    intro r hr
    exact bound _ R (fun i hi => hrefl i (mem_filter.mp hi).1)
      (fun i hi j hj => hsymm i (mem_filter.mp hi).1 j (mem_filter.mp hj).1) p hp (hno r)
  calc
    _ ≤ (F.image label).card * ∑r∈F.image label, (F.filter (fun i => label i=r)).card^2 := hsq
    _ ≤ (F.image label).card * ((p-1)*(fiberPairs F label R).card) := Nat.mul_le_mul_left _ hb
    _ = _ := by ring

end Erdos571.PackingEnergy

/-! Packing rooted copies while retaining edges between the roots. -/
namespace Erdos571.FullRootedPacking
open Finset SimpleGraph

/-- The usual disjoint-petal embedding, with root-root edges restored from
any one of the original copies. -/
def powerCopy {A R W : Type*} [Fintype A]
    {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}
    (p : ℕ) (hp : 0<p) (r : R ↪ W) (f : Fin p → H.Copy G)
    (hroot : ∀i x, f i (.inr x)=r x)
    (hdis : ∀i j, i≠j → Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j))) :
    (FullRootedPower.graph H p).Copy G := by
  let e := RootedPacking.powerCopy p r f hroot hdis
  refine { toHom := { toFun := e, map_rel' := ?_ }, injective' := e.injective }
  intro u v h
  cases u with
  | inl u => cases v with
    | inl v => exact e.toHom.map_adj h
    | inr v => exact e.toHom.map_adj h
  | inr u => cases v with
    | inl v => exact e.toHom.map_adj h
    | inr v =>
      change G.Adj (r u) (r v)
      rw [← hroot ⟨0,hp⟩ u,← hroot ⟨0,hp⟩ v]
      exact (f ⟨0,hp⟩).toHom.map_adj h

theorem contained_of_packing {I A R W : Type*} [Fintype A]
    {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}
    (S : Finset I) (f : I → H.Copy G) (r : R ↪ W) (p : ℕ) (hp : 0<p)
    (hroot : ∀i∈S, ∀x, f i (.inr x)=r x) (hSc : S.card=p)
    (hdis : ∀i∈S, ∀j∈S, i≠j → Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j))) :
    FullRootedPower.graph H p ⊑ G := by
  classical
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by simpa only [Fintype.card_fin,Fintype.card_coe] using hSc.symm)
  refine ⟨powerCopy p hp r (fun i => f (e i)) (fun i x => hroot (e i) (e i).property x) ?_⟩
  intro i j hij
  apply hdis (e i) (e i).property (e j) (e j).property
  intro he
  exact hij (e.injective (Subtype.ext he))

end Erdos571.FullRootedPacking

/-! Global collision criteria for rooted powers, without uniform pinned-fiber bounds. -/
namespace Erdos571.RootedCollisionEnergy
open Finset SimpleGraph RootedPacking

variable {I A R W : Type*} [DecidableEq I] [DecidableEq W]
variable [Fintype A] [Fintype R]
variable {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}

/-- The original roots of an indexed copy. -/
def labels (f : I → H.Copy G) (i : I) : R → W := fun r => f i (.inr r)

/-- Ordered pairs agreeing on every root and sharing at least one interior vertex. -/
noncomputable def collisions (F : Finset I) (f : I → H.Copy G) : Finset (I × I) := by
  classical
  exact PackingEnergy.fiberPairs F (labels f)
    (fun i j => ¬Disjoint (interior (f i)) (interior (f j)))

lemma mem_collisions (F : Finset I) (f : I → H.Copy G) (i j : I) :
    (i,j)∈collisions F f ↔ i∈F ∧ j∈F ∧ labels f i=labels f j ∧
      ¬Disjoint (interior (f i)) (interior (f j)) := by
  classical
  simp only [collisions,PackingEnergy.fiberPairs,mem_filter,mem_product]
  tauto

lemma labels_card (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) :
    (F.image (labels f)).card ≤ U.card^Fintype.card R := by
  classical
  let val : (F.image (labels f)) → (R → U) := fun r a => ⟨r.val a,by
    obtain ⟨i,hi,he⟩ := mem_image.mp r.property
    rw [← he]
    exact hroot i hi a⟩
  have hinj : Function.Injective val := by
    intro r s he
    apply Subtype.ext
    funext a
    exact congrArg Subtype.val (congrFun he a)
  simpa only [Fintype.card_coe,Fintype.card_fun] using Fintype.card_le_of_injective val hinj

/-- A power-free host forces many collisions globally, even when no individual
rooted or pinned fiber has a constant bound. -/
theorem bound [Nonempty A] (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G) :
    F.card^2 ≤ (p-1)*U.card^Fintype.card R*(collisions F f).card := by
  classical
  have hn (i : I) : (interior (f i)).Nonempty := by
    rw [← card_pos,interior_card]
    exact Fintype.card_pos
  have h := PackingEnergy.fiber_bound F (labels f)
    (fun i j => ¬Disjoint (interior (f i)) (interior (f j)))
    (fun i hi h => (hn i).ne_empty (disjoint_self.mp h))
    (fun i hi j hj h hd => h hd.symm) p hp (by
      intro r hr
      obtain ⟨S,hSF,hS,hdis⟩ := hr
      have hSn : S.Nonempty := card_pos.mp (by omega)
      obtain ⟨i₀,hi₀⟩ := hSn
      have he : labels f i₀=r := (mem_filter.mp (hSF hi₀)).2
      have hrinj : Function.Injective r := by
        rw [← he]
        exact (f i₀).injective.comp Sum.inr_injective
      apply hfree
      exact FullRootedPacking.contained_of_packing S f ⟨r,hrinj⟩ p (by omega)
        (fun i hi a => congrFun (mem_filter.mp (hSF hi)).2 a) hS
        (fun i hi j hj hij => not_not.mp (hdis i hi j hj hij)))
  change F.card^2 ≤ (p-1)*(F.image (labels f)).card*(collisions F f).card at h
  exact h.trans (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (labels_card F f U hroot)))

/-- A linear *total* collision estimate suffices. No uniform load assumption
on a vertex, root tuple, or copy is used. -/
theorem bound_of_linear_collisions [Nonempty A]
    (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G) {B : ℝ} (hB : 0≤B)
    (hcol : ((collisions F f).card:ℝ) ≤ B*F.card) :
    (F.card:ℝ) ≤ (p-1:ℕ)*B*(U.card:ℝ)^Fintype.card R := by
  have he : (F.card:ℝ)^2 ≤ (p-1:ℕ)*(U.card:ℝ)^Fintype.card R*(collisions F f).card := by
    exact_mod_cast bound F f U hroot p hp hfree
  have hmul := mul_le_mul_of_nonneg_left hcol
    (show (0:ℝ)≤(p-1:ℕ)*(U.card:ℝ)^Fintype.card R by positivity)
  by_cases hn : F.card=0
  · simp only [hn,Nat.cast_zero]; positivity
  have hn : (0:ℝ)<F.card := by exact_mod_cast (Nat.pos_of_ne_zero hn)
  nlinarith

/-- The collision estimate may also contain an absorbable quadratic error. -/
theorem bound_of_collision_estimate [Nonempty A]
    (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G) {B ε : ℝ} (hB : 0≤B) (hε : ε<1)
    (hcol : (p-1:ℕ)*(U.card:ℝ)^Fintype.card R*(collisions F f).card ≤
      B*(U.card:ℝ)^Fintype.card R*F.card + ε*(F.card:ℝ)^2) :
    (F.card:ℝ) ≤ (B/(1-ε))*(U.card:ℝ)^Fintype.card R := by
  have he : (F.card:ℝ)^2 ≤ (p-1:ℕ)*(U.card:ℝ)^Fintype.card R*(collisions F f).card := by
    exact_mod_cast bound F f U hroot p hp hfree
  by_cases hn : F.card=0
  · simp only [hn,Nat.cast_zero]
    exact mul_nonneg (div_nonneg hB (by linarith)) (by positivity)
  have hn : (0:ℝ)<F.card := by exact_mod_cast (Nat.pos_of_ne_zero hn)
  have hlin : (1-ε)*(F.card:ℝ) ≤ B*(U.card:ℝ)^Fintype.card R := by
    nlinarith
  rw [div_mul_eq_mul_div]
  exact (le_div_iff₀ (by linarith : 0<1-ε)).mpr (by nlinarith)



/-- The contribution from equality at two specified interior positions. -/
noncomputable def pinPairs (F : Finset I) (f : I → H.Copy G) (a b : A) : Finset (I × I) := by
  classical
  exact (F×ˢF).filter (fun p => labels f p.1=labels f p.2 ∧ f p.1 (.inl a)=f p.2 (.inl b))

lemma collisions_eq_biUnion (F : Finset I) (f : I → H.Copy G) :
    collisions F f = univ.biUnion (fun a : A => univ.biUnion (fun b : A => pinPairs F f a b)) := by
  classical
  ext p
  constructor
  · intro hp
    obtain ⟨hi,hj,hr,hd⟩ := (mem_collisions F f p.1 p.2).mp hp
    rw [Finset.disjoint_left] at hd
    push_neg at hd
    obtain ⟨w,hwi,hwj⟩ := hd
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hwi hwj
    obtain ⟨a,hea⟩ := hwi
    obtain ⟨b,heb⟩ := hwj
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_biUnion.mpr ⟨b,mem_univ _,
      mem_filter.mpr ⟨mem_product.mpr ⟨hi,hj⟩,hr,hea.trans heb.symm⟩⟩⟩
  · intro hp
    obtain ⟨a,ha,hp⟩ := mem_biUnion.mp hp
    obtain ⟨b,hb,hp⟩ := mem_biUnion.mp hp
    obtain ⟨hp,hr,he⟩ := mem_filter.mp hp
    refine (mem_collisions F f p.1 p.2).mpr ⟨(mem_product.mp hp).1,(mem_product.mp hp).2,hr,?_⟩
    intro hd
    exact Finset.disjoint_left.mp hd (mem_interior (f p.1) a) (he ▸ mem_interior (f p.2) b)

lemma collisions_card_le (F : Finset I) (f : I → H.Copy G) :
    (collisions F f).card ≤ ∑a : A, ∑b : A, (pinPairs F f a b).card := by
  classical
  rw [collisions_eq_biUnion]
  exact card_biUnion_le.trans (sum_le_sum (fun a ha => card_biUnion_le))

/-- A position-by-position global counting criterion. These are counts of
pairs of copies, not maximum loads of individual rooted fibers. -/
theorem bound_of_pin_pairs [Nonempty A] (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G) :
    F.card^2 ≤ (p-1)*U.card^Fintype.card R * (∑a : A, ∑b : A, (pinPairs F f a b).card) :=
  (bound F f U hroot p hp hfree).trans (Nat.mul_le_mul_left _ (collisions_card_le F f))

/-- If host vertices have fixed template roles, an intersection can only be
at the same interior position in the two copies. -/
lemma collisions_eq_diagonal_biUnion (F : Finset I) (f : I → H.Copy G)
    (role : W → A⊕R) (hrole : ∀i∈F, ∀v, role (f i v)=v) :
    collisions F f = univ.biUnion (fun a : A => pinPairs F f a a) := by
  classical
  rw [collisions_eq_biUnion]
  ext p
  constructor
  · intro hp
    obtain ⟨a,ha,hp⟩ := mem_biUnion.mp hp
    obtain ⟨b,hb,hp⟩ := mem_biUnion.mp hp
    have hh := mem_filter.mp hp
    have hi := (mem_product.mp hh.1).1
    have hj := (mem_product.mp hh.1).2
    have he := congrArg role hh.2.2
    rw [hrole p.1 hi,hrole p.2 hj] at he
    have hab : a=b := Sum.inl.inj he
    subst b
    exact mem_biUnion.mpr ⟨a,ha,hp⟩
  · intro hp
    obtain ⟨a,ha,hp⟩ := mem_biUnion.mp hp
    exact mem_biUnion.mpr ⟨a,ha,mem_biUnion.mpr ⟨a,ha,hp⟩⟩

lemma collisions_card_le_diagonal (F : Finset I) (f : I → H.Copy G)
    (role : W → A⊕R) (hrole : ∀i∈F, ∀v, role (f i v)=v) :
    (collisions F f).card ≤ ∑a : A, (pinPairs F f a a).card := by
  classical
  rw [collisions_eq_diagonal_biUnion F f role hrole]
  exact card_biUnion_le

end Erdos571.RootedCollisionEnergy


/- ## WeightedPackingEnergy -/
/- Nonnegative weighted versions of the finite packing energy bound. -/
namespace Erdos571.PackingEnergy
open Finset SimpleGraph Filter

variable {I : Type*} [DecidableEq I]

/-- Give an index a natural multiplicity and apply the packing inequality to its clones. -/
theorem weighted_nat_bound (F : Finset I) (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀i∈F, R i i) (hsymm : ∀i∈F, ∀j∈F, R i j → R j i)
    (p : ℕ) (hp : 2≤p)
    (hno : ¬∃S⊆F, S.card=p ∧ ∀i∈S, ∀j∈S, i≠j → ¬R i j)
    (w : I → ℕ) :
    (∑i∈F, w i)^2 ≤ (p-1)*(∑i∈F, ∑j∈F, if R i j then w i*w j else 0) := by
  classical
  let C := (i : F) × Fin (w i)
  let rel : C → C → Prop := fun i j => R i.1.val j.1.val
  have h := bound (univ : Finset C) rel
    (fun i _ => hrefl i.1.val i.1.property)
    (fun i _ j _ => hsymm i.1.val i.1.property j.1.val j.1.property) p hp (by
      rintro ⟨S,hS,hSc,hind⟩
      apply hno
      let pr : C → I := fun i => i.1.val
      have hinj : Set.InjOn pr S := by
        intro i hi j hj he
        by_contra hn
        exact hind i hi j hj hn (by
          change R (pr i) (pr j)
          rw [←he]
          exact hrefl i.1.val i.1.property)
      refine ⟨S.image pr, ?_, (card_image_of_injOn hinj).trans hSc, ?_⟩
      · intro i hi
        obtain ⟨j,hj,rfl⟩ := mem_image.mp hi
        exact j.1.property
      · intro i hi j hj hij
        obtain ⟨x,hx,rfl⟩ := mem_image.mp hi
        obtain ⟨y,hy,rfl⟩ := mem_image.mp hj
        exact hind x hx y hy (fun he => hij (congrArg pr he)))
  have hcard : (univ : Finset C).card=∑i∈F, w i := by
    simp only [C,card_univ,Fintype.card_sigma,Fintype.card_fin]
    exact sum_attach F w
  have hpairs : (pairs (univ : Finset C) rel).card=
      ∑i∈F, ∑j∈F, if R i j then w i*w j else 0 := by
    simp only [pairs,card_filter,sum_product,rel,C,Fintype.sum_sigma]
    simp_rw [sum_comm (s := (univ : Finset (Fin _))) (t := (univ : Finset F))]
    dsimp only
    simp only [sum_const,nsmul_eq_mul,card_univ,Fintype.card_fin]
    simp only [mul_ite,mul_one,mul_zero,Nat.cast_id]
    trans ∑i∈F, ∑j : F, if R i j then w i*w j else 0
    · exact sum_attach F (fun i : I => ∑j : F, if R i j then w i*w j else 0)
    apply sum_congr rfl
    intro i hi
    exact sum_attach F (fun j => if R i j then w i*w j else 0)
  rwa [hcard,hpairs] at h

/-- The same natural-weight bound, expressed as a sum over conflicting pairs. -/
lemma weighted_nat_bound_pairs (F : Finset I) (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀i∈F, R i i) (hsymm : ∀i∈F, ∀j∈F, R i j → R j i)
    (p : ℕ) (hp : 2≤p)
    (hno : ¬∃S⊆F, S.card=p ∧ ∀i∈S, ∀j∈S, i≠j → ¬R i j)
    (w : I → ℕ) :
    (∑i∈F, w i)^2 ≤ (p-1)*(∑e∈pairs F R, w e.1*w e.2) := by
  simpa only [pairs,sum_filter,sum_product] using weighted_nat_bound F R hrefl hsymm p hp hno w

/-- Arbitrary nonnegative real weights satisfy the exact packing energy bound.
The proof approximates the weights by natural multiplicities, without a
maximum-weight or maximum-load assumption. -/
theorem weighted_bound (F : Finset I) (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀i∈F, R i i) (hsymm : ∀i∈F, ∀j∈F, R i j → R j i)
    (p : ℕ) (hp : 2≤p)
    (hno : ¬∃S⊆F, S.card=p ∧ ∀i∈S, ∀j∈S, i≠j → ¬R i j)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑i∈F, w i)^2 ≤ (p-1:ℕ)*(∑e∈pairs F R, w e.1*w e.2) := by
  let app : I → ℝ → ℝ := fun i x => (⌊w i*x⌋₊:ℝ)/x
  have ht (i : I) (hi : i∈F) : Tendsto (app i) atTop (nhds (w i)) :=
    tendsto_nat_floor_mul_div_atTop (hw i hi)
  have hleft : Tendsto (fun x : ℝ => (∑i∈F, app i x)^2) atTop (nhds ((∑i∈F, w i)^2)) :=
    (tendsto_finset_sum F ht).pow 2
  have hright : Tendsto (fun x : ℝ => (p-1:ℕ)*∑e∈pairs F R, app e.1 x*app e.2 x)
      atTop (nhds ((p-1:ℕ)*∑e∈pairs F R, w e.1*w e.2)) := by
    apply Filter.Tendsto.const_mul
    apply tendsto_finset_sum
    intro e he
    have hh := mem_product.mp (mem_filter.mp he).1
    exact (ht e.1 hh.1).mul (ht e.2 hh.2)
  apply le_of_tendsto_of_tendsto hleft hright
  apply Filter.Eventually.of_forall
  intro x
  have hn : (∑i∈F, (⌊w i*x⌋₊:ℝ))^2 ≤
      (p-1:ℕ)*∑e∈pairs F R, (⌊w e.1*x⌋₊:ℝ)*(⌊w e.2*x⌋₊:ℝ) := by
    exact_mod_cast weighted_nat_bound_pairs F R hrefl hsymm p hp hno (fun i => ⌊w i*x⌋₊)
  calc
    _ = (∑i∈F, (⌊w i*x⌋₊:ℝ))^2/x^2 := by simp only [app,←sum_div,div_pow]
    _ ≤ ((p-1:ℕ)*∑e∈pairs F R, (⌊w e.1*x⌋₊:ℝ)*(⌊w e.2*x⌋₊:ℝ))/x^2 :=
      div_le_div_of_nonneg_right hn (sq_nonneg x)
    _ = _ := by
      rw [mul_div_assoc,sum_div]
      congr 1
      apply sum_congr rfl
      intro e he
      dsimp only [app]
      rw [div_mul_div_comm,pow_two]

/-- Weighted collision sums split exactly across the labels. -/
lemma sum_weighted_fiber_pairs {J : Type*} [DecidableEq J]
    (F : Finset I) (label : I → J) (R : I → I → Prop) [DecidableRel R] (w : I → ℝ) :
    (∑r∈F.image label, ∑e∈pairs (F.filter (fun i => label i=r)) R, w e.1*w e.2)=
      ∑e∈fiberPairs F label R, w e.1*w e.2 := by
  simp_rw [pairs_fiber]
  exact sum_fiberwise_of_maps_to (fun e he =>
    mem_image.mpr ⟨e.1,(mem_product.mp (mem_filter.mp he).1).1,rfl⟩) _

/-- The weighted global inequality, assuming nonpacking only within each label. -/
theorem weighted_fiber_bound {J : Type*} [DecidableEq J]
    (F : Finset I) (label : I → J) (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀i∈F, R i i) (hsymm : ∀i∈F, ∀j∈F, R i j → R j i)
    (p : ℕ) (hp : 2≤p)
    (hno : ∀r : J, ¬∃S⊆F.filter (fun i => label i=r), S.card=p ∧
      ∀i∈S, ∀j∈S, i≠j → ¬R i j)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑i∈F, w i)^2 ≤ (p-1:ℕ)*(F.image label).card*
      (∑e∈fiberPairs F label R, w e.1*w e.2) := by
  have hsum : (∑r∈F.image label, ∑i∈F.filter (fun i => label i=r), w i)=∑i∈F, w i :=
    sum_fiberwise_of_maps_to (fun i hi => mem_image.mpr ⟨i,hi,rfl⟩) w
  have hsq := sq_sum_le_card_mul_sum_sq (s := F.image label)
    (f := fun r => ∑i∈F.filter (fun i => label i=r), w i)
  rw [hsum] at hsq
  have hb : (∑r∈F.image label, (∑i∈F.filter (fun i => label i=r), w i)^2) ≤
      (p-1:ℕ)*(∑e∈fiberPairs F label R, w e.1*w e.2) := by
    rw [←sum_weighted_fiber_pairs,mul_sum]
    apply sum_le_sum
    intro r hr
    exact weighted_bound _ R (fun i hi => hrefl i (mem_filter.mp hi).1)
      (fun i hi j hj => hsymm i (mem_filter.mp hi).1 j (mem_filter.mp hj).1)
      p hp (hno r) w (fun i hi => hw i (mem_filter.mp hi).1)
  exact hsq.trans ((mul_le_mul_of_nonneg_left hb (Nat.cast_nonneg _)).trans_eq (by ring))

/-- Fiber energy with an arbitrary positive normalization for each label. -/
lemma sum_normalized_fiber_pairs {J : Type*} [DecidableEq J]
    (F : Finset I) (label : I → J) (R : I → I → Prop) [DecidableRel R]
    (w : I → ℝ) (μ : J → ℝ) :
    (∑r∈F.image label, (∑e∈pairs (F.filter (fun i => label i=r)) R, w e.1*w e.2)/μ r)=
      ∑e∈fiberPairs F label R, w e.1*w e.2/μ (label e.1) := by
  simp_rw [sum_div,pairs_fiber]
  trans ∑r∈F.image label,
    ∑e∈(fiberPairs F label R).filter (fun e => label e.1=r), w e.1*w e.2/μ (label e.1)
  · apply sum_congr rfl
    intro r hr
    apply sum_congr rfl
    intro e he
    rw [(mem_filter.mp he).2]
  · exact sum_fiberwise_of_maps_to (fun e he =>
      mem_image.mpr ⟨e.1,(mem_product.mp (mem_filter.mp he).1).1,rfl⟩) _

/-- An arbitrary label measure can replace the crude number-of-labels factor.
This allows copy weights and root-label weights to be chosen separately. -/
theorem normalized_weighted_fiber_bound {J : Type*} [DecidableEq J]
    (F : Finset I) (label : I → J) (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀i∈F, R i i) (hsymm : ∀i∈F, ∀j∈F, R i j → R j i)
    (p : ℕ) (hp : 2≤p)
    (hno : ∀r : J, ¬∃S⊆F.filter (fun i => label i=r), S.card=p ∧
      ∀i∈S, ∀j∈S, i≠j → ¬R i j)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) (μ : J → ℝ)
    (hμ : ∀r∈F.image label, 0<μ r) :
    (∑i∈F, w i)^2/(∑r∈F.image label, μ r) ≤
      (p-1:ℕ)*(∑e∈fiberPairs F label R, w e.1*w e.2/μ (label e.1)) := by
  have hsum : (∑r∈F.image label, ∑i∈F.filter (fun i => label i=r), w i)=∑i∈F, w i :=
    sum_fiberwise_of_maps_to (fun i hi => mem_image.mpr ⟨i,hi,rfl⟩) w
  have hsq := sq_sum_div_le_sum_sq_div (F.image label)
    (fun r => ∑i∈F.filter (fun i => label i=r), w i) hμ
  rw [hsum] at hsq
  apply hsq.trans
  rw [←sum_normalized_fiber_pairs,mul_sum]
  apply sum_le_sum
  intro r hr
  rw [←mul_div_assoc]
  apply div_le_div_of_nonneg_right _ (hμ r hr).le
  exact weighted_bound _ R (fun i hi => hrefl i (mem_filter.mp hi).1)
    (fun i hi j hj => hsymm i (mem_filter.mp hi).1 j (mem_filter.mp hj).1)
    p hp (hno r) w (fun i hi => hw i (mem_filter.mp hi).1)

end Erdos571.PackingEnergy


/- ## WeightedRootedCollision -/
/- Weighted global collision bounds for full rooted powers. -/
namespace Erdos571.RootedCollisionEnergy
open Finset SimpleGraph RootedPacking

variable {I A R W : Type*} [DecidableEq I] [DecidableEq W]
variable [Fintype A] [Fintype R]
variable {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}

/-- Full-power freeness rules out disjoint-petal packings in every root fiber. -/
lemma no_fiber_packing (F : Finset I) (f : I → H.Copy G)
    (p : ℕ) (hp : 0<p) (hfree : (FullRootedPower.graph H p).Free G) (r : R → W) :
    ¬∃S⊆F.filter (fun i => labels f i=r), S.card=p ∧
      ∀i∈S, ∀j∈S, i≠j → ¬¬Disjoint (interior (f i)) (interior (f j)) := by
  classical
  rintro ⟨S,hSF,hS,hdis⟩
  obtain ⟨i₀,hi₀⟩ := card_pos.mp (by omega : 0<S.card)
  have he : labels f i₀=r := (mem_filter.mp (hSF hi₀)).2
  have hrinj : Function.Injective r := by
    rw [←he]
    exact (f i₀).injective.comp Sum.inr_injective
  apply hfree
  exact FullRootedPacking.contained_of_packing S f ⟨r,hrinj⟩ p hp
    (fun i hi a => congrFun (mem_filter.mp (hSF hi)).2 a) hS
    (fun i hi j hj hij => not_not.mp (hdis i hi j hj hij))

/-- The collision inequality with nonnegative copy weights. -/
theorem weighted_bound [Nonempty A] (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑i∈F, w i)^2 ≤ (p-1:ℕ)*(U.card:ℝ)^Fintype.card R*
      (∑e∈collisions F f, w e.1*w e.2) := by
  classical
  have hn (i : I) : (interior (f i)).Nonempty := by
    rw [←card_pos,interior_card]
    exact Fintype.card_pos
  have he := PackingEnergy.weighted_fiber_bound F (labels f)
    (fun i j => ¬Disjoint (interior (f i)) (interior (f j)))
    (fun i hi h => (hn i).ne_empty (disjoint_self.mp h))
    (fun i hi j hj h hd => h hd.symm) p hp
    (no_fiber_packing F f p (by omega) hfree) w hw
  change (∑i∈F, w i)^2 ≤ (p-1:ℕ)*(F.image (labels f)).card*
    (∑e∈collisions F f, w e.1*w e.2) at he
  have hc : ((F.image (labels f)).card:ℝ)≤(U.card:ℝ)^Fintype.card R := by
    exact_mod_cast labels_card F f U hroot
  have hs : 0≤∑e∈collisions F f, w e.1*w e.2 := by
    apply sum_nonneg
    intro e he
    have hh := (mem_collisions F f e.1 e.2).mp he
    exact mul_nonneg (hw e.1 hh.1) (hw e.2 hh.2.1)
  exact he.trans (mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg _)) hs)

/-- A root-label measure can be used instead of the number of available root tuples. -/
theorem normalized_weighted_bound [Nonempty A] (F : Finset I) (f : I → H.Copy G)
    (p : ℕ) (hp : 2≤p) (hfree : (FullRootedPower.graph H p).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) (μ : (R → W) → ℝ)
    (hμ : ∀r∈F.image (labels f), 0<μ r) :
    (∑i∈F, w i)^2/(∑r∈F.image (labels f), μ r) ≤
      (p-1:ℕ)*(∑e∈collisions F f, w e.1*w e.2/μ (labels f e.1)) := by
  classical
  have hn (i : I) : (interior (f i)).Nonempty := by
    rw [←card_pos,interior_card]
    exact Fintype.card_pos
  exact PackingEnergy.normalized_weighted_fiber_bound F (labels f)
    (fun i j => ¬Disjoint (interior (f i)) (interior (f j)))
    (fun i hi h => (hn i).ne_empty (disjoint_self.mp h))
    (fun i hi j hj h hd => h hd.symm) p hp
    (no_fiber_packing F f p (by omega) hfree) w hw μ hμ

end Erdos571.RootedCollisionEnergy


/- ## RootedPairOverlap -/
/- Collision pairs as copies of two-petal powers with a nonempty extra core. -/
set_option maxHeartbeats 2000000
namespace Erdos571.RootedPairOverlap
open Finset SimpleGraph RootedSunflower RootedPacking

variable {A R W : Type*} [Fintype A] [DecidableEq A]
variable {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}

/-- Two distinct canonically overlapping copies give a proper-core two-petal
power, with both original copies recoverable as its distinguished slices. -/
theorem pair_core (f g : H.Copy G) (hfg : f≠g)
    (hroot : ∀r, f (.inr r)=g (.inr r))
    (hcross : ∀a b, f (.inl a)=g (.inl b) → a=b)
    (hinter : ¬Disjoint (interior f) (interior g)) :
    ∃C : Finset A, C.Nonempty ∧ C≠univ ∧ ∃k : (corePower H C 2).Copy G,
      (∀v, k (slice C 0 v)=f v) ∧ (∀v, k (slice C 1 v)=g v) := by
  classical
  let c : Fin 2 → H.Copy G := ![f,g]
  have hc : Function.Injective c := by
    intro i j he
    fin_cases i <;> fin_cases j
    · rfl
    · exact (hfg he).elim
    · exact (hfg he.symm).elim
    · rfl
  let r : R ↪ W := (Function.Embedding.inr : R ↪ A⊕R).trans f.toEmbedding
  have hr (i : Fin 2) (a : R) : c i (.inr a)=r a := by
    fin_cases i
    · rfl
    · exact (hroot a).symm
  have hcan : Canonical
      (fun i => (Function.Embedding.inl : A ↪ A⊕R).trans (c i).toEmbedding) univ := by
    intro i hi j hj hij a b he
    have hab : a=b := by
      fin_cases i <;> fin_cases j
      · exact (hij rfl).elim
      · exact hcross a b he
      · exact (hcross b a he.symm).symm
      · exact (hij rfl).elim
    subst b
    refine ⟨rfl,?_⟩
    intro k hk
    fin_cases i <;> fin_cases j <;> fin_cases k
    all_goals first | rfl | exact he | exact he.symm | exact (hij rfl).elim
  obtain ⟨C,hC,k,hk⟩ := GenericRooted.corePower_contained_with_slices
    (by norm_num : 2≤(2:ℕ)) r c hc hr hcan
  have h₀ (v : A⊕R) : k (slice C 0 v)=f v := by
    convert hk 0 v using 1 <;> congr 2 <;> exact Subsingleton.elim _ _
  have h₁ (v : A⊕R) : k (slice C 1 v)=g v := by
    convert hk 1 v using 1 <;> congr 2 <;> exact Subsingleton.elim _ _
  have hCn : C.Nonempty := by
    rw [Finset.disjoint_left] at hinter
    push_neg at hinter
    obtain ⟨w,hwf,hwg⟩ := hinter
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hwf hwg
    obtain ⟨a,ha⟩ := hwf
    obtain ⟨b,hb⟩ := hwg
    have he : f (.inl a)=g (.inl b) := ha.trans hb.symm
    have hab := hcross a b he
    subst b
    refine ⟨a,?_⟩
    by_contra haC
    have hs := k.injective ((h₀ (.inl a)).trans (he.trans (h₁ (.inl a)).symm))
    simp only [RootedSunflower.slice,dif_neg haC,Sum.inl.injEq,Prod.mk.injEq] at hs
    exact (by decide : (0:Fin 2)≠1) hs.1
  exact ⟨C,hCn,hC,k,h₀,h₁⟩

/-- A nonempty, proper set of extra shared interior positions. -/
abbrev ProperCore (A : Type*) [Fintype A] :=
  {C : Finset A // C.Nonempty ∧ C≠univ}

/-- Recover the two distinguished slices of a core-power copy. -/
def decode (k : (C : ProperCore A) × (corePower H C.val 2).Copy G) : H.Copy G×H.Copy G :=
  (k.2.comp (sliceCopy H k.1.val 0), k.2.comp (sliceCopy H k.1.val 1))

lemma pair_core_decode (f g : H.Copy G) (hfg : f≠g)
    (hroot : ∀r, f (.inr r)=g (.inr r))
    (hcross : ∀a b, f (.inl a)=g (.inl b) → a=b)
    (hinter : ¬Disjoint (interior f) (interior g)) :
    ∃k : (C : ProperCore A) × (corePower H C.val 2).Copy G, decode k=(f,g) := by
  obtain ⟨C,hCn,hCp,k,h₀,h₁⟩ := pair_core f g hfg hroot hcross hinter
  refine ⟨⟨⟨C,hCn,hCp⟩,k⟩,Prod.ext ?_ ?_⟩
  · apply Copy.ext
    exact h₀
  · apply Copy.ext
    exact h₁

/-- In a role-colored copy family, every off-diagonal collision is encoded
injectively by an ordinary copy of a two-petal proper-core power. -/
theorem off_diagonal_bound [Fintype R] [Fintype W] [DecidableEq W]
    (F : Finset (H.Copy G)) (role : W → A⊕R)
    (hrole : ∀f∈F, ∀v, role (f v)=v) :
    ((RootedCollisionEnergy.collisions F id).filter (fun e => e.1≠e.2)).card ≤
      ∑C : ProperCore A, Nat.card ((corePower H C.val 2).Copy G) := by
  classical
  let B := (RootedCollisionEnergy.collisions F id).filter (fun e => e.1≠e.2)
  let K := (C : ProperCore A) × (corePower H C.val 2).Copy G
  have hex (e : B) : ∃k : K, decode k=e.val := by
    have hh := mem_filter.mp e.property
    have hc := (RootedCollisionEnergy.mem_collisions F id e.val.1 e.val.2).mp hh.1
    exact pair_core_decode e.val.1 e.val.2 hh.2
      (fun r => congrFun hc.2.2.1 r)
      (fun a b he => Sum.inl.inj (by
        have h := congrArg role he
        rw [hrole e.val.1 hc.1,hrole e.val.2 hc.2.1] at h
        exact h)) hc.2.2.2
  let enc : B → K := fun e => (hex e).choose
  have hdec (e : B) : decode (enc e)=e.val := (hex e).choose_spec
  have hi : Function.Injective enc := by
    intro e f he
    apply Subtype.ext
    exact (hdec e).symm.trans ((congrArg decode he).trans (hdec f))
  have hc := Fintype.card_le_of_injective enc hi
  rw [Fintype.card_coe] at hc
  have hK : Fintype.card K=∑C : ProperCore A, Nat.card ((corePower H C.val 2).Copy G) := by
    rw [Fintype.card_sigma]
    simp only [Nat.card_eq_fintype_card]
  exact hc.trans_eq hK

/-- A concrete overlap expansion for collision energy. The diagonal contributes
at most one per copy; all remaining terms are ordinary proper-core copy counts. -/
theorem collisions_card_le_core_copies [Fintype R] [Fintype W] [DecidableEq W]
    (F : Finset (H.Copy G)) (role : W → A⊕R)
    (hrole : ∀f∈F, ∀v, role (f v)=v) :
    (RootedCollisionEnergy.collisions F id).card ≤ F.card+
      ∑C : ProperCore A, Nat.card ((corePower H C.val 2).Copy G) := by
  classical
  have hd : ((RootedCollisionEnergy.collisions F id).filter (fun e => e.1=e.2)).card ≤F.card := by
    apply card_le_card_of_injOn Prod.fst
    · intro e he
      exact ((RootedCollisionEnergy.mem_collisions F id e.1 e.2).mp (mem_filter.mp he).1).1
    · intro e he f hf hef
      exact Prod.ext hef ((mem_filter.mp he).2.symm.trans (hef.trans (mem_filter.mp hf).2))
  have ho := off_diagonal_bound F role hrole
  have hu : ((RootedCollisionEnergy.collisions F id).filter (fun e => e.1=e.2)) ∪
      ((RootedCollisionEnergy.collisions F id).filter (fun e => e.1≠e.2)) =
      RootedCollisionEnergy.collisions F id := by
    ext e
    simp only [mem_union,mem_filter]
    tauto
  have he := card_union_le
    ((RootedCollisionEnergy.collisions F id).filter (fun e => e.1=e.2))
    ((RootedCollisionEnergy.collisions F id).filter (fun e => e.1≠e.2))
  rw [hu] at he
  omega

end Erdos571.RootedPairOverlap


/- ## RoleColoring -/
/- Retaining a constant fraction of an indexed copy family with fixed vertex roles. -/
namespace Erdos571.RoleColoring
open Finset SimpleGraph

variable {V W C : Type*} [Fintype V] [Fintype W] [Fintype C] [DecidableEq W]

/-- The number of assignments extending prescribed values on an embedded vertex set. -/
lemma assignment_count (e : V ↪ W) (r : V → C) :
    letI : DecidablePred (fun c : W → C => ∀v, c (e v)=r v) := Classical.decPred _
    ((univ : Finset (W → C)).filter (fun c : W → C => ∀v, c (e v)=r v)).card=
      Fintype.card C^(Fintype.card W-Fintype.card V) := by
  classical
  let S := {w : W // w∉Set.range e}
  let es : V⊕S ≃ W := (Equiv.sumCongr (Equiv.ofInjective e e.injective) (Equiv.refl S)).trans
    (Equiv.sumCompl (fun w => w∈Set.range e))
  have hl (v : V) : es (.inl v)=e v := rfl
  have hr (w : S) : es (.inr w)=w.val := rfl
  let ext (s : S → C) : W → C := fun w => Sum.elim r s (es.symm w)
  have hext (s : S → C) (v : V) : ext s (e v)=r v := by
    rw [←hl]
    simp only [ext,Equiv.symm_apply_apply,Sum.elim_inl]
  let E : {c : W → C // ∀v, c (e v)=r v} ≃ (S → C) :=
    { toFun := fun c w => c.val w
      invFun := fun s => ⟨ext s,hext s⟩
      left_inv := by
        intro c
        apply Subtype.ext
        funext w
        obtain ⟨w,rfl⟩ := es.surjective w
        cases w with
        | inl v =>
          change ext (fun w : S => c.val w) (es (.inl v))=c.val (es (.inl v))
          rw [hl,hext,c.property]
        | inr w =>
          change Sum.elim r (fun w : S => c.val w) (es.symm (es (.inr w)))=c.val (es (.inr w))
          rw [Equiv.symm_apply_apply]
          rfl
      right_inv := by
        intro s
        funext w
        change ext s w.val=s w
        rw [←hr]
        simp only [ext,Equiv.symm_apply_apply,Sum.elim_inr] }
  have hS : Fintype.card S=Fintype.card W-Fintype.card V := by
    have he := Fintype.card_congr es
    simp only [Fintype.card_sum] at he
    omega
  have hc := Fintype.card_congr E
  rw [Fintype.card_fun,hS] at hc
  apply Eq.trans _ hc
  rw [Fintype.card_subtype]
  congr 1
  ext c
  simp only [mem_filter,mem_univ,true_and]

variable {I : Type*} [DecidableEq I]

/-- Members of an indexed embedding family respecting a prescribed role map. -/
noncomputable def colored (F : Finset I) (f : I → V ↪ W) (role : W → V) : Finset I := by
  classical
  exact F.filter (fun i => ∀v, role (f i v)=v)

/-- Independent uniform vertex roles retain at least a `k^(-k)` fraction of
any finite family of embeddings of a nonempty `k`-vertex template. -/
theorem exists_coloring [Nonempty V] (F : Finset I) (f : I → V ↪ W) :
    ∃role : W → V, F.card≤Fintype.card V^Fintype.card V*(colored F f role).card := by
  classical
  by_cases hF : F.Nonempty
  swap
  · refine ⟨fun _ => Classical.choice ‹Nonempty V›,?_⟩
    rw [not_nonempty_iff_eq_empty.mp hF,card_empty]
    exact Nat.zero_le _
  obtain ⟨i₀,hi₀⟩ := hF
  have hn : Fintype.card V≤Fintype.card W := Fintype.card_le_of_injective (f i₀) (f i₀).injective
  have hassign (i : I) :
      (∑role : W → V, if (∀v, role (f i v)=v) then 1 else 0)=
        Fintype.card V^(Fintype.card W-Fintype.card V) := by
    have h := assignment_count (f i) id
    simp only [card_filter,id_eq] at h
    convert h using 1
    apply sum_congr rfl
    intro role hrole
    split_ifs <;> rfl
  have hsum : (∑role : W → V, (colored F f role).card)=
      F.card*Fintype.card V^(Fintype.card W-Fintype.card V) := by
    simp only [colored,card_filter]
    rw [sum_comm]
    simp only [hassign,sum_const,smul_eq_mul]
  obtain ⟨role,hrole,hmax⟩ := exists_max_image (univ : Finset (W → V))
    (fun role => (colored F f role).card) univ_nonempty
  refine ⟨role,?_⟩
  have hmul : F.card*Fintype.card V^(Fintype.card W-Fintype.card V)≤
      (Fintype.card V^Fintype.card V*(colored F f role).card)*
        Fintype.card V^(Fintype.card W-Fintype.card V) := by
    calc
      _ = ∑role : W → V, (colored F f role).card := hsum.symm
      _ ≤ ∑_ : W → V, (colored F f role).card := sum_le_sum hmax
      _ = _ := by
        simp only [sum_const,card_univ,Fintype.card_fun,smul_eq_mul]
        conv_lhs => rw [show Fintype.card W=Fintype.card V+(Fintype.card W-Fintype.card V) by omega,pow_add]
        ring
  exact Nat.le_of_mul_le_mul_right hmul (pow_pos Fintype.card_pos _)

/-- A role-colored subfamily with the same constant-factor guarantee. -/
theorem exists_colored_subfamily [Nonempty V] (F : Finset I) (f : I → V ↪ W) :
    ∃role : W → V, ∃B⊆F, (∀i∈B, ∀v, role (f i v)=v) ∧
      F.card≤Fintype.card V^Fintype.card V*B.card := by
  classical
  obtain ⟨role,hrole⟩ := exists_coloring F f
  exact ⟨role,colored F f role,filter_subset _ _,
    fun i hi => (mem_filter.mp hi).2,hrole⟩

end Erdos571.RoleColoring


/- ## UncoloredRootedEnergy -/
/- A collision expansion without a pre-existing role coloring of the host. -/
namespace Erdos571.RootedPairOverlap
open Finset SimpleGraph RootedSunflower

variable {A R W : Type*} [Fintype A] [Fintype R] [Fintype W]
variable [DecidableEq A] [DecidableEq W] [Nonempty A]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

/-- A power-free host forces either a bounded ordinary copy count or many
copies of some proper-core overlap graph. No uniform pinned-fiber estimate
and no hypothesis on the host's role coloring are required. -/
theorem uncolored_bound (F : Finset (H.Copy G)) (U : Finset W)
    (hroot : ∀f∈F, ∀r, f (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G) :
    F.card^2 ≤ (Fintype.card (A⊕R)^Fintype.card (A⊕R))^2*(p-1)*
      U.card^Fintype.card R*
        (F.card+∑C : ProperCore A, Nat.card ((corePower H C.val 2).Copy G)) := by
  classical
  obtain ⟨role,B,hBF,hrole,hB⟩ := RoleColoring.exists_colored_subfamily F
    (fun f : H.Copy G => f.toEmbedding)
  have he := RootedCollisionEnergy.bound B id U
    (fun f hf r => hroot f (hBF hf) r) p hp hfree
  have ho := collisions_card_le_core_copies B role hrole
  have hBFc := card_le_card hBF
  have hE : (RootedCollisionEnergy.collisions B id).card ≤
      F.card+∑C : ProperCore A, Nat.card ((corePower H C.val 2).Copy G) := by
    omega
  calc
    _ ≤ (Fintype.card (A⊕R)^Fintype.card (A⊕R)*B.card)^2 := Nat.pow_le_pow_left hB 2
    _ = (Fintype.card (A⊕R)^Fintype.card (A⊕R))^2*B.card^2 := mul_pow _ _ _
    _ ≤ (Fintype.card (A⊕R)^Fintype.card (A⊕R))^2*
        ((p-1)*U.card^Fintype.card R*(RootedCollisionEnergy.collisions B id).card) :=
      Nat.mul_le_mul_left _ he
    _ ≤ (Fintype.card (A⊕R)^Fintype.card (A⊕R))^2*
        ((p-1)*U.card^Fintype.card R*
          (F.card+∑C : ProperCore A, Nat.card ((corePower H C.val 2).Copy G))) :=
      Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hE)
    _ = _ := by ring

end Erdos571.RootedPairOverlap

/-! Retaining the actual root-fiber second moment in the collision inequality. -/
namespace Erdos571.PackingEnergy
open Finset SimpleGraph
variable {I J : Type*} [DecidableEq I] [DecidableEq J]

/-- Before applying Cauchy-Schwarz across labels, packing controls the actual
second moment of the fiber masses. -/
theorem weighted_fiber_second_moment (F : Finset I) (label : I → J)
    (R : I → I → Prop) [DecidableRel R]
    (hrefl : ∀i∈F, R i i) (hsymm : ∀i∈F, ∀j∈F, R i j → R j i)
    (p : ℕ) (hp : 2≤p)
    (hno : ∀r : J, ¬∃S⊆F.filter (fun i => label i=r), S.card=p ∧
      ∀i∈S, ∀j∈S, i≠j → ¬R i j)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑r∈F.image label, (∑i∈F.filter (fun i => label i=r), w i)^2) ≤
      (p-1:ℕ)*(∑e∈fiberPairs F label R, w e.1*w e.2) := by
  rw [←sum_weighted_fiber_pairs,mul_sum]
  apply sum_le_sum
  intro r hr
  exact weighted_bound _ R (fun i hi => hrefl i (mem_filter.mp hi).1)
    (fun i hi j hj => hsymm i (mem_filter.mp hi).1 j (mem_filter.mp hj).1)
    p hp (hno r) w (fun i hi => hw i (mem_filter.mp hi).1)

/-- A second-moment identity with no conflict condition. -/
lemma sum_fiber_mass_sq (F : Finset I) (label : I → J) (w : I → ℝ) :
    (∑r∈F.image label, (∑i∈F.filter (fun i => label i=r), w i)^2)=
      ∑e∈fiberPairs F label (fun _ _ => True), w e.1*w e.2 := by
  rw [←sum_weighted_fiber_pairs]
  apply sum_congr rfl
  intro r hr
  simp only [pairs,filter_true,sum_product,pow_two,sum_mul_sum]

lemma mass_sq_le_fiber_second_moment (F : Finset I) (label : I → J) (w : I → ℝ) :
    (∑i∈F, w i)^2 ≤ (F.image label).card*
      (∑e∈fiberPairs F label (fun _ _ => True), w e.1*w e.2) := by
  have hs : (∑r∈F.image label, ∑i∈F.filter (fun i => label i=r), w i)=∑i∈F, w i :=
    sum_fiberwise_of_maps_to (fun i hi => mem_image.mpr ⟨i,hi,rfl⟩) w
  have h := sq_sum_le_card_mul_sum_sq (s := F.image label)
    (f := fun r => ∑i∈F.filter (fun i => label i=r), w i)
  rwa [hs,sum_fiber_mass_sq] at h

end Erdos571.PackingEnergy

namespace Erdos571.RootedCollisionEnergy
open Finset SimpleGraph RootedPacking
variable {I A R W : Type*} [DecidableEq I] [DecidableEq W]
variable [Fintype A] [Fintype R]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

/-- All ordered pairs agreeing on the original roots, including disjoint pairs. -/
noncomputable def agreements (F : Finset I) (f : I → H.Copy G) : Finset (I×I) := by
  classical
  exact PackingEnergy.fiberPairs F (labels f) (fun _ _ => True)

lemma mem_agreements (F : Finset I) (f : I → H.Copy G) (i j : I) :
    (i,j)∈agreements F f ↔ i∈F ∧ j∈F ∧ labels f i=labels f j := by
  classical
  simp only [agreements,PackingEnergy.fiberPairs,mem_filter,mem_product,and_true]
  tauto

lemma agreements_nonneg (F : Finset I) (f : I → H.Copy G) (w : I → ℝ)
    (hw : ∀i∈F, 0≤w i) : 0≤∑e∈agreements F f, w e.1*w e.2 := by
  apply sum_nonneg
  intro e he
  have h := (mem_agreements F f e.1 e.2).mp he
  exact mul_nonneg (hw _ h.1) (hw _ h.2.1)

/-- Rooted-power freeness bounds the full second moment, not merely the
Cauchy-Schwarz lower bound involving the number of available root tuples. -/
theorem weighted_second_moment_bound [Nonempty A]
    (F : Finset I) (f : I → H.Copy G) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑e∈agreements F f, w e.1*w e.2) ≤
      (p-1:ℕ)*(∑e∈collisions F f, w e.1*w e.2) := by
  classical
  have hn (i : I) : (interior (f i)).Nonempty := by
    rw [←card_pos,interior_card]
    exact Fintype.card_pos
  rw [agreements,←PackingEnergy.sum_fiber_mass_sq]
  exact PackingEnergy.weighted_fiber_second_moment F (labels f)
    (fun i j => ¬Disjoint (interior (f i)) (interior (f j)))
    (fun i hi h => (hn i).ne_empty (disjoint_self.mp h))
    (fun i hi j hj h hd => h hd.symm) p hp
    (no_fiber_packing F f p (by omega) hfree) w hw

lemma weighted_mass_sq_le_agreements (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑i∈F, w i)^2 ≤ (U.card:ℝ)^Fintype.card R*
      (∑e∈agreements F f, w e.1*w e.2) := by
  classical
  have h := PackingEnergy.mass_sq_le_fiber_second_moment F (labels f) w
  change (∑i∈F, w i)^2 ≤ (F.image (labels f)).card*
    (∑e∈agreements F f, w e.1*w e.2) at h
  have hc : ((F.image (labels f)).card:ℝ)≤(U.card:ℝ)^Fintype.card R := by
    exact_mod_cast labels_card F f U hroot
  exact h.trans (mul_le_mul_of_nonneg_right hc (agreements_nonneg F f w hw))

/-- Absorb an error proportional to the actual second moment. This is weaker
than requiring an error proportional to mass squared divided by root count. -/
theorem bound_of_relative_second_moment [Nonempty A]
    (F : Finset I) (f : I → H.Copy G) (U : Finset W)
    (hroot : ∀i∈F, ∀r, f i (.inr r)∈U) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) {B ε : ℝ} (hB : 0≤B)
    (hε : (p-1:ℕ)*ε<1)
    (hcol : (∑e∈collisions F f, w e.1*w e.2) ≤ B*(∑i∈F, w i)+
      ε*(∑e∈agreements F f, w e.1*w e.2)) :
    (∑i∈F, w i) ≤ ((p-1:ℕ)*B/(1-(p-1:ℕ)*ε))*(U.card:ℝ)^Fintype.card R := by
  have hm := weighted_second_moment_bound F f p hp hfree w hw
  have hs := weighted_mass_sq_le_agreements F f U hroot w hw
  have hpn : (0:ℝ)≤(p-1:ℕ) := Nat.cast_nonneg _
  have hcol' := mul_le_mul_of_nonneg_left hcol hpn
  have hden : 0<1-(p-1:ℕ)*ε := by linarith
  have he : (∑e∈agreements F f, w e.1*w e.2) ≤
      ((p-1:ℕ)*B/(1-(p-1:ℕ)*ε))*(∑i∈F, w i) := by
    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ hden).mpr
    nlinarith
  have ht := mul_le_mul_of_nonneg_left he (show (0:ℝ)≤(U.card:ℝ)^Fintype.card R by positivity)
  have hmass : 0≤∑i∈F, w i := sum_nonneg hw
  by_cases hzero : (∑i∈F, w i)=0
  · rw [hzero]
    exact mul_nonneg (div_nonneg (mul_nonneg hpn hB) hden.le) (by positivity)
  have hpos : 0<∑i∈F, w i := lt_of_le_of_ne hmass (Ne.symm hzero)
  nlinarith

/-- The unweighted version retains the full root-fiber second moment. -/
theorem second_moment_bound [Nonempty A]
    (F : Finset I) (f : I → H.Copy G) (p : ℕ) (hp : 2≤p)
    (hfree : (FullRootedPower.graph H p).Free G) :
    (agreements F f).card≤(p-1)*(collisions F f).card := by
  have h := weighted_second_moment_bound F f p hp hfree (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

end Erdos571.RootedCollisionEnergy


/-! Elementary consequences of log-convexity for positive moment sequences. -/
namespace Erdos571.DiscreteMoments

variable {m : ℕ → ℝ}

lemma ratio_monotone (hpos : ∀n, 0 < m n)
    (hconv : ∀n, m (n+1)^2 ≤ m n*m (n+2)) :
    Monotone (fun n => m (n+1)/m n) := by
  apply monotone_nat_of_le_succ
  intro n
  apply (div_le_div_iff₀ (hpos n) (hpos (n+1))).mpr
  have h := hconv n
  simpa only [Nat.add_assoc,show (1:ℕ)+1=2 by rfl,pow_two,mul_comm] using h

/-- An upper bound on the last successive ratio bounds every earlier growth step. -/
theorem growth_bound (hpos : ∀n, 0 < m n)
    (hconv : ∀n, m (n+1)^2 ≤ m n*m (n+2))
    (n : ℕ) {C : ℝ} (hC : 0 ≤ C) (hstep : m (n+1) ≤ C*m n) :
    ∀i ≤ n+1, m i ≤ m 0*C^i := by
  have hr := ratio_monotone hpos hconv
  have hlast : m (n+1)/m n ≤ C := (div_le_iff₀ (hpos n)).mpr hstep
  have hs (i : ℕ) (hi : i ≤ n) : m (i+1) ≤ C*m i :=
    (div_le_iff₀ (hpos i)).mp ((hr hi).trans hlast)
  intro i hi
  induction i with
  | zero => simp only [pow_zero,mul_one,le_refl]
  | succ i ih =>
    have hip : i ≤ n := by omega
    have h := mul_le_mul_of_nonneg_left (ih (by omega)) hC
    calc
      m (i+1)  ≤  C*m i := hs i hip
      _  ≤  C*(m 0*C^i) := h
      _ = m 0*C^(i+1) := by rw [pow_succ]; ring

lemma pinch_ordered (hpos : ∀n, 0 < m n)
    (hconv : ∀n, m (n+1)^2 ≤ m n*m (n+2)) (i j : ℕ) (hij : i ≤ j) :
    m (i+1)*m (j+1) ≤ m 1*m (i+j+1) := by
  induction i generalizing j with
  | zero => simp only [Nat.zero_add,le_refl]
  | succ i ih =>
    have hr := ratio_monotone hpos hconv (show i+1 ≤ j+1 by omega)
    have hc := (div_le_div_iff₀ (hpos (i+1)) (hpos (j+1))).mp hr
    have hh := ih (j+1) (by omega)
    calc
      m (i+1+1)*m (j+1)  ≤  m (i+1)*m (j+1+1) := by nlinarith
      _  ≤  m 1*m (i+(j+1)+1) := hh
      _ = m 1*m ((i+1)+j+1) := by congr 2; omega

/-- Two positive-length closed pieces are bounded by the shortest piece times
the complementary long piece. -/
theorem pinch (hpos : ∀n, 0 < m n)
    (hconv : ∀n, m (n+1)^2 ≤ m n*m (n+2)) (i j : ℕ) :
    m (i+1)*m (j+1) ≤ m 1*m (i+j+1) := by
  rcases le_total i j with hij|hji
  · exact pinch_ordered hpos hconv i j hij
  · simpa only [mul_comm,Nat.add_comm] using pinch_ordered hpos hconv j i hji

end Erdos571.DiscreteMoments


/-! Even-walk moments using Cauchy-Schwarz, without spectral axioms. -/
namespace Erdos571.EvenWalkMoments
open Finset Matrix
variable {W : Type*} [Fintype W] [DecidableEq W]

noncomputable def point (A : Matrix W W ℝ) (k : ℕ) (x : W) : ℝ := (A^(2*k)) x x
noncomputable def total (A : Matrix W W ℝ) (k : ℕ) : ℝ := ∑x, point A k x

lemma row_dot {A : Matrix W W ℝ} (hs : A.IsSymm) (i j : ℕ) (x : W) :
    (∑y, (A^i) x y*(A^j) x y)=(A^(i+j)) x x := by
  rw [pow_add,Matrix.mul_apply]
  apply sum_congr rfl
  intro y hy
  rw [(hs.pow j).apply x y]

lemma row_sq {A : Matrix W W ℝ} (hs : A.IsSymm) (i : ℕ) (x : W) :
    (∑y, ((A^i) x y)^2)=point A i x := by
  simpa only [pow_two,point,two_mul] using row_dot hs i i x

lemma point_logconvex {A : Matrix W W ℝ} (hs : A.IsSymm) (x : W) (k : ℕ) :
    point A (k+1) x^2 ≤ point A k x*point A (k+2) x := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset W)
    (fun y => (A^k) x y) (fun y => (A^(k+2)) x y)
  rw [row_dot hs,row_sq hs,row_sq hs] at h
  simpa only [point,show k+(k+2)=2*(k+1) by omega] using h

lemma total_logconvex {A : Matrix W W ℝ} (hs : A.IsSymm) (k : ℕ) :
    total A (k+1)^2 ≤ total A k*total A (k+2) := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (W×W))
    (fun e => (A^k) e.1 e.2) (fun e => (A^(k+2)) e.1 e.2)
  simp only [Fintype.sum_prod_type] at h
  simp_rw [row_dot hs,row_sq hs] at h
  simpa only [total,point,show k+(k+2)=2*(k+1) by omega] using h

@[simp] lemma point_zero (A : Matrix W W ℝ) (x : W) : point A 0 x=1 := by
  simp only [point,mul_zero,pow_zero,Matrix.one_apply_eq]

@[simp] lemma total_zero (A : Matrix W W ℝ) : total A 0=Fintype.card W := by
  simp only [total,point_zero,sum_const,card_univ,nsmul_eq_mul,mul_one]

lemma point_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y) (k : ℕ) (x : W) :
    0≤point A k x := Matrix.pow_apply_nonneg hA _ _ _

lemma total_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y) (k : ℕ) :
    0≤total A k := sum_nonneg (fun x hx => point_nonneg hA k x)

lemma point_step {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y) (k : ℕ) (x : W) :
    point A k x*point A 1 x≤point A (k+1) x := by
  simp only [point,show 2*(k+1)=2*k+2 by omega,show 2*(1:ℕ)=2 by omega,pow_add,Matrix.mul_apply]
  exact single_le_sum (fun y hy => mul_nonneg (Matrix.pow_apply_nonneg hA (2*k) x y)
    (Matrix.pow_apply_nonneg hA 2 y x)) (mem_univ x)

lemma point_pos {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y) (x : W)
    (hx : 0<point A 1 x) (k : ℕ) : 0<point A k x := by
  induction k with
  | zero => simp only [point_zero,zero_lt_one]
  | succ k ih => exact (mul_pos ih hx).trans_le (point_step hA k x)

lemma total_pos [Nonempty W] {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    (hx : ∀x, 0<point A 1 x) (k : ℕ) : 0<total A k := by
  exact sum_pos (fun x hx' => point_pos hA x (hx x) k) univ_nonempty

/-- The trace moment cannot have a small last growth ratio if its total mass
exceeds the corresponding geometric-growth bound. -/
theorem total_growth_bound [Nonempty W] {A : Matrix W W ℝ} (hs : A.IsSymm)
    (hA : ∀x y, 0≤A x y) (hx : ∀x, 0<point A 1 x) (k : ℕ)
    {C : ℝ} (hC : 0≤C) (hstep : total A (k+1)≤C*total A k) :
    total A (k+1)≤Fintype.card W*C^(k+1) := by
  have h := DiscreteMoments.growth_bound (total_pos hA hx) (total_logconvex hs) k hC hstep
    (k+1) le_rfl
  simpa only [total_zero] using h

/-- At a pinched vertex, the product of two shorter even closed-walk counts
is bounded by its degree times the complementary long moment. -/
theorem point_pinch {A : Matrix W W ℝ} (hs : A.IsSymm)
    (hA : ∀x y, 0≤A x y) (x : W) (hx : 0<point A 1 x) (i j : ℕ) :
    point A (i+1) x*point A (j+1) x≤point A 1 x*point A (i+j+1) x :=
  DiscreteMoments.pinch (point_pos hA x hx) (point_logconvex hs x) i j

lemma total_pinch {A : Matrix W W ℝ} (hs : A.IsSymm)
    (hA : ∀x y, 0≤A x y) (hx : ∀x, 0<point A 1 x)
    {D : ℝ} (hD : ∀x, point A 1 x≤D) (i j : ℕ) :
    (∑x, point A (i+1) x*point A (j+1) x)≤D*total A (i+j+1) := by
  rw [total,mul_sum]
  apply sum_le_sum
  intro x hx'
  exact (point_pinch hs hA x (hx x) i j).trans
    (mul_le_mul_of_nonneg_right (hD x) (point_nonneg hA _ x))

lemma row_sum_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {d : ℝ} (hd : 0≤d) (hrow : ∀x, d≤∑y, A x y) (k : ℕ) (x : W) :
    d^k≤∑y, (A^k) x y := by
  induction k generalizing x with
  | zero => simp [Matrix.one_apply]
  | succ k ih =>
    simp only [pow_succ',Matrix.mul_apply]
    rw [sum_comm]
    simp_rw [←mul_sum]
    calc
      d*d^k ≤ (∑y, A x y)*d^k := mul_le_mul_of_nonneg_right (hrow x) (pow_nonneg hd k)
      _ = ∑y, A x y*d^k := sum_mul _ _ _
      _ ≤ ∑y, A x y*(∑z, (A^k) y z) :=
        sum_le_sum (fun y hy => mul_le_mul_of_nonneg_left (ih y) (hA x y))

/-- A minimum row sum forces the usual lower bound on every even trace moment. -/
theorem total_lower [Nonempty W] {A : Matrix W W ℝ} (hs : A.IsSymm)
    (hA : ∀x y, 0≤A x y) {d : ℝ} (hd : 0≤d) (hrow : ∀x, d≤∑y, A x y) (k : ℕ) :
    d^(2*k)≤total A k := by
  have hl : (Fintype.card W:ℝ)*d^k≤∑x, ∑y, (A^k) x y := by
    calc
      _ = ∑_x : W, d^k := by simp only [sum_const,card_univ,nsmul_eq_mul]
      _ ≤ _ := sum_le_sum (fun x hx => row_sum_lower hA hd hrow k x)
  have hp : (0:ℝ)<Fintype.card W := Nat.cast_pos.mpr Fintype.card_pos
  have hl0 : 0≤(Fintype.card W:ℝ)*d^k := mul_nonneg hp.le (pow_nonneg hd k)
  have hl2 := pow_le_pow_left₀ hl0 hl 2
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (W×W)))
    (f := fun e => (A^k) e.1 e.2)
  simp only [card_univ,Fintype.card_prod,Nat.cast_mul,Fintype.sum_prod_type] at hc
  simp_rw [row_sq hs] at hc
  rw [←pow_two (Fintype.card W:ℝ)] at hc
  change (∑x, ∑y, (A^k) x y)^2 ≤ (Fintype.card W:ℝ)^2*total A k at hc
  have he : ((Fintype.card W:ℝ)*d^k)^2=(Fintype.card W:ℝ)^2*d^(2*k) := by
    rw [mul_pow,show 2*k=k*2 by omega,pow_mul]
  rw [he] at hl2
  exact le_of_mul_le_mul_left (hl2.trans hc) (sq_pos_of_pos hp)

end Erdos571.EvenWalkMoments


/-! Fixed-position rotation and pinching of closed walks. -/
namespace Erdos571.ClosedWalkRotation
open Finset SimpleGraph
variable {W : Type*} {G : SimpleGraph W}

abbrev Based (G : SimpleGraph W) (n : ℕ) (x : W) := {p : G.Walk x x // p.length=n}
abbrev Closed (G : SimpleGraph W) (n : ℕ) := (x : W) × Based G n x

def vertex {n : ℕ} (p : Closed G n) (i : ℕ) : W := p.2.val.getVert i

@[simp] lemma vertex_zero {n : ℕ} (p : Closed G n) : vertex p 0=p.1 := Walk.getVert_zero _
@[simp] lemma vertex_end {n : ℕ} (p : Closed G n) : vertex p n=p.1 := by
  exact Walk.getVert_of_length_le _ p.2.property.le

lemma ext_vertex {n : ℕ} (hn : 0<n) {p q : Closed G n}
    (h : ∀i<n, vertex p i=vertex q i) : p=q := by
  have he : p.1=q.1 := by simpa only [vertex_zero] using h 0 hn
  rcases p with ⟨x,p,hp⟩
  rcases q with ⟨y,q,hq⟩
  dsimp only at he
  subst y
  congr 1
  apply Subtype.ext
  apply Walk.ext_getVert_le_length (hp.trans hq.symm)
  intro i hi
  by_cases hin : i<n
  · exact h i hin
  · have he : i=n := by omega
    subst i
    simp only [←hp,Walk.getVert_length]
    rw [hp,←hq,Walk.getVert_length]

def rotate {n : ℕ} (i : ℕ) (p : Closed G n) : Closed G n :=
  ⟨vertex p i,⟨(p.2.val.drop i).append (p.2.val.take i),by
    simp only [Walk.length_append,Walk.drop_length,Walk.take_length,p.2.property]
    omega⟩⟩

lemma rotate_vertex {n : ℕ} (p : Closed G n) (i j : ℕ) :
    vertex (rotate i p) j=
      if j<n-i then vertex p (i+j) else vertex p (min i (j-(n-i))) := by
  simp only [vertex,rotate,Walk.getVert_append,Walk.drop_length,Walk.drop_getVert,
    Walk.take_getVert,p.2.property]

lemma recover_vertex {n : ℕ} (p : Closed G n) (i : ℕ) (hi : i≤n) (j : ℕ) (hj : j<n) :
    vertex p j=vertex (rotate i p) (if j < i then n-i+j else j-i) := by
  by_cases hji : j < i
  · rw [if_pos hji,rotate_vertex,if_neg (by omega : ¬n-i+j<n-i)]
    congr 1
    omega
  · rw [if_neg hji,rotate_vertex,if_pos (by omega : j-i<n-i)]
    congr 1
    omega

lemma rotate_injective {n : ℕ} (hn : 0<n) (i : ℕ) (hi : i≤n) :
    Function.Injective (rotate (G:=G) (n:=n) i) := by
  intro p q he
  apply ext_vertex hn
  intro j hj
  rw [recover_vertex p i hi j hj,recover_vertex q i hi j hj,he]

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

lemma closed_card (k : ℕ) : (Fintype.card (Closed G (2*k)):ℝ)=
    EvenWalkMoments.total (G.adjMatrix ℝ) k := by
  rw [Fintype.card_sigma,Nat.cast_sum]
  unfold EvenWalkMoments.total EvenWalkMoments.point
  apply sum_congr rfl
  intro x hx
  exact (G.adjMatrix_pow_apply_eq_card_walk (2*k) x x).symm

/-- Closed walks pinched at a fixed positive position. -/
abbrev Pinched (G : SimpleGraph W) (n d : ℕ) := {p : Closed G n // vertex p d=p.1}

/-- Splitting at a prescribed return to the starting vertex. -/
def split {n d : ℕ} (hd : d≤n) (p : Pinched G n d) :
    (x : W) × (Based G d x × Based G (n-d) x) :=
  ⟨p.val.1,
    ⟨⟨(p.val.2.val.take d).copy rfl p.property,by
      simp only [Walk.length_copy,Walk.take_length,p.val.2.property,min_eq_left hd]⟩,
     ⟨(p.val.2.val.drop d).copy p.property rfl,by
      simp only [Walk.length_copy,Walk.drop_length,p.val.2.property]⟩⟩⟩

def join {n d : ℕ} (hd : d≤n) (q : (x : W) × (Based G d x × Based G (n-d) x)) : Closed G n :=
  ⟨q.1,⟨q.2.1.val.append q.2.2.val,by
    rw [Walk.length_append,q.2.1.property,q.2.2.property]
    omega⟩⟩

lemma join_split {n d : ℕ} (hd : d≤n) (p : Pinched G n d) : join hd (split hd p)=p.val := by
  refine Sigma.ext (by rfl) ?_
  apply heq_of_eq
  apply Subtype.ext
  change ((p.val.2.val.take d).copy rfl p.property).append
    ((p.val.2.val.drop d).copy p.property rfl)=p.val.2.val
  rw [Walk.append_copy_copy,Walk.copy_rfl_rfl,Walk.append_take_drop_eq]

lemma split_injective {n d : ℕ} (hd : d≤n) : Function.Injective (split (G:=G) hd) := by
  intro p q he
  apply Subtype.ext
  exact (join_split hd p).symm.trans ((congrArg (join hd) he).trans (join_split hd q))

lemma pinched_card_bound {n d : ℕ} (hd : d≤n) :
    (Fintype.card (Pinched G n d):ℝ)≤
      ∑x, ((G.adjMatrix ℝ)^d) x x*((G.adjMatrix ℝ)^(n-d)) x x := by
  have h := Fintype.card_le_of_injective (split (G:=G) hd) (split_injective hd)
  have h' : (Fintype.card (Pinched G n d):ℝ)≤
      ∑x, (Fintype.card (Based G d x):ℝ)*Fintype.card (Based G (n-d) x) := by
    exact_mod_cast (by simpa only [Fintype.card_sigma,Fintype.card_prod] using h)
  simpa only [G.adjMatrix_pow_apply_eq_card_walk] using h'

end Erdos571.ClosedWalkRotation


/-! Pinched closed walks and uniform bounds on repeated-vertex contributions. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ClosedWalkRotation
open Finset SimpleGraph EvenWalkMoments
variable {W : Type*} {G : SimpleGraph W}
variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev Collision (G : SimpleGraph W) (n i j : ℕ) :=
  {p : Closed G n // vertex p i=vertex p j}

def toPinched {n i j : ℕ} (hij : i≤j) (hjn : j<n) (p : Collision G n i j) :
    Pinched G n (j-i) :=
  ⟨rotate i p.val,by
    rw [rotate_vertex,if_pos (by omega : j-i<n-i)]
    change vertex p.val (i+(j-i))=vertex p.val i
    rw [Nat.add_sub_of_le hij]
    exact p.property.symm⟩

lemma toPinched_injective {n i j : ℕ} (hij : i≤j) (hjn : j<n) :
    Function.Injective (toPinched (G:=G) hij hjn) := by
  intro p q he
  apply Subtype.ext
  exact rotate_injective (by omega) i (by omega) (congrArg Subtype.val he)

lemma collision_card_bound {n i j : ℕ} (hij : i≤j) (hjn : j<n) :
    (Fintype.card (Collision G n i j):ℝ)≤
      ∑x, ((G.adjMatrix ℝ)^(j-i)) x x*((G.adjMatrix ℝ)^(n-(j-i))) x x := by
  have h : (Fintype.card (Collision G n i j):ℝ)≤Fintype.card (Pinched G n (j-i)) := by
    exact_mod_cast Fintype.card_le_of_injective (toPinched (G:=G) hij hjn)
      (toPinched_injective hij hjn)
  exact h.trans (pinched_card_bound (by omega))

lemma pinched_even (c : G.Coloring Bool) {n d : ℕ} (hd : d≤n) (p : Pinched G n d) :
    Even d ∧ Even (n-d) := by
  let q := split hd p
  constructor
  · have h := (c.even_length_iff_congr q.2.1.val).mpr Iff.rfl
    rwa [q.2.1.property] at h
  · have h := (c.even_length_iff_congr q.2.2.val).mpr Iff.rfl
    rwa [q.2.2.property] at h

lemma adj_nonneg (x y : W) : 0≤G.adjMatrix ℝ x y := by
  simp only [SimpleGraph.adjMatrix_apply]
  split_ifs <;> norm_num

lemma point_one_degree (x : W) : point (G.adjMatrix ℝ) 1 x=G.degree x := by
  simp only [point,mul_one,pow_two,G.adjMatrix_mul_self_apply_self]

/-- Every fixed repeated-vertex condition costs at most maximum degree times
the immediately preceding even trace moment. -/
theorem collision_bound (c : G.Coloring Bool) (k i j : ℕ) (hij : i<j) (hjn : j<2*(k+2))
    (hpos : ∀x, 0<G.degree x) {D : ℝ} (hD : 0≤D) (hdeg : ∀x, (G.degree x:ℝ)≤D) :
    (Fintype.card (Collision G (2*(k+2)) i j):ℝ)≤D*total (G.adjMatrix ℝ) (k+1) := by
  classical
  cases isEmpty_or_nonempty (Collision G (2*(k+2)) i j) with
  | inl he =>
    letI := he
    rw [Fintype.card_eq_zero,Nat.cast_zero]
    exact mul_nonneg hD (total_nonneg adj_nonneg _)
  | inr he =>
    obtain ⟨p⟩ := he
    have hev := pinched_even c (by omega) (toPinched hij.le hjn p)
    obtain ⟨a,ha⟩ := hev.1
    obtain ⟨b,hb⟩ := hev.2
    have ha1 : 1≤a := by omega
    have hb1 : 1≤b := by omega
    have hda : j-i=2*((a-1)+1) := by omega
    have hdb : 2*(k+2)-(j-i)=2*((b-1)+1) := by omega
    have hab : (a-1)+(b-1)+1=k+1 := by omega
    have h := collision_card_bound (G:=G) hij.le hjn
    rw [hdb,hda] at h
    change (Fintype.card (Collision G (2*(k+2)) i j):ℝ)≤
      ∑x, point (G.adjMatrix ℝ) ((a-1)+1) x*point (G.adjMatrix ℝ) ((b-1)+1) x at h
    have hp (x : W) : 0<point (G.adjMatrix ℝ) 1 x := by
      rw [point_one_degree]
      exact_mod_cast hpos x
    have hd (x : W) : point (G.adjMatrix ℝ) 1 x≤D := by
      rw [point_one_degree]
      exact hdeg x
    have ht := total_pinch G.isSymm_adjMatrix adj_nonneg hp hd (a-1) (b-1)
    rw [hab] at ht
    exact h.trans ht

/-- Closed walks with a repeated vertex before the final return. -/
noncomputable def bad (G : SimpleGraph W) (n : ℕ) : Finset (Closed G n) := by
  classical
  exact univ.biUnion (fun i : Fin n => univ.biUnion (fun j : Fin n =>
    if i<j then univ.filter (fun p => vertex p i=vertex p j) else ∅))

lemma mem_bad {n : ℕ} (p : Closed G n) :
    p∈bad G n ↔ ∃i j : Fin n, i<j ∧ vertex p i=vertex p j := by
  classical
  simp only [bad,mem_biUnion,mem_univ,true_and,mem_ite,mem_filter,notMem_empty,imp_false,not_not]
  tauto

/-- All degeneracies together are controlled with a length-dependent constant. -/
theorem bad_bound (c : G.Coloring Bool) (k : ℕ) (hpos : ∀x, 0<G.degree x)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀x, (G.degree x:ℝ)≤D) :
    ((bad G (2*(k+2))).card:ℝ)≤(2*(k+2):ℕ)^2*D*total (G.adjMatrix ℝ) (k+1) := by
  classical
  have hb : (bad G (2*(k+2))).card≤
      ∑i : Fin (2*(k+2)), ∑j : Fin (2*(k+2)),
        (if i<j then (univ.filter (fun p : Closed G (2*(k+2)) => vertex p i=vertex p j)).card else 0) := by
    unfold bad
    apply card_biUnion_le.trans
    apply sum_le_sum
    intro i hi
    apply card_biUnion_le.trans
    apply sum_le_sum
    intro j hj
    split_ifs
    · apply card_le_card
      intro p hp
      simpa only [mem_filter,mem_univ,true_and] using hp
    · rw [card_empty]
  have hr : ((bad G (2*(k+2))).card:ℝ)≤
      ∑i : Fin (2*(k+2)), ∑j : Fin (2*(k+2)),
        (if i<j then ((univ.filter (fun p : Closed G (2*(k+2)) => vertex p i=vertex p j)).card:ℝ) else 0) := by
    exact_mod_cast hb
  apply hr.trans
  calc
    _ ≤ ∑_i : Fin (2*(k+2)), ∑_j : Fin (2*(k+2)), D*total (G.adjMatrix ℝ) (k+1) := by
      apply sum_le_sum
      intro i hi
      apply sum_le_sum
      intro j hj
      by_cases hij : i<j
      · rw [if_pos hij]
        have h := collision_bound c k i j hij j.isLt hpos hD hdeg
        have he : (univ.filter (fun p : Closed G (2*(k+2)) => vertex p i=vertex p j)).card=
            Fintype.card (Collision G (2*(k+2)) i j) := by
          rw [Fintype.card_subtype]
        rw [he]
        exact h
      · rw [if_neg hij]
        exact mul_nonneg hD (total_nonneg adj_nonneg _)
    _ = _ := by simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,Nat.cast_pow]; ring

end Erdos571.ClosedWalkRotation


/-! Rooted paths of arbitrary length and their full theta powers. -/
namespace Erdos571.GenericTheta
open Finset SimpleGraph RootedPacking

abbrev Vertex (k : ℕ) := Fin (k+1)⊕Fin 2

def position (k : ℕ) : Vertex k → Fin (k+3)
  | .inl a => ⟨a.val+1,by omega⟩
  | .inr r => if r=0 then 0 else ⟨k+2,by omega⟩

lemma position_injective (k : ℕ) : Function.Injective (position k) := by
  rintro (a|r) (b|s) he
  · have h := congrArg Fin.val he
    exact congrArg Sum.inl (Fin.ext (by dsimp only [position] at h; omega))
  · have h := congrArg Fin.val he
    fin_cases s <;> norm_num [position] at h <;> omega
  · have h := congrArg Fin.val he
    fin_cases r <;> norm_num [position] at h <;> omega
  · fin_cases r <;> fin_cases s
    all_goals first | rfl | skip
    all_goals have h := congrArg Fin.val he
    all_goals norm_num [position] at h


def template (k : ℕ) : SimpleGraph (Vertex k) := (pathGraph (k+3)).comap (position k)
abbrev graph (k M : ℕ) := FullRootedPower.graph (template k) M

variable {W : Type*} {G : SimpleGraph W}

/-- An oriented walk with its two endpoints and length stored in its type. -/
abbrev PathWalk (G : SimpleGraph W) (k : ℕ) :=
  (x : W) × (y : W) × {p : G.Walk x y // p.length=k+2}

def vertex {k : ℕ} (p : PathWalk G k) (i : ℕ) : W := p.2.2.val.getVert i

def roots {k : ℕ} (p : PathWalk G k) : W×W := (p.1,p.2.1)

def Good {k : ℕ} (p : PathWalk G k) : Prop :=
  Function.Injective (fun i : Fin (k+3) => vertex p i)

noncomputable def foot [DecidableEq W] {k : ℕ} (p : PathWalk G k) : Finset W :=
  univ.image (fun i : Fin (k+1) => vertex p (i.val+1))

lemma foot_nonempty [DecidableEq W] {k : ℕ} (p : PathWalk G k) : (foot p).Nonempty :=
  ⟨vertex p 1,mem_image.mpr ⟨0,mem_univ _,rfl⟩⟩

@[simp] lemma vertex_zero {k : ℕ} (p : PathWalk G k) : vertex p 0=p.1 := Walk.getVert_zero _
@[simp] lemma vertex_end {k : ℕ} (p : PathWalk G k) : vertex p (k+2)=p.2.1 :=
  Walk.getVert_of_length_le _ p.2.2.property.le

/-- A vertex-simple walk is a copy of the corresponding rooted path. -/
def copyOfGood {k : ℕ} (p : PathWalk G k) (hp : Good p) : (template k).Copy G where
  toHom :=
    { toFun := fun v => vertex p (position k v)
      map_rel' := by
        intro u v huv
        have hh := pathGraph_adj.mp huv
        rcases hh with he|he
        · have ha := p.2.2.val.adj_getVert_succ (show (position k u).val<p.2.2.val.length by
            have hv := (position k v).isLt
            rw [p.2.2.property]
            omega)
          simpa only [vertex,he] using ha
        · have ha := p.2.2.val.adj_getVert_succ (show (position k v).val<p.2.2.val.length by
            have hu := (position k u).isLt
            rw [p.2.2.property]
            omega)
          simpa only [vertex,he] using ha.symm }
  injective' := hp.comp (position_injective k)

lemma copyOfGood_root_zero {k : ℕ} (p : PathWalk G k) (hp : Good p) :
    copyOfGood p hp (.inr 0)=p.1 := by
  change vertex p (position k (.inr 0))=p.1
  simp only [position,ite_true,Fin.val_zero,vertex_zero]

lemma copyOfGood_root_one {k : ℕ} (p : PathWalk G k) (hp : Good p) :
    copyOfGood p hp (.inr 1)=p.2.1 := by
  change vertex p (position k (.inr 1))=p.2.1
  simp only [position,Fin.reduceEq,ite_false,vertex_end]

lemma interior_copyOfGood [DecidableEq W] {k : ℕ} (p : PathWalk G k) (hp : Good p) :
    interior (copyOfGood p hp)=foot p := by
  classical
  ext w
  simp only [RootedPacking.interior,foot,mem_image,mem_univ,true_and]
  rfl

end Erdos571.GenericTheta


/-! Packing simple paths while retaining the full pair-of-walks second moment. -/
namespace Erdos571.GenericTheta
open Finset SimpleGraph
variable {W : Type*} [DecidableEq W] {G : SimpleGraph W}

/-- A pair conflicts if either walk is nonsimple or their interiors intersect. -/
def Conflict {k : ℕ} (p q : PathWalk G k) : Prop :=
  ¬(Good p ∧ Good q ∧ Disjoint (foot p) (foot q))

lemma conflict_refl {k : ℕ} (p : PathWalk G k) : Conflict p p := by
  intro h
  exact (foot_nonempty p).ne_empty (disjoint_self.mp h.2.2)

lemma conflict_symm {k : ℕ} {p q : PathWalk G k} (h : Conflict p q) : Conflict q p := by
  intro h'
  exact h ⟨h'.2.1,h'.1,h'.2.2.symm⟩

lemma contains_of_packing {k : ℕ} (S : Finset (PathWalk G k)) (M : ℕ) (hM : 0<M)
    (r : W×W) (hS : S.card=M) (hg : ∀p∈S, Good p) (hr : ∀p∈S, roots p=r)
    (hdis : ∀p∈S, ∀q∈S, p≠q → Disjoint (foot p) (foot q)) : graph k M ⊑ G := by
  classical
  obtain ⟨p₀,hp₀⟩ := card_pos.mp (by omega : 0<S.card)
  have hrne : r.1≠r.2 := by
    intro he
    have he' : vertex p₀ (0 : Fin (k+3))=vertex p₀ (⟨k+2,by omega⟩ : Fin (k+3)) := by
      simp only [Fin.val_zero,vertex_zero,vertex_end]
      exact (congrArg Prod.fst (hr p₀ hp₀)).trans (he.trans (congrArg Prod.snd (hr p₀ hp₀)).symm)
    have hh := congrArg Fin.val (hg p₀ hp₀ he')
    norm_num at hh
  let r' : Fin 2 ↪ W :=
    ⟨![r.1,r.2],by
      intro i j he
      fin_cases i <;> fin_cases j
      all_goals first | rfl | exact (hrne he).elim | exact (hrne he.symm).elim⟩
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa only [Fintype.card_coe,Fintype.card_fin] using hS.symm)
  let f : Fin M → (template k).Copy G := fun i => copyOfGood (e i).val (hg (e i) (e i).property)
  have hfr (i : Fin M) (j : Fin 2) : f i (.inr j)=r' j := by
    fin_cases j
    · exact (copyOfGood_root_zero _ _).trans (congrArg Prod.fst (hr (e i) (e i).property))
    · exact (copyOfGood_root_one _ _).trans (congrArg Prod.snd (hr (e i) (e i).property))
  have hfd (i j : Fin M) (hij : i≠j) :
      Disjoint (RootedPacking.interior (f i)) (RootedPacking.interior (f j)) := by
    rw [interior_copyOfGood,interior_copyOfGood]
    exact hdis (e i) (e i).property (e j) (e j).property
      (fun he => hij (e.injective (Subtype.ext he)))
  exact ⟨FullRootedPacking.powerCopy M hM r' f hfr hfd⟩

lemma no_packing {k : ℕ} (F : Finset (PathWalk G k)) (M : ℕ) (hM : 2≤M)
    (hf : (graph k M).Free G) (r : W×W) :
    ¬∃S⊆F.filter (fun p => roots p=r), S.card=M ∧
      ∀p∈S, ∀q∈S, p≠q → ¬Conflict p q := by
  classical
  rintro ⟨S,hSF,hS,hdis⟩
  apply hf (contains_of_packing S M (by omega) r hS ?_ ?_ ?_)
  · intro p hp
    obtain ⟨q,hq,hqp⟩ := exists_mem_ne (by omega : 1<S.card) p
    exact (not_not.mp (hdis p hp q hq hqp.symm)).1
  · intro p hp
    exact (mem_filter.mp (hSF hp)).2
  · intro p hp q hq hpq
    exact (not_not.mp (hdis p hp q hq hpq)).2.2

/-- All walks may be counted: nonsimple walks are treated as conflicts rather
than removed by a potentially lossy preliminary estimate. -/
theorem pair_bound {k : ℕ} (F : Finset (PathWalk G k)) (M : ℕ) (hM : 2≤M)
    (hf : (graph k M).Free G) :
    letI : DecidableRel (Conflict (G:=G) (k:=k)) := fun _ _ => Classical.propDecidable _
    (PackingEnergy.fiberPairs F roots (fun _ _ => True)).card≤
      (M-1)*(PackingEnergy.fiberPairs F roots Conflict).card := by
  classical
  have h := PackingEnergy.weighted_fiber_second_moment F roots Conflict
    (fun p hp => conflict_refl p) (fun p hp q hq => conflict_symm) M hM
    (no_packing F M hM hf) (fun _ => 1) (by intros; norm_num)
  rw [PackingEnergy.sum_fiber_mass_sq] at h
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

end Erdos571.GenericTheta


/-! Pairs of equal-endpoint walks are exactly marked closed walks. -/
namespace Erdos571.GenericTheta
open Finset SimpleGraph
variable {W : Type*} {G : SimpleGraph W}

lemma ext_vertex {k : ℕ} {p q : PathWalk G k}
    (h : ∀i≤k+2, vertex p i=vertex q i) : p=q := by
  have hx : p.1=q.1 := by simpa only [vertex_zero] using h 0 (by omega)
  have hy : p.2.1=q.2.1 := by simpa only [vertex_end] using h (k+2) le_rfl
  rcases p with ⟨x,y,p,hp⟩
  rcases q with ⟨x',y',q,hq⟩
  dsimp only at hx hy
  subst x'
  subst y'
  congr 2
  apply Subtype.ext
  apply Walk.ext_getVert_le_length (hp.trans hq.symm)
  intro i hi
  exact h i (by omega)

abbrev Agreement (G : SimpleGraph W) (k : ℕ) :=
  {e : PathWalk G k×PathWalk G k // roots e.1=roots e.2}

/-- Traverse the first walk and then the reverse of the second. -/
def joinPair {k : ℕ} (e : Agreement G k) : ClosedWalkRotation.Closed G (2*(k+2)) :=
  ⟨e.val.1.1,⟨e.val.1.2.2.val.append
    (e.val.2.2.2.val.reverse.copy (congrArg Prod.snd e.property).symm (congrArg Prod.fst e.property).symm),by
      simp only [Walk.length_append,Walk.length_copy,Walk.length_reverse,
        e.val.1.2.2.property,e.val.2.2.2.property]
      omega⟩⟩

lemma joinPair_left {k : ℕ} (e : Agreement G k) (i : ℕ) (hi : i≤k+2) :
    ClosedWalkRotation.vertex (joinPair e) i=vertex e.val.1 i := by
  simp only [ClosedWalkRotation.vertex,joinPair,Walk.getVert_append,e.val.1.2.2.property,
    Walk.getVert_copy,Walk.getVert_reverse,e.val.2.2.2.property]
  by_cases hil : i<k+2
  · rw [if_pos hil]
    rfl
  · rw [if_neg hil]
    have hie : i=k+2 := by omega
    subst i
    change vertex e.val.2 (k+2-((k+2)-(k+2)))=vertex e.val.1 (k+2)
    rw [Nat.sub_self,Nat.sub_zero,vertex_end,vertex_end]
    exact (congrArg Prod.snd e.property).symm

lemma joinPair_right {k : ℕ} (e : Agreement G k) (i : ℕ) (hi : i≤k+2) :
    ClosedWalkRotation.vertex (joinPair e) (2*(k+2)-i)=vertex e.val.2 i := by
  simp only [ClosedWalkRotation.vertex,joinPair,Walk.getVert_append,e.val.1.2.2.property,
    Walk.getVert_copy,Walk.getVert_reverse,e.val.2.2.2.property]
  rw [if_neg (by omega : ¬2*(k+2)-i<k+2)]
  change vertex e.val.2 (k+2-((2*(k+2)-i)-(k+2)))=vertex e.val.2 i
  congr 1
  omega

lemma joinPair_injective {k : ℕ} : Function.Injective (joinPair (G:=G) (k:=k)) := by
  intro e f he
  apply Subtype.ext
  apply Prod.ext
  · apply ext_vertex
    intro i hi
    rw [←joinPair_left e i hi,←joinPair_left f i hi,he]
  · apply ext_vertex
    intro i hi
    rw [←joinPair_right e i hi,←joinPair_right f i hi,he]

def splitPair {k : ℕ} (p : ClosedWalkRotation.Closed G (2*(k+2))) : Agreement G k :=
  ⟨(⟨p.1,ClosedWalkRotation.vertex p (k+2),⟨p.2.val.take (k+2),by
      simp only [Walk.take_length,p.2.property]
      omega⟩⟩,
    ⟨p.1,ClosedWalkRotation.vertex p (k+2),⟨(p.2.val.drop (k+2)).reverse,by
      simp only [Walk.length_reverse,Walk.drop_length,p.2.property]
      omega⟩⟩),rfl⟩

lemma joinPair_splitPair {k : ℕ} (p : ClosedWalkRotation.Closed G (2*(k+2))) :
    joinPair (splitPair p)=p := by
  apply ClosedWalkRotation.ext_vertex (by omega)
  intro i hi
  by_cases hil : i<k+2
  · rw [joinPair_left _ i (by omega)]
    change (p.2.val.take (k+2)).getVert i=p.2.val.getVert i
    rw [Walk.take_getVert,min_eq_right (by omega : i≤k+2)]
  · have hsub : 2*(k+2)-(2*(k+2)-i)=i := by omega
    rw [←hsub,joinPair_right _ (2*(k+2)-i) (by omega),hsub]
    change ((p.2.val.drop (k+2)).reverse).getVert (2*(k+2)-i)=p.2.val.getVert i
    rw [Walk.getVert_reverse,Walk.drop_length,p.2.property,Walk.drop_getVert]
    congr 1
    omega

def pairEquivClosed (k : ℕ) : Agreement G k ≃ ClosedWalkRotation.Closed G (2*(k+2)) where
  toFun := joinPair
  invFun := splitPair
  left_inv e := joinPair_injective (joinPair_splitPair (joinPair e))
  right_inv := joinPair_splitPair

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev Conflicting (G : SimpleGraph W) (k : ℕ) :=
  {e : PathWalk G k×PathWalk G k // roots e.1=roots e.2 ∧ Conflict e.1 e.2}

lemma agreement_card (k : ℕ) :
    (Fintype.card (Agreement G k):ℝ)=EvenWalkMoments.total (G.adjMatrix ℝ) (k+2) := by
  have he := Fintype.card_congr (pairEquivClosed (G:=G) k)
  rw [he,ClosedWalkRotation.closed_card]

open Classical in
lemma typed_pair_bound (k M : ℕ) (hM : 2≤M) (hf : (graph k M).Free G) :
    Fintype.card (Agreement G k)≤(M-1)*Fintype.card (Conflicting G k) := by
  classical
  have h := pair_bound (univ : Finset (PathWalk G k)) M hM hf
  have ha : (PackingEnergy.fiberPairs (univ : Finset (PathWalk G k)) roots (fun _ _ => True)).card=
      Fintype.card (Agreement G k) := by
    rw [Fintype.card_subtype]
    congr 1
    ext e
    simp only [PackingEnergy.fiberPairs,mem_filter,mem_product,mem_univ,true_and,and_true]
  have hc : (PackingEnergy.fiberPairs (univ : Finset (PathWalk G k)) roots Conflict).card=
      Fintype.card (Conflicting G k) := by
    rw [Fintype.card_subtype]
    congr 1
  rwa [ha,hc] at h

end Erdos571.GenericTheta


/-! The sharp moment ratio for a theta-free bipartite graph. -/
namespace Erdos571.GenericTheta
open Finset SimpleGraph EvenWalkMoments
variable {W : Type*} {G : SimpleGraph W}
variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

lemma indices_eq_of_not_bad {n : ℕ} {p : ClosedWalkRotation.Closed G n}
    (hp : p ∉ ClosedWalkRotation.bad G n) {i j : ℕ} (hi : i<n) (hj : j<n)
    (he : ClosedWalkRotation.vertex p i=ClosedWalkRotation.vertex p j) : i=j := by
  by_contra hne
  rcases lt_or_gt_of_ne hne with hij|hji
  · exact hp ((ClosedWalkRotation.mem_bad p).mpr ⟨⟨i,hi⟩,⟨j,hj⟩,hij,he⟩)
  · exact hp ((ClosedWalkRotation.mem_bad p).mpr ⟨⟨j,hj⟩,⟨i,hi⟩,hji,he.symm⟩)

def rightSlot (k i : ℕ) : ℕ := if i=0 then 0 else 2*(k+2)-i

lemma rightSlot_lt {k i : ℕ} (hi : i≤k+2) : rightSlot k i<2*(k+2) := by
  unfold rightSlot
  split_ifs <;> omega

lemma rightSlot_injective {k i j : ℕ} (hi : i≤k+2) (hj : j≤k+2)
    (he : rightSlot k i=rightSlot k j) : i=j := by
  unfold rightSlot at he
  split_ifs at he <;> omega

lemma joinPair_rightSlot {k : ℕ} (e : Agreement G k) (i : ℕ) (hi : i≤k+2) :
    ClosedWalkRotation.vertex (joinPair e) (rightSlot k i)=vertex e.val.2 i := by
  unfold rightSlot
  split_ifs with h
  · subst i
    rw [ClosedWalkRotation.vertex_zero,vertex_zero]
    exact congrArg Prod.fst e.property
  · exact joinPair_right e i hi

lemma good_pair_of_not_bad {k : ℕ} (e : Agreement G k)
    (h : joinPair e ∉ ClosedWalkRotation.bad G (2*(k+2))) :
    Good e.val.1 ∧ Good e.val.2 ∧ Disjoint (foot e.val.1) (foot e.val.2) := by
  refine ⟨?_,?_,?_⟩
  · intro i j hij
    apply Fin.ext
    apply indices_eq_of_not_bad h (by omega : i.val<2*(k+2)) (by omega : j.val<2*(k+2))
    rwa [joinPair_left e i (by omega),joinPair_left e j (by omega)]
  · intro i j hij
    apply Fin.ext
    apply rightSlot_injective (by omega : i.val≤k+2) (by omega : j.val≤k+2)
    apply indices_eq_of_not_bad h (rightSlot_lt (by omega)) (rightSlot_lt (by omega))
    rwa [joinPair_rightSlot e i (by omega),joinPair_rightSlot e j (by omega)]
  · apply Finset.disjoint_left.mpr
    intro x hx hy
    obtain ⟨i,hi,hix⟩ := mem_image.mp hx
    obtain ⟨j,hj,hjx⟩ := mem_image.mp hy
    have he : ClosedWalkRotation.vertex (joinPair e) (i.val+1)=
        ClosedWalkRotation.vertex (joinPair e) (2*(k+2)-(j.val+1)) := by
      rw [joinPair_left e _ (by omega),joinPair_right e _ (by omega),hix,hjx]
    have hn := indices_eq_of_not_bad h (by omega : i.val+1<2*(k+2))
      (by omega : 2*(k+2)-(j.val+1)<2*(k+2)) he
    omega

lemma conflict_mem_bad {k : ℕ} (e : Conflicting G k) :
    joinPair ⟨e.val,e.property.1⟩ ∈ ClosedWalkRotation.bad G (2*(k+2)) := by
  by_contra h
  exact e.property.2 (good_pair_of_not_bad ⟨e.val,e.property.1⟩ h)

open Classical in
lemma conflicting_card_bound (k : ℕ) :
    Fintype.card (Conflicting G k)≤(ClosedWalkRotation.bad G (2*(k+2))).card := by
  let f : Conflicting G k → ↥(ClosedWalkRotation.bad G (2*(k+2))) :=
    fun e => ⟨joinPair ⟨e.val,e.property.1⟩,conflict_mem_bad e⟩
  have hf : Function.Injective f := by
    intro e e' he
    apply Subtype.ext
    have he' : (⟨e.val,e.property.1⟩ : Agreement G k)=⟨e'.val,e'.property.1⟩ :=
      joinPair_injective (congrArg Subtype.val he)
    exact Subtype.mk.inj he'
  simpa only [Fintype.card_coe] using Fintype.card_le_of_injective f hf

/-- Freeness bounds the last even-moment ratio by a constant times maximum degree. -/
theorem moment_step (c : G.Coloring Bool) (k M : ℕ) (hM : 2≤M) (hf : (graph k M).Free G)
    (hpos : ∀x, 0<G.degree x) {D : ℝ} (hD : 0≤D) (hdeg : ∀x, (G.degree x:ℝ)≤D) :
    total (G.adjMatrix ℝ) (k+2)≤((M-1:ℕ):ℝ)*(2*(k+2):ℕ)^2*D*
      total (G.adjMatrix ℝ) (k+1) := by
  classical
  have hp : (Fintype.card (Agreement G k):ℝ)≤((M-1:ℕ):ℝ)*Fintype.card (Conflicting G k) := by
    exact_mod_cast typed_pair_bound k M hM hf
  have hc : (Fintype.card (Conflicting G k):ℝ)≤(ClosedWalkRotation.bad G (2*(k+2))).card := by
    exact_mod_cast conflicting_card_bound (G:=G) k
  have hb := ClosedWalkRotation.bad_bound c k hpos hD hdeg
  rw [agreement_card] at hp
  calc
    _ ≤ ((M-1:ℕ):ℝ)*Fintype.card (Conflicting G k) := hp
    _ ≤ ((M-1:ℕ):ℝ)*(ClosedWalkRotation.bad G (2*(k+2))).card :=
      mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg _)
    _ ≤ ((M-1:ℕ):ℝ)*((2*(k+2):ℕ)^2*D*total (G.adjMatrix ℝ) (k+1)) :=
      mul_le_mul_of_nonneg_left hb (Nat.cast_nonneg _)
    _ = _ := by ring

end Erdos571.GenericTheta


/-! A uniform sharp upper bound for arbitrary fixed theta graphs. -/
namespace Erdos571.GenericTheta
open Finset SimpleGraph EvenWalkMoments DensityRegularization ProjectionHeavy

lemma degree_bound {W : Type*} [Fintype W] [Nonempty W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (c : G.Coloring Bool)
    (k M : ℕ) (hM : 2≤M) (hf : (graph k M).Free G)
    {Q d : ℝ} (hQ : 0≤Q) (hd : 0<d)
    (hdeg : ∀x, d≤(G.degree x:ℝ) ∧ (G.degree x:ℝ)≤Q*d) :
    d≤((M-1:ℕ):ℝ)*(2*(k+2):ℕ)^2*Q*(Fintype.card W:ℝ)^(1/(k+2:ℕ):ℝ) := by
  have hpos (x : W) : 0<G.degree x := by
    exact_mod_cast hd.trans_le (hdeg x).1
  have hpoint (x : W) : 0<point (G.adjMatrix ℝ) 1 x := by
    rw [ClosedWalkRotation.point_one_degree]
    exact_mod_cast hpos x
  let C : ℝ := ((M-1:ℕ):ℝ)*(2*(k+2):ℕ)^2*Q
  have hC : 0≤C := by dsimp [C]; positivity
  have hs : total (G.adjMatrix ℝ) ((k+1)+1)≤(C*d)*total (G.adjMatrix ℝ) (k+1) := by
    have h := moment_step c k M hM hf hpos (mul_nonneg hQ hd.le) (fun x => (hdeg x).2)
    simpa only [Nat.add_assoc,mul_assoc,C] using h
  have hu := total_growth_bound G.isSymm_adjMatrix ClosedWalkRotation.adj_nonneg hpoint (k+1)
    (mul_nonneg hC hd.le) hs
  have hl := total_lower G.isSymm_adjMatrix ClosedWalkRotation.adj_nonneg hd.le
    (fun x => by simpa only [SimpleGraph.adjMatrix_apply,←G.degree_eq_sum_if_adj] using (hdeg x).1) (k+2)
  have hp : d^(2*(k+2))≤(Fintype.card W:ℝ)*(C*d)^(k+2) := hl.trans hu
  have hdL : 0<d^(k+2) := pow_pos hd _
  have hp' : d^(k+2)≤C^(k+2)*(Fintype.card W:ℝ) := by
    apply (mul_le_mul_iff_right₀ hdL).mp
    calc
      d^(k+2)*d^(k+2) = d^(2*(k+2)) := by rw [←pow_add]; congr 1; omega
      _ ≤ (Fintype.card W:ℝ)*(C*d)^(k+2) := hp
      _ = _ := by rw [mul_pow]; ring
  have hn : 0≤(Fintype.card W:ℝ) := Nat.cast_nonneg _
  have hn0 : (0:ℝ)<(k+2:ℕ) := by positivity
  apply (pow_le_pow_iff_left₀ hd.le (mul_nonneg hC (Real.rpow_nonneg hn _)) (by omega : k+2≠0)).mp
  change d^(k+2)≤(C*(Fintype.card W:ℝ)^(1/(k+2:ℕ):ℝ))^(k+2)
  rw [mul_pow,←Real.rpow_mul_natCast hn,one_div_mul_cancel hn0.ne',Real.rpow_one]
  exact hp'

/-- Induced almost-regular hosts satisfy the sharp estimate without a large-degree cutoff. -/
theorem exists_regular_bound (k M : ℕ) (hM : 2≤M) (Q : ℝ) (hQ : 1≤Q) :
    ∃D : ℝ, 0≤D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj)
        (g : W → Bool), (∀{u v}, G.Adj u v → g u≠g v) → (graph k M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0<d →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          ((arcs G U).card:ℝ)≤D*(U.card:ℝ)^(1+1/(k+2:ℕ):ℝ) := by
  let C : ℝ := ((M-1:ℕ):ℝ)*(2*(k+2):ℕ)^2*Q
  have hQ0 : 0≤Q := by linarith
  have hC : 0≤C := by dsimp [C]; positivity
  refine ⟨Q*C,mul_nonneg hQ0 hC,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  letI : Nonempty ↥U := hU.to_subtype
  let H := G.induce (U:Set W)
  let c : H.Coloring Bool := ⟨fun x => g x.val,fun h => hg h⟩
  have hfree : (graph k M).Free H := fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
  have hb := degree_bound H c k M hM hfree hQ0 hd (fun x => by
    simpa only [H,TreeCopiesIn.induce_degree] using hdeg x.val x.property)
  have hcard : Fintype.card ↑(U:Set W)=U.card := by
    rw [←Nat.card_eq_fintype_card,Nat.card_coe_set_eq,Set.ncard_coe_finset]
  rw [hcard] at hb
  have hn : 0<(U.card:ℝ) := by exact_mod_cast hU.card_pos
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*(C*(U.card:ℝ)^(1/(k+2:ℕ):ℝ)) :=
      mul_le_mul_of_nonneg_left hb (by positivity)
    _ = _ := by rw [Real.rpow_add hn,Real.rpow_one]; ring

/-- The theta graph with `M` branches of length `k+2` has extremal exponent at most `1+1/(k+2)`. -/
theorem edge_bound (k M : ℕ) (hM : 2≤M) :
    ∃D : ℝ, 0≤D ∧ EdgeBound (graph k M) (1+1/(k+2:ℕ):ℝ) D := by
  let γ : ℝ := 1/(k+2:ℕ)
  have hk : (1:ℝ)≤(k+2:ℕ) := by exact_mod_cast (show 1≤k+2 by omega)
  have hγ : 0<γ := by dsimp [γ]; positivity
  have hγ1 : γ≤1 := by dsimp [γ]; exact (div_le_one (by positivity)).mpr hk
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0<K := by dsimp [K]; positivity
  have hK1 : 1≤K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16≤K^((1+γ)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left,Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound k M hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph k M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+γ) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ)≤2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.GenericTheta


/-! Balanced rooted-path certificates for all theta lengths. -/
namespace Erdos571.GenericTheta
open Finset SimpleGraph RootedSunflower OrdinaryRooted

noncomputable def pathEquiv (k : ℕ) : Vertex k ≃ Fin (k+3) :=
  Equiv.ofBijective (position k) ((Fintype.bijective_iff_injective_and_card _).mpr
    ⟨position_injective k,by simp [Vertex]⟩)

noncomputable def pathIso (k : ℕ) : template k ≃g pathGraph (k+3) where
  toEquiv := pathEquiv k
  map_rel_iff' := Iff.rfl

lemma connected (k : ℕ) : (template k).Connected :=
  (pathIso k).connected_iff.mpr (pathGraph_connected (k+2))

lemma no_isolated (k : ℕ) : ∀u, ∃v, (template k).Adj u v := by
  letI : Nontrivial (Vertex k) := ⟨⟨.inl 0,.inr 0,Sum.inl_ne_inr⟩⟩
  exact (connected k).preconnected.exists_adj_of_nontrivial

noncomputable def stepEdge (k : ℕ) (i : Fin (k+2)) : (template k).edgeSet :=
  ⟨s((pathEquiv k).symm i.castSucc,(pathEquiv k).symm i.succ),by
    apply (template k).mem_edgeSet.mpr
    change (pathGraph (k+3)).Adj ((pathEquiv k) ((pathEquiv k).symm i.castSucc))
      ((pathEquiv k) ((pathEquiv k).symm i.succ))
    rw [Equiv.apply_symm_apply,Equiv.apply_symm_apply,pathGraph_adj]
    exact Or.inl rfl⟩

lemma stepEdge_injective (k : ℕ) : Function.Injective (stepEdge k) := by
  intro i j he
  have h := Sym2.eq_iff.mp (congrArg Subtype.val he)
  rcases h with ⟨h,_⟩|⟨h,h'⟩
  · have hh := (pathEquiv k).symm.injective h
    have hv := congrArg Fin.val hh
    exact Fin.ext hv
  · have hh := congrArg Fin.val ((pathEquiv k).symm.injective h)
    have hh' := congrArg Fin.val ((pathEquiv k).symm.injective h')
    simp only [Fin.val_castSucc,Fin.val_succ] at hh hh'
    omega

lemma mem_stepEdge_iff (k : ℕ) (i : Fin (k+2)) (v : Vertex k) :
    v ∈ (stepEdge k i).val ↔ position k v=i.castSucc ∨ position k v=i.succ := by
  change v ∈ s((pathEquiv k).symm i.castSucc,(pathEquiv k).symm i.succ) ↔ _
  simp only [Sym2.mem_iff]
  change (v=(pathEquiv k).symm i.castSucc ∨ v=(pathEquiv k).symm i.succ) ↔
    (pathEquiv k) v=i.castSucc ∨ (pathEquiv k) v=i.succ
  simp only [Equiv.eq_symm_apply]

lemma leftEdge_mem (k : ℕ) (a : Fin (k+1)) : Sum.inl a ∈ (stepEdge k a.castSucc).val := by
  rw [mem_stepEdge_iff]
  right
  apply Fin.ext
  rfl

lemma rightEdge_mem (k : ℕ) (a : Fin (k+1)) : Sum.inl a ∈ (stepEdge k a.succ).val := by
  rw [mem_stepEdge_iff]
  left
  apply Fin.ext
  rfl

/-- Every nonempty collection of interior path vertices meets at least one more edge than its size. -/
lemma petal_card (k : ℕ) (C : Finset (Fin (k+1))) (hC : (univ\C).Nonempty) :
    (univ\C).card+1≤Nat.card (PetalEdge (template k) C) := by
  classical
  let S := univ\C
  let m := S.max' hC
  have hm : m∈S := S.max'_mem hC
  let f : Option ↥S → PetalEdge (template k) C := fun a => match a with
    | none => ⟨stepEdge k m.succ,⟨m,(mem_sdiff.mp hm).2,rightEdge_mem k m⟩⟩
    | some a => ⟨stepEdge k a.val.castSucc,⟨a.val,(mem_sdiff.mp a.property).2,leftEdge_mem k a.val⟩⟩
  have hinj : Function.Injective f := by
    intro a b he
    cases a with
    | none => cases b with
      | none => rfl
      | some b =>
        have hi : m.succ=b.val.castSucc := stepEdge_injective k (congrArg Subtype.val he)
        have hv := congrArg Fin.val hi
        have hb : b.val ≤ m := S.le_max' _ b.property
        simp only [Fin.val_succ,Fin.val_castSucc] at hv
        have hb' : b.val.val ≤ m.val := hb
        omega
    | some a => cases b with
      | none =>
        have hi : a.val.castSucc=m.succ := stepEdge_injective k (congrArg Subtype.val he)
        have hv := congrArg Fin.val hi
        have ha : a.val ≤ m := S.le_max' _ a.property
        simp only [Fin.val_succ,Fin.val_castSucc] at hv
        have ha' : a.val.val ≤ m.val := ha
        omega
      | some b =>
        have hi : a.val.castSucc=b.val.castSucc := stepEdge_injective k (congrArg Subtype.val he)
        congr 1
        apply Subtype.ext
        have hv := congrArg Fin.val hi
        exact Fin.ext hv
  have h := Fintype.card_le_of_injective f hinj
  simpa only [Fintype.card_option,Fintype.card_coe,Nat.card_eq_fintype_card] using h

lemma balance (k : ℕ) : ∀C : Finset (Fin (k+1)),
    (k+2)*(Fintype.card (Fin (k+1))-C.card)≤(k+1)*Nat.card (PetalEdge (template k) C) := by
  intro C
  classical
  have hc : C.card≤k+1 := by simpa only [Fintype.card_fin] using card_le_univ C
  have he : (univ\C).card=k+1-C.card := by
    rw [card_sdiff_of_subset (subset_univ _),card_univ,Fintype.card_fin]
  simp only [Fintype.card_fin]
  by_cases hC : (univ\C).Nonempty
  · have h := petal_card k C hC
    rw [he] at h
    have hh := Nat.mul_le_mul_left (k+1) h
    have hn : k+1-C.card≤k+1 := Nat.sub_le _ _
    nlinarith
  · have h := card_eq_zero.mpr (not_nonempty_iff_eq_empty.mp hC)
    rw [he] at h
    rw [h,mul_zero]
    omega

def color (k : ℕ) (v : Vertex k) : Bool := pathGraph.bicoloring (k+3) (position k v)

lemma color_proper (k : ℕ) : ∀{u v}, (template k).Adj u v → color k u≠color k v := by
  intro u v h
  exact (pathGraph.bicoloring (k+3)).map_rel h

theorem supported (k : ℕ) : Supported (template k) (2-(k+1:ℕ)/(k+2:ℕ):ℝ) := by
  intro M hM
  have he : (2-(k+1:ℕ)/(k+2:ℕ):ℝ)=1+1/(k+2:ℕ) := by
    have hk : ((k+2:ℕ):ℝ)≠0 := by positivity
    field_simp
    push_cast
    ring
  rw [he]
  exact edge_bound k M hM

theorem certificate (k : ℕ) : Certificate (k+1) (k+2) :=
  ⟨Fin (k+1),Fin 2,inferInstance,inferInstance,inferInstance,inferInstance,
    template k,color k,color_proper k,connected k,no_isolated k,balance k,supported k⟩

theorem iterated_certificate (k t : ℕ) : Certificate (k+1) (k+2+(k+1)*t) := by
  induction t with
  | zero => simpa using certificate k
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    convert h using 1 <;> nlinarith

/-- Exact exponents supplied by all path powers and their paired cones. -/
theorem exact_family (k t : ℕ) :
    ∃q : ℕ, ∃G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(k+1:ℕ)/(k+2+(k+1)*t:ℕ):ℚ):ℝ)) := by
  have h := (iterated_certificate k t).realizes (by omega) (by nlinarith)
  exact h

end Erdos571.GenericTheta


/-! Even moments with an arbitrary Gram-kernel weight. -/
namespace Erdos571.GramWalkMoments
open Finset Matrix
variable {W I : Type*} [Fintype W] [DecidableEq W] [Fintype I]

noncomputable def moment (A : Matrix W W ℝ) (F : Matrix W I ℝ) (k : ℕ) : ℝ :=
  Matrix.trace (F.transpose*A^(2*k)*F)

lemma mixed {A : Matrix W W ℝ} (hs : A.IsSymm) (F : Matrix W I ℝ) (i j : ℕ) :
    (∑z, ∑x, (A^i*F) x z*(A^j*F) x z)=Matrix.trace (F.transpose*A^(i+j)*F) := by
  have he : (A^i*F).transpose*(A^j*F)=F.transpose*A^(i+j)*F := by
    rw [Matrix.transpose_mul,(hs.pow i).eq,pow_add]
    simp only [Matrix.mul_assoc]
  rw [←he]
  simp only [Matrix.trace,Matrix.diag,Matrix.mul_apply,Matrix.transpose_apply]

lemma sum_sq {A : Matrix W W ℝ} (hs : A.IsSymm) (F : Matrix W I ℝ) (k : ℕ) :
    (∑z, ∑x, ((A^k*F) x z)^2)=moment A F k := by
  simpa only [pow_two,show k+k=2*k by omega,moment] using mixed hs F k k

lemma nonneg {A : Matrix W W ℝ} (hs : A.IsSymm) (F : Matrix W I ℝ) (k : ℕ) :
    0 ≤ moment A F k := by
  rw [←sum_sq hs]
  exact sum_nonneg (fun _ _ => sum_nonneg (fun _ _ => sq_nonneg _))

lemma logconvex {A : Matrix W W ℝ} (hs : A.IsSymm) (F : Matrix W I ℝ) (k : ℕ) :
    moment A F (k+1)^2 ≤ moment A F k*moment A F (k+2) := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (I×W))
    (fun p => (A^k*F) p.2 p.1) (fun p => (A^(k+2)*F) p.2 p.1)
  simp only [Fintype.sum_prod_type] at h
  rw [mixed hs,sum_sq hs,sum_sq hs] at h
  simpa only [moment,show k+(k+2)=2*(k+1) by omega] using h

lemma kernel_eq (A : Matrix W W ℝ) (F : Matrix W I ℝ) (k : ℕ) :
    moment A F k=Matrix.trace (A^(2*k)*(F*F.transpose)) := by
  rw [moment,Matrix.trace_mul_cycle,Matrix.trace_mul_comm]

lemma kernel_expansion (A : Matrix W W ℝ) (F : Matrix W I ℝ) (k : ℕ) :
    moment A F k=∑x, ∑y, (A^(2*k)) x y*(F*F.transpose) y x := by
  rw [kernel_eq]
  simp only [Matrix.trace,Matrix.diag,Matrix.mul_apply]

lemma zero (A : Matrix W W ℝ) (F : Matrix W I ℝ) :
    moment A F 0=∑x, (F*F.transpose) x x := by
  rw [kernel_eq]
  simp only [mul_zero,pow_zero,Matrix.one_mul,Matrix.trace,Matrix.diag]

lemma kernel_nonneg {F : Matrix W I ℝ} (hF : ∀x z, 0≤F x z) (x y : W) :
    0≤(F*F.transpose) x y := by
  rw [Matrix.mul_apply]
  exact sum_nonneg (fun z hz => mul_nonneg (hF x z) (hF y z))

lemma diagonal_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {F : Matrix W I ℝ} (hF : ∀x z, 0≤F x z) (k : ℕ) :
    (∑x, (A^(2*k)) x x*(F*F.transpose) x x) ≤ moment A F k := by
  rw [kernel_expansion]
  apply sum_le_sum
  intro x hx
  exact single_le_sum (fun y hy => mul_nonneg (Matrix.pow_apply_nonneg hA (2*k) x y)
    (kernel_nonneg hF y x)) (mem_univ x)

lemma pos {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    (hp : ∀x, 0<Erdos571.EvenWalkMoments.point A 1 x)
    {F : Matrix W I ℝ} (hF : ∀x z, 0≤F x z) (hFpos : ∃x z, 0<F x z) (k : ℕ) :
    0 < moment A F k := by
  obtain ⟨x,z,hxz⟩ := hFpos
  have hker : 0<(F*F.transpose) x x := by
    rw [Matrix.mul_apply]
    apply (mul_pos hxz hxz).trans_le
    exact single_le_sum (fun z hz => mul_self_nonneg _) (mem_univ z)
  have hh := mul_pos (EvenWalkMoments.point_pos hA x (hp x) k) hker
  apply hh.trans_le
  apply le_trans ?_ (diagonal_lower hA hF k)
  exact single_le_sum (fun y hy => mul_nonneg (Matrix.pow_apply_nonneg hA (2*k) y y)
    (kernel_nonneg hF y y)) (mem_univ x)

end Erdos571.GramWalkMoments

/-! Propagation of a terminal-arm collision to its attachment collision. -/
namespace Erdos571.DiscreteMoments

lemma interpolation_power {m : ℕ → ℝ} (hp : ∀n, 0 < m n)
    (hc : ∀n, m (n+1)^2 ≤ m n*m (n+2)) (n : ℕ) :
    m n^(n+1) ≤ m 0*m (n+1)^n := by
  have h := growth_bound hp hc n (show 0≤ m (n+1)/m n from div_nonneg (hp _).le (hp _).le)
    (show m (n+1)≤(m (n+1)/m n)*m n by rw [div_mul_cancel₀ _ (hp n).ne']) n (by omega)
  rw [div_pow,←mul_div_assoc] at h
  have hh := (le_div_iff₀ (pow_pos (hp n) n)).mp h
  simpa only [pow_succ',mul_comm] using hh

end Erdos571.DiscreteMoments

namespace Erdos571.EvenWalkMoments
open Matrix
variable {W : Type*} [Fintype W] [DecidableEq W]

lemma degree_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤ A x y)
    {d : ℝ} (hd : 0≤ d) (hx : ∀x, d≤ point A 1 x) (k : ℕ) (x : W) :
    d^k≤ point A k x := by
  induction k with
  | zero => simp only [pow_zero,point_zero,le_refl]
  | succ k ih =>
    rw [pow_succ]
    exact (mul_le_mul ih (hx x) hd (point_nonneg hA k x)).trans (point_step hA k x)

end Erdos571.EvenWalkMoments

namespace Erdos571.GramWalkMoments
open Finset Matrix EvenWalkMoments
variable {W I : Type*} [Fintype W] [DecidableEq W] [Fintype I]

/-- The squared-root-fiber energy when the attachment vertices of the two copies coincide. -/
noncomputable def attachment (A : Matrix W W ℝ) (F : Matrix W I ℝ) (L : ℕ) : ℝ :=
  ∑x, (F*F.transpose) x x*point A L x

/-- The squared-root-fiber energy when the final interior vertices on an arm coincide. -/
noncomputable def terminal (A : Matrix W W ℝ) (F : Matrix W I ℝ) (k : ℕ) : ℝ :=
  ∑z, ∑x, point A 1 x*((A^k*F) x z)^2

lemma gram_diagonal_nonneg (F : Matrix W I ℝ) (x : W) : 0≤(F*F.transpose) x x := by
  rw [Matrix.mul_apply]
  exact sum_nonneg (fun z hz => mul_self_nonneg _)

lemma attachment_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤ A x y)
    (F : Matrix W I ℝ) (L : ℕ) : 0≤ attachment A F L := by
  exact sum_nonneg (fun x hx => mul_nonneg (gram_diagonal_nonneg F x) (point_nonneg hA L x))

lemma terminal_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤ A x y)
    (F : Matrix W I ℝ) (k : ℕ) : 0≤ terminal A F k := by
  exact sum_nonneg (fun z hz => sum_nonneg (fun x hx => mul_nonneg (point_nonneg hA 1 x) (sq_nonneg _)))

lemma terminal_le {A : Matrix W W ℝ} (hs : A.IsSymm)
    (F : Matrix W I ℝ) {D : ℝ} (hD : ∀x, point A 1 x≤ D) (k : ℕ) :
    terminal A F k≤ D*moment A F k := by
  rw [←sum_sq hs,terminal,mul_sum]
  apply sum_le_sum
  intro z hz
  rw [mul_sum]
  exact sum_le_sum (fun x hx => mul_le_mul_of_nonneg_right (hD x) (sq_nonneg _))

lemma attachment_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤ A x y)
    (F : Matrix W I ℝ) {d : ℝ} (hd : 0≤ d) (hdeg : ∀x, d≤ point A 1 x) (L : ℕ) :
    d^L*moment A F 0≤ attachment A F L := by
  rw [zero,mul_sum]
  apply sum_le_sum
  intro x hx
  simpa only [mul_comm] using mul_le_mul_of_nonneg_left (degree_lower hA hd hdeg L x)
    (gram_diagonal_nonneg F x)

/-- A terminal collision cannot carry large energy unless the attachment
collision does too. The estimate retains the full moment of the rest of the tree. -/
theorem terminal_propagation {A : Matrix W W ℝ} (hs : A.IsSymm) (hA : ∀x y, 0≤ A x y)
    {F : Matrix W I ℝ} (hF : ∀x z, 0≤ F x z) (hFpos : ∃x z, 0< F x z)
    {d D : ℝ} (hd : 0< d) (hD : 0≤ D)
    (hdeg : ∀x, d≤ point A 1 x ∧ point A 1 x≤ D) (k : ℕ) :
    (d*terminal A F k)^(k+1)≤ D^(k+1)*attachment A F (k+1)*moment A F (k+1)^k := by
  have hp := pos hA (fun x => hd.trans_le (hdeg x).1) hF hFpos
  have hc := DiscreteMoments.interpolation_power hp (logconvex hs F) k
  have ht := terminal_le hs F (fun x => (hdeg x).2) k
  have ht' := pow_le_pow_left₀ (terminal_nonneg hA F k) ht (k+1)
  rw [mul_pow] at ht'
  have ha := attachment_lower hA F hd.le (fun x => (hdeg x).1) (k+1)
  calc
    _ = d^(k+1)*terminal A F k^(k+1) := mul_pow _ _ _
    _ ≤ d^(k+1)*(D^(k+1)*moment A F k^(k+1)) :=
      mul_le_mul_of_nonneg_left ht' (pow_nonneg hd.le _)
    _ ≤ d^(k+1)*(D^(k+1)*(moment A F 0*moment A F (k+1)^k)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hc (pow_nonneg hD _)) (pow_nonneg hd.le _)
    _ = D^(k+1)*(d^(k+1)*moment A F 0)*moment A F (k+1)^k := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left ha (pow_nonneg hD _)) (pow_nonneg (hp _).le _)

end Erdos571.GramWalkMoments

/-! Recursive Gram kernels of homogeneous branching trees. -/
namespace Erdos571.GramFeatures
open Finset Matrix
variable {W I J : Type*} [Fintype W] [Fintype I]

noncomputable def kernel (F : Matrix W I ℝ) : Matrix W W ℝ := F*F.transpose

noncomputable def branch (F : Matrix W I ℝ) (s : ℕ) : Matrix W (Fin s → I) ℝ :=
  fun x r => ∏i, F x (r i)

lemma kernel_branch (F : Matrix W I ℝ) (s : ℕ) (x y : W) :
    kernel (branch F s) x y=(kernel F x y)^s := by
  simp only [kernel,Matrix.mul_apply,Matrix.transpose_apply,branch]
  simp_rw [←Finset.prod_mul_distrib]
  rw [←Fintype.prod_sum (fun _ : Fin s => fun z : I => F x z*F y z)]
  simp only [prod_const,card_univ,Fintype.card_fin]

lemma kernel_chain (A : Matrix W W ℝ) (F : Matrix W I ℝ) :
    kernel (A*F)=A*kernel F*A.transpose := by
  simp only [kernel,Matrix.transpose_mul,Matrix.mul_assoc]

lemma kernel_symm (F : Matrix W I ℝ) : (kernel F).IsSymm := by
  show (kernel F).transpose=kernel F
  simp only [kernel,Matrix.transpose_mul,Matrix.transpose_transpose]

lemma branch_nonneg {F : Matrix W I ℝ} (hF : ∀x z, 0≤F x z) (s : ℕ) (x : W) (r : Fin s → I) :
    0≤branch F s x r := prod_nonneg (fun i hi => hF x (r i))

lemma chain_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {F : Matrix W I ℝ} (hF : ∀x z, 0≤F x z) (x : W) (z : I) : 0≤(A*F) x z := by
  rw [Matrix.mul_apply]
  exact sum_nonneg (fun y hy => mul_nonneg (hA x y) (hF y z))

end Erdos571.GramFeatures

namespace Erdos571.LayeredGramKernels
open Finset Matrix GramFeatures
variable (W : Type*)

/-- Leaf labels in curried form, matching the recursive tree shape. -/
def Labels : List ℕ → Type _
  | [] => W
  | s::l => Fin s → Labels l

instance [Fintype W] (l : List ℕ) : Fintype (Labels W l) := by
  induction l with
  | nil => exact inferInstanceAs (Fintype W)
  | cons s l ih => exact inferInstanceAs (Fintype (Fin s → Labels W l))

lemma labels_card [Fintype W] (l : List ℕ) : Fintype.card (Labels W l)=Fintype.card W^l.prod := by
  induction l with
  | nil => simp only [Labels,List.prod_nil,pow_one]
  | cons s l ih =>
    simp only [Labels,Fintype.card_fun,Fintype.card_fin,ih,List.prod_cons,←pow_mul]
    rw [Nat.mul_comm]

variable {W}
variable [Fintype W]

/-- An entry is the weighted number of branch assignments with prescribed
attachment vertex and prescribed leaf labels. -/
noncomputable def feature (A : Matrix W W ℝ) : (l : List ℕ) → Matrix W (Labels W l) ℝ
  | [] => A
  | s::l => branch (A*feature A l) s

noncomputable def branchKernel (A : Matrix W W ℝ) (l : List ℕ) : Matrix W W ℝ :=
  kernel (feature A l)

lemma kernel_nil (A : Matrix W W ℝ) : branchKernel A []=A*A.transpose := rfl

lemma kernel_cons (A : Matrix W W ℝ) (s : ℕ) (l : List ℕ) (x y : W) :
    branchKernel A (s::l) x y=(A*branchKernel A l*A.transpose) x y^s := by
  change kernel (branch (A*feature A l) s) x y=_
  rw [kernel_branch,kernel_chain]
  rfl

lemma kernel_cons_symm {A : Matrix W W ℝ} (hs : A.IsSymm) (s : ℕ) (l : List ℕ) (x y : W) :
    branchKernel A (s::l) x y=(A*branchKernel A l*A) x y^s := by
  rw [kernel_cons,hs.eq]

lemma feature_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y) (l : List ℕ) :
    ∀x r, 0≤feature A l x r := by
  induction l with
  | nil => exact hA
  | cons s l ih => exact branch_nonneg (chain_nonneg hA ih) s

lemma feature_pos_some {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    (hn : ∀x, ∃y, 0<A x y) (l : List ℕ) : ∀x, ∃r, 0<feature A l x r := by
  induction l with
  | nil => exact hn
  | cons s l ih =>
    intro x
    obtain ⟨y,hxy⟩ := hn x
    obtain ⟨r,hr⟩ := ih y
    have hp : 0<(A*feature A l) x r := by
      rw [Matrix.mul_apply]
      apply (mul_pos hxy hr).trans_le
      exact single_le_sum (fun y hy => mul_nonneg (hA x y) (feature_nonneg hA l y r)) (mem_univ y)
    refine ⟨fun _ => r,?_⟩
    change 0<∏_i : Fin s, (A*feature A l) x r
    exact prod_pos (fun i hi => hp)

lemma kernel_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y) (l : List ℕ) (x y : W) :
    0≤branchKernel A l x y := by
  classical
  exact GramWalkMoments.kernel_nonneg (feature_nonneg hA l) x y

lemma kernel_isSymm (A : Matrix W W ℝ) (l : List ℕ) : (branchKernel A l).IsSymm :=
  kernel_symm (feature A l)

variable [DecidableEq W]

/-- The full root-agreement energy with an additional rooted arm of length L. -/
noncomputable def energy (A : Matrix W W ℝ) (l : List ℕ) (L : ℕ) : ℝ :=
  GramWalkMoments.moment A (feature A l) L

lemma energy_expansion (A : Matrix W W ℝ) (l : List ℕ) (L : ℕ) :
    energy A l L=∑x, ∑y, (A^(2*L)) x y*branchKernel A l y x :=
  GramWalkMoments.kernel_expansion A (feature A l) L

lemma energy_sq {A : Matrix W W ℝ} (hs : A.IsSymm) (l : List ℕ) (L : ℕ) :
    energy A l L=∑r, ∑x, ((A^L*feature A l) x r)^2 :=
  (GramWalkMoments.sum_sq hs (feature A l) L).symm

lemma energy_logconvex {A : Matrix W W ℝ} (hs : A.IsSymm) (l : List ℕ) (L : ℕ) :
    energy A l (L+1)^2≤energy A l L*energy A l (L+2) :=
  GramWalkMoments.logconvex hs (feature A l) L

/-- The pendant-arm propagation estimate applies at every depth and branching pattern. -/
theorem terminal_propagation [Nonempty W] {A : Matrix W W ℝ} (hs : A.IsSymm)
    (hA : ∀x y, 0≤A x y) (hn : ∀x, ∃y, 0<A x y)
    {d D : ℝ} (hd : 0<d) (hD : 0≤D)
    (hdeg : ∀x, d≤EvenWalkMoments.point A 1 x ∧ EvenWalkMoments.point A 1 x≤D)
    (l : List ℕ) (k : ℕ) :
    (d*GramWalkMoments.terminal A (feature A l) k)^(k+1)≤D^(k+1)*
      GramWalkMoments.attachment A (feature A l) (k+1)*energy A l (k+1)^k := by
  obtain ⟨x⟩ := ‹Nonempty W›
  obtain ⟨r,hr⟩ := feature_pos_some hA hn l x
  exact GramWalkMoments.terminal_propagation hs hA (feature_nonneg hA l) ⟨x,r,hr⟩ hd hD hdeg k

end Erdos571.LayeredGramKernels

/-! Sharp degree-based lower energy for all homogeneous tree shapes. -/
namespace Erdos571.GramFeatures
open Finset Matrix
variable {W I : Type*} [Fintype W] [Fintype I]

lemma branch_row_sum (F : Matrix W I ℝ) (s : ℕ) (x : W) :
    (∑r, branch F s x r)=(∑r, F x r)^s := by
  unfold branch
  rw [←Fintype.prod_sum (fun _ : Fin s => fun z : I => F x z)]
  simp only [prod_const,card_univ,Fintype.card_fin]

lemma chain_row_sum (A : Matrix W W ℝ) (F : Matrix W I ℝ) (x : W) :
    (∑r, (A*F) x r)=∑y, A x y*(∑r, F y r) := by
  simp only [Matrix.mul_apply]
  rw [sum_comm]
  simp only [mul_sum]

lemma chain_row_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {F : Matrix W I ℝ} {d b : ℝ} (hb : 0≤b)
    (hrow : ∀x, d≤∑y, A x y) (hF : ∀x, b≤∑r, F x r) (x : W) :
    d*b≤∑r, (A*F) x r := by
  rw [chain_row_sum]
  calc
    _ ≤ (∑y, A x y)*b := mul_le_mul_of_nonneg_right (hrow x) hb
    _ = ∑y, A x y*b := sum_mul _ _ _
    _ ≤ _ := sum_le_sum (fun y hy => mul_le_mul_of_nonneg_left (hF y) (hA x y))

lemma chain_row_upper {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {F : Matrix W I ℝ} {D B : ℝ} (hB : 0≤B)
    (hrow : ∀x, (∑y, A x y)≤D) (hF : ∀x, (∑r, F x r)≤B) (x : W) :
    (∑r, (A*F) x r)≤D*B := by
  rw [chain_row_sum]
  calc
    _ ≤ ∑y, A x y*B := sum_le_sum (fun y hy => mul_le_mul_of_nonneg_left (hF y) (hA x y))
    _ = (∑y, A x y)*B := (sum_mul _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right (hrow x) hB

end Erdos571.GramFeatures

namespace Erdos571.LayeredGramKernels
open Finset Matrix GramFeatures
variable {W : Type*} [Fintype W]

/-- Number of edges below the attachment vertex, excluding the additional rooted arm. -/
def cost : List ℕ → ℕ
  | [] => 1
  | s::l => s*(cost l+1)

lemma cost_succ (l : List ℕ) : cost l+1=LayeredTrees.edges l := by
  induction l with
  | nil => rfl
  | cons s l ih => simp only [cost,LayeredTrees.edges,←ih]; omega

lemma feature_row_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {d : ℝ} (hd : 0≤d) (hrow : ∀x, d≤∑y, A x y) (l : List ℕ) (x : W) :
    d^cost l≤∑r, feature A l x r := by
  induction l generalizing x with
  | nil => simpa only [feature,cost,pow_one] using hrow x
  | cons s l ih =>
    change d^(s*(cost l+1))≤∑r, branch (A*feature A l) s x r
    rw [branch_row_sum,show s*(cost l+1)=(cost l+1)*s by ring,pow_mul]
    apply pow_le_pow_left₀ (pow_nonneg hd _)
    rw [pow_succ']
    exact chain_row_lower hA (pow_nonneg hd _) hrow ih x

lemma feature_row_upper {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {D : ℝ} (hD : 0≤D) (hrow : ∀x, (∑y, A x y)≤D) (l : List ℕ) (x : W) :
    (∑r, feature A l x r)≤D^cost l := by
  induction l generalizing x with
  | nil => simpa only [feature,cost,pow_one] using hrow x
  | cons s l ih =>
    change (∑r, branch (A*feature A l) s x r)≤D^(s*(cost l+1))
    rw [branch_row_sum,show s*(cost l+1)=(cost l+1)*s by ring,pow_mul]
    apply pow_le_pow_left₀ (sum_nonneg (fun r hr => chain_nonneg hA (feature_nonneg hA l) x r))
    rw [pow_succ']
    exact chain_row_upper hA (pow_nonneg hD _) hrow ih x

variable [DecidableEq W]

lemma full_row_lower {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {d : ℝ} (hd : 0≤d) (hrow : ∀x, d≤∑y, A x y) (l : List ℕ) (L : ℕ) (x : W) :
    d^(L+cost l)≤∑r, (A^L*feature A l) x r := by
  rw [pow_add]
  exact chain_row_lower (Matrix.pow_apply_nonneg hA L) (pow_nonneg hd _)
    (EvenWalkMoments.row_sum_lower hA hd hrow L) (feature_row_lower hA hd hrow l) x

lemma power_row_upper {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {D : ℝ} (hD : 0≤D) (hrow : ∀x, (∑y, A x y)≤D) (L : ℕ) (x : W) :
    (∑y, (A^L) x y)≤D^L := by
  induction L generalizing x with
  | zero => simp [Matrix.one_apply]
  | succ L ih =>
    rw [pow_succ',pow_succ']
    exact chain_row_upper hA (pow_nonneg hD _) hrow ih x

lemma full_row_upper {A : Matrix W W ℝ} (hA : ∀x y, 0≤A x y)
    {D : ℝ} (hD : 0≤D) (hrow : ∀x, (∑y, A x y)≤D) (l : List ℕ) (L : ℕ) (x : W) :
    (∑r, (A^L*feature A l) x r)≤D^(L+cost l) := by
  rw [pow_add]
  exact chain_row_upper (Matrix.pow_apply_nonneg hA L) (pow_nonneg hD _)
    (power_row_upper hA hD hrow L) (feature_row_upper hA hD hrow l) x

/-- All leaf-label fibers together retain the sharp tree second-moment lower bound. -/
theorem energy_lower {A : Matrix W W ℝ} (hs : A.IsSymm) (hA : ∀x y, 0≤A x y)
    {d : ℝ} (hd : 0≤d) (hrow : ∀x, d≤∑y, A x y) (l : List ℕ) (L : ℕ) :
    ((Fintype.card W:ℝ)*d^(L+cost l))^2≤(Fintype.card W:ℝ)^(l.prod+1)*energy A l L := by
  have hl : (Fintype.card W:ℝ)*d^(L+cost l)≤∑x, ∑r, (A^L*feature A l) x r := by
    calc
      _ = ∑_x : W, d^(L+cost l) := by simp only [sum_const,card_univ,nsmul_eq_mul]
      _ ≤ _ := sum_le_sum (fun x hx => full_row_lower hA hd hrow l L x)
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (W×Labels W l)))
    (f := fun p => (A^L*feature A l) p.1 p.2)
  simp only [card_univ,Fintype.card_prod,labels_card,Nat.cast_mul,Nat.cast_pow,Fintype.sum_prod_type] at hc
  have he : (∑x, ∑r, ((A^L*feature A l) x r)^2)=energy A l L := by
    rw [sum_comm,energy_sq hs]
  rw [he,←pow_succ'] at hc
  exact (pow_le_pow_left₀ (by positivity) hl 2).trans hc

end Erdos571.LayeredGramKernels

/-! Finite branching assignments realizing the recursive matrix features. -/
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

/-- A branching assignment with prescribed attachment and leaf labels.
Repeated vertices are intentionally retained. -/
def Assignment : (l : List ℕ) → W → Labels W l → Type _
  | [],x,r => PLift (G.Adj x r)
  | s::l,x,r => (i : Fin s) → (y : W) × (PLift (G.Adj x y)×Assignment l y (r i))

instance [Fintype W] [DecidableRel G.Adj] (l : List ℕ) (x : W) (r : Labels W l) :
    Fintype (Assignment G l x r) := by
  induction l generalizing x with
  | nil => exact inferInstanceAs (Fintype (PLift (G.Adj x r)))
  | cons s l ih =>
    letI : ∀y r, Fintype (Assignment G l y r) := ih
    exact inferInstanceAs (Fintype ((i : Fin s) → (y : W) ×
      (PLift (G.Adj x y)×Assignment G l y (r i))))

/-- Read a leaf label in the uncurried vertex indexing of LayeredTrees. -/
def leafValue : (l : List ℕ) → Labels W l → Leaves l → W
  | [],r,_ => r
  | _::l,r,p => leafValue l (r p.1) p.2

/-- Read the image of any interior vertex from a branching assignment. -/
def interiorValue : (l : List ℕ) → {x : W} → {r : Labels W l} →
    Assignment G l x r → Interior l → W
  | [],x,_,_,_ => x
  | _::_,x,_,_,none => x
  | _::l,_,_,a,some p => interiorValue l (a p.1).2.2 p.2

@[simp] lemma interior_anchor (l : List ℕ) {x : W} {r : Labels W l} (a : Assignment G l x r) :
    interiorValue G l a (anchor l)=x := by cases l <;> rfl

lemma interior_preserving (l : List ℕ) {x : W} {r : Labels W l} (a : Assignment G l x r) :
    ∀{u v}, (core l).Adj u v → G.Adj (interiorValue G l a u) (interiorValue G l a v) := by
  induction l generalizing x with
  | nil => intro u v h; exact h.elim
  | cons s l ih =>
    intro u v h
    cases u with
    | none => cases v with
      | none => exact h.elim
      | some p =>
        change p.2=anchor l at h
        change G.Adj x (interiorValue G l (a p.1).2.2 p.2)
        rw [h,interior_anchor]
        exact (a p.1).2.1.down
    | some p => cases v with
      | none =>
        change p.2=anchor l at h
        change G.Adj (interiorValue G l (a p.1).2.2 p.2) x
        rw [h,interior_anchor]
        exact (a p.1).2.1.down.symm
      | some q =>
        obtain ⟨he,h⟩ := h
        change p.1=q.1 at he
        rcases p with ⟨i,u⟩
        rcases q with ⟨j,v⟩
        dsimp only at he
        subst j
        exact ih (a i).2.2 h

lemma leaf_preserving (l : List ℕ) {x : W} {r : Labels W l} (a : Assignment G l x r) :
    ∀v : Leaves l, G.Adj (interiorValue G l a (attach l v)) (leafValue l r v) := by
  induction l generalizing x with
  | nil => intro v; exact a.down
  | cons s l ih => intro v; exact ih (a v.1).2.2 v.2

/-- Add the distinguished root adjacent to the top attachment. -/
def hom (l : List ℕ) {x : W} {r : Labels W l} (a : Assignment G l x r)
    (z : W) (hz : G.Adj z x) : template l →g G where
  toFun := Sum.elim (interiorValue G l a) (fun v => v.elim z (leafValue l r))
  map_rel' := by
    rintro (u|u) (v|v) h
    · exact interior_preserving G l a h
    · change u=rootAttach l v at h
      subst u
      cases v with
      | none => simpa only [Sum.elim_inl,Sum.elim_inr,rootAttach,Option.elim_none,interior_anchor] using hz.symm
      | some v => exact leaf_preserving G l a v
    · change v=rootAttach l u at h
      subst v
      cases u with
      | none => simpa only [Sum.elim_inl,Sum.elim_inr,rootAttach,Option.elim_none,interior_anchor] using hz
      | some u => exact (leaf_preserving G l a u).symm
    · exact h.elim

lemma card_assignment [Fintype W] [DecidableRel G.Adj] (l : List ℕ) (x : W) (r : Labels W l) :
    (Fintype.card (Assignment G l x r):ℝ)=feature (G.adjMatrix ℝ) l x r := by
  induction l generalizing x with
  | nil =>
    change (Fintype.card (PLift (G.Adj x r)):ℝ)=G.adjMatrix ℝ x r
    by_cases h : G.Adj x r
    · letI : Fact (G.Adj x r) := ⟨h⟩
      letI : Unique (PLift (G.Adj x r)) := {default := ⟨h⟩,uniq := fun _ => Subsingleton.elim _ _}
      simp only [Fintype.card_unique,Nat.cast_one,SimpleGraph.adjMatrix_apply,if_pos h]
    · letI : IsEmpty (PLift (G.Adj x r)) := ⟨fun a => h a.down⟩
      simp only [Fintype.card_eq_zero,Nat.cast_zero,SimpleGraph.adjMatrix_apply,if_neg h]
  | cons s l ih =>
    change (Fintype.card ((i : Fin s) → (y : W) ×
      (PLift (G.Adj x y)×Assignment G l y (r i))):ℝ)=_
    simp only [Fintype.card_pi,Fintype.card_sigma,Fintype.card_prod,Nat.cast_prod,Nat.cast_sum,Nat.cast_mul]
    change (∏i : Fin s, ∑y : W, (Fintype.card (PLift (G.Adj x y)):ℝ)*
      (Fintype.card (Assignment G l y (r i)):ℝ))=∏i : Fin s, ((G.adjMatrix ℝ)*feature (G.adjMatrix ℝ) l) x (r i)
    apply prod_congr rfl
    intro i hi
    rw [Matrix.mul_apply]
    apply sum_congr rfl
    intro y hy
    rw [ih]
    congr 1
    by_cases h : G.Adj x y
    · letI : Unique (PLift (G.Adj x y)) := {default := ⟨h⟩,uniq := fun _ => Subsingleton.elim _ _}
      simp only [Fintype.card_unique,Nat.cast_one,SimpleGraph.adjMatrix_apply,if_pos h]
    · letI : IsEmpty (PLift (G.Adj x y)) := ⟨fun a => h a.down⟩
      simp only [Fintype.card_eq_zero,Nat.cast_zero,SimpleGraph.adjMatrix_apply,if_neg h]

end Erdos571.LayeredAssignments

/-! Root-agreement pairs of layered tree homomorphisms have the Gram energy. -/
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

lemma leafValue_injective (l : List ℕ) : Function.Injective (leafValue (W:=W) l) := by
  induction l with
  | nil => intro r s h; exact congrFun h ()
  | cons k l ih =>
    intro r s h
    funext i
    apply ih
    funext a
    exact congrFun h (i,a)

lemma assignment_ext (l : List ℕ) {x : W} {r : Labels W l} (a b : Assignment G l x r)
    (h : ∀u, interiorValue G l a u=interiorValue G l b u) : a=b := by
  induction l generalizing x with
  | nil => exact Subsingleton.elim (α:=PLift (G.Adj x r)) _ _
  | cons k l ih =>
    funext i
    have hh (u : Interior l) : interiorValue G l (a i).2.2 u=interiorValue G l (b i).2.2 u :=
      h (some (i,u))
    have hy : (a i).1=(b i).1 := by simpa only [interior_anchor] using hh (anchor l)
    rcases ha : a i with ⟨y,p,c⟩
    rcases hb : b i with ⟨y',p',c'⟩
    rw [ha,hb] at hy hh
    dsimp only at hy hh
    subst y'
    refine Sigma.ext rfl ?_
    apply heq_of_eq
    apply Prod.ext (Subsingleton.elim _ _)
    exact ih c c' hh

abbrev Fiber (l : List ℕ) (z : W) (r : Labels W l) :=
  (x : W) × (PLift (G.Adj z x)×Assignment G l x r)

abbrev Full (l : List ℕ) :=
  (r : W×Labels W l) × Fiber G l r.1 r.2

def fiberHom (l : List ℕ) {z : W} {r : Labels W l} (p : Fiber G l z r) : template l →g G :=
  hom G l p.2.2 z p.2.1.down

def fullHom (l : List ℕ) (p : Full G l) : template l →g G := fiberHom G l p.2

lemma fiberHom_injective (l : List ℕ) (z : W) (r : Labels W l) :
    Function.Injective (fiberHom G l (z:=z) (r:=r)) := by
  intro p q he
  have hx : p.1=q.1 := by
    have h := congrArg (fun f : template l →g G => f (.inl (anchor l))) he
    change interiorValue G l p.2.2 (anchor l)=interiorValue G l q.2.2 (anchor l) at h
    simpa only [interior_anchor] using h
  rcases p with ⟨x,hp,a⟩
  rcases q with ⟨x',hq,b⟩
  dsimp only at hx
  subst x'
  refine Sigma.ext rfl ?_
  apply heq_of_eq
  apply Prod.ext (Subsingleton.elim _ _)
  apply assignment_ext G l a b
  intro u
  exact congrArg (fun f : template l →g G => f (.inl u)) he

lemma fullHom_injective (l : List ℕ) : Function.Injective (fullHom G l) := by
  intro p q he
  have hz : p.1.1=q.1.1 := congrArg (fun f : template l →g G => f (.inr none)) he
  have hr : p.1.2=q.1.2 := by
    apply leafValue_injective l
    funext a
    exact congrArg (fun f : template l →g G => f (.inr (some a))) he
  have hroot : p.1=q.1 := Prod.ext hz hr
  rcases p with ⟨r,p⟩
  rcases q with ⟨r',q⟩
  dsimp only at hroot
  subst r'
  refine Sigma.ext rfl ?_
  exact heq_of_eq (fiberHom_injective G l r.1 r.2 he)

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

lemma card_fiber (l : List ℕ) (z : W) (r : Labels W l) :
    (Fintype.card (Fiber G l z r):ℝ)=((G.adjMatrix ℝ)*feature (G.adjMatrix ℝ) l) z r := by
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,Matrix.mul_apply]
  apply sum_congr rfl
  intro x hx
  rw [card_assignment]
  congr 1
  by_cases h : G.Adj z x
  · letI : Unique (PLift (G.Adj z x)) := {default := ⟨h⟩,uniq := fun _ => Subsingleton.elim _ _}
    simp only [Fintype.card_unique,Nat.cast_one,SimpleGraph.adjMatrix_apply,if_pos h]
  · letI : IsEmpty (PLift (G.Adj z x)) := ⟨fun a => h a.down⟩
    simp only [Fintype.card_eq_zero,Nat.cast_zero,SimpleGraph.adjMatrix_apply,if_neg h]

abbrev Agreement (l : List ℕ) := {p : Full G l×Full G l // p.1.1=p.2.1}

def agreementEquiv (l : List ℕ) : Agreement G l ≃
    ((r : W×Labels W l) × (Fiber G l r.1 r.2×Fiber G l r.1 r.2)) where
  toFun e := by
    rcases e with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he⟩
    change r=s at he
    subst s
    exact ⟨r,p,q⟩
  invFun e := ⟨(⟨e.1,e.2.1⟩,⟨e.1,e.2.2⟩),rfl⟩
  left_inv e := by
    rcases e with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he⟩
    change r=s at he
    subst s
    rfl
  right_inv e := by rcases e with ⟨r,p,q⟩; rfl

open Classical in
lemma agreement_card (l : List ℕ) :
    (Fintype.card (Agreement G l):ℝ)=energy (G.adjMatrix ℝ) l 1 := by
  classical
  rw [Fintype.card_congr (agreementEquiv G l)]
  rw [Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow]
  simp_rw [card_fiber]
  rw [energy_sq G.isSymm_adjMatrix]
  simp only [pow_one,Fintype.sum_prod_type]
  rw [sum_comm]

end Erdos571.LayeredAssignments

/-! Retained second moments for all rooted homomorphisms, including noninjective ones. -/
namespace Erdos571.RootedHomEnergy
open Finset SimpleGraph RootedPacking
variable {A R W I J : Type*} [Fintype A] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

noncomputable def interior (f : H →g G) : Finset W := univ.image (fun a => f (.inl a))

def Conflict (f g : H →g G) : Prop :=
  ¬(Function.Injective f ∧ Function.Injective g ∧ Disjoint (interior f) (interior g))

lemma conflict_refl [Nonempty A] (f : H →g G) : Conflict f f := by
  intro h
  have hn : (interior f).Nonempty := Finset.Nonempty.image univ_nonempty _
  exact hn.ne_empty (disjoint_self.mp h.2.2)

lemma conflict_symm {f g : H →g G} (h : Conflict f g) : Conflict g f := by
  intro h'
  exact h ⟨h'.2.1,h'.1,h'.2.2.symm⟩

/-- An independent family of rooted homomorphisms automatically gives genuine disjoint copies. -/
lemma contains_of_packing (S : Finset I) (f : I → H →g G) (M : ℕ) (hM : 0<M)
    (hcard : S.card=M) (hgood : ∀i∈S, Function.Injective (f i))
    (hroot : ∀i∈S, ∀j∈S, ∀r : R, f i (.inr r)=f j (.inr r))
    (hdis : ∀i∈S, ∀j∈S, i≠j → Disjoint (interior (f i)) (interior (f j))) :
    FullRootedPower.graph H M ⊑ G := by
  classical
  obtain ⟨i₀,hi₀⟩ := card_pos.mp (by omega : 0<S.card)
  let roots : R ↪ W := ⟨fun r => f i₀ (.inr r),(hgood i₀ hi₀).comp Sum.inr_injective⟩
  let e : Fin M ≃ S := Fintype.equivOfCardEq (by simpa only [Fintype.card_coe,Fintype.card_fin] using hcard.symm)
  let c : Fin M → H.Copy G := fun i => ⟨f (e i),hgood (e i) (e i).property⟩
  refine ⟨FullRootedPacking.powerCopy M hM roots c ?_ ?_⟩
  · intro i r
    exact hroot (e i) (e i).property i₀ hi₀ r
  · intro i j hij
    have hfoot (i : Fin M) : RootedPacking.interior (c i)=interior (f (e i)) := by
      ext w
      simp only [RootedPacking.interior,interior,mem_image,mem_univ,true_and]
      rfl
    rw [hfoot,hfoot]
    exact hdis (e i) (e i).property (e j) (e j).property
      (fun he => hij (e.injective (Subtype.ext he)))

variable [DecidableEq I] [DecidableEq J]

lemma no_packing (F : Finset I) (f : I → H →g G) (label : I → J)
    (hroot : ∀i∈F, ∀j∈F, label i=label j → ∀r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2≤M) (hf : (FullRootedPower.graph H M).Free G) (r : J) :
    ¬∃S⊆F.filter (fun i => label i=r), S.card=M ∧
      ∀i∈S, ∀j∈S, i≠j → ¬Conflict (f i) (f j) := by
  classical
  rintro ⟨S,hSF,hS,hdis⟩
  apply hf (contains_of_packing S f M (by omega) hS ?_ ?_ ?_)
  · intro i hi
    obtain ⟨j,hj,hji⟩ := exists_mem_ne (by omega : 1<S.card) i
    exact (not_not.mp (hdis i hi j hj hji.symm)).1
  · intro i hi j hj a
    have hiF := mem_filter.mp (hSF hi)
    have hjF := mem_filter.mp (hSF hj)
    exact hroot i hiF.1 j hjF.1 (hiF.2.trans hjF.2.symm) a
  · intro i hi j hj hij
    exact (not_not.mp (hdis i hi j hj hij)).2.2

open Classical in
/-- No preliminary deletion of noninjective homomorphisms is required. -/
theorem weighted_bound [Nonempty A] (F : Finset I) (f : I → H →g G) (label : I → J)
    (hroot : ∀i∈F, ∀j∈F, label i=label j → ∀r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2≤M) (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑e∈PackingEnergy.fiberPairs F label (fun _ _ => True), w e.1*w e.2)≤
      (M-1:ℕ)*(∑e∈PackingEnergy.fiberPairs F label (fun i j => Conflict (f i) (f j)), w e.1*w e.2) := by
  classical
  rw [←PackingEnergy.sum_fiber_mass_sq]
  exact PackingEnergy.weighted_fiber_second_moment F label (fun i j => Conflict (f i) (f j))
    (fun i hi => conflict_refl _) (fun i hi j hj => conflict_symm) M hM
    (no_packing F f label hroot M hM hf) w hw

open Classical in
theorem pair_bound [Nonempty A] (F : Finset I) (f : I → H →g G) (label : I → J)
    (hroot : ∀i∈F, ∀j∈F, label i=label j → ∀r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2≤M) (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs F label (fun _ _ => True)).card≤
      (M-1)*(PackingEnergy.fiberPairs F label (fun i j => Conflict (f i) (f j))).card := by
  have h := weighted_bound F f label hroot M hM hf (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

end Erdos571.RootedHomEnergy

/-! Ordinary rooted-power freeness forces collision energy in every layered tree. -/
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev Conflicting (l : List ℕ) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧ RootedHomEnergy.Conflict (fullHom G l p.1) (fullHom G l p.2)}

lemma same_roots (l : List ℕ) (p q : Full G l) (he : p.1=q.1) (r : Option (Leaves l)) :
    fullHom G l p (.inr r)=fullHom G l q (.inr r) := by
  cases r with
  | none => exact congrArg Prod.fst he
  | some r => exact congrArg (fun t => leafValue l t.2 r) he

open Classical in
theorem pair_bound (l : List ℕ) (M : ℕ) (hM : 2≤M) (hf : (graph l M).Free G) :
    Fintype.card (Agreement G l)≤(M-1)*Fintype.card (Conflicting G l) := by
  classical
  let label : Full G l → W×Labels W l := Sigma.fst
  let conflict : Full G l → Full G l → Prop := fun p q =>
    RootedHomEnergy.Conflict (fullHom G l p) (fullHom G l q)
  have h := RootedHomEnergy.pair_bound (univ : Finset (Full G l)) (fullHom G l) label
    (fun p hp q hq he r => same_roots G l p q he r) M hM hf
  have ha : (PackingEnergy.fiberPairs (univ : Finset (Full G l)) label (fun _ _ => True)).card=
      Fintype.card (Agreement G l) := by
    rw [Fintype.card_subtype]
    congr 1
    ext e
    simp only [PackingEnergy.fiberPairs,mem_filter,mem_product,mem_univ,true_and,and_true,label]
  have hc : (PackingEnergy.fiberPairs (univ : Finset (Full G l)) label conflict).card=
      Fintype.card (Conflicting G l) := by
    rw [Fintype.card_subtype]
    congr 1
  rwa [ha,hc] at h

open Classical in
/-- The exact recursively computed Gram energy must be paid for by conflicts. -/
theorem energy_le_conflicts (l : List ℕ) (M : ℕ) (hM : 2≤M) (hf : (graph l M).Free G) :
    energy (G.adjMatrix ℝ) l 1≤((M-1:ℕ):ℝ)*Fintype.card (Conflicting G l) := by
  have he : (Fintype.card (Agreement G l):ℝ)=energy (G.adjMatrix ℝ) l 1 := by
    convert agreement_card G l using 1
  rw [←he]
  exact_mod_cast pair_bound G l M hM hf

end Erdos571.LayeredAssignments

/-! Cross-position collisions reduce to same-position pinning by Cauchy-Schwarz. -/
namespace Erdos571.MarginalCollisionEnergy
open Finset
variable {I J : Type*} [DecidableEq I] [Fintype J] [DecidableEq J]

noncomputable def fiberMass (F : Finset I) (label : I → J) (w : I → ℝ) (r : J) : ℝ :=
  by classical exact ∑i∈F, if label i=r then w i else 0

noncomputable def pairMass (F : Finset I) (left right : I → J) (w : I → ℝ) : ℝ :=
  by classical exact ∑i∈F, ∑j∈F, if left i=right j then w i*w j else 0

lemma pairMass_fibers (F : Finset I) (left right : I → J) (w : I → ℝ) :
    pairMass F left right w=∑r, fiberMass F left w r*fiberMass F right w r := by
  unfold pairMass fiberMass
  simp_rw [sum_mul_sum]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro i hi
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro j hj
  by_cases he : left i=right j
  · rw [if_pos he]
    simp only [he,ite_mul,mul_ite,zero_mul,mul_zero]
    simp
  · rw [if_neg he]
    have hz (r : J) : (if left i=r then w i else 0)*(if right j=r then w j else 0)=0 := by
      split_ifs with h h' <;> first | exact (he (h.trans h'.symm)).elim | ring
    simp only [hz,sum_const_zero]

lemma two_cross_le (F : Finset I) (left right : I → J) (w : I → ℝ) :
    2*pairMass F left right w≤ pairMass F left left w+pairMass F right right w := by
  rw [pairMass_fibers,pairMass_fibers,pairMass_fibers,mul_sum,←sum_add_distrib]
  apply sum_le_sum
  intro r hr
  nlinarith [sq_nonneg (fiberMass F left w r-fiberMass F right w r)]

lemma pairMass_nonneg (F : Finset I) (left right : I → J) (w : I → ℝ)
    (hw : ∀i∈F, 0≤ w i) : 0≤ pairMass F left right w := by
  apply sum_nonneg
  intro i hi
  apply sum_nonneg
  intro j hj
  split_ifs
  · exact mul_nonneg (hw i hi) (hw j hj)
  · exact le_rfl

variable {A : Type*} [Fintype A]

lemma sum_cross_le (F : Finset I) (label : A → I → J) (w : I → ℝ) :
    (∑a, ∑b, pairMass F (label a) (label b) w)≤
      (Fintype.card A:ℝ)*(∑a, pairMass F (label a) (label a) w) := by
  have h : 2*(∑a, ∑b, pairMass F (label a) (label b) w)≤
      2*(Fintype.card A:ℝ)*(∑a, pairMass F (label a) (label a) w) := by
    calc
      _ = ∑a, ∑b, 2*pairMass F (label a) (label b) w := by simp only [mul_sum]
      _ ≤ ∑a, ∑b, (pairMass F (label a) (label a) w+pairMass F (label b) (label b) w) :=
        sum_le_sum (fun a ha => sum_le_sum (fun b hb => two_cross_le F (label a) (label b) w))
      _ = _ := by
        simp only [sum_add_distrib,sum_const,card_univ,nsmul_eq_mul,←mul_sum]
        ring
  linarith

open Classical in
/-- Any collision relation witnessed by equality of two (possibly different)
position labels is controlled by same-position marginal energies. -/
theorem covered_pairs_bound (F : Finset I) (label : A → I → J)
    (R : I → I → Prop) (hcover : ∀i∈F, ∀j∈F, R i j → ∃a b, label a i=label b j)
    (w : I → ℝ) (hw : ∀i∈F, 0≤ w i) :
    (∑e∈(F×ˢF).filter (fun e => R e.1 e.2), w e.1*w e.2)≤
      (Fintype.card A:ℝ)*(∑a, pairMass F (label a) (label a) w) := by
  classical
  have hnonneg (e : I×I) (he : e∈F×ˢF) (p : A×A) :
      0≤ if label p.1 e.1=label p.2 e.2 then w e.1*w e.2 else 0 := by
    split_ifs
    · exact mul_nonneg (hw _ (mem_product.mp he).1) (hw _ (mem_product.mp he).2)
    · exact le_rfl
  have h : (∑e∈(F×ˢF).filter (fun e => R e.1 e.2), w e.1*w e.2)≤
      ∑e∈F×ˢF, ∑p : A×A, if label p.1 e.1=label p.2 e.2 then w e.1*w e.2 else 0 := by
    rw [sum_filter]
    apply sum_le_sum
    intro e he
    by_cases hr : R e.1 e.2
    · rw [if_pos hr]
      obtain ⟨a,b,hab⟩ := hcover _ (mem_product.mp he).1 _ (mem_product.mp he).2 hr
      have hs := single_le_sum (fun p hp => hnonneg e he p) (mem_univ (a,b))
      simpa only [hab,ite_true] using hs
    · rw [if_neg hr]
      exact sum_nonneg (fun p hp => hnonneg e he p)
  apply h.trans
  calc
    _ = ∑p : A×A, pairMass F (label p.1) (label p.2) w := by
      rw [sum_comm]
      apply sum_congr rfl
      intro p hp
      rw [sum_product]
      rfl
    _ = ∑a, ∑b, pairMass F (label a) (label b) w := Fintype.sum_prod_type _
    _ ≤ _ := sum_cross_le F label w

end Erdos571.MarginalCollisionEnergy

/-! Weighted overlap energy needs only single-position pinning, with no role coloring. -/
namespace Erdos571.RootedCollisionEnergy
open Finset SimpleGraph RootedPacking MarginalCollisionEnergy
variable {I A R W : Type*} [DecidableEq I] [Fintype A] [Fintype R] [Fintype W] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

def pinLabel (f : I → H.Copy G) (a : A) (i : I) : (R → W)×W := (labels f i,f i (.inl a))

/-- Ordered pairs agreeing at the original roots and at one fixed interior position. -/
noncomputable def pinned (F : Finset I) (f : I → H.Copy G) (a : A) : Finset (I×I) := by
  classical
  exact PackingEnergy.fiberPairs F (pinLabel f a) (fun _ _ => True)

lemma pinned_mass (F : Finset I) (f : I → H.Copy G) (a : A) (w : I → ℝ) :
    (∑e∈pinned F f a, w e.1*w e.2)=pairMass F (pinLabel f a) (pinLabel f a) w := by
  classical
  simp only [pinned,PackingEnergy.fiberPairs,sum_filter,and_true,sum_product,pairMass]

/-- Cross-position overlap costs only a factor |A| beyond same-position overlap. -/
theorem collisions_le_single_pins (F : Finset I) (f : I → H.Copy G) (w : I → ℝ)
    (hw : ∀i∈F, 0≤w i) :
    (∑e∈collisions F f, w e.1*w e.2)≤
      (Fintype.card A:ℝ)*(∑a, ∑e∈pinned F f a, w e.1*w e.2) := by
  classical
  have h := covered_pairs_bound F (pinLabel f)
    (fun i j => labels f i=labels f j ∧ ¬Disjoint (interior (f i)) (interior (f j))) (by
      intro i hi j hj hij
      obtain ⟨v,hvi,hvj⟩ := Finset.not_disjoint_iff.mp hij.2
      simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hvi hvj
      obtain ⟨a,hav⟩ := hvi
      obtain ⟨b,hbv⟩ := hvj
      exact ⟨a,b,Prod.ext hij.1 (hav.trans hbv.symm)⟩) w hw
  have he : collisions F f=(F×ˢF).filter
      (fun e => labels f e.1=labels f e.2 ∧ ¬Disjoint (interior (f e.1)) (interior (f e.2))) := by
    ext e
    simp only [collisions,PackingEnergy.fiberPairs,mem_filter,mem_product]
  rw [he]
  simp_rw [pinned_mass]
  convert h using 1
  apply sum_congr ?_ (fun _ _ => rfl)
  ext e
  simp only [mem_filter,mem_product]

/-- A power-free host has large same-position collision energy in at least
one interior role. This retains the full second moment and requires no coloring. -/
theorem weighted_single_pin_bound [Nonempty A] (F : Finset I) (f : I → H.Copy G)
    (M : ℕ) (hM : 2≤M) (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0≤w i) :
    (∑e∈agreements F f, w e.1*w e.2)≤
      ((M-1:ℕ):ℝ)*(Fintype.card A:ℝ)*(∑a, ∑e∈pinned F f a, w e.1*w e.2) := by
  have h := weighted_second_moment_bound F f M hM hf w hw
  have hc := mul_le_mul_of_nonneg_left (collisions_le_single_pins F f w hw)
    (show (0:ℝ)≤(M-1:ℕ) by positivity)
  exact h.trans (by simpa only [mul_assoc] using hc)

lemma single_pin_bound [Nonempty A] (F : Finset I) (f : I → H.Copy G)
    (M : ℕ) (hM : 2≤M) (hf : (FullRootedPower.graph H M).Free G) :
    (agreements F f).card≤(M-1)*Fintype.card A*(∑a, (pinned F f a).card) := by
  have h := weighted_single_pin_bound F f M hM hf (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

end Erdos571.RootedCollisionEnergy

/-! Recursive assignments and ordinary homomorphisms of the layered tree are equivalent. -/
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

def labelsOf : (l : List ℕ) → (Leaves l → W) → Labels W l
  | [],f => f ()
  | _::l,f => fun i => labelsOf l (fun a => f (i,a))

lemma leafValue_labelsOf (l : List ℕ) (f : Leaves l → W) : leafValue l (labelsOf l f)=f := by
  induction l with
  | nil => funext a; cases a; rfl
  | cons s l ih =>
    funext a
    exact congrFun (ih (fun b => f (a.1,b))) a.2

lemma labelsOf_leafValue (l : List ℕ) (r : Labels W l) : labelsOf l (leafValue l r)=r :=
  leafValue_injective l (leafValue_labelsOf l (leafValue l r))

/-- Recover the branching choices from any edge-preserving vertex assignment. -/
def ofMap : (l : List ℕ) → (v : Interior l → W) → (r : Labels W l) →
    (∀{a b}, (core l).Adj a b → G.Adj (v a) (v b)) →
    (∀a, G.Adj (v (attach l a)) (leafValue l r a)) → Assignment G l (v (anchor l)) r
  | [],v,r,hc,hr => ⟨hr ()⟩
  | s::l,v,r,hc,hr => fun i =>
    ⟨v (some (i,anchor l)),⟨hc (by change anchor l=anchor l; rfl)⟩,
      ofMap l (fun a => v (some (i,a))) (r i)
        (fun h => hc ⟨rfl,h⟩) (fun a => hr (i,a))⟩

lemma interior_ofMap (l : List ℕ) (v : Interior l → W) (r : Labels W l) (hc hr) :
    interiorValue G l (ofMap G l v r hc hr)=v := by
  induction l with
  | nil => funext a; cases a; rfl
  | cons s l ih =>
    funext a
    cases a with
    | none => rfl
    | some a => exact congrFun (ih (fun b => v (some (a.1,b))) (r a.1) _ _) a.2

def fromHom (l : List ℕ) (f : template l →g G) : Full G l :=
  ⟨(f (.inr none),labelsOf l (fun a => f (.inr (some a)))),
    f (.inl (anchor l)),⟨f.map_rel (by change anchor l=rootAttach l none; rfl)⟩,
    ofMap G l (fun a => f (.inl a)) (labelsOf l (fun a => f (.inr (some a))))
      (fun h => f.map_rel h) (fun a => by
        rw [show leafValue l (labelsOf l (fun a => f (.inr (some a)))) a=f (.inr (some a)) from
          congrFun (leafValue_labelsOf l _) a]
        exact f.map_rel (by change attach l a=rootAttach l (some a); rfl))⟩

lemma fullHom_fromHom (l : List ℕ) (f : template l →g G) : fullHom G l (fromHom G l f)=f := by
  ext v
  cases v with
  | inl a => exact congrFun (interior_ofMap G l _ _ _ _) a
  | inr r => cases r with
    | none => rfl
    | some a => exact congrFun (leafValue_labelsOf l _) a

def homEquiv (l : List ℕ) : Full G l ≃ (template l →g G) where
  toFun := fullHom G l
  invFun := fromHom G l
  left_inv a := fullHom_injective G l (fullHom_fromHom G l (fullHom G l a))
  right_inv := fullHom_fromHom G l

/-- Actual copies embed in the assignment model without changing any vertex image. -/
def copyAssignment (l : List ℕ) (f : (template l).Copy G) : Full G l := fromHom G l f.toHom

lemma copyAssignment_injective (l : List ℕ) : Function.Injective (copyAssignment G l) := by
  intro f g he
  apply Copy.ext
  intro v
  have h := congrArg (fun a => fullHom G l a v) he
  simpa only [copyAssignment,fullHom_fromHom] using h

@[simp] lemma copyAssignment_value (l : List ℕ) (f : (template l).Copy G) (v) :
    fullHom G l (copyAssignment G l f) v=f v := by
  rw [copyAssignment,fullHom_fromHom]
  rfl

end Erdos571.LayeredAssignments

/-! The exact energy of a pin at the top attachment vertex. -/
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

abbrev Pinned (l : List ℕ) (a : Interior l) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧ fullHom G l p.1 (.inl a)=fullHom G l p.2 (.inl a)}

abbrev CenterData (l : List ℕ) :=
  (x : W) × (z : W) × (r : Labels W l) ×
    (PLift (G.Adj z x)×(Assignment G l x r×Assignment G l x r))

lemma fullHom_anchor (l : List ℕ) (p : Full G l) : fullHom G l p (.inl (anchor l))=p.2.1 := by
  change interiorValue G l p.2.2.2 (anchor l)=p.2.1
  exact interior_anchor G l _

def centerEquiv (l : List ℕ) : Pinned G l (anchor l) ≃ CenterData G l where
  toFun p := by
    rcases p with ⟨⟨⟨r,⟨x,hx,a⟩⟩,⟨r',⟨y,hy,b⟩⟩⟩,hr,he⟩
    change r=r' at hr
    subst r'
    simp only [fullHom_anchor] at he
    change x=y at he
    subst y
    exact ⟨x,r.1,r.2,hx,a,b⟩
  invFun p := ⟨(⟨(p.2.1,p.2.2.1),p.1,p.2.2.2.1,p.2.2.2.2.1⟩,
      ⟨(p.2.1,p.2.2.1),p.1,p.2.2.2.1,p.2.2.2.2.2⟩),rfl,by
        rw [fullHom_anchor,fullHom_anchor]⟩
  left_inv p := by
    rcases p with ⟨⟨⟨r,⟨x,hx,a⟩⟩,⟨r',⟨y,hy,b⟩⟩⟩,hr,he⟩
    change r=r' at hr
    subst r'
    simp only [fullHom_anchor] at he
    change x=y at he
    subst y
    have hh : hy=hx := Subsingleton.elim _ _
    subst hy
    rfl
  right_inv p := by rcases p with ⟨x,z,r,h,a,b⟩; rfl

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

lemma card_adj (z x : W) : (Fintype.card (PLift (G.Adj z x)):ℝ)=G.adjMatrix ℝ z x :=
  card_assignment G [] z x

lemma sum_adj_column (x : W) : (∑z, G.adjMatrix ℝ z x)=(G.degree x:ℝ) := by
  simp only [G.isSymm_adjMatrix.apply x,SimpleGraph.adjMatrix_apply,←G.degree_eq_sum_if_adj]

lemma branchKernel_diagonal (l : List ℕ) (x : W) :
    branchKernel (G.adjMatrix ℝ) l x x=∑r, (feature (G.adjMatrix ℝ) l x r)^2 := by
  simp only [branchKernel,GramFeatures.kernel,Matrix.mul_apply,Matrix.transpose_apply,pow_two]

open Classical in
/-- A top pin is exactly the attachment energy in the weighted moment formalism. -/
theorem center_pinned_card (l : List ℕ) :
    (Fintype.card (Pinned G l (anchor l)):ℝ)=
      GramWalkMoments.attachment (G.adjMatrix ℝ) (feature (G.adjMatrix ℝ) l) 1 := by
  classical
  rw [Fintype.card_congr (centerEquiv G l)]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul]
  simp_rw [card_assignment,card_adj]
  change (∑x, ∑z, ∑r, G.adjMatrix ℝ z x*
    (feature (G.adjMatrix ℝ) l x r*feature (G.adjMatrix ℝ) l x r))=
      ∑x, branchKernel (G.adjMatrix ℝ) l x x*EvenWalkMoments.point (G.adjMatrix ℝ) 1 x
  apply sum_congr rfl
  intro x hx
  rw [branchKernel_diagonal,ClosedWalkRotation.point_one_degree]
  simp only [←pow_two,←mul_sum,←sum_mul,sum_adj_column]
  ring

end Erdos571.LayeredAssignments


/-! Marking one coordinate of a Gram feature and one distinguished branch. -/
namespace Erdos571.GramFeatures
open Finset Matrix
variable {W I V : Type*} [Fintype W] [Fintype I]

open Classical in
noncomputable def rootMark (F : Matrix W I ℝ) : Matrix W (I×W) ℝ :=
  fun x p => if x=p.2 then F x p.1 else 0

open Classical in
lemma kernel_rootMark (F : Matrix W I ℝ) (x y : W) :
    kernel (rootMark F) x y=if x=y then kernel F x y else 0 := by
  classical
  simp only [kernel,Matrix.mul_apply,Matrix.transpose_apply,rootMark,Fintype.sum_prod_type]
  by_cases h : x=y
  · subst y
    simp only [ite_mul_ite,ite_self,if_pos rfl]
    simp
  · simp only [if_neg h]
    apply sum_eq_zero
    intro r hr
    apply sum_eq_zero
    intro w hw
    by_cases hx : x=w
    · have hy : y≠w := fun hy => h (hx.trans hy.symm)
      simp only [if_neg hy,mul_zero]
    · simp only [if_neg hx,zero_mul]

noncomputable def markBranch (F : Matrix W I ℝ) (P : Matrix W (I×V) ℝ)
    (s : ℕ) (i : Fin s) : Matrix W ((Fin s → I)×V) ℝ :=
  fun x p => ∏j : Fin s, if j=i then P x (p.1 j,p.2) else F x (p.1 j)

lemma prod_one_mark (s : ℕ) (i : Fin s) (a b : ℝ) :
    (∏j : Fin s, if j=i then a else b)=a*b^(s-1) := by
  classical
  rw [←mul_prod_erase _ _ (mem_univ i)]
  simp only [if_pos rfl]
  congr 1
  calc
    (∏j∈univ.erase i, if j=i then a else b)=(∏_j∈univ.erase i, b) := by
      apply prod_congr rfl
      intro j hj
      exact if_neg (ne_of_mem_erase hj)
    _ = b^(s-1) := by simp only [prod_const,card_erase_of_mem (mem_univ i),card_univ,Fintype.card_fin]

lemma kernel_markBranch [Fintype V] (F : Matrix W I ℝ) (P : Matrix W (I×V) ℝ)
    (s : ℕ) (i : Fin s) (x y : W) :
    kernel (markBranch F P s i) x y=kernel P x y*(kernel F x y)^(s-1) := by
  classical
  simp only [kernel,Matrix.mul_apply,Matrix.transpose_apply,markBranch,Fintype.sum_prod_type]
  rw [sum_comm]
  simp_rw [←prod_mul_distrib]
  have hstep (w : V) :
      (∑r : Fin s → I, ∏j, (if j=i then P x (r j,w) else F x (r j))*
        (if j=i then P y (r j,w) else F y (r j)))=
        (∑r, P x (r,w)*P y (r,w))*(∑r, F x r*F y r)^(s-1) := by
    rw [←Fintype.prod_sum (fun j : Fin s => fun r : I =>
      (if j=i then P x (r,w) else F x r)*(if j=i then P y (r,w) else F y r))]
    calc
      _ = ∏j : Fin s, if j=i then (∑r, P x (r,w)*P y (r,w)) else (∑r, F x r*F y r) := by
        apply prod_congr rfl
        intro j hj
        by_cases h : j=i <;> simp only [h,ite_true,ite_false]
      _ = _ := prod_one_mark s i _ _
  simp_rw [hstep]
  rw [←sum_mul]
  congr 1
  exact sum_comm

lemma rootMark_nonneg {F : Matrix W I ℝ} (hF : ∀x r, 0 ≤ F x r) :
    ∀x p, 0 ≤ rootMark F x p := by
  classical
  intro x p
  exact ite_nonneg (hF x p.1) le_rfl

lemma markBranch_nonneg {F : Matrix W I ℝ} {P : Matrix W (I×V) ℝ}
    (hF : ∀x r, 0 ≤ F x r) (hP : ∀x r, 0 ≤ P x r) (s : ℕ) (i : Fin s) :
    ∀x p, 0 ≤ markBranch F P s i x p := by
  intro x p
  exact prod_nonneg (fun j hj => ite_nonneg (hP x _) (hF x _))

end Erdos571.GramFeatures

namespace Erdos571.LayeredGramKernels
open Matrix GramFeatures LayeredTrees
variable {W : Type*} [Fintype W]

noncomputable def pinFeature (A : Matrix W W ℝ) :
    (l : List ℕ) → Interior l → Matrix W (Labels W l×W) ℝ
  | [],_ => rootMark (feature A [])
  | s::l,none => rootMark (feature A (s::l))
  | s::l,some (i,a) => markBranch (A*feature A l) (A*pinFeature A l a) s i

lemma pinFeature_anchor (A : Matrix W W ℝ) (l : List ℕ) :
    pinFeature A l (anchor l)=rootMark (feature A l) := by cases l <;> rfl

noncomputable def pinKernel (A : Matrix W W ℝ) (l : List ℕ) (a : Interior l) : Matrix W W ℝ :=
  kernel (pinFeature A l a)

open Classical in
lemma pinKernel_anchor (A : Matrix W W ℝ) (l : List ℕ) (x y : W) :
    pinKernel A l (anchor l) x y=if x=y then branchKernel A l x y else 0 := by
  classical
  simp only [pinKernel,pinFeature_anchor,kernel_rootMark,branchKernel]

lemma pinKernel_cons (A : Matrix W W ℝ) (s : ℕ) (l : List ℕ)
    (i : Fin s) (a : Interior l) (x y : W) :
    pinKernel A (s::l) (some (i,a)) x y=(A*pinKernel A l a*A.transpose) x y*
      ((A*branchKernel A l*A.transpose) x y)^(s-1) := by
  change kernel (markBranch (A*feature A l) (A*pinFeature A l a) s i) x y=_
  rw [kernel_markBranch,kernel_chain,kernel_chain]
  rfl

lemma pinFeature_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0 ≤ A x y) (l : List ℕ) :
    ∀a x r, 0 ≤ pinFeature A l a x r := by
  induction l with
  | nil => intro a; exact rootMark_nonneg hA
  | cons s l ih =>
    intro a
    cases a with
    | none => exact rootMark_nonneg (feature_nonneg hA (s::l))
    | some p =>
      exact markBranch_nonneg (chain_nonneg hA (feature_nonneg hA l))
        (chain_nonneg hA (ih p.2)) s p.1

lemma pinKernel_nonneg {A : Matrix W W ℝ} (hA : ∀x y, 0 ≤ A x y)
    (l : List ℕ) (a : Interior l) (x y : W) : 0 ≤ pinKernel A l a x y := by
  classical
  exact GramWalkMoments.kernel_nonneg (pinFeature_nonneg hA l a) x y

lemma pinKernel_isSymm (A : Matrix W W ℝ) (l : List ℕ) (a : Interior l) :
    (pinKernel A l a).IsSymm := kernel_symm _

end Erdos571.LayeredGramKernels

/-! Exact counting interpretation of recursively marked Gram features. -/
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
lemma card_subtype_real {I : Type*} [Fintype I] (p : I → Prop) [DecidablePred p] :
    (Fintype.card {x : I // p x}:ℝ)=∑x : I, if p x then (1:ℝ) else 0 := by
  rw [Fintype.card_subtype,card_filter,Nat.cast_sum]
  apply sum_congr rfl
  intro x hx
  split_ifs <;> simp

open Classical in
lemma marked_child_sum (l : List ℕ) (x : W) (r : Labels W l) (a : Interior l) (w : W) :
    (∑p : (y : W) × (PLift (G.Adj x y)×Assignment G l y r),
      if interiorValue G l p.2.2 a=w then (1:ℝ) else 0)=
    ∑y, G.adjMatrix ℝ x y*
      (Fintype.card {p : Assignment G l y r // interiorValue G l p a=w}:ℝ) := by
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro y hy
  rw [card_subtype_real,Fintype.sum_prod_type]
  dsimp only
  rw [sum_const]
  simp only [nsmul_eq_mul,card_univ,card_adj]

open Classical in
lemma marked_branch_count (s : ℕ) (l : List ℕ) (x : W) (r : Labels W (s::l))
    (i : Fin s) (a : Interior l) (w : W) :
    (Fintype.card {p : Assignment G (s::l) x r //
      interiorValue G (s::l) p (some (i,a))=w}:ℝ)=
    ∏j : Fin s, if j=i then
      (∑y, G.adjMatrix ℝ x y*
        (Fintype.card {p : Assignment G l y (r j) // interiorValue G l p a=w}:ℝ))
      else (G.adjMatrix ℝ * feature (G.adjMatrix ℝ) l) x (r j) := by
  rw [card_subtype_real]
  change (∑p : (j : Fin s) → (y : W) × (PLift (G.Adj x y)×Assignment G l y (r j)),
    if interiorValue G l (p i).2.2 a=w then (1:ℝ) else 0)=_
  calc
    _ = ∑p : (j : Fin s) → (y : W) × (PLift (G.Adj x y)×Assignment G l y (r j)),
        ∏j : Fin s, if j=i then
          (if interiorValue G l (p j).2.2 a=w then (1:ℝ) else 0) else 1 := by
      apply sum_congr rfl
      intro p hp
      simp only [prod_ite_eq',mem_univ,ite_true]
    _ = ∏j : Fin s, ∑p : (y : W) × (PLift (G.Adj x y)×Assignment G l y (r j)),
        if j=i then (if interiorValue G l p.2.2 a=w then (1:ℝ) else 0) else 1 := by
      exact (Fintype.prod_sum (fun j : Fin s =>
        fun p : (y : W) × (PLift (G.Adj x y)×Assignment G l y (r j)) =>
          if j=i then (if interiorValue G l p.2.2 a=w then (1:ℝ) else 0) else 1)).symm
    _ = _ := by
      apply prod_congr rfl
      intro j hj
      by_cases h : j=i
      · simp only [if_pos h]
        exact marked_child_sum G l x (r j) a w
      · simp only [if_neg h,sum_const,nsmul_eq_mul,mul_one,card_univ]
        rw [Fintype.card_sigma,Nat.cast_sum,Matrix.mul_apply]
        apply sum_congr rfl
        intro y hy
        rw [Fintype.card_prod,Nat.cast_mul,card_adj,card_assignment]

open Classical in
/-- Prescribing the image at an arbitrary interior role gives exactly the
corresponding marked feature entry. No injectivity restriction is imposed. -/
theorem card_pinAssignment (l : List ℕ) (x : W) (r : Labels W l) (a : Interior l) (w : W) :
    (Fintype.card {p : Assignment G l x r // interiorValue G l p a=w}:ℝ)=
      pinFeature (G.adjMatrix ℝ) l a x (r,w) := by
  induction l generalizing x with
  | nil =>
    rw [card_subtype_real]
    simp only [pinFeature,rootMark,interiorValue]
    by_cases h : x=w <;> simp only [h,ite_true,ite_false,sum_const,nsmul_eq_mul,mul_one,mul_zero,card_univ]
    all_goals try rw [←h]
    exact card_assignment G [] x r
  | cons s l ih =>
    cases a with
    | none =>
      rw [card_subtype_real]
      simp only [pinFeature,rootMark,interiorValue]
      by_cases h : x=w <;> simp only [h,ite_true,ite_false,sum_const,nsmul_eq_mul,mul_one,mul_zero,card_univ]
      all_goals try rw [←h]
      exact card_assignment G (s::l) x r
    | some p =>
      rcases p with ⟨i,a⟩
      rw [marked_branch_count]
      change (∏j : Fin s, if j=i then _ else _)=
        ∏j : Fin s, if j=i then (G.adjMatrix ℝ * pinFeature (G.adjMatrix ℝ) l a) x (r j,w)
          else (G.adjMatrix ℝ * feature (G.adjMatrix ℝ) l) x (r j)
      apply prod_congr rfl
      intro j hj
      by_cases h : j=i
      · simp only [if_pos h,Matrix.mul_apply]
        apply sum_congr rfl
        intro y hy
        rw [ih]
      · simp only [if_neg h]

end Erdos571.LayeredAssignments

/-! All single-position pin counts are exact Gram energies. -/
namespace Erdos571

/-- Equal-label pairs in a dependent family can be regrouped by their label
and the common value of an additional marking. -/
def markedPairEquiv {R W : Type*} (F : R → Type*) (f : ((r : R) × F r) → W) :
    {p : ((r : R) × F r)×((r : R) × F r) //
      p.1.1=p.2.1 ∧ f p.1=f p.2} ≃
    (r : R) × (w : W) × ({p : F r // f ⟨r,p⟩=w}×{p : F r // f ⟨r,p⟩=w}) where
  toFun p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,hr,he⟩
    change r=s at hr
    subst s
    exact ⟨r,f ⟨r,p⟩,⟨p,rfl⟩,⟨q,he.symm⟩⟩
  invFun p := ⟨(⟨p.1,p.2.2.1.1⟩,⟨p.1,p.2.2.2.1⟩),rfl,
    p.2.2.1.2.trans p.2.2.2.2.symm⟩
  left_inv p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,hr,he⟩
    change r=s at hr
    subst s
    rfl
  right_inv p := by
    rcases p with ⟨r,w,⟨p,hp⟩,⟨q,hq⟩⟩
    subst w
    rfl

end Erdos571

namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

abbrev PinFiber (l : List ℕ) (a : Interior l) (z : W) (r : Labels W l) (w : W) :=
  {p : Fiber G l z r // interiorValue G l p.2.2 a=w}

abbrev PinFiberData (l : List ℕ) (a : Interior l) (z : W) (r : Labels W l) (w : W) :=
  (x : W) × (PLift (G.Adj z x)×{p : Assignment G l x r // interiorValue G l p a=w})

def pinFiberEquiv (l : List ℕ) (a : Interior l) (z : W) (r : Labels W l) (w : W) :
    PinFiber G l a z r w ≃ PinFiberData G l a z r w where
  toFun p := ⟨p.1.1,p.1.2.1,⟨p.1.2.2,p.2⟩⟩
  invFun p := ⟨⟨p.1,p.2.1,p.2.2.1⟩,p.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def pinEquiv (l : List ℕ) (a : Interior l) :
    Pinned G l a ≃ (r : W×Labels W l) × (w : W) ×
      (PinFiber G l a r.1 r.2 w×PinFiber G l a r.1 r.2 w) :=
  markedPairEquiv (fun r : W×Labels W l => Fiber G l r.1 r.2)
    (fun p => fullHom G l p (.inl a))

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
lemma card_pinFiber (l : List ℕ) (a : Interior l) (z : W) (r : Labels W l) (w : W) :
    (Fintype.card (PinFiber G l a z r w):ℝ)=
      (G.adjMatrix ℝ * pinFeature (G.adjMatrix ℝ) l a) z (r,w) := by
  rw [Fintype.card_congr (pinFiberEquiv G l a z r w)]
  simp only [PinFiberData,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul]
  rw [Matrix.mul_apply]
  apply sum_congr rfl
  intro x hx
  rw [card_adj,card_pinAssignment]

open Classical in
/-- An ordered pair agreeing on all roots and at role a is counted by the
second moment of the marked feature at a. This retains all homomorphisms. -/
theorem pinned_card (l : List ℕ) (a : Interior l) :
    (Fintype.card (Pinned G l a):ℝ)=
      GramWalkMoments.moment (G.adjMatrix ℝ) (pinFeature (G.adjMatrix ℝ) l a) 1 := by
  rw [Fintype.card_congr (pinEquiv G l a),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul]
  simp_rw [card_pinFiber,←pow_two]
  rw [←GramWalkMoments.sum_sq G.isSymm_adjMatrix (pinFeature (G.adjMatrix ℝ) l a) 1]
  simp only [pow_one,Fintype.sum_prod_type]
  rw [sum_comm]
  apply sum_congr rfl
  intro r hr
  rw [sum_comm]

end Erdos571.LayeredAssignments

/-! Genuine-copy packing bounds in terms of the recursively marked moments. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

lemma copyAssignment_roots (l : List ℕ) (f g : (template l).Copy G)
    (h : ∀r, f (.inr r)=g (.inr r)) : (copyAssignment G l f).1=(copyAssignment G l g).1 := by
  apply Prod.ext (h none)
  change labelsOf l (fun a => f (.inr (some a)))=labelsOf l (fun a => g (.inr (some a)))
  congr 1
  funext a
  exact h (some a)

open Classical in
lemma copyPins_le_pinned (l : List ℕ) (F : Finset ((template l).Copy G)) (a : Interior l) :
    (RootedCollisionEnergy.pinned F id a).card ≤ Fintype.card (Pinned G l a) := by
  classical
  let f : RootedCollisionEnergy.pinned F id a → Pinned G l a := fun p => by
    have hp := p.property
    simp only [RootedCollisionEnergy.pinned,PackingEnergy.fiberPairs,mem_filter,mem_product,and_true] at hp
    have he := hp.2
    refine ⟨(copyAssignment G l p.val.1,copyAssignment G l p.val.2),?_,?_⟩
    · apply copyAssignment_roots G l
      intro r
      exact congrFun (congrArg Prod.fst he) r
    · simpa only [copyAssignment_value] using congrArg Prod.snd he
  have hi : Function.Injective f := by
    intro p q he
    apply Subtype.ext
    apply Prod.ext
    · exact copyAssignment_injective G l (congrArg (fun r => r.val.1) he)
    · exact copyAssignment_injective G l (congrArg (fun r => r.val.2) he)
  simpa only [Fintype.card_coe] using Fintype.card_le_of_injective f hi

open Classical in
/-- Ordinary rooted-power freeness bounds the agreement energy of genuine
copies by a sum of marked Gram moments. -/
theorem copyAgreement_le_pinMoments (l : List ℕ) (F : Finset ((template l).Copy G))
    (M : ℕ) (hM : 2 ≤ M) (hf : (graph l M).Free G) :
    ((RootedCollisionEnergy.agreements F id).card:ℝ) ≤
      (M-1:ℕ)*(nonroots l:ℝ)*∑a : Interior l,
        GramWalkMoments.moment (G.adjMatrix ℝ) (pinFeature (G.adjMatrix ℝ) l a) 1 := by
  classical
  have h := RootedCollisionEnergy.single_pin_bound F id M hM hf
  have hc : ((RootedCollisionEnergy.agreements F id).card:ℝ) ≤
      (M-1:ℕ)*(nonroots l:ℝ)*∑a : Interior l, ((RootedCollisionEnergy.pinned F id a).card:ℝ) := by
    exact_mod_cast (by simpa only [card_interior] using h)
  refine hc.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
  apply sum_le_sum
  intro a ha
  rw [←pinned_card G l a]
  exact_mod_cast copyPins_le_pinned G l F a

open Classical in
lemma copies_lower_nat (l : List ℕ) (d : ℕ)
    (hdeg : ∀x, d+(edges l+1) ≤ G.degree x) :
    Fintype.card W*d^(edges l) ≤ Fintype.card ((template l).Copy G) := by
  have hv : Fintype.card (Interior l⊕Option (Leaves l))=edges l+1 := by
    simp only [Fintype.card_sum,Fintype.card_option,card_interior,card_leaves,edges_eq]
    omega
  have h := TreeCount.tree_count_of_degree G (template l) (isTree l) d (by simpa only [hv] using hdeg)
  simpa only [hv,Nat.add_sub_cancel_right,labelledCopyCount,←Nat.card_eq_fintype_card] using h

open Classical in
/-- A necessary quantitative constraint on all the marked moments in an
ordinary power-free host. Only a minimum-degree assumption is used here. -/
theorem power_free_pin_constraint (l : List ℕ) (M d : ℕ) (hM : 2 ≤ M)
    (hf : (graph l M).Free G) (hdeg : ∀x, d+(edges l+1) ≤ G.degree x) :
    ((Fintype.card W:ℝ)*(d:ℝ)^(edges l))^2 ≤
      (Fintype.card W:ℝ)^(l.prod+1)*
        ((M-1:ℕ)*(nonroots l:ℝ)*∑a : Interior l,
          GramWalkMoments.moment (G.adjMatrix ℝ) (pinFeature (G.adjMatrix ℝ) l a) 1) := by
  classical
  have hl : ((Fintype.card W:ℝ)*(d:ℝ)^(edges l))^2 ≤
      (Fintype.card ((template l).Copy G):ℝ)^2 := by
    apply pow_le_pow_left₀ (by positivity)
    exact_mod_cast copies_lower_nat G l d hdeg
  have hcs := RootedCollisionEnergy.weighted_mass_sq_le_agreements
    (univ : Finset ((template l).Copy G)) id univ (by intros; exact mem_univ _)
      (fun _ => (1:ℝ)) (by intros; norm_num)
  have hm := copyAgreement_le_pinMoments G l univ M hM hf
  simp only [sum_const,card_univ,nsmul_eq_mul,mul_one,Fintype.card_option,card_leaves] at hcs
  exact hl.trans (hcs.trans (mul_le_mul_of_nonneg_left hm (by positivity)))

end Erdos571.LayeredAssignments


set_option maxHeartbeats 1500000

/-! Higher moments from bounded coordinate hitting sets. -/
namespace Erdos571.CoordinateCoverMoments
open Finset
variable {I A W : Type*} [DecidableEq I] [Fintype A] [Fintype W] [DecidableEq W]

lemma sum_power_bound {J : Type*} (S : Finset J) (f : J → ℝ)
    (hf : ∀j∈S, 0 ≤ f j) (k : ℕ) (hk : 1 ≤ k) :
    (∑j∈S, f j)^k ≤ (S.card:ℝ)^(k-1)*∑j∈S, (f j)^k := by
  have h := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg S (f := f) (p := (k:ℝ))
    (by exact_mod_cast hk) hf
  have he : (k:ℝ)-1=((k-1:ℕ):ℝ) := by rw [Nat.cast_sub hk,Nat.cast_one]
  rw [he] at h
  simpa only [Real.rpow_natCast] using h

open Classical in
noncomputable def markMass (F : Finset I) (c : A → I → W) (w : I → ℝ) (a : A) (v : W) : ℝ :=
  ∑i∈F, if c a i=v then w i else 0

lemma markMass_nonneg (F : Finset I) (c : A → I → W) (w : I → ℝ)
    (hw : ∀i∈F, 0 ≤ w i) (a : A) (v : W) : 0 ≤ markMass F c w a v := by
  classical
  exact sum_nonneg (fun i hi => ite_nonneg (hw i hi) le_rfl)

/-- A coordinate cover controls the full mass without bounding any individual fiber. -/
lemma mass_le_cover (F : Finset I) (c : A → I → W) (w : I → ℝ)
    (hw : ∀i∈F, 0 ≤ w i) (U : Finset W) (hU : ∀i∈F, ∃a, c a i∈U) :
    (∑i∈F, w i) ≤ ∑p∈(univ×ˢU), markMass F c w p.1 p.2 := by
  classical
  simp only [markMass]
  rw [sum_comm]
  apply sum_le_sum
  intro i hi
  obtain ⟨a,ha⟩ := hU i hi
  have hmem : (a,c a i)∈univ×ˢU := mem_product.mpr ⟨mem_univ a,ha⟩
  have h := single_le_sum (f := fun p : A×W => if c p.1 i=p.2 then w i else 0)
    (fun p hp => ite_nonneg (hw i hi) le_rfl) hmem
  simpa only [ite_true] using h

/-- Every positive integer moment is controlled by the same-position marked
moments, with a factor depending only on the size of the cover and the role set. -/
theorem bound (F : Finset I) (c : A → I → W) (w : I → ℝ)
    (hw : ∀i∈F, 0 ≤ w i) (U : Finset W) (C : ℕ) (hC : U.card ≤ C)
    (hU : ∀i∈F, ∃a, c a i∈U) (k : ℕ) (hk : 1 ≤ k) :
    (∑i∈F, w i)^k ≤ ((Fintype.card A:ℝ)*C)^(k-1)*
      ∑a, ∑v, (markMass F c w a v)^k := by
  classical
  have hm := pow_le_pow_left₀ (sum_nonneg hw) (mass_le_cover F c w hw U hU) k
  have hp := sum_power_bound (univ×ˢU) (fun p => markMass F c w p.1 p.2)
    (fun p hp => markMass_nonneg F c w hw p.1 p.2) k hk
  have hc : ((univ×ˢU : Finset (A×W)).card:ℝ) ≤ (Fintype.card A:ℝ)*C := by
    simp only [card_product,card_univ,Nat.cast_mul]
    exact mul_le_mul_of_nonneg_left (by exact_mod_cast hC) (Nat.cast_nonneg _)
  have hs : (∑p∈(univ×ˢU), (markMass F c w p.1 p.2)^k) ≤
      ∑a, ∑v, (markMass F c w a v)^k := by
    rw [sum_product]
    apply sum_le_sum
    intro a ha
    exact sum_le_sum_of_subset_of_nonneg (subset_univ _)
      (fun v hv hv' => pow_nonneg (markMass_nonneg F c w hw a v) k)
  exact (hm.trans hp).trans (mul_le_mul
    (pow_le_pow_left₀ (by positivity) hc _) hs
    (sum_nonneg (fun p hp => pow_nonneg (markMass_nonneg F c w hw p.1 p.2) k)) (by positivity))

end Erdos571.CoordinateCoverMoments

namespace Erdos571.RootedCollisionEnergy
open Finset SimpleGraph RootedPacking CoordinateCoverMoments MarginalCollisionEnergy
variable {I A R W : Type*} [DecidableEq I] [Fintype A] [Fintype R] [DecidableEq R] [Fintype W] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

open Classical in
noncomputable def fiberMoment {J : Type*} [Fintype J] [DecidableEq J] (F : Finset I) (label : I → J)
    (w : I → ℝ) (k : ℕ) : ℝ := ∑r : J, (fiberMass F label w r)^k

lemma root_cover [Nonempty A] (F : Finset I) (f : I → H.Copy G)
    (M : ℕ) (hM : 1 ≤ M) (hf : (FullRootedPower.graph H M).Free G) (r : R → W) :
    ∃U : Finset W, U.card ≤ Fintype.card A*(M-1) ∧
      ∀i∈F.filter (fun i => labels f i=r), ∃a : A, f i (.inl a)∈U := by
  classical
  obtain ⟨U,hU,hcover⟩ := small_cover_of_no_packing (F.filter (fun i => labels f i=r))
    (fun i => interior (f i)) (Fintype.card A) M
    (fun i hi => by rw [←card_pos,interior_card]; exact Fintype.card_pos)
    (fun i hi => (interior_card _).le) (by
      rintro ⟨S,hSF,hS,hdis⟩
      exact no_fiber_packing F f M (by omega) hf r ⟨S,hSF,hS,
        fun i hi j hj hij => not_not.mpr (hdis i hi j hj hij)⟩)
  refine ⟨U,hU,?_⟩
  intro i hi
  obtain ⟨v,hv,hvU⟩ := hcover i hi
  simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hv
  obtain ⟨a,rfl⟩ := hv
  exact ⟨a,hvU⟩

lemma marked_root_fiber (F : Finset I) (f : I → H.Copy G) (w : I → ℝ)
    (r : R → W) (a : A) (v : W) :
    markMass (F.filter (fun i => labels f i=r)) (fun a i => f i (.inl a)) w a v=
      fiberMass F (pinLabel f a) w (r,v) := by
  classical
  simp only [markMass,fiberMass,sum_filter,pinLabel,Prod.mk.injEq]
  apply sum_congr rfl
  intro i hi
  split_ifs <;> simp_all

open Classical in
/-- Higher moments admit a same-position pinning bound under ordinary
rooted-power freeness. The weights may be arbitrary nonnegative copy weights. -/
theorem weighted_higher_single_pin_bound [Nonempty A] (F : Finset I) (f : I → H.Copy G)
    (M : ℕ) (hM : 1 ≤ M) (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0 ≤ w i) (k : ℕ) (hk : 1 ≤ k) :
    fiberMoment F (labels f) w k ≤ ((M-1:ℕ)*(Fintype.card A:ℝ)^2)^(k-1)*
      ∑a : A, fiberMoment F (pinLabel f a) w k := by
  classical
  have hb (r : R → W) : (fiberMass F (labels f) w r)^k ≤
      ((M-1:ℕ)*(Fintype.card A:ℝ)^2)^(k-1)*
        ∑a, ∑v, (fiberMass F (pinLabel f a) w (r,v))^k := by
    obtain ⟨U,hU,hcover⟩ := root_cover F f M hM hf r
    have h := CoordinateCoverMoments.bound (F.filter (fun i => labels f i=r))
      (fun a i => f i (.inl a)) w (fun i hi => hw i (mem_filter.mp hi).1) U
      (Fintype.card A*(M-1)) hU hcover k hk
    simp_rw [marked_root_fiber] at h
    have he : (Fintype.card A:ℝ)*(Fintype.card A*(M-1):ℕ)=
        (M-1:ℕ)*(Fintype.card A:ℝ)^2 := by push_cast; ring
    rw [he] at h
    simpa only [fiberMass,sum_filter] using h
  unfold fiberMoment
  calc
    _ ≤ ∑r : R → W, ((M-1:ℕ)*(Fintype.card A:ℝ)^2)^(k-1)*
        ∑a, ∑v, (fiberMass F (pinLabel f a) w (r,v))^k := sum_le_sum (fun r hr => hb r)
    _ = _ := by
      rw [←mul_sum]
      congr 1
      rw [sum_comm]
      apply sum_congr rfl
      intro a ha
      rw [Fintype.sum_prod_type]

end Erdos571.RootedCollisionEnergy

/-! Higher fiber moments count tuples with a common label. -/
namespace Erdos571.FiberMomentTuples
open Finset RootedCollisionEnergy MarginalCollisionEnergy
variable {I J : Type*} [DecidableEq I] [Fintype J] [DecidableEq J]

abbrev Tuple (F : Finset I) (label : I → J) (k : ℕ) :=
  {p : Fin (k+1) → F // ∀i, label (p i)=label (p 0)}

abbrev Data (F : Finset I) (label : I → J) (k : ℕ) :=
  (r : J) × (Fin (k+1) → {i : F // label i=r})

def equiv (F : Finset I) (label : I → J) (k : ℕ) : Tuple F label k ≃ Data F label k where
  toFun p := ⟨label (p.val 0),fun i => ⟨p.val i,p.property i⟩⟩
  invFun p := ⟨fun i => (p.2 i).val,fun i => (p.2 i).property.trans (p.2 0).property.symm⟩
  left_inv _ := rfl
  right_inv p := by
    rcases p with ⟨r,p⟩
    have h : label (p 0).val=r := (p 0).property
    apply Sigma.ext h
    apply Function.hfunext rfl
    intro i j hij
    have he : i=j := eq_of_heq hij
    subst j
    apply (Subtype.heq_iff_coe_eq (fun x => by dsimp only; rw [h])).mpr
    rfl

def fiberEquiv (F : Finset I) (label : I → J) (r : J) :
    {i : F // label i=r} ≃ F.filter (fun i => label i=r) where
  toFun p := ⟨p.val.val,mem_filter.mpr ⟨p.val.property,p.property⟩⟩
  invFun p := ⟨⟨p.val,(mem_filter.mp p.property).1⟩,(mem_filter.mp p.property).2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma fiberMass_one (F : Finset I) (label : I → J) (r : J) :
    fiberMass F label (fun _ => 1) r=((F.filter (fun i => label i=r)).card:ℝ) := by
  classical
  simp only [fiberMass,card_filter,Nat.cast_sum]
  apply sum_congr rfl
  intro i hi
  split_ifs <;> simp

lemma fiber_card (F : Finset I) (label : I → J) (r : J) :
    (Fintype.card {i : F // label i=r}:ℝ)=fiberMass F label (fun _ => 1) r := by
  rw [Fintype.card_congr (fiberEquiv F label r),Fintype.card_coe,fiberMass_one]

/-- The zeroth index anchors the common label, so the tuple length is positive. -/
theorem card_tuple (F : Finset I) (label : I → J) (k : ℕ) :
    (Fintype.card (Tuple F label k):ℝ)=fiberMoment F label (fun _ => 1) (k+1) := by
  rw [Fintype.card_congr (equiv F label k)]
  simp only [Data,Fintype.card_sigma,Fintype.card_fun,Fintype.card_fin,Nat.cast_sum,Nat.cast_pow]
  simp only [fiber_card,fiberMoment]

lemma sum_fiberMass (F : Finset I) (label : I → J) (w : I → ℝ) :
    (∑r, fiberMass F label w r)=∑i∈F, w i := by
  classical
  simp only [fiberMass]
  rw [sum_comm]
  apply sum_congr rfl
  intro i hi
  simp

/-- Hölder's lower bound for any positive integer fiber moment. -/
theorem mass_power_le_moment (F : Finset I) (label : I → J) (w : I → ℝ)
    (hw : ∀i∈F, 0 ≤ w i) (k : ℕ) (hk : 1 ≤ k) :
    (∑i∈F, w i)^k ≤ (Fintype.card J:ℝ)^(k-1)*fiberMoment F label w k := by
  classical
  have h := CoordinateCoverMoments.sum_power_bound (univ : Finset J) (fiberMass F label w)
    (fun r hr => sum_nonneg (fun i hi => ite_nonneg (hw i hi) le_rfl)) k hk
  simpa only [sum_fiberMass,card_univ,fiberMoment] using h

end Erdos571.FiberMomentTuples

namespace Erdos571.RootedCollisionEnergy
open Finset SimpleGraph FiberMomentTuples
variable {I A R W : Type*} [DecidableEq I] [Fintype A] [Fintype R] [DecidableEq R] [Fintype W] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

open Classical in
/-- Higher-moment packing bounds the total weighted copy mass using only
same-position pin moments. -/
theorem mass_power_le_single_pin_moments [Nonempty A] (F : Finset I) (f : I → H.Copy G)
    (M : ℕ) (hM : 1 ≤ M) (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀i∈F, 0 ≤ w i) (k : ℕ) (hk : 1 ≤ k) :
    (∑i∈F, w i)^k ≤
      ((Fintype.card W:ℝ)^Fintype.card R*((M-1:ℕ)*(Fintype.card A:ℝ)^2))^(k-1)*
        ∑a : A, fiberMoment F (pinLabel f a) w k := by
  classical
  have hl := mass_power_le_moment F (labels f) w hw k hk
  have hu := weighted_higher_single_pin_bound F f M hM hf w hw k hk
  have h := hl.trans (mul_le_mul_of_nonneg_left hu (by positivity))
  simpa only [Fintype.card_fun,Nat.cast_pow,mul_pow,mul_assoc] using h

end Erdos571.RootedCollisionEnergy

/-! Higher-moment constraints retain genuine layered-tree copies throughout. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LayeredAssignments
open Finset SimpleGraph LayeredTrees RootedCollisionEnergy
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
/-- Unlike the all-homomorphism marked kernels, these higher pin moments use
only injective tree copies. In particular repeated root values are excluded. -/
theorem genuine_higher_pin_constraint (l : List ℕ) (M d k : ℕ) (hM : 1 ≤ M) (hk : 1 ≤ k)
    (hf : (graph l M).Free G) (hdeg : ∀x, d+(edges l+1) ≤ G.degree x) :
    ((Fintype.card W:ℝ)*(d:ℝ)^(edges l))^k ≤
      ((Fintype.card W:ℝ)^(l.prod+1)*((M-1:ℕ)*(nonroots l:ℝ)^2))^(k-1)*
        ∑a : Interior l, fiberMoment (univ : Finset ((template l).Copy G)) (pinLabel id a)
          (fun _ => 1) k := by
  classical
  have hl : ((Fintype.card W:ℝ)*(d:ℝ)^(edges l))^k ≤
      (Fintype.card ((template l).Copy G):ℝ)^k := by
    apply pow_le_pow_left₀ (by positivity)
    exact_mod_cast copies_lower_nat G l d hdeg
  have h := mass_power_le_single_pin_moments (univ : Finset ((template l).Copy G)) id
    M hM hf (fun _ => 1) (by intros; norm_num) k hk
  simp only [sum_const,card_univ,nsmul_eq_mul,mul_one,Fintype.card_option,card_leaves,card_interior] at h
  exact hl.trans h

end Erdos571.LayeredAssignments


set_option maxHeartbeats 2000000

namespace Erdos571.LayeredFanAssembly
open Finset SimpleGraph LayeredTrees
variable {W : Type} [Fintype W] [DecidableEq W]

/-- Assemble arbitrary layered children. Every child interior is disjoint
from all other child interiors, all new hubs, and every global root. -/
theorem contains_of_children (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (u : Fin M ↪ W) (r : Option (Leaves (p::l)) ↪ W)
    (f : Fin M × Fin p → (template l).Copy G)
    (hroot : ∀i j, f (i,j) (.inr none)=u i ∧
      ∀a : Leaves l, f (i,j) (.inr (some a))=r (some (j,a)))
    (hdis : Pairwise (fun i j => Disjoint (RootedPacking.interior (f i))
      (RootedPacking.interior (f j))))
    (hfu : ∀i a j, f i (.inl a)≠u j)
    (hfr : ∀i a b, f i (.inl a)≠r b)
    (hur : ∀i b, u i≠r b)
    (hshort : ∀i, G.Adj (u i) (r none)) : graph (p::l) M ⊑ G := by
  classical
  let E := RootedPacking.packedInterior f hdis
  let c : Fin M × Interior (p::l) ↪ W :=
    { toFun := fun x => match x.2 with
        | none => u x.1
        | some (j,a) => f (x.1,j) (.inl a)
      inj' := by
        rintro ⟨i,a⟩ ⟨j,b⟩ he
        cases a with
        | none => cases b with
          | none => exact Prod.ext (u.injective he) rfl
          | some b => exact (hfu (j,b.1) b.2 i he.symm).elim
        | some a => cases b with
          | none => exact (hfu (i,a.1) a.2 j he).elim
          | some b =>
            have hh : E ((i,a.1),a.2)=E ((j,b.1),b.2) := he
            have hh := E.injective hh
            have hi := (Prod.mk.inj (Prod.mk.inj hh).1).1
            have hj := (Prod.mk.inj (Prod.mk.inj hh).1).2
            have ha := (Prod.mk.inj hh).2
            exact Prod.ext hi (congrArg some (Prod.ext hj ha)) }
  have hcr : ∀x b, c x≠r b := by
    rintro ⟨i,a⟩ b
    cases a with
    | none => exact hur i b
    | some a => exact hfr (i,a.1) a.2 b
  let e : ((Fin M × Interior (p::l)) ⊕ Option (Leaves (p::l))) ↪ W :=
    ⟨Sum.elim c r,Sum.elim_injective.mpr ⟨c.injective,r.injective,hcr⟩⟩
  refine ⟨{toHom := {toFun := e, map_rel' := ?_},injective' := e.injective}⟩
  rintro (⟨i,a⟩|a) (⟨j,b⟩|b) h
  · obtain ⟨hij,h⟩ := h
    change i=j at hij
    subst j
    cases a with
    | none => cases b with
      | none => exact h.elim
      | some b =>
        change b.2=anchor l at h
        change G.Adj (u i) (f (i,b.1) (.inl b.2))
        rw [h,←(hroot i b.1).1]
        exact (f (i,b.1)).toHom.map_adj (show (template l).Adj (.inr none) (.inl (anchor l)) from rfl)
    | some a => cases b with
      | none =>
        change a.2=anchor l at h
        change G.Adj (f (i,a.1) (.inl a.2)) (u i)
        rw [h,←(hroot i a.1).1]
        exact (f (i,a.1)).toHom.map_adj (show (template l).Adj (.inl (anchor l)) (.inr none) from rfl)
      | some b =>
        obtain ⟨hab,h⟩ := h
        change a.1=b.1 at hab
        change G.Adj (f (i,a.1) (.inl a.2)) (f (i,b.1) (.inl b.2))
        rw [←hab]
        exact (f (i,a.1)).toHom.map_adj h
  · cases a with
    | none => cases b with
      | none => exact hshort i
      | some b =>
        change (none : Interior (p::l))=some (b.1,attach l b.2) at h
        cases h
    | some a => cases b with
      | none =>
        change some a=(none : Interior (p::l)) at h
        cases h
      | some b =>
        change some a=some (b.1,attach l b.2) at h
        have h := Option.some.inj h
        change G.Adj (f (i,a.1) (.inl a.2)) (r (some b))
        rw [h]
        change G.Adj (f (i,b.1) (.inl (attach l b.2))) (r (some (b.1,b.2)))
        rw [←(hroot i b.1).2 b.2]
        exact (f (i,b.1)).toHom.map_adj (show (template l).Adj
          (.inl (attach l b.2)) (.inr (some b.2)) from rfl)
  · cases b with
    | none => cases a with
      | none => exact (hshort j).symm
      | some a =>
        change (none : Interior (p::l))=some (a.1,attach l a.2) at h
        cases h
    | some b => cases a with
      | none =>
        change some b=(none : Interior (p::l)) at h
        cases h
      | some a =>
        change some b=some (a.1,attach l a.2) at h
        have h := Option.some.inj h
        change G.Adj (r (some a)) (f (j,b.1) (.inl b.2))
        rw [h]
        change G.Adj (r (some (a.1,a.2))) (f (j,a.1) (.inl (attach l a.2)))
        rw [←(hroot j a.1).2 a.2]
        exact (f (j,a.1)).toHom.map_adj (show (template l).Adj
          (.inr (some a.2)) (.inl (attach l a.2)) from rfl)
  · exact h.elim


/-- A packing large enough to avoid every root, hub, and previously chosen
child interior during the amalgamation. -/
def packingThreshold (l : List ℕ) (p M : ℕ) : ℕ :=
  p*l.prod+1+M+nonroots l*(M*p)

/-- Richness here means an actual disjoint packing, not a large number of
possibly overlapping assignments. No upper-bound hypothesis is built in. -/
def PackingRich (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (u : W) (r : Leaves l → W) : Prop :=
  ∃F : Finset ((template l).Copy G), packingThreshold l p M < F.card ∧
    (∀f∈F, f (.inr none)=u ∧ ∀a, f (.inr (some a))=r a) ∧
    ∀f∈F, ∀g∈F, f≠g → Disjoint (RootedPacking.interior f) (RootedPacking.interior g)

lemma PackingRich.distinct {G : SimpleGraph W} {l : List ℕ} {p M : ℕ}
    {u : W} {r : Leaves l → W} (h : PackingRich G l p M u r) :
    Function.Injective r ∧ ∀a, u≠r a := by
  obtain ⟨F,hc,hr,hd⟩ := h
  obtain ⟨f,hf⟩ := card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) hc)
  constructor
  · intro a b hab
    have he := (hr f hf).2 a |>.trans (hab.trans ((hr f hf).2 b).symm)
    exact Option.some.inj (Sum.inr.inj (f.injective he))
  · intro a ha
    have he := (hr f hf).1.trans (ha.trans ((hr f hf).2 a).symm)
    have hh := Sum.inr.inj (f.injective he)
    cases hh

/-- A grid of rich child fibers and adjacent hubs forces the full parent
power. This works at every depth and uses only finite disjoint packings. -/
theorem contains_of_rich_neighbors (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (u : Fin M ↪ W) (r : Option (Leaves (p::l)) ↪ W)
    (hur : ∀i b, u i≠r b) (hshort : ∀i, G.Adj (u i) (r none))
    (hrich : ∀i j, PackingRich G l p M (u i) (fun a => r (some (j,a)))) :
    graph (p::l) M ⊑ G := by
  classical
  have hx : ∀z : Fin M×Fin p, ∃F : Finset ((template l).Copy G),
      packingThreshold l p M < F.card ∧
      (∀f∈F, f (.inr none)=u z.1 ∧ ∀a, f (.inr (some a))=r (some (z.2,a))) ∧
      ∀f∈F, ∀g∈F, f≠g → Disjoint (RootedPacking.interior f) (RootedPacking.interior g) :=
    fun z => hrich z.1 z.2
  choose F hFc hFr hFd using hx
  let Z := univ.image r ∪ univ.image u
  have hZ : Z.card ≤ p*l.prod+1+M := by
    have h := card_union_le (univ.image r) (univ.image u)
    have hr := card_image_le (s := univ) (f := r)
    have hu := card_image_le (s := univ) (f := u)
    simp only [card_univ,Fintype.card_option,card_leaves,List.prod_cons,Fintype.card_fin] at hr hu
    dsimp [Z]
    omega
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice_finite (nonroots l) 1
    RootedPacking.interior F Z
    (by intro i f hf; exact (RootedPacking.interior_card f).le.trans_eq (card_interior l))
    (by
      intro i w
      apply card_le_one.mpr
      intro f hf g hg
      obtain ⟨hf,hwf⟩ := mem_filter.mp hf
      obtain ⟨hg,hwg⟩ := mem_filter.mp hg
      by_contra hfg
      exact Finset.disjoint_left.mp (hFd i f hf g hg hfg) hwf hwg)
    (by
      intro i
      simp only [Fintype.card_prod,Fintype.card_fin,mul_one]
      exact lt_of_le_of_lt (Nat.add_le_add_right hZ _) (hFc i))
  have huZ (i : Fin M) : u i∈Z := mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩)
  have hrZ (b : Option (Leaves (p::l))) : r b∈Z := mem_union_left _ (mem_image.mpr ⟨b,mem_univ _,rfl⟩)
  apply contains_of_children G l p M u r f (fun i j => hFr (i,j) _ (hf (i,j))) hfdis
  · intro i a j he
    exact Finset.disjoint_left.mp (hfZ i) (RootedPacking.mem_interior (f i) a) (he.symm ▸ huZ j)
  · intro i a b he
    exact Finset.disjoint_left.mp (hfZ i) (RootedPacking.mem_interior (f i) a) (he.symm ▸ hrZ b)
  · exact hur
  · exact hshort

end Erdos571.LayeredFanAssembly


set_option maxHeartbeats 2000000

namespace Erdos571.LayeredFanAssembly
open Finset SimpleGraph LayeredTrees DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

/-- The extra exclusion keeps the newly chosen short root separate from
all long roots in the tuple. -/
def boxRel (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (z u : W) (r : Leaves l → W) : Prop :=
  PackingRich G l p M u r ∧ ∀a, r a≠z

/-- Parent-power freeness forbids a complete grid of rich child tuples,
where different tuples have disjoint root footprints. -/
lemma box_no_packing (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (l : List ℕ) (p M : ℕ) (hM : 1 ≤ M)
    (hf : (graph (p::l) M).Free G) (z : W) (X : Leaves l → Finset W)
    (a : Fin M ↪ neighbors G U z) :
    ¬∃S⊆Fintype.piFinset X, S.card=p ∧
      (∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g)) ∧
      ∀f∈S, ∀i, boxRel G l p M z (a i) f := by
  rintro ⟨S,hSX,hS,hdis,hrel⟩
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by simpa using hS.symm)
  let u : Fin M ↪ W := a.trans (Function.Embedding.subtype _)
  let i₀ : Fin M := ⟨0,by omega⟩
  have hroot (j : Fin p) := (hrel (e j) (e j).property i₀).1.distinct
  let r : Option (Leaves (p::l)) ↪ W :=
    { toFun := fun x => match x with | none => z | some (j,b) => (e j).val b
      inj' := by
        rintro (_|⟨j,b⟩) (_|⟨k,c⟩) he
        · rfl
        · exact ((hrel (e k) (e k).property i₀).2 c he.symm).elim
        · exact ((hrel (e j) (e j).property i₀).2 b he).elim
        · by_cases hjk : j=k
          · subst k
            exact congrArg some (Prod.ext rfl ((hroot j).1 he))
          · have he' : (e j).val≠(e k).val := fun hh => hjk (e.injective (Subtype.ext hh))
            exact (Finset.disjoint_left.mp (hdis (e j) (e j).property (e k) (e k).property he')
              (mem_image.mpr ⟨b,mem_univ _,rfl⟩) (mem_image.mpr ⟨c,mem_univ _,he.symm⟩)).elim }
  apply hf (contains_of_rich_neighbors G l p M u r ?_ ?_ ?_)
  · intro i b
    cases b with
    | none => exact G.ne_of_adj (mem_filter.mp (a i).property).2.symm
    | some b => exact ((hrel (e b.1) (e b.1).property i).1.distinct).2 b.2
  · intro i
    exact (mem_filter.mp (a i).property).2.symm
  · intro i j
    exact (hrel (e j) (e j).property i).1

/-- A quantitative sparse-box bound for rich packings, valid for child
trees of arbitrary depth. -/
theorem box_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (l : List ℕ) (hl : 0 < l.prod) (p M : ℕ) (hM : 1 ≤ M)
    (hf : (graph (p::l) M).Free G) (z : W) (v : Leaves l → W)
    {D : ℝ} (hD : 1 ≤ D)
    (hz : ((neighbors G U z).card:ℝ) ≤ D)
    (hv : ∀a, ((neighbors G U (v a)).card:ℝ) ≤ D) :
    letI : DecidableRel (boxRel G l p M z) := fun _ _ => Classical.propDecidable _
    (((neighbors G U z ×ˢ Fintype.piFinset (fun a => neighbors G U (v a))).filter
      (fun x => boxRel G l p M z x.1 x.2)).card:ℝ) ≤
      TupleBoxKst.coefficient l.prod p M * D^((l.prod:ℝ)+1-1/(M:ℝ)) := by
  classical
  letI : Nonempty (Leaves l) := Fintype.card_pos_iff.mp (by simpa only [card_leaves] using hl)
  let A := neighbors G U z
  let X : Leaves l → Finset W := fun a => neighbors G U (v a)
  let P : A → (Leaves l → W) → Prop := fun a r => boxRel G l p M z a.val r
  have hb := TupleBoxKst.bound X P p M hM hD (by simpa only [Fintype.card_coe] using hz) hv
    (box_no_packing G U l p M hM hf z X)
  have he : ((univ ×ˢ Fintype.piFinset X).filter (fun x : A × (Leaves l → W) => P x.1 x.2)).card=
      ((A ×ˢ Fintype.piFinset X).filter (fun x => boxRel G l p M z x.1 x.2)).card := by
    apply card_bij (fun x _ => (x.1.val,x.2))
    · intro x hx
      obtain ⟨hx,hP⟩ := mem_filter.mp hx
      exact mem_filter.mpr ⟨mem_product.mpr ⟨x.1.property,(mem_product.mp hx).2⟩,hP⟩
    · intro x hx y hy hxy
      exact Prod.ext (Subtype.ext (Prod.mk.inj hxy).1) (Prod.mk.inj hxy).2
    · intro x hx
      obtain ⟨hx,hP⟩ := mem_filter.mp hx
      exact ⟨(⟨x.1,(mem_product.mp hx).1⟩,x.2),
        mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,(mem_product.mp hx).2⟩,hP⟩,rfl⟩
  simpa only [he,card_leaves] using hb

end Erdos571.LayeredFanAssembly


