namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization

/-- Counting all copies of a connected graph from a maximum-degree bound. -/
theorem all_bound {V W : Type} [Fintype V] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) {D : ℝ} (hD : 0 ≤ D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hmem : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ) ≤ U.card * D^(Fintype.card V-1) := by
  classical
  let v₀ : V := Classical.choice hH.nonempty
  apply RealFiberCount.bound F U (fun f => f v₀) (fun f hf => hmem f hf v₀)
  intro w hw
  have hb := bound H hH G U hD hdeg {v₀} (singleton_nonempty _) (fun _ => w)
    (F.filter (fun f => f v₀=w))
    (fun f hf => hmem f (mem_filter.mp hf).1) (by
      intro f hf v hv
      have he : v=v₀ := mem_singleton.mp hv
      subst v
      exact (mem_filter.mp hf).2)
  simpa only [card_singleton] using hb

end Erdos571.ConnectedCopyBound

namespace Erdos571.LayeredFanAssembly
open Finset SimpleGraph LayeredTrees DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def coreCopy (l : List ℕ) : (core l).Copy (template l) :=
  RootedIncidence.coreCopy (core l) (fun a r => a=rootAttach l r)

open Classical in
noncomputable def richCopies (G : SimpleGraph W) (U : Finset W) (l : List ℕ) (p M : ℕ) :
    Finset ((template l).Copy G) :=
  (TreeCopiesIn.copies (template l) G U).filter
    (fun f => PackingRich G l p M (f (.inr none)) (fun a => f (.inr (some a))))

/-- Rich child-copy families are lower-order globally in a parent-power-free
host. No bound on the load of a single interior vertex is assumed. -/
theorem rich_copies_bound_factored (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (l : List ℕ) (hl : 0 < l.prod) (p M : ℕ) (hM : 1 ≤ M)
    (hf : (graph (p::l) M).Free G) {D : ℝ} (hD : 1 ≤ D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    ((richCopies G U l p M).card:ℝ) ≤
      TupleBoxKst.coefficient l.prod p M * U.card * D^(nonroots l-1) *
        D^((l.prod:ℝ)+1-1/(M:ℝ)) := by
  classical
  let F := richCopies G U l p M
  let C := TreeCopiesIn.copies (core l) G U
  let ev : (template l).Copy G → (core l).Copy G := fun f => f.comp (coreCopy l)
  have hm (f) (hf : f∈F) : ∀a, f a∈U :=
    (TreeCopiesIn.mem_copies _ _ _ _).mp (mem_filter.mp hf).1
  have hmap : Set.MapsTo ev F C := by
    intro f hf
    exact (TreeCopiesIn.mem_copies _ _ _ _).mpr (fun a => hm f hf (.inl a))
  have hc := RealFiberCount.bound F C ev hmap
    (D := TupleBoxKst.coefficient l.prod p M * D^((l.prod:ℝ)+1-1/(M:ℝ))) (by
      intro g hg
      have hgU := (TreeCopiesIn.mem_copies _ _ _ _).mp hg
      let B := ((neighbors G U (g (anchor l))) ×ˢ
        Fintype.piFinset (fun a : Leaves l => neighbors G U (g (attach l a)))).filter
          (fun x => boxRel G l p M (g (anchor l)) x.1 x.2)
      have hb : (F.filter (fun f => ev f=g)).card ≤ B.card := by
        apply card_le_card_of_injOn (fun f => (f (.inr none),fun a => f (.inr (some a))))
        · intro f hf'
          obtain ⟨hf',he⟩ := mem_filter.mp hf'
          have hcore (a : Interior l) : f (.inl a)=g a :=
            congrArg (fun c : (core l).Copy G => c a) he
          refine mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hm f hf' _,?_⟩,?_⟩,
            (mem_filter.mp hf').2,?_⟩
          · rw [←hcore]
            exact f.toHom.map_adj (show (template l).Adj (.inl (anchor l)) (.inr none) from rfl)
          · apply Fintype.mem_piFinset.mpr
            intro a
            refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←hcore]
            exact f.toHom.map_adj (show (template l).Adj (.inl (attach l a)) (.inr (some a)) from rfl)
          · intro a
            rw [←hcore]
            exact f.injective.ne Sum.inr_ne_inl
        · intro f hf' g' hg' he
          have hh := (mem_filter.mp hf').2.trans (mem_filter.mp hg').2.symm
          have hc (a : Interior l) : f (.inl a)=g' (.inl a) :=
            congrArg (fun c : (core l).Copy G => c a) hh
          have hr := Prod.mk.inj he
          apply Copy.ext
          rintro (a|a)
          · exact hc a
          · cases a with
            | none => exact hr.1
            | some a => exact congrFun hr.2 a
      exact (show _ ≤ (B.card:ℝ) by exact_mod_cast hb).trans
        (box_bound G U l hl p M hM hf (g (anchor l)) (fun a => g (attach l a)) hD
          (hdeg _ (hgU _)) (fun a => hdeg _ (hgU _))))
  have hC := ConnectedCopyBound.all_bound (core l) (core_tree l).isConnected G U
    (by linarith) hdeg C (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  rw [card_interior] at hC
  have hh := mul_le_mul_of_nonneg_right hC
    (show 0 ≤ TupleBoxKst.coefficient l.prod p M * D^((l.prod:ℝ)+1-1/(M:ℝ)) by
      unfold TupleBoxKst.coefficient
      positivity)
  exact hc.trans (hh.trans_eq (by ring))

/-- The rich-copy error saves a fixed positive power of the maximum degree. -/
theorem rich_copies_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (l : List ℕ) (hl : 0 < l.prod) (p M : ℕ) (hM : 1 ≤ M)
    (hf : (graph (p::l) M).Free G) {D : ℝ} (hD : 1 ≤ D)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D) :
    ((richCopies G U l p M).card:ℝ) ≤
      TupleBoxKst.coefficient l.prod p M * U.card * D^((edges l:ℝ)-1/(M:ℝ)) := by
  have h := rich_copies_bound_factored G U l hl p M hM hf hD hdeg
  have he : ((nonroots l-1:ℕ):ℝ)+((l.prod:ℝ)+1-1/(M:ℝ))=(edges l:ℝ)-1/(M:ℝ) := by
    rw [Nat.cast_sub (nonroots_pos l),Nat.cast_one,edges_eq,Nat.cast_add]
    ring
  have hp : D^(nonroots l-1) * D^((l.prod:ℝ)+1-1/(M:ℝ))=D^((edges l:ℝ)-1/(M:ℝ)) := by
    rw [←Real.rpow_natCast,←Real.rpow_add (by linarith : 0 < D),he]
  exact h.trans_eq (by rw [mul_assoc _ _ (D^((l.prod:ℝ)+1-1/(M:ℝ))),hp])

end Erdos571.LayeredFanAssembly


set_option maxHeartbeats 2000000

namespace Erdos571.LayeredFanAssembly
open Finset SimpleGraph LayeredTrees DensityRegularization
variable {V W : Type} [Fintype V] [DecidableEq V] [Fintype W] [DecidableEq W]

lemma card_template (l : List ℕ) :
    Fintype.card (Interior l ⊕ Option (Leaves l))=edges l+1 := by
  rw [Fintype.card_sum,Fintype.card_option,card_interior,card_leaves,edges_eq]
  omega

/-- The lower-order rich-fiber bound persists after extending the child to
any fixed connected pattern. It therefore applies to every rerooted child
embedding of the same shape, not just the original downward branches. -/
theorem rich_subtree_bound (H : SimpleGraph V) (hH : H.Connected)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (l : List ℕ) (hl : 0 < l.prod) (p M : ℕ) (hM : 1 ≤ M)
    (hf : (graph (p::l) M).Free G) (e : (template l).Copy H)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, PackingRich G l p M (f (e (.inr none)))
      (fun a => f (e (.inr (some a))))) :
    (F.card:ℝ) ≤ TupleBoxKst.coefficient l.prod p M * U.card *
      D^(((Fintype.card V-1:ℕ):ℝ)-1/(M:ℝ)) := by
  classical
  have hv := Fintype.card_le_of_injective e e.injective
  rw [card_template] at hv
  have hb := ConnectedCopyBound.copy_restriction_bound H hH (template l) e G U
    (by linarith : 0 ≤ D) hdeg F (richCopies G U l p M) hm (by
      intro f hf
      exact mem_filter.mpr ⟨(TreeCopiesIn.mem_copies _ _ _ _).mpr (fun a => hm f hf _),hr f hf⟩)
  rw [card_template] at hb
  have hc := mul_le_mul_of_nonneg_right (rich_copies_bound G U l hl p M hM hf hD hdeg)
    (show 0 ≤ D^(Fintype.card V-(edges l+1)) by positivity)
  have he : ((edges l:ℝ)-1/(M:ℝ))+((Fintype.card V-(edges l+1):ℕ):ℝ)=
      ((Fintype.card V-1:ℕ):ℝ)-1/(M:ℝ) := by
    rw [Nat.cast_sub hv,Nat.cast_sub (by omega : 1 ≤ Fintype.card V)]
    push_cast
    ring
  have hp : D^((edges l:ℝ)-1/(M:ℝ))*D^(Fintype.card V-(edges l+1))=
      D^(((Fintype.card V-1:ℕ):ℝ)-1/(M:ℝ)) := by
    rw [←Real.rpow_natCast,←Real.rpow_add (by linarith : 0 < D),he]
  exact hb.trans (hc.trans_eq (by rw [mul_assoc _ _ (D^(Fintype.card V-(edges l+1))),hp]))

/-- Finitely many child embeddings can all be cleaned at the cost of one
fixed multiple of the same lower-order error. -/
theorem rich_subtrees_union_bound {I : Type} [Fintype I]
    (H : SimpleGraph V) (hH : H.Connected)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (l : List ℕ) (hl : 0 < l.prod) (p M : ℕ) (hM : 1 ≤ M)
    (hf : (graph (p::l) M).Free G) (e : I → (template l).Copy H)
    {D : ℝ} (hD : 1 ≤ D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, ∃i, PackingRich G l p M (f (e i (.inr none)))
      (fun a => f (e i (.inr (some a))))) :
    (F.card:ℝ) ≤ (Fintype.card I:ℝ) * TupleBoxKst.coefficient l.prod p M * U.card *
      D^(((Fintype.card V-1:ℕ):ℝ)-1/(M:ℝ)) := by
  classical
  let S (i : I) := F.filter (fun f => PackingRich G l p M (f (e i (.inr none)))
    (fun a => f (e i (.inr (some a)))))
  have hsub : F ⊆ univ.biUnion S := by
    intro f hf
    obtain ⟨i,hi⟩ := hr f hf
    exact mem_biUnion.mpr ⟨i,mem_univ _,mem_filter.mpr ⟨hf,hi⟩⟩
  have hc : (F.card:ℝ) ≤ ∑i : I, ((S i).card:ℝ) := by
    exact_mod_cast (card_le_card hsub).trans card_biUnion_le
  have hh := sum_le_sum (s := univ) (fun i hi => rich_subtree_bound H hH G U l hl p M hM hf
    (e i) hD hdeg (S i) (fun f hf => hm f (mem_filter.mp hf).1)
    (fun f hf => (mem_filter.mp hf).2))
  simp only [sum_const,card_univ,nsmul_eq_mul] at hh
  exact hc.trans (hh.trans_eq (by ring))

end Erdos571.LayeredFanAssembly


/-! A finite closure criterion for turning exclusions of genuine rooted
packings into a constant root-fiber bound. The criterion is explicit; it is
not asserted for the unresolved layered-tree families. -/
set_option maxHeartbeats 2000000

namespace Erdos571.RootedPruningClosure
open Finset SimpleGraph RootedSunflower

variable {A R W : Type} [Fintype A]

def Fixed (C : Finset A) : A ⊕ R → Prop
  | .inl a => a ∈ C
  | .inr _ => True

instance [DecidableEq A] (C : Finset A) : DecidablePred (Fixed (R := R) C) := by
  intro v
  cases v <;> unfold Fixed <;> infer_instance

/-- A genuine packing at a prescribed ordered root tuple. -/
def PackedAt {B S : Type} [Fintype B] (K : SimpleGraph (B ⊕ S))
    (G : SimpleGraph W) (r : S → W) (p : ℕ) : Prop :=
  ∃ f : Fin p → K.Copy G, (∀ i s, f i (.inr s) = r s) ∧
    Pairwise (fun i j => Disjoint (RootedPacking.interior (f i))
      (RootedPacking.interior (f j)))

/-- The child roots are fixed by the proposed extra core, whereas every
child interior lies outside it. -/
def Resolves {B S : Type} {H : SimpleGraph (A ⊕ R)}
    {K : SimpleGraph (B ⊕ S)} (e : K.Copy H) (C : Finset A) : Prop :=
  (∀ b, ¬Fixed C (e (.inl b))) ∧ ∀ s, Fixed C (e (.inr s))

lemma fixed_slice [DecidableEq A] (C : Finset A) {p : ℕ} (i j : Fin p)
    (v : A ⊕ R) (hv : Fixed C v) : slice C i v = slice C j v := by
  cases v with
  | inl a =>
    change a ∈ C at hv
    simp only [RootedSunflower.slice, dif_pos hv]
  | inr r => rfl

lemma free_slice_ne [DecidableEq A] (C : Finset A) {p : ℕ} {i j : Fin p}
    (hij : i ≠ j) (v w : A ⊕ R) (hv : ¬Fixed C v) (hw : ¬Fixed C w) :
    slice C i v ≠ slice C j w := by
  cases v with
  | inr r => exact (hv trivial).elim
  | inl a =>
    cases w with
    | inr r => exact (hw trivial).elim
    | inl b =>
      change a ∉ C at hv
      change b ∉ C at hw
      simp only [RootedSunflower.slice, dif_neg hv, dif_neg hw]
      intro h
      exact hij (congrArg (fun z : Fin p × {a : A // a ∉ C} => z.1) (Sum.inl.inj h))

/-- A child resolving a core extracts an actual disjoint packing from its
core power. No bound on any individual vertex load is used. -/
theorem packed_restrictions [DecidableEq A] {B S : Type} [Fintype B]
    {H : SimpleGraph (A ⊕ R)} {K : SimpleGraph (B ⊕ S)} {G : SimpleGraph W}
    (e : K.Copy H) (C : Finset A) (he : Resolves e C) {p : ℕ} (i₀ : Fin p)
    (g : (corePower H C p).Copy G) :
    PackedAt K G (fun s => g (slice C i₀ (e (.inr s)))) p := by
  classical
  let f : Fin p → K.Copy G := fun i => (g.comp (sliceCopy H C i)).comp e
  refine ⟨f, ?_, ?_⟩
  · intro i s
    change g (slice C i (e (.inr s))) = g (slice C i₀ (e (.inr s)))
    exact congrArg g (fixed_slice C i i₀ _ (he.2 s))
  · intro i j hij
    apply Finset.disjoint_left.mpr
    intro w hwi hwj
    simp only [RootedPacking.interior, mem_image, mem_univ, true_and] at hwi hwj
    obtain ⟨a, ha⟩ := hwi
    obtain ⟨b, hb⟩ := hwj
    have hh := g.injective (ha.trans hb.symm)
    exact free_slice_ne C hij (e (.inl a)) (e (.inl b)) (he.1 a) (he.1 b) hh

/-- Canonical sunflowers plus a collection resolving every proper extra core
bound the entire root fiber. The empty core must also be covered: normally
the parent template itself is included among the pruning rules for this case.
The exclusions concern genuine disjoint packings, not all homomorphisms. -/
theorem fiber_bound {J : Type} (B S : J → Type)
    [∀ j, Fintype (B j)] {H : SimpleGraph (A ⊕ R)}
    (K : ∀ j, SimpleGraph (B j ⊕ S j)) (e : ∀ j, (K j).Copy H)
    (hcover : ∀ C : Finset A, C ≠ univ → ∃ j, Resolves (e j) C)
    (G : SimpleGraph W) (p : ℕ) (hp : 2 ≤ p)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hpoor : ∀ f ∈ F, ∀ j, ¬PackedAt (K j) G
      (fun s => f (e j (.inr s))) p) :
    F.card ≤ RootedSunflower.bound (Fintype.card A) p := by
  classical
  by_contra! hlarge
  let labels : H.Copy G → A ↪ W := fun f => Function.Embedding.inl.trans f.toEmbedding
  have hinj : Set.InjOn labels F := by
    intro f hf g hg he
    apply Copy.ext
    intro v
    cases v with
    | inl a => exact congrArg (fun k : A ↪ W => k a) he
    | inr s => exact (hroot f hf s).trans (hroot g hg s).symm
  obtain ⟨P, hPF, hPc, hcan⟩ := RootedSunflower.labelled_sunflower
    (Fintype.card A) F labels p rfl hp hinj hlarge
  let idx : Fin p ≃ P := Fintype.equivOfCardEq (by simp only [Fintype.card_fin,
    Fintype.card_coe, hPc])
  let fs : Fin p → H.Copy G := fun i => (idx i).val
  have hfs : Function.Injective fs := Subtype.val_injective.comp idx.injective
  have hfr (i : Fin p) (s : R) : fs i (.inr s) = r s :=
    hroot _ (hPF (idx i).property) s
  have hfc : Canonical (fun i => (Function.Embedding.inl : A ↪ A ⊕ R).trans
      (fs i).toEmbedding) univ := by
    intro i hi j hj hij a b hab
    have hne : (idx i).val ≠ (idx j).val := fun h => hij (idx.injective (Subtype.ext h))
    obtain ⟨he, hfix⟩ := hcan _ (idx i).property _ (idx j).property hne a b hab
    exact ⟨he, fun k hk => hfix _ (idx k).property⟩
  obtain ⟨C, hC, g, hg⟩ := GenericRooted.corePower_contained_with_slices hp r fs hfs hfr hfc
  obtain ⟨j, hj⟩ := hcover C hC
  let i₀ : Fin p := ⟨0, by omega⟩
  have hpack := packed_restrictions (e j) C hj i₀ g
  have hroots : (fun s => g (slice C i₀ (e j (.inr s)))) =
      (fun s => fs i₀ (e j (.inr s))) := by
    funext s
    exact hg i₀ _
  rw [hroots] at hpack
  exact hpoor _ (hPF (idx i₀).property) j hpack

/-- Ordinary rooted-power freeness supplies the parent pruning rule. -/
lemma not_packedAt_of_free {H : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}
    {p : ℕ} (hp : 1 ≤ p) (hf : (RootedPacking.power H p).Free G) (r : R → W) :
    ¬PackedAt H G r p := by
  rintro ⟨f, hr, hd⟩
  let i₀ : Fin p := ⟨0, by omega⟩
  have hi : Function.Injective r := by
    intro a b hab
    exact Sum.inr.inj ((f i₀).injective
      ((hr i₀ a).trans (hab.trans (hr i₀ b).symm)))
  exact hf ⟨RootedPacking.powerCopy p ⟨r, hi⟩ f hr (fun i j hij => hd hij)⟩

/-- The finite-fiber criterion yields the usual global root-tuple bound. -/
theorem global_bound [Fintype R] [DecidableEq W] {J : Type} (B S : J → Type)
    [∀ j, Fintype (B j)] {H : SimpleGraph (A ⊕ R)}
    (K : ∀ j, SimpleGraph (B j ⊕ S j)) (e : ∀ j, (K j).Copy H)
    (hcover : ∀ C : Finset A, C ≠ univ → ∃ j, Resolves (e j) C)
    (G : SimpleGraph W) (p : ℕ) (hp : 2 ≤ p) (U : Finset W)
    (F : Finset (H.Copy G)) (hm : ∀ f ∈ F, ∀ r, f (.inr r) ∈ U)
    (hpoor : ∀ f ∈ F, ∀ j, ¬PackedAt (K j) G
      (fun s => f (e j (.inr s))) p) :
    (F.card : ℝ) ≤ (RootedSunflower.bound (Fintype.card A) p : ℝ) *
      (U.card : ℝ) ^ Fintype.card R := by
  apply RootedFiberCount.bound H G U F hm (Nat.cast_nonneg _)
  intro r F' hF' hr
  exact_mod_cast fiber_bound B S K e hcover G p hp F' r hr
    (fun f hf j => hpoor f (hF' hf) j)

end Erdos571.RootedPruningClosure


/-! Compatibility of the abstract pruning criterion with the already proved
layered packing-rich estimates. -/
set_option maxHeartbeats 2000000
namespace Erdos571.RootedPruningClosure
open Finset SimpleGraph LayeredTrees LayeredFanAssembly
variable {W : Type} [Fintype W]

lemma packedAt_rich (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (u : W) (r : Leaves l → W)
    (h : PackedAt (template l) G (fun s => s.elim u r)
      (packingThreshold l p M + 1)) : PackingRich G l p M u r := by
  classical
  obtain ⟨f, hr, hd⟩ := h
  have hi : Function.Injective f := by
    intro i j hij
    by_contra hne
    have hdis := hd hne
    have hm := RootedPacking.mem_interior (f i) (anchor l)
    exact Finset.disjoint_left.mp hdis hm (hij ▸ hm)
  refine ⟨univ.image f, ?_, ?_, ?_⟩
  · simp only [card_image_of_injective _ hi, card_univ, Fintype.card_fin]
    omega
  · intro g hg
    obtain ⟨i, hi, rfl⟩ := mem_image.mp hg
    exact ⟨hr i none, fun a => hr i (some a)⟩
  · intro g hg k hk hne
    obtain ⟨i, hi, rfl⟩ := mem_image.mp hg
    obtain ⟨j, hj, rfl⟩ := mem_image.mp hk
    exact hd (fun he => hne (congrArg f he))

lemma rich_packedAt (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (u : W) (r : Leaves l → W) (h : PackingRich G l p M u r) :
    PackedAt (template l) G (fun s => s.elim u r)
      (packingThreshold l p M + 1) := by
  classical
  obtain ⟨F, hF, hr, hd⟩ := h
  obtain ⟨P, hPF, hPc⟩ := exists_subset_card_eq (Nat.succ_le_of_lt hF)
  let idx : Fin (packingThreshold l p M + 1) ≃ P := Fintype.equivOfCardEq (by
    simp only [Fintype.card_fin, Fintype.card_coe, hPc])
  refine ⟨fun i => (idx i).val, ?_, ?_⟩
  · intro i s
    cases s with
    | none => exact (hr _ (hPF (idx i).property)).1
    | some a => exact (hr _ (hPF (idx i).property)).2 a
  · intro i j hij
    exact hd _ (hPF (idx i).property) _ (hPF (idx j).property)
      (fun he => hij (idx.injective (Subtype.ext he)))

/-- Packing richness and prescribed-root packing have exactly the same
meaning here, including the strict threshold and interior disjointness. -/
theorem packedAt_iff_rich (G : SimpleGraph W) (l : List ℕ) (p M : ℕ)
    (u : W) (r : Leaves l → W) :
    PackedAt (template l) G (fun s => s.elim u r)
      (packingThreshold l p M + 1) ↔ PackingRich G l p M u r :=
  ⟨packedAt_rich G l p M u r, rich_packedAt G l p M u r⟩

end Erdos571.RootedPruningClosure


/-! The combinatorial closure condition behind the two-level fan argument. -/
set_option maxHeartbeats 2000000
namespace Erdos571.RootedPruningClosure
open Finset SimpleGraph

/-- Every two-path with fixed endpoints has fixed middle vertex. This is the
closed-core condition left after excluding a free two-path packing. -/
def TwoClosed {A R : Type} (H : SimpleGraph (A ⊕ R)) (C : Finset A) : Prop :=
  ∀ u v w, H.Adj u v → H.Adj v w → u ≠ w →
    Fixed C u → Fixed C w → Fixed C v

end Erdos571.RootedPruningClosure

namespace Erdos571.FanSpider
open Finset SimpleGraph RootedPruningClosure

/-- Every nonempty proper two-closed core of a two-level fan is resolved by
one of its original or rerooted short-spider subtemplates. This is a purely
finite structural statement, separate from all extremal estimates. -/
theorem resolves_twoClosed (p q : ℕ) (C : Finset (Interior p q))
    (hC : C.Nonempty) (hproper : C ≠ univ)
    (hclosed : TwoClosed (template p q) C) :
    ∃ b : Branch p q, Resolves (subCopy b) C := by
  classical
  have htop (i : Fin p) (hi : Fixed C (hub i)) : Fixed C (center p q) :=
    hclosed (hub i) (center p q) (short p q) (adj_hub i).symm (adj_short p q)
      (by simp [hub, short]) hi trivial
  have hmid (i : Fin p) (j : Fin q) (hi : Fixed C (hub i)) : Fixed C (middle i j) :=
    hclosed (hub i) (middle i j) (root i j) (adj_middle i j) (adj_root i j)
      (by simp [hub, root]) hi trivial
  have hhub (i : Fin p) (j : Fin q) (hc : Fixed C (center p q))
      (hj : Fixed C (middle i j)) : Fixed C (hub i) :=
    hclosed (center p q) (hub i) (middle i j) (adj_hub i) (adj_middle i j)
      (by simp [center, middle]) hc hj
  by_cases hc : Fixed C (center p q)
  · have hex : ∃ i : Fin p, ¬Fixed C (hub i) := by
      by_contra! hh
      apply hproper
      apply eq_univ_of_forall
      rintro ((a | i) | ⟨i, j⟩)
      · have ha : a = 0 := Subsingleton.elim _ _
        subst a
        exact hc
      · exact hh i
      · exact hmid i j (hh i)
    obtain ⟨i, hi⟩ := hex
    refine ⟨.inl i, ?_, ?_⟩
    · intro a
      cases a with
      | none => exact hi
      | some j => exact fun h => hi (hhub i j hc h)
    · intro r
      cases r with
      | none => exact hc
      | some j => trivial
  · have hh (i : Fin p) : ¬Fixed C (hub i) := fun hi => hc (htop i hi)
    have hex : ∃ i : Fin p, ∃ j : Fin q, Fixed C (middle i j) := by
      obtain ⟨a, ha⟩ := hC
      rcases a with (a | i) | ⟨i, j⟩
      · have ha0 : a = 0 := Subsingleton.elim _ _
        subst a
        exact (hc ha).elim
      · exact (hh i ha).elim
      · exact ⟨i, j, ha⟩
    obtain ⟨i, j, hj⟩ := hex
    have hother (k : Fin q) (hkj : k ≠ j) : ¬Fixed C (middle i k) := by
      intro hk
      apply hh i
      exact hclosed (middle i j) (hub i) (middle i k) (adj_middle i j).symm
        (adj_middle i k) (by
          intro he
          exact hkj.symm (congrArg Prod.snd (Sum.inr.inj (Sum.inl.inj he)))) hj hk
    refine ⟨.inr (i, j), ?_, ?_⟩
    · intro a
      cases a with
      | none => exact hh i
      | some k =>
        change ¬Fixed C (if k = j then center p q else middle i k)
        split_ifs with hk
        · exact hc
        · exact hother k hk
    · intro r
      cases r with
      | none => exact hj
      | some k =>
        change Fixed C (if k = j then short p q else root i k)
        split_ifs <;> trivial

end Erdos571.FanSpider


/-! A precise finite obstruction to extending the two-level closure rule by
merely using the same immediate-child shape in depth three. This is NOT a
disproof of the rational Turan conjecture. -/
set_option maxHeartbeats 4000000
set_option maxRecDepth 10000
set_option synthInstance.maxSize 4096

namespace Erdos571.RootedPruningClosure
open Finset SimpleGraph
variable {A R B S : Type} [Fintype A] [Fintype R] [DecidableEq A]

/-- Neighbors whose roles are not fixed by a proposed sunflower core. -/
def freeNeighbors (H : SimpleGraph (A ⊕ R)) [DecidableRel H.Adj]
    (C : Finset A) (v : A ⊕ R) : Finset (A ⊕ R) :=
  univ.filter (fun w => H.Adj v w ∧ ¬Fixed C w)

lemma internal_neighbors_le [Fintype B] [Fintype S] [DecidableEq B]
    {H : SimpleGraph (A ⊕ R)} [DecidableRel H.Adj]
    {K : SimpleGraph (B ⊕ S)} [DecidableRel K.Adj]
    (e : K.Copy H) (C : Finset A) (he : Resolves e C) (v : B ⊕ S) :
    (univ.filter (fun b : B => K.Adj v (.inl b))).card ≤
      (freeNeighbors H C (e v)).card := by
  classical
  let L := univ.filter (fun b : B => K.Adj v (.inl b))
  have hi : Function.Injective (fun b : B => e (.inl b)) := e.injective.comp Sum.inl_injective
  have hs : L.image (fun b => e (.inl b)) ⊆ freeNeighbors H C (e v) := by
    intro w hw
    obtain ⟨b, hb, rfl⟩ := mem_image.mp hw
    exact mem_filter.mpr ⟨mem_univ _, e.toHom.map_adj (mem_filter.mp hb).2, he.1 b⟩
  simpa only [card_image_of_injective _ hi] using card_le_card hs

end Erdos571.RootedPruningClosure

namespace Erdos571.LayeredPruningObstruction
open Finset SimpleGraph RootedPruningClosure
abbrev A := LayeredTrees.Interior [2, 2, 2]
abbrev R := Option (LayeredTrees.Leaves [2, 2, 2])
abbrev H := LayeredTrees.template [2, 2, 2]

def core : Finset A :=
  {some (0, some (0, none)), some (0, some (0, some (0, ()))) ,
    some (0, some (0, some (1, ())))}

lemma core_nonempty : core.Nonempty := by decide
lemma core_proper : core ≠ univ := by decide

/-- A pinned bottom hub and its two terminal middles form a nonempty proper
core already closed under the light-two-path rule. -/
lemma core_twoClosed : TwoClosed H core := by
  unfold TwoClosed
  decide

def strongNeighbors (v : A ⊕ R) : Finset (A ⊕ R) :=
  (freeNeighbors H core v).filter (fun w => 3 ≤ (freeNeighbors H core w).card)

/-- At every free vertex adjacent to a fixed vertex, at most one remaining
neighbor has three free neighbors. The next lemma uses this finite test to
exclude ALL immediate-child embeddings, not just downward ones. -/
lemma boundary_test : ∀ v : A ⊕ R, ¬Fixed core v →
    (∃ r, H.Adj v r ∧ Fixed core r) → (strongNeighbors v).card ≤ 1 := by
  decide

instance fanDecidable : DecidableRel (FanSpider.template 2 2).Adj := by
  rintro ((a | i) | (u | j)) ((b | k) | (v | l))
  all_goals first | cases a | skip
  all_goals first | cases b | skip
  all_goals dsimp [FanSpider.template, AnchoredArms.template]
  all_goals infer_instance

lemma hub_internal_degree (i : Fin 2) :
    (univ.filter (fun b : FanSpider.Interior 2 2 =>
      (FanSpider.template 2 2).Adj (FanSpider.hub i) (.inl b))).card = 3 := by
  fin_cases i <;> decide

/-- No copy of the immediate child fan resolves this extra core. This
quantifies over every child copy in the parent, including rerootings. -/
theorem no_child_resolves (e : (FanSpider.template 2 2).Copy H) :
    ¬Resolves e core := by
  classical
  intro he
  have hx : ¬Fixed core (e (FanSpider.center 2 2)) := he.1 _
  have hb : ∃ r, H.Adj (e (FanSpider.center 2 2)) r ∧ Fixed core r :=
    ⟨e (FanSpider.short 2 2), e.toHom.map_adj (FanSpider.adj_short 2 2), he.2 _⟩
  have hup := boundary_test _ hx hb
  let f : Fin 2 → A ⊕ R := fun i => e (FanSpider.hub i)
  have hi : Function.Injective f := by
    intro i j hij
    exact Sum.inr.inj (Sum.inl.inj (Sum.inl.inj (e.injective hij)))
  have hs : univ.image f ⊆ strongNeighbors (e (FanSpider.center 2 2)) := by
    intro w hw
    obtain ⟨i, hi, rfl⟩ := mem_image.mp hw
    apply mem_filter.mpr
    refine ⟨mem_filter.mpr ⟨mem_univ _, e.toHom.map_adj (FanSpider.adj_hub i), he.1 _⟩, ?_⟩
    have h := internal_neighbors_le e core he (FanSpider.hub i)
    rw [hub_internal_degree] at h
    exact h
  have hlow : 2 ≤ (strongNeighbors (e (FanSpider.center 2 2))).card := by
    have h := card_le_card hs
    simpa only [card_image_of_injective _ hi, card_univ, Fintype.card_fin] using h
  omega

/-- Thus the parent rule, light two-paths and all immediate-child copies do
not form a resolving collection in depth three. An additional kind of
pruning estimate really is required for that proposed extension. -/
theorem closure_failure : ∃ C : Finset A, C.Nonempty ∧ C ≠ univ ∧
    TwoClosed H C ∧ ∀ e : (FanSpider.template 2 2).Copy H, ¬Resolves e C :=
  ⟨core, core_nonempty, core_proper, core_twoClosed, no_child_resolves⟩

end Erdos571.LayeredPruningObstruction


/-! Regularization without discarding the hereditary density bound. -/
namespace Erdos571.DensityRegularization
open Finset SimpleGraph
variable {V : Type*} [DecidableEq V]

theorem exists_almost_regular_local (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V)
    {β K : ℝ} (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2) (hK : 0 < K)
    (hKpow : 16 ≤ K^(β-1)) (hm : 0 < (arcs G S).card) :
    ∃ T ⊆ S, ∃ C d : ℝ, 0 < C ∧ 0 < d ∧ 0 < (arcs G T).card ∧
      ((arcs G S).card:ℝ) ≤ C*(S.card:ℝ)^β ∧
      C*(T.card:ℝ)^β ≤ 4*(arcs G T).card ∧
      (∀ W ⊆ T, ((arcs G W).card:ℝ) ≤ C*(W.card:ℝ)^β) ∧
      ∀ v ∈ T, d ≤ ((neighbors G T v).card:ℝ) ∧
        ((neighbors G T v).card:ℝ) ≤ 8*K*d := by
  classical
  obtain ⟨U,hUS,C,hC,hUm,hden,hSden,hlocal⟩ := exists_density_max G S (β := β) (by linarith) hm
  obtain ⟨T,hTU,harcs,hreg⟩ := regularize_local G U hβ1 hβ2 hC.le hK hKpow hUm hden hlocal
  have hUc : (0:ℝ) < U.card := by
    obtain ⟨⟨u,v⟩,he⟩ := card_pos.mp hUm
    exact_mod_cast card_pos.mpr ⟨u,(mem_arcs.mp he).1⟩
  have hUm' : (0:ℝ) < (arcs G U).card := by exact_mod_cast hUm
  let d : ℝ := (arcs G U).card/(8*(U.card:ℝ))
  have hd : 0 < d := div_pos hUm' (by positivity)
  have hTpos : 0 < (arcs G T).card := by
    have : (0:ℝ) < (arcs G T).card := by linarith
    exact_mod_cast this
  refine ⟨T,hTU.trans hUS,C,d,hC,hd,hTpos,hSden,?_,fun W hW => hlocal W (hW.trans hTU),?_⟩
  · have hcard : (T.card:ℝ) ≤ U.card := by exact_mod_cast card_le_card hTU
    calc
      _ ≤ C*(U.card:ℝ)^β := by gcongr
      _ = (arcs G U).card := hden.symm
      _ ≤ _ := harcs
  · intro v hv
    obtain ⟨hlo,hhi⟩ := hreg v hv
    constructor
    · apply (div_le_iff₀ (by positivity : (0:ℝ) < 8*(U.card:ℝ))).mpr
      nlinarith
    · apply (mul_le_mul_iff_right₀ hUc).mp
      have he : (U.card:ℝ)*(8*K*d) = K*(arcs G U).card := by
        dsimp [d]
        field_simp
        <;> ring
      rw [he]
      simpa only [mul_comm] using hhi

/-- A sharp upper-bound argument may retain hereditary density throughout
regularization. The constant C here is supplied by density maximization,
not an additional assumption on the original host. -/
theorem bound_of_almost_regular_local (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) {β K B : ℝ} (hβ1 : 1 ≤ β) (hβ2 : β ≤ 2)
    (hK : 0 < K) (hKpow : 16 ≤ K^(β-1)) (hB : 0 ≤ B)
    (hbound : ∀ T ⊆ S, ∀ C d : ℝ, 0 < C → 0 < d →
      C*(T.card:ℝ)^β ≤ 4*(arcs G T).card →
      (∀ W ⊆ T, ((arcs G W).card:ℝ) ≤ C*(W.card:ℝ)^β) →
      (∀ v ∈ T, d ≤ ((neighbors G T v).card:ℝ) ∧
        ((neighbors G T v).card:ℝ) ≤ 8*K*d) → C ≤ B) :
    ((arcs G S).card:ℝ) ≤ B*(S.card:ℝ)^β := by
  by_cases hz : (arcs G S).card=0
  · rw [hz,Nat.cast_zero]
    positivity
  obtain ⟨T,hTS,C,d,hC,hd,hTm,hSden,hTden,hlocal,hreg⟩ :=
    exists_almost_regular_local G S hβ1 hβ2 hK hKpow (by omega)
  exact hSden.trans (mul_le_mul_of_nonneg_right
    (hbound T hTS C d hC hd hTden hlocal hreg)
    (Real.rpow_nonneg (Nat.cast_nonneg _) _))

end Erdos571.DensityRegularization


/-! A hereditary density bound controls the second moment of degrees into
any prescribed vertex set. No pseudorandomness or freeness is assumed. -/
namespace Erdos571.NeighborhoodEnergy
open Finset SimpleGraph DensityRegularization

lemma square_mass_bound {V : Type*} [DecidableEq V]
    (U : Finset V) (f : V → ℝ) (s : ℕ) (hs : 0 < s) {D B : ℝ}
    (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hf : ∀ v ∈ U, 0 ≤ f v ∧ f v ≤ D)
    (hm : ∑ v ∈ U, f v ≤ D*s)
    (hsmall : ∀ T ⊆ U, T.card ≤ s → ∑ v ∈ T, f v ≤ B) :
    ∑ v ∈ U, (f v)^2 ≤ 2*D*B := by
  classical
  have hs' : (0 : ℝ) < s := by exact_mod_cast hs
  let T := U.filter (fun v => B < s*f v)
  have hTU : T ⊆ U := filter_subset _ _
  have hTc : T.card ≤ s := by
    by_contra! hc
    obtain ⟨Q, hQT, hQc⟩ := exists_subset_card_eq hc.le
    have hQne : Q.Nonempty := card_pos.mp (by omega)
    have hlt : ∑ _v ∈ Q, B < ∑ v ∈ Q, (s:ℝ)*f v := by
      exact sum_lt_sum_of_nonempty hQne (fun v hv => (mem_filter.mp (hQT hv)).2)
    simp only [sum_const, nsmul_eq_mul, ← mul_sum, hQc] at hlt
    have hle := hsmall Q (hQT.trans hTU) hQc.le
    have := mul_le_mul_of_nonneg_left hle hs'.le
    linarith
  have hhigh : ∑ v ∈ T, (f v)^2 ≤ D*B := by
    calc
      _ ≤ ∑ v ∈ T, D*f v := sum_le_sum (fun v hv => by
        have h := hf v (hTU hv)
        nlinarith)
      _ = D*(∑ v ∈ T, f v) := (mul_sum _ _ _).symm
      _ ≤ D*B := mul_le_mul_of_nonneg_left (hsmall T hTU hTc) hD
  have hlow : (s:ℝ)*(∑ v ∈ U\T, (f v)^2) ≤ (s:ℝ)*(D*B) := by
    calc
      _ = ∑ v ∈ U\T, (s:ℝ)*(f v)^2 := mul_sum _ _ _
      _ ≤ ∑ v ∈ U\T, B*f v := sum_le_sum (fun v hv => by
        have hvU := (mem_sdiff.mp hv).1
        have hn : (s:ℝ)*f v ≤ B := le_of_not_gt (fun h =>
          (mem_sdiff.mp hv).2 (mem_filter.mpr ⟨hvU,h⟩))
        have h := mul_le_mul_of_nonneg_right hn (hf v hvU).1
        nlinarith)
      _ = B*(∑ v ∈ U\T, f v) := (mul_sum _ _ _).symm
      _ ≤ B*(∑ v ∈ U, f v) := mul_le_mul_of_nonneg_left
        (sum_le_sum_of_subset_of_nonneg sdiff_subset (fun v hv _ => (hf v hv).1)) hB
      _ ≤ B*(D*s) := mul_le_mul_of_nonneg_left hm hB
      _ = _ := by ring
  have hlow' := (mul_le_mul_iff_right₀ hs').mp hlow
  have hsplit := sum_sdiff hTU (f := fun v => (f v)^2)
  linarith

variable {V : Type*} [DecidableEq V]

lemma degree_mass_swap (G : SimpleGraph V) [DecidableRel G.Adj] (U S : Finset V) :
    (∑ v ∈ U, ((neighbors G S v).card : ℝ)) =
      ∑ u ∈ S, ((neighbors G U u).card : ℝ) := by
  have h := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (s:=U) (t:=S) G.Adj
  have h' : (∑ v ∈ U, (neighbors G S v).card) =
      ∑ u ∈ S, (neighbors G U u).card := by
    simpa only [neighbors,bipartiteAbove,bipartiteBelow,G.adj_comm] using h
  exact_mod_cast h'

lemma rectangle_mass_le (G : SimpleGraph V) [DecidableRel G.Adj] (S T : Finset V) :
    (∑ v ∈ T, ((neighbors G S v).card : ℝ)) ≤ (arcs G (S ∪ T)).card := by
  have hsub : (T ×ˢ S).filter (fun p => G.Adj p.1 p.2) ⊆ arcs G (S ∪ T) := by
    rintro ⟨v,u⟩ hp
    obtain ⟨hmem, hadj⟩ := mem_filter.mp hp
    obtain ⟨hv,hu⟩ := mem_product.mp hmem
    exact mem_arcs.mpr ⟨mem_union_right _ hv, mem_union_left _ hu, hadj⟩
  have h := card_le_card hsub
  rw [rectangle_card] at h
  exact_mod_cast h

/-- The estimate has no logarithmic factor and holds for every positive
real density exponent. Degrees and the hereditary bound are both local to U. -/
theorem small_set_second_moment (G : SimpleGraph V) [DecidableRel G.Adj]
    (U S : Finset V) (hS : S ⊆ U) {α C D : ℝ}
    (hα : 0 < α) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hdeg : ∀ v ∈ U, ((neighbors G U v).card : ℝ) ≤ D)
    (hlocal : ∀ W ⊆ U, ((arcs G W).card : ℝ) ≤ C*(W.card : ℝ)^α) :
    ∑ v ∈ U, ((neighbors G S v).card : ℝ)^2 ≤
      2*C*D*(2*(S.card : ℝ))^α := by
  by_cases hs : S.card=0
  · have he : S=∅ := card_eq_zero.mp hs
    simp [he,neighbors,Real.zero_rpow hα.ne']
  have hs' : 0 < S.card := by omega
  have h := square_mass_bound U (fun v => ((neighbors G S v).card : ℝ)) S.card hs'
    (B := C*(2*(S.card : ℝ))^α) hD (mul_nonneg hC (Real.rpow_nonneg (by positivity) _)) ?_ ?_ ?_
  · convert h using 1 <;> ring
  · intro v hv
    refine ⟨Nat.cast_nonneg _, ?_⟩
    have hn : ((neighbors G S v).card : ℝ) ≤ (neighbors G U v).card := by
      exact_mod_cast card_le_card (neighbors_mono G hS v)
    exact hn.trans (hdeg v hv)
  · rw [degree_mass_swap]
    calc
      _ ≤ ∑ _u ∈ S, D := sum_le_sum (fun u hu => hdeg u (hS hu))
      _ = D*S.card := by simp [mul_comm]
  · intro T hT hTc
    have hbound := hlocal (S ∪ T) (union_subset hS hT)
    have hsize : ((S ∪ T).card : ℝ) ≤ 2*(S.card : ℝ) := by
      have h := card_union_le S T
      exact_mod_cast (show (S ∪ T).card ≤ 2*S.card by omega)
    exact (rectangle_mass_le G S T).trans (hbound.trans
      (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) hsize hα.le) hC))

end Erdos571.NeighborhoodEnergy

/-! Choosing mutually disjoint copies from separately supplied genuine packings. -/
namespace Erdos571.RootedPruningClosure
open Finset SimpleGraph

variable {A R W I : Type} [Fintype A] [Nonempty A] [Fintype I]

/-- A transversal of genuine packings can avoid a prescribed blacklist.
There is no assumption about loads in the family of all rooted copies. -/
theorem choose_packed {K : SimpleGraph (A ⊕ R)} {G : SimpleGraph W}
    (r : I → R → W) (p : ℕ) (Z : Finset W)
    (hpack : ∀ i, PackedAt K G (r i) p)
    (hp : Z.card + Fintype.card A * Fintype.card I < p) :
    ∃ f : I → K.Copy G, (∀ i s, f i (.inr s) = r i s) ∧
      (∀ i, Disjoint (RootedPacking.interior (f i)) Z) ∧
      Pairwise (fun i j => Disjoint (RootedPacking.interior (f i))
        (RootedPacking.interior (f j))) := by
  classical
  choose fs hr hd using hpack
  have hinj (i : I) : Function.Injective (fs i) := by
    intro j k he
    by_contra hne
    let a : A := Classical.arbitrary A
    exact Finset.disjoint_left.mp (hd i hne)
      (RootedPacking.mem_interior (fs i j) a)
      (he ▸ RootedPacking.mem_interior (fs i j) a)
  let F : I → Finset (K.Copy G) := fun i => univ.image (fs i)
  have hcard (i : I) : (F i).card = p := by
    simp only [F, card_image_of_injective _ (hinj i), card_univ, Fintype.card_fin]
  have hload (i : I) (w : W) :
      ((F i).filter (fun f => w ∈ RootedPacking.interior f)).card ≤ 1 := by
    apply card_le_one.mpr
    intro f hf g hg
    obtain ⟨hfm, hfw⟩ := mem_filter.mp hf
    obtain ⟨hgm, hgw⟩ := mem_filter.mp hg
    obtain ⟨j, hj, rfl⟩ := mem_image.mp hfm
    obtain ⟨k, hk, rfl⟩ := mem_image.mp hgm
    by_contra he
    exact Finset.disjoint_left.mp (hd i (fun h => he (congrArg (fs i) h))) hfw hgw
  obtain ⟨f, hf, hz, hdis⟩ := DisjointChoice.exists_choice_finite
    (Fintype.card A) 1 RootedPacking.interior F Z
    (by intro i f hf; exact (RootedPacking.interior_card f).le)
    hload (by intro i; simpa only [mul_one, hcard] using hp)
  refine ⟨f, ?_, hz, hdis⟩
  intro i s
  obtain ⟨j, hj, he⟩ := mem_image.mp (hf i)
  rw [← he]
  exact hr i j s

end Erdos571.RootedPruningClosure

/-! Replacing selected short root leaves by length-two arms. -/
namespace Erdos571.LeafArms
open Finset SimpleGraph
variable {A R J W : Type}

def short (K : SimpleGraph A) (E : A → R → Prop) (a : J → A) :
    SimpleGraph (A ⊕ (R ⊕ J)) :=
  RootedIncidence.graph K (fun v => Sum.elim (E v) (fun j => v = a j))

def longIncidence (E : A → R → Prop) : (A ⊕ J) → (R ⊕ J) → Prop
  | .inl v, .inl r => E v r
  | .inl _, .inr _ => False
  | .inr _, .inl _ => False
  | .inr j, .inr k => j = k

def long (K : SimpleGraph A) (E : A → R → Prop) (a : J → A) :
    SimpleGraph ((A ⊕ J) ⊕ (R ⊕ J)) :=
  RootedIncidence.graph (RootedIncidence.graph K (fun v j => v = a j))
    (longIncidence E)

/-- The old vertices and the shortened roots, reclassified as middles. -/
def old : (A ⊕ (R ⊕ J)) ↪ ((A ⊕ J) ⊕ (R ⊕ J)) where
  toFun := fun v => match v with
    | .inl v => .inl (.inl v)
    | .inr (.inl r) => .inr (.inl r)
    | .inr (.inr j) => .inl (.inr j)
  inj' := by
    rintro (a | (r | j)) (b | (s | k)) he <;> simp_all

def shortCopy (K : SimpleGraph A) (E : A → R → Prop) (a : J → A) :
    (short K E a).Copy (long K E a) where
  toHom :=
    { toFun := old
      map_rel' := by
        rintro (v | (r | j)) (w | (s | k)) h
        all_goals exact h }
  injective' := old.injective

def baseCopy (K : SimpleGraph A) (E : A → R → Prop) (a : J → A) :
    (RootedIncidence.graph K E).Copy (long K E a) where
  toHom :=
    { toFun := Sum.map Sum.inl Sum.inl
      map_rel' := by
        rintro (v | r) (w | s) h
        all_goals exact h }
  injective' := Sum.map_injective.mpr ⟨Sum.inl_injective, Sum.inl_injective⟩

def extendFun (f : (A ⊕ (R ⊕ J)) → W) (z : J → W) :
    ((A ⊕ J) ⊕ (R ⊕ J)) → W
  | .inl (.inl v) => f (.inl v)
  | .inl (.inr j) => f (.inr (.inr j))
  | .inr (.inl r) => f (.inr (.inl r))
  | .inr (.inr j) => z j

lemma extendFun_injective (f : (A ⊕ (R ⊕ J)) ↪ W) (z : J ↪ W)
    (hfresh : ∀ j v, z j ≠ f v) : Function.Injective (extendFun f z) := by
  rintro ((v | j) | (r | j)) ((w | k) | (s | k)) he
  all_goals simp only [extendFun] at he
  · exact congrArg (Sum.inl ∘ Sum.inl) (Sum.inl.inj (f.injective he))
  · exact (Sum.inl_ne_inr (f.injective he)).elim
  · exact (Sum.inl_ne_inr (f.injective he)).elim
  · exact (hfresh k _ he.symm).elim
  · exact (Sum.inr_ne_inl (f.injective he)).elim
  · exact congrArg (Sum.inl ∘ Sum.inr) (Sum.inr.inj (Sum.inr.inj (f.injective he)))
  · exact (Sum.inr_ne_inl (Sum.inr.inj (f.injective he))).elim
  · exact (hfresh k _ he.symm).elim
  · exact (Sum.inr_ne_inl (f.injective he)).elim
  · exact (Sum.inl_ne_inr (Sum.inr.inj (f.injective he))).elim
  · exact congrArg (Sum.inr ∘ Sum.inl) (Sum.inl.inj (Sum.inr.inj (f.injective he)))
  · exact (hfresh k _ he.symm).elim
  · exact (hfresh j _ he).elim
  · exact (hfresh j _ he).elim
  · exact (hfresh j _ he).elim
  · exact congrArg (Sum.inr ∘ Sum.inr) (z.injective he)

/-- Extend the shortened roots to pairwise distinct fresh terminal roots. -/
def extendCopy (K : SimpleGraph A) (E : A → R → Prop) (a : J → A)
    (G : SimpleGraph W) (f : (short K E a).Copy G) (z : J ↪ W)
    (hadj : ∀ j, G.Adj (f (.inr (.inr j))) (z j))
    (hfresh : ∀ j v, z j ≠ f v) : (long K E a).Copy G where
  toHom :=
    { toFun := extendFun f z
      map_rel' := by
        rintro ((v | j) | (r | j)) ((w | k) | (s | k)) h
        · exact f.toHom.map_adj h
        · exact f.toHom.map_adj h
        · exact f.toHom.map_adj h
        · exact h.elim
        · exact f.toHom.map_adj h
        · exact h.elim
        · exact h.elim
        · change j = k at h
          subst k
          exact hadj j
        · exact f.toHom.map_adj h
        · exact h.elim
        · exact h.elim
        · exact h.elim
        · exact h.elim
        · change k = j at h
          subst j
          exact (hadj k).symm
        · exact h.elim
        · exact h.elim }
  injective' := extendFun_injective f.toEmbedding z hfresh

lemma extendCopy_interior [Fintype A] [Fintype J] [DecidableEq W]
    (K : SimpleGraph A) (E : A → R → Prop) (a : J → A)
    (G : SimpleGraph W) (f : (short K E a).Copy G) (z : J ↪ W) (hadj) (hfresh) :
    RootedPacking.interior (extendCopy K E a G f z hadj hfresh) =
      RootedPacking.interior f ∪ univ.image (fun j => f (.inr (.inr j))) := by
  ext w
  simp only [RootedPacking.interior, mem_image, mem_univ, true_and, mem_union]
  constructor
  · rintro ⟨v, hv⟩
    cases v with
    | inl v => exact Or.inl ⟨v, hv⟩
    | inr j => exact Or.inr ⟨j, hv⟩
  · rintro (⟨v, hv⟩ | ⟨j, hj⟩)
    · exact ⟨.inl v, hv⟩
    · exact ⟨.inr j, hj⟩

end Erdos571.LeafArms

/-! Simultaneously extending packed short-leaf templates at distinct anchors. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LeafArms
open Finset SimpleGraph RootedPruningClosure DensityRegularization
variable {A R J W : Type} [Fintype A] [Nonempty A] [Fintype R] [Fintype J] [DecidableEq W]

/-- Number of copies that suffices to avoid all new roots, middles and
previously selected interiors. -/
def packingSize (A R J : Type) [Fintype A] [Fintype R] [Fintype J] (M : ℕ) : ℕ :=
  Fintype.card R + Fintype.card J + M * Fintype.card J + Fintype.card A * M + 1

/-- The new roots form an embedding. In particular, two terminal arms
cannot use the same anchor as their respective new roots. -/
theorem contains_of_packed (K : SimpleGraph A) (E : A → R → Prop) (a : J → A)
    (G : SimpleGraph W) (M : ℕ) (r : R ⊕ J ↪ W) (u : Fin M → J → W)
    (hu : ∀ i j, G.Adj (u i j) (r (.inr j)))
    (hur : ∀ i j s, u i j ≠ r s)
    (hdis : Pairwise (fun i k => Disjoint (TupleBoxPacking.foot (u i))
      (TupleBoxPacking.foot (u k))))
    (hpack : ∀ i, PackedAt (short K E a) G
      (Sum.elim (fun s => r (.inl s)) (u i)) (packingSize A R J M)) :
    (RootedPacking.power (long K E a) M).IsContained G := by
  classical
  let Z : Finset W := univ.image r ∪ univ.biUnion (fun i => TupleBoxPacking.foot (u i))
  have hZ : Z.card ≤ Fintype.card R + Fintype.card J + M * Fintype.card J := by
    calc
      _ ≤ (univ.image r).card + (univ.biUnion (fun i => TupleBoxPacking.foot (u i))).card := card_union_le _ _
      _ ≤ Fintype.card (R ⊕ J) + ∑ i : Fin M, (TupleBoxPacking.foot (u i)).card :=
        Nat.add_le_add (by simpa only [card_univ] using card_image_le (s := univ) (f := r)) card_biUnion_le
      _ ≤ Fintype.card (R ⊕ J) + ∑ _i : Fin M, Fintype.card J :=
        Nat.add_le_add_left (sum_le_sum (fun i _ => TupleBoxPacking.foot_card (u i))) _
      _ = _ := by simp
  obtain ⟨f, hfr, hfZ, hff⟩ := choose_packed
    (fun i => Sum.elim (fun s => r (.inl s)) (u i)) (packingSize A R J M) Z hpack
    (by simp only [Fintype.card_fin]; unfold packingSize; omega)
  have hrZ (s : R ⊕ J) : r s ∈ Z := mem_union_left _ (mem_image.mpr ⟨s, mem_univ _, rfl⟩)
  have huZ (i : Fin M) (j : J) : u i j ∈ Z :=
    mem_union_right _ (mem_biUnion.mpr ⟨i, mem_univ _, mem_image.mpr ⟨j, mem_univ _, rfl⟩⟩)
  let z : J ↪ W := Function.Embedding.inr.trans r
  have hadj (i : Fin M) (j : J) : G.Adj (f i (.inr (.inr j))) (z j) := by
    rw [hfr i (.inr j)]
    exact hu i j
  have hfresh (i : Fin M) (j : J) (v : A ⊕ (R ⊕ J)) : z j ≠ f i v := by
    intro he
    cases v with
    | inl v =>
      exact Finset.disjoint_left.mp (hfZ i)
        (RootedPacking.mem_interior (f i) v) (he ▸ hrZ (.inr j))
    | inr s =>
      rw [hfr i s] at he
      cases s with
      | inl s => exact Sum.inr_ne_inl (r.injective he)
      | inr k => exact hur i k (.inr j) he.symm
  let g : Fin M → (long K E a).Copy G := fun i => extendCopy K E a G (f i) z (hadj i) (hfresh i)
  have hgroot (i : Fin M) (s : R ⊕ J) : g i (.inr s) = r s := by
    cases s with
    | inl s => exact hfr i (.inl s)
    | inr j => rfl
  have hgint (i : Fin M) : RootedPacking.interior (g i) =
      RootedPacking.interior (f i) ∪ TupleBoxPacking.foot (u i) := by
    rw [extendCopy_interior]
    congr 1
    unfold TupleBoxPacking.foot
    congr 1
    funext j
    exact hfr i (.inr j)
  have hcross (i k : Fin M) : Disjoint (RootedPacking.interior (f i)) (TupleBoxPacking.foot (u k)) := by
    apply (hfZ i).mono_right
    intro w hw
    obtain ⟨j, hj, rfl⟩ := mem_image.mp hw
    exact huZ k j
  have hgdis (i k : Fin M) (hik : i ≠ k) : Disjoint (RootedPacking.interior (g i)) (RootedPacking.interior (g k)) := by
    rw [hgint, hgint, disjoint_union_left, disjoint_union_right, disjoint_union_right]
    exact ⟨⟨hff hik, hcross i k⟩, ⟨(hcross k i).symm, hdis hik⟩⟩
  exact ⟨RootedPacking.powerCopy M r g hgroot hgdis⟩

/-- A tuple box at distinct fresh anchors cannot contain a large matching
of genuinely packed shortened-root tuples in a parent-power-free host. -/
theorem packed_box_bound [Nonempty J]
    (K : SimpleGraph A) (E : A → R → Prop) (a : J → A)
    (G : SimpleGraph W) [DecidableRel G.Adj] (M D : ℕ)
    (hf : (RootedPacking.power (long K E a) M).Free G)
    (U : Finset W) (r : R ⊕ J ↪ W)
    (hdeg : ∀ j, (neighbors G U (r (.inr j))).card ≤ D)
    (F : Finset (J → W))
    (hF : ∀ u ∈ F, ∀ j, u j ∈ neighbors G U (r (.inr j)))
    (havoid : ∀ u ∈ F, ∀ j s, u j ≠ r s)
    (hpack : ∀ u ∈ F, PackedAt (short K E a) G
      (Sum.elim (fun s => r (.inl s)) u) (packingSize A R J M)) :
    F.card ≤ (Fintype.card J)^2 * M * D^(Fintype.card J - 1) := by
  classical
  apply TupleBoxPacking.no_packing_bound
    (fun j => neighbors G U (r (.inr j))) D M hdeg F
    (by intro u hu; exact Fintype.mem_piFinset.mpr (hF u hu))
  rintro ⟨S, hSF, hSc, hdis⟩
  let idx : Fin M ≃ S := Fintype.equivOfCardEq (by simp [hSc])
  let u : Fin M → J → W := fun i => (idx i).val
  apply hf (contains_of_packed K E a G M r u ?_ ?_ ?_ ?_)
  · intro i j
    exact ((mem_filter.mp (hF _ (hSF (idx i).property) j)).2).symm
  · intro i j s
    exact havoid _ (hSF (idx i).property) j s
  · intro i k hik
    exact hdis _ (idx i).property _ (idx k).property
      (fun he => hik (idx.injective (Subtype.ext he)))
  · intro i
    exact hpack _ (hSF (idx i).property)

end Erdos571.LeafArms

/-! A one-degree saving for simultaneous leaf shortening at distinct attachments. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LeafArms
open Finset SimpleGraph RootedPruningClosure DensityRegularization
variable {A R J W : Type} [Fintype A] [Nonempty A] [Fintype R] [Fintype J]
  [Nonempty J] [DecidableEq W]

/-- The retained roots and the selected distinct attachment vertices. -/
def anchorRoots (K : SimpleGraph A) (E : A → R → Prop) (a : J ↪ A)
    (G : SimpleGraph W) (g : (RootedIncidence.graph K E).Copy G) : R ⊕ J ↪ W where
  toFun := Sum.elim (fun r => g (.inr r)) (fun j => g (.inl (a j)))
  inj' := Sum.elim_injective.mpr ⟨g.injective.comp Sum.inr_injective,
    g.injective.comp (Sum.inl_injective.comp a.injective),
    fun r j he => Sum.inr_ne_inl (g.injective he)⟩

/-- Once the base and all arm middles have been fixed, every terminal tip
costs at most one factor of the maximum degree. -/
lemma tip_fiber_bound (K : SimpleGraph A) (E : A → R → Prop) (a : J → A)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (D : ℕ)
    (hdeg : ∀ v ∈ U, (neighbors G U v).card ≤ D)
    (F : Finset ((long K E a).Copy G))
    (hmem : ∀ f ∈ F, ∀ v, f v ∈ U)
    (hbase : ∀ f ∈ F, ∀ g ∈ F, f.comp (baseCopy K E a) = g.comp (baseCopy K E a))
    (hmid : ∀ f ∈ F, ∀ g ∈ F, ∀ j, f (.inl (.inr j)) = g (.inl (.inr j))) :
    F.card ≤ D^(Fintype.card J) := by
  classical
  by_cases hn : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hn, card_empty, zero_le]
  obtain ⟨f₀, hf₀⟩ := hn
  let X : J → Finset W := fun j => neighbors G U (f₀ (.inl (.inr j)))
  apply le_trans _ (TupleBoxPacking.box_card X D (fun j => hdeg _ (hmem f₀ hf₀ _)))
  apply card_le_card_of_injOn (fun f : (long K E a).Copy G => fun j => f (.inr (.inr j)))
  · intro f hf
    apply Fintype.mem_piFinset.mpr
    intro j
    apply mem_filter.mpr
    refine ⟨hmem f hf _, ?_⟩
    rw [← hmid f hf f₀ hf₀ j]
    exact f.toHom.map_adj (show (long K E a).Adj (.inl (.inr j)) (.inr (.inr j)) from rfl)
  · intro f hf g hg he
    apply Copy.ext
    rintro ((v | j) | (r | j))
    · exact congrArg (fun f : (RootedIncidence.graph K E).Copy G => f (.inl v)) (hbase f hf g hg)
    · exact hmid f hf g hg j
    · exact congrArg (fun f : (RootedIncidence.graph K E).Copy G => f (.inr r)) (hbase f hf g hg)
    · exact congrFun he j

/-- The attachment map is injective: this hypothesis is essential for using
its image as the distinct new-root tuple in the packing argument. The base
need not be a tree; its connectedness suffices for the count. -/
theorem rich_copies_bound (K : SimpleGraph A) (E : A → R → Prop) (a : J ↪ A)
    (hconn : (RootedIncidence.graph K E).Connected)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (D M : ℕ)
    (hdeg : ∀ v ∈ U, (neighbors G U v).card ≤ D)
    (hf : (RootedPacking.power (long K E a) M).Free G)
    (F : Finset ((long K E a).Copy G))
    (hmem : ∀ f ∈ F, ∀ v, f v ∈ U)
    (hpack : ∀ f ∈ F, PackedAt (short K E a) G
      (Sum.elim (fun r => f (.inr (.inl r))) (fun j => f (.inl (.inr j))))
      (packingSize A R J M)) :
    (F.card : ℝ) ≤ ((Fintype.card J)^2 * M : ℕ) * (U.card : ℝ) *
      (D : ℝ)^(Fintype.card A + Fintype.card R + 2 * Fintype.card J - 2) := by
  classical
  let pre : (long K E a).Copy G → (RootedIncidence.graph K E).Copy G :=
    fun f => f.comp (baseCopy K E a)
  let S := F.image pre
  let B : ℕ := D^(Fintype.card J) * ((Fintype.card J)^2 * M * D^(Fintype.card J - 1))
  have hfiber (g : (RootedIncidence.graph K E).Copy G) (hg : g ∈ S) :
      ((F.filter (fun f => pre f = g)).card : ℝ) ≤ B := by
    let F₁ := F.filter (fun f => pre f = g)
    let ev : (long K E a).Copy G → J → W := fun f j => f (.inl (.inr j))
    let R₁ := F₁.image ev
    let r := anchorRoots K E a G g
    have hpre (f : (long K E a).Copy G) (h : f ∈ F₁) (v : A ⊕ R) :
        f (baseCopy K E a v) = g v :=
      congrArg (fun f : (RootedIncidence.graph K E).Copy G => f v) (mem_filter.mp h).2
    have hmap (u : J → W) (hu : u ∈ R₁) (j : J) :
        u j ∈ neighbors G U (r (.inr j)) := by
      obtain ⟨f, hf₁, rfl⟩ := mem_image.mp hu
      apply mem_filter.mpr
      refine ⟨hmem f (mem_filter.mp hf₁).1 _, ?_⟩
      change G.Adj (g (.inl (a j))) (f (.inl (.inr j)))
      rw [← hpre f hf₁ (.inl (a j))]
      exact f.toHom.map_adj (show (long K E a).Adj (.inl (.inl (a j))) (.inl (.inr j)) from rfl)
    have havoid (u : J → W) (hu : u ∈ R₁) (j : J) (s : R ⊕ J) : u j ≠ r s := by
      obtain ⟨f, hf₁, rfl⟩ := mem_image.mp hu
      cases s with
      | inl s =>
        change f (.inl (.inr j)) ≠ g (.inr s)
        rw [← hpre f hf₁ (.inr s)]
        intro he
        exact Sum.inl_ne_inr (f.injective he)
      | inr k =>
        change f (.inl (.inr j)) ≠ g (.inl (a k))
        rw [← hpre f hf₁ (.inl (a k))]
        intro he
        exact Sum.inr_ne_inl (Sum.inl.inj (f.injective he))
    have hp (u : J → W) (hu : u ∈ R₁) : PackedAt (short K E a) G
        (Sum.elim (fun s => r (.inl s)) u) (packingSize A R J M) := by
      obtain ⟨f, hf₁, rfl⟩ := mem_image.mp hu
      have he : Sum.elim (fun s => r (.inl s)) (ev f) =
          Sum.elim (fun s => f (.inr (.inl s))) (fun j => f (.inl (.inr j))) := by
        funext s
        cases s with
        | inl s => exact (hpre f hf₁ (.inr s)).symm
        | inr j => rfl
      rw [he]
      exact hpack f (mem_filter.mp hf₁).1
    have hrU (j : J) : r (.inr j) ∈ U := by
      obtain ⟨f, hfF, he⟩ := mem_image.mp hg
      exact (hpre f (mem_filter.mpr ⟨hfF, he⟩) (.inl (a j))) ▸ hmem f hfF _
    have hRc := packed_box_bound K E a G M D hf U r
      (fun j => hdeg _ (hrU j)) R₁ hmap havoid hp
    have hfc (u : J → W) (hu : u ∈ F₁.image ev) :
        (F₁.filter (fun f => ev f = u)).card ≤ D^(Fintype.card J) := by
      apply tip_fiber_bound K E a G U D hdeg _
        (fun f h => hmem f (mem_filter.mp (mem_filter.mp h).1).1)
      · intro f hf₁ g hg₁
        exact (mem_filter.mp (mem_filter.mp hf₁).1).2.trans
          (mem_filter.mp (mem_filter.mp hg₁).1).2.symm
      · intro f hf₁ g hg₁ j
        exact congrFun ((mem_filter.mp hf₁).2.trans (mem_filter.mp hg₁).2.symm) j
    have hh := (card_le_mul_card_image F₁ (D^(Fintype.card J)) hfc).trans
      (Nat.mul_le_mul_left _ hRc)
    exact_mod_cast hh
  have hc := RealFiberCount.bound F S pre
    (fun f hf => mem_image.mpr ⟨f, hf, rfl⟩) hfiber
  have hs := ConnectedCopyBound.total (RootedIncidence.graph K E) hconn G U
    (Nat.cast_nonneg D) (fun v hv => by exact_mod_cast hdeg v hv) S (by
      intro g hg v
      obtain ⟨f, hfF, rfl⟩ := mem_image.mp hg
      exact hmem f hfF _)
  have ha := Fintype.card_pos (α := A)
  have hj := Fintype.card_pos (α := J)
  have hexp : Fintype.card A + Fintype.card R - 1 +
      Fintype.card J + (Fintype.card J - 1) =
      Fintype.card A + Fintype.card R + 2 * Fintype.card J - 2 := by omega
  calc
    _ ≤ (S.card : ℝ) * B := hc
    _ ≤ (U.card : ℝ) * (D : ℝ)^(Fintype.card A + Fintype.card R - 1) * B := by
      apply mul_le_mul_of_nonneg_right _ (Nat.cast_nonneg B)
      simpa only [Fintype.card_sum] using hs
    _ = _ := by
      simp only [B, Nat.cast_mul, Nat.cast_pow]
      rw [← hexp, pow_add, pow_add]
      ring

end Erdos571.LeafArms

/-! What two-closed pin sets imply for terminal length-two arms. -/
namespace Erdos571.LeafArms
open Finset SimpleGraph RootedPruningClosure
variable {A R J : Type}

/-- A fixed attachment and the fixed tip force the intervening middle. -/
lemma middle_fixed_of_attachment_fixed (K : SimpleGraph A) (E : A → R → Prop)
    (a : J → A) (C : Finset (A ⊕ J)) (hc : TwoClosed (long K E a) C)
    (j : J) (hj : Sum.inl (a j) ∈ C) : Sum.inr j ∈ C := by
  exact hc (.inl (.inl (a j))) (.inl (.inr j)) (.inr (.inr j))
    (show (long K E a).Adj (.inl (.inl (a j))) (.inl (.inr j)) from rfl)
    (show (long K E a).Adj (.inl (.inr j)) (.inr (.inr j)) from rfl)
    Sum.inl_ne_inr hj trivial

/-- Two distinct fixed arm middles at the same attachment force the
attachment into the fixed core. -/
lemma attachment_fixed_of_two_middles (K : SimpleGraph A) (E : A → R → Prop)
    (a : J → A) (C : Finset (A ⊕ J)) (hc : TwoClosed (long K E a) C)
    (j k : J) (hjk : j ≠ k) (haj : a j = a k)
    (hj : Sum.inr j ∈ C) (hk : Sum.inr k ∈ C) : Sum.inl (a j) ∈ C := by
  exact hc (.inl (.inr j)) (.inl (.inl (a j))) (.inl (.inr k))
    (show (long K E a).Adj (.inl (.inr j)) (.inl (.inl (a j))) from rfl)
    (show (long K E a).Adj (.inl (.inl (a j))) (.inl (.inr k)) from haj)
    (fun h => hjk (Sum.inr.inj (Sum.inl.inj h))) hj hk

/-- A fixed base neighbor and a fixed arm middle also force their shared
attachment. In particular an attachment with a retained root neighbor
cannot remain free while one of its arm middles is fixed. -/
lemma attachment_fixed_of_base_neighbor (K : SimpleGraph A) (E : A → R → Prop)
    (a : J → A) (C : Finset (A ⊕ J)) (hc : TwoClosed (long K E a) C)
    (j : J) (v : A ⊕ R)
    (hadj : (RootedIncidence.graph K E).Adj v (.inl (a j)))
    (hv : Fixed C (baseCopy K E a v)) (hj : Sum.inr j ∈ C) :
    Sum.inl (a j) ∈ C := by
  apply hc (baseCopy K E a v) (.inl (.inl (a j))) (.inl (.inr j))
    ((baseCopy K E a).toHom.map_adj hadj)
    (show (long K E a).Adj (.inl (.inl (a j))) (.inl (.inr j)) from rfl)
    ?_ hv hj
  cases v with
  | inl v => exact fun h => Sum.inl_ne_inr (Sum.inl.inj h)
  | inr r => exact Sum.inr_ne_inl

/-- Among fixed middles whose attachments remain free, the attachment map
is injective. Other attachments are allowed to lie in the core. -/
theorem free_attachment_injective (K : SimpleGraph A) (E : A → R → Prop)
    (a : J → A) (C : Finset (A ⊕ J)) (hc : TwoClosed (long K E a) C) :
    Function.Injective (fun j : {j : J // Sum.inr j ∈ C ∧ Sum.inl (a j) ∉ C} => a j.val) := by
  intro j k he
  apply Subtype.ext
  by_contra hjk
  exact j.property.2 (attachment_fixed_of_two_middles K E a C hc
    j.val k.val hjk he j.property.1 k.property.1)

/-- For a core consisting only of terminal middles, distinct attachments
are automatic. This justifies using the distinct-anchor shortening estimate
for such a core, not for arbitrary cores containing hubs. -/
theorem middle_only_attachment_injective (K : SimpleGraph A) (E : A → R → Prop)
    (a : J → A) (C : Finset (A ⊕ J)) (hc : TwoClosed (long K E a) C)
    (hfree : ∀ v : A, Sum.inl v ∉ C) :
    Function.Injective (fun j : {j : J // Sum.inr j ∈ C} => a j.val) := by
  intro j k he
  apply Subtype.ext
  by_contra hjk
  exact hfree (a j.val) (attachment_fixed_of_two_middles K E a C hc
    j.val k.val hjk he j.property k.property)

end Erdos571.LeafArms

/-! Rectangular consequences of a hereditary induced-density bound. -/
namespace Erdos571.NeighborhoodEnergy
open Finset SimpleGraph DensityRegularization

/-- If every small subset has bounded mass, then its average bounds the
average over every larger set. No sign assumptions on the masses are needed. -/
lemma mass_of_small_subsets {V : Type*} [DecidableEq V] (U : Finset V)
    (f : V → ℝ) (s : ℕ) (hs : 0 < s) (B : ℝ) (hsU : s ≤ U.card)
    (hsmall : ∀ Q ⊆ U, Q.card ≤ s → ∑ v ∈ Q, f v ≤ B) :
    (s : ℝ) * (∑ v ∈ U, f v) ≤ U.card * B := by
  induction U using Finset.strongInductionOn with
  | _ U ih =>
    by_cases he : U.card = s
    · rw [he]
      exact mul_le_mul_of_nonneg_left (hsmall U Subset.rfl he.le) (Nat.cast_nonneg s)
    have hlt : s < U.card := by omega
    obtain ⟨v, hv, hmin⟩ := U.exists_min_image f (card_pos.mp (by omega))
    obtain ⟨Q, hQU, hQc⟩ := exists_subset_card_eq hsU
    have hvB : (s : ℝ) * f v ≤ B := by
      calc
        _ = ∑ _w ∈ Q, f v := by simp [hQc]
        _ ≤ ∑ w ∈ Q, f w := sum_le_sum (fun w hw => hmin w (hQU hw))
        _ ≤ B := hsmall Q hQU hQc.le
    have hE : s ≤ (U.erase v).card := by rw [card_erase_of_mem hv]; omega
    have hrec := ih (U.erase v) (erase_ssubset hv) hE
      (fun Q hQE hQs => hsmall Q (hQE.trans (erase_subset v U)) hQs)
    have hsum := sum_erase_add U f hv
    have hcard : ((U.erase v).card : ℝ) + 1 = U.card := by
      exact_mod_cast card_erase_add_one hv
    calc
      _ = (s : ℝ) * (∑ w ∈ U.erase v, f w) + (s : ℝ) * f v := by rw [← hsum, mul_add]
      _ ≤ ((U.erase v).card : ℝ) * B + B := add_le_add hrec hvB
      _ = (((U.erase v).card : ℝ) + 1) * B := by ring
      _ = _ := by rw [hcard]

variable {V : Type*} [DecidableEq V]

/-- Hereditary density bounds have a stronger rectangular form. This bound
remains useful when one side is much smaller than the other. -/
theorem hereditary_rectangle_mul (G : SimpleGraph V) [DecidableRel G.Adj]
    (U S T : Finset V) (hS : S ⊆ U) (hT : T ⊆ U)
    (hs : 0 < S.card) (hst : S.card ≤ T.card) {α C : ℝ}
    (hα : 0 < α) (hC : 0 ≤ C)
    (hlocal : ∀ W ⊆ U, ((arcs G W).card : ℝ) ≤ C * (W.card : ℝ)^α) :
    (S.card : ℝ) * (∑ v ∈ T, ((neighbors G S v).card : ℝ)) ≤
      C * T.card * (2 * (S.card : ℝ))^α := by
  have hm := mass_of_small_subsets T (fun v => ((neighbors G S v).card : ℝ))
    S.card hs (C * (2 * (S.card : ℝ))^α) hst ?_
  · simpa only [mul_left_comm, mul_assoc] using hm
  · intro Q hQT hQs
    have hsize : ((S ∪ Q).card : ℝ) ≤ 2 * (S.card : ℝ) := by
      have hh := card_union_le S Q
      exact_mod_cast (show (S ∪ Q).card ≤ 2 * S.card by omega)
    exact (rectangle_mass_le G S Q).trans
      ((hlocal (S ∪ Q) (union_subset hS (hQT.trans hT))).trans
        (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) hsize hα.le) hC))

/-- In particular, cross-incidences are at most
`2^α C |S|^(α-1) |T|` when `0 < |S| ≤ |T|`. -/
theorem hereditary_rectangle (G : SimpleGraph V) [DecidableRel G.Adj]
    (U S T : Finset V) (hS : S ⊆ U) (hT : T ⊆ U)
    (hs : 0 < S.card) (hst : S.card ≤ T.card) {α C : ℝ}
    (hα : 0 < α) (hC : 0 ≤ C)
    (hlocal : ∀ W ⊆ U, ((arcs G W).card : ℝ) ≤ C * (W.card : ℝ)^α) :
    ∑ v ∈ T, ((neighbors G S v).card : ℝ) ≤
      2^α * C * (S.card : ℝ)^(α-1) * T.card := by
  have hs' : (0 : ℝ) < S.card := by exact_mod_cast hs
  apply (mul_le_mul_iff_right₀ hs').mp
  calc
    _ ≤ C * T.card * (2 * (S.card : ℝ))^α :=
      hereditary_rectangle_mul G U S T hS hT hs hst hα hC hlocal
    _ = _ := by
      rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) hs'.le,
        Real.rpow_sub hs', Real.rpow_one]
      field_simp

end Erdos571.NeighborhoodEnergy


/-! Pruning all pin sets disjoint from a designated core reduces packing
and collision questions to that core, without bounding the whole root fiber. -/
set_option maxHeartbeats 2000000
namespace Erdos571.RootedPruningClosure
open Finset SimpleGraph RootedSunflower

variable {A R W : Type} [Fintype A]

noncomputable def interiorOn [DecidableEq W] {H : SimpleGraph (A ⊕ R)}
    {G : SimpleGraph W} (f : H.Copy G) (D : Finset A) : Finset W :=
  D.image (fun a => f (.inl a))

lemma mem_interiorOn [DecidableEq W] {H : SimpleGraph (A ⊕ R)}
    {G : SimpleGraph W} (f : H.Copy G) (D : Finset A) {a : A} (ha : a ∈ D) :
    f (.inl a) ∈ interiorOn f D := mem_image.mpr ⟨a, ha, rfl⟩

/-- Only extra pin sets disjoint from D have to be resolved. The conclusion
bounds families with disjoint D-images, not all copies in the root fiber. -/
theorem core_disjoint_fiber_bound [DecidableEq W] {J : Type} (B S : J → Type)
    [∀ j, Fintype (B j)] {H : SimpleGraph (A ⊕ R)}
    (K : ∀ j, SimpleGraph (B j ⊕ S j)) (e : ∀ j, (K j).Copy H)
    (D : Finset A)
    (hcover : ∀ C : Finset A, C ≠ univ → Disjoint C D → ∃ j, Resolves (e j) C)
    (G : SimpleGraph W) (p : ℕ) (hp : 2 ≤ p)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hdis : ∀ f ∈ F, ∀ g ∈ F, f ≠ g → Disjoint (interiorOn f D) (interiorOn g D))
    (hpoor : ∀ f ∈ F, ∀ j, ¬PackedAt (K j) G
      (fun s => f (e j (.inr s))) p) :
    F.card ≤ RootedSunflower.bound (Fintype.card A) p := by
  classical
  by_contra! hlarge
  let labels : H.Copy G → A ↪ W := fun f => Function.Embedding.inl.trans f.toEmbedding
  have hinj : Set.InjOn labels F := by
    intro f hf g hg he
    apply Copy.ext
    intro v
    cases v with
    | inl a => exact congrArg (fun k : A ↪ W => k a) he
    | inr s => exact (hroot f hf s).trans (hroot g hg s).symm
  obtain ⟨P, hPF, hPc, hcan⟩ := RootedSunflower.labelled_sunflower
    (Fintype.card A) F labels p rfl hp hinj hlarge
  let idx : Fin p ≃ P := Fintype.equivOfCardEq (by simp only [Fintype.card_fin,
    Fintype.card_coe, hPc])
  let fs : Fin p → H.Copy G := fun i => (idx i).val
  have hfs : Function.Injective fs := Subtype.val_injective.comp idx.injective
  have hfr (i : Fin p) (s : R) : fs i (.inr s) = r s :=
    hroot _ (hPF (idx i).property) s
  have hfc : Canonical (fun i => (Function.Embedding.inl : A ↪ A ⊕ R).trans
      (fs i).toEmbedding) univ := by
    intro i hi j hj hij a b hab
    have hne : (idx i).val ≠ (idx j).val := fun h => hij (idx.injective (Subtype.ext h))
    obtain ⟨he, hfix⟩ := hcan _ (idx i).property _ (idx j).property hne a b hab
    exact ⟨he, fun k hk => hfix _ (idx k).property⟩
  obtain ⟨C, hC, g, hg⟩ := GenericRooted.corePower_contained_with_slices hp r fs hfs hfr hfc
  let i₀ : Fin p := ⟨0, by omega⟩
  let i₁ : Fin p := ⟨1, by omega⟩
  have h01 : i₀ ≠ i₁ := by intro h; have := congrArg Fin.val h; simp [i₀, i₁] at this
  have hCD : Disjoint C D := by
    apply Finset.disjoint_left.mpr
    intro a haC haD
    have he : fs i₀ (.inl a) = fs i₁ (.inl a) := by
      rw [← hg i₀ (.inl a), ← hg i₁ (.inl a)]
      exact congrArg g (fixed_slice C i₀ i₁ (.inl a) haC)
    exact Finset.disjoint_left.mp
      (hdis _ (hPF (idx i₀).property) _ (hPF (idx i₁).property) (hfs.ne h01))
      (mem_interiorOn (fs i₀) D haD) (he.symm ▸ mem_interiorOn (fs i₁) D haD)
  obtain ⟨j, hj⟩ := hcover C hC hCD
  have hpack := packed_restrictions (e j) C hj i₀ g
  have hroots : (fun s => g (slice C i₀ (e j (.inr s)))) =
      (fun s => fs i₀ (e j (.inr s))) := by
    funext s
    exact hg i₀ _
  rw [hroots] at hpack
  exact hpoor _ (hPF (idx i₀).property) j hpack

/-- The preceding bound excludes a large core-disjoint packing inside any
fixed-root subfamily. Full interiors are not required to be disjoint. -/
theorem no_core_packing [DecidableEq W] {J : Type} (B S : J → Type)
    [∀ j, Fintype (B j)] {H : SimpleGraph (A ⊕ R)}
    (K : ∀ j, SimpleGraph (B j ⊕ S j)) (e : ∀ j, (K j).Copy H)
    (D : Finset A)
    (hcover : ∀ C : Finset A, C ≠ univ → Disjoint C D → ∃ j, Resolves (e j) C)
    (G : SimpleGraph W) (p : ℕ) (hp : 2 ≤ p)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hpoor : ∀ f ∈ F, ∀ j, ¬PackedAt (K j) G
      (fun s => f (e j (.inr s))) p) :
    ¬∃ P ⊆ F, P.card = RootedSunflower.bound (Fintype.card A) p + 1 ∧
      ∀ f ∈ P, ∀ g ∈ P, f ≠ g → Disjoint (interiorOn f D) (interiorOn g D) := by
  rintro ⟨P, hPF, hPc, hdis⟩
  have hh := core_disjoint_fiber_bound B S K e D hcover G p hp P r
    (fun f hf => hroot f (hPF hf)) hdis (fun f hf => hpoor f (hPF hf))
  omega

open Classical in
/-- Arbitrary nonnegative weights give a collision bound involving only
images of the designated core. No bound on the full root fiber is assumed. -/
theorem weighted_core_bound [DecidableEq W] {J : Type} (B S : J → Type)
    [∀ j, Fintype (B j)] {H : SimpleGraph (A ⊕ R)}
    (K : ∀ j, SimpleGraph (B j ⊕ S j)) (e : ∀ j, (K j).Copy H)
    (D : Finset A) (hD : D.Nonempty)
    (hcover : ∀ C : Finset A, C ≠ univ → Disjoint C D → ∃ j, Resolves (e j) C)
    (G : SimpleGraph W) (p : ℕ) (hp : 2 ≤ p)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hpoor : ∀ f ∈ F, ∀ j, ¬PackedAt (K j) G
      (fun s => f (e j (.inr s))) p)
    (w : H.Copy G → ℝ) (hw : ∀ f ∈ F, 0 ≤ w f) :
    (∑ f ∈ F, w f)^2 ≤ (RootedSunflower.bound (Fintype.card A) p : ℝ) *
      ∑ fg ∈ PackingEnergy.pairs F
        (fun f g => ¬Disjoint (interiorOn f D) (interiorOn g D)), w fg.1 * w fg.2 := by
  classical
  have hb : 1 ≤ RootedSunflower.bound (Fintype.card A) p := by
    unfold RootedSunflower.bound
    have hfac := Nat.factorial_pos (Fintype.card A)
    have hpow : 0 < (p - 1) ^ Fintype.card A := pow_pos (by omega) _
    have : 0 < (Fintype.card A).factorial ^ 2 * (p-1)^Fintype.card A :=
      Nat.mul_pos (pow_pos hfac _) hpow
    omega
  have hn (f : H.Copy G) : (interiorOn f D).Nonempty := hD.image _
  have he := PackingEnergy.weighted_bound F
    (fun f g => ¬Disjoint (interiorOn f D) (interiorOn g D))
    (fun f hf hd => (hn f).ne_empty (disjoint_self.mp hd))
    (fun f hf g hg hd hgd => hd hgd.symm)
    (RootedSunflower.bound (Fintype.card A) p + 1) (by omega) (by
      simpa only [not_not] using no_core_packing B S K e D hcover G p hp F r hroot hpoor)
    w hw
  simpa only [Nat.add_sub_cancel] using he

end Erdos571.RootedPruningClosure


/-! A Gram-matrix Cauchy inequality for hub-pin energies. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U W R : Type*} [Fintype U] [Fintype W] [Fintype R]

noncomputable def squareMass (A : Matrix U W ℝ) : ℝ := ∑ u, ∑ w, (A u w)^2

lemma squareMass_nonneg (A : Matrix U W ℝ) : 0 ≤ squareMass A :=
  sum_nonneg (fun u _ => sum_nonneg (fun w _ => sq_nonneg _))

lemma squareMass_trace (A : Matrix U W ℝ) : squareMass A = (A * A.transpose).trace := by
  simp only [squareMass, Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.transpose_apply, pow_two]

lemma gram_squareMass (B : Matrix W R ℝ) :
    squareMass (B * B.transpose) = squareMass (B.transpose * B) := by
  rw [squareMass_trace, squareMass_trace]
  simp only [Matrix.transpose_mul, Matrix.transpose_transpose]
  simpa only [Matrix.mul_assoc] using
    Matrix.trace_mul_cycle B (B.transpose * B) B.transpose

lemma chain_gram_identity (A : Matrix U W ℝ) (B : Matrix W R ℝ) :
    squareMass (A * B) = ∑ w, ∑ z,
      (A.transpose * A) w z * (B * B.transpose) w z := by
  rw [squareMass_trace]
  simp only [Matrix.transpose_mul]
  have hcyc : (A * B * (B.transpose * A.transpose)).trace =
      ((A.transpose * A) * (B * B.transpose)).trace := by
    simpa only [Matrix.mul_assoc] using
      Matrix.trace_mul_cycle A (B * B.transpose) A.transpose
  rw [hcyc]
  simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.transpose_apply]
  apply sum_congr rfl
  intro w hw
  apply sum_congr rfl
  intro z hz
  congr 1
  apply sum_congr rfl
  intro x hx
  ring

/-- The fourth power of the Frobenius norm of `A B` is controlled by the
row-Gram energy of A and column-Gram energy of B. B may already have been
capped or masked; no factorization of B is assumed. -/
theorem chain_gram_cauchy (A : Matrix U W ℝ) (B : Matrix W R ℝ) :
    squareMass (A * B)^2 ≤
      squareMass (A.transpose * A) * squareMass (B.transpose * B) := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (W × W))
    (fun p => (A.transpose * A) p.1 p.2) (fun p => (B * B.transpose) p.1 p.2)
  simp only [Fintype.sum_prod_type] at h
  rw [chain_gram_identity]
  change _ ≤ squareMass (A.transpose * A) * squareMass (B.transpose * B)
  rw [← gram_squareMass B]
  exact h

/-- A hub contribution dominated by one arm feature times a chained feature
obeys the corresponding squared pin bound. This is an algebraic estimate,
not a freeness or genuine-copy statement. -/
theorem hub_pin_bound (A : Matrix U W ℝ) (B : Matrix W R ℝ)
    (F : Matrix U R ℝ) (L : U → R → R → ℝ) (K : ℝ)
    (hK : 0 ≤ K) (hrow : ∀ u, ∑ x, (F u x)^2 ≤ K)
    (hL : ∀ u x y, 0 ≤ L u x y ∧ L u x y ≤ F u x * (A * B) u y) :
    (∑ u, ∑ x, ∑ y, (L u x y)^2)^2 ≤
      K^2 * squareMass (A.transpose * A) * squareMass (B.transpose * B) := by
  have hb : (∑ u, ∑ x, ∑ y, (L u x y)^2) ≤ K * squareMass (A * B) := by
    calc
      _ ≤ ∑ u, ∑ x, ∑ y, (F u x * (A * B) u y)^2 :=
        sum_le_sum (fun u _ => sum_le_sum (fun x _ => sum_le_sum (fun y _ =>
          pow_le_pow_left₀ (hL u x y).1 (hL u x y).2 2)))
      _ = ∑ u, (∑ x, (F u x)^2) * (∑ y, ((A * B) u y)^2) := by
        simp only [sum_mul_sum, mul_pow]
      _ ≤ ∑ u, K * (∑ y, ((A * B) u y)^2) :=
        sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hrow u)
          (sum_nonneg (fun y _ => sq_nonneg _)))
      _ = _ := by simp only [squareMass, mul_sum]
  have hnon : 0 ≤ ∑ u, ∑ x, ∑ y, (L u x y)^2 := by positivity
  calc
    _ ≤ (K * squareMass (A * B))^2 := pow_le_pow_left₀ hnon hb 2
    _ = K^2 * squareMass (A * B)^2 := mul_pow _ _ _
    _ ≤ K^2 * (squareMass (A.transpose * A) * squareMass (B.transpose * B)) :=
      mul_le_mul_of_nonneg_left (chain_gram_cauchy A B) (sq_nonneg K)
    _ = _ := by ring

end Erdos571.GramPin


/-! An unmasked same-hub estimate. The factorization B = A F is essential
in this module; it does not assert the corresponding entrywise-masked bound. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U R : Type*} [Fintype U] [Fintype R]

lemma squareMass_mono {A B : Matrix U R ℝ}
    (hA : ∀ u r, 0 ≤ A u r) (hAB : ∀ u r, A u r ≤ B u r) :
    squareMass A ≤ squareMass B := by
  exact sum_le_sum (fun u _ => sum_le_sum (fun r _ =>
    pow_le_pow_left₀ (hA u r) (hAB u r) 2))

lemma squareMass_smul (c : ℝ) (A : Matrix U R ℝ) :
    squareMass (c • A) = c^2 * squareMass A := by
  simp only [squareMass, Matrix.smul_apply, smul_eq_mul, mul_pow, mul_sum]

/-- A bounded entrywise power kernel is controlled by a longer Gram chain.
This statement only requires a specified row-Gram factorization. -/
theorem hadamard_gram_chain (A : Matrix U U ℝ) (F : Matrix U R ℝ)
    (Q : Matrix U U ℝ) (s : ℕ) (hs : 1 ≤ s) (T : ℝ)
    (hQ : ∀ u v, 0 ≤ Q u v) (hQT : ∀ u v, Q u v ≤ T)
    (hchain : ∀ u v, Q u v ≤ ((A*A).transpose*(A*A)) u v)
    (hgram : ∀ u v, (F*F.transpose) u v = (Q u v)^s) :
    squareMass (F*F.transpose) ≤ T^(s-1) * squareMass (A*(A*F)) := by
  have hk (u v : U) : 0 ≤ (F*F.transpose) u v := by rw [hgram]; exact pow_nonneg (hQ u v) _
  have hentry (u v : U) : ((F*F.transpose) u v)^2 ≤
      T^(s-1) * (((A*A).transpose*(A*A)) u v * (F*F.transpose) u v) := by
    have he : (Q u v)^s = (Q u v)^(s-1) * Q u v := by
      rw [←pow_succ]; congr 1; omega
    calc
      _ = (Q u v)^(s-1) * Q u v * (F*F.transpose) u v := by
        rw [pow_two, hgram u v, he]
      _ ≤ T^(s-1) * (((A*A).transpose*(A*A)) u v) * (F*F.transpose) u v :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul (pow_le_pow_left₀ (hQ u v) (hQT u v) _) (hchain u v)
            (hQ u v) (pow_nonneg ((hQ u v).trans (hQT u v)) _)) (hk u v)
      _ = _ := by ring
  calc
    _ ≤ ∑ u, ∑ v, T^(s-1) *
        (((A*A).transpose*(A*A)) u v * (F*F.transpose) u v) :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => hentry u v))
    _ = T^(s-1) * squareMass ((A*A)*F) := by
      rw [chain_gram_identity]
      simp only [mul_sum]
    _ = _ := by rw [Matrix.mul_assoc]

/-- If a nonnegative degeneracy matrix is dominated by D times the feature
Gram matrix, its energy is bounded sharply by the unmasked parent energy.
No freeness, codegree, or genuine-copy conclusion is included here. -/
theorem unmasked_degeneracy_bound (A : Matrix U U ℝ) (hA : A.IsSymm)
    (F : Matrix U R ℝ) (Q : Matrix U U ℝ) (s : ℕ) (hs : 1 ≤ s)
    (T D : ℝ)
    (hQ : ∀ u v, 0 ≤ Q u v) (hQT : ∀ u v, Q u v ≤ T)
    (hchain : ∀ u v, Q u v ≤ ((A*A).transpose*(A*A)) u v)
    (hgram : ∀ u v, (F*F.transpose) u v = (Q u v)^s)
    (Z : Matrix R R ℝ) (hZ : ∀ x y, 0 ≤ Z x y)
    (hZF : ∀ x y, Z x y ≤ D * (F.transpose*F) x y) :
    squareMass Z ^ 2 ≤ (D^2*T^(s-1))^2 *
      squareMass (A*A) * squareMass ((A*F).transpose*(A*F)) := by
  have hz : squareMass Z ≤ D^2 * squareMass (F*F.transpose) := by
    calc
      _ ≤ squareMass (D • (F.transpose*F)) := squareMass_mono hZ hZF
      _ = D^2 * squareMass (F.transpose*F) := squareMass_smul D _
      _ = _ := by rw [gram_squareMass F]
  have hb : squareMass Z ≤ D^2*T^(s-1) * squareMass (A*(A*F)) := by
    calc
      _ ≤ D^2 * squareMass (F*F.transpose) := hz
      _ ≤ D^2 * (T^(s-1) * squareMass (A*(A*F))) :=
        mul_le_mul_of_nonneg_left (hadamard_gram_chain A F Q s hs T hQ hQT hchain hgram)
          (sq_nonneg D)
      _ = _ := by ring
  calc
    _ ≤ (D^2*T^(s-1) * squareMass (A*(A*F)))^2 :=
      pow_le_pow_left₀ (squareMass_nonneg Z) hb 2
    _ = (D^2*T^(s-1))^2 * squareMass (A*(A*F))^2 := mul_pow _ _ _
    _ ≤ (D^2*T^(s-1))^2 *
        (squareMass (A.transpose*A) * squareMass ((A*F).transpose*(A*F))) :=
      mul_le_mul_of_nonneg_left (chain_gram_cauchy A (A*F)) (sq_nonneg _)
    _ = _ := by rw [hA]; ring

end Erdos571.GramPin


/-! Consequences under explicit global bounded-codegree hypotheses.
Local lightness of selected graph copies does not supply these hypotheses. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U : Type*} [Fintype U]

theorem bounded_kernel_degeneracy (A N : Matrix U U ℝ)
    (hA : A.IsSymm) (hAn : ∀ u v, 0 ≤ A u v)
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hrow : ∀ u, ∑ v, A u v ≤ D)
    (hN : ∀ u v, 0 ≤ N u v) (hNL : ∀ u v, N u v ≤ L)
    (hNA : ∀ u v, N u v ≤ (A*A) u v)
    (s : ℕ) (hs : 1 ≤ s) (δ : U → ℝ)
    (hδ : ∀ u, 0 ≤ δ u ∧ δ u ≤ D) :
    squareMass (fun x y : Fin s → U =>
      ∑ u, δ u * branch N s u x * branch N s u y)^2 ≤
      (D^2*(L*D^2)^(s-1))^2 * squareMass (A*A) *
        squareMass ((A*branch N s).transpose*(A*branch N s)) := by
  let F := branch N s
  let Q := N*N.transpose
  have hF : ∀ u x, 0 ≤ F u x := branch_nonneg hN s
  have hAA : ∀ u v, 0 ≤ (A*A) u v := chain_nonneg hAn hAn
  have hAArow (u : U) : ∑ v, (A*A) u v ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hAn hD hrow hrow u
  have hNrow (u : U) : ∑ v, N u v ≤ D^2 :=
    (sum_le_sum (fun v _ => hNA u v)).trans (hAArow u)
  have hQ (u v : U) : 0 ≤ Q u v := by
    exact sum_nonneg (fun x _ => mul_nonneg (hN u x) (hN v x))
  have hQT (u v : U) : Q u v ≤ L*D^2 := by
    calc
      _ ≤ ∑ x, N u x * L := sum_le_sum (fun x _ =>
        mul_le_mul_of_nonneg_left (hNL v x) (hN u x))
      _ = (∑ x, N u x) * L := (sum_mul _ _ _).symm
      _ ≤ D^2 * L := mul_le_mul_of_nonneg_right (hNrow u) hL
      _ = _ := mul_comm _ _
  have hsym : (A*A).IsSymm := by
    show (A*A).transpose = A*A
    rw [Matrix.transpose_mul, hA]
  have hchain (u v : U) : Q u v ≤ ((A*A).transpose*(A*A)) u v := by
    change (∑ x, N u x * N v x) ≤ ∑ x, (A*A) x u * (A*A) x v
    apply sum_le_sum
    intro x hx
    rw [hsym.apply u x, hsym.apply v x]
    exact mul_le_mul (hNA u x) (hNA v x) (hN v x) (hAA u x)
  apply unmasked_degeneracy_bound A hA F Q s hs (L*D^2) D hQ hQT hchain
    (kernel_branch N s) _
  · intro x y
    exact sum_nonneg (fun u _ => mul_nonneg
      (mul_nonneg (hδ u).1 (hF u x)) (hF u y))
  · intro x y
    change (∑ u, δ u * F u x * F u y) ≤ D * ∑ u, F u x * F u y
    rw [mul_sum]
    exact sum_le_sum (fun u _ => by
      rw [←mul_assoc]
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (hδ u).2 (hF u x)) (hF u y))

/-- A global codegree cap gives the Frobenius estimate used in the hub and
unmasked-degeneracy inequalities. The cap must apply to every distinct pair. -/
theorem adjacency_gram_bound [DecidableEq U] (G : SimpleGraph U)
    [DecidableRel G.Adj] (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) :
    squareMass (G.adjMatrix ℝ * G.adjMatrix ℝ) ≤
      (L+1) * Fintype.card U * D^2 := by
  let A := G.adjMatrix ℝ
  have hAn (u v : U) : 0 ≤ A u v := by
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hAA (u v : U) : 0 ≤ (A*A) u v := chain_nonneg hAn hAn u v
  have hrow (u : U) : ∑ v, A u v ≤ D := by
    have he : ∑ v, A u v = (G.degree u : ℝ) := by
      simpa only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    exact he.le.trans (hdeg u)
  have hAArow (u : U) : ∑ v, (A*A) u v ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hAn hD hrow hrow u
  have hentry (u v : U) : ((A*A) u v)^2 ≤
      L*(A*A) u v + if u=v then D^2 else 0 := by
    by_cases he : u=v
    · subst v
      have hdg : (A*A) u u = (G.degree u : ℝ) := G.adjMatrix_mul_self_apply_self u
      rw [if_pos rfl, hdg]
      have hh := pow_le_pow_left₀ (Nat.cast_nonneg (G.degree u)) (hdeg u) 2
      exact hh.trans (le_add_of_nonneg_left (mul_nonneg hL (Nat.cast_nonneg _)))
    · rw [if_neg he, add_zero, pow_two]
      exact mul_le_mul_of_nonneg_right (hcodeg u v he) (hAA u v)
  calc
    _ ≤ ∑ u, ∑ v, (L*(A*A) u v + if u=v then D^2 else 0) :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => hentry u v))
    _ = ∑ u, (L*(∑ v, (A*A) u v) + D^2) := by
      simp only [sum_add_distrib, ←mul_sum]
      simp
    _ ≤ ∑ _u : U, (L*D^2 + D^2) := sum_le_sum (fun u _ =>
      add_le_add (mul_le_mul_of_nonneg_left (hAArow u) hL) le_rfl)
    _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul]; ring

end Erdos571.GramPin


/-! A row-Gram bound for linear functionals, used to estimate central pins.
These are matrix inequalities, not a graph-freeness assertion. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {I J : Type*} [Fintype I] [Fintype J]

lemma nonnegative_symmetric_form_bound (H : Matrix I I ℝ) (hs : H.IsSymm)
    (hn : ∀ i j, 0 ≤ H i j) (C : ℝ) (hr : ∀ i, ∑ j, H i j ≤ C)
    (y : I → ℝ) :
    (∑ i, ∑ j, H i j * y i * y j) ≤ C * ∑ i, (y i)^2 := by
  have hh : 2*(∑ i, ∑ j, H i j*y i*y j) ≤
      ∑ i, ∑ j, H i j*((y i)^2+(y j)^2) := by
    simp only [mul_sum]
    exact sum_le_sum (fun i _ => sum_le_sum (fun j _ => by
      have h := mul_le_mul_of_nonneg_left (sq_nonneg (y i-y j)) (hn i j)
      nlinarith))
  have he : (∑ i, ∑ j, H i j*((y i)^2+(y j)^2)) =
      2*∑ i, (∑ j, H i j)*(y i)^2 := by
    simp only [mul_add, sum_add_distrib, ←sum_mul]
    have hx : (∑ i, ∑ j, H i j*(y j)^2) =
        ∑ i, (∑ j, H i j)*(y i)^2 := by
      rw [sum_comm]
      apply sum_congr rfl
      intro i hi
      rw [sum_mul]
      apply sum_congr rfl
      intro j hj
      rw [hs.apply i j]
    rw [hx]
    ring
  rw [he] at hh
  have hlast : (∑ i, (∑ j, H i j)*(y i)^2) ≤ C*∑ i, (y i)^2 := by
    rw [mul_sum]
    exact sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (hr i) (sq_nonneg _))
  linarith

/-- Schur's row-sum test applied to the row-Gram matrix of an arbitrary
rectangular real matrix. -/
theorem row_gram_operator_bound (P : Matrix I J ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hn : ∀ i j, 0 ≤ (P*P.transpose) i j)
    (hr : ∀ i, ∑ j, (P*P.transpose) i j ≤ C) (x : J → ℝ) :
    (∑ i, (∑ j, P i j*x j)^2) ≤ C*∑ j, (x j)^2 := by
  let y : I → ℝ := fun i => ∑ j, P i j*x j
  have hs : (P*P.transpose).IsSymm := by
    show (P*P.transpose).transpose=P*P.transpose
    rw [Matrix.transpose_mul, Matrix.transpose_transpose]
  have ht : (∑ j, (∑ i, P i j*y i)^2) =
      ∑ i, ∑ k, (P*P.transpose) i k*y i*y k := by
    simp only [pow_two, Matrix.mul_apply, Matrix.transpose_apply, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro i hi
    rw [sum_comm]
    apply sum_congr rfl
    intro k hk
    apply sum_congr rfl
    intro j hj
    ring
  have hb := nonnegative_symmetric_form_bound (P*P.transpose) hs hn C hr y
  rw [←ht] at hb
  have hid : (∑ j, (∑ i, P i j*y i)*x j) = ∑ i, (y i)^2 := by
    simp only [sum_mul]
    rw [sum_comm]
    apply sum_congr rfl
    intro i hi
    calc
      _ = (∑ j, P i j*x j)*y i := by
        rw [sum_mul]
        apply sum_congr rfl
        intro j hj
        ring
      _ = (y i)^2 := by rw [pow_two]
  have hc := sum_mul_sq_le_sq_mul_sq (univ : Finset J)
    (fun j => ∑ i, P i j*y i) x
  rw [hid] at hc
  have hh := hc.trans (mul_le_mul_of_nonneg_right hb
    (sum_nonneg (fun j _ => sq_nonneg (x j))))
  have hy : 0 ≤ ∑ i, (y i)^2 := sum_nonneg (fun i _ => sq_nonneg _)
  by_cases he : (∑ i, (y i)^2)=0
  · change _ ≤ C*∑ j, (x j)^2
    rw [he]
    exact mul_nonneg hC (sum_nonneg (fun j _ => sq_nonneg _))
  · have hyp : 0 < ∑ i, (y i)^2 := lt_of_le_of_ne hy (Ne.symm he)
    change (∑ i, (y i)^2) ≤ _
    nlinarith

/-- The diagonal of a conjugated matrix is controlled by the row sums of
the entrywise square of the adjacency Gram matrix. -/
theorem diagonal_conjugation_bound (A : Matrix I J ℝ) (K : Matrix J J ℝ)
    (C : ℝ) (hC : 0 ≤ C)
    (hr : ∀ i, ∑ j, ((A*A.transpose) i j)^2 ≤ C) :
    (∑ i, ((A*K*A.transpose) i i)^2) ≤ C*squareMass K := by
  let P : Matrix I (J×J) ℝ := fun i p => A i p.1*A i p.2
  have hgram (i j : I) : (P*P.transpose) i j=((A*A.transpose) i j)^2 := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, P, Fintype.sum_prod_type,
      pow_two, sum_mul, mul_sum]
    apply sum_congr rfl
    intro u hu
    apply sum_congr rfl
    intro v hv
    ring
  have he := row_gram_operator_bound P C hC
    (fun i j => by rw [hgram]; exact sq_nonneg _)
    (fun i => by simp_rw [hgram]; exact hr i) (fun p => K p.1 p.2)
  have hp (i : I) : (∑ p, P i p*K p.1 p.2)=(A*K*A.transpose) i i := by
    simp only [P, Fintype.sum_prod_type, Matrix.mul_apply, Matrix.transpose_apply, sum_mul]
    rw [sum_comm]
    apply sum_congr rfl
    intro u hu
    apply sum_congr rfl
    intro v hv
    ring
  simp_rw [hp] at he
  simpa only [Fintype.sum_prod_type, squareMass] using he

/-- This bounds central-vertex collision energy without any pointwise
cap on the entries of the chained feature matrix A F. -/
theorem center_pin_bound {R : Type*} [Fintype R]
    (A : Matrix I J ℝ) (F : Matrix J R ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hr : ∀ i, ∑ j, ((A*A.transpose) i j)^2 ≤ C) :
    (∑ i, (∑ x, ((A*F) i x)^2)^2) ≤ C*squareMass (F*F.transpose) := by
  have h := diagonal_conjugation_bound A (F*F.transpose) C hC hr
  have he : A*(F*F.transpose)*A.transpose=(A*F)*(A*F).transpose := by
    simp only [Matrix.transpose_mul, Matrix.mul_assoc]
  rw [he] at h
  simpa only [Matrix.mul_apply, Matrix.transpose_apply, ←pow_two] using h

end Erdos571.GramPin


/-! Explicit global-codegree consequences of the frame inequality. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U : Type*} [Fintype U] [DecidableEq U]

theorem adjacency_gram_row_bound (G : SimpleGraph U) [DecidableRel G.Adj]
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) (u : U) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ (L+1)*D^2 := by
  let A := G.adjMatrix ℝ
  have hAn (u v : U) : 0 ≤ A u v := by
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hAA (u v : U) : 0 ≤ (A*A) u v := chain_nonneg hAn hAn u v
  have hrow (u : U) : ∑ v, A u v ≤ D := by
    have he : ∑ v, A u v = (G.degree u : ℝ) := by
      simpa only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    exact he.le.trans (hdeg u)
  have hAArow : ∑ v, (A*A) u v ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hAn hD hrow hrow u
  have hentry (v : U) : ((A*A) u v)^2 ≤
      L*(A*A) u v + if u=v then D^2 else 0 := by
    by_cases he : u=v
    · subst v
      have hdg : (A*A) u u = (G.degree u : ℝ) := G.adjMatrix_mul_self_apply_self u
      rw [if_pos rfl, hdg]
      have hh := pow_le_pow_left₀ (Nat.cast_nonneg (G.degree u)) (hdeg u) 2
      exact hh.trans (le_add_of_nonneg_left (mul_nonneg hL (Nat.cast_nonneg _)))
    · rw [if_neg he, add_zero, pow_two]
      exact mul_le_mul_of_nonneg_right (hcodeg u v he) (hAA u v)
  calc
    _ ≤ ∑ v, (L*(A*A) u v + if u=v then D^2 else 0) :=
      sum_le_sum (fun v _ => hentry v)
    _ = L*(∑ v, (A*A) u v) + D^2 := by
      simp only [sum_add_distrib, ←mul_sum]; simp
    _ ≤ L*D^2 + D^2 := add_le_add (mul_le_mul_of_nonneg_left hAArow hL) le_rfl
    _ = _ := by ring

/-- The central-pin estimate for adjacency chains needs no cap on short-star
fibers. Its assumption is a global codegree cap, not local lightness. -/
theorem graph_center_pin_bound {R : Type*} [Fintype R]
    (G : SimpleGraph U) [DecidableRel G.Adj]
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (F : Matrix U R ℝ) :
    (∑ u, (∑ x, ((G.adjMatrix ℝ * F) u x)^2)^2) ≤
      (L+1)*D^2*squareMass (F*F.transpose) := by
  apply center_pin_bound (G.adjMatrix ℝ) F ((L+1)*D^2) (by positivity)
  intro u
  simpa only [SimpleGraph.transpose_adjMatrix] using adjacency_gram_row_bound G L D hL hD hdeg hcodeg u

/-- The full unmasked central-pin estimate, relative to parent Gram energy. -/
theorem unmasked_center_pin_bound {R : Type*} [Fintype R]
    (A : Matrix U U ℝ) (hA : A.IsSymm) (F : Matrix U R ℝ)
    (Q : Matrix U U ℝ) (s : ℕ) (hs : 1 ≤ s) (C T : ℝ)
    (hC : 0 ≤ C) (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ C)
    (hQ : ∀ u v, 0 ≤ Q u v) (hQT : ∀ u v, Q u v ≤ T)
    (hchain : ∀ u v, Q u v ≤ ((A*A).transpose*(A*A)) u v)
    (hgram : ∀ u v, (F*F.transpose) u v = (Q u v)^s) :
    (∑ u, (∑ x, ((A*F) u x)^2)^2)^2 ≤ (C*T^(s-1))^2 *
      squareMass (A*A) * squareMass ((A*F).transpose*(A*F)) := by
  have hp := center_pin_bound A F C hC (by intro u; rw [hA]; exact hr u)
  have hb : (∑ u, (∑ x, ((A*F) u x)^2)^2) ≤ C*T^(s-1)*squareMass (A*(A*F)) := by
    calc
      _ ≤ C*squareMass (F*F.transpose) := hp
      _ ≤ C*(T^(s-1)*squareMass (A*(A*F))) := mul_le_mul_of_nonneg_left
        (hadamard_gram_chain A F Q s hs T hQ hQT hchain hgram) hC
      _ = _ := by ring
  calc
    _ ≤ (C*T^(s-1)*squareMass (A*(A*F)))^2 := pow_le_pow_left₀ (by positivity) hb 2
    _ = (C*T^(s-1))^2*squareMass (A*(A*F))^2 := mul_pow _ _ _
    _ ≤ (C*T^(s-1))^2 *
        (squareMass (A.transpose*A) * squareMass ((A*F).transpose*(A*F))) :=
      mul_le_mul_of_nonneg_left (chain_gram_cauchy A (A*F)) (sq_nonneg _)
    _ = _ := by rw [hA]; ring

end Erdos571.GramPin


/-! Log-convexity and interpolation for weighted finite power sums. -/
namespace Erdos571.WeightedPowerMoments
open Finset
variable {I : Type*} [Fintype I]

noncomputable def moment (w t : I → ℝ) (k : ℕ) : ℝ := ∑ i, w i*(t i)^k

lemma nonneg (w t : I → ℝ) (hw : ∀ i, 0 ≤ w i) (ht : ∀ i, 0 ≤ t i) (k : ℕ) :
    0 ≤ moment w t k := sum_nonneg (fun i _ => mul_nonneg (hw i) (pow_nonneg (ht i) k))

lemma pos (w t : I → ℝ) (hw : ∀ i, 0 ≤ w i) (ht : ∀ i, 0 ≤ t i)
    (hp : ∃ i, 0 < w i ∧ 0 < t i) (k : ℕ) : 0 < moment w t k := by
  obtain ⟨i, hiw, hit⟩ := hp
  exact (mul_pos hiw (pow_pos hit k)).trans_le
    (single_le_sum (fun j _ => mul_nonneg (hw j) (pow_nonneg (ht j) k)) (mem_univ i))

lemma logconvex (w t : I → ℝ) (hw : ∀ i, 0 ≤ w i) (ht : ∀ i, 0 ≤ t i) (k : ℕ) :
    moment w t (k+1)^2 ≤ moment w t k*moment w t (k+2) := by
  apply sum_sq_le_sum_mul_sum_of_sq_eq_mul univ
    (fun i _ => mul_nonneg (hw i) (pow_nonneg (ht i) k))
    (fun i _ => mul_nonneg (hw i) (pow_nonneg (ht i) (k+2)))
  intro i hi
  simp only [pow_succ]
  ring

/-- One-step interpolation with only natural powers in the conclusion. -/
theorem interpolation (w t : I → ℝ) (hw : ∀ i, 0 ≤ w i) (ht : ∀ i, 0 ≤ t i)
    (hp : ∃ i, 0 < w i ∧ 0 < t i) (s : ℕ) (hs : 1 ≤ s) :
    moment w t (s-1)^s ≤ moment w t 0*moment w t s^(s-1) := by
  have h := DiscreteMoments.interpolation_power (pos w t hw ht hp)
    (logconvex w t hw ht) (s-1)
  simpa only [Nat.sub_add_cancel hs] using h

/-- A square-moment bound followed by interpolation. This form avoids
introducing fractional powers in subsequent collision calculations. -/
theorem mixed_interpolation (w t : I → ℝ) (hw : ∀ i, 0 ≤ w i) (ht : ∀ i, 0 ≤ t i)
    (hp : ∃ i, 0 < w i ∧ 0 < t i) (s : ℕ) (hs : 1 ≤ s)
    (b C : ℝ) (hC : 0 ≤ C)
    (hbound : b^2 ≤ C^2*moment w t (s-1)*moment w t s) :
    b^(2*s) ≤ C^(2*s)*moment w t 0*moment w t s^(2*s-1) := by
  have he := pow_le_pow_left₀ (sq_nonneg b) hbound s
  have hm := interpolation w t hw ht hp s hs
  calc
    _ = (b^2)^s := pow_mul b 2 s
    _ ≤ (C^2*moment w t (s-1)*moment w t s)^s := he
    _ = C^(2*s)*moment w t (s-1)^s*moment w t s^s := by
      rw [mul_pow, mul_pow, ←pow_mul]
    _ ≤ C^(2*s)*(moment w t 0*moment w t s^(s-1))*moment w t s^s :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hm (pow_nonneg hC _))
        (pow_nonneg (nonneg w t hw ht s) _)
    _ = _ := by
      rw [show 2*s-1=(s-1)+s by omega, pow_add]
      ring

end Erdos571.WeightedPowerMoments


/-! Moment interpolation for two equal arm bundles joined by a two-walk. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U : Type*} [Fintype U]

noncomputable def entryPower (Q : Matrix U U ℝ) (s : ℕ) : Matrix U U ℝ :=
  fun u v => (Q u v)^s

noncomputable def bilateralEnergy (A Q : Matrix U U ℝ) (s : ℕ) : ℝ :=
  squareMass (A*entryPower Q s*A.transpose)

noncomputable def conjugationInner (A K L : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, (A*K*A.transpose) u v * (A*L*A.transpose) u v

lemma conjugation_trace (A K : Matrix U U ℝ) :
    squareMass (A*K*A.transpose) =
      ((A.transpose*A)*K*(A.transpose*A)*K.transpose).trace := by
  rw [squareMass_trace]
  simpa only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc] using
    Matrix.trace_mul_cycle A (K*(A.transpose*A)*K.transpose) A.transpose

lemma conjugationInner_cauchy (A K L : Matrix U U ℝ) :
    conjugationInner A K L^2 ≤
      squareMass (A*K*A.transpose)*squareMass (A*L*A.transpose) := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (U×U))
    (fun p => (A*K*A.transpose) p.1 p.2) (fun p => (A*L*A.transpose) p.1 p.2)
  simpa only [Fintype.sum_prod_type, conjugationInner, squareMass] using h

noncomputable def bilateralWeight (A : Matrix U U ℝ) (p : U×U×U×U) : ℝ :=
  (A.transpose*A) p.1 p.2.2.2 * (A.transpose*A) p.2.2.1 p.2.1

noncomputable def bilateralBase (Q : Matrix U U ℝ) (p : U×U×U×U) : ℝ :=
  Q p.2.2.2 p.2.2.1 * Q p.1 p.2.1

lemma trace_entryPower_identity (M Q : Matrix U U ℝ) (s : ℕ) :
    (M*entryPower Q s*M*(entryPower Q s).transpose).trace =
      WeightedPowerMoments.moment
        (fun p : U×U×U×U => M p.1 p.2.2.2 * M p.2.2.1 p.2.1)
        (bilateralBase Q) s := by
  simp only [WeightedPowerMoments.moment, bilateralBase,
    Fintype.sum_prod_type, Matrix.trace, Matrix.diag, Matrix.mul_apply,
    Matrix.transpose_apply, sum_mul, mul_sum, entryPower, mul_pow]
  apply sum_congr rfl
  intro i hi
  apply sum_congr rfl
  intro j hj
  apply sum_congr rfl
  intro k hk
  apply sum_congr rfl
  intro l hl
  ring

lemma bilateral_moment (A Q : Matrix U U ℝ) (s : ℕ) :
    bilateralEnergy A Q s =
      WeightedPowerMoments.moment (bilateralWeight A) (bilateralBase Q) s := by
  rw [bilateralEnergy, conjugation_trace]
  exact trace_entryPower_identity (A.transpose*A) Q s

lemma bilateralWeight_nonneg (A : Matrix U U ℝ) (hA : ∀ u v, 0 ≤ A u v)
    (p : U×U×U×U) : 0 ≤ bilateralWeight A p := by
  apply mul_nonneg
  all_goals exact sum_nonneg (fun u _ => mul_nonneg (hA _ _) (hA _ _))

lemma bilateralBase_nonneg (Q : Matrix U U ℝ) (hQ : ∀ u v, 0 ≤ Q u v)
    (p : U×U×U×U) : 0 ≤ bilateralBase Q p := mul_nonneg (hQ _ _) (hQ _ _)

lemma bilateral_positive_term (A Q : Matrix U U ℝ)
    (hp : ∃ u, 0 < (A.transpose*A) u u ∧ 0 < Q u u) :
    ∃ p, 0 < bilateralWeight A p ∧ 0 < bilateralBase Q p := by
  obtain ⟨u, hAu, hQu⟩ := hp
  exact ⟨(u,u,u,u), mul_pos hAu hAu, mul_pos hQu hQu⟩

lemma bilateral_logconvex (A Q : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v) (s : ℕ) :
    bilateralEnergy A Q (s+1)^2 ≤ bilateralEnergy A Q s*bilateralEnergy A Q (s+2) := by
  simp_rw [bilateral_moment]
  exact WeightedPowerMoments.logconvex _ _
    (bilateralWeight_nonneg A hA) (bilateralBase_nonneg Q hQ) s

theorem bilateral_interpolation (A Q : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hp : ∃ u, 0 < (A.transpose*A) u u ∧ 0 < Q u u) (s : ℕ) (hs : 1 ≤ s) :
    bilateralEnergy A Q (s-1)^s ≤ bilateralEnergy A Q 0*bilateralEnergy A Q s^(s-1) := by
  simp_rw [bilateral_moment]
  exact WeightedPowerMoments.interpolation _ _
    (bilateralWeight_nonneg A hA) (bilateralBase_nonneg Q hQ)
    (bilateral_positive_term A Q hp) s hs

/-- Natural-power form of the mixed-energy interpolation used for a repeated
leaf root. It is an algebraic statement, not a copy-count decomposition. -/
theorem bilateral_mixed_interpolation (A Q : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hp : ∃ u, 0 < (A.transpose*A) u u ∧ 0 < Q u u) (s : ℕ) (hs : 1 ≤ s) :
    conjugationInner A (entryPower Q (s-1)) (entryPower Q s)^(2*s) ≤
      bilateralEnergy A Q 0*bilateralEnergy A Q s^(2*s-1) := by
  have h := WeightedPowerMoments.mixed_interpolation (bilateralWeight A) (bilateralBase Q)
    (bilateralWeight_nonneg A hA) (bilateralBase_nonneg Q hQ)
    (bilateral_positive_term A Q hp) s hs
    (conjugationInner A (entryPower Q (s-1)) (entryPower Q s)) 1 (by norm_num) (by
      simpa only [←bilateral_moment, bilateralEnergy, one_pow, one_mul] using
        conjugationInner_cauchy A (entryPower Q (s-1)) (entryPower Q s))
  simpa only [one_pow, one_mul, ←bilateral_moment] using h

lemma bilateral_zero (A Q : Matrix U U ℝ) :
    bilateralEnergy A Q 0 = (∑ u, (∑ v, A u v)^2)^2 := by
  have he (u v : U) : (A*entryPower Q 0*A.transpose) u v =
      (∑ x, A u x)*(∑ y, A v y) := by
    simp only [entryPower, pow_zero, Matrix.mul_apply, Matrix.transpose_apply, mul_one,
      mul_sum]
  simp only [bilateralEnergy, squareMass, he, mul_pow]
  simp only [←mul_sum, ←sum_mul, pow_two]

lemma bilateral_zero_upper (A Q : Matrix U U ℝ) (hA : ∀ u v, 0 ≤ A u v)
    (D : ℝ) (hr : ∀ u, ∑ v, A u v ≤ D) :
    bilateralEnergy A Q 0 ≤ (Fintype.card U : ℝ)^2*D^4 := by
  rw [bilateral_zero]
  have hrow : (∑ u, (∑ v, A u v)^2) ≤ Fintype.card U*D^2 := by
    calc
      _ ≤ ∑ _u : U, D^2 := sum_le_sum (fun u _ =>
        pow_le_pow_left₀ (sum_nonneg (fun v _ => hA u v)) (hr u) 2)
      _ = _ := by simp
  calc
    _ ≤ ((Fintype.card U : ℝ)*D^2)^2 := pow_le_pow_left₀ (by positivity) hrow 2
    _ = _ := by ring

end Erdos571.GramPin


/-! Degree-based lower bounds for the unmasked bilateral Gram energy. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U R : Type*} [Fintype U] [Fintype R]

lemma columnGram_total (B : Matrix U R ℝ) :
    (∑ x, ∑ y, (B.transpose*B) x y) = ∑ u, (∑ x, B u x)^2 := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  simp_rw [sum_comm (s := (univ : Finset R)) (t := (univ : Finset U))]
  rw [sum_comm]
  simp only [pow_two, sum_mul_sum]
  rw [sum_comm]

/-- A lower row mass gives a fourth-moment lower bound, with the number of
columns as the only normalization. No nonnegativity of individual entries is
needed once the row masses have been bounded below by a nonnegative b. -/
theorem columnGram_energy_lower (B : Matrix U R ℝ) (b : ℝ) (hb : 0 ≤ b)
    (hrow : ∀ u, b ≤ ∑ x, B u x) :
    (Fintype.card U : ℝ)^2*b^4 ≤
      (Fintype.card R : ℝ)^2*squareMass (B.transpose*B) := by
  have hl : Fintype.card U*b^2 ≤ ∑ x, ∑ y, (B.transpose*B) x y := by
    rw [columnGram_total]
    calc
      _ = ∑ _u : U, b^2 := by simp
      _ ≤ _ := sum_le_sum (fun u _ => pow_le_pow_left₀ hb (hrow u) 2)
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (R×R)))
    (f := fun p => (B.transpose*B) p.1 p.2)
  simp only [card_univ, Fintype.card_prod, Nat.cast_mul, Fintype.sum_prod_type] at hc
  calc
    _ = ((Fintype.card U : ℝ)*b^2)^2 := by ring
    _ ≤ (∑ x, ∑ y, (B.transpose*B) x y)^2 := pow_le_pow_left₀ (by positivity) hl 2
    _ ≤ _ := by simpa only [squareMass, pow_two] using hc

variable [DecidableEq U]

lemma bilateral_as_columnGram (A : Matrix U U ℝ) (hs : A.IsSymm) (s : ℕ) :
    bilateralEnergy A ((A*A)*(A*A)) s =
      squareMass ((A*branch (A*A) s).transpose*(A*branch (A*A) s)) := by
  let F := branch (A*A) s
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, hs]
  have hK : F*F.transpose=entryPower ((A*A)*(A*A)) s := by
    ext u v
    have h := kernel_branch (A*A) s u v
    simpa only [kernel, hAA.eq, entryPower, F] using h
  rw [←gram_squareMass (A*F)]
  have he : (A*F)*(A*F).transpose=A*(F*F.transpose)*A.transpose := by
    simp only [Matrix.transpose_mul, Matrix.mul_assoc]
  rw [he, hK]
  rfl

/-- The expected lower energy for two s-arm bundles separated by a two-walk.
All powers in this statement are natural powers. -/
theorem bilateral_degree_lower (A : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (d : ℝ) (hd : 0 ≤ d)
    (hrow : ∀ u, d ≤ ∑ v, A u v) (s : ℕ) :
    (Fintype.card U : ℝ)^2*d^(8*s+4) ≤
      (Fintype.card U : ℝ)^(2*s)*bilateralEnergy A ((A*A)*(A*A)) s := by
  have hAArow (u : U) : d^2 ≤ ∑ v, (A*A) u v := by
    simpa only [pow_two] using chain_row_lower hA hd hrow hrow u
  have hFrow (u : U) : d^(2*s) ≤ ∑ x, branch (A*A) s u x := by
    rw [branch_row_sum, pow_mul]
    exact pow_le_pow_left₀ (sq_nonneg d) (hAArow u) s
  have hBrow (u : U) : d^(2*s+1) ≤ ∑ x, (A*branch (A*A) s) u x := by
    simpa only [pow_succ', mul_comm] using
      chain_row_lower hA (pow_nonneg hd (2*s)) hrow hFrow u
  have h := columnGram_energy_lower (A*branch (A*A) s) (d^(2*s+1))
    (pow_nonneg hd _) hBrow
  have he : (d^(2*s+1))^4=d^(8*s+4) := by rw [←pow_mul]; congr 1; omega
  have hc : (Fintype.card (Fin s → U) : ℝ)^2=(Fintype.card U : ℝ)^(2*s) := by
    simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow, ←pow_mul]
    congr 1
    omega
  rw [he, hc, ←bilateral_as_columnGram A hs s] at h
  exact h

end Erdos571.GramPin


/-! Algebraic bounds for two types of root or middle identifications.
A combinatorial identification with actual graph homomorphisms is separate. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U : Type*} [Fintype U] [DecidableEq U]

noncomputable def diagonalMass (B : Matrix U U ℝ) : ℝ := ∑ u, (B u u)^2

lemma diagonalMass_le (B : Matrix U U ℝ) : diagonalMass B ≤ squareMass B := by
  exact sum_le_sum (fun u _ => single_le_sum (fun v _ => sq_nonneg _) (mem_univ u))

lemma weighted_entry_mixed_bound (P B C : Matrix U U ℝ)
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hP : ∀ u v, 0 ≤ P u v)
    (hB : ∀ u v, 0 ≤ B u v) (hC : ∀ u v, 0 ≤ C u v)
    (hPb : ∀ u v, P u v ≤ L + if u=v then D else 0) :
    (∑ u, ∑ v, P u v*B u v*C u v)^2 ≤
      2*L^2*squareMass B*squareMass C + 2*D^2*diagonalMass B*diagonalMass C := by
  let b := ∑ u, ∑ v, B u v*C u v
  let c := ∑ u, B u u*C u u
  have hn : 0 ≤ ∑ u, ∑ v, P u v*B u v*C u v :=
    sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
      mul_nonneg (mul_nonneg (hP u v) (hB u v)) (hC u v)))
  have hb : (∑ u, ∑ v, P u v*B u v*C u v) ≤ L*b+D*c := by
    calc
      _ ≤ ∑ u, ∑ v, (L + if u=v then D else 0)*B u v*C u v :=
        sum_le_sum (fun u _ => sum_le_sum (fun v _ =>
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hPb u v) (hB u v)) (hC u v)))
      _ = _ := by
        simp only [add_mul, sum_add_distrib, ite_mul, zero_mul]
        simp only [sum_ite_eq, mem_univ, if_true]
        simp only [b, c, mul_assoc, mul_sum]
  have hbc : b^2 ≤ squareMass B*squareMass C := by
    have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (U×U))
      (fun p => B p.1 p.2) (fun p => C p.1 p.2)
    simpa only [b, squareMass, Fintype.sum_prod_type] using h
  have hcc : c^2 ≤ diagonalMass B*diagonalMass C :=
    sum_mul_sq_le_sq_mul_sq univ (fun u => B u u) (fun u => C u u)
  calc
    _ ≤ (L*b+D*c)^2 := pow_le_pow_left₀ hn hb 2
    _ ≤ 2*L^2*b^2 + 2*D^2*c^2 := by nlinarith [sq_nonneg (L*b-D*c)]
    _ ≤ 2*L^2*(squareMass B*squareMass C) +
        2*D^2*(diagonalMass B*diagonalMass C) :=
      add_le_add (mul_le_mul_of_nonneg_left hbc (by positivity))
        (mul_le_mul_of_nonneg_left hcc (by positivity))
    _ = _ := by ring

/-- In the central/terminal-middle identification kernel, off-diagonal
codegrees give a mixed full energy, and the diagonal gives a central pin. -/
theorem graph_middle_identification_bound (G : SimpleGraph U) [DecidableRel G.Adj]
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (B C : Matrix U U ℝ) (hB : ∀ u v, 0 ≤ B u v) (hC : ∀ u v, 0 ≤ C u v) :
    (∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*B u v*C u v)^2 ≤
      2*L^2*squareMass B*squareMass C + 2*D^2*squareMass B*diagonalMass C := by
  have hAn (u v : U) : 0 ≤ G.adjMatrix ℝ u v := by
    dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hAA := GramFeatures.chain_nonneg hAn hAn
  have h := weighted_entry_mixed_bound (G.adjMatrix ℝ * G.adjMatrix ℝ) B C L D hL hD
    hAA hB hC (by
      intro u v
      by_cases he : u=v
      · subst v
        rw [if_pos rfl, G.adjMatrix_mul_self_apply_self]
        exact (hdeg u).trans (le_add_of_nonneg_left hL)
      · simpa only [if_neg he, add_zero] using hcodeg u v he)
  apply h.trans
  apply add_le_add le_rfl
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left (diagonalMass_le B) (by positivity))
    (sum_nonneg (fun u _ => sq_nonneg _))

end Erdos571.GramPin


/-! Weighted moments with a coefficient bounded by a square root of the base. -/
namespace Erdos571.WeightedPowerMoments
open Finset
variable {I : Type*} [Fintype I]

lemma perturbation_cauchy (w t z : I → ℝ) (hw : ∀ i, 0 ≤ w i)
    (ht : ∀ i, 0 ≤ t i) (C : ℝ) (hz : ∀ i, (z i)^2 ≤ C^2*t i)
    (s : ℕ) (hs : 1 ≤ s) :
    (∑ i, w i*(t i)^(s-1)*z i)^2 ≤ C^2*moment w t (s-1)*moment w t s := by
  have hc : (∑ i, w i*(t i)^(s-1)*z i)^2 ≤
      (∑ i, w i*(t i)^(s-1))*(∑ i, w i*(t i)^(s-1)*(z i)^2) := by
    apply sum_sq_le_sum_mul_sum_of_sq_eq_mul univ
      (fun i _ => mul_nonneg (hw i) (pow_nonneg (ht i) _))
      (fun i _ => mul_nonneg (mul_nonneg (hw i) (pow_nonneg (ht i) _)) (sq_nonneg _))
    intro i hi
    ring
  have hb : (∑ i, w i*(t i)^(s-1)*(z i)^2) ≤ C^2*moment w t s := by
    rw [moment, mul_sum]
    apply sum_le_sum
    intro i hi
    calc
      _ ≤ w i*(t i)^(s-1)*(C^2*t i) :=
        mul_le_mul_of_nonneg_left (hz i) (mul_nonneg (hw i) (pow_nonneg (ht i) _))
      _ = C^2*(w i*(t i)^s) := by
        have he : (t i)^s=(t i)^(s-1)*t i := by
          rw [←pow_succ]; congr 1; omega
        rw [he]
        ring
  exact hc.trans ((mul_le_mul_of_nonneg_left hb (nonneg w t hw ht (s-1))).trans_eq (by
    dsimp only [moment]
    ring))

/-- The coefficient may vary with the index; only its squared pointwise
bound is required. -/
theorem perturbation_interpolation (w t z : I → ℝ) (hw : ∀ i, 0 ≤ w i)
    (ht : ∀ i, 0 ≤ t i) (hp : ∃ i, 0 < w i ∧ 0 < t i)
    (C : ℝ) (hC : 0 ≤ C) (hz : ∀ i, (z i)^2 ≤ C^2*t i)
    (s : ℕ) (hs : 1 ≤ s) :
    (∑ i, w i*(t i)^(s-1)*z i)^(2*s) ≤ C^(2*s)*moment w t 0*moment w t s^(2*s-1) :=
  mixed_interpolation w t hw ht hp s hs _ C hC (perturbation_cauchy w t z hw ht C hz s hs)

end Erdos571.WeightedPowerMoments


/-! Repeated-root kernels, with the repeated root separated from all hubs.
Diagonal root/hub coincidences are deliberately not included. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U : Type*} [Fintype U] [DecidableEq U]

noncomputable def separatedRootProduct (N : Matrix U U ℝ)
    (u v : U) (S : Finset U) (w : U) : ℝ :=
  if w ∈ S then 0 else N u w*N v w

lemma separatedRootProduct_nonneg (N : Matrix U U ℝ)
    (hN : ∀ u v, 0 ≤ N u v) (u v : U) (S : Finset U) (w : U) :
    0 ≤ separatedRootProduct N u v S w := by
  unfold separatedRootProduct
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (hN u w) (hN v w)

lemma separatedRootProduct_square_sum (N : Matrix U U ℝ)
    (hN : ∀ u v, 0 ≤ N u v) (L : ℝ) (hL : 0 ≤ L)
    (hcap : ∀ u v, u ≠ v → N u v ≤ L)
    (u v : U) (S : Finset U) (hu : u ∈ S) (hv : v ∈ S) :
    (∑ w, (separatedRootProduct N u v S w)^2) ≤ L^2*(N*N.transpose) u v := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, mul_sum]
  apply sum_le_sum
  intro w hw
  by_cases hm : w ∈ S
  · simp only [separatedRootProduct, if_pos hm, zero_pow (by decide : 2≠0)]
    exact mul_nonneg (sq_nonneg L) (mul_nonneg (hN u w) (hN v w))
  · have huw : u ≠ w := by intro he; exact hm (he ▸ hu)
    have hvw : v ≠ w := by intro he; exact hm (he ▸ hv)
    have hp : N u w*N v w ≤ L^2 := by
      simpa only [pow_two] using mul_le_mul (hcap u w huw) (hcap v w hvw) (hN v w) hL
    simp only [separatedRootProduct, if_neg hm, pow_two]
    simpa only [pow_two] using mul_le_mul_of_nonneg_right hp (mul_nonneg (hN u w) (hN v w))

lemma separatedRoot_cross_square (N : Matrix U U ℝ)
    (hN : ∀ u v, 0 ≤ N u v) (L : ℝ) (hL : 0 ≤ L)
    (hcap : ∀ u v, u ≠ v → N u v ≤ L)
    (u v x y : U) (S : Finset U) (hu : u ∈ S) (hv : v ∈ S)
    (hx : x ∈ S) (hy : y ∈ S) :
    (∑ w, separatedRootProduct N u v S w*separatedRootProduct N x y S w)^2 ≤
      (L^2)^2*((N*N.transpose) u v*(N*N.transpose) x y) := by
  have hc := sum_mul_sq_le_sq_mul_sq univ
    (separatedRootProduct N u v S) (separatedRootProduct N x y S)
  have h₁ := separatedRootProduct_square_sum N hN L hL hcap u v S hu hv
  have h₂ := separatedRootProduct_square_sum N hN L hL hcap x y S hx hy
  calc
    _ ≤ _ := hc
    _ ≤ (L^2*(N*N.transpose) u v)*(L^2*(N*N.transpose) x y) :=
      mul_le_mul h₁ h₂ (sum_nonneg (fun w _ => sq_nonneg _))
        (mul_nonneg (sq_nonneg L) (GramFeatures.chain_nonneg hN (fun a b => hN b a) u v))
    _ = _ := by ring

noncomputable def hubSet (p : U×U×U×U) : Finset U := {p.1,p.2.1,p.2.2.1,p.2.2.2}

noncomputable def crossRootWeight (N : Matrix U U ℝ) (p : U×U×U×U) : ℝ :=
  ∑ w, separatedRootProduct N p.2.2.2 p.2.2.1 (hubSet p) w *
    separatedRootProduct N p.1 p.2.1 (hubSet p) w

lemma crossRootWeight_square (N : Matrix U U ℝ) (hN : ∀ u v, 0 ≤ N u v)
    (L : ℝ) (hL : 0 ≤ L) (hcap : ∀ u v, u ≠ v → N u v ≤ L)
    (p : U×U×U×U) :
    (crossRootWeight N p)^2 ≤ (L^2)^2*bilateralBase (N*N.transpose) p := by
  exact separatedRoot_cross_square N hN L hL hcap _ _ _ _ (hubSet p)
    (by simp [hubSet]) (by simp [hubSet]) (by simp [hubSet]) (by simp [hubSet])

noncomputable def crossRootEnergy (A N : Matrix U U ℝ) (s : ℕ) : ℝ :=
  ∑ p, bilateralWeight A p*(bilateralBase (N*N.transpose) p)^(s-1)*crossRootWeight N p

/-- The exact natural-power estimate for a root identified across the two
arm bundles, excluding its coincidence with any hub. -/
theorem crossRootEnergy_interpolation (A N : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hN : ∀ u v, 0 ≤ N u v)
    (L : ℝ) (hL : 0 ≤ L) (hcap : ∀ u v, u ≠ v → N u v ≤ L)
    (hp : ∃ u, 0 < (A.transpose*A) u u ∧ 0 < (N*N.transpose) u u)
    (s : ℕ) (hs : 1 ≤ s) :
    crossRootEnergy A N s^(2*s) ≤ (L^2)^(2*s)*bilateralEnergy A (N*N.transpose) 0 *
      bilateralEnergy A (N*N.transpose) s^(2*s-1) := by
  have hQ : ∀ u v, 0 ≤ (N*N.transpose) u v :=
    GramFeatures.chain_nonneg hN (fun a b => hN b a)
  have h := WeightedPowerMoments.perturbation_interpolation
    (bilateralWeight A) (bilateralBase (N*N.transpose)) (crossRootWeight N)
    (bilateralWeight_nonneg A hA) (bilateralBase_nonneg _ hQ)
    (bilateral_positive_term A _ hp) (L^2) (sq_nonneg L)
    (crossRootWeight_square N hN L hL hcap) s hs
  simpa only [crossRootEnergy, ←bilateral_moment] using h

end Erdos571.GramPin


/-! Branching assignments for a layered tree without the distinguished short
root. For shape [2,s], this is the subdivided symmetric double star. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels LayeredAssignments
variable {W : Type} (G : SimpleGraph W)

def graph (l : List ℕ) : SimpleGraph (Interior l ⊕ Leaves l) :=
  LeafRooted.graph (core l) (attach l)

instance (l : List ℕ) : DecidableRel (graph l).Adj :=
  inferInstanceAs (DecidableRel (LeafRooted.graph (core l) (attach l)).Adj)

lemma isTree (l : List ℕ) : (graph l).IsTree :=
  LeafRooted.isTree (core l) (core_tree l) (attach l)

abbrev Fiber (l : List ℕ) (r : Labels W l) := (x : W) × Assignment G l x r
abbrev Full (l : List ℕ) := (r : Labels W l) × Fiber G l r

def assignmentHom (l : List ℕ) {x : W} {r : Labels W l} (a : Assignment G l x r) :
    graph l →g G where
  toFun := Sum.elim (interiorValue G l a) (leafValue l r)
  map_rel' := by
    rintro (u|u) (v|v) h
    · exact interior_preserving G l a h
    · change u=attach l v at h
      subst u
      exact leaf_preserving G l a v
    · change v=attach l u at h
      subst v
      exact (leaf_preserving G l a u).symm
    · exact h.elim

def hom (l : List ℕ) (p : Full G l) : graph l →g G := assignmentHom G l p.2.2

@[simp] lemma hom_anchor (l : List ℕ) (p : Full G l) :
    hom G l p (.inl (anchor l))=p.2.1 := interior_anchor G l p.2.2

@[simp] lemma hom_root (l : List ℕ) (p : Full G l) (r : Leaves l) :
    hom G l p (.inr r)=leafValue l p.1 r := rfl

lemma hom_injective (l : List ℕ) : Function.Injective (hom G l) := by
  intro p q he
  have hr : p.1=q.1 := by
    apply leafValue_injective l
    funext a
    exact congrArg (fun f : graph l →g G => f (.inr a)) he
  have hx : p.2.1=q.2.1 := by
    simpa only [hom_anchor] using congrArg (fun f : graph l →g G => f (.inl (anchor l))) he
  rcases p with ⟨r,x,a⟩
  rcases q with ⟨r',x',b⟩
  dsimp only at hr hx
  subst r'
  subst x'
  have hab : a=b := by
    apply assignment_ext G l
    intro u
    exact congrArg (fun f : graph l →g G => f (.inl u)) he
  subst b
  rfl

def fromHom (l : List ℕ) (f : graph l →g G) : Full G l :=
  ⟨labelsOf l (fun a => f (.inr a)), f (.inl (anchor l)),
    ofMap G l (fun a => f (.inl a)) (labelsOf l (fun a => f (.inr a)))
      (fun h => f.map_rel h) (fun a => by
        rw [show leafValue l (labelsOf l (fun a => f (.inr a))) a=f (.inr a) from
          congrFun (leafValue_labelsOf l _) a]
        exact f.map_rel (show (graph l).Adj (.inl (attach l a)) (.inr a) from rfl))⟩

lemma hom_fromHom (l : List ℕ) (f : graph l →g G) : hom G l (fromHom G l f)=f := by
  ext v
  cases v with
  | inl a => exact congrFun (interior_ofMap G l _ _ _ _) a
  | inr r => exact congrFun (leafValue_labelsOf l _) r

def homEquiv (l : List ℕ) : Full G l ≃ (graph l →g G) where
  toFun := hom G l
  invFun := fromHom G l
  left_inv p := hom_injective G l (hom_fromHom G l (hom G l p))
  right_inv := hom_fromHom G l

variable [Fintype W] [DecidableRel G.Adj]

lemma card_fiber (l : List ℕ) (r : Labels W l) :
    (Fintype.card (Fiber G l r) : ℝ) = ∑ x, feature (G.adjMatrix ℝ) l x r := by
  simp only [Fintype.card_sigma, Nat.cast_sum, card_assignment]

abbrev Agreement (l : List ℕ) := {p : Full G l×Full G l // p.1.1=p.2.1}

def agreementEquiv (l : List ℕ) : Agreement G l ≃
    ((r : Labels W l) × (Fiber G l r×Fiber G l r)) where
  toFun e := by
    rcases e with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he⟩
    change r=s at he
    subst s
    exact ⟨r,p,q⟩
  invFun e := ⟨(⟨e.1,e.2.1⟩,⟨e.1,e.2.2⟩),rfl⟩
  left_inv e := by
    rcases e with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he⟩
    change r=s at he
    subst s
    rfl
  right_inv e := by rcases e with ⟨r,p,q⟩; rfl

open Classical in
lemma agreement_card (l : List ℕ) :
    (Fintype.card (Agreement G l) : ℝ) =
      ∑ r, (∑ x, feature (G.adjMatrix ℝ) l x r)^2 := by
  rw [Fintype.card_congr (agreementEquiv G l)]
  simp only [Fintype.card_sigma, Nat.cast_sum, Fintype.card_prod, Nat.cast_mul,
    ←pow_two, Nat.cast_pow, card_assignment]

end Erdos571.LayeredBush


/-! Exact pin counts for the rootless layered assignment model. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels LayeredAssignments
variable {W : Type} (G : SimpleGraph W)

abbrev Pinned (l : List ℕ) (a : Interior l) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧ hom G l p.1 (.inl a)=hom G l p.2 (.inl a)}

abbrev PinFiber (l : List ℕ) (a : Interior l) (r : Labels W l) (w : W) :=
  {p : Fiber G l r // interiorValue G l p.2 a=w}

def pinFiberEquiv (l : List ℕ) (a : Interior l) (r : Labels W l) (w : W) :
    PinFiber G l a r w ≃ ((x : W) × {p : Assignment G l x r // interiorValue G l p a=w}) where
  toFun p := ⟨p.1.1,p.1.2,p.2⟩
  invFun p := ⟨⟨p.1,p.2.1⟩,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def pinEquiv (l : List ℕ) (a : Interior l) :
    Pinned G l a ≃ ((r : Labels W l) × (w : W) ×
      (PinFiber G l a r w×PinFiber G l a r w)) :=
  markedPairEquiv (fun r : Labels W l => Fiber G l r)
    (fun p => hom G l p (.inl a))

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
lemma card_pinFiber (l : List ℕ) (a : Interior l) (r : Labels W l) (w : W) :
    (Fintype.card (PinFiber G l a r w) : ℝ) =
      ∑ x, pinFeature (G.adjMatrix ℝ) l a x (r,w) := by
  rw [Fintype.card_congr (pinFiberEquiv G l a r w)]
  simp only [Fintype.card_sigma, Nat.cast_sum, card_pinAssignment]

open Classical in
theorem pinned_card (l : List ℕ) (a : Interior l) :
    (Fintype.card (Pinned G l a) : ℝ) =
      ∑ r, ∑ w, (∑ x, pinFeature (G.adjMatrix ℝ) l a x (r,w))^2 := by
  rw [Fintype.card_congr (pinEquiv G l a)]
  simp only [Fintype.card_sigma, Nat.cast_sum, Fintype.card_prod, Nat.cast_mul]
  simp_rw [card_pinFiber, ←pow_two]

/-- The sum of all entries of a row-Gram matrix is the squared column mass. -/
lemma kernel_total {I : Type*} [Fintype I] (F : Matrix W I ℝ) :
    (∑ x, ∑ y, (F*F.transpose) x y) = ∑ r, (∑ x, F x r)^2 := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  simp_rw [sum_comm (s := (univ : Finset W)) (t := (univ : Finset I))]
  simp only [pow_two, sum_mul_sum]

open Classical in
theorem pinned_kernel_sum (l : List ℕ) (a : Interior l) :
    (Fintype.card (Pinned G l a) : ℝ) =
      ∑ x, ∑ y, pinKernel (G.adjMatrix ℝ) l a x y := by
  rw [pinned_card]
  simpa only [pinKernel, GramFeatures.kernel, Fintype.sum_prod_type] using
    (kernel_total (pinFeature (G.adjMatrix ℝ) l a)).symm

end Erdos571.LayeredBush


/-! The actual rootless [2,s] assignment energy is the bilateral Gram energy.
No injectivity or freeness conclusion is asserted by these identities. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U R : Type*} [Fintype U] [Fintype R]

lemma branch_two_total (B : Matrix U R ℝ) :
    (∑ r : Fin 2 → R, (∑ z, branch B 2 z r)^2) = squareMass (B.transpose*B) := by
  have h := Fintype.sum_equiv (finTwoArrowEquiv R)
    (fun r : Fin 2 → R => (∑ z, B z (r 0)*B z (r 1))^2)
    (fun p : R×R => (∑ z, B z p.1*B z p.2)^2) (fun r => rfl)
  simpa only [branch, Fin.prod_univ_two, squareMass, Matrix.mul_apply,
    Matrix.transpose_apply, Fintype.sum_prod_type] using h

lemma short_branchKernel [DecidableEq U] (A : Matrix U U ℝ) (hA : A.IsSymm) (s : ℕ) :
    LayeredGramKernels.branchKernel A [s] = entryPower ((A*A)*(A*A)) s := by
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, hA]
  ext u v
  have h := kernel_branch (A*A) s u v
  simpa only [LayeredGramKernels.branchKernel, LayeredGramKernels.feature, kernel,
    hAA.eq, entryPower] using h

end Erdos571.GramPin

namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels LayeredAssignments GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem bilateral_agreement_card (s : ℕ) :
    (Fintype.card (Agreement G [2,s]) : ℝ) =
      bilateralEnergy (G.adjMatrix ℝ) ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s := by
  rw [agreement_card, bilateral_as_columnGram _ G.isSymm_adjMatrix s]
  exact branch_two_total (G.adjMatrix ℝ * branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s)

open Classical in
theorem bilateral_center_pin_card (s : ℕ) :
    (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ) =
      ∑ z, (∑ x, ((G.adjMatrix ℝ * branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s) z x)^2)^2 := by
  rw [pinned_kernel_sum]
  have hd (x : W) : (∑ y, pinKernel (G.adjMatrix ℝ) [2,s] (anchor [2,s]) x y)=
      branchKernel (G.adjMatrix ℝ) [2,s] x x := by
    calc
      _ = pinKernel (G.adjMatrix ℝ) [2,s] (anchor [2,s]) x x :=
        sum_eq_single x (fun y hy hne => by simp [pinKernel_anchor, hne.symm])
          (by simp)
      _ = _ := by simp [pinKernel_anchor]
  simp_rw [hd]
  change (∑ z, kernel (branch (G.adjMatrix ℝ * branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s) 2) z z)=_
  simp_rw [kernel_branch]
  simp only [kernel, Matrix.mul_apply, Matrix.transpose_apply, ←pow_two]

open Classical in
theorem bilateral_hub_pin_card (s : ℕ) (i : Fin 2) :
    (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ) =
      conjugationInner (G.adjMatrix ℝ)
        (Matrix.diagonal (fun u => ((G.adjMatrix ℝ * G.adjMatrix ℝ)*
          (G.adjMatrix ℝ * G.adjMatrix ℝ)) u u^s))
        (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  have hk : branchKernel A [s]=entryPower Q s := short_branchKernel A G.isSymm_adjMatrix s
  have hp : pinKernel A [s] (anchor [s])=Matrix.diagonal (fun u => (Q u u)^s) := by
    ext u v
    rw [pinKernel_anchor, hk]
    by_cases he : u=v
    · subst v
      simp [entryPower]
    · simp [he, Matrix.diagonal]
  rw [pinned_kernel_sum]
  change (∑ x, ∑ y, pinKernel A [2,s] (some (i,anchor [s])) x y)=_
  simp only [pinKernel_cons, hp, hk, Nat.reduceSub, pow_one, conjugationInner]
  rfl

end Erdos571.LayeredBush


/-! Rooted-power freeness forces either noninjective homomorphisms or
same-position interior collision energy in the rootless assignment model. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredGramKernels LayeredAssignments
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev Conflicting (l : List ℕ) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧ RootedHomEnergy.Conflict (hom G l p.1) (hom G l p.2)}

abbrev BadLeft (l : List ℕ) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧ ¬Function.Injective (hom G l p.1)}

abbrev BadRight (l : List ℕ) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧ ¬Function.Injective (hom G l p.2)}

abbrev Overlap (l : List ℕ) :=
  {p : Full G l×Full G l // p.1.1=p.2.1 ∧
    ¬Disjoint (RootedHomEnergy.interior (hom G l p.1)) (RootedHomEnergy.interior (hom G l p.2))}

open Classical in
theorem agreement_le_conflicts (l : List ℕ) (M : ℕ) (hM : 2 ≤ M)
    (hf : (FullRootedPower.graph (graph l) M).Free G) :
    Fintype.card (Agreement G l) ≤ (M-1)*Fintype.card (Conflicting G l) := by
  classical
  letI : Nonempty (Interior l) := ⟨anchor l⟩
  let label : Full G l → Labels W l := Sigma.fst
  let conflict : Full G l → Full G l → Prop := fun p q =>
    RootedHomEnergy.Conflict (hom G l p) (hom G l q)
  have h := RootedHomEnergy.pair_bound (univ : Finset (Full G l)) (hom G l) label
    (fun p hp q hq he r => congrArg (fun t => leafValue l t r) he) M hM hf
  have ha : (PackingEnergy.fiberPairs (univ : Finset (Full G l)) label (fun _ _ => True)).card=
      Fintype.card (Agreement G l) := by
    rw [Fintype.card_subtype]
    congr 1
    ext e
    simp only [PackingEnergy.fiberPairs, mem_filter, mem_product, mem_univ, true_and, and_true, label]
  have hc : (PackingEnergy.fiberPairs (univ : Finset (Full G l)) label conflict).card=
      Fintype.card (Conflicting G l) := by
    rw [Fintype.card_subtype]
    congr 1
  rwa [ha,hc] at h

def badSwapEquiv (l : List ℕ) : BadLeft G l ≃ BadRight G l where
  toFun p := ⟨(p.1.2,p.1.1),p.2.1.symm,p.2.2⟩
  invFun p := ⟨(p.1.2,p.1.1),p.2.1.symm,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

open Classical in
theorem conflicts_le_bad_overlap (l : List ℕ) :
    (Fintype.card (Conflicting G l) : ℝ) ≤
      2*Fintype.card (BadLeft G l)+Fintype.card (Overlap G l) := by
  have hr : Fintype.card (BadRight G l)=Fintype.card (BadLeft G l) :=
    (Fintype.card_congr (badSwapEquiv G l)).symm
  have h : (Fintype.card (Conflicting G l) : ℝ) ≤
      Fintype.card (BadLeft G l)+Fintype.card (BadRight G l)+Fintype.card (Overlap G l) := by
    simp only [card_subtype_real, ←sum_add_distrib]
    apply sum_le_sum
    intro p hp
    by_cases he : p.1.1=p.2.1 <;>
      by_cases hi : Function.Injective (hom G l p.1) <;>
      by_cases hj : Function.Injective (hom G l p.2) <;>
      by_cases hd : Disjoint (RootedHomEnergy.interior (hom G l p.1))
        (RootedHomEnergy.interior (hom G l p.2)) <;>
      simp [RootedHomEnergy.Conflict, he, hi, hj, hd]
  rw [hr] at h
  nlinarith

open Classical in
theorem overlap_le_pins (l : List ℕ) :
    (Fintype.card (Overlap G l) : ℝ) ≤
      (nonroots l : ℝ)*∑ a : Interior l, (Fintype.card (Pinned G l a) : ℝ) := by
  classical
  let label : Interior l → Full G l → (Labels W l)×W :=
    fun a p => (p.1, hom G l p (.inl a))
  let rel : Full G l → Full G l → Prop := fun p q => p.1=q.1 ∧
    ¬Disjoint (RootedHomEnergy.interior (hom G l p)) (RootedHomEnergy.interior (hom G l q))
  have h := MarginalCollisionEnergy.covered_pairs_bound (univ : Finset (Full G l)) label rel (by
    intro p hp q hq he
    obtain ⟨v,hpv,hqv⟩ := Finset.not_disjoint_iff.mp he.2
    simp only [RootedHomEnergy.interior, mem_image, mem_univ, true_and] at hpv hqv
    obtain ⟨a,ha⟩ := hpv
    obtain ⟨b,hb⟩ := hqv
    exact ⟨a,b,Prod.ext he.1 (ha.trans hb.symm)⟩) (fun _ => (1:ℝ)) (by intros; norm_num)
  have hp (a : Interior l) : MarginalCollisionEnergy.pairMass (univ : Finset (Full G l))
      (label a) (label a) (fun _ => (1:ℝ)) = Fintype.card (Pinned G l a) := by
    rw [card_subtype_real]
    simp only [MarginalCollisionEnergy.pairMass, label, Prod.mk.injEq, mul_one, Fintype.sum_prod_type]
  convert h using 1
  · simp only [card_subtype_real, sum_filter, sum_product, Fintype.sum_prod_type, mul_one]
    apply sum_congr rfl
    intro p hp
    apply sum_congr rfl
    intro q hq
    simp only [rel]
    split_ifs <;> rfl
  · simp only [card_interior, hp]


open Classical in
/-- This is an exact finite inequality for ordinary graph freeness. The
remaining analytic task is to bound the bad and pinned terms. -/
theorem agreement_le_bad_pins (l : List ℕ) (M : ℕ) (hM : 2 ≤ M)
    (hf : (FullRootedPower.graph (graph l) M).Free G) :
    (Fintype.card (Agreement G l) : ℝ) ≤ (M-1:ℕ)*
      (2*Fintype.card (BadLeft G l)+(nonroots l : ℝ)*
        ∑ a : Interior l, (Fintype.card (Pinned G l a) : ℝ)) := by
  have h : (Fintype.card (Agreement G l) : ℝ) ≤
      (M-1:ℕ)*(Fintype.card (Conflicting G l) : ℝ) := by
    exact_mod_cast agreement_le_conflicts G l M hM hf
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  exact (conflicts_le_bad_overlap G l).trans (add_le_add le_rfl (overlap_le_pins G l))

end Erdos571.LayeredBush


/-! The diagonal-conjugation expression for hub pins and its Gram bound. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U R : Type*} [Fintype U] [Fintype R] [DecidableEq U]

lemma inner_trace (B C : Matrix U U ℝ) :
    (∑ u, ∑ v, B u v*C u v)=(B*C.transpose).trace := by
  simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.transpose_apply]

lemma conjugationInner_trace (A K L : Matrix U U ℝ) :
    conjugationInner A K L = ((A.transpose*A)*K*(A.transpose*A)*L.transpose).trace := by
  rw [conjugationInner, inner_trace]
  simpa only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc] using
    Matrix.trace_mul_cycle A (K*(A.transpose*A)*L.transpose) A.transpose

lemma diagonal_hub_identity (A : Matrix U U ℝ) (F : Matrix U R ℝ) (f : U → ℝ) :
    conjugationInner A (Matrix.diagonal f) (F*F.transpose) =
      ∑ u, f u*(∑ r, (((A.transpose*A)*F) u r)^2) := by
  let M := A.transpose*A
  let K := F*F.transpose
  let D := Matrix.diagonal f
  have hM : M.IsSymm := by
    show (A.transpose*A).transpose=A.transpose*A
    rw [Matrix.transpose_mul, Matrix.transpose_transpose]
  have hK : K.transpose=K := by
    show (F*F.transpose).transpose=F*F.transpose
    rw [Matrix.transpose_mul, Matrix.transpose_transpose]
  have hcyc : (M*D*M*K).trace=(D*(M*K*M)).trace := by
    calc
      _ = ((M*K)*M*D).trace := by
        simpa only [Matrix.mul_assoc] using Matrix.trace_mul_cycle M D (M*K)
      _ = _ := Matrix.trace_mul_comm ((M*K)*M) D
  have hMF : M*K*M=(M*F)*(M*F).transpose := by
    simp only [K, Matrix.transpose_mul, hM.eq, Matrix.mul_assoc]
  rw [conjugationInner_trace]
  change (M*D*M*K.transpose).trace=_
  rw [hK, hcyc, hMF]
  simp only [D, Matrix.trace, Matrix.diag, Matrix.diagonal_mul]
  simp only [Matrix.mul_apply, Matrix.transpose_apply, pow_two]
  rfl

/-- A bound on feature row square mass controls the exact diagonal hub-pin
expression. The adjacency matrix need not be nonnegative or symmetric here. -/
theorem diagonal_hub_bound (A : Matrix U U ℝ) (F : Matrix U R ℝ) (B : ℝ)
    (hrow : ∀ u, ∑ r, (F u r)^2 ≤ B) :
    (conjugationInner A (Matrix.diagonal (fun u => (F*F.transpose) u u))
      (F*F.transpose))^2 ≤ B^2*squareMass (A.transpose*A)*
        squareMass ((A*F).transpose*(A*F)) := by
  have hk (u : U) : (F*F.transpose) u u=∑ r, (F u r)^2 := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, pow_two]
  have hn (u : U) : 0 ≤ (F*F.transpose) u u := by rw [hk]; positivity
  rw [diagonal_hub_identity]
  have hnon : 0 ≤ ∑ u, (F*F.transpose) u u*(∑ r, (((A.transpose*A)*F) u r)^2) :=
    sum_nonneg (fun u _ => mul_nonneg (hn u) (sum_nonneg (fun r _ => sq_nonneg _)))
  have hb : (∑ u, (F*F.transpose) u u*(∑ r, (((A.transpose*A)*F) u r)^2)) ≤
      B*squareMass ((A.transpose*A)*F) := by
    rw [squareMass, mul_sum]
    exact sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right
      (by rw [hk]; exact hrow u) (sum_nonneg (fun r _ => sq_nonneg _)))
  have hc := chain_gram_cauchy A.transpose (A*F)
  rw [Matrix.transpose_transpose, gram_squareMass A] at hc
  calc
    _ ≤ (B*squareMass ((A.transpose*A)*F))^2 := pow_le_pow_left₀ hnon hb 2
    _ = B^2*squareMass (A.transpose*(A*F))^2 := by rw [Matrix.mul_assoc, mul_pow]
    _ ≤ B^2*(squareMass (A.transpose*A)*squareMass ((A*F).transpose*(A*F))) :=
      mul_le_mul_of_nonneg_left hc (sq_nonneg B)
    _ = _ := by ring

end Erdos571.GramPin


/-! Uniform fourth-walk kernel bounds under a global codegree hypothesis. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U R : Type*} [Fintype U] [Fintype R]

lemma kernel_entry_sq_le (F : Matrix U R ℝ) (u v : U) :
    ((F*F.transpose) u v)^2 ≤ (∑ r, (F u r)^2)*(∑ r, (F v r)^2) :=
  sum_mul_sq_le_sq_mul_sq univ (fun r => F u r) (fun r => F v r)

lemma kernel_entry_le_of_rows (F : Matrix U R ℝ) (T : ℝ) (hT : 0 ≤ T)
    (hr : ∀ u, ∑ r, (F u r)^2 ≤ T) (u v : U) : (F*F.transpose) u v ≤ T := by
  have h := (kernel_entry_sq_le F u v).trans
    (mul_le_mul (hr u) (hr v) (sum_nonneg (fun r _ => sq_nonneg _)) hT)
  nlinarith

variable [DecidableEq U]

theorem graph_fourWalk_entries (G : SimpleGraph U) [DecidableRel G.Adj]
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) (u v : U) :
    0 ≤ ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ∧
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤ (L+1)*D^2 := by
  let A := G.adjMatrix ℝ
  have hA (u v : U) : 0 ≤ A u v := by
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hM := chain_nonneg hA hA
  have hs : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  refine ⟨chain_nonneg hM hM u v, ?_⟩
  have h := kernel_entry_le_of_rows (A*A) ((L+1)*D^2) (by positivity)
    (adjacency_gram_row_bound G L D hL hD hdeg hcodeg) u v
  simpa only [hs.eq] using h

lemma graph_gram_mass_bound (G : SimpleGraph U) [DecidableRel G.Adj]
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) :
    squareMass (G.adjMatrix ℝ * G.adjMatrix ℝ) ≤ Fintype.card U*((L+1)*D^2) := by
  have h := adjacency_gram_bound G L D hL hD hdeg hcodeg
  nlinarith

end Erdos571.GramPin


/-! Entrywise monotonicity and linearity of the conjugated Gram pairing. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U : Type*} [Fintype U]

lemma conjugation_nonneg (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) (u v : U) :
    0 ≤ (A*K*A.transpose) u v :=
  GramFeatures.chain_nonneg (GramFeatures.chain_nonneg hA hK) (fun x y => hA y x) u v

lemma conjugation_mono (A K L : Matrix U U ℝ) (hA : ∀ u v, 0 ≤ A u v)
    (hKL : ∀ u v, K u v ≤ L u v) (u v : U) :
    (A*K*A.transpose) u v ≤ (A*L*A.transpose) u v := by
  have hAK (u v : U) : (A*K) u v ≤ (A*L) u v :=
    sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (hKL x v) (hA u x))
  exact sum_le_sum (fun x _ => mul_le_mul_of_nonneg_right (hAK u x) (hA v x))

lemma conjugationInner_nonneg (A K L : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) (hL : ∀ u v, 0 ≤ L u v) :
    0 ≤ conjugationInner A K L :=
  sum_nonneg (fun u _ => sum_nonneg (fun v _ => mul_nonneg
    (conjugation_nonneg A K hA hK u v) (conjugation_nonneg A L hA hL u v)))

lemma conjugationInner_mono_left (A K K' L : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hL : ∀ u v, 0 ≤ L u v)
    (hKK : ∀ u v, K u v ≤ K' u v) :
    conjugationInner A K L ≤ conjugationInner A K' L :=
  sum_le_sum (fun u _ => sum_le_sum (fun v _ => mul_le_mul_of_nonneg_right
    (conjugation_mono A K K' hA hKK u v) (conjugation_nonneg A L hA hL u v)))

lemma conjugationInner_smul_left (A K L : Matrix U U ℝ) (c : ℝ) :
    conjugationInner A (c • K) L=c*conjugationInner A K L := by
  simp only [conjugationInner, Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_apply,
    smul_eq_mul, mul_assoc, mul_sum]

lemma conjugationInner_add_left (A K K' L : Matrix U U ℝ) :
    conjugationInner A (K+K') L=conjugationInner A K L+conjugationInner A K' L := by
  simp only [conjugationInner, Matrix.mul_add, Matrix.add_mul, Matrix.add_apply, add_mul, sum_add_distrib]

end Erdos571.GramPin


/-! Sharp bounds for the actual hub and center pin counts of the rootless
[2,s] tree, under an explicit global codegree cap. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem hub_pin_bound_global (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (s : ℕ) (i : Fin 2) :
    (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ)^2 ≤
      Fintype.card W*((L+1)*D^2)^(2*s+1)*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let F := branch (A*A) s
  let T := (L+1)*D^2
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hK : F*F.transpose=entryPower Q s := short_branchKernel A G.isSymm_adjMatrix s
  have hrow (u : W) : ∑ r, (F u r)^2 ≤ T^s := by
    have he : (∑ r, (F u r)^2)=(F*F.transpose) u u := by
      simp only [Matrix.mul_apply, Matrix.transpose_apply, pow_two]
    rw [he, hK]
    exact pow_le_pow_left₀ (graph_fourWalk_entries G L D hL hD hdeg hcodeg u u).1
      (graph_fourWalk_entries G L D hL hD hdeg hcodeg u u).2 s
  have h := diagonal_hub_bound A F (T^s) hrow
  rw [hK] at h
  rw [bilateral_hub_pin_card, bilateral_agreement_card]
  change conjugationInner A (diagonal (fun u => (Q u u)^s)) (entryPower Q s)^2 ≤
    Fintype.card W*T^(2*s+1)*bilateralEnergy A Q s
  have hM : squareMass (A.transpose*A) ≤ Fintype.card W*T := by
    have hsA : A.transpose=A := G.isSymm_adjMatrix
    rw [hsA]
    exact graph_gram_mass_bound G L D hL hD hdeg hcodeg
  have hE : squareMass ((A*F).transpose*(A*F))=bilateralEnergy A Q s :=
    (bilateral_as_columnGram A G.isSymm_adjMatrix s).symm
  calc
    _ ≤ (T^s)^2*squareMass (A.transpose*A)*squareMass ((A*F).transpose*(A*F)) := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*squareMass ((A*F).transpose*(A*F)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hM (sq_nonneg _)) (squareMass_nonneg _)
    _ = _ := by
      rw [hE, ←pow_mul, show s*2=2*s by omega, pow_succ]
      ring

open Classical in
theorem center_pin_bound_global (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (s : ℕ) (hs : 1 ≤ s) :
    (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ)^2 ≤
      Fintype.card W*((L+1)*D^2)^(2*s+1)*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let F := branch (A*A) s
  let T := (L+1)*D^2
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  have hK (u v : W) : (F*F.transpose) u v=(Q u v)^s :=
    congrArg (fun B : Matrix W W ℝ => B u v) (short_branchKernel A G.isSymm_adjMatrix s)
  have hQT := graph_fourWalk_entries G L D hL hD hdeg hcodeg
  have h := unmasked_center_pin_bound A G.isSymm_adjMatrix F Q s hs T T hT
    (adjacency_gram_row_bound G L D hL hD hdeg hcodeg)
    (fun u v => (hQT u v).1) (fun u v => (hQT u v).2)
    (fun u v => by rw [hAA]) hK
  have hpow : T*T^(s-1)=T^s := by rw [←pow_succ']; congr 1; omega
  rw [hpow] at h
  rw [bilateral_center_pin_card, bilateral_agreement_card]
  change (∑ z, (∑ x, ((A*F) z x)^2)^2)^2 ≤ Fintype.card W*T^(2*s+1)*bilateralEnergy A Q s
  have hM : squareMass (A*A) ≤ Fintype.card W*T := graph_gram_mass_bound G L D hL hD hdeg hcodeg
  have hE : squareMass ((A*F).transpose*(A*F))=bilateralEnergy A Q s :=
    (bilateral_as_columnGram A G.isSymm_adjMatrix s).symm
  calc
    _ ≤ (T^s)^2*squareMass (A*A)*squareMass ((A*F).transpose*(A*F)) := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*squareMass ((A*F).transpose*(A*F)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hM (sq_nonneg _)) (squareMass_nonneg _)
    _ = _ := by
      rw [hE, ←pow_mul, show s*2=2*s by omega, pow_succ]
      ring

end Erdos571.LayeredBush


/-! A terminal-middle pin is controlled by a lower arm moment and a hub pin,
under global codegrees and explicit minimum and maximum degree hypotheses. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem terminal_pin_mixed_bound (d D L : ℝ) (hd : 0 ≤ d) (hD : 0 ≤ D) (hL : 0 ≤ L)
    (hdeg : ∀ u, d ≤ (G.degree u : ℝ) ∧ (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (s : ℕ) (hs : 1 ≤ s) (i : Fin 2) (j : Fin s) :
    d^2*(Fintype.card (Pinned G [2,s] (some (i,some (j,())))) : ℝ) ≤
      d^2*D*L*conjugationInner (G.adjMatrix ℝ)
        (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) (s-1))
        (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s) +
      D^2*(Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ) := by
  let A := G.adjMatrix ℝ
  let M := A*A
  let Q := M*M
  let S := A*(Matrix.diagonal (fun u => (G.degree u : ℝ)))*A.transpose
  let K := pinKernel A [s] (some (j,()))
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hsA : A.transpose=A := G.isSymm_adjMatrix
  have hM := chain_nonneg hA hA
  have hQ := chain_nonneg hM hM
  have hMd (u : W) : M u u=(G.degree u : ℝ) := G.adjMatrix_mul_self_apply_self u
  have hbase : pinKernel A [] ()=Matrix.diagonal (fun u => (G.degree u : ℝ)) := by
    ext u v
    rw [show ()=anchor [] from rfl, pinKernel_anchor]
    by_cases he : u=v
    · subst v
      simp only [eq_self_iff_true, if_true, Matrix.diagonal_apply_eq]
      change (A*A.transpose) u u=(G.degree u : ℝ)
      rw [hsA]
      exact hMd u
    · simp [he, Matrix.diagonal]
  have hbaseQ : A*branchKernel A []*A.transpose=Q := by
    simp only [branchKernel, feature, kernel, hsA, Q, M, Matrix.mul_assoc]
  have hK (u v : W) : K u v=S u v*(Q u v)^(s-1) := by
    change pinKernel A [s] (some (j,())) u v=_
    rw [pinKernel_cons, hbase, hbaseQ]
  have hS (u v : W) : S u v ≤ D*M u v := by
    change (A*(diagonal (fun u => (G.degree u : ℝ)))*A.transpose) u v ≤ D*(A*A) u v
    rw [Matrix.mul_apply]
    simp_rw [Matrix.mul_diagonal, Matrix.transpose_apply]
    have he : (A*A) u v=∑ x, A u x*A v x := by
      have he' : (A*A.transpose) u v=∑ x, A u x*A v x := rfl
      simpa only [hsA] using he'
    rw [he, mul_sum]
    exact sum_le_sum (fun x _ => by
      have h := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hdeg x).2 (hA u x)) (hA v x)
      nlinarith)
  have hQd (u : W) : d^2 ≤ Q u u := by
    have h₀ : d^2 ≤ M u u*M u u := by
      rw [hMd, ←pow_two]
      exact pow_le_pow_left₀ hd (hdeg u).1 2
    exact h₀.trans (single_le_sum (fun v _ => mul_nonneg (hM u v) (hM v u)) (mem_univ u))
  have hKs : branchKernel A [s]=entryPower Q s := short_branchKernel A G.isSymm_adjMatrix s
  have hpow (u v : W) : (Q u v)^s=(Q u v)^(s-1)*Q u v := by
    rw [←pow_succ]; congr 1; omega
  have hbound (u v : W) : (d^2 • K) u v ≤
      ((d^2*D*L) • entryPower Q (s-1) +
        D^2 • Matrix.diagonal (fun u => (Q u u)^s)) u v := by
    simp only [Matrix.smul_apply, Matrix.add_apply, smul_eq_mul, entryPower, hK]
    by_cases he : u=v
    · subst v
      rw [Matrix.diagonal_apply_eq]
      have hSd : S u u ≤ D^2 := by
        exact (hS u u).trans (by rw [hMd, pow_two]; exact mul_le_mul_of_nonneg_left (hdeg u).2 hD)
      have h₁ := mul_le_mul_of_nonneg_left hSd (sq_nonneg d)
      have h₂ := mul_le_mul_of_nonneg_left (hQd u) (sq_nonneg D)
      have h₃ := mul_le_mul_of_nonneg_right h₁ (pow_nonneg (hQ u u) (s-1))
      have h₄ := mul_le_mul_of_nonneg_right h₂ (pow_nonneg (hQ u u) (s-1))
      have hp : 0 ≤ d^2*D*L*(Q u u)^(s-1) :=
        mul_nonneg (mul_nonneg (mul_nonneg (sq_nonneg d) hD) hL) (pow_nonneg (hQ u u) _)
      rw [hpow]
      nlinarith
    · rw [Matrix.diagonal_apply_ne _ he, mul_zero, add_zero]
      have hc : S u v ≤ D*L := (hS u v).trans (mul_le_mul_of_nonneg_left (hcodeg u v he) hD)
      have h := mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hc (pow_nonneg (hQ u v) (s-1))) (sq_nonneg d)
      nlinarith
  have hp : (Fintype.card (Pinned G [2,s] (some (i,some (j,())))) : ℝ)=
      conjugationInner A K (entryPower Q s) := by
    rw [pinned_kernel_sum]
    change (∑ x, ∑ y, pinKernel A [2,s] (some (i,some (j,()))) x y)=_
    simp only [pinKernel_cons, hKs, Nat.reduceSub, pow_one, conjugationInner]
    rfl
  rw [hp, bilateral_hub_pin_card]
  change d^2*conjugationInner A K (entryPower Q s) ≤
    d^2*D*L*conjugationInner A (entryPower Q (s-1)) (entryPower Q s)+
      D^2*conjugationInner A (diagonal (fun u => (Q u u)^s)) (entryPower Q s)
  have h := conjugationInner_mono_left A (d^2 • K)
    ((d^2*D*L) • entryPower Q (s-1)+D^2 • diagonal (fun u => (Q u u)^s))
    (entryPower Q s) hA (fun u v => pow_nonneg (hQ u v) s) hbound
  simpa only [conjugationInner_add_left, conjugationInner_smul_left] using h

end Erdos571.LayeredBush


/-! A Cauchy bound for imposing the same restriction on one or both copies
in a fixed-root family. -/
namespace Erdos571.FiberRestrictionEnergy
variable {R : Type*} (F : R → Type*)

abbrev Agreement := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1}
abbrev Left (P : Sigma F → Prop) := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ P p.1}
abbrev Both (P : Sigma F → Prop) := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ P p.1 ∧ P p.2}
abbrev Restricted (P : Sigma F → Prop) (r : R) := {p : F r // P ⟨r,p⟩}

def agreementEquiv : Agreement F ≃ ((r : R) × (F r×F r)) where
  toFun p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he⟩
    change r=s at he
    subst s
    exact ⟨r,p,q⟩
  invFun p := ⟨(⟨p.1,p.2.1⟩,⟨p.1,p.2.2⟩),rfl⟩
  left_inv p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he⟩
    change r=s at he
    subst s
    rfl
  right_inv p := by rcases p with ⟨r,p,q⟩; rfl

def leftEquiv (P : Sigma F → Prop) : Left F P ≃ ((r : R) × (Restricted F P r×F r)) where
  toFun p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he,hp⟩
    change r=s at he
    subst s
    exact ⟨r,⟨p,hp⟩,q⟩
  invFun p := ⟨(⟨p.1,p.2.1.1⟩,⟨p.1,p.2.2⟩),rfl,p.2.1.2⟩
  left_inv p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he,hp⟩
    change r=s at he
    subst s
    rfl
  right_inv p := by rcases p with ⟨r,⟨p,hp⟩,q⟩; rfl

def bothEquiv (P : Sigma F → Prop) : Both F P ≃
    ((r : R) × (Restricted F P r×Restricted F P r)) where
  toFun p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he,hp,hq⟩
    change r=s at he
    subst s
    exact ⟨r,⟨p,hp⟩,⟨q,hq⟩⟩
  invFun p := ⟨(⟨p.1,p.2.1.1⟩,⟨p.1,p.2.2.1⟩),rfl,p.2.1.2,p.2.2.2⟩
  left_inv p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,he,hp,hq⟩
    change r=s at he
    subst s
    rfl
  right_inv p := by rcases p with ⟨r,⟨p,hp⟩,⟨q,hq⟩⟩; rfl

variable [Fintype R] [∀ r, Fintype (F r)]
open Classical in
/-- One bad copy against an arbitrary copy is bounded by the geometric mean
of the both-bad and unrestricted root-agreement energies. -/
theorem left_cauchy (P : Sigma F → Prop) :
    (Fintype.card (Left F P) : ℝ)^2 ≤
      (Fintype.card (Both F P) : ℝ)*(Fintype.card (Agreement F) : ℝ) := by
  classical
  rw [Fintype.card_congr (leftEquiv F P), Fintype.card_congr (bothEquiv F P),
    Fintype.card_congr (agreementEquiv F)]
  simp only [Fintype.card_sigma, Fintype.card_prod, Nat.cast_sum, Nat.cast_mul]
  simpa only [pow_two] using Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
    (fun r => (Fintype.card (Restricted F P r) : ℝ)) (fun r => (Fintype.card (F r) : ℝ))

end Erdos571.FiberRestrictionEnergy


/-! Interior/root identifications reduce to same-position pinning, without
any preliminary deletion of noninjective homomorphisms. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev EqualLeft (l : List ℕ) (u v : Interior l⊕Leaves l) :=
  FiberRestrictionEnergy.Left (Fiber G l) (fun p => hom G l p u=hom G l p v)

abbrev EqualBoth (l : List ℕ) (u v : Interior l⊕Leaves l) :=
  FiberRestrictionEnergy.Both (Fiber G l) (fun p => hom G l p u=hom G l p v)

open Classical in
theorem equality_pair_cauchy (l : List ℕ) (u v : Interior l⊕Leaves l) :
    (Fintype.card (EqualLeft G l u v) : ℝ)^2 ≤
      (Fintype.card (EqualBoth G l u v) : ℝ)*(Fintype.card (Agreement G l) : ℝ) := by
  simpa only [←Nat.card_eq_fintype_card] using
    FiberRestrictionEnergy.left_cauchy (Fiber G l) (fun p => hom G l p u=hom G l p v)

open Classical in
theorem interior_root_both_le_pin (l : List ℕ) (a : Interior l) (r : Leaves l) :
    Fintype.card (EqualBoth G l (.inl a) (.inr r)) ≤ Fintype.card (Pinned G l a) := by
  classical
  let f : EqualBoth G l (.inl a) (.inr r) → Pinned G l a := fun p =>
    ⟨p.1,p.2.1,p.2.2.1.trans ((congrArg (fun t => LayeredAssignments.leafValue l t r) p.2.1).trans
      p.2.2.2.symm)⟩
  have hi : Function.Injective f := by
    intro p q he
    apply Subtype.ext
    exact congrArg (fun t : Pinned G l a => t.val) he
  exact Fintype.card_le_of_injective f hi

open Classical in
/-- The one-copy interior/root degeneracy is bounded by the geometric mean
of the ordinary root-agreement energy and the relevant interior pin. -/
theorem interior_root_left_bound (l : List ℕ) (a : Interior l) (r : Leaves l) :
    (Fintype.card (EqualLeft G l (.inl a) (.inr r)) : ℝ)^2 ≤
      (Fintype.card (Pinned G l a) : ℝ)*(Fintype.card (Agreement G l) : ℝ) := by
  apply (equality_pair_cauchy G l (.inl a) (.inr r)).trans
  apply mul_le_mul_of_nonneg_right _ (Nat.cast_nonneg _)
  exact_mod_cast interior_root_both_le_pin G l a r

end Erdos571.LayeredBush


/-! Replacing a leaf-root value by another when their attachment images
coincide. This preserves homomorphisms, not necessarily copies. -/
namespace Erdos571.LeafRooted
open SimpleGraph
variable {A R W : Type} [DecidableEq R]

def replaceRoot (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f : graph K attach →g G) (r t : R)
    (h : f (.inl (attach r))=f (.inl (attach t))) : graph K attach →g G := by
  let root : R → W := fun w => if w=t then f (.inr r) else f (.inr w)
  have hr (w : R) : G.Adj (f (.inl (attach w))) (root w) := by
    dsimp only [root]
    by_cases he : w=t
    · subst w
      rw [if_pos rfl, ←h]
      exact f.map_rel (show (graph K attach).Adj (.inl (attach r)) (.inr r) from rfl)
    · rw [if_neg he]
      exact f.map_rel (show (graph K attach).Adj (.inl (attach w)) (.inr w) from rfl)
  refine ⟨Sum.elim (fun a => f (.inl a)) root, ?_⟩
  rintro (a|a) (b|b) hab
  · exact f.map_rel hab
  · change a=attach b at hab
    subst a
    exact hr b
  · change b=attach a at hab
    subst b
    exact (hr a).symm
  · exact hab.elim

@[simp] lemma replaceRoot_interior (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f : graph K attach →g G) (r t : R) (h) (a : A) :
    replaceRoot K attach G f r t h (.inl a)=f (.inl a) := rfl

@[simp] lemma replaceRoot_root (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f : graph K attach →g G) (r t : R) (h) (w : R) :
    replaceRoot K attach G f r t h (.inr w) = if w=t then f (.inr r) else f (.inr w) := rfl

@[simp] lemma replaceRoot_kept (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f : graph K attach →g G) (r t : R) (h) :
    replaceRoot K attach G f r t h (.inr r)=f (.inr r) := by
  rw [replaceRoot_root]
  split_ifs <;> rfl

lemma replaceRoot_equal_roots (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f : graph K attach →g G) (r t : R) (h) :
    replaceRoot K attach G f r t h (.inr r)=replaceRoot K attach G f r t h (.inr t) := by
  simp only [replaceRoot_kept, replaceRoot_root, if_true]

lemma replaceRoot_root_agreement (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f g : graph K attach →g G) (r t : R) (hf hg)
    (hr : ∀ w, f (.inr w)=g (.inr w)) (w : R) :
    replaceRoot K attach G f r t hf (.inr w)=replaceRoot K attach G g r t hg (.inr w) := by
  simp only [replaceRoot_root, hr]

/-- The original homomorphism is recovered from the replacement and the
single overwritten leaf value. -/
lemma replaceRoot_recover (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)
    (f g : graph K attach →g G) (r t : R) (hf hg)
    (he : replaceRoot K attach G f r t hf=replaceRoot K attach G g r t hg)
    (ht : f (.inr t)=g (.inr t)) : f=g := by
  ext v
  cases v with
  | inl a =>
    have hh := congrArg (fun k : graph K attach →g G => k (.inl a)) he
    simpa only [replaceRoot_interior] using hh
  | inr w =>
    by_cases hw : w=t
    · simpa only [hw] using ht
    · have h := congrArg (fun k : graph K attach →g G => k (.inr w)) he
      simpa only [replaceRoot_root, if_neg hw] using h

end Erdos571.LeafRooted


/-! A both-copy attachment collision is encoded by either a cross-copy pin,
or by an identified-root pair and one common neighbor. -/
namespace Erdos571.LeafRooted
open SimpleGraph Finset
variable {A R W : Type} [DecidableEq R]
variable (K : SimpleGraph A) (attach : R → A) (G : SimpleGraph W)

abbrev HomPairs := (graph K attach →g G) × (graph K attach →g G)

def Agree (p : HomPairs K attach G) : Prop := ∀ r, p.1 (.inr r)=p.2 (.inr r)

abbrev BothEqual (u v : A⊕R) :=
  {p : HomPairs K attach G // Agree K attach G p ∧ p.1 u=p.1 v ∧ p.2 u=p.2 v}

abbrev HomPin (a : A) :=
  {p : HomPairs K attach G // Agree K attach G p ∧ p.1 (.inl a)=p.2 (.inl a)}

abbrev RootLift (r t : R) (p : BothEqual K attach G (.inr r) (.inr t)) :=
  {w : W // p.1.1 (.inl (attach r)) ≠ p.1.2 (.inl (attach r)) ∧
    G.Adj (p.1.1 (.inl (attach r))) w ∧ G.Adj (p.1.2 (.inl (attach r))) w}

/-- Replacement applied to both parents. -/
def replacePair (r t : R) (p : BothEqual K attach G (.inl (attach r)) (.inl (attach t))) :
    BothEqual K attach G (.inr r) (.inr t) :=
  ⟨(replaceRoot K attach G p.1.1 r t p.2.2.1,
    replaceRoot K attach G p.1.2 r t p.2.2.2),
    replaceRoot_root_agreement K attach G _ _ r t p.2.2.1 p.2.2.2 p.2.1,
    replaceRoot_equal_roots K attach G _ r t p.2.2.1,
    replaceRoot_equal_roots K attach G _ r t p.2.2.2⟩

lemma replacePair_recover (r t : R)
    (p q : BothEqual K attach G (.inl (attach r)) (.inl (attach t)))
    (he : replacePair K attach G r t p=replacePair K attach G r t q)
    (ht : p.1.1 (.inr t)=q.1.1 (.inr t)) : p=q := by
  have h₁ := congrArg (fun z : BothEqual K attach G (.inr r) (.inr t) => z.1.1) he
  have h₂ := congrArg (fun z : BothEqual K attach G (.inr r) (.inr t) => z.1.2) he
  apply Subtype.ext
  exact Prod.ext (replaceRoot_recover K attach G _ _ r t p.2.2.1 q.2.2.1 h₁ ht)
    (replaceRoot_recover K attach G _ _ r t p.2.2.2 q.2.2.2 h₂
      ((p.2.1 t).symm.trans (ht.trans (q.2.1 t))))

noncomputable def collisionEncode (r t : R)
    (p : BothEqual K attach G (.inl (attach r)) (.inl (attach t))) :
    HomPin K attach G (attach r) ⊕
      ((q : BothEqual K attach G (.inr r) (.inr t)) × RootLift K attach G r t q) := by
  classical
  by_cases he : p.1.1 (.inl (attach r))=p.1.2 (.inl (attach r))
  · exact .inl ⟨p.1,p.2.1,he⟩
  · refine .inr ⟨replacePair K attach G r t p, p.1.1 (.inr t), he, ?_, ?_⟩
    · change G.Adj (p.1.1 (.inl (attach r))) (p.1.1 (.inr t))
      rw [p.2.2.1]
      exact p.1.1.map_rel (show (graph K attach).Adj (.inl (attach t)) (.inr t) from rfl)
    · change G.Adj (p.1.2 (.inl (attach r))) (p.1.1 (.inr t))
      rw [p.2.1 t, p.2.2.2]
      exact p.1.2.map_rel (show (graph K attach).Adj (.inl (attach t)) (.inr t) from rfl)

lemma collisionEncode_injective (r t : R) : Function.Injective (collisionEncode K attach G r t) := by
  classical
  intro p q he
  unfold collisionEncode at he
  split_ifs at he
  all_goals first
    | exact False.elim (Sum.noConfusion he)
    | exact Subtype.ext (congrArg (fun z : HomPin K attach G (attach r) => z.1) (Sum.inl.inj he))
    | have he' := Sum.inr.inj he
      apply replacePair_recover K attach G r t p q (congrArg Sigma.fst he')
      exact congrArg (fun z : (q : BothEqual K attach G (.inr r) (.inr t)) × RootLift K attach G r t q => z.2.1) he' 

variable [Fintype A] [Fintype R] [Fintype W] [DecidableRel K.Adj] [DecidableRel G.Adj]

open Classical in
lemma rootLift_card_le (r t : R) (L : ℕ)
    (hcodeg : ∀ x y, x ≠ y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (p : BothEqual K attach G (.inr r) (.inr t)) :
    Fintype.card (RootLift K attach G r t p) ≤ L := by
  classical
  by_cases he : p.1.1 (.inl (attach r))=p.1.2 (.inl (attach r))
  · have hi : IsEmpty (RootLift K attach G r t p) := ⟨fun x => x.2.1 he⟩
    exact (Fintype.card_eq_zero_iff.mpr hi).le.trans (Nat.zero_le L)
  · apply le_trans _ (hcodeg _ _ he)
    exact Fintype.card_le_of_injective (fun x : RootLift K attach G r t p =>
      (⟨x.1,x.2.2⟩ : G.commonNeighbors _ _)) (fun x y h => by
        apply Subtype.ext
        have hh := congrArg (fun z : G.commonNeighbors (p.1.1 (.inl (attach r))) (p.1.2 (.inl (attach r))) => z.val) h
        exact hh)

open Classical in
/-- This is an actual finite homomorphism count, not a masked-kernel estimate. -/
theorem attachment_collision_bound (r t : R) (L : ℕ)
    (hcodeg : ∀ x y, x ≠ y → Fintype.card (G.commonNeighbors x y) ≤ L) :
    Fintype.card (BothEqual K attach G (.inl (attach r)) (.inl (attach t))) ≤
      Fintype.card (HomPin K attach G (attach r)) +
        L*Fintype.card (BothEqual K attach G (.inr r) (.inr t)) := by
  classical
  have hi := Fintype.card_le_of_injective _ (collisionEncode_injective K attach G r t)
  apply hi.trans
  rw [Fintype.card_sum, Fintype.card_sigma]
  apply Nat.add_le_add_left
  calc
    _ ≤ ∑ _p : BothEqual K attach G (.inr r) (.inr t), L :=
      sum_le_sum (fun p _ => rootLift_card_le K attach G r t L hcodeg p)
    _ = _ := by simp [Nat.mul_comm]

end Erdos571.LeafRooted


/-! Transfer the leaf replacement encoding to the layered assignment counts. -/
namespace Erdos571.LayeredBush
open SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

lemma labels_eq_iff_root_agreement (l : List ℕ) (p q : Full G l) :
    p.1=q.1 ↔ ∀ r, hom G l p (.inr r)=hom G l q (.inr r) := by
  constructor
  · intro h r
    exact congrArg (fun t => leafValue l t r) h
  · intro h
    apply leafValue_injective l
    exact funext h

def equalBothHomEquiv (l : List ℕ) (u v : Interior l⊕Leaves l) :
    EqualBoth G l u v ≃ LeafRooted.BothEqual (core l) (attach l) G u v :=
  (Equiv.prodCongr (homEquiv G l) (homEquiv G l)).subtypeEquiv (by
    intro p
    change (p.1.1=p.2.1 ∧ hom G l p.1 u=hom G l p.1 v ∧ hom G l p.2 u=hom G l p.2 v) ↔
      ((∀ r, hom G l p.1 (.inr r)=hom G l p.2 (.inr r)) ∧
        hom G l p.1 u=hom G l p.1 v ∧ hom G l p.2 u=hom G l p.2 v)
    rw [labels_eq_iff_root_agreement])

def pinHomEquiv (l : List ℕ) (a : Interior l) :
    Pinned G l a ≃ LeafRooted.HomPin (core l) (attach l) G a :=
  (Equiv.prodCongr (homEquiv G l) (homEquiv G l)).subtypeEquiv (by
    intro p
    change (p.1.1=p.2.1 ∧ hom G l p.1 (.inl a)=hom G l p.2 (.inl a)) ↔
      ((∀ r, hom G l p.1 (.inr r)=hom G l p.2 (.inr r)) ∧
        hom G l p.1 (.inl a)=hom G l p.2 (.inl a))
    rw [labels_eq_iff_root_agreement])

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

set_option maxHeartbeats 1600000 in
open Classical in
/-- Under a global codegree cap, a collision between the attachments of two
leaf roots costs a same-position pin plus L times the repeated-root count. -/
theorem attachment_collision_bound (l : List ℕ) (r t : Leaves l) (L : ℕ)
    (hcodeg : ∀ x y, x ≠ y → Fintype.card (G.commonNeighbors x y) ≤ L) :
    Fintype.card (EqualBoth G l (.inl (attach l r)) (.inl (attach l t))) ≤
      Fintype.card (Pinned G l (attach l r)) +
        L*Fintype.card (EqualBoth G l (.inr r) (.inr t)) := by
  classical
  have h := LeafRooted.attachment_collision_bound (core l) (attach l) G r t L hcodeg
  have h₁ := Nat.card_congr (equalBothHomEquiv G l (.inl (attach l r)) (.inl (attach l t)))
  have h₂ := Nat.card_congr (equalBothHomEquiv G l (.inr r) (.inr t))
  have h₃ := Nat.card_congr (pinHomEquiv G l (attach l r))
  simp only [←Nat.card_eq_fintype_card] at h ⊢
  rwa [←h₁, ←h₂, ←h₃] at h


end Erdos571.LayeredBush


/-! Union and Cauchy bounds for a finite list of forbidden equality patterns. -/
namespace Erdos571.FiberRestrictionEnergy
open Finset
variable {R I : Type*} (F : R → Type*) [Fintype R] [∀ r, Fintype (F r)] [Fintype I]

open Classical in
lemma left_union_bound (P : Sigma F → Prop) (Q : I → Sigma F → Prop)
    (hcover : ∀ p, P p → ∃ i, Q i p) :
    Fintype.card (Left F P) ≤ ∑ i, Fintype.card (Left F (Q i)) := by
  classical
  let f : Left F P → ((i : I) × Left F (Q i)) := fun p =>
    ⟨(hcover p.1.1 p.2.2).choose, p.1,p.2.1,(hcover p.1.1 p.2.2).choose_spec⟩
  have hi : Function.Injective f := by
    intro p q he
    apply Subtype.ext
    exact congrArg (fun z : (i : I) × Left F (Q i) => z.2.1) he
  simpa only [Fintype.card_sigma] using Fintype.card_le_of_injective f hi

open Classical in
/-- A union of restrictions costs only the number of patterns in the
squared one-copy bound, with the both-copy energies added. -/
theorem left_union_cauchy (P : Sigma F → Prop) (Q : I → Sigma F → Prop)
    (hcover : ∀ p, P p → ∃ i, Q i p) :
    (Fintype.card (Left F P) : ℝ)^2 ≤
      Fintype.card I * (Fintype.card (Agreement F) : ℝ) *
        ∑ i, (Fintype.card (Both F (Q i)) : ℝ) := by
  classical
  have hu : (Fintype.card (Left F P) : ℝ) ≤ ∑ i, (Fintype.card (Left F (Q i)) : ℝ) := by
    exact_mod_cast left_union_bound F P Q hcover
  have hc := sum_mul_sq_le_sq_mul_sq univ (fun _ : I => (1:ℝ))
    (fun i => (Fintype.card (Left F (Q i)) : ℝ))
  simp only [one_mul, one_pow, sum_const, card_univ, nsmul_eq_mul, mul_one] at hc
  calc
    _ ≤ (∑ i, (Fintype.card (Left F (Q i)) : ℝ))^2 :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) hu 2
    _ ≤ (Fintype.card I : ℝ)*∑ i, (Fintype.card (Left F (Q i)) : ℝ)^2 := hc
    _ ≤ (Fintype.card I : ℝ)*∑ i,
        (Fintype.card (Both F (Q i)) : ℝ)*(Fintype.card (Agreement F) : ℝ) :=
      mul_le_mul_of_nonneg_left (sum_le_sum (fun i _ => left_cauchy F (Q i))) (Nat.cast_nonneg _)
    _ = _ := by rw [←sum_mul]; ring

end Erdos571.FiberRestrictionEnergy


/-! Reducing noninjective-copy energy to a finite sum of both-copy equality
energies. This does not discard any homomorphisms. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev DistinctRoles (l : List ℕ) :=
  {p : (Interior l⊕Leaves l)×(Interior l⊕Leaves l) // p.1≠p.2}

open Classical in
/-- Every noninjective first parent has a specified pair of distinct template
roles with the same image. The right-hand energies impose that equality in
both parents. -/
theorem bad_left_equalities_bound (l : List ℕ) :
    (Fintype.card (BadLeft G l) : ℝ)^2 ≤
      Fintype.card (DistinctRoles l) * (Fintype.card (Agreement G l) : ℝ) *
        ∑ p : DistinctRoles l, (Fintype.card (EqualBoth G l p.1.1 p.1.2) : ℝ) := by
  classical
  have h := FiberRestrictionEnergy.left_union_cauchy (Fiber G l)
    (fun p => ¬Function.Injective (hom G l p))
    (fun q : DistinctRoles l => fun p => hom G l p q.1.1=hom G l p q.1.2) (by
      intro p hp
      obtain ⟨u,v,he,hne⟩ := Function.not_injective_iff.mp hp
      exact ⟨⟨(u,v),hne⟩,he⟩)
  simpa only [←Nat.card_eq_fintype_card] using h

end Erdos571.LayeredBush


/-! Finite counts for two dependent choices whose base values coincide. -/
namespace Erdos571.EqualSigmaCounts
variable {U : Type*}

def sameBaseEquiv (F H : U → Type*) :
    {p : (Sigma F)×(Sigma H) // p.1.1=p.2.1} ≃ ((u : U) × (F u×H u)) where
  toFun p := by
    rcases p with ⟨⟨⟨u,p⟩,⟨v,q⟩⟩,he⟩
    change u=v at he
    subst v
    exact ⟨u,p,q⟩
  invFun p := ⟨(⟨p.1,p.2.1⟩,⟨p.1,p.2.2⟩),rfl⟩
  left_inv p := by
    rcases p with ⟨⟨⟨u,p⟩,⟨v,q⟩⟩,he⟩
    change u=v at he
    subst v
    rfl
  right_inv p := by rcases p with ⟨u,p,q⟩; rfl

def twoEqualBaseEquiv (F : Fin 2 → U → Type*) :
    {p : (i : Fin 2) → Sigma (F i) // (p 0).1=(p 1).1} ≃
      ((u : U) × (F 0 u×F 1 u)) :=
  ((piFinTwoEquiv (fun i => Sigma (F i))).subtypeEquiv (fun _ => Iff.rfl)).trans
    (sameBaseEquiv (F 0) (F 1))

variable [Fintype U]
open Classical in
lemma card_twoEqualBase (F : Fin 2 → U → Type*) [∀ i u, Fintype (F i u)] :
    Fintype.card {p : (i : Fin 2) → Sigma (F i) // (p 0).1=(p 1).1} =
      ∑ u, Fintype.card (F 0 u)*Fintype.card (F 1 u) := by
  classical
  simpa only [Fintype.card_sigma, Fintype.card_prod] using
    Fintype.card_congr (twoEqualBaseEquiv F)

end Erdos571.EqualSigmaCounts


/-! The exact both-copy same-hub collision energy for the subdivided symmetric
double star, in the ordinary homomorphism model. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredAssignments LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev HubEqualAssignment (s : ℕ) (x : W) (r : Labels W [2,s]) :=
  {p : Assignment G [2,s] x r //
    interiorValue G [2,s] p (some (0,anchor [s]))=
      interiorValue G [2,s] p (some (1,anchor [s]))}

abbrev HubEqualFiber (s : ℕ) (r : Labels W [2,s]) :=
  {p : Fiber G [2,s] r //
    interiorValue G [2,s] p.2 (some (0,anchor [s]))=
      interiorValue G [2,s] p.2 (some (1,anchor [s]))}

def hubEqualFiberEquiv (s : ℕ) (r : Labels W [2,s]) :
    HubEqualFiber G s r ≃ ((x : W) × HubEqualAssignment G s x r) where
  toFun p := ⟨p.1.1,p.1.2,p.2⟩
  invFun p := ⟨⟨p.1,p.2.1⟩,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

open Classical in
lemma hubEqualAssignment_card (s : ℕ) (x : W) (r : Labels W [2,s]) :
    (Fintype.card (HubEqualAssignment G s x r) : ℝ) =
      ∑ u, G.adjMatrix ℝ x u * feature (G.adjMatrix ℝ) [s] u (r 0) *
        feature (G.adjMatrix ℝ) [s] u (r 1) := by
  classical
  have h := EqualSigmaCounts.card_twoEqualBase
    (fun i : Fin 2 => fun u : W => PLift (G.Adj x u)×Assignment G [s] u (r i))
  have hc : Fintype.card (HubEqualAssignment G s x r)=
      ∑ u, Fintype.card (PLift (G.Adj x u)×Assignment G [s] u (r 0))*
        Fintype.card (PLift (G.Adj x u)×Assignment G [s] u (r 1)) := by
    simpa only [←Nat.card_eq_fintype_card] using h
  rw [hc, Nat.cast_sum]
  apply sum_congr rfl
  intro u hu
  simp only [Fintype.card_prod, Nat.cast_mul, card_adj, card_assignment]
  by_cases ha : G.Adj x u <;> simp only [SimpleGraph.adjMatrix_apply, ha, if_true, if_false] <;> ring

open Classical in
lemma hubEqualFiber_card (s : ℕ) (r : Labels W [2,s]) :
    (Fintype.card (HubEqualFiber G s r) : ℝ) =
      ∑ u, (G.degree u : ℝ) * feature (G.adjMatrix ℝ) [s] u (r 0) *
        feature (G.adjMatrix ℝ) [s] u (r 1) := by
  classical
  rw [Fintype.card_congr (hubEqualFiberEquiv G s r)]
  simp only [Fintype.card_sigma, Nat.cast_sum, hubEqualAssignment_card]
  rw [sum_comm]
  apply sum_congr rfl
  intro u hu
  rw [←sum_mul, ←sum_mul]
  congr 2
  have hd := G.adjMatrix_mulVec_const_apply (α := ℝ) (a := 1) (v := u)
  simp only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] at hd
  simpa only [G.isSymm_adjMatrix.apply] using hd

open Classical in
/-- Equality of the two hubs inside each parent is exactly the squared
Frobenius mass of the degree-weighted branch Gram matrix. -/
theorem hub_equality_card (s : ℕ) :
    (Fintype.card (EqualBoth G [2,s]
      (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) =
      squareMass (fun x y : Fin s → W =>
        ∑ u, (G.degree u : ℝ) * branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s u x *
          branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s u y) := by
  classical
  rw [Fintype.card_congr (FiberRestrictionEnergy.bothEquiv (Fiber G [2,s])
    (fun p => hom G [2,s] p (.inl (some (0,anchor [s])))=
      hom G [2,s] p (.inl (some (1,anchor [s])))))]
  simp only [Fintype.card_sigma, Fintype.card_prod, Nat.cast_sum, Nat.cast_mul]
  change (∑ r : Labels W [2,s], (Fintype.card (HubEqualFiber G s r) : ℝ)*
    (Fintype.card (HubEqualFiber G s r) : ℝ))=_
  simp only [hubEqualFiber_card, ←pow_two]
  have h := Fintype.sum_equiv (finTwoArrowEquiv (Fin s → W))
    (fun r : Fin 2 → Fin s → W =>
      (∑ u, (G.degree u : ℝ)*branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s u (r 0)*
        branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s u (r 1))^2)
    (fun p : (Fin s → W)×(Fin s → W) =>
      (∑ u, (G.degree u : ℝ)*branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s u p.1*
        branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s u p.2)^2) (fun r => rfl)
  simpa only [squareMass, Fintype.sum_prod_type, feature, pow_two] using h

open Classical in
/-- The actual both-copy same-hub count has the same sharp squared upper
bound as the center and hub pins, with a global codegree cap. -/
theorem hub_equality_bound_global (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (s : ℕ) (hs : 1 ≤ s) :
    (Fintype.card (EqualBoth G [2,s]
      (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ)^2 ≤
      Fintype.card W*((L+1)*D^2)^(2*s+1)*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let F := branch (A*A) s
  let T := (L+1)*D^2
  let Z : Matrix (Fin s → W) (Fin s → W) ℝ := fun x y => ∑ u, (G.degree u : ℝ)*F u x*F u y
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hAn (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  have hFn := branch_nonneg (chain_nonneg hAn hAn) s
  have hZn (x y : Fin s → W) : 0 ≤ Z x y :=
    sum_nonneg (fun u _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hFn u x)) (hFn u y))
  have hZF (x y : Fin s → W) : Z x y ≤ D*(F.transpose*F) x y := by
    simp only [Z, Matrix.mul_apply, Matrix.transpose_apply, mul_sum]
    apply sum_le_sum
    intro u hu
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (hdeg u) (hFn u x)) (hFn u y)
  have hK (u v : W) : (F*F.transpose) u v=(Q u v)^s :=
    congrArg (fun B : Matrix W W ℝ => B u v) (short_branchKernel A G.isSymm_adjMatrix s)
  have hQT := graph_fourWalk_entries G L D hL hD hdeg hcodeg
  have h := unmasked_degeneracy_bound A G.isSymm_adjMatrix F Q s hs T D
    (fun u v => (hQT u v).1) (fun u v => (hQT u v).2)
    (fun u v => by rw [hAA]) hK Z hZn hZF
  have hp : D^2*T^(s-1) ≤ T^s := by
    have hdT : D^2 ≤ T := by dsimp [T]; nlinarith [sq_nonneg D]
    calc
      _ ≤ T*T^(s-1) := mul_le_mul_of_nonneg_right hdT (pow_nonneg hT _)
      _ = T^s := by rw [←pow_succ']; congr 1; omega
  have hM : squareMass (A*A) ≤ Fintype.card W*T := graph_gram_mass_bound G L D hL hD hdeg hcodeg
  have hE : squareMass ((A*F).transpose*(A*F))=bilateralEnergy A Q s :=
    (bilateral_as_columnGram A G.isSymm_adjMatrix s).symm
  rw [hub_equality_card, bilateral_agreement_card]
  change squareMass Z^2 ≤ Fintype.card W*T^(2*s+1)*bilateralEnergy A Q s
  calc
    _ ≤ (D^2*T^(s-1))^2*squareMass (A*A)*squareMass ((A*F).transpose*(A*F)) := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*squareMass ((A*F).transpose*(A*F)) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul (pow_le_pow_left₀ (by positivity) hp 2) hM (squareMass_nonneg _) (sq_nonneg _))
        (squareMass_nonneg _)
    _ = _ := by
      rw [hE, ←pow_mul, show s*2=2*s by omega, pow_succ]
      ring

end Erdos571.LayeredBush


/-! Repeated-coordinate estimates for nonnegative tensor features. -/
namespace Erdos571.TensorRootCollisions
open Finset
variable {I W : Type*} [Fintype I] [Fintype W] [DecidableEq I] [DecidableEq W]

lemma product_split (j : I) (f : I → ℝ) :
    (∏ i, f i) = f j * ∏ i : {i : I // i≠j}, f i.1 := by
  have h := Fintype.prod_subtype_mul_prod_subtype (fun i : I => i=j) f
  simpa using h.symm

/-- Removing a forced repeated coordinate saves one entire free sum. The
remaining repeated factor needs only a cap on the allowed values. -/
theorem same_coordinate_bound (f : W → ℝ) (hf : ∀ w, 0 ≤ f w)
    (j k : I) (hjk : j≠k) (P : W → Prop) [DecidablePred P]
    (C : ℝ) (hC : 0 ≤ C) (hcap : ∀ w, P w → f w ≤ C) :
    (∑ x : I → W, if x j=x k ∧ P (x j) then ∏ i, f (x i) else 0) ≤
      C*(∑ w, f w)^(Fintype.card I-1) := by
  let J := {i : I // i≠j}
  let k' : J := ⟨k,Ne.symm hjk⟩
  have hsplit := Fintype.sum_equiv (Equiv.funSplitAt j W)
    (fun x : I → W => if x j=x k ∧ P (x j) then ∏ i, f (x i) else 0)
    (fun p : W×(J → W) => if p.1=p.2 k' ∧ P p.1 then
      f p.1*∏ i : J, f (p.2 i) else 0) (by
      intro x
      simp only [Equiv.funSplitAt_apply]
      rw [product_split j (fun i => f (x i))])
  rw [hsplit, Fintype.sum_prod_type, sum_comm]
  have hcard : Fintype.card J=Fintype.card I-1 := by
    simpa only [Fintype.card_unique] using Fintype.card_subtype_compl (fun i : I => i=j)
  have hprod : (∑ y : J → W, ∏ i : J, f (y i))=(∑ w, f w)^(Fintype.card I-1) := by
    rw [←Fintype.prod_sum]
    simp only [prod_const, card_univ, hcard]
  calc
    _ ≤ ∑ y : J → W, C*∏ i : J, f (y i) := by
      apply sum_le_sum
      intro y hy
      have he : (∑ w, if w=y k' ∧ P w then f w*∏ i : J, f (y i) else 0)=
          if P (y k') then f (y k')*∏ i : J, f (y i) else 0 := by
        rw [sum_eq_single (y k')]
        · simp
        · intro w hw hne
          simp [hne]
        · simp
      rw [he]
      by_cases hp : P (y k')
      · rw [if_pos hp]
        exact mul_le_mul_of_nonneg_right (hcap _ hp) (prod_nonneg (fun i _ => hf _))
      · rw [if_neg hp]
        exact mul_nonneg hC (prod_nonneg (fun i _ => hf _))
    _ = _ := by rw [←mul_sum, hprod]

/-- Arbitrary weighting of one coordinate separates from the other tensor
coordinates. -/
lemma weighted_coordinate_sum (f h : W → ℝ) (j : I) :
    (∑ x : I → W, h (x j)*∏ i, f (x i)) =
      (∑ w, h w*f w)*(∑ w, f w)^(Fintype.card I-1) := by
  let J := {i : I // i≠j}
  have hsplit := Fintype.sum_equiv (Equiv.funSplitAt j W)
    (fun x : I → W => h (x j)*∏ i, f (x i))
    (fun p : W×(J → W) => (h p.1*f p.1)*∏ i : J, f (p.2 i)) (by
      intro x
      simp only [Equiv.funSplitAt_apply, product_split j (fun i => f (x i)), mul_assoc]
      rfl)
  rw [hsplit, Fintype.sum_prod_type]
  have hcard : Fintype.card J=Fintype.card I-1 := by
    simpa only [Fintype.card_unique] using Fintype.card_subtype_compl (fun i : I => i=j)
  have hprod : (∑ y : J → W, ∏ i : J, f (y i))=(∑ w, f w)^(Fintype.card I-1) := by
    rw [←Fintype.prod_sum]
    simp only [prod_const, card_univ, hcard]
  simp only [←mul_sum, ←sum_mul]
  congr 1

lemma weighted_coordinate_pair_sum (f g : W → ℝ) (H : W → W → ℝ) (j k : I) :
    (∑ x : I → W, ∑ y : I → W,
      H (x j) (y k)*(∏ i, f (x i))*(∏ i, g (y i))) =
      (∑ u, ∑ v, H u v*f u*g v)*
        (∑ u, f u)^(Fintype.card I-1)*(∑ v, g v)^(Fintype.card I-1) := by
  have hinner (x : I → W) :
      (∑ y : I → W, H (x j) (y k)*(∏ i, f (x i))*(∏ i, g (y i))) =
        ((∑ v, H (x j) v*g v)*(∏ i, f (x i)))*(∑ v, g v)^(Fintype.card I-1) := by
    have h := weighted_coordinate_sum g (H (x j)) k
    calc
      _ = (∑ y : I → W, H (x j) (y k)*(∏ i, g (y i)))*(∏ i, f (x i)) := by
        rw [sum_mul]
        apply sum_congr rfl
        intro y hy
        ring
      _ = _ := by rw [h]; ring
  simp only [hinner, ←sum_mul]
  rw [weighted_coordinate_sum f (fun u => ∑ v, H u v*g v) j]
  congr 2
  apply sum_congr rfl
  intro u hu
  rw [sum_mul]
  apply sum_congr rfl
  intro v hv
  ring

/-- Two tensors sharing a selected root have one fourfold factor in place
of the two independent root sums. -/
lemma cross_coordinate_identity (f g : W → ℝ) (P : W → Prop) [DecidablePred P]
    (j k : I) :
    (∑ x : I → W, ∑ y : I → W,
      if x j=y k ∧ P (x j) then (∏ i, f (x i))*(∏ i, g (y i)) else 0) =
      (∑ w, if P w then f w*g w else 0)*
        (∑ u, f u)^(Fintype.card I-1)*(∑ v, g v)^(Fintype.card I-1) := by
  have h := weighted_coordinate_pair_sum f g
    (fun u v => if u=v ∧ P u then 1 else 0) j k
  have hleft : (∑ x : I → W, ∑ y : I → W,
      (if x j=y k ∧ P (x j) then (1:ℝ) else 0)*(∏ i, f (x i))*(∏ i, g (y i))) =
      ∑ x : I → W, ∑ y : I → W,
        if x j=y k ∧ P (x j) then (∏ i, f (x i))*(∏ i, g (y i)) else 0 := by
    simp only [ite_mul, one_mul, zero_mul]
  have hroot : (∑ u, ∑ v, (if u=v ∧ P u then (1:ℝ) else 0)*f u*g v)=
      ∑ w, if P w then f w*g w else 0 := by
    apply sum_congr rfl
    intro u hu
    by_cases hp : P u
    · simp only [hp, and_true, ite_mul, one_mul, zero_mul]
      simp
    · simp [hp]
  rwa [hleft, hroot] at h

end Erdos571.TensorRootCollisions


/-! Counts and weighted sums obtained by fixing the base values of dependent
choices. -/
namespace Erdos571.FixedSigmaCounts
open Finset
variable {U : Type*}

def fixedBaseEquiv (F : U → Type*) (u : U) : {p : Sigma F // p.1=u} ≃ F u where
  toFun p := by
    rcases p with ⟨⟨v,p⟩,he⟩
    change v=u at he
    subst v
    exact p
  invFun p := ⟨⟨u,p⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨v,p⟩,he⟩
    change v=u at he
    subst v
    rfl
  right_inv _ := rfl

def twoFixedBaseEquiv (F : Fin 2 → U → Type*) (u v : U) :
    {p : (i : Fin 2) → Sigma (F i) // ((p 0).1,(p 1).1)=(u,v)} ≃ (F 0 u×F 1 v) :=
  ((piFinTwoEquiv (fun i => Sigma (F i))).subtypeEquiv (by
    intro p
    change ((p 0).1,(p 1).1)=(u,v) ↔ (p 0).1=u ∧ (p 1).1=v
    simp only [Prod.mk.injEq])).trans
    (Equiv.subtypeProdEquivProd.trans (Equiv.prodCongr (fixedBaseEquiv (F 0) u) (fixedBaseEquiv (F 1) v)))

variable [Fintype U]
open Classical in
lemma card_twoFixedBase (F : Fin 2 → U → Type*) [∀ i u, Fintype (F i u)] (u v : U) :
    Fintype.card {p : (i : Fin 2) → Sigma (F i) // ((p 0).1,(p 1).1)=(u,v)} =
      Fintype.card (F 0 u)*Fintype.card (F 1 v) := by
  classical
  simpa only [Fintype.card_prod] using Fintype.card_congr (twoFixedBaseEquiv F u v)

variable {V : Type*} [Fintype V] [DecidableEq V]
lemma weighted_tag_sum (tag : U → V) (w : V → ℝ) :
    (∑ p, w (tag p))=∑ v, (Fintype.card {p : U // tag p=v} : ℝ)*w v := by
  rw [←Fintype.sum_fiberwise tag (fun p => w (tag p))]
  apply sum_congr rfl
  intro v hv
  calc
    _ = ∑ _p : {p : U // tag p=v}, w v := sum_congr rfl (fun p _ => congrArg w p.2)
    _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul]

lemma weighted_pair_tag_sum (tag : U → V) (w : V → V → ℝ) :
    (∑ p, ∑ q, w (tag p) (tag q))=∑ u, ∑ v,
      (Fintype.card {p : U // tag p=u} : ℝ)*(Fintype.card {p : U // tag p=v} : ℝ)*w u v := by
  calc
    _ = ∑ p, ∑ v, (Fintype.card {p : U // tag p=v} : ℝ)*w (tag p) v :=
      sum_congr rfl (fun p _ => weighted_tag_sum tag (w (tag p)))
    _ = ∑ v, ∑ p, (Fintype.card {p : U // tag p=v} : ℝ)*w (tag p) v := sum_comm
    _ = ∑ v, ∑ u, (Fintype.card {p : U // tag p=u} : ℝ)*
        ((Fintype.card {p : U // tag p=v} : ℝ)*w u v) :=
      sum_congr rfl (fun v _ => weighted_tag_sum tag
        (fun u => (Fintype.card {p : U // tag p=v} : ℝ)*w u v))
    _ = _ := by rw [sum_comm]; simp only [mul_assoc]

end Erdos571.FixedSigmaCounts


/-! Exact fixed-hub counts and arbitrary hub/root-weighted agreement sums
for the rootless subdivided symmetric double star. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredAssignments LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

def assignmentHubs (s : ℕ) {x : W} {r : Labels W [2,s]} (p : Assignment G [2,s] x r) : W×W :=
  ((p 0).1,(p 1).1)

def fiberHubs (s : ℕ) (r : Labels W [2,s]) (p : Fiber G [2,s] r) : W×W := assignmentHubs G s p.2

def fullHubs (s : ℕ) (p : Full G [2,s]) : W×W := fiberHubs G s p.1 p.2

abbrev HubFixedAssignment (s : ℕ) (x : W) (r : Labels W [2,s]) (u v : W) :=
  {p : Assignment G [2,s] x r // assignmentHubs G s p=(u,v)}

abbrev HubFixedFiber (s : ℕ) (r : Labels W [2,s]) (u v : W) :=
  {p : Fiber G [2,s] r // fiberHubs G s r p=(u,v)}

def hubFixedFiberEquiv (s : ℕ) (r : Labels W [2,s]) (u v : W) :
    HubFixedFiber G s r u v ≃ ((x : W) × HubFixedAssignment G s x r u v) where
  toFun p := ⟨p.1.1,p.1.2,p.2⟩
  invFun p := ⟨⟨p.1,p.2.1⟩,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

open Classical in
lemma hubFixedAssignment_card (s : ℕ) (x : W) (r : Labels W [2,s]) (u v : W) :
    (Fintype.card (HubFixedAssignment G s x r u v) : ℝ) =
      G.adjMatrix ℝ x u * feature (G.adjMatrix ℝ) [s] u (r 0) *
        (G.adjMatrix ℝ x v * feature (G.adjMatrix ℝ) [s] v (r 1)) := by
  classical
  have h := FixedSigmaCounts.card_twoFixedBase
    (fun i : Fin 2 => fun u : W => PLift (G.Adj x u)×Assignment G [s] u (r i)) u v
  have hc : Fintype.card (HubFixedAssignment G s x r u v)=
      Fintype.card (PLift (G.Adj x u)×Assignment G [s] u (r 0))*
        Fintype.card (PLift (G.Adj x v)×Assignment G [s] v (r 1)) := by
    simpa only [←Nat.card_eq_fintype_card] using h
  rw [hc]
  simp only [Fintype.card_prod, Nat.cast_mul, card_adj, card_assignment]

open Classical in
lemma hubFixedFiber_card (s : ℕ) (r : Labels W [2,s]) (u v : W) :
    (Fintype.card (HubFixedFiber G s r u v) : ℝ) =
      (G.adjMatrix ℝ * G.adjMatrix ℝ) u v * feature (G.adjMatrix ℝ) [s] u (r 0) *
        feature (G.adjMatrix ℝ) [s] v (r 1) := by
  classical
  rw [Fintype.card_congr (hubFixedFiberEquiv G s r u v)]
  simp only [Fintype.card_sigma, Nat.cast_sum, hubFixedAssignment_card, Matrix.mul_apply, sum_mul]
  apply sum_congr rfl
  intro x hx
  rw [G.isSymm_adjMatrix.apply x u]
  ring

open Classical in
lemma fiber_hub_sum (s : ℕ) (r : Labels W [2,s]) (w : (W×W) → ℝ) :
    (∑ p : Fiber G [2,s] r, w (fiberHubs G s r p))=
      ∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v *
        feature (G.adjMatrix ℝ) [s] u (r 0) * feature (G.adjMatrix ℝ) [s] v (r 1)*w (u,v) := by
  rw [FixedSigmaCounts.weighted_tag_sum (fiberHubs G s r) w, Fintype.sum_prod_type]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by rw [hubFixedFiber_card]))

open Classical in
lemma agreement_hub_sum (s : ℕ) (w : Labels W [2,s] → (W×W) → (W×W) → ℝ) :
    (∑ p : Agreement G [2,s], w p.1.1.1 (fullHubs G s p.1.1) (fullHubs G s p.1.2))=
      ∑ r, ∑ u, ∑ v, ∑ x, ∑ y,
        ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v * feature (G.adjMatrix ℝ) [s] u (r 0) *
          feature (G.adjMatrix ℝ) [s] v (r 1)) *
        ((G.adjMatrix ℝ * G.adjMatrix ℝ) x y * feature (G.adjMatrix ℝ) [s] x (r 0) *
          feature (G.adjMatrix ℝ) [s] y (r 1)) * w r (u,v) (x,y) := by
  classical
  have he := Fintype.sum_equiv (agreementEquiv G [2,s])
    (fun p : Agreement G [2,s] => w p.1.1.1 (fullHubs G s p.1.1) (fullHubs G s p.1.2))
    (fun p : (r : Labels W [2,s]) × (Fiber G [2,s] r×Fiber G [2,s] r) =>
      w p.1 (fiberHubs G s p.1 p.2.1) (fiberHubs G s p.1 p.2.2)) (by
      rintro ⟨⟨⟨r,p⟩,⟨t,q⟩⟩,ht⟩
      change r=t at ht
      subst t
      rfl)
  rw [he, Fintype.sum_sigma]
  apply sum_congr rfl
  intro r hr
  rw [Fintype.sum_prod_type, FixedSigmaCounts.weighted_pair_tag_sum (fiberHubs G s r) (w r)]
  simp only [Fintype.sum_prod_type, hubFixedFiber_card]

end Erdos571.LayeredBush


/-! Root events in the actual root-agreeing homomorphism pair model, indexed
by the four hub images. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredAssignments LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

def hubIndexEquiv : ((W×W)×(W×W)) ≃ (W×W×W×W) where
  toFun p := (p.1.1,p.2.1,p.2.2,p.1.2)
  invFun p := ((p.1,p.2.2.2),(p.2.1,p.2.2.1))
  left_inv _ := rfl
  right_inv _ := rfl

def fullHubQuad (s : ℕ) (p q : Full G [2,s]) : W×W×W×W :=
  hubIndexEquiv (fullHubs G s p,fullHubs G s q)

open Classical in
lemma agreement_hub_quad_sum (s : ℕ) (w : Labels W [2,s] → (W×W×W×W) → ℝ) :
    (∑ e : Agreement G [2,s], w e.1.1.1 (fullHubQuad G s e.1.1 e.1.2)) =
      ∑ r, ∑ p : W×W×W×W, bilateralWeight (G.adjMatrix ℝ) p *
        (branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.1 (r 0)*
          branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.1 (r 0)) *
        (branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.2.1 (r 1)*
          branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.2.2 (r 1)) * w r p := by
  classical
  rw [show (∑ e : Agreement G [2,s], w e.1.1.1 (fullHubQuad G s e.1.1 e.1.2))=
      ∑ e : Agreement G [2,s], (fun r u v => w r (hubIndexEquiv (u,v)))
        e.1.1.1 (fullHubs G s e.1.1) (fullHubs G s e.1.2) from rfl,
    agreement_hub_sum G s (fun r u v => w r (hubIndexEquiv (u,v)))]
  apply sum_congr rfl
  intro r hr
  let N := G.adjMatrix ℝ * G.adjMatrix ℝ
  have hN : N.IsSymm := by
    show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=_
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  have h := Fintype.sum_equiv (hubIndexEquiv (W := W))
    (fun q : (W×W)×(W×W) =>
      (N q.1.1 q.1.2 * branch N s q.1.1 (r 0)*branch N s q.1.2 (r 1))*
      (N q.2.1 q.2.2 * branch N s q.2.1 (r 0)*branch N s q.2.2 (r 1))*w r (hubIndexEquiv q))
    (fun p : W×W×W×W => bilateralWeight (G.adjMatrix ℝ) p *
      (branch N s p.1 (r 0)*branch N s p.2.1 (r 0))*
      (branch N s p.2.2.1 (r 1)*branch N s p.2.2.2 (r 1))*w r p) (by
      intro q
      simp only [hubIndexEquiv, Equiv.coe_fn_mk, bilateralWeight, G.isSymm_adjMatrix.eq]
      change (N q.1.1 q.1.2*_*_)*(N q.2.1 q.2.2*_*_)*_=
        (N q.1.1 q.1.2*N q.2.2 q.2.1)*(_*_)*(_*_)*_
      rw [hN.apply q.2.2 q.2.1]
      ring)
  simpa only [Fintype.sum_prod_type, feature] using h

abbrev RootEvent (s : ℕ) (P : Labels W [2,s] → (W×W×W×W) → Prop) :=
  {e : Agreement G [2,s] // P e.1.1.1 (fullHubQuad G s e.1.1 e.1.2)}

open Classical in
lemma rootEvent_card (s : ℕ) (P : Labels W [2,s] → (W×W×W×W) → Prop) :
    (Fintype.card (RootEvent G s P) : ℝ)=
      ∑ p : W×W×W×W, bilateralWeight (G.adjMatrix ℝ) p *
        ∑ r, (branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.1 (r 0)*
          branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.1 (r 0)) *
        (branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.2.1 (r 1)*
          branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.2.2 (r 1)) *
        (if P r p then 1 else 0) := by
  classical
  rw [card_subtype_real, agreement_hub_quad_sum G s (fun r p => if P r p then 1 else 0), sum_comm]
  apply sum_congr rfl
  intro p hp
  rw [mul_sum]
  apply sum_congr rfl
  intro r hr
  ring

end Erdos571.LayeredBush


/-! The exact separated cross-root tensor expression used by bilateral
moment interpolation. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures LayeredGramKernels
variable {U : Type*} [Fintype U] [DecidableEq U]

open Classical in
lemma cross_root_tensor_identity (N : Matrix U U ℝ) (s : ℕ) (j k : Fin s) (p : U×U×U×U) :
    (∑ r : Fin 2 → Fin s → U,
      (branch N s p.1 (r 0)*branch N s p.2.1 (r 0))*
        (branch N s p.2.2.1 (r 1)*branch N s p.2.2.2 (r 1))*
        (if r 0 j=r 1 k ∧ r 0 j ∉ hubSet p then 1 else 0)) =
      bilateralBase (N*N.transpose) p^(s-1)*crossRootWeight N p := by
  classical
  let f := fun w => N p.1 w*N p.2.1 w
  let g := fun w => N p.2.2.2 w*N p.2.2.1 w
  let P := fun w => w ∉ hubSet p
  have hroot : (∑ w, if P w then f w*g w else 0)=crossRootWeight N p := by
    apply sum_congr rfl
    intro w hw
    dsimp only [P,f,g,crossRootWeight,separatedRootProduct]
    by_cases hm : w ∈ hubSet p <;> simp only [hm, if_true, if_false, not_true_eq_false, not_false_eq_true] <;> ring
  have he := Fintype.sum_equiv (finTwoArrowEquiv (Fin s → U))
    (fun r : Fin 2 → Fin s → U =>
      (branch N s p.1 (r 0)*branch N s p.2.1 (r 0))*
        (branch N s p.2.2.1 (r 1)*branch N s p.2.2.2 (r 1))*
        (if r 0 j=r 1 k ∧ P (r 0 j) then 1 else 0))
    (fun q : (Fin s → U)×(Fin s → U) =>
      if q.1 j=q.2 k ∧ P (q.1 j) then (∏ i, f (q.1 i))*(∏ i, g (q.2 i)) else 0) (by
      intro r
      change (_*_)*(_*_)*(if r 0 j=r 1 k ∧ P (r 0 j) then 1 else 0)=_
      simp only [finTwoArrowEquiv, piFinTwoEquiv, Equiv.coe_fn_mk, branch, f, g, prod_mul_distrib]
      split_ifs <;> ring)
  rw [he, Fintype.sum_prod_type, TensorRootCollisions.cross_coordinate_identity f g P j k, hroot]
  simp only [f, g, bilateralBase, Matrix.mul_apply, Matrix.transpose_apply, Fintype.card_fin, mul_pow]
  ring

end Erdos571.GramPin


/-! Exact separated cross-bundle root-collision counts and their sharp
bilateral interpolation bound under global codegrees. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U : Type*} [Fintype U] [DecidableEq U]

lemma graph_bilateral_positive (G : SimpleGraph U) [DecidableRel G.Adj]
    (hp : ∃ u, 0 < G.degree u) :
    ∃ u, 0 < ((G.adjMatrix ℝ).transpose*G.adjMatrix ℝ) u u ∧
      0 < ((G.adjMatrix ℝ * G.adjMatrix ℝ)*
        (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose) u u := by
  obtain ⟨u,hu⟩ := hp
  have hdeg : (0:ℝ) < G.degree u := by exact_mod_cast hu
  let N := G.adjMatrix ℝ * G.adjMatrix ℝ
  have hN : 0 < N u u := by rw [show N u u=(G.degree u : ℝ) from G.adjMatrix_mul_self_apply_self u]; exact hdeg
  have hQ : (N u u)^2 ≤ (N*N.transpose) u u := by
    simpa only [Matrix.mul_apply, Matrix.transpose_apply, pow_two] using
      single_le_sum (fun v _ => sq_nonneg (N u v)) (mem_univ u)
  refine ⟨u,?_,(sq_pos_of_pos hN).trans_le hQ⟩
  simpa only [G.isSymm_adjMatrix.eq, SimpleGraph.adjMatrix_mul_self_apply_self] using hdeg

end Erdos571.GramPin

namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev CrossRootSeparated (s : ℕ) (j k : Fin s) :=
  RootEvent G s (fun r p => r 0 j=r 1 k ∧ r 0 j ∉ hubSet p)

open Classical in
/-- This cardinality includes all parent homomorphisms with the root event;
it does not require either parent to be injective. -/
theorem cross_root_separated_card (s : ℕ) (j k : Fin s) :
    (Fintype.card (CrossRootSeparated G s j k) : ℝ)=
      crossRootEnergy (G.adjMatrix ℝ) (G.adjMatrix ℝ * G.adjMatrix ℝ) s := by
  have h := rootEvent_card G s (fun r p => r 0 j=r 1 k ∧ r 0 j ∉ hubSet p)
  simp only [←Nat.card_eq_fintype_card] at h ⊢
  rw [h]
  unfold crossRootEnergy
  apply sum_congr rfl
  intro p hp
  rw [mul_assoc]
  congr 1
  convert cross_root_tensor_identity (G.adjMatrix ℝ * G.adjMatrix ℝ) s j k p using 1
  apply sum_congr rfl
  intro r hr
  split_ifs <;> rfl

open Classical in
/-- Natural-power control of the actual separated repeated-root event. -/
theorem cross_root_separated_bound (L D : ℝ) (hL : 0 ≤ L)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u ≠ v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (hp : ∃ u, 0 < G.degree u) (s : ℕ) (hs : 1 ≤ s) (j k : Fin s) :
    (Fintype.card (CrossRootSeparated G s j k) : ℝ)^(2*s) ≤
      (L^2)^(2*s)*(Fintype.card W : ℝ)^2*D^4*
        (Fintype.card (Agreement G [2,s]) : ℝ)^(2*s-1) := by
  let A := G.adjMatrix ℝ
  let N := A*A
  let Q := N*N.transpose
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hN := chain_nonneg hA hA
  have hsN : N.transpose=N := by
    dsimp only [N]
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  have h := crossRootEnergy_interpolation A N hA hN L hL hcodeg (graph_bilateral_positive G hp) s hs
  have hrow (u : W) : ∑ v, A u v ≤ D := by
    have he := G.adjMatrix_mulVec_const_apply (α := ℝ) (a := 1) (v := u)
    simp only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] at he
    exact he.le.trans (hdeg u)
  have hzero := bilateral_zero_upper A Q hA D hrow
  have hE : bilateralEnergy A Q s=(Fintype.card (Agreement G [2,s]) : ℝ) := by
    rw [bilateral_agreement_card]
    simp only [Q,hsN]
    rfl
  rw [cross_root_separated_card]
  calc
    _ ≤ (L^2)^(2*s)*bilateralEnergy A Q 0*bilateralEnergy A Q s^(2*s-1) := h
    _ ≤ (L^2)^(2*s)*((Fintype.card W : ℝ)^2*D^4)*bilateralEnergy A Q s^(2*s-1) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hzero (by positivity))
        (pow_nonneg (squareMass_nonneg _) _)
    _ = _ := by rw [hE]; ring

end Erdos571.LayeredBush


/-! A same-bundle repeated root saves a tensor coordinate, provided its value
is separated from the two relevant hub images. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U : Type*} [Fintype U] [DecidableEq U]

open Classical in
lemma same_root_tensor_bound (N : Matrix U U ℝ) (hN : ∀ u v, 0 ≤ N u v)
    (L : ℝ) (hL : 0 ≤ L) (hcap : ∀ u v, u≠v → N u v ≤ L)
    (s : ℕ) (j k : Fin s) (hjk : j≠k) (p : U×U×U×U) :
    (∑ r : Fin 2 → Fin s → U,
      (branch N s p.1 (r 0)*branch N s p.2.1 (r 0))*
        (branch N s p.2.2.1 (r 1)*branch N s p.2.2.2 (r 1))*
        (if r 0 j=r 0 k ∧ r 0 j ∉ hubSet p then 1 else 0)) ≤
      L^2*((N*N.transpose) p.1 p.2.1)^(s-1)*((N*N.transpose) p.2.2.2 p.2.2.1)^s := by
  classical
  let f := fun w => N p.1 w*N p.2.1 w
  let g := fun w => N p.2.2.2 w*N p.2.2.1 w
  let P := fun w => w ∉ hubSet p
  have hfg : 0 ≤ (∑ w, g w)^s := by
    apply pow_nonneg
    exact sum_nonneg (fun w _ => mul_nonneg (hN _ _) (hN _ _))
  have hrep := TensorRootCollisions.same_coordinate_bound f
    (fun w => mul_nonneg (hN _ _) (hN _ _)) j k hjk P (L^2) (sq_nonneg L) (by
      intro w hw
      have h₁ : p.1≠w := by intro he; apply hw; simp [hubSet,he]
      have h₂ : p.2.1≠w := by intro he; apply hw; simp [hubSet,he]
      simpa only [f,pow_two] using mul_le_mul (hcap _ _ h₁) (hcap _ _ h₂) (hN _ _) hL)
  have he := Fintype.sum_equiv (finTwoArrowEquiv (Fin s → U))
    (fun r : Fin 2 → Fin s → U =>
      (branch N s p.1 (r 0)*branch N s p.2.1 (r 0))*
        (branch N s p.2.2.1 (r 1)*branch N s p.2.2.2 (r 1))*
        (if r 0 j=r 0 k ∧ P (r 0 j) then 1 else 0))
    (fun q : (Fin s → U)×(Fin s → U) =>
      (if q.1 j=q.1 k ∧ P (q.1 j) then ∏ i, f (q.1 i) else 0)*(∏ i, g (q.2 i))) (by
      intro r
      simp only [finTwoArrowEquiv, piFinTwoEquiv, Equiv.coe_fn_mk, branch,f,g,prod_mul_distrib]
      split_ifs <;> ring)
  rw [he, Fintype.sum_prod_type]
  simp only [←mul_sum, ←sum_mul]
  have hgsum : (∑ y : Fin s → U, ∏ i, g (y i))=(∑ w, g w)^s := by
    rw [←Fintype.prod_sum]
    simp only [prod_const,card_univ,Fintype.card_fin]
  rw [hgsum]
  simpa only [f,g,Matrix.mul_apply,Matrix.transpose_apply,Fintype.card_fin] using
    mul_le_mul_of_nonneg_right hrep hfg

end Erdos571.GramPin


/-! Scalar four-hub formulas for mixed bilateral powers. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {U : Type*} [Fintype U]

lemma conjugationInner_comm (A K L : Matrix U U ℝ) :
    conjugationInner A K L=conjugationInner A L K := by
  simp only [conjugationInner,mul_comm]

lemma trace_mixed_entryPower_identity (M Q : Matrix U U ℝ) (a b : ℕ) :
    (M*entryPower Q a*M*(entryPower Q b).transpose).trace=
      ∑ p : U×U×U×U, M p.1 p.2.2.2*M p.2.2.1 p.2.1*(Q p.2.2.2 p.2.2.1)^a*(Q p.1 p.2.1)^b := by
  simp only [Fintype.sum_prod_type, Matrix.trace, Matrix.diag,
    Matrix.mul_apply, Matrix.transpose_apply, entryPower, sum_mul, mul_sum]
  apply sum_congr rfl
  intro i hi
  apply sum_congr rfl
  intro j hj
  apply sum_congr rfl
  intro k hk
  apply sum_congr rfl
  intro l hl
  ring

lemma conjugationInner_entryPower_moment (A Q : Matrix U U ℝ) (a b : ℕ) :
    conjugationInner A (entryPower Q a) (entryPower Q b)=
      ∑ p : U×U×U×U, bilateralWeight A p*(Q p.2.2.2 p.2.2.1)^a*(Q p.1 p.2.1)^b := by
  classical
  rw [conjugationInner_trace]
  exact trace_mixed_entryPower_identity (A.transpose*A) Q a b

end Erdos571.GramPin


/-! Actual within-bundle separated repeated-root counts, reduced to mixed
bilateral moments. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev SameRootSeparated (s : ℕ) (j k : Fin s) :=
  RootEvent G s (fun r p => r 0 j=r 0 k ∧ r 0 j ∉ hubSet p)

open Classical in
theorem same_root_separated_mixed_bound (L : ℝ) (hL : 0 ≤ L)
    (hcodeg : ∀ u v, u≠v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (s : ℕ) (j k : Fin s) (hjk : j≠k) :
    (Fintype.card (SameRootSeparated G s j k) : ℝ) ≤ L^2*
      conjugationInner (G.adjMatrix ℝ)
        (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ).transpose) (s-1))
        (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ).transpose) s) := by
  have hcard := rootEvent_card G s (fun r p => r 0 j=r 0 k ∧ r 0 j ∉ hubSet p)
  simp only [←Nat.card_eq_fintype_card] at hcard ⊢
  rw [hcard, conjugationInner_comm, conjugationInner_entryPower_moment, mul_sum]
  have hA (u v : W) : 0 ≤ G.adjMatrix ℝ u v := by
    dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  apply sum_le_sum
  intro p hp
  have ht := same_root_tensor_bound (G.adjMatrix ℝ * G.adjMatrix ℝ)
    (chain_nonneg hA hA) L hL hcodeg s j k hjk p
  have ht' : (∑ r : Labels W [2,s],
      (branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.1 (r 0)*
        branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.1 (r 0))*
      (branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.2.1 (r 1)*
        branch (G.adjMatrix ℝ * G.adjMatrix ℝ) s p.2.2.2 (r 1))*
      (if r 0 j=r 0 k ∧ r 0 j ∉ hubSet p then 1 else 0)) ≤
      L^2*((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ).transpose) p.1 p.2.1^(s-1)*
        ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ).transpose) p.2.2.2 p.2.2.1^s := by
    convert ht using 1
  have hh := mul_le_mul_of_nonneg_left ht' (bilateralWeight_nonneg (G.adjMatrix ℝ) hA p)
  convert hh using 1
  · congr 1
    apply sum_congr rfl
    intro r hr
    split_ifs <;> rfl
  · ring

open Classical in
theorem same_root_separated_bound (L D : ℝ) (hL : 0 ≤ L)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u≠v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (hp : ∃ u, 0 < G.degree u) (s : ℕ) (hs : 1 ≤ s) (j k : Fin s) (hjk : j≠k) :
    (Fintype.card (SameRootSeparated G s j k) : ℝ)^(2*s) ≤
      (L^2)^(2*s)*(Fintype.card W : ℝ)^2*D^4*
        (Fintype.card (Agreement G [2,s]) : ℝ)^(2*s-1) := by
  let A := G.adjMatrix ℝ
  let N := A*A
  let Q := N*N.transpose
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hN := chain_nonneg hA hA
  have hQ := chain_nonneg hN (fun u v => hN v u)
  have hsN : N.transpose=N := by
    dsimp only [N]
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  have h := bilateral_mixed_interpolation A Q hA hQ (graph_bilateral_positive G hp) s hs
  have hrow (u : W) : ∑ v, A u v ≤ D := by
    have he := G.adjMatrix_mulVec_const_apply (α := ℝ) (a := 1) (v := u)
    simp only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] at he
    exact he.le.trans (hdeg u)
  have hzero := bilateral_zero_upper A Q hA D hrow
  have hE : bilateralEnergy A Q s=(Fintype.card (Agreement G [2,s]) : ℝ) := by
    rw [bilateral_agreement_card]
    simp only [Q,hsN]
    rfl
  have hc := same_root_separated_mixed_bound G L hL hcodeg s j k hjk
  calc
    _ ≤ (L^2*conjugationInner A (entryPower Q (s-1)) (entryPower Q s))^(2*s) :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) hc _
    _ = (L^2)^(2*s)*conjugationInner A (entryPower Q (s-1)) (entryPower Q s)^(2*s) := mul_pow _ _ _
    _ ≤ (L^2)^(2*s)*(bilateralEnergy A Q 0*bilateralEnergy A Q s^(2*s-1)) :=
      mul_le_mul_of_nonneg_left h (by positivity)
    _ ≤ (L^2)^(2*s)*(((Fintype.card W : ℝ)^2*D^4)*bilateralEnergy A Q s^(2*s-1)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hzero (pow_nonneg (squareMass_nonneg _) _)) (by positivity)
    _ = _ := by rw [hE]; ring

end Erdos571.LayeredBush


/-! Simple finite-event unions and nested restrictions on root-agreeing pairs. -/
namespace Erdos571.FiniteEventUnion
open Finset
variable {X I : Type*} [Fintype X] [Fintype I]

open Classical in
theorem card_le_sum (P : X → Prop) (Q : I → X → Prop)
    (hcover : ∀ x, P x → ∃ i, Q i x) :
    Fintype.card {x : X // P x} ≤ ∑ i, Fintype.card {x : X // Q i x} := by
  classical
  let f : {x : X // P x} → ((i : I) × {x : X // Q i x}) := fun x =>
    ⟨(hcover x.1 x.2).choose,x.1,(hcover x.1 x.2).choose_spec⟩
  have hi : Function.Injective f := by
    intro x y he
    apply Subtype.ext
    exact congrArg (fun p : (i : I) × {x : X // Q i x} => p.2.1) he
  simpa only [Fintype.card_sigma] using Fintype.card_le_of_injective f hi

open Classical in
theorem card_split_bound (P Q : X → Prop) :
    Fintype.card {x : X // P x} ≤
      Fintype.card {x : X // P x ∧ ¬Q x}+Fintype.card {x : X // Q x} := by
  classical
  let C : Bool → X → Prop := fun b x => if b then P x ∧ ¬Q x else Q x
  have h := card_le_sum P C (by
    intro x hp
    by_cases hq : Q x
    · exact ⟨false,hq⟩
    · exact ⟨true,hp,hq⟩)
  simpa only [C,Fintype.sum_bool,Bool.false_eq_true,if_false,if_true,Nat.add_comm] using h

end Erdos571.FiniteEventUnion

namespace Erdos571.FiberRestrictionEnergy
variable {R : Type*} (F : R → Type*)

abbrev LeftEvent (P : Sigma F → Prop) := {e : Agreement F // P e.1.1}
abbrev RightEvent (P : Sigma F → Prop) := {e : Agreement F // P e.1.2}

def leftEventEquiv (P : Sigma F → Prop) : LeftEvent F P ≃ Left F P where
  toFun p := ⟨p.1.1,p.1.2,p.2⟩
  invFun p := ⟨⟨p.1,p.2.1⟩,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def rightEventEquiv (P : Sigma F → Prop) : RightEvent F P ≃ Left F P where
  toFun p := ⟨(p.1.1.2,p.1.1.1),p.1.2.symm,p.2⟩
  invFun p := ⟨⟨(p.1.2,p.1.1),p.2.1.symm⟩,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

end Erdos571.FiberRestrictionEnergy


/-! Root-equals-hub events are covered by one-copy interior/root equalities.
They are deliberately kept separate from the separated-root tensor bounds. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev RootNearHubs (s : ℕ) (r : Leaves [2,s]) :=
  {e : Agreement G [2,s] // hom G [2,s] e.1.1 (.inr r) ∈ hubSet (fullHubQuad G s e.1.1 e.1.2)}

def hubRole (s : ℕ) (i : Fin 2) : Interior [2,s] := some (i,anchor [s])

lemma hub0_value (s : ℕ) (p : Full G [2,s]) :
    (fullHubs G s p).1=hom G [2,s] p (.inl (hubRole s 0)) := rfl

lemma hub1_value (s : ℕ) (p : Full G [2,s]) :
    (fullHubs G s p).2=hom G [2,s] p (.inl (hubRole s 1)) := rfl

open Classical in
theorem root_near_hubs_bound (s : ℕ) (r : Leaves [2,s]) :
    Fintype.card (RootNearHubs G s r) ≤
      2*∑ i : Fin 2, Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr r)) := by
  classical
  let P : (Fin 2⊕Fin 2) → Agreement G [2,s] → Prop := Sum.elim
    (fun i e => hom G [2,s] e.1.1 (.inl (hubRole s i))=hom G [2,s] e.1.1 (.inr r))
    (fun i e => hom G [2,s] e.1.2 (.inl (hubRole s i))=hom G [2,s] e.1.2 (.inr r))
  have hcover (e : Agreement G [2,s])
      (he : hom G [2,s] e.1.1 (.inr r) ∈ hubSet (fullHubQuad G s e.1.1 e.1.2)) :
      ∃ i : Fin 2⊕Fin 2, P i e := by
    have hr : hom G [2,s] e.1.1 (.inr r)=hom G [2,s] e.1.2 (.inr r) :=
      congrArg (fun t => leafValue [2,s] t r) e.2
    simp only [fullHubQuad,hubIndexEquiv,Equiv.coe_fn_mk,hubSet,
      mem_insert,mem_singleton,hub0_value,hub1_value] at he
    rcases he with h|h|h|h
    · exact ⟨.inl 0,h.symm⟩
    · exact ⟨.inr 0,h.symm.trans hr⟩
    · exact ⟨.inr 1,h.symm.trans hr⟩
    · exact ⟨.inl 1,h.symm⟩
  have h := FiniteEventUnion.card_le_sum
    (fun e : Agreement G [2,s] => hom G [2,s] e.1.1 (.inr r) ∈ hubSet (fullHubQuad G s e.1.1 e.1.2)) P hcover
  have hl (i : Fin 2) : Fintype.card {e : Agreement G [2,s] // P (.inl i) e}=
      Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr r)) := by
    simpa only [←Nat.card_eq_fintype_card] using Nat.card_congr
      (FiberRestrictionEnergy.leftEventEquiv (Fiber G [2,s])
        (fun p => hom G [2,s] p (.inl (hubRole s i))=hom G [2,s] p (.inr r)))
  have hr (i : Fin 2) : Fintype.card {e : Agreement G [2,s] // P (.inr i) e}=
      Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr r)) := by
    simpa only [←Nat.card_eq_fintype_card] using Nat.card_congr
      (FiberRestrictionEnergy.rightEventEquiv (Fiber G [2,s])
        (fun p => hom G [2,s] p (.inl (hubRole s i))=hom G [2,s] p (.inr r)))
  simp only [Fintype.sum_sum_type,hl,hr,←two_mul] at h
  simpa only [←Nat.card_eq_fintype_card] using h

end Erdos571.LayeredBush


/-! Separating repeated roots from all four hubs. These finite inequalities
restore the root-equals-hub cases omitted by the tensor estimates. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

def rootEqualBothEventEquiv (l : List ℕ) (r t : Leaves l) :
    EqualBoth G l (.inr r) (.inr t) ≃
      {e : Agreement G l // hom G l e.1.1 (.inr r)=hom G l e.1.1 (.inr t)} where
  toFun p := ⟨⟨p.1,p.2.1⟩,p.2.2.1⟩
  invFun p := ⟨p.1.1,p.1.2,p.2,by
    have hr : hom G l p.1.1.1 (.inr r)=hom G l p.1.1.2 (.inr r) :=
      congrArg (fun v => leafValue l v r) p.1.2
    have ht : hom G l p.1.1.1 (.inr t)=hom G l p.1.1.2 (.inr t) :=
      congrArg (fun v => leafValue l v t) p.1.2
    exact hr.symm.trans (p.2.trans ht)⟩
  left_inv _ := rfl
  right_inv _ := rfl

open Classical in
theorem cross_root_partition_bound (s : ℕ) (j k : Fin s) :
    Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (1,k,()))) ≤
      Fintype.card (CrossRootSeparated G s j k) +
        2*∑ i : Fin 2, Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr (0,j,()))) := by
  classical
  have h := FiniteEventUnion.card_split_bound
    (fun e : Agreement G [2,s] => hom G [2,s] e.1.1 (.inr (0,j,()))=
      hom G [2,s] e.1.1 (.inr (1,k,())))
    (fun e : Agreement G [2,s] => hom G [2,s] e.1.1 (.inr (0,j,())) ∈
      hubSet (fullHubQuad G s e.1.1 e.1.2))
  have h₀ := Nat.card_congr (rootEqualBothEventEquiv G [2,s] (0,j,()) (1,k,()))
  have hn := root_near_hubs_bound G s (0,j,())
  simp only [←Nat.card_eq_fintype_card] at h h₀ hn ⊢
  rw [←h₀] at h
  exact h.trans (Nat.add_le_add_left hn _)

open Classical in
theorem same_root_partition_bound (s : ℕ) (j k : Fin s) :
    Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (0,k,()))) ≤
      Fintype.card (SameRootSeparated G s j k) +
        2*∑ i : Fin 2, Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr (0,j,()))) := by
  classical
  have h := FiniteEventUnion.card_split_bound
    (fun e : Agreement G [2,s] => hom G [2,s] e.1.1 (.inr (0,j,()))=
      hom G [2,s] e.1.1 (.inr (0,k,())))
    (fun e : Agreement G [2,s] => hom G [2,s] e.1.1 (.inr (0,j,())) ∈
      hubSet (fullHubQuad G s e.1.1 e.1.2))
  have h₀ := Nat.card_congr (rootEqualBothEventEquiv G [2,s] (0,j,()) (0,k,()))
  have hn := root_near_hubs_bound G s (0,j,())
  simp only [←Nat.card_eq_fintype_card] at h h₀ hn ⊢
  rw [←h₀] at h
  exact h.trans (Nat.add_le_add_left hn _)

end Erdos571.LayeredBush


/-! Permuting the two top branches preserves all ordinary rootless layered
homomorphisms and their equality counts. -/
namespace Erdos571.LayeredBush
open SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

def permuteFull (s : ℕ) (σ : Equiv.Perm (Fin 2)) (p : Full G [2,s]) : Full G [2,s] :=
  ⟨fun i => p.1 (σ i),p.2.1,fun i => p.2.2 (σ i)⟩

def branchVertexPerm (s : ℕ) (σ : Equiv.Perm (Fin 2)) :
    (Interior [2,s]⊕Leaves [2,s]) → (Interior [2,s]⊕Leaves [2,s])
  | .inl none => .inl none
  | .inl (some (i,a)) => .inl (some (σ i,a))
  | .inr (i,r) => .inr (σ i,r)

lemma hom_permuteFull (s : ℕ) (σ : Equiv.Perm (Fin 2)) (p : Full G [2,s])
    (v : Interior [2,s]⊕Leaves [2,s]) :
    hom G [2,s] (permuteFull G s σ p) v=hom G [2,s] p (branchVertexPerm s σ v) := by
  cases v with
  | inl a => cases a <;> rfl
  | inr r => rfl

def permuteFullEquiv (s : ℕ) (σ : Equiv.Perm (Fin 2)) : Full G [2,s] ≃ Full G [2,s] where
  toFun := permuteFull G s σ
  invFun := permuteFull G s σ.symm
  left_inv p := by
    apply hom_injective G [2,s]
    ext v
    simp only [hom_permuteFull]
    cases v with
    | inl a => cases a with
      | none => rfl
      | some a => simp only [branchVertexPerm,Equiv.apply_symm_apply]
    | inr r =>
      rcases r with ⟨i,r⟩
      simp only [branchVertexPerm,Equiv.apply_symm_apply]
  right_inv p := by
    apply hom_injective G [2,s]
    ext v
    simp only [hom_permuteFull]
    cases v with
    | inl a => cases a with
      | none => rfl
      | some a => simp only [branchVertexPerm,Equiv.symm_apply_apply]
    | inr r =>
      rcases r with ⟨i,r⟩
      simp only [branchVertexPerm,Equiv.symm_apply_apply]

lemma permute_labels_eq_iff (s : ℕ) (σ : Equiv.Perm (Fin 2)) (p q : Full G [2,s]) :
    (permuteFull G s σ p).1=(permuteFull G s σ q).1 ↔ p.1=q.1 := by
  constructor
  · intro h
    funext i
    simpa only [permuteFull,Equiv.apply_symm_apply] using congrFun h (σ.symm i)
  · intro h
    exact congrArg (fun r => fun i => r (σ i)) h

def equalBothBranchPermEquiv (s : ℕ) (σ : Equiv.Perm (Fin 2))
    (u v : Interior [2,s]⊕Leaves [2,s]) :
    EqualBoth G [2,s] (branchVertexPerm s σ u) (branchVertexPerm s σ v) ≃
      EqualBoth G [2,s] u v :=
  (Equiv.prodCongr (permuteFullEquiv G s σ) (permuteFullEquiv G s σ)).subtypeEquiv (by
    intro p
    change (p.1.1=p.2.1 ∧ hom G [2,s] p.1 (branchVertexPerm s σ u)=hom G [2,s] p.1 (branchVertexPerm s σ v) ∧
      hom G [2,s] p.2 (branchVertexPerm s σ u)=hom G [2,s] p.2 (branchVertexPerm s σ v)) ↔
      ((permuteFull G s σ p.1).1=(permuteFull G s σ p.2).1 ∧
        hom G [2,s] (permuteFull G s σ p.1) u=hom G [2,s] (permuteFull G s σ p.1) v ∧
        hom G [2,s] (permuteFull G s σ p.2) u=hom G [2,s] (permuteFull G s σ p.2) v)
    rw [permute_labels_eq_iff]
    simp only [hom_permuteFull])

def equalBothSymmEquiv (l : List ℕ) (u v : Interior l⊕Leaves l) :
    EqualBoth G l u v ≃ EqualBoth G l v u where
  toFun p := ⟨p.1,p.2.1,p.2.2.1.symm,p.2.2.2.symm⟩
  invFun p := ⟨p.1,p.2.1,p.2.2.1.symm,p.2.2.2.symm⟩
  left_inv _ := rfl
  right_inv _ := rfl

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]
open Classical in
lemma root_bundle_swap_card (s : ℕ) (j k : Fin s) :
    Fintype.card (EqualBoth G [2,s] (.inr (1,j,())) (.inr (1,k,())))=
      Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (0,k,()))) := by
  have h := Nat.card_congr (equalBothBranchPermEquiv G s (Equiv.swap 0 1)
    (.inr (0,j,())) (.inr (0,k,())))
  simpa only [branchVertexPerm,Equiv.swap_apply_left,←Nat.card_eq_fintype_card] using h

end Erdos571.LayeredBush


/-! Within-copy equality with the central anchor, counted by a diagonally
marked assignment feature. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredAssignments LayeredGramKernels GramFeatures
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

abbrev AnchorEqualFiber (l : List ℕ) (a : Interior l) (r : Labels W l) :=
  {p : Fiber G l r // p.1=interiorValue G l p.2 a}

def anchorEqualFiberEquiv (l : List ℕ) (a : Interior l) (r : Labels W l) :
    AnchorEqualFiber G l a r ≃ ((x : W) × {p : Assignment G l x r // interiorValue G l p a=x}) where
  toFun p := ⟨p.1.1,p.1.2,p.2.symm⟩
  invFun p := ⟨⟨p.1,p.2.1⟩,p.2.2.symm⟩
  left_inv _ := rfl
  right_inv _ := rfl

open Classical in
lemma anchorEqualFiber_card (l : List ℕ) (a : Interior l) (r : Labels W l) :
    (Fintype.card (AnchorEqualFiber G l a r) : ℝ)=
      ∑ x, pinFeature (G.adjMatrix ℝ) l a x (r,x) := by
  rw [Fintype.card_congr (anchorEqualFiberEquiv G l a r)]
  simp only [Fintype.card_sigma,Nat.cast_sum,card_pinAssignment]

open Classical in
theorem anchor_equality_card (l : List ℕ) (a : Interior l) :
    (Fintype.card (EqualBoth G l (.inl (anchor l)) (.inl a)) : ℝ)=
      ∑ r, (∑ x, pinFeature (G.adjMatrix ℝ) l a x (r,x))^2 := by
  rw [Fintype.card_congr (FiberRestrictionEnergy.bothEquiv (Fiber G l)
    (fun p => hom G l p (.inl (anchor l))=hom G l p (.inl a)))]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul]
  have hc (r : Labels W l) :
      (Fintype.card (FiberRestrictionEnergy.Restricted (Fiber G l)
        (fun p => hom G l p (.inl (anchor l))=hom G l p (.inl a)) r) : ℝ)=
        ∑ x, pinFeature (G.adjMatrix ℝ) l a x (r,x) := by
    have he : FiberRestrictionEnergy.Restricted (Fiber G l)
        (fun p => hom G l p (.inl (anchor l))=hom G l p (.inl a)) r ≃ AnchorEqualFiber G l a r :=
      Equiv.subtypeEquivRight (fun p => by simp only [hom_anchor]; rfl)
    rw [Fintype.card_congr he,anchorEqualFiber_card]
  simp only [hc,pow_two]

end Erdos571.LayeredBush


/-! Cross inner products of marked branch features with separately prescribed
mark values. -/
namespace Erdos571.GramFeatures
open Finset Matrix
variable {U I V : Type*} [Fintype U] [Fintype I]

lemma markBranch_cross (F : Matrix U I ℝ) (P : Matrix U (I×V) ℝ)
    (s : ℕ) (i : Fin s) (x y : U) (w z : V) :
    (∑ r, markBranch F P s i x (r,w)*markBranch F P s i y (r,z))=
      (∑ r, P x (r,w)*P y (r,z))*(kernel F x y)^(s-1) := by
  classical
  simp only [markBranch,←prod_mul_distrib]
  rw [←Fintype.prod_sum (fun j : Fin s => fun r : I =>
    (if j=i then P x (r,w) else F x r)*(if j=i then P y (r,z) else F y r))]
  calc
    _ = ∏ j : Fin s, if j=i then (∑ r, P x (r,w)*P y (r,z)) else kernel F x y := by
      apply prod_congr rfl
      intro j hj
      by_cases he : j=i
      · simp only [if_pos he]
      · simp only [if_neg he,kernel,Matrix.mul_apply,Matrix.transpose_apply]
    _ = _ := prod_one_mark s i _ _

lemma chain_rootMark (A : Matrix U U ℝ) (u r z : U) :
    (A*rootMark A) u (r,z)=A u z*A z r := by
  classical
  simp only [Matrix.mul_apply,rootMark,mul_ite,mul_zero]
  simp

end Erdos571.GramFeatures


/-! The exact kernel for identifying the central middle with one terminal
middle inside each parent. -/
namespace Erdos571.GramPin
open Finset Matrix GramFeatures LayeredGramKernels
variable {U R : Type*} [Fintype U] [Fintype R]

lemma conjugation_entry (A K : Matrix U U ℝ) (x y : U) :
    (A*K*A.transpose) x y=∑ u, ∑ v, A x u*K u v*A y v := by
  rw [Matrix.mul_assoc]
  simp only [Matrix.mul_apply,Matrix.transpose_apply,mul_sum,mul_assoc]

lemma cross_chain (A : Matrix U U ℝ) (F H : Matrix U R ℝ) :
    (A*F)*(A*H).transpose=A*(F*H.transpose)*A.transpose := by
  simp only [Matrix.transpose_mul,Matrix.mul_assoc]

noncomputable def collapsedChild (A : Matrix U U ℝ) (s : ℕ) (j : Fin s) : Matrix U (Fin s → U) ℝ :=
  fun x X => (A*pinFeature A [s] (some (j,()))) x (X,x)

lemma terminal_child_cross (A : Matrix U U ℝ) (s : ℕ) (j : Fin s) (u v x y : U) :
    (∑ X, pinFeature A [s] (some (j,())) u (X,x)*pinFeature A [s] (some (j,())) v (X,y))=
      A u x*A v y*(A*A.transpose) x y*(kernel (A*A) u v)^(s-1) := by
  change (∑ X, markBranch (A*A) (A*rootMark A) s j u (X,x)*
    markBranch (A*A) (A*rootMark A) s j v (X,y))=_
  rw [markBranch_cross]
  simp_rw [chain_rootMark]
  have he : (∑ r, (A u x*A x r)*(A v y*A y r))=A u x*A v y*(A*A.transpose) x y := by
    simp only [Matrix.mul_apply,Matrix.transpose_apply,mul_sum]
    apply sum_congr rfl
    intro r hr
    ring
  rw [he]

lemma collapsedChild_kernel (A : Matrix U U ℝ)
    (hId : ∀ u v, A u v*A v u=A u v) (s : ℕ) (j : Fin s) (x y : U) :
    kernel (collapsedChild A s j) x y=(A*A.transpose) x y*
      (A*entryPower ((A*A)*(A*A).transpose) (s-1)*A.transpose) x y := by
  let P : Matrix U (Fin s → U) ℝ := fun u X => pinFeature A [s] (some (j,())) u (X,x)
  let H : Matrix U (Fin s → U) ℝ := fun v X => pinFeature A [s] (some (j,())) v (X,y)
  have hcross : kernel (collapsedChild A s j) x y=(A*(P*H.transpose)*A.transpose) x y := by
    rw [←cross_chain]
    rfl
  rw [hcross,conjugation_entry,conjugation_entry,mul_sum]
  apply sum_congr rfl
  intro u hu
  rw [mul_sum]
  apply sum_congr rfl
  intro v hv
  have he : (P*H.transpose) u v=A u x*A v y*(A*A.transpose) x y*(kernel (A*A) u v)^(s-1) :=
    terminal_child_cross A s j u v x y
  rw [he]
  change A x u*(A u x*A v y*(A*A.transpose) x y*(kernel (A*A) u v)^(s-1))*A y v=
    (A*A.transpose) x y*(A x u*(kernel (A*A) u v)^(s-1)*A y v)
  calc
    _ = (A x u*A u x)*(A y v*A v y)*(A*A.transpose) x y*(kernel (A*A) u v)^(s-1) := by ring
    _ = _ := by rw [hId x u,hId y v]; ring

lemma terminal_anchor_feature (A : Matrix U U ℝ) (s : ℕ) (j : Fin s) (x : U)
    (r : Labels U [2,s]) :
    pinFeature A [2,s] (some (0,some (j,()))) x (r,x)=
      collapsedChild A s j x (r 0)*(A*branch (A*A) s) x (r 1) := by
  change markBranch (A*branch (A*A) s) (A*pinFeature A [s] (some (j,()))) 2 0 x (r,x)=_
  simp only [markBranch,Fin.prod_univ_two,Fin.isValue,eq_self_iff_true,if_true]
  norm_num only [Fin.reduceEq,if_false]
  rfl

lemma binary_mixed_kernel (P B : Matrix U R ℝ) (x y : U) :
    (∑ r : Fin 2 → R, (P x (r 0)*B x (r 1))*(P y (r 0)*B y (r 1)))=
      kernel P x y*kernel B x y := by
  have h := Fintype.sum_equiv (finTwoArrowEquiv R)
    (fun r : Fin 2 → R => (P x (r 0)*B x (r 1))*(P y (r 0)*B y (r 1)))
    (fun p : R×R => (P x p.1*B x p.2)*(P y p.1*B y p.2)) (fun r => rfl)
  rw [h]
  simp only [Fintype.sum_prod_type,kernel,Matrix.mul_apply,Matrix.transpose_apply,sum_mul_sum]
  apply sum_congr rfl
  intro r hr
  apply sum_congr rfl
  intro t ht
  ring

lemma terminal_anchor_kernel (A : Matrix U U ℝ) (hA : A.IsSymm)
    (hId : ∀ u v, A u v*A v u=A u v) (s : ℕ) (j : Fin s) (x y : U) :
    kernel (fun x r => pinFeature A [2,s] (some (0,some (j,()))) x (r,x)) x y=
      (A*A) x y*(A*entryPower ((A*A)*(A*A)) (s-1)*A) x y*
        (A*entryPower ((A*A)*(A*A)) s*A) x y := by
  have hsN : (A*A).transpose=A*A := by rw [Matrix.transpose_mul,hA]
  have hK : kernel (branch (A*A) s)=entryPower ((A*A)*(A*A)) s := by
    ext u v
    simpa only [entryPower,kernel,hsN] using kernel_branch (A*A) s u v
  change (∑ r, pinFeature A [2,s] (some (0,some (j,()))) x (r,x)*
    pinFeature A [2,s] (some (0,some (j,()))) y (r,y))=_
  simp only [terminal_anchor_feature]
  have h := binary_mixed_kernel (collapsedChild A s j) (A*branch (A*A) s) x y
  rw [collapsedChild_kernel A hId,kernel_chain,hK,hA,hsN] at h
  exact h

end Erdos571.GramPin


/-! The last central/terminal within-copy collision identity and its actual
finite-count bound under global codegrees. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredAssignments LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem central_terminal_equality_card (s : ℕ) (j : Fin s) :
    (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (0,some (j,()))))) : ℝ)=
      ∑ x, ∑ y, (G.adjMatrix ℝ * G.adjMatrix ℝ) x y *
        (G.adjMatrix ℝ * entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) (s-1)*G.adjMatrix ℝ) x y *
        (G.adjMatrix ℝ * entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s*G.adjMatrix ℝ) x y := by
  have hId (u v : W) : G.adjMatrix ℝ u v*G.adjMatrix ℝ v u=G.adjMatrix ℝ u v := by
    rw [G.isSymm_adjMatrix.apply v u]
    by_cases ha : G.Adj u v <;> simp only [SimpleGraph.adjMatrix_apply,ha,if_true,if_false] <;> norm_num
  rw [anchor_equality_card]
  let P := fun x r => pinFeature (G.adjMatrix ℝ) [2,s] (some (0,some (j,()))) x (r,x)
  calc
    _ = ∑ x, ∑ y, kernel P x y := (kernel_total P).symm
    _ = _ := sum_congr rfl (fun x _ => sum_congr rfl (fun y _ =>
      terminal_anchor_kernel (G.adjMatrix ℝ) G.isSymm_adjMatrix hId s j x y))

open Classical in
lemma center_pin_diagonal_mass (s : ℕ) :
    (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ)=
      diagonalMass (G.adjMatrix ℝ * entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s*G.adjMatrix ℝ) := by
  let A := G.adjMatrix ℝ
  let F := branch (A*A) s
  have hK : kernel F=entryPower ((A*A)*(A*A)) s := short_branchKernel A G.isSymm_adjMatrix s
  have hB : kernel (A*F)=A*entryPower ((A*A)*(A*A)) s*A := by
    rw [kernel_chain,hK,G.isSymm_adjMatrix]
  rw [bilateral_center_pin_card]
  unfold diagonalMass
  apply sum_congr rfl
  intro x hx
  congr 1
  change (∑ r, ((A*F) x r)^2)=(A*entryPower ((A*A)*(A*A)) s*A) x x
  rw [←hB]
  simp only [kernel,Matrix.mul_apply,Matrix.transpose_apply,pow_two]

open Classical in
theorem central_terminal_equality_bound_global (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ u v, u≠v → (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L)
    (s : ℕ) (j : Fin s) :
    (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (0,some (j,()))))) : ℝ)^2 ≤
      2*L^2*(Fintype.card (Agreement G [2,s-1]) : ℝ)*(Fintype.card (Agreement G [2,s]) : ℝ) +
      2*D^2*(Fintype.card (Agreement G [2,s-1]) : ℝ)*(Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let B := A*entryPower Q (s-1)*A
  let C := A*entryPower Q s*A
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hM := chain_nonneg hA hA
  have hQ := chain_nonneg hM hM
  have hB (u v : W) : 0 ≤ B u v :=
    chain_nonneg (chain_nonneg hA (fun u v => pow_nonneg (hQ u v) (s-1))) hA u v
  have hC (u v : W) : 0 ≤ C u v :=
    chain_nonneg (chain_nonneg hA (fun u v => pow_nonneg (hQ u v) s)) hA u v
  have h := graph_middle_identification_bound G L D hL hD hdeg hcodeg B C hB hC
  rw [central_terminal_equality_card,bilateral_agreement_card,bilateral_agreement_card,center_pin_diagonal_mass]
  simpa only [bilateralEnergy,G.isSymm_adjMatrix.eq] using h

end Erdos571.LayeredBush


/-! A finite quantitative certificate converting uniformly small equality
and pin energies into an ordinary rooted-power copy. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem not_free_of_uniform_energies (l : List ℕ) (M : ℕ) (hM : 2 ≤ M)
    (ε : ℝ) (hε : 0 ≤ ε)
    (hsmall : (M-1:ℕ)*(2*(Fintype.card (DistinctRoles l) : ℝ)+(nonroots l : ℝ)^2)*ε < 1)
    (hpos : 0 < (Fintype.card (Agreement G l) : ℝ))
    (heq : ∀ p : DistinctRoles l, (Fintype.card (EqualBoth G l p.1.1 p.1.2) : ℝ) ≤
      ε^2*(Fintype.card (Agreement G l) : ℝ))
    (hpin : ∀ a : Interior l, (Fintype.card (Pinned G l a) : ℝ) ≤
      ε*(Fintype.card (Agreement G l) : ℝ)) :
    ¬(FullRootedPower.graph (graph l) M).Free G := by
  classical
  intro hf
  let E : ℝ := Fintype.card (Agreement G l)
  let N : ℝ := Fintype.card (DistinctRoles l)
  let m : ℝ := nonroots l
  have hE : 0 ≤ E := hpos.le
  have hN : 0 ≤ N := Nat.cast_nonneg _
  have hm : 0 ≤ m := Nat.cast_nonneg _
  have hsum : (∑ p : DistinctRoles l, (Fintype.card (EqualBoth G l p.1.1 p.1.2) : ℝ)) ≤ N*ε^2*E := by
    calc
      _ ≤ ∑ _p : DistinctRoles l, ε^2*E := sum_le_sum (fun p _ => heq p)
      _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul,N]; ring
  have hb := bad_left_equalities_bound G l
  have hb' : (Fintype.card (BadLeft G l) : ℝ)^2 ≤ (N*ε*E)^2 := by
    calc
      _ ≤ N*E*∑ p : DistinctRoles l, (Fintype.card (EqualBoth G l p.1.1 p.1.2) : ℝ) := hb
      _ ≤ N*E*(N*ε^2*E) := mul_le_mul_of_nonneg_left hsum (mul_nonneg hN hE)
      _ = _ := by ring
  have hbsmall : (Fintype.card (BadLeft G l) : ℝ) ≤ N*ε*E := by
    have hn : 0 ≤ N*ε*E := by positivity
    nlinarith
  have hpsum : (∑ a : Interior l, (Fintype.card (Pinned G l a) : ℝ)) ≤ m*ε*E := by
    calc
      _ ≤ ∑ _a : Interior l, ε*E := sum_le_sum (fun a _ => hpin a)
      _ = _ := by simp only [sum_const,card_univ,card_interior,nsmul_eq_mul,m]; ring
  have hu := agreement_le_bad_pins G l M hM hf
  have hfinal : E ≤ (M-1:ℕ)*(2*N+m^2)*ε*E := by
    calc
      _ ≤ (M-1:ℕ)*(2*Fintype.card (BadLeft G l)+m*∑ a : Interior l, (Fintype.card (Pinned G l a) : ℝ)) := hu
      _ ≤ (M-1:ℕ)*(2*(N*ε*E)+m*(m*ε*E)) :=
        mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left hbsmall (by norm_num))
            (mul_le_mul_of_nonneg_left hpsum hm)) (Nat.cast_nonneg _)
      _ = _ := by ring
  have hh : (M-1:ℕ)*(2*N+m^2)*ε*E < E := by
    simpa only [one_mul] using mul_lt_mul_of_pos_right hsmall hpos
  exact (not_lt_of_ge hfinal) hh

end Erdos571.LayeredBush


/-! A hub cannot coincide with any middle vertex in a bipartite host. For
these role pairs, a path of length at most three suffices. -/
namespace Erdos571.LayeredBush
open SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels
variable {W : Type} (G : SimpleGraph W)

lemma no_triangle_of_bipartite (hb : G.IsBipartite) (u v w : W)
    (huv : G.Adj u v) (hvw : G.Adj v w) (hwu : G.Adj w u) : False := by
  obtain ⟨c⟩ := hb
  have h₁ := c.valid huv
  have h₂ := c.valid hvw
  have h₃ := c.valid hwu
  omega

lemma hom_center_adj_hub (s : ℕ) (f : graph [2,s] →g G) (i : Fin 2) :
    G.Adj (f (.inl (anchor [2,s]))) (f (.inl (some (i,anchor [s])))) := by
  apply f.map_rel
  change anchor [s]=anchor [s]
  rfl

lemma hom_hub_adj_terminal (s : ℕ) (f : graph [2,s] →g G) (i : Fin 2) (j : Fin s) :
    G.Adj (f (.inl (some (i,anchor [s])))) (f (.inl (some (i,some (j,()))))) := by
  apply f.map_rel
  change i=i ∧ ()=anchor []
  exact ⟨rfl,rfl⟩

lemma hom_hub_ne_center (s : ℕ) (f : graph [2,s] →g G) (i : Fin 2) :
    f (.inl (some (i,anchor [s]))) ≠ f (.inl (anchor [2,s])) :=
  (hom_center_adj_hub G s f i).ne.symm

lemma hom_hub_ne_terminal (hb : G.IsBipartite) (s : ℕ) (f : graph [2,s] →g G)
    (i k : Fin 2) (j : Fin s) :
    f (.inl (some (i,anchor [s]))) ≠ f (.inl (some (k,some (j,())))) := by
  intro he
  apply no_triangle_of_bipartite G hb (f (.inl (anchor [2,s])))
    (f (.inl (some (k,anchor [s])))) (f (.inl (some (k,some (j,())))))
    (hom_center_adj_hub G s f k) (hom_hub_adj_terminal G s f k j)
  rw [←he]
  exact (hom_center_adj_hub G s f i).symm

variable [Fintype W] [DecidableEq W] [DecidableRel G.Adj]
open Classical in
lemma equalBoth_card_zero_of_ne (l : List ℕ) (u v : Interior l⊕Leaves l)
    (hne : ∀ p : Full G l, hom G l p u ≠ hom G l p v) :
    Fintype.card (EqualBoth G l u v)=0 := by
  haveI : IsEmpty (EqualBoth G l u v) := ⟨fun p => hne p.1.1 p.2.2.1⟩
  exact Fintype.card_eq_zero

open Classical in
lemma hub_center_equality_zero (s : ℕ) (i : Fin 2) :
    Fintype.card (EqualBoth G [2,s] (.inl (some (i,anchor [s]))) (.inl (anchor [2,s])))=0 :=
  equalBoth_card_zero_of_ne G [2,s] _ _ (fun p => hom_hub_ne_center G s (hom G [2,s] p) i)

open Classical in
lemma hub_terminal_equality_zero (hb : G.IsBipartite) (s : ℕ) (i k : Fin 2) (j : Fin s) :
    Fintype.card (EqualBoth G [2,s] (.inl (some (i,anchor [s]))) (.inl (some (k,some (j,())))))=0 :=
  equalBoth_card_zero_of_ne G [2,s] _ _ (fun p => hom_hub_ne_terminal G hb s (hom G [2,s] p) i k j)

end Erdos571.LayeredBush


/-! Exhaustive equality-pattern classification for the subdivided symmetric
double star in a bipartite host. -/
namespace Erdos571.LayeredBush
open SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
lemma equalBoth_swap_card (l : List ℕ) (u v : Interior l⊕Leaves l) :
    Fintype.card (EqualBoth G l u v)=Fintype.card (EqualBoth G l v u) := by
  let e : EqualBoth G l u v ≃ EqualBoth G l v u := Equiv.subtypeEquivRight (fun p => by
    change (p.1.1=p.2.1 ∧ hom G l p.1 u=hom G l p.1 v ∧ hom G l p.2 u=hom G l p.2 v) ↔
      (p.1.1=p.2.1 ∧ hom G l p.1 v=hom G l p.1 u ∧ hom G l p.2 v=hom G l p.2 u)
    simp only [eq_comm])
  simpa only [←Nat.card_eq_fintype_card] using Nat.card_congr e

lemma interior_case_split (s : ℕ) (a : Interior [2,s]) :
    a=anchor [2,s] ∨ (∃ i : Fin 2, a=some (i,anchor [s])) ∨
      ∃ (i : Fin 2) (j : Fin s), a=some (i,some (j,())) := by
  cases a with
  | none => exact .inl rfl
  | some p =>
    rcases p with ⟨i,a⟩
    cases a with
    | none => exact .inr (.inl ⟨i,rfl⟩)
    | some p =>
      rcases p with ⟨j,t⟩
      cases t
      exact .inr (.inr ⟨i,j,rfl⟩)

open Classical in
theorem interior_equalities_uniform (hb : G.IsBipartite) (s : ℕ) (B : ℝ) (hB : 0 ≤ B)
    (hhub : (Fintype.card (EqualBoth G [2,s] (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) ≤ B)
    (hcenter : ∀ (i : Fin 2) (j : Fin s),
      (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (i,some (j,()))))) : ℝ) ≤ B)
    (hmiddle : ∀ (i k : Fin 2) (j t : Fin s), some (i,some (j,())) ≠ some (k,some (t,())) →
      (Fintype.card (EqualBoth G [2,s] (.inl (some (i,some (j,())))) (.inl (some (k,some (t,()))))) : ℝ) ≤ B)
    (a b : Interior [2,s]) (hne : a≠b) :
    (Fintype.card (EqualBoth G [2,s] (.inl a) (.inl b)) : ℝ) ≤ B := by
  rcases interior_case_split s a with rfl|⟨i,rfl⟩|⟨i,j,rfl⟩ <;>
    rcases interior_case_split s b with rfl|⟨k,rfl⟩|⟨k,t,rfl⟩
  · exact (hne rfl).elim
  · rw [equalBoth_swap_card,hub_center_equality_zero,Nat.cast_zero]
    exact hB
  · exact hcenter k t
  · rw [hub_center_equality_zero,Nat.cast_zero]
    exact hB
  · fin_cases i <;> fin_cases k
    · exact (hne rfl).elim
    · exact hhub
    · rw [equalBoth_swap_card]
      exact hhub
    · exact (hne rfl).elim
  · rw [hub_terminal_equality_zero G hb,Nat.cast_zero]
    exact hB
  · rw [equalBoth_swap_card]
    exact hcenter i j
  · rw [equalBoth_swap_card,hub_terminal_equality_zero G hb,Nat.cast_zero]
    exact hB
  · exact hmiddle i k j t hne

open Classical in
/-- All ordered unequal role pairs are controlled by the five meaningful
collision classes. The hub/middle classes vanish in a bipartite host. -/
theorem all_equalities_uniform (hb : G.IsBipartite) (s : ℕ) (B : ℝ) (hB : 0 ≤ B)
    (hhub : (Fintype.card (EqualBoth G [2,s] (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) ≤ B)
    (hcenter : ∀ (i : Fin 2) (j : Fin s),
      (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (i,some (j,()))))) : ℝ) ≤ B)
    (hmiddle : ∀ (i k : Fin 2) (j t : Fin s), some (i,some (j,())) ≠ some (k,some (t,())) →
      (Fintype.card (EqualBoth G [2,s] (.inl (some (i,some (j,())))) (.inl (some (k,some (t,()))))) : ℝ) ≤ B)
    (hroot : ∀ r t : Leaves [2,s], r≠t →
      (Fintype.card (EqualBoth G [2,s] (.inr r) (.inr t)) : ℝ) ≤ B)
    (hinteriorroot : ∀ (a : Interior [2,s]) (r : Leaves [2,s]),
      (Fintype.card (EqualBoth G [2,s] (.inl a) (.inr r)) : ℝ) ≤ B)
    (p : DistinctRoles [2,s]) :
    (Fintype.card (EqualBoth G [2,s] p.1.1 p.1.2) : ℝ) ≤ B := by
  rcases p with ⟨⟨a|r,b|t⟩,hne⟩
  · exact interior_equalities_uniform G hb s B hB hhub hcenter hmiddle a b (fun he => hne (congrArg Sum.inl he))
  · exact hinteriorroot a t
  · rw [equalBoth_swap_card]
    exact hinteriorroot b r
  · exact hroot r t (fun he => hne (congrArg Sum.inr he))

end Erdos571.LayeredBush


/-! Uniform relative bounds for all repeated-root patterns, with the omitted
root-hub events restored by one-copy Cauchy estimates. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
lemma root_hub_left_sum_small (s : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hpin : ∀ i : Fin 2, (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ) ≤
      η^2*(Fintype.card (Agreement G [2,s]) : ℝ)) (r : Leaves [2,s]) :
    2*∑ i : Fin 2, (Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr r)) : ℝ) ≤
      4*η*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  simp only [←Nat.card_eq_fintype_card] at hpin ⊢
  let E : ℝ := Nat.card (Agreement G [2,s])
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have hi (i : Fin 2) : (Nat.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr r)) : ℝ) ≤ η*E := by
    have h₁ := interior_root_left_bound G [2,s] (hubRole s i) r
    simp only [←Nat.card_eq_fintype_card,hubRole] at h₁
    have h₂ := mul_le_mul_of_nonneg_right (hpin i) hE
    have h₃ : 0 ≤ η*E := mul_nonneg hη hE
    dsimp only [hubRole,E] at h₁ h₂ h₃ ⊢
    nlinarith
  have hsum : (∑ i : Fin 2, (Nat.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr r)) : ℝ)) ≤ 2*(η*E) := by
    calc
      _ ≤ ∑ _i : Fin 2, η*E := sum_le_sum (fun i _ => hi i)
      _ = _ := by simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul, Nat.cast_ofNat]
  nlinarith

open Classical in
theorem root_equalities_small (s : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hpin : ∀ i : Fin 2, (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ) ≤
      η^2*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hcross : ∀ j k : Fin s, (Fintype.card (CrossRootSeparated G s j k) : ℝ) ≤
      η*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hsame : ∀ j k : Fin s, j≠k → (Fintype.card (SameRootSeparated G s j k) : ℝ) ≤
      η*(Fintype.card (Agreement G [2,s]) : ℝ))
    (r t : Leaves [2,s]) (hne : r≠t) :
    (Fintype.card (EqualBoth G [2,s] (.inr r) (.inr t)) : ℝ) ≤
      5*η*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  let E : ℝ := Fintype.card (Agreement G [2,s])
  have hcross' (j k : Fin s) :
      (Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (1,k,()))) : ℝ) ≤ 5*η*E := by
    have hp : (Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (1,k,()))) : ℝ) ≤
        (Fintype.card (CrossRootSeparated G s j k) : ℝ)+
        2*∑ i : Fin 2, (Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr (0,j,()))) : ℝ) := by
      exact_mod_cast cross_root_partition_bound G s j k
    have hh := root_hub_left_sum_small G s η hη hpin (0,j,())
    have hs := hcross j k
    linarith
  have hsame' (j k : Fin s) (hjk : j≠k) :
      (Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (0,k,()))) : ℝ) ≤ 5*η*E := by
    have hp : (Fintype.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (0,k,()))) : ℝ) ≤
        (Fintype.card (SameRootSeparated G s j k) : ℝ)+
        2*∑ i : Fin 2, (Fintype.card (EqualLeft G [2,s] (.inl (hubRole s i)) (.inr (0,j,()))) : ℝ) := by
      exact_mod_cast same_root_partition_bound G s j k
    have hh := root_hub_left_sum_small G s η hη hpin (0,j,())
    have hs := hsame j k hjk
    linarith
  rcases r with ⟨i,j,u⟩
  rcases t with ⟨k,m,v⟩
  cases u
  cases v
  fin_cases i <;> fin_cases k
  · exact hsame' j m (fun he => hne (by subst m; rfl))
  · exact hcross' j m
  · rw [equalBoth_swap_card]
    exact hcross' m j
  · have hh := hsame' j m (fun he => hne (by subst m; rfl))
    have hswap := root_bundle_swap_card G s j m
    simp only [←Nat.card_eq_fintype_card] at hswap hh ⊢
    calc
      _ = (Nat.card (EqualBoth G [2,s] (.inr (0,j,())) (.inr (0,m,()))) : ℝ) :=
        congrArg (fun n : ℕ => (n : ℝ)) hswap
      _ ≤ _ := by simpa only [E,←Nat.card_eq_fintype_card] using hh

end Erdos571.LayeredBush


/-! Combining all actual collision classes into a finite ordinary-freeness
contradiction under explicit small-error hypotheses. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem not_free_of_small_errors (hb : G.IsBipartite) (s M L : ℕ) (hM : 2 ≤ M)
    (hcodeg : ∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (η ε : ℝ) (hη : 0 ≤ η) (hη1 : η ≤ 1) (hε : 0 ≤ ε)
    (hscale : (6+5*(L:ℝ))*η ≤ ε^2) (hpinScale : η^2 ≤ ε)
    (hsmall : (M-1:ℕ)*(2*(Fintype.card (DistinctRoles [2,s]) : ℝ)+(nonroots [2,s] : ℝ)^2)*ε < 1)
    (hpos : 0 < (Fintype.card (Agreement G [2,s]) : ℝ))
    (hpin : ∀ a : Interior [2,s], (Fintype.card (Pinned G [2,s] a) : ℝ) ≤
      η^2*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hhub : (Fintype.card (EqualBoth G [2,s] (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) ≤
      η^2*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hcenter : ∀ (i : Fin 2) (j : Fin s),
      (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (i,some (j,()))))) : ℝ) ≤
        η*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hcross : ∀ j k : Fin s, (Fintype.card (CrossRootSeparated G s j k) : ℝ) ≤
      η*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hsame : ∀ j k : Fin s, j≠k → (Fintype.card (SameRootSeparated G s j k) : ℝ) ≤
      η*(Fintype.card (Agreement G [2,s]) : ℝ)) :
    ¬(FullRootedPower.graph (graph [2,s]) M).Free G := by
  classical
  let E : ℝ := Fintype.card (Agreement G [2,s])
  let H : ℝ := 6+5*L
  have hE : 0 ≤ E := hpos.le
  have hηE : 0 ≤ η*E := mul_nonneg hη hE
  have hη2 : η^2 ≤ η := by nlinarith
  have hH1 : 1 ≤ H := by dsimp [H]; have hL : (0:ℝ) ≤ L := Nat.cast_nonneg _; linarith
  have hH5 : 5 ≤ H := by dsimp [H]; have hL : (0:ℝ) ≤ L := Nat.cast_nonneg _; linarith
  have hbound : η*E ≤ H*η*E := by
    simpa only [mul_assoc,one_mul] using mul_le_mul_of_nonneg_right hH1 hηE
  have hbound5 : 5*η*E ≤ H*η*E := by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hH5 hηE
  have hbound2 : η^2*E ≤ H*η*E := (mul_le_mul_of_nonneg_right hη2 hE).trans hbound
  have hroot (r t : Leaves [2,s]) (hne : r≠t) :
      (Fintype.card (EqualBoth G [2,s] (.inr r) (.inr t)) : ℝ) ≤ 5*η*E :=
    root_equalities_small G s η hη (fun i => hpin (some (i,anchor [s]))) hcross hsame r t hne
  have hmiddle (i k : Fin 2) (j t : Fin s)
      (hne : some (i,some (j,())) ≠ some (k,some (t,()))) :
      (Fintype.card (EqualBoth G [2,s] (.inl (some (i,some (j,())))) (.inl (some (k,some (t,()))))) : ℝ) ≤ H*η*E := by
    have hrne : (⟨i,j,()⟩ : Leaves [2,s]) ≠ ⟨k,t,()⟩ := by
      intro he
      exact hne (congrArg (attach [2,s]) he)
    have hc : (Fintype.card (EqualBoth G [2,s] (.inl (some (i,some (j,())))) (.inl (some (k,some (t,()))))) : ℝ) ≤
        (Fintype.card (Pinned G [2,s] (some (i,some (j,())))) : ℝ)+
          (L:ℝ)*(Fintype.card (EqualBoth G [2,s] (.inr (i,j,())) (.inr (k,t,()))) : ℝ) := by
      exact_mod_cast attachment_collision_bound G [2,s] (i,j,()) (k,t,()) L hcodeg
    calc
      _ ≤ _ := hc
      _ ≤ η^2*E+(L:ℝ)*(5*η*E) := add_le_add (hpin _) (mul_le_mul_of_nonneg_left (hroot _ _ hrne) (Nat.cast_nonneg _))
      _ ≤ η*E+(L:ℝ)*(5*η*E) := add_le_add (mul_le_mul_of_nonneg_right hη2 hE) le_rfl
      _ ≤ H*η*E := by dsimp [H]; nlinarith
  have hir (a : Interior [2,s]) (r : Leaves [2,s]) :
      (Fintype.card (EqualBoth G [2,s] (.inl a) (.inr r)) : ℝ) ≤ H*η*E := by
    have hi : (Fintype.card (EqualBoth G [2,s] (.inl a) (.inr r)) : ℝ) ≤
        (Fintype.card (Pinned G [2,s] a) : ℝ) := by exact_mod_cast interior_root_both_le_pin G [2,s] a r
    exact hi.trans ((hpin a).trans hbound2)
  apply not_free_of_uniform_energies G [2,s] M hM ε hε hsmall hpos
  · intro p
    have h := all_equalities_uniform G hb s (H*η*E) (by positivity)
      (hhub.trans hbound2) (fun i j => (hcenter i j).trans hbound) hmiddle
      (fun r t hne => (hroot r t hne).trans hbound5) hir p
    exact h.trans (by simpa only [H,mul_assoc] using mul_le_mul_of_nonneg_right hscale hE)
  · intro a
    exact (hpin a).trans (mul_le_mul_of_nonneg_right hpinScale hE)

end Erdos571.LayeredBush


/-! Elementary power-threshold algebra for relative finite energies. -/
namespace Erdos571.EnergyThresholds

lemma relative_of_power {x E B a : ℝ} (hE : 0 ≤ E) (ha : 0 ≤ a)
    (k : ℕ) (hk : 1 ≤ k) (hx : x^k ≤ B*E^(k-1)) (hB : B ≤ a^k*E) : x ≤ a*E := by
  apply le_of_pow_le_pow_left₀ (by omega : k≠0) (mul_nonneg ha hE)
  calc
    _ ≤ B*E^(k-1) := hx
    _ ≤ (a^k*E)*E^(k-1) := mul_le_mul_of_nonneg_right hB (pow_nonneg hE _)
    _ = (a*E)^k := by
      rw [mul_assoc,←pow_succ',show k-1+1=k by omega,mul_pow]

lemma relative_of_square {x E C a : ℝ} (hE : 0 ≤ E) (ha : 0 ≤ a)
    (hx : x^2 ≤ C*E) (hC : C ≤ a^2*E) : x ≤ a*E := by
  apply relative_of_power hE ha 2 (by omega) _ hC
  simpa only [Nat.reduceSub,pow_one] using hx

end Erdos571.EnergyThresholds


/-! Small cardinality and symmetry utilities for the analytic closure. -/
namespace Erdos571.LayeredBush
open SimpleGraph LayeredTrees LayeredGramKernels
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
lemma pinned_le_agreement (l : List ℕ) (a : Interior l) :
    Fintype.card (Pinned G l a) ≤ Fintype.card (Agreement G l) := by
  classical
  let f : Pinned G l a → Agreement G l := fun p => ⟨p.1,p.2.1⟩
  exact Fintype.card_le_of_injective f (fun p q he => by
    apply Subtype.ext
    exact congrArg (fun z : Agreement G l => z.val) he)

open Classical in
lemma central_terminal_bundle_swap_card (s : ℕ) (j : Fin s) :
    Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (1,some (j,())))))=
      Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (0,some (j,()))))) := by
  have h := Nat.card_congr (equalBothBranchPermEquiv G s (Equiv.swap 0 1)
    (.inl (anchor [2,s])) (.inl (some (0,some (j,())))))
  simpa only [branchVertexPerm,anchor,Equiv.swap_apply_left,←Nat.card_eq_fintype_card] using h

lemma adjacency_square_common_card (u v : W) :
    (G.adjMatrix ℝ * G.adjMatrix ℝ) u v=(Fintype.card (G.commonNeighbors u v) : ℝ) := by
  rw [←pow_two,SimpleGraph.adjMatrix_pow_apply_eq_card_walk]
  exact_mod_cast Fintype.card_congr (G.walkLengthTwoEquivCommonNeighbors u v)

end Erdos571.LayeredBush


/-! Scalar interpolation inequalities for the actual rootless agreement
counts and the mixed bilateral expression. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem graph_moment_bounds (D : ℝ) (hdeg : ∀ u, (G.degree u : ℝ) ≤ D)
    (hp : ∃ u, 0 < G.degree u) (s : ℕ) (hs : 1 ≤ s) :
    (Fintype.card (Agreement G [2,s-1]) : ℝ)^s ≤
      (Fintype.card W : ℝ)^2*D^4*(Fintype.card (Agreement G [2,s]) : ℝ)^(s-1) ∧
    conjugationInner (G.adjMatrix ℝ)
      (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) (s-1))
      (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s)^(2*s) ≤
      (Fintype.card W : ℝ)^2*D^4*(Fintype.card (Agreement G [2,s]) : ℝ)^(2*s-1) := by
  let A := G.adjMatrix ℝ
  let N := A*A
  let Q := N*N
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hN := chain_nonneg hA hA
  have hQ := chain_nonneg hN hN
  have hsN : N.transpose=N := by
    dsimp only [N]
    rw [Matrix.transpose_mul,G.isSymm_adjMatrix]
  have hp' : ∃ u, 0 < (A.transpose*A) u u ∧ 0 < Q u u := by
    have hh := graph_bilateral_positive G hp
    change ∃ u, 0 < (A.transpose*A) u u ∧ 0 < (N*N.transpose) u u at hh
    simpa only [hsN] using hh
  have hrow (u : W) : ∑ v, A u v ≤ D := by
    have he := G.adjMatrix_mulVec_const_apply (α := ℝ) (a := 1) (v := u)
    simp only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] at he
    exact he.le.trans (hdeg u)
  have hzero := bilateral_zero_upper A Q hA D hrow
  constructor
  · have h := bilateral_interpolation A Q hA hQ hp' s hs
    have hh := h.trans (mul_le_mul_of_nonneg_right hzero (pow_nonneg (squareMass_nonneg _) _))
    simpa only [bilateral_agreement_card] using hh
  · have h := bilateral_mixed_interpolation A Q hA hQ hp' s hs
    have hh := h.trans (mul_le_mul_of_nonneg_right hzero (pow_nonneg (squareMass_nonneg _) _))
    simpa only [bilateral_agreement_card] using hh

end Erdos571.LayeredBush


/-! Two scalar energy thresholds suffice for ordinary rooted-power containment
in globally bounded-codegree bipartite hosts. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin EnergyThresholds
variable {W : Type} (G : SimpleGraph W) [Fintype W] [DecidableEq W] [DecidableRel G.Adj]

open Classical in
theorem not_free_of_energy_thresholds (hb : G.IsBipartite) (s M L : ℕ) (hs : 1 ≤ s) (hM : 2 ≤ M)
    (d D : ℝ) (hd : 0 < d) (hD : 0 ≤ D)
    (hdeg : ∀ u, d ≤ (G.degree u : ℝ) ∧ (G.degree u : ℝ) ≤ D)
    (hcodeg : ∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (hp : ∃ u, 0 < G.degree u)
    (η ε κ μ : ℝ) (hη : 0 ≤ η) (hη1 : η ≤ 1) (hε : 0 ≤ ε) (hκ : 0 ≤ κ) (hμ : 0 ≤ μ)
    (hscale : (6+5*(L:ℝ))*η ≤ ε^2) (hpinScale : η^2 ≤ ε)
    (hκsmall : κ ≤ η^2)
    (hterminal : d^2*D*(L:ℝ)*μ+D^2*κ ≤ d^2*η^2)
    (hroot : (L:ℝ)^2*μ ≤ η)
    (hcentral : (2*(L:ℝ)^2+2*D^2)*μ^2 ≤ η^2)
    (hsmall : (M-1:ℕ)*(2*(Fintype.card (DistinctRoles [2,s]) : ℝ)+(nonroots [2,s] : ℝ)^2)*ε < 1)
    (hpos : 0 < (Fintype.card (Agreement G [2,s]) : ℝ))
    (hGram : (Fintype.card W : ℝ)*(((L:ℝ)+1)*D^2)^(2*s+1) ≤
      κ^2*(Fintype.card (Agreement G [2,s]) : ℝ))
    (hZero : (Fintype.card W : ℝ)^2*D^4 ≤ μ^(2*s)*(Fintype.card (Agreement G [2,s]) : ℝ)) :
    ¬(FullRootedPower.graph (graph [2,s]) M).Free G := by
  classical
  let E : ℝ := Fintype.card (Agreement G [2,s])
  let Eprev : ℝ := Fintype.card (Agreement G [2,s-1])
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let Mixed := conjugationInner A (entryPower Q (s-1)) (entryPower Q s)
  let Z : ℝ := (Fintype.card W : ℝ)^2*D^4
  have hE : 0 ≤ E := hpos.le
  have hEp : 0 ≤ Eprev := Nat.cast_nonneg _
  have hL : (0:ℝ) ≤ L := Nat.cast_nonneg _
  have hcodeg' (x y : W) (hne : x≠y) : (A*A) x y ≤ (L:ℝ) := by
    rw [adjacency_square_common_card]
    exact_mod_cast hcodeg x y hne
  have hmoment := graph_moment_bounds G D (fun u => (hdeg u).2) hp s hs
  have hMixed : Mixed ≤ μ*E := relative_of_power hE hμ (2*s) (by omega) hmoment.2 hZero
  have hprev : Eprev ≤ μ^2*E := by
    apply relative_of_power hE (sq_nonneg μ) s hs hmoment.1
    simpa only [←pow_mul] using hZero
  have hhubPin (i : Fin 2) : (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ) ≤ κ*E :=
    relative_of_square hE hκ (hub_pin_bound_global G L D hL hD (fun u => (hdeg u).2) hcodeg' s i) hGram
  have hcenterPin : (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ) ≤ κ*E :=
    relative_of_square hE hκ (center_pin_bound_global G L D hL hD (fun u => (hdeg u).2) hcodeg' s hs) hGram
  have hpin (a : Interior [2,s]) : (Fintype.card (Pinned G [2,s] a) : ℝ) ≤ η^2*E := by
    rcases interior_case_split s a with rfl|⟨i,rfl⟩|⟨i,j,rfl⟩
    · exact hcenterPin.trans (mul_le_mul_of_nonneg_right hκsmall hE)
    · exact (hhubPin i).trans (mul_le_mul_of_nonneg_right hκsmall hE)
    · have ht := terminal_pin_mixed_bound G d D L hd.le hD hL hdeg hcodeg' s hs i j
      have hb₁ := mul_le_mul_of_nonneg_left hMixed (show 0 ≤ d^2*D*(L:ℝ) by positivity)
      have hb₂ := mul_le_mul_of_nonneg_left (hhubPin i) (sq_nonneg D)
      have hcf := mul_le_mul_of_nonneg_right hterminal hE
      have ht' : d^2*(Fintype.card (Pinned G [2,s] (some (i,some (j,())))) : ℝ) ≤ d^2*(η^2*E) := by
        dsimp only [Mixed,A,Q,E] at hb₁ hb₂ hcf ⊢
        nlinarith
      exact (mul_le_mul_iff_of_pos_left (sq_pos_of_pos hd)).mp ht'
  have hhub : (Fintype.card (EqualBoth G [2,s] (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) ≤ η^2*E := by
    have hh := relative_of_square hE hκ
      (hub_equality_bound_global G L D hL hD (fun u => (hdeg u).2) hcodeg' s hs) hGram
    exact hh.trans (mul_le_mul_of_nonneg_right hκsmall hE)
  have hrootSmall (x : ℝ) (hx : x^(2*s) ≤ ((L:ℝ)^2)^(2*s)*(Fintype.card W : ℝ)^2*D^4*E^(2*s-1)) : x ≤ η*E := by
    have hx' : x^(2*s) ≤ ((L:ℝ)^2)^(2*s)*Z*E^(2*s-1) := by
      simpa only [Z,mul_assoc] using hx
    have hz : ((L:ℝ)^2)^(2*s)*Z ≤ ((L:ℝ)^2*μ)^(2*s)*E := by
      have hh := mul_le_mul_of_nonneg_left hZero (pow_nonneg (sq_nonneg (L:ℝ)) (2*s))
      simpa only [mul_pow,mul_assoc,Z] using hh
    exact (relative_of_power hE (mul_nonneg (sq_nonneg (L:ℝ)) hμ) (2*s) (by omega) hx' hz).trans
      (mul_le_mul_of_nonneg_right hroot hE)
  have hcross (j k : Fin s) : (Fintype.card (CrossRootSeparated G s j k) : ℝ) ≤ η*E := by
    apply hrootSmall
    exact cross_root_separated_bound G L D hL (fun u => (hdeg u).2) hcodeg' hp s hs j k
  have hsame (j k : Fin s) (hjk : j≠k) : (Fintype.card (SameRootSeparated G s j k) : ℝ) ≤ η*E := by
    apply hrootSmall
    exact same_root_separated_bound G L D hL (fun u => (hdeg u).2) hcodeg' hp s hs j k hjk
  have hct (j : Fin s) :
      (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (0,some (j,()))))) : ℝ) ≤ η*E := by
    have hct := central_terminal_equality_bound_global G L D hL hD (fun u => (hdeg u).2) hcodeg' s j
    have hple : (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ) ≤ E := by
      dsimp only [E]
      exact_mod_cast pinned_le_agreement G [2,s] (anchor [2,s])
    have hh : (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (0,some (j,()))))) : ℝ)^2 ≤ (η*E)^2 := by
      calc
        _ ≤ 2*(L:ℝ)^2*Eprev*E+2*D^2*Eprev*(Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ) := hct
        _ ≤ 2*(L:ℝ)^2*Eprev*E+2*D^2*Eprev*E :=
          add_le_add le_rfl (mul_le_mul_of_nonneg_left hple (by positivity))
        _ = (2*(L:ℝ)^2+2*D^2)*Eprev*E := by ring
        _ ≤ (2*(L:ℝ)^2+2*D^2)*(μ^2*E)*E :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hprev (by positivity)) hE
        _ = ((2*(L:ℝ)^2+2*D^2)*μ^2)*E^2 := by ring
        _ ≤ η^2*E^2 := mul_le_mul_of_nonneg_right hcentral (sq_nonneg E)
        _ = _ := (mul_pow η E 2).symm
    exact le_of_pow_le_pow_left₀ (by decide : 2≠0) (mul_nonneg hη hE) hh
  have hcenter (i : Fin 2) (j : Fin s) :
      (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (i,some (j,()))))) : ℝ) ≤ η*E := by
    fin_cases i
    · exact hct j
    · calc
        _ = (Fintype.card (EqualBoth G [2,s] (.inl (anchor [2,s])) (.inl (some (0,some (j,()))))) : ℝ) := by
          exact_mod_cast central_terminal_bundle_swap_card G s j
        _ ≤ _ := hct j
  exact not_free_of_small_errors G hb s M L hM hcodeg η ε hη hη1 hε hscale hpinScale hsmall hpos
    hpin hhub hcenter hcross hsame

end Erdos571.LayeredBush


/-! Positive scalar choices for the small-error certificate. -/
namespace Erdos571.BushCoefficientChoice

lemma choose (c H C : ℝ) (hc : 0 ≤ c) (hH : 1 ≤ H) (hC : 0 ≤ C) :
    ∃ ε η τ : ℝ, 0 < ε ∧ ε ≤ 1 ∧ 0 < η ∧ η ≤ 1 ∧ 0 < τ ∧ τ ≤ 1 ∧
      c*ε < 1 ∧ H*η ≤ ε^2 ∧ η^2 ≤ ε ∧ C*τ ≤ η^2 := by
  let ε : ℝ := 1/(c+2)
  have hc2 : 0 < c+2 := by linarith
  have hε : 0 < ε := div_pos (by norm_num) hc2
  have hεeq : (c+2)*ε=1 := by dsimp [ε]; field_simp
  have hε1 : ε ≤ 1 := by nlinarith
  let η := ε^2/(H+1)
  have hH1 : 0 < H+1 := by linarith
  have hη : 0 < η := div_pos (sq_pos_of_pos hε) hH1
  have hηeq : (H+1)*η=ε^2 := by dsimp [η]; field_simp
  have hηε : η ≤ ε^2 := by nlinarith
  have hη1 : η ≤ 1 := by nlinarith
  let τ := η^2/(C+1)
  have hC1 : 0 < C+1 := by linarith
  have hτ : 0 < τ := div_pos (sq_pos_of_pos hη) hC1
  have hτeq : (C+1)*τ=η^2 := by dsimp [τ]; field_simp
  have hτη : τ ≤ η^2 := by nlinarith
  have hτ1 : τ ≤ 1 := by nlinarith
  refine ⟨ε,η,τ,hε,hε1,hη,hη1,hτ,hτ1,?_,?_,?_,?_⟩ <;> nlinarith

lemma coefficients (K L d D η τ : ℝ) (hK : 0 ≤ K) (hL : 0 ≤ L)
    (hd : 0 ≤ d) (hD : 1 ≤ D) (hreg : D ≤ K*d)
    (hη : 0 ≤ η) (hη1 : η ≤ 1) (hτ : 0 ≤ τ) (hτ1 : τ ≤ 1)
    (hsmall : (2*K^2+2*L^2+2*L+2)*τ ≤ η^2) :
    τ ≤ η^2 ∧
    d^2*D*L*(τ/D)+D^2*τ ≤ d^2*η^2 ∧
    L^2*(τ/D) ≤ η ∧
    (2*L^2+2*D^2)*(τ/D)^2 ≤ η^2 := by
  have hDp : 0 < D := by linarith
  have hμ : 0 ≤ τ/D := div_nonneg hτ hDp.le
  have hμτ : τ/D ≤ τ := div_le_self hτ hD
  have hτsq : τ^2 ≤ τ := by nlinarith
  have hηsq : η^2 ≤ η := by nlinarith
  have hKτ : 2*K^2*τ ≤ η^2 := by nlinarith [mul_nonneg (sq_nonneg L) hτ, mul_nonneg hL hτ]
  have hLτ : 2*L*τ ≤ η^2 := by nlinarith [mul_nonneg (sq_nonneg L) hτ, mul_nonneg (sq_nonneg K) hτ]
  have hL2τ : 2*L^2*τ ≤ η^2 := by nlinarith [mul_nonneg (sq_nonneg K) hτ, mul_nonneg hL hτ]
  have hcoefτ : (2*L^2+2)*τ ≤ η^2 := by nlinarith [mul_nonneg (sq_nonneg K) hτ, mul_nonneg hL hτ]
  have hDsq : D^2 ≤ K^2*d^2 := by
    simpa only [mul_pow] using pow_le_pow_left₀ hDp.le hreg 2
  have hmul : D*(τ/D)=τ := by field_simp
  refine ⟨?_,?_,?_,?_⟩
  · nlinarith [mul_nonneg (sq_nonneg K) hτ, mul_nonneg (sq_nonneg L) hτ, mul_nonneg hL hτ]
  · have ha := mul_le_mul_of_nonneg_left hKτ (sq_nonneg d)
    have hb := mul_le_mul_of_nonneg_left hLτ (sq_nonneg d)
    have hc := mul_le_mul_of_nonneg_right hDsq hτ
    have he : d^2*D*L*(τ/D)=d^2*L*τ := by calc
      _ = d^2*L*(D*(τ/D)) := by ring
      _ = _ := by rw [hmul]
    rw [he]
    nlinarith
  · have hh := mul_le_mul_of_nonneg_left hμτ (sq_nonneg L)
    nlinarith
  · have hμsq := pow_le_pow_left₀ hμ hμτ 2
    have ha := mul_le_mul_of_nonneg_left hμsq (show 0 ≤ 2*L^2 by positivity)
    have hb : D^2*(τ/D)^2=τ^2 := by rw [←mul_pow,hmul]
    have hc := mul_le_mul_of_nonneg_left hτsq (show 0 ≤ 2*L^2+2 by positivity)
    nlinarith

end Erdos571.BushCoefficientChoice


/-! Natural-power transport from sharp degree conditions to the two scalar
energy thresholds. -/
namespace Erdos571.BushDegreeTransport

lemma normalized_lower (n d E : ℝ) (hn : 0 < n) (s : ℕ) (hs : 1 ≤ s)
    (h : n^2*d^(8*s+4) ≤ n^(2*s)*E) :
    n*d^(8*s+4) ≤ n^(2*s-1)*E := by
  apply (mul_le_mul_iff_of_pos_left hn).mp
  calc
    _ = n^2*d^(8*s+4) := by ring
    _ ≤ n^(2*s)*E := h
    _ = _ := by
      have he : n^(2*s)=n^(2*s-1)*n := by rw [←pow_succ]; congr 1; omega
      rw [he]
      ring

lemma core_threshold (n d D K R E τ : ℝ) (hn : 0 < n) (hd : 0 ≤ d)
    (hD : 0 ≤ D) (hK : 0 ≤ K) (hR : 0 ≤ R) (hreg : D ≤ K*d)
    (a b : ℕ) (hlower : n*d^(2*b) ≤ n^a*E)
    (hdense : n^a*R*K^b ≤ τ^2*d^b) :
    n*R*D^b ≤ τ^2*E := by
  have hDp : D^b ≤ K^b*d^b := by simpa only [mul_pow] using pow_le_pow_left₀ hD hreg b
  apply (mul_le_mul_iff_of_pos_right (pow_pos hn a)).mp
  calc
    _ ≤ (n*R*(K^b*d^b))*n^a :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hDp (by positivity)) (pow_nonneg hn.le _)
    _ = (n^a*R*K^b)*(n*d^b) := by ring
    _ ≤ (τ^2*d^b)*(n*d^b) := mul_le_mul_of_nonneg_right hdense (by positivity)
    _ = τ^2*(n*d^(2*b)) := by rw [mul_comm 2 b,pow_mul]; ring
    _ ≤ τ^2*(n^a*E) := mul_le_mul_of_nonneg_left hlower (sq_nonneg τ)
    _ = _ := by ring

lemma zero_degree_threshold (n d D K E τ : ℝ) (hn : 0 < n) (hd : 0 ≤ d)
    (hD : 0 ≤ D) (hK : 0 ≤ K) (hτ : 0 ≤ τ) (hreg : D ≤ K*d)
    (a p q r : ℕ) (hlower : n*d^(r+q) ≤ n^a*E)
    (hdense : n^(a+1)*K^q ≤ τ^p*d^r) :
    n^2*D^q ≤ τ^p*E := by
  have hDp : D^q ≤ K^q*d^q := by simpa only [mul_pow] using pow_le_pow_left₀ hD hreg q
  apply (mul_le_mul_iff_of_pos_right (pow_pos hn a)).mp
  calc
    _ ≤ (n^2*(K^q*d^q))*n^a :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hDp (sq_nonneg n)) (pow_nonneg hn.le _)
    _ = (n^(a+1)*K^q)*(n*d^q) := by rw [pow_succ]; ring
    _ ≤ (τ^p*d^r)*(n*d^q) := mul_le_mul_of_nonneg_right hdense (by positivity)
    _ = τ^p*(n*d^(r+q)) := by rw [pow_add]; ring
    _ ≤ τ^p*(n^a*E) := mul_le_mul_of_nonneg_left hlower (pow_nonneg hτ _)
    _ = _ := by ring

lemma zero_threshold (n D E τ : ℝ) (hD : 0 < D) (p : ℕ)
    (h : n^2*D^(p+4) ≤ τ^p*E) : n^2*D^4 ≤ (τ/D)^p*E := by
  apply (mul_le_mul_iff_of_pos_right (pow_pos hD p)).mp
  calc
    _ = n^2*D^(p+4) := by rw [pow_add]; ring
    _ ≤ τ^p*E := h
    _ = _ := by rw [div_pow]; field_simp

lemma exists_degree_coefficient (R K τ : ℝ) (hτ : 0 < τ) (a b : ℕ) :
    ∃ B : ℝ, 0 < B ∧ R*K^b ≤ τ^2*B ∧ (K^3)^a ≤ τ^a*B := by
  obtain ⟨B,hB⟩ := exists_gt (max 0 (max (R*K^b/τ^2) ((K^3)^a/τ^a)))
  have hB0 : 0 < B := (le_max_left _ _).trans_lt hB
  have h₁ : R*K^b/τ^2 ≤ B := ((le_max_left _ _).trans (le_max_right _ _)).trans hB.le
  have h₂ : (K^3)^a/τ^a ≤ B := ((le_max_right _ _).trans (le_max_right _ _)).trans hB.le
  refine ⟨B,hB0,?_,?_⟩
  · simpa only [mul_comm] using (div_le_iff₀ (sq_pos_of_pos hτ)).mp h₁
  · simpa only [mul_comm] using (div_le_iff₀ (pow_pos hτ a)).mp h₂

lemma single_to_two (n d K R τ B : ℝ) (hn : 0 ≤ n) (hd : 1 ≤ d)
    (hK : 1 ≤ K) (hτ : 0 < τ) (s : ℕ) (hs : 3 ≤ s)
    (hB₁ : R*K^(4*s+2) ≤ τ^2*B)
    (hB₂ : (K^3)^(2*s-1) ≤ τ^(2*s-1)*B)
    (hdense : B*n^(2*s-1) ≤ d^(4*s+2)) :
    n^(2*s-1)*R*K^(4*s+2) ≤ τ^2*d^(4*s+2) ∧
      n^(2*s)*K^(2*s+4) ≤ τ^(2*s)*d^(6*s) := by
  have hd0 : 0 ≤ d := le_trans (by norm_num) hd
  refine ⟨?_,?_⟩
  · calc
      _ = (R*K^(4*s+2))*n^(2*s-1) := by ring
      _ ≤ (τ^2*B)*n^(2*s-1) := mul_le_mul_of_nonneg_right hB₁ (pow_nonneg hn _)
      _ = τ^2*(B*n^(2*s-1)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hdense (sq_nonneg τ)
  · have hc : (K^3*n)^(2*s-1) ≤ (τ*d^3)^(2*s-1) := by
      calc
        _ = (K^3)^(2*s-1)*n^(2*s-1) := mul_pow _ _ _
        _ ≤ (τ^(2*s-1)*B)*n^(2*s-1) := mul_le_mul_of_nonneg_right hB₂ (pow_nonneg hn _)
        _ = τ^(2*s-1)*(B*n^(2*s-1)) := by ring
        _ ≤ τ^(2*s-1)*d^(4*s+2) := mul_le_mul_of_nonneg_left hdense (pow_nonneg hτ.le _)
        _ ≤ τ^(2*s-1)*d^(3*(2*s-1)) :=
          mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hd (by omega)) (pow_nonneg hτ.le _)
        _ = _ := by rw [pow_mul,mul_pow]
    have hc' : K^3*n ≤ τ*d^3 :=
      le_of_pow_le_pow_left₀ (by omega : 2*s-1≠0) (by positivity) hc
    have hp := pow_le_pow_left₀ (show 0 ≤ K^3*n by positivity) hc' (2*s)
    have he₁ : (K^3*n)^(2*s)=K^(6*s)*n^(2*s) := by
      rw [mul_pow,←pow_mul]
      congr 1
      congr 1
      omega
    have he₂ : (τ*d^3)^(2*s)=τ^(2*s)*d^(6*s) := by
      rw [mul_pow,←pow_mul]
      congr 1
      congr 1
      omega
    rw [he₁,he₂] at hp
    apply le_trans _ hp
    have hh := mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ hK (by omega : 2*s+4 ≤ 6*s)) (pow_nonneg hn (2*s))
    simpa only [mul_comm] using hh

end Erdos571.BushDegreeTransport


/-! A sharp conditional degree bound for the subdivided symmetric double-star
rooted power. The host codegree cap is GLOBAL and remains an assumption. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable (s M L : ℕ) (hs : 3 ≤ s) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K)
include hs hM hK

open Classical in
/-- Sharp rooted-density degree bound under a global bounded-codegree
hypothesis. This does not supply a cleaning theorem for arbitrary hosts. -/
theorem bounded_codegree_degree_bound :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u : ℝ) ∧ (G.degree u : ℝ) ≤ K*d) →
      (∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L) →
      (FullRootedPower.graph (graph [2,s]) M).Free G →
      d^(4*s+2) < B*(Fintype.card W : ℝ)^(2*s-1) := by
  classical
  let c : ℝ := (M-1:ℕ)*(2*(Fintype.card (DistinctRoles [2,s]) : ℝ)+(nonroots [2,s] : ℝ)^2)
  let H : ℝ := 6+5*L
  let C : ℝ := 2*K^2+2*(L:ℝ)^2+2*L+2
  have hc : 0 ≤ c := by dsimp [c]; positivity
  have hH : 1 ≤ H := by dsimp [H]; have hL : (0:ℝ) ≤ L := Nat.cast_nonneg _; linarith
  have hC : 0 ≤ C := by dsimp [C]; positivity
  obtain ⟨ε,η,τ,hε,hε1,hη,hη1,hτ,hτ1,hεsmall,hscale,hpinScale,hτsmall⟩ :=
    BushCoefficientChoice.choose c H C hc hH hC
  let R : ℝ := ((L:ℝ)+1)^(2*s+1)
  obtain ⟨B,hB,hB₁,hB₂⟩ := BushDegreeTransport.exists_degree_coefficient R K τ hτ (2*s-1) (4*s+2)
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hcodeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W : ℝ)^(2*s-1) ≤ d^(4*s+2) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Fintype.card (Agreement G [2,s])
  let A := G.adjMatrix ℝ
  have hn : 0 < n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hdpos : 0 < d := by linarith
  have hK0 : 0 ≤ K := le_trans (by norm_num) hK
  have hL0 : (0:ℝ) ≤ L := Nat.cast_nonneg _
  have hD : 1 ≤ D := by dsimp [D]; nlinarith
  have hDpos : 0 < D := by linarith
  have hs1 : 1 ≤ s := by omega
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : d ≤ ∑ v, A u v := by
    have he := G.adjMatrix_mulVec_const_apply (α := ℝ) (a := 1) (v := u)
    simp only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] at he
    exact (hdeg u).1.trans he.ge
  have hlow : n^2*d^(8*s+4) ≤ n^(2*s)*E := by
    have h := bilateral_degree_lower A G.isSymm_adjMatrix hA d hdpos.le hrow s
    simpa only [n,E,bilateral_agreement_card,A] using h
  have hE : 0 < E := by
    have hh : 0 < n^(2*s)*E := (mul_pos (sq_pos_of_pos hn) (pow_pos hdpos _)).trans_le hlow
    exact (mul_pos_iff_of_pos_left (pow_pos hn (2*s))).mp hh
  have hp : ∃ u, 0 < G.degree u := by
    obtain ⟨u⟩ := ‹Nonempty W›
    refine ⟨u,?_⟩
    have hh : (0:ℝ) < G.degree u := hdpos.trans_le (hdeg u).1
    exact_mod_cast hh
  have hlow' := BushDegreeTransport.normalized_lower n d E hn s hs1 hlow
  obtain ⟨hden₁,hden₂⟩ := BushDegreeTransport.single_to_two n d K R τ B hn.le hd hK hτ s hs hB₁ hB₂ hdense
  have hGram : n*(((L:ℝ)+1)*D^2)^(2*s+1) ≤ τ^2*E := by
    have hl : n*d^(2*(4*s+2)) ≤ n^(2*s-1)*E := by
      simpa only [show 2*(4*s+2)=8*s+4 by omega] using hlow'
    have h := BushDegreeTransport.core_threshold n d D K R E τ hn hdpos.le hDpos.le hK0
      (by dsimp [R]; positivity) le_rfl (2*s-1) (4*s+2) hl hden₁
    simpa only [mul_pow,←pow_mul,show 2*(2*s+1)=4*s+2 by omega,R,mul_assoc] using h
  have hZero : n^2*D^4 ≤ (τ/D)^(2*s)*E := by
    apply BushDegreeTransport.zero_threshold n D E τ hDpos (2*s)
    have hl : n*d^(6*s+(2*s+4)) ≤ n^(2*s-1)*E := by
      simpa only [show 6*s+(2*s+4)=8*s+4 by omega] using hlow'
    have ht : n^((2*s-1)+1)*K^(2*s+4) ≤ τ^(2*s)*d^(6*s) := by
      simpa only [show (2*s-1)+1=2*s by omega] using hden₂
    exact BushDegreeTransport.zero_degree_threshold n d D K E τ hn hdpos.le hDpos.le hK0 hτ.le
      le_rfl (2*s-1) (2*s) (2*s+4) (6*s) hl ht
  obtain ⟨hκsmall,hterminal,hroot,hcentral⟩ := BushCoefficientChoice.coefficients K L d D η τ hK0 hL0
    hdpos.le hD le_rfl hη.le hη1 hτ.le hτ1 hτsmall
  exact not_free_of_energy_thresholds G hb s M L hs1 hM d D hdpos hDpos.le hdeg hcodeg hp
    η ε τ (τ/D) hη.le hη1 hε.le hτ.le (div_nonneg hτ.le hDpos.le)
    hscale hpinScale hκsmall hterminal hroot hcentral hεsmall hE hGram hZero hf

end Erdos571.LayeredBush


/-! The sharp bush bound for hosts with globally bounded codegrees, without
any bipartiteness or degree-regularity assumption on the host. The codegree
hypothesis is retained throughout; this is not an unrestricted Turán bound. -/
namespace Erdos571.BoundedCodegreeTransport
open Finset SimpleGraph

variable {V W : Type*} [Fintype V] [Fintype W]

/-- Common-neighbor cardinalities cannot increase under an ordinary graph copy. -/
theorem commonNeighbors_le (H : SimpleGraph V) (G : SimpleGraph W)
    [DecidableRel H.Adj] [DecidableRel G.Adj] (f : H.Copy G) (u v : V) :
    Fintype.card (H.commonNeighbors u v) ≤ Fintype.card (G.commonNeighbors (f u) (f v)) := by
  classical
  let e : H.commonNeighbors u v → G.commonNeighbors (f u) (f v) :=
    fun x => ⟨f x.val, f.toHom.map_adj x.property.1, f.toHom.map_adj x.property.2⟩
  apply Fintype.card_le_of_injective e
  intro x y he
  exact Subtype.ext (f.injective (congrArg Subtype.val he))

/-- A global natural codegree cap is hereditary under ordinary containment. -/
theorem cap_of_copy (H : SimpleGraph V) (G : SimpleGraph W)
    [DecidableRel H.Adj] [DecidableRel G.Adj] (f : H.Copy G) (L : ℕ)
    (hc : ∀ u v, u ≠ v → Fintype.card (G.commonNeighbors u v) ≤ L) :
    ∀ u v, u ≠ v → Fintype.card (H.commonNeighbors u v) ≤ L := by
  intro u v huv
  exact (commonNeighbors_le H G f u v).trans (hc _ _ (fun h => huv (f.injective h)))

end Erdos571.BoundedCodegreeTransport

namespace Erdos571.LayeredBush
open Finset SimpleGraph DensityRegularization

noncomputable def degreeExponent (s : ℕ) : ℝ := (2*s-1:ℕ)/(4*s+2:ℕ)

lemma degreeExponent_pos (s : ℕ) (hs : 1 ≤ s) : 0 < degreeExponent s := by
  have hn : (0:ℝ) < (2*s-1:ℕ) := by exact_mod_cast (show 0 < 2*s-1 by omega)
  exact div_pos hn (by positivity)

lemma degreeExponent_le_one (s : ℕ) : degreeExponent s ≤ 1 := by
  apply (div_le_one (by positivity : (0:ℝ) < (4*s+2:ℕ))).mpr
  exact_mod_cast (show 2*s-1 ≤ 4*s+2 by omega)

/-- The conditional degree estimate extends to all induced almost-regular
subgraphs, including small minimum degrees and empty vertex sets. -/
theorem bounded_codegree_regular_bound (s M L : ℕ) (hs : 3 ≤ s) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (∀ u v, u ≠ v → Fintype.card (G.commonNeighbors u v) ≤ L) →
        (FullRootedPower.graph (graph [2,s]) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent s) := by
  obtain ⟨B,hB,hbound⟩ := bounded_codegree_degree_bound s M L hs hM Q hQ
  let C : ℝ := B^((4*s+2:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hcodeg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent s :=
    Real.one_le_rpow hn1 (degreeExponent_pos s (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent s := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (FullRootedPower.graph (graph [2,s]) M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have hcap := BoundedCodegreeTransport.cap_of_copy H G (Copy.induce G (U:Set W)) L hcodeg
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hcap hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (4*s+2) (2*s-1) (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent s at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent s) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The sharp bush exponent is an edge bound in the entire class of hosts
with a fixed global codegree cap. Bipartiteness and regularity are no longer
assumptions on the host. The codegree cap is still an essential hypothesis. -/
theorem bounded_codegree_edge_bound (s M L : ℕ) (hs : 3 ≤ s) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (∀ u v, u ≠ v → Fintype.card (G.commonNeighbors u v) ≤ L) →
        (FullRootedPower.graph (graph [2,s]) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent s) := by
  have hγ : 0 < degreeExponent s := degreeExponent_pos s (by omega)
  have hγ1 : degreeExponent s ≤ 1 := degreeExponent_le_one s
  let K : ℝ := (16:ℝ)^((degreeExponent s)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent s)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := bounded_codegree_regular_bound s M L hs hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hcodeg hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (FullRootedPower.graph (graph [2,s]) M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  obtain ⟨f⟩ := IsContained.of_le hFG
  have hcap := BoundedCodegreeTransport.cap_of_copy F G f L hcodeg
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent s) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hcap hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

/-- The first parameter gives the precise restricted exponent `19/14`.
This still assumes a global codegree cap on the host. -/
theorem bounded_codegree_nineteen_fourteenths (M L : ℕ) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (∀ u v, u ≠ v → Fintype.card (G.commonNeighbors u v) ≤ L) →
        (FullRootedPower.graph (graph [2,3]) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(19/14:ℝ) := by
  have h := bounded_codegree_edge_bound 3 M L (by omega) hM
  have he : 1+degreeExponent 3=(19/14:ℝ) := by norm_num [degreeExponent]
  rw [he] at h
  exact h

end Erdos571.LayeredBush


/-! Balancedness and the exact random-algebraic lower exponent for layered
bushes. The removed-short-edge allocation already exists for layered trees;
here it is transported to the actual rootless graph. -/
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees RootedSunflower

/-- Restore the distinguished short root, without using it in this copy. -/
def addShortCopy (l : List ℕ) : (graph l).Copy (template l) where
  toHom :=
    { toFun := Sum.map id some
      map_rel' := by
        rintro (u|u) (v|v) h <;> exact h }
  injective' := by
    rintro (u|u) (v|v) h <;> simp_all

lemma card_edges (l : List ℕ) : Nat.card (graph l).edgeSet = edges l-1 := by
  have h := (isTree_iff_connected_and_card.mp (isTree l)).2
  simp only [Nat.card_eq_fintype_card, Fintype.card_sum, card_interior, card_leaves] at h
  rw [Nat.card_eq_fintype_card, edges_eq]
  omega

abbrev BushEdgeIndex (l : List ℕ) := {e : EdgeIndex l // e ≠ anchorEdge l}

lemma shortRoot_not_in_image (l : List ℕ) (e : (graph l).edgeSet) :
    Sum.inr none ∉ ((addShortCopy l).toHom.mapEdgeSet e).val := by
  intro h
  obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp h
  cases v <;> simp [addShortCopy] at he

noncomputable def bushEdgeIndex (l : List ℕ) (e : (graph l).edgeSet) : BushEdgeIndex l :=
  ⟨(edgeEquiv l).symm ((addShortCopy l).toHom.mapEdgeSet e), by
    intro he
    apply shortRoot_not_in_image l e
    have hm := (root_mem_iff l _).mpr he
    have hh : edgeMap l ((edgeEquiv l).symm ((addShortCopy l).toHom.mapEdgeSet e)) =
        (addShortCopy l).toHom.mapEdgeSet e := (edgeEquiv l).apply_symm_apply _
    rwa [hh] at hm⟩

lemma bushEdgeIndex_injective (l : List ℕ) : Function.Injective (bushEdgeIndex l) := by
  intro e f he
  apply Hom.mapEdgeSet.injective (addShortCopy l).toHom (addShortCopy l).injective
  apply (edgeEquiv l).symm.injective
  exact congrArg Subtype.val he

lemma bushEdgeIndex_bijective (l : List ℕ) : Function.Bijective (bushEdgeIndex l) := by
  classical
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  refine ⟨bushEdgeIndex_injective l, ?_⟩
  rw [← Nat.card_eq_fintype_card, card_edges]
  change edges l-1=Fintype.card {e : EdgeIndex l // ¬ e=anchorEdge l}
  have hsingle : Fintype.card {e : EdgeIndex l // e=anchorEdge l}=1 := Fintype.card_unique
  rw [Fintype.card_subtype_compl, hsingle, card_edgeIndex]

noncomputable def bushEdgeEquiv (l : List ℕ) : (graph l).edgeSet ≃ BushEdgeIndex l :=
  Equiv.ofBijective (bushEdgeIndex l) (bushEdgeIndex_bijective l)

lemma removedWeight_anchor (l : List ℕ) (a : Interior l) :
    removedWeight l a (anchorEdge l)=0 := by
  cases l with
  | nil => simp [removedWeight, anchorEdge]
  | cons k l => cases a <;> rfl

lemma removedWeight_bush_sum (l : List ℕ) (a : Interior l) :
    (∑ e : BushEdgeIndex l, removedWeight l a e.val) = ((edges l:ℚ)-1)/nonroots l := by
  classical
  rw [← sum_subtype (univ.erase (anchorEdge l)) (by intro x; simp)]
  have h := sum_erase_add (univ : Finset (EdgeIndex l)) (removedWeight l a) (mem_univ (anchorEdge l))
  rw [removedWeight_anchor, add_zero] at h
  exact h.trans ((weight_rows l).2 a)

noncomputable def bushWeight (l : List ℕ) (a : Interior l) (e : (graph l).edgeSet) : ℚ :=
  removedWeight l a (bushEdgeIndex l e).val

lemma bushWeight_row (l : List ℕ) (a : Interior l) :
    (∑ e, bushWeight l a e)=((edges l:ℚ)-1)/nonroots l := by
  have h := (bushEdgeEquiv l).sum_comp (fun e => removedWeight l a e.val)
  exact h.trans (removedWeight_bush_sum l a)

lemma bushWeight_support (l : List ℕ) (a : Interior l) (e : (graph l).edgeSet)
    (ha : Sum.inl a ∉ e.val) : bushWeight l a e=0 := by
  apply (weight_support l).2
  intro h
  have hh := (incidence_iff l a (bushEdgeIndex l e).val).mp h
  have he : edgeMap l (bushEdgeIndex l e).val = (addShortCopy l).toHom.mapEdgeSet e :=
    (edgeEquiv l).apply_symm_apply _
  rw [he] at hh
  obtain ⟨v,hv,hv'⟩ := Sym2.mem_map.mp hh
  have hv'' : (addShortCopy l) v = (addShortCopy l) (Sum.inl a) := hv'
  exact ha ((addShortCopy l).injective hv'' ▸ hv)

/-- Removing the short distinguished root preserves the lower-balance
certificate, with one fewer edge. -/
theorem balanced (l : List ℕ) (hl : Valid l) :
    ∀ C : Finset (Interior l), (edges l-1)*(Fintype.card (Interior l)-C.card) ≤
      nonroots l*Nat.card (PetalEdge (graph l) C) := by
  have he : 1 ≤ edges l := (nonroots_pos l).trans_le (by rw [edges_eq]; omega)
  apply WeightedBalance.balance (graph l) (bushWeight l) (nonroots l) (edges l-1)
    (nonroots_pos l) (fun a e => (weight_nonneg l hl).2 a _) (bushWeight_support l)
  · intro a
    rw [bushWeight_row, Nat.cast_sub he, Nat.cast_one]
  · intro e
    have h := (weight_columns l).2 (bushEdgeIndex l e).val
    rw [if_neg (bushEdgeIndex l e).property] at h
    exact h.le

/-- Every valid bush with at least one leaf has a fixed rooted power with
its predicted lower exponent. -/
theorem exists_power_lower (l : List ℕ) (hl : Valid l) (hp : ∀ k ∈ l, 0 < k) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(nonroots l:ℝ)/(edges l-1:ℕ)))
      (fun n : ℕ => (extremalNumber n (FullRootedPower.graph (graph l) M):ℝ)) := by
  have hleaf : 0 < Fintype.card (Leaves l) := by rw [card_leaves]; exact prod_pos l hp
  letI : Nonempty (Leaves l) := Fintype.card_pos_iff.mp hleaf
  letI : Nontrivial (Interior l ⊕ Leaves l) :=
    ⟨⟨.inl (anchor l), .inr (Classical.choice ‹Nonempty (Leaves l)›), Sum.inl_ne_inr⟩⟩
  have hno : ∀ u, ∃ v, (graph l).Adj u v :=
    (isTree l).isConnected.preconnected.exists_adj_of_nontrivial
  have hab : nonroots l ≤ edges l-1 := by
    rw [edges_eq]
    have h := prod_pos l hp
    omega
  exact FullRootedPower.exact_lower (graph l) hno (nonroots l) (edges l-1)
    ((nonroots_pos l).trans_le hab) hab (balanced l hl)

/-- The rootless symmetric bush has the lower exponent matching the
class-restricted upper bound. No unrestricted upper bound is claimed. -/
theorem symmetric_exists_lower (s : ℕ) (hs : 1 ≤ s) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(1+degreeExponent s))
      (fun n : ℕ => (extremalNumber n (FullRootedPower.graph (graph [2,s]) M):ℝ)) := by
  have hv : Valid [2,s] := by
    refine ⟨⟨trivial, ?_⟩, ?_⟩ <;> simp only [edges, nonroots] <;> omega
  have hp : ∀ k ∈ [2,s], 0 < k := by intro k hk; simp only [List.mem_cons, List.not_mem_nil, or_false] at hk; omega
  have h := exists_power_lower [2,s] hv hp
  have he : 2-(nonroots [2,s]:ℝ)/(edges [2,s]-1:ℕ) = 1+degreeExponent s := by
    have hn : 1 ≤ 2*s := by omega
    have hd : (0:ℝ) < 4*s+2 := by positivity
    simp only [nonroots, edges]
    norm_num
    unfold degreeExponent
    rw [Nat.cast_sub hn]
    push_cast
    field_simp
    ring
  rwa [he] at h

/-- The rooted powers of every bush are bipartite. -/
theorem power_bipartite (l : List ℕ) (M : ℕ) :
    (FullRootedPower.graph (graph l) M).IsBipartite := by
  let c : Interior l ⊕ Leaves l → Bool := fun v => fullColor l (addShortCopy l v)
  have hc : ∀ {u v}, (graph l).Adj u v → c u ≠ c v := by
    intro u v h
    exact fullColor_proper l ((addShortCopy l).toHom.map_adj h)
  let C : (FullRootedPower.graph (graph l) M).Coloring Bool :=
    ⟨FullRootedPower.color c M, FullRootedPower.color_proper _ _ _ hc⟩
  simpa only [Fintype.card_bool] using C.colorable

/-- A fixed bipartite witness has the predicted unconditional lower bound,
and the matching upper bound in every fixed bounded-codegree host class.
The missing unrestricted upper bound is not included in this theorem. -/
theorem symmetric_lower_and_codegree_upper (s : ℕ) (hs : 3 ≤ s) :
    ∃ M : ℕ, 2 ≤ M ∧ (FullRootedPower.graph (graph [2,s]) M).IsBipartite ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(1+degreeExponent s))
        (fun n : ℕ => (extremalNumber n (FullRootedPower.graph (graph [2,s]) M):ℝ)) ∧
      ∀ L : ℕ, ∃ D : ℝ, 0 ≤ D ∧
        ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
          (∀ u v, u ≠ v → Fintype.card (G.commonNeighbors u v) ≤ L) →
          (FullRootedPower.graph (graph [2,s]) M).Free G →
          (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent s) := by
  obtain ⟨M,hM,hl⟩ := symmetric_exists_lower s (by omega)
  exact ⟨M,hM,power_bipartite [2,s] M,hl,fun L => bounded_codegree_edge_bound s M L hs hM⟩

end Erdos571.LayeredBush


/- Weighted Turán bounds for a clique-free heavy-codegree shadow. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HeavyCliqueMoments
open Finset SimpleGraph Matrix
variable {V I : Type} [Fintype V] [Fintype I]

open Classical in
lemma weighted_nonadj (K : SimpleGraph V) (k : ℕ) (hk : 2 ≤ k)
    (hK : K.CliqueFree k) (w : V → ℝ) (hw : ∀ v, 0 ≤ w v) :
    (∑ v, w v)^2 ≤ (k-1:ℕ) * ∑ u, ∑ v, if ¬K.Adj u v then w u*w v else 0 := by
  classical
  have h := PackingEnergy.weighted_bound (univ : Finset V) (fun u v => ¬K.Adj u v)
    (fun u _ => K.loopless u) (fun u _ v _ h hv => h (K.symm hv)) k hk (by
      rintro ⟨S, hS, hSc, hc⟩
      apply hK S
      refine ⟨?_, hSc⟩
      intro u hu v hv huv
      exact not_not.mp (hc u hu v hv huv)) w (fun v _ => hw v)
  simpa only [PackingEnergy.pairs, sum_filter, sum_product] using h

open Classical in
lemma sum_masked_form (A : Matrix I V ℝ) (K : SimpleGraph V) (f : V → ℝ) :
    (∑ i, ∑ u, ∑ v, if ¬K.Adj u v then (A i u*f u)*(A i v*f v) else 0) =
      ∑ u, ∑ v, if ¬K.Adj u v then (A.transpose*A) u v*f u*f v else 0 := by
  classical
  rw [sum_comm]
  apply sum_congr rfl
  intro u hu
  rw [sum_comm]
  apply sum_congr rfl
  intro v hv
  by_cases h : K.Adj u v
  · simp [h]
  · simp only [h, not_false_eq_true, ite_true, Matrix.mul_apply, Matrix.transpose_apply,
      sum_mul]
    apply sum_congr rfl
    intro i hi
    ring

open Classical in
/-- A positive quadratic form may be restricted to nonedges of a clique-free
shadow, at a constant loss. No entrywise deletion of a Gram factor is used. -/
theorem quadratic_mask (A : Matrix I V ℝ) (hA : ∀ i v, 0 ≤ A i v)
    (K : SimpleGraph V) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (f : V → ℝ) (hf : ∀ v, 0 ≤ f v) :
    (∑ i, (∑ v, A i v*f v)^2) ≤
      (k-1:ℕ) * ∑ u, ∑ v, if ¬K.Adj u v then (A.transpose*A) u v*f u*f v else 0 := by
  classical
  calc
    _ ≤ ∑ i, (k-1:ℕ) * ∑ u, ∑ v,
        if ¬K.Adj u v then (A i u*f u)*(A i v*f v) else 0 := by
      apply sum_le_sum
      intro i hi
      exact weighted_nonadj K k hk hK (fun v => A i v*f v) (fun v => mul_nonneg (hA i v) (hf v))
    _ = _ := by rw [← mul_sum, sum_masked_form]

/-- Only nonedges of the shadow need a codegree bound. -/
theorem quadratic_bound (A : Matrix I V ℝ) (hA : ∀ i v, 0 ≤ A i v)
    (K : SimpleGraph V) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L)
    (hdiag : ∀ v, (A.transpose*A) v v ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬K.Adj u v → (A.transpose*A) u v ≤ L)
    (f : V → ℝ) (hf : ∀ v, 0 ≤ f v) :
    (∑ i, (∑ v, A i v*f v)^2) ≤
      (k-1:ℕ) * (L*(∑ v, f v)^2 + D*∑ v, (f v)^2) := by
  classical
  apply (quadratic_mask A hA K k hk hK f hf).trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  have hh (u v : V) :
      (if ¬K.Adj u v then (A.transpose*A) u v*f u*f v else 0) ≤
        L*f u*f v + if u=v then D*(f u)^2 else 0 := by
    by_cases he : u=v
    · subst v
      rw [if_pos (K.loopless u), if_pos rfl]
      have hm := mul_le_mul_of_nonneg_right (hdiag u) (sq_nonneg (f u))
      nlinarith [mul_nonneg hL (sq_nonneg (f u))]
    · rw [if_neg he, add_zero]
      by_cases ha : K.Adj u v
      · simp only [ha, not_true_eq_false, ite_false]
        exact mul_nonneg (mul_nonneg hL (hf u)) (hf v)
      · rw [if_pos ha]
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (hlight u v he ha) (hf u)) (hf v)
  calc
    _ ≤ ∑ u, ∑ v, (L*f u*f v + if u=v then D*(f u)^2 else 0) :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => hh u v))
    _ = _ := by
      simp only [sum_add_distrib, sum_ite_eq, mem_univ, if_true, ←mul_sum]
      simp only [← mul_sum, ← sum_mul]
      ring


variable [DecidableEq V]

/-- Fourth-walk row mass is bounded using a clique-free shadow, rather than
a global pointwise codegree cap. -/
theorem graph_row_bound (G : SimpleGraph V) [DecidableRel G.Adj]
    (K : SimpleGraph V) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ v, (G.degree v : ℝ) ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬K.Adj u v →
      (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) (u : V) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤
      (k-1:ℕ)*(L+1)*D^2 := by
  let A := G.adjMatrix ℝ
  have hA (x y : V) : 0 ≤ A x y := by
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hsym : A.IsSymm := G.isSymm_adjMatrix
  have hrow : ∑ v, A u v = (G.degree u : ℝ) := by
    simpa only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] using
      (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
  have hsq : ∑ v, (A u v)^2 = (G.degree u : ℝ) := by
    rw [← hrow]
    apply sum_congr rfl
    intro v hv
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have h := quadratic_bound A hA K k hk hK L D hL
    (by intro v; rw [hsym]; exact (G.adjMatrix_mul_self_apply_self v).le.trans (hdeg v))
    (by simpa only [hsym.eq] using hlight) (fun v => A u v) (hA u)
  have he (v : V) : (∑ x, A v x*A u x)=(A*A) u v := by
    simp only [Matrix.mul_apply]
    apply sum_congr rfl
    intro x hx
    rw [hsym.apply v x]
    ring
  simp_rw [he] at h
  rw [hrow, hsq] at h
  apply h.trans
  have hdg : 0 ≤ (G.degree u : ℝ) := Nat.cast_nonneg _
  have h₁ := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hdg (hdeg u) 2) hL
  have h₂ := mul_le_mul_of_nonneg_left (hdeg u) hD
  have hb : L*(G.degree u : ℝ)^2 + D*(G.degree u : ℝ) ≤ (L+1)*D^2 := by
    nlinarith
  exact (mul_le_mul_of_nonneg_left hb (Nat.cast_nonneg (k-1))).trans_eq (by ring)

/-- The corresponding entrywise bound on the fourth-walk kernel. -/
theorem graph_fourWalk_bound (G : SimpleGraph V) [DecidableRel G.Adj]
    (K : SimpleGraph V) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hdeg : ∀ v, (G.degree v : ℝ) ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬K.Adj u v →
      (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) (u v : V) :
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤
      (k-1:ℕ)*(L+1)*D^2 := by
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    rw [Matrix.IsSymm, Matrix.transpose_mul, SimpleGraph.transpose_adjMatrix]
  have h := GramPin.kernel_entry_le_of_rows (G.adjMatrix ℝ * G.adjMatrix ℝ)
    ((k-1:ℕ)*(L+1)*D^2) (by positivity)
    (graph_row_bound G K k hk hK L D hL hD hdeg hlight) u v
  simpa only [hs.eq] using h


end Erdos571.HeavyCliqueMoments


/-! Fourth-walk moments in graphs avoiding a fixed one-subdivision. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph Matrix
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]

lemma cliqueFree_of_subdivision_free (H : SimpleGraph V)
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (hf : (ProjectionHeavy.subdivision H).Free G) :
    (graph G U (Fintype.card V + Nat.card H.edgeSet)).CliqueFree (Fintype.card V) := by
  apply SimpleGraph.cliqueFree_iff_top_free.mpr
  intro h
  exact free H G U hf ((SimpleGraph.IsContained.of_le (show H ≤ ⊤ from le_top)).trans h)

lemma common_univ_card (G : SimpleGraph W) [DecidableRel G.Adj] (u v : W) :
    (FourthMoment.common G univ u v).card=Fintype.card (G.commonNeighbors u v) := by
  symm
  apply Fintype.card_of_finset' (FourthMoment.common G univ u v)
  intro w
  simp [FourthMoment.common, SimpleGraph.mem_commonNeighbors]

lemma light_square_bound (G : SimpleGraph W) [DecidableRel G.Adj] (t : ℕ)
    (u v : W) (hne : u ≠ v) (hn : ¬(graph G univ t).Adj u v) :
    (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ t := by
  have h : ¬t ≤ (FourthMoment.common G univ u v).card := fun h => hn ⟨hne,h⟩
  rw [LayeredBush.adjacency_square_common_card, ← common_univ_card]
  exact_mod_cast (Nat.le_of_lt (Nat.lt_of_not_ge h))

/-- The maximum-degree fourth-moment bound uses actual subdivision freeness.
There is no global codegree-cap hypothesis. -/
theorem subdivision_free_row_bound (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) (u : W) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤
      (Fintype.card V-1:ℕ) * ((Fintype.card V + Nat.card H.edgeSet:ℕ)+1:ℝ)*D^2 := by
  exact HeavyCliqueMoments.graph_row_bound G
    (graph G univ (Fintype.card V + Nat.card H.edgeSet)) (Fintype.card V) hV
    (cliqueFree_of_subdivision_free H G univ hf) _ D (Nat.cast_nonneg _) hD hdeg
    (light_square_bound G _) u

theorem subdivision_free_fourWalk_bound (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) (u v : W) :
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤
      (Fintype.card V-1:ℕ) * ((Fintype.card V + Nat.card H.edgeSet:ℕ)+1:ℝ)*D^2 := by
  exact HeavyCliqueMoments.graph_fourWalk_bound G
    (graph G univ (Fintype.card V + Nat.card H.edgeSet)) (Fintype.card V) hV
    (cliqueFree_of_subdivision_free H G univ hf) _ D (Nat.cast_nonneg _) hD hdeg
    (light_square_bound G _) u v

theorem subdivision_free_gram_mass_bound (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) :
    GramPin.squareMass (G.adjMatrix ℝ * G.adjMatrix ℝ) ≤
      Fintype.card W*((Fintype.card V-1:ℕ) * ((Fintype.card V + Nat.card H.edgeSet:ℕ)+1:ℝ)*D^2) := by
  calc
    _ ≤ ∑ _u : W, (Fintype.card V-1:ℕ) * ((Fintype.card V + Nat.card H.edgeSet:ℕ)+1:ℝ)*D^2 :=
      sum_le_sum (fun u _ => subdivision_free_row_bound H hV G hf D hD hdeg u)
    _ = _ := by simp

end Erdos571.HostHeavyShadow


/-! The two-bundle bush power embeds in a complete graph subdivision. -/
set_option maxHeartbeats 3000000
namespace Erdos571.BushSubdivision
open Finset SimpleGraph LayeredTrees

abbrev Branch (s M : ℕ) := (Fin M × Fin 2) ⊕ (Fin 2 × Fin s)
abbrev Middle (s M : ℕ) := Fin M ⊕ (Fin M × Fin 2 × Fin s)
abbrev Vertex (s M : ℕ) := (Fin M × Interior [2,s]) ⊕ Leaves [2,s]

/-- Separate the degree-two vertices from the branch vertices. -/
def split (s M : ℕ) : Vertex s M ≃ Branch s M ⊕ Middle s M where
  toFun
    | .inl (k,none) => .inr (.inl k)
    | .inl (k,some (i,none)) => .inl (.inl (k,i))
    | .inl (k,some (i,some (j,()))) => .inr (.inr (k,i,j))
    | .inr (i,j,()) => .inl (.inr (i,j))
  invFun
    | .inl (.inl (k,i)) => .inl (k,some (i,none))
    | .inl (.inr (i,j)) => .inr (i,j,())
    | .inr (.inl k) => .inl (k,none)
    | .inr (.inr (k,i,j)) => .inl (k,some (i,some (j,())))
  left_inv := by
    rintro (⟨k,(_|⟨i,(_|⟨j,⟨⟩⟩)⟩)⟩|⟨i,j,⟨⟩⟩) <;> rfl
  right_inv := by
    rintro ((⟨k,i⟩|⟨i,j⟩)|(k|⟨k,i,j⟩)) <;> rfl

def ends (s M : ℕ) : Middle s M → Branch s M × Branch s M
  | .inl k => (.inl (k,0), .inl (k,1))
  | .inr (k,i,j) => (.inl (k,i), .inr (i,j))

lemma ends_ne (s M : ℕ) (m : Middle s M) : (ends s M m).1 ≠ (ends s M m).2 := by
  rcases m with k|⟨k,i,j⟩
  · simp [ends]
  · simp [ends]

def edge (s M : ℕ) (m : Middle s M) : (⊤ : SimpleGraph (Branch s M)).edgeSet :=
  ⟨s((ends s M m).1,(ends s M m).2), (SimpleGraph.top_adj _ _).mpr (ends_ne s M m)⟩

lemma edge_injective (s M : ℕ) : Function.Injective (edge s M) := by
  intro m n he
  have h := congrArg Subtype.val he
  rcases m with k|⟨k,i,j⟩ <;> rcases n with k'|⟨k',i',j'⟩
  all_goals simp only [edge, ends, Sym2.eq_iff, Sum.inl.injEq, Sum.inr.injEq,
    Sum.inl_ne_inr, Sum.inr_ne_inl, Prod.mk.injEq] at h
  · rcases h with ⟨h,_⟩|⟨h,h'⟩
    · simp_all
    · norm_num at h
  · tauto
  · tauto
  · rcases h with ⟨⟨rfl,rfl⟩,⟨_,rfl⟩⟩|h
    · rfl
    · tauto

def vertexMap (s M : ℕ) : Vertex s M → Branch s M ⊕ (⊤ : SimpleGraph (Branch s M)).edgeSet :=
  Sum.map id (edge s M) ∘ split s M

lemma vertexMap_injective (s M : ℕ) : Function.Injective (vertexMap s M) :=
  (Sum.map_injective.mpr ⟨Function.injective_id,edge_injective s M⟩).comp (split s M).injective

lemma branch_mem_center (s M : ℕ) (k : Fin M) (i : Fin 2) :
    (Sum.inl (k,i) : Branch s M) ∈ (edge s M (.inl k)).val := by
  simp only [edge, ends, Sym2.mem_iff, Sum.inl.injEq, Prod.mk.injEq, true_and]
  fin_cases i <;> simp

/-- An ordinary copy, not merely a graph homomorphism. -/
def copy (s M : ℕ) :
    (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Copy
      (ProjectionHeavy.subdivision (⊤ : SimpleGraph (Branch s M))) where
  toHom :=
    { toFun := vertexMap s M
      map_rel' := by
        rintro (⟨k,(_|⟨i,(_|⟨j,⟨⟩⟩)⟩)⟩|⟨i,j,⟨⟩⟩)
          (⟨k',(_|⟨i',(_|⟨j',⟨⟩⟩)⟩)⟩|⟨i',j',⟨⟩⟩) h
        all_goals simp only [FullRootedPower.graph, LayeredBush.graph, LeafRooted.graph,
          RootedIncidence.graph, core, TreeFan.graph, anchor, LayeredTrees.attach] at h
        all_goals try contradiction
        all_goals simp only [vertexMap, Function.comp_apply, split, Sum.map_inl, Sum.map_inr,
          id_eq, ProjectionHeavy.subdivision, SixCycleCase.bipGraph, ProjectionHeavy.incidence]
        all_goals try { obtain ⟨rfl,rfl⟩ := h; exact branch_mem_center s M _ _ }
        all_goals try { obtain ⟨rfl,⟨rfl,rfl⟩⟩ := h; simp [edge, ends] }
        all_goals simp_all [edge, ends, Sym2.mem_iff]
        all_goals first | (fin_cases i <;> simp) | (fin_cases i' <;> simp) }
  injective' := vertexMap_injective s M

end Erdos571.BushSubdivision


/-! Actual bush-power freeness implies the fourth-walk bounds needed for
unmasked hub and center pin estimates. No global codegree cap is assumed. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LayeredBush
open Finset SimpleGraph Matrix LayeredTrees LayeredGramKernels GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def momentCoefficient (s M : ℕ) : ℝ :=
  (Fintype.card (BushSubdivision.Branch s M)-1:ℕ) *
    ((Fintype.card (BushSubdivision.Branch s M) +
      Nat.card (⊤ : SimpleGraph (BushSubdivision.Branch s M)).edgeSet:ℕ)+1:ℝ)

lemma momentCoefficient_nonneg (s M : ℕ) : 0 ≤ momentCoefficient s M := by
  unfold momentCoefficient
  positivity

lemma complete_subdivision_free (s M : ℕ) (G : SimpleGraph W)
    (hf : (FullRootedPower.graph (graph [2,s]) M).Free G) :
    (ProjectionHeavy.subdivision (⊤ : SimpleGraph (BushSubdivision.Branch s M))).Free G := by
  intro h
  exact hf ((show FullRootedPower.graph (graph [2,s]) M ⊑
    ProjectionHeavy.subdivision (⊤ : SimpleGraph (BushSubdivision.Branch s M)) from
      ⟨BushSubdivision.copy s M⟩).trans h)

/-- An unconditional fourth-walk row bound for every bush-power-free host. -/
theorem free_fourth_row_bound (s M : ℕ) (hM : 1 ≤ M)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (graph [2,s]) M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) (u : W) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ momentCoefficient s M*D^2 := by
  have hc : 2 ≤ Fintype.card (BushSubdivision.Branch s M) := by
    simp only [BushSubdivision.Branch, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
    omega
  exact HostHeavyShadow.subdivision_free_row_bound _ hc G
    (complete_subdivision_free s M G hf) D hD hdeg u

lemma fourth_entries_of_row_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ T) (u v : W) :
    0 ≤ ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ∧
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤ T := by
  let A := G.adjMatrix ℝ
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A, SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hN := chain_nonneg hA hA
  have hs : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  refine ⟨chain_nonneg hN hN u v, ?_⟩
  have h := kernel_entry_le_of_rows (A*A) T hT hrow u v
  simpa only [hs.eq] using h

open Classical in
/-- Hub pin energy only needs fourth-walk row control, not individual
codegree bounds. -/
theorem hub_pin_bound_of_fourth_rows (G : SimpleGraph W) [DecidableRel G.Adj]
    (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ T)
    (s : ℕ) (i : Fin 2) :
    (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ)^2 ≤
      Fintype.card W*T^(2*s+1)*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let F := branch (A*A) s
  have hK : F*F.transpose=entryPower Q s := short_branchKernel A G.isSymm_adjMatrix s
  have hr (u : W) : ∑ r, (F u r)^2 ≤ T^s := by
    have he : (∑ r, (F u r)^2)=(F*F.transpose) u u := by
      simp only [Matrix.mul_apply, Matrix.transpose_apply, pow_two]
    rw [he, hK]
    exact pow_le_pow_left₀ (fourth_entries_of_row_bound G T hT hrow u u).1
      (fourth_entries_of_row_bound G T hT hrow u u).2 s
  have h := diagonal_hub_bound A F (T^s) hr
  rw [hK] at h
  rw [bilateral_hub_pin_card, bilateral_agreement_card]
  change conjugationInner A (diagonal (fun u => (Q u u)^s)) (entryPower Q s)^2 ≤
    Fintype.card W*T^(2*s+1)*bilateralEnergy A Q s
  have hN : squareMass (A.transpose*A) ≤ Fintype.card W*T := by
    rw [G.isSymm_adjMatrix]
    exact (sum_le_sum (fun u _ => hrow u)).trans_eq (by simp)
  have hE : squareMass ((A*F).transpose*(A*F))=bilateralEnergy A Q s :=
    (bilateral_as_columnGram A G.isSymm_adjMatrix s).symm
  calc
    _ ≤ (T^s)^2*squareMass (A.transpose*A)*squareMass ((A*F).transpose*(A*F)) := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*squareMass ((A*F).transpose*(A*F)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hN (sq_nonneg _)) (squareMass_nonneg _)
    _ = _ := by
      rw [hE, ←pow_mul, show s*2=2*s by omega, pow_succ]
      ring

open Classical in
theorem center_pin_bound_of_fourth_rows (G : SimpleGraph W) [DecidableRel G.Adj]
    (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ T)
    (s : ℕ) (hs : 1 ≤ s) :
    (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ)^2 ≤
      Fintype.card W*T^(2*s+1)*(Fintype.card (Agreement G [2,s]) : ℝ) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let F := branch (A*A) s
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul, G.isSymm_adjMatrix]
  have hK (u v : W) : (F*F.transpose) u v=(Q u v)^s :=
    congrArg (fun B : Matrix W W ℝ => B u v) (short_branchKernel A G.isSymm_adjMatrix s)
  have hQT := fourth_entries_of_row_bound G T hT hrow
  have h := unmasked_center_pin_bound A G.isSymm_adjMatrix F Q s hs T T hT hrow
    (fun u v => (hQT u v).1) (fun u v => (hQT u v).2)
    (fun u v => by rw [hAA]) hK
  have hpow : T*T^(s-1)=T^s := by rw [←pow_succ']; congr 1; omega
  rw [hpow] at h
  rw [bilateral_center_pin_card, bilateral_agreement_card]
  change (∑ z, (∑ x, ((A*F) z x)^2)^2)^2 ≤ Fintype.card W*T^(2*s+1)*bilateralEnergy A Q s
  have hN : squareMass (A*A) ≤ Fintype.card W*T :=
    (sum_le_sum (fun u _ => hrow u)).trans_eq (by simp)
  have hE : squareMass ((A*F).transpose*(A*F))=bilateralEnergy A Q s :=
    (bilateral_as_columnGram A G.isSymm_adjMatrix s).symm
  calc
    _ ≤ (T^s)^2*squareMass (A*A)*squareMass ((A*F).transpose*(A*F)) := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*squareMass ((A*F).transpose*(A*F)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hN (sq_nonneg _)) (squareMass_nonneg _)
    _ = _ := by
      rw [hE, ←pow_mul, show s*2=2*s by omega, pow_succ]
      ring

open Classical in
theorem free_hub_pin_bound (s M : ℕ) (hM : 1 ≤ M)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (graph [2,s]) M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) (i : Fin 2) :
    (Fintype.card (Pinned G [2,s] (some (i,anchor [s]))) : ℝ)^2 ≤
      Fintype.card W*(momentCoefficient s M*D^2)^(2*s+1)*
        (Fintype.card (Agreement G [2,s]) : ℝ) :=
  hub_pin_bound_of_fourth_rows G _ (mul_nonneg (momentCoefficient_nonneg s M) (sq_nonneg D))
    (free_fourth_row_bound s M hM G hf D hD hdeg) s i

open Classical in
theorem free_center_pin_bound (s M : ℕ) (hs : 1 ≤ s) (hM : 1 ≤ M)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (graph [2,s]) M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) :
    (Fintype.card (Pinned G [2,s] (anchor [2,s])) : ℝ)^2 ≤
      Fintype.card W*(momentCoefficient s M*D^2)^(2*s+1)*
        (Fintype.card (Agreement G [2,s]) : ℝ) :=
  center_pin_bound_of_fourth_rows G _ (mul_nonneg (momentCoefficient_nonneg s M) (sq_nonneg D))
    (free_fourth_row_bound s M hM G hf D hD hdeg) s hs

end Erdos571.LayeredBush

/-! Uniform retention of light two-walks from the freeness-aware fourth moment. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LightArmKernel
open Finset SimpleGraph Matrix GramFeatures
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def trim (P : Matrix W W ℝ) (L : ℝ) : Matrix W W ℝ :=
  fun u v => if u ≠ v ∧ P u v ≤ L then P u v else 0

lemma trim_nonneg (P : Matrix W W ℝ) (hP : ∀ u v, 0 ≤ P u v) (L : ℝ) (u v : W) :
    0 ≤ trim P L u v := by
  classical
  unfold trim
  split_ifs
  · exact hP u v
  · exact le_rfl

lemma trim_le (P : Matrix W W ℝ) (hP : ∀ u v, 0 ≤ P u v) (L : ℝ) (u v : W) :
    trim P L u v ≤ P u v := by
  classical
  unfold trim
  split_ifs
  · exact le_rfl
  · exact hP u v

lemma trim_cap (P : Matrix W W ℝ) (L : ℝ) (hL : 0 ≤ L) (u v : W) :
    trim P L u v ≤ L := by
  classical
  unfold trim
  split_ifs with h
  · exact h.2
  · exact hL

@[simp] lemma trim_diag (P : Matrix W W ℝ) (L : ℝ) (u : W) : trim P L u u=0 := by
  simp [trim]

lemma trim_symm (P : Matrix W W ℝ) (hP : P.IsSymm) (L : ℝ) : (trim P L).IsSymm := by
  classical
  apply Matrix.IsSymm.ext
  intro u v
  simp only [trim, hP.apply u v, ne_comm]

lemma trim_loss (P : Matrix W W ℝ) (hP : ∀ u v, 0 ≤ P u v)
    (L D : ℝ) (hL : 0 ≤ L) (hdiag : ∀ u, P u u ≤ D) (u v : W) :
    L*P u v ≤ L*trim P L u v + (P u v)^2 + if u=v then L*D else 0 := by
  classical
  by_cases he : u=v
  · subst v
    rw [trim_diag, if_pos rfl, mul_zero, zero_add]
    exact (mul_le_mul_of_nonneg_left (hdiag u) hL).trans (le_add_of_nonneg_left (sq_nonneg _))
  · rw [if_neg he, add_zero]
    by_cases hb : P u v ≤ L
    · rw [trim, if_pos ⟨he,hb⟩]
      exact le_add_of_nonneg_right (sq_nonneg _)
    · simp only [trim, hb, and_false, ite_false, mul_zero, zero_add]
      nlinarith [mul_nonneg (hP u v) (sub_nonneg.mpr (le_of_lt (lt_of_not_ge hb)))]

/-- A row-wise second-moment bound makes the truncation loss uniform. -/
theorem trim_row_lower (P : Matrix W W ℝ) (hP : ∀ u v, 0 ≤ P u v)
    (L D T b : ℝ) (hL : 0 < L)
    (hdiag : ∀ u, P u u ≤ D)
    (hrow : ∀ u, b ≤ ∑ v, P u v)
    (hmoment : ∀ u, (∑ v, (P u v)^2) ≤ T)
    (hD : 4*D ≤ b) (hT : 4*T ≤ L*b) (u : W) :
    b/2 ≤ ∑ v, trim P L u v := by
  have hsum := sum_le_sum (fun v (_ : v∈univ) => trim_loss P hP L D hL.le hdiag u v)
  simp only [sum_add_distrib, ←mul_sum, sum_ite_eq, mem_univ, if_true] at hsum
  have hlow := mul_le_mul_of_nonneg_left (hrow u) hL.le
  have hdiag' := mul_le_mul_of_nonneg_left hD hL.le
  have hm := hmoment u
  nlinarith

variable (G : SimpleGraph W) [DecidableRel G.Adj]
noncomputable def matrix (L : ℝ) : Matrix W W ℝ := trim (G.adjMatrix ℝ * G.adjMatrix ℝ) L

lemma square_nonneg (u v : W) : 0 ≤ (G.adjMatrix ℝ * G.adjMatrix ℝ) u v := by
  apply chain_nonneg
  all_goals intro x y; dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num

lemma nonneg (L : ℝ) (u v : W) : 0 ≤ matrix G L u v := trim_nonneg _ (square_nonneg G) L u v
lemma le_square (L : ℝ) (u v : W) : matrix G L u v ≤ (G.adjMatrix ℝ * G.adjMatrix ℝ) u v :=
  trim_le _ (square_nonneg G) L u v
lemma cap (L : ℝ) (hL : 0 ≤ L) (u v : W) : matrix G L u v ≤ L := trim_cap _ L hL u v
@[simp] lemma diagonal (L : ℝ) (u : W) : matrix G L u u=0 := trim_diag _ L u

lemma isSymm (L : ℝ) : (matrix G L).IsSymm := by
  apply trim_symm
  show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ
  rw [Matrix.transpose_mul, SimpleGraph.transpose_adjMatrix]

lemma le_entry_square (L : ℝ) (u v : W) : matrix G L u v ≤ (matrix G L u v)^2 := by
  classical
  unfold matrix trim
  split_ifs
  · rw [LayeredBush.adjacency_square_common_card]
    simpa only [pow_two, Nat.cast_mul] using
      (show (Fintype.card (G.commonNeighbors u v):ℝ) ≤
        (Fintype.card (G.commonNeighbors u v):ℝ)*(Fintype.card (G.commonNeighbors u v):ℝ) by
          exact_mod_cast Nat.le_mul_self (Fintype.card (G.commonNeighbors u v)))
  · norm_num

lemma gram_diagonal_lower (L : ℝ) (u : W) :
    (∑ v, matrix G L u v) ≤ (matrix G L*(matrix G L).transpose) u u := by
  simpa only [Matrix.mul_apply, Matrix.transpose_apply, ←pow_two] using
    sum_le_sum (fun v _ => le_entry_square G L u v)

lemma row_upper (L D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u : ℝ) ≤ D) (u : W) :
    (∑ v, matrix G L u v) ≤ D^2 := by
  have hr (u : W) : ∑ v, G.adjMatrix ℝ u v ≤ D := by
    have he : (∑ v, G.adjMatrix ℝ u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hdeg u
  have hA (u v : W) : 0 ≤ G.adjMatrix ℝ u v := by
    dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  exact (sum_le_sum (fun v _ => le_square G L u v)).trans
    (by simpa only [pow_two] using chain_row_upper hA hD hr hr u)

/-- The minimum retained row mass needs only the degree and fourth-moment
bounds, together with two explicit numerical inequalities. -/
theorem row_lower (L D T d : ℝ) (hL : 0 < L) (hd : 0 ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u : ℝ)) (hmax : ∀ u, (G.degree u : ℝ) ≤ D)
    (hmoment : ∀ u, (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ T)
    (hD : 4*D ≤ d^2) (hT : 4*T ≤ L*d^2) (u : W) :
    d^2/2 ≤ ∑ v, matrix G L u v := by
  have hr (u : W) : d ≤ ∑ v, G.adjMatrix ℝ u v := by
    have he : (∑ v, G.adjMatrix ℝ u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hmin u
  have hA (u v : W) : 0 ≤ G.adjMatrix ℝ u v := by
    dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  apply trim_row_lower _ (square_nonneg G) L D T (d^2) hL
    (fun u => (G.adjMatrix_mul_self_apply_self u).le.trans (hmax u))
    (fun u => by simpa only [pow_two] using chain_row_lower hA hd hr hr u)
    hmoment hD hT

/-- Trimming arm endpoints does not enlarge the fourth-walk Gram matrix. -/
lemma gram_le_fourth (L : ℝ) (u v : W) :
    (matrix G L*(matrix G L).transpose) u v ≤
      ((G.adjMatrix ℝ * G.adjMatrix ℝ).transpose*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v := by
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ
    rw [Matrix.transpose_mul, SimpleGraph.transpose_adjMatrix]
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  apply sum_le_sum
  intro x _
  change matrix G L u x * matrix G L v x ≤
    (G.adjMatrix ℝ * G.adjMatrix ℝ) x u * (G.adjMatrix ℝ * G.adjMatrix ℝ) x v
  rw [hs.apply u x, hs.apply v x]
  exact mul_le_mul (le_square G L u x) (le_square G L v x)
    (nonneg G L v x) (square_nonneg G u x)

lemma gram_nonneg (L : ℝ) (u v : W) : 0 ≤ (matrix G L*(matrix G L).transpose) u v :=
  chain_nonneg (nonneg G L) (fun x y => nonneg G L y x) u v

lemma gram_upper (L T : ℝ) (hT : 0 ≤ T)
    (hmoment : ∀ u, (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ T) (u v : W) :
    (matrix G L*(matrix G L).transpose) u v ≤ T := by
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ
    rw [Matrix.transpose_mul, SimpleGraph.transpose_adjMatrix]
  exact (gram_le_fourth G L u v).trans (by
    rw [hs]; exact (LayeredBush.fourth_entries_of_row_bound G T hT hmoment u v).2)

/-- Uniform row retention in an almost-regular bush-power-free host. -/
theorem free_row_lower (s M : ℕ) (hM : 1 ≤ M)
    (hf : (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G)
    (L K d : ℝ) (hL : 0 < L) (hK : 1 ≤ K) (hd : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u : ℝ)) (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (hcut : 4*LayeredBush.momentCoefficient s M*K^2 ≤ L) (u : W) :
    d^2/2 ≤ ∑ v, matrix G L u v := by
  have hK0 : 0 ≤ K := by linarith
  have hd0 : 0 ≤ d := by linarith
  apply row_lower G L (K*d) (LayeredBush.momentCoefficient s M*(K*d)^2) d
    hL hd0 hmin hmax
    (LayeredBush.free_fourth_row_bound s M hM G hf (K*d) (mul_nonneg hK0 hd0) hmax)
  · nlinarith [mul_nonneg hd0 (sub_nonneg.mpr hd)]
  · nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]

/-- The same retained mass supplies a lower diagonal bound for the arm Gram. -/
theorem free_gram_diagonal_lower (s M : ℕ) (hM : 1 ≤ M)
    (hf : (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G)
    (L K d : ℝ) (hL : 0 < L) (hK : 1 ≤ K) (hd : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u : ℝ)) (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (hcut : 4*LayeredBush.momentCoefficient s M*K^2 ≤ L) (u : W) :
    d^2/2 ≤ (matrix G L*(matrix G L).transpose) u u :=
  (free_row_lower G s M hM hf L K d hL hK hd hmin hmax hcut u).trans
    (gram_diagonal_lower G L u)

end Erdos571.LightArmKernel

/-! Bilateral energy and major pins with a separately chosen arm kernel. -/
set_option maxHeartbeats 3000000
namespace Erdos571.GramPin
open Finset Matrix GramFeatures
variable {U : Type*} [Fintype U] [DecidableEq U]

lemma arm_branch_gram (N : Matrix U U ℝ) (s : ℕ) :
    branch N s*(branch N s).transpose=entryPower (N*N.transpose) s := by
  ext u v
  exact kernel_branch N s u v

lemma arm_bilateral_as_columnGram (A N : Matrix U U ℝ) (s : ℕ) :
    bilateralEnergy A (N*N.transpose) s =
      squareMass ((A*branch N s).transpose*(A*branch N s)) := by
  rw [←gram_squareMass (A*branch N s)]
  have he : (A*branch N s)*(A*branch N s).transpose=
      A*(branch N s*(branch N s).transpose)*A.transpose := by
    simp only [Matrix.transpose_mul, Matrix.mul_assoc]
  rw [he, arm_branch_gram]
  rfl

/-- Only row mass is needed to retain the sharp bilateral energy. -/
theorem arm_bilateral_lower (A N : Matrix U U ℝ) (hA : ∀ u v, 0 ≤ A u v)
    (d b : ℝ) (hd : 0 ≤ d) (hb : 0 ≤ b)
    (hrowA : ∀ u, d ≤ ∑ v, A u v) (hrowN : ∀ u, b ≤ ∑ v, N u v) (s : ℕ) :
    (Fintype.card U : ℝ)^2*(d*b^s)^4 ≤
      (Fintype.card U : ℝ)^(2*s)*bilateralEnergy A (N*N.transpose) s := by
  have hF (u : U) : b^s ≤ ∑ r, branch N s u r := by
    rw [branch_row_sum]
    exact pow_le_pow_left₀ hb (hrowN u) s
  have hB := chain_row_lower hA (pow_nonneg hb s) hrowA hF
  have h := columnGram_energy_lower (A*branch N s) (d*b^s)
    (mul_nonneg hd (pow_nonneg hb s)) hB
  have hc : (Fintype.card (Fin s → U) : ℝ)^2=(Fintype.card U : ℝ)^(2*s) := by
    simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow, ←pow_mul]
    congr 1
    omega
  rw [hc, ←arm_bilateral_as_columnGram A N s] at h
  exact h

/-- Hub pin control survives arm-endpoint truncation. -/
theorem arm_hub_bound (A N : Matrix U U ℝ) (T : ℝ)
    (hQT : ∀ u v, (N*N.transpose) u v ≤ T) (s : ℕ) :
    (conjugationInner A (diagonal (fun u => ((N*N.transpose) u u)^s))
      (entryPower (N*N.transpose) s))^2 ≤
      (T^s)^2*squareMass (A.transpose*A)*bilateralEnergy A (N*N.transpose) s := by
  have hr (u : U) : ∑ r, (branch N s u r)^2 ≤ T^s := by
    have he : (∑ r, (branch N s u r)^2)=(branch N s*(branch N s).transpose) u u := by
      simp only [Matrix.mul_apply, Matrix.transpose_apply, pow_two]
    rw [he, arm_branch_gram]
    apply pow_le_pow_left₀ _ (hQT u u) s
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    exact sum_nonneg (fun v _ => mul_self_nonneg _)
  have h := diagonal_hub_bound A (branch N s) (T^s) hr
  rw [arm_branch_gram, ←arm_bilateral_as_columnGram A N s] at h
  exact h

/-- The center bound needs a comparison of the arm Gram to the unmasked
fourth-walk matrix; it does not need the arms themselves to be unmasked. -/
theorem arm_center_bound (A N : Matrix U U ℝ) (hA : A.IsSymm)
    (hN : ∀ u v, 0 ≤ N u v) (s : ℕ) (hs : 1 ≤ s) (C T : ℝ) (hC : 0 ≤ C)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ C)
    (hQT : ∀ u v, (N*N.transpose) u v ≤ T)
    (hchain : ∀ u v, (N*N.transpose) u v ≤ ((A*A).transpose*(A*A)) u v) :
    (∑ u, (∑ x, ((A*branch N s) u x)^2)^2)^2 ≤
      (C*T^(s-1))^2*squareMass (A*A)*bilateralEnergy A (N*N.transpose) s := by
  have h := unmasked_center_pin_bound A hA (branch N s) (N*N.transpose) s hs C T
    hC hr (chain_nonneg hN (fun u v => hN v u)) hQT hchain
    (fun u v => congrArg (fun P : Matrix U U ℝ => P u v) (arm_branch_gram N s))
  rw [←arm_bilateral_as_columnGram A N s] at h
  exact h

end Erdos571.GramPin

/-! A light-pair restriction for actual fixed-label quadratic counts. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HeavyFiberRestriction
open Finset SimpleGraph
variable {I W R : Type} [Fintype I] [Fintype W] [Fintype R]

lemma cliqueFree_comap (K : SimpleGraph W) (e : I → W) (k : ℕ)
    (hK : K.CliqueFree k) : (K.comap e).CliqueFree k := by
  classical
  intro S hS
  have hinj : Set.InjOn e S := by
    intro i hi j hj he
    by_contra hne
    have ha := hS.isClique hi hj hne
    change K.Adj (e i) (e j) at ha
    exact ha.ne he
  apply hK (S.image e)
  refine ⟨?_, ?_⟩
  · intro u hu v hv huv
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    obtain ⟨j,hj,rfl⟩ := mem_image.mp hv
    exact hS.isClique hi hj (fun he => huv (congrArg e he))
  · rw [card_image_of_injOn hinj]
    exact hS.card_eq

open Classical in
/-- Weighted Turán may be applied to a role map, even when it is far from
injective. Equal-image pairs remain among the retained pairs. -/
theorem weighted_role (K : SimpleGraph W) (e : I → W) (k : ℕ) (hk : 2 ≤ k)
    (hK : K.CliqueFree k) (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) :
    (∑ i, w i)^2 ≤ (k-1:ℕ)*∑ i, ∑ j, if ¬K.Adj (e i) (e j) then w i*w j else 0 :=
  HeavyCliqueMoments.weighted_nonadj (K.comap e) k hk (cliqueFree_comap K e k hK) w hw

open Classical in
theorem weighted_fibers (K : SimpleGraph W) (e : I → W) (label : I → R)
    (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k) (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) :
    (∑ r, (∑ i, if label i=r then w i else 0)^2) ≤
      (k-1:ℕ)*∑ i, ∑ j, if label i=label j ∧ ¬K.Adj (e i) (e j) then w i*w j else 0 := by
  classical
  have h := sum_le_sum (fun r (_ : r∈univ) => weighted_role K e k hk hK
    (fun i => if label i=r then w i else 0) (fun i => by dsimp only; split_ifs <;> simp_all))
  simp only [←mul_sum] at h
  apply h.trans_eq
  congr 1
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  rw [sum_comm]
  apply sum_congr rfl
  intro j _
  by_cases he : label i=label j
  · by_cases ha : K.Adj (e i) (e j)
    · simp [ha]
    · simp [ha, he]
  · simp only [he, false_and, ite_false]
    apply sum_eq_zero
    intro r _
    by_cases hi : label i=r <;> by_cases hj : label j=r
    · exact False.elim (he (hi.trans hj.symm))
    all_goals simp [hi,hj]

open Classical in
/-- Cardinal version, phrased on a sigma family to fit the assignment model. -/
theorem family_pairs (F : R → Type) [∀ r, Fintype (F r)]
    (K : SimpleGraph W) (e : Sigma F → W) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k) :
    Fintype.card (FiberRestrictionEnergy.Agreement F) ≤
      (k-1)*Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ ¬K.Adj (e p.1) (e p.2)} := by
  classical
  have h := weighted_fibers K e Sigma.fst k hk hK (fun _ => (1:ℝ)) (by simp)
  rw [Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv F)]
  simp only [Fintype.card_sigma, Fintype.card_prod]
  have hL : (∑ r, (∑ i : Sigma F, if i.1=r then (1:ℝ) else 0)^2) =
      ((∑ r, Fintype.card (F r)*Fintype.card (F r):ℕ):ℝ) := by
    simp only [Fintype.sum_sigma, Nat.cast_sum, Nat.cast_mul]
    apply sum_congr rfl
    intro r _
    have he (x : R) : (∑ _i : F x, if x=r then (1:ℝ) else 0)=
        if x=r then (Fintype.card (F x):ℝ) else 0 := by
      split_ifs <;> simp
    change (∑ x : R, ∑ _i : F x, if x=r then (1:ℝ) else 0)^2=_
    simp_rw [he]
    simp [pow_two]
  have hR : (∑ i : Sigma F, ∑ j : Sigma F,
      if i.1=j.1 ∧ ¬K.Adj (e i) (e j) then (1:ℝ)*1 else 0) =
      (Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ ¬K.Adj (e p.1) (e p.2)}:ℝ) := by
    rw [Fintype.card_subtype]
    simp only [←Finset.sum_boole, Fintype.sum_prod_type, mul_one]
  rw [hL,hR] at h
  exact_mod_cast h

open Classical in
/-- Separate the diagonal role-pairs from the light off-diagonal pairs. -/
theorem family_split (F : R → Type) [∀ r, Fintype (F r)]
    (K : SimpleGraph W) (e : Sigma F → W) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (Light : W → W → Prop) (hlight : ∀ u v, ¬K.Adj u v → u≠v → Light u v) :
    Fintype.card (FiberRestrictionEnergy.Agreement F) ≤ (k-1)*
      (Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ e p.1=e p.2} +
       Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ Light (e p.1) (e p.2)}) := by
  classical
  apply (family_pairs F K e k hk hK).trans
  apply Nat.mul_le_mul_left
  let P : (Sigma F)×(Sigma F) → Prop := fun p => p.1.1=p.2.1 ∧ e p.1=e p.2
  let Q : (Sigma F)×(Sigma F) → Prop := fun p => p.1.1=p.2.1 ∧ Light (e p.1) (e p.2)
  apply (Fintype.card_subtype_mono _ (fun p => P p ∨ Q p) ?_).trans (Fintype.card_subtype_or P Q)
  intro p hp
  by_cases he : e p.1=e p.2
  · exact Or.inl ⟨hp.1,he⟩
  · exact Or.inr ⟨hp.1,hlight _ _ hp.2 he⟩

variable [DecidableEq W]
open Classical in
/-- Bush-power freeness yields a uniform light-pair restriction for ANY
finite rooted family, not just for a particular assignment parametrization. -/
theorem bush_free_family_split (F : R → Type) [∀ r, Fintype (F r)]
    (G : SimpleGraph W) [DecidableRel G.Adj] (s M : ℕ) (hM : 1 ≤ M)
    (hf : (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G)
    (e : Sigma F → W) :
    Fintype.card (FiberRestrictionEnergy.Agreement F) ≤
      (Fintype.card (BushSubdivision.Branch s M)-1)*
      (Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ e p.1=e p.2} +
       Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ e p.1≠e p.2 ∧
         Fintype.card (G.commonNeighbors (e p.1) (e p.2)) ≤
           Fintype.card (BushSubdivision.Branch s M)+
             Nat.card (⊤ : SimpleGraph (BushSubdivision.Branch s M)).edgeSet}) := by
  classical
  let H := (⊤ : SimpleGraph (BushSubdivision.Branch s M))
  let t := Fintype.card (BushSubdivision.Branch s M)+Nat.card H.edgeSet
  let K := HostHeavyShadow.graph G univ t
  have hk : 2 ≤ Fintype.card (BushSubdivision.Branch s M) := by
    simp only [BushSubdivision.Branch,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hK : K.CliqueFree (Fintype.card (BushSubdivision.Branch s M)) :=
    HostHeavyShadow.cliqueFree_of_subdivision_free H G univ
      (LayeredBush.complete_subdivision_free s M G hf)
  have h := family_split F K e _ hk hK
    (fun u v => u≠v ∧ Fintype.card (G.commonNeighbors u v) ≤ t) (by
      intro u v hn hne
      refine ⟨hne, ?_⟩
      have hc : (FourthMoment.common G univ u v).card < t := by
        by_contra hh
        exact hn ⟨hne,le_of_not_gt hh⟩
      rw [HostHeavyShadow.common_univ_card] at hc
      exact hc.le)
  simpa only [t, H, ←Nat.card_eq_fintype_card] using h

end Erdos571.HeavyFiberRestriction

/-! Finite arm-masked assignments. The two bundles may have arbitrary finite
index sets, so deleting an arm produces another member of the same model. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmTensor
open Finset Matrix GramFeatures GramPin
variable {W : Type*} [Fintype W]
noncomputable def tensor (N : Matrix W W ℝ) (I : Type*) [Fintype I] [DecidableEq I] : Matrix W (I → W) ℝ :=
  fun u r => ∏ i, N u (r i)

lemma nonneg (N : Matrix W W ℝ) (hN : ∀ u v, 0 ≤ N u v) (I : Type*) [Fintype I] [DecidableEq I]
    (u : W) (r : I → W) : 0 ≤ tensor N I u r := prod_nonneg (fun i _ => hN u (r i))

lemma gram (N : Matrix W W ℝ) (I : Type*) [Fintype I] [DecidableEq I] (u v : W) :
    (tensor N I*(tensor N I).transpose) u v=((N*N.transpose) u v)^Fintype.card I := by
  simp only [Matrix.mul_apply,Matrix.transpose_apply,tensor]
  simp_rw [←Finset.prod_mul_distrib]
  rw [←Fintype.prod_sum (fun _ : I => fun r : W => N u r*N v r)]
  simp only [prod_const,card_univ]

lemma row_sum (N : Matrix W W ℝ) (I : Type*) [Fintype I] [DecidableEq I] (u : W) :
    (∑ r, tensor N I u r)=(∑ v, N u v)^Fintype.card I := by
  unfold tensor
  rw [←Fintype.prod_sum (fun _ : I => fun v : W => N u v)]
  simp only [prod_const,card_univ]

lemma mixed_total {R S : Type*} [Fintype R] [Fintype S]
    (B : Matrix W R ℝ) (C : Matrix W S ℝ) :
    (∑ r, ∑ t, (∑ u, B u r*C u t)^2) =
      ∑ u, ∑ v, (B*B.transpose) u v*(C*C.transpose) u v := by
  simp only [Matrix.mul_apply,Matrix.transpose_apply,pow_two,sum_mul_sum]
  rw [sum_comm]
  simp_rw [sum_comm (s := (univ : Finset R)) (t := (univ : Finset W))]
  rw [sum_comm]
  apply sum_congr rfl
  intro u _
  rw [sum_comm]
  apply sum_congr rfl
  intro v _
  rw [sum_comm]
  apply sum_congr rfl
  intro r _
  apply sum_congr rfl
  intro t _
  ring

lemma chain_gram [DecidableEq W] (A N : Matrix W W ℝ) (I : Type*) [Fintype I] [DecidableEq I] :
    (A*tensor N I)*(A*tensor N I).transpose=
      A*entryPower (N*N.transpose) (Fintype.card I)*A.transpose := by
  have h : tensor N I*(tensor N I).transpose=entryPower (N*N.transpose) (Fintype.card I) := by
    ext u v
    exact gram N I u v
  simp only [Matrix.transpose_mul,←Matrix.mul_assoc]
  rw [Matrix.mul_assoc A (tensor N I),h]

end Erdos571.ArmTensor

namespace Erdos571.MaskedBush
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

def Light (u r : W) : Prop := u≠r ∧ (G.adjMatrix ℝ * G.adjMatrix ℝ) u r ≤ L
abbrev Arm (u r : W) := PLift (Light G L u r) × G.commonNeighbors u r

noncomputable instance armFintype (u r : W) : Fintype (Arm G L u r) := by
  classical
  infer_instance

def middle {u r : W} (p : Arm G L u r) : W := p.2.val
lemma arm_left {u r : W} (p : Arm G L u r) : G.Adj u (middle G L p) := p.2.property.1
lemma arm_right {u r : W} (p : Arm G L u r) : G.Adj (middle G L p) r := p.2.property.2.symm
lemma arm_light {u r : W} (p : Arm G L u r) : Light G L u r := p.1.down
lemma arm_ext {u r : W} (p q : Arm G L u r) (h : middle G L p=middle G L q) : p=q :=
  Prod.ext (Subsingleton.elim _ _) (Subtype.ext h)

lemma card_arm (u r : W) : (Fintype.card (Arm G L u r):ℝ)=LightArmKernel.matrix G L u r := by
  classical
  simp only [Arm,Fintype.card_prod,Nat.cast_mul,LightArmKernel.matrix,LightArmKernel.trim]
  by_cases h : Light G L u r
  · rw [if_pos (show u≠r ∧ (G.adjMatrix ℝ * G.adjMatrix ℝ) u r ≤ L from h)]
    have hc : Fintype.card (PLift (Light G L u r))=1 := by
      haveI : Nonempty (PLift (Light G L u r)) := ⟨⟨h⟩⟩
      simpa only [Nat.card_eq_fintype_card] using (Nat.card_unique (α := PLift (Light G L u r)))
    rw [hc,Nat.cast_one,one_mul,LayeredBush.adjacency_square_common_card]
  · rw [if_neg (show ¬(u≠r ∧ (G.adjMatrix ℝ * G.adjMatrix ℝ) u r ≤ L) from h)]
    haveI : IsEmpty (PLift (Light G L u r)) := ⟨fun p => h p.down⟩
    rw [Fintype.card_eq_zero (α := PLift (Light G L u r)),Nat.cast_zero,zero_mul]

variable (I J : Type) [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
abbrev Bundle (u : W) (r : I → W) := (i : I) → Arm G L u (r i)
abbrev Side (x : W) (r : I → W) := (u : W) × (PLift (G.Adj x u) × Bundle G L I u r)
abbrev Roots := (I → W) × (J → W)
abbrev Fiber (r : Roots I J) := (x : W) × (Side G L I x r.1 × Side G L J x r.2)
abbrev Full := (r : Roots I J) × Fiber G L I J r

noncomputable instance bundleFintype (u : W) (r : I → W) : Fintype (Bundle G L I u r) := by
  classical
  infer_instance
noncomputable instance sideFintype (x : W) (r : I → W) : Fintype (Side G L I x r) := by
  classical
  infer_instance
noncomputable instance fiberFintype (r : Roots I J) : Fintype (Fiber G L I J r) := by
  classical
  infer_instance

lemma card_bundle (u : W) (r : I → W) : (Fintype.card (Bundle G L I u r):ℝ)=
    ArmTensor.tensor (LightArmKernel.matrix G L) I u r := by
  classical
  simp only [Bundle,Fintype.card_pi,Nat.cast_prod,card_arm,ArmTensor.tensor]

lemma card_side (x : W) (r : I → W) : (Fintype.card (Side G L I x r):ℝ)=
    (G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) I) x r := by
  classical
  simp only [Side,Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,
    LayeredAssignments.card_adj,card_bundle,Matrix.mul_apply]

lemma card_fiber (r : Roots I J) : (Fintype.card (Fiber G L I J r):ℝ)=
    ∑ x, (G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) I) x r.1 *
      (G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) J) x r.2 := by
  classical
  rw [Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,card_side]

abbrev Agreement := FiberRestrictionEnergy.Agreement (Fiber G L I J)

open Classical in
lemma agreement_card : (Fintype.card (Agreement G L I J):ℝ)=
    conjugationInner (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card I))
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card J)) := by
  classical
  rw [Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G L I J))]
  rw [Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,Nat.cast_pow,card_fiber,←pow_two,Fintype.sum_prod_type]
  rw [ArmTensor.mixed_total,ArmTensor.chain_gram,ArmTensor.chain_gram]
  rfl

open Classical in
lemma symmetric_agreement_card (s : ℕ) : (Fintype.card (Agreement G L (Fin s) (Fin s)):ℝ)=
    bilateralEnergy (G.adjMatrix ℝ)
      (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s := by
  rw [agreement_card]
  simp only [Fintype.card_fin,conjugationInner,bilateralEnergy,squareMass,pow_two]

end Erdos571.MaskedBush

/-! Deleting an arm, without changing any retained arm endpoint. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

def center (p : Full G L I J) : W := p.2.1
def leftHub (p : Full G L I J) : W := p.2.2.1.1
def rightHub (p : Full G L I J) : W := p.2.2.2.1
def leftRoot (p : Full G L I J) (i : I) : W := p.1.1 i
def rightRoot (p : Full G L I J) (j : J) : W := p.1.2 j
def leftMiddle (p : Full G L I J) (i : I) : W := middle G L (p.2.2.1.2.2 i)
def rightMiddle (p : Full G L I J) (j : J) : W := middle G L (p.2.2.2.2.2 j)

lemma center_adj_left (p : Full G L I J) : G.Adj (center G L p) (leftHub G L p) := p.2.2.1.2.1.down
lemma center_adj_right (p : Full G L I J) : G.Adj (center G L p) (rightHub G L p) := p.2.2.2.2.1.down
lemma left_hub_adj_middle (p : Full G L I J) (i : I) : G.Adj (leftHub G L p) (leftMiddle G L p i) :=
  arm_left G L (p.2.2.1.2.2 i)
lemma right_hub_adj_middle (p : Full G L I J) (j : J) : G.Adj (rightHub G L p) (rightMiddle G L p j) :=
  arm_left G L (p.2.2.2.2.2 j)
lemma left_middle_adj_root (p : Full G L I J) (i : I) : G.Adj (leftMiddle G L p i) (leftRoot G L p i) :=
  arm_right G L (p.2.2.1.2.2 i)
lemma right_middle_adj_root (p : Full G L I J) (j : J) : G.Adj (rightMiddle G L p j) (rightRoot G L p j) :=
  arm_right G L (p.2.2.2.2.2 j)
lemma left_light (p : Full G L I J) (i : I) : Light G L (leftHub G L p) (leftRoot G L p i) :=
  arm_light G L (p.2.2.1.2.2 i)
lemma right_light (p : Full G L I J) (j : J) : Light G L (rightHub G L p) (rightRoot G L p j) :=
  arm_light G L (p.2.2.2.2.2 j)

lemma full_ext (p q : Full G L I J) (hr : p.1=q.1)
    (hc : center G L p=center G L q)
    (hl : leftHub G L p=leftHub G L q) (hh : rightHub G L p=rightHub G L q)
    (hml : ∀ i, leftMiddle G L p i=leftMiddle G L q i)
    (hmr : ∀ j, rightMiddle G L p j=rightMiddle G L q j) : p=q := by
  rcases p with ⟨⟨r,t⟩,x,⟨u,hu,a⟩,⟨v,hv,b⟩⟩
  rcases q with ⟨⟨r',t'⟩,x',⟨u',hu',a'⟩,⟨v',hv',b'⟩⟩
  obtain ⟨rfl,rfl⟩ := Prod.mk.inj hr
  change x=x' at hc
  change u=u' at hl
  change v=v' at hh
  subst x'; subst u'; subst v'
  have ha : a=a' := by
    funext i
    exact arm_ext G L _ _ (hml i)
  have hb : b=b' := by
    funext j
    exact arm_ext G L _ _ (hmr j)
  subst a'; subst b'
  have hu0 : hu=hu' := Subsingleton.elim _ _
  have hv0 : hv=hv' := Subsingleton.elim _ _
  subst hu'; subst hv'
  rfl

abbrev Without (j : J) := {k : J // k≠j}

def deleteRight (j : J) (p : Full G L I J) : Full G L I (Without j) :=
  ⟨(p.1.1,fun k => p.1.2 k.val),p.2.1,p.2.2.1,
    p.2.2.2.1,p.2.2.2.2.1,fun k => p.2.2.2.2.2 k.val⟩

@[simp] lemma deleteRight_center (j : J) (p : Full G L I J) :
    center G L (deleteRight G L j p)=center G L p := rfl
@[simp] lemma deleteRight_leftHub (j : J) (p : Full G L I J) :
    leftHub G L (deleteRight G L j p)=leftHub G L p := rfl
@[simp] lemma deleteRight_rightHub (j : J) (p : Full G L I J) :
    rightHub G L (deleteRight G L j p)=rightHub G L p := rfl
@[simp] lemma deleteRight_leftMiddle (j : J) (p : Full G L I J) (i : I) :
    leftMiddle G L (deleteRight G L j p) i=leftMiddle G L p i := rfl
@[simp] lemma deleteRight_rightMiddle (j : J) (p : Full G L I J) (k : Without j) :
    rightMiddle G L (deleteRight G L j p) k=rightMiddle G L p k.val := rfl

lemma deleteRight_labels (j : J) (p q : Full G L I J) (hr : p.1=q.1) :
    (deleteRight G L j p).1=(deleteRight G L j q).1 := by
  exact congrArg (fun r : Roots I J => (r.1,fun k : Without j => r.2 k.val)) hr

/-- Retained data, the removed root and the removed middle determine the
original assignment. No root replacement or additional lightness is used. -/
lemma deleteRight_restore (j : J) (p q : Full G L I J)
    (he : deleteRight G L j p=deleteRight G L j q)
    (hr : rightRoot G L p j=rightRoot G L q j)
    (hm : rightMiddle G L p j=rightMiddle G L q j) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · exact congrArg (fun r : Roots I (Without j) => r.1) hlabel
    · funext k
      by_cases hk : k=j
      · subst k; exact hr
      · exact congrArg (fun r : Roots I (Without j) => r.2 ⟨k,hk⟩) hlabel
  · exact congrArg (fun t : Full G L I (Without j) => center G L t) he
  · exact congrArg (fun t : Full G L I (Without j) => leftHub G L t) he
  · exact congrArg (fun t : Full G L I (Without j) => rightHub G L t) he
  · intro i
    exact congrArg (fun t : Full G L I (Without j) => leftMiddle G L t i) he
  · intro k
    by_cases hk : k=j
    · subst k; exact hm
    · exact congrArg (fun t : Full G L I (Without j) => rightMiddle G L t ⟨k,hk⟩) he

lemma cross_collision_delete_inj (i : I) (j : J) (p q : Full G L I J)
    (hp : leftMiddle G L p i=rightMiddle G L p j)
    (hq : leftMiddle G L q i=rightMiddle G L q j)
    (he : deleteRight G L j p=deleteRight G L j q)
    (hr : rightRoot G L p j=rightRoot G L q j) : p=q := by
  apply deleteRight_restore G L j p q he hr
  exact hp.symm.trans ((congrArg (fun t : Full G L I (Without j) => leftMiddle G L t i) he).trans hq)

lemma same_collision_delete_inj (i j : J) (hij : i≠j) (p q : Full G L I J)
    (hp : rightMiddle G L p i=rightMiddle G L p j)
    (hq : rightMiddle G L q i=rightMiddle G L q j)
    (he : deleteRight G L j p=deleteRight G L j q)
    (hr : rightRoot G L p j=rightRoot G L q j) : p=q := by
  apply deleteRight_restore G L j p q he hr
  exact hp.symm.trans ((congrArg (fun t : Full G L I (Without j) => rightMiddle G L t ⟨i,hij⟩) he).trans hq)

end Erdos571.MaskedBush

/-! A quadratic deletion bound with a light common-neighbor fiber. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LightPairDeletion
open Finset SimpleGraph
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable (G : SimpleGraph W) [DecidableRel G.Adj]
variable (F : R → Type) (E : S → Type) [∀ r, Fintype (F r)] [∀ s, Fintype (E s)]

open Classical in
theorem pair_bound (d : Sigma F → Sigma E) (root role : Sigma F → W)
    (kept : Sigma E → W) (cap : ℕ)
    (hlabel : ∀ p q, p.1=q.1 → (d p).1=(d q).1)
    (hroot : ∀ p q, p.1=q.1 → root p=root q)
    (hrole : ∀ p, role p=kept (d p))
    (hadj : ∀ p, G.Adj (role p) (root p))
    (hinj : ∀ p q, d p=d q → root p=root q → p=q) :
    Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧
      Fintype.card (G.commonNeighbors (role p.1) (role p.2)) ≤ cap} ≤
        cap*Fintype.card (FiberRestrictionEnergy.Agreement E) := by
  classical
  let X := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧
    Fintype.card (G.commonNeighbors (role p.1) (role p.2)) ≤ cap}
  let Ext (p : FiberRestrictionEnergy.Agreement E) :=
    PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap) ×
      G.commonNeighbors (kept p.1.1) (kept p.1.2)
  let encode : X → Sigma Ext := fun p =>
    ⟨⟨(d p.1.1,d p.1.2),hlabel _ _ p.2.1⟩,
      ⟨by simpa only [←hrole] using p.2.2⟩,
      root p.1.1,
      by simpa only [←hrole] using hadj p.1.1,
      by simpa only [←hrole,hroot _ _ p.2.1] using hadj p.1.2⟩
  have hi : Function.Injective encode := by
    intro p q he
    have hd : (d p.1.1,d p.1.2)=(d q.1.1,d q.1.2) :=
      congrArg (fun t : Sigma Ext => t.1.val) he
    have hr : root p.1.1=root q.1.1 := congrArg (fun t : Sigma Ext => t.2.2.val) he
    apply Subtype.ext
    apply Prod.ext
    · exact hinj _ _ (Prod.mk.inj hd).1 hr
    · apply hinj _ _ (Prod.mk.inj hd).2
      exact (hroot _ _ p.2.1).symm.trans (hr.trans (hroot _ _ q.2.1))
  have hb (p : FiberRestrictionEnergy.Agreement E) : Fintype.card (Ext p) ≤ cap := by
    by_cases hc : Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap
    · have hpc : Fintype.card (PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap))=1 := by
        haveI : Nonempty (PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap)) := ⟨⟨hc⟩⟩
        simpa only [Nat.card_eq_fintype_card] using
          (Nat.card_unique (α := PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap)))
      simpa only [Ext,Fintype.card_prod,hpc,one_mul] using hc
    · haveI : IsEmpty (Ext p) := ⟨fun t => hc t.1.down⟩
      simp only [Fintype.card_eq_zero,zero_le]
  calc
    _ ≤ Fintype.card (Sigma Ext) := Fintype.card_le_of_injective encode hi
    _ = ∑ p, Fintype.card (Ext p) := Fintype.card_sigma
    _ ≤ ∑ _p : FiberRestrictionEnergy.Agreement E, cap := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp [Nat.mul_comm]

end Erdos571.LightPairDeletion

/-! Weighted light restriction followed by deletion bounds actual both-bad
energies, with the equal-role pairs charged directly to pins. -/
set_option maxHeartbeats 3000000
namespace Erdos571.RestrictionDeletion
open Finset SimpleGraph
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable (F : R → Type) [∀ r, Fintype (F r)] (P : Sigma F → Prop)

def forget (p : Sigma (FiberRestrictionEnergy.Restricted F P)) : Sigma F := ⟨p.1,p.2.val⟩

lemma forget_injective : Function.Injective (forget F P) := by
  rintro ⟨r,p,hp⟩ ⟨r',q,hq⟩ he
  change (⟨r,p⟩ : Sigma F)=⟨r',q⟩ at he
  cases he
  rfl

abbrev RolePin (role : Sigma F → W) :=
  {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ role p.1=role p.2}

def agreementEquiv : FiberRestrictionEnergy.Agreement (FiberRestrictionEnergy.Restricted F P) ≃
    FiberRestrictionEnergy.Both F P :=
  (FiberRestrictionEnergy.agreementEquiv (FiberRestrictionEnergy.Restricted F P)).trans
    (FiberRestrictionEnergy.bothEquiv F P).symm

open Classical in
lemma restricted_pin_le (role : Sigma F → W) :
    Nat.card (RolePin (FiberRestrictionEnergy.Restricted F P) (role ∘ forget F P)) ≤
      Nat.card (RolePin F role) := by
  classical
  let f : RolePin (FiberRestrictionEnergy.Restricted F P) (role ∘ forget F P) → RolePin F role :=
    fun p => ⟨(forget F P p.1.1,forget F P p.1.2),p.2⟩
  have hi : Function.Injective f := by
    intro p q he
    apply Subtype.ext
    exact Prod.ext ((forget_injective F P) (congrArg (fun z : RolePin F role => z.1.1) he))
      ((forget_injective F P) (congrArg (fun z : RolePin F role => z.1.2) he))
  simpa only [Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hi

variable (E : S → Type) [∀ s, Fintype (E s)]
variable (G : SimpleGraph W) [DecidableRel G.Adj]
open Classical in
/-- The diagonal term is charged to an existing pin, not to a new
codegree factor. All other terms are bounded by deleting one arm. -/
theorem collision_bound (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (d : Sigma F → Sigma E) (root role : Sigma F → W) (kept : Sigma E → W)
    (hlabel : ∀ p q, p.1=q.1 → (d p).1=(d q).1)
    (hroot : ∀ p q, p.1=q.1 → root p=root q)
    (hrole : ∀ p, P p → role p=kept (d p))
    (hadj : ∀ p, P p → G.Adj (role p) (root p))
    (hinj : ∀ p q, P p → P q → d p=d q → root p=root q → p=q) :
    Nat.card (FiberRestrictionEnergy.Both F P) ≤
      (k-1)*(Nat.card (RolePin F role) + cap*Nat.card (FiberRestrictionEnergy.Agreement E)) := by
  classical
  let F' := FiberRestrictionEnergy.Restricted F P
  let e := forget F P
  have hp : ∀ p : Sigma F', P (e p) := fun p => p.2.property
  have hl := LightPairDeletion.pair_bound G F' E (d ∘ e) (root ∘ e) (role ∘ e) kept cap
    (fun p q h => hlabel _ _ h) (fun p q h => hroot _ _ h)
    (fun p => hrole _ (hp p)) (fun p => hadj _ (hp p))
    (fun p q hd hr => (forget_injective F P) (hinj _ _ (hp p) (hp q) hd hr))
  have hs := HeavyFiberRestriction.family_split F' K (role ∘ e) k hk hK
    (fun u v => Fintype.card (G.commonNeighbors u v) ≤ cap) hlight
  have he : Nat.card (FiberRestrictionEnergy.Agreement F')=
      Nat.card (FiberRestrictionEnergy.Both F P) := Nat.card_congr (agreementEquiv F P)
  have hpin := restricted_pin_le F P role
  simp only [←Nat.card_eq_fintype_card] at hl hs
  rw [he] at hs
  apply hs.trans
  apply Nat.mul_le_mul_left
  exact Nat.add_le_add hpin hl

end Erdos571.RestrictionDeletion

/-! Actual same-branch and cross-branch terminal collisions are controlled
by pins and a one-arm-deleted agreement energy. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

abbrev CrossCollision (i : I) (j : J) := FiberRestrictionEnergy.Both (Fiber G L I J)
  (fun p => leftMiddle G L p i=rightMiddle G L p j)
abbrev RightCollision (i j : J) := FiberRestrictionEnergy.Both (Fiber G L I J)
  (fun p => rightMiddle G L p i=rightMiddle G L p j)
abbrev Pin (role : Full G L I J → W) := RestrictionDeletion.RolePin (Fiber G L I J) role

/-- No global codegree assumption is used: only light pairs in the shadow
contribute to the one-arm-deleted term. -/
theorem cross_attachment_bound (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : I) (j : J) :
    Nat.card (CrossCollision G L i j) ≤ (k-1)*
      (Nat.card (Pin G L (fun p : Full G L I J => leftMiddle G L p i)) +
        cap*Nat.card (Agreement G L I (Without j))) := by
  apply RestrictionDeletion.collision_bound (Fiber G L I J)
    (fun p => leftMiddle G L p i=rightMiddle G L p j) (Fiber G L I (Without j)) G K k cap hk hK hlight
    (deleteRight G L j) (fun p => rightRoot G L p j) (fun p => leftMiddle G L p i)
    (fun p => leftMiddle G L p i)
    (deleteRight_labels G L j) (fun p q h => congrArg (fun r : Roots I J => r.2 j) h)
    (fun _ _ => rfl)
  · intro p hp
    rw [hp]
    exact right_middle_adj_root G L p j
  · exact cross_collision_delete_inj G L i j

/-- The same deletion works for two distinct terminal positions in a single
bundle, since the other collided middle survives the deletion. -/
theorem right_attachment_bound (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i j : J) (hij : i≠j) :
    Nat.card (RightCollision G L (I := I) i j) ≤ (k-1)*
      (Nat.card (Pin G L (fun p : Full G L I J => rightMiddle G L p i)) +
        cap*Nat.card (Agreement G L I (Without j))) := by
  apply RestrictionDeletion.collision_bound (Fiber G L I J)
    (fun p => rightMiddle G L p i=rightMiddle G L p j) (Fiber G L I (Without j)) G K k cap hk hK hlight
    (deleteRight G L j) (fun p => rightRoot G L p j) (fun p => rightMiddle G L p i)
    (fun p => rightMiddle G L p ⟨i,hij⟩)
    (deleteRight_labels G L j) (fun p q h => congrArg (fun r : Roots I J => r.2 j) h)
    (fun _ _ => rfl)
  · intro p hp
    rw [hp]
    exact right_middle_adj_root G L p j
  · exact same_collision_delete_inj G L i j hij

abbrev CentralCollision (j : J) := FiberRestrictionEnergy.Both (Fiber G L I J)
  (fun p => center G L p=rightMiddle G L p j)

/-- Identifying the center with a terminal is handled by the same deletion:
the center survives, so the removed middle is still recoverable. -/
theorem central_attachment_bound (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (j : J) :
    Nat.card (CentralCollision G L (I := I) j) ≤ (k-1)*
      (Nat.card (Pin G L (center G L : Full G L I J → W)) +
        cap*Nat.card (Agreement G L I (Without j))) := by
  apply RestrictionDeletion.collision_bound (Fiber G L I J)
    (fun p => center G L p=rightMiddle G L p j) (Fiber G L I (Without j)) G K k cap hk hK hlight
    (deleteRight G L j) (fun p => rightRoot G L p j) (center G L)
    (center G L)
    (deleteRight_labels G L j) (fun p q h => congrArg (fun r : Roots I J => r.2 j) h)
    (fun _ _ => rfl)
  · intro p hp
    rw [hp]
    exact right_middle_adj_root G L p j
  · intro p q hp hq he hr
    apply deleteRight_restore G L j p q he hr
    exact hp.symm.trans ((congrArg (fun t : Full G L I (Without j) => center G L t) he).trans hq)

lemma card_without (j : J) : Fintype.card (Without j)=Fintype.card J-1 := by
  classical
  simpa only [Without,ne_eq] using Fintype.card_subtype_compl (fun k : J => k=j)

open Classical in
/-- Deleting an arm has precisely the expected mixed bilateral energy. -/
theorem deleted_agreement_card (s : ℕ) (j : Fin s) :
    (Nat.card (Agreement G L (Fin s) (Without j)):ℝ)=
      GramPin.conjugationInner (G.adjMatrix ℝ)
        (GramPin.entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s)
        (GramPin.entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (s-1)) := by
  simpa only [Nat.card_eq_fintype_card,card_without,Fintype.card_fin] using
    agreement_card G L (Fin s) (Without j)

end Erdos571.MaskedBush

/-! The arm-masked finite model consists of actual bush homomorphisms. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph LayeredTrees LayeredAssignments LayeredGramKernels
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

def sideAssignment (s : ℕ) {x : W} {r : Fin s → W} (p : Side G L (Fin s) x r) :
    (u : W) × (PLift (G.Adj x u) × Assignment G [s] u r) :=
  ⟨p.1,p.2.1,fun j => ⟨middle G L (p.2.2 j),⟨arm_left G L (p.2.2 j)⟩,⟨arm_right G L (p.2.2 j)⟩⟩⟩

def rootLabels (s : ℕ) (r : Roots (W := W) (Fin s) (Fin s)) : Labels W [2,s] :=
  fun i => if i=0 then r.1 else r.2

def oldFull (s : ℕ) (p : Full G L (Fin s) (Fin s)) : LayeredBush.Full G [2,s] :=
  ⟨rootLabels s p.1,p.2.1,fun i => by
    by_cases hi : i=0
    · change (u : W) × (PLift (G.Adj p.2.1 u) × Assignment G [s] u (if i=0 then p.1.1 else p.1.2))
      rw [if_pos hi]
      exact sideAssignment G L s p.2.2.1
    · change (u : W) × (PLift (G.Adj p.2.1 u) × Assignment G [s] u (if i=0 then p.1.1 else p.1.2))
      rw [if_neg hi]
      exact sideAssignment G L s p.2.2.2⟩

def hom (s : ℕ) (p : Full G L (Fin s) (Fin s)) : LayeredBush.graph [2,s] →g G :=
  LayeredBush.hom G [2,s] (oldFull G L s p)

@[simp] lemma hom_center (s : ℕ) (p : Full G L (Fin s) (Fin s)) :
    hom G L s p (.inl (anchor [2,s]))=center G L p := rfl
@[simp] lemma hom_leftHub (s : ℕ) (p : Full G L (Fin s) (Fin s)) :
    hom G L s p (.inl (some (0,anchor [s])))=leftHub G L p := rfl
@[simp] lemma hom_rightHub (s : ℕ) (p : Full G L (Fin s) (Fin s)) :
    hom G L s p (.inl (some (1,anchor [s])))=rightHub G L p := rfl
@[simp] lemma hom_leftMiddle (s : ℕ) (p : Full G L (Fin s) (Fin s)) (j : Fin s) :
    hom G L s p (.inl (some (0,some (j,()))))=leftMiddle G L p j := rfl
@[simp] lemma hom_rightMiddle (s : ℕ) (p : Full G L (Fin s) (Fin s)) (j : Fin s) :
    hom G L s p (.inl (some (1,some (j,()))))=rightMiddle G L p j := rfl
@[simp] lemma hom_leftRoot (s : ℕ) (p : Full G L (Fin s) (Fin s)) (j : Fin s) :
    hom G L s p (.inr (0,j,()))=leftRoot G L p j := rfl
@[simp] lemma hom_rightRoot (s : ℕ) (p : Full G L (Fin s) (Fin s)) (j : Fin s) :
    hom G L s p (.inr (1,j,()))=rightRoot G L p j := rfl

lemma hom_injective (s : ℕ) : Function.Injective (hom G L s) := by
  intro p q he
  apply full_ext G L p q
  · apply Prod.ext
    · funext j
      exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inr (0,j,()))) he
    · funext j
      exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inr (1,j,()))) he
  · exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inl (anchor [2,s]))) he
  · exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inl (some (0,anchor [s])))) he
  · exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inl (some (1,anchor [s])))) he
  · intro j
    exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inl (some (0,some (j,()))))) he
  · intro j
    exact congrArg (fun f : LayeredBush.graph [2,s] →g G => f (.inl (some (1,some (j,()))))) he

lemma same_roots (s : ℕ) (p q : Full G L (Fin s) (Fin s)) (hr : p.1=q.1) (r : Leaves [2,s]) :
    hom G L s p (.inr r)=hom G L s q (.inr r) := by
  exact congrArg (fun t : Roots (Fin s) (Fin s) => leafValue [2,s] (rootLabels s t) r) hr

open Classical in
/-- The ordinary root-power packing bound applies directly to these masked
homomorphisms; no assumption of injectivity of an individual assignment is made. -/
theorem freeness_pairs (s M : ℕ) (hM : 2 ≤ M)
    (hf : (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G) :
    Nat.card (Agreement G L (Fin s) (Fin s)) ≤ (M-1)*
      Nat.card {p : Full G L (Fin s) (Fin s)×Full G L (Fin s) (Fin s) //
        p.1.1=p.2.1 ∧ RootedHomEnergy.Conflict (hom G L s p.1) (hom G L s p.2)} := by
  classical
  have h := RootedHomEnergy.pair_bound (univ : Finset (Full G L (Fin s) (Fin s)))
    (hom G L s) Sigma.fst (fun p _ q _ hr => same_roots G L s p q hr) M hM hf
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
    PackingEnergy.pairs,true_and,and_true,univ_product_univ] using h

end Erdos571.MaskedBush

/-! Exact center and hub pin counts in the arm-masked assignment model. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmTensor
open Finset Matrix
variable {W I J : Type*} [Fintype W] [Fintype I] [Fintype J]
lemma pair_row_squares (B : Matrix W I ℝ) (C : Matrix W J ℝ) :
    (∑ r, ∑ t, ∑ u, (B u r*C u t)^2)=
      ∑ u, (∑ r, (B u r)^2)*(∑ t, (C u t)^2) := by
  simp only [mul_pow,sum_mul_sum]
  rw [sum_comm]
  simp_rw [sum_comm (s := (univ : Finset I)) (t := (univ : Finset W))]
  rw [sum_comm]
  apply sum_congr rfl
  intro u _
  rw [sum_comm]

end Erdos571.ArmTensor

namespace Erdos571.MaskedBush
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

abbrev MarkFiber (role : Full G L I J → W) (r : Roots I J) (w : W) :=
  {p : Fiber G L I J r // role ⟨r,p⟩=w}

open Classical in
lemma pin_card (role : Full G L I J → W) : (Nat.card (Pin G L role):ℝ)=
    ∑ r, ∑ w, (Fintype.card (MarkFiber G L role r w):ℝ)^2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (markedPairEquiv (Fiber G L I J) role)]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,←pow_two,Nat.cast_pow]

def centerMarkEquiv (r : Roots I J) (w : W) : MarkFiber G L (center G L) r w ≃
    (Side G L I w r.1 × Side G L J w r.2) where
  toFun p := by
    rcases p with ⟨⟨x,a,b⟩,he⟩
    change x=w at he
    subst x
    exact ⟨a,b⟩
  invFun p := ⟨⟨w,p⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,a,b⟩,he⟩
    change x=w at he
    subst x
    rfl
  right_inv _ := rfl

open Classical in
lemma centerMark_card (r : Roots I J) (w : W) : (Fintype.card (MarkFiber G L (center G L) r w):ℝ)=
    (G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) I) w r.1 *
      (G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) J) w r.2 := by
  rw [Fintype.card_congr (centerMarkEquiv G L r w)]
  simp only [Fintype.card_prod,Nat.cast_mul,card_side]

open Classical in
lemma center_pin_card : (Nat.card (Pin G L (center G L : Full G L I J → W)):ℝ)=
    ∑ u, (∑ r, ((G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) I) u r)^2)*
      (∑ t, ((G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) J) u t)^2) := by
  rw [pin_card]
  simp only [centerMark_card,Fintype.sum_prod_type]
  exact ArmTensor.pair_row_squares _ _

def rightMarkEquiv (r : Roots I J) (w : W) : MarkFiber G L (rightHub G L) r w ≃
    ((x : W) × (Side G L I x r.1 × PLift (G.Adj x w) × Bundle G L J w r.2)) where
  toFun p := by
    rcases p with ⟨⟨x,a,⟨u,hu,b⟩⟩,he⟩
    change u=w at he
    subst u
    exact ⟨x,a,hu,b⟩
  invFun p := ⟨⟨p.1,p.2.1,w,p.2.2⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,a,⟨u,hu,b⟩⟩,he⟩
    change u=w at he
    subst u
    rfl
  right_inv _ := rfl

open Classical in
lemma rightMark_card (r : Roots I J) (w : W) : (Fintype.card (MarkFiber G L (rightHub G L) r w):ℝ)=
    ((G.adjMatrix ℝ).transpose*(G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) I)) w r.1 *
      ArmTensor.tensor (LightArmKernel.matrix G L) J w r.2 := by
  rw [Fintype.card_congr (rightMarkEquiv G L r w),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,card_side,LayeredAssignments.card_adj,card_bundle]
  rw [Matrix.mul_apply,sum_mul]
  apply sum_congr rfl
  intro x _
  rw [Matrix.transpose_apply]
  ring

open Classical in
lemma right_pin_card : (Nat.card (Pin G L (rightHub G L : Full G L I J → W)):ℝ)=
    ∑ u, ((LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) u u)^Fintype.card J *
      (∑ r, (((G.adjMatrix ℝ).transpose*G.adjMatrix ℝ * ArmTensor.tensor (LightArmKernel.matrix G L) I) u r)^2) := by
  rw [pin_card]
  simp only [rightMark_card,Fintype.sum_prod_type]
  rw [ArmTensor.pair_row_squares]
  apply sum_congr rfl
  intro u _
  have h : (∑ r, (ArmTensor.tensor (LightArmKernel.matrix G L) J u r)^2)=
      ((LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) u u)^Fintype.card J := by
    simpa only [Matrix.mul_apply,Matrix.transpose_apply,pow_two] using
      ArmTensor.gram (LightArmKernel.matrix G L) J u u
  rw [h,Matrix.mul_assoc]
  ring

open Classical in
lemma symmetric_center_pin_card (s : ℕ) :
    (Nat.card (Pin G L (center G L : Full G L (Fin s) (Fin s) → W)):ℝ)=
      ∑ u, (∑ r, ((G.adjMatrix ℝ * branch (LightArmKernel.matrix G L) s) u r)^2)^2 := by
  rw [center_pin_card]
  simp only [pow_two]
  rfl

open Classical in
lemma symmetric_right_pin_card (s : ℕ) :
    (Nat.card (Pin G L (rightHub G L : Full G L (Fin s) (Fin s) → W)):ℝ)=
      conjugationInner (G.adjMatrix ℝ)
        (Matrix.diagonal (fun u => ((LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) u u)^s))
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [right_pin_card,←arm_branch_gram,diagonal_hub_identity]
  simp only [Fintype.card_fin]
  rfl

end Erdos571.MaskedBush

/-! The two arm bundles may be interchanged without changing the mask. -/
namespace Erdos571.MaskedBush
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

def swap (p : Full G L I J) : Full G L J I := ⟨p.1.swap,p.2.1,p.2.2.swap⟩
@[simp] lemma swap_swap (p : Full G L I J) : swap G L (swap G L p)=p := rfl
@[simp] lemma swap_center (p : Full G L I J) : center G L (swap G L p)=center G L p := rfl
@[simp] lemma swap_leftHub (p : Full G L I J) : leftHub G L (swap G L p)=rightHub G L p := rfl
@[simp] lemma swap_rightHub (p : Full G L I J) : rightHub G L (swap G L p)=leftHub G L p := rfl
@[simp] lemma swap_leftMiddle (p : Full G L I J) (j : J) : leftMiddle G L (swap G L p) j=rightMiddle G L p j := rfl
@[simp] lemma swap_rightMiddle (p : Full G L I J) (i : I) : rightMiddle G L (swap G L p) i=leftMiddle G L p i := rfl
@[simp] lemma swap_leftRoot (p : Full G L I J) (j : J) : leftRoot G L (swap G L p) j=rightRoot G L p j := rfl
@[simp] lemma swap_rightRoot (p : Full G L I J) (i : I) : rightRoot G L (swap G L p) i=leftRoot G L p i := rfl

def swapEquiv : Full G L I J ≃ Full G L J I where
  toFun := swap G L
  invFun := swap G L
  left_inv := swap_swap G L
  right_inv := swap_swap G L

def swapPinEquiv (role : Full G L J I → W) :
    Pin G L (role ∘ swap G L) ≃ Pin G L role where
  toFun p := ⟨(swap G L p.1.1,swap G L p.1.2),congrArg Prod.swap p.2.1,p.2.2⟩
  invFun p := ⟨(swap G L p.1.1,swap G L p.1.2),congrArg Prod.swap p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def swapAgreementEquiv : Agreement G L I J ≃ Agreement G L J I where
  toFun p := ⟨(swap G L p.1.1,swap G L p.1.2),congrArg Prod.swap p.2⟩
  invFun p := ⟨(swap G L p.1.1,swap G L p.1.2),congrArg Prod.swap p.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def swapBothEquiv (P : Full G L J I → Prop) :
    FiberRestrictionEnergy.Both (Fiber G L I J) (P ∘ swap G L) ≃
      FiberRestrictionEnergy.Both (Fiber G L J I) P where
  toFun p := ⟨(swap G L p.1.1,swap G L p.1.2),congrArg Prod.swap p.2.1,p.2.2⟩
  invFun p := ⟨(swap G L p.1.1,swap G L p.1.2),congrArg Prod.swap p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma left_pin_eq_right : Nat.card (Pin G L (leftHub G L : Full G L I J → W))=
    Nat.card (Pin G L (rightHub G L : Full G L J I → W)) :=
  Nat.card_congr (swapPinEquiv G L (rightHub G L))

end Erdos571.MaskedBush

/-! Actual major pin bounds and energy retention, with no global codegree cap. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

lemma right_pin_bound (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T) (s : ℕ) :
    (Nat.card (Pin G L (rightHub G L : Full G L (Fin s) (Fin s) → W)):ℝ)^2 ≤
      Fintype.card W*T^(2*s+1)*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) := by
  classical
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  have h := arm_hub_bound A N T (LightArmKernel.gram_upper G L T hT hrow) s
  have hm : squareMass (A.transpose*A) ≤ Fintype.card W*T := by
    rw [G.isSymm_adjMatrix]
    exact (sum_le_sum (fun u _ => hrow u)).trans_eq (by simp)
  rw [symmetric_right_pin_card]
  have he : (Nat.card (Agreement G L (Fin s) (Fin s)):ℝ)=bilateralEnergy A (N*N.transpose) s := by
    simpa only [Nat.card_eq_fintype_card] using symmetric_agreement_card G L s
  rw [he]
  calc
    _ ≤ (T^s)^2*squareMass (A.transpose*A)*bilateralEnergy A (N*N.transpose) s := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*bilateralEnergy A (N*N.transpose) s :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hm (sq_nonneg _)) (squareMass_nonneg _)
    _ = _ := by rw [←pow_mul,show s*2=2*s by omega,pow_succ]; ring

lemma center_pin_bound (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T) (s : ℕ) (hs : 1 ≤ s) :
    (Nat.card (Pin G L (center G L : Full G L (Fin s) (Fin s) → W)):ℝ)^2 ≤
      Fintype.card W*T^(2*s+1)*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) := by
  classical
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  have h := arm_center_bound A N G.isSymm_adjMatrix (LightArmKernel.nonneg G L) s hs T T hT hrow
    (LightArmKernel.gram_upper G L T hT hrow) (LightArmKernel.gram_le_fourth G L)
  have hp : T*T^(s-1)=T^s := by rw [←pow_succ']; congr 1; omega
  rw [hp] at h
  have hm : squareMass (A*A) ≤ Fintype.card W*T :=
    (sum_le_sum (fun u _ => hrow u)).trans_eq (by simp)
  rw [symmetric_center_pin_card]
  have he : (Nat.card (Agreement G L (Fin s) (Fin s)):ℝ)=bilateralEnergy A (N*N.transpose) s := by
    simpa only [Nat.card_eq_fintype_card] using symmetric_agreement_card G L s
  rw [he]
  calc
    _ ≤ (T^s)^2*squareMass (A*A)*bilateralEnergy A (N*N.transpose) s := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*bilateralEnergy A (N*N.transpose) s :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hm (sq_nonneg _)) (squareMass_nonneg _)
    _ = _ := by rw [←pow_mul,show s*2=2*s by omega,pow_succ]; ring

lemma left_pin_bound (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T) (s : ℕ) :
    (Nat.card (Pin G L (leftHub G L : Full G L (Fin s) (Fin s) → W)):ℝ)^2 ≤
      Fintype.card W*T^(2*s+1)*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) := by
  rw [left_pin_eq_right]
  exact right_pin_bound G L T hT hrow s

lemma energy_lower (d b : ℝ) (hd : 0 ≤ d) (hb : 0 ≤ b)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ))
    (hret : ∀ u, b ≤ ∑ v, LightArmKernel.matrix G L u v) (s : ℕ) :
    (Fintype.card W:ℝ)^2*(d*b^s)^4 ≤
      (Fintype.card W:ℝ)^(2*s)*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) := by
  classical
  have hA (u v : W) : 0 ≤ G.adjMatrix ℝ u v := by
    dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hr (u : W) : d ≤ ∑ v, G.adjMatrix ℝ u v := by
    have he : (∑ v, G.adjMatrix ℝ u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]; exact hmin u
  have h := arm_bilateral_lower (G.adjMatrix ℝ) (LightArmKernel.matrix G L) hA d b hd hb hr hret s
  simpa only [←symmetric_agreement_card G L s,←Nat.card_eq_fintype_card] using h

/-- The lower bound retains the sharp degree exponent and loses only a
constant factor, uniformly in every bush-power-free almost-regular host. -/
theorem free_energy_lower (s M : ℕ) (hM : 1 ≤ M)
    (hf : (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G)
    (K d : ℝ) (hL : 0 < L) (hK : 1 ≤ K) (hd : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u : ℝ)) (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (hcut : 4*LayeredBush.momentCoefficient s M*K^2 ≤ L) :
    (Fintype.card W:ℝ)^2*(d*(d^2/2)^s)^4 ≤
      (Fintype.card W:ℝ)^(2*s)*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) :=
  energy_lower G L d (d^2/2) (by linarith) (by positivity) hmin
    (LightArmKernel.free_row_lower G s M hM hf L K d hL hK hd hmin hmax hcut) s

end Erdos571.MaskedBush

/-! A light pair supports only boundedly many deleted two-edge arms. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LightPairDeletion
open Finset SimpleGraph
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable (G : SimpleGraph W) [DecidableRel G.Adj]
variable (F : R → Type) (E : S → Type) [∀ r, Fintype (F r)] [∀ s, Fintype (E s)]

open Classical in
theorem two_step_pair_bound (d : Sigma F → Sigma E) (middle root role : Sigma F → W)
    (kept : Sigma E → W) (cap D : ℕ) (hdeg : ∀ w, G.degree w ≤ D)
    (hlabel : ∀ p q, p.1=q.1 → (d p).1=(d q).1)
    (hmiddle : ∀ p q, p.1=q.1 → middle p=middle q)
    (hroot : ∀ p q, p.1=q.1 → root p=root q)
    (hrole : ∀ p, role p=kept (d p))
    (hadj : ∀ p, G.Adj (role p) (middle p))
    (hedge : ∀ p, G.Adj (middle p) (root p))
    (hinj : ∀ p q, d p=d q → middle p=middle q → root p=root q → p=q) :
    Fintype.card {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧
      Fintype.card (G.commonNeighbors (role p.1) (role p.2)) ≤ cap} ≤
        (cap*D)*Fintype.card (FiberRestrictionEnergy.Agreement E) := by
  classical
  let X := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧
    Fintype.card (G.commonNeighbors (role p.1) (role p.2)) ≤ cap}
  let Ext (p : FiberRestrictionEnergy.Agreement E) :=
    PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap) ×
      ((w : G.commonNeighbors (kept p.1.1) (kept p.1.2)) × G.neighborSet w.val)
  let encode : X → Sigma Ext := fun p =>
    ⟨⟨(d p.1.1,d p.1.2),hlabel _ _ p.2.1⟩,
      ⟨by simpa only [←hrole] using p.2.2⟩,
      ⟨middle p.1.1,by simpa only [←hrole] using hadj p.1.1,
        by simpa only [←hrole,hmiddle _ _ p.2.1] using hadj p.1.2⟩,
      ⟨root p.1.1,hedge p.1.1⟩⟩
  have hi : Function.Injective encode := by
    intro p q he
    have hd : (d p.1.1,d p.1.2)=(d q.1.1,d q.1.2) :=
      congrArg (fun t : Sigma Ext => t.1.val) he
    have hm : middle p.1.1=middle q.1.1 := congrArg (fun t : Sigma Ext => t.2.2.1.val) he
    have hr : root p.1.1=root q.1.1 := congrArg (fun t : Sigma Ext => t.2.2.2.val) he
    apply Subtype.ext
    apply Prod.ext
    · exact hinj _ _ (Prod.mk.inj hd).1 hm hr
    · apply hinj _ _ (Prod.mk.inj hd).2
      · exact (hmiddle _ _ p.2.1).symm.trans (hm.trans (hmiddle _ _ q.2.1))
      · exact (hroot _ _ p.2.1).symm.trans (hr.trans (hroot _ _ q.2.1))
  have hb (p : FiberRestrictionEnergy.Agreement E) : Fintype.card (Ext p) ≤ cap*D := by
    by_cases hc : Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap
    · have hpc : Fintype.card (PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap))=1 := by
        haveI : Nonempty (PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap)) := ⟨⟨hc⟩⟩
        simpa only [Nat.card_eq_fintype_card] using
          (Nat.card_unique (α := PLift (Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2)) ≤ cap)))
      simp only [Ext,Fintype.card_prod,hpc,one_mul,Fintype.card_sigma]
      calc
        _ ≤ ∑ _w : G.commonNeighbors (kept p.1.1) (kept p.1.2), D :=
          sum_le_sum (fun w _ => by simpa only [SimpleGraph.card_neighborSet_eq_degree] using hdeg w.val)
        _ = Fintype.card (G.commonNeighbors (kept p.1.1) (kept p.1.2))*D := by simp
        _ ≤ _ := Nat.mul_le_mul_right D hc
    · haveI : IsEmpty (Ext p) := ⟨fun t => hc t.1.down⟩
      simp only [Fintype.card_eq_zero,zero_le]
  calc
    _ ≤ Fintype.card (Sigma Ext) := Fintype.card_le_of_injective encode hi
    _ = ∑ p, Fintype.card (Ext p) := Fintype.card_sigma
    _ ≤ ∑ _p : FiberRestrictionEnergy.Agreement E, cap*D := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp [Nat.mul_comm]

end Erdos571.LightPairDeletion

/-! An extra prescribed role value is just another root-family label. -/
namespace Erdos571.MarkedFiberFamily
variable {R W : Type} [Fintype R] [Fintype W]
variable (F : R → Type) [∀ r, Fintype (F r)] (mark : Sigma F → W)

abbrev Fiber (r : R×W) := {p : F r.1 // mark ⟨r.1,p⟩=r.2}
def forget (p : Sigma (Fiber F mark)) : Sigma F := ⟨p.1.1,p.2.val⟩
lemma mark_forget (p : Sigma (Fiber F mark)) : mark (forget F mark p)=p.1.2 := p.2.property

lemma labels_eq (p q : Sigma (Fiber F mark)) (h : p.1=q.1) :
    (forget F mark p).1=(forget F mark q).1 := congrArg Prod.fst h
lemma marks_eq (p q : Sigma (Fiber F mark)) (h : p.1=q.1) :
    mark (forget F mark p)=mark (forget F mark q) :=
  (mark_forget F mark p).trans ((congrArg Prod.snd h).trans (mark_forget F mark q).symm)

lemma forget_injective : Function.Injective (forget F mark) := by
  rintro ⟨⟨r,w⟩,p,hp⟩ ⟨⟨r',w'⟩,q,hq⟩ he
  change (⟨r,p⟩ : Sigma F)=⟨r',q⟩ at he
  cases he
  have hw : w=w' := hp.symm.trans hq
  subst w'
  rfl

def agreementEquiv : FiberRestrictionEnergy.Agreement (Fiber F mark) ≃
    RestrictionDeletion.RolePin F mark where
  toFun p := ⟨(forget F mark p.1.1,forget F mark p.1.2),labels_eq F mark _ _ p.2,marks_eq F mark _ _ p.2⟩
  invFun p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,hr,he⟩
    change r=s at hr
    subst s
    exact ⟨(⟨(r,mark ⟨r,p⟩),p,rfl⟩,⟨(r,mark ⟨r,p⟩),q,he.symm⟩),rfl⟩
  left_inv p := by
    rcases p with ⟨⟨⟨⟨r,w⟩,p,hp⟩,⟨⟨s,v⟩,q,hq⟩⟩,he⟩
    have hrs : r=s := congrArg Prod.fst he
    have hwv : w=v := congrArg Prod.snd he
    subst s
    subst v
    apply Subtype.ext
    apply Prod.ext
    · apply forget_injective F mark
      rfl
    · apply forget_injective F mark
      rfl
  right_inv p := by
    rcases p with ⟨⟨⟨r,p⟩,⟨s,q⟩⟩,hr,he⟩
    change r=s at hr
    subst s
    rfl

lemma agreement_card : Nat.card (FiberRestrictionEnergy.Agreement (Fiber F mark))=
    Nat.card (RestrictionDeletion.RolePin F mark) := Nat.card_congr (agreementEquiv F mark)

open Classical in
lemma pin_le (role : Sigma F → W) :
    Nat.card (RestrictionDeletion.RolePin (Fiber F mark) (role ∘ forget F mark)) ≤
      Nat.card (RestrictionDeletion.RolePin F role) := by
  classical
  let f : RestrictionDeletion.RolePin (Fiber F mark) (role ∘ forget F mark) →
      RestrictionDeletion.RolePin F role := fun p =>
    ⟨(forget F mark p.1.1,forget F mark p.1.2),labels_eq F mark _ _ p.2.1,p.2.2⟩
  have hi : Function.Injective f := by
    intro p q he
    apply Subtype.ext
    exact Prod.ext ((forget_injective F mark) (congrArg (fun z : RestrictionDeletion.RolePin F role => z.1.1) he))
      ((forget_injective F mark) (congrArg (fun z : RestrictionDeletion.RolePin F role => z.1.2) he))
  simpa only [Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hi

end Erdos571.MarkedFiberFamily

/-! Light-shadow restriction bounds actual terminal pins without requiring
a pointwise global codegree cap. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

/-- The pin at a terminal either also pins its hub, or contributes at most
`cap * D` times the one-arm-deleted agreement energy. -/
theorem right_terminal_pin_bound (K : SimpleGraph W) (k cap D : ℕ)
    (hk : 2 ≤ k) (hK : K.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ D)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (j : J) :
    Nat.card (Pin G L (fun p : Full G L I J => rightMiddle G L p j)) ≤ (k-1)*
      (Nat.card (Pin G L (rightHub G L : Full G L I J → W)) +
        (cap*D)*Nat.card (Agreement G L I (Without j))) := by
  classical
  let F := Fiber G L I J
  let mark : Sigma F → W := fun p => rightMiddle G L p j
  let F' := MarkedFiberFamily.Fiber F mark
  let e := MarkedFiberFamily.forget F mark
  let E := Fiber G L I (Without j)
  have hlabel (p q : Sigma F') (h : p.1=q.1) : (e p).1=(e q).1 :=
    MarkedFiberFamily.labels_eq F mark p q h
  have hl := LightPairDeletion.two_step_pair_bound G F' E
    (deleteRight G L j ∘ e) (mark ∘ e) ((fun p => rightRoot G L p j) ∘ e)
    (rightHub G L ∘ e) (rightHub G L) cap D hdeg
    (fun p q h => deleteRight_labels G L j _ _ (hlabel p q h))
    (MarkedFiberFamily.marks_eq F mark)
    (fun p q h => congrArg (fun r : Roots I J => r.2 j) (hlabel p q h))
    (fun _ => rfl)
    (fun p => right_hub_adj_middle G L (e p) j)
    (fun p => right_middle_adj_root G L (e p) j)
    (fun p q hd hm hr => (MarkedFiberFamily.forget_injective F mark)
      (deleteRight_restore G L j (e p) (e q) hd hr hm))
  have hs := HeavyFiberRestriction.family_split F' K (rightHub G L ∘ e) k hk hK
    (fun u v => Fintype.card (G.commonNeighbors u v) ≤ cap) hlight
  have hp := MarkedFiberFamily.pin_le F mark (rightHub G L)
  have he := MarkedFiberFamily.agreement_card F mark
  simp only [←Nat.card_eq_fintype_card] at hl hs
  rw [he] at hs
  exact hs.trans (Nat.mul_le_mul_left _ (Nat.add_le_add hp hl))

end Erdos571.MaskedBush

/-! Repeated roots are bounded by deleting one arm. The light endpoint mask
makes each of the two deleted-middle fibers uniformly bounded. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

def castArm {u r t : W} (h : r=t) (p : Arm G L u r) : Arm G L u t := h ▸ p
lemma castArm_middle {u r t : W} (h : r=t) (p : Arm G L u r) :
    middle G L (castArm G L h p)=middle G L p := by subst t; rfl

lemma card_arm_cap (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) (u r : W) :
    Fintype.card (Arm G L u r) ≤ cap := by
  have h := (LightArmKernel.cap G L hL u r).trans hcap
  rw [←card_arm] at h
  exact_mod_cast h

/-- The kept root may lie in either bundle; no endpoint is replaced. -/
theorem prescribed_root_delete_bound (j : J) (kept : Full G L I (Without j) → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J)
      (fun p => rightRoot G L p j=kept (deleteRight G L j p))) ≤
        cap^2*Nat.card (Agreement G L I (Without j)) := by
  classical
  let X := FiberRestrictionEnergy.Both (Fiber G L I J)
    (fun p => rightRoot G L p j=kept (deleteRight G L j p))
  let E := Agreement G L I (Without j)
  let Ext (p : E) := Arm G L (rightHub G L p.1.1) (kept p.1.1) ×
    Arm G L (rightHub G L p.1.2) (kept p.1.2)
  let encode : X → Sigma Ext := fun p =>
    ⟨⟨(deleteRight G L j p.1.1,deleteRight G L j p.1.2),deleteRight_labels G L j _ _ p.2.1⟩,
      castArm G L p.2.2.1 (p.1.1.2.2.2.2.2 j),castArm G L p.2.2.2 (p.1.2.2.2.2.2.2 j)⟩
  have hi : Function.Injective encode := by
    intro p q he
    have hd : (deleteRight G L j p.1.1,deleteRight G L j p.1.2)=
        (deleteRight G L j q.1.1,deleteRight G L j q.1.2) :=
      congrArg (fun t : Sigma Ext => t.1.val) he
    have hm₁ : rightMiddle G L p.1.1 j=rightMiddle G L q.1.1 j := by
      have h := congrArg (fun t : Sigma Ext => middle G L t.2.1) he
      simpa only [encode,castArm_middle] using h
    have hm₂ : rightMiddle G L p.1.2 j=rightMiddle G L q.1.2 j := by
      have h := congrArg (fun t : Sigma Ext => middle G L t.2.2) he
      simpa only [encode,castArm_middle] using h
    apply Subtype.ext
    apply Prod.ext
    · apply deleteRight_restore G L j _ _ (Prod.mk.inj hd).1 _ hm₁
      exact p.2.2.1.trans ((congrArg kept (Prod.mk.inj hd).1).trans q.2.2.1.symm)
    · apply deleteRight_restore G L j _ _ (Prod.mk.inj hd).2 _ hm₂
      exact p.2.2.2.trans ((congrArg kept (Prod.mk.inj hd).2).trans q.2.2.2.symm)
  have hb (p : E) : Fintype.card (Ext p) ≤ cap^2 := by
    rw [Fintype.card_prod,pow_two]
    exact Nat.mul_le_mul (card_arm_cap G L cap hL hcap _ _) (card_arm_cap G L cap hL hcap _ _)
  have hcard : Fintype.card X ≤ cap^2*Fintype.card E := calc
    _ ≤ Fintype.card (Sigma Ext) := Fintype.card_le_of_injective encode hi
    _ = ∑ p, Fintype.card (Ext p) := Fintype.card_sigma
    _ ≤ ∑ _p : E, cap^2 := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp [Nat.mul_comm]
  simpa only [←Nat.card_eq_fintype_card] using hcard

/-- Cross-bundle repeated roots require no special cross-kernel estimate once
all retained arms have light, distinct endpoints. -/
theorem cross_root_bound (i : I) (j : J) (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J)
      (fun p => rightRoot G L p j=leftRoot G L p i)) ≤
        cap^2*Nat.card (Agreement G L I (Without j)) :=
  prescribed_root_delete_bound G L j (fun p => leftRoot G L p i) cap hL hcap

/-- Two repeated roots in the same bundle are covered by the same bound. -/
theorem right_root_bound (i j : J) (hij : i≠j) (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J)
      (fun p => rightRoot G L p j=rightRoot G L p i)) ≤
        cap^2*Nat.card (Agreement G L I (Without j)) :=
  prescribed_root_delete_bound G L j (fun p => rightRoot G L p ⟨i,hij⟩) cap hL hcap

end Erdos571.MaskedBush

/-! The remaining same-hub degeneracy in the masked finite model. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J : Type} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]

abbrev HubEqualFiber (r : Roots I J) :=
  {p : Fiber G L I J r // leftHub G L ⟨r,p⟩=rightHub G L ⟨r,p⟩}
abbrev HubEqual := FiberRestrictionEnergy.Both (Fiber G L I J)
  (fun p => leftHub G L p=rightHub G L p)

def hubEqualFiberEquiv (r : Roots I J) : HubEqualFiber G L r ≃
    ((u : W) × (G.neighborSet u × Bundle G L I u r.1 × Bundle G L J u r.2)) where
  toFun p := by
    rcases p with ⟨⟨x,⟨u,hu,a⟩,⟨v,hv,b⟩⟩,he⟩
    change u=v at he
    subst v
    exact ⟨u,⟨x,hu.down.symm⟩,a,b⟩
  invFun p := ⟨⟨p.2.1.val,⟨p.1,⟨p.2.1.property.symm⟩,p.2.2.1⟩,
    ⟨p.1,⟨p.2.1.property.symm⟩,p.2.2.2⟩⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,⟨u,hu,a⟩,⟨v,hv,b⟩⟩,he⟩
    change u=v at he
    subst v
    cases hu
    cases hv
    rfl
  right_inv p := by rcases p with ⟨u,⟨x,hx⟩,a,b⟩; rfl

open Classical in
lemma hubEqualFiber_card (r : Roots I J) : (Fintype.card (HubEqualFiber G L r):ℝ)=
    ∑ u, (G.degree u:ℝ)*ArmTensor.tensor (LightArmKernel.matrix G L) I u r.1 *
      ArmTensor.tensor (LightArmKernel.matrix G L) J u r.2 := by
  rw [Fintype.card_congr (hubEqualFiberEquiv G L r),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,SimpleGraph.card_neighborSet_eq_degree,card_bundle,mul_assoc]

lemma symmetric_hub_equal_card (s : ℕ) :
    (Nat.card (HubEqual G L (I := Fin s) (J := Fin s)):ℝ)=
      squareMass (fun x y : Fin s → W => ∑ u, (G.degree u:ℝ)*
        branch (LightArmKernel.matrix G L) s u x*branch (LightArmKernel.matrix G L) s u y) := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.bothEquiv
    (Fiber G L (Fin s) (Fin s)) (fun p => leftHub G L p=rightHub G L p)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,←pow_two,Nat.cast_pow]
  change (∑ r : Roots (Fin s) (Fin s), (Fintype.card (HubEqualFiber G L r):ℝ)^2)=_
  simp only [hubEqualFiber_card,Fintype.sum_prod_type]
  rfl

lemma hub_equal_bound (T D : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (hDT : D^2 ≤ T) (s : ℕ) (hs : 1 ≤ s) :
    (Nat.card (HubEqual G L (I := Fin s) (J := Fin s)):ℝ)^2 ≤
      Fintype.card W*T^(2*s+1)*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) := by
  classical
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let F := branch N s
  let Q := N*N.transpose
  let Z : Matrix (Fin s → W) (Fin s → W) ℝ := fun x y => ∑ u, (G.degree u:ℝ)*F u x*F u y
  have hFn := branch_nonneg (LightArmKernel.nonneg G L) s
  have hZn (x y : Fin s → W) : 0 ≤ Z x y :=
    sum_nonneg (fun u _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hFn u x)) (hFn u y))
  have hZF (x y : Fin s → W) : Z x y ≤ D*(F.transpose*F) x y := by
    simp only [Z,Matrix.mul_apply,Matrix.transpose_apply,mul_sum]
    apply sum_le_sum
    intro u _
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (hdeg u) (hFn u x)) (hFn u y)
  have h := unmasked_degeneracy_bound A G.isSymm_adjMatrix F Q s hs T D
    (LightArmKernel.gram_nonneg G L) (LightArmKernel.gram_upper G L T hT hrow)
    (LightArmKernel.gram_le_fourth G L) (kernel_branch N s) Z hZn hZF
  have hp : D^2*T^(s-1) ≤ T^s := by
    calc
      _ ≤ T*T^(s-1) := mul_le_mul_of_nonneg_right hDT (pow_nonneg hT _)
      _ = _ := by rw [←pow_succ']; congr 1; omega
  have hm : squareMass (A*A) ≤ Fintype.card W*T :=
    (sum_le_sum (fun u _ => hrow u)).trans_eq (by simp)
  have he : squareMass ((A*F).transpose*(A*F))=(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ) := by
    rw [←arm_bilateral_as_columnGram]
    simpa only [Nat.card_eq_fintype_card] using (symmetric_agreement_card G L s).symm
  rw [symmetric_hub_equal_card]
  calc
    _ ≤ (D^2*T^(s-1))^2*squareMass (A*A)*squareMass ((A*F).transpose*(A*F)) := h
    _ ≤ (T^s)^2*(Fintype.card W*T)*squareMass ((A*F).transpose*(A*F)) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul (pow_le_pow_left₀ (by positivity) hp 2) hm (squareMass_nonneg _) (sq_nonneg _))
        (squareMass_nonneg _)
    _ = _ := by rw [he,←pow_mul,show s*2=2*s by omega,pow_succ]; ring

end Erdos571.MaskedBush

/-! A uniform finite-energy certificate for arbitrary rooted homomorphism families. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HomFamilyEnergy
open Finset SimpleGraph
variable {A R J W : Type} [Fintype A] [Fintype R] [Fintype J] [Fintype W] [DecidableEq W]
variable (F : J → Type) [∀ j, Fintype (F j)]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W} (f : Sigma F → H →g G)

abbrev Agreement := FiberRestrictionEnergy.Agreement F
abbrev Conflicting := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ RootedHomEnergy.Conflict (f p.1) (f p.2)}
abbrev BadLeft := FiberRestrictionEnergy.Left F (fun p => ¬Function.Injective (f p))
abbrev BadRight := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧ ¬Function.Injective (f p.2)}
abbrev Overlap := {p : (Sigma F)×(Sigma F) // p.1.1=p.2.1 ∧
  ¬Disjoint (RootedHomEnergy.interior (f p.1)) (RootedHomEnergy.interior (f p.2))}
abbrev Pin (a : A) := RestrictionDeletion.RolePin F (fun p => f p (.inl a))
abbrev EqualBoth (u v : A⊕R) := FiberRestrictionEnergy.Both F (fun p => f p u=f p v)
abbrev DistinctRoles := {p : (A⊕R)×(A⊕R) // p.1≠p.2}

def badSwapEquiv : BadLeft F f ≃ BadRight F f where
  toFun p := ⟨(p.1.2,p.1.1),p.2.1.symm,p.2.2⟩
  invFun p := ⟨(p.1.2,p.1.1),p.2.1.symm,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

open Classical in
lemma conflicts_le_bad_overlap : (Nat.card (Conflicting F f):ℝ) ≤
    2*Nat.card (BadLeft F f)+Nat.card (Overlap F f) := by
  classical
  have hr := Nat.card_congr (badSwapEquiv F f)
  have h : (Nat.card (Conflicting F f):ℝ) ≤
      Nat.card (BadLeft F f)+Nat.card (BadRight F f)+Nat.card (Overlap F f) := by
    simp only [Nat.card_eq_fintype_card,LayeredAssignments.card_subtype_real,←sum_add_distrib]
    apply sum_le_sum
    intro p _
    by_cases he : p.1.1=p.2.1 <;>
      by_cases hi : Function.Injective (f p.1) <;>
      by_cases hj : Function.Injective (f p.2) <;>
      by_cases hd : Disjoint (RootedHomEnergy.interior (f p.1)) (RootedHomEnergy.interior (f p.2)) <;>
      simp [RootedHomEnergy.Conflict,he,hi,hj,hd]
  rw [←hr] at h
  nlinarith

open Classical in
lemma overlap_le_pins : (Nat.card (Overlap F f):ℝ) ≤
    Fintype.card A*∑ a, (Nat.card (Pin F f a):ℝ) := by
  classical
  let label : A → Sigma F → J×W := fun a p => (p.1,f p (.inl a))
  let rel : Sigma F → Sigma F → Prop := fun p q => p.1=q.1 ∧
    ¬Disjoint (RootedHomEnergy.interior (f p)) (RootedHomEnergy.interior (f q))
  have h := MarginalCollisionEnergy.covered_pairs_bound (univ : Finset (Sigma F)) label rel (by
    intro p _ q _ he
    obtain ⟨v,hpv,hqv⟩ := Finset.not_disjoint_iff.mp he.2
    simp only [RootedHomEnergy.interior,mem_image,mem_univ,true_and] at hpv hqv
    obtain ⟨a,ha⟩ := hpv
    obtain ⟨b,hb⟩ := hqv
    exact ⟨a,b,Prod.ext he.1 (ha.trans hb.symm)⟩) (fun _ => (1:ℝ)) (by intros; norm_num)
  have hp (a : A) : MarginalCollisionEnergy.pairMass (univ : Finset (Sigma F))
      (label a) (label a) (fun _ => (1:ℝ)) = Nat.card (Pin F f a) := by
    rw [Nat.card_eq_fintype_card,LayeredAssignments.card_subtype_real]
    simp only [MarginalCollisionEnergy.pairMass,label,Prod.mk.injEq,mul_one,Fintype.sum_prod_type]
  convert h using 1
  · simp only [Nat.card_eq_fintype_card,LayeredAssignments.card_subtype_real,sum_filter,sum_product,Fintype.sum_prod_type,mul_one]
    apply sum_congr rfl
    intro p _
    apply sum_congr rfl
    intro q _
    simp only [rel]
    split_ifs <;> rfl
  · simp only [hp]

open Classical in
lemma agreement_le_bad_pins [Nonempty A] (M : ℕ) (hM : 2 ≤ M)
    (hroots : ∀ p q, p.1=q.1 → ∀ r, f p (.inr r)=f q (.inr r))
    (hf : (FullRootedPower.graph H M).Free G) :
    (Nat.card (Agreement F):ℝ) ≤ (M-1:ℕ)*
      (2*Nat.card (BadLeft F f)+(Fintype.card A:ℝ)*∑ a, (Nat.card (Pin F f a):ℝ)) := by
  classical
  have h := RootedHomEnergy.pair_bound (univ : Finset (Sigma F)) f Sigma.fst
    (fun p _ q _ h => hroots p q h) M hM hf
  have hn : Nat.card (Agreement F) ≤ (M-1)*Nat.card (Conflicting F f) := by
    simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
      PackingEnergy.pairs,true_and,and_true,univ_product_univ] using h
  have hr : (Nat.card (Agreement F):ℝ) ≤ (M-1:ℕ)*(Nat.card (Conflicting F f):ℝ) := by exact_mod_cast hn
  exact hr.trans (mul_le_mul_of_nonneg_left
    ((conflicts_le_bad_overlap F f).trans (add_le_add le_rfl (overlap_le_pins F f))) (Nat.cast_nonneg _))

open Classical in
lemma bad_left_bound : (Nat.card (BadLeft F f):ℝ)^2 ≤
    Fintype.card (DistinctRoles (A := A) (R := R))*(Nat.card (Agreement F):ℝ)*
      ∑ p : DistinctRoles (A := A) (R := R), (Nat.card (EqualBoth F f p.1.1 p.1.2):ℝ) := by
  classical
  have h := FiberRestrictionEnergy.left_union_cauchy F (fun p => ¬Function.Injective (f p))
    (fun q : DistinctRoles (A := A) (R := R) => fun p => f p q.1.1=f p q.1.2) (by
      intro p hp
      obtain ⟨u,v,he,hne⟩ := Function.not_injective_iff.mp hp
      exact ⟨⟨(u,v),hne⟩,he⟩)
  simpa only [←Nat.card_eq_fintype_card] using h

open Classical in
theorem not_free_of_uniform_energies [Nonempty A] (M : ℕ) (hM : 2 ≤ M)
    (hroots : ∀ p q, p.1=q.1 → ∀ r, f p (.inr r)=f q (.inr r))
    (ε : ℝ) (hε : 0 ≤ ε)
    (hsmall : (M-1:ℕ)*(2*(Fintype.card (DistinctRoles (A := A) (R := R)):ℝ)+(Fintype.card A:ℝ)^2)*ε < 1)
    (hpos : 0 < (Nat.card (Agreement F):ℝ))
    (heq : ∀ p : DistinctRoles (A := A) (R := R), (Nat.card (EqualBoth F f p.1.1 p.1.2):ℝ) ≤
      ε^2*(Nat.card (Agreement F):ℝ))
    (hpin : ∀ a : A, (Nat.card (Pin F f a):ℝ) ≤ ε*(Nat.card (Agreement F):ℝ)) :
    ¬(FullRootedPower.graph H M).Free G := by
  classical
  intro hf
  let E : ℝ := Nat.card (Agreement F)
  let N : ℝ := Fintype.card (DistinctRoles (A := A) (R := R))
  let m : ℝ := Fintype.card A
  have hE : 0 ≤ E := hpos.le
  have hN : 0 ≤ N := Nat.cast_nonneg _
  have hm : 0 ≤ m := Nat.cast_nonneg _
  have hsum : (∑ p : DistinctRoles (A := A) (R := R), (Nat.card (EqualBoth F f p.1.1 p.1.2):ℝ)) ≤ N*ε^2*E := by
    calc
      _ ≤ ∑ _p : DistinctRoles (A := A) (R := R), ε^2*E := sum_le_sum (fun p _ => heq p)
      _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul,N]; ring
  have hb := bad_left_bound F f
  have hb' : (Nat.card (BadLeft F f):ℝ)^2 ≤ (N*ε*E)^2 := by
    calc
      _ ≤ N*E*∑ p : DistinctRoles (A := A) (R := R), (Nat.card (EqualBoth F f p.1.1 p.1.2):ℝ) := hb
      _ ≤ N*E*(N*ε^2*E) := mul_le_mul_of_nonneg_left hsum (mul_nonneg hN hE)
      _ = _ := by ring
  have hbsmall : (Nat.card (BadLeft F f):ℝ) ≤ N*ε*E := by
    have hn : 0 ≤ N*ε*E := by positivity
    nlinarith
  have hpsum : (∑ a : A, (Nat.card (Pin F f a):ℝ)) ≤ m*ε*E := by
    calc
      _ ≤ ∑ _a : A, ε*E := sum_le_sum (fun a _ => hpin a)
      _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul,m]; ring
  have hu := agreement_le_bad_pins F f M hM hroots hf
  have hfinal : E ≤ (M-1:ℕ)*(2*N+m^2)*ε*E := by
    calc
      _ ≤ (M-1:ℕ)*(2*Nat.card (BadLeft F f)+m*∑ a : A, (Nat.card (Pin F f a):ℝ)) := hu
      _ ≤ (M-1:ℕ)*(2*(N*ε*E)+m*(m*ε*E)) :=
        mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left hbsmall (by norm_num))
            (mul_le_mul_of_nonneg_left hpsum hm)) (Nat.cast_nonneg _)
      _ = _ := by ring
  have hh : (M-1:ℕ)*(2*N+m^2)*ε*E < E := by
    simpa only [one_mul] using mul_lt_mul_of_pos_right hsmall hpos
  exact (not_lt_of_ge hfinal) hh

end Erdos571.HomFamilyEnergy

/-! Classifying all nongenuine role equalities in the actual masked model. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph LayeredTrees
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev EqualBoth (s : ℕ) (u v : Interior [2,s]⊕Leaves [2,s]) :=
  HomFamilyEnergy.EqualBoth (Fiber G L (Fin s) (Fin s)) (hom G L s) u v
abbrev InteriorPin (s : ℕ) (a : Interior [2,s]) :=
  Pin G L (fun p : Full G L (Fin s) (Fin s) => hom G L s p (.inl a))

lemma equalBoth_swap_card (s : ℕ) (u v : Interior [2,s]⊕Leaves [2,s]) :
    Nat.card (EqualBoth G L s u v)=Nat.card (EqualBoth G L s v u) := by
  apply Nat.card_congr
  exact (Equiv.refl _).subtypeEquiv (fun p => by simp only [Equiv.refl_apply,eq_comm])

lemma equalBoth_card_zero_of_ne (s : ℕ) (u v : Interior [2,s]⊕Leaves [2,s])
    (hne : ∀ p : Full G L (Fin s) (Fin s), hom G L s p u≠hom G L s p v) :
    Nat.card (EqualBoth G L s u v)=0 := by
  haveI : IsEmpty (EqualBoth G L s u v) := ⟨fun p => hne p.1.1 p.2.2.1⟩
  exact Nat.card_of_isEmpty

lemma hub_center_equality_zero (s : ℕ) (i : Fin 2) :
    Nat.card (EqualBoth G L s (.inl (some (i,anchor [s]))) (.inl (anchor [2,s])))=0 :=
  equalBoth_card_zero_of_ne G L s _ _ (fun p => LayeredBush.hom_hub_ne_center G s (hom G L s p) i)

lemma hub_terminal_equality_zero (hb : G.IsBipartite) (s : ℕ) (i k : Fin 2) (j : Fin s) :
    Nat.card (EqualBoth G L s (.inl (some (i,anchor [s]))) (.inl (some (k,some (j,())))))=0 :=
  equalBoth_card_zero_of_ne G L s _ _ (fun p => LayeredBush.hom_hub_ne_terminal G hb s (hom G L s p) i k j)

lemma interior_root_both_le_pin (s : ℕ) (a : Interior [2,s]) (r : Leaves [2,s]) :
    Nat.card (EqualBoth G L s (.inl a) (.inr r)) ≤ Nat.card (InteriorPin G L s a) := by
  classical
  let f : EqualBoth G L s (.inl a) (.inr r) → InteriorPin G L s a := fun p =>
    ⟨p.1,p.2.1,p.2.2.1.trans ((same_roots G L s p.1.1 p.1.2 p.2.1 r).trans p.2.2.2.symm)⟩
  have hi : Function.Injective f := by
    intro p q he
    apply Subtype.ext
    exact congrArg (fun t : InteriorPin G L s a => t.val) he
  simpa only [Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hi

open Classical in
theorem interior_equalities_uniform (hb : G.IsBipartite) (s : ℕ) (B : ℝ) (hB : 0 ≤ B)
    (hhub : (Nat.card (EqualBoth G L s (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) ≤ B)
    (hcenter : ∀ (i : Fin 2) (j : Fin s),
      (Nat.card (EqualBoth G L s (.inl (anchor [2,s])) (.inl (some (i,some (j,()))))) : ℝ) ≤ B)
    (hmiddle : ∀ (i k : Fin 2) (j t : Fin s), some (i,some (j,())) ≠ some (k,some (t,())) →
      (Nat.card (EqualBoth G L s (.inl (some (i,some (j,())))) (.inl (some (k,some (t,()))))) : ℝ) ≤ B)
    (a b : Interior [2,s]) (hne : a≠b) :
    (Nat.card (EqualBoth G L s (.inl a) (.inl b)) : ℝ) ≤ B := by
  rcases LayeredBush.interior_case_split s a with rfl|⟨i,rfl⟩|⟨i,j,rfl⟩ <;>
    rcases LayeredBush.interior_case_split s b with rfl|⟨k,rfl⟩|⟨k,t,rfl⟩
  · exact (hne rfl).elim
  · rw [equalBoth_swap_card,hub_center_equality_zero,Nat.cast_zero]
    exact hB
  · exact hcenter k t
  · rw [hub_center_equality_zero,Nat.cast_zero]
    exact hB
  · fin_cases i <;> fin_cases k
    · exact (hne rfl).elim
    · exact hhub
    · rw [equalBoth_swap_card]
      exact hhub
    · exact (hne rfl).elim
  · rw [hub_terminal_equality_zero G L hb,Nat.cast_zero]
    exact hB
  · rw [equalBoth_swap_card]
    exact hcenter i j
  · rw [equalBoth_swap_card,hub_terminal_equality_zero G L hb,Nat.cast_zero]
    exact hB
  · exact hmiddle i k j t hne

open Classical in
/-- All ordered unequal role pairs are controlled by the five meaningful
collision classes. The hub/middle classes vanish in a bipartite host. -/
theorem all_equalities_uniform (hb : G.IsBipartite) (s : ℕ) (B : ℝ) (hB : 0 ≤ B)
    (hhub : (Nat.card (EqualBoth G L s (.inl (some (0,anchor [s]))) (.inl (some (1,anchor [s])))) : ℝ) ≤ B)
    (hcenter : ∀ (i : Fin 2) (j : Fin s),
      (Nat.card (EqualBoth G L s (.inl (anchor [2,s])) (.inl (some (i,some (j,()))))) : ℝ) ≤ B)
    (hmiddle : ∀ (i k : Fin 2) (j t : Fin s), some (i,some (j,())) ≠ some (k,some (t,())) →
      (Nat.card (EqualBoth G L s (.inl (some (i,some (j,())))) (.inl (some (k,some (t,()))))) : ℝ) ≤ B)
    (hroot : ∀ r t : Leaves [2,s], r≠t →
      (Nat.card (EqualBoth G L s (.inr r) (.inr t)) : ℝ) ≤ B)
    (hinteriorroot : ∀ (a : Interior [2,s]) (r : Leaves [2,s]),
      (Nat.card (EqualBoth G L s (.inl a) (.inr r)) : ℝ) ≤ B)
    (p : LayeredBush.DistinctRoles [2,s]) :
    (Nat.card (EqualBoth G L s p.1.1 p.1.2) : ℝ) ≤ B := by
  rcases p with ⟨⟨a|r,b|t⟩,hne⟩
  · exact interior_equalities_uniform G L hb s B hB hhub hcenter hmiddle a b (fun he => hne (congrArg Sum.inl he))
  · exact hinteriorroot a t
  · rw [equalBoth_swap_card]
    exact hinteriorroot b r
  · exact hroot r t (fun he => hne (congrArg Sum.inr he))


end Erdos571.MaskedBush

/-! The individual deletion estimates cover every nongenuine equality. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph LayeredTrees
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

/-- All meaningful collision types are small once pins and the one-arm-deleted
agreement are small. The coefficient hypotheses are purely scalar. -/
theorem all_collision_bounds (hb : G.IsBipartite) (s : ℕ)
    (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap)
    (P Z B : ℝ) (hB : 0 ≤ B) (hPB : P ≤ B)
    (hpin : ∀ a : Interior [2,s], (Nat.card (InteriorPin G L s a):ℝ) ≤ P)
    (hhub : (Nat.card (HubEqual G L (I := Fin s) (J := Fin s)):ℝ) ≤ B)
    (hdel : ∀ j : Fin s, (Nat.card (Agreement G L (Fin s) (Without j)):ℝ) ≤ Z)
    (hattach : (k-1:ℕ)*(P+cap*Z) ≤ B) (hrootcap : (cap:ℝ)^2*Z ≤ B)
    (p : LayeredBush.DistinctRoles [2,s]) :
    (Nat.card (EqualBoth G L s p.1.1 p.1.2):ℝ) ≤ B := by
  classical
  have hatt (X Y : ℕ) (j : Fin s)
      (h : X ≤ (k-1)*(Y+cap*Nat.card (Agreement G L (Fin s) (Without j))))
      (hy : (Y:ℝ) ≤ P) : (X:ℝ) ≤ B := by
    have hr : (X:ℝ) ≤ (k-1:ℕ)*((Y:ℝ)+cap*(Nat.card (Agreement G L (Fin s) (Without j)):ℝ)) := by
      exact_mod_cast h
    exact hr.trans ((mul_le_mul_of_nonneg_left
      (add_le_add hy (mul_le_mul_of_nonneg_left (hdel j) (Nat.cast_nonneg _)))
      (Nat.cast_nonneg _)).trans hattach)
  have hrt (X : ℕ) (j : Fin s)
      (h : X ≤ cap^2*Nat.card (Agreement G L (Fin s) (Without j))) : (X:ℝ) ≤ B := by
    have hr : (X:ℝ) ≤ (cap:ℝ)^2*(Nat.card (Agreement G L (Fin s) (Without j)):ℝ) := by exact_mod_cast h
    exact hr.trans ((mul_le_mul_of_nonneg_left (hdel j) (sq_nonneg _)).trans hrootcap)
  apply all_equalities_uniform G L hb s B hB hhub
  · intro i j
    fin_cases i
    · have he : Nat.card (EqualBoth G L s (.inl (anchor [2,s])) (.inl (some (0,some (j,())))))=
          Nat.card (CentralCollision G L (I := Fin s) j) :=
        Nat.card_congr (swapBothEquiv G L (fun p : Full G L (Fin s) (Fin s) => center G L p=rightMiddle G L p j))
      apply (congrArg (fun n : ℕ => (n:ℝ)) he).le.trans
      exact hatt _ _ j (central_attachment_bound G L K k cap hk hK hlight j) (hpin (anchor [2,s]))
    · exact hatt _ _ j (central_attachment_bound G L K k cap hk hK hlight j) (hpin (anchor [2,s]))
  · intro i k' j t hne
    fin_cases i <;> fin_cases k'
    · have hjt : j≠t := by intro he; subst t; exact hne rfl
      have he : Nat.card (EqualBoth G L s (.inl (some (0,some (j,())))) (.inl (some (0,some (t,())))))=
          Nat.card (RightCollision G L (I := Fin s) j t) :=
        Nat.card_congr (swapBothEquiv G L (fun p : Full G L (Fin s) (Fin s) => rightMiddle G L p j=rightMiddle G L p t))
      apply (congrArg (fun n : ℕ => (n:ℝ)) he).le.trans
      exact hatt _ _ t (right_attachment_bound G L K k cap hk hK hlight j t hjt) (hpin (some (1,some (j,()))))
    · exact hatt _ _ t (cross_attachment_bound G L K k cap hk hK hlight j t) (hpin (some (0,some (j,()))))
    · rw [equalBoth_swap_card]
      exact hatt _ _ j (cross_attachment_bound G L K k cap hk hK hlight t j) (hpin (some (0,some (t,()))))
    · have hjt : j≠t := by intro he; subst t; exact hne rfl
      exact hatt _ _ t (right_attachment_bound G L K k cap hk hK hlight j t hjt) (hpin (some (1,some (j,()))))
  · rintro ⟨i,j,⟨⟩⟩ ⟨k',t,⟨⟩⟩ hne
    fin_cases i <;> fin_cases k'
    · have htj : t≠j := by intro he; subst t; exact hne rfl
      have he : Nat.card (EqualBoth G L s (.inr (0,j,())) (.inr (0,t,())))=
          Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s))
            (fun p => rightRoot G L p j=rightRoot G L p t)) :=
        Nat.card_congr (swapBothEquiv G L (fun p : Full G L (Fin s) (Fin s) => rightRoot G L p j=rightRoot G L p t))
      apply (congrArg (fun n : ℕ => (n:ℝ)) he).le.trans
      exact hrt _ j (right_root_bound G L t j htj cap hL hcap)
    · rw [equalBoth_swap_card]
      exact hrt _ t (cross_root_bound G L j t cap hL hcap)
    · exact hrt _ j (cross_root_bound G L t j cap hL hcap)
    · have htj : t≠j := by intro he; subst t; exact hne rfl
      exact hrt _ j (right_root_bound G L t j htj cap hL hcap)
  · intro a r
    have h : (Nat.card (EqualBoth G L s (.inl a) (.inr r)):ℝ) ≤ Nat.card (InteriorPin G L s a) := by
      exact_mod_cast interior_root_both_le_pin G L s a r
    exact h.trans ((hpin a).trans hPB)

end Erdos571.MaskedBush

/-! Uniform interior pin bounds from major pins and deleted-arm energy. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph LayeredTrees
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

theorem all_pin_bounds (s : ℕ) (K : SimpleGraph W) (k cap D : ℕ)
    (hk : 2 ≤ k) (hK : K.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ D)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (b Z P : ℝ) (hbP : b ≤ P) (htP : (k-1:ℕ)*(b+(cap*D:ℕ)*Z) ≤ P)
    (hc : (Nat.card (Pin G L (center G L : Full G L (Fin s) (Fin s) → W)):ℝ) ≤ b)
    (hl : (Nat.card (Pin G L (leftHub G L : Full G L (Fin s) (Fin s) → W)):ℝ) ≤ b)
    (hr : (Nat.card (Pin G L (rightHub G L : Full G L (Fin s) (Fin s) → W)):ℝ) ≤ b)
    (hdel : ∀ j : Fin s, (Nat.card (Agreement G L (Fin s) (Without j)):ℝ) ≤ Z)
    (a : Interior [2,s]) : (Nat.card (InteriorPin G L s a):ℝ) ≤ P := by
  have ht (j : Fin s) : (Nat.card (Pin G L (fun p : Full G L (Fin s) (Fin s) => rightMiddle G L p j)):ℝ) ≤ P := by
    have h := right_terminal_pin_bound G L (I := Fin s) K k cap D hk hK hdeg hlight j
    have h' : (Nat.card (Pin G L (fun p : Full G L (Fin s) (Fin s) => rightMiddle G L p j)):ℝ) ≤
        (k-1:ℕ)*((Nat.card (Pin G L (rightHub G L : Full G L (Fin s) (Fin s) → W)):ℝ)+
          (cap*D:ℕ)*(Nat.card (Agreement G L (Fin s) (Without j)):ℝ)) := by exact_mod_cast h
    exact h'.trans ((mul_le_mul_of_nonneg_left
      (add_le_add hr (mul_le_mul_of_nonneg_left (hdel j) (Nat.cast_nonneg _))) (Nat.cast_nonneg _)).trans htP)
  rcases LayeredBush.interior_case_split s a with rfl|⟨i,rfl⟩|⟨i,j,rfl⟩
  · exact hc.trans hbP
  · fin_cases i
    · exact hl.trans hbP
    · exact hr.trans hbP
  · fin_cases i
    · have he : Nat.card (Pin G L (fun p : Full G L (Fin s) (Fin s) => leftMiddle G L p j))=
          Nat.card (Pin G L (fun p : Full G L (Fin s) (Fin s) => rightMiddle G L p j)) :=
        Nat.card_congr (swapPinEquiv G L (fun p : Full G L (Fin s) (Fin s) => rightMiddle G L p j))
      exact (congrArg (fun n : ℕ => (n:ℝ)) he).le.trans (ht j)
    · exact ht j

end Erdos571.MaskedBush

/-! Complete finite small-count certificate for the light-arm bush model. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph LayeredTrees
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

open Classical in
theorem not_free_of_small_counts (hb : G.IsBipartite) (s M : ℕ) (hM : 2 ≤ M)
    (K : SimpleGraph W) (k cap D : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hdeg : ∀ w, G.degree w ≤ D)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap)
    (ε p κ μ : ℝ) (hε : 0 ≤ ε)
    (hκp : κ ≤ p) (hterminal : (k-1:ℕ)*(κ+(cap*D:ℕ)*μ) ≤ p)
    (hp : p ≤ ε^2) (hε1 : ε^2 ≤ ε)
    (hattach : (k-1:ℕ)*(p+cap*μ) ≤ ε^2) (hroot : (cap:ℝ)^2*μ ≤ ε^2)
    (hsmall : (M-1:ℕ)*(2*(Fintype.card (LayeredBush.DistinctRoles [2,s]):ℝ)+
      (Fintype.card (Interior [2,s]):ℝ)^2)*ε < 1)
    (hpos : 0 < (Nat.card (Agreement G L (Fin s) (Fin s)):ℝ))
    (hc : (Nat.card (Pin G L (center G L : Full G L (Fin s) (Fin s) → W)):ℝ) ≤
      κ*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ))
    (hr : (Nat.card (Pin G L (rightHub G L : Full G L (Fin s) (Fin s) → W)):ℝ) ≤
      κ*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ))
    (hh : (Nat.card (HubEqual G L (I := Fin s) (J := Fin s)):ℝ) ≤
      κ*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ))
    (hdel : ∀ j : Fin s, (Nat.card (Agreement G L (Fin s) (Without j)):ℝ) ≤
      μ*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ)) :
    ¬(FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G := by
  classical
  let E : ℝ := Nat.card (Agreement G L (Fin s) (Fin s))
  have hE : 0 ≤ E := hpos.le
  have hl : (Nat.card (Pin G L (leftHub G L : Full G L (Fin s) (Fin s) → W)):ℝ) ≤ κ*E := by
    rw [left_pin_eq_right]
    exact hr
  have hpin : ∀ a : Interior [2,s], (Nat.card (InteriorPin G L s a):ℝ) ≤ p*E := by
    apply all_pin_bounds G L s K k cap D hk hK hdeg hlight (κ*E) (μ*E) (p*E)
      (mul_le_mul_of_nonneg_right hκp hE) _ hc hl hr hdel
    have h := mul_le_mul_of_nonneg_right hterminal hE
    nlinarith
  have heq : ∀ q : LayeredBush.DistinctRoles [2,s], (Nat.card (EqualBoth G L s q.1.1 q.1.2):ℝ) ≤ ε^2*E := by
    apply all_collision_bounds G L hb s K k cap hk hK hlight hL hcap
      (p*E) (μ*E) (ε^2*E) (mul_nonneg (sq_nonneg ε) hE)
      (mul_le_mul_of_nonneg_right hp hE) hpin
      (hh.trans (mul_le_mul_of_nonneg_right (hκp.trans hp) hE)) hdel
    · have h := mul_le_mul_of_nonneg_right hattach hE
      nlinarith
    · have h := mul_le_mul_of_nonneg_right hroot hE
      nlinarith
  apply HomFamilyEnergy.not_free_of_uniform_energies (Fiber G L (Fin s) (Fin s))
    (hom G L s) M hM (same_roots G L s) ε hε ?_ hpos heq
  · intro a
    exact (hpin a).trans (mul_le_mul_of_nonneg_right (hp.trans hε1) hE)
  · simpa only [←Nat.card_eq_fintype_card] using hsmall

end Erdos571.MaskedBush

/-! Mixed-moment interpolation for the actual deleted-arm families. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

lemma deleted_moment_bound (D : ℝ) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D)
    (hp : ∃ u, 0 < (G.degree u:ℝ) ∧
      0 < (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) u u)
    (s : ℕ) (hs : 1 ≤ s) (j : Fin s) :
    (Nat.card (Agreement G L (Fin s) (Without j)):ℝ)^(2*s) ≤
      (Fintype.card W:ℝ)^2*D^4*(Nat.card (Agreement G L (Fin s) (Fin s)):ℝ)^(2*s-1) := by
  classical
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let Q := N*N.transpose
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hQ := LightArmKernel.gram_nonneg G L
  have hp' : ∃ u, 0 < (A.transpose*A) u u ∧ 0 < Q u u := by
    obtain ⟨u,hu,hq⟩ := hp
    refine ⟨u,?_,hq⟩
    change 0 < ((G.adjMatrix ℝ).transpose*G.adjMatrix ℝ) u u
    rw [G.isSymm_adjMatrix,G.adjMatrix_mul_self_apply_self]
    exact hu
  have hrow (u : W) : ∑ v, A u v ≤ D := by
    have he := G.adjMatrix_mulVec_const_apply (α := ℝ) (a := 1) (v := u)
    simp only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] at he
    exact he.le.trans (hdeg u)
  have h := bilateral_mixed_interpolation A Q hA hQ hp' s hs
  have hzero := bilateral_zero_upper A Q hA D hrow
  have hh := h.trans (mul_le_mul_of_nonneg_right hzero (pow_nonneg (squareMass_nonneg _) _))
  rw [deleted_agreement_card,conjugationInner_comm]
  simpa only [A,Q,N,←symmetric_agreement_card G L s,←Nat.card_eq_fintype_card] using hh

end Erdos571.MaskedBush

namespace Erdos571.MaskedDegreeTransport
open Finset

lemma retained_normalization (n d E : ℝ) (hn : 0 < n) (s : ℕ) (hs : 1 ≤ s)
    (h : n^2*(d*(d^2/2)^s)^4 ≤ n^(2*s)*E) :
    n*d^(8*s+4) ≤ n^(2*s-1)*((2:ℝ)^(4*s)*E) := by
  have h' := mul_le_mul_of_nonneg_right h (show (0:ℝ) ≤ 2^(4*s) by positivity)
  have he : (d*(d^2/2)^s)^4*2^(4*s)=d^(8*s+4) := by
    simp only [mul_pow,div_pow,←pow_mul]
    rw [show s*4=4*s by omega,show 2*s*4=8*s by omega,mul_assoc]
    rw [div_mul_cancel₀ _ (show (2:ℝ)^(4*s)≠0 by positivity),←pow_add]
    congr 1
    omega
  have hh : n^2*d^(8*s+4) ≤ n^(2*s)*((2:ℝ)^(4*s)*E) := by
    calc
      _ = (n^2*(d*(d^2/2)^s)^4)*2^(4*s) := by rw [mul_assoc,he]
      _ ≤ _ := h'
      _ = _ := by ring
  exact BushDegreeTransport.normalized_lower n d ((2:ℝ)^(4*s)*E) hn s hs hh

lemma scaled_power_threshold (r τ E : ℝ) (hr : 1 ≤ r) (hτ : 0 ≤ τ) (hE : 0 ≤ E)
    (p : ℕ) (hp : 1 ≤ p) : (τ/r)^p*(r*E) ≤ τ^p*E := by
  have hrp : 0 < r := by linarith
  have hpow : r ≤ r^p := by simpa only [pow_one] using pow_le_pow_right₀ hr hp
  have hh : (τ/r)^p*r ≤ τ^p := by
    calc
      _ ≤ (τ/r)^p*r^p := mul_le_mul_of_nonneg_left hpow (pow_nonneg (div_nonneg hτ hrp.le) p)
      _ = τ^p := by rw [←mul_pow,div_mul_cancel₀ _ hrp.ne']
  simpa only [←mul_assoc] using mul_le_mul_of_nonneg_right hh hE

end Erdos571.MaskedDegreeTransport

/-! Fixed positive coefficient choices for the masked count certificate. -/
namespace Erdos571.MaskedBushCoefficients

lemma choose (a c L : ℝ) (ha : 0 ≤ a) (hc : 1 ≤ c) (hL : 0 ≤ L) :
    ∃ ε τ : ℝ, 0 < ε ∧ ε ≤ 1 ∧ 0 < τ ∧ τ ≤ 1 ∧ a*ε < 1 ∧
      c*(1+L)*τ ≤ ε^2 ∧ c*(c*(1+L)+L)*τ ≤ ε^2 ∧ L^2*τ ≤ ε^2 := by
  let C := c*(1+L)+c*(c*(1+L)+L)+L^2
  have hc0 : 0 ≤ c := by linarith
  have hC : 0 ≤ C := by dsimp [C]; positivity
  obtain ⟨ε,η,τ,hε,hε1,hη,hη1,hτ,hτ1,hsmall,hscale,hscale',hCτ⟩ :=
    BushCoefficientChoice.choose a 1 C ha le_rfl hC
  have hbound : C*τ ≤ ε^2 := by
    have hηsq : η^2 ≤ η := by nlinarith
    norm_num only [one_mul] at hscale
    exact hCτ.trans (hηsq.trans hscale)
  have hf : 0 ≤ c*(1+L) := by positivity
  have hs : 0 ≤ c*(c*(1+L)+L) := by positivity
  have h₁ : c*(1+L) ≤ C := by dsimp [C]; nlinarith [sq_nonneg L]
  have h₂ : c*(c*(1+L)+L) ≤ C := by dsimp [C]; nlinarith [sq_nonneg L]
  have h₃ : L^2 ≤ C := by dsimp [C]; nlinarith [sq_nonneg L]
  exact ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,
    (mul_le_mul_of_nonneg_right h₁ hτ.le).trans hbound,
    (mul_le_mul_of_nonneg_right h₂ hτ.le).trans hbound,
    (mul_le_mul_of_nonneg_right h₃ hτ.le).trans hbound⟩

lemma coefficients (c L Dmax D τ ε : ℝ) (hc : 1 ≤ c) (hL : 0 ≤ L)
    (hD : 1 ≤ D) (hmax : Dmax ≤ D) (hτ : 0 ≤ τ)
    (hatt : c*(c*(1+L)+L)*τ ≤ ε^2) (hroot : L^2*τ ≤ ε^2) :
    τ ≤ c*(1+L)*τ ∧
      c*(τ+L*Dmax*(τ/D)) ≤ c*(1+L)*τ ∧
      c*(c*(1+L)*τ+L*(τ/D)) ≤ ε^2 ∧ L^2*(τ/D) ≤ ε^2 := by
  have hc0 : 0 ≤ c := by linarith
  have hDp : 0 < D := by linarith
  have hμ : 0 ≤ τ/D := div_nonneg hτ hDp.le
  have hμτ : τ/D ≤ τ := div_le_self hτ hD
  have hDm : D*(τ/D)=τ := by field_simp
  have hm : Dmax*(τ/D) ≤ τ := (mul_le_mul_of_nonneg_right hmax hμ).trans_eq hDm
  refine ⟨?_,?_,?_,?_⟩
  · have hco : 1 ≤ c*(1+L) := by nlinarith
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hco hτ
  · have h : c*(τ+L*(Dmax*(τ/D))) ≤ c*(τ+L*τ) :=
      mul_le_mul_of_nonneg_left (add_le_add le_rfl (mul_le_mul_of_nonneg_left hm hL)) hc0
    calc
      _ = c*(τ+L*(Dmax*(τ/D))) := by ring
      _ ≤ c*(τ+L*τ) := h
      _ = _ := by ring
  · calc
      _ ≤ c*(c*(1+L)*τ+L*τ) := mul_le_mul_of_nonneg_left
        (add_le_add le_rfl (mul_le_mul_of_nonneg_left hμτ hL)) hc0
      _ = c*(c*(1+L)+L)*τ := by ring
      _ ≤ _ := hatt
  · exact (mul_le_mul_of_nonneg_left hμτ (sq_nonneg L)).trans hroot

end Erdos571.MaskedBushCoefficients

/-! Sharp unrestricted degree bound from the light-arm finite energy certificate. -/
set_option maxHeartbeats 4000000
namespace Erdos571.MaskedBush
open Finset SimpleGraph Matrix LayeredTrees GramFeatures GramPin

/-- No global codegree assumption appears in this degree bound. -/
theorem free_degree_bound (s M : ℕ) (hs : 3 ≤ s) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K) :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) →
      (FullRootedPower.graph (LayeredBush.graph [2,s]) M).Free G →
      d^(4*s+2) < B*(Fintype.card W:ℝ)^(2*s-1) := by
  classical
  let C := LayeredBush.momentCoefficient s M
  let k := Fintype.card (BushSubdivision.Branch s M)
  let t := k+Nat.card (⊤ : SimpleGraph (BushSubdivision.Branch s M)).edgeSet
  let cap : ℕ := Nat.ceil (4*C*K^2+1+(t:ℝ))
  have hC : 0 ≤ C := LayeredBush.momentCoefficient_nonneg s M
  have hK0 : 0 ≤ K := by linarith
  have hk : 2 ≤ k := by
    simp only [k,BushSubdivision.Branch,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hcap : 4*C*K^2+1+(t:ℝ) ≤ (cap:ℝ) := Nat.le_ceil _
  have hcut : 4*C*K^2 ≤ (cap:ℝ) := by have ht0 : (0:ℝ) ≤ t := Nat.cast_nonneg _; linarith
  have htc : t ≤ cap := by
    have hh : (t:ℝ) ≤ (cap:ℝ) := by nlinarith [mul_nonneg hC (sq_nonneg K)]
    exact_mod_cast hh
  have hcapPos : (0:ℝ) < cap := by nlinarith [mul_nonneg hC (sq_nonneg K),(show (0:ℝ) ≤ t from Nat.cast_nonneg t)]
  let c : ℝ := (k-1:ℕ)
  have hc : 1 ≤ c := by dsimp [c]; exact_mod_cast (show 1 ≤ k-1 by omega)
  let pack : ℝ := (M-1:ℕ)*(2*(Fintype.card (LayeredBush.DistinctRoles [2,s]):ℝ)+
    (Fintype.card (Interior [2,s]):ℝ)^2)
  have hpack : 0 ≤ pack := by dsimp [pack]; positivity
  obtain ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,hpSmall,hattach,hroot⟩ :=
    MaskedBushCoefficients.choose pack c cap hpack hc (Nat.cast_nonneg _)
  let r : ℝ := 2^(4*s)
  have hr : 1 ≤ r := one_le_pow₀ (by norm_num : (1:ℝ) ≤ 2)
  have hrpos : 0 < r := by linarith
  let τ' := τ/r
  have hτ' : 0 < τ' := div_pos hτ hrpos
  let R : ℝ := (C+1)^(2*s+1)
  have hR : 0 ≤ R := by dsimp [R]; positivity
  obtain ⟨B₀,hB₀,hB₁,hB₂⟩ := BushDegreeTransport.exists_degree_coefficient R K τ' hτ' (2*s-1) (4*s+2)
  let B := B₀+(4*K)^(4*s+2)+1
  have hB : 0 < B := by dsimp [B]; positivity
  have hBge : B₀ ≤ B := by dsimp [B]; nlinarith [pow_nonneg (show 0 ≤ 4*K by positivity) (4*s+2)]
  have hBlarge : (4*K)^(4*s+2) < B := by dsimp [B]; linarith
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W:ℝ)^(2*s-1) ≤ d^(4*s+2) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Nat.card (Agreement G cap (Fin s) (Fin s))
  let T := (C+1)*D^2
  have hn1 : 1 ≤ n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hn : 0 < n := by linarith
  have hdpos : 0 < d := by linarith
  have hD1 : 1 ≤ D := by dsimp [D]; nlinarith
  have hD : 0 < D := by linarith
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hDT : D^2 ≤ T := by dsimp [T]; nlinarith [mul_nonneg hC (sq_nonneg D)]
  have hd4 : 4*K ≤ d := by
    by_contra hh
    have hdp : d^(4*s+2) ≤ (4*K)^(4*s+2) := pow_le_pow_left₀ hdpos.le (le_of_not_ge hh) _
    have hpow : 1 ≤ n^(2*s-1) := one_le_pow₀ hn1
    have hlow : B ≤ B*n^(2*s-1) := by nlinarith
    exact (not_lt_of_ge ((hdense.trans hdp).trans' hlow)) hBlarge
  have hmax (u : W) : (G.degree u:ℝ) ≤ D := (hdeg u).2
  have hmin (u : W) : d ≤ (G.degree u:ℝ) := (hdeg u).1
  have hlow := free_energy_lower G (cap:ℝ) s M (by omega) hf K d hcapPos hK hd4 hmin hmax hcut
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have hEpos : 0 < E := by
    by_contra he
    have hh : n^(2*s)*E ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (pow_nonneg hn.le _) (le_of_not_gt he)
    have hlpos : 0 < n^2*(d*(d^2/2)^s)^4 := by positivity
    exact (not_lt_of_ge (hlow.trans hh)) hlpos
  have hnorm : n*d^(8*s+4) ≤ n^(2*s-1)*(r*E) :=
    MaskedDegreeTransport.retained_normalization n d E hn s (by omega) hlow
  have hdense₀ : B₀*n^(2*s-1) ≤ d^(4*s+2) :=
    (mul_le_mul_of_nonneg_right hBge (pow_nonneg hn.le _)).trans hdense
  have ht := BushDegreeTransport.single_to_two n d K R τ' B₀ hn.le hd hK hτ' s hs hB₁ hB₂ hdense₀
  have hGram : n*T^(2*s+1) ≤ τ^2*E := by
    have hc := BushDegreeTransport.core_threshold n d D K R (r*E) τ' hn hdpos.le hD.le hK0 hR le_rfl
      (2*s-1) (4*s+2) (by simpa only [show 2*(4*s+2)=8*s+4 by omega] using hnorm) ht.1
    have hscale := MaskedDegreeTransport.scaled_power_threshold r τ E hr hτ.le hE 2 (by omega)
    have hid : T^(2*s+1)=R*D^(4*s+2) := by
      simp only [T,R,mul_pow,←pow_mul,show 2*(2*s+1)=4*s+2 by omega]
    rw [hid]
    exact (show n*(R*D^(4*s+2)) ≤ τ'^2*(r*E) by simpa only [mul_assoc] using hc).trans hscale
  have hZero : n^2*D^4 ≤ (τ/D)^(2*s)*E := by
    apply BushDegreeTransport.zero_threshold n D E τ hD (2*s)
    have hz := BushDegreeTransport.zero_degree_threshold n d D K (r*E) τ' hn hdpos.le hD.le hK0 hτ'.le le_rfl
      (2*s-1) (2*s) (2*s+4) (6*s)
      (by simpa only [show 6*s+(2*s+4)=8*s+4 by omega] using hnorm)
      (by simpa only [show 2*s-1+1=2*s by omega] using ht.2)
    exact hz.trans (MaskedDegreeTransport.scaled_power_threshold r τ E hr hτ.le hE (2*s) (by omega))
  have hrow (u : W) : (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ T :=
    (LayeredBush.free_fourth_row_bound s M (by omega) G hf D hD.le hmax u).trans
      (by dsimp [T,C]; nlinarith [sq_nonneg D])
  have hcenter : (Nat.card (Pin G cap (center G cap : Full G cap (Fin s) (Fin s) → W)):ℝ) ≤ τ*E :=
    EnergyThresholds.relative_of_square hE hτ.le (center_pin_bound G cap T hT hrow s (by omega)) hGram
  have hright : (Nat.card (Pin G cap (rightHub G cap : Full G cap (Fin s) (Fin s) → W)):ℝ) ≤ τ*E :=
    EnergyThresholds.relative_of_square hE hτ.le (right_pin_bound G cap T hT hrow s) hGram
  have hhub : (Nat.card (HubEqual G cap (I := Fin s) (J := Fin s)):ℝ) ≤ τ*E :=
    EnergyThresholds.relative_of_square hE hτ.le (hub_equal_bound G cap T D hT hrow hmax hDT s (by omega)) hGram
  have hpGram : ∃ u, 0 < (G.degree u:ℝ) ∧ 0 < (LightArmKernel.matrix G cap*(LightArmKernel.matrix G cap).transpose) u u := by
    let u : W := Classical.arbitrary W
    refine ⟨u,hdpos.trans_le (hmin u),?_⟩
    exact (by positivity : 0 < d^2/2).trans_le
      (LightArmKernel.free_gram_diagonal_lower G s M (by omega) hf cap K d hcapPos hK hd4 hmin hmax hcut u)
  have hμ : 0 ≤ τ/D := div_nonneg hτ.le hD.le
  have hdel (j : Fin s) : (Nat.card (Agreement G cap (Fin s) (Without j)):ℝ) ≤ (τ/D)*E :=
    EnergyThresholds.relative_of_power hE hμ (2*s) (by omega)
      (deleted_moment_bound G cap D hmax hpGram s (by omega) j) hZero
  let S := HostHeavyShadow.graph G univ t
  have hS : S.CliqueFree k := HostHeavyShadow.cliqueFree_of_subdivision_free
    (⊤ : SimpleGraph (BushSubdivision.Branch s M)) G univ (LayeredBush.complete_subdivision_free s M G hf)
  have hlight (u v : W) (hnon : ¬S.Adj u v) (hne : u≠v) : Fintype.card (G.commonNeighbors u v) ≤ cap := by
    have ht : (FourthMoment.common G univ u v).card < t := by
      by_contra hh
      exact hnon ⟨hne,le_of_not_gt hh⟩
    rw [HostHeavyShadow.common_univ_card] at ht
    exact ht.le.trans htc
  have hDmax : (G.maxDegree:ℝ) ≤ D := by
    obtain ⟨u,hu⟩ := G.exists_maximal_degree_vertex
    rw [hu]
    exact hmax u
  have hcoef := MaskedBushCoefficients.coefficients c cap G.maxDegree D τ ε hc (Nat.cast_nonneg _) hD1 hDmax hτ.le hattach hroot
  have hεsq : ε^2 ≤ ε := by nlinarith
  have hfree := not_free_of_small_counts G (cap:ℝ) hb s M hM S k cap G.maxDegree hk hS
    G.degree_le_maxDegree hlight (Nat.cast_nonneg _) le_rfl
    ε (c*(1+cap)*τ) τ (τ/D) hε.le hcoef.1
    (by simpa only [c,Nat.cast_mul] using hcoef.2.1) hpSmall hεsq hcoef.2.2.1 hcoef.2.2.2
    (by simpa only [pack,←Nat.card_eq_fintype_card] using hsmall) hEpos hcenter hright hhub hdel
  exact hfree hf

end Erdos571.MaskedBush

/-! Unrestricted edge bounds for the subdivided symmetric bush powers. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LayeredBush
open Finset SimpleGraph DensityRegularization

theorem unrestricted_regular_bound (s M : ℕ) (hs : 3 ≤ s) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (FullRootedPower.graph (graph [2,s]) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent s) := by
  obtain ⟨B,hB,hbound⟩ := MaskedBush.free_degree_bound s M hs hM Q hQ
  let C : ℝ := B^((4*s+2:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent s :=
    Real.one_le_rpow hn1 (degreeExponent_pos s (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent s := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (FullRootedPower.graph (graph [2,s]) M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (4*s+2) (2*s-1) (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent s at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent s) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The sharp bush exponent holds for every finite forbidden-free host. -/
theorem unrestricted_edge_bound (s M : ℕ) (hs : 3 ≤ s) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (FullRootedPower.graph (graph [2,s]) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent s) := by
  have hγ : 0 < degreeExponent s := degreeExponent_pos s (by omega)
  have hγ1 : degreeExponent s ≤ 1 := degreeExponent_le_one s
  let K : ℝ := (16:ℝ)^((degreeExponent s)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent s)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := unrestricted_regular_bound s M hs hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (FullRootedPower.graph (graph [2,s]) M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent s) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb


end Erdos571.LayeredBush

/-! Exact ordinary Turan exponents from the symmetric bushes and their cones. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LayeredBush
open Finset SimpleGraph LayeredTrees OrdinaryRooted

lemma symmetric_exponent_eq (s : ℕ) (hs : 1 ≤ s) :
    1+degreeExponent s=2-((2*s+3:ℕ):ℝ)/((4*s+2:ℕ):ℝ) := by
  have hn : 1 ≤ 2*s := by omega
  have hden : (4*(s:ℝ)+2)≠0 := by positivity
  unfold degreeExponent
  rw [Nat.cast_sub hn]
  push_cast
  field_simp
  ring

theorem symmetric_supported (s : ℕ) (hs : 3 ≤ s) :
    Supported (graph [2,s]) (2-((2*s+3:ℕ):ℝ)/((4*s+2:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := unrestricted_edge_bound s M hs hM
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  rw [←symmetric_exponent_eq s (by omega)]
  exact hbound W inferInstance G inferInstance hf

theorem symmetric_certificate (s : ℕ) (hs : 3 ≤ s) : Certificate (2*s+3) (4*s+2) := by
  classical
  have hv : Valid [2,s] := by
    refine ⟨⟨trivial, ?_⟩, ?_⟩ <;> simp only [edges,nonroots] <;> omega
  have hleaf : 0 < Fintype.card (Leaves [2,s]) := by
    rw [card_leaves]
    simp only [List.prod_cons,List.prod_nil]
    omega
  letI : Nonempty (Leaves [2,s]) := Fintype.card_pos_iff.mp hleaf
  letI : Nontrivial (Interior [2,s]⊕Leaves [2,s]) :=
    ⟨⟨.inl (anchor [2,s]),.inr (Classical.choice ‹Nonempty (Leaves [2,s])›),Sum.inl_ne_inr⟩⟩
  let c : Interior [2,s]⊕Leaves [2,s] → Bool := fun v => fullColor [2,s] (addShortCopy [2,s] v)
  have hc : ∀ {u v}, (graph [2,s]).Adj u v → c u≠c v := by
    intro u v h
    exact fullColor_proper [2,s] ((addShortCopy [2,s]).toHom.map_adj h)
  have hni : ∀ u, ∃ v, (graph [2,s]).Adj u v :=
    (isTree [2,s]).isConnected.preconnected.exists_adj_of_nontrivial
  have ha : nonroots [2,s]=2*s+3 := by simp only [nonroots]; omega
  have he : edges [2,s]-1=4*s+2 := by simp only [edges]; omega
  refine ⟨Interior [2,s],Leaves [2,s],inferInstance,inferInstance,inferInstance,inferInstance,
    graph [2,s],c,hc,(isTree [2,s]).isConnected,hni,?_,symmetric_supported s hs⟩
  simpa only [ha,he] using balanced [2,s] hv

theorem symmetric_iterated_certificate (s t : ℕ) (hs : 3 ≤ s) :
    Certificate (2*s+3) (4*s+2+t*(2*s+3)) := by
  induction t with
  | zero => simpa using symmetric_certificate s hs
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 4*s+2+(t+1)*(2*s+3)=4*s+2+t*(2*s+3)+(2*s+3) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- A new unconditional family, containing `19/14` at `s=3,t=0`. -/
theorem symmetric_exact_family (s t : ℕ) (hs : 3 ≤ s) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(2*s+3:ℚ)/(4*s+2+t*(2*s+3):ℚ):ℚ):ℝ)) := by
  have h := (symmetric_iterated_certificate s t hs).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_nineteen_fourteenths :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((19/14:ℚ):ℝ)) := by
  have h := symmetric_exact_family 3 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.LayeredBush



/-! Heavy-codegree shadows on copies of a whole finite core. -/
set_option maxHeartbeats 3000000
namespace Erdos571.CoreArms
open Finset SimpleGraph
variable {V R W : Type} [Fintype V] [Fintype R] [Fintype W] [DecidableEq W]

/-- Attach one length-two root arm for every element of `R`. The middle
vertices are nonroots, even when several arms attach to the same core role. -/
def template (K : SimpleGraph V) (attach : R → V) : SimpleGraph ((V ⊕ R) ⊕ R) :=
  LeafRooted.graph (LeafRooted.graph K attach) Sum.inr

abbrev Branch (M : ℕ) := (Fin M × V) ⊕ R
abbrev Middle (M : ℕ) := Fin M × R

def threshold (M : ℕ) : ℕ := M * Fintype.card V + Fintype.card R + M * Fintype.card R

/-- Heavy pairs suffice once the whole core and all root images have been
chosen injectively. No codegree assumption is made on any other pair. -/
theorem contains_of_branch_map (K : SimpleGraph V) (attach : R → V) (M : ℕ)
    (G : SimpleGraph W) [DecidableRel G.Adj] (f : Branch (V := V) (R := R) M → W)
    (hf : Function.Injective f)
    (hcore : ∀ k u v, K.Adj u v → G.Adj (f (.inl (k,u))) (f (.inl (k,v))))
    (hheavy : ∀ k r, threshold (V := V) (R := R) M ≤
      (FourthMoment.common G univ (f (.inl (k,attach r))) (f (.inr r))).card) :
    FullRootedPower.graph (template K attach) M ⊑ G := by
  classical
  let Z : Finset W := univ.image f
  let F : Middle (R := R) M → Finset W := fun p =>
    FourthMoment.common G univ (f (.inl (p.1,attach p.2))) (f (.inr p.2))
  have hZ : Z.card ≤ M * Fintype.card V + Fintype.card R := by
    have h := card_image_le (s := (univ : Finset (Branch (V := V) (R := R) M))) (f := f)
    simpa only [card_univ, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin] using h
  obtain ⟨g,hg,hgF⟩ := ShortSpider.select_avoiding F Z (by
    intro p
    have h := hheavy p.1 p.2
    simp only [Middle, Fintype.card_prod, Fintype.card_fin]
    dsimp only [threshold] at h
    dsimp only [F]
    omega)
  have hgf (p : Middle (R := R) M) (b : Branch (V := V) (R := R) M) : g p ≠ f b := by
    intro he
    exact (hgF p).2 (mem_image.mpr ⟨b,mem_univ _,he.symm⟩)
  have hadj (k : Fin M) (r : R) :
      G.Adj (f (.inl (k,attach r))) (g (k,r)) ∧ G.Adj (g (k,r)) (f (.inr r)) := by
    have h := (hgF (k,r)).1
    change g (k,r) ∈ FourthMoment.common G univ _ _ at h
    simp only [FourthMoment.common, mem_filter, mem_univ, true_and] at h
    exact ⟨h.1,h.2.symm⟩
  let e : ((Fin M × (V ⊕ R)) ⊕ R) → W
    | .inl (k,.inl v) => f (.inl (k,v))
    | .inl (k,.inr r) => g (k,r)
    | .inr r => f (.inr r)
  refine ⟨{toHom := {toFun := e, map_rel' := ?_}, injective' := ?_}⟩
  · rintro (⟨k,(u|r)⟩|r) (⟨l,(v|s)⟩|s) h
    all_goals dsimp only [e]
    · change k=l ∧ K.Adj u v at h
      obtain ⟨hkl,h⟩ := h
      subst l
      exact hcore k u v h
    · change k=l ∧ u=attach s at h
      obtain ⟨hkl,h⟩ := h
      subst l
      subst u
      exact (hadj k s).1
    · change Sum.inl u = Sum.inr s at h
      exact (Sum.inl_ne_inr h).elim
    · change k=l ∧ v=attach r at h
      obtain ⟨hkl,h⟩ := h
      subst l
      subst v
      exact (hadj k r).1.symm
    · change k=l ∧ False at h
      exact h.2.elim
    · change Sum.inr r = Sum.inr s at h
      have he : r=s := Sum.inr.inj h
      subst s
      exact (hadj k r).2
    · change Sum.inl v = Sum.inr r at h
      exact (Sum.inl_ne_inr h).elim
    · change Sum.inr s = Sum.inr r at h
      have he : s=r := Sum.inr.inj h
      subst r
      exact (hadj l s).2.symm
    · change False at h
      exact h.elim
  · rintro (⟨k,(u|r)⟩|r) (⟨l,(v|s)⟩|s) h
    all_goals dsimp only [e] at h
    · have hh := Sum.inl.inj (hf h)
      obtain ⟨rfl,rfl⟩ := Prod.mk.inj hh
      rfl
    · exact (hgf (l,s) (.inl (k,u)) h.symm).elim
    · exact (Sum.inl_ne_inr (hf h)).elim
    · exact (hgf (k,r) (.inl (l,v)) h).elim
    · have hh := hg h
      obtain ⟨rfl,rfl⟩ := Prod.mk.inj hh
      rfl
    · exact (hgf (k,r) (.inr s) h).elim
    · exact (Sum.inr_ne_inl (hf h)).elim
    · exact (hgf (l,s) (.inr r) h.symm).elim
    · exact congrArg Sum.inr (Sum.inr.inj (hf h))

end Erdos571.CoreArms

namespace Erdos571.CoreCopyShadow
open Finset SimpleGraph
variable {V R W : Type} [Fintype V] [Fintype R] [Fintype W] [DecidableEq W]

/-- Two copies must be vertex-disjoint, and every pair of corresponding
roles must have heavy codegree. This is not the ordinary vertex shadow. -/
def graph (K : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    [Nonempty V] (t : ℕ) : SimpleGraph (K.Copy G) where
  Adj f g := (∀ u v, f u ≠ g v) ∧ ∀ v, t ≤ (FourthMoment.common G univ (f v) (g v)).card
  symm := by
    intro f g h
    refine ⟨fun u v => (h.1 v u).symm,?_⟩
    intro v
    have he : FourthMoment.common G univ (g v) (f v) = FourthMoment.common G univ (f v) (g v) := by
      ext w
      simp [FourthMoment.common, and_comm]
    rw [he]
    exact h.2 v
  loopless := by
    intro f h
    exact h.1 (Classical.arbitrary V) (Classical.arbitrary V) rfl

/-- A clique of disjoint heavy core copies supplies petal cores and one
fresh root image for each arm. All middle vertices are then chosen fresh. -/
theorem contains_of_clique_copy [Nonempty V] (K : SimpleGraph V) (attach : R → V) (M : ℕ)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (c : (⊤ : SimpleGraph (Fin M ⊕ R)).Copy
      (graph K G (CoreArms.threshold (V := V) (R := R) M))) :
    FullRootedPower.graph (CoreArms.template K attach) M ⊑ G := by
  classical
  have hi : Function.Injective (fun p : (Fin M ⊕ R) × V => c p.1 p.2) := by
    intro p q he
    by_cases hpq : p.1=q.1
    · apply Prod.ext hpq
      apply (c p.1).injective
      simpa only [hpq] using he
    · exact ((c.toHom.map_adj ((top_adj _ _).mpr hpq)).1 p.2 q.2 he).elim
  let b : CoreArms.Branch (V := V) (R := R) M → (Fin M ⊕ R) × V
    | .inl (k,v) => (.inl k,v)
    | .inr r => (.inr r,attach r)
  have hb : Function.Injective b := by
    rintro (⟨k,u⟩|r) (⟨l,v⟩|s) h
    all_goals dsimp only [b] at h
    · obtain ⟨h₁,h₂⟩ := Prod.mk.inj h
      exact congrArg Sum.inl (Prod.ext (Sum.inl.inj h₁) h₂)
    · exact (Sum.inl_ne_inr (congrArg Prod.fst h)).elim
    · exact (Sum.inr_ne_inl (congrArg Prod.fst h)).elim
    · exact congrArg Sum.inr (Sum.inr.inj (congrArg Prod.fst h))
  apply CoreArms.contains_of_branch_map K attach M G
    (fun z => c (b z).1 (b z).2) (hi.comp hb)
  · intro k u v h
    exact (c (.inl k)).toHom.map_adj h
  · intro k r
    exact (c.toHom.map_adj ((top_adj _ _).mpr (Sum.inl_ne_inr))).2 (attach r)

/-- Ordinary forbidden-power freeness implies clique-freeness of the
whole-core shadow, including cores with adjacent branching vertices. -/
theorem cliqueFree [Nonempty V] (K : SimpleGraph V) (attach : R → V) (M : ℕ)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (CoreArms.template K attach) M).Free G) :
    (graph K G (CoreArms.threshold (V := V) (R := R) M)).CliqueFree
      (M + Fintype.card R) := by
  have he : M + Fintype.card R = Fintype.card (Fin M ⊕ R) := by simp
  rw [he]
  apply cliqueFree_iff_top_free.mpr
  rintro ⟨c⟩
  exact hf (contains_of_clique_copy K attach M G c)

end Erdos571.CoreCopyShadow


/-! Actual freeness gives an overlap-or-light-coordinate restriction on
pairs of complete core copies, with arbitrary nonnegative weights. -/
set_option maxHeartbeats 3000000
namespace Erdos571.FiniteEventUnion
open Finset
variable {X I : Type} [Fintype X] [Fintype I]

open Classical in
theorem weighted_le_sum (P : X → Prop) (Q : I → X → Prop)
    (hcover : ∀ x, P x → ∃ i, Q i x) (a : X → ℝ) (ha : ∀ x, 0 ≤ a x) :
    (∑ x, if P x then a x else 0) ≤ ∑ i, ∑ x, if Q i x then a x else 0 := by
  classical
  rw [sum_comm]
  apply sum_le_sum
  intro x _
  by_cases hx : P x
  · obtain ⟨i,hi⟩ := hcover x hx
    rw [if_pos hx]
    have h := single_le_sum (s := (univ : Finset I))
      (f := fun j => if Q j x then a x else 0)
      (fun j _ => by dsimp only; split_ifs <;> simp_all) (mem_univ i)
    simpa only [if_pos hi] using h
  · rw [if_neg hx]
    exact sum_nonneg (fun i _ => by split_ifs <;> simp_all)

end Erdos571.FiniteEventUnion

namespace Erdos571.CoreCopyShadow
open Finset SimpleGraph
variable {V R W : Type} [Fintype V] [Fintype R] [Fintype W]
  [DecidableEq W] [Nonempty V]

lemma nonadj_iff (K : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (t : ℕ) (f g : K.Copy G) :
    ¬(graph K G t).Adj f g ↔
      (∃ u v, f u=g v) ∨ ∃ v, (FourthMoment.common G univ (f v) (g v)).card<t := by
  classical
  change ¬((∀ u v, f u≠g v) ∧ ∀ v, t ≤ _) ↔ _
  simp only [not_and_or, not_forall, not_not, not_le]

open Classical in
/-- The cost of restricting to light coordinates includes every overlap
between core roles. No overlap term is discarded or assumed negligible. -/
theorem weighted_restriction {I : Type} [Fintype I]
    (K : SimpleGraph V) (attach : R → V) (M : ℕ)
    (hM : 2 ≤ M + Fintype.card R) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (CoreArms.template K attach) M).Free G)
    (e : I → K.Copy G) (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) :
    (∑ i, w i)^2 ≤ (M + Fintype.card R - 1 : ℕ) *
      ((∑ u : V, ∑ v : V, ∑ i : I, ∑ j : I,
          if e i u=e j v then w i*w j else 0) +
        ∑ v : V, ∑ i : I, ∑ j : I,
          if (FourthMoment.common G univ (e i v) (e j v)).card <
            CoreArms.threshold (V := V) (R := R) M then w i*w j else 0) := by
  classical
  let t := CoreArms.threshold (V := V) (R := R) M
  let Q : (V×V) ⊕ V → (I × I) → Prop
    | .inl (u,v), (i,j) => e i u=e j v
    | .inr v, (i,j) => (FourthMoment.common G univ (e i v) (e j v)).card<t
  have h := HeavyFiberRestriction.weighted_role (graph K G t) e _ hM
    (cliqueFree K attach M G hf) w hw
  have hc := FiniteEventUnion.weighted_le_sum
    (fun p : I × I => ¬(graph K G t).Adj (e p.1) (e p.2)) Q
    (by
      intro p hp
      rcases (nonadj_iff K G t (e p.1) (e p.2)).mp hp with ⟨u,v,h⟩|⟨v,h⟩
      · exact ⟨.inl (u,v),h⟩
      · exact ⟨.inr v,h⟩)
    (fun p => w p.1*w p.2) (fun p => mul_nonneg (hw _) (hw _))
  simp only [Fintype.sum_prod_type,Fintype.sum_sum_type,Q] at hc
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  apply hc.trans_eq
  apply congrArg₂ (· + ·)
  · apply sum_congr rfl
    intro u _
    apply sum_congr rfl
    intro v _
    apply sum_congr rfl
    intro i _
    apply sum_congr rfl
    intro j _
    by_cases he : e i u=e j v <;> simp only [he,if_true,if_false]
  · apply sum_congr rfl
    intro v _
    apply sum_congr rfl
    intro i _
    apply sum_congr rfl
    intro j _
    dsimp only [t]
    split_ifs <;> rfl

open Classical in
/-- The same restriction for a rooted finite family of assignments. Its
right-hand side consists of literal finite overlap and light-pair counts. -/
theorem family_restriction {S : Type} [Fintype S]
    (F : S → Type) [∀ s, Fintype (F s)]
    (K : SimpleGraph V) (attach : R → V) (M : ℕ) (hM : 2 ≤ M + Fintype.card R)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (CoreArms.template K attach) M).Free G)
    (e : Sigma F → K.Copy G) :
    Nat.card (FiberRestrictionEnergy.Agreement F) ≤
      (M + Fintype.card R - 1) *
        ((∑ u : V, ∑ v : V, Nat.card {p : Sigma F × Sigma F //
          p.1.1=p.2.1 ∧ e p.1 u=e p.2 v}) +
          ∑ v : V, Nat.card {p : Sigma F × Sigma F //
            p.1.1=p.2.1 ∧ (FourthMoment.common G univ (e p.1 v) (e p.2 v)).card <
              CoreArms.threshold (V := V) (R := R) M}) := by
  classical
  let t := CoreArms.threshold (V := V) (R := R) M
  let Q : (V×V) ⊕ V → (Sigma F × Sigma F) → Prop
    | .inl (u,v),p => p.1.1=p.2.1 ∧ e p.1 u=e p.2 v
    | .inr v,p => p.1.1=p.2.1 ∧ (FourthMoment.common G univ (e p.1 v) (e p.2 v)).card<t
  have h := HeavyFiberRestriction.family_pairs F (graph K G t) e _ hM
    (cliqueFree K attach M G hf)
  have hc := FiniteEventUnion.card_le_sum
    (fun p : Sigma F × Sigma F => p.1.1=p.2.1 ∧ ¬(graph K G t).Adj (e p.1) (e p.2)) Q
    (by
      intro p hp
      rcases (nonadj_iff K G t (e p.1) (e p.2)).mp hp.2 with ⟨u,v,h⟩|⟨v,h⟩
      · exact ⟨.inl (u,v),hp.1,h⟩
      · exact ⟨.inr v,hp.1,h⟩)
  simp only [Fintype.sum_sum_type,Fintype.sum_prod_type,Q] at hc
  simp only [←Nat.card_eq_fintype_card] at h hc ⊢
  exact h.trans (Nat.mul_le_mul_left (M + Nat.card R - 1) hc)

end Erdos571.CoreCopyShadow


/-! Freeness-aware tensor quadratic bounds for an arbitrary finite core.
The retained terms are core overlaps and a sum with one codegree factor deleted. -/
set_option maxHeartbeats 3000000
namespace Erdos571.CoreTensorMoments
open Finset SimpleGraph Matrix
variable {V W I : Type} [Fintype V] [Fintype W] [Fintype I]
  [DecidableEq V] [DecidableEq W]

noncomputable def codegree (G : SimpleGraph W) [DecidableRel G.Adj] (u v : W) : ℝ :=
  (FourthMoment.common G univ u v).card

lemma codegree_nonneg (G : SimpleGraph W) [DecidableRel G.Adj] (u v : W) :
    0 ≤ codegree G u v := Nat.cast_nonneg _

lemma codegree_eq (G : SimpleGraph W) [DecidableRel G.Adj] (u v : W) :
    codegree G u v = ∑ x, G.adjMatrix ℝ x u * G.adjMatrix ℝ x v := by
  rw [codegree,HostHeavyShadow.common_univ_card,
    ←LayeredBush.adjacency_square_common_card,Matrix.mul_apply]
  apply sum_congr rfl
  intro x _
  rw [G.isSymm_adjMatrix.apply u x]

noncomputable def feature (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) : Matrix (V → W) I ℝ := fun x i => ∏ v, G.adjMatrix ℝ (x v) (e i v)

noncomputable def pairKernel (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) : ℝ := ∏ v, codegree G (e i v) (e j v)

noncomputable def deletedKernel (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (v : V) (i j : I) : ℝ :=
  ∏ u ∈ univ.erase v, codegree G (e i u) (e j u)

lemma pairKernel_nonneg (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) : 0 ≤ pairKernel G e i j :=
  prod_nonneg (fun v _ => codegree_nonneg G _ _)

lemma deletedKernel_nonneg (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (v : V) (i j : I) : 0 ≤ deletedKernel G e v i j :=
  prod_nonneg (fun u _ => codegree_nonneg G _ _)

lemma feature_nonneg (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (x : V → W) (i : I) : 0 ≤ feature G e x i := by
  apply prod_nonneg
  intro v _
  simp only [SimpleGraph.adjMatrix_apply]
  split_ifs <;> norm_num

/-- Exact factorization: the feature Gram matrix is the product of the
corresponding-role codegrees, including diagonal and overlapping cores. -/
lemma feature_gram (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) :
    ((feature G e).transpose * feature G e) i j = pairKernel G e i j := by
  simp only [Matrix.mul_apply,Matrix.transpose_apply,feature,pairKernel,←prod_mul_distrib]
  rw [←Fintype.prod_sum (fun v x => G.adjMatrix ℝ x (e i v)*G.adjMatrix ℝ x (e j v))]
  apply prod_congr rfl
  intro v _
  exact (codegree_eq G _ _).symm

lemma pairKernel_le_deleted (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) (v : V) (t : ℕ)
    (hlight : (FourthMoment.common G univ (e i v) (e j v)).card<t) :
    pairKernel G e i j ≤ t * deletedKernel G e v i j := by
  have he : pairKernel G e i j = codegree G (e i v) (e j v)*deletedKernel G e v i j :=
    (mul_prod_erase univ (fun u => codegree G (e i u) (e j u)) (mem_univ v)).symm
  rw [he]
  apply mul_le_mul_of_nonneg_right _ (deletedKernel_nonneg G e v i j)
  unfold codegree
  exact_mod_cast hlight.le

open Classical in
noncomputable def overlapKernel (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) : ℝ :=
  ∑ u : V, ∑ v : V, if e i u=e j v then pairKernel G e i j else 0

lemma overlapKernel_nonneg (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) : 0 ≤ overlapKernel G e i j := by
  classical
  apply sum_nonneg
  intro u _
  apply sum_nonneg
  intro v _
  split_ifs
  · exact pairKernel_nonneg G e i j
  · exact le_rfl

lemma pairKernel_le_overlap (G : SimpleGraph W) [DecidableRel G.Adj]
    (e : I → V → W) (i j : I) (u v : V) (he : e i u=e j v) :
    pairKernel G e i j ≤ overlapKernel G e i j := by
  classical
  have h₁ : pairKernel G e i j ≤ ∑ v' : V, if e i u=e j v' then pairKernel G e i j else 0 := by
    have h := single_le_sum (s := (univ : Finset V))
      (f := fun v' => if e i u=e j v' then pairKernel G e i j else 0)
      (fun v' _ => by dsimp only; split_ifs; exact pairKernel_nonneg G e i j; exact le_rfl)
      (mem_univ v)
    simpa only [if_pos he] using h
  apply h₁.trans
  unfold overlapKernel
  exact single_le_sum (s := univ)
    (f := fun u' => ∑ v' : V, if e i u'=e j v' then pairKernel G e i j else 0)
    (fun u' _ => sum_nonneg (fun v' _ => by split_ifs; exact pairKernel_nonneg G e i j; exact le_rfl))
    (mem_univ u)

open Classical in
/-- Nonedges in the core-copy shadow give a quantitative product deletion,
with a separate term for every possible cross-role overlap. -/
lemma masked_kernel_bound [Nonempty V] (K : SimpleGraph V)
    (G : SimpleGraph W) [DecidableRel G.Adj] (e : I → K.Copy G) (t : ℕ) (i j : I) :
    (if ¬(CoreCopyShadow.graph K G t).Adj (e i) (e j) then
      pairKernel G (fun i v => e i v) i j else 0) ≤
      overlapKernel G (fun i v => e i v) i j +
        t * ∑ v, deletedKernel G (fun i v => e i v) v i j := by
  classical
  have ho := overlapKernel_nonneg G (fun i v => e i v) i j
  have hd : 0 ≤ (t:ℝ)*∑ v, deletedKernel G (fun i v => e i v) v i j :=
    mul_nonneg (Nat.cast_nonneg _) (sum_nonneg (fun v _ => deletedKernel_nonneg G _ _ _ _))
  by_cases ha : (CoreCopyShadow.graph K G t).Adj (e i) (e j)
  · rw [if_neg (not_not.mpr ha)]
    exact add_nonneg ho hd
  · rw [if_pos ha]
    rcases (CoreCopyShadow.nonadj_iff K G t (e i) (e j)).mp ha with ⟨u,v,h⟩|⟨v,h⟩
    · exact (pairKernel_le_overlap G _ i j u v h).trans (le_add_of_nonneg_right hd)
    · apply (pairKernel_le_deleted G _ i j v t h).trans
      have hh := single_le_sum (s := (univ : Finset V))
        (fun u _ => deletedKernel_nonneg G (fun i v => e i v) u i j) (mem_univ v)
      exact (mul_le_mul_of_nonneg_left hh (Nat.cast_nonneg t)).trans (le_add_of_nonneg_left ho)

open Classical in
/-- A whole-core analogue of the vertex fourth-moment restriction. It is an
unconditional consequence of actual forbidden-power freeness. The overlap
terms are explicit; this theorem does not assert that they are small. -/
theorem free_quadratic_bound {R : Type} [Fintype R] [Nonempty V]
    (K : SimpleGraph V) (attach : R → V) (M : ℕ) (hM : 2 ≤ M+Fintype.card R)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (CoreArms.template K attach) M).Free G)
    (e : I → K.Copy G) (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) :
    (∑ x : V → W, (∑ i, feature G (fun i v => e i v) x i*w i)^2) ≤
      (M+Fintype.card R-1:ℕ) * ∑ i, ∑ j,
        (overlapKernel G (fun i v => e i v) i j +
          CoreArms.threshold (V := V) (R := R) M *
            ∑ v, deletedKernel G (fun i v => e i v) v i j) * w i*w j := by
  classical
  let t := CoreArms.threshold (V := V) (R := R) M
  let S := CoreCopyShadow.graph K G t
  have h := HeavyCliqueMoments.quadratic_mask (feature G (fun i v => e i v))
    (feature_nonneg G _) (S.comap e) _ hM
    (HeavyFiberRestriction.cliqueFree_comap S e _ (CoreCopyShadow.cliqueFree K attach M G hf)) w hw
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  apply sum_le_sum
  intro i _
  apply sum_le_sum
  intro j _
  have hh := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right (masked_kernel_bound K G e t i j) (hw i)) (hw j)
  rw [feature_gram]
  by_cases ha : S.Adj (e i) (e j)
  · simpa only [SimpleGraph.comap_adj,S,ha,not_true_eq_false,if_false,zero_mul] using hh
  · simpa only [SimpleGraph.comap_adj,S,ha,not_false_eq_true,if_true] using hh

end Erdos571.CoreTensorMoments



/-! Finite nonnegative pushforward estimates with bounded role fibers. -/
namespace Erdos571.CorePushforward
open Finset
variable {I J U V : Type} [Fintype I] [Fintype J] [Fintype U] [Fintype V]
  [DecidableEq U] [DecidableEq V]

lemma sum_comp_le (e : I → U) (f : U → ℝ) (hf : ∀ u, 0 ≤ f u)
    (D : ℝ) (hD : ∀ u, (Nat.card {i : I // e i=u} : ℝ) ≤ D) :
    (∑ i, f (e i)) ≤ D * ∑ u, f u := by
  classical
  rw [FixedSigmaCounts.weighted_tag_sum,mul_sum]
  apply sum_le_sum
  intro u _
  apply mul_le_mul_of_nonneg_right _ (hf u)
  simpa only [Nat.card_eq_fintype_card] using hD u

lemma sum_pair_comp_le (e : I → U) (f : J → V) (K : U → V → ℝ)
    (hK : ∀ u v, 0 ≤ K u v) (D E : ℝ) (hE0 : 0 ≤ E)
    (he : ∀ u, (Nat.card {i : I // e i=u} : ℝ) ≤ D)
    (hf : ∀ v, (Nat.card {j : J // f j=v} : ℝ) ≤ E) :
    (∑ i, ∑ j, K (e i) (f j)) ≤ D*E*∑ u, ∑ v, K u v := by
  calc
    _ ≤ ∑ i, E * ∑ v, K (e i) v :=
      sum_le_sum (fun i _ => sum_comp_le f (K (e i)) (hK _) E hf)
    _ = ∑ v, E * ∑ i, K (e i) v := by simp only [mul_sum]; rw [sum_comm]
    _ ≤ ∑ v, E * (D * ∑ u, K u v) := by
      exact sum_le_sum (fun v _ => mul_le_mul_of_nonneg_left
        (sum_comp_le e (fun u => K u v) (fun u => hK u v) D he) hE0)
    _ = _ := by
      simp only [mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      ring

end Erdos571.CorePushforward


/-! Tensor moments for a core consisting of one edge. -/
set_option maxHeartbeats 3000000
namespace Erdos571.CoreEdgeTrace
open Finset SimpleGraph Matrix CoreTensorMoments
variable {W : Type} [Fintype W] [DecidableEq W]

/-- The two orientations of an actual edge are both used. -/
def role {G : SimpleGraph W} (d : G.Dart) : Bool → W
  | false => d.fst
  | true => d.snd

def copy (G : SimpleGraph W) (d : G.Dart) : (⊤ : SimpleGraph Bool).Copy G where
  toHom :=
    {toFun := role d
     map_rel' := by
      intro u v h
      have hn := (top_adj _ _).mp h
      cases u <;> cases v
      · exact (hn rfl).elim
      · exact d.adj
      · exact d.adj.symm
      · exact (hn rfl).elim}
  injective' := by
    intro u v he
    cases u <;> cases v
    · rfl
    · exact (d.fst_ne_snd he).elim
    · exact (d.snd_ne_fst he).elim
    · rfl

lemma role_fiber_card (G : SimpleGraph W) [DecidableRel G.Adj] (b : Bool) (u : W) :
    Nat.card {d : G.Dart // role d b=u}=G.degree u := by
  classical
  have hfalse : Nat.card {d : G.Dart // role d false=u}=G.degree u := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
    exact G.dart_fst_fiber_card_eq_degree u
  cases b
  · exact hfalse
  · let e : {d : G.Dart // role d true=u} ≃ {d : G.Dart // role d false=u} :=
      {toFun := fun d => ⟨d.val.symm,d.property⟩
       invFun := fun d => ⟨d.val.symm,d.property⟩
       left_inv := by intro d; apply Subtype.ext; exact d.val.symm_symm
       right_inv := by intro d; apply Subtype.ext; exact d.val.symm_symm}
    exact (Nat.card_congr e).trans hfalse

lemma adjacency_row (G : SimpleGraph W) [DecidableRel G.Adj] (u : W) :
    (∑ v, G.adjMatrix ℝ u v)=(G.degree u:ℝ) := by
  simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
    G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u)

lemma codegree_le (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℝ) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (u v : W) : codegree G u v ≤ D := by
  rw [codegree,HostHeavyShadow.common_univ_card]
  exact (show (Fintype.card (G.commonNeighbors u v):ℝ) ≤ G.degree u by
    exact_mod_cast G.card_commonNeighbors_le_degree_left u v).trans (hdeg u)

lemma codegree_total (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) :
    (∑ u, ∑ v, codegree G u v) ≤ Fintype.card W * D^2 := by
  have hrow (u : W) : (∑ v, codegree G u v) ≤ D^2 := by
    have he (u v : W) : codegree G u v=(G.adjMatrix ℝ * G.adjMatrix ℝ) u v := by
      rw [codegree,HostHeavyShadow.common_univ_card,LayeredBush.adjacency_square_common_card]
    simp_rw [he]
    have hA (u v : W) : 0 ≤ G.adjMatrix ℝ u v := by
      simp only [SimpleGraph.adjMatrix_apply]; split_ifs <;> norm_num
    have hh := GramFeatures.chain_row_upper hA hD
      (fun u => (adjacency_row G u).le.trans (hdeg u))
      (fun u => (adjacency_row G u).le.trans (hdeg u)) u
    simpa only [pow_two] using hh
  exact (sum_le_sum (fun u _ => hrow u)).trans_eq (by simp)

lemma pairKernel_le (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (d e : G.Dart) :
    pairKernel G role d e ≤ D^2 := by
  simp only [pairKernel,Fintype.prod_bool]
  exact (mul_le_mul (codegree_le G D hdeg _ _) (codegree_le G D hdeg _ _)
    (codegree_nonneg G _ _) hD).trans_eq (pow_two D).symm

lemma deletedKernel_pair_sum (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (b : Bool) :
    (∑ d : G.Dart, ∑ e : G.Dart, deletedKernel G role b d e) ≤ Fintype.card W * D^4 := by
  have he (d e : G.Dart) : deletedKernel G role b d e = codegree G (role d (!b)) (role e (!b)) := by
    have h₀ : (univ : Finset Bool).erase false={true} := by decide
    have h₁ : (univ : Finset Bool).erase true={false} := by decide
    cases b <;> simp only [deletedKernel,h₀,h₁,prod_singleton,Bool.not_false,Bool.not_true]
  simp_rw [he]
  have hf (u : W) : (Nat.card {d : G.Dart // role d (!b)=u}:ℝ) ≤ D := by
    rw [role_fiber_card]
    exact hdeg u
  have h := CorePushforward.sum_pair_comp_le (fun d : G.Dart => role d (!b))
    (fun d : G.Dart => role d (!b)) (codegree G) (codegree_nonneg G) D D hD hf hf
  apply h.trans
  have hh := mul_le_mul_of_nonneg_left (codegree_total G D hD hdeg) (mul_nonneg hD hD)
  exact hh.trans_eq (by ring)

lemma overlap_one_sum (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (a b : Bool) :
    (∑ d : G.Dart, ∑ e : G.Dart, if role d a=role e b then pairKernel G role d e else 0) ≤
      Fintype.card W * D^4 := by
  classical
  have hu (u : W) : (Nat.card {d : G.Dart // role d a=u}:ℝ) ≤ D := by
    rw [role_fiber_card]; exact hdeg u
  have hv (u : W) : (Nat.card {d : G.Dart // role d b=u}:ℝ) ≤ D := by
    rw [role_fiber_card]; exact hdeg u
  have hh := CorePushforward.sum_pair_comp_le (fun d : G.Dart => role d a)
    (fun e : G.Dart => role e b) (fun u v => if u=v then (1:ℝ) else 0)
    (by intro u v; dsimp only; split_ifs <;> norm_num) D D hD hu hv
  have hn : (∑ u : W, ∑ v : W, if u=v then (1:ℝ) else 0) = Fintype.card W := by simp
  rw [hn] at hh
  have hbound : (∑ d : G.Dart, ∑ e : G.Dart, if role d a=role e b then pairKernel G role d e else 0) ≤
      D^2 * ∑ d : G.Dart, ∑ e : G.Dart, if role d a=role e b then (1:ℝ) else 0 := by
    simp only [mul_sum]
    apply sum_le_sum
    intro d _
    apply sum_le_sum
    intro e _
    split_ifs
    · simpa only [mul_one] using pairKernel_le G D hD hdeg d e
    · simp
  exact hbound.trans ((mul_le_mul_of_nonneg_left hh (sq_nonneg D)).trans_eq (by ring))

lemma overlap_pair_sum (G : SimpleGraph W) [DecidableRel G.Adj]
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) :
    (∑ d : G.Dart, ∑ e : G.Dart, overlapKernel G role d e) ≤ 4*Fintype.card W * D^4 := by
  classical
  simp only [overlapKernel,Fintype.sum_bool,sum_add_distrib]
  have h₁ := overlap_one_sum G D hD hdeg true true
  have h₂ := overlap_one_sum G D hD hdeg true false
  have h₃ := overlap_one_sum G D hD hdeg false true
  have h₄ := overlap_one_sum G D hD hdeg false false
  linarith

end Erdos571.CoreEdgeTrace


/-! An unrestricted almost-regular degree bound for edge cores with
arbitrarily many length-two root arms. -/
set_option maxHeartbeats 3000000
namespace Erdos571.CoreEdgeTrace
open Finset SimpleGraph Matrix CoreTensorMoments
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def energy (G : SimpleGraph W) [DecidableRel G.Adj] : ℝ :=
  ∑ x : Bool → W, (∑ d : G.Dart, feature G role x d)^2

lemma column_mass (G : SimpleGraph W) [DecidableRel G.Adj] (d : G.Dart) :
    (∑ x : Bool → W, feature G role x d) = (G.degree d.snd:ℝ) * G.degree d.fst := by
  unfold feature
  rw [←Fintype.prod_sum (fun b w => G.adjMatrix ℝ w (role d b))]
  have he (b : Bool) : (∑ w, G.adjMatrix ℝ w (role d b)) = (G.degree (role d b):ℝ) := by
    calc
      _ = ∑ w, G.adjMatrix ℝ (role d b) w :=
        sum_congr rfl (fun w _ => G.isSymm_adjMatrix.apply _ _)
      _ = _ := adjacency_row G _
  rw [Fintype.prod_bool]
  exact congrArg₂ (· * ·) (he true) (he false)

lemma total_mass_lower (G : SimpleGraph W) [DecidableRel G.Adj]
    (d : ℝ) (hd : 0 ≤ d) (hmin : ∀ u, d ≤ (G.degree u:ℝ)) :
    Fintype.card W * d^3 ≤ ∑ x : Bool → W, ∑ e : G.Dart, feature G role x e := by
  rw [sum_comm]
  simp_rw [column_mass]
  have hc : Fintype.card W*d ≤ (Fintype.card G.Dart:ℝ) := by
    rw [G.dart_card_eq_sum_degrees,Nat.cast_sum]
    exact (show Fintype.card W*d=∑ _u : W, d by simp).trans_le
      (sum_le_sum (fun u _ => hmin u))
  calc
    _ = (Fintype.card W*d)*d^2 := by ring
    _ ≤ (Fintype.card G.Dart:ℝ)*d^2 := mul_le_mul_of_nonneg_right hc (sq_nonneg d)
    _ = ∑ _e : G.Dart, d^2 := by simp
    _ ≤ _ := sum_le_sum (fun e _ => by
      simpa only [pow_two] using mul_le_mul (hmin e.snd) (hmin e.fst) hd (Nat.cast_nonneg _))

lemma energy_lower [Nonempty W] (G : SimpleGraph W) [DecidableRel G.Adj]
    (d : ℝ) (hd : 0 ≤ d) (hmin : ∀ u, d ≤ (G.degree u:ℝ)) :
    d^6 ≤ energy G := by
  have hn : (0:ℝ)<Fintype.card W := by exact_mod_cast Fintype.card_pos
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (Bool → W)))
    (f := fun x => ∑ e : G.Dart, feature G role x e)
  simp only [card_univ,Fintype.card_fun,Fintype.card_bool,Nat.cast_pow] at hc
  have hl := pow_le_pow_left₀ (by positivity : 0 ≤ (Fintype.card W:ℝ)*d^3)
    (total_mass_lower G d hd hmin) 2
  have hh : (Fintype.card W:ℝ)^2*d^6 ≤ (Fintype.card W:ℝ)^2*energy G := by
    apply (show (Fintype.card W:ℝ)^2*d^6=((Fintype.card W:ℝ)*d^3)^2 by ring).le.trans
    exact hl.trans hc
  exact (mul_le_mul_iff_of_pos_left (pow_pos hn 2)).mp hh

noncomputable def coefficient {R : Type} [Fintype R] (M : ℕ) : ℝ :=
  (M+Fintype.card R-1:ℕ) * (4+2*(CoreArms.threshold (V := Bool) (R := R) M:ℝ))

lemma coefficient_nonneg {R : Type} [Fintype R] (M : ℕ) :
    0 ≤ coefficient (R := R) M := by unfold coefficient; positivity

/-- The upper sixth-walk energy bound follows from whole-core clique
freeness, not a global bound on the host's individual codegrees. -/
theorem energy_upper {R : Type} [Fintype R] (attach : R → Bool) (M : ℕ)
    (hM : 2 ≤ M+Fintype.card R) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (CoreArms.template (⊤ : SimpleGraph Bool) attach) M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) :
    energy G ≤ coefficient (R := R) M * Fintype.card W * D^4 := by
  classical
  let t := CoreArms.threshold (V := Bool) (R := R) M
  have h := free_quadratic_bound (⊤ : SimpleGraph Bool) attach M hM G hf
    (copy G) (fun _ => (1:ℝ)) (by simp)
  simp only [mul_one] at h
  change energy G ≤ (M+Fintype.card R-1:ℕ)*
    ∑ d : G.Dart, ∑ e : G.Dart,
      (overlapKernel G role d e + (t:ℝ)*∑ v, deletedKernel G role v d e) at h
  simp only [sum_add_distrib,Fintype.sum_bool,mul_add,←mul_sum] at h
  have ho := overlap_pair_sum G D hD hdeg
  have ht := deletedKernel_pair_sum G D hD hdeg true
  have hf' := deletedKernel_pair_sum G D hD hdeg false
  have hb :
      (∑ d : G.Dart, ∑ e : G.Dart, overlapKernel G role d e) +
        (t:ℝ)*(∑ d : G.Dart, ∑ e : G.Dart, deletedKernel G role true d e) +
        (t:ℝ)*(∑ d : G.Dart, ∑ e : G.Dart, deletedKernel G role false d e) ≤
      (4+2*(t:ℝ))*Fintype.card W*D^4 := by
    have h₁ := mul_le_mul_of_nonneg_left ht (Nat.cast_nonneg t)
    have h₂ := mul_le_mul_of_nonneg_left hf' (Nat.cast_nonneg t)
    nlinarith
  have hh := mul_le_mul_of_nonneg_left hb (Nat.cast_nonneg (M+Fintype.card R-1))
  unfold coefficient
  apply h.trans
  convert hh using 1 <;> ring

/-- Unrestricted core-arm degree estimate: every nonempty almost-regular
forbidden-free host has `d^2 = O(n)`. This is not the sharp rooted-density
exponent for double spiders. -/
theorem free_degree_bound {R : Type} [Fintype R] [Nonempty W]
    (attach : R → Bool) (M : ℕ) (hM : 2 ≤ M+Fintype.card R)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (CoreArms.template (⊤ : SimpleGraph Bool) attach) M).Free G)
    (K d : ℝ) (hK : 0 ≤ K) (hd : 0 < d)
    (hdeg : ∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) :
    d^2 ≤ coefficient (R := R) M * K^4 * Fintype.card W := by
  have h := (energy_lower G d hd.le (fun u => (hdeg u).1)).trans
    (energy_upper attach M hM G hf (K*d) (mul_nonneg hK hd.le) (fun u => (hdeg u).2))
  have he : d^6=d^2*d^4 := by ring
  rw [he,mul_pow] at h
  apply (mul_le_mul_iff_of_pos_right (pow_pos hd 4)).mp
  convert h using 1 <;> ring

end Erdos571.CoreEdgeTrace


/-! Ordinary three-halves upper bounds for edge cores decorated with
length-two root arms. The host is unrestricted. -/
set_option maxHeartbeats 3000000
namespace Erdos571.CoreEdgeTrace
open Finset SimpleGraph DensityRegularization

 theorem regular_bound {R : Type} [Fintype R] (attach : R → Bool) (M : ℕ)
    (hM : 2 ≤ M+Fintype.card R) (Q : ℝ) (hQ : 0 ≤ Q) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ {W : Type} [Fintype W] [DecidableEq W]
        (G : SimpleGraph W) [DecidableRel G.Adj],
        (FullRootedPower.graph (CoreArms.template (⊤ : SimpleGraph Bool) attach) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ C*(U.card:ℝ)^(3/2:ℝ) := by
  let A := coefficient (R := R) M*Q^4
  have hA : 0 ≤ A := mul_nonneg (coefficient_nonneg M) (pow_nonneg hQ _)
  let B := A^(1/2:ℝ)
  have hB : 0 ≤ B := Real.rpow_nonneg hA _
  refine ⟨Q*B,mul_nonneg hQ hB,?_⟩
  intro W _ _ G _ hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  letI : Nonempty ↥U := hU.to_subtype
  let H := G.induce (U:Set W)
  have hfree : (FullRootedPower.graph (CoreArms.template (⊤ : SimpleGraph Bool) attach) M).Free H :=
    fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
  have h := free_degree_bound attach M hM H hfree Q d hQ hd (fun v => by
    simpa only [H,TreeCopiesIn.induce_degree] using hdeg v.val v.property)
  have hc : Fintype.card ↑(U:Set W)=U.card := by simp
  rw [hc] at h
  have hn : (0:ℝ)<U.card := by exact_mod_cast hU.card_pos
  have hdpow : d ≤ B*(U.card:ℝ)^(1/2:ℝ) := by
    have hh := LongSpider.degree_of_power 2 1 (by omega) hn.le hd.le hA
      (show d^2 ≤ A*(U.card:ℝ)^1 by simpa only [A,pow_one] using h)
    norm_num only [Nat.cast_ofNat, Nat.cast_one, one_div] at hh
    exact hh
  have he : ((arcs G U).card:ℝ)=∑ v∈U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v∈U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*(B*(U.card:ℝ)^(1/2:ℝ)) :=
      mul_le_mul_of_nonneg_left hdpow (mul_nonneg hn.le hQ)
    _ = _ := by
      rw [show (3/2:ℝ)=1+1/2 by norm_num,Real.rpow_add hn,Real.rpow_one]
      ring

/-- This upper bound applies to every finite host, with no regularity,
bipartiteness, or codegree assumptions on the original host. -/
theorem edge_bound {R : Type} [Fintype R] (attach : R → Bool) (M : ℕ)
    (hM : 2 ≤ M+Fintype.card R) :
    ∃ C : ℝ, 0 ≤ C ∧ ProjectionHeavy.EdgeBound
      (FullRootedPower.graph (CoreArms.template (⊤ : SimpleGraph Bool) attach) M) (3/2:ℝ) C := by
  obtain ⟨C,hC,hreg⟩ := regular_bound attach M hM (8*256) (by norm_num)
  refine ⟨4*C,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  have hpow : (16:ℝ) ≤ 256^((3/2:ℝ)-1) := by
    norm_num [←Real.sqrt_eq_rpow]
  have h := bound_of_almost_regular G univ (β := (3/2:ℝ)) (K := (256:ℝ)) (D := C)
    (by norm_num) (by norm_num) (by norm_num) hpow hC (by
      intro T hT d hd hdeg
      exact hreg G hf T d hd hdeg)
  have he : (arcs G univ).card=2*Nat.card G.edgeSet := by
    rw [arcs_sum]
    have hneigh (w : W) : neighbors G univ w=G.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hneigh,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using G.sum_degrees_eq_twice_card_edges
  rw [he,card_univ,Nat.cast_mul,Nat.cast_ofNat] at h
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card G.edgeSet:ℝ) by nlinarith [show (0:ℝ) ≤ Nat.card G.edgeSet from Nat.cast_nonneg _]).trans h

end Erdos571.CoreEdgeTrace

namespace Erdos571.DoubleSpider
open SimpleGraph

lemma coreArms_eq (p q : ℕ) :
    CoreArms.template (⊤ : SimpleGraph Bool) (side (p := p) (q := q))=template p q := by
  ext u v
  rcases u with (c|r)|r <;> rcases v with (d|s)|s <;> first | rfl | exact eq_comm

/-- A new unrestricted ordinary upper bound; it is not claimed sharp. -/
theorem unrestricted_three_halves_upper (p q M : ℕ) (hM : 2 ≤ M) :
    ∃ C : ℝ, 0 ≤ C ∧ ProjectionHeavy.EdgeBound (graph p q M) (3/2:ℝ) C := by
  have h := CoreEdgeTrace.edge_bound (side (p := p) (q := q)) M (by omega)
  rw [coreArms_eq] at h
  exact h

/-- Both bounds concern the same fixed graph. The two exponents are not
asserted equal. -/
theorem lower_and_three_halves_upper (p q : ℕ) (hsum : 1 ≤ p+q)
    (hpq : q ≤ 2*p+1) (hqp : p ≤ 2*q+1) :
    ∃ M : ℕ, 2 ≤ M ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(2-((p+q+2:ℕ):ℝ)/((2*(p+q)+1:ℕ):ℝ)))
        (fun n : ℕ => (extremalNumber n (graph p q M):ℝ)) ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (extremalNumber n (graph p q M):ℝ))
        (fun n : ℕ => (n:ℝ)^(3/2:ℝ)) := by
  obtain ⟨M,hM,hl⟩ := exists_lower p q hsum hpq hqp
  obtain ⟨C,hC,hu⟩ := unrestricted_three_halves_upper p q M hM
  exact ⟨M,hM,hl,ProjectionHeavy.EdgeBound.extremal_isBigO _ hC hu⟩

theorem twentyfour_seventeen_bounds :
    ∃ M : ℕ, 2 ≤ M ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(24/17:ℝ))
        (fun n : ℕ => (extremalNumber n (graph 4 4 M):ℝ)) ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (extremalNumber n (graph 4 4 M):ℝ))
        (fun n : ℕ => (n:ℝ)^(3/2:ℝ)) := by
  have h := lower_and_three_halves_upper 4 4 (by omega) (by omega) (by omega)
  norm_num at h
  exact h

end Erdos571.DoubleSpider



/-! Add length-two root arms while preserving all old root incidences. -/
set_option maxHeartbeats 3000000
namespace Erdos571.RootedCoreArms
open Finset SimpleGraph
variable {A R S W : Type} [Fintype A] [Fintype R] [Fintype S]
  [Fintype W] [DecidableEq W]

def incidence (E : A → R → Prop) : A ⊕ S → R ⊕ S → Prop
  | .inl a,.inl r => E a r
  | .inr s,.inr t => s=t
  | _,_ => False

def template (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A) :
    SimpleGraph ((A ⊕ S) ⊕ (R ⊕ S)) :=
  RootedIncidence.graph (LeafRooted.graph K attach) (incidence E)

abbrev Branch (M : ℕ) := (Fin M × A) ⊕ (R ⊕ S)
abbrev Middle (M : ℕ) := Fin M × S

def threshold (M : ℕ) : ℕ :=
  M*Fintype.card A + Fintype.card R + Fintype.card S + M*Fintype.card S

/-- Preserve old incidences and greedily lift all the new arms. -/
theorem contains_of_branch_map (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A)
    (M : ℕ) (G : SimpleGraph W) [DecidableRel G.Adj]
    (f : Branch (A := A) (R := R) (S := S) M → W) (hf : Function.Injective f)
    (hcore : ∀ k a b, K.Adj a b → G.Adj (f (.inl (k,a))) (f (.inl (k,b))))
    (hold : ∀ k a r, E a r → G.Adj (f (.inl (k,a))) (f (.inr (.inl r))))
    (hheavy : ∀ k s, threshold (A := A) (R := R) (S := S) M ≤
      (FourthMoment.common G univ (f (.inl (k,attach s))) (f (.inr (.inr s)))).card) :
    FullRootedPower.graph (template K E attach) M ⊑ G := by
  classical
  let Z : Finset W := univ.image f
  let F : Middle (S := S) M → Finset W := fun p =>
    FourthMoment.common G univ (f (.inl (p.1,attach p.2))) (f (.inr (.inr p.2)))
  have hZ : Z.card ≤ M*Fintype.card A + Fintype.card R + Fintype.card S := by
    have h := card_image_le (s := (univ : Finset (Branch (A := A) (R := R) (S := S) M))) (f := f)
    simpa only [card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,Nat.add_assoc] using h
  obtain ⟨g,hg,hgF⟩ := ShortSpider.select_avoiding F Z (by
    intro p
    have h := hheavy p.1 p.2
    simp only [Middle,Fintype.card_prod,Fintype.card_fin]
    dsimp only [threshold] at h
    dsimp only [F]
    omega)
  have hgf (p : Middle (S := S) M) (b : Branch (A := A) (R := R) (S := S) M) : g p ≠ f b := by
    intro he
    exact (hgF p).2 (mem_image.mpr ⟨b,mem_univ _,he.symm⟩)
  have hadj (k : Fin M) (s : S) :
      G.Adj (f (.inl (k,attach s))) (g (k,s)) ∧ G.Adj (g (k,s)) (f (.inr (.inr s))) := by
    have h := (hgF (k,s)).1
    change g (k,s) ∈ FourthMoment.common G univ _ _ at h
    simp only [FourthMoment.common,mem_filter,mem_univ,true_and] at h
    exact ⟨h.1,h.2.symm⟩
  let e : ((Fin M × (A ⊕ S)) ⊕ (R ⊕ S)) → W
    | .inl (k,.inl a) => f (.inl (k,a))
    | .inl (k,.inr s) => g (k,s)
    | .inr r => f (.inr r)
  refine ⟨{toHom := {toFun := e, map_rel' := ?_}, injective' := ?_}⟩
  · rintro (⟨k,(a|s)⟩|(r|s)) (⟨l,(b|t)⟩|(r'|t)) h
    all_goals dsimp only [e]
    · change k=l ∧ K.Adj a b at h
      obtain ⟨hkl,h⟩ := h
      subst l
      exact hcore k a b h
    · change k=l ∧ a=attach t at h
      obtain ⟨hkl,h⟩ := h
      subst l
      subst a
      exact (hadj k t).1
    · exact hold k a r' h
    · exact h.elim
    · change k=l ∧ b=attach s at h
      obtain ⟨hkl,h⟩ := h
      subst l
      subst b
      exact (hadj k s).1.symm
    · exact h.2.elim
    · exact h.elim
    · change s=t at h
      subst t
      exact (hadj k s).2
    · exact (hold l b r h).symm
    · exact h.elim
    · exact h.elim
    · exact h.elim
    · exact h.elim
    · change t=s at h
      subst s
      exact (hadj l t).2.symm
    · exact h.elim
    · exact h.elim
  · rintro (⟨k,(a|s)⟩|r) (⟨l,(b|t)⟩|r') h
    all_goals dsimp only [e] at h
    · have hh := Sum.inl.inj (hf h)
      obtain ⟨rfl,rfl⟩ := Prod.mk.inj hh
      rfl
    · exact (hgf (l,t) (.inl (k,a)) h.symm).elim
    · exact (Sum.inl_ne_inr (hf h)).elim
    · exact (hgf (k,s) (.inl (l,b)) h).elim
    · have hh := hg h
      obtain ⟨rfl,rfl⟩ := Prod.mk.inj hh
      rfl
    · exact (hgf (k,s) (.inr r') h).elim
    · exact (Sum.inr_ne_inl (hf h)).elim
    · exact (hgf (l,t) (.inr r) h.symm).elim
    · exact congrArg Sum.inr (Sum.inr.inj (hf h))

end Erdos571.RootedCoreArms


/-! Conditional heavy shadows with old roots fixed. Only the core roles
receiving new arms are required to have heavy corresponding codegrees. -/
set_option maxHeartbeats 3000000
namespace Erdos571.RootedCoreShadow
open Finset SimpleGraph
variable {A R S W : Type} [Fintype A] [Fintype R] [Fintype S]
  [Fintype W] [DecidableEq W] [Nonempty A]

def graph (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A)
    (G : SimpleGraph W) [DecidableRel G.Adj] (t : ℕ) :
    SimpleGraph ((RootedIncidence.graph K E).Copy G) where
  Adj f g := (∀ r, f (.inr r)=g (.inr r)) ∧
    (∀ a b, f (.inl a)≠g (.inl b)) ∧
    ∀ s, t ≤ (FourthMoment.common G univ (f (.inl (attach s))) (g (.inl (attach s)))).card
  symm := by
    intro f g h
    refine ⟨fun r => (h.1 r).symm,fun a b => (h.2.1 b a).symm,?_⟩
    intro s
    have he : FourthMoment.common G univ (g (.inl (attach s))) (f (.inl (attach s))) =
        FourthMoment.common G univ (f (.inl (attach s))) (g (.inl (attach s))) := by
      ext w; simp [FourthMoment.common,and_comm]
    rw [he]
    exact h.2.2 s
  loopless := by
    intro f h
    exact h.2.1 (Classical.arbitrary A) (Classical.arbitrary A) rfl

/-- All clique members agree at old roots, so the new root images can be
chosen from extra core copies without changing those old images. -/
theorem contains_of_clique_copy (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A)
    (M : ℕ) (hM : 1 ≤ M) (G : SimpleGraph W) [DecidableRel G.Adj]
    (c : (⊤ : SimpleGraph (Fin M ⊕ S)).Copy
      (graph K E attach G (RootedCoreArms.threshold (A := A) (R := R) (S := S) M))) :
    FullRootedPower.graph (RootedCoreArms.template K E attach) M ⊑ G := by
  classical
  let i₀ : Fin M ⊕ S := .inl ⟨0,by omega⟩
  let old : R → W := fun r => c i₀ (.inr r)
  have hold (i : Fin M ⊕ S) (r : R) : c i (.inr r)=old r := by
    by_cases hi : i=i₀
    · subst i; rfl
    · exact (c.toHom.map_adj ((top_adj _ _).mpr hi)).1 r
  have holdinj : Function.Injective old := by
    intro r r' he
    exact Sum.inr.inj ((c i₀).injective he)
  let aux : (Fin M ⊕ S) × A → W := fun p => c p.1 (.inl p.2)
  have haux : Function.Injective aux := by
    intro p q he
    by_cases hpq : p.1=q.1
    · apply Prod.ext hpq
      apply Sum.inl.inj
      apply (c p.1).injective
      simpa only [aux,hpq] using he
    · exact ((c.toHom.map_adj ((top_adj _ _).mpr hpq)).2.1 p.2 q.2 he).elim
  have havoid (p : (Fin M ⊕ S) × A) (r : R) : aux p≠old r := by
    intro he
    rw [←hold p.1 r] at he
    exact Sum.inl_ne_inr ((c p.1).injective he)
  let f : RootedCoreArms.Branch (A := A) (R := R) (S := S) M → W
    | .inl (k,a) => aux (.inl k,a)
    | .inr (.inl r) => old r
    | .inr (.inr s) => aux (.inr s,attach s)
  have hf : Function.Injective f := by
    rintro (⟨k,a⟩|(r|s)) (⟨l,b⟩|(r'|s')) he
    all_goals dsimp only [f] at he
    · have h := haux he
      obtain ⟨h₁,h₂⟩ := Prod.mk.inj h
      exact congrArg Sum.inl (Prod.ext (Sum.inl.inj h₁) h₂)
    · exact (havoid (.inl k,a) r' he).elim
    · exact (Sum.inl_ne_inr (congrArg Prod.fst (haux he))).elim
    · exact (havoid (.inl l,b) r he.symm).elim
    · exact congrArg (fun r => Sum.inr (Sum.inl r)) (holdinj he)
    · exact (havoid (.inr s',attach s') r he.symm).elim
    · exact (Sum.inr_ne_inl (congrArg Prod.fst (haux he))).elim
    · exact (havoid (.inr s,attach s) r' he).elim
    · exact congrArg (fun s => Sum.inr (Sum.inr s)) (Sum.inr.inj (congrArg Prod.fst (haux he)))
  apply RootedCoreArms.contains_of_branch_map K E attach M G f hf
  · intro k a b h
    exact (c (.inl k)).toHom.map_adj (show (RootedIncidence.graph K E).Adj (.inl a) (.inl b) from h)
  · intro k a r h
    have hh := (c (.inl k)).toHom.map_adj (show (RootedIncidence.graph K E).Adj (.inl a) (.inr r) from h)
    change G.Adj (c (.inl k) (.inl a)) (c (.inl k) (.inr r)) at hh
    rw [hold (.inl k) r] at hh
    exact hh
  · intro k s
    exact (c.toHom.map_adj ((top_adj _ _).mpr Sum.inl_ne_inr)).2.2 s

/-- Actual rooted-power freeness implies clique-freeness of the conditional
shadow, with no assumption that the old rooted template is itself absent. -/
theorem cliqueFree (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A)
    (M : ℕ) (hM : 1 ≤ M) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (RootedCoreArms.template K E attach) M).Free G) :
    (graph K E attach G (RootedCoreArms.threshold (A := A) (R := R) (S := S) M)).CliqueFree
      (M+Fintype.card S) := by
  have he : M+Fintype.card S=Fintype.card (Fin M ⊕ S) := by simp
  rw [he]
  apply cliqueFree_iff_top_free.mpr
  rintro ⟨c⟩
  exact hf (contains_of_clique_copy K E attach M hM G c)

lemma nonadj_of_same_roots (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A)
    (G : SimpleGraph W) [DecidableRel G.Adj] (t : ℕ)
    (f g : (RootedIncidence.graph K E).Copy G)
    (hroot : ∀ r, f (.inr r)=g (.inr r)) :
    ¬(graph K E attach G t).Adj f g ↔
      (∃ a b, f (.inl a)=g (.inl b)) ∨
        ∃ s, (FourthMoment.common G univ (f (.inl (attach s))) (g (.inl (attach s)))).card<t := by
  classical
  change ¬((∀ r, f (.inr r)=g (.inr r)) ∧ _ ∧ _) ↔ _
  simp only [hroot,forall_const,true_and,not_and_or,not_forall,not_not,not_le,not_true_eq_false,exists_false,false_or]

open Classical in
/-- A root-fiber pair restriction with only the newly attached roles as
light alternatives. Every old-nonroot overlap remains explicitly counted. -/
theorem family_restriction {J : Type} [Fintype J]
    (F : J → Type) [∀ j, Fintype (F j)]
    (K : SimpleGraph A) (E : A → R → Prop) (attach : S → A)
    (M : ℕ) (hM : 1 ≤ M) (hk : 2 ≤ M+Fintype.card S)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (RootedCoreArms.template K E attach) M).Free G)
    (e : Sigma F → (RootedIncidence.graph K E).Copy G)
    (hroot : ∀ f g : Sigma F, f.1=g.1 → ∀ r, e f (.inr r)=e g (.inr r)) :
    Nat.card (FiberRestrictionEnergy.Agreement F) ≤
      (M+Fintype.card S-1) *
        ((∑ a : A, ∑ b : A, Nat.card {p : Sigma F × Sigma F //
          p.1.1=p.2.1 ∧ e p.1 (.inl a)=e p.2 (.inl b)}) +
          ∑ s : S, Nat.card {p : Sigma F × Sigma F //
            p.1.1=p.2.1 ∧ (FourthMoment.common G univ
              (e p.1 (.inl (attach s))) (e p.2 (.inl (attach s)))).card <
                RootedCoreArms.threshold (A := A) (R := R) (S := S) M}) := by
  classical
  let t := RootedCoreArms.threshold (A := A) (R := R) (S := S) M
  let Q : (A×A) ⊕ S → (Sigma F × Sigma F) → Prop
    | .inl (a,b),p => p.1.1=p.2.1 ∧ e p.1 (.inl a)=e p.2 (.inl b)
    | .inr s,p => p.1.1=p.2.1 ∧ (FourthMoment.common G univ
        (e p.1 (.inl (attach s))) (e p.2 (.inl (attach s)))).card<t
  have h := HeavyFiberRestriction.family_pairs F (graph K E attach G t) e _ hk
    (cliqueFree K E attach M hM G hf)
  have hc := FiniteEventUnion.card_le_sum
    (fun p : Sigma F × Sigma F => p.1.1=p.2.1 ∧ ¬(graph K E attach G t).Adj (e p.1) (e p.2)) Q
    (by
      intro p hp
      rcases (nonadj_of_same_roots K E attach G t (e p.1) (e p.2) (hroot _ _ hp.1)).mp hp.2 with
        ⟨a,b,h⟩|⟨s,h⟩
      · exact ⟨.inl (a,b),hp.1,h⟩
      · exact ⟨.inr s,hp.1,h⟩)
  simp only [Fintype.sum_sum_type,Fintype.sum_prod_type,Q] at hc
  simp only [←Nat.card_eq_fintype_card] at h hc ⊢
  exact h.trans (Nat.mul_le_mul_left (M+Nat.card S-1) hc)

end Erdos571.RootedCoreShadow


/-! A one-hub conditional heavy shadow for double-spider powers. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpiderRootedShadow
open Finset SimpleGraph

abbrev Interior (p : ℕ) := Bool ⊕ Fin p

def core (p : ℕ) : SimpleGraph (Interior p) :=
  RootedIncidence.graph (⊤ : SimpleGraph Bool) (fun b (_ : Fin p) => b=false)

def oldIncidence (p : ℕ) : Interior p → Fin p → Prop := fun a r => a=.inr r

def oldTemplate (p : ℕ) := RootedIncidence.graph (core p) (oldIncidence p)

def attach (p q : ℕ) : Fin q → Interior p := fun _ => .inl true

lemma relabel_adj (p q : ℕ) :
    ∀ u v, (RootedCoreArms.template (core p) (oldIncidence p) (attach p q)).Adj u v ↔
      (DoubleSpider.template p q).Adj
        (Sum.map (Equiv.sumAssoc Bool (Fin p) (Fin q)) id u)
        (Sum.map (Equiv.sumAssoc Bool (Fin p) (Fin q)) id v) := by
  rintro (((b|i)|j)|(i|j)) (((b'|i')|j')|(i'|j'))
  all_goals simp [RootedCoreArms.template,RootedCoreArms.incidence,core,oldIncidence,attach,
    LeafRooted.graph,RootedIncidence.graph,DoubleSpider.template,DoubleSpider.core,DoubleSpider.side,
    Equiv.sumAssoc,eq_comm]

def powerIso (p q M : ℕ) :
    FullRootedPower.graph (RootedCoreArms.template (core p) (oldIncidence p) (attach p q)) M ≃g
      DoubleSpider.graph p q M :=
  FullRootedPower.isoOfRelabel _ _ (Equiv.sumAssoc Bool (Fin p) (Fin q)) (Equiv.refl _)
    (relabel_adj p q) M

variable {W : Type} [Fintype W] [DecidableEq W]

/-- New arms all attach to the right hub. Within a fixed left-root fiber,
the only light-codegree alternative is therefore at that specified hub. -/
theorem cliqueFree (p q M : ℕ) (hM : 1 ≤ M)
    (G : SimpleGraph W) [DecidableRel G.Adj] (hf : (DoubleSpider.graph p q M).Free G) :
    (RootedCoreShadow.graph (core p) (oldIncidence p) (attach p q) G
      (RootedCoreArms.threshold (A := Interior p) (R := Fin p) (S := Fin q) M)).CliqueFree (M+q) := by
  have hf' : (FullRootedPower.graph
      (RootedCoreArms.template (core p) (oldIncidence p) (attach p q)) M).Free G :=
    fun h => hf ((powerIso p q M).symm.isContained.trans h)
  simpa only [Fintype.card_fin] using RootedCoreShadow.cliqueFree
    (core p) (oldIncidence p) (attach p q) M hM G hf'

lemma nonadj_iff (p q : ℕ) (hq : 1 ≤ q)
    (G : SimpleGraph W) [DecidableRel G.Adj] (t : ℕ)
    (f g : (oldTemplate p).Copy G) (hroot : ∀ r, f (.inr r)=g (.inr r)) :
    ¬(RootedCoreShadow.graph (core p) (oldIncidence p) (attach p q) G t).Adj f g ↔
      (∃ a b, f (.inl a)=g (.inl b)) ∨
        (FourthMoment.common G univ (f (.inl (.inl true))) (g (.inl (.inl true)))).card<t := by
  letI : Nonempty (Fin q) := ⟨⟨0,by omega⟩⟩
  simpa only [attach,exists_const] using RootedCoreShadow.nonadj_of_same_roots
    (core p) (oldIncidence p) (attach p q) G t f g hroot

end Erdos571.DoubleSpiderRootedShadow


/-! A specified-role quadratic estimate inside one fixed old-root fiber.
Its error terms are all old-nonroot overlaps, not global codegree excesses. -/
set_option maxHeartbeats 3000000
namespace Erdos571.RootedCoreShadow
open Finset SimpleGraph Matrix CoreTensorMoments
variable {A R S W I : Type} [Fintype A] [Fintype R] [Fintype S] [Nonempty S]
  [Fintype W] [DecidableEq W] [Fintype I] [Nonempty A]

open Classical in
lemma role_mask_bound (K : SimpleGraph A) (E : A → R → Prop) (a₀ : A)
    (G : SimpleGraph W) [DecidableRel G.Adj] (t : ℕ)
    (f g : (RootedIncidence.graph K E).Copy G)
    (hroot : ∀ r, f (.inr r)=g (.inr r)) :
    (if ¬(graph K E (fun _ : S => a₀) G t).Adj f g then
      codegree G (f (.inl a₀)) (g (.inl a₀)) else 0) ≤
      (t:ℝ) + ∑ a : A, ∑ b : A, if f (.inl a)=g (.inl b) then
        codegree G (f (.inl a₀)) (g (.inl a₀)) else 0 := by
  classical
  let P := codegree G (f (.inl a₀)) (g (.inl a₀))
  have hP : 0 ≤ P := codegree_nonneg G _ _
  have ho : 0 ≤ ∑ a : A, ∑ b : A, if f (.inl a)=g (.inl b) then P else 0 := by
    exact sum_nonneg (fun a _ => sum_nonneg (fun b _ => by split_ifs <;> simp_all))
  by_cases ha : (graph K E (fun _ : S => a₀) G t).Adj f g
  · rw [if_neg (not_not.mpr ha)]
    exact add_nonneg (Nat.cast_nonneg _) ho
  · rw [if_pos ha]
    rcases (nonadj_of_same_roots K E (fun _ : S => a₀) G t f g hroot).mp ha with ⟨a,b,he⟩|⟨s,hs⟩
    · have hb : P ≤ ∑ b' : A, if f (.inl a)=g (.inl b') then P else 0 := by
        have h := single_le_sum (s := (univ : Finset A))
          (f := fun b' => if f (.inl a)=g (.inl b') then P else 0)
          (fun b' _ => by dsimp only; split_ifs <;> simp_all) (mem_univ b)
        simpa only [if_pos he] using h
      have hab : (∑ b' : A, if f (.inl a)=g (.inl b') then P else 0) ≤
          ∑ a' : A, ∑ b' : A, if f (.inl a')=g (.inl b') then P else 0 := by
        exact single_le_sum (s := (univ : Finset A))
          (f := fun a' => ∑ b' : A, if f (.inl a')=g (.inl b') then P else 0)
          (fun a' _ => sum_nonneg (fun b' _ => by split_ifs <;> simp_all)) (mem_univ a)
      exact (hb.trans hab).trans (le_add_of_nonneg_left (Nat.cast_nonneg t))
    · have ht : codegree G (f (.inl a₀)) (g (.inl a₀)) ≤ t := by
        unfold codegree
        exact_mod_cast hs.le
      exact ht.trans (le_add_of_nonneg_right ho)

open Classical in
/-- This inequality requires equality of old root images but does not require
old-template freeness. The new arms all attach to the one specified role. -/
theorem role_quadratic_bound (K : SimpleGraph A) (E : A → R → Prop) (a₀ : A)
    (M : ℕ) (hM : 1 ≤ M) (hk : 2 ≤ M+Fintype.card S)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (FullRootedPower.graph (RootedCoreArms.template K E (fun _ : S => a₀)) M).Free G)
    (e : I → (RootedIncidence.graph K E).Copy G)
    (hroot : ∀ i j r, e i (.inr r)=e j (.inr r))
    (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) :
    (∑ x : W, (∑ i, G.adjMatrix ℝ x (e i (.inl a₀))*w i)^2) ≤
      (M+Fintype.card S-1:ℕ) * ∑ i, ∑ j,
        ((RootedCoreArms.threshold (A := A) (R := R) (S := S) M:ℝ) +
          ∑ a : A, ∑ b : A, if e i (.inl a)=e j (.inl b) then
            codegree G (e i (.inl a₀)) (e j (.inl a₀)) else 0) * w i*w j := by
  classical
  let t := RootedCoreArms.threshold (A := A) (R := R) (S := S) M
  let B : Matrix W I ℝ := fun x i => G.adjMatrix ℝ x (e i (.inl a₀))
  let Q := graph K E (fun _ : S => a₀) G t
  have hB (x : W) (i : I) : 0 ≤ B x i := by
    dsimp [B,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have h := HeavyCliqueMoments.quadratic_mask B hB (Q.comap e) _ hk
    (HeavyFiberRestriction.cliqueFree_comap Q e _ (cliqueFree K E (fun _ : S => a₀) M hM G hf)) w hw
  have hgram (i j : I) : (B.transpose*B) i j = codegree G (e i (.inl a₀)) (e j (.inl a₀)) := by
    simp only [Matrix.mul_apply,Matrix.transpose_apply,B]
    exact (codegree_eq G _ _).symm
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  apply sum_le_sum
  intro i _
  apply sum_le_sum
  intro j _
  rw [hgram]
  have hh := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
    (role_mask_bound (S := S) K E a₀ G t (e i) (e j) (hroot i j)) (hw i)) (hw j)
  by_cases ha : Q.Adj (e i) (e j)
  · simpa only [SimpleGraph.comap_adj,Q,ha,not_true_eq_false,if_false,zero_mul] using hh
  · simpa only [SimpleGraph.comap_adj,Q,ha,not_false_eq_true,if_true] using hh

end Erdos571.RootedCoreShadow

/-! Heavy shadows on rich short-spider supports. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpiderRootedShadow
open Finset SimpleGraph

/-- Move the short root into the nonroot core, as its pendant hub. -/
def oldToShort (p : ℕ) : Interior p ⊕ Fin p → Option (Fin p) ⊕ Option (Fin p)
  | .inl (.inl false) => .inl none
  | .inl (.inl true) => .inr none
  | .inl (.inr j) => .inl (some j)
  | .inr j => .inr (some j)

def shortCopy (p : ℕ) : (oldTemplate p).Copy (ShortSpider.template p) where
  toHom :=
    { toFun := oldToShort p
      map_rel' := by
        rintro ((b|j)|j) ((b'|j')|j') h
        all_goals try (cases b)
        all_goals try (cases b')
        all_goals simpa [oldTemplate,core,oldIncidence,oldToShort,RootedIncidence.graph,
          ShortSpider.template,eq_comm] using h }
  injective' := by
    rintro ((b|j)|j) ((b'|j')|j') h
    all_goals try (cases b)
    all_goals try (cases b')
    all_goals simp_all [oldToShort]

variable {W : Type} [Fintype W] [DecidableEq W]

/-- A heavy clique of rich pendant-hub images supplies disjoint old cores.
All old roots stay fixed; no freeness of the old rooted graph is used. -/
theorem contains_of_rich_heavy_clique
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hM : q+1 ≤ M)
    (r : Fin q ↪ W) (u : (Fin M ⊕ Fin p) ↪ W)
    (hrich : ∀ i, DoubleSpider.completionThreshold t p q M <
      (LongSpider.shortFiber G U t q (u i) r).card)
    (hheavy : ∀ i j, i≠j → RootedCoreArms.threshold
      (A := Interior q) (R := Fin q) (S := Fin p) M ≤
        (FourthMoment.common G univ (u i) (u j)).card) :
    DoubleSpider.graph q p M ⊑ G := by
  classical
  let I := Fin M ⊕ Fin p
  let Z : Finset W := univ.image r ∪ univ.image u
  have hZ : Z.card ≤ q+(M+p) := by
    have h₁ : (univ.image r).card ≤ q := by simpa using card_image_le (s := univ) (f := r)
    have h₂ : (univ.image u).card ≤ M+p := by simpa using card_image_le (s := univ) (f := u)
    exact (card_union_le _ _).trans (Nat.add_le_add h₁ h₂)
  have hc : Z.card+(q+1)*Fintype.card I ≤ p+q+M*(p+q+2) := by
    have hp : p*(q+1) ≤ p*M := Nat.mul_le_mul_left p hM
    simp only [I,Fintype.card_sum,Fintype.card_fin]
    nlinarith
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice_finite
    (q+1) ((q+1)*t^(q+1)) RootedPacking.interior
    (fun i : I => LongSpider.shortFiber G U t q (u i) r) Z
    (by intro i f hf; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card f).le)
    (fun i w => LongSpider.shortFiber_load G U t q ht (u i) r w)
    (fun i => lt_of_le_of_lt (Nat.mul_le_mul_right _ hc) (hrich i))
  have hroot (i : I) := (LongSpider.mem_shortFiber G U t q (u i) r (f i)).mp (hf i)
  let e : I → (oldTemplate q).Copy G := fun i => (f i).comp (shortCopy q)
  have epend (i : I) : e i (.inl (.inl true))=u i := (hroot i).2.1
  have eroot (i : I) (j : Fin q) : e i (.inr j)=r j := (hroot i).2.2 j
  have einterior (i : I) (a : Interior q) : e i (.inl a)=u i ∨
      e i (.inl a)∈RootedPacking.interior (f i) := by
    rcases a with (b|j)
    · cases b
      · exact Or.inr (RootedPacking.mem_interior (f i) none)
      · exact Or.inl (epend i)
    · exact Or.inr (RootedPacking.mem_interior (f i) (some j))
  have huZ (i : I) : u i∈Z := mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩)
  have edis (i j : I) (hij : i≠j) (a b : Interior q) : e i (.inl a)≠e j (.inl b) := by
    intro he
    rcases einterior i a with hi|hi <;> rcases einterior j b with hj|hj
    · exact hij (u.injective (hi.symm.trans (he.trans hj)))
    · exact disjoint_left.mp (hfZ j) hj (he ▸ (hi.symm ▸ huZ i))
    · exact disjoint_left.mp (hfZ i) hi (he.symm ▸ (hj.symm ▸ huZ j))
    · exact disjoint_left.mp (hfdis hij) hi (he.symm ▸ hj)
  let c : (⊤ : SimpleGraph I).Copy
      (RootedCoreShadow.graph (core q) (oldIncidence q) (attach q p) G
        (RootedCoreArms.threshold (A := Interior q) (R := Fin q) (S := Fin p) M)) :=
    { toHom :=
        { toFun := e
          map_rel' := by
            intro i j hij
            have hne := (top_adj _ _).mp hij
            refine ⟨fun a => (eroot i a).trans (eroot j a).symm,edis i j hne,?_⟩
            intro a
            change _ ≤ (FourthMoment.common G univ (e i (.inl (.inl true)))
              (e j (.inl (.inl true)))).card
            rw [epend,epend]
            exact hheavy i j hne }
      injective' := by
        intro i j he
        change e i=e j at he
        apply u.injective
        rw [← epend i,← epend j,he] }
  exact (powerIso q p M).symm.isContained.trans
    (RootedCoreShadow.contains_of_clique_copy (core q) (oldIncidence q) (attach q p)
      M (by omega) G c)

/-- Actual double-spider freeness makes the vertex shadow on any rich
support clique-free. This assertion concerns pairs of vertices IN the
support, not arbitrary outside endpoints. -/
theorem rich_support_cliqueFree
    (G : SimpleGraph W) [DecidableRel G.Adj] (U S : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hM : q+1 ≤ M)
    (hf : (DoubleSpider.graph p q M).Free G) (r : Fin q ↪ W)
    (hrich : ∀ u∈S, DoubleSpider.completionThreshold t p q M <
      (LongSpider.shortFiber G U t q u r).card) :
    ((HostHeavyShadow.graph G univ
      (RootedCoreArms.threshold (A := Interior q) (R := Fin q) (S := Fin p) M)).induce
        (S : Set W)).CliqueFree (M+p) := by
  classical
  have he : M+p=Fintype.card (Fin M ⊕ Fin p) := by simp
  rw [he]
  apply cliqueFree_iff_top_free.mpr
  rintro ⟨c⟩
  let u : (Fin M ⊕ Fin p) ↪ W := ⟨fun i => (c i).val,Subtype.val_injective.comp c.injective⟩
  apply DoubleSpider.free_swap G p q M hf
  apply contains_of_rich_heavy_clique G U t p q M ht hM r u
  · intro i
    exact hrich _ (c i).property
  · intro i j hij
    exact (c.toHom.map_adj ((top_adj _ _).mpr hij)).2

end Erdos571.DoubleSpiderRootedShadow

/-! Quadratic and rectangular bounds for a clique-free heavy shadow on a support.
The direction of the support restriction is explicit in every statement. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HeavyCliqueMoments
open Finset SimpleGraph Matrix
variable {V I : Type} [Fintype V] [Fintype I]

open Classical in
theorem quadratic_bound_variable_diagonal (A : Matrix I V ℝ) (hA : ∀ i v, 0 ≤ A i v)
    (K : SimpleGraph V) (k : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (L : ℝ) (D : V → ℝ) (hL : 0 ≤ L)
    (hdiag : ∀ v, (A.transpose*A) v v ≤ D v)
    (hlight : ∀ u v, u ≠ v → ¬K.Adj u v → (A.transpose*A) u v ≤ L)
    (f : V → ℝ) (hf : ∀ v, 0 ≤ f v) :
    (∑ i, (∑ v, A i v*f v)^2) ≤
      (k-1:ℕ) * (L*(∑ v, f v)^2 + ∑ v, D v*(f v)^2) := by
  classical
  apply (quadratic_mask A hA K k hk hK f hf).trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  have hh (u v : V) :
      (if ¬K.Adj u v then (A.transpose*A) u v*f u*f v else 0) ≤
        L*f u*f v + if u=v then D u*(f u)^2 else 0 := by
    by_cases he : u=v
    · subst v
      rw [if_pos (K.loopless u),if_pos rfl]
      have hm := mul_le_mul_of_nonneg_right (hdiag u) (sq_nonneg (f u))
      nlinarith [mul_nonneg hL (sq_nonneg (f u))]
    · rw [if_neg he,add_zero]
      by_cases ha : K.Adj u v
      · simp only [ha,not_true_eq_false,ite_false]
        exact mul_nonneg (mul_nonneg hL (hf u)) (hf v)
      · rw [if_pos ha]
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (hlight u v he ha) (hf u)) (hf v)
  calc
    _ ≤ ∑ u, ∑ v, (L*f u*f v + if u=v then D u*(f u)^2 else 0) :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => hh u v))
    _ = _ := by
      simp only [sum_add_distrib,sum_ite_eq,mem_univ,if_true,←mul_sum]
      simp only [←mul_sum,←sum_mul]
      ring

end Erdos571.HeavyCliqueMoments

namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph Matrix DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def rectangularMatrix (G : SimpleGraph W) [DecidableRel G.Adj] (X S : Finset W) : Matrix X S ℝ :=
  fun x s => G.adjMatrix ℝ x s

lemma rectangular_gram (G : SimpleGraph W) [DecidableRel G.Adj] (X S : Finset W)
    (u v : S) :
    ((rectangularMatrix G X S).transpose * rectangularMatrix G X S) u v =
        (FourthMoment.common G X u v).card := by
  classical
  simp only [Matrix.mul_apply,Matrix.transpose_apply,rectangularMatrix]
  rw [Finset.sum_coe_sort X (fun x : W => G.adjMatrix ℝ x u*G.adjMatrix ℝ x v)]
  simp only [FourthMoment.common,card_filter,Nat.cast_sum,Nat.cast_ite,Nat.cast_one,Nat.cast_zero]
  apply sum_congr rfl
  intro x hx
  dsimp [SimpleGraph.adjMatrix]
  simp only [G.adj_comm]
  split_ifs <;> simp_all

/-- The row set may be arbitrary, but BOTH endpoints of every tested
heavy pair belong to S. The diagonal term counts edges to the row set. -/
theorem support_quadratic_bound
    (G : SimpleGraph W) [DecidableRel G.Adj] (X S : Finset W)
    (t k : ℕ) (hk : 2 ≤ k)
    (hK : ((graph G univ t).induce (S : Set W)).CliqueFree k)
    (w : S → ℝ) (hw : ∀ s, 0 ≤ w s) :
    (∑ x : X, (∑ s : S, G.adjMatrix ℝ x s*w s)^2) ≤
      (k-1:ℕ) * ((t:ℝ)*(∑ s : S, w s)^2 +
        ∑ s : S, (neighbors G X s).card*(w s)^2) := by
  classical
  let B := rectangularMatrix G X S
  apply HeavyCliqueMoments.quadratic_bound_variable_diagonal B
    (by intro x s; dsimp [B,rectangularMatrix,SimpleGraph.adjMatrix]; split_ifs <;> norm_num)
    ((graph G univ t).induce (S : Set W)) k hk hK t
    (fun s => ((neighbors G X s).card:ℝ)) (Nat.cast_nonneg t) ?_ ?_ w hw
  · intro s
    change (B.transpose*B) _ _ ≤ _
    rw [show B=rectangularMatrix G X S from rfl,rectangular_gram G X S]
    have he : FourthMoment.common G X s s=neighbors G X s := by
      ext v; simp [FourthMoment.common,neighbors]
    rw [he]
  · intro u v huv hnot
    change (B.transpose*B) _ _ ≤ _
    rw [show B=rectangularMatrix G X S from rfl,rectangular_gram G X S]
    have hne : (u:W)≠v := fun h => huv (Subtype.ext h)
    have ht : (FourthMoment.common G univ u v).card<t := by
      apply Nat.lt_of_not_ge
      exact fun h => hnot ⟨hne,h⟩
    have hs : FourthMoment.common G X u v ⊆ FourthMoment.common G univ u v := by
      intro x hx
      exact mem_filter.mpr ⟨mem_univ x,(mem_filter.mp hx).2⟩
    exact_mod_cast (card_le_card hs).trans ht.le

/-- The orientation is `|Y| + sqrt(|Y|)*|S|`, with fixed clique constants.
It must not be used as the reversed bounded-codegree estimate. -/
theorem support_rectangular_bound
    (G : SimpleGraph W) [DecidableRel G.Adj] (S Y : Finset W)
    (t k : ℕ) (hk : 2 ≤ k)
    (hK : ((graph G univ t).induce (S : Set W)).CliqueFree k) :
    ((BoundedCodegreeCross.edges G S Y).card:ℝ) ≤
      (k-1:ℕ)*Y.card + Real.sqrt ((k-1:ℕ)*(t:ℝ)*Y.card)*S.card := by
  classical
  have hs (x : Y) : (∑ s : S, G.adjMatrix ℝ x s)=(neighbors G S x).card := by
    rw [Finset.sum_coe_sort]
    simp only [SimpleGraph.adjMatrix,Matrix.of_apply,neighbors,card_filter,Nat.cast_sum,Nat.cast_ite,Nat.cast_one,Nat.cast_zero]
  have h := support_quadratic_bound G Y S t k hk hK (fun _ => 1) (by simp)
  simp only [mul_one,one_pow] at h
  simp_rw [hs] at h
  have he : (∑ s : S, ((neighbors G Y s).card:ℝ))=(BoundedCodegreeCross.edges G S Y).card := by
    rw [Finset.sum_coe_sort S (fun s : W => ((neighbors G Y s).card:ℝ))]
    exact_mod_cast (BoundedCodegreeCross.card_edges_left G S Y).symm
  have he' : (∑ y : Y, ((neighbors G S y).card:ℝ))=(BoundedCodegreeCross.edges G S Y).card := by
    rw [Finset.sum_coe_sort Y (fun y : W => ((neighbors G S y).card:ℝ))]
    exact_mod_cast (BoundedCodegreeCross.card_edges_right G S Y).symm
  simp only [sum_const,card_univ,Fintype.card_coe,nsmul_eq_mul,mul_one,he] at h
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset Y))
    (f := fun y => ((neighbors G S y).card:ℝ))
  rw [he',card_univ,Fintype.card_coe] at hc
  have hh := hc.trans (mul_le_mul_of_nonneg_left h (Nat.cast_nonneg Y.card))
  have hz : (Real.sqrt ((k-1:ℕ)*(t:ℝ)*Y.card)*S.card)^2 =
      (k-1:ℕ)*(t:ℝ)*Y.card*(S.card:ℝ)^2 := by
    rw [mul_pow,Real.sq_sqrt (by positivity)]
  apply BoundedCodegreeCross.quadratic_bound (by positivity) (by positivity)
  rw [hz]
  nlinarith [hh]

end Erdos571.HostHeavyShadow

/-! Actual freeness supplies support-restricted quadratic and edge bounds. -/
set_option maxHeartbeats 3000000
namespace Erdos571.DoubleSpiderRootedShadow
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

theorem rich_support_quadratic_bound
    (G : SimpleGraph W) [DecidableRel G.Adj] (U S X : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hM : q+1 ≤ M) (hk : 2 ≤ M+p)
    (hf : (DoubleSpider.graph p q M).Free G) (r : Fin q ↪ W)
    (hrich : ∀ u∈S, DoubleSpider.completionThreshold t p q M <
      (LongSpider.shortFiber G U t q u r).card)
    (w : S → ℝ) (hw : ∀ s, 0 ≤ w s) :
    (∑ x : X, (∑ s : S, G.adjMatrix ℝ x s*w s)^2) ≤
      (M+p-1:ℕ) * ((RootedCoreArms.threshold
        (A := Interior q) (R := Fin q) (S := Fin p) M:ℝ)*(∑ s : S, w s)^2 +
          ∑ s : S, (neighbors G X s).card*(w s)^2) :=
  HostHeavyShadow.support_quadratic_bound G X S _ (M+p) hk
    (rich_support_cliqueFree G U S t p q M ht hM hf r hrich) w hw

/-- The support is on the square-root-free factor, not under the square root. -/
theorem rich_support_rectangular_bound
    (G : SimpleGraph W) [DecidableRel G.Adj] (U S Y : Finset W)
    (t p q M : ℕ) (ht : 1 ≤ t) (hM : q+1 ≤ M) (hk : 2 ≤ M+p)
    (hf : (DoubleSpider.graph p q M).Free G) (r : Fin q ↪ W)
    (hrich : ∀ u∈S, DoubleSpider.completionThreshold t p q M <
      (LongSpider.shortFiber G U t q u r).card) :
    ((BoundedCodegreeCross.edges G S Y).card:ℝ) ≤
      (M+p-1:ℕ)*Y.card + Real.sqrt ((M+p-1:ℕ)*
        (RootedCoreArms.threshold (A := Interior q) (R := Fin q) (S := Fin p) M:ℝ)*Y.card)*S.card :=
  HostHeavyShadow.support_rectangular_bound G S Y _ (M+p) hk
    (rich_support_cliqueFree G U S t p q M ht hM hf r hrich)

end Erdos571.DoubleSpiderRootedShadow

/-! The subdivision of a three-vertex path with the same number of rooted
leaves at every vertex. Only the lower bound is claimed here. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHub
open Finset SimpleGraph RootedSunflower

abbrev counts (s : ℕ) := BalancedTree.leafCount 2 (3*s-1)
abbrev BaseRoot (s : ℕ) := BalancedTree.Leaf (counts s)
def base (s : ℕ) := BalancedTree.graph (counts s)
def template (s : ℕ) := RootedSubdivision.graph (base s)
def graph (s M : ℕ) := FullRootedPower.graph (template s) M

lemma counts_eq (s : ℕ) (hs : 1 ≤ s) (i : Fin 3) : counts s i=s := by
  have hsQ : (1:ℚ) ≤ s := by exact_mod_cast hs
  have h31 : 1 ≤ 3*s := by omega
  have h₁ : BalancedTree.rounding 2 (3*s-1) 1=s := by
    unfold BalancedTree.rounding BalancedTree.slope
    norm_num only [Nat.cast_ofNat,Nat.cast_add]
    apply (Nat.ceil_eq_iff (by omega : s≠0)).mpr
    rw [Nat.cast_sub hs,Nat.cast_sub h31]
    push_cast
    constructor <;> linarith
  have h₂ : BalancedTree.rounding 2 (3*s-1) 2=2*s := by
    unfold BalancedTree.rounding BalancedTree.slope
    norm_num only [Nat.cast_ofNat,Nat.cast_add]
    apply (Nat.ceil_eq_iff (by omega : 2*s≠0)).mpr
    rw [Nat.cast_sub (by omega : 1 ≤ 2*s),Nat.cast_sub h31]
    push_cast
    constructor <;> linarith
  have h₃ : BalancedTree.rounding 2 (3*s-1) 3=3*s-1 := BalancedTree.rounding_end 2 _
  fin_cases i
  · simp [counts, BalancedTree.leafCount, Fin.last,
      BalancedTree.rounding_zero, h₁]
  · simp [counts, BalancedTree.leafCount, Fin.last, h₁, h₂]
    omega
  · simp [counts, BalancedTree.leafCount, Fin.last, h₂, h₃]
    omega

lemma base_roots (s : ℕ) (hs : 1 ≤ s) : Fintype.card (BaseRoot s)=3*s := by
  rw [BalancedTree.card_roots]
  omega

lemma base_edges (s : ℕ) (hs : 1 ≤ s) : Nat.card (base s).edgeSet=3*s+2 := by
  rw [base,BalancedTree.card_edges,BalancedTree.sum_leafCount]
  omega

lemma base_isTree (s : ℕ) : (base s).IsTree := BalancedTree.isTree _

lemma base_balance (s : ℕ) (hs : 1 ≤ s) : ∀ C : Finset (Fin 3),
    (3*s+2)*(Fintype.card (Fin 3)-C.card) ≤ 3*Nat.card (PetalEdge (base s) C) := by
  intro C
  have h := BalancedExactLower.petal_balance 2 (3*s-1) C
  simpa only [show 2+(3*s-1)+1=3*s+2 by omega,show 2+1=3 by omega] using h

lemma template_balance (s : ℕ) (hs : 1 ≤ s) : ∀ C : Finset (RootedSubdivision.Nonroot (base s)),
    (6*s+4)*(Fintype.card (RootedSubdivision.Nonroot (base s))-C.card) ≤
      (3*s+5)*Nat.card (PetalEdge (template s) C) := by
  classical
  have h := RootedSubdivision.balance (base s) 3 (3*s+2) (by omega) (base_balance s hs)
  simpa only [template, Fintype.card_eq_nat_card,
    show 2*(3*s+2)=6*s+4 by omega,show 3+(3*s+2)=3*s+5 by omega] using h

lemma no_isolated (s : ℕ) : ∀ u, ∃ v, (template s).Adj u v :=
  RootedSubdivision.no_isolated (base s) (BalancedExactLower.no_isolated 2 (3*s-1))

lemma connected (s : ℕ) : (template s).Connected :=
  RootedSubdivision.connected (base s) (base_isTree s).isConnected

lemma graph_bipartite (s M : ℕ) : (graph s M).IsBipartite := by
  let c := RootedSubdivision.color (base s)
  let C : (graph s M).Coloring Bool :=
    ⟨FullRootedPower.color c M,FullRootedPower.color_proper (template s) c M
      (RootedSubdivision.color_proper (base s))⟩
  simpa only [Fintype.card_bool] using C.colorable

/-- A fixed actual power has the exact predicted lower exponent. No
matching ordinary upper bound is asserted. -/
theorem exists_lower (s : ℕ) (hs : 1 ≤ s) : ∃ M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(3*(s:ℝ)+5)/(6*(s:ℝ)+4)))
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ)) := by
  have h := FullRootedPower.exact_lower (template s) (no_isolated s)
    (3*s+5) (6*s+4) (by omega) (by omega) (template_balance s hs)
  simpa only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat] using h

theorem twentyfour_seventeen_lower : ∃ M : ℕ, 2 ≤ M ∧ (graph 5 M).IsBipartite ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(24/17:ℝ))
      (fun n : ℕ => (extremalNumber n (graph 5 M):ℝ)) := by
  obtain ⟨M,hM,h⟩ := exists_lower 5 (by omega)
  refine ⟨M,hM,graph_bipartite 5 M,?_⟩
  norm_num at h
  exact h

end Erdos571.ThreeHub

/-! Fourth-row bounds from actual three-hub subdivision-power freeness. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHub
open Finset SimpleGraph Matrix

abbrev Branch (s M : ℕ) := (Fin (M+1) × Fin 3) ⊕ BaseRoot s

noncomputable def momentCoefficient (s M : ℕ) : ℝ :=
  (Fintype.card (Branch s M)-1:ℕ) *
    ((Fintype.card (Branch s M) +
      Nat.card (FullRootedPower.graph (base s) (M+1)).edgeSet:ℕ)+1:ℝ)

lemma momentCoefficient_nonneg (s M : ℕ) : 0 ≤ momentCoefficient s M := by
  unfold momentCoefficient
  positivity

lemma branch_card_ge (s M : ℕ) : 2 ≤ Fintype.card (Branch s M) := by
  simp only [Branch, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
  omega

variable {W : Type} [Fintype W] [DecidableEq W]

lemma subdivision_free (s M : ℕ) (G : SimpleGraph W)
    (hf : (graph s M).Free G) :
    (ProjectionHeavy.subdivision (FullRootedPower.graph (base s) (M+1))).Free G := by
  intro h
  exact hf ((show graph s M ⊑
    ProjectionHeavy.subdivision (FullRootedPower.graph (base s) (M+1)) from
      ⟨RootedSubdivision.powerCopy (base s) M⟩).trans h)

/-- Actual graph freeness, without any global codegree hypothesis. -/
theorem free_fourth_row_bound (s M : ℕ) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (graph s M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) (u : W) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤ momentCoefficient s M*D^2 :=
  HostHeavyShadow.subdivision_free_row_bound _ (branch_card_ge s M) G
    (subdivision_free s M G hf) D hD hdeg u

theorem free_fourWalk_bound (s M : ℕ) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (graph s M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) (u v : W) :
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤
      momentCoefficient s M*D^2 :=
  HostHeavyShadow.subdivision_free_fourWalk_bound _ (branch_card_ge s M) G
    (subdivision_free s M G hf) D hD hdeg u v

theorem free_gram_mass_bound (s M : ℕ) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (graph s M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ v, (G.degree v : ℝ) ≤ D) :
    GramPin.squareMass (G.adjMatrix ℝ * G.adjMatrix ℝ) ≤
      Fintype.card W*(momentCoefficient s M*D^2) :=
  HostHeavyShadow.subdivision_free_gram_mass_bound _ (branch_card_ge s M) G
    (subdivision_free s M G hf) D hD hdeg

end Erdos571.ThreeHub

/-! A nonsharp sub-three-halves upper bound for the subdivision of any
fixed nonempty finite bipartite graph. -/
set_option maxHeartbeats 2000000
namespace Erdos571.BipartiteSubdivisionUpper
open Finset SimpleGraph ProjectionHeavy

variable {V : Type} [Fintype V]

noncomputable def bipartiteCopy (H : SimpleGraph V) (hH : H.IsBipartite) :
    H.Copy (completeBipartiteGraph (Fin (Fintype.card V)) (Fin (Fintype.card V))) := by
  classical
  let c : H.Coloring Bool := hH.toColoring (by simp)
  let e := Fintype.equivFin V
  let f : V → Fin (Fintype.card V) ⊕ Fin (Fintype.card V) :=
    fun v => if c v then .inl (e v) else .inr (e v)
  refine ⟨⟨f,?_⟩,?_⟩
  · intro u v h
    have hc := c.valid h
    dsimp [f]
    cases hu : c u <;> cases hv : c v <;> simp_all
  · intro u v h
    change f u = f v at h
    have he := congrArg (Sum.elim e.symm e.symm) h
    simpa only [f, apply_ite, Sum.elim_inl, Sum.elim_inr, Equiv.symm_apply_apply,
      ite_self] using he

noncomputable def exponent (q : ℕ) : ℝ := 2-(2-1/(q:ℝ))⁻¹

lemma exponent_bounds {q : ℕ} (hq : 1 ≤ q) :
    1 ≤ exponent q ∧ exponent q < 3/2 := by
  have hqR : (1:ℝ) ≤ q := by exact_mod_cast hq
  have hqpos : (0:ℝ) < q := by linarith
  have hi : 0 < 1/(q:ℝ) := one_div_pos.mpr hqpos
  have hi1 : 1/(q:ℝ) ≤ 1 := (div_le_one hqpos).mpr hqR
  have ha : 1 ≤ 2-1/(q:ℝ) := by linarith
  have ha2 : 2-1/(q:ℝ) < 2 := by linarith
  have hap : 0 < 2-1/(q:ℝ) := by linarith
  have hinv : (2-1/(q:ℝ))⁻¹ ≤ 1 := (inv_le_one₀ hap).mpr ha
  have hlo : (1/2:ℝ) < (2-1/(q:ℝ))⁻¹ := by
    simpa only [one_div] using (one_div_lt_one_div_of_lt hap ha2)
  unfold exponent
  constructor <;> linarith

theorem edge_bound [Nonempty V] (H : SimpleGraph V) (hH : H.IsBipartite) :
    ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (subdivision H) (exponent (Fintype.card V)) C := by
  have hq : 1 ≤ Fintype.card V := Fintype.card_pos
  have hqR : (1:ℝ) ≤ Fintype.card V := by exact_mod_cast hq
  have hqpos : (0:ℝ) < Fintype.card V := by linarith
  let C : ℝ := 2*(Fintype.card V)+(Fintype.card V+1)
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have hb : EdgeBound H (2-1/(Fintype.card V:ℝ)) C :=
    (ShortSpider.kst_bound _ _ hq hq).mono ⟨bipartiteCopy H hH⟩
  have ha1 : 1 ≤ 2-1/(Fintype.card V:ℝ) := by
    have hi := (div_le_one hqpos).mpr hqR
    linarith
  have ha2 : 2-1/(Fintype.card V:ℝ) ≤ 2 := sub_le_self _ (by positivity)
  exact ⟨_, mul_nonneg (by norm_num)
    (WeakSubdivisionUpper.coefficient_nonneg hC),
    WeakSubdivisionUpper.edge_bound H ha1 ha2 hC hb⟩

theorem upper [Nonempty V] (H : SimpleGraph V) (hH : H.IsBipartite) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (subdivision H):ℝ))
      (fun n : ℕ => (n:ℝ)^(exponent (Fintype.card V))) := by
  obtain ⟨C,hC,h⟩ := edge_bound H hH
  exact EdgeBound.extremal_isBigO _ hC h

end Erdos571.BipartiteSubdivisionUpper

/-! Same-graph lower and nonsharp upper bounds for the three-hub family. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHub
open Finset SimpleGraph ProjectionHeavy

lemma base_power_bipartite (s M : ℕ) : (FullRootedPower.graph (base s) M).IsBipartite := by
  classical
  let c : (base s).Coloring Bool := (base_isTree s).isBipartite.toColoring (by simp)
  let C : (FullRootedPower.graph (base s) M).Coloring Bool :=
    ⟨FullRootedPower.color c M, FullRootedPower.color_proper (base s) c M c.valid⟩
  simpa only [Fintype.card_bool] using C.colorable

noncomputable def upperExponent (s M : ℕ) : ℝ :=
  BipartiteSubdivisionUpper.exponent (Fintype.card (Branch s M))

lemma upperExponent_bounds (s M : ℕ) : 1 ≤ upperExponent s M ∧ upperExponent s M < 3/2 :=
  BipartiteSubdivisionUpper.exponent_bounds (by have h := branch_card_ge s M; omega)

/-- This is an ordinary upper bound, but not the sharp rooted-density exponent. -/
theorem nonsharp_edge_bound (s M : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (graph s M) (upperExponent s M) C := by
  obtain ⟨C,hC,h⟩ := BipartiteSubdivisionUpper.edge_bound
    (FullRootedPower.graph (base s) (M+1)) (base_power_bipartite s (M+1))
  exact ⟨C,hC,h.mono ⟨RootedSubdivision.powerCopy (base s) M⟩⟩

theorem nonsharp_upper (s M : ℕ) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ))
      (fun n : ℕ => (n:ℝ)^(upperExponent s M)) := by
  obtain ⟨C,hC,h⟩ := nonsharp_edge_bound s M
  exact EdgeBound.extremal_isBigO _ hC h

/-- One fixed graph has both bounds. The upper exponent is strictly below
three halves; it is not asserted to equal the lower exponent. -/
theorem lower_and_nonsharp_upper (s : ℕ) (hs : 1 ≤ s) :
    ∃ M : ℕ, 2 ≤ M ∧ (graph s M).IsBipartite ∧ upperExponent s M < 3/2 ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(2-(3*(s:ℝ)+5)/(6*(s:ℝ)+4)))
        (fun n : ℕ => (extremalNumber n (graph s M):ℝ)) ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (extremalNumber n (graph s M):ℝ))
        (fun n : ℕ => (n:ℝ)^(upperExponent s M)) := by
  obtain ⟨M,hM,hl⟩ := exists_lower s hs
  exact ⟨M,hM,graph_bipartite s M,(upperExponent_bounds s M).2,hl,nonsharp_upper s M⟩

theorem twentyfour_seventeen_bounds :
    ∃ M : ℕ, 2 ≤ M ∧ (graph 5 M).IsBipartite ∧ upperExponent 5 M < 3/2 ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(24/17:ℝ))
        (fun n : ℕ => (extremalNumber n (graph 5 M):ℝ)) ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (extremalNumber n (graph 5 M):ℝ))
        (fun n : ℕ => (n:ℝ)^(upperExponent 5 M)) := by
  have h := lower_and_nonsharp_upper 5 (by omega)
  norm_num at h
  exact h

end Erdos571.ThreeHub

/-! Algebraic estimates for the three-hub path kernel. These estimates do
not assert an injective-copy count or a sharp extremal upper bound. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin
variable {U : Type*} [Fintype U]

noncomputable def chain (A K : Matrix U U ℝ) : Matrix U U ℝ :=
  (A*A)*K*(A*A)

noncomputable def energy (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, K u v * (chain A K u v)^2

noncomputable def centerPin (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, K u u * (chain A K u u)^2

noncomputable def twoEnergy (A K : Matrix U U ℝ) : ℝ :=
  squareMass (A*K*A)

lemma twoEnergy_eq_inner (A K : Matrix U U ℝ) (hA : A.IsSymm) :
    twoEnergy A K = ∑ u, ∑ v, K u v * chain A K u v := by
  classical
  have h := conjugation_trace A K
  rw [hA.eq, ←inner_trace] at h
  rw [twoEnergy, h]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => mul_comm _ _))

lemma energy_nonneg (A K : Matrix U U ℝ) (hK : ∀ u v, 0 ≤ K u v) :
    0 ≤ energy A K :=
  sum_nonneg (fun u _ => sum_nonneg (fun v _ => mul_nonneg (hK u v) (sq_nonneg _)))

lemma centerPin_nonneg (A K : Matrix U U ℝ) (hK : ∀ u v, 0 ≤ K u v) :
    0 ≤ centerPin A K :=
  sum_nonneg (fun u _ => mul_nonneg (hK u u) (sq_nonneg _))

lemma twoEnergy_nonneg (A K : Matrix U U ℝ) : 0 ≤ twoEnergy A K := by
  exact sum_nonneg (fun u _ => sum_nonneg (fun v _ => sq_nonneg _))

/-- Weighted Cauchy--Schwarz, with the full kernel mass retained. -/
theorem twoEnergy_sq_le (A K : Matrix U U ℝ) (hA : A.IsSymm)
    (hK : ∀ u v, 0 ≤ K u v) :
    (twoEnergy A K)^2 ≤ (∑ u, ∑ v, K u v) * energy A K := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (U×U))
    (fun p => Real.sqrt (K p.1 p.2))
    (fun p => Real.sqrt (K p.1 p.2)*chain A K p.1 p.2)
  have h₁ (u v : U) : Real.sqrt (K u v)*(Real.sqrt (K u v)*chain A K u v)=
      K u v*chain A K u v := by
    rw [←mul_assoc, ←pow_two, Real.sq_sqrt (hK u v)]
  have h₂ (u v : U) : (Real.sqrt (K u v)*chain A K u v)^2=
      K u v*(chain A K u v)^2 := by rw [mul_pow, Real.sq_sqrt (hK u v)]
  rw [twoEnergy_eq_inner A K hA]
  simpa only [Fintype.sum_prod_type,h₁,h₂,Real.sq_sqrt (hK _ _),energy] using h

/-- A fourth-row cap gives a central-pin bound in terms of the two-hub
energy. No comparison eliminating that smaller energy is assumed. -/
theorem centerPin_le (A K : Matrix U U ℝ) (hA : A.IsSymm)
    (T B : ℝ) (hT : 0 ≤ T) (hB : 0 ≤ B)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, K u u ≤ B) :
    centerPin A K ≤ B*T*twoEnergy A K := by
  have h := diagonal_conjugation_bound A (A*K*A) T hT
    (by simpa only [hA.eq] using hr)
  have he : A*(A*K*A)*A.transpose=chain A K := by
    simp only [hA.eq, chain, Matrix.mul_assoc]
  rw [he] at h
  calc
    _ ≤ B*∑ u, (chain A K u u)^2 := by
      rw [mul_sum]
      exact sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hdiag u) (sq_nonneg _))
    _ ≤ B*(T*twoEnergy A K) := mul_le_mul_of_nonneg_left h hB
    _ = _ := by ring

theorem centerPin_sq_le_mass (A K : Matrix U U ℝ) (hA : A.IsSymm)
    (hK : ∀ u v, 0 ≤ K u v) (T B : ℝ) (hT : 0 ≤ T) (hB : 0 ≤ B)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, K u u ≤ B) :
    (centerPin A K)^2 ≤ (B*T)^2*(∑ u, ∑ v, K u v)*energy A K := by
  calc
    _ ≤ (B*T*twoEnergy A K)^2 := pow_le_pow_left₀ (centerPin_nonneg A K hK)
      (centerPin_le A K hA T B hT hB hr hdiag) 2
    _ = (B*T)^2*(twoEnergy A K)^2 := mul_pow _ _ _
    _ ≤ (B*T)^2*((∑ u, ∑ v, K u v)*energy A K) :=
      mul_le_mul_of_nonneg_left (twoEnergy_sq_le A K hA hK) (sq_nonneg _)
    _ = _ := by ring

end Erdos571.ThreeHubKernel

/-! Explicit mass loss in the current central-pin estimate. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U]

lemma entryPower_mass_le (Q : Matrix U U ℝ) (s : ℕ) (hs : 1 ≤ s)
    (T Z : ℝ) (hQ : ∀ u v, 0 ≤ Q u v) (hQT : ∀ u v, Q u v ≤ T)
    (hrow : ∀ u, ∑ v, Q u v ≤ Z) :
    (∑ u, ∑ v, entryPower Q s u v) ≤ Fintype.card U*T^(s-1)*Z := by
  have hp (u v : U) : (Q u v)^s ≤ T^(s-1)*Q u v := by
    have he : s=(s-1)+1 := by omega
    conv_lhs => rw [he, pow_succ]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (hQ u v) (hQT u v) _) (hQ u v)
  calc
    _ ≤ ∑ u, ∑ v, T^(s-1)*Q u v :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => hp u v))
    _ ≤ ∑ _u : U, T^(s-1)*Z := by
      apply sum_le_sum
      intro u _
      rw [←mul_sum]
      have hT : 0 ≤ T := (hQ u u).trans (hQT u u)
      exact mul_le_mul_of_nonneg_left (hrow u) (pow_nonneg hT _)
    _ = _ := by simp; ring

/-- The kernel mass is bounded, not silently discarded. The resulting
factor is `n*T^(3*s+1)*Z`, where `Z` bounds the fourth-walk row sum. -/
theorem centerPin_power_sq_le (A Q : Matrix U U ℝ) (hA : A.IsSymm)
    (s : ℕ) (hs : 1 ≤ s) (T Z : ℝ) (hT : 0 ≤ T)
    (hQ : ∀ u v, 0 ≤ Q u v) (hQT : ∀ u v, Q u v ≤ T)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hrow : ∀ u, ∑ v, Q u v ≤ Z) :
    (centerPin A (entryPower Q s))^2 ≤
      Fintype.card U*T^(3*s+1)*Z*energy A (entryPower Q s) := by
  have hK (u v : U) : 0 ≤ entryPower Q s u v := pow_nonneg (hQ u v) _
  have hb := centerPin_sq_le_mass A (entryPower Q s) hA hK T (T^s)
    hT (pow_nonneg hT _) hr (fun u => pow_le_pow_left₀ (hQ u u) (hQT u u) s)
  have he : (T^s*T)^2*T^(s-1)=T^(3*s+1) := by
    rw [←pow_succ, ←pow_mul, ←pow_add]
    congr 1
    omega
  calc
    _ ≤ (T^s*T)^2*(∑ u, ∑ v, entryPower Q s u v)*energy A (entryPower Q s) := hb
    _ ≤ (T^s*T)^2*(Fintype.card U*T^(s-1)*Z)*energy A (entryPower Q s) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (entryPower_mass_le Q s hs T Z hQ hQT hrow) (sq_nonneg _))
        (energy_nonneg A _ hK)
    _ = Fintype.card U*((T^s*T)^2*T^(s-1))*Z*energy A (entryPower Q s) := by ring
    _ = _ := by rw [he]

variable [DecidableEq U]

lemma graph_fourWalk_row_sum (G : SimpleGraph U) [DecidableRel G.Adj]
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (u : U) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v) ≤ D^4 := by
  let A := G.adjMatrix ℝ
  have hA (u v : U) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have ha (u : U) : ∑ v, A u v ≤ D := by
    have he : ∑ v, A u v=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    exact he.le.trans (hdeg u)
  have h₂ (u : U) : ∑ v, (A*A) u v ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hA hD ha ha u
  have h₄ := chain_row_upper (chain_nonneg hA hA) (sq_nonneg D) h₂ h₂ u
  convert h₄ using 1 <;> ring

/-- Under the fourth-row bound alone the central-pin estimate has
`D^(6*s+6)`, rather than the sharp-density scale `D^(6*s+4)`. -/
theorem graph_centerPin_sq_le (G : SimpleGraph U) [DecidableRel G.Adj]
    (s : ℕ) (hs : 1 ≤ s) (T D : ℝ) (hT : 0 ≤ T) (hD : 0 ≤ D)
    (hr : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) :
    let A := G.adjMatrix ℝ
    let Q := (A*A)*(A*A)
    (centerPin A (entryPower Q s))^2 ≤
      Fintype.card U*T^(3*s+1)*D^4*energy A (entryPower Q s) := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  have hA : A.IsSymm := G.isSymm_adjMatrix
  have hQ (u v : U) : 0 ≤ Q u v ∧ Q u v ≤ T :=
    LayeredBush.fourth_entries_of_row_bound G T hT hr u v
  have hz (u : U) : ∑ v, Q u v ≤ D^4 :=
    graph_fourWalk_row_sum G D hD hdeg u
  exact centerPin_power_sq_le A Q hA s hs T (D^4) hT
    (fun u v => (hQ u v).1) (fun u v => (hQ u v).2) hr hz

/-- Actual three-hub-power freeness supplies the fourth-row hypothesis. -/
theorem free_centerPin_sq_le (G : SimpleGraph U) [DecidableRel G.Adj]
    (s M : ℕ) (hs : 1 ≤ s) (hf : (ThreeHub.graph s M).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) :
    let A := G.adjMatrix ℝ
    let Q := (A*A)*(A*A)
    (centerPin A (entryPower Q s))^2 ≤
      Fintype.card U*(ThreeHub.momentCoefficient s M)^(3*s+1)*D^(6*s+6)*
        energy A (entryPower Q s) := by
  have h := graph_centerPin_sq_le G s hs (ThreeHub.momentCoefficient s M*D^2) D
    (mul_nonneg (ThreeHub.momentCoefficient_nonneg s M) (sq_nonneg D)) hD
    (ThreeHub.free_fourth_row_bound s M G hf D hD hdeg) hdeg
  dsimp only at h ⊢
  apply h.trans_eq
  rw [mul_pow]
  have he : (D^2)^(3*s+1)*D^4=D^(6*s+6) := by
    rw [←pow_mul,←pow_add]
    congr 1
    omega
  calc
    _ = Fintype.card U*(ThreeHub.momentCoefficient s M)^(3*s+1)*
        ((D^2)^(3*s+1)*D^4)*energy (G.adjMatrix ℝ)
          (entryPower ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) s) := by ring
    _ = _ := by rw [he]

end Erdos571.ThreeHubKernel


/-! Normalized second-walk kernels retain a nonnegative quadratic bound from
actual forbidden-subdivision freeness. This is stronger information than a
uniform row-square bound; no sharp pin estimate is asserted here. -/
set_option maxHeartbeats 2000000
namespace Erdos571.SubdivisionNormalizedKernel
open Finset Matrix SimpleGraph
variable {W : Type} [Fintype W]

noncomputable def kernel (G : SimpleGraph W) [DecidableRel G.Adj] (d : ℝ) :
    Matrix W W ℝ := (1/d) • (G.adjMatrix ℝ * G.adjMatrix ℝ)

lemma nonneg (G : SimpleGraph W) [DecidableRel G.Adj] (d : ℝ) (hd : 0 < d)
    (u v : W) : 0 ≤ kernel G d u v := by
  classical
  change 0 ≤ (1/d) * (G.adjMatrix ℝ * G.adjMatrix ℝ) u v
  exact mul_nonneg (by positivity) (LightArmKernel.square_nonneg G u v)

lemma symm (G : SimpleGraph W) [DecidableRel G.Adj] (d : ℝ) :
    (kernel G d).IsSymm := by
  apply Matrix.IsSymm.smul
  change (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose = _
  rw [Matrix.transpose_mul, SimpleGraph.transpose_adjMatrix]

lemma posSemidef (G : SimpleGraph W) [DecidableRel G.Adj] (d : ℝ) (hd : 0 < d) :
    (kernel G d).PosSemidef := by
  have h := Matrix.posSemidef_conjTranspose_mul_self (G.adjMatrix ℝ)
  have he : (G.adjMatrix ℝ).conjTranspose = G.adjMatrix ℝ := by
    ext u v
    simp only [Matrix.conjTranspose_apply, star_trivial]
    exact G.isSymm_adjMatrix.apply _ _
  rw [he] at h
  exact h.smul (by positivity : 0 ≤ (1/d : ℝ))

lemma diagonal (G : SimpleGraph W) [DecidableRel G.Adj] (d : ℝ) (u : W) :
    kernel G d u u = (G.degree u : ℝ)/d := by
  change (1/d) * (G.adjMatrix ℝ * G.adjMatrix ℝ) u u = _
  rw [G.adjMatrix_mul_self_apply_self]
  ring

lemma diagonal_bounds (G : SimpleGraph W) [DecidableRel G.Adj]
    (d K : ℝ) (hd : 0 < d)
    (hmin : ∀ u, d ≤ (G.degree u : ℝ)) (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (u : W) : 1 ≤ kernel G d u u ∧ kernel G d u u ≤ K := by
  rw [diagonal]
  exact ⟨(le_div_iff₀ hd).mpr (by simpa using hmin u), (div_le_iff₀ hd).mpr (hmax u)⟩

lemma row_bounds (G : SimpleGraph W) [DecidableRel G.Adj]
    (d K : ℝ) (hd : 0 < d) (hK : 0 ≤ K)
    (hmin : ∀ u, d ≤ (G.degree u : ℝ)) (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (u : W) : d ≤ ∑ v, kernel G d u v ∧ ∑ v, kernel G d u v ≤ K^2*d := by
  let A := G.adjMatrix ℝ
  have hA (x y : W) : 0 ≤ A x y := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hr (x : W) : ∑ y, A x y = (G.degree x : ℝ) := by
    simpa only [Matrix.mulVec, dotProduct, Function.const_apply, mul_one] using
      (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := x))
  have hlo : d^2 ≤ ∑ v, (A*A) u v := by
    simpa only [pow_two] using GramFeatures.chain_row_lower hA hd.le
      (fun x => (hmin x).trans_eq (hr x).symm) (fun x => (hmin x).trans_eq (hr x).symm) u
  have hhi : ∑ v, (A*A) u v ≤ (K*d)^2 := by
    simpa only [pow_two] using GramFeatures.chain_row_upper hA (mul_nonneg hK hd.le)
      (fun x => (hr x).trans_le (hmax x)) (fun x => (hr x).trans_le (hmax x)) u
  have he : (∑ v, kernel G d u v) = (∑ v, (A*A) u v)/d := by
    simp only [kernel, Matrix.smul_apply, smul_eq_mul, ←mul_sum, div_eq_mul_inv, one_mul, A]
    ring
  rw [he]
  constructor
  · apply (le_div_iff₀ hd).mpr
    simpa only [pow_two] using hlo
  · apply (div_le_iff₀ hd).mpr
    nlinarith

lemma gram_quadratic_identity {I : Type*} [Fintype I]
    (A : Matrix I W ℝ) (f : W → ℝ) :
    (∑ u, ∑ v, (A.transpose*A) u v*f u*f v) = ∑ i, (∑ v, A i v*f v)^2 := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, sum_mul, pow_two, mul_sum]
  conv_lhs => arg 2; ext u; rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  rw [sum_comm]
  apply sum_congr rfl
  intro v _
  apply sum_congr rfl
  intro u _
  ring

variable [DecidableEq W]
variable {V : Type} [Fintype V]

/-- A normalized kernel from an actual subdivision-free graph satisfies a
quadratic bound for every nonnegative weight, not only for coordinate rows. -/
theorem free_quadratic_bound (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (d K : ℝ) (hd : 0 < d)
    (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (f : W → ℝ) (hfn : ∀ u, 0 ≤ f u) :
    (∑ u, ∑ v, kernel G d u v*f u*f v) ≤
      (Fintype.card V-1:ℕ) *
        (((Fintype.card V + Nat.card H.edgeSet:ℕ):ℝ)/d*(∑ u, f u)^2 +
          K*∑ u, (f u)^2) := by
  let A := G.adjMatrix ℝ
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have h := HeavyCliqueMoments.quadratic_bound A hA
    (HostHeavyShadow.graph G univ (Fintype.card V + Nat.card H.edgeSet))
    (Fintype.card V) hV (HostHeavyShadow.cliqueFree_of_subdivision_free H G univ hf)
    (Fintype.card V + Nat.card H.edgeSet) (K*d) (by positivity)
    (fun u => by rw [G.isSymm_adjMatrix.eq]; exact (G.adjMatrix_mul_self_apply_self u).le.trans (hmax u))
    (by
      intro u v huv hn
      simpa only [A, G.isSymm_adjMatrix.eq, Nat.cast_add] using
        (HostHeavyShadow.light_square_bound G (Fintype.card V + Nat.card H.edgeSet) u v huv hn)) f hfn
  have he : (∑ u, ∑ v, kernel G d u v*f u*f v) =
      (1/d)*(∑ i, (∑ v, A i v*f v)^2) := by
    rw [←gram_quadratic_identity, G.isSymm_adjMatrix.eq]
    simp only [kernel, Matrix.smul_apply, smul_eq_mul, mul_assoc, ←mul_sum, A]
  rw [he]
  apply (mul_le_mul_of_nonneg_left h (by positivity : 0 ≤ (1/d : ℝ))).trans_eq
  simp only [Nat.cast_add]
  field_simp

/-- The corresponding uniform row-square cap, in dimensionless units. -/
theorem free_row_square_bound (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (d K : ℝ) (hd : 0 < d) (hK : 0 ≤ K)
    (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d) (u : W) :
    (∑ v, (kernel G d u v)^2) ≤
      (Fintype.card V-1:ℕ) *
        (((Fintype.card V + Nat.card H.edgeSet:ℕ):ℝ)+1)*K^2 := by
  have h := HostHeavyShadow.subdivision_free_row_bound H hV G hf (K*d)
    (mul_nonneg hK hd.le) hmax u
  calc
    _ = (1/d)^2 * ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 := by
      simp only [kernel, Matrix.smul_apply, smul_eq_mul, mul_pow, mul_sum]
    _ ≤ (1/d)^2 * ((Fintype.card V-1:ℕ)*
        (((Fintype.card V + Nat.card H.edgeSet:ℕ):ℝ)+1)*(K*d)^2) :=
      mul_le_mul_of_nonneg_left h (sq_nonneg _)
    _ = _ := by field_simp

/-- Specialization to the actual three-hub forbidden graph. -/
theorem threeHub_free_quadratic_bound (s M : ℕ)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ThreeHub.graph s M).Free G)
    (d K : ℝ) (hd : 0 < d) (hmax : ∀ u, (G.degree u : ℝ) ≤ K*d)
    (f : W → ℝ) (hfn : ∀ u, 0 ≤ f u) :
    (∑ u, ∑ v, kernel G d u v*f u*f v) ≤
      (Fintype.card (ThreeHub.Branch s M)-1:ℕ) *
        (((Fintype.card (ThreeHub.Branch s M) +
          Nat.card (FullRootedPower.graph (ThreeHub.base s) (M+1)).edgeSet:ℕ):ℝ)/d*
            (∑ u, f u)^2 + K*∑ u, (f u)^2) :=
  free_quadratic_bound _ (ThreeHub.branch_card_ge s M) G
    (ThreeHub.subdivision_free s M G hf) d K hd hmax f hfn

end Erdos571.SubdivisionNormalizedKernel


/-! An all-hubs-pinned three-hub kernel bound. This is an algebraic estimate,
not a claim that the single-pin errors have been controlled. -/
set_option maxHeartbeats 1000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix
variable {U : Type*} [Fintype U]

noncomputable def fullHubPin (M Q : Matrix U U ℝ) (s : ℕ) : ℝ :=
  ∑ x, (Q x x)^s * (∑ y, (M x y)^2 * (Q y y)^s)^2

/-- Pinning all three hubs gives the sharp dimensionless order `n`. -/
theorem fullHubPin_le (M Q : Matrix U U ℝ) (s : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hdiag : ∀ x, 0 ≤ Q x x ∧ Q x x ≤ T)
    (hrow : ∀ x, ∑ y, (M x y)^2 ≤ T) :
    fullHubPin M Q s ≤ Fintype.card U*T^(3*s+2) := by
  have hr (x : U) : 0 ≤ ∑ y, (M x y)^2*(Q y y)^s :=
    sum_nonneg (fun y _ => mul_nonneg (sq_nonneg _) (pow_nonneg (hdiag y).1 _))
  have hb (x : U) : (∑ y, (M x y)^2*(Q y y)^s) ≤ T^(s+1) := by
    calc
      _ ≤ ∑ y, (M x y)^2*T^s :=
        sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left
          (pow_le_pow_left₀ (hdiag y).1 (hdiag y).2 s) (sq_nonneg _))
      _ = (∑ y, (M x y)^2)*T^s := by rw [sum_mul]
      _ ≤ T*T^s := mul_le_mul_of_nonneg_right (hrow x) (pow_nonneg hT _)
      _ = _ := by rw [pow_succ]; ring
  calc
    _ ≤ ∑ _x : U, T^s*(T^(s+1))^2 := by
      apply sum_le_sum
      intro x _
      exact mul_le_mul (pow_le_pow_left₀ (hdiag x).1 (hdiag x).2 s)
        (pow_le_pow_left₀ (hr x) (hb x) 2) (sq_nonneg _) (pow_nonneg hT _)
    _ = Fintype.card U*T^(3*s+2) := by
      simp only [sum_const,card_univ,nsmul_eq_mul,←pow_mul,←pow_add]
      congr 2
      omega

/-- A symmetric row-square cap supplies all hypotheses of `fullHubPin_le`. -/
theorem fullHubPin_square_le (M : Matrix U U ℝ) (hsym : M.IsSymm)
    (s : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hrow : ∀ x, ∑ y, (M x y)^2 ≤ T) :
    fullHubPin M (M*M) s ≤ Fintype.card U*T^(3*s+2) := by
  apply fullHubPin_le M (M*M) s T hT _ hrow
  intro x
  have he : (M*M) x x = ∑ y, (M x y)^2 := by
    simp only [Matrix.mul_apply]
    exact sum_congr rfl (fun y _ => by rw [hsym.apply y x, pow_two])
  rw [he]
  exact ⟨sum_nonneg (fun y _ => sq_nonneg _),hrow x⟩

end Erdos571.ThreeHubKernel

/- A representative-matching estimate for incidence traces with both fiber
sizes bounded. All codegree and local-degree hypotheses remain explicit. -/
set_option maxHeartbeats 2000000
namespace Erdos571.IncidenceTrace
open Finset SimpleGraph ProjectionHeavy PatternCone SixCycleCase BipartiteCycleBounds

variable {L R : Type} [DecidableEq L] [DecidableEq R]

/-- A maximal matching covers a finite relation by its selected rows and
columns. Bounded fibers turn this into a cardinality estimate. -/
theorem card_le_fiber_caps (O M : Finset (L×R))
    (hL : Set.InjOn Prod.fst (M : Set (L×R)))
    (hR : Set.InjOn Prod.snd (M : Set (L×R)))
    (hcover : ∀ l r, (l,r)∈O → r∉M.image Prod.snd → l∈M.image Prod.fst)
    (a b : ℕ)
    (ha : ∀ l, (O.filter (fun p => p.1=l)).card ≤ a)
    (hb : ∀ r, (O.filter (fun p => p.2=r)).card ≤ b) :
    O.card ≤ (a+b)*M.card := by
  classical
  let X := O.filter (fun p => p.1∈M.image Prod.fst)
  let Y := O.filter (fun p => p.2∈M.image Prod.snd)
  have hc : O ⊆ X∪Y := by
    intro p hp
    by_cases hr : p.2∈M.image Prod.snd
    · exact mem_union_right _ (mem_filter.mpr ⟨hp,hr⟩)
    · exact mem_union_left _ (mem_filter.mpr ⟨hp,hcover _ _ hp hr⟩)
  have hx : X.card ≤ a*M.card := by
    have h := card_le_mul_card_image (f := Prod.fst) X a (fun l _ =>
      (card_le_card (by intro p hp; exact mem_filter.mpr ⟨(mem_filter.mp (mem_filter.mp hp).1).1,(mem_filter.mp hp).2⟩)).trans (ha l))
    have hi : X.image Prod.fst ⊆ M.image Prod.fst := by
      intro l hl
      obtain ⟨p,hp,rfl⟩ := mem_image.mp hl
      exact (mem_filter.mp hp).2
    exact h.trans ((Nat.mul_le_mul_left _ (card_le_card hi)).trans_eq
      (by rw [card_image_of_injOn hL]))
  have hy : Y.card ≤ b*M.card := by
    have h := card_le_mul_card_image (f := Prod.snd) Y b (fun r _ =>
      (card_le_card (by intro p hp; exact mem_filter.mpr ⟨(mem_filter.mp (mem_filter.mp hp).1).1,(mem_filter.mp hp).2⟩)).trans (hb r))
    have hi : Y.image Prod.snd ⊆ M.image Prod.snd := by
      intro r hr
      obtain ⟨p,hp,rfl⟩ := mem_image.mp hr
      exact (mem_filter.mp hp).2
    exact h.trans ((Nat.mul_le_mul_left _ (card_le_card hi)).trans_eq
      (by rw [card_image_of_injOn hR]))
  exact (card_le_card hc).trans ((card_union_le _ _).trans (by rw [add_mul]; exact Nat.add_le_add hx hy))

variable [Fintype L]

noncomputable def candidates (E : Finset (L×R)) (B : Finset R) :
    Finset (Sym2 L × R) := by
  classical
  exact (univ ×ˢ B).filter (fun p => ¬p.1.IsDiag ∧ ∀v∈p.1, (v,p.2)∈E)

lemma mem_candidates (E : Finset (L×R)) (B : Finset R) (e : Sym2 L) (b : R) :
    (e,b)∈candidates E B ↔ b∈B ∧ ¬e.IsDiag ∧ ∀v∈e, (v,b)∈E := by
  classical
  simp only [candidates,mem_filter,mem_product,mem_univ,true_and]

/-- The selected endpoint pairs form an ordinary `H`-free graph: colors are
chosen injectively, rather than merely assigned independently to edges. -/
theorem representatives {V : Type} [Fintype V]
    (H : SimpleGraph V) (E : Finset (L×R)) (B : Finset R)
    (hf : ¬Contains (incidence H) E univ B) :
    ∃ M ⊆ candidates E B,
      Set.InjOn Prod.fst (M : Set (Sym2 L × R)) ∧
      Set.InjOn Prod.snd (M : Set (Sym2 L × R)) ∧
      (∀ e b, (e,b)∈candidates E B → b∉M.image Prod.snd → e∈M.image Prod.fst) ∧
      ∃ Q : SimpleGraph L, H.Free Q ∧ Nat.card Q.edgeSet=M.card ∧
        Q.edgeSet=(M.image Prod.fst : Set (Sym2 L)) := by
  classical
  obtain ⟨M,hMO,hL,hR,hmax⟩ := maximal_matching (candidates E B)
  let S := M.image Prod.fst
  let Q := fromEdgeSet (S : Set (Sym2 L))
  have hS (e : Sym2 L) (he : e∈S) : ¬e.IsDiag := by
    obtain ⟨p,hp,rfl⟩ := mem_image.mp he
    exact ((mem_candidates E B _ _).mp (hMO hp)).2.1
  have hQE : Q.edgeSet=(S : Set (Sym2 L)) := by
    ext e
    simp only [Q,edgeSet_fromEdgeSet,Set.mem_diff,Sym2.mem_diagSet_iff_isDiag]
    exact ⟨fun h => h.1,fun h => ⟨h,hS e h⟩⟩
  have hfind (e : Q.edgeSet) : ∃b, (e.val,b)∈M := by
    have he : e.val∈S := by
      change e.val∈(S:Set (Sym2 L))
      rw [←hQE]
      exact e.property
    obtain ⟨⟨e',b⟩,hp,he⟩ := mem_image.mp he
    dsimp only [Prod.fst] at he
    subst e'
    exact ⟨b,hp⟩
  choose col hcol using hfind
  have hcolinj : Function.Injective col := by
    intro e f h
    exact Subtype.ext (congrArg Prod.fst (hR (hcol e) (hcol f) h))
  have hcolB (e : Q.edgeSet) : col e∈B :=
    ((mem_candidates E B _ _).mp (hMO (hcol e))).1
  have hcolE (e : Q.edgeSet) (v : L) (hv : v∈e.val) : (v,col e)∈E :=
    ((mem_candidates E B _ _).mp (hMO (hcol e))).2.2 v hv
  have hQfree : H.Free Q := by
    rintro ⟨f⟩
    let edge := f.toHom.mapEdgeSet
    apply hf
    refine ⟨f,fun e => col (edge e),f.injective,?_,fun _ => mem_univ _,?_,?_⟩
    · exact hcolinj.comp (Hom.mapEdgeSet.injective f.toHom f.injective)
    · exact fun e => hcolB (edge e)
    · intro v e hve
      exact hcolE (edge e) (f v) (Sym2.mem_map.mpr ⟨v,hve,rfl⟩)
  have hcard : Nat.card Q.edgeSet=M.card := by
    rw [hQE,Nat.card_eq_fintype_card]
    have hc := Fintype.card_of_finset' (p := (S : Set (Sym2 L))) S (fun _ => Iff.rfl)
    rw [hc]
    exact card_image_of_injOn hL
  exact ⟨M,hMO,hL,hR,hmax,Q,hQfree,hcard,hQE⟩

/-- An ordinary extremal bound controls all candidate pairs when both
incidence-fiber caps are available. -/
theorem candidates_bound {V : Type} [Fintype V]
    (H : SimpleGraph V) {α C : ℝ} (hbound : EdgeBound H α C)
    (E : Finset (L×R)) (B : Finset R)
    (hf : ¬Contains (incidence H) E univ B) (a b : ℕ)
    (ha : ∀ e, ((candidates E B).filter (fun p => p.1=e)).card ≤ a)
    (hb : ∀ r, ((candidates E B).filter (fun p => p.2=r)).card ≤ b) :
    ((candidates E B).card:ℝ) ≤ (a+b:ℕ)*C*(Fintype.card L:ℝ)^α := by
  obtain ⟨M,hMO,hL,hR,hcover,Q,hQ,hcard,hQE⟩ := representatives H E B hf
  have hc := card_le_fiber_caps (candidates E B) M hL hR hcover a b ha hb
  have he := hbound.estimate Q hQ
  rw [hcard] at he
  exact (show ((candidates E B).card:ℝ) ≤ (a+b:ℕ)*(M.card:ℝ) by exact_mod_cast hc).trans
    ((mul_le_mul_of_nonneg_left he (Nat.cast_nonneg (a+b))).trans_eq (by ring))

lemma candidates_row_cap (E : Finset (L×R)) (B : Finset R) (a : ℕ)
    (h : ∀ u v, u≠v → (ProjectionHeavy.common E B u v).card ≤ a) (e : Sym2 L) :
    ((candidates E B).filter (fun p => p.1=e)).card ≤ a := by
  classical
  induction e using Sym2.inductionOn with
  | hf u v =>
    by_cases huv : u=v
    · subst v
      have he : (candidates E B).filter (fun p => p.1=s(u,u))=∅ := by
        apply eq_empty_iff_forall_notMem.mpr
        intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        have hh := ((mem_candidates E B _ _).mp hp).2.1
        rw [he] at hh
        exact hh (by simp)
      simp only [he,card_empty]
      omega
    · apply (card_le_card_of_injOn Prod.snd ?_ ?_).trans (h u v huv)
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        have hh := (mem_candidates E B _ _).mp hp
        apply mem_filter.mpr
        refine ⟨hh.1,hh.2.2 u ?_,hh.2.2 v ?_⟩ <;> simp [he]
      · intro p hp q hq he
        exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) he

lemma candidates_column_cap (E : Finset (L×R)) (B : Finset R) (b : ℕ)
    (h : ∀ r∈B, (nl E univ r).card ≤ b) (r : R) :
    ((candidates E B).filter (fun p => p.2=r)).card ≤ b^2 := by
  classical
  by_cases hr : r∈B
  · have hc : ((candidates E B).filter (fun p => p.2=r)).card ≤
        ((nl E univ r) ×ˢ (nl E univ r)).card := by
      apply card_le_card_of_injOn (fun p => p.1.out)
      · intro p hp
        obtain ⟨hp,he⟩ := mem_filter.mp hp
        have hh := (mem_candidates E B _ _).mp hp
        apply mem_product.mpr
        constructor
        · exact mem_filter.mpr ⟨mem_univ _,by simpa only [he] using hh.2.2 _ (Sym2.out_fst_mem p.1)⟩
        · exact mem_filter.mpr ⟨mem_univ _,by simpa only [he] using hh.2.2 _ (Sym2.out_snd_mem p.1)⟩
      · intro p hp q hq he
        apply Prod.ext _ ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm)
        calc
          p.1 = Quot.mk _ p.1.out := p.1.out_eq.symm
          _ = Quot.mk _ q.1.out := congrArg (Quot.mk _) he
          _ = q.1 := q.1.out_eq
    rw [card_product] at hc
    exact hc.trans (by have hh := h r hr; nlinarith)
  · have he : (candidates E B).filter (fun p => p.2=r)=∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro p hp
      exact hr ((mem_filter.mp hp).2 ▸ ((mem_candidates E B _ _).mp (mem_filter.mp hp).1).1)
    simp only [he,card_empty]
    omega

/-- Bounded pair multiplicity and bounded middle degree give a local trace
bound, with no minimum middle-degree requirement. -/
theorem bounded_trace {V : Type} [Fintype V]
    (H : SimpleGraph V) {α C : ℝ} (hbound : EdgeBound H α C)
    (E : Finset (L×R)) (B : Finset R)
    (hf : ¬Contains (incidence H) E univ B) (a b : ℕ)
    (ha : ∀ u v, u≠v → (ProjectionHeavy.common E B u v).card ≤ a)
    (hb : ∀ r∈B, (nl E univ r).card ≤ b) :
    ((candidates E B).card:ℝ) ≤ (a+b^2:ℕ)*C*(Fintype.card L:ℝ)^α :=
  candidates_bound H hbound E B hf a (b^2)
    (candidates_row_cap E B a ha) (candidates_column_cap E B b hb)

/-- The vertex factor can be restricted to an endpoint support. -/
theorem bounded_trace_on {V : Type} [Fintype V]
    (H : SimpleGraph V) {α C : ℝ} (hbound : EdgeBound H α C)
    (E : Finset (L×R)) (A : Finset L) (B : Finset R)
    (hEA : ∀ p∈E, p.1∈A)
    (hf : ¬Contains (incidence H) E univ B) (a b : ℕ)
    (ha : ∀ u v, u≠v → (ProjectionHeavy.common E B u v).card ≤ a)
    (hb : ∀ r∈B, (nl E univ r).card ≤ b) :
    ((candidates E B).card:ℝ) ≤ (a+b^2:ℕ)*C*(A.card:ℝ)^α := by
  classical
  obtain ⟨M,hMO,hL,hR,hcover,Q,hQ,hcard,hQE⟩ := representatives H E B hf
  have hsupp : Q.support ⊆ (A : Set L) := by
    intro x hx
    obtain ⟨y,hxy⟩ := hx
    have he : s(x,y)∈Q.edgeSet := hxy
    rw [hQE] at he
    obtain ⟨p,hp,he⟩ := mem_image.mp he
    have hh := (mem_candidates E B _ _).mp (hMO hp)
    exact hEA (x,p.2) (hh.2.2 x (by simp [he]))
  have hQi : H.Free (Q.induce (A : Set L)) := by
    intro hc
    exact hQ (hc.trans ⟨Copy.induce Q (A : Set L)⟩)
  have he := hbound.estimate (Q.induce (A : Set L)) hQi
  have hcards : Nat.card (Q.induce (A : Set L)).edgeSet=M.card := by
    have hq := Q.card_edgeFinset_induce_of_support_subset hsupp
    have hq' : Nat.card (Q.induce (A : Set L)).edgeSet=Nat.card Q.edgeSet := by
      simpa only [←card_edgeSet,←Nat.card_eq_fintype_card] using hq
    exact hq'.trans hcard
  have haCard : Fintype.card (A : Set L)=A.card :=
    Fintype.card_of_finset' (p := (A : Set L)) A (fun _ => Iff.rfl)
  rw [hcards,haCard] at he
  have hc := card_le_fiber_caps (candidates E B) M hL hR hcover a (b^2)
    (candidates_row_cap E B a ha) (candidates_column_cap E B b hb)
  exact (show ((candidates E B).card:ℝ) ≤ (a+b^2:ℕ)*(M.card:ℝ) by exact_mod_cast hc).trans
    ((mul_le_mul_of_nonneg_left he (Nat.cast_nonneg (a+b^2))).trans_eq (by ring))

/-- Each unordered endpoint pair has at most two ordered representatives. -/
lemma ordered_fiber_card (F : Finset ((L×L)×R)) (p : Sym2 L × R) :
    (F.filter (fun t => (s(t.1.1,t.1.2),t.2)=p)).card ≤ 2 := by
  classical
  let a := p.1.out.1
  let b := p.1.out.2
  have he : s(a,b)=p.1 := p.1.out_eq
  have hs : F.filter (fun t => (s(t.1.1,t.1.2),t.2)=p) ⊆
      {((a,b),p.2),((b,a),p.2)} := by
    intro t ht
    have h := (mem_filter.mp ht).2
    have hp := congrArg Prod.fst h
    have hr := congrArg Prod.snd h
    dsimp only [Prod.fst,Prod.snd] at hp hr
    rw [←he,Sym2.eq_iff] at hp
    rcases hp with ⟨h₁,h₂⟩ | ⟨h₁,h₂⟩
    · have ht : t=((a,b),p.2) := Prod.ext (Prod.ext h₁ h₂) hr
      simp only [ht,mem_insert,mem_singleton,true_or]
    · have ht : t=((b,a),p.2) := Prod.ext (Prod.ext h₁ h₂) hr
      simp only [ht,mem_insert,mem_singleton,or_true]
  exact (card_le_card hs).trans (card_insert_le _ _ |>.trans (by simp))

/-- A family of oriented, distinct-endpoint two-paths is bounded by twice
its candidate-pair trace. -/
theorem oriented_card_le (E : Finset (L×R)) (B : Finset R)
    (F : Finset ((L×L)×R))
    (hF : ∀ t∈F, t.2∈B ∧ t.1.1≠t.1.2 ∧ (t.1.1,t.2)∈E ∧ (t.1.2,t.2)∈E) :
    F.card ≤ 2*(candidates E B).card := by
  classical
  let f : ((L×L)×R) → (Sym2 L × R) := fun t => (s(t.1.1,t.1.2),t.2)
  have h := card_le_mul_card_image (f := f) F 2 (fun p _ => ordered_fiber_card F p)
  have hs : F.image f ⊆ candidates E B := by
    intro p hp
    obtain ⟨t,ht,rfl⟩ := mem_image.mp hp
    obtain ⟨hb,hne,hl,hr⟩ := hF t ht
    apply (mem_candidates E B _ _).mpr
    refine ⟨hb,?_,?_⟩
    · simpa only [Sym2.isDiag_iff_proj_eq] using hne
    · intro x hx
      rcases Sym2.mem_iff.mp hx with rfl | rfl
      · exact hl
      · exact hr
  exact h.trans (Nat.mul_le_mul_left _ (card_le_card hs))

end Erdos571.IncidenceTrace

/- Off-diagonal four-walk bounds under a global codegree cap. This cap is
not derived from freeness and is not silently imposed on masked copies. -/
set_option maxHeartbeats 2500000
namespace Erdos571.LocalFourthWalk
open Finset SimpleGraph Matrix ProjectionHeavy PatternCone BipartiteCycleBounds
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

def common (u v : W) : Finset W := G.neighborFinset u ∩ G.neighborFinset v

def walks (u v : W) : Finset ((W×W)×W) :=
  univ.filter (fun t => G.Adj u t.1.1 ∧ G.Adj t.1.1 t.2 ∧ G.Adj t.2 t.1.2 ∧ G.Adj t.1.2 v)

lemma mem_common (u v x : W) : x∈common G u v ↔ G.Adj u x ∧ G.Adj v x := by
  simp only [common,mem_inter,G.mem_neighborFinset]

lemma common_card (u v : W) : (common G u v).card=Fintype.card (G.commonNeighbors u v) := by
  symm
  exact Fintype.card_of_finset' (common G u v) (fun x => by
    simp only [mem_common,SimpleGraph.mem_commonNeighbors])

lemma mem_walks (u v : W) (t : (W×W)×W) : t∈walks G u v ↔
    G.Adj u t.1.1 ∧ G.Adj t.1.1 t.2 ∧ G.Adj t.2 t.1.2 ∧ G.Adj t.1.2 v := by
  simp only [walks,mem_filter,mem_univ,true_and]

lemma walks_card (u v : W) : ((walks G u v).card:ℝ)=
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v := by
  simp only [walks,card_filter,Nat.cast_sum,Nat.cast_ite,Nat.cast_one,Nat.cast_zero,
    Fintype.sum_prod_type,Matrix.mul_apply,mul_sum,sum_mul]
  conv_lhs => arg 2; ext x; rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro z _
  rw [sum_comm]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  dsimp [SimpleGraph.adjMatrix]
  split_ifs <;> simp_all

lemma middle_left_card (u v : W) (L D : ℕ) (huv : u≠v)
    (hc : (common G u v).card ≤ L) (hd : G.degree u ≤ D) :
    ((walks G u v).filter (fun t => t.2=u)).card ≤ D*L := by
  have h : ((walks G u v).filter (fun t => t.2=u)).card ≤
      ((G.neighborFinset u) ×ˢ (common G u v)).card := by
    apply card_le_card_of_injOn Prod.fst
    · intro t ht
      obtain ⟨ht,he⟩ := mem_filter.mp ht
      have hh := (mem_walks G u v t).mp ht
      exact mem_product.mpr ⟨(G.mem_neighborFinset _ _).mpr hh.1,
        (mem_common G u v _).mpr ⟨he ▸ hh.2.2.1,hh.2.2.2.symm⟩⟩
    · intro p hp q hq he
      exact Prod.ext he ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm)
  rw [card_product,card_neighborFinset_eq_degree] at h
  exact h.trans (Nat.mul_le_mul hd hc)

lemma middle_right_card (u v : W) (L D : ℕ)
    (hc : (common G u v).card ≤ L) (hd : G.degree v ≤ D) :
    ((walks G u v).filter (fun t => t.2=v)).card ≤ L*D := by
  have h : ((walks G u v).filter (fun t => t.2=v)).card ≤
      ((common G u v) ×ˢ (G.neighborFinset v)).card := by
    apply card_le_card_of_injOn Prod.fst
    · intro t ht
      obtain ⟨ht,he⟩ := mem_filter.mp ht
      have hh := (mem_walks G u v t).mp ht
      exact mem_product.mpr ⟨(mem_common G u v _).mpr ⟨hh.1,he ▸ hh.2.1.symm⟩,
        (G.mem_neighborFinset _ _).mpr hh.2.2.2.symm⟩
    · intro p hp q hq he
      exact Prod.ext he ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm)
  rw [card_product,card_neighborFinset_eq_degree] at h
  exact h.trans (Nat.mul_le_mul hc hd)

lemma repeated_endpoint_card (u v : W) (L D : ℕ)
    (hc : (common G u v).card ≤ L) (hd : ∀ x, G.degree x ≤ D) :
    ((walks G u v).filter (fun t => t.1.1=t.1.2)).card ≤ D*L := by
  let F := (walks G u v).filter (fun t => t.1.1=t.1.2)
  let f : ((W×W)×W) → W := fun t => t.1.1
  have hf (x : W) : (F.filter (fun t => f t=x)).card ≤ D := by
    have h : (F.filter (fun t => f t=x)).card ≤ (G.neighborFinset x).card := by
      apply card_le_card_of_injOn Prod.snd
      · intro t ht
        have hm := (mem_filter.mp (mem_filter.mp ht).1).1
        have hh := (mem_walks G u v t).mp hm
        apply (G.mem_neighborFinset _ _).mpr
        exact (mem_filter.mp ht).2 ▸ hh.2.1
      · intro p hp q hq he
        have hpx := (mem_filter.mp hp).2
        have hqx := (mem_filter.mp hq).2
        have hpy := (mem_filter.mp (mem_filter.mp hp).1).2
        have hqy := (mem_filter.mp (mem_filter.mp hq).1).2
        apply Prod.ext _ he
        apply Prod.ext (hpx.trans hqx.symm)
        exact hpy.symm.trans ((hpx.trans hqx.symm).trans hqy)
    exact h.trans (by simpa only [card_neighborFinset_eq_degree] using hd x)
  have him : F.image f ⊆ common G u v := by
    intro x hx
    obtain ⟨t,ht,rfl⟩ := mem_image.mp hx
    have hh := (mem_walks G u v t).mp (mem_filter.mp ht).1
    apply (mem_common G u v _).mpr
    refine ⟨hh.1,?_⟩
    change G.Adj v t.1.1
    rw [(mem_filter.mp ht).2]
    exact hh.2.2.2.symm
  exact (card_le_mul_card_image F D (fun x _ => hf x)).trans
    (Nat.mul_le_mul_left _ ((card_le_card him).trans hc))

variable {V : Type} [Fintype V]

/-- Passing to all endpoint vertices does not change incidence freeness if
all pattern vertices have an incident edge and the relation is supported on A. -/
lemma contains_univ_false (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    (A B : Finset W) (E : Finset (W×W))
    (hEA : ∀ p∈E, p.1∈A)
    (hf : ¬Contains (incidence H) E A B) :
    ¬Contains (incidence H) E univ B := by
  rintro ⟨f,g,hfi,hgi,hfa,hgb,hadj⟩
  apply hf
  refine ⟨f,g,hfi,hgi,?_,hgb,hadj⟩
  intro x
  obtain ⟨y,hxy⟩ := hH x
  let e : H.edgeSet := ⟨s(x,y),hxy⟩
  apply hEA (f x,g e)
  apply hadj
  simp [incidence,e]

/-- The local trace bound controls off-diagonal four-walks. The global
codegree cap and triangle-free condition are explicit hypotheses. -/
theorem off_diagonal_bound (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (htri : ∀ x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    (L D : ℕ)
    (hcodeg : ∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (hdeg : ∀ x, G.degree x ≤ D) (u v : W) (huv : u≠v) :
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤
      2*(L+(2*L)^2:ℕ)*C*(2*(D:ℝ))^α+3*(L:ℝ)*D := by
  classical
  let A := G.neighborFinset u ∪ G.neighborFinset v
  let B := univ \ (A∪{u,v})
  let E := (A×ˢB).filter (fun p => G.Adj p.1 p.2)
  let F := (walks G u v).filter (fun t => t.2≠u ∧ t.2≠v ∧ t.1.1≠t.1.2)
  have hEA : ∀ p∈E, p.1∈A := by
    intro p hp
    exact (mem_product.mp (mem_filter.mp hp).1).1
  have hdis : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro x hx hxB
    exact (Finset.mem_sdiff.mp hxB).2 (mem_union_left _ hx)
  have hfree : ¬Contains (incidence H) E univ B :=
    contains_univ_false H hH A B E hEA (PatternCone.cut_not_contains (incidence H) G hf A B hdis)
  have hc (x y : W) (hxy : x≠y) : (common G x y).card ≤ L := by
    rw [common_card]
    exact hcodeg x y hxy
  have hpair (x y : W) (hxy : x≠y) : (ProjectionHeavy.common E B x y).card ≤ L := by
    apply (card_le_card ?_).trans (hc x y hxy)
    intro z hz
    have hh := (mem_filter.mp hz).2
    apply (mem_common G x y z).mpr
    exact ⟨(mem_filter.mp hh.1).2,(mem_filter.mp hh.2).2⟩
  have hmid (z : W) (hz : z∈B) : (nl E univ z).card ≤ 2*L := by
    have hzu : z≠u := by
      intro h; exact (Finset.mem_sdiff.mp hz).2 (mem_union_right _ (by simp [h]))
    have hzv : z≠v := by
      intro h; exact (Finset.mem_sdiff.mp hz).2 (mem_union_right _ (by simp [h]))
    have hs : nl E univ z ⊆ common G u z ∪ common G v z := by
      intro x hx
      have he := (mem_filter.mp hx).2
      have hxa := hEA _ he
      have hxz := (mem_filter.mp he).2
      rcases mem_union.mp hxa with hxu | hxv
      · exact mem_union_left _ ((mem_common G u z x).mpr
          ⟨(G.mem_neighborFinset _ _).mp hxu,hxz.symm⟩)
      · exact mem_union_right _ ((mem_common G v z x).mpr
          ⟨(G.mem_neighborFinset _ _).mp hxv,hxz.symm⟩)
    exact (card_le_card hs).trans ((card_union_le _ _).trans (by
      have h₁ := hc u z hzu.symm
      have h₂ := hc v z hzv.symm
      omega))
  have hF : ∀ t∈F, t.2∈B ∧ t.1.1≠t.1.2 ∧ (t.1.1,t.2)∈E ∧ (t.1.2,t.2)∈E := by
    intro t ht
    obtain ⟨ht,hzu,hzv,hxy⟩ := mem_filter.mp ht
    have hh := (mem_walks G u v t).mp ht
    have hx : t.1.1∈A := mem_union_left _ ((G.mem_neighborFinset _ _).mpr hh.1)
    have hy : t.1.2∈A := mem_union_right _ ((G.mem_neighborFinset _ _).mpr hh.2.2.2.symm)
    have hz : t.2∈B := by
      apply Finset.mem_sdiff.mpr
      refine ⟨mem_univ _,?_⟩
      intro hz
      rcases mem_union.mp hz with hz | hz
      · rcases mem_union.mp hz with hu | hv
        · exact htri u t.1.1 t.2 hh.1 hh.2.1 ((G.mem_neighborFinset _ _).mp hu)
        · exact htri v t.1.2 t.2 hh.2.2.2.symm hh.2.2.1.symm ((G.mem_neighborFinset _ _).mp hv)
      · simp only [mem_insert,mem_singleton] at hz
        exact hz.elim hzu hzv
    exact ⟨hz,hxy,mem_filter.mpr ⟨mem_product.mpr ⟨hx,hz⟩,hh.2.1⟩,
      mem_filter.mpr ⟨mem_product.mpr ⟨hy,hz⟩,hh.2.2.1.symm⟩⟩
  have hfcard := IncidenceTrace.oriented_card_le E B F hF
  have htrace := IncidenceTrace.bounded_trace_on H hbound E A B hEA hfree L (2*L) hpair hmid
  have hac : A.card ≤ 2*D := by
    exact (card_union_le _ _).trans (by
      simp only [card_neighborFinset_eq_degree]
      have h₁ := hdeg u
      have h₂ := hdeg v
      omega)
  have hac' : (A.card:ℝ)^α ≤ (2*(D:ℝ))^α :=
    Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hac) hα
  have hgood : (F.card:ℝ) ≤ 2*(L+(2*L)^2:ℕ)*C*(2*(D:ℝ))^α := by
    have h₁ : (F.card:ℝ) ≤ 2*((IncidenceTrace.candidates E B).card:ℝ) := by exact_mod_cast hfcard
    have h₂ := mul_le_mul_of_nonneg_left htrace (by norm_num : (0:ℝ)≤2)
    have h₃ := mul_le_mul_of_nonneg_left hac' (by positivity : 0≤2*(L+(2*L)^2:ℕ)*C)
    exact h₁.trans ((h₂.trans_eq (by ring)).trans h₃)
  let Z₁ := (walks G u v).filter (fun t => t.2=u)
  let Z₂ := (walks G u v).filter (fun t => t.2=v)
  let X := (walks G u v).filter (fun t => t.1.1=t.1.2)
  have hs : walks G u v ⊆ Z₁∪Z₂∪X∪F := by
    intro t ht
    by_cases h₁ : t.2=u
    · exact mem_union_left _ (mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨ht,h₁⟩)))
    by_cases h₂ : t.2=v
    · exact mem_union_left _ (mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨ht,h₂⟩)))
    by_cases hx : t.1.1=t.1.2
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨ht,hx⟩))
    exact mem_union_right _ (mem_filter.mpr ⟨ht,h₁,h₂,hx⟩)
  have hz₁ : Z₁.card ≤ D*L := middle_left_card G u v L D huv (hc u v huv) (hdeg u)
  have hz₂ : Z₂.card ≤ L*D := middle_right_card G u v L D (hc u v huv) (hdeg v)
  have hx : X.card ≤ D*L := repeated_endpoint_card G u v L D (hc u v huv) hdeg
  have hcard : (walks G u v).card ≤ 3*L*D+F.card := by
    have h := (card_le_card hs).trans (card_union_le _ _)
    have h₁ := card_union_le (Z₁∪Z₂) X
    have h₂ := card_union_le Z₁ Z₂
    nlinarith
  rw [←walks_card]
  have hcard' : ((walks G u v).card:ℝ) ≤ 3*(L:ℝ)*D+F.card := by exact_mod_cast hcard
  linarith

end Erdos571.LocalFourthWalk

/- Local four-walk decay for the actual three-hub forbidden graph, under
an explicit global codegree bound. -/
set_option maxHeartbeats 2500000
namespace Erdos571.FullRootedPower
open SimpleGraph
lemma no_isolated {A R : Type*} (H : SimpleGraph (A ⊕ R))
    (hH : ∀ x, ∃ y, H.Adj x y) (M : ℕ) (hM : 1 ≤ M) :
    ∀ x, ∃ y, (graph H M).Adj x y := by
  intro x
  rcases x with ⟨i,a⟩ | r
  · obtain ⟨y,hy⟩ := hH (.inl a)
    rcases y with b | r
    · exact ⟨.inl (i,b),rfl,hy⟩
    · exact ⟨.inr r,hy⟩
  · obtain ⟨y,hy⟩ := hH (.inr r)
    rcases y with a | s
    · exact ⟨.inl (⟨0,by omega⟩,a),hy⟩
    · exact ⟨.inr s,hy⟩
end Erdos571.FullRootedPower

namespace Erdos571.LocalFourthWalk
open SimpleGraph Matrix Finset ProjectionHeavy
lemma triangle_free_of_bipartite {W : Type*} (G : SimpleGraph W)
    (hb : G.IsBipartite) :
    ∀ x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z := by
  let c : G.Coloring Bool := hb.toColoring (by simp)
  intro x y z hxy hyz hxz
  have h₁ := c.valid hxy
  have h₂ := c.valid hyz
  have h₃ := c.valid hxz
  cases hx : c x <;> cases hy : c y <;> cases hz : c z <;> simp_all
end Erdos571.LocalFourthWalk

namespace Erdos571.ThreeHub
open SimpleGraph Matrix Finset ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]

lemma base_power_no_isolated (s M : ℕ) :
    ∀ x, ∃ y, (FullRootedPower.graph (base s) (M+1)).Adj x y :=
  FullRootedPower.no_isolated _ (BalancedExactLower.no_isolated 2 (3*s-1)) _ (by omega)

noncomputable def baseUpperExponent (s M : ℕ) : ℝ :=
  2-1/(Fintype.card (Branch s M):ℝ)
noncomputable def baseUpperCoefficient (s M : ℕ) : ℝ :=
  2*(Fintype.card (Branch s M))+(Fintype.card (Branch s M)+1)

lemma baseUpperExponent_bounds (s M : ℕ) :
    1 ≤ baseUpperExponent s M ∧ baseUpperExponent s M < 2 := by
  have hq : (1:ℝ) ≤ Fintype.card (Branch s M) := by
    exact_mod_cast (show 1 ≤ Fintype.card (Branch s M) by have h := branch_card_ge s M; omega)
  have hp : (0:ℝ) < Fintype.card (Branch s M) := by linarith
  have hi := (div_le_one hp).mpr hq
  have hj := one_div_pos.mpr hp
  dsimp [baseUpperExponent]
  constructor <;> linarith

lemma base_edge_bound (s M : ℕ) :
    EdgeBound (FullRootedPower.graph (base s) (M+1))
      (baseUpperExponent s M) (baseUpperCoefficient s M) := by
  have hq : 1 ≤ Fintype.card (Branch s M) := by have h := branch_card_ge s M; omega
  exact (ShortSpider.kst_bound _ _ hq hq).mono
    ⟨BipartiteSubdivisionUpper.bipartiteCopy _ (base_power_bipartite s (M+1))⟩

/-- The codegree assumption here is global; no reduction removing it is used. -/
theorem off_diagonal_fourWalk_bound (s M : ℕ) (G : SimpleGraph W)
    [DecidableRel G.Adj] (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (L D : ℕ)
    (hcodeg : ∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (hdeg : ∀ x, G.degree x ≤ D) (u v : W) (huv : u≠v) :
    ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v ≤
      2*(L+(2*L)^2:ℕ)*(baseUpperCoefficient s M)*
        (2*(D:ℝ))^(baseUpperExponent s M)+3*(L:ℝ)*D :=
  LocalFourthWalk.off_diagonal_bound G _ (base_power_no_isolated s M)
    (by have h := (baseUpperExponent_bounds s M).1; linarith)
    (by dsimp [baseUpperCoefficient]; positivity) (base_edge_bound s M)
    (subdivision_free s M G hf) (LocalFourthWalk.triangle_free_of_bipartite G hb)
    L D hcodeg hdeg u v huv
end Erdos571.ThreeHub

/- Scaling the local four-walk estimate. The global codegree hypothesis
is retained in every graph application. -/
set_option maxHeartbeats 2500000
namespace Erdos571.LocalFourthWalk
open Finset SimpleGraph Matrix ProjectionHeavy

lemma normalize_power_bound {a b α d K D w : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hα : 1 ≤ α) (hd : 1 ≤ d)
    (hK : 0 ≤ K) (hD : 0 ≤ D) (hDK : D ≤ K*d)
    (hw : w ≤ a*(2*D)^α+b*D) :
    w/d^2 ≤ (a*(2*K)^α+b*K)*d^(α-2) := by
  have hdp : 0 < d := by linarith
  have hd2 : 0 < d^2 := sq_pos_of_pos hdp
  have hp : (2*D)^α ≤ (2*(K*d))^α :=
    Real.rpow_le_rpow (by positivity) (by linarith) (by linarith)
  have he : (2*(K*d))^α=(2*K)^α*d^α := by
    rw [←mul_assoc,Real.mul_rpow (by positivity) hdp.le]
  have hpow : d ≤ d^α := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hd hα
  have h : w ≤ (a*(2*K)^α+b*K)*d^α := by
    calc
      w ≤ a*(2*D)^α+b*D := hw
      _ ≤ a*(2*(K*d))^α+b*(K*d) :=
        add_le_add (mul_le_mul_of_nonneg_left hp ha) (mul_le_mul_of_nonneg_left hDK hb)
      _ ≤ a*((2*K)^α*d^α)+b*(K*d^α) := by
        rw [he]
        exact add_le_add_right (mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hpow hK) hb) _
      _ = _ := by ring
  calc
    w/d^2 ≤ ((a*(2*K)^α+b*K)*d^α)/d^2 := div_le_div_of_nonneg_right h hd2.le
    _ = _ := by rw [Real.rpow_sub hdp,Real.rpow_two]; ring

variable {W : Type} [Fintype W] [DecidableEq W]
variable {V : Type} [Fintype V]

lemma normalized_square (G : SimpleGraph W) [DecidableRel G.Adj]
    (d : ℝ) (u v : W) :
    (SubdivisionNormalizedKernel.kernel G d * SubdivisionNormalizedKernel.kernel G d) u v =
      ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u v/d^2 := by
  simp only [SubdivisionNormalizedKernel.kernel,Matrix.mul_apply,Matrix.smul_apply,smul_eq_mul,
    Finset.sum_div]
  apply sum_congr rfl
  intro x _
  ring

/-- Local decay in normalized units, with the original freeness and
all graph-wide assumptions stated explicitly. -/
theorem normalized_off_diagonal_bound (H : SimpleGraph V)
    (hH : ∀ x, ∃ y, H.Adj x y) {α C : ℝ}
    (hα : 1 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G) (hb : G.IsBipartite)
    (L : ℕ) (hcodeg : ∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (d K : ℝ) (hd : 1 ≤ d) (hK : 0 ≤ K)
    (hdeg : ∀ x, (G.degree x:ℝ) ≤ K*d) (u v : W) (huv : u≠v) :
    (SubdivisionNormalizedKernel.kernel G d * SubdivisionNormalizedKernel.kernel G d) u v ≤
      (2*(L+(2*L)^2:ℕ)*C*(2*K)^α+3*(L:ℝ)*K)*d^(α-2) := by
  have hD : (G.maxDegree:ℝ) ≤ K*d := by
    letI : Nonempty W := ⟨u⟩
    obtain ⟨x,hx⟩ := G.exists_maximal_degree_vertex
    rw [hx]
    exact hdeg x
  rw [normalized_square]
  exact normalize_power_bound (by positivity) (by positivity) hα hd hK
    (Nat.cast_nonneg _) hD
    (off_diagonal_bound G H hH (by linarith) hC hbound hf
      (triangle_free_of_bipartite G hb) L G.maxDegree hcodeg G.degree_le_maxDegree u v huv)
end Erdos571.LocalFourthWalk

namespace Erdos571.ThreeHub
open SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def localTraceCoefficient (s M L : ℕ) (K : ℝ) : ℝ :=
  2*(L+(2*L)^2:ℕ)*(baseUpperCoefficient s M)*(2*K)^(baseUpperExponent s M)+3*(L:ℝ)*K

lemma localTraceCoefficient_nonneg (s M L : ℕ) (K : ℝ) (hK : 0 ≤ K) :
    0 ≤ localTraceCoefficient s M L K := by
  dsimp [localTraceCoefficient,baseUpperCoefficient]
  positivity

/-- The normalized off-diagonal fourth-walk entry tends to zero as d grows
when s, M, L and K are fixed. This theorem still assumes bounded codegrees. -/
theorem normalized_off_diagonal_bound (s M : ℕ) (G : SimpleGraph W)
    [DecidableRel G.Adj] (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (L : ℕ) (hcodeg : ∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L)
    (d K : ℝ) (hd : 1 ≤ d) (hK : 0 ≤ K)
    (hdeg : ∀ x, (G.degree x:ℝ) ≤ K*d) (u v : W) (huv : u≠v) :
    (SubdivisionNormalizedKernel.kernel G d * SubdivisionNormalizedKernel.kernel G d) u v ≤
      localTraceCoefficient s M L K * d^(-(1/(Fintype.card (Branch s M):ℝ))) := by
  have h := LocalFourthWalk.normalized_off_diagonal_bound _ (base_power_no_isolated s M)
    (baseUpperExponent_bounds s M).1 (by dsimp [baseUpperCoefficient]; positivity)
    (base_edge_bound s M) G (subdivision_free s M G hf) hb L hcodeg d K hd hK hdeg u v huv
  have he : baseUpperExponent s M-2= -(1/(Fintype.card (Branch s M):ℝ)) := by
    dsimp [baseUpperExponent]; ring
  simpa only [he,localTraceCoefficient] using h
end Erdos571.ThreeHub

/- A quantitative substitute for positive semidefiniteness after arm trimming.
The masked matrix is not asserted to be positive semidefinite. -/
set_option maxHeartbeats 2500000
namespace Erdos571.LightArmKernel
open Finset Matrix SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

lemma trim_remainder_row_bound (P : Matrix W W ℝ)
    (hP : ∀ u v, 0 ≤ P u v) (L D T : ℝ) (hL : 0 < L)
    (hdiag : ∀ u, P u u ≤ D)
    (hrow : ∀ u, ∑ v, (P u v)^2 ≤ T) (u : W) :
    (∑ v, (P u v-trim P L u v)) ≤ D+T/L := by
  classical
  have h := sum_le_sum (fun v (_ : v∈univ) => trim_loss P hP L D hL.le hdiag u v)
  simp only [sum_add_distrib, ←mul_sum, sum_ite_eq, mem_univ, if_true] at h
  rw [sum_sub_distrib]
  have hm := hrow u
  have he : L*(T/L)=T := mul_div_cancel₀ T hL.ne'
  nlinarith

/-- The elementary symmetric row-sum bound works for signed weights too. -/
lemma quadratic_le_of_row_bound (E : Matrix W W ℝ) (hs : E.IsSymm)
    (hn : ∀ u v, 0 ≤ E u v) (R : ℝ)
    (hr : ∀ u, ∑ v, E u v ≤ R) (f : W → ℝ) :
    (∑ u, ∑ v, E u v*f u*f v) ≤ R*∑ u, (f u)^2 := by
  have hterm (u v : W) : 2*(E u v*f u*f v) ≤ E u v*(f u)^2+E u v*(f v)^2 := by
    nlinarith [mul_nonneg (hn u v) (sq_nonneg (f u-f v))]
  have hsum := sum_le_sum (fun u (_ : u∈univ) =>
    sum_le_sum (fun v (_ : v∈univ) => hterm u v))
  have hx : (∑ u, ∑ v, E u v*(f u)^2) ≤ R*∑ u, (f u)^2 := by
    simp only [←sum_mul]
    calc
      _ ≤ ∑ u, R*(f u)^2 := sum_le_sum (fun u _ =>
        mul_le_mul_of_nonneg_right (hr u) (sq_nonneg _))
      _ = _ := by rw [mul_sum]
  have he : (∑ u, ∑ v, E u v*(f v)^2) = ∑ u, ∑ v, E u v*(f u)^2 := by
    rw [sum_comm]
    exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by rw [hs.apply v u]))
  simp only [sum_add_distrib, ←mul_sum] at hsum
  rw [he] at hsum
  linarith

/-- Removing a nonnegative symmetric matrix of bounded row mass from a
nonnegative quadratic form introduces at most this explicit negative error. -/
theorem trim_quadratic_lower (P : Matrix W W ℝ) (hs : P.IsSymm)
    (hn : ∀ u v, 0 ≤ P u v)
    (hq : ∀ f : W → ℝ, 0 ≤ ∑ u, ∑ v, P u v*f u*f v)
    (L D T : ℝ) (hL : 0 < L) (hdiag : ∀ u, P u u ≤ D)
    (hrow : ∀ u, ∑ v, (P u v)^2 ≤ T) (f : W → ℝ) :
    -(D+T/L)*(∑ u, (f u)^2) ≤ ∑ u, ∑ v, trim P L u v*f u*f v := by
  let E := P-trim P L
  have hsE : E.IsSymm := hs.sub (trim_symm P hs L)
  have hnE (u v : W) : 0 ≤ E u v := sub_nonneg.mpr (trim_le P hn L u v)
  have hrE (u : W) : ∑ v, E u v ≤ D+T/L :=
    trim_remainder_row_bound P hn L D T hL hdiag hrow u
  have h := quadratic_le_of_row_bound E hsE hnE (D+T/L) hrE f
  have he : (∑ u, ∑ v, E u v*f u*f v) =
      (∑ u, ∑ v, P u v*f u*f v)-(∑ u, ∑ v, trim P L u v*f u*f v) := by
    simp only [E,Matrix.sub_apply,sub_mul,sum_sub_distrib]
  rw [he] at h
  have hp := hq f
  linarith

variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma square_quadratic_nonneg (f : W → ℝ) :
    0 ≤ ∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*f u*f v := by
  have h := SubdivisionNormalizedKernel.gram_quadratic_identity (G.adjMatrix ℝ) f
  rw [G.isSymm_adjMatrix.eq] at h
  rw [h]
  exact sum_nonneg (fun _ _ => sq_nonneg _)

/-- The fourth-row bound controls the signed quadratic error of the actual
arm mask, without any global codegree assumption. -/
theorem matrix_quadratic_lower (L D T : ℝ) (hL : 0 < L)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ D)
    (hrow : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T)
    (f : W → ℝ) :
    -(D+T/L)*(∑ u, (f u)^2) ≤ ∑ u, ∑ v, matrix G L u v*f u*f v := by
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    change (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose = _
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  exact trim_quadratic_lower _ hs (square_nonneg G) (square_quadratic_nonneg G)
    L D T hL (fun u => (G.adjMatrix_mul_self_apply_self u).le.trans (hdeg u)) hrow f

/-- Dividing by the two-walk degree scale makes the error small when L and
d are large. This is a lower bound for all signed weights, not exact PSD. -/
theorem normalized_matrix_quadratic_lower (L K C d : ℝ)
    (hL : 0 < L) (hd : 0 < d)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hrow : ∀ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ C*(K*d)^2)
    (f : W → ℝ) :
    -(K/d+C*K^2/L)*(∑ u, (f u)^2) ≤
      ∑ u, ∑ v, (matrix G L u v/d^2)*f u*f v := by
  have h := matrix_quadratic_lower G L (K*d) (C*(K*d)^2) hL hdeg hrow f
  have he : (∑ u, ∑ v, (matrix G L u v/d^2)*f u*f v) =
      (∑ u, ∑ v, matrix G L u v*f u*f v)/d^2 := by
    simp only [div_mul_eq_mul_div,←sum_div]
  rw [he]
  apply (le_div_iff₀ (sq_pos_of_pos hd)).mpr
  convert h using 1 <;> field_simp <;> ring
end Erdos571.LightArmKernel

namespace Erdos571.ThreeHub
open Finset Matrix SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
/-- Actual three-hub freeness supplies the moment input. No codegree cap is
assumed; the conclusion is approximate positive semidefiniteness only. -/
theorem lightArm_quadratic_lower (s M : ℕ) (G : SimpleGraph W)
    [DecidableRel G.Adj] (hf : (graph s M).Free G)
    (L K d : ℝ) (hL : 0 < L) (hK : 0 ≤ K) (hd : 0 < d)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ K*d) (f : W → ℝ) :
    -(K/d+momentCoefficient s M*K^2/L)*(∑ u, (f u)^2) ≤
      ∑ u, ∑ v, (LightArmKernel.matrix G L u v/d^2)*f u*f v :=
  LightArmKernel.normalized_matrix_quadratic_lower G L K (momentCoefficient s M) d
    hL hd hdeg (free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK hd.le) hdeg) f
end Erdos571.ThreeHub

/- A degree-sensitive central-pin estimate. Its threshold is still above
that needed for the three-hub sharp exponent. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U]

lemma total_sq_le_squareMass (B : Matrix U U ℝ) :
    (∑ u, ∑ v, B u v)^2 ≤ (Fintype.card U:ℝ)^2*squareMass B := by
  have h := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (U×U))) (f := fun p => B p.1 p.2)
  simpa only [Fintype.sum_prod_type,card_univ,Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,squareMass] using h

lemma conjugation_total_lower (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (d : ℝ) (hd : 0 ≤ d) (hrow : ∀ u, d ≤ ∑ v, A u v) :
    d^2*(∑ u, ∑ v, K u v) ≤ ∑ u, ∑ v, (A*K*A) u v := by
  have hc (v : U) : d ≤ ∑ u, A u v := by
    simpa only [hs.apply v] using hrow v
  have he : (∑ u, ∑ v, (A*K*A) u v) =
      ∑ x, ∑ y, (∑ u, A u x)*K x y*(∑ v, A y v) := by
    simp only [Matrix.mul_apply,mul_sum,sum_mul]
    conv_rhs => rw [sum_comm]
    conv_lhs => arg 2; ext u; rw [sum_comm]
    conv_lhs => arg 2; ext u; arg 2; ext y; rw [sum_comm]
    rw [sum_comm]
    apply sum_congr rfl
    intro y _
    rw [sum_comm]
    apply sum_congr rfl
    intro x _
    rw [sum_comm]
  rw [he,mul_sum]
  apply sum_le_sum
  intro x _
  rw [mul_sum]
  apply sum_le_sum
  intro y _
  calc
    d^2*K x y = (d*K x y)*d := by ring
    _ ≤ ((∑ u, A u x)*K x y)*(∑ v, A y v) :=
      mul_le_mul (mul_le_mul_of_nonneg_right (hc x) (hK x y)) (hrow y) hd
        (mul_nonneg (sum_nonneg (fun _ _ => hA _ _)) (hK x y))

/-- Keeping the kernel mass in the lower estimate removes the worst
upper-mass loss from the earlier pin comparison. -/
theorem centerPin_mul_mass_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (d T B : ℝ) (hd : 0 ≤ d) (hT : 0 ≤ T) (hB : 0 ≤ B)
    (hrow : ∀ u, d ≤ ∑ v, A u v)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T) (hdiag : ∀ u, K u u ≤ B) :
    centerPin A K*d^4*(∑ u, ∑ v, K u v) ≤
      B*T*(Fintype.card U:ℝ)^2*energy A K := by
  let m := ∑ u, ∑ v, K u v
  let z := twoEnergy A K
  let p := centerPin A K
  let e := energy A K
  have hm : 0 ≤ m := sum_nonneg (fun u _ => sum_nonneg (fun v _ => hK u v))
  have hz : 0 ≤ z := twoEnergy_nonneg A K
  have hp : 0 ≤ p := centerPin_nonneg A K hK
  have he : 0 ≤ e := energy_nonneg A K hK
  have h₁ : p ≤ B*T*z := centerPin_le A K hs T B hT hB hr hdiag
  have h₂ : z^2 ≤ m*e := twoEnergy_sq_le A K hs hK
  have h₃ : d^4*m^2 ≤ (Fintype.card U:ℝ)^2*z := by
    have hl := conjugation_total_lower A K hs hA hK d hd hrow
    have hh := total_sq_le_squareMass (A*K*A)
    have hl' := pow_le_pow_left₀ (by positivity : 0 ≤ d^2*m) hl 2
    exact (by convert hl'.trans hh using 1 <;> dsimp [m,z,twoEnergy] <;> ring)
  by_cases hm0 : m=0
  · change p*d^4*m ≤ B*T*(Fintype.card U:ℝ)^2*e
    rw [hm0,mul_zero]
    positivity
  · have hmp : 0 < m := lt_of_le_of_ne hm (Ne.symm hm0)
    have h : (p*d^4*m)*m ≤ (B*T*(Fintype.card U:ℝ)^2*e)*m := by
      calc
        _ = p*(d^4*m^2) := by ring
        _ ≤ p*((Fintype.card U:ℝ)^2*z) := mul_le_mul_of_nonneg_left h₃ hp
        _ = (p*z)*(Fintype.card U:ℝ)^2 := by ring
        _ ≤ (B*T*z^2)*(Fintype.card U:ℝ)^2 := mul_le_mul_of_nonneg_right
          (by nlinarith [mul_le_mul_of_nonneg_right h₁ hz]) (sq_nonneg _)
        _ ≤ (B*T*(m*e))*(Fintype.card U:ℝ)^2 := mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left h₂ (mul_nonneg hB hT)) (sq_nonneg _)
        _ = _ := by ring
    exact (mul_le_mul_iff_left₀ hmp).mp (by simpa only [mul_comm m] using h)

lemma entryPower_mass_lower (Q : Matrix U U ℝ) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (b : ℝ) (hb : 0 ≤ b)
    (hrow : ∀ u, b ≤ ∑ v, Q u v) :
    (Fintype.card U:ℝ)*b^s ≤
      (Fintype.card U:ℝ)^(s-1)*(∑ u, ∑ v, entryPower Q s u v) := by
  have hh (u : U) : b^s ≤ (Fintype.card U:ℝ)^(s-1)*∑ v, (Q u v)^s := by
    have h := CoordinateCoverMoments.sum_power_bound univ (Q u) (fun v _ => hQ u v) s hs
    simpa only [card_univ] using (pow_le_pow_left₀ hb (hrow u) s).trans h
  simpa only [sum_const,card_univ,nsmul_eq_mul,←mul_sum,entryPower] using
    sum_le_sum (fun u (_ : u∈univ) => hh u)

/-- A separate arm Gram kernel may be used: only its diagonal cap and
row-mass lower bound enter this estimate. -/
theorem centerPin_power_mul_row_le [Nonempty U]
    (A Q : Matrix U U ℝ) (hsym : A.IsSymm) (hA : ∀ u v, 0 ≤ A u v)
    (hQ : ∀ u v, 0 ≤ Q u v) (s : ℕ) (hs : 1 ≤ s)
    (d T b : ℝ) (hd : 0 ≤ d) (hT : 0 ≤ T) (hb : 0 ≤ b)
    (hrow : ∀ u, d ≤ ∑ v, A u v)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hQT : ∀ u, Q u u ≤ T) (hQr : ∀ u, b ≤ ∑ v, Q u v) :
    centerPin A (entryPower Q s)*d^4*b^s ≤
      T^(s+1)*(Fintype.card U:ℝ)^s*energy A (entryPower Q s) := by
  let K := entryPower Q s
  have hk : ∀ u v, 0 ≤ K u v := fun u v => pow_nonneg (hQ u v) s
  have hp := centerPin_mul_mass_le A K hsym hA hk d T (T^s) hd hT (pow_nonneg hT s)
    hrow hr (fun u => pow_le_pow_left₀ (hQ u u) (hQT u) s)
  have hm := entryPower_mass_lower Q hQ s hs b hb hQr
  have hn : (0:ℝ) < Fintype.card U := by exact_mod_cast Fintype.card_pos (α := U)
  have hpin : 0 ≤ centerPin A K := centerPin_nonneg A K hk
  have he : 0 ≤ energy A K := energy_nonneg A K hk
  have h := (mul_le_mul_of_nonneg_left hm (mul_nonneg hpin (pow_nonneg hd 4))).trans
    (by
      have hh := mul_le_mul_of_nonneg_left hp (pow_nonneg hn.le (s-1))
      convert hh using 1 <;> ring)
  have he₂ : (Fintype.card U:ℝ)^(s-1)*(Fintype.card U:ℝ)^2=
      (Fintype.card U:ℝ)^s*Fintype.card U := by
    rw [←pow_add,←pow_succ]
    congr 1
    omega
  have hh : (centerPin A K*d^4*b^s)*(Fintype.card U:ℝ) ≤
      (T^(s+1)*(Fintype.card U:ℝ)^s*energy A K)*(Fintype.card U:ℝ) := by
    convert h using 1
    · ring
    · rw [pow_succ]
      calc
        _ = T^s*T*energy A K*((Fintype.card U:ℝ)^s*Fintype.card U) := by ring
        _ = _ := by rw [←he₂]; ring
  exact (mul_le_mul_iff_left₀ hn).mp (by simpa only [mul_comm (Fintype.card U:ℝ)] using hh)

/-- Applying the lower bound to the fourth-walk kernel yields the
threshold d^(2s+2) compared with n^s after fourth-moment normalization. -/
theorem centerPin_power_mul_degree_le [Nonempty U]
    (A : Matrix U U ℝ) (hsym : A.IsSymm) (hA : ∀ u v, 0 ≤ A u v)
    (s : ℕ) (hs : 1 ≤ s) (d T : ℝ) (hd : 0 ≤ d) (hT : 0 ≤ T)
    (hrow : ∀ u, d ≤ ∑ v, A u v)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T) :
    centerPin A (entryPower ((A*A)*(A*A)) s)*d^(4*s+4) ≤
      T^(s+1)*(Fintype.card U:ℝ)^s*energy A (entryPower ((A*A)*(A*A)) s) := by
  let Q := (A*A)*(A*A)
  have hQ : ∀ u v, 0 ≤ Q u v := chain_nonneg (chain_nonneg hA hA) (chain_nonneg hA hA)
  have hAA (u : U) : d^2 ≤ ∑ v, (A*A) u v := by
    simpa only [pow_two] using chain_row_lower hA hd hrow hrow u
  have hQr (u : U) : d^4 ≤ ∑ v, Q u v := by
    have h := chain_row_lower (chain_nonneg hA hA) (sq_nonneg d) hAA hAA u
    convert h using 1 <;> dsimp [Q] <;> ring
  have hQT (u : U) : Q u u ≤ T := by
    have he : Q u u=∑ v, ((A*A) u v)^2 := by
      have ht : (A*A).IsSymm := by
        show (A*A).transpose=A*A
        rw [Matrix.transpose_mul,hsym.eq]
      simp only [Q,Matrix.mul_apply]
      apply sum_congr rfl
      intro v _
      change (A*A) u v*(A*A) v u=((A*A) u v)^2
      rw [ht.apply v u,pow_two]
    rw [he]
    exact hr u
  have h := centerPin_power_mul_row_le A Q hsym hA hQ s hs d T (d^4) hd hT
    (pow_nonneg hd _) hrow hr hQT hQr
  have he : d^4*(d^4)^s=d^(4*s+4) := by
    rw [←pow_mul,←pow_add]
    congr 1
    omega
  change centerPin A (entryPower Q s)*d^(4*s+4) ≤ _
  calc
    _ = centerPin A (entryPower Q s)*d^4*(d^4)^s := by rw [←he]; ring
    _ ≤ _ := h

end Erdos571.ThreeHubKernel

/- Actual-freeness instances of the degree-sensitive central-pin estimate.
These estimates concern kernel energies, not yet all assignment collisions. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix SimpleGraph GramFeatures GramPin

lemma cancel_pin_scale (s : ℕ) (p e n C K d r : ℝ) (hd : 0 < d) (hr : 0 < r)
    (h : p*d^4*(d^4/r)^s ≤ (C*(K*d)^2)^(s+1)*n^s*e) :
    p*d^(2*s+2) ≤ r^s*C^(s+1)*K^(2*s+2)*n^s*e := by
  have he₁ : d^4*(d^4/r)^s*r^s=d^(4*s+4) := by
    rw [div_pow]
    have he : r^s≠0 := pow_ne_zero _ hr.ne'
    field_simp
    rw [←pow_mul,←pow_add]
    congr 1
    omega
  have he₂ : (C*(K*d)^2)^(s+1)=C^(s+1)*K^(2*s+2)*d^(2*s+2) := by
    simp only [mul_pow,←pow_mul]
    rw [show 2*(s+1)=2*s+2 by omega]
    ring
  have he₃ : d^(4*s+4)=(d^(2*s+2))^2 := by
    rw [←pow_mul]
    congr 1
    omega
  have hh := mul_le_mul_of_nonneg_right h (pow_nonneg hr.le s)
  have h' : (p*d^(2*s+2))*d^(2*s+2) ≤
      (r^s*C^(s+1)*K^(2*s+2)*n^s*e)*d^(2*s+2) := by
    convert hh using 1
    · calc
        _ = p*d^(4*s+4) := by rw [he₃]; ring
        _ = _ := by rw [←he₁]; ring
    · rw [he₂]; ring
  exact (mul_le_mul_iff_left₀ (pow_pos hd (2*s+2))).mp
    (by simpa only [mul_comm (d^(2*s+2))] using h')

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- No global codegree assumption is needed for this central-pin estimate. -/
theorem free_centerPin_mul_degree_le (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (d K : ℝ) (hd : 0 < d) (hK : 0 ≤ K)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d) :
    let A := G.adjMatrix ℝ
    let F := entryPower ((A*A)*(A*A)) s
    centerPin A F*d^(2*s+2) ≤
      (ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2)*(Fintype.card W:ℝ)^s*energy A F := by
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let C := ThreeHub.momentCoefficient s M
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : d ≤ ∑ v, A u v := by
    have he : (∑ v, A u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hmin u
  have h := centerPin_power_mul_degree_le A G.isSymm_adjMatrix hA s hs d (C*(K*d)^2)
    hd.le (by dsimp [C]; positivity [ThreeHub.momentCoefficient_nonneg s M]) hrow
    (ThreeHub.free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK hd.le) hmax)
  have h' : centerPin A (entryPower Q s)*d^4*(d^4/(1:ℝ))^s ≤
      (C*(K*d)^2)^(s+1)*(Fintype.card W:ℝ)^s*energy A (entryPower Q s) := by
    have he : d^4*(d^4)^s=d^(4*s+4) := by
      rw [←pow_mul,←pow_add]
      congr 1
      omega
    calc
      _ = centerPin A (entryPower Q s)*d^(4*s+4) := by rw [div_one,←he]; ring
      _ ≤ _ := h
  simpa only [one_pow,one_mul] using cancel_pin_scale s _ _ _ C K d 1 hd (by norm_num) h'

/-- The same estimate permits light arm masks. The only loss is a fixed
factor 4^s from retaining at least half of every two-walk row. -/
theorem free_masked_centerPin_mul_degree_le (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    let A := G.adjMatrix ℝ
    let N := LightArmKernel.matrix G L
    let F := entryPower (N*N.transpose) s
    centerPin A F*d^(2*s+2) ≤
      (4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2)*
        (Fintype.card W:ℝ)^s*energy A F := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let Q := N*N.transpose
  let C := ThreeHub.momentCoefficient s M
  let T := C*(K*d)^2
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hK0 : 0 ≤ K := by linarith
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : d ≤ ∑ v, A u v := by
    have he : (∑ v, A u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hmin u
  have hmoment (u : W) : ∑ v, ((A*A) u v)^2 ≤ T :=
    ThreeHub.free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK0 hd.le) hmax u
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hmoment
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hQr (u : W) : d^4/4 ≤ ∑ v, Q u v := by
    have hNs : N.transpose=N := (LightArmKernel.isSymm G L).eq
    have h := chain_row_lower (LightArmKernel.nonneg G L) (by positivity : 0 ≤ d^2/2)
      hNrow hNrow u
    change d^4/4 ≤ ∑ v, (N*N.transpose) u v
    rw [hNs]
    convert h using 1 <;> ring
  have hQT (u : W) : Q u u ≤ T := LightArmKernel.gram_upper G L T hT hmoment u u
  have h := centerPin_power_mul_row_le A Q G.isSymm_adjMatrix hA
    (LightArmKernel.gram_nonneg G L) s hs d T (d^4/4) hd.le hT (by positivity)
    hrow hmoment hQT hQr
  exact cancel_pin_scale s _ _ _ C K d 4 hd (by norm_num) h

end Erdos571.ThreeHubKernel

/- Finite three-hub walk assignments with light arms. Their agreement and
center-pin cardinalities are exactly the algebraic kernel quantities. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmTensor
open Finset Matrix
variable {W I J K : Type*} [Fintype W] [Fintype I] [Fintype J] [Fintype K]

lemma product_gram (B : Matrix W I ℝ) (C : Matrix W J ℝ) (u v : W) :
    (∑ p : I×J, (B u p.1*C u p.2)*(B v p.1*C v p.2)) =
      (B*B.transpose) u v*(C*C.transpose) u v := by
  simp only [Fintype.sum_prod_type,Matrix.mul_apply,Matrix.transpose_apply,sum_mul_sum]
  exact sum_congr rfl (fun r _ => sum_congr rfl (fun t _ => by ring))

lemma triple_mixed_total (B : Matrix W I ℝ) (C : Matrix W J ℝ) (D : Matrix W K ℝ) :
    (∑ r, ∑ t, ∑ a, (∑ u, B u r*C u t*D u a)^2) =
      ∑ u, ∑ v, (B*B.transpose) u v*(C*C.transpose) u v*(D*D.transpose) u v := by
  let F : Matrix W (I×J) ℝ := fun u p => B u p.1*C u p.2
  have h := mixed_total F D
  have he (u v : W) : (F*F.transpose) u v=(B*B.transpose) u v*(C*C.transpose) u v :=
    product_gram B C u v
  simp only [Fintype.sum_prod_type,F] at h
  rw [h]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by rw [←he]))

lemma triple_row_squares (B : Matrix W I ℝ) (C : Matrix W J ℝ) (D : Matrix W K ℝ) :
    (∑ r, ∑ t, ∑ a, ∑ u, (B u r*C u t*D u a)^2) =
      ∑ u, (B*B.transpose) u u*(C*C.transpose) u u*(D*D.transpose) u u := by
  let F : Matrix W (I×J) ℝ := fun u p => B u p.1*C u p.2
  have h := pair_row_squares F D
  have he (u : W) : (∑ p, (F u p)^2)=(B*B.transpose) u u*(C*C.transpose) u u := by
    simpa only [F,←pow_two] using product_gram B C u u
  simp only [Fintype.sum_prod_type,F] at h
  rw [h]
  exact sum_congr rfl (fun u _ => by
    rw [←he]
    simp only [F,Fintype.sum_prod_type,Matrix.mul_apply,Matrix.transpose_apply,pow_two])
end Erdos571.ArmTensor

namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ)

abbrev Labels := Fin s → W
abbrev Roots := Labels (W := W) s × (Labels (W := W) s × Labels (W := W) s)
abbrev Bundle (x : W) (r : Labels (W := W) s) := MaskedBush.Bundle G L (Fin s) x r
/-- The core arm is an unmasked two-walk; only the terminal root arms are light. -/
abbrev Side (x : W) (r : Labels (W := W) s) :=
  (u : W) × (G.commonNeighbors x u × Bundle G L s u r)
abbrev At (r : Roots (W := W) s) (x : W) :=
  Bundle G L s x r.1 × (Side G L s x r.2.1 × Side G L s x r.2.2)
abbrev Fiber (r : Roots (W := W) s) := (x : W) × At G L s r x
abbrev Full := (r : Roots (W := W) s) × Fiber G L s r
abbrev Agreement := FiberRestrictionEnergy.Agreement (Fiber G L s)
def center (p : Full G L s) : W := p.2.1
abbrev Pin (role : Full G L s → W) :=
  {p : Full G L s × Full G L s // p.1.1=p.2.1 ∧ role p.1=role p.2}
abbrev MarkFiber (role : Full G L s → W) (r : Roots (W := W) s) (x : W) :=
  {p : Fiber G L s r // role ⟨r,p⟩=x}

noncomputable instance sideFintype (x : W) (r : Labels (W := W) s) : Fintype (Side G L s x r) := by
  classical
  infer_instance
noncomputable instance fiberFintype (r : Roots (W := W) s) : Fintype (Fiber G L s r) := by
  classical
  infer_instance

noncomputable def armFeature : Matrix W (Labels (W := W) s) ℝ :=
  ArmTensor.tensor (LightArmKernel.matrix G L) (Fin s)
noncomputable def sideFeature : Matrix W (Labels (W := W) s) ℝ :=
  (G.adjMatrix ℝ * G.adjMatrix ℝ)*armFeature G L s

lemma card_side (x : W) (r : Labels (W := W) s) :
    (Fintype.card (Side G L s x r):ℝ)=sideFeature G L s x r := by
  classical
  simp only [Side,Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,
    MaskedBush.card_bundle,sideFeature,Matrix.mul_apply,armFeature]
  apply sum_congr rfl
  intro u _
  rw [←LayeredBush.adjacency_square_common_card]
  rfl

lemma card_at (r : Roots (W := W) s) (x : W) :
    (Fintype.card (At G L s r x):ℝ)=
      armFeature G L s x r.1*sideFeature G L s x r.2.1*sideFeature G L s x r.2.2 := by
  classical
  simp only [At,Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_side,armFeature]
  ring

lemma card_fiber (r : Roots (W := W) s) :
    (Fintype.card (Fiber G L s r):ℝ)=
      ∑ x, armFeature G L s x r.1*sideFeature G L s x r.2.1*sideFeature G L s x r.2.2 := by
  classical
  simp only [Fiber,Fintype.card_sigma,Nat.cast_sum,card_at]

lemma arm_gram : armFeature G L s*(armFeature G L s).transpose =
    entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s := by
  ext u v
  simpa only [Fintype.card_fin,armFeature] using ArmTensor.gram (LightArmKernel.matrix G L) (Fin s) u v

lemma side_gram : sideFeature G L s*(sideFeature G L s).transpose =
    ThreeHubKernel.chain (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    change (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose = _
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  simp only [sideFeature,Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix,Matrix.mul_assoc]
  rw [←Matrix.mul_assoc (armFeature G L s),arm_gram]
  simp only [ThreeHubKernel.chain,Matrix.mul_assoc]

open Classical in
lemma agreement_card : (Nat.card (Agreement G L s):ℝ)=
    ThreeHubKernel.energy (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G L s)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,
    card_fiber,Fintype.sum_prod_type]
  rw [ArmTensor.triple_mixed_total,arm_gram,side_gram]
  simp only [ThreeHubKernel.energy,pow_two,mul_assoc]

open Classical in
lemma pin_card (role : Full G L s → W) : (Nat.card (Pin G L s role):ℝ)=
    ∑ r, ∑ x, (Fintype.card (MarkFiber G L s role r x):ℝ)^2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (markedPairEquiv (Fiber G L s) role)]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,←pow_two,Nat.cast_pow]

def centerMarkEquiv (r : Roots (W := W) s) (x : W) :
    MarkFiber G L s (center G L s) r x ≃ At G L s r x where
  toFun p := by
    rcases p with ⟨⟨y,a⟩,he⟩
    change y=x at he
    subst y
    exact a
  invFun a := ⟨⟨x,a⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨y,a⟩,he⟩
    change y=x at he
    subst y
    rfl
  right_inv _ := rfl

open Classical in
lemma center_pin_card : (Nat.card (Pin G L s (center G L s)):ℝ)=
    ThreeHubKernel.centerPin (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [pin_card]
  simp_rw [Fintype.card_congr (centerMarkEquiv G L s _ _),card_at]
  simp only [Fintype.sum_prod_type]
  rw [ArmTensor.triple_row_squares,arm_gram,side_gram]
  simp only [ThreeHubKernel.centerPin,pow_two,mul_assoc]

end Erdos571.ThreeHubAssignments

/- The degree-sensitive estimate for finite center-pin cardinalities. This
is not yet a bound for all conflicts in the forbidden-power packing argument. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHubAssignments
open Finset Matrix SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem center_pin_mul_degree_le (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Pin G L s (center G L s)):ℝ)*d^(2*s+2) ≤
      (4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2)*
        (Fintype.card W:ℝ)^s*(Nat.card (Agreement G L s):ℝ) := by
  rw [center_pin_card,agreement_card]
  exact ThreeHubKernel.free_masked_centerPin_mul_degree_le G s M hs hf L d K
    hL hd hK hdK hmin hmax hcut

theorem center_pin_small (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K τ : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L)
    (hscale : (4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2)*
      (Fintype.card W:ℝ)^s ≤ τ*d^(2*s+2)) :
    (Nat.card (Pin G L s (center G L s)):ℝ) ≤ τ*(Nat.card (Agreement G L s):ℝ) := by
  have h := center_pin_mul_degree_le G s M hs hf L d K hL hd hK hdK hmin hmax hcut
  have h' := h.trans (mul_le_mul_of_nonneg_right hscale (Nat.cast_nonneg (Nat.card (Agreement G L s))))
  apply (mul_le_mul_iff_left₀ (pow_pos hd (2*s+2))).mp
  convert h' using 1 <;> ring

end Erdos571.ThreeHubAssignments

/- Walk assignments define homomorphisms of the original three-hub template.
The homomorphisms are not asserted to be injective. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ)

def hubValue (p : Full G L s) (i : Fin 3) : W :=
  if i=0 then p.2.2.2.1.1 else if i=1 then p.2.1 else p.2.2.2.2.1

def labelAt (p : Full G L s) (i : Fin 3) : Fin s → W :=
  if i=0 then p.1.2.1 else if i=1 then p.1.1 else p.1.2.2

def bundleAt (p : Full G L s) (i : Fin 3) :
    MaskedBush.Bundle G L (Fin s) (hubValue G L s p i) (labelAt G L s p i) := by
  by_cases h₀ : i=0
  · subst i
    simpa only [hubValue,labelAt,if_pos rfl] using p.2.2.2.1.2.2
  by_cases h₁ : i=1
  · subst i
    simpa [hubValue,labelAt] using p.2.2.1
  have h₂ : i=2 := by omega
  subst i
  simpa [hubValue,labelAt] using p.2.2.2.2.2.2

def coreMiddle (p : Full G L s) (i : Fin 2) : W :=
  if i=0 then p.2.2.2.1.2.1.val else p.2.2.2.2.2.1.val

variable (hs : 1 ≤ s)

def rootValue (p : Full G L s) (r : ThreeHub.BaseRoot s) : W :=
  labelAt G L s p r.1 (finCongr (ThreeHub.counts_eq s hs r.1) r.2)

def oldValue (p : Full G L s) : Fin 3 ⊕ ThreeHub.BaseRoot s → W :=
  Sum.elim (hubValue G L s p) (rootValue G L s hs p)

def edgeIndexValue (p : Full G L s) : BalancedTree.EdgeIndex (ThreeHub.counts s) → W
  | .inl i => coreMiddle G L s p i
  | .inr r => MaskedBush.middle G L
      (bundleAt G L s p r.1 (finCongr (ThreeHub.counts_eq s hs r.1) r.2))

noncomputable def edgeValue (p : Full G L s) (e : (ThreeHub.base s).edgeSet) : W :=
  edgeIndexValue G L s hs p ((BalancedTree.edgeEquiv (ThreeHub.counts s)).symm e)

lemma edgeValue_edge (p : Full G L s) (i : BalancedTree.EdgeIndex (ThreeHub.counts s)) :
    edgeValue G L s hs p (BalancedTree.edge i)=edgeIndexValue G L s hs p i := by
  unfold edgeValue
  have h : (BalancedTree.edgeEquiv (ThreeHub.counts s)).symm (BalancedTree.edge i)=i :=
    (BalancedTree.edgeEquiv (ThreeHub.counts s)).symm_apply_apply i
  rw [h]

lemma edgeIndex_incidence (p : Full G L s) (i : BalancedTree.EdgeIndex (ThreeHub.counts s))
    (v : Fin 3 ⊕ ThreeHub.BaseRoot s) (hv : v∈(BalancedTree.edge i).val) :
    G.Adj (oldValue G L s hs p v) (edgeIndexValue G L s hs p i) := by
  rcases i with i | r
  · simp only [BalancedTree.edge,Sym2.mem_iff] at hv
    rcases hv with rfl | rfl
    · fin_cases i
      · simpa [oldValue,hubValue,edgeIndexValue,coreMiddle] using p.2.2.2.1.2.1.property.2
      · simpa [oldValue,hubValue,edgeIndexValue,coreMiddle] using p.2.2.2.2.2.1.property.1
    · fin_cases i
      · simpa [oldValue,hubValue,edgeIndexValue,coreMiddle] using p.2.2.2.1.2.1.property.1
      · simpa [oldValue,hubValue,edgeIndexValue,coreMiddle] using p.2.2.2.2.2.1.property.2
  · simp only [BalancedTree.edge,Sym2.mem_iff] at hv
    rcases hv with rfl | rfl
    · exact MaskedBush.arm_left G L (bundleAt G L s p r.1
        (finCongr (ThreeHub.counts_eq s hs r.1) r.2))
    · exact (MaskedBush.arm_right G L (bundleAt G L s p r.1
        (finCongr (ThreeHub.counts_eq s hs r.1) r.2))).symm

lemma edge_incidence (p : Full G L s) (e : (ThreeHub.base s).edgeSet)
    (v : Fin 3 ⊕ ThreeHub.BaseRoot s) (hv : v∈e.val) :
    G.Adj (oldValue G L s hs p v) (edgeValue G L s hs p e) := by
  obtain ⟨i,rfl⟩ := BalancedTree.edge_surjective e
  rw [edgeValue_edge]
  exact edgeIndex_incidence G L s hs p i v hv

noncomputable def subdivisionHom (p : Full G L s) :
    ProjectionHeavy.subdivision (ThreeHub.base s) →g G where
  toFun := Sum.elim (oldValue G L s hs p) (edgeValue G L s hs p)
  map_rel' := by
    rintro (v|e) (w|f) h
    · exact h.elim
    · exact edge_incidence G L s hs p f v h
    · exact (edge_incidence G L s hs p e w h).symm
    · exact h.elim

/-- Every finite assignment preserves every edge of the original template.
Repeated vertices are still permitted. -/
noncomputable def hom (p : Full G L s) : ThreeHub.template s →g G :=
  (subdivisionHom G L s hs p).comp (RootedSubdivision.iso (ThreeHub.base s)).toHom

lemma hom_old (p : Full G L s) (v : Fin 3 ⊕ ThreeHub.BaseRoot s) :
    hom G L s hs p (RootedSubdivision.old (ThreeHub.base s) v)=oldValue G L s hs p v := by
  change (subdivisionHom G L s hs p)
    (RootedSubdivision.vertexEquiv (ThreeHub.base s) (RootedSubdivision.old (ThreeHub.base s) v)) = _
  rw [RootedSubdivision.vertexEquiv_apply,RootedSubdivision.toVertex_old]
  rfl

lemma hom_middle (p : Full G L s) (e : (ThreeHub.base s).edgeSet) :
    hom G L s hs p (RootedSubdivision.middle (ThreeHub.base s) e)=edgeValue G L s hs p e := by
  change (subdivisionHom G L s hs p)
    (RootedSubdivision.vertexEquiv (ThreeHub.base s) (RootedSubdivision.middle (ThreeHub.base s) e)) = _
  rw [RootedSubdivision.vertexEquiv_apply,RootedSubdivision.toVertex_middle]
  rfl

lemma rootEdge_false (e : RootedSubdivision.RootEdge (ThreeHub.base s)) : False := by
  apply e.property
  obtain ⟨i,hi⟩ := BalancedTree.edge_surjective e.val
  rcases i with i | r
  · refine ⟨i.castSucc,by simp,?_⟩
    rw [←hi]
    simp [BalancedTree.edge]
  · refine ⟨r.1,by simp,?_⟩
    rw [←hi]
    simp [BalancedTree.edge]

lemma same_roots (p q : Full G L s) (hr : p.1=q.1)
    (r : RootedSubdivision.Root (ThreeHub.base s)) :
    hom G L s hs p (.inr r)=hom G L s hs q (.inr r) := by
  rcases r with r | e
  · change hom G L s hs p (RootedSubdivision.old (ThreeHub.base s) (.inr r)) =
      hom G L s hs q (RootedSubdivision.old (ThreeHub.base s) (.inr r))
    rw [hom_old,hom_old]
    change labelAt G L s p r.1 _ = labelAt G L s q r.1 _
    simp only [labelAt,hr]
  · exact (rootEdge_false s e).elim

open Classical in
/-- Original ThreeHub freeness controls the full agreement count by actual
homomorphism conflicts. Noninjective assignments have not been discarded. -/
theorem freeness_pairs (M : ℕ) (hM : 2 ≤ M) (hf : (ThreeHub.graph s M).Free G) :
    Nat.card (Agreement G L s) ≤ (M-1)*
      Nat.card {p : Full G L s×Full G L s //
        p.1.1=p.2.1 ∧ RootedHomEnergy.Conflict (hom G L s hs p.1) (hom G L s hs p.2)} := by
  classical
  have h := RootedHomEnergy.pair_bound (univ : Finset (Full G L s))
    (hom G L s hs) Sigma.fst (fun p _ q _ hr => same_roots G L s hs p q hr) M hM hf
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
    PackingEnergy.pairs,true_and,and_true,univ_product_univ] using h

end Erdos571.ThreeHubAssignments


/-! Explicit iterated paired cones. This upper transfer does not assert
any sharp subdivision transfer. -/
set_option maxHeartbeats 2000000
namespace Erdos571.IteratedOrdinaryCone
open SimpleGraph Finset ProjectionHeavy
variable {V : Type} (H : SimpleGraph V) (c : V → Bool)

abbrev Vertex (V : Type) (t : ℕ) := V ⊕ (Fin t × Bool)

def graph (t : ℕ) : SimpleGraph (Vertex V t) where
  Adj u v := match u,v with
    | .inl x,.inl y => H.Adj x y
    | .inl x,.inr p => c x ≠ p.2
    | .inr p,.inl y => p.2 ≠ c y
    | .inr p,.inr q => p.2 ≠ q.2
  symm := by intro u v h; cases u <;> cases v <;> exact h.symm
  loopless := by intro u; cases u <;> simp

def color (t : ℕ) : Vertex V t → Bool := Sum.elim c Prod.snd

lemma color_proper (hc : ∀ {u v}, H.Adj u v → c u ≠ c v) (t : ℕ) :
    ∀ {u v}, (graph H c t).Adj u v → color c t u ≠ color c t v := by
  intro u v h
  cases u <;> cases v
  · exact hc h
  all_goals exact h

def oldCopy (t : ℕ) : H.Copy (graph H c t) where
  toHom := ⟨Sum.inl, fun h => h⟩
  injective' := Sum.inl_injective

def zeroCopy : (graph H c 0).Copy H where
  toHom := ⟨Sum.elim id (fun p => Fin.elim0 p.1), by
    intro u v h
    cases u with
    | inl u => cases v with
      | inl v => exact h
      | inr v => exact Fin.elim0 v.1
    | inr u => exact Fin.elim0 u.1⟩
  injective' := by
    intro u v h
    cases u with
    | inl u => cases v with
      | inl v => exact congrArg Sum.inl h
      | inr v => exact Fin.elim0 v.1
    | inr u => exact Fin.elim0 u.1

def step (t : ℕ) : Vertex V (t+1) → Vertex V t ⊕ Bool
  | .inl v => .inl (.inl v)
  | .inr (i,b) => Fin.cases (.inr b) (fun j => .inl (.inr (j,b))) i

lemma step_injective (t : ℕ) : Function.Injective (step (V := V) t) := by
  intro u v h
  cases u with
  | inl u => cases v with
    | inl v => exact congrArg Sum.inl (Sum.inl.inj (Sum.inl.inj h))
    | inr v =>
      obtain ⟨i,b⟩ := v
      cases i using Fin.cases <;> simp [step] at h
  | inr u =>
    obtain ⟨i,b⟩ := u
    cases v with
    | inl v => cases i using Fin.cases <;> simp [step] at h
    | inr v =>
      obtain ⟨j,d⟩ := v
      cases i using Fin.cases <;> cases j using Fin.cases <;> simp [step] at h ⊢
      · exact h
      · exact h

def stepCopy (t : ℕ) : (graph H c (t+1)).Copy
    (OrdinaryCone.graph (graph H c t) (color c t)) where
  toHom := ⟨step t, by
    intro u v h
    cases u with
    | inl u => cases v with
      | inl v => exact h
      | inr v =>
        obtain ⟨i,b⟩ := v
        cases i using Fin.cases <;> exact h
    | inr u =>
      obtain ⟨i,b⟩ := u
      cases v with
      | inl v => cases i using Fin.cases <;> exact h
      | inr v =>
        obtain ⟨j,d⟩ := v
        cases i using Fin.cases <;> cases j using Fin.cases <;> exact h⟩
  injective' := step_injective t

lemma connected (hH : H.Connected) (t : ℕ) : (graph H c t).Connected := by
  cases t with
  | zero =>
    apply hH.map (oldCopy H c 0).toHom
    intro v
    cases v with
    | inl v => exact ⟨v,rfl⟩
    | inr v => exact Fin.elim0 v.1
  | succ t =>
    let r : Bool → Vertex V (t+1) := fun b => .inr (0,b)
    have hroot (v : Vertex V (t+1)) : (graph H c (t+1)).Reachable v (r false) := by
      cases v with
      | inl v =>
        cases hv : c v with
        | false =>
          exact (show (graph H c (t+1)).Adj (.inl v) (r true) by
            change c v ≠ true; simp [hv]).reachable.trans
            (show (graph H c (t+1)).Adj (r true) (r false) by change true ≠ false; decide).reachable
        | true =>
          exact (show (graph H c (t+1)).Adj (.inl v) (r false) by
            change c v ≠ false; simp [hv]).reachable
      | inr p =>
        obtain ⟨i,b⟩ := p
        cases b with
        | false =>
          exact (show (graph H c (t+1)).Adj (.inr (i,false)) (r true) by change false ≠ true; decide).reachable.trans
            (show (graph H c (t+1)).Adj (r true) (r false) by change true ≠ false; decide).reachable
        | true =>
          exact (show (graph H c (t+1)).Adj (.inr (i,true)) (r false) by change true ≠ false; decide).reachable
    exact {preconnected := fun u v => (hroot u).trans (hroot v).symm, nonempty := ⟨r false⟩}

lemma exponent_bounds (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) (t : ℕ) :
    1 ≤ 2-a/(b+t*a) ∧ 2-a/(b+t*a) < 2 := by
  have ht : 0 ≤ (t:ℝ)*a := mul_nonneg (Nat.cast_nonneg _) ha.le
  have hp : 0 < b+t*a := by linarith
  have hu : a/(b+t*a) ≤ 1 := (div_le_one hp).mpr (by linarith)
  have hl : 0 < a/(b+t*a) := div_pos ha hp
  constructor <;> linarith

/-- Iterating paired cones changes a deficit `a/b` to `a/(b+t*a)`. -/
theorem edge_bound [Fintype V] (hH : H.Connected)
    (hc : ∀ {u v}, H.Adj u v → c u ≠ c v)
    (a b C : ℝ) (ha : 0 < a) (hab : a ≤ b) (hC : 0 ≤ C)
    (hb : EdgeBound H (2-a/b) C) (t : ℕ) :
    ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (graph H c t) (2-a/(b+t*a)) D := by
  induction t with
  | zero =>
    refine ⟨C,hC,?_⟩
    simpa only [Nat.cast_zero,zero_mul,add_zero] using hb.mono ⟨zeroCopy H c⟩
  | succ t ih =>
    obtain ⟨D,hD,hd⟩ := ih
    obtain ⟨E,hE,he⟩ := OrdinaryCone.edge_bound (graph H c t) (connected H c hH t)
      (color c t) (color_proper H c hc t) (exponent_bounds a b ha hab t).1
      (exponent_bounds a b ha hab t).2 hD hd
    have hden : b+(t:ℝ)*a ≠ 0 := by
      have : 0 ≤ (t:ℝ)*a := mul_nonneg (Nat.cast_nonneg _) ha.le
      linarith
    have hden' : b+((t:ℝ)+1)*a ≠ 0 := by
      have : 0 ≤ (t:ℝ)*a := mul_nonneg (Nat.cast_nonneg _) ha.le
      nlinarith
    have hex : 1+(3-(2-a/(b+(t:ℝ)*a)))⁻¹=2-a/(b+(t+1:ℕ)*a) := by
      push_cast
      have hh : 3-(2-a/(b+(t:ℝ)*a))=(b+((t:ℝ)+1)*a)/(b+(t:ℝ)*a) := by
        apply (eq_div_iff hden).mpr
        rw [sub_mul,sub_mul,div_mul_cancel₀ _ hden]
        ring
      rw [hh,inv_div]
      apply (mul_left_inj' hden').mp
      rw [add_mul,sub_mul,div_mul_cancel₀ _ hden',div_mul_cancel₀ _ hden']
      ring
    exact ⟨E,hE,hex ▸ he.mono ⟨stepCopy H c t⟩⟩

end Erdos571.IteratedOrdinaryCone


/-! A multiplicity-independent exponent for the unsubdivided three-hub
power, obtained by placing it inside paired cones of a tree. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ProjectionHeavy.EdgeBound
open SimpleGraph
lemma forest {V : Type} [Fintype V] (H : SimpleGraph V) (hH : H.IsAcyclic) :
    EdgeBound H 1 (Fintype.card V) := by
  constructor
  intro W _ G hf
  classical
  have h := (card_edgeFinset_le_extremalNumber hf).trans
    (Erdos571.extremalNumber_forest_le H hH (Fintype.card W))
  rw [Real.rpow_one]
  simpa only [Nat.card_eq_fintype_card,card_edgeSet,Nat.cast_mul] using
    (show (G.edgeFinset.card:ℝ) ≤ (Fintype.card V*Fintype.card W:ℕ) by exact_mod_cast h)
end Erdos571.ProjectionHeavy.EdgeBound

namespace Erdos571.ThreeHub
open SimpleGraph Finset ProjectionHeavy

def hubColor (i : Fin 3) : Bool := decide (i=1)

def coneCore (M : ℕ) := TreeFan.graph (pathGraph 3) 1 M

def coneCoreColor (M : ℕ) : Option (Fin M × Fin 3) → Bool
  | none => false
  | some p => hubColor p.2

lemma path_three_isTree : (pathGraph 3).IsTree := by
  apply isTree_iff_connected_and_card.mpr
  refine ⟨pathGraph_connected 2,?_⟩
  letI : DecidableRel (pathGraph 3).Adj := fun _ _ => decidable_of_iff _ pathGraph_adj.symm
  simp only [Nat.card_eq_fintype_card]
  decide


lemma coneCore_isTree (M : ℕ) : (coneCore M).IsTree :=
  TreeFan.isTree (pathGraph 3) path_three_isTree 1 M

lemma hubColor_proper {i j : Fin 3} (h : (pathGraph 3).Adj i j) :
    hubColor i ≠ hubColor j := by
  fin_cases i <;> fin_cases j <;> simp_all [hubColor,pathGraph_adj]

lemma coneCoreColor_proper (M : ℕ) :
    ∀ {u v}, (coneCore M).Adj u v → coneCoreColor M u ≠ coneCoreColor M v := by
  intro u v h
  cases u with
  | none => cases v with
    | none => exact h.elim
    | some p =>
      change p.2=1 at h
      simp [coneCoreColor,h,hubColor]
  | some p => cases v with
    | none =>
      change p.2=1 at h
      simp [coneCoreColor,h,hubColor]
    | some q => exact hubColor_proper h.2

def rootConeIndex (s : ℕ) (hs : 1 ≤ s) (r : BaseRoot s) : Fin (2*s) × Bool :=
  (⟨if r.1=2 then s+r.2.val else r.2.val, by
    have hr : r.2.val<s := by simpa only [counts_eq s hs r.1] using r.2.isLt
    split_ifs <;> omega⟩, !(hubColor r.1))

lemma rootConeIndex_injective (s : ℕ) (hs : 1 ≤ s) :
    Function.Injective (rootConeIndex s hs) := by
  intro r q h
  have h₁ := congrArg (fun p : Fin (2*s)×Bool => p.1.val) h
  have h₂ := congrArg Prod.snd h
  obtain ⟨i,ri⟩ := r
  obtain ⟨j,qj⟩ := q
  have hr : ri.val<s := by simpa only [counts_eq s hs i] using ri.isLt
  have hq : qj.val<s := by simpa only [counts_eq s hs j] using qj.isLt
  fin_cases i <;> fin_cases j <;>
    norm_num [rootConeIndex,hubColor,Fin.ext_iff] at h₁ h₂
  all_goals first | contradiction | omega | simpa only [Sigma.mk.injEq,heq_eq_eq,Fin.ext_iff,true_and] using h₁

lemma rootConeIndex_color (s : ℕ) (hs : 1 ≤ s) (r : BaseRoot s) :
    hubColor r.1 ≠ (rootConeIndex s hs r).2 := by
  change hubColor r.1 ≠ !(hubColor r.1)
  cases hubColor r.1 <;> decide

def baseConeCopy (s M : ℕ) (hs : 1 ≤ s) :
    (FullRootedPower.graph (base s) M).Copy
      (IteratedOrdinaryCone.graph (coneCore M) (coneCoreColor M) (2*s)) where
  toHom := ⟨Sum.map some (rootConeIndex s hs), by
    intro u v h
    cases u with
    | inl u => cases v with
      | inl v => exact h
      | inr r =>
        change u.2=r.1 at h
        change hubColor u.2 ≠ (rootConeIndex s hs r).2
        rw [h]
        exact rootConeIndex_color s hs r
    | inr r => cases v with
      | inl v =>
        change r.1=v.2 at h
        change (rootConeIndex s hs r).2 ≠ hubColor v.2
        rw [←h]
        exact (rootConeIndex_color s hs r).symm
      | inr q => exact h.elim⟩
  injective' := Sum.map_injective.mpr ⟨Option.some_injective _,rootConeIndex_injective s hs⟩

/-- The power multiplicity affects the constant, but not this exponent. -/
theorem uniform_base_edge_bound (s M : ℕ) (hs : 1 ≤ s) :
    ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (FullRootedPower.graph (base s) M)
      (2-1/(2*(s:ℝ)+1)) C := by
  have hf := EdgeBound.forest (coneCore M) (coneCore_isTree M).2
  obtain ⟨C,hC,h⟩ := IteratedOrdinaryCone.edge_bound (coneCore M) (coneCoreColor M)
    (coneCore_isTree M).isConnected (coneCoreColor_proper M)
    1 1 (Fintype.card (Option (Fin M×Fin 3))) (by norm_num) (by norm_num)
    (by positivity) (by norm_num at hf ⊢; exact hf) (2*s)
  refine ⟨C,hC,?_⟩
  convert h.mono ⟨baseConeCopy s M hs⟩ using 1 <;> push_cast <;> congr 2 <;> ring

end Erdos571.ThreeHub


/-! Consequences of the multiplicity-independent base exponent. Codegree
boundedness remains explicit in the local result; the ordinary subdivision
bound uses only the already-proved weak transfer. -/
set_option maxHeartbeats 2000000
namespace Erdos571.ThreeHub
open SimpleGraph Finset Matrix ProjectionHeavy

lemma uniform_base_exponent_bounds (s : ℕ) :
    1 ≤ (2-1/(2*(s:ℝ)+1)) ∧ (2-1/(2*(s:ℝ)+1)) < 2 := by
  have h := IteratedOrdinaryCone.exponent_bounds 1 1 (by norm_num) (by norm_num) (2*s)
  simpa only [Nat.cast_mul,Nat.cast_ofNat,mul_one,add_comm (1:ℝ)] using h

/-- A fixed constant works for all finite hosts, with off-diagonal decay
`d^(-1/(2*s+1))`. A global bound on codegrees is still required. -/
theorem uniform_normalized_off_diagonal_bound (s M : ℕ) (hs : 1 ≤ s)
    (L : ℕ) (K : ℝ) (hK : 0 ≤ K) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ {W : Type} [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
        (graph s M).Free G → G.IsBipartite →
        (∀ x y, x≠y → Fintype.card (G.commonNeighbors x y) ≤ L) →
        ∀ d : ℝ, 1 ≤ d → (∀ x, (G.degree x:ℝ) ≤ K*d) →
        ∀ u v : W, u≠v →
          (SubdivisionNormalizedKernel.kernel G d * SubdivisionNormalizedKernel.kernel G d) u v ≤
            C*d^(-(1/(2*(s:ℝ)+1))) := by
  obtain ⟨B,hB,hbound⟩ := uniform_base_edge_bound s (M+1) hs
  let C := 2*(L+(2*L)^2:ℕ)*B*(2*K)^(2-1/(2*(s:ℝ)+1))+3*(L:ℝ)*K
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro W _ _ G _ hf hb hcodeg d hd hdeg u v huv
  have h := LocalFourthWalk.normalized_off_diagonal_bound _ (base_power_no_isolated s M)
    (uniform_base_exponent_bounds s).1 hB hbound G (subdivision_free s M G hf) hb
    L hcodeg d K hd hK hdeg u v huv
  have he : (2-1/(2*(s:ℝ)+1))-2= -(1/(2*(s:ℝ)+1)) := by ring
  simpa only [he] using h

/-- An unconditional ordinary bound with an exponent independent of the
power multiplicity. This is weaker than the rooted-density prediction. -/
theorem uniform_nonsharp_edge_bound (s M : ℕ) (hs : 1 ≤ s) :
    ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (graph s M) (2-(2-1/(2*(s:ℝ)+1))⁻¹) C := by
  obtain ⟨B,hB,hbound⟩ := uniform_base_edge_bound s (M+1) hs
  have h := WeakSubdivisionUpper.edge_bound _ (uniform_base_exponent_bounds s).1
    (uniform_base_exponent_bounds s).2.le hB hbound
  refine ⟨_,?_,h.mono ⟨RootedSubdivision.powerCopy (base s) M⟩⟩
  exact mul_nonneg (by norm_num) (WeakSubdivisionUpper.coefficient_nonneg hB)

theorem uniform_nonsharp_upper (s M : ℕ) (hs : 1 ≤ s) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ))
      (fun n : ℕ => (n:ℝ)^(2-(2-1/(2*(s:ℝ)+1))⁻¹)) := by
  obtain ⟨C,hC,h⟩ := uniform_nonsharp_edge_bound s M hs
  exact h.extremal_isBigO _ hC

/-- Both estimates concern one fixed graph. The gap between `24/17` and
`31/21` remains; this is not a new exact exponent. -/
theorem twentyfour_seventeen_uniform_bounds :
    ∃ M : ℕ, 2 ≤ M ∧ (graph 5 M).IsBipartite ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(24/17:ℝ))
        (fun n : ℕ => (extremalNumber n (graph 5 M):ℝ)) ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (extremalNumber n (graph 5 M):ℝ))
        (fun n : ℕ => (n:ℝ)^(31/21:ℝ)) := by
  obtain ⟨M,hM,hb,hl⟩ := twentyfour_seventeen_lower
  refine ⟨M,hM,hb,hl,?_⟩
  have h := uniform_nonsharp_upper 5 M (by omega)
  norm_num at h
  exact h

end Erdos571.ThreeHub

/-! A separate endpoint-hub pin estimate for the three-hub kernel.
These are algebraic quantities; the finite endpoint-pin identity is not
asserted in this module. -/
set_option maxHeartbeats 2500000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def endpointChain (A K : Matrix U U ℝ) : Matrix U U ℝ :=
  chain A (Matrix.diagonal (fun u => K u u))

noncomputable def endpointPin (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, K u v*chain A K u v*endpointChain A K u v

lemma chain_nonnegative (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) :
    ∀ u v, 0 ≤ chain A K u v :=
  GramFeatures.chain_nonneg (GramFeatures.chain_nonneg (GramFeatures.chain_nonneg hA hA) hK)
    (GramFeatures.chain_nonneg hA hA)

lemma endpointChain_nonneg (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) :
    ∀ u v, 0 ≤ endpointChain A K u v := by
  apply chain_nonnegative A _ hA
  intro u v
  simp only [Matrix.diagonal_apply]
  split_ifs
  · exact hK u u
  · exact le_rfl

lemma endpointPin_nonneg (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) :
    0 ≤ endpointPin A K :=
  sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
    mul_nonneg (mul_nonneg (hK u v) (chain_nonnegative A K hA hK u v))
      (endpointChain_nonneg A K hA hK u v)))

lemma endpointChain_le (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (B : ℝ) (hdiag : ∀ u, K u u ≤ B) (u v : U) :
    endpointChain A K u v ≤ B*((A*A)*(A*A)) u v := by
  change (∑ w, ((A*A)*Matrix.diagonal (fun u => K u u)) u w*(A*A) w v) ≤
    B*∑ w, (A*A) u w*(A*A) w v
  rw [mul_sum]
  apply sum_le_sum
  intro w _
  rw [Matrix.mul_diagonal]
  have hp : 0 ≤ (A*A) u w*(A*A) w v :=
    mul_nonneg (GramFeatures.chain_nonneg hA hA u w) (GramFeatures.chain_nonneg hA hA w v)
  convert mul_le_mul_of_nonneg_right (hdiag w) hp using 1 <;> ring

lemma chain_diagonal_sum (A K : Matrix U U ℝ) (hs : A.IsSymm) :
    (∑ u, chain A K u u)=∑ u, ∑ v, K u v*((A*A)*(A*A)) u v := by
  have hQ : ((A*A)*(A*A)).IsSymm := by
    show ((A*A)*(A*A)).transpose=(A*A)*(A*A)
    simp only [Matrix.transpose_mul,hs.eq,Matrix.mul_assoc]
  rw [inner_trace,hQ.eq]
  change ((A*A)*K*(A*A)).trace=(K*((A*A)*(A*A))).trace
  simpa only [Matrix.mul_assoc] using (Matrix.trace_mul_cycle K (A*A) (A*A)).symm

lemma diagonal_inner_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (b : ℝ) (hdiag : ∀ u, b ≤ K u u) :
    b*(∑ u, chain A K u u) ≤ twoEnergy A K := by
  rw [twoEnergy_eq_inner A K hs,mul_sum]
  apply sum_le_sum
  intro u _
  calc
    _ ≤ K u u*chain A K u u :=
      mul_le_mul_of_nonneg_right (hdiag u) (chain_nonnegative A K hA hK u u)
    _ ≤ ∑ v, K u v*chain A K u v :=
      single_le_sum (fun v _ => mul_nonneg (hK u v) (chain_nonnegative A K hA hK u v)) (mem_univ u)

/-- The lower diagonal of the arm Gram kernel is retained. It prevents
losing a whole kernel-mass factor in the endpoint estimate. -/
theorem endpointPin_sq_mul_lower_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (b B T : ℝ) (hb : 0 ≤ b) (hB : 0 ≤ B) (hT : 0 ≤ T)
    (hdiag : ∀ u, b ≤ K u u ∧ K u u ≤ B)
    (hQT : ∀ u v, ((A*A)*(A*A)) u v ≤ T) :
    (endpointPin A K)^2*b ≤ B^2*T*energy A K*twoEnergy A K := by
  let S := endpointChain A K
  let eS := ∑ u, ∑ v, K u v*(S u v)^2
  have hs0 : ∀ u v, 0 ≤ S u v := endpointChain_nonneg A K hA hK
  have hQ : ∀ u v, 0 ≤ ((A*A)*(A*A)) u v :=
    GramFeatures.chain_nonneg (GramFeatures.chain_nonneg hA hA) (GramFeatures.chain_nonneg hA hA)
  have hcs : (endpointPin A K)^2 ≤ energy A K*eS := by
    have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (U×U))
      (fun p => Real.sqrt (K p.1 p.2)*chain A K p.1 p.2)
      (fun p => Real.sqrt (K p.1 p.2)*S p.1 p.2)
    have hp (u v : U) : (Real.sqrt (K u v)*chain A K u v)*(Real.sqrt (K u v)*S u v)=
        K u v*chain A K u v*S u v := by
      calc
        _ = (Real.sqrt (K u v))^2*chain A K u v*S u v := by ring
        _ = _ := by rw [Real.sq_sqrt (hK u v)]
    simpa only [Fintype.sum_prod_type,hp,mul_pow,Real.sq_sqrt (hK _ _),endpointPin,energy,eS,S] using h
  have hsbound : eS ≤ B^2*T*(∑ u, chain A K u u) := by
    rw [chain_diagonal_sum A K hs,mul_sum]
    apply sum_le_sum
    intro u _
    rw [mul_sum]
    apply sum_le_sum
    intro v _
    have hh := pow_le_pow_left₀ (hs0 u v) (endpointChain_le A K hA B (fun u => (hdiag u).2) u v) 2
    have hq : (((A*A)*(A*A)) u v)^2 ≤ T*((A*A)*(A*A)) u v := by
      nlinarith [mul_le_mul_of_nonneg_right (hQT u v) (hQ u v)]
    calc
      K u v*(S u v)^2 ≤ K u v*(B*((A*A)*(A*A)) u v)^2 :=
        mul_le_mul_of_nonneg_left hh (hK u v)
      _ ≤ K u v*(B^2*(T*((A*A)*(A*A)) u v)) := by
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hq (sq_nonneg B)) (hK u v)
      _ = _ := by ring
  have hz := diagonal_inner_le A K hs hA hK b (fun u => (hdiag u).1)
  have hm : eS*b ≤ B^2*T*twoEnergy A K := by
    calc
      _ ≤ (B^2*T*(∑ u, chain A K u u))*b := mul_le_mul_of_nonneg_right hsbound hb
      _ = B^2*T*(b*(∑ u, chain A K u u)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hz (mul_nonneg (sq_nonneg B) hT)
  calc
    _ ≤ (energy A K*eS)*b := mul_le_mul_of_nonneg_right hcs hb
    _ = energy A K*(eS*b) := by ring
    _ ≤ energy A K*(B^2*T*twoEnergy A K) := mul_le_mul_of_nonneg_left hm (energy_nonneg A K hK)
    _ = _ := by ring

/-- The conjugation mass lower bound also controls the smaller energy
itself relative to the full three-hub energy. -/
theorem twoEnergy_mul_mass_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (d : ℝ) (hd : 0 ≤ d) (hrow : ∀ u, d ≤ ∑ v, A u v) :
    twoEnergy A K*d^4*(∑ u, ∑ v, K u v) ≤ (Fintype.card U:ℝ)^2*energy A K := by
  let m := ∑ u, ∑ v, K u v
  let z := twoEnergy A K
  have hm : 0 ≤ m := sum_nonneg (fun u _ => sum_nonneg (fun v _ => hK u v))
  have hz : 0 ≤ z := twoEnergy_nonneg A K
  have he : 0 ≤ energy A K := energy_nonneg A K hK
  have hl : d^4*m^2 ≤ (Fintype.card U:ℝ)^2*z := by
    have h := conjugation_total_lower A K hs hA hK d hd hrow
    have hp := pow_le_pow_left₀ (by positivity : 0 ≤ d^2*m) h 2
    have hh := total_sq_le_squareMass (A*K*A)
    convert hp.trans hh using 1 <;> dsimp [m,z,twoEnergy] <;> ring
  have hu := twoEnergy_sq_le A K hs hK
  by_cases hm0 : m=0
  · change z*d^4*m ≤ _
    rw [hm0,mul_zero]
    positivity
  · have hmp : 0 < m := lt_of_le_of_ne hm (Ne.symm hm0)
    apply (mul_le_mul_iff_left₀ hmp).mp
    calc
      (z*d^4*m)*m = z*(d^4*m^2) := by ring
      _ ≤ z*((Fintype.card U:ℝ)^2*z) := mul_le_mul_of_nonneg_left hl hz
      _ = (Fintype.card U:ℝ)^2*z^2 := by ring
      _ ≤ (Fintype.card U:ℝ)^2*(m*energy A K) := mul_le_mul_of_nonneg_left hu (sq_nonneg _)
      _ = _ := by ring

/-- In combination with a positive lower kernel diagonal and row-mass
bounds, this gives the same polynomial degree threshold as the central pin. -/
theorem endpointPin_sq_mul_mass_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (d b B T : ℝ) (hd : 0 ≤ d) (hb : 0 ≤ b) (hB : 0 ≤ B) (hT : 0 ≤ T)
    (hrow : ∀ u, d ≤ ∑ v, A u v)
    (hdiag : ∀ u, b ≤ K u u ∧ K u u ≤ B)
    (hQT : ∀ u v, ((A*A)*(A*A)) u v ≤ T) :
    (endpointPin A K)^2*b*d^4*(∑ u, ∑ v, K u v) ≤
      B^2*T*(Fintype.card U:ℝ)^2*(energy A K)^2 := by
  have hp := endpointPin_sq_mul_lower_le A K hs hA hK b B T hb hB hT hdiag hQT
  have hz := twoEnergy_mul_mass_le A K hs hA hK d hd hrow
  have hm : 0 ≤ ∑ u, ∑ v, K u v := sum_nonneg (fun u _ => sum_nonneg (fun v _ => hK u v))
  calc
    _ ≤ (B^2*T*energy A K*twoEnergy A K)*d^4*(∑ u, ∑ v, K u v) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hp (pow_nonneg hd _)) hm
    _ = (B^2*T*energy A K)*(twoEnergy A K*d^4*(∑ u, ∑ v, K u v)) := by ring
    _ ≤ (B^2*T*energy A K)*((Fintype.card U:ℝ)^2*energy A K) :=
      mul_le_mul_of_nonneg_left hz (by positivity [energy_nonneg A K hK])
    _ = _ := by ring


/-- A separate arm Gram kernel is allowed. Its positive lower diagonal is
kept on the left, together with its row-mass lower bound. -/
theorem endpointPin_power_mul_row_le [Nonempty U]
    (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (d T b r : ℝ)
    (hd : 0 ≤ d) (hT : 0 ≤ T) (hb : 0 ≤ b) (hr : 0 ≤ r)
    (hrow : ∀ u, d ≤ ∑ v, A u v)
    (hQT : ∀ u v, ((A*A)*(A*A)) u v ≤ T)
    (hdiag : ∀ u, b ≤ Q u u ∧ Q u u ≤ T)
    (hQr : ∀ u, r ≤ ∑ v, Q u v) :
    (endpointPin A (entryPower Q s))^2*b^s*d^4*r^s ≤
      T^(2*s+1)*(Fintype.card U:ℝ)^s*(energy A (entryPower Q s))^2 := by
  let K := entryPower Q s
  have hk : ∀ u v, 0 ≤ K u v := fun u v => pow_nonneg (hQ u v) s
  have hp := endpointPin_sq_mul_mass_le A K hsym hA hk d (b^s) (T^s) T
    hd (pow_nonneg hb s) (pow_nonneg hT s) hT hrow
    (fun u => ⟨pow_le_pow_left₀ hb (hdiag u).1 s,pow_le_pow_left₀ (hQ u u) (hdiag u).2 s⟩) hQT
  have hm := entryPower_mass_lower Q hQ s hs r hr hQr
  have hn : (0:ℝ) < Fintype.card U := by exact_mod_cast Fintype.card_pos (α := U)
  have h := (mul_le_mul_of_nonneg_left hm (by positivity :
      0 ≤ (endpointPin A K)^2*b^s*d^4)).trans
    (by
      have hh := mul_le_mul_of_nonneg_left hp (pow_nonneg hn.le (s-1))
      convert hh using 1 <;> ring)
  have he₁ : (Fintype.card U:ℝ)^(s-1)*(Fintype.card U:ℝ)^2=
      (Fintype.card U:ℝ)^s*Fintype.card U := by
    rw [←pow_add,←pow_succ]
    congr 1
    omega
  have he₂ : (T^s)^2*T=T^(2*s+1) := by
    rw [←pow_mul,←pow_succ]
    congr 1
    omega
  have hh : ((endpointPin A K)^2*b^s*d^4*r^s)*(Fintype.card U:ℝ) ≤
      (T^(2*s+1)*(Fintype.card U:ℝ)^s*(energy A K)^2)*(Fintype.card U:ℝ) := by
    convert h using 1
    · ring
    · calc
        _ = T^(2*s+1)*((Fintype.card U:ℝ)^s*Fintype.card U)*(energy A K)^2 := by ring
        _ = _ := by rw [←he₁,←he₂]; ring
  exact (mul_le_mul_iff_left₀ hn).mp hh

end Erdos571.ThreeHubKernel


/-! Endpoint-kernel control under actual three-hub freeness. No global
codegree cap is assumed. The finite endpoint-pin identity is still separate. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix SimpleGraph GramFeatures GramPin

lemma cancel_endpoint_scale (s : ℕ) (p e n C K d : ℝ) (hd : 0 < d)
    (h : p^2*(d^2/2)^s*d^4*(d^4/4)^s ≤ (C*(K*d)^2)^(2*s+1)*n^s*e^2) :
    p^2*d^(2*s+2) ≤ (8:ℝ)^s*C^(2*s+1)*K^(4*s+2)*n^s*e^2 := by
  have he₁ : ((d^2/2)^s*d^4*(d^4/4)^s)*(8:ℝ)^s=d^(6*s+4) := by
    calc
      _ = d^4*((d^2/2)*(d^4/4)*8)^s := by simp only [mul_pow]; ring
      _ = d^4*(d^6)^s := by congr 2; ring
      _ = _ := by rw [←pow_mul,←pow_add]; congr 1; omega
  have he₂ : (C*(K*d)^2)^(2*s+1)=C^(2*s+1)*K^(4*s+2)*d^(4*s+2) := by
    simp only [mul_pow,←pow_mul]
    rw [show 2*(2*s+1)=4*s+2 by omega]
    ring
  have he₃ : d^(6*s+4)=d^(2*s+2)*d^(4*s+2) := by
    rw [←pow_add]
    congr 1
    omega
  have hh := mul_le_mul_of_nonneg_right h (by positivity : 0 ≤ (8:ℝ)^s)
  have h' : (p^2*d^(2*s+2))*d^(4*s+2) ≤
      ((8:ℝ)^s*C^(2*s+1)*K^(4*s+2)*n^s*e^2)*d^(4*s+2) := by
    convert hh using 1
    · calc
        _ = p^2*d^(6*s+4) := by rw [he₃]; ring
        _ = _ := by rw [←he₁]; ring
    · rw [he₂]; ring
  exact (mul_le_mul_iff_left₀ (pow_pos hd (4*s+2))).mp h'

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- The endpoint kernel has the same degree threshold as the current
central-pin estimate, not the sharper rooted-density threshold. -/
theorem free_masked_endpointPin_sq_mul_degree_le (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    let A := G.adjMatrix ℝ
    let N := LightArmKernel.matrix G L
    let F := entryPower (N*N.transpose) s
    (endpointPin A F)^2*d^(2*s+2) ≤
      (8:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+1)*K^(4*s+2)*
        (Fintype.card W:ℝ)^s*(energy A F)^2 := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let Q := N*N.transpose
  let C := ThreeHub.momentCoefficient s M
  let T := C*(K*d)^2
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hK0 : 0 ≤ K := by linarith
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : d ≤ ∑ v, A u v := by
    have he : (∑ v, A u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hmin u
  have hmoment (u : W) : ∑ v, ((A*A) u v)^2 ≤ T :=
    ThreeHub.free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK0 hd.le) hmax u
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hmoment
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hQr (u : W) : d^4/4 ≤ ∑ v, Q u v := by
    have hNs : N.transpose=N := (LightArmKernel.isSymm G L).eq
    have h := chain_row_lower (LightArmKernel.nonneg G L) (by positivity : 0 ≤ d^2/2)
      hNrow hNrow u
    change d^4/4 ≤ ∑ v, (N*N.transpose) u v
    rw [hNs]
    convert h using 1 <;> ring
  have hQT (u v : W) : ((A*A)*(A*A)) u v ≤ T :=
    (LayeredBush.fourth_entries_of_row_bound G T hT hmoment u v).2
  have hdiag (u : W) : d^2/2 ≤ Q u u ∧ Q u u ≤ T :=
    ⟨(hNrow u).trans (LightArmKernel.gram_diagonal_lower G L u),
      LightArmKernel.gram_upper G L T hT hmoment u u⟩
  have h := endpointPin_power_mul_row_le A Q G.isSymm_adjMatrix hA
    (LightArmKernel.gram_nonneg G L) s hs d T (d^2/2) (d^4/4)
    hd.le hT (by positivity) (by positivity) hrow hQT hdiag hQr
  exact cancel_endpoint_scale s _ _ _ C K d hd h

end Erdos571.ThreeHubKernel


/-! The endpoint kernel is the exact cardinality of an endpoint pin in
the finite light-arm assignment model. Repeated vertices remain allowed. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmTensor
open Finset Matrix
variable {W I J : Type} [Fintype W] [Fintype I] [Fintype J] [DecidableEq W]

lemma endpoint_mixed_total (P : Matrix W W ℝ) (F : Matrix W I ℝ) (B : Matrix W J ℝ) :
    (∑ r : I, ∑ t : I, ∑ a : J, ∑ u : W,
      (F u t*(∑ x, F x r*P x u*B x a))^2) =
      ∑ x, ∑ y, (F*F.transpose) x y*(B*B.transpose) x y*
        (P*Matrix.diagonal (fun u => (F*F.transpose) u u)*P.transpose) x y := by
  let K := F*F.transpose
  let C := B*B.transpose
  let H : Matrix W (I×J) ℝ := fun u p => ∑ x, F x p.1*P x u*B x p.2
  have h (u : W) : (∑ p, (H u p)^2)=∑ x, ∑ y, P x u*P y u*K x y*C x y := by
    let F' : Matrix W I ℝ := fun x r => F x r*P x u
    have hf (x y : W) : (F'*F'.transpose) x y=P x u*P y u*K x y := by
      simp only [F',K,Matrix.mul_apply,Matrix.transpose_apply,mul_sum]
      exact sum_congr rfl (fun r _ => by ring)
    have hh := mixed_total F' B
    simpa only [F',Fintype.sum_prod_type,H,hf,C] using hh
  have he := pair_row_squares F H
  simp only [Fintype.sum_prod_type,H] at he
  rw [sum_comm]
  rw [he]
  have hk (u : W) : (∑ t, (F u t)^2)=K u u := by
    simp only [K,Matrix.mul_apply,Matrix.transpose_apply,pow_two]
  have h' (u : W) : (∑ r, ∑ a, (∑ x, F x r*P x u*B x a)^2)=
      ∑ x, ∑ y, P x u*P y u*K x y*C x y := by
    simpa only [H,Fintype.sum_prod_type] using h u
  simp_rw [hk,h']
  simp only [mul_sum]
  rw [sum_comm]
  conv_lhs => arg 2; ext x; rw [sum_comm]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  change (∑ u, K u u*(P x u*P y u*K x y*C x y))=
    K x y*C x y*∑ u, (P*Matrix.diagonal (fun u => K u u)) x u*P.transpose u y
  rw [mul_sum]
  apply sum_congr rfl
  intro u _
  rw [Matrix.mul_diagonal,Matrix.transpose_apply]
  ring
end Erdos571.ArmTensor

namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ)

def leftHub (p : Full G L s) : W := p.2.2.2.1.1

def leftMarkEquiv (r : Roots (W := W) s) (u : W) :
    MarkFiber G L s (leftHub G L s) r u ≃
      ((x : W) × (Bundle G L s x r.1 ×
        (G.commonNeighbors x u × Bundle G L s u r.2.1) × Side G L s x r.2.2)) where
  toFun p := by
    rcases p with ⟨⟨x,a,⟨v,h,b⟩,z⟩,he⟩
    change v=u at he
    subst v
    exact ⟨x,a,⟨h,b⟩,z⟩
  invFun p := ⟨⟨p.1,p.2.1,⟨u,p.2.2.1⟩,p.2.2.2⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,a,⟨v,h,b⟩,z⟩,he⟩
    change v=u at he
    subst v
    rfl
  right_inv _ := rfl

open Classical in
lemma leftMark_card (r : Roots (W := W) s) (u : W) :
    (Fintype.card (MarkFiber G L s (leftHub G L s) r u):ℝ)=
      armFeature G L s u r.2.1*
        (∑ x, armFeature G L s x r.1*(G.adjMatrix ℝ * G.adjMatrix ℝ) x u*sideFeature G L s x r.2.2) := by
  rw [Fintype.card_congr (leftMarkEquiv G L s r u),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_side]
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  rw [←LayeredBush.adjacency_square_common_card]
  dsimp only [armFeature]
  ring

open Classical in
lemma left_pin_card : (Nat.card (Pin G L s (leftHub G L s)):ℝ)=
    ThreeHubKernel.endpointPin (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [pin_card]
  simp_rw [leftMark_card]
  simp only [Fintype.sum_prod_type]
  rw [ArmTensor.endpoint_mixed_total,arm_gram,side_gram]
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ := by
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  rw [hs]
  rfl


def rightHub (p : Full G L s) : W := p.2.2.2.2.1

def swapSides (p : Full G L s) : Full G L s :=
  ⟨⟨p.1.1,p.1.2.2,p.1.2.1⟩,p.2.1,p.2.2.1,p.2.2.2.2,p.2.2.2.1⟩

def endpointPinEquiv : Pin G L s (leftHub G L s) ≃ Pin G L s (rightHub G L s) where
  toFun p := ⟨⟨swapSides G L s p.1.1,swapSides G L s p.1.2⟩,
    congrArg (fun r : Roots (W := W) s => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  invFun p := ⟨⟨swapSides G L s p.1.1,swapSides G L s p.1.2⟩,
    congrArg (fun r : Roots (W := W) s => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma right_pin_card : (Nat.card (Pin G L s (rightHub G L s)):ℝ)=
    ThreeHubKernel.endpointPin (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [←Nat.card_congr (endpointPinEquiv G L s)]
  exact left_pin_card G L s


lemma hom_leftHub (hs : 1 ≤ s) (p : Full G L s) :
    hom G L s hs p (RootedSubdivision.old (ThreeHub.base s) (.inl 0))=leftHub G L s p := by
  rw [hom_old]
  simp [oldValue,hubValue,leftHub]

lemma hom_rightHub (hs : 1 ≤ s) (p : Full G L s) :
    hom G L s hs p (RootedSubdivision.old (ThreeHub.base s) (.inl 2))=rightHub G L s p := by
  rw [hom_old]
  simp [oldValue,hubValue,rightHub]

variable [Nonempty W]
/-- Actual endpoint-pin cardinalities satisfy the degree-sensitive bound,
under original ThreeHub freeness and without a global codegree hypothesis. -/
theorem left_pin_sq_mul_degree_le (M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Pin G L s (leftHub G L s)):ℝ)^2*d^(2*s+2) ≤
      (8:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+1)*K^(4*s+2)*
        (Fintype.card W:ℝ)^s*(Nat.card (Agreement G L s):ℝ)^2 := by
  rw [left_pin_card,agreement_card]
  exact ThreeHubKernel.free_masked_endpointPin_sq_mul_degree_le G s M hs hf L d K
    hL hd hK hdK hmin hmax hcut


theorem right_pin_sq_mul_degree_le (M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Pin G L s (rightHub G L s)):ℝ)^2*d^(2*s+2) ≤
      (8:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+1)*K^(4*s+2)*
        (Fintype.card W:ℝ)^s*(Nat.card (Agreement G L s):ℝ)^2 := by
  rw [←Nat.card_congr (endpointPinEquiv G L s)]
  exact left_pin_sq_mul_degree_le G L s M hs hf d K hL hd hK hdK hmin hmax hcut

end Erdos571.ThreeHubAssignments

/-! Algebra for a core-middle pin in the three-hub assignment model.
The graph-theoretic local quadratic input is kept explicit here. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def middleChain (A K : Matrix U U ℝ) : Matrix U U ℝ :=
  A*Matrix.diagonal (fun w => (A*K*A) w w)*A

noncomputable def middlePin (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, K u v*chain A K u v*middleChain A K u v

noncomputable def localMiddleMoment (A K : Matrix U U ℝ) (w : U) : ℝ :=
  ∑ u, ∑ v, A w u*A w v*K u v*(A*A) u v

lemma weighted_sum_sq {I : Type} [Fintype I] (w f : I → ℝ) (hw : ∀ i, 0 ≤ w i) :
    (∑ i, w i*f i)^2 ≤ (∑ i, w i)*(∑ i, w i*(f i)^2) := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset I)
    (fun i => Real.sqrt (w i)) (fun i => Real.sqrt (w i)*f i)
  have he (i : I) : Real.sqrt (w i)*(Real.sqrt (w i)*f i)=w i*f i := by
    rw [←mul_assoc,←pow_two,Real.sq_sqrt (hw i)]
  simpa only [he,mul_pow,Real.sq_sqrt (hw _)] using h

lemma weighted_inner_sq (K B C : Matrix U U ℝ) (hK : ∀ u v, 0 ≤ K u v) :
    (∑ u, ∑ v, K u v*B u v*C u v)^2 ≤
      (∑ u, ∑ v, K u v*(B u v)^2)*(∑ u, ∑ v, K u v*(C u v)^2) := by
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (U×U))
    (fun p => Real.sqrt (K p.1 p.2)*B p.1 p.2)
    (fun p => Real.sqrt (K p.1 p.2)*C p.1 p.2)
  have he (u v : U) : (Real.sqrt (K u v)*B u v)*(Real.sqrt (K u v)*C u v)=
      K u v*B u v*C u v := by
    calc
      _ = (Real.sqrt (K u v))^2*B u v*C u v := by ring
      _ = _ := by rw [Real.sq_sqrt (hK u v)]
  simpa only [Fintype.sum_prod_type,he,mul_pow,Real.sq_sqrt (hK _ _)] using h

lemma sandwich_diagonal_apply (A : Matrix U U ℝ) (g : U → ℝ) (hs : A.IsSymm) (u v : U) :
    (A*Matrix.diagonal g*A) u v=∑ w, A u w*A v w*g w := by
  change (∑ w, (A*Matrix.diagonal g) u w*A w v)=_
  apply sum_congr rfl
  intro w _
  rw [Matrix.mul_diagonal,hs.apply w v]
  ring

lemma middleChain_nonneg (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) :
    ∀ u v, 0 ≤ middleChain A K u v := by
  apply GramFeatures.chain_nonneg (GramFeatures.chain_nonneg hA _) hA
  intro u v
  simp only [Matrix.diagonal_apply]
  split_ifs
  · exact GramFeatures.chain_nonneg (GramFeatures.chain_nonneg hA hK) hA u u
  · exact le_rfl

lemma middlePin_nonneg (A K : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) : 0 ≤ middlePin A K :=
  sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
    mul_nonneg (mul_nonneg (hK u v) (chain_nonnegative A K hA hK u v))
      (middleChain_nonneg A K hA hK u v)))

/-- Weighted Cauchy exposes a local quadratic moment at each marked middle. -/
lemma middle_square_energy_le_local (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v) :
    (∑ u, ∑ v, K u v*(middleChain A K u v)^2) ≤
      ∑ w, ((A*K*A) w w)^2*localMiddleMoment A K w := by
  have hcs (u v : U) : (middleChain A K u v)^2 ≤
      (A*A) u v*(∑ w, A u w*A v w*((A*K*A) w w)^2) := by
    rw [middleChain,sandwich_diagonal_apply A _ hs]
    have he : (∑ w, A u w*A v w)=(A*A) u v := by
      simp only [Matrix.mul_apply,hs.apply v]
    simpa only [he] using weighted_sum_sq (fun w => A u w*A v w)
      (fun w => (A*K*A) w w) (fun w => mul_nonneg (hA u w) (hA v w))
  calc
    _ ≤ ∑ u, ∑ v, K u v*((A*A) u v*(∑ w, A u w*A v w*((A*K*A) w w)^2)) :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => mul_le_mul_of_nonneg_left (hcs u v) (hK u v)))
    _ = _ := by
      simp only [mul_sum,localMiddleMoment]
      conv_lhs => arg 2; ext u; rw [sum_comm]
      rw [sum_comm]
      apply sum_congr rfl
      intro w _
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      rw [hs.apply u w,hs.apply v w]
      ring

/-- The local moment bound and fourth-row bound give a mass-sensitive
middle-pin estimate. No codegree cap is presumed. -/
theorem middlePin_sq_le_mass (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (Z T B : ℝ) (hZ : 0 ≤ Z) (hT : 0 ≤ T) (hB : 0 ≤ B)
    (hlocal : ∀ w, localMiddleMoment A K w ≤ Z)
    (hrow : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hcap : ∀ u v, K u v ≤ B) :
    (middlePin A K)^2 ≤ Z*T*B*(∑ u, ∑ v, K u v)*energy A K := by
  have h₁ := weighted_inner_sq K (chain A K) (middleChain A K) hK
  have h₂ := middle_square_energy_le_local A K hs hA hK
  have h₃ : (∑ w, ((A*K*A) w w)^2*localMiddleMoment A K w) ≤
      Z*∑ w, ((A*K*A) w w)^2 := by
    rw [mul_sum]
    exact sum_le_sum (fun w _ => by
      simpa only [mul_comm Z] using mul_le_mul_of_nonneg_left (hlocal w) (sq_nonneg _))
  have h₄ : (∑ w, ((A*K*A) w w)^2) ≤ T*squareMass K := by
    simpa only [hs.eq] using diagonal_conjugation_bound A K T hT (by simpa only [hs.eq] using hrow)
  have h₅ : squareMass K ≤ B*(∑ u, ∑ v, K u v) := by
    simp only [squareMass,mul_sum]
    exact sum_le_sum (fun u _ => sum_le_sum (fun v _ => by
      simpa only [pow_two] using mul_le_mul_of_nonneg_right (hcap u v) (hK u v)))
  have hh := h₂.trans (h₃.trans ((mul_le_mul_of_nonneg_left h₄ hZ).trans
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h₅ hT) hZ)))
  calc
    _ ≤ energy A K*(∑ u, ∑ v, K u v*(middleChain A K u v)^2) := h₁
    _ ≤ energy A K*(Z*(T*(B*(∑ u, ∑ v, K u v)))) :=
      mul_le_mul_of_nonneg_left hh (energy_nonneg A K hK)
    _ = _ := by ring

end Erdos571.ThreeHubKernel


/-! A nonnegative feature factor allows the subdivision-freeness quadratic
estimate to control the local moment for a core-middle pin. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U I : Type} [Fintype U] [Fintype I] [DecidableEq U]

lemma conjugation_diagonal_bound_of_cap (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hcap : ∀ u v, K u v ≤ B) (w : U) :
    (A*K*A) w w ≤ D^2*B := by
  have he : (A*K*A) w w=∑ u, ∑ v, A w u*K u v*A w v := by
    simp only [Matrix.mul_apply,sum_mul,hs.apply _ w]
    rw [sum_comm]
  calc
    _ = ∑ u, ∑ v, A w u*K u v*A w v := he
    _ ≤ ∑ u, ∑ v, A w u*B*A w v := sum_le_sum (fun u _ => sum_le_sum (fun v _ =>
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hcap u v) (hA w u)) (hA w v)))
    _ = (∑ u, A w u)^2*B := by simp only [sum_mul_sum,pow_two,sum_mul,mul_sum]; congr 1; funext u; congr 1; funext v; ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ (sum_nonneg (fun u _ => hA w u)) (hrow w) 2) hB

lemma localMiddleMoment_feature (A : Matrix U U ℝ) (F : Matrix U I ℝ) (w : U) :
    localMiddleMoment A (F*F.transpose) w=
      ∑ r, ∑ u, ∑ v, (A*A) u v*(A w u*F u r)*(A w v*F v r) := by
  change (∑ u, ∑ v, A w u*A w v*(∑ r, F u r*F v r)*(A*A) u v)=_
  simp only [mul_sum,sum_mul]
  conv_lhs => arg 2; ext u; rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro r _
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  ring

lemma conjugation_feature_diagonal (A : Matrix U U ℝ) (F : Matrix U I ℝ) (hs : A.IsSymm) (w : U) :
    (∑ r, (∑ u, A w u*F u r)^2)=(A*(F*F.transpose)*A) w w := by
  have he : (A*F)*(A*F).transpose=A*(F*F.transpose)*A := by
    simp only [Matrix.transpose_mul,hs.eq,Matrix.mul_assoc]
  rw [←he]
  simp only [Matrix.mul_apply,Matrix.transpose_apply,pow_two]

lemma feature_column_squares (A : Matrix U U ℝ) (F : Matrix U I ℝ) (w : U) :
    (∑ r, ∑ u, (A w u*F u r)^2)=∑ u, (A w u)^2*(F*F.transpose) u u := by
  simp only [mul_pow,Matrix.mul_apply,Matrix.transpose_apply,←pow_two,mul_sum]
  rw [sum_comm]

/-- The local moment uses the whole nonnegative Gram factor, rather than
an entrywise mask incorrectly treated as positive semidefinite. -/
theorem localMiddleMoment_bound (A : Matrix U U ℝ) (F : Matrix U I ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hF : ∀ u r, 0 ≤ F u r)
    (c L D B : ℝ) (hc : 0 ≤ c) (hL : 0 ≤ L) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hAsq : ∀ u v, (A u v)^2 ≤ A u v)
    (hcap : ∀ u v, (F*F.transpose) u v ≤ B)
    (hquad : ∀ f : U → ℝ, (∀ u, 0 ≤ f u) →
      (∑ u, ∑ v, (A*A) u v*f u*f v) ≤ c*(L*(∑ u, f u)^2+D*∑ u, (f u)^2)) (w : U) :
    localMiddleMoment A (F*F.transpose) w ≤ c*(L+1)*D^2*B := by
  let K := F*F.transpose
  have hK : ∀ u v, 0 ≤ K u v := fun u v =>
    sum_nonneg (fun r _ => mul_nonneg (hF u r) (hF v r))
  have hq := sum_le_sum (fun r (_ : r∈univ) =>
    hquad (fun u => A w u*F u r) (fun u => mul_nonneg (hA w u) (hF u r)))
  rw [←localMiddleMoment_feature] at hq
  simp only [←mul_sum,sum_add_distrib] at hq
  rw [conjugation_feature_diagonal A F hs w,feature_column_squares] at hq
  have hb := conjugation_diagonal_bound_of_cap A K hs hA D B hD hB hrow hcap w
  have hsq : (∑ u, (A w u)^2*K u u) ≤ D*B := by
    calc
      _ ≤ ∑ u, A w u*K u u := sum_le_sum (fun u _ =>
        mul_le_mul_of_nonneg_right (hAsq w u) (hK u u))
      _ ≤ ∑ u, A w u*B := sum_le_sum (fun u _ =>
        mul_le_mul_of_nonneg_left (hcap u u) (hA w u))
      _ = (∑ u, A w u)*B := by rw [sum_mul]
      _ ≤ _ := mul_le_mul_of_nonneg_right (hrow w) hB
  apply hq.trans
  calc
    _ ≤ c*(L*(D^2*B)+D*(D*B)) := mul_le_mul_of_nonneg_left
      (add_le_add (mul_le_mul_of_nonneg_left hb hL) (mul_le_mul_of_nonneg_left hsq hD)) hc
    _ = _ := by ring

end Erdos571.ThreeHubKernel


/-! Converting the mass-sensitive middle-pin bound into a polynomial
row-mass threshold. Zero kernel mass is handled without division. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

lemma energy_mass_cube_lower (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (d : ℝ) (hd : 0 ≤ d) (hrow : ∀ u, d ≤ ∑ v, A u v) :
    d^8*(∑ u, ∑ v, K u v)^3 ≤ (Fintype.card U:ℝ)^4*energy A K := by
  let m := ∑ u, ∑ v, K u v
  let z := twoEnergy A K
  have hm : 0 ≤ m := sum_nonneg (fun u _ => sum_nonneg (fun v _ => hK u v))
  have he : 0 ≤ energy A K := energy_nonneg A K hK
  have hl : d^4*m^2 ≤ (Fintype.card U:ℝ)^2*z := by
    have h := conjugation_total_lower A K hs hA hK d hd hrow
    have hp := pow_le_pow_left₀ (by positivity : 0 ≤ d^2*m) h 2
    convert hp.trans (total_sq_le_squareMass (A*K*A)) using 1 <;> dsimp [m,z,twoEnergy] <;> ring
  have hsq := pow_le_pow_left₀ (by positivity : 0 ≤ d^4*m^2) hl 2
  have hu := twoEnergy_sq_le A K hs hK
  by_cases hm0 : m=0
  · change d^8*m^3 ≤ _
    rw [hm0,zero_pow (by omega),mul_zero]
    positivity
  · have hmp : 0 < m := lt_of_le_of_ne hm (Ne.symm hm0)
    apply (mul_le_mul_iff_left₀ hmp).mp
    calc
      (d^8*m^3)*m = (d^4*m^2)^2 := by ring
      _ ≤ ((Fintype.card U:ℝ)^2*z)^2 := hsq
      _ = (Fintype.card U:ℝ)^4*z^2 := by ring
      _ ≤ (Fintype.card U:ℝ)^4*(m*energy A K) := mul_le_mul_of_nonneg_left hu (by positivity)
      _ = _ := by ring

/-- The factor of kernel mass on the right is absorbed using the Perron
lower bound; no uniform bound on the mass is substituted. -/
theorem middlePin_sq_mul_mass_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (d T B : ℝ) (hd : 0 ≤ d) (hT : 0 ≤ T) (hB : 0 ≤ B)
    (hmin : ∀ u, d ≤ ∑ v, A u v)
    (hlocal : ∀ w, localMiddleMoment A K w ≤ T*B)
    (hrow : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hcap : ∀ u v, K u v ≤ B) :
    (middlePin A K)^2*d^8*(∑ u, ∑ v, K u v)^2 ≤
      (T*B)^2*(Fintype.card U:ℝ)^4*(energy A K)^2 := by
  have hp := middlePin_sq_le_mass A K hs hA hK (T*B) T B (mul_nonneg hT hB) hT hB hlocal hrow hcap
  have he := energy_mass_cube_lower A K hs hA hK d hd hmin
  have hE : 0 ≤ energy A K := energy_nonneg A K hK
  calc
    _ ≤ ((T*B)*T*B*(∑ u, ∑ v, K u v)*energy A K)*d^8*(∑ u, ∑ v, K u v)^2 :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hp (pow_nonneg hd _)) (sq_nonneg _)
    _ = (T*B)^2*energy A K*(d^8*(∑ u, ∑ v, K u v)^3) := by ring
    _ ≤ (T*B)^2*energy A K*((Fintype.card U:ℝ)^4*energy A K) :=
      mul_le_mul_of_nonneg_left he (mul_nonneg (sq_nonneg _) hE)
    _ = _ := by ring

theorem middlePin_power_mul_row_le [Nonempty U]
    (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (d T r : ℝ) (hd : 0 ≤ d) (hT : 0 ≤ T) (hr : 0 ≤ r)
    (hmin : ∀ u, d ≤ ∑ v, A u v)
    (hlocal : ∀ w, localMiddleMoment A (entryPower Q s) w ≤ T*T^s)
    (hrow : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hcap : ∀ u v, Q u v ≤ T) (hQr : ∀ u, r ≤ ∑ v, Q u v) :
    (middlePin A (entryPower Q s))^2*d^8*r^(2*s) ≤
      T^(2*s+2)*(Fintype.card U:ℝ)^(2*s)*(energy A (entryPower Q s))^2 := by
  let K := entryPower Q s
  have hK : ∀ u v, 0 ≤ K u v := fun u v => pow_nonneg (hQ u v) s
  have hp := middlePin_sq_mul_mass_le A K hsym hA hK d T (T^s) hd hT (pow_nonneg hT s)
    hmin hlocal hrow (fun u v => pow_le_pow_left₀ (hQ u v) (hcap u v) s)
  have hm := entryPower_mass_lower Q hQ s hs r hr hQr
  have hm2 := pow_le_pow_left₀ (by positivity : 0 ≤ (Fintype.card U:ℝ)*r^s) hm 2
  have hn : 0 < (Fintype.card U:ℝ) := by exact_mod_cast Fintype.card_pos (α := U)
  have h := (mul_le_mul_of_nonneg_left hm2 (by positivity : 0 ≤ (middlePin A K)^2*d^8)).trans
    (by
      have hh := mul_le_mul_of_nonneg_left hp (sq_nonneg ((Fintype.card U:ℝ)^(s-1)))
      convert hh using 1 <;> ring)
  have he₁ : ((Fintype.card U:ℝ)^(s-1))^2*(Fintype.card U:ℝ)^4=
      (Fintype.card U:ℝ)^(2*s)*(Fintype.card U:ℝ)^2 := by
    simp only [←pow_mul,←pow_add]
    congr 1
    omega
  have he₂ : (T*T^s)^2=T^(2*s+2) := by
    rw [←pow_succ',←pow_mul]
    congr 1
    omega
  have he₃ : (r^s)^2=r^(2*s) := by rw [←pow_mul,Nat.mul_comm s 2]
  have hh : ((middlePin A K)^2*d^8*r^(2*s))*(Fintype.card U:ℝ)^2 ≤
      (T^(2*s+2)*(Fintype.card U:ℝ)^(2*s)*(energy A K)^2)*(Fintype.card U:ℝ)^2 := by
    convert h using 1
    · rw [mul_pow,he₃]; ring
    · calc
        _ = T^(2*s+2)*((Fintype.card U:ℝ)^(2*s)*(Fintype.card U:ℝ)^2)*(energy A K)^2 := by ring
        _ = _ := by rw [←he₁,←he₂]; ring
  exact (mul_le_mul_iff_left₀ (sq_pos_of_pos hn)).mp hh

end Erdos571.ThreeHubKernel


/-! Core-middle kernel bounds from actual ThreeHub freeness. The local
quadratic estimate, not a global codegree cap, supplies the required input. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix SimpleGraph GramFeatures GramPin
variable {W I : Type} [Fintype W] [Fintype I] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma free_localMiddleMoment_bound (s M : ℕ) (hf : (ThreeHub.graph s M).Free G)
    (F : Matrix W I ℝ) (hF : ∀ u r, 0 ≤ F u r) (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (hcap : ∀ u v, (F*F.transpose) u v ≤ B) (w : W) :
    localMiddleMoment (G.adjMatrix ℝ) (F*F.transpose) w ≤ ThreeHub.momentCoefficient s M*D^2*B := by
  let A := G.adjMatrix ℝ
  let c : ℝ := (Fintype.card (ThreeHub.Branch s M)-1:ℕ)
  let ell : ℝ := (Fintype.card (ThreeHub.Branch s M)+
    Nat.card (FullRootedPower.graph (ThreeHub.base s) (M+1)).edgeSet:ℕ)
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : ∑ v, A u v ≤ D := by
    have he : (∑ v, A u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hdeg u
  have hAsq (u v : W) : (A u v)^2 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hquad (f : W → ℝ) (hfn : ∀ u, 0 ≤ f u) :
      (∑ u, ∑ v, (A*A) u v*f u*f v) ≤ c*(ell*(∑ u, f u)^2+D*∑ u, (f u)^2) := by
    have h := SubdivisionNormalizedKernel.threeHub_free_quadratic_bound s M G hf 1 D
      (by norm_num) (by simpa only [mul_one] using hdeg) f hfn
    simpa only [SubdivisionNormalizedKernel.kernel,div_one,Matrix.smul_apply,smul_eq_mul,one_mul] using h
  have h := localMiddleMoment_bound A F G.isSymm_adjMatrix hA hF c ell D B
    (by dsimp [c]; positivity) (by dsimp [ell]; positivity) hD hB hrow hAsq hcap hquad w
  simpa only [A,c,ell,ThreeHub.momentCoefficient,Nat.cast_add,Nat.cast_one] using h

lemma cancel_middle_scale (s : ℕ) (p e n C K d : ℝ) (hd : 0 < d)
    (h : p^2*d^8*(d^4/4)^(2*s) ≤ (C*(K*d)^2)^(2*s+2)*n^(2*s)*e^2) :
    p^2*d^(4*s+4) ≤ (16:ℝ)^s*C^(2*s+2)*K^(4*s+4)*n^(2*s)*e^2 := by
  have hr : (16:ℝ)^s=(4:ℝ)^(2*s) := by rw [pow_mul]; norm_num
  have he₁ : (d^8*(d^4/4)^(2*s))*(16:ℝ)^s=d^(8*s+8) := by
    calc
      _ = d^8*((d^4/4)*4)^(2*s) := by rw [mul_pow,hr]; ring
      _ = d^8*(d^4)^(2*s) := by rw [div_mul_cancel₀ _ (by norm_num : (4:ℝ)≠0)]
      _ = _ := by rw [←pow_mul,←pow_add]; congr 1; omega
  have he₂ : (C*(K*d)^2)^(2*s+2)=C^(2*s+2)*K^(4*s+4)*d^(4*s+4) := by
    simp only [mul_pow,←pow_mul]
    rw [show 2*(2*s+2)=4*s+4 by omega]
    ring
  have he₃ : d^(8*s+8)=(d^(4*s+4))^2 := by rw [←pow_mul]; congr 1; omega
  have hh := mul_le_mul_of_nonneg_right h (by positivity : 0 ≤ (16:ℝ)^s)
  have h' : (p^2*d^(4*s+4))*d^(4*s+4) ≤
      ((16:ℝ)^s*C^(2*s+2)*K^(4*s+4)*n^(2*s)*e^2)*d^(4*s+4) := by
    convert hh using 1
    · calc
        _ = p^2*d^(8*s+8) := by rw [he₃]; ring
        _ = _ := by rw [←he₁]; ring
    · rw [he₂]; ring
  exact (mul_le_mul_iff_left₀ (pow_pos hd (4*s+4))).mp h'

variable [Nonempty W]
/-- The core-middle kernel has the same nonsharp threshold as the central
pin. All graph-wide assumptions are displayed; no codegree bound is added. -/
theorem free_masked_middlePin_sq_mul_degree_le (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    let A := G.adjMatrix ℝ
    let N := LightArmKernel.matrix G L
    let F := entryPower (N*N.transpose) s
    (middlePin A F)^2*d^(4*s+4) ≤
      (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+2)*K^(4*s+4)*
        (Fintype.card W:ℝ)^(2*s)*(energy A F)^2 := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let Q := N*N.transpose
  let C := ThreeHub.momentCoefficient s M
  let T := C*(K*d)^2
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hK0 : 0 ≤ K := by linarith
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : d ≤ ∑ v, A u v := by
    have he : (∑ v, A u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hmin u
  have hmoment (u : W) : ∑ v, ((A*A) u v)^2 ≤ T :=
    ThreeHub.free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK0 hd.le) hmax u
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hmoment
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hQr (u : W) : d^4/4 ≤ ∑ v, Q u v := by
    have hNs : N.transpose=N := (LightArmKernel.isSymm G L).eq
    have h := chain_row_lower (LightArmKernel.nonneg G L) (by positivity : 0 ≤ d^2/2)
      hNrow hNrow u
    change d^4/4 ≤ ∑ v, (N*N.transpose) u v
    rw [hNs]
    convert h using 1 <;> ring
  have hcap (u v : W) : Q u v ≤ T := LightArmKernel.gram_upper G L T hT hmoment u v
  have hlocal (w : W) : localMiddleMoment A (entryPower Q s) w ≤ T*T^s := by
    have h := free_localMiddleMoment_bound G s M hf (ThreeHubAssignments.armFeature G L s)
      (ArmTensor.nonneg N (LightArmKernel.nonneg G L) (Fin s)) (K*d) (T^s)
      (mul_nonneg hK0 hd.le) (pow_nonneg hT s) hmax
      (by
        rw [ThreeHubAssignments.arm_gram]
        exact fun u v => pow_le_pow_left₀ (LightArmKernel.gram_nonneg G L u v) (hcap u v) s) w
    simpa only [ThreeHubAssignments.arm_gram] using h
  have h := middlePin_power_mul_row_le A Q G.isSymm_adjMatrix hA
    (LightArmKernel.gram_nonneg G L) s hs d T (d^4/4) hd.le hT (by positivity)
    hrow hlocal hmoment hcap hQr
  exact cancel_middle_scale s _ _ _ C K d hd h

end Erdos571.ThreeHubKernel


/-! Exact core-middle pin cardinalities for the original finite assignment
model, and their actual-freeness degree bounds. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmTensor
open Finset Matrix
variable {W I J R : Type} [Fintype W] [Fintype I] [Fintype J] [Fintype R] [DecidableEq W]

lemma marked_mixed_total (P : Matrix W W ℝ) (F : Matrix W I ℝ)
    (J' : Matrix W J ℝ) (B : Matrix W R ℝ) :
    (∑ r : I, ∑ t : J, ∑ a : R, ∑ u : W,
      (J' u t*(∑ x, F x r*P x u*B x a))^2) =
      ∑ x, ∑ y, (F*F.transpose) x y*(B*B.transpose) x y*
        (P*Matrix.diagonal (fun u => (J'*J'.transpose) u u)*P.transpose) x y := by
  let K := F*F.transpose
  let C := B*B.transpose
  let H : Matrix W (I×R) ℝ := fun u p => ∑ x, F x p.1*P x u*B x p.2
  have h (u : W) : (∑ p, (H u p)^2)=∑ x, ∑ y, P x u*P y u*K x y*C x y := by
    let F' : Matrix W I ℝ := fun x r => F x r*P x u
    have hf (x y : W) : (F'*F'.transpose) x y=P x u*P y u*K x y := by
      simp only [F',K,Matrix.mul_apply,Matrix.transpose_apply,mul_sum]
      exact sum_congr rfl (fun r _ => by ring)
    have hh := mixed_total F' B
    simpa only [F',Fintype.sum_prod_type,H,hf,C] using hh
  have he := pair_row_squares J' H
  simp only [Fintype.sum_prod_type,H] at he
  rw [sum_comm,he]
  have hk (u : W) : (∑ t, (J' u t)^2)=(J'*J'.transpose) u u := by
    simp only [Matrix.mul_apply,Matrix.transpose_apply,pow_two]
  have h' (u : W) : (∑ r, ∑ a, (∑ x, F x r*P x u*B x a)^2)=
      ∑ x, ∑ y, P x u*P y u*K x y*C x y := by
    simpa only [H,Fintype.sum_prod_type] using h u
  simp_rw [hk,h']
  simp only [mul_sum]
  rw [sum_comm]
  conv_lhs => arg 2; ext x; rw [sum_comm]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  change (∑ u, (J'*J'.transpose) u u*(P x u*P y u*K x y*C x y))=
    K x y*C x y*∑ u, (P*Matrix.diagonal (fun u => (J'*J'.transpose) u u)) x u*P.transpose u y
  rw [mul_sum]
  apply sum_congr rfl
  intro u _
  rw [Matrix.mul_diagonal,Matrix.transpose_apply]
  ring
end Erdos571.ArmTensor

namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ)

def leftCoreMiddle (p : Full G L s) : W := p.2.2.2.1.2.1.val

def rightCoreMiddle (p : Full G L s) : W := p.2.2.2.2.2.1.val

def leftCoreMarkEquiv (r : Roots (W := W) s) (w : W) :
    MarkFiber G L s (leftCoreMiddle G L s) r w ≃
      ((x : W) × (Bundle G L s x r.1 × PLift (G.Adj x w) ×
        MaskedBush.Side G L (Fin s) w r.2.1 × Side G L s x r.2.2)) where
  toFun p := by
    rcases p with ⟨⟨x,a,⟨u,⟨z,hz⟩,b⟩,q⟩,he⟩
    change z=w at he
    subst z
    exact ⟨x,a,⟨hz.1⟩,⟨u,⟨hz.2.symm⟩,b⟩,q⟩
  invFun p := by
    rcases p with ⟨x,a,hx,⟨u,hu,b⟩,q⟩
    exact ⟨⟨x,a,⟨u,⟨w,hx.down,hu.down.symm⟩,b⟩,q⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,a,⟨u,⟨z,hz⟩,b⟩,q⟩,he⟩
    change z=w at he
    subst z
    rfl
  right_inv p := by
    rcases p with ⟨x,a,⟨hx⟩,⟨u,⟨hu⟩,b⟩,q⟩
    rfl

open Classical in
lemma leftCoreMark_card (r : Roots (W := W) s) (w : W) :
    (Fintype.card (MarkFiber G L s (leftCoreMiddle G L s) r w):ℝ)=
      (G.adjMatrix ℝ * armFeature G L s) w r.2.1*
        (∑ x, armFeature G L s x r.1*G.adjMatrix ℝ x w*sideFeature G L s x r.2.2) := by
  rw [Fintype.card_congr (leftCoreMarkEquiv G L s r w),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,MaskedBush.card_side,
    card_side,LayeredAssignments.card_adj]
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  dsimp only [armFeature]
  ring

open Classical in
lemma left_core_pin_card : (Nat.card (Pin G L s (leftCoreMiddle G L s)):ℝ)=
    ThreeHubKernel.middlePin (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [pin_card]
  simp_rw [leftCoreMark_card]
  simp only [Fintype.sum_prod_type]
  rw [ArmTensor.marked_mixed_total]
  have hm : (G.adjMatrix ℝ * armFeature G L s)*(G.adjMatrix ℝ * armFeature G L s).transpose=
      G.adjMatrix ℝ *(armFeature G L s*(armFeature G L s).transpose)*G.adjMatrix ℝ := by
    simp only [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix,Matrix.mul_assoc]
  rw [hm,arm_gram,side_gram,SimpleGraph.transpose_adjMatrix]
  rfl

def corePinEquiv : Pin G L s (leftCoreMiddle G L s) ≃ Pin G L s (rightCoreMiddle G L s) where
  toFun p := ⟨⟨swapSides G L s p.1.1,swapSides G L s p.1.2⟩,
    congrArg (fun r : Roots (W := W) s => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  invFun p := ⟨⟨swapSides G L s p.1.1,swapSides G L s p.1.2⟩,
    congrArg (fun r : Roots (W := W) s => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma right_core_pin_card : (Nat.card (Pin G L s (rightCoreMiddle G L s)):ℝ)=
    ThreeHubKernel.middlePin (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [←Nat.card_congr (corePinEquiv G L s)]
  exact left_core_pin_card G L s

lemma hom_coreMiddle (hs : 1 ≤ s) (p : Full G L s) (i : Fin 2) :
    hom G L s hs p (RootedSubdivision.middle (ThreeHub.base s)
      (BalancedTree.edge (.inl i)))=coreMiddle G L s p i := by
  rw [hom_middle,edgeValue_edge]
  rfl

variable [Nonempty W]
/-- Finite core-middle pin counts, under original freeness, satisfy the
nonsharp `s/(2*s+2)` degree threshold. -/
theorem left_core_pin_sq_mul_degree_le (M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Pin G L s (leftCoreMiddle G L s)):ℝ)^2*d^(4*s+4) ≤
      (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+2)*K^(4*s+4)*
        (Fintype.card W:ℝ)^(2*s)*(Nat.card (Agreement G L s):ℝ)^2 := by
  rw [left_core_pin_card,agreement_card]
  exact ThreeHubKernel.free_masked_middlePin_sq_mul_degree_le G s M hs hf L d K
    hL hd hK hdK hmin hmax hcut

theorem right_core_pin_sq_mul_degree_le (M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Pin G L s (rightCoreMiddle G L s)):ℝ)^2*d^(4*s+4) ≤
      (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+2)*K^(4*s+4)*
        (Fintype.card W:ℝ)^(2*s)*(Nat.card (Agreement G L s):ℝ)^2 := by
  rw [←Nat.card_congr (corePinEquiv G L s)]
  exact left_core_pin_sq_mul_degree_le G L s M hs hf d K hL hd hK hdK hmin hmax hcut

end Erdos571.ThreeHubAssignments

/-! Nonnegative moment interpolation and the two deleted-arm energies.
These estimates retain all zero cases and do not assert injective copies. -/
set_option maxHeartbeats 3000000
namespace Erdos571.WeightedPowerMoments
open Finset
variable {I : Type*} [Fintype I]

/-- The moment interpolation inequality requires no positive summand. -/
theorem interpolation_nonneg (w t : I → ℝ) (hw : ∀ i, 0 ≤ w i)
    (ht : ∀ i, 0 ≤ t i) (s : ℕ) (hs : 1 ≤ s) :
    moment w t (s-1)^s ≤ moment w t 0*moment w t s^(s-1) := by
  by_cases hp : ∃ i, 0 < w i ∧ 0 < t i
  · exact interpolation w t hw ht hp s hs
  by_cases hs1 : s=1
  · subst s; simp
  have hz : moment w t (s-1)=0 := by
    apply sum_eq_zero
    intro i _
    by_cases hw0 : w i=0
    · simp [hw0]
    have ht0 : t i=0 := by
      by_contra ht0
      exact hp ⟨i,lt_of_le_of_ne (hw i) (Ne.symm hw0),lt_of_le_of_ne (ht i) (Ne.symm ht0)⟩
    simp [ht0,show s-1≠0 by omega]
  rw [hz,zero_pow (by omega : s≠0)]
  exact mul_nonneg (nonneg w t hw ht 0) (pow_nonneg (nonneg w t hw ht s) _)

end Erdos571.WeightedPowerMoments

namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def centralMoment (A Q : Matrix U U ℝ) (s k : ℕ) : ℝ :=
  ∑ u, ∑ v, (Q u v)^k*(chain A (entryPower Q s) u v)^2

noncomputable def endpointMoment (A Q : Matrix U U ℝ) (s k : ℕ) : ℝ :=
  ∑ u, ∑ v, (Q u v)^s*chain A (entryPower Q s) u v*chain A (entryPower Q k) u v

lemma centralMoment_self (A Q : Matrix U U ℝ) (s : ℕ) :
    centralMoment A Q s s=energy A (entryPower Q s) := rfl

lemma endpointMoment_self (A Q : Matrix U U ℝ) (s : ℕ) :
    endpointMoment A Q s s=energy A (entryPower Q s) := by
  simp only [endpointMoment,energy,entryPower,pow_two,mul_assoc]

lemma endpointMoment_nonneg (A Q : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v) (s k : ℕ) :
    0 ≤ endpointMoment A Q s k := by
  exact sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
    mul_nonneg (mul_nonneg (pow_nonneg (hQ u v) _)
      (chain_nonnegative A _ hA (fun x y => pow_nonneg (hQ x y) _) u v))
      (chain_nonnegative A _ hA (fun x y => pow_nonneg (hQ x y) _) u v)))

lemma centralMoment_zero (A Q : Matrix U U ℝ) (s : ℕ) :
    centralMoment A Q s 0=squareMass (chain A (entryPower Q s)) := by
  simp only [centralMoment,pow_zero,one_mul,squareMass]

lemma conjugation_inner_swap (X K L : Matrix U U ℝ) (hs : X.IsSymm) :
    (∑ u, ∑ v, K u v*(X*L*X) u v) =
      ∑ u, ∑ v, (X*K*X) u v*L u v := by
  rw [inner_trace,inner_trace]
  simp only [Matrix.transpose_mul,hs.eq]
  simpa only [Matrix.mul_assoc] using
    Matrix.trace_mul_cycle K (X*L.transpose) X

lemma endpointMoment_as_moment (A Q : Matrix U U ℝ) (hs : A.IsSymm) (s k : ℕ) :
    endpointMoment A Q s k=WeightedPowerMoments.moment
      (fun p : U×U => chain A (fun u v => (Q u v)^s*chain A (entryPower Q s) u v) p.1 p.2)
      (fun p => Q p.1 p.2) k := by
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul,hs.eq]
  have h := conjugation_inner_swap (A*A)
    (fun u v => (Q u v)^s*chain A (entryPower Q s) u v) (entryPower Q k) hAA
  simpa only [endpointMoment,chain,WeightedPowerMoments.moment,Fintype.sum_prod_type,entryPower] using h

/-- Deleting an arm from the central bundle interpolates between its zeroth
moment and the full three-hub energy. -/
theorem centralMoment_interpolation (A Q : Matrix U U ℝ)
    (hQ : ∀ u v, 0 ≤ Q u v) (s : ℕ) (hs : 1 ≤ s) :
    centralMoment A Q s (s-1)^s ≤
      centralMoment A Q s 0*(energy A (entryPower Q s))^(s-1) := by
  have h := WeightedPowerMoments.interpolation_nonneg
    (fun p : U×U => (chain A (entryPower Q s) p.1 p.2)^2)
    (fun p => Q p.1 p.2) (fun _ => sq_nonneg _) (fun p => hQ p.1 p.2) s hs
  simpa only [WeightedPowerMoments.moment,Fintype.sum_prod_type,mul_comm,centralMoment,
    energy,entryPower] using h

/-- The endpoint moment uses a nonnegative, conjugated weight. -/
theorem endpointMoment_interpolation (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v) (s : ℕ) (hs : 1 ≤ s) :
    endpointMoment A Q s (s-1)^s ≤
      endpointMoment A Q s 0*(energy A (entryPower Q s))^(s-1) := by
  rw [←endpointMoment_self A Q s]
  simp_rw [endpointMoment_as_moment A Q hsym]
  apply WeightedPowerMoments.interpolation_nonneg
  · intro p
    exact chain_nonnegative A _ hA (fun u v =>
      mul_nonneg (pow_nonneg (hQ u v) _) (chain_nonnegative A _ hA
        (fun x y => pow_nonneg (hQ x y) _) u v)) p.1 p.2
  · intro p; exact hQ p.1 p.2
  · exact hs

end Erdos571.ThreeHubKernel


/-! Frobenius bounds from nonnegative Gram row sums. -/
namespace Erdos571.GramPin
open Finset Matrix
variable {I J R : Type*} [Fintype I] [Fintype J] [Fintype R]

lemma squareMass_transpose (B : Matrix I J ℝ) : squareMass B.transpose=squareMass B := by
  simp only [squareMass,Matrix.transpose_apply]
  exact sum_comm

lemma squareMass_mul_left_le (A : Matrix I J ℝ) (B : Matrix J R ℝ)
    (C : ℝ) (hC : 0 ≤ C) (hn : ∀ i j, 0 ≤ (A*A.transpose) i j)
    (hr : ∀ i, ∑ j, (A*A.transpose) i j ≤ C) :
    squareMass (A*B) ≤ C*squareMass B := by
  calc
    _ = ∑ r, ∑ i, ((A*B) i r)^2 := sum_comm
    _ ≤ ∑ r, C*∑ j, (B j r)^2 := by
      apply sum_le_sum
      intro r _
      exact row_gram_operator_bound A C hC hn hr (fun j => B j r)
    _ = _ := by
      rw [←mul_sum]
      congr 1
      exact sum_comm

lemma squareMass_mul_right_le (A : Matrix I J ℝ) (B : Matrix J R ℝ)
    (C : ℝ) (hC : 0 ≤ C) (hn : ∀ i j, 0 ≤ (B.transpose*B) i j)
    (hr : ∀ i, ∑ j, (B.transpose*B) i j ≤ C) :
    squareMass (A*B) ≤ C*squareMass A := by
  have h := squareMass_mul_left_le B.transpose A.transpose C hC
    (by simpa only [Matrix.transpose_transpose] using hn)
    (by simpa only [Matrix.transpose_transpose] using hr)
  rw [←Matrix.transpose_mul,squareMass_transpose,squareMass_transpose] at h
  exact h

variable {U : Type*} [Fintype U]

/-- A symmetric nonnegative matrix with row sums bounded by D has squared
Frobenius operator norm at most D squared, on either side. -/
lemma squareMass_conjugation_le (A K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (D : ℝ) (hD : 0 ≤ D)
    (hrow : ∀ u, ∑ v, A u v ≤ D) :
    squareMass (A*K*A) ≤ D^4*squareMass K := by
  have hn : ∀ u v, 0 ≤ (A*A) u v := GramFeatures.chain_nonneg hA hA
  have hr : ∀ u, ∑ v, (A*A) u v ≤ D^2 := by
    intro u
    simpa only [pow_two] using GramFeatures.chain_row_upper hA hD hrow hrow u
  have hl := squareMass_mul_left_le A K (D^2) (sq_nonneg D)
    (by simpa only [hs.eq] using hn) (by simpa only [hs.eq] using hr)
  have hh := squareMass_mul_right_le (A*K) A (D^2) (sq_nonneg D)
    (by simpa only [hs.eq] using hn) (by simpa only [hs.eq] using hr)
  calc
    _ ≤ D^2*squareMass (A*K) := hh
    _ ≤ D^2*(D^2*squareMass K) := mul_le_mul_of_nonneg_left hl (sq_nonneg D)
    _ = _ := by ring

lemma squareMass_le_cap_mass (K : Matrix U U ℝ) (hK : ∀ u v, 0 ≤ K u v)
    (B : ℝ) (hcap : ∀ u v, K u v ≤ B) :
    squareMass K ≤ B*(∑ u, ∑ v, K u v) := by
  simp only [squareMass,mul_sum]
  exact sum_le_sum (fun u _ => sum_le_sum (fun v _ => by
    simpa only [pow_two] using mul_le_mul_of_nonneg_right (hcap u v) (hK u v)))

end Erdos571.GramPin


/-! Mass-sensitive deleted-arm bounds for the three-hub kernel. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

lemma sandwich_ones (X Q : Matrix U U ℝ) (u v : U) :
    (X*entryPower Q 0*X) u v=(∑ x, X u x)*(∑ y, X y v) := by
  simp only [Matrix.mul_apply,entryPower,pow_zero,mul_one,mul_sum]

lemma chain_ones_bound (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (D : ℝ) (hD : 0 ≤ D)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (u v : U) :
    chain A (entryPower Q 0) u v ≤ D^4 := by
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul,hsym.eq]
  have hr (x : U) : ∑ y, (A*A) x y ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hA hD hrow hrow x
  have hc (y : U) : ∑ x, (A*A) x y ≤ D^2 := by
    simpa only [hAA.apply y] using hr y
  change ((A*A)*entryPower Q 0*(A*A)) u v ≤ _
  rw [sandwich_ones]
  have h := mul_le_mul (hr u) (hc v)
    (sum_nonneg (fun x _ => chain_nonneg hA hA x v)) (sq_nonneg D)
  convert h using 1 <;> ring

lemma endpointMoment_zero_bound (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (D : ℝ) (hD : 0 ≤ D) (hrow : ∀ u, ∑ v, A u v ≤ D) :
    endpointMoment A Q s 0 ≤ D^4*twoEnergy A (entryPower Q s) := by
  rw [twoEnergy_eq_inner A _ hsym]
  simp only [endpointMoment,mul_sum]
  apply sum_le_sum
  intro u _
  apply sum_le_sum
  intro v _
  calc
    _ ≤ (Q u v)^s*chain A (entryPower Q s) u v*D^4 :=
      mul_le_mul_of_nonneg_left (chain_ones_bound A Q hsym hA D hD hrow u v)
        (mul_nonneg (pow_nonneg (hQ u v) _) (chain_nonnegative A _ hA
          (fun x y => pow_nonneg (hQ x y) _) u v))
    _ = _ := by dsimp [entryPower]; ring

lemma centralMoment_zero_bound (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (D T : ℝ) (hD : 0 ≤ D)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hcap : ∀ u v, Q u v ≤ T) :
    centralMoment A Q s 0 ≤ D^8*T^s*(∑ u, ∑ v, entryPower Q s u v) := by
  have hAA : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul,hsym.eq]
  have hr (u : U) : ∑ v, (A*A) u v ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hA hD hrow hrow u
  have h := squareMass_conjugation_le (A*A) (entryPower Q s) hAA
    (chain_nonneg hA hA) (D^2) (sq_nonneg D) hr
  have hk := squareMass_le_cap_mass (entryPower Q s)
    (fun u v => pow_nonneg (hQ u v) s) (T^s)
    (fun u v => pow_le_pow_left₀ (hQ u v) (hcap u v) s)
  rw [centralMoment_zero]
  calc
    _ ≤ (D^2)^4*squareMass (entryPower Q s) := h
    _ ≤ (D^2)^4*(T^s*(∑ u, ∑ v, entryPower Q s u v)) :=
      mul_le_mul_of_nonneg_left hk (by positivity)
    _ = _ := by ring

/-- The endpoint-deleted energy is bounded relative to the full energy,
with one power of the arm-kernel mass retained. -/
theorem endpointMoment_deleted_mul_mass_le (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (d D : ℝ) (hd : 0 ≤ d) (hD : 0 ≤ D)
    (hmin : ∀ u, d ≤ ∑ v, A u v) (hmax : ∀ u, ∑ v, A u v ≤ D) :
    endpointMoment A Q s (s-1)^s*d^4*(∑ u, ∑ v, entryPower Q s u v) ≤
      D^4*(Fintype.card U:ℝ)^2*(energy A (entryPower Q s))^s := by
  let K := entryPower Q s
  let E := energy A K
  let m := ∑ u, ∑ v, K u v
  have hK : ∀ u v, 0 ≤ K u v := fun u v => pow_nonneg (hQ u v) s
  have hE : 0 ≤ E := energy_nonneg A K hK
  have hm : 0 ≤ m := sum_nonneg (fun u _ => sum_nonneg (fun v _ => hK u v))
  have hi := endpointMoment_interpolation A Q hsym hA hQ s hs
  have h₀ := endpointMoment_zero_bound A Q hsym hA hQ s D hD hmax
  have hb : endpointMoment A Q s (s-1)^s ≤ D^4*twoEnergy A K*E^(s-1) :=
    hi.trans (mul_le_mul_of_nonneg_right h₀ (pow_nonneg hE _))
  have hz := twoEnergy_mul_mass_le A K hsym hA hK d hd hmin
  calc
    _ ≤ (D^4*twoEnergy A K*E^(s-1))*d^4*m :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hb (pow_nonneg hd _)) hm
    _ = D^4*E^(s-1)*(twoEnergy A K*d^4*m) := by ring
    _ ≤ D^4*E^(s-1)*((Fintype.card U:ℝ)^2*E) :=
      mul_le_mul_of_nonneg_left hz (by positivity)
    _ = _ := by
      have he : E^(s-1)*E=E^s := by rw [←pow_succ,Nat.sub_add_cancel hs]
      change _ = D^4*(Fintype.card U:ℝ)^2*E^s
      rw [←he]
      ring

/-- Two powers of the mass are retained for a central deleted arm.
The Perron inequality already includes the zero-mass case. -/
theorem centralMoment_deleted_mul_mass_le (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (d D T : ℝ) (hd : 0 ≤ d) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hmin : ∀ u, d ≤ ∑ v, A u v) (hmax : ∀ u, ∑ v, A u v ≤ D)
    (hcap : ∀ u v, Q u v ≤ T) :
    centralMoment A Q s (s-1)^s*d^8*(∑ u, ∑ v, entryPower Q s u v)^2 ≤
      D^8*T^s*(Fintype.card U:ℝ)^4*(energy A (entryPower Q s))^s := by
  let K := entryPower Q s
  let E := energy A K
  let m := ∑ u, ∑ v, K u v
  have hK : ∀ u v, 0 ≤ K u v := fun u v => pow_nonneg (hQ u v) s
  have hE : 0 ≤ E := energy_nonneg A K hK
  have hi := centralMoment_interpolation A Q hQ s hs
  have h₀ := centralMoment_zero_bound A Q hsym hA hQ s D T hD hmax hcap
  have hb : centralMoment A Q s (s-1)^s ≤ D^8*T^s*m*E^(s-1) :=
    hi.trans (mul_le_mul_of_nonneg_right h₀ (pow_nonneg hE _))
  have hz := energy_mass_cube_lower A K hsym hA hK d hd hmin
  calc
    _ ≤ (D^8*T^s*m*E^(s-1))*d^8*m^2 :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hb (pow_nonneg hd _)) (sq_nonneg m)
    _ = D^8*T^s*E^(s-1)*(d^8*m^3) := by ring
    _ ≤ D^8*T^s*E^(s-1)*((Fintype.card U:ℝ)^4*E) :=
      mul_le_mul_of_nonneg_left hz (by positivity)
    _ = _ := by
      have he : E^(s-1)*E=E^s := by rw [←pow_succ,Nat.sub_add_cancel hs]
      change _ = D^8*T^s*(Fintype.card U:ℝ)^4*E^s
      rw [←he]
      ring

end Erdos571.ThreeHubKernel


/-! Eliminating the arm mass in the deleted-arm moment estimates. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U] [Nonempty U]

lemma mass_row_cancel_linear (s : ℕ) (hs : 1 ≤ s) (n p b r m c : ℝ)
    (hn : 0 < n) (hp : 0 ≤ p) (hb : 0 ≤ b)
    (hm : n*r^s ≤ n^(s-1)*m) (h : p*b*m ≤ c*n^2) :
    p*b*r^s ≤ c*n^s := by
  have h' := (mul_le_mul_of_nonneg_left hm (mul_nonneg hp hb)).trans
    (by
      have hh := mul_le_mul_of_nonneg_left h (pow_nonneg hn.le (s-1))
      convert hh using 1 <;> ring)
  have he : n^(s-1)*n^2=n^s*n := by
    rw [←pow_add,←pow_succ]
    congr 1
    omega
  apply (mul_le_mul_iff_left₀ hn).mp
  convert h' using 1
  · ring
  · calc
      _ = c*(n^s*n) := by ring
      _ = _ := by rw [←he]; ring

lemma mass_row_cancel_quadratic (s : ℕ) (hs : 1 ≤ s) (n p b r m c : ℝ)
    (hn : 0 < n) (hp : 0 ≤ p) (hb : 0 ≤ b) (hr : 0 ≤ r)
    (hm : n*r^s ≤ n^(s-1)*m) (h : p*b*m^2 ≤ c*n^4) :
    p*b*r^(2*s) ≤ c*n^(2*s) := by
  have hm2 := pow_le_pow_left₀ (mul_nonneg hn.le (pow_nonneg hr s)) hm 2
  have h' := (mul_le_mul_of_nonneg_left hm2 (mul_nonneg hp hb)).trans
    (by
      have hh := mul_le_mul_of_nonneg_left h (sq_nonneg (n^(s-1)))
      convert hh using 1 <;> ring)
  have he : (n^(s-1))^2*n^4=n^(2*s)*n^2 := by
    simp only [←pow_mul,←pow_add]
    congr 1
    omega
  have her : (r^s)^2=r^(2*s) := by rw [←pow_mul,Nat.mul_comm s 2]
  apply (mul_le_mul_iff_left₀ (sq_pos_of_pos hn)).mp
  convert h' using 1
  · rw [mul_pow,her]; ring
  · calc
      _ = c*(n^(2*s)*n^2) := by ring
      _ = _ := by rw [←he]; ring

/-- Row-mass version of the endpoint deletion bound. -/
theorem endpointMoment_deleted_mul_row_le (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (d D r : ℝ) (hd : 0 ≤ d) (hD : 0 ≤ D) (hr : 0 ≤ r)
    (hmin : ∀ u, d ≤ ∑ v, A u v) (hmax : ∀ u, ∑ v, A u v ≤ D)
    (hQr : ∀ u, r ≤ ∑ v, Q u v) :
    endpointMoment A Q s (s-1)^s*d^4*r^s ≤
      D^4*(Fintype.card U:ℝ)^s*(energy A (entryPower Q s))^s := by
  have hn : 0 < (Fintype.card U:ℝ) := by exact_mod_cast Fintype.card_pos (α := U)
  have hm := entryPower_mass_lower Q hQ s hs r hr hQr
  have h := endpointMoment_deleted_mul_mass_le A Q hsym hA hQ s hs d D hd hD hmin hmax
  have hh := mass_row_cancel_linear s hs (Fintype.card U:ℝ)
    (endpointMoment A Q s (s-1)^s) (d^4) r (∑ u, ∑ v, entryPower Q s u v)
    (D^4*(energy A (entryPower Q s))^s) hn
    (pow_nonneg (endpointMoment_nonneg A Q hA hQ s (s-1)) _) (pow_nonneg hd _) hm
    (by convert h using 1 <;> ring)
  convert hh using 1 <;> ring

/-- Row-mass version of central deletion, with two powers of the arm mass. -/
theorem centralMoment_deleted_mul_row_le (A Q : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (s : ℕ) (hs : 1 ≤ s) (d D T r : ℝ) (hd : 0 ≤ d) (hD : 0 ≤ D)
    (hT : 0 ≤ T) (hr : 0 ≤ r)
    (hmin : ∀ u, d ≤ ∑ v, A u v) (hmax : ∀ u, ∑ v, A u v ≤ D)
    (hcap : ∀ u v, Q u v ≤ T) (hQr : ∀ u, r ≤ ∑ v, Q u v) :
    centralMoment A Q s (s-1)^s*d^8*r^(2*s) ≤
      D^8*T^s*(Fintype.card U:ℝ)^(2*s)*(energy A (entryPower Q s))^s := by
  have hn : 0 < (Fintype.card U:ℝ) := by exact_mod_cast Fintype.card_pos (α := U)
  have hm := entryPower_mass_lower Q hQ s hs r hr hQr
  have h := centralMoment_deleted_mul_mass_le A Q hsym hA hQ s hs d D T hd hD hT hmin hmax hcap
  have hp : 0 ≤ centralMoment A Q s (s-1)^s := by
    apply pow_nonneg
    exact sum_nonneg (fun u _ => sum_nonneg (fun v _ => mul_nonneg
      (pow_nonneg (hQ u v) _) (sq_nonneg _)))
  have hh := mass_row_cancel_quadratic s hs (Fintype.card U:ℝ)
    (centralMoment A Q s (s-1)^s) (d^8) r (∑ u, ∑ v, entryPower Q s u v)
    (D^8*T^s*(energy A (entryPower Q s))^s) hn hp (pow_nonneg hd _) hr hm
    (by convert h using 1 <;> ring)
  convert hh using 1 <;> ring

end Erdos571.ThreeHubKernel


/-! Actual ThreeHub freeness supplies the masked-arm inputs for deletion.
No global codegree cap is assumed. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix SimpleGraph GramPin GramFeatures

lemma cancel_deleted_endpoint_scale (s : ℕ) (p E n K d : ℝ) (hd : 0 < d)
    (h : p*d^4*(d^4/4)^s ≤ (K*d)^4*n^s*E^s) :
    p*d^(4*s) ≤ (4:ℝ)^s*K^4*n^s*E^s := by
  have he : d^4*(d^4/4)^s*(4:ℝ)^s=d^(4*s)*d^4 := by
    rw [div_pow]
    field_simp
    simp only [←pow_mul,←pow_add]
  have hh := mul_le_mul_of_nonneg_right h (by positivity : 0 ≤ (4:ℝ)^s)
  apply (mul_le_mul_iff_left₀ (pow_pos hd 4)).mp
  convert hh using 1
  · calc
      _ = p*(d^(4*s)*d^4) := by ring
      _ = _ := by rw [←he]; ring
  · ring

lemma cancel_deleted_central_scale (s : ℕ) (p E n C K d : ℝ) (hd : 0 < d)
    (h : p*d^8*(d^4/4)^(2*s) ≤ (K*d)^8*(C*(K*d)^2)^s*n^(2*s)*E^s) :
    p*d^(6*s) ≤ (16:ℝ)^s*C^s*K^(2*s+8)*n^(2*s)*E^s := by
  have h16 : (4:ℝ)^(2*s)=(16:ℝ)^s := by rw [pow_mul]; norm_num
  have he₁ : d^8*(d^4/4)^(2*s)*(16:ℝ)^s=d^(6*s)*d^(2*s+8) := by
    rw [←h16,div_pow]
    field_simp
    simp only [←pow_mul,←pow_add]
    congr 1
    omega
  have he₂ : (K*d)^8*(C*(K*d)^2)^s=C^s*K^(2*s+8)*d^(2*s+8) := by
    simp only [mul_pow,←pow_mul]
    rw [show 2*s+8=8+2*s by omega,pow_add,pow_add]
    ring
  have hh := mul_le_mul_of_nonneg_right h (by positivity : 0 ≤ (16:ℝ)^s)
  apply (mul_le_mul_iff_left₀ (pow_pos hd (2*s+8))).mp
  convert hh using 1
  · calc
      _ = p*(d^(6*s)*d^(2*s+8)) := by ring
      _ = _ := by rw [←he₁]; ring
  · rw [he₂]; ring

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma adjacency_row_sum (u : W) : ∑ v, G.adjMatrix ℝ u v=(G.degree u:ℝ) := by
  simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
    (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))

/-- A reusable pair of light-arm inputs: the Gram row lower bound and
entry cap supplied by the actual forbidden graph. -/
theorem free_masked_arm_mass_cap (s M : ℕ) (hf : (ThreeHub.graph s M).Free G)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    let N := LightArmKernel.matrix G L
    (∀ u, d^4/4 ≤ ∑ v, (N*N.transpose) u v) ∧
    ∀ u v, (N*N.transpose) u v ≤ ThreeHub.momentCoefficient s M*(K*d)^2 := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let C := ThreeHub.momentCoefficient s M
  let T := C*(K*d)^2
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hK0 : 0 ≤ K := by linarith
  have hmoment (u : W) : ∑ v, ((A*A) u v)^2 ≤ T :=
    ThreeHub.free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK0 hd.le) hmax u
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hmoment
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  constructor
  · intro u
    have hNs : N.transpose=N := (LightArmKernel.isSymm G L).eq
    have h := chain_row_lower (LightArmKernel.nonneg G L) (by positivity : 0 ≤ d^2/2)
      hNrow hNrow u
    change d^4/4 ≤ ∑ v, (N*N.transpose) u v
    rw [hNs]
    convert h using 1 <;> ring
  · exact LightArmKernel.gram_upper G L T hT hmoment

variable [Nonempty W]

/-- Endpoint deletion costs at most a constant times n/d^4, expressed
polynomially so that zero energies require no division. -/
theorem free_masked_endpointMoment_deleted (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    let A := G.adjMatrix ℝ
    let N := LightArmKernel.matrix G L
    let Q := N*N.transpose
    endpointMoment A Q s (s-1)^s*d^(4*s) ≤
      (4:ℝ)^s*K^4*(Fintype.card W:ℝ)^s*(energy A (entryPower Q s))^s := by
  dsimp only
  have hA : ∀ u v, 0 ≤ G.adjMatrix ℝ u v := by
    intro u v; simp only [SimpleGraph.adjMatrix_apply]; split_ifs <;> norm_num
  have hin := free_masked_arm_mass_cap G s M hf L d K hL hd hK hdK hmin hmax hcut
  have h := endpointMoment_deleted_mul_row_le (G.adjMatrix ℝ)
    (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose)
    G.isSymm_adjMatrix hA (LightArmKernel.gram_nonneg G L) s hs d (K*d) (d^4/4)
    hd.le (by positivity) (by positivity)
    (by intro u; rw [adjacency_row_sum]; exact hmin u)
    (by intro u; rw [adjacency_row_sum]; exact hmax u) hin.1
  exact cancel_deleted_endpoint_scale s _ _ _ K d hd h

/-- Central deletion costs at most a constant times n^2/d^6. This
estimate has the original freeness hypothesis, not a global codegree cap. -/
theorem free_masked_centralMoment_deleted (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    let A := G.adjMatrix ℝ
    let N := LightArmKernel.matrix G L
    let Q := N*N.transpose
    centralMoment A Q s (s-1)^s*d^(6*s) ≤
      (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^s*K^(2*s+8)*
        (Fintype.card W:ℝ)^(2*s)*(energy A (entryPower Q s))^s := by
  dsimp only
  have hA : ∀ u v, 0 ≤ G.adjMatrix ℝ u v := by
    intro u v; simp only [SimpleGraph.adjMatrix_apply]; split_ifs <;> norm_num
  have hin := free_masked_arm_mass_cap G s M hf L d K hL hd hK hdK hmin hmax hcut
  have hC : 0 ≤ ThreeHub.momentCoefficient s M := ThreeHub.momentCoefficient_nonneg s M
  have h := centralMoment_deleted_mul_row_le (G.adjMatrix ℝ)
    (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose)
    G.isSymm_adjMatrix hA (LightArmKernel.gram_nonneg G L) s hs d (K*d)
    (ThreeHub.momentCoefficient s M*(K*d)^2) (d^4/4) hd.le (by positivity)
    (by positivity) (by positivity)
    (by intro u; rw [adjacency_row_sum]; exact hmin u)
    (by intro u; rw [adjacency_row_sum]; exact hmax u) hin.2 hin.1
  exact cancel_deleted_central_scale s _ _ _ (ThreeHub.momentCoefficient s M) K d hd h

end Erdos571.ThreeHubKernel


/-! Three independently indexed light-arm bundles and their exact energies.
The finite assignments here may repeat vertices. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev Roots (I J K : Type) := (I → W) × ((J → W) × (K → W))
abbrev Side (I : Type) (x : W) (r : I → W) :=
  (u : W) × (G.commonNeighbors x u × MaskedBush.Bundle G L I u r)
abbrev At (I J K : Type) (r : Roots (W := W) I J K) (x : W) :=
  MaskedBush.Bundle G L I x r.1 × (Side G L J x r.2.1 × Side G L K x r.2.2)
abbrev Fiber (I J K : Type) (r : Roots (W := W) I J K) := (x : W) × At G L I J K r x
abbrev Full (I J K : Type) := (r : Roots (W := W) I J K) × Fiber G L I J K r
abbrev Agreement (I J K : Type) := FiberRestrictionEnergy.Agreement (Fiber G L I J K)

variable {I J K : Type} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

noncomputable instance sideFintype (x : W) (r : I → W) : Fintype (Side G L I x r) := by
  classical
  infer_instance
noncomputable instance fiberFintype (r : Roots (W := W) I J K) : Fintype (Fiber G L I J K r) := by
  classical
  infer_instance

noncomputable def armFeature (I : Type) [Fintype I] [DecidableEq I] : Matrix W (I → W) ℝ :=
  ArmTensor.tensor (LightArmKernel.matrix G L) I
noncomputable def sideFeature (I : Type) [Fintype I] [DecidableEq I] : Matrix W (I → W) ℝ :=
  (G.adjMatrix ℝ * G.adjMatrix ℝ)*armFeature G L I

lemma card_side (x : W) (r : I → W) :
    (Fintype.card (Side G L I x r):ℝ)=sideFeature G L I x r := by
  classical
  simp only [Side,Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,
    MaskedBush.card_bundle,sideFeature,Matrix.mul_apply,armFeature]
  apply sum_congr rfl
  intro u _
  rw [←LayeredBush.adjacency_square_common_card]
  rfl

lemma card_at (r : Roots (W := W) I J K) (x : W) :
    (Fintype.card (At G L I J K r x):ℝ)=
      armFeature G L I x r.1*sideFeature G L J x r.2.1*sideFeature G L K x r.2.2 := by
  classical
  simp only [At,Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_side,armFeature]
  ring

lemma card_fiber (r : Roots (W := W) I J K) :
    (Fintype.card (Fiber G L I J K r):ℝ)=
      ∑ x, armFeature G L I x r.1*sideFeature G L J x r.2.1*sideFeature G L K x r.2.2 := by
  classical
  simp only [Fiber,Fintype.card_sigma,Nat.cast_sum,card_at]

lemma arm_gram (I : Type) [Fintype I] [DecidableEq I] : armFeature G L I*(armFeature G L I).transpose =
    entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card I) := by
  ext u v
  exact ArmTensor.gram (LightArmKernel.matrix G L) I u v

lemma side_gram (I : Type) [Fintype I] [DecidableEq I] : sideFeature G L I*(sideFeature G L I).transpose =
    ThreeHubKernel.chain (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card I)) := by
  simp only [sideFeature,Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix,Matrix.mul_assoc]
  rw [←Matrix.mul_assoc (armFeature G L I),arm_gram]
  simp only [ThreeHubKernel.chain,Matrix.mul_assoc]

open Classical in
lemma agreement_card (I J K : Type) [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K] :
    (Nat.card (Agreement G L I J K):ℝ)=
      let A := G.adjMatrix ℝ
      let N := LightArmKernel.matrix G L
      let Q := N*N.transpose
      ∑ u, ∑ v, Q u v^(Fintype.card I)*
        ThreeHubKernel.chain A (entryPower Q (Fintype.card J)) u v*
        ThreeHubKernel.chain A (entryPower Q (Fintype.card K)) u v := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G L I J K)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,
    card_fiber,Fintype.sum_prod_type]
  rw [ArmTensor.triple_mixed_total,arm_gram,side_gram,side_gram]
  rfl

lemma central_deleted_card (s : ℕ) (i : Fin s) :
    (Nat.card (Agreement G L (MaskedBush.Without i) (Fin s) (Fin s)):ℝ)=
      ThreeHubKernel.centralMoment (G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s (s-1) := by
  rw [agreement_card]
  simp only [MaskedBush.card_without,Fintype.card_fin,ThreeHubKernel.centralMoment,pow_two,mul_assoc]

lemma left_deleted_card (s : ℕ) (i : Fin s) :
    (Nat.card (Agreement G L (Fin s) (MaskedBush.Without i) (Fin s)):ℝ)=
      ThreeHubKernel.endpointMoment (G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s (s-1) := by
  rw [agreement_card]
  simp only [MaskedBush.card_without,Fintype.card_fin,ThreeHubKernel.endpointMoment]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  ring

lemma right_deleted_card (s : ℕ) (i : Fin s) :
    (Nat.card (Agreement G L (Fin s) (Fin s) (MaskedBush.Without i)):ℝ)=
      ThreeHubKernel.endpointMoment (G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s (s-1) := by
  rw [agreement_card]
  simp only [MaskedBush.card_without,Fintype.card_fin,ThreeHubKernel.endpointMoment]

/-- At equal bundle sizes, this is definitionally the earlier full family. -/
lemma symmetric_agreement (s : ℕ) : Agreement G L (Fin s) (Fin s) (Fin s)=ThreeHubAssignments.Agreement G L s := rfl

variable [Nonempty W]

/-- Exact finite endpoint-deleted agreement bounds under original freeness. -/
theorem left_deleted_bound (s M : ℕ) (hs : 1 ≤ s) (i : Fin s)
    (hf : (ThreeHub.graph s M).Free G) (d K L : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Agreement G L (Fin s) (MaskedBush.Without i) (Fin s)):ℝ)^s*d^(4*s) ≤
      (4:ℝ)^s*K^4*(Fintype.card W:ℝ)^s*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ)^s := by
  rw [left_deleted_card,ThreeHubAssignments.agreement_card]
  exact ThreeHubKernel.free_masked_endpointMoment_deleted G s M hs hf L d K hL hd hK hdK hmin hmax hcut

theorem right_deleted_bound (s M : ℕ) (hs : 1 ≤ s) (i : Fin s)
    (hf : (ThreeHub.graph s M).Free G) (d K L : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Agreement G L (Fin s) (Fin s) (MaskedBush.Without i)):ℝ)^s*d^(4*s) ≤
      (4:ℝ)^s*K^4*(Fintype.card W:ℝ)^s*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ)^s := by
  rw [right_deleted_card,ThreeHubAssignments.agreement_card]
  exact ThreeHubKernel.free_masked_endpointMoment_deleted G s M hs hf L d K hL hd hK hdK hmin hmax hcut

/-- The central-deleted count also has a polynomial bound without any
positivity assumption on either agreement cardinality. -/
theorem central_deleted_bound (s M : ℕ) (hs : 1 ≤ s) (i : Fin s)
    (hf : (ThreeHub.graph s M).Free G) (d K L : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (Agreement G L (MaskedBush.Without i) (Fin s) (Fin s)):ℝ)^s*d^(6*s) ≤
      (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^s*K^(2*s+8)*(Fintype.card W:ℝ)^(2*s)*
        (Nat.card (ThreeHubAssignments.Agreement G L s):ℝ)^s := by
  rw [central_deleted_card,ThreeHubAssignments.agreement_card]
  exact ThreeHubKernel.free_masked_centralMoment_deleted G s M hs hf L d K hL hd hK hdK hmin hmax hcut

end Erdos571.ThreeHubMixed


/-! Deleting one terminal arm preserves the remaining labels and all core
roles. A deleted arm is reconstructed from its root and middle values. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

def center (p : Full G L I J K) : W := p.2.1
def leftHub (p : Full G L I J K) : W := p.2.2.2.1.1
def rightHub (p : Full G L I J K) : W := p.2.2.2.2.1
def leftCoreMiddle (p : Full G L I J K) : W := p.2.2.2.1.2.1.val
def rightCoreMiddle (p : Full G L I J K) : W := p.2.2.2.2.2.1.val
def centralRoot (p : Full G L I J K) (i : I) : W := p.1.1 i
def centralMiddle (p : Full G L I J K) (i : I) : W := MaskedBush.middle G L (p.2.2.1 i)
lemma central_hub_adj_middle (p : Full G L I J K) (i : I) :
    G.Adj (center G L p) (centralMiddle G L p i) := MaskedBush.arm_left G L (p.2.2.1 i)
lemma central_middle_adj_root (p : Full G L I J K) (i : I) :
    G.Adj (centralMiddle G L p i) (centralRoot G L p i) := MaskedBush.arm_right G L (p.2.2.1 i)
lemma central_light (p : Full G L I J K) (i : I) :
    MaskedBush.Light G L (center G L p) (centralRoot G L p i) := MaskedBush.arm_light G L (p.2.2.1 i)

def leftRoot (p : Full G L I J K) (i : J) : W := p.1.2.1 i
def leftMiddle (p : Full G L I J K) (i : J) : W := MaskedBush.middle G L (p.2.2.2.1.2.2 i)
lemma left_hub_adj_middle (p : Full G L I J K) (i : J) :
    G.Adj (leftHub G L p) (leftMiddle G L p i) := MaskedBush.arm_left G L (p.2.2.2.1.2.2 i)
lemma left_middle_adj_root (p : Full G L I J K) (i : J) :
    G.Adj (leftMiddle G L p i) (leftRoot G L p i) := MaskedBush.arm_right G L (p.2.2.2.1.2.2 i)
lemma left_light (p : Full G L I J K) (i : J) :
    MaskedBush.Light G L (leftHub G L p) (leftRoot G L p i) := MaskedBush.arm_light G L (p.2.2.2.1.2.2 i)

def rightRoot (p : Full G L I J K) (i : K) : W := p.1.2.2 i
def rightMiddle (p : Full G L I J K) (i : K) : W := MaskedBush.middle G L (p.2.2.2.2.2.2 i)
lemma right_hub_adj_middle (p : Full G L I J K) (i : K) :
    G.Adj (rightHub G L p) (rightMiddle G L p i) := MaskedBush.arm_left G L (p.2.2.2.2.2.2 i)
lemma right_middle_adj_root (p : Full G L I J K) (i : K) :
    G.Adj (rightMiddle G L p i) (rightRoot G L p i) := MaskedBush.arm_right G L (p.2.2.2.2.2.2 i)
lemma right_light (p : Full G L I J K) (i : K) :
    MaskedBush.Light G L (rightHub G L p) (rightRoot G L p i) := MaskedBush.arm_light G L (p.2.2.2.2.2.2 i)

lemma full_ext (p q : Full G L I J K) (hr : p.1=q.1)
    (hc : center G L p=center G L q)
    (hl : leftHub G L p=leftHub G L q) (hh : rightHub G L p=rightHub G L q)
    (hcl : leftCoreMiddle G L p=leftCoreMiddle G L q)
    (hcr : rightCoreMiddle G L p=rightCoreMiddle G L q)
    (hmc : ∀ i, centralMiddle G L p i=centralMiddle G L q i)
    (hml : ∀ i, leftMiddle G L p i=leftMiddle G L q i)
    (hmr : ∀ i, rightMiddle G L p i=rightMiddle G L q i) : p=q := by
  rcases p with ⟨⟨r,t,a⟩,x,b,⟨u,cm,c⟩,⟨v,dm,e⟩⟩
  rcases q with ⟨⟨r',t',a'⟩,x',b',⟨u',cm',c'⟩,⟨v',dm',e'⟩⟩
  obtain ⟨rfl,hrr⟩ := Prod.mk.inj hr
  obtain ⟨rfl,rfl⟩ := Prod.mk.inj hrr
  change x=x' at hc
  change u=u' at hl
  change v=v' at hh
  subst x'; subst u'; subst v'
  have hb : b=b' := by funext i; exact MaskedBush.arm_ext G L _ _ (hmc i)
  have hc : c=c' := by funext i; exact MaskedBush.arm_ext G L _ _ (hml i)
  have he : e=e' := by funext i; exact MaskedBush.arm_ext G L _ _ (hmr i)
  have hcm : cm=cm' := Subtype.ext hcl
  have hdm : dm=dm' := Subtype.ext hcr
  subst b'; subst c'; subst e'; subst cm'; subst dm'
  rfl

def deleteCentral (i : I) (p : Full G L I J K) : Full G L (MaskedBush.Without i) J K :=
  ⟨(fun k => p.1.1 k.val,p.1.2),p.2.1,(fun k => p.2.2.1 k.val),p.2.2.2⟩

lemma deleteCentral_labels (i : I) (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteCentral G L i p).1=(deleteCentral G L i q).1 :=
  congrArg (fun r : Roots (W := W) I J K => (fun k : MaskedBush.Without i => r.1 k.val,r.2)) hr

lemma deleteCentral_restore (i : I) (p q : Full G L I J K)
    (he : deleteCentral G L i p=deleteCentral G L i q)
    (hr : centralRoot G L p i=centralRoot G L q i)
    (hm : centralMiddle G L p i=centralMiddle G L q i) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · funext k
      by_cases hk : k=i
      · subst k; exact hr
      · exact congrArg (fun r : Roots (W := W) (MaskedBush.Without i) J K => r.1 ⟨k,hk⟩) hlabel
    · apply Prod.ext
      · exact congrArg (fun r : Roots (W := W) (MaskedBush.Without i) J K => r.2.1) hlabel
      · exact congrArg (fun r : Roots (W := W) (MaskedBush.Without i) J K => r.2.2) hlabel
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => center G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftHub G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightHub G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftCoreMiddle G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightCoreMiddle G L t) he
  · intro k
    by_cases hk : k=i
    · subst k; exact hm
    · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => centralMiddle G L t ⟨k,hk⟩) he
  · intro k; exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftMiddle G L t k) he
  · intro k; exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightMiddle G L t k) he

def deleteLeft (i : J) (p : Full G L I J K) : Full G L I (MaskedBush.Without i) K :=
  ⟨(p.1.1,(fun k => p.1.2.1 k.val,p.1.2.2)),p.2.1,p.2.2.1,
    ⟨p.2.2.2.1.1,p.2.2.2.1.2.1,fun k => p.2.2.2.1.2.2 k.val⟩,p.2.2.2.2⟩

lemma deleteLeft_labels (i : J) (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteLeft G L i p).1=(deleteLeft G L i q).1 :=
  congrArg (fun r : Roots (W := W) I J K => (r.1,(fun k : MaskedBush.Without i => r.2.1 k.val,r.2.2))) hr

lemma deleteLeft_restore (i : J) (p q : Full G L I J K)
    (he : deleteLeft G L i p=deleteLeft G L i q)
    (hr : leftRoot G L p i=leftRoot G L q i)
    (hm : leftMiddle G L p i=leftMiddle G L q i) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.1) hlabel
    · apply Prod.ext
      · funext k
        by_cases hk : k=i
        · subst k; exact hr
        · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.2.1 ⟨k,hk⟩) hlabel
      · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.2.2) hlabel
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => center G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftHub G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightHub G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftCoreMiddle G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightCoreMiddle G L t) he
  · intro k; exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => centralMiddle G L t k) he
  · intro k
    by_cases hk : k=i
    · subst k; exact hm
    · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftMiddle G L t ⟨k,hk⟩) he
  · intro k; exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightMiddle G L t k) he

def deleteRight (i : K) (p : Full G L I J K) : Full G L I J (MaskedBush.Without i) :=
  ⟨(p.1.1,(p.1.2.1,fun k => p.1.2.2 k.val)),p.2.1,p.2.2.1,p.2.2.2.1,
    ⟨p.2.2.2.2.1,p.2.2.2.2.2.1,fun k => p.2.2.2.2.2.2 k.val⟩⟩

lemma deleteRight_labels (i : K) (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteRight G L i p).1=(deleteRight G L i q).1 :=
  congrArg (fun r : Roots (W := W) I J K => (r.1,(r.2.1,fun k : MaskedBush.Without i => r.2.2 k.val))) hr

lemma deleteRight_restore (i : K) (p q : Full G L I J K)
    (he : deleteRight G L i p=deleteRight G L i q)
    (hr : rightRoot G L p i=rightRoot G L q i)
    (hm : rightMiddle G L p i=rightMiddle G L q i) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.1) hlabel
    · apply Prod.ext
      · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.2.1) hlabel
      · funext k
        by_cases hk : k=i
        · subst k; exact hr
        · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.2.2 ⟨k,hk⟩) hlabel
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => center G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftHub G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightHub G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftCoreMiddle G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightCoreMiddle G L t) he
  · intro k; exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => centralMiddle G L t k) he
  · intro k; exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftMiddle G L t k) he
  · intro k
    by_cases hk : k=i
    · subst k; exact hm
    · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightMiddle G L t ⟨k,hk⟩) he

end Erdos571.ThreeHubMixed


/-! An interface for deleting a light two-edge root arm, followed by finite
terminal-pin and prescribed-root collision bounds. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmDeletion
open Finset SimpleGraph
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable (F : R → Type) (E : S → Type) [∀ r, Fintype (F r)] [∀ s, Fintype (E s)]

structure Data where
  delete : Sigma F → Sigma E
  root : Sigma F → W
  hub : Sigma E → W
  arm : ∀ p, MaskedBush.Arm G L (hub (delete p)) (root p)
  labels : ∀ p q, p.1=q.1 → (delete p).1=(delete q).1
  roots : ∀ p q, p.1=q.1 → root p=root q
  restore : ∀ p q, delete p=delete q → root p=root q →
    MaskedBush.middle G L (arm p)=MaskedBush.middle G L (arm q) → p=q

variable {G L F E}
variable (D : Data G L F E)

def Data.middle (p : Sigma F) : W := MaskedBush.middle G L (D.arm p)
def hub (p : Sigma F) : W := D.hub (D.delete p)

/-- A terminal pin either pins its retained hub too, or pays one light
common-neighbor factor and one maximum-degree factor after arm deletion. -/
theorem terminal_pin_bound (K : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hK : K.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (RestrictionDeletion.RolePin F D.middle) ≤ (k-1)*
      (Nat.card (RestrictionDeletion.RolePin F (hub D)) +
        (cap*Δ)*Nat.card (FiberRestrictionEnergy.Agreement E)) := by
  classical
  let F' := MarkedFiberFamily.Fiber F D.middle
  let e := MarkedFiberFamily.forget F D.middle
  have hlabel (p q : Sigma F') (h : p.1=q.1) : (e p).1=(e q).1 :=
    MarkedFiberFamily.labels_eq F D.middle p q h
  have hl := LightPairDeletion.two_step_pair_bound G F' E
    (D.delete ∘ e) (D.middle ∘ e) (D.root ∘ e) (hub D ∘ e) D.hub cap Δ hdeg
    (fun p q h => D.labels _ _ (hlabel p q h))
    (MarkedFiberFamily.marks_eq F D.middle)
    (fun p q h => D.roots _ _ (hlabel p q h))
    (fun _ => rfl)
    (fun p => MaskedBush.arm_left G L (D.arm (e p)))
    (fun p => MaskedBush.arm_right G L (D.arm (e p)))
    (fun p q hd hm hr => (MarkedFiberFamily.forget_injective F D.middle)
      (D.restore (e p) (e q) hd hr hm))
  have hs := HeavyFiberRestriction.family_split F' K (hub D ∘ e) k hk hK
    (fun u v => Fintype.card (G.commonNeighbors u v) ≤ cap) hlight
  have hp := MarkedFiberFamily.pin_le F D.middle (hub D)
  have he := MarkedFiberFamily.agreement_card F D.middle
  simp only [←Nat.card_eq_fintype_card] at hl hs
  rw [he] at hs
  exact hs.trans (Nat.mul_le_mul_left _ (Nat.add_le_add hp hl))

/-- If the removed root is determined by retained data, each of the two
assignments has at most cap choices for the removed light middle. -/
theorem prescribed_root_bound (kept : Sigma E → W) (cap : ℕ)
    (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both F (fun p => D.root p=kept (D.delete p))) ≤
      cap^2*Nat.card (FiberRestrictionEnergy.Agreement E) := by
  classical
  let X := FiberRestrictionEnergy.Both F (fun p => D.root p=kept (D.delete p))
  let B := FiberRestrictionEnergy.Agreement E
  let Ext (p : B) := MaskedBush.Arm G L (D.hub p.1.1) (kept p.1.1) ×
    MaskedBush.Arm G L (D.hub p.1.2) (kept p.1.2)
  let encode : X → Sigma Ext := fun p =>
    ⟨⟨(D.delete p.1.1,D.delete p.1.2),D.labels _ _ p.2.1⟩,
      MaskedBush.castArm G L p.2.2.1 (D.arm p.1.1),
      MaskedBush.castArm G L p.2.2.2 (D.arm p.1.2)⟩
  have hi : Function.Injective encode := by
    intro p q he
    have hd : (D.delete p.1.1,D.delete p.1.2)=(D.delete q.1.1,D.delete q.1.2) :=
      congrArg (fun t : Sigma Ext => t.1.val) he
    have hm₁ : D.middle p.1.1=D.middle q.1.1 := by
      have h := congrArg (fun t : Sigma Ext => MaskedBush.middle G L t.2.1) he
      simpa only [encode,MaskedBush.castArm_middle] using h
    have hm₂ : D.middle p.1.2=D.middle q.1.2 := by
      have h := congrArg (fun t : Sigma Ext => MaskedBush.middle G L t.2.2) he
      simpa only [encode,MaskedBush.castArm_middle] using h
    apply Subtype.ext
    apply Prod.ext
    · apply D.restore _ _ (Prod.mk.inj hd).1 _ hm₁
      exact p.2.2.1.trans ((congrArg kept (Prod.mk.inj hd).1).trans q.2.2.1.symm)
    · apply D.restore _ _ (Prod.mk.inj hd).2 _ hm₂
      exact p.2.2.2.trans ((congrArg kept (Prod.mk.inj hd).2).trans q.2.2.2.symm)
  have hb (p : B) : Fintype.card (Ext p) ≤ cap^2 := by
    rw [Fintype.card_prod,pow_two]
    exact Nat.mul_le_mul (MaskedBush.card_arm_cap G L cap hL hcap _ _)
      (MaskedBush.card_arm_cap G L cap hL hcap _ _)
  have hc : Fintype.card X ≤ cap^2*Fintype.card B := calc
    _ ≤ Fintype.card (Sigma Ext) := Fintype.card_le_of_injective encode hi
    _ = ∑ p, Fintype.card (Ext p) := Fintype.card_sigma
    _ ≤ ∑ _p : B, cap^2 := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp [Nat.mul_comm]
  simpa only [←Nat.card_eq_fintype_card] using hc

end Erdos571.ArmDeletion


/-! Same-assignment middle collisions whose other role is retained. -/
namespace Erdos571.ArmDeletion
open Finset SimpleGraph
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable {G : SimpleGraph W} [DecidableRel G.Adj] {L : ℝ}
variable {F : R → Type} {E : S → Type} [∀ r, Fintype (F r)] [∀ s, Fintype (E s)]

/-- Identifying the removed middle with any retained role determines that
middle. Only the root remains to be chosen in the light-pair encoding. -/
theorem prescribed_middle_bound (D : Data G L F E) (kept : Sigma E → W)
    (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both F (fun p => D.middle p=kept (D.delete p))) ≤
      (k-1)*(Nat.card (RestrictionDeletion.RolePin F (kept ∘ D.delete)) +
        cap*Nat.card (FiberRestrictionEnergy.Agreement E)) := by
  apply RestrictionDeletion.collision_bound F
    (fun p => D.middle p=kept (D.delete p)) E G K k cap hk hK hlight
    D.delete D.root (kept ∘ D.delete) kept D.labels D.roots (fun _ _ => rfl)
  · intro p hp
    change G.Adj (kept (D.delete p)) (D.root p)
    rw [←hp]
    exact MaskedBush.arm_right G L (D.arm p)
  · intro p q hp hq hd hr
    apply D.restore p q hd hr
    exact hp.trans ((congrArg kept hd).trans hq.symm)

end Erdos571.ArmDeletion


/-! Terminal pins and retained-data root collisions for each three-hub
bundle, via actual one-arm deletion maps. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

abbrev Pin (role : Full G L I J K → W) := RestrictionDeletion.RolePin (Fiber G L I J K) role

def centralDeletion (i : I) : ArmDeletion.Data G L (Fiber G L I J K)
    (Fiber G L (MaskedBush.Without i) J K) where
  delete := deleteCentral G L i
  root := fun p => centralRoot G L p i
  hub := center G L
  arm := fun p => p.2.2.1 i
  labels := deleteCentral_labels G L i
  roots := fun p q hr => congrArg (fun r : Roots (W := W) I J K => r.1 i) hr
  restore := deleteCentral_restore G L i

/-- The central terminal pin reduces to its hub pin and its deleted agreement. -/
theorem central_terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : I) :
    Nat.card (Pin G L (fun p : Full G L I J K => centralMiddle G L p i)) ≤ (k-1)*
      (Nat.card (Pin G L (center G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (Agreement G L (MaskedBush.Without i) J K)) :=
  ArmDeletion.terminal_pin_bound (centralDeletion G L i) H k cap Δ hk hH hdeg hlight

/-- The removed central root may be any function of retained data. -/
theorem central_prescribed_root_bound (i : I) (kept : Full G L (MaskedBush.Without i) J K → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => centralRoot G L p i=kept (deleteCentral G L i p))) ≤
        cap^2*Nat.card (Agreement G L (MaskedBush.Without i) J K) :=
  ArmDeletion.prescribed_root_bound (centralDeletion G L i) kept cap hL hcap

def leftDeletion (i : J) : ArmDeletion.Data G L (Fiber G L I J K)
    (Fiber G L I (MaskedBush.Without i) K) where
  delete := deleteLeft G L i
  root := fun p => leftRoot G L p i
  hub := leftHub G L
  arm := fun p => p.2.2.2.1.2.2 i
  labels := deleteLeft_labels G L i
  roots := fun p q hr => congrArg (fun r : Roots (W := W) I J K => r.2.1 i) hr
  restore := deleteLeft_restore G L i

/-- The left terminal pin reduces to its hub pin and its deleted agreement. -/
theorem left_terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : J) :
    Nat.card (Pin G L (fun p : Full G L I J K => leftMiddle G L p i)) ≤ (k-1)*
      (Nat.card (Pin G L (leftHub G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (Agreement G L I (MaskedBush.Without i) K)) :=
  ArmDeletion.terminal_pin_bound (leftDeletion G L i) H k cap Δ hk hH hdeg hlight

/-- The removed left root may be any function of retained data. -/
theorem left_prescribed_root_bound (i : J) (kept : Full G L I (MaskedBush.Without i) K → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => leftRoot G L p i=kept (deleteLeft G L i p))) ≤
        cap^2*Nat.card (Agreement G L I (MaskedBush.Without i) K) :=
  ArmDeletion.prescribed_root_bound (leftDeletion G L i) kept cap hL hcap

def rightDeletion (i : K) : ArmDeletion.Data G L (Fiber G L I J K)
    (Fiber G L I J (MaskedBush.Without i)) where
  delete := deleteRight G L i
  root := fun p => rightRoot G L p i
  hub := rightHub G L
  arm := fun p => p.2.2.2.2.2.2 i
  labels := deleteRight_labels G L i
  roots := fun p q hr => congrArg (fun r : Roots (W := W) I J K => r.2.2 i) hr
  restore := deleteRight_restore G L i

/-- The right terminal pin reduces to its hub pin and its deleted agreement. -/
theorem right_terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : K) :
    Nat.card (Pin G L (fun p : Full G L I J K => rightMiddle G L p i)) ≤ (k-1)*
      (Nat.card (Pin G L (rightHub G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (Agreement G L I J (MaskedBush.Without i))) :=
  ArmDeletion.terminal_pin_bound (rightDeletion G L i) H k cap Δ hk hH hdeg hlight

/-- The removed right root may be any function of retained data. -/
theorem right_prescribed_root_bound (i : K) (kept : Full G L I J (MaskedBush.Without i) → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => rightRoot G L p i=kept (deleteRight G L i p))) ≤
        cap^2*Nat.card (Agreement G L I J (MaskedBush.Without i)) :=
  ArmDeletion.prescribed_root_bound (rightDeletion G L i) kept cap hL hcap

end Erdos571.ThreeHubMixed


/-! Same-copy terminal collisions with any retained role in the mixed
three-hub assignment family. -/
namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

theorem central_prescribed_middle_bound (i : I) (kept : Full G L (MaskedBush.Without i) J K → W)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => centralMiddle G L p i=kept (deleteCentral G L i p))) ≤
      (k-1)*(Nat.card (Pin G L (kept ∘ deleteCentral G L i)) +
        cap*Nat.card (Agreement G L (MaskedBush.Without i) J K)) :=
  ArmDeletion.prescribed_middle_bound (centralDeletion G L i) kept H k cap hk hH hlight

theorem left_prescribed_middle_bound (i : J) (kept : Full G L I (MaskedBush.Without i) K → W)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => leftMiddle G L p i=kept (deleteLeft G L i p))) ≤
      (k-1)*(Nat.card (Pin G L (kept ∘ deleteLeft G L i)) +
        cap*Nat.card (Agreement G L I (MaskedBush.Without i) K)) :=
  ArmDeletion.prescribed_middle_bound (leftDeletion G L i) kept H k cap hk hH hlight

theorem right_prescribed_middle_bound (i : K) (kept : Full G L I J (MaskedBush.Without i) → W)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => rightMiddle G L p i=kept (deleteRight G L i p))) ≤
      (k-1)*(Nat.card (Pin G L (kept ∘ deleteRight G L i)) +
        cap*Nat.card (Agreement G L I J (MaskedBush.Without i))) :=
  ArmDeletion.prescribed_middle_bound (rightDeletion G L i) kept H k cap hk hH hlight

end Erdos571.ThreeHubMixed

/-! Algebraic energies for identifying two core roles within each copy.
No pointwise codegree cap beyond the degree bound is needed here. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubKernel
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def contractedCore (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, (A*A) u u*(A*A) v v*(K u v)^2*chain A K u v

noncomputable def coincidentHubs (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, K u v*
    (entryPower (A*A) 2*entryPower K 2*entryPower (A*A) 2) u v

noncomputable def coincidentMiddles (A K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, ((A*K*A) u v)^3

lemma sandwich_apply (A K : Matrix U U ℝ) (u v : U) :
    (A*K*A) u v=∑ x, ∑ y, A u x*K x y*A y v := by
  simp only [Matrix.mul_apply,sum_mul]
  rw [sum_comm]

lemma sandwich_cap (A K : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hcap : ∀ u v, K u v ≤ B) (u v : U) :
    (A*K*A) u v ≤ D^2*B := by
  have hc : ∑ y, A y v ≤ D := by simpa only [hsym.apply v] using hrow v
  rw [sandwich_apply]
  calc
    _ ≤ ∑ x, ∑ y, A u x*B*A y v := by
      exact sum_le_sum (fun x _ => sum_le_sum (fun y _ =>
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hcap x y) (hA u x)) (hA y v)))
    _ = B*(∑ x, A u x)*(∑ y, A y v) := by simp only [←mul_sum,←sum_mul]; ring
    _ ≤ B*D*D := mul_le_mul (mul_le_mul_of_nonneg_left (hrow u) hB) hc
      (sum_nonneg (fun y _ => hA y v)) (mul_nonneg hB hD)
    _ = _ := by ring

lemma squared_sandwich_bound (X K : Matrix U U ℝ)
    (hX : ∀ u v, 0 ≤ X u v) (hK : ∀ u v, 0 ≤ K u v)
    (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hXcap : ∀ u v, X u v ≤ D) (hKcap : ∀ u v, K u v ≤ B) (u v : U) :
    (entryPower X 2*entryPower K 2*entryPower X 2) u v ≤ D^2*B*(X*K*X) u v := by
  rw [sandwich_apply,sandwich_apply]
  simp only [entryPower,mul_sum]
  apply sum_le_sum
  intro x _
  apply sum_le_sum
  intro y _
  have hx : (X u x)^2 ≤ D*X u x := by nlinarith [mul_le_mul_of_nonneg_right (hXcap u x) (hX u x)]
  have hy : (X y v)^2 ≤ D*X y v := by nlinarith [mul_le_mul_of_nonneg_right (hXcap y v) (hX y v)]
  have hk : (K x y)^2 ≤ B*K x y := by nlinarith [mul_le_mul_of_nonneg_right (hKcap x y) (hK x y)]
  calc
    _ ≤ (D*X u x)*(B*K x y)*(D*X y v) := by gcongr <;> positivity [hX u x,hK x y]
    _ = _ := by ring

lemma contractedCore_le (A K : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hdiag : ∀ u, (A*A) u u ≤ D) (hcap : ∀ u v, K u v ≤ B) :
    contractedCore A K ≤ D^2*B*twoEnergy A K := by
  rw [twoEnergy_eq_inner A K hsym]
  simp only [contractedCore,mul_sum]
  apply sum_le_sum
  intro u _
  apply sum_le_sum
  intro v _
  have ha : (A*A) u u*(A*A) v v ≤ D^2 := by
    simpa only [pow_two] using mul_le_mul (hdiag u) (hdiag v) (chain_nonneg hA hA v v) hD
  have hk : (K u v)^2 ≤ B*K u v := by nlinarith [mul_le_mul_of_nonneg_right (hcap u v) (hK u v)]
  calc
    _ ≤ D^2*(B*K u v)*chain A K u v :=
      mul_le_mul_of_nonneg_right (mul_le_mul ha hk (sq_nonneg _) (sq_nonneg D))
        (chain_nonnegative A K hA hK u v)
    _ = _ := by ring

lemma coincidentHubs_le (A K : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hcodeg : ∀ u v, (A*A) u v ≤ D) (hcap : ∀ u v, K u v ≤ B) :
    coincidentHubs A K ≤ D^2*B*twoEnergy A K := by
  rw [twoEnergy_eq_inner A K hsym]
  simp only [coincidentHubs,mul_sum]
  apply sum_le_sum
  intro u _
  apply sum_le_sum
  intro v _
  have h := mul_le_mul_of_nonneg_left
    (squared_sandwich_bound (A*A) K (chain_nonneg hA hA) hK D B hD hB hcodeg hcap u v) (hK u v)
  convert h using 1 <;> dsimp [chain] <;> ring

lemma coincidentMiddles_le (A K : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (D B : ℝ) (hD : 0 ≤ D) (hB : 0 ≤ B)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hcap : ∀ u v, K u v ≤ B) :
    coincidentMiddles A K ≤ D^2*B*twoEnergy A K := by
  simp only [coincidentMiddles,twoEnergy,squareMass,mul_sum]
  exact sum_le_sum (fun u _ => sum_le_sum (fun v _ => by
    have h := mul_le_mul_of_nonneg_right (sandwich_cap A K hsym hA hK D B hD hB hrow hcap u v)
      (sq_nonneg ((A*K*A) u v))
    convert h using 1 <;> ring))

/-- Any collision energy dominated by a fixed multiple of the two-hub
energy inherits its mass-sensitive Perron bound. -/
lemma collision_mul_mass_le (A K : Matrix U U ℝ) (hsym : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hK : ∀ u v, 0 ≤ K u v)
    (p c d : ℝ) (hc : 0 ≤ c) (hd : 0 ≤ d) (hmin : ∀ u, d ≤ ∑ v, A u v)
    (hp : p ≤ c*twoEnergy A K) :
    p*d^4*(∑ u, ∑ v, K u v) ≤ c*(Fintype.card U:ℝ)^2*energy A K := by
  have hm : 0 ≤ ∑ u, ∑ v, K u v := sum_nonneg (fun u _ => sum_nonneg (fun v _ => hK u v))
  calc
    _ ≤ (c*twoEnergy A K)*d^4*(∑ u, ∑ v, K u v) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hp (pow_nonneg hd _)) hm
    _ = c*(twoEnergy A K*d^4*(∑ u, ∑ v, K u v)) := by ring
    _ ≤ c*((Fintype.card U:ℝ)^2*energy A K) :=
      mul_le_mul_of_nonneg_left (twoEnergy_mul_mass_le A K hsym hA hK d hd hmin) hc
    _ = _ := by ring

end Erdos571.ThreeHubKernel


/-! Tensor identities for the three possible same-copy core identifications. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmTensor
open Finset Matrix GramFeatures GramPin
variable {U R S : Type} [Fintype U] [Fintype R] [Fintype S] [DecidableEq U]

lemma row_scale_gram (F : Matrix U R ℝ) (w : U → ℝ) (u v : U) :
    let H : Matrix U R ℝ := fun x r => w x*F x r
    (H*H.transpose) u v=w u*w v*(F*F.transpose) u v := by
  simp only [Matrix.mul_apply,Matrix.transpose_apply,mul_sum]
  exact sum_congr rfl (fun r _ => by ring)

lemma contracted_total (X : Matrix U U ℝ) (F : Matrix U R ℝ) (B : Matrix U S ℝ) :
    (∑ r, ∑ t, ∑ a, (∑ u, X u u*F u r*F u t*B u a)^2) =
      ∑ u, ∑ v, X u u*X v v*((F*F.transpose) u v)^2*(B*B.transpose) u v := by
  let H : Matrix U R ℝ := fun u r => X u u*F u r
  have h := triple_mixed_total H F B
  change (∑ r, ∑ t, ∑ a, (∑ u, H u r*F u t*B u a)^2)=_
  rw [h]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  rw [show (H*H.transpose) u v=X u u*X v v*(F*F.transpose) u v from row_scale_gram F (fun u => X u u) u v]
  ring

lemma coincident_hubs_total (X : Matrix U U ℝ) (hsym : X.IsSymm) (F : Matrix U R ℝ) :
    (∑ r, ∑ t, ∑ a, (∑ x, ∑ u, F x r*(X x u)^2*F u t*F u a)^2) =
      ∑ x, ∑ y, (F*F.transpose) x y*
        (entryPower X 2*entryPower (F*F.transpose) 2*entryPower X 2) x y := by
  let M : Matrix U (R×R) ℝ := fun u p => F u p.1*F u p.2
  let Y := entryPower X 2
  have hY : Y.transpose=Y := by
    ext u v
    exact congrArg (fun x : ℝ => x^2) (hsym.apply u v)
  have hM : M*M.transpose=entryPower (F*F.transpose) 2 := by
    ext u v
    simpa only [M,entryPower,pow_two] using product_gram F F u v
  have hB : (Y*M)*(Y*M).transpose=Y*entryPower (F*F.transpose) 2*Y := by
    simp only [Matrix.transpose_mul,hY,Matrix.mul_assoc]
    rw [←Matrix.mul_assoc M,hM]
  have h := mixed_total F (Y*M)
  simp only [Fintype.sum_prod_type] at h
  rw [hB] at h
  convert h using 1
  apply sum_congr rfl
  intro r _
  apply sum_congr rfl
  intro t _
  apply sum_congr rfl
  intro a _
  congr 1
  simp only [Matrix.mul_apply,mul_sum,Y,entryPower,M]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro u _
  ring

lemma coincident_middles_total (A : Matrix U U ℝ) (hsym : A.IsSymm) (F : Matrix U R ℝ) :
    (∑ r, ∑ t, ∑ a,
      (∑ x, ∑ w, A x w*F x r*(A*F) w t*(A*F) w a)^2) =
      ∑ u, ∑ v, ((A*(F*F.transpose)*A) u v)^3 := by
  have he (r t a : R) :
      (∑ x, ∑ w, A x w*F x r*(A*F) w t*(A*F) w a)=
        ∑ w, (A*F) w r*(A*F) w t*(A*F) w a := by
    rw [sum_comm]
    apply sum_congr rfl
    intro w _
    rw [←sum_mul,←sum_mul]
    congr 2
    apply sum_congr rfl
    intro x _
    rw [hsym.apply w x]
  simp_rw [he]
  rw [triple_mixed_total]
  have hg : (A*F)*(A*F).transpose=A*(F*F.transpose)*A := by
    simp only [Matrix.transpose_mul,hsym.eq,Matrix.mul_assoc]
  rw [hg]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by ring))

end Erdos571.ArmTensor


/-! Exact finite counts for same-copy identifications of the core roles. -/
set_option maxHeartbeats 3000000
namespace Erdos571.FiberRestrictionEnergy
open Finset
variable {R : Type} [Fintype R] (F : R → Type) [∀ r, Fintype (F r)]
open Classical in
lemma both_card_real (P : Sigma F → Prop) :
    (Nat.card (Both F P):ℝ)=∑ r, (Nat.card (Restricted F P r):ℝ)^2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (bothEquiv F P),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,Nat.card_eq_fintype_card]
end Erdos571.FiberRestrictionEnergy

namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph Matrix GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

abbrev ContractedLeft (p : Full G L I J K) := leftHub G L p=center G L p
abbrev SameHubs (p : Full G L I J K) := leftHub G L p=rightHub G L p
abbrev SameCoreMiddles (p : Full G L I J K) := leftCoreMiddle G L p=rightCoreMiddle G L p

abbrev ContractAt (r : Roots (W := W) I J K) (x : W) :=
  MaskedBush.Bundle G L I x r.1 × (G.commonNeighbors x x ×
    (MaskedBush.Bundle G L J x r.2.1 × Side G L K x r.2.2))

def contractedLeftEquiv (r : Roots (W := W) I J K) :
    FiberRestrictionEnergy.Restricted (Fiber G L I J K) (ContractedLeft G L) r ≃
      ((x : W) × ContractAt G L r x) where
  toFun p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,right⟩,he⟩
    change u=x at he
    subst u
    exact ⟨x,b,cm,c,right⟩
  invFun p := ⟨⟨p.1,p.2.1,⟨p.1,p.2.2.1,p.2.2.2.1⟩,p.2.2.2.2⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,right⟩,he⟩
    change u=x at he
    subst u
    rfl
  right_inv p := by rcases p with ⟨x,b,cm,c,right⟩; rfl

open Classical in
lemma contractedLeft_fiber_card (r : Roots (W := W) I J K) :
    (Nat.card (FiberRestrictionEnergy.Restricted (Fiber G L I J K) (ContractedLeft G L) r):ℝ)=
      ∑ x, (G.adjMatrix ℝ * G.adjMatrix ℝ) x x*armFeature G L I x r.1*
        armFeature G L J x r.2.1*sideFeature G L K x r.2.2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (contractedLeftEquiv G L r)]
  simp only [ContractAt,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,
    MaskedBush.card_bundle,card_side,←LayeredBush.adjacency_square_common_card]
  apply sum_congr rfl
  intro x _
  dsimp only [armFeature,sideFeature,Matrix.mul_apply]
  ring

open Classical in
lemma contractedLeft_card (s : ℕ) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s)) (ContractedLeft G L)):ℝ)=
      ThreeHubKernel.contractedCore (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [FiberRestrictionEnergy.both_card_real]
  simp_rw [contractedLeft_fiber_card (I := Fin s) (J := Fin s) (K := Fin s) G L]
  simp only [Fintype.sum_prod_type]
  rw [ArmTensor.contracted_total,arm_gram,side_gram]
  simp only [Fintype.card_fin,ThreeHubKernel.contractedCore]

abbrev SameHubAt (r : Roots (W := W) I J K) (x u : W) :=
  MaskedBush.Bundle G L I x r.1 × (G.commonNeighbors x u × (G.commonNeighbors x u ×
    (MaskedBush.Bundle G L J u r.2.1 × MaskedBush.Bundle G L K u r.2.2)))

def sameHubsEquiv (r : Roots (W := W) I J K) :
    FiberRestrictionEnergy.Restricted (Fiber G L I J K) (SameHubs G L) r ≃
      ((x : W) × (u : W) × SameHubAt G L r x u) where
  toFun p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,⟨v,dm,e⟩⟩,he⟩
    change u=v at he
    subst v
    exact ⟨x,u,b,cm,dm,c,e⟩
  invFun p := ⟨⟨p.1,p.2.2.1,⟨p.2.1,p.2.2.2.1,p.2.2.2.2.2.1⟩,
    ⟨p.2.1,p.2.2.2.2.1,p.2.2.2.2.2.2⟩⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,⟨v,dm,e⟩⟩,he⟩
    change u=v at he
    subst v
    rfl
  right_inv p := by rcases p with ⟨x,u,b,cm,dm,c,e⟩; rfl

open Classical in
lemma sameHubs_fiber_card (r : Roots (W := W) I J K) :
    (Nat.card (FiberRestrictionEnergy.Restricted (Fiber G L I J K) (SameHubs G L) r):ℝ)=
      ∑ x, ∑ u, armFeature G L I x r.1*((G.adjMatrix ℝ * G.adjMatrix ℝ) x u)^2*
        armFeature G L J u r.2.1*armFeature G L K u r.2.2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (sameHubsEquiv G L r)]
  simp only [SameHubAt,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,
    MaskedBush.card_bundle,←LayeredBush.adjacency_square_common_card]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro u _
  dsimp only [armFeature]
  ring

open Classical in
lemma sameHubs_card (s : ℕ) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s)) (SameHubs G L)):ℝ)=
      ThreeHubKernel.coincidentHubs (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [FiberRestrictionEnergy.both_card_real]
  simp_rw [sameHubs_fiber_card (I := Fin s) (J := Fin s) (K := Fin s) G L]
  simp only [Fintype.sum_prod_type]
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    change (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=_
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  rw [ArmTensor.coincident_hubs_total _ hs,arm_gram]
  simp only [Fintype.card_fin,ThreeHubKernel.coincidentHubs]

abbrev SameMidAt (r : Roots (W := W) I J K) (x w : W) :=
  PLift (G.Adj x w) × (MaskedBush.Bundle G L I x r.1 ×
    (MaskedBush.Side G L J w r.2.1 × MaskedBush.Side G L K w r.2.2))

def sameMiddlesEquiv (r : Roots (W := W) I J K) :
    FiberRestrictionEnergy.Restricted (Fiber G L I J K) (SameCoreMiddles G L) r ≃
      ((x : W) × (w : W) × SameMidAt G L r x w) where
  toFun p := by
    rcases p with ⟨⟨x,b,⟨u,⟨w,hw,hu⟩,c⟩,⟨v,⟨w',hw',hv⟩,e⟩⟩,he⟩
    change w=w' at he
    subst w'
    exact ⟨x,w,⟨hw⟩,b,⟨u,⟨hu.symm⟩,c⟩,⟨v,⟨hv.symm⟩,e⟩⟩
  invFun p := by
    rcases p with ⟨x,w,⟨h⟩,b,⟨u,⟨hu⟩,c⟩,⟨v,⟨hv⟩,e⟩⟩
    exact ⟨⟨x,b,⟨u,⟨w,h,hu.symm⟩,c⟩,⟨v,⟨w,h,hv.symm⟩,e⟩⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,b,⟨u,⟨w,hw,hu⟩,c⟩,⟨v,⟨w',hw',hv⟩,e⟩⟩,he⟩
    change w=w' at he
    subst w'
    rfl
  right_inv p := by
    rcases p with ⟨x,w,⟨h⟩,b,⟨u,⟨hu⟩,c⟩,⟨v,⟨hv⟩,e⟩⟩
    rfl

open Classical in
lemma sameMiddles_fiber_card (r : Roots (W := W) I J K) :
    (Nat.card (FiberRestrictionEnergy.Restricted (Fiber G L I J K) (SameCoreMiddles G L) r):ℝ)=
      ∑ x, ∑ w, G.adjMatrix ℝ x w*armFeature G L I x r.1*
        (G.adjMatrix ℝ * armFeature G L J) w r.2.1*
        (G.adjMatrix ℝ * armFeature G L K) w r.2.2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (sameMiddlesEquiv G L r)]
  simp only [SameMidAt,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,
    MaskedBush.card_bundle,MaskedBush.card_side,LayeredAssignments.card_adj]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro w _
  dsimp only [armFeature,Matrix.mul_apply]
  ring

open Classical in
lemma sameMiddles_card (s : ℕ) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s)) (SameCoreMiddles G L)):ℝ)=
      ThreeHubKernel.coincidentMiddles (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  rw [FiberRestrictionEnergy.both_card_real]
  simp_rw [sameMiddles_fiber_card (I := Fin s) (J := Fin s) (K := Fin s) G L]
  simp only [Fintype.sum_prod_type]
  rw [ArmTensor.coincident_middles_total _ G.isSymm_adjMatrix,arm_gram]
  simp only [Fintype.card_fin,ThreeHubKernel.coincidentMiddles]

end Erdos571.ThreeHubMixed


/-! The other central-endpoint identification is obtained by swapping the
endpoint bundles; roots and assignments are transported together. -/
namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph Matrix GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

def swap (p : Full G L I J K) : Full G L I K J :=
  ⟨(p.1.1,(p.1.2.2,p.1.2.1)),p.2.1,p.2.2.1,p.2.2.2.2,p.2.2.2.1⟩

lemma swap_swap (p : Full G L I J K) : swap G L (swap G L p)=p := by
  rcases p with ⟨⟨r,t,a⟩,x,b,left,right⟩
  rfl

def swapBothEquiv (P : Full G L I J K → Prop) :
    FiberRestrictionEnergy.Both (Fiber G L I J K) P ≃
      FiberRestrictionEnergy.Both (Fiber G L I K J) (P ∘ swap G L) where
  toFun p := ⟨(swap G L p.1.1,swap G L p.1.2),
    congrArg (fun r : Roots (W := W) I J K => (r.1,(r.2.2,r.2.1))) p.2.1,
    by simpa only [Function.comp_apply,swap_swap] using p.2.2.1,
    by simpa only [Function.comp_apply,swap_swap] using p.2.2.2⟩
  invFun p := ⟨(swap G L p.1.1,swap G L p.1.2),
    congrArg (fun r : Roots (W := W) I K J => (r.1,(r.2.2,r.2.1))) p.2.1,p.2.2⟩
  left_inv p := by apply Subtype.ext; exact Prod.ext (swap_swap G L _) (swap_swap G L _)
  right_inv p := by apply Subtype.ext; exact Prod.ext (swap_swap G L _) (swap_swap G L _)

abbrev ContractedRight (p : Full G L I J K) := rightHub G L p=center G L p

lemma contractedRight_card (s : ℕ) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s)) (ContractedRight G L)):ℝ)=
      ThreeHubKernel.contractedCore (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  have he := Nat.card_congr (swapBothEquiv G L (ContractedRight G L : Full G L (Fin s) (Fin s) (Fin s) → Prop))
  change Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s)) (ContractedRight G L))=
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s)) (ContractedLeft G L)) at he
  rw [he]
  exact contractedLeft_card G L s

end Erdos571.ThreeHubMixed


/-! The common degree threshold for same-copy core-collision energies. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHub

lemma momentCoefficient_one_le (s M : ℕ) : 1 ≤ momentCoefficient s M := by
  have hn := branch_card_ge s M
  have h₁ : 1 ≤ Fintype.card (Branch s M)-1 := by omega
  have h₂ : 1 ≤ Fintype.card (Branch s M)+Nat.card (FullRootedPower.graph (base s) (M+1)).edgeSet+1 := by omega
  have h := Nat.mul_le_mul h₁ h₂
  unfold momentCoefficient
  exact_mod_cast h

end Erdos571.ThreeHub

namespace Erdos571.ThreeHubKernel
open Finset Matrix SimpleGraph GramPin GramFeatures
variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma adjacency_square_degree_cap (D : ℝ) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (u v : W) :
    (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ D := by
  rw [LayeredBush.adjacency_square_common_card]
  exact (show (Fintype.card (G.commonNeighbors u v):ℝ) ≤ (G.degree u:ℝ) by
    exact_mod_cast G.card_commonNeighbors_le_degree_left u v).trans (hdeg u)

/-- Every nonnegative collision count bounded by D^2*T^s*twoEnergy has the
same degree threshold as the current central-pin bound. -/
theorem free_core_energy_bound (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K p : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) (hp0 : 0 ≤ p)
    (hp : p ≤ (K*d)^2*(ThreeHub.momentCoefficient s M*(K*d)^2)^s*
      twoEnergy (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s)) :
    p*d^(2*s+2) ≤ (4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2)*
      (Fintype.card W:ℝ)^s*energy (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let Q := N*N.transpose
  let F := entryPower Q s
  let C := ThreeHub.momentCoefficient s M
  let T := C*(K*d)^2
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hT : 0 ≤ T := mul_nonneg hC (sq_nonneg _)
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp only [A,SimpleGraph.adjMatrix_apply]; split_ifs <;> norm_num
  have hQ : ∀ u v, 0 ≤ Q u v := LightArmKernel.gram_nonneg G L
  have hF : ∀ u v, 0 ≤ F u v := fun u v => pow_nonneg (hQ u v) s
  have hE : 0 ≤ energy A F := energy_nonneg A F hF
  have hin := free_masked_arm_mass_cap G s M hf L d K hL hd hK hdK hmin hmax hcut
  have hr (u : W) : d ≤ ∑ v, A u v := by
    rw [adjacency_row_sum]
    exact hmin u
  have hD : (K*d)^2 ≤ T := by
    have hh := mul_le_mul_of_nonneg_right (ThreeHub.momentCoefficient_one_le s M) (sq_nonneg (K*d))
    simpa only [one_mul] using hh
  have hcap : p ≤ T^(s+1)*twoEnergy A F := by
    apply hp.trans
    rw [pow_succ' T s]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hD (pow_nonneg hT s)) (twoEnergy_nonneg A F)
  have hm := entryPower_mass_lower Q hQ s hs (d^4/4) (by positivity) hin.1
  have h := collision_mul_mass_le A F G.isSymm_adjMatrix hA hF p (T^(s+1)) d
    (pow_nonneg hT _) hd.le hr hcap
  have hn : 0 < (Fintype.card W:ℝ) := by exact_mod_cast Fintype.card_pos (α := W)
  have hrow := mass_row_cancel_linear s hs (Fintype.card W:ℝ) p (d^4) (d^4/4)
    (∑ u, ∑ v, F u v) (T^(s+1)*energy A F) hn hp0 (pow_nonneg hd.le _) hm
    (by convert h using 1 <;> ring)
  have hh : p*d^4*(d^4/4)^s ≤ (C*(K*d)^2)^(s+1)*(Fintype.card W:ℝ)^s*energy A F := by
    convert hrow using 1 <;> ring
  exact cancel_pin_scale s p (energy A F) (Fintype.card W:ℝ) C K d 4 hd (by norm_num) hh

end Erdos571.ThreeHubKernel


/-! Uniform finite same-copy core-collision bounds for the original
three-hub assignment model. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubMixed
open Finset SimpleGraph Matrix GramPin

inductive CoreCollision where
  | centralLeft | centralRight | endpoints | middles
  deriving DecidableEq, Fintype

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

def CoreCollision.predicate (c : CoreCollision) {I J K : Type} (p : Full G L I J K) : Prop :=
  match c with
  | .centralLeft => ContractedLeft G L p
  | .centralRight => ContractedRight G L p
  | .endpoints => SameHubs G L p
  | .middles => SameCoreMiddles G L p

noncomputable def CoreCollision.energy (c : CoreCollision) (A K : Matrix W W ℝ) : ℝ :=
  match c with
  | .centralLeft | .centralRight => ThreeHubKernel.contractedCore A K
  | .endpoints => ThreeHubKernel.coincidentHubs A K
  | .middles => ThreeHubKernel.coincidentMiddles A K

lemma core_collision_card (s : ℕ) (c : CoreCollision) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s))
      (CoreCollision.predicate G L c)):ℝ)=
    c.energy (G.adjMatrix ℝ)
      (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  cases c
  · exact contractedLeft_card G L s
  · exact contractedRight_card G L s
  · exact sameHubs_card G L s
  · exact sameMiddles_card G L s

variable [Nonempty W]

lemma core_collision_twoEnergy_le (s : ℕ) (c : CoreCollision) (D T : ℝ)
    (hD : 0 ≤ D) (hT : 0 ≤ T) (hmax : ∀ u, (G.degree u:ℝ) ≤ D)
    (hQcap : ∀ u v, (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) u v ≤ T) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s))
      (CoreCollision.predicate G L c)):ℝ) ≤
      D^2*T^s*ThreeHubKernel.twoEnergy (G.adjMatrix ℝ)
        (entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) s) := by
  let A := G.adjMatrix ℝ
  let Q := LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose
  let F := entryPower Q s
  have hA : ∀ u v, 0 ≤ A u v := by
    intro u v; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hQ : ∀ u v, 0 ≤ Q u v := LightArmKernel.gram_nonneg G L
  have hF : ∀ u v, 0 ≤ F u v := fun u v => pow_nonneg (hQ u v) s
  have hcap : ∀ u v, F u v ≤ T^s := fun u v => pow_le_pow_left₀ (hQ u v) (hQcap u v) s
  have hrow (u : W) : ∑ v, A u v ≤ D := by
    rw [ThreeHubKernel.adjacency_row_sum]
    exact hmax u
  have hcodeg : ∀ u v, (A*A) u v ≤ D := ThreeHubKernel.adjacency_square_degree_cap G D hmax
  rw [core_collision_card]
  cases c
  · exact ThreeHubKernel.contractedCore_le A F G.isSymm_adjMatrix hA hF D (T^s) hD (pow_nonneg hT _)
      (fun u => hcodeg u u) hcap
  · exact ThreeHubKernel.contractedCore_le A F G.isSymm_adjMatrix hA hF D (T^s) hD (pow_nonneg hT _)
      (fun u => hcodeg u u) hcap
  · exact ThreeHubKernel.coincidentHubs_le A F G.isSymm_adjMatrix hA hF D (T^s) hD (pow_nonneg hT _) hcodeg hcap
  · exact ThreeHubKernel.coincidentMiddles_le A F G.isSymm_adjMatrix hA hF D (T^s) hD (pow_nonneg hT _) hrow hcap

/-- Each of the four possible nonadjacent same-parity core identifications
has the current nonsharp degree threshold. -/
theorem core_collision_bound (s M : ℕ) (hs : 1 ≤ s) (c : CoreCollision)
    (hf : (ThreeHub.graph s M).Free G) (d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L (Fin s) (Fin s) (Fin s))
      (CoreCollision.predicate G L c)):ℝ)*d^(2*s+2) ≤
      (4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2)*
        (Fintype.card W:ℝ)^s*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ) := by
  rw [ThreeHubAssignments.agreement_card]
  apply ThreeHubKernel.free_core_energy_bound G s M hs hf L d K _ hL hd hK hdK hmin hmax hcut
    (Nat.cast_nonneg _)
  have hin := ThreeHubKernel.free_masked_arm_mass_cap G s M hf L d K hL hd hK hdK hmin hmax hcut
  exact core_collision_twoEnergy_le G L s c (K*d) (ThreeHub.momentCoefficient s M*(K*d)^2)
    (by positivity) (mul_nonneg (ThreeHub.momentCoefficient_nonneg s M) (sq_nonneg _)) hmax hin.2

end Erdos571.ThreeHubMixed

/-! Injective role indices for all vertices of the original ThreeHub template.
The indices preserve the root/nonroot split and evaluate to the actual hom. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph

abbrev Arm (s : ℕ) := Fin 3 × Fin s
abbrev Core := Fin 3 ⊕ Fin 2
abbrev Interior (s : ℕ) := Core ⊕ Arm s
abbrev Vertex (s : ℕ) := Interior s ⊕ Arm s

variable (s : ℕ) (hs : 1 ≤ s)

def rootEquiv : ThreeHub.BaseRoot s ≃ Arm s where
  toFun r := ⟨r.1,finCongr (ThreeHub.counts_eq s hs r.1) r.2⟩
  invFun r := ⟨r.1,(finCongr (ThreeHub.counts_eq s hs r.1)).symm r.2⟩
  left_inv r := by cases r; simp
  right_inv r := by cases r; simp

noncomputable def petalIndex (e : RootedSubdivision.Petal (ThreeHub.base s)) : Fin 2 ⊕ Arm s :=
  Sum.map id (rootEquiv s hs) ((BalancedTree.edgeEquiv (ThreeHub.counts s)).symm e.val)

lemma petalIndex_injective : Function.Injective (petalIndex s hs) :=
  (Sum.map_injective.mpr ⟨Function.injective_id,(rootEquiv s hs).injective⟩).comp
    ((BalancedTree.edgeEquiv (ThreeHub.counts s)).symm.injective.comp Subtype.val_injective)

noncomputable def interiorIndex (a : RootedSubdivision.Nonroot (ThreeHub.base s)) : Interior s :=
  (Equiv.sumAssoc (Fin 3) (Fin 2) (Arm s)).symm (Sum.map id (petalIndex s hs) a)

lemma interiorIndex_injective : Function.Injective (interiorIndex s hs) :=
  (Equiv.sumAssoc (Fin 3) (Fin 2) (Arm s)).symm.injective.comp
    (Sum.map_injective.mpr ⟨Function.injective_id,petalIndex_injective s hs⟩)

def rootIndex (r : RootedSubdivision.Root (ThreeHub.base s)) : Arm s :=
  match r with
  | .inl r => rootEquiv s hs r
  | .inr e => False.elim (ThreeHubAssignments.rootEdge_false s e)

lemma rootIndex_injective : Function.Injective (rootIndex s hs) := by
  rintro (r|e) (t|f) he
  · exact congrArg Sum.inl ((rootEquiv s hs).injective he)
  · exact (ThreeHubAssignments.rootEdge_false s f).elim
  · exact (ThreeHubAssignments.rootEdge_false s e).elim
  · exact (ThreeHubAssignments.rootEdge_false s e).elim

noncomputable def vertexIndex : RootedSubdivision.Vertex (ThreeHub.base s) → Vertex s :=
  Sum.map (interiorIndex s hs) (rootIndex s hs)

lemma vertexIndex_injective : Function.Injective (vertexIndex s hs) :=
  Sum.map_injective.mpr ⟨interiorIndex_injective s hs,rootIndex_injective s hs⟩

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev Full := ThreeHubAssignments.Full G L s

def coreValue (p : Full s G L) : Core → W :=
  Sum.elim (ThreeHubAssignments.hubValue G L s p) (ThreeHubAssignments.coreMiddle G L s p)

def terminalValue (p : Full s G L) (r : Arm s) : W :=
  MaskedBush.middle G L (ThreeHubAssignments.bundleAt G L s p r.1 r.2)

def rootValue (p : Full s G L) (r : Arm s) : W :=
  ThreeHubAssignments.labelAt G L s p r.1 r.2

def interiorValue (p : Full s G L) : Interior s → W :=
  Sum.elim (coreValue s G L p) (terminalValue s G L p)

def value (p : Full s G L) : Vertex s → W :=
  Sum.elim (interiorValue s G L p) (rootValue s G L p)

lemma hom_value (p : Full s G L) (v : RootedSubdivision.Vertex (ThreeHub.base s)) :
    ThreeHubAssignments.hom G L s hs p v=value s G L p (vertexIndex s hs v) := by
  rcases v with (a|e)|(r|e)
  · have h := ThreeHubAssignments.hom_old G L s hs p (.inl a)
    exact h
  · have h := ThreeHubAssignments.hom_middle G L s hs p e.val
    rw [RootedSubdivision.middle_petal] at h
    rw [h]
    unfold ThreeHubAssignments.edgeValue
    generalize hi : (BalancedTree.edgeEquiv (ThreeHub.counts s)).symm e.val=i
    cases i with
    | inl i => simp [value,vertexIndex,interiorIndex,petalIndex,hi,Sum.map_inr,
        Sum.map_inl,id_eq,Equiv.sumAssoc,interiorValue,coreValue,
        Sum.elim_inl,ThreeHubAssignments.edgeIndexValue]
    | inr r => simp [value,vertexIndex,interiorIndex,petalIndex,hi,Sum.map_inr,
        Sum.map_inl,id_eq,Equiv.sumAssoc,interiorValue,terminalValue,
        Sum.elim_inl,Sum.elim_inr,rootEquiv,ThreeHubAssignments.edgeIndexValue]
  · exact ThreeHubAssignments.hom_old G L s hs p (.inr r)
  · exact (ThreeHubAssignments.rootEdge_false s e).elim

end Erdos571.ThreeHubRoles


/-! Explicit comparisons between role-index evaluations and the finite
mixed-family coordinates used by the deletion bounds. -/
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

@[simp] lemma hub_zero (p : Full s G L) :
    ThreeHubAssignments.hubValue G L s p 0=ThreeHubMixed.leftHub G L p := rfl
@[simp] lemma hub_one (p : Full s G L) :
    ThreeHubAssignments.hubValue G L s p 1=ThreeHubMixed.center G L p := rfl
@[simp] lemma hub_two (p : Full s G L) :
    ThreeHubAssignments.hubValue G L s p 2=ThreeHubMixed.rightHub G L p := rfl
@[simp] lemma coreMiddle_zero (p : Full s G L) :
    ThreeHubAssignments.coreMiddle G L s p 0=ThreeHubMixed.leftCoreMiddle G L p := rfl
@[simp] lemma coreMiddle_one (p : Full s G L) :
    ThreeHubAssignments.coreMiddle G L s p 1=ThreeHubMixed.rightCoreMiddle G L p := rfl
@[simp] lemma root_zero (p : Full s G L) (i : Fin s) :
    rootValue s G L p (0,i)=ThreeHubMixed.leftRoot G L p i := rfl
@[simp] lemma root_one (p : Full s G L) (i : Fin s) :
    rootValue s G L p (1,i)=ThreeHubMixed.centralRoot G L p i := rfl
@[simp] lemma root_two (p : Full s G L) (i : Fin s) :
    rootValue s G L p (2,i)=ThreeHubMixed.rightRoot G L p i := rfl
@[simp] lemma terminal_zero (p : Full s G L) (i : Fin s) :
    terminalValue s G L p (0,i)=ThreeHubMixed.leftMiddle G L p i := rfl
@[simp] lemma terminal_one (p : Full s G L) (i : Fin s) :
    terminalValue s G L p (1,i)=ThreeHubMixed.centralMiddle G L p i := rfl
@[simp] lemma terminal_two (p : Full s G L) (i : Fin s) :
    terminalValue s G L p (2,i)=ThreeHubMixed.rightMiddle G L p i := rfl

end Erdos571.ThreeHubRoles


/-! Bipartite parity separates every old role from every middle role. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
include hg

lemma two_walk_color {u v w : W} (hu : G.Adj u w) (hv : G.Adj v w) : g u=g v := by
  have h₁ := hg hu
  have h₂ := hg hv
  cases hgu : g u <;> cases hgv : g v <;> cases hgw : g w <;> simp_all

lemma hub_color (p : Full s G L) (i : Fin 3) :
    g (ThreeHubAssignments.hubValue G L s p i)=g (ThreeHubAssignments.center G L s p) := by
  fin_cases i
  · exact two_walk_color G g hg p.2.2.2.1.2.1.property.2 p.2.2.2.1.2.1.property.1
  · rfl
  · exact two_walk_color G g hg p.2.2.2.2.2.1.property.2 p.2.2.2.2.2.1.property.1

lemma coreMiddle_color (p : Full s G L) (i : Fin 2) :
    g (ThreeHubAssignments.coreMiddle G L s p i)≠g (ThreeHubAssignments.center G L s p) := by
  fin_cases i
  · exact (hg p.2.2.2.1.2.1.property.1).symm
  · exact (hg p.2.2.2.2.2.1.property.1).symm

lemma root_color (p : Full s G L) (r : Arm s) :
    g (rootValue s G L p r)=g (ThreeHubAssignments.center G L s p) := by
  let a := ThreeHubAssignments.bundleAt G L s p r.1 r.2
  have h := two_walk_color G g hg (MaskedBush.arm_right G L a).symm (MaskedBush.arm_left G L a)
  exact h.trans (hub_color s G L g hg p r.1)

lemma terminal_color (p : Full s G L) (r : Arm s) :
    g (terminalValue s G L p r)≠g (ThreeHubAssignments.center G L s p) := by
  have h := (hg (MaskedBush.arm_left G L (ThreeHubAssignments.bundleAt G L s p r.1 r.2))).symm
  exact h.trans_eq (hub_color s G L g hg p r.1)

def parity : Vertex s → Bool
  | .inl (.inl (.inl _)) => false
  | .inl (.inl (.inr _)) => true
  | .inl (.inr _) => true
  | .inr _ => false

lemma value_color (p : Full s G L) (v : Vertex s) :
    g (value s G L p v)=
      if parity s v then !(g (ThreeHubAssignments.center G L s p))
      else g (ThreeHubAssignments.center G L s p) := by
  rcases v with ((i|i)|r)|r
  · exact hub_color s G L g hg p i
  · have h := coreMiddle_color s G L g hg p i
    change g (ThreeHubAssignments.coreMiddle G L s p i)=!(g (ThreeHubAssignments.center G L s p))
    cases hx : g (ThreeHubAssignments.coreMiddle G L s p i) <;>
      cases hy : g (ThreeHubAssignments.center G L s p) <;> simp_all
  · have h := terminal_color s G L g hg p r
    change g (terminalValue s G L p r)=!(g (ThreeHubAssignments.center G L s p))
    cases hx : g (terminalValue s G L p r) <;>
      cases hy : g (ThreeHubAssignments.center G L s p) <;> simp_all
  · exact root_color s G L g hg p r

lemma value_ne_of_parity (p : Full s G L) (v w : Vertex s) (h : parity s v≠parity s w) :
    value s G L p v≠value s G L p w := by
  intro he
  have hc := congrArg g he
  rw [value_color s G L g hg,value_color s G L g hg] at hc
  cases hv : parity s v <;> cases hw : parity s w <;>
    cases hx : g (ThreeHubAssignments.center G L s p) <;> simp_all

lemma opposite_parity_both_zero (v w : Vertex s) (h : parity s v≠parity s w) :
    Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
      (fun p => value s G L p v=value s G L p w))=0 := by
  haveI : IsEmpty (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
      (fun p => value s G L p v=value s G L p w)) :=
    ⟨fun p => value_ne_of_parity s G L g hg p.1.1 v w h p.2.2.1⟩
  simp

end Erdos571.ThreeHubRoles


/-! Each indexed arm has a deletion witness retaining every core role and
all other root and terminal roles. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

structure DeletionWitness (r : Arm s) where
  S : Type
  finS : Fintype S
  E : S → Type
  finE : ∀ x, Fintype (E x)
  data : ArmDeletion.Data G L (ThreeHubAssignments.Fiber G L s) E
  root_eq : ∀ p, data.root p=rootValue s G L p r
  middle_eq : ∀ p, data.middle p=terminalValue s G L p r
  hub_eq : ∀ p, ArmDeletion.hub data p=coreValue s G L p (.inl r.1)
  core_retained : ∀ c : Core, ∃ kept : Sigma E → W,
    ∀ p, coreValue s G L p c=kept (data.delete p)
  root_retained : ∀ t : Arm s, t≠r → ∃ kept : Sigma E → W,
    ∀ p, rootValue s G L p t=kept (data.delete p)
  terminal_retained : ∀ t : Arm s, t≠r → ∃ kept : Sigma E → W,
    ∀ p, terminalValue s G L p t=kept (data.delete p)

noncomputable def leftWitness (i : Fin s) : DeletionWitness s G L (0,i) := by
  classical
  refine
    { S := ThreeHubMixed.Roots (W := W) (Fin s) (MaskedBush.Without i) (Fin s)
      finS := inferInstance
      E := ThreeHubMixed.Fiber G L (Fin s) (MaskedBush.Without i) (Fin s)
      finE := fun _ => inferInstance
      data := ThreeHubMixed.leftDeletion G L i
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · rintro (j|j)
    · fin_cases j
      · exact ⟨ThreeHubMixed.leftHub G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.center G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.rightHub G L,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨ThreeHubMixed.leftCoreMiddle G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.rightCoreMiddle G L,fun _ => rfl⟩
  · rintro ⟨j,k⟩ ht
    fin_cases j
    · have hk : k≠i := fun he => ht (Prod.ext rfl he)
      exact ⟨fun p => ThreeHubMixed.leftRoot G L p ⟨k,hk⟩,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.centralRoot G L p k,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.rightRoot G L p k,fun _ => rfl⟩
  · rintro ⟨j,k⟩ ht
    fin_cases j
    · have hk : k≠i := fun he => ht (Prod.ext rfl he)
      exact ⟨fun p => ThreeHubMixed.leftMiddle G L p ⟨k,hk⟩,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.centralMiddle G L p k,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.rightMiddle G L p k,fun _ => rfl⟩

noncomputable def centralWitness (i : Fin s) : DeletionWitness s G L (1,i) := by
  classical
  refine
    { S := ThreeHubMixed.Roots (W := W) (MaskedBush.Without i) (Fin s) (Fin s)
      finS := inferInstance
      E := ThreeHubMixed.Fiber G L (MaskedBush.Without i) (Fin s) (Fin s)
      finE := fun _ => inferInstance
      data := ThreeHubMixed.centralDeletion G L i
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · rintro (j|j)
    · fin_cases j
      · exact ⟨ThreeHubMixed.leftHub G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.center G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.rightHub G L,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨ThreeHubMixed.leftCoreMiddle G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.rightCoreMiddle G L,fun _ => rfl⟩
  · rintro ⟨j,k⟩ ht
    fin_cases j
    · exact ⟨fun p => ThreeHubMixed.leftRoot G L p k,fun _ => rfl⟩
    · have hk : k≠i := fun he => ht (Prod.ext rfl he)
      exact ⟨fun p => ThreeHubMixed.centralRoot G L p ⟨k,hk⟩,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.rightRoot G L p k,fun _ => rfl⟩
  · rintro ⟨j,k⟩ ht
    fin_cases j
    · exact ⟨fun p => ThreeHubMixed.leftMiddle G L p k,fun _ => rfl⟩
    · have hk : k≠i := fun he => ht (Prod.ext rfl he)
      exact ⟨fun p => ThreeHubMixed.centralMiddle G L p ⟨k,hk⟩,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.rightMiddle G L p k,fun _ => rfl⟩

noncomputable def rightWitness (i : Fin s) : DeletionWitness s G L (2,i) := by
  classical
  refine
    { S := ThreeHubMixed.Roots (W := W) (Fin s) (Fin s) (MaskedBush.Without i)
      finS := inferInstance
      E := ThreeHubMixed.Fiber G L (Fin s) (Fin s) (MaskedBush.Without i)
      finE := fun _ => inferInstance
      data := ThreeHubMixed.rightDeletion G L i
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · rintro (j|j)
    · fin_cases j
      · exact ⟨ThreeHubMixed.leftHub G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.center G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.rightHub G L,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨ThreeHubMixed.leftCoreMiddle G L,fun _ => rfl⟩
      · exact ⟨ThreeHubMixed.rightCoreMiddle G L,fun _ => rfl⟩
  · rintro ⟨j,k⟩ ht
    fin_cases j
    · exact ⟨fun p => ThreeHubMixed.leftRoot G L p k,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.centralRoot G L p k,fun _ => rfl⟩
    · have hk : k≠i := fun he => ht (Prod.ext rfl he)
      exact ⟨fun p => ThreeHubMixed.rightRoot G L p ⟨k,hk⟩,fun _ => rfl⟩
  · rintro ⟨j,k⟩ ht
    fin_cases j
    · exact ⟨fun p => ThreeHubMixed.leftMiddle G L p k,fun _ => rfl⟩
    · exact ⟨fun p => ThreeHubMixed.centralMiddle G L p k,fun _ => rfl⟩
    · have hk : k≠i := fun he => ht (Prod.ext rfl he)
      exact ⟨fun p => ThreeHubMixed.rightMiddle G L p ⟨k,hk⟩,fun _ => rfl⟩

noncomputable def deletionWitness (r : Arm s) : DeletionWitness s G L r := by
  rcases r with ⟨j,i⟩
  by_cases h₀ : j=0
  · subst j; exact leftWitness s G L i
  by_cases h₁ : j=1
  · subst j; exact centralWitness s G L i
  have h₂ : j=2 := by omega
  subst j
  exact rightWitness s G L i

/-- Uniform numerical bounds on the three deletion families transfer to
any role-indexed deletion witness. -/
lemma deleted_witness_bound (Z : ℝ)
    (hc : ∀ i : Fin s, (Nat.card (ThreeHubMixed.Agreement G L
      (MaskedBush.Without i) (Fin s) (Fin s)):ℝ) ≤ Z)
    (hl : ∀ i : Fin s, (Nat.card (ThreeHubMixed.Agreement G L
      (Fin s) (MaskedBush.Without i) (Fin s)):ℝ) ≤ Z)
    (hr : ∀ i : Fin s, (Nat.card (ThreeHubMixed.Agreement G L
      (Fin s) (Fin s) (MaskedBush.Without i)):ℝ) ≤ Z) (r : Arm s) :
    (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness s G L r).E):ℝ) ≤ Z := by
  rcases r with ⟨j,i⟩
  fin_cases j
  · exact hl i
  · exact hc i
  · exact hr i

end Erdos571.ThreeHubRoles


/-! Role-indexed consequences of the retained-data deletion interface. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {r : Arm s} (D : DeletionWitness s G L r)

lemma DeletionWitness.root_collision_bound (role : Full s G L → W)
    (hret : ∃ kept : Sigma D.E → W, ∀ p, role p=kept (D.data.delete p))
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) (Z : ℝ)
    (hdel : (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) ≤ Z) :
    (Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
      (fun p => rootValue s G L p r=role p)):ℝ) ≤ (cap:ℝ)^2*Z := by
  classical
  letI := D.finS
  letI := D.finE
  obtain ⟨kept,hkept⟩ := hret
  have h := ArmDeletion.prescribed_root_bound D.data kept cap hL hcap
  have he : (fun p => D.data.root p=kept (D.data.delete p))=
      (fun p => rootValue s G L p r=role p) := by
    funext p
    rw [D.root_eq,←hkept]
  rw [he] at h
  have hh : (Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
      (fun p => rootValue s G L p r=role p)):ℝ) ≤
      (cap:ℝ)^2*(Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) := by exact_mod_cast h
  exact hh.trans (mul_le_mul_of_nonneg_left hdel (sq_nonneg _))

lemma DeletionWitness.middle_collision_bound (role : Full s G L → W)
    (hret : ∃ kept : Sigma D.E → W, ∀ p, role p=kept (D.data.delete p))
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (B Z : ℝ)
    (hpin : (Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s) role):ℝ) ≤ B)
    (hdel : (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) ≤ Z) :
    (Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
      (fun p => terminalValue s G L p r=role p)):ℝ) ≤ (k-1:ℕ)*(B+cap*Z) := by
  classical
  letI := D.finS
  letI := D.finE
  obtain ⟨kept,hkept⟩ := hret
  have h := ArmDeletion.prescribed_middle_bound D.data kept H k cap hk hH hlight
  have hp : kept ∘ D.data.delete=role := funext (fun p => (hkept p).symm)
  have he : (fun p => D.data.middle p=kept (D.data.delete p))=
      (fun p => terminalValue s G L p r=role p) := by
    funext p
    rw [D.middle_eq,←hkept]
  rw [he,hp] at h
  have hh : (Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
      (fun p => terminalValue s G L p r=role p)):ℝ) ≤
      (k-1:ℕ)*((Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s) role):ℝ)+
        cap*(Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ)) := by exact_mod_cast h
  exact hh.trans (mul_le_mul_of_nonneg_left
    (add_le_add hpin (mul_le_mul_of_nonneg_left hdel (Nat.cast_nonneg cap))) (Nat.cast_nonneg _))

lemma DeletionWitness.terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (B Z : ℝ)
    (hpin : (Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s)
      (fun p => coreValue s G L p (.inl r.1))):ℝ) ≤ B)
    (hdel : (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) ≤ Z) :
    (Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s)
      (fun p => terminalValue s G L p r)):ℝ) ≤ (k-1:ℕ)*(B+(cap*Δ:ℕ)*Z) := by
  classical
  letI := D.finS
  letI := D.finE
  have h := ArmDeletion.terminal_pin_bound D.data H k cap Δ hk hH hdeg hlight
  have hm : D.data.middle=(fun p => terminalValue s G L p r) := funext D.middle_eq
  have hh : ArmDeletion.hub D.data=(fun p => coreValue s G L p (.inl r.1)) := funext D.hub_eq
  rw [hm,hh] at h
  have h' : (Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s)
      (fun p => terminalValue s G L p r)):ℝ) ≤
      (k-1:ℕ)*((Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s)
        (fun p => coreValue s G L p (.inl r.1))):ℝ)+(cap*Δ:ℕ)*
          (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ)) := by exact_mod_cast h
  exact h'.trans (mul_le_mul_of_nonneg_left
    (add_le_add hpin (mul_le_mul_of_nonneg_left hdel (Nat.cast_nonneg _))) (Nat.cast_nonneg _))

end Erdos571.ThreeHubRoles


/-! Complete classification of role pins and distinct-role collisions in
the three-hub walk model. All hypotheses are explicit finite count bounds. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev Pin (a : Interior s) := RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s)
  (fun p => interiorValue s G L p a)
abbrev EqualBoth (v w : Vertex s) := FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s)
  (fun p => value s G L p v=value s G L p w)

lemma equalBoth_symm (v w : Vertex s) : Nat.card (EqualBoth s G L v w)=Nat.card (EqualBoth s G L w v) := by
  have he : (fun p : Full s G L => value s G L p v=value s G L p w)=
      (fun p : Full s G L => value s G L p w=value s G L p v) :=
    funext (fun _ => propext eq_comm)
  exact congrArg (fun P => Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s) P)) he

lemma all_pin_bounds (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (B Z P : ℝ) (hBP : B ≤ P) (hterm : (k-1:ℕ)*(B+(cap*Δ:ℕ)*Z) ≤ P)
    (hcore : ∀ c : Core, (Nat.card (Pin s G L (.inl c)):ℝ) ≤ B)
    (hdel : ∀ r : Arm s, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness s G L r).E):ℝ) ≤ Z) :
    ∀ a : Interior s, (Nat.card (Pin s G L a):ℝ) ≤ P := by
  rintro (c|r)
  · exact (hcore c).trans hBP
  · exact (DeletionWitness.terminal_pin_bound s G L (deletionWitness s G L r)
      H k cap Δ hk hH hdeg hlight B Z (hcore (.inl r.1)) (hdel r)).trans hterm

lemma core_equal_bound (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (B : ℝ) (hB : 0 ≤ B)
    (hcore : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (ThreeHubMixed.Fiber G L (Fin s) (Fin s) (Fin s))
        (ThreeHubMixed.CoreCollision.predicate G L c)):ℝ) ≤ B)
    (c d : Core) (hne : c≠d) :
    (Nat.card (EqualBoth s G L (.inl (.inl c)) (.inl (.inl d))):ℝ) ≤ B := by
  rcases c with i|i <;> rcases d with j|j
  · fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · exact hcore .centralLeft
    · exact hcore .endpoints
    · rw [equalBoth_symm]; exact hcore .centralLeft
    · exact (hne rfl).elim
    · rw [equalBoth_symm]; exact hcore .centralRight
    · rw [equalBoth_symm]; exact hcore .endpoints
    · exact hcore .centralRight
    · exact (hne rfl).elim
  · have h := opposite_parity_both_zero s G L g hg (.inl (.inl (.inl i))) (.inl (.inl (.inr j))) (by simp [parity])
    change (Nat.card (EqualBoth s G L _ _):ℝ) ≤ B
    rw [h,Nat.cast_zero]
    exact hB
  · have h := opposite_parity_both_zero s G L g hg (.inl (.inl (.inr i))) (.inl (.inl (.inl j))) (by simp [parity])
    change (Nat.card (EqualBoth s G L _ _):ℝ) ≤ B
    rw [h,Nat.cast_zero]
    exact hB
  · fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · exact hcore .middles
    · rw [equalBoth_symm]; exact hcore .middles
    · exact (hne rfl).elim

/-- Every same-copy collision is a core collision, a retained-role arm
collision, or is excluded by bipartite parity. -/
theorem all_collision_bounds (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap) (P Z B : ℝ) (hB : 0 ≤ B)
    (hattach : (k-1:ℕ)*(P+cap*Z) ≤ B) (hroot : (cap:ℝ)^2*Z ≤ B)
    (hpin : ∀ a : Interior s, (Nat.card (Pin s G L a):ℝ) ≤ P)
    (hcore : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (ThreeHubMixed.Fiber G L (Fin s) (Fin s) (Fin s))
        (ThreeHubMixed.CoreCollision.predicate G L c)):ℝ) ≤ B)
    (hdel : ∀ r : Arm s, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness s G L r).E):ℝ) ≤ Z) :
    ∀ v w : Vertex s, v≠w → (Nat.card (EqualBoth s G L v w):ℝ) ≤ B := by
  have hrc (r : Arm s) (c : Core) :
      (Nat.card (EqualBoth s G L (.inr r) (.inl (.inl c))):ℝ) ≤ B := by
    exact (DeletionWitness.root_collision_bound s G L (deletionWitness s G L r)
      (fun p => coreValue s G L p c) ((deletionWitness s G L r).core_retained c)
      cap hL hcap Z (hdel r)).trans hroot
  have hrr (r t : Arm s) (hne : t≠r) :
      (Nat.card (EqualBoth s G L (.inr r) (.inr t)):ℝ) ≤ B := by
    exact (DeletionWitness.root_collision_bound s G L (deletionWitness s G L r)
      (fun p => rootValue s G L p t) ((deletionWitness s G L r).root_retained t hne)
      cap hL hcap Z (hdel r)).trans hroot
  have htc (r : Arm s) (c : Core) :
      (Nat.card (EqualBoth s G L (.inl (.inr r)) (.inl (.inl c))):ℝ) ≤ B := by
    exact (DeletionWitness.middle_collision_bound s G L (deletionWitness s G L r)
      (fun p => coreValue s G L p c) ((deletionWitness s G L r).core_retained c)
      H k cap hk hH hlight P Z (hpin (.inl c)) (hdel r)).trans hattach
  have htt (r t : Arm s) (hne : t≠r) :
      (Nat.card (EqualBoth s G L (.inl (.inr r)) (.inl (.inr t))):ℝ) ≤ B := by
    exact (DeletionWitness.middle_collision_bound s G L (deletionWitness s G L r)
      (fun p => terminalValue s G L p t) ((deletionWitness s G L r).terminal_retained t hne)
      H k cap hk hH hlight P Z (hpin (.inr t)) (hdel r)).trans hattach
  intro v w hvw
  by_cases he : parity s v=parity s w
  swap
  · have h := opposite_parity_both_zero s G L g hg v w he
    change (Nat.card (EqualBoth s G L v w):ℝ) ≤ B
    rw [h,Nat.cast_zero]
    exact hB
  rcases v with ((i|i)|r)|r <;> rcases w with ((j|j)|t)|t <;> simp only [parity,Bool.false_eq_true,Bool.true_eq_false] at he
  · exact core_equal_bound s G L g hg B hB hcore (.inl i) (.inl j) (fun h => hvw (congrArg (fun c : Core => (Sum.inl (Sum.inl c):Vertex s)) h))
  · rw [equalBoth_symm]; exact hrc t (.inl i)
  · exact core_equal_bound s G L g hg B hB hcore (.inr i) (.inr j) (fun h => hvw (congrArg (fun c : Core => (Sum.inl (Sum.inl c):Vertex s)) h))
  · rw [equalBoth_symm]; exact htc t (.inr i)
  · exact htc r (.inr j)
  · exact htt r t (fun h => hvw (by rw [h]))
  · exact hrc r (.inl j)
  · exact hrr r t (fun h => hvw (by rw [h]))

end Erdos571.ThreeHubRoles


/-! A complete small-count certificate for the original ThreeHub graph.
The hypotheses concern actual finite families, not abstract kernel surrogates. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HomFamilyEnergy
open Finset SimpleGraph
variable {A R J W : Type} [Fintype A] [Fintype R] [Fintype J] [Fintype W] [DecidableEq W]
variable (F : J → Type) [∀ j, Fintype (F j)]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W} (f : Sigma F → H →g G)

/-- The instance-independent cardinality interface to the packing certificate. -/
theorem not_free_of_uniform_energies_nat [Nonempty A] (M : ℕ) (hM : 2 ≤ M)
    (hroots : ∀ p q, p.1=q.1 → ∀ r, f p (.inr r)=f q (.inr r))
    (ε : ℝ) (hε : 0 ≤ ε)
    (hsmall : (M-1:ℕ)*(2*(Nat.card (DistinctRoles (A := A) (R := R)):ℝ)+(Nat.card A:ℝ)^2)*ε < 1)
    (hpos : 0 < (Nat.card (Agreement F):ℝ))
    (heq : ∀ p : DistinctRoles (A := A) (R := R), (Nat.card (EqualBoth F f p.1.1 p.1.2):ℝ) ≤
      ε^2*(Nat.card (Agreement F):ℝ))
    (hpin : ∀ a : A, (Nat.card (Pin F f a):ℝ) ≤ ε*(Nat.card (Agreement F):ℝ)) :
    ¬(FullRootedPower.graph H M).Free G := by
  classical
  apply not_free_of_uniform_energies F f M hM hroots ε hε _ hpos heq hpin
  simpa only [Nat.card_eq_fintype_card] using hsmall
end Erdos571.HomFamilyEnergy

namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

open Classical in
theorem not_free_of_small_counts (hs : 1 ≤ s) (M : ℕ) (hM : 2 ≤ M)
    (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (H : SimpleGraph W) (k cap Δ : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap)
    (ε p κ μ : ℝ) (hε : 0 ≤ ε) (hκp : κ ≤ p)
    (hterm : (k-1:ℕ)*(κ+(cap*Δ:ℕ)*μ) ≤ p)
    (hp : p ≤ ε^2) (hε1 : ε^2 ≤ ε)
    (hattach : (k-1:ℕ)*(p+cap*μ) ≤ ε^2) (hroot : (cap:ℝ)^2*μ ≤ ε^2)
    (hsmall : (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
      (A := RootedSubdivision.Nonroot (ThreeHub.base s))
      (R := RootedSubdivision.Root (ThreeHub.base s))):ℝ)+
        (Nat.card (RootedSubdivision.Nonroot (ThreeHub.base s)):ℝ)^2)*ε < 1)
    (hpos : 0 < (Nat.card (ThreeHubAssignments.Agreement G L s):ℝ))
    (hcore : ∀ c : Core, (Nat.card (Pin s G L (.inl c)):ℝ) ≤
      κ*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ))
    (hcoll : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (ThreeHubMixed.Fiber G L (Fin s) (Fin s) (Fin s))
        (ThreeHubMixed.CoreCollision.predicate G L c)):ℝ) ≤
      κ*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ))
    (hdel : ∀ r : Arm s, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness s G L r).E):ℝ) ≤
      μ*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ)) :
    ¬(ThreeHub.graph s M).Free G := by
  classical
  let E : ℝ := Nat.card (ThreeHubAssignments.Agreement G L s)
  have hE : 0 ≤ E := hpos.le
  have hpin : ∀ a : Interior s, (Nat.card (Pin s G L a):ℝ) ≤ p*E := by
    apply all_pin_bounds s G L H k cap Δ hk hH hdeg hlight (κ*E) (μ*E) (p*E)
      (mul_le_mul_of_nonneg_right hκp hE) _ hcore hdel
    have h := mul_le_mul_of_nonneg_right hterm hE
    nlinarith
  have heq : ∀ v w : Vertex s, v≠w → (Nat.card (EqualBoth s G L v w):ℝ) ≤ ε^2*E := by
    apply all_collision_bounds s G L g hg H k cap hk hH hlight hL hcap (p*E) (μ*E) (ε^2*E)
      (mul_nonneg (sq_nonneg _) hE) _ _ hpin _ hdel
    · have h := mul_le_mul_of_nonneg_right hattach hE
      nlinarith
    · have h := mul_le_mul_of_nonneg_right hroot hE
      nlinarith
    · intro c
      exact (hcoll c).trans (mul_le_mul_of_nonneg_right (hκp.trans hp) hE)
  apply HomFamilyEnergy.not_free_of_uniform_energies_nat (ThreeHubAssignments.Fiber G L s)
    (ThreeHubAssignments.hom G L s hs) M hM (ThreeHubAssignments.same_roots G L s hs)
    ε hε hsmall hpos
  · intro q
    have he : (fun p : Full s G L => ThreeHubAssignments.hom G L s hs p q.1.1=
        ThreeHubAssignments.hom G L s hs p q.1.2)=
        (fun p => value s G L p (vertexIndex s hs q.1.1)=value s G L p (vertexIndex s hs q.1.2)) := by
      funext p
      rw [hom_value,hom_value]
    change (Nat.card (FiberRestrictionEnergy.Both (ThreeHubAssignments.Fiber G L s) _):ℝ) ≤ _
    rw [he]
    exact heq _ _ (fun h => q.property (vertexIndex_injective s hs h))
  · intro a
    have he : (fun p : Full s G L => ThreeHubAssignments.hom G L s hs p (.inl a))=
        (fun p => interiorValue s G L p (interiorIndex s hs a)) := by
      funext p
      exact hom_value s hs G L p (.inl a)
    change (Nat.card (RestrictionDeletion.RolePin (ThreeHubAssignments.Fiber G L s) _):ℝ) ≤ _
    rw [he]
    exact (hpin _).trans (mul_le_mul_of_nonneg_right (hp.trans hε1) hE)

end Erdos571.ThreeHubRoles

/-! Finite Ramsey bounds for unions of clique-free graphs. -/
set_option maxHeartbeats 1200000
namespace Erdos571.RamseyCliqueUnion
open Finset SimpleGraph

lemma clique_card_lt {V : Type*} (G : SimpleGraph V) (k : ℕ)
    (hk : G.CliqueFree k) (S : Finset V) (hS : G.IsClique S) : S.card < k := by
  by_contra! hn
  obtain ⟨T,hTS,hTc⟩ := Finset.exists_subset_card_eq hn
  exact hk T ⟨hS.subset hTS,hTc⟩

lemma induce_clique {V : Type*} (G : SimpleGraph V) (F : Set V) (k : ℕ)
    (S : Finset F) (hS : (G.induce F).IsNClique k S) :
    G.IsNClique k (S.map ⟨Subtype.val,Subtype.val_injective⟩) := by
  classical
  constructor
  · intro u hu v hv huv
    obtain ⟨a,ha,rfl⟩ := Finset.mem_map.mp hu
    obtain ⟨b,hb,rfl⟩ := Finset.mem_map.mp hv
    exact hS.1 ha hb (fun h => huv (congrArg Subtype.val h))
  · simpa only [Finset.card_map] using hS.2

lemma neighbors_cliqueFree {V : Type*} (G : SimpleGraph V) (k : ℕ)
    (hk : G.CliqueFree (k+1)) (x : V) (F : Set V) (hF : ∀ y∈F, G.Adj x y) :
    (G.induce F).CliqueFree k := by
  classical
  intro S hS
  apply hk (insert x (S.map ⟨Subtype.val,Subtype.val_injective⟩))
  apply (induce_clique G F k S hS).insert
  intro y hy
  obtain ⟨a,ha,rfl⟩ := Finset.mem_map.mp hy
  exact hF a a.property

/-- A coarse exponential two-color Ramsey bound. Constants will depend
only on forbidden clique sizes, not on the host vertex type. -/
theorem sup_cliqueFree (k l : ℕ) {V : Type*} (G H : SimpleGraph V)
    (hG : G.CliqueFree (k+1)) (hH : H.CliqueFree (l+1)) :
    (G⊔H).CliqueFree (2^(k+l)) := by
  classical
  induction k generalizing l V with
  | zero =>
    haveI : IsEmpty V := SimpleGraph.cliqueFree_one.mp hG
    exact (SimpleGraph.CliqueFree.mono (Nat.succ_le_iff.mpr (by positivity : 0 < 2^(_+_)))) (SimpleGraph.cliqueFree_one.mpr inferInstance)
  | succ k ihk =>
    induction l generalizing V with
    | zero =>
      haveI : IsEmpty V := SimpleGraph.cliqueFree_one.mp hH
      exact (SimpleGraph.CliqueFree.mono (Nat.succ_le_iff.mpr (by positivity : 0 < 2^(_+_)))) (SimpleGraph.cliqueFree_one.mpr inferInstance)
    | succ l ihl =>
      intro S hS
      have hSc : S.card=2^(k+1+(l+1)) := hS.2
      obtain ⟨x,hx⟩ := Finset.card_pos.mp (show 0<S.card by rw [hSc]; positivity)
      let N : Finset V := S.filter (fun y => G.Adj x y)
      let B : Finset V := S.filter (fun y => y≠x ∧ ¬G.Adj x y)
      have hG' : (G.induce (N:Set V)).CliqueFree (k+1) :=
        neighbors_cliqueFree G (k+1) hG x _ (fun y hy => (Finset.mem_filter.mp hy).2)
      have hH' : (H.induce (B:Set V)).CliqueFree (l+1) := by
        apply neighbors_cliqueFree H (l+1) hH x
        intro y hy
        have hy' := Finset.mem_filter.mp hy
        exact (hS.1 hx hy'.1 hy'.2.1.symm).resolve_left hy'.2.2
      have hN := ihk (l+1) (G.induce (N:Set V)) (H.induce (N:Set V)) hG'
        (SimpleGraph.CliqueFree.comap (SimpleGraph.Embedding.induce _) hH)
      have hB := ihl (G.induce (B:Set V)) (H.induce (B:Set V))
        (SimpleGraph.CliqueFree.comap (SimpleGraph.Embedding.induce _) hG) hH'
      have hn : N.card<2^(k+(l+1)) := by
        have hh := clique_card_lt _ _ hN (Finset.univ : Finset N) (by
          intro a ha b hb hab
          exact hS.1 (Finset.mem_filter.mp a.property).1 (Finset.mem_filter.mp b.property).1
            (fun h => hab (Subtype.ext h)))
        simpa only [Finset.card_univ, ←Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset] using hh
      have hb : B.card<2^(k+1+l) := by
        have hh := clique_card_lt _ _ hB (Finset.univ : Finset B) (by
          intro a ha b hb hab
          exact hS.1 (Finset.mem_filter.mp a.property).1 (Finset.mem_filter.mp b.property).1
            (fun h => hab (Subtype.ext h)))
        simpa only [Finset.card_univ, ←Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset] using hh
      have hpart : N.card+B.card+1=S.card := by
        have hdis : Disjoint N B := by
          apply Finset.disjoint_left.mpr
          intro y hy hy'
          exact (Finset.mem_filter.mp hy').2.2 (Finset.mem_filter.mp hy).2
        have he : N∪B=S.erase x := by
          ext y
          simp only [N,B,Finset.mem_union,Finset.mem_filter,Finset.mem_erase]
          constructor
          · rintro (⟨hy,hxy⟩|⟨hy,hne,hxy⟩)
            · exact ⟨hxy.ne.symm,hy⟩
            · exact ⟨hne,hy⟩
          · rintro ⟨hne,hy⟩
            by_cases hh : G.Adj x y
            · exact Or.inl ⟨hy,hh⟩
            · exact Or.inr ⟨hy,hne,hh⟩
        rw [←Finset.card_union_of_disjoint hdis,he,Finset.card_erase_of_mem hx]
        have : 0<S.card := Finset.card_pos.mpr ⟨x,hx⟩
        omega
      have he : 2^(k+1+(l+1))=2^(k+(l+1))+2^(k+1+l) := by
        rw [show k+1+(l+1)=(k+l+1)+1 by omega,pow_succ]
        rw [show k+(l+1)=k+l+1 by omega,show k+1+l=k+l+1 by omega]
        omega
      omega

end Erdos571.RamseyCliqueUnion


/-! A finite family of clique-free coordinate graphs can be imposed at once.
The bounds are deliberately coarse and independent of the host size. -/
set_option maxHeartbeats 1200000
namespace Erdos571.RamseyRoleMask
open Finset SimpleGraph

lemma cliqueFree_comap {V W : Type*} (G : SimpleGraph W) (k : ℕ)
    (hG : G.CliqueFree k) (f : V → W) : (G.comap f).CliqueFree k := by
  classical
  intro S hS
  have hi : Set.InjOn f S := by
    intro x hx y hy he
    by_contra hn
    have hh : G.Adj (f x) (f y) := hS.1 hx hy hn
    exact hh.ne he
  apply hG (S.image f)
  constructor
  · intro x hx y hy hxy
    obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨b,hb,rfl⟩ := Finset.mem_image.mp hy
    exact hS.1 ha hb (fun h => hxy (congrArg f h))
  · rw [Finset.card_image_of_injOn hi,hS.2]

def bound (k M : ℕ) : ℕ → ℕ
  | 0 => M
  | n+1 => 2^(k+bound k M n)

lemma bound_ge_two (k M n : ℕ) (hM : 2 ≤ M) : 2 ≤ bound k M n := by
  induction n with
  | zero => exact hM
  | succ n ih =>
    change 2 ≤ 2^(k+bound k M n)
    calc
      2 = 2^1 := by norm_num
      _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)

def union {V : Type*} (L : List (SimpleGraph V)) (B : SimpleGraph V) : SimpleGraph V :=
  L.foldr (fun G H => G⊔H) B

lemma union_cliqueFree {V : Type*} (L : List (SimpleGraph V)) (B : SimpleGraph V)
    (k M : ℕ) (hB : B.CliqueFree M) (hL : ∀ G∈L, G.CliqueFree k) :
    (union L B).CliqueFree (bound k M L.length) := by
  induction L with
  | nil => exact hB
  | cons G L ih =>
    exact RamseyCliqueUnion.sup_cliqueFree k (bound k M L.length) G (union L B)
      ((hL G (by simp)).mono (Nat.le_succ _))
      ((ih (fun H hH => hL H (by simp [hH]))).mono (Nat.le_succ _))

lemma union_nonadj {V : Type*} (L : List (SimpleGraph V)) (B : SimpleGraph V)
    (x y : V) : ¬(union L B).Adj x y ↔ ¬B.Adj x y ∧ ∀ G∈L, ¬G.Adj x y := by
  induction L with
  | nil => simp [union]
  | cons G L ih =>
    change ¬(G.Adj x y ∨ (union L B).Adj x y) ↔ _
    rw [not_or,ih]
    simp only [List.mem_cons,forall_eq_or_imp]
    tauto

noncomputable def coordinates {I V W : Type*} [Fintype I]
    (K : SimpleGraph W) (f : V → I → W) : List (SimpleGraph V) :=
  (Finset.univ.toList : List I).map (fun a => K.comap (fun p => f p a))

lemma coordinates_length {I V W : Type*} [Fintype I]
    (K : SimpleGraph W) (f : V → I → W) :
    (coordinates K f).length=Fintype.card I := by
  classical
  simp [coordinates]

lemma coordinates_free {I V W : Type*} [Fintype I]
    (K : SimpleGraph W) (f : V → I → W) (k : ℕ) (hK : K.CliqueFree k) :
    ∀ G∈coordinates K f, G.CliqueFree k := by
  classical
  intro G hG
  obtain ⟨a,ha,rfl⟩ := List.mem_map.mp hG
  exact cliqueFree_comap K k hK (fun p => f p a)

lemma coordinates_nonadj {I V W : Type*} [Fintype I]
    (K : SimpleGraph W) (f : V → I → W) (x y : V) :
    (∀ G∈coordinates K f, ¬G.Adj x y) ↔ ∀ a, ¬K.Adj (f x a) (f y a) := by
  classical
  simp [coordinates]

end Erdos571.RamseyRoleMask


/-! Full agreement energy can be charged to conflicting pairs that are
simultaneously nonadjacent in every coordinate of a clique-free shadow.
This is a Ramsey restriction, not an entrywise PSD assertion. -/
set_option maxHeartbeats 1600000
namespace Erdos571.RamseyLightConflict
open Finset SimpleGraph
variable {A R W I J : Type*} [Fintype A] [Nonempty A] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

def packingGraph (f : I → H →g G) (label : I → J) : SimpleGraph I where
  Adj i j := label i=label j ∧ ¬RootedHomEnergy.Conflict (f i) (f j)
  symm := by
    intro i j h
    exact ⟨h.1.symm,fun h' => h.2 (RootedHomEnergy.conflict_symm h')⟩
  loopless := by
    intro i h
    exact h.2 (RootedHomEnergy.conflict_refl (f i))

lemma packingGraph_free (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2 ≤ M) (hf : (FullRootedPower.graph H M).Free G) :
    (packingGraph f label).CliqueFree M := by
  classical
  intro S hS
  have hcard := hS.2
  apply hf (RootedHomEnergy.contains_of_packing S f M (by omega) hS.2 _ _ _)
  · intro i hi
    obtain ⟨j,hj,hji⟩ := Finset.exists_mem_ne (by omega : 1<S.card) i
    exact (not_not.mp (hS.1 hi hj hji.symm).2).1
  · intro i hi j hj r
    by_cases hij : i=j
    · subst j; rfl
    · exact hroots i j (hS.1 hi hj hij).1 r
  · intro i hi j hj hij
    exact (not_not.mp (hS.1 hi hj hij).2).2.2

variable {T : Type*} [Fintype T]

noncomputable def maskGraph (K : SimpleGraph W) (role : I → T → W)
    (f : I → H →g G) (label : I → J) : SimpleGraph I :=
  RamseyRoleMask.union (RamseyRoleMask.coordinates K role) (packingGraph f label)

lemma maskGraph_free (K : SimpleGraph W) (role : I → T → W)
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : K.CliqueFree k)
    (hf : (FullRootedPower.graph H M).Free G) :
    (maskGraph K role f label).CliqueFree (RamseyRoleMask.bound k M (Fintype.card T)) := by
  have h := RamseyRoleMask.union_cliqueFree (RamseyRoleMask.coordinates K role)
    (packingGraph f label) k M (packingGraph_free f label hroots M hM hf)
    (RamseyRoleMask.coordinates_free K role k hK)
  simpa only [RamseyRoleMask.coordinates_length] using h

lemma maskGraph_nonadj (K : SimpleGraph W) (role : I → T → W)
    (f : I → H →g G) (label : I → J) (i j : I) (he : label i=label j) :
    ¬(maskGraph K role f label).Adj i j ↔
      RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ a, ¬K.Adj (role i a) (role j a) := by
  classical
  rw [maskGraph,RamseyRoleMask.union_nonadj,RamseyRoleMask.coordinates_nonadj]
  simp only [packingGraph,he,true_and,not_not]

variable [DecidableEq I] [DecidableEq J]

open Classical in
/-- Arbitrary nonnegative copy weights retain their full fiber energy.
Only the conflict pairs on the right are masked. -/
theorem weighted_bound (S : Finset I) (K : SimpleGraph W) (role : I → T → W)
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : K.CliqueFree k)
    (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀ i∈S, 0 ≤ w i) :
    (∑ e∈PackingEnergy.fiberPairs S label (fun _ _ => True), w e.1*w e.2) ≤
      (RamseyRoleMask.bound k M (Fintype.card T)-1:ℕ) *
        ∑ e∈PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ a, ¬K.Adj (role i a) (role j a)),
          w e.1*w e.2 := by
  classical
  let B := maskGraph K role f label
  let p := RamseyRoleMask.bound k M (Fintype.card T)
  have hp : 2 ≤ p := RamseyRoleMask.bound_ge_two k M _ hM
  have hB : B.CliqueFree p := maskGraph_free K role f label hroots k M hM hK hf
  have hn (r : J) : ¬∃ U⊆S.filter (fun i => label i=r), U.card=p ∧
      ∀ i∈U, ∀ j∈U, i≠j → ¬(¬B.Adj i j) := by
    rintro ⟨U,hU,hUc,hh⟩
    exact hB U ⟨fun i hi j hj hij => not_not.mp (hh i hi j hj hij),hUc⟩
  have hh := PackingEnergy.weighted_fiber_second_moment S label (fun i j => ¬B.Adj i j)
    (fun i hi => B.loopless i) (fun i hi j hj h ha => h (B.symm ha)) p hp hn w hw
  have he : PackingEnergy.fiberPairs S label (fun i j => ¬B.Adj i j)=
      PackingEnergy.fiberPairs S label (fun i j =>
        RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ a, ¬K.Adj (role i a) (role j a)) := by
    ext e
    simp only [PackingEnergy.fiberPairs,Finset.mem_filter]
    by_cases h : label e.1=label e.2
    · simp only [h,true_and,maskGraph_nonadj K role f label e.1 e.2 h,B]
    · simp [h]
  rw [PackingEnergy.sum_fiber_mass_sq,he] at hh
  exact hh

open Classical in
/-- Unweighted finite-pair form of the all-coordinate restriction. -/
theorem pair_bound (S : Finset I) (K : SimpleGraph W) (role : I → T → W)
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : K.CliqueFree k)
    (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound k M (Fintype.card T)-1) *
        (PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ a, ¬K.Adj (role i a) (role j a))).card := by
  have h := weighted_bound S K role f label hroots k M hM hK hf (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

/-- The actual finite family interface, using instance-independent cardinalities. -/
theorem family_bound [Fintype J] (F : J → Type*) [∀ j, Fintype (F j)]
    (K : SimpleGraph W) (role : Sigma F → T → W) (f : Sigma F → H →g G)
    (hroots : ∀ p q, p.1=q.1 → ∀ r, f p (.inr r)=f q (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : K.CliqueFree k)
    (hf : (FullRootedPower.graph H M).Free G) :
    Nat.card (FiberRestrictionEnergy.Agreement F) ≤
      (RamseyRoleMask.bound k M (Fintype.card T)-1) *
      Nat.card {p : Sigma F × Sigma F // p.1.1=p.2.1 ∧
        RootedHomEnergy.Conflict (f p.1) (f p.2) ∧
          ∀ a, ¬K.Adj (role p.1 a) (role p.2 a)} := by
  classical
  have h := pair_bound (univ : Finset (Sigma F)) K role f Sigma.fst hroots k M hM hK hf
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
    PackingEnergy.pairs,true_and,and_true,univ_product_univ] using h

end Erdos571.RamseyLightConflict


/-! Representative traces may be restricted to selected endpoint pairs.
This permits codegree caps only on pairs actually being counted. -/
set_option maxHeartbeats 1500000
namespace Erdos571.IncidenceTrace
open Finset SimpleGraph ProjectionHeavy PatternCone SixCycleCase BipartiteCycleBounds
variable {L R : Type} [DecidableEq L] [DecidableEq R] [Fintype L]

theorem restricted_representatives {V : Type} [Fintype V]
    (H : SimpleGraph V) (E : Finset (L×R)) (B : Finset R)
    (O : Finset (Sym2 L × R)) (hO : O ⊆ candidates E B)
    (hf : ¬Contains (incidence H) E univ B) :
    ∃ M ⊆ O,
      Set.InjOn Prod.fst (M : Set (Sym2 L × R)) ∧
      Set.InjOn Prod.snd (M : Set (Sym2 L × R)) ∧
      (∀ e b, (e,b)∈O → b∉M.image Prod.snd → e∈M.image Prod.fst) ∧
      ∃ Q : SimpleGraph L, H.Free Q ∧ Nat.card Q.edgeSet=M.card ∧
        Q.edgeSet=(M.image Prod.fst : Set (Sym2 L)) := by
  classical
  obtain ⟨M,hMO,hL,hR,hmax⟩ := maximal_matching O
  let S := M.image Prod.fst
  let Q := fromEdgeSet (S : Set (Sym2 L))
  have hS (e : Sym2 L) (he : e∈S) : ¬e.IsDiag := by
    obtain ⟨p,hp,rfl⟩ := mem_image.mp he
    exact ((mem_candidates E B _ _).mp (hO (hMO hp))).2.1
  have hQE : Q.edgeSet=(S : Set (Sym2 L)) := by
    ext e
    simp only [Q,edgeSet_fromEdgeSet,Set.mem_diff,Sym2.mem_diagSet_iff_isDiag]
    exact ⟨fun h => h.1,fun h => ⟨h,hS e h⟩⟩
  have hfind (e : Q.edgeSet) : ∃b, (e.val,b)∈M := by
    have he : e.val∈S := by
      change e.val∈(S:Set (Sym2 L))
      rw [←hQE]
      exact e.property
    obtain ⟨⟨e',b⟩,hp,he⟩ := mem_image.mp he
    dsimp only [Prod.fst] at he
    subst e'
    exact ⟨b,hp⟩
  choose col hcol using hfind
  have hcolinj : Function.Injective col := by
    intro e f h
    exact Subtype.ext (congrArg Prod.fst (hR (hcol e) (hcol f) h))
  have hcolB (e : Q.edgeSet) : col e∈B :=
    ((mem_candidates E B _ _).mp (hO (hMO (hcol e)))).1
  have hcolE (e : Q.edgeSet) (v : L) (hv : v∈e.val) : (v,col e)∈E :=
    ((mem_candidates E B _ _).mp (hO (hMO (hcol e)))).2.2 v hv
  have hQfree : H.Free Q := by
    rintro ⟨f⟩
    let edge := f.toHom.mapEdgeSet
    apply hf
    refine ⟨f,fun e => col (edge e),f.injective,?_,fun _ => mem_univ _,?_,?_⟩
    · exact hcolinj.comp (Hom.mapEdgeSet.injective f.toHom f.injective)
    · exact fun e => hcolB (edge e)
    · intro v e hve
      exact hcolE (edge e) (f v) (Sym2.mem_map.mpr ⟨v,hve,rfl⟩)
  have hcard : Nat.card Q.edgeSet=M.card := by
    rw [hQE,Nat.card_eq_fintype_card]
    have hc := Fintype.card_of_finset' (p := (S : Set (Sym2 L))) S (fun _ => Iff.rfl)
    rw [hc]
    exact card_image_of_injOn hL
  exact ⟨M,hMO,hL,hR,hmax,Q,hQfree,hcard,hQE⟩

theorem restricted_trace_on {V : Type} [Fintype V]
    (H : SimpleGraph V) {α C : ℝ} (hbound : EdgeBound H α C)
    (E : Finset (L×R)) (A : Finset L) (B : Finset R)
    (O : Finset (Sym2 L × R)) (hO : O ⊆ candidates E B)
    (hEA : ∀ p∈E, p.1∈A)
    (hf : ¬Contains (incidence H) E univ B) (a b : ℕ)
    (ha : ∀ e, (O.filter (fun p => p.1=e)).card ≤ a)
    (hb : ∀ r, (O.filter (fun p => p.2=r)).card ≤ b) :
    (O.card:ℝ) ≤ (a+b:ℕ)*C*(A.card:ℝ)^α := by
  classical
  obtain ⟨M,hMO,hL,hR,hcover,Q,hQ,hcard,hQE⟩ := restricted_representatives H E B O hO hf
  have hsupp : Q.support ⊆ (A : Set L) := by
    intro x hx
    obtain ⟨y,hxy⟩ := hx
    have he : s(x,y)∈Q.edgeSet := hxy
    rw [hQE] at he
    obtain ⟨p,hp,he⟩ := mem_image.mp he
    have hh := (mem_candidates E B _ _).mp (hO (hMO hp))
    exact hEA (x,p.2) (hh.2.2 x (by simp [he]))
  have hQi : H.Free (Q.induce (A : Set L)) := by
    intro hc
    exact hQ (hc.trans ⟨Copy.induce Q (A : Set L)⟩)
  have he := hbound.estimate (Q.induce (A : Set L)) hQi
  have hcards : Nat.card (Q.induce (A : Set L)).edgeSet=M.card := by
    have hq := Q.card_edgeFinset_induce_of_support_subset hsupp
    have hq' : Nat.card (Q.induce (A : Set L)).edgeSet=Nat.card Q.edgeSet := by
      simpa only [←card_edgeSet,←Nat.card_eq_fintype_card] using hq
    exact hq'.trans hcard
  have haCard : Fintype.card (A : Set L)=A.card :=
    Fintype.card_of_finset' (p := (A : Set L)) A (fun _ => Iff.rfl)
  rw [hcards,haCard] at he
  have hc := card_le_fiber_caps O M hL hR hcover a b ha hb
  exact (show (O.card:ℝ) ≤ (a+b:ℕ)*(M.card:ℝ) by exact_mod_cast hc).trans
    ((mul_le_mul_of_nonneg_left he (Nat.cast_nonneg (a+b))).trans_eq (by ring))

/-- An arbitrary restricted trace also controls its ordered orientations. -/
theorem oriented_restricted_card_le (O : Finset (Sym2 L × R))
    (F : Finset ((L×L)×R))
    (hF : ∀ t∈F, (s(t.1.1,t.1.2),t.2)∈O) : F.card ≤ 2*O.card := by
  classical
  let f : ((L×L)×R) → (Sym2 L × R) := fun t => (s(t.1.1,t.1.2),t.2)
  have h := card_le_mul_card_image (f := f) F 2 (fun p _ => ordered_fiber_card F p)
  have hs : F.image f ⊆ O := by
    intro p hp
    obtain ⟨t,ht,rfl⟩ := mem_image.mp hp
    exact hF t ht
  exact h.trans (Nat.mul_le_mul_left _ (card_le_card hs))

end Erdos571.IncidenceTrace


/-! A local four-walk trace with all relevant two-walk pairs light.
Unlike the earlier unmasked trace, no global codegree cap is assumed. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LocalMaskedTrace
open Finset SimpleGraph ProjectionHeavy PatternCone BipartiteCycleBounds LocalFourthWalk
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

def allowedPair (L : ℕ) (e : Sym2 W) : Prop :=
  ∀ a∈e, ∀ b∈e, a≠b → (common G a b).card ≤ L

lemma allowedPair_mk (L : ℕ) (u v : W) (hc : (common G u v).card ≤ L) :
    allowedPair G L s(u,v) := by
  intro a ha b hb hab
  rcases Sym2.mem_iff.mp ha with rfl|rfl <;> rcases Sym2.mem_iff.mp hb with rfl|rfl
  · exact (hab rfl).elim
  · exact hc
  · simpa only [LocalFourthWalk.common,inter_comm] using hc
  · exact (hab rfl).elim

noncomputable def lightCandidates (L : ℕ) (E : Finset (W×W)) (B : Finset W) :
    Finset (Sym2 W × W) := by
  classical
  exact (IncidenceTrace.candidates E B).filter (fun p => allowedPair G L p.1)

lemma lightCandidates_subset (L : ℕ) (E : Finset (W×W)) (B : Finset W) :
    lightCandidates G L E B ⊆ IncidenceTrace.candidates E B := by
  classical
  exact filter_subset _ _

lemma lightCandidates_row_cap (L : ℕ) (E : Finset (W×W)) (B : Finset W)
    (hE : ∀ p∈E, G.Adj p.1 p.2) (e : Sym2 W) :
    ((lightCandidates G L E B).filter (fun p => p.1=e)).card ≤ L := by
  classical
  induction e using Sym2.inductionOn with
  | hf u v =>
    let F := (lightCandidates G L E B).filter (fun p => p.1=s(u,v))
    by_cases hz : F=∅
    · simp only [F] at hz
      rw [hz,card_empty]
      omega
    obtain ⟨p,hp⟩ := Finset.nonempty_iff_ne_empty.mpr hz
    have hp' := mem_filter.mp hp
    have hpL := mem_filter.mp hp'.1
    have hpC := (IncidenceTrace.mem_candidates E B _ _).mp hpL.1
    have huv : u≠v := by
      intro he
      apply hpC.2.1
      rw [hp'.2,he]
      simp
    have hc : (common G u v).card ≤ L := hpL.2 u (by simp [hp'.2]) v (by simp [hp'.2]) huv
    apply (card_le_card_of_injOn Prod.snd ?_ ?_).trans hc
    · intro q hq
      have hq' := mem_filter.mp hq
      have hqC := (IncidenceTrace.mem_candidates E B _ _).mp (mem_filter.mp hq'.1).1
      exact (mem_common G u v _).mpr
        ⟨hE _ (hqC.2.2 u (by simp [hq'.2])),hE _ (hqC.2.2 v (by simp [hq'.2]))⟩
    · intro p hp q hq he
      exact Prod.ext ((mem_filter.mp hp).2.trans (mem_filter.mp hq).2.symm) he

lemma lightCandidates_column_cap (L b : ℕ) (E : Finset (W×W)) (B : Finset W)
    (hb : ∀ r∈B, (nl E univ r).card ≤ b) (r : W) :
    ((lightCandidates G L E B).filter (fun p => p.2=r)).card ≤ b^2 := by
  classical
  apply (card_le_card ?_).trans (IncidenceTrace.candidates_column_cap E B b hb r)
  intro p hp
  exact mem_filter.mpr ⟨lightCandidates_subset G L E B (mem_filter.mp hp).1,(mem_filter.mp hp).2⟩

/-- Each copy has a light arm; the two middle roles are equal or light. -/
def maskedWalks (L : ℕ) (u v : W) : Finset ((W×W)×W) :=
  (walks G u v).filter (fun t => t.2≠u ∧ t.2≠v ∧
    (common G u t.2).card ≤ L ∧ (common G v t.2).card ≤ L ∧
      (t.1.1=t.1.2 ∨ (common G t.1.1 t.1.2).card ≤ L))

variable {V : Type} [Fintype V]

/-- The only endpoint codegree hypothesis concerns this one pair `u,v`.
All other caps are imposed by the counted walk predicate. -/
theorem off_diagonal_bound (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (htri : ∀ x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    (L D : ℕ) (hdeg : ∀ x, G.degree x ≤ D) (u v : W)
    (hcap : (common G u v).card ≤ L) :
    ((maskedWalks G L u v).card:ℝ) ≤
      2*(L+(2*L)^2:ℕ)*C*(2*(D:ℝ))^α+(L:ℝ)*D := by
  classical
  let A := G.neighborFinset u ∪ G.neighborFinset v
  let B := (univ \ (A∪{u,v})).filter (fun z =>
    (common G u z).card ≤ L ∧ (common G v z).card ≤ L)
  let E := (A×ˢB).filter (fun p => G.Adj p.1 p.2)
  let F := (maskedWalks G L u v).filter (fun t => t.1.1≠t.1.2)
  let O := lightCandidates G L E B
  have hEA : ∀ p∈E, p.1∈A := by
    intro p hp
    exact (mem_product.mp (mem_filter.mp hp).1).1
  have hdis : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro x hx hxB
    exact (Finset.mem_sdiff.mp (mem_filter.mp hxB).1).2 (mem_union_left _ hx)
  have hfree : ¬Contains (incidence H) E univ B :=
    contains_univ_false H hH A B E hEA (PatternCone.cut_not_contains (incidence H) G hf A B hdis)
  have hmid (z : W) (hz : z∈B) : (nl E univ z).card ≤ 2*L := by
    have hs : nl E univ z ⊆ common G u z ∪ common G v z := by
      intro x hx
      have he := (mem_filter.mp hx).2
      have hxa := hEA _ he
      have hxz := (mem_filter.mp he).2
      rcases mem_union.mp hxa with hxu|hxv
      · exact mem_union_left _ ((mem_common G u z x).mpr
          ⟨(G.mem_neighborFinset _ _).mp hxu,hxz.symm⟩)
      · exact mem_union_right _ ((mem_common G v z x).mpr
          ⟨(G.mem_neighborFinset _ _).mp hxv,hxz.symm⟩)
    have hc := (mem_filter.mp hz).2
    exact (card_le_card hs).trans ((card_union_le _ _).trans (by omega))
  have hF : ∀ t∈F, (s(t.1.1,t.1.2),t.2)∈O := by
    intro t ht
    obtain ⟨ht,hxy⟩ := mem_filter.mp ht
    obtain ⟨ht,hzu,hzv,hlu,hlv,hlxy⟩ := mem_filter.mp ht
    have hh := (mem_walks G u v t).mp ht
    have hx : t.1.1∈A := mem_union_left _ ((G.mem_neighborFinset _ _).mpr hh.1)
    have hy : t.1.2∈A := mem_union_right _ ((G.mem_neighborFinset _ _).mpr hh.2.2.2.symm)
    have hz : t.2∈B := by
      apply mem_filter.mpr
      refine ⟨Finset.mem_sdiff.mpr ⟨mem_univ _,?_⟩,hlu,hlv⟩
      intro hz
      rcases mem_union.mp hz with hz|hz
      · rcases mem_union.mp hz with hu|hv
        · exact htri u t.1.1 t.2 hh.1 hh.2.1 ((G.mem_neighborFinset _ _).mp hu)
        · exact htri v t.1.2 t.2 hh.2.2.2.symm hh.2.2.1.symm ((G.mem_neighborFinset _ _).mp hv)
      · simp only [mem_insert,mem_singleton] at hz
        exact hz.elim hzu hzv
    apply mem_filter.mpr
    refine ⟨(IncidenceTrace.mem_candidates E B _ _).mpr ⟨hz,?_,?_⟩,
      allowedPair_mk G L _ _ (hlxy.resolve_left hxy)⟩
    · simpa only [Sym2.isDiag_iff_proj_eq] using hxy
    · intro x hx'
      rcases Sym2.mem_iff.mp hx' with rfl|rfl
      · exact mem_filter.mpr ⟨mem_product.mpr ⟨hx,hz⟩,hh.2.1⟩
      · exact mem_filter.mpr ⟨mem_product.mpr ⟨hy,hz⟩,hh.2.2.1.symm⟩
  have hfcard := IncidenceTrace.oriented_restricted_card_le O F hF
  have htrace := IncidenceTrace.restricted_trace_on H hbound E A B O
    (lightCandidates_subset G L E B) hEA hfree L ((2*L)^2)
    (lightCandidates_row_cap G L E B (fun p hp => (mem_filter.mp hp).2))
    (lightCandidates_column_cap G L (2*L) E B hmid)
  have hac : A.card ≤ 2*D := by
    exact (card_union_le _ _).trans (by
      simp only [card_neighborFinset_eq_degree]
      have h₁ := hdeg u
      have h₂ := hdeg v
      omega)
  have hac' : (A.card:ℝ)^α ≤ (2*(D:ℝ))^α :=
    Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hac) hα
  have hgood : (F.card:ℝ) ≤ 2*(L+(2*L)^2:ℕ)*C*(2*(D:ℝ))^α := by
    have h₁ : (F.card:ℝ) ≤ 2*(O.card:ℝ) := by exact_mod_cast hfcard
    have h₂ := mul_le_mul_of_nonneg_left htrace (by norm_num : (0:ℝ)≤2)
    have h₃ := mul_le_mul_of_nonneg_left hac' (by positivity : 0≤2*(L+(2*L)^2:ℕ)*C)
    exact h₁.trans ((h₂.trans_eq (by ring)).trans h₃)
  let X := (maskedWalks G L u v).filter (fun t => t.1.1=t.1.2)
  have hx : X.card ≤ D*L := by
    apply (card_le_card ?_).trans (repeated_endpoint_card G u v L D hcap hdeg)
    intro t ht
    exact mem_filter.mpr ⟨(mem_filter.mp (mem_filter.mp ht).1).1,(mem_filter.mp ht).2⟩
  have hcard : (maskedWalks G L u v).card ≤ X.card+F.card := by
    apply (card_le_card ?_).trans (card_union_le X F)
    intro t ht
    by_cases he : t.1.1=t.1.2
    · exact mem_union_left _ (mem_filter.mpr ⟨ht,he⟩)
    · exact mem_union_right _ (mem_filter.mpr ⟨ht,he⟩)
  have hcard' : ((maskedWalks G L u v).card:ℝ) ≤ (D:ℝ)*L+F.card := by
    exact_mod_cast hcard.trans (Nat.add_le_add_right hx _)
  linarith

end Erdos571.LocalMaskedTrace


/-! Uniform density-scale decay for the restricted four-walk trace.
No global codegree bound is present. -/
set_option maxHeartbeats 1200000
namespace Erdos571.LocalMaskedTrace
open Finset SimpleGraph ProjectionHeavy LocalFourthWalk
variable {W : Type} [Fintype W] [DecidableEq W]
variable {V : Type} [Fintype V]

/-- Only the specified endpoint pair must be light; the other restrictions
are already part of `maskedWalks`. -/
theorem normalized_bound (H : SimpleGraph V)
    (hH : ∀ x, ∃ y, H.Adj x y) {α C : ℝ}
    (hα : 1 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G) (hb : G.IsBipartite)
    (L : ℕ) (d K : ℝ) (hd : 1 ≤ d) (hK : 0 ≤ K)
    (hdeg : ∀ x, (G.degree x:ℝ) ≤ K*d) (u v : W)
    (hcap : Fintype.card (G.commonNeighbors u v) ≤ L) :
    ((maskedWalks G L u v).card:ℝ)/d^2 ≤
      (2*(L+(2*L)^2:ℕ)*C*(2*K)^α+(L:ℝ)*K)*d^(α-2) := by
  have hD : (G.maxDegree:ℝ) ≤ K*d := by
    letI : Nonempty W := ⟨u⟩
    obtain ⟨x,hx⟩ := G.exists_maximal_degree_vertex
    rw [hx]
    exact hdeg x
  exact normalize_power_bound (by positivity) (by positivity) hα hd hK
    (Nat.cast_nonneg _) hD
    (off_diagonal_bound G H hH (by linarith) hC hbound hf
      (triangle_free_of_bipartite G hb) L G.maxDegree G.degree_le_maxDegree u v
      (by simpa only [LocalFourthWalk.common_card] using hcap))
end Erdos571.LocalMaskedTrace

namespace Erdos571.ThreeHub
open SimpleGraph Finset

/-- The constant is quantified before all host graphs. This is a bound for
restricted arm pairs, not for the unrestricted fourth-walk kernel. -/
theorem uniform_masked_normalized_bound (s M : ℕ) (hs : 1 ≤ s)
    (L : ℕ) (K : ℝ) (hK : 0 ≤ K) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ {W : Type} [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
        (graph s M).Free G → G.IsBipartite →
        ∀ d : ℝ, 1 ≤ d → (∀ x, (G.degree x:ℝ) ≤ K*d) →
        ∀ u v : W, Fintype.card (G.commonNeighbors u v) ≤ L →
          ((LocalMaskedTrace.maskedWalks G L u v).card:ℝ)/d^2 ≤
            C*d^(-(1/(2*(s:ℝ)+1))) := by
  obtain ⟨B,hB,hbound⟩ := uniform_base_edge_bound s (M+1) hs
  let C := 2*(L+(2*L)^2:ℕ)*B*(2*K)^(2-1/(2*(s:ℝ)+1))+(L:ℝ)*K
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro W _ _ G _ hf hb d hd hdeg u v huv
  have h := LocalMaskedTrace.normalized_bound _ (base_power_no_isolated s M)
    (uniform_base_exponent_bounds s).1 hB hbound G (subdivision_free s M G hf) hb
    L d K hd hK hdeg u v huv
  have he : (2-1/(2*(s:ℝ)+1))-2= -(1/(2*(s:ℝ)+1)) := by ring
  simpa only [he] using h
end Erdos571.ThreeHub


/-! Exact finite arm-pair interpretation of the all-light local trace.
The resulting kernel is nonnegative; no PSD claim is made. -/
set_option maxHeartbeats 1800000
namespace Erdos571.MaskedArmPairTrace
open Finset SimpleGraph Matrix LocalFourthWalk ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ)

def MiddleLight {u v r : W}
    (p : MaskedBush.Arm G (L:ℝ) u r × MaskedBush.Arm G (L:ℝ) v r) : Prop :=
  MaskedBush.middle G (L:ℝ) p.1=MaskedBush.middle G (L:ℝ) p.2 ∨
    (LocalFourthWalk.common G (MaskedBush.middle G (L:ℝ) p.1)
      (MaskedBush.middle G (L:ℝ) p.2)).card ≤ L

abbrev Raw (u v : W) := (r : W) × (MaskedBush.Arm G (L:ℝ) u r × MaskedBush.Arm G (L:ℝ) v r)
abbrev Family (u v : W) := {p : Raw G L u v // MiddleLight G L p.2}

lemma arm_light_iff (u r : W) : MaskedBush.Light G (L:ℝ) u r ↔
    u≠r ∧ (LocalFourthWalk.common G u r).card ≤ L := by
  rw [MaskedBush.Light,LayeredBush.adjacency_square_common_card,LocalFourthWalk.common_card]
  exact and_congr_right (fun _ => Nat.cast_le)

noncomputable def traceEquiv (u v : W) : Family G L u v ≃
    LocalMaskedTrace.maskedWalks G L u v where
  toFun p := by
    let a := MaskedBush.middle G (L:ℝ) p.val.2.1
    let b := MaskedBush.middle G (L:ℝ) p.val.2.2
    let r := p.val.1
    have h₁ := (arm_light_iff G L u r).mp (MaskedBush.arm_light G (L:ℝ) p.val.2.1)
    have h₂ := (arm_light_iff G L v r).mp (MaskedBush.arm_light G (L:ℝ) p.val.2.2)
    refine ⟨((a,b),r),mem_filter.mpr ⟨?_,h₁.1.symm,h₂.1.symm,h₁.2,h₂.2,p.property⟩⟩
    exact (mem_walks G u v _).mpr
      ⟨MaskedBush.arm_left G (L:ℝ) p.val.2.1,MaskedBush.arm_right G (L:ℝ) p.val.2.1,
        (MaskedBush.arm_right G (L:ℝ) p.val.2.2).symm,(MaskedBush.arm_left G (L:ℝ) p.val.2.2).symm⟩
  invFun p := by
    have hp := mem_filter.mp p.property
    have hh := (mem_walks G u v _).mp hp.1
    refine ⟨⟨p.val.2,⟨⟨(arm_light_iff G L u p.val.2).mpr ⟨hp.2.1.symm,hp.2.2.2.1⟩⟩,
      ⟨p.val.1.1,hh.1,hh.2.1.symm⟩⟩,
      ⟨⟨(arm_light_iff G L v p.val.2).mpr ⟨hp.2.2.1.symm,hp.2.2.2.2.1⟩⟩,
      ⟨p.val.1.2,hh.2.2.2.symm,hh.2.2.1⟩⟩⟩,hp.2.2.2.2.2⟩
  left_inv p := by
    apply Subtype.ext
    rcases p with ⟨⟨r,⟨hu,⟨a,ha⟩⟩,⟨hv,⟨b,hb⟩⟩⟩,hm⟩
    cases hu
    cases hv
    rfl
  right_inv p := by apply Subtype.ext; rfl

lemma family_card (u v : W) : Nat.card (Family G L u v)=(LocalMaskedTrace.maskedWalks G L u v).card := by
  classical
  rw [Nat.card_congr (traceEquiv G L u v),Nat.card_eq_fintype_card,Fintype.card_coe]

noncomputable def kernel : Matrix W W ℝ := fun u v => Nat.card (Family G L u v)

lemma nonneg (u v : W) : 0 ≤ kernel G L u v := Nat.cast_nonneg _

lemma raw_card (u v : W) : (Nat.card (Raw G L u v):ℝ)=
    (LightArmKernel.matrix G (L:ℝ)*(LightArmKernel.matrix G (L:ℝ)).transpose) u v := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  apply sum_congr rfl
  intro r _
  rw [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_arm,MaskedBush.card_arm]
  rfl

lemma kernel_le_gram (u v : W) : kernel G L u v ≤
    (LightArmKernel.matrix G (L:ℝ)*(LightArmKernel.matrix G (L:ℝ)).transpose) u v := by
  classical
  rw [←raw_card]
  unfold kernel
  exact_mod_cast Nat.card_le_card_of_injective (Subtype.val : Family G L u v → Raw G L u v)
    Subtype.val_injective

/-- The diagonal is bounded without any freeness assumption. -/
lemma diagonal_bound (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (u : W) :
    kernel G L u u ≤ (L:ℝ)*D^2 := by
  apply (kernel_le_gram G L u u).trans
  have hcap := LightArmKernel.cap G (L:ℝ) (Nat.cast_nonneg L)
  have hnon := LightArmKernel.nonneg G (L:ℝ)
  calc
    _ = ∑ r, LightArmKernel.matrix G (L:ℝ) u r * LightArmKernel.matrix G (L:ℝ) u r := rfl
    _ ≤ ∑ r, (L:ℝ)*LightArmKernel.matrix G (L:ℝ) u r :=
      sum_le_sum (fun r _ => mul_le_mul_of_nonneg_right (hcap u r) (hnon u r))
    _ ≤ _ := by
      rw [←mul_sum]
      exact mul_le_mul_of_nonneg_left (LightArmKernel.row_upper G (L:ℝ) D hD hdeg u) (Nat.cast_nonneg _)

variable {V : Type} [Fintype V]

/-- The local trace bound applies to the actual finite arm-pair kernel. -/
theorem normalized_bound (H : SimpleGraph V)
    (hH : ∀ x, ∃ y, H.Adj x y) {α C : ℝ}
    (hα : 1 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hb : G.IsBipartite)
    (d K : ℝ) (hd : 1 ≤ d) (hK : 0 ≤ K)
    (hdeg : ∀ x, (G.degree x:ℝ) ≤ K*d) (u v : W)
    (hcap : Fintype.card (G.commonNeighbors u v) ≤ L) :
    kernel G L u v/d^2 ≤
      (2*(L+(2*L)^2:ℕ)*C*(2*K)^α+(L:ℝ)*K)*d^(α-2) := by
  change (Nat.card (Family G L u v):ℝ)/d^2 ≤ _
  rw [family_card]
  exact LocalMaskedTrace.normalized_bound H hH hα hC hbound G hf hb L d K hd hK hdeg u v hcap

end Erdos571.MaskedArmPairTrace


/-! Independent root arms give powers of the actual restricted pair kernel. -/
set_option maxHeartbeats 1200000
namespace Erdos571.MaskedArmPairTrace
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ)
variable (I : Type) [Fintype I]

abbrev BundleFamily (u v : W) :=
  {p : (r : I → W) × (MaskedBush.Bundle G (L:ℝ) I u r × MaskedBush.Bundle G (L:ℝ) I v r) //
    ∀ i, MiddleLight G L (p.2.1 i,p.2.2 i)}

def bundleEquiv (u v : W) : BundleFamily G L I u v ≃ (I → Family G L u v) where
  toFun p i := ⟨⟨p.val.1 i,p.val.2.1 i,p.val.2.2 i⟩,p.property i⟩
  invFun p := ⟨⟨fun i => (p i).val.1,fun i => (p i).val.2.1,fun i => (p i).val.2.2⟩,
    fun i => (p i).property⟩
  left_inv p := by apply Subtype.ext; rfl
  right_inv p := by funext i; apply Subtype.ext; rfl

lemma bundle_card (u v : W) : (Nat.card (BundleFamily G L I u v):ℝ)=
    (kernel G L u v)^Fintype.card I := by
  rw [Nat.card_congr (bundleEquiv G L I u v),Nat.card_fun,Nat.card_eq_fintype_card (α := I),Nat.cast_pow]
  rfl

variable {I}

/-- A clique-free shadow's nonedges may be used instead of explicitly
bounding middle codegrees. This implication retains the actual arm data. -/
lemma middleLight_of_nonadj (H : SimpleGraph W) (cap : ℕ) (hcap : cap ≤ L)
    (hlight : ∀ x y, x≠y → ¬H.Adj x y → Fintype.card (G.commonNeighbors x y) ≤ cap)
    {u v r : W} (p : MaskedBush.Arm G (L:ℝ) u r × MaskedBush.Arm G (L:ℝ) v r)
    (hn : ¬H.Adj (MaskedBush.middle G (L:ℝ) p.1) (MaskedBush.middle G (L:ℝ) p.2)) :
    MiddleLight G L p := by
  by_cases he : MaskedBush.middle G (L:ℝ) p.1=MaskedBush.middle G (L:ℝ) p.2
  · exact Or.inl he
  · exact Or.inr (by rw [LocalFourthWalk.common_card]; exact (hlight _ _ he hn).trans hcap)

end Erdos571.MaskedArmPairTrace


/-! The all-coordinate Ramsey restriction for the ORIGINAL ThreeHub
assignment family. No assumption of injective individual assignments. -/
set_option maxHeartbeats 1600000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

lemma vertex_card : Fintype.card (Vertex s)=5+6*s := by
  simp only [Vertex,Interior,Core,Arm,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
  omega

open Classical in
abbrev LightConflicting (hs : 1 ≤ s) (H : SimpleGraph W) :=
  {p : Full s G L × Full s G L // p.1.1=p.2.1 ∧
    RootedHomEnergy.Conflict (ThreeHubAssignments.hom G L s hs p.1)
      (ThreeHubAssignments.hom G L s hs p.2) ∧
      ∀ v : Vertex s, ¬H.Adj (value s G L p.1 v) (value s G L p.2 v)}

/-- Full agreement energy is charged to conflicts that are light at all roles. -/
theorem light_conflict_bound (hs : 1 ≤ s) (H : SimpleGraph W) (k M : ℕ)
    (hH : H.CliqueFree k) (hM : 2 ≤ M) (hf : (ThreeHub.graph s M).Free G) :
    Nat.card (ThreeHubAssignments.Agreement G L s) ≤
      (RamseyRoleMask.bound k M (5+6*s)-1)*Nat.card (LightConflicting s G L hs H) := by
  classical
  have h := RamseyLightConflict.family_bound (ThreeHubAssignments.Fiber G L s)
    H (value s G L) (ThreeHubAssignments.hom G L s hs)
    (ThreeHubAssignments.same_roots G L s hs) k M hM hH hf
  simpa only [vertex_card] using h

end Erdos571.ThreeHubRoles


/-! Exact light-pair predicates for a chosen integral cutoff. -/
namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma graph_antitone (a b : ℕ) (hab : a ≤ b) : graph G univ b ≤ graph G univ a := by
  intro u v h
  exact ⟨h.1,hab.trans h.2⟩

lemma nonadj_succ (L : ℕ) (u v : W) : ¬(graph G univ (L+1)).Adj u v ↔
    u=v ∨ Fintype.card (G.commonNeighbors u v) ≤ L := by
  change ¬(u≠v ∧ L+1 ≤ (FourthMoment.common G univ u v).card) ↔ _
  rw [common_univ_card]
  by_cases he : u=v
  · simp [he]
  · constructor
    · intro hn
      right
      have hh : ¬L+1 ≤ Fintype.card (G.commonNeighbors u v) := fun h => hn ⟨he,h⟩
      omega
    · rintro (hh|hh)
      · exact (he hh).elim
      · rintro ⟨_,hc⟩
        omega

variable {V : Type} [Fintype V]
lemma cutoff_cliqueFree (H : SimpleGraph V) (L : ℕ)
    (hL : Fintype.card V+Nat.card H.edgeSet ≤ L+1)
    (hf : (ProjectionHeavy.subdivision H).Free G) :
    (graph G univ (L+1)).CliqueFree (Fintype.card V) :=
  SimpleGraph.CliqueFree.anti (graph_antitone G _ _ hL)
    (cliqueFree_of_subdivision_free H G univ hf)

end Erdos571.HostHeavyShadow


/-! Actual ThreeHub freeness supplies the clique-free shadow needed by
all-coordinate light-conflict restriction. -/
set_option maxHeartbeats 1600000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

/-- The cutoff may be increased to accommodate the light-arm mass bounds. -/
theorem actual_light_conflict_bound (hs : 1 ≤ s) (cap M : ℕ)
    (hcap : Fintype.card (ThreeHub.Branch s M) +
      Nat.card (FullRootedPower.graph (ThreeHub.base s) (M+1)).edgeSet ≤ cap+1)
    (hM : 2 ≤ M) (hf : (ThreeHub.graph s M).Free G) :
    Nat.card (ThreeHubAssignments.Agreement G L s) ≤
      (RamseyRoleMask.bound (Fintype.card (ThreeHub.Branch s M)) M (5+6*s)-1)*
        Nat.card (LightConflicting s G L hs (HostHeavyShadow.graph G univ (cap+1))) := by
  classical
  apply light_conflict_bound s G L hs _ _ M _ hM hf
  exact HostHeavyShadow.cutoff_cliqueFree G _ cap hcap (ThreeHub.subdivision_free s M G hf)

/-- Every coordinate in the charged pair is equal or has bounded codegree. -/
lemma lightConflict_coordinate (hs : 1 ≤ s) (cap : ℕ)
    (p : LightConflicting s G L hs (HostHeavyShadow.graph G univ (cap+1))) (v : Vertex s) :
    value s G L p.val.1 v=value s G L p.val.2 v ∨
      Fintype.card (G.commonNeighbors (value s G L p.val.1 v) (value s G L p.val.2 v)) ≤ cap :=
  (HostHeavyShadow.nonadj_succ G cap _ _).mp (p.property.2.2 v)

end Erdos571.ThreeHubRoles


/-! Charged ThreeHub conflicts retain actual restricted arm-pair data. -/
set_option maxHeartbeats 1600000
namespace Erdos571.ThreeHubRoles
open Finset SimpleGraph
variable (s : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

noncomputable def light_arm_pair (hs : 1 ≤ s) (cap : ℕ)
    (p : LightConflicting s G (cap:ℝ) hs (HostHeavyShadow.graph G univ (cap+1))) (a : Arm s) :
    MaskedArmPairTrace.Family G cap
      (ThreeHubAssignments.hubValue G (cap:ℝ) s p.val.1 a.1)
      (ThreeHubAssignments.hubValue G (cap:ℝ) s p.val.2 a.1) := by
  classical
  rcases p with ⟨⟨⟨r,x⟩,⟨t,y⟩⟩,he,hc,hl⟩
  change r=t at he
  subst t
  let left := ThreeHubAssignments.bundleAt G (cap:ℝ) s ⟨r,x⟩ a.1 a.2
  let right := ThreeHubAssignments.bundleAt G (cap:ℝ) s ⟨r,y⟩ a.1 a.2
  refine ⟨⟨ThreeHubAssignments.labelAt G (cap:ℝ) s ⟨r,x⟩ a.1 a.2,left,right⟩,?_⟩
  apply MaskedArmPairTrace.middleLight_of_nonadj G cap
    (HostHeavyShadow.graph G univ (cap+1)) cap le_rfl _ (left,right)
  · exact hl (.inl (.inr a))
  · intro u v hne hn
    exact ((HostHeavyShadow.nonadj_succ G cap u v).mp hn).resolve_left hne

end Erdos571.ThreeHubRoles

/-! Scalar aggregation at the NONSHARP ThreeHub density threshold. -/
set_option maxHeartbeats 1200000
namespace Erdos571.ThreeHubScalarThresholds

lemma scale_bound (n d B C a : ℝ) (hn : 0 ≤ n) (hd : 1 ≤ d) (hB : 0 ≤ B) (ha : 0 ≤ a)
    (s e q p : ℕ) (hqp : e*q ≤ p) (hC : C ≤ a*B^q) (hdense : B*n^s ≤ d^e) :
    C*n^(s*q) ≤ a*d^p := by
  have hpow := pow_le_pow_left₀ (mul_nonneg hB (pow_nonneg hn _)) hdense q
  have he : (B*n^s)^q=B^q*n^(s*q) := by rw [mul_pow,pow_mul]
  have he' : (d^e)^q=d^(e*q) := by rw [pow_mul]
  rw [he,he'] at hpow
  calc
    _ ≤ (a*B^q)*n^(s*q) := mul_le_mul_of_nonneg_right hC (pow_nonneg hn _)
    _ = a*(B^q*n^(s*q)) := by ring
    _ ≤ a*d^(e*q) := mul_le_mul_of_nonneg_left hpow ha
    _ ≤ _ := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hd hqp) ha

lemma relative_of_scaled_power (x E τ d : ℝ) (hE : 0 ≤ E) (hτ : 0 ≤ τ) (hd : 0 < d)
    (m e : ℕ) (hm : 1 ≤ m)
    (h : x^m*d^e ≤ τ^m*d^e*E^m) : x ≤ τ*E := by
  apply le_of_pow_le_pow_left₀ (by omega : m≠0) (mul_nonneg hτ hE)
  apply (mul_le_mul_iff_left₀ (pow_pos hd e)).mp
  convert h using 1 <;> simp only [mul_pow] <;> ring

lemma count_small (n d B C x E τ : ℝ) (hn : 0 ≤ n) (hd : 1 ≤ d)
    (hB : 0 ≤ B) (hE : 0 ≤ E) (hτ : 0 ≤ τ) (s e q p m : ℕ) (hm : 1 ≤ m)
    (hqp : e*q ≤ p) (hC : C ≤ τ^m*B^q) (hdense : B*n^s ≤ d^e)
    (hx : x^m*d^p ≤ C*n^(s*q)*E^m) : x ≤ τ*E := by
  have hd0 : 0 < d := by linarith
  apply relative_of_scaled_power x E τ d hE hτ hd0 m p hm
  exact hx.trans (mul_le_mul_of_nonneg_right
    (scale_bound n d B C (τ^m) hn hd hB (pow_nonneg hτ _) s e q p hqp hC hdense)
    (pow_nonneg hE _))

lemma deleted_small (n d B C x E K τ : ℝ) (hn : 0 ≤ n) (hd : 1 ≤ d)
    (hB : 0 ≤ B) (hE : 0 ≤ E) (hK : 0 < K) (hτ : 0 ≤ τ)
    (s e q p : ℕ) (hs : 1 ≤ s) (hqp : e*q ≤ p)
    (hC : C*K^s ≤ τ^s*B^q) (hdense : B*n^s ≤ d^e)
    (hx : x^s*d^(p+s) ≤ C*n^(s*q)*E^s) : x ≤ (τ/(K*d))*E := by
  have hd0 : 0 < d := by linarith
  have hKd : 0 < K*d := mul_pos hK hd0
  have hx' : (x*(K*d))^s*d^p ≤ (C*K^s)*n^(s*q)*E^s := by
    have hh := mul_le_mul_of_nonneg_right hx (pow_nonneg hK.le s)
    calc
      _ = (x^s*d^(p+s))*K^s := by rw [mul_pow,mul_pow,pow_add]; ring
      _ ≤ (C*n^(s*q)*E^s)*K^s := hh
      _ = _ := by ring
  have hc := count_small n d B (C*K^s) (x*(K*d)) E τ hn hd hB hE hτ
    s e q p s hs hqp hC hdense hx'
  calc
    x ≤ (τ*E)/(K*d) := (le_div_iff₀ hKd).mpr hc
    _ = _ := by ring

/-- A fixed large density coefficient controls each of the finitely many
pin/deletion scales. The two squared scales are not silently linearized. -/
lemma choose (s e : ℕ) (C₀ C₁ C₂ C₃ C₄ K τ : ℝ)
    (hC₀ : 0 ≤ C₀) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂) (hC₃ : 0 ≤ C₃) (hC₄ : 0 ≤ C₄)
    (hK : 0 ≤ K) (hτ : 0 < τ) :
    ∃ B : ℝ, 1 ≤ B ∧ (4*K)^e < B ∧
      C₀ ≤ τ*B ∧ C₁ ≤ τ^2*B ∧ C₂ ≤ τ^2*B^2 ∧
      C₃*K^s ≤ τ^s*B ∧ C₄*K^s ≤ τ^s*B^2 := by
  let B := 1+(4*K)^e+C₀/τ+C₁/τ^2+C₂/τ^2+C₃*K^s/τ^s+C₄*K^s/τ^s
  have h₀ : 0 ≤ C₀/τ := div_nonneg hC₀ hτ.le
  have h₁ : 0 ≤ C₁/τ^2 := div_nonneg hC₁ (sq_nonneg _)
  have h₂ : 0 ≤ C₂/τ^2 := div_nonneg hC₂ (sq_nonneg _)
  have h₃ : 0 ≤ C₃*K^s/τ^s := by positivity
  have h₄ : 0 ≤ C₄*K^s/τ^s := by positivity
  have hpow : 0 ≤ (4*K)^e := by positivity
  have hB : 1 ≤ B := by dsimp [B]; linarith
  have hBB : B ≤ B^2 := by nlinarith
  have hτ2 : 0 < τ^2 := pow_pos hτ _
  have hτs : 0 < τ^s := pow_pos hτ _
  refine ⟨B,hB,?_,?_,?_,?_,?_,?_⟩
  · dsimp [B]; linarith
  · have h : C₀/τ ≤ B := by dsimp [B]; linarith
    nlinarith [(div_le_iff₀ hτ).mp h]
  · have h : C₁/τ^2 ≤ B := by dsimp [B]; linarith
    nlinarith [(div_le_iff₀ hτ2).mp h]
  · have h : C₂/τ^2 ≤ B^2 := (by dsimp [B]; linarith : C₂/τ^2 ≤ B).trans hBB
    nlinarith [(div_le_iff₀ hτ2).mp h]
  · have h : C₃*K^s/τ^s ≤ B := by dsimp [B]; linarith
    nlinarith [(div_le_iff₀ hτs).mp h]
  · have h : C₄*K^s/τ^s ≤ B^2 := (by dsimp [B]; linarith : C₄*K^s/τ^s ≤ B).trans hBB
    nlinarith [(div_le_iff₀ hτs).mp h]

end Erdos571.ThreeHubScalarThresholds


/-! All finite ThreeHub core and deletion counts share the current
NONSHARP polynomial density scale. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHubNonsharp
open Finset SimpleGraph ThreeHubScalarThresholds

structure Scale (s M : ℕ) (K τ B : ℝ) : Prop where
  center : (4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2) ≤ τ*B
  endpoint : (8:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+1)*K^(4*s+2) ≤ τ^2*B
  middle : (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+2)*K^(4*s+4) ≤ τ^2*B^2
  deletedEndpoint : (4:ℝ)^s*K^4*K^s ≤ τ^s*B
  deletedCenter : (16:ℝ)^s*(ThreeHub.momentCoefficient s M)^s*K^(2*s+8)*K^s ≤ τ^s*B^2

lemma exists_scale (s M : ℕ) (K τ : ℝ) (hK : 0 ≤ K) (hτ : 0 < τ) :
    ∃ B : ℝ, 1 ≤ B ∧ (4*K)^(2*s+2) < B ∧ Scale s M K τ B := by
  have hC := ThreeHub.momentCoefficient_nonneg s M
  obtain ⟨B,hB,hl,h₀,h₁,h₂,h₃,h₄⟩ := ThreeHubScalarThresholds.choose s (2*s+2)
    ((4:ℝ)^s*(ThreeHub.momentCoefficient s M)^(s+1)*K^(2*s+2))
    ((8:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+1)*K^(4*s+2))
    ((16:ℝ)^s*(ThreeHub.momentCoefficient s M)^(2*s+2)*K^(4*s+4))
    ((4:ℝ)^s*K^4) ((16:ℝ)^s*(ThreeHub.momentCoefficient s M)^s*K^(2*s+8))
    K τ (by positivity) (by positivity) (by positivity) (by positivity) (by positivity) hK hτ
  exact ⟨B,hB,hl,⟨h₀,h₁,h₂,h₃,h₄⟩⟩

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- Every original core-role pin is small under one explicit scale. -/
theorem core_small (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K τ B : ℝ)
    (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hB : 0 ≤ B) (hτ : 0 ≤ τ) (hscale : Scale s M K τ B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L)
    (hdense : B*(Fintype.card W:ℝ)^s ≤ d^(2*s+2)) :
    ∀ c : ThreeHubRoles.Core, (Nat.card (ThreeHubRoles.Pin s G L (.inl c)):ℝ) ≤
      τ*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ) := by
  classical
  let E : ℝ := Nat.card (ThreeHubAssignments.Agreement G L s)
  let n : ℝ := Fintype.card W
  have hn : 0 ≤ n := Nat.cast_nonneg _
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have hd0 : 0 < d := by linarith
  have hcenter : (Nat.card (ThreeHubAssignments.Pin G L s (ThreeHubAssignments.center G L s)):ℝ) ≤ τ*E := by
    apply count_small n d B _ _ E τ hn hd hB hE hτ s (2*s+2) 1 (2*s+2) 1 (by omega)
      (by omega) (by simpa only [pow_one] using hscale.center) hdense
    simpa only [pow_one,mul_one] using ThreeHubAssignments.center_pin_mul_degree_le
        G s M hs hf L d K hL hd0 hK hdK hmin hmax hcut
  have hl : (Nat.card (ThreeHubAssignments.Pin G L s (ThreeHubAssignments.leftHub G L s)):ℝ) ≤ τ*E := by
    apply count_small n d B _ _ E τ hn hd hB hE hτ s (2*s+2) 1 (2*s+2) 2 (by omega)
      (by omega) (by simpa only [pow_one] using hscale.endpoint) hdense
    simpa only [mul_one] using ThreeHubAssignments.left_pin_sq_mul_degree_le
        G L s M hs hf d K hL hd0 hK hdK hmin hmax hcut
  have hr : (Nat.card (ThreeHubAssignments.Pin G L s (ThreeHubAssignments.rightHub G L s)):ℝ) ≤ τ*E := by
    apply count_small n d B _ _ E τ hn hd hB hE hτ s (2*s+2) 1 (2*s+2) 2 (by omega)
      (by omega) (by simpa only [pow_one] using hscale.endpoint) hdense
    simpa only [mul_one] using ThreeHubAssignments.right_pin_sq_mul_degree_le
        G L s M hs hf d K hL hd0 hK hdK hmin hmax hcut
  have hlm : (Nat.card (ThreeHubAssignments.Pin G L s (ThreeHubAssignments.leftCoreMiddle G L s)):ℝ) ≤ τ*E := by
    apply count_small n d B _ _ E τ hn hd hB hE hτ s (2*s+2) 2 (4*s+4) 2 (by omega)
      (by omega) hscale.middle hdense
    simpa only [show s*2=2*s by omega] using ThreeHubAssignments.left_core_pin_sq_mul_degree_le
      G L s M hs hf d K hL hd0 hK hdK hmin hmax hcut
  have hrm : (Nat.card (ThreeHubAssignments.Pin G L s (ThreeHubAssignments.rightCoreMiddle G L s)):ℝ) ≤ τ*E := by
    apply count_small n d B _ _ E τ hn hd hB hE hτ s (2*s+2) 2 (4*s+4) 2 (by omega)
      (by omega) hscale.middle hdense
    simpa only [show s*2=2*s by omega] using ThreeHubAssignments.right_core_pin_sq_mul_degree_le
      G L s M hs hf d K hL hd0 hK hdK hmin hmax hcut
  rintro (i|i)
  · fin_cases i
    · exact hl
    · exact hcenter
    · exact hr
  · fin_cases i
    · exact hlm
    · exact hrm

/-- The four same-copy core identifications obey the same linear scale. -/
theorem core_collisions_small (s M : ℕ) (hs : 1 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K τ B : ℝ)
    (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hB : 0 ≤ B) (hτ : 0 ≤ τ) (hscale : Scale s M K τ B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L)
    (hdense : B*(Fintype.card W:ℝ)^s ≤ d^(2*s+2))
    (c : ThreeHubMixed.CoreCollision) :
    (Nat.card (FiberRestrictionEnergy.Both (ThreeHubMixed.Fiber G L (Fin s) (Fin s) (Fin s))
      (ThreeHubMixed.CoreCollision.predicate G L c)):ℝ) ≤
      τ*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ) := by
  have hd0 : 0 < d := by linarith
  apply count_small (Fintype.card W:ℝ) d B _ _ _ τ (Nat.cast_nonneg _) hd hB (Nat.cast_nonneg _) hτ
    s (2*s+2) 1 (2*s+2) 1 (by omega) (by omega)
    (by simpa only [pow_one] using hscale.center) hdense
  simpa only [pow_one,mul_one] using ThreeHubMixed.core_collision_bound
      G L s M hs c hf d K hL hd0 hK hdK hmin hmax hcut

/-- Multiplication by maximum-degree scale is affordable for every deletion
when `s>=4`; no larger density exponent is introduced. -/
theorem deletions_small (s M : ℕ) (hs : 4 ≤ s)
    (hf : (ThreeHub.graph s M).Free G) (L d K τ B : ℝ)
    (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hB : 0 ≤ B) (hτ : 0 ≤ τ) (hscale : Scale s M K τ B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L)
    (hdense : B*(Fintype.card W:ℝ)^s ≤ d^(2*s+2))
    (r : ThreeHubRoles.Arm s) :
    (Nat.card (FiberRestrictionEnergy.Agreement (ThreeHubRoles.deletionWitness s G L r).E):ℝ) ≤
      (τ/(K*d))*(Nat.card (ThreeHubAssignments.Agreement G L s):ℝ) := by
  have hd0 : 0 < d := by linarith
  have hK0 : 0 < K := by linarith
  apply ThreeHubRoles.deleted_witness_bound s G L _ _ _ _ r
  · intro i
    apply deleted_small (Fintype.card W:ℝ) d B _ _ _ K τ (Nat.cast_nonneg _) hd hB
      (Nat.cast_nonneg _) hK0 hτ s (2*s+2) 2 (5*s) (by omega) (by omega)
      hscale.deletedCenter hdense
    simpa only [show 5*s+s=6*s by omega,show s*2=2*s by omega] using
      ThreeHubMixed.central_deleted_bound G s M (by omega) i hf d K L hL hd0 hK hdK hmin hmax hcut
  · intro i
    apply deleted_small (Fintype.card W:ℝ) d B _ _ _ K τ (Nat.cast_nonneg _) hd hB
      (Nat.cast_nonneg _) hK0 hτ s (2*s+2) 1 (3*s) (by omega) (by omega)
      (by simpa only [pow_one] using hscale.deletedEndpoint) hdense
    simpa only [show 3*s+s=4*s by omega,mul_one] using
      ThreeHubMixed.left_deleted_bound G s M (by omega) i hf d K L hL hd0 hK hdK hmin hmax hcut
  · intro i
    apply deleted_small (Fintype.card W:ℝ) d B _ _ _ K τ (Nat.cast_nonneg _) hd hB
      (Nat.cast_nonneg _) hK0 hτ s (2*s+2) 1 (3*s) (by omega) (by omega)
      (by simpa only [pow_one] using hscale.deletedEndpoint) hdense
    simpa only [show 3*s+s=4*s by omega,mul_one] using
      ThreeHubMixed.right_deleted_bound G s M (by omega) i hf d K L hL hd0 hK hdK hmin hmax hcut

end Erdos571.ThreeHubNonsharp


/-! Positive light row mass gives an actual finite assignment, even though
individual assignments are allowed to repeat vertices. -/
set_option maxHeartbeats 1600000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem agreement_pos (s M : ℕ) (hf : (ThreeHub.graph s M).Free G) (L d K : ℝ)
    (hL : 0 < L) (hd : 0 < d) (hK : 1 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*ThreeHub.momentCoefficient s M*K^2 ≤ L) :
    0 < (Nat.card (Agreement G L s):ℝ) := by
  classical
  let C := ThreeHub.momentCoefficient s M
  let T := C*(K*d)^2
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hK0 : 0 ≤ K := by linarith
  have hm (u : W) : ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T :=
    ThreeHub.free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK0 hd.le) hmax u
  have hrow (u : W) : d^2/2 ≤ ∑ v, LightArmKernel.matrix G L u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hm
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  let u : W := Classical.arbitrary W
  have hpos : 0 < ∑ v, LightArmKernel.matrix G L u v :=
    (by positivity : 0 < d^2/2).trans_le (hrow u)
  obtain ⟨r,hr,har⟩ := Finset.sum_pos_iff_of_nonneg (fun v _ => LightArmKernel.nonneg G L u v) |>.mp hpos
  have har' : 0 < Fintype.card (MaskedBush.Arm G L u r) := by
    have hh : (0:ℝ) < Fintype.card (MaskedBush.Arm G L u r) := by
      rw [MaskedBush.card_arm]
      exact har
    exact_mod_cast hh
  let arm : MaskedBush.Arm G L u r := Classical.choice (Fintype.card_pos_iff.mp har')
  have hdu : 0 < G.degree u := by exact_mod_cast hd.trans_le (hmin u)
  obtain ⟨w,hw⟩ := Finset.card_pos.mp (show 0<(G.neighborFinset u).card by simpa using hdu)
  have huw : G.Adj u w := (G.mem_neighborFinset u w).mp hw
  let cm : G.commonNeighbors u u := ⟨w,huw,huw⟩
  let roots : Roots (W := W) s := (fun _ => r,fun _ => r,fun _ => r)
  let bundle : Bundle G L s u (fun _ => r) := fun _ => arm
  let side : Side G L s u (fun _ => r) := ⟨u,cm,bundle⟩
  let p : Full G L s := ⟨roots,u,bundle,side,side⟩
  letI : Nonempty (Agreement G L s) := ⟨⟨(p,p),rfl⟩⟩
  exact_mod_cast (Nat.card_pos (α := Agreement G L s))

end Erdos571.ThreeHubAssignments


/-! A fully unrestricted but NONSHARP degree bound for original ThreeHub
powers. The threshold is s/(2s+2), not (3s-1)/(6s+4). -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubNonsharp
open Finset SimpleGraph Matrix

theorem free_degree_bound (s M : ℕ) (hs : 4 ≤ s) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K) :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) →
      (ThreeHub.graph s M).Free G →
      d^(2*s+2) < B*(Fintype.card W:ℝ)^s := by
  classical
  let C := ThreeHub.momentCoefficient s M
  let k := Fintype.card (ThreeHub.Branch s M)
  let t := k+Nat.card (FullRootedPower.graph (ThreeHub.base s) (M+1)).edgeSet
  let cap : ℕ := Nat.ceil (4*C*K^2+1+(t:ℝ))
  have hC : 0 ≤ C := ThreeHub.momentCoefficient_nonneg s M
  have hK0 : 0 ≤ K := by linarith
  have hk : 2 ≤ k := ThreeHub.branch_card_ge s M
  have hcap : 4*C*K^2+1+(t:ℝ) ≤ (cap:ℝ) := Nat.le_ceil _
  have hcut : 4*C*K^2 ≤ (cap:ℝ) := by have ht0 : (0:ℝ) ≤ t := Nat.cast_nonneg _; linarith
  have htc : t ≤ cap := by
    have hh : (t:ℝ) ≤ (cap:ℝ) := by nlinarith [mul_nonneg hC (sq_nonneg K)]
    exact_mod_cast hh
  have hcapPos : (0:ℝ) < cap := by nlinarith [mul_nonneg hC (sq_nonneg K),(show (0:ℝ) ≤ t from Nat.cast_nonneg t)]
  let c : ℝ := (k-1:ℕ)
  have hc : 1 ≤ c := by dsimp [c]; exact_mod_cast (show 1 ≤ k-1 by omega)
  let pack : ℝ := (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
    (A := RootedSubdivision.Nonroot (ThreeHub.base s))
    (R := RootedSubdivision.Root (ThreeHub.base s))):ℝ)+
      (Nat.card (RootedSubdivision.Nonroot (ThreeHub.base s)):ℝ)^2)
  have hpack : 0 ≤ pack := by dsimp [pack]; positivity
  obtain ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,hpSmall,hattach,hroot⟩ :=
    MaskedBushCoefficients.choose pack c cap hpack hc (Nat.cast_nonneg _)
  obtain ⟨B,hB1,hBlarge,hscale⟩ := exists_scale s M K τ hK0 hτ
  have hB : 0 < B := by linarith
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W:ℝ)^s ≤ d^(2*s+2) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Nat.card (ThreeHubAssignments.Agreement G (cap:ℝ) s)
  have hn1 : 1 ≤ n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hn : 0 < n := by linarith
  have hdpos : 0 < d := by linarith
  have hD1 : 1 ≤ D := by dsimp [D]; nlinarith
  have hD : 0 < D := by linarith
  have hd4 : 4*K ≤ d := by
    by_contra hh
    have hdp : d^(2*s+2) ≤ (4*K)^(2*s+2) := pow_le_pow_left₀ hdpos.le (le_of_not_ge hh) _
    have hpow : 1 ≤ n^s := one_le_pow₀ hn1
    have hlow : B ≤ B*n^s := by nlinarith
    exact (not_lt_of_ge ((hdense.trans hdp).trans' hlow)) hBlarge
  have hmax (u : W) : (G.degree u:ℝ) ≤ D := (hdeg u).2
  have hmin (u : W) : d ≤ (G.degree u:ℝ) := (hdeg u).1
  have hEpos : 0 < E := ThreeHubAssignments.agreement_pos G s M hf cap d K hcapPos hdpos hK hd4 hmin hmax hcut
  have hcore := core_small G s M (by omega) hf cap d K τ B hcapPos hd hK hd4 hB.le hτ.le hscale
    hmin hmax hcut hdense
  have hcoll := core_collisions_small G s M (by omega) hf cap d K τ B hcapPos hd hK hd4 hB.le hτ.le hscale
    hmin hmax hcut hdense
  have hdel := deletions_small G s M hs hf cap d K τ B hcapPos hd hK hd4 hB.le hτ.le hscale
    hmin hmax hcut hdense
  let H := HostHeavyShadow.graph G univ t
  have hH : H.CliqueFree k := HostHeavyShadow.cliqueFree_of_subdivision_free
    (FullRootedPower.graph (ThreeHub.base s) (M+1)) G univ (ThreeHub.subdivision_free s M G hf)
  have hlight (u v : W) (hnon : ¬H.Adj u v) (hne : u≠v) : Fintype.card (G.commonNeighbors u v) ≤ cap := by
    have ht : (FourthMoment.common G univ u v).card < t := by
      by_contra hh
      exact hnon ⟨hne,le_of_not_gt hh⟩
    rw [HostHeavyShadow.common_univ_card] at ht
    exact ht.le.trans htc
  have hDmax : (G.maxDegree:ℝ) ≤ D := by
    obtain ⟨u,hu⟩ := G.exists_maximal_degree_vertex
    rw [hu]
    exact hmax u
  have hcoef := MaskedBushCoefficients.coefficients c cap G.maxDegree D τ ε hc (Nat.cast_nonneg _)
    hD1 hDmax hτ.le hattach hroot
  have hεsq : ε^2 ≤ ε := by nlinarith
  let g : G.Coloring Bool := hb.toColoring (by simp)
  have hfree := ThreeHubRoles.not_free_of_small_counts s G (cap:ℝ) (by omega) M hM g g.valid
    H k cap G.maxDegree hk hH G.degree_le_maxDegree hlight (Nat.cast_nonneg _) le_rfl
    ε (c*(1+cap)*τ) τ (τ/D) hε.le hcoef.1
    (by simpa only [c,Nat.cast_mul] using hcoef.2.1) hpSmall hεsq hcoef.2.2.1 hcoef.2.2.2
    (by simpa only [pack] using hsmall) hEpos hcore hcoll hdel
  exact hfree hf

end Erdos571.ThreeHubNonsharp


/-! Unrestricted ordinary upper bounds at the current NONSHARP exponent. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHubNonsharp
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeExponent (s : ℕ) : ℝ := (s:ℝ)/((2*s+2:ℕ):ℝ)

lemma degreeExponent_pos (s : ℕ) (hs : 1 ≤ s) : 0 < degreeExponent s := by
  unfold degreeExponent
  apply div_pos
  · exact_mod_cast (show 0<s by omega)
  · positivity

lemma degreeExponent_le_one (s : ℕ) : degreeExponent s ≤ 1 := by
  unfold degreeExponent
  apply (div_le_one (by positivity : (0:ℝ)<(2*s+2:ℕ))).mpr
  exact_mod_cast (show s ≤ 2*s+2 by omega)

theorem unrestricted_regular_bound (s M : ℕ) (hs : 4 ≤ s) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (ThreeHub.graph s M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent s) := by
  obtain ⟨B,hB,hbound⟩ := free_degree_bound s M hs hM Q hQ
  let C : ℝ := B^((2*s+2:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent s :=
    Real.one_le_rpow hn1 (degreeExponent_pos s (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent s := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (ThreeHub.graph s M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (2*s+2) s (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent s at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent s) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The current nonsharp exponent holds for every finite forbidden-free host. -/
theorem unrestricted_edge_bound (s M : ℕ) (hs : 4 ≤ s) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (ThreeHub.graph s M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent s) := by
  have hγ : 0 < degreeExponent s := degreeExponent_pos s (by omega)
  have hγ1 : degreeExponent s ≤ 1 := degreeExponent_le_one s
  let K : ℝ := (16:ℝ)^((degreeExponent s)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent s)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := unrestricted_regular_bound s M hs hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (ThreeHub.graph s M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent s) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb


theorem edge_bound (s M : ℕ) (hs : 4 ≤ s) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (ThreeHub.graph s M) (1+degreeExponent s) D := by
  obtain ⟨D,hD,h⟩ := unrestricted_edge_bound s M hs hM
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  exact h W inferInstance G inferInstance hf

theorem upper (s M : ℕ) (hs : 4 ≤ s) (hM : 2 ≤ M) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (ThreeHub.graph s M):ℝ))
      (fun n : ℕ => (n:ℝ)^(1+degreeExponent s)) := by
  obtain ⟨D,hD,h⟩ := edge_bound s M hs hM
  exact h.extremal_isBigO _ hD

/-- This improves the upper exponent for one fixed graph from31/21 to17/12,
while keeping its lower24/17. It is not a sharp Theta statement. -/
theorem twentyfour_seventeen_improved_bounds :
    ∃ M : ℕ, 2 ≤ M ∧ (ThreeHub.graph 5 M).IsBipartite ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (n:ℝ)^(24/17:ℝ))
        (fun n : ℕ => (extremalNumber n (ThreeHub.graph 5 M):ℝ)) ∧
      Asymptotics.IsBigO Filter.atTop
        (fun n : ℕ => (extremalNumber n (ThreeHub.graph 5 M):ℝ))
        (fun n : ℕ => (n:ℝ)^(17/12:ℝ)) := by
  obtain ⟨M,hM,hb,hl⟩ := ThreeHub.twentyfour_seventeen_lower
  refine ⟨M,hM,hb,hl,?_⟩
  have h := upper 5 M (by omega) hM
  norm_num only [degreeExponent] at h
  exact h

end Erdos571.ThreeHubNonsharp

/-! Mixed-coordinate Ramsey restriction for a biclique-free shadow. -/
set_option maxHeartbeats 1500000
namespace Erdos571.RamseyMixedPairs
open Finset SimpleGraph
variable {W I : Type*}

/-- Cross adjacency between two individually nonadjacent role pairs. -/
def graph (K : SimpleGraph W) (a b : I → W) : SimpleGraph I where
  Adj i j := i≠j ∧ (K.Adj (a i) (b j) ∨ K.Adj (a j) (b i))
  symm := by intro i j h; exact ⟨h.1.symm,h.2.symm⟩
  loopless := by intro i h; exact h.1 rfl

def forward [LinearOrder I] (K : SimpleGraph W) (a b : I → W) : SimpleGraph I where
  Adj i j := (i < j ∧ K.Adj (a i) (b j)) ∨ (j < i ∧ K.Adj (a j) (b i))
  symm := by intro i j h; exact h.symm
  loopless := by intro i h; rcases h with h|h <;> exact (lt_irrefl i h.1)

lemma forward_adj_of_lt [LinearOrder I] (K : SimpleGraph W) (a b : I → W)
    {i j : I} (hij : i < j) (h : (forward K a b).Adj i j) : K.Adj (a i) (b j) := by
  exact h.resolve_right (fun h' => (asymm hij h'.1)) |>.2

/-- An ordered cross-adjacency clique of size `2*t` contains a `K_(t,t)`.
The nonadjacency inside each role pair prevents repeated images. -/
theorem forward_cliqueFree [LinearOrder I] (K : SimpleGraph W) (a b : I → W)
    (hab : ∀i, ¬K.Adj (a i) (b i)) (t : ℕ)
    (hf : (completeBipartiteGraph (Fin t) (Fin t)).Free K) :
    (forward K a b).CliqueFree (2*t) := by
  classical
  intro S hS
  let e := S.orderEmbOfFin hS.2
  have hr {i j : Fin (2*t)} (hij : i < j) : K.Adj (a (e i)) (b (e j)) := by
    apply forward_adj_of_lt K a b (e.strictMono hij)
    exact hS.1 (S.orderEmbOfFin_mem hS.2 i) (S.orderEmbOfFin_mem hS.2 j)
      (ne_of_lt (e.strictMono hij))
  have ha : Function.Injective (a ∘ e) := by
    intro i j he
    change a (e i)=a (e j) at he
    apply le_antisymm
    · by_contra! h
      have hh := hr h
      exact hab (e i) (by simpa only [←he] using hh)
    · by_contra! h
      have hh := hr h
      exact hab (e j) (by simpa only [Function.comp_apply,he] using hh)
  have hb : Function.Injective (b ∘ e) := by
    intro i j he
    change b (e i)=b (e j) at he
    apply le_antisymm
    · by_contra! h
      have hh := hr h
      exact hab (e j) (by simpa only [he] using hh)
    · by_contra! h
      have hh := hr h
      exact hab (e i) (by simpa only [←he] using hh)
  let l : Fin t → Fin (2*t) := fun i => ⟨i.val,by omega⟩
  let r : Fin t → Fin (2*t) := fun i => ⟨t+i.val,by omega⟩
  have hl : Function.Injective l := by
    intro i j he
    have hh := congrArg (fun x : Fin (2*t) => x.val) he
    exact Fin.ext hh
  have hr' : Function.Injective r := by
    intro i j he
    have h := congrArg Fin.val he
    apply Fin.ext
    dsimp [r] at h
    omega
  apply hf
  apply completeBipartiteGraph_isContained_iff.mpr
  refine ⟨univ.image (a ∘ e ∘ l),univ.image (b ∘ e ∘ r),?_,?_,?_⟩
  · simpa only [card_univ] using card_image_of_injective univ (ha.comp hl)
  · simpa only [card_univ] using card_image_of_injective univ (hb.comp hr')
  · intro x hx y hy
    change x∈univ.image (a ∘ e ∘ l) at hx
    change y∈univ.image (b ∘ e ∘ r) at hy
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hx
    obtain ⟨j,hj,rfl⟩ := mem_image.mp hy
    exact hr (by change i.val<t+j.val; omega)

/-- No injectivity of the role maps is assumed. -/
theorem cliqueFree (K : SimpleGraph W) (a b : I → W)
    (hab : ∀i, ¬K.Adj (a i) (b i)) (t : ℕ)
    (hf : (completeBipartiteGraph (Fin t) (Fin t)).Free K) :
    (graph K a b).CliqueFree (2^(4*t)) := by
  classical
  letI : LinearOrder I := linearOrderOfSTO WellOrderingRel
  have h₁ := forward_cliqueFree K a b hab t hf
  have h₂ := forward_cliqueFree K b a (fun i h => hab i h.symm) t hf
  have hh := RamseyCliqueUnion.sup_cliqueFree (2*t) (2*t)
    (forward K a b) (forward K b a) (h₁.mono (Nat.le_succ _)) (h₂.mono (Nat.le_succ _))
  have hle : graph K a b ≤ forward K a b ⊔ forward K b a := by
    intro i j h
    rcases lt_or_gt_of_ne h.1 with hij|hji
    · rcases h.2 with h|h
      · exact Or.inl (Or.inl ⟨hij,h⟩)
      · exact Or.inr (Or.inl ⟨hij,h.symm⟩)
    · rcases h.2 with h|h
      · exact Or.inr (Or.inr ⟨hji,h.symm⟩)
      · exact Or.inl (Or.inr ⟨hji,h⟩)
  convert hh.anti hle using 1 <;> congr 1 <;> omega

lemma nonadj (K : SimpleGraph W) (a b : I → W)
    (hab : ∀i, ¬K.Adj (a i) (b i)) (i j : I) :
    ¬(graph K a b).Adj i j ↔ ¬K.Adj (a i) (b j) ∧ ¬K.Adj (a j) (b i) := by
  by_cases hij : i=j
  · subst j; simp only [graph,ne_eq,not_true_eq_false,false_and,not_false_eq_true,
      hab i,and_self]
  · simp only [graph,ne_eq,hij,not_false_eq_true,true_and,not_or]

end Erdos571.RamseyMixedPairs


/-! Rooted packing energy with an arbitrary finite list of clique-free masks. -/
set_option maxHeartbeats 1500000
namespace Erdos571.RamseyConflictMasks
open Finset SimpleGraph RamseyLightConflict
variable {A R W I J : Type*} [Fintype A] [Nonempty A] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}
variable [DecidableEq I] [DecidableEq J]

open Classical in
theorem weighted_bound (S : Finset I) (L : List (SimpleGraph I))
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hL : ∀ K∈L, K.CliqueFree k)
    (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀ i∈S, 0 ≤ w i) :
    (∑ e∈PackingEnergy.fiberPairs S label (fun _ _ => True), w e.1*w e.2) ≤
      (RamseyRoleMask.bound k M L.length-1:ℕ) *
        ∑ e∈PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ K∈L, ¬K.Adj i j),
          w e.1*w e.2 := by
  classical
  let B := RamseyRoleMask.union L (packingGraph f label)
  let p := RamseyRoleMask.bound k M L.length
  have hp : 2 ≤ p := RamseyRoleMask.bound_ge_two k M _ hM
  have hB : B.CliqueFree p := RamseyRoleMask.union_cliqueFree L
    (packingGraph f label) k M (packingGraph_free f label hroots M hM hf) hL
  have hn (r : J) : ¬∃ U⊆S.filter (fun i => label i=r), U.card=p ∧
      ∀ i∈U, ∀ j∈U, i≠j → ¬(¬B.Adj i j) := by
    rintro ⟨U,hU,hUc,hh⟩
    exact hB U ⟨fun i hi j hj hij => not_not.mp (hh i hi j hj hij),hUc⟩
  have hh := PackingEnergy.weighted_fiber_second_moment S label (fun i j => ¬B.Adj i j)
    (fun i hi => B.loopless i) (fun i hi j hj h ha => h (B.symm ha)) p hp hn w hw
  have he : PackingEnergy.fiberPairs S label (fun i j => ¬B.Adj i j)=
      PackingEnergy.fiberPairs S label (fun i j =>
        RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ K∈L, ¬K.Adj i j) := by
    ext e
    simp only [PackingEnergy.fiberPairs,Finset.mem_filter]
    by_cases h : label e.1=label e.2
    · simp only [h,true_and,B,RamseyRoleMask.union_nonadj,packingGraph,not_not]
    · simp [h]
  rw [PackingEnergy.sum_fiber_mass_sq,he] at hh
  exact hh

open Classical in
theorem pair_bound (S : Finset I) (L : List (SimpleGraph I))
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hL : ∀ K∈L, K.CliqueFree k)
    (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound k M L.length-1) *
        (PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧ ∀ K∈L, ¬K.Adj i j)).card := by
  have h := weighted_bound S L f label hroots k M hM hL hf (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

end Erdos571.RamseyConflictMasks


/-! Cross-coordinate lightness for pairs of roles that are light within each hom. -/
set_option maxHeartbeats 1500000
namespace Erdos571.RamseyMixedRoleConflict
open Finset SimpleGraph
variable {A R W I J T : Type*} [Fintype A] [Nonempty A] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W} [Fintype T]

noncomputable def masks (K : SimpleGraph W) (a b : T → I → W) : List (SimpleGraph I) :=
  (univ.toList : List T).map (fun t => RamseyMixedPairs.graph K (a t) (b t))

lemma masks_length (K : SimpleGraph W) (a b : T → I → W) :
    (masks K a b).length=Fintype.card T := by
  classical
  simp [masks]

lemma masks_free (K : SimpleGraph W) (a b : T → I → W)
    (hab : ∀t i, ¬K.Adj (a t i) (b t i)) (k : ℕ)
    (hf : (completeBipartiteGraph (Fin k) (Fin k)).Free K) :
    ∀ Q∈masks K a b, Q.CliqueFree (2^(4*k)) := by
  classical
  intro Q hQ
  obtain ⟨t,ht,rfl⟩ := List.mem_map.mp hQ
  exact RamseyMixedPairs.cliqueFree K (a t) (b t) (hab t) k hf

lemma masks_nonadj (K : SimpleGraph W) (a b : T → I → W)
    (hab : ∀t i, ¬K.Adj (a t i) (b t i)) (i j : I) :
    (∀ Q∈masks K a b, ¬Q.Adj i j) ↔
      ∀t, ¬K.Adj (a t i) (b t j) ∧ ¬K.Adj (a t j) (b t i) := by
  classical
  simp [masks,RamseyMixedPairs.nonadj K _ _ (hab _)]

variable [DecidableEq I] [DecidableEq J]
open Classical in
theorem weighted_bound (S : Finset I) (K : SimpleGraph W) (a b : T → I → W)
    (hab : ∀t i, ¬K.Adj (a t i) (b t i))
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀ i∈S, 0 ≤ w i) :
    (∑ e∈PackingEnergy.fiberPairs S label (fun _ _ => True), w e.1*w e.2) ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Fintype.card T)-1:ℕ) *
        ∑ e∈PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧
            ∀t, ¬K.Adj (a t i) (b t j) ∧ ¬K.Adj (a t j) (b t i)),
          w e.1*w e.2 := by
  have hh := RamseyConflictMasks.weighted_bound S (masks K a b) f label hroots
    (2^(4*k)) M hM (masks_free K a b hab k hK) hf w hw
  simpa only [masks_length,masks_nonadj K a b hab] using hh

open Classical in
theorem pair_bound (S : Finset I) (K : SimpleGraph W) (a b : T → I → W)
    (hab : ∀t i, ¬K.Adj (a t i) (b t i))
    (f : I → H →g G) (label : I → J)
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Fintype.card T)-1) *
        (PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧
            ∀t, ¬K.Adj (a t i) (b t j) ∧ ¬K.Adj (a t j) (b t i))).card := by
  have h := weighted_bound S K a b hab f label hroots k M hM hK hf (fun _ => 1)
    (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

theorem family_bound [Fintype J] (F : J → Type*) [∀ j, Fintype (F j)]
    (K : SimpleGraph W) (a b : T → Sigma F → W)
    (hab : ∀t i, ¬K.Adj (a t i) (b t i)) (f : Sigma F → H →g G)
    (hroots : ∀ p q, p.1=q.1 → ∀ r, f p (.inr r)=f q (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    Nat.card (FiberRestrictionEnergy.Agreement F) ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Fintype.card T)-1) *
      Nat.card {p : Sigma F × Sigma F // p.1.1=p.2.1 ∧
        RootedHomEnergy.Conflict (f p.1) (f p.2) ∧
          ∀t, ¬K.Adj (a t p.1) (b t p.2) ∧ ¬K.Adj (a t p.2) (b t p.1)} := by
  classical
  have h := pair_bound (univ : Finset (Sigma F)) K a b hab f Sigma.fst hroots k M hM hK hf
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
    PackingEnergy.pairs,true_and,and_true,univ_product_univ] using h

end Erdos571.RamseyMixedRoleConflict


/-! A finite bipartite base makes the subdivision-heavy shadow biclique-free. -/
set_option maxHeartbeats 1200000
namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph
variable {V : Type} [Fintype V]

noncomputable def bipartiteCopy (H : SimpleGraph V) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u≠c v) :
    H.Copy (completeBipartiteGraph (Fin (Fintype.card V)) (Fin (Fintype.card V))) := by
  classical
  let f : V → Fin (Fintype.card V) ⊕ Fin (Fintype.card V) :=
    fun v => if c v then .inl (Fintype.equivFin V v) else .inr (Fintype.equivFin V v)
  refine { toHom := {toFun := f,map_rel' := ?_}, injective' := ?_ }
  · intro u v huv
    have h := hc huv
    cases hu : c u <;> cases hv : c v <;> simp_all [f,completeBipartiteGraph]
  · intro u v he
    have hu : (Fintype.equivFin V) u=(Fintype.equivFin V) v := by
      cases hcu : c u <;> cases hcv : c v <;> simpa [f,hcu,hcv] using he
    exact (Fintype.equivFin V).injective hu

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem cutoff_bicliqueFree (H : SimpleGraph V) (c : V → Bool)
    (hc : ∀{u v}, H.Adj u v → c u≠c v) (L : ℕ)
    (hL : Fintype.card V+Nat.card H.edgeSet ≤ L+1)
    (hf : (ProjectionHeavy.subdivision H).Free G) :
    (completeBipartiteGraph (Fin (Fintype.card V)) (Fin (Fintype.card V))).Free
      (graph G univ (L+1)) := by
  intro h
  have hh : H ⊑ graph G univ (L+1) := IsContained.trans ⟨bipartiteCopy H c hc⟩ h
  have hs : H ⊑ graph G univ (Fintype.card V+Nat.card H.edgeSet) :=
    IsContained.trans hh ⟨SimpleGraph.Copy.ofLE _ _ (graph_antitone G _ _ hL)⟩
  exact (free H G univ hf) hs

end Erdos571.HostHeavyShadow


/-! Pathwise-light copy families support mixed Ramsey masks on every pair
of roles with a common neighbor (and on every diagonal role pair). -/
set_option maxHeartbeats 1600000
namespace Erdos571.PathwiseLightConflict
open Finset SimpleGraph
variable {V W : Type}

/-- These, and not arbitrary pairs of template vertices, are controlled by
pathwise two-step lightness. -/
def Related (H : SimpleGraph V) (u v : V) : Prop :=
  u=v ∨ ∃x, H.Adj u x ∧ H.Adj x v

lemma related_refl (H : SimpleGraph V) (u : V) : Related H u u := Or.inl rfl
lemma related_symm (H : SimpleGraph V) {u v : V} (h : Related H u v) : Related H v u := by
  rcases h with h|⟨x,hux,hxv⟩
  · exact Or.inl h.symm
  · exact Or.inr ⟨x,hxv.symm,hux.symm⟩

abbrev Roles (H : SimpleGraph V) := {p : V×V // Related H p.1 p.2}

open Classical in
noncomputable instance [Fintype V] (H : SimpleGraph V) : Fintype (Roles H) :=
  Fintype.ofFinite _

def Within (H : SimpleGraph V) (K : SimpleGraph W) (f : V → W) : Prop :=
  ∀u v, Related H u v → ¬K.Adj (f u) (f v)

def Between (H : SimpleGraph V) (K : SimpleGraph W) (f g : V → W) : Prop :=
  ∀u v, Related H u v → ¬K.Adj (f u) (g v)

lemma between_symm (H : SimpleGraph V) (K : SimpleGraph W) {f g : V → W}
    (h : Between H K f g) : Between H K g f := by
  intro u v huv hh
  exact h v u (related_symm H huv) hh.symm

lemma between_same (H : SimpleGraph V) (K : SimpleGraph W) {f g : V → W}
    (h : Between H K f g) (u : V) : ¬K.Adj (f u) (g u) := h u u (related_refl H u)

lemma between_neighbors (H : SimpleGraph V) (K : SimpleGraph W) {f g : V → W}
    (h : Between H K f g) {u x v : V} (hu : H.Adj u x) (hv : H.Adj v x) :
    ¬K.Adj (f u) (g v) := h u v (Or.inr ⟨x,hu,hv.symm⟩)

lemma role_iff (H : SimpleGraph V) (K : SimpleGraph W) (f g : V → W) :
    (∀r : Roles H, ¬K.Adj (f r.val.1) (g r.val.2) ∧
      ¬K.Adj (g r.val.1) (f r.val.2)) ↔ Between H K f g := by
  constructor
  · intro h u v huv
    exact (h ⟨(u,v),huv⟩).1
  · intro h r
    exact ⟨h _ _ r.property,between_symm H K h _ _ r.property⟩

variable [Fintype V] [Fintype W] [DecidableEq W]

lemma within_of_light (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (L : ℕ) (f : H.Copy G) (hf : ConnectedCopyBound.Light H G univ (L+1) f) :
    Within H (HostHeavyShadow.graph G univ (L+1)) f := by
  intro u v huv
  rcases huv with rfl|⟨x,hux,hxv⟩
  · exact (HostHeavyShadow.graph G univ (L+1)).loopless _
  · by_cases he : u=v
    · subst v; exact (HostHeavyShadow.graph G univ (L+1)).loopless _
    · intro hh
      have h := hf u x v hux hxv he
      exact (not_le_of_gt h) hh.2

variable {A R I J : Type} [Fintype A] [Fintype R] [Nonempty A]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}
variable [DecidableEq I] [DecidableEq J]

open Classical in
theorem weighted_bound (S : Finset I) (K : SimpleGraph W)
    (f : I → H →g G) (label : I → J) (hwithin : ∀i, Within H K (f i))
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀ i∈S, 0 ≤ w i) :
    (∑ e∈PackingEnergy.fiberPairs S label (fun _ _ => True), w e.1*w e.2) ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Fintype.card (Roles H))-1:ℕ) *
        ∑ e∈PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧ Between H K (f i) (f j)), w e.1*w e.2 := by
  have hh := RamseyMixedRoleConflict.weighted_bound S K
    (fun (r : Roles H) i => f i r.val.1) (fun (r : Roles H) i => f i r.val.2)
    (fun r i => hwithin i _ _ r.property) f label hroots k M hM hK hf w hw
  simpa only [role_iff] using hh

open Classical in
theorem pair_bound (S : Finset I) (K : SimpleGraph W)
    (f : I → H →g G) (label : I → J) (hwithin : ∀i, Within H K (f i))
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Fintype.card (Roles H))-1) *
        (PackingEnergy.fiberPairs S label (fun i j =>
          RootedHomEnergy.Conflict (f i) (f j) ∧ Between H K (f i) (f j))).card := by
  have hh := weighted_bound S K f label hwithin hroots k M hM hK hf (fun _ => 1)
    (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at hh
  exact_mod_cast hh

theorem family_bound [Fintype J] (F : J → Type) [∀j, Fintype (F j)]
    (K : SimpleGraph W) (f : Sigma F → H →g G) (hwithin : ∀i, Within H K (f i))
    (hroots : ∀ p q, p.1=q.1 → ∀ r, f p (.inr r)=f q (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    Nat.card (FiberRestrictionEnergy.Agreement F) ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Fintype.card (Roles H))-1) *
      Nat.card {p : Sigma F × Sigma F // p.1.1=p.2.1 ∧
        RootedHomEnergy.Conflict (f p.1) (f p.2) ∧ Between H K (f p.1) (f p.2)} := by
  classical
  have hh := pair_bound (univ : Finset (Sigma F)) K f Sigma.fst hwithin hroots k M hM hK hf
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
    PackingEnergy.pairs,true_and,and_true,univ_product_univ] using hh

end Erdos571.PathwiseLightConflict


/-! The mixed-mask energy bound applied to actual injective light copies. -/
set_option maxHeartbeats 1600000
namespace Erdos571.PathwiseLightConflict
open Finset SimpleGraph
variable {A R W I J : Type} [Fintype A] [Fintype R] [Nonempty A]
variable [Fintype W] [DecidableEq W] [DecidableEq I] [DecidableEq J]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

lemma copy_conflict_iff (f g : H.Copy G) :
    RootedHomEnergy.Conflict f.toHom g.toHom ↔ ∃a b : A, f (.inl a)=g (.inl b) := by
  classical
  unfold RootedHomEnergy.Conflict
  simp only [f.injective,g.injective,true_and]
  rw [Finset.not_disjoint_iff]
  constructor
  · rintro ⟨w,hw,hw'⟩
    obtain ⟨a,ha,he⟩ := Finset.mem_image.mp hw
    obtain ⟨b,hb,he'⟩ := Finset.mem_image.mp hw'
    exact ⟨a,b,he.trans he'.symm⟩
  · rintro ⟨a,b,he⟩
    exact ⟨f (.inl a),Finset.mem_image.mpr ⟨a,mem_univ _,rfl⟩,
      Finset.mem_image.mpr ⟨b,mem_univ _,he.symm⟩⟩

open Classical in
theorem copy_pair_bound (S : Finset I) (K : SimpleGraph W)
    (f : I → H.Copy G) (label : I → J) (hwithin : ∀i, Within H K (f i))
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound (2^(4*k)) M (Nat.card (Roles H))-1) *
        (PackingEnergy.fiberPairs S label (fun i j =>
          (∃a b : A, f i (.inl a)=f j (.inl b)) ∧ Between H K (f i) (f j))).card := by
  have h := pair_bound S K (fun i => (f i).toHom) label hwithin hroots k M hM hK hf
  simpa only [Nat.card_eq_fintype_card,copy_conflict_iff] using h

variable [DecidableRel G.Adj]
variable {V : Type} [Fintype V]

open Classical in
/-- The auxiliary base is not required to be the unsubdivision of `H`.
Both actual freeness hypotheses are displayed explicitly. -/
theorem actual_copy_pair_bound (B : SimpleGraph V) (c : V → Bool)
    (hc : ∀{u v}, B.Adj u v → c u≠c v) (L : ℕ)
    (hL : Nat.card V+Nat.card B.edgeSet ≤ L+1)
    (hB : (ProjectionHeavy.subdivision B).Free G)
    (S : Finset I) (f : I → H.Copy G) (label : I → J)
    (hlight : ∀i, ConnectedCopyBound.Light H G univ (L+1) (f i))
    (hroots : ∀ i j, label i=label j → ∀ r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2 ≤ M) (hf : (FullRootedPower.graph H M).Free G) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound (2^(4*Nat.card V)) M (Nat.card (Roles H))-1) *
        (PackingEnergy.fiberPairs S label (fun i j =>
          (∃a b : A, f i (.inl a)=f j (.inl b)) ∧
            Between H (HostHeavyShadow.graph G univ (L+1)) (f i) (f j))).card :=
  by
    have hK := HostHeavyShadow.cutoff_bicliqueFree G B c hc L
      (by simpa only [Nat.card_eq_fintype_card] using hL) hB
    have hK' : (completeBipartiteGraph (Fin (Nat.card V)) (Fin (Nat.card V))).Free
        (HostHeavyShadow.graph G univ (L+1)) := by
      rw [Nat.card_eq_fintype_card]
      exact hK
    exact copy_pair_bound S _ f label
      (fun i => within_of_light H G L (f i) (hlight i)) hroots _ M hM hK' hf

end Erdos571.PathwiseLightConflict


/-! Subdivision preserves trees, with exact total vertex and edge counts. -/
set_option maxHeartbeats 1500000
namespace Erdos571.RootedSubdivision
open Finset SimpleGraph
variable {A R : Type} [Fintype A] [Fintype R]

lemma incidenceEdge_surjective (H : SimpleGraph (A⊕R)) : Function.Surjective (incidenceEdge H) := by
  rintro ⟨e,he⟩
  obtain ⟨u,v,rfl⟩ := exists_pair e
  change (graph H).Adj u v at he
  rcases old_or_middle H u with ⟨u,rfl⟩|⟨u,rfl⟩ <;>
    rcases old_or_middle H v with ⟨v,rfl⟩|⟨v,rfl⟩
  · change (ProjectionHeavy.subdivision H).Adj (toVertex H (old H u)) (toVertex H (old H v)) at he
    rw [toVertex_old,toVertex_old] at he
    exact he.elim
  · refine ⟨⟨(v,u),(adj_old_middle H u v).mp he⟩,?_⟩
    rfl
  · refine ⟨⟨(u,v),(adj_old_middle H v u).mp he.symm⟩,?_⟩
    apply Subtype.ext
    exact Sym2.eq_swap
  · change (ProjectionHeavy.subdivision H).Adj (toVertex H (middle H u)) (toVertex H (middle H v)) at he
    rw [toVertex_middle,toVertex_middle] at he
    exact he.elim

lemma graph_edge_card (H : SimpleGraph (A⊕R)) : Nat.card (graph H).edgeSet=2*Nat.card H.edgeSet := by
  classical
  let e : {p : H.edgeSet×(A⊕R) // p.2∈p.1.val} ≃ (Σe : H.edgeSet, {v : A⊕R // v∈e.val}) :=
    {toFun := fun p => ⟨p.val.1,⟨p.val.2,p.property⟩⟩
     invFun := fun p => ⟨⟨p.1,p.2.val⟩,p.2.property⟩
     left_inv := fun p => rfl
     right_inv := fun p => rfl}
  rw [←Nat.card_congr (Equiv.ofBijective (incidenceEdge H)
    ⟨incidenceEdge_injective H,incidenceEdge_surjective H⟩),Nat.card_congr e]
  simp only [Nat.card_eq_fintype_card,Fintype.card_sigma]
  have hh (e : H.edgeSet) : Fintype.card {v : A⊕R // v∈e.val}=2 := by
    rw [←Nat.card_eq_fintype_card]
    exact endpoints_card H e
  simp only [hh,sum_const,card_univ,nsmul_eq_mul,mul_comm]
  rfl

lemma vertex_card (H : SimpleGraph (A⊕R)) :
    Nat.card (Vertex H)=Nat.card (A⊕R)+Nat.card H.edgeSet := by
  rw [Nat.card_congr (vertexEquiv H),Nat.card_sum]

lemma isTree (H : SimpleGraph (A⊕R)) (hH : H.IsTree) : (graph H).IsTree := by
  classical
  apply isTree_iff_connected_and_card.mpr
  refine ⟨connected H hH.isConnected,?_⟩
  rw [graph_edge_card,vertex_card]
  have h := (isTree_iff_connected_and_card.mp hH).2
  omega

end Erdos571.RootedSubdivision


/-! Instance-independent cardinalities for pathwise-light copy families. -/
set_option maxHeartbeats 1500000
namespace Erdos571.HostHeavyShadow
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {A W : Type} [DecidableEq W]
variable (T : SimpleGraph A) (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev LightCopyFamily (U : Finset W) (t : ℕ) :=
  {f : T.Copy G // (∀v, f v∈U) ∧ ConnectedCopyBound.Light T G U t f}

variable [Fintype A] [Fintype W]
lemma lightCopyFamily_card (U : Finset W) (t : ℕ) :
    Nat.card (LightCopyFamily T G U t)=(lightCopies T G U t).card := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
  apply congrArg Finset.card
  ext f
  simp only [lightCopies,Finset.mem_filter,Finset.mem_univ,true_and]
  rw [TreeCopiesIn.mem_copies]

lemma lightCopyFamily_card_mono (U : Finset W) (a b : ℕ) (hab : a ≤ b) :
    Nat.card (LightCopyFamily T G U a) ≤ Nat.card (LightCopyFamily T G U b) := by
  classical
  let f : LightCopyFamily T G U a → LightCopyFamily T G U b := fun p =>
    ⟨p.val,p.property.1,fun u v w huv hvw huw => (p.property.2 u v w huv hvw huw).trans_le hab⟩
  apply Nat.card_le_card_of_injective f
  intro p q h
  have hh := congrArg (fun x : LightCopyFamily T G U b => x.val) h
  exact Subtype.ext hh

variable {V : Type} [Fintype V] [DecidableEq A]
/-- The source type of copies does not mention its `Fintype` enumeration. -/
theorem light_tree_abundance_nat (H : SimpleGraph V) {α C : ℝ}
    (hα0 : 0 ≤ α) (hα2 : α < 2) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (hT : T.IsTree) (hk : 3 ≤ Nat.card A) (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ L : ℝ, 1 ≤ L ∧ ∀ {W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W),
      (subdivision H).Free G → ∀d : ℝ, L ≤ d →
      (∀x∈U, d ≤ ((neighbors G U x).card:ℝ)) →
      (∀x∈U, ((neighbors G U x).card:ℝ) ≤ Q*d) →
      (U.card:ℝ)*(d/4)^(Nat.card A-1)/2 ≤
        Nat.card (LightCopyFamily T G U (Nat.card V+Nat.card H.edgeSet)) := by
  obtain ⟨L,hL,hcount⟩ := light_tree_abundance H hα0 hα2 hC hbound T hT
    (by simpa only [Nat.card_eq_fintype_card] using hk) Q hQ
  refine ⟨L,hL,?_⟩
  intro W _ _ G _ U hf d hd hmin hmax
  have h := hcount G U hf d hd hmin hmax
  rw [lightCopyFamily_card]
  simpa only [Nat.card_eq_fintype_card] using h

end Erdos571.HostHeavyShadow


/-! Cardinalities independent of decidability implementations in copy-pair filters. -/
set_option maxHeartbeats 1500000
namespace Erdos571.PathwiseLightConflict
open Finset SimpleGraph
variable {I J : Type*}

abbrev PairFamily (S : Finset I) (label : I → J) (P : I → I → Prop) :=
  {p : I×I // p.1∈S ∧ p.2∈S ∧ label p.1=label p.2 ∧ P p.1 p.2}

open Classical in
lemma pairFamily_card (S : Finset I) (label : I → J) (P : I → I → Prop) :
    Nat.card (PairFamily S label P)=(PackingEnergy.fiberPairs S label P).card := by
  classical
  let e : PairFamily S label P ≃ ↥(PackingEnergy.fiberPairs S label P) :=
    {toFun := fun p => ⟨p.val,Finset.mem_filter.mpr
      ⟨Finset.mem_product.mpr ⟨p.property.1,p.property.2.1⟩,p.property.2.2⟩⟩
     invFun := fun p => ⟨p.val, (Finset.mem_product.mp (Finset.mem_filter.mp p.property).1).1,
       (Finset.mem_product.mp (Finset.mem_filter.mp p.property).1).2,
       (Finset.mem_filter.mp p.property).2⟩
     left_inv := fun p => rfl
     right_inv := fun p => rfl}
  rw [Nat.card_congr e,Nat.card_eq_fintype_card,Fintype.card_coe]

variable {A R W I J V : Type} [Fintype A] [Fintype R] [Nonempty A]
variable [Fintype W] [DecidableEq W] [Fintype V]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W} [DecidableRel G.Adj]

/-- A host-size-independent mixed-mask factor for actual light copies.
Neither side mentions the enumeration of the interior type. -/
theorem actual_copy_pair_card_bound (B : SimpleGraph V) (c : V → Bool)
    (hc : ∀{u v}, B.Adj u v → c u≠c v) (L : ℕ)
    (hL : Nat.card V+Nat.card B.edgeSet ≤ L+1)
    (hB : (ProjectionHeavy.subdivision B).Free G)
    (S : Finset I) (f : I → H.Copy G) (label : I → J)
    (hlight : ∀i, ConnectedCopyBound.Light H G univ (L+1) (f i))
    (hroots : ∀i j, label i=label j → ∀r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2 ≤ M) (hf : (FullRootedPower.graph H M).Free G) :
    Nat.card (PairFamily S label (fun _ _ => True)) ≤
      (RamseyRoleMask.bound (2^(4*Nat.card V)) M (Nat.card (Roles H))-1) *
        Nat.card (PairFamily S label (fun i j =>
          (∃a b : A, f i (.inl a)=f j (.inl b)) ∧
            Between H (HostHeavyShadow.graph G univ (L+1)) (f i) (f j))) := by
  classical
  rw [pairFamily_card,pairFamily_card]
  have h := actual_copy_pair_bound B c hc L hL hB S f label hlight hroots M hM hf
  convert h using 1 <;> congr 1 <;> try { congr 1 }
  all_goals
    apply congrArg Finset.card
    ext p
    simp only [PackingEnergy.fiberPairs,Finset.mem_filter]

end Erdos571.PathwiseLightConflict


/-! Actual ThreeHub pathwise-light copies: abundance and mixed-conflict charging.
No sharp upper bound is claimed here. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHub
open Finset SimpleGraph DensityRegularization PathwiseLightConflict

lemma template_isTree (s : ℕ) : (template s).IsTree :=
  RootedSubdivision.isTree (base s) (base_isTree s)

lemma template_vertex_card (s : ℕ) (hs : 1 ≤ s) :
    Nat.card (RootedSubdivision.Vertex (base s))=6*s+5 := by
  rw [RootedSubdivision.vertex_card]
  rw [Nat.card_eq_fintype_card (α := Fin 3⊕BaseRoot s),Fintype.card_sum,Fintype.card_fin,
    base_roots s hs,base_edges s hs]
  omega

lemma template_root_card (s : ℕ) (hs : 1 ≤ s) :
    Nat.card (RootedSubdivision.Root (base s))=3*s := by
  classical
  have hsurj : Function.Surjective (ThreeHubRoles.rootIndex s hs) := by
    intro a
    refine ⟨.inl ((ThreeHubRoles.rootEquiv s hs).symm a),?_⟩
    exact (ThreeHubRoles.rootEquiv s hs).apply_symm_apply a
  rw [Nat.card_congr (Equiv.ofBijective (ThreeHubRoles.rootIndex s hs)
    ⟨ThreeHubRoles.rootIndex_injective s hs,hsurj⟩)]
  simp only [ThreeHubRoles.Arm,Nat.card_prod,Nat.card_fin]

lemma template_interior_card (s : ℕ) (hs : 1 ≤ s) :
    Nat.card (RootedSubdivision.Nonroot (base s))=3*s+5 := by
  have h := template_vertex_card s hs
  change Nat.card (RootedSubdivision.Nonroot (base s)⊕RootedSubdivision.Root (base s))=6*s+5 at h
  rw [Nat.card_sum,template_root_card s hs] at h
  omega

noncomputable def pathwiseCap (s M : ℕ) : ℕ :=
  Nat.card (Branch s M)+Nat.card (FullRootedPower.graph (base s) (M+1)).edgeSet

/-- Constants precede the host type and the graph. Every two-edge subpath,
including those through the core middles and the three hubs, is light. -/
theorem pathwise_light_abundance (s M : ℕ) (hs : 1 ≤ s) (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ L : ℝ, 1 ≤ L ∧ ∀ {W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W), (graph s M).Free G →
      ∀d : ℝ, L ≤ d →
      (∀x∈U, d ≤ ((neighbors G U x).card:ℝ)) →
      (∀x∈U, ((neighbors G U x).card:ℝ) ≤ Q*d) →
      (U.card:ℝ)*(d/4)^(6*s+4)/2 ≤
        Nat.card (HostHeavyShadow.LightCopyFamily (template s) G U (pathwiseCap s M+1)) := by
  classical
  obtain ⟨C,hC,hbound⟩ := uniform_base_edge_bound s (M+1) hs
  obtain ⟨L,hL,hlower⟩ := HostHeavyShadow.light_tree_abundance_nat (template s)
    (FullRootedPower.graph (base s) (M+1))
    (by have h := (uniform_base_exponent_bounds s).1; linarith)
    (uniform_base_exponent_bounds s).2 hC hbound (template_isTree s)
    (by rw [template_vertex_card s hs]; omega) Q hQ
  refine ⟨L,hL,?_⟩
  intro W _ _ G _ U hf d hd hmin hmax
  have h := hlower G U (subdivision_free s M G hf) d hd hmin hmax
  rw [template_vertex_card s hs] at h
  have hexp : 6*s+5-1=6*s+4 := by omega
  rw [hexp] at h
  exact h.trans (Nat.cast_le.mpr (HostHeavyShadow.lightCopyFamily_card_mono
    (template s) G U (pathwiseCap s M) (pathwiseCap s M+1) (Nat.le_succ _)))

variable {W I J : Type} [Fintype W] [DecidableEq W] [DecidableEq I] [DecidableEq J]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

open Classical in
/-- Ordinary freeness of the original graph suffices. The source family
consists of actual injective copies, not unrestricted assignments. -/
theorem pathwise_pair_bound (s M : ℕ) (S : Finset I)
    (f : I → (template s).Copy G) (label : I → J)
    (hlight : ∀i, ConnectedCopyBound.Light (template s) G univ (pathwiseCap s M+1) (f i))
    (hroots : ∀i j, label i=label j → ∀r : RootedSubdivision.Root (base s),
      f i (.inr r)=f j (.inr r)) (hM : 2 ≤ M) (hf : (graph s M).Free G) :
    Nat.card (PairFamily S label (fun _ _ => True)) ≤
      (RamseyRoleMask.bound (2^(4*Nat.card (Branch s M))) M
        (Nat.card (Roles (template s)))-1) *
      Nat.card (PairFamily S label (fun i j =>
        (∃a b : RootedSubdivision.Nonroot (base s), f i (.inl a)=f j (.inl b)) ∧
          Between (template s) (HostHeavyShadow.graph G univ (pathwiseCap s M+1)) (f i) (f j))) := by
  classical
  let c : (FullRootedPower.graph (base s) (M+1)).Coloring Bool :=
    (base_power_bipartite s (M+1)).toColoring (by simp)
  exact actual_copy_pair_card_bound (H := template s) (G := G) (I := I) (J := J) _ c c.valid (pathwiseCap s M) (Nat.le_succ _)
    (subdivision_free s M G hf) S f label hlight hroots M hM hf

end Erdos571.ThreeHub
/-! A fourth-walk cap controls heavy endpoints at every path length at least two. -/
set_option maxHeartbeats 1800000
namespace Erdos571.HeavyLongWalks
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]

lemma power_row_upper (A : Matrix W W ℝ) (hA : ∀x y, 0 ≤ A x y)
    (D : ℝ) (hD : 0 ≤ D) (hrow : ∀x, ∑y, A x y ≤ D) (k : ℕ) (x : W) :
    ∑y, (A^k) x y ≤ D^k := by
  induction k generalizing x with
  | zero => simp [Matrix.one_apply]
  | succ k ih =>
    simp only [pow_succ',Matrix.mul_apply]
    rw [sum_comm]
    simp_rw [←mul_sum]
    calc
      _ ≤ ∑y, A x y*D^k := sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left (ih y) (hA x y))
      _ = (∑y, A x y)*D^k := (sum_mul _ _ _).symm
      _ ≤ D*D^k := mul_le_mul_of_nonneg_right (hrow x) (pow_nonneg hD k)

lemma shifted_trace_bound (A : Matrix W W ℝ) (hA : ∀x y, 0 ≤ A x y)
    (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T) (hrow : ∀x, ∑y, A x y ≤ D)
    (hfour : ∀x y, (A^4) x y ≤ T) (k : ℕ) :
    ∑x, (A^(k+4)) x x ≤ (Fintype.card W:ℝ)*T*D^k := by
  rw [pow_add]
  simp only [Matrix.mul_apply]
  calc
    _ ≤ ∑x, ∑y, (A^k) x y*T := sum_le_sum (fun x _ => sum_le_sum (fun y _ =>
      mul_le_mul_of_nonneg_left (hfour y x) (Matrix.pow_apply_nonneg hA _ _ _)))
    _ ≤ ∑_x : W, D^k*T := by
      apply sum_le_sum
      intro x _
      rw [←sum_mul]
      exact mul_le_mul_of_nonneg_right (power_row_upper A hA D hD hrow k x) hT
    _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul]; ring

variable (G : SimpleGraph W) [DecidableRel G.Adj]
abbrev Walks (k : ℕ) := (x : W) × (y : W) × {p : G.Walk x y // p.length=k}
abbrev Heavy (L k : ℕ) := {p : Walks G k // L ≤ Fintype.card (G.commonNeighbors p.1 p.2.1)}

lemma heavy_card (L k : ℕ) :
    (Nat.card (Heavy G L k):ℝ)=∑x, ∑y,
      if L ≤ Fintype.card (G.commonNeighbors x y) then ((G.adjMatrix ℝ)^k) x y else 0 := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
  simp only [Finset.card_filter,Nat.cast_sum,Fintype.sum_sigma]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  by_cases h : L ≤ Fintype.card (G.commonNeighbors x y)
  · simp only [h,if_true,sum_const,card_univ,Nat.cast_one,nsmul_eq_mul,mul_one]
    exact (G.adjMatrix_pow_apply_eq_card_walk k x y).symm
  · simp only [h,if_false,Nat.cast_zero,sum_const_zero]

/-- The heavy-endpoint count is charged to closed walks with two extra edges. -/
lemma heavy_mul_cutoff_le_trace (L k : ℕ) :
    (L:ℝ)*Nat.card (Heavy G L k) ≤ ∑x, ((G.adjMatrix ℝ)^(k+2)) x x := by
  classical
  let A := G.adjMatrix ℝ
  have hs : A.IsSymm := G.isSymm_adjMatrix
  have he (x : W) : (A^(k+2)) x x=∑y, (A^k) x y*(Fintype.card (G.commonNeighbors x y):ℝ) := by
    rw [pow_add,Matrix.mul_apply]
    apply sum_congr rfl
    intro y _
    rw [(hs.pow 2).apply x y,pow_two,LayeredBush.adjacency_square_common_card]
  rw [heavy_card,mul_sum]
  apply sum_le_sum
  intro x _
  rw [he,mul_sum]
  apply sum_le_sum
  intro y _
  by_cases h : L ≤ Fintype.card (G.commonNeighbors x y)
  · rw [if_pos h]
    have hh : (L:ℝ) ≤ Fintype.card (G.commonNeighbors x y) := by exact_mod_cast h
    have hn : 0 ≤ (A^k) x y := Matrix.pow_apply_nonneg (fun u v => by
      dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num) _ _ _
    simpa only [mul_comm] using mul_le_mul_of_nonneg_right hh hn
  · rw [if_neg h,mul_zero]
    apply mul_nonneg _ (Nat.cast_nonneg _)
    exact Matrix.pow_apply_nonneg (fun u v => by
      dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num) _ _ _

theorem heavy_walk_bound (L : ℕ) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hdeg : ∀x, (G.degree x:ℝ) ≤ D)
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y ≤ T) (k : ℕ) :
    (L:ℝ)*Nat.card (Heavy G L (k+2)) ≤ (Fintype.card W:ℝ)*T*D^k := by
  have hrow (x : W) : ∑y, G.adjMatrix ℝ x y ≤ D := by
    have he : ∑y, G.adjMatrix ℝ x y=(G.degree x:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := x))
    exact he.le.trans (hdeg x)
  have h := (heavy_mul_cutoff_le_trace G L (k+2)).trans
    (by
      have hh := shifted_trace_bound (G.adjMatrix ℝ) (fun u v => by
        dsimp [SimpleGraph.adjMatrix]; split_ifs <;> norm_num) D T hD hT hrow hfour k
      simpa only [show k+2+2=k+4 by omega] using hh)
  exact h

end Erdos571.HeavyLongWalks

/-! A fourth-walk cap bounds copies with a heavy pair at any path distance. -/
set_option maxHeartbeats 1800000
namespace Erdos571.HeavyLongWalks
open Finset SimpleGraph DensityRegularization
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma mapped_path_fiber (hH : H.Connected) {u v : V} (p : H.Walk u v) (hp : p.IsPath)
    (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀x, (G.degree x:ℝ) ≤ D)
    (F : Finset (H.Copy G)) (q : Walks G p.length)
    (hfix : ∀f∈F, (⟨f u,f v,⟨p.map f.toHom,Walk.length_map _ _⟩⟩ : Walks G p.length)=q) :
    (F.card:ℝ) ≤ D^(Fintype.card V-(p.length+1)) := by
  classical
  by_cases hn : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hn,card_empty,Nat.cast_zero]; positivity
  obtain ⟨f₀,hf₀⟩ := hn
  have hs : p.support.toFinset.card=p.length+1 := by
    rw [List.toFinset_card_of_nodup hp.support_nodup,Walk.length_support]
  have hdeg' : ∀x∈(univ : Finset W), ((neighbors G univ x).card:ℝ) ≤ D := by
    intro x _
    have he : neighbors G univ x=G.neighborFinset x := by ext y; simp [neighbors]
    rw [he,G.card_neighborFinset_eq_degree]
    exact hdeg x
  have h := ConnectedCopyBound.bound H hH G univ hD hdeg' p.support.toFinset
    (Finset.Nonempty.mono (Finset.singleton_subset_iff.mpr
      (List.mem_toFinset.mpr (p.start_mem_support))) (Finset.singleton_nonempty u)) f₀ F
    (by intros; exact mem_univ _) (by
      intro f hf x hx
      have hh := (hfix f hf).trans (hfix f₀ hf₀).symm
      have hh' := congrArg (fun q : Walks G p.length => q.2.2.val.support) hh
      simp only [Walk.support_map] at hh'
      exact List.map_inj_left.mp hh' x (List.mem_toFinset.mp hx))
  simpa only [hs] using h

/-- The path length disappears from the final exponent. -/
theorem heavy_pair_copy_bound (hH : H.Connected) {u v : V} (p : H.Walk u v)
    (hp : p.IsPath) (k : ℕ) (hlen : p.length=k+2)
    (L : ℕ) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hdeg : ∀x, (G.degree x:ℝ) ≤ D)
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y ≤ T)
    (F : Finset (H.Copy G)) (hbad : ∀f∈F, L ≤ Fintype.card (G.commonNeighbors (f u) (f v))) :
    (L:ℝ)*F.card ≤ (Fintype.card W:ℝ)*T*D^(Fintype.card V-3) := by
  classical
  let ev : H.Copy G → Walks G p.length := fun f =>
    ⟨f u,f v,⟨p.map f.toHom,Walk.length_map _ _⟩⟩
  let B := (univ : Finset (Walks G p.length)).filter
    (fun q => L ≤ Fintype.card (G.commonNeighbors q.1 q.2.1))
  have hcount : (F.card:ℝ) ≤ B.card*D^(Fintype.card V-(p.length+1)) := by
    apply RealFiberCount.bound F B ev
    · intro f hf
      exact mem_filter.mpr ⟨mem_univ _,hbad f hf⟩
    · intro q hq
      apply mapped_path_fiber H G hH p hp D hD hdeg
      intro f hf
      exact (mem_filter.mp hf).2
  have hcard : B.card=Nat.card (Heavy G L p.length) := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
  have hwalk := heavy_walk_bound G L D T hD hT hdeg hfour k
  have hsize : p.length+1 ≤ Fintype.card V := by
    have hh := card_le_univ p.support.toFinset
    rwa [List.toFinset_card_of_nodup hp.support_nodup,Walk.length_support] at hh
  have he : k+(Fintype.card V-(p.length+1))=Fintype.card V-3 := by omega
  have hc := mul_le_mul_of_nonneg_left hcount (Nat.cast_nonneg L : (0:ℝ) ≤ L)
  rw [hcard,hlen] at hc
  calc
    _ ≤ (L:ℝ)*(Nat.card (Heavy G L (k+2))*D^(Fintype.card V-(k+2+1))) := hc
    _ = ((L:ℝ)*Nat.card (Heavy G L (k+2)))*D^(Fintype.card V-(k+2+1)) := by ring
    _ ≤ ((Fintype.card W:ℝ)*T*D^k)*D^(Fintype.card V-(k+2+1)) :=
      mul_le_mul_of_nonneg_right hwalk (pow_nonneg hD _)
    _ = _ := by rw [mul_assoc,←pow_add]; rw [hlen] at he; rw [he]

end Erdos571.HeavyLongWalks

/-! A global pairwise lightness condition on each individual tree copy. -/
set_option maxHeartbeats 1800000
namespace Erdos571.GloballyLightCopies
open Finset SimpleGraph DensityRegularization HeavyLongWalks
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

def Light (L : ℕ) (f : H.Copy G) : Prop :=
  ∀u v, u≠v → Fintype.card (G.commonNeighbors (f u) (f v))<L

abbrev Family (L : ℕ) := {f : H.Copy G // Light H G L f}

lemma adjacent_heavy_empty
    (htri : ∀x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    {u v : V} (huv : H.Adj u v) (L : ℕ) (hL : 1 ≤ L)
    (F : Finset (H.Copy G)) (hbad : ∀f∈F, L ≤ Fintype.card (G.commonNeighbors (f u) (f v))) : F=∅ := by
  classical
  apply eq_empty_iff_forall_notMem.mpr
  intro f hf
  have hadj := f.toHom.map_adj huv
  have hempty : IsEmpty (G.commonNeighbors (f u) (f v)) := ⟨by
    rintro ⟨w,hw⟩
    exact htri (f u) (f v) w hadj hw.2 hw.1⟩
  have hz : Fintype.card (G.commonNeighbors (f u) (f v))=0 :=
    Fintype.card_eq_zero
  have hh := hbad f hf
  omega

/-- Every fixed unequal pair of template roles has the same heavy-copy bound. -/
theorem pair_bound (hH : H.Connected)
    (htri : ∀x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    {u v : V} (huv : u≠v) (L : ℕ) (hL : 1 ≤ L)
    (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T) (hdeg : ∀x, (G.degree x:ℝ) ≤ D)
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y ≤ T)
    (F : Finset (H.Copy G)) (hbad : ∀f∈F, L ≤ Fintype.card (G.commonNeighbors (f u) (f v))) :
    (L:ℝ)*F.card ≤ (Fintype.card W:ℝ)*T*D^(Fintype.card V-3) := by
  classical
  obtain ⟨p⟩ := hH.preconnected u v
  let q := p.toPath
  have hp : q.val.length≠0 := fun h => huv (Walk.eq_of_length_eq_zero h)
  by_cases hone : q.val.length=1
  · rw [adjacent_heavy_empty H G htri (Walk.adj_of_length_eq_one hone) L hL F hbad,
      card_empty,Nat.cast_zero,mul_zero]
    positivity
  · exact heavy_pair_copy_bound H G hH q.val q.property (q.val.length-2) (by omega)
      L D T hD hT hdeg hfour F hbad

/-- All pairs, not just endpoints of two-edge template paths, may be cleaned. -/
theorem bad_bound (hH : H.Connected)
    (htri : ∀x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    (L : ℕ) (hL : 1 ≤ L) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hdeg : ∀x, (G.degree x:ℝ) ≤ D) (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y ≤ T)
    (F : Finset (H.Copy G)) (hbad : ∀f∈F, ¬Light H G L f) :
    (L:ℝ)*F.card ≤ (Fintype.card V:ℝ)^2*(Fintype.card W:ℝ)*T*D^(Fintype.card V-3) := by
  classical
  let B : V×V → Finset (H.Copy G) := fun p => F.filter
    (fun f => p.1≠p.2 ∧ L ≤ Fintype.card (G.commonNeighbors (f p.1) (f p.2)))
  have hsub : F ⊆ univ.biUnion B := by
    intro f hf
    have hb := hbad f hf
    simp only [Light,not_forall, _root_.not_imp,not_lt] at hb
    obtain ⟨u,v,huv,hh⟩ := hb
    exact mem_biUnion.mpr ⟨(u,v),mem_univ _,mem_filter.mpr ⟨hf,huv,hh⟩⟩
  have hb (p : V×V) : (L:ℝ)*(B p).card ≤ (Fintype.card W:ℝ)*T*D^(Fintype.card V-3) := by
    by_cases he : p.1=p.2
    · have hz : B p=∅ := by simp [B,he]
      rw [hz,card_empty,Nat.cast_zero,mul_zero]; positivity
    · exact pair_bound H G hH htri he L hL D T hD hT hdeg hfour (B p)
        (fun f hf => (mem_filter.mp hf).2.2)
  have hc : (F.card:ℝ) ≤ ∑p : V×V, ((B p).card:ℝ) := by
    exact_mod_cast ((card_le_card hsub).trans (card_biUnion_le))
  calc
    _ ≤ (L:ℝ)*∑p : V×V, ((B p).card:ℝ) := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg L)
    _ = ∑p : V×V, (L:ℝ)*(B p).card := mul_sum _ _ _
    _ ≤ ∑_p : V×V, (Fintype.card W:ℝ)*T*D^(Fintype.card V-3) := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp only [sum_const,card_univ,Fintype.card_prod,Nat.cast_mul,nsmul_eq_mul]; ring

end Erdos571.GloballyLightCopies

/-! Abundant injective copies whose entire vertex set has bounded codegrees. -/
set_option maxHeartbeats 2200000
namespace Erdos571.GloballyLightCopies
open Finset SimpleGraph DensityRegularization
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

theorem tree_abundance (hH : H.IsTree) (hv : 3 ≤ Fintype.card V)
    (htri : ∀x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q) (hd : 4*((Fintype.card V:ℝ)+1) ≤ d)
    (hmin : ∀x, d ≤ (G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ) ≤ Q*d)
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y ≤ C*(Q*d)^2)
    (L : ℕ) (hL : 1 ≤ L)
    (hcut : 2*(Fintype.card V:ℝ)^2*C*(4*Q)^(Fintype.card V-1) ≤ L) :
    (Fintype.card W:ℝ)*(d/4)^(Fintype.card V-1)/2 ≤ Nat.card (Family H G L) := by
  classical
  have hd0 : 0 ≤ d := by have hn := Nat.cast_nonneg (Fintype.card V) (α := ℝ); linarith
  have hQ0 : 0 ≤ Q := by linarith
  have hD : 0 ≤ Q*d := mul_nonneg hQ0 hd0
  have hLp : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  let B := (univ : Finset (H.Copy G)).filter (fun f => ¬Light H G L f)
  let F := (univ : Finset (H.Copy G)).filter (Light H G L)
  have hb := bad_bound H G hH.isConnected htri L hL (Q*d) (C*(Q*d)^2) hD
    (mul_nonneg hC (sq_nonneg _)) hmax hfour B (fun f hf => (mem_filter.mp hf).2)
  have he : 2+(Fintype.card V-3)=Fintype.card V-1 := by omega
  have hb' : (L:ℝ)*B.card ≤ (Fintype.card V:ℝ)^2*(Fintype.card W:ℝ)*C*(Q*d)^(Fintype.card V-1) := by
    apply hb.trans_eq
    calc
      _ = (Fintype.card V:ℝ)^2*(Fintype.card W:ℝ)*C*
          ((Q*d)^2*(Q*d)^(Fintype.card V-3)) := by ring
      _ = _ := by rw [←pow_add,he]
  have hpow : (4*Q)^(Fintype.card V-1)*(d/4)^(Fintype.card V-1)=(Q*d)^(Fintype.card V-1) := by
    rw [←mul_pow]
    congr 1
    ring
  have hsmall : 2*(B.card:ℝ) ≤ (Fintype.card W:ℝ)*(d/4)^(Fintype.card V-1) := by
    have hh : (2*(B.card:ℝ))*(L:ℝ) ≤
        ((Fintype.card W:ℝ)*(d/4)^(Fintype.card V-1))*(L:ℝ) := by
      calc
        _ = 2*((L:ℝ)*B.card) := by ring
        _ ≤ 2*((Fintype.card V:ℝ)^2*(Fintype.card W:ℝ)*C*(Q*d)^(Fintype.card V-1)) :=
          mul_le_mul_of_nonneg_left hb' (by norm_num)
        _ = (2*(Fintype.card V:ℝ)^2*C*(4*Q)^(Fintype.card V-1))*
            ((Fintype.card W:ℝ)*(d/4)^(Fintype.card V-1)) := by rw [←hpow]; ring
        _ ≤ (L:ℝ)*((Fintype.card W:ℝ)*(d/4)^(Fintype.card V-1)) :=
          mul_le_mul_of_nonneg_right hcut (by positivity)
        _ = _ := by ring
    exact (mul_le_mul_iff_left₀ hLp).mp (by simpa only [mul_comm (L:ℝ)] using hh)
  have hmin' : ∀x∈(univ : Finset W), d ≤ ((neighbors G univ x).card:ℝ) := by
    intro x _
    have he : neighbors G univ x=G.neighborFinset x := by ext y; simp [neighbors]
    rw [he,G.card_neighborFinset_eq_degree]
    exact hmin x
  have hall := TreeCopiesIn.lower H hH G univ hd hmin'
  have heall : TreeCopiesIn.copies H G univ=(univ : Finset (H.Copy G)) := by
    ext f
    simp only [TreeCopiesIn.mem_copies,Finset.mem_univ,implies_true]
  rw [heall,card_univ,card_univ] at hall
  have hsplit : F.card+B.card=Fintype.card (H.Copy G) := by
    simpa only [card_univ] using card_filter_add_card_filter_not (s := (univ : Finset (H.Copy G)))
      (Light H G L)
  have hsplit' : (F.card:ℝ)+(B.card:ℝ)=Fintype.card (H.Copy G) := by exact_mod_cast hsplit
  have hF : Nat.card (Family H G L)=F.card := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
  rw [hF]
  linarith

/-- Instance-independent form for large concrete templates. -/
theorem tree_abundance_nat (hH : H.IsTree) (hv : 3 ≤ Nat.card V)
    (htri : ∀x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q) (hd : 4*((Nat.card V:ℝ)+1) ≤ d)
    (hmin : ∀x, d ≤ (G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ) ≤ Q*d)
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y ≤ C*(Q*d)^2)
    (L : ℕ) (hL : 1 ≤ L)
    (hcut : 2*(Nat.card V:ℝ)^2*C*(4*Q)^(Nat.card V-1) ≤ L) :
    (Nat.card W:ℝ)*(d/4)^(Nat.card V-1)/2 ≤ Nat.card (Family H G L) := by
  have h := tree_abundance H G hH
    (by simpa only [Nat.card_eq_fintype_card] using hv) htri C Q d hC hQ
    (by simpa only [Nat.card_eq_fintype_card] using hd) hmin hmax hfour L hL
    (by simpa only [Nat.card_eq_fintype_card] using hcut)
  simpa only [Nat.card_eq_fintype_card] using h

end Erdos571.GloballyLightCopies

/-! Globally light copies allow all cross-role pairs to be made light simultaneously. -/
set_option maxHeartbeats 1800000
namespace Erdos571.GloballyLightCopies
open Finset SimpleGraph PathwiseLightConflict
variable {V W : Type} [Fintype W] [DecidableEq W]

def AllBetween (K : SimpleGraph W) (f g : V → W) : Prop :=
  ∀u v, ¬K.Adj (f u) (g v)

lemma allBetween_symm (K : SimpleGraph W) {f g : V → W} (h : AllBetween K f g) :
    AllBetween K g f := by
  intro u v hh
  exact h v u hh.symm

lemma allRoles_iff (K : SimpleGraph W) (f g : V → W) :
    (∀p : V×V, ¬K.Adj (f p.1) (g p.2) ∧ ¬K.Adj (g p.1) (f p.2)) ↔ AllBetween K f g := by
  constructor
  · intro h u v
    exact (h (u,v)).1
  · intro h p
    exact ⟨h _ _,allBetween_symm K h _ _⟩

variable [Fintype V] [DecidableEq V]
lemma allBetween_of_light (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]
    (L : ℕ) (f : H.Copy G) (hf : Light H G (L+1) f) :
    AllBetween (HostHeavyShadow.graph G univ (L+1)) f f := by
  intro u v hh
  by_cases he : u=v
  · subst v
    exact hh.1 rfl
  · have hc := hf u v he
    have hh' := hh.2
    rw [HostHeavyShadow.common_univ_card] at hh'
    omega

variable {A R I J : Type} [Fintype A] [Fintype R] [Nonempty A]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

/-- The entire union of two charged copies is light: not only matching roles,
and not only pairs at distance two in the template. -/
theorem copy_pair_card_bound (S : Finset I) (K : SimpleGraph W)
    (f : I → H.Copy G) (label : I → J) (hwithin : ∀i, AllBetween K (f i) (f i))
    (hroots : ∀i j, label i=label j → ∀r, f i (.inr r)=f j (.inr r))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    Nat.card (PairFamily S label (fun _ _ => True)) ≤
      (RamseyRoleMask.bound (2^(4*k)) M ((Nat.card (A⊕R))^2)-1) *
        Nat.card (PairFamily S label (fun i j =>
          (∃a b : A, f i (.inl a)=f j (.inl b)) ∧ AllBetween K (f i) (f j))) := by
  classical
  have h := RamseyMixedRoleConflict.pair_bound S K
    (fun (p : (A⊕R)×(A⊕R)) i => f i p.1)
    (fun (p : (A⊕R)×(A⊕R)) i => f i p.2)
    (fun p i => hwithin i _ _) (fun i => (f i).toHom) label hroots k M hM hK hf
  have hcard : Fintype.card ((A⊕R)×(A⊕R))=(Nat.card (A⊕R))^2 := by
    rw [Nat.card_eq_fintype_card,Fintype.card_prod,pow_two]
  simp only [hcard,PathwiseLightConflict.copy_conflict_iff,allRoles_iff] at h
  rw [pairFamily_card,pairFamily_card]
  convert h using 1 <;> congr 1 <;> try { congr 1 }
  all_goals
    apply congrArg Finset.card
    ext p
    simp only [PackingEnergy.fiberPairs,Finset.mem_filter]

variable [DecidableRel G.Adj] {Bv : Type} [Fintype Bv]

theorem actual_copy_pair_card_bound (B : SimpleGraph Bv) (c : Bv → Bool)
    (hc : ∀{u v}, B.Adj u v → c u≠c v) (L : ℕ)
    (hL : Nat.card Bv+Nat.card B.edgeSet ≤ L+1)
    (hB : (ProjectionHeavy.subdivision B).Free G)
    (S : Finset I) (f : I → H.Copy G) (label : I → J)
    (hlight : ∀i, Light H G (L+1) (f i))
    (hroots : ∀i j, label i=label j → ∀r, f i (.inr r)=f j (.inr r))
    (M : ℕ) (hM : 2 ≤ M) (hf : (FullRootedPower.graph H M).Free G) :
    Nat.card (PairFamily S label (fun _ _ => True)) ≤
      (RamseyRoleMask.bound (2^(4*Nat.card Bv)) M ((Nat.card (A⊕R))^2)-1) *
        Nat.card (PairFamily S label (fun i j =>
          (∃a b : A, f i (.inl a)=f j (.inl b)) ∧
            AllBetween (HostHeavyShadow.graph G univ (L+1)) (f i) (f j))) := by
  classical
  have hK := HostHeavyShadow.cutoff_bicliqueFree G B c hc L
    (by simpa only [Nat.card_eq_fintype_card] using hL) hB
  have hK' : (completeBipartiteGraph (Fin (Nat.card Bv)) (Fin (Nat.card Bv))).Free
      (HostHeavyShadow.graph G univ (L+1)) := by
    rw [Nat.card_eq_fintype_card]
    exact hK
  exact copy_pair_card_bound S _ f label (fun i => allBetween_of_light H G L (f i) (hlight i))
    hroots _ M hM hK' hf

end Erdos571.GloballyLightCopies

/-! Globally light ThreeHub copies and globally light charged overlaps. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHub
open Finset SimpleGraph PathwiseLightConflict

lemma exists_global_light_cap (s M : ℕ) (Q : ℝ) : ∃L : ℕ, pathwiseCap s M ≤ L ∧
    2*(6*(s:ℝ)+5)^2*momentCoefficient s M*(4*Q)^(6*s+4) ≤ (L:ℝ)+1 := by
  obtain ⟨N,hN⟩ := exists_nat_ge (2*(6*(s:ℝ)+5)^2*momentCoefficient s M*(4*Q)^(6*s+4))
  refine ⟨max (pathwiseCap s M) N,le_max_left _ _,?_⟩
  have hh : (N:ℝ) ≤ max (pathwiseCap s M) N := by exact_mod_cast le_max_right (pathwiseCap s M) N
  linarith

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- The host has no global codegree hypothesis. Every distinct pair of
vertices INSIDE each retained injective copy is light. -/
theorem globally_light_abundance (s M : ℕ) (hs : 1 ≤ s)
    (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 4*(6*(s:ℝ)+6) ≤ d)
    (hmin : ∀x, d ≤ (G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ) ≤ Q*d)
    (L : ℕ) (hcut : 2*(6*(s:ℝ)+5)^2*momentCoefficient s M*(4*Q)^(6*s+4) ≤ (L:ℝ)+1) :
    (Nat.card W:ℝ)*(d/4)^(6*s+4)/2 ≤
      Nat.card (GloballyLightCopies.Family (template s) G (L+1)) := by
  classical
  have hd0 : 0 ≤ d := by have hs0 : (0:ℝ) ≤ s := Nat.cast_nonneg s; linarith
  have hD : 0 ≤ Q*d := mul_nonneg (by linarith) hd0
  have hfour (x y : W) : ((G.adjMatrix ℝ)^4) x y ≤ momentCoefficient s M*(Q*d)^2 := by
    have hh := free_fourWalk_bound s M G hf (Q*d) hD hmax x y
    simpa only [show (4:ℕ)=2+2 from rfl,pow_add,pow_two] using hh
  have hnum : Nat.card (RootedSubdivision.Vertex (base s))-1=6*s+4 := by
    rw [template_vertex_card s hs]
    omega
  have h := GloballyLightCopies.tree_abundance_nat (template s) G (template_isTree s)
    (by rw [template_vertex_card s hs]; omega) (LocalFourthWalk.triangle_free_of_bipartite G hb)
    (momentCoefficient s M) Q d (momentCoefficient_nonneg s M) hQ
    (by
      convert hd using 1
      rw [template_vertex_card s hs]
      push_cast
      ring)
    hmin hmax hfour (L+1) (by omega)
    (by simpa only [template_vertex_card s hs,hnum,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,
        show 6*s+5-1=6*s+4 by omega,Nat.cast_one] using hcut)
  simpa only [hnum] using h

variable {I J : Type}

/-- Full root-agreement energy is charged to overlapping pairs whose ENTIRE
combined vertex set is light. This is not a bounded-codegree host reduction. -/
theorem globally_light_pair_bound (s M : ℕ) (hs : 1 ≤ s) (L : ℕ)
    (hL : pathwiseCap s M ≤ L) (S : Finset I) (f : I → (template s).Copy G) (label : I → J)
    (hlight : ∀i, GloballyLightCopies.Light (template s) G (L+1) (f i))
    (hroots : ∀i j, label i=label j → ∀r : RootedSubdivision.Root (base s),
      f i (.inr r)=f j (.inr r)) (hM : 2 ≤ M) (hf : (graph s M).Free G) :
    Nat.card (PairFamily S label (fun _ _ => True)) ≤
      (RamseyRoleMask.bound (2^(4*Nat.card (Branch s M))) M ((6*s+5)^2)-1) *
      Nat.card (PairFamily S label (fun i j =>
        (∃a b : RootedSubdivision.Nonroot (base s), f i (.inl a)=f j (.inl b)) ∧
          GloballyLightCopies.AllBetween (HostHeavyShadow.graph G univ (L+1)) (f i) (f j))) := by
  classical
  let c : (FullRootedPower.graph (base s) (M+1)).Coloring Bool :=
    (base_power_bipartite s (M+1)).toColoring (by simp)
  have h := GloballyLightCopies.actual_copy_pair_card_bound
    (H := template s) (G := G) (I := I) (J := J) _ c c.valid L (hL.trans (Nat.le_succ _))
    (subdivision_free s M G hf) S f label hlight hroots M hM hf
  simpa only [template_vertex_card s hs] using h

end Erdos571.ThreeHub

/-! Retaining full fiber energy under clique-free pair masks, without a packing hypothesis. -/
set_option maxHeartbeats 1600000
namespace Erdos571.RamseyMaskEnergy
open Finset SimpleGraph
variable {I J : Type*} [DecidableEq I] [DecidableEq J]

open Classical in
theorem weighted_bound (S : Finset I) (L : List (SimpleGraph I)) (label : I → J)
    (k : ℕ) (hL : ∀K∈L, K.CliqueFree k) (w : I → ℝ) (hw : ∀i∈S, 0 ≤ w i) :
    (∑e∈PackingEnergy.fiberPairs S label (fun _ _ => True), w e.1*w e.2) ≤
      (RamseyRoleMask.bound k 2 L.length-1:ℕ)*
      ∑e∈PackingEnergy.fiberPairs S label (fun i j => ∀K∈L, ¬K.Adj i j), w e.1*w e.2 := by
  classical
  let B := RamseyRoleMask.union L (⊥ : SimpleGraph I)
  let p := RamseyRoleMask.bound k 2 L.length
  have hp : 2 ≤ p := RamseyRoleMask.bound_ge_two k 2 _ le_rfl
  have hB : B.CliqueFree p := RamseyRoleMask.union_cliqueFree L ⊥ k 2
    (SimpleGraph.cliqueFree_bot le_rfl) hL
  have hn (r : J) : ¬∃ U⊆S.filter (fun i => label i=r), U.card=p ∧
      ∀i∈U, ∀j∈U, i≠j → ¬(¬B.Adj i j) := by
    rintro ⟨U,hU,hUc,hh⟩
    exact hB U ⟨fun i hi j hj hij => not_not.mp (hh i hi j hj hij),hUc⟩
  have hh := PackingEnergy.weighted_fiber_second_moment S label (fun i j => ¬B.Adj i j)
    (fun i hi => B.loopless i) (fun i hi j hj h ha => h (B.symm ha)) p hp hn w hw
  have he : PackingEnergy.fiberPairs S label (fun i j => ¬B.Adj i j)=
      PackingEnergy.fiberPairs S label (fun i j => ∀K∈L, ¬K.Adj i j) := by
    ext e
    simp only [PackingEnergy.fiberPairs,mem_filter,B,RamseyRoleMask.union_nonadj,
      SimpleGraph.bot_adj,not_false_eq_true,true_and]
  rw [PackingEnergy.sum_fiber_mass_sq,he] at hh
  exact hh

open Classical in
theorem pair_bound (S : Finset I) (L : List (SimpleGraph I)) (label : I → J)
    (k : ℕ) (hL : ∀K∈L, K.CliqueFree k) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤
      (RamseyRoleMask.bound k 2 L.length-1)*
      (PackingEnergy.fiberPairs S label (fun i j => ∀K∈L, ¬K.Adj i j)).card := by
  have h := weighted_bound S L label k hL (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

end Erdos571.RamseyMaskEnergy

/-! Global lightness can be retained separately in every pinned subfamily. -/
set_option maxHeartbeats 1800000
namespace Erdos571.GloballyLightEnergy
open Finset SimpleGraph GloballyLightCopies
variable {V W I J : Type} [Fintype V] [Fintype W] [DecidableEq W] [DecidableEq I] [DecidableEq J]

def factor (k v : ℕ) : ℕ := RamseyRoleMask.bound (2^(4*k)) 2 (v^2)-1

lemma factor_pos (k v : ℕ) : 0 < factor k v := by
  have h := RamseyRoleMask.bound_ge_two (2^(4*k)) 2 (v^2) le_rfl
  unfold factor
  omega

open Classical in
/-- The same fixed factor works for EVERY label map, including a pin added
to the root labels. No forbidden rooted power is assumed. -/
theorem weighted_retention (S : Finset I) (K : SimpleGraph W) (f : I → V → W)
    (hwithin : ∀i, AllBetween K (f i) (f i)) (label : I → J)
    (k : ℕ) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (w : I → ℝ) (hw : ∀i∈S, 0 ≤ w i) :
    (∑e∈PackingEnergy.fiberPairs S label (fun _ _ => True), w e.1*w e.2) ≤
      (factor k (Nat.card V):ℝ)*
      ∑e∈PackingEnergy.fiberPairs S label (fun i j => AllBetween K (f i) (f j)), w e.1*w e.2 := by
  let a : V×V → I → W := fun p i => f i p.1
  let b : V×V → I → W := fun p i => f i p.2
  have hab : ∀p i, ¬K.Adj (a p i) (b p i) := fun p i => hwithin i _ _
  have h := RamseyMaskEnergy.weighted_bound S (RamseyMixedRoleConflict.masks K a b) label
    (2^(4*k)) (RamseyMixedRoleConflict.masks_free K a b hab k hK) w hw
  have hlen : (RamseyMixedRoleConflict.masks K a b).length=(Nat.card V)^2 := by
    rw [RamseyMixedRoleConflict.masks_length,Fintype.card_prod,Nat.card_eq_fintype_card,pow_two]
  have he (i j : I) : (∀Q∈RamseyMixedRoleConflict.masks K a b, ¬Q.Adj i j) ↔
      AllBetween K (f i) (f j) :=
    (RamseyMixedRoleConflict.masks_nonadj K a b hab i j).trans (allRoles_iff K (f i) (f j))
  simpa only [hlen,he,factor] using h

open Classical in
theorem pair_retention (S : Finset I) (K : SimpleGraph W) (f : I → V → W)
    (hwithin : ∀i, AllBetween K (f i) (f i)) (label : I → J)
    (k : ℕ) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K) :
    (PackingEnergy.fiberPairs S label (fun _ _ => True)).card ≤ factor k (Nat.card V)*
      (PackingEnergy.fiberPairs S label (fun i j => AllBetween K (f i) (f j))).card := by
  have h := weighted_retention S K f hwithin label k hK (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one] at h
  exact_mod_cast h

variable {A R : Type} [Fintype A] [Fintype R]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

noncomputable def pinned (S : Finset I) (K : SimpleGraph W) (f : I → H.Copy G) (a : A) :
    Finset (I×I) := by
  classical
  exact PackingEnergy.fiberPairs S (RootedCollisionEnergy.pinLabel f a)
    (fun i j => AllBetween K (f i) (f j))

/-- Ordinary cross-role Cauchy is followed by mask retention on each same-role
pin. Thus the right side really does retain global lightness. -/
theorem weighted_single_pin_bound [Nonempty A] (S : Finset I) (K : SimpleGraph W)
    (f : I → H.Copy G) (hwithin : ∀i, AllBetween K (f i) (f i))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G)
    (w : I → ℝ) (hw : ∀i∈S, 0 ≤ w i) :
    (∑e∈RootedCollisionEnergy.agreements S f, w e.1*w e.2) ≤
      ((M-1:ℕ):ℝ)*(Fintype.card A:ℝ)*(factor k (Nat.card (A⊕R)):ℝ)*
        (∑a, ∑e∈pinned S K f a, w e.1*w e.2) := by
  classical
  have h := RootedCollisionEnergy.weighted_single_pin_bound S f M hM hf w hw
  have hp (a : A) : (∑e∈RootedCollisionEnergy.pinned S f a, w e.1*w e.2) ≤
      (factor k (Nat.card (A⊕R)):ℝ)*(∑e∈pinned S K f a, w e.1*w e.2) := by
    exact weighted_retention S K (fun i => (f i : A⊕R → W)) hwithin
      (RootedCollisionEnergy.pinLabel f a) k hK w hw
  have hs : (∑a, ∑e∈RootedCollisionEnergy.pinned S f a, w e.1*w e.2) ≤
      (factor k (Nat.card (A⊕R)):ℝ)*(∑a, ∑e∈pinned S K f a, w e.1*w e.2) := by
    rw [mul_sum]
    exact sum_le_sum (fun a _ => hp a)
  exact h.trans (by
    have hh := mul_le_mul_of_nonneg_left hs
      (mul_nonneg (Nat.cast_nonneg (M-1)) (Nat.cast_nonneg (Fintype.card A)))
    simpa only [mul_assoc] using hh)

theorem single_pin_bound [Nonempty A] (S : Finset I) (K : SimpleGraph W)
    (f : I → H.Copy G) (hwithin : ∀i, AllBetween K (f i) (f i))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    (RootedCollisionEnergy.agreements S f).card ≤
      (M-1)*Fintype.card A*factor k (Nat.card (A⊕R))*(∑a, (pinned S K f a).card) := by
  have h := weighted_single_pin_bound S K f hwithin k M hM hK hf (fun _ => 1) (by intros; norm_num)
  simp only [mul_one,sum_const,nsmul_eq_mul,mul_one,Nat.cast_sum] at h
  exact_mod_cast h

/-- Instance-independent single-role form: one globally light pin carries a
fixed fraction of the full root-agreement energy. -/
theorem exists_big_pin [Nonempty A] (S : Finset I) (K : SimpleGraph W)
    (f : I → H.Copy G) (hwithin : ∀i, AllBetween K (f i) (f i))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    ∃a : A, Nat.card (PathwiseLightConflict.PairFamily S (RootedCollisionEnergy.labels f)
        (fun _ _ => True)) ≤
      (M-1)*(Nat.card A)^2*factor k (Nat.card (A⊕R))*
        Nat.card (PathwiseLightConflict.PairFamily S (RootedCollisionEnergy.pinLabel f a)
          (fun i j => AllBetween K (f i) (f j))) := by
  classical
  obtain ⟨a,ha,hmax⟩ := Finset.exists_max_image (univ : Finset A)
    (fun a => (pinned S K f a).card) univ_nonempty
  have hsum : (∑b : A, (pinned S K f b).card) ≤ Fintype.card A*(pinned S K f a).card := by
    calc
      _ ≤ ∑_b : A, (pinned S K f a).card := sum_le_sum (fun b hb => hmax b hb)
      _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul]; rfl
  have h := (single_pin_bound S K f hwithin k M hM hK hf).trans
    (Nat.mul_le_mul_left ((M-1)*Fintype.card A*factor k (Nat.card (A⊕R))) hsum)
  have hE : Nat.card (PathwiseLightConflict.PairFamily S (RootedCollisionEnergy.labels f)
      (fun _ _ => True))=(RootedCollisionEnergy.agreements S f).card := by
    rw [PathwiseLightConflict.pairFamily_card]
    apply congrArg Finset.card
    ext p
    simp only [RootedCollisionEnergy.agreements,PackingEnergy.fiberPairs,Finset.mem_filter]
  have hP : Nat.card (PathwiseLightConflict.PairFamily S (RootedCollisionEnergy.pinLabel f a)
      (fun i j => AllBetween K (f i) (f j)))=(pinned S K f a).card := by
    rw [PathwiseLightConflict.pairFamily_card]
    apply congrArg Finset.card
    ext p
    simp only [pinned,PackingEnergy.fiberPairs,Finset.mem_filter]
  refine ⟨a,?_⟩
  rw [hE,hP,Nat.card_eq_fintype_card (α := A)]
  convert h using 1 <;> ring

end Erdos571.GloballyLightEnergy

/-! Root-label Cauchy combined with globally light same-role pin retention. -/
set_option maxHeartbeats 1800000
namespace Erdos571.GloballyLightEnergy
open Finset SimpleGraph GloballyLightCopies PathwiseLightConflict
variable {I J : Type} [DecidableEq I] [DecidableEq J]

lemma fiber_cauchy (S : Finset I) (label : I → J) :
    S.card^2 ≤ (S.image label).card*Nat.card (PairFamily S label (fun _ _ => True)) := by
  classical
  have h := PackingEnergy.fiber_bound S label (fun _ _ => True)
    (by intros; trivial) (by intros; trivial) 2 le_rfl (by
      rintro r ⟨T,hT,hcard,hsep⟩
      obtain ⟨i,hi,j,hj,hij⟩ := Finset.one_lt_card.mp (show 1 < T.card by omega)
      exact hsep i hi j hj hij trivial)
  rw [pairFamily_card]
  simp only [show (2:ℕ)-1=1 from rfl,one_mul] at h
  convert h using 1
  congr 1
  apply congrArg Finset.card
  ext p
  simp only [PackingEnergy.fiberPairs,mem_filter]

variable {A R W : Type} [Fintype A] [Fintype R] [Fintype W] [DecidableEq W]
variable {H : SimpleGraph (A⊕R)} {G : SimpleGraph W}

/-- No finite-set enumeration occurs in this pinned-copy type. -/
abbrev PinFamily (K : SimpleGraph W) (f : I → H.Copy G) (a : A) :=
  {p : I×I // (∀r, f p.1 (.inr r)=f p.2 (.inr r)) ∧
    f p.1 (.inl a)=f p.2 (.inl a) ∧ AllBetween K (f p.1) (f p.2)}

open Classical in
lemma pinFamily_card [Fintype I] (K : SimpleGraph W) (f : I → H.Copy G) (a : A) :
    Nat.card (PinFamily K f a)=Nat.card (PairFamily univ (RootedCollisionEnergy.pinLabel f a)
      (fun i j => AllBetween K (f i) (f j))) := by
  apply Nat.card_congr
  exact Equiv.subtypeEquivRight (fun p => by
    simp only [mem_univ,true_and,RootedCollisionEnergy.pinLabel,Prod.mk.injEq,
      RootedCollisionEnergy.labels,funext_iff,and_assoc])

/-- The size of the original family squared is bounded by the root-label
space times a single globally light pin. -/
theorem exists_large_pin [Fintype I] [Nonempty A] (K : SimpleGraph W)
    (f : I → H.Copy G) (hwithin : ∀i, AllBetween K (f i) (f i))
    (k M : ℕ) (hM : 2 ≤ M) (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free K)
    (hf : (FullRootedPower.graph H M).Free G) :
    ∃a : A, (Nat.card I)^2 ≤ (M-1)*(Nat.card A)^2*factor k (Nat.card (A⊕R))*
      (Nat.card W)^(Nat.card R)*Nat.card (PinFamily K f a) := by
  classical
  obtain ⟨a,ha⟩ := exists_big_pin univ K f hwithin k M hM hK hf
  have hc := fiber_cauchy (univ : Finset I) (RootedCollisionEnergy.labels f)
  have hr := RootedCollisionEnergy.labels_card (univ : Finset I) f (univ : Finset W)
    (by intros; exact mem_univ _)
  have hh := hc.trans (Nat.mul_le_mul hr ha)
  simp only [card_univ,←Nat.card_eq_fintype_card] at hh
  refine ⟨a,?_⟩
  rw [pinFamily_card]
  convert hh using 1 <;> ring

end Erdos571.GloballyLightEnergy

/-! An unconditional lower bound on an actual globally light ThreeHub pin. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHub
open Finset SimpleGraph GloballyLightCopies GloballyLightEnergy
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev GlobalCopies (s L : ℕ) := Family (template s) G (L+1)

abbrev GlobalPin (s L : ℕ) (a : RootedSubdivision.Nonroot (base s)) :=
  PinFamily (HostHeavyShadow.graph G univ (L+1))
    (fun f : GlobalCopies G s L => f.val) a

noncomputable def globalPinCoefficient (s M : ℕ) : ℕ :=
  (M-1)*(3*s+5)^2*factor (Nat.card (Branch s M)) (6*s+5)

/-- Original graph freeness, with no bounded-codegree assumption on the host,
forces a large same-role pin whose entire two-copy union is light. -/
theorem exists_global_pin (s M L : ℕ) (hs : 1 ≤ s) (hM : 2 ≤ M)
    (hL : pathwiseCap s M ≤ L) (hf : (graph s M).Free G) :
    ∃a : RootedSubdivision.Nonroot (base s),
      (Nat.card (GlobalCopies G s L))^2 ≤ globalPinCoefficient s M*
        (Nat.card W)^(3*s)*Nat.card (GlobalPin G s L a) := by
  classical
  letI := Fintype.ofFinite (GlobalCopies G s L)
  let c : (FullRootedPower.graph (base s) (M+1)).Coloring Bool :=
    (base_power_bipartite s (M+1)).toColoring (by simp)
  have hK := HostHeavyShadow.cutoff_bicliqueFree G _ c c.valid L
    (by simpa only [←Nat.card_eq_fintype_card] using hL.trans (Nat.le_succ L))
    (subdivision_free s M G hf)
  have hK' : (completeBipartiteGraph (Fin (Nat.card (Branch s M)))
      (Fin (Nat.card (Branch s M)))).Free (HostHeavyShadow.graph G univ (L+1)) := by
    rw [Nat.card_eq_fintype_card]
    exact hK
  have h := exists_large_pin (HostHeavyShadow.graph G univ (L+1))
    (fun f : GlobalCopies G s L => f.val)
    (fun f => allBetween_of_light (template s) G L f.val f.property)
    (Nat.card (Branch s M)) M hM hK' hf
  simpa only [template_root_card s hs,template_interior_card s hs,
    template_vertex_card s hs,globalPinCoefficient] using h

/-- First-moment abundance and Cauchy yield the squared tree-count lower
scale for one globally light pin. No matching sharp pin upper is asserted. -/
theorem global_pin_lower (s M L : ℕ) (hs : 1 ≤ s) (hM : 2 ≤ M)
    (hL : pathwiseCap s M ≤ L) (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 4*(6*(s:ℝ)+6) ≤ d)
    (hmin : ∀x, d ≤ (G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ) ≤ Q*d)
    (hcut : 2*(6*(s:ℝ)+5)^2*momentCoefficient s M*(4*Q)^(6*s+4) ≤ (L:ℝ)+1) :
    ∃a : RootedSubdivision.Nonroot (base s),
      ((Nat.card W:ℝ)*(d/4)^(6*s+4)/2)^2 ≤ (globalPinCoefficient s M:ℝ)*
        (Nat.card W:ℝ)^(3*s)*Nat.card (GlobalPin G s L a) := by
  obtain ⟨a,ha⟩ := exists_global_pin G s M L hs hM hL hf
  have h := globally_light_abundance G s M hs hf hb Q d hQ hd hmin hmax L hcut
  have hd0 : 0 ≤ d := by have hs0 : (0:ℝ) ≤ s := Nat.cast_nonneg s; linarith
  refine ⟨a,(pow_le_pow_left₀ (by positivity) h 2).trans ?_⟩
  exact_mod_cast ha

end Erdos571.ThreeHub


/-! Capped nonnegative weights can be rounded for a quadratic energy bound. -/
set_option maxHeartbeats 1800000
namespace Erdos571.CappedEnergy
open Finset
variable {V W : Type*} [DecidableEq V] [DecidableEq W]

/-- A set of the largest k weights dominates every capped fractional choice
of total mass at most Mk. -/
theorem linear_rounding (U : Finset V) (w f : V → ℝ) (k : ℕ)
    (M : ℝ) (hM : 0 ≤ M) (hw : ∀v∈U, 0 ≤ w v)
    (hf : ∀v∈U, 0 ≤ f v ∧ f v ≤ M) (hm : ∑v∈U, f v ≤ M*k) :
    ∃T ⊆ U, T.card ≤ k ∧ (∑v∈U, w v*f v) ≤ M*∑v∈T, w v := by
  by_cases hkU : U.card ≤ k
  · refine ⟨U,Subset.rfl,hkU,?_⟩
    rw [mul_sum]
    exact sum_le_sum (fun v hv => by nlinarith [hw v hv,(hf v hv).2])
  have hk : k ≤ U.card := by omega
  by_cases hk0 : k=0
  · subst k
    have hz : ∀v∈U, f v=0 := by
      intro v hv
      have h := single_le_sum (fun v hv => (hf v hv).1) hv
      simp only [Nat.cast_zero,mul_zero] at hm
      linarith [(hf v hv).1]
    refine ⟨∅,empty_subset _,by simp,?_⟩
    simp only [sum_empty,mul_zero]
    apply le_of_eq
    exact sum_eq_zero (fun v hv => by rw [hz v hv,mul_zero])
  obtain ⟨T₀,hT₀,hcard₀⟩ := exists_subset_card_eq hk
  have hne : (U.powersetCard k).Nonempty := ⟨T₀,mem_powersetCard.mpr ⟨hT₀,hcard₀⟩⟩
  obtain ⟨T,hT,hmax⟩ := exists_max_image (U.powersetCard k) (fun T => ∑v∈T, w v) hne
  obtain ⟨hTU,hTc⟩ := mem_powersetCard.mp hT
  have hTne : T.Nonempty := card_pos.mp (by omega)
  obtain ⟨z,hz,hmin⟩ := exists_min_image T w hTne
  have hout : ∀v∈U\T, w v ≤ w z := by
    intro v hv
    have hvU := (mem_sdiff.mp hv).1
    have hvT := (mem_sdiff.mp hv).2
    have hve : v∉T.erase z := fun h => hvT (mem_of_mem_erase h)
    have hsub : insert v (T.erase z) ⊆ U := insert_subset hvU ((erase_subset z T).trans hTU)
    have hcard : (insert v (T.erase z)).card=k := by
      rw [card_insert_of_notMem hve,card_erase_of_mem hz,hTc]
      omega
    have hh := hmax (insert v (T.erase z)) (mem_powersetCard.mpr ⟨hsub,hcard⟩)
    rw [sum_insert hve] at hh
    have he := sum_erase_add T w hz
    linarith
  have hdiff : (∑v∈U\T, w v*f v) ≤ w z*∑v∈U\T, f v := by
    rw [mul_sum]
    exact sum_le_sum (fun v hv => mul_le_mul_of_nonneg_right (hout v hv) (hf v (mem_sdiff.mp hv).1).1)
  have hinside : (∑v∈T, w v*f v)+w z*(M*k-∑v∈T, f v) ≤ M*∑v∈T, w v := by
    have ht : ∀v∈T, w v*f v+w z*(M-f v) ≤ M*w v := by
      intro v hv
      have hh := mul_nonneg (sub_nonneg.mpr (hmin v hv)) (sub_nonneg.mpr (hf v (hTU hv)).2)
      nlinarith
    have hh := sum_le_sum ht
    simp only [sum_add_distrib,mul_sub,sum_sub_distrib,←mul_sum,sum_const,hTc,nsmul_eq_mul] at hh
    convert hh using 1 <;> ring
  have hmass : (∑v∈U\T, f v) ≤ M*k-∑v∈T, f v := by
    have he := sum_sdiff hTU (f := f)
    linarith
  have hMdiff := mul_le_mul_of_nonneg_left hmass (hw z (hTU hz))
  refine ⟨T,hTU,hTc.le,?_⟩
  have he := sum_sdiff hTU (f := fun v => w v*f v)
  linarith

/-- An indicator-set energy bound extends to arbitrary capped nonnegative
weights, with exactly the square of the cap and no logarithmic loss. -/
theorem square_bound (S : Finset W) (U : Finset V) (A : W → V → ℝ)
    (hA : ∀x∈S, ∀v∈U, 0 ≤ A x v) (f : V → ℝ) (k : ℕ) (M B : ℝ)
    (hM : 0 ≤ M) (hB : 0 ≤ B) (hf : ∀v∈U, 0 ≤ f v ∧ f v ≤ M)
    (hm : ∑v∈U, f v ≤ M*k)
    (hset : ∀T ⊆ U, T.card ≤ k → (∑x∈S, (∑v∈T, A x v)^2) ≤ B) :
    (∑x∈S, (∑v∈U, A x v*f v)^2) ≤ M^2*B := by
  let g : W → ℝ := fun x => ∑v∈U, A x v*f v
  let w : V → ℝ := fun v => ∑x∈S, A x v*g x
  have hg : ∀x∈S, 0 ≤ g x := fun x hx =>
    sum_nonneg (fun v hv => mul_nonneg (hA x hx v hv) (hf v hv).1)
  have hw : ∀v∈U, 0 ≤ w v := fun v hv =>
    sum_nonneg (fun x hx => mul_nonneg (hA x hx v hv) (hg x hx))
  obtain ⟨T,hTU,hTk,ht⟩ := linear_rounding U w f k M hM hw hf hm
  have he : (∑v∈U, w v*f v)=∑x∈S, (g x)^2 := by
    simp only [w,sum_mul]
    rw [sum_comm]
    apply sum_congr rfl
    intro x hx
    calc
      _ = (∑v∈U, A x v*f v)*g x := by rw [sum_mul]; congr 1; funext v; ring
      _ = _ := by change g x*g x=(g x)^2; ring
  have hz : (∑v∈T, w v)=∑x∈S, g x*(∑v∈T, A x v) := by
    simp only [w]
    rw [sum_comm]
    apply sum_congr rfl
    intro x hx
    rw [mul_sum]
    exact sum_congr rfl (fun v hv => mul_comm _ _)
  rw [he,hz] at ht
  have hcs := sum_mul_sq_le_sq_mul_sq S g (fun x => ∑v∈T, A x v)
  have hE : 0 ≤ ∑x∈S, (g x)^2 := sum_nonneg (fun x hx => sq_nonneg _)
  have hEsq := pow_le_pow_left₀ hE ht 2
  rw [mul_pow] at hEsq
  have hb := hcs.trans (mul_le_mul_of_nonneg_left (hset T hTU hTk) hE)
  have hh := hEsq.trans (mul_le_mul_of_nonneg_left hb (sq_nonneg M))
  change (∑x∈S, (g x)^2) ≤ _
  by_cases hzE : (∑x∈S, (g x)^2)=0
  · rw [hzE]
    positivity
  have hp : 0 < ∑x∈S, (g x)^2 := lt_of_le_of_ne hE (Ne.symm hzE)
  apply (mul_le_mul_iff_right₀ hp).mp
  convert hh using 1 <;> ring

end Erdos571.CappedEnergy


/-! Hereditary density controls capped weighted neighborhood energy. -/
set_option maxHeartbeats 1800000
namespace Erdos571.NeighborhoodEnergy
open Finset SimpleGraph DensityRegularization
variable {V : Type*} [DecidableEq V]
variable (G : SimpleGraph V) [DecidableRel G.Adj]

/-- The indicator estimate extends to weights of cap M and total mass Mk.
There is no logarithmic loss and no support-size assumption on f. -/
theorem capped_second_moment (U : Finset V) (f : V → ℝ) (k : ℕ)
    (α C D M : ℝ) (hα : 0 < α) (hC : 0 ≤ C) (hD : 0 ≤ D) (hM : 0 ≤ M)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (hlocal : ∀S ⊆ U, ((arcs G S).card:ℝ) ≤ C*(S.card:ℝ)^α)
    (hf : ∀v∈U, 0 ≤ f v ∧ f v ≤ M) (hm : ∑v∈U, f v ≤ M*k) :
    (∑x∈U, (∑v∈neighbors G U x, f v)^2) ≤ 2*C*D*M^2*(2*(k:ℝ))^α := by
  classical
  let A : V → V → ℝ := fun x v => if G.Adj x v then 1 else 0
  have hA : ∀x∈U, ∀v∈U, 0 ≤ A x v := by
    intros
    dsimp [A]
    split_ifs <;> norm_num
  have hs (S : Finset V) (hSU : S ⊆ U) (hSk : S.card ≤ k) :
      (∑x∈U, (∑v∈S, A x v)^2) ≤ 2*C*D*(2*(k:ℝ))^α := by
    have h := small_set_second_moment G U S hSU hα hC hD hdeg hlocal
    have he (x : V) : (∑v∈S, A x v)=((neighbors G S x).card:ℝ) := by
      simp only [A,sum_boole,neighbors]
    simp only [he]
    exact h.trans (mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow (by positivity) (by exact_mod_cast Nat.mul_le_mul_left 2 hSk) hα.le)
      (by positivity))
  have h := CappedEnergy.square_bound U U A hA f k M (2*C*D*(2*(k:ℝ))^α)
    hM (by positivity) hf hm hs
  have he (x : V) : (∑v∈U, A x v*f v)=∑v∈neighbors G U x, f v := by
    simp only [A,neighbors,sum_filter,ite_mul,one_mul,zero_mul]
  simp only [he] at h
  convert h using 1 <;> ring

/-- A real mass parameter, with the one-unit ceiling error explicit. -/
theorem weighted_second_moment (U : Finset V) (f : V → ℝ)
    (α C D M m : ℝ) (hα : 0 < α) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hM : 0 < M) (hm0 : 0 ≤ m)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (hlocal : ∀S ⊆ U, ((arcs G S).card:ℝ) ≤ C*(S.card:ℝ)^α)
    (hf : ∀v∈U, 0 ≤ f v ∧ f v ≤ M) (hm : ∑v∈U, f v ≤ m) :
    (∑x∈U, (∑v∈neighbors G U x, f v)^2) ≤ 2*C*D*M^2*(2*(m/M+1))^α := by
  let k : ℕ := ⌈m/M⌉₊
  have hkm : m ≤ M*k := by
    have h := mul_le_mul_of_nonneg_left (Nat.le_ceil (m/M)) hM.le
    simpa only [mul_div_cancel₀ m hM.ne'] using h
  have h := capped_second_moment G U f k α C D M hα hC hD hM.le hdeg hlocal hf (hm.trans hkm)
  have hk : (k:ℝ) ≤ m/M+1 := (Nat.ceil_lt_add_one (div_nonneg hm0 hM.le)).le
  exact h.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow (by positivity) (by linarith) hα.le) (by positivity))

/-- If the mass parameter dominates the cap, the bound has the natural
homogeneous form M^(2-alpha) m^alpha. -/
theorem weighted_second_moment_homogeneous (U : Finset V) (f : V → ℝ)
    (α C D M m : ℝ) (hα : 0 < α) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hM : 0 < M) (hMm : M ≤ m)
    (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ) ≤ D)
    (hlocal : ∀S ⊆ U, ((arcs G S).card:ℝ) ≤ C*(S.card:ℝ)^α)
    (hf : ∀v∈U, 0 ≤ f v ∧ f v ≤ M) (hm : ∑v∈U, f v ≤ m) :
    (∑x∈U, (∑v∈neighbors G U x, f v)^2) ≤
      2*4^α*C*D*M^(2-α)*m^α := by
  have hm0 : 0 ≤ m := hM.le.trans hMm
  have h := weighted_second_moment G U f α C D M m hα hC hD hM hm0 hdeg hlocal hf hm
  have hratio : 1 ≤ m/M := (le_div_iff₀ hM).mpr (by simpa using hMm)
  have hb : 2*(m/M+1) ≤ 4*m/M := by
    calc
      _ ≤ 4*(m/M) := by linarith
      _ = _ := by ring
  have hh := h.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow (by positivity) hb hα.le) (by positivity))
  apply hh.trans_eq
  rw [Real.div_rpow (by positivity) hM.le,Real.mul_rpow (by norm_num : (0:ℝ) ≤ 4) hm0,
    Real.rpow_sub hM,Real.rpow_two]
  ring

end Erdos571.NeighborhoodEnergy


/-! Hereditary density bounds the return energies of light two-walk profiles. -/
set_option maxHeartbeats 2000000
namespace Erdos571.HereditaryLightProfiles
open Finset Matrix SimpleGraph DensityRegularization GramFeatures
variable {W : Type} [Fintype W] [DecidableEq W]

lemma row_square_mul_le (A B : Matrix W W ℝ) (hs : A.IsSymm)
    (hA : ∀x y, 0 ≤ A x y) (D : ℝ) (hD : 0 ≤ D)
    (hrow : ∀x, ∑y, A x y ≤ D) (u : W) :
    (∑x, ((B*A) u x)^2) ≤ D^2*∑x, (B u x)^2 := by
  have hn : ∀x y, 0 ≤ (A*A) x y := chain_nonneg hA hA
  have hr : ∀x, ∑y, (A*A) x y ≤ D^2 := fun x => by
    simpa only [pow_two] using chain_row_upper hA hD hrow hrow x
  have h := GramPin.row_gram_operator_bound A (D^2) (sq_nonneg D)
    (by simpa only [hs.eq] using hn) (by simpa only [hs.eq] using hr) (fun x => B u x)
  convert h using 1
  congr 1
  funext x
  congr 1
  simp only [Matrix.mul_apply]
  exact sum_congr rfl (fun y _ => by rw [hs.apply y x]; ring)

variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma light_profile_identity (L : ℝ) (u x : W) :
    (LightArmKernel.matrix G L*G.adjMatrix ℝ) u x =
      ∑v∈neighbors G univ x, LightArmKernel.matrix G L u v := by
  simp only [Matrix.mul_apply,SimpleGraph.adjMatrix_apply,neighbors,sum_filter]
  apply sum_congr rfl
  intro v hv
  simp only [G.adj_comm v x,mul_ite,mul_one,mul_zero]

/-- Six-walk return energy with both endpoint two-walks light. The density
coefficient is the hereditary one, not a new freeness assumption. -/
theorem light_six_profile (α C D L : ℝ) (hα : 0 < α) (hC : 0 ≤ C)
    (hD : 0 ≤ D) (hL : 0 < L) (hLD : L ≤ D^2)
    (hdeg : ∀x, (G.degree x:ℝ) ≤ D)
    (hlocal : ∀S : Finset W, (arcs G S).card ≤ C*(S.card:ℝ)^α) (u : W) :
    (∑x, ((LightArmKernel.matrix G L*G.adjMatrix ℝ) u x)^2) ≤
      2*4^α*C*D*L^(2-α)*(D^2)^α := by
  have h := NeighborhoodEnergy.weighted_second_moment_homogeneous G univ
    (fun v => LightArmKernel.matrix G L u v) α C D L (D^2) hα hC hD hL hLD
    (by
      intro x hx
      have he : neighbors G univ x=G.neighborFinset x := by ext v; simp [neighbors]
      rw [he,G.card_neighborFinset_eq_degree]
      exact hdeg x)
    (fun S hS => hlocal S)
    (fun v hv => ⟨LightArmKernel.nonneg G L u v,LightArmKernel.cap G L hL.le u v⟩)
    (LightArmKernel.row_upper G L D hD hdeg u)
  simpa only [light_profile_identity] using h

/-- Eight-walk return energy for the fully light kernel. -/
theorem light_eight_profile (α C D L : ℝ) (hα : 0 < α) (hC : 0 ≤ C)
    (hD : 0 ≤ D) (hL : 0 < L) (hLD : L ≤ D^2)
    (hdeg : ∀x, (G.degree x:ℝ) ≤ D)
    (hlocal : ∀S : Finset W, (arcs G S).card ≤ C*(S.card:ℝ)^α) (u : W) :
    (∑x, ((LightArmKernel.matrix G L*LightArmKernel.matrix G L) u x)^2) ≤
      2*4^α*C*D^3*L^(2-α)*(D^2)^α := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  have hA : ∀x y, 0 ≤ A x y := by
    intro x y
    dsimp [A,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hN := LightArmKernel.nonneg G L
  have hNN : ∀x y, 0 ≤ (N*N) x y := chain_nonneg hN hN
  have he (x : W) : (N*N) u x ≤ ((N*A)*A) u x := by
    rw [Matrix.mul_assoc]
    simp only [Matrix.mul_apply]
    exact sum_le_sum (fun v hv => mul_le_mul_of_nonneg_left
      (LightArmKernel.le_square G L v x) (hN u v))
  have h := row_square_mul_le A (N*A) G.isSymm_adjMatrix hA D hD
    (fun x => (ThreeHubKernel.adjacency_row_sum G x).le.trans (hdeg x)) u
  have hl := light_six_profile G α C D L hα hC hD hL hLD hdeg hlocal u
  calc
    _ ≤ ∑x, (((N*A)*A) u x)^2 := sum_le_sum (fun x hx => pow_le_pow_left₀ (hNN u x) (he x) 2)
    _ ≤ D^2*∑x, ((N*A) u x)^2 := h
    _ ≤ D^2*(2*4^α*C*D*L^(2-α)*(D^2)^α) := mul_le_mul_of_nonneg_left hl (sq_nonneg D)
    _ = _ := by ring

end Erdos571.HereditaryLightProfiles


/-! Leaf deletion for homomorphisms with one prescribed vertex. -/
set_option maxHeartbeats 1800000
namespace Erdos571.PinnedHomLeaf
open Finset SimpleGraph
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W)

abbrev Family (r : V) (x : W) := {f : H →g G // f r = x}

noncomputable instance familyFintype (r : V) (x : W) : Fintype (Family H G r x) := by
  classical
  exact Fintype.ofFinite _

noncomputable def extend (z w : V) (hw : ∀a, H.Adj z a → a=w)
    (hzw : H.Adj z w) (f : H.induce ({z}ᶜ : Set V) →g G) (y : W)
    (hy : G.Adj (f ⟨w,hzw.ne'⟩) y) : H →g G where
  toFun a := if ha : a=z then y else f ⟨a,ha⟩
  map_rel' := by
    intro a b hab
    by_cases ha : a=z
    · subst a
      have hb := hw b hab
      subst b
      simpa only [dif_pos rfl,dif_neg hzw.ne'] using hy.symm
    · by_cases hb : b=z
      · subst b
        have ha' := hw a hab.symm
        subst a
        simpa only [dif_pos rfl,dif_neg hzw.ne'] using hy
      · simpa only [dif_neg ha,dif_neg hb] using (f.map_adj (v := ⟨a,ha⟩) (w := ⟨b,hb⟩) hab)

@[simp] lemma extend_leaf (z w : V) (hw : ∀a, H.Adj z a → a=w)
    (hzw : H.Adj z w) (f : H.induce ({z}ᶜ : Set V) →g G) (y : W) (hy) :
    extend H G z w hw hzw f y hy z=y := by simp [extend]

@[simp] lemma extend_old (z w : V) (hw : ∀a, H.Adj z a → a=w)
    (hzw : H.Adj z w) (f : H.induce ({z}ᶜ : Set V) →g G) (y : W) (hy)
    (a : ({z}ᶜ : Set V)) : extend H G z w hw hzw f y hy a=f a := by
  have ha : a.val≠z := a.property
  change (if h : a.val=z then y else f ⟨a.val,h⟩)=f a
  simp only [dif_neg ha]

noncomputable def leafEquiv (r z w : V) (hzr : z≠r)
    (hw : ∀a, H.Adj z a → a=w) (hzw : H.Adj z w) (x : W) :
    Family H G r x ≃
      (f : Family (H.induce ({z}ᶜ : Set V)) G ⟨r,hzr.symm⟩ x) ×
        G.neighborSet (f.val ⟨w,hzw.ne'⟩) where
  toFun f := ⟨⟨⟨fun a => f.val a,fun h => f.val.map_adj h⟩,f.property⟩,
    ⟨f.val z,f.val.map_adj hzw.symm⟩⟩
  invFun p := ⟨extend H G z w hw hzw p.1.val p.2.val p.2.property,by
    change extend H G z w hw hzw p.1.val p.2.val p.2.property (⟨r,hzr.symm⟩ : ({z}ᶜ : Set V))=x
    rw [extend_old]; exact p.1.property⟩
  left_inv f := by
    apply Subtype.ext
    ext a
    by_cases ha : a=z
    · subst a; simp [extend]
    · simp [extend,ha]
  right_inv p := by
    rcases p with ⟨f,y⟩
    apply Sigma.ext
    · apply Subtype.ext
      ext a
      exact extend_old H G z w hw hzw f.val y.val y.property a
    · apply (Subtype.heq_iff_coe_eq (by
        intro t
        change G.Adj (extend H G z w hw hzw f.val y.val y.property (⟨w,hzw.ne'⟩ : ({z}ᶜ : Set V))) t ↔ G.Adj (f.val ⟨w,hzw.ne'⟩) t
        rw [extend_old])).mpr
      exact extend_leaf H G z w hw hzw f.val y.val y.property

lemma card_leaf [DecidableRel G.Adj] (r z w : V) (hzr : z≠r)
    (hw : ∀a, H.Adj z a → a=w) (hzw : H.Adj z w) (x : W) :
    Nat.card (Family H G r x)=
      ∑f : Family (H.induce ({z}ᶜ : Set V)) G ⟨r,hzr.symm⟩ x,
        G.degree (f.val ⟨w,hzw.ne'⟩) := by
  classical
  rw [Nat.card_congr (leafEquiv H G r z w hzr hw hzw x), Nat.card_eq_fintype_card,
    Fintype.card_sigma]
  apply sum_congr rfl
  intro f _
  exact G.card_neighborSet_eq_degree _

end Erdos571.PinnedHomLeaf


/-! A tree homomorphism upper bound with one vertex pinned. -/
set_option maxHeartbeats 1800000
namespace Erdos571.PinnedHomLeaf
open Finset SimpleGraph

 theorem card_upper {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.IsTree) (G : SimpleGraph W) [DecidableRel G.Adj]
    (r : V) (x : W) (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀y, (G.degree y:ℝ) ≤ D) :
    (Nat.card (Family H G r x):ℝ) ≤ D^(Fintype.card V-1) := by
  classical
  generalize hn : Fintype.card V=n at *
  induction n using Nat.strong_induction_on generalizing V with
  | h n ih =>
    rcases subsingleton_or_nontrivial V with hV|hV
    · letI := hV
      have hsub : Subsingleton (Family H G r x) := ⟨by
        intro f g
        apply Subtype.ext
        ext a
        rw [Subsingleton.elim a r, f.property, g.property]⟩
      have hc : Nat.card (Family H G r x) ≤ 1 := by
        letI := hsub
        simpa only [Nat.card_eq_fintype_card] using (Fintype.card_le_one_iff_subsingleton.mpr hsub)
      have hn1 : n=1 := by
        letI : Unique V := uniqueOfSubsingleton r
        rw [←hn]; exact Fintype.card_unique
      rw [hn1,Nat.sub_self,pow_zero]
      exact_mod_cast hc
    · letI := hV
      obtain ⟨z,hzr,hz⟩ := TreeCount.leaf_ne_root H hH r
      obtain ⟨w,hzw,hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz
      let S : Set V := {z}ᶜ
      have hS : (H.induce S).IsTree :=
        ⟨hH.isConnected.induce_compl_singleton_of_degree_eq_one hz,hH.IsAcyclic.induce S⟩
      have hcS : Fintype.card S=n-1 := by
        simp only [S,Fintype.card_compl_set,Fintype.card_unique,hn]
      have hn2 : 2 ≤ n := by rw [←hn]; exact Fintype.one_lt_card_iff_nontrivial.mpr hV
      have hSm : Fintype.card S<n := by omega
      have hI := ih (Fintype.card S) hSm (H.induce S) hS ⟨r,hzr.symm⟩ rfl
      have he := card_leaf H G r z w hzr hw hzw x
      have hb : (Nat.card (Family H G r x):ℝ) ≤
          D*(Nat.card (Family (H.induce S) G ⟨r,hzr.symm⟩ x):ℝ) := by
        rw [he,Nat.cast_sum]
        calc
          _ ≤ ∑_f : Family (H.induce S) G ⟨r,hzr.symm⟩ x, D := sum_le_sum (fun f _ => hdeg _)
          _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]; ring
      calc
        _ ≤ D*(Nat.card (Family (H.induce S) G ⟨r,hzr.symm⟩ x):ℝ) := hb
        _ ≤ D*D^(Fintype.card S-1) := mul_le_mul_of_nonneg_left hI hD
        _ = D^(n-1) := by rw [hcS,←pow_succ']; congr 1; omega

end Erdos571.PinnedHomLeaf


/-! Weighted leaf deletion moves a matrix weight along a tree edge. -/
set_option maxHeartbeats 2200000
namespace Erdos571.PinnedHomLeaf
open Finset SimpleGraph Matrix
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

noncomputable def energy (r : V) (x : W) (u v : V) (M : Matrix W W ℝ) : ℝ :=
  ∑f : Family H G r x, M (f.val u) (f.val v)

lemma energy_symm (r : V) (x : W) (u v : V) (M : Matrix W W ℝ) (hM : M.IsSymm) :
    energy H G r x u v M=energy H G r x v u M := by
  exact sum_congr rfl (fun f _ => hM.apply _ _)

lemma energy_leaf_eq (r z w : V) (hzr : z≠r) (hw : ∀a, H.Adj z a → a=w)
    (hzw : H.Adj z w) (x : W) (u v : V) (M : Matrix W W ℝ) :
    energy H G r x u v M=
      ∑f : Family (H.induce ({z}ᶜ : Set V)) G ⟨r,hzr.symm⟩ x,
      ∑y : G.neighborSet (f.val ⟨w,hzw.ne'⟩),
        M (extend H G z w hw hzw f.val y.val y.property u)
          (extend H G z w hw hzw f.val y.val y.property v) := by
  classical
  rw [energy]
  have he := Fintype.sum_equiv (leafEquiv H G r z w hzr hw hzw x)
    (fun f : Family H G r x => M (f.val u) (f.val v))
    (fun p => M (((leafEquiv H G r z w hzr hw hzw x).symm p).val u)
      (((leafEquiv H G r z w hzr hw hzw x).symm p).val v))
    (by intro f; simp only [Equiv.symm_apply_apply])
  simpa only [Fintype.sum_sigma,leafEquiv] using he

lemma energy_leaf_unmarked (r z w : V) (hzr : z≠r) (hw : ∀a, H.Adj z a → a=w)
    (hzw : H.Adj z w) (x : W) (u v : ({z}ᶜ : Set V)) (M : Matrix W W ℝ)
    (hM : ∀a b, 0 ≤ M a b) (D : ℝ) (hdeg : ∀y, (G.degree y:ℝ) ≤ D) :
    energy H G r x u v M ≤ D*energy (H.induce ({z}ᶜ : Set V)) G ⟨r,hzr.symm⟩ x u v M := by
  classical
  rw [energy_leaf_eq H G r z w hzr hw hzw x u v M]
  simp only [extend_old,sum_const,card_univ,G.card_neighborSet_eq_degree,nsmul_eq_mul]
  rw [energy,mul_sum]
  exact sum_le_sum (fun f _ => mul_le_mul_of_nonneg_right (hdeg _) (hM _ _))

lemma energy_leaf_marked (r z w : V) (hzr : z≠r) (hw : ∀a, H.Adj z a → a=w)
    (hzw : H.Adj z w) (x : W) (v : ({z}ᶜ : Set V)) (M : Matrix W W ℝ) :
    energy H G r x z v M =
      energy (H.induce ({z}ᶜ : Set V)) G ⟨r,hzr.symm⟩ x ⟨w,hzw.ne'⟩ v
        (G.adjMatrix ℝ * M) := by
  classical
  rw [energy_leaf_eq H G r z w hzr hw hzw x z v M,energy]
  apply sum_congr rfl
  intro f _
  simp only [extend_leaf,extend_old,G.adjMatrix_mul_apply]
  exact (Finset.sum_subtype (G.neighborFinset (f.val ⟨w,hzw.ne'⟩))
    (fun y => G.mem_neighborFinset _ _) (fun y => M y (f.val v))).symm

end Erdos571.PinnedHomLeaf


/-! A fourth-walk cap controls a weighted tree count with one arbitrary
vertex prescribed. Leaf deletion avoids any uniform rooted-fiber assumption. -/
set_option maxHeartbeats 2400000
namespace Erdos571.PinnedHomLeaf
open Finset SimpleGraph Matrix
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]

lemma admissible_card (H : SimpleGraph V) (hH : H.Connected) (u v : V) (k : ℕ)
    (hk : 2 ≤ k) (heq : u=v → 4 ≤ k) (hadj : H.Adj u v → 3 ≤ k) :
    5 ≤ Fintype.card V+k := by
  classical
  by_cases he : u=v
  · have hn : 1 ≤ Fintype.card V := by exact Fintype.card_pos_iff.mpr ⟨u⟩
    have := heq he
    omega
  have htwo : 2 ≤ Fintype.card V := by
    have hh := card_le_univ ({u,v} : Finset V)
    simpa only [card_pair he] using hh
  by_cases hthree : 3 ≤ k
  · omega
  have hna : ¬H.Adj u v := fun h => (by have := hadj h; omega)
  obtain ⟨p⟩ := hH.preconnected u v
  let q := p.toPath
  have hl0 : q.val.length≠0 := fun h => he (Walk.eq_of_length_eq_zero h)
  have hl1 : q.val.length≠1 := fun h => hna (Walk.adj_of_length_eq_one h)
  have hh := card_le_univ q.val.support.toFinset
  rw [List.toFinset_card_of_nodup q.property.support_nodup,Walk.length_support] at hh
  omega

lemma shifted_entry (A : Matrix W W ℝ) (hA : ∀x y, 0 ≤ A x y)
    (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T) (hrow : ∀x, ∑y, A x y ≤ D)
    (hfour : ∀x y, (A^4) x y ≤ T) (k : ℕ) (hk : 4 ≤ k) (x y : W) :
    (A^k) x y ≤ T*D^(k-4) := by
  have he : k=(k-4)+4 := by omega
  conv_lhs => rw [he,pow_add,Matrix.mul_apply]
  calc
    _ ≤ ∑z, (A^(k-4)) x z*T := sum_le_sum (fun z _ =>
      mul_le_mul_of_nonneg_left (hfour z y) (Matrix.pow_apply_nonneg hA _ _ _))
    _ = (∑z, (A^(k-4)) x z)*T := (sum_mul _ _ _).symm
    _ ≤ D^(k-4)*T := mul_le_mul_of_nonneg_right
      (HeavyLongWalks.power_row_upper A hA D hD hrow (k-4) x) hT
    _ = _ := mul_comm _ _

 theorem weighted_tree_bound (H : SimpleGraph V) (hH : H.IsTree)
    (G : SimpleGraph W) [DecidableRel G.Adj] (r : V) (x : W)
    (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T) (hdeg : ∀y, (G.degree y:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ T)
    (k : ℕ) (u v : V) (hk : 2 ≤ k) (heq : u=v → 4 ≤ k)
    (hadj : H.Adj u v → 3 ≤ k) :
    energy H G r x u v ((G.adjMatrix ℝ)^k) ≤ T*D^(Fintype.card V+k-5) := by
  classical
  let A := G.adjMatrix ℝ
  have hA : ∀a b, 0 ≤ A a b := by
    intro a b; dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (a : W) : ∑b, A a b ≤ D :=
    (ThreeHubKernel.adjacency_row_sum G a).le.trans (hdeg a)
  generalize hn : Fintype.card V=n at *
  induction n using Nat.strong_induction_on generalizing V k with
  | h n ih =>
    by_cases hk4 : 4 ≤ k
    · have hb := card_upper H hH G r x D hD hdeg
      have hnpos : 1 ≤ n := by rw [←hn]; exact Fintype.card_pos_iff.mpr ⟨r⟩
      calc
        _ ≤ ∑_f : Family H G r x, T*D^(k-4) :=
          sum_le_sum (fun f _ => shifted_entry A hA D T hD hT hrow hfour k hk4 _ _)
        _ = (Nat.card (Family H G r x):ℝ)*(T*D^(k-4)) := by
          simp only [sum_const,card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]
        _ ≤ D^(n-1)*(T*D^(k-4)) := mul_le_mul_of_nonneg_right (by simpa only [hn] using hb) (by positivity)
        _ = T*D^(n+k-5) := by
          rw [mul_left_comm,←pow_add]
          congr 2
          omega
    have huv : u≠v := fun h => hk4 (heq h)
    have hn2 : 2 ≤ n := by
      have hh := card_le_univ ({u,v} : Finset V)
      simp only [card_pair huv,hn] at hh
      exact hh
    letI : Nontrivial V := Fintype.one_lt_card_iff_nontrivial.mp (by omega)
    obtain ⟨z,hzr,hz⟩ := TreeCount.leaf_ne_root H hH r
    obtain ⟨w,hzw,hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz
    let S : Set V := {z}ᶜ
    have hS : (H.induce S).IsTree :=
      ⟨hH.isConnected.induce_compl_singleton_of_degree_eq_one hz,hH.IsAcyclic.induce S⟩
    have hcS : Fintype.card S=n-1 := by
      simp only [S,Fintype.card_compl_set,Fintype.card_unique,hn]
    have hSm : Fintype.card S<n := by omega
    have hmarked (t : V) (ht : t≠z) (hza : H.Adj z t → 3 ≤ k) :
        energy H G r x z t (A^k) ≤ T*D^(n+k-5) := by
      let tS : S := ⟨t,ht⟩
      let wS : S := ⟨w,hzw.ne'⟩
      have heq' : wS=tS → 4 ≤ k+1 := by
        intro h
        have hwt : w=t := congrArg Subtype.val h
        have := hza (hwt ▸ hzw)
        omega
      have hi := ih (Fintype.card S) hSm (H.induce S) hS ⟨r,hzr.symm⟩
        (k+1) wS tS (by omega) heq' (by intro h; omega) rfl
      have he := energy_leaf_marked H G r z w hzr hw hzw x tS (A^k)
      change energy H G r x z t (A^k) = _ at he
      rw [he,←pow_succ']
      apply hi.trans_eq
      congr 2
      omega
    by_cases huz : u=z
    · subst u
      exact hmarked v huv.symm hadj
    by_cases hvz : v=z
    · subst v
      rw [energy_symm H G r x u z (A^k) (G.isSymm_adjMatrix.pow k)]
      exact hmarked u huv (fun h => hadj h.symm)
    let uS : S := ⟨u,huz⟩
    let vS : S := ⟨v,hvz⟩
    have heq' : uS=vS → 4 ≤ k := fun h => heq (congrArg Subtype.val h)
    have hadj' : (H.induce S).Adj uS vS → 3 ≤ k := hadj
    have hi := ih (Fintype.card S) hSm (H.induce S) hS ⟨r,hzr.symm⟩
      k uS vS hk heq' hadj' rfl
    have hc := admissible_card (H.induce S) hS.isConnected uS vS k hk heq' hadj'
    have hl := energy_leaf_unmarked H G r z w hzr hw hzw x uS vS (A^k)
      (Matrix.pow_apply_nonneg hA k) D hdeg
    calc
      _ ≤ D*energy (H.induce S) G ⟨r,hzr.symm⟩ x uS vS (A^k) := hl
      _ ≤ D*(T*D^(Fintype.card S+k-5)) := mul_le_mul_of_nonneg_left hi hD
      _ = T*D^(n+k-5) := by
        rw [mul_left_comm,←pow_succ']
        congr 2
        omega

end Erdos571.PinnedHomLeaf


/-! Global lightness can be imposed uniformly at every prescribed image of
one tree vertex. No conditional bound for an entire root tuple is claimed. -/
set_option maxHeartbeats 2400000
namespace Erdos571.GloballyLightCopies
open Finset SimpleGraph Matrix
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma pinned_weight_bound (hH : H.IsTree) (r : V) (x : W) (u v : V)
    (huv : u≠v) (hna : ¬H.Adj u v)
    (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T) (hdeg : ∀y, (G.degree y:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ T)
    (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x) :
    (∑f∈F, (Fintype.card (G.commonNeighbors (f u) (f v)):ℝ)) ≤
      T*D^(Fintype.card V-3) := by
  classical
  let lift : F → PinnedHomLeaf.Family H G r x := fun f => ⟨f.val.toHom,hfix f.val f.property⟩
  have hi : Function.Injective lift := by
    intro f g he
    apply Subtype.ext
    apply Copy.ext
    intro a
    exact congrArg (fun p : PinnedHomLeaf.Family H G r x => p.val a) he
  let wt : PinnedHomLeaf.Family H G r x → ℝ := fun f =>
    ((G.adjMatrix ℝ)^2) (f.val u) (f.val v)
  have hw : ∀f, 0 ≤ wt f := by
    intro f
    dsimp [wt]
    rw [pow_two,LayeredBush.adjacency_square_common_card]
    positivity
  have hh : (∑f : F, wt (lift f)) ≤ ∑f, wt f := by
    rw [←sum_image (s := (univ : Finset F)) (f := wt) (hi.injOn)]
    exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun f _ _ => hw f)
  have he : (∑f : F, wt (lift f))=
      ∑f∈F, (Fintype.card (G.commonNeighbors (f u) (f v)):ℝ) := by
    simp only [wt,lift,pow_two,LayeredBush.adjacency_square_common_card]
    exact F.sum_coe_sort (fun f => (Fintype.card (G.commonNeighbors (f u) (f v)):ℝ))
  rw [he] at hh
  have hb := PinnedHomLeaf.weighted_tree_bound H hH G r x D T hD hT hdeg hfour
    2 u v (by omega) (fun h => (huv h).elim) (fun h => (hna h).elim)
  simpa only [show Fintype.card V+2-5=Fintype.card V-3 by omega] using hh.trans hb

 theorem pinned_pair_bound (hH : H.IsTree) (r : V) (x : W)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    {u v : V} (huv : u≠v) (L : ℕ) (hL : 1 ≤ L)
    (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T) (hdeg : ∀y, (G.degree y:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ T)
    (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x)
    (hbad : ∀f∈F, L ≤ Fintype.card (G.commonNeighbors (f u) (f v))) :
    (L:ℝ)*F.card ≤ T*D^(Fintype.card V-3) := by
  classical
  by_cases ha : H.Adj u v
  · rw [adjacent_heavy_empty H G htri ha L hL F hbad,card_empty,Nat.cast_zero,mul_zero]
    positivity
  have hb := pinned_weight_bound H G hH r x u v huv ha D T hD hT hdeg hfour F hfix
  have hs : (L:ℝ)*F.card ≤ ∑f∈F, (Fintype.card (G.commonNeighbors (f u) (f v)):ℝ) := by
    calc
      _ = ∑_f∈F, (L:ℝ) := by simp only [sum_const,nsmul_eq_mul]; ring
      _ ≤ _ := sum_le_sum (fun f hf => by exact_mod_cast hbad f hf)
  exact hs.trans hb

 theorem pinned_bad_bound (hH : H.IsTree) (r : V) (x : W)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (L : ℕ) (hL : 1 ≤ L) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hdeg : ∀y, (G.degree y:ℝ) ≤ D) (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ T)
    (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x) (hbad : ∀f∈F, ¬Light H G L f) :
    (L:ℝ)*F.card ≤ (Fintype.card V:ℝ)^2*T*D^(Fintype.card V-3) := by
  classical
  let B : V×V → Finset (H.Copy G) := fun p => F.filter
    (fun f => p.1≠p.2 ∧ L ≤ Fintype.card (G.commonNeighbors (f p.1) (f p.2)))
  have hsub : F ⊆ univ.biUnion B := by
    intro f hf
    have hb := hbad f hf
    simp only [Light,not_forall,_root_.not_imp,not_lt] at hb
    obtain ⟨u,v,huv,hh⟩ := hb
    exact mem_biUnion.mpr ⟨(u,v),mem_univ _,mem_filter.mpr ⟨hf,huv,hh⟩⟩
  have hb (p : V×V) : (L:ℝ)*(B p).card ≤ T*D^(Fintype.card V-3) := by
    by_cases he : p.1=p.2
    · have hz : B p=∅ := by simp [B,he]
      rw [hz,card_empty,Nat.cast_zero,mul_zero]; positivity
    · exact pinned_pair_bound H G hH r x htri he L hL D T hD hT hdeg hfour (B p)
        (fun f hf => hfix f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2.2)
  have hc : (F.card:ℝ) ≤ ∑p : V×V, ((B p).card:ℝ) := by
    exact_mod_cast ((card_le_card hsub).trans card_biUnion_le)
  calc
    _ ≤ (L:ℝ)*∑p : V×V, ((B p).card:ℝ) := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg L)
    _ = ∑p : V×V, (L:ℝ)*(B p).card := mul_sum _ _ _
    _ ≤ ∑_p : V×V, T*D^(Fintype.card V-3) := sum_le_sum (fun p _ => hb p)
    _ = _ := by simp only [sum_const,card_univ,Fintype.card_prod,Nat.cast_mul,nsmul_eq_mul]; ring

end Erdos571.GloballyLightCopies


/-! Uniform abundance of globally light tree copies with one prescribed vertex. -/
set_option maxHeartbeats 2400000
namespace Erdos571.GloballyLightCopies
open Finset SimpleGraph
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev PinnedFamily (L : ℕ) (r : V) (x : W) :=
  {f : H.Copy G // f r=x ∧ Light H G L f}

 theorem pinned_tree_abundance (hH : H.IsTree) (hv : 3 ≤ Fintype.card V)
    (r : V) (x : W)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q) (hd : 4*((Fintype.card V:ℝ)+1) ≤ d)
    (hmin : ∀y, d ≤ (G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ) ≤ Q*d)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*(Q*d)^2)
    (L : ℕ) (hL : 1 ≤ L)
    (hcut : 2*(Fintype.card V:ℝ)^2*C*(4*Q)^(Fintype.card V-1) ≤ L) :
    (d/4)^(Fintype.card V-1)/2 ≤ Nat.card (PinnedFamily H G L r x) := by
  classical
  have hd0 : 0 ≤ d := by have hn := Nat.cast_nonneg (Fintype.card V) (α := ℝ); linarith
  have hQ0 : 0 ≤ Q := by linarith
  have hD : 0 ≤ Q*d := mul_nonneg hQ0 hd0
  have hLp : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  let A := (univ : Finset (H.Copy G)).filter (fun f => f r=x)
  let B := A.filter (fun f => ¬Light H G L f)
  let F := A.filter (Light H G L)
  have hb := pinned_bad_bound H G hH r x htri L hL (Q*d) (C*(Q*d)^2) hD
    (mul_nonneg hC (sq_nonneg _)) hmax hfour B
    (fun f hf => (mem_filter.mp (mem_filter.mp hf).1).2)
    (fun f hf => (mem_filter.mp hf).2)
  have he : 2+(Fintype.card V-3)=Fintype.card V-1 := by omega
  have hb' : (L:ℝ)*B.card ≤ (Fintype.card V:ℝ)^2*C*(Q*d)^(Fintype.card V-1) := by
    apply hb.trans_eq
    calc
      _ = (Fintype.card V:ℝ)^2*C*((Q*d)^2*(Q*d)^(Fintype.card V-3)) := by ring
      _ = _ := by rw [←pow_add,he]
  have hpow : (4*Q)^(Fintype.card V-1)*(d/4)^(Fintype.card V-1)=(Q*d)^(Fintype.card V-1) := by
    rw [←mul_pow]
    congr 1
    ring
  have hsmall : 2*(B.card:ℝ) ≤ (d/4)^(Fintype.card V-1) := by
    have hh : (2*(B.card:ℝ))*(L:ℝ) ≤ ((d/4)^(Fintype.card V-1))*(L:ℝ) := by
      calc
        _ = 2*((L:ℝ)*B.card) := by ring
        _ ≤ 2*((Fintype.card V:ℝ)^2*C*(Q*d)^(Fintype.card V-1)) :=
          mul_le_mul_of_nonneg_left hb' (by norm_num)
        _ = (2*(Fintype.card V:ℝ)^2*C*(4*Q)^(Fintype.card V-1))*
            (d/4)^(Fintype.card V-1) := by rw [←hpow]; ring
        _ ≤ (L:ℝ)*(d/4)^(Fintype.card V-1) :=
          mul_le_mul_of_nonneg_right hcut (by positivity)
        _ = _ := by ring
    exact (mul_le_mul_iff_left₀ hLp).mp (by simpa only [mul_comm (L:ℝ)] using hh)
  have hn : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hflo : (⌊d/2⌋₊:ℝ) ≤ d/2 := Nat.floor_le (by linarith)
  have hfhi := Nat.lt_floor_add_one (d/2)
  have hflower : d/4 ≤ (⌊d/2⌋₊:ℝ) := by linarith
  have hnat := TreeCount.pinned_count_of_degree H hH G r x ⌊d/2⌋₊ (fun y => by
    have hh : (⌊d/2⌋₊:ℝ)+Fintype.card V ≤ (G.degree y:ℝ) := by linarith [hmin y]
    exact_mod_cast hh)
  have hA : Nat.card (TreeCount.Pinned H G r x)=A.card := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
  rw [hA] at hnat
  have hall : (d/4)^(Fintype.card V-1) ≤ (A.card:ℝ) :=
    (pow_le_pow_left₀ (by positivity) hflower _).trans (by exact_mod_cast hnat)
  have hsplit : F.card+B.card=A.card := card_filter_add_card_filter_not (s := A) (Light H G L)
  have hsplit' : (F.card:ℝ)+(B.card:ℝ)=A.card := by exact_mod_cast hsplit
  have hF : Nat.card (PinnedFamily H G L r x)=F.card := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
    congr 1
    ext f
    simp only [F,A,mem_filter,mem_univ,true_and]
  rw [hF]
  linarith

 theorem pinned_tree_abundance_nat (hH : H.IsTree) (hv : 3 ≤ Nat.card V)
    (r : V) (x : W)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q) (hd : 4*((Nat.card V:ℝ)+1) ≤ d)
    (hmin : ∀y, d ≤ (G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ) ≤ Q*d)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*(Q*d)^2)
    (L : ℕ) (hL : 1 ≤ L)
    (hcut : 2*(Nat.card V:ℝ)^2*C*(4*Q)^(Nat.card V-1) ≤ L) :
    (d/4)^(Nat.card V-1)/2 ≤ Nat.card (PinnedFamily H G L r x) := by
  have h := pinned_tree_abundance H G hH
    (by simpa only [Nat.card_eq_fintype_card] using hv) r x htri C Q d hC hQ
    (by simpa only [Nat.card_eq_fintype_card] using hd) hmin hmax hfour L hL
    (by simpa only [Nat.card_eq_fintype_card] using hcut)
  simpa only [Nat.card_eq_fintype_card] using h

end Erdos571.GloballyLightCopies


/-! Every prescribed host vertex supports many globally light ThreeHub copies. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHub
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem globally_light_pinned_abundance (s M : ℕ) (hs : 1 ≤ s)
    (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 4*(6*(s:ℝ)+6) ≤ d)
    (hmin : ∀x, d ≤ (G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ) ≤ Q*d)
    (L : ℕ) (r : RootedSubdivision.Vertex (base s)) (x : W) (hcut : 2*(6*(s:ℝ)+5)^2*momentCoefficient s M*(4*Q)^(6*s+4) ≤ (L:ℝ)+1) :
    (d/4)^(6*s+4)/2 ≤
      Nat.card (GloballyLightCopies.PinnedFamily (template s) G (L+1) r x) := by
  classical
  have hd0 : 0 ≤ d := by have hs0 : (0:ℝ) ≤ s := Nat.cast_nonneg s; linarith
  have hD : 0 ≤ Q*d := mul_nonneg (by linarith) hd0
  have hfour (x y : W) : ((G.adjMatrix ℝ)^4) x y ≤ momentCoefficient s M*(Q*d)^2 := by
    have hh := free_fourWalk_bound s M G hf (Q*d) hD hmax x y
    simpa only [show (4:ℕ)=2+2 from rfl,pow_add,pow_two] using hh
  have hnum : Nat.card (RootedSubdivision.Vertex (base s))-1=6*s+4 := by
    rw [template_vertex_card s hs]
    omega
  have h := GloballyLightCopies.pinned_tree_abundance_nat (template s) G (template_isTree s)
    (by rw [template_vertex_card s hs]; omega) r x (LocalFourthWalk.triangle_free_of_bipartite G hb)
    (momentCoefficient s M) Q d (momentCoefficient_nonneg s M) hQ
    (by
      convert hd using 1
      rw [template_vertex_card s hs]
      push_cast
      ring)
    hmin hmax hfour (L+1) (by omega)
    (by simpa only [template_vertex_card s hs,hnum,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,
        show 6*s+5-1=6*s+4 by omega,Nat.cast_one] using hcut)
  simpa only [hnum] using h

end Erdos571.ThreeHub


/-! Tree counts weighted by walks to a fixed external vertex. The hypotheses
at the prescribed image include the short walks of lengths two and three. -/
set_option maxHeartbeats 2400000
namespace Erdos571.PinnedExternalWalk
open Finset SimpleGraph Matrix PinnedHomLeaf
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]

noncomputable def weight (G : SimpleGraph W) [DecidableRel G.Adj]
    (y : W) (k : ℕ) : Matrix W W ℝ :=
  fun a _ => ((G.adjMatrix ℝ)^k) a y

lemma weight_nonneg (G : SimpleGraph W) [DecidableRel G.Adj] (y : W) (k : ℕ) :
    ∀a b, 0 ≤ weight G y k a b := by
  intro a b
  exact Matrix.pow_apply_nonneg (by
    intro u v
    dsimp [SimpleGraph.adjMatrix]
    split_ifs <;> norm_num) k a y

lemma mul_weight (G : SimpleGraph W) [DecidableRel G.Adj] (y : W) (k : ℕ) :
    G.adjMatrix ℝ * weight G y k = weight G y (k+1) := by
  ext a b
  simp only [weight, pow_succ', Matrix.mul_apply]

/-- Uniform external weights require short-walk bounds from the pinned image.
No root-tuple fiber bound is assumed. -/
theorem bound (H : SimpleGraph V) (hH : H.IsTree)
    (G : SimpleGraph W) [DecidableRel G.Adj] (r : V) (x y : W)
    (D C : ℝ) (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hdeg : ∀z, (G.degree z:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*D^2)
    (htwo : ((G.adjMatrix ℝ)^2) x y ≤ C)
    (hthree : ((G.adjMatrix ℝ)^3) x y ≤ C*D)
    (k : ℕ) (v : V) (hk : 2 ≤ k) :
    energy H G r x v r (weight G y k) ≤ C*D^(Fintype.card V+k-3) := by
  classical
  let A := G.adjMatrix ℝ
  have hA : ∀a b, 0 ≤ A a b := by
    intro a b
    dsimp [A, SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hrow (a : W) : ∑b, A a b ≤ D :=
    (ThreeHubKernel.adjacency_row_sum G a).le.trans (hdeg a)
  have hentry (j : ℕ) (hj : 4 ≤ j) (a b : W) :
      (A^j) a b ≤ C*D^(j-2) := by
    have hh := shifted_entry A hA D (C*D^2) hD (by positivity) hrow hfour j hj a b
    apply hh.trans_eq
    rw [mul_assoc, ←pow_add]
    congr 2
    omega
  have hfixed (j : ℕ) (hj : 2 ≤ j) : (A^j) x y ≤ C*D^(j-2) := by
    by_cases hj4 : 4 ≤ j
    · exact hentry j hj4 x y
    have he : j=2 ∨ j=3 := by omega
    rcases he with rfl|rfl
    · simpa using htwo
    · simpa using hthree
  generalize hn : Fintype.card V=n at *
  induction n using Nat.strong_induction_on generalizing V k with
  | h n ih =>
    have hnpos : 1 ≤ n := by
      rw [←hn]
      exact Fintype.card_pos_iff.mpr ⟨r⟩
    have hfinish (hb : ∀f : Family H G r x, (A^k) (f.val v) y ≤ C*D^(k-2)) :
        energy H G r x v r (weight G y k) ≤ C*D^(n+k-3) := by
      have hc := card_upper H hH G r x D hD hdeg
      calc
        _ ≤ ∑_f : Family H G r x, C*D^(k-2) := sum_le_sum (fun f _ => hb f)
        _ = (Nat.card (Family H G r x):ℝ)*(C*D^(k-2)) := by
          simp only [sum_const,card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]
        _ ≤ D^(n-1)*(C*D^(k-2)) :=
          mul_le_mul_of_nonneg_right (by simpa only [hn] using hc) (by positivity)
        _ = C*D^(n+k-3) := by
          rw [mul_left_comm,←pow_add]
          congr 2
          omega
    by_cases hk4 : 4 ≤ k
    · exact hfinish (fun f => hentry k hk4 _ _)
    by_cases hvr : v=r
    · apply hfinish
      intro f
      rw [hvr,f.property]
      exact hfixed k hk
    have hn2 : 2 ≤ n := by
      have hh := card_le_univ ({v,r} : Finset V)
      simpa only [card_pair hvr,hn] using hh
    letI : Nontrivial V := Fintype.one_lt_card_iff_nontrivial.mp (by omega)
    obtain ⟨z,hzr,hz⟩ := TreeCount.leaf_ne_root H hH r
    obtain ⟨w,hzw,hw⟩ := degree_eq_one_iff_existsUnique_adj.mp hz
    let S : Set V := {z}ᶜ
    have hS : (H.induce S).IsTree :=
      ⟨hH.isConnected.induce_compl_singleton_of_degree_eq_one hz,hH.IsAcyclic.induce S⟩
    have hcS : Fintype.card S=n-1 := by
      simp only [S,Fintype.card_compl_set,Fintype.card_unique,hn]
    have hSm : Fintype.card S<n := by omega
    let rS : S := ⟨r,hzr.symm⟩
    by_cases hvz : v=z
    · subst v
      let wS : S := ⟨w,hzw.ne'⟩
      have hi := ih (Fintype.card S) hSm (H.induce S) hS rS (k+1) wS (by omega) rfl
      have he := energy_leaf_marked H G r z w hzr hw hzw x rS (weight G y k)
      rw [mul_weight] at he
      change energy H G r x z r (weight G y k)=_ at he
      rw [he]
      apply hi.trans_eq
      congr 2
      omega
    · let vS : S := ⟨v,hvz⟩
      have hi := ih (Fintype.card S) hSm (H.induce S) hS rS k vS hk rfl
      have hl := energy_leaf_unmarked H G r z w hzr hw hzw x vS rS (weight G y k)
        (weight_nonneg G y k) D hdeg
      calc
        _ ≤ D*energy (H.induce S) G rS x vS rS (weight G y k) := hl
        _ ≤ D*(C*D^(Fintype.card S+k-3)) := mul_le_mul_of_nonneg_left hi hD
        _ = C*D^(n+k-3) := by
          rw [mul_left_comm,←pow_succ']
          congr 2
          have hSpos : 1 ≤ Fintype.card S := Fintype.card_pos_iff.mpr ⟨rS⟩
          omega

end Erdos571.PinnedExternalWalk


/-! Global lightness of a pinned tree copy relative to a fixed external set. -/
set_option maxHeartbeats 2400000
namespace Erdos571.PinnedExternalLight
open Finset SimpleGraph PinnedHomLeaf
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma weight_bound (hH : H.IsTree) (r : V) (x y : W) (v : V)
    (D C : ℝ) (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hdeg : ∀z, (G.degree z:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*D^2)
    (htwo : ((G.adjMatrix ℝ)^2) x y ≤ C)
    (hthree : ((G.adjMatrix ℝ)^3) x y ≤ C*D)
    (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x) :
    (∑f∈F, (Fintype.card (G.commonNeighbors (f v) y):ℝ)) ≤
      C*D^(Fintype.card V-1) := by
  classical
  let lift : F → Family H G r x := fun f => ⟨f.val.toHom,hfix f.val f.property⟩
  have hi : Function.Injective lift := by
    intro f g he
    apply Subtype.ext
    apply Copy.ext
    intro a
    exact congrArg (fun p : Family H G r x => p.val a) he
  let wt : Family H G r x → ℝ := fun f => ((G.adjMatrix ℝ)^2) (f.val v) y
  have hw (f) : 0 ≤ wt f := PinnedExternalWalk.weight_nonneg G y 2 (f.val v) x
  have hh : (∑f : F, wt (lift f)) ≤ ∑f, wt f := by
    rw [←sum_image (s := (univ : Finset F)) (f := wt) hi.injOn]
    exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun f _ _ => hw f)
  have he : (∑f : F, wt (lift f))=
      ∑f∈F, (Fintype.card (G.commonNeighbors (f v) y):ℝ) := by
    simp only [wt,lift,pow_two,LayeredBush.adjacency_square_common_card]
    exact F.sum_coe_sort (fun f => (Fintype.card (G.commonNeighbors (f v) y):ℝ))
  rw [he] at hh
  have hb := PinnedExternalWalk.bound H hH G r x y D C hD hC hdeg hfour htwo hthree 2 v (by omega)
  simpa only [energy,PinnedExternalWalk.weight,show Fintype.card V+2-3=Fintype.card V-1 by omega] using
    hh.trans hb

lemma pair_bound (hH : H.IsTree) (r : V) (x y : W) (v : V)
    (D C : ℝ) (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hdeg : ∀z, (G.degree z:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*D^2)
    (htwo : ((G.adjMatrix ℝ)^2) x y ≤ C)
    (hthree : ((G.adjMatrix ℝ)^3) x y ≤ C*D)
    (L : ℕ) (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x)
    (hbad : ∀f∈F, L ≤ Fintype.card (G.commonNeighbors (f v) y)) :
    (L:ℝ)*F.card ≤ C*D^(Fintype.card V-1) := by
  have hb := weight_bound H G hH r x y v D C hD hC hdeg hfour htwo hthree F hfix
  have hs : (L:ℝ)*F.card ≤ ∑f∈F, (Fintype.card (G.commonNeighbors (f v) y):ℝ) := by
    calc
      _ = ∑_f∈F, (L:ℝ) := by simp only [sum_const,nsmul_eq_mul]; ring
      _ ≤ _ := sum_le_sum (fun f hf => by exact_mod_cast hbad f hf)
  exact hs.trans hb

def Light (Z : Finset W) (L : ℕ) (f : H.Copy G) : Prop :=
  ∀y∈Z, ∀v, Fintype.card (G.commonNeighbors (f v) y)<L

lemma bad_bound (hH : H.IsTree) (r : V) (x : W) (Z : Finset W)
    (D C : ℝ) (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hdeg : ∀z, (G.degree z:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*D^2)
    (htwo : ∀y∈Z, ((G.adjMatrix ℝ)^2) x y ≤ C)
    (hthree : ∀y∈Z, ((G.adjMatrix ℝ)^3) x y ≤ C*D)
    (L : ℕ) (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x)
    (hbad : ∀f∈F, ¬Light H G Z L f) :
    (L:ℝ)*F.card ≤ (Z.card:ℝ)*Fintype.card V*C*D^(Fintype.card V-1) := by
  classical
  let B : Z×V → Finset (H.Copy G) := fun p => F.filter
    (fun f => L ≤ Fintype.card (G.commonNeighbors (f p.2) p.1.val))
  have hsub : F ⊆ univ.biUnion B := by
    intro f hf
    have hh := hbad f hf
    simp only [Light,not_forall,_root_.not_imp,not_lt] at hh
    obtain ⟨y,hy,v,hv⟩ := hh
    exact mem_biUnion.mpr ⟨(⟨y,hy⟩,v),mem_univ _,mem_filter.mpr ⟨hf,hv⟩⟩
  have hb (p : Z×V) : (L:ℝ)*(B p).card ≤ C*D^(Fintype.card V-1) :=
    pair_bound H G hH r x p.1.val p.2 D C hD hC hdeg hfour
      (htwo _ p.1.property) (hthree _ p.1.property) L (B p)
      (fun f hf => hfix f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hc : (F.card:ℝ) ≤ ∑p : Z×V, ((B p).card:ℝ) := by
    exact_mod_cast ((card_le_card hsub).trans card_biUnion_le)
  calc
    _ ≤ (L:ℝ)*∑p : Z×V, ((B p).card:ℝ) := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg L)
    _ = ∑p : Z×V, (L:ℝ)*(B p).card := mul_sum _ _ _
    _ ≤ ∑_p : Z×V, C*D^(Fintype.card V-1) := sum_le_sum (fun p _ => hb p)
    _ = _ := by
      simp only [sum_const,card_univ,Fintype.card_prod,Fintype.card_coe,Nat.cast_mul,nsmul_eq_mul]
      ring

end Erdos571.PinnedExternalLight


/-! Many pinned tree copies can avoid and remain light to a prescribed finite
external set. This is conditional on explicit short-walk bounds to that set. -/
set_option maxHeartbeats 2600000
namespace Erdos571.PinnedExternalLight
open Finset SimpleGraph
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev Extension (r : V) (x : W) (Z : Finset W) (L : ℕ) :=
  {f : H.Copy G // f r=x ∧ (∀v, f v∉Z) ∧
    GloballyLightCopies.Light H G L f ∧ Light H G Z L f}

theorem abundance (hH : H.IsTree) (hv : 3 ≤ Fintype.card V)
    (r : V) (x : W) (Z : Finset W) (hx : x∉Z)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q)
    (hd : 4*((Fintype.card V:ℝ)+Z.card+1) ≤ d)
    (hmin : ∀y, d ≤ (G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ) ≤ Q*d)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*(Q*d)^2)
    (htwo : ∀y∈Z, ((G.adjMatrix ℝ)^2) x y ≤ C)
    (hthree : ∀y∈Z, ((G.adjMatrix ℝ)^3) x y ≤ C*(Q*d))
    (L : ℕ) (hL : 1 ≤ L)
    (hcut : 2*((Fintype.card V:ℝ)^2+Z.card*Fintype.card V)*C*
      (4*Q)^(Fintype.card V-1) ≤ L) :
    (d/4)^(Fintype.card V-1)/2 ≤ Nat.card (Extension H G r x Z L) := by
  classical
  have hn : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hz : (0:ℝ) ≤ Z.card := Nat.cast_nonneg _
  have hd0 : 0 ≤ d := by linarith
  have hQ0 : 0 ≤ Q := by linarith
  have hD : 0 ≤ Q*d := mul_nonneg hQ0 hd0
  have hLp : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  let A := TreeCopiesIn.centeredAvoiding H G univ {x} Z r
  let B₁ := A.filter (fun f => ¬GloballyLightCopies.Light H G L f)
  let B₂ := A.filter (fun f => ¬Light H G Z L f)
  let Bad := A.filter (fun f => ¬(GloballyLightCopies.Light H G L f ∧ Light H G Z L f))
  let F := A.filter (fun f => GloballyLightCopies.Light H G L f ∧ Light H G Z L f)
  have hfix (f) (hf : f∈A) : f r=x := by
    have hm := (TreeCopiesIn.mem_centeredAvoiding H G univ {x} Z r f).mp hf
    simpa only [mem_singleton] using hm.2.1
  have hb₁ := GloballyLightCopies.pinned_bad_bound H G hH r x htri L hL
    (Q*d) (C*(Q*d)^2) hD (mul_nonneg hC (sq_nonneg _)) hmax hfour B₁
    (fun f hf => hfix f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hb₁' : (L:ℝ)*B₁.card ≤ (Fintype.card V:ℝ)^2*C*(Q*d)^(Fintype.card V-1) := by
    apply hb₁.trans_eq
    calc
      _ = (Fintype.card V:ℝ)^2*C*((Q*d)^2*(Q*d)^(Fintype.card V-3)) := by ring
      _ = _ := by rw [←pow_add,show 2+(Fintype.card V-3)=Fintype.card V-1 by omega]
  have hb₂ := bad_bound H G hH r x Z (Q*d) C hD hC hmax hfour htwo hthree L B₂
    (fun f hf => hfix f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  have hsub : Bad ⊆ B₁∪B₂ := by
    intro f hf
    obtain ⟨ha,hb⟩ := mem_filter.mp hf
    rcases not_and_or.mp hb with h|h
    · exact mem_union_left _ (mem_filter.mpr ⟨ha,h⟩)
    · exact mem_union_right _ (mem_filter.mpr ⟨ha,h⟩)
  have hbcard : (Bad.card:ℝ) ≤ (B₁.card:ℝ)+B₂.card := by
    exact_mod_cast ((card_le_card hsub).trans (card_union_le _ _))
  have hb : (L:ℝ)*Bad.card ≤
      ((Fintype.card V:ℝ)^2+Z.card*Fintype.card V)*C*(Q*d)^(Fintype.card V-1) := by
    calc
      _ ≤ (L:ℝ)*((B₁.card:ℝ)+B₂.card) := mul_le_mul_of_nonneg_left hbcard (Nat.cast_nonneg _)
      _ = (L:ℝ)*B₁.card+(L:ℝ)*B₂.card := mul_add _ _ _
      _ ≤ _ := (add_le_add hb₁' hb₂).trans_eq (by ring)
  have hpow : (4*Q)^(Fintype.card V-1)*(d/4)^(Fintype.card V-1)=(Q*d)^(Fintype.card V-1) := by
    rw [←mul_pow]
    congr 1
    ring
  have hsmall : 2*(Bad.card:ℝ) ≤ (d/4)^(Fintype.card V-1) := by
    have hh : (2*(Bad.card:ℝ))*(L:ℝ) ≤ ((d/4)^(Fintype.card V-1))*(L:ℝ) := by
      calc
        _ = 2*((L:ℝ)*Bad.card) := by ring
        _ ≤ 2*(((Fintype.card V:ℝ)^2+Z.card*Fintype.card V)*C*(Q*d)^(Fintype.card V-1)) :=
          mul_le_mul_of_nonneg_left hb (by norm_num)
        _ = (2*((Fintype.card V:ℝ)^2+Z.card*Fintype.card V)*C*(4*Q)^(Fintype.card V-1))*
            (d/4)^(Fintype.card V-1) := by rw [←hpow]; ring
        _ ≤ (L:ℝ)*(d/4)^(Fintype.card V-1) :=
          mul_le_mul_of_nonneg_right hcut (by positivity)
        _ = _ := by ring
    exact (mul_le_mul_iff_left₀ hLp).mp (by simpa only [mul_comm (L:ℝ)] using hh)
  have hall : (d/4)^(Fintype.card V-1) ≤ (A.card:ℝ) := by
    have ha := TreeCopiesIn.centered_avoiding_lower H hH G univ {x} Z r (subset_univ _)
      (disjoint_singleton_left.mpr hx) hd (fun y _ => by
        have he : DensityRegularization.neighbors G univ y=G.neighborFinset y := by
          ext z
          simp [DensityRegularization.neighbors]
        simpa only [he,card_neighborFinset_eq_degree] using hmin y)
    simpa only [card_singleton,Nat.cast_one,one_mul] using ha
  have hsplit : F.card+Bad.card=A.card := card_filter_add_card_filter_not (s := A)
    (fun f => GloballyLightCopies.Light H G L f ∧ Light H G Z L f)
  have hsplit' : (F.card:ℝ)+(Bad.card:ℝ)=A.card := by exact_mod_cast hsplit
  have hF : Nat.card (Extension H G r x Z L)=F.card := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
    congr 1
    ext f
    simp only [F,A,mem_filter,TreeCopiesIn.mem_centeredAvoiding,mem_univ,forall_true_iff,
      true_and,mem_singleton,and_assoc]
  rw [hF]
  linarith

end Erdos571.PinnedExternalLight


/-! Third-walk control from the image of a prescribed tree vertex. -/
set_option maxHeartbeats 2400000
namespace Erdos571.PinnedThirdLight
open Finset SimpleGraph Matrix PinnedHomLeaf
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma copy_weight_le (r : V) (x : W) (u v : V) (M : Matrix W W ℝ)
    (hM : ∀a b, 0 ≤ M a b) (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x) :
    (∑f∈F, M (f u) (f v)) ≤ energy H G r x u v M := by
  classical
  let lift : F → Family H G r x := fun f => ⟨f.val.toHom,hfix f.val f.property⟩
  have hi : Function.Injective lift := by
    intro f g he
    apply Subtype.ext
    apply Copy.ext
    intro a
    exact congrArg (fun p : Family H G r x => p.val a) he
  let wt : Family H G r x → ℝ := fun f => M (f.val u) (f.val v)
  have hh : (∑f : F, wt (lift f)) ≤ ∑f, wt f := by
    rw [←sum_image (s := (univ : Finset F)) (f := wt) hi.injOn]
    exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun f _ _ => hM _ _)
  have he : (∑f : F, wt (lift f))=∑f∈F, M (f u) (f v) := by
    simp only [wt,lift]
    exact F.sum_coe_sort (fun f => M (f u) (f v))
  rwa [he] at hh

lemma pair_bound (hH : H.IsTree) (r v : V) (hv : v≠r) (x : W)
    (D C L : ℝ) (hD : 0 < D) (hC : 0 ≤ C)
    (hdeg : ∀z, (G.degree z:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*D^2)
    (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x)
    (hbad : ∀f∈F, L*D ≤ ((G.adjMatrix ℝ)^3) (f r) (f v)) :
    L*F.card ≤ C*D^(Fintype.card V-1) := by
  classical
  have hA : ∀a b, 0 ≤ G.adjMatrix ℝ a b := by
    intro a b
    dsimp [SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hw := copy_weight_le H G r x r v ((G.adjMatrix ℝ)^3)
    (Matrix.pow_apply_nonneg hA 3) F hfix
  have ht := weighted_tree_bound H hH G r x D (C*D^2) hD.le (by positivity) hdeg hfour
    3 r v (by omega) (fun he => (hv he.symm).elim) (by intro _; omega)
  have hn : 2 ≤ Fintype.card V := by
    have h := card_le_univ ({v,r} : Finset V)
    simpa only [card_pair hv] using h
  have hsum : (L*D)*F.card ≤ ∑f∈F, ((G.adjMatrix ℝ)^3) (f r) (f v) := by
    calc
      _ = ∑_f∈F, L*D := by simp only [sum_const,nsmul_eq_mul]; ring
      _ ≤ _ := sum_le_sum (fun f hf => hbad f hf)
  have hbound := hsum.trans (hw.trans ht)
  have he : (C*D^2)*D^(Fintype.card V+3-5)=
      (C*D^(Fintype.card V-1))*D := by
    rw [mul_assoc,←pow_add,mul_assoc,←pow_succ]
    congr 2
    omega
  rw [he] at hbound
  exact (mul_le_mul_iff_left₀ hD).mp (by simpa only [mul_assoc,mul_comm D,mul_left_comm D] using hbound)

def Light (r : V) (L D : ℝ) (f : H.Copy G) : Prop :=
  ∀v, v≠r → ((G.adjMatrix ℝ)^3) (f r) (f v)<L*D

lemma bad_bound (hH : H.IsTree) (r : V) (x : W)
    (D C L : ℝ) (hD : 0 < D) (hC : 0 ≤ C) (hL : 0 ≤ L)
    (hdeg : ∀z, (G.degree z:ℝ) ≤ D)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*D^2)
    (F : Finset (H.Copy G)) (hfix : ∀f∈F, f r=x)
    (hbad : ∀f∈F, ¬Light H G r L D f) :
    L*F.card ≤ (Fintype.card V:ℝ)*C*D^(Fintype.card V-1) := by
  classical
  let B : V → Finset (H.Copy G) := fun v => F.filter
    (fun f => v≠r ∧ L*D ≤ ((G.adjMatrix ℝ)^3) (f r) (f v))
  have hsub : F ⊆ univ.biUnion B := by
    intro f hf
    have hh := hbad f hf
    simp only [Light,not_forall,_root_.not_imp,not_lt] at hh
    obtain ⟨v,hv,hb⟩ := hh
    exact mem_biUnion.mpr ⟨v,mem_univ _,mem_filter.mpr ⟨hf,hv,hb⟩⟩
  have hb (v : V) : L*(B v).card ≤ C*D^(Fintype.card V-1) := by
    by_cases hv : v=r
    · have he : B v=∅ := by simp [B,hv]
      rw [he,card_empty,Nat.cast_zero,mul_zero]
      positivity
    · exact pair_bound H G hH r v hv x D C L hD hC hdeg hfour (B v)
        (fun f hf => hfix f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2.2)
  have hc : (F.card:ℝ) ≤ ∑v, ((B v).card:ℝ) := by
    exact_mod_cast ((card_le_card hsub).trans card_biUnion_le)
  calc
    _ ≤ L*∑v, ((B v).card:ℝ) := mul_le_mul_of_nonneg_left hc hL
    _ = ∑v, L*(B v).card := mul_sum _ _ _
    _ ≤ ∑_v : V, C*D^(Fintype.card V-1) := sum_le_sum (fun v _ => hb v)
    _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul]; ring

end Erdos571.PinnedThirdLight


/-! Pinned extensions which also retain third-walk control from their anchor. -/
set_option maxHeartbeats 2600000
namespace Erdos571.PinnedExternalLight
open Finset SimpleGraph
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev SafeExtension (r : V) (x : W) (Z : Finset W) (L : ℕ) (D : ℝ) :=
  {f : H.Copy G // f r=x ∧ (∀v, f v∉Z) ∧ GloballyLightCopies.Light H G L f ∧
    Light H G Z L f ∧ PinnedThirdLight.Light H G r L D f}

/-- Explicit external short-walk bounds allow uniformly many extensions,
with avoidance, full pairwise lightness, and anchor third-walk lightness. -/
theorem safe_abundance (hH : H.IsTree) (hv : 3 ≤ Fintype.card V)
    (r : V) (x : W) (Z : Finset W) (hx : x∉Z)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q)
    (hd : 4*((Fintype.card V:ℝ)+Z.card+1) ≤ d)
    (hmin : ∀y, d ≤ (G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ) ≤ Q*d)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*(Q*d)^2)
    (htwo : ∀y∈Z, ((G.adjMatrix ℝ)^2) x y ≤ C)
    (hthree : ∀y∈Z, ((G.adjMatrix ℝ)^3) x y ≤ C*(Q*d))
    (L : ℕ) (hL : 1 ≤ L)
    (hcut : 2*((Fintype.card V:ℝ)^2+Z.card*Fintype.card V)*C*
      (4*Q)^(Fintype.card V-1) ≤ L)
    (hcut3 : 4*(Fintype.card V:ℝ)*C*(4*Q)^(Fintype.card V-1) ≤ L) :
    (d/4)^(Fintype.card V-1)/4 ≤ Nat.card (SafeExtension H G r x Z L (Q*d)) := by
  classical
  have hn : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hz : (0:ℝ) ≤ Z.card := Nat.cast_nonneg _
  have hd0 : 0 < d := by linarith
  have hQ0 : 0 < Q := by linarith
  have hD : 0 < Q*d := mul_pos hQ0 hd0
  have hLp : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  let A := (univ : Finset (H.Copy G)).filter (fun f => f r=x ∧ (∀v, f v∉Z) ∧
    GloballyLightCopies.Light H G L f ∧ Light H G Z L f)
  let B := A.filter (fun f => ¬PinnedThirdLight.Light H G r L (Q*d) f)
  let F := A.filter (PinnedThirdLight.Light H G r L (Q*d))
  have hAc : Nat.card (Extension H G r x Z L)=A.card := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
  have hall := abundance H G hH hv r x Z hx htri C Q d hC hQ hd hmin hmax hfour htwo hthree L hL hcut
  rw [hAc] at hall
  have hb := PinnedThirdLight.bad_bound H G hH r x (Q*d) C L hD hC (Nat.cast_nonneg _)
    hmax hfour B (fun f hf => (mem_filter.mp (mem_filter.mp hf).1).2.1)
    (fun f hf => (mem_filter.mp hf).2)
  have hpow : (4*Q)^(Fintype.card V-1)*(d/4)^(Fintype.card V-1)=(Q*d)^(Fintype.card V-1) := by
    rw [←mul_pow]
    congr 1
    ring
  have hsmall : 4*(B.card:ℝ) ≤ (d/4)^(Fintype.card V-1) := by
    have hh : (4*(B.card:ℝ))*(L:ℝ) ≤ ((d/4)^(Fintype.card V-1))*(L:ℝ) := by
      calc
        _ = 4*((L:ℝ)*B.card) := by ring
        _ ≤ 4*((Fintype.card V:ℝ)*C*(Q*d)^(Fintype.card V-1)) :=
          mul_le_mul_of_nonneg_left hb (by norm_num)
        _ = (4*(Fintype.card V:ℝ)*C*(4*Q)^(Fintype.card V-1))*
            (d/4)^(Fintype.card V-1) := by rw [←hpow]; ring
        _ ≤ (L:ℝ)*(d/4)^(Fintype.card V-1) :=
          mul_le_mul_of_nonneg_right hcut3 (by positivity)
        _ = _ := by ring
    exact (mul_le_mul_iff_left₀ hLp).mp (by simpa only [mul_comm (L:ℝ)] using hh)
  have hsplit : F.card+B.card=A.card := card_filter_add_card_filter_not (s := A)
    (PinnedThirdLight.Light H G r L (Q*d))
  have hsplit' : (F.card:ℝ)+(B.card:ℝ)=A.card := by exact_mod_cast hsplit
  have hF : Nat.card (SafeExtension H G r x Z L (Q*d))=F.card := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
    congr 1
    ext f
    simp only [F,A,mem_filter,mem_univ,true_and,and_assoc]
  rw [hF]
  linarith

end Erdos571.PinnedExternalLight


/-! Uniform extension away from a fixed light copy, meeting it only at a
prescribed anchor. The new copy remains light to every old image. -/
set_option maxHeartbeats 2600000
namespace Erdos571.PinnedCopyExtension
open Finset SimpleGraph
variable {V₀ V W : Type} [Fintype V₀] [Fintype V] [Fintype W]
  [DecidableEq V₀] [DecidableEq V] [DecidableEq W]
variable (H₀ : SimpleGraph V₀) (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

noncomputable def externalImage (r₀ : V₀) (f : H₀.Copy G) : Finset W :=
  (univ.erase r₀).image f

lemma externalImage_card (r₀ : V₀) (f : H₀.Copy G) :
    (externalImage H₀ G r₀ f).card=Fintype.card V₀-1 := by
  have hi : Function.Injective (f : V₀ → W) := fun a b h => f.injective h
  rw [externalImage,card_image_of_injective _ hi,card_erase_of_mem (mem_univ r₀),card_univ]

lemma anchor_not_mem (r₀ : V₀) (f : H₀.Copy G) : f r₀∉externalImage H₀ G r₀ f := by
  intro h
  obtain ⟨v,hv,he⟩ := mem_image.mp h
  exact (mem_erase.mp hv).1 (f.injective he)

lemma external_two (r₀ : V₀) (f : H₀.Copy G) (L : ℕ)
    (hl : GloballyLightCopies.Light H₀ G L f) :
    ∀y∈externalImage H₀ G r₀ f, ((G.adjMatrix ℝ)^2) (f r₀) y ≤ L := by
  intro y hy
  obtain ⟨v,hv,rfl⟩ := mem_image.mp hy
  rw [pow_two,LayeredBush.adjacency_square_common_card]
  exact_mod_cast (hl r₀ v (mem_erase.mp hv).1.symm).le

lemma external_three (r₀ : V₀) (f : H₀.Copy G) (L D : ℝ)
    (hl : PinnedThirdLight.Light H₀ G r₀ L D f) :
    ∀y∈externalImage H₀ G r₀ f, ((G.adjMatrix ℝ)^3) (f r₀) y ≤ L*D := by
  intro y hy
  obtain ⟨v,hv,rfl⟩ := mem_image.mp hy
  exact (hl v (mem_erase.mp hv).1).le

/-- The old copy need not be a single vertex: its non-anchor images become
an external blacklist. Its third-walk lightness is a substantive hypothesis. -/
theorem abundance (hH : H.IsTree) (hv : 3 ≤ Fintype.card V)
    (r₀ : V₀) (r : V) (f : H₀.Copy G)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (C Q d : ℝ) (hC : 0 ≤ C) (hQ : 1 ≤ Q)
    (hd : 4*((Fintype.card V:ℝ)+Fintype.card V₀) ≤ d)
    (hmin : ∀y, d ≤ (G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ) ≤ Q*d)
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*(Q*d)^2)
    (L₀ L : ℕ) (hL₀ : (L₀:ℝ) ≤ C) (hL : 1 ≤ L)
    (hl₂ : GloballyLightCopies.Light H₀ G L₀ f)
    (hl₃ : PinnedThirdLight.Light H₀ G r₀ L₀ (Q*d) f)
    (hcut : 2*((Fintype.card V:ℝ)^2+(Fintype.card V₀-1:ℕ)*Fintype.card V)*C*
      (4*Q)^(Fintype.card V-1) ≤ L)
    (hcut3 : 4*(Fintype.card V:ℝ)*C*(4*Q)^(Fintype.card V-1) ≤ L) :
    (d/4)^(Fintype.card V-1)/4 ≤
      Nat.card (PinnedExternalLight.SafeExtension H G r (f r₀) (externalImage H₀ G r₀ f) L (Q*d)) := by
  have hn₀ : 1 ≤ Fintype.card V₀ := Fintype.card_pos_iff.mpr ⟨r₀⟩
  have hn₀R : (1:ℝ) ≤ Fintype.card V₀ := by exact_mod_cast hn₀
  have hnR : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hd0 : 0 ≤ d := by linarith
  have hD : 0 ≤ Q*d := mul_nonneg (by linarith) hd0
  apply PinnedExternalLight.safe_abundance H G hH hv r (f r₀) (externalImage H₀ G r₀ f)
    (anchor_not_mem H₀ G r₀ f) htri C Q d hC hQ
  · rw [externalImage_card,Nat.cast_sub hn₀,Nat.cast_one]
    linarith
  · exact hmin
  · exact hmax
  · exact hfour
  · intro y hy
    exact (external_two H₀ G r₀ f L₀ hl₂ y hy).trans hL₀
  · intro y hy
    exact (external_three H₀ G r₀ f L₀ (Q*d) hl₃ y hy).trans (mul_le_mul_of_nonneg_right hL₀ hD)
  · exact hL
  · simpa only [externalImage_card] using hcut
  · exact hcut3

end Erdos571.PinnedCopyExtension


/-! Actual ThreeHub freeness supplies the fourth-walk input for uniform
extensions from any fixed copy with the required short-walk lightness. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHub
open Finset SimpleGraph
variable {V₀ V W : Type} [Fintype V₀] [Fintype V] [Fintype W]
  [DecidableEq V₀] [DecidableEq V] [DecidableEq W]
variable (H₀ : SimpleGraph V₀) (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

 theorem safe_copy_extension (s M : ℕ) (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (hH : H.IsTree) (hv : 3 ≤ Fintype.card V) (r₀ : V₀) (r : V) (f : H₀.Copy G)
    (Q d : ℝ) (hQ : 1 ≤ Q)
    (hd : 4*((Fintype.card V:ℝ)+Fintype.card V₀) ≤ d)
    (hmin : ∀y, d ≤ (G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ) ≤ Q*d)
    (L₀ L : ℕ) (hL : 1 ≤ L)
    (hl₂ : GloballyLightCopies.Light H₀ G L₀ f)
    (hl₃ : PinnedThirdLight.Light H₀ G r₀ L₀ (Q*d) f)
    (hcut : 2*((Fintype.card V:ℝ)^2+(Fintype.card V₀-1:ℕ)*Fintype.card V)*
      (momentCoefficient s M+L₀)*(4*Q)^(Fintype.card V-1) ≤ L)
    (hcut3 : 4*(Fintype.card V:ℝ)*(momentCoefficient s M+L₀)*
      (4*Q)^(Fintype.card V-1) ≤ L) :
    (d/4)^(Fintype.card V-1)/4 ≤ Nat.card
      (PinnedExternalLight.SafeExtension H G r (f r₀)
        (PinnedCopyExtension.externalImage H₀ G r₀ f) L (Q*d)) := by
  have hn₀ : (0:ℝ) ≤ Fintype.card V₀ := Nat.cast_nonneg _
  have hn : (0:ℝ) ≤ Fintype.card V := Nat.cast_nonneg _
  have hd0 : 0 ≤ d := by linarith
  have hD : 0 ≤ Q*d := mul_nonneg (by linarith) hd0
  have hC : 0 ≤ momentCoefficient s M := momentCoefficient_nonneg s M
  apply PinnedCopyExtension.abundance H₀ H G hH hv r₀ r f
    (LocalFourthWalk.triangle_free_of_bipartite G hb) (momentCoefficient s M+L₀) Q d
    (add_nonneg hC (Nat.cast_nonneg _)) hQ hd hmin hmax
  · intro a b
    have hh := free_fourWalk_bound s M G hf (Q*d) hD hmax a b
    have hh' : ((G.adjMatrix ℝ)^4) a b ≤ momentCoefficient s M*(Q*d)^2 := by
      simpa only [show (4:ℕ)=2+2 from rfl,pow_add,pow_two] using hh
    exact hh'.trans (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right (Nat.cast_nonneg L₀)) (sq_nonneg _))
  · linarith
  · exact hL
  · exact hl₂
  · exact hl₃
  · exact hcut
  · exact hcut3

end Erdos571.ThreeHub

/-! A local greedy step preserving both second- and third-walk lightness. -/
set_option maxHeartbeats 2400000
namespace Erdos571.LocalSafeNeighbors
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma sum_second (x y : W) :
    (∑z∈G.neighborFinset x, (Fintype.card (G.commonNeighbors z y):ℝ))=
      ((G.adjMatrix ℝ)^3) x y := by
  rw [show (3:ℕ)=1+2 from rfl,pow_add,pow_one,G.adjMatrix_mul_apply]
  simp only [pow_two,LayeredBush.adjacency_square_common_card]

lemma sum_third (x y : W) :
    (∑z∈G.neighborFinset x, ((G.adjMatrix ℝ)^3) z y)=
      ((G.adjMatrix ℝ)^4) x y := by
  rw [show (4:ℕ)=1+3 from rfl,pow_add,pow_one,G.adjMatrix_mul_apply]

lemma second_bad (x y : W) (L : ℕ) (B : ℝ)
    (hthree : ((G.adjMatrix ℝ)^3) x y ≤ B) :
    (L:ℝ)*((G.neighborFinset x).filter
      (fun z => L ≤ Fintype.card (G.commonNeighbors z y))).card ≤ B := by
  classical
  let F := (G.neighborFinset x).filter (fun z => L ≤ Fintype.card (G.commonNeighbors z y))
  calc
    _ = ∑_z∈F, (L:ℝ) := by simp only [sum_const,nsmul_eq_mul]; ring
    _ ≤ ∑z∈F, (Fintype.card (G.commonNeighbors z y):ℝ) :=
      sum_le_sum (fun z hz => by exact_mod_cast (mem_filter.mp hz).2)
    _ ≤ ∑z∈G.neighborFinset x, (Fintype.card (G.commonNeighbors z y):ℝ) :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun z _ _ => Nat.cast_nonneg _)
    _ ≤ B := (sum_second G x y).le.trans hthree

lemma third_bad (x y : W) (L D C : ℝ) (hD : 0 < D)
    (hfour : ((G.adjMatrix ℝ)^4) x y ≤ C*D^2) :
    L*((G.neighborFinset x).filter (fun z => L*D ≤ ((G.adjMatrix ℝ)^3) z y)).card ≤ C*D := by
  classical
  let F := (G.neighborFinset x).filter (fun z => L*D ≤ ((G.adjMatrix ℝ)^3) z y)
  have hA : ∀u v, 0 ≤ G.adjMatrix ℝ u v := by
    intro u v
    dsimp [SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hs : (L*D)*F.card ≤ C*D^2 := by
    calc
      _ = ∑_z∈F, L*D := by simp only [sum_const,nsmul_eq_mul]; ring
      _ ≤ ∑z∈F, ((G.adjMatrix ℝ)^3) z y := sum_le_sum (fun z hz => (mem_filter.mp hz).2)
      _ ≤ ∑z∈G.neighborFinset x, ((G.adjMatrix ℝ)^3) z y :=
        sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
          (fun z _ _ => Matrix.pow_apply_nonneg hA 3 z y)
      _ ≤ C*D^2 := (sum_third G x y).le.trans hfour
  have hh : (L*(F.card:ℝ))*D ≤ (C*D)*D := by nlinarith [hs]
  exact (mul_le_mul_iff_left₀ hD).mp (by simpa only [mul_comm D] using hh)

noncomputable def available (x : W) (Z : Finset W) (L : ℕ) (D : ℝ) : Finset W := by
  classical
  exact ((G.neighborFinset x)\Z).filter (fun z => ∀y∈Z,
    Fintype.card (G.commonNeighbors z y)<L ∧ ((G.adjMatrix ℝ)^3) z y<L*D)

/-- Local availability costs only the old images and the two short-walk
exception sets. No global host codegree cap is assumed. -/
theorem count (x : W) (Z : Finset W) (L : ℕ) (D B C : ℝ) (hD : 0 < D)
    (hthree : ∀y∈Z, ((G.adjMatrix ℝ)^3) x y ≤ B*D)
    (hfour : ∀y∈Z, ((G.adjMatrix ℝ)^4) x y ≤ C*D^2) :
    (L:ℝ)*(G.degree x:ℝ) ≤ (L:ℝ)*Z.card +
      (L:ℝ)*(available G x Z L D).card+(Z.card:ℝ)*(B+C)*D := by
  classical
  let F₂ (y : Z) := (G.neighborFinset x).filter
    (fun z => L ≤ Fintype.card (G.commonNeighbors z y.val))
  let F₃ (y : Z) := (G.neighborFinset x).filter
    (fun z => (L:ℝ)*D ≤ ((G.adjMatrix ℝ)^3) z y.val)
  let S₂ := univ.biUnion F₂
  let S₃ := univ.biUnion F₃
  have hsub : G.neighborFinset x ⊆ Z∪available G x Z L D∪S₂∪S₃ := by
    intro z hz
    by_cases hzZ : z∈Z
    · exact mem_union_left _ (mem_union_left _ (mem_union_left _ hzZ))
    by_cases ha : z∈available G x Z L D
    · exact mem_union_left _ (mem_union_left _ (mem_union_right _ ha))
    have hb : ∃y∈Z, L ≤ Fintype.card (G.commonNeighbors z y) ∨
        (L:ℝ)*D ≤ ((G.adjMatrix ℝ)^3) z y := by
      simp only [available,mem_filter,Finset.mem_sdiff,hz,hzZ,not_false_eq_true,true_and,not_forall,
        _root_.not_imp,not_and_or,not_lt] at ha
      obtain ⟨y,hy,hb⟩ := ha
      exact ⟨y,hy,hb⟩
    obtain ⟨y,hy,hb⟩ := hb
    rcases hb with h|h
    · exact mem_union_left _ (mem_union_right _ (mem_biUnion.mpr
        ⟨⟨y,hy⟩,mem_univ _,mem_filter.mpr ⟨hz,h⟩⟩))
    · exact mem_union_right _ (mem_biUnion.mpr ⟨⟨y,hy⟩,mem_univ _,mem_filter.mpr ⟨hz,h⟩⟩)
  have hs₂ : (L:ℝ)*S₂.card ≤ (Z.card:ℝ)*(B*D) := by
    have hc : (S₂.card:ℝ) ≤ ∑y : Z, ((F₂ y).card:ℝ) := by exact_mod_cast (card_biUnion_le (s := univ) (t := F₂))
    calc
      _ ≤ (L:ℝ)*∑y : Z, ((F₂ y).card:ℝ) := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg _)
      _ = ∑y : Z, (L:ℝ)*(F₂ y).card := mul_sum _ _ _
      _ ≤ ∑_y : Z, B*D := sum_le_sum (fun y _ => second_bad G x y.val L (B*D) (hthree _ y.property))
      _ = _ := by simp
  have hs₃ : (L:ℝ)*S₃.card ≤ (Z.card:ℝ)*(C*D) := by
    have hc : (S₃.card:ℝ) ≤ ∑y : Z, ((F₃ y).card:ℝ) := by exact_mod_cast (card_biUnion_le (s := univ) (t := F₃))
    calc
      _ ≤ (L:ℝ)*∑y : Z, ((F₃ y).card:ℝ) := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg _)
      _ = ∑y : Z, (L:ℝ)*(F₃ y).card := mul_sum _ _ _
      _ ≤ ∑_y : Z, C*D := sum_le_sum (fun y _ => third_bad G x y.val L D C hD (hfour _ y.property))
      _ = _ := by simp
  have hc : (G.degree x:ℝ) ≤ (Z.card:ℝ)+(available G x Z L D).card+S₂.card+S₃.card := by
    have hh := (card_le_card hsub).trans (card_union_le _ _)
    have hh₂ := card_union_le (Z∪available G x Z L D) S₂
    have hh₃ := card_union_le Z (available G x Z L D)
    rw [card_neighborFinset_eq_degree] at hh
    exact_mod_cast (show G.degree x ≤ Z.card+(available G x Z L D).card+S₂.card+S₃.card by omega)
  have hh := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg L : (0:ℝ)≤L)
  nlinarith [hs₂,hs₃]

/-- Choosing the new cutoff larger than the old one leaves half of the
minimum-degree scale available at every greedy extension step. -/
theorem half_degree (x : W) (Z : Finset W) (L : ℕ) (Q d B C : ℝ)
    (hQ : 1 ≤ Q) (hd : 0 < d) (hL : 1 ≤ L)
    (hmin : d ≤ (G.degree x:ℝ)) (hZ : 4*(Z.card:ℝ) ≤ d)
    (hcut : 4*(Z.card:ℝ)*(B+C)*Q ≤ L)
    (hthree : ∀y∈Z, ((G.adjMatrix ℝ)^3) x y ≤ B*(Q*d))
    (hfour : ∀y∈Z, ((G.adjMatrix ℝ)^4) x y ≤ C*(Q*d)^2) :
    d/2 ≤ (available G x Z L (Q*d)).card := by
  have hD : 0 < Q*d := mul_pos (by linarith) hd
  have hLp : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  have hc := count G x Z L (Q*d) B C hD hthree hfour
  have hm := mul_le_mul_of_nonneg_left hmin hLp.le
  have hz := mul_le_mul_of_nonneg_left hZ hLp.le
  have ht := mul_le_mul_of_nonneg_right hcut hd.le
  have hh : (L:ℝ)*(d/2) ≤ (L:ℝ)*(available G x Z L (Q*d)).card := by
    nlinarith [hc,hm,hz,ht]
  exact (mul_le_mul_iff_right₀ hLp).mp hh

/-- Pairwise second- and third-walk caps, with diagonal pairs excluded. -/
def Strong (Z : Finset W) (L D : ℝ) : Prop :=
  ∀x∈Z, ∀y∈Z, x≠y →
    ((G.adjMatrix ℝ)^2) x y ≤ L ∧ ((G.adjMatrix ℝ)^3) x y ≤ L*D

lemma strong_insert (x z : W) (Z : Finset W) (L : ℕ) (L₀ D : ℝ)
    (hD : 0 ≤ D) (hL : L₀ ≤ L) (hZ : Strong G Z L₀ D)
    (hz : z∈available G x Z L D) : Strong G (insert z Z) L D := by
  classical
  have hp := (mem_filter.mp hz).2
  have hpair (y : W) (hy : y∈Z) :
      ((G.adjMatrix ℝ)^2) z y ≤ L ∧ ((G.adjMatrix ℝ)^3) z y ≤ L*D := by
    have hh := hp y hy
    constructor
    · rw [pow_two,LayeredBush.adjacency_square_common_card]
      exact_mod_cast hh.1.le
    · exact hh.2.le
  intro u hu v hv huv
  by_cases huz : u=z
  · subst u
    exact hpair v ((mem_insert.mp hv).resolve_left huv.symm)
  by_cases hvz : v=z
  · subst v
    have hh := hpair u ((mem_insert.mp hu).resolve_left huz)
    rw [(G.isSymm_adjMatrix.pow 2).apply z u,(G.isSymm_adjMatrix.pow 3).apply z u]
    exact hh
  · have hh := hZ u ((mem_insert.mp hu).resolve_left huz)
      v ((mem_insert.mp hv).resolve_left hvz) huv
    exact ⟨hh.1.trans hL,hh.2.trans (mul_le_mul_of_nonneg_right hL hD)⟩



lemma cube_diag_zero
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c) (x : W) :
    ((G.adjMatrix ℝ)^3) x x=0 := by
  rw [←sum_second]
  apply sum_eq_zero
  intro y hy
  have hxy := (G.mem_neighborFinset x y).mp hy
  have hi : IsEmpty (G.commonNeighbors y x) := ⟨by
    rintro ⟨z,hz⟩
    exact htri x y z hxy hz.1 hz.2⟩
  letI := hi
  rw [Fintype.card_eq_zero,Nat.cast_zero]

lemma strong_singleton (x : W) (L D : ℝ) : Strong G {x} L D := by
  intro u hu v hv huv
  exact (huv ((mem_singleton.mp hu).trans (mem_singleton.mp hv).symm)).elim

/-- A pairwise-strong old image set supplies the input for the next local
step; bipartiteness may be used to discharge the displayed triangle condition. -/
theorem half_degree_of_strong (x : W) (Z : Finset W) (hx : x∈Z)
    (L : ℕ) (L₀ Q d C : ℝ) (hL₀ : 0 ≤ L₀)
    (hQ : 1 ≤ Q) (hd : 0 < d) (hL : 1 ≤ L)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : d ≤ (G.degree x:ℝ)) (hZ : 4*(Z.card:ℝ) ≤ d)
    (hcut : 4*(Z.card:ℝ)*(L₀+C)*Q ≤ L)
    (hstrong : Strong G Z L₀ (Q*d))
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b ≤ C*(Q*d)^2) :
    d/2 ≤ (available G x Z L (Q*d)).card := by
  apply half_degree G x Z L Q d L₀ C hQ hd hL hmin hZ hcut
  · intro y hy
    by_cases he : x=y
    · subst y
      rw [cube_diag_zero G htri x]
      exact mul_nonneg hL₀ (mul_nonneg (by linarith) hd.le)
    · exact (hstrong x hx y hy he).2
  · intro y hy
    exact hfour x y

end Erdos571.LocalSafeNeighbors

/-! Growing a connected prescribed subtree by a single safe neighbor. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ConnectedSafeGrowth
open Finset SimpleGraph LocalSafeNeighbors
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W)

lemma unique_attachment (hH : H.IsAcyclic) (C : Finset V)
    (hC : (H.induce (C : Set V)).Connected) (v u : V)
    (hv : v ∉ C) (hu : u ∈ C) (hvu : H.Adj v u) :
    ∀w∈C, H.Adj v w → w=u := by
  intro w hw hvw
  obtain ⟨p,hp⟩ := hC.exists_isPath ⟨u,hu⟩ ⟨w,hw⟩
  let f : H.induce (C : Set V) →g H := ⟨Subtype.val,fun h => h⟩
  let q : H.Path u w := SimpleGraph.Path.map f Subtype.val_injective (⟨p,hp⟩ : (H.induce (C : Set V)).Path ⟨u,hu⟩ ⟨w,hw⟩)
  have hnot : v ∉ q.val.support := by
    change v ∉ (p.map f).support
    rw [SimpleGraph.Walk.support_map]
    intro hh
    obtain ⟨z,hz,he⟩ := List.mem_map.mp hh
    exact hv (he ▸ z.property)
  have he := hH.path_unique (⟨.cons hvu q.val,q.property.cons hnot⟩ : H.Path v w)
    (SimpleGraph.Path.singleton hvw)
  have hs := congrArg (fun r : H.Path v w => r.val.snd) he
  simpa only [SimpleGraph.Walk.snd_cons,SimpleGraph.Path.singleton] using hs.symm

lemma connected_insert (C : Finset V) (hC : (H.induce (C : Set V)).Connected)
    (v u : V) (hu : u∈C) (hvu : H.Adj v u) :
    (H.induce ((insert v C : Finset V) : Set V)).Connected := by
  let f : H.induce (C : Set V) →g H.induce ((insert v C : Finset V) : Set V) :=
    ⟨fun x => ⟨x.val,Finset.mem_insert_of_mem x.property⟩,fun h => h⟩
  let u' : ((insert v C : Finset V) : Set V) := ⟨u,Finset.mem_insert_of_mem hu⟩
  let v' : ((insert v C : Finset V) : Set V) := ⟨v,Finset.mem_insert_self _ _⟩
  have hr (x : ((insert v C : Finset V) : Set V)) : (H.induce ((insert v C : Finset V) : Set V)).Reachable u' x := by
    rcases Finset.mem_insert.mp x.property with hx|hx
    · have he : x=v' := Subtype.ext hx
      rw [he]
      exact (show (H.induce ((insert v C : Finset V) : Set V)).Adj u' v' from hvu.symm).reachable
    · exact (hC.preconnected ⟨u,hu⟩ ⟨x.val,hx⟩).map f
  letI : Nonempty ((insert v C : Finset V) : Set V) := ⟨v'⟩
  exact ⟨fun x y => (hr x).symm.trans (hr y)⟩

noncomputable def image (C : Finset V) (f : (H.induce (C : Set V)).Copy G) : Finset W :=
  univ.image f

lemma image_card (C : Finset V) (f : (H.induce (C : Set V)).Copy G) :
    (image H G C f).card=C.card := by
  classical
  have hi : Function.Injective (f : ↥(C : Set V) → W) := f.injective
  rw [image,Finset.card_image_of_injective _ hi,Finset.card_univ]
  simp

lemma mem_image (C : Finset V) (f : (H.induce (C : Set V)).Copy G)
    (u : V) (hu : u∈C) : f ⟨u,hu⟩∈image H G C f :=
  Finset.mem_image.mpr ⟨⟨u,hu⟩,Finset.mem_univ _,rfl⟩

noncomputable def extend (C : Finset V) (v u : V) (hv : v∉C) (hu : u∈C)
    (hunique : ∀w∈C, H.Adj v w → w=u)
    (f : (H.induce (C : Set V)).Copy G) (y : W)
    (hy : G.Adj (f ⟨u,hu⟩) y) (hynew : y∉image H G C f) :
    (H.induce ((insert v C : Finset V) : Set V)).Copy G where
  toHom :=
    { toFun := fun a => if ha : a.val=v then y else f ⟨a.val,(Finset.mem_insert.mp a.property).resolve_left ha⟩
      map_rel' := by
        intro a b hab
        change H.Adj a.val b.val at hab
        by_cases ha : a.val=v
        · have hb : b.val≠v := by intro hb; rw [ha,hb] at hab; exact H.loopless v hab
          have hbC := (Finset.mem_insert.mp b.property).resolve_left hb
          have he : b.val=u := hunique b.val hbC (by simpa only [ha] using hab)
          have he' : (⟨b.val,hbC⟩ : (C : Set V))=⟨u,hu⟩ := Subtype.ext he
          simpa only [dif_pos ha,dif_neg hb,he'] using hy.symm
        · by_cases hb : b.val=v
          · have haC := (Finset.mem_insert.mp a.property).resolve_left ha
            have he : a.val=u := hunique a.val haC (by simpa only [hb] using hab.symm)
            have he' : (⟨a.val,haC⟩ : (C : Set V))=⟨u,hu⟩ := Subtype.ext he
            simpa only [dif_neg ha,dif_pos hb,he'] using hy
          · simpa only [dif_neg ha,dif_neg hb] using
              f.toHom.map_adj (v := ⟨a.val,(Finset.mem_insert.mp a.property).resolve_left ha⟩)
                (w := ⟨b.val,(Finset.mem_insert.mp b.property).resolve_left hb⟩) hab }
  injective' := by
    intro a b he
    change (if ha : a.val=v then y else f ⟨a.val,_⟩)=
      (if hb : b.val=v then y else f ⟨b.val,_⟩) at he
    by_cases ha : a.val=v
    · by_cases hb : b.val=v
      · exact Subtype.ext (ha.trans hb.symm)
      · rw [dif_pos ha,dif_neg hb] at he
        exact (hynew (he.symm ▸ mem_image H G C f b.val _)).elim
    · by_cases hb : b.val=v
      · rw [dif_neg ha,dif_pos hb] at he
        exact (hynew (he ▸ mem_image H G C f a.val _)).elim
      · rw [dif_neg ha,dif_neg hb] at he
        have hh : (⟨a.val,(Finset.mem_insert.mp a.property).resolve_left ha⟩ : (C : Set V))=
            ⟨b.val,(Finset.mem_insert.mp b.property).resolve_left hb⟩ := f.injective he
        exact Subtype.ext (congrArg (fun x : ↥(C : Set V) => x.val) hh)

@[simp] lemma extend_new (C : Finset V) (v u : V) (hv : v∉C) (hu : u∈C)
    (hunique) (f : (H.induce (C : Set V)).Copy G) (y : W) (hy) (hynew) :
    extend H G C v u hv hu hunique f y hy hynew ⟨v,Finset.mem_insert_self _ _⟩=y := by
  simp [extend]

@[simp] lemma extend_old (C : Finset V) (v u : V) (hv : v∉C) (hu : u∈C)
    (hunique) (f : (H.induce (C : Set V)).Copy G) (y : W) (hy) (hynew)
    (a : (C : Set V)) :
    extend H G C v u hv hu hunique f y hy hynew
      ⟨a.val,Finset.mem_insert_of_mem a.property⟩=f a := by
  have ha : a.val≠v := fun he => hv (he ▸ a.property)
  change (if h : a.val=v then y else f ⟨a.val,_⟩)=f a
  rw [dif_neg ha]

lemma image_extend (C : Finset V) (v u : V) (hv : v∉C) (hu : u∈C)
    (hunique) (f : (H.induce (C : Set V)).Copy G) (y : W) (hy) (hynew) :
    image H G (insert v C) (extend H G C v u hv hu hunique f y hy hynew)=
      insert y (image H G C f) := by
  classical
  ext z
  constructor
  · intro hz
    obtain ⟨a,_,rfl⟩ := Finset.mem_image.mp hz
    rcases Finset.mem_insert.mp a.property with ha|ha
    · have he : a=⟨v,Finset.mem_insert_self _ _⟩ := Subtype.ext ha
      rw [he,extend_new]
      exact Finset.mem_insert_self _ _
    · have he : a=⟨a.val,Finset.mem_insert_of_mem ha⟩ := rfl
      rw [he,extend_old H G C v u hv hu hunique f y hy hynew ⟨a.val,ha⟩]
      exact Finset.mem_insert_of_mem (mem_image H G C f a.val ha)
  · intro hz
    rcases Finset.mem_insert.mp hz with rfl|hz
    · exact Finset.mem_image.mpr ⟨⟨v,Finset.mem_insert_self _ _⟩,Finset.mem_univ _,extend_new ..⟩
    · obtain ⟨a,_,rfl⟩ := Finset.mem_image.mp hz
      exact Finset.mem_image.mpr ⟨⟨a.val,Finset.mem_insert_of_mem a.property⟩,Finset.mem_univ _,extend_old ..⟩

end Erdos571.ConnectedSafeGrowth

/-! Many safe tree extensions of an arbitrary prescribed connected subtree. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ConnectedSafeExtension
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeGrowth
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

noncomputable def wholeImage (g : H.Copy G) : Finset W := univ.image g

abbrev Family (C : Finset V) (f : (H.induce (C : Set V)).Copy G) (L D : ℝ) :=
  {g : H.Copy G // (∀a : (C : Set V), g a.val=f a) ∧ Strong G (wholeImage H G g) L D}

noncomputable instance familyFintype (C : Finset V)
    (f : (H.induce (C : Set V)).Copy G) (L D : ℝ) : Fintype (Family H G C f L D) :=
  by classical exact Fintype.ofFinite _

noncomputable def fullCopy (f : (H.induce (univ : Finset V)).Copy G) : H.Copy G where
  toHom := ⟨fun v => f ⟨v,Finset.mem_univ _⟩,fun h => f.toHom.map_adj h⟩
  injective' := fun u v h => congrArg Subtype.val (f.injective h)

lemma wholeImage_fullCopy (f : (H.induce (univ : Finset V)).Copy G) :
    wholeImage H G (fullCopy H G f)=ConnectedSafeGrowth.image H G univ f := by
  classical
  ext y
  constructor
  · intro hy
    obtain ⟨v,_,rfl⟩ := Finset.mem_image.mp hy
    exact Finset.mem_image.mpr ⟨⟨v,Finset.mem_univ _⟩,Finset.mem_univ _,rfl⟩
  · intro hy
    obtain ⟨v,_,rfl⟩ := Finset.mem_image.mp hy
    exact Finset.mem_image.mpr ⟨v.val,Finset.mem_univ _,rfl⟩

/-- A cutoff schedule allows one to maintain both walk caps at every
extension step. Only connected prescribed vertex sets are admitted. -/
theorem abundance (hH : H.IsTree)
    (Q d C₀ : ℝ) (hQ : 1≤Q) (hd : 0<d) (hC₀ : 0≤C₀)
    (hsize : 4*(Fintype.card V:ℝ)≤d)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : ∀x, d≤(G.degree x:ℝ))
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y≤C₀*(Q*d)^2)
    (L : ℕ→ℕ) (hLpos : ∀i, 1≤L i) (hLstep : ∀i, L i≤L (i+1))
    (hcut : ∀i<Fintype.card V,
      4*(Fintype.card V:ℝ)*((L i:ℝ)+C₀)*Q≤L (i+1))
    (C : Finset V) (hC : (H.induce (C : Set V)).Connected)
    (f : (H.induce (C : Set V)).Copy G)
    (hstrong : Strong G (ConnectedSafeGrowth.image H G C f) (L C.card) (Q*d)) :
    (d/2)^(Fintype.card V-C.card)≤
      (Nat.card (Family H G C f (L (Fintype.card V)) (Q*d)):ℝ) := by
  classical
  generalize hn : Fintype.card V-C.card=n
  induction n using Nat.strong_induction_on generalizing C f with
  | h n ih =>
    by_cases hfull : C=univ
    · subst C
      have hn0 : n=0 := by simpa only [Finset.card_univ,Nat.sub_self] using hn.symm
      rw [hn0,pow_zero]
      let g := fullCopy H G f
      have hg : Strong G (wholeImage H G g) (L (Fintype.card V)) (Q*d) := by
        simpa only [g,wholeImage_fullCopy,Finset.card_univ] using hstrong
      let e : Unit → Family H G univ f (L (Fintype.card V)) (Q*d) :=
        fun _ => ⟨g,by intro a; rfl,hg⟩
      have hi : Function.Injective e := fun _ _ _ => Subsingleton.elim _ _
      have hc := Nat.card_le_card_of_injective e hi
      simpa only [Nat.card_unique,Nat.cast_one] using (Nat.cast_le (α := ℝ)).mpr hc
    · have hCne : C.Nonempty := by
        obtain ⟨x⟩ := hC.nonempty
        exact ⟨x.val,x.property⟩
      obtain ⟨u,hu,v,hv,huv⟩ := ConnectedCopyBound.boundary H hH.isConnected C hCne hfull
      have hunique := unique_attachment H hH.IsAcyclic C hC v u hv hu huv.symm
      let C' := insert v C
      have hC' : (H.induce (C' : Set V)).Connected := connected_insert H C hC v u hu huv.symm
      have hc' : C'.card=C.card+1 := Finset.card_insert_of_notMem hv
      have hCcard : C.card<Fintype.card V := by
        have hh := Finset.card_le_univ C'
        omega
      have hlt : Fintype.card V-C'.card<n := by omega
      have hn' : n=(Fintype.card V-C'.card)+1 := by omega
      let Z := ConnectedSafeGrowth.image H G C f
      let x := f ⟨u,hu⟩
      let Y := available G x Z (L C'.card) (Q*d)
      have hZcard : Z.card=C.card := image_card H G C f
      have hZsize : 4*(Z.card:ℝ)≤d := by
        have hc : (Z.card:ℝ)≤Fintype.card V := by exact_mod_cast (hZcard ▸ Finset.card_le_univ C)
        linarith
      have hcut' : 4*(Z.card:ℝ)*((L C.card:ℝ)+C₀)*Q≤L C'.card := by
        have hm : (Z.card:ℝ)≤Fintype.card V := by exact_mod_cast (hZcard ▸ Finset.card_le_univ C)
        have hnn : 0≤(L C.card:ℝ)+C₀ := add_nonneg (Nat.cast_nonneg _) hC₀
        calc
          _ ≤ 4*(Fintype.card V:ℝ)*((L C.card:ℝ)+C₀)*Q := by gcongr
          _ ≤ _ := by rw [hc']; exact hcut C.card hCcard
      have hY : d/2≤(Y.card:ℝ) := half_degree_of_strong G x Z
        (ConnectedSafeGrowth.mem_image H G C f u hu) (L C'.card) (L C.card) Q d C₀
        (Nat.cast_nonneg _) hQ hd (hLpos _) htri (hmin _) hZsize hcut' hstrong hfour
      have hyadj (y : Y) : G.Adj x y.val := by
        exact (G.mem_neighborFinset x y.val).mp (Finset.mem_sdiff.mp (Finset.mem_filter.mp y.property).1).1
      have hynew (y : Y) : y.val∉Z := (Finset.mem_sdiff.mp (Finset.mem_filter.mp y.property).1).2
      let f' (y : Y) := ConnectedSafeGrowth.extend H G C v u hv hu hunique f y.val (hyadj y) (hynew y)
      have hfstrong (y : Y) : Strong G (ConnectedSafeGrowth.image H G C' (f' y)) (L C'.card) (Q*d) := by
        rw [image_extend]
        exact strong_insert G x y.val Z (L C'.card) (L C.card) (Q*d)
          (mul_nonneg (by linarith) hd.le) (by rw [hc']; exact_mod_cast hLstep C.card)
          hstrong y.property
      have hind (y : Y) : (d/2)^(Fintype.card V-C'.card)≤
          (Nat.card (Family H G C' (f' y) (L (Fintype.card V)) (Q*d)):ℝ) :=
        ih _ hlt C' hC' (f' y) (hfstrong y) rfl
      let F := (y : Y) × Family H G C' (f' y) (L (Fintype.card V)) (Q*d)
      let φ : F → Family H G C f (L (Fintype.card V)) (Q*d) := fun p =>
        ⟨p.2.val,by
          intro a
          exact (p.2.property.1 ⟨a.val,Finset.mem_insert_of_mem a.property⟩).trans
            (extend_old H G C v u hv hu hunique f p.1.val (hyadj p.1) (hynew p.1) a),p.2.property.2⟩
      have hφ : Function.Injective φ := by
        rintro ⟨y,g⟩ ⟨z,k⟩ he
        have hgk : g.val=k.val := congrArg Subtype.val he
        have hvy : g.val v=y.val := (g.property.1 ⟨v,Finset.mem_insert_self _ _⟩).trans (extend_new ..)
        have hvz : k.val v=z.val := (k.property.1 ⟨v,Finset.mem_insert_self _ _⟩).trans (extend_new ..)
        have hyz : y=z := Subtype.ext (hvy.symm.trans ((congrArg (fun g : H.Copy G => g v) hgk).trans hvz))
        subst z
        exact Sigma.ext rfl (heq_of_eq (Subtype.ext hgk))
      have hcard : (Nat.card F:ℝ)≤Nat.card (Family H G C f (L (Fintype.card V)) (Q*d)) :=
        by exact_mod_cast Nat.card_le_card_of_injective φ hφ
      have hsum : (Y.card:ℝ)*(d/2)^(Fintype.card V-C'.card)≤(Nat.card F:ℝ) := by
        rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
        have hh := Finset.sum_le_sum (fun y (_ : y∈(univ : Finset Y)) => hind y)
        simpa only [Finset.sum_const,Finset.card_univ,Fintype.card_coe,nsmul_eq_mul,
          Nat.card_eq_fintype_card] using hh
      calc
        _ = (d/2)*(d/2)^(Fintype.card V-C'.card) := by rw [hn',pow_succ]; ring
        _ ≤ (Y.card:ℝ)*(d/2)^(Fintype.card V-C'.card) :=
          mul_le_mul_of_nonneg_right hY (pow_nonneg (by linarith) _)
        _ ≤ _ := hsum.trans hcard

end Erdos571.ConnectedSafeExtension

/-! Host-independent cutoff schedules for safe connected-subtree extension. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ConnectedSafeExtension
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeGrowth

noncomputable def cutoff (N : ℕ) (Q C : ℝ) (L₀ : ℕ) : ℕ→ℕ
  | 0 => max L₀ 1
  | i+1 => max (cutoff N Q C L₀ i)
      (max 1 ⌈4*(N:ℝ)*((cutoff N Q C L₀ i:ℝ)+C)*Q⌉₊)

lemma cutoff_step (N : ℕ) (Q C : ℝ) (L₀ i : ℕ) :
    cutoff N Q C L₀ i≤cutoff N Q C L₀ (i+1) := le_max_left _ _

lemma cutoff_mono (N : ℕ) (Q C : ℝ) (L₀ : ℕ) : Monotone (cutoff N Q C L₀) :=
  monotone_nat_of_le_succ (cutoff_step N Q C L₀)

lemma cutoff_pos (N : ℕ) (Q C : ℝ) (L₀ i : ℕ) : 1≤cutoff N Q C L₀ i := by
  cases i with
  | zero => exact le_max_right _ _
  | succ i => exact (le_max_left _ _).trans (le_max_right _ _)

lemma cutoff_ge (N : ℕ) (Q C : ℝ) (L₀ i : ℕ) : L₀≤cutoff N Q C L₀ i :=
  (le_max_left _ _).trans (cutoff_mono N Q C L₀ (Nat.zero_le i))

lemma cutoff_growth (N : ℕ) (Q C : ℝ) (L₀ i : ℕ) :
    4*(N:ℝ)*((cutoff N Q C L₀ i:ℝ)+C)*Q≤cutoff N Q C L₀ (i+1) := by
  have h := Nat.le_ceil (4*(N:ℝ)*((cutoff N Q C L₀ i:ℝ)+C)*Q)
  have ht : ⌈4*(N:ℝ)*((cutoff N Q C L₀ i:ℝ)+C)*Q⌉₊≤cutoff N Q C L₀ (i+1) :=
    (le_max_right _ _).trans (le_max_right _ _)
  exact h.trans ((Nat.cast_le (α := ℝ)).mpr ht)

variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

/-- A completely explicit final cutoff depends on the template size and
walk/degree constants, not on the host order or the partial copy. -/
theorem abundance_at_cutoff (hH : H.IsTree)
    (Q d C₀ : ℝ) (hQ : 1≤Q) (hd : 0<d) (hC₀ : 0≤C₀)
    (hsize : 4*(Fintype.card V:ℝ)≤d)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : ∀x, d≤(G.degree x:ℝ))
    (hfour : ∀x y, ((G.adjMatrix ℝ)^4) x y≤C₀*(Q*d)^2)
    (L₀ : ℕ) (C : Finset V) (hC : (H.induce (C : Set V)).Connected)
    (f : (H.induce (C : Set V)).Copy G)
    (hstrong : Strong G (ConnectedSafeGrowth.image H G C f) L₀ (Q*d)) :
    (d/2)^(Fintype.card V-C.card)≤
      (Nat.card (Family H G C f
        (cutoff (Fintype.card V) Q C₀ L₀ (Fintype.card V)) (Q*d)):ℝ) := by
  apply abundance H G hH Q d C₀ hQ hd hC₀ hsize htri hmin hfour
    (cutoff (Fintype.card V) Q C₀ L₀)
    (cutoff_pos (Fintype.card V) Q C₀ L₀) (cutoff_step (Fintype.card V) Q C₀ L₀) (fun i _ => cutoff_growth ..) C hC f
  intro x hx y hy hxy
  have h := hstrong x hx y hy hxy
  have hL : (L₀:ℝ)≤cutoff (Fintype.card V) Q C₀ L₀ C.card := by exact_mod_cast cutoff_ge (Fintype.card V) Q C₀ L₀ C.card
  exact ⟨h.1.trans hL,h.2.trans (mul_le_mul_of_nonneg_right hL (mul_nonneg (by linarith) hd.le))⟩

end Erdos571.ConnectedSafeExtension

/-! Uniformly many tree copies with all second- and third-walk pairs light. -/
set_option maxHeartbeats 2200000
namespace Erdos571.StrongPinnedCopies
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeExtension
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev Family (L D : ℝ) := {g : H.Copy G // Strong G (wholeImage H G g) L D}
abbrev Pinned (r : V) (x : W) (L D : ℝ) :=
  {g : H.Copy G // g r=x ∧ Strong G (wholeImage H G g) L D}

noncomputable instance familyFintype (L D : ℝ) : Fintype (Family H G L D) := by
  classical exact Fintype.ofFinite _
noncomputable instance pinnedFintype (r : V) (x : W) (L D : ℝ) : Fintype (Pinned H G r x L D) := by
  classical exact Fintype.ofFinite _

noncomputable def singletonCopy (r : V) (x : W) : (H.induce ({r} : Finset V)).Copy G where
  toHom := ⟨fun _ => x,by
    intro a b hab
    change H.Adj a.val b.val at hab
    have ha : a.val=r := Finset.mem_singleton.mp a.property
    have hb : b.val=r := Finset.mem_singleton.mp b.property
    exact (H.loopless r (by simpa only [ha,hb] using hab)).elim⟩
  injective' := fun a b _ => Subtype.ext
    ((Finset.mem_singleton.mp a.property).trans (Finset.mem_singleton.mp b.property).symm)

lemma singleton_image (r : V) (x : W) :
    ConnectedSafeGrowth.image H G {r} (singletonCopy H G r x)={x} := by
  classical
  ext y
  simp only [ConnectedSafeGrowth.image,Finset.mem_image,Finset.mem_univ,true_and,Finset.mem_singleton]
  constructor
  · rintro ⟨a,ha⟩
    exact ha.symm
  · rintro rfl
    exact ⟨⟨r,Finset.mem_singleton_self _⟩,rfl⟩

def singletonEquiv (r : V) (x : W) (L D : ℝ) :
    ConnectedSafeExtension.Family H G {r} (singletonCopy H G r x) L D≃Pinned H G r x L D where
  toFun p := ⟨p.val,p.property.1 ⟨r,Finset.mem_singleton_self _⟩,p.property.2⟩
  invFun p := ⟨p.val,by
    intro a
    have ha : a.val=r := Finset.mem_singleton.mp a.property
    simpa only [ha] using p.property.1,p.property.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- Every prescribed anchor has the full greedy count, with uniform
pairwise short-walk caps throughout each copy. -/
theorem pinned_abundance (hH : H.IsTree) (r : V) (x : W)
    (Q d C₀ : ℝ) (hQ : 1≤Q) (hd : 0<d) (hC₀ : 0≤C₀)
    (hsize : 4*(Fintype.card V:ℝ)≤d)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : ∀y, d≤(G.degree y:ℝ))
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b≤C₀*(Q*d)^2) :
    (d/2)^(Fintype.card V-1)≤(Nat.card (Pinned H G r x
      (cutoff (Fintype.card V) Q C₀ 0 (Fintype.card V)) (Q*d)):ℝ) := by
  classical
  have hi : Strong G (ConnectedSafeGrowth.image H G {r} (singletonCopy H G r x)) 0 (Q*d) := by
    rw [singleton_image]
    exact strong_singleton G x 0 (Q*d)
  letI : Nonempty ↥({r} : Finset V) := ⟨⟨r,Finset.mem_singleton_self _⟩⟩
  letI : Subsingleton ↥({r} : Finset V) := ⟨fun a b => Subtype.ext
    ((Finset.mem_singleton.mp a.property).trans (Finset.mem_singleton.mp b.property).symm)⟩
  have hc : (H.induce ({r} : Finset V)).Connected := SimpleGraph.Connected.of_subsingleton
  have h := abundance_at_cutoff H G hH Q d C₀ hQ hd hC₀ hsize htri hmin hfour 0 {r} hc
    (singletonCopy H G r x) (by simpa only [Nat.cast_zero] using hi)
  rw [Nat.card_congr (singletonEquiv H G r x _ _)] at h
  simpa only [Finset.card_singleton] using h

/-- Summing the anchored lower bound gives a whole-copy abundance theorem. -/
theorem abundance (hH : H.IsTree)
    (Q d C₀ : ℝ) (hQ : 1≤Q) (hd : 0<d) (hC₀ : 0≤C₀)
    (hsize : 4*(Fintype.card V:ℝ)≤d)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : ∀y, d≤(G.degree y:ℝ))
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b≤C₀*(Q*d)^2) :
    (Fintype.card W:ℝ)*(d/2)^(Fintype.card V-1)≤(Nat.card (Family H G
      (cutoff (Fintype.card V) Q C₀ 0 (Fintype.card V)) (Q*d)):ℝ) := by
  classical
  obtain ⟨r⟩ := hH.isConnected.nonempty
  let L := cutoff (Fintype.card V) Q C₀ 0 (Fintype.card V)
  let F := (x : W) × Pinned H G r x L (Q*d)
  let φ : F → Family H G L (Q*d) := fun p => ⟨p.2.val,p.2.property.2⟩
  have hi : Function.Injective φ := by
    rintro ⟨x,f⟩ ⟨y,g⟩ he
    have hfg : f.val=g.val := congrArg Subtype.val he
    have hxy : x=y := f.property.1.symm.trans
      ((congrArg (fun g : H.Copy G => g r) hfg).trans g.property.1)
    subst y
    exact Sigma.ext rfl (heq_of_eq (Subtype.ext hfg))
  have hc : (Nat.card F:ℝ)≤Nat.card (Family H G L (Q*d)) := by
    exact_mod_cast Nat.card_le_card_of_injective φ hi
  have hh : (Fintype.card W:ℝ)*(d/2)^(Fintype.card V-1)≤(Nat.card F:ℝ) := by
    rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
    have hs := Finset.sum_le_sum (fun x (_ : x∈(univ : Finset W)) =>
      pinned_abundance H G hH r x Q d C₀ hQ hd hC₀ hsize htri hmin hfour)
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card] using hs
  exact hh.trans hc

end Erdos571.StrongPinnedCopies

/-! Original ThreeHub freeness supplies safe extension for every finite tree. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHub
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeExtension
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma safe_four_walks (s M : ℕ) (hf : (graph s M).Free G)
    (Q d : ℝ) (hQ : 1≤Q) (hd : 0≤d) (hmax : ∀x, (G.degree x:ℝ)≤Q*d) :
    ∀x y, ((G.adjMatrix ℝ)^4) x y≤ momentCoefficient s M*(Q*d)^2 := by
  intro x y
  have h := free_fourWalk_bound s M G hf (Q*d) (mul_nonneg (by linarith) hd) hmax x y
  simpa only [show (4:ℕ)=2+2 from rfl,pow_add,pow_two] using h

/-- Every pairwise-strong connected partial tree copy has uniformly many
safe completions in an actual ThreeHub-free almost-regular bipartite host. -/
theorem strong_connected_extension (s M : ℕ) (hH : H.IsTree)
    (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1≤Q) (hd : 0<d) (hsize : 4*(Fintype.card V:ℝ)≤d)
    (hmin : ∀x, d≤(G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ)≤Q*d)
    (L₀ : ℕ) (C : Finset V) (hC : (H.induce (C : Set V)).Connected)
    (f : (H.induce (C : Set V)).Copy G)
    (hstrong : Strong G (ConnectedSafeGrowth.image H G C f) L₀ (Q*d)) :
    (d/2)^(Fintype.card V-C.card)≤(Nat.card (ConnectedSafeExtension.Family H G C f
      (cutoff (Fintype.card V) Q (momentCoefficient s M) L₀ (Fintype.card V)) (Q*d)):ℝ) :=
  abundance_at_cutoff H G hH Q d (momentCoefficient s M) hQ hd (momentCoefficient_nonneg s M)
    hsize (LocalFourthWalk.triangle_free_of_bipartite G hb) hmin
    (safe_four_walks G s M hf Q d hQ hd.le hmax) L₀ C hC f hstrong

/-- This strengthens the old anchor-only third-walk cleaning: all pairs
inside each counted copy obey the third-walk cap, as well as the codegree cap. -/
theorem strong_pinned_abundance (s M : ℕ) (hH : H.IsTree) (r : V) (x : W)
    (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1≤Q) (hd : 0<d) (hsize : 4*(Fintype.card V:ℝ)≤d)
    (hmin : ∀y, d≤(G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ)≤Q*d) :
    (d/2)^(Fintype.card V-1)≤(Nat.card (StrongPinnedCopies.Pinned H G r x
      (cutoff (Fintype.card V) Q (momentCoefficient s M) 0 (Fintype.card V)) (Q*d)):ℝ) :=
  StrongPinnedCopies.pinned_abundance H G hH r x Q d (momentCoefficient s M) hQ hd
    (momentCoefficient_nonneg s M) hsize (LocalFourthWalk.triangle_free_of_bipartite G hb)
    hmin (safe_four_walks G s M hf Q d hQ hd.le hmax)

theorem strong_tree_abundance (s M : ℕ) (hH : H.IsTree)
    (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1≤Q) (hd : 0<d) (hsize : 4*(Fintype.card V:ℝ)≤d)
    (hmin : ∀y, d≤(G.degree y:ℝ)) (hmax : ∀y, (G.degree y:ℝ)≤Q*d) :
    (Fintype.card W:ℝ)*(d/2)^(Fintype.card V-1)≤(Nat.card (StrongPinnedCopies.Family H G
      (cutoff (Fintype.card V) Q (momentCoefficient s M) 0 (Fintype.card V)) (Q*d)):ℝ) :=
  StrongPinnedCopies.abundance H G hH Q d (momentCoefficient s M) hQ hd
    (momentCoefficient_nonneg s M) hsize (LocalFourthWalk.triangle_free_of_bipartite G hb)
    hmin (safe_four_walks G s M hf Q d hQ hd.le hmax)

end Erdos571.ThreeHub

/-! Globally light agreement pins retained from pairwise-strong tree copies. -/
set_option maxHeartbeats 2400000
namespace Erdos571.StrongPinnedCopies
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeExtension GloballyLightCopies GloballyLightEnergy
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
variable (H : SimpleGraph V) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma wholeImage_mem (f : H.Copy G) (v : V) : f v∈wholeImage H G f :=
  Finset.mem_image.mpr ⟨v,Finset.mem_univ _,rfl⟩

lemma family_mono (L L' D : ℝ) (hL : L≤L') (hD : 0≤D) :
    Nat.card (Family H G L D)≤Nat.card (Family H G L' D) := by
  classical
  let φ : Family H G L D → Family H G L' D := fun f => ⟨f.val,by
    intro x hx y hy hxy
    have h := f.property x hx y hy hxy
    exact ⟨h.1.trans hL,h.2.trans (mul_le_mul_of_nonneg_right hL hD)⟩⟩
  exact Nat.card_le_card_of_injective φ (by
    intro f g he
    apply Subtype.ext
    exact congrArg (fun x : Family H G L' D => x.val) he)

lemma light (L : ℕ) (D : ℝ) (f : Family H G L D) : Light H G (L+1) f.val := by
  intro u v huv
  have hne : f.val u≠f.val v := fun he => huv (f.val.injective he)
  have h := (f.property (f.val u) (wholeImage_mem H G f.val u)
    (f.val v) (wholeImage_mem H G f.val v) hne).1
  rw [pow_two,LayeredBush.adjacency_square_common_card] at h
  have hn : Fintype.card (G.commonNeighbors (f.val u) (f.val v))≤L := by exact_mod_cast h
  omega

lemma third_from_image (L D : ℝ) (hL : 0≤L) (hD : 0≤D)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (f : Family H G L D) (u v : V) : ((G.adjMatrix ℝ)^3) (f.val u) (f.val v)≤L*D := by
  by_cases he : f.val u=f.val v
  · rw [he,cube_diag_zero G htri]
    exact mul_nonneg hL hD
  · exact (f.property (f.val u) (wholeImage_mem H G f.val u)
      (f.val v) (wholeImage_mem H G f.val v) he).2

/-- Nat.card form avoids dependence on a concrete template's enumeration. -/
theorem abundance_nat (hH : H.IsTree)
    (Q d C₀ : ℝ) (hQ : 1≤Q) (hd : 0<d) (hC₀ : 0≤C₀)
    (hsize : 4*(Nat.card V:ℝ)≤d)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : ∀y, d≤(G.degree y:ℝ))
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b≤C₀*(Q*d)^2) :
    (Nat.card W:ℝ)*(d/2)^(Nat.card V-1)≤(Nat.card (Family H G
      (cutoff (Nat.card V) Q C₀ 0 (Nat.card V)) (Q*d)):ℝ) := by
  simpa only [Nat.card_eq_fintype_card] using abundance H G hH Q d C₀ hQ hd hC₀
    (by simpa only [Nat.card_eq_fintype_card] using hsize) htri hmin hfour

/-- Enumeration-independent form of the strong-copy predicate. -/
abbrev RoleFamily (L D : ℝ) := {f : H.Copy G // ∀u v, u≠v →
  ((G.adjMatrix ℝ)^2) (f u) (f v)≤L ∧ ((G.adjMatrix ℝ)^3) (f u) (f v)≤L*D}

def roleEquiv (L D : ℝ) : Family H G L D≃RoleFamily H G L D where
  toFun f := ⟨f.val,by
    intro u v huv
    exact f.property _ (wholeImage_mem H G f.val u) _ (wholeImage_mem H G f.val v)
      (fun he => huv (f.val.injective he))⟩
  invFun f := ⟨f.val,by
    intro x hx y hy hxy
    obtain ⟨u,_,rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨v,_,rfl⟩ := Finset.mem_image.mp hy
    exact f.property u v (fun he => hxy (congrArg f.val he))⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma role_family_mono (L L' D : ℝ) (hL : L≤L') (hD : 0≤D) :
    Nat.card (RoleFamily H G L D)≤Nat.card (RoleFamily H G L' D) := by
  rw [←Nat.card_congr (roleEquiv H G L D),←Nat.card_congr (roleEquiv H G L' D)]
  exact family_mono H G L L' D hL hD

lemma role_light (L : ℕ) (D : ℝ) (f : RoleFamily H G L D) : Light H G (L+1) f.val :=
  light H G L D ((roleEquiv H G L D).symm f)

lemma role_third_from_image (L D : ℝ) (hL : 0≤L) (hD : 0≤D)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (f : RoleFamily H G L D) (u v : V) : ((G.adjMatrix ℝ)^3) (f.val u) (f.val v)≤L*D :=
  third_from_image H G L D hL hD htri ((roleEquiv H G L D).symm f) u v

theorem role_abundance_nat (hH : H.IsTree)
    (Q d C₀ : ℝ) (hQ : 1≤Q) (hd : 0<d) (hC₀ : 0≤C₀)
    (hsize : 4*(Nat.card V:ℝ)≤d)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (hmin : ∀y, d≤(G.degree y:ℝ))
    (hfour : ∀a b, ((G.adjMatrix ℝ)^4) a b≤C₀*(Q*d)^2) :
    (Nat.card W:ℝ)*(d/2)^(Nat.card V-1)≤(Nat.card (RoleFamily H G
      (cutoff (Nat.card V) Q C₀ 0 (Nat.card V)) (Q*d)):ℝ) := by
  rw [←Nat.card_congr (roleEquiv H G _ _)]
  exact abundance_nat H G hH Q d C₀ hQ hd hC₀ hsize htri hmin hfour

end Erdos571.StrongPinnedCopies

namespace Erdos571.StrongCopyPins
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeExtension GloballyLightCopies GloballyLightEnergy
variable {A R W : Type} [Fintype A] [Fintype R] [Fintype W]
variable [DecidableEq A] [DecidableEq R] [DecidableEq W]
variable (H : SimpleGraph (A⊕R)) (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev Family (L : ℕ) (D : ℝ) (a : A) := PinFamily (HostHeavyShadow.graph G univ (L+1))
  (fun f : StrongPinnedCopies.RoleFamily H G L D => f.val) a

/-- The shared pin has the third-walk cap to every image in the left copy. -/
lemma anchor_third_left (L : ℕ) (D : ℝ) (hD : 0≤D)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (a : A) (p : Family H G L D a) (v : A⊕R) :
    ((G.adjMatrix ℝ)^3) (p.val.1.val (.inl a)) (p.val.1.val v)≤L*D :=
  StrongPinnedCopies.role_third_from_image H G L D (Nat.cast_nonneg _) hD htri p.val.1 (.inl a) v

/-- The pin agreement supplies the same bound to every image in the right
copy. This is not a claim about arbitrary cross-role third-walk pairs. -/
lemma anchor_third_right (L : ℕ) (D : ℝ) (hD : 0≤D)
    (htri : ∀a b c, G.Adj a b → G.Adj b c → ¬G.Adj a c)
    (a : A) (p : Family H G L D a) (v : A⊕R) :
    ((G.adjMatrix ℝ)^3) (p.val.1.val (.inl a)) (p.val.2.val v)≤L*D := by
  rw [p.property.2.1]
  exact StrongPinnedCopies.role_third_from_image H G L D (Nat.cast_nonneg _) hD htri p.val.2 (.inl a) v

lemma cross_two (L : ℕ) (D : ℝ) (a : A) (p : Family H G L D a)
    (u v : A⊕R) (hne : p.val.1.val u≠p.val.2.val v) :
    ((G.adjMatrix ℝ)^2) (p.val.1.val u) (p.val.2.val v)≤L := by
  have hh := p.property.2.2 u v
  have hn : Fintype.card (G.commonNeighbors (p.val.1.val u) (p.val.2.val v))≤L := by
    by_contra! hbad
    apply hh
    refine ⟨hne,?_⟩
    rw [HostHeavyShadow.common_univ_card]
    change L+1≤Fintype.card (G.commonNeighbors (p.val.1.val u) (p.val.2.val v))
    omega
  have he (x y : W) : ((G.adjMatrix ℝ)^2) x y=(Fintype.card (G.commonNeighbors x y):ℝ) := by
    rw [pow_two,LayeredBush.adjacency_square_common_card]
  exact (he _ _).le.trans ((Nat.cast_le (α := ℝ)).mpr hn)

theorem exists_large_pin [Nonempty A] (L k M : ℕ) (D : ℝ) (hM : 2≤M)
    (hK : (completeBipartiteGraph (Fin k) (Fin k)).Free (HostHeavyShadow.graph G univ (L+1)))
    (hf : (FullRootedPower.graph H M).Free G) :
    ∃a : A, (Nat.card (StrongPinnedCopies.RoleFamily H G L D))^2≤
      (M-1)*(Nat.card A)^2*factor k (Nat.card (A⊕R))*(Nat.card W)^(Nat.card R)*
        Nat.card (Family H G L D a) := by
  classical
  exact GloballyLightEnergy.exists_large_pin _ (fun f : StrongPinnedCopies.RoleFamily H G L D => f.val)
    (fun f => allBetween_of_light H G L f.val (StrongPinnedCopies.role_light H G L D f)) k M hM hK hf

end Erdos571.StrongCopyPins

/-! A large globally light pin with additional third-walk control at its anchor. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHub
open Finset SimpleGraph LocalSafeNeighbors ConnectedSafeExtension GloballyLightCopies GloballyLightEnergy
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

abbrev StrongGlobalPin (s L : ℕ) (D : ℝ) (a : RootedSubdivision.Nonroot (base s)) :=
  StrongCopyPins.Family (template s) G L D a

theorem exists_strong_global_pin (s M L : ℕ) (D : ℝ) (hs : 1≤s) (hM : 2≤M)
    (hL : pathwiseCap s M≤L) (hf : (graph s M).Free G) :
    ∃a : RootedSubdivision.Nonroot (base s),
      (Nat.card (StrongPinnedCopies.RoleFamily (template s) G L D))^2≤globalPinCoefficient s M*
        (Nat.card W)^(3*s)*Nat.card (StrongGlobalPin G s L D a) := by
  classical
  let c : (FullRootedPower.graph (base s) (M+1)).Coloring Bool :=
    (base_power_bipartite s (M+1)).toColoring (by simp)
  have hK := HostHeavyShadow.cutoff_bicliqueFree G _ c c.valid L
    (by simpa only [←Nat.card_eq_fintype_card] using hL.trans (Nat.le_succ L))
    (subdivision_free s M G hf)
  have hK' : (completeBipartiteGraph (Fin (Nat.card (Branch s M)))
      (Fin (Nat.card (Branch s M)))).Free (HostHeavyShadow.graph G univ (L+1)) := by
    rw [Nat.card_eq_fintype_card]
    exact hK
  have h := StrongCopyPins.exists_large_pin (template s) G L (Nat.card (Branch s M)) M D hM hK' hf
  simpa only [template_root_card s hs,template_interior_card s hs,
    template_vertex_card s hs,globalPinCoefficient] using h

/-- The pin family here is genuinely smaller than the old globally light
family: both constituent copies are pairwise third-walk-light as well.
Every member therefore has the two anchor-third bounds proved in
StrongCopyPins, without asserting third-lightness for all cross pairs. -/
theorem strong_global_pin_lower (s M L : ℕ) (hs : 1≤s) (hM : 2≤M)
    (hL : pathwiseCap s M≤L) (hf : (graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1≤Q) (hd : 4*(6*(s:ℝ)+5)≤d)
    (hmin : ∀x, d≤(G.degree x:ℝ)) (hmax : ∀x, (G.degree x:ℝ)≤Q*d)
    (hcut : cutoff (6*s+5) Q (momentCoefficient s M) 0 (6*s+5)≤L) :
    ∃a : RootedSubdivision.Nonroot (base s),
      ((Nat.card W:ℝ)*(d/2)^(6*s+4))^2≤(globalPinCoefficient s M:ℝ)*
        (Nat.card W:ℝ)^(3*s)*Nat.card (StrongGlobalPin G s L (Q*d) a) := by
  classical
  have hs0 : (0:ℝ)≤s := Nat.cast_nonneg s
  have hd0 : 0<d := by linarith
  have hD : 0≤Q*d := mul_nonneg (by linarith) hd0.le
  have hsize : 4*(Nat.card (RootedSubdivision.Vertex (base s)):ℝ)≤d := by
    simpa only [template_vertex_card s hs,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat] using hd
  have hcount := StrongPinnedCopies.role_abundance_nat (template s) G (template_isTree s)
    Q d (momentCoefficient s M) hQ hd0 (momentCoefficient_nonneg s M) hsize
    (LocalFourthWalk.triangle_free_of_bipartite G hb) hmin
    (safe_four_walks G s M hf Q d hQ hd0.le hmax)
  have hnum : Nat.card (RootedSubdivision.Vertex (base s))-1=6*s+4 := by
    rw [template_vertex_card s hs]
    omega
  simp only [template_vertex_card s hs,hnum,show 6*s+5-1=6*s+4 by omega] at hcount
  have hmono := StrongPinnedCopies.role_family_mono (template s) G
    (cutoff (6*s+5) Q (momentCoefficient s M) 0 (6*s+5)) L (Q*d)
    (by exact_mod_cast hcut) hD
  have hlow : (Nat.card W:ℝ)*(d/2)^(6*s+4)≤
      Nat.card (StrongPinnedCopies.RoleFamily (template s) G L (Q*d)) :=
    hcount.trans (by exact_mod_cast hmono)
  obtain ⟨a,ha⟩ := exists_strong_global_pin G s M L (Q*d) hs hM hL hf
  refine ⟨a,(pow_le_pow_left₀ (by positivity) hlow 2).trans ?_⟩
  exact_mod_cast ha

end Erdos571.ThreeHub

/-! A third-walk cap localizes an adjacency operator at one neighborhood.
The edge mask is imposed before forming its Gram matrix. No positive
semidefiniteness of a zero-diagonal codegree mask is assumed. -/
set_option maxHeartbeats 1600000
namespace Erdos571.LocalThirdOperator
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

omit [Fintype W] [DecidableEq W] in
lemma adjacency_nonneg (x y : W) : 0 ≤ G.adjMatrix ℝ x y := by
  dsimp [SimpleGraph.adjMatrix]
  split_ifs <;> norm_num

lemma square_row_on_neighbors (u x : W) (S : Finset W)
    (hS : S ⊆ G.neighborFinset u) :
    (∑ y∈S, ((G.adjMatrix ℝ)^2) x y) ≤ ((G.adjMatrix ℝ)^3) u x := by
  have hsym := (G.isSymm_adjMatrix (α := ℝ)).pow 2
  calc
    _ ≤ ∑ y∈G.neighborFinset u, ((G.adjMatrix ℝ)^2) x y :=
      sum_le_sum_of_subset_of_nonneg hS (fun y _ _ =>
        Matrix.pow_apply_nonneg (adjacency_nonneg G) 2 x y)
    _ = ∑ y∈G.neighborFinset u, ((G.adjMatrix ℝ)^2) y x := by
      exact sum_congr rfl (fun y _ => hsym.apply y x)
    _ = _ := by
      rw [show (3:ℕ)=1+2 from rfl, pow_add, pow_one, G.adjMatrix_mul_apply]

/-- Every nonnegative edge restriction of the local incidence matrix has
row-Gram mass at most the same third-walk bound. -/
theorem masked_gram_row (u : W) (S : Finset W) (T : ℝ)
    (hS : S ⊆ G.neighborFinset u)
    (hthird : ∀ x∈S, ((G.adjMatrix ℝ)^3) u x ≤ T)
    (P : Matrix S W ℝ) (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y) :
    (∀ x z, 0 ≤ (P*P.transpose) x z) ∧
      ∀ x, ∑ z, (P*P.transpose) x z ≤ T := by
  have hentry (x z : S) :
      0 ≤ (P*P.transpose) x z ∧
      (P*P.transpose) x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val := by
    rw [pow_two]
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    constructor
    · exact sum_nonneg (fun y _ => mul_nonneg (hP x y).1 (hP z y).1)
    · apply sum_le_sum
      intro y _
      rw [G.isSymm_adjMatrix.apply z.val y]
      exact mul_le_mul (hP x y).2 (hP z y).2 (hP z y).1 (adjacency_nonneg G _ _)
  refine ⟨fun x z => (hentry x z).1, ?_⟩
  intro x
  calc
    _ ≤ ∑ z : S, ((G.adjMatrix ℝ)^2) x.val z.val :=
      sum_le_sum (fun z _ => (hentry x z).2)
    _ = ∑ z∈S, ((G.adjMatrix ℝ)^2) x.val z := by
      exact Finset.sum_coe_sort S _
    _ ≤ ((G.adjMatrix ℝ)^3) u x.val := square_row_on_neighbors G u x.val S hS
    _ ≤ T := hthird x.val x.property

/-- A localized operator bound, valid for signed test functions. -/
theorem masked_operator (u : W) (S : Finset W) (T : ℝ) (hT : 0 ≤ T)
    (hS : S ⊆ G.neighborFinset u)
    (hthird : ∀ x∈S, ((G.adjMatrix ℝ)^3) u x ≤ T)
    (P : Matrix S W ℝ) (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y)
    (f : W → ℝ) :
    (∑ x, (∑ y, P x y*f y)^2) ≤ T*∑ y, (f y)^2 := by
  obtain ⟨hn, hr⟩ := masked_gram_row G u S T hS hthird P hP
  exact GramPin.row_gram_operator_bound P T hT hn hr f

/-- The transpose direction follows from the same local Gram row bound. -/
theorem masked_transpose_operator (u : W) (S : Finset W) (T : ℝ)
    (hS : S ⊆ G.neighborFinset u)
    (hthird : ∀ x∈S, ((G.adjMatrix ℝ)^3) u x ≤ T)
    (P : Matrix S W ℝ) (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y)
    (f : S → ℝ) :
    (∑ y, (∑ x, P x y*f x)^2) ≤ T*∑ x, (f x)^2 := by
  obtain ⟨hn, hr⟩ := masked_gram_row G u S T hS hthird P hP
  have hs : (P*P.transpose).IsSymm := by
    show (P*P.transpose).transpose = P*P.transpose
    rw [Matrix.transpose_mul, Matrix.transpose_transpose]
  have he : (∑ y, (∑ x, P x y*f x)^2) =
      ∑ x, ∑ z, (P*P.transpose) x z*f x*f z := by
    simp only [pow_two, Matrix.mul_apply, Matrix.transpose_apply, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro x _
    rw [sum_comm]
    apply sum_congr rfl
    intro z _
    exact sum_congr rfl (fun y _ => by ring)
  rw [he]
  exact GramPin.nonnegative_symmetric_form_bound (P*P.transpose) hs hn T hr f

/-- Squared Frobenius norm loses only T squared on a localized two-sided
conjugation, rather than the fourth power of the host maximum degree. -/
theorem masked_conjugation (u : W) (S : Finset W) (T : ℝ) (hT : 0 ≤ T)
    (hS : S ⊆ G.neighborFinset u)
    (hthird : ∀ x∈S, ((G.adjMatrix ℝ)^3) u x ≤ T)
    (P : Matrix S W ℝ) (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y)
    (K : Matrix W W ℝ) :
    GramPin.squareMass (P*K*P.transpose) ≤ T^2*GramPin.squareMass K := by
  obtain ⟨hn, hr⟩ := masked_gram_row G u S T hS hthird P hP
  have hleft := GramPin.squareMass_mul_left_le P K T hT hn hr
  have hright := GramPin.squareMass_mul_right_le (P*K) P.transpose T hT
    (by simpa only [Matrix.transpose_transpose] using hn)
    (by simpa only [Matrix.transpose_transpose] using hr)
  exact hright.trans ((mul_le_mul_of_nonneg_left hleft hT).trans_eq (by ring))

noncomputable def cut (u : W) (T : ℝ) : Finset W := by
  classical
  exact (G.neighborFinset u).filter (fun x => ((G.adjMatrix ℝ)^3) u x ≤ T)

lemma mem_cut (u x : W) (T : ℝ) :
    x∈cut G u T ↔ G.Adj u x ∧ ((G.adjMatrix ℝ)^3) u x ≤ T := by
  classical
  simp only [cut, mem_filter, G.mem_neighborFinset]

lemma cut_subset (u : W) (T : ℝ) : cut G u T ⊆ G.neighborFinset u := by
  classical
  exact filter_subset _ _

/-- Local fourth-walk mass controls the loss in the third-light
neighborhood. This estimate needs no coloring or forbidden-graph input. -/
theorem cut_loss (u : W) (T : ℝ) :
    T*(G.degree u:ℝ) ≤ T*(cut G u T).card + ((G.adjMatrix ℝ)^4) u u := by
  classical
  have hnon (x : W) : 0 ≤ ((G.adjMatrix ℝ)^3) u x :=
    Matrix.pow_apply_nonneg (adjacency_nonneg G) 3 u x
  have hh : ∀ x∈G.neighborFinset u, T ≤
      (if ((G.adjMatrix ℝ)^3) u x ≤ T then T else 0) + ((G.adjMatrix ℝ)^3) u x := by
    intro x hx
    split_ifs with h
    · exact le_add_of_nonneg_right (hnon x)
    · simp only [zero_add]
      exact (lt_of_not_ge h).le
  have hb := sum_le_sum hh
  rw [sum_add_distrib] at hb
  have he : (∑ x∈G.neighborFinset u,
      if ((G.adjMatrix ℝ)^3) u x ≤ T then T else 0) = T*(cut G u T).card := by
    rw [←sum_filter]
    simp only [cut, sum_const, nsmul_eq_mul, mul_comm T]
  have hs : (∑ x∈G.neighborFinset u, ((G.adjMatrix ℝ)^3) u x) =
      ((G.adjMatrix ℝ)^4) u u := by
    have hsym := (G.isSymm_adjMatrix (α := ℝ)).pow 3
    calc
      _ = ∑ x∈G.neighborFinset u, ((G.adjMatrix ℝ)^3) x u :=
        sum_congr rfl (fun x _ => hsym.apply x u)
      _ = _ := LocalSafeNeighbors.sum_third G u u
  rw [he, hs] at hb
  simpa only [sum_const, nsmul_eq_mul, card_neighborFinset_eq_degree, mul_comm T] using hb

lemma cut_half_degree (u : W) (d T : ℝ) (hT : 0 < T)
    (hmin : d ≤ (G.degree u:ℝ))
    (hfour : ((G.adjMatrix ℝ)^4) u u ≤ T*d/2) :
    d/2 ≤ ((cut G u T).card:ℝ) := by
  have h := cut_loss G u T
  have hh := mul_le_mul_of_nonneg_left hmin hT.le
  apply (mul_le_mul_iff_right₀ hT).mp
  nlinarith

/-- An edge in a pairwise-strong copy lies in the appropriate third-light
cut at either endpoint. -/
lemma strong_copy_edge_mem {V : Type} [Fintype V]
    (H : SimpleGraph V) (L D : ℝ)
    (f : StrongPinnedCopies.RoleFamily H G L D) {a b : V} (hab : H.Adj a b) :
    f.val b∈cut G (f.val a) (L*D) := by
  exact (mem_cut G _ _ _).mpr ⟨f.val.toHom.map_adj hab, (f.property a b hab.ne).2⟩

/-- The two edge masks may be different; each is formed on the same
third-light neighborhood before taking a Gram matrix. -/
theorem masked_cross_conjugation (u : W) (S : Finset W) (T : ℝ) (hT : 0 ≤ T)
    (hS : S ⊆ G.neighborFinset u)
    (hthird : ∀ x∈S, ((G.adjMatrix ℝ)^3) u x ≤ T)
    (P Q : Matrix S W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y)
    (hQ : ∀ x y, 0 ≤ Q x y ∧ Q x y ≤ G.adjMatrix ℝ x.val y)
    (K : Matrix W W ℝ) :
    GramPin.squareMass (P*K*Q.transpose) ≤ T^2*GramPin.squareMass K := by
  obtain ⟨hnP, hrP⟩ := masked_gram_row G u S T hS hthird P hP
  obtain ⟨hnQ, hrQ⟩ := masked_gram_row G u S T hS hthird Q hQ
  have hleft := GramPin.squareMass_mul_left_le P K T hT hnP hrP
  have hright := GramPin.squareMass_mul_right_le (P*K) Q.transpose T hT
    (by simpa only [Matrix.transpose_transpose] using hnQ)
    (by simpa only [Matrix.transpose_transpose] using hrQ)
  exact hright.trans ((mul_le_mul_of_nonneg_left hleft hT).trans_eq (by ring))

end Erdos571.LocalThirdOperator

namespace Erdos571.StrongCopyPins
open Finset SimpleGraph LocalThirdOperator
variable {A R W : Type} [Fintype A] [Fintype R] [Fintype W]
variable [DecidableEq A] [DecidableEq R] [DecidableEq W]
variable (H : SimpleGraph (A⊕R)) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma left_neighbor_cut (L : ℕ) (D : ℝ) (a : A)
    (p : Family H G L D a) (v : A⊕R) (hav : H.Adj (.inl a) v) :
    p.val.1.val v∈cut G (p.val.1.val (.inl a)) (L*D) :=
  strong_copy_edge_mem G H L D p.val.1 hav

/-- Both constituent copies use the SAME third-light neighborhood at their
shared pin. No third-walk cap between arbitrary cross-role pairs is claimed. -/
lemma right_neighbor_cut (L : ℕ) (D : ℝ) (a : A)
    (p : Family H G L D a) (v : A⊕R) (hav : H.Adj (.inl a) v) :
    p.val.2.val v∈cut G (p.val.1.val (.inl a)) (L*D) := by
  rw [p.property.2.1]
  exact strong_copy_edge_mem G H L D p.val.2 hav
end Erdos571.StrongCopyPins

namespace Erdos571.ThreeHub
open Finset SimpleGraph LocalThirdOperator
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- Actual ThreeHub freeness supplies a large third-light neighborhood at
EVERY vertex, not merely after averaging over anchors. -/
theorem third_cut_abundance (s M : ℕ) (hf : (graph s M).Free G)
    (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 0 < d)
    (hmin : ∀ x, d ≤ (G.degree x:ℝ))
    (hmax : ∀ x, (G.degree x:ℝ) ≤ Q*d) (u : W) :
    d/2 ≤ ((cut G u (2*(momentCoefficient s M+1)*Q^2*d)).card:ℝ) := by
  have hC := momentCoefficient_nonneg s M
  have hT : 0 < 2*(momentCoefficient s M+1)*Q^2*d := by positivity
  apply cut_half_degree G u d _ hT (hmin u)
  have hh := safe_four_walks G s M hf Q d hQ hd.le hmax u u
  apply hh.trans
  have he : 2*(momentCoefficient s M+1)*Q^2*d*d/2 =
      (momentCoefficient s M+1)*(Q*d)^2 := by ring
  rw [he]
  nlinarith [sq_nonneg (Q*d)]

/-- A concrete uniform local operator bound from the original forbidden
configuration. The test function may have either sign. -/
theorem third_cut_operator (s M : ℕ) (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 0 ≤ d)
    (u : W) (f : W → ℝ) :
    (∑ x : cut G u (2*(momentCoefficient s M+1)*Q^2*d),
      (∑ y, G.adjMatrix ℝ x.val y*f y)^2) ≤
      (2*(momentCoefficient s M+1)*Q^2*d)*∑ y, (f y)^2 := by
  have hC := momentCoefficient_nonneg s M
  apply masked_operator G u _ _ (by positivity) (cut_subset G u _)
    (fun x hx => ((mem_cut G u x _).mp hx).2)
    (fun x y => G.adjMatrix ℝ x.val y)
    (fun x y => ⟨adjacency_nonneg G x.val y, le_rfl⟩) f
end Erdos571.ThreeHub

/-! Arithmetic of a proposed path-cone transfer. The graph-theoretic
transfer is not asserted here. -/
set_option maxHeartbeats 1200000
namespace Erdos571.LongConeArithmetic

/-- Candidate increment in the extremal exponent after a length-k attachment. -/
def step (k : ℕ) (δ : ℚ) : ℚ := 1 / (1 + k * (1-δ))

lemma step_interval (k : ℕ) (hk : 1 ≤ k) (δ : ℚ)
    (hδ : 0 ≤ δ) (hsmall : (k:ℚ)*δ < 1) :
    δ < step k δ ∧ step k δ < 1 := by
  have hkq : (1:ℚ) ≤ k := by exact_mod_cast hk
  have hδ1 : δ < 1 := by nlinarith
  have hdiff : 0 < 1-δ := sub_pos.mpr hδ1
  have hden : 0 < 1 + (k:ℚ)*(1-δ) := by positivity
  constructor
  · apply (lt_div_iff₀ hden).mpr
    nlinarith [mul_pos (sub_pos.mpr hδ1) (sub_pos.mpr hsmall)]
  · apply (div_lt_one hden).mpr
    nlinarith [mul_pos (show (0:ℚ)<k by linarith) (sub_pos.mpr hδ1)]

/-- Every rational increment in [0,1) is generated from zero using only
steps whose input satisfies k*δ<1. The decreasing measure is the numerator. -/
theorem generate_fraction (P : ℚ → Prop) (hzero : P 0)
    (hstep : ∀ k : ℕ, 1 ≤ k → ∀ δ : ℚ, 0 ≤ δ → (k:ℚ)*δ < 1 →
      P δ → P (step k δ)) (p q : ℕ) (hpq : p < q) : P ((p:ℚ)/q) := by
  induction p using Nat.strong_induction_on generalizing q with
  | h p ih =>
    by_cases hp : p=0
    · subst p
      simpa using hzero
    have hp0 : 0<p := Nat.pos_of_ne_zero hp
    let k := (q-1)/p
    have hk : 1 ≤ k := Nat.div_pos (by omega) hp0
    have hlo : k*p < q := by
      have h := Nat.div_mul_le_self (q-1) p
      dsimp [k]
      omega
    have hhi : q ≤ (k+1)*p := by
      have h := Nat.lt_mul_div_succ (q-1) hp0
      rw [Nat.mul_comm p] at h
      change q-1 < (k+1)*p at h
      omega
    let r := (k+1)*p-q
    have hr : r+q=(k+1)*p := Nat.sub_add_cancel hhi
    have hrp : r<p := by nlinarith
    have hrkp : r<k*p := by nlinarith
    have hkp : 0<k*p := Nat.mul_pos (by omega) hp0
    have hold := ih r hrp (k*p) hrkp
    have hpQ : (0:ℚ)<p := by exact_mod_cast hp0
    have hkQ : (0:ℚ)<k := by exact_mod_cast (show 0<k by omega)
    have hqQ : (0:ℚ)<q := by exact_mod_cast (show 0<q by omega)
    have hrQ : (r:ℚ)+q=((k:ℚ)+1)*p := by exact_mod_cast hr
    have hrpQ : (r:ℚ)<p := by exact_mod_cast hrp
    have hin : 0 ≤ (r:ℚ)/(k*p:ℕ) := by positivity
    have hsmall : (k:ℚ)*((r:ℚ)/(k*p:ℕ))<1 := by
      push_cast
      apply (mul_lt_mul_iff_right₀ hpQ).mp
      field_simp
      nlinarith
    have h := hstep k hk ((r:ℚ)/(k*p:ℕ)) hin hsmall hold
    have he : step k ((r:ℚ)/(k*p:ℕ))=(p:ℚ)/q := by
      unfold step
      push_cast
      have hd : 1+(k:ℚ)*(1-(r:ℚ)/((k:ℚ)*p))=(q:ℚ)/p := by
        field_simp
        nlinarith
      rw [hd]
      field_simp
    rwa [he] at h

/-- Rational, rather than numerator/denominator, interface to the same
arithmetic reduction. This supplies no extremal upper-bound theorem. -/
theorem generate (P : ℚ → Prop) (hzero : P 0)
    (hstep : ∀ k : ℕ, 1 ≤ k → ∀ δ : ℚ, 0 ≤ δ → (k:ℚ)*δ < 1 →
      P δ → P (step k δ)) (δ : ℚ) (hδ : 0 ≤ δ) (hδ1 : δ < 1) : P δ := by
  have hn : 0 ≤ δ.num := Rat.num_nonneg.mpr hδ
  have hnQ : (δ.num.natAbs:ℚ)=δ.num := by
    rw [←Int.cast_natCast,Int.natAbs_of_nonneg hn]
  have he : (δ.num.natAbs:ℚ)/δ.den=δ := by
    rw [hnQ,Rat.num_div_den]
  have hden : (0:ℚ)<δ.den := by exact_mod_cast δ.den_pos
  have hpq : δ.num.natAbs<δ.den := by
    have hh := (div_lt_one hden).mp (he ▸ hδ1)
    exact_mod_cast hh
  simpa only [he] using generate_fraction P hzero hstep δ.num.natAbs δ.den hpq


/-- Retaining the old graph cannot support a decrease of an already sharp
exponent. The arithmetic map is nondecreasing exactly in this range. -/
lemma step_comparison (k : ℕ) (δ : ℚ) (hδ1 : δ<1) :
    δ≤step k δ ↔ (k:ℚ)*δ≤1 := by
  have hd : 0<1+(k:ℚ)*(1-δ) := by
    have hdiff : 0<1-δ := sub_pos.mpr hδ1
    positivity
  unfold step
  rw [le_div_iff₀ hd]
  constructor
  · intro h
    by_contra hn
    have hp := mul_pos (sub_pos.mpr hδ1) (sub_pos.mpr (lt_of_not_ge hn))
    nlinarith
  · intro h
    have hp := mul_nonneg (sub_pos.mpr hδ1).le (sub_nonneg.mpr h)
    nlinarith

/-- The formal parameter change suggested by length-k path attachment. -/
lemma parameter_identity (a b k : ℕ) (hb : 0<b) :
    step k (1-(a:ℚ)/b) = (b:ℚ)/(b+k*a:ℕ) := by
  have hbQ : (0:ℚ)<b := by exact_mod_cast hb
  unfold step
  push_cast
  have he : 1+(k:ℚ)*(1-(1-(a:ℚ)/b))=((b:ℚ)+k*a)/b := by
    field_simp
    ring
  rw [he]
  field_simp

lemma first_gap_chain :
    step 2 (step 3 (step 5 0)) = (7/17:ℚ) := by
  norm_num [step]

end Erdos571.LongConeArithmetic

/-! A concrete path-cone construction, retaining the old graph and adding
one private path from each old vertex to one of two adjacent new roots.
No extremal upper transfer is asserted in this module. -/
set_option maxHeartbeats 1200000
namespace Erdos571.PathCone
open SimpleGraph

/-- Alternating colors along a path. -/
def flip : Bool → ℕ → Bool
  | b,0 => b
  | b,n+1 => !(flip b n)

@[simp] lemma flip_zero (b : Bool) : flip b 0=b := rfl
@[simp] lemma flip_succ (b : Bool) (n : ℕ) : flip b (n+1)=!(flip b n) := rfl
lemma flip_ne_succ (b : Bool) (n : ℕ) : flip b n≠flip b (n+1) := by
  rw [flip_succ]
  cases flip b n <;> decide

abbrev Vertex (V : Type*) (k : ℕ) := (V×Fin k)⊕Bool

/-- The new path from (v,0) has k edges, including its final edge to an apex. -/
def graph {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ) :
    SimpleGraph (Vertex V k) where
  Adj x y := match x,y with
    | .inl (v,i), .inl (w,j) =>
        (i.val=0 ∧ j.val=0 ∧ H.Adj v w) ∨
          (v=w ∧ i.val+1=j.val) ∨ (v=w ∧ j.val+1=i.val)
    | .inl (v,i), .inr b => i.val+1=k ∧ flip (c v) k=b
    | .inr b, .inl (v,i) => i.val+1=k ∧ flip (c v) k=b
    | .inr b, .inr d => b≠d
  symm := by
    rintro (⟨v,i⟩|b) (⟨w,j⟩|d) h
    · rcases h with ⟨hi,hj,h⟩|⟨h,hij⟩|⟨h,hji⟩
      · exact Or.inl ⟨hj,hi,h.symm⟩
      · exact Or.inr (Or.inr ⟨h.symm,hij⟩)
      · exact Or.inr (Or.inl ⟨h.symm,hji⟩)
    · exact h
    · exact h
    · exact h.symm
  loopless := by
    rintro (⟨v,i⟩|b) h
    · rcases h with ⟨_,_,h⟩|⟨_,h⟩|⟨_,h⟩
      · exact H.irrefl h
      · omega
      · omega
    · exact h rfl

def color {V : Type*} (c : V → Bool) (k : ℕ) : Vertex V k → Bool
  | .inl (v,i) => flip (c v) i.val
  | .inr b => b

lemma color_proper {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ)
    (hc : ∀{v w}, H.Adj v w → c v≠c w) :
    ∀{x y}, (graph H c k).Adj x y → color c k x≠color c k y := by
  rintro (⟨v,i⟩|b) (⟨w,j⟩|d) h
  · rcases h with ⟨hi,hj,h⟩|⟨h,hij⟩|⟨h,hji⟩
    · simpa only [color,hi,hj,flip_zero] using hc h
    · subst w
      simpa only [color,←hij] using flip_ne_succ (c v) i.val
    · subst w
      simpa only [color,←hji] using (flip_ne_succ (c v) j.val).symm
  · obtain ⟨hi,hb⟩ := h
    change flip (c v) i.val≠d
    simpa only [hi,hb] using flip_ne_succ (c v) i.val
  · obtain ⟨hj,hb⟩ := h
    change b≠flip (c w) j.val
    simpa only [hj,hb] using (flip_ne_succ (c w) j.val).symm
  · exact h

lemma bipartite {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ)
    (hc : ∀{v w}, H.Adj v w → c v≠c w) : (graph H c k).IsBipartite := by
  let coloring : (graph H c k).Coloring Bool := ⟨color c k,fun h => color_proper H c k hc h⟩
  simpa only [Fintype.card_bool] using coloring.colorable

/-- Old edges are retained, not subdivided. -/
def oldCopy {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ) (hk : 1≤k) :
    H.Copy (graph H c k) where
  toHom :=
    { toFun := fun v => .inl (v,⟨0,by omega⟩)
      map_rel' := fun h => Or.inl ⟨rfl,rfl,h⟩ }
  injective' := by
    intro v w h
    exact (Prod.mk.inj (Sum.inl.inj h)).1

lemma old_contained {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ) (hk : 1≤k) :
    H ⊑ graph H c k := ⟨oldCopy H c k hk⟩

/-- Every path vertex has a successor toward its apex, and the two apices
are adjacent. This does not require the old graph to have any edges. -/
lemma no_isolated {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ) :
    ∀x, ∃y, (graph H c k).Adj x y := by
  rintro (⟨v,i⟩|b)
  · by_cases hi : i.val+1<k
    · exact ⟨.inl (v,⟨i.val+1,hi⟩),Or.inr (Or.inl ⟨rfl,rfl⟩)⟩
    · exact ⟨.inr (flip (c v) k),⟨by omega,rfl⟩⟩
  · refine ⟨.inr (!b),?_⟩
    change b≠!b
    cases b <;> decide


lemma reach_apex {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ)
    (v : V) (i : Fin k) :
    (graph H c k).Reachable (.inl (v,i)) (.inr (flip (c v) k)) := by
  by_cases hi : i.val+1<k
  · exact (show (graph H c k).Adj (.inl (v,i)) (.inl (v,⟨i.val+1,hi⟩)) from
      Or.inr (Or.inl ⟨rfl,rfl⟩)).reachable.trans
        (reach_apex H c k v ⟨i.val+1,hi⟩)
  · exact (show (graph H c k).Adj (.inl (v,i)) (.inr (flip (c v) k)) from
      ⟨by omega,rfl⟩).reachable
termination_by k-i.val

lemma connected {V : Type*} (H : SimpleGraph V) (c : V → Bool) (k : ℕ) :
    (graph H c k).Connected := by
  have hr (b : Bool) : (graph H c k).Reachable (.inr b) (.inr false) := by
    cases b
    · exact Reachable.rfl
    · exact (show (graph H c k).Adj (.inr true) (.inr false) from by change true≠false; decide).reachable
  have h (x : Vertex V k) : (graph H c k).Reachable x (.inr false) := by
    rcases x with ⟨v,i⟩|b
    · exact (reach_apex H c k v i).trans (hr _)
    · exact hr b
  exact { preconnected := fun x y => (h x).trans (h y).symm, nonempty := ⟨.inr false⟩ }

/-- At length one this is exactly the already-treated ordinary paired cone. -/
def oneIso {V : Type*} (H : SimpleGraph V) (c : V → Bool) :
    graph H c 1 ≃g OrdinaryCone.graph H c where
  toEquiv := Equiv.sumCongr (Equiv.prodUnique V (Fin 1)) (Equiv.refl Bool)
  map_rel_iff' := by
    have hi (i : Fin 1) : i=0 := Subsingleton.elim _ _
    rintro (⟨v,i⟩|b) (⟨w,j⟩|d)
    all_goals simp [graph,OrdinaryCone.graph,hi,flip]
    · cases c v <;> cases d <;> decide
    · cases b <;> cases c w <;> decide

lemma one_edge_bound {V : Type} [Fintype V] (H : SimpleGraph V) (hH : H.Connected)
    (c : V → Bool) (hc : ∀{u v}, H.Adj u v → c u≠c v) {α C : ℝ}
    (hα1 : 1≤α) (hα2 : α<2) (hC : 0≤C) (hbound : ProjectionHeavy.EdgeBound H α C) :
    ∃D : ℝ, 0≤D ∧ ProjectionHeavy.EdgeBound (graph H c 1) (1+(3-α)⁻¹) D := by
  obtain ⟨D,hD,h⟩ := OrdinaryCone.edge_bound H hH c hc hα1 hα2 hC hbound
  exact ⟨D,hD,h.mono ⟨(oneIso H c).toCopy⟩⟩

end Erdos571.PathCone


/-! Rooted path cones: graph compatibility and balance. -/

namespace Erdos571.RootedPathCone
open Finset SimpleGraph RootedSunflower

variable {A R : Type*}

abbrev Nonroot (A : Type*) (k : ℕ) := A × Fin k
abbrev Root (R : Type*) (k : ℕ) := (R × Fin k) ⊕ Bool
abbrev Vertex (A R : Type*) (k : ℕ) := Nonroot A k ⊕ Root R k

def vertexEquiv (A R : Type*) (k : ℕ) : Vertex A R k ≃ PathCone.Vertex (A ⊕ R) k where
  toFun
    | .inl (a,i) => .inl (.inl a,i)
    | .inr (.inl (r,i)) => .inl (.inr r,i)
    | .inr (.inr b) => .inr b
  invFun
    | .inl (.inl a,i) => .inl (a,i)
    | .inl (.inr r,i) => .inr (.inl (r,i))
    | .inr b => .inr (.inr b)
  left_inv := by rintro (⟨a,i⟩ | (⟨r,i⟩ | b)) <;> rfl
  right_inv := by rintro (⟨a|r,i⟩ | b) <;> rfl

def graph (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ) :
    SimpleGraph (Vertex A R k) :=
  (PathCone.graph H c k).comap (vertexEquiv A R k)

def ordinaryIso (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ) :
    graph H c k ≃g PathCone.graph H c k :=
  SimpleGraph.Iso.comap (vertexEquiv A R k) _

def color (c : A ⊕ R → Bool) (k : ℕ) : Vertex A R k → Bool :=
  PathCone.color c k ∘ vertexEquiv A R k

lemma color_proper (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ)
    (hc : ∀{v w}, H.Adj v w → c v ≠ c w) :
    ∀{x y}, (graph H c k).Adj x y → color c k x ≠ color c k y := by
  intro x y h
  exact PathCone.color_proper H c k hc h

lemma bipartite (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ)
    (hc : ∀{v w}, H.Adj v w → c v ≠ c w) : (graph H c k).IsBipartite := by
  let col : (graph H c k).Coloring Bool := ⟨color c k, fun h => color_proper H c k hc h⟩
  simpa only [Fintype.card_bool] using col.colorable

lemma connected (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ) :
    (graph H c k).Connected :=
  (ordinaryIso H c k).connected_iff.mpr (PathCone.connected H c k)

lemma no_isolated (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ) :
    ∀x, ∃y, (graph H c k).Adj x y := by
  intro x
  obtain ⟨y,hy⟩ := PathCone.no_isolated H c k (vertexEquiv A R k x)
  refine ⟨(vertexEquiv A R k).symm y, ?_⟩
  change (PathCone.graph H c k).Adj _ _
  simpa only [Equiv.apply_symm_apply] using hy

/-- Paths above root vertices are shared; paths above nonroots are copied. -/
def powerEquiv (A R : Type*) (k M : ℕ) :
    ((Fin M × Nonroot A k) ⊕ Root R k) ≃ PathCone.Vertex ((Fin M × A) ⊕ R) k where
  toFun
    | .inl (m,a,i) => .inl (.inl (m,a),i)
    | .inr (.inl (r,i)) => .inl (.inr r,i)
    | .inr (.inr b) => .inr b
  invFun
    | .inl (.inl (m,a),i) => .inl (m,a,i)
    | .inl (.inr r,i) => .inr (.inl (r,i))
    | .inr b => .inr (.inr b)
  left_inv := by rintro (⟨m,a,i⟩ | (⟨r,i⟩ | b)) <;> rfl
  right_inv := by rintro (⟨⟨m,a⟩|r,i⟩ | b) <;> rfl

def powerIso (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k M : ℕ) :
    FullRootedPower.graph (graph H c k) M ≃g
      PathCone.graph (FullRootedPower.graph H M) (FullRootedPower.color c M) k where
  toEquiv := powerEquiv A R k M
  map_rel_iff' := by
    rintro (⟨m,a,i⟩ | (⟨r,i⟩ | b)) (⟨m',a',j⟩ | (⟨r',j⟩ | b'))
    all_goals simp only [graph, SimpleGraph.comap_adj, PathCone.graph,
      FullRootedPower.graph, FullRootedPower.color, powerEquiv, vertexEquiv,
      Equiv.coe_fn_mk, Sum.elim_inl, Sum.elim_inr, Sum.inl.injEq, Sum.inr.injEq,
      Sum.inl_ne_inr, Sum.inr_ne_inl, Prod.mk.injEq, false_and, or_false]
    all_goals tauto

lemma power_color (c : A ⊕ R → Bool) (k M : ℕ)
    (v : (Fin M × Nonroot A k) ⊕ Root R k) :
    PathCone.color (FullRootedPower.color c M) k (powerEquiv A R k M v) =
      FullRootedPower.color (color c k) M v := by
  rcases v with ⟨m,a,i⟩ | (⟨r,i⟩ | b) <;> rfl


def old (k : ℕ) (hk : 1 ≤ k) : A ⊕ R → Vertex A R k
  | .inl a => .inl (a,⟨0,by omega⟩)
  | .inr r => .inr (.inl (r,⟨0,by omega⟩))

lemma old_injective (k : ℕ) (hk : 1 ≤ k) :
    Function.Injective (old (A:=A) (R:=R) k hk) := by
  rintro (a|r) (a'|r') h <;> simp_all only [old, Sum.inl.injEq,
    Sum.inr.injEq, Sum.inl_ne_inr, Sum.inr_ne_inl, Prod.mk.injEq, and_true]

def oldCopy (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) (k : ℕ) (hk : 1 ≤ k) :
    H.Copy (graph H c k) where
  toHom :=
    { toFun := old k hk
      map_rel' := by
        rintro (a|r) (a'|r') h <;> exact Or.inl ⟨rfl,rfl,h⟩ }
  injective' := old_injective k hk

def level {k : ℕ} : Vertex A R k → ℕ
  | .inl (_,i) => i.val
  | .inr (.inl (_,i)) => i.val
  | .inr (.inr _) => k

@[simp] lemma level_old (k : ℕ) (hk : 1 ≤ k) (v : A ⊕ R) :
    level (old k hk v) = 0 := by cases v <;> rfl

def next (c : A ⊕ R → Bool) {k : ℕ} (p : Nonroot A k) : Vertex A R k :=
  if h : p.2.val+1<k then .inl (p.1,⟨p.2.val+1,h⟩)
  else .inr (.inr (PathCone.flip (c (.inl p.1)) k))

@[simp] lemma level_next (c : A ⊕ R → Bool) {k : ℕ} (p : Nonroot A k) :
    level (next c p) = p.2.val+1 := by
  dsimp [next]
  split_ifs with h
  · rfl
  · dsimp [level]
    omega

def outEdge (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) {k : ℕ}
    (p : Nonroot A k) : (graph H c k).edgeSet :=
  ⟨s(.inl p,next c p),by
    dsimp [next]
    split_ifs with h
    · exact Or.inr (Or.inl ⟨rfl,rfl⟩)
    · exact ⟨by omega,rfl⟩⟩

lemma outEdge_injective (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool) {k : ℕ} :
    Function.Injective (outEdge H c (k:=k)) := by
  intro p q h
  have h' := congrArg Subtype.val h
  change s(.inl p,next c p) = s(.inl q,next c q) at h'
  rcases Sym2.eq_iff.mp h' with ⟨hp,_⟩ | ⟨h₁,h₂⟩
  · exact Sum.inl.inj hp
  · have hl₁ := congrArg level h₁
    have hl₂ := congrArg level h₂
    simp only [level_next] at hl₁ hl₂
    change p.2.val = q.2.val+1 at hl₁
    change p.2.val+1 = q.2.val at hl₂
    omega

lemma old_outEdge_ne (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {k : ℕ} (hk : 1 ≤ k) (e : H.edgeSet) (p : Nonroot A k) :
    (oldCopy H c k hk).toHom.mapEdgeSet e ≠ outEdge H c p := by
  intro h
  have hm : next c p ∈ ((oldCopy H c k hk).toHom.mapEdgeSet e).val := by
    rw [h]
    exact Sym2.mem_iff.mpr (Or.inr rfl)
  obtain ⟨v,hv,he⟩ := Sym2.mem_map.mp hm
  have hl := congrArg level he
  change level (old k hk v) = level (next c p) at hl
  rw [level_old,level_next] at hl
  omega

end Erdos571.RootedPathCone


/-! Counting touched edges on the attachment paths. -/
namespace Erdos571.RootedPathCone
open Finset SimpleGraph RootedSunflower
attribute [local instance] Classical.propDecidable

variable {A R : Type*} [Fintype A] [Fintype R]

noncomputable def freeLevels {k : ℕ} (C : Finset (Nonroot A k)) (a : A) : Finset (Fin k) :=
  univ.filter (fun i => (a,i) ∉ C)

noncomputable def oldPins {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) : Finset A :=
  univ.filter (fun a => (a,⟨0,by omega⟩) ∈ C)

noncomputable def extra {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) : Finset A :=
  (oldPins hk C).filter (fun a => (freeLevels C a).Nonempty)

lemma unpinned_card {k : ℕ} (C : Finset (Nonroot A k)) :
    Fintype.card (Nonroot A k)-C.card = ∑ a, (freeLevels C a).card := by
  classical
  have h := Fintype.card_congr (Equiv.subtypeProdEquivSigmaSubtype
    (fun (a : A) (i : Fin k) => (a,i) ∉ C))
  change Fintype.card {p : Nonroot A k // p ∉ C} = _ at h
  rw [Fintype.card_subtype_compl,Fintype.card_coe,Fintype.card_sigma] at h
  simpa only [Fintype.card_subtype,freeLevels] using h

/-- A nonempty fiber not containing level zero has at most `k-1` levels. -/
lemma unpinned_bound {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) :
    Fintype.card (Nonroot A k)-C.card ≤
      k*(Fintype.card A-(oldPins hk C).card) + (k-1)*(extra hk C).card := by
  classical
  have h (a : A) : (freeLevels C a).card ≤
      (if a ∉ oldPins hk C then k else 0) + (if a ∈ extra hk C then k-1 else 0) := by
    by_cases ha : a ∉ oldPins hk C
    · have hb : (freeLevels C a).card ≤ k := by
        simpa only [Fintype.card_fin] using card_le_univ (freeLevels C a)
      simpa only [if_pos ha] using hb.trans (Nat.le_add_right _ _)
    · have ha' : a ∈ oldPins hk C := by tauto
      by_cases he : (freeLevels C a).Nonempty
      · have hb : (freeLevels C a) ⊆ (univ : Finset (Fin k)).erase ⟨0,by omega⟩ := by
          intro i hi
          have hi' := (mem_filter.mp hi).2
          have ha₀ := (mem_filter.mp ha').2
          apply mem_erase.mpr
          exact ⟨fun h => hi' (by simpa only [h] using ha₀),mem_univ _⟩
        have hb' : (freeLevels C a).card ≤ k-1 := by
          simpa only [card_erase_of_mem (mem_univ _),card_univ,Fintype.card_fin]
            using card_le_card hb
        have hae : a ∈ extra hk C := mem_filter.mpr ⟨ha',he⟩
        simpa only [if_neg ha,if_pos hae,zero_add] using hb'
      · have hzero : freeLevels C a = ∅ := not_nonempty_iff_eq_empty.mp he
        simp only [hzero,card_empty,zero_le]
  rw [unpinned_card]
  calc
    _ ≤ ∑ a, ((if a ∉ oldPins hk C then k else 0) + (if a ∈ extra hk C then k-1 else 0)) :=
      sum_le_sum (fun a _ => h a)
    _ = _ := by
      rw [sum_add_distrib, sum_ite, sum_ite]
      simp only [sum_const, nsmul_eq_mul, Nat.cast_id,
        filter_mem_eq_inter, univ_inter]
      have hcard : (univ.filter (fun a => a ∉ oldPins hk C)).card =
          Fintype.card A-(oldPins hk C).card := by
        simpa only [Finset.compl_eq_univ_sdiff,Finset.sdiff_eq_filter] using
          Finset.card_compl (oldPins hk C)
      rw [hcard]
      ring

noncomputable def firstFree {k : ℕ} {hk : 1 ≤ k} {C : Finset (Nonroot A k)}
    (a : extra hk C) : Fin k :=
  (freeLevels C a.val).min' ((mem_filter.mp a.property).2)

lemma firstFree_not_mem {k : ℕ} {hk : 1 ≤ k} {C : Finset (Nonroot A k)}
    (a : extra hk C) : (a.val,firstFree a) ∉ C := by
  exact (mem_filter.mp ((freeLevels C a.val).min'_mem ((mem_filter.mp a.property).2))).2

lemma firstFree_pos {k : ℕ} {hk : 1 ≤ k} {C : Finset (Nonroot A k)}
    (a : extra hk C) : 0 < (firstFree a).val := by
  have ha := (mem_filter.mp (mem_filter.mp a.property).1).2
  have hfree := firstFree_not_mem a
  by_contra hn
  have hi : firstFree a = ⟨0,by omega⟩ := Fin.ext (by change (firstFree a).val = 0; omega)
  exact hfree (by simpa only [hi] using ha)

noncomputable def gapIndex {k : ℕ} {hk : 1 ≤ k} {C : Finset (Nonroot A k)}
    (a : extra hk C) : Nonroot A k :=
  (a.val,⟨(firstFree a).val-1,by have := (firstFree a).isLt; omega⟩)

lemma gapIndex_mem {k : ℕ} {hk : 1 ≤ k} {C : Finset (Nonroot A k)}
    (a : extra hk C) : gapIndex a ∈ C := by
  by_contra h
  have hi : (gapIndex a).2 ∈ freeLevels C a.val := mem_filter.mpr ⟨mem_univ _,h⟩
  have hmin := (freeLevels C a.val).min'_le _ hi
  change firstFree a ≤ (gapIndex a).2 at hmin
  have hv := hmin
  change (firstFree a).val ≤ (firstFree a).val-1 at hv
  have hp := firstFree_pos a
  omega

omit [Fintype R] in
lemma next_gapIndex (c : A ⊕ R → Bool) {k : ℕ} {hk : 1 ≤ k}
    {C : Finset (Nonroot A k)} (a : extra hk C) :
    next c (gapIndex a) = Sum.inl (a.val,firstFree a) := by
  have hp := firstFree_pos a
  have hl : (firstFree a).val-1+1 < k := by have := (firstFree a).isLt; omega
  simp only [next,gapIndex,dif_pos hl]
  congr 2
  apply Fin.ext
  dsimp
  omega


noncomputable def oldPetal (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) :
    PetalEdge H (oldPins hk C) → PetalEdge (graph H c k) C := fun e =>
  ⟨(oldCopy H c k hk).toHom.mapEdgeSet e.val,by
    obtain ⟨a,ha,he⟩ := e.property
    refine ⟨(a,⟨0,by omega⟩),?_,?_⟩
    · simpa only [oldPins,mem_filter,mem_univ,true_and] using ha
    · exact Sym2.mem_map.mpr ⟨.inl a,he,rfl⟩⟩

noncomputable def outgoingPetal (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {k : ℕ} (C : Finset (Nonroot A k)) :
    {p : Nonroot A k // p ∉ C} → PetalEdge (graph H c k) C := fun p =>
  ⟨outEdge H c p.val,p.val,p.property,Sym2.mem_iff.mpr (Or.inl rfl)⟩

noncomputable def gapPetal (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) :
    extra hk C → PetalEdge (graph H c k) C := fun a =>
  ⟨outEdge H c (gapIndex a),(a.val,firstFree a),firstFree_not_mem a,by
    change Sum.inl (a.val,firstFree a) ∈ s(Sum.inl (gapIndex a),next c (gapIndex a))
    rw [next_gapIndex]
    exact Sym2.mem_iff.mpr (Or.inr rfl)⟩

lemma petal_injective (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) :
    Function.Injective (Sum.elim (oldPetal H c hk C)
      (Sum.elim (outgoingPetal H c C) (gapPetal H c hk C))) := by
  classical
  apply Sum.elim_injective.mpr
  refine ⟨?_,?_,?_⟩
  · intro e f h
    exact Subtype.ext (Hom.mapEdgeSet.injective (oldCopy H c k hk).toHom
      (old_injective k hk) (congrArg Subtype.val h))
  · apply Sum.elim_injective.mpr
    refine ⟨?_,?_,?_⟩
    · intro p q h
      exact Subtype.ext (outEdge_injective H c (congrArg Subtype.val h))
    · intro a b h
      have hp := outEdge_injective H c (congrArg Subtype.val h)
      exact Subtype.ext (congrArg Prod.fst hp)
    · intro p a h
      have hp : p.val=gapIndex a := outEdge_injective H c (congrArg Subtype.val h)
      exact p.property (hp ▸ gapIndex_mem a)
  · rintro e (p|a) h
    · exact old_outEdge_ne H c hk e.val p.val (congrArg Subtype.val h)
    · exact old_outEdge_ne H c hk e.val (gapIndex a) (congrArg Subtype.val h)

/-- Old touched edges, outgoing edges, and the extra predecessor edges are disjoint. -/
lemma petal_card (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    {k : ℕ} (hk : 1 ≤ k) (C : Finset (Nonroot A k)) :
    Nat.card (PetalEdge H (oldPins hk C)) +
      (Fintype.card (Nonroot A k)-C.card) + (extra hk C).card ≤
        Nat.card (PetalEdge (graph H c k) C) := by
  classical
  have h := Nat.card_le_card_of_injective _ (petal_injective H c hk C)
  simpa only [Nat.card_eq_fintype_card,Fintype.card_sum,Fintype.card_subtype_compl,
    Fintype.card_coe,add_assoc] using h

/-- Attaching paths of length `k` transfers the balance parameters from
`(a,b)` to `(k*a,b+k*a)`, in the range forced by the retained old edges. -/
theorem balance (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (a b k : ℕ) (hk : 1 ≤ k) (hadm : (k-1)*b ≤ k*a)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∀ C : Finset (Nonroot A k),
      (b+k*a)*(Fintype.card (Nonroot A k)-C.card) ≤
        (k*a)*Nat.card (PetalEdge (graph H c k) C) := by
  intro C
  have h₁ := Nat.mul_le_mul_left k (hbal (oldPins hk C))
  have h₂ := Nat.mul_le_mul_left b (unpinned_bound hk C)
  have h₃ := Nat.mul_le_mul_right (extra hk C).card hadm
  have h₄ := Nat.mul_le_mul_left (k*a) (petal_card H c hk C)
  nlinarith

end Erdos571.RootedPathCone


/-! The exact lower bound for full powers of a rooted path cone. -/
namespace Erdos571.RootedPathCone
open Finset SimpleGraph RootedSunflower

/-- The balance transfer yields the predicted lower bound for an actual path
cone over an actual rooted power. This theorem claims no upper estimate. -/
theorem exact_lower {A R : Type} [Fintype A] [Fintype R] [Nonempty A]
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (a b k : ℕ) (hb : 1 ≤ b) (hk : 1 ≤ k) (hadm : (k-1)*b ≤ k*a)
    (hbal : ∀ C : Finset A, b*(Fintype.card A-C.card) ≤ a*Nat.card (PetalEdge H C)) :
    ∃ M : ℕ, 2 ≤ M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-((k*a:ℕ):ℝ)/((b+k*a:ℕ):ℝ)))
      (fun n : ℕ => (extremalNumber n
        (PathCone.graph (FullRootedPower.graph H M) (FullRootedPower.color c M) k):ℝ)) := by
  letI : NeZero k := ⟨by omega⟩
  obtain ⟨M,hM,h⟩ := FullRootedPower.exact_lower (graph H c k) (no_isolated H c k)
    (k*a) (b+k*a) (by omega) (by omega) (balance H c a b k hk hadm hbal)
  have he (n : ℕ) := extremalNumber_congr_right (powerIso H c k M) (n:=n)
  refine ⟨M,hM,?_⟩
  simpa only [he] using h

end Erdos571.RootedPathCone


/-! A precise conditional reduction to the currently unproved path-cone upper
transfer. All graph compatibility and lower-balance inputs are proved. -/
namespace Erdos571.PathConeReduction
open Finset SimpleGraph ProjectionHeavy RootedSunflower

/-- This is an unproved hypothesis, not an assertion of an upper bound. -/
def Upper : Prop :=
  ∀ (V : Type) [Fintype V] (H : SimpleGraph V), H.Connected →
    ∀ (c : V → Bool), (∀ {v w}, H.Adj v w → c v ≠ c w) →
    ∀ (α C : ℝ), 1 ≤ α → α < 2 → 0 ≤ C → EdgeBound H α C →
    ∀ (k : ℕ), 1 ≤ k → (k:ℝ)*(α-1) < 1 →
      ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (PathCone.graph H c k) (1+1/(1+k*(2-α))) D

lemma supported (hu : Upper) {A R : Type} [Fintype A] [Fintype R] [Nonempty R]
    (H : SimpleGraph (A ⊕ R)) (c : A ⊕ R → Bool)
    (hH : H.Connected) (hc : ∀ {v w}, H.Adj v w → c v ≠ c w)
    (α : ℝ) (hα : 1 ≤ α) (hα2 : α < 2) (hs : OrdinaryRooted.Supported H α)
    (k : ℕ) (hk : 1 ≤ k) (hsmall : (k:ℝ)*(α-1)<1) :
    OrdinaryRooted.Supported (RootedPathCone.graph H c k) (1+1/(1+k*(2-α))) := by
  intro M hM
  obtain ⟨C,hC,hb⟩ := hs M hM
  obtain ⟨D,hD,hd⟩ := hu _ (FullRootedPower.graph H M)
    (FullRootedPower.connected H hH (by omega)) (FullRootedPower.color c M)
    (FullRootedPower.color_proper H c M hc) α C hα hα2 hC hb k hk hsmall
  exact ⟨D,hD,hd.congr (RootedPathCone.powerIso H c k M).symm⟩

lemma certificate (hu : Upper) {a b : ℕ} (h : OrdinaryRooted.Certificate a b)
    (ha : 1 ≤ a) (hab : a ≤ b) (k : ℕ) (hk : 1 ≤ k)
    (hsmall : (k:ℚ)*(1-(a:ℚ)/b)<1) :
    OrdinaryRooted.Certificate (k*a) (b+k*a) := by
  obtain ⟨A,R,hA,hR,hAn,hRn,H,c,hc,hH,hni,hbal,hs⟩ := h
  letI := hA
  letI := hR
  letI := hAn
  letI := hRn
  letI : NeZero k := ⟨by omega⟩
  have hb : (0:ℚ)<b := by exact_mod_cast (show 0<b by omega)
  have hbk : (k-1:ℕ)*b ≤ k*a := by
    have hq : ((k:ℚ)-1)*b < (k:ℚ)*a := by
      have hh := (mul_lt_mul_iff_left₀ hb).mpr hsmall
      field_simp at hh
      nlinarith
    have hks : ((k-1:ℕ):ℚ)=(k:ℚ)-1 := by
      rw [Nat.cast_sub hk,Nat.cast_one]
    rw [←hks] at hq
    exact le_of_lt (by exact_mod_cast hq)
  refine ⟨RootedPathCone.Nonroot A k,RootedPathCone.Root R k,
    inferInstance,inferInstance,inferInstance,inferInstance,
    RootedPathCone.graph H c k,RootedPathCone.color c k,
    RootedPathCone.color_proper H c k hc,RootedPathCone.connected H c k,
    RootedPathCone.no_isolated H c k,RootedPathCone.balance H c a b k hk hbk hbal,?_⟩
  have hi := SupportedBounds.deficit_interval a b ha hab
  have hsmallR : (k:ℝ)*((2-(a:ℝ)/b)-1)<1 := by
    have hq : (k:ℚ)*((2-(a:ℚ)/b)-1)<1 := by convert hsmall using 1 <;> ring
    have hh := (Rat.cast_lt (K:=ℝ)).mpr hq
    simpa only [Rat.cast_mul,Rat.cast_sub,Rat.cast_div,Rat.cast_ofNat,Rat.cast_natCast,
      Rat.cast_one] using hh
  have hbound := supported hu H c hH hc _ hi.1 hi.2 hs k hk hsmallR
  have he : 1+1/(1+(k:ℝ)*(2-(2-(a:ℝ)/b))) =
      2-((k*a:ℕ):ℝ)/((b+k*a:ℕ):ℝ) := by
    have hbR : (0:ℝ)<b := by exact_mod_cast (show 0<b by omega)
    have hbka : (0:ℝ)<(b:ℝ)+k*a := by positivity
    have hden : 1+(k:ℝ)*(2-(2-(a:ℝ)/b))=((b:ℝ)+k*a)/b := by
      field_simp
      ring
    rw [hden]
    push_cast
    field_simp [hbR.ne',hbka.ne']
    <;> ring
  rwa [he] at hbound

/-- Conditional only: a genuine path-cone upper transfer in the stated range
would settle the original rational-exponent conjecture. -/
theorem rational_turan_of_path_cone_upper (hu : Upper) :
    ∀ α : ℚ, 1 ≤ α → α < 2 →
      ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
        Asymptotics.IsTheta Filter.atTop
          (fun n : ℕ => (extremalNumber n G : ℝ))
          (fun n : ℕ => (n : ℝ) ^ (α : ℝ)) := by
  let P : ℚ → Prop := fun δ => ∃ a b : ℕ, 1 ≤ a ∧ a ≤ b ∧
    δ=1-(a:ℚ)/b ∧ OrdinaryRooted.Certificate a b
  have hzero : P 0 := ⟨1,1,by omega,by omega,by norm_num,OrdinaryRooted.base_certificate⟩
  have hstep : ∀ k : ℕ, 1 ≤ k → ∀ δ : ℚ, 0 ≤ δ → (k:ℚ)*δ<1 →
      P δ → P (LongConeArithmetic.step k δ) := by
    intro k hk δ hδ hsmall hP
    obtain ⟨a,b,ha,hab,rfl,h⟩ := hP
    refine ⟨k*a,b+k*a,by nlinarith,by omega,?_,certificate hu h ha hab k hk hsmall⟩
    rw [LongConeArithmetic.parameter_identity a b k (by omega)]
    have hbka : (0:ℚ)<(b:ℚ)+k*a := by
      have hb : (0:ℚ)<b := by exact_mod_cast (show 0<b by omega)
      positivity
    push_cast
    field_simp
    ring
  intro α hα hα2
  obtain ⟨a,b,ha,hab,he,h⟩ := LongConeArithmetic.generate P hzero hstep (α-1) (by linarith) (by linarith)
  have hαeq : α=2-(a:ℚ)/b := by linarith
  rw [hαeq]
  exact h.realizes ha hab

end Erdos571.PathConeReduction


/-! Two-endpoint restrictions of the two-walk operator. -/
namespace Erdos571.CrossThirdOperator
open Finset SimpleGraph Matrix

section Rectangular
variable {I J : Type*} [Fintype I] [Fintype J]

lemma gram_rows (P : Matrix I J ℝ) (R C : ℝ) (hC : 0 ≤ C)
    (hP : ∀ i j, 0 ≤ P i j)
    (hr : ∀ i, ∑ j, P i j ≤ R) (hc : ∀ j, ∑ i, P i j ≤ C) :
    (∀ i k, 0 ≤ (P*P.transpose) i k) ∧
      ∀ i, ∑ k, (P*P.transpose) i k ≤ R*C := by
  constructor
  · intro i k
    exact sum_nonneg (fun j _ => mul_nonneg (hP i j) (hP k j))
  · intro i
    calc
      _ = ∑ j, P i j * ∑ k, P k j := by
        simp only [Matrix.mul_apply,Matrix.transpose_apply,mul_sum]
        exact sum_comm
      _ ≤ ∑ j, P i j*C := sum_le_sum (fun j _ => mul_le_mul_of_nonneg_left (hc j) (hP i j))
      _ = (∑ j, P i j)*C := (sum_mul ..).symm
      _ ≤ R*C := mul_le_mul_of_nonneg_right (hr i) hC

lemma schur (P : Matrix I J ℝ) (R C : ℝ) (hR : 0 ≤ R) (hC : 0 ≤ C)
    (hP : ∀ i j, 0 ≤ P i j)
    (hr : ∀ i, ∑ j, P i j ≤ R) (hc : ∀ j, ∑ i, P i j ≤ C) (f : J → ℝ) :
    (∑ i, (∑ j, P i j*f j)^2) ≤ R*C*∑ j, (f j)^2 := by
  obtain ⟨hn,hg⟩ := gram_rows P R C hC hP hr hc
  exact GramPin.row_gram_operator_bound P (R*C) (mul_nonneg hR hC) hn hg f

lemma square_mass (P : Matrix I J ℝ) (L R C : ℝ) (hL : 0 ≤ L)
    (hP : ∀ i j, 0 ≤ P i j ∧ P i j ≤ L)
    (hr : ∀ i, ∑ j, P i j ≤ R) (hc : ∀ j, ∑ i, P i j ≤ C) :
    GramPin.squareMass P ≤ L*min ((Fintype.card I:ℝ)*R) ((Fintype.card J:ℝ)*C) := by
  have hmass : (∑ i, ∑ j, P i j) ≤ min ((Fintype.card I:ℝ)*R) ((Fintype.card J:ℝ)*C) := by
    apply le_min
    · simpa only [sum_const,card_univ,nsmul_eq_mul] using sum_le_sum (fun i _ => hr i)
    · rw [sum_comm]
      simpa only [sum_const,card_univ,nsmul_eq_mul] using sum_le_sum (fun j _ => hc j)
  have hsq : GramPin.squareMass P ≤ L*∑ i, ∑ j, P i j := by
    simp only [GramPin.squareMass,mul_sum]
    exact sum_le_sum (fun i _ => sum_le_sum (fun j _ => by
      simpa only [pow_two] using mul_le_mul_of_nonneg_right (hP i j).2 (hP i j).1))
  exact hsq.trans (mul_le_mul_of_nonneg_left hmass hL)

end Rectangular

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

noncomputable def cut (u r : W) (T : ℝ) : Finset W :=
  (G.neighborFinset u).filter (fun x => ((G.adjMatrix ℝ)^3) r x ≤ T)

lemma mem_cut (u r x : W) (T : ℝ) :
    x∈cut G u r T ↔ G.Adj u x ∧ ((G.adjMatrix ℝ)^3) r x ≤ T := by
  simp only [cut,mem_filter,G.mem_neighborFinset]

lemma cut_subset (u r : W) (T : ℝ) : cut G u r T ⊆ G.neighborFinset u := filter_subset _ _

/-- The rows are cut using the other endpoint; the columns use the first
endpoint. Both directions of the Schur test therefore have bound `T`. -/
lemma masked_rows_cols (u r : W) (T : ℝ)
    (P : Matrix (cut G u r T) (cut G r u T) ℝ)
    (hP : ∀ x z, 0 ≤ P x z ∧ P x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val) :
    (∀ x, ∑ z, P x z ≤ T) ∧ (∀ z, ∑ x, P x z ≤ T) := by
  constructor
  · intro x
    calc
      _ ≤ ∑ z : cut G r u T, ((G.adjMatrix ℝ)^2) x.val z.val :=
        sum_le_sum (fun z _ => (hP x z).2)
      _ = ∑ z∈cut G r u T, ((G.adjMatrix ℝ)^2) x.val z := Finset.sum_coe_sort _ _
      _ ≤ ((G.adjMatrix ℝ)^3) r x.val :=
        LocalThirdOperator.square_row_on_neighbors G r x.val _ (cut_subset G r u T)
      _ ≤ T := ((mem_cut G u r x.val T).mp x.property).2
  · intro z
    calc
      _ ≤ ∑ x : cut G u r T, ((G.adjMatrix ℝ)^2) z.val x.val := by
        apply sum_le_sum
        intro x _
        exact (hP x z).2.trans_eq (((G.isSymm_adjMatrix (α:=ℝ)).pow 2).apply _ _)
      _ = ∑ x∈cut G u r T, ((G.adjMatrix ℝ)^2) z.val x := Finset.sum_coe_sort _ _
      _ ≤ ((G.adjMatrix ℝ)^3) u z.val :=
        LocalThirdOperator.square_row_on_neighbors G u z.val _ (cut_subset G u r T)
      _ ≤ T := ((mem_cut G r u z.val T).mp z.property).2

lemma masked_operator (u r : W) (T : ℝ) (hT : 0 ≤ T)
    (P : Matrix (cut G u r T) (cut G r u T) ℝ)
    (hP : ∀ x z, 0 ≤ P x z ∧ P x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val)
    (f : cut G r u T → ℝ) :
    (∑ x, (∑ z, P x z*f z)^2) ≤ T^2*∑ z, (f z)^2 := by
  obtain ⟨hr,hc⟩ := masked_rows_cols G u r T P hP
  simpa only [pow_two] using schur P T T hT hT (fun x z => (hP x z).1) hr hc f

lemma masked_square_mass (u r : W) (T L : ℝ) (hL : 0 ≤ L)
    (P : Matrix (cut G u r T) (cut G r u T) ℝ)
    (hP : ∀ x z, 0 ≤ P x z ∧ P x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val)
    (hcap : ∀ x z, P x z ≤ L) :
    GramPin.squareMass P ≤ L*T*min ((cut G u r T).card:ℝ) ((cut G r u T).card:ℝ) := by
  obtain ⟨hr,hc⟩ := masked_rows_cols G u r T P hP
  by_cases hT : 0 ≤ T
  · have h := square_mass P L T T hL (fun x z => ⟨(hP x z).1,hcap x z⟩) hr hc
    simpa only [Fintype.card_coe,←min_mul_of_nonneg _ _ hT,mul_assoc,mul_comm T] using h
  · have hempty : IsEmpty (cut G u r T) := ⟨fun x => by
      have hz : 0 ≤ ∑ z, P x z := sum_nonneg (fun z _ => (hP x z).1)
      exact hT (hz.trans (hr x))⟩
    letI := hempty
    have hcard : (cut G u r T).card=0 := by
      have h := Fintype.card_of_isEmpty (α:=cut G u r T)
      simpa only [Fintype.card_coe] using h
    simp only [GramPin.squareMass,Finset.univ_eq_empty,Finset.sum_empty,hcard,Nat.cast_zero]
    rw [min_eq_left (Nat.cast_nonneg _),mul_zero]


/-- The off-diagonal light two-walk matrix, on the cross-cut domains. -/
noncomputable def lightChannel (u r : W) (T L : ℝ) :
    Matrix (cut G u r T) (cut G r u T) ℝ := fun x z =>
  if x.val≠z.val ∧ ((G.adjMatrix ℝ)^2) x.val z.val≤L
    then ((G.adjMatrix ℝ)^2) x.val z.val else 0

lemma lightChannel_bounds (u r : W) (T L : ℝ) (hL : 0 ≤ L) :
    (∀ x z, 0 ≤ lightChannel G u r T L x z ∧
      lightChannel G u r T L x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val) ∧
    ∀ x z, lightChannel G u r T L x z ≤ L := by
  have hn (x z : W) : 0 ≤ ((G.adjMatrix ℝ)^2) x z :=
    Matrix.pow_apply_nonneg (LocalThirdOperator.adjacency_nonneg G) 2 x z
  constructor
  · intro x z
    dsimp [lightChannel]
    split_ifs <;> simp only [le_refl,hn,zero_le, and_self]
  · intro x z
    dsimp [lightChannel]
    split_ifs with h
    · exact h.2
    · exact hL

lemma lightChannel_operator (u r : W) (T L : ℝ) (hT : 0 ≤ T) (hL : 0 ≤ L)
    (f : cut G r u T → ℝ) :
    (∑ x, (∑ z, lightChannel G u r T L x z*f z)^2) ≤ T^2*∑ z, (f z)^2 :=
  masked_operator G u r T hT _ (lightChannel_bounds G u r T L hL).1 f

lemma lightChannel_square_mass (u r : W) (T L : ℝ) (hT : 0 ≤ T) (hL : 0 ≤ L) :
    GramPin.squareMass (lightChannel G u r T L) ≤ L*T*min (G.degree u:ℝ) (G.degree r:ℝ) := by
  obtain ⟨hp,hcap⟩ := lightChannel_bounds G u r T L hL
  have h := masked_square_mass G u r T L hL _ hp hcap
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (mul_nonneg hL hT)
  apply min_le_min
  · exact_mod_cast (by simpa only [G.card_neighborFinset_eq_degree] using
      Finset.card_le_card (cut_subset G u r T))
  · exact_mod_cast (by simpa only [G.card_neighborFinset_eq_degree] using
      Finset.card_le_card (cut_subset G r u T))

lemma masked_cross_conjugation (u r : W) (T : ℝ)
    (P Q : Matrix (cut G u r T) (cut G r u T) ℝ)
    (hP : ∀ x z, 0 ≤ P x z ∧ P x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val)
    (hQ : ∀ x z, 0 ≤ Q x z ∧ Q x z ≤ ((G.adjMatrix ℝ)^2) x.val z.val)
    (K : Matrix (cut G r u T) (cut G r u T) ℝ) :
    GramPin.squareMass (P*K*Q.transpose) ≤ T^4*GramPin.squareMass K := by
  by_cases hT : 0 ≤ T
  · obtain ⟨hpr,hpc⟩ := masked_rows_cols G u r T P hP
    obtain ⟨hqr,hqc⟩ := masked_rows_cols G u r T Q hQ
    obtain ⟨hnP,hrP⟩ := gram_rows P T T hT (fun x z => (hP x z).1) hpr hpc
    obtain ⟨hnQ,hrQ⟩ := gram_rows Q T T hT (fun x z => (hQ x z).1) hqr hqc
    have hleft := GramPin.squareMass_mul_left_le P K (T*T) (mul_self_nonneg T) hnP hrP
    have hright := GramPin.squareMass_mul_right_le (P*K) Q.transpose (T*T) (mul_self_nonneg T)
      (by simpa only [Matrix.transpose_transpose] using hnQ)
      (by simpa only [Matrix.transpose_transpose] using hrQ)
    exact hright.trans ((mul_le_mul_of_nonneg_left hleft (mul_self_nonneg T)).trans_eq (by ring))
  · have hr := (masked_rows_cols G u r T P hP).1
    letI : IsEmpty (cut G u r T) := ⟨fun x => hT ((sum_nonneg (fun z _ => (hP x z).1)).trans (hr x))⟩
    simp only [GramPin.squareMass,Finset.univ_eq_empty,Finset.sum_empty]
    positivity

/-- Only an actual strong-copy third-walk bound is used. -/
lemma strong_copy_mem {V : Type} (H : SimpleGraph V) (L D : ℝ)
    (f : StrongPinnedCopies.RoleFamily H G L D) {a b x : V}
    (hax : H.Adj a x) (hbx : b≠x) :
    f.val x∈cut G (f.val a) (f.val b) (L*D) :=
  (mem_cut G _ _ _ _).mpr ⟨f.val.toHom.map_adj hax,(f.property b x hbx).2⟩

end Erdos571.CrossThirdOperator

namespace Erdos571.StrongCopyPins
open Finset SimpleGraph CrossThirdOperator
variable {A R W : Type} [Fintype A] [Fintype R] [Fintype W]
variable [DecidableEq A] [DecidableEq R] [DecidableEq W]
variable (H : SimpleGraph (A⊕R)) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma cross_cut_left (L : ℕ) (D : ℝ) (a : A) (r : R)
    (p : Family H G L D a) {x : A⊕R} (hax : H.Adj (.inl a) x) (hrx : .inr r≠x) :
    p.val.1.val x∈CrossThirdOperator.cut G (p.val.1.val (.inl a)) (p.val.1.val (.inr r)) (L*D) :=
  strong_copy_mem G H L D p.val.1 hax hrx

/-- Both copies use the very same pair of cuts, because both endpoints agree.
This does not assert a third-walk cap between arbitrary cross-copy roles. -/
lemma cross_cut_right (L : ℕ) (D : ℝ) (a : A) (r : R)
    (p : Family H G L D a) {x : A⊕R} (hax : H.Adj (.inl a) x) (hrx : .inr r≠x) :
    p.val.2.val x∈CrossThirdOperator.cut G (p.val.1.val (.inl a)) (p.val.1.val (.inr r)) (L*D) := by
  rw [p.property.2.1,p.property.1 r]
  exact strong_copy_mem G H L D p.val.2 hax hrx

lemma reverse_cut_left (L : ℕ) (D : ℝ) (a : A) (r : R)
    (p : Family H G L D a) {z : A⊕R} (hrz : H.Adj (.inr r) z) (haz : .inl a≠z) :
    p.val.1.val z∈CrossThirdOperator.cut G (p.val.1.val (.inr r)) (p.val.1.val (.inl a)) (L*D) :=
  strong_copy_mem G H L D p.val.1 hrz haz

lemma reverse_cut_right (L : ℕ) (D : ℝ) (a : A) (r : R)
    (p : Family H G L D a) {z : A⊕R} (hrz : H.Adj (.inr r) z) (haz : .inl a≠z) :
    p.val.2.val z∈CrossThirdOperator.cut G (p.val.1.val (.inr r)) (p.val.1.val (.inl a)) (L*D) := by
  rw [p.property.2.1,p.property.1 r]
  exact strong_copy_mem G H L D p.val.2 hrz haz

lemma cross_light_channel (L : ℕ) (D : ℝ) (a : A) (r : R)
    (p : Family H G L D a) {x z : A⊕R}
    (hax : H.Adj (.inl a) x) (hrx : .inr r≠x)
    (hrz : H.Adj (.inr r) z) (haz : .inl a≠z)
    (hne : p.val.1.val x≠p.val.2.val z) :
    lightChannel G (p.val.1.val (.inl a)) (p.val.1.val (.inr r)) (L*D) L
      ⟨p.val.1.val x,cross_cut_left H G L D a r p hax hrx⟩
      ⟨p.val.2.val z,reverse_cut_right H G L D a r p hrz haz⟩ =
        ((G.adjMatrix ℝ)^2) (p.val.1.val x) (p.val.2.val z) := by
  exact if_pos ⟨hne,cross_two H G L D a p x z hne⟩

end Erdos571.StrongCopyPins

/-! Actual four-walk channels with all relevant codegrees light. The local
trace bound becomes a signed operator estimate, without a global cap. -/
namespace Erdos571.LightFourChannel
open Finset SimpleGraph Matrix LocalFourthWalk
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

noncomputable def middles (u r : W) (L : ℕ) (x z : W) : Finset W := by
  classical
  exact (common G x z).filter (fun v => v≠u ∧ v≠r ∧
    (common G u v).card≤L ∧ (common G r v).card≤L ∧ x≠z ∧ (common G x z).card≤L)

lemma mem_middles (u r : W) (L : ℕ) (x z v : W) :
    v∈middles G u r L x z ↔ G.Adj x v ∧ G.Adj z v ∧ v≠u ∧ v≠r ∧
      (common G u v).card≤L ∧ (common G r v).card≤L ∧ x≠z ∧ (common G x z).card≤L := by
  classical
  simp only [middles,mem_filter,mem_common]
  tauto

lemma middles_cap (u r : W) (L : ℕ) (x z : W) : (middles G u r L x z).card≤L := by
  classical
  by_cases h : (middles G u r L x z).Nonempty
  · obtain ⟨v,hv⟩ := h
    exact (card_le_card (filter_subset _ _)).trans ((mem_filter.mp hv).2.2.2.2.2.2)
  · rw [not_nonempty_iff_eq_empty.mp h,card_empty]
    exact Nat.zero_le _

lemma middles_two (u r : W) (L : ℕ) (x z : W) :
    ((middles G u r L x z).card:ℝ)≤((G.adjMatrix ℝ)^2) x z := by
  classical
  have h : (middles G u r L x z).card≤(common G x z).card := card_le_card (filter_subset _ _)
  rw [pow_two,LayeredBush.adjacency_square_common_card,←common_card]
  exact_mod_cast h

noncomputable def matrix (u r : W) (T : ℝ) (L : ℕ) :
    Matrix (CrossThirdOperator.cut G u r T) (CrossThirdOperator.cut G r u T) ℝ :=
  fun x z => (middles G u r L x.val z.val).card

lemma bounds (u r : W) (T : ℝ) (L : ℕ) :
    (∀ x z, 0 ≤ matrix G u r T L x z ∧
      matrix G u r T L x z≤((G.adjMatrix ℝ)^2) x.val z.val) ∧
    ∀ x z, matrix G u r T L x z≤L := by
  refine ⟨fun x z => ⟨Nat.cast_nonneg _,middles_two G u r L x.val z.val⟩,?_⟩
  intro x z
  change ((middles G u r L x.val z.val).card:ℝ) ≤ L
  exact_mod_cast middles_cap G u r L x.val z.val

/-- The sum of the channel entries counts a subfamily of the previously
formalized all-light four-walks. No factorization of a pin family is asserted. -/
lemma mass_le (u r : W) (T : ℝ) (L : ℕ) :
    (∑ x, ∑ z, matrix G u r T L x z) ≤ (LocalMaskedTrace.maskedWalks G L u r).card := by
  classical
  let F := (x : CrossThirdOperator.cut G u r T) ×
    (z : CrossThirdOperator.cut G r u T) × middles G u r L x.val z.val
  let φ : F → LocalMaskedTrace.maskedWalks G L u r := fun p =>
    ⟨((p.1.val,p.2.1.val),p.2.2.val),by
      obtain ⟨hxv,hzv,hvu,hvr,huv,hrv,hxz,hc⟩ :=
        (mem_middles G u r L _ _ _).mp p.2.2.property
      apply mem_filter.mpr
      refine ⟨(mem_walks G u r _).mpr ⟨?_,hxv,hzv.symm,?_⟩,hvu,hvr,huv,hrv,Or.inr hc⟩
      · exact ((CrossThirdOperator.mem_cut G u r p.1.val T).mp p.1.property).1
      · exact ((CrossThirdOperator.mem_cut G r u p.2.1.val T).mp p.2.1.property).1.symm⟩
  have hi : Function.Injective φ := by
    rintro ⟨x,z,v⟩ ⟨x',z',v'⟩ h
    have he := congrArg Subtype.val h
    have hx : x=x' := Subtype.ext (congrArg (fun p : (W×W)×W => p.1.1) he)
    have hz : z=z' := Subtype.ext (congrArg (fun p : (W×W)×W => p.1.2) he)
    subst x' z'
    have hv : v=v' := Subtype.ext (congrArg (fun p : (W×W)×W => p.2) he)
    subst v'
    rfl
  have hc : (Nat.card F:ℝ)≤(Nat.card (LocalMaskedTrace.maskedWalks G L u r):ℝ) := by
    exact_mod_cast Nat.card_le_card_of_injective φ hi
  simpa only [F,Nat.card_eq_fintype_card,Fintype.card_sigma,Fintype.card_coe,Nat.cast_sum,matrix] using hc

lemma square_mass_le (u r : W) (T : ℝ) (L : ℕ) :
    GramPin.squareMass (matrix G u r T L) ≤ (L:ℝ)*(LocalMaskedTrace.maskedWalks G L u r).card := by
  obtain ⟨hp,hcap⟩ := bounds G u r T L
  have hsq : GramPin.squareMass (matrix G u r T L)≤(L:ℝ)*∑ x, ∑ z, matrix G u r T L x z := by
    simp only [GramPin.squareMass,mul_sum]
    exact sum_le_sum (fun x _ => sum_le_sum (fun z _ => by
      simpa only [pow_two] using mul_le_mul_of_nonneg_right (hcap x z) (hp x z).1))
  exact hsq.trans (mul_le_mul_of_nonneg_left (mass_le G u r T L) (Nat.cast_nonneg _))

lemma operator_le (u r : W) (T : ℝ) (L : ℕ)
    (f : CrossThirdOperator.cut G r u T → ℝ) :
    (∑ x, (∑ z, matrix G u r T L x z*f z)^2) ≤
      ((L:ℝ)*(LocalMaskedTrace.maskedWalks G L u r).card)*∑ z, (f z)^2 := by
  have hh : (∑ x, (∑ z, matrix G u r T L x z*f z)^2) ≤
      GramPin.squareMass (matrix G u r T L)*∑ z, (f z)^2 := by
    simpa only [GramPin.squareMass,Finset.sum_mul] using
      sum_le_sum (fun x (_ : x∈univ) => sum_mul_sq_le_sq_mul_sq univ (matrix G u r T L x) f)
  exact hh.trans (mul_le_mul_of_nonneg_right (square_mass_le G u r T L) (sum_nonneg (fun z _ => sq_nonneg _)))

/-- Further restrictions can delete arbitrary middle choices in each matrix
entry. Signed test vectors are still allowed. -/
lemma dominated_operator_le (u r : W) (T : ℝ) (L : ℕ)
    (P : Matrix (CrossThirdOperator.cut G u r T) (CrossThirdOperator.cut G r u T) ℝ)
    (hP : ∀ x z, 0≤P x z ∧ P x z ≤ matrix G u r T L x z)
    (f : CrossThirdOperator.cut G r u T → ℝ) :
    (∑ x, (∑ z, P x z*f z)^2) ≤
      ((L:ℝ)*(LocalMaskedTrace.maskedWalks G L u r).card)*∑ z, (f z)^2 := by
  have hs : GramPin.squareMass P ≤ GramPin.squareMass (matrix G u r T L) := by
    apply sum_le_sum
    intro x _
    exact sum_le_sum (fun z _ => pow_le_pow_left₀ (hP x z).1 (hP x z).2 2)
  have hh : (∑ x, (∑ z, P x z*f z)^2) ≤ GramPin.squareMass P*∑ z, (f z)^2 := by
    simpa only [GramPin.squareMass,Finset.sum_mul] using
      sum_le_sum (fun x (_ : x∈univ) => sum_mul_sq_le_sq_mul_sq univ (P x) f)
  exact hh.trans (mul_le_mul_of_nonneg_right (hs.trans (square_mass_le G u r T L))
    (sum_nonneg (fun z _ => sq_nonneg _)))

/-- Nonnegative weights bounded by B, including constraints depending on all
three internal roles, produce a matrix bounded by B times the full channel. -/
lemma bounded_middle_weight (u r : W) (T : ℝ) (L : ℕ) (B : ℝ)
    (w : W → W → W → ℝ)
    (hw : ∀ x z v, v∈middles G u r L x z → 0≤w x z v ∧ w x z v≤B)
    (x : CrossThirdOperator.cut G u r T) (z : CrossThirdOperator.cut G r u T) :
    0≤(∑ v∈middles G u r L x.val z.val, w x.val z.val v) ∧
      (∑ v∈middles G u r L x.val z.val, w x.val z.val v)≤B*matrix G u r T L x z := by
  constructor
  · exact sum_nonneg (fun v hv => (hw x.val z.val v hv).1)
  · simpa only [sum_const,nsmul_eq_mul,mul_comm B,matrix] using
      sum_le_sum (fun v hv => (hw x.val z.val v hv).2)

variable {V : Type} [Fintype V]

/-- Actual subdivision freeness provides a subquadratic squared operator
bound whenever the old exponent is below two. -/
theorem operator_bound (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C : ℝ} (hα : 0≤α) (hC : 0≤C) (hbound : ProjectionHeavy.EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hb : G.IsBipartite)
    (L D : ℕ) (hdeg : ∀ x, G.degree x≤D) (u r : W) (T : ℝ)
    (hcap : (common G u r).card≤L) (f : CrossThirdOperator.cut G r u T → ℝ) :
    (∑ x, (∑ z, matrix G u r T L x z*f z)^2) ≤
      ((L:ℝ)*(2*(L+(2*L)^2:ℕ)*C*(2*(D:ℝ))^α+(L:ℝ)*D))*∑ z, (f z)^2 := by
  have h := LocalMaskedTrace.off_diagonal_bound G H hH hα hC hbound hf
    (LocalFourthWalk.triangle_free_of_bipartite G hb) L D hdeg u r hcap
  exact (operator_le G u r T L f).trans
    (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h (Nat.cast_nonneg _))
      (sum_nonneg (fun z _ => sq_nonneg _)))

omit [Fintype V] in
/-- Membership is supplied by an actual pairwise-strong copy, including
all the distinct-role hypotheses required by the four-walk channel. -/
lemma strong_middle (H : SimpleGraph V) (L : ℕ) (D : ℝ)
    (f : StrongPinnedCopies.RoleFamily H G L D) {a x v z r : V}
    (hxv : H.Adj x v) (hzv : H.Adj z v)
    (hva : v≠a) (hvr : v≠r) (hxz : x≠z) :
    f.val v∈middles G (f.val a) (f.val r) L (f.val x) (f.val z) := by
  have hnat (b c : V) (hbc : b≠c) : (common G (f.val b) (f.val c)).card≤L := by
    have h := (f.property b c hbc).1
    have hh : ((common G (f.val b) (f.val c)).card:ℝ) ≤ L := by
      simpa only [pow_two,LayeredBush.adjacency_square_common_card,common_card] using h
    exact_mod_cast hh
  exact (mem_middles G _ _ _ _ _ _).mpr ⟨f.val.toHom.map_adj hxv,f.val.toHom.map_adj hzv,
    f.val.injective.ne hva,f.val.injective.ne hvr,hnat a v hva.symm,hnat r v hvr.symm,
    f.val.injective.ne hxz,hnat x z hxz⟩

end Erdos571.LightFourChannel

/-! A uniform subquadratic operator bound for actual light four-walk channels
in ThreeHub-free hosts. This is not yet a bound for the full pin energy. -/
namespace Erdos571.ThreeHub
open Finset SimpleGraph Matrix ProjectionHeavy

/-- No global codegree assumption: the endpoint cap is local, and every
other necessary cap is part of `LightFourChannel.middles`. -/
theorem light_channel_operator (s M : ℕ) (hs : 1 ≤ s) (L : ℕ) (Q : ℝ) (hQ : 0 ≤ Q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], (graph s M).Free G → G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ x, (G.degree x:ℝ) ≤ Q*d) →
      ∀ u r : W, Fintype.card (G.commonNeighbors u r) ≤ L → ∀ T : ℝ,
      ∀ P : Matrix (CrossThirdOperator.cut G u r T) (CrossThirdOperator.cut G r u T) ℝ,
      (∀ x z, 0≤P x z ∧ P x z≤LightFourChannel.matrix G u r T L x z) →
      ∀ f : CrossThirdOperator.cut G r u T → ℝ,
        (∑ x, (∑ z, P x z*f z)^2) ≤
          C*d^(2-1/(2*(s:ℝ)+1))*∑ z, (f z)^2 := by
  obtain ⟨B,hB,hbound⟩ := uniform_base_edge_bound s (M+1) hs
  let α : ℝ := 2-1/(2*(s:ℝ)+1)
  let C₀ : ℝ := 2*(L+(2*L)^2:ℕ)*B*(2*Q)^α+(L:ℝ)*Q
  refine ⟨(L:ℝ)*C₀,by dsimp [C₀]; positivity,?_⟩
  intro W _ _ G _ hf hb d hd hdeg u r hcap T P hP f
  have hd0 : 0<d := by linarith
  have h := LocalMaskedTrace.normalized_bound _ (base_power_no_isolated s M)
    (uniform_base_exponent_bounds s).1 hB hbound G (subdivision_free s M G hf) hb
    L d Q hd hQ hdeg u r hcap
  change (LocalMaskedTrace.maskedWalks G L u r).card/d^2 ≤ C₀*d^(α-2) at h
  have hcard : ((LocalMaskedTrace.maskedWalks G L u r).card:ℝ) ≤ C₀*d^α := by
    have h' := (div_le_iff₀ (sq_pos_of_pos hd0)).mp h
    have he : d^(α-2)*d^2=d^α := by
      rw [←Real.rpow_natCast,←Real.rpow_add hd0]
      congr 1
      norm_num
    simpa only [mul_assoc,he] using h'
  have hcoef : (L:ℝ)*(LocalMaskedTrace.maskedWalks G L u r).card ≤ (L:ℝ)*C₀*d^α := by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hcard (Nat.cast_nonneg L)
  exact (LightFourChannel.dominated_operator_le G u r T L P hP f).trans
    (mul_le_mul_of_nonneg_right hcoef (sum_nonneg (fun z _ => sq_nonneg _)))

end Erdos571.ThreeHub

namespace Erdos571.StrongCopyPins
open Finset SimpleGraph
variable {A R W : Type} [Fintype W] [DecidableEq W]
variable (H : SimpleGraph (A⊕R)) (G : SimpleGraph W) [DecidableRel G.Adj]

lemma pin_root_common_le (L : ℕ) (D : ℝ) (a : A) (r : R) (p : Family H G L D a) :
    Fintype.card (G.commonNeighbors (p.val.1.val (.inl a)) (p.val.1.val (.inr r))) ≤ L := by
  have h := (p.val.1.property (.inl a) (.inr r) (by simp)).1
  have hh : (Fintype.card (G.commonNeighbors (p.val.1.val (.inl a)) (p.val.1.val (.inr r))):ℝ) ≤ L := by
    simpa only [pow_two,LayeredBush.adjacency_square_common_card] using h
  exact_mod_cast hh

end Erdos571.StrongCopyPins


/-! Pruning by the relative mass of a good family in each root fiber.
This lemma compares energies only on the retained root mask; it does not
assert that any analytic pin bound is stable under such a mask. -/
namespace Erdos571.RootFiberPruning
open Finset
variable {R : Type*} [Fintype R]

noncomputable def retained (a b : R → ℝ) (κ : ℝ) : Finset R := by
  classical
  exact univ.filter (fun r => κ * a r ≤ b r)

lemma mem_retained (a b : R → ℝ) (κ : ℝ) (r : R) :
    r ∈ retained a b κ ↔ κ * a r ≤ b r := by
  classical
  simp [retained]

open Classical in
lemma discarded_mass (a b : R → ℝ) (κ : ℝ)
    (ha : ∀ r, 0 ≤ a r) (hκ : 0 ≤ κ) :
    ∑ r ∈ univ \ retained a b κ, b r ≤ κ * ∑ r, a r := by
  classical
  calc
    _ ≤ ∑ r ∈ univ \ retained a b κ, κ * a r := by
      apply sum_le_sum
      intro r hr
      exact le_of_lt (lt_of_not_ge ((not_congr (mem_retained a b κ r)).mp
        (Finset.mem_sdiff.mp hr).2))
    _ ≤ ∑ r, κ * a r := sum_le_sum_of_subset_of_nonneg
      (subset_univ _) (fun r _ _ => mul_nonneg hκ (ha r))
    _ = _ := (mul_sum ..).symm

lemma retained_mass (a b : R → ℝ) (κ : ℝ)
    (ha : ∀ r, 0 ≤ a r) (hκ : 0 ≤ κ) :
    (∑ r, b r) - κ * ∑ r, a r ≤ ∑ r ∈ retained a b κ, b r := by
  classical
  have h := discarded_mass a b κ ha hκ
  have he := sum_sdiff (subset_univ (retained a b κ)) (f := b)
  linarith

lemma retained_moment (a b : R → ℝ) (κ : ℝ) (k : ℕ)
    (ha : ∀ r, 0 ≤ a r) (hκ : 0 ≤ κ) :
    κ^k * ∑ r ∈ retained a b κ, (a r)^k ≤
      ∑ r ∈ retained a b κ, (b r)^k := by
  classical
  rw [mul_sum]
  apply sum_le_sum
  intro r hr
  rw [← mul_pow]
  exact pow_le_pow_left₀ (mul_nonneg hκ (ha r))
    ((mem_retained a b κ r).mp hr) k

lemma half_mass (a b : R → ℝ) (κ B U : ℝ)
    (ha : ∀ r, 0 ≤ a r) (hκ : 0 ≤ κ)
    (hb : B ≤ ∑ r, b r) (hu : ∑ r, a r ≤ U) (hcut : κ * U ≤ B/2) :
    B/2 ≤ ∑ r ∈ retained a b κ, b r := by
  have h := retained_mass a b κ ha hκ
  have hh := mul_le_mul_of_nonneg_left hu hκ
  linarith

variable (F H : R → Type*) [∀ r, Fintype (F r)] [∀ r, Fintype (H r)]

noncomputable def count (F : R → Type*) [∀ r, Fintype (F r)] (r : R) : ℝ :=
  Nat.card (F r)

noncomputable def roots (κ : ℝ) : Finset R := retained (count F) (count H) κ

abbrev Masked (J : Finset R) := (r : J) × F r.val
abbrev MaskedAgreement (J : Finset R) :=
  FiberRestrictionEnergy.Agreement (fun r : J => F r.val)

open Classical in
lemma masked_card (J : Finset R) :
    (Nat.card (Masked F J) : ℝ) = ∑ r ∈ J, count F r := by
  simp only [Masked, Nat.card_eq_fintype_card, Fintype.card_sigma, Nat.cast_sum, count]
  simp only [← Finset.sum_attach J (fun r => (Fintype.card (F r) : ℝ))]
  rfl

open Classical in
lemma masked_agreement_card (J : Finset R) :
    (Nat.card (MaskedAgreement F J) : ℝ) = ∑ r ∈ J, (count F r)^2 := by
  rw [Nat.card_eq_fintype_card, Fintype.card_congr
    (FiberRestrictionEnergy.agreementEquiv (fun r : J => F r.val))]
  simp only [Fintype.card_sigma, Fintype.card_prod, Nat.cast_sum, Nat.cast_mul,
    count, Nat.card_eq_fintype_card, pow_two]
  simp only [← Finset.sum_attach J (fun r => (Fintype.card (F r) : ℝ) * Fintype.card (F r))]
  rfl

lemma count_nonneg (r : R) : 0 ≤ count F r := Nat.cast_nonneg _

lemma card_mass (κ : ℝ) (hκ : 0 ≤ κ) :
    (Nat.card (Sigma H) : ℝ) - κ * Nat.card (Sigma F) ≤
      Nat.card (Masked H (roots F H κ)) := by
  classical
  rw [masked_card]
  have h := retained_mass (count F) (count H) κ (count_nonneg F) hκ
  simpa only [roots, count, Nat.card_eq_fintype_card, Fintype.card_sigma,
    Nat.cast_sum] using h

lemma card_energy (κ : ℝ) (hκ : 0 ≤ κ) :
    κ^2 * (Nat.card (MaskedAgreement F (roots F H κ)) : ℝ) ≤
      Nat.card (MaskedAgreement H (roots F H κ)) := by
  rw [masked_agreement_card, masked_agreement_card]
  exact retained_moment (count F) (count H) κ 2 (count_nonneg F) hκ

lemma card_half_mass (κ B U : ℝ) (hκ : 0 ≤ κ)
    (hb : B ≤ (Nat.card (Sigma H) : ℝ))
    (hu : (Nat.card (Sigma F) : ℝ) ≤ U) (hcut : κ * U ≤ B/2) :
    B/2 ≤ (Nat.card (Masked H (roots F H κ)) : ℝ) := by
  have h := card_mass F H κ hκ
  have hh := mul_le_mul_of_nonneg_left hu hκ
  linarith

end Erdos571.RootFiberPruning

/-! Inverting the assignment-to-homomorphism map on homomorphisms whose
terminal arms are light. Strong injective copies are included. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ) (hs : 1 ≤ s)

abbrev leafIndex (i : Fin 3) (j : Fin s) : ThreeHub.BaseRoot s :=
  ⟨i,(finCongr (ThreeHub.counts_eq s hs i)).symm j⟩

def extractHub (f : ThreeHub.template s →g G) (i : Fin 3) : W :=
  f (RootedSubdivision.old (ThreeHub.base s) (.inl i))
def extractRoot (f : ThreeHub.template s →g G) (i : Fin 3) (j : Fin s) : W :=
  f (RootedSubdivision.old (ThreeHub.base s) (.inr (leafIndex s hs i j)))
noncomputable def extractMiddle (f : ThreeHub.template s →g G)
    (i : BalancedTree.EdgeIndex (ThreeHub.counts s)) : W :=
  f (RootedSubdivision.middle (ThreeHub.base s) (BalancedTree.edge i))

def ArmsLight (f : ThreeHub.template s →g G) : Prop :=
  ∀ i j, MaskedBush.Light G L (extractHub G s f i) (extractRoot G s hs f i j)

lemma extract_incidence (f : ThreeHub.template s →g G)
    (i : BalancedTree.EdgeIndex (ThreeHub.counts s))
    (v : Fin 3 ⊕ ThreeHub.BaseRoot s) (hv : v ∈ (BalancedTree.edge i).val) :
    G.Adj (f (RootedSubdivision.old (ThreeHub.base s) v)) (extractMiddle G s f i) :=
  f.map_adj ((RootedSubdivision.adj_old_middle (ThreeHub.base s) v _).mpr hv)

noncomputable def extractBundle (f : ThreeHub.template s →g G)
    (h : ArmsLight G L s hs f) (i : Fin 3) :
    Bundle G L s (extractHub G s f i) (extractRoot G s hs f i) := fun j =>
  ⟨⟨h i j⟩, extractMiddle G s f (.inr (leafIndex s hs i j)),
    extract_incidence G s f _ _ (by simp [BalancedTree.edge]),
    extract_incidence G s f _ _ (by simp [BalancedTree.edge])⟩

noncomputable def fromHom (f : ThreeHub.template s →g G)
    (h : ArmsLight G L s hs f) : Full G L s :=
  ⟨⟨extractRoot G s hs f 1,extractRoot G s hs f 0,extractRoot G s hs f 2⟩,
    extractHub G s f 1,extractBundle G L s hs f h 1,
    ⟨extractHub G s f 0,
      ⟨extractMiddle G s f (.inl 0),
        extract_incidence G s f _ _ (by simp [BalancedTree.edge]),
        extract_incidence G s f _ _ (by simp [BalancedTree.edge])⟩,
      extractBundle G L s hs f h 0⟩,
    ⟨extractHub G s f 2,
      ⟨extractMiddle G s f (.inl 1),
        extract_incidence G s f _ _ (by simp [BalancedTree.edge]),
        extract_incidence G s f _ _ (by simp [BalancedTree.edge])⟩,
      extractBundle G L s hs f h 2⟩⟩

lemma fromHom_hub (f : ThreeHub.template s →g G)
    (h : ArmsLight G L s hs f) (i : Fin 3) :
    hubValue G L s (fromHom G L s hs f h) i=extractHub G s f i := by
  fin_cases i <;> simp [hubValue,fromHom]

lemma fromHom_label (f : ThreeHub.template s →g G)
    (h : ArmsLight G L s hs f) (i : Fin 3) :
    labelAt G L s (fromHom G L s hs f h) i=extractRoot G s hs f i := by
  fin_cases i <;> simp [labelAt,fromHom]

lemma fromHom_edgeIndex (f : ThreeHub.template s →g G)
    (h : ArmsLight G L s hs f) (i : BalancedTree.EdgeIndex (ThreeHub.counts s)) :
    edgeIndexValue G L s hs (fromHom G L s hs f h) i=extractMiddle G s f i := by
  rcases i with i | ⟨i,j⟩
  · fin_cases i <;> simp [edgeIndexValue,coreMiddle,fromHom]
  · fin_cases i <;>
      simp [edgeIndexValue,bundleAt,fromHom,extractBundle,MaskedBush.middle,leafIndex]

lemma hom_fromHom (f : ThreeHub.template s →g G)
    (h : ArmsLight G L s hs f) : hom G L s hs (fromHom G L s hs f h)=f := by
  ext v
  have ho (w : Fin 3 ⊕ ThreeHub.BaseRoot s) :
      hom G L s hs (fromHom G L s hs f h) (RootedSubdivision.old (ThreeHub.base s) w)=
        f (RootedSubdivision.old (ThreeHub.base s) w) := by
    rw [hom_old]
    rcases w with i | ⟨i,j⟩
    · exact fromHom_hub G L s hs f h i
    · simp only [oldValue,Sum.elim_inr,rootValue,fromHom_label,extractRoot,leafIndex,
        Equiv.symm_apply_apply]
  have hm (e : (ThreeHub.base s).edgeSet) :
      hom G L s hs (fromHom G L s hs f h) (RootedSubdivision.middle (ThreeHub.base s) e)=
        f (RootedSubdivision.middle (ThreeHub.base s) e) := by
    obtain ⟨i,rfl⟩ := BalancedTree.edge_surjective e
    rw [hom_middle,edgeValue_edge,fromHom_edgeIndex]
    rfl
  rcases v with (i|e)|(r|e)
  · exact ho (.inl i)
  · simpa only [RootedSubdivision.middle_petal] using hm e.val
  · exact ho (.inr r)
  · exact (rootEdge_false s e).elim

lemma extractHub_hom (p : Full G L s) (i : Fin 3) :
    extractHub G s (hom G L s hs p) i=hubValue G L s p i :=
  hom_old G L s hs p (.inl i)

lemma extractRoot_hom (p : Full G L s) (i : Fin 3) (j : Fin s) :
    extractRoot G s hs (hom G L s hs p) i j=labelAt G L s p i j := by
  simp only [extractRoot,hom_old,oldValue,Sum.elim_inr,rootValue,leafIndex,
    Equiv.apply_symm_apply]

lemma extractMiddle_hom (p : Full G L s)
    (i : BalancedTree.EdgeIndex (ThreeHub.counts s)) :
    extractMiddle G s (hom G L s hs p) i=edgeIndexValue G L s hs p i := by
  rw [extractMiddle,hom_middle,edgeValue_edge]

lemma armsLight_hom (p : Full G L s) : ArmsLight G L s hs (hom G L s hs p) := by
  intro i j
  rw [extractHub_hom,extractRoot_hom]
  exact MaskedBush.arm_light G L (bundleAt G L s p i j)

lemma hom_injective : Function.Injective (hom G L s hs) := by
  intro p q hpq
  have hh (i : Fin 3) : hubValue G L s p i=hubValue G L s q i := by
    rw [←extractHub_hom G L s hs,←extractHub_hom G L s hs,hpq]
  have hr (i : Fin 3) (j : Fin s) : labelAt G L s p i j=labelAt G L s q i j := by
    rw [←extractRoot_hom G L s hs,←extractRoot_hom G L s hs,hpq]
  have hm (i : BalancedTree.EdgeIndex (ThreeHub.counts s)) :
      edgeIndexValue G L s hs p i=edgeIndexValue G L s hs q i := by
    rw [←extractMiddle_hom G L s hs,←extractMiddle_hom G L s hs,hpq]
  rcases p with ⟨⟨rC,rL,rR⟩,c,bC,⟨l,mL,bL⟩,r,mR,bR⟩
  rcases q with ⟨⟨rC',rL',rR'⟩,c',bC',⟨l',mL',bL'⟩,r',mR',bR'⟩
  have hc : c=c' := by simpa [hubValue] using hh 1
  have hl : l=l' := by simpa [hubValue] using hh 0
  have hr' : r=r' := by simpa [hubValue] using hh 2
  have hcR : rC=rC' := funext (fun j => by simpa [labelAt] using hr 1 j)
  have hlR : rL=rL' := funext (fun j => by simpa [labelAt] using hr 0 j)
  have hrR : rR=rR' := funext (fun j => by simpa [labelAt] using hr 2 j)
  subst c' l' r' rC' rL' rR'
  have hml : mL=mL' := Subtype.ext (by simpa [edgeIndexValue,coreMiddle] using hm (.inl 0))
  have hmr : mR=mR' := Subtype.ext (by simpa [edgeIndexValue,coreMiddle] using hm (.inl 1))
  have hbc : bC=bC' := by
    funext j
    apply MaskedBush.arm_ext G L
    simpa [edgeIndexValue,bundleAt,leafIndex] using hm (.inr (leafIndex s hs 1 j))
  have hbl : bL=bL' := by
    funext j
    apply MaskedBush.arm_ext G L
    simpa [edgeIndexValue,bundleAt,leafIndex] using hm (.inr (leafIndex s hs 0 j))
  have hbr : bR=bR' := by
    funext j
    apply MaskedBush.arm_ext G L
    simpa [edgeIndexValue,bundleAt,leafIndex] using hm (.inr (leafIndex s hs 2 j))
  subst mL' mR' bC' bL' bR'
  rfl

lemma fromHom_hom (p : Full G L s) :
    fromHom G L s hs (hom G L s hs p) (armsLight_hom G L s hs p)=p :=
  hom_injective G L s hs (hom_fromHom G L s hs _ _)

lemma roots_eq_iff (p q : Full G L s) :
    p.1=q.1 ↔ ∀ r : RootedSubdivision.Root (ThreeHub.base s),
      hom G L s hs p (.inr r)=hom G L s hs q (.inr r) := by
  refine ⟨same_roots G L s hs p q,?_⟩
  intro h
  have hh (i : Fin 3) (j : Fin s) : labelAt G L s p i j=labelAt G L s q i j := by
    rw [←extractRoot_hom G L s hs,←extractRoot_hom G L s hs]
    exact h (.inl (leafIndex s hs i j))
  apply Prod.ext
  · exact funext (fun j => by simpa [labelAt] using hh 1 j)
  · apply Prod.ext
    · exact funext (fun j => by simpa [labelAt] using hh 0 j)
    · exact funext (fun j => by simpa [labelAt] using hh 2 j)

variable (D : ℝ)

lemma strong_armsLight
    (f : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D) :
    ArmsLight G L s hs f.val.toHom := by
  intro i j
  have hne : RootedSubdivision.old (ThreeHub.base s) (.inl i) ≠
      RootedSubdivision.old (ThreeHub.base s) (.inr (leafIndex s hs i j)) :=
    (RootedSubdivision.old_injective (ThreeHub.base s)).ne (by simp)
  refine ⟨f.val.injective.ne hne,?_⟩
  simpa only [pow_two] using (f.property _ _ hne).1

noncomputable def fromStrong
    (f : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D) : Full G L s :=
  fromHom G L s hs f.val.toHom (strong_armsLight G L s hs D f)

lemma hom_fromStrong
    (f : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D) :
    hom G L s hs (fromStrong G L s hs D f)=f.val.toHom :=
  hom_fromHom G L s hs f.val.toHom _

lemma fromStrong_injective : Function.Injective (fromStrong G L s hs D) := by
  intro f g h
  have he : f.val.toHom=g.val.toHom := by
    rw [←hom_fromStrong G L s hs D f,←hom_fromStrong G L s hs D g,h]
  apply Subtype.ext
  apply Copy.ext
  intro v
  exact DFunLike.congr_fun he v

lemma fromStrong_roots
    (f g : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D) :
    (fromStrong G L s hs D f).1=(fromStrong G L s hs D g).1 ↔
      ∀ r : RootedSubdivision.Root (ThreeHub.base s), f.val (.inr r)=g.val (.inr r) := by
  rw [roots_eq_iff G L s hs,hom_fromStrong,hom_fromStrong]
  rfl

end Erdos571.ThreeHubAssignments

namespace Erdos571.PinnedHomLeaf
open Finset SimpleGraph

/-- Summing the one-pinned tree bound counts all tree homomorphisms. -/
theorem total_upper {V W : Type} [Fintype V] [Fintype W] [DecidableEq V] [DecidableEq W]
    (H : SimpleGraph V) (hH : H.IsTree) (G : SimpleGraph W) [DecidableRel G.Adj]
    (r : V) (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ y, (G.degree y : ℝ) ≤ D) :
    (Nat.card (H →g G) : ℝ) ≤ (Nat.card W : ℝ)*D^(Fintype.card V-1) := by
  classical
  rw [←Nat.card_congr (Equiv.sigmaFiberEquiv (fun f : H →g G => f r))]
  simp only [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  calc
    _ ≤ ∑ _x : W, D^(Fintype.card V-1) := by
      apply sum_le_sum
      intro x _
      simpa only [Nat.card_eq_fintype_card] using card_upper H hH G r x D hD hdeg
    _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul]

end Erdos571.PinnedHomLeaf

namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ) (hs : 1 ≤ s)

include hs in
lemma full_upper (D : ℝ) (hD : 0 ≤ D) (hdeg : ∀ y, (G.degree y : ℝ) ≤ D) :
    (Nat.card (Full G L s) : ℝ) ≤ (Nat.card W : ℝ)*D^(6*s+4) := by
  classical
  have hi : Nat.card (Full G L s) ≤ Nat.card (ThreeHub.template s →g G) :=
    Nat.card_le_card_of_injective (hom G L s hs) (hom_injective G L s hs)
  have h := PinnedHomLeaf.total_upper (ThreeHub.template s) (ThreeHub.template_isTree s) G
    (.inl (.inl 0)) D hD hdeg
  have hn : Fintype.card (RootedSubdivision.Vertex (ThreeHub.base s))-1=6*s+4 := by
    rw [←Nat.card_eq_fintype_card,ThreeHub.template_vertex_card s hs]
    omega
  have hiR : (Nat.card (Full G L s) : ℝ) ≤ Nat.card (ThreeHub.template s →g G) := by
    exact_mod_cast hi
  exact hiR.trans (by simpa only [hn] using h)

end Erdos571.ThreeHubAssignments

/-! Root-mask pruning of genuine strong copies, compared with all light-arm
assignments on exactly the same mask. The pin estimate below is a lower bound,
not the missing analytic upper bound. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHubRootPruning
open Finset SimpleGraph ThreeHubAssignments RootFiberPruning
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (s : ℕ) (hs : 1 ≤ s) (D : ℝ)

abbrev Good := StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D
abbrev GoodFiber (r : Roots (W := W) s) :=
  {f : Good G L s D // (fromStrong G L s hs D f).1=r}

noncomputable instance goodFiberFintype (r : Roots (W := W) s) :
    Fintype (GoodFiber G L s hs D r) := by
  classical
  exact Fintype.ofFinite _

lemma good_total : Nat.card (Sigma (GoodFiber G L s hs D))=Nat.card (Good G L s D) :=
  Nat.card_congr (Equiv.sigmaFiberEquiv (fun f : Good G L s D => (fromStrong G L s hs D f).1))

noncomputable def fiberMap (r : Roots (W := W) s) (f : GoodFiber G L s hs D r) : Fiber G L s r :=
  f.property ▸ (fromStrong G L s hs D f.val).2

lemma fiberMap_full (r : Roots (W := W) s) (f : GoodFiber G L s hs D r) :
    (⟨r,fiberMap G L s hs D r f⟩ : Full G L s)=fromStrong G L s hs D f.val := by
  rcases f with ⟨f,hf⟩
  subst r
  rfl

lemma fiberMap_injective (r : Roots (W := W) s) :
    Function.Injective (fiberMap G L s hs D r) := by
  intro f g h
  apply Subtype.ext
  apply fromStrong_injective G L s hs D
  rw [←fiberMap_full G L s hs D r f,←fiberMap_full G L s hs D r g,h]

lemma fiber_card_le (r : Roots (W := W) s) :
    Nat.card (GoodFiber G L s hs D r) ≤ Nat.card (Fiber G L s r) :=
  Nat.card_le_card_of_injective _ (fiberMap_injective G L s hs D r)

noncomputable def mask (κ : ℝ) : Finset (Roots (W := W) s) :=
  roots (Fiber G L s) (GoodFiber G L s hs D) κ

abbrev All (κ : ℝ) := Masked (Fiber G L s) (mask G L s hs D κ)
abbrev Retained (κ : ℝ) := Masked (GoodFiber G L s hs D) (mask G L s hs D κ)
abbrev AllAgreement (κ : ℝ) := MaskedAgreement (Fiber G L s) (mask G L s hs D κ)
abbrev GoodAgreement (κ : ℝ) := MaskedAgreement (GoodFiber G L s hs D) (mask G L s hs D κ)

def copy (κ : ℝ) (p : Retained G L s hs D κ) : (ThreeHub.template s).Copy G := p.2.val.val

lemma mass (κ : ℝ) (hκ : 0 ≤ κ) :
    (Nat.card (Good G L s D) : ℝ) - κ * Nat.card (Full G L s) ≤
      Nat.card (Retained G L s hs D κ) := by
  have h := card_mass (Fiber G L s) (GoodFiber G L s hs D) κ hκ
  rwa [good_total] at h

lemma energy (κ : ℝ) (hκ : 0 ≤ κ) :
    κ^2 * (Nat.card (AllAgreement G L s hs D κ) : ℝ) ≤
      Nat.card (GoodAgreement G L s hs D κ) :=
  card_energy (Fiber G L s) (GoodFiber G L s hs D) κ hκ

lemma retained_roots (κ : ℝ) (p q : Retained G L s hs D κ) :
    p.1=q.1 ↔ ∀ r, copy G L s hs D κ p (.inr r)=copy G L s hs D κ q (.inr r) := by
  dsimp only [copy]
  rw [←fromStrong_roots G L s hs D p.2.val q.2.val,p.2.property,q.2.property]
  exact Subtype.ext_iff

open Classical in
lemma agreement_pair_card (κ : ℝ) :
    Nat.card (GoodAgreement G L s hs D κ)=
      Nat.card (PathwiseLightConflict.PairFamily univ
        (RootedCollisionEnergy.labels (copy G L s hs D κ)) (fun _ _ => True)) := by
  apply Nat.card_congr
  apply Equiv.subtypeEquivRight
  intro p
  simp only [mem_univ,true_and,and_true,RootedCollisionEnergy.labels,funext_iff]
  exact retained_roots G L s hs D κ p.1 p.2

abbrev Pin (κ : ℝ) (a : RootedSubdivision.Nonroot (ThreeHub.base s)) :=
  GloballyLightEnergy.PinFamily (HostHeavyShadow.graph G univ (L+1)) (copy G L s hs D κ) a

include hs in
/-- Packing on the retained strong family, without enlarging its root mask. -/
theorem masked_pin (κ : ℝ) (hκ : 0 ≤ κ) (M : ℕ) (hM : 2 ≤ M)
    (hL : ThreeHub.pathwiseCap s M ≤ L) (hf : (ThreeHub.graph s M).Free G) :
    ∃ a : RootedSubdivision.Nonroot (ThreeHub.base s),
      κ^2 * (Nat.card (AllAgreement G L s hs D κ) : ℝ) ≤
        (ThreeHub.globalPinCoefficient s M : ℝ)*Nat.card (Pin G L s hs D κ a) := by
  classical
  letI : Nonempty (RootedSubdivision.Nonroot (ThreeHub.base s)) := ⟨.inl 0⟩
  let K := HostHeavyShadow.graph G univ (L+1)
  let c : (FullRootedPower.graph (ThreeHub.base s) (M+1)).Coloring Bool :=
    (ThreeHub.base_power_bipartite s (M+1)).toColoring (by simp)
  have hK := HostHeavyShadow.cutoff_bicliqueFree G _ c c.valid L
    (by simpa only [←Nat.card_eq_fintype_card] using hL.trans (Nat.le_succ L))
    (ThreeHub.subdivision_free s M G hf)
  have hK' : (completeBipartiteGraph (Fin (Nat.card (ThreeHub.Branch s M)))
      (Fin (Nat.card (ThreeHub.Branch s M)))).Free K := by
    rw [Nat.card_eq_fintype_card]
    exact hK
  have hwithin (p : Retained G L s hs D κ) :
      GloballyLightCopies.AllBetween K (copy G L s hs D κ p) (copy G L s hs D κ p) :=
    GloballyLightCopies.allBetween_of_light (ThreeHub.template s) G L p.2.val.val
      (StrongPinnedCopies.role_light (ThreeHub.template s) G L D p.2.val)
  obtain ⟨a,ha⟩ := GloballyLightEnergy.exists_big_pin univ K (copy G L s hs D κ)
    hwithin (Nat.card (ThreeHub.Branch s M)) M hM hK' hf
  rw [←agreement_pair_card G L s hs D κ] at ha
  have hpin := GloballyLightEnergy.pinFamily_card K (copy G L s hs D κ) a
  rw [←hpin,ThreeHub.template_interior_card s hs,ThreeHub.template_vertex_card s hs] at ha
  refine ⟨a,(energy G L s hs D κ hκ).trans ?_⟩
  change (Nat.card (GoodAgreement G L s hs D κ) : ℝ) ≤ _
  exact_mod_cast ha

/-- This fraction depends on the template and the almost-regularity ratio,
not on the host size or degree. -/
noncomputable def fraction (s : ℕ) (Q : ℝ) : ℝ := (2*(2*Q)^(6*s+4))⁻¹

lemma fraction_pos (s : ℕ) (Q : ℝ) (hQ : 0 < Q) : 0 < fraction s Q := by
  unfold fraction
  positivity

lemma fraction_scale (s : ℕ) (n Q d : ℝ) (hQ : 0 < Q) :
    fraction s Q*(n*(Q*d)^(6*s+4))=(n*(d/2)^(6*s+4))/2 := by
  unfold fraction
  simp only [mul_pow,div_pow]
  field_simp

lemma half_mass_of_bounds (Q d : ℝ) (hQ : 0 < Q) (hd : 0 ≤ d)
    (hdeg : ∀ y, (G.degree y : ℝ) ≤ Q*d)
    (hgood : (Nat.card W : ℝ)*(d/2)^(6*s+4) ≤ Nat.card (Good G L s (Q*d))) :
    ((Nat.card W : ℝ)*(d/2)^(6*s+4))/2 ≤
      Nat.card (Retained G L s hs (Q*d) (fraction s Q)) := by
  have h := mass G L s hs (Q*d) (fraction s Q) (fraction_pos s Q hQ).le
  have hu := full_upper G L s hs (Q*d) (mul_nonneg hQ.le hd) hdeg
  have hh := mul_le_mul_of_nonneg_left hu (fraction_pos s Q hQ).le
  rw [fraction_scale s (Nat.card W) Q d hQ] at hh
  linarith

include hs in
/-- Actual freeness and the previously proved local safe-extension theorem
supply the good-family abundance required by root pruning. -/
lemma strong_abundance (M : ℕ) (hf : (ThreeHub.graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 4*(6*(s:ℝ)+5) ≤ d)
    (hmin : ∀ x, d ≤ (G.degree x : ℝ)) (hmax : ∀ x, (G.degree x : ℝ) ≤ Q*d)
    (hcut : ConnectedSafeExtension.cutoff (6*s+5) Q (ThreeHub.momentCoefficient s M) 0 (6*s+5) ≤ L) :
    (Nat.card W : ℝ)*(d/2)^(6*s+4) ≤ Nat.card (Good G L s (Q*d)) := by
  classical
  have hs0 : (0:ℝ) ≤ s := Nat.cast_nonneg s
  have hd0 : 0 < d := by linarith
  have hD : 0 ≤ Q*d := mul_nonneg (by linarith) hd0.le
  have hsize : 4*(Nat.card (RootedSubdivision.Vertex (ThreeHub.base s)):ℝ) ≤ d := by
    simpa only [ThreeHub.template_vertex_card s hs,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat] using hd
  have hcount := StrongPinnedCopies.role_abundance_nat (ThreeHub.template s) G (ThreeHub.template_isTree s)
    Q d (ThreeHub.momentCoefficient s M) hQ hd0 (ThreeHub.momentCoefficient_nonneg s M) hsize
    (LocalFourthWalk.triangle_free_of_bipartite G hb) hmin
    (ThreeHub.safe_four_walks G s M hf Q d hQ hd0.le hmax)
  have hnum : Nat.card (RootedSubdivision.Vertex (ThreeHub.base s))-1=6*s+4 := by
    rw [ThreeHub.template_vertex_card s hs]
    omega
  simp only [ThreeHub.template_vertex_card s hs,show 6*s+5-1=6*s+4 by omega] at hcount
  have hmono := StrongPinnedCopies.role_family_mono (ThreeHub.template s) G
    (ConnectedSafeExtension.cutoff (6*s+5) Q (ThreeHub.momentCoefficient s M) 0 (6*s+5)) L (Q*d)
    (by exact_mod_cast hcut) hD
  exact hcount.trans (by exact_mod_cast hmono)

/-- Both conclusions use one and the same retained root mask. A matching
upper bound for its pins remains a separate problem. -/
theorem retained_abundance_and_pin (M : ℕ) (hM : 2 ≤ M)
    (hL : ThreeHub.pathwiseCap s M ≤ L)
    (hf : (ThreeHub.graph s M).Free G) (hb : G.IsBipartite)
    (Q d : ℝ) (hQ : 1 ≤ Q) (hd : 4*(6*(s:ℝ)+5) ≤ d)
    (hmin : ∀ x, d ≤ (G.degree x : ℝ)) (hmax : ∀ x, (G.degree x : ℝ) ≤ Q*d)
    (hcut : ConnectedSafeExtension.cutoff (6*s+5) Q (ThreeHub.momentCoefficient s M) 0 (6*s+5) ≤ L) :
    ((Nat.card W : ℝ)*(d/2)^(6*s+4))/2 ≤
      Nat.card (Retained G L s hs (Q*d) (fraction s Q)) ∧
    ∃ a : RootedSubdivision.Nonroot (ThreeHub.base s),
      (fraction s Q)^2 * (Nat.card (AllAgreement G L s hs (Q*d) (fraction s Q)) : ℝ) ≤
        (ThreeHub.globalPinCoefficient s M : ℝ)*Nat.card (Pin G L s hs (Q*d) (fraction s Q) a) := by
  have hQ0 : 0 < Q := by linarith
  have hs0 : (0:ℝ) ≤ s := Nat.cast_nonneg s
  have hd0 : 0 ≤ d := by linarith
  refine ⟨half_mass_of_bounds G L s hs Q d hQ0 hd0 hmax ?_,
    masked_pin G L s hs (Q*d) (fraction s Q) (fraction_pos s Q hQ0).le M hM hL hf⟩
  exact strong_abundance G L s hs M hf hb Q d hQ hd hmin hmax hcut

end Erdos571.ThreeHubRootPruning

/-! An oriented subdivision exclusion alone does not give the proposed
unbalanced square-root incidence bound. This is an auxiliary obstruction,
not a disproof of the rational Turan conjecture. -/
set_option maxHeartbeats 2000000
namespace Erdos571.OrientedSubdivisionIncidence
open Finset
variable {S Y : Type*} [Fintype S] [Fintype Y] [DecidableEq S] [DecidableEq Y]

/-- All branch vertices of the subdivision lie in `S`. -/
def Free (E : Finset (S × Y)) (p M : ℕ) : Prop :=
  ∀ f : (Fin p ⊕ Fin M) ↪ S, ∀ g : (Fin p × Fin M) ↪ Y,
    ¬ ∀ i j, (f (.inl i), g (i,j)) ∈ E ∧ (f (.inr j), g (i,j)) ∈ E

def edge {p M : ℕ} (f : (Fin p ⊕ Fin M) ↪ S) (g : (Fin p × Fin M) ↪ Y)
    (a : (Fin p × Fin M) × Bool) : S × Y :=
  (if a.2 then f (.inl a.1.1) else f (.inr a.1.2), g a.1)

lemma edge_injective {p M : ℕ} (f : (Fin p ⊕ Fin M) ↪ S)
    (g : (Fin p × Fin M) ↪ Y) : Function.Injective (edge f g) := by
  rintro ⟨ij,b⟩ ⟨ij',b'⟩ h
  have hij : ij=ij' := g.injective (congrArg Prod.snd h)
  subst ij'
  have hh := congrArg Prod.fst h
  cases b <;> cases b' <;> simp_all [edge, f.injective.eq_iff]

noncomputable def pattern {p M : ℕ} (f : (Fin p ⊕ Fin M) ↪ S)
    (g : (Fin p × Fin M) ↪ Y) : Finset (S × Y) := univ.image (edge f g)

lemma pattern_card {p M : ℕ} (f : (Fin p ⊕ Fin M) ↪ S)
    (g : (Fin p × Fin M) ↪ Y) : (pattern f g).card = 2*p*M := by
  rw [pattern, card_image_of_injective _ (edge_injective f g)]
  simp only [card_univ, Fintype.card_prod, Fintype.card_fin, Fintype.card_bool]
  ring

lemma pattern_nonempty {p M : ℕ} (hp : 0<p) (hM : 0<M)
    (f : (Fin p ⊕ Fin M) ↪ S) (g : (Fin p × Fin M) ↪ Y) :
    (pattern f g).Nonempty := by
  exact ⟨edge f g ((⟨0,hp⟩,⟨0,hM⟩),true), mem_image.mpr ⟨_,mem_univ _,rfl⟩⟩

lemma pattern_subset_iff {p M : ℕ} (f : (Fin p ⊕ Fin M) ↪ S)
    (g : (Fin p × Fin M) ↪ Y) (E : Finset (S × Y)) :
    pattern f g ⊆ E ↔ ∀ i j, (f (.inl i),g (i,j))∈E ∧ (f (.inr j),g (i,j))∈E := by
  constructor
  · intro h i j
    exact ⟨h (mem_image.mpr ⟨((i,j),true),mem_univ _,rfl⟩),
      h (mem_image.mpr ⟨((i,j),false),mem_univ _,rfl⟩)⟩
  · intro h e he
    obtain ⟨⟨⟨i,j⟩,b⟩,_,rfl⟩ := mem_image.mp he
    cases b
    · exact (h i j).2
    · exact (h i j).1

lemma placement_card_le (p M : ℕ) :
    Fintype.card (((Fin p ⊕ Fin M) ↪ S) × ((Fin p × Fin M) ↪ Y)) ≤
      (Fintype.card S)^(p+M)*(Fintype.card Y)^(p*M) := by
  classical
  let val : (((Fin p ⊕ Fin M) ↪ S) × ((Fin p × Fin M) ↪ Y)) →
      ((Fin p ⊕ Fin M) → S) × ((Fin p × Fin M) → Y) :=
    fun a => (a.1,a.2)
  have hi : Function.Injective val := by
    rintro ⟨f,g⟩ ⟨f',g'⟩ he
    apply Prod.ext
    · exact DFunLike.coe_injective (congrArg Prod.fst he)
    · exact DFunLike.coe_injective (congrArg Prod.snd he)
  simpa only [Fintype.card_prod,Fintype.card_fun,Fintype.card_sum,Fintype.card_fin]
    using Fintype.card_le_of_injective val hi

/-- Random deletion, keeping the orientation in the forbidden patterns. -/
theorem exists_free (p M : ℕ) (hp : 0<p) (hM : 0<M)
    (θ : ℝ) (hθ : 0≤θ) (hθ1 : θ≤1) :
    ∃ E : Finset (S × Y), Free E p M ∧
      θ*Fintype.card S*Fintype.card Y -
        (Fintype.card S:ℝ)^(p+M)*(Fintype.card Y:ℝ)^(p*M)*θ^(2*p*M) ≤ E.card := by
  classical
  let J := ((Fin p ⊕ Fin M) ↪ S) × ((Fin p × Fin M) ↪ Y)
  obtain ⟨E,hE,hfree⟩ := RandomDeletion.exists_avoiding_patterns
    (fun a : J => pattern a.1 a.2) (fun a => pattern_nonempty hp hM a.1 a.2) θ hθ hθ1
  refine ⟨E,fun f g h => hfree (f,g) ((pattern_subset_iff f g E).mpr h),?_⟩
  have hc : (Fintype.card J:ℝ) ≤ (Fintype.card S:ℝ)^(p+M)*(Fintype.card Y:ℝ)^(p*M) := by
    exact_mod_cast placement_card_le (S:=S) (Y:=Y) p M
  have hc' := mul_le_mul_of_nonneg_right hc (pow_nonneg hθ (2*p*M))
  simp only [pattern_card, sum_const, card_univ, nsmul_eq_mul,
    Fintype.card_prod, Nat.cast_mul] at hE
  change θ*((Fintype.card S:ℝ)*Fintype.card Y) -
    (Fintype.card J:ℝ)*θ^(2*p*M) ≤ E.card at hE
  nlinarith

/-- A concrete unbalanced family: q^20 branch-side vertices, q^9 middle-side
vertices, and at least q^21-q^(-8) incidences without an oriented K_(4,11)
subdivision. -/
theorem power_family (q : ℕ) (hq : 2≤q) :
    ∃ E : Finset (Fin (q^20) × Fin (q^9)), Free E 4 11 ∧
      (q:ℝ)^21 - 1/(q:ℝ)^8 ≤ E.card := by
  have hq0 : (0:ℝ)<q := by exact_mod_cast (show 0<q by omega)
  have hq1 : (1:ℝ)≤q := by exact_mod_cast (show 1≤q by omega)
  obtain ⟨E,hf,hE⟩ := exists_free (S:=Fin (q^20)) (Y:=Fin (q^9)) 4 11
    (by omega) (by omega) (1/(q:ℝ)^8) (by positivity)
    (by simpa using one_div_le_one_div_of_le (by norm_num : (0:ℝ)<1) (one_le_pow₀ hq1 (n:=8)))
  refine ⟨E,hf,?_⟩
  norm_num only [Fintype.card_fin,Nat.cast_pow,Nat.reduceAdd,Nat.reduceMul] at hE
  convert hE using 1 <;> field_simp <;> ring

/-- The proposed incidence bound has no universal constant, even for this
one fixed oriented forbidden subdivision. -/
theorem no_square_root_bound :
    ¬ ∃ C : ℝ, 0≤C ∧ ∀ m n : ℕ, ∀ E : Finset (Fin m × Fin n),
      Free E 4 11 → (E.card:ℝ) ≤ C*((m:ℝ)+(n:ℝ)*Real.sqrt m) := by
  rintro ⟨C,hC,hbound⟩
  obtain ⟨q,hq⟩ := exists_nat_gt (4*C+2)
  have hq2 : 2≤q := by
    have : (2:ℝ)<q := lt_of_le_of_lt (by linarith) hq
    exact le_of_lt (by exact_mod_cast this)
  have hq0 : (0:ℝ)<q := by exact_mod_cast (show 0<q by omega)
  have hq1 : (1:ℝ)≤q := by exact_mod_cast (show 1≤q by omega)
  obtain ⟨E,hf,hE⟩ := power_family q hq2
  have hb := hbound (q^20) (q^9) E hf
  have hs : Real.sqrt ((q:ℝ)^20)=(q:ℝ)^10 := by
    rw [show (q:ℝ)^20=((q:ℝ)^10)^2 by ring, Real.sqrt_sq (by positivity)]
  simp only [Nat.cast_pow,hs] at hb
  have h19 : (q:ℝ)^19 ≤ (q:ℝ)^20 := pow_le_pow_right₀ hq1 (by omega)
  have hmul : (q:ℝ)^9*(q:ℝ)^10=(q:ℝ)^19 := by ring
  rw [hmul] at hb
  have hb' : (E.card:ℝ) ≤ 2*C*(q:ℝ)^20 := by nlinarith
  have hp : 1 ≤ (q:ℝ)^20 := one_le_pow₀ hq1
  have hinv : 1/(q:ℝ)^8 ≤ 1 := by
    simpa using one_div_le_one_div_of_le (by norm_num : (0:ℝ)<1) (one_le_pow₀ hq1 (n:=8))
  have hlarge : 2*C+1 < (q:ℝ) := by linarith
  have hh := mul_lt_mul_of_pos_right hlarge (pow_pos hq0 20)
  have h21 : (q:ℝ)^21=(q:ℝ)*(q:ℝ)^20 := by ring
  rw [h21] at hE
  nlinarith

end Erdos571.OrientedSubdivisionIncidence

/-! Extracting a fixed-size set from a sparse uniform forbidden-pattern family.
This will be used inside dependent random choice; it is not an extremal upper
bound on its own. -/
namespace Erdos571.DependentChoice
open Finset

lemma avoid_uniform {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I]
    (P : J → Finset I) (r m : ℕ) (hr : 1  ≤  r) (hm : 1  ≤  m)
    (hcard : ∀ j, (P j).card = r)
    (hdense : (2*m)^r*(Fintype.card J+1)  ≤  (Fintype.card I)^r) :
    ∃ S : Finset I, m  ≤  S.card ∧ ∀ j, ¬ P j ⊆ S := by
  have hN : 2*m  ≤  Fintype.card I := by
    apply (Nat.pow_le_pow_iff_left (by omega : r ≠ 0)).mp
    exact (Nat.le_mul_of_pos_right _ (by omega : 0 < Fintype.card J+1)).trans hdense
  have hN0 : (0:ℝ) < Fintype.card I := by exact_mod_cast (show 0 < Fintype.card I by omega)
  have hmR : (1:ℝ) ≤ m := by exact_mod_cast hm
  let prob : ℝ := (2*(m:ℝ))/Fintype.card I
  have hp : 0 ≤ prob := by dsimp [prob]; positivity
  have hp1 : prob ≤ 1 := by
    dsimp [prob]
    rw [div_le_one hN0]
    exact_mod_cast hN
  have hcost : (Fintype.card J:ℝ)*prob^r  ≤  1 := by
    have hh : (2*(m:ℝ))^r*(Fintype.card J:ℝ)  ≤  (Fintype.card I:ℝ)^r := by
      have hh' := (Nat.mul_le_mul_left ((2*m)^r) (Nat.le_succ (Fintype.card J))).trans hdense
      exact_mod_cast hh'
    dsimp [prob]
    rw [div_pow, ← mul_div_assoc, div_le_one (pow_pos hN0 _)]
    nlinarith
  obtain ⟨S,hS,havoid⟩ := RandomDeletion.exists_avoiding_patterns P
    (fun j => card_pos.mp (by rw [hcard]; omega)) prob hp hp1
  refine ⟨S,?_,havoid⟩
  have hmean : prob*Fintype.card I=2*(m:ℝ) := by
    dsimp [prob]
    exact div_mul_cancel₀ _ hN0.ne'
  simp only [hcard,sum_const,card_univ,nsmul_eq_mul,hmean] at hS
  have hh : (m:ℝ) ≤ S.card := by linarith
  exact_mod_cast hh

lemma avoid_uniform_subset {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I]
    (P : J → Finset I) (r m : ℕ) (hr : 1  ≤  r) (hm : 1  ≤  m)
    (hcard : ∀ j, (P j).card = r)
    (hdense : (2*m)^r*(Fintype.card J+1)  ≤  (Fintype.card I)^r) :
    ∃ S : Finset I, S.card=m ∧ ∀ j, ¬ P j ⊆ S := by
  obtain ⟨T,hT,havoid⟩ := avoid_uniform P r m hr hm hcard hdense
  obtain ⟨S,hST,hS⟩ := exists_subset_card_eq hT
  exact ⟨S,hS,fun j h => havoid j (h.trans hST)⟩

lemma avoid_uniform_in {I : Type*} [DecidableEq I] (U : Finset I)
    (B : Finset (Finset I)) (r m : ℕ) (hr : 1 ≤ r) (hm : 1 ≤ m)
    (hsub : ∀ b ∈ B, b ⊆ U) (hcard : ∀ b ∈ B, b.card = r)
    (hdense : (2*m)^r*(B.card+1) ≤ U.card^r) :
    ∃ S ⊆ U, S.card = m ∧ ∀ b ∈ B, ¬ b ⊆ S := by
  classical
  let P : B → Finset U := fun b => b.val.subtype (· ∈ U)
  have hP (b : B) : (P b).card = r := by
    change (b.val.subtype (· ∈ U)).card = r
    rw [card_subtype, filter_eq_self.mpr (fun x hx => hsub b.val b.property hx)]
    exact hcard b.val b.property
  obtain ⟨T,hT,havoid⟩ := avoid_uniform_subset P r m hr hm hP
    (by simpa only [Fintype.card_coe] using hdense)
  refine ⟨T.image Subtype.val, ?_, ?_, ?_⟩
  · intro x hx
    obtain ⟨x,hx,rfl⟩ := mem_image.mp hx
    exact x.property
  · simpa only [card_image_of_injective _ Subtype.val_injective] using hT
  · intro b hb hbs
    apply havoid ⟨b,hb⟩
    intro x hx
    have hxb : x.val ∈ b := mem_subtype.mp hx
    obtain ⟨y,hy,he⟩ := mem_image.mp (hbs hxb)
    have hyx : y=x := Subtype.ext he
    simpa only [hyx] using hy

end Erdos571.DependentChoice


/-! Finite common-neighborhood sampling without replacement. -/
namespace Erdos571.DependentChoice
open Finset
variable {X Y : Type*} [Fintype X] [Fintype Y] [DecidableEq X] [DecidableEq Y]
variable (R : X → Y → Prop) [DecidableRel R]

def common (A : Finset X) : Finset Y := univ.filter (fun y => ∀ x ∈ A, R x y)

lemma mem_common (A : Finset X) (y : Y) : y ∈ common R A ↔ ∀ x ∈ A, R x y := by
  simp [common]

def sampleCommon (s : ℕ) (t : Fin s ↪ X) : Finset Y :=
  univ.filter (fun y => ∀ i, R (t i) y)

lemma mem_sampleCommon (s : ℕ) (t : Fin s ↪ X) (y : Y) :
    y ∈ sampleCommon R s t ↔ ∀ i, R (t i) y := by
  simp [sampleCommon]

def bad (r cap : ℕ) : Finset (Finset Y) :=
  ((univ : Finset Y).powersetCard r).filter (fun A => (common (fun y x => R x y) A).card < cap)

lemma mem_bad (r cap : ℕ) (A : Finset Y) :
    A ∈ bad R r cap ↔ A.card=r ∧ (common (fun y x => R x y) A).card < cap := by
  simp [bad]

def badIn (s r cap : ℕ) (t : Fin s ↪ X) : Finset (Finset Y) :=
  (bad R r cap).filter (· ⊆ sampleCommon R s t)

lemma sample_fiber_cap (s cap : ℕ) (A : Finset Y)
    (hcap : (common (fun y x => R x y) A).card ≤ cap) :
    ((univ : Finset (Fin s ↪ X)).filter (fun t => A ⊆ sampleCommon R s t)).card ≤ cap^s := by
  classical
  let U := common (fun y x => R x y) A
  let F := ((univ : Finset (Fin s ↪ X)).filter (fun t => A ⊆ sampleCommon R s t))
  let f : F → (Fin s → U) := fun t i => ⟨t.val i, by
    apply (mem_common _ _ _).mpr
    intro y hy
    exact (mem_sampleCommon R s t.val y).mp ((mem_filter.mp t.property).2 hy) i⟩
  have hf : Function.Injective f := by
    intro t u h
    apply Subtype.ext
    apply DFunLike.ext
    intro i
    exact congrArg Subtype.val (congrFun h i)
  have h := Fintype.card_le_of_injective f hf
  have h' : F.card ≤ U.card^s := by
    simpa only [Fintype.card_coe,Fintype.card_fun,Fintype.card_fin] using h
  exact h'.trans (Nat.pow_le_pow_left hcap s)

lemma bad_sum_le (s r cap : ℕ) :
    (∑ t : Fin s ↪ X, (badIn R s r cap t).card) ≤ (Fintype.card Y)^r*cap^s := by
  classical
  have hs := sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
    (s := (univ : Finset (Fin s ↪ X))) (t := bad R r cap)
    (fun t A => A ⊆ sampleCommon R s t)
  change (∑ t : Fin s ↪ X, (badIn R s r cap t).card) =
    ∑ A ∈ bad R r cap, ((univ : Finset (Fin s ↪ X)).filter (fun t => A ⊆ sampleCommon R s t)).card at hs
  rw [hs]
  calc
    _ ≤ ∑ _A ∈ bad R r cap, cap^s := sum_le_sum (fun A hA =>
      sample_fiber_cap R s cap A (Nat.le_of_lt ((mem_bad R r cap A).mp hA).2))
    _ = (bad R r cap).card*cap^s := by simp
    _ ≤ (Fintype.card Y)^r*cap^s := Nat.mul_le_mul_right _
      ((card_filter_le _ _).trans (by
        rw [card_powersetCard,card_univ]
        exact Nat.choose_le_pow _ _))

lemma good_subset_of_power (s r cap m : ℕ) (hr : 1 ≤ r) (hm : 1 ≤ m)
    (t : Fin s ↪ X)
    (hdense : (2*m)^r*((badIn R s r cap t).card+1) ≤ (sampleCommon R s t).card^r) :
    ∃ S ⊆ sampleCommon R s t, S.card=m ∧
      ∀ A ⊆ S, A.card=r → cap ≤ (common (fun y x => R x y) A).card := by
  obtain ⟨S,hS,hcard,havoid⟩ := avoid_uniform_in (sampleCommon R s t)
    (badIn R s r cap t) r m hr hm
    (fun A hA => (mem_filter.mp hA).2)
    (fun A hA => ((mem_bad R r cap A).mp (mem_filter.mp hA).1).1) hdense
  refine ⟨S,hS,hcard,?_⟩
  intro A hAS hAr
  by_contra hn
  have hAb : A ∈ badIn R s r cap t := mem_filter.mpr
    ⟨(mem_bad R r cap A).mpr ⟨hAr,Nat.lt_of_not_ge hn⟩,hAS.trans hS⟩
  exact havoid A hAb hAS

end Erdos571.DependentChoice


/-! First and higher moments for sampling distinct common neighbors. -/
namespace Erdos571.DependentChoice
open Finset

lemma pow_le_desc (s d n : ℕ) (h : d+s ≤ n) : d^s ≤ n.descFactorial s := by
  induction s with
  | zero => simp
  | succ s ih =>
    rw [pow_succ',Nat.descFactorial_succ]
    exact Nat.mul_le_mul (by omega : d ≤ n-s) (ih (by omega))

variable {X Y : Type*} [Fintype X] [Fintype Y] [DecidableEq X] [DecidableEq Y]
variable (R : X → Y → Prop) [DecidableRel R]

lemma sampling_sum_lower (s d : ℕ)
    (hdeg : ∀ y, d+s ≤ Fintype.card {x // R x y}) :
    Fintype.card Y*d^s ≤ ∑ t : Fin s ↪ X, (sampleCommon R s t).card := by
  classical
  let F := (y : Y) × (Fin s ↪ {x // R x y})
  let A := (t : Fin s ↪ X) × sampleCommon R s t
  let f : F → A := fun p =>
    ⟨p.2.trans (Function.Embedding.subtype _), ⟨p.1, by
      apply (mem_sampleCommon R s _ _).mpr
      intro i
      exact (p.2 i).property⟩⟩
  have hf : Function.Injective f := by
    rintro ⟨y,t⟩ ⟨z,u⟩ h
    have hyz : y=z := congrArg (fun a : A => a.2.val) h
    subst z
    have htu : t=u := by
      apply DFunLike.ext
      intro i
      apply Subtype.ext
      exact congrArg (fun a : A => a.1 i) h
    subst u
    rfl
  have h := Fintype.card_le_of_injective f hf
  have hc : (∑ y, (Fintype.card {x // R x y}).descFactorial s) ≤
      ∑ t : Fin s ↪ X, (sampleCommon R s t).card := by
    simpa only [F,A,Fintype.card_sigma,Fintype.card_embedding_eq,Fintype.card_fin,Fintype.card_coe] using h
  have hlow : Fintype.card Y*d^s ≤ ∑ y, (Fintype.card {x // R x y}).descFactorial s := by
    simpa only [sum_const,card_univ,smul_eq_mul] using
      (sum_le_sum (s := (univ : Finset Y)) (fun y _ => pow_le_desc s d _ (hdeg y)))
  exact hlow.trans hc

lemma sampling_power_lower (s r d : ℕ) (hr : 1 ≤ r)
    (hdeg : ∀ y, d+s ≤ Fintype.card {x // R x y}) :
    ((Fintype.card Y:ℝ)*(d:ℝ)^s)^r ≤
      (Fintype.card X:ℝ)^(s*(r-1))*∑ t : Fin s ↪ X, ((sampleCommon R s t).card:ℝ)^r := by
  classical
  have hlow : (Fintype.card Y:ℝ)*(d:ℝ)^s ≤
      ∑ t : Fin s ↪ X, ((sampleCommon R s t).card:ℝ) := by
    exact_mod_cast sampling_sum_lower R s d hdeg
  have hp := CoordinateCoverMoments.sum_power_bound (univ : Finset (Fin s ↪ X))
    (fun t => ((sampleCommon R s t).card:ℝ)) (fun _ _ => Nat.cast_nonneg _) r hr
  simp only [card_univ] at hp
  have hcard : (Fintype.card (Fin s ↪ X):ℝ) ≤ (Fintype.card X:ℝ)^s := by
    have h := Nat.descFactorial_le_pow (Fintype.card X) s
    simpa only [Fintype.card_embedding_eq,Fintype.card_fin,Nat.cast_pow] using
      (show (Fintype.card X |>.descFactorial s : ℝ) ≤ (Fintype.card X^s:ℕ) by exact_mod_cast h)
  calc
    _ ≤ (∑ t : Fin s ↪ X, ((sampleCommon R s t).card:ℝ))^r :=
      pow_le_pow_left₀ (by positivity) hlow r
    _ ≤ _ := hp.trans (by
      apply mul_le_mul_of_nonneg_right _ (sum_nonneg (fun _ _ => pow_nonneg (Nat.cast_nonneg _) _))
      simpa only [←pow_mul] using pow_le_pow_left₀ (Nat.cast_nonneg _) hcard (r-1))

/-- If no sampled common neighborhood yields the desired good set, then its
rth moment has a universal upper bound. -/
lemma sampling_power_upper (s r cap m : ℕ) (hr : 1 ≤ r) (hm : 1 ≤ m)
    (hno : ∀ t : Fin s ↪ X, ¬ ∃ S ⊆ sampleCommon R s t, S.card=m ∧
      ∀ A ⊆ S, A.card=r → cap ≤ (common (fun y x => R x y) A).card) :
    (∑ t : Fin s ↪ X, ((sampleCommon R s t).card:ℝ)^r) ≤
      (2*(m:ℝ))^r*((Fintype.card Y:ℝ)^r*(cap:ℝ)^s+(Fintype.card X:ℝ)^s) := by
  classical
  have ht (t : Fin s ↪ X) : (sampleCommon R s t).card^r ≤
      (2*m)^r*((badIn R s r cap t).card+1) := by
    apply Nat.le_of_lt
    by_contra hn
    exact hno t (good_subset_of_power R s r cap m hr hm t (Nat.le_of_not_gt hn))
  have hs := sum_le_sum (s := (univ : Finset (Fin s ↪ X))) (fun t _ => ht t)
  simp only [mul_add,mul_one,sum_add_distrib,←mul_sum,sum_const,card_univ,smul_eq_mul] at hs
  have hb := bad_sum_le R s r cap
  have hc : Fintype.card (Fin s ↪ X) ≤ Fintype.card X^s := by
    simpa only [Fintype.card_embedding_eq,Fintype.card_fin] using Nat.descFactorial_le_pow (Fintype.card X) s
  have hnat : (∑ t : Fin s ↪ X, (sampleCommon R s t).card^r) ≤
      (2*m)^r*((Fintype.card Y)^r*cap^s+(Fintype.card X)^s) := by
    calc
      _ ≤ _ := hs
      _ ≤ _ := by nlinarith [Nat.mul_le_mul_left ((2*m)^r) hb, Nat.mul_le_mul_left ((2*m)^r) hc]
  exact_mod_cast hnat

end Erdos571.DependentChoice


/-! An embedding lemma for bipartite graphs with a bounded number of exceptional
vertices on one side and bounded degrees at its remaining vertices. -/
namespace Erdos571.DependentChoice
open Finset SimpleGraph

variable {L B : Type*}
def model (s : ℕ) (P : L → B → Prop) : SimpleGraph ((Fin s ⊕ L) ⊕ B) :=
  SixCycleCase.bipGraph (Sum.elim (fun _ _ => True) P)

variable [Fintype L] [Fintype B] [DecidableEq B]
variable (P : L → B → Prop) [DecidableRel P]
variable {W : Type*} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma model_contained (s r m : ℕ) (hrm : r ≤ m) (hBm : Fintype.card B ≤ m)
    (hP : ∀ l, (univ.filter (P l)).card ≤ r)
    (t : Fin s ↪ W) (S : Finset W) (hS : S ⊆ sampleCommon G.Adj s t) (hSm : S.card=m)
    (hgood : ∀ A ⊆ S, A.card=r → s+m+Fintype.card L ≤ (common G.Adj A).card) :
    (model s P).IsContained G := by
  classical
  let e : B ↪ S := (Function.Embedding.nonempty_of_card_le (by
    simpa only [Fintype.card_coe,hSm] using hBm)).some
  let b : B ↪ W := e.trans (Function.Embedding.subtype _)
  have hb (x : B) : b x ∈ S := (e x).property
  let Z := (univ.image t) ∪ S
  have hZ : Z.card ≤ s+m := by
    have h := card_union_le (univ.image t) S
    simpa only [card_image_of_injective _ t.injective,card_univ,Fintype.card_fin,hSm] using h
  let A : L → Finset W := fun l => (univ.filter (P l)).image b
  have hAS (l : L) : A l ⊆ S := by
    intro w hw
    obtain ⟨x,hx,rfl⟩ := mem_image.mp hw
    exact hb x
  have hAr (l : L) : (A l).card ≤ r :=
    (card_image_le).trans (hP l)
  have hc (l : L) : s+m+Fintype.card L ≤ (common G.Adj (A l)).card := by
    obtain ⟨Q,hAQ,hQS,hQr⟩ := exists_subsuperset_card_eq (hAS l) (hAr l) (by omega : r ≤ S.card)
    apply (hgood Q hQS hQr).trans
    apply card_le_card
    intro x hx
    apply (mem_common _ _ _).mpr
    intro y hy
    exact (mem_common _ _ _).mp hx y (hAQ hy)
  let F : L → Finset W := fun l => common G.Adj (A l) \ Z
  have hF (l : L) : Fintype.card L ≤ (F l).card := by
    have h := @card_le_card_sdiff_add_card W (common G.Adj (A l)) Z inferInstance
    have hh := hc l
    change Fintype.card L ≤ (common G.Adj (A l) \ Z).card
    omega
  obtain ⟨f,hfi,hf⟩ := ProjectionHeavy.injective_selection F hF
  have hfZ (l : L) : f l ∉ Z := (Finset.mem_sdiff.mp (hf l)).2
  have hft (l : L) (i : Fin s) : f l ≠ t i := by
    intro he
    apply hfZ l
    exact mem_union_left _ (mem_image.mpr ⟨i,mem_univ _,he.symm⟩)
  have hfb (l : L) (x : B) : f l ≠ b x := by
    intro he
    exact hfZ l (mem_union_right _ (he ▸ hb x))
  have htb (i : Fin s) (x : B) : t i ≠ b x := by
    have h := (mem_sampleCommon G.Adj s t (b x)).mp (hS (hb x)) i
    exact h.ne
  let a : Fin s ⊕ L → W := Sum.elim t f
  have hai : Function.Injective a := Sum.elim_injective.mpr
    ⟨t.injective,hfi,fun i l he => hft l i he.symm⟩
  let g : ((Fin s ⊕ L) ⊕ B) → W := Sum.elim a b
  have hgi : Function.Injective g := Sum.elim_injective.mpr ⟨hai,b.injective,by
    intro u x
    cases u with
    | inl i => exact htb i x
    | inr l => exact hfb l x⟩
  have hadj (u : Fin s ⊕ L) (x : B) (h : Sum.elim (fun _ _ => True) P u x) :
      G.Adj (a u) (b x) := by
    cases u with
    | inl i => exact (mem_sampleCommon G.Adj s t (b x)).mp (hS (hb x)) i
    | inr l =>
      have hm : b x ∈ A l := mem_image.mpr ⟨x,mem_filter.mpr ⟨mem_univ _,h⟩,rfl⟩
      exact ((mem_common G.Adj (A l) (f l)).mp (Finset.mem_sdiff.mp (hf l)).1 (b x) hm).symm
  refine ⟨⟨⟨g,?_⟩,hgi⟩⟩
  intro u v h
  cases u <;> cases v
  · exact h.elim
  · exact hadj _ _ h
  · exact (hadj _ _ h).symm
  · exact h.elim

end Erdos571.DependentChoice


/-! A dependent-random-choice upper bound for the exceptional-vertex model. -/
namespace Erdos571.DependentChoice
open Finset SimpleGraph
variable {L B : Type*} [Fintype L] [Fintype B] [DecidableEq B]
variable (P : L → B → Prop) [DecidableRel P]

def cap (s m : ℕ) : ℕ := s+m+Fintype.card L

def coefficient (s r m : ℕ) : ℕ := (2*m)^r*((cap (L:=L) s m)^s+1)

lemma coefficient_pos (s r m : ℕ) (hm : 1 ≤ m) : 0 < coefficient (L:=L) s r m := by
  unfold coefficient
  positivity

variable {W : Type*} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma free_degree_polynomial (s r m k : ℕ) (hs : 1 ≤ s) (hsr : s ≤ r)
    (hrm : r ≤ m) (hBm : Fintype.card B ≤ m)
    (hP : ∀ l, (univ.filter (P l)).card ≤ r)
    (hf : (model s P).Free G) (hdeg : ∀ x, k+s ≤ G.degree x) :
    k^r ≤ coefficient (L:=L) s r m*(Fintype.card W)^(r-1) := by
  classical
  let n := Fintype.card W
  let C := coefficient (L:=L) s r m
  have hn : 0 < n := Fintype.card_pos
  have hr : 1 ≤ r := hs.trans hsr
  have hm : 1 ≤ m := hr.trans hrm
  have hno (t : Fin s ↪ W) : ¬ ∃ S ⊆ sampleCommon G.Adj s t, S.card=m ∧
      ∀ A ⊆ S, A.card=r → cap (L:=L) s m ≤ (common (fun y x => G.Adj x y) A).card := by
    rintro ⟨S,hS,hSm,hgood⟩
    apply hf
    apply model_contained P G s r m hrm hBm hP t S hS hSm
    intro A hAS hAr
    simpa only [G.adj_comm] using hgood A hAS hAr
  have hlow := sampling_power_lower G.Adj s r k hr (fun y => by
    simpa only [←G.card_neighborSet_eq_degree,G.adj_comm] using hdeg y)
  have hup := sampling_power_upper G.Adj s r (cap (L:=L) s m) m hr hm hno
  have h : (n*k^s)^r ≤ n^(s*(r-1))*((2*m)^r*(n^r*(cap (L:=L) s m)^s+n^s)) := by
    have hh := hlow.trans (mul_le_mul_of_nonneg_left hup (pow_nonneg (Nat.cast_nonneg _) _))
    exact_mod_cast hh
  have hsrn : n^s ≤ n^r := Nat.pow_le_pow_right hn hsr
  have hpow : k^(s*r) ≤ C*n^(s*(r-1)) := by
    apply Nat.le_of_mul_le_mul_left (c:=n^r) _ (pow_pos hn _)
    calc
      _ = (n*k^s)^r := by rw [mul_pow,←pow_mul]
      _ ≤ _ := h
      _ ≤ n^r*(C*n^(s*(r-1))) := by
        have hh := Nat.mul_le_mul_left (n^(s*(r-1))*(2*m)^r) hsrn
        dsimp [C,coefficient]
        nlinarith
  apply (Nat.pow_le_pow_iff_left (by omega : s≠0)).mp
  calc
    (k^r)^s = k^(s*r) := by rw [←pow_mul]; congr 1; ring
    _ ≤ C*n^(s*(r-1)) := hpow
    _ ≤ C^s*n^(s*(r-1)) := Nat.mul_le_mul_right _ (Nat.le_self_pow (by omega) C)
    _ = (C*n^(r-1))^s := by rw [mul_pow,←pow_mul]; congr 2; ring

noncomputable def realCoefficient (s r m : ℕ) : ℝ :=
  2*((s:ℝ)+1)+4*(coefficient (L:=L) s r m:ℝ)^((r:ℝ)⁻¹)

lemma realCoefficient_nonneg (s r m : ℕ) : 0 ≤ realCoefficient (L:=L) s r m := by
  unfold realCoefficient
  positivity

lemma free_min_degree (s r m : ℕ) (hs : 1 ≤ s) (hsr : s ≤ r)
    (hrm : r ≤ m) (hBm : Fintype.card B ≤ m)
    (hP : ∀ l, (univ.filter (P l)).card ≤ r)
    (hf : (model s P).Free G) (d : ℝ) (hd : 0 < d)
    (hdeg : ∀ x, d ≤ (G.degree x:ℝ)) :
    d ≤ realCoefficient (L:=L) s r m*(Fintype.card W:ℝ)^((r-1:ℕ)/(r:ℝ)) := by
  have hn : (1:ℝ) ≤ Fintype.card W := by exact_mod_cast Fintype.card_pos (α:=W)
  have hnp : 1 ≤ (Fintype.card W:ℝ)^((r-1:ℕ)/(r:ℝ)) :=
    Real.one_le_rpow hn (by positivity)
  let C : ℝ := (coefficient (L:=L) s r m:ℝ)^((r:ℝ)⁻¹)
  have hC : 0 ≤ C := Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hsR : (1:ℝ) ≤ s := by exact_mod_cast hs
  change d ≤ (2*((s:ℝ)+1)+4*C)*(Fintype.card W:ℝ)^((r-1:ℕ)/(r:ℝ))
  by_cases hsmall : d ≤ 2*((s:ℝ)+1)
  · nlinarith
  have hdlarge : 2*((s:ℝ)+1)<d := lt_of_not_ge hsmall
  let k := ⌊d/2⌋₊
  have hk : (k:ℝ) ≤ d/2 := Nat.floor_le (by positivity)
  have hk' : d/2 < (k:ℝ)+1 := Nat.lt_floor_add_one _
  have hdeg' (x : W) : k+s ≤ G.degree x := by
    have hh := hdeg x
    have hz : (k:ℝ)+(s:ℝ) ≤ G.degree x := by linarith
    exact_mod_cast hz
  have hp := free_degree_polynomial P G s r m k hs hsr hrm hBm hP hf hdeg'
  have hpR : (k:ℝ)^r ≤ (coefficient (L:=L) s r m:ℝ)*(Fintype.card W:ℝ)^(r-1) := by
    exact_mod_cast hp
  have hb := LongSpider.degree_of_power r (r-1) (by omega) (Nat.cast_nonneg _)
    (Nat.cast_nonneg k) (Nat.cast_nonneg _) hpR
  change (k:ℝ) ≤ C*(Fintype.card W:ℝ)^((r-1:ℕ)/(r:ℝ)) at hb
  have hd4 : d ≤ 4*(k:ℝ) := by linarith
  nlinarith

end Erdos571.DependentChoice


/-! Global extremal consequence of the exceptional-vertex embedding model. -/
namespace Erdos571.DependentChoice
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {L B : Type} [Fintype L] [Fintype B] [DecidableEq B]
variable (P : L → B → Prop) [DecidableRel P]

theorem model_edge_bound (s r m : ℕ) (hs : 1 ≤ s) (hsr : s ≤ r)
    (hrm : r ≤ m) (hBm : Fintype.card B ≤ m)
    (hP : ∀ l, (univ.filter (P l)).card ≤ r) :
    ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (model s P) (2-1/(r:ℝ)) C := by
  let γ : ℝ := (r-1:ℕ)/(r:ℝ)
  let D := realCoefficient (L:=L) s r m
  have hD : 0 ≤ D := realCoefficient_nonneg s r m
  have hγ : 0 ≤ γ := by dsimp [γ]; positivity
  have he : 1+γ=2-1/(r:ℝ) := by
    have hr : (0:ℝ)<r := by exact_mod_cast (show 0<r by omega)
    dsimp [γ]
    rw [Nat.cast_sub (by omega : 1 ≤ r),Nat.cast_one]
    field_simp
    ring
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  have h := bound_of_min_degree G univ (γ:=γ) (D:=D) hγ hD (by
    intro T hT hne d hd hdeg
    letI : Nonempty T := hne.to_subtype
    let F := G.induce (T:Set W)
    have hfree : (model s P).Free F := fun h => hf (h.trans ⟨Copy.induce G (T:Set W)⟩)
    have hh := free_min_degree P F s r m hs hsr hrm hBm hP hfree d hd (fun x => by
      simpa only [F,TreeCopiesIn.induce_degree] using hdeg x.val x.property)
    have hc : Fintype.card ↑(T:Set W)=T.card := by
      rw [←Nat.card_eq_fintype_card,Nat.card_coe_set_eq,Set.ncard_coe_finset]
    simpa only [hc] using hh)
  have ha : (arcs G univ).card = 2*Nat.card G.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors G univ w = G.neighborFinset w := by
      ext v
      simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using G.sum_degrees_eq_twice_card_edges
  rw [ha,card_univ,he,Nat.cast_mul,Nat.cast_ofNat] at h
  have hn : (0:ℝ) ≤ Nat.card G.edgeSet := Nat.cast_nonneg _
  linarith

end Erdos571.DependentChoice


/-! A sharper multiplicity-independent upper exponent for the unsubdivided
ThreeHub power. This is not its sharp rooted-density upper bound. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHub
open Finset SimpleGraph ProjectionHeavy

abbrev DRCLow (M : ℕ) := Fin M × Bool
abbrev DRCRight (s M : ℕ) := Fin M ⊕ (Bool × Fin s)

def drcRel (s M : ℕ) (a : DRCLow M) : DRCRight s M → Prop
  | .inl i => a.1=i
  | .inr p => a.2=p.1

instance (s M : ℕ) : DecidableRel (drcRel s M) := fun a b => by
  cases b <;> dsimp [drcRel] <;> infer_instance

lemma drcRel_degree (s M : ℕ) (a : DRCLow M) :
    (univ.filter (drcRel s M a)).card ≤ s+1 := by
  classical
  have he : univ.filter (drcRel s M a) =
      {Sum.inl a.1} ∪ (univ.image (fun j : Fin s => Sum.inr (a.2,j))) := by
    ext b
    cases b with
    | inl b => simp [drcRel,eq_comm]
    | inr p => rcases p with ⟨c,j⟩; simp [drcRel,eq_comm]
  rw [he]
  exact (card_union_le _ _).trans (by
    have h : (univ.image (fun j : Fin s => (Sum.inr (a.2,j) : DRCRight s M))).card ≤ (univ : Finset (Fin s)).card := card_image_le
    simpa only [card_singleton,card_univ,Fintype.card_fin,add_comm] using Nat.add_le_add_left h 1)

def drcCoreMap (s M : ℕ) (p : Fin M × Fin 3) : (Fin s ⊕ DRCLow M) ⊕ DRCRight s M :=
  if p.2=1 then .inr (.inl p.1) else .inl (.inr (p.1,decide (p.2=2)))

def drcRootMap (s M : ℕ) (hs : 1 ≤ s) (r : BaseRoot s) :
    (Fin s ⊕ DRCLow M) ⊕ DRCRight s M :=
  let j : Fin s := ⟨r.2.val,by simpa only [counts_eq s hs r.1] using r.2.isLt⟩
  if r.1=1 then .inl (.inl j) else .inr (.inr (decide (r.1=2),j))

lemma drcCoreMap_injective (s M : ℕ) : Function.Injective (drcCoreMap s M) := by
  rintro ⟨a,i⟩ ⟨b,j⟩ h
  fin_cases i <;> fin_cases j <;> simp_all [drcCoreMap]

lemma drcRootMap_injective (s M : ℕ) (hs : 1 ≤ s) :
    Function.Injective (drcRootMap s M hs) := by
  rintro ⟨i,a⟩ ⟨j,b⟩ h
  fin_cases i <;> fin_cases j <;> simp [drcRootMap,Fin.ext_iff] at h ⊢
  all_goals first | contradiction | exact h

lemma drcMap_disjoint (s M : ℕ) (hs : 1 ≤ s) (p : Fin M × Fin 3) (r : BaseRoot s) :
    drcCoreMap s M p ≠ drcRootMap s M hs r := by
  obtain ⟨a,i⟩ := p
  obtain ⟨j,b⟩ := r
  fin_cases i <;> fin_cases j <;> simp [drcCoreMap,drcRootMap]

def drcBaseCopy (s M : ℕ) (hs : 1 ≤ s) :
    (FullRootedPower.graph (base s) M).Copy (DependentChoice.model s (drcRel s M)) where
  toHom := ⟨Sum.elim (drcCoreMap s M) (drcRootMap s M hs),by
    intro u v h
    cases u with
    | inl u => cases v with
      | inl v =>
        obtain ⟨a,i⟩ := u
        obtain ⟨b,j⟩ := v
        change a=b ∧ (pathGraph 3).Adj i j at h
        obtain ⟨rfl,h⟩ := h
        fin_cases i <;> fin_cases j <;>
          simp_all [drcCoreMap,DependentChoice.model,SixCycleCase.bipGraph,drcRel,pathGraph_adj]
      | inr r =>
        obtain ⟨a,i⟩ := u
        obtain ⟨j,b⟩ := r
        change i=j at h
        subst j
        fin_cases i <;>
          simp [drcCoreMap,drcRootMap,DependentChoice.model,SixCycleCase.bipGraph,drcRel]
    | inr r => cases v with
      | inl v =>
        obtain ⟨j,b⟩ := r
        obtain ⟨a,i⟩ := v
        change j=i at h
        subst j
        fin_cases i <;>
          simp [drcCoreMap,drcRootMap,DependentChoice.model,SixCycleCase.bipGraph,drcRel]
      | inr q => exact h.elim⟩
  injective' := Sum.elim_injective.mpr
    ⟨drcCoreMap_injective s M,drcRootMap_injective s M hs,drcMap_disjoint s M hs⟩

theorem drc_base_edge_bound (s M : ℕ) (hs : 1 ≤ s) :
    ∃ C : ℝ, 0 ≤ C ∧ EdgeBound (FullRootedPower.graph (base s) M)
      (2-1/((s:ℝ)+1)) C := by
  obtain ⟨C,hC,h⟩ := DependentChoice.model_edge_bound (drcRel s M)
    s (s+1) (s+1+Fintype.card (DRCRight s M)) hs (by omega) (by omega)
    (by omega) (drcRel_degree s M)
  refine ⟨C,hC,?_⟩
  simpa only [Nat.cast_add,Nat.cast_one] using h.mono ⟨drcBaseCopy s M hs⟩

end Erdos571.ThreeHub


/-! An improved subquadratic operator bound for actual light four-walk channels
in ThreeHub-free hosts. This is not yet a bound for the full pin energy. -/
namespace Erdos571.ThreeHub
open Finset SimpleGraph Matrix ProjectionHeavy

lemma drc_base_exponent_bounds (s : ℕ) :
    1 ≤ (2-1/((s:ℝ)+1)) ∧ (2-1/((s:ℝ)+1)) < 2 := by
  have hs : (0:ℝ) ≤ s := Nat.cast_nonneg _
  have hp : (0:ℝ) < (s:ℝ)+1 := by positivity
  have hi : 1/((s:ℝ)+1) ≤ 1 := (div_le_one hp).mpr (by linarith)
  have hi0 : 0 < 1/((s:ℝ)+1) := by positivity
  constructor <;> linarith

/-- No global codegree assumption: the endpoint cap is local, and every
other necessary cap is part of `LightFourChannel.middles`. -/
theorem drc_light_channel_operator (s M : ℕ) (hs : 1 ≤ s) (L : ℕ) (Q : ℝ) (hQ : 0 ≤ Q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {W : Type} [Fintype W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], (graph s M).Free G → G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ x, (G.degree x:ℝ) ≤ Q*d) →
      ∀ u r : W, Fintype.card (G.commonNeighbors u r) ≤ L → ∀ T : ℝ,
      ∀ P : Matrix (CrossThirdOperator.cut G u r T) (CrossThirdOperator.cut G r u T) ℝ,
      (∀ x z, 0≤P x z ∧ P x z≤LightFourChannel.matrix G u r T L x z) →
      ∀ f : CrossThirdOperator.cut G r u T → ℝ,
        (∑ x, (∑ z, P x z*f z)^2) ≤
          C*d^(2-1/((s:ℝ)+1))*∑ z, (f z)^2 := by
  obtain ⟨B,hB,hbound⟩ := drc_base_edge_bound s (M+1) hs
  let α : ℝ := 2-1/((s:ℝ)+1)
  let C₀ : ℝ := 2*(L+(2*L)^2:ℕ)*B*(2*Q)^α+(L:ℝ)*Q
  refine ⟨(L:ℝ)*C₀,by dsimp [C₀]; positivity,?_⟩
  intro W _ _ G _ hf hb d hd hdeg u r hcap T P hP f
  have hd0 : 0<d := by linarith
  have h := LocalMaskedTrace.normalized_bound _ (base_power_no_isolated s M)
    (drc_base_exponent_bounds s).1 hB hbound G (subdivision_free s M G hf) hb
    L d Q hd hQ hdeg u r hcap
  change (LocalMaskedTrace.maskedWalks G L u r).card/d^2 ≤ C₀*d^(α-2) at h
  have hcard : ((LocalMaskedTrace.maskedWalks G L u r).card:ℝ) ≤ C₀*d^α := by
    have h' := (div_le_iff₀ (sq_pos_of_pos hd0)).mp h
    have he : d^(α-2)*d^2=d^α := by
      rw [←Real.rpow_natCast,←Real.rpow_add hd0]
      congr 1
      norm_num
    simpa only [mul_assoc,he] using h'
  have hcoef : (L:ℝ)*(LocalMaskedTrace.maskedWalks G L u r).card ≤ (L:ℝ)*C₀*d^α := by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hcard (Nat.cast_nonneg L)
  exact (LightFourChannel.dominated_operator_le G u r T L P hP f).trans
    (mul_le_mul_of_nonneg_right hcoef (sum_nonneg (fun z _ => sq_nonneg _)))

end Erdos571.ThreeHub

/-! A dimension-free square-sum bound from sub-square-root subset masses. -/
set_option maxHeartbeats 2000000
namespace Erdos571.HereditarySpectral
open Finset

noncomputable def series (b : ℝ) : ℝ := ∑' k : ℕ, (k:ℝ)^(2*b-2)

lemma series_nonneg (b : ℝ) : 0 ≤ series b :=
  tsum_nonneg (fun k => Real.rpow_nonneg (Nat.cast_nonneg k) _)

/-- A hereditary mass bound with exponent below one half controls the full
square sum, with no dimension factor. -/
theorem square_sum_of_subsets {V : Type*} [Fintype V] (w : V → ℝ)
    {b C : ℝ} (hb : b < 1/2) (hC : 0 ≤ C) (hw : ∀ x, 0 ≤ w x)
    (hset : ∀ S : Finset V, ∑ x∈S, w x ≤ C*(S.card:ℝ)^b) :
    ∑ x, (w x)^2 ≤ C^2*series b := by
  classical
  let n := Fintype.card V
  let e₀ : Fin n ≃ V := (Fintype.equivFin V).symm
  let σ := Tuple.sort (fun i : Fin n => -w (e₀ i))
  let e : Fin n ≃ V := σ.trans e₀
  have hanti : Antitone (fun i : Fin n => w (e i)) := by
    intro i j hij
    have h := Tuple.monotone_sort (fun i : Fin n => -w (e₀ i)) hij
    exact neg_le_neg_iff.mp h
  have hpoint (i : Fin n) : w (e i) ≤ C*((i.val+1:ℕ):ℝ)^(b-1) := by
    let S := (Iic i).map e.toEmbedding
    have hc : S.card = i.val+1 := by simp [S,Fin.card_Iic]
    have hm : ((i.val+1:ℕ):ℝ)*w (e i) ≤ ∑ x∈S, w x := by
      rw [←hc]
      calc
        _ = ∑ _x∈S, w (e i) := by simp
        _ ≤ _ := by
          apply sum_le_sum
          intro x hx
          obtain ⟨j,hj,rfl⟩ := mem_map.mp hx
          exact hanti (mem_Iic.mp hj)
    have h := hm.trans (hset S)
    rw [hc] at h
    have hi : (0:ℝ) < ((i.val+1:ℕ):ℝ) := by positivity
    have hh : w (e i) ≤ C*((i.val+1:ℕ):ℝ)^b / ((i.val+1:ℕ):ℝ) :=
      (le_div_iff₀ hi).mpr (by simpa only [mul_comm] using h)
    simpa only [Real.rpow_sub hi,Real.rpow_one,mul_div_assoc] using hh
  have hp : Summable (fun k : ℕ => (k:ℝ)^(2*b-2)) :=
    Real.summable_nat_rpow.mpr (by linarith)
  have hs : (∑ i : Fin n, ((i.val+1:ℕ):ℝ)^(2*b-2)) ≤ series b := by
    have h := hp.sum_le_tsum ((univ : Finset (Fin n)).image (fun i => i.val+1))
      (fun k _ => Real.rpow_nonneg (Nat.cast_nonneg k) (2*b-2))
    rw [sum_image] at h
    · exact h
    · intro i _ j _ hij
      exact Fin.ext (Nat.add_right_cancel hij)
  calc
    _ = ∑ i : Fin n, (w (e i))^2 := (e.sum_comp (fun x => (w x)^2)).symm
    _ ≤ ∑ i : Fin n, C^2*((i.val+1:ℕ):ℝ)^(2*b-2) := by
      apply sum_le_sum
      intro i _
      have hh := pow_le_pow_left₀ (hw (e i)) (hpoint i) 2
      rw [mul_pow,←Real.rpow_mul_natCast (by positivity)] at hh
      convert hh using 1 <;> congr 2 <;> ring
    _ = C^2*∑ i : Fin n, ((i.val+1:ℕ):ℝ)^(2*b-2) := (mul_sum _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hs (sq_nonneg C)


/-- Rectangular hereditary mass bounds extend to arbitrary signed vectors.
The exponent restriction makes the constant independent of both dimensions. -/
theorem operator_of_rectangles {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℝ) {b C : ℝ} (hb : b < 1/2) (hC : 0 ≤ C)
    (hA : ∀ x y, 0 ≤ A x y)
    (hrect : ∀ (S : Finset I) (T : Finset J),
      (∑ x∈S, ∑ y∈T, A x y) ≤ C*(S.card:ℝ)^b*(T.card:ℝ)^b)
    (f : J → ℝ) :
    (∑ x, (∑ y, A x y*f y)^2) ≤ C^2*(series b)^2*∑ y, (f y)^2 := by
  classical
  let F : ℝ := ∑ y, (f y)^2
  let R : ℝ := Real.sqrt (series b*F)
  have hF : 0 ≤ F := sum_nonneg (fun _ _ => sq_nonneg _)
  have hR : 0 ≤ R := Real.sqrt_nonneg _
  have hR2 : R^2=series b*F := Real.sq_sqrt (mul_nonneg (series_nonneg b) hF)
  let g : I → ℝ := fun x => ∑ y, A x y*|f y|
  have hg : ∀ x, 0 ≤ g x := fun x =>
    sum_nonneg (fun y _ => mul_nonneg (hA x y) (abs_nonneg _))
  have hsub (S : Finset I) : (∑ x∈S, g x) ≤ (C*R)*(S.card:ℝ)^b := by
    let w : J → ℝ := fun y => ∑ x∈S, A x y
    have hw : ∀ y, 0 ≤ w y := fun y => sum_nonneg (fun x _ => hA x y)
    have hm := square_sum_of_subsets w hb
      (show 0 ≤ C*(S.card:ℝ)^b by positivity) hw (fun T => by
        change (∑ y∈T, ∑ x∈S, A x y) ≤ _
        rw [sum_comm]
        exact hrect S T)
    have hcs := sum_mul_sq_le_sq_mul_sq univ w (fun y => |f y|)
    simp only [sq_abs] at hcs
    have he : (∑ x∈S, g x)=∑ y, w y*|f y| := by
      simp only [g,w,sum_mul]
      exact sum_comm
    have hsq : (∑ x∈S, g x)^2 ≤ ((C*R)*(S.card:ℝ)^b)^2 := by
      rw [he]
      calc
        _ ≤ (∑ y, (w y)^2)*F := hcs
        _ ≤ (C*(S.card:ℝ)^b)^2*series b*F := by
          exact mul_le_mul_of_nonneg_right hm hF
        _ = ((C*R)*(S.card:ℝ)^b)^2 := by simp only [mul_pow,hR2]; ring
    exact (sq_le_sq₀ (sum_nonneg (fun x _ => hg x)) (by positivity)).mp hsq
  have hmain := square_sum_of_subsets g hb (mul_nonneg hC hR) hg hsub
  calc
    _ ≤ ∑ x, (g x)^2 := by
      apply sum_le_sum
      intro x _
      have h : |∑ y, A x y*f y| ≤ g x := by
        apply (abs_sum_le_sum_abs _ _).trans_eq
        simp only [g,abs_mul,abs_of_nonneg (hA x _)]
      simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg _) h 2
    _ ≤ (C*R)^2*series b := hmain
    _ = _ := by rw [mul_pow,hR2]; dsimp only [F]; ring

/-- Averaging over equal-size restrictions strengthens an induced-style
bound to a genuinely rectangular one. -/
theorem rectangle_mul {I J : Type*} [DecidableEq I] [DecidableEq J]
    (A : I → J → ℝ) (S : Finset I) (T : Finset J) {α K : ℝ}
    (hα : 0 ≤ α) (hK : 0 ≤ K) (hs : 0 < S.card) (hst : S.card ≤ T.card)
    (hlocal : ∀ Q ⊆ T, (∑ x∈S, ∑ y∈Q, A x y) ≤ K*((S.card:ℝ)+Q.card)^α) :
    (S.card:ℝ)*(∑ x∈S, ∑ y∈T, A x y) ≤
      K*T.card*(2*(S.card:ℝ))^α := by
  have h := NeighborhoodEnergy.mass_of_small_subsets T (fun y => ∑ x∈S, A x y)
    S.card hs (K*(2*(S.card:ℝ))^α) hst (by
      intro Q hQT hQc
      have hsize : (S.card:ℝ)+Q.card ≤ 2*(S.card:ℝ) := by exact_mod_cast (show S.card+Q.card ≤ 2*S.card by omega)
      exact (show (∑ y∈Q, ∑ x∈S, A x y) ≤ K*((S.card:ℝ)+Q.card)^α by
        rw [sum_comm]
        exact hlocal Q hQT).trans
          (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by positivity) hsize hα) hK))
  rw [sum_comm] at h
  convert h using 1 <;> ring


lemma rectangle_of_local_le {I J : Type*} [DecidableEq I] [DecidableEq J]
    (A : I → J → ℝ) (S : Finset I) (T : Finset J) {α b K N : ℝ}
    (hα : 0 ≤ α) (hK : 0 ≤ K) (hb1 : b ≤ 1) (hbα : b ≤ α-1)
    (hs : 0 < S.card) (hst : S.card ≤ T.card)
    (hSN : (S.card:ℝ) ≤ N) (hTN : (T.card:ℝ) ≤ N)
    (hlocal : ∀ Q ⊆ T, (∑ x∈S, ∑ y∈Q, A x y) ≤ K*((S.card:ℝ)+Q.card)^α) :
    (∑ x∈S, ∑ y∈T, A x y) ≤
      (2^α*K*N^(α-2*b))*(S.card:ℝ)^b*(T.card:ℝ)^b := by
  have hs' : (0:ℝ) < S.card := by exact_mod_cast hs
  have ht' : (0:ℝ) < T.card := hs'.trans_le (by exact_mod_cast hst)
  have hN : 0 < N := hs'.trans_le hSN
  have hm := rectangle_mul A S T hα hK hs hst hlocal
  have hraw : (∑ x∈S, ∑ y∈T, A x y) ≤
      2^α*K*(S.card:ℝ)^(α-1)*T.card := by
    apply (mul_le_mul_iff_right₀ hs').mp
    calc
      _ ≤ K*T.card*(2*(S.card:ℝ))^α := hm
      _ = _ := by
        rw [Real.mul_rpow (by norm_num : (0:ℝ)≤2) hs'.le,
          Real.rpow_sub hs',Real.rpow_one]
        field_simp
  have hsmall := Real.rpow_le_rpow hs'.le hSN (sub_nonneg.mpr hbα)
  have hlarge := Real.rpow_le_rpow ht'.le hTN (sub_nonneg.mpr hb1)
  have hpow : (S.card:ℝ)^(α-1-b)*(T.card:ℝ)^(1-b) ≤ N^(α-2*b) := by
    have h := mul_le_mul hsmall hlarge (Real.rpow_nonneg ht'.le _)
      (Real.rpow_nonneg hN.le _)
    rw [←Real.rpow_add hN] at h
    convert h using 1 <;> congr 1 <;> ring
  have hid : (S.card:ℝ)^(α-1)*(T.card:ℝ) =
      ((S.card:ℝ)^b*(T.card:ℝ)^b)*
        ((S.card:ℝ)^(α-1-b)*(T.card:ℝ)^(1-b)) := by
    calc
      _ = (S.card:ℝ)^(b+(α-1-b))*(T.card:ℝ)^(b+(1-b)) := by
        congr 1 <;> simp only [add_sub_cancel]; rw [Real.rpow_one]
      _ = _ := by rw [Real.rpow_add hs',Real.rpow_add ht']; ring
  calc
    _ ≤ 2^α*K*((S.card:ℝ)^(α-1)*(T.card:ℝ)) := by simpa only [mul_assoc] using hraw
    _ = 2^α*K*(((S.card:ℝ)^b*(T.card:ℝ)^b)*
        ((S.card:ℝ)^(α-1-b)*(T.card:ℝ)^(1-b))) := by rw [hid]
    _ ≤ 2^α*K*(((S.card:ℝ)^b*(T.card:ℝ)^b)*N^(α-2*b)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hpow (by positivity)) (by positivity)
    _ = _ := by ring

/-- A hereditary bound of exponent alpha gives an L2 operator bound with
exponent arbitrarily close to alpha-1, provided alpha>3/2. -/
theorem rectangles_of_local {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℝ) {α b K N : ℝ}
    (hα : 0 ≤ α) (hK : 0 ≤ K) (hb1 : b ≤ 1) (hbα : b ≤ α-1)
    (hIN : (Fintype.card I:ℝ) ≤ N) (hJN : (Fintype.card J:ℝ) ≤ N)
    (hlocal : ∀ (S : Finset I) (T : Finset J),
      (∑ x∈S, ∑ y∈T, A x y) ≤ K*((S.card:ℝ)+T.card)^α)
    (S : Finset I) (T : Finset J) :
    (∑ x∈S, ∑ y∈T, A x y) ≤
      (2^α*K*N^(α-2*b))*(S.card:ℝ)^b*(T.card:ℝ)^b := by
  classical
  by_cases hs : S=∅
  · subst S
    simp only [sum_empty,card_empty,Nat.cast_zero]
    have hN : 0≤N := (Nat.cast_nonneg _).trans hIN
    positivity
  by_cases ht : T=∅
  · subst T
    simp only [sum_empty,sum_const_zero,card_empty,Nat.cast_zero]
    have hN : 0≤N := (Nat.cast_nonneg _).trans hIN
    positivity
  have hs' : 0<S.card := card_pos.mpr (nonempty_iff_ne_empty.mpr hs)
  have ht' : 0<T.card := card_pos.mpr (nonempty_iff_ne_empty.mpr ht)
  have hSN : (S.card:ℝ) ≤ N := (show (S.card:ℝ) ≤ Fintype.card I by exact_mod_cast card_le_univ S).trans hIN
  have hTN : (T.card:ℝ) ≤ N := (show (T.card:ℝ) ≤ Fintype.card J by exact_mod_cast card_le_univ T).trans hJN
  rcases le_total S.card T.card with hst|hts
  · exact rectangle_of_local_le A S T hα hK hb1 hbα hs' hst hSN hTN
      (fun Q _ => hlocal S Q)
  · have h := rectangle_of_local_le (fun y x => A x y) T S hα hK hb1 hbα ht' hts hTN hSN
      (fun Q _ => by rw [sum_comm]; simpa only [add_comm] using hlocal Q T)
    rw [sum_comm] at h
    convert h using 1 <;> ring

theorem operator_of_local {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℝ) {α b K N : ℝ}
    (hα : 0 ≤ α) (hK : 0 ≤ K) (hb : b < 1/2) (hbα : b ≤ α-1)
    (hIN : (Fintype.card I:ℝ) ≤ N) (hJN : (Fintype.card J:ℝ) ≤ N)
    (hA : ∀ x y, 0 ≤ A x y)
    (hlocal : ∀ (S : Finset I) (T : Finset J),
      (∑ x∈S, ∑ y∈T, A x y) ≤ K*((S.card:ℝ)+T.card)^α)
    (f : J → ℝ) :
    (∑ x, (∑ y, A x y*f y)^2) ≤
      (2^α*K*N^(α-2*b))^2*(series b)^2*∑ y, (f y)^2 := by
  have hN : 0≤N := (Nat.cast_nonneg _).trans hIN
  exact operator_of_rectangles A hb (by positivity) hA
    (rectangles_of_local A hα hK (by linarith) hbα hIN hJN hlocal) f

end Erdos571.HereditarySpectral

/-! Every rectangle in an actual light four-walk channel inherits the old
graph's extremal estimate. -/
set_option maxHeartbeats 2500000
namespace Erdos571.LightFourChannel
open Finset SimpleGraph ProjectionHeavy PatternCone BipartiteCycleBounds LocalFourthWalk LocalMaskedTrace
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- There is no diagonal correction: the channel already excludes equal
endpoints. Only counted pairs and middle vertices need codegree caps. -/
theorem hereditary_mass {V : Type} [Fintype V]
    (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (htri : ∀ x y z, G.Adj x y → G.Adj y z → ¬G.Adj x z)
    (L : ℕ) (u r : W) (S T : Finset W)
    (hS : S ⊆ G.neighborFinset u) (hT : T ⊆ G.neighborFinset r) :
    (∑ x∈S, ∑ z∈T, ((middles G u r L x z).card:ℝ)) ≤
      2*(L+(2*L)^2:ℕ)*C*((S.card:ℝ)+T.card)^α := by
  classical
  let A := S∪T
  let B := (univ \ (A∪{u,r})).filter (fun v =>
    (common G u v).card ≤ L ∧ (common G r v).card ≤ L)
  let E := (A×ˢB).filter (fun p => G.Adj p.1 p.2)
  let O := lightCandidates G L E B
  let F := ((S×ˢT).sigma (fun p => middles G u r L p.1 p.2)).map
    (⟨fun p : (p : W×W) × W => (p.1,p.2),by
      intro p q h
      cases p
      cases q
      cases h
      rfl⟩ : ((p : W×W) × W) ↪ ((W×W)×W))
  have hEA : ∀ p∈E, p.1∈A := by
    intro p hp
    exact (mem_product.mp (mem_filter.mp hp).1).1
  have hdis : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro x hx hxB
    exact (Finset.mem_sdiff.mp (mem_filter.mp hxB).1).2 (mem_union_left _ hx)
  have hfree : ¬Contains (incidence H) E univ B :=
    contains_univ_false H hH A B E hEA
      (PatternCone.cut_not_contains (incidence H) G hf A B hdis)
  have hmid (v : W) (hv : v∈B) : (nl E univ v).card ≤ 2*L := by
    have hs : nl E univ v ⊆ common G u v ∪ common G r v := by
      intro x hx
      have he := (mem_filter.mp hx).2
      have hxa := hEA _ he
      have hxv := (mem_filter.mp he).2
      rcases mem_union.mp hxa with hxu|hxr
      · exact mem_union_left _ ((mem_common G u v x).mpr
          ⟨(G.mem_neighborFinset _ _).mp (hS hxu),hxv.symm⟩)
      · exact mem_union_right _ ((mem_common G r v x).mpr
          ⟨(G.mem_neighborFinset _ _).mp (hT hxr),hxv.symm⟩)
    have hc := (mem_filter.mp hv).2
    exact (card_le_card hs).trans ((card_union_le _ _).trans (by omega))
  have hF : ∀ t∈F, (s(t.1.1,t.1.2),t.2)∈O := by
    intro t ht
    obtain ⟨⟨⟨x,z⟩,v⟩,hp,rfl⟩ := mem_map.mp ht
    obtain ⟨hxz,hv⟩ := mem_sigma.mp hp
    obtain ⟨hx,hz⟩ := mem_product.mp hxz
    obtain ⟨hxv,hzv,hvu,hvr,hlu,hlr,hnxz,hlxz⟩ := (mem_middles G u r L x z v).mp hv
    have hvB : v∈B := by
      apply mem_filter.mpr
      refine ⟨Finset.mem_sdiff.mpr ⟨mem_univ _,?_⟩,hlu,hlr⟩
      intro hvA
      rcases mem_union.mp hvA with hvA|hvA
      · rcases mem_union.mp hvA with hu|hr
        · exact htri u x v ((G.mem_neighborFinset _ _).mp (hS hx)) hxv
            ((G.mem_neighborFinset _ _).mp (hS hu))
        · exact htri r z v ((G.mem_neighborFinset _ _).mp (hT hz)) hzv
            ((G.mem_neighborFinset _ _).mp (hT hr))
      · simp only [mem_insert,mem_singleton] at hvA
        exact hvA.elim hvu hvr
    apply mem_filter.mpr
    refine ⟨(IncidenceTrace.mem_candidates E B _ _).mpr ⟨hvB,?_,?_⟩,
      allowedPair_mk G L _ _ hlxz⟩
    · simpa only [Sym2.isDiag_iff_proj_eq] using hnxz
    · intro y hy
      rcases Sym2.mem_iff.mp hy with rfl|rfl
      · exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_union_left _ hx,hvB⟩,hxv⟩
      · exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_union_right _ hz,hvB⟩,hzv⟩
  have hfc := IncidenceTrace.oriented_restricted_card_le O F hF
  have ht := IncidenceTrace.restricted_trace_on H hbound E A B O
    (lightCandidates_subset G L E B) hEA hfree L ((2*L)^2)
    (lightCandidates_row_cap G L E B (fun p hp => (mem_filter.mp hp).2))
    (lightCandidates_column_cap G L (2*L) E B hmid)
  have hc : (F.card:ℝ) = ∑ x∈S, ∑ z∈T, ((middles G u r L x z).card:ℝ) := by
    simp only [F,card_map,card_sigma,Nat.cast_sum,sum_product]
  have hsize : (A.card:ℝ) ≤ (S.card:ℝ)+T.card := by
    exact_mod_cast card_union_le S T
  calc
    _ = (F.card:ℝ) := hc.symm
    _ ≤ 2*(O.card:ℝ) := by exact_mod_cast hfc
    _ ≤ 2*((L+(2*L)^2:ℕ)*C*(A.card:ℝ)^α) := mul_le_mul_of_nonneg_left ht (by norm_num)
    _ ≤ 2*((L+(2*L)^2:ℕ)*C*((S.card:ℝ)+T.card)^α) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) hsize hα) (by positivity))
        (by norm_num)
    _ = _ := by ring


/-- The hereditary bound holds on the exact cross-cut matrix domains and
survives arbitrary nonnegative entrywise domination. -/
theorem matrix_hereditary_mass {V : Type} [Fintype V]
    (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C) (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hb : G.IsBipartite)
    (L : ℕ) (u r : W) (R : ℝ)
    (P : Matrix (CrossThirdOperator.cut G u r R) (CrossThirdOperator.cut G r u R) ℝ)
    (hP : ∀ x z, P x z ≤ matrix G u r R L x z)
    (S : Finset (CrossThirdOperator.cut G u r R))
    (T : Finset (CrossThirdOperator.cut G r u R)) :
    (∑ x∈S, ∑ z∈T, P x z) ≤
      2*(L+(2*L)^2:ℕ)*C*((S.card:ℝ)+T.card)^α := by
  classical
  let S' := S.image Subtype.val
  let T' := T.image Subtype.val
  have hs : S' ⊆ G.neighborFinset u := by
    intro x hx
    obtain ⟨x,hx,rfl⟩ := mem_image.mp hx
    exact CrossThirdOperator.cut_subset G u r R x.property
  have ht : T' ⊆ G.neighborFinset r := by
    intro z hz
    obtain ⟨z,hz,rfl⟩ := mem_image.mp hz
    exact CrossThirdOperator.cut_subset G r u R z.property
  have h := hereditary_mass G H hH hα hC hbound hf
    (LocalFourthWalk.triangle_free_of_bipartite G hb) L u r S' T' hs ht
  have hsC : S'.card=S.card := card_image_of_injective S Subtype.val_injective
  have htC : T'.card=T.card := card_image_of_injective T Subtype.val_injective
  rw [hsC,htC] at h
  have he : (∑ x∈S', ∑ z∈T', ((middles G u r L x z).card:ℝ)) =
      ∑ x∈S, ∑ z∈T, matrix G u r R L x z := by
    simp only [S',T',sum_image Subtype.val_injective.injOn,matrix]
  rw [he] at h
  exact (sum_le_sum (fun x _ => sum_le_sum (fun z _ => hP x z))).trans h

end Erdos571.LightFourChannel

/-! An improved operator estimate for actual light four-walk channels. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LightFourChannel
open Finset SimpleGraph ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- Hereditary channel sparsity improves the Frobenius estimate. No endpoint
codegree assumption is needed, and the two cross-cut endpoint sets may overlap. -/
theorem hereditary_operator {V : Type} [Fintype V]
    (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α b C D : ℝ} (hα : 0 ≤ α) (hC : 0 ≤ C) (hb : b < 1/2)
    (hbα : b ≤ α-1) (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hbi : G.IsBipartite)
    (hdeg : ∀ x, (G.degree x:ℝ) ≤ D) (L : ℕ) (u r : W) (R : ℝ)
    (P : Matrix (CrossThirdOperator.cut G u r R) (CrossThirdOperator.cut G r u R) ℝ)
    (hP : ∀ x z, 0 ≤ P x z ∧ P x z ≤ matrix G u r R L x z)
    (f : CrossThirdOperator.cut G r u R → ℝ) :
    (∑ x, (∑ z, P x z*f z)^2) ≤
      (2^α*(2*(L+(2*L)^2:ℕ)*C)*D^(α-2*b))^2*
        (HereditarySpectral.series b)^2*∑ z, (f z)^2 := by
  have hcard (x y : W) : (Fintype.card (CrossThirdOperator.cut G x y R):ℝ) ≤ D := by
    have hc := card_le_card (CrossThirdOperator.cut_subset G x y R)
    rw [G.card_neighborFinset_eq_degree] at hc
    simpa only [Fintype.card_coe] using (show ((CrossThirdOperator.cut G x y R).card:ℝ) ≤ D from
      (show ((CrossThirdOperator.cut G x y R).card:ℝ) ≤ G.degree x by exact_mod_cast hc).trans (hdeg x))
  apply HereditarySpectral.operator_of_local P hα (by positivity) hb hbα
    (hcard u r) (hcard r u) (fun x z => (hP x z).1)
  exact matrix_hereditary_mass G H hH hα hC hbound hf hbi L u r R P (fun x z => (hP x z).2)

end Erdos571.LightFourChannel

namespace Erdos571.ThreeHub
open Finset SimpleGraph ProjectionHeavy

/-- The squared operator exponent can approach 2-2/(s+1) from above. This
controls arbitrary entrywise-dominated channels but not arbitrary coupled
three-branch weights. -/
theorem drc_hereditary_channel (s M L : ℕ) (hs : 1 ≤ s)
    (b Q : ℝ) (hb : b < 1/2) (hbα : b ≤ 1-1/((s:ℝ)+1)) (hQ : 0 ≤ Q) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0 < d → (∀ x, (G.degree x:ℝ) ≤ Q*d) →
      ∀ (u r : W) (T : ℝ),
      ∀ P : Matrix (CrossThirdOperator.cut G u r T) (CrossThirdOperator.cut G r u T) ℝ,
      (∀ x z, 0≤P x z ∧ P x z≤LightFourChannel.matrix G u r T L x z) →
      ∀ f : CrossThirdOperator.cut G r u T → ℝ,
        (∑ x, (∑ z, P x z*f z)^2) ≤
          C*d^(4-2/((s:ℝ)+1)-4*b)*∑ z, (f z)^2 := by
  obtain ⟨B,hB,hbound⟩ := drc_base_edge_bound s (M+1) hs
  let α : ℝ := 2-1/((s:ℝ)+1)
  let K : ℝ := 2^α*(2*(L+(2*L)^2:ℕ)*B)
  let C : ℝ := K^2*(Q^(α-2*b))^2*(HereditarySpectral.series b)^2
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg u r T P hP f
  have hbα' : b ≤ α-1 := by dsimp [α]; linarith
  have h := LightFourChannel.hereditary_operator G _ (base_power_no_isolated s M)
    (le_trans (by norm_num) (drc_base_exponent_bounds s).1) hB hb hbα' hbound
    (subdivision_free s M G hf) hbi hdeg L u r T P hP f
  change (∑ x, (∑ z, P x z*f z)^2) ≤
    (K*(Q*d)^(α-2*b))^2*(HereditarySpectral.series b)^2*∑ z, (f z)^2 at h
  apply h.trans_eq
  have he : ((d^(α-2*b))^2:ℝ) = d^(4-2/((s:ℝ)+1)-4*b) := by
    rw [←Real.rpow_mul_natCast hd.le]
    congr 1
    dsimp [α]
    ring
  rw [Real.mul_rpow hQ hd.le]
  simp only [mul_pow,he,C]
  ring

end Erdos571.ThreeHub

/-! Finite power sums and the sharp hereditary spectral exponent. -/
set_option maxHeartbeats 2000000
namespace Erdos571.HereditarySpectralExact
open Finset MeasureTheory

lemma finite_power_sum (n : ℕ) {p : ℝ} (hp : -1 < p) (hp0 : p ≤ 0) :
    (∑ i : Fin n, ((i.val+1:ℕ):ℝ)^p) ≤ (n:ℝ)^(p+1)/(p+1) := by
  have hint (k : ℕ) : IntervalIntegrable (fun x : ℝ => x^p) volume (k:ℝ) ((k+1:ℕ):ℝ) :=
    intervalIntegral.intervalIntegrable_rpow' hp
  have hstep (k : ℕ) : (((k+1:ℕ):ℝ)^p) ≤
      ∫ x in (k:ℝ)..((k+1:ℕ):ℝ), x^p := by
    have h := intervalIntegral.integral_mono_on_of_le_Ioo
      (show (k:ℝ) ≤ ((k+1:ℕ):ℝ) by exact_mod_cast Nat.le_succ k)
      (intervalIntegral.intervalIntegrable_const (c := ((k+1:ℕ):ℝ)^p)) (hint k)
      (fun x hx => Real.rpow_le_rpow_of_nonpos ((Nat.cast_nonneg k).trans_lt hx.1) hx.2.le hp0)
    simpa only [intervalIntegral.integral_const,Nat.cast_add,Nat.cast_one,add_sub_cancel_left,
      one_smul] using h
  rw [Fin.sum_univ_eq_sum_range (fun k : ℕ => ((k+1:ℕ):ℝ)^p)]
  calc
    _ ≤ ∑ k∈range n, ∫ x in (k:ℝ)..((k+1:ℕ):ℝ), x^p := sum_le_sum (fun k _ => hstep k)
    _ = ∫ x in (0:ℝ)..(n:ℝ), x^p := by
      simpa only [Nat.cast_zero] using intervalIntegral.sum_integral_adjacent_intervals
        (a := fun k : ℕ => (k:ℝ)) (fun k (_ : k<n) => hint k)
    _ = _ := by rw [integral_rpow (Or.inl hp),Real.zero_rpow (by linarith : p+1≠0),sub_zero]

/-- Sorting turns an affine hereditary mass bound into an affine rank bound. -/
lemma sorted_affine {V : Type*} [Fintype V] (w : V → ℝ) {b B C : ℝ}
    (hset : ∀ S : Finset V, ∑ x∈S, w x ≤ B*S.card+C*(S.card:ℝ)^b) :
    ∃ e : Fin (Fintype.card V) ≃ V,
      ∀ i, w (e i) ≤ B+C*((i.val+1:ℕ):ℝ)^(b-1) := by
  classical
  let e₀ : Fin (Fintype.card V) ≃ V := (Fintype.equivFin V).symm
  let σ := Tuple.sort (fun i => -w (e₀ i))
  let e := σ.trans e₀
  have hanti : Antitone (fun i => w (e i)) := by
    intro i j hij
    exact neg_le_neg_iff.mp (Tuple.monotone_sort (fun i => -w (e₀ i)) hij)
  refine ⟨e,fun i => ?_⟩
  let S := (Iic i).map e.toEmbedding
  have hc : S.card = i.val+1 := by simp [S,Fin.card_Iic]
  have hm : ((i.val+1:ℕ):ℝ)*w (e i) ≤ ∑ x∈S, w x := by
    rw [←hc]
    calc
      _ = ∑ _x∈S, w (e i) := by simp
      _ ≤ _ := by
        apply sum_le_sum
        intro x hx
        obtain ⟨j,hj,rfl⟩ := mem_map.mp hx
        exact hanti (mem_Iic.mp hj)
  have h := hm.trans (hset S)
  rw [hc] at h
  have hi : (0:ℝ) < ((i.val+1:ℕ):ℝ) := by positivity
  apply (mul_le_mul_iff_right₀ hi).mp
  apply h.trans_eq
  rw [Real.rpow_sub hi,Real.rpow_one]
  field_simp

/-- Above the square-root threshold, the finite-dimensional rank estimate
has the exact power of the dimension, not a logarithmic or epsilon loss. -/
theorem square_sum_affine {V : Type*} [Fintype V] (w : V → ℝ)
    {b B C : ℝ} (hb : 1/2 < b) (hb1 : b ≤ 1) (hB : 0≤B) (hC : 0≤C)
    (hw : ∀ x, 0≤w x)
    (hset : ∀ S : Finset V, ∑ x∈S, w x ≤ B*S.card+C*(S.card:ℝ)^b) :
    ∑ x, (w x)^2 ≤ 2*B^2*Fintype.card V+
      2*C^2*((Fintype.card V:ℝ)^(2*b-1)/(2*b-1)) := by
  classical
  obtain ⟨e,he⟩ := sorted_affine w hset
  have hp := finite_power_sum (Fintype.card V) (by linarith : -1<2*b-2) (by linarith : 2*b-2≤0)
  have hpow (i : Fin (Fintype.card V)) :
      ((((i.val+1:ℕ):ℝ)^(b-1))^2:ℝ) = ((i.val+1:ℕ):ℝ)^(2*b-2) := by
    rw [←Real.rpow_mul_natCast (by positivity)]
    congr 1
    ring
  calc
    _ = ∑ i, (w (e i))^2 := (e.sum_comp _).symm
    _ ≤ ∑ i : Fin (Fintype.card V), (2*B^2+2*C^2*((i.val+1:ℕ):ℝ)^(2*b-2)) := by
      apply sum_le_sum
      intro i _
      have h := pow_le_pow_left₀ (hw (e i)) (he i) 2
      have hs : (B+C*((i.val+1:ℕ):ℝ)^(b-1))^2 ≤
          2*B^2+2*(C*((i.val+1:ℕ):ℝ)^(b-1))^2 := by nlinarith [sq_nonneg (B-C*((i.val+1:ℕ):ℝ)^(b-1))]
      exact h.trans (by simpa only [mul_pow,hpow,mul_assoc] using hs)
    _ = 2*B^2*Fintype.card V+2*C^2*∑ i : Fin (Fintype.card V), ((i.val+1:ℕ):ℝ)^(2*b-2) := by
      simp only [sum_add_distrib,sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,mul_sum]
      ring
    _ ≤ _ := by
      have hh := mul_le_mul_of_nonneg_left hp (by positivity : 0≤2*C^2)
      have he : 2*b-2+1=2*b-1 := by ring
      rw [he] at hh
      exact add_le_add le_rfl hh


noncomputable def coefficient (a : ℝ) : ℝ := 2+2/(2*a-1)

lemma coefficient_nonneg {a : ℝ} (ha : 1/2<a) : 0≤coefficient a := by
  unfold coefficient
  have h : 0<2*a-1 := by linarith
  positivity

lemma size_power_trade {s N a : ℝ} (hs : 0≤s) (hsN : s≤N)
    (ha : 1/2<a) (ha1 : a≤1) : s^2*N^(2*a-1) ≤ N*s^(2*a) := by
  by_cases hs0 : s=0
  · subst s
    rw [zero_pow (by omega : (2:ℕ)≠0),zero_mul,Real.zero_rpow (by linarith : 2*a≠0),mul_zero]
  have hs' : 0<s := lt_of_le_of_ne hs (Ne.symm hs0)
  have hN : 0<N := hs'.trans_le hsN
  have h := mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow hs hsN (by linarith : 0≤2-2*a))
    (show 0≤s^(2*a)*N^(2*a-1) by positivity)
  have hleft : s^(2*a)*N^(2*a-1)*s^(2-2*a)=s^2*N^(2*a-1) := by
    rw [mul_right_comm,←Real.rpow_add hs']
    norm_num
  have hright : s^(2*a)*N^(2*a-1)*N^(2-2*a)=N*s^(2*a) := by
    rw [mul_assoc,←Real.rpow_add hN]
    have he : 2*a-1+(2-2*a)=1 := by ring
    rw [he,Real.rpow_one,mul_comm]
  rwa [hleft,hright] at h

lemma square_sum_power {V : Type*} [Fintype V] (w : V → ℝ)
    {a C N : ℝ} (ha : 1/2<a) (ha1 : a≤1) (hC : 0≤C)
    (hN : (Fintype.card V:ℝ)≤N) (hw : ∀ x, 0≤w x)
    (hset : ∀ S : Finset V, ∑ x∈S, w x ≤ C*(S.card:ℝ)^a) :
    ∑ x, (w x)^2 ≤ coefficient a*C^2*N^(2*a-1) := by
  have h := square_sum_affine w ha ha1 (B:=0) (by norm_num) hC hw
    (fun S => by simpa only [zero_mul,zero_add] using hset S)
  have hq : 0<2*a-1 := by linarith
  simp only [zero_pow (by omega : (2:ℕ)≠0),mul_zero,zero_mul,zero_add] at h
  have hp := Real.rpow_le_rpow (Nat.cast_nonneg _) hN hq.le
  calc
    _ ≤ 2*C^2*((Fintype.card V:ℝ)^(2*a-1)/(2*a-1)) := h
    _ = (2/(2*a-1))*C^2*(Fintype.card V:ℝ)^(2*a-1) := by ring
    _ ≤ coefficient a*C^2*(Fintype.card V:ℝ)^(2*a-1) := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      apply mul_le_mul_of_nonneg_right _ (sq_nonneg C)
      dsimp [coefficient]
      linarith
    _ ≤ _ := mul_le_mul_of_nonneg_left hp (mul_nonneg (coefficient_nonneg ha) (sq_nonneg C))

/-- The exact spectral exponent from the unequal-side rectangular bound. -/
theorem operator_of_rectangles {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℝ) {a K N : ℝ}
    (ha : 1/2<a) (ha1 : a≤1) (hK : 0≤K)
    (hIN : (Fintype.card I:ℝ)≤N) (hJN : (Fintype.card J:ℝ)≤N)
    (hA : ∀ x y, 0≤A x y)
    (hrect : ∀ (S : Finset I) (T : Finset J),
      (∑ x∈S, ∑ y∈T, A x y) ≤
        K*((S.card:ℝ)^a*T.card+S.card*(T.card:ℝ)^a))
    (f : J → ℝ) :
    (∑ x, (∑ y, A x y*f y)^2) ≤
      (coefficient a)^2*K^2*N^(2*a)*∑ y, (f y)^2 := by
  classical
  have hN : 0≤N := (Nat.cast_nonneg _).trans hIN
  have hq : 0<2*a-1 := by linarith
  let F : ℝ := ∑ y, (f y)^2
  let R : ℝ := Real.sqrt (coefficient a*N*F)
  have hF : 0≤F := sum_nonneg (fun _ _ => sq_nonneg _)
  have hR : 0≤R := Real.sqrt_nonneg _
  have hR2 : R^2=coefficient a*N*F := Real.sq_sqrt (by
    have hc := coefficient_nonneg ha
    positivity)
  let g : I → ℝ := fun x => ∑ y, A x y*|f y|
  have hg : ∀ x, 0≤g x := fun x => sum_nonneg (fun y _ => mul_nonneg (hA x y) (abs_nonneg _))
  have hsub (S : Finset I) : (∑ x∈S, g x) ≤ (K*R)*(S.card:ℝ)^a := by
    let w : J → ℝ := fun y => ∑ x∈S, A x y
    have hw : ∀ y, 0≤w y := fun y => sum_nonneg (fun x _ => hA x y)
    have hSN : (S.card:ℝ)≤N :=
      (show (S.card:ℝ)≤Fintype.card I by exact_mod_cast card_le_univ S).trans hIN
    have hm := square_sum_affine w ha ha1
      (B:=K*(S.card:ℝ)^a) (C:=K*S.card) (by positivity) (by positivity) hw (fun T => by
        change (∑ y∈T, ∑ x∈S, A x y) ≤ _
        rw [sum_comm]
        exact (hrect S T).trans_eq (by ring))
    have hp := Real.rpow_le_rpow (Nat.cast_nonneg _) hJN hq.le
    have ht := size_power_trade (Nat.cast_nonneg S.card) hSN ha ha1
    have hsqpow : ((S.card:ℝ)^a)^2 = (S.card:ℝ)^(2*a) := by
      rw [←Real.rpow_mul_natCast (Nat.cast_nonneg _)]
      congr 1
      ring
    have hm' : (∑ y, (w y)^2) ≤ coefficient a*K^2*N*(S.card:ℝ)^(2*a) := by
      calc
        _ ≤ 2*(K*(S.card:ℝ)^a)^2*Fintype.card J+
            2*(K*S.card)^2*((Fintype.card J:ℝ)^(2*a-1)/(2*a-1)) := hm
        _ ≤ 2*(K*(S.card:ℝ)^a)^2*N+
            2*(K*S.card)^2*(N^(2*a-1)/(2*a-1)) := by
          exact add_le_add (mul_le_mul_of_nonneg_left hJN (by positivity))
            (mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hp hq.le) (by positivity))
        _ = 2*K^2*N*(S.card:ℝ)^(2*a)+
            (2*K^2/(2*a-1))*((S.card:ℝ)^2*N^(2*a-1)) := by
          simp only [mul_pow,hsqpow]
          ring
        _ ≤ 2*K^2*N*(S.card:ℝ)^(2*a)+
            (2*K^2/(2*a-1))*(N*(S.card:ℝ)^(2*a)) := by
          exact add_le_add le_rfl (mul_le_mul_of_nonneg_left ht (by positivity))
        _ = _ := by dsimp [coefficient]; ring
    have hcs := sum_mul_sq_le_sq_mul_sq univ w (fun y => |f y|)
    simp only [sq_abs] at hcs
    have he : (∑ x∈S, g x)=∑ y, w y*|f y| := by
      simp only [g,w,sum_mul]
      exact sum_comm
    have hsq : (∑ x∈S, g x)^2 ≤ ((K*R)*(S.card:ℝ)^a)^2 := by
      rw [he]
      calc
        _ ≤ (∑ y, (w y)^2)*F := hcs
        _ ≤ (coefficient a*K^2*N*(S.card:ℝ)^(2*a))*F := mul_le_mul_of_nonneg_right hm' hF
        _ = _ := by simp only [mul_pow,hR2,hsqpow]; ring
    exact (sq_le_sq₀ (sum_nonneg (fun x _ => hg x)) (by positivity)).mp hsq
  have hmain := square_sum_power g ha ha1 (mul_nonneg hK hR) hIN hg hsub
  have hpowN : N*N^(2*a-1)=N^(2*a) := by
    by_cases hz : N=0
    · subst N
      rw [zero_mul,Real.zero_rpow (by linarith : 2*a≠0)]
    have hN' : 0<N := lt_of_le_of_ne hN (Ne.symm hz)
    nth_rw 1 [←Real.rpow_one N]
    rw [←Real.rpow_add hN']
    congr 1
    ring
  calc
    _ ≤ ∑ x, (g x)^2 := by
      apply sum_le_sum
      intro x _
      have h : |∑ y, A x y*f y| ≤ g x := by
        apply (abs_sum_le_sum_abs _ _).trans_eq
        simp only [g,abs_mul,abs_of_nonneg (hA x _)]
      simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg _) h 2
    _ ≤ coefficient a*(K*R)^2*N^(2*a-1) := hmain
    _ = (coefficient a)^2*K^2*(N*N^(2*a-1))*F := by rw [mul_pow,hR2]; ring
    _ = _ := by rw [hpowN]

end Erdos571.HereditarySpectralExact

/-! Exact hereditary spectral growth for local induced-style mass bounds. -/
set_option maxHeartbeats 2000000
namespace Erdos571.HereditarySpectralExact
open Finset

lemma rectangle_raw {I J : Type*} [DecidableEq I] [DecidableEq J]
    (A : I → J → ℝ) (S : Finset I) (T : Finset J) {α K : ℝ}
    (hα : 0≤α) (hK : 0≤K) (hs : 0<S.card) (hst : S.card≤T.card)
    (hlocal : ∀ Q ⊆ T, (∑ x∈S, ∑ y∈Q, A x y) ≤ K*((S.card:ℝ)+Q.card)^α) :
    (∑ x∈S, ∑ y∈T, A x y) ≤ 2^α*K*(S.card:ℝ)^(α-1)*T.card := by
  have hs' : (0:ℝ)<S.card := by exact_mod_cast hs
  have hm := HereditarySpectral.rectangle_mul A S T hα hK hs hst hlocal
  apply (mul_le_mul_iff_right₀ hs').mp
  calc
    _ ≤ K*T.card*(2*(S.card:ℝ))^α := hm
    _ = _ := by
      rw [Real.mul_rpow (by norm_num : (0:ℝ)≤2) hs'.le,
        Real.rpow_sub hs',Real.rpow_one]
      field_simp

theorem rectangles_of_local {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℝ) {α K : ℝ} (hα : 0≤α) (hK : 0≤K)
    (hlocal : ∀ (S : Finset I) (T : Finset J),
      (∑ x∈S, ∑ y∈T, A x y) ≤ K*((S.card:ℝ)+T.card)^α)
    (S : Finset I) (T : Finset J) :
    (∑ x∈S, ∑ y∈T, A x y) ≤
      (2^α*K)*((S.card:ℝ)^(α-1)*T.card+S.card*(T.card:ℝ)^(α-1)) := by
  classical
  by_cases hs : S=∅
  · subst S
    simp only [sum_empty,card_empty,Nat.cast_zero,zero_mul,add_zero]
    positivity
  by_cases ht : T=∅
  · subst T
    simp only [sum_empty,sum_const_zero,card_empty,Nat.cast_zero,mul_zero,zero_add]
    positivity
  have hs' : 0<S.card := card_pos.mpr (nonempty_iff_ne_empty.mpr hs)
  have ht' : 0<T.card := card_pos.mpr (nonempty_iff_ne_empty.mpr ht)
  rcases le_total S.card T.card with hst|hts
  · have h := rectangle_raw A S T hα hK hs' hst (fun Q _ => hlocal S Q)
    calc
      _ ≤ 2^α*K*((S.card:ℝ)^(α-1)*T.card) := by simpa only [mul_assoc] using h
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (by positivity)) (by positivity)
  · have h := rectangle_raw (fun y x => A x y) T S hα hK ht' hts
      (fun Q _ => by rw [sum_comm]; simpa only [add_comm] using hlocal Q T)
    rw [sum_comm] at h
    calc
      _ ≤ 2^α*K*((S.card:ℝ)*(T.card:ℝ)^(α-1)) := by convert h using 1 <;> ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (by positivity)) (by positivity)

/-- No epsilon loss for 3/2<alpha<=2. -/
theorem operator_of_local {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℝ) {α K N : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hK : 0≤K)
    (hIN : (Fintype.card I:ℝ)≤N) (hJN : (Fintype.card J:ℝ)≤N)
    (hA : ∀ x y, 0≤A x y)
    (hlocal : ∀ (S : Finset I) (T : Finset J),
      (∑ x∈S, ∑ y∈T, A x y) ≤ K*((S.card:ℝ)+T.card)^α)
    (f : J → ℝ) :
    (∑ x, (∑ y, A x y*f y)^2) ≤
      (coefficient (α-1))^2*(2^α*K)^2*N^(2*α-2)*∑ y, (f y)^2 := by
  have h := operator_of_rectangles A (a:=α-1) (by linarith) (by linarith)
    (show 0≤2^α*K by positivity) hIN hJN hA
    (rectangles_of_local A (by linarith) hK hlocal) f
  convert h using 1 <;> congr 2 <;> congr 1 <;> ring

end Erdos571.HereditarySpectralExact

/-! Exact squared operator growth for genuine locally light channels. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LightFourChannel
open Finset SimpleGraph ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem exact_hereditary_operator {V : Type} [Fintype V]
    (H : SimpleGraph V) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C D : ℝ} (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C)
    (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hbi : G.IsBipartite)
    (hdeg : ∀ x, (G.degree x:ℝ) ≤ D) (L : ℕ) (u r : W) (R : ℝ)
    (P : Matrix (CrossThirdOperator.cut G u r R) (CrossThirdOperator.cut G r u R) ℝ)
    (hP : ∀ x z, 0 ≤ P x z ∧ P x z ≤ matrix G u r R L x z)
    (f : CrossThirdOperator.cut G r u R → ℝ) :
    (∑ x, (∑ z, P x z*f z)^2) ≤
      (HereditarySpectralExact.coefficient (α-1))^2*
        (2^α*(2*(L+(2*L)^2:ℕ)*C))^2*D^(2*α-2)*∑ z, (f z)^2 := by
  have hcard (x y : W) : (Fintype.card (CrossThirdOperator.cut G x y R):ℝ) ≤ D := by
    have hc := card_le_card (CrossThirdOperator.cut_subset G x y R)
    rw [G.card_neighborFinset_eq_degree] at hc
    simpa only [Fintype.card_coe] using (show ((CrossThirdOperator.cut G x y R).card:ℝ) ≤ D from
      (show ((CrossThirdOperator.cut G x y R).card:ℝ) ≤ G.degree x by exact_mod_cast hc).trans (hdeg x))
  apply HereditarySpectralExact.operator_of_local P hα hα2 (by positivity)
    (hcard u r) (hcard r u) (fun x z => (hP x z).1)
  exact matrix_hereditary_mass G H hH (by linarith) hC hbound hf hbi L u r R P (fun x z => (hP x z).2)

end Erdos571.LightFourChannel

namespace Erdos571.ThreeHub
open Finset SimpleGraph ProjectionHeavy

/-- The old DRC exponent now yields squared channel exponent 2-2/(s+1),
without a logarithm or an epsilon loss. This is still a local bound. -/
theorem drc_exact_hereditary_channel (s M L : ℕ) (hs : 2 ≤ s)
    (Q : ℝ) (hQ : 0 ≤ Q) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0 < d → (∀ x, (G.degree x:ℝ) ≤ Q*d) →
      ∀ (u r : W) (T : ℝ),
      ∀ P : Matrix (CrossThirdOperator.cut G u r T) (CrossThirdOperator.cut G r u T) ℝ,
      (∀ x z, 0≤P x z ∧ P x z≤LightFourChannel.matrix G u r T L x z) →
      ∀ f : CrossThirdOperator.cut G r u T → ℝ,
        (∑ x, (∑ z, P x z*f z)^2) ≤
          C*d^(2-2/((s:ℝ)+1))*∑ z, (f z)^2 := by
  obtain ⟨B,hB,hbound⟩ := drc_base_edge_bound s (M+1) (by omega)
  let α : ℝ := 2-1/((s:ℝ)+1)
  let K : ℝ := 2^α*(2*(L+(2*L)^2:ℕ)*B)
  let C : ℝ := (HereditarySpectralExact.coefficient (α-1))^2*K^2*Q^(2*α-2)
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg u r T P hP f
  have hsR : (2:ℝ)≤s := by exact_mod_cast hs
  have hden : (0:ℝ)<s+1 := by positivity
  have hrec : 1/((s:ℝ)+1)<1/2 := (div_lt_iff₀ hden).mpr (by linarith)
  have hα : 3/2<α := by dsimp [α]; linarith
  have hα2 : α≤2 := by dsimp [α]; have := one_div_pos.mpr hden; linarith
  have h := LightFourChannel.exact_hereditary_operator G _ (base_power_no_isolated s M)
    hα hα2 hB hbound (subdivision_free s M G hf) hbi hdeg L u r T P hP f
  change (∑ x, (∑ z, P x z*f z)^2) ≤
    (HereditarySpectralExact.coefficient (α-1))^2*K^2*(Q*d)^(2*α-2)*∑ z, (f z)^2 at h
  apply h.trans_eq
  have he : 2*α-2=2-2/((s:ℝ)+1) := by dsimp [α]; ring
  rw [Real.mul_rpow hQ hd.le]
  dsimp only [C]
  rw [he]
  ring

end Erdos571.ThreeHub

/-! Channel interpolation retaining the squared mass of middle features.
The same arbitrary feature mask is retained throughout. -/
set_option maxHeartbeats 2400000
namespace Erdos571.MiddleFeatureInterpolation
open Finset

lemma weighted_feature_energy {V R : Type*} [Fintype V] [Fintype R]
    (w : V → ℝ) (F : V → R → ℝ) (hw : ∀ v, 0≤w v) :
    (∑ q, (∑ v, w v*F v q)^2) ≤
      (∑ v, w v)*(∑ v, w v*∑ q, (F v q)^2) := by
  have h (q : R) : (∑ v, w v*F v q)^2 ≤
      (∑ v, w v)*(∑ v, w v*(F v q)^2) := by
    have hcs := sum_mul_sq_le_sq_mul_sq univ
      (fun v => Real.sqrt (w v)) (fun v => Real.sqrt (w v)*F v q)
    have he (v : V) : Real.sqrt (w v)*(Real.sqrt (w v)*F v q)=w v*F v q := by
      rw [←mul_assoc,←pow_two,Real.sq_sqrt (hw v)]
    simpa only [he,mul_pow,Real.sq_sqrt (hw _)] using hcs
  calc
    _ ≤ ∑ q, (∑ v, w v)*(∑ v, w v*(F v q)^2) := sum_le_sum (fun q _ => h q)
    _ = _ := by
      rw [←mul_sum]
      congr 1
      rw [sum_comm]
      simp only [mul_sum]

variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]

noncomputable def channel (c : I → J → V → ℝ) : I → J → ℝ := fun x z => ∑ v, c x z v
noncomputable def weightedChannel (c : I → J → V → ℝ) (B : V → ℝ) : I → J → ℝ :=
  fun x z => ∑ v, c x z v*B v
noncomputable def output (c : I → J → V → ℝ) (F : V → R → ℝ) (f : J → ℝ) : I → R → ℝ :=
  fun x q => ∑ z, (∑ v, c x z v*F v q)*f z

/-- A pointwise weighted Cauchy bound keeps the middle-feature energies. -/
theorem mixed_energy (c : I → J → V → ℝ) (F : V → R → ℝ) (B : V → ℝ)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, 0≤F v q)
    (hB : ∀ v, ∑ q, (F v q)^2 ≤ B v) (f : J → ℝ) :
    (∑ x, ∑ q, (output c F f x q)^2) ≤
      ∑ x, (∑ z, channel c x z*|f z|)*(∑ z, weightedChannel c B x z*|f z|) := by
  apply sum_le_sum
  intro x _
  let w : J×V → ℝ := fun p => c x p.1 p.2*|f p.1|
  let H : (J×V) → R → ℝ := fun p q => F p.2 q
  have hw : ∀ p, 0≤w p := fun p => mul_nonneg (hc x p.1 p.2) (abs_nonneg _)
  have he (q : R) : |output c F f x q| ≤ ∑ p, w p*H p q := by
    unfold output
    apply (abs_sum_le_sum_abs _ _).trans
    rw [Fintype.sum_prod_type]
    apply sum_le_sum
    intro z _
    rw [abs_mul,abs_of_nonneg (sum_nonneg (fun v _ => mul_nonneg (hc x z v) (hF v q))),sum_mul]
    exact le_of_eq (sum_congr rfl (fun v _ => by dsimp only [w,H]; ring))
  have hm := weighted_feature_energy w H hw
  have hdiag : (∑ p, w p*∑ q, (H p q)^2) ≤
      ∑ z, weightedChannel c B x z*|f z| := by
    rw [Fintype.sum_prod_type]
    simp only [weightedChannel,sum_mul]
    apply sum_le_sum
    intro z _
    apply sum_le_sum
    intro v _
    dsimp only [w,H]
    exact (mul_le_mul_of_nonneg_left (hB v) (hw (z,v))).trans_eq (by ring)
  have hsum : (∑ p, w p)=∑ z, channel c x z*|f z| := by
    simp only [w,Fintype.sum_prod_type,channel,sum_mul]
  calc
    _ ≤ ∑ q, (∑ p, w p*H p q)^2 := by
      exact sum_le_sum (fun q _ => by simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg _) (he q) 2)
    _ ≤ (∑ p, w p)*(∑ p, w p*∑ q, (H p q)^2) := hm
    _ ≤ (∑ p, w p)*(∑ z, weightedChannel c B x z*|f z|) :=
      mul_le_mul_of_nonneg_left hdiag (sum_nonneg (fun p _ => hw p))
    _ = _ := by rw [hsum]

/-- One unweighted channel norm is sufficient; the other factor retains
the actual weighted channel instead of replacing it by a uniform cap. -/
theorem mixed_energy_sq (c : I → J → V → ℝ) (F : V → R → ℝ) (B : V → ℝ)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, 0≤F v q)
    (hB : ∀ v, ∑ q, (F v q)^2 ≤ B v) (Λ : ℝ)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel c x z*f z)^2) ≤ Λ*∑ z, (f z)^2)
    (f : J → ℝ) :
    (∑ x, ∑ q, (output c F f x q)^2)^2 ≤
      (Λ*∑ z, (f z)^2)*(∑ x, (∑ z, weightedChannel c B x z*|f z|)^2) := by
  have h := mixed_energy c F B hc hF hB f
  have hh := pow_le_pow_left₀ (sum_nonneg (fun _ _ => sum_nonneg (fun _ _ => sq_nonneg _))) h 2
  have hcs := sum_mul_sq_le_sq_mul_sq univ
    (fun x => ∑ z, channel c x z*|f z|)
    (fun x => ∑ z, weightedChannel c B x z*|f z|)
  have ho := hop (fun z => |f z|)
  simp only [sq_abs] at ho
  exact (hh.trans hcs).trans (mul_le_mul_of_nonneg_right ho (sum_nonneg (fun _ _ => sq_nonneg _)))

/-- A uniform feature-energy cap gives a vector-valued operator theorem. -/
theorem mixed_energy_uniform (c : I → J → V → ℝ) (F : V → R → ℝ)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, 0≤F v q) (B Λ : ℝ) (hB : 0≤B)
    (hcap : ∀ v, ∑ q, (F v q)^2 ≤ B)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel c x z*f z)^2) ≤ Λ*∑ z, (f z)^2)
    (f : J → ℝ) :
    (∑ x, ∑ q, (output c F f x q)^2) ≤ B*Λ*∑ z, (f z)^2 := by
  have h := mixed_energy c F (fun _ => B) hc hF hcap f
  have he (x : I) : (∑ z, weightedChannel c (fun _ => B) x z*|f z|)=
      B*(∑ z, channel c x z*|f z|) := by
    simp only [weightedChannel,channel,sum_mul,mul_sum]
    exact sum_congr rfl (fun z _ => sum_congr rfl (fun v _ => by ring))
  have ho := hop (fun z => |f z|)
  simp only [sq_abs] at ho
  calc
    _ ≤ ∑ x, (∑ z, channel c x z*|f z|)*(B*(∑ z, channel c x z*|f z|)) := by simpa only [he] using h
    _ = B*∑ x, (∑ z, channel c x z*|f z|)^2 := by
      rw [mul_sum]
      exact sum_congr rfl (fun _ _ => by ring)
    _ ≤ B*(Λ*∑ z, (f z)^2) := mul_le_mul_of_nonneg_left ho hB
    _ = _ := by ring


/-- Arbitrary feature masks, including coupled root-tuple masks, are kept
identically in the output and in the middle-energy profile. -/
theorem masked_energy_sq (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, q∈S → 0≤F v q) (Λ : ℝ)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel c x z*f z)^2) ≤ Λ*∑ z, (f z)^2)
    (f : J → ℝ) :
    (∑ x, ∑ q∈S, (output c F f x q)^2)^2 ≤
      (Λ*∑ z, (f z)^2)*
        (∑ x, (∑ z, weightedChannel c (fun v => ∑ q∈S, (F v q)^2) x z*|f z|)^2) := by
  classical
  let F' : V → S → ℝ := fun v q => F v q.val
  have h := mixed_energy_sq c F' (fun v => ∑ q∈S, (F v q)^2)
    hc (fun v q => hF v q.val q.property) (fun v => (sum_coe_sort S (fun q => (F v q)^2)).le) Λ hop f
  have he (x : I) : (∑ q : S, (output c F' f x q)^2)=∑ q∈S, (output c F f x q)^2 :=
    sum_coe_sort S (fun q => (output c F f x q)^2)
  simpa only [he] using h

theorem masked_energy_uniform (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, q∈S → 0≤F v q)
    (B Λ : ℝ) (hB : 0≤B) (hcap : ∀ v, ∑ q∈S, (F v q)^2≤B)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel c x z*f z)^2) ≤ Λ*∑ z, (f z)^2)
    (f : J → ℝ) :
    (∑ x, ∑ q∈S, (output c F f x q)^2) ≤ B*Λ*∑ z, (f z)^2 := by
  classical
  let F' : V → S → ℝ := fun v q => F v q.val
  have h := mixed_energy_uniform c F' hc (fun v q => hF v q.val q.property) B Λ hB
    (fun v => (sum_coe_sort S (fun q => (F v q)^2)).le.trans (hcap v)) hop f
  have he (x : I) : (∑ q : S, (output c F' f x q)^2)=∑ q∈S, (output c F f x q)^2 :=
    sum_coe_sort S (fun q => (output c F f x q)^2)
  simpa only [he] using h

end Erdos571.MiddleFeatureInterpolation

/-! Actual middle-choice channels with arbitrarily masked root features. -/
set_option maxHeartbeats 2200000
namespace Erdos571.LightFourChannel
open Finset SimpleGraph ProjectionHeavy MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def choicesKernel {I J : Type*} (S : I → J → Finset W) : I → J → W → ℝ :=
  fun x z v => if v∈S x z then 1 else 0

lemma choices_nonneg {I J : Type*} (S : I → J → Finset W) :
    ∀ x z v, 0≤choicesKernel S x z v := by
  intro x z v
  dsimp [choicesKernel]
  split_ifs <;> norm_num

lemma choices_channel {I J : Type*} (S : I → J → Finset W) (x : I) (z : J) :
    channel (choicesKernel S) x z=(S x z).card := by
  classical
  simp only [channel,choicesKernel,sum_boole,filter_mem_eq_inter,univ_inter]

lemma choices_weighted {I J : Type*} (S : I → J → Finset W) (B : W → ℝ) (x : I) (z : J) :
    weightedChannel (choicesKernel S) B x z=∑ v∈S x z, B v := by
  classical
  simp only [weightedChannel,choicesKernel,ite_mul,one_mul,zero_mul,sum_ite_mem_eq]

lemma choices_output {I J R : Type*} [Fintype J] (S : I → J → Finset W)
    (F : W → R → ℝ) (f : J → ℝ) (x : I) (q : R) :
    output (choicesKernel S) F f x q=∑ z, (∑ v∈S x z, F v q)*f z := by
  classical
  simp only [output,choicesKernel,ite_mul,one_mul,zero_mul,sum_ite_mem_eq]

variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma choices_dominated (u r : W) (T : ℝ) (L : ℕ)
    (S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W)
    (hS : ∀ x z, S x z ⊆ middles G u r L x.val z.val) :
    ∀ x z, 0≤channel (choicesKernel S) x z ∧
      channel (choicesKernel S) x z≤ matrix G u r T L x z := by
  intro x z
  rw [choices_channel]
  refine ⟨Nat.cast_nonneg _,?_⟩
  change ((S x z).card:ℝ) ≤ (middles G u r L x.val z.val).card
  exact_mod_cast card_le_card (hS x z)

variable {HVertex : Type} [Fintype HVertex]

/-- The remaining middle feature is not discarded or factored across the
channel endpoints. Its squared mass, with exactly the same root mask, is
retained in the second channel factor. -/
theorem masked_feature_interpolation {R : Type*} [Fintype R]
    (H : SimpleGraph HVertex) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C D : ℝ} (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C)
    (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hbi : G.IsBipartite)
    (hdeg : ∀ x, (G.degree x:ℝ)≤D) (L : ℕ) (u r : W) (T : ℝ)
    (S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W)
    (hS : ∀ x z, S x z ⊆ middles G u r L x.val z.val)
    (F : W → R → ℝ) (J : Finset R) (hF : ∀ v q, q∈J → 0≤F v q)
    (f : CrossThirdOperator.cut G r u T → ℝ) :
    (∑ x, ∑ q∈J, (∑ z, (∑ v∈S x z, F v q)*f z)^2)^2 ≤
      ((HereditarySpectralExact.coefficient (α-1))^2*
        (2^α*(2*(L+(2*L)^2:ℕ)*C))^2*D^(2*α-2)*∑ z, (f z)^2)*
      (∑ x, (∑ z, (∑ v∈S x z, ∑ q∈J, (F v q)^2)*|f z|)^2) := by
  have h := MiddleFeatureInterpolation.masked_energy_sq (choicesKernel S) F J
    (choices_nonneg S) hF _
    (fun g => exact_hereditary_operator G H hH hα hα2 hC hbound hf hbi hdeg L u r T
      (channel (choicesKernel S)) (choices_dominated G u r T L S hS) g) f
  simpa only [choices_output,choices_weighted] using h

/-- A uniform bound is also available, but it deliberately displays the
feature-energy factor that cannot simply be omitted in a pin estimate. -/
theorem masked_feature_operator {R : Type*} [Fintype R]
    (H : SimpleGraph HVertex) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C D : ℝ} (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C)
    (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hbi : G.IsBipartite)
    (hdeg : ∀ x, (G.degree x:ℝ)≤D) (L : ℕ) (u r : W) (T : ℝ)
    (S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W)
    (hS : ∀ x z, S x z ⊆ middles G u r L x.val z.val)
    (F : W → R → ℝ) (J : Finset R) (hF : ∀ v q, q∈J → 0≤F v q)
    (B : ℝ) (hB : 0≤B) (hcap : ∀ v, ∑ q∈J, (F v q)^2≤B)
    (f : CrossThirdOperator.cut G r u T → ℝ) :
    (∑ x, ∑ q∈J, (∑ z, (∑ v∈S x z, F v q)*f z)^2) ≤
      B*((HereditarySpectralExact.coefficient (α-1))^2*
        (2^α*(2*(L+(2*L)^2:ℕ)*C))^2*D^(2*α-2))*∑ z, (f z)^2 := by
  have h := MiddleFeatureInterpolation.masked_energy_uniform (choicesKernel S) F J
    (choices_nonneg S) hF B _ hB hcap
    (fun g => exact_hereditary_operator G H hH hα hα2 hC hbound hf hbi hdeg L u r T
      (channel (choicesKernel S)) (choices_dominated G u r T L S hS) g) f
  simpa only [choices_output] using h

end Erdos571.LightFourChannel

/-! Squared middle-feature masses for the actual remaining arm bundles. -/
set_option maxHeartbeats 1500000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma armFeature_nonneg (L : ℝ) (s : ℕ) (v : W) (q : Labels (W:=W) s) :
    0≤armFeature G L s v q :=
  ArmTensor.nonneg _ (LightArmKernel.nonneg G L) _ v q

lemma armFeature_row_energy (L : ℝ) (s : ℕ) (v : W) :
    (∑ q, (armFeature G L s v q)^2)=
      (∑ r, (LightArmKernel.matrix G L v r)^2)^s := by
  have h := congrArg (fun A : Matrix W W ℝ => A v v) (arm_gram G L s)
  simpa only [Matrix.mul_apply,Matrix.transpose_apply,←pow_two,GramPin.entryPower] using h

/-- The mask can be an arbitrary subset of all remaining root labels. -/
theorem masked_arm_energy_le (L D : ℝ) (s : ℕ) (hL : 0≤L) (hD : 0≤D)
    (hdeg : ∀ x, (G.degree x:ℝ)≤D) (J : Finset (Labels (W:=W) s)) (v : W) :
    (∑ q∈J, (armFeature G L s v q)^2) ≤ (L*D^2)^s := by
  have hrow : (∑ r, (LightArmKernel.matrix G L v r)^2) ≤ L*D^2 := by
    calc
      _ ≤ L*∑ r, LightArmKernel.matrix G L v r := by
        rw [mul_sum]
        exact sum_le_sum (fun r _ => by
          simpa only [pow_two] using mul_le_mul_of_nonneg_right
            (LightArmKernel.cap G L hL v r) (LightArmKernel.nonneg G L v r))
      _ ≤ _ := mul_le_mul_of_nonneg_left (LightArmKernel.row_upper G L D hD hdeg v) hL
  calc
    _ ≤ ∑ q, (armFeature G L s v q)^2 :=
      sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun _ _ _ => sq_nonneg _)
    _ = (∑ r, (LightArmKernel.matrix G L v r)^2)^s := armFeature_row_energy G L s v
    _ ≤ _ := pow_le_pow_left₀ (sum_nonneg (fun _ _ => sq_nonneg _)) hrow s

end Erdos571.ThreeHubAssignments

/-! The exact DRC channel gain with actual middle features and root masks. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHub
open Finset SimpleGraph MiddleFeatureInterpolation LightFourChannel

/-- The weighted factor is retained rather than being identified with the
full tree's agreement energy. The feature mask may be arbitrarily coupled. -/
theorem drc_masked_middle_features (s M L : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0≤Q) :
    ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0<d → (∀ x, (G.degree x:ℝ)≤Q*d) →
      ∀ (u r : W) (T : ℝ),
      ∀ S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W,
      (∀ x z, S x z ⊆ middles G u r L x.val z.val) →
      ∀ (R : Type) [Fintype R] (F : W → R → ℝ) (J : Finset R),
      (∀ v q, q∈J → 0≤F v q) →
      ∀ f : CrossThirdOperator.cut G r u T → ℝ,
      (∑ x, ∑ q∈J, (∑ z, (∑ v∈S x z, F v q)*f z)^2)^2 ≤
        (C*d^(2-2/((s:ℝ)+1))*∑ z, (f z)^2)*
          (∑ x, (∑ z, (∑ v∈S x z, ∑ q∈J, (F v q)^2)*|f z|)^2) := by
  obtain ⟨C,hC,h⟩ := drc_exact_hereditary_channel s M L hs Q hQ
  refine ⟨C,hC,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg u r T S hS R _ F J hF f
  have hop := h W G hf hbi d hd hdeg u r T (channel (choicesKernel S))
    (choices_dominated G u r T L S hS)
  have hh := masked_energy_sq (choicesKernel S) F J (choices_nonneg S) hF _ hop f
  simpa only [choices_output,choices_weighted] using hh

/-- In particular, a remaining light-arm bundle is a legitimate vector-valued
middle feature. The factor (L*(Q*d)^2)^t records its squared row mass. -/
theorem drc_remaining_arm_features (s M L t : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0≤Q) :
    ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0<d → (∀ x, (G.degree x:ℝ)≤Q*d) →
      ∀ (u r : W) (T : ℝ),
      ∀ S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W,
      (∀ x z, S x z ⊆ middles G u r L x.val z.val) →
      ∀ J : Finset (ThreeHubAssignments.Labels (W:=W) t),
      ∀ f : CrossThirdOperator.cut G r u T → ℝ,
      (∑ x, ∑ q∈J, (∑ z, (∑ v∈S x z, ThreeHubAssignments.armFeature G L t v q)*f z)^2) ≤
        ((L:ℝ)*(Q*d)^2)^t*(C*d^(2-2/((s:ℝ)+1)))*∑ z, (f z)^2 := by
  obtain ⟨C,hC,h⟩ := drc_exact_hereditary_channel s M L hs Q hQ
  refine ⟨C,hC,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg u r T S hS J f
  have hop := h W G hf hbi d hd hdeg u r T (channel (choicesKernel S))
    (choices_dominated G u r T L S hS)
  have hh := masked_energy_uniform (choicesKernel S) (ThreeHubAssignments.armFeature G L t) J
    (choices_nonneg S) (fun v q _ => ThreeHubAssignments.armFeature_nonneg G L t v q)
    (((L:ℝ)*(Q*d)^2)^t) _ (by positivity)
    (ThreeHubAssignments.masked_arm_energy_le G L (Q*d) t (Nat.cast_nonneg _) (mul_nonneg hQ hd.le) hdeg J)
    hop f
  simpa only [choices_output] using hh

end Erdos571.ThreeHub

/-! A finite-family form of middle-feature interpolation. These counts
retain the same arbitrary feature mask, but are not the full ThreeHub pin. -/
set_option maxHeartbeats 2500000
namespace Erdos571.FiniteChannelFeatures
open Finset MiddleFeatureInterpolation
variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]
variable (S : I → J → Finset V) (B : V → R → Type*) [∀ v q, Fintype (B v q)]

abbrev Row (q : R) (x : I) := (z : J) × (v : S x z) × B v.val q
abbrev Profile (Q : Finset R) (v : V) := (q : Q) × (B v q.val × B v q.val)
abbrev WeightedRow (Q : Finset R) (x : I) := (z : J) × (v : S x z) × Profile B Q v.val
abbrev Agreement (Q : Finset R) := (q : Q) × (x : I) × (Row S B q.val x × Row S B q.val x)
abbrev WeightedAgreement (Q : Finset R) := (x : I) × (WeightedRow S B Q x × WeightedRow S B Q x)

noncomputable def kernel : I → J → V → ℝ := by
  classical
  exact fun x z v => if v∈S x z then 1 else 0
noncomputable def feature : V → R → ℝ := fun v q => Fintype.card (B v q)

lemma kernel_nonneg : ∀ x z v, 0≤kernel S x z v := by
  classical
  intros
  unfold kernel
  split_ifs <;> norm_num

lemma feature_nonneg : ∀ v q, 0≤feature B v q := fun _ _ => Nat.cast_nonneg _

lemma row_card (q : R) (x : I) :
    (Fintype.card (Row S B q x):ℝ)=output (kernel S) (feature B) (fun _ => 1) x q := by
  classical
  simp only [Row,Fintype.card_sigma,Nat.cast_sum,output,kernel,feature,mul_one,
    ite_mul,one_mul,zero_mul,sum_ite_mem_eq]
  exact sum_congr rfl (fun z _ => sum_coe_sort (S x z) (fun v => (Fintype.card (B v q):ℝ)))

lemma profile_card (Q : Finset R) (v : V) :
    (Fintype.card (Profile B Q v):ℝ)=∑ q∈Q, (feature B v q)^2 := by
  classical
  simp only [Profile,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,←pow_two,Nat.cast_pow,feature]
  exact sum_coe_sort Q (fun q => (Fintype.card (B v q):ℝ)^2)

lemma weighted_row_card (Q : Finset R) (x : I) :
    (Fintype.card (WeightedRow S B Q x):ℝ)=
      ∑ z, weightedChannel (kernel S) (fun v => ∑ q∈Q, (feature B v q)^2) x z := by
  classical
  change (Fintype.card ((z : J) × (v : S x z) × Profile B Q v.val):ℝ)=_
  rw [Fintype.card_sigma,Nat.cast_sum]
  apply sum_congr rfl
  intro z _
  rw [Fintype.card_sigma,Nat.cast_sum]
  simp_rw [profile_card]
  simp only [weightedChannel,kernel,ite_mul,one_mul,zero_mul,sum_ite_mem_eq]
  exact sum_coe_sort (S x z) (fun v => ∑ q∈Q, (feature B v q)^2)

lemma agreement_card (Q : Finset R) :
    (Nat.card (Agreement S B Q):ℝ)=
      ∑ x, ∑ q∈Q, (output (kernel S) (feature B) (fun _ => 1) x q)^2 := by
  classical
  rw [Nat.card_eq_fintype_card]
  have hc : (Fintype.card (Agreement S B Q):ℝ)=
      ∑ q : Q, ∑ x : I, (Fintype.card (Row S B q.val x):ℝ)^2 := by
    rw [Fintype.card_sigma,Nat.cast_sum]
    apply sum_congr rfl
    intro q _
    rw [Fintype.card_sigma,Nat.cast_sum]
    apply sum_congr rfl
    intro x _
    rw [Fintype.card_prod,Nat.cast_mul]
    ring
  rw [hc]
  simp_rw [row_card]
  rw [sum_comm]
  exact sum_congr rfl (fun x _ => sum_coe_sort Q
    (fun q => (output (kernel S) (feature B) (fun _ => 1) x q)^2))

lemma weighted_agreement_card (Q : Finset R) :
    (Nat.card (WeightedAgreement S B Q):ℝ)=
      ∑ x, (∑ z, weightedChannel (kernel S) (fun v => ∑ q∈Q, (feature B v q)^2) x z)^2 := by
  classical
  rw [Nat.card_eq_fintype_card]
  have hc : (Fintype.card (WeightedAgreement S B Q):ℝ)=
      ∑ x : I, (Fintype.card (WeightedRow S B Q x):ℝ)^2 := by
    rw [Fintype.card_sigma,Nat.cast_sum]
    apply sum_congr rfl
    intro x _
    rw [Fintype.card_prod,Nat.cast_mul]
    ring
  rw [hc]
  simp_rw [weighted_row_card]

/-- The original agreements use one common feature label; the weighted
agreements have two copies at a common middle vertex in each profile.
Both profiles use precisely Q. No packing or whole-tree identity is assumed. -/
theorem interpolation (Q : Finset R) (Λ : ℝ)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel (kernel S) x z*f z)^2) ≤ Λ*∑ z, (f z)^2) :
    (Nat.card (Agreement S B Q):ℝ)^2 ≤
      (Λ*Fintype.card J)*(Nat.card (WeightedAgreement S B Q):ℝ) := by
  have h := masked_energy_sq (kernel S) (feature B) Q (kernel_nonneg S)
    (fun v q _ => feature_nonneg B v q) Λ hop (fun _ => 1)
  rw [agreement_card,weighted_agreement_card]
  simpa only [one_pow,sum_const,card_univ,nsmul_eq_mul,mul_one,abs_one] using h

end Erdos571.FiniteChannelFeatures

/-! Finite agreement comparisons for genuine allowed middle choices. -/
set_option maxHeartbeats 2500000
namespace Erdos571.LightFourChannel
open Finset SimpleGraph ProjectionHeavy MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- A finite-family rearrangement supplied by the actual channel operator.
The right-hand profiles share a middle vertex, not merely a root label. -/
theorem finite_feature_interpolation {R HVertex : Type} [Fintype R] [Fintype HVertex]
    (H : SimpleGraph HVertex) (hH : ∀ x, ∃ y, H.Adj x y)
    {α C D : ℝ} (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C)
    (hbound : EdgeBound H α C)
    (hf : (ProjectionHeavy.subdivision H).Free G) (hbi : G.IsBipartite)
    (hdeg : ∀ x, (G.degree x:ℝ)≤D) (L : ℕ) (u r : W) (T : ℝ)
    (S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W)
    (hS : ∀ x z, S x z ⊆ middles G u r L x.val z.val)
    (B : W → R → Type) [∀ v q, Fintype (B v q)] (J : Finset R) :
    (Nat.card (FiniteChannelFeatures.Agreement S B J):ℝ)^2 ≤
      ((HereditarySpectralExact.coefficient (α-1))^2*
        (2^α*(2*(L+(2*L)^2:ℕ)*C))^2*D^(2*α-2)*(CrossThirdOperator.cut G r u T).card)*
      (Nat.card (FiniteChannelFeatures.WeightedAgreement S B J):ℝ) := by
  classical
  have hop := fun g => exact_hereditary_operator G H hH hα hα2 hC hbound hf hbi hdeg L u r T
    (channel (choicesKernel S)) (choices_dominated G u r T L S hS) g
  have he : FiniteChannelFeatures.kernel S=choicesKernel S := by
    funext x z v
    by_cases h : v∈S x z <;> simp [FiniteChannelFeatures.kernel,choicesKernel,h]
  have h := FiniteChannelFeatures.interpolation S B J _ (by rw [he]; exact hop)
  simpa only [Fintype.card_coe] using h

end Erdos571.LightFourChannel

namespace Erdos571.ThreeHub
open Finset SimpleGraph MiddleFeatureInterpolation LightFourChannel

/-- Actual remaining-arm bundle counts obey the finite rearrangement with
an unchanged root mask. This is not yet an upper bound on a full-tree pin. -/
theorem drc_finite_arm_interpolation (s M L : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0≤Q) :
    ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0<d → (∀ x, (G.degree x:ℝ)≤Q*d) →
      ∀ (u r : W) (T : ℝ),
      ∀ S : CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W,
      (∀ x z, S x z ⊆ middles G u r L x.val z.val) →
      ∀ (t : ℕ) (J : Finset (ThreeHubAssignments.Labels (W:=W) t)),
        (Nat.card (FiniteChannelFeatures.Agreement S (ThreeHubAssignments.Bundle G L t) J):ℝ)^2 ≤
          (C*d^(2-2/((s:ℝ)+1))*(CrossThirdOperator.cut G r u T).card)*
            (Nat.card (FiniteChannelFeatures.WeightedAgreement S (ThreeHubAssignments.Bundle G L t) J):ℝ) := by
  obtain ⟨C,hC,h⟩ := drc_exact_hereditary_channel s M L hs Q hQ
  refine ⟨C,hC,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg u r T S hS t J
  classical
  have hop := h W G hf hbi d hd hdeg u r T (channel (choicesKernel S))
    (choices_dominated G u r T L S hS)
  have he : FiniteChannelFeatures.kernel S=choicesKernel S := by
    funext x z v
    by_cases h : v∈S x z <;> simp [FiniteChannelFeatures.kernel,choicesKernel,h]
  have hh := FiniteChannelFeatures.interpolation S (ThreeHubAssignments.Bundle G L t) J _
    (by rw [he]; exact hop)
  simpa only [Fintype.card_coe] using hh

end Erdos571.ThreeHub


/-! Channel interpolation after summing its free row endpoint and then
nonnegative outer slices. The feature masks are not enlarged. -/
set_option maxHeartbeats 2400000
namespace Erdos571.MiddleFeatureInterpolation
open Finset

lemma weighted_cauchy {O : Type*} [Fintype O] (a b : O → ℝ)
    (ha : ∀ o, 0 ≤ a o) :
    (∑ o, a o * b o)^2 ≤ (∑ o, a o) * ∑ o, a o * (b o)^2 := by
  have h := sum_mul_sq_le_sq_mul_sq univ
    (fun o => Real.sqrt (a o)) (fun o => Real.sqrt (a o)*b o)
  have he (o : O) : Real.sqrt (a o)*(Real.sqrt (a o)*b o)=a o*b o := by
    rw [←mul_assoc,←pow_two,Real.sq_sqrt (ha o)]
  simpa only [he,mul_pow,Real.sq_sqrt (ha _)] using h

variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]

noncomputable def totalOutputEnergy (c : I → J → V → ℝ) (F : V → R → ℝ)
    (S : Finset R) : ℝ := ∑ q∈S, (∑ x, output c F (fun _ => 1) x q)^2

noncomputable def profileEnergy (c : I → J → V → ℝ) (F : V → R → ℝ)
    (S : Finset R) : ℝ :=
    ∑ x, (∑ z, weightedChannel c (fun v => ∑ q∈S, (F v q)^2) x z)^2

lemma totalOutputEnergy_nonneg (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R) :
    0 ≤ totalOutputEnergy c F S :=
  sum_nonneg (fun _ _ => sq_nonneg _)

lemma profileEnergy_nonneg (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R) :
    0 ≤ profileEnergy c F S := sum_nonneg (fun _ _ => sq_nonneg _)

/-- Summing the free first endpoint costs exactly its domain cardinality. -/
lemma totalOutputEnergy_le (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R) :
    totalOutputEnergy c F S ≤ (Fintype.card I:ℝ)*∑ x, ∑ q∈S, (output c F (fun _ => 1) x q)^2 := by
  have h (q : R) : (∑ x, output c F (fun _ => 1) x q)^2 ≤
      (Fintype.card I:ℝ)*∑ x, (output c F (fun _ => 1) x q)^2 := by
    simpa only [one_mul,one_pow,sum_const,card_univ,nsmul_eq_mul,mul_one] using
      sum_mul_sq_le_sq_mul_sq univ (fun _ : I => (1:ℝ)) (fun x => output c F (fun _ => 1) x q)
  calc
    _ ≤ ∑ q∈S, (Fintype.card I:ℝ)*∑ x, (output c F (fun _ => 1) x q)^2 :=
      sum_le_sum (fun q _ => h q)
    _ = _ := by rw [←mul_sum,sum_comm]

/-- Local interpolation, with both endpoint cardinalities explicit. -/
theorem totalOutputEnergy_sq (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, q∈S → 0≤F v q) (Λ : ℝ)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel c x z*f z)^2) ≤ Λ*∑ z, (f z)^2) :
    (totalOutputEnergy c F S)^2 ≤
      ((Fintype.card I:ℝ)^2*Λ*Fintype.card J)*profileEnergy c F S := by
  have h := masked_energy_sq c F S hc hF Λ hop (fun _ => 1)
  simp only [one_pow,sum_const,card_univ,nsmul_eq_mul,mul_one,abs_one] at h
  have hh := pow_le_pow_left₀ (totalOutputEnergy_nonneg c F S) (totalOutputEnergy_le c F S) 2
  rw [mul_pow] at hh
  exact (hh.trans (mul_le_mul_of_nonneg_left h (sq_nonneg _))).trans_eq (by
    unfold profileEnergy
    ring)

/-- The familiar D^3 factor is only a cardinality relaxation. -/
theorem totalOutputEnergy_sq_of_card (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) (hF : ∀ v q, q∈S → 0≤F v q) (D Λ : ℝ)
    (hΛ : 0≤Λ) (hI : (Fintype.card I:ℝ)≤D) (hJ : (Fintype.card J:ℝ)≤D)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel c x z*f z)^2) ≤ Λ*∑ z, (f z)^2) :
    (totalOutputEnergy c F S)^2 ≤ (D^3*Λ)*profileEnergy c F S := by
  have hD : 0≤D := (Nat.cast_nonneg (Fintype.card I)).trans hI
  have hcoef : (Fintype.card I:ℝ)^2*Λ*Fintype.card J ≤ D^3*Λ := by
    calc
      _ ≤ D^2*Λ*D := mul_le_mul
        (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (Nat.cast_nonneg _) hI 2) hΛ)
        hJ (Nat.cast_nonneg _) (mul_nonneg (sq_nonneg _) hΛ)
      _ = _ := by ring
  exact (totalOutputEnergy_sq c F S hc hF Λ hop).trans
    (mul_le_mul_of_nonneg_right hcoef (profileEnergy_nonneg c F S))

/-- Weighted summation of local interpolation inequalities. No independence
of a slice weight and its mask is required. -/
theorem weighted_slices {O : Type*} [Fintype O] (a b w : O → ℝ) (K : ℝ)
    (ha : ∀ o, 0≤a o) (hb : ∀ o, (b o)^2≤K*w o) :
    (∑ o, a o*b o)^2 ≤ K*(∑ o, a o)*(∑ o, a o*w o) := by
  calc
    _ ≤ (∑ o, a o)*∑ o, a o*(b o)^2 := weighted_cauchy a b ha
    _ ≤ (∑ o, a o)*∑ o, a o*(K*w o) :=
      mul_le_mul_of_nonneg_left (sum_le_sum (fun o _ => mul_le_mul_of_nonneg_left (hb o) (ha o)))
        (sum_nonneg (fun o _ => ha o))
    _ = _ := by
      simp_rw [mul_left_comm (a _) K]
      rw [←mul_sum]
      ring

/-- Dependent row and column domains allow each outer slice to use its own
actual cross-cut. The same S(o) occurs in both energies. -/
theorem sliced_totalOutputEnergy {O : Type*} [Fintype O]
    {I J : O → Type*} [∀ o, Fintype (I o)] [∀ o, Fintype (J o)]
    (c : ∀ o, I o → J o → V → ℝ) (F : O → V → R → ℝ)
    (S : O → Finset R) (a : O → ℝ) (D Λ : ℝ)
    (ha : ∀ o, 0≤a o) (hΛ : 0≤Λ)
    (hc : ∀ o x z v, 0≤c o x z v) (hF : ∀ o v q, q∈S o → 0≤F o v q)
    (hI : ∀ o, (Fintype.card (I o):ℝ)≤D) (hJ : ∀ o, (Fintype.card (J o):ℝ)≤D)
    (hop : ∀ o (f : J o → ℝ), (∑ x, (∑ z, channel (c o) x z*f z)^2) ≤ Λ*∑ z, (f z)^2) :
    (∑ o, a o*totalOutputEnergy (c o) (F o) (S o))^2 ≤
      (D^3*Λ)*(∑ o, a o)*(∑ o, a o*profileEnergy (c o) (F o) (S o)) :=
  weighted_slices a _ _ _ ha (fun o =>
    totalOutputEnergy_sq_of_card (c o) (F o) (S o) (hc o) (hF o) D Λ hΛ (hI o) (hJ o) (hop o))

end Erdos571.MiddleFeatureInterpolation

/-! Finite counts for interpolation with a free first channel endpoint. -/
set_option maxHeartbeats 2400000
namespace Erdos571.FiniteChannelFeatures
open Finset MiddleFeatureInterpolation
variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]
variable (S : I → J → Finset V) (B : V → R → Type*) [∀ v q, Fintype (B v q)]

abbrev TotalRow (q : R) := (x : I) × Row S B q x
abbrev TotalAgreement (Q : Finset R) := (q : Q) × (TotalRow S B q.val × TotalRow S B q.val)

lemma total_row_card (q : R) : (Fintype.card (TotalRow S B q):ℝ)=
    ∑ x, output (kernel S) (feature B) (fun _ => 1) x q := by
  rw [Fintype.card_sigma,Nat.cast_sum]
  exact sum_congr rfl (fun x _ => row_card S B q x)

lemma total_agreement_card (Q : Finset R) :
    (Nat.card (TotalAgreement S B Q):ℝ)=totalOutputEnergy (kernel S) (feature B) Q := by
  classical
  rw [Nat.card_eq_fintype_card]
  change (Fintype.card ((q : Q) × (TotalRow S B q.val × TotalRow S B q.val)):ℝ)=_
  rw [Fintype.card_sigma,Nat.cast_sum]
  have h (q : Q) : (Fintype.card (TotalRow S B q.val × TotalRow S B q.val):ℝ)=
      (∑ x, output (kernel S) (feature B) (fun _ => 1) x q.val)^2 := by
    rw [Fintype.card_prod,Nat.cast_mul,total_row_card]
    ring
  simp_rw [h]
  exact sum_coe_sort Q (fun q => (∑ x, output (kernel S) (feature B) (fun _ => 1) x q)^2)

theorem total_interpolation (Q : Finset R) (Λ : ℝ)
    (hop : ∀ f : J → ℝ, (∑ x, (∑ z, channel (kernel S) x z*f z)^2) ≤ Λ*∑ z, (f z)^2) :
    (Nat.card (TotalAgreement S B Q):ℝ)^2 ≤
      ((Fintype.card I:ℝ)^2*Λ*Fintype.card J)*(Nat.card (WeightedAgreement S B Q):ℝ) := by
  rw [total_agreement_card,weighted_agreement_card]
  exact totalOutputEnergy_sq (kernel S) (feature B) Q (kernel_nonneg S)
    (fun v q _ => feature_nonneg B v q) Λ hop

end Erdos571.FiniteChannelFeatures

/-! Restricting one actual side assignment to its four-walk channel. The
other terminal arms remain features on the middle hub. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

noncomputable def choices (u r : W) :
    CrossThirdOperator.cut G u r T → CrossThirdOperator.cut G r u T → Finset W :=
  fun x z => middles G u r L x.val z.val

abbrev Remaining (v : W) (q : Labels (W := W) s) :=
  MaskedBush.Bundle G L (MaskedBush.Without i) v (fun j => q j.val)

noncomputable instance remainingFintype (v : W) (q : Labels (W := W) s) :
    Fintype (Remaining G L s i v q) := by
  classical
  infer_instance

def Allowed (u : W) (q : Labels (W := W) s) (p : Side G L s u q) : Prop :=
  p.2.1.val ∈ CrossThirdOperator.cut G u (q i) T ∧
    MaskedBush.middle G L (p.2.2 i) ∈ CrossThirdOperator.cut G (q i) u T ∧
    p.1 ∈ middles G u (q i) L p.2.1.val (MaskedBush.middle G L (p.2.2 i))

abbrev Restricted (u : W) (q : Labels (W := W) s) :=
  {p : Side G L s u q // Allowed G L T s i u q p}

noncomputable instance restrictedFintype (u : W) (q : Labels (W := W) s) :
    Fintype (Restricted G L T s i u q) := by
  classical
  infer_instance

def encode (u : W) (q : Labels (W := W) s) (p : Restricted G L T s i u q) :
    FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q :=
  ⟨⟨p.val.2.1.val,p.property.1⟩,
    ⟨MaskedBush.middle G L (p.val.2.2 i),p.property.2.1⟩,
    ⟨p.val.1,p.property.2.2⟩,fun j => p.val.2.2 j.val⟩

lemma encode_injective (u : W) (q : Labels (W := W) s) :
    Function.Injective (encode G L T s i u q) := by
  intro p p' he
  have hx : p.val.2.1.val=p'.val.2.1.val :=
    congrArg (fun t : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q => t.1.val) he
  have hz : MaskedBush.middle G L (p.val.2.2 i)=MaskedBush.middle G L (p'.val.2.2 i) :=
    congrArg (fun t : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q => t.2.1.val) he
  have hv : p.val.1=p'.val.1 :=
    congrArg (fun t : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q => t.2.2.1.val) he
  have hb (j : MaskedBush.Without i) :
      MaskedBush.middle G L (p.val.2.2 j.val)=MaskedBush.middle G L (p'.val.2.2 j.val) :=
    congrArg (fun t : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q =>
      MaskedBush.middle G L (t.2.2.2 j)) he
  apply Subtype.ext
  rcases p with ⟨⟨v,x,b⟩,hp⟩
  rcases p' with ⟨⟨v',x',b'⟩,hp'⟩
  change v=v' at hv
  subst v'
  have hxx : x=x' := Subtype.ext hx
  subst x'
  have hbb : b=b' := by
    funext j
    apply MaskedBush.arm_ext G L
    by_cases hj : j=i
    · subst j; exact hz
    · exact hb ⟨j,hj⟩
  subst b'
  rfl

lemma restricted_card (u : W) (q : Labels (W := W) s) :
    (Fintype.card (Restricted G L T s i u q):ℝ) ≤
      ∑ x, output (FiniteChannelFeatures.kernel (choices G L T u (q i)))
        (FiniteChannelFeatures.feature (Remaining G L s i)) (fun _ => 1) x q := by
  rw [←FiniteChannelFeatures.total_row_card]
  exact_mod_cast Fintype.card_le_of_injective _ (encode_injective G L T s i u q)

lemma choices_kernel (u r : W) :
    FiniteChannelFeatures.kernel (choices G L T u r)=choicesKernel (choices G L T u r) := by
  classical
  funext x z v
  by_cases h : v∈choices G L T u r x z <;> simp [FiniteChannelFeatures.kernel,choicesKernel,h]

lemma choices_dominated (u r : W) :
    ∀ x z, 0≤channel (FiniteChannelFeatures.kernel (choices G L T u r)) x z ∧
      channel (FiniteChannelFeatures.kernel (choices G L T u r)) x z ≤ matrix G u r T L x z := by
  rw [choices_kernel]
  exact LightFourChannel.choices_dominated G u r T L _ (fun _ _ => Subset.rfl)

end Erdos571.ThreeHubChannelSides

/-! Strong copies use the actual selected-arm channel. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (s : ℕ) (hs : 1≤s) (i : Fin s) (D : ℝ)

lemma strong_allowed (f : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D) :
    let p := fromStrong G L s hs D f
    Allowed G L (L*D) s i p.2.1 p.1.2.1 p.2.2.2.1 := by
  let a := RootedSubdivision.old (ThreeHub.base s) (.inl 1)
  let v := RootedSubdivision.old (ThreeHub.base s) (.inl 0)
  let r := RootedSubdivision.old (ThreeHub.base s) (.inr (leafIndex s hs 0 i))
  let x := RootedSubdivision.middle (ThreeHub.base s) (BalancedTree.edge (.inl 0))
  let z := RootedSubdivision.middle (ThreeHub.base s) (BalancedTree.edge (.inr (leafIndex s hs 0 i)))
  have hax : (ThreeHub.template s).Adj a x :=
    (RootedSubdivision.adj_old_middle (ThreeHub.base s) _ _).mpr (by simp [a,x,BalancedTree.edge])
  have hvx : (ThreeHub.template s).Adj v x :=
    (RootedSubdivision.adj_old_middle (ThreeHub.base s) _ _).mpr (by simp [v,x,BalancedTree.edge])
  have hvz : (ThreeHub.template s).Adj v z :=
    (RootedSubdivision.adj_old_middle (ThreeHub.base s) _ _).mpr (by simp [v,z,BalancedTree.edge])
  have hrz : (ThreeHub.template s).Adj r z :=
    (RootedSubdivision.adj_old_middle (ThreeHub.base s) _ _).mpr (by simp [r,z,BalancedTree.edge])
  have hrx : r≠x := RootedSubdivision.old_ne_middle (ThreeHub.base s) _ _
  have haz : a≠z := RootedSubdivision.old_ne_middle (ThreeHub.base s) _ _
  have hva : v≠a := (RootedSubdivision.old_injective (ThreeHub.base s)).ne (by simp)
  have hvr : v≠r := (RootedSubdivision.old_injective (ThreeHub.base s)).ne (by simp)
  have hxz : x≠z := (RootedSubdivision.middle_injective (ThreeHub.base s)).ne
    (BalancedTree.edge_injective.ne (by simp))
  change f.val x∈CrossThirdOperator.cut G (f.val a) (f.val r) (L*D) ∧
    f.val z∈CrossThirdOperator.cut G (f.val r) (f.val a) (L*D) ∧
    f.val v∈middles G (f.val a) (f.val r) L (f.val x) (f.val z)
  exact ⟨CrossThirdOperator.strong_copy_mem G _ L D f hax hrx,
    CrossThirdOperator.strong_copy_mem G _ L D f hrz haz,
    strong_middle G _ L D f hvx.symm hvz.symm hva hvr hxz⟩

end Erdos571.ThreeHubChannelSides

/-! An actual retained central pin embeds into channel-restricted assignments
with exactly its retained root mask. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

abbrev At (r : Roots (W := W) s) (u : W) :=
  Bundle G L s u r.1 × (Restricted G L T s i u r.2.1 × Side G L s u r.2.2)

noncomputable instance atFintype (r : Roots (W := W) s) (u : W) : Fintype (At G L T s i r u) := by
  classical
  infer_instance

abbrev Marked (J : Finset (Roots (W := W) s)) :=
  (p : J × W) × At G L T s i p.1.val p.2

abbrev Pin (J : Finset (Roots (W := W) s)) :=
  FiberRestrictionEnergy.Agreement (fun p : J × W => At G L T s i p.1.val p.2)

def forget {J : Finset (Roots (W := W) s)} (p : Marked G L T s i J) : Full G L s :=
  ⟨p.1.1.val,p.1.2,p.2.1,p.2.2.1.val,p.2.2.2⟩

lemma forget_injective {J : Finset (Roots (W := W) s)} : Function.Injective (forget G L T s i (J := J)) := by
  rintro ⟨⟨⟨r,hr⟩,u⟩,a,⟨b,hb⟩,c⟩ ⟨⟨⟨r',hr'⟩,u'⟩,a',⟨b',hb'⟩,c'⟩ he
  change (⟨r,u,a,b,c⟩ : Full G L s)=⟨r',u',a',b',c'⟩ at he
  cases he
  rfl

variable (hs : 1≤s) (D : ℝ)

noncomputable def markStrong {J : Finset (Roots (W := W) s)}
    (f : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D)
    (hf : (fromStrong G L s hs D f).1∈J) : Marked G L (L*D) s i J :=
  let p := fromStrong G L s hs D f
  ⟨(⟨p.1,hf⟩,p.2.1),p.2.2.1,⟨p.2.2.2.1,strong_allowed G L s hs i D f⟩,p.2.2.2.2⟩

lemma forget_markStrong {J : Finset (Roots (W := W) s)}
    (f : StrongPinnedCopies.RoleFamily (ThreeHub.template s) G L D)
    (hf : (fromStrong G L s hs D f).1∈J) :
    forget G L (L*D) s i (markStrong G L s i hs D f hf)=fromStrong G L s hs D f := rfl

noncomputable def markRetained (κ : ℝ) (p : ThreeHubRootPruning.Retained G L s hs D κ) :
    Marked G L (L*D) s i (ThreeHubRootPruning.mask G L s hs D κ) :=
  markStrong G L s i hs D p.2.val (by rw [p.2.property]; exact p.1.property)

lemma markRetained_injective (κ : ℝ) : Function.Injective (markRetained G L s i hs D κ) := by
  intro p q he
  have hf : fromStrong G L s hs D p.2.val=fromStrong G L s hs D q.2.val :=
    congrArg (forget G L (L*D) s i) he
  have hpq := fromStrong_injective G L s hs D hf
  rcases p with ⟨r,p,hp⟩
  rcases q with ⟨r',q,hq⟩
  change p=q at hpq
  subst q
  have hr : r=r' := Subtype.ext (hp.symm.trans hq)
  subst r'
  rfl

noncomputable def encodeCentralPin (κ : ℝ)
    (p : ThreeHubRootPruning.Pin G L s hs D κ (.inl 1)) :
    Pin G L (L*D) s i (ThreeHubRootPruning.mask G L s hs D κ) :=
  ⟨(markRetained G L s i hs D κ p.val.1,markRetained G L s i hs D κ p.val.2),by
    apply Prod.ext
    · apply Subtype.ext
      exact (fromStrong_roots G L s hs D p.val.1.2.val p.val.2.2.val).mpr p.property.1
    · exact p.property.2.1⟩

lemma encodeCentralPin_injective (κ : ℝ) : Function.Injective (encodeCentralPin G L s i hs D κ) := by
  intro p q he
  apply Subtype.ext
  apply Prod.ext
  · apply markRetained_injective G L s i hs D κ
    exact congrArg (fun t : Pin G L (L*D) s i (ThreeHubRootPruning.mask G L s hs D κ) => t.val.1) he
  · apply markRetained_injective G L s i hs D κ
    exact congrArg (fun t : Pin G L (L*D) s i (ThreeHubRootPruning.mask G L s hs D κ) => t.val.2) he

/-- Global cross-light conditions can be forgotten for this upper comparison;
the individual strong-copy channels and the original root mask remain. -/
theorem central_pin_le (κ : ℝ) :
    Nat.card (ThreeHubRootPruning.Pin G L s hs D κ (.inl 1)) ≤
      Nat.card (Pin G L (L*D) s i (ThreeHubRootPruning.mask G L s hs D κ)) :=
  Nat.card_le_card_of_injective _ (encodeCentralPin_injective G L s i hs D κ)

end Erdos571.ThreeHubChannelSides

/-! Exact slicing of the retained central-pin upper, with its middle-feature
profile retained. This is not a bound of that profile by agreement energy. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

abbrev Outer := W × W × Labels (W := W) s × Labels (W := W) s

noncomputable def slice (J : Finset (Roots (W := W) s)) (o : Outer (W := W) s) :
    Finset (Labels (W := W) s) :=
  univ.filter (fun q => q i=o.2.1 ∧ (o.2.2.1,q,o.2.2.2)∈J)

lemma mem_slice (J : Finset (Roots (W := W) s)) (o : Outer (W := W) s) (q : Labels (W := W) s) :
    q∈slice s i J o ↔ q i=o.2.1 ∧ (o.2.2.1,q,o.2.2.2)∈J := by
  classical
  simp only [slice,mem_filter,mem_univ,true_and]

noncomputable def sliceEquiv (J : Finset (Roots (W := W) s)) :
    (J × W) ≃ ((o : Outer (W := W) s) × slice s i J o) where
  toFun p := ⟨(p.2,p.1.val.2.1 i,p.1.val.1,p.1.val.2.2),
    ⟨p.1.val.2.1,(mem_slice s i J _ _).mpr ⟨rfl,p.1.property⟩⟩⟩
  invFun p := ⟨⟨(p.1.2.2.1,p.2.val,p.1.2.2.2),(mem_slice s i J _ _).mp p.2.property |>.2⟩,p.1.1⟩
  left_inv p := by rcases p with ⟨⟨⟨a,b,c⟩,hr⟩,u⟩; rfl
  right_inv p := by
    rcases p with ⟨⟨u,r,a,c⟩,⟨b,hb⟩⟩
    have he : b i=r := ((mem_slice s i J _ _).mp hb).1
    subst r
    rfl

/-- This identity slices an arbitrary coupled root mask, not a Cartesian
product of masks on the separate branches. -/
lemma sum_slices (J : Finset (Roots (W := W) s))
    (a : W → Labels (W := W) s → Labels (W := W) s → ℝ)
    (b : W → W → Labels (W := W) s → ℝ) :
    (∑ r∈J, ∑ u, a u r.1 r.2.2*b u (r.2.1 i) r.2.1)=
      ∑ o : Outer (W := W) s, a o.1 o.2.2.1 o.2.2.2 * ∑ q∈slice s i J o, b o.1 o.2.1 q := by
  classical
  calc
    _ = ∑ p : J × W, a p.2 p.1.val.1 p.1.val.2.2*b p.2 (p.1.val.2.1 i) p.1.val.2.1 := by
      rw [Fintype.sum_prod_type]
      exact (sum_coe_sort J (fun r => ∑ u, a u r.1 r.2.2*b u (r.2.1 i) r.2.1)).symm
    _ = ∑ p : (o : Outer (W := W) s) × slice s i J o,
        a p.1.1 p.1.2.2.1 p.1.2.2.2*b p.1.1 p.1.2.1 p.2.val :=
      Fintype.sum_equiv (sliceEquiv s i J) _ _ (fun _ => rfl)
    _ = _ := by
      rw [Fintype.sum_sigma]
      apply sum_congr rfl
      intro o _
      dsimp only
      rw [←mul_sum]
      congr 1
      exact sum_coe_sort (slice s i J o) (fun q => b o.1 o.2.1 q)

noncomputable def outerWeight (u : W) (a c : Labels (W := W) s) : ℝ :=
  ((Fintype.card (Bundle G L s u a):ℝ)*Fintype.card (Side G L s u c))^2

noncomputable def sideOutput (u r : W) (q : Labels (W := W) s) : ℝ :=
  ∑ x, output (FiniteChannelFeatures.kernel (choices G L T u r))
    (FiniteChannelFeatures.feature (Remaining G L s i)) (fun _ => 1) x q

noncomputable def slicedPinEnergy (J : Finset (Roots (W := W) s)) : ℝ :=
  ∑ o : Outer (W := W) s, outerWeight G L s o.1 o.2.2.1 o.2.2.2 *
    totalOutputEnergy (FiniteChannelFeatures.kernel (choices G L T o.1 o.2.1))
      (FiniteChannelFeatures.feature (Remaining G L s i)) (slice s i J o)

noncomputable def outerMass : ℝ :=
  ∑ o : Outer (W := W) s, outerWeight G L s o.1 o.2.2.1 o.2.2.2

noncomputable def profileMoment (J : Finset (Roots (W := W) s)) : ℝ :=
  ∑ o : Outer (W := W) s, outerWeight G L s o.1 o.2.2.1 o.2.2.2 *
    profileEnergy (FiniteChannelFeatures.kernel (choices G L T o.1 o.2.1))
      (FiniteChannelFeatures.feature (Remaining G L s i)) (slice s i J o)

lemma pin_card (J : Finset (Roots (W := W) s)) :
    (Nat.card (Pin G L T s i J):ℝ)=
      ∑ r∈J, ∑ u, outerWeight G L s u r.1 r.2.2*(Fintype.card (Restricted G L T s i u r.2.1):ℝ)^2 := by
  classical
  rw [Nat.card_congr (FiberRestrictionEnergy.agreementEquiv (fun p : J × W => At G L T s i p.1.val p.2)),
    Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum,Fintype.sum_prod_type]
  have he (r : J) (u : W) :
      (Fintype.card (At G L T s i r.val u × At G L T s i r.val u):ℝ)=
      outerWeight G L s u r.val.1 r.val.2.2*(Fintype.card (Restricted G L T s i u r.val.2.1):ℝ)^2 := by
    simp only [At,Fintype.card_prod,Nat.cast_mul,outerWeight]
    ring
  simp_rw [he]
  exact sum_coe_sort J (fun r => ∑ u, outerWeight G L s u r.1 r.2.2*
    (Fintype.card (Restricted G L T s i u r.2.1):ℝ)^2)

lemma pin_le_sliced (J : Finset (Roots (W := W) s)) :
    (Nat.card (Pin G L T s i J):ℝ)≤slicedPinEnergy G L T s i J := by
  rw [pin_card]
  calc
    _ ≤ ∑ r∈J, ∑ u, outerWeight G L s u r.1 r.2.2*(sideOutput G L T s i u (r.2.1 i) r.2.1)^2 := by
      apply sum_le_sum
      intro r _
      apply sum_le_sum
      intro u _
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (Nat.cast_nonneg _) (restricted_card G L T s i u r.2.1) 2) (sq_nonneg _)
    _ = _ := sum_slices s i J (outerWeight G L s) (fun u r q => (sideOutput G L T s i u r q)^2)

lemma cut_card_le (D : ℝ) (hdeg : ∀ x, (G.degree x:ℝ)≤D) (u r : W) :
    (Fintype.card (CrossThirdOperator.cut G u r T):ℝ)≤D := by
  have h := card_le_card (CrossThirdOperator.cut_subset G u r T)
  rw [card_neighborFinset_eq_degree] at h
  simpa only [Fintype.card_coe] using (show ((CrossThirdOperator.cut G u r T).card:ℝ)≤D from
    (Nat.cast_le.mpr h).trans (hdeg u))

/-- The whole central-pin interpolation. The displayed profileMoment is
still an additional quantity: it has not been identified with agreement. -/
theorem pin_interpolation (J : Finset (Roots (W := W) s)) (D Λ : ℝ)
    (hΛ : 0≤Λ) (hdeg : ∀ x, (G.degree x:ℝ)≤D)
    (hop : ∀ u r (f : CrossThirdOperator.cut G r u T → ℝ),
      (∑ x, (∑ z, channel (FiniteChannelFeatures.kernel (choices G L T u r)) x z*f z)^2)≤Λ*∑ z, (f z)^2) :
    (Nat.card (Pin G L T s i J):ℝ)^2 ≤
      (D^3*Λ)*outerMass G L s*profileMoment G L T s i J := by
  have h := sliced_totalOutputEnergy
    (fun o : Outer (W := W) s => FiniteChannelFeatures.kernel (choices G L T o.1 o.2.1))
    (fun _ => FiniteChannelFeatures.feature (Remaining G L s i)) (slice s i J)
    (fun o => outerWeight G L s o.1 o.2.2.1 o.2.2.2) D Λ (fun _ => sq_nonneg _) hΛ
    (fun o => FiniteChannelFeatures.kernel_nonneg _) (fun _ v q _ => FiniteChannelFeatures.feature_nonneg _ v q)
    (fun o => cut_card_le G T D hdeg o.1 o.2.1) (fun o => cut_card_le G T D hdeg o.2.1 o.1)
    (fun o => hop o.1 o.2.1)
  exact (pow_le_pow_left₀ (Nat.cast_nonneg _) (pin_le_sliced G L T s i J) 2).trans h

end Erdos571.ThreeHubChannelSides

/-! The actual freeness-supplied central-pin interpolation on the retained
root mask. The remaining profile moment is deliberately displayed. -/
set_option maxHeartbeats 2800000
namespace Erdos571.ThreeHub
open Finset SimpleGraph MiddleFeatureInterpolation LightFourChannel ThreeHubChannelSides

/-- A genuine retained strong central pin satisfies this bound, using the
exact hereditary channel operator from original subdivision freeness.
No matching agreement-energy bound for profileMoment is claimed. -/
theorem drc_retained_central_pin_interpolation (s M L : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0≤Q) :
    ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0<d → (∀ x, (G.degree x:ℝ)≤Q*d) →
      ∀ (hs' : 1≤s) (i : Fin s) (κ : ℝ),
        (Nat.card (ThreeHubRootPruning.Pin G L s hs' (Q*d) κ (.inl 1)):ℝ)^2 ≤
          ((Q*d)^3*(C*d^(2-2/((s:ℝ)+1))))*outerMass G L s*
            profileMoment G L ((L:ℝ)*(Q*d)) s i (ThreeHubRootPruning.mask G L s hs' (Q*d) κ) := by
  obtain ⟨C,hC,h⟩ := drc_exact_hereditary_channel s M L hs Q hQ
  refine ⟨C,hC,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg hs' i κ
  have hop := fun u r => h W G hf hbi d hd hdeg u r ((L:ℝ)*(Q*d))
    (channel (FiniteChannelFeatures.kernel (choices G L ((L:ℝ)*(Q*d)) u r)))
    (ThreeHubChannelSides.choices_dominated G L ((L:ℝ)*(Q*d)) u r)
  have hc : (Nat.card (ThreeHubRootPruning.Pin G L s hs' (Q*d) κ (.inl 1)):ℝ) ≤
      Nat.card (ThreeHubChannelSides.Pin G L ((L:ℝ)*(Q*d)) s i (ThreeHubRootPruning.mask G L s hs' (Q*d) κ)) := by
    exact_mod_cast central_pin_le G L s i hs' (Q*d) κ
  exact (pow_le_pow_left₀ (Nat.cast_nonneg _) hc 2).trans
    (pin_interpolation G L ((L:ℝ)*(Q*d)) s i _ (Q*d) (C*d^(2-2/((s:ℝ)+1)))
      (mul_nonneg hC (Real.rpow_nonneg hd.le _)) hdeg hop)

end Erdos571.ThreeHub

/-! The selected root is fixed in each slice, so the middle profile has
s-1 free arm labels, not s free labels. -/
set_option maxHeartbeats 2500000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph Matrix ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (s : ℕ) (i : Fin s)

lemma remaining_energy_le (D : ℝ) (hD : 0≤D) (hdeg : ∀ x, (G.degree x:ℝ)≤D)
    (S : Finset (Labels (W := W) s)) (r : W) (hS : ∀ q∈S, q i=r) (v : W) :
    (∑ q∈S, (FiniteChannelFeatures.feature (Remaining G L s i) v q)^2) ≤
      ((L:ℝ)*D^2)^(s-1) := by
  classical
  let f : Labels (W := W) s → (MaskedBush.Without i → W) := fun q j => q j.val
  have hi : Set.InjOn f S := by
    intro q hq q' hq' he
    funext j
    by_cases hj : j=i
    · subst j
      exact (hS q hq).trans (hS q' hq').symm
    · exact congrFun he ⟨j,hj⟩
  have hrow : (∑ r, (LightArmKernel.matrix G L v r)^2)≤(L:ℝ)*D^2 := by
    calc
      _ ≤ (L:ℝ)*∑ r, LightArmKernel.matrix G L v r := by
        rw [mul_sum]
        exact sum_le_sum (fun r _ => by
          simpa only [pow_two] using mul_le_mul_of_nonneg_right
            (LightArmKernel.cap G L (Nat.cast_nonneg _) v r) (LightArmKernel.nonneg G L v r))
      _ ≤ _ := mul_le_mul_of_nonneg_left (LightArmKernel.row_upper G L D hD hdeg v) (Nat.cast_nonneg _)
  calc
    _ = ∑ q∈S.image f, (ArmTensor.tensor (LightArmKernel.matrix G L) (MaskedBush.Without i) v q)^2 := by
      rw [sum_image hi]
      apply sum_congr rfl
      intro q _
      simp only [FiniteChannelFeatures.feature,Remaining,MaskedBush.card_bundle]
      rfl
    _ ≤ ∑ q, (ArmTensor.tensor (LightArmKernel.matrix G L) (MaskedBush.Without i) v q)^2 :=
      sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun _ _ _ => sq_nonneg _)
    _ = (∑ r, (LightArmKernel.matrix G L v r)^2)^(s-1) := by
      have h := ArmTensor.gram (LightArmKernel.matrix G L) (MaskedBush.Without i) v v
      simpa only [Matrix.mul_apply,Matrix.transpose_apply,←pow_two,GramPin.entryPower,MaskedBush.card_without,Fintype.card_fin] using h
    _ ≤ _ := pow_le_pow_left₀ (sum_nonneg (fun _ _ => sq_nonneg _)) hrow (s-1)

/-- The full retained-root mask may couple all three groups. Only its
selected-coordinate condition is used for this uniform cap. -/
theorem sliced_profile_cap (D : ℝ) (hD : 0≤D) (hdeg : ∀ x, (G.degree x:ℝ)≤D)
    (J : Finset (Roots (W := W) s)) (o : Outer (W := W) s) (v : W) :
    (∑ q∈slice s i J o, (FiniteChannelFeatures.feature (Remaining G L s i) v q)^2) ≤
      ((L:ℝ)*D^2)^(s-1) :=
  remaining_energy_le G L s i D hD hdeg _ o.2.1
    (fun q hq => ((mem_slice s i J o q).mp hq).1) v

end Erdos571.ThreeHubChannelSides


/-! The four-walk channel encodes the restricted side exactly, including its
selected arm. This is a cardinality identification, not a sharp pin bound. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

noncomputable def restoreBundle (v : W) (q : Labels (W := W) s)
    (a : MaskedBush.Arm G L v (q i)) (b : Remaining G L s i v q) : Bundle G L s v q := by
  classical
  intro j
  exact if h : j=i then h.symm ▸ a else b ⟨j,h⟩

lemma restoreBundle_selected (v : W) (q : Labels (W := W) s)
    (a : MaskedBush.Arm G L v (q i)) (b : Remaining G L s i v q) :
    restoreBundle G L s i v q a b i=a := by
  classical
  simp [restoreBundle]

lemma restoreBundle_remaining (v : W) (q : Labels (W := W) s)
    (a : MaskedBush.Arm G L v (q i)) (b : Remaining G L s i v q)
    (j : MaskedBush.Without i) : restoreBundle G L s i v q a b j.val=b j := by
  classical
  simp [restoreBundle,j.property]

noncomputable def restoreSide (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    Side G L s u q := by
  let x := p.1
  let z := p.2.1
  let v := p.2.2.1
  have hv := (mem_middles G u (q i) L x.val z.val v.val).mp v.property
  let a : MaskedBush.Arm G L v.val (q i) :=
    ⟨⟨(MaskedArmPairTrace.arm_light_iff G L v.val (q i)).mpr
      ⟨hv.2.2.2.1,by simpa only [LocalFourthWalk.common,inter_comm] using hv.2.2.2.2.2.1⟩⟩,
      ⟨z.val,hv.2.1.symm,((CrossThirdOperator.mem_cut G (q i) u z.val T).mp z.property).1⟩⟩
  exact ⟨v.val,⟨x.val,((CrossThirdOperator.mem_cut G u (q i) x.val T).mp x.property).1,hv.1.symm⟩,
    restoreBundle G L s i v.val q a p.2.2.2⟩

lemma restoreSide_hub (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    (restoreSide G L T s i u q p).1=p.2.2.1.val := rfl

lemma restoreSide_core (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    (restoreSide G L T s i u q p).2.1.val=p.1.val := rfl

lemma restoreSide_selected (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    MaskedBush.middle G L ((restoreSide G L T s i u q p).2.2 i)=p.2.1.val := by
  dsimp only [restoreSide]
  rw [restoreBundle_selected]
  rfl

lemma restoreSide_remaining (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q)
    (j : MaskedBush.Without i) :
    (restoreSide G L T s i u q p).2.2 j.val=p.2.2.2 j := by
  dsimp only [restoreSide]
  exact restoreBundle_remaining G L s i _ _ _ _ j

lemma restoreSide_allowed (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    Allowed G L T s i u q (restoreSide G L T s i u q p) := by
  change _ ∧ _ ∧ _
  rw [restoreSide_core,restoreSide_selected,restoreSide_hub]
  exact ⟨p.1.property,p.2.1.property,p.2.2.1.property⟩

noncomputable def decode (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    Restricted G L T s i u q :=
  ⟨restoreSide G L T s i u q p,restoreSide_allowed G L T s i u q p⟩

lemma row_ext (u : W) (q : Labels (W := W) s)
    (p p' : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q)
    (hx : p.1.val=p'.1.val) (hz : p.2.1.val=p'.2.1.val) (hv : p.2.2.1.val=p'.2.2.1.val)
    (hb : ∀ j : MaskedBush.Without i,
      MaskedBush.middle G L (p.2.2.2 j)=MaskedBush.middle G L (p'.2.2.2 j)) : p=p' := by
  rcases p with ⟨x,z,v,b⟩
  rcases p' with ⟨x',z',v',b'⟩
  have hxx : x=x' := Subtype.ext hx
  subst x'
  have hzz : z=z' := Subtype.ext hz
  subst z'
  have hvv : v=v' := Subtype.ext hv
  subst v'
  have hbb : b=b' := by
    funext j
    exact MaskedBush.arm_ext G L _ _ (hb j)
  subst b'
  rfl

lemma encode_decode (u : W) (q : Labels (W := W) s)
    (p : FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q) :
    encode G L T s i u q (decode G L T s i u q p)=p := by
  apply row_ext G L T s i u q
  · exact restoreSide_core G L T s i u q p
  · exact restoreSide_selected G L T s i u q p
  · exact restoreSide_hub G L T s i u q p
  · intro j
    exact congrArg (MaskedBush.middle G L) (restoreSide_remaining G L T s i u q p j)

lemma decode_encode (u : W) (q : Labels (W := W) s) (p : Restricted G L T s i u q) :
    decode G L T s i u q (encode G L T s i u q p)=p := by
  apply encode_injective G L T s i u q
  exact encode_decode G L T s i u q (encode G L T s i u q p)

noncomputable def sideEquiv (u : W) (q : Labels (W := W) s) :
    Restricted G L T s i u q ≃
      FiniteChannelFeatures.TotalRow (choices G L T u (q i)) (Remaining G L s i) q where
  toFun := encode G L T s i u q
  invFun := decode G L T s i u q
  left_inv := decode_encode G L T s i u q
  right_inv := encode_decode G L T s i u q

lemma restricted_card_eq (u : W) (q : Labels (W := W) s) :
    (Fintype.card (Restricted G L T s i u q):ℝ)=sideOutput G L T s i u (q i) q := by
  rw [Fintype.card_congr (sideEquiv G L T s i u q)]
  exact FiniteChannelFeatures.total_row_card _ _ q

lemma pin_eq_sliced (J : Finset (Roots (W := W) s)) :
    (Nat.card (Pin G L T s i J):ℝ)=slicedPinEnergy G L T s i J := by
  rw [pin_card]
  simp_rw [restricted_card_eq]
  exact sum_slices s i J (outerWeight G L s) (fun u r q => (sideOutput G L T s i u r q)^2)

end Erdos571.ThreeHubChannelSides

/-! A profile row-mass estimate. Its uniform cap is explicit and may lose
powers of the host degree. -/
set_option maxHeartbeats 2000000
namespace Erdos571.MiddleFeatureInterpolation
open Finset
variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]

noncomputable def profileMass (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R) : ℝ :=
  ∑ x, ∑ z, weightedChannel c (fun v => ∑ q∈S, (F v q)^2) x z

lemma profileMass_nonneg (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) : 0≤profileMass c F S := by
  unfold profileMass weightedChannel
  exact sum_nonneg (fun x _ => sum_nonneg (fun z _ => sum_nonneg (fun v _ =>
    mul_nonneg (hc x z v) (sum_nonneg (fun q _ => sq_nonneg _)))))

lemma profile_row_bound (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) (B T : ℝ) (hB : 0≤B)
    (hcap : ∀ v, ∑ q∈S, (F v q)^2≤B)
    (hrow : ∀ x, ∑ z, channel c x z≤T) (x : I) :
    (∑ z, weightedChannel c (fun v => ∑ q∈S, (F v q)^2) x z)≤B*T := by
  calc
    _ ≤ ∑ z, ∑ v, c x z v*B := by
      exact sum_le_sum (fun z _ => sum_le_sum (fun v _ => mul_le_mul_of_nonneg_left (hcap v) (hc x z v)))
    _ = B*∑ z, channel c x z := by simp only [channel,←sum_mul]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (hrow x) hB

theorem profileEnergy_le_mass (c : I → J → V → ℝ) (F : V → R → ℝ) (S : Finset R)
    (hc : ∀ x z v, 0≤c x z v) (B T : ℝ) (hB : 0≤B)
    (hcap : ∀ v, ∑ q∈S, (F v q)^2≤B)
    (hrow : ∀ x, ∑ z, channel c x z≤T) :
    profileEnergy c F S ≤ (B*T)*profileMass c F S := by
  unfold profileEnergy profileMass
  rw [mul_sum]
  apply sum_le_sum
  intro x _
  have hn : 0≤∑ z, weightedChannel c (fun v => ∑ q∈S, (F v q)^2) x z := by
    exact sum_nonneg (fun z _ => sum_nonneg (fun v _ =>
      mul_nonneg (hc x z v) (sum_nonneg (fun q _ => sq_nonneg _))))
  simpa only [pow_two] using mul_le_mul_of_nonneg_right
    (profile_row_bound c F S hc B T hB hcap hrow x) hn

end Erdos571.MiddleFeatureInterpolation

/-! A middle profile represents two rows with exactly the same walk choices.
It therefore embeds into the ordinary total agreement on the same mask. -/
set_option maxHeartbeats 2300000
namespace Erdos571.FiniteChannelFeatures
open Finset MiddleFeatureInterpolation
variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]
variable (S : I → J → Finset V) (B : V → R → Type*) [∀ v q, Fintype (B v q)]

abbrev TotalProfile (Q : Finset R) := (x : I) × WeightedRow S B Q x

def profileAgreement (Q : Finset R) (p : TotalProfile S B Q) : TotalAgreement S B Q :=
  ⟨p.2.2.2.1,⟨p.1,p.2.1,p.2.2.1,p.2.2.2.2.1⟩,⟨p.1,p.2.1,p.2.2.1,p.2.2.2.2.2⟩⟩

lemma profileAgreement_injective (Q : Finset R) : Function.Injective (profileAgreement S B Q) := by
  rintro ⟨x,z,v,q,b,c⟩ ⟨x',z',v',q',b',c'⟩ he
  have hq : q=q' := congrArg Sigma.fst he
  subst q'
  have hh : ((⟨x,z,v,b⟩ : TotalRow S B q.val),(⟨x,z,v,c⟩ : TotalRow S B q.val))=
      (⟨x',z',v',b'⟩,⟨x',z',v',c'⟩) := eq_of_heq (Sigma.mk.inj he).2
  have h₁ := (Prod.mk.inj hh).1
  have h₂ := (Prod.mk.inj hh).2
  have hx : x=x' := congrArg Sigma.fst h₁
  subst x'
  have hz : z=z' := congrArg (fun p : TotalRow S B q.val => p.2.1) h₁
  subst z'
  have hv : v=v' := Subtype.ext (congrArg (fun p : TotalRow S B q.val => p.2.2.1.val) h₁)
  subst v'
  have hb : b=b' := by simpa only [Sigma.mk.inj_iff,heq_eq_eq,true_and] using h₁
  have hc : c=c' := by simpa only [Sigma.mk.inj_iff,heq_eq_eq,true_and] using h₂
  subst b' c'
  rfl

lemma total_profile_card (Q : Finset R) :
    (Nat.card (TotalProfile S B Q):ℝ)=profileMass (kernel S) (feature B) Q := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  exact sum_congr rfl (fun x _ => weighted_row_card S B Q x)

/-- The injection repeats the entire channel choice, not just the middle
hub. No feature labels outside Q are introduced. -/
theorem profileMass_le_totalOutputEnergy (Q : Finset R) :
    profileMass (kernel S) (feature B) Q ≤ totalOutputEnergy (kernel S) (feature B) Q := by
  rw [←total_profile_card,←total_agreement_card]
  exact_mod_cast Nat.card_le_card_of_injective _ (profileAgreement_injective S B Q)

theorem profileEnergy_le_totalOutputEnergy (Q : Finset R) (B₀ T : ℝ) (hB : 0≤B₀)
    (hcap : ∀ v, ∑ q∈Q, (feature B v q)^2≤B₀)
    (hrow : ∀ x, ∑ z, channel (kernel S) x z≤T) (hT : 0≤T) :
    profileEnergy (kernel S) (feature B) Q ≤ (B₀*T)*totalOutputEnergy (kernel S) (feature B) Q :=
  (profileEnergy_le_mass (kernel S) (feature B) Q (kernel_nonneg S) B₀ T hB hcap hrow).trans
    (mul_le_mul_of_nonneg_left (profileMass_le_totalOutputEnergy S B Q) (mul_nonneg hB hT))

end Erdos571.FiniteChannelFeatures

/-! Comparing profile moments with the same masked agreement family. The
factor from the uniform profile cap is explicit and is not sharp. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

noncomputable def profileMassMoment (J : Finset (Roots (W := W) s)) : ℝ :=
  ∑ o : Outer (W := W) s, outerWeight G L s o.1 o.2.2.1 o.2.2.2 *
    profileMass (FiniteChannelFeatures.kernel (choices G L T o.1 o.2.1))
      (FiniteChannelFeatures.feature (Remaining G L s i)) (slice s i J o)

lemma profileMassMoment_le_pin (J : Finset (Roots (W := W) s)) :
    profileMassMoment G L T s i J ≤ (Nat.card (Pin G L T s i J):ℝ) := by
  rw [pin_eq_sliced]
  exact sum_le_sum (fun o _ => mul_le_mul_of_nonneg_left
    (FiniteChannelFeatures.profileMass_le_totalOutputEnergy _ _ _) (sq_nonneg _))

def markToMasked {J : Finset (Roots (W := W) s)} (p : Marked G L T s i J) :
    RootFiberPruning.Masked (Fiber G L s) J :=
  ⟨p.1.1,p.1.2,p.2.1,p.2.2.1.val,p.2.2.2⟩

lemma markToMasked_injective {J : Finset (Roots (W := W) s)} :
    Function.Injective (markToMasked G L T s i (J := J)) := by
  intro p q he
  apply forget_injective G L T s i
  exact congrArg (fun t : RootFiberPruning.Masked (Fiber G L s) J =>
    (⟨t.1.val,t.2⟩ : Full G L s)) he

def pinToAgreement {J : Finset (Roots (W := W) s)} (p : Pin G L T s i J) :
    RootFiberPruning.MaskedAgreement (Fiber G L s) J :=
  ⟨(markToMasked G L T s i p.val.1,markToMasked G L T s i p.val.2),
    congrArg Prod.fst p.property⟩

lemma pinToAgreement_injective {J : Finset (Roots (W := W) s)} :
    Function.Injective (pinToAgreement G L T s i (J := J)) := by
  intro p q he
  apply Subtype.ext
  apply Prod.ext
  · apply markToMasked_injective G L T s i
    exact congrArg (fun t : RootFiberPruning.MaskedAgreement (Fiber G L s) J => t.val.1) he
  · apply markToMasked_injective G L T s i
    exact congrArg (fun t : RootFiberPruning.MaskedAgreement (Fiber G L s) J => t.val.2) he

lemma pin_le_allAgreement (J : Finset (Roots (W := W) s)) :
    Nat.card (Pin G L T s i J) ≤ Nat.card (RootFiberPruning.MaskedAgreement (Fiber G L s) J) :=
  Nat.card_le_card_of_injective _ (pinToAgreement_injective G L T s i)

lemma profileMassMoment_le_allAgreement (J : Finset (Roots (W := W) s)) :
    profileMassMoment G L T s i J ≤
      (Nat.card (RootFiberPruning.MaskedAgreement (Fiber G L s) J):ℝ) :=
  (profileMassMoment_le_pin G L T s i J).trans (by exact_mod_cast pin_le_allAgreement G L T s i J)

lemma choices_row_bound (u r : W) :
    ∀ x, ∑ z, channel (FiniteChannelFeatures.kernel (choices G L T u r)) x z≤T := by
  apply (CrossThirdOperator.masked_rows_cols G u r T _ ?_).1
  intro x z
  have h := ThreeHubChannelSides.choices_dominated G L T u r x z
  exact ⟨h.1,h.2.trans ((LightFourChannel.bounds G u r T L).1 x z).2⟩

/-- This keeps the profile mass, before its finite embedding into agreement.
The coefficient is a uniform cap and is not claimed to be optimal. -/
theorem profileMoment_le_mass (J : Finset (Roots (W := W) s)) (D : ℝ)
    (hD : 0≤D) (hdeg : ∀ x, (G.degree x:ℝ)≤D) :
    profileMoment G L T s i J ≤ (((L:ℝ)*D^2)^(s-1)*T)*profileMassMoment G L T s i J := by
  unfold profileMoment profileMassMoment
  rw [mul_sum]
  apply sum_le_sum
  intro o _
  have h := profileEnergy_le_mass (FiniteChannelFeatures.kernel (choices G L T o.1 o.2.1))
    (FiniteChannelFeatures.feature (Remaining G L s i)) (slice s i J o)
    (FiniteChannelFeatures.kernel_nonneg _) (((L:ℝ)*D^2)^(s-1)) T (by positivity)
    (sliced_profile_cap G L s i D hD hdeg J o) (choices_row_bound G L T o.1 o.2.1)
  exact (mul_le_mul_of_nonneg_left h (sq_nonneg _)).trans_eq (by unfold outerWeight; ring)

/-- The same original J occurs in the profile and agreement. The cost
(L D^2)^(s-1) T must not be suppressed when applying this theorem. -/
theorem profileMoment_le_allAgreement (J : Finset (Roots (W := W) s)) (D : ℝ)
    (hD : 0≤D) (hdeg : ∀ x, (G.degree x:ℝ)≤D) (hT : 0≤T) :
    profileMoment G L T s i J ≤ (((L:ℝ)*D^2)^(s-1)*T)*
      (Nat.card (RootFiberPruning.MaskedAgreement (Fiber G L s) J):ℝ) :=
  (profileMoment_le_mass G L T s i J D hD hdeg).trans
    (mul_le_mul_of_nonneg_left (profileMassMoment_le_allAgreement G L T s i J) (by positivity))

end Erdos571.ThreeHubChannelSides

/-! An explicit, nonsharp retained central-pin versus agreement inequality.
The uniform-profile cost remains visible. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L s : ℕ)

lemma outerMass_nonneg : 0≤outerMass G L s :=
  sum_nonneg (fun _ _ => sq_nonneg _)

end Erdos571.ThreeHubChannelSides

namespace Erdos571.ThreeHub
open Finset SimpleGraph ThreeHubChannelSides

/-- This compares to the original retained agreement, but the coefficient
has the full uniform feature-energy factor. It does not establish the
sharp ThreeHub exponent or a universal upper transfer. -/
theorem drc_retained_central_pin_vs_agreement (s M L : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0≤Q) :
    ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0<d → (∀ x, (G.degree x:ℝ)≤Q*d) →
      ∀ (hs' : 1≤s) (κ : ℝ),
        (Nat.card (ThreeHubRootPruning.Pin G L s hs' (Q*d) κ (.inl 1)):ℝ)^2 ≤
          (((Q*d)^3*(C*d^(2-2/((s:ℝ)+1))))*outerMass G L s*
            (((L:ℝ)*(Q*d)^2)^(s-1)*((L:ℝ)*(Q*d))))*
              (Nat.card (ThreeHubRootPruning.AllAgreement G L s hs' (Q*d) κ):ℝ) := by
  obtain ⟨C,hC,h⟩ := drc_retained_central_pin_interpolation s M L hs Q hQ
  refine ⟨C,hC,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg hs' κ
  let i : Fin s := ⟨0,by omega⟩
  have hD : 0≤Q*d := mul_nonneg hQ hd.le
  have hp := profileMoment_le_allAgreement G L ((L:ℝ)*(Q*d)) s i
    (ThreeHubRootPruning.mask G L s hs' (Q*d) κ) (Q*d) hD hdeg
    (mul_nonneg (Nat.cast_nonneg _) hD)
  have hcoef : 0≤((Q*d)^3*(C*d^(2-2/((s:ℝ)+1))))*outerMass G L s :=
    mul_nonneg (mul_nonneg (pow_nonneg hD _) (mul_nonneg hC (Real.rpow_nonneg hd.le _)))
      (outerMass_nonneg G L s)
  exact (h W G hf hbi d hd hdeg hs' i κ).trans
    ((mul_le_mul_of_nonneg_left hp hcoef).trans_eq (by dsimp only [ThreeHubRootPruning.AllAgreement]; ring))

end Erdos571.ThreeHub

/- A profile is exactly an agreement that repeats every channel choice. -/
set_option maxHeartbeats 2400000
namespace Erdos571.FiniteChannelFeatures
open Finset MiddleFeatureInterpolation
variable {I J V R : Type*} [Fintype I] [Fintype J] [Fintype V] [Fintype R]
variable (S : I → J → Finset V) (B : V → R → Type*) [∀ v q, Fintype (B v q)]

def rowChoice {q : R} (p : TotalRow S B q) : I × J × V :=
  (p.1,p.2.1,p.2.2.1.val)

abbrev ChoiceRow (q : R) :=
  {p : TotalRow S B q × TotalRow S B q // rowChoice S B p.1=rowChoice S B p.2}
abbrev ChoiceAgreement (Q : Finset R) := (q : Q) × ChoiceRow S B q.val
abbrev FixedProfile (q : R) := (x : I) × (z : J) × (v : S x z) × (B v.val q × B v.val q)

def fixedToChoice (q : R) (p : FixedProfile S B q) : ChoiceRow S B q :=
  ⟨(⟨p.1,p.2.1,p.2.2.1,p.2.2.2.1⟩,⟨p.1,p.2.1,p.2.2.1,p.2.2.2.2⟩),rfl⟩

def choiceToFixed (q : R) (p : ChoiceRow S B q) : FixedProfile S B q := by
  rcases p with ⟨⟨⟨x,z,v,b⟩,⟨x',z',v',c⟩⟩,he⟩
  have hx : x=x' := congrArg Prod.fst he
  subst x'
  have hz : z=z' := congrArg (fun p : I × J × V => p.2.1) he
  subst z'
  have hv : v=v' := Subtype.ext (congrArg (fun p : I × J × V => p.2.2) he)
  subst v'
  exact ⟨x,z,v,b,c⟩

def fixedChoiceEquiv (q : R) : FixedProfile S B q ≃ ChoiceRow S B q where
  toFun := fixedToChoice S B q
  invFun := choiceToFixed S B q
  left_inv p := by rcases p with ⟨x,z,v,b,c⟩; rfl
  right_inv p := by
    rcases p with ⟨⟨⟨x,z,v,b⟩,⟨x',z',v',c⟩⟩,he⟩
    have hx : x=x' := congrArg Prod.fst he
    subst x'
    have hz : z=z' := congrArg (fun p : I × J × V => p.2.1) he
    subst z'
    have hv : v=v' := Subtype.ext (congrArg (fun p : I × J × V => p.2.2) he)
    subst v'
    rfl

def totalFixedEquiv (Q : Finset R) : TotalProfile S B Q ≃ ((q : Q) × FixedProfile S B q.val) where
  toFun p := ⟨p.2.2.2.1,p.1,p.2.1,p.2.2.1,p.2.2.2.2⟩
  invFun p := ⟨p.2.1,p.2.2.1,p.2.2.2.1,p.1,p.2.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def profileChoiceEquiv (Q : Finset R) : TotalProfile S B Q ≃ ChoiceAgreement S B Q :=
  (totalFixedEquiv S B Q).trans (Equiv.sigmaCongrRight (fun q => fixedChoiceEquiv S B q.val))

lemma choice_agreement_card (Q : Finset R) :
    (Nat.card (ChoiceAgreement S B Q):ℝ)=profileMass (kernel S) (feature B) Q := by
  rw [←Nat.card_congr (profileChoiceEquiv S B Q)]
  exact total_profile_card S B Q

noncomputable def fixedProfileMass (q : R) : ℝ :=
  ∑ x, ∑ z, ∑ v : S x z, (feature B v.val q)^2

lemma choice_row_card (q : R) :
    (Nat.card (ChoiceRow S B q):ℝ)=fixedProfileMass S B q := by
  classical
  rw [←Nat.card_congr (fixedChoiceEquiv S B q)]
  simp only [Nat.card_eq_fintype_card,FixedProfile,Fintype.card_sigma,Fintype.card_prod,
    Nat.cast_sum,Nat.cast_mul,fixedProfileMass,feature,pow_two]

lemma profileMass_eq_sum_fixed (Q : Finset R) :
    profileMass (kernel S) (feature B) Q=∑ q∈Q, fixedProfileMass S B q := by
  classical
  rw [←choice_agreement_card,Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  simp_rw [←Nat.card_eq_fintype_card,choice_row_card]
  exact sum_coe_sort Q (fixedProfileMass S B)

end Erdos571.FiniteChannelFeatures

/- The profile mass counts a multiple-pin subfamily on the original root mask. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments LightFourChannel MiddleFeatureInterpolation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

def sideChoice {u : W} {q : Labels (W := W) s} (p : Side G L s u q) : W × W × W :=
  (p.2.1.val,MaskedBush.middle G L (p.2.2 i),p.1)

abbrev ChoiceSide (u : W) (q : Labels (W := W) s) :=
  {p : Restricted G L T s i u q × Restricted G L T s i u q //
    sideChoice G L s i p.1.val=sideChoice G L s i p.2.val}

lemma rowChoice_encode_iff (u : W) (q : Labels (W := W) s)
    (p p' : Restricted G L T s i u q) :
    FiniteChannelFeatures.rowChoice (choices G L T u (q i)) (Remaining G L s i)
      (encode G L T s i u q p)=
    FiniteChannelFeatures.rowChoice (choices G L T u (q i)) (Remaining G L s i)
      (encode G L T s i u q p') ↔ sideChoice G L s i p.val=sideChoice G L s i p'.val := by
  constructor
  · intro h
    exact congrArg (fun t : CrossThirdOperator.cut G u (q i) T ×
      CrossThirdOperator.cut G (q i) u T × W => (t.1.val,t.2.1.val,t.2.2)) h
  · intro h
    apply Prod.ext
    · exact Subtype.ext (congrArg Prod.fst h)
    · apply Prod.ext
      · exact Subtype.ext (congrArg (fun t : W × W × W => t.2.1) h)
      · exact congrArg (fun t : W × W × W => t.2.2) h

noncomputable def sideChoiceEquiv (u : W) (q : Labels (W := W) s) :
    ChoiceSide G L T s i u q ≃
      FiniteChannelFeatures.ChoiceRow (choices G L T u (q i)) (Remaining G L s i) q where
  toFun p := ⟨(encode G L T s i u q p.val.1,encode G L T s i u q p.val.2),
    (rowChoice_encode_iff G L T s i u q _ _).mpr p.property⟩
  invFun p := ⟨(decode G L T s i u q p.val.1,decode G L T s i u q p.val.2),by
    apply (rowChoice_encode_iff G L T s i u q _ _).mp
    simpa only [encode_decode] using p.property⟩
  left_inv p := by
    apply Subtype.ext
    exact Prod.ext (decode_encode G L T s i u q p.val.1) (decode_encode G L T s i u q p.val.2)
  right_inv p := by
    apply Subtype.ext
    exact Prod.ext (encode_decode G L T s i u q p.val.1) (encode_decode G L T s i u q p.val.2)

lemma choice_side_card (u : W) (q : Labels (W := W) s) :
    (Nat.card (ChoiceSide G L T s i u q):ℝ)=
      FiniteChannelFeatures.fixedProfileMass (choices G L T u (q i)) (Remaining G L s i) q := by
  rw [Nat.card_congr (sideChoiceEquiv G L T s i u q)]
  exact FiniteChannelFeatures.choice_row_card _ _ q

abbrev Outside (u : W) (a c : Labels (W := W) s) := Bundle G L s u a × Side G L s u c
abbrev ProfilePinned (J : Finset (Roots (W := W) s)) :=
  (p : J × W) × ((Outside G L s p.2 p.1.val.1 p.1.val.2.2 ×
    Outside G L s p.2 p.1.val.1 p.1.val.2.2) × ChoiceSide G L T s i p.2 p.1.val.2.1)

noncomputable instance choiceSideFintype (u : W) (q : Labels (W := W) s) :
    Fintype (ChoiceSide G L T s i u q) := by
  classical
  infer_instance

lemma profile_pinned_card (J : Finset (Roots (W := W) s)) :
    (Nat.card (ProfilePinned G L T s i J):ℝ)=profileMassMoment G L T s i J := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum,Fintype.sum_prod_type]
  have h (r : J) (u : W) :
      (Fintype.card ((Outside G L s u r.val.1 r.val.2.2 × Outside G L s u r.val.1 r.val.2.2) ×
        ChoiceSide G L T s i u r.val.2.1):ℝ)=
      outerWeight G L s u r.val.1 r.val.2.2 *
        FiniteChannelFeatures.fixedProfileMass (choices G L T u (r.val.2.1 i)) (Remaining G L s i) r.val.2.1 := by
    rw [Fintype.card_prod,Nat.cast_mul,←Nat.card_eq_fintype_card (α := ChoiceSide G L T s i u r.val.2.1),
      choice_side_card]
    congr 1
    simp only [Fintype.card_prod,Nat.cast_mul,Outside,outerWeight]
    ring
  simp_rw [h]
  rw [sum_coe_sort J (fun r => ∑ u, outerWeight G L s u r.1 r.2.2 *
    FiniteChannelFeatures.fixedProfileMass (choices G L T u (r.2.1 i)) (Remaining G L s i) r.2.1)]
  rw [sum_slices s i J (outerWeight G L s)
    (fun u r q => FiniteChannelFeatures.fixedProfileMass (choices G L T u r) (Remaining G L s i) q)]
  unfold profileMassMoment
  exact sum_congr rfl (fun o _ => congrArg (fun z => outerWeight G L s o.1 o.2.2.1 o.2.2.2*z)
    (FiniteChannelFeatures.profileMass_eq_sum_fixed _ _ _).symm)

def profileToPin {J : Finset (Roots (W := W) s)} (p : ProfilePinned G L T s i J) : Pin G L T s i J :=
  ⟨(⟨p.1,p.2.1.1.1,p.2.2.val.1,p.2.1.1.2⟩,
    ⟨p.1,p.2.1.2.1,p.2.2.val.2,p.2.1.2.2⟩),rfl⟩

lemma profileToPin_injective {J : Finset (Roots (W := W) s)} :
    Function.Injective (profileToPin G L T s i (J := J)) := by
  rintro ⟨p,⟨⟨a,c⟩,⟨a',c'⟩⟩,⟨⟨b,b'⟩,hb⟩⟩ ⟨q,⟨⟨d,e⟩,⟨d',e'⟩⟩,⟨⟨f,f'⟩,hf⟩⟩ he
  have h₁ := congrArg (fun t : Pin G L T s i J => t.val.1) he
  have h₂ := congrArg (fun t : Pin G L T s i J => t.val.2) he
  have hp : p=q := congrArg Sigma.fst h₁
  subst q
  have he₁ : (a,b,c)=(d,f,e) := eq_of_heq (Sigma.mk.inj h₁).2
  have he₂ : (a',b',c')=(d',f',e') := eq_of_heq (Sigma.mk.inj h₂).2
  rcases Prod.mk.inj he₁ with ⟨rfl,h⟩
  rcases Prod.mk.inj h with ⟨rfl,rfl⟩
  rcases Prod.mk.inj he₂ with ⟨rfl,h'⟩
  rcases Prod.mk.inj h' with ⟨rfl,rfl⟩
  rfl

/-- The common center and all three vertices of the selected channel remain pinned. -/
def traceMark (p : Full G L s) : W × (W × W × W) :=
  (p.2.1,sideChoice G L s i p.2.2.2.1)

abbrev TracePin (J : Finset (Roots (W := W) s)) :=
  {p : RootFiberPruning.MaskedAgreement (Fiber G L s) J //
    traceMark G L s i ⟨p.val.1.1.val,p.val.1.2⟩=
      traceMark G L s i ⟨p.val.2.1.val,p.val.2.2⟩}

def profileToTrace {J : Finset (Roots (W := W) s)} (p : ProfilePinned G L T s i J) : TracePin G L s i J :=
  ⟨pinToAgreement G L T s i (profileToPin G L T s i p),Prod.ext rfl p.2.2.property⟩

lemma profileToTrace_injective {J : Finset (Roots (W := W) s)} :
    Function.Injective (profileToTrace G L T s i (J := J)) := by
  intro p q he
  apply profileToPin_injective G L T s i
  apply pinToAgreement_injective G L T s i
  exact congrArg Subtype.val he

/-- This is a smaller target than total agreement: four interior roles coincide. -/
theorem profileMassMoment_le_tracePin (J : Finset (Roots (W := W) s)) :
    profileMassMoment G L T s i J ≤ (Nat.card (TracePin G L s i J):ℝ) := by
  classical
  rw [←profile_pinned_card]
  exact_mod_cast Nat.card_le_card_of_injective _ (profileToTrace_injective G L T s i)

end Erdos571.ThreeHubChannelSides

/- Retaining the multiple pin in the channel-profile recurrence. The numerical
coefficient is unchanged; this is not a sharp upper-bound theorem. -/
namespace Erdos571.ThreeHubChannelSides
open Finset SimpleGraph ThreeHubAssignments
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℕ) (T : ℝ) (s : ℕ) (i : Fin s)

theorem profileMoment_le_tracePin (J : Finset (Roots (W := W) s)) (D : ℝ)
    (hD : 0≤D) (hdeg : ∀ x, (G.degree x:ℝ)≤D) (hT : 0≤T) :
    profileMoment G L T s i J ≤ (((L:ℝ)*D^2)^(s-1)*T)*
      (Nat.card (TracePin G L s i J):ℝ) :=
  (profileMoment_le_mass G L T s i J D hD hdeg).trans
    (mul_le_mul_of_nonneg_left (profileMassMoment_le_tracePin G L T s i J) (by positivity))

lemma tracePin_le_allAgreement (J : Finset (Roots (W := W) s)) :
    Nat.card (TracePin G L s i J) ≤ Nat.card (RootFiberPruning.MaskedAgreement (Fiber G L s) J) :=
  Nat.card_le_card_of_injective Subtype.val Subtype.val_injective

end Erdos571.ThreeHubChannelSides

namespace Erdos571.ThreeHub
open Finset SimpleGraph ThreeHubChannelSides

/-- The profile cost is now charged to four simultaneous pins, on exactly the
retained root mask. No sharp scalar bound for that subfamily is claimed. -/
theorem drc_retained_central_pin_vs_trace (s M L : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0≤Q) :
    ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (FullRootedPower.graph (template s) M).Free G → G.IsBipartite →
      ∀ d : ℝ, 0<d → (∀ x, (G.degree x:ℝ)≤Q*d) →
      ∀ (hs' : 1≤s) (i : Fin s) (κ : ℝ),
        (Nat.card (ThreeHubRootPruning.Pin G L s hs' (Q*d) κ (.inl 1)):ℝ)^2 ≤
          (((Q*d)^3*(C*d^(2-2/((s:ℝ)+1))))*outerMass G L s*
            (((L:ℝ)*(Q*d)^2)^(s-1)*((L:ℝ)*(Q*d))))*
              (Nat.card (TracePin G L s i (ThreeHubRootPruning.mask G L s hs' (Q*d) κ)):ℝ) := by
  obtain ⟨C,hC,h⟩ := drc_retained_central_pin_interpolation s M L hs Q hQ
  refine ⟨C,hC,?_⟩
  intro W _ _ G _ hf hbi d hd hdeg hs' i κ
  have hD : 0≤Q*d := mul_nonneg hQ hd.le
  have hp := profileMoment_le_tracePin G L ((L:ℝ)*(Q*d)) s i
    (ThreeHubRootPruning.mask G L s hs' (Q*d) κ) (Q*d) hD hdeg
    (mul_nonneg (Nat.cast_nonneg _) hD)
  have hcoef : 0≤((Q*d)^3*(C*d^(2-2/((s:ℝ)+1))))*outerMass G L s :=
    mul_nonneg (mul_nonneg (pow_nonneg hD _) (mul_nonneg hC (Real.rpow_nonneg hd.le _)))
      (outerMass_nonneg G L s)
  exact (h W G hf hbi d hd hdeg hs' i κ).trans
    ((mul_le_mul_of_nonneg_left hp hcoef).trans_eq (by ring))

end Erdos571.ThreeHub


/-! A signed quadratic estimate for a forbidden-graph-free adjacency matrix. -/
set_option maxHeartbeats 2500000
namespace Erdos571.HereditaryGraphSpectral
open Finset SimpleGraph ProjectionHeavy DensityRegularization
variable {V W : Type} [Fintype W] [DecidableEq W]

lemma adj_nonneg (G : SimpleGraph W) [DecidableRel G.Adj] (u v : W) :
    0 ≤ G.adjMatrix ℝ u v := by
  simp only [SimpleGraph.adjMatrix_apply]
  split_ifs <;> norm_num

lemma sum_adj_eq_arcs (G : SimpleGraph W) [DecidableRel G.Adj] (S : Finset W) :
    (∑ u∈S, ∑ v∈S, G.adjMatrix ℝ u v) = (arcs G S).card := by
  simp only [arcs,card_filter,Nat.cast_sum,Nat.cast_ite,Nat.cast_one,Nat.cast_zero,
    sum_product,SimpleGraph.adjMatrix_apply]

lemma local_mass (H : SimpleGraph V) {α C : ℝ} (hα : 0≤α) (hC : 0≤C)
    (hbound : EdgeBound H α C) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : H.Free G) (S T : Finset W) :
    (∑ u∈S, ∑ v∈T, G.adjMatrix ℝ u v) ≤ 2*C*((S.card:ℝ)+T.card)^α := by
  classical
  have hb := hbound.estimate (G.induce (↑(S∪T) : Set W))
    (fun h => hf (h.trans ⟨Copy.induce G _⟩))
  have hc : Fintype.card (↑(S∪T) : Set W) = (S∪T).card := by
    exact Fintype.card_of_finset' (p := (↑(S∪T) : Set W)) (S∪T) (fun _ => Iff.rfl)
  rw [hc] at hb
  have he : ((arcs G (S∪T)).card:ℝ) ≤ 2*C*((S∪T).card:ℝ)^α := by
    rw [arcs_card,Nat.cast_mul,Nat.cast_ofNat]
    nlinarith
  have hs : (S∪T).card ≤ S.card+T.card := card_union_le S T
  calc
    _ ≤ ∑ u∈S, ∑ v∈S∪T, G.adjMatrix ℝ u v := by
      apply sum_le_sum
      intro u hu
      exact sum_le_sum_of_subset_of_nonneg subset_union_right (fun v _ _ => adj_nonneg G u v)
    _ ≤ ∑ u∈S∪T, ∑ v∈S∪T, G.adjMatrix ℝ u v :=
      sum_le_sum_of_subset_of_nonneg subset_union_left (fun u _ _ =>
        sum_nonneg (fun v _ => adj_nonneg G u v))
    _ = (arcs G (S∪T)).card := sum_adj_eq_arcs G (S∪T)
    _ ≤ 2*C*((S∪T).card:ℝ)^α := he
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hs) hα) (by positivity)

noncomputable def coefficient (α C : ℝ) : ℝ :=
  HereditarySpectralExact.coefficient (α-1) * (2^α*(2*C))

lemma coefficient_nonneg {α C : ℝ} (hα : 3/2<α) (hC : 0≤C) :
    0≤coefficient α C := by
  exact mul_nonneg (HereditarySpectralExact.coefficient_nonneg (by linarith)) (by positivity)

/-- This estimate holds for signed weights; no positivity of the adjacency
quadratic form is assumed. -/
theorem quadratic_bound (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : H.Free G) (hWD : (Fintype.card W:ℝ)≤D) (f : W → ℝ) :
    |∑ u, ∑ v, G.adjMatrix ℝ u v*f u*f v| ≤
      coefficient α C * D^(α-1) * ∑ u, (f u)^2 := by
  classical
  have ho := HereditarySpectralExact.operator_of_local (G.adjMatrix ℝ)
    hα hα2 (show 0≤2*C by positivity) hWD hWD (adj_nonneg G)
    (local_mass H (by linarith) hC hbound G hf) f
  have hp : D^(2*α-2)=(D^(α-1))^2 := by
    rw [←Real.rpow_mul_natCast hD.le]
    congr 1
    ring
  rw [hp] at ho
  let F : ℝ := ∑ u, (f u)^2
  let R : ℝ := coefficient α C * D^(α-1)
  have hF : 0≤F := sum_nonneg (fun _ _ => sq_nonneg _)
  have hR : 0≤R := mul_nonneg (coefficient_nonneg hα hC) (Real.rpow_nonneg hD.le _)
  have ho' : (∑ u, (∑ v, G.adjMatrix ℝ u v*f v)^2) ≤ R^2*F := by
    convert ho using 1
    dsimp [R,coefficient,F]
    ring
  have hcs := sum_mul_sq_le_sq_mul_sq univ f (fun u => ∑ v, G.adjMatrix ℝ u v*f v)
  have he : (∑ u, f u*(∑ v, G.adjMatrix ℝ u v*f v)) =
      ∑ u, ∑ v, G.adjMatrix ℝ u v*f u*f v := by
    simp only [mul_sum]
    exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by ring))
  rw [he] at hcs
  have hsq : (∑ u, ∑ v, G.adjMatrix ℝ u v*f u*f v)^2 ≤ (R*F)^2 := by
    calc
      _ ≤ F*(∑ u, (∑ v, G.adjMatrix ℝ u v*f v)^2) := hcs
      _ ≤ F*(R^2*F) := mul_le_mul_of_nonneg_left ho' hF
      _ = _ := by ring
  apply (sq_le_sq₀ (abs_nonneg _) (mul_nonneg hR hF)).mp
  simpa only [sq_abs] using hsq

end Erdos571.HereditaryGraphSpectral


/-! Local hereditary sparsity gives a signed operator bound for a masked Gram matrix. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HeavyGramSpectral
open Finset SimpleGraph ProjectionHeavy Matrix
variable {V W : Type} [Fintype W] [DecidableEq W]
variable (G K : SimpleGraph W) [DecidableRel G.Adj] [DecidableRel K.Adj]

noncomputable def masked : Matrix W W ℝ := fun u v =>
  K.adjMatrix ℝ u v * (G.adjMatrix ℝ * G.adjMatrix ℝ) u v

def localForm (f : W → ℝ) (x : W) : ℝ :=
  ∑ u, ∑ v, K.adjMatrix ℝ u v * (G.adjMatrix ℝ x u*f u) * (G.adjMatrix ℝ x v*f v)

lemma quadratic_eq_sum_local (f : W → ℝ) :
    (∑ u, ∑ v, masked G K u v*f u*f v) = ∑ x, localForm G K f x := by
  classical
  unfold masked localForm
  simp only [Matrix.mul_apply,mul_sum,sum_mul]
  calc
    _ = ∑ u, ∑ v, ∑ x, K.adjMatrix ℝ u v *
        (G.adjMatrix ℝ x u*f u) * (G.adjMatrix ℝ x v*f v) := by
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      apply sum_congr rfl
      intro x _
      rw [G.isSymm_adjMatrix.apply u x]
      ring
    _ = ∑ u, ∑ x, ∑ v, K.adjMatrix ℝ u v *
        (G.adjMatrix ℝ x u*f u) * (G.adjMatrix ℝ x v*f v) :=
      sum_congr rfl (fun u _ => sum_comm)
    _ = _ := sum_comm

lemma local_eq_neighbors (f : W → ℝ) (x : W) :
    localForm G K f x =
      ∑ u∈G.neighborFinset x, ∑ v∈G.neighborFinset x, K.adjMatrix ℝ u v*f u*f v := by
  classical
  have hn : G.neighborFinset x = univ.filter (G.Adj x) := by ext u; simp
  simp only [localForm,hn,sum_filter,SimpleGraph.adjMatrix_apply]
  apply sum_congr rfl
  intro u _
  by_cases hu : G.Adj x u
  · simp only [hu,ite_true,one_mul]
    apply sum_congr rfl
    intro v _
    by_cases hv : G.Adj x v <;> simp [hv]
  · simp [hu]

lemma local_bound (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : H.Free K)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f : W → ℝ) (x : W) :
    |localForm G K f x| ≤ HereditaryGraphSpectral.coefficient α C * D^(α-1) *
      ∑ u∈G.neighborFinset x, (f u)^2 := by
  classical
  let S := G.neighborFinset x
  have hc : (Fintype.card S:ℝ)≤D := by
    simpa only [Fintype.card_coe,SimpleGraph.card_neighborFinset_eq_degree] using hdeg x
  have h := HereditaryGraphSpectral.quadratic_bound H hα hα2 hC hD hbound
    (K.induce (S:Set W)) (fun h => hf (h.trans ⟨Copy.induce K _⟩)) hc (fun u => f u.val)
  change |∑ u : (S:Set W), ∑ v : (S:Set W), K.adjMatrix ℝ u.val v.val*f u.val*f v.val| ≤
    HereditaryGraphSpectral.coefficient α C * D^(α-1) * ∑ u : (S:Set W), (f u.val)^2 at h
  have hi (u : W) : (∑ v : (S:Set W), K.adjMatrix ℝ u v.val*f u*f v.val) =
      ∑ v∈S, K.adjMatrix ℝ u v*f u*f v :=
    (sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl) (fun v => K.adjMatrix ℝ u v*f u*f v)).symm
  simp_rw [hi] at h
  rw [←sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl) (fun u => ∑ v∈S, K.adjMatrix ℝ u v*f u*f v),
    ←sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl) (fun u => (f u)^2)] at h
  simpa only [local_eq_neighbors,S] using h

lemma sum_neighbor_weight (w : W → ℝ) :
    (∑ x, ∑ u∈G.neighborFinset x, w u) = ∑ u, (G.degree u:ℝ)*w u := by
  classical
  have hn (x : W) : G.neighborFinset x=univ.filter (G.Adj x) := by ext u; simp
  have he (u : W) : (∑ x, if G.Adj x u then w u else 0) = (G.degree u:ℝ)*w u := by
    simp_rw [G.adj_comm (v:=u)]
    rw [←sum_filter]
    rw [←hn u]
    simp only [sum_const,nsmul_eq_mul,SimpleGraph.card_neighborFinset_eq_degree]
  simp_rw [hn,sum_filter]
  rw [sum_comm]
  exact sum_congr rfl (fun u _ => he u)

/-- The shadow need only be H-free; the host itself is not assumed H-free.
This is an absolute bound for every signed quadratic form. -/
theorem quadratic_bound (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : H.Free K)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f : W → ℝ) :
    |∑ u, ∑ v, masked G K u v*f u*f v| ≤
      HereditaryGraphSpectral.coefficient α C * D^α * ∑ u, (f u)^2 := by
  classical
  have hA : 0≤HereditaryGraphSpectral.coefficient α C*D^(α-1) :=
    mul_nonneg (HereditaryGraphSpectral.coefficient_nonneg hα hC) (Real.rpow_nonneg hD.le _)
  calc
    _ = |∑ x, localForm G K f x| := congrArg abs (quadratic_eq_sum_local G K f)
    _ ≤ ∑ x, |localForm G K f x| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ x, HereditaryGraphSpectral.coefficient α C * D^(α-1) *
        ∑ u∈G.neighborFinset x, (f u)^2 :=
      sum_le_sum (fun x _ => local_bound G K H hα hα2 hC hD hbound hf hdeg f x)
    _ = HereditaryGraphSpectral.coefficient α C * D^(α-1) *
        ∑ u, (G.degree u:ℝ)*(f u)^2 := by
      rw [←mul_sum,sum_neighbor_weight]
    _ ≤ HereditaryGraphSpectral.coefficient α C * D^(α-1) *
        ∑ u, D*(f u)^2 := mul_le_mul_of_nonneg_left
      (sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hdeg u) (sq_nonneg _))) hA
    _ = _ := by
      rw [←mul_sum,←mul_assoc]
      have hp : D^(α-1)*D=D^α := by
        nth_rw 2 [←Real.rpow_one D]
        rw [←Real.rpow_add hD]
        congr 1
        ring
      rw [mul_assoc (HereditaryGraphSpectral.coefficient α C),hp]

end Erdos571.HeavyGramSpectral


/-! Polynomially small signed error for fixed light cutoffs under subdivision freeness. -/
set_option maxHeartbeats 3000000
namespace Erdos571.LightArmKernel
open Finset SimpleGraph ProjectionHeavy Matrix
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma shadow_adj_iff (L : ℕ) (u v : W) :
    (HostHeavyShadow.graph G univ (L+1)).Adj u v ↔
      u≠v ∧ (L:ℝ)<(G.adjMatrix ℝ * G.adjMatrix ℝ) u v := by
  rw [LayeredBush.adjacency_square_common_card,←HostHeavyShadow.common_univ_card]
  change (u≠v ∧ L+1≤(FourthMoment.common G univ u v).card) ↔ _
  constructor
  · rintro ⟨hne,h⟩
    refine ⟨hne,?_⟩
    exact_mod_cast (show L<(FourthMoment.common G univ u v).card by omega)
  · rintro ⟨hne,h⟩
    have h' : L<(FourthMoment.common G univ u v).card := by exact_mod_cast h
    exact ⟨hne,by omega⟩

lemma square_eq_trim_add_shadow (L : ℕ) (u v : W) :
    (G.adjMatrix ℝ * G.adjMatrix ℝ) u v = matrix G L u v +
      HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1)) u v +
      if u=v then (G.degree u:ℝ) else 0 := by
  classical
  rw [HeavyGramSpectral.masked,SimpleGraph.adjMatrix_apply]
  simp only [shadow_adj_iff]
  by_cases he : u=v
  · subst v
    simp only [ne_eq,not_true_eq_false,false_and,ite_false,zero_mul,
      matrix,trim_diag,zero_add,ite_true,SimpleGraph.adjMatrix_mul_self_apply_self]
  · by_cases hl : (G.adjMatrix ℝ * G.adjMatrix ℝ) u v≤L
    · simp only [matrix,trim,ne_eq,he,not_false_eq_true,hl,true_and,ite_true,not_lt.mpr hl,and_false,
        ite_false,zero_mul,add_zero]
    · simp only [matrix,trim,ne_eq,he,not_false_eq_true,hl,true_and,ite_false,lt_of_not_ge hl,ite_true,
        one_mul,zero_add,add_zero]

lemma square_form_decomposition (L : ℕ) (f : W → ℝ) :
    (∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*f u*f v) =
      (∑ u, ∑ v, matrix G L u v*f u*f v) +
      (∑ u, ∑ v, HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1)) u v*f u*f v) +
      ∑ u, (G.degree u:ℝ)*(f u)^2 := by
  classical
  simp_rw [square_eq_trim_add_shadow G L]
  simp only [add_mul,sum_add_distrib,ite_mul,zero_mul,sum_ite_eq,mem_univ,ite_true]
  congr 1
  exact sum_congr rfl (fun u _ => by ring)

/-- The cutoff is fixed. The error improves from a constant times D^2 to
D plus a constant times D^alpha, where alpha is the base graph's upper exponent. -/
theorem subdivision_quadratic_remainder (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f : W → ℝ) :
    |(∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*f u*f v)-
      (∑ u, ∑ v, matrix G L u v*f u*f v)| ≤
      (D+HereditaryGraphSpectral.coefficient α C*D^α)*∑ u, (f u)^2 := by
  classical
  have hfree : H.Free (HostHeavyShadow.graph G univ (L+1)) := by
    intro h
    exact HostHeavyShadow.free H G univ hf (h.trans
      ⟨SimpleGraph.Copy.ofLE _ _ (HostHeavyShadow.graph_antitone G _ _ hL)⟩)
  have hh := HeavyGramSpectral.quadratic_bound G (HostHeavyShadow.graph G univ (L+1))
    H hα hα2 hC hD hbound hfree hdeg f
  have hd : (∑ u, (G.degree u:ℝ)*(f u)^2) ≤ D*∑ u, (f u)^2 := by
    rw [mul_sum]
    exact sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hdeg u) (sq_nonneg _))
  rw [square_form_decomposition G L f]
  rw [add_assoc,add_sub_cancel_left]
  calc
    _ ≤ |∑ u, ∑ v, HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1)) u v*f u*f v| +
        |∑ u, (G.degree u:ℝ)*(f u)^2| := abs_add_le _ _
    _ = |∑ u, ∑ v, HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1)) u v*f u*f v| +
        ∑ u, (G.degree u:ℝ)*(f u)^2 := by
      rw [abs_of_nonneg (show 0≤∑ u, (G.degree u:ℝ)*(f u)^2 from
        sum_nonneg (fun u _ => mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _))) ]
    _ ≤ _ := by nlinarith

theorem subdivision_quadratic_lower (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f : W → ℝ) :
    -(D+HereditaryGraphSpectral.coefficient α C*D^α)*(∑ u, (f u)^2) ≤
      ∑ u, ∑ v, matrix G L u v*f u*f v := by
  have h := subdivision_quadratic_remainder G H hα hα2 hC hD hbound hf L hL hdeg f
  have hq := square_quadratic_nonneg G f
  have hh := le_abs_self ((∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*f u*f v)-
    (∑ u, ∑ v, matrix G L u v*f u*f v))
  linarith

end Erdos571.LightArmKernel


/-! A fixed-cutoff polynomial improvement to approximate positivity of three-hub arm kernels. -/
set_option maxHeartbeats 2500000
namespace Erdos571.LightArmKernel
open Finset SimpleGraph ProjectionHeavy
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma normalize_polynomial_error (α C Q d : ℝ) (hQ : 0<Q) (hd : 0<d) :
    (Q*d+C*(Q*d)^α)/d^2 = Q/d+C*Q^α*d^(α-2) := by
  rw [Real.mul_rpow hQ.le hd.le,Real.rpow_sub hd,Real.rpow_two]
  field_simp

theorem subdivision_normalized_quadratic_lower (H : SimpleGraph V) {α C Q d : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hQ : 0<Q) (hd : 0<d)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤Q*d) (f : W → ℝ) :
    -(Q/d+HereditaryGraphSpectral.coefficient α C*Q^α*d^(α-2))*(∑ u, (f u)^2) ≤
      ∑ u, ∑ v, (matrix G L u v/d^2)*f u*f v := by
  have h := subdivision_quadratic_lower G H hα hα2 hC (mul_pos hQ hd) hbound hf L hL hdeg f
  have he : (∑ u, ∑ v, (matrix G L u v/d^2)*f u*f v) =
      (∑ u, ∑ v, matrix G L u v*f u*f v)/d^2 := by
    simp only [div_mul_eq_mul_div,←sum_div]
  rw [he,←normalize_polynomial_error α (HereditaryGraphSpectral.coefficient α C) Q d hQ hd]
  apply (le_div_iff₀ (sq_pos_of_pos hd)).mpr
  convert h using 1 <;> field_simp <;> ring

end Erdos571.LightArmKernel

namespace Erdos571.ThreeHub
open Finset SimpleGraph ProjectionHeavy

/-- For all sufficiently large fixed cutoffs, the normalized light arm kernel
has signed quadratic error O(d^(-1/(s+1))) at the d^2 scale. This does not assert
that the light kernel itself is positive semidefinite. -/
theorem lightArm_polynomial_quadratic_lower (s M : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0<Q) :
    ∃ L₀ : ℕ, ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (graph s M).Free G → ∀ d : ℝ, 0<d →
      (∀ u, (G.degree u:ℝ)≤Q*d) → ∀ L : ℕ, L₀≤L → ∀ f : W → ℝ,
      -(Q/d+C*d^(-1/((s:ℝ)+1)))*(∑ u, (f u)^2) ≤
        ∑ u, ∑ v, (LightArmKernel.matrix G L u v/d^2)*f u*f v := by
  obtain ⟨B,hB,hbound⟩ := drc_base_edge_bound s (M+1) (by omega)
  let H := FullRootedPower.graph (base s) (M+1)
  let α : ℝ := 2-1/((s:ℝ)+1)
  let C := HereditaryGraphSpectral.coefficient α B*Q^α
  have hsR : (2:ℝ)≤s := by exact_mod_cast hs
  have hden : (0:ℝ)<s+1 := by positivity
  have hrec : 1/((s:ℝ)+1)<1/2 := (div_lt_iff₀ hden).mpr (by linarith)
  have hα : 3/2<α := by dsimp [α]; linarith
  have hα2 : α≤2 := by dsimp [α]; have := one_div_pos.mpr hden; linarith
  have hC : 0≤C := mul_nonneg (HereditaryGraphSpectral.coefficient_nonneg hα hB)
    (Real.rpow_nonneg hQ.le _)
  refine ⟨Fintype.card ((Fin (M+1)×Fin 3)⊕BaseRoot s)+Nat.card H.edgeSet,C,hC,?_⟩
  intro W _ _ G _ hf d hd hdeg L hL f
  have h := LightArmKernel.subdivision_normalized_quadratic_lower G H hα hα2 hB hQ hd
    hbound (subdivision_free s M G hf) L (by
      change Fintype.card ((Fin (M+1)×Fin 3)⊕BaseRoot s)+Nat.card H.edgeSet≤L+1
      omega) hdeg f
  have he : α-2=-1/((s:ℝ)+1) := by dsimp [α]; ring
  simpa only [C,he] using h

end Erdos571.ThreeHub


/-! Signed quadratic bounds give bilinear and profile-error bounds on an
arbitrary retained mask. The mask is not factored or enlarged. -/
set_option maxHeartbeats 2000000
namespace Erdos571.MaskedQuadraticPerturbation
open Finset Matrix
variable {U I : Type*} [Fintype U]

noncomputable def form (R : Matrix U U ℝ) (f g : U → ℝ) : ℝ :=
  ∑ u, ∑ v, R u v*f u*g v

lemma form_symm (R : Matrix U U ℝ) (hR : R.IsSymm) (f g : U → ℝ) :
    form R f g=form R g f := by
  unfold form
  rw [sum_comm]
  apply sum_congr rfl
  intro v _
  apply sum_congr rfl
  intro u _
  rw [hR.apply v u]
  ring

lemma form_add_left (R : Matrix U U ℝ) (f g h : U → ℝ) :
    form R (fun u => f u+g u) h=form R f h+form R g h := by
  simp only [form,mul_add,add_mul,sum_add_distrib]

lemma form_add_right (R : Matrix U U ℝ) (f g h : U → ℝ) :
    form R f (fun u => g u+h u)=form R f g+form R f h := by
  simp only [form,mul_add,sum_add_distrib]

lemma form_scale_left (R : Matrix U U ℝ) (f g : U → ℝ) (t : ℝ) :
    form R (fun u => t*f u) g=t*form R f g := by
  simp only [form,mul_sum]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  ring

lemma form_scale_right (R : Matrix U U ℝ) (f g : U → ℝ) (t : ℝ) :
    form R f (fun u => t*g u)=t*form R f g := by
  simp only [form,mul_sum]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  ring

lemma polarization (R : Matrix U U ℝ) (hR : R.IsSymm) (f g : U → ℝ) (t : ℝ) :
    form R (fun u => f u+t*g u) (fun u => f u+t*g u)-
      form R (fun u => f u+(-t)*g u) (fun u => f u+(-t)*g u)=4*t*form R f g := by
  simp only [form_add_left,form_add_right,form_scale_left,form_scale_right]
  rw [form_symm R hR g f]
  ring

lemma parallelogram (f g : U → ℝ) (t : ℝ) :
    (∑ u, (f u+t*g u)^2)+(∑ u, (f u+(-t)*g u)^2)=
      2*((∑ u, (f u)^2)+t^2*∑ u, (g u)^2) := by
  simp only [←sum_add_distrib,mul_sum]
  apply sum_congr rfl
  intro u _
  ring

/-- Polarization and a nonpositive discriminant give the exact squared
bilinear bound, without a dimension factor. -/
theorem bilinear_sq (R : Matrix U U ℝ) (hR : R.IsSymm) (B : ℝ)
    (hquad : ∀ f : U → ℝ, |form R f f|≤B*∑ u, (f u)^2) (f g : U → ℝ) :
    (form R f g)^2≤B^2*(∑ u, (f u)^2)*(∑ u, (g u)^2) := by
  have hp (t : ℝ) : 2*t*form R f g≤B*((∑ u, (f u)^2)+t^2*∑ u, (g u)^2) := by
    have hplus := (abs_le.mp (hquad (fun u => f u+t*g u))).2
    have hminus := (abs_le.mp (hquad (fun u => f u+(-t)*g u))).1
    have hpol := polarization R hR f g t
    have hpar := parallelogram f g t
    nlinarith [congrArg (fun x : ℝ => B*x) hpar]
  have hd := discrim_le_zero (a := B*∑ u, (g u)^2)
    (b := -2*form R f g) (c := B*∑ u, (f u)^2) (fun t => by
      have h := hp t
      nlinarith)
  unfold discrim at hd
  nlinarith

/-- A quadratic bound also controls the Euclidean norm of the error operator. -/
theorem operator_sq (R : Matrix U U ℝ) (hR : R.IsSymm) (B : ℝ)
    (hquad : ∀ f : U → ℝ, |form R f f|≤B*∑ u, (f u)^2) (f : U → ℝ) :
    (∑ u, (∑ v, R u v*f v)^2)≤B^2*∑ u, (f u)^2 := by
  let g : U → ℝ := fun u => ∑ v, R u v*f v
  have he : form R g f=∑ u, (g u)^2 := by
    unfold form
    apply sum_congr rfl
    intro u _
    calc
      _ = g u*∑ v, R u v*f v := by
        rw [mul_sum]
        exact sum_congr rfl (fun _ _ => by ring)
      _ = _ := by change g u*g u=(g u)^2; ring
  have h := bilinear_sq R hR B hquad g f
  rw [he] at h
  have hg : 0≤∑ u, (g u)^2 := sum_nonneg (fun _ _ => sq_nonneg _)
  change (∑ u, (g u)^2)≤_
  by_cases hz : (∑ u, (g u)^2)=0
  · rw [hz]
    exact mul_nonneg (sq_nonneg B) (sum_nonneg (fun _ _ => sq_nonneg _))
  · have hp : 0<∑ u, (g u)^2 := lt_of_le_of_ne hg (Ne.symm hz)
    by_contra hn
    have hl := sub_pos.mpr (lt_of_not_ge hn)
    nlinarith [mul_pos hp hl]

/-- The product profile on the right is summed over the original coupled
mask; no product-of-marginals relaxation is made. -/
theorem masked_error (R : Matrix U U ℝ) (hR : R.IsSymm) (B : ℝ)
    (hquad : ∀ f : U → ℝ, |form R f f|≤B*∑ u, (f u)^2)
    (J : Finset I) (f g : I → U → ℝ) :
    (∑ r∈J, (form R (f r) (g r))^2)≤
      B^2*∑ r∈J, (∑ u, (f r u)^2)*(∑ u, (g r u)^2) := by
  rw [mul_sum]
  exact sum_le_sum (fun r _ => by simpa only [mul_assoc] using bilinear_sq R hR B hquad (f r) (g r))

/-- Comparison of two masked energies, with an explicit profile error. -/
theorem masked_energy (P N : Matrix U U ℝ) (hs : (P-N).IsSymm) (B : ℝ)
    (hquad : ∀ f : U → ℝ, |form (P-N) f f|≤B*∑ u, (f u)^2)
    (J : Finset I) (f g : I → U → ℝ) :
    (∑ r∈J, (form P (f r) (g r))^2)≤
      2*(∑ r∈J, (form N (f r) (g r))^2)+
        2*B^2*∑ r∈J, (∑ u, (f r u)^2)*(∑ u, (g r u)^2) := by
  have he (r : I) : form (P-N) (f r) (g r)=form P (f r) (g r)-form N (f r) (g r) := by
    simp only [form,Matrix.sub_apply,sub_mul,sum_sub_distrib]
  have hb := masked_error (P-N) hs B hquad J f g
  have hstep (r : I) : (form P (f r) (g r))^2≤
      2*(form N (f r) (g r))^2+2*(form (P-N) (f r) (g r))^2 := by
    rw [he]
    nlinarith [sq_nonneg (form P (f r) (g r)-2*form N (f r) (g r))]
  have h := sum_le_sum (fun r (_ : r∈J) => hstep r)
  simp only [sum_add_distrib,←mul_sum] at h
  nlinarith

end Erdos571.MaskedQuadraticPerturbation



/-! Actual graph-free polynomial errors, usable with signed masked features. -/
set_option maxHeartbeats 2200000
namespace Erdos571.LightArmKernel
open Finset SimpleGraph Matrix ProjectionHeavy MaskedQuadraticPerturbation
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma remainder_isSymm (L : ℝ) :
    (G.adjMatrix ℝ * G.adjMatrix ℝ-matrix G L).IsSymm := by
  apply Matrix.IsSymm.sub _ (isSymm G L)
  show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ
  rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]

lemma remainder_form (L : ℝ) (f : W → ℝ) :
    form (G.adjMatrix ℝ * G.adjMatrix ℝ-matrix G L) f f=
      (∑ u, ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*f u*f v)-
      (∑ u, ∑ v, matrix G L u v*f u*f v) := by
  simp only [form,Matrix.sub_apply,sub_mul,sum_sub_distrib]

/-- In particular the error remains valid for an arbitrary set of coupled
root labels and arbitrary signed features. -/
theorem subdivision_masked_energy (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) {I : Type*}
    (J : Finset I) (f g : I → W → ℝ) :
    (∑ r∈J, (form (G.adjMatrix ℝ * G.adjMatrix ℝ) (f r) (g r))^2)≤
      2*(∑ r∈J, (form (matrix G L) (f r) (g r))^2)+
        2*(D+HereditaryGraphSpectral.coefficient α C*D^α)^2*
          ∑ r∈J, (∑ u, (f r u)^2)*(∑ u, (g r u)^2) := by
  apply masked_energy _ _ (remainder_isSymm G L)
  intro f
  rw [remainder_form]
  exact subdivision_quadratic_remainder G H hα hα2 hC hD hbound hf L hL hdeg f

end Erdos571.LightArmKernel

namespace Erdos571.ThreeHub
open Finset SimpleGraph Matrix ProjectionHeavy MaskedQuadraticPerturbation

/-- The polynomial estimate in its two-sided form, at the unnormalized
operator scale. This does not assert positive semidefiniteness of the trim. -/
theorem lightArm_polynomial_remainder (s M : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0<Q) :
    ∃ L₀ : ℕ, ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (graph s M).Free G → ∀ d : ℝ, 0<d →
      (∀ u, (G.degree u:ℝ)≤Q*d) → ∀ L : ℕ, L₀≤L → ∀ f : W → ℝ,
      |form (G.adjMatrix ℝ * G.adjMatrix ℝ-LightArmKernel.matrix G L) f f|≤
        (d^2*(Q/d+C*d^(-1/((s:ℝ)+1))))*(∑ u, (f u)^2) := by
  obtain ⟨B,hB,hbound⟩ := drc_base_edge_bound s (M+1) (by omega)
  let H := FullRootedPower.graph (base s) (M+1)
  let α : ℝ := 2-1/((s:ℝ)+1)
  let C := HereditaryGraphSpectral.coefficient α B*Q^α
  have hsR : (2:ℝ)≤s := by exact_mod_cast hs
  have hden : (0:ℝ)<s+1 := by positivity
  have hrec : 1/((s:ℝ)+1)<1/2 := (div_lt_iff₀ hden).mpr (by linarith)
  have hα : 3/2<α := by dsimp [α]; linarith
  have hα2 : α≤2 := by dsimp [α]; have := one_div_pos.mpr hden; linarith
  have hC : 0≤C := mul_nonneg (HereditaryGraphSpectral.coefficient_nonneg hα hB)
    (Real.rpow_nonneg hQ.le _)
  refine ⟨Fintype.card ((Fin (M+1)×Fin 3)⊕BaseRoot s)+Nat.card H.edgeSet,C,hC,?_⟩
  intro W _ _ G _ hf d hd hdeg L hL f
  rw [LightArmKernel.remainder_form]
  have h := LightArmKernel.subdivision_quadratic_remainder G H hα hα2 hB (mul_pos hQ hd)
    hbound (subdivision_free s M G hf) L (by
      change Fintype.card ((Fin (M+1)×Fin 3)⊕BaseRoot s)+Nat.card H.edgeSet≤L+1
      omega) hdeg f
  have he : α-2=-1/((s:ℝ)+1) := by dsimp [α]; ring
  have hn := LightArmKernel.normalize_polynomial_error α (HereditaryGraphSpectral.coefficient α B) Q d hQ hd
  rw [he] at hn
  change (Q*d+HereditaryGraphSpectral.coefficient α B*(Q*d)^α)/d^2=
    Q/d+C*d^(-1/((s:ℝ)+1)) at hn
  rw [←hn]
  convert h using 1 <;> field_simp <;> ring

end Erdos571.ThreeHub



/-! A full-to-light core comparison for the actual three-hub assignment
fibers, with the same arbitrary coupled root mask and an explicit profile error. -/
set_option maxHeartbeats 2200000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix MaskedQuadraticPerturbation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ)

/-- Only the left core is changed. The right core remains the full two-walk. -/
abbrev LightCoreSide (x : W) (r : Labels (W := W) s) :=
  (u : W) × (MaskedBush.Arm G L x u × Bundle G L s u r)
abbrev OneLightCoreFiber (r : Roots (W := W) s) :=
  (x : W) × (Bundle G L s x r.1 ×
    (LightCoreSide G L s x r.2.1 × Side G L s x r.2.2))

noncomputable instance lightCoreSideFintype (x : W) (r : Labels (W := W) s) :
    Fintype (LightCoreSide G L s x r) := by
  classical
  infer_instance
noncomputable instance oneLightCoreFiberFintype (r : Roots (W := W) s) :
    Fintype (OneLightCoreFiber G L s r) := by
  classical
  infer_instance

lemma card_lightCoreSide (x : W) (r : Labels (W := W) s) :
    (Fintype.card (LightCoreSide G L s x r):ℝ)=
      ∑ u, LightArmKernel.matrix G L x u*armFeature G L s u r := by
  classical
  rw [Fintype.card_sigma,Nat.cast_sum]
  apply sum_congr rfl
  intro u _
  rw [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_arm,MaskedBush.card_bundle]
  rfl

noncomputable def outerCoreWeight (r : Roots (W := W) s) (u : W) : ℝ :=
  armFeature G L s u r.1*sideFeature G L s u r.2.2
noncomputable def innerCoreWeight (r : Roots (W := W) s) (u : W) : ℝ :=
  armFeature G L s u r.2.1

/-- This profile still sums over J itself, not over separate projections of J. -/
noncomputable def coreReplacementProfile (J : Finset (Roots (W := W) s)) : ℝ :=
  ∑ r∈J, (∑ u, (outerCoreWeight G L s r u)^2)*
    (∑ u, (innerCoreWeight G L s r u)^2)

lemma fiber_as_core_form (r : Roots (W := W) s) :
    (Nat.card (Fiber G L s r):ℝ)=form (G.adjMatrix ℝ * G.adjMatrix ℝ)
      (outerCoreWeight G L s r) (innerCoreWeight G L s r) := by
  classical
  rw [Nat.card_eq_fintype_card,card_fiber]
  have hside (u : W) : sideFeature G L s u r.2.1=
      ∑ v, (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*armFeature G L s v r.2.1 := by
    rw [sideFeature,Matrix.mul_apply]
  simp only [form,outerCoreWeight,innerCoreWeight,hside,mul_sum,sum_mul]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  ring

lemma light_fiber_as_core_form (r : Roots (W := W) s) :
    (Nat.card (OneLightCoreFiber G L s r):ℝ)=form (LightArmKernel.matrix G L)
      (outerCoreWeight G L s r) (innerCoreWeight G L s r) := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  unfold form
  apply sum_congr rfl
  intro u _
  rw [Fintype.card_prod,Nat.cast_mul,Fintype.card_prod,Nat.cast_mul]
  rw [card_lightCoreSide,card_side,MaskedBush.card_bundle]
  simp only [outerCoreWeight,innerCoreWeight,mul_sum,sum_mul,armFeature]
  apply sum_congr rfl
  intro v _
  ring

/-- Exact masked squared loss from trimming this one core. -/
theorem core_replacement_error (B : ℝ)
    (hq : ∀ f : W → ℝ,
      |form (G.adjMatrix ℝ * G.adjMatrix ℝ-LightArmKernel.matrix G L) f f|≤B*∑ u, (f u)^2)
    (J : Finset (Roots (W := W) s)) :
    (∑ r∈J, ((Nat.card (Fiber G L s r):ℝ)-Nat.card (OneLightCoreFiber G L s r))^2)≤
      B^2*coreReplacementProfile G L s J := by
  have h := masked_error _ (LightArmKernel.remainder_isSymm G L) B hq J
    (outerCoreWeight G L s) (innerCoreWeight G L s)
  simp only [fiber_as_core_form,light_fiber_as_core_form,coreReplacementProfile]
  convert h using 1
  simp only [form,Matrix.sub_apply,sub_mul,sum_sub_distrib]

/-- This is an energy comparison with an error, not a pin estimate or
an extremal upper bound. No root mask is discarded. -/
theorem core_replacement_energy (B : ℝ)
    (hq : ∀ f : W → ℝ,
      |form (G.adjMatrix ℝ * G.adjMatrix ℝ-LightArmKernel.matrix G L) f f|≤B*∑ u, (f u)^2)
    (J : Finset (Roots (W := W) s)) :
    (∑ r∈J, (Nat.card (Fiber G L s r):ℝ)^2)≤
      2*(∑ r∈J, (Nat.card (OneLightCoreFiber G L s r):ℝ)^2)+
        2*B^2*coreReplacementProfile G L s J := by
  simpa only [fiber_as_core_form,light_fiber_as_core_form,coreReplacementProfile] using
    masked_energy _ _ (LightArmKernel.remainder_isSymm G L) B hq J
      (outerCoreWeight G L s) (innerCoreWeight G L s)

end Erdos571.ThreeHubAssignments

namespace Erdos571.ThreeHub
open Finset SimpleGraph ThreeHubAssignments

/-- Actual ThreeHub freeness supplies a polynomial coefficient in the same-mask
core replacement comparison. The profile on the right still needs control. -/
theorem masked_core_replacement (s M : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0<Q) :
    ∃ L₀ : ℕ, ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (graph s M).Free G → ∀ d : ℝ, 0<d →
      (∀ u, (G.degree u:ℝ)≤Q*d) → ∀ L : ℕ, L₀≤L →
      ∀ J : Finset (Roots (W := W) s),
      (∑ r∈J, (Nat.card (Fiber G L s r):ℝ)^2)≤
        2*(∑ r∈J, (Nat.card (OneLightCoreFiber G L s r):ℝ)^2)+
          2*d^4*(Q/d+C*d^(-1/((s:ℝ)+1)))^2*coreReplacementProfile G L s J := by
  obtain ⟨L₀,C,hC,h⟩ := lightArm_polynomial_remainder s M hs Q hQ
  refine ⟨L₀,C,hC,?_⟩
  intro W _ _ G _ hf d hd hdeg L hL J
  have hb := core_replacement_energy G L s _ (h W G hf d hd hdeg L hL) J
  convert hb using 1 <;> ring

end Erdos571.ThreeHub


/-! Localizing the hereditary spectral bound before Cauchy retains an
actual common core middle in the resulting squared-error profile. -/
set_option maxHeartbeats 2600000
namespace Erdos571.HeavyGramSpectral
open Finset SimpleGraph Matrix ProjectionHeavy MaskedQuadraticPerturbation
variable {V W : Type} [Fintype W] [DecidableEq W]
variable (G K : SimpleGraph W) [DecidableRel G.Adj] [DecidableRel K.Adj]

noncomputable def localBilinear (f g : W → ℝ) (x : W) : ℝ :=
  ∑ u, ∑ v, K.adjMatrix ℝ u v*(G.adjMatrix ℝ x u*f u)*(G.adjMatrix ℝ x v*g v)

lemma bilinear_eq_sum_local (f g : W → ℝ) :
    form (masked G K) f g=∑ x, localBilinear G K f g x := by
  unfold form masked localBilinear
  simp only [Matrix.mul_apply,mul_sum,sum_mul]
  calc
    _ = ∑ u, ∑ v, ∑ x, K.adjMatrix ℝ u v*
        (G.adjMatrix ℝ x u*f u)*(G.adjMatrix ℝ x v*g v) := by
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      apply sum_congr rfl
      intro x _
      rw [G.isSymm_adjMatrix.apply u x]
      ring
    _ = ∑ u, ∑ x, ∑ v, K.adjMatrix ℝ u v*
        (G.adjMatrix ℝ x u*f u)*(G.adjMatrix ℝ x v*g v) :=
      sum_congr rfl (fun _ _ => sum_comm)
    _ = _ := sum_comm

lemma local_bilinear_eq_neighbors (f g : W → ℝ) (x : W) :
    localBilinear G K f g x=
      ∑ u∈G.neighborFinset x, ∑ v∈G.neighborFinset x, K.adjMatrix ℝ u v*f u*g v := by
  classical
  have hn : G.neighborFinset x=univ.filter (G.Adj x) := by ext u; simp
  simp only [localBilinear,hn,sum_filter,SimpleGraph.adjMatrix_apply]
  apply sum_congr rfl
  intro u _
  by_cases hu : G.Adj x u
  · simp only [hu,ite_true,one_mul]
    apply sum_congr rfl
    intro v _
    by_cases hv : G.Adj x v <;> simp [hv]
  · simp [hu]

lemma local_bilinear_sq_bound (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : H.Free K)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f g : W → ℝ) (x : W) :
    (localBilinear G K f g x)^2≤(HereditaryGraphSpectral.coefficient α C*D^(α-1))^2*
      (∑ u∈G.neighborFinset x, (f u)^2)*(∑ v∈G.neighborFinset x, (g v)^2) := by
  classical
  let S := G.neighborFinset x
  let K' := K.induce (S:Set W)
  have hc : (Fintype.card (S:Set W):ℝ)≤D := by
    change (Fintype.card S:ℝ)≤D
    simpa only [Fintype.card_coe,card_neighborFinset_eq_degree] using hdeg x
  have hq (a : ↥(S:Set W) → ℝ) : |form (K'.adjMatrix ℝ) a a|≤
      (HereditaryGraphSpectral.coefficient α C*D^(α-1))*∑ u, (a u)^2 :=
    HereditaryGraphSpectral.quadratic_bound H hα hα2 hC hD hbound K'
      (fun h => hf (h.trans ⟨Copy.induce K _⟩)) hc a
  have h := bilinear_sq (K'.adjMatrix ℝ) K'.isSymm_adjMatrix _ hq
    (fun u => f u.val) (fun u => g u.val)
  change (∑ u : (S:Set W), ∑ v : (S:Set W), K.adjMatrix ℝ u.val v.val*f u.val*g v.val)^2≤
    (HereditaryGraphSpectral.coefficient α C*D^(α-1))^2*
      (∑ u : (S:Set W), (f u.val)^2)*(∑ v : (S:Set W), (g v.val)^2) at h
  have hi (u : W) : (∑ v : (S:Set W), K.adjMatrix ℝ u v.val*f u*g v.val)=
      ∑ v∈S, K.adjMatrix ℝ u v*f u*g v :=
    (sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl)
      (fun v => K.adjMatrix ℝ u v*f u*g v)).symm
  simp_rw [hi] at h
  rw [←sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl)
      (fun u => ∑ v∈S, K.adjMatrix ℝ u v*f u*g v),
    ←sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl) (fun u => (f u)^2),
    ←sum_subtype (p := fun u : W => u∈(S:Set W)) S (fun _ => Iff.rfl) (fun u => (g u)^2)] at h
  simpa only [local_bilinear_eq_neighbors,S] using h

lemma neighbor_sum_eq_adj (f : W → ℝ) (x : W) :
    (∑ u∈G.neighborFinset x, f u)=∑ u, G.adjMatrix ℝ x u*f u := by
  classical
  have hn : G.neighborFinset x=univ.filter (G.Adj x) := by ext u; simp
  simp only [hn,sum_filter,SimpleGraph.adjMatrix_apply,ite_mul,one_mul,zero_mul]

lemma neighbor_product_eq_form (f g : W → ℝ) :
    (∑ x, (∑ u∈G.neighborFinset x, f u)*(∑ v∈G.neighborFinset x, g v))=
      form (G.adjMatrix ℝ * G.adjMatrix ℝ) f g := by
  simp only [neighbor_sum_eq_adj,form,Matrix.mul_apply,sum_mul,mul_sum]
  symm
  calc
    _ = ∑ u, ∑ v, ∑ x, (G.adjMatrix ℝ x u*f u)*(G.adjMatrix ℝ x v*g v) := by
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      apply sum_congr rfl
      intro x _
      rw [G.isSymm_adjMatrix.apply u x]
      ring
    _ = ∑ u, ∑ x, ∑ v, (G.adjMatrix ℝ x u*f u)*(G.adjMatrix ℝ x v*g v) :=
      sum_congr rfl (fun _ _ => sum_comm)
    _ = _ := by
      rw [sum_comm]
      exact sum_congr rfl (fun _ _ => sum_comm)

/-- The weighted profile retains a genuine shared core middle. Both vectors
may be signed. No positive-semidefinite assertion about the heavy mask is used. -/
theorem bilinear_sq_pinned (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : H.Free K)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f g : W → ℝ) :
    (form (masked G K) f g)^2≤(Fintype.card W:ℝ)*
      (HereditaryGraphSpectral.coefficient α C*D^(α-1))^2*
        form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f u)^2) (fun u => (g u)^2) := by
  rw [bilinear_eq_sum_local]
  have hcs := sq_sum_le_card_mul_sum_sq (s := (univ : Finset W)) (f := localBilinear G K f g)
  simp only [card_univ] at hcs
  have hb := sum_le_sum (fun x (_ : x∈univ) =>
    local_bilinear_sq_bound G K H hα hα2 hC hD hbound hf hdeg f g x)
  have he : (∑ x, (HereditaryGraphSpectral.coefficient α C*D^(α-1))^2*
      (∑ u∈G.neighborFinset x, (f u)^2)*(∑ v∈G.neighborFinset x, (g v)^2))=
      (HereditaryGraphSpectral.coefficient α C*D^(α-1))^2*
        form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f u)^2) (fun u => (g u)^2) := by
    simp only [mul_assoc,←mul_sum,neighbor_product_eq_form]
  rw [he] at hb
  exact hcs.trans ((mul_le_mul_of_nonneg_left hb (Nat.cast_nonneg _)).trans_eq (by ring))

end Erdos571.HeavyGramSpectral



/-! A polynomial trimming error charged to an actual pinned two-walk profile. -/
set_option maxHeartbeats 2400000
namespace Erdos571.LightArmKernel
open Finset SimpleGraph Matrix ProjectionHeavy MaskedQuadraticPerturbation
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma squared_profile_nonneg (f g : W → ℝ) :
    0≤form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f u)^2) (fun u => (g u)^2) :=
  sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
    mul_nonneg (mul_nonneg (square_nonneg G u v) (sq_nonneg _)) (sq_nonneg _)))

lemma diagonal_profile_le (f g : W → ℝ) :
    (∑ u, (G.degree u:ℝ)*(f u*g u)^2)≤
      form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f u)^2) (fun u => (g u)^2) := by
  unfold form
  apply sum_le_sum
  intro u _
  have h := single_le_sum (s := (univ : Finset W))
    (f := fun v => (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*(f u)^2*(g v)^2)
    (fun v _ => mul_nonneg (mul_nonneg (square_nonneg G u v) (sq_nonneg _)) (sq_nonneg _))
    (mem_univ u)
  dsimp only at h
  rw [G.adjMatrix_mul_self_apply_self] at h
  simpa only [mul_pow,mul_assoc] using h

lemma diagonal_bilinear_sq {D : ℝ} (hD : 0≤D)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f g : W → ℝ) :
    (∑ u, (G.degree u:ℝ)*f u*g u)^2≤(Fintype.card W:ℝ)*D*
      form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f u)^2) (fun u => (g u)^2) := by
  have hcs := ThreeHubKernel.weighted_sum_sq (fun u => (G.degree u:ℝ))
    (fun u => f u*g u) (fun u => Nat.cast_nonneg _)
  have hs : (∑ u, (G.degree u:ℝ))≤(Fintype.card W:ℝ)*D := by
    simpa only [sum_const,card_univ,nsmul_eq_mul] using sum_le_sum (fun u (_ : u∈univ) => hdeg u)
  have hp := diagonal_profile_le G f g
  have hn : 0≤∑ u, (G.degree u:ℝ)*(f u*g u)^2 :=
    sum_nonneg (fun u _ => mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _))
  simpa only [mul_assoc] using hcs.trans (mul_le_mul hs hp hn (mul_nonneg (Nat.cast_nonneg _) hD))

lemma remainder_bilinear (L : ℕ) (f g : W → ℝ) :
    form (G.adjMatrix ℝ * G.adjMatrix ℝ-matrix G L) f g=
      form (HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1))) f g+
        ∑ u, (G.degree u:ℝ)*f u*g u := by
  classical
  have he (u v : W) : (G.adjMatrix ℝ * G.adjMatrix ℝ-matrix G L) u v=
      HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1)) u v+
        if u=v then (G.degree u:ℝ) else 0 := by
    have h := square_eq_trim_add_shadow G L u v
    change (G.adjMatrix ℝ * G.adjMatrix ℝ) u v-matrix G L u v=_
    linarith
  simp only [form,he,add_mul,sum_add_distrib,ite_mul,zero_mul,sum_ite_eq,mem_univ,ite_true]

/-- The extra factor card(W) comes from summing local neighborhood forms.
In exchange, the right side keeps a common core middle rather than dropping
all core edges from the profile. -/
theorem subdivision_pinned_error (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (f g : W → ℝ) :
    (form (G.adjMatrix ℝ * G.adjMatrix ℝ-matrix G L) f g)^2≤
      2*(Fintype.card W:ℝ)*((HereditaryGraphSpectral.coefficient α C*D^(α-1))^2+D)*
        form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f u)^2) (fun u => (g u)^2) := by
  classical
  have hfree : H.Free (HostHeavyShadow.graph G univ (L+1)) := by
    intro h
    exact HostHeavyShadow.free H G univ hf (h.trans
      ⟨SimpleGraph.Copy.ofLE _ _ (HostHeavyShadow.graph_antitone G _ _ hL)⟩)
  have hh := HeavyGramSpectral.bilinear_sq_pinned G (HostHeavyShadow.graph G univ (L+1))
    H hα hα2 hC hD hbound hfree hdeg f g
  have hd := diagonal_bilinear_sq G hD.le hdeg f g
  rw [remainder_bilinear]
  nlinarith [sq_nonneg (form (HeavyGramSpectral.masked G (HostHeavyShadow.graph G univ (L+1))) f g-
    ∑ u, (G.degree u:ℝ)*f u*g u)]

/-- The original coupled root mask is unchanged. -/
theorem subdivision_masked_pinned_error (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) {I : Type*}
    (J : Finset I) (f g : I → W → ℝ) :
    (∑ r∈J, (form (G.adjMatrix ℝ * G.adjMatrix ℝ-matrix G L) (f r) (g r))^2)≤
      2*(Fintype.card W:ℝ)*((HereditaryGraphSpectral.coefficient α C*D^(α-1))^2+D)*
        ∑ r∈J, form (G.adjMatrix ℝ * G.adjMatrix ℝ) (fun u => (f r u)^2) (fun u => (g r u)^2) := by
  rw [mul_sum]
  exact sum_le_sum (fun r _ => subdivision_pinned_error G H hα hα2 hC hD hbound hf L hL hdeg (f r) (g r))

end Erdos571.LightArmKernel



/-! The two-walk-weighted core profile is an actual three-role pin family
on the same root mask, with no missing core-edge condition. -/
set_option maxHeartbeats 2600000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix MaskedQuadraticPerturbation
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (s : ℕ)

abbrev CoreOutside (r : Roots (W := W) s) (u : W) :=
  Bundle G L s u r.1 × Side G L s u r.2.2

/-- Two assignments share central hub u, left hub v, and a common middle x. -/
abbrev CorePinnedData (J : Finset (Roots (W := W) s)) :=
  (r : J) × (u : W) × (v : W) ×
    (G.commonNeighbors u v × ((CoreOutside G L s r.val u × CoreOutside G L s r.val u) ×
      (Bundle G L s v r.val.2.1 × Bundle G L s v r.val.2.1)))

noncomputable instance coreOutsideFintype (r : Roots (W := W) s) (u : W) :
    Fintype (CoreOutside G L s r u) := by
  classical
  infer_instance
noncomputable instance corePinnedDataFintype (J : Finset (Roots (W := W) s)) :
    Fintype (CorePinnedData G L s J) := by
  classical
  infer_instance

lemma coreOutside_card (r : Roots (W := W) s) (u : W) :
    (Fintype.card (CoreOutside G L s r u):ℝ)=outerCoreWeight G L s r u := by
  classical
  rw [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_side]
  rfl

/-- The profile contains P_uv, rather than the unsupported product of norms. -/
noncomputable def pinnedCoreProfile (J : Finset (Roots (W := W) s)) : ℝ :=
  ∑ r∈J, form (G.adjMatrix ℝ * G.adjMatrix ℝ)
    (fun u => (outerCoreWeight G L s r u)^2) (fun u => (innerCoreWeight G L s r u)^2)

lemma corePinnedData_card (J : Finset (Roots (W := W) s)) :
    (Nat.card (CorePinnedData G L s J):ℝ)=pinnedCoreProfile G L s J := by
  classical
  rw [Nat.card_eq_fintype_card]
  simp only [CorePinnedData,Fintype.card_sigma,Nat.cast_sum]
  have h (r : J) (u v : W) :
      (Fintype.card (G.commonNeighbors u v ×
        ((CoreOutside G L s r.val u × CoreOutside G L s r.val u) ×
          (Bundle G L s v r.val.2.1 × Bundle G L s v r.val.2.1))):ℝ)=
        (G.adjMatrix ℝ * G.adjMatrix ℝ) u v*
          (outerCoreWeight G L s r.val u)^2*(innerCoreWeight G L s r.val v)^2 := by
    rw [Fintype.card_prod,Nat.cast_mul,Fintype.card_prod,Nat.cast_mul]
    rw [Fintype.card_prod,Nat.cast_mul,coreOutside_card]
    rw [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle]
    rw [←LayeredBush.adjacency_square_common_card]
    simp only [innerCoreWeight,armFeature]
    ring
  simp_rw [h]
  exact sum_coe_sort J (fun r => form (G.adjMatrix ℝ * G.adjMatrix ℝ)
    (fun u => (outerCoreWeight G L s r u)^2) (fun u => (innerCoreWeight G L s r u)^2))

def coreTripleMark (p : Full G L s) : W × W × W :=
  (p.2.1,p.2.2.2.1.2.1.val,p.2.2.2.1.1)

abbrev CoreTriplePin (J : Finset (Roots (W := W) s)) :=
  {p : RootFiberPruning.MaskedAgreement (Fiber G L s) J //
    coreTripleMark G L s ⟨p.val.1.1.val,p.val.1.2⟩=
      coreTripleMark G L s ⟨p.val.2.1.val,p.val.2.2⟩}

def coreDataToPin {J : Finset (Roots (W := W) s)} (p : CorePinnedData G L s J) :
    CoreTriplePin G L s J :=
  ⟨⟨(⟨p.1,p.2.1,p.2.2.2.2.1.1.1,⟨p.2.2.1,p.2.2.2.1,p.2.2.2.2.2.1⟩,p.2.2.2.2.1.1.2⟩,
    ⟨p.1,p.2.1,p.2.2.2.2.1.2.1,⟨p.2.2.1,p.2.2.2.1,p.2.2.2.2.2.2⟩,p.2.2.2.2.1.2.2⟩),rfl⟩,rfl⟩

def corePinToData {J : Finset (Roots (W := W) s)} (p : CoreTriplePin G L s J) :
    CorePinnedData G L s J := by
  rcases p with ⟨⟨⟨⟨r,u,a,⟨v,x,b⟩,c⟩,⟨r',u',a',⟨v',x',b'⟩,c'⟩⟩,hr⟩,hm⟩
  change r=r' at hr
  subst r'
  change (u,x.val,v)=(u',x'.val,v') at hm
  have hu : u=u' := congrArg Prod.fst hm
  subst u'
  have hv : v=v' := congrArg (fun t : W × W × W => t.2.2) hm
  subst v'
  have hx : x=x' := Subtype.ext (congrArg (fun t : W × W × W => t.2.1) hm)
  subst x'
  exact ⟨r,u,v,x,⟨⟨a,c⟩,⟨a',c'⟩⟩,b,b'⟩

lemma corePinToData_toPin {J : Finset (Roots (W := W) s)} (p : CorePinnedData G L s J) :
    corePinToData G L s (coreDataToPin G L s p)=p := by
  rcases p with ⟨r,u,v,x,⟨⟨a,c⟩,⟨a',c'⟩⟩,b,b'⟩
  rfl

lemma coreDataToPin_toData {J : Finset (Roots (W := W) s)} (p : CoreTriplePin G L s J) :
    coreDataToPin G L s (corePinToData G L s p)=p := by
  rcases p with ⟨⟨⟨⟨r,u,a,⟨v,x,b⟩,c⟩,⟨r',u',a',⟨v',x',b'⟩,c'⟩⟩,hr⟩,hm⟩
  change r=r' at hr
  subst r'
  change (u,x.val,v)=(u',x'.val,v') at hm
  have hu : u=u' := congrArg Prod.fst hm
  subst u'
  have hv : v=v' := congrArg (fun t : W × W × W => t.2.2) hm
  subst v'
  have hx : x=x' := Subtype.ext (congrArg (fun t : W × W × W => t.2.1) hm)
  subst x'
  rfl

def corePinnedEquiv (J : Finset (Roots (W := W) s)) :
    CorePinnedData G L s J ≃ CoreTriplePin G L s J where
  toFun := coreDataToPin G L s
  invFun := corePinToData G L s
  left_inv := corePinToData_toPin G L s
  right_inv := coreDataToPin_toData G L s

/-- Exact equality with the original masked agreement restricted by three pins. -/
theorem coreTriplePin_card (J : Finset (Roots (W := W) s)) :
    (Nat.card (CoreTriplePin G L s J):ℝ)=pinnedCoreProfile G L s J := by
  rw [←Nat.card_congr (corePinnedEquiv G L s J)]
  exact corePinnedData_card G L s J

lemma coreDataToPin_injective {J : Finset (Roots (W := W) s)} :
    Function.Injective (coreDataToPin G L s (J := J)) :=
  Function.LeftInverse.injective (corePinToData_toPin G L s)

/-- This comparison does not restore global cross-light constraints; it does
retain all three specified roles and every root label in the original J. -/
theorem pinnedCoreProfile_le_pin (J : Finset (Roots (W := W) s)) :
    pinnedCoreProfile G L s J≤(Nat.card (CoreTriplePin G L s J):ℝ) := by
  rw [←corePinnedData_card]
  exact_mod_cast Nat.card_le_card_of_injective _ (coreDataToPin_injective G L s)

lemma coreTriplePin_le_agreement (J : Finset (Roots (W := W) s)) :
    Nat.card (CoreTriplePin G L s J)≤Nat.card (RootFiberPruning.MaskedAgreement (Fiber G L s) J) :=
  Nat.card_le_card_of_injective Subtype.val Subtype.val_injective

end Erdos571.ThreeHubAssignments



/-! The local spectral trimming error is charged to an exact three-role pin
in the original masked assignment family. The pin still requires a sharp bound. -/
set_option maxHeartbeats 2400000
namespace Erdos571.ThreeHubAssignments
open Finset SimpleGraph Matrix ProjectionHeavy MaskedQuadraticPerturbation
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

/-- This keeps the core-middle incidence and identifies the profile with a
subfamily of the original agreement, not a disconnected completion count. -/
theorem subdivision_core_error (H : SimpleGraph V) {α C D : ℝ}
    (hα : 3/2<α) (hα2 : α≤2) (hC : 0≤C) (hD : 0<D)
    (hbound : EdgeBound H α C) (hf : (subdivision H).Free G)
    (L : ℕ) (hL : Fintype.card V+Nat.card H.edgeSet≤L+1)
    (hdeg : ∀ u, (G.degree u:ℝ)≤D) (s : ℕ) (J : Finset (Roots (W := W) s)) :
    (∑ r∈J, ((Nat.card (Fiber G L s r):ℝ)-Nat.card (OneLightCoreFiber G L s r))^2)≤
      2*(Fintype.card W:ℝ)*((HereditaryGraphSpectral.coefficient α C*D^(α-1))^2+D)*
        (Nat.card (CoreTriplePin G L s J):ℝ) := by
  have h := LightArmKernel.subdivision_masked_pinned_error G H hα hα2 hC hD hbound hf L hL hdeg
    J (outerCoreWeight G L s) (innerCoreWeight G L s)
  rw [coreTriplePin_card]
  simp only [fiber_as_core_form,light_fiber_as_core_form,pinnedCoreProfile]
  convert h using 1
  simp only [form,Matrix.sub_apply,sub_mul,sum_sub_distrib]

lemma energy_of_core_error (L : ℝ) (s : ℕ) (J : Finset (Roots (W := W) s)) (B : ℝ)
    (h : (∑ r∈J, ((Nat.card (Fiber G L s r):ℝ)-Nat.card (OneLightCoreFiber G L s r))^2)≤
      B*(Nat.card (CoreTriplePin G L s J):ℝ)) :
    (∑ r∈J, (Nat.card (Fiber G L s r):ℝ)^2)≤
      2*(∑ r∈J, (Nat.card (OneLightCoreFiber G L s r):ℝ)^2)+
        2*B*(Nat.card (CoreTriplePin G L s J):ℝ) := by
  have hs := sum_le_sum (s := J) (fun r _ =>
    show (Nat.card (Fiber G L s r):ℝ)^2≤2*(Nat.card (OneLightCoreFiber G L s r):ℝ)^2+
      2*((Nat.card (Fiber G L s r):ℝ)-Nat.card (OneLightCoreFiber G L s r))^2 from by
        nlinarith [sq_nonneg ((Nat.card (Fiber G L s r):ℝ)-2*Nat.card (OneLightCoreFiber G L s r))])
  simp only [sum_add_distrib,←mul_sum] at hs
  linarith

end Erdos571.ThreeHubAssignments

namespace Erdos571.ThreeHub
open Finset SimpleGraph Matrix ProjectionHeavy ThreeHubAssignments

/-- The actual coefficient is O(n*d^(2-2/(s+1))) and multiplies a
THREE-ROLE PIN, rather than the earlier disconnected product profile. -/
theorem masked_core_error_vs_triplePin (s M : ℕ) (hs : 2≤s) (Q : ℝ) (hQ : 0<Q) :
    ∃ L₀ : ℕ, ∃ C : ℝ, 0≤C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) [DecidableRel G.Adj],
      (graph s M).Free G → ∀ d : ℝ, 0<d →
      (∀ u, (G.degree u:ℝ)≤Q*d) → ∀ L : ℕ, L₀≤L →
      ∀ J : Finset (Roots (W := W) s),
      (∑ r∈J, ((Nat.card (Fiber G L s r):ℝ)-Nat.card (OneLightCoreFiber G L s r))^2)≤
        (Fintype.card W:ℝ)*(2*Q*d+C*d^(2-2/((s:ℝ)+1)))*
          (Nat.card (CoreTriplePin G L s J):ℝ) := by
  obtain ⟨B,hB,hbound⟩ := drc_base_edge_bound s (M+1) (by omega)
  let H := FullRootedPower.graph (base s) (M+1)
  let α : ℝ := 2-1/((s:ℝ)+1)
  let c : ℝ := HereditaryGraphSpectral.coefficient α B
  let C : ℝ := 2*c^2*Q^(2-2/((s:ℝ)+1))
  have hsR : (2:ℝ)≤s := by exact_mod_cast hs
  have hden : (0:ℝ)<s+1 := by positivity
  have hrec : 1/((s:ℝ)+1)<1/2 := (div_lt_iff₀ hden).mpr (by linarith)
  have hα : 3/2<α := by dsimp [α]; linarith
  have hα2 : α≤2 := by dsimp [α]; have := one_div_pos.mpr hden; linarith
  have hC : 0≤C := by dsimp [C]; positivity
  refine ⟨Fintype.card ((Fin (M+1)×Fin 3)⊕BaseRoot s)+Nat.card H.edgeSet,C,hC,?_⟩
  intro W _ _ G _ hf d hd hdeg L hL J
  have h := subdivision_core_error G H hα hα2 hB (mul_pos hQ hd)
    hbound (subdivision_free s M G hf) L (by
      change Fintype.card ((Fin (M+1)×Fin 3)⊕BaseRoot s)+Nat.card H.edgeSet≤L+1
      omega) hdeg s J
  have he : (α-1)*2=2-2/((s:ℝ)+1) := by dsimp [α]; ring
  have hp : (c*(Q*d)^(α-1))^2=c^2*Q^(2-2/((s:ℝ)+1))*d^(2-2/((s:ℝ)+1)) := by
    rw [mul_pow,←Real.rpow_mul_natCast (mul_pos hQ hd).le,Nat.cast_ofNat,he,Real.mul_rpow hQ.le hd.le]
    ring
  change _≤2*(Fintype.card W:ℝ)*((c*(Q*d)^(α-1))^2+Q*d)*_ at h
  rw [hp] at h
  convert h using 1 <;> dsimp [C] <;> ring

end Erdos571.ThreeHub


/-! Supporting module: MatchedThreeHubPin -/
/-! Weighted three-hub interpolation when the two arm kernels satisfy a
pointwise matching identity. This is an analytic lemma, not an extremal
bound or a conclusion about arbitrary root masks. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MatchedThreeHubPin
open Finset Matrix GramPin GramFeatures ThreeHubKernel
variable {U : Type} [Fintype U]

noncomputable def energy (A B K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, K u v * (chain A B u v)^2

noncomputable def pin (A B K : Matrix U U ℝ) : ℝ :=
  ∑ u, K u u * (chain A B u u)^2

lemma energy_nonneg (A B K : Matrix U U ℝ) (hK : ∀ u v, 0 ≤ K u v) :
    0 ≤ energy A B K :=
  sum_nonneg (fun u _ => sum_nonneg (fun v _ => mul_nonneg (hK u v) (sq_nonneg _)))

lemma pin_nonneg (A B K : Matrix U U ℝ) (hK : ∀ u v, 0 ≤ K u v) :
    0 ≤ pin A B K :=
  sum_nonneg (fun u _ => mul_nonneg (hK u u) (sq_nonneg _))

lemma trace_chain (A B : Matrix U U ℝ) (hA : A.IsSymm) :
    (chain A B).trace = ∑ u, ∑ v, B u v*((A*A)*(A*A)) u v := by
  classical
  have hQ : ((A*A)*(A*A)).IsSymm := by
    show (((A*A)*(A*A)).transpose) = _
    simp only [Matrix.transpose_mul, hA.eq]
  rw [inner_trace, hQ.eq]
  unfold chain
  calc
    _ = (((A*A)*(A*A))*B).trace := Matrix.trace_mul_cycle (A*A) B (A*A)
    _ = _ := Matrix.trace_mul_comm _ _

lemma pin_le_twoEnergy (A B K : Matrix U U ℝ) (hA : A.IsSymm)
    (T b : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T) (hdiag : ∀ u, K u u ≤ b) :
    pin A B K ≤ b*T*twoEnergy A B := by
  have h := diagonal_conjugation_bound A (A*B*A) T hT
    (by simpa only [hA.eq] using hr)
  have he : A*(A*B*A)*A.transpose=chain A B := by
    simp only [hA.eq, chain, Matrix.mul_assoc]
  rw [he] at h
  calc
    _ ≤ b * ∑ u, (chain A B u u)^2 := by
      rw [mul_sum]
      exact sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hdiag u) (sq_nonneg _))
    _ ≤ b * (T*twoEnergy A B) := mul_le_mul_of_nonneg_left h hb
    _ = _ := by ring

/-- The matching identity converts weighted Cauchy into a trace, rather
than into the mass of the arm kernel. -/
theorem twoEnergy_sq_le_trace (A B K Q : Matrix U U ℝ) (hA : A.IsSymm)
    (hB : ∀ u v, 0 ≤ B u v) (hK : ∀ u v, 0 ≤ K u v)
    (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v)) :
    (twoEnergy A B)^2 ≤ (chain A B).trace*energy A B K := by
  have hc := sum_sq_le_sum_mul_sum_of_sq_eq_mul (univ : Finset (U×U))
    (fun p _ => mul_nonneg (hQ p.1 p.2) (hB p.1 p.2))
    (fun p _ => mul_nonneg (hK p.1 p.2) (sq_nonneg (chain A B p.1 p.2)))
    (r := fun p => B p.1 p.2*chain A B p.1 p.2)
    (f := fun p => Q p.1 p.2*B p.1 p.2)
    (g := fun p => K p.1 p.2*(chain A B p.1 p.2)^2)
    (by intro p _; rw [mul_pow,hmatch]; ring)
  have hm : (∑ u, ∑ v, Q u v*B u v) ≤ (chain A B).trace := by
    rw [trace_chain A B hA]
    exact sum_le_sum (fun u _ => sum_le_sum (fun v _ => by
      simpa only [mul_comm (B u v)] using mul_le_mul_of_nonneg_right (hle u v) (hB u v)))
  rw [twoEnergy_eq_inner A B hA]
  have hc' : (∑ u, ∑ v, B u v*chain A B u v)^2 ≤
      (∑ u, ∑ v, Q u v*B u v)*energy A B K := by
    simpa only [Fintype.sum_prod_type,energy] using hc
  exact hc'.trans (mul_le_mul_of_nonneg_right hm (energy_nonneg A B K hK))

lemma trace_sq_mul_lower (A B K : Matrix U U ℝ) (c : ℝ) (hc : 0 ≤ c)
    (hdiag : ∀ u, c ≤ K u u) :
    c*(chain A B).trace^2 ≤ (Fintype.card U:ℝ)*pin A B K := by
  have h := sq_sum_le_card_mul_sum_sq (s := (univ : Finset U))
    (f := fun u => chain A B u u)
  have hp : c*(∑ u, (chain A B u u)^2) ≤ pin A B K := by
    rw [mul_sum]
    exact sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hdiag u) (sq_nonneg _))
  have h' := mul_le_mul_of_nonneg_left h hc
  simp only [card_univ] at h'
  change c*(∑ u, chain A B u u)^2 ≤ _
  calc
    _ ≤ c*((Fintype.card U:ℝ)*∑ u, (chain A B u u)^2) := h'
    _ = (Fintype.card U:ℝ)*(c*∑ u, (chain A B u u)^2) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hp (Nat.cast_nonneg _)

/-- A sharp-scale cubic bound for the weighted center pin. The positive
lower bound on the central kernel diagonal is an explicit hypothesis. -/
theorem cubic (A B K Q : Matrix U U ℝ) (hA : A.IsSymm)
    (hB : ∀ u v, 0 ≤ B u v) (hK : ∀ u v, 0 ≤ K u v)
    (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (T b c : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, c ≤ K u u ∧ K u u ≤ b) :
    c*(pin A B K)^3 ≤ (b*T)^4*(Fintype.card U:ℝ)*(energy A B K)^2 := by
  let p := pin A B K
  let z := twoEnergy A B
  let t := (chain A B).trace
  let E := energy A B K
  have hp : 0 ≤ p := pin_nonneg A B K hK
  have hz : 0 ≤ z := twoEnergy_nonneg A B
  have hE : 0 ≤ E := energy_nonneg A B K hK
  have h₁ : p ≤ b*T*z := pin_le_twoEnergy A B K hA T b hT hb hr (fun u => (hdiag u).2)
  have h₂ : z^2 ≤ t*E := twoEnergy_sq_le_trace A B K Q hA hB hK hQ hle hmatch
  have h₃ : c*t^2 ≤ (Fintype.card U:ℝ)*p := trace_sq_mul_lower A B K c hc (fun u => (hdiag u).1)
  have h₄ : p^4 ≤ (b*T)^4*t^2*E^2 := by
    have hz4 : z^4 ≤ t^2*E^2 := by
      have h := pow_le_pow_left₀ (sq_nonneg z) h₂ 2
      convert h using 1 <;> ring
    calc
      _ ≤ (b*T*z)^4 := pow_le_pow_left₀ hp h₁ 4
      _ = (b*T)^4*z^4 := mul_pow _ _ _
      _ ≤ _ := by nlinarith [mul_le_mul_of_nonneg_left hz4 (pow_nonneg (mul_nonneg hb hT) 4)]
  have hfinal : (c*p^3)*p ≤ ((b*T)^4*(Fintype.card U:ℝ)*E^2)*p := by
    calc
      _ = c*p^4 := by ring
      _ ≤ c*((b*T)^4*t^2*E^2) := mul_le_mul_of_nonneg_left h₄ hc
      _ = (b*T)^4*(c*t^2)*E^2 := by ring
      _ ≤ (b*T)^4*((Fintype.card U:ℝ)*p)*E^2 := by
        gcongr
      _ = _ := by ring
  by_cases hp0 : p=0
  · change c*p^3 ≤ _
    rw [hp0,zero_pow (by decide : (3:ℕ)≠0),mul_zero]
    positivity
  · exact (mul_le_mul_iff_left₀ (lt_of_le_of_ne hp (Ne.symm hp0))).mp hfinal

end Erdos571.MatchedThreeHubPin


/-! Supporting module: MatchedArmKernels -/
/-! Matched arm kernels: each endpoint has one more long arm than the
center. Extra common short-arm factors are permitted. -/
set_option maxHeartbeats 2500000
namespace Erdos571.MatchedArmKernels
open Finset Matrix Erdos571.MatchedThreeHubPin
variable {U : Type} [Fintype U]

noncomputable def endpoint (Z Q : Matrix U U ℝ) (s : ℕ) : Matrix U U ℝ :=
  fun u v => Z u v*(Q u v)^s

noncomputable def central (Z Q : Matrix U U ℝ) (s : ℕ) : Matrix U U ℝ :=
  endpoint Z Q (s-1)

lemma matching_identity (Z Q : Matrix U U ℝ) (s : ℕ) (hs : 1 ≤ s) (u v : U) :
    (endpoint Z Q s u v)^2 =
      central Z Q s u v * (Q u v*endpoint Z Q s u v) := by
  dsimp only [central,endpoint]
  simp only [mul_pow]
  have he : (Q u v)^s*(Q u v)^s=(Q u v)^(s-1)*((Q u v)*(Q u v)^s) := by
    rw [←pow_add,←pow_succ',←pow_add]
    congr 1
    omega
  rw [pow_two ((Q u v)^s),he]
  ring

lemma nonneg (Z Q : Matrix U U ℝ) (s : ℕ)
    (hZ : ∀ u v, 0 ≤ Z u v) (hQ : ∀ u v, 0 ≤ Q u v) (u v : U) :
    0 ≤ endpoint Z Q s u v := mul_nonneg (hZ u v) (pow_nonneg (hQ u v) s)

/-- The trace-based cubic bound survives a separate light-arm Gram kernel,
provided that kernel is entrywise below the full fourth-walk kernel.
No arbitrary coupled root mask is inserted in this statement. -/
theorem central_cubic (A Z Q : Matrix U U ℝ) (hA : A.IsSymm)
    (hZ : ∀ u v, 0 ≤ Z u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (s : ℕ) (hs : 1 ≤ s) (T D d q : ℝ)
    (hT : 0 ≤ T) (hD : 0 ≤ D) (hd : 0 ≤ d) (hq : 0 ≤ q)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiagZ : ∀ u, d ≤ Z u u ∧ Z u u ≤ D)
    (hdiagQ : ∀ u, q ≤ Q u u ∧ Q u u ≤ T) :
    (d*q^(s-1))*(pin A (endpoint Z Q s) (central Z Q s))^3 ≤
      (D*T^s)^4*(Fintype.card U:ℝ)*(energy A (endpoint Z Q s) (central Z Q s))^2 := by
  have hdiag (u : U) : d*q^(s-1) ≤ central Z Q s u u ∧
      central Z Q s u u ≤ D*T^(s-1) := by
    constructor
    · exact mul_le_mul (hdiagZ u).1
        (pow_le_pow_left₀ hq (hdiagQ u).1 (s-1))
        (pow_nonneg hq _) (hZ u u)
    · exact mul_le_mul (hdiagZ u).2
        (pow_le_pow_left₀ (hQ u u) (hdiagQ u).2 (s-1))
        (pow_nonneg (hQ u u) _) hD
  have h := MatchedThreeHubPin.cubic A (endpoint Z Q s) (central Z Q s) Q hA
    (nonneg Z Q s hZ hQ) (nonneg Z Q (s-1) hZ hQ) hQ hle (matching_identity Z Q s hs)
    T (D*T^(s-1)) (d*q^(s-1)) hT (by positivity) (by positivity) hr hdiag
  have he : D*T^(s-1)*T=D*T^s := by
    rw [mul_assoc,←pow_succ]
    congr 2
    omega
  rwa [he] at h

/-- With no short arms, the central pin coefficient has degree `6s+2`
when the fourth-walk cap and the arm diagonal both have degree two. -/
theorem unmarked_scale (s : ℕ) (hs : 1 ≤ s) (p E n C d : ℝ)
    (hd : 0 < d)
    (h : (d^2)^(s-1)*p^3 ≤ ((C*d^2)^s)^4*n*E^2) :
    p^3 ≤ C^(4*s)*n*d^(6*s+2)*E^2 := by
  have he : ((C*d^2)^s)^4=C^(4*s)*d^(8*s) := by
    simp only [mul_pow,←pow_mul]
    congr 1 <;> congr 1 <;> omega
  rw [he] at h
  apply (mul_le_mul_iff_right₀ (pow_pos hd (2*(s-1)))).mp
  convert h using 1
  · rw [←pow_mul]
  · have hp : d^(2*(s-1))*d^(6*s+2)=d^(8*s) := by
      rw [←pow_add]
      congr 1
      omega
    calc
      d^(2*(s-1))*(C^(4*s)*n*d^(6*s+2)*E^2) =
          C^(4*s)*n*(d^(2*(s-1))*d^(6*s+2))*E^2 := by ring
      _ = _ := by rw [hp]; ring

end Erdos571.MatchedArmKernels


/-! Supporting module: MatchedThreeHubCorePins -/
/-! Core-pin comparisons for the matched weighted energy. The endpoint
estimate explicitly requires compatibility with the full fourth-walk
kernel; that hypothesis is not inferred for trimmed arm kernels. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MatchedThreeHubPin
open Finset Matrix GramPin GramFeatures ThreeHubKernel
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def outside (A B K : Matrix U U ℝ) : Matrix U U ℝ :=
  fun u v => K u v*chain A B u v

noncomputable def endpointPin (A B K : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, K u v*chain A B u v*endpointChain A B u v

noncomputable def middlePin (A B K : Matrix U U ℝ) : ℝ :=
  ∑ u, (A*B*A) u u*(A*outside A B K*A) u u

lemma endpointPin_le_twoEnergy (A B K : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (hK : ∀ u v, 0 ≤ K u v) (b : ℝ) (hb : 0 ≤ b)
    (hdiag : ∀ u, B u u ≤ b)
    (hcompat : ∀ u v, K u v*((A*A)*(A*A)) u v ≤ B u v) :
    endpointPin A B K ≤ b*twoEnergy A B := by
  rw [twoEnergy_eq_inner A B hs,mul_sum]
  apply sum_le_sum
  intro u _
  rw [mul_sum]
  apply sum_le_sum
  intro v _
  have hC := chain_nonnegative A B hA hB u v
  calc
    _ ≤ K u v*chain A B u v*(b*((A*A)*(A*A)) u v) :=
      mul_le_mul_of_nonneg_left (endpointChain_le A B hA b hdiag u v)
        (mul_nonneg (hK u v) hC)
    _ = b*(K u v*((A*A)*(A*A)) u v)*chain A B u v := by ring
    _ ≤ b*B u v*chain A B u v :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hcompat u v) hb) hC
    _ = _ := by ring

lemma squareMass_endpoint_le_trace (A B K Q : Matrix U U ℝ) (hA : A.IsSymm)
    (hB : ∀ u v, 0 ≤ B u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (b : ℝ) (hb : 0 ≤ b) (hcap : ∀ u v, K u v ≤ b) :
    squareMass B ≤ b*(chain A B).trace := by
  rw [trace_chain A B hA,mul_sum]
  apply sum_le_sum
  intro u _
  rw [mul_sum]
  apply sum_le_sum
  intro v _
  change (B u v)^2 ≤ _
  rw [hmatch]
  calc
    _ ≤ b*(Q u v*B u v) :=
      mul_le_mul_of_nonneg_right (hcap u v) (mul_nonneg (hQ u v) (hB u v))
    _ ≤ b*(((A*A)*(A*A)) u v*B u v) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hle u v) (hB u v)) hb
    _ = _ := by ring

lemma squareMass_outside_le (A B K : Matrix U U ℝ)
    (hK : ∀ u v, 0 ≤ K u v) (b : ℝ) (hcap : ∀ u v, K u v ≤ b) :
    squareMass (outside A B K) ≤ b*energy A B K := by
  rw [energy,mul_sum]
  apply sum_le_sum
  intro u _
  rw [mul_sum]
  apply sum_le_sum
  intro v _
  change (K u v*chain A B u v)^2 ≤ _
  rw [mul_pow]
  have hk : (K u v)^2 ≤ b*K u v := by
    simpa only [pow_two] using mul_le_mul_of_nonneg_right (hcap u v) (hK u v)
  exact (mul_le_mul_of_nonneg_right hk (sq_nonneg _)).trans_eq (by ring)

/-- Both shared core-middle pins admit this trace estimate. It requires
an entry cap on the central kernel, not a global cap on host codegrees. -/
theorem middlePin_sq_le_trace (A B K Q : Matrix U U ℝ) (hs : A.IsSymm)
    (hB : ∀ u v, 0 ≤ B u v) (hK : ∀ u v, 0 ≤ K u v)
    (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (T b : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hcap : ∀ u v, K u v ≤ b) :
    (middlePin A B K)^2 ≤ (b*T)^2*(chain A B).trace*energy A B K := by
  have h₁ := diagonal_conjugation_bound A B T hT (by simpa only [hs.eq] using hr)
  have h₂ := diagonal_conjugation_bound A (outside A B K) T hT
    (by simpa only [hs.eq] using hr)
  rw [hs.eq] at h₁ h₂
  have hcs := sum_mul_sq_le_sq_mul_sq (univ : Finset U)
    (fun u => (A*B*A) u u) (fun u => (A*outside A B K*A) u u)
  have h₃ := squareMass_endpoint_le_trace A B K Q hs hB hQ hle hmatch b hb hcap
  have h₄ := squareMass_outside_le A B K hK b hcap
  have hfirst := h₁.trans (mul_le_mul_of_nonneg_left h₃ hT)
  have hsecond := h₂.trans (mul_le_mul_of_nonneg_left h₄ hT)
  have hprod := mul_le_mul hfirst hsecond
    (sum_nonneg (fun _ _ => sq_nonneg _))
    ((sum_nonneg (fun _ _ => sq_nonneg _)).trans hfirst)
  exact hcs.trans (hprod.trans_eq (by ring))

/-- A scalar consequence shared by the endpoint and middle comparisons.
The center pin remains on the right, so no freeness conclusion is hidden. -/
theorem fourth_vs_center (A B K : Matrix U U ℝ)
    (hK : ∀ u v, 0 ≤ K u v) (x a c : ℝ) (hc : 0 ≤ c)
    (hdiag : ∀ u, c ≤ K u u)
    (hx : x^2 ≤ a^2*(chain A B).trace*energy A B K) :
    c*x^4 ≤ a^4*(Fintype.card U:ℝ)*pin A B K*(energy A B K)^2 := by
  have ht := trace_sq_mul_lower A B K c hc hdiag
  have hp := pow_le_pow_left₀ (sq_nonneg x) hx 2
  have hp' : x^4 ≤ a^4*(chain A B).trace^2*(energy A B K)^2 := by
    convert hp using 1 <;> ring
  calc
    _ ≤ c*(a^4*(chain A B).trace^2*(energy A B K)^2) :=
      mul_le_mul_of_nonneg_left hp' hc
    _ = a^4*(c*(chain A B).trace^2)*(energy A B K)^2 := by ring
    _ ≤ a^4*((Fintype.card U:ℝ)*pin A B K)*(energy A B K)^2 := by gcongr
    _ = _ := by ring

end Erdos571.MatchedThreeHubPin


/-! Supporting module: MatchedThreeHubTemplate -/
/-! The matched three-hub template: endpoint arm counts s, central count
s-1. This module gives its lower certificate and a fourth-walk estimate
from actual freeness, not its sharp extremal upper bound. -/
set_option maxHeartbeats 2000000
namespace Erdos571.MatchedThreeHub
open Finset SimpleGraph RootedSunflower

abbrev counts (s : ℕ) := BalancedTree.leafCount 2 (3*s-2)
abbrev BaseRoot (s : ℕ) := BalancedTree.Leaf (counts s)
def base (s : ℕ) := BalancedTree.graph (counts s)
def template (s : ℕ) := RootedSubdivision.graph (base s)
def graph (s M : ℕ) := FullRootedPower.graph (template s) M

lemma base_roots (s : ℕ) (hs : 1 ≤ s) : Fintype.card (BaseRoot s)=3*s-1 := by
  rw [BalancedTree.card_roots]
  omega

lemma base_edges (s : ℕ) (hs : 1 ≤ s) : Nat.card (base s).edgeSet=3*s+1 := by
  rw [base,BalancedTree.card_edges,BalancedTree.sum_leafCount]
  omega

lemma base_isTree (s : ℕ) : (base s).IsTree := BalancedTree.isTree _

lemma base_balance (s : ℕ) (hs : 1 ≤ s) : ∀ C : Finset (Fin 3),
    (3*s+1)*(Fintype.card (Fin 3)-C.card) ≤ 3*Nat.card (PetalEdge (base s) C) := by
  intro C
  have h := BalancedExactLower.petal_balance 2 (3*s-2) C
  simpa only [show 2+(3*s-2)+1=3*s+1 by omega,show 2+1=3 by omega] using h

lemma template_balance (s : ℕ) (hs : 1 ≤ s) : ∀ C : Finset (RootedSubdivision.Nonroot (base s)),
    (6*s+2)*(Fintype.card (RootedSubdivision.Nonroot (base s))-C.card) ≤
      (3*s+4)*Nat.card (PetalEdge (template s) C) := by
  classical
  have h := RootedSubdivision.balance (base s) 3 (3*s+1) (by omega) (base_balance s hs)
  simpa only [template, Fintype.card_eq_nat_card,
    show 2*(3*s+1)=6*s+2 by omega,show 3+(3*s+1)=3*s+4 by omega] using h

lemma no_isolated (s : ℕ) : ∀ u, ∃ v, (template s).Adj u v :=
  RootedSubdivision.no_isolated (base s) (BalancedExactLower.no_isolated 2 (3*s-2))

lemma connected (s : ℕ) : (template s).Connected :=
  RootedSubdivision.connected (base s) (base_isTree s).isConnected

lemma graph_bipartite (s M : ℕ) : (graph s M).IsBipartite := by
  let c := RootedSubdivision.color (base s)
  let C : (graph s M).Coloring Bool :=
    ⟨FullRootedPower.color c M,FullRootedPower.color_proper (template s) c M
      (RootedSubdivision.color_proper (base s))⟩
  simpa only [Fintype.card_bool] using C.colorable

/-- A fixed actual power has the exact predicted lower exponent. No
matching ordinary upper bound is asserted. -/
theorem exists_lower (s : ℕ) (hs : 1 ≤ s) : ∃ M : ℕ, 2 ≤ M ∧
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^(2-(3*(s:ℝ)+4)/(6*(s:ℝ)+2)))
      (fun n : ℕ => (extremalNumber n (graph s M):ℝ)) := by
  have h := FullRootedPower.exact_lower (template s) (no_isolated s)
    (3*s+4) (6*s+2) (by omega) (by omega) (template_balance s hs)
  simpa only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat] using h

lemma counts_eq (s : ℕ) (hs : 1 ≤ s) (i : Fin 3) :
    counts s i = if i=1 then s-1 else s := by
  have h31 : 2 ≤ 3*s := by omega
  have h₁ : BalancedTree.rounding 2 (3*s-2) 1=s := by
    unfold BalancedTree.rounding BalancedTree.slope
    norm_num only [Nat.cast_ofNat,Nat.cast_add]
    apply (Nat.ceil_eq_iff (by omega : s≠0)).mpr
    rw [Nat.cast_sub hs,Nat.cast_sub h31]
    push_cast
    constructor <;> linarith
  have h₂ : BalancedTree.rounding 2 (3*s-2) 2=2*s-1 := by
    unfold BalancedTree.rounding BalancedTree.slope
    norm_num only [Nat.cast_ofNat,Nat.cast_add]
    apply (Nat.ceil_eq_iff (by omega : 2*s-1≠0)).mpr
    rw [Nat.cast_sub (by omega : 1 ≤ 2*s-1),Nat.cast_sub (by omega : 1 ≤ 2*s),
      Nat.cast_sub h31]
    push_cast
    constructor <;> linarith
  have h₃ : BalancedTree.rounding 2 (3*s-2) 3=3*s-2 := BalancedTree.rounding_end 2 _
  fin_cases i
  · simp [counts,BalancedTree.leafCount,Fin.last,BalancedTree.rounding_zero,h₁]
  · simp [counts,BalancedTree.leafCount,Fin.last,h₁,h₂]
    omega
  · simp [counts,BalancedTree.leafCount,Fin.last,h₂,h₃]
    omega

abbrev Branch (s M : ℕ) := (Fin (M+1)×Fin 3)⊕BaseRoot s

noncomputable def momentCoefficient (s M : ℕ) : ℝ :=
  (Fintype.card (Branch s M)-1:ℕ)*
    ((Fintype.card (Branch s M)+
      Nat.card (FullRootedPower.graph (base s) (M+1)).edgeSet:ℕ)+1:ℝ)

lemma momentCoefficient_nonneg (s M : ℕ) : 0 ≤ momentCoefficient s M := by
  unfold momentCoefficient
  positivity

/-- Actual freeness of this new template, not freeness of the older uniform
ThreeHub template, supplies the needed fourth-walk cap. -/
theorem free_fourth_row_bound {W : Type} [Fintype W] [DecidableEq W]
    (s M : ℕ) (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (graph s M).Free G) (D : ℝ) (hD : 0 ≤ D)
    (hdeg : ∀ v, (G.degree v:ℝ) ≤ D) (u : W) :
    (∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2) ≤
      momentCoefficient s M*D^2 := by
  have hv : 2 ≤ Fintype.card (Branch s M) := by
    simp only [Branch,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hsub : (ProjectionHeavy.subdivision (FullRootedPower.graph (base s) (M+1))).Free G := by
    intro h
    exact hf (IsContained.trans ⟨RootedSubdivision.powerCopy (base s) M⟩ h)
  exact HostHeavyShadow.subdivision_free_row_bound _ hv G hsub D hD hdeg u

end Erdos571.MatchedThreeHub


/-! Supporting module: MatchedThreeHubGraphPin -/
/-! The sharp-scale central-kernel estimate under actual matched-template
freeness. This is not yet a count of all injective copies or an upper bound
for the extremal number. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MatchedThreeHub
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin MatchedArmKernels
variable {W : Type} [Fintype W] [DecidableEq W]

lemma fourth_diagonal_lower (G : SimpleGraph W) [DecidableRel G.Adj]
    (d : ℝ) (hd : 0 ≤ d) (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (u : W) :
    d^2 ≤ ((G.adjMatrix ℝ * G.adjMatrix ℝ)*(G.adjMatrix ℝ * G.adjMatrix ℝ)) u u := by
  let A := G.adjMatrix ℝ
  have hP : (A*A).IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul,G.isSymm_adjMatrix]
  have he : ((A*A)*(A*A)) u u=∑ v, ((A*A) u v)^2 := by
    simp only [Matrix.mul_apply]
    apply sum_congr rfl
    intro v _
    change (A*A) u v*(A*A) v u=((A*A) u v)^2
    rw [hP.apply v u,pow_two]
  change d^2 ≤ ((A*A)*(A*A)) u u
  rw [he]
  have h := single_le_sum (s := (univ : Finset W))
    (f := fun v => ((A*A) u v)^2) (fun v _ => sq_nonneg _) (mem_univ u)
  have hdg : (A*A) u u=(G.degree u:ℝ) := G.adjMatrix_mul_self_apply_self u
  dsimp only at h
  rw [hdg] at h
  exact (pow_le_pow_left₀ hd (hmin u) 2).trans h

/-- The degree exponent on the coefficient is exactly the template edge
count `6s+2`. The central bundle has `s-1` arms, not `s`. -/
theorem free_central_kernel_bound (s M : ℕ) (hs : 1 ≤ s)
    (G : SimpleGraph W) [DecidableRel G.Adj] (hf : (graph s M).Free G)
    (d K : ℝ) (hd : 0 < d) (hK : 0 ≤ K)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d) :
    let A := G.adjMatrix ℝ
    let Q := (A*A)*(A*A)
    let B := endpoint (fun _ _ => 1) Q s
    let C := central (fun _ _ => 1) Q s
    (pin A B C)^3 ≤ (momentCoefficient s M*K^2)^(4*s)*(Fintype.card W:ℝ)*
      d^(6*s+2)*(energy A B C)^2 := by
  dsimp only
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let C := momentCoefficient s M*K^2
  let T := C*d^2
  have hC : 0 ≤ C := mul_nonneg (momentCoefficient_nonneg s M) (sq_nonneg K)
  have hT : 0 ≤ T := mul_nonneg hC (sq_nonneg d)
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hQT := LayeredBush.fourth_entries_of_row_bound G T hT hrow
  have hQ (u v : W) : 0 ≤ Q u v := (hQT u v).1
  have hdiag (u : W) : d^2 ≤ Q u u ∧ Q u u ≤ T :=
    ⟨fourth_diagonal_lower G d hd.le hmin u,(hQT u u).2⟩
  have h := central_cubic A (fun _ _ => 1) Q G.isSymm_adjMatrix
    (by intros; norm_num) hQ (by intros; exact le_rfl) s hs T 1 1 (d^2)
    hT (by norm_num) (by norm_num) (sq_nonneg d) hrow (by intros; exact ⟨le_rfl,le_rfl⟩) hdiag
  simp only [one_mul] at h
  exact unmarked_scale s hs _ _ _ C d hd h

end Erdos571.MatchedThreeHub


/-! Supporting module: MatchedThreeHubAllCore -/
/-! All unmasked matched core pins have the same cubic coefficient.
This is an analytic statement, not a complete extremal upper bound. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MatchedThreeHubPin
open Finset Matrix GramPin GramFeatures ThreeHubKernel

lemma trace_cubic_scalar (p z t E a c n : ℝ)
    (hp : 0 ≤ p) (ht : 0 ≤ t) (hE : 0 ≤ E)
    (ha : 0 ≤ a) (hc : 0 ≤ c) (hn : 0 ≤ n)
    (h₁ : p ≤ a*z) (h₂ : z^2 ≤ t*E) (h₃ : c*t^2 ≤ n*p) :
    c^2*t^3 ≤ n^2*a^2*E := by
  have h₄ : c^2*t^4 ≤ n^2*a^2*t*E := by
    calc
      _ = (c*t^2)^2 := by ring
      _ ≤ (n*p)^2 := pow_le_pow_left₀ (mul_nonneg hc (sq_nonneg t)) h₃ 2
      _ = n^2*p^2 := mul_pow _ _ _
      _ ≤ n^2*(a*z)^2 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hp h₁ 2) (sq_nonneg n)
      _ = n^2*a^2*z^2 := by ring
      _ ≤ n^2*a^2*(t*E) := mul_le_mul_of_nonneg_left h₂ (mul_nonneg (sq_nonneg n) (sq_nonneg a))
      _ = _ := by ring
  by_cases ht0 : t=0
  · rw [ht0,zero_pow (by decide : (3:ℕ)≠0),mul_zero]
    positivity
  · apply (mul_le_mul_iff_left₀ (lt_of_le_of_ne ht (Ne.symm ht0))).mp
    convert h₄ using 1 <;> ring

lemma pin_cubic_scalar (x t E a c n : ℝ)
    (hE : 0 ≤ E) (ha : 0 ≤ a) (hn : 0 ≤ n)
    (hx : x^2 ≤ a^2*t*E) (ht : c^2*t^3 ≤ n^2*a^2*E) :
    c*x^3 ≤ a^4*n*E^2 := by
  have h₁ : x^6 ≤ a^6*t^3*E^3 := by
    have h := pow_le_pow_left₀ (sq_nonneg x) hx 3
    convert h using 1 <;> ring
  apply le_of_sq_le_sq _ (by positivity)
  calc
    _ = c^2*x^6 := by ring
    _ ≤ c^2*(a^6*t^3*E^3) := mul_le_mul_of_nonneg_left h₁ (sq_nonneg c)
    _ = a^6*E^3*(c^2*t^3) := by ring
    _ ≤ a^6*E^3*(n^2*a^2*E) :=
      mul_le_mul_of_nonneg_left ht (mul_nonneg (pow_nonneg ha _) (pow_nonneg hE _))
    _ = _ := by ring

variable {U : Type} [Fintype U] [DecidableEq U]

/-- The common trace estimate underlying all three types of core pin. -/
theorem trace_cubic (A B K Q : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (hK : ∀ u v, 0 ≤ K u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (T b c : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, c ≤ K u u ∧ K u u ≤ b) :
    c^2*(chain A B).trace^3 ≤
      (Fintype.card U:ℝ)^2*(b*T)^2*energy A B K := by
  apply trace_cubic_scalar (pin A B K) (twoEnergy A B) _ _ _ _ _
    (pin_nonneg A B K hK) (sum_nonneg (fun u _ => chain_nonnegative A B hA hB u u))
    (energy_nonneg A B K hK) (mul_nonneg hb hT) hc (Nat.cast_nonneg _)
  · exact pin_le_twoEnergy A B K hs T b hT hb hr (fun u => (hdiag u).2)
  · exact twoEnergy_sq_le_trace A B K Q hs hB hK hQ hle hmatch
  · exact trace_sq_mul_lower A B K c hc (fun u => (hdiag u).1)

/-- A pin satisfying the common squared trace comparison obeys the cubic. -/
theorem cubic_of_trace_comparison (A B K Q : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (hK : ∀ u v, 0 ≤ K u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (T b c x : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, c ≤ K u u ∧ K u u ≤ b)
    (hx : x^2 ≤ (b*T)^2*(chain A B).trace*energy A B K) :
    c*x^3 ≤ (b*T)^4*(Fintype.card U:ℝ)*(energy A B K)^2 := by
  exact pin_cubic_scalar x _ _ _ _ _ (energy_nonneg A B K hK)
    (mul_nonneg hb hT) (Nat.cast_nonneg _) hx
    (trace_cubic A B K Q hs hA hB hK hQ hle hmatch T b c hT hb hc hr hdiag)

/-- No endpoint compatibility is required for the core-middle estimate. -/
theorem middle_cubic (A B K Q : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (hK : ∀ u v, 0 ≤ K u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (T b c : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hcap : ∀ u v, K u v ≤ b) (hdiag : ∀ u, c ≤ K u u) :
    c*(middlePin A B K)^3 ≤ (b*T)^4*(Fintype.card U:ℝ)*(energy A B K)^2 := by
  exact cubic_of_trace_comparison A B K Q hs hA hB hK hQ hle hmatch T b c _ hT hb hc
    hr (fun u => ⟨hdiag u,hcap u u⟩)
    (middlePin_sq_le_trace A B K Q hs hB hK hQ hle hmatch T b hT hb hr hcap)

/-- The endpoint estimate additionally needs compatibility with the full
fourth-walk kernel and its corresponding diagonal cap. -/
theorem endpoint_cubic (A B K Q : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (hK : ∀ u v, 0 ≤ K u v) (hQ : ∀ u v, 0 ≤ Q u v)
    (hle : ∀ u v, Q u v ≤ ((A*A)*(A*A)) u v)
    (hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v))
    (T b c : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, c ≤ K u u ∧ K u u ≤ b)
    (hBdiag : ∀ u, B u u ≤ b*T)
    (hcompat : ∀ u v, K u v*((A*A)*(A*A)) u v ≤ B u v) :
    c*(endpointPin A B K)^3 ≤ (b*T)^4*(Fintype.card U:ℝ)*(energy A B K)^2 := by
  apply cubic_of_trace_comparison A B K Q hs hA hB hK hQ hle hmatch
    T b c _ hT hb hc hr hdiag
  have hp : 0 ≤ endpointPin A B K := by
    apply sum_nonneg
    intro u _
    apply sum_nonneg
    intro v _
    exact mul_nonneg (mul_nonneg (hK u v) (chain_nonnegative A B hA hB u v))
      (endpointChain_nonneg A B hA hB u v)
  have h₁ := endpointPin_le_twoEnergy A B K hs hA hB hK (b*T) (mul_nonneg hb hT) hBdiag hcompat
  have h₂ := twoEnergy_sq_le_trace A B K Q hs hB hK hQ hle hmatch
  calc
    _ ≤ (b*T*twoEnergy A B)^2 := pow_le_pow_left₀ hp h₁ 2
    _ = (b*T)^2*(twoEnergy A B)^2 := mul_pow _ _ _
    _ ≤ (b*T)^2*((chain A B).trace*energy A B K) :=
      mul_le_mul_of_nonneg_left h₂ (sq_nonneg _)
    _ = _ := by ring

end Erdos571.MatchedThreeHubPin


/-! Supporting module: MatchedThreeHubAllCoreGraph -/
/-! Sharp-scale bounds for every unmasked matched core-pin kernel,
under actual matched-template freeness. No injectivity claim is made. -/
set_option maxHeartbeats 3000000
namespace Erdos571.MatchedArmKernels
open Finset Matrix GramPin GramFeatures ThreeHubKernel MatchedThreeHubPin
variable {U : Type} [Fintype U] [DecidableEq U]

lemma unmarked_all_core_cubic (A : Matrix U U ℝ) (hsymm : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (s : ℕ) (hs : 1 ≤ s)
    (T q : ℝ) (hT : 0 ≤ T) (hq : 0 ≤ q)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hdiag : ∀ u, q ≤ ((A*A)*(A*A)) u u)
    (hcap : ∀ u v, ((A*A)*(A*A)) u v ≤ T) (x : ℝ)
    (hx : x=pin A (endpoint (fun _ _ => 1) ((A*A)*(A*A)) s)
        (central (fun _ _ => 1) ((A*A)*(A*A)) s) ∨
      x=MatchedThreeHubPin.endpointPin A (endpoint (fun _ _ => 1) ((A*A)*(A*A)) s)
        (central (fun _ _ => 1) ((A*A)*(A*A)) s) ∨
      x=middlePin A (endpoint (fun _ _ => 1) ((A*A)*(A*A)) s)
        (central (fun _ _ => 1) ((A*A)*(A*A)) s)) :
    q^(s-1)*x^3 ≤ (T^s)^4*(Fintype.card U:ℝ)*
      (MatchedThreeHubPin.energy A (endpoint (fun _ _ => 1) ((A*A)*(A*A)) s)
        (central (fun _ _ => 1) ((A*A)*(A*A)) s))^2 := by
  let Q := (A*A)*(A*A)
  let B := endpoint (fun _ _ => 1) Q s
  let K := central (fun _ _ => 1) Q s
  have hQ (u v : U) : 0 ≤ Q u v := chain_nonneg (chain_nonneg hA hA) (chain_nonneg hA hA) u v
  have hB : ∀ u v, 0 ≤ B u v := nonneg _ Q s (by intros; norm_num) hQ
  have hK : ∀ u v, 0 ≤ K u v := nonneg _ Q (s-1) (by intros; norm_num) hQ
  have hKcap (u v : U) : K u v ≤ T^(s-1) := by
    change 1*(Q u v)^(s-1) ≤ _
    rw [one_mul]
    exact pow_le_pow_left₀ (hQ u v) (hcap u v) _
  have hKdiag (u : U) : q^(s-1) ≤ K u u := by
    change _ ≤ 1*(Q u u)^(s-1)
    rw [one_mul]
    exact pow_le_pow_left₀ hq (hdiag u) _
  have he : T^(s-1)*T=T^s := by
    rw [←pow_succ]
    congr 1
    omega
  have hmatch : ∀ u v, (B u v)^2=K u v*(Q u v*B u v) := matching_identity _ Q s hs
  have hBdiag (u : U) : B u u ≤ T^(s-1)*T := by
    rw [he]
    change 1*(Q u u)^s ≤ _
    rw [one_mul]
    exact pow_le_pow_left₀ (hQ u u) (hcap u u) _
  have hcompat (u v : U) : K u v*((A*A)*(A*A)) u v ≤ B u v := by
    change (1*(Q u v)^(s-1))*Q u v ≤ 1*(Q u v)^s
    simp only [one_mul]
    rw [←pow_succ,show s-1+1=s by omega]
  rcases hx with rfl|rfl|rfl
  · have h := MatchedThreeHubPin.cubic A B K Q hsymm hB hK hQ (by intros; exact le_rfl)
      hmatch T (T^(s-1)) (q^(s-1)) hT (pow_nonneg hT _) (pow_nonneg hq _) hr
      (fun u => ⟨hKdiag u,hKcap u u⟩)
    rwa [he] at h
  · have h := endpoint_cubic A B K Q hsymm hA hB hK hQ (by intros; exact le_rfl)
      hmatch T (T^(s-1)) (q^(s-1)) hT (pow_nonneg hT _) (pow_nonneg hq _) hr
      (fun u => ⟨hKdiag u,hKcap u u⟩) hBdiag hcompat
    rwa [he] at h
  · have h := middle_cubic A B K Q hsymm hA hB hK hQ (by intros; exact le_rfl)
      hmatch T (T^(s-1)) (q^(s-1)) hT (pow_nonneg hT _) (pow_nonneg hq _) hr hKcap hKdiag
    rwa [he] at h

end Erdos571.MatchedArmKernels

namespace Erdos571.MatchedThreeHub
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin MatchedArmKernels
variable {W : Type} [Fintype W] [DecidableEq W]

/-- All three unmasked core-pin kernels have the sharp degree coefficient.
This does not assert a retained-mask inequality or an injective-copy bound. -/
theorem free_all_core_kernel_bound (s M : ℕ) (hs : 1 ≤ s)
    (G : SimpleGraph W) [DecidableRel G.Adj] (hf : (graph s M).Free G)
    (d K : ℝ) (hd : 0 < d) (hK : 0 ≤ K)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d) :
    let A := G.adjMatrix ℝ
    let Q := (A*A)*(A*A)
    let B := endpoint (fun _ _ => 1) Q s
    let C := central (fun _ _ => 1) Q s
    ∀ x : ℝ, (x=pin A B C ∨ x=endpointPin A B C ∨ x=middlePin A B C) →
      x^3 ≤ (momentCoefficient s M*K^2)^(4*s)*(Fintype.card W:ℝ)*
        d^(6*s+2)*(energy A B C)^2 := by
  dsimp only
  intro x hx
  let A := G.adjMatrix ℝ
  let Q := (A*A)*(A*A)
  let C := momentCoefficient s M*K^2
  let T := C*d^2
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hC : 0 ≤ C := mul_nonneg (momentCoefficient_nonneg s M) (sq_nonneg K)
  have hT : 0 ≤ T := mul_nonneg hC (sq_nonneg d)
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hQT := LayeredBush.fourth_entries_of_row_bound G T hT hrow
  have hdiag (u : W) : d^2 ≤ Q u u := fourth_diagonal_lower G d hd.le hmin u
  have h := unmarked_all_core_cubic A G.isSymm_adjMatrix hA s hs T (d^2) hT (sq_nonneg d)
    hrow hdiag (fun u v => (hQT u v).2) x hx
  exact unmarked_scale s hs _ _ _ C d hd h

end Erdos571.MatchedThreeHub


/-! Supporting module: HybridMatchedKernels -/
/-! One untrimmed endpoint arm restores the full-kernel matching identity.
The common factor may still consist entirely of trimmed arms. These are
kernel estimates, not an injective-copy or extremal upper-bound theorem. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMatchedKernels
open Finset Matrix GramFeatures GramPin ThreeHubKernel MatchedThreeHubPin
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def endpoint (A Z : Matrix U U ℝ) : Matrix U U ℝ :=
  fun u v => Z u v * ((A*A)*(A*A)) u v

lemma matching_identity (A Z : Matrix U U ℝ) (u v : U) :
    (endpoint A Z u v)^2 = Z u v * (((A*A)*(A*A)) u v * endpoint A Z u v) := by
  unfold endpoint
  ring

/-- All three core-pin estimates permit an arbitrary nonnegative common
factor, provided one endpoint arm uses the full fourth-walk kernel. -/
theorem all_core_cubic (A Z : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hZ : ∀ u v, 0 ≤ Z u v)
    (T b c : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hQcap : ∀ u v, ((A*A)*(A*A)) u v ≤ T)
    (hcap : ∀ u v, Z u v ≤ b) (hdiag : ∀ u, c ≤ Z u u)
    (x : ℝ) (hx : x=pin A (endpoint A Z) Z ∨
      x=endpointPin A (endpoint A Z) Z ∨ x=middlePin A (endpoint A Z) Z) :
    c*x^3 ≤ (b*T)^4*(Fintype.card U:ℝ)*(energy A (endpoint A Z) Z)^2 := by
  let Q := (A*A)*(A*A)
  let B := endpoint A Z
  have hQ : ∀ u v, 0 ≤ Q u v :=
    chain_nonneg (chain_nonneg hA hA) (chain_nonneg hA hA)
  have hB : ∀ u v, 0 ≤ B u v := fun u v => mul_nonneg (hZ u v) (hQ u v)
  have hmatch : ∀ u v, (B u v)^2=Z u v*(Q u v*B u v) := matching_identity A Z
  have hBdiag (u : U) : B u u ≤ b*T :=
    mul_le_mul (hcap u u) (hQcap u u) (hQ u u) hb
  have hcompat (u v : U) : Z u v*((A*A)*(A*A)) u v ≤ B u v := le_rfl
  rcases hx with rfl|rfl|rfl
  · exact MatchedThreeHubPin.cubic A B Z Q hs hB hZ hQ (by intros; exact le_rfl)
      hmatch T b c hT hb hc hr (fun u => ⟨hdiag u,hcap u u⟩)
  · exact endpoint_cubic A B Z Q hs hA hB hZ hQ (by intros; exact le_rfl)
      hmatch T b c hT hb hc hr (fun u => ⟨hdiag u,hcap u u⟩) hBdiag hcompat
  · exact middle_cubic A B Z Q hs hA hB hZ hQ (by intros; exact le_rfl)
      hmatch T b c hT hb hc hr hcap hdiag

/-- All remaining arms may use a separate light Gram kernel. No assertion
that this light kernel is itself the full fourth-walk kernel is made. -/
theorem light_power_cubic (A R : Matrix U U ℝ) (hsymm : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hR : ∀ u v, 0 ≤ R u v)
    (s : ℕ) (hs : 1 ≤ s) (T q : ℝ) (hT : 0 ≤ T) (hq : 0 ≤ q)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hQcap : ∀ u v, ((A*A)*(A*A)) u v ≤ T)
    (hcap : ∀ u v, R u v ≤ T) (hdiag : ∀ u, q ≤ R u u)
    (x : ℝ) (hx : x=pin A (endpoint A (entryPower R (s-1))) (entryPower R (s-1)) ∨
      x=endpointPin A (endpoint A (entryPower R (s-1))) (entryPower R (s-1)) ∨
      x=middlePin A (endpoint A (entryPower R (s-1))) (entryPower R (s-1))) :
    q^(s-1)*x^3 ≤ (T^s)^4*(Fintype.card U:ℝ)*
      (energy A (endpoint A (entryPower R (s-1))) (entryPower R (s-1)))^2 := by
  have h := all_core_cubic A (entryPower R (s-1)) hsymm hA
    (fun u v => pow_nonneg (hR u v) _) T (T^(s-1)) (q^(s-1))
    hT (pow_nonneg hT _) (pow_nonneg hq _) hr hQcap
    (fun u v => pow_le_pow_left₀ (hR u v) (hcap u v) _)
    (fun u => pow_le_pow_left₀ hq (hdiag u) _) x hx
  have he : T^(s-1)*T=T^s := by
    rw [←pow_succ]
    congr 1
    omega
  rwa [he] at h

lemma light_scale (s : ℕ) (hs : 1 ≤ s) (p E n C d : ℝ) (hd : 0 < d)
    (h : (d^2/2)^(s-1)*p^3 ≤ ((C*d^2)^s)^4*n*E^2) :
    p^3 ≤ (2:ℝ)^(s-1)*C^(4*s)*n*d^(6*s+2)*E^2 := by
  have hh := mul_le_mul_of_nonneg_left h (by positivity : 0 ≤ (2:ℝ)^(s-1))
  have he : (2:ℝ)^(s-1)*(d^2/2)^(s-1)=(d^2)^(s-1) := by
    rw [←mul_pow]
    congr 1
    ring
  have h' : (d^2)^(s-1)*p^3 ≤ ((C*d^2)^s)^4*((2:ℝ)^(s-1)*n)*E^2 := by
    calc
      _ = (2:ℝ)^(s-1)*((d^2/2)^(s-1)*p^3) := by rw [←mul_assoc,he]
      _ ≤ _ := hh.trans_eq (by ring)
  have h'' := MatchedArmKernels.unmarked_scale s hs p E ((2:ℝ)^(s-1)*n) C d hd h'
  convert h'' using 1 <;> ring

end Erdos571.HybridMatchedKernels

namespace Erdos571.MatchedThreeHub
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin
variable {W : Type} [Fintype W] [DecidableEq W]

/-- Actual matched-template freeness gives the sharp coefficient for all
hybrid core pins. Each endpoint has one full arm and `s-1` light arms;
the center has `s-1` light arms. Root labels are not coupled by an extra mask. -/
theorem free_hybrid_all_core_bound (s M : ℕ) (hs : 1 ≤ s)
    (G : SimpleGraph W) [DecidableRel G.Adj] (hf : (graph s M).Free G)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*momentCoefficient s M*K^2 ≤ L) :
    let A := G.adjMatrix ℝ
    let N := LightArmKernel.matrix G L
    let Z := entryPower (N*N.transpose) (s-1)
    let B := HybridMatchedKernels.endpoint A Z
    ∀ x : ℝ, (x=pin A B Z ∨ x=endpointPin A B Z ∨ x=middlePin A B Z) →
      x^3 ≤ (2:ℝ)^(s-1)*(momentCoefficient s M*K^2)^(4*s)*
        (Fintype.card W:ℝ)*d^(6*s+2)*(energy A B Z)^2 := by
  dsimp only
  intro x hx
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let R := N*N.transpose
  let C := momentCoefficient s M*K^2
  let T := C*d^2
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hC : 0 ≤ C := mul_nonneg (momentCoefficient_nonneg s M) (sq_nonneg K)
  have hT : 0 ≤ T := mul_nonneg hC (sq_nonneg d)
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := free_fourth_row_bound s M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hQcap (u v : W) : ((A*A)*(A*A)) u v ≤ T :=
    (LayeredBush.fourth_entries_of_row_bound G T hT hrow u v).2
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hdiag (u : W) : d^2/2 ≤ R u u :=
    (hNrow u).trans (LightArmKernel.gram_diagonal_lower G L u)
  have h := HybridMatchedKernels.light_power_cubic A R G.isSymm_adjMatrix hA
    (LightArmKernel.gram_nonneg G L) s hs T (d^2/2) hT (by positivity)
    hrow hQcap (LightArmKernel.gram_upper G L T hT hrow) hdiag x hx
  exact HybridMatchedKernels.light_scale s hs _ _ _ C d hd h

end Erdos571.MatchedThreeHub


/-! Supporting module: HybridThreeHubAssignments -/
/-! Finite hybrid three-hub assignments. The two endpoint bundles have one
untrimmed arm in addition to the common light arms. Repeated vertices are
allowed. No claim that these assignments are injective copies is made. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

abbrev Labels := Fin k → W
abbrev EndLabels := Labels (W:=W) k × W
abbrev Roots := Labels (W:=W) k × (EndLabels (W:=W) k × EndLabels (W:=W) k)
abbrev Bundle (x : W) (r : Labels (W:=W) k) := MaskedBush.Bundle G L (Fin k) x r
abbrev EndBundle (x : W) (r : EndLabels (W:=W) k) :=
  Bundle G L k x r.1 × G.commonNeighbors x r.2
abbrev Side (x : W) (r : EndLabels (W:=W) k) :=
  (u : W) × (G.commonNeighbors x u × EndBundle G L k u r)
abbrev At (r : Roots (W:=W) k) (x : W) :=
  Bundle G L k x r.1 × (Side G L k x r.2.1 × Side G L k x r.2.2)
abbrev Fiber (r : Roots (W:=W) k) := (x : W) × At G L k r x
abbrev Full := (r : Roots (W:=W) k) × Fiber G L k r
abbrev Agreement := FiberRestrictionEnergy.Agreement (Fiber G L k)
abbrev Pin (role : Full G L k → W) :=
  {p : Full G L k × Full G L k // p.1.1=p.2.1 ∧ role p.1=role p.2}
abbrev MarkFiber (role : Full G L k → W) (r : Roots (W:=W) k) (x : W) :=
  {p : Fiber G L k r // role ⟨r,p⟩=x}

def center (p : Full G L k) : W := p.2.1
def leftHub (p : Full G L k) : W := p.2.2.2.1.1
def rightHub (p : Full G L k) : W := p.2.2.2.2.1

noncomputable instance sideFintype (x : W) (r : EndLabels (W:=W) k) : Fintype (Side G L k x r) := by
  classical
  infer_instance
noncomputable instance fiberFintype (r : Roots (W:=W) k) : Fintype (Fiber G L k r) := by
  classical
  infer_instance

noncomputable def armFeature : Matrix W (Labels (W:=W) k) ℝ :=
  ArmTensor.tensor (LightArmKernel.matrix G L) (Fin k)
noncomputable def endFeature : Matrix W (EndLabels (W:=W) k) ℝ :=
  fun x r => armFeature G L k x r.1*(G.adjMatrix ℝ * G.adjMatrix ℝ) x r.2
noncomputable def sideFeature : Matrix W (EndLabels (W:=W) k) ℝ :=
  (G.adjMatrix ℝ * G.adjMatrix ℝ)*endFeature G L k
noncomputable def centralKernel : Matrix W W ℝ :=
  entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k
noncomputable def endpointKernel : Matrix W W ℝ :=
  HybridMatchedKernels.endpoint (G.adjMatrix ℝ) (centralKernel G L k)

lemma card_endBundle (x : W) (r : EndLabels (W:=W) k) :
    (Fintype.card (EndBundle G L k x r):ℝ)=endFeature G L k x r := by
  classical
  simp only [EndBundle,Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,
    ←LayeredBush.adjacency_square_common_card]
  rfl

lemma card_side (x : W) (r : EndLabels (W:=W) k) :
    (Fintype.card (Side G L k x r):ℝ)=sideFeature G L k x r := by
  classical
  simp only [Side,Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,
    card_endBundle,sideFeature,endFeature,armFeature,MaskedBush.card_bundle,Matrix.mul_apply,
    ←LayeredBush.adjacency_square_common_card]

lemma card_at (r : Roots (W:=W) k) (x : W) :
    (Fintype.card (At G L k r x):ℝ)=
      armFeature G L k x r.1*sideFeature G L k x r.2.1*sideFeature G L k x r.2.2 := by
  classical
  simp only [At,Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_side,armFeature]
  ring

lemma card_fiber (r : Roots (W:=W) k) :
    (Fintype.card (Fiber G L k r):ℝ)=
      ∑ x, armFeature G L k x r.1*sideFeature G L k x r.2.1*sideFeature G L k x r.2.2 := by
  classical
  simp only [Fiber,Fintype.card_sigma,Nat.cast_sum,card_at]

lemma arm_gram : armFeature G L k*(armFeature G L k).transpose=centralKernel G L k := by
  ext u v
  simpa only [Fintype.card_fin,armFeature,centralKernel] using
    ArmTensor.gram (LightArmKernel.matrix G L) (Fin k) u v

lemma end_gram : endFeature G L k*(endFeature G L k).transpose=endpointKernel G L k := by
  have hP : (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ := by
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  ext u v
  change (∑ r, endFeature G L k u r*endFeature G L k v r)=_
  simp only [endFeature]
  rw [ArmTensor.product_gram,arm_gram,hP]
  rfl

lemma side_gram : sideFeature G L k*(sideFeature G L k).transpose=
    ThreeHubKernel.chain (G.adjMatrix ℝ) (endpointKernel G L k) := by
  simp only [sideFeature,Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix,Matrix.mul_assoc]
  rw [←Matrix.mul_assoc (endFeature G L k),end_gram]
  simp only [ThreeHubKernel.chain,Matrix.mul_assoc]

open Classical in
lemma agreement_card : (Nat.card (Agreement G L k):ℝ)=
    energy (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G L k)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,card_fiber,Fintype.sum_prod_type]
  have h := ArmTensor.triple_mixed_total (armFeature G L k) (sideFeature G L k) (sideFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,side_gram]
  simp only [energy,pow_two,mul_assoc]

open Classical in
lemma pin_card (role : Full G L k → W) : (Nat.card (Pin G L k role):ℝ)=
    ∑ r, ∑ x, (Fintype.card (MarkFiber G L k role r x):ℝ)^2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (Erdos571.markedPairEquiv (Fiber G L k) role)]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,←pow_two,Nat.cast_pow]

def centerMarkEquiv (r : Roots (W:=W) k) (x : W) :
    MarkFiber G L k (center G L k) r x ≃ At G L k r x where
  toFun p := by
    rcases p with ⟨⟨y,a⟩,he⟩
    change y=x at he
    subst y
    exact a
  invFun a := ⟨⟨x,a⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨y,a⟩,he⟩
    change y=x at he
    subst y
    rfl
  right_inv _ := rfl

open Classical in
lemma center_pin_card : (Nat.card (Pin G L k (center G L k)):ℝ)=
    pin (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [pin_card]
  simp_rw [Fintype.card_congr (centerMarkEquiv G L k _ _),card_at]
  simp only [Fintype.sum_prod_type]
  have h := ArmTensor.triple_row_squares (armFeature G L k) (sideFeature G L k) (sideFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,side_gram]
  simp only [pin,pow_two,mul_assoc]

def leftMarkEquiv (r : Roots (W:=W) k) (u : W) :
    MarkFiber G L k (leftHub G L k) r u ≃
      ((x : W) × (Bundle G L k x r.1 ×
        (G.commonNeighbors x u × EndBundle G L k u r.2.1) × Side G L k x r.2.2)) where
  toFun p := by
    rcases p with ⟨⟨x,a,⟨v,h,b⟩,z⟩,he⟩
    change v=u at he
    subst v
    exact ⟨x,a,⟨h,b⟩,z⟩
  invFun p := ⟨⟨p.1,p.2.1,⟨u,p.2.2.1⟩,p.2.2.2⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,a,⟨v,h,b⟩,z⟩,he⟩
    change v=u at he
    subst v
    rfl
  right_inv _ := rfl

open Classical in
lemma leftMark_card (r : Roots (W:=W) k) (u : W) :
    (Fintype.card (MarkFiber G L k (leftHub G L k) r u):ℝ)=
      endFeature G L k u r.2.1*
        (∑ x, armFeature G L k x r.1*(G.adjMatrix ℝ * G.adjMatrix ℝ) x u*sideFeature G L k x r.2.2) := by
  rw [Fintype.card_congr (leftMarkEquiv G L k r u),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_endBundle,card_side]
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  simp only [←LayeredBush.adjacency_square_common_card]
  dsimp only [endFeature,armFeature]
  ring

open Classical in
lemma left_pin_card : (Nat.card (Pin G L k (leftHub G L k)):ℝ)=
    endpointPin (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [pin_card]
  simp_rw [leftMark_card]
  simp only [Fintype.sum_prod_type]
  have h := ArmTensor.marked_mixed_total (G.adjMatrix ℝ * G.adjMatrix ℝ)
    (armFeature G L k) (endFeature G L k) (sideFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,end_gram,side_gram]
  have hP : (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=G.adjMatrix ℝ * G.adjMatrix ℝ := by
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  rw [hP]
  rfl

def swapSides (p : Full G L k) : Full G L k :=
  ⟨⟨p.1.1,p.1.2.2,p.1.2.1⟩,p.2.1,p.2.2.1,p.2.2.2.2,p.2.2.2.1⟩

def endpointPinEquiv : Pin G L k (leftHub G L k) ≃ Pin G L k (rightHub G L k) where
  toFun p := ⟨⟨swapSides G L k p.1.1,swapSides G L k p.1.2⟩,
    congrArg (fun r : Roots (W:=W) k => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  invFun p := ⟨⟨swapSides G L k p.1.1,swapSides G L k p.1.2⟩,
    congrArg (fun r : Roots (W:=W) k => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma right_pin_card : (Nat.card (Pin G L k (rightHub G L k)):ℝ)=
    endpointPin (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [←Nat.card_congr (endpointPinEquiv G L k)]
  exact left_pin_card G L k

/-- Actual finite hub-pin cardinalities have the hybrid cubic coefficient.
This does not claim that all assignments are genuine copies. -/
theorem hub_pin_cubic (M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (role : Full G L k → W)
    (hrole : role=center G L k ∨ role=leftHub G L k ∨ role=rightHub G L k) :
    (Nat.card (Pin G L k role):ℝ)^3 ≤
      (2:ℝ)^k*(MatchedThreeHub.momentCoefficient (k+1) M*K^2)^(4*(k+1))*
        (Fintype.card W:ℝ)*d^(6*(k+1)+2)*(Nat.card (Agreement G L k):ℝ)^2 := by
  rw [agreement_card]
  apply MatchedThreeHub.free_hybrid_all_core_bound (k+1) M (by omega) G hf L d K
    hL hd hK hdK hmin hmax hcut
  rcases hrole with rfl|rfl|rfl
  · exact Or.inl (center_pin_card G L k)
  · exact Or.inr (Or.inl (left_pin_card G L k))
  · exact Or.inr (Or.inl (right_pin_card G L k))

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridAssignmentAbundance -/
/-! First-moment abundance and Cauchy lower energy for the same finite
hybrid assignments used in the sharp core-pin estimates. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin

lemma triple_first_mass {U I J R : Type} [Fintype U] [Fintype I] [Fintype J] [Fintype R]
    (F : Matrix U I ℝ) (B : Matrix U J ℝ) (C : Matrix U R ℝ) :
    (∑ r, ∑ t, ∑ a, ∑ u, F u r*B u t*C u a)=
      ∑ u, (∑ r, F u r)*(∑ t, B u t)*(∑ a, C u a) := by
  simp_rw [sum_comm (s:=(univ : Finset R)) (t:=(univ : Finset U))]
  simp_rw [sum_comm (s:=(univ : Finset J)) (t:=(univ : Finset U))]
  rw [sum_comm]
  apply sum_congr rfl
  intro u _
  simp only [←mul_sum,←sum_mul]

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

open Classical in
lemma full_card : (Nat.card (Full G L k):ℝ)=
    ∑ x, (∑ r, armFeature G L k x r)*(∑ r, sideFeature G L k x r)^2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  simp only [card_fiber,Fintype.sum_prod_type]
  have h := triple_first_mass (armFeature G L k) (sideFeature G L k) (sideFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h]
  exact sum_congr rfl (fun x _ => by ring)

lemma full_lower (d b : ℝ) (hd : 0 ≤ d) (hb : 0 ≤ b)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ))
    (hlight : ∀ u, b ≤ ∑ v, LightArmKernel.matrix G L u v) :
    (Fintype.card W:ℝ)*d^8*b^(3*k) ≤ (Nat.card (Full G L k):ℝ) := by
  let A := G.adjMatrix ℝ
  let P := A*A
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hrow (u : W) : d ≤ ∑ v, A u v := by
    have he : (∑ v, A u v)=(G.degree u:ℝ) := by
      simpa only [Matrix.mulVec,dotProduct,Function.const_apply,mul_one] using
        (G.adjMatrix_mulVec_const_apply (a := (1:ℝ)) (v := u))
    rw [he]
    exact hmin u
  have hP (u v : W) : 0 ≤ P u v := chain_nonneg hA hA u v
  have hProw (u : W) : d^2 ≤ ∑ v, P u v := by
    simpa only [pow_two] using chain_row_lower hA hd hrow hrow u
  have hF (u : W) : b^k ≤ ∑ r, armFeature G L k u r := by
    rw [armFeature,ArmTensor.row_sum,Fintype.card_fin]
    exact pow_le_pow_left₀ hb (hlight u) k
  have hEnd (u : W) : d^2*b^k ≤ ∑ r, endFeature G L k u r := by
    have he : (∑ r, endFeature G L k u r)=
        (∑ r, armFeature G L k u r)*(∑ v, P u v) := by
      simp only [endFeature,Fintype.sum_prod_type,mul_sum,sum_mul]
      rw [Finset.sum_comm]
    rw [he]
    have h := mul_le_mul (hF u) (hProw u) (sq_nonneg d)
      ((pow_nonneg hb k).trans (hF u))
    simpa only [mul_comm] using h
  have hSide (u : W) : d^4*b^k ≤ ∑ r, sideFeature G L k u r := by
    have h := chain_row_lower hP (mul_nonneg (sq_nonneg d) (pow_nonneg hb k)) hProw hEnd u
    convert h using 1 <;> ring
  rw [full_card]
  calc
    _ = ∑ _x : W, b^k*(d^4*b^k)^2 := by
      simp only [sum_const,card_univ,nsmul_eq_mul]
      rw [show 3*k=k*3 by omega,pow_mul]
      ring
    _ ≤ _ := sum_le_sum (fun u _ => mul_le_mul (hF u)
      (pow_le_pow_left₀ (by positivity) (hSide u) 2) (sq_nonneg _)
      ((pow_nonneg hb k).trans (hF u)))

open Classical in
lemma energy_cauchy : (Nat.card (Full G L k):ℝ)^2 ≤
    (Fintype.card W:ℝ)^(3*k+2)*(Nat.card (Agreement G L k):ℝ) := by
  have h := sq_sum_le_card_mul_sum_sq (s:=(univ : Finset (Roots (W:=W) k)))
    (f:=fun r => (Fintype.card (Fiber G L k r):ℝ))
  have hfull : (Nat.card (Full G L k):ℝ)=∑ r, (Fintype.card (Fiber G L k r):ℝ) := by
    rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  have hag : (Nat.card (Agreement G L k):ℝ)=∑ r, (Fintype.card (Fiber G L k r):ℝ)^2 := by
    rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G L k)),
      Fintype.card_sigma,Nat.cast_sum]
    simp only [Fintype.card_prod,Nat.cast_mul,pow_two]
  have hr : (Fintype.card (Roots (W:=W) k):ℝ)=(Fintype.card W:ℝ)^(3*k+2) := by
    simp only [Fintype.card_prod,Fintype.card_fun,Fintype.card_fin,Nat.cast_mul,Nat.cast_pow]
    simp only [←pow_succ,←pow_add]
    congr 1
    omega
  rw [hfull]
  rw [card_univ,hr,←hag] at h
  exact h

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridThreeHubHom -/
/-! The hybrid assignments are homomorphisms of an explicit matched
three-hub template. Freeness then gives the genuine homomorphism conflict
inequality; injectivity has not been assumed. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridThreeHub
open Finset SimpleGraph

def counts (k : ℕ) : Fin 3 → ℕ := ![k+1,k,k+1]
abbrev BaseRoot (k : ℕ) := BalancedTree.Leaf (counts k)
def base (k : ℕ) := BalancedTree.graph (counts k)
def template (k : ℕ) := RootedSubdivision.graph (base k)
def graph (k M : ℕ) := FullRootedPower.graph (template k) M

lemma counts_eq (k : ℕ) : MatchedThreeHub.counts (k+1)=counts k := by
  funext i
  rw [MatchedThreeHub.counts_eq (k+1) (by omega)]
  fin_cases i <;> simp [counts]

lemma free_of_matched {W : Type} (G : SimpleGraph W) (k M : ℕ)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G) : (graph k M).Free G := by
  change (FullRootedPower.graph (RootedSubdivision.graph
    (BalancedTree.graph (MatchedThreeHub.counts (k+1)))) M).Free G at hf
  rw [counts_eq k] at hf
  exact hf

end Erdos571.HybridThreeHub

namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

def hubValue (p : Full G L k) (i : Fin 3) : W :=
  if i=0 then leftHub G L k p else if i=1 then center G L k p else rightHub G L k p

def endLabel (r : EndLabels (W:=W) k) (i : Fin (k+1)) : W :=
  Fin.cases r.2 (fun j => r.1 j) i

def armWalk {u : W} {r : W} (a : MaskedBush.Arm G L u r) : G.commonNeighbors u r :=
  ⟨MaskedBush.middle G L a,MaskedBush.arm_left G L a,(MaskedBush.arm_right G L a).symm⟩

def endWalk {u : W} {r : EndLabels (W:=W) k} (b : EndBundle G L k u r)
    (i : Fin (k+1)) : G.commonNeighbors u (endLabel k r i) := by
  induction i using Fin.cases with
  | zero => exact b.2
  | succ j => exact armWalk G L (b.1 j)

def rootLabel (r : Roots (W:=W) k) : HybridThreeHub.BaseRoot k → W := by
  rintro ⟨i,j⟩
  revert j
  refine Fin.cases (fun j => endLabel k r.2.1 j) ?_ i
  intro i
  refine Fin.cases (fun j => r.1 j) ?_ i
  intro i
  refine Fin.cases (fun j => endLabel k r.2.2 j) ?_ i
  exact fun i => Fin.elim0 i

def rootWalk (p : Full G L k) (r : HybridThreeHub.BaseRoot k) :
    G.commonNeighbors (hubValue G L k p r.1) (rootLabel k p.1 r) := by
  rcases r with ⟨i,j⟩
  revert j
  refine Fin.cases ?_ ?_ i
  · intro j
    simpa [rootLabel,hubValue,leftHub] using endWalk G L k p.2.2.2.1.2.2 j
  intro i
  refine Fin.cases ?_ ?_ i
  · intro j
    simpa [rootLabel,hubValue,center] using armWalk G L (p.2.2.1 j)
  intro i
  refine Fin.cases ?_ ?_ i
  · intro j
    simpa [rootLabel,hubValue,rightHub] using endWalk G L k p.2.2.2.2.2.2 j
  exact fun i => Fin.elim0 i

def oldValue (p : Full G L k) : Fin 3⊕HybridThreeHub.BaseRoot k → W :=
  Sum.elim (hubValue G L k p) (rootLabel k p.1)

def coreMiddle (p : Full G L k) (i : Fin 2) : W :=
  if i=0 then p.2.2.2.1.2.1.val else p.2.2.2.2.2.1.val

def edgeIndexValue (p : Full G L k) : BalancedTree.EdgeIndex (HybridThreeHub.counts k) → W
  | .inl i => coreMiddle G L k p i
  | .inr r => (rootWalk G L k p r).val

noncomputable def edgeValue (p : Full G L k) (e : (HybridThreeHub.base k).edgeSet) : W :=
  edgeIndexValue G L k p ((BalancedTree.edgeEquiv (HybridThreeHub.counts k)).symm e)

lemma edgeValue_edge (p : Full G L k) (i : BalancedTree.EdgeIndex (HybridThreeHub.counts k)) :
    edgeValue G L k p (BalancedTree.edge i)=edgeIndexValue G L k p i := by
  unfold edgeValue
  exact congrArg (edgeIndexValue G L k p)
    ((BalancedTree.edgeEquiv (HybridThreeHub.counts k)).symm_apply_apply i)

lemma edgeIndex_incidence (p : Full G L k) (i : BalancedTree.EdgeIndex (HybridThreeHub.counts k))
    (v : Fin 3⊕HybridThreeHub.BaseRoot k) (hv : v∈(BalancedTree.edge i).val) :
    G.Adj (oldValue G L k p v) (edgeIndexValue G L k p i) := by
  rcases i with i|r
  · simp only [BalancedTree.edge,Sym2.mem_iff] at hv
    rcases hv with rfl|rfl
    · fin_cases i
      · simpa [oldValue,hubValue,leftHub,edgeIndexValue,coreMiddle] using p.2.2.2.1.2.1.property.2
      · simpa [oldValue,hubValue,center,edgeIndexValue,coreMiddle] using p.2.2.2.2.2.1.property.1
    · fin_cases i
      · simpa [oldValue,hubValue,center,edgeIndexValue,coreMiddle] using p.2.2.2.1.2.1.property.1
      · simpa [oldValue,hubValue,rightHub,edgeIndexValue,coreMiddle] using p.2.2.2.2.2.1.property.2
  · simp only [BalancedTree.edge,Sym2.mem_iff] at hv
    rcases hv with rfl|rfl
    · exact (rootWalk G L k p r).property.1
    · exact (rootWalk G L k p r).property.2

lemma edge_incidence (p : Full G L k) (e : (HybridThreeHub.base k).edgeSet)
    (v : Fin 3⊕HybridThreeHub.BaseRoot k) (hv : v∈e.val) :
    G.Adj (oldValue G L k p v) (edgeValue G L k p e) := by
  obtain ⟨i,rfl⟩ := BalancedTree.edge_surjective e
  rw [edgeValue_edge]
  exact edgeIndex_incidence G L k p i v hv

noncomputable def subdivisionHom (p : Full G L k) :
    ProjectionHeavy.subdivision (HybridThreeHub.base k) →g G where
  toFun := Sum.elim (oldValue G L k p) (edgeValue G L k p)
  map_rel' := by
    rintro (v|e) (w|f) h
    · exact h.elim
    · exact edge_incidence G L k p f v h
    · exact (edge_incidence G L k p e w h).symm
    · exact h.elim

noncomputable def hom (p : Full G L k) : HybridThreeHub.template k →g G :=
  (subdivisionHom G L k p).comp (RootedSubdivision.iso (HybridThreeHub.base k)).toHom

lemma hom_old (p : Full G L k) (v : Fin 3⊕HybridThreeHub.BaseRoot k) :
    hom G L k p (RootedSubdivision.old (HybridThreeHub.base k) v)=oldValue G L k p v := by
  change (subdivisionHom G L k p)
    (RootedSubdivision.vertexEquiv (HybridThreeHub.base k) (RootedSubdivision.old (HybridThreeHub.base k) v))=_
  rw [RootedSubdivision.vertexEquiv_apply,RootedSubdivision.toVertex_old]
  rfl

lemma hom_middle (p : Full G L k) (e : (HybridThreeHub.base k).edgeSet) :
    hom G L k p (RootedSubdivision.middle (HybridThreeHub.base k) e)=edgeValue G L k p e := by
  change (subdivisionHom G L k p)
    (RootedSubdivision.vertexEquiv (HybridThreeHub.base k) (RootedSubdivision.middle (HybridThreeHub.base k) e))=_
  rw [RootedSubdivision.vertexEquiv_apply,RootedSubdivision.toVertex_middle]
  rfl

lemma rootEdge_false (e : RootedSubdivision.RootEdge (HybridThreeHub.base k)) : False := by
  apply e.property
  obtain ⟨i,hi⟩ := BalancedTree.edge_surjective e.val
  rcases i with i|r
  · refine ⟨i.castSucc,by simp,?_⟩
    rw [←hi]
    simp [BalancedTree.edge]
  · refine ⟨r.1,by simp,?_⟩
    rw [←hi]
    simp [BalancedTree.edge]

lemma same_roots (p q : Full G L k) (hr : p.1=q.1)
    (r : RootedSubdivision.Root (HybridThreeHub.base k)) :
    hom G L k p (.inr r)=hom G L k q (.inr r) := by
  rcases r with r|e
  · change hom G L k p (RootedSubdivision.old (HybridThreeHub.base k) (.inr r)) =
      hom G L k q (RootedSubdivision.old (HybridThreeHub.base k) (.inr r))
    rw [hom_old,hom_old]
    change rootLabel k p.1 r=rootLabel k q.1 r
    rw [hr]
  · exact (rootEdge_false k e).elim

open Classical in
theorem freeness_pairs (M : ℕ) (hM : 2 ≤ M) (hf : (MatchedThreeHub.graph (k+1) M).Free G) :
    Nat.card (Agreement G L k) ≤ (M-1)*
      Nat.card {p : Full G L k×Full G L k //
        p.1.1=p.2.1 ∧ RootedHomEnergy.Conflict (hom G L k p.1) (hom G L k p.2)} := by
  have h := RootedHomEnergy.pair_bound (univ : Finset (Full G L k))
    (hom G L k) Sigma.fst (fun p _ q _ hr => same_roots G L k p q hr) M hM
    (HybridThreeHub.free_of_matched G k M hf)
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,PackingEnergy.fiberPairs,
    PackingEnergy.pairs,true_and,and_true,univ_product_univ] using h

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridCoreCollisions -/
/-! Algebraic bounds for three same-copy core collision patterns.
The quantities here are kernels; no finite-assignment identification or
injective-copy conclusion is asserted in this file. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridCoreCollisions
open Finset Matrix GramFeatures GramPin ThreeHubKernel MatchedThreeHubPin
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def adjacent (A B Z : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, (A*A) u u*(A*A) v v*Z u v*B u v*chain A B u v

noncomputable def opposite (A B Z : Matrix U U ℝ) : ℝ :=
  let P₂ := entryPower (A*A) 2
  ∑ u, ∑ v, (B u v)^2*(P₂*Z*P₂) u v

noncomputable def middles (A B Z : Matrix U U ℝ) : ℝ :=
  ∑ u, ∑ v, (A*Z*A) u v*((A*B*A) u v)^2

lemma conjugation_entry_cap (P Z : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (b D : ℝ) (hb : 0 ≤ b) (hD : 0 ≤ D)
    (hZ : ∀ u v, Z u v ≤ b) (hr : ∀ u, ∑ v, P u v ≤ D) (u v : U) :
    (P*Z*P) u v ≤ b*D^2 := by
  have hc (v : U) : ∑ w, P w v ≤ D := by
    simpa only [hs.apply v] using hr v
  have he : (P*Z*P) u v = ∑ i, ∑ j, P u i*Z i j*P j v := by
    simp only [Matrix.mul_apply,Finset.sum_mul]
    rw [Finset.sum_comm]
  rw [he]
  calc
    _ ≤ ∑ i, ∑ j, P u i*b*P j v :=
      sum_le_sum (fun i _ => sum_le_sum (fun j _ =>
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hZ i j) (hP u i)) (hP j v)))
    _ = b*(∑ i, P u i)*(∑ j, P j v) := by
      simp only [mul_sum,sum_mul]
      rw [Finset.sum_comm]
      exact sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => by ring))
    _ ≤ b*D*D := mul_le_mul (mul_le_mul_of_nonneg_left (hr u) hb) (hc v)
      (sum_nonneg (fun j _ => hP j v)) (mul_nonneg hb hD)
    _ = _ := by ring

lemma adjacent_le (A B Z : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (hZ : ∀ u v, 0 ≤ Z u v) (D b : ℝ) (hD : 0 ≤ D) (hb : 0 ≤ b)
    (hdiag : ∀ u, (A*A) u u ≤ D) (hcap : ∀ u v, Z u v ≤ b) :
    adjacent A B Z ≤ b*D^2*twoEnergy A B := by
  rw [twoEnergy_eq_inner A B hs,mul_sum]
  apply sum_le_sum
  intro u _
  rw [mul_sum]
  apply sum_le_sum
  intro v _
  have hP := chain_nonneg hA hA
  have hd := mul_le_mul (hdiag u) (hdiag v) (hP v v) hD
  have hz := mul_le_mul hd (hcap u v) (hZ u v) (mul_nonneg hD hD)
  have h := mul_le_mul_of_nonneg_right hz
    (mul_nonneg (hB u v) (chain_nonnegative A B hA hB u v))
  convert h using 1 <;> ring

lemma middles_le (A B Z : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (D b : ℝ) (hD : 0 ≤ D) (hb : 0 ≤ b)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hcap : ∀ u v, Z u v ≤ b) :
    middles A B Z ≤ b*D^2*twoEnergy A B := by
  simp only [middles,twoEnergy,squareMass,mul_sum]
  exact sum_le_sum (fun u _ => sum_le_sum (fun v _ =>
    mul_le_mul_of_nonneg_right
      (conjugation_entry_cap A Z hs hA b D hb hD hcap hrow u v) (sq_nonneg _)))

lemma chain_diagonal_lower (A B : Matrix U U ℝ)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (d : ℝ) (hd : 0 ≤ d) (hdiag : ∀ u, d ≤ (A*A) u u) (u v : U) :
    d^2*B u v ≤ chain A B u v := by
  have hP := chain_nonneg hA hA
  have hPB := chain_nonneg hP hB
  have h₁ : (A*A) u u*B u v ≤ ((A*A)*B) u v :=
    single_le_sum (fun i _ => mul_nonneg (hP u i) (hB i v)) (mem_univ u)
  have h₂ : ((A*A)*B) u v*(A*A) v v ≤ chain A B u v :=
    single_le_sum (fun i _ => mul_nonneg (hPB u i) (hP i v)) (mem_univ v)
  calc
    _ ≤ ((A*A) u u*(A*A) v v)*B u v :=
      mul_le_mul_of_nonneg_right (by
        simpa only [pow_two] using (mul_le_mul (hdiag u) (hdiag v) hd (hP u u))) (hB u v)
    _ = ((A*A) u u*B u v)*(A*A) v v := by ring
    _ ≤ ((A*A)*B) u v*(A*A) v v := mul_le_mul_of_nonneg_right h₁ (hP v v)
    _ ≤ _ := h₂

lemma squareMass_le_twoEnergy (A B : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (d : ℝ) (hd : 0 ≤ d) (hdiag : ∀ u, d ≤ (A*A) u u) :
    d^2*squareMass B ≤ twoEnergy A B := by
  rw [twoEnergy_eq_inner A B hs]
  simp only [squareMass,mul_sum]
  apply sum_le_sum
  intro u _
  apply sum_le_sum
  intro v _
  have h := mul_le_mul_of_nonneg_left (chain_diagonal_lower A B hA hB d hd hdiag u v) (hB u v)
  convert h using 1 <;> ring

lemma opposite_le (A B Z : Matrix U U ℝ) (hs : A.IsSymm)
    (T b : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T) (hcap : ∀ u v, Z u v ≤ b) :
    opposite A B Z ≤ b*T^2*squareMass B := by
  let P₂ := entryPower (A*A) 2
  have hP₂ : P₂.IsSymm := by
    apply Matrix.IsSymm.ext
    intro u v
    change ((A*A) v u)^2=((A*A) u v)^2
    congr 1
    have h : (A*A).IsSymm := by
      show (A*A).transpose=A*A
      rw [Matrix.transpose_mul,hs.eq]
    exact h.apply u v
  simp only [opposite,squareMass,mul_sum]
  exact sum_le_sum (fun u _ => sum_le_sum (fun v _ =>
    (mul_le_mul_of_nonneg_left
      (conjugation_entry_cap P₂ Z hP₂ (fun u v => sq_nonneg _) b T hb hT hcap hr u v)
      (sq_nonneg (B u v))).trans_eq (by ring)))

lemma opposite_mul_lower_le (A B Z : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hB : ∀ u v, 0 ≤ B u v)
    (T b d : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hd : 0 ≤ d)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T) (hcap : ∀ u v, Z u v ≤ b)
    (hdiag : ∀ u, d ≤ (A*A) u u) :
    d^2*opposite A B Z ≤ b*T^2*twoEnergy A B := by
  calc
    _ ≤ d^2*(b*T^2*squareMass B) :=
      mul_le_mul_of_nonneg_left (opposite_le A B Z hs T b hT hb hr hcap) (sq_nonneg d)
    _ = b*T^2*(d^2*squareMass B) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (squareMass_le_twoEnergy A B hs hA hB d hd hdiag)
      (mul_nonneg hb (sq_nonneg T))

end Erdos571.HybridCoreCollisions


/-! Supporting module: HybridDeletedMoments -/
/-! Deleted-arm interpolation for hybrid kernels. All moments and errors
use the same hybrid energy. These are algebraic estimates; assignment
identities for deletion are not asserted here. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridDeletedMoments
open Finset Matrix GramPin GramFeatures
variable {U : Type} [Fintype U] [DecidableEq U]

noncomputable def bundle (P R : Matrix U U ℝ) (k : ℕ) : Matrix U U ℝ :=
  fun u v => (R u v)^k*(P*P) u v
noncomputable def chain (P R : Matrix U U ℝ) (k : ℕ) : Matrix U U ℝ := P*bundle P R k*P
noncomputable def energy (P R : Matrix U U ℝ) (k : ℕ) : ℝ :=
  ∑ u, ∑ v, (R u v)^k*(chain P R k u v)^2
noncomputable def weightKernel (P R : Matrix U U ℝ) (k : ℕ) : Matrix U U ℝ :=
  fun u v => (R u v)^k*chain P R k u v
noncomputable def centerMoment (P R : Matrix U U ℝ) (k j : ℕ) : ℝ :=
  ∑ u, ∑ v, (R u v)^j*(chain P R k u v)^2
noncomputable def endpointMoment (P R : Matrix U U ℝ) (k j : ℕ) : ℝ :=
  ∑ u, ∑ v, (R u v)^k*chain P R k u v*chain P R j u v

lemma endpoint_as_moment (P R : Matrix U U ℝ) (hs : P.IsSymm) (k j : ℕ) :
    endpointMoment P R k j=WeightedPowerMoments.moment
      (fun p : U×U => (P*(weightKernel P R k)*P) p.1 p.2*(P*P) p.1 p.2)
      (fun p => R p.1 p.2) j := by
  have h := ThreeHubKernel.conjugation_inner_swap P
    (weightKernel P R k) (bundle P R j) hs
  change _=∑ p : U×U, _
  simp only [Fintype.sum_prod_type]
  change (∑ u, ∑ v, ((R u v)^k*chain P R k u v)*(P*bundle P R j*P) u v)=_
  change (∑ u, ∑ v, weightKernel P R k u v*(P*bundle P R j*P) u v)=_
  rw [h]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by dsimp [bundle]; ring))

lemma endpoint_self (P R : Matrix U U ℝ) (k : ℕ) : endpointMoment P R k k=energy P R k := by
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by ring))

lemma endpoint_interpolation (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : ∀ u v, 0 ≤ R u v) (k : ℕ) (hk : 1 ≤ k) :
    (endpointMoment P R k (k-1))^k ≤ endpointMoment P R k 0*(energy P R k)^(k-1) := by
  have hB (u v : U) : 0 ≤ bundle P R k u v :=
    mul_nonneg (pow_nonneg (hR u v) _) (chain_nonneg hP hP u v)
  have hC : ∀ u v, 0 ≤ chain P R k u v := chain_nonneg (chain_nonneg hP hB) hP
  have h := WeightedPowerMoments.interpolation_nonneg
    (fun p : U×U => (P*(weightKernel P R k)*P) p.1 p.2*(P*P) p.1 p.2)
    (fun p => R p.1 p.2)
    (fun p => mul_nonneg (chain_nonneg (chain_nonneg hP
      (fun u v => mul_nonneg (pow_nonneg (hR u v) _) (hC u v))) hP p.1 p.2)
      (chain_nonneg hP hP p.1 p.2))
    (fun p => hR p.1 p.2) k hk
  rw [←endpoint_as_moment P R hs,←endpoint_as_moment P R hs,←endpoint_as_moment P R hs,
    endpoint_self] at h
  exact h

lemma center_interpolation (P R : Matrix U U ℝ) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (hk : 1 ≤ k) :
    (centerMoment P R k (k-1))^k ≤ centerMoment P R k 0*(energy P R k)^(k-1) := by
  have h := WeightedPowerMoments.interpolation_nonneg
    (fun p : U×U => (chain P R k p.1 p.2)^2) (fun p => R p.1 p.2)
    (fun _ => sq_nonneg _) (fun p => hR p.1 p.2) k hk
  simpa only [WeightedPowerMoments.moment,Fintype.sum_prod_type,centerMoment,energy,mul_comm] using h

lemma total_conjugation_le (P B : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hB : ∀ u v, 0 ≤ B u v)
    (D : ℝ) (hD : 0 ≤ D) (hrow : ∀ u, ∑ v, P u v ≤ D) :
    (∑ u, ∑ v, (P*B*P) u v) ≤ D^2*(∑ u, ∑ v, B u v) := by
  have hc (v : U) : ∑ u, P u v ≤ D := by simpa only [hs.apply v] using hrow v
  have he : (∑ u, ∑ v, (P*B*P) u v) =
      ∑ x, ∑ y, (∑ u, P u x)*B x y*(∑ v, P y v) := by
    simp only [Matrix.mul_apply,mul_sum,sum_mul]
    conv_rhs => rw [sum_comm]
    conv_lhs => arg 2; ext u; rw [sum_comm]
    conv_lhs => arg 2; ext u; arg 2; ext y; rw [sum_comm]
    rw [sum_comm]
    apply sum_congr rfl
    intro y _
    rw [sum_comm]
    apply sum_congr rfl
    intro x _
    rw [sum_comm]
  rw [he,mul_sum]
  apply sum_le_sum
  intro u _
  rw [mul_sum]
  apply sum_le_sum
  intro v _
  have h := mul_le_mul (mul_le_mul_of_nonneg_right (hc u) (hB u v)) (hrow v)
    (sum_nonneg (fun w _ => hP v w)) (mul_nonneg hD (hB u v))
  exact h.trans_eq (by ring)

lemma bundle_mass_le (P R : Matrix U U ℝ)
    (hP : ∀ u v, 0 ≤ P u v) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, P u v ≤ D) (hcap : ∀ u v, R u v ≤ T) :
    (∑ u, ∑ v, bundle P R k u v) ≤ (Fintype.card U:ℝ)*D^2*T^k := by
  have hr (u : U) : ∑ v, (P*P) u v ≤ D^2 := by
    simpa only [pow_two] using chain_row_upper hP hD hrow hrow u
  calc
    _ ≤ ∑ u, T^k*∑ v, (P*P) u v := by
      simp only [mul_sum]
      exact sum_le_sum (fun u _ => sum_le_sum (fun v _ =>
        mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (hR u v) (hcap u v) k)
          (chain_nonneg hP hP u v)))
    _ ≤ ∑ _u : U, T^k*D^2 := sum_le_sum (fun u _ => mul_le_mul_of_nonneg_left (hr u) (pow_nonneg hT _))
    _ = _ := by simp only [sum_const,card_univ,nsmul_eq_mul]; ring

lemma bundle_cap (P R : Matrix U U ℝ)
    (hP : ∀ u v, 0 ≤ P u v) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (hQcap : ∀ u v, (P*P) u v ≤ T) (hcap : ∀ u v, R u v ≤ T) (u v : U) :
    bundle P R k u v ≤ T^(k+1) := by
  rw [pow_succ]
  exact mul_le_mul (pow_le_pow_left₀ (hR u v) (hcap u v) k) (hQcap u v)
    (chain_nonneg hP hP u v) (pow_nonneg hT _)

lemma center_zero_le (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, P u v ≤ D) (hQcap : ∀ u v, (P*P) u v ≤ T)
    (hcap : ∀ u v, R u v ≤ T) :
    centerMoment P R k 0 ≤ (Fintype.card U:ℝ)*D^6*T^(2*k+1) := by
  have hB (u v : U) : 0 ≤ bundle P R k u v :=
    mul_nonneg (pow_nonneg (hR u v) _) (chain_nonneg hP hP u v)
  have hm := bundle_mass_le P R hP hR k D T hD hT hrow hcap
  have hsB := squareMass_le_cap_mass (bundle P R k) hB (T^(k+1)) (bundle_cap P R hP hR k T hT hQcap hcap)
  have hconj := squareMass_conjugation_le P (bundle P R k) hs hP D hD hrow
  change (∑ u, ∑ v, (R u v)^0*(chain P R k u v)^2) ≤ _
  simp only [pow_zero,one_mul]
  change squareMass (P*bundle P R k*P) ≤ _
  calc
    _ ≤ D^4*squareMass (bundle P R k) := hconj
    _ ≤ D^4*(T^(k+1)*(∑ u, ∑ v, bundle P R k u v)) := mul_le_mul_of_nonneg_left hsB (pow_nonneg hD _)
    _ ≤ D^4*(T^(k+1)*((Fintype.card U:ℝ)*D^2*T^k)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hm (pow_nonneg hT _)) (pow_nonneg hD _)
    _ = _ := by rw [show 2*k+1=k+k+1 by omega]; simp only [pow_add,pow_one]; ring

lemma endpoint_zero_le (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, P u v ≤ D) (hQcap : ∀ u v, (P*P) u v ≤ T)
    (hcap : ∀ u v, R u v ≤ T) :
    endpointMoment P R k 0 ≤ (Fintype.card U:ℝ)*D^6*T^(2*k+1) := by
  have hB (u v : U) : 0 ≤ bundle P R k u v :=
    mul_nonneg (pow_nonneg (hR u v) _) (chain_nonneg hP hP u v)
  have hC : ∀ u v, 0 ≤ chain P R k u v := chain_nonneg (chain_nonneg hP hB) hP
  have hzero (u v : U) : chain P R 0 u v ≤ T*D^2 := by
    have he : bundle P R 0=P*P := by ext u v; simp [bundle]
    rw [chain,he]
    exact HybridCoreCollisions.conjugation_entry_cap P (P*P) hs hP T D hT hD hQcap hrow u v
  have hm := bundle_mass_le P R hP hR k D T hD hT hrow hcap
  have hc := total_conjugation_le P (bundle P R k) hs hP hB D hD hrow
  calc
    _ ≤ T^k*(T*D^2)*(∑ u, ∑ v, chain P R k u v) := by
      simp only [endpointMoment,mul_sum]
      exact sum_le_sum (fun u _ => sum_le_sum (fun v _ => by
        have h := mul_le_mul (pow_le_pow_left₀ (hR u v) (hcap u v) k) (hzero u v)
          (chain_nonneg (chain_nonneg hP (fun u v => by simp [bundle]; exact chain_nonneg hP hP u v)) hP u v)
          (pow_nonneg hT _)
        have h' := mul_le_mul_of_nonneg_right h (hC u v)
        convert h' using 1 <;> ring))
    _ ≤ T^k*(T*D^2)*(D^2*(∑ u, ∑ v, bundle P R k u v)) :=
      mul_le_mul_of_nonneg_left hc (by positivity)
    _ ≤ T^k*(T*D^2)*(D^2*((Fintype.card U:ℝ)*D^2*T^k)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hm (sq_nonneg D)) (by positivity)
    _ = _ := by rw [show 2*k+1=k+k+1 by omega]; simp only [pow_add,pow_one]; ring

/-- Both light-arm deletion moments obey one uniform absolute coefficient. -/
theorem deleted_le (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (hk : 1 ≤ k) (D T : ℝ) (hD : 0 ≤ D) (hT : 0 ≤ T)
    (hrow : ∀ u, ∑ v, P u v ≤ D) (hQcap : ∀ u v, (P*P) u v ≤ T)
    (hcap : ∀ u v, R u v ≤ T) (x : ℝ)
    (hx : x=centerMoment P R k (k-1) ∨ x=endpointMoment P R k (k-1)) :
    x^k ≤ (Fintype.card U:ℝ)*D^6*T^(2*k+1)*(energy P R k)^(k-1) := by
  have he : 0 ≤ energy P R k := sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
    mul_nonneg (pow_nonneg (hR u v) _) (sq_nonneg _)))
  rcases hx with rfl|rfl
  · exact (center_interpolation P R hR k hk).trans
      (mul_le_mul_of_nonneg_right (center_zero_le P R hs hP hR k D T hD hT hrow hQcap hcap) (pow_nonneg he _))
  · exact (endpoint_interpolation P R hs hP hR k hk).trans
      (mul_le_mul_of_nonneg_right (endpoint_zero_le P R hs hP hR k D T hD hT hrow hQcap hcap) (pow_nonneg he _))

end Erdos571.HybridDeletedMoments


/-! Supporting module: HybridMixedAssignments -/
/-! Independently indexed light bundles, each endpoint also having one full
arm. Deleting a light arm is expressed as an actual finite assignment family. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMixed
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev EndLabels (I : Type) := (I → W) × W
abbrev Roots (I J K : Type) := (I → W) × (EndLabels (W:=W) J × EndLabels (W:=W) K)
abbrev EndBundle (I : Type) (x : W) (r : EndLabels (W:=W) I) :=
  MaskedBush.Bundle G L I x r.1 × G.commonNeighbors x r.2
abbrev Side (I : Type) (x : W) (r : EndLabels (W:=W) I) :=
  (u : W) × (G.commonNeighbors x u × EndBundle G L I u r)
abbrev At (I J K : Type) (r : Roots (W:=W) I J K) (x : W) :=
  MaskedBush.Bundle G L I x r.1 × (Side G L J x r.2.1 × Side G L K x r.2.2)
abbrev Fiber (I J K : Type) (r : Roots (W:=W) I J K) := (x : W) × At G L I J K r x
abbrev Full (I J K : Type) := (r : Roots (W:=W) I J K) × Fiber G L I J K r
abbrev Agreement (I J K : Type) := FiberRestrictionEnergy.Agreement (Fiber G L I J K)

variable {I J K : Type} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

noncomputable instance sideFintype (x : W) (r : EndLabels (W:=W) I) : Fintype (Side G L I x r) := by
  classical
  infer_instance
noncomputable instance fiberFintype (r : Roots (W:=W) I J K) : Fintype (Fiber G L I J K r) := by
  classical
  infer_instance

noncomputable instance rootsDecidableEq : DecidableEq (Roots (W:=W) I J K) := by
  classical
  infer_instance
noncomputable instance fullFintype : Fintype (Full G L I J K) := by
  classical
  infer_instance

noncomputable def armFeature (I : Type) [Fintype I] [DecidableEq I] : Matrix W (I → W) ℝ :=
  ArmTensor.tensor (LightArmKernel.matrix G L) I
noncomputable def endFeature (I : Type) [Fintype I] [DecidableEq I] : Matrix W (EndLabels (W:=W) I) ℝ :=
  fun x r => armFeature G L I x r.1*(G.adjMatrix ℝ * G.adjMatrix ℝ) x r.2
noncomputable def sideFeature (I : Type) [Fintype I] [DecidableEq I] : Matrix W (EndLabels (W:=W) I) ℝ :=
  (G.adjMatrix ℝ * G.adjMatrix ℝ)*endFeature G L I

lemma card_side (x : W) (r : EndLabels (W:=W) I) :
    (Fintype.card (Side G L I x r):ℝ)=sideFeature G L I x r := by
  classical
  simp only [Side,EndBundle,Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,
    MaskedBush.card_bundle,sideFeature,Matrix.mul_apply,armFeature,endFeature,
    ←LayeredBush.adjacency_square_common_card]

lemma card_at (r : Roots (W:=W) I J K) (x : W) :
    (Fintype.card (At G L I J K r x):ℝ)=
      armFeature G L I x r.1*sideFeature G L J x r.2.1*sideFeature G L K x r.2.2 := by
  classical
  simp only [At,Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_side,armFeature]
  ring

lemma card_fiber (r : Roots (W:=W) I J K) :
    (Fintype.card (Fiber G L I J K r):ℝ)=
      ∑ x, armFeature G L I x r.1*sideFeature G L J x r.2.1*sideFeature G L K x r.2.2 := by
  classical
  simp only [Fiber,Fintype.card_sigma,Nat.cast_sum,card_at]

lemma arm_gram (I : Type) [Fintype I] [DecidableEq I] : armFeature G L I*(armFeature G L I).transpose =
    entryPower (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card I) := by
  ext u v
  exact ArmTensor.gram (LightArmKernel.matrix G L) I u v

lemma end_gram (I : Type) [Fintype I] [DecidableEq I] : endFeature G L I*(endFeature G L I).transpose =
    HybridDeletedMoments.bundle (G.adjMatrix ℝ * G.adjMatrix ℝ)
      (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card I) := by
  ext u v
  have h := ArmTensor.product_gram (armFeature G L I) (G.adjMatrix ℝ * G.adjMatrix ℝ) u v
  rw [arm_gram] at h
  simpa only [endFeature,HybridDeletedMoments.bundle,Matrix.transpose_mul,
    SimpleGraph.transpose_adjMatrix,entryPower] using h

lemma side_gram (I : Type) [Fintype I] [DecidableEq I] : sideFeature G L I*(sideFeature G L I).transpose =
    HybridDeletedMoments.chain (G.adjMatrix ℝ * G.adjMatrix ℝ)
      (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) (Fintype.card I) := by
  simp only [sideFeature,Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix,Matrix.mul_assoc]
  rw [←Matrix.mul_assoc (endFeature G L I),end_gram]
  simp only [HybridDeletedMoments.chain,Matrix.mul_assoc]

open Classical in
lemma agreement_card (I J K : Type) [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K] :
    (Nat.card (Agreement G L I J K):ℝ)=
      let P := G.adjMatrix ℝ * G.adjMatrix ℝ
      let N := LightArmKernel.matrix G L
      let R := N*N.transpose
      ∑ u, ∑ v, R u v^(Fintype.card I)*
        HybridDeletedMoments.chain P R (Fintype.card J) u v*
        HybridDeletedMoments.chain P R (Fintype.card K) u v := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G L I J K)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,card_fiber,Fintype.sum_prod_type]
  have h := ArmTensor.triple_mixed_total (armFeature G L I) (sideFeature G L J) (sideFeature G L K)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,side_gram,side_gram]
  simp only [entryPower,pow_two]

lemma central_deleted_card (k : ℕ) (i : Fin k) :
    (Nat.card (Agreement G L (MaskedBush.Without i) (Fin k) (Fin k)):ℝ)=
      HybridDeletedMoments.centerMoment (G.adjMatrix ℝ * G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k (k-1) := by
  rw [agreement_card]
  simp only [MaskedBush.card_without,Fintype.card_fin,HybridDeletedMoments.centerMoment,pow_two,mul_assoc]

lemma left_deleted_card (k : ℕ) (i : Fin k) :
    (Nat.card (Agreement G L (Fin k) (MaskedBush.Without i) (Fin k)):ℝ)=
      HybridDeletedMoments.endpointMoment (G.adjMatrix ℝ * G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k (k-1) := by
  rw [agreement_card]
  simp only [MaskedBush.card_without,Fintype.card_fin,HybridDeletedMoments.endpointMoment]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by ring))

lemma right_deleted_card (k : ℕ) (i : Fin k) :
    (Nat.card (Agreement G L (Fin k) (Fin k) (MaskedBush.Without i)):ℝ)=
      HybridDeletedMoments.endpointMoment (G.adjMatrix ℝ * G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k (k-1) := by
  rw [agreement_card]
  simp only [MaskedBush.card_without,Fintype.card_fin,HybridDeletedMoments.endpointMoment]

lemma symmetric_agreement (k : ℕ) : Agreement G L (Fin k) (Fin k) (Fin k)=HybridThreeHubAssignments.Agreement G L k := rfl

lemma symmetric_energy (k : ℕ) :
    (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)=
      HybridDeletedMoments.energy (G.adjMatrix ℝ * G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k := by
  rw [←symmetric_agreement,agreement_card]
  simp only [Fintype.card_fin,HybridDeletedMoments.energy,pow_two,mul_assoc]

end Erdos571.HybridMixed


/-! Supporting module: HybridArmDeletion -/
/-! Deleting one terminal arm preserves the remaining labels and all core
roles. A deleted arm is reconstructed from its root and middle values. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMixed
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

def center (p : Full G L I J K) : W := p.2.1
def leftHub (p : Full G L I J K) : W := p.2.2.2.1.1
def rightHub (p : Full G L I J K) : W := p.2.2.2.2.1
def leftCoreMiddle (p : Full G L I J K) : W := p.2.2.2.1.2.1.val
def rightCoreMiddle (p : Full G L I J K) : W := p.2.2.2.2.2.1.val
def centralRoot (p : Full G L I J K) (i : I) : W := p.1.1 i
def centralMiddle (p : Full G L I J K) (i : I) : W := MaskedBush.middle G L (p.2.2.1 i)
lemma central_hub_adj_middle (p : Full G L I J K) (i : I) :
    G.Adj (center G L p) (centralMiddle G L p i) := MaskedBush.arm_left G L (p.2.2.1 i)
lemma central_middle_adj_root (p : Full G L I J K) (i : I) :
    G.Adj (centralMiddle G L p i) (centralRoot G L p i) := MaskedBush.arm_right G L (p.2.2.1 i)
lemma central_light (p : Full G L I J K) (i : I) :
    MaskedBush.Light G L (center G L p) (centralRoot G L p i) := MaskedBush.arm_light G L (p.2.2.1 i)

def leftRoot (p : Full G L I J K) (i : J) : W := p.1.2.1.1 i
def leftMiddle (p : Full G L I J K) (i : J) : W := MaskedBush.middle G L (p.2.2.2.1.2.2.1 i)
lemma left_hub_adj_middle (p : Full G L I J K) (i : J) :
    G.Adj (leftHub G L p) (leftMiddle G L p i) := MaskedBush.arm_left G L (p.2.2.2.1.2.2.1 i)
lemma left_middle_adj_root (p : Full G L I J K) (i : J) :
    G.Adj (leftMiddle G L p i) (leftRoot G L p i) := MaskedBush.arm_right G L (p.2.2.2.1.2.2.1 i)
lemma left_light (p : Full G L I J K) (i : J) :
    MaskedBush.Light G L (leftHub G L p) (leftRoot G L p i) := MaskedBush.arm_light G L (p.2.2.2.1.2.2.1 i)

def rightRoot (p : Full G L I J K) (i : K) : W := p.1.2.2.1 i
def rightMiddle (p : Full G L I J K) (i : K) : W := MaskedBush.middle G L (p.2.2.2.2.2.2.1 i)
lemma right_hub_adj_middle (p : Full G L I J K) (i : K) :
    G.Adj (rightHub G L p) (rightMiddle G L p i) := MaskedBush.arm_left G L (p.2.2.2.2.2.2.1 i)
lemma right_middle_adj_root (p : Full G L I J K) (i : K) :
    G.Adj (rightMiddle G L p i) (rightRoot G L p i) := MaskedBush.arm_right G L (p.2.2.2.2.2.2.1 i)
lemma right_light (p : Full G L I J K) (i : K) :
    MaskedBush.Light G L (rightHub G L p) (rightRoot G L p i) := MaskedBush.arm_light G L (p.2.2.2.2.2.2.1 i)

def leftFullMiddle (p : Full G L I J K) : W := p.2.2.2.1.2.2.2.val
def rightFullMiddle (p : Full G L I J K) : W := p.2.2.2.2.2.2.2.val

lemma full_ext (p q : Full G L I J K) (hr : p.1=q.1)
    (hc : center G L p=center G L q)
    (hl : leftHub G L p=leftHub G L q) (hh : rightHub G L p=rightHub G L q)
    (hcl : leftCoreMiddle G L p=leftCoreMiddle G L q)
    (hcr : rightCoreMiddle G L p=rightCoreMiddle G L q)
    (hmc : ∀ i, centralMiddle G L p i=centralMiddle G L q i)
    (hml : ∀ i, leftMiddle G L p i=leftMiddle G L q i)
    (hmr : ∀ i, rightMiddle G L p i=rightMiddle G L q i)
    (hfl : leftFullMiddle G L p=leftFullMiddle G L q)
    (hfr : rightFullMiddle G L p=rightFullMiddle G L q) : p=q := by
  rcases p with ⟨⟨r,t,a⟩,x,b,⟨u,cm,c,cf⟩,⟨v,dm,e,ef⟩⟩
  rcases q with ⟨⟨r',t',a'⟩,x',b',⟨u',cm',c',cf'⟩,⟨v',dm',e',ef'⟩⟩
  obtain ⟨rfl,hrr⟩ := Prod.mk.inj hr
  obtain ⟨rfl,rfl⟩ := Prod.mk.inj hrr
  change x=x' at hc
  change u=u' at hl
  change v=v' at hh
  subst x'; subst u'; subst v'
  have hb : b=b' := by funext i; exact MaskedBush.arm_ext G L _ _ (hmc i)
  have hc : c=c' := by funext i; exact MaskedBush.arm_ext G L _ _ (hml i)
  have he : e=e' := by funext i; exact MaskedBush.arm_ext G L _ _ (hmr i)
  have hcm : cm=cm' := Subtype.ext hcl
  have hdm : dm=dm' := Subtype.ext hcr
  have hcf : cf=cf' := Subtype.ext hfl
  have hef : ef=ef' := Subtype.ext hfr
  subst b'; subst c'; subst e'; subst cm'; subst dm'; subst cf'; subst ef'
  rfl

def deleteCentral (i : I) (p : Full G L I J K) : Full G L (MaskedBush.Without i) J K :=
  ⟨(fun k => p.1.1 k.val,p.1.2),p.2.1,(fun k => p.2.2.1 k.val),p.2.2.2⟩

lemma deleteCentral_labels (i : I) (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteCentral G L i p).1=(deleteCentral G L i q).1 :=
  congrArg (fun r : Roots (W := W) I J K => (fun k : MaskedBush.Without i => r.1 k.val,r.2)) hr

lemma deleteCentral_restore (i : I) (p q : Full G L I J K)
    (he : deleteCentral G L i p=deleteCentral G L i q)
    (hr : centralRoot G L p i=centralRoot G L q i)
    (hm : centralMiddle G L p i=centralMiddle G L q i) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · funext k
      by_cases hk : k=i
      · subst k; exact hr
      · exact congrArg (fun r : Roots (W := W) (MaskedBush.Without i) J K => r.1 ⟨k,hk⟩) hlabel
    · apply Prod.ext
      · exact congrArg (fun r : Roots (W := W) (MaskedBush.Without i) J K => r.2.1) hlabel
      · exact congrArg (fun r : Roots (W := W) (MaskedBush.Without i) J K => r.2.2) hlabel
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => center G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftHub G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightHub G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftCoreMiddle G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightCoreMiddle G L t) he
  · intro k
    by_cases hk : k=i
    · subst k; exact hm
    · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => centralMiddle G L t ⟨k,hk⟩) he
  · intro k; exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftMiddle G L t k) he
  · intro k; exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightMiddle G L t k) he

  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => leftFullMiddle G L t) he
  · exact congrArg (fun t : Full G L (MaskedBush.Without i) J K => rightFullMiddle G L t) he

def deleteLeft (i : J) (p : Full G L I J K) : Full G L I (MaskedBush.Without i) K :=
  ⟨(p.1.1,((fun k => p.1.2.1.1 k.val,p.1.2.1.2),p.1.2.2)),p.2.1,p.2.2.1,
    ⟨p.2.2.2.1.1,p.2.2.2.1.2.1,(fun k => p.2.2.2.1.2.2.1 k.val),p.2.2.2.1.2.2.2⟩,p.2.2.2.2⟩

lemma deleteLeft_labels (i : J) (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteLeft G L i p).1=(deleteLeft G L i q).1 :=
  congrArg (fun r : Roots (W := W) I J K => (r.1,((fun k : MaskedBush.Without i => r.2.1.1 k.val,r.2.1.2),r.2.2))) hr

lemma deleteLeft_restore (i : J) (p q : Full G L I J K)
    (he : deleteLeft G L i p=deleteLeft G L i q)
    (hr : leftRoot G L p i=leftRoot G L q i)
    (hm : leftMiddle G L p i=leftMiddle G L q i) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.1) hlabel
    · apply Prod.ext
      · apply Prod.ext
        · funext k
          by_cases hk : k=i
          · subst k; exact hr
          · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.2.1.1 ⟨k,hk⟩) hlabel
        · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.2.1.2) hlabel
      · exact congrArg (fun r : Roots (W := W) I (MaskedBush.Without i) K => r.2.2) hlabel
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => center G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftHub G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightHub G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftCoreMiddle G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightCoreMiddle G L t) he
  · intro k; exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => centralMiddle G L t k) he
  · intro k
    by_cases hk : k=i
    · subst k; exact hm
    · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftMiddle G L t ⟨k,hk⟩) he
  · intro k; exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightMiddle G L t k) he

  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => leftFullMiddle G L t) he
  · exact congrArg (fun t : Full G L I (MaskedBush.Without i) K => rightFullMiddle G L t) he

def deleteRight (i : K) (p : Full G L I J K) : Full G L I J (MaskedBush.Without i) :=
  ⟨(p.1.1,(p.1.2.1,(fun k => p.1.2.2.1 k.val,p.1.2.2.2))),p.2.1,p.2.2.1,p.2.2.2.1,
    ⟨p.2.2.2.2.1,p.2.2.2.2.2.1,(fun k => p.2.2.2.2.2.2.1 k.val),p.2.2.2.2.2.2.2⟩⟩

lemma deleteRight_labels (i : K) (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteRight G L i p).1=(deleteRight G L i q).1 :=
  congrArg (fun r : Roots (W := W) I J K => (r.1,(r.2.1,(fun k : MaskedBush.Without i => r.2.2.1 k.val,r.2.2.2)))) hr

lemma deleteRight_restore (i : K) (p q : Full G L I J K)
    (he : deleteRight G L i p=deleteRight G L i q)
    (hr : rightRoot G L p i=rightRoot G L q i)
    (hm : rightMiddle G L p i=rightMiddle G L q i) : p=q := by
  have hlabel := congrArg Sigma.fst he
  apply full_ext G L p q
  · apply Prod.ext
    · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.1) hlabel
    · apply Prod.ext
      · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.2.1) hlabel
      · apply Prod.ext
        · funext k
          by_cases hk : k=i
          · subst k; exact hr
          · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.2.2.1 ⟨k,hk⟩) hlabel
        · exact congrArg (fun r : Roots (W := W) I J (MaskedBush.Without i) => r.2.2.2) hlabel
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => center G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftHub G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightHub G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftCoreMiddle G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightCoreMiddle G L t) he
  · intro k; exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => centralMiddle G L t k) he
  · intro k; exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftMiddle G L t k) he
  · intro k
    by_cases hk : k=i
    · subst k; exact hm
    · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightMiddle G L t ⟨k,hk⟩) he

  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => leftFullMiddle G L t) he
  · exact congrArg (fun t : Full G L I J (MaskedBush.Without i) => rightFullMiddle G L t) he

end Erdos571.HybridMixed


/-! Supporting module: HybridTerminalDeletion -/
/-! Terminal pins and retained-data root collisions for each three-hub
bundle, via actual one-arm deletion maps. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMixed
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

abbrev Pin (role : Full G L I J K → W) := RestrictionDeletion.RolePin (Fiber G L I J K) role

def centralDeletion (i : I) : ArmDeletion.Data G L (Fiber G L I J K)
    (Fiber G L (MaskedBush.Without i) J K) where
  delete := deleteCentral G L i
  root := fun p => centralRoot G L p i
  hub := center G L
  arm := fun p => p.2.2.1 i
  labels := deleteCentral_labels G L i
  roots := fun p q hr => congrArg (fun r : Roots (W := W) I J K => r.1 i) hr
  restore := deleteCentral_restore G L i

/-- The central terminal pin reduces to its hub pin and its deleted agreement. -/
theorem central_terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : I) :
    Nat.card (Pin G L (fun p : Full G L I J K => centralMiddle G L p i)) ≤ (k-1)*
      (Nat.card (Pin G L (center G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (Agreement G L (MaskedBush.Without i) J K)) :=
  ArmDeletion.terminal_pin_bound (centralDeletion G L i) H k cap Δ hk hH hdeg hlight

/-- The removed central root may be any function of retained data. -/
theorem central_prescribed_root_bound (i : I) (kept : Full G L (MaskedBush.Without i) J K → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => centralRoot G L p i=kept (deleteCentral G L i p))) ≤
        cap^2*Nat.card (Agreement G L (MaskedBush.Without i) J K) :=
  ArmDeletion.prescribed_root_bound (centralDeletion G L i) kept cap hL hcap

def leftDeletion (i : J) : ArmDeletion.Data G L (Fiber G L I J K)
    (Fiber G L I (MaskedBush.Without i) K) where
  delete := deleteLeft G L i
  root := fun p => leftRoot G L p i
  hub := leftHub G L
  arm := fun p => p.2.2.2.1.2.2.1 i
  labels := deleteLeft_labels G L i
  roots := fun p q hr => congrArg (fun r : Roots (W := W) I J K => r.2.1.1 i) hr
  restore := deleteLeft_restore G L i

/-- The left terminal pin reduces to its hub pin and its deleted agreement. -/
theorem left_terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : J) :
    Nat.card (Pin G L (fun p : Full G L I J K => leftMiddle G L p i)) ≤ (k-1)*
      (Nat.card (Pin G L (leftHub G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (Agreement G L I (MaskedBush.Without i) K)) :=
  ArmDeletion.terminal_pin_bound (leftDeletion G L i) H k cap Δ hk hH hdeg hlight

/-- The removed left root may be any function of retained data. -/
theorem left_prescribed_root_bound (i : J) (kept : Full G L I (MaskedBush.Without i) K → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => leftRoot G L p i=kept (deleteLeft G L i p))) ≤
        cap^2*Nat.card (Agreement G L I (MaskedBush.Without i) K) :=
  ArmDeletion.prescribed_root_bound (leftDeletion G L i) kept cap hL hcap

def rightDeletion (i : K) : ArmDeletion.Data G L (Fiber G L I J K)
    (Fiber G L I J (MaskedBush.Without i)) where
  delete := deleteRight G L i
  root := fun p => rightRoot G L p i
  hub := rightHub G L
  arm := fun p => p.2.2.2.2.2.2.1 i
  labels := deleteRight_labels G L i
  roots := fun p q hr => congrArg (fun r : Roots (W := W) I J K => r.2.2.1 i) hr
  restore := deleteRight_restore G L i

/-- The right terminal pin reduces to its hub pin and its deleted agreement. -/
theorem right_terminal_pin_bound (H : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hH : H.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (i : K) :
    Nat.card (Pin G L (fun p : Full G L I J K => rightMiddle G L p i)) ≤ (k-1)*
      (Nat.card (Pin G L (rightHub G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (Agreement G L I J (MaskedBush.Without i))) :=
  ArmDeletion.terminal_pin_bound (rightDeletion G L i) H k cap Δ hk hH hdeg hlight

/-- The removed right root may be any function of retained data. -/
theorem right_prescribed_root_bound (i : K) (kept : Full G L I J (MaskedBush.Without i) → W)
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => rightRoot G L p i=kept (deleteRight G L i p))) ≤
        cap^2*Nat.card (Agreement G L I J (MaskedBush.Without i)) :=
  ArmDeletion.prescribed_root_bound (rightDeletion G L i) kept cap hL hcap

end Erdos571.HybridMixed


/-! Supporting module: HybridMiddleDeletion -/
/-! Same-copy terminal collisions with any retained role in the mixed
three-hub assignment family. -/
namespace Erdos571.HybridMixed
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {I J K : Type} [Fintype I] [Fintype J] [Fintype K]
  [DecidableEq I] [DecidableEq J] [DecidableEq K]

theorem central_prescribed_middle_bound (i : I) (kept : Full G L (MaskedBush.Without i) J K → W)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => centralMiddle G L p i=kept (deleteCentral G L i p))) ≤
      (k-1)*(Nat.card (Pin G L (kept ∘ deleteCentral G L i)) +
        cap*Nat.card (Agreement G L (MaskedBush.Without i) J K)) :=
  ArmDeletion.prescribed_middle_bound (centralDeletion G L i) kept H k cap hk hH hlight

theorem left_prescribed_middle_bound (i : J) (kept : Full G L I (MaskedBush.Without i) K → W)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => leftMiddle G L p i=kept (deleteLeft G L i p))) ≤
      (k-1)*(Nat.card (Pin G L (kept ∘ deleteLeft G L i)) +
        cap*Nat.card (Agreement G L I (MaskedBush.Without i) K)) :=
  ArmDeletion.prescribed_middle_bound (leftDeletion G L i) kept H k cap hk hH hlight

theorem right_prescribed_middle_bound (i : K) (kept : Full G L I J (MaskedBush.Without i) → W)
    (H : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => rightMiddle G L p i=kept (deleteRight G L i p))) ≤
      (k-1)*(Nat.card (Pin G L (kept ∘ deleteRight G L i)) +
        cap*Nat.card (Agreement G L I J (MaskedBush.Without i))) :=
  ArmDeletion.prescribed_middle_bound (rightDeletion G L i) kept H k cap hk hH hlight

end Erdos571.HybridMixed


/-! Supporting module: TwoStepArmDeletion -/
/-! Terminal pins and prescribed-middle collisions need an actual two-edge
arm, but do not require that the arm itself has been trimmed. -/
set_option maxHeartbeats 3000000
namespace Erdos571.TwoStepArmDeletion
open Finset SimpleGraph
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable (G : SimpleGraph W) [DecidableRel G.Adj]
variable (F : R → Type) (E : S → Type) [∀ r, Fintype (F r)] [∀ s, Fintype (E s)]

structure Data where
  delete : Sigma F → Sigma E
  root : Sigma F → W
  middle : Sigma F → W
  hub : Sigma E → W
  left : ∀ p, G.Adj (hub (delete p)) (middle p)
  right : ∀ p, G.Adj (middle p) (root p)
  labels : ∀ p q, p.1=q.1 → (delete p).1=(delete q).1
  roots : ∀ p q, p.1=q.1 → root p=root q
  restore : ∀ p q, delete p=delete q → root p=root q → middle p=middle q → p=q

variable {G F E}
variable (D : Data G F E)

def hub (p : Sigma F) : W := D.hub (D.delete p)

theorem terminal_pin_bound (K : SimpleGraph W) (k cap Δ : ℕ)
    (hk : 2 ≤ k) (hK : K.CliqueFree k) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (RestrictionDeletion.RolePin F D.middle) ≤ (k-1)*
      (Nat.card (RestrictionDeletion.RolePin F (hub D)) +
        (cap*Δ)*Nat.card (FiberRestrictionEnergy.Agreement E)) := by
  classical
  let F' := MarkedFiberFamily.Fiber F D.middle
  let e := MarkedFiberFamily.forget F D.middle
  have hlabel (p q : Sigma F') (h : p.1=q.1) : (e p).1=(e q).1 :=
    MarkedFiberFamily.labels_eq F D.middle p q h
  have hl := LightPairDeletion.two_step_pair_bound G F' E
    (D.delete ∘ e) (D.middle ∘ e) (D.root ∘ e) (hub D ∘ e) D.hub cap Δ hdeg
    (fun p q h => D.labels _ _ (hlabel p q h))
    (MarkedFiberFamily.marks_eq F D.middle)
    (fun p q h => D.roots _ _ (hlabel p q h))
    (fun _ => rfl) (fun p => D.left (e p)) (fun p => D.right (e p))
    (fun p q hd hm hr => (MarkedFiberFamily.forget_injective F D.middle)
      (D.restore (e p) (e q) hd hr hm))
  have hs := HeavyFiberRestriction.family_split F' K (hub D ∘ e) k hk hK
    (fun u v => Fintype.card (G.commonNeighbors u v) ≤ cap) hlight
  have hp := MarkedFiberFamily.pin_le F D.middle (hub D)
  have he := MarkedFiberFamily.agreement_card F D.middle
  simp only [←Nat.card_eq_fintype_card] at hl hs
  rw [he] at hs
  exact hs.trans (Nat.mul_le_mul_left _ (Nat.add_le_add hp hl))

theorem prescribed_middle_bound (kept : Sigma E → W)
    (K : SimpleGraph W) (k cap : ℕ) (hk : 2 ≤ k) (hK : K.CliqueFree k)
    (hlight : ∀ u v, ¬K.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both F (fun p => D.middle p=kept (D.delete p))) ≤
      (k-1)*(Nat.card (RestrictionDeletion.RolePin F (kept ∘ D.delete)) +
        cap*Nat.card (FiberRestrictionEnergy.Agreement E)) := by
  apply RestrictionDeletion.collision_bound F
    (fun p => D.middle p=kept (D.delete p)) E G K k cap hk hK hlight
    D.delete D.root (kept ∘ D.delete) kept D.labels D.roots (fun _ _ => rfl)
  · intro p hp
    change G.Adj (kept (D.delete p)) (D.root p)
    rw [←hp]
    exact D.right p
  · intro p q hp hq hd hr
    apply D.restore p q hd hr
    exact hp.trans ((congrArg kept hd).trans hq.symm)

end Erdos571.TwoStepArmDeletion


/-! Supporting module: HybridDeletedGraph -/
/-! Actual matched-template freeness bounds every light-arm-deleted agreement
of the hybrid family. No lower degree or injectivity hypothesis is needed. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMixed
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

lemma free_deleted_moment_bound (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G) (D : ℝ) (hD : 0 ≤ D)
    (hmax : ∀ u, (G.degree u:ℝ) ≤ D) (x : ℝ)
    (hx : x=HybridDeletedMoments.centerMoment (G.adjMatrix ℝ * G.adjMatrix ℝ)
      (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k (k-1) ∨
      x=HybridDeletedMoments.endpointMoment (G.adjMatrix ℝ * G.adjMatrix ℝ)
      (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k (k-1)) :
    x^k ≤ (Fintype.card W:ℝ)*D^12*(MatchedThreeHub.momentCoefficient (k+1) M*D^2)^(2*k+1)*
      (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)^(k-1) := by
  let A := G.adjMatrix ℝ
  let P := A*A
  let N := LightArmKernel.matrix G L
  let T := MatchedThreeHub.momentCoefficient (k+1) M*D^2
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hP : ∀ u v, 0 ≤ P u v := chain_nonneg hA hA
  have hs : P.IsSymm := by
    show (A*A).transpose=_
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  have hrowA (u : W) : ∑ v, A u v ≤ D := by
    rw [ThreeHubKernel.adjacency_row_sum]
    exact hmax u
  have hrowP (u : W) : ∑ v, P u v ≤ D^2 := by
    simpa only [P,pow_two] using chain_row_upper hA hD hrowA hrowA u
  have hT : 0 ≤ T := mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg _ _) (sq_nonneg D)
  have hrow (u : W) : ∑ v, (P u v)^2 ≤ T :=
    MatchedThreeHub.free_fourth_row_bound (k+1) M G hf D hD hmax u
  have hQcap (u v : W) : (P*P) u v ≤ T :=
    (LayeredBush.fourth_entries_of_row_bound G T hT hrow u v).2
  have h := HybridDeletedMoments.deleted_le P (N*N.transpose) hs hP
    (LightArmKernel.gram_nonneg G L) k hk (D^2) T (sq_nonneg D) hT hrowP hQcap
    (LightArmKernel.gram_upper G L T hT hrow) x hx
  rw [symmetric_energy]
  convert h using 1 <;> simp only [P,A,T,pow_mul]; ring

/-- The common absolute bound for all three possible light-arm deletions. -/
theorem all_deleted_bound (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G) (D : ℝ) (hD : 0 ≤ D)
    (hmax : ∀ u, (G.degree u:ℝ) ≤ D) (i : Fin k) (x : ℝ)
    (hx : x=(Nat.card (Agreement G L (MaskedBush.Without i) (Fin k) (Fin k)):ℝ) ∨
      x=(Nat.card (Agreement G L (Fin k) (MaskedBush.Without i) (Fin k)):ℝ) ∨
      x=(Nat.card (Agreement G L (Fin k) (Fin k) (MaskedBush.Without i)):ℝ)) :
    x^k ≤ (Fintype.card W:ℝ)*D^12*(MatchedThreeHub.momentCoefficient (k+1) M*D^2)^(2*k+1)*
      (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)^(k-1) := by
  apply free_deleted_moment_bound G L k M hk hf D hD hmax x
  rcases hx with rfl|rfl|rfl
  · exact Or.inl (central_deleted_card G L k i)
  · exact Or.inr (left_deleted_card G L k i)
  · exact Or.inr (right_deleted_card G L k i)

end Erdos571.HybridMixed


/-! Supporting module: HybridFullArmDeletion -/
/-! Deleting an untrimmed endpoint arm. The exact deleted agreement is
pointwise dominated by a light-arm-deleted moment; the two energies are
not identified. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMixed
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev BareRoots (I J K : Type) := (I → W) × ((J → W) × EndLabels (W:=W) K)
abbrev BareAt (I J K : Type) (r : BareRoots (W:=W) I J K) (x : W) :=
  MaskedBush.Bundle G L I x r.1 × (ThreeHubMixed.Side G L J x r.2.1 × Side G L K x r.2.2)
abbrev BareFiber (I J K : Type) (r : BareRoots (W:=W) I J K) := (x : W) × BareAt G L I J K r x
abbrev BareFull (I J K : Type) := (r : BareRoots (W:=W) I J K) × BareFiber G L I J K r
abbrev BareAgreement (I J K : Type) := FiberRestrictionEnergy.Agreement (BareFiber G L I J K)

variable {I J K : Type} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

noncomputable instance bareFiberFintype (r : BareRoots (W:=W) I J K) : Fintype (BareFiber G L I J K r) := by
  classical
  infer_instance
noncomputable instance bareFullFintype : Fintype (BareFull G L I J K) := by
  classical
  infer_instance
noncomputable instance bareRootsDecidableEq : DecidableEq (BareRoots (W:=W) I J K) := by
  classical
  infer_instance

lemma bare_fiber_card (r : BareRoots (W:=W) I J K) :
    (Fintype.card (BareFiber G L I J K r):ℝ)=
      ∑ x, armFeature G L I x r.1*ThreeHubMixed.sideFeature G L J x r.2.1*sideFeature G L K x r.2.2 := by
  classical
  rw [Fintype.card_sigma,Nat.cast_sum]
  apply sum_congr rfl
  intro x _
  simp only [BareAt,Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,ThreeHubMixed.card_side,card_side,armFeature]
  ring

lemma bare_agreement_card (I J K : Type) [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K] :
    (Nat.card (BareAgreement G L I J K):ℝ)=
      let A := G.adjMatrix ℝ
      let N := LightArmKernel.matrix G L
      let R := N*N.transpose
      ∑ u, ∑ v, R u v^(Fintype.card I)*
        ThreeHubKernel.chain A (entryPower R (Fintype.card J)) u v*
        HybridDeletedMoments.chain (A*A) R (Fintype.card K) u v := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (BareFiber G L I J K)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,bare_fiber_card,Fintype.sum_prod_type]
  have h := ArmTensor.triple_mixed_total (armFeature G L I) (ThreeHubMixed.sideFeature G L J) (sideFeature G L K)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,ThreeHubMixed.side_gram,side_gram]
  simp only [entryPower,pow_two]

/-- Removing the untrimmed left arm costs no more energy than removing a
light left arm, when there is at least one such light arm. -/
lemma bare_agreement_le (k : ℕ) (hk : 1 ≤ k) :
    (Nat.card (BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ) ≤
      HybridDeletedMoments.endpointMoment (G.adjMatrix ℝ * G.adjMatrix ℝ)
        (LightArmKernel.matrix G L*(LightArmKernel.matrix G L).transpose) k (k-1) := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let R := N*N.transpose
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hP := chain_nonneg hA hA
  have hR : ∀ u v, 0 ≤ R u v := LightArmKernel.gram_nonneg G L
  have hQ (u v : W) : R u v ≤ ((A*A)*(A*A)) u v := by
    simpa only [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix] using LightArmKernel.gram_le_fourth G L u v
  have hB (u v : W) : entryPower R k u v ≤ HybridDeletedMoments.bundle (A*A) R (k-1) u v := by
    change (R u v)^k ≤ (R u v)^(k-1)*((A*A)*(A*A)) u v
    have he : k=k-1+1 := by omega
    conv_lhs => rw [he,pow_succ]
    exact mul_le_mul_of_nonneg_left (hQ u v) (pow_nonneg (hR u v) _)
  have hchain (u v : W) : ThreeHubKernel.chain A (entryPower R k) u v ≤
      HybridDeletedMoments.chain (A*A) R (k-1) u v := by
    simp only [ThreeHubKernel.chain,HybridDeletedMoments.chain,Matrix.mul_apply]
    apply sum_le_sum
    intro x _
    apply mul_le_mul_of_nonneg_right _ (hP x v)
    apply sum_le_sum
    intro y _
    exact mul_le_mul_of_nonneg_left (hB y x) (hP u y)
  rw [bare_agreement_card]
  simp only [Fintype.card_fin,HybridDeletedMoments.endpointMoment]
  apply sum_le_sum
  intro u _
  apply sum_le_sum
  intro v _
  have hn : 0 ≤ HybridDeletedMoments.chain (A*A) R k u v :=
    chain_nonneg (chain_nonneg hP (fun u v => mul_nonneg (pow_nonneg (hR u v) _)
      (chain_nonneg hP hP u v))) hP u v
  have h := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left (hchain u v) (pow_nonneg (hR u v) k)) hn
  exact h.trans_eq (by ring)

def bareLeftHub (p : BareFull G L I J K) : W := p.2.2.2.1.1

def deleteLeftFull (p : Full G L I J K) : BareFull G L I J K :=
  ⟨(p.1.1,(p.1.2.1.1,p.1.2.2)),p.2.1,p.2.2.1,
    ⟨p.2.2.2.1.1,p.2.2.2.1.2.1,p.2.2.2.1.2.2.1⟩,p.2.2.2.2⟩

lemma deleteLeftFull_labels (p q : Full G L I J K) (hr : p.1=q.1) :
    (deleteLeftFull G L p).1=(deleteLeftFull G L q).1 :=
  congrArg (fun r : Roots (W:=W) I J K => (r.1,(r.2.1.1,r.2.2))) hr

lemma deleteLeftFull_restore (p q : Full G L I J K)
    (he : deleteLeftFull G L p=deleteLeftFull G L q)
    (hr : p.1.2.1.2=q.1.2.1.2) (hm : leftFullMiddle G L p=leftFullMiddle G L q) : p=q := by
  apply full_ext G L p q
  · have hlabel := congrArg Sigma.fst he
    apply Prod.ext
    · exact congrArg (fun r : BareRoots (W:=W) I J K => r.1) hlabel
    · apply Prod.ext
      · exact Prod.ext (congrArg (fun r : BareRoots (W:=W) I J K => r.2.1) hlabel) hr
      · exact congrArg (fun r : BareRoots (W:=W) I J K => r.2.2) hlabel
  · exact congrArg (fun p : BareFull G L I J K => p.2.1) he
  · exact congrArg (bareLeftHub G L) he
  · exact congrArg (fun p : BareFull G L I J K => p.2.2.2.2.1) he
  · exact congrArg (fun p : BareFull G L I J K => p.2.2.2.1.2.1.val) he
  · exact congrArg (fun p : BareFull G L I J K => p.2.2.2.2.2.1.val) he
  · intro i; exact congrArg (fun p : BareFull G L I J K => MaskedBush.middle G L (p.2.2.1 i)) he
  · intro i; exact congrArg (fun p : BareFull G L I J K => MaskedBush.middle G L (p.2.2.2.1.2.2 i)) he
  · intro i; exact congrArg (fun p : BareFull G L I J K => MaskedBush.middle G L (p.2.2.2.2.2.2.1 i)) he
  · exact hm
  · exact congrArg (fun p : BareFull G L I J K => p.2.2.2.2.2.2.2.val) he

def leftFullDeletion : TwoStepArmDeletion.Data G (Fiber G L I J K) (BareFiber G L I J K) where
  delete := deleteLeftFull G L
  root := fun p => p.1.2.1.2
  middle := leftFullMiddle G L
  hub := bareLeftHub G L
  left := fun p => p.2.2.2.1.2.2.2.property.1
  right := fun p => p.2.2.2.1.2.2.2.property.2.symm
  labels := deleteLeftFull_labels G L
  roots := fun _ _ hr => congrArg (fun r : Roots (W:=W) I J K => r.2.1.2) hr
  restore := deleteLeftFull_restore G L

theorem left_full_terminal_bound (H : SimpleGraph W) (t cap Δ : ℕ)
    (ht : 2 ≤ t) (hH : H.CliqueFree t) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (Pin G L (leftFullMiddle G L : Full G L I J K → W)) ≤ (t-1)*
      (Nat.card (Pin G L (leftHub G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (BareAgreement G L I J K)) :=
  TwoStepArmDeletion.terminal_pin_bound (leftFullDeletion G L) H t cap Δ ht hH hdeg hlight

theorem left_full_middle_bound (kept : BareFull G L I J K → W)
    (H : SimpleGraph W) (t cap : ℕ) (ht : 2 ≤ t) (hH : H.CliqueFree t)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => leftFullMiddle G L p=kept (deleteLeftFull G L p))) ≤
      (t-1)*(Nat.card (Pin G L (kept ∘ deleteLeftFull G L)) +
        cap*Nat.card (BareAgreement G L I J K)) :=
  TwoStepArmDeletion.prescribed_middle_bound (leftFullDeletion G L) kept H t cap ht hH hlight

def swap (p : Full G L I J K) : Full G L I K J :=
  ⟨(p.1.1,(p.1.2.2,p.1.2.1)),p.2.1,p.2.2.1,p.2.2.2.2,p.2.2.2.1⟩

lemma swap_swap (p : Full G L I J K) : swap G L (swap G L p)=p := by
  rcases p with ⟨⟨r,t,a⟩,x,b,left,right⟩
  rfl

lemma swap_injective : Function.Injective (swap G L : Full G L I J K → Full G L I K J) := by
  intro p q h
  simpa only [swap_swap] using congrArg (swap G L) h

def deleteRightFull (p : Full G L I J K) : BareFull G L I K J := deleteLeftFull G L (swap G L p)

def rightFullDeletion : TwoStepArmDeletion.Data G (Fiber G L I J K) (BareFiber G L I K J) where
  delete := deleteRightFull G L
  root := fun p => p.1.2.2.2
  middle := rightFullMiddle G L
  hub := bareLeftHub G L
  left := fun p => p.2.2.2.2.2.2.2.property.1
  right := fun p => p.2.2.2.2.2.2.2.property.2.symm
  labels := fun _ _ hr => congrArg (fun r : Roots (W:=W) I J K => (r.1,(r.2.2.1,r.2.1))) hr
  roots := fun _ _ hr => congrArg (fun r : Roots (W:=W) I J K => r.2.2.2) hr
  restore := fun p q he hr hm => swap_injective G L (deleteLeftFull_restore G L _ _ he hr hm)

theorem right_full_terminal_bound (H : SimpleGraph W) (t cap Δ : ℕ)
    (ht : 2 ≤ t) (hH : H.CliqueFree t) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (Pin G L (rightFullMiddle G L : Full G L I J K → W)) ≤ (t-1)*
      (Nat.card (Pin G L (rightHub G L : Full G L I J K → W)) +
        (cap*Δ)*Nat.card (BareAgreement G L I K J)) :=
  TwoStepArmDeletion.terminal_pin_bound (rightFullDeletion G L) H t cap Δ ht hH hdeg hlight

theorem right_full_middle_bound (kept : BareFull G L I K J → W)
    (H : SimpleGraph W) (t cap : ℕ) (ht : 2 ≤ t) (hH : H.CliqueFree t)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap) :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L I J K)
      (fun p => rightFullMiddle G L p=kept (deleteRightFull G L p))) ≤
      (t-1)*(Nat.card (Pin G L (kept ∘ deleteRightFull G L)) +
        cap*Nat.card (BareAgreement G L I K J)) :=
  TwoStepArmDeletion.prescribed_middle_bound (rightFullDeletion G L) kept H t cap ht hH hlight

/-- The same absolute deleted-moment bound also covers deletion of a full arm. -/
theorem bare_deleted_bound (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G) (D : ℝ) (hD : 0 ≤ D)
    (hmax : ∀ u, (G.degree u:ℝ) ≤ D) :
    (Nat.card (BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ)^k ≤
      (Fintype.card W:ℝ)*D^12*(MatchedThreeHub.momentCoefficient (k+1) M*D^2)^(2*k+1)*
        (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)^(k-1) := by
  exact (pow_le_pow_left₀ (Nat.cast_nonneg _) (bare_agreement_le G L k hk) k).trans
    (free_deleted_moment_bound G L k M hk hf D hD hmax _ (Or.inr rfl))

end Erdos571.HybridMixed


/-! Supporting module: HybridRoleIndex -/
/-! Explicit roles for the hybrid template: five core vertices, 3k light
terminal middles and roots, and two full terminal middles and roots. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRoles
open Finset SimpleGraph

abbrev LightArm (k : ℕ) := Fin 3 × Fin k
abbrev Arm (k : ℕ) := LightArm k ⊕ Fin 2
abbrev Core := Fin 3 ⊕ Fin 2
abbrev Interior (k : ℕ) := Core ⊕ Arm k
abbrev Vertex (k : ℕ) := Interior k ⊕ Arm k

variable (k : ℕ)

def baseToArm : HybridThreeHub.BaseRoot k → Arm k := by
  rintro ⟨i,j⟩
  revert j
  refine Fin.cases (fun j => Fin.cases (.inr 0) (fun a => .inl (0,a)) j) ?_ i
  intro i
  refine Fin.cases (fun j => .inl (1,j)) ?_ i
  intro i
  refine Fin.cases (fun j => Fin.cases (.inr 1) (fun a => .inl (2,a)) j) ?_ i
  exact fun i => Fin.elim0 i

def armToBase : Arm k → HybridThreeHub.BaseRoot k := by
  rintro (⟨i,j⟩|i)
  · refine Fin.cases ⟨0,j.succ⟩ ?_ i
    intro i
    refine Fin.cases ⟨1,j⟩ ?_ i
    intro i
    exact Fin.cases ⟨2,j.succ⟩ (fun i => Fin.elim0 i) i
  · exact Fin.cases ⟨0,(0 : Fin (k+1))⟩ (fun i => Fin.cases ⟨2,(0 : Fin (k+1))⟩ (fun i => Fin.elim0 i) i) i

def rootEquiv : HybridThreeHub.BaseRoot k ≃ Arm k where
  toFun := baseToArm k
  invFun := armToBase k
  left_inv r := by
    rcases r with ⟨i,j⟩
    fin_cases i
    · induction j using Fin.cases with
      | zero => rfl
      | succ j => rfl
    · rfl
    · induction j using Fin.cases with
      | zero => rfl
      | succ j => rfl
  right_inv r := by
    rcases r with ⟨i,j⟩|i
    · fin_cases i <;> rfl
    · fin_cases i <;> rfl

noncomputable def petalIndex (e : RootedSubdivision.Petal (HybridThreeHub.base k)) : Fin 2 ⊕ Arm k :=
  Sum.map id (rootEquiv k) ((BalancedTree.edgeEquiv (HybridThreeHub.counts k)).symm e.val)

lemma petalIndex_injective : Function.Injective (petalIndex k) :=
  (Sum.map_injective.mpr ⟨Function.injective_id,(rootEquiv k).injective⟩).comp
    ((BalancedTree.edgeEquiv (HybridThreeHub.counts k)).symm.injective.comp Subtype.val_injective)

noncomputable def interiorIndex (a : RootedSubdivision.Nonroot (HybridThreeHub.base k)) : Interior k :=
  (Equiv.sumAssoc (Fin 3) (Fin 2) (Arm k)).symm (Sum.map id (petalIndex k) a)

lemma interiorIndex_injective : Function.Injective (interiorIndex k) :=
  (Equiv.sumAssoc (Fin 3) (Fin 2) (Arm k)).symm.injective.comp
    (Sum.map_injective.mpr ⟨Function.injective_id,petalIndex_injective k⟩)

def rootIndex (r : RootedSubdivision.Root (HybridThreeHub.base k)) : Arm k :=
  match r with
  | .inl r => rootEquiv k r
  | .inr e => False.elim (HybridThreeHubAssignments.rootEdge_false k e)

lemma rootIndex_injective : Function.Injective (rootIndex k) := by
  rintro (r|e) (t|f) he
  · exact congrArg Sum.inl ((rootEquiv k).injective he)
  · exact (HybridThreeHubAssignments.rootEdge_false k f).elim
  · exact (HybridThreeHubAssignments.rootEdge_false k e).elim
  · exact (HybridThreeHubAssignments.rootEdge_false k e).elim

noncomputable def vertexIndex : RootedSubdivision.Vertex (HybridThreeHub.base k) → Vertex k :=
  Sum.map (interiorIndex k) (rootIndex k)

lemma vertexIndex_injective : Function.Injective (vertexIndex k) :=
  Sum.map_injective.mpr ⟨interiorIndex_injective k,rootIndex_injective k⟩

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

abbrev Full := HybridThreeHubAssignments.Full G L k

def coreValue (p : Full k G L) : Core → W :=
  Sum.elim (HybridThreeHubAssignments.hubValue G L k p) (HybridThreeHubAssignments.coreMiddle G L k p)

def terminalValue (p : Full k G L) (r : Arm k) : W :=
  (HybridThreeHubAssignments.rootWalk G L k p ((rootEquiv k).symm r)).val

def rootValue (p : Full k G L) (r : Arm k) : W :=
  HybridThreeHubAssignments.rootLabel k p.1 ((rootEquiv k).symm r)

def interiorValue (p : Full k G L) : Interior k → W :=
  Sum.elim (coreValue k G L p) (terminalValue k G L p)

def value (p : Full k G L) : Vertex k → W :=
  Sum.elim (interiorValue k G L p) (rootValue k G L p)

lemma hom_value (p : Full k G L) (v : RootedSubdivision.Vertex (HybridThreeHub.base k)) :
    HybridThreeHubAssignments.hom G L k p v=value k G L p (vertexIndex k v) := by
  rcases v with (a|e)|(r|e)
  · exact HybridThreeHubAssignments.hom_old G L k p (.inl a)
  · have h := HybridThreeHubAssignments.hom_middle G L k p e.val
    rw [RootedSubdivision.middle_petal] at h
    rw [h]
    unfold HybridThreeHubAssignments.edgeValue
    generalize hi : (BalancedTree.edgeEquiv (HybridThreeHub.counts k)).symm e.val=i
    cases i with
    | inl i => simp [value,vertexIndex,interiorIndex,petalIndex,hi,Sum.map_inr,
        Sum.map_inl,id_eq,Equiv.sumAssoc,interiorValue,coreValue,
        Sum.elim_inl,HybridThreeHubAssignments.edgeIndexValue]
    | inr r =>
      simp only [value,vertexIndex,interiorIndex,petalIndex,hi,Sum.map_inr,
        Sum.map_inl,id_eq,Equiv.sumAssoc,interiorValue,terminalValue,
        Sum.elim_inl,Sum.elim_inr,HybridThreeHubAssignments.edgeIndexValue]
      exact congrArg (fun r => (HybridThreeHubAssignments.rootWalk G L k p r).val)
        ((rootEquiv k).symm_apply_apply r).symm
  · have h := HybridThreeHubAssignments.hom_old G L k p (.inr r)
    simpa only [value,vertexIndex,rootIndex,Sum.map_inr,Sum.elim_inr,rootValue,
      Equiv.symm_apply_apply] using h
  · exact (HybridThreeHubAssignments.rootEdge_false k e).elim

end Erdos571.HybridRoles


/-! Supporting module: HybridRoleValues -/
/-! Explicit comparisons between role-index evaluations and the finite
mixed-family coordinates used by the deletion bounds. -/
namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

@[simp] lemma hub_zero (p : Full k G L) :
    HybridThreeHubAssignments.hubValue G L k p 0=HybridMixed.leftHub G L p := rfl
@[simp] lemma hub_one (p : Full k G L) :
    HybridThreeHubAssignments.hubValue G L k p 1=HybridMixed.center G L p := rfl
@[simp] lemma hub_two (p : Full k G L) :
    HybridThreeHubAssignments.hubValue G L k p 2=HybridMixed.rightHub G L p := rfl
@[simp] lemma coreMiddle_zero (p : Full k G L) :
    HybridThreeHubAssignments.coreMiddle G L k p 0=HybridMixed.leftCoreMiddle G L p := rfl
@[simp] lemma coreMiddle_one (p : Full k G L) :
    HybridThreeHubAssignments.coreMiddle G L k p 1=HybridMixed.rightCoreMiddle G L p := rfl
@[simp] lemma root_zero (p : Full k G L) (i : Fin k) :
    rootValue k G L p (.inl (0,i))=HybridMixed.leftRoot G L p i := rfl
@[simp] lemma root_one (p : Full k G L) (i : Fin k) :
    rootValue k G L p (.inl (1,i))=HybridMixed.centralRoot G L p i := rfl
@[simp] lemma root_two (p : Full k G L) (i : Fin k) :
    rootValue k G L p (.inl (2,i))=HybridMixed.rightRoot G L p i := rfl
@[simp] lemma terminal_zero (p : Full k G L) (i : Fin k) :
    terminalValue k G L p (.inl (0,i))=HybridMixed.leftMiddle G L p i := rfl
@[simp] lemma terminal_one (p : Full k G L) (i : Fin k) :
    terminalValue k G L p (.inl (1,i))=HybridMixed.centralMiddle G L p i := rfl
@[simp] lemma terminal_two (p : Full k G L) (i : Fin k) :
    terminalValue k G L p (.inl (2,i))=HybridMixed.rightMiddle G L p i := rfl

@[simp] lemma root_full_left (p : Full k G L) : rootValue k G L p (.inr 0)=p.1.2.1.2 := rfl
@[simp] lemma root_full_right (p : Full k G L) : rootValue k G L p (.inr 1)=p.1.2.2.2 := rfl
@[simp] lemma terminal_full_left (p : Full k G L) :
    terminalValue k G L p (.inr 0)=HybridMixed.leftFullMiddle G L p := rfl
@[simp] lemma terminal_full_right (p : Full k G L) :
    terminalValue k G L p (.inr 1)=HybridMixed.rightFullMiddle G L p := rfl

end Erdos571.HybridRoles


/-! Supporting module: HybridDeletionWitness -/
/-! Every hybrid terminal arm has an actual deletion witness preserving all
other roles. Light arms additionally retain their light-pair certificate. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmDeletion
variable {W R S : Type} [Fintype W] [DecidableEq W] [Fintype R] [Fintype S]
variable {G : SimpleGraph W} [DecidableRel G.Adj] {L : ℝ}
variable {F : R → Type} {E : S → Type} [∀ r, Fintype (F r)] [∀ s, Fintype (E s)]

def Data.toTwoStep (D : Data G L F E) : TwoStepArmDeletion.Data G F E where
  delete := D.delete
  root := D.root
  middle := D.middle
  hub := D.hub
  left := fun p => MaskedBush.arm_left G L (D.arm p)
  right := fun p => MaskedBush.arm_right G L (D.arm p)
  labels := D.labels
  roots := D.roots
  restore := D.restore
end Erdos571.ArmDeletion

namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

def hubIndex (r : Arm k) : Fin 3 := ((rootEquiv k).symm r).1

structure DeletionWitness (r : Arm k) where
  S : Type
  finS : Fintype S
  E : S → Type
  finE : ∀ x, Fintype (E x)
  data : TwoStepArmDeletion.Data G (HybridThreeHubAssignments.Fiber G L k) E
  root_eq : ∀ p, data.root p=rootValue k G L p r
  middle_eq : ∀ p, data.middle p=terminalValue k G L p r
  hub_eq : ∀ p, TwoStepArmDeletion.hub data p=coreValue k G L p (.inl (hubIndex k r))
  light : ∀ a : LightArm k, r=.inl a → ∀ p,
    MaskedBush.Light G L (TwoStepArmDeletion.hub data p) (data.root p)
  core_retained : ∀ c : Core, ∃ kept : Sigma E → W,
    ∀ p, coreValue k G L p c=kept (data.delete p)
  root_retained : ∀ t : Arm k, t≠r → ∃ kept : Sigma E → W,
    ∀ p, rootValue k G L p t=kept (data.delete p)
  terminal_retained : ∀ t : Arm k, t≠r → ∃ kept : Sigma E → W,
    ∀ p, terminalValue k G L p t=kept (data.delete p)

noncomputable def leftWitness (i : Fin k) : DeletionWitness k G L (.inl (0,i)) := by
  classical
  refine
    { S := HybridMixed.Roots (W := W) (Fin k) (MaskedBush.Without i) (Fin k)
      finS := inferInstance
      E := HybridMixed.Fiber G L (Fin k) (MaskedBush.Without i) (Fin k)
      finE := fun _ => inferInstance
      data := (HybridMixed.leftDeletion G L i).toTwoStep
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      light := ?_
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · intro a ha p
    exact MaskedBush.arm_light G L (p.2.2.2.1.2.2.1 i)
  · rintro (j|j)
    · fin_cases j
      · exact ⟨HybridMixed.leftHub G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.center G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightHub G L,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨HybridMixed.leftCoreMiddle G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightCoreMiddle G L,fun _ => rfl⟩
  · rintro (⟨j,l⟩|j) ht
    · fin_cases j
      · have hk : l≠i := fun he => ht (congrArg Sum.inl (Prod.ext rfl he))
        exact ⟨fun p => HybridMixed.leftRoot G L p ⟨l,hk⟩,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.centralRoot G L p l,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.rightRoot G L p l,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.1.2.1.2,fun _ => rfl⟩
      · exact ⟨fun p => p.1.2.2.2,fun _ => rfl⟩
  · rintro (⟨j,l⟩|j) ht
    · fin_cases j
      · have hk : l≠i := fun he => ht (congrArg Sum.inl (Prod.ext rfl he))
        exact ⟨fun p => HybridMixed.leftMiddle G L p ⟨l,hk⟩,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.centralMiddle G L p l,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.rightMiddle G L p l,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨HybridMixed.leftFullMiddle G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightFullMiddle G L,fun _ => rfl⟩

noncomputable def centralWitness (i : Fin k) : DeletionWitness k G L (.inl (1,i)) := by
  classical
  refine
    { S := HybridMixed.Roots (W := W) (MaskedBush.Without i) (Fin k) (Fin k)
      finS := inferInstance
      E := HybridMixed.Fiber G L (MaskedBush.Without i) (Fin k) (Fin k)
      finE := fun _ => inferInstance
      data := (HybridMixed.centralDeletion G L i).toTwoStep
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      light := ?_
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · intro a ha p
    exact MaskedBush.arm_light G L (p.2.2.1 i)
  · rintro (j|j)
    · fin_cases j
      · exact ⟨HybridMixed.leftHub G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.center G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightHub G L,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨HybridMixed.leftCoreMiddle G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightCoreMiddle G L,fun _ => rfl⟩
  · rintro (⟨j,l⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => HybridMixed.leftRoot G L p l,fun _ => rfl⟩
      · have hk : l≠i := fun he => ht (congrArg Sum.inl (Prod.ext rfl he))
        exact ⟨fun p => HybridMixed.centralRoot G L p ⟨l,hk⟩,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.rightRoot G L p l,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.1.2.1.2,fun _ => rfl⟩
      · exact ⟨fun p => p.1.2.2.2,fun _ => rfl⟩
  · rintro (⟨j,l⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => HybridMixed.leftMiddle G L p l,fun _ => rfl⟩
      · have hk : l≠i := fun he => ht (congrArg Sum.inl (Prod.ext rfl he))
        exact ⟨fun p => HybridMixed.centralMiddle G L p ⟨l,hk⟩,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.rightMiddle G L p l,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨HybridMixed.leftFullMiddle G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightFullMiddle G L,fun _ => rfl⟩

noncomputable def rightWitness (i : Fin k) : DeletionWitness k G L (.inl (2,i)) := by
  classical
  refine
    { S := HybridMixed.Roots (W := W) (Fin k) (Fin k) (MaskedBush.Without i)
      finS := inferInstance
      E := HybridMixed.Fiber G L (Fin k) (Fin k) (MaskedBush.Without i)
      finE := fun _ => inferInstance
      data := (HybridMixed.rightDeletion G L i).toTwoStep
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      light := ?_
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · intro a ha p
    exact MaskedBush.arm_light G L (p.2.2.2.2.2.2.1 i)
  · rintro (j|j)
    · fin_cases j
      · exact ⟨HybridMixed.leftHub G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.center G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightHub G L,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨HybridMixed.leftCoreMiddle G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightCoreMiddle G L,fun _ => rfl⟩
  · rintro (⟨j,l⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => HybridMixed.leftRoot G L p l,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.centralRoot G L p l,fun _ => rfl⟩
      · have hk : l≠i := fun he => ht (congrArg Sum.inl (Prod.ext rfl he))
        exact ⟨fun p => HybridMixed.rightRoot G L p ⟨l,hk⟩,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.1.2.1.2,fun _ => rfl⟩
      · exact ⟨fun p => p.1.2.2.2,fun _ => rfl⟩
  · rintro (⟨j,l⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => HybridMixed.leftMiddle G L p l,fun _ => rfl⟩
      · exact ⟨fun p => HybridMixed.centralMiddle G L p l,fun _ => rfl⟩
      · have hk : l≠i := fun he => ht (congrArg Sum.inl (Prod.ext rfl he))
        exact ⟨fun p => HybridMixed.rightMiddle G L p ⟨l,hk⟩,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨HybridMixed.leftFullMiddle G L,fun _ => rfl⟩
      · exact ⟨HybridMixed.rightFullMiddle G L,fun _ => rfl⟩

noncomputable def leftFullWitness : DeletionWitness k G L (.inr 0) := by
  classical
  refine
    { S := HybridMixed.BareRoots (W:=W) (Fin k) (Fin k) (Fin k)
      finS := inferInstance
      E := HybridMixed.BareFiber G L (Fin k) (Fin k) (Fin k)
      finE := fun _ => inferInstance
      data := HybridMixed.leftFullDeletion G L
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      light := by intro a h; cases h
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · rintro (j|j)
    · fin_cases j
      · exact ⟨fun p => p.2.2.2.1.1,fun _ => rfl⟩
      · exact ⟨fun p => p.2.1,fun _ => rfl⟩
      · exact ⟨fun p => p.2.2.2.2.1,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.2.2.2.1.2.1.val,fun _ => rfl⟩
      · exact ⟨fun p => p.2.2.2.2.2.1.val,fun _ => rfl⟩
  · rintro (⟨j,i⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => p.1.2.1 i,fun _ => rfl⟩
      · exact ⟨fun p => p.1.1 i,fun _ => rfl⟩
      · exact ⟨fun p => p.1.2.2.1 i,fun _ => rfl⟩
    · fin_cases j
      · exact (ht rfl).elim
      · exact ⟨fun p => p.1.2.2.2,fun _ => rfl⟩
  · rintro (⟨j,i⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => MaskedBush.middle G L (p.2.2.2.1.2.2 i),fun _ => rfl⟩
      · exact ⟨fun p => MaskedBush.middle G L (p.2.2.1 i),fun _ => rfl⟩
      · exact ⟨fun p => MaskedBush.middle G L (p.2.2.2.2.2.2.1 i),fun _ => rfl⟩
    · fin_cases j
      · exact (ht rfl).elim
      · exact ⟨fun p => p.2.2.2.2.2.2.2.val,fun _ => rfl⟩

noncomputable def rightFullWitness : DeletionWitness k G L (.inr 1) := by
  classical
  refine
    { S := HybridMixed.BareRoots (W:=W) (Fin k) (Fin k) (Fin k)
      finS := inferInstance
      E := HybridMixed.BareFiber G L (Fin k) (Fin k) (Fin k)
      finE := fun _ => inferInstance
      data := HybridMixed.rightFullDeletion G L
      root_eq := fun _ => rfl
      middle_eq := fun _ => rfl
      hub_eq := fun _ => rfl
      light := by intro a h; cases h
      core_retained := ?_
      root_retained := ?_
      terminal_retained := ?_ }
  · rintro (j|j)
    · fin_cases j
      · exact ⟨fun p => p.2.2.2.2.1,fun _ => rfl⟩
      · exact ⟨fun p => p.2.1,fun _ => rfl⟩
      · exact ⟨fun p => p.2.2.2.1.1,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.2.2.2.2.2.1.val,fun _ => rfl⟩
      · exact ⟨fun p => p.2.2.2.1.2.1.val,fun _ => rfl⟩
  · rintro (⟨j,i⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => p.1.2.2.1 i,fun _ => rfl⟩
      · exact ⟨fun p => p.1.1 i,fun _ => rfl⟩
      · exact ⟨fun p => p.1.2.1 i,fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.1.2.2.2,fun _ => rfl⟩
      · exact (ht rfl).elim
  · rintro (⟨j,i⟩|j) ht
    · fin_cases j
      · exact ⟨fun p => MaskedBush.middle G L (p.2.2.2.2.2.2.1 i),fun _ => rfl⟩
      · exact ⟨fun p => MaskedBush.middle G L (p.2.2.1 i),fun _ => rfl⟩
      · exact ⟨fun p => MaskedBush.middle G L (p.2.2.2.1.2.2 i),fun _ => rfl⟩
    · fin_cases j
      · exact ⟨fun p => p.2.2.2.2.2.2.2.val,fun _ => rfl⟩
      · exact (ht rfl).elim

noncomputable def deletionWitness (r : Arm k) : DeletionWitness k G L r := by
  rcases r with ⟨j,i⟩|j
  · by_cases h₀ : j=0
    · subst j; exact leftWitness k G L i
    by_cases h₁ : j=1
    · subst j; exact centralWitness k G L i
    have h₂ : j=2 := by omega
    subst j
    exact rightWitness k G L i
  · by_cases h : j=0
    · subst j; exact leftFullWitness k G L
    have he : j=1 := by omega
    subst j
    exact rightFullWitness k G L

lemma deleted_witness_bound (Z : ℝ)
    (hc : ∀ i : Fin k, (Nat.card (HybridMixed.Agreement G L
      (MaskedBush.Without i) (Fin k) (Fin k)):ℝ) ≤ Z)
    (hl : ∀ i : Fin k, (Nat.card (HybridMixed.Agreement G L
      (Fin k) (MaskedBush.Without i) (Fin k)):ℝ) ≤ Z)
    (hr : ∀ i : Fin k, (Nat.card (HybridMixed.Agreement G L
      (Fin k) (Fin k) (MaskedBush.Without i)):ℝ) ≤ Z)
    (hf : (Nat.card (HybridMixed.BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ) ≤ Z)
    (r : Arm k) :
    (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness k G L r).E):ℝ) ≤ Z := by
  rcases r with ⟨j,i⟩|j
  · fin_cases j
    · exact hl i
    · exact hc i
    · exact hr i
  · fin_cases j <;> exact hf

end Erdos571.HybridRoles


/-! Supporting module: HybridIndexedDeletionBounds -/
/-! Role-indexed consequences of the retained-data deletion interface. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable {r : Arm k} (D : DeletionWitness k G L r)

lemma DeletionWitness.root_collision_bound (hlight : ∃ a : LightArm k, r=.inl a) (role : Full k G L → W)
    (hret : ∃ kept : Sigma D.E → W, ∀ p, role p=kept (D.data.delete p))
    (cap : ℕ) (hL : 0 ≤ L) (hcap : L ≤ cap) (Z : ℝ)
    (hdel : (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) ≤ Z) :
    (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (fun p => rootValue k G L p r=role p)):ℝ) ≤ (cap:ℝ)^2*Z := by
  classical
  letI := D.finS
  letI := D.finE
  obtain ⟨kept,hkept⟩ := hret
  obtain ⟨a,ha⟩ := hlight
  let Dlight : ArmDeletion.Data G L (HybridThreeHubAssignments.Fiber G L k) D.E :=
    { delete := D.data.delete
      root := D.data.root
      hub := D.data.hub
      arm := fun p => ⟨⟨D.light a ha p⟩,⟨D.data.middle p,D.data.left p,(D.data.right p).symm⟩⟩
      labels := D.data.labels
      roots := D.data.roots
      restore := D.data.restore }
  have h := ArmDeletion.prescribed_root_bound Dlight kept cap hL hcap
  have he : (fun p => D.data.root p=kept (D.data.delete p))=
      (fun p => rootValue k G L p r=role p) := by
    funext p
    rw [D.root_eq,←hkept]
  change Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
    (fun p => D.data.root p=kept (D.data.delete p))) ≤ _ at h
  rw [he] at h
  have hh : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (fun p => rootValue k G L p r=role p)):ℝ) ≤
      (cap:ℝ)^2*(Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) := by exact_mod_cast h
  exact hh.trans (mul_le_mul_of_nonneg_left hdel (sq_nonneg _))

lemma DeletionWitness.middle_collision_bound (role : Full k G L → W)
    (hret : ∃ kept : Sigma D.E → W, ∀ p, role p=kept (D.data.delete p))
    (H : SimpleGraph W) (t cap : ℕ) (hk : 2 ≤ t) (hH : H.CliqueFree t)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (B Z : ℝ)
    (hpin : (Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k) role):ℝ) ≤ B)
    (hdel : (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) ≤ Z) :
    (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (fun p => terminalValue k G L p r=role p)):ℝ) ≤ (t-1:ℕ)*(B+cap*Z) := by
  classical
  letI := D.finS
  letI := D.finE
  obtain ⟨kept,hkept⟩ := hret
  have h := TwoStepArmDeletion.prescribed_middle_bound D.data kept H t cap hk hH hlight
  have hp : kept ∘ D.data.delete=role := funext (fun p => (hkept p).symm)
  have he : (fun p => D.data.middle p=kept (D.data.delete p))=
      (fun p => terminalValue k G L p r=role p) := by
    funext p
    rw [D.middle_eq,←hkept]
  rw [he,hp] at h
  have hh : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (fun p => terminalValue k G L p r=role p)):ℝ) ≤
      (t-1:ℕ)*((Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k) role):ℝ)+
        cap*(Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ)) := by exact_mod_cast h
  exact hh.trans (mul_le_mul_of_nonneg_left
    (add_le_add hpin (mul_le_mul_of_nonneg_left hdel (Nat.cast_nonneg cap))) (Nat.cast_nonneg _))

lemma DeletionWitness.terminal_pin_bound (H : SimpleGraph W) (t cap Δ : ℕ)
    (hk : 2 ≤ t) (hH : H.CliqueFree t) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (B Z : ℝ)
    (hpin : (Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k)
      (fun p => coreValue k G L p (.inl (hubIndex k r)))):ℝ) ≤ B)
    (hdel : (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ) ≤ Z) :
    (Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k)
      (fun p => terminalValue k G L p r)):ℝ) ≤ (t-1:ℕ)*(B+(cap*Δ:ℕ)*Z) := by
  classical
  letI := D.finS
  letI := D.finE
  have h := TwoStepArmDeletion.terminal_pin_bound D.data H t cap Δ hk hH hdeg hlight
  have hm : D.data.middle=(fun p => terminalValue k G L p r) := funext D.middle_eq
  have hh : TwoStepArmDeletion.hub D.data=(fun p => coreValue k G L p (.inl (hubIndex k r))) := funext D.hub_eq
  rw [hm,hh] at h
  have h' : (Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k)
      (fun p => terminalValue k G L p r)):ℝ) ≤
      (t-1:ℕ)*((Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k)
        (fun p => coreValue k G L p (.inl (hubIndex k r)))):ℝ)+(cap*Δ:ℕ)*
          (Nat.card (FiberRestrictionEnergy.Agreement D.E):ℝ)) := by exact_mod_cast h
  exact h'.trans (mul_le_mul_of_nonneg_left
    (add_le_add hpin (mul_le_mul_of_nonneg_left hdel (Nat.cast_nonneg _))) (Nat.cast_nonneg _))

end Erdos571.HybridRoles


/-! Supporting module: HybridRoleParity -/
/-! Bipartite parity separates every old role from every middle role. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
include hg

lemma two_walk_color {u v w : W} (hu : G.Adj u w) (hv : G.Adj v w) : g u=g v := by
  have h₁ := hg hu
  have h₂ := hg hv
  cases hgu : g u <;> cases hgv : g v <;> cases hgw : g w <;> simp_all

lemma hub_color (p : Full k G L) (i : Fin 3) :
    g (HybridThreeHubAssignments.hubValue G L k p i)=g (HybridThreeHubAssignments.center G L k p) := by
  fin_cases i
  · exact two_walk_color G g hg p.2.2.2.1.2.1.property.2 p.2.2.2.1.2.1.property.1
  · rfl
  · exact two_walk_color G g hg p.2.2.2.2.2.1.property.2 p.2.2.2.2.2.1.property.1

lemma coreMiddle_color (p : Full k G L) (i : Fin 2) :
    g (HybridThreeHubAssignments.coreMiddle G L k p i)≠g (HybridThreeHubAssignments.center G L k p) := by
  fin_cases i
  · exact (hg p.2.2.2.1.2.1.property.1).symm
  · exact (hg p.2.2.2.2.2.1.property.1).symm

lemma root_color (p : Full k G L) (r : Arm k) :
    g (rootValue k G L p r)=g (HybridThreeHubAssignments.center G L k p) := by
  let a := HybridThreeHubAssignments.rootWalk G L k p ((rootEquiv k).symm r)
  have h := two_walk_color G g hg a.property.2 a.property.1
  exact h.trans (hub_color k G L g hg p ((rootEquiv k).symm r).1)

lemma terminal_color (p : Full k G L) (r : Arm k) :
    g (terminalValue k G L p r)≠g (HybridThreeHubAssignments.center G L k p) := by
  have h := (hg (HybridThreeHubAssignments.rootWalk G L k p ((rootEquiv k).symm r)).property.1).symm
  exact h.trans_eq (hub_color k G L g hg p ((rootEquiv k).symm r).1)

def parity : Vertex k → Bool
  | .inl (.inl (.inl _)) => false
  | .inl (.inl (.inr _)) => true
  | .inl (.inr _) => true
  | .inr _ => false

lemma value_color (p : Full k G L) (v : Vertex k) :
    g (value k G L p v)=
      if parity k v then !(g (HybridThreeHubAssignments.center G L k p))
      else g (HybridThreeHubAssignments.center G L k p) := by
  rcases v with ((i|i)|r)|r
  · exact hub_color k G L g hg p i
  · have h := coreMiddle_color k G L g hg p i
    change g (HybridThreeHubAssignments.coreMiddle G L k p i)=!(g (HybridThreeHubAssignments.center G L k p))
    cases hx : g (HybridThreeHubAssignments.coreMiddle G L k p i) <;>
      cases hy : g (HybridThreeHubAssignments.center G L k p) <;> simp_all
  · have h := terminal_color k G L g hg p r
    change g (terminalValue k G L p r)=!(g (HybridThreeHubAssignments.center G L k p))
    cases hx : g (terminalValue k G L p r) <;>
      cases hy : g (HybridThreeHubAssignments.center G L k p) <;> simp_all
  · exact root_color k G L g hg p r

lemma value_ne_of_parity (p : Full k G L) (v w : Vertex k) (h : parity k v≠parity k w) :
    value k G L p v≠value k G L p w := by
  intro he
  have hc := congrArg g he
  rw [value_color k G L g hg,value_color k G L g hg] at hc
  cases hv : parity k v <;> cases hw : parity k w <;>
    cases hx : g (HybridThreeHubAssignments.center G L k p) <;> simp_all

lemma opposite_parity_both_zero (v w : Vertex k) (h : parity k v≠parity k w) :
    Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (fun p => value k G L p v=value k G L p w))=0 := by
  haveI : IsEmpty (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (fun p => value k G L p v=value k G L p w)) :=
    ⟨fun p => value_ne_of_parity k G L g hg p.1.1 v w h p.2.2.1⟩
  simp

end Erdos571.HybridRoles


/-! Supporting module: HybridRootReflection -/
/-! A reflection bound for identifying the two untrimmed endpoint roots.
This file proves algebraic identities and inequalities only; finite
assignment identities and the full collision decomposition are separate. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRootReflection
open Finset Matrix GramPin GramFeatures ThreeHubKernel MatchedThreeHubPin
variable {U I : Type} [Fintype U] [Fintype I] [DecidableEq U]

lemma gram_squareMass_le (F : Matrix U I ℝ) :
    squareMass (F*F.transpose) ≤ (squareMass F)^2 := by
  calc
    _ ≤ ∑ u, ∑ v, (∑ r, (F u r)^2)*(∑ r, (F v r)^2) := by
      apply sum_le_sum
      intro u _
      apply sum_le_sum
      intro v _
      simpa only [Matrix.mul_apply,Matrix.transpose_apply] using
        sum_mul_sq_le_sq_mul_sq (univ : Finset I) (fun r => F u r) (fun r => F v r)
    _ = _ := by rw [pow_two]; simp only [squareMass,sum_mul_sum]

noncomputable def localFeature (P : Matrix U U ℝ) (F : Matrix U I ℝ) (x : U) : Matrix U I ℝ :=
  (P*Matrix.diagonal (fun u => P x u))*F

noncomputable def arm (P Z : Matrix U U ℝ) : Matrix U U ℝ :=
  fun u v => Z u v*(P*P) u v

lemma local_mass (P : Matrix U U ℝ) (hs : P.IsSymm) (F : Matrix U I ℝ) (x : U) :
    squareMass (localFeature P F x) = (P*arm P (F*F.transpose)*P) x x := by
  let D := Matrix.diagonal (fun u => P x u)
  have hm : (P*D).transpose*(P*D)=D*(P*P)*D := by
    simp only [Matrix.transpose_mul,Matrix.diagonal_transpose,hs.eq,D,Matrix.mul_assoc]
  have he : (P*arm P (F*F.transpose)*P) x x =
      ∑ u, ∑ v, P x u*arm P (F*F.transpose) u v*P v x := by
    simp only [Matrix.mul_apply,Finset.sum_mul]
    rw [Finset.sum_comm]
  rw [he,localFeature,chain_gram_identity]
  change (∑ u, ∑ v, ((P*D).transpose*(P*D)) u v*(F*F.transpose) u v)=_
  rw [hm]
  simp only [D,Matrix.mul_diagonal,Matrix.diagonal_mul,arm]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  rw [←hs.apply x v]
  ring

noncomputable def rootCollision (P : Matrix U U ℝ) (F : Matrix U I ℝ) : ℝ :=
  ∑ x, ∑ u, ∑ v, (F*F.transpose) u v *
    ((localFeature P F x*(localFeature P F x).transpose) u v)^2

/-- Reflection exchanges the repeated endpoint root with the central hub.
Only a Gram factorization of the common arm kernel is used. -/
theorem rootCollision_le (A : Matrix U U ℝ) (hs : A.IsSymm) (F : Matrix U I ℝ)
    (b c : ℝ) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hcap : ∀ u v, (F*F.transpose) u v ≤ b)
    (hdiag : ∀ u, c ≤ (F*F.transpose) u u) :
    c*rootCollision (A*A) F ≤
      b*pin A (HybridMatchedKernels.endpoint A (F*F.transpose)) (F*F.transpose) := by
  let P := A*A
  let Z := F*F.transpose
  have hP : P.IsSymm := by
    show (A*A).transpose=A*A
    rw [Matrix.transpose_mul,hs.eq]
  have he (x : U) : squareMass (localFeature P F x) =
      chain A (HybridMatchedKernels.endpoint A Z) x x := by
    have h := local_mass P hP F x
    exact h
  have hroot : rootCollision P F ≤
      b*∑ x, (chain A (HybridMatchedKernels.endpoint A Z) x x)^2 := by
    rw [rootCollision,mul_sum]
    apply sum_le_sum
    intro x _
    calc
      _ ≤ b*squareMass (localFeature P F x*(localFeature P F x).transpose) := by
        simp only [squareMass,mul_sum]
        exact sum_le_sum (fun u _ => sum_le_sum (fun v _ =>
          mul_le_mul_of_nonneg_right (hcap u v) (sq_nonneg _)))
      _ ≤ b*(squareMass (localFeature P F x))^2 :=
        mul_le_mul_of_nonneg_left (gram_squareMass_le _) hb
      _ = _ := by rw [he]
  have hp : c*(∑ x, (chain A (HybridMatchedKernels.endpoint A Z) x x)^2) ≤
      pin A (HybridMatchedKernels.endpoint A Z) Z := by
    rw [mul_sum]
    exact sum_le_sum (fun x _ => mul_le_mul_of_nonneg_right (hdiag x) (sq_nonneg _))
  calc
    _ ≤ c*(b*∑ x, (chain A (HybridMatchedKernels.endpoint A Z) x x)^2) :=
      mul_le_mul_of_nonneg_left hroot hc
    _ = b*(c*∑ x, (chain A (HybridMatchedKernels.endpoint A Z) x x)^2) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hp hb

end Erdos571.HybridRootReflection


/-! Supporting module: HybridEndpointRootCollision -/
/-! Exact finite count and reflection bound when the two untrimmed endpoint
roots coincide. The finite objects still allow other repeated vertices. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin HybridRootReflection
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

abbrev JoinedLabels := W × (Labels (W:=W) k × (Labels (W:=W) k × Labels (W:=W) k))
abbrev JoinedFiber (r : JoinedLabels (W:=W) k) :=
  Fiber G L k (r.2.1,(r.2.2.1,r.1),(r.2.2.2,r.1))
abbrev JoinedAgreement := (r : JoinedLabels (W:=W) k) × (JoinedFiber G L k r × JoinedFiber G L k r)

lemma side_local_feature (x u : W) (r : Labels (W:=W) k) :
    sideFeature G L k u (r,x)=
      localFeature (G.adjMatrix ℝ * G.adjMatrix ℝ) (armFeature G L k) x u r := by
  rw [sideFeature,Matrix.mul_apply,localFeature,Matrix.mul_apply]
  simp only [Matrix.mul_diagonal,endFeature]
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=_
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  apply sum_congr rfl
  intro v _
  rw [hs.apply x v]
  ring

open Classical in
lemma joined_card : (Nat.card (JoinedAgreement G L k):ℝ)=
    rootCollision (G.adjMatrix ℝ * G.adjMatrix ℝ) (armFeature G L k) := by
  rw [Nat.card_eq_fintype_card,Fintype.card_sigma,Nat.cast_sum]
  conv_lhs => arg 2; ext r; rw [Fintype.card_prod,Nat.cast_mul,←pow_two]
  change (∑ r : JoinedLabels (W:=W) k, (Fintype.card (JoinedFiber G L k r):ℝ)^2)=_
  simp only [JoinedFiber,card_fiber,Fintype.sum_prod_type,side_local_feature]
  rw [rootCollision]
  apply sum_congr rfl
  intro x _
  rw [ArmTensor.triple_mixed_total]
  simp only [pow_two,mul_assoc]

/-- The entire repeated-endpoint-root energy is controlled by the actual
finite central pin, not by an unrelated unmasked energy. -/
theorem joined_le_center (b c : ℝ) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hcap : ∀ u v, centralKernel G L k u v ≤ b)
    (hdiag : ∀ u, c ≤ centralKernel G L k u u) :
    c*(Nat.card (JoinedAgreement G L k):ℝ) ≤
      b*(Nat.card (Pin G L k (center G L k)):ℝ) := by
  rw [joined_card,center_pin_card]
  have h := rootCollision_le (G.adjMatrix ℝ) G.isSymm_adjMatrix (armFeature G L k)
    b c hb hc (by simpa only [arm_gram] using hcap) (by simpa only [arm_gram] using hdiag)
  rw [arm_gram] at h
  exact h

/-- Actual matched-template freeness makes the reflection coefficient
independent of the host order and degree. -/
theorem free_joined_le_center (M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L) :
    (Nat.card (JoinedAgreement G L k):ℝ) ≤
      (2*(MatchedThreeHub.momentCoefficient (k+1) M*K^2))^k*
        (Nat.card (Pin G L k (center G L k)):ℝ) := by
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  let T := C*d^2
  have hC : 0 ≤ C := mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg (k+1) M) (sq_nonneg K)
  have hT : 0 ≤ T := mul_nonneg hC (sq_nonneg d)
  have hrow (u : W) : ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T := by
    have h := MatchedThreeHub.free_fourth_row_bound (k+1) M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hNrow (u : W) : d^2/2 ≤ ∑ v, LightArmKernel.matrix G L u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hcap (u v : W) : centralKernel G L k u v ≤ T^k :=
    pow_le_pow_left₀ (LightArmKernel.gram_nonneg G L u v)
      (LightArmKernel.gram_upper G L T hT hrow u v) k
  have hdiag (u : W) : (d^2/2)^k ≤ centralKernel G L k u u :=
    pow_le_pow_left₀ (by positivity) ((hNrow u).trans (LightArmKernel.gram_diagonal_lower G L u)) k
  have h := joined_le_center G L k (T^k) ((d^2/2)^k) (pow_nonneg hT _) (by positivity) hcap hdiag
  have he : (d^2/2)^k*(2*C)^k=T^k := by
    rw [←mul_pow]
    congr 1
    dsimp [T]
    ring
  apply (mul_le_mul_iff_right₀ (pow_pos (by positivity : 0 < d^2/2) k)).mp
  change (d^2/2)^k*(Nat.card (JoinedAgreement G L k):ℝ) ≤
    (d^2/2)^k*((2*C)^k*(Nat.card (Pin G L k (center G L k)):ℝ))
  rw [←mul_assoc,he]
  exact h

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridJoinedBoth -/
/-! The joined-root count is exactly the both-copy restriction of the full
hybrid assignment family. -/
namespace Erdos571.HybridThreeHubAssignments
open SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

abbrev SameFullRoots (p : Full G L k) := p.1.2.1.2=p.1.2.2.2

def sameFullRootsEquiv :
    FiberRestrictionEnergy.Both (Fiber G L k) (SameFullRoots G L k) ≃ JoinedAgreement G L k where
  toFun p := by
    rcases p with ⟨⟨⟨⟨r,⟨t,x⟩,⟨a,y⟩⟩,p⟩,⟨r',q⟩⟩,he,hp,hq⟩
    cases he
    change x=y at hp
    subst y
    exact ⟨(x,r,t,a),p,q⟩
  invFun p := ⟨(⟨(p.1.2.1,(p.1.2.2.1,p.1.1),(p.1.2.2.2,p.1.1)),p.2.1⟩,
    ⟨(p.1.2.1,(p.1.2.2.1,p.1.1),(p.1.2.2.2,p.1.1)),p.2.2⟩),rfl,rfl,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨⟨⟨r,⟨t,x⟩,⟨a,y⟩⟩,p⟩,⟨r',q⟩⟩,he,hp,hq⟩
    cases he
    change x=y at hp
    subst y
    rfl
  right_inv p := by rcases p with ⟨⟨x,r,t,a⟩,p,q⟩; rfl

lemma sameFullRoots_card :
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (SameFullRoots G L k))=
      Nat.card (JoinedAgreement G L k) := Nat.card_congr (sameFullRootsEquiv G L k)

theorem sameFullRoots_bound (M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L) :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (SameFullRoots G L k)):ℝ) ≤
      (2*(MatchedThreeHub.momentCoefficient (k+1) M*K^2))^k*
        (Nat.card (Pin G L k (center G L k)):ℝ) := by
  rw [sameFullRoots_card]
  exact free_joined_le_center G L k M hf d K hL hd hK hdK hmin hmax hcut

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridCoreMiddleAssignments -/
/-! Exact finite identities for the two core-middle pins in the hybrid
assignment model. These are the same hybrid energies as the hub pins. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix GramPin MatchedThreeHubPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

abbrev EndStep (w : W) (r : EndLabels (W:=W) k) :=
  (u : W) × (PLift (G.Adj w u) × EndBundle G L k u r)

def leftCoreMiddle (p : Full G L k) : W := p.2.2.2.1.2.1.val
def rightCoreMiddle (p : Full G L k) : W := p.2.2.2.2.2.1.val

open Classical in
lemma card_endStep (w : W) (r : EndLabels (W:=W) k) :
    (Fintype.card (EndStep G L k w r):ℝ)=(G.adjMatrix ℝ * endFeature G L k) w r := by
  simp only [EndStep,Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,
    LayeredAssignments.card_adj,MaskedBush.card_bundle,←LayeredBush.adjacency_square_common_card,
    endFeature,armFeature,Matrix.mul_apply]

def leftCoreMarkEquiv (r : Roots (W:=W) k) (w : W) :
    MarkFiber G L k (leftCoreMiddle G L k) r w ≃
      ((x : W) × (Bundle G L k x r.1 × PLift (G.Adj x w) ×
        EndStep G L k w r.2.1 × Side G L k x r.2.2)) where
  toFun p := by
    rcases p with ⟨⟨x,a,⟨u,⟨z,hz⟩,b⟩,q⟩,he⟩
    change z=w at he
    subst z
    exact ⟨x,a,⟨hz.1⟩,⟨u,⟨hz.2.symm⟩,b⟩,q⟩
  invFun p := by
    rcases p with ⟨x,a,hx,⟨u,hu,b⟩,q⟩
    exact ⟨⟨x,a,⟨u,⟨w,hx.down,hu.down.symm⟩,b⟩,q⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,a,⟨u,⟨z,hz⟩,b⟩,q⟩,he⟩
    change z=w at he
    subst z
    rfl
  right_inv p := by
    rcases p with ⟨x,a,⟨hx⟩,⟨u,⟨hu⟩,b⟩,q⟩
    rfl

open Classical in
lemma leftCoreMark_card (r : Roots (W:=W) k) (w : W) :
    (Fintype.card (MarkFiber G L k (leftCoreMiddle G L k) r w):ℝ)=
      (G.adjMatrix ℝ * endFeature G L k) w r.2.1*
        (∑ x, armFeature G L k x r.1*G.adjMatrix ℝ x w*sideFeature G L k x r.2.2) := by
  rw [Fintype.card_congr (leftCoreMarkEquiv G L k r w),Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,MaskedBush.card_bundle,card_endStep,
    card_side,LayeredAssignments.card_adj]
  rw [mul_sum]
  exact sum_congr rfl (fun x _ => by dsimp only [armFeature]; ring)

lemma middle_pairing (A B Z : Matrix W W ℝ) (hs : A.IsSymm) :
    (∑ u, ∑ v, Z u v*ThreeHubKernel.chain A B u v*
      (A*Matrix.diagonal (fun w => (A*B*A) w w)*A) u v)=middlePin A B Z := by
  let O := outside A B Z
  let D := Matrix.diagonal (fun w => (A*B*A) w w)
  change (∑ u, ∑ v, O u v*(A*D*A) u v)=_
  rw [inner_trace]
  simp only [Matrix.transpose_mul,hs.eq,D,Matrix.diagonal_transpose]
  have he : (O*(A*D*A)).trace=(D*(A*O*A)).trace := by
    simpa only [Matrix.mul_assoc] using (Matrix.trace_mul_cycle D A (O*A)).symm
  simp only [Matrix.mul_assoc] at he
  rw [he]
  simp only [D,Matrix.trace,Matrix.diag,Matrix.diagonal_mul,middlePin,O,Matrix.mul_assoc]

open Classical in
lemma left_core_pin_card : (Nat.card (Pin G L k (leftCoreMiddle G L k)):ℝ)=
    middlePin (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [pin_card]
  simp_rw [leftCoreMark_card]
  simp only [Fintype.sum_prod_type]
  have h := ArmTensor.marked_mixed_total (G.adjMatrix ℝ) (armFeature G L k)
    (G.adjMatrix ℝ * endFeature G L k) (sideFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h]
  have hm : (G.adjMatrix ℝ * endFeature G L k)*(G.adjMatrix ℝ * endFeature G L k).transpose=
      G.adjMatrix ℝ * (endFeature G L k*(endFeature G L k).transpose)*G.adjMatrix ℝ := by
    simp only [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix,Matrix.mul_assoc]
  rw [hm,arm_gram,end_gram,side_gram,SimpleGraph.transpose_adjMatrix]
  exact middle_pairing _ _ _ G.isSymm_adjMatrix

def corePinEquiv : Pin G L k (leftCoreMiddle G L k) ≃ Pin G L k (rightCoreMiddle G L k) where
  toFun p := ⟨⟨swapSides G L k p.1.1,swapSides G L k p.1.2⟩,
    congrArg (fun r : Roots (W:=W) k => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  invFun p := ⟨⟨swapSides G L k p.1.1,swapSides G L k p.1.2⟩,
    congrArg (fun r : Roots (W:=W) k => (r.1,r.2.2,r.2.1)) p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma right_core_pin_card : (Nat.card (Pin G L k (rightCoreMiddle G L k)):ℝ)=
    middlePin (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [←Nat.card_congr (corePinEquiv G L k)]
  exact left_core_pin_card G L k

/-- All five actual core roles have the same sharp cubic coefficient. -/
theorem all_core_pin_cubic (M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (role : Full G L k → W)
    (hrole : role=center G L k ∨ role=leftHub G L k ∨ role=rightHub G L k ∨
      role=leftCoreMiddle G L k ∨ role=rightCoreMiddle G L k) :
    (Nat.card (Pin G L k role):ℝ)^3 ≤
      (2:ℝ)^k*(MatchedThreeHub.momentCoefficient (k+1) M*K^2)^(4*(k+1))*
        (Fintype.card W:ℝ)*d^(6*(k+1)+2)*(Nat.card (Agreement G L k):ℝ)^2 := by
  rw [agreement_card]
  apply MatchedThreeHub.free_hybrid_all_core_bound (k+1) M (by omega) G hf L d K
    hL hd hK hdK hmin hmax hcut
  rcases hrole with rfl|rfl|rfl|rfl|rfl
  · exact Or.inl (center_pin_card G L k)
  · exact Or.inr (Or.inl (left_pin_card G L k))
  · exact Or.inr (Or.inl (right_pin_card G L k))
  · exact Or.inr (Or.inr (left_core_pin_card G L k))
  · exact Or.inr (Or.inr (right_core_pin_card G L k))

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridCoreCollisionCubic -/
/-! The trace interpolation also controls the same-copy core collision
kernels. No finite-copy identifications are assumed here. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridCoreCollisions
open Finset Matrix GramFeatures GramPin ThreeHubKernel MatchedThreeHubPin

lemma scaled_pin_cubic_scalar (x t E a c n h : ℝ)
    (hE : 0 ≤ E) (ha : 0 ≤ a) (hn : 0 ≤ n) (hh : 0 ≤ h)
    (hx : x^2 ≤ a^2*t*E) (ht : c^2*t^3 ≤ n^2*h^2*E) :
    c*x^3 ≤ a^3*h*n*E^2 := by
  have h₁ : x^6 ≤ a^6*t^3*E^3 := by
    have h := pow_le_pow_left₀ (sq_nonneg x) hx 3
    convert h using 1 <;> ring
  apply le_of_sq_le_sq _ (by positivity)
  calc
    _ = c^2*x^6 := by ring
    _ ≤ c^2*(a^6*t^3*E^3) := mul_le_mul_of_nonneg_left h₁ (sq_nonneg c)
    _ = a^6*E^3*(c^2*t^3) := by ring
    _ ≤ a^6*E^3*(n^2*h^2*E) :=
      mul_le_mul_of_nonneg_left ht (mul_nonneg (pow_nonneg ha _) (pow_nonneg hE _))
    _ = _ := by ring

variable {U : Type} [Fintype U] [DecidableEq U]

lemma cubic_of_twoEnergy_upper (A Z : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hZ : ∀ u v, 0 ≤ Z u v)
    (T b c a x : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c) (ha : 0 ≤ a)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hcap : ∀ u, Z u u ≤ b) (hdiag : ∀ u, c ≤ Z u u)
    (hx0 : 0 ≤ x) (hx : x ≤ a*twoEnergy A (HybridMatchedKernels.endpoint A Z)) :
    c*x^3 ≤ a^3*(b*T)*(Fintype.card U:ℝ)*
      (energy A (HybridMatchedKernels.endpoint A Z) Z)^2 := by
  let B := HybridMatchedKernels.endpoint A Z
  let Q := (A*A)*(A*A)
  have hQ := chain_nonneg (chain_nonneg hA hA) (chain_nonneg hA hA)
  have hB (u v : U) : 0 ≤ B u v := mul_nonneg (hZ u v) (hQ u v)
  have hmatch := HybridMatchedKernels.matching_identity A Z
  have h₁ := MatchedThreeHubPin.twoEnergy_sq_le_trace A B Z Q hs hB hZ hQ
    (by intros; exact le_rfl) hmatch
  have h₂ := MatchedThreeHubPin.trace_cubic A B Z Q hs hA hB hZ hQ
    (by intros; exact le_rfl) hmatch T b c hT hb hc hr (fun u => ⟨hdiag u,hcap u⟩)
  apply scaled_pin_cubic_scalar x (chain A B).trace (energy A B Z) a c
    (Fintype.card U:ℝ) (b*T) (MatchedThreeHubPin.energy_nonneg A B Z hZ) ha
    (Nat.cast_nonneg _) (mul_nonneg hb hT) _ h₂
  calc
    _ ≤ (a*twoEnergy A B)^2 := pow_le_pow_left₀ hx0 hx 2
    _ = a^2*(twoEnergy A B)^2 := mul_pow _ _ _
    _ ≤ a^2*((chain A B).trace*energy A B Z) := mul_le_mul_of_nonneg_left h₁ (sq_nonneg a)
    _ = _ := by ring

end Erdos571.HybridCoreCollisions


/-! Supporting module: HybridCoreTensor -/
/-! Tensor identities for the three hybrid same-copy core identifications. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridCoreTensor
open Finset Matrix GramFeatures GramPin ArmTensor
variable {U I J : Type} [Fintype U] [Fintype I] [Fintype J] [DecidableEq U]

lemma contracted_total (P : Matrix U U ℝ) (F : Matrix U I ℝ) (H : Matrix U J ℝ) :
    (∑ r, ∑ t, ∑ a, (∑ u, P u u*F u r*H u t*(P*H) u a)^2)=
      ∑ u, ∑ v, P u u*P v v*(F*F.transpose) u v*(H*H.transpose) u v*
        ((P*H)*(P*H).transpose) u v := by
  let F' : Matrix U I ℝ := fun u r => P u u*F u r
  have h := triple_mixed_total F' H (P*H)
  change (∑ r, ∑ t, ∑ a, (∑ u, F' u r*H u t*(P*H) u a)^2)=_
  rw [h]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  rw [show (F'*F'.transpose) u v=P u u*P v v*(F*F.transpose) u v from
    row_scale_gram F (fun u => P u u) u v]

lemma same_hubs_total (P : Matrix U U ℝ) (hs : P.IsSymm) (F : Matrix U I ℝ) (H : Matrix U J ℝ) :
    (∑ r, ∑ t, ∑ a, (∑ x, ∑ u, F x r*(P x u)^2*H u t*H u a)^2)=
      ∑ u, ∑ v, ((H*H.transpose) u v)^2*
        (entryPower P 2*(F*F.transpose)*entryPower P 2) u v := by
  let M : Matrix U (J×J) ℝ := fun u p => H u p.1*H u p.2
  let Y := entryPower P 2
  have hY : Y.IsSymm := by
    apply Matrix.IsSymm.ext
    intro u v
    exact congrArg (fun z : ℝ => z^2) (hs.apply u v)
  have hM : M*M.transpose=entryPower (H*H.transpose) 2 := by
    ext u v
    simpa only [M,entryPower,pow_two] using product_gram H H u v
  have hB : (Y*M)*(Y*M).transpose=Y*entryPower (H*H.transpose) 2*Y := by
    simp only [Matrix.transpose_mul,hY.eq,Matrix.mul_assoc]
    rw [←Matrix.mul_assoc M,hM]
  have h := mixed_total F (Y*M)
  simp only [Fintype.sum_prod_type] at h
  rw [hB] at h
  have h' : (∑ r, ∑ t, ∑ a, (∑ x, ∑ u, F x r*(P x u)^2*H u t*H u a)^2)=
      ∑ u, ∑ v, (F*F.transpose) u v*(Y*entryPower (H*H.transpose) 2*Y) u v := by
    convert h using 1
    apply sum_congr rfl
    intro r _
    apply sum_congr rfl
    intro t _
    apply sum_congr rfl
    intro a _
    congr 1
    simp only [Matrix.mul_apply,mul_sum,Y,entryPower,M]
    exact sum_congr rfl (fun x _ => sum_congr rfl (fun u _ => by ring))
  rw [h',ThreeHubKernel.conjugation_inner_swap Y _ _ hY]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by dsimp [entryPower]; ring))

lemma same_middles_total (A : Matrix U U ℝ) (hs : A.IsSymm) (F : Matrix U I ℝ) (H : Matrix U J ℝ) :
    (∑ r, ∑ t, ∑ a,
      (∑ x, ∑ w, A x w*F x r*(A*H) w t*(A*H) w a)^2)=
      ∑ u, ∑ v, (A*(F*F.transpose)*A) u v*((A*(H*H.transpose)*A) u v)^2 := by
  have he (r : I) (t a : J) :
      (∑ x, ∑ w, A x w*F x r*(A*H) w t*(A*H) w a)=
        ∑ w, (A*F) w r*(A*H) w t*(A*H) w a := by
    rw [sum_comm]
    apply sum_congr rfl
    intro w _
    rw [←sum_mul,←sum_mul]
    congr 2
    apply sum_congr rfl
    intro x _
    rw [hs.apply w x]
  simp_rw [he]
  rw [triple_mixed_total]
  have hF : (A*F)*(A*F).transpose=A*(F*F.transpose)*A := by
    simp only [Matrix.transpose_mul,hs.eq,Matrix.mul_assoc]
  have hH : (A*H)*(A*H).transpose=A*(H*H.transpose)*A := by
    simp only [Matrix.transpose_mul,hs.eq,Matrix.mul_assoc]
  rw [hF,hH]
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => by ring))

end Erdos571.HybridCoreTensor


/-! Supporting module: HybridCoreCounts -/
/-! Exact finite both-copy collision counts for the hybrid core. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable (k : ℕ)

abbrev ContractedLeft (p : Full G L k) := leftHub G L k p=center G L k p
abbrev SameHubs (p : Full G L k) := leftHub G L k p=rightHub G L k p
abbrev SameCoreMiddles (p : Full G L k) := leftCoreMiddle G L k p=rightCoreMiddle G L k p

abbrev ContractAt (r : Roots (W:=W) k) (x : W) :=
  Bundle G L k x r.1 × (G.commonNeighbors x x ×
    (EndBundle G L k x r.2.1 × Side G L k x r.2.2))

def contractedLeftEquiv (r : Roots (W:=W) k) :
    FiberRestrictionEnergy.Restricted (Fiber G L k) (ContractedLeft G L k) r ≃
      ((x : W) × ContractAt G L k r x) where
  toFun p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,right⟩,he⟩
    change u=x at he
    subst u
    exact ⟨x,b,cm,c,right⟩
  invFun p := ⟨⟨p.1,p.2.1,⟨p.1,p.2.2.1,p.2.2.2.1⟩,p.2.2.2.2⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,right⟩,he⟩
    change u=x at he
    subst u
    rfl
  right_inv p := by rcases p with ⟨x,b,cm,c,right⟩; rfl

open Classical in
lemma contractedLeft_fiber_card (r : Roots (W:=W) k) :
    (Nat.card (FiberRestrictionEnergy.Restricted (Fiber G L k) (ContractedLeft G L k) r):ℝ)=
      ∑ x, (G.adjMatrix ℝ * G.adjMatrix ℝ) x x*armFeature G L k x r.1*
        endFeature G L k x r.2.1*sideFeature G L k x r.2.2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (contractedLeftEquiv G L k r)]
  simp only [ContractAt,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,
    MaskedBush.card_bundle,card_side,←LayeredBush.adjacency_square_common_card]
  apply sum_congr rfl
  intro x _
  dsimp only [armFeature,endFeature,sideFeature,Matrix.mul_apply]
  ring

open Classical in
lemma contractedLeft_card :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (ContractedLeft G L k)):ℝ)=
      HybridCoreCollisions.adjacent (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [FiberRestrictionEnergy.both_card_real]
  simp_rw [contractedLeft_fiber_card]
  simp only [Fintype.sum_prod_type]
  have h := HybridCoreTensor.contracted_total (G.adjMatrix ℝ * G.adjMatrix ℝ)
    (armFeature G L k) (endFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  change _=HybridCoreCollisions.adjacent _ _ _
  rw [show (G.adjMatrix ℝ * G.adjMatrix ℝ)*endFeature G L k=sideFeature G L k from rfl] at h
  rw [h,arm_gram,end_gram,side_gram]
  rfl

abbrev SameHubAt (r : Roots (W:=W) k) (x u : W) :=
  Bundle G L k x r.1 × (G.commonNeighbors x u × (G.commonNeighbors x u ×
    (EndBundle G L k u r.2.1 × EndBundle G L k u r.2.2)))

def sameHubsEquiv (r : Roots (W:=W) k) :
    FiberRestrictionEnergy.Restricted (Fiber G L k) (SameHubs G L k) r ≃
      ((x : W) × (u : W) × SameHubAt G L k r x u) where
  toFun p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,⟨v,dm,e⟩⟩,he⟩
    change u=v at he
    subst v
    exact ⟨x,u,b,cm,dm,c,e⟩
  invFun p := ⟨⟨p.1,p.2.2.1,⟨p.2.1,p.2.2.2.1,p.2.2.2.2.2.1⟩,
    ⟨p.2.1,p.2.2.2.2.1,p.2.2.2.2.2.2⟩⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,b,⟨u,cm,c⟩,⟨v,dm,e⟩⟩,he⟩
    change u=v at he
    subst v
    rfl
  right_inv p := by rcases p with ⟨x,u,b,cm,dm,c,e⟩; rfl

open Classical in
lemma sameHubs_fiber_card (r : Roots (W:=W) k) :
    (Nat.card (FiberRestrictionEnergy.Restricted (Fiber G L k) (SameHubs G L k) r):ℝ)=
      ∑ x, ∑ u, armFeature G L k x r.1*((G.adjMatrix ℝ * G.adjMatrix ℝ) x u)^2*
        endFeature G L k u r.2.1*endFeature G L k u r.2.2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (sameHubsEquiv G L k r)]
  simp only [SameHubAt,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,
    MaskedBush.card_bundle,←LayeredBush.adjacency_square_common_card]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro u _
  dsimp only [armFeature,endFeature]
  ring

open Classical in
lemma sameHubs_card :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (SameHubs G L k)):ℝ)=
      HybridCoreCollisions.opposite (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [FiberRestrictionEnergy.both_card_real]
  simp_rw [sameHubs_fiber_card]
  simp only [Fintype.sum_prod_type]
  have hs : (G.adjMatrix ℝ * G.adjMatrix ℝ).IsSymm := by
    show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=_
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  have h := HybridCoreTensor.same_hubs_total (G.adjMatrix ℝ * G.adjMatrix ℝ) hs
    (armFeature G L k) (endFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,end_gram]
  rfl

abbrev SameMidAt (r : Roots (W:=W) k) (x w : W) :=
  PLift (G.Adj x w) × (Bundle G L k x r.1 ×
    (EndStep G L k w r.2.1 × EndStep G L k w r.2.2))

def sameMiddlesEquiv (r : Roots (W:=W) k) :
    FiberRestrictionEnergy.Restricted (Fiber G L k) (SameCoreMiddles G L k) r ≃
      ((x : W) × (w : W) × SameMidAt G L k r x w) where
  toFun p := by
    rcases p with ⟨⟨x,b,⟨u,⟨w,hw,hu⟩,c⟩,⟨v,⟨w',hw',hv⟩,e⟩⟩,he⟩
    change w=w' at he
    subst w'
    exact ⟨x,w,⟨hw⟩,b,⟨u,⟨hu.symm⟩,c⟩,⟨v,⟨hv.symm⟩,e⟩⟩
  invFun p := by
    rcases p with ⟨x,w,⟨h⟩,b,⟨u,⟨hu⟩,c⟩,⟨v,⟨hv⟩,e⟩⟩
    exact ⟨⟨x,b,⟨u,⟨w,h,hu.symm⟩,c⟩,⟨v,⟨w,h,hv.symm⟩,e⟩⟩,rfl⟩
  left_inv p := by
    rcases p with ⟨⟨x,b,⟨u,⟨w,hw,hu⟩,c⟩,⟨v,⟨w',hw',hv⟩,e⟩⟩,he⟩
    change w=w' at he
    subst w'
    rfl
  right_inv p := by
    rcases p with ⟨x,w,⟨h⟩,b,⟨u,⟨hu⟩,c⟩,⟨v,⟨hv⟩,e⟩⟩
    rfl

open Classical in
lemma sameMiddles_fiber_card (r : Roots (W:=W) k) :
    (Nat.card (FiberRestrictionEnergy.Restricted (Fiber G L k) (SameCoreMiddles G L k) r):ℝ)=
      ∑ x, ∑ w, G.adjMatrix ℝ x w*armFeature G L k x r.1*
        (G.adjMatrix ℝ * endFeature G L k) w r.2.1*
        (G.adjMatrix ℝ * endFeature G L k) w r.2.2 := by
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (sameMiddlesEquiv G L k r)]
  simp only [SameMidAt,Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,
    MaskedBush.card_bundle,LayeredAssignments.card_adj,←LayeredBush.adjacency_square_common_card]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro w _
  dsimp only [armFeature,endFeature,Matrix.mul_apply]
  ring

open Classical in
lemma sameMiddles_card :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (SameCoreMiddles G L k)):ℝ)=
      HybridCoreCollisions.middles (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  rw [FiberRestrictionEnergy.both_card_real]
  simp_rw [sameMiddles_fiber_card]
  simp only [Fintype.sum_prod_type]
  have h := HybridCoreTensor.same_middles_total (G.adjMatrix ℝ) G.isSymm_adjMatrix
    (armFeature G L k) (endFeature G L k)
  simp only [Fintype.sum_prod_type] at h
  rw [h,arm_gram,end_gram]
  rfl

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridCoreFiniteBounds -/
/-! Finite sharp-scale cubic bounds for the four possible nonadjacent,
same-parity core identifications in the hybrid assignment family. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridCoreCollisions
open Finset Matrix GramFeatures GramPin ThreeHubKernel MatchedThreeHubPin
variable {U : Type} [Fintype U] [DecidableEq U]

lemma uniform_scaled_cubic (A Z : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hZ : ∀ u v, 0 ≤ Z u v)
    (T b c D d x : ℝ) (hT : 0 ≤ T) (hb : 0 ≤ b) (hc : 0 ≤ c) (hD : 0 ≤ D) (hd : 0 ≤ d)
    (hr : ∀ u, ∑ v, ((A*A) u v)^2 ≤ T)
    (hrow : ∀ u, ∑ v, A u v ≤ D) (hupper : ∀ u, (A*A) u u ≤ D)
    (hlower : ∀ u, d ≤ (A*A) u u)
    (hcap : ∀ u v, Z u v ≤ b) (hdiag : ∀ u, c ≤ Z u u) (hx0 : 0 ≤ x)
    (hx : x=adjacent A (HybridMatchedKernels.endpoint A Z) Z ∨
      x=opposite A (HybridMatchedKernels.endpoint A Z) Z ∨
      x=middles A (HybridMatchedKernels.endpoint A Z) Z) :
    c*d^6*x^3 ≤ b^4*T*(d^2*D^2+T^2)^3*(Fintype.card U:ℝ)*
      (energy A (HybridMatchedKernels.endpoint A Z) Z)^2 := by
  let B := HybridMatchedKernels.endpoint A Z
  have hB (u v : U) : 0 ≤ B u v := mul_nonneg (hZ u v)
    (chain_nonneg (chain_nonneg hA hA) (chain_nonneg hA hA) u v)
  have hz : 0 ≤ twoEnergy A B := squareMass_nonneg _
  have hbd (y : ℝ) (hy : y ≤ b*D^2*twoEnergy A B) :
      d^2*y ≤ (b*(d^2*D^2+T^2))*twoEnergy A B := by
    calc
      _ ≤ d^2*(b*D^2*twoEnergy A B) := mul_le_mul_of_nonneg_left hy (sq_nonneg d)
      _ ≤ _ := by nlinarith [mul_nonneg (mul_nonneg hb (sq_nonneg T)) hz]
  have hbt (y : ℝ) (hy : d^2*y ≤ b*T^2*twoEnergy A B) :
      d^2*y ≤ (b*(d^2*D^2+T^2))*twoEnergy A B := by
    exact hy.trans (by nlinarith [mul_nonneg (mul_nonneg hb (mul_nonneg (sq_nonneg d) (sq_nonneg D))) hz])
  have hx : d^2*x ≤ (b*(d^2*D^2+T^2))*twoEnergy A B := by
    rcases hx with rfl|rfl|rfl
    · exact hbd _ (adjacent_le A B Z hs hA hB hZ D b hD hb hupper hcap)
    · exact hbt _ (opposite_mul_lower_le A B Z hs hA hB T b d hT hb hd hr hcap hlower)
    · exact hbd _ (middles_le A B Z hs hA D b hD hb hrow hcap)
  have h := cubic_of_twoEnergy_upper A Z hs hA hZ T b c (b*(d^2*D^2+T^2)) (d^2*x)
    hT hb hc (by positivity) hr (fun u => hcap u u) hdiag (mul_nonneg (sq_nonneg d) hx0) hx
  convert h using 1 <;> ring

lemma uniform_cubic_scale (k : ℕ) (C K d x n E : ℝ) (hd : 0 < d)
    (h : (d^2/2)^k*d^6*x^3 ≤ ((C*d^2)^k)^4*(C*d^2)*
      (d^2*(K*d)^2+(C*d^2)^2)^3*n*E^2) :
    x^3 ≤ (2:ℝ)^k*C^(4*k+1)*(K^2+C^2)^3*n*d^(6*k+8)*E^2 := by
  have he : (2:ℝ)^k*(d^2/2)^k=(d^2)^k := by rw [←mul_pow]; congr 1; ring
  have h' := mul_le_mul_of_nonneg_left h (by positivity : 0 ≤ (2:ℝ)^k)
  have he' : (2:ℝ)^k*((d^2/2)^k*d^6*x^3)=d^(2*k+6)*x^3 := by
    rw [←mul_assoc,←mul_assoc,he]
    simp only [pow_add,pow_mul]
  rw [he'] at h'
  apply (mul_le_mul_iff_right₀ (pow_pos hd (2*k+6))).mp
  calc
    _ ≤ _ := h'
    _ = d^(2*k+6)*((2:ℝ)^k*C^(4*k+1)*(K^2+C^2)^3*n*d^(6*k+8)*E^2) := by
      have hh : d^2*(K*d)^2+(C*d^2)^2=d^4*(K^2+C^2) := by ring
      rw [hh]
      simp only [mul_pow,pow_add,pow_mul,pow_one]
      ring

end Erdos571.HybridCoreCollisions

namespace Erdos571.HybridThreeHubAssignments
open Finset SimpleGraph Matrix GramFeatures GramPin MatchedThreeHubPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ) (k : ℕ)

abbrev ContractedRight (p : Full G L k) := rightHub G L k p=center G L k p

def swapBothEquiv (P : Full G L k → Prop) :
    FiberRestrictionEnergy.Both (Fiber G L k) P ≃
      FiberRestrictionEnergy.Both (Fiber G L k) (P ∘ swapSides G L k) where
  toFun p := ⟨(swapSides G L k p.1.1,swapSides G L k p.1.2),
    congrArg (fun r : Roots (W:=W) k => (r.1,(r.2.2,r.2.1))) p.2.1,p.2.2⟩
  invFun p := ⟨(swapSides G L k p.1.1,swapSides G L k p.1.2),
    congrArg (fun r : Roots (W:=W) k => (r.1,(r.2.2,r.2.1))) p.2.1,p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma contractedRight_card :
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (ContractedRight G L k)):ℝ)=
      HybridCoreCollisions.adjacent (G.adjMatrix ℝ) (endpointKernel G L k) (centralKernel G L k) := by
  have he := Nat.card_congr (swapBothEquiv G L k (ContractedRight G L k))
  change Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (ContractedRight G L k))=
    Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) (ContractedLeft G L k)) at he
  rw [he]
  exact contractedLeft_card G L k

/-- All four core collision predicates, including both adjacent-hub choices. -/
theorem all_core_collision_cubic (M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (P : Full G L k → Prop)
    (hP : P=ContractedLeft G L k ∨ P=ContractedRight G L k ∨ P=SameHubs G L k ∨ P=SameCoreMiddles G L k) :
    let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
    (Nat.card (FiberRestrictionEnergy.Both (Fiber G L k) P):ℝ)^3 ≤
      (2:ℝ)^k*C^(4*k+1)*(K^2+C^2)^3*(Fintype.card W:ℝ)*d^(6*k+8)*
        (Nat.card (Agreement G L k):ℝ)^2 := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let R := N*N.transpose
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  let T := C*d^2
  let Z := centralKernel G L k
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hC : 0 ≤ C := mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg _ _) (sq_nonneg K)
  have hT : 0 ≤ T := mul_nonneg hC (sq_nonneg d)
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := MatchedThreeHub.free_fourth_row_bound (k+1) M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hdiag (u : W) : (d^2/2)^k ≤ Z u u :=
    pow_le_pow_left₀ (by positivity) ((hNrow u).trans (LightArmKernel.gram_diagonal_lower G L u)) k
  have hR : ∀ u v, 0 ≤ R u v := LightArmKernel.gram_nonneg G L
  have hcap (u v : W) : Z u v ≤ T^k :=
    pow_le_pow_left₀ (hR u v) (LightArmKernel.gram_upper G L T hT hrow u v) k
  have hrowA (u : W) : ∑ v, A u v ≤ K*d := by
    rw [ThreeHubKernel.adjacency_row_sum]
    exact hmax u
  have hdegree (u : W) : (A*A) u u=(G.degree u:ℝ) := by
    rw [LayeredBush.adjacency_square_common_card]
    simp only [SimpleGraph.commonNeighbors,Set.inter_self,←SimpleGraph.card_neighborSet_eq_degree]
  rw [agreement_card]
  apply HybridCoreCollisions.uniform_cubic_scale k C K d _ _ _ hd
  apply HybridCoreCollisions.uniform_scaled_cubic A Z G.isSymm_adjMatrix hA
    (fun u v => pow_nonneg (hR u v) k) T (T^k) ((d^2/2)^k) (K*d) d _ hT
    (pow_nonneg hT k) (by positivity) (mul_nonneg hK hd.le) hd.le hrow hrowA
    (fun u => (hdegree u).trans_le (hmax u)) (fun u => (hmin u).trans_eq (hdegree u).symm)
    hcap hdiag (Nat.cast_nonneg _)
  rcases hP with rfl|rfl|rfl|rfl
  · exact Or.inl (contractedLeft_card G L k)
  · exact Or.inl (contractedRight_card G L k)
  · exact Or.inr (Or.inl (sameHubs_card G L k))
  · exact Or.inr (Or.inr (sameMiddles_card G L k))

end Erdos571.HybridThreeHubAssignments


/-! Supporting module: HybridRoleBounds -/
/-! Complete classification of role pins and distinct-role collisions in
the three-hub walk model. All hypotheses are explicit finite count bounds. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

def coreCollision (c : ThreeHubMixed.CoreCollision) : Full k G L → Prop :=
  match c with
  | .centralLeft => HybridThreeHubAssignments.ContractedLeft G L k
  | .centralRight => HybridThreeHubAssignments.ContractedRight G L k
  | .endpoints => HybridThreeHubAssignments.SameHubs G L k
  | .middles => HybridThreeHubAssignments.SameCoreMiddles G L k

abbrev Pin (a : Interior k) := RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k)
  (fun p => interiorValue k G L p a)
abbrev EqualBoth (v w : Vertex k) := FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
  (fun p => value k G L p v=value k G L p w)

lemma equalBoth_symm (v w : Vertex k) : Nat.card (EqualBoth k G L v w)=Nat.card (EqualBoth k G L w v) := by
  have he : (fun p : Full k G L => value k G L p v=value k G L p w)=
      (fun p : Full k G L => value k G L p w=value k G L p v) :=
    funext (fun _ => propext eq_comm)
  exact congrArg (fun P => Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k) P)) he

lemma all_pin_bounds (H : SimpleGraph W) (m cap Δ : ℕ)
    (hk : 2 ≤ m) (hH : H.CliqueFree m) (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (B Z P : ℝ) (hBP : B ≤ P) (hterm : (m-1:ℕ)*(B+(cap*Δ:ℕ)*Z) ≤ P)
    (hcore : ∀ c : Core, (Nat.card (Pin k G L (.inl c)):ℝ) ≤ B)
    (hdel : ∀ r : Arm k, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness k G L r).E):ℝ) ≤ Z) :
    ∀ a : Interior k, (Nat.card (Pin k G L a):ℝ) ≤ P := by
  rintro (c|r)
  · exact (hcore c).trans hBP
  · exact (DeletionWitness.terminal_pin_bound k G L (deletionWitness k G L r)
      H m cap Δ hk hH hdeg hlight B Z (hcore (.inl (hubIndex k r))) (hdel r)).trans hterm

lemma core_equal_bound (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (B : ℝ) (hB : 0 ≤ B)
    (hcore : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (coreCollision k G L c)):ℝ) ≤ B)
    (c d : Core) (hne : c≠d) :
    (Nat.card (EqualBoth k G L (.inl (.inl c)) (.inl (.inl d))):ℝ) ≤ B := by
  rcases c with i|i <;> rcases d with j|j
  · fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · exact hcore .centralLeft
    · exact hcore .endpoints
    · rw [equalBoth_symm]; exact hcore .centralLeft
    · exact (hne rfl).elim
    · rw [equalBoth_symm]; exact hcore .centralRight
    · rw [equalBoth_symm]; exact hcore .endpoints
    · exact hcore .centralRight
    · exact (hne rfl).elim
  · have h := opposite_parity_both_zero k G L g hg (.inl (.inl (.inl i))) (.inl (.inl (.inr j))) (by simp [parity])
    change (Nat.card (EqualBoth k G L _ _):ℝ) ≤ B
    rw [h,Nat.cast_zero]
    exact hB
  · have h := opposite_parity_both_zero k G L g hg (.inl (.inl (.inr i))) (.inl (.inl (.inl j))) (by simp [parity])
    change (Nat.card (EqualBoth k G L _ _):ℝ) ≤ B
    rw [h,Nat.cast_zero]
    exact hB
  · fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · exact hcore .middles
    · rw [equalBoth_symm]; exact hcore .middles
    · exact (hne rfl).elim

/-- Every same-copy collision is a core collision, a retained-role arm
collision, or is excluded by bipartite parity. -/
theorem all_collision_bounds (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (H : SimpleGraph W) (m cap : ℕ) (hk : 2 ≤ m) (hH : H.CliqueFree m)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap) (P Z B : ℝ) (hB : 0 ≤ B)
    (hPB : P ≤ B)
    (hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (HybridThreeHubAssignments.SameFullRoots G L k)):ℝ) ≤ B)
    (hattach : (m-1:ℕ)*(P+cap*Z) ≤ B) (hroot : (cap:ℝ)^2*Z ≤ B)
    (hpin : ∀ a : Interior k, (Nat.card (Pin k G L a):ℝ) ≤ P)
    (hcore : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (coreCollision k G L c)):ℝ) ≤ B)
    (hdel : ∀ r : Arm k, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness k G L r).E):ℝ) ≤ Z) :
    ∀ v w : Vertex k, v≠w → (Nat.card (EqualBoth k G L v w):ℝ) ≤ B := by
  have hrc (r : Arm k) (c : Core) :
      (Nat.card (EqualBoth k G L (.inr r) (.inl (.inl c))):ℝ) ≤ B := by
    classical
    let f : EqualBoth k G L (.inr r) (.inl (.inl c)) → Pin k G L (.inl c) := fun p =>
      ⟨p.1,p.2.1,p.2.2.1.symm.trans ((congrArg (fun labels =>
        HybridThreeHubAssignments.rootLabel k labels ((rootEquiv k).symm r)) p.2.1).trans p.2.2.2)⟩
    have hi : Function.Injective f := by
      intro p q h
      apply Subtype.ext
      exact congrArg (fun x : Pin k G L (.inl c) => x.val) h
    have h : (Nat.card (EqualBoth k G L (.inr r) (.inl (.inl c))):ℝ) ≤
        (Nat.card (Pin k G L (.inl c)):ℝ) := by
      exact_mod_cast (show Nat.card (EqualBoth k G L (.inr r) (.inl (.inl c))) ≤
        Nat.card (Pin k G L (.inl c)) from by
          simpa only [Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hi)
    exact h.trans ((hpin (.inl c)).trans hPB)
  have hrrlight (r : LightArm k) (t : Arm k) (hne : t≠.inl r) :
      (Nat.card (EqualBoth k G L (.inr (.inl r)) (.inr t)):ℝ) ≤ B := by
    exact (DeletionWitness.root_collision_bound k G L (deletionWitness k G L (.inl r)) ⟨r,rfl⟩
      (fun p => rootValue k G L p t) ((deletionWitness k G L (.inl r)).root_retained t hne)
      cap hL hcap Z (hdel (.inl r))).trans hroot
  have hrr (r t : Arm k) (hne : t≠r) :
      (Nat.card (EqualBoth k G L (.inr r) (.inr t)):ℝ) ≤ B := by
    rcases r with r|i
    · exact hrrlight r t hne
    rcases t with t|j
    · rw [equalBoth_symm]
      exact hrrlight t (.inr i) (Ne.symm hne)
    fin_cases i <;> fin_cases j
    · exact (hne rfl).elim
    · exact hjoined
    · rw [equalBoth_symm]; exact hjoined
    · exact (hne rfl).elim
  have htc (r : Arm k) (c : Core) :
      (Nat.card (EqualBoth k G L (.inl (.inr r)) (.inl (.inl c))):ℝ) ≤ B := by
    exact (DeletionWitness.middle_collision_bound k G L (deletionWitness k G L r)
      (fun p => coreValue k G L p c) ((deletionWitness k G L r).core_retained c)
      H m cap hk hH hlight P Z (hpin (.inl c)) (hdel r)).trans hattach
  have htt (r t : Arm k) (hne : t≠r) :
      (Nat.card (EqualBoth k G L (.inl (.inr r)) (.inl (.inr t))):ℝ) ≤ B := by
    exact (DeletionWitness.middle_collision_bound k G L (deletionWitness k G L r)
      (fun p => terminalValue k G L p t) ((deletionWitness k G L r).terminal_retained t hne)
      H m cap hk hH hlight P Z (hpin (.inr t)) (hdel r)).trans hattach
  intro v w hvw
  by_cases he : parity k v=parity k w
  swap
  · have h := opposite_parity_both_zero k G L g hg v w he
    change (Nat.card (EqualBoth k G L v w):ℝ) ≤ B
    rw [h,Nat.cast_zero]
    exact hB
  rcases v with ((i|i)|r)|r <;> rcases w with ((j|j)|t)|t <;> simp only [parity,Bool.false_eq_true,Bool.true_eq_false] at he
  · exact core_equal_bound k G L g hg B hB hcore (.inl i) (.inl j) (fun h => hvw (congrArg (fun c : Core => (Sum.inl (Sum.inl c):Vertex k)) h))
  · rw [equalBoth_symm]; exact hrc t (.inl i)
  · exact core_equal_bound k G L g hg B hB hcore (.inr i) (.inr j) (fun h => hvw (congrArg (fun c : Core => (Sum.inl (Sum.inl c):Vertex k)) h))
  · rw [equalBoth_symm]; exact htc t (.inr i)
  · exact htc r (.inr j)
  · exact htt r t (fun h => hvw (by rw [h]))
  · exact hrc r (.inl j)
  · exact hrr r t (fun h => hvw (by rw [h]))

end Erdos571.HybridRoles


/-! Supporting module: HybridSmallCountCertificate -/
/-! A finite small-count certificate for the hybrid template. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

open Classical in
theorem not_free_of_small_counts (M : ℕ) (hM : 2 ≤ M)
    (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (H : SimpleGraph W) (m cap Δ : ℕ) (hk : 2 ≤ m) (hH : H.CliqueFree m)
    (hdeg : ∀ w, G.degree w ≤ Δ)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap)
    (ε p κ μ : ℝ) (hε : 0 ≤ ε) (hκp : κ ≤ p)
    (hterm : (m-1:ℕ)*(κ+(cap*Δ:ℕ)*μ) ≤ p)
    (hp : p ≤ ε^2) (hε1 : ε^2 ≤ ε)
    (hattach : (m-1:ℕ)*(p+cap*μ) ≤ ε^2) (hroot : (cap:ℝ)^2*μ ≤ ε^2)
    (hsmall : (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
      (A := RootedSubdivision.Nonroot (HybridThreeHub.base k))
      (R := RootedSubdivision.Root (HybridThreeHub.base k))):ℝ)+
        (Nat.card (RootedSubdivision.Nonroot (HybridThreeHub.base k)):ℝ)^2)*ε < 1)
    (hpos : 0 < (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hcore : ∀ c : Core, (Nat.card (Pin k G L (.inl c)):ℝ) ≤
      κ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hcoll : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (coreCollision k G L c)):ℝ) ≤
      κ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (HybridThreeHubAssignments.SameFullRoots G L k)):ℝ) ≤
        ε^2*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hdel : ∀ r : Arm k, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness k G L r).E):ℝ) ≤
      μ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) :
    ¬(HybridThreeHub.graph k M).Free G := by
  classical
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G L k)
  have hE : 0 ≤ E := hpos.le
  have hpin : ∀ a : Interior k, (Nat.card (Pin k G L a):ℝ) ≤ p*E := by
    apply all_pin_bounds k G L H m cap Δ hk hH hdeg hlight (κ*E) (μ*E) (p*E)
      (mul_le_mul_of_nonneg_right hκp hE) _ hcore hdel
    have h := mul_le_mul_of_nonneg_right hterm hE
    nlinarith
  have heq : ∀ v w : Vertex k, v≠w → (Nat.card (EqualBoth k G L v w):ℝ) ≤ ε^2*E := by
    apply all_collision_bounds k G L g hg H m cap hk hH hlight hL hcap (p*E) (μ*E) (ε^2*E)
      (mul_nonneg (sq_nonneg _) hE) (mul_le_mul_of_nonneg_right hp hE) hjoined _ _ hpin _ hdel
    · have h := mul_le_mul_of_nonneg_right hattach hE
      nlinarith
    · have h := mul_le_mul_of_nonneg_right hroot hE
      nlinarith
    · intro c
      exact (hcoll c).trans (mul_le_mul_of_nonneg_right (hκp.trans hp) hE)
  apply HomFamilyEnergy.not_free_of_uniform_energies_nat (HybridThreeHubAssignments.Fiber G L k)
    (HybridThreeHubAssignments.hom G L k) M hM (HybridThreeHubAssignments.same_roots G L k)
    ε hε hsmall hpos
  · intro q
    have he : (fun p : Full k G L => HybridThreeHubAssignments.hom G L k p q.1.1=
        HybridThreeHubAssignments.hom G L k p q.1.2)=
        (fun p => value k G L p (vertexIndex k q.1.1)=value k G L p (vertexIndex k q.1.2)) := by
      funext p
      rw [hom_value,hom_value]
    change (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k) _):ℝ) ≤ _
    rw [he]
    exact heq _ _ (fun h => q.property (vertexIndex_injective k h))
  · intro a
    have he : (fun p : Full k G L => HybridThreeHubAssignments.hom G L k p (.inl a))=
        (fun p => interiorValue k G L p (interiorIndex k a)) := by
      funext p
      exact hom_value k G L p (.inl a)
    change (Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k) _):ℝ) ≤ _
    rw [he]
    exact (hpin _).trans (mul_le_mul_of_nonneg_right (hp.trans hε1) hE)

end Erdos571.HybridRoles


/-! Supporting module: HybridEnergyScales -/
/-! Polynomial energy scaling for the hybrid model. Density converts all
core cubics and deleted-arm moments to small fractions of the same energy. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridScales
open Finset SimpleGraph

lemma energy_lower_scalar (k : ℕ) (n d F E : ℝ) (hn : 0 < n) (hd : 0 ≤ d)
    (hF : n*d^(6*k+8) ≤ (2:ℝ)^(3*k)*F)
    (hE : F^2 ≤ n^(3*k+2)*E) :
    d^(12*k+16) ≤ (2:ℝ)^(6*k)*n^(3*k)*E := by
  have h := pow_le_pow_left₀ (by positivity : 0 ≤ n*d^(6*k+8)) hF 2
  simp only [mul_pow] at h
  have h' := h.trans (mul_le_mul_of_nonneg_left hE (sq_nonneg ((2:ℝ)^(3*k))))
  have hp : ((2:ℝ)^(3*k))^2=(2:ℝ)^(6*k) := by rw [←pow_mul]; congr 1; omega
  have hp' : (d^(6*k+8))^2=d^(12*k+16) := by rw [←pow_mul]; congr 1; omega
  rw [hp,hp'] at h'
  apply (mul_le_mul_iff_right₀ (sq_pos_of_pos hn)).mp
  convert h' using 1 <;> simp only [pow_add] <;> ring

lemma dense_energy_scalar (k : ℕ) (n d E B : ℝ) (hn : 0 < n) (hd : 0 ≤ d)
    (hE : d^(12*k+16) ≤ (2:ℝ)^(6*k)*n^(3*k)*E)
    (hdense : B*n^(3*k+1) ≤ d^(6*k+8)) :
    B*n*d^(6*k+8) ≤ (2:ℝ)^(6*k)*E := by
  apply (mul_le_mul_iff_right₀ (pow_pos hn (3*k))).mp
  calc
    _ = (B*n^(3*k+1))*d^(6*k+8) := by simp only [pow_add,pow_one]; ring
    _ ≤ d^(6*k+8)*d^(6*k+8) := mul_le_mul_of_nonneg_right hdense (pow_nonneg hd _)
    _ = d^(12*k+16) := by rw [←pow_add]; congr 1; omega
    _ ≤ _ := hE
    _ = _ := by ring

lemma power_small (r : ℕ) (hr : 1 ≤ r) (x C n d E B τ H : ℝ) (e : ℕ)
    (hx : 0 ≤ x) (hC : 0 ≤ C) (hE : 0 ≤ E) (hB : 0 < B) (hτ : 0 ≤ τ)
    (hpow : x^r ≤ C*n*d^e*E^(r-1))
    (henergy : B*n*d^e ≤ H*E) (hscale : C*H ≤ τ^r*B) :
    x ≤ τ*E := by
  apply (pow_le_pow_iff_left₀ hx (mul_nonneg hτ hE) (by omega : r≠0)).mp
  apply (mul_le_mul_iff_right₀ hB).mp
  calc
    _ ≤ B*(C*n*d^e*E^(r-1)) := mul_le_mul_of_nonneg_left hpow hB.le
    _ = C*E^(r-1)*(B*n*d^e) := by ring
    _ ≤ C*E^(r-1)*(H*E) := mul_le_mul_of_nonneg_left henergy (mul_nonneg hC (pow_nonneg hE _))
    _ = (C*H)*E^r := by
      conv_rhs => rw [show r=r-1+1 by omega,pow_succ]
      ring
    _ ≤ (τ^r*B)*E^r := mul_le_mul_of_nonneg_right hscale (pow_nonneg hE _)
    _ = _ := by rw [mul_pow]; ring

lemma deleted_degree_scale (k : ℕ) (hk : 6 ≤ k) (Δ C K n d E : ℝ)
    (hC : 0 ≤ C) (hK : 0 ≤ K) (hn : 0 ≤ n) (hd : 1 ≤ d) (hE : 0 ≤ E)
    (h : Δ^k ≤ n*(K*d)^12*(C*d^2)^(2*k+1)*E^(k-1)) :
    (K*d*Δ)^k ≤ (K^(k+12)*C^(2*k+1))*n*d^(6*k+8)*E^(k-1) := by
  have hpow : d^(5*k+14) ≤ d^(6*k+8) := pow_le_pow_right₀ hd (by omega)
  calc
    _ = (K*d)^k*Δ^k := mul_pow _ _ _
    _ ≤ (K*d)^k*(n*(K*d)^12*(C*d^2)^(2*k+1)*E^(k-1)) :=
      mul_le_mul_of_nonneg_left h (pow_nonneg (mul_nonneg hK (by linarith)) _)
    _ = (K^(k+12)*C^(2*k+1))*n*d^(5*k+14)*E^(k-1) := by
      simp only [mul_pow,pow_add,pow_mul,pow_one]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hpow (by positivity)) (pow_nonneg hE _)

variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma free_energy_lower (k M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L) [Nonempty W] :
    d^(12*k+16) ≤ (2:ℝ)^(6*k)*(Fintype.card W:ℝ)^(3*k)*
      (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ) := by
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  let T := C*d^2
  have hrow (u : W) : ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^2 ≤ T := by
    have h := MatchedThreeHub.free_fourth_row_bound (k+1) M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hNrow (u : W) : d^2/2 ≤ ∑ v, LightArmKernel.matrix G L u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  apply energy_lower_scalar k (Fintype.card W:ℝ) d
    (Nat.card (HybridThreeHubAssignments.Full G L k):ℝ) _ (by exact_mod_cast Fintype.card_pos) hd.le _
    (HybridThreeHubAssignments.energy_cauchy G L k)
  have h := mul_le_mul_of_nonneg_left (HybridThreeHubAssignments.full_lower G L k d (d^2/2)
    hd.le (by positivity) hmin hNrow) (by positivity : 0 ≤ (2:ℝ)^(3*k))
  have he : (2:ℝ)^(3*k)*(d^2/2)^(3*k)=(d^2)^(3*k) := by rw [←mul_pow]; congr 1; ring
  calc
    _ = (Fintype.card W:ℝ)*d^8*((2:ℝ)^(3*k)*(d^2/2)^(3*k)) := by
      rw [he]; simp only [pow_add,pow_mul]; ring
    _ = (2:ℝ)^(3*k)*((Fintype.card W:ℝ)*d^8*(d^2/2)^(3*k)) := by ring
    _ ≤ _ := h

lemma free_energy_pos (k M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L) [Nonempty W] :
    0 < (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ) := by
  have h := free_energy_lower G k M hf L d K hL hd hK hdK hmin hmax hcut
  have hp := (pow_pos hd (12*k+16)).trans_le h
  exact (mul_pos_iff.mp hp).resolve_right (fun h => not_lt_of_ge (by positivity) h.1) |>.2

end Erdos571.HybridScales


/-! Supporting module: HybridCountScales -/
/-! Uniform small-count bounds at the matched hybrid degree threshold.
The deletion step is valid for k >= 6. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridScales
open Finset SimpleGraph

noncomputable def coreCoefficient (k M : ℕ) (K : ℝ) : ℝ :=
  (2:ℝ)^k*(MatchedThreeHub.momentCoefficient (k+1) M*K^2)^(4*(k+1))
noncomputable def collisionCoefficient (k M : ℕ) (K : ℝ) : ℝ :=
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  (2:ℝ)^k*C^(4*k+1)*(K^2+C^2)^3
noncomputable def deletionCoefficient (k M : ℕ) (K : ℝ) : ℝ :=
  K^(k+12)*(MatchedThreeHub.momentCoefficient (k+1) M*K^2)^(2*k+1)

theorem exists_scale (k M : ℕ) (K τ : ℝ) (hτ : 0 < τ) :
    ∃ B : ℝ, 1 ≤ B ∧ (4*K)^(6*k+8)<B ∧
      coreCoefficient k M K*(2:ℝ)^(6*k) ≤ τ^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ τ^3*B ∧
      deletionCoefficient k M K*(2:ℝ)^(6*k) ≤ τ^k*B := by
  let X := max (coreCoefficient k M K*(2:ℝ)^(6*k)/τ^3)
    (max (collisionCoefficient k M K*(2:ℝ)^(6*k)/τ^3)
      (deletionCoefficient k M K*(2:ℝ)^(6*k)/τ^k))
  obtain ⟨B,hB⟩ := exists_gt (max 1 (max ((4*K)^(6*k+8)) X))
  have hX : X ≤ B := (le_max_right _ _).trans ((le_max_right _ _).trans hB.le)
  refine ⟨B,(le_max_left _ _).trans hB.le,(le_max_left _ _).trans_lt ((le_max_right _ _).trans_lt hB),?_,?_,?_⟩
  · have h := (div_le_iff₀ (pow_pos hτ 3)).mp ((le_max_left _ _).trans hX)
    simpa only [mul_comm] using h
  · have h := (div_le_iff₀ (pow_pos hτ 3)).mp ((le_max_left _ _).trans ((le_max_right _ _).trans hX))
    simpa only [mul_comm] using h
  · have h := (div_le_iff₀ (pow_pos hτ k)).mp ((le_max_right _ _).trans ((le_max_right _ _).trans hX))
    simpa only [mul_comm] using h

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma deleted_witness_moment (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G) (L D : ℝ) (hD : 0 ≤ D)
    (hmax : ∀ u, (G.degree u:ℝ) ≤ D) (r : HybridRoles.Arm k) :
    (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ)^k ≤
      (Fintype.card W:ℝ)*D^12*(MatchedThreeHub.momentCoefficient (k+1) M*D^2)^(2*k+1)*
        (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)^(k-1) := by
  rcases r with ⟨j,i⟩|j
  · fin_cases j
    · exact HybridMixed.all_deleted_bound G L k M hk hf D hD hmax i _ (Or.inr (Or.inl rfl))
    · exact HybridMixed.all_deleted_bound G L k M hk hf D hD hmax i _ (Or.inl rfl)
    · exact HybridMixed.all_deleted_bound G L k M hk hf D hD hmax i _ (Or.inr (Or.inr rfl))
  · fin_cases j <;> exact HybridMixed.bare_deleted_bound G L k M hk hf D hD hmax

/-- The same density hypothesis simultaneously controls every finite count
needed by the hybrid small-count certificate. -/
theorem all_counts_small (k M : ℕ) (hk : 6 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K τ B : ℝ) (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K)
    (hdK : 4*K ≤ d) (hτ : 0 ≤ τ) (hB : 0 < B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (hscale : coreCoefficient k M K*(2:ℝ)^(6*k) ≤ τ^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ τ^3*B ∧
      deletionCoefficient k M K*(2:ℝ)^(6*k) ≤ τ^k*B)
    (hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8)) :
    (∀ c : HybridRoles.Core, (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤
      τ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤
      τ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ r : HybridRoles.Arm k,
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ) ≤
      (τ/(K*d))*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) := by
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G L k)
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  have hd0 : 0 < d := by linarith
  have hK0 : 0 ≤ K := by linarith
  have hD : 0 < K*d := mul_pos (by linarith) hd0
  have hC : 0 ≤ C := mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg _ _) (sq_nonneg K)
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have henergy := dense_energy_scalar k (Fintype.card W:ℝ) d E B
    (by exact_mod_cast Fintype.card_pos) hd0.le
    (free_energy_lower G k M hf L d K hL hd0 hK0 hdK hmin hmax hcut) hdense
  refine ⟨?_,?_,?_⟩
  · intro c
    apply power_small 3 (by omega) _ (coreCoefficient k M K) (Fintype.card W:ℝ) d E B τ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [coreCoefficient]; positivity) hE hB hτ _ henergy hscale.1
    have h := HybridThreeHubAssignments.all_core_pin_cubic G L k M hf d K hL hd0 hK0 hdK hmin hmax hcut
      (fun p => HybridRoles.coreValue k G L p c) (by
        rcases c with i|i
        · fin_cases i
          · exact Or.inr (Or.inl rfl)
          · exact Or.inl rfl
          · exact Or.inr (Or.inr (Or.inl rfl))
        · fin_cases i
          · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
          · exact Or.inr (Or.inr (Or.inr (Or.inr rfl))))
    simpa only [coreCoefficient,show 6*(k+1)+2=6*k+8 by omega] using h
  · intro c
    apply power_small 3 (by omega) _ (collisionCoefficient k M K) (Fintype.card W:ℝ) d E B τ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [collisionCoefficient]; positivity) hE hB hτ _ henergy hscale.2.1
    exact HybridThreeHubAssignments.all_core_collision_cubic G L k M hf d K hL hd0 hK0 hdK hmin hmax hcut
      (HybridRoles.coreCollision k G L c) (by
        cases c
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl)))
  · intro r
    let Δ : ℝ := Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E)
    have hdel : Δ^k ≤ (Fintype.card W:ℝ)*(K*d)^12*(C*d^2)^(2*k+1)*E^(k-1) := by
      have h := deleted_witness_moment G k M (by omega) hf L (K*d) hD.le hmax r
      convert h using 1 <;> dsimp [C] <;> ring
    have hh := deleted_degree_scale k hk Δ C K (Fintype.card W:ℝ) d E hC hK0
      (Nat.cast_nonneg _) hd hE hdel
    have hsmall := power_small k (by omega) (K*d*Δ) (deletionCoefficient k M K)
      (Fintype.card W:ℝ) d E B τ _ (6*k+8) (mul_nonneg hD.le (Nat.cast_nonneg _))
      (by dsimp [deletionCoefficient]; positivity) hE hB hτ hh henergy hscale.2.2
    calc
      _ ≤ τ*E/(K*d) := (le_div_iff₀ hD).mpr (by nlinarith [hsmall])
      _ = _ := by ring

end Erdos571.HybridScales


/-! Supporting module: HybridFreeDegree -/
/-! Sharp degree bound for matched hybrid three-hub powers, with k >= 6. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridUpper
open Finset SimpleGraph Matrix

theorem free_degree_bound (k M : ℕ) (hk : 6 ≤ k) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K) :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) →
      (MatchedThreeHub.graph (k+1) M).Free G →
      d^(6*k+8) < B*(Fintype.card W:ℝ)^(3*k+1) := by
  classical
  let C := MatchedThreeHub.momentCoefficient (k+1) M
  let m := Fintype.card (MatchedThreeHub.Branch (k+1) M)
  let t := m+Nat.card (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)).edgeSet
  let cap : ℕ := Nat.ceil (4*C*K^2+1+(t:ℝ))
  have hC : 0 ≤ C := MatchedThreeHub.momentCoefficient_nonneg (k+1) M
  have hK0 : 0 ≤ K := by linarith
  have hm : 2 ≤ m := by
    dsimp [m,MatchedThreeHub.Branch]
    simp only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hcap : 4*C*K^2+1+(t:ℝ) ≤ (cap:ℝ) := Nat.le_ceil _
  have hcut : 4*C*K^2 ≤ (cap:ℝ) := by have ht0 : (0:ℝ) ≤ t := Nat.cast_nonneg _; linarith
  have htc : t ≤ cap := by
    have hh : (t:ℝ) ≤ (cap:ℝ) := by nlinarith [mul_nonneg hC (sq_nonneg K)]
    exact_mod_cast hh
  have hcapPos : (0:ℝ) < cap := by nlinarith [mul_nonneg hC (sq_nonneg K),(show (0:ℝ) ≤ t from Nat.cast_nonneg t)]
  let c : ℝ := (m-1:ℕ)
  have hc : 1 ≤ c := by dsimp [c]; exact_mod_cast (show 1 ≤ m-1 by omega)
  let pack : ℝ := (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
    (A := RootedSubdivision.Nonroot (HybridThreeHub.base k))
    (R := RootedSubdivision.Root (HybridThreeHub.base k))):ℝ)+
      (Nat.card (RootedSubdivision.Nonroot (HybridThreeHub.base k)):ℝ)^2)
  have hpack : 0 ≤ pack := by dsimp [pack]; positivity
  obtain ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,hpSmall,hattach,hroot⟩ :=
    MaskedBushCoefficients.choose pack c cap hpack hc (Nat.cast_nonneg _)
  let R := (2*(C*K^2))^k
  have hR : 0 ≤ R := pow_nonneg (by positivity) _
  let σ := τ/(R+1)
  have hσ : 0 < σ := div_pos hτ (by positivity)
  have hστ : σ ≤ τ := (div_le_iff₀ (by positivity : 0<R+1)).mpr (by nlinarith [mul_nonneg hτ.le hR])
  have hRσ : R*σ ≤ τ := by
    have he : σ*(R+1)=τ := div_mul_cancel₀ _ (by positivity)
    nlinarith [hσ.le]
  obtain ⟨B,hB1,hBlarge,hscale⟩ := HybridScales.exists_scale k M K σ hσ
  have hB : 0 < B := by linarith
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G (cap:ℝ) k)
  have hn1 : 1 ≤ n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hn : 0 < n := by linarith
  have hdpos : 0 < d := by linarith
  have hD1 : 1 ≤ D := by dsimp [D]; nlinarith
  have hD : 0 < D := by linarith
  have hd4 : 4*K ≤ d := by
    by_contra hh
    have hdp : d^(6*k+8) ≤ (4*K)^(6*k+8) := pow_le_pow_left₀ hdpos.le (le_of_not_ge hh) _
    have hpow : 1 ≤ n^(3*k+1) := one_le_pow₀ hn1
    have hlow : B ≤ B*n^(3*k+1) := by nlinarith
    exact (not_lt_of_ge ((hdense.trans hdp).trans' hlow)) hBlarge
  have hmax (u : W) : (G.degree u:ℝ) ≤ D := (hdeg u).2
  have hmin (u : W) : d ≤ (G.degree u:ℝ) := (hdeg u).1
  have hEpos : 0 < E := HybridScales.free_energy_pos G k M hf cap d K hcapPos hdpos hK0 hd4 hmin hmax hcut
  obtain ⟨hcoreσ,hcollσ,hdelσ⟩ := HybridScales.all_counts_small G k M hk hf cap d K σ B
    hcapPos hd hK hd4 hσ.le hB hmin hmax hcut hscale hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G (cap:ℝ) (.inl c)):ℝ) ≤ τ*E :=
    (hcoreσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
        (HybridRoles.coreCollision k G (cap:ℝ) c)):ℝ) ≤ τ*E :=
    (hcollσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hdel (r : HybridRoles.Arm k) :
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G (cap:ℝ) r).E):ℝ) ≤ (τ/D)*E :=
    (hdelσ r).trans (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hστ hD.le) hEpos.le)
  have hsub : (ProjectionHeavy.subdivision (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1))).Free G := by
    intro h
    exact hf (IsContained.trans ⟨RootedSubdivision.powerCopy (MatchedThreeHub.base (k+1)) M⟩ h)
  let H := HostHeavyShadow.graph G univ t
  have hH : H.CliqueFree m := HostHeavyShadow.cliqueFree_of_subdivision_free
    (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)) G univ hsub
  have hlight (u v : W) (hnon : ¬H.Adj u v) (hne : u≠v) : Fintype.card (G.commonNeighbors u v) ≤ cap := by
    have ht : (FourthMoment.common G univ u v).card < t := by
      by_contra hh
      exact hnon ⟨hne,le_of_not_gt hh⟩
    rw [HostHeavyShadow.common_univ_card] at ht
    exact ht.le.trans htc
  have hDmax : (G.maxDegree:ℝ) ≤ D := by
    obtain ⟨u,hu⟩ := G.exists_maximal_degree_vertex
    rw [hu]
    exact hmax u
  have hcoef := MaskedBushCoefficients.coefficients c cap G.maxDegree D τ ε hc (Nat.cast_nonneg _)
    hD1 hDmax hτ.le hattach hroot
  have hεsq : ε^2 ≤ ε := by nlinarith
  have hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
      (HybridThreeHubAssignments.SameFullRoots G (cap:ℝ) k)):ℝ) ≤ ε^2*E := by
    have h := HybridThreeHubAssignments.sameFullRoots_bound G (cap:ℝ) k M hf d K hcapPos hdpos hK0 hd4 hmin hmax hcut
    have hp : (Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) ≤ σ*E := hcoreσ (.inl 1)
    calc
      _ ≤ R*(Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) := h
      _ ≤ R*(σ*E) := mul_le_mul_of_nonneg_left hp hR
      _ = (R*σ)*E := by ring
      _ ≤ τ*E := mul_le_mul_of_nonneg_right hRσ hEpos.le
      _ ≤ ε^2*E := mul_le_mul_of_nonneg_right (hcoef.1.trans hpSmall) hEpos.le
  let g : G.Coloring Bool := hb.toColoring (by simp)
  have hfree := HybridRoles.not_free_of_small_counts k G (cap:ℝ) M hM g g.valid
    H m cap G.maxDegree hm hH G.degree_le_maxDegree hlight (Nat.cast_nonneg _) le_rfl
    ε (c*(1+cap)*τ) τ (τ/D) hε.le hcoef.1
    (by simpa only [c,Nat.cast_mul] using hcoef.2.1) hpSmall hεsq hcoef.2.2.1 hcoef.2.2.2
    (by simpa only [pack] using hsmall) hEpos hcore hcoll hjoined hdel
  exact hfree (HybridThreeHub.free_of_matched G k M hf)

end Erdos571.HybridUpper


/-! Supporting module: HybridExtremalUpper -/
/-! Sharp ordinary extremal bounds for matched hybrid three-hub powers. -/
set_option maxHeartbeats 2200000
namespace Erdos571.HybridUpper
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeExponent (k : ℕ) : ℝ := ((3*k+1:ℕ):ℝ)/((6*k+8:ℕ):ℝ)

lemma degreeExponent_pos (k : ℕ) (hs : 1 ≤ k) : 0 < degreeExponent k := by
  unfold degreeExponent
  apply div_pos
  · exact_mod_cast (show 0<3*k+1 by omega)
  · positivity

lemma degreeExponent_le_one (k : ℕ) : degreeExponent k ≤ 1 := by
  unfold degreeExponent
  apply (div_le_one (by positivity : (0:ℝ)<(6*k+8:ℕ))).mpr
  exact_mod_cast (show 3*k+1 ≤ 6*k+8 by omega)

theorem unrestricted_regular_bound (k M : ℕ) (hk : 6 ≤ k) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (MatchedThreeHub.graph (k+1) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent k) := by
  obtain ⟨B,hB,hbound⟩ := free_degree_bound k M hk hM Q hQ
  let C : ℝ := B^((6*k+8:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent k :=
    Real.one_le_rpow hn1 (degreeExponent_pos k (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent k := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (MatchedThreeHub.graph (k+1) M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (6*k+8) (3*k+1) (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent k at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent k) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The sharp exponent holds for every finite forbidden-free host. -/
theorem unrestricted_edge_bound (k M : ℕ) (hk : 6 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (MatchedThreeHub.graph (k+1) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent k) := by
  have hγ : 0 < degreeExponent k := degreeExponent_pos k (by omega)
  have hγ1 : degreeExponent k ≤ 1 := degreeExponent_le_one k
  let K : ℝ := (16:ℝ)^((degreeExponent k)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent k)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := unrestricted_regular_bound k M hk hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (MatchedThreeHub.graph (k+1) M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent k) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb


theorem edge_bound (k M : ℕ) (hk : 6 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (MatchedThreeHub.graph (k+1) M) (1+degreeExponent k) D := by
  obtain ⟨D,hD,h⟩ := unrestricted_edge_bound k M hk hM
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  exact h W inferInstance G inferInstance hf

theorem upper (k M : ℕ) (hk : 6 ≤ k) (hM : 2 ≤ M) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
      (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨D,hD,h⟩ := edge_bound k M hk hM
  exact h.extremal_isBigO _ hD

/-- A fixed matched power has the exact exponent, for every k >= 6. -/
theorem exists_theta (k : ℕ) (hk : 6 ≤ k) :
    ∃ M : ℕ, 2 ≤ M ∧ (MatchedThreeHub.graph (k+1) M).IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
        (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨M,hM,hl⟩ := MatchedThreeHub.exists_lower (k+1) (by omega)
  refine ⟨M,hM,MatchedThreeHub.graph_bipartite _ _,upper k M hk hM,?_⟩
  have he : 2-(3*((k+1:ℕ):ℝ)+4)/(6*((k+1:ℕ):ℝ)+2)=1+degreeExponent k := by
    dsimp [degreeExponent]
    push_cast
    have hden : (6*(k:ℝ)+8)≠0 := by positivity
    field_simp
    ring
  rwa [he] at hl

end Erdos571.HybridUpper


/-! Supporting module: HybridExactFamily -/
/-! Exact rational exponents from the matched hybrid three-hub certificates
and their iterated paired cones. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridUpper
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (k : ℕ) :
    1+degreeExponent k=2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ) := by
  dsimp [degreeExponent]
  have hden : ((6*k+8:ℕ):ℝ)≠0 := by positivity
  field_simp
  push_cast
  ring

theorem supported (k : ℕ) (hk : 6 ≤ k) :
    Supported (MatchedThreeHub.template (k+1)) (2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound k M hk hM
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (k : ℕ) (hk : 6 ≤ k) : Certificate (3*k+7) (6*k+8) := by
  classical
  let H := MatchedThreeHub.base (k+1)
  have hroot : 0 < Fintype.card (MatchedThreeHub.BaseRoot (k+1)) := by
    rw [MatchedThreeHub.base_roots (k+1) (by omega)]
    omega
  letI : Nonempty (MatchedThreeHub.BaseRoot (k+1)) := Fintype.card_pos_iff.mp hroot
  letI : Nonempty (RootedSubdivision.Root H) := ⟨Sum.inl (Classical.arbitrary _)⟩
  refine ⟨RootedSubdivision.Nonroot H,RootedSubdivision.Root H,
    inferInstance,inferInstance,inferInstance,inferInstance,
    MatchedThreeHub.template (k+1),RootedSubdivision.color H,
    RootedSubdivision.color_proper H,MatchedThreeHub.connected (k+1),
    MatchedThreeHub.no_isolated (k+1),?_,supported k hk⟩
  have h := MatchedThreeHub.template_balance (k+1) (by omega)
  simpa only [←Nat.card_eq_fintype_card,show 6*(k+1)+2=6*k+8 by omega,show 3*(k+1)+4=3*k+7 by omega] using h

theorem iterated_certificate (k t : ℕ) (hk : 6 ≤ k) :
    Certificate (3*k+7) (6*k+8+t*(3*k+7)) := by
  induction t with
  | zero => simpa using certificate k hk
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 6*k+8+(t+1)*(3*k+7)=6*k+8+t*(3*k+7)+(3*k+7) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- A proved exact family, not a realization of every rational exponent. -/
theorem exact_family (k t : ℕ) (hk : 6 ≤ k) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(3*k+7:ℚ)/(6*k+8+t*(3*k+7):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate k t hk).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_sixtythree_fortyfourths :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((63/44:ℚ):ℝ)) := by
  have h := exact_family 6 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.HybridUpper


/-! Supporting module: HybridRefinedDeletedMoments -/
/-! A deleted moment can be controlled by its own hub pin via the Gram
structure of the moment weight. This is stronger than the absolute bound. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridGramMoments
open Finset Matrix GramFeatures GramPin
variable {U : Type} [Fintype U] [DecidableEq U]

def IsGram (W : Matrix U U ℝ) : Prop :=
  ∃ (I : Type) (_ : Fintype I) (F : Matrix U I ℝ), W=F*F.transpose

lemma IsGram.self {I : Type} [Fintype I] (F : Matrix U I ℝ) : IsGram (F*F.transpose) :=
  ⟨I,inferInstance,F,rfl⟩

lemma IsGram.product {W Z : Matrix U U ℝ} (hW : IsGram W) (hZ : IsGram Z) :
    IsGram (fun u v => W u v*Z u v) := by
  obtain ⟨I,hI,F,rfl⟩ := hW
  obtain ⟨J,hJ,H,rfl⟩ := hZ
  letI := hI
  letI := hJ
  refine ⟨I×J,inferInstance,(fun u p => F u p.1*H u p.2),?_⟩
  ext u v
  exact (ArmTensor.product_gram F H u v).symm

lemma IsGram.conjugation {W : Matrix U U ℝ} (hW : IsGram W)
    (P : Matrix U U ℝ) (hs : P.IsSymm) : IsGram (P*W*P) := by
  obtain ⟨I,hI,F,rfl⟩ := hW
  letI := hI
  refine ⟨I,inferInstance,P*F,?_⟩
  simp only [Matrix.transpose_mul,hs.eq,Matrix.mul_assoc]

lemma IsGram.power {W : Matrix U U ℝ} (hW : IsGram W) (k : ℕ) : IsGram (entryPower W k) := by
  classical
  obtain ⟨I,hI,F,rfl⟩ := hW
  letI := hI
  refine ⟨Fin k → I,inferInstance,GramFeatures.branch F k,?_⟩
  ext u v
  exact (GramFeatures.kernel_branch F k u v).symm

lemma IsGram.total_le_trace {W : Matrix U U ℝ} (hW : IsGram W) :
    (∑ u, ∑ v, W u v) ≤ (Fintype.card U:ℝ)*(∑ u, W u u) := by
  obtain ⟨I,hI,F,rfl⟩ := hW
  letI := hI
  have hpair (u v : U) : 2*(F*F.transpose) u v ≤ (F*F.transpose) u u+(F*F.transpose) v v := by
    simp only [Matrix.mul_apply,Matrix.transpose_apply,mul_sum,←sum_add_distrib]
    exact sum_le_sum (fun i _ => by nlinarith [sq_nonneg (F u i-F v i)])
  have h := sum_le_sum (s:=(univ : Finset U)) (fun u _ =>
    sum_le_sum (s:=(univ : Finset U)) (fun v _ => hpair u v))
  simp only [sum_add_distrib,sum_const,card_univ,nsmul_eq_mul,←mul_sum] at h
  nlinarith

noncomputable def diagonalMoment (W R : Matrix U U ℝ) (k : ℕ) : ℝ :=
  ∑ u, (R u u)^k*W u u

lemma deletion_by_pin (W R : Matrix U U ℝ) (hgram : IsGram W)
    (hW : ∀ u v, 0 ≤ W u v) (hR : ∀ u v, 0 ≤ R u v)
    (k : ℕ) (hk : 1 ≤ k) (q : ℝ) (hq : 0 ≤ q) (hdiag : ∀ u, q ≤ R u u) :
    q^k*(WeightedPowerMoments.moment (fun p : U×U => W p.1 p.2) (fun p => R p.1 p.2) (k-1))^k ≤
      (Fintype.card U:ℝ)*diagonalMoment W R k*
        (WeightedPowerMoments.moment (fun p : U×U => W p.1 p.2) (fun p => R p.1 p.2) k)^(k-1) := by
  let M := WeightedPowerMoments.moment (fun p : U×U => W p.1 p.2) (fun p => R p.1 p.2)
  have hE : 0 ≤ M k := sum_nonneg (fun p _ => mul_nonneg (hW p.1 p.2) (pow_nonneg (hR p.1 p.2) _))
  have hzero : q^k*M 0 ≤ (Fintype.card U:ℝ)*diagonalMoment W R k := by
    have hd : q^k*(∑ u, W u u) ≤ diagonalMoment W R k := by
      rw [mul_sum]
      exact sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ hq (hdiag u) k) (hW u u))
    calc
      _ = q^k*(∑ u, ∑ v, W u v) := by simp only [M,WeightedPowerMoments.moment,pow_zero,mul_one,Fintype.sum_prod_type]
      _ ≤ q^k*((Fintype.card U:ℝ)*(∑ u, W u u)) := mul_le_mul_of_nonneg_left hgram.total_le_trace (pow_nonneg hq _)
      _ = (Fintype.card U:ℝ)*(q^k*(∑ u, W u u)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hd (Nat.cast_nonneg _)
  have hi := WeightedPowerMoments.interpolation_nonneg
    (fun p : U×U => W p.1 p.2) (fun p => R p.1 p.2)
    (fun p => hW p.1 p.2) (fun p => hR p.1 p.2) k hk
  calc
    _ ≤ q^k*(M 0*(M k)^(k-1)) := mul_le_mul_of_nonneg_left hi (pow_nonneg hq _)
    _ = (q^k*M 0)*(M k)^(k-1) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_right hzero (pow_nonneg hE _)

end Erdos571.HybridGramMoments

namespace Erdos571.HybridDeletedMoments
open Finset Matrix GramFeatures GramPin HybridGramMoments
variable {U : Type} [Fintype U] [DecidableEq U]

lemma bundle_gram (P R : Matrix U U ℝ) (hs : P.IsSymm) (hR : IsGram R) (k : ℕ) : IsGram (bundle P R k) := by
  have hP : IsGram (P*P) := by simpa only [hs.eq] using IsGram.self P
  exact (hR.power k).product hP

lemma chain_gram (P R : Matrix U U ℝ) (hs : P.IsSymm) (hR : IsGram R) (k : ℕ) : IsGram (chain P R k) :=
  (bundle_gram P R hs hR k).conjugation P hs

noncomputable def endpointWeight (P R : Matrix U U ℝ) (k : ℕ) : Matrix U U ℝ :=
  fun u v => (P*weightKernel P R k*P) u v*(P*P) u v

lemma endpointWeight_gram (P R : Matrix U U ℝ) (hs : P.IsSymm) (hR : IsGram R) (k : ℕ) :
    IsGram (endpointWeight P R k) := by
  have hP : IsGram (P*P) := by simpa only [hs.eq] using IsGram.self P
  exact (((hR.power k).product (chain_gram P R hs hR k)).conjugation P hs).product hP

lemma endpoint_diagonal (A R : Matrix U U ℝ) (hs : A.IsSymm) (k : ℕ) :
    diagonalMoment (endpointWeight (A*A) R k) R k=
      MatchedThreeHubPin.endpointPin A (bundle (A*A) R k) (entryPower R k) := by
  have hsP : (A*A).IsSymm := by show (A*A).transpose=_; rw [Matrix.transpose_mul,hs.eq]
  have h := ThreeHubKernel.conjugation_inner_swap (A*A) (weightKernel (A*A) R k)
    (Matrix.diagonal (fun u => bundle (A*A) R k u u)) hsP
  change _=∑ u, ∑ v, weightKernel (A*A) R k u v*
    ((A*A)*Matrix.diagonal (fun u => bundle (A*A) R k u u)*(A*A)) u v
  rw [h]
  simp only [Matrix.diagonal_apply,mul_ite,mul_zero,Finset.sum_ite_eq,mem_univ,if_true]
  exact sum_congr rfl (fun u _ => by dsimp [diagonalMoment,endpointWeight,bundle]; ring)

/-- The center-deleted moment is controlled by the center pin. -/
lemma center_deleted_pin (A R : Matrix U U ℝ) (hs : A.IsSymm)
    (hR : ∀ u v, 0 ≤ R u v) (hGram : IsGram R)
    (k : ℕ) (hk : 1 ≤ k) (q : ℝ) (hq : 0 ≤ q) (hdiag : ∀ u, q ≤ R u u) :
    q^k*(centerMoment (A*A) R k (k-1))^k ≤
      (Fintype.card U:ℝ)*MatchedThreeHubPin.pin A (bundle (A*A) R k) (entryPower R k)*
        (energy (A*A) R k)^(k-1) := by
  have hsP : (A*A).IsSymm := by show (A*A).transpose=_; rw [Matrix.transpose_mul,hs.eq]
  let C := chain (A*A) R k
  have hC := chain_gram (A*A) R hsP hGram k
  have h := deletion_by_pin (fun u v => (C u v)^2) R
    (by simpa only [pow_two] using hC.product hC) (fun _ _ => sq_nonneg _) hR k hk q hq hdiag
  simpa only [WeightedPowerMoments.moment,Fintype.sum_prod_type,diagonalMoment,
    centerMoment,energy,MatchedThreeHubPin.pin,entryPower,mul_comm] using h

/-- The endpoint-deleted moment is controlled by its endpoint hub pin. -/
lemma endpoint_deleted_pin (A R : Matrix U U ℝ) (hs : A.IsSymm)
    (hA : ∀ u v, 0 ≤ A u v) (hR : ∀ u v, 0 ≤ R u v) (hGram : IsGram R)
    (k : ℕ) (hk : 1 ≤ k) (q : ℝ) (hq : 0 ≤ q) (hdiag : ∀ u, q ≤ R u u) :
    q^k*(endpointMoment (A*A) R k (k-1))^k ≤
      (Fintype.card U:ℝ)*MatchedThreeHubPin.endpointPin A (bundle (A*A) R k) (entryPower R k)*
        (energy (A*A) R k)^(k-1) := by
  have hsP : (A*A).IsSymm := by show (A*A).transpose=_; rw [Matrix.transpose_mul,hs.eq]
  have hP := chain_nonneg hA hA
  have hB (u v : U) : 0 ≤ bundle (A*A) R k u v :=
    mul_nonneg (pow_nonneg (hR u v) k) (chain_nonneg hP hP u v)
  have hC := chain_nonneg (chain_nonneg hP hB) hP
  have hW (u v : U) : 0 ≤ endpointWeight (A*A) R k u v :=
    mul_nonneg (chain_nonneg (chain_nonneg hP (fun u v =>
      mul_nonneg (pow_nonneg (hR u v) k) (hC u v))) hP u v) (chain_nonneg hP hP u v)
  have h := deletion_by_pin (endpointWeight (A*A) R k) R (endpointWeight_gram (A*A) R hsP hGram k)
    hW hR k hk q hq hdiag
  rw [endpoint_diagonal A R hs k] at h
  change q^k*(WeightedPowerMoments.moment (fun p : U×U =>
    ((A*A)*weightKernel (A*A) R k*(A*A)) p.1 p.2*((A*A)*(A*A)) p.1 p.2) (fun p => R p.1 p.2) (k-1))^k ≤ _ at h
  rw [←endpoint_as_moment (A*A) R hsP k (k-1)] at h
  change q^k*(endpointMoment (A*A) R k (k-1))^k ≤ _*
    (WeightedPowerMoments.moment (fun p : U×U =>
      ((A*A)*weightKernel (A*A) R k*(A*A)) p.1 p.2*((A*A)*(A*A)) p.1 p.2) (fun p => R p.1 p.2) k)^(k-1) at h
  rw [←endpoint_as_moment (A*A) R hsP k k,endpoint_self] at h
  exact h

end Erdos571.HybridDeletedMoments


/-! Supporting module: HybridRefinedDeletedGraph -/
/-! Finite pin-controlled deletion bounds for every hybrid terminal arm. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRefinedScales
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma free_deleted_pin (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (r : HybridRoles.Arm k) :
    (d^2/2)^k*(Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ)^k ≤
      (Fintype.card W:ℝ)*(Nat.card (HybridRoles.Pin k G L (.inl (.inl (HybridRoles.hubIndex k r)))):ℝ)*
        (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)^(k-1) := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let R := N*N.transpose
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  let T := C*d^2
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := MatchedThreeHub.free_fourth_row_bound (k+1) M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hdiag (u : W) : d^2/2 ≤ R u u :=
    (hNrow u).trans (LightArmKernel.gram_diagonal_lower G L u)
  have hc := HybridDeletedMoments.center_deleted_pin A R G.isSymm_adjMatrix
    (LightArmKernel.gram_nonneg G L) (HybridGramMoments.IsGram.self N) k hk (d^2/2) (by positivity) hdiag
  have he := HybridDeletedMoments.endpoint_deleted_pin A R G.isSymm_adjMatrix hA
    (LightArmKernel.gram_nonneg G L) (HybridGramMoments.IsGram.self N) k hk (d^2/2) (by positivity) hdiag
  have hb : (d^2/2)^k*(Nat.card (HybridMixed.BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ)^k ≤
      (Fintype.card W:ℝ)*MatchedThreeHubPin.endpointPin A (HybridDeletedMoments.bundle (A*A) R k) (entryPower R k)*
        (HybridDeletedMoments.energy (A*A) R k)^(k-1) :=
    (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg _) (HybridMixed.bare_agreement_le G L k hk) k)
      (by positivity : 0 ≤ (d^2/2)^k)).trans he
  rcases r with ⟨j,i⟩|j
  · fin_cases j
    · change (d^2/2)^k*(Nat.card (HybridMixed.Agreement G L (Fin k) (MaskedBush.Without i) (Fin k)):ℝ)^k ≤
        _*(Nat.card (HybridThreeHubAssignments.Pin G L k (HybridThreeHubAssignments.leftHub G L k)):ℝ)*_
      rw [HybridMixed.left_deleted_card,HybridThreeHubAssignments.left_pin_card,HybridMixed.symmetric_energy]
      exact he
    · change (d^2/2)^k*(Nat.card (HybridMixed.Agreement G L (MaskedBush.Without i) (Fin k) (Fin k)):ℝ)^k ≤
        _*(Nat.card (HybridThreeHubAssignments.Pin G L k (HybridThreeHubAssignments.center G L k)):ℝ)*_
      rw [HybridMixed.central_deleted_card,HybridThreeHubAssignments.center_pin_card,HybridMixed.symmetric_energy]
      exact hc
    · change (d^2/2)^k*(Nat.card (HybridMixed.Agreement G L (Fin k) (Fin k) (MaskedBush.Without i)):ℝ)^k ≤
        _*(Nat.card (HybridThreeHubAssignments.Pin G L k (HybridThreeHubAssignments.rightHub G L k)):ℝ)*_
      rw [HybridMixed.right_deleted_card,HybridThreeHubAssignments.right_pin_card,HybridMixed.symmetric_energy]
      exact he
  · fin_cases j
    · change (d^2/2)^k*(Nat.card (HybridMixed.BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ)^k ≤
        _*(Nat.card (HybridThreeHubAssignments.Pin G L k (HybridThreeHubAssignments.leftHub G L k)):ℝ)*_
      rw [HybridThreeHubAssignments.left_pin_card,HybridMixed.symmetric_energy]
      exact hb
    · change (d^2/2)^k*(Nat.card (HybridMixed.BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ)^k ≤
        _*(Nat.card (HybridThreeHubAssignments.Pin G L k (HybridThreeHubAssignments.rightHub G L k)):ℝ)*_
      rw [HybridThreeHubAssignments.right_pin_card,HybridMixed.symmetric_energy]
      exact hb

end Erdos571.HybridRefinedScales


/-! Supporting module: HybridRefinedCountScales -/
/-! Pin-controlled deletion reduces the matched-family threshold from k>=6
to k>=3. The same density and energy are used throughout. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRefinedScales
open Finset SimpleGraph HybridScales

lemma order_le_degree_power (k : ℕ) (hk : 3 ≤ k) (n d B : ℝ)
    (hn : 0 ≤ n) (hd : 1 ≤ d) (hB : 1 ≤ B)
    (hdense : B*n^(3*k+1) ≤ d^(6*k+8)) : n ≤ d^k := by
  have he : 6*k+8 ≤ k*(3*k+1) := by nlinarith [Nat.mul_le_mul_right k hk]
  apply (pow_le_pow_iff_left₀ hn (pow_nonneg (by linarith : 0 ≤ d) k) (by omega : 3*k+1≠0)).mp
  calc
    _ ≤ B*n^(3*k+1) := by nlinarith [pow_nonneg hn (3*k+1)]
    _ ≤ _ := hdense
    _ ≤ d^(k*(3*k+1)) := pow_le_pow_right₀ hd he
    _ = _ := pow_mul _ _ _

lemma deleted_by_pin_scale (k : ℕ) (Δ n d K p E : ℝ)
    (hd : 0 < d) (hK : 0 ≤ K) (hp : 0 ≤ p) (hE : 0 ≤ E) (hn : n ≤ d^k)
    (h : (d^2/2)^k*Δ^k ≤ n*p*E^(k-1)) :
    (K*d*Δ)^k ≤ (2*K)^k*p*E^(k-1) := by
  have h' := mul_le_mul_of_nonneg_left h (by positivity : 0 ≤ (2*K)^k)
  have he : (2*K)^k*(d^2/2)^k=(K*d^2)^k := by rw [←mul_pow]; congr 1; ring
  apply (mul_le_mul_iff_right₀ (pow_pos hd k)).mp
  calc
    _ = (2*K)^k*((d^2/2)^k*Δ^k) := by
      rw [←mul_assoc,he]
      simp only [mul_pow]; ring
    _ ≤ _ := h'
    _ ≤ (2*K)^k*(d^k*p*E^(k-1)) := mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hn hp) (pow_nonneg hE _))
      (pow_nonneg (mul_nonneg (by norm_num) hK) _)
    _ = _ := by ring

noncomputable def pinTolerance (k : ℕ) (K τ : ℝ) : ℝ := min τ ((τ/(2*K))^k)

lemma pinTolerance_pos (k : ℕ) (K τ : ℝ) (hK : 0 < K) (hτ : 0 < τ) :
    0 < pinTolerance k K τ := lt_min hτ (pow_pos (div_pos hτ (by positivity)) _)

lemma pinTolerance_scale (k : ℕ) (K τ : ℝ) (hK : 0 < K) :
    (2*K)^k*pinTolerance k K τ ≤ τ^k := by
  have h := mul_le_mul_of_nonneg_left (min_le_right τ ((τ/(2*K))^k))
    (pow_nonneg (by positivity : 0 ≤ 2*K) k)
  have he : (2*K)^k*(τ/(2*K))^k=τ^k := by
    rw [←mul_pow]
    congr 1
    field_simp
  exact h.trans_eq he

theorem exists_scale (k M : ℕ) (K τ : ℝ) (hK : 0 < K) (hτ : 0 < τ) :
    ∃ B : ℝ, 1 ≤ B ∧ (4*K)^(6*k+8)<B ∧
      coreCoefficient k M K*(2:ℝ)^(6*k) ≤ (pinTolerance k K τ)^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ (pinTolerance k K τ)^3*B := by
  obtain ⟨B,hB,hlarge,hcore,hcoll,hdel⟩ := HybridScales.exists_scale k M K (pinTolerance k K τ)
    (pinTolerance_pos k K τ hK hτ)
  exact ⟨B,hB,hlarge,hcore,hcoll⟩

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem all_counts_small (k M : ℕ) (hk : 3 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K τ B : ℝ) (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K)
    (hdK : 4*K ≤ d) (hτ : 0 ≤ τ) (hB : 1 ≤ B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (hscale : coreCoefficient k M K*(2:ℝ)^(6*k) ≤ (pinTolerance k K τ)^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ (pinTolerance k K τ)^3*B)
    (hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8)) :
    (∀ c : HybridRoles.Core, (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤
      τ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤
      τ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ r : HybridRoles.Arm k,
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ) ≤
      (τ/(K*d))*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) := by
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G L k)
  let κ := pinTolerance k K τ
  have hd0 : 0 < d := by linarith
  have hK0 : 0 < K := by linarith
  have hD : 0 < K*d := mul_pos hK0 hd0
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have hC : 0 ≤ MatchedThreeHub.momentCoefficient (k+1) M*K^2 :=
    mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg _ _) (sq_nonneg K)
  have hB0 : 0 < B := by linarith
  have hκ : 0 ≤ κ := le_min hτ (pow_nonneg (div_nonneg hτ (by positivity)) _)
  have hκτ : κ ≤ τ := min_le_left _ _
  have henergy := dense_energy_scalar k (Fintype.card W:ℝ) d E B
    (by exact_mod_cast Fintype.card_pos) hd0.le
    (free_energy_lower G k M hf L d K hL hd0 hK0.le hdK hmin hmax hcut) hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤ κ*E := by
    apply power_small 3 (by omega) _ (coreCoefficient k M K) (Fintype.card W:ℝ) d E B κ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [coreCoefficient]; positivity) hE hB0 hκ _ henergy hscale.1
    have h := HybridThreeHubAssignments.all_core_pin_cubic G L k M hf d K hL hd0 hK0.le hdK hmin hmax hcut
      (fun p => HybridRoles.coreValue k G L p c) (by
        rcases c with i|i
        · fin_cases i
          · exact Or.inr (Or.inl rfl)
          · exact Or.inl rfl
          · exact Or.inr (Or.inr (Or.inl rfl))
        · fin_cases i
          · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
          · exact Or.inr (Or.inr (Or.inr (Or.inr rfl))))
    simpa only [coreCoefficient,show 6*(k+1)+2=6*k+8 by omega] using h
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤ κ*E := by
    apply power_small 3 (by omega) _ (collisionCoefficient k M K) (Fintype.card W:ℝ) d E B κ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [collisionCoefficient]; positivity) hE hB0 hκ _ henergy hscale.2
    exact HybridThreeHubAssignments.all_core_collision_cubic G L k M hf d K hL hd0 hK0.le hdK hmin hmax hcut
      (HybridRoles.coreCollision k G L c) (by
        cases c
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl)))
  refine ⟨fun c => (hcore c).trans (mul_le_mul_of_nonneg_right hκτ hE),
    fun c => (hcoll c).trans (mul_le_mul_of_nonneg_right hκτ hE),?_⟩
  intro r
  let Δ : ℝ := Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E)
  let p : ℝ := Nat.card (HybridRoles.Pin k G L (.inl (.inl (HybridRoles.hubIndex k r))))
  have hdel := free_deleted_pin G k M (by omega) hf L d K hL hd0 hK0.le hdK hmin hmax hcut r
  have hn := order_le_degree_power k hk (Fintype.card W:ℝ) d B (Nat.cast_nonneg _) hd hB hdense
  have hh := deleted_by_pin_scale k Δ (Fintype.card W:ℝ) d K p E hd0 hK0.le (Nat.cast_nonneg _) hE hn hdel
  have hsmall : K*d*Δ ≤ τ*E := by
    apply (pow_le_pow_iff_left₀ (mul_nonneg hD.le (Nat.cast_nonneg _)) (mul_nonneg hτ hE) (by omega : k≠0)).mp
    calc
      _ ≤ _ := hh
      _ ≤ (2*K)^k*(κ*E)*E^(k-1) := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hcore (.inl (HybridRoles.hubIndex k r))) (by positivity)) (pow_nonneg hE _)
      _ = ((2*K)^k*κ)*E^k := by
        have hEe : E*E^(k-1)=E^k := by rw [←pow_succ']; congr 1; omega
        rw [←hEe]
        ring
      _ ≤ τ^k*E^k := mul_le_mul_of_nonneg_right (pinTolerance_scale k K τ hK0) (pow_nonneg hE _)
      _ = _ := (mul_pow _ _ _).symm
  calc
    _ ≤ τ*E/(K*d) := (le_div_iff₀ hD).mpr (by nlinarith [hsmall])
    _ = _ := by ring

end Erdos571.HybridRefinedScales


/-! Supporting module: HybridRefinedFreeDegree -/
/-! Sharp degree bound for matched hybrid three-hub powers, with k >= 3. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRefinedUpper
open Finset SimpleGraph Matrix

theorem free_degree_bound (k M : ℕ) (hk : 3 ≤ k) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K) :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) →
      (MatchedThreeHub.graph (k+1) M).Free G →
      d^(6*k+8) < B*(Fintype.card W:ℝ)^(3*k+1) := by
  classical
  let C := MatchedThreeHub.momentCoefficient (k+1) M
  let m := Fintype.card (MatchedThreeHub.Branch (k+1) M)
  let t := m+Nat.card (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)).edgeSet
  let cap : ℕ := Nat.ceil (4*C*K^2+1+(t:ℝ))
  have hC : 0 ≤ C := MatchedThreeHub.momentCoefficient_nonneg (k+1) M
  have hK0 : 0 ≤ K := by linarith
  have hm : 2 ≤ m := by
    dsimp [m,MatchedThreeHub.Branch]
    simp only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hcap : 4*C*K^2+1+(t:ℝ) ≤ (cap:ℝ) := Nat.le_ceil _
  have hcut : 4*C*K^2 ≤ (cap:ℝ) := by have ht0 : (0:ℝ) ≤ t := Nat.cast_nonneg _; linarith
  have htc : t ≤ cap := by
    have hh : (t:ℝ) ≤ (cap:ℝ) := by nlinarith [mul_nonneg hC (sq_nonneg K)]
    exact_mod_cast hh
  have hcapPos : (0:ℝ) < cap := by nlinarith [mul_nonneg hC (sq_nonneg K),(show (0:ℝ) ≤ t from Nat.cast_nonneg t)]
  let c : ℝ := (m-1:ℕ)
  have hc : 1 ≤ c := by dsimp [c]; exact_mod_cast (show 1 ≤ m-1 by omega)
  let pack : ℝ := (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
    (A := RootedSubdivision.Nonroot (HybridThreeHub.base k))
    (R := RootedSubdivision.Root (HybridThreeHub.base k))):ℝ)+
      (Nat.card (RootedSubdivision.Nonroot (HybridThreeHub.base k)):ℝ)^2)
  have hpack : 0 ≤ pack := by dsimp [pack]; positivity
  obtain ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,hpSmall,hattach,hroot⟩ :=
    MaskedBushCoefficients.choose pack c cap hpack hc (Nat.cast_nonneg _)
  let R := (2*(C*K^2))^k
  have hR : 0 ≤ R := pow_nonneg (by positivity) _
  let σ := τ/(R+1)
  have hσ : 0 < σ := div_pos hτ (by positivity)
  have hστ : σ ≤ τ := (div_le_iff₀ (by positivity : 0<R+1)).mpr (by nlinarith [mul_nonneg hτ.le hR])
  have hRσ : R*σ ≤ τ := by
    have he : σ*(R+1)=τ := div_mul_cancel₀ _ (by positivity)
    nlinarith [hσ.le]
  obtain ⟨B,hB1,hBlarge,hscale⟩ := HybridRefinedScales.exists_scale k M K σ (by linarith) hσ
  have hB : 0 < B := by linarith
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G (cap:ℝ) k)
  have hn1 : 1 ≤ n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hn : 0 < n := by linarith
  have hdpos : 0 < d := by linarith
  have hD1 : 1 ≤ D := by dsimp [D]; nlinarith
  have hD : 0 < D := by linarith
  have hd4 : 4*K ≤ d := by
    by_contra hh
    have hdp : d^(6*k+8) ≤ (4*K)^(6*k+8) := pow_le_pow_left₀ hdpos.le (le_of_not_ge hh) _
    have hpow : 1 ≤ n^(3*k+1) := one_le_pow₀ hn1
    have hlow : B ≤ B*n^(3*k+1) := by nlinarith
    exact (not_lt_of_ge ((hdense.trans hdp).trans' hlow)) hBlarge
  have hmax (u : W) : (G.degree u:ℝ) ≤ D := (hdeg u).2
  have hmin (u : W) : d ≤ (G.degree u:ℝ) := (hdeg u).1
  have hEpos : 0 < E := HybridScales.free_energy_pos G k M hf cap d K hcapPos hdpos hK0 hd4 hmin hmax hcut
  obtain ⟨hcoreσ,hcollσ,hdelσ⟩ := HybridRefinedScales.all_counts_small G k M hk hf cap d K σ B
    hcapPos hd hK hd4 hσ.le hB1 hmin hmax hcut hscale hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G (cap:ℝ) (.inl c)):ℝ) ≤ τ*E :=
    (hcoreσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
        (HybridRoles.coreCollision k G (cap:ℝ) c)):ℝ) ≤ τ*E :=
    (hcollσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hdel (r : HybridRoles.Arm k) :
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G (cap:ℝ) r).E):ℝ) ≤ (τ/D)*E :=
    (hdelσ r).trans (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hστ hD.le) hEpos.le)
  have hsub : (ProjectionHeavy.subdivision (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1))).Free G := by
    intro h
    exact hf (IsContained.trans ⟨RootedSubdivision.powerCopy (MatchedThreeHub.base (k+1)) M⟩ h)
  let H := HostHeavyShadow.graph G univ t
  have hH : H.CliqueFree m := HostHeavyShadow.cliqueFree_of_subdivision_free
    (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)) G univ hsub
  have hlight (u v : W) (hnon : ¬H.Adj u v) (hne : u≠v) : Fintype.card (G.commonNeighbors u v) ≤ cap := by
    have ht : (FourthMoment.common G univ u v).card < t := by
      by_contra hh
      exact hnon ⟨hne,le_of_not_gt hh⟩
    rw [HostHeavyShadow.common_univ_card] at ht
    exact ht.le.trans htc
  have hDmax : (G.maxDegree:ℝ) ≤ D := by
    obtain ⟨u,hu⟩ := G.exists_maximal_degree_vertex
    rw [hu]
    exact hmax u
  have hcoef := MaskedBushCoefficients.coefficients c cap G.maxDegree D τ ε hc (Nat.cast_nonneg _)
    hD1 hDmax hτ.le hattach hroot
  have hεsq : ε^2 ≤ ε := by nlinarith
  have hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
      (HybridThreeHubAssignments.SameFullRoots G (cap:ℝ) k)):ℝ) ≤ ε^2*E := by
    have h := HybridThreeHubAssignments.sameFullRoots_bound G (cap:ℝ) k M hf d K hcapPos hdpos hK0 hd4 hmin hmax hcut
    have hp : (Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) ≤ σ*E := hcoreσ (.inl 1)
    calc
      _ ≤ R*(Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) := h
      _ ≤ R*(σ*E) := mul_le_mul_of_nonneg_left hp hR
      _ = (R*σ)*E := by ring
      _ ≤ τ*E := mul_le_mul_of_nonneg_right hRσ hEpos.le
      _ ≤ ε^2*E := mul_le_mul_of_nonneg_right (hcoef.1.trans hpSmall) hEpos.le
  let g : G.Coloring Bool := hb.toColoring (by simp)
  have hfree := HybridRoles.not_free_of_small_counts k G (cap:ℝ) M hM g g.valid
    H m cap G.maxDegree hm hH G.degree_le_maxDegree hlight (Nat.cast_nonneg _) le_rfl
    ε (c*(1+cap)*τ) τ (τ/D) hε.le hcoef.1
    (by simpa only [c,Nat.cast_mul] using hcoef.2.1) hpSmall hεsq hcoef.2.2.1 hcoef.2.2.2
    (by simpa only [pack] using hsmall) hEpos hcore hcoll hjoined hdel
  exact hfree (HybridThreeHub.free_of_matched G k M hf)

end Erdos571.HybridRefinedUpper


/-! Supporting module: HybridRefinedExtremalUpper -/
/-! Sharp ordinary extremal bounds for matched hybrid three-hub powers. -/
set_option maxHeartbeats 2200000
namespace Erdos571.HybridRefinedUpper
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeExponent (k : ℕ) : ℝ := ((3*k+1:ℕ):ℝ)/((6*k+8:ℕ):ℝ)

lemma degreeExponent_pos (k : ℕ) (hs : 1 ≤ k) : 0 < degreeExponent k := by
  unfold degreeExponent
  apply div_pos
  · exact_mod_cast (show 0<3*k+1 by omega)
  · positivity

lemma degreeExponent_le_one (k : ℕ) : degreeExponent k ≤ 1 := by
  unfold degreeExponent
  apply (div_le_one (by positivity : (0:ℝ)<(6*k+8:ℕ))).mpr
  exact_mod_cast (show 3*k+1 ≤ 6*k+8 by omega)

theorem unrestricted_regular_bound (k M : ℕ) (hk : 3 ≤ k) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (MatchedThreeHub.graph (k+1) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent k) := by
  obtain ⟨B,hB,hbound⟩ := free_degree_bound k M hk hM Q hQ
  let C : ℝ := B^((6*k+8:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent k :=
    Real.one_le_rpow hn1 (degreeExponent_pos k (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent k := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (MatchedThreeHub.graph (k+1) M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (6*k+8) (3*k+1) (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent k at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent k) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The sharp exponent holds for every finite forbidden-free host. -/
theorem unrestricted_edge_bound (k M : ℕ) (hk : 3 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (MatchedThreeHub.graph (k+1) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent k) := by
  have hγ : 0 < degreeExponent k := degreeExponent_pos k (by omega)
  have hγ1 : degreeExponent k ≤ 1 := degreeExponent_le_one k
  let K : ℝ := (16:ℝ)^((degreeExponent k)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent k)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := unrestricted_regular_bound k M hk hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (MatchedThreeHub.graph (k+1) M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent k) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb


theorem edge_bound (k M : ℕ) (hk : 3 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (MatchedThreeHub.graph (k+1) M) (1+degreeExponent k) D := by
  obtain ⟨D,hD,h⟩ := unrestricted_edge_bound k M hk hM
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  exact h W inferInstance G inferInstance hf

theorem upper (k M : ℕ) (hk : 3 ≤ k) (hM : 2 ≤ M) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
      (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨D,hD,h⟩ := edge_bound k M hk hM
  exact h.extremal_isBigO _ hD

/-- A fixed matched power has the exact exponent, for every k >= 3. -/
theorem exists_theta (k : ℕ) (hk : 3 ≤ k) :
    ∃ M : ℕ, 2 ≤ M ∧ (MatchedThreeHub.graph (k+1) M).IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
        (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨M,hM,hl⟩ := MatchedThreeHub.exists_lower (k+1) (by omega)
  refine ⟨M,hM,MatchedThreeHub.graph_bipartite _ _,upper k M hk hM,?_⟩
  have he : 2-(3*((k+1:ℕ):ℝ)+4)/(6*((k+1:ℕ):ℝ)+2)=1+degreeExponent k := by
    dsimp [degreeExponent]
    push_cast
    have hden : (6*(k:ℝ)+8)≠0 := by positivity
    field_simp
    ring
  rwa [he] at hl

end Erdos571.HybridRefinedUpper


/-! Supporting module: HybridRefinedExactFamily -/
/-! Exact rational exponents from the matched hybrid three-hub certificates
and their iterated paired cones. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRefinedUpper
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (k : ℕ) :
    1+degreeExponent k=2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ) := by
  dsimp [degreeExponent]
  have hden : ((6*k+8:ℕ):ℝ)≠0 := by positivity
  field_simp
  push_cast
  ring

theorem supported (k : ℕ) (hk : 3 ≤ k) :
    Supported (MatchedThreeHub.template (k+1)) (2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound k M hk hM
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (k : ℕ) (hk : 3 ≤ k) : Certificate (3*k+7) (6*k+8) := by
  classical
  let H := MatchedThreeHub.base (k+1)
  have hroot : 0 < Fintype.card (MatchedThreeHub.BaseRoot (k+1)) := by
    rw [MatchedThreeHub.base_roots (k+1) (by omega)]
    omega
  letI : Nonempty (MatchedThreeHub.BaseRoot (k+1)) := Fintype.card_pos_iff.mp hroot
  letI : Nonempty (RootedSubdivision.Root H) := ⟨Sum.inl (Classical.arbitrary _)⟩
  refine ⟨RootedSubdivision.Nonroot H,RootedSubdivision.Root H,
    inferInstance,inferInstance,inferInstance,inferInstance,
    MatchedThreeHub.template (k+1),RootedSubdivision.color H,
    RootedSubdivision.color_proper H,MatchedThreeHub.connected (k+1),
    MatchedThreeHub.no_isolated (k+1),?_,supported k hk⟩
  have h := MatchedThreeHub.template_balance (k+1) (by omega)
  simpa only [←Nat.card_eq_fintype_card,show 6*(k+1)+2=6*k+8 by omega,show 3*(k+1)+4=3*k+7 by omega] using h

theorem iterated_certificate (k t : ℕ) (hk : 3 ≤ k) :
    Certificate (3*k+7) (6*k+8+t*(3*k+7)) := by
  induction t with
  | zero => simpa using certificate k hk
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 6*k+8+(t+1)*(3*k+7)=6*k+8+t*(3*k+7)+(3*k+7) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- A proved exact family, not a realization of every rational exponent. -/
theorem exact_family (k t : ℕ) (hk : 3 ≤ k) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(3*k+7:ℚ)/(6*k+8+t*(3*k+7):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate k t hk).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_eighteen_thirteenths :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((18/13:ℚ):ℝ)) := by
  have h := exact_family 3 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.HybridRefinedUpper



/-! Supporting module: NonnegativeGramMoments -/

/-! Nonnegative Gram factors retain the row-mass lower bound after arbitrary
Schur multiplication by another nonnegative Gram kernel. -/
set_option maxHeartbeats 3000000
namespace Erdos571.NonnegativeGramMoments
open Finset Matrix GramPin GramFeatures
variable {U I : Type} [Fintype U] [Fintype I]

def IsNonnegGram (W : Matrix U U ℝ) : Prop :=
  ∃ (J : Type) (_ : Fintype J) (F : Matrix U J ℝ),
    (∀ u j, 0 ≤ F u j) ∧ W = F * F.transpose

lemma IsNonnegGram.self (F : Matrix U I ℝ) (hF : ∀ u i, 0 ≤ F u i) :
    IsNonnegGram (F * F.transpose) := ⟨I, inferInstance, F, hF, rfl⟩

lemma IsNonnegGram.gram {W : Matrix U U ℝ} (hW : IsNonnegGram W) :
    HybridGramMoments.IsGram W := by
  obtain ⟨J,hJ,F,hF,rfl⟩ := hW
  exact ⟨J,hJ,F,rfl⟩

lemma IsNonnegGram.nonneg {W : Matrix U U ℝ} (hW : IsNonnegGram W) :
    ∀ u v, 0 ≤ W u v := by
  obtain ⟨J,hJ,F,hF,rfl⟩ := hW
  letI := hJ
  exact fun u v => sum_nonneg (fun j _ => mul_nonneg (hF u j) (hF v j))

lemma IsNonnegGram.product {W Z : Matrix U U ℝ}
    (hW : IsNonnegGram W) (hZ : IsNonnegGram Z) :
    IsNonnegGram (fun u v => W u v * Z u v) := by
  obtain ⟨J,hJ,F,hF,rfl⟩ := hW
  obtain ⟨K,hK,H,hH,rfl⟩ := hZ
  letI := hJ
  letI := hK
  refine ⟨J × K,inferInstance,(fun u p => F u p.1 * H u p.2),
    (fun u p => mul_nonneg (hF u p.1) (hH u p.2)),?_⟩
  ext u v
  exact (ArmTensor.product_gram F H u v).symm

lemma IsNonnegGram.conjugation {W : Matrix U U ℝ} (hW : IsNonnegGram W)
    (P : Matrix U U ℝ) (hs : P.IsSymm) (hP : ∀ u v, 0 ≤ P u v) :
    IsNonnegGram (P * W * P) := by
  obtain ⟨J,hJ,F,hF,rfl⟩ := hW
  letI := hJ
  refine ⟨J,inferInstance,P*F,chain_nonneg hP hF,?_⟩
  simp only [Matrix.transpose_mul,hs.eq,Matrix.mul_assoc]

lemma IsNonnegGram.power {W : Matrix U U ℝ} (hW : IsNonnegGram W) (k : ℕ) :
    IsNonnegGram (entryPower W k) := by
  classical
  obtain ⟨J,hJ,F,hF,rfl⟩ := hW
  letI := hJ
  refine ⟨Fin k → J,inferInstance,branch F k,?_,?_⟩
  · intro u f
    exact prod_nonneg (fun i _ => hF u (f i))
  · ext u v
    exact (kernel_branch F k u v).symm

lemma rowGram_total (F : Matrix U I ℝ) :
    (∑ u, ∑ v, (F*F.transpose) u v) = ∑ i, (∑ u, F u i)^2 := by
  simpa only [Matrix.transpose_transpose,Matrix.transpose_apply] using
    columnGram_total F.transpose

/-- A positive row lower bound survives testing the Gram square against
any completely positive kernel, without an entrywise mixing hypothesis. -/
theorem row_gram_lower (N : Matrix U U ℝ) (hs : N.IsSymm)
    (hN : ∀ u v, 0 ≤ N u v) (F : Matrix U I ℝ) (hF : ∀ u i, 0 ≤ F u i)
    (r : ℝ) (hr : 0 ≤ r) (hrow : ∀ u, r ≤ ∑ v, N u v) :
    r^2 * (∑ u, ∑ v, (F*F.transpose) u v) ≤
      (Fintype.card U:ℝ) * ∑ u, ∑ v, (F*F.transpose) u v * (N*N.transpose) u v := by
  have hc (v : U) : r ≤ ∑ u, N u v := by
    simpa only [hs.apply v] using hrow v
  have hcol (i : I) : r * (∑ u, F u i) ≤ ∑ u, (N*F) u i := by
    simp only [Matrix.mul_apply]
    rw [sum_comm, mul_sum]
    apply sum_le_sum
    intro v _
    rw [←sum_mul]
    exact mul_le_mul_of_nonneg_right (hc v) (hF v i)
  have hbound (i : I) : r^2 * (∑ u, F u i)^2 ≤
      (Fintype.card U:ℝ) * ∑ u, ((N*F) u i)^2 := by
    have h := sq_sum_le_card_mul_sum_sq (s := (univ : Finset U))
      (f := fun u => (N*F) u i)
    simp only [card_univ] at h
    have hl := pow_le_pow_left₀ (mul_nonneg hr (sum_nonneg (fun u _ => hF u i))) (hcol i) 2
    simpa only [mul_pow] using hl.trans h
  have h := sum_le_sum (s := (univ : Finset I)) (fun i _ => hbound i)
  rw [←mul_sum,←mul_sum,←rowGram_total F] at h
  conv at h => rhs; arg 2; rw [sum_comm]
  have he := chain_gram_identity N F
  rw [hs.eq] at he
  rw [hs.eq]
  calc
    _ ≤ (Fintype.card U:ℝ) * squareMass (N*F) := h
    _ = _ := by rw [he]; congr 1; apply sum_congr rfl; intro u _; apply sum_congr rfl; intro v _; ring

 theorem IsNonnegGram.row_lower {W : Matrix U U ℝ} (hW : IsNonnegGram W)
    (N : Matrix U U ℝ) (hs : N.IsSymm) (hN : ∀ u v, 0 ≤ N u v)
    (r : ℝ) (hr : 0 ≤ r) (hrow : ∀ u, r ≤ ∑ v, N u v) :
    r^2 * (∑ u, ∑ v, W u v) ≤
      (Fintype.card U:ℝ) * ∑ u, ∑ v, W u v * (N*N.transpose) u v := by
  obtain ⟨J,hJ,F,hF,rfl⟩ := hW
  letI := hJ
  exact row_gram_lower N hs hN F hF r hr hrow

/-- Trace Cauchy–Schwarz: the first kernel moment is controlled by its
second moment and the diagonal mass of the Gram weight. -/
theorem gram_first_moment_sq (N : Matrix U U ℝ) (hs : N.IsSymm)
    (F : Matrix U I ℝ) :
    (∑ u, ∑ v, (F*F.transpose) u v * N u v)^2 ≤
      (∑ u, (F*F.transpose) u u) *
        (∑ u, ∑ v, (F*F.transpose) u v * (N*N.transpose) u v) := by
  have he : (∑ u, ∑ v, (F*F.transpose) u v * N u v) =
      ∑ u, ∑ i, F u i * (N*F) u i := by
    simp only [Matrix.mul_apply,Matrix.transpose_apply,mul_sum,sum_mul]
    apply sum_congr rfl
    intro u _
    rw [sum_comm]
    apply sum_congr rfl
    intro i _
    apply sum_congr rfl
    intro v _
    ring
  have hd : (∑ u, (F*F.transpose) u u) = squareMass F := by
    simp only [Matrix.mul_apply,Matrix.transpose_apply,squareMass,pow_two]
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset (U × I))
    (fun p => F p.1 p.2) (fun p => (N*F) p.1 p.2)
  simp only [Fintype.sum_prod_type] at h
  rw [he,hd]
  have hg := chain_gram_identity N F
  rw [hs.eq] at hg
  rw [hs.eq]
  change (∑ u, ∑ i, F u i * (N*F) u i)^2 ≤ squareMass F * squareMass (N*F) at h
  apply h.trans_eq
  rw [hg]
  congr 1
  exact sum_congr rfl (fun u _ => sum_congr rfl (fun v _ => mul_comm _ _))

 theorem IsGram.first_moment_sq {W : Matrix U U ℝ} (hW : HybridGramMoments.IsGram W)
    (N : Matrix U U ℝ) (hs : N.IsSymm) :
    (∑ u, ∑ v, W u v * N u v)^2 ≤
      (∑ u, W u u) * (∑ u, ∑ v, W u v * (N*N.transpose) u v) := by
  obtain ⟨J,hJ,F,rfl⟩ := hW
  letI := hJ
  exact gram_first_moment_sq N hs F

end Erdos571.NonnegativeGramMoments

/-! Supporting module: TerminalGramInterpolation -/

/-! A terminal-pin estimate retaining the light first moment instead of
replacing it by a codegree cap times the deleted mass. -/
set_option maxHeartbeats 3000000
namespace Erdos571.NonnegativeGramMoments
open Finset Matrix SimpleGraph
variable {U : Type} [Fintype U]

open Classical in
lemma IsNonnegGram.nonadj_bound {S : Matrix U U ℝ} (hS : IsNonnegGram S)
    (H : SimpleGraph U) (m : ℕ) (hm : 2 ≤ m) (hH : H.CliqueFree m) :
    (∑ u, ∑ v, S u v) ≤
      (m-1:ℕ) * ∑ u, ∑ v, if ¬ H.Adj u v then S u v else 0 := by
  classical
  obtain ⟨I,hI,F,hF,rfl⟩ := hS
  letI := hI
  rw [rowGram_total]
  have h := sum_le_sum (s := (univ : Finset I)) (fun i _ =>
    HeavyCliqueMoments.weighted_nonadj H m hm hH (fun u => F u i) (fun u => hF u i))
  rw [←mul_sum] at h
  apply h.trans_eq
  congr 1
  rw [sum_comm]
  apply sum_congr rfl
  intro u _
  rw [sum_comm]
  apply sum_congr rfl
  intro v _
  by_cases ha : H.Adj u v
  · simp only [ha,not_true_eq_false,ite_false,sum_const_zero]
  · simp only [ha,not_false_eq_true,ite_true,Matrix.mul_apply,Matrix.transpose_apply]

open Classical in
/-- The light off-diagonal term keeps `N u v`; in particular it does not
pay a maximum codegree times the entire deleted agreement. -/
theorem terminal_first_moment (W S N : Matrix U U ℝ)
    (hW : IsNonnegGram W) (hS : IsNonnegGram S)
    (H : SimpleGraph U) (m : ℕ) (hm : 2 ≤ m) (hH : H.CliqueFree m)
    (D : ℝ) (hD : 0 ≤ D) (hN : ∀ u v, 0 ≤ N u v)
    (hdiag : ∀ u, S u u ≤ (N*N.transpose) u u)
    (hoff : ∀ u v, u ≠ v → ¬H.Adj u v → S u v ≤ D*N u v) :
    (∑ u, ∑ v, W u v*S u v) ≤ (m-1:ℕ) *
      ((∑ u, W u u*(N*N.transpose) u u) + D*∑ u, ∑ v, W u v*N u v) := by
  classical
  have h := (hW.product hS).nonadj_bound H m hm hH
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  have hp (u v : U) :
      (if ¬H.Adj u v then W u v*S u v else 0) ≤
        (if u=v then W u u*(N*N.transpose) u u else 0) + D*(W u v*N u v) := by
    by_cases he : u=v
    · subst v
      rw [if_pos (H.loopless u),if_pos rfl]
      exact (mul_le_mul_of_nonneg_left (hdiag u) (hW.nonneg u u)).trans
        (le_add_of_nonneg_right (mul_nonneg hD (mul_nonneg (hW.nonneg u u) (hN u u))))
    · rw [if_neg he,zero_add]
      by_cases ha : H.Adj u v
      · simp only [ha,not_true_eq_false,ite_false]
        exact mul_nonneg hD (mul_nonneg (hW.nonneg u v) (hN u v))
      · rw [if_pos ha]
        exact (mul_le_mul_of_nonneg_left (hoff u v he ha) (hW.nonneg u v)).trans_eq (by ring)
  calc
    _ ≤ ∑ u, ∑ v, ((if u=v then W u u*(N*N.transpose) u u else 0) + D*(W u v*N u v)) :=
      sum_le_sum (fun u _ => sum_le_sum (fun v _ => hp u v))
    _ = _ := by simp only [sum_add_distrib,sum_ite_eq,mem_univ,if_true,←mul_sum]

/-- Squared terminal-pin control by its own hub pin and the same whole
agreement energy. No host-order factor occurs. -/
theorem terminal_sq (W S N : Matrix U U ℝ)
    (hW : IsNonnegGram W) (hS : IsNonnegGram S) (hs : N.IsSymm)
    (H : SimpleGraph U) (m : ℕ) (hm : 2 ≤ m) (hH : H.CliqueFree m)
    (D q : ℝ) (hD : 0 ≤ D) (hq : 0 ≤ q) (hN : ∀ u v, 0 ≤ N u v)
    (hdiag : ∀ u, S u u ≤ (N*N.transpose) u u)
    (hoff : ∀ u v, u ≠ v → ¬H.Adj u v → S u v ≤ D*N u v)
    (hmin : ∀ u, q ≤ (N*N.transpose) u u) :
    q*(∑ u, ∑ v, W u v*S u v)^2 ≤ 2*(m-1:ℕ)^2 *
      (∑ u, W u u*(N*N.transpose) u u) *
      (q*(∑ u, W u u*(N*N.transpose) u u) +
        D^2*(∑ u, ∑ v, W u v*(N*N.transpose) u v)) := by
  let p := ∑ u, ∑ v, W u v*S u v
  let b := ∑ u, W u u*(N*N.transpose) u u
  let a := ∑ u, ∑ v, W u v*N u v
  let E := ∑ u, ∑ v, W u v*(N*N.transpose) u v
  let t : ℝ := (m-1:ℕ)
  have hp : 0 ≤ p := sum_nonneg (fun u _ => sum_nonneg (fun v _ => mul_nonneg (hW.nonneg u v) (hS.nonneg u v)))
  have hE : 0 ≤ E := sum_nonneg (fun u _ => sum_nonneg (fun v _ =>
    mul_nonneg (hW.nonneg u v) (GramFeatures.chain_nonneg hN (fun u v => hN v u) u v)))
  have hb : 0 ≤ b := sum_nonneg (fun u _ => mul_nonneg (hW.nonneg u u)
    (GramFeatures.chain_nonneg hN (fun u v => hN v u) u u))
  have hfirst : p ≤ t*(b+D*a) := terminal_first_moment W S N hW hS H m hm hH D hD hN hdiag hoff
  have hcs : a^2 ≤ (∑ u, W u u)*E := IsGram.first_moment_sq hW.gram N hs
  have htrace : q*(∑ u, W u u) ≤ b := by
    rw [mul_sum]
    exact sum_le_sum (fun u _ => by
      simpa only [mul_comm] using mul_le_mul_of_nonneg_left (hmin u) (hW.nonneg u u))
  have hqa : q*a^2 ≤ b*E := (mul_le_mul_of_nonneg_left hcs hq).trans (by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_right htrace hE)
  have hp2 : p^2 ≤ t^2*(b+D*a)^2 := by
    simpa only [mul_pow] using pow_le_pow_left₀ hp hfirst 2
  have hsum : (b+D*a)^2 ≤ 2*(b^2+D^2*a^2) := by nlinarith [sq_nonneg (b-D*a)]
  change q*p^2 ≤ 2*t^2*b*(q*b+D^2*E)
  calc
    _ ≤ q*(t^2*(b+D*a)^2) := mul_le_mul_of_nonneg_left hp2 hq
    _ ≤ q*(t^2*(2*(b^2+D^2*a^2))) := by gcongr
    _ = 2*t^2*(q*b^2 + D^2*(q*a^2)) := by ring
    _ ≤ 2*t^2*(q*b^2 + D^2*(b*E)) := by gcongr
    _ = _ := by ring

end Erdos571.NonnegativeGramMoments

/-! Supporting module: HybridPositiveDeletedMoments -/

/-! Linear deletion bounds from completely positive weights. These bounds
retain the same hybrid agreement energy. -/
set_option maxHeartbeats 3000000
namespace Erdos571.NonnegativeGramMoments
open Finset Matrix GramFeatures GramPin
variable {U : Type} [Fintype U]

theorem successive_moment (W N : Matrix U U ℝ) (hW : IsNonnegGram W)
    (hs : N.IsSymm) (hN : ∀ u v, 0 ≤ N u v) (j : ℕ)
    (r : ℝ) (hr : 0 ≤ r) (hrow : ∀ u, r ≤ ∑ v, N u v) :
    r^2*(∑ u, ∑ v, W u v*((N*N.transpose) u v)^j) ≤
      (Fintype.card U:ℝ)*(∑ u, ∑ v, W u v*((N*N.transpose) u v)^(j+1)) := by
  have hgram := hW.product ((IsNonnegGram.self N hN).power j)
  have h := hgram.row_lower N hs hN r hr hrow
  simpa only [entryPower,pow_succ,mul_assoc] using h

end Erdos571.NonnegativeGramMoments

namespace Erdos571.HybridPositiveDeletedMoments
open Finset Matrix GramFeatures HybridDeletedMoments NonnegativeGramMoments
variable {U : Type} [Fintype U] [DecidableEq U]

lemma bundle_nonnegGram (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : IsNonnegGram R) (k : ℕ) :
    IsNonnegGram (bundle P R k) := by
  have hPP : IsNonnegGram (P*P) := by simpa only [hs.eq] using IsNonnegGram.self P hP
  exact (hR.power k).product hPP

lemma chain_nonnegGram (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : IsNonnegGram R) (k : ℕ) :
    IsNonnegGram (HybridDeletedMoments.chain P R k) :=
  (bundle_nonnegGram P R hs hP hR k).conjugation P hs hP

lemma endpointWeight_nonnegGram (P R : Matrix U U ℝ) (hs : P.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hR : IsNonnegGram R) (k : ℕ) :
    IsNonnegGram (endpointWeight P R k) := by
  have hPP : IsNonnegGram (P*P) := by simpa only [hs.eq] using IsNonnegGram.self P hP
  exact (((hR.power k).product (chain_nonnegGram P R hs hP hR k)).conjugation P hs hP).product hPP

lemma center_deleted (P N : Matrix U U ℝ) (hsP : P.IsSymm) (hsN : N.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hN : ∀ u v, 0 ≤ N u v)
    (k : ℕ) (hk : 1 ≤ k) (r : ℝ) (hr : 0 ≤ r) (hrow : ∀ u, r ≤ ∑ v, N u v) :
    r^2*centerMoment P (N*N.transpose) k (k-1) ≤
      (Fintype.card U:ℝ)*energy P (N*N.transpose) k := by
  let R := N*N.transpose
  let C := HybridDeletedMoments.chain P R k
  have hC := chain_nonnegGram P R hsP hP (IsNonnegGram.self N hN) k
  have hW : IsNonnegGram (fun u v => (C u v)^2) := by
    simpa only [pow_two] using hC.product hC
  have h := successive_moment (fun u v => (C u v)^2) N hW hsN hN (k-1) r hr hrow
  rw [Nat.sub_add_cancel hk] at h
  simpa only [centerMoment,energy,mul_comm] using h

lemma endpoint_deleted (P N : Matrix U U ℝ) (hsP : P.IsSymm) (hsN : N.IsSymm)
    (hP : ∀ u v, 0 ≤ P u v) (hN : ∀ u v, 0 ≤ N u v)
    (k : ℕ) (hk : 1 ≤ k) (r : ℝ) (hr : 0 ≤ r) (hrow : ∀ u, r ≤ ∑ v, N u v) :
    r^2*endpointMoment P (N*N.transpose) k (k-1) ≤
      (Fintype.card U:ℝ)*energy P (N*N.transpose) k := by
  let R := N*N.transpose
  have hW := endpointWeight_nonnegGram P R hsP hP (IsNonnegGram.self N hN) k
  have h := successive_moment (endpointWeight P R k) N hW hsN hN (k-1) r hr hrow
  rw [Nat.sub_add_cancel hk] at h
  rw [endpoint_as_moment P R hsP k (k-1),←endpoint_self P R k,endpoint_as_moment P R hsP k k]
  simpa only [WeightedPowerMoments.moment,Fintype.sum_prod_type,endpointWeight] using h

end Erdos571.HybridPositiveDeletedMoments

/-! Supporting module: HybridPositiveDeletedGraph -/

/-! Finite pin-controlled deletion bounds for every hybrid terminal arm. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridPositiveScales
open Finset SimpleGraph Matrix GramFeatures GramPin
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

lemma free_deleted_linear (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (r : HybridRoles.Arm k) :
    (d^2/2)^2*(Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ) ≤
      (Fintype.card W:ℝ)*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ) := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let R := N*N.transpose
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  let T := C*d^2
  have hA (u v : W) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]; split_ifs <;> norm_num
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := MatchedThreeHub.free_fourth_row_bound (k+1) M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hP := chain_nonneg hA hA
  have hsP : (A*A).IsSymm := by
    show (A*A).transpose=_
    rw [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  have hc := HybridPositiveDeletedMoments.center_deleted (A*A) N hsP (LightArmKernel.isSymm G L)
    hP (LightArmKernel.nonneg G L) k hk (d^2/2) (by positivity) hNrow
  have he := HybridPositiveDeletedMoments.endpoint_deleted (A*A) N hsP (LightArmKernel.isSymm G L)
    hP (LightArmKernel.nonneg G L) k hk (d^2/2) (by positivity) hNrow
  have hb : (d^2/2)^2*(Nat.card (HybridMixed.BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ) ≤
      (Fintype.card W:ℝ)*(HybridDeletedMoments.energy (A*A) R k) :=
    (mul_le_mul_of_nonneg_left (HybridMixed.bare_agreement_le G L k hk) (sq_nonneg _)).trans he
  rcases r with ⟨j,i⟩|j
  · fin_cases j
    · change (d^2/2)^2*(Nat.card (HybridMixed.Agreement G L (Fin k) (MaskedBush.Without i) (Fin k)):ℝ) ≤ _
      rw [HybridMixed.left_deleted_card,HybridMixed.symmetric_energy]
      exact he
    · change (d^2/2)^2*(Nat.card (HybridMixed.Agreement G L (MaskedBush.Without i) (Fin k) (Fin k)):ℝ) ≤ _
      rw [HybridMixed.central_deleted_card,HybridMixed.symmetric_energy]
      exact hc
    · change (d^2/2)^2*(Nat.card (HybridMixed.Agreement G L (Fin k) (Fin k) (MaskedBush.Without i)):ℝ) ≤ _
      rw [HybridMixed.right_deleted_card,HybridMixed.symmetric_energy]
      exact he
  · fin_cases j
    all_goals
      change (d^2/2)^2*(Nat.card (HybridMixed.BareAgreement G L (Fin k) (Fin k) (Fin k)):ℝ) ≤ _
      rw [HybridMixed.symmetric_energy]
      exact hb

end Erdos571.HybridPositiveScales

/-! Supporting module: HybridPositiveCountScales -/

/-! The same matched pin bounds with linear, completely positive deletion.
The density condition now suffices for every k >= 2. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridPositiveScales
open Finset SimpleGraph HybridScales

lemma scaled_order_le_cube (k : ℕ) (hk : 2 ≤ k) (n d K τ B : ℝ)
    (hn : 0 ≤ n) (hd : 1 ≤ d) (hτ : 0 ≤ τ)
    (hscale : (4*K)^(3*k+1) ≤ τ^(3*k+1)*B)
    (hdense : B*n^(3*k+1) ≤ d^(6*k+8)) : 4*K*n ≤ τ*d^3 := by
  by_cases hKn : 0 ≤ 4*K*n
  swap
  · exact (le_of_not_ge hKn).trans (mul_nonneg hτ (pow_nonneg (by linarith : 0 ≤ d) _))
  apply (pow_le_pow_iff_left₀ hKn (mul_nonneg hτ (pow_nonneg (by linarith : 0 ≤ d) _))
    (by omega : 3*k+1≠0)).mp
  calc
    _ = (4*K)^(3*k+1)*n^(3*k+1) := mul_pow _ _ _
    _ ≤ (τ^(3*k+1)*B)*n^(3*k+1) := mul_le_mul_of_nonneg_right hscale (pow_nonneg hn _)
    _ = τ^(3*k+1)*(B*n^(3*k+1)) := by ring
    _ ≤ τ^(3*k+1)*d^(6*k+8) := mul_le_mul_of_nonneg_left hdense (pow_nonneg hτ _)
    _ ≤ τ^(3*k+1)*d^(3*(3*k+1)) := mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ hd (by omega : 6*k+8 ≤ 3*(3*k+1))) (pow_nonneg hτ _)
    _ = _ := by rw [pow_mul,mul_pow]

theorem exists_scale (k M : ℕ) (K τ : ℝ) (hK : 0 < K) (hτ : 0 < τ) :
    ∃ B : ℝ, 1 ≤ B ∧ (4*K)^(6*k+8)<B ∧
      coreCoefficient k M K*(2:ℝ)^(6*k) ≤ (HybridRefinedScales.pinTolerance k K τ)^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ (HybridRefinedScales.pinTolerance k K τ)^3*B ∧
      (4*K)^(3*k+1) ≤ τ^(3*k+1)*B := by
  obtain ⟨B,hB,hlarge,hcore,hcoll⟩ := HybridRefinedScales.exists_scale k M K τ hK hτ
  let C := max B ((4*K/τ)^(3*k+1))
  have hBC : B ≤ C := le_max_left _ _
  have hp : 0 ≤ (HybridRefinedScales.pinTolerance k K τ)^3 :=
    pow_nonneg (HybridRefinedScales.pinTolerance_pos k K τ hK hτ).le _
  refine ⟨C,hB.trans hBC,hlarge.trans_le hBC,
    hcore.trans (mul_le_mul_of_nonneg_left hBC hp),
    hcoll.trans (mul_le_mul_of_nonneg_left hBC hp),?_⟩
  have h := mul_le_mul_of_nonneg_left (le_max_right B ((4*K/τ)^(3*k+1))) (pow_nonneg hτ.le (3*k+1))
  have he : τ^(3*k+1)*(4*K/τ)^(3*k+1)=(4*K)^(3*k+1) := by
    rw [←mul_pow]
    congr 1
    field_simp
  exact he ▸ h

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem all_counts_small (k M : ℕ) (hk : 2 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K τ B : ℝ) (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K)
    (hdK : 4*K ≤ d) (hτ : 0 ≤ τ) (hB : 1 ≤ B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (hscale : coreCoefficient k M K*(2:ℝ)^(6*k) ≤ (HybridRefinedScales.pinTolerance k K τ)^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ (HybridRefinedScales.pinTolerance k K τ)^3*B ∧
      (4*K)^(3*k+1) ≤ τ^(3*k+1)*B)
    (hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8)) :
    (∀ c : HybridRoles.Core, (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤
      τ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤
      τ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ r : HybridRoles.Arm k,
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ) ≤
      (τ/(K*d))*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) := by
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G L k)
  let κ := HybridRefinedScales.pinTolerance k K τ
  have hd0 : 0 < d := by linarith
  have hK0 : 0 < K := by linarith
  have hD : 0 < K*d := mul_pos hK0 hd0
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have hC : 0 ≤ MatchedThreeHub.momentCoefficient (k+1) M*K^2 :=
    mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg _ _) (sq_nonneg K)
  have hB0 : 0 < B := by linarith
  have hκ : 0 ≤ κ := le_min hτ (pow_nonneg (div_nonneg hτ (by positivity)) _)
  have hκτ : κ ≤ τ := min_le_left _ _
  have henergy := dense_energy_scalar k (Fintype.card W:ℝ) d E B
    (by exact_mod_cast Fintype.card_pos) hd0.le
    (free_energy_lower G k M hf L d K hL hd0 hK0.le hdK hmin hmax hcut) hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤ κ*E := by
    apply power_small 3 (by omega) _ (coreCoefficient k M K) (Fintype.card W:ℝ) d E B κ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [coreCoefficient]; positivity) hE hB0 hκ _ henergy hscale.1
    have h := HybridThreeHubAssignments.all_core_pin_cubic G L k M hf d K hL hd0 hK0.le hdK hmin hmax hcut
      (fun p => HybridRoles.coreValue k G L p c) (by
        rcases c with i|i
        · fin_cases i
          · exact Or.inr (Or.inl rfl)
          · exact Or.inl rfl
          · exact Or.inr (Or.inr (Or.inl rfl))
        · fin_cases i
          · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
          · exact Or.inr (Or.inr (Or.inr (Or.inr rfl))))
    simpa only [coreCoefficient,show 6*(k+1)+2=6*k+8 by omega] using h
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤ κ*E := by
    apply power_small 3 (by omega) _ (collisionCoefficient k M K) (Fintype.card W:ℝ) d E B κ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [collisionCoefficient]; positivity) hE hB0 hκ _ henergy hscale.2.1
    exact HybridThreeHubAssignments.all_core_collision_cubic G L k M hf d K hL hd0 hK0.le hdK hmin hmax hcut
      (HybridRoles.coreCollision k G L c) (by
        cases c
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl)))
  refine ⟨fun c => (hcore c).trans (mul_le_mul_of_nonneg_right hκτ hE),
    fun c => (hcoll c).trans (mul_le_mul_of_nonneg_right hκτ hE),?_⟩
  intro r
  let Δ : ℝ := Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E)
  have hdel := free_deleted_linear G k M (by omega) hf L d K hL hd0 hK0.le hdK hmin hmax hcut r
  have hn := scaled_order_le_cube k hk (Fintype.card W:ℝ) d K τ B (Nat.cast_nonneg _) hd hτ hscale.2.2 hdense
  have hsmall : K*d*Δ ≤ τ*E := by
    apply (mul_le_mul_iff_right₀ (pow_pos hd0 3)).mp
    have h₁ := mul_le_mul_of_nonneg_left hdel (by positivity : 0 ≤ 4*K)
    have h₂ := mul_le_mul_of_nonneg_right hn hE
    nlinarith [h₁,h₂]
  calc
    _ ≤ τ*E/(K*d) := (le_div_iff₀ hD).mpr (by nlinarith [hsmall])
    _ = _ := by ring

end Erdos571.HybridPositiveScales

/-! Supporting module: HybridPositiveFreeDegree -/

/-! Sharp degree bound for matched hybrid three-hub powers, with k >= 2. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridPositiveUpper
open Finset SimpleGraph Matrix

theorem free_degree_bound (k M : ℕ) (hk : 2 ≤ k) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K) :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) →
      (MatchedThreeHub.graph (k+1) M).Free G →
      d^(6*k+8) < B*(Fintype.card W:ℝ)^(3*k+1) := by
  classical
  let C := MatchedThreeHub.momentCoefficient (k+1) M
  let m := Fintype.card (MatchedThreeHub.Branch (k+1) M)
  let t := m+Nat.card (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)).edgeSet
  let cap : ℕ := Nat.ceil (4*C*K^2+1+(t:ℝ))
  have hC : 0 ≤ C := MatchedThreeHub.momentCoefficient_nonneg (k+1) M
  have hK0 : 0 ≤ K := by linarith
  have hm : 2 ≤ m := by
    dsimp [m,MatchedThreeHub.Branch]
    simp only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hcap : 4*C*K^2+1+(t:ℝ) ≤ (cap:ℝ) := Nat.le_ceil _
  have hcut : 4*C*K^2 ≤ (cap:ℝ) := by have ht0 : (0:ℝ) ≤ t := Nat.cast_nonneg _; linarith
  have htc : t ≤ cap := by
    have hh : (t:ℝ) ≤ (cap:ℝ) := by nlinarith [mul_nonneg hC (sq_nonneg K)]
    exact_mod_cast hh
  have hcapPos : (0:ℝ) < cap := by nlinarith [mul_nonneg hC (sq_nonneg K),(show (0:ℝ) ≤ t from Nat.cast_nonneg t)]
  let c : ℝ := (m-1:ℕ)
  have hc : 1 ≤ c := by dsimp [c]; exact_mod_cast (show 1 ≤ m-1 by omega)
  let pack : ℝ := (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
    (A := RootedSubdivision.Nonroot (HybridThreeHub.base k))
    (R := RootedSubdivision.Root (HybridThreeHub.base k))):ℝ)+
      (Nat.card (RootedSubdivision.Nonroot (HybridThreeHub.base k)):ℝ)^2)
  have hpack : 0 ≤ pack := by dsimp [pack]; positivity
  obtain ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,hpSmall,hattach,hroot⟩ :=
    MaskedBushCoefficients.choose pack c cap hpack hc (Nat.cast_nonneg _)
  let R := (2*(C*K^2))^k
  have hR : 0 ≤ R := pow_nonneg (by positivity) _
  let σ := τ/(R+1)
  have hσ : 0 < σ := div_pos hτ (by positivity)
  have hστ : σ ≤ τ := (div_le_iff₀ (by positivity : 0<R+1)).mpr (by nlinarith [mul_nonneg hτ.le hR])
  have hRσ : R*σ ≤ τ := by
    have he : σ*(R+1)=τ := div_mul_cancel₀ _ (by positivity)
    nlinarith [hσ.le]
  obtain ⟨B,hB1,hBlarge,hscale⟩ := HybridPositiveScales.exists_scale k M K σ (by linarith) hσ
  have hB : 0 < B := by linarith
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G (cap:ℝ) k)
  have hn1 : 1 ≤ n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hn : 0 < n := by linarith
  have hdpos : 0 < d := by linarith
  have hD1 : 1 ≤ D := by dsimp [D]; nlinarith
  have hD : 0 < D := by linarith
  have hd4 : 4*K ≤ d := by
    by_contra hh
    have hdp : d^(6*k+8) ≤ (4*K)^(6*k+8) := pow_le_pow_left₀ hdpos.le (le_of_not_ge hh) _
    have hpow : 1 ≤ n^(3*k+1) := one_le_pow₀ hn1
    have hlow : B ≤ B*n^(3*k+1) := by nlinarith
    exact (not_lt_of_ge ((hdense.trans hdp).trans' hlow)) hBlarge
  have hmax (u : W) : (G.degree u:ℝ) ≤ D := (hdeg u).2
  have hmin (u : W) : d ≤ (G.degree u:ℝ) := (hdeg u).1
  have hEpos : 0 < E := HybridScales.free_energy_pos G k M hf cap d K hcapPos hdpos hK0 hd4 hmin hmax hcut
  obtain ⟨hcoreσ,hcollσ,hdelσ⟩ := HybridPositiveScales.all_counts_small G k M hk hf cap d K σ B
    hcapPos hd hK hd4 hσ.le hB1 hmin hmax hcut hscale hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G (cap:ℝ) (.inl c)):ℝ) ≤ τ*E :=
    (hcoreσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
        (HybridRoles.coreCollision k G (cap:ℝ) c)):ℝ) ≤ τ*E :=
    (hcollσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hdel (r : HybridRoles.Arm k) :
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G (cap:ℝ) r).E):ℝ) ≤ (τ/D)*E :=
    (hdelσ r).trans (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hστ hD.le) hEpos.le)
  have hsub : (ProjectionHeavy.subdivision (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1))).Free G := by
    intro h
    exact hf (IsContained.trans ⟨RootedSubdivision.powerCopy (MatchedThreeHub.base (k+1)) M⟩ h)
  let H := HostHeavyShadow.graph G univ t
  have hH : H.CliqueFree m := HostHeavyShadow.cliqueFree_of_subdivision_free
    (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)) G univ hsub
  have hlight (u v : W) (hnon : ¬H.Adj u v) (hne : u≠v) : Fintype.card (G.commonNeighbors u v) ≤ cap := by
    have ht : (FourthMoment.common G univ u v).card < t := by
      by_contra hh
      exact hnon ⟨hne,le_of_not_gt hh⟩
    rw [HostHeavyShadow.common_univ_card] at ht
    exact ht.le.trans htc
  have hDmax : (G.maxDegree:ℝ) ≤ D := by
    obtain ⟨u,hu⟩ := G.exists_maximal_degree_vertex
    rw [hu]
    exact hmax u
  have hcoef := MaskedBushCoefficients.coefficients c cap G.maxDegree D τ ε hc (Nat.cast_nonneg _)
    hD1 hDmax hτ.le hattach hroot
  have hεsq : ε^2 ≤ ε := by nlinarith
  have hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
      (HybridThreeHubAssignments.SameFullRoots G (cap:ℝ) k)):ℝ) ≤ ε^2*E := by
    have h := HybridThreeHubAssignments.sameFullRoots_bound G (cap:ℝ) k M hf d K hcapPos hdpos hK0 hd4 hmin hmax hcut
    have hp : (Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) ≤ σ*E := hcoreσ (.inl 1)
    calc
      _ ≤ R*(Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) := h
      _ ≤ R*(σ*E) := mul_le_mul_of_nonneg_left hp hR
      _ = (R*σ)*E := by ring
      _ ≤ τ*E := mul_le_mul_of_nonneg_right hRσ hEpos.le
      _ ≤ ε^2*E := mul_le_mul_of_nonneg_right (hcoef.1.trans hpSmall) hEpos.le
  let g : G.Coloring Bool := hb.toColoring (by simp)
  have hfree := HybridRoles.not_free_of_small_counts k G (cap:ℝ) M hM g g.valid
    H m cap G.maxDegree hm hH G.degree_le_maxDegree hlight (Nat.cast_nonneg _) le_rfl
    ε (c*(1+cap)*τ) τ (τ/D) hε.le hcoef.1
    (by simpa only [c,Nat.cast_mul] using hcoef.2.1) hpSmall hεsq hcoef.2.2.1 hcoef.2.2.2
    (by simpa only [pack] using hsmall) hEpos hcore hcoll hjoined hdel
  exact hfree (HybridThreeHub.free_of_matched G k M hf)

end Erdos571.HybridPositiveUpper

/-! Supporting module: HybridPositiveExtremalUpper -/

/-! Sharp ordinary extremal bounds for matched hybrid three-hub powers. -/
set_option maxHeartbeats 2200000
namespace Erdos571.HybridPositiveUpper
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeExponent (k : ℕ) : ℝ := ((3*k+1:ℕ):ℝ)/((6*k+8:ℕ):ℝ)

lemma degreeExponent_pos (k : ℕ) (hs : 1 ≤ k) : 0 < degreeExponent k := by
  unfold degreeExponent
  apply div_pos
  · exact_mod_cast (show 0<3*k+1 by omega)
  · positivity

lemma degreeExponent_le_one (k : ℕ) : degreeExponent k ≤ 1 := by
  unfold degreeExponent
  apply (div_le_one (by positivity : (0:ℝ)<(6*k+8:ℕ))).mpr
  exact_mod_cast (show 3*k+1 ≤ 6*k+8 by omega)

theorem unrestricted_regular_bound (k M : ℕ) (hk : 2 ≤ k) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (MatchedThreeHub.graph (k+1) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent k) := by
  obtain ⟨B,hB,hbound⟩ := free_degree_bound k M hk hM Q hQ
  let C : ℝ := B^((6*k+8:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent k :=
    Real.one_le_rpow hn1 (degreeExponent_pos k (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent k := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (MatchedThreeHub.graph (k+1) M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (6*k+8) (3*k+1) (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent k at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent k) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The sharp exponent holds for every finite forbidden-free host. -/
theorem unrestricted_edge_bound (k M : ℕ) (hk : 2 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (MatchedThreeHub.graph (k+1) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent k) := by
  have hγ : 0 < degreeExponent k := degreeExponent_pos k (by omega)
  have hγ1 : degreeExponent k ≤ 1 := degreeExponent_le_one k
  let K : ℝ := (16:ℝ)^((degreeExponent k)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent k)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := unrestricted_regular_bound k M hk hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (MatchedThreeHub.graph (k+1) M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent k) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb


theorem edge_bound (k M : ℕ) (hk : 2 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (MatchedThreeHub.graph (k+1) M) (1+degreeExponent k) D := by
  obtain ⟨D,hD,h⟩ := unrestricted_edge_bound k M hk hM
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  exact h W inferInstance G inferInstance hf

theorem upper (k M : ℕ) (hk : 2 ≤ k) (hM : 2 ≤ M) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
      (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨D,hD,h⟩ := edge_bound k M hk hM
  exact h.extremal_isBigO _ hD

/-- A fixed matched power has the exact exponent, for every k >= 2. -/
theorem exists_theta (k : ℕ) (hk : 2 ≤ k) :
    ∃ M : ℕ, 2 ≤ M ∧ (MatchedThreeHub.graph (k+1) M).IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
        (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨M,hM,hl⟩ := MatchedThreeHub.exists_lower (k+1) (by omega)
  refine ⟨M,hM,MatchedThreeHub.graph_bipartite _ _,upper k M hk hM,?_⟩
  have he : 2-(3*((k+1:ℕ):ℝ)+4)/(6*((k+1:ℕ):ℝ)+2)=1+degreeExponent k := by
    dsimp [degreeExponent]
    push_cast
    have hden : (6*(k:ℝ)+8)≠0 := by positivity
    field_simp
    ring
  rwa [he] at hl

end Erdos571.HybridPositiveUpper

/-! Supporting module: HybridPositiveExactFamily -/

/-! Exact rational exponents from the matched hybrid three-hub certificates
and their iterated paired cones. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridPositiveUpper
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (k : ℕ) :
    1+degreeExponent k=2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ) := by
  dsimp [degreeExponent]
  have hden : ((6*k+8:ℕ):ℝ)≠0 := by positivity
  field_simp
  push_cast
  ring

theorem supported (k : ℕ) (hk : 2 ≤ k) :
    Supported (MatchedThreeHub.template (k+1)) (2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound k M hk hM
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (k : ℕ) (hk : 2 ≤ k) : Certificate (3*k+7) (6*k+8) := by
  classical
  let H := MatchedThreeHub.base (k+1)
  have hroot : 0 < Fintype.card (MatchedThreeHub.BaseRoot (k+1)) := by
    rw [MatchedThreeHub.base_roots (k+1) (by omega)]
    omega
  letI : Nonempty (MatchedThreeHub.BaseRoot (k+1)) := Fintype.card_pos_iff.mp hroot
  letI : Nonempty (RootedSubdivision.Root H) := ⟨Sum.inl (Classical.arbitrary _)⟩
  refine ⟨RootedSubdivision.Nonroot H,RootedSubdivision.Root H,
    inferInstance,inferInstance,inferInstance,inferInstance,
    MatchedThreeHub.template (k+1),RootedSubdivision.color H,
    RootedSubdivision.color_proper H,MatchedThreeHub.connected (k+1),
    MatchedThreeHub.no_isolated (k+1),?_,supported k hk⟩
  have h := MatchedThreeHub.template_balance (k+1) (by omega)
  simpa only [←Nat.card_eq_fintype_card,show 6*(k+1)+2=6*k+8 by omega,show 3*(k+1)+4=3*k+7 by omega] using h

theorem iterated_certificate (k t : ℕ) (hk : 2 ≤ k) :
    Certificate (3*k+7) (6*k+8+t*(3*k+7)) := by
  induction t with
  | zero => simpa using certificate k hk
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 6*k+8+(t+1)*(3*k+7)=6*k+8+t*(3*k+7)+(3*k+7) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- A proved exact family, not a realization of every rational exponent. -/
theorem exact_family (k t : ℕ) (hk : 2 ≤ k) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(3*k+7:ℚ)/(6*k+8+t*(3*k+7):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate k t hk).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_twenty_seven_twentieths :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((27/20:ℚ):ℝ)) := by
  have h := exact_family 2 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.HybridPositiveUpper

/-! The actual two-step terminal-pin kernel, with arbitrary endpoint gates. -/
set_option maxHeartbeats 3000000
namespace Erdos571.GatedArmKernel
open Finset SimpleGraph Matrix GramFeatures NonnegativeGramMoments
variable {U : Type} [Fintype U] [DecidableEq U]
variable (G : SimpleGraph U) [DecidableRel G.Adj] (gate : U → U → Prop)

open Classical in
noncomputable def feature : Matrix U (U × U) ℝ := fun u p =>
  if gate u p.1 then G.adjMatrix ℝ u p.2 * G.adjMatrix ℝ p.2 p.1 else 0

open Classical in
noncomputable def matrix : Matrix U U ℝ := fun u r =>
  if gate u r then (G.adjMatrix ℝ * G.adjMatrix ℝ) u r else 0

noncomputable def terminal : Matrix U U ℝ := feature G gate * (feature G gate).transpose

lemma adj_nonneg (u v : U) : 0 ≤ G.adjMatrix ℝ u v := by
  dsimp [SimpleGraph.adjMatrix]
  split_ifs <;> norm_num

lemma adj_square (u v : U) : (G.adjMatrix ℝ u v)^2 = G.adjMatrix ℝ u v := by
  dsimp [SimpleGraph.adjMatrix]
  split_ifs <;> norm_num

lemma feature_nonneg (u : U) (p : U × U) : 0 ≤ feature G gate u p := by
  classical
  unfold feature
  split_ifs
  · exact mul_nonneg (adj_nonneg G _ _) (adj_nonneg G _ _)
  · exact le_rfl

lemma feature_le (u : U) (p : U × U) :
    feature G gate u p ≤ G.adjMatrix ℝ u p.2 * G.adjMatrix ℝ p.2 p.1 := by
  classical
  unfold feature
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (adj_nonneg G _ _) (adj_nonneg G _ _)

lemma feature_square (u : U) (p : U × U) : (feature G gate u p)^2 = feature G gate u p := by
  classical
  unfold feature
  split_ifs
  · rw [mul_pow,adj_square,adj_square]
  · norm_num

lemma feature_row (u r : U) : (∑ m, feature G gate u (r,m)) = matrix G gate u r := by
  classical
  unfold feature matrix
  by_cases h : gate u r
  · simp only [h,ite_true,Matrix.mul_apply]
  · simp only [h,ite_false,sum_const_zero]

lemma nonneg (u r : U) : 0 ≤ matrix G gate u r := by
  rw [←feature_row]
  exact sum_nonneg (fun m _ => feature_nonneg G gate u (r,m))

lemma terminal_nonnegGram : IsNonnegGram (terminal G gate) :=
  IsNonnegGram.self (feature G gate) (feature_nonneg G gate)

lemma terminal_diag (u : U) : terminal G gate u u = ∑ r, matrix G gate u r := by
  change (∑ p : U × U, feature G gate u p * feature G gate u p) = _
  simp only [←pow_two,feature_square,Fintype.sum_prod_type,feature_row]

lemma le_entry_square (u r : U) : matrix G gate u r ≤ (matrix G gate u r)^2 := by
  classical
  unfold matrix
  split_ifs
  · rw [LayeredBush.adjacency_square_common_card]
    simpa only [pow_two] using (show (Fintype.card (G.commonNeighbors u r):ℝ) ≤ (Fintype.card (G.commonNeighbors u r):ℝ)^2 from by
      exact_mod_cast Nat.le_self_pow (by decide : 2 ≠ 0) _)
  · norm_num

lemma terminal_diag_le (u : U) :
    terminal G gate u u ≤ (matrix G gate * (matrix G gate).transpose) u u := by
  rw [terminal_diag]
  simpa only [Matrix.mul_apply,Matrix.transpose_apply,←pow_two] using
    sum_le_sum (fun r (_ : r∈univ) => le_entry_square G gate u r)

lemma terminal_le (D : ℝ) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D) (u v : U) :
    terminal G gate u v ≤ D*(G.adjMatrix ℝ * G.adjMatrix ℝ) u v := by
  let A := G.adjMatrix ℝ
  have hp (r m : U) : feature G gate u (r,m)*feature G gate v (r,m) ≤
      A u m * A v m * A m r := by
    have h := mul_le_mul (feature_le G gate u (r,m)) (feature_le G gate v (r,m))
      (feature_nonneg G gate v (r,m)) (mul_nonneg (adj_nonneg G u m) (adj_nonneg G m r))
    have he : (A u m*A m r)*(A v m*A m r)=A u m*A v m*A m r := by
      calc
        _ = A u m*A v m*(A m r)^2 := by ring
        _ = _ := by rw [adj_square]
    exact h.trans_eq he
  change (∑ p : U × U, feature G gate u p*feature G gate v p) ≤ _
  rw [Fintype.sum_prod_type]
  calc
    _ ≤ ∑ r, ∑ m, A u m*A v m*A m r := sum_le_sum (fun r _ => sum_le_sum (fun m _ => hp r m))
    _ = ∑ m, A u m*A v m*(G.degree m:ℝ) := by
      rw [sum_comm]
      apply sum_congr rfl
      intro m _
      rw [←mul_sum,ThreeHubKernel.adjacency_row_sum]
    _ ≤ ∑ m, A u m*A v m*D := sum_le_sum (fun m _ =>
      mul_le_mul_of_nonneg_left (hdeg m) (mul_nonneg (adj_nonneg G u m) (adj_nonneg G v m)))
    _ = _ := by
      rw [←sum_mul,mul_comm D]
      congr 1
      change _=(A*A) u v
      simp only [Matrix.mul_apply]
      exact sum_congr rfl (fun m _ => congrArg (fun x : ℝ => A u m*x) (G.isSymm_adjMatrix.apply m v))

lemma light_matrix (L : ℝ) : matrix G (MaskedBush.Light G L)=LightArmKernel.matrix G L := by
  ext u v
  simp [matrix,MaskedBush.Light,LightArmKernel.matrix,LightArmKernel.trim]

lemma full_matrix : matrix G (fun _ _ => True)=G.adjMatrix ℝ * G.adjMatrix ℝ := by
  ext u v
  simp [matrix]

lemma light_off (L D : ℝ) (hdeg : ∀ u, (G.degree u:ℝ) ≤ D)
    (u v : U) (hne : u≠v) (hlight : (G.adjMatrix ℝ * G.adjMatrix ℝ) u v ≤ L) :
    terminal G (MaskedBush.Light G L) u v ≤ D*LightArmKernel.matrix G L u v := by
  have h := terminal_le G (MaskedBush.Light G L) D hdeg u v
  rw [LightArmKernel.matrix,LightArmKernel.trim,if_pos ⟨hne,hlight⟩]
  exact h

end Erdos571.GatedArmKernel

/-! A complete finite one-arm extension and its exact Gram counts. -/
set_option maxHeartbeats 3000000
namespace Erdos571.ArmExtensionFamily
open Finset SimpleGraph Matrix GramFeatures GramPin NonnegativeGramMoments
variable {U R : Type} [Fintype U] [DecidableEq U] [Fintype R]
variable (G : SimpleGraph U) [DecidableRel G.Adj] (gate : U → U → Prop)

abbrev Arm (u r : U) := PLift (gate u r) × G.commonNeighbors u r
noncomputable instance armFintype (u r : U) : Fintype (Arm G gate u r) := by classical exact inferInstance

def middle {u r : U} (a : Arm G gate u r) : U := a.2.val

lemma card_arm (u r : U) : (Fintype.card (Arm G gate u r):ℝ)=GatedArmKernel.matrix G gate u r := by
  classical
  unfold GatedArmKernel.matrix
  by_cases h : gate u r
  · haveI : Nonempty (PLift (gate u r)) := ⟨⟨h⟩⟩
    have hc : Fintype.card (PLift (gate u r))=1 := by
      simpa only [Nat.card_eq_fintype_card] using Nat.card_unique (α := PLift (gate u r))
    rw [if_pos h,Fintype.card_prod,hc,one_mul,LayeredBush.adjacency_square_common_card]
  · haveI : IsEmpty (PLift (gate u r)) := ⟨fun p => h p.down⟩
    simp only [h,ite_false,Arm,Fintype.card_prod,Fintype.card_eq_zero,zero_mul,Nat.cast_zero]

lemma card_marked_arm (u r m : U) :
    (Fintype.card {a : Arm G gate u r // middle G gate a=m}:ℝ)=
      GatedArmKernel.feature G gate u (r,m) := by
  classical
  by_cases h : gate u r ∧ G.Adj u m ∧ G.Adj r m
  · haveI : Nonempty {a : Arm G gate u r // middle G gate a=m} :=
      ⟨⟨⟨⟨h.1⟩,⟨m,h.2⟩⟩,rfl⟩⟩
    haveI : Subsingleton {a : Arm G gate u r // middle G gate a=m} := ⟨by
      intro a b
      apply Subtype.ext
      exact Prod.ext (Subsingleton.elim _ _) (Subtype.ext (a.property.trans b.property.symm))⟩
    have hc : Fintype.card {a : Arm G gate u r // middle G gate a=m}=1 := by
      simpa only [Nat.card_eq_fintype_card] using
        Nat.card_unique (α := {a : Arm G gate u r // middle G gate a=m})
    rw [hc]
    simp [GatedArmKernel.feature,h.1,SimpleGraph.adjMatrix,h.2.1,h.2.2.symm]
  · haveI : IsEmpty {a : Arm G gate u r // middle G gate a=m} := ⟨by
      intro a
      have ha := a.val.2.property
      change G.Adj u (middle G gate a.val) ∧ G.Adj r (middle G gate a.val) at ha
      rw [a.property] at ha
      exact h ⟨a.val.1.down,ha⟩⟩
    rw [Fintype.card_eq_zero,Nat.cast_zero]
    unfold GatedArmKernel.feature
    by_cases hg : gate u r
    · rw [if_pos hg]
      have hn : ¬(G.Adj u m ∧ G.Adj m r) := fun ha => h ⟨hg,ha.1,ha.2.symm⟩
      simp only [SimpleGraph.adjMatrix]
      by_cases h₁ : G.Adj u m
      · have h₂ : ¬G.Adj m r := fun ha => hn ⟨h₁,ha⟩
        simp [h₁,h₂]
      · simp [h₁]
    · rw [if_neg hg]

variable (F : U → R → Type) [∀ u r, Fintype (F u r)]
abbrev Fiber (r : R × U) := (u : U) × (F u r.1 × Arm G gate u r.2)
abbrev Full := Sigma (Fiber G gate F)
noncomputable instance fiberFintype (r : R × U) : Fintype (Fiber G gate F r) := by classical exact inferInstance

def hub (p : Full G gate F) : U := p.2.1
def tip (p : Full G gate F) : U := middle G gate p.2.2.2

noncomputable def rest : Matrix U R ℝ := fun u r => Fintype.card (F u r)
noncomputable def weight : Matrix U U ℝ := rest F * (rest F).transpose

lemma weight_nonnegGram : IsNonnegGram (weight F) :=
  IsNonnegGram.self (rest F) (fun _ _ => Nat.cast_nonneg _)

lemma fiber_card (r : R × U) : (Fintype.card (Fiber G gate F r):ℝ)=
    ∑ u, rest F u r.1 * GatedArmKernel.matrix G gate u r.2 := by
  classical
  rw [Fintype.card_sigma,Nat.cast_sum]
  apply sum_congr rfl
  intro u _
  rw [Fintype.card_prod,Nat.cast_mul,card_arm]
  rfl

lemma agreement_card : (Nat.card (FiberRestrictionEnergy.Agreement (Fiber G gate F)):ℝ)=
    ∑ u, ∑ v, weight F u v *
      (GatedArmKernel.matrix G gate * (GatedArmKernel.matrix G gate).transpose) u v := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (FiberRestrictionEnergy.agreementEquiv (Fiber G gate F)),
    Fintype.card_sigma,Nat.cast_sum]
  simp only [Fintype.card_prod,Nat.cast_mul,←pow_two,Nat.cast_pow,fiber_card,Fintype.sum_prod_type]
  exact ArmTensor.mixed_total (rest F) (GatedArmKernel.matrix G gate)

abbrev Marked (role : Full G gate F → U) (r : R × U) (x : U) :=
  {p : Fiber G gate F r // role ⟨r,p⟩=x}

lemma pin_card (role : Full G gate F → U) :
    (Nat.card (RestrictionDeletion.RolePin (Fiber G gate F) role):ℝ)=
      ∑ r, ∑ x, (Fintype.card (Marked G gate F role r x):ℝ)^2 := by
  classical
  rw [Nat.card_eq_fintype_card,Fintype.card_congr (Erdos571.markedPairEquiv (Fiber G gate F) role)]
  simp only [Fintype.card_sigma,Fintype.card_prod,Nat.cast_sum,Nat.cast_mul,←pow_two,Nat.cast_pow]

def hubEquiv (r : R × U) (u : U) : Marked G gate F (hub G gate F) r u ≃
    F u r.1 × Arm G gate u r.2 where
  toFun p := by rcases p with ⟨⟨v,f,a⟩,h⟩; change v=u at h; subst v; exact ⟨f,a⟩
  invFun p := ⟨⟨u,p⟩,rfl⟩
  left_inv p := by rcases p with ⟨⟨v,f,a⟩,h⟩; change v=u at h; subst v; rfl
  right_inv _ := rfl

lemma hub_marked_card (r : R × U) (u : U) :
    (Fintype.card (Marked G gate F (hub G gate F) r u):ℝ)=
      rest F u r.1 * GatedArmKernel.matrix G gate u r.2 := by
  classical
  rw [Fintype.card_congr (hubEquiv G gate F r u),Fintype.card_prod,Nat.cast_mul,card_arm]
  rfl

lemma hub_pin_card :
    (Nat.card (RestrictionDeletion.RolePin (Fiber G gate F) (hub G gate F)):ℝ)=
      ∑ u, weight F u u *
        (GatedArmKernel.matrix G gate * (GatedArmKernel.matrix G gate).transpose) u u := by
  classical
  rw [pin_card]
  simp_rw [hub_marked_card]
  simp only [Fintype.sum_prod_type]
  rw [sum_comm]
  conv_lhs => arg 2; ext r; rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro u _
  rw [sum_comm]
  simp only [weight,rest,Matrix.mul_apply,Matrix.transpose_apply,mul_pow,pow_two,sum_mul_sum]
  exact sum_congr rfl (fun r _ => sum_congr rfl (fun x _ => by ring))

def tipEquiv (r : R × U) (m : U) : Marked G gate F (tip G gate F) r m ≃
    ((u : U) × (F u r.1 × {a : Arm G gate u r.2 // middle G gate a=m})) where
  toFun p := ⟨p.val.1,p.val.2.1,⟨p.val.2.2,p.property⟩⟩
  invFun p := ⟨⟨p.1,p.2.1,p.2.2.val⟩,p.2.2.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma tip_pin_card :
    (Nat.card (RestrictionDeletion.RolePin (Fiber G gate F) (tip G gate F)):ℝ)=
      ∑ u, ∑ v, weight F u v * GatedArmKernel.terminal G gate u v := by
  classical
  rw [pin_card]
  simp_rw [Fintype.card_congr (tipEquiv G gate F _ _)]
  simp only [Fintype.card_sigma,Nat.cast_sum,Fintype.card_prod,Nat.cast_mul,card_marked_arm,Fintype.sum_prod_type]
  have h := ArmTensor.mixed_total (rest F) (GatedArmKernel.feature G gate)
  simp only [Fintype.sum_prod_type] at h
  exact h

/-- A finite arm extension satisfies the sharp relative terminal-pin bound.
All three cardinalities use precisely the same extension family. -/
theorem terminal_pin_sq (H : SimpleGraph U) (m : ℕ) (hm : 2 ≤ m)
    (hH : H.CliqueFree m) (D q : ℝ) (hD : 0 ≤ D) (hq : 0 ≤ q)
    (hdeg : ∀ u, (G.degree u:ℝ) ≤ D)
    (hs : (GatedArmKernel.matrix G gate).IsSymm)
    (hgate : ∀ u v, u ≠ v → ¬H.Adj u v → gate u v)
    (hmin : ∀ u, q ≤ (GatedArmKernel.matrix G gate *
      (GatedArmKernel.matrix G gate).transpose) u u) :
    q*(Nat.card (RestrictionDeletion.RolePin (Fiber G gate F) (tip G gate F)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (RestrictionDeletion.RolePin (Fiber G gate F) (hub G gate F)):ℝ)*
        (q*(Nat.card (RestrictionDeletion.RolePin (Fiber G gate F) (hub G gate F)):ℝ) +
          D^2*(Nat.card (FiberRestrictionEnergy.Agreement (Fiber G gate F)):ℝ)) := by
  rw [tip_pin_card,hub_pin_card,agreement_card]
  apply NonnegativeGramMoments.terminal_sq (weight F) (GatedArmKernel.terminal G gate)
    (GatedArmKernel.matrix G gate) (weight_nonnegGram F) (GatedArmKernel.terminal_nonnegGram G gate)
    hs H m hm hH D q hD hq (GatedArmKernel.nonneg G gate)
    (GatedArmKernel.terminal_diag_le G gate) _ hmin
  intro u v hne hn
  rw [GatedArmKernel.matrix,if_pos (hgate u v hne hn)]
  exact GatedArmKernel.terminal_le G gate D hdeg u v

end Erdos571.ArmExtensionFamily

/-! Transport of exact agreement and pin counts along a label-compatible
bijection. -/
namespace Erdos571.ArmFamilyTransport
variable {R S U : Type} {F : R → Type} {E : S → Type}

def agreementEquiv (e : Sigma F ≃ Sigma E)
    (he : ∀ p q, p.1=q.1 ↔ (e p).1=(e q).1) :
    FiberRestrictionEnergy.Agreement F ≃ FiberRestrictionEnergy.Agreement E :=
  Equiv.subtypeEquiv (e.prodCongr e) (fun p => he p.1 p.2)

def pinEquiv (e : Sigma F ≃ Sigma E)
    (he : ∀ p q, p.1=q.1 ↔ (e p).1=(e q).1)
    (f : Sigma F → U) (g : Sigma E → U) (hf : ∀ p, f p=g (e p)) :
    RestrictionDeletion.RolePin F f ≃ RestrictionDeletion.RolePin E g :=
  Equiv.subtypeEquiv (e.prodCongr e) (fun p => by
    change (p.1.1=p.2.1 ∧ f p.1=f p.2) ↔ ((e p.1).1=(e p.2).1 ∧ g (e p.1)=g (e p.2))
    rw [he,hf,hf])

end Erdos571.ArmFamilyTransport

/-! A root-label-preserving arm-extension equivalence at a central arm. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridCentralArmExtension
open Finset SimpleGraph HybridMixed
variable {W I J K : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

abbrev Choice (u : W) := (r : W) × MaskedBush.Arm G L u r
abbrev LabeledSide (X : Type) (u : W) := (r : EndLabels (W:=W) X) × Side G L X u r
abbrev Flat := (u : W) × ((I → Choice G L u) × (LabeledSide G L J u × LabeledSide G L K u))

def flatten : Full G L I J K ≃ Flat (I:=I) (J:=J) (K:=K) G L where
  toFun p := ⟨p.2.1,(fun i => ⟨p.1.1 i,p.2.2.1 i⟩),⟨p.1.2.1,p.2.2.2.1⟩,⟨p.1.2.2,p.2.2.2.2⟩⟩
  invFun p := ⟨(fun i => (p.2.1 i).1,p.2.2.1.1,p.2.2.2.1),p.1,
    (fun i => (p.2.1 i).2),p.2.2.1.2,p.2.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

variable (i : I)
abbrev Rest (u : W) (r : Roots (W:=W) (MaskedBush.Without i) J K) :=
  At G L (MaskedBush.Without i) J K r u
noncomputable instance restFintype (u : W) (r : Roots (W:=W) (MaskedBush.Without i) J K) :
    Fintype (Rest (J:=J) (K:=K) G L i u r) := by classical exact inferInstance
abbrev Extended := ArmExtensionFamily.Full G (MaskedBush.Light G L) (Rest (J:=J) (K:=K) G L i)
abbrev SplitFlat := (u : W) × ((Choice G L u × (MaskedBush.Without i → Choice G L u)) ×
  (LabeledSide G L J u × LabeledSide G L K u))

def splitFlat : Flat (I:=I) (J:=J) (K:=K) G L ≃ SplitFlat (J:=J) (K:=K) G L i :=
  Equiv.sigmaCongrRight (fun u => (Equiv.piSplitAt i (fun _ => Choice G L u)).prodCongr (Equiv.refl _))

def flattenExtended : Extended (J:=J) (K:=K) G L i ≃ SplitFlat (J:=J) (K:=K) G L i where
  toFun p := ⟨p.2.1,(⟨p.1.2,p.2.2.2⟩,fun j => ⟨p.1.1.1 j,p.2.2.1.1 j⟩),
    ⟨p.1.1.2.1,p.2.2.1.2.1⟩,⟨p.1.1.2.2,p.2.2.1.2.2⟩⟩
  invFun p := ⟨((fun j => (p.2.1.2 j).1,p.2.2.1.1,p.2.2.2.1),p.2.1.1.1),
    p.1,⟨(fun j => (p.2.1.2 j).2),p.2.2.1.2,p.2.2.2.2⟩,p.2.1.1.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable def equiv : Full G L I J K ≃ Extended (J:=J) (K:=K) G L i :=
  ((flatten G L).trans (splitFlat G L i)).trans (flattenExtended G L i).symm

lemma labels (p q : Full G L I J K) :
    p.1=q.1 ↔ (equiv G L i p).1=(equiv G L i q).1 := by
  change p.1=q.1 ↔ ((fun j : MaskedBush.Without i => p.1.1 j.val,p.1.2),p.1.1 i)=
    ((fun j : MaskedBush.Without i => q.1.1 j.val,q.1.2),q.1.1 i)
  constructor
  · intro h
    exact congrArg (fun r : Roots (W:=W) I J K => ((fun j : MaskedBush.Without i => r.1 j.val,r.2),r.1 i)) h
  · intro h
    apply Prod.ext
    · funext j
      by_cases hj : j=i
      · subst j
        exact congrArg Prod.snd h
      · exact congrArg (fun r : (Roots (W:=W) (MaskedBush.Without i) J K) × W => r.1.1 ⟨j,hj⟩) h
    · exact congrArg (fun r : (Roots (W:=W) (MaskedBush.Without i) J K) × W => r.1.2) h

lemma hub_eq (p : Full G L I J K) : center G L p = ArmExtensionFamily.hub G (MaskedBush.Light G L)
    (Rest (J:=J) (K:=K) G L i) (equiv G L i p) := rfl

lemma tip_eq (p : Full G L I J K) : centralMiddle G L p i = ArmExtensionFamily.tip G (MaskedBush.Light G L)
    (Rest (J:=J) (K:=K) G L i) (equiv G L i p) := rfl

lemma agreement_card : Nat.card (Agreement G L I J K)=
    Nat.card (FiberRestrictionEnergy.Agreement (ArmExtensionFamily.Fiber G (MaskedBush.Light G L)
      (Rest (J:=J) (K:=K) G L i))) :=
  Nat.card_congr (ArmFamilyTransport.agreementEquiv (equiv G L i) (labels G L i))

lemma hub_pin_card : Nat.card (Pin G L (center G L : Full G L I J K → W))=
    Nat.card (RestrictionDeletion.RolePin (ArmExtensionFamily.Fiber G (MaskedBush.Light G L)
      (Rest (J:=J) (K:=K) G L i)) (ArmExtensionFamily.hub G (MaskedBush.Light G L) _)) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (equiv G L i) (labels G L i) _ _ (hub_eq G L i))

lemma tip_pin_card : Nat.card (Pin G L (fun p : Full G L I J K => centralMiddle G L p i))=
    Nat.card (RestrictionDeletion.RolePin (ArmExtensionFamily.Fiber G (MaskedBush.Light G L)
      (Rest (J:=J) (K:=K) G L i)) (ArmExtensionFamily.tip G (MaskedBush.Light G L) _)) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (equiv G L i) (labels G L i) _ _ (tip_eq G L i))

end Erdos571.HybridCentralArmExtension

/-! Complete one-arm extensions at a hybrid endpoint. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridEndpointArmExtension
open Finset SimpleGraph HybridMixed
variable {W I J K : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

abbrev Choice (u : W) := (r : W) × MaskedBush.Arm G L u r
abbrev FullChoice (u : W) := (r : W) × G.commonNeighbors u r
abbrev OtherRoots := (I → W) × EndLabels (W:=W) K
abbrev Other (u : W) (r : OtherRoots (W:=W) (I:=I) (K:=K)) :=
  (x : W) × (MaskedBush.Bundle G L I x r.1 × (G.commonNeighbors x u × Side G L K x r.2))
abbrev LabeledOther (u : W) := (r : OtherRoots (W:=W) (I:=I) (K:=K)) × Other G L u r
abbrev Flat := (u : W) × ((J → Choice G L u) × (FullChoice G u × LabeledOther (I:=I) (K:=K) G L u))

def flatten : Full G L I J K ≃ Flat (I:=I) (J:=J) (K:=K) G L where
  toFun p := ⟨p.2.2.2.1.1,(fun j => ⟨p.1.2.1.1 j,p.2.2.2.1.2.2.1 j⟩),
    ⟨p.1.2.1.2,p.2.2.2.1.2.2.2⟩,⟨(p.1.1,p.1.2.2),p.2.1,p.2.2.1,p.2.2.2.1.2.1,p.2.2.2.2⟩⟩
  invFun p := ⟨(p.2.2.2.1.1,((fun j => (p.2.1 j).1),p.2.2.1.1),p.2.2.2.1.2),
    p.2.2.2.2.1,p.2.2.2.2.2.1,
    ⟨p.1,p.2.2.2.2.2.2.1,(fun j => (p.2.1 j).2),p.2.2.1.2⟩,p.2.2.2.2.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

variable (i : J)
abbrev RestRoots := EndLabels (W:=W) (MaskedBush.Without i) × OtherRoots (W:=W) (I:=I) (K:=K)
abbrev Rest (u : W) (r : RestRoots (W:=W) (I:=I) (K:=K) i) :=
  MaskedBush.Bundle G L (MaskedBush.Without i) u r.1.1 ×
    (G.commonNeighbors u r.1.2 × Other G L u r.2)
noncomputable instance restFintype (u : W) (r : RestRoots (W:=W) (I:=I) (K:=K) i) :
    Fintype (Rest G L i u r) := by classical exact inferInstance
abbrev Extended := ArmExtensionFamily.Full G (MaskedBush.Light G L) (Rest (I:=I) (K:=K) G L i)
abbrev SplitFlat := (u : W) × ((Choice G L u × (MaskedBush.Without i → Choice G L u)) ×
  (FullChoice G u × LabeledOther (I:=I) (K:=K) G L u))

def splitFlat : Flat (I:=I) (J:=J) (K:=K) G L ≃ SplitFlat (I:=I) (K:=K) G L i :=
  Equiv.sigmaCongrRight (fun u => (Equiv.piSplitAt i (fun _ => Choice G L u)).prodCongr (Equiv.refl _))

def flattenExtended : Extended (I:=I) (K:=K) G L i ≃ SplitFlat (I:=I) (K:=K) G L i where
  toFun p := ⟨p.2.1,(⟨p.1.2,p.2.2.2⟩,fun j => ⟨p.1.1.1.1 j,p.2.2.1.1 j⟩),
    ⟨p.1.1.1.2,p.2.2.1.2.1⟩,⟨p.1.1.2,p.2.2.1.2.2⟩⟩
  invFun p := ⟨((((fun j => (p.2.1.2 j).1),p.2.2.1.1),p.2.2.2.1),p.2.1.1.1),
    p.1,⟨(fun j => (p.2.1.2 j).2),p.2.2.1.2,p.2.2.2.2⟩,p.2.1.1.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable def equiv : Full G L I J K ≃ Extended (I:=I) (K:=K) G L i :=
  ((flatten G L).trans (splitFlat G L i)).trans (flattenExtended G L i).symm

lemma labels (p q : Full G L I J K) : p.1=q.1 ↔ (equiv G L i p).1=(equiv G L i q).1 := by
  change p.1=q.1 ↔ (((fun j : MaskedBush.Without i => p.1.2.1.1 j.val,p.1.2.1.2),(p.1.1,p.1.2.2)),p.1.2.1.1 i)=
    (((fun j : MaskedBush.Without i => q.1.2.1.1 j.val,q.1.2.1.2),(q.1.1,q.1.2.2)),q.1.2.1.1 i)
  constructor
  · intro h
    exact congrArg (fun r : Roots (W:=W) I J K =>
      (((fun j : MaskedBush.Without i => r.2.1.1 j.val,r.2.1.2),(r.1,r.2.2)),r.2.1.1 i)) h
  · intro h
    apply Prod.ext
    · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (K:=K) i × W => r.1.2.1) h
    · apply Prod.ext
      · apply Prod.ext
        · funext j
          by_cases hj : j=i
          · subst j; exact congrArg Prod.snd h
          · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (K:=K) i × W => r.1.1.1 ⟨j,hj⟩) h
        · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (K:=K) i × W => r.1.1.2) h
      · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (K:=K) i × W => r.1.2.2) h

lemma hub_eq (p : Full G L I J K) : leftHub G L p = ArmExtensionFamily.hub G (MaskedBush.Light G L)
    (Rest (I:=I) (K:=K) G L i) (equiv G L i p) := rfl
lemma tip_eq (p : Full G L I J K) : leftMiddle G L p i = ArmExtensionFamily.tip G (MaskedBush.Light G L)
    (Rest (I:=I) (K:=K) G L i) (equiv G L i p) := rfl

lemma agreement_card : Nat.card (Agreement G L I J K)=
    Nat.card (FiberRestrictionEnergy.Agreement (ArmExtensionFamily.Fiber G (MaskedBush.Light G L)
      (Rest (I:=I) (K:=K) G L i))) :=
  Nat.card_congr (ArmFamilyTransport.agreementEquiv (equiv G L i) (labels G L i))
lemma hub_pin_card : Nat.card (Pin G L (leftHub G L : Full G L I J K → W))=
    Nat.card (RestrictionDeletion.RolePin (ArmExtensionFamily.Fiber G (MaskedBush.Light G L)
      (Rest (I:=I) (K:=K) G L i)) (ArmExtensionFamily.hub G (MaskedBush.Light G L) _)) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (equiv G L i) (labels G L i) _ _ (hub_eq G L i))
lemma tip_pin_card : Nat.card (Pin G L (fun p : Full G L I J K => leftMiddle G L p i))=
    Nat.card (RestrictionDeletion.RolePin (ArmExtensionFamily.Fiber G (MaskedBush.Light G L)
      (Rest (I:=I) (K:=K) G L i)) (ArmExtensionFamily.tip G (MaskedBush.Light G L) _)) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (equiv G L i) (labels G L i) _ _ (tip_eq G L i))

end Erdos571.HybridEndpointArmExtension

/-! Exact reconstruction of the untrimmed endpoint arm. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridFullArmExtension
open Finset SimpleGraph HybridMixed HybridEndpointArmExtension
variable {W I J K : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

abbrev RestRoots := (J → W) × OtherRoots (W:=W) (I:=I) (K:=K)
abbrev Rest (u : W) (r : RestRoots (W:=W) (I:=I) (J:=J) (K:=K)) :=
  MaskedBush.Bundle G L J u r.1 × Other G L u r.2
noncomputable instance restFintype (u : W) (r : RestRoots (W:=W) (I:=I) (J:=J) (K:=K)) :
    Fintype (Rest G L u r) := by classical exact inferInstance
abbrev Extended := ArmExtensionFamily.Full G (fun _ _ => True) (Rest (I:=I) (J:=J) (K:=K) G L)

def flattenExtended : Extended (I:=I) (J:=J) (K:=K) G L ≃ Flat (I:=I) (J:=J) (K:=K) G L where
  toFun p := ⟨p.2.1,(fun j => ⟨p.1.1.1 j,p.2.2.1.1 j⟩),
    ⟨p.1.2,p.2.2.2.2⟩,⟨p.1.1.2,p.2.2.1.2⟩⟩
  invFun p := ⟨(((fun j => (p.2.1 j).1),p.2.2.2.1),p.2.2.1.1),
    p.1,⟨(fun j => (p.2.1 j).2),p.2.2.2.2⟩,⟨⟨True.intro⟩,p.2.2.1.2⟩⟩
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable def equiv : Full G L I J K ≃ Extended (I:=I) (J:=J) (K:=K) G L :=
  (flatten G L).trans (flattenExtended G L).symm

lemma labels (p q : Full G L I J K) : p.1=q.1 ↔ (equiv G L p).1=(equiv G L q).1 := by
  change p.1=q.1 ↔ ((p.1.2.1.1,(p.1.1,p.1.2.2)),p.1.2.1.2)=
    ((q.1.2.1.1,(q.1.1,q.1.2.2)),q.1.2.1.2)
  constructor
  · intro h
    exact congrArg (fun r : Roots (W:=W) I J K => ((r.2.1.1,(r.1,r.2.2)),r.2.1.2)) h
  · intro h
    apply Prod.ext
    · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (J:=J) (K:=K) × W => r.1.2.1) h
    · apply Prod.ext
      · apply Prod.ext
        · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (J:=J) (K:=K) × W => r.1.1) h
        · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (J:=J) (K:=K) × W => r.2) h
      · exact congrArg (fun r : RestRoots (W:=W) (I:=I) (J:=J) (K:=K) × W => r.1.2.2) h

lemma hub_eq (p : Full G L I J K) : leftHub G L p = ArmExtensionFamily.hub G (fun _ _ => True)
    (Rest (I:=I) (J:=J) (K:=K) G L) (equiv G L p) := rfl
lemma tip_eq (p : Full G L I J K) : leftFullMiddle G L p = ArmExtensionFamily.tip G (fun _ _ => True)
    (Rest (I:=I) (J:=J) (K:=K) G L) (equiv G L p) := rfl

lemma agreement_card : Nat.card (Agreement G L I J K)=
    Nat.card (FiberRestrictionEnergy.Agreement (ArmExtensionFamily.Fiber G (fun _ _ => True)
      (Rest (I:=I) (J:=J) (K:=K) G L))) :=
  Nat.card_congr (ArmFamilyTransport.agreementEquiv (equiv G L) (labels G L))
lemma hub_pin_card : Nat.card (Pin G L (leftHub G L : Full G L I J K → W))=
    Nat.card (RestrictionDeletion.RolePin (ArmExtensionFamily.Fiber G (fun _ _ => True)
      (Rest (I:=I) (J:=J) (K:=K) G L)) (ArmExtensionFamily.hub G (fun _ _ => True) _)) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (equiv G L) (labels G L) _ _ (hub_eq G L))
lemma tip_pin_card : Nat.card (Pin G L (leftFullMiddle G L : Full G L I J K → W))=
    Nat.card (RestrictionDeletion.RolePin (ArmExtensionFamily.Fiber G (fun _ _ => True)
      (Rest (I:=I) (J:=J) (K:=K) G L)) (ArmExtensionFamily.tip G (fun _ _ => True) _)) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (equiv G L) (labels G L) _ _ (tip_eq G L))

end Erdos571.HybridFullArmExtension

/-! Terminal-pin interpolation in the exact hybrid assignment family. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridMixed
open Finset SimpleGraph Matrix
variable {W I J K : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)
variable [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]

noncomputable def swapEquiv : Full G L I J K ≃ Full G L I K J where
  toFun := swap G L
  invFun := swap G L
  left_inv := swap_swap G L
  right_inv := swap_swap G L

lemma swap_labels (p q : Full G L I J K) : p.1=q.1 ↔ (swap G L p).1=(swap G L q).1 := by
  constructor
  · exact congrArg (fun r : Roots (W:=W) I J K => (r.1,(r.2.2,r.2.1)))
  · exact congrArg (fun r : Roots (W:=W) I K J => (r.1,(r.2.2,r.2.1)))

lemma swap_agreement_card : Nat.card (Agreement G L I J K)=Nat.card (Agreement G L I K J) :=
  Nat.card_congr (ArmFamilyTransport.agreementEquiv (swapEquiv G L) (swap_labels G L))

lemma swap_pin_card (f : Full G L I J K → W) (h : Full G L I K J → W)
    (he : ∀ p, f p=h (swap G L p)) :
    Nat.card (Pin G L f)=Nat.card (Pin G L h) :=
  Nat.card_congr (ArmFamilyTransport.pinEquiv (swapEquiv G L) (swap_labels G L) f h he)

variable (H : SimpleGraph W) (m : ℕ) (hm : 2 ≤ m) (hH : H.CliqueFree m)
variable (D q : ℝ) (hD : 0 ≤ D) (hq : 0 ≤ q)
variable (hdeg : ∀ u, (G.degree u:ℝ) ≤ D)
variable (hgate : ∀ u v, u≠v → ¬H.Adj u v → MaskedBush.Light G L u v)
variable (hmin : ∀ u, q ≤ (LightArmKernel.matrix G L * (LightArmKernel.matrix G L).transpose) u u)

include hm hH hD hq hdeg hgate hmin

lemma central_terminal_sq (i : I) :
    q*(Nat.card (Pin G L (fun p : Full G L I J K => centralMiddle G L p i)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (Pin G L (center G L : Full G L I J K → W)):ℝ)*
        (q*(Nat.card (Pin G L (center G L : Full G L I J K → W)):ℝ) +
          D^2*(Nat.card (Agreement G L I J K):ℝ)) := by
  rw [HybridCentralArmExtension.tip_pin_card,HybridCentralArmExtension.hub_pin_card,
    HybridCentralArmExtension.agreement_card]
  apply ArmExtensionFamily.terminal_pin_sq G (MaskedBush.Light G L)
    (HybridCentralArmExtension.Rest G L i) H m hm hH D q hD hq hdeg _ hgate
  · simpa only [GatedArmKernel.light_matrix] using hmin
  · rw [GatedArmKernel.light_matrix]
    exact LightArmKernel.isSymm G L

lemma left_terminal_sq (i : J) :
    q*(Nat.card (Pin G L (fun p : Full G L I J K => leftMiddle G L p i)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (Pin G L (leftHub G L : Full G L I J K → W)):ℝ)*
        (q*(Nat.card (Pin G L (leftHub G L : Full G L I J K → W)):ℝ) +
          D^2*(Nat.card (Agreement G L I J K):ℝ)) := by
  rw [HybridEndpointArmExtension.tip_pin_card,HybridEndpointArmExtension.hub_pin_card,
    HybridEndpointArmExtension.agreement_card]
  apply ArmExtensionFamily.terminal_pin_sq G (MaskedBush.Light G L)
    (HybridEndpointArmExtension.Rest G L i) H m hm hH D q hD hq hdeg _ hgate
  · simpa only [GatedArmKernel.light_matrix] using hmin
  · rw [GatedArmKernel.light_matrix]
    exact LightArmKernel.isSymm G L

lemma right_terminal_sq (i : K) :
    q*(Nat.card (Pin G L (fun p : Full G L I J K => rightMiddle G L p i)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (Pin G L (rightHub G L : Full G L I J K → W)):ℝ)*
        (q*(Nat.card (Pin G L (rightHub G L : Full G L I J K → W)):ℝ) +
          D^2*(Nat.card (Agreement G L I J K):ℝ)) := by
  rw [swap_pin_card G L (fun p : Full G L I J K => rightMiddle G L p i)
    (fun p : Full G L I K J => leftMiddle G L p i) (fun _ => rfl),
    swap_pin_card G L (rightHub G L : Full G L I J K → W)
      (leftHub G L : Full G L I K J → W) (fun _ => rfl),swap_agreement_card]
  exact left_terminal_sq G L H m hm hH D q hD hq hdeg hgate hmin i

variable (hfullmin : ∀ u, q ≤ ((G.adjMatrix ℝ * G.adjMatrix ℝ)*
    (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose) u u)

omit hgate hmin
include hfullmin

lemma left_full_terminal_sq :
    q*(Nat.card (Pin G L (leftFullMiddle G L : Full G L I J K → W)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (Pin G L (leftHub G L : Full G L I J K → W)):ℝ)*
        (q*(Nat.card (Pin G L (leftHub G L : Full G L I J K → W)):ℝ) +
          D^2*(Nat.card (Agreement G L I J K):ℝ)) := by
  rw [HybridFullArmExtension.tip_pin_card,HybridFullArmExtension.hub_pin_card,
    HybridFullArmExtension.agreement_card]
  apply ArmExtensionFamily.terminal_pin_sq G (fun _ _ => True)
    (HybridFullArmExtension.Rest G L) H m hm hH D q hD hq hdeg _ (by intros; trivial)
  · simpa only [GatedArmKernel.full_matrix] using hfullmin
  · rw [GatedArmKernel.full_matrix]
    show (G.adjMatrix ℝ * G.adjMatrix ℝ).transpose=_
    simp only [Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]

lemma right_full_terminal_sq :
    q*(Nat.card (Pin G L (rightFullMiddle G L : Full G L I J K → W)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (Pin G L (rightHub G L : Full G L I J K → W)):ℝ)*
        (q*(Nat.card (Pin G L (rightHub G L : Full G L I J K → W)):ℝ) +
          D^2*(Nat.card (Agreement G L I J K):ℝ)) := by
  rw [swap_pin_card G L (rightFullMiddle G L : Full G L I J K → W)
    (leftFullMiddle G L : Full G L I K J → W) (fun _ => rfl),
    swap_pin_card G L (rightHub G L : Full G L I J K → W)
      (leftHub G L : Full G L I K J → W) (fun _ => rfl),swap_agreement_card]
  exact left_full_terminal_sq G L H m hm hH D q hD hq hdeg hfullmin

end Erdos571.HybridMixed

/-! The new finite terminal estimate on actual matched-free hosts. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridTerminalGraph
open Finset SimpleGraph Matrix GramFeatures HybridMixed
variable {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem terminal_sq (k M : ℕ) (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (H : SimpleGraph W) (m : ℕ) (hm : 2 ≤ m) (hH : H.CliqueFree m)
    (L d K : ℝ) (hL : 0 < L) (hd : 0 < d) (hK : 0 ≤ K) (hdK : 4*K ≤ d)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → (Fintype.card (G.commonNeighbors u v):ℝ) ≤ L)
    (r : HybridRoles.Arm k) :
    (Nat.card (HybridRoles.Pin k G L (.inr r)):ℝ)^2 ≤
      2*(m-1:ℕ)^2*(Nat.card (HybridRoles.Pin k G L (.inl (.inl (HybridRoles.hubIndex k r)))):ℝ)*
        ((Nat.card (HybridRoles.Pin k G L (.inl (.inl (HybridRoles.hubIndex k r)))):ℝ)+
          2*K^2*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) := by
  let A := G.adjMatrix ℝ
  let N := LightArmKernel.matrix G L
  let C := MatchedThreeHub.momentCoefficient (k+1) M*K^2
  let T := C*d^2
  have hrow (u : W) : ∑ v, ((A*A) u v)^2 ≤ T := by
    have h := MatchedThreeHub.free_fourth_row_bound (k+1) M G hf (K*d) (mul_nonneg hK hd.le) hmax u
    convert h using 1 <;> dsimp [T,C] <;> ring
  have hNrow (u : W) : d^2/2 ≤ ∑ v, N u v := by
    apply LightArmKernel.row_lower G L (K*d) T d hL hd.le hmin hmax hrow
    · nlinarith [mul_nonneg hd.le (sub_nonneg.mpr hdK)]
    · dsimp [T,C]
      nlinarith [mul_le_mul_of_nonneg_right hcut (sq_nonneg d)]
  have hdiag (u : W) : d^2/2 ≤ (N*N.transpose) u u :=
    (hNrow u).trans (LightArmKernel.gram_diagonal_lower G L u)
  have hsP : (A*A).IsSymm := by
    show (A*A).transpose=_
    simp only [A,Matrix.transpose_mul,SimpleGraph.transpose_adjMatrix]
  have hfull (u : W) : d^2/2 ≤ ((A*A)*(A*A).transpose) u u := by
    have h := (hdiag u).trans (LightArmKernel.gram_le_fourth G L u u)
    change d^2/2 ≤ ((A*A).transpose*(A*A)) u u at h
    simpa only [hsP.eq] using h
  have hgate (u v : W) (hne : u≠v) (hn : ¬H.Adj u v) : MaskedBush.Light G L u v := by
    refine ⟨hne,?_⟩
    rw [LayeredBush.adjacency_square_common_card]
    exact hlight u v hn hne
  have hraw :
      (d^2/2)*(Nat.card (HybridRoles.Pin k G L (.inr r)):ℝ)^2 ≤
        2*(m-1:ℕ)^2*(Nat.card (HybridRoles.Pin k G L (.inl (.inl (HybridRoles.hubIndex k r)))):ℝ)*
          ((d^2/2)*(Nat.card (HybridRoles.Pin k G L (.inl (.inl (HybridRoles.hubIndex k r)))):ℝ)+
            (K*d)^2*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) := by
    rcases r with ⟨j,i⟩|j
    · fin_cases j
      · exact left_terminal_sq G L H m hm hH (K*d) (d^2/2) (mul_nonneg hK hd.le) (by positivity)
          hmax hgate hdiag i
      · exact central_terminal_sq G L H m hm hH (K*d) (d^2/2) (mul_nonneg hK hd.le) (by positivity)
          hmax hgate hdiag i
      · exact right_terminal_sq G L H m hm hH (K*d) (d^2/2) (mul_nonneg hK hd.le) (by positivity)
          hmax hgate hdiag i
    · fin_cases j
      · exact left_full_terminal_sq G L H m hm hH (K*d) (d^2/2) (mul_nonneg hK hd.le) (by positivity)
          hmax hfull
      · exact right_full_terminal_sq G L H m hm hH (K*d) (d^2/2) (mul_nonneg hK hd.le) (by positivity)
          hmax hfull
  apply (mul_le_mul_iff_right₀ (show 0 < d^2/2 by positivity)).mp
  convert hraw using 1 <;> ring

lemma small_pin (x b E c K κ p : ℝ) (hx : 0 ≤ x) (hb : 0 ≤ b) (hE : 0 ≤ E)
    (hκ : 0 ≤ κ) (hκ1 : κ ≤ 1) (hp : 0 ≤ p)
    (h : x^2 ≤ 2*c^2*b*(b+2*K^2*E)) (hsmall : b ≤ κ*E)
    (hscale : 2*c^2*κ*(1+2*K^2) ≤ p^2) : x ≤ p*E := by
  apply (pow_le_pow_iff_left₀ hx (mul_nonneg hp hE) (by decide : 2≠0)).mp
  have hsecond : b+2*K^2*E ≤ (1+2*K^2)*E := by
    have hh := hsmall.trans (mul_le_mul_of_nonneg_right hκ1 hE)
    nlinarith
  calc
    _ ≤ 2*c^2*b*(b+2*K^2*E) := h
    _ ≤ (2*c^2*(κ*E))*((1+2*K^2)*E) :=
      mul_le_mul (mul_le_mul_of_nonneg_left hsmall (by positivity)) hsecond
        (by positivity) (by positivity)
    _ = (2*c^2*κ*(1+2*K^2))*E^2 := by ring
    _ ≤ p^2*E^2 := mul_le_mul_of_nonneg_right hscale (sq_nonneg _)
    _ = _ := (mul_pow _ _ _).symm

end Erdos571.HybridTerminalGraph

/-! A finite certificate accepting every pin explicitly, without the old terminal deletion cost. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridRoles
open Finset SimpleGraph
variable (k : ℕ) {W : Type} [Fintype W] [DecidableEq W]
variable (G : SimpleGraph W) [DecidableRel G.Adj] (L : ℝ)

open Classical in
theorem not_free_of_pin_counts (M : ℕ) (hM : 2 ≤ M)
    (g : W → Bool) (hg : ∀ {u v}, G.Adj u v → g u≠g v)
    (H : SimpleGraph W) (m cap : ℕ) (hk : 2 ≤ m) (hH : H.CliqueFree m)
    (hlight : ∀ u v, ¬H.Adj u v → u≠v → Fintype.card (G.commonNeighbors u v) ≤ cap)
    (hL : 0 ≤ L) (hcap : L ≤ cap)
    (ε p μ : ℝ) (hε : 0 ≤ ε)
    (hp : p ≤ ε^2) (hε1 : ε^2 ≤ ε)
    (hattach : (m-1:ℕ)*(p+cap*μ) ≤ ε^2) (hroot : (cap:ℝ)^2*μ ≤ ε^2)
    (hsmall : (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
      (A := RootedSubdivision.Nonroot (HybridThreeHub.base k))
      (R := RootedSubdivision.Root (HybridThreeHub.base k))):ℝ)+
        (Nat.card (RootedSubdivision.Nonroot (HybridThreeHub.base k)):ℝ)^2)*ε < 1)
    (hpos : 0 < (Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hpin : ∀ a : Interior k, (Nat.card (Pin k G L a):ℝ) ≤
      p*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hcoll : ∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (coreCollision k G L c)):ℝ) ≤
      ε^2*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
      (HybridThreeHubAssignments.SameFullRoots G L k)):ℝ) ≤
        ε^2*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ))
    (hdel : ∀ r : Arm k, (Nat.card (FiberRestrictionEnergy.Agreement (deletionWitness k G L r).E):ℝ) ≤
      μ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) :
    ¬(HybridThreeHub.graph k M).Free G := by
  classical
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G L k)
  have hE : 0 ≤ E := hpos.le
  have heq : ∀ v w : Vertex k, v≠w → (Nat.card (EqualBoth k G L v w):ℝ) ≤ ε^2*E := by
    apply all_collision_bounds k G L g hg H m cap hk hH hlight hL hcap (p*E) (μ*E) (ε^2*E)
      (mul_nonneg (sq_nonneg _) hE) (mul_le_mul_of_nonneg_right hp hE) hjoined _ _ hpin hcoll hdel
    · have h := mul_le_mul_of_nonneg_right hattach hE
      nlinarith
    · have h := mul_le_mul_of_nonneg_right hroot hE
      nlinarith
  apply HomFamilyEnergy.not_free_of_uniform_energies_nat (HybridThreeHubAssignments.Fiber G L k)
    (HybridThreeHubAssignments.hom G L k) M hM (HybridThreeHubAssignments.same_roots G L k)
    ε hε hsmall hpos
  · intro q
    have he : (fun p : Full k G L => HybridThreeHubAssignments.hom G L k p q.1.1=
        HybridThreeHubAssignments.hom G L k p q.1.2)=
        (fun p => value k G L p (vertexIndex k q.1.1)=value k G L p (vertexIndex k q.1.2)) := by
      funext p
      rw [hom_value,hom_value]
    change (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k) _):ℝ) ≤ _
    rw [he]
    exact heq _ _ (fun h => q.property (vertexIndex_injective k h))
  · intro a
    have he : (fun p : Full k G L => HybridThreeHubAssignments.hom G L k p (.inl a))=
        (fun p => interiorValue k G L p (interiorIndex k a)) := by
      funext p
      exact hom_value k G L p (.inl a)
    change (Nat.card (RestrictionDeletion.RolePin (HybridThreeHubAssignments.Fiber G L k) _):ℝ) ≤ _
    rw [he]
    exact (hpin _).trans (mul_le_mul_of_nonneg_right (hp.trans hε1) hE)

end Erdos571.HybridRoles

/-! Separate core and deletion tolerances. The deletion error no longer pays a maximum-degree factor. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridInterpolatedScales
open Finset SimpleGraph HybridScales

lemma scaled_order_le_fourth (k : ℕ) (hk : 1 ≤ k) (n d τ B : ℝ)
    (hn : 0 ≤ n) (hd : 1 ≤ d) (hτ : 0 ≤ τ)
    (hscale : (4:ℝ)^(3*k+1) ≤ τ^(3*k+1)*B)
    (hdense : B*n^(3*k+1) ≤ d^(6*k+8)) : 4*n ≤ τ*d^4 := by
  by_cases hKn : 0 ≤ 4*n
  swap
  · exact (le_of_not_ge hKn).trans (mul_nonneg hτ (pow_nonneg (by linarith : 0 ≤ d) _))
  apply (pow_le_pow_iff_left₀ hKn (mul_nonneg hτ (pow_nonneg (by linarith : 0 ≤ d) _))
    (by omega : 3*k+1≠0)).mp
  calc
    _ = (4:ℝ)^(3*k+1)*n^(3*k+1) := mul_pow _ _ _
    _ ≤ (τ^(3*k+1)*B)*n^(3*k+1) := mul_le_mul_of_nonneg_right hscale (pow_nonneg hn _)
    _ = τ^(3*k+1)*(B*n^(3*k+1)) := by ring
    _ ≤ τ^(3*k+1)*d^(6*k+8) := mul_le_mul_of_nonneg_left hdense (pow_nonneg hτ _)
    _ ≤ τ^(3*k+1)*d^(4*(3*k+1)) := mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ hd (by omega : 6*k+8 ≤ 4*(3*k+1))) (pow_nonneg hτ _)
    _ = _ := by rw [pow_mul,mul_pow]

theorem exists_scale (k M : ℕ) (K κ μ : ℝ) (hκ : 0 < κ) (hμ : 0 < μ) :
    ∃ B : ℝ, 1 ≤ B ∧ (4*K)^(6*k+8)<B ∧
      coreCoefficient k M K*(2:ℝ)^(6*k) ≤ κ^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ κ^3*B ∧
      (4:ℝ)^(3*k+1) ≤ μ^(3*k+1)*B := by
  obtain ⟨B,hB,hlarge,hcore,hcoll,_⟩ := HybridScales.exists_scale k M K κ hκ
  let C := max B ((4/μ)^(3*k+1))
  have hBC : B ≤ C := le_max_left _ _
  refine ⟨C,hB.trans hBC,hlarge.trans_le hBC,
    hcore.trans (mul_le_mul_of_nonneg_left hBC (pow_nonneg hκ.le _)),
    hcoll.trans (mul_le_mul_of_nonneg_left hBC (pow_nonneg hκ.le _)),?_⟩
  have h := mul_le_mul_of_nonneg_left (le_max_right B ((4/μ)^(3*k+1))) (pow_nonneg hμ.le (3*k+1))
  have he : μ^(3*k+1)*(4/μ)^(3*k+1)=(4:ℝ)^(3*k+1) := by
    rw [←mul_pow]
    congr 1
    field_simp
  exact he ▸ h

variable {W : Type} [Fintype W] [DecidableEq W] [Nonempty W]
variable (G : SimpleGraph W) [DecidableRel G.Adj]

theorem all_counts_small (k M : ℕ) (hk : 1 ≤ k)
    (hf : (MatchedThreeHub.graph (k+1) M).Free G)
    (L d K κ μ B : ℝ) (hL : 0 < L) (hd : 1 ≤ d) (hK : 1 ≤ K)
    (hdK : 4*K ≤ d) (hκ : 0 ≤ κ) (hμ : 0 ≤ μ) (hB : 1 ≤ B)
    (hmin : ∀ u, d ≤ (G.degree u:ℝ)) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (hcut : 4*MatchedThreeHub.momentCoefficient (k+1) M*K^2 ≤ L)
    (hscale : coreCoefficient k M K*(2:ℝ)^(6*k) ≤ κ^3*B ∧
      collisionCoefficient k M K*(2:ℝ)^(6*k) ≤ κ^3*B ∧
      (4:ℝ)^(3*k+1) ≤ μ^(3*k+1)*B)
    (hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8)) :
    (∀ c : HybridRoles.Core, (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤
      κ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ c : ThreeHubMixed.CoreCollision,
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤
      κ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) ∧
    (∀ r : HybridRoles.Arm k,
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E):ℝ) ≤
      μ*(Nat.card (HybridThreeHubAssignments.Agreement G L k):ℝ)) := by
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G L k)
  have hd0 : 0 < d := by linarith
  have hK0 : 0 < K := by linarith
  have hD : 0 < K*d := mul_pos hK0 hd0
  have hE : 0 ≤ E := Nat.cast_nonneg _
  have hC : 0 ≤ MatchedThreeHub.momentCoefficient (k+1) M*K^2 :=
    mul_nonneg (MatchedThreeHub.momentCoefficient_nonneg _ _) (sq_nonneg K)
  have hB0 : 0 < B := by linarith
  have henergy := dense_energy_scalar k (Fintype.card W:ℝ) d E B
    (by exact_mod_cast Fintype.card_pos) hd0.le
    (free_energy_lower G k M hf L d K hL hd0 hK0.le hdK hmin hmax hcut) hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G L (.inl c)):ℝ) ≤ κ*E := by
    apply power_small 3 (by omega) _ (coreCoefficient k M K) (Fintype.card W:ℝ) d E B κ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [coreCoefficient]; positivity) hE hB0 hκ _ henergy hscale.1
    have h := HybridThreeHubAssignments.all_core_pin_cubic G L k M hf d K hL hd0 hK0.le hdK hmin hmax hcut
      (fun p => HybridRoles.coreValue k G L p c) (by
        rcases c with i|i
        · fin_cases i
          · exact Or.inr (Or.inl rfl)
          · exact Or.inl rfl
          · exact Or.inr (Or.inr (Or.inl rfl))
        · fin_cases i
          · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
          · exact Or.inr (Or.inr (Or.inr (Or.inr rfl))))
    simpa only [coreCoefficient,show 6*(k+1)+2=6*k+8 by omega] using h
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G L k)
        (HybridRoles.coreCollision k G L c)):ℝ) ≤ κ*E := by
    apply power_small 3 (by omega) _ (collisionCoefficient k M K) (Fintype.card W:ℝ) d E B κ _ (6*k+8)
      (Nat.cast_nonneg _) (by dsimp [collisionCoefficient]; positivity) hE hB0 hκ _ henergy hscale.2.1
    exact HybridThreeHubAssignments.all_core_collision_cubic G L k M hf d K hL hd0 hK0.le hdK hmin hmax hcut
      (HybridRoles.coreCollision k G L c) (by
        cases c
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl)))
  refine ⟨hcore,hcoll,?_⟩
  intro r
  let Δ : ℝ := Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G L r).E)
  have hdel := HybridPositiveScales.free_deleted_linear G k M hk hf L d K hL hd0 hK0.le hdK hmin hmax hcut r
  have hn := scaled_order_le_fourth k hk (Fintype.card W:ℝ) d μ B (Nat.cast_nonneg _) hd hμ hscale.2.2 hdense
  apply (mul_le_mul_iff_right₀ (pow_pos hd0 4)).mp
  have h₁ := mul_le_mul_of_nonneg_left hdel (by norm_num : (0:ℝ) ≤ 4)
  have h₂ := mul_le_mul_of_nonneg_right hn hE
  nlinarith [h₁,h₂]

end Erdos571.HybridInterpolatedScales

/-! Sharp degree bound for matched hybrid three-hub powers, with k >= 1. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridInterpolatedUpper
open Finset SimpleGraph Matrix

theorem free_degree_bound (k M : ℕ) (hk : 1 ≤ k) (hM : 2 ≤ M) (K : ℝ) (hK : 1 ≤ K) :
    ∃ B : ℝ, 0 < B ∧ ∀ {W : Type} [Fintype W] [Nonempty W] [DecidableEq W]
      (G : SimpleGraph W) [DecidableRel G.Adj], G.IsBipartite →
      ∀ d : ℝ, 1 ≤ d → (∀ u, d ≤ (G.degree u:ℝ) ∧ (G.degree u:ℝ) ≤ K*d) →
      (MatchedThreeHub.graph (k+1) M).Free G →
      d^(6*k+8) < B*(Fintype.card W:ℝ)^(3*k+1) := by
  classical
  let C := MatchedThreeHub.momentCoefficient (k+1) M
  let m := Fintype.card (MatchedThreeHub.Branch (k+1) M)
  let t := m+Nat.card (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)).edgeSet
  let cap : ℕ := Nat.ceil (4*C*K^2+1+(t:ℝ))
  have hC : 0 ≤ C := MatchedThreeHub.momentCoefficient_nonneg (k+1) M
  have hK0 : 0 ≤ K := by linarith
  have hm : 2 ≤ m := by
    dsimp [m,MatchedThreeHub.Branch]
    simp only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin]
    omega
  have hcap : 4*C*K^2+1+(t:ℝ) ≤ (cap:ℝ) := Nat.le_ceil _
  have hcut : 4*C*K^2 ≤ (cap:ℝ) := by have ht0 : (0:ℝ) ≤ t := Nat.cast_nonneg _; linarith
  have htc : t ≤ cap := by
    have hh : (t:ℝ) ≤ (cap:ℝ) := by nlinarith [mul_nonneg hC (sq_nonneg K)]
    exact_mod_cast hh
  have hcapPos : (0:ℝ) < cap := by nlinarith [mul_nonneg hC (sq_nonneg K),(show (0:ℝ) ≤ t from Nat.cast_nonneg t)]
  let c : ℝ := (m-1:ℕ)
  have hc : 1 ≤ c := by dsimp [c]; exact_mod_cast (show 1 ≤ m-1 by omega)
  let pack : ℝ := (M-1:ℕ)*(2*(Nat.card (HomFamilyEnergy.DistinctRoles
    (A := RootedSubdivision.Nonroot (HybridThreeHub.base k))
    (R := RootedSubdivision.Root (HybridThreeHub.base k))):ℝ)+
      (Nat.card (RootedSubdivision.Nonroot (HybridThreeHub.base k)):ℝ)^2)
  have hpack : 0 ≤ pack := by dsimp [pack]; positivity
  obtain ⟨ε,τ,hε,hε1,hτ,hτ1,hsmall,hpSmall,hattach,hroot⟩ :=
    MaskedBushCoefficients.choose pack c cap hpack hc (Nat.cast_nonneg _)
  let R := (2*(C*K^2))^k
  have hR : 0 ≤ R := pow_nonneg (by positivity) _
  let p := c*(1+cap)*τ
  have hp : 0 < p := by dsimp [p]; positivity
  have hpSmall' : p ≤ ε^2 := hpSmall
  have hεsq : ε^2 ≤ ε := by nlinarith
  have hp1 : p ≤ 1 := hpSmall'.trans (hεsq.trans hε1)
  have hτp : τ ≤ p := by
    have hh : 1 ≤ c*(1+cap) := by nlinarith [(show (0:ℝ) ≤ cap from Nat.cast_nonneg _)]
    simpa only [one_mul] using (mul_le_mul_of_nonneg_right hh hτ.le)
  let S := 2*c^2*(1+2*K^2)+R+1
  have hS : 0 < S := by dsimp [S]; positivity
  let σ := min τ (p^2/S)
  have hσ : 0 < σ := lt_min hτ (div_pos (sq_pos_of_pos hp) hS)
  have hστ : σ ≤ τ := min_le_left _ _
  have hσ1 : σ ≤ 1 := hστ.trans hτ1
  have hσS : σ*S ≤ p^2 := (le_div_iff₀ hS).mp (min_le_right _ _)
  have hterm : 2*c^2*σ*(1+2*K^2) ≤ p^2 := by
    have hh : 2*c^2*(1+2*K^2) ≤ S := by dsimp [S]; linarith
    have hh' := mul_le_mul_of_nonneg_right hh hσ.le
    nlinarith
  have hRσ : R*σ ≤ ε^2 := by
    have hh : R ≤ S := by dsimp [S]; nlinarith [mul_nonneg (sq_nonneg c) (by positivity : 0 ≤ (1+2*K^2))]
    have hh' := mul_le_mul_of_nonneg_right hh hσ.le
    have hp2 : p^2 ≤ p := by nlinarith
    nlinarith
  obtain ⟨B,hB1,hBlarge,hscale⟩ := HybridInterpolatedScales.exists_scale k M K σ τ hσ hτ
  have hB : 0 < B := by linarith
  refine ⟨B,hB,?_⟩
  intro W instF instN instEq G instAdj hb d hd hdeg hf
  by_contra hnot
  have hdense : B*(Fintype.card W:ℝ)^(3*k+1) ≤ d^(6*k+8) := le_of_not_gt hnot
  let n : ℝ := Fintype.card W
  let D := K*d
  let E : ℝ := Nat.card (HybridThreeHubAssignments.Agreement G (cap:ℝ) k)
  have hn1 : 1 ≤ n := by dsimp [n]; exact_mod_cast Fintype.card_pos
  have hn : 0 < n := by linarith
  have hdpos : 0 < d := by linarith
  have hD1 : 1 ≤ D := by dsimp [D]; nlinarith
  have hD : 0 < D := by linarith
  have hd4 : 4*K ≤ d := by
    by_contra hh
    have hdp : d^(6*k+8) ≤ (4*K)^(6*k+8) := pow_le_pow_left₀ hdpos.le (le_of_not_ge hh) _
    have hpow : 1 ≤ n^(3*k+1) := one_le_pow₀ hn1
    have hlow : B ≤ B*n^(3*k+1) := by nlinarith
    exact (not_lt_of_ge ((hdense.trans hdp).trans' hlow)) hBlarge
  have hmax (u : W) : (G.degree u:ℝ) ≤ D := (hdeg u).2
  have hmin (u : W) : d ≤ (G.degree u:ℝ) := (hdeg u).1
  have hEpos : 0 < E := HybridScales.free_energy_pos G k M hf cap d K hcapPos hdpos hK0 hd4 hmin hmax hcut
  obtain ⟨hcoreσ,hcollσ,hdelσ⟩ := HybridInterpolatedScales.all_counts_small G k M hk hf cap d K σ τ B
    hcapPos hd hK hd4 hσ.le hτ.le hB1 hmin hmax hcut hscale hdense
  have hcore (c : HybridRoles.Core) : (Nat.card (HybridRoles.Pin k G (cap:ℝ) (.inl c)):ℝ) ≤ τ*E :=
    (hcoreσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hcoll (c : ThreeHubMixed.CoreCollision) :
      (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
        (HybridRoles.coreCollision k G (cap:ℝ) c)):ℝ) ≤ τ*E :=
    (hcollσ c).trans (mul_le_mul_of_nonneg_right hστ hEpos.le)
  have hdel (r : HybridRoles.Arm k) :
      (Nat.card (FiberRestrictionEnergy.Agreement (HybridRoles.deletionWitness k G (cap:ℝ) r).E):ℝ) ≤ τ*E :=
    hdelσ r
  have hsub : (ProjectionHeavy.subdivision (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1))).Free G := by
    intro h
    exact hf (IsContained.trans ⟨RootedSubdivision.powerCopy (MatchedThreeHub.base (k+1)) M⟩ h)
  let H := HostHeavyShadow.graph G univ t
  have hH : H.CliqueFree m := HostHeavyShadow.cliqueFree_of_subdivision_free
    (FullRootedPower.graph (MatchedThreeHub.base (k+1)) (M+1)) G univ hsub
  have hlight (u v : W) (hnon : ¬H.Adj u v) (hne : u≠v) : Fintype.card (G.commonNeighbors u v) ≤ cap := by
    have ht : (FourthMoment.common G univ u v).card < t := by
      by_contra hh
      exact hnon ⟨hne,le_of_not_gt hh⟩
    rw [HostHeavyShadow.common_univ_card] at ht
    exact ht.le.trans htc
  have hpin (a : HybridRoles.Interior k) : (Nat.card (HybridRoles.Pin k G (cap:ℝ) a):ℝ) ≤ p*E := by
    rcases a with a|r
    · exact (hcore a).trans (mul_le_mul_of_nonneg_right hτp hEpos.le)
    · apply HybridTerminalGraph.small_pin _ _ E c K σ p (Nat.cast_nonneg _) (Nat.cast_nonneg _)
        hEpos.le hσ.le hσ1 hp.le _ (hcoreσ (.inl (HybridRoles.hubIndex k r))) hterm
      exact HybridTerminalGraph.terminal_sq G k M hf H m hm hH (cap:ℝ) d K hcapPos hdpos hK0 hd4
        hmin hmax hcut (fun u v hn he => by exact_mod_cast hlight u v hn he) r
  have hjoined : (Nat.card (FiberRestrictionEnergy.Both (HybridThreeHubAssignments.Fiber G (cap:ℝ) k)
      (HybridThreeHubAssignments.SameFullRoots G (cap:ℝ) k)):ℝ) ≤ ε^2*E := by
    have h := HybridThreeHubAssignments.sameFullRoots_bound G (cap:ℝ) k M hf d K hcapPos hdpos hK0 hd4 hmin hmax hcut
    have hp : (Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) ≤ σ*E := hcoreσ (.inl 1)
    calc
      _ ≤ R*(Nat.card (HybridThreeHubAssignments.Pin G (cap:ℝ) k (HybridThreeHubAssignments.center G (cap:ℝ) k)):ℝ) := h
      _ ≤ R*(σ*E) := mul_le_mul_of_nonneg_left hp hR
      _ = (R*σ)*E := by ring
      _ ≤ ε^2*E := mul_le_mul_of_nonneg_right hRσ hEpos.le
  let g : G.Coloring Bool := hb.toColoring (by simp)
  have hfree := HybridRoles.not_free_of_pin_counts k G (cap:ℝ) M hM g g.valid
    H m cap hm hH hlight (Nat.cast_nonneg _) le_rfl
    ε p τ hε.le hpSmall' hεsq (by convert hattach using 1 <;> dsimp only [p,c] <;> ring) hroot
    (by simpa only [pack] using hsmall) hEpos hpin
    (fun c => (hcoll c).trans (mul_le_mul_of_nonneg_right (hτp.trans hpSmall') hEpos.le))
    hjoined hdel
  exact hfree (HybridThreeHub.free_of_matched G k M hf)

end Erdos571.HybridInterpolatedUpper

/-! Sharp ordinary extremal bounds for matched hybrid three-hub powers. -/
set_option maxHeartbeats 2200000
namespace Erdos571.HybridInterpolatedUpper
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeExponent (k : ℕ) : ℝ := ((3*k+1:ℕ):ℝ)/((6*k+8:ℕ):ℝ)

lemma degreeExponent_pos (k : ℕ) (hs : 1 ≤ k) : 0 < degreeExponent k := by
  unfold degreeExponent
  apply div_pos
  · exact_mod_cast (show 0<3*k+1 by omega)
  · positivity

lemma degreeExponent_le_one (k : ℕ) : degreeExponent k ≤ 1 := by
  unfold degreeExponent
  apply (div_le_one (by positivity : (0:ℝ)<(6*k+8:ℕ))).mpr
  exact_mod_cast (show 3*k+1 ≤ 6*k+8 by omega)

theorem unrestricted_regular_bound (k M : ℕ) (hk : 1 ≤ k) (hM : 2 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀ {u v}, G.Adj u v → g u ≠ g v) →
        (MatchedThreeHub.graph (k+1) M).Free G →
        ∀ (U : Finset W) (d : ℝ), 0 < d →
        (∀ v ∈ U, d ≤ ((neighbors G U v).card:ℝ) ∧
          ((neighbors G U v).card:ℝ) ≤ Q*d) →
        ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+degreeExponent k) := by
  obtain ⟨B,hB,hbound⟩ := free_degree_bound k M hk hM Q hQ
  let C : ℝ := B^((6*k+8:ℕ):ℝ)⁻¹
  have hC : 0 ≤ C := Real.rpow_nonneg hB.le _
  have hQ0 : 0 ≤ Q := by linarith
  refine ⟨Q*(1+C), by positivity, ?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have he : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [he, arcs, empty_product, filter_empty, card_empty, Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast hU.card_pos
  have hn : (0:ℝ) < U.card := by linarith
  have hpow1 : 1 ≤ (U.card:ℝ)^degreeExponent k :=
    Real.one_le_rpow hn1 (degreeExponent_pos k (by omega)).le
  have hdpow : d ≤ (1+C)*(U.card:ℝ)^degreeExponent k := by
    by_cases hd1 : d < 1
    · nlinarith
    · letI : Nonempty ↥U := hU.to_subtype
      let H := G.induce (U:Set W)
      let c : H.Coloring Bool := ⟨fun x => g x.val, fun h => hg h⟩
      have hbip : H.IsBipartite := by
        simpa only [Fintype.card_bool] using c.colorable
      have hfree : (MatchedThreeHub.graph (k+1) M).Free H :=
        fun h => hf (h.trans ⟨Copy.induce G (U:Set W)⟩)
      have h := hbound H hbip d (le_of_not_gt hd1) (fun v => by
        simpa only [H, TreeCopiesIn.induce_degree] using hdeg v.val v.property) hfree
      have hc : Fintype.card ↑(U:Set W) = U.card := by
        rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, Set.ncard_coe_finset]
      rw [hc] at h
      have hh := LongSpider.degree_of_power (6*k+8) (3*k+1) (by omega) hn.le hd.le hB.le h.le
      change d ≤ C*(U.card:ℝ)^degreeExponent k at hh
      nlinarith
  have he : ((arcs G U).card:ℝ) = ∑ v ∈ U, ((neighbors G U v).card:ℝ) := by
    exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑ _v ∈ U, Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((1+C)*(U.card:ℝ)^degreeExponent k) :=
      mul_le_mul_of_nonneg_left hdpow (by positivity)
    _ = _ := by rw [Real.rpow_add hn, Real.rpow_one]; ring

/-- The sharp exponent holds for every finite forbidden-free host. -/
theorem unrestricted_edge_bound (k M : ℕ) (hk : 1 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (G : SimpleGraph W) (_ : DecidableRel G.Adj),
        (MatchedThreeHub.graph (k+1) M).Free G →
        (Nat.card G.edgeSet:ℝ) ≤ D*(Fintype.card W:ℝ)^(1+degreeExponent k) := by
  have hγ : 0 < degreeExponent k := degreeExponent_pos k (by omega)
  have hγ1 : degreeExponent k ≤ 1 := degreeExponent_le_one k
  let K : ℝ := (16:ℝ)^((degreeExponent k)⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+degreeExponent k)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left, Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := unrestricted_regular_bound k M hk hM (8*K) (by linarith)
  refine ⟨4*D, by positivity, ?_⟩
  intro W _ G _ hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (MatchedThreeHub.graph (k+1) M).Free F :=
    fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+degreeExponent k) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card = 2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w = F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn, card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card, card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs, card_univ, Nat.cast_mul, Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb


theorem edge_bound (k M : ℕ) (hk : 1 ≤ k) (hM : 2 ≤ M) :
    ∃ D : ℝ, 0 ≤ D ∧ EdgeBound (MatchedThreeHub.graph (k+1) M) (1+degreeExponent k) D := by
  obtain ⟨D,hD,h⟩ := unrestricted_edge_bound k M hk hM
  refine ⟨D,hD,⟨?_⟩⟩
  intro W _ G hf
  classical
  exact h W inferInstance G inferInstance hf

theorem upper (k M : ℕ) (hk : 1 ≤ k) (hM : 2 ≤ M) :
    Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
      (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨D,hD,h⟩ := edge_bound k M hk hM
  exact h.extremal_isBigO _ hD

/-- A fixed matched power has the exact exponent, for every k >= 1. -/
theorem exists_theta (k : ℕ) (hk : 1 ≤ k) :
    ∃ M : ℕ, 2 ≤ M ∧ (MatchedThreeHub.graph (k+1) M).IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n (MatchedThreeHub.graph (k+1) M):ℝ))
        (fun n : ℕ => (n:ℝ)^(1+degreeExponent k)) := by
  obtain ⟨M,hM,hl⟩ := MatchedThreeHub.exists_lower (k+1) (by omega)
  refine ⟨M,hM,MatchedThreeHub.graph_bipartite _ _,upper k M hk hM,?_⟩
  have he : 2-(3*((k+1:ℕ):ℝ)+4)/(6*((k+1:ℕ):ℝ)+2)=1+degreeExponent k := by
    dsimp [degreeExponent]
    push_cast
    have hden : (6*(k:ℝ)+8)≠0 := by positivity
    field_simp
    ring
  rwa [he] at hl

end Erdos571.HybridInterpolatedUpper

/-! Exact rational exponents from the matched hybrid three-hub certificates
and their iterated paired cones. -/
set_option maxHeartbeats 3000000
namespace Erdos571.HybridInterpolatedUpper
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (k : ℕ) :
    1+degreeExponent k=2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ) := by
  dsimp [degreeExponent]
  have hden : ((6*k+8:ℕ):ℝ)≠0 := by positivity
  field_simp
  push_cast
  ring

theorem supported (k : ℕ) (hk : 1 ≤ k) :
    Supported (MatchedThreeHub.template (k+1)) (2-((3*k+7:ℕ):ℝ)/((6*k+8:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound k M hk hM
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (k : ℕ) (hk : 1 ≤ k) : Certificate (3*k+7) (6*k+8) := by
  classical
  let H := MatchedThreeHub.base (k+1)
  have hroot : 0 < Fintype.card (MatchedThreeHub.BaseRoot (k+1)) := by
    rw [MatchedThreeHub.base_roots (k+1) (by omega)]
    omega
  letI : Nonempty (MatchedThreeHub.BaseRoot (k+1)) := Fintype.card_pos_iff.mp hroot
  letI : Nonempty (RootedSubdivision.Root H) := ⟨Sum.inl (Classical.arbitrary _)⟩
  refine ⟨RootedSubdivision.Nonroot H,RootedSubdivision.Root H,
    inferInstance,inferInstance,inferInstance,inferInstance,
    MatchedThreeHub.template (k+1),RootedSubdivision.color H,
    RootedSubdivision.color_proper H,MatchedThreeHub.connected (k+1),
    MatchedThreeHub.no_isolated (k+1),?_,supported k hk⟩
  have h := MatchedThreeHub.template_balance (k+1) (by omega)
  simpa only [←Nat.card_eq_fintype_card,show 6*(k+1)+2=6*k+8 by omega,show 3*(k+1)+4=3*k+7 by omega] using h

theorem iterated_certificate (k t : ℕ) (hk : 1 ≤ k) :
    Certificate (3*k+7) (6*k+8+t*(3*k+7)) := by
  induction t with
  | zero => simpa using certificate k hk
  | succ t ih =>
    have h := ih.cone (by omega) (by nlinarith)
    have he : 6*k+8+(t+1)*(3*k+7)=6*k+8+t*(3*k+7)+(3*k+7) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

/-- A proved exact family, not a realization of every rational exponent. -/
theorem exact_family (k t : ℕ) (hk : 1 ≤ k) :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(3*k+7:ℚ)/(6*k+8+t*(3*k+7):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate k t hk).realizes (by omega) (by nlinarith)
  push_cast at h ⊢
  exact h

theorem exponent_nine_sevenths :
    ∃ q : ℕ, ∃ G : SimpleGraph (Fin q), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((9/7:ℚ):ℝ)) := by
  have h := exact_family 1 0 (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.HybridInterpolatedUpper


/-! Signed local incidence bounds from actual subdivision freeness.
The edge restriction precedes the Gram construction. No third-walk cutoff
and no global codegree cap are assumed. -/
set_option maxHeartbeats 2000000
namespace Erdos571.LocalIncidenceOperator
open Finset Matrix
variable {I J K L : Type*} [Fintype I] [Fintype J] [Fintype K] [Fintype L]

/-- An entrywise nonnegative restriction inherits a nonnegative-vector
operator bound, including for signed test vectors. -/
theorem of_nonnegative_bound (A P : Matrix I J ℝ)
    (hP : ∀ i j, 0 ≤ P i j ∧ P i j ≤ A i j) (C : ℝ)
    (hA : ∀ f : J → ℝ, (∀ j, 0 ≤ f j) →
      (∑ i, (∑ j, A i j*f j)^2) ≤ C*∑ j, (f j)^2) (f : J → ℝ) :
    (∑ i, (∑ j, P i j*f j)^2) ≤ C*∑ j, (f j)^2 := by
  have hh (i : I) : |∑ j, P i j*f j| ≤ ∑ j, A i j*|f j| := by
    apply (Finset.abs_sum_le_sum_abs _ _).trans
    apply sum_le_sum
    intro j _
    rw [abs_mul, abs_of_nonneg (hP i j).1]
    exact mul_le_mul_of_nonneg_right (hP i j).2 (abs_nonneg _)
  have hm : (∑ i, (∑ j, P i j*f j)^2) ≤ ∑ i, (∑ j, A i j*|f j|)^2 := by
    apply sum_le_sum
    intro i _
    apply sq_le_sq.mpr
    exact (hh i).trans (le_abs_self _)
  have hb := hA (fun j => |f j|) (fun j => abs_nonneg _)
  simp only [sq_abs] at hb
  exact hm.trans hb

/-- Finite Euclidean duality, stated without any row-sum hypothesis. -/
theorem transpose_bound (P : Matrix I J ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hb : ∀ g : I → ℝ, (∑ j, (∑ i, P i j*g i)^2) ≤ C*∑ i, (g i)^2)
    (f : J → ℝ) :
    (∑ i, (∑ j, P i j*f j)^2) ≤ C*∑ j, (f j)^2 := by
  let g : I → ℝ := fun i => ∑ j, P i j*f j
  have he : (∑ j, (∑ i, P i j*g i)*f j) = ∑ i, (g i)^2 := by
    simp only [sum_mul]
    rw [sum_comm]
    apply sum_congr rfl
    intro i _
    calc
      _ = (∑ j, P i j*f j)*g i := by
        rw [sum_mul]
        exact sum_congr rfl (fun j _ => by ring)
      _ = _ := by change g i*g i=(g i)^2; ring
  have h := sum_mul_sq_le_sq_mul_sq (univ : Finset J)
    (fun j => ∑ i, P i j*g i) f
  rw [he] at h
  have hh := h.trans (mul_le_mul_of_nonneg_right (hb g)
    (sum_nonneg (fun j _ => sq_nonneg (f j))))
  have hn : 0 ≤ ∑ i, (g i)^2 := sum_nonneg (fun i _ => sq_nonneg _)
  change (∑ i, (g i)^2) ≤ _
  by_cases hz : (∑ i, (g i)^2)=0
  · rw [hz]
    positivity
  · have hp : 0 < ∑ i, (g i)^2 := lt_of_le_of_ne hn (Ne.symm hz)
    nlinarith

lemma squareMass_mul_left (P : Matrix I J ℝ) (X : Matrix J K ℝ) (C : ℝ)
    (hb : ∀ f : J → ℝ, (∑ i, (∑ j, P i j*f j)^2) ≤ C*∑ j, (f j)^2) :
    GramPin.squareMass (P*X) ≤ C*GramPin.squareMass X := by
  unfold GramPin.squareMass
  simp only [Matrix.mul_apply]
  rw [sum_comm, mul_sum]
  calc
    _ ≤ ∑ k, C*∑ j, (X j k)^2 := sum_le_sum (fun k _ => hb (fun j => X j k))
    _ = _ := by rw [←mul_sum, sum_comm, mul_sum]

lemma squareMass_mul_right (P : Matrix K J ℝ) (X : Matrix I J ℝ) (C : ℝ)
    (hb : ∀ f : J → ℝ, (∑ k, (∑ j, P k j*f j)^2) ≤ C*∑ j, (f j)^2) :
    GramPin.squareMass (X*P.transpose) ≤ C*GramPin.squareMass X := by
  unfold GramPin.squareMass
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  rw [mul_sum]
  apply sum_le_sum
  intro i _
  simpa only [mul_comm] using hb (fun j => X i j)

theorem cross_conjugation (P : Matrix I J ℝ) (Q : Matrix K L ℝ)
    (X : Matrix J L ℝ) (C D : ℝ) (hD : 0 ≤ D)
    (hP : ∀ f : J → ℝ, (∑ i, (∑ j, P i j*f j)^2) ≤ C*∑ j, (f j)^2)
    (hQ : ∀ f : L → ℝ, (∑ k, (∑ l, Q k l*f l)^2) ≤ D*∑ l, (f l)^2) :
    GramPin.squareMass (P*X*Q.transpose) ≤ (C*D)*GramPin.squareMass X := by
  exact (squareMass_mul_right Q (P*X) D hQ).trans
    ((mul_le_mul_of_nonneg_left (squareMass_mul_left P X C hP) hD).trans_eq (by ring))

end Erdos571.LocalIncidenceOperator

namespace Erdos571.SubdivisionLocalOperator
open Finset Matrix SimpleGraph
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]

noncomputable def coefficient (H : SimpleGraph V) (S : Finset W) (D : ℝ) : ℝ :=
  (Fintype.card V-1:ℕ)*((Fintype.card V+Nat.card H.edgeSet:ℕ)*(S.card:ℝ)+D)

omit [Fintype W] [DecidableEq W] in
lemma coefficient_nonneg (H : SimpleGraph V) (S : Finset W) (D : ℝ) (hD : 0 ≤ D) :
    0 ≤ coefficient H S D := by unfold coefficient; positivity

/-- The transpose incidence estimate uses the full selected set, not a
third-walk-light subset of it. The weights may have either sign. -/
theorem masked_transpose_operator (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (S : Finset W) (D : ℝ) (hmax : ∀ u, (G.degree u:ℝ) ≤ D)
    (P : Matrix S W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y) (f : S → ℝ) :
    (∑ y, (∑ x, P x y*f x)^2) ≤ coefficient H S D*∑ x, (f x)^2 := by
  classical
  let A : Matrix W S ℝ := fun y x => G.adjMatrix ℝ y x.val
  let K := HostHeavyShadow.graph G univ (Fintype.card V+Nat.card H.edgeSet)
  have hK : (K.induce (S : Set W)).CliqueFree (Fintype.card V) :=
    SimpleGraph.CliqueFree.comap (SimpleGraph.Embedding.induce (G := K) (S : Set W))
      (HostHeavyShadow.cliqueFree_of_subdivision_free H G univ hf)
  have hgram (x z : S) : (A.transpose*A) x z =
      (G.adjMatrix ℝ * G.adjMatrix ℝ) x.val z.val := by
    simp only [A, Matrix.mul_apply, Matrix.transpose_apply]
    exact sum_congr rfl (fun y _ => by rw [G.isSymm_adjMatrix.apply x.val y])
  apply LocalIncidenceOperator.of_nonnegative_bound A P.transpose
    (by intro y x; simpa only [A, Matrix.transpose_apply, G.isSymm_adjMatrix.apply x.val y] using hP x y)
    (coefficient H S D) ?_ f
  intro g hg
  have h := HeavyCliqueMoments.quadratic_bound A
    (fun y x => LocalThirdOperator.adjacency_nonneg G y x.val)
    (K.induce (S : Set W)) (Fintype.card V) hV hK
    (Fintype.card V+Nat.card H.edgeSet) D (by positivity)
    (by intro x; rw [hgram,G.adjMatrix_mul_self_apply_self]; exact hmax x.val)
    (by
      intro x z hxz hn
      rw [hgram]
      simpa only [Nat.cast_add] using HostHeavyShadow.light_square_bound G _ x.val z.val
        (fun he => hxz (Subtype.ext he)) hn) g hg
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset S)) (f := g)
  simp only [card_univ, Fintype.card_coe] at hc
  apply h.trans
  unfold coefficient
  rw [mul_assoc]
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  have hh := mul_le_mul_of_nonneg_left hc (Nat.cast_nonneg (Fintype.card V+Nat.card H.edgeSet))
  push_cast at hh ⊢
  nlinarith

/-- The direct incidence estimate follows by finite Euclidean duality. -/
theorem masked_operator (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (S : Finset W) (D : ℝ) (hD : 0 ≤ D) (hmax : ∀ u, (G.degree u:ℝ) ≤ D)
    (P : Matrix S W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y) (f : W → ℝ) :
    (∑ x, (∑ y, P x y*f y)^2) ≤ coefficient H S D*∑ y, (f y)^2 :=
  LocalIncidenceOperator.transpose_bound P _ (coefficient_nonneg H S D hD)
    (masked_transpose_operator H hV G hf S D hmax P hP) f

/-- Two independently masked local incidence operators may be used on
opposite sides of an arbitrary matrix. -/
theorem masked_cross_conjugation (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (S T : Finset W) (D : ℝ) (hD : 0 ≤ D) (hmax : ∀ u, (G.degree u:ℝ) ≤ D)
    (P : Matrix S W ℝ) (Q : Matrix T W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y)
    (hQ : ∀ x y, 0 ≤ Q x y ∧ Q x y ≤ G.adjMatrix ℝ x.val y)
    (X : Matrix W W ℝ) :
    GramPin.squareMass (P*X*Q.transpose) ≤
      (coefficient H S D*coefficient H T D)*GramPin.squareMass X :=
  LocalIncidenceOperator.cross_conjugation P Q X _ _ (coefficient_nonneg H T D hD)
    (masked_operator H hV G hf S D hD hmax P hP)
    (masked_operator H hV G hf T D hD hmax Q hQ)


noncomputable def localConstant (H : SimpleGraph V) : ℝ :=
  (Fintype.card V-1:ℕ)*((Fintype.card V+Nat.card H.edgeSet:ℕ)+1)

lemma localConstant_nonneg (H : SimpleGraph V) : 0 ≤ localConstant H := by
  unfold localConstant
  positivity

omit [Fintype W] [DecidableEq W] in
lemma coefficient_le (H : SimpleGraph V) (S : Finset W) (D : ℝ)
    (hS : (S.card:ℝ) ≤ D) : coefficient H S D ≤ localConstant H*D := by
  unfold coefficient localConstant
  have h := mul_le_mul_of_nonneg_left hS
    (Nat.cast_nonneg (Fintype.card V+Nat.card H.edgeSet))
  have hh := mul_le_mul_of_nonneg_left h (Nat.cast_nonneg (Fintype.card V-1))
  nlinarith

/-- On a whole neighborhood the squared operator norm is O(D), even when
some third-walk row sums are much larger than D. -/
theorem neighborhood_operator (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (u : W) (S : Finset W) (hS : S ⊆ G.neighborFinset u)
    (D : ℝ) (hD : 0 ≤ D) (hmax : ∀ x, (G.degree x:ℝ) ≤ D)
    (P : Matrix S W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y) (f : W → ℝ) :
    (∑ x, (∑ y, P x y*f y)^2) ≤ localConstant H*D*∑ y, (f y)^2 := by
  have hc : (S.card:ℝ) ≤ D := by
    have h := card_le_card hS
    rw [card_neighborFinset_eq_degree] at h
    exact (show (S.card:ℝ) ≤ G.degree u by exact_mod_cast h).trans (hmax u)
  exact (masked_operator H hV G hf S D hD hmax P hP f).trans
    (mul_le_mul_of_nonneg_right (coefficient_le H S D hc)
      (sum_nonneg (fun y _ => sq_nonneg _)))

/-- The same O(D) constant applies to the transpose on the whole neighborhood. -/
theorem neighborhood_transpose_operator (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (u : W) (S : Finset W) (hS : S ⊆ G.neighborFinset u)
    (D : ℝ) (hmax : ∀ x, (G.degree x:ℝ) ≤ D)
    (P : Matrix S W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y) (f : S → ℝ) :
    (∑ y, (∑ x, P x y*f x)^2) ≤ localConstant H*D*∑ x, (f x)^2 := by
  have hc : (S.card:ℝ) ≤ D := by
    have h := card_le_card hS
    rw [card_neighborFinset_eq_degree] at h
    exact (show (S.card:ℝ) ≤ G.degree u by exact_mod_cast h).trans (hmax u)
  exact (masked_transpose_operator H hV G hf S D hmax P hP f).trans
    (mul_le_mul_of_nonneg_right (coefficient_le H S D hc)
      (sum_nonneg (fun y _ => sq_nonneg _)))

/-- Only a principal compression is bounded here. This is not a global
signed-vector bound by a rank-one matrix plus a constant identity. -/
theorem normalized_principal_form (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (u : W) (S : Finset W) (hS : S ⊆ G.neighborFinset u)
    (d K : ℝ) (hd : 0 < d) (hmax : ∀ x, (G.degree x:ℝ) ≤ K*d) (f : S → ℝ) :
    (∑ x, ∑ z, SubdivisionNormalizedKernel.kernel G d x.val z.val*f x*f z) ≤
      localConstant H*K*∑ x, (f x)^2 := by
  let P : Matrix S W ℝ := fun x y => G.adjMatrix ℝ x.val y
  have hp : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y :=
    fun x y => ⟨LocalThirdOperator.adjacency_nonneg G _ _, le_rfl⟩
  have hh := neighborhood_transpose_operator H hV G hf u S hS (K*d) hmax P hp f
  have he : (∑ x, ∑ z, SubdivisionNormalizedKernel.kernel G d x.val z.val*f x*f z) =
      (1/d)*(∑ y, (∑ x, P x y*f x)^2) := by
    have hi : (∑ x, ∑ z, (P*P.transpose) x z*f x*f z) =
        ∑ y, (∑ x, P x y*f x)^2 := by
      simpa only [Matrix.transpose_transpose, Matrix.transpose_apply] using
        SubdivisionNormalizedKernel.gram_quadratic_identity P.transpose f
    rw [←hi]
    simp only [SubdivisionNormalizedKernel.kernel, Matrix.smul_apply, smul_eq_mul,
      mul_sum]
    apply sum_congr rfl
    intro x _
    apply sum_congr rfl
    intro z _
    have hg : (P*P.transpose) x z = (G.adjMatrix ℝ * G.adjMatrix ℝ) x.val z.val := by
      simp only [Matrix.mul_apply,Matrix.transpose_apply,P]
      exact sum_congr rfl (fun y _ => by rw [G.isSymm_adjMatrix.apply z.val y])
    rw [hg]
    ring
  rw [he]
  exact (mul_le_mul_of_nonneg_left hh (by positivity : 0 ≤ (1/d:ℝ))).trans_eq
    (by field_simp)

/-- Independent edge restrictions on two entire neighborhoods have a
uniform two-sided Frobenius bound. -/
theorem neighborhood_cross_conjugation (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (u v : W) (S T : Finset W) (hS : S ⊆ G.neighborFinset u) (hT : T ⊆ G.neighborFinset v)
    (D : ℝ) (hD : 0 ≤ D) (hmax : ∀ x, (G.degree x:ℝ) ≤ D)
    (P : Matrix S W ℝ) (Q : Matrix T W ℝ)
    (hP : ∀ x y, 0 ≤ P x y ∧ P x y ≤ G.adjMatrix ℝ x.val y)
    (hQ : ∀ x y, 0 ≤ Q x y ∧ Q x y ≤ G.adjMatrix ℝ x.val y)
    (X : Matrix W W ℝ) :
    GramPin.squareMass (P*X*Q.transpose) ≤ (localConstant H*D)^2*GramPin.squareMass X := by
  simpa only [pow_two] using LocalIncidenceOperator.cross_conjugation P Q X _ _
    (mul_nonneg (localConstant_nonneg H) hD)
    (neighborhood_operator H hV G hf u S hS D hD hmax P hP)
    (neighborhood_operator H hV G hf v T hT D hD hmax Q hQ)

end Erdos571.SubdivisionLocalOperator


/-! A signed fourth-norm consequence of the already proved fourth-walk
row bound. This does not assert sharp pin absorption. -/
set_option maxHeartbeats 2000000
namespace Erdos571.SubdivisionLocalOperator
open Finset Matrix SimpleGraph
variable {V W : Type} [Fintype V] [Fintype W] [DecidableEq W]

/-- Any edge restriction, imposed before the Gram construction, inherits
the fourth-walk frame bound supplied by subdivision freeness. -/
lemma masked_row_square (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hmax : ∀ x, (G.degree x:ℝ) ≤ D)
    (B : Matrix W W ℝ)
    (hB : ∀ x y, 0 ≤ B x y ∧ B x y ≤ G.adjMatrix ℝ x y) (x : W) :
    (∑ y, ((B*B.transpose) x y)^2) ≤ localConstant H*D^2 := by
  have hentry (x y : W) : 0 ≤ (B*B.transpose) x y ∧
      (B*B.transpose) x y ≤ (G.adjMatrix ℝ * G.adjMatrix ℝ) x y := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    constructor
    · exact sum_nonneg (fun z _ => mul_nonneg (hB x z).1 (hB y z).1)
    · apply sum_le_sum
      intro z _
      rw [G.isSymm_adjMatrix.apply y z]
      exact mul_le_mul (hB x z).2 (hB y z).2 (hB y z).1
        (LocalThirdOperator.adjacency_nonneg G _ _)
  apply (sum_le_sum (fun y _ => pow_le_pow_left₀ (hentry x y).1 (hentry x y).2 2)).trans
  simpa only [localConstant, Nat.cast_add, Nat.cast_one] using
    HostHeavyShadow.subdivision_free_row_bound H hV G hf D hD hmax x

/-- The adjacency operator (or any nonnegative edge restriction) maps
signed L2 vectors to L4 with fourth-power norm at most c_H D^2. -/
theorem masked_fourth_norm (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph W) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (D : ℝ) (hD : 0 ≤ D) (hmax : ∀ x, (G.degree x:ℝ) ≤ D)
    (B : Matrix W W ℝ)
    (hB : ∀ x y, 0 ≤ B x y ∧ B x y ≤ G.adjMatrix ℝ x y) (f : W → ℝ) :
    (∑ x, (∑ y, B x y*f y)^4) ≤ localConstant H*D^2*(∑ y, (f y)^2)^2 := by
  let K : Matrix W W ℝ := fun y z => f y*f z
  have hd (x : W) : (B*K*B.transpose) x x = (∑ y, B x y*f y)^2 := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply, K, sum_mul, pow_two, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro y _
    exact sum_congr rfl (fun z _ => by ring)
  have hk : GramPin.squareMass K = (∑ y, (f y)^2)^2 := by
    simp only [GramPin.squareMass, K, mul_pow, ←mul_sum, ←sum_mul]
    ring
  have h := GramPin.diagonal_conjugation_bound B K (localConstant H*D^2)
    (mul_nonneg (localConstant_nonneg H) (sq_nonneg D))
    (masked_row_square H hV G hf D hD hmax B hB)
  simp_rw [hd, ←pow_mul] at h
  simpa only [show 2*2=4 from rfl, hk] using h

end Erdos571.SubdivisionLocalOperator


/-! Integer Schur powers retain a quadratic estimate from a clique-free
shadow. These are auxiliary inequalities, not a rational-exponent upper bound. -/
set_option maxHeartbeats 3000000
namespace Erdos571.NonnegativeGramShadowPowers
open Finset Matrix SimpleGraph NonnegativeGramMoments GramFeatures GramPin
variable {U : Type} [Fintype U]

/-- The shadow bound applies to every explicit nonnegative Gram kernel. -/
theorem quadratic (P : Matrix U U ℝ) (hP : IsNonnegGram P)
    (H : SimpleGraph U) (k : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L)
    (hdiag : ∀ u, P u u ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬H.Adj u v → P u v ≤ L)
    (f : U → ℝ) (hf : ∀ u, 0 ≤ f u) :
    (∑ u, ∑ v, P u v*f u*f v) ≤
      (k-1:ℕ)*(L*(∑ u, f u)^2+D*∑ u, (f u)^2) := by
  obtain ⟨J,hJ,F,hF,rfl⟩ := hP
  letI := hJ
  have h := HeavyCliqueMoments.quadratic_bound F.transpose
    (fun j u => hF u j) H k hk hH L D hL
    (by simpa only [Matrix.transpose_transpose] using hdiag)
    (by simpa only [Matrix.transpose_transpose] using hlight) f hf
  have he := SubdivisionNormalizedKernel.gram_quadratic_identity F.transpose f
  simp only [Matrix.transpose_transpose,Matrix.transpose_apply] at he h
  exact he.trans_le h

/-- Both the light threshold and the diagonal threshold are raised to the
same integer power. The clique factor is not raised to that power. -/
theorem power_quadratic (P : Matrix U U ℝ) (hP : IsNonnegGram P)
    (H : SimpleGraph U) (k : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L)
    (hdiag : ∀ u, P u u ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬H.Adj u v → P u v ≤ L)
    (m : ℕ) (f : U → ℝ) (hf : ∀ u, 0 ≤ f u) :
    (∑ u, ∑ v, (P u v)^m*f u*f v) ≤
      (k-1:ℕ)*(L^m*(∑ u, f u)^2+D^m*∑ u, (f u)^2) := by
  exact quadratic (entryPower P m) (hP.power m) H k hk hH
    (L^m) (D^m) (pow_nonneg hL m)
    (fun u => pow_le_pow_left₀ (hP.nonneg u u) (hdiag u) m)
    (fun u v huv huvH => pow_le_pow_left₀ (hP.nonneg u v) (hlight u v huv huvH) m)
    f hf

/-- A signed Euclidean estimate follows by taking absolute values. The
rank-one term is the square of the L1 norm, not `(sum f)^2`. -/
theorem power_signed (P : Matrix U U ℝ) (hP : IsNonnegGram P)
    (H : SimpleGraph U) (k : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L)
    (hdiag : ∀ u, P u u ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬H.Adj u v → P u v ≤ L)
    (m : ℕ) (f : U → ℝ) :
    |∑ u, ∑ v, (P u v)^m*f u*f v| ≤
      (k-1:ℕ)*(L^m*(∑ u, |f u|)^2+D^m*∑ u, (f u)^2) := by
  have hp := power_quadratic P hP H k hk hH L D hL hdiag hlight m
    (fun u => |f u|) (fun u => abs_nonneg (f u))
  simp only [sq_abs] at hp
  apply le_trans _ hp
  calc
    _ ≤ ∑ u, |∑ v, (P u v)^m*f u*f v| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ u, ∑ v, |(P u v)^m*f u*f v| := by
      exact sum_le_sum (fun u _ => abs_sum_le_sum_abs _ _)
    _ = _ := by
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      rw [abs_mul,abs_mul,abs_of_nonneg (pow_nonneg (hP.nonneg u v) m)]

/-- A global operator bound, with the ambient cardinality kept explicitly. -/
theorem power_operator (P : Matrix U U ℝ) (hP : IsNonnegGram P)
    (H : SimpleGraph U) (k : ℕ) (hk : 2 ≤ k) (hH : H.CliqueFree k)
    (L D : ℝ) (hL : 0 ≤ L)
    (hdiag : ∀ u, P u u ≤ D)
    (hlight : ∀ u v, u ≠ v → ¬H.Adj u v → P u v ≤ L)
    (m : ℕ) (f : U → ℝ) :
    |∑ u, ∑ v, (P u v)^m*f u*f v| ≤
      (k-1:ℕ)*(L^m*(Fintype.card U:ℝ)+D^m)*(∑ u, (f u)^2) := by
  have h := power_signed P hP H k hk hH L D hL hdiag hlight m f
  have hc := sq_sum_le_card_mul_sum_sq (s := (univ : Finset U)) (f := fun u => |f u|)
  simp only [card_univ,sq_abs] at hc
  apply h.trans
  calc
    _ ≤ (k-1:ℕ)*(L^m*((Fintype.card U:ℝ)*∑ u, (f u)^2)+D^m*∑ u, (f u)^2) := by
      gcongr
    _ = _ := by ring

variable [DecidableEq U]
variable {V : Type} [Fintype V]

/-- Actual subdivision freeness supplies the shadow for every integer
entrywise power of the unnormalized two-walk matrix. -/
theorem subdivision_free_power (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph U) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (D : ℝ) (hmax : ∀ u, (G.degree u:ℝ) ≤ D)
    (m : ℕ) (f : U → ℝ) :
    |∑ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^m*f u*f v| ≤
      (Fintype.card V-1:ℕ)*
        ((((Fintype.card V+Nat.card H.edgeSet:ℕ):ℝ)^m)*(Fintype.card U:ℝ)+D^m)*
          (∑ u, (f u)^2) := by
  let A := G.adjMatrix ℝ
  have hA (u v : U) : 0 ≤ A u v := by
    dsimp [A,SimpleGraph.adjMatrix]
    split_ifs <;> norm_num
  have hgram : IsNonnegGram (A*A) := by
    simpa only [A,SimpleGraph.transpose_adjMatrix] using IsNonnegGram.self A hA
  have h := power_operator (A*A) hgram
    (HostHeavyShadow.graph G univ (Fintype.card V+Nat.card H.edgeSet))
    (Fintype.card V) hV (HostHeavyShadow.cliqueFree_of_subdivision_free H G univ hf)
    (Fintype.card V+Nat.card H.edgeSet) D (by positivity)
    (fun u => (G.adjMatrix_mul_self_apply_self u).le.trans (hmax u))
    (by
      intro u v huv hn
      simpa only [Nat.cast_add] using
        HostHeavyShadow.light_square_bound G (Fintype.card V+Nat.card H.edgeSet) u v huv hn)
    m f
  simpa only [A,Nat.cast_add] using h


/-- Dimensionless form for a genuine subdivision-free host. No signed
Loewner comparison with a rank-one matrix is asserted. -/
theorem normalized_power_operator (H : SimpleGraph V) (hV : 2 ≤ Fintype.card V)
    (G : SimpleGraph U) [DecidableRel G.Adj]
    (hf : (ProjectionHeavy.subdivision H).Free G)
    (d K : ℝ) (hd : 0 < d) (hmax : ∀ u, (G.degree u:ℝ) ≤ K*d)
    (m : ℕ) (f : U → ℝ) :
    |∑ u, ∑ v, (SubdivisionNormalizedKernel.kernel G d u v)^m*f u*f v| ≤
      (Fintype.card V-1:ℕ)*
        (((((Fintype.card V+Nat.card H.edgeSet:ℕ):ℝ)/d)^m)*(Fintype.card U:ℝ)+K^m)*
          (∑ u, (f u)^2) := by
  have h := subdivision_free_power H hV G hf (K*d) hmax m f
  have he : (∑ u, ∑ v, (SubdivisionNormalizedKernel.kernel G d u v)^m*f u*f v) =
      (1/d^m)*(∑ u, ∑ v, ((G.adjMatrix ℝ * G.adjMatrix ℝ) u v)^m*f u*f v) := by
    simp only [SubdivisionNormalizedKernel.kernel,Matrix.smul_apply,smul_eq_mul,
      mul_pow,_root_.one_div_pow,mul_assoc,←mul_sum]
  rw [he,abs_mul,abs_of_nonneg (by positivity : 0 ≤ (1/d^m : ℝ))]
  apply (mul_le_mul_of_nonneg_left h (by positivity : 0 ≤ (1/d^m : ℝ))).trans_eq
  simp only [div_pow,mul_pow]
  field_simp


end Erdos571.NonnegativeGramShadowPowers


/-! Connected free components with all their boundary vertices as roots.
This supplies a finite resolving collection, but no rich-copy counting bound. -/
set_option maxHeartbeats 2000000
namespace Erdos571.BoundaryComponentPruning
open Finset SimpleGraph RootedPruningClosure
variable {V : Type} [Fintype V] [DecidableEq V]

noncomputable def boundary (H : SimpleGraph V) (S : Finset V) : Finset V :=
  by
    classical
    exact Sᶜ.filter (fun v => ∃ u ∈ S, H.Adj u v)

lemma mem_boundary (H : SimpleGraph V) (S : Finset V) (v : V) :
    v ∈ boundary H S ↔ v ∉ S ∧ ∃ u ∈ S, H.Adj u v := by
  classical
  simp [boundary]

abbrev Interior (S : Finset V) := {v : V // v ∈ S}
abbrev Root (H : SimpleGraph V) (S : Finset V) := {v : V // v ∈ boundary H S}

def vertexMap (H : SimpleGraph V) (S : Finset V) : Interior S ⊕ Root H S → V :=
  Sum.elim Subtype.val Subtype.val

lemma vertexMap_injective (H : SimpleGraph V) (S : Finset V) :
    Function.Injective (vertexMap H S) := by
  rintro (u | u) (v | v) he
  all_goals change (u:V) = (v:V) at he
  · exact congrArg Sum.inl (Subtype.ext he)
  · exact ((mem_boundary H S v).mp v.property).1 (he ▸ u.property) |>.elim
  · exact ((mem_boundary H S u).mp u.property).1 (he.symm ▸ v.property) |>.elim
  · exact congrArg Sum.inr (Subtype.ext he)

noncomputable def graph (H : SimpleGraph V) (S : Finset V) :
    SimpleGraph (Interior S ⊕ Root H S) := H.comap (vertexMap H S)

def copy (H : SimpleGraph V) (S : Finset V) : (graph H S).Copy H :=
  ⟨⟨vertexMap H S, fun h => h⟩, vertexMap_injective H S⟩

/-- Every edge leaving the selected interior is retained; no boundary anchor
is silently omitted. -/
lemma neighbor_retained (H : SimpleGraph V) (S : Finset V)
    (u : Interior S) (v : V) (huv : H.Adj u v) :
    ∃ w : Interior S ⊕ Root H S, vertexMap H S w = v ∧ (graph H S).Adj (.inl u) w := by
  classical
  by_cases hv : v ∈ S
  · exact ⟨.inl ⟨v,hv⟩,rfl,huv⟩
  · exact ⟨.inr ⟨v,(mem_boundary H S v).mpr ⟨hv,u,u.property,huv⟩⟩,rfl,huv⟩

lemma connected (H : SimpleGraph V) (S : Finset V)
    (hS : (H.induce (S : Set V)).Connected) : (graph H S).Connected := by
  obtain ⟨u⟩ := hS.nonempty
  let f : H.induce (S : Set V) →g graph H S := ⟨Sum.inl,fun h => h⟩
  apply (graph H S).connected_iff_exists_forall_reachable.mpr
  refine ⟨.inl u,?_⟩
  rintro (v | v)
  · exact (hS.preconnected u v).map f
  · obtain ⟨w,hw,hwv⟩ := ((mem_boundary H S v).mp v.property).2
    exact ((hS.preconnected u ⟨w,hw⟩).map f).trans
      (show (graph H S).Adj (.inl ⟨w,hw⟩) (.inr v) from hwv).reachable

lemma acyclic (H : SimpleGraph V) (S : Finset V) (hH : H.IsAcyclic) :
    (graph H S).IsAcyclic :=
  hH.comap (copy H S).toHom (copy H S).injective

lemma isTree (H : SimpleGraph V) (S : Finset V) (hH : H.IsAcyclic)
    (hS : (H.induce (S : Set V)).Connected) : (graph H S).IsTree :=
  ⟨connected H S hS, acyclic H S hH⟩

/-- A boundary vertex of a connected subtree has exactly one neighbor in
that subtree. -/
lemma unique_boundary_attachment (H : SimpleGraph V) (S : Finset V)
    (hH : H.IsAcyclic) (hS : (H.induce (S : Set V)).Connected) (r : Root H S) :
    ∃! u : Interior S, H.Adj r u := by
  obtain ⟨hr,u,hu,hur⟩ := (mem_boundary H S r).mp r.property
  refine ⟨⟨u,hu⟩,hur.symm,?_⟩
  intro v hv
  exact Subtype.ext (ConnectedSafeGrowth.unique_attachment H hH S hS r u hr hu hur.symm v v.property hv)

lemma boundary_independent (H : SimpleGraph V) (S : Finset V)
    (hH : H.IsAcyclic) (hS : (H.induce (S : Set V)).Connected)
    (r t : Root H S) : ¬H.Adj r t := by
  intro hrt
  obtain ⟨hr,u,hu,hur⟩ := (mem_boundary H S r).mp r.property
  obtain ⟨ht,v,hv,hvt⟩ := (mem_boundary H S t).mp t.property
  have hc := ConnectedSafeGrowth.connected_insert H S hS r u hu hur.symm
  have ht' : (t:V) ∉ insert (r:V) S := by
    simp only [mem_insert,not_or]
    exact ⟨hrt.ne',ht⟩
  have he := ConnectedSafeGrowth.unique_attachment H hH (insert (r:V) S) hc t r ht'
    (mem_insert_self _ _) hrt.symm v (mem_insert_of_mem hv) hvt.symm
  exact hr (he ▸ hv)

/-- A maximal connected subset of a nonempty allowed set has all of its
external neighbors outside that set. -/
theorem exists_closed_connected (H : SimpleGraph V) (F : Finset V) (hF : F.Nonempty) :
    ∃ S : Finset V, S ⊆ F ∧ S.Nonempty ∧
      (H.induce (S : Set V)).Connected ∧ ∀ v ∈ boundary H S, v ∉ F := by
  classical
  let P : Finset (Finset V) := F.powerset.filter (fun S : Finset V => (H.induce (S : Set V)).Connected)
  obtain ⟨x,hx⟩ := hF
  have hP : P.Nonempty := by
    refine ⟨{x},mem_filter.mpr ⟨mem_powerset.mpr (singleton_subset_iff.mpr hx),?_⟩⟩
    change (H.induce (({x} : Finset V) : Set V)).Connected
    letI : Nonempty ((({x}:Finset V):Set V)) := ⟨⟨x,mem_singleton_self x⟩⟩
    letI : Subsingleton ((({x}:Finset V):Set V)) := ⟨fun a b => Subtype.ext
      ((mem_singleton.mp a.property).trans (mem_singleton.mp b.property).symm)⟩
    exact SimpleGraph.Connected.of_subsingleton
  obtain ⟨S,hSP,hmax⟩ := exists_max_image P Finset.card hP
  have hSF := mem_powerset.mp (mem_filter.mp hSP).1
  have hS := (mem_filter.mp hSP).2
  have hSne : S.Nonempty := by
    obtain ⟨u⟩ := hS.nonempty
    exact ⟨u,u.property⟩
  refine ⟨S,hSF,hSne,hS,?_⟩
  intro v hv hvF
  obtain ⟨hvS,u,hu,huv⟩ := (mem_boundary H S v).mp hv
  have hin : insert v S ∈ P := by
    refine mem_filter.mpr ⟨mem_powerset.mpr (insert_subset hvF hSF),?_⟩
    exact ConnectedSafeGrowth.connected_insert H S hS v u hu huv.symm
  have hh := hmax (insert v S) hin
  rw [card_insert_of_notMem hvS] at hh
  omega

variable {A R : Type} [Fintype A] [Fintype R] [DecidableEq A] [DecidableEq R]

/-- All nonempty connected interior subsets form a finite list of possible
boundary-rooted pruning rules. -/
abbrev Rule (H : SimpleGraph (A ⊕ R)) :=
  {S : Finset (A ⊕ R) // S.Nonempty ∧
    (H.induce (S : Set (A ⊕ R))).Connected ∧ ∀ v ∈ S, ∃ a : A, v = .inl a}

/-- Unlike immediate-child pruning, this collection resolves every proper
extra pin set. The boundary may contain several previously pinned roles. -/
theorem resolves_every_core (H : SimpleGraph (A ⊕ R)) (C : Finset A) (hC : C ≠ univ) :
    ∃ S : Rule H, Resolves (copy H S.val) C := by
  classical
  let F := univ.filter (fun v : A ⊕ R => ¬Fixed C v)
  have hF : F.Nonempty := by
    have he : ∃ a : A, a ∉ C := by
      by_contra! hh
      exact hC (eq_univ_of_forall hh)
    obtain ⟨a,ha⟩ := he
    exact ⟨.inl a,mem_filter.mpr ⟨mem_univ _,ha⟩⟩
  obtain ⟨S,hSF,hSne,hS,hbd⟩ := exists_closed_connected H F hF
  have hfree (v) (hv : v ∈ S) : ¬Fixed C v := (mem_filter.mp (hSF hv)).2
  have hnon (v) (hv : v ∈ S) : ∃ a : A, v = .inl a := by
    cases v with
    | inl a => exact ⟨a,rfl⟩
    | inr r => exact (hfree _ hv trivial).elim
  refine ⟨⟨S,hSne,hS,hnon⟩,?_,?_⟩
  · intro u
    exact hfree u u.property
  · intro r
    by_contra hn
    exact hbd r r.property (mem_filter.mpr ⟨mem_univ _,hn⟩)

variable {W : Type} [Fintype W] [DecidableEq W]

omit [Fintype W] [DecidableEq W] in
/-- A root-fiber bound with an explicit unresolved input: every boundary
component packing has been excluded on the SAME family of copies. -/
theorem fiber_bound (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W)
    (p : ℕ) (hp : 2 ≤ p) (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hpoor : ∀ f ∈ F, ∀ S : Rule H, ¬PackedAt (graph H S.val) G
      (fun s => f (copy H S.val (.inr s))) p) :
    F.card ≤ RootedSunflower.bound (Fintype.card A) p := by
  classical
  exact RootedPruningClosure.fiber_bound
    (fun S : Rule H => Interior S.val) (fun S => Root H S.val)
    (fun S => graph H S.val) (fun S => copy H S.val)
    (fun C hC => resolves_every_core H C hC) G p hp F r hroot hpoor

end Erdos571.BoundaryComponentPruning


/-! Replacing an interior by a packing at its entire prescribed boundary.
No existence of such a packing is inferred from the number of copies. -/
set_option maxHeartbeats 2000000
namespace Erdos571.BoundaryComponentPruning
open Finset SimpleGraph RootedPruningClosure
variable {V W : Type} [Fintype V] [DecidableEq V]

noncomputable def replace (H : SimpleGraph V) (G : SimpleGraph W) (S : Finset V)
    (f : H.Copy G) (g : (graph H S).Copy G)
    (hroot : ∀ r : Root H S, g (.inr r) = f r)
    (havoid : ∀ u : Interior S, ∀ v ∉ S, g (.inl u) ≠ f v) : H.Copy G := by
  classical
  let e : V → W := fun v => if h : v ∈ S then g (.inl ⟨v,h⟩) else f v
  have hin (v : V) (hv : v ∈ S) : e v = g (.inl ⟨v,hv⟩) := dif_pos hv
  have hout (v : V) (hv : v ∉ S) : e v = f v := dif_neg hv
  refine ⟨⟨e,?_⟩,?_⟩
  · intro u v huv
    by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
    · rw [hin u hu,hin v hv]
      exact g.toHom.map_adj huv
    · let r : Root H S := ⟨v,(mem_boundary H S v).mpr ⟨hv,u,hu,huv⟩⟩
      rw [hin u hu,hout v hv,←hroot r]
      exact g.toHom.map_adj huv
    · let r : Root H S := ⟨u,(mem_boundary H S u).mpr ⟨hu,v,hv,huv.symm⟩⟩
      rw [hout u hu,hin v hv,←hroot r]
      exact g.toHom.map_adj huv
    · rw [hout u hu,hout v hv]
      exact f.toHom.map_adj huv
  · intro u v he
    change e u = e v at he
    by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
    · rw [hin u hu,hin v hv] at he
      exact congrArg Subtype.val (Sum.inl.inj (g.injective he))
    · rw [hin u hu,hout v hv] at he
      exact (havoid ⟨u,hu⟩ v hv he).elim
    · rw [hout u hu,hin v hv] at he
      exact (havoid ⟨v,hv⟩ u hu he.symm).elim
    · rw [hout u hu,hout v hv] at he
      exact f.injective he

lemma replace_in (H : SimpleGraph V) (G : SimpleGraph W) (S : Finset V)
    (f : H.Copy G) (g : (graph H S).Copy G) (hroot) (havoid)
    (u : Interior S) : replace H G S f g hroot havoid u = g (.inl u) := by
  classical
  change (if h : (u:V) ∈ S then g (.inl ⟨u,h⟩) else f u) = _
  rw [dif_pos u.property]

lemma replace_out (H : SimpleGraph V) (G : SimpleGraph W) (S : Finset V)
    (f : H.Copy G) (g : (graph H S).Copy G) (hroot) (havoid)
    (v : V) (hv : v ∉ S) : replace H G S f g hroot havoid v = f v := by
  classical
  change (if h : v ∈ S then g (.inl ⟨v,h⟩) else f v) = _
  rw [dif_neg hv]

variable [DecidableEq W]

/-- Boundary-packings allow simultaneous replacements against a common
blacklist. All boundary equalities refer to the original copies. -/
theorem replace_family {I : Type} [Fintype I]
    (H : SimpleGraph V) (G : SimpleGraph W) (S : Finset V) (hS : S.Nonempty)
    (f : I → H.Copy G) (p : ℕ) (Z : Finset W)
    (hpack : ∀ i, PackedAt (graph H S) G (fun r : Root H S => f i r) p)
    (hp : Z.card + (Fintype.card V + S.card) * Fintype.card I < p) :
    ∃ f' : I → H.Copy G,
      (∀ i v, v ∉ S → f' i v = f i v) ∧
      (∀ i, Disjoint (S.image (f' i)) Z) ∧
      (∀ i j, Disjoint (S.image (f' i)) (univ.image (f j))) ∧
      Pairwise (fun i j => Disjoint (S.image (f' i)) (S.image (f' j))) := by
  classical
  letI : Nonempty (Interior S) := ⟨⟨hS.choose,hS.choose_spec⟩⟩
  let B := Z ∪ univ.biUnion (fun i : I => univ.image (f i))
  have hB : B.card ≤ Z.card + Fintype.card V * Fintype.card I := by
    have hc : (univ.biUnion (fun i : I => univ.image (f i))).card ≤
        Fintype.card V * Fintype.card I := by
      apply card_biUnion_le.trans
      calc
        _ ≤ ∑ _i : I, Fintype.card V := by
          exact sum_le_sum (fun i _ => (card_image_le (s := univ) (f := f i)).trans_eq (card_univ))
        _ = _ := by simp [Nat.mul_comm]
    exact (card_union_le Z _).trans (Nat.add_le_add_left hc _)
  have hlarge : B.card + Fintype.card (Interior S) * Fintype.card I < p := by
    rw [Fintype.card_coe]
    nlinarith
  obtain ⟨g,hr,hgB,hgg⟩ := choose_packed (fun i => fun r : Root H S => f i r) p B hpack hlarge
  have himage (i : I) (v : V) : f i v ∈ B :=
    mem_union_right _ (mem_biUnion.mpr ⟨i,mem_univ _,mem_image.mpr ⟨v,mem_univ _,rfl⟩⟩)
  have havoid (i : I) (u : Interior S) (v : V) : g i (.inl u) ≠ f i v := by
    intro he
    exact Finset.disjoint_left.mp (hgB i) (RootedPacking.mem_interior (g i) u)
      (he.symm ▸ himage i v)
  let f' : I → H.Copy G := fun i => replace H G S (f i) (g i) (hr i)
    (fun u v _ => havoid i u v)
  have heq (i : I) : S.image (f' i) = RootedPacking.interior (g i) := by
    ext w
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and]
    constructor
    · rintro ⟨v,hv,rfl⟩
      refine ⟨⟨v,hv⟩,?_⟩
      exact (replace_in H G S (f i) (g i) _ _ ⟨v,hv⟩).symm
    · rintro ⟨u,rfl⟩
      exact ⟨u,u.property,replace_in H G S (f i) (g i) _ _ u⟩
  refine ⟨f',?_,?_,?_,?_⟩
  · intro i v hv
    exact replace_out H G S (f i) (g i) _ _ v hv
  · intro i
    rw [heq]
    exact (hgB i).mono_right (subset_union_left)
  · intro i j
    rw [heq]
    exact (hgB i).mono_right (by
      intro w hw
      exact mem_union_right _ (mem_biUnion.mpr ⟨j,mem_univ _,hw⟩))
  · intro i j hij
    rw [heq,heq]
    exact hgg hij

variable {A R : Type} [Fintype A] [Fintype R] [DecidableEq A] [DecidableEq R]

/-- If the complementary interiors have already been packed, genuine
boundary packings complete them to a full rooted power. This does not assert
that a dense family supplies the complementary packing. -/
theorem power_of_complement_packing
    (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W) (S : Finset (A ⊕ R))
    (hS : S.Nonempty) (hnon : ∀ v ∈ S, ∃ a : A, v = .inl a)
    (M p : ℕ) (hM : 0 < M) (f : Fin M → H.Copy G) (r : R ↪ W)
    (hroot : ∀ i s, f i (.inr s) = r s)
    (hdis : ∀ i j, i ≠ j → ∀ a b : A, .inl a ∉ S → .inl b ∉ S →
      f i (.inl a) ≠ f j (.inl b))
    (hpack : ∀ i, PackedAt (graph H S) G (fun r : Root H S => f i r) p)
    (hp : (Fintype.card (A ⊕ R) + S.card) * M < p) :
    FullRootedPower.graph H M ⊑ G := by
  classical
  obtain ⟨f',hout,hZ,hcross,hinside⟩ := replace_family H G S hS f p ∅ hpack (by simpa using hp)
  have hroots (i : Fin M) (s : R) : f' i (.inr s) = r s := by
    rw [hout i (.inr s) (by
      intro hs
      obtain ⟨a,ha⟩ := hnon _ hs
      cases ha),hroot]
  apply Nonempty.intro
  apply FullRootedPacking.powerCopy M hM r f' hroots
  intro i j hij
  apply Finset.disjoint_left.mpr
  intro w hwi hwj
  simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hwi hwj
  obtain ⟨a,rfl⟩ := hwi
  obtain ⟨b,he⟩ := hwj
  by_cases hia : Sum.inl a ∈ S <;> by_cases hjb : Sum.inl b ∈ S
  · exact Finset.disjoint_left.mp (hinside hij)
      (mem_image.mpr ⟨.inl a,hia,rfl⟩) (mem_image.mpr ⟨.inl b,hjb,he⟩)
  · rw [hout j (.inl b) hjb] at he
    exact Finset.disjoint_left.mp (hcross i j)
      (mem_image.mpr ⟨.inl a,hia,rfl⟩) (mem_image.mpr ⟨.inl b,mem_univ _,he⟩)
  · rw [hout i (.inl a) hia] at he
    exact Finset.disjoint_left.mp (hcross j i)
      (mem_image.mpr ⟨.inl b,hjb,rfl⟩) (mem_image.mpr ⟨.inl a,mem_univ _,he.symm⟩)
  · rw [hout i (.inl a) hia,hout j (.inl b) hjb] at he
    exact hdis i j hij a b hia hjb he.symm

end Erdos571.BoundaryComponentPruning


/-! Actual rooted-power freeness localizes collisions outside any component
whose entire prescribed boundary has a large genuine packing. -/
set_option maxHeartbeats 2000000
namespace Erdos571.BoundaryComponentPruning
open Finset SimpleGraph RootedPruningClosure
variable {A R W : Type} [Fintype A] [Fintype R]
  [DecidableEq A] [DecidableEq R] [DecidableEq W]

noncomputable def remaining (S : Finset (A ⊕ R)) : Finset A :=
  univ.filter (fun a => Sum.inl a ∉ S)

omit [Fintype R] in
lemma mem_remaining (S : Finset (A ⊕ R)) (a : A) :
    a ∈ remaining S ↔ Sum.inl a ∉ S := by
  simp [remaining]

/-- This exclusion is a consequence of actual target freeness, not an
additional assumption about all fibers of a smaller rooted graph. -/
theorem no_complement_packing
    (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W) (S : Finset (A ⊕ R))
    (hS : S.Nonempty) (hnon : ∀ v ∈ S, ∃ a : A, v = .inl a)
    (M p : ℕ) (hM : 0 < M) (hf : (FullRootedPower.graph H M).Free G)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hpack : ∀ f ∈ F, PackedAt (graph H S) G (fun r : Root H S => f r) p)
    (hp : (Fintype.card (A ⊕ R) + S.card) * M < p) :
    ¬∃ T ⊆ F, T.card = M ∧ ∀ f ∈ T, ∀ g ∈ T, f ≠ g →
      Disjoint (interiorOn f (remaining S)) (interiorOn g (remaining S)) := by
  classical
  rintro ⟨T,hTF,hTM,hd⟩
  let e : Fin M ≃ T := Fintype.equivOfCardEq (by simp only [Fintype.card_fin,Fintype.card_coe,hTM])
  apply hf
  apply power_of_complement_packing H G S hS hnon M p hM (fun i => (e i).val) r
    (fun i s => hroot (e i) (hTF (e i).property) s) _
    (fun i => hpack (e i) (hTF (e i).property)) hp
  intro i j hij a b ha hb he
  have hne : (e i).val ≠ (e j).val := fun he => hij (e.injective (Subtype.ext he))
  have hdis := hd (e i) (e i).property (e j) (e j).property hne
  have hi := mem_interiorOn (e i).val (remaining S) ((mem_remaining S a).mpr ha)
  have hj := mem_interiorOn (e j).val (remaining S) ((mem_remaining S b).mpr hb)
  exact Finset.disjoint_left.mp hdis hi (he.symm ▸ hj)

open Classical in
/-- Nonnegative weights, and hence an arbitrary retained subfamily, are
allowed. Only the remaining interior roles appear on the right-hand side. -/
theorem rich_weighted_collision
    (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W) (S : Finset (A ⊕ R))
    (hS : S.Nonempty) (hrem : (remaining S).Nonempty)
    (hnon : ∀ v ∈ S, ∃ a : A, v = .inl a)
    (M p : ℕ) (hM : 2 ≤ M) (hf : (FullRootedPower.graph H M).Free G)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀ f ∈ F, ∀ s, f (.inr s) = r s)
    (hpack : ∀ f ∈ F, PackedAt (graph H S) G (fun r : Root H S => f r) p)
    (hp : (Fintype.card (A ⊕ R) + S.card) * M < p)
    (w : H.Copy G → ℝ) (hw : ∀ f ∈ F, 0 ≤ w f) :
    (∑ f ∈ F, w f)^2 ≤ (M-1:ℕ) *
      ∑ e ∈ PackingEnergy.pairs F (fun f g =>
        ¬Disjoint (interiorOn f (remaining S)) (interiorOn g (remaining S))),
        w e.1 * w e.2 := by
  have hne (f : H.Copy G) : (interiorOn f (remaining S)).Nonempty := hrem.image _
  apply PackingEnergy.weighted_bound F
    (fun f g => ¬Disjoint (interiorOn f (remaining S)) (interiorOn g (remaining S)))
    (fun f _ h => (hne f).ne_empty (disjoint_self.mp h))
    (fun _ _ _ _ h => fun he => h he.symm) M hM _ w hw
  rintro ⟨T,hTF,hTM,hT⟩
  apply no_complement_packing H G S hS hnon M p (by omega) hf F r hroot hpack hp
  refine ⟨T,hTF,hTM,?_⟩
  intro f hft g hgt hfg
  exact not_not.mp (hT f hft g hgt hfg)

end Erdos571.BoundaryComponentPruning

/-! Greedy partitions of a tuple box into vertex-disjoint classes. -/
namespace Erdos571.DisjointTupleColoring
open Finset

lemma finite_coloring {B : Type} [Fintype B] [DecidableEq B]
    (R : B → B → Prop) [DecidableRel R] (hR : Symmetric R) (L : ℕ)
    (hL : ∀b, (univ.filter (R b)).card ≤ L) :
    ∃c : B → Fin (L+1), ∀a b, a ≠ b → R a b → c a ≠ c b := by
  classical
  have hs (S : Finset B) : ∃c : B → Fin (L+1),
      ∀a∈S, ∀b∈S, a ≠ b → R a b → c a ≠ c b := by
    induction S using Finset.induction_on with
    | empty => exact ⟨fun _ => 0, by simp⟩
    | @insert a S ha ih =>
      obtain ⟨c,hc⟩ := ih
      let Z := (S.filter (R a)).image c
      have hZ : Z.card ≤ L := card_image_le.trans
        ((card_le_card (filter_subset_filter _ (subset_univ _))).trans (hL a))
      have hn : ¬(univ : Finset (Fin (L+1))) ⊆ Z := by
        intro h
        have := card_le_card h
        simp only [card_univ,Fintype.card_fin] at this
        omega
      obtain ⟨i,hi,hiZ⟩ := not_subset.mp hn
      refine ⟨Function.update c a i, ?_⟩
      intro x hx y hy hxy hRxy
      rcases mem_insert.mp hx with hxa | hx
      · subst x
        have hya : y ≠ a := Ne.symm hxy
        have hyS := (mem_insert.mp hy).resolve_left hya
        rw [Function.update_self,Function.update_of_ne hya]
        intro he
        exact hiZ (he ▸ mem_image.mpr ⟨y,mem_filter.mpr ⟨hyS,hRxy⟩,rfl⟩)
      · have hxa : x ≠ a := fun he => ha (he ▸ hx)
        rcases mem_insert.mp hy with hya | hy
        · subst y
          rw [Function.update_of_ne hxa,Function.update_self]
          intro he
          exact hiZ (he ▸ mem_image.mpr ⟨x,mem_filter.mpr ⟨hx,hR hRxy⟩,rfl⟩)
        · have hya : y ≠ a := fun he => ha (he ▸ hy)
          rw [Function.update_of_ne hxa,Function.update_of_ne hya]
          exact hc x hx y hy hxy hRxy
  obtain ⟨c,hc⟩ := hs univ
  exact ⟨c,fun a b => hc a (mem_univ _) b (mem_univ _)⟩

variable {I W : Type} [Fintype I] [DecidableEq I] [DecidableEq W]

lemma overlap_load (X : I → Finset W) (D : ℕ) (hD : ∀i, (X i).card ≤ D)
    (f : I → W) :
    ((Fintype.piFinset X).filter (fun g =>
      ¬Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g))).card ≤
      (Fintype.card I)^2*D^(Fintype.card I-1) := by
  classical
  apply (TupleBoxPacking.cover_bound X D hD _ (filter_subset _ _) (TupleBoxPacking.foot f) ?_).trans
  · have h := Nat.mul_le_mul_right (Fintype.card I*D^(Fintype.card I-1))
      (TupleBoxPacking.foot_card f)
    nlinarith
  · intro g hg
    obtain ⟨w,hwf,hwg⟩ := not_disjoint_iff.mp (mem_filter.mp hg).2
    exact ⟨w,hwg,hwf⟩

lemma box_coloring (X : I → Finset W) (D : ℕ) (hD : ∀i, (X i).card ≤ D) :
    ∃c : (Fintype.piFinset X) → Fin ((Fintype.card I)^2*D^(Fintype.card I-1)+1),
      ∀f g, f ≠ g → c f = c g →
        Disjoint (TupleBoxPacking.foot f.val) (TupleBoxPacking.foot g.val) := by
  classical
  let B := Fintype.piFinset X
  let R : B → B → Prop := fun f g => ¬Disjoint (TupleBoxPacking.foot f.val) (TupleBoxPacking.foot g.val)
  have hR : Symmetric R := fun _ _ h hd => h hd.symm
  have hL (f : B) : (univ.filter (R f)).card ≤
      (Fintype.card I)^2*D^(Fintype.card I-1) := by
    apply le_trans _ (overlap_load X D hD f.val)
    apply card_le_card_of_injOn (fun g => g.val)
    · intro g hg
      exact mem_filter.mpr ⟨g.property,(mem_filter.mp hg).2⟩
    · intro g hg g' hg' he
      exact Subtype.ext he
  obtain ⟨c,hc⟩ := finite_coloring R hR _ hL
  exact ⟨c,fun f g hfg he => not_not.mp (fun hn => hc f g hfg hn he)⟩

end Erdos571.DisjointTupleColoring

/-! An additive form of the rectangular KST bound, with explicit multiplicity dependence. -/
namespace Erdos571.RectangularKstMoment
open Finset
variable {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]

lemma additive_bound (P : A → B → Prop) [DecidableRel P] (p M : ℕ) (hp : 1 ≤ p)
    (hT : ∀f : Fin p ↪ A, (common P p f).card ≤ M) :
    ((univ.filter (fun e : A×B => P e.1 e.2)).card:ℝ) ≤
      2*((M:ℝ)*(Fintype.card B:ℝ)^(p-1))^((p:ℝ)⁻¹)*Fintype.card A +
      2*p*Fintype.card B := by
  classical
  let x : ℝ := 2*((M:ℝ)*(Fintype.card B:ℝ)^(p-1))^((p:ℝ)⁻¹)*Fintype.card A
  let y : ℝ := 2*p*Fintype.card B
  have hx : 0 ≤ x := by dsimp [x]; positivity
  have hy : 0 ≤ y := by dsimp [y]; positivity
  have hpn : p ≠ 0 := by omega
  have he : x^p+y^p = (Fintype.card B:ℝ)^(p-1)*
      ((2:ℝ)^p*M*(Fintype.card A:ℝ)^p+(2*p)^p*Fintype.card B) := by
    dsimp [x,y]
    rw [mul_pow,mul_pow,Real.rpow_inv_natCast_pow (by positivity) hpn,mul_pow]
    have hpow : (Fintype.card B:ℝ)^p=(Fintype.card B:ℝ)^(p-1)*Fintype.card B := by
      rw [←pow_succ]; congr 1; omega
    rw [hpow]
    ring
  have hm := edge_moment P p M hp hT
  rw [←he] at hm
  exact (pow_le_pow_iff_left₀ (Nat.cast_nonneg _) (add_nonneg hx hy) hpn).mp
    (hm.trans (pow_add_pow_le hx hy hpn))

end Erdos571.RectangularKstMoment

/-! Reverse KST summed over disjoint tuple classes. -/
namespace Erdos571.ColoredReverseKst
open Finset
variable {A B C : Type} [Fintype A] [Fintype B] [Fintype C]
  [DecidableEq A] [DecidableEq B] [DecidableEq C]

lemma bound (P : A → B → Prop) [DecidableRel P] (c : B → C)
    (p M : ℕ) (hp : 1 ≤ p)
    (hT : ∀k, ∀f : Fin p ↪ {b : B // c b=k},
      (univ.filter (fun a => ∀i, P a (f i).val)).card ≤ M) :
    ((univ.filter (fun e : A×B => P e.1 e.2)).card:ℝ) ≤
      2*((M:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*Fintype.card B +
      2*p*Fintype.card A*Fintype.card C := by
  classical
  let E := univ.filter (fun e : A×B => P e.1 e.2)
  let Eₖ (k : C) := E.filter (fun e => c e.2=k)
  have hEₖ (k : C) : (Eₖ k).card =
      (univ.filter (fun e : {b : B // c b=k}×A => P e.2 e.1.val)).card := by
    symm
    apply card_bij (fun e _ => (e.2,e.1.val))
    · intro e he
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_univ _,(mem_filter.mp he).2⟩,e.1.property⟩
    · intro e he e' he' heq
      exact Prod.ext (Subtype.ext (Prod.mk.inj heq).2) (Prod.mk.inj heq).1
    · intro e he
      obtain ⟨he,hc⟩ := mem_filter.mp he
      refine ⟨(⟨e.2,hc⟩,e.1),mem_filter.mpr ⟨mem_univ _,(mem_filter.mp he).2⟩,?_⟩
      exact Prod.eta e
  have hsum : (∑k, ((Eₖ k).card:ℝ))=(E.card:ℝ) := by
    have h := sum_card_fiberwise_eq_card_filter E (univ : Finset C) (fun e => c e.2)
    simp only [mem_univ,filter_true] at h
    exact_mod_cast h
  have hBsum : (∑k : C, (Fintype.card {b : B // c b=k}:ℝ))=Fintype.card B := by
    simp only [Fintype.card_subtype]
    have h := sum_card_fiberwise_eq_card_filter (univ : Finset B) (univ : Finset C) c
    simp only [mem_univ,filter_true,card_univ] at h
    exact_mod_cast h
  have h (k : C) : ((Eₖ k).card:ℝ) ≤
      2*((M:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*Fintype.card {b : B // c b=k} +
      2*p*Fintype.card A := by
    rw [hEₖ]
    exact RectangularKstMoment.additive_bound (fun (b : {b : B // c b=k}) a => P a b.val)
      p M hp (hT k)
  calc
    _ = ∑k, ((Eₖ k).card:ℝ) := hsum.symm
    _ ≤ ∑k : C, (2*((M:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*
        Fintype.card {b : B // c b=k} + 2*p*Fintype.card A) := sum_le_sum (fun k _ => h k)
    _ = _ := by rw [sum_add_distrib,←mul_sum,hBsum]; simp [mul_comm]

end Erdos571.ColoredReverseKst

/-! Reversing tuple-box KST: the power saving depends on the fixed number
of disjoint tuples rather than on the power multiplicity. -/
namespace Erdos571.TupleBoxKstReverse
open Finset
variable {A I W : Type} [Fintype A] [Fintype I] [DecidableEq A]
  [DecidableEq I] [DecidableEq W]

lemma dimension_bound (X : I → Finset W) (P : A → (I → W) → Prop) [DecidableRel P]
    (p M D : ℕ) (hp : 1 ≤ p) (hX : ∀i, (X i).card ≤ D)
    (hno : ∀a : Fin M ↪ A, ¬∃S⊆Fintype.piFinset X, S.card=p ∧
      (∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g)) ∧
      ∀f∈S, ∀i, P (a i) f) :
    (((univ×ˢFintype.piFinset X).filter (fun e => P e.1 e.2)).card:ℝ) ≤
      2*((M:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*(Fintype.piFinset X).card +
      2*p*Fintype.card A*((Fintype.card I:ℝ)^2*(D:ℝ)^(Fintype.card I-1)+1) := by
  classical
  let B := Fintype.piFinset X
  obtain ⟨c,hc⟩ := DisjointTupleColoring.box_coloring X D hX
  let Q : A → B → Prop := fun a b => P a b.val
  have hT (k) (f : Fin p ↪ {b : B // c b=k}) :
      (univ.filter (fun a => ∀i, Q a (f i).val)).card ≤ M := by
    by_contra hn
    let T := univ.filter (fun a => ∀i, Q a (f i).val)
    obtain ⟨a⟩ := Function.Embedding.nonempty_of_card_le
      (show Fintype.card (Fin M) ≤ Fintype.card T by
        simp only [Fintype.card_fin,Fintype.card_coe]; dsimp [T]; omega)
    let a' : Fin M ↪ A := a.trans (Function.Embedding.subtype _)
    let ff : Fin p → (I → W) := fun i => (f i).val.val
    have hff : Function.Injective ff := by
      intro i j he
      exact f.injective (Subtype.ext (Subtype.ext he))
    let S := univ.image ff
    have hS : S.card=p := by rw [card_image_of_injective _ hff,card_univ,Fintype.card_fin]
    apply hno a'
    refine ⟨S,?_,hS,?_,?_⟩
    · intro g hg
      obtain ⟨i,hi,rfl⟩ := mem_image.mp hg
      exact (f i).val.property
    · intro g hg g' hg' hgg'
      obtain ⟨i,hi,rfl⟩ := mem_image.mp hg
      obtain ⟨j,hj,rfl⟩ := mem_image.mp hg'
      exact hc (f i).val (f j).val (fun he => hgg' (congrArg Subtype.val he))
        ((f i).property.trans (f j).property.symm)
    · intro g hg i
      obtain ⟨j,hj,rfl⟩ := mem_image.mp hg
      exact (mem_filter.mp (a i).property).2 j
  have hb := ColoredReverseKst.bound Q c p M hp hT
  have he : (univ.filter (fun e : A×B => Q e.1 e.2)).card =
      ((univ×ˢB).filter (fun e => P e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1,e.2.val))
    · intro e he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,e.2.property⟩,(mem_filter.mp he).2⟩
    · intro e he f hf hef
      exact Prod.ext (Prod.mk.inj hef).1 (Subtype.ext (Prod.mk.inj hef).2)
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(e.1,⟨e.2,(mem_product.mp he).2⟩),mem_filter.mpr ⟨mem_univ _,hP⟩,rfl⟩
  simpa only [he,Fintype.card_coe,Fintype.card_fin,Nat.cast_add,Nat.cast_mul,
    Nat.cast_pow,Nat.cast_one] using hb

lemma bound [Nonempty I] (X : I → Finset W) (P : A → (I → W) → Prop) [DecidableRel P]
    (p M : ℕ) (hp : 1 ≤ p) {D : ℝ} (hD : 1 ≤ D)
    (hA : (Fintype.card A:ℝ) ≤ D) (hX : ∀i, ((X i).card:ℝ) ≤ D)
    (hno : ∀a : Fin M ↪ A, ¬∃S⊆Fintype.piFinset X, S.card=p ∧
      (∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g)) ∧
      ∀f∈S, ∀i, P (a i) f) :
    (((univ×ˢFintype.piFinset X).filter (fun e => P e.1 e.2)).card:ℝ) ≤
      2*(M:ℝ)^((p:ℝ)⁻¹)*D^((Fintype.card I:ℝ)+1-1/(p:ℝ)) +
      2*p*((Fintype.card I:ℝ)^2+1)*D^(Fintype.card I) := by
  classical
  let q := Fintype.card I
  have hq : 1 ≤ q := Fintype.card_pos
  have hD0 : 0 ≤ D := by linarith
  have hDp : 0 < D := by linarith
  have hXn : ∀i, (X i).card ≤ ⌊D⌋₊ := fun i => Nat.le_floor (hX i)
  have hB : ((Fintype.piFinset X).card:ℝ) ≤ D^q := by
    exact (show ((Fintype.piFinset X).card:ℝ) ≤ (⌊D⌋₊:ℝ)^q by
      exact_mod_cast TupleBoxPacking.box_card X ⌊D⌋₊ hXn).trans
      (pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le hD0) q)
  have hroot : ((M:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹) ≤
      ((M:ℝ)*D^(p-1))^((p:ℝ)⁻¹) := by
    apply Real.rpow_le_rpow (by positivity) _ (by positivity)
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg _) hA _) (Nat.cast_nonneg _)
  have hmain : 2*((M:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*(Fintype.piFinset X).card ≤
      2*(M:ℝ)^((p:ℝ)⁻¹)*D^((q:ℝ)+1-1/(p:ℝ)) := by
    calc
      _ ≤ 2*((M:ℝ)*D^(p-1))^((p:ℝ)⁻¹)*D^q := by gcongr
      _ = _ := by
        rw [Real.mul_rpow (Nat.cast_nonneg _) (pow_nonneg hD0 _),
          ←Real.rpow_natCast_mul hD0,←Real.rpow_natCast D q]
        simp only [mul_assoc]
        rw [←Real.rpow_add hDp]
        congr 3
        rw [Nat.cast_sub hp,Nat.cast_one]
        have hp0 : (p:ℝ) ≠ 0 := by exact_mod_cast (show p ≠ 0 by omega)
        field_simp
        ring
  have hcol : (q:ℝ)^2*(⌊D⌋₊:ℝ)^(q-1)+1 ≤ ((q:ℝ)^2+1)*D^(q-1) := by
    have hpow := pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le hD0) (q-1)
    have h1 : (1:ℝ) ≤ D^(q-1) := one_le_pow₀ hD
    nlinarith [sq_nonneg (q:ℝ)]
  have herr : 2*p*Fintype.card A*((q:ℝ)^2*(⌊D⌋₊:ℝ)^(q-1)+1) ≤
      2*p*((q:ℝ)^2+1)*D^q := by
    calc
      _ ≤ 2*p*D*(((q:ℝ)^2+1)*D^(q-1)) := by gcongr
      _ = _ := by
        have he : D*D^(q-1)=D^q := by rw [←pow_succ']; congr 1; omega
        calc
          _ = 2*p*((q:ℝ)^2+1)*(D*D^(q-1)) := by ring
          _ = _ := by rw [he]
  exact (dimension_bound X P p M ⌊D⌋₊ hp hXn hno).trans (add_le_add hmain herr)

end Erdos571.TupleBoxKstReverse

/-! Rich fan boxes with polynomial, rather than exponential, multiplicity thresholds. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def reverseBoxBound (p q M : ℕ) (D : ℝ) : ℝ :=
  2*(M:ℝ)^((p:ℝ)⁻¹)*D^((q:ℝ)+1-1/(p:ℝ)) + 2*p*((q:ℝ)^2+1)*D^q

lemma reverseBoxBound_nonneg (p q M : ℕ) {D : ℝ} (hD : 0≤D) :
    0≤reverseBoxBound p q M D := by unfold reverseBoxBound; positivity

lemma reverse_box_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (z : W) (v : Fin q → W) {D : ℝ} (hD : 1≤D)
    (hz : ((neighbors G U z).card:ℝ)≤D) (hv : ∀j, ((neighbors G U (v j)).card:ℝ)≤D) :
    letI : DecidableRel (boxRel G U t p q M z) := fun _ _ => Classical.propDecidable _
    (((neighbors G U z×ˢFintype.piFinset (fun j => neighbors G U (v j))).filter
      (fun e => boxRel G U t p q M z e.1 e.2)).card:ℝ)≤
      reverseBoxBound p q M D := by
  classical
  letI : Nonempty (Fin q) := ⟨⟨0,by omega⟩⟩
  let A := neighbors G U z
  let X : Fin q → Finset W := fun j => neighbors G U (v j)
  let P : A → (Fin q → W) → Prop := fun a r => boxRel G U t p q M z a.val r
  have hb := TupleBoxKstReverse.bound X P p M hp hD (by simpa only [Fintype.card_coe] using hz) hv
    (box_no_packing G U t p q M ht hM hf z X)
  have he : ((univ×ˢFintype.piFinset X).filter (fun e : A×(Fin q → W) => P e.1 e.2)).card=
      ((A×ˢFintype.piFinset X).filter (fun e => boxRel G U t p q M z e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1.val,e.2))
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨e.1.property,(mem_product.mp he).2⟩,hP⟩
    · intro e he f hf hef
      exact Prod.ext (Subtype.ext (Prod.mk.inj hef).1) (Prod.mk.inj hef).2
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(⟨e.1,(mem_product.mp he).1⟩,e.2),
        mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,(mem_product.mp he).2⟩,hP⟩,rfl⟩
  simpa only [he,Fintype.card_fin,reverseBoxBound] using hb


end Erdos571.FanSpider

/-! Carrying the reversed tuple-box bound into rich fan-branch counting. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma reverse_richBranches_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((richBranches G U t p q M).card:ℝ)≤
      U.card*D^q*reverseBoxBound p q M D := by
  classical
  let F := richBranches G U t p q M
  let pre : (ShortSpider.template q).Copy G → W×(Fin q → W) :=
    fun f => (f (.inl none),fun j => f (.inl (some j)))
  have hm (f) (hf : f∈F) : ∀v, f v∈U :=
    (TreeCopiesIn.mem_copies _ _ _ _).mp (mem_filter.mp hf).1
  have hmap (f) (hf : f∈F) : pre f∈branchCores G U q := by
    refine mem_biUnion.mpr ⟨f (.inl none),hm f hf _,mem_image.mpr ⟨(fun j => f (.inl (some j))),?_,rfl⟩⟩
    exact Fintype.mem_piFinset.mpr (fun j => mem_filter.mpr ⟨hm f hf _,f.toHom.map_adj trivial⟩)
  have hcount := RealFiberCount.bound F (branchCores G U q) pre hmap
    (D := reverseBoxBound p q M D) (by
      intro v hv
      obtain ⟨z,hz,hv⟩ := mem_biUnion.mp hv
      obtain ⟨v',hv',he⟩ := mem_image.mp hv
      subst v
      let B := ((neighbors G U z)×ˢFintype.piFinset (fun j => neighbors G U (v' j))).filter
        (fun e => boxRel G U t p q M z e.1 e.2)
      have hc : (F.filter (fun f => pre f=(z,v'))).card≤B.card := by
        apply card_le_card_of_injOn (fun f => (f (.inr none),fun j => f (.inr (some j))))
        · intro f hf'
          obtain ⟨hf',he⟩ := mem_filter.mp hf'
          have hez : f (.inl none)=z := congrArg Prod.fst he
          have hev : (fun j => f (.inl (some j)))=v' := congrArg Prod.snd he
          refine mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hm f hf' _,?_⟩,?_⟩,
            (mem_filter.mp hf').2,?_⟩
          · rw [←hez]
            exact f.toHom.map_adj rfl
          · apply Fintype.mem_piFinset.mpr
            intro j
            refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←congrFun hev j]
            exact f.toHom.map_adj rfl
          · intro j
            rw [←hez]
            exact f.injective.ne Sum.inr_ne_inl
        · intro f hf' f' hf'' he
          have hp := (mem_filter.mp hf').2.trans (mem_filter.mp hf'').2.symm
          have hz : f (.inl none)=f' (.inl none) := congrArg Prod.fst hp
          have hv : (fun j => f (.inl (some j)))=(fun j => f' (.inl (some j))) := congrArg Prod.snd hp
          have hr := Prod.mk.inj he
          apply Copy.ext
          rintro (a|r)
          · cases a with
            | none => exact hz
            | some j => exact congrFun hv j
          · cases r with
            | none => exact hr.1
            | some j => exact congrFun hr.2 j
      exact (show _≤(B.card:ℝ) by exact_mod_cast hc).trans
        (reverse_box_bound G U t p q M ht hp hq hM hf z v' hD (hdeg z hz)
          (fun j => hdeg _ (mem_filter.mp (Fintype.mem_piFinset.mp hv' j)).1)))
  have hh := mul_le_mul_of_nonneg_right (branchCores_bound G U q (by linarith) hdeg)
    (reverseBoxBound_nonneg p q M (D := D) (by linarith))
  exact hcount.trans (hh.trans_eq (by ring))


end Erdos571.FanSpider

/-! Fan copy counting with a reversed-KST rich-subtree error. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma reverse_rich_subtree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (b : Branch p q) (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))) :
    (F.card:ℝ)≤U.card*D^(p+2*p*q-q)*reverseBoxBound p q M D := by
  classical
  have hb := ConnectedCopyBound.copy_restriction_bound (template p q) (connected p q) (ShortSpider.template q)
    (subCopy b) G U (by linarith) hdeg F (richBranches G U t p q M) hm (by
      intro f hf
      exact mem_filter.mpr ⟨(TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hm f hf _),hr f hf⟩)
  rw [card_vertex p q] at hb
  simp only [Fintype.card_sum,Fintype.card_option,Fintype.card_fin] at hb
  have he : p+2*p*q+2-(q+1+(q+1))=p+2*p*q-2*q := by omega
  rw [he] at hb
  have hh := mul_le_mul_of_nonneg_right (reverse_richBranches_bound G U t p q M ht hp hq hM hf hD hdeg)
    (show 0≤D^(p+2*p*q-2*q) by positivity)
  have hpq : q≤p*q := by simpa using Nat.mul_le_mul_right q hp
  have hmul : D^q*D^(p+2*p*q-2*q)=D^(p+2*p*q-q) := by
    rw [←pow_add]
    congr 1
    simp only [Nat.mul_assoc]
    omega
  exact hb.trans (hh.trans_eq (by
    calc
      _ = U.card*(D^q*D^(p+2*p*q-2*q))*reverseBoxBound p q M D := by ring
      _ = _ := by rw [hmul]))

theorem reverse_all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ)≤(M*(p+p*q+1)*copyLoad t p q M:ℕ)*(U.card:ℝ)^(p*q+1)+
      ((p+2*p*q+2:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q-1)+
      (p+p*q:ℕ)*U.card*D^(p+2*p*q-q)*reverseBoxBound p q M D := by
  classical
  let A := F.filter (GoodCopy G U t p q M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light (template p q) G U t f)
  let C (b : Branch p q) := F.filter (fun f => Rich G U t p q M
    (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j)))))
  have hs : F⊆A∪B∪univ.biUnion C := by
    intro f hf
    by_cases hl : ConnectedCopyBound.Light (template p q) G U t f
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩))
    by_cases hb : ∀b : Branch p q, ¬Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hm f hf,hl,hb⟩))
    · simp only [not_forall,not_not] at hb
      obtain ⟨b,hb⟩ := hb
      exact mem_union_right _ (mem_biUnion.mpr ⟨b,mem_univ _,mem_filter.mpr ⟨hf,hb⟩⟩)
  have hA := good_count G U t p q M hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card:ℝ)≤((p+2*p*q+2:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q-1) := by
    have h := ConnectedCopyBound.nonlight_bound (template p q) (connected p q) G U t (by linarith) hdeg B
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    simpa only [card_vertex p q,show p+2*p*q+2-3=p+2*p*q-1 by omega,mul_assoc] using h
  have hC : ((univ.biUnion C).card:ℝ)≤
      (p+p*q:ℕ)*U.card*D^(p+2*p*q-q)*reverseBoxBound p q M D := by
    have hc : ((univ.biUnion C).card:ℝ)≤∑b : Branch p q, ((C b).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun b hb => reverse_rich_subtree_count G U t p q M ht hp hq hM hf hD hdeg b (C b)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul] at hh
    exact hc.trans (hh.trans_eq (by ring))
  have hc := (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hc' : (F.card:ℝ)≤A.card+B.card+(univ.biUnion C).card := by exact_mod_cast hc
  linarith

end Erdos571.FanSpider

/-! Explicit scaling of the reverse-KST fan error. -/
namespace Erdos571.FanSpider
open Filter Asymptotics

noncomputable def reverse_countError (p q M K : ℕ) (D : ℝ) : ℝ :=
  ((p+2*p*q+2:ℕ):ℝ)^3*(2/(K:ℝ)*D^2+(2*(p:ℝ)*q+7)*D)*D^(p+2*p*q-1)+
    (p+p*q:ℕ)*D^(p+2*p*q-q)*reverseBoxBound p q M D

noncomputable def reverse_linearCoeff (p q : ℕ) : ℝ :=
  ((p+2*p*q+2:ℕ):ℝ)^3*(2*(p:ℝ)*q+7)+2*p*(p+p*q:ℕ)*((q:ℝ)^2+1)

lemma reverse_linearCoeff_nonneg (p q : ℕ) : 0≤reverse_linearCoeff p q := by
  unfold reverse_linearCoeff; positivity

lemma reverse_countError_eq (p q M K : ℕ) (hp : 1≤p) {D : ℝ} (hD : 0<D) :
    reverse_countError p q M K D =
      (2*((p+2*p*q+2:ℕ):ℝ)^3/(K:ℝ))*D^(p+2*p*q+1)+
      reverse_linearCoeff p q*D^(p+2*p*q)+
      2*(p+p*q:ℕ)*(M:ℝ)^((p:ℝ)⁻¹)*D^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ)) := by
  have hn : q≤p+2*p*q := by nlinarith
  have hmain : D^2*D^(p+2*p*q-1)=D^(p+2*p*q+1) := by rw [←pow_add]; congr 1; omega
  have hlin : D*D^(p+2*p*q-1)=D^(p+2*p*q) := by rw [←pow_succ']; congr 1; omega
  have hboxlin : D^(p+2*p*q-q)*D^q=D^(p+2*p*q) := by rw [←pow_add]; congr 1; omega
  have hrich : D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(p:ℝ))=
      D^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ)) := by
    rw [←Real.rpow_natCast D (p+2*p*q-q),←Real.rpow_add hD]
    congr 1
    rw [Nat.cast_sub hn]
    push_cast
    ring
  calc
    _ = (2*((p+2*p*q+2:ℕ):ℝ)^3/(K:ℝ))*(D^2*D^(p+2*p*q-1))+
        (((p+2*p*q+2:ℕ):ℝ)^3*(2*(p:ℝ)*q+7))*(D*D^(p+2*p*q-1))+
        (2*p*(p+p*q:ℕ)*((q:ℝ)^2+1))*(D^(p+2*p*q-q)*D^q)+
        (2*(p+p*q:ℕ)*(M:ℝ)^((p:ℝ)⁻¹))*(D^(p+2*p*q-q)*D^((q:ℝ)+1-1/(p:ℝ))) := by
      unfold reverse_countError reverseBoxBound
      ring
    _ = _ := by rw [hmain,hlin,hboxlin,hrich]; unfold reverse_linearCoeff; ring

lemma reverse_countError_scale (p q M K : ℕ) (hp : 1≤p) (hM : 1≤M)
    {D : ℝ} (hD : 0<D) :
    reverse_countError p q M K ((M:ℝ)*D) ≤
      (M:ℝ)^(p+2*p*q+1)*reverse_countError p q 1 K D := by
  have hM1 : (1:ℝ)≤M := by exact_mod_cast hM
  have hMp : (0:ℝ)<M := by linarith
  have hrich : (M:ℝ)^((p:ℝ)⁻¹)*((M:ℝ)*D)^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ)) =
      (M:ℝ)^(p+2*p*q+1)*D^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ)) := by
    rw [Real.mul_rpow hMp.le hD.le,←mul_assoc,←Real.rpow_add hMp]
    have he : (p:ℝ)⁻¹+(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ))=((p+2*p*q+1:ℕ):ℝ) := by ring
    rw [he,Real.rpow_natCast]
  rw [reverse_countError_eq p q M K hp (mul_pos hMp hD),reverse_countError_eq p q 1 K hp hD]
  simp only [Nat.cast_one,Real.one_rpow,mul_one]
  rw [mul_pow,mul_pow]
  have hr := hrich
  have he : 2*(p+p*q:ℕ)*(M:ℝ)^((p:ℝ)⁻¹)*((M:ℝ)*D)^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ)) =
      2*(p+p*q:ℕ)*(M:ℝ)^(p+2*p*q+1)*D^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ)) := by
    calc
      _ = 2*(p+p*q:ℕ)*((M:ℝ)^((p:ℝ)⁻¹)*((M:ℝ)*D)^(((p+2*p*q+1:ℕ):ℝ)-1/(p:ℝ))) := by ring
      _ = _ := by rw [hr]; ring
  rw [he]
  have hl := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hM1 (show p+2*p*q≤p+2*p*q+1 by omega))
      (reverse_linearCoeff_nonneg p q)) (pow_nonneg hD.le (p+2*p*q))
  nlinarith

lemma exists_reverse_unit_threshold (p q : ℕ) (hp : 1≤p) (Q : ℝ) (hQ : 1≤Q) :
    ∃K : ℕ, 1≤K ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧ ∀d : ℝ, L≤d →
      reverse_countError p q 1 K (Q*d)≤(d/4)^(p+2*p*q+1)/2 := by
  let k := p+2*p*q+1
  let h := p+2*p*q
  let e : ℝ := (k:ℝ)-1/(p:ℝ)
  let A : ℝ := ((p+2*p*q+2:ℕ):ℝ)^3
  obtain ⟨K,hK⟩ := exists_nat_gt (8*A*4^k*Q^k)
  have hQpos : 0<Q := by linarith
  have hApos : 0<A := by dsimp [A]; positivity
  have hKpos : (0:ℝ)<K := lt_trans (by positivity) hK
  have hK1 : 1≤K := by exact_mod_cast (show 0<K by exact_mod_cast hKpos)
  have h4 : (0:ℝ)<4*4^k := by positivity
  have hsmall : 2*A*Q^k/(K:ℝ)≤1/(4*4^k) := by
    apply (div_le_div_iff₀ hKpos h4).mpr
    nlinarith
  let B : ℝ := reverse_linearCoeff p q*Q^h
  let C : ℝ := 2*(p+p*q:ℕ)*Q^e
  have hhk : (h:ℝ)<k := by dsimp [h,k]; push_cast; linarith
  have hek : e<(k:ℝ) := by
    have hp0 : (0:ℝ)<p := by exact_mod_cast (show 0<p by omega)
    dsimp [e]
    linarith [one_div_pos.mpr hp0]
  have ho : (fun d : ℝ => B*d^(h:ℝ)+C*d^e)=o[atTop] (fun d => d^(k:ℝ)) :=
    ((ThetaFour.rpow_littleO hhk).const_mul_left B).add ((ThetaFour.rpow_littleO hek).const_mul_left C)
  obtain ⟨L,hL⟩ := eventually_atTop.mp (ho.def (c := 1/(4*4^k)) (by positivity))
  refine ⟨K,hK1,max (4*(p+2*p*q+3:ℕ)) L,le_max_left _ _,?_⟩
  intro d hd
  have hdl : (4*(p+2*p*q+3:ℕ):ℝ)≤d := (le_max_left _ _).trans hd
  have hdpos : 0<d := lt_of_lt_of_le (by positivity) hdl
  have hbound := hL d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hdpos.le _)] at hbound
  have herr := (le_abs_self (B*d^(h:ℝ)+C*d^e)).trans hbound
  have hmain := mul_le_mul_of_nonneg_right hsmall (pow_nonneg hdpos.le k)
  have heq : reverse_countError p q 1 K (Q*d)=B*d^(h:ℝ)+C*d^e+(2*A*Q^k/(K:ℝ))*d^k := by
    rw [reverse_countError_eq p q 1 K hp (mul_pos hQpos hdpos),Real.mul_rpow hQpos.le hdpos.le]
    simp only [Real.rpow_natCast,Nat.cast_one,Real.one_rpow,mul_one]
    dsimp [A,B,C,h,e,k]
    rw [mul_pow,mul_pow]
    ring
  rw [heq]
  simp only [Real.rpow_natCast] at herr
  have hsum : B*d^(h:ℝ)+C*d^e+(2*A*Q^k/(K:ℝ))*d^k≤2*(1/(4*4^k)*d^k) := by
    simpa only [Real.rpow_natCast,two_mul] using add_le_add herr hmain
  exact hsum.trans_eq (by dsimp [k]; rw [div_pow]; ring)

lemma exists_reverse_uniform_threshold (p q : ℕ) (hp : 1≤p) (Q : ℝ) (hQ : 1≤Q) :
    ∃K : ℕ, 1≤K ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧
      ∀M : ℕ, 1≤M → ∀d : ℝ, L*M≤d →
        reverse_countError p q M K (Q*d)≤(d/4)^(p+2*p*q+1)/2 := by
  obtain ⟨K,hK,L,hLs,hL⟩ := exists_reverse_unit_threshold p q hp Q hQ
  refine ⟨K,hK,L,hLs,?_⟩
  intro M hM d hd
  have hMp : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hx : L≤d/(M:ℝ) := (le_div_iff₀ hMp).mpr hd
  have hxp : 0<d/(M:ℝ) := lt_of_lt_of_le (lt_of_lt_of_le (by positivity) hLs) hx
  have hQp : 0<Q := by linarith
  have hscale := reverse_countError_scale p q M K hp hM (mul_pos hQp hxp)
  have hmul : (M:ℝ)*(Q*(d/(M:ℝ)))=Q*d := by field_simp
  rw [hmul] at hscale
  have hh := mul_le_mul_of_nonneg_left (hL (d/M) hx) (pow_nonneg hMp.le (p+2*p*q+1))
  exact hscale.trans (hh.trans_eq (by rw [←mul_div_assoc,←mul_pow]; congr 2; field_simp))

end Erdos571.FanSpider

/-! The remaining multiplicity cost in fan pinning, separated from the KST error. -/
namespace Erdos571.FanSpider

lemma heavyThreshold_mul_bound (p q M K : ℕ) (hM : 1≤M) :
    heavyThreshold p q M K ≤ heavyThreshold p q 1 K*M := by
  unfold heavyThreshold AnchoredArms.heavyThreshold AnchoredArms.massCoeff AnchoredArms.vertexCount
  have h₁ : 2*(Fintype.card (Arms p q)+1) ≤ 2*(Fintype.card (Arms p q)+1)*M :=
    Nat.le_mul_of_pos_right _ (by omega)
  have h₂ : Fintype.card (Arms p q)+1 ≤ (Fintype.card (Arms p q)+1)*M :=
    Nat.le_mul_of_pos_right _ (by omega)
  have h₃ : 4 ≤ 4*M := by omega
  have hm : 4*(M*Fintype.card (Core p)+1)+2*(Fintype.card (Arms p q)+1) ≤
      (4*(1*Fintype.card (Core p)+1)+2*(Fintype.card (Arms p q)+1))*M := by nlinarith
  have hh := Nat.mul_le_mul_right (K^(Fintype.card (Arms p q)+1)) hm
  nlinarith

lemma richThreshold_mul_bound (t T p q M : ℕ) (hM : 1≤M) (ht : t≤T*M) :
    richThreshold t p q M ≤ richThreshold T p q 1*M^(q+2) := by
  have hpre : p*q+1+M+(q+1)*M*p ≤ (p*q+1+1+(q+1)*1*p)*M := by
    have := Nat.le_mul_of_pos_right (p*q+1) (show 0<M by omega)
    nlinarith
  have hpow : t^(q+1) ≤ T^(q+1)*M^(q+1) := by
    simpa only [mul_pow] using Nat.pow_le_pow_left ht (q+1)
  have hh := Nat.mul_le_mul hpre (Nat.mul_le_mul_left (q+1) hpow)
  unfold richThreshold branchLoad
  calc
    _ ≤ (p*q+1+1+(q+1)*1*p)*M*((q+1)*(T^(q+1)*M^(q+1))) := hh
    _ = _ := by rw [show q+2=(q+1)+1 by omega,pow_succ]; ring

lemma pinBound_mul_bound (t T p q M : ℕ) (hM : 1≤M) (ht : t≤T*M) :
    pinBound t p q M ≤ pinBound T p q 1*M^((q+2)*(p+1)) := by
  have hr := richThreshold_mul_bound t T p q M hM ht
  have hMp : M ≤ M^(q+2) := by
    simpa only [pow_one] using Nat.pow_le_pow_right hM (show 1≤q+2 by omega)
  have hMpow : 1 ≤ M^(q+2) := one_le_pow₀ hM
  have hlin : t+richThreshold t p q M+1 ≤ (T+richThreshold T p q 1+1)*M^(q+2) := by
    have ht' := ht.trans (Nat.mul_le_mul_left T hMp)
    nlinarith
  have hplus : richThreshold t p q M+1 ≤ (richThreshold T p q 1+1)*M^(q+2) := by nlinarith
  have hpow := Nat.pow_le_pow_left hplus p
  have hh := Nat.mul_le_mul hlin hpow
  unfold pinBound
  calc
    _ ≤ (T+richThreshold T p q 1+1)*M^(q+2)*((richThreshold T p q 1+1)*M^(q+2))^p := hh
    _ = _ := by rw [mul_pow,←pow_mul,show (q+2)*(p+1)=(q+2)+(q+2)*p by ring,pow_add]; ring

lemma copyLoad_mul_bound (t T p q M : ℕ) (hM : 1≤M) (ht : t≤T*M) :
    copyLoad t p q M ≤ copyLoad T p q 1*M^((q+2)*(p+1)) := by
  have hh := Nat.mul_le_mul_left (p+p*q+1) (pinBound_mul_bound t T p q M hM ht)
  simpa only [copyLoad,Nat.mul_assoc] using hh

def multiplicityExponent (p q : ℕ) : ℕ := (q+2)*(p+1)+1

lemma degreeBase_mul_bound (p q M K : ℕ) (hM : 1≤M) :
    degreeBase p q M K ≤ degreeBase p q 1 K*(M:ℝ)^(multiplicityExponent p q) := by
  have hc := copyLoad_mul_bound (heavyThreshold p q M K) (heavyThreshold p q 1 K) p q M hM
    (heavyThreshold_mul_bound p q M K hM)
  have hh : M*(p+p*q+1)*copyLoad (heavyThreshold p q M K) p q M ≤
      ((p+p*q+1)*copyLoad (heavyThreshold p q 1 K) p q 1)*M^(multiplicityExponent p q) := by
    have h := Nat.mul_le_mul_left (M*(p+p*q+1)) hc
    exact h.trans_eq (by unfold multiplicityExponent; rw [pow_succ]; ring)
  unfold degreeBase
  have hhr : (M*(p+p*q+1)*copyLoad (heavyThreshold p q M K) p q M:ℕ) ≤
      (((p+p*q+1)*copyLoad (heavyThreshold p q 1 K) p q 1:ℕ):ℝ)*(M:ℝ)^(multiplicityExponent p q) := by
    exact_mod_cast hh
  have h := mul_le_mul_of_nonneg_left hhr (show 0≤(2:ℝ)*4^(p+2*p*q+1) by positivity)
  simpa only [one_mul,mul_assoc] using h

end Erdos571.FanSpider

/-! A uniform-in-multiplicity power bound for almost-regular homogeneous fans. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization ProjectionHeavy

lemma reverse_large_degree_power {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (p q M K : ℕ) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 0<d) (hdlarge : 4*(p+2*p*q+3:ℕ)≤d)
    (herr : reverse_countError p q M K (Q*d)≤(d/4)^(p+2*p*q+1)/2) (hK : 1≤K)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) :
    d^(p+2*p*q+1)≤degreeBase p q M K*(U.card:ℝ)^(p*q) := by
  classical
  have hn : (0:ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0≤Q*d := by positivity
  let F := TreeCopiesIn.copies (template p q) G U
  have hl : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤F.card := by
    have hh := TreeCopiesIn.lower (template p q) (isTree p q) G U (d := d) (by
      simp only [card_vertex p q,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat]
      push_cast at hdlarge
      linarith)
      (fun v hv => (hdeg v hv).1)
    simpa only [card_vertex p q,Nat.add_sub_cancel] using hh
  have hd1 : 1≤d := (show (1:ℝ)≤4*(p+2*p*q+3:ℕ) by norm_cast; omega).trans hdlarge
  have hD1 : 1≤Q*d := by nlinarith
  have ht : 1≤heavyThreshold p q M K := by
    have hpos : 0<heavyThreshold p q M K := by
      dsimp [heavyThreshold,AnchoredArms.heavyThreshold,AnchoredArms.vertexCount]
      positivity
    omega
  have hu := reverse_all_count G U (heavyThreshold p q M K) p q M ht hp hq hM hf hD1
    (fun v hv => (hdeg v hv).2) F (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have hbad := badPairs_sum_bound G g hg U p q M K hK hf hD (fun v hv => (hdeg v hv).2)
  have hb := mul_le_mul_of_nonneg_right hbad (show 0≤(((p+2*p*q+2:ℕ):ℝ))^3*(Q*d)^(p+2*p*q-1) by positivity)
  let C : ℝ := (M*(p+p*q+1)*copyLoad (heavyThreshold p q M K) p q M:ℕ)
  have hc : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤C*(U.card:ℝ)^(p*q+1)+U.card*reverse_countError p q M K (Q*d) := by
    dsimp [C,reverse_countError]
    nlinarith
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤2*C*(U.card:ℝ)^(p*q+1) := by linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0≤(4:ℝ)^(p+2*p*q+1) by positivity)
  have heq : (U.card:ℝ)*(d/4)^(p+2*p*q+1)*4^(p+2*p*q+1)=U.card*d^(p+2*p*q+1) := by
    rw [div_pow]; field_simp
  rw [heq,pow_succ (U.card:ℝ) (p*q)] at hm'
  have hpower : d^(p+2*p*q+1)≤degreeBase p q M K*(U.card:ℝ)^(p*q) := by
    apply (mul_le_mul_iff_left₀ hn).mp
    dsimp [degreeBase]
    dsimp [C] at hm'
    nlinarith
  exact hpower

theorem exists_uniform_power_bound (p q : ℕ) (hp : 1≤p) (hq : 1≤q)
    (Q : ℝ) (hQ : 1≤Q) :
    ∃C : ℝ, 0≤C ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧
      ∀M : ℕ, 1≤M → ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (U : Finset W), U.Nonempty →
        (graph p q M).Free G → ∀g : W → Bool, (∀{u v}, G.Adj u v → g u≠g v) →
        ∀d : ℝ, L*M≤d →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          d^(p+2*p*q+1)≤C*(M:ℝ)^(multiplicityExponent p q)*(U.card:ℝ)^(p*q) := by
  obtain ⟨K,hK,L,hLs,herr⟩ := exists_reverse_uniform_threshold p q hp Q hQ
  refine ⟨degreeBase p q 1 K,by unfold degreeBase; positivity,L,hLs,?_⟩
  intro M hM W _ _ G _ U hU hf g hg d hd hdeg
  have hM1 : (1:ℝ)≤M := by exact_mod_cast hM
  have hL0 : 0≤L := le_trans (by positivity) hLs
  have hdlarge : (4*(p+2*p*q+3:ℕ):ℝ)≤d := hLs.trans (by nlinarith)
  have hdpos : 0<d := lt_of_lt_of_le (by positivity) hdlarge
  have hh := reverse_large_degree_power G U hU p q M K hp hq hM hf g hg hQ hdpos hdlarge
    (herr M hM d hd) hK hdeg
  exact hh.trans (mul_le_mul_of_nonneg_right (degreeBase_mul_bound p q M K hM) (by positivity))

end Erdos571.FanSpider

/-! The verified quantitative gain, and its exact parameters for the 3,3 fan. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph DensityRegularization

/-- A uniform sufficient condition for an actual homogeneous fan power,
not just a homomorphism or a collection of overlapping copies. -/
theorem exists_uniform_containment_threshold (p q : ℕ) (hp : 1≤p) (hq : 1≤q)
    (Q : ℝ) (hQ : 1≤Q) :
    ∃C : ℝ, 0≤C ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧
      ∀M : ℕ, 1≤M → ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (U : Finset W), U.Nonempty →
        ∀g : W → Bool, (∀{u v}, G.Adj u v → g u≠g v) → ∀d : ℝ,
          L*M≤d → C*(M:ℝ)^(multiplicityExponent p q)*(U.card:ℝ)^(p*q)<d^(p+2*p*q+1) →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          graph p q M ⊑ G := by
  obtain ⟨C,hC,L,hL,hbound⟩ := exists_uniform_power_bound p q hp hq Q hQ
  refine ⟨C,hC,L,hL,?_⟩
  intro M hM W _ _ G _ U hU g hg d hd hstrict hdeg
  by_contra hf
  exact (not_lt_of_ge (hbound M hM W inferInstance inferInstance G inferInstance U hU hf g hg d hd hdeg)) hstrict

/-- This is a genuine power bound with constants independent of `M`.
The exponent sixteen is still too costly for the proposed mixed-fan extension. -/
theorem three_three_uniform_bound (Q : ℝ) (hQ : 1≤Q) :
    ∃C : ℝ, 0≤C ∧ ∃L : ℝ, 68≤L ∧
      ∀M : ℕ, 1≤M → ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (U : Finset W), U.Nonempty →
        (graph 2 3 M).Free G → ∀g : W → Bool, (∀{u v}, G.Adj u v → g u≠g v) →
        ∀d : ℝ, L*M≤d →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          d^15≤C*(M:ℝ)^16*(U.card:ℝ)^6 := by
  simpa only [multiplicityExponent,show (3+2)*(2+1)+1=16 by norm_num,
    show 2+2*2*3+3=17 by norm_num,show 2*3=6 by norm_num,
    show 2+2*2*3+1=15 by norm_num,Nat.cast_ofNat,show (4:ℝ)*17=68 by norm_num]
    using exists_uniform_power_bound 2 3 (by omega) (by omega) Q hQ

/-- Arithmetic diagnostic only: no graph nonrealizability is asserted. -/
lemma mixed_scale_arithmetic :
    (15:ℚ)*(7/17)-6=3/17 ∧ (3/17:ℚ)/16=3/272 ∧
      1-2*(7/17:ℚ)=3/17 ∧ (3/272:ℚ)<3/17 := by norm_num

end Erdos571.FanSpider

/-! Tight light short-spider pin counts: a pinned middle saves one choice. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma center_arm_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W) (j : Fin s) (z w : W)
    (hgood : ∀f∈F, GoodCopy G U t s f) (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (hcent : ∀f∈F, f (.inl none)=z) (harm : ∀f∈F, f (.inl (some j))=w) :
    F.card≤t^(s-1) := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C (k : Fin s) : Finset W := if k=j then {w} else FourthMoment.common G U z (r (some k))
  have hC (k : Fin s) : (C k).card ≤ if k=j then 1 else t := by
    by_cases hk : k=j
    · simp [C,hk]
    · simp only [C,if_neg hk]
      have h := ((hgood f₀ hf₀).2 k).2
      rw [hcent f₀ hf₀,hroot f₀ hf₀] at h
      exact h.le
  let ev : F → ((k : Fin s) → C k) := fun f k =>
    ⟨f.val (.inl (some k)),by
      by_cases hk : k=j
      · simp only [C,if_pos hk,mem_singleton]
        exact hk ▸ harm f.val f.property
      · simp only [C,if_neg hk]
        refine mem_filter.mpr ⟨(hgood f.val f.property).1 _,?_,?_⟩
        · rw [←hcent f.val f.property]
          exact f.val.toHom.map_adj trivial
        · rw [←hroot f.val f.property]
          exact f.val.toHom.map_adj rfl⟩
  have hev : Function.Injective ev := by
    intro f f' he
    apply Subtype.ext
    apply Copy.ext
    rintro (a|a)
    · cases a with
      | none => exact (hcent f.val f.property).trans (hcent f'.val f'.property).symm
      | some k => exact congrArg Subtype.val (congrFun he k)
    · exact (hroot f.val f.property a).trans (hroot f'.val f'.property a).symm
  have hh := Fintype.card_le_of_injective ev hev
  rw [Fintype.card_coe,Fintype.card_pi] at hh
  calc
    _ ≤ ∏k : Fin s, Fintype.card (C k) := hh
    _ ≤ ∏k : Fin s, if k=j then 1 else t := prod_le_prod' (fun k _ => by simpa using hC k)
    _ = _ := by
      rw [←prod_erase_mul univ (fun k : Fin s => if k=j then 1 else t) (mem_univ j)]
      simp only [ite_true,mul_one]
      have he : (∏k∈(univ : Finset (Fin s)).erase j, if k=j then 1 else t) =
          ∏_k∈(univ : Finset (Fin s)).erase j, t := by
        apply prod_congr rfl
        intro k hk
        exact if_neg (mem_erase.mp hk).1
      rw [he]
      simp

lemma sharp_arm_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W) (j : Fin s) (w : W)
    (hgood : ∀f∈F, GoodCopy G U t s f) (hroot : ∀f∈F, ∀x, f (.inr x)=r x)
    (harm : ∀f∈F, f (.inl (some j))=w) : F.card≤t^s := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := FourthMoment.common G U (r none) w
  have hC : C.card≤t := by
    have h := ((hgood f₀ hf₀).2 j).1
    rw [hroot f₀ hf₀,harm f₀ hf₀] at h
    exact h.le
  let center := fun f : (template s).Copy G => f (.inl none)
  have hsub : F.image center⊆C := by
    intro c hc
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hc
    refine mem_filter.mpr ⟨(hgood f hf).1 _,?_,?_⟩
    · rw [←hroot f hf]
      exact f.toHom.map_adj rfl
    · rw [←harm f hf]
      exact f.toHom.map_adj trivial
  have hb : F.card≤t^(s-1)*(F.image center).card := card_le_mul_card_image F _ (by
    intro c hc
    exact center_arm_count G U t s _ r j c w
      (fun f hf => hgood f (mem_filter.mp hf).1)
      (fun f hf => hroot f (mem_filter.mp hf).1)
      (fun f hf => (mem_filter.mp hf).2)
      (fun f hf => harm f (mem_filter.mp hf).1))
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hsub).trans hC))).trans_eq
    (by rw [←pow_succ]; congr 1; have := j.isLt; omega)

lemma sharp_interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t s : ℕ)
    (F : Finset ((template s).Copy G)) (r : Option (Fin s) → W)
    (hgood : ∀f∈F, GoodCopy G U t s f) (hroot : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤(s+1)*t^s := by
  classical
  let A (a : Option (Fin s)) := F.filter (fun f => f (.inl a)=w)
  have hsub : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,he⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨hf,he⟩⟩
  have hA (a : Option (Fin s)) : (A a).card≤t^s := by
    cases a with
    | none =>
      exact center_count G U t s _ r w
        (fun f hf => hgood f (mem_filter.mp hf).1)
        (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    | some j =>
      exact sharp_arm_count G U t s _ r j w
        (fun f hf => hgood f (mem_filter.mp hf).1)
        (fun f hf => hroot f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
  exact ((card_le_card hsub).trans card_biUnion_le).trans
    ((sum_le_sum (fun a _ => hA a)).trans_eq (by simp))

end Erdos571.ShortSpider

/-! Fan pinning without counting the pinned branch twice. -/
namespace Erdos571.FanSpider
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

structure ControlledCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q R : ℕ)
    (f : (template p q).Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light (template p q) G U t f
  branch : ∀b : Branch p q, (LongSpider.shortFiber G U t q (f (subCopy b (.inr none)))
    (fun j => f (subCopy b (.inr (some j))))).card≤R

lemma ControlledCopy.child_good {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W} {t p q R : ℕ}
    {f : (template p q).Copy G} (h : ControlledCopy G U t p q R f) (b : Branch p q) :
    ShortSpider.GoodCopy G U t q (f.comp (subCopy b)) := by
  refine ⟨fun v => h.mem _,?_⟩
  intro j
  constructor
  · exact h.light _ _ _ ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inr none) (.inl none) from rfl))
      ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inl none) (.inl (some j)) from trivial))
      ((subCopy b).injective.ne Sum.inr_ne_inl)
  · exact h.light _ _ _ ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inl none) (.inl (some j)) from trivial))
      ((subCopy b).toHom.map_adj (show (ShortSpider.template q).Adj (.inl (some j)) (.inr (some j)) from rfl))
      ((subCopy b).injective.ne Sum.inl_ne_inr)

lemma controlled_branch_image_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q R : ℕ)
    (F : Finset ((template p q).Copy G)) (b : Branch p q) (r : Option (Fin q) → W)
    (hg : ∀f∈F, ControlledCopy G U t p q R f)
    (hr : ∀f∈F, ∀a, f (subCopy b (.inr a))=r a) :
    (F.image (fun f => f.comp (subCopy b))).card≤R := by
  classical
  by_cases hF : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hF,image_empty,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  have hb : (LongSpider.shortFiber G U t q (r none) (fun j => r (some j))).card≤R := by
    have h := (hg f₀ hf₀).branch b
    simp only [hr f₀ hf₀] at h
    exact h
  apply le_trans _ hb
  apply card_le_card
  intro f hf
  obtain ⟨g,hg',rfl⟩ := mem_image.mp hf
  apply (LongSpider.mem_shortFiber _ _ _ _ _ _ _).mpr
  exact ⟨(hg g hg').child_good b,hr g hg' none,fun j => hr g hg' (some j)⟩

lemma controlled_center_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q R : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (center p q)=w) : F.card≤R^p := by
  classical
  let C (i : Fin p) := F.image (fun f => f.comp (branchCopy i))
  have hC (i : Fin p) : (C i).card≤R :=
    controlled_branch_image_bound G U t p q R F (.inl i) (fun a => a.elim w (fun j => r (.inr (i,j)))) hg (by
      intro f hf a
      cases a with
      | none => exact hw f hf
      | some j => exact hr f hf (.inr (i,j)))
  let ev : F → ((i : Fin p) → C i) := fun f i => ⟨f.val.comp (branchCopy i),mem_image.mpr ⟨f.val,f.property,rfl⟩⟩
  have hi : Function.Injective ev := by
    intro f f' he
    have hchild (i : Fin p) : f.val.comp (branchCopy i)=f'.val.comp (branchCopy i) := congrArg Subtype.val (congrFun he i)
    apply Subtype.ext
    apply Copy.ext
    rintro (((a|i)|⟨i,j⟩)|x)
    · have ha : a=0 := Subsingleton.elim _ _
      subst a
      exact (hw f.val f.property).trans (hw f'.val f'.property).symm
    · exact congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl none)) (hchild i)
    · exact congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl (some j))) (hchild i)
    · exact (hr f.val f.property x).trans (hr f'.val f'.property x).symm
  have hc := Fintype.card_le_of_injective ev hi
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  calc
    _ ≤ ∏i : Fin p, Fintype.card (C i) := hc
    _ ≤ ∏_i : Fin p, R := prod_le_prod' (fun i _ => by simpa using hC i)
    _ = _ := by simp



lemma controlled_branch_fiber_count (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q R : ℕ) (F : Finset ((template p q).Copy G))
    (r : Root p q → W) (i : Fin p) (ψ : (ShortSpider.template q).Copy G)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hbranch : ∀f∈F, f.comp (branchCopy i)=ψ) : F.card≤R^(p-1) := by
  classical
  let J := {k : Fin p // k≠i}
  let C (k : J) := F.image (fun f => f.comp (branchCopy k.val))
  have hcenter (f) (hf : f∈F) : f (center p q)=ψ (.inr none) :=
    congrArg (fun g : (ShortSpider.template q).Copy G => g (.inr none)) (hbranch f hf)
  have hC (k : J) : (C k).card≤R :=
    controlled_branch_image_bound G U t p q R F (.inl k.val)
      (fun a => a.elim (ψ (.inr none)) (fun j => r (.inr (k.val,j)))) hg (by
        intro f hf a
        cases a with
        | none => exact hcenter f hf
        | some j => exact hr f hf (.inr (k.val,j)))
  let ev : F → ((k : J) → C k) := fun f k =>
    ⟨f.val.comp (branchCopy k.val),mem_image.mpr ⟨f.val,f.property,rfl⟩⟩
  have hi : Function.Injective ev := by
    intro f f' he
    have hchild (k : Fin p) : f.val.comp (branchCopy k)=f'.val.comp (branchCopy k) := by
      by_cases hk : k=i
      · subst k
        exact (hbranch f.val f.property).trans (hbranch f'.val f'.property).symm
      · exact congrArg Subtype.val (congrFun he ⟨k,hk⟩)
    apply Subtype.ext
    apply Copy.ext
    rintro (((a|k)|⟨k,j⟩)|x)
    · have ha : a=0 := Subsingleton.elim _ _
      subst a
      exact (hcenter f.val f.property).trans (hcenter f'.val f'.property).symm
    · exact congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl none)) (hchild k)
    · exact congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl (some j))) (hchild k)
    · exact (hr f.val f.property x).trans (hr f'.val f'.property x).symm
  have hc := Fintype.card_le_of_injective ev hi
  rw [Fintype.card_coe,Fintype.card_pi] at hc
  have hJ : Fintype.card J=p-1 := by
    dsimp [J]
    rw [Fintype.card_subtype_compl]
    simp
  calc
    _ ≤ ∏k : J, Fintype.card (C k) := hc
    _ ≤ ∏_k : J, R := prod_le_prod' (fun k _ => by simpa using hC k)
    _ = _ := by simp [hJ]

lemma controlled_middle_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R : ℕ) (F : Finset ((template p q).Copy G)) (r : Root p q → W)
    (w : W) (i : Fin p) (j : Fin q)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (middle i j)=w) : F.card≤R^p := by
  classical
  let rr : Option (Fin q) → W := fun a => a.elim w (fun k => if k=j then r (.inl ()) else r (.inr (i,k)))
  have hroot (f) (hf : f∈F) (a : Option (Fin q)) : f (subCopy (.inr (i,j)) (.inr a))=rr a := by
    cases a with
    | none => exact hw f hf
    | some k =>
      change f (if k=j then short p q else root i k)=(if k=j then r (.inl ()) else r (.inr (i,k)))
      by_cases hk : k=j
      · rw [if_pos hk,if_pos hk]; exact hr f hf (.inl ())
      · rw [if_neg hk,if_neg hk]; exact hr f hf (.inr (i,k))
  let ev : (template p q).Copy G → (ShortSpider.template q).Copy G := fun f => f.comp (rerootCopy i j)
  have hC : (F.image ev).card≤R := controlled_branch_image_bound G U t p q R F (.inr (i,j)) rr hg hroot
  have hb : F.card≤R^(p-1)*(F.image ev).card := card_le_mul_card_image F _ (by
    intro ψ hψ
    obtain ⟨f₀,hf₀,he₀⟩ := mem_image.mp hψ
    apply controlled_branch_fiber_count G U t p q R _ r i (f₀.comp (branchCopy i))
      (fun f hf => hg f (mem_filter.mp hf).1) (fun f hf => hr f (mem_filter.mp hf).1)
    intro f hf
    have he : ev f=ev f₀ := (mem_filter.mp hf).2.trans he₀.symm
    apply Copy.ext
    rintro (a|a)
    · cases a with
      | none =>
        have h := congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl none)) he
        exact h
      | some k =>
        by_cases hk : k=j
        · subst k
          exact (hw f (mem_filter.mp hf).1).trans (hw f₀ hf₀).symm
        · have h := congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl (some k))) he
          change f (if k=j then center p q else middle i k)=f₀ (if k=j then center p q else middle i k) at h
          simpa only [if_neg hk] using h
    · cases a with
      | none =>
        have h := congrArg (fun g : (ShortSpider.template q).Copy G => g (.inl (some j))) he
        change f (if j=j then center p q else middle i j)=f₀ (if j=j then center p q else middle i j) at h
        simpa only [ite_true] using h
      | some k => exact (hr f (mem_filter.mp hf).1 (.inr (i,k))).trans (hr f₀ hf₀ (.inr (i,k))).symm)
  exact (hb.trans (Nat.mul_le_mul_left _ hC)).trans_eq
    (by rw [←pow_succ]; congr 1; have := i.isLt; omega)


lemma controlled_hub_branch_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R : ℕ) (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W) (i : Fin p)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (hub i)=w) : (F.image (fun f => f.comp (branchCopy i))).card≤t^(q+1) := by
  classical
  by_cases hF : F.Nonempty
  swap
  · simp only [not_nonempty_iff_eq_empty.mp hF,image_empty,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let B := F.image (fun f => f.comp (branchCopy i))
  let C := FourthMoment.common G U w (r (.inl ()))
  have hC : C.card≤t := by
    have h := (hg f₀ hf₀).light (hub i) (center p q) (short p q)
      (adj_hub i).symm (adj_short p q) (by simp [hub,short])
    change (FourthMoment.common G U (f₀ (hub i)) (f₀ (.inr (.inl ())))).card<t at h
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact h.le
  let ev : (ShortSpider.template q).Copy G → W := fun f => f (.inr none)
  have hsub : B.image ev⊆C := by
    intro u hu
    obtain ⟨ψ,hψ,rfl⟩ := mem_image.mp hu
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
    refine mem_filter.mpr ⟨(hg f hf).mem _,?_,?_⟩
    · rw [←hw f hf]
      exact f.toHom.map_adj (adj_hub i).symm
    · rw [←hr f hf]
      exact f.toHom.map_adj (adj_short p q).symm
  have hb : B.card≤t^q*(B.image ev).card := card_le_mul_card_image B _ (by
    intro u hu
    apply ShortSpider.center_count G U t q _ (fun a => a.elim u (fun j => r (.inr (i,j)))) w
    · intro ψ hψ
      obtain ⟨f,hf,rfl⟩ := mem_image.mp (mem_filter.mp hψ).1
      exact (hg f hf).child_good (.inl i)
    · intro ψ hψ a
      cases a with
      | none => exact (mem_filter.mp hψ).2
      | some j =>
        obtain ⟨f,hf,rfl⟩ := mem_image.mp (mem_filter.mp hψ).1
        exact hr f hf (.inr (i,j))
    · intro ψ hψ
      obtain ⟨f,hf,rfl⟩ := mem_image.mp (mem_filter.mp hψ).1
      exact hw f hf)
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hsub).trans hC))).trans_eq (pow_succ _ _).symm

lemma controlled_hub_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R : ℕ) (hR : t^(q+1)≤R) (F : Finset ((template p q).Copy G))
    (r : Root p q → W) (w : W) (i : Fin p)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (hw : ∀f∈F, f (hub i)=w) : F.card≤R^p := by
  classical
  have hb := card_le_mul_card_image F (R^(p-1)) (f := fun f => f.comp (branchCopy i)) (by
    intro ψ hψ
    exact controlled_branch_fiber_count G U t p q R _ r i ψ
      (fun f hf => hg f (mem_filter.mp hf).1) (fun f hf => hr f (mem_filter.mp hf).1)
      (fun f hf => (mem_filter.mp hf).2))
  exact (hb.trans (Nat.mul_le_mul_left _ ((controlled_hub_branch_count G U t p q R F r w i hg hr hw).trans hR))).trans_eq
    (by rw [←pow_succ]; congr 1; have := i.isLt; omega)

lemma controlled_pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R : ℕ) (hR : t^(q+1)≤R) (F : Finset ((template p q).Copy G))
    (r : Root p q → W) (w : W) (a : Interior p q)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (.inl a)=w) : F.card≤R^p := by
  rcases a with (a|i)|⟨i,j⟩
  · have ha : a=0 := Subsingleton.elim _ _
    subst a
    exact controlled_center_count G U t p q R F r w hg hr hw
  · exact controlled_hub_count G U t p q R hR F r w i hg hr hw
  · exact controlled_middle_count G U t p q R F r w i j hg hr hw


lemma controlled_interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R : ℕ) (hR : t^(q+1)≤R) (F : Finset ((template p q).Copy G))
    (r : Root p q → W) (hg : ∀f∈F, ControlledCopy G U t p q R f)
    (hr : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤(p+p*q+1)*R^p := by
  classical
  let A (a : Interior p q) := F.filter (fun f => f (.inl a)=w)
  have hs : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨hf,ha⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hs
    _ ≤ ∑a : Interior p q, (A a).card := card_biUnion_le
    _ ≤ ∑_a : Interior p q, R^p := sum_le_sum (fun a ha =>
      controlled_pinned_count G U t p q R hR (A a) r w a
        (fun f hf => hg f (mem_filter.mp hf).1) (fun f hf => hr f (mem_filter.mp hf).1)
        (fun f hf => (mem_filter.mp hf).2))
    _ = _ := by simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul,Nat.cast_id]; ring

lemma controlled_rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R M : ℕ) (hR : t^(q+1)≤R) (hR0 : 0<R) (hf : (graph p q M).Free G)
    (F : Finset ((template p q).Copy G)) (r : Root p q ↪ W)
    (hg : ∀f∈F, ControlledCopy G U t p q R f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) :
    F.card<M*(p+p*q+1)*((p+p*q+1)*R^p) := by
  classical
  by_contra! hc
  have hh := RootedPacking.power_contained_of_bounded_load F id r hr ((p+p*q+1)*R^p) M (by positivity)
    (controlled_interior_load G U t p q R hR F r hg hr) (by
      simpa only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,show 1+p+p*q=p+p*q+1 by omega] using hc)
  rw [power_eq] at hh
  exact hf hh

lemma controlled_good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q R M : ℕ) (hR : t^(q+1)≤R) (hR0 : 0<R) (hf : (graph p q M).Free G)
    (F : Finset ((template p q).Copy G)) (hg : ∀f∈F, ControlledCopy G U t p q R f) :
    (F.card:ℝ)≤(M*(p+p*q+1)*((p+p*q+1)*R^p):ℕ)*(U.card:ℝ)^(p*q+1) := by
  have h := RootedFiberCount.bound (template p q) G U F (fun f hf r => (hg f hf).mem _)
    (B := (M*(p+p*q+1)*((p+p*q+1)*R^p):ℕ)) (by positivity) (by
      intro r F' hF' hr
      exact_mod_cast (controlled_rooted_count G U t p q R M hR hR0 hf F' r
        (fun f hf => hg f (hF' hf)) hr).le)
  simpa only [Fintype.card_sum,Fintype.card_prod,Fintype.card_unit,Fintype.card_fin,Nat.add_comm 1 (p*q)] using h

end Erdos571.FanSpider

/-! Sharp local thresholds for homogeneous fan packing. -/
namespace Erdos571.FanSpider.Sharp
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def threshold (t p q M : ℕ) : ℕ :=
  (t+(p*q+1+M+(q+1)*M*p)*(q+1))*t^q

lemma threshold_ge_power (t p q M : ℕ) : t^(q+1)≤threshold t p q M := by
  unfold threshold
  rw [pow_succ']
  exact Nat.mul_le_mul_right _ (Nat.le_add_right _ _)

lemma threshold_pos (t p q M : ℕ) (ht : 1≤t) : 0<threshold t p q M :=
  lt_of_lt_of_le (by positivity) (threshold_ge_power t p q M)

noncomputable def Rich (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (u : W) (r : Fin q → W) : Prop :=
  threshold t p q M < (LongSpider.shortFiber G U t q u r).card

lemma shortFiber_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t q : ℕ) (u : W) (r : Fin q → W) (w : W) :
    ((LongSpider.shortFiber G U t q u r).filter (fun f => w∈RootedPacking.interior f)).card ≤
      (q+1)*t^q := by
  apply ShortSpider.sharp_interior_load G U t q _ (fun a => a.elim u r)
  · intro f hf
    exact (LongSpider.mem_shortFiber G U t q u r f).mp hf |>.1
  · intro f hf a
    have h := (LongSpider.mem_shortFiber G U t q u r f).mp hf
    cases a with
    | none => exact h.2.1
    | some j => exact h.2.2 j

lemma contains_of_rich_neighbors (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1≤t) (r : Root p q ↪ W) (u : Fin M ↪ W)
    (hu : ∀i, G.Adj (u i) (r (.inl ()))) (hur : ∀i j, u i≠r j)
    (hrich : ∀i j, Rich G U t p q M (u i) (fun k => r (.inr (j,k)))) : graph p q M ⊑ G := by
  classical
  let Z := univ.image r ∪ univ.image u
  have hZ : Z.card≤p*q+1+M := by
    have h := card_union_le (univ.image r) (univ.image u)
    have hr := card_image_le (s := univ) (f := r)
    have hu := card_image_le (s := univ) (f := u)
    simp only [card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,Fintype.card_unit] at hr hu
    dsimp [Z]
    omega
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice_finite (q+1) (((q+1)*t^q))
    RootedPacking.interior
    (fun z : Fin M×Fin p => LongSpider.shortFiber G U t q (u z.1) (fun k => r (.inr (z.2,k)))) Z
    (by intro z f hf; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card f).le)
    (fun z w => shortFiber_load G U t q (u z.1) (fun k => r (.inr (z.2,k))) w)
    (by
      intro z
      have h := hrich z.1 z.2
      change threshold t p q M<_ at h
      simp only [Fintype.card_prod,Fintype.card_fin]
      apply lt_of_le_of_lt _ h
      dsimp [threshold]
      have hh := Nat.mul_le_mul_right ((q+1)*t^q)
        (show Z.card+(q+1)*(M*p) ≤ p*q+1+M+(q+1)*M*p by nlinarith)
      calc
        _ ≤ (p*q+1+M+(q+1)*M*p)*((q+1)*t^q) := hh
        _ = ((p*q+1+M+(q+1)*M*p)*(q+1))*t^q := by ring
        _ ≤ _ := Nat.mul_le_mul_right (t^q) (Nat.le_add_left _ _))
  let E := RootedPacking.packedInterior f hfdis
  let a : Fin M×Fin p ↪ W :=
    { toFun := fun z => E (z,none)
      inj' := fun _ _ h => congrArg Prod.fst (E.injective h) }
  let b : Fin M×Arms p q ↪ W :=
    { toFun := fun z => E ((z.1,z.2.1),some z.2.2)
      inj' := by
        rintro ⟨i,j,k⟩ ⟨i',j',k'⟩ he
        have h := E.injective he
        have hij := (Prod.mk.inj h).1
        have hk := Option.some.inj (Prod.mk.inj h).2
        exact Prod.ext (Prod.mk.inj hij).1 (Prod.ext (Prod.mk.inj hij).2 hk) }
  have havoid (z : Fin M×Fin p) (v : Option (Fin q)) (w : W) (hw : w∈Z) : f z (.inl v)≠w := by
    intro he
    exact Finset.disjoint_left.mp (hfZ z) (RootedPacking.mem_interior (f z) v) (he.symm ▸ hw)
  have huZ (i : Fin M) : u i∈Z := mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩)
  have hrZ (j : Root p q) : r j∈Z := mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩)
  have hroots (z : Fin M×Fin p) := (LongSpider.mem_shortFiber G U t q (u z.1) (fun k => r (.inr (z.2,k))) (f z)).mp (hf z)
  apply contains_of_layout G p q M u a b r
  · intro i z
    exact (havoid z none (u i) (huZ i)).symm
  · intro i z
    exact (havoid (z.1,z.2.1) (some z.2.2) (u i) (huZ i)).symm
  · exact hur
  · intro z z' he
    have h := E.injective he
    have hh := (Prod.mk.inj h).2
    simp at hh
  · intro z j
    exact havoid z none (r j) (hrZ j)
  · intro z j
    exact havoid (z.1,z.2.1) (some z.2.2) (r j) (hrZ j)
  · exact hu
  · intro i j
    change G.Adj (u i) (f (i,j) (.inl none))
    rw [←(hroots (i,j)).2.1]
    exact (f (i,j)).toHom.map_adj rfl
  · intro i j k
    exact (f (i,j)).toHom.map_adj trivial
  · intro i j k
    change G.Adj (f (i,j) (.inl (some k))) (r (.inr (j,k)))
    rw [←(hroots (i,j)).2.2 k]
    exact (f (i,j)).toHom.map_adj rfl


end Erdos571.FanSpider.Sharp

/-! Reversed tuple-box counting with sharp light-spider thresholds. -/
namespace Erdos571.FanSpider.Sharp
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_distinct {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t p q M : ℕ} {u : W} {r : Fin q → W} (h : Rich G U t p q M u r) :
    Function.Injective r ∧ ∀j, u≠r j := by
  obtain ⟨f,hf⟩ := card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) h)
  have hr := (LongSpider.mem_shortFiber G U t q u r f).mp hf
  constructor
  · intro j k he
    have hfk : f (.inr (some j))=f (.inr (some k)) := (hr.2.2 j).trans (he.trans (hr.2.2 k).symm)
    exact Option.some.inj (Sum.inr.inj (f.injective hfk))
  · intro j he
    have hfk : f (.inr none)=f (.inr (some j)) := hr.2.1.trans (he.trans (hr.2.2 j).symm)
    have hh := Sum.inr.inj (f.injective hfk)
    simp at hh

def boxRel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (z u : W) (r : Fin q → W) : Prop :=
  Rich G U t p q M u r ∧ ∀j, r j≠z

lemma box_no_packing (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hM : 1≤M) (hf : (graph p q M).Free G)
    (z : W) (X : Fin q → Finset W) (a : Fin M ↪ neighbors G U z) :
    ¬∃S⊆Fintype.piFinset X, S.card=p ∧
      (∀f∈S, ∀g∈S, f≠g → Disjoint (TupleBoxPacking.foot f) (TupleBoxPacking.foot g)) ∧
      ∀f∈S, ∀i, boxRel G U t p q M z (a i) f := by
  rintro ⟨S,hSX,hS,hdis,hrel⟩
  let e : Fin p ≃ S := Fintype.equivOfCardEq (by simpa using hS.symm)
  let u : Fin M ↪ W := a.trans (Function.Embedding.subtype _)
  let i₀ : Fin M := ⟨0,by omega⟩
  have hroot (j : Fin p) := rich_distinct (hrel (e j) (e j).property i₀).1
  let r : Root p q ↪ W :=
    { toFun := Sum.elim (fun _ => z) (fun x => (e x.1).val x.2)
      inj' := by
        rintro (v|⟨j,k⟩) (v'|⟨j',k'⟩) he
        · exact congrArg Sum.inl (Subsingleton.elim _ _)
        · exact ((hrel (e j') (e j').property i₀).2 k' he.symm).elim
        · exact ((hrel (e j) (e j).property i₀).2 k he).elim
        · by_cases hj : j=j'
          · subst j'
            exact congrArg Sum.inr (Prod.ext rfl ((hroot j).1 he))
          · have he' : (e j).val≠(e j').val := fun hh => hj (e.injective (Subtype.ext hh))
            exact (Finset.disjoint_left.mp (hdis (e j) (e j).property (e j') (e j').property he')
              (mem_image.mpr ⟨k,mem_univ _,rfl⟩) (mem_image.mpr ⟨k',mem_univ _,he.symm⟩)).elim }
  apply hf (contains_of_rich_neighbors G U t p q M ht r u ?_ ?_ ?_)
  · intro i
    exact (mem_filter.mp (a i).property).2.symm
  · intro i j
    cases j with
    | inl v => exact G.ne_of_adj (mem_filter.mp (a i).property).2.symm
    | inr x => exact (rich_distinct (hrel (e x.1) (e x.1).property i).1).2 x.2
  · intro i j
    exact (hrel (e j) (e j).property i).1

lemma box_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (z : W) (v : Fin q → W) {D : ℝ} (hD : 1≤D)
    (hz : ((neighbors G U z).card:ℝ)≤D) (hv : ∀j, ((neighbors G U (v j)).card:ℝ)≤D) :
    letI : DecidableRel (boxRel G U t p q M z) := fun _ _ => Classical.propDecidable _
    (((neighbors G U z×ˢFintype.piFinset (fun j => neighbors G U (v j))).filter
      (fun e => boxRel G U t p q M z e.1 e.2)).card:ℝ)≤
      reverseBoxBound p q M D := by
  classical
  letI : Nonempty (Fin q) := ⟨⟨0,by omega⟩⟩
  let A := neighbors G U z
  let X : Fin q → Finset W := fun j => neighbors G U (v j)
  let P : A → (Fin q → W) → Prop := fun a r => boxRel G U t p q M z a.val r
  have hb := TupleBoxKstReverse.bound X P p M hp hD (by simpa only [Fintype.card_coe] using hz) hv
    (box_no_packing G U t p q M ht hM hf z X)
  have he : ((univ×ˢFintype.piFinset X).filter (fun e : A×(Fin q → W) => P e.1 e.2)).card=
      ((A×ˢFintype.piFinset X).filter (fun e => boxRel G U t p q M z e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1.val,e.2))
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨e.1.property,(mem_product.mp he).2⟩,hP⟩
    · intro e he f hf hef
      exact Prod.ext (Subtype.ext (Prod.mk.inj hef).1) (Prod.mk.inj hef).2
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(⟨e.1,(mem_product.mp he).1⟩,e.2),
        mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,(mem_product.mp he).2⟩,hP⟩,rfl⟩
  simpa only [he,Fintype.card_fin,reverseBoxBound] using hb


end Erdos571.FanSpider.Sharp

/-! Rich fan-branch counts for the tightened threshold. -/
namespace Erdos571.FanSpider.Sharp
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def richBranches (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) : Finset ((ShortSpider.template q).Copy G) := by
  classical
  exact (TreeCopiesIn.copies (ShortSpider.template q) G U).filter
    (fun f => Rich G U t p q M (f (.inr none)) (fun j => f (.inr (some j))))

lemma richBranches_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((richBranches G U t p q M).card:ℝ)≤
      U.card*D^q*reverseBoxBound p q M D := by
  classical
  let F := richBranches G U t p q M
  let pre : (ShortSpider.template q).Copy G → W×(Fin q → W) :=
    fun f => (f (.inl none),fun j => f (.inl (some j)))
  have hm (f) (hf : f∈F) : ∀v, f v∈U :=
    (TreeCopiesIn.mem_copies _ _ _ _).mp (mem_filter.mp hf).1
  have hmap (f) (hf : f∈F) : pre f∈branchCores G U q := by
    refine mem_biUnion.mpr ⟨f (.inl none),hm f hf _,mem_image.mpr ⟨(fun j => f (.inl (some j))),?_,rfl⟩⟩
    exact Fintype.mem_piFinset.mpr (fun j => mem_filter.mpr ⟨hm f hf _,f.toHom.map_adj trivial⟩)
  have hcount := RealFiberCount.bound F (branchCores G U q) pre hmap
    (D := reverseBoxBound p q M D) (by
      intro v hv
      obtain ⟨z,hz,hv⟩ := mem_biUnion.mp hv
      obtain ⟨v',hv',he⟩ := mem_image.mp hv
      subst v
      let B := ((neighbors G U z)×ˢFintype.piFinset (fun j => neighbors G U (v' j))).filter
        (fun e => boxRel G U t p q M z e.1 e.2)
      have hc : (F.filter (fun f => pre f=(z,v'))).card≤B.card := by
        apply card_le_card_of_injOn (fun f => (f (.inr none),fun j => f (.inr (some j))))
        · intro f hf'
          obtain ⟨hf',he⟩ := mem_filter.mp hf'
          have hez : f (.inl none)=z := congrArg Prod.fst he
          have hev : (fun j => f (.inl (some j)))=v' := congrArg Prod.snd he
          refine mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hm f hf' _,?_⟩,?_⟩,
            (mem_filter.mp hf').2,?_⟩
          · rw [←hez]
            exact f.toHom.map_adj rfl
          · apply Fintype.mem_piFinset.mpr
            intro j
            refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←congrFun hev j]
            exact f.toHom.map_adj rfl
          · intro j
            rw [←hez]
            exact f.injective.ne Sum.inr_ne_inl
        · intro f hf' f' hf'' he
          have hp := (mem_filter.mp hf').2.trans (mem_filter.mp hf'').2.symm
          have hz : f (.inl none)=f' (.inl none) := congrArg Prod.fst hp
          have hv : (fun j => f (.inl (some j)))=(fun j => f' (.inl (some j))) := congrArg Prod.snd hp
          have hr := Prod.mk.inj he
          apply Copy.ext
          rintro (a|r)
          · cases a with
            | none => exact hz
            | some j => exact congrFun hv j
          · cases r with
            | none => exact hr.1
            | some j => exact congrFun hr.2 j
      exact (show _≤(B.card:ℝ) by exact_mod_cast hc).trans
        (box_bound G U t p q M ht hp hq hM hf z v' hD (hdeg z hz)
          (fun j => hdeg _ (mem_filter.mp (Fintype.mem_piFinset.mp hv' j)).1)))
  have hh := mul_le_mul_of_nonneg_right (branchCores_bound G U q (by linarith) hdeg)
    (reverseBoxBound_nonneg p q M (D := D) (by linarith))
  exact hcount.trans (hh.trans_eq (by ring))



end Erdos571.FanSpider.Sharp

/-! Fan copy bounds with nonredundant pin counts. -/
namespace Erdos571.FanSpider.Sharp
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

abbrev GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (f : (template p q).Copy G) : Prop :=
  ControlledCopy G U t p q (threshold t p q M) f

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hf : (graph p q M).Free G)
    (F : Finset ((template p q).Copy G)) (hg : ∀f∈F, GoodCopy G U t p q M f) :
    (F.card:ℝ)≤(M*(p+p*q+1)*((p+p*q+1)*threshold t p q M^p):ℕ)*(U.card:ℝ)^(p*q+1) :=
  controlled_good_count G U t p q (threshold t p q M) M
    (threshold_ge_power t p q M) (threshold_pos t p q M ht) hf F hg

lemma rich_subtree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (b : Branch p q) (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))) :
    (F.card:ℝ)≤U.card*D^(p+2*p*q-q)*reverseBoxBound p q M D := by
  classical
  have hb := ConnectedCopyBound.copy_restriction_bound (template p q) (connected p q) (ShortSpider.template q)
    (subCopy b) G U (by linarith) hdeg F (richBranches G U t p q M) hm (by
      intro f hf
      exact mem_filter.mpr ⟨(TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hm f hf _),hr f hf⟩)
  rw [card_vertex p q] at hb
  simp only [Fintype.card_sum,Fintype.card_option,Fintype.card_fin] at hb
  have he : p+2*p*q+2-(q+1+(q+1))=p+2*p*q-2*q := by omega
  rw [he] at hb
  have hh := mul_le_mul_of_nonneg_right (richBranches_bound G U t p q M ht hp hq hM hf hD hdeg)
    (show 0≤D^(p+2*p*q-2*q) by positivity)
  have hpq : q≤p*q := by simpa using Nat.mul_le_mul_right q hp
  have hmul : D^q*D^(p+2*p*q-2*q)=D^(p+2*p*q-q) := by
    rw [←pow_add]
    congr 1
    simp only [Nat.mul_assoc]
    omega
  exact hb.trans (hh.trans_eq (by
    calc
      _ = U.card*(D^q*D^(p+2*p*q-2*q))*reverseBoxBound p q M D := by ring
      _ = _ := by rw [hmul]))

theorem all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ)≤(M*(p+p*q+1)*((p+p*q+1)*threshold t p q M^p):ℕ)*(U.card:ℝ)^(p*q+1)+
      ((p+2*p*q+2:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q-1)+
      (p+p*q:ℕ)*U.card*D^(p+2*p*q-q)*reverseBoxBound p q M D := by
  classical
  let A := F.filter (GoodCopy G U t p q M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light (template p q) G U t f)
  let C (b : Branch p q) := F.filter (fun f => Rich G U t p q M
    (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j)))))
  have hs : F⊆A∪B∪univ.biUnion C := by
    intro f hf
    by_cases hl : ConnectedCopyBound.Light (template p q) G U t f
    swap
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩))
    by_cases hb : ∀b : Branch p q, ¬Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hf,hm f hf,hl,fun b => le_of_not_gt (hb b)⟩))
    · simp only [not_forall,not_not] at hb
      obtain ⟨b,hb⟩ := hb
      exact mem_union_right _ (mem_biUnion.mpr ⟨b,mem_univ _,mem_filter.mpr ⟨hf,hb⟩⟩)
  have hA := good_count G U t p q M ht hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card:ℝ)≤((p+2*p*q+2:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q-1) := by
    have h := ConnectedCopyBound.nonlight_bound (template p q) (connected p q) G U t (by linarith) hdeg B
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    simpa only [card_vertex p q,show p+2*p*q+2-3=p+2*p*q-1 by omega,mul_assoc] using h
  have hC : ((univ.biUnion C).card:ℝ)≤
      (p+p*q:ℕ)*U.card*D^(p+2*p*q-q)*reverseBoxBound p q M D := by
    have hc : ((univ.biUnion C).card:ℝ)≤∑b : Branch p q, ((C b).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun b hb => rich_subtree_count G U t p q M ht hp hq hM hf hD hdeg b (C b)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul] at hh
    exact hc.trans (hh.trans_eq (by ring))
  have hc := (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  have hc' : (F.card:ℝ)≤A.card+B.card+(univ.biUnion C).card := by exact_mod_cast hc
  linarith


end Erdos571.FanSpider.Sharp

/-! Tightening the fan multiplicity exponent to its number of nonroots. -/
namespace Erdos571.FanSpider.Sharp

lemma threshold_mul_bound (t T p q M : ℕ) (hM : 1≤M) (ht : t≤T*M) :
    threshold t p q M≤threshold T p q 1*M^(q+1) := by
  have hpre : p*q+1+M+(q+1)*M*p≤(p*q+1+1+(q+1)*1*p)*M := by
    have := Nat.le_mul_of_pos_right (p*q+1) (show 0<M by omega)
    nlinarith
  have hcoef : t+(p*q+1+M+(q+1)*M*p)*(q+1)≤(T+(p*q+1+1+(q+1)*1*p)*(q+1))*M := by
    have hh := Nat.mul_le_mul_right (q+1) hpre
    nlinarith
  have hpow : t^q≤T^q*M^q := by simpa only [mul_pow] using Nat.pow_le_pow_left ht q
  unfold threshold
  exact (Nat.mul_le_mul hcoef hpow).trans_eq (by rw [pow_succ]; ring)

noncomputable def degreeBase (p q M K : ℕ) : ℝ :=
  2*4^(p+2*p*q+1)*(M*(p+p*q+1)*((p+p*q+1)*threshold (heavyThreshold p q M K) p q M^p):ℕ)

lemma degreeBase_mul_bound (p q M K : ℕ) (hM : 1≤M) :
    degreeBase p q M K≤degreeBase p q 1 K*(M:ℝ)^(p+p*q+1) := by
  have hc := threshold_mul_bound (heavyThreshold p q M K) (heavyThreshold p q 1 K) p q M hM
    (heavyThreshold_mul_bound p q M K hM)
  have hh : M*(p+p*q+1)*((p+p*q+1)*threshold (heavyThreshold p q M K) p q M^p) ≤
      ((p+p*q+1)*((p+p*q+1)*threshold (heavyThreshold p q 1 K) p q 1^p))*M^(p+p*q+1) := by
    have h := Nat.mul_le_mul_left (M*(p+p*q+1)*(p+p*q+1)) (Nat.pow_le_pow_left hc p)
    rw [mul_pow,←pow_mul] at h
    calc
      _ ≤ (M*(p+p*q+1)*(p+p*q+1))*(threshold (heavyThreshold p q 1 K) p q 1^p*M^((q+1)*p)) := by
        simpa only [Nat.mul_assoc] using h
      _ = _ := by rw [show p+p*q+1=(q+1)*p+1 by ring,pow_succ]; ring
  unfold degreeBase
  have hhr : (M*(p+p*q+1)*((p+p*q+1)*threshold (heavyThreshold p q M K) p q M^p):ℕ) ≤
      (((p+p*q+1)*((p+p*q+1)*threshold (heavyThreshold p q 1 K) p q 1^p):ℕ):ℝ)*(M:ℝ)^(p+p*q+1) := by
    exact_mod_cast hh
  have h := mul_le_mul_of_nonneg_left hhr (show 0≤(2:ℝ)*4^(p+2*p*q+1) by positivity)
  simpa only [one_mul,mul_assoc] using h

end Erdos571.FanSpider.Sharp

/-! A homogeneous fan bound with the nonroot-count multiplicity exponent. -/
namespace Erdos571.FanSpider.Sharp
open Finset SimpleGraph DensityRegularization ProjectionHeavy

lemma large_degree_power {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (p q M K : ℕ) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 0<d) (hdlarge : 4*(p+2*p*q+3:ℕ)≤d)
    (herr : reverse_countError p q M K (Q*d)≤(d/4)^(p+2*p*q+1)/2) (hK : 1≤K)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) :
    d^(p+2*p*q+1)≤degreeBase p q M K*(U.card:ℝ)^(p*q) := by
  classical
  have hn : (0:ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0≤Q*d := by positivity
  let F := TreeCopiesIn.copies (template p q) G U
  have hl : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤F.card := by
    have hh := TreeCopiesIn.lower (template p q) (isTree p q) G U (d := d) (by
      simp only [card_vertex p q,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat]
      push_cast at hdlarge
      linarith)
      (fun v hv => (hdeg v hv).1)
    simpa only [card_vertex p q,Nat.add_sub_cancel] using hh
  have hd1 : 1≤d := (show (1:ℝ)≤4*(p+2*p*q+3:ℕ) by norm_cast; omega).trans hdlarge
  have hD1 : 1≤Q*d := by nlinarith
  have ht : 1≤heavyThreshold p q M K := by
    have hpos : 0<heavyThreshold p q M K := by
      dsimp [heavyThreshold,AnchoredArms.heavyThreshold,AnchoredArms.vertexCount]
      positivity
    omega
  have hu := all_count G U (heavyThreshold p q M K) p q M ht hp hq hM hf hD1
    (fun v hv => (hdeg v hv).2) F (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have hbad := badPairs_sum_bound G g hg U p q M K hK hf hD (fun v hv => (hdeg v hv).2)
  have hb := mul_le_mul_of_nonneg_right hbad (show 0≤(((p+2*p*q+2:ℕ):ℝ))^3*(Q*d)^(p+2*p*q-1) by positivity)
  let C : ℝ := (M*(p+p*q+1)*((p+p*q+1)*threshold (heavyThreshold p q M K) p q M^p):ℕ)
  have hc : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤C*(U.card:ℝ)^(p*q+1)+U.card*reverse_countError p q M K (Q*d) := by
    dsimp [C,reverse_countError]
    nlinarith
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (U.card:ℝ)*(d/4)^(p+2*p*q+1)≤2*C*(U.card:ℝ)^(p*q+1) := by linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0≤(4:ℝ)^(p+2*p*q+1) by positivity)
  have heq : (U.card:ℝ)*(d/4)^(p+2*p*q+1)*4^(p+2*p*q+1)=U.card*d^(p+2*p*q+1) := by
    rw [div_pow]; field_simp
  rw [heq,pow_succ (U.card:ℝ) (p*q)] at hm'
  have hpower : d^(p+2*p*q+1)≤degreeBase p q M K*(U.card:ℝ)^(p*q) := by
    apply (mul_le_mul_iff_left₀ hn).mp
    dsimp [degreeBase]
    dsimp [C] at hm'
    nlinarith
  exact hpower

theorem exists_uniform_power_bound (p q : ℕ) (hp : 1≤p) (hq : 1≤q)
    (Q : ℝ) (hQ : 1≤Q) :
    ∃C : ℝ, 0≤C ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧
      ∀M : ℕ, 1≤M → ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (U : Finset W), U.Nonempty →
        (graph p q M).Free G → ∀g : W → Bool, (∀{u v}, G.Adj u v → g u≠g v) →
        ∀d : ℝ, L*M≤d →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          d^(p+2*p*q+1)≤C*(M:ℝ)^(p+p*q+1)*(U.card:ℝ)^(p*q) := by
  obtain ⟨K,hK,L,hLs,herr⟩ := exists_reverse_uniform_threshold p q hp Q hQ
  refine ⟨degreeBase p q 1 K,by unfold degreeBase; positivity,L,hLs,?_⟩
  intro M hM W _ _ G _ U hU hf g hg d hd hdeg
  have hM1 : (1:ℝ)≤M := by exact_mod_cast hM
  have hL0 : 0≤L := le_trans (by positivity) hLs
  have hdlarge : (4*(p+2*p*q+3:ℕ):ℝ)≤d := hLs.trans (by nlinarith)
  have hdpos : 0<d := lt_of_lt_of_le (by positivity) hdlarge
  have hh := large_degree_power G U hU p q M K hp hq hM hf g hg hQ hdpos hdlarge
    (herr M hM d hd) hK hdeg
  exact hh.trans (mul_le_mul_of_nonneg_right (degreeBase_mul_bound p q M K hM) (by positivity))

end Erdos571.FanSpider.Sharp

/-! The verified quantitative gain, and its exact parameters for the 3,3 fan. -/
namespace Erdos571.FanSpider.Sharp
open Finset SimpleGraph DensityRegularization

/-- A uniform sufficient condition for an actual homogeneous fan power,
not just a homomorphism or a collection of overlapping copies. -/
theorem exists_uniform_containment_threshold (p q : ℕ) (hp : 1≤p) (hq : 1≤q)
    (Q : ℝ) (hQ : 1≤Q) :
    ∃C : ℝ, 0≤C ∧ ∃L : ℝ, 4*(p+2*p*q+3:ℕ)≤L ∧
      ∀M : ℕ, 1≤M → ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (U : Finset W), U.Nonempty →
        ∀g : W → Bool, (∀{u v}, G.Adj u v → g u≠g v) → ∀d : ℝ,
          L*M≤d → C*(M:ℝ)^(p+p*q+1)*(U.card:ℝ)^(p*q)<d^(p+2*p*q+1) →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          graph p q M ⊑ G := by
  obtain ⟨C,hC,L,hL,hbound⟩ := exists_uniform_power_bound p q hp hq Q hQ
  refine ⟨C,hC,L,hL,?_⟩
  intro M hM W _ _ G _ U hU g hg d hd hstrict hdeg
  by_contra hf
  exact (not_lt_of_ge (hbound M hM W inferInstance inferInstance G inferInstance U hU hf g hg d hd hdeg)) hstrict

/-- This is a genuine power bound with constants independent of `M`.
The exponent nine is still too costly for the proposed mixed-fan extension. -/
theorem three_three_uniform_bound (Q : ℝ) (hQ : 1≤Q) :
    ∃C : ℝ, 0≤C ∧ ∃L : ℝ, 68≤L ∧
      ∀M : ℕ, 1≤M → ∀(W : Type) (_ : Fintype W) (_ : DecidableEq W)
        (G : SimpleGraph W) (_ : DecidableRel G.Adj) (U : Finset W), U.Nonempty →
        (graph 2 3 M).Free G → ∀g : W → Bool, (∀{u v}, G.Adj u v → g u≠g v) →
        ∀d : ℝ, L*M≤d →
          (∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) →
          d^15≤C*(M:ℝ)^9*(U.card:ℝ)^6 := by
  simpa only [show 2+2*3+1=9 by norm_num,
    show 2+2*2*3+3=17 by norm_num,show 2*3=6 by norm_num,
    show 2+2*2*3+1=15 by norm_num,Nat.cast_ofNat,show (4:ℝ)*17=68 by norm_num]
    using exists_uniform_power_bound 2 3 (by omega) (by omega) Q hQ

/-- Arithmetic diagnostic only: no graph nonrealizability is asserted. -/
lemma mixed_scale_arithmetic :
    (15:ℚ)*(7/17)-6=3/17 ∧ (3/17:ℚ)/9=1/51 ∧
      1-2*(7/17:ℚ)=3/17 ∧ (1/51:ℚ)<3/17 := by norm_num

end Erdos571.FanSpider.Sharp


/-! ## CenterArmFanTemplate -/


/-! A fan with one additional two-edge root arm at its center.
No extremal upper bound for this template is asserted here. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph

abbrev Core (p : ℕ) := FanSpider.Core p
abbrev Arms (p q : ℕ) := Option (FanSpider.Arms p q)
abbrev Interior (p q : ℕ) := Core p ⊕ Arms p q
abbrev Root (p q : ℕ) := Unit ⊕ Arms p q
abbrev Vertex (p q : ℕ) := Interior p q ⊕ Root p q

def attach {p q : ℕ} : Arms p q → Core p
  | none => .inl 0
  | some i => .inr i.1

def template (p q : ℕ) := AnchoredArms.template (KstUpper.Star p) (.inl 0) (@attach p q)
def graph (p q M : ℕ) := FullRootedPower.graph (template p q) M

def center (p q : ℕ) : Vertex p q := .inl (.inl (.inl 0))
def hub {p q : ℕ} (i : Fin p) : Vertex p q := .inl (.inl (.inr i))
def middle {p q : ℕ} (i : Fin p) (j : Fin q) : Vertex p q := .inl (.inr (some (i,j)))
def short (p q : ℕ) : Vertex p q := .inr (.inl ())
def root {p q : ℕ} (i : Fin p) (j : Fin q) : Vertex p q := .inr (.inr (some (i,j)))
def newMiddle (p q : ℕ) : Vertex p q := .inl (.inr none)
def newRoot (p q : ℕ) : Vertex p q := .inr (.inr none)

lemma adj_short (p q : ℕ) : (template p q).Adj (center p q) (short p q) := rfl
lemma adj_hub {p q : ℕ} (i : Fin p) : (template p q).Adj (center p q) (hub i) := by
  simp [template,AnchoredArms.template,center,hub,KstUpper.Star,completeBipartiteGraph]
lemma adj_middle {p q : ℕ} (i : Fin p) (j : Fin q) : (template p q).Adj (hub i) (middle i j) := rfl
lemma adj_root {p q : ℕ} (i : Fin p) (j : Fin q) : (template p q).Adj (middle i j) (root i j) := rfl
lemma adj_newMiddle (p q : ℕ) : (template p q).Adj (center p q) (newMiddle p q) := rfl
lemma adj_newRoot (p q : ℕ) : (template p q).Adj (newMiddle p q) (newRoot p q) := rfl

def rootAttach {p q : ℕ} : Root p q → Interior p q
  | .inl _ => .inl (.inl 0)
  | .inr i => .inr i

lemma leaf_eq (p q : ℕ) : template p q=
    LeafRooted.graph (LeafRooted.graph (KstUpper.Star p) (@attach p q)) (@rootAttach p q) := by
  ext u v
  rcases u with (a|i)|(x|i)
  all_goals rcases v with (b|j)|(y|j)
  all_goals simp only [template,AnchoredArms.template,LeafRooted.graph,RootedIncidence.graph,
    rootAttach,Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,Sum.inr_ne_inl]
  all_goals first | rfl | exact eq_comm

lemma isTree (p q : ℕ) : (template p q).IsTree := by
  rw [leaf_eq]
  exact LeafRooted.isTree _ (LeafRooted.isTree _ (KstUpper.star_tree p) _) _

lemma connected (p q : ℕ) : (template p q).Connected := (isTree p q).isConnected

lemma card_interior (p q : ℕ) : Fintype.card (Interior p q)=p+p*q+2 := by
  simp only [Fintype.card_sum,Fintype.card_fin,Fintype.card_option,Fintype.card_prod]; ring
lemma card_root (p q : ℕ) : Fintype.card (Root p q)=p*q+2 := by
  simp only [Fintype.card_sum,Fintype.card_unit,Fintype.card_option,Fintype.card_prod,Fintype.card_fin]; ring
lemma card_vertex (p q : ℕ) : Fintype.card (Vertex p q)=p+2*p*q+4 := by
  simp only [Fintype.card_sum,Fintype.card_fin,Fintype.card_unit,Fintype.card_option,Fintype.card_prod]; ring
lemma card_edges (p q : ℕ) : Nat.card (template p q).edgeSet=p+2*p*q+3 := by
  have h := (isTree_iff_connected_and_card.mp (isTree p q)).2
  change Nat.card (template p q).edgeSet+1=Nat.card (Vertex p q) at h
  rw [Nat.card_eq_fintype_card (α := Vertex p q),card_vertex] at h
  omega

def color {p q : ℕ} : Vertex p q → Bool
  | .inl (.inl a) => FanSpider.coreColor a
  | .inl (.inr i) => !(FanSpider.coreColor (attach i))
  | .inr (.inl _) => false
  | .inr (.inr i) => FanSpider.coreColor (attach i)

lemma color_proper (p q : ℕ) : ∀{u v}, (template p q).Adj u v → color u≠color v := by
  rintro ((a|i)|(x|i)) ((b|j)|(y|j)) h
  all_goals simp only [template,AnchoredArms.template] at h
  all_goals first
    | exact h.elim
    | exact FanSpider.coreColor_proper p h
    | subst a; simp [color,FanSpider.coreColor]
    | subst b; simp [color,FanSpider.coreColor]
    | subst i; simp [color]

lemma no_isolated (p q : ℕ) : ∀v, ∃w, (template p q).Adj v w := by
  rintro ((a|i)|(u|i))
  · cases a with
    | inl a =>
      have ha : a=0 := Subsingleton.elim _ _
      subst a
      exact ⟨short p q,adj_short p q⟩
    | inr j => exact ⟨center p q,(adj_hub j).symm⟩
  · cases i with
    | none => exact ⟨newRoot p q,adj_newRoot p q⟩
    | some i => exact ⟨root i.1 i.2,adj_root i.1 i.2⟩
  · cases u
    exact ⟨center p q,(adj_short p q).symm⟩
  · cases i with
    | none => exact ⟨newMiddle p q,(adj_newRoot p q).symm⟩
    | some i => exact ⟨middle i.1 i.2,(adj_root i.1 i.2).symm⟩

end Erdos571.CenterArmFan


/-! ## CenterArmFanMaps -/


/-! Restricting a center-arm fan copy to its original homogeneous fan. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph

abbrev nonrootMap {p q : ℕ} : FanSpider.Interior p q → Interior p q := Sum.map id some
abbrev rootMap {p q : ℕ} : FanSpider.Root p q → Root p q := Sum.map id some

def oldCopy (p q : ℕ) : (FanSpider.template p q).Copy (template p q) where
  toHom :=
    { toFun := Sum.map nonrootMap rootMap
      map_rel' := by
        rintro ((a|i)|(u|i)) ((b|j)|(v|j)) h
        all_goals simpa only [FanSpider.template,template,AnchoredArms.template,Sum.map_inl,
          Sum.map_inr,nonrootMap,rootMap,id_eq,attach,Option.some.injEq] using h }
  injective' := by
    intro x y h
    change Sum.map nonrootMap rootMap x=Sum.map nonrootMap rootMap y at h
    rcases x with (a|i)|(u|i)
    all_goals rcases y with (b|j)|(v|j)
    all_goals simp only [Sum.map_inl,Sum.map_inr,nonrootMap,rootMap,id_eq,
      Sum.inl.injEq,Sum.inr.injEq,Sum.inl_ne_inr,Sum.inr_ne_inl,Option.some.injEq] at h
    all_goals first | exact h.elim | subst_vars; rfl

def subCopy {p q : ℕ} (b : FanSpider.Branch p q) : (ShortSpider.template q).Copy (template p q) :=
  (oldCopy p q).comp (FanSpider.subCopy b)

lemma old_newMiddle_ne {p q : ℕ} (v : FanSpider.Vertex p q) : oldCopy p q v≠newMiddle p q := by
  rcases v with (a|i)|(u|i) <;> simp [oldCopy,newMiddle]

lemma old_newRoot_ne {p q : ℕ} (v : FanSpider.Vertex p q) : oldCopy p q v≠newRoot p q := by
  rcases v with (a|i)|(u|i) <;> simp [oldCopy,newRoot]

end Erdos571.CenterArmFan


/-! ## RepeatedHeavyRoots -/


/-! Heavy-root layouts with repeated attachment labels and a single tree core. -/
namespace Erdos571.RepeatedHeavyRoots
open Finset SimpleGraph DensityRegularization
variable {A I R W : Type} [Fintype A] [Fintype I] [Fintype R] [Fintype W] [DecidableEq W]

def massCoefficient (A R : Type) [Fintype A] [Fintype R] : ℕ :=
  4*(Fintype.card A+1)+2*Fintype.card R

def vertexBound (A I R : Type) [Fintype A] [Fintype I] [Fintype R] : ℕ :=
  Fintype.card A+Fintype.card I+Fintype.card R

theorem exists_layout (K : SimpleGraph A) (hK : K.IsTree) (c : A → Bool)
    (hc : ∀{a b}, K.Adj a b → c a≠c b) (a₀ : A) (ha₀ : c a₀=true)
    (attach : I → A) (label : I → R) (hattach : ∀i, c (attach i)=false)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v)
    (U S : Finset W) (t D : ℕ) (ht : vertexBound A I R≤t)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (hSU : S⊆U) (hS : S.card≤D)
    (hSg : ∀s∈S, g s=false) (r : R ↪ W) (r₀ : R)
    (hrU : ∀j, r j∈U) (hrg : ∀j, g (r j)=false)
    (hheavy : ∀u∈S, ∀j, t≤(FourthMoment.common G U u (r j)).card)
    (hlarge : massCoefficient A R*D<t*S.card) :
    ∃f : A ↪ W, ∃m : I ↪ W,
      (∀a b, K.Adj a b → G.Adj (f a) (f b)) ∧
      (∀a, c a=true → G.Adj (f a) (r r₀)) ∧
      (∀i, G.Adj (f (attach i)) (m i) ∧ G.Adj (m i) (r (label i))) ∧
      (∀a i, f a≠m i) ∧ (∀a j, f a≠r j) ∧ (∀i j, m i≠r j) := by
  classical
  let Y := neighbors G U (r r₀)
  have hY : Y.card≤D := hdeg _ (hrU _)
  have hYg (y) (hy : y∈Y) : g y=true := by
    have h := hg (mem_filter.mp hy).2
    have hr := hrg r₀
    cases hgy : g y <;> simp_all
  let E := (S×ˢY).filter (fun p => G.Adj p.1 p.2)
  have hE : E⊆arcs G U := by
    intro e he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨hSU hs,(mem_filter.mp hy).1,ha⟩
  have hl := DirectedDegreeBounds.left G U E hE D hdeg
  have hh := DirectedDegreeBounds.right G U E hE D hdeg
  have hcount : t*S.card≤E.card := by
    rw [rectangle_card]
    have hC (u : W) : neighbors G Y u=FourthMoment.common G U u (r r₀) := by
      ext v
      simp only [neighbors,Y,FourthMoment.common,mem_filter]
      tauto
    simp_rw [hC]
    exact (show t*S.card=∑_u∈S,t by simp [mul_comm]).trans_le
      (sum_le_sum (fun u hu => hheavy u hu r₀))
  let Z := univ.image r
  have hZ : Z.card=Fintype.card R := by
    simp [Z,card_image_of_injective _ r.injective]
  let E' := CherryPacking.avoid E Z
  let U' := (S∪Y)\Z
  have hU' : U'.card≤2*D := by
    have h1 := card_le_card (sdiff_subset (s:=S∪Y) (t:=Z))
    have h2 := card_union_le S Y
    dsimp [U']
    omega
  have hrem := CherryPacking.remove_bound E Z D hl hh
  have hcard : 4*(Fintype.card A+1)*D<E'.card := by
    change E.card≤E'.card+2*Z.card*D at hrem
    rw [hZ] at hrem
    dsimp [massCoefficient] at hlarge
    nlinarith
  have hE' : E'⊆arcs G U' := by
    intro e he
    obtain ⟨he,havoid⟩ := mem_filter.mp he
    obtain ⟨he,ha⟩ := mem_filter.mp he
    obtain ⟨hs,hy⟩ := mem_product.mp he
    exact mem_arcs.mpr ⟨mem_sdiff.mpr ⟨mem_union_left _ hs,havoid.1⟩,
      mem_sdiff.mpr ⟨mem_union_right _ hy,havoid.2⟩,ha⟩
  have hmass : 2*(Fintype.card A+1)*U'.card<(arcs G U').card := by
    have h1 := card_le_card hE'
    have h2 := Nat.mul_le_mul_left (2*(Fintype.card A+1)) hU'
    nlinarith
  obtain ⟨fs,hfs,hdis⟩ := ColoredTreePacking.pack_of_arcs K hK c hc a₀ ha₀ G g hg U' 1 (by
    simpa only [one_mul] using hmass)
  let f : A ↪ W := (fs 0).toEmbedding
  have hcore (a : A) : f a∈U' ∧ g (f a)=c a := hfs 0 a
  have hcavoid (a : A) : f a∉Z := (mem_sdiff.mp (hcore a).1).2
  have hcS (i : I) : f (attach i)∈S := by
    obtain hs|hy := mem_union.mp (mem_sdiff.mp (hcore (attach i)).1).1
    · exact hs
    · have h := hYg _ hy
      have h' := (hcore (attach i)).2
      rw [hattach] at h'
      simp_all
  have hcY (a : A) (ha : c a=true) : f a∈Y := by
    obtain hs|hy := mem_union.mp (mem_sdiff.mp (hcore a).1).1
    · have h := hSg _ hs
      have h' := (hcore a).2
      rw [ha] at h'
      simp_all
    · exact hy
  have hrZ (j : R) : r j∈Z := mem_image.mpr ⟨j,mem_univ _,rfl⟩
  let Z' := (univ.image f) ∪ Z
  have hZ' : Z'.card≤Fintype.card A+Fintype.card R := by
    have h1 := card_union_le (univ.image f) Z
    have h2 := card_image_le (s := univ) (f := f)
    simp only [card_univ] at h2
    dsimp [Z']
    omega
  let F (i : I) := FourthMoment.common G U (f (attach i)) (r (label i))
  obtain ⟨m,hm,hmF⟩ := ShortSpider.select_avoiding F Z' (by
    intro i
    have h := hheavy _ (hcS i) (label i)
    change t≤(F i).card at h
    dsimp [vertexBound] at ht
    omega)
  refine ⟨f,⟨m,hm⟩,?_,?_,?_,?_,?_,?_⟩
  · intro a b hab
    exact (fs 0).toHom.map_adj hab
  · intro a ha
    exact (mem_filter.mp (hcY a ha)).2.symm
  · intro i
    exact ⟨(mem_filter.mp (hmF i).1).2.1,(mem_filter.mp (hmF i).1).2.2.symm⟩
  · intro a i he
    exact (hmF i).2 (mem_union_left _ (mem_image.mpr ⟨a,mem_univ _,he⟩))
  · intro a j he
    exact hcavoid a (he.symm ▸ hrZ j)
  · intro i j he
    change m i=r j at he
    exact (hmF i).2 (mem_union_right _ (he.symm ▸ hrZ j))

end Erdos571.RepeatedHeavyRoots


/-! ## CenterArmFanHeavyCore -/


/-! A tree core for all petals, with the new opposite-side root shared. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph

abbrev JoinedCore (p M : ℕ) := Option (Fin M × (Fin 1 ⊕ Fin (p+1)))

def joinedGraph (p M : ℕ) : SimpleGraph (JoinedCore p M) :=
  TreeFan.graph (KstUpper.Star (p+1)) (.inr 0) M

lemma joined_tree (p M : ℕ) : (joinedGraph p M).IsTree :=
  TreeFan.isTree _ (KstUpper.star_tree (p+1)) _ M

def joinedColor {p M : ℕ} : JoinedCore p M → Bool
  | none => true
  | some (_, .inl _) => true
  | some (_, .inr _) => false

lemma joinedColor_proper (p M : ℕ) :
    ∀{u v}, (joinedGraph p M).Adj u v → joinedColor u≠joinedColor v := by
  rintro (_|⟨i,a|a⟩) (_|⟨j,b|b⟩) h
  all_goals simp [joinedGraph,TreeFan.graph,KstUpper.Star,completeBipartiteGraph,joinedColor] at h ⊢

abbrev OldArms (p q : ℕ) := FanSpider.Arms p q
abbrev OldRoot (p q : ℕ) := FanSpider.Root p q

def joinedAttach {p q M : ℕ} (i : Fin M × OldArms p q) : JoinedCore p M :=
  some (i.1,.inr i.2.1.succ)

def joinedCoreMap {p M : ℕ} : Fin M × Core p → JoinedCore p M
  | (i,.inl a) => some (i,.inl a)
  | (i,.inr j) => some (i,.inr j.succ)

def joinedNewMiddle {p M : ℕ} (i : Fin M) : JoinedCore p M := some (i,.inr 0)

lemma joinedCoreMap_injective (p M : ℕ) : Function.Injective (@joinedCoreMap p M) := by
  rintro ⟨i,a|a⟩ ⟨j,b|b⟩ h
  all_goals simp only [joinedCoreMap,Option.some.injEq,Prod.mk.injEq,Sum.inl.injEq,Sum.inr.injEq,
    Sum.inl_ne_inr,Sum.inr_ne_inl,Fin.succ_inj,and_false] at h
  all_goals first | exact h.elim | exact Prod.ext h.1 (congrArg Sum.inl h.2) | exact Prod.ext h.1 (congrArg Sum.inr h.2)

lemma contains_of_joined_layout {W : Type} [Fintype W]
    (G : SimpleGraph W) (p q M : ℕ) (f : JoinedCore p M ↪ W)
    (m : Fin M × OldArms p q ↪ W) (r : OldRoot p q ↪ W)
    (hf : ∀a b, (joinedGraph p M).Adj a b → G.Adj (f a) (f b))
    (hshort : ∀a, joinedColor a=true → G.Adj (f a) (r (.inl ())))
    (harm : ∀i, G.Adj (f (joinedAttach i)) (m i) ∧ G.Adj (m i) (r (.inr i.2)))
    (hfm : ∀a i, f a≠m i) (hfr : ∀a j, f a≠r j) (hmr : ∀i j, m i≠r j) :
    graph p q M ⊑ G := by
  let core : Fin M × Core p ↪ W :=
    ⟨fun i => f (joinedCoreMap i),f.injective.comp (joinedCoreMap_injective p M)⟩
  let mid : Fin M × Arms p q ↪ W :=
    { toFun := fun i => match i.2 with | none => f (joinedNewMiddle i.1) | some j => m (i.1,j)
      inj' := by
        rintro ⟨i,_|a⟩ ⟨j,_|b⟩ h
        · have hh := f.injective h
          simp only [joinedNewMiddle,Option.some.injEq,Prod.mk.injEq,and_true] at hh
          exact Prod.ext hh rfl
        · exact (hfm _ _ h).elim
        · exact (hfm _ _ h.symm).elim
        · have hh := m.injective h
          exact Prod.ext (Prod.mk.inj hh).1 (congrArg some (Prod.mk.inj hh).2) }
  let roots : Root p q ↪ W :=
    { toFun := fun x => match x with
        | .inl u => r (.inl u)
        | .inr none => f none
        | .inr (some j) => r (.inr j)
      inj' := by
        rintro (u|_|a) (v|_|b) h
        · exact congrArg Sum.inl (Sum.inl.inj (r.injective h))
        · exact (hfr _ _ h.symm).elim
        · exact (Sum.inl_ne_inr (r.injective h)).elim
        · exact (hfr _ _ h).elim
        · rfl
        · exact (hfr _ _ h).elim
        · exact (Sum.inr_ne_inl (r.injective h)).elim
        · exact (hfr _ _ h.symm).elim
        · exact congrArg (fun j => Sum.inr (some j)) (Sum.inr.inj (r.injective h)) }
  apply AnchoredArms.contains_of_layout (KstUpper.Star p) (.inl 0) attach G M core mid roots
  · rintro ⟨i,a|a⟩ ⟨j,_|b⟩ he
    · have h := f.injective he
      simp [joinedCoreMap,joinedNewMiddle] at h
    · exact hfm _ _ he
    · have h := f.injective he
      simp [joinedCoreMap,joinedNewMiddle] at h
    · exact hfm _ _ he
  · rintro ⟨i,a|a⟩ (u|_|b) he
    all_goals first
      | exact hfr _ _ he
      | have h := f.injective he; simp [joinedCoreMap] at h
  · rintro ⟨i,_|a⟩ (u|_|b) he
    all_goals first
      | exact hfr _ _ he
      | exact hmr _ _ he
      | exact hfm _ _ he.symm
      | have h := f.injective he; simp [joinedNewMiddle] at h
  · intro i a b hab
    apply hf
    cases a <;> cases b <;>
      simpa [joinedGraph,TreeFan.graph,joinedCoreMap,KstUpper.Star,completeBipartiteGraph] using hab
  · intro i
    exact hshort _ rfl
  · rintro i (_|j)
    · constructor
      · apply hf
        exact ⟨rfl,by simp [KstUpper.Star,completeBipartiteGraph]⟩
      · apply hf
        rfl
    · exact harm (i,j)

end Erdos571.CenterArmFan


/-! ## CenterArmFanLayout -/


/-! Direct injective layouts for center-arm-fan powers. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph
variable {W : Type} [Fintype W]

lemma contains_of_layout (G : SimpleGraph W) (p q M : ℕ)
    (u : Fin M ↪ W) (a : Fin M×Fin p ↪ W) (b : Fin M×OldArms p q ↪ W) (v : Fin M ↪ W) (r : Root p q ↪ W)
    (hua : ∀i j, u i≠a j) (hub : ∀i j, u i≠b j) (hur : ∀i j, u i≠r j)
    (huv : ∀i j, u i≠v j) (hav : ∀i j, a i≠v j) (hbv : ∀i j, b i≠v j) (hvr : ∀i j, v i≠r j)
    (hab : ∀i j, a i≠b j) (har : ∀i j, a i≠r j) (hbr : ∀i j, b i≠r j)
    (hshort : ∀i, G.Adj (u i) (r (.inl ())))
    (hfirst : ∀i j, G.Adj (u i) (a (i,j)))
    (hsecond : ∀i j k, G.Adj (a (i,j)) (b (i,(j,k))))
    (hroot : ∀i j k, G.Adj (b (i,(j,k))) (r (.inr (some (j,k)))))
    (hnew : ∀i, G.Adj (u i) (v i) ∧ G.Adj (v i) (r (.inr none))) : graph p q M ⊑ G := by
  let core : Fin M×Core p ↪ W :=
    { toFun := fun p => match p.2 with | .inl _ => u p.1 | .inr j => a (p.1,j)
      inj' := by
        rintro ⟨i,v|j⟩ ⟨i',v'|j'⟩ he
        · exact Prod.ext (u.injective he) (congrArg Sum.inl (Subsingleton.elim v v'))
        · exact (hua _ _ he).elim
        · exact (hua _ _ he.symm).elim
        · have hh := a.injective he
          have hii : i=i' := congrArg Prod.fst hh
          have hjj : j=j' := congrArg Prod.snd hh
          subst i'
          subst j'
          rfl }
  let mid : Fin M×Arms p q ↪ W :=
    { toFun := fun x => x.2.elim (v x.1) (fun j => b (x.1,j))
      inj' := by
        rintro ⟨i,_|a⟩ ⟨j,_|b'⟩ he
        · exact Prod.ext (v.injective he) rfl
        · exact (hbv _ _ he.symm).elim
        · exact (hbv _ _ he).elim
        · have h := b.injective he
          exact Prod.ext (Prod.mk.inj h).1 (congrArg some (Prod.mk.inj h).2) }
  apply AnchoredArms.contains_of_layout (KstUpper.Star p) (.inl 0) attach G M core mid r
  · rintro ⟨i,w|j⟩ ⟨k,_|l⟩ he
    · exact huv _ _ he
    · exact hub _ _ he
    · exact hav _ _ he
    · exact hab _ _ he
  · rintro ⟨i,v|j⟩ q he
    · exact hur _ _ he
    · exact har _ _ he
  · rintro ⟨i,_|j⟩ k he
    · exact hvr _ _ he
    · exact hbr _ _ he
  · rintro i (v|j) (v'|j') h
    · simp [KstUpper.Star,completeBipartiteGraph] at h
    · exact hfirst _ _
    · exact (hfirst _ _).symm
    · simp [KstUpper.Star,completeBipartiteGraph] at h
  · exact hshort
  · rintro i (_|j)
    · exact hnew i
    · exact ⟨hsecond i j.1 j.2,hroot i j.1 j.2⟩


end Erdos571.CenterArmFan


/-! ## CenterArmFanRichAssembly -/


/-! Rich short-spider branches plus disjoint new arms give the actual target power. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def richThreshold (t p q M : ℕ) : ℕ :=
  (t+(p*q+2+2*M+(q+1)*M*p)*(q+1))*t^q

noncomputable def Rich (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (u : W) (r : Fin q → W) : Prop :=
  richThreshold t p q M < (LongSpider.shortFiber G U t q u r).card

lemma rich_distinct {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t p q M : ℕ} {u : W} {r : Fin q → W} (h : Rich G U t p q M u r) :
    Function.Injective r ∧ ∀j, u≠r j := by
  obtain ⟨f,hf⟩ := card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) h)
  have hr := (LongSpider.mem_shortFiber G U t q u r f).mp hf
  constructor
  · intro j k he
    have hfk : f (.inr (some j))=f (.inr (some k)) := (hr.2.2 j).trans (he.trans (hr.2.2 k).symm)
    exact Option.some.inj (Sum.inr.inj (f.injective hfk))
  · intro j he
    have hfk : f (.inr none)=f (.inr (some j)) := hr.2.1.trans (he.trans (hr.2.2 j).symm)
    have hh := Sum.inr.inj (f.injective hfk)
    simp at hh

lemma contains_of_rich_extended_centers (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1≤t) (r : Root p q ↪ W) (u v : Fin M ↪ W)
    (hu : ∀i, G.Adj (u i) (r (.inl ()))) (hur : ∀i j, u i≠r j)
    (huv : ∀i j, u i≠v j) (hvr : ∀i j, v i≠r j)
    (hnew : ∀i, G.Adj (u i) (v i) ∧ G.Adj (v i) (r (.inr none)))
    (hrich : ∀i j, Rich G U t p q M (u i) (fun k => r (.inr (some (j,k))))) : graph p q M ⊑ G := by
  classical
  let Z := univ.image r ∪ univ.image u ∪ univ.image v
  have hZ : Z.card≤p*q+2+2*M := by
    have h := card_union_le (univ.image r) (univ.image u)
    have h' := card_union_le (univ.image r ∪ univ.image u) (univ.image v)
    have hr := card_image_le (s := univ) (f := r)
    have hu := card_image_le (s := univ) (f := u)
    have hv := card_image_le (s := univ) (f := v)
    simp only [card_univ,card_root,Fintype.card_fin] at hr hu hv
    dsimp [Z]
    omega
  obtain ⟨f,hf,hfZ,hfdis⟩ := DisjointChoice.exists_choice_finite (q+1) (((q+1)*t^q))
    RootedPacking.interior
    (fun z : Fin M×Fin p => LongSpider.shortFiber G U t q (u z.1) (fun k => r (.inr (some (z.2,k))))) Z
    (by intro z f hf; simpa only [Fintype.card_option,Fintype.card_fin] using (RootedPacking.interior_card f).le)
    (fun z w => FanSpider.Sharp.shortFiber_load G U t q (u z.1) (fun k => r (.inr (some (z.2,k)))) w)
    (by
      intro z
      have h := hrich z.1 z.2
      change richThreshold t p q M<_ at h
      simp only [Fintype.card_prod,Fintype.card_fin]
      apply lt_of_le_of_lt _ h
      dsimp [richThreshold]
      have hh := Nat.mul_le_mul_right ((q+1)*t^q)
        (show Z.card+(q+1)*(M*p) ≤ p*q+2+2*M+(q+1)*M*p by nlinarith)
      calc
        _ ≤ (p*q+2+2*M+(q+1)*M*p)*((q+1)*t^q) := hh
        _ = ((p*q+2+2*M+(q+1)*M*p)*(q+1))*t^q := by ring
        _ ≤ _ := Nat.mul_le_mul_right (t^q) (Nat.le_add_left _ _))
  let E := RootedPacking.packedInterior f hfdis
  let a : Fin M×Fin p ↪ W :=
    { toFun := fun z => E (z,none)
      inj' := fun _ _ h => congrArg Prod.fst (E.injective h) }
  let b : Fin M×OldArms p q ↪ W :=
    { toFun := fun z => E ((z.1,z.2.1),some z.2.2)
      inj' := by
        rintro ⟨i,j,k⟩ ⟨i',j',k'⟩ he
        have h := E.injective he
        have hij := (Prod.mk.inj h).1
        have hk := Option.some.inj (Prod.mk.inj h).2
        exact Prod.ext (Prod.mk.inj hij).1 (Prod.ext (Prod.mk.inj hij).2 hk) }
  have havoid (z : Fin M×Fin p) (v : Option (Fin q)) (w : W) (hw : w∈Z) : f z (.inl v)≠w := by
    intro he
    exact Finset.disjoint_left.mp (hfZ z) (RootedPacking.mem_interior (f z) v) (he.symm ▸ hw)
  have huZ (i : Fin M) : u i∈Z := mem_union_left _ (mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩))
  have hvZ (i : Fin M) : v i∈Z := mem_union_right _ (mem_image.mpr ⟨i,mem_univ _,rfl⟩)
  have hrZ (j : Root p q) : r j∈Z := mem_union_left _ (mem_union_left _ (mem_image.mpr ⟨j,mem_univ _,rfl⟩))
  have hroots (z : Fin M×Fin p) := (LongSpider.mem_shortFiber G U t q (u z.1) (fun k => r (.inr (some (z.2,k)))) (f z)).mp (hf z)
  apply contains_of_layout G p q M u a b v r
  · intro i z
    exact (havoid z none (u i) (huZ i)).symm
  · intro i z
    exact (havoid (z.1,z.2.1) (some z.2.2) (u i) (huZ i)).symm
  · exact hur
  · exact huv
  · intro z j
    exact havoid z none (v j) (hvZ j)
  · intro z j
    exact havoid (z.1,z.2.1) (some z.2.2) (v j) (hvZ j)
  · exact hvr
  · intro z z' he
    have h := E.injective he
    have hh := (Prod.mk.inj h).2
    simp at hh
  · intro z j
    exact havoid z none (r j) (hrZ j)
  · intro z j
    exact havoid (z.1,z.2.1) (some z.2.2) (r j) (hrZ j)
  · exact hu
  · intro i j
    change G.Adj (u i) (f (i,j) (.inl none))
    rw [←(hroots (i,j)).2.1]
    exact (f (i,j)).toHom.map_adj rfl
  · intro i j k
    exact (f (i,j)).toHom.map_adj trivial
  · intro i j k
    change G.Adj (f (i,j) (.inl (some k))) (r (.inr (some (j,k))))
    rw [←(hroots (i,j)).2.2 k]
    exact (f (i,j)).toHom.map_adj rfl


  · exact hnew

end Erdos571.CenterArmFan


/-! ## CenterArmFanGood -/


/-! Good center-arm fan copies and bounded rooted pin loads. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

lemma richThreshold_ge_power (t p q M : ℕ) : t^(q+1)≤richThreshold t p q M := by
  unfold richThreshold
  rw [pow_succ']
  exact Nat.mul_le_mul_right _ (Nat.le_add_right _ _)

structure GoodCopy (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (f : (template p q).Copy G) : Prop where
  mem : ∀v, f v∈U
  light : ConnectedCopyBound.Light (template p q) G U t f
  branch : ∀b : FanSpider.Branch p q, (LongSpider.shortFiber G U t q
    (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))).card≤richThreshold t p q M

lemma GoodCopy.old_good {G : SimpleGraph W} [DecidableRel G.Adj] {U : Finset W}
    {t p q M : ℕ} {f : (template p q).Copy G} (hf : GoodCopy G U t p q M f) :
    FanSpider.ControlledCopy G U t p q (richThreshold t p q M) (f.comp (oldCopy p q)) := by
  refine ⟨fun _ => hf.mem _,?_,hf.branch⟩
  intro u v w huv hvw huw
  exact hf.light _ _ _ ((oldCopy p q).toHom.map_adj huv) ((oldCopy p q).toHom.map_adj hvw)
    ((oldCopy p q).injective.ne huw)

lemma copy_eq_of_old_new {G : SimpleGraph W} {p q : ℕ} (f f' : (template p q).Copy G)
    (ho : f.comp (oldCopy p q)=f'.comp (oldCopy p q))
    (hm : f (newMiddle p q)=f' (newMiddle p q)) (hr : f (newRoot p q)=f' (newRoot p q)) : f=f' := by
  apply Copy.ext
  rintro ((a|_|i)|(u|_|i))
  · exact congrArg (fun g : (FanSpider.template p q).Copy G => g (.inl (.inl a))) ho
  · exact hm
  · exact congrArg (fun g : (FanSpider.template p q).Copy G => g (.inl (.inr i))) ho
  · exact congrArg (fun g : (FanSpider.template p q).Copy G => g (.inr (.inl u))) ho
  · exact hr
  · exact congrArg (fun g : (FanSpider.template p q).Copy G => g (.inr (.inr i))) ho

lemma old_fiber_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀a, f (.inr a)=r a)
    (ψ : (FanSpider.template p q).Copy G) (ho : ∀f∈F, f.comp (oldCopy p q)=ψ) : F.card≤t := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := FourthMoment.common G U (ψ (FanSpider.center p q)) (r (.inr none))
  have hcenter (f) (hf : f∈F) : f (center p q)=ψ (FanSpider.center p q) :=
    congrArg (fun g : (FanSpider.template p q).Copy G => g (FanSpider.center p q)) (ho f hf)
  have hC : C.card≤t := by
    have h := (hg f₀ hf₀).light (center p q) (newMiddle p q) (newRoot p q)
      (adj_newMiddle p q) (adj_newRoot p q) (by simp [center,newRoot])
    change (FourthMoment.common G U (f₀ (center p q)) (f₀ (.inr (.inr none)))).card<t at h
    rw [hcenter f₀ hf₀,hr f₀ hf₀] at h
    exact h.le
  apply le_trans _ hC
  apply card_le_card_of_injOn (fun f => f (newMiddle p q))
  · intro f hf
    refine mem_filter.mpr ⟨(hg f hf).mem _,?_,?_⟩
    · rw [←hcenter f hf]
      exact f.toHom.map_adj (adj_newMiddle p q)
    · rw [←hr f hf]
      exact f.toHom.map_adj (adj_newRoot p q).symm
  · intro f hf f' hf' he
    exact copy_eq_of_old_new f f' ((ho f hf).trans (ho f' hf').symm) he
      ((hr f hf (.inr none)).trans (hr f' hf' (.inr none)).symm)

lemma old_pin_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W) (a : FanSpider.Interior p q)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (.inl (nonrootMap a))=w) : F.card≤t*richThreshold t p q M^p := by
  classical
  let ev : (template p q).Copy G → (FanSpider.template p q).Copy G := fun f => f.comp (oldCopy p q)
  have hb := card_le_mul_card_image F t (f := ev) (by
    intro ψ hψ
    exact old_fiber_bound G U t p q M _ r
      (fun f hf => hg f (mem_filter.mp hf).1) (fun f hf => hr f (mem_filter.mp hf).1) ψ
      (fun f hf => (mem_filter.mp hf).2))
  apply hb.trans
  apply Nat.mul_le_mul_left
  apply FanSpider.controlled_pinned_count G U t p q (richThreshold t p q M)
    (richThreshold_ge_power t p q M) (F.image ev) (r ∘ rootMap) w a
  · intro ψ hψ
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
    exact (hg f hf).old_good
  · intro ψ hψ x
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
    exact hr f hf (rootMap x)
  · intro ψ hψ
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
    exact hw f hf

lemma new_middle_pin_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (newMiddle p q)=w) : F.card≤t*richThreshold t p q M^p := by
  classical
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨f₀,hf₀⟩ := hF
  let C := FourthMoment.common G U w (r (.inl ()))
  have hC : C.card≤t := by
    have h := (hg f₀ hf₀).light (newMiddle p q) (center p q) (short p q)
      (adj_newMiddle p q).symm (adj_short p q) (by simp [newMiddle,short])
    change (FourthMoment.common G U (f₀ (newMiddle p q)) (f₀ (.inr (.inl ())))).card<t at h
    rw [hw f₀ hf₀,hr f₀ hf₀] at h
    exact h.le
  let ev : (template p q).Copy G → W := fun f => f (center p q)
  have hsub : F.image ev⊆C := by
    intro u hu
    obtain ⟨f,hf,rfl⟩ := mem_image.mp hu
    refine mem_filter.mpr ⟨(hg f hf).mem _,?_,?_⟩
    · rw [←hw f hf]
      exact f.toHom.map_adj (adj_newMiddle p q).symm
    · rw [←hr f hf]
      exact f.toHom.map_adj (adj_short p q).symm
  have hb := card_le_mul_card_image F (richThreshold t p q M^p) (f := ev) (by
    intro u hu
    let F' := F.filter (fun f => ev f=u)
    let old := fun f : (template p q).Copy G => f.comp (oldCopy p q)
    have hinj : Set.InjOn old F' := by
      intro f hf f' hf' he
      exact copy_eq_of_old_new f f' he
        ((hw f (mem_filter.mp hf).1).trans (hw f' (mem_filter.mp hf').1).symm)
        ((hr f (mem_filter.mp hf).1 (.inr none)).trans (hr f' (mem_filter.mp hf').1 (.inr none)).symm)
    have hcard : F'.card=(F'.image old).card := (card_image_iff.mpr hinj).symm
    rw [hcard]
    apply FanSpider.controlled_center_count G U t p q (richThreshold t p q M) _ (r ∘ rootMap) u
    · intro ψ hψ
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
      exact (hg f (mem_filter.mp hf).1).old_good
    · intro ψ hψ x
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
      exact hr f (mem_filter.mp hf).1 (rootMap x)
    · intro ψ hψ
      obtain ⟨f,hf,rfl⟩ := mem_image.mp hψ
      exact (mem_filter.mp hf).2)
  exact (hb.trans (Nat.mul_le_mul_left _ ((card_le_card hsub).trans hC))).trans_eq (Nat.mul_comm _ _)

lemma pinned_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W) (w : W) (a : Interior p q)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x)
    (hw : ∀f∈F, f (.inl a)=w) : F.card≤t*richThreshold t p q M^p := by
  rcases a with a|_|a
  · exact old_pin_count G U t p q M F r w (.inl a) hg hr hw
  · exact new_middle_pin_count G U t p q M F r w hg hr hw
  · exact old_pin_count G U t p q M F r w (.inr a) hg hr hw

end Erdos571.CenterArmFan


/-! ## CenterArmFanGoodCount -/


namespace Erdos571.CenterArmFan
open Finset SimpleGraph
variable {W : Type} [Fintype W] [DecidableEq W]

def copyLoad (t p q M : ℕ) := (p+p*q+2)*(t*richThreshold t p q M^p+1)

lemma interior_load (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (F : Finset ((template p q).Copy G)) (r : Root p q → W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) (w : W) :
    (F.filter (fun f => w∈RootedPacking.interior f)).card≤copyLoad t p q M := by
  classical
  let A (a : Interior p q) := F.filter (fun f => f (.inl a)=w)
  have hs : F.filter (fun f => w∈RootedPacking.interior f)⊆univ.biUnion A := by
    intro f hf
    obtain ⟨hf,hw⟩ := mem_filter.mp hf
    simp only [RootedPacking.interior,mem_image,mem_univ,true_and] at hw
    obtain ⟨a,ha⟩ := hw
    exact mem_biUnion.mpr ⟨a,mem_univ _,mem_filter.mpr ⟨hf,ha⟩⟩
  calc
    _ ≤ (univ.biUnion A).card := card_le_card hs
    _ ≤ ∑a : Interior p q, (A a).card := card_biUnion_le
    _ ≤ ∑_a : Interior p q, (t*richThreshold t p q M^p+1) := sum_le_sum (fun a ha =>
      (pinned_count G U t p q M (A a) r w a (fun f hf => hg f (mem_filter.mp hf).1)
        (fun f hf => hr f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)).trans (Nat.le_succ _))
    _ = _ := by
      simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,Fintype.card_option,nsmul_eq_mul,Nat.cast_id]
      unfold copyLoad
      congr 1
      omega

lemma power_eq (p q M : ℕ) : RootedPacking.power (template p q) M=graph p q M := by
  ext u v
  cases u <;> cases v
  · rfl
  · rfl
  · rfl
  · simp [RootedPacking.power,graph,FullRootedPower.graph,template,AnchoredArms.template]

lemma rooted_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (hf : (graph p q M).Free G) (F : Finset ((template p q).Copy G)) (r : Root p q ↪ W)
    (hg : ∀f∈F, GoodCopy G U t p q M f) (hr : ∀f∈F, ∀x, f (.inr x)=r x) :
    F.card<M*(p+p*q+2)*copyLoad t p q M := by
  classical
  by_contra! hc
  have hB : 0<copyLoad t p q M := by dsimp [copyLoad]; positivity
  have hh := RootedPacking.power_contained_of_bounded_load F id r hr (copyLoad t p q M) M hB
    (interior_load G U t p q M F r hg hr) (by
      simpa only [Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,Fintype.card_option,show 1+p+(p*q+1)=p+p*q+2 by omega] using hc)
  rw [power_eq] at hh
  exact hf hh

lemma good_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t p q M : ℕ)
    (hf : (graph p q M).Free G) (F : Finset ((template p q).Copy G))
    (hg : ∀f∈F, GoodCopy G U t p q M f) :
    (F.card:ℝ)≤(M*(p+p*q+2)*copyLoad t p q M:ℕ)*(U.card:ℝ)^(p*q+2) := by
  have h := RootedFiberCount.bound (template p q) G U F (fun f hf r => (hg f hf).mem _)
    (B := (M*(p+p*q+2)*copyLoad t p q M:ℕ)) (by positivity) (by
      intro r F' hF' hr
      exact_mod_cast (rooted_count G U t p q M hf F' r (fun f hf => hg f (hF' hf)) hr).le)
  simpa only [Fintype.card_sum,Fintype.card_prod,Fintype.card_unit,Fintype.card_fin,Fintype.card_option,show 1+(p*q+1)=p*q+2 by omega] using h

end Erdos571.CenterArmFan


/-! ## CenterArmFanArmPairs -/


/-! Bounded loads for new arms with a fixed new root. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma arm_pairs_left_load (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (z x : W) (E : Finset (W×W))
    (hE : ∀e∈E, (e.2,x)∈ShortSpider.arms G U t z e.1) (w : W) :
    (E.filter (fun e => e.1=w)).card≤t := by
  classical
  let F := E.filter (fun e => e.1=w)
  change F.card≤t
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨e,he⟩ := hF
  have hw : e.1=w := (mem_filter.mp he).2
  have ht := (ShortSpider.mem_arms.mp (hE e (mem_filter.mp he).1)).2.2.2.2.2
  have hC : (FourthMoment.common G U w x).card<t := by
    rw [hw] at ht
    exact lt_of_not_ge (fun h => ht (Or.inr h))
  apply le_trans _ hC.le
  apply card_le_card_of_injOn Prod.snd
  · intro e he
    have ha := ShortSpider.mem_arms.mp (hE e (mem_filter.mp he).1)
    refine mem_filter.mpr ⟨ha.1,?_,ha.2.2.2.1.symm⟩
    rw [←(mem_filter.mp he).2]
    exact ha.2.2.1
  · intro e he e' he' hh
    exact Prod.ext ((mem_filter.mp he).2.trans (mem_filter.mp he').2.symm) hh

lemma arm_pairs_right_load (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) (z x : W) (E : Finset (W×W))
    (hEU : ∀e∈E, e.1∈U) (hEz : ∀e∈E, G.Adj z e.1)
    (hE : ∀e∈E, (e.2,x)∈ShortSpider.arms G U t z e.1) (w : W) :
    (E.filter (fun e => e.2=w)).card≤t := by
  classical
  let F := E.filter (fun e => e.2=w)
  change F.card≤t
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty]; omega
  obtain ⟨e,he⟩ := hF
  have hw : e.2=w := (mem_filter.mp he).2
  have ht := (ShortSpider.mem_arms.mp (hE e (mem_filter.mp he).1)).2.2.2.2.1
  have hC : (FourthMoment.common G U z w).card<t := by
    rw [hw] at ht
    exact lt_of_not_ge (fun h => ht (Or.inr h))
  apply le_trans _ hC.le
  apply card_le_card_of_injOn Prod.fst
  · intro e he
    have ha := ShortSpider.mem_arms.mp (hE e (mem_filter.mp he).1)
    refine mem_filter.mpr ⟨hEU e (mem_filter.mp he).1,hEz e (mem_filter.mp he).1,?_⟩
    rw [←(mem_filter.mp he).2]
    exact ha.2.2.1.symm
  · intro e he e' he' hh
    exact Prod.ext hh ((mem_filter.mp he).2.trans (mem_filter.mp he').2.symm)

lemma pair_foot_load (E : Finset (W×W)) (t : ℕ)
    (hl : ∀w, (E.filter (fun e => e.1=w)).card≤t)
    (hr : ∀w, (E.filter (fun e => e.2=w)).card≤t) (w : W) :
    (E.filter (fun e => w∈ThetaFour.foot e)).card≤2*t := by
  classical
  have hs : E.filter (fun e => w∈ThetaFour.foot e)⊆
      E.filter (fun e => e.1=w) ∪ E.filter (fun e => e.2=w) := by
    intro e he
    obtain ⟨he,hw⟩ := mem_filter.mp he
    simp only [ThetaFour.foot,mem_insert,mem_singleton] at hw
    rcases hw with hw|hw
    · exact mem_union_left _ (mem_filter.mpr ⟨he,hw.symm⟩)
    · exact mem_union_right _ (mem_filter.mpr ⟨he,hw.symm⟩)
  exact (card_le_card hs).trans ((card_union_le _ _).trans (by have := hl w; have := hr w; omega))

lemma rich_extended_pairs_bound (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t p q M : ℕ) (ht : 1≤t) (hf : (graph p q M).Free G)
    (r : Root p q ↪ W) (E : Finset (W×W))
    (hEU : ∀e∈E, e.1∈U) (hEz : ∀e∈E, G.Adj (r (.inl ())) e.1)
    (hE : ∀e∈E, (e.2,r (.inr none))∈ShortSpider.arms G U t (r (.inl ())) e.1)
    (hRich : ∀e∈E, ∀j : Fin p, Rich G U t p q M e.1 (fun k => r (.inr (some (j,k))))) :
    E.card≤(p*q+2+2*M)*(2*t) := by
  classical
  by_contra! hc
  let Z := univ.image r
  have hZ : Z.card≤p*q+2 := by
    simpa only [card_univ,card_root] using card_image_le (s := univ) (f := r)
  obtain ⟨f,hfE,hfZ,hfdis⟩ := DisjointChoice.exists_choice 2 (2*t) M ThetaFour.foot (fun _ => E) Z
    (fun _ _ _ => by exact card_le_two)
    (fun _ w => pair_foot_load E t
      (arm_pairs_left_load G U t _ _ E hE) (arm_pairs_right_load G U t _ _ E hEU hEz hE) w)
    (fun _ => lt_of_le_of_lt (Nat.mul_le_mul_right _ (by omega)) hc)
  have hne (i : Fin M) : (f i).1≠(f i).2 :=
    G.ne_of_adj (ShortSpider.mem_arms.mp (hE _ (hfE i))).2.2.1
  let u := PairPacking.first f hne hfdis
  let v := PairPacking.second f hne hfdis
  have hu (i : Fin M) : u i=(f i).1 := rfl
  have hv (i : Fin M) : v i=(f i).2 := rfl
  have havoid (i : Fin M) (w) (hw : w∈ThetaFour.foot (f i)) (j) : w≠r j := by
    intro he
    exact disjoint_left.mp (hfZ i) hw (he.symm ▸ mem_image.mpr ⟨j,mem_univ _,rfl⟩)
  apply hf
  apply contains_of_rich_extended_centers G U t p q M ht r u v
  · intro i
    exact (hEz _ (hfE i)).symm
  · intro i j
    exact havoid i _ (by simp [hu,ThetaFour.foot]) j
  · exact PairPacking.first_second_ne f hne hfdis
  · intro i j
    exact havoid i _ (by simp [hv,ThetaFour.foot]) j
  · intro i
    have h := ShortSpider.mem_arms.mp (hE _ (hfE i))
    exact ⟨h.2.2.1,h.2.2.2.1⟩
  · intro i j
    exact hRich _ (hfE i) j

end Erdos571.CenterArmFan


/-! ## CenterArmFanCommonRows -/


/-! A common rich-row bound obtained by averaging the new root. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def extendRoots {p q : ℕ} (r : OldRoot p q ↪ W) (x : W) (hx : ∀j, x≠r j) : Root p q ↪ W where
  toFun
    | .inl u => r (.inl u)
    | .inr none => x
    | .inr (some j) => r (.inr j)
  inj' := by
    rintro (u|_|a) (v|_|b) h
    · exact congrArg Sum.inl (Sum.inl.inj (r.injective h))
    · exact (hx _ h.symm).elim
    · exact (Sum.inl_ne_inr (r.injective h)).elim
    · exact (hx _ h).elim
    · rfl
    · exact (hx _ h).elim
    · exact (Sum.inr_ne_inl (r.injective h)).elim
    · exact (hx _ h.symm).elim
    · exact congrArg (fun j => Sum.inr (some j)) (Sum.inr.inj (r.injective h))

lemma common_rich_rows (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hf : (graph p q M).Free G)
    (r : OldRoot p q ↪ W) (F : Finset W) (hFU : F⊆U)
    (hz : ∀u∈F, G.Adj (r (.inl ())) u)
    (hRich : ∀u∈F, ∀j : Fin p, Rich G U t p q M u (fun k => r (.inr (j,k))))
    {H : ℝ} (hH : 0<H) (hlarge : 2*(p*q+1:ℕ)*t≤H)
    (hrow : ∀u∈F, H≤((ShortSpider.arms G U t (r (.inl ())) u).card:ℝ)) :
    (F.card:ℝ)≤2*((p*q+2+2*M)*(2*t):ℕ)*(U.card:ℝ)/H := by
  classical
  let B := (p*q+2+2*M)*(2*t)
  let Z := univ.image r
  have hZ : Z.card=p*q+1 := by
    simp [Z,card_image_of_injective _ r.injective,Fintype.card_sum,Fintype.card_prod,Nat.add_comm]
  let E (x : W) := (F×ˢU).filter (fun e => (e.2,x)∈ShortSpider.arms G U t (r (.inl ())) e.1)
  have hEU (x) (e) (he : e∈E x) : e.1∈U := hFU (mem_product.mp (mem_filter.mp he).1).1
  have hEz (x) (e) (he : e∈E x) : G.Adj (r (.inl ())) e.1 := hz _ (mem_product.mp (mem_filter.mp he).1).1
  have hEarm (x) (e) (he : e∈E x) : (e.2,x)∈ShortSpider.arms G U t (r (.inl ())) e.1 :=
    (mem_filter.mp he).2
  have hgood (x) (hx : x∉Z) : (E x).card≤B := by
    let r' := extendRoots r x (fun j he => hx (mem_image.mpr ⟨j,mem_univ _,he.symm⟩))
    apply rich_extended_pairs_bound G U t p q M ht hf r' (E x) (hEU x) (hEz x) (hEarm x)
    intro e he j
    exact hRich _ (mem_product.mp (mem_filter.mp he).1).1 j
  have hbad (x) : (E x).card≤F.card*t := by
    have h := card_le_mul_card_image (E x) t (f := Prod.fst)
      (fun w _ => arm_pairs_left_load G U t _ x (E x) (hEarm x) w)
    have hs : (E x).image Prod.fst⊆F := by
      intro u hu
      obtain ⟨e,he,rfl⟩ := mem_image.mp hu
      exact (mem_product.mp (mem_filter.mp he).1).1
    exact (h.trans (Nat.mul_le_mul_left t (card_le_card hs))).trans_eq (Nat.mul_comm _ _)
  have hsum : (∑x∈U, (E x).card)=∑u∈F, (ShortSpider.arms G U t (r (.inl ())) u).card := by
    simp only [E,card_filter,sum_product]
    rw [sum_comm]
    apply sum_congr rfl
    intro u hu
    rw [sum_comm]
    have he : (U×ˢU).filter (fun e => e∈ShortSpider.arms G U t (r (.inl ())) u)=
        ShortSpider.arms G U t (r (.inl ())) u := by
      ext e
      constructor
      · intro he
        exact (mem_filter.mp he).2
      · intro he
        have hh := ShortSpider.mem_arms.mp he
        exact mem_filter.mpr ⟨mem_product.mpr ⟨hh.1,hh.2.1⟩,he⟩
    have hc := congrArg Finset.card he
    simpa only [card_filter,sum_product] using hc
  have htotal : (∑x∈U, (E x).card)≤U.card*B+Z.card*(F.card*t) := by
    calc
      _ ≤ ∑x∈U, (B+if x∈Z then F.card*t else 0) := sum_le_sum (fun x hx => by
        by_cases hxZ : x∈Z
        · simp only [if_pos hxZ]
          exact (hbad x).trans (Nat.le_add_left _ _)
        · simp only [if_neg hxZ,add_zero]
          exact hgood x hxZ)
      _ = U.card*B+(U.filter (fun x => x∈Z)).card*(F.card*t) := by
        have he : U.filter (fun x => x∈Z)=U∩Z := by ext x; simp
        rw [sum_add_distrib,he]
        simp
      _ ≤ _ := Nat.add_le_add_left (Nat.mul_le_mul_right _ (card_le_card (by
        intro x hx; exact (mem_filter.mp hx).2))) _
  have hl : H*(F.card:ℝ)≤∑u∈F, ((ShortSpider.arms G U t (r (.inl ())) u).card:ℝ) := by
    simpa only [sum_const,nsmul_eq_mul,mul_comm] using sum_le_sum (fun u hu => hrow u hu)
  have hu : (∑u∈F, ((ShortSpider.arms G U t (r (.inl ())) u).card:ℝ))≤
      (U.card:ℝ)*B+(p*q+1:ℕ)*((F.card:ℝ)*t) := by
    rw [hsum,hZ] at htotal
    exact_mod_cast htotal
  apply (le_div_iff₀ hH).mpr
  have hscale := mul_le_mul_of_nonneg_right hlarge (Nat.cast_nonneg F.card : (0:ℝ)≤F.card)
  dsimp [B] at hu ⊢
  nlinarith

end Erdos571.CenterArmFan


/-! ## TupleBoxCommonKst -/


/-! Tuple-box KST from a real-valued common-row bound. -/
namespace Erdos571.TupleBoxCommonKst
open Finset
variable {A I W : Type} [Fintype A] [Fintype I] [DecidableEq A]
  [DecidableEq I] [DecidableEq W]

lemma dimension_bound (X : I → Finset W) (P : A → (I → W) → Prop) [DecidableRel P]
    (p D : ℕ) (hp : 1≤p) (hX : ∀i, (X i).card≤D) {T : ℝ} (hT0 : 0≤T)
    (hcommon : ∀f : Fin p ↪ (Fintype.piFinset X),
      (∀i j, i≠j → Disjoint (TupleBoxPacking.foot (f i).val) (TupleBoxPacking.foot (f j).val)) →
      ((univ.filter (fun a : A => ∀i, P a (f i).val)).card:ℝ)≤T) :
    (((univ×ˢFintype.piFinset X).filter (fun e => P e.1 e.2)).card:ℝ) ≤
      2*(T*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*(Fintype.piFinset X).card +
      2*p*Fintype.card A*((Fintype.card I:ℝ)^2*(D:ℝ)^(Fintype.card I-1)+1) := by
  classical
  let B := Fintype.piFinset X
  obtain ⟨c,hc⟩ := DisjointTupleColoring.box_coloring X D hX
  let Q : A → B → Prop := fun a b => P a b.val
  have hT (k) (f : Fin p ↪ {b : B // c b=k}) :
      (univ.filter (fun a => ∀i, Q a (f i).val)).card ≤ ⌊T⌋₊ := by
    apply Nat.le_floor
    let f' : Fin p ↪ B := f.trans (Function.Embedding.subtype _)
    exact hcommon f' (fun i j hij => hc (f i).val (f j).val
      (fun he => hij (f.injective (Subtype.ext he))) ((f i).property.trans (f j).property.symm))
  have hb := ColoredReverseKst.bound Q c p ⌊T⌋₊ hp hT
  have he : (univ.filter (fun e : A×B => Q e.1 e.2)).card =
      ((univ×ˢB).filter (fun e => P e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1,e.2.val))
    · intro e he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,e.2.property⟩,(mem_filter.mp he).2⟩
    · intro e he f hf hef
      exact Prod.ext (Prod.mk.inj hef).1 (Subtype.ext (Prod.mk.inj hef).2)
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(e.1,⟨e.2,(mem_product.mp he).2⟩),mem_filter.mpr ⟨mem_univ _,hP⟩,rfl⟩
  have hfirst : (((univ×ˢFintype.piFinset X).filter (fun e => P e.1 e.2)).card:ℝ) ≤
      2*((⌊T⌋₊:ℝ)*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*(Fintype.piFinset X).card +
      2*p*Fintype.card A*((Fintype.card I:ℝ)^2*(D:ℝ)^(Fintype.card I-1)+1) := by
    simpa only [he,Fintype.card_coe,Fintype.card_fin,Nat.cast_add,Nat.cast_mul,
      Nat.cast_pow,Nat.cast_one] using hb
  apply hfirst.trans
  gcongr
  exact Nat.floor_le hT0

lemma bound [Nonempty I] (X : I → Finset W) (P : A → (I → W) → Prop) [DecidableRel P]
    (p : ℕ) (hp : 1≤p) {D T : ℝ} (hD : 1≤D) (hT0 : 0≤T)
    (hA : (Fintype.card A:ℝ)≤D) (hX : ∀i, ((X i).card:ℝ)≤D)
    (hcommon : ∀f : Fin p ↪ (Fintype.piFinset X),
      (∀i j, i≠j → Disjoint (TupleBoxPacking.foot (f i).val) (TupleBoxPacking.foot (f j).val)) →
      ((univ.filter (fun a : A => ∀i, P a (f i).val)).card:ℝ)≤T) :
    (((univ×ˢFintype.piFinset X).filter (fun e => P e.1 e.2)).card:ℝ)≤
      2*T^((p:ℝ)⁻¹)*D^((Fintype.card I:ℝ)+1-1/(p:ℝ))+
      2*p*((Fintype.card I:ℝ)^2+1)*D^(Fintype.card I) := by
  classical
  let q := Fintype.card I
  have hq : 1 ≤ q := Fintype.card_pos
  have hD0 : 0 ≤ D := by linarith
  have hDp : 0 < D := by linarith
  have hXn : ∀i, (X i).card ≤ ⌊D⌋₊ := fun i => Nat.le_floor (hX i)
  have hB : ((Fintype.piFinset X).card:ℝ) ≤ D^q := by
    exact (show ((Fintype.piFinset X).card:ℝ) ≤ (⌊D⌋₊:ℝ)^q by
      exact_mod_cast TupleBoxPacking.box_card X ⌊D⌋₊ hXn).trans
      (pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le hD0) q)
  have hroot : (T*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹) ≤
      (T*D^(p-1))^((p:ℝ)⁻¹) := by
    apply Real.rpow_le_rpow (by positivity) _ (by positivity)
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg _) hA _) hT0
  have hmain : 2*(T*(Fintype.card A:ℝ)^(p-1))^((p:ℝ)⁻¹)*(Fintype.piFinset X).card ≤
      2*T^((p:ℝ)⁻¹)*D^((q:ℝ)+1-1/(p:ℝ)) := by
    calc
      _ ≤ 2*(T*D^(p-1))^((p:ℝ)⁻¹)*D^q := by gcongr
      _ = _ := by
        rw [Real.mul_rpow hT0 (pow_nonneg hD0 _),
          ←Real.rpow_natCast_mul hD0,←Real.rpow_natCast D q]
        simp only [mul_assoc]
        rw [←Real.rpow_add hDp]
        congr 3
        rw [Nat.cast_sub hp,Nat.cast_one]
        have hp0 : (p:ℝ) ≠ 0 := by exact_mod_cast (show p ≠ 0 by omega)
        field_simp
        ring
  have hcol : (q:ℝ)^2*(⌊D⌋₊:ℝ)^(q-1)+1 ≤ ((q:ℝ)^2+1)*D^(q-1) := by
    have hpow := pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le hD0) (q-1)
    have h1 : (1:ℝ) ≤ D^(q-1) := one_le_pow₀ hD
    nlinarith [sq_nonneg (q:ℝ)]
  have herr : 2*p*Fintype.card A*((q:ℝ)^2*(⌊D⌋₊:ℝ)^(q-1)+1) ≤
      2*p*((q:ℝ)^2+1)*D^q := by
    calc
      _ ≤ 2*p*D*(((q:ℝ)^2+1)*D^(q-1)) := by gcongr
      _ = _ := by
        have he : D*D^(q-1)=D^q := by rw [←pow_succ']; congr 1; omega
        calc
          _ = 2*p*((q:ℝ)^2+1)*(D*D^(q-1)) := by ring
          _ = _ := by rw [he]
  exact (dimension_bound X P p ⌊D⌋₊ hp hXn hT0 hcommon).trans (add_le_add hmain herr)


end Erdos571.TupleBoxCommonKst


/-! ## CenterArmFanBox -/


/-! Rich short-spider tuples with a supply of center arms are sparse in every box. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def boxRel (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (H : ℝ) (z u : W) (r : Fin q → W) : Prop :=
  Rich G U t p q M u r ∧ (∀j, r j≠z) ∧ H≤((ShortSpider.arms G U t z u).card:ℝ)

noncomputable def boxEstimate (p q t M : ℕ) (n H D : ℝ) : ℝ :=
  2*(2*((p*q+2+2*M)*(2*t):ℕ)*n/H)^((p:ℝ)⁻¹)*D^((q:ℝ)+1-1/(p:ℝ))+
    2*p*((q:ℝ)^2+1)*D^q

open Classical in
lemma box_common_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hf : (graph p q M).Free G)
    {H : ℝ} (hH : 0<H) (hlarge : 2*(p*q+1:ℕ)*t≤H) (z : W) (X : Fin q → Finset W)
    (f : Fin p ↪ Fintype.piFinset X)
    (hdis : ∀i j, i≠j → Disjoint (TupleBoxPacking.foot (f i).val) (TupleBoxPacking.foot (f j).val)) :
    ((univ.filter (fun a : neighbors G U z => ∀i, boxRel G U t p q M H z a.val (f i).val)).card:ℝ)≤
      2*((p*q+2+2*M)*(2*t):ℕ)*(U.card:ℝ)/H := by
  classical
  let F := (neighbors G U z).filter (fun u => ∀i, boxRel G U t p q M H z u (f i).val)
  have he : (univ.filter (fun a : neighbors G U z => ∀i, boxRel G U t p q M H z a.val (f i).val)).card=F.card := by
    apply card_bij (fun a _ => a.val)
    · intro a ha
      exact mem_filter.mpr ⟨a.property,(mem_filter.mp ha).2⟩
    · intro a ha b hb hab
      exact Subtype.ext hab
    · intro a ha
      exact ⟨⟨a,(mem_filter.mp ha).1⟩,mem_filter.mpr ⟨mem_univ _,(mem_filter.mp ha).2⟩,rfl⟩
  rw [he]
  by_cases hF : F.Nonempty
  swap
  · rw [not_nonempty_iff_eq_empty.mp hF,card_empty,Nat.cast_zero]
    positivity
  obtain ⟨u₀,hu₀⟩ := hF
  have hdist (i : Fin p) := rich_distinct ((mem_filter.mp hu₀).2 i).1
  let r : OldRoot p q ↪ W :=
    { toFun := Sum.elim (fun _ => z) (fun a => (f a.1).val a.2)
      inj' := by
        rintro (a|⟨i,j⟩) (b|⟨i',j'⟩) h
        · exact congrArg Sum.inl (Subsingleton.elim _ _)
        · exact (((mem_filter.mp hu₀).2 i').2.1 j' h.symm).elim
        · exact (((mem_filter.mp hu₀).2 i).2.1 j h).elim
        · by_cases hi : i=i'
          · subst i'
            exact congrArg Sum.inr (Prod.ext rfl ((hdist i).1 h))
          · exact (disjoint_left.mp (hdis i i' hi)
              (mem_image.mpr ⟨j,mem_univ _,rfl⟩) (mem_image.mpr ⟨j',mem_univ _,h.symm⟩)).elim }
  apply common_rich_rows G U t p q M ht hf r F
  · exact (filter_subset _ _).trans (filter_subset _ _)
  · intro u hu
    exact (mem_filter.mp (mem_filter.mp hu).1).2
  · intro u hu i
    exact ((mem_filter.mp hu).2 i).1
  · exact hH
  · exact hlarge
  · intro u hu
    exact ((mem_filter.mp hu).2 ⟨0,by omega⟩).2.2

lemma box_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hf : (graph p q M).Free G)
    {H : ℝ} (hH : 0<H) (hlarge : 2*(p*q+1:ℕ)*t≤H) (z : W) (v : Fin q → W)
    {D : ℝ} (hD : 1≤D) (hz : ((neighbors G U z).card:ℝ)≤D)
    (hv : ∀j, ((neighbors G U (v j)).card:ℝ)≤D) :
    letI : DecidableRel (boxRel G U t p q M H z) := fun _ _ => Classical.propDecidable _
    (((neighbors G U z×ˢFintype.piFinset (fun j => neighbors G U (v j))).filter
      (fun e => boxRel G U t p q M H z e.1 e.2)).card:ℝ)≤boxEstimate p q t M U.card H D := by
  classical
  letI : Nonempty (Fin q) := ⟨⟨0,by omega⟩⟩
  let A := neighbors G U z
  let X : Fin q → Finset W := fun j => neighbors G U (v j)
  let P : A → (Fin q → W) → Prop := fun a r => boxRel G U t p q M H z a.val r
  have hb := TupleBoxCommonKst.bound X P p hp hD (T := 2*((p*q+2+2*M)*(2*t):ℕ)*(U.card:ℝ)/H)
    (by positivity) (by simpa only [Fintype.card_coe] using hz) hv
    (box_common_bound G U t p q M ht hp hf hH hlarge z X)
  have he : ((univ×ˢFintype.piFinset X).filter (fun e : A×(Fin q → W) => P e.1 e.2)).card=
      ((A×ˢFintype.piFinset X).filter (fun e => boxRel G U t p q M H z e.1 e.2)).card := by
    apply card_bij (fun e _ => (e.1.val,e.2))
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact mem_filter.mpr ⟨mem_product.mpr ⟨e.1.property,(mem_product.mp he).2⟩,hP⟩
    · intro e he f hf hef
      exact Prod.ext (Subtype.ext (Prod.mk.inj hef).1) (Prod.mk.inj hef).2
    · intro e he
      obtain ⟨he,hP⟩ := mem_filter.mp he
      exact ⟨(⟨e.1,(mem_product.mp he).1⟩,e.2),
        mem_filter.mpr ⟨mem_product.mpr ⟨mem_univ _,(mem_product.mp he).2⟩,hP⟩,rfl⟩
  simpa only [he,Fintype.card_fin,boxEstimate] using hb

end Erdos571.CenterArmFan


/-! ## CenterArmFanRichCount -/


/-! Carrying the reversed tuple-box bound into rich fan-branch counting. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

noncomputable def richBranches (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (H : ℝ) : Finset ((ShortSpider.template q).Copy G) := by
  classical
  exact (TreeCopiesIn.copies (ShortSpider.template q) G U).filter (fun f =>
    Rich G U t p q M (f (.inr none)) (fun j => f (.inr (some j))) ∧
      H≤((ShortSpider.arms G U t (f (.inl none)) (f (.inr none))).card:ℝ))

lemma boxEstimate_nonneg (p q t M : ℕ) (n H : ℝ) (hn : 0≤n) (hH : 0≤H) {D : ℝ} (hD : 0≤D) :
    0≤boxEstimate p q t M n H D := by
  unfold boxEstimate
  positivity

lemma richBranches_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hf : (graph p q M).Free G)
    {H : ℝ} (hH : 0<H) (hlarge : 2*(p*q+1:ℕ)*t≤H)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    ((richBranches G U t p q M H).card:ℝ)≤
      U.card*D^q*boxEstimate p q t M U.card H D := by
  classical
  let F := richBranches G U t p q M H
  let pre : (ShortSpider.template q).Copy G → W×(Fin q → W) :=
    fun f => (f (.inl none),fun j => f (.inl (some j)))
  have hm (f) (hf : f∈F) : ∀v, f v∈U :=
    (TreeCopiesIn.mem_copies _ _ _ _).mp (mem_filter.mp hf).1
  have hmap (f) (hf : f∈F) : pre f∈FanSpider.branchCores G U q := by
    refine mem_biUnion.mpr ⟨f (.inl none),hm f hf _,mem_image.mpr ⟨(fun j => f (.inl (some j))),?_,rfl⟩⟩
    exact Fintype.mem_piFinset.mpr (fun j => mem_filter.mpr ⟨hm f hf _,f.toHom.map_adj trivial⟩)
  have hcount := RealFiberCount.bound F (FanSpider.branchCores G U q) pre hmap
    (D := boxEstimate p q t M U.card H D) (by
      intro v hv
      obtain ⟨z,hz,hv⟩ := mem_biUnion.mp hv
      obtain ⟨v',hv',he⟩ := mem_image.mp hv
      subst v
      let B := ((neighbors G U z)×ˢFintype.piFinset (fun j => neighbors G U (v' j))).filter
        (fun e => boxRel G U t p q M H z e.1 e.2)
      have hc : (F.filter (fun f => pre f=(z,v'))).card≤B.card := by
        apply card_le_card_of_injOn (fun f => (f (.inr none),fun j => f (.inr (some j))))
        · intro f hf'
          obtain ⟨hf',he⟩ := mem_filter.mp hf'
          have hez : f (.inl none)=z := congrArg Prod.fst he
          have hev : (fun j => f (.inl (some j)))=v' := congrArg Prod.snd he
          refine mem_filter.mpr ⟨mem_product.mpr ⟨mem_filter.mpr ⟨hm f hf' _,?_⟩,?_⟩,
            (mem_filter.mp hf').2.1,?_,?_⟩
          · rw [←hez]
            exact f.toHom.map_adj rfl
          · apply Fintype.mem_piFinset.mpr
            intro j
            refine mem_filter.mpr ⟨hm f hf' _,?_⟩
            rw [←congrFun hev j]
            exact f.toHom.map_adj rfl
          · intro j
            rw [←hez]
            exact f.injective.ne Sum.inr_ne_inl
          · simpa only [←hez] using (mem_filter.mp hf').2.2
        · intro f hf' f' hf'' he
          have hp := (mem_filter.mp hf').2.trans (mem_filter.mp hf'').2.symm
          have hz : f (.inl none)=f' (.inl none) := congrArg Prod.fst hp
          have hv : (fun j => f (.inl (some j)))=(fun j => f' (.inl (some j))) := congrArg Prod.snd hp
          have hr := Prod.mk.inj he
          apply Copy.ext
          rintro (a|r)
          · cases a with
            | none => exact hz
            | some j => exact congrFun hv j
          · cases r with
            | none => exact hr.1
            | some j => exact congrFun hr.2 j
      exact (show _≤(B.card:ℝ) by exact_mod_cast hc).trans
        (box_bound G U t p q M ht hp hq hf hH hlarge z v' hD (hdeg z hz)
          (fun j => hdeg _ (mem_filter.mp (Fintype.mem_piFinset.mp hv' j)).1)))
  have hh := mul_le_mul_of_nonneg_right (FanSpider.branchCores_bound G U q (by linarith) hdeg)
    (boxEstimate_nonneg p q t M (U.card:ℝ) H (by positivity) hH.le (D := D) (by linarith))
  exact hcount.trans (hh.trans_eq (by ring))


end Erdos571.CenterArmFan


/-! ## CenterArmFanRichSubtrees -/


/-! Fan copy counting with a reversed-KST rich-subtree error. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma rich_subtree_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hf : (graph p q M).Free G)
    {H : ℝ} (hH : 0<H) (hlarge : 2*(p*q+1:ℕ)*t≤H)
    {D : ℝ} (hD : 1≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D)
    (b : FanSpider.Branch p q) (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hr : ∀f∈F, Rich G U t p q M (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j)))))
    (ha : ∀f∈F, H≤((ShortSpider.arms G U t (f (subCopy b (.inl none))) (f (subCopy b (.inr none)))).card:ℝ)) :
    (F.card:ℝ)≤U.card*D^(p+2*p*q+2-q)*boxEstimate p q t M U.card H D := by
  classical
  have hb := ConnectedCopyBound.copy_restriction_bound (template p q) (connected p q) (ShortSpider.template q)
    (subCopy b) G U (by linarith) hdeg F (richBranches G U t p q M H) hm (by
      intro f hf
      exact mem_filter.mpr ⟨(TreeCopiesIn.mem_copies _ _ _ _).mpr (fun v => hm f hf _),hr f hf,ha f hf⟩)
  rw [card_vertex p q] at hb
  simp only [Fintype.card_sum,Fintype.card_option,Fintype.card_fin] at hb
  have he : p+2*p*q+4-(q+1+(q+1))=p+2*p*q+2-2*q := by omega
  rw [he] at hb
  have hh := mul_le_mul_of_nonneg_right (richBranches_bound G U t p q M ht hp hq hf hH hlarge hD hdeg)
    (show 0≤D^(p+2*p*q+2-2*q) by positivity)
  have hpq : q≤p*q := by simpa using Nat.mul_le_mul_right q hp
  have hmul : D^q*D^(p+2*p*q+2-2*q)=D^(p+2*p*q+2-q) := by
    rw [←pow_add]
    congr 1
    simp only [Nat.mul_assoc]
    omega
  exact hb.trans (hh.trans_eq (by
    calc
      _ = U.card*(D^q*D^(p+2*p*q+2-2*q))*boxEstimate p q t M U.card H D := by ring
      _ = _ := by rw [hmul]))

end Erdos571.CenterArmFan


/-! ## ShortSpiderArmLoss -/


/-! Aggregate arm loss and the number of edges with too few light three-walk arms. -/
namespace Erdos571.ShortSpider
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

lemma fullArms_lower (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    {d : ℝ} (hd : 0≤d) (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ))
    (c : W) (hc : c∈U) : d^2≤((fullArms G U c).card:ℝ) := by
  have he : ((fullArms G U c).card:ℝ)=∑a∈neighbors G U c, ((neighbors G U a).card:ℝ) := by
    exact_mod_cast fullArms_card G U c
  rw [he]
  have hs := sum_le_sum (s := neighbors G U c) (fun a ha => hdeg a (mem_filter.mp ha).1)
  simp only [sum_const,nsmul_eq_mul] at hs
  nlinarith [mul_le_mul_of_nonneg_right (hdeg c hc) hd]

lemma armLoss_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑e∈arcs G U, (((fullArms G U e.2).card:ℝ)-(arms G U t e.1 e.2).card))≤
      2*D*(∑v∈U, ((badPairs G U t v).card:ℝ)) := by
  classical
  have hbad := first_bad_bound G U t hD hdeg
  have hs : threeWalks G U ⊆ goodWalks G U t ∪
      (threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1) ∪
      (threeWalks G U).filter (fun p => Bad G U t p.1.2 p.2.2) := by
    intro p hp
    by_cases h₁ : Bad G U t p.1.1 p.2.1
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hp,h₁⟩))
    by_cases h₂ : Bad G U t p.1.2 p.2.2
    · exact mem_union_right _ (mem_filter.mpr ⟨hp,h₂⟩)
    exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨hp,h₁,h₂⟩))
  have hsplit := (card_le_card hs).trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  rw [second_bad_card] at hsplit
  have hsplit' : ((threeWalks G U).card:ℝ)≤(goodWalks G U t).card+
      2*(((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card:ℝ) := by
    exact_mod_cast (show (threeWalks G U).card≤(goodWalks G U t).card+
      2*((threeWalks G U).filter (fun p => Bad G U t p.1.1 p.2.1)).card by omega)
  have hfull : (∑e∈arcs G U, ((fullArms G U e.2).card:ℝ))=(threeWalks G U).card := by
    exact_mod_cast (threeWalks_card G U).symm
  have hgood : (∑e∈arcs G U, ((arms G U t e.1 e.2).card:ℝ))=(goodWalks G U t).card := by
    exact_mod_cast (goodWalks_card G U t).symm
  rw [sum_sub_distrib,hfull,hgood]
  linarith

noncomputable def poorArcs (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t : ℕ) (H : ℝ) : Finset (W×W) := by
  classical
  exact (arcs G U).filter (fun e => ((arms G U t e.1 e.2).card:ℝ)<H)

lemma poorArcs_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {d D H : ℝ} (hd : 0≤d) (hD : 0≤D)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤D) :
    ((poorArcs G U t H).card:ℝ)*(d^2-H)≤2*D*(∑v∈U, ((badPairs G U t v).card:ℝ)) := by
  classical
  let loss (e : W×W) : ℝ := (fullArms G U e.2).card-(arms G U t e.1 e.2).card
  have hn (e : W×W) : 0≤loss e := by
    have h : (arms G U t e.1 e.2).card≤(fullArms G U e.2).card := card_le_card (filter_subset _ _)
    exact sub_nonneg.mpr (by exact_mod_cast h)
  have hs : (∑_e∈poorArcs G U t H, (d^2-H))≤∑e∈poorArcs G U t H, loss e := by
    apply sum_le_sum
    intro e he
    obtain ⟨he,hp⟩ := mem_filter.mp he
    have hfull := fullArms_lower G U hd (fun v hv => (hdeg v hv).1) e.2 (mem_arcs.mp he).2.1
    dsimp [loss]
    linarith
  simp only [sum_const,nsmul_eq_mul] at hs
  apply hs.trans
  apply le_trans _ (armLoss_bound G U t hD (fun v hv => (hdeg v hv).2))
  exact sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun e _ _ => hn e)

lemma poorArcs_half_bound (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (t : ℕ)
    {d D : ℝ} (hd : 0<d) (hD : 0≤D)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤D) :
    ((poorArcs G U t (d^2/2)).card:ℝ)≤4*D*(∑v∈U, ((badPairs G U t v).card:ℝ))/d^2 := by
  apply (le_div_iff₀ (sq_pos_of_pos hd)).mpr
  have h := poorArcs_bound G U t (H := d^2/2) hd.le hD hdeg
  linarith

end Erdos571.ShortSpider


/-! ## PoorEdgeCopies -/


/-! Copies of a connected graph containing a specified poor oriented edge. -/
namespace Erdos571.ConnectedCopyBound
open Finset SimpleGraph DensityRegularization

lemma poor_edge_bound {V W : Type} [Fintype V] [DecidableEq V] [Fintype W] [DecidableEq W]
    (T : SimpleGraph V) (hT : T.Connected) (G : SimpleGraph W) [DecidableRel G.Adj]
    (U : Finset W) (t : ℕ) {d D : ℝ} (hd : 0<d) (hD : 0≤D)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤D)
    (x y : V) (hxy : T.Adj x y) (F : Finset (T.Copy G)) (hm : ∀f∈F, ∀v, f v∈U)
    (hp : ∀f∈F, ((ShortSpider.arms G U t (f x) (f y)).card:ℝ)<d^2/2) :
    (F.card:ℝ)≤(4*D*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))/d^2)*D^(Fintype.card V-2) := by
  classical
  let pre : T.Copy G → W×W := fun f => (f x,f y)
  have hmap : Set.MapsTo pre F (ShortSpider.poorArcs G U t (d^2/2)) := by
    intro f hf
    exact mem_filter.mpr ⟨mem_arcs.mpr ⟨hm f hf x,hm f hf y,f.toHom.map_adj hxy⟩,hp f hf⟩
  have hcount := RealFiberCount.bound F (ShortSpider.poorArcs G U t (d^2/2)) pre hmap
    (D := D^(Fintype.card V-2)) (by
      intro e he
      have h := bound T hT G U hD (fun v hv => (hdeg v hv).2) {x,y} (by simp)
        (fun v => if v=x then e.1 else e.2) (F.filter (fun f => pre f=e))
        (fun f hf => hm f (mem_filter.mp hf).1) (by
          intro f hf v hv
          have heq := (mem_filter.mp hf).2
          rcases mem_insert.mp hv with rfl|hv
          · simpa only [if_pos rfl] using congrArg Prod.fst heq
          · have hv' : v=y := mem_singleton.mp hv
            subst v
            simpa only [if_neg hxy.ne.symm] using congrArg Prod.snd heq)
      simpa only [Finset.card_pair hxy.ne] using h)
  exact hcount.trans (mul_le_mul_of_nonneg_right (ShortSpider.poorArcs_half_bound G U t hd hD hdeg)
    (pow_nonneg hD _))

end Erdos571.ConnectedCopyBound


/-! ## CenterArmFanAllCount -/


/-! Center-arm fan copies: good, nonlight, rich, and poor-edge contributions. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

theorem all_count (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W)
    (t p q M : ℕ) (ht : 1≤t) (hp : 1≤p) (hq : 1≤q) (hf : (graph p q M).Free G)
    {d D : ℝ} (hd : 0<d) (hD : 1≤D) (hlarge : 2*(p*q+1:ℕ)*t≤d^2/2)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤D)
    (F : Finset ((template p q).Copy G)) (hm : ∀f∈F, ∀v, f v∈U) :
    (F.card:ℝ)≤(M*(p+p*q+2)*copyLoad t p q M:ℕ)*(U.card:ℝ)^(p*q+2)+
      ((p+2*p*q+4:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q+1)+
      (p+p*q:ℕ)*U.card*D^(p+2*p*q+2-q)*boxEstimate p q t M U.card (d^2/2) D+
      (p+p*q:ℕ)*(4*D*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))/d^2)*D^(p+2*p*q+2) := by
  classical
  let A := F.filter (GoodCopy G U t p q M)
  let B := F.filter (fun f => ¬ConnectedCopyBound.Light (template p q) G U t f)
  let C (b : FanSpider.Branch p q) := F.filter (fun f => Rich G U t p q M
    (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j)))) ∧
      d^2/2≤((ShortSpider.arms G U t (f (subCopy b (.inl none))) (f (subCopy b (.inr none)))).card:ℝ))
  let P (b : FanSpider.Branch p q) := F.filter (fun f =>
    ((ShortSpider.arms G U t (f (subCopy b (.inl none))) (f (subCopy b (.inr none)))).card:ℝ)<d^2/2)
  have hs : F⊆A∪B∪univ.biUnion C∪univ.biUnion P := by
    intro f hf
    by_cases hl : ConnectedCopyBound.Light (template p q) G U t f
    swap
    · exact mem_union_left _ (mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨hf,hl⟩)))
    by_cases hb : ∀b : FanSpider.Branch p q, ¬Rich G U t p q M
      (f (subCopy b (.inr none))) (fun j => f (subCopy b (.inr (some j))))
    · apply mem_union_left
      apply mem_union_left
      apply mem_union_left
      exact mem_filter.mpr ⟨hf,hm f hf,hl,fun b => Nat.le_of_not_lt (hb b)⟩
    · simp only [not_forall,not_not] at hb
      obtain ⟨b,hb⟩ := hb
      by_cases ha : d^2/2≤((ShortSpider.arms G U t (f (subCopy b (.inl none))) (f (subCopy b (.inr none)))).card:ℝ)
      · exact mem_union_left _ (mem_union_right _ (mem_biUnion.mpr ⟨b,mem_univ _,mem_filter.mpr ⟨hf,hb,ha⟩⟩))
      · exact mem_union_right _ (mem_biUnion.mpr ⟨b,mem_univ _,mem_filter.mpr ⟨hf,lt_of_not_ge ha⟩⟩)
  have hA := good_count G U t p q M hf A (fun f hf => (mem_filter.mp hf).2)
  have hB : (B.card:ℝ)≤((p+2*p*q+4:ℕ):ℝ)^3*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))*D^(p+2*p*q+1) := by
    have h := ConnectedCopyBound.nonlight_bound (template p q) (connected p q) G U t (by linarith)
      (fun v hv => (hdeg v hv).2) B (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2)
    simpa only [card_vertex p q,show p+2*p*q+4-3=p+2*p*q+1 by omega,mul_assoc] using h
  have hC : ((univ.biUnion C).card:ℝ)≤
      (p+p*q:ℕ)*U.card*D^(p+2*p*q+2-q)*boxEstimate p q t M U.card (d^2/2) D := by
    have hc : ((univ.biUnion C).card:ℝ)≤∑b : FanSpider.Branch p q, ((C b).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun b hb => rich_subtree_count G U t p q M ht hp hq hf
      (by positivity) hlarge hD (fun v hv => (hdeg v hv).2) b (C b)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2.1)
      (fun f hf => (mem_filter.mp hf).2.2))
    simp only [sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul] at hh
    exact hc.trans (hh.trans_eq (by ring))
  have hP : ((univ.biUnion P).card:ℝ)≤
      (p+p*q:ℕ)*(4*D*(∑v∈U, ((ShortSpider.badPairs G U t v).card:ℝ))/d^2)*D^(p+2*p*q+2) := by
    have hc : ((univ.biUnion P).card:ℝ)≤∑b : FanSpider.Branch p q, ((P b).card:ℝ) := by exact_mod_cast card_biUnion_le
    have hh := sum_le_sum (s := univ) (fun b hb => ConnectedCopyBound.poor_edge_bound
      (template p q) (connected p q) G U t hd (by linarith) hdeg
      (subCopy b (.inl none)) (subCopy b (.inr none)) ((subCopy b).toHom.map_adj rfl) (P b)
      (fun f hf => hm f (mem_filter.mp hf).1) (fun f hf => (mem_filter.mp hf).2))
    simp only [card_vertex p q,show p+2*p*q+4-2=p+2*p*q+2 by omega,
      sum_const,card_univ,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,nsmul_eq_mul] at hh
    exact hc.trans (hh.trans_eq (by ring))
  have hc := (card_le_card hs).trans ((card_union_le _ _).trans
    (Nat.add_le_add_right ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _)) _))
  have hc' : (F.card:ℝ)≤A.card+B.card+(univ.biUnion C).card+(univ.biUnion P).card := by exact_mod_cast hc
  linarith

end Erdos571.CenterArmFan


/-! ## CenterArmFanHeavyRoots -/


/-! Actual center-arm-fan containment from a heavy common-root rectangle. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization
variable {W : Type} [Fintype W] [DecidableEq W]

def massCoeff (p q M : ℕ) := RepeatedHeavyRoots.massCoefficient (JoinedCore p M) (OldRoot p q)
def vertexCount (p q M : ℕ) :=
  RepeatedHeavyRoots.vertexBound (JoinedCore p M) (Fin M × OldArms p q) (OldRoot p q)

theorem contains_of_heavy_roots (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U S : Finset W) (p q t M D : ℕ)
    (ht : vertexCount p q M≤t) (hdeg : ∀v∈U, (neighbors G U v).card≤D)
    (hSU : S⊆U) (hS : S.card≤D) (hSg : ∀s∈S, g s=false)
    (r : OldRoot p q ↪ W) (hrU : ∀j, r j∈U) (hrg : ∀j, g (r j)=false)
    (hheavy : ∀u∈S, ∀j, t≤(FourthMoment.common G U u (r j)).card)
    (hlarge : massCoeff p q M*D<t*S.card) : graph p q M ⊑ G := by
  obtain ⟨f,m,hf,hs,ha,hfm,hfr,hmr⟩ := RepeatedHeavyRoots.exists_layout
    (joinedGraph p M) (joined_tree p M) joinedColor (joinedColor_proper p M) none rfl
    (@joinedAttach p q M) (fun i => Sum.inr i.2) (fun _ => rfl)
    G g hg U S t D ht hdeg hSU hS hSg r (.inl ()) hrU hrg hheavy hlarge
  exact contains_of_joined_layout G p q M f m r hf hs ha hfm hfr hmr

end Erdos571.CenterArmFan


/-! ## CenterArmFanHeavyShadow -/


/-! Local heavy-shadow exclusion for the center-arm fan. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]

def heavyThreshold (p q M L : ℕ) := massCoeff p q M*L^(p*q+1)+vertexCount p q M

lemma heavy_induced_free (p q : ℕ)
    (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W)
    (M L D : ℕ) (hL : 1≤L) (hf : (graph p q M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (completeBipartiteGraph (Fin (p*q+1)) (Fin (D/L^(p*q+1)+1))).Free
      ((heavy (arcs G U) U (heavyThreshold p q M L)).induce (neighbors G U z : Set W)) := by
  classical
  rintro ⟨f⟩
  let n := p*q+1
  let mcols := D/L^n+1
  let e : OldRoot p q ≃ Fin n := Fintype.equivOfCardEq (by simp [n,Fintype.card_sum,Fintype.card_prod,Nat.add_comm])
  let old : Fin n⊕Fin mcols ↪ W := f.toEmbedding.trans (Function.Embedding.subtype _)
  let r : OldRoot p q ↪ W := e.toEmbedding.trans (Function.Embedding.inl.trans old)
  let S := univ.image (fun i : Fin mcols => old (.inr i))
  have holdN (a : Fin n⊕Fin mcols) : old a∈neighbors G U z := (f a).property
  have holdU (a : Fin n⊕Fin mcols) : old a∈U := (mem_filter.mp (holdN a)).1
  have hSU : S⊆U := by
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdU _
  have hrU (j : OldRoot p q) : r j∈U := holdU _
  have hS : S.card=mcols := by
    have hi : Function.Injective (fun i : Fin mcols => old (.inr i)) := old.injective.comp Sum.inr_injective
    simp only [S,card_image_of_injective _ hi,card_univ,Fintype.card_fin]
  have hsize : S.card≤D := by
    apply le_trans _ (hdeg z hz)
    apply card_le_card
    intro u hu
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    exact holdN _
  let g' : W → Bool := fun w => if g w=g z then true else false
  have hg' {u v} (h : G.Adj u v) : g' u≠g' v := by
    have h' := hg h
    cases hgu : g u <;> cases hgv : g v <;> cases hgz : g z <;> simp_all [g']
  have hNz (w) (hw : w∈neighbors G U z) : g' w=false := by
    have h := hg (mem_filter.mp hw).2
    simp [g',Ne.symm h]
  have hSg (w) (hw : w∈S) : g' w=false := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hw
    exact hNz _ (holdN _)
  have hrg (j : OldRoot p q) : g' (r j)=false := hNz _ (holdN _)
  have hheavy (u) (hu : u∈S) (j : OldRoot p q) :
      heavyThreshold p q M L≤(FourthMoment.common G U u (r j)).card := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hu
    have h := f.toHom.map_adj (show (completeBipartiteGraph (Fin n) (Fin mcols)).Adj (.inr i) (.inl (e j)) by simp [completeBipartiteGraph])
    change old (.inr i)≠r j ∧ heavyThreshold p q M L≤(common (arcs G U) U (old (.inr i)) (r j)).card at h
    rw [ShortSpider.common_eq G U (holdU (.inr i)) (hrU j)] at h
    exact h.2
  have hmass : heavyThreshold p q M L*S.card≤ massCoeff p q M*D := by
    apply le_of_not_gt
    intro h
    exact hf (contains_of_heavy_roots G g' hg' U S p q
      (heavyThreshold p q M L) M D (by dsimp [heavyThreshold]; omega)
      hdeg hSU hsize hSg r hrU hrg hheavy h)
  have hscale : L^n*mcols≤D := by
    rw [hS] at hmass
    have hm : massCoeff p q M*(L^n*mcols)≤ massCoeff p q M*D := by
      dsimp [heavyThreshold] at hmass
      change (massCoeff p q M*L^n+vertexCount p q M)*mcols≤ massCoeff p q M*D at hmass
      nlinarith
    exact (mul_le_mul_iff_right₀ (by dsimp [massCoeff,RepeatedHeavyRoots.massCoefficient]; omega : 0< massCoeff p q M)).mp hm
  have hLpos : 0<L^n := pow_pos (by omega) _
  have hp : D<L^n*mcols := Nat.lt_mul_div_succ D hLpos
  omega


end Erdos571.CenterArmFan


/-! ## CenterArmFanHeavyCount -/


/-! Arbitrarily small quadratic heavy-path mass under actual target freeness. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph DensityRegularization ProjectionHeavy
variable {W : Type} [Fintype W] [DecidableEq W]

variable (G : SimpleGraph W) [DecidableRel G.Adj] (g : W → Bool)
    (hg : ∀{u v}, G.Adj u v → g u≠g v) (U : Finset W) (p q : ℕ)
include hg

lemma heavy_pairs_nat (M L D : ℕ) (hL : 1≤L) (hf : (graph p q M).Free G)
    (hdeg : ∀v∈U, (neighbors G U v).card≤D) (z : W) (hz : z∈U) :
    (heavyPairs (arcs G U) U (heavyThreshold p q M L) (neighbors G U z)).card≤
      2*(D/L+p*q+3)*D := by
  classical
  let H := (heavy (arcs G U) U (heavyThreshold p q M L)).induce (neighbors G U z : Set W)
  have hn : Fintype.card (neighbors G U z : Set W)=(neighbors G U z).card :=
    Fintype.card_of_finset' (p := (neighbors G U z : Set W)) _ (fun _ => Iff.rfl)
  have hsize : Fintype.card (neighbors G U z : Set W)≤D := by
    simpa only [hn] using hdeg z hz
  have hpow := AnchoredArms.scale_power D L (p*q) hL
  have hb := TreeCount.edge_bound_of_no_commonRootCopies (KstUpper.Star (p*q+1))
    (KstUpper.star_tree _) (D/L+1) (D/L^(p*q+1)) D
    (by simpa only [Fintype.card_fin,Fintype.card_sum,Nat.add_sub_cancel,Nat.add_sub_cancel_left] using hpow) H hsize
    (fun h => heavy_induced_free p q G g hg U M L D hL hf hdeg z hz
      (KstUpper.contained_of_common_roots H h))
  have hb' : Nat.card H.edgeSet≤(D/L+p*q+3)*(neighbors G U z).card := by
    convert hb using 1 <;> simp only [Nat.card_eq_fintype_card,card_edgeSet,
      Fintype.card_sum,Fintype.card_fin,hn] <;> congr 1 <;> omega
  rw [heavyPairs_card]
  exact (Nat.mul_le_mul_left 2 hb').trans (by
    nlinarith [Nat.mul_le_mul_left (2*(D/L+p*q+3)) (hdeg z hz)])

lemma heavy_pairs_bound (M L : ℕ) (hL : 1≤L) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) (z : W) (hz : z∈U) :
    ((heavyPairs (arcs G U) U (heavyThreshold p q M L) (neighbors G U z)).card:ℝ)≤
      2/(L:ℝ)*D^2+2*(p*q+3:ℝ)*D := by
  have hb := heavy_pairs_nat G g hg U p q M L ⌊D⌋₊ hL hf
    (fun v hv => Nat.le_floor (hdeg v hv)) z hz
  have hb' : ((heavyPairs (arcs G U) U (heavyThreshold p q M L) (neighbors G U z)).card:ℝ)≤
      2*((⌊D⌋₊/L:ℕ)+(p*q:ℝ)+3)*(⌊D⌋₊:ℝ) := by exact_mod_cast hb
  have hLpos : (0:ℝ)<L := by exact_mod_cast (show 0<L by omega)
  have hdiv : (⌊D⌋₊/L:ℕ)*(L:ℝ)≤D := by
    have h : (⌊D⌋₊/L:ℕ)*(L:ℝ)≤(⌊D⌋₊:ℝ) := by exact_mod_cast Nat.div_mul_le_self ⌊D⌋₊ L
    exact h.trans (Nat.floor_le hD)
  have hquot := (le_div_iff₀ hLpos).mpr hdiv
  calc
    _ ≤ 2*((⌊D⌋₊/L:ℕ)+(p*q:ℝ)+3)*(⌊D⌋₊:ℝ) := hb'
    _ ≤ 2*(D/(L:ℝ)+(p*q:ℝ)+3)*D := by gcongr; exact Nat.floor_le hD
    _ = _ := by ring

theorem badPairs_sum_bound (M L : ℕ) (hL : 1≤L) (hf : (graph p q M).Free G)
    {D : ℝ} (hD : 0≤D) (hdeg : ∀v∈U, ((neighbors G U v).card:ℝ)≤D) :
    (∑v∈U, ((ShortSpider.badPairs G U (heavyThreshold p q M L) v).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+(2*(p*q:ℝ)+7)*D) := by
  have hh : (∑v∈U, ((heavyPairs (arcs G U) U (heavyThreshold p q M L) (neighbors G U v)).card:ℝ))≤
      U.card*(2/(L:ℝ)*D^2+2*(p*q+3:ℝ)*D) := by
    exact (sum_le_sum (fun v hv => heavy_pairs_bound G g hg U p q M L hL hf hD hdeg v hv)).trans_eq (by simp [mul_add])
  have h := ThetaFour.badPairs_sum_bound G U (heavyThreshold p q M L) hdeg
  nlinarith


end Erdos571.CenterArmFan


/-! ## CenterArmFanNumerics -/


/-! Scaling and absorption for the center-arm fan counting error. -/
namespace Erdos571.CenterArmFan
open Filter Asymptotics
set_option maxHeartbeats 2000000

noncomputable def countError (p q t M K : ℕ) (n d D : ℝ) : ℝ :=
  ((p+2*p*q+4:ℕ):ℝ)^3*(2/(K:ℝ)*D^2+(2*(p:ℝ)*q+7)*D)*D^(p+2*p*q+1)+
    (p+p*q:ℕ)*D^(p+2*p*q+2-q)*boxEstimate p q t M n (d^2/2) D+
    (p+p*q:ℕ)*(4*D*(2/(K:ℝ)*D^2+(2*(p:ℝ)*q+7)*D)/d^2)*D^(p+2*p*q+2)

noncomputable def heavyCoeff (p q : ℕ) (Q : ℝ) : ℝ :=
  ((p+2*p*q+4:ℕ):ℝ)^3*Q^(p+2*p*q+1)+4*(p+p*q:ℕ)*Q^(p+2*p*q+3)

noncomputable def linearCoeff (p q : ℕ) (Q : ℝ) : ℝ :=
  heavyCoeff p q Q*(2*(p:ℝ)*q+7)*Q+2*p*(p+p*q:ℕ)*((q:ℝ)^2+1)*Q^(p+2*p*q+2)

noncomputable def richCoeff (p q t M : ℕ) (Q : ℝ) : ℝ :=
  2*(p+p*q:ℕ)*(4*((p*q+2+2*M)*(2*t):ℕ))^((p:ℝ)⁻¹)*Q^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ))

lemma countError_eq (p q t M K : ℕ) (hp : 1≤p) {n d Q : ℝ}
    (hn : 0≤n) (hd : 0<d) (hQ : 0<Q) :
    countError p q t M K n d (Q*d) =
      (2*heavyCoeff p q Q*Q^2/(K:ℝ))*d^(p+2*p*q+3)+linearCoeff p q Q*d^(p+2*p*q+2)+
      richCoeff p q t M Q*n^((p:ℝ)⁻¹)*d^(((p+2*p*q+3:ℕ):ℝ)-3/(p:ℝ)) := by
  have hnq : q≤p+2*p*q+2 := by nlinarith
  have hrichpow : (Q*d)^(p+2*p*q+2-q)*(Q*d)^((q:ℝ)+1-1/(p:ℝ))=
      (Q*d)^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ)) := by
    rw [←Real.rpow_natCast,←Real.rpow_add (mul_pos hQ hd)]
    congr 1
    rw [Nat.cast_sub hnq]
    push_cast
    ring
  have hboxlin : (Q*d)^(p+2*p*q+2-q)*(Q*d)^q=(Q*d)^(p+2*p*q+2) := by
    rw [←pow_add]; congr 1; omega
  have hmain : d^2*d^(p+2*p*q+1)=d^(p+2*p*q+3) := by rw [←pow_add]; congr 1; omega
  have hlin : d*d^(p+2*p*q+1)=d^(p+2*p*q+2) := by rw [←pow_succ']
  have hpoor : (Q*d)^(p+2*p*q+3)/d^2=Q^(p+2*p*q+3)*d^(p+2*p*q+1) := by
    rw [mul_pow,show p+2*p*q+3=(p+2*p*q+1)+2 by omega,pow_add d]
    field_simp
  have hrich : (2*((p*q+2+2*M)*(2*t):ℕ)*n/(d^2/2))^((p:ℝ)⁻¹)*
      (Q*d)^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ)) =
      (4*((p*q+2+2*M)*(2*t):ℕ))^((p:ℝ)⁻¹)*Q^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ))*
        n^((p:ℝ)⁻¹)*d^(((p+2*p*q+3:ℕ):ℝ)-3/(p:ℝ)) := by
    have he : 2*((p*q+2+2*M)*(2*t):ℕ)*n/(d^2/2)=(4*((p*q+2+2*M)*(2*t):ℕ))*n/d^2 := by ring
    rw [he,Real.div_rpow (by positivity) (sq_nonneg d),Real.mul_rpow (by positivity) hn,
      Real.mul_rpow hQ.le hd.le]
    have hepow : (d^2)^((p:ℝ)⁻¹)=d^(2/(p:ℝ)) := by
      rw [←Real.rpow_natCast d 2,←Real.rpow_mul hd.le]
      norm_num
      congr 1
    rw [hepow]
    have hediv : d^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ))/d^(2/(p:ℝ))=
        d^(((p+2*p*q+3:ℕ):ℝ)-3/(p:ℝ)) := by
      rw [←Real.rpow_sub hd]
      congr 1
      ring
    calc
      _ = (4*((p*q+2+2*M)*(2*t):ℕ))^((p:ℝ)⁻¹)*Q^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ))*
          n^((p:ℝ)⁻¹)*(d^(((p+2*p*q+3:ℕ):ℝ)-1/(p:ℝ))/d^(2/(p:ℝ))) := by ring
      _ = _ := by rw [hediv]
  have he : countError p q t M K n d (Q*d) =
      (((p+2*p*q+4:ℕ):ℝ)^3*(Q*d)^(p+2*p*q+1)+4*(p+p*q:ℕ)*((Q*d)^(p+2*p*q+3)/d^2))*
        (2/(K:ℝ)*(Q*d)^2+(2*(p:ℝ)*q+7)*(Q*d))+
      (2*p*(p+p*q:ℕ)*((q:ℝ)^2+1))*((Q*d)^(p+2*p*q+2-q)*(Q*d)^q)+
      2*(p+p*q:ℕ)*((2*((p*q+2+2*M)*(2*t):ℕ)*n/(d^2/2))^((p:ℝ)⁻¹)*
        ((Q*d)^(p+2*p*q+2-q)*(Q*d)^((q:ℝ)+1-1/(p:ℝ)))) := by
    unfold countError boxEstimate
    rw [show p+2*p*q+3=(p+2*p*q+2)+1 by omega,pow_succ]
    ring
  rw [he,hboxlin,hrichpow,hrich,hpoor]
  simp only [mul_pow]
  have hheavy : ((p+2*p*q+4:ℕ):ℝ)^3*(Q^(p+2*p*q+1)*d^(p+2*p*q+1))+
      4*(p+p*q:ℕ)*(Q^(p+2*p*q+3)*d^(p+2*p*q+1))=heavyCoeff p q Q*d^(p+2*p*q+1) := by
    unfold heavyCoeff
    ring
  rw [hheavy]
  calc
    _ = (2*heavyCoeff p q Q*Q^2/(K:ℝ))*(d^2*d^(p+2*p*q+1))+
        (heavyCoeff p q Q*(2*(p:ℝ)*q+7)*Q)*(d*d^(p+2*p*q+1))+
        (2*p*(p+p*q:ℕ)*((q:ℝ)^2+1)*Q^(p+2*p*q+2))*d^(p+2*p*q+2)+
        richCoeff p q t M Q*n^((p:ℝ)⁻¹)*d^(((p+2*p*q+3:ℕ):ℝ)-3/(p:ℝ)) := by
      unfold richCoeff
      ring
    _ = _ := by rw [hmain,hlin]; unfold linearCoeff; ring

lemma countError_le (p q t M K : ℕ) (hp : 1≤p) {n d Q s : ℝ}
    (hn : 0≤n) (hd : 0<d) (hQ : 0<Q) (hns : n≤d^s) :
    countError p q t M K n d (Q*d) ≤
      (2*heavyCoeff p q Q*Q^2/(K:ℝ))*d^(p+2*p*q+3)+linearCoeff p q Q*d^(p+2*p*q+2)+
      richCoeff p q t M Q*d^(((p+2*p*q+3:ℕ):ℝ)+(s-3)/(p:ℝ)) := by
  rw [countError_eq p q t M K hp hn hd hQ]
  apply add_le_add le_rfl
  have h := Real.rpow_le_rpow hn hns (show 0≤(p:ℝ)⁻¹ by positivity)
  have hr : 0≤richCoeff p q t M Q := by unfold richCoeff; positivity
  have hb := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h hr)
    (Real.rpow_nonneg hd.le (((p+2*p*q+3:ℕ):ℝ)-3/(p:ℝ)))
  apply hb.trans_eq
  rw [←Real.rpow_mul hd.le,mul_assoc,←Real.rpow_add hd]
  congr 2
  ring

lemma exists_error_threshold (p q M : ℕ) (hp : 1≤p) (hq : 2≤q) (Q : ℝ) (hQ : 1≤Q) :
    ∃K : ℕ, 1≤K ∧ ∃L : ℝ, 4*(p+2*p*q+5:ℕ)≤L ∧
      4*(p*q+1:ℕ)*heavyThreshold p q M K+1≤L ∧
      ∀n d : ℝ, 0≤n → L≤d → n≤d^(((p+2*p*q+3:ℕ):ℝ)/(p*q+1:ℕ)) →
        countError p q (heavyThreshold p q M K) M K n d (Q*d)≤(d/4)^(p+2*p*q+3)/2 := by
  let k := p+2*p*q+3
  let h := p+2*p*q+2
  let s : ℝ := (k:ℝ)/(p*q+1:ℕ)
  let e : ℝ := (k:ℝ)+(s-3)/(p:ℝ)
  let A : ℝ := heavyCoeff p q Q
  have hQpos : 0<Q := by linarith
  have hApos : 0<A := by dsimp [A,heavyCoeff]; positivity
  obtain ⟨K,hK⟩ := exists_nat_gt (8*A*Q^2*4^k)
  have hKpos : (0:ℝ)<K := lt_trans (by positivity) hK
  have hK1 : 1≤K := by exact_mod_cast (show 0<K by exact_mod_cast hKpos)
  have hsmall : 2*A*Q^2/(K:ℝ)≤1/(4*4^k) := by
    apply (div_le_div_iff₀ hKpos (by positivity)).mpr
    nlinarith
  let t := heavyThreshold p q M K
  let B := linearCoeff p q Q
  let C := richCoeff p q t M Q
  have hhk : (h:ℝ)<k := by dsimp [h,k]; push_cast; linarith
  have hs : s<3 := by
    apply (div_lt_iff₀ (by positivity : (0:ℝ)<(p*q+1:ℕ))).mpr
    have he : p+2*p*q+3<3*(p*q+1) := by nlinarith
    exact_mod_cast he
  have hp0 : (0:ℝ)<p := by exact_mod_cast (show 0<p by omega)
  have hek : e<(k:ℝ) := by
    dsimp [e]
    have hh : (s-3)/(p:ℝ)<0 := div_neg_of_neg_of_pos (by linarith) hp0
    linarith
  have ho : (fun d : ℝ => B*d^(h:ℝ)+C*d^e)=o[atTop] (fun d => d^(k:ℝ)) :=
    ((ThetaFour.rpow_littleO hhk).const_mul_left B).add ((ThetaFour.rpow_littleO hek).const_mul_left C)
  obtain ⟨L,hL⟩ := eventually_atTop.mp (ho.def (c := 1/(4*4^k)) (by positivity))
  let L' : ℝ := max (max (4*(p+2*p*q+5:ℕ)) (4*(p*q+1:ℕ)*t+1)) L
  refine ⟨K,hK1,L',(le_max_left _ _).trans (le_max_left _ _),
    (le_max_right _ _).trans (le_max_left _ _),?_⟩
  intro n d hn hd hns
  have hdpos : 0<d := lt_of_lt_of_le (by dsimp [L']; positivity) hd
  have hbound := hL d ((le_max_right _ _).trans hd)
  rw [Real.norm_eq_abs,Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hdpos.le _)] at hbound
  have herr := (le_abs_self (B*d^(h:ℝ)+C*d^e)).trans hbound
  have hmain := mul_le_mul_of_nonneg_right hsmall (pow_nonneg hdpos.le k)
  have hcount := countError_le p q t M K hp hn hdpos hQpos hns
  have hh : countError p q t M K n d (Q*d)≤2*(1/(4*4^k)*d^k) := by
    change countError p q t M K n d (Q*d)≤(2*A*Q^2/(K:ℝ))*d^k+B*d^h+C*d^e at hcount
    simp only [Real.rpow_natCast] at herr
    linarith
  exact hh.trans_eq (by dsimp [k]; rw [div_pow]; ring)

end Erdos571.CenterArmFan


/-! ## IndexedWeightedBalance -/


/-! Balanced allocations on an injectively indexed collection of graph edges. -/
namespace Erdos571.WeightedBalance
open Finset SimpleGraph RootedSunflower
variable {A R E : Type} [Fintype A] [Fintype R] [Fintype E]

lemma indexed_balance (H : SimpleGraph (A⊕R)) [DecidableRel H.Adj]
    (edge : E → H.edgeSet) (he : Function.Injective edge)
    (w : A → E → ℚ) (a b : ℕ) (ha : 0<a)
    (hw : ∀v e, 0≤w v e) (hsupport : ∀v e, Sum.inl v∉(edge e).val → w v e=0)
    (hrow : ∀v, (b:ℚ)/(a:ℚ)≤∑e, w v e) (hcol : ∀e, (∑v, w v e)≤1) :
    ∀C : Finset A, b*(Fintype.card A-C.card)≤a*Nat.card (PetalEdge H C) := by
  classical
  intro C
  let S : Finset A := univ\C
  let T := univ.filter (fun e : E => ∃v, v∉C ∧ Sum.inl v∈(edge e).val)
  have hS : S.card=Fintype.card A-C.card := by simp only [S,card_sdiff,inter_univ,card_univ]
  have hb (e : E) : (∑v∈S, w v e)≤ if e∈T then (1:ℚ) else 0 := by
    split_ifs with ht
    · exact (sum_le_sum_of_subset_of_nonneg (subset_univ S) (fun v _ _ => hw v e)).trans (hcol e)
    · apply le_of_eq
      apply sum_eq_zero
      intro v hv
      apply hsupport
      intro hm
      exact ht (mem_filter.mpr ⟨mem_univ _,v,(mem_sdiff.mp hv).2,hm⟩)
  let f : T → PetalEdge H C := fun e => ⟨edge e.val,(mem_filter.mp e.property).2⟩
  have hf : Function.Injective f := by
    intro e e' h
    exact Subtype.ext (he (congrArg Subtype.val h))
  have hc : T.card≤Nat.card (PetalEdge H C) := by
    simpa only [Fintype.card_coe,Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hf
  have hh := sum_le_sum (s := univ) (fun e _ => hb e)
  rw [sum_comm] at hh
  have hr := sum_le_sum (s := S) (fun v _ => hrow v)
  have hsum : (∑e : E, if e∈T then (1:ℚ) else 0)=(T.card:ℚ) := by simp
  rw [hsum] at hh
  have hd : (b:ℚ)/a*(Fintype.card A-C.card:ℕ)≤Nat.card (PetalEdge H C) := by
    calc
      _ = ∑_v∈S, (b:ℚ)/a := by simp [hS,mul_comm]
      _ ≤ _ := (hr.trans hh).trans (by exact_mod_cast hc)
  have haq : (0:ℚ)<a := by exact_mod_cast ha
  have hx := mul_le_mul_of_nonneg_left hd haq.le
  rw [←mul_assoc,mul_div_cancel₀ _ haq.ne'] at hx
  exact_mod_cast hx

end Erdos571.WeightedBalance


/-! ## CenterArmFanBalance -/


/-! A fractional balance certificate for the center-arm fan. -/
set_option linter.unusedSimpArgs false
namespace Erdos571.CenterArmFan
open Finset SimpleGraph RootedSunflower

abbrev Edge (p q : ℕ) := Fin p ⊕ (Unit ⊕ (Arms p q ⊕ Arms p q))

def edge {p q : ℕ} : Edge p q → (template p q).edgeSet
  | .inl i => ⟨s(center p q,hub i),adj_hub (q := q) i⟩
  | .inr (.inl _) => ⟨s(center p q,short p q),adj_short p q⟩
  | .inr (.inr (.inl i)) => ⟨s(.inl (.inl (attach i)),.inl (.inr i)),rfl⟩
  | .inr (.inr (.inr i)) => ⟨s(.inl (.inr i),.inr (.inr i)),rfl⟩

lemma edge_injective (p q : ℕ) : Function.Injective (@edge p q) := by
  intro e f h
  have hh := congrArg Subtype.val h
  rcases e with i|(u|(i|i))
  all_goals rcases f with j|(v|(j|j))
  all_goals simp only [edge,center,hub,short,Sym2.eq_iff,Prod.mk.injEq,Sum.inl.injEq,Sum.inr.injEq,
    Sum.inl_ne_inr,Sum.inr_ne_inl,not_false_eq_true,false_and,and_false,false_or,or_false,
    true_and,and_true] at hh
  all_goals first
    | contradiction
    | subst_vars; rfl
    | rcases hh with ⟨h1,h2⟩; subst j; rfl
    | exact congrArg Sum.inl hh

def allocation {p q : ℕ} (ρ δ : ℚ) : Interior p q → Edge p q → ℚ
  | .inl (.inl _), .inl _ => δ
  | .inl (.inr i), .inl j => if i=j then 1-δ else 0
  | .inl (.inl _), .inr (.inl _) => 1
  | .inl a, .inr (.inr (.inl i)) => if a=attach i then 2-ρ else 0
  | .inr i, .inr (.inr (.inl j)) => if i=j then ρ-1 else 0
  | .inr i, .inr (.inr (.inr j)) => if i=j then 1 else 0
  | _,_ => 0

lemma allocation_nonneg (p q : ℕ) {ρ δ : ℚ} (hρ : 1≤ρ) (hρ2 : ρ≤2)
    (hδ : 0≤δ) (hδ1 : δ≤1) : ∀a e, 0≤@allocation p q ρ δ a e := by
  rintro ((a|i)|i) (j|(u|(j|j)))
  all_goals simp only [allocation]
  all_goals (try split_ifs) <;> linarith

lemma allocation_support (p q : ℕ) (ρ δ : ℚ) :
    ∀a e, Sum.inl a∉(edge e).val → @allocation p q ρ δ a e=0 := by
  rintro ((a|i)|i) (j|(u|(j|j))) h
  all_goals simp only [edge,center,hub,short,Sym2.mem_iff,Sum.inl.injEq,Sum.inr.injEq,
    Sum.inl_ne_inr,Sum.inr_ne_inl,or_false,false_or] at h
  all_goals simp only [allocation]
  all_goals first | rfl | exact if_neg (by tauto) | skip
  all_goals have ha : a=0 := Subsingleton.elim _ _
  all_goals subst a
  all_goals tauto

lemma allocation_column (p q : ℕ) (ρ δ : ℚ) (e : Edge p q) :
    (∑a : Interior p q, allocation ρ δ a e)=1 := by
  rcases e with i|(u|(i|i))
  all_goals simp only [Fintype.sum_sum_type,allocation]
  · simp
  · simp
  · cases i with
    | none => simp [attach]; ring
    | some i => simp [attach]; ring
  · simp

lemma allocation_center_row (p q : ℕ) (ρ δ : ℚ) (a : Fin 1) :
    (∑e : Edge p q, allocation ρ δ (.inl (.inl a)) e)=p*δ+1+(2-ρ) := by
  have ha : a=0 := Subsingleton.elim _ _
  subst a
  simp [Fintype.sum_sum_type,Fintype.sum_option,allocation,attach] <;> ring

lemma allocation_hub_row (p q : ℕ) (ρ δ : ℚ) (i : Fin p) :
    (∑e : Edge p q, allocation ρ δ (.inl (.inr i)) e)=1-δ+q*(2-ρ) := by
  simp only [Fintype.sum_sum_type,Fintype.sum_option,Fintype.sum_prod_type,allocation,attach]
  simp only [sum_ite_irrel,sum_const_zero,Sum.inr.injEq,Sum.inr_ne_inl,if_false,
    sum_ite_eq,sum_ite_eq',mem_univ,if_true,sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,
    add_zero,zero_add]

lemma allocation_middle_row (p q : ℕ) (ρ δ : ℚ) (i : Arms p q) :
    (∑e : Edge p q, allocation ρ δ (.inr i) e)=ρ := by
  simp [Fintype.sum_sum_type,allocation]

lemma balanced (p q : ℕ) (hp : 1≤p) (hq : 1≤q) :
    ∀C : Finset (Interior p q), (p+2*p*q+3)*(Fintype.card (Interior p q)-C.card)≤
      (p+p*q+2)*Nat.card (PetalEdge (template p q) C) := by
  classical
  let a : ℚ := p+p*q+2
  let b : ℚ := p+2*p*q+3
  let ρ := b/a
  let δ : ℚ := (q-1)/a
  have ha : 0<a := by dsimp [a]; positivity
  have hp' : (1:ℚ)≤p := by exact_mod_cast hp
  have hq' : (1:ℚ)≤q := by exact_mod_cast hq
  have hρ : 1≤ρ := by dsimp [ρ]; apply (le_div_iff₀ ha).mpr; dsimp [a,b]; nlinarith
  have hρ2 : ρ≤2 := by dsimp [ρ]; apply (div_le_iff₀ ha).mpr; dsimp [a,b]; nlinarith
  have hδ : 0≤δ := div_nonneg (by linarith) ha.le
  have hδ1 : δ≤1 := by dsimp [δ]; apply (div_le_one ha).mpr; dsimp [a]; nlinarith
  apply WeightedBalance.indexed_balance (template p q) edge (edge_injective p q)
    (allocation ρ δ) (p+p*q+2) (p+2*p*q+3) (by omega)
    (allocation_nonneg p q hρ hρ2 hδ hδ1) (allocation_support p q ρ δ) ?_
    (fun e => (allocation_column p q ρ δ e).le)
  rintro ((i|i)|i)
  · rw [allocation_center_row]
    have he : (p:ℚ)*δ+1+(2-ρ)=ρ := by dsimp [ρ,δ,a,b]; field_simp; ring
    rw [he]
    exact le_of_eq (by dsimp [ρ,a,b]; push_cast; rfl)
  · rw [allocation_hub_row]
    have he : 1-δ+(q:ℚ)*(2-ρ)=ρ := by dsimp [ρ,δ,a,b]; field_simp; ring
    rw [he]
    exact le_of_eq (by dsimp [ρ,a,b]; push_cast; rfl)
  · rw [allocation_middle_row]
    exact le_of_eq (by dsimp [ρ,a,b]; push_cast; rfl)

end Erdos571.CenterArmFan


/-! ## CenterArmFanLower -/


/-! Exact-exponent lower bounds for the center-arm fan powers. -/
namespace Erdos571.CenterArmFan
open SimpleGraph

lemma exists_lower (p q : ℕ) (hp : 1≤p) (hq : 1≤q) :
    ∃M : ℕ, 2≤M ∧ Asymptotics.IsBigO Filter.atTop
      (fun n : ℕ => (n:ℝ)^((2:ℝ)-(p+p*q+2:ℕ)/(p+2*p*q+3:ℕ)))
      (fun n : ℕ => (extremalNumber n (graph p q M):ℝ)) := by
  classical
  exact FullRootedPower.exact_lower (template p q) (no_isolated p q)
    (p+p*q+2) (p+2*p*q+3) (by omega) (by nlinarith) (balanced p q hp hq)

end Erdos571.CenterArmFan


/-! ## CenterArmFanUpper -/


/-! Sharp ordinary upper bounds for homogeneous fan powers. -/
namespace Erdos571.CenterArmFan
set_option maxHeartbeats 2000000
open Finset SimpleGraph DensityRegularization ProjectionHeavy

noncomputable def degreeBase (p q M K : ℕ) : ℝ :=
  2*4^(p+2*p*q+3)*(M*(p+p*q+2)*copyLoad (heavyThreshold p q M K) p q M:ℕ)

noncomputable def degreeCoefficient (p q M K : ℕ) : ℝ :=
  (degreeBase p q M K)^(((p+2*p*q+3:ℕ):ℝ)⁻¹)

lemma degreeCoefficient_nonneg (p q M K : ℕ) : 0≤degreeCoefficient p q M K := by
  unfold degreeCoefficient degreeBase
  positivity

lemma large_degree_bound {W : Type} [Fintype W] [DecidableEq W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (U : Finset W) (hU : U.Nonempty)
    (p q M K : ℕ) (hp : 1≤p) (hq : 1≤q) (hM : 1≤M) (hf : (graph p q M).Free G)
    (g : W → Bool) (hg : ∀{u v}, G.Adj u v → g u≠g v)
    {Q d : ℝ} (hQ : 1≤Q) (hd : 0<d) (hdlarge : 4*(p+2*p*q+5:ℕ)≤d)
    (hlarge : 2*(p*q+1:ℕ)*heavyThreshold p q M K≤d^2/2)
    (herr : countError p q (heavyThreshold p q M K) M K U.card d (Q*d)≤(d/4)^(p+2*p*q+3)/2) (hK : 1≤K)
    (hdeg : ∀v∈U, d≤((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ)≤Q*d) :
    d≤degreeCoefficient p q M K*(U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) := by
  classical
  have hn : (0:ℝ)<U.card := by exact_mod_cast card_pos.mpr hU
  have hD : 0≤Q*d := by positivity
  let F := TreeCopiesIn.copies (template p q) G U
  have hl : (U.card:ℝ)*(d/4)^(p+2*p*q+3)≤F.card := by
    have hh := TreeCopiesIn.lower (template p q) (isTree p q) G U (d := d) (by
      simp only [card_vertex p q,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat]
      push_cast at hdlarge
      linarith)
      (fun v hv => (hdeg v hv).1)
    simpa only [card_vertex p q,Nat.add_sub_cancel] using hh
  have hd1 : 1≤d := (show (1:ℝ)≤4*(p+2*p*q+5:ℕ) by norm_cast; omega).trans hdlarge
  have hD1 : 1≤Q*d := by nlinarith
  have ht : 1≤heavyThreshold p q M K := by
    have hpos : 0<heavyThreshold p q M K := by
      dsimp [heavyThreshold,vertexCount,RepeatedHeavyRoots.vertexBound]
      simp only [Fintype.card_option,Fintype.card_sum,Fintype.card_prod,Fintype.card_fin,Fintype.card_unit]
      positivity
    omega
  have hu := all_count G U (heavyThreshold p q M K) p q M ht hp hq hf hd hD1 hlarge
    hdeg F (fun f hf => (TreeCopiesIn.mem_copies _ _ _ _).mp hf)
  have hbad := badPairs_sum_bound G g hg U p q M K hK hf hD (fun v hv => (hdeg v hv).2)
  have hb := mul_le_mul_of_nonneg_right hbad
    (show 0≤(((p+2*p*q+4:ℕ):ℝ))^3*(Q*d)^(p+2*p*q+1) by positivity)
  have hbpoor := mul_le_mul_of_nonneg_right hbad
    (show 0≤(p+p*q:ℕ)*4*(Q*d)/d^2*(Q*d)^(p+2*p*q+2) by positivity)
  let C : ℝ := (M*(p+p*q+2)*copyLoad (heavyThreshold p q M K) p q M:ℕ)
  have hc : (U.card:ℝ)*(d/4)^(p+2*p*q+3)≤C*(U.card:ℝ)^(p*q+2)+
      U.card*countError p q (heavyThreshold p q M K) M K U.card d (Q*d) := by
    dsimp [C,countError]
    linear_combination hl + hu + hb + hbpoor
  have he := mul_le_mul_of_nonneg_left herr hn.le
  have hm : (U.card:ℝ)*(d/4)^(p+2*p*q+3)≤2*C*(U.card:ℝ)^(p*q+2) := by linarith
  have hm' := mul_le_mul_of_nonneg_right hm (show 0≤(4:ℝ)^(p+2*p*q+3) by positivity)
  have heq : (U.card:ℝ)*(d/4)^(p+2*p*q+3)*4^(p+2*p*q+3)=U.card*d^(p+2*p*q+3) := by
    rw [div_pow]; field_simp
  rw [heq,pow_succ (U.card:ℝ) (p*q+1)] at hm'
  have hpower : d^(p+2*p*q+3)≤degreeBase p q M K*(U.card:ℝ)^(p*q+1) := by
    apply (mul_le_mul_iff_left₀ hn).mp
    dsimp [degreeBase]
    dsimp [C] at hm'
    nlinarith
  exact LongSpider.degree_of_power (p+2*p*q+3) (p*q+1) (by omega) hn.le hd.le (by unfold degreeBase; positivity) hpower

/-- The almost-regular estimate for a properly colored host. -/
theorem exists_regular_bound (p q M : ℕ) (hp : 1≤p) (hq : 2≤q) (hM : 1 ≤ M)
    (Q : ℝ) (hQ : 1 ≤ Q) : ∃D : ℝ, 0 ≤ D ∧
      ∀ (W : Type) (_ : Fintype W) (_ : DecidableEq W) (G : SimpleGraph W) (_ : DecidableRel G.Adj) (g : W → Bool),
        (∀{u v}, G.Adj u v → g u≠g v) → (graph p q M).Free G → ∀ (U : Finset W) (d : ℝ), 0 < d →
          (∀v∈U, d ≤ ((neighbors G U v).card:ℝ) ∧ ((neighbors G U v).card:ℝ) ≤ Q*d) →
          ((arcs G U).card:ℝ) ≤ D*(U.card:ℝ)^(1+((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) := by
  obtain ⟨K,hK,L,hLs,hLa,herr⟩ := exists_error_threshold p q M hp hq Q hQ
  let B := degreeCoefficient p q M K+1
  have hB : 0 ≤ B := by dsimp [B]; have := degreeCoefficient_nonneg p q M K; linarith
  have hL : 0≤L := le_trans (by positivity) hLs
  refine ⟨Q*(L+B),by have hL : 0≤L := le_trans (by positivity) hLs; positivity,?_⟩
  intro W _ _ G _ g hg hf U d hd hdeg
  classical
  by_cases hU : U.Nonempty
  swap
  · have hUe : U=∅ := not_nonempty_iff_eq_empty.mp hU
    simp only [hUe,arcs,empty_product,filter_empty,card_empty,Nat.cast_zero]
    positivity
  have hn1 : (1:ℝ) ≤ U.card := by exact_mod_cast card_pos.mpr hU
  have hn : (0:ℝ) < U.card := by linarith
  have hnγ : 1 ≤ (U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) := Real.one_le_rpow hn1 (by positivity)
  have hdmax : d ≤ (L+B)*(U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) := by
    by_cases hdl : d ≤ L
    · have hL : 0≤L := le_trans (by positivity) hLs
      nlinarith
    · have hdL : L≤d := le_of_not_ge hdl
      by_cases hdn : d≤(U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ))
      · have hL0 : 0≤L := le_trans (by positivity) hLs
        have hBc : 0≤degreeCoefficient p q M K := degreeCoefficient_nonneg p q M K
        dsimp [B]
        nlinarith
      have hns : (U.card:ℝ)≤d^(((p+2*p*q+3:ℕ):ℝ)/(p*q+1:ℕ)) := by
        have h := Real.rpow_le_rpow (show 0≤(U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) by positivity)
          (le_of_not_ge hdn) (show 0≤((p+2*p*q+3:ℕ):ℝ)/(p*q+1:ℕ) by positivity)
        rw [←Real.rpow_mul hn.le] at h
        have he : (((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ))*(((p+2*p*q+3:ℕ):ℝ)/(p*q+1:ℕ))=1 := by
          have h1 : ((p*q+1:ℕ):ℝ)≠0 := by positivity
          have h2 : ((p+2*p*q+3:ℕ):ℝ)≠0 := by positivity
          field_simp
        simpa only [he,Real.rpow_one] using h
      have hlarge : 2*(p*q+1:ℕ)*heavyThreshold p q M K≤d^2/2 := by
        have hh := hLa.trans hdL
        have ht : (0:ℝ)≤(p*q+1:ℕ)*heavyThreshold p q M K := by positivity
        nlinarith
      have hl := large_degree_bound G U hU p q M K hp (by omega) hM hf g hg hQ hd
        (hLs.trans hdL) hlarge (herr U.card d hn.le hdL hns) hK hdeg
      have hnn : 0 ≤ (U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) := by positivity
      have hL0 : 0≤L := le_trans (by positivity) hLs
      dsimp [B]
      nlinarith
  have he : ((arcs G U).card:ℝ)=∑v∈U, ((neighbors G U v).card:ℝ) := by exact_mod_cast arcs_sum G U
  rw [he]
  calc
    _ ≤ ∑_v∈U,Q*d := sum_le_sum (fun v hv => (hdeg v hv).2)
    _ = (U.card:ℝ)*Q*d := by simp; ring
    _ ≤ (U.card:ℝ)*Q*((L+B)*(U.card:ℝ)^(((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ))) :=
      mul_le_mul_of_nonneg_left hdmax (by positivity)
    _ = _ := by rw [Real.rpow_add hn,Real.rpow_one]; ring

/-- Sharp ordinary upper bound for each fixed spider power. -/
theorem edge_bound (p q M : ℕ) (hp : 1≤p) (hq : 2≤q) (hM : 1 ≤ M) :
    ∃D : ℝ, 0 ≤ D ∧ EdgeBound (graph p q M) (1+((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) D := by
  let γ : ℝ := ((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)
  have hγ : 0 < γ := by
    have hs0 : (0:ℝ)<(p*q:ℕ) := by exact_mod_cast Nat.mul_pos (by omega : 0<p) (by omega : 0<q)
    dsimp [γ]
    positivity
  have hγ1 : γ ≤ 1 := by
    dsimp [γ]
    apply (div_le_one (by positivity)).mpr
    exact_mod_cast (show p*q+1 ≤ p+2*p*q+3 by nlinarith)
  let K : ℝ := (16:ℝ)^(γ⁻¹)
  have hK : 0 < K := by dsimp [K]; positivity
  have hK1 : 1 ≤ K := Real.one_le_rpow (by norm_num) (by positivity)
  have hKpow : 16 ≤ K^((1+γ)-1) := by
    dsimp [K]
    rw [add_sub_cancel_left,Real.rpow_inv_rpow (by norm_num) hγ.ne']
  obtain ⟨D,hD,hreg⟩ := exists_regular_bound p q M hp hq hM (8*K) (by linarith)
  refine ⟨4*D,by positivity,⟨?_⟩⟩
  intro W _ G hf
  classical
  obtain ⟨F,hFG,g,hg,hhalf⟩ := OrdinaryCone.exists_colored_subgraph G
  have hfree : (graph p q M).Free F := fun h => hf (h.trans (IsContained.of_le hFG))
  have hb := bound_of_almost_regular F univ (β:=1+γ) (K:=K) (D:=D)
    (by linarith) (by linarith) hK hKpow hD (by
      intro T hT d hd hdeg
      exact hreg W inferInstance inferInstance F inferInstance g hg hfree T d hd hdeg)
  have harcs : (arcs F univ).card=2*Nat.card F.edgeSet := by
    rw [arcs_sum]
    have hn (w : W) : neighbors F univ w=F.neighborFinset w := by
      ext v; simp [neighbors]
    simp_rw [hn,card_neighborFinset_eq_degree]
    simpa only [Nat.card_eq_fintype_card,card_edgeSet] using F.sum_degrees_eq_twice_card_edges
  rw [harcs,card_univ,Nat.cast_mul,Nat.cast_ofNat] at hb
  exact (show (Nat.card G.edgeSet:ℝ) ≤ 2*(Nat.card F.edgeSet:ℝ) by exact_mod_cast hhalf).trans hb

end Erdos571.CenterArmFan


/-! ## CenterArmFanFamily -/


/-! Exact two-level fan exponents, and their paired cones. -/
namespace Erdos571.CenterArmFan
open Finset SimpleGraph OrdinaryRooted

lemma exponent_eq (p q : ℕ) :
    1+((p*q+1:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)=2-((p+p*q+2:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ) := by
  have hden : ((p+2*p*q+3:ℕ):ℝ)≠0 := by positivity
  push_cast
  field_simp
  <;> ring

theorem supported (p q : ℕ) (hp : 1≤p) (hq : 2≤q) :
    Supported (template p q) (2-((p+p*q+2:ℕ):ℝ)/((p+2*p*q+3:ℕ):ℝ)) := by
  intro M hM
  obtain ⟨D,hD,hbound⟩ := edge_bound p q M hp hq (by omega)
  rw [exponent_eq] at hbound
  exact ⟨D,hD,hbound⟩

theorem certificate (p q : ℕ) (hp : 1≤p) (hq : 2≤q) : Certificate (p+p*q+2) (p+2*p*q+3) :=
  ⟨Interior p q,Root p q,inferInstance,inferInstance,inferInstance,inferInstance,
    template p q,color,color_proper p q,connected p q,no_isolated p q,
    balanced p q hp (by omega),supported p q hp hq⟩

theorem iterated_certificate (p q t : ℕ) (hp : 1≤p) (hq : 2≤q) :
    Certificate (p+p*q+2) (p+2*p*q+3+t*(p+p*q+2)) := by
  induction t with
  | zero => simpa using certificate p q hp hq
  | succ t ih =>
    have h := ih.cone (by omega) (by simp only [Nat.mul_assoc]; omega)
    have he : p+2*p*q+3+(t+1)*(p+p*q+2)=p+2*p*q+3+t*(p+p*q+2)+(p+p*q+2) := by ring
    simpa only [Nat.succ_eq_add_one,he] using h

theorem exact_family (p q t : ℕ) (hp : 1≤p) (hq : 2≤q) :
    ∃N : ℕ, ∃G : SimpleGraph (Fin N), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((2-(p+p*q+2:ℚ)/(p+2*p*q+3+t*(p+p*q+2):ℚ):ℚ):ℝ)) := by
  have h := (iterated_certificate p q t hp hq).realizes (by omega) (by simp only [Nat.mul_assoc]; omega)
  push_cast at h ⊢
  exact h

theorem exponent_twenty_four_seventeenths :
    ∃N : ℕ, ∃G : SimpleGraph (Fin N), G.IsBipartite ∧
      Asymptotics.IsTheta Filter.atTop
        (fun n : ℕ => (extremalNumber n G:ℝ))
        (fun n : ℕ => (n:ℝ)^((24/17:ℚ):ℝ)) := by
  have h := exact_family 2 3 0 (by omega) (by omega)
  norm_num at h ⊢
  exact h

end Erdos571.CenterArmFan

/- Counting rich boundary-component layouts by their complementary footprints,
then averaging only those roots which have not already been prescribed. -/
namespace Erdos571.BoundaryComponentPruning
open Finset SimpleGraph RootedPruningClosure

lemma rich_bounded_load_count {A R W : Type} [Fintype A] [Fintype R]
    [DecidableEq A] [DecidableEq R] [DecidableEq W]
    (H : SimpleGraph (A ⊕ R)) (G : SimpleGraph W) (S : Finset (A ⊕ R))
    (hS : S.Nonempty) (hrem : (remaining S).Nonempty)
    (hnon : ∀v∈S, ∃a : A, v=.inl a)
    (M p B : ℕ) (hM : 0<M) (hB : 0<B) (hf : (FullRootedPower.graph H M).Free G)
    (F : Finset (H.Copy G)) (r : R ↪ W)
    (hroot : ∀f∈F, ∀s, f (.inr s)=r s)
    (hpack : ∀f∈F, PackedAt (graph H S) G (fun r : Root H S => f r) p)
    (hp : (Fintype.card (A ⊕ R)+S.card)*M<p)
    (hload : ∀w, (F.filter (fun f => w∈interiorOn f (remaining S))).card≤B) :
    F.card<M*(remaining S).card*B := by
  classical
  by_contra! hc
  have hfoot (f : H.Copy G) : (interiorOn f (remaining S)).card≤(remaining S).card := by
    exact card_image_le
  obtain ⟨T,hTF,hTM,hdis⟩ := RootedPacking.disjoint_footprints F
    (fun f => interiorOn f (remaining S)) (remaining S).card B M
    (card_pos.mpr hrem) hB (fun f _ => hrem.image _) (fun f _ => hfoot f) hload hc
  exact no_complement_packing H G S hS hnon M p hM hf F r hroot hpack hp ⟨T,hTF,hTM,hdis⟩

lemma rich_partial_roots_bound {A R₀ R₁ W : Type} [Fintype A] [Fintype R₀] [Fintype R₁]
    [DecidableEq A] [DecidableEq R₀] [DecidableEq R₁] [DecidableEq W]
    (H : SimpleGraph (A ⊕ (R₀ ⊕ R₁))) (G : SimpleGraph W)
    (S : Finset (A ⊕ (R₀ ⊕ R₁)))
    (hS : S.Nonempty) (hrem : (remaining S).Nonempty)
    (hnon : ∀v∈S, ∃a : A, v=.inl a)
    (M p B : ℕ) (hM : 0<M) (hB : 0<B) (hf : (FullRootedPower.graph H M).Free G)
    (F : Finset (H.Copy G)) (r₀ : R₀ → W) (U : Finset W)
    (hold : ∀f∈F, ∀s, f (.inr (.inl s))=r₀ s)
    (hmem : ∀f∈F, ∀s : R₁, f (.inr (.inr s))∈U)
    (hpack : ∀f∈F, PackedAt (graph H S) G (fun r : Root H S => f r) p)
    (hp : (Fintype.card (A ⊕ (R₀ ⊕ R₁))+S.card)*M<p)
    (hload : ∀r : R₁ → W, ∀w,
      ((F.filter (fun f => (fun s : R₁ => f (.inr (.inr s)))=r)).filter
        (fun f => w∈interiorOn f (remaining S))).card≤B) :
    (F.card:ℝ)≤(M*(remaining S).card*B:ℕ)*(U.card:ℝ)^(Fintype.card R₁) := by
  classical
  let roots : H.Copy G → R₁ → W := fun f s => f (.inr (.inr s))
  have hb (r : R₁ → W) (hr : r∈F.image roots) :
      ((F.filter (fun f => roots f=r)).card:ℝ)≤(M*(remaining S).card*B:ℕ) := by
    obtain ⟨f₀,hf₀,he⟩ := mem_image.mp hr
    let allRoots : R₀ ⊕ R₁ ↪ W :=
      { toFun := fun r => f₀ (.inr r)
        inj' := f₀.injective.comp Sum.inr_injective }
    have hh := rich_bounded_load_count H G S hS hrem hnon M p B hM hB hf
      (F.filter (fun f => roots f=r)) allRoots (by
        intro f hff s
        rcases s with s|s
        · exact (hold f (mem_filter.mp hff).1 s).trans (hold f₀ hf₀ s).symm
        · exact congrFun ((mem_filter.mp hff).2.trans he.symm) s)
      (fun f hff => hpack f (mem_filter.mp hff).1) hp (hload r)
    exact_mod_cast hh.le
  have hc := RealFiberCount.bound F (F.image roots) roots
    (fun f hf => mem_image.mpr ⟨f,hf,rfl⟩) hb
  have hi : (F.image roots).card≤U.card^(Fintype.card R₁) := by
    let val : (F.image roots) → (R₁ → U) := fun r a => ⟨r.val a,by
      obtain ⟨f,hf,he⟩ := mem_image.mp r.property
      rw [←he]
      exact hmem f hf a⟩
    have hinj : Function.Injective val := by
      intro r r' he
      apply Subtype.ext
      funext a
      exact congrArg Subtype.val (congrFun he a)
    simpa only [Fintype.card_coe,Fintype.card_fun] using Fintype.card_le_of_injective val hinj
  have hi' : ((F.image roots).card:ℝ)≤(U.card:ℝ)^Fintype.card R₁ := by exact_mod_cast hi
  exact hc.trans ((mul_le_mul_of_nonneg_right hi' (Nat.cast_nonneg _)).trans_eq (mul_comm _ _))

/-- A lower bound on the number of layouts per center converts the preceding
partial-root estimate into a common-row bound. The layout supply and its
root-fiber pin loads remain explicit hypotheses. -/
lemma rich_rows_bound {A R₀ R₁ W : Type} [Fintype A] [Fintype R₀] [Fintype R₁]
    [DecidableEq A] [DecidableEq R₀] [DecidableEq R₁] [DecidableEq W]
    (H : SimpleGraph (A ⊕ (R₀ ⊕ R₁))) (G : SimpleGraph W)
    (S : Finset (A ⊕ (R₀ ⊕ R₁)))
    (hS : S.Nonempty) (hrem : (remaining S).Nonempty)
    (hnon : ∀v∈S, ∃a : A, v=.inl a)
    (M p B : ℕ) (hM : 0<M) (hB : 0<B) (hf : (FullRootedPower.graph H M).Free G)
    (F : Finset (H.Copy G)) (r₀ : R₀ → W) (U : Finset W)
    (hold : ∀f∈F, ∀s, f (.inr (.inl s))=r₀ s)
    (hmem : ∀f∈F, ∀s : R₁, f (.inr (.inr s))∈U)
    (hpack : ∀f∈F, PackedAt (graph H S) G (fun r : Root H S => f r) p)
    (hp : (Fintype.card (A ⊕ (R₀ ⊕ R₁))+S.card)*M<p)
    (hload : ∀r : R₁ → W, ∀w,
      ((F.filter (fun f => (fun s : R₁ => f (.inr (.inr s)))=r)).filter
        (fun f => w∈interiorOn f (remaining S))).card≤B)
    (center : H.Copy G → W) (C : Finset W) {L : ℝ} (hL : 0<L)
    (hsupply : ∀u∈C, L≤((F.filter (fun f => center f=u)).card:ℝ)) :
    (C.card:ℝ)≤(M*(remaining S).card*B:ℕ)*(U.card:ℝ)^(Fintype.card R₁)/L := by
  classical
  have hs : (C.card:ℝ)*L≤F.card := by
    have h₁ := sum_le_sum hsupply
    have h₂ : (∑u∈C, ((F.filter (fun f => center f=u)).card:ℝ))≤F.card := by
      have hn : (∑u∈C, (F.filter (fun f => center f=u)).card)≤F.card := by
        rw [sum_card_fiberwise_eq_card_filter]
        exact card_le_card (filter_subset _ _)
      exact_mod_cast hn
    simpa only [sum_const,nsmul_eq_mul] using h₁.trans h₂
  exact (le_div_iff₀ hL).mpr (hs.trans
    (rich_partial_roots_bound H G S hS hrem hnon M p B hM hB hf F r₀ U hold hmem hpack hp hload))

end Erdos571.BoundaryComponentPruning


