def colorMap (g : Groups) : Fin 7 → Fin 7 := (if g.val < 2 then (if g.val < 1 then color0 else color1) else (if g.val < 3 then color2 else (if g.val < 4 then color3 else color4)))
def colorInverse (g : Groups) : Fin 7 → Fin 7 := (if g.val < 2 then (if g.val < 1 then color0 else color1) else (if g.val < 3 then color2 else (if g.val < 4 then color3 else color4)))
def vertexMap (g : Groups) : W → W := (if g.val < 2 then (if g.val < 1 then vertex0 else vertex1) else (if g.val < 3 then vertex2 else (if g.val < 4 then vertex3 else vertex4)))
def vertexInverse (g : Groups) : W → W := (if g.val < 2 then (if g.val < 1 then vertex0 else vertex1) else (if g.val < 3 then vertex2 else (if g.val < 4 then vertex3 else vertex4)))
def data (g : Groups) : Fin 7 → ℕ → ℕ := (if g.val < 2 then (if g.val < 1 then data0 else data1) else (if g.val < 3 then data2 else (if g.val < 4 then data3 else data4)))
def rowImage (g : Groups) (i : Fin 7) (q : Fin (choices i)) : Fin (choices (colorMap g i)) :=
  ⟨data g i q.val % choices (colorMap g i),Nat.mod_lt _ (choices_pos _)⟩
def shift (g : Groups) (i : Fin 7) (q : Fin (choices i)) : ℕ :=
  data g i q.val / choices i % length i
def reversed (g : Groups) (i : Fin 7) (q : Fin (choices i)) : Bool :=
  decide (data g i q.val / choices i / length i = 1)
def edgeForward (g : Groups) (i : Fin 7) (q : Fin (choices i)) (j : Fin (length i)) :
    Fin (length (colorMap g i)) :=
  ⟨(if reversed g i q then shift g i q + length i - 1 - j.val else shift g i q + j.val) %
    length (colorMap g i),Nat.mod_lt _ (length_pos _)⟩
def edgeBackward (g : Groups) (i : Fin 7) (q : Fin (choices i)) (j : Fin (length (colorMap g i))) :
    Fin (length i) :=
  ⟨(if reversed g i q then shift g i q + length i - 1 - j.val else j.val + length i - shift g i q) %
    length i,Nat.mod_lt _ (length_pos _)⟩
def RowValid (g : Groups) (i : Fin 7) (q : Fin (choices i)) : Prop :=
  Function.LeftInverse (edgeBackward g i q) (edgeForward g i q) ∧
  Function.RightInverse (edgeBackward g i q) (edgeForward g i q) ∧
  ∀ j : Fin (length i),
    s(vertexMap g (word i q j),vertexMap g (word i q (j+1))) =
      s(word (colorMap g i) (rowImage g i q) (edgeForward g i q j),
        word (colorMap g i) (rowImage g i q) (edgeForward g i q j+1))
def BaseValid (g : Groups) : Prop :=
  Function.LeftInverse (colorInverse g) (colorMap g) ∧
  Function.RightInverse (colorInverse g) (colorMap g) ∧
  Function.LeftInverse (vertexInverse g) (vertexMap g)
def Valid (g : Groups) : Prop :=
  Function.LeftInverse (colorInverse g) (colorMap g) ∧
  Function.RightInverse (colorInverse g) (colorMap g) ∧
  Function.LeftInverse (vertexInverse g) (vertexMap g) ∧
  ∀ (i : Fin 7) (q : Fin (choices i)), RowValid g i q
instance (g : Groups) (i : Fin 7) (q : Fin (choices i)) : Decidable (RowValid g i q) := by
  unfold RowValid; infer_instance
instance (g : Groups) : Decidable (BaseValid g) := by unfold BaseValid; infer_instance
instance (g : Groups) : Decidable (Valid g) := by unfold Valid; infer_instance

def ValidAt (j : ℕ) : Prop := ∀ h : j < 5, Valid ⟨j,h⟩
instance (j : ℕ) : Decidable (ValidAt j) := by unfold ValidAt; infer_instance
end Erdos184Work.PureSevenGenerators
