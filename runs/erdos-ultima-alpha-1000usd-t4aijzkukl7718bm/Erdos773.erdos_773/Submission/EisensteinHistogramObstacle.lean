lemma eisenstein_histogram_digit_conditions :
    ∀ j : Fin 4,
      (eisensteinHistogramWords j).length = 995 ∧
      (eisensteinHistogramWords j).getLast? = some 1 ∧
      (eisensteinHistogramWords j).headD 0 % 9 = 3 ∧
      ∀ digit ∈ (eisensteinHistogramWords j).dropLast,
        digit < 81 ∧ 3 ∣ digit := by
  decide

lemma eisenstein_histogram_counts :
    ∀ (j : Fin 4) (digit : Fin 81),
      (eisensteinHistogramWords j).count digit.val =
        (eisensteinHistogramWords 0).count digit.val := by
  decide

lemma eisenstein_histogram_bounds :
    ∀ (j : Fin 4) (digit : ℕ), digit ∈ eisensteinHistogramWords j → digit < 81 := by
  decide

lemma eisenstein_histogram_permutation (j : Fin 4) :
    (eisensteinHistogramWords j).Perm (eisensteinHistogramWords 0) := by
  rw [List.perm_iff_count]
  intro digit
  by_cases hd : digit < 81
  · exact eisenstein_histogram_counts j ⟨digit, hd⟩
  · rw [List.count_eq_zero_of_not_mem (fun h => hd (eisenstein_histogram_bounds j digit h)),
      List.count_eq_zero_of_not_mem (fun h => hd (eisenstein_histogram_bounds 0 digit h))]

lemma eisenstein_histogram_additive_statistics {M : Type*} [AddCommMonoid M]
    (f : ℕ → M) (j : Fin 4) :
    ((eisensteinHistogramWords j).map f).sum =
      ((eisensteinHistogramWords 0).map f).sum := by
  exact ((eisenstein_histogram_permutation j).map f).sum_eq

lemma eisenstein_histogram_moments :
    ∀ j : Fin 4,
      (eisensteinHistogramWords j).sum = 38440 ∧
      ((eisensteinHistogramWords j).map (fun d => d ^ 2)).sum = 2130202 := by
  decide

lemma eisenstein_histogram_collision :
    (eisensteinHistogramValue 0) ^ 2 + (eisensteinHistogramValue 1) ^ 2 =
      (eisensteinHistogramValue 2) ^ 2 + (eisensteinHistogramValue 3) ^ 2 ∧
    Nat.gcd (Nat.gcd (eisensteinHistogramValue 0) (eisensteinHistogramValue 1))
      (Nat.gcd (eisensteinHistogramValue 2) (eisensteinHistogramValue 3)) = 120 ∧
    ¬ IsSidon (((Finset.univ : Finset (Fin 4)).image
      (fun j => (eisensteinHistogramValue j) ^ 2)) : Set ℕ) := by
  decide

