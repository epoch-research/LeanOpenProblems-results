/-!
An auxiliary carry obstruction with ordered Gaussian--Eisenstein digits,
common first two digit-value moments, and digit height O(sqrt(radix)).
NOT a disproof of Erdős 773. The radices in this family are composite.
-/
namespace Erdos773.SquareRootDigitCarry
open Finset
set_option maxHeartbeats 4000000
set_option maxRecDepth 8192

def base (t : ℕ) : ℕ := 36*(t+1000000)^2-1
def height (t : ℕ) : ℕ := 150000*(t+1000000)

