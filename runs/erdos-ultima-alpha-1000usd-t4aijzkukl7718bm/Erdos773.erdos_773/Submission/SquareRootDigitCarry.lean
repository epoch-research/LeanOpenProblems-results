lemma square_collision (t : ℕ) :
    root t 0 ^ 2 + root t 1 ^ 2 = root t 2 ^ 2 + root t 3 ^ 2 := by
  have hb : (base t : ℤ)+1 = 36*((t:ℤ)+1000000)^2 := by exact_mod_cast base_formula t
  have hz : 36*((t:ℤ)+1000000)^2-(base t:ℤ)-1 = 0 := by omega
  have hd := discrepancy (base t) t
  rw [hz,mul_zero] at hd
  change (root t 0 : ℤ)^2 + (root t 1 : ℤ)^2 -
    (root t 2 : ℤ)^2 - (root t 3 : ℤ)^2 = 0 at hd
  have he : (root t 0 : ℤ)^2 + (root t 1 : ℤ)^2 =
      (root t 2 : ℤ)^2 + (root t 3 : ℤ)^2 := by linarith
  exact_mod_cast he

private lemma image_not_sidon (f : Fin 4 → ℕ) (hf : Function.Injective f)
    (he : f 0+f 1=f 2+f 3) : ¬ IsSidon ((univ.image f) : Set ℕ) := by
  intro h
  have hm (j : Fin 4) : f j ∈ (univ.image f : Finset ℕ) := mem_image.mpr ⟨j,mem_univ j,rfl⟩
  rcases h _ (hm 0) _ (hm 2) _ (hm 1) _ (hm 3) he with h | h
  · exact (by decide : (0 : Fin 4) ≠ 2) (hf h.1)
  · exact (by decide : (0 : Fin 4) ≠ 3) (hf h.1)

theorem not_sidon (t : ℕ) :
    ¬ IsSidon ((univ.image (fun j : Fin 4 => root t j ^ 2)) : Set ℕ) := by
  apply image_not_sidon
  · intro i j h
    exact root_injective t (Nat.pow_left_injective (by decide : (2 : ℕ) ≠ 0) h)
  · exact square_collision t

lemma bases_unbounded (L : ℕ) : ∃ t : ℕ, L < base t := by
  refine ⟨L, ?_⟩
  have := height_lt_base L
  dsimp [height] at this
  omega

open Filter Real

lemma eventual_power_bound (α : ℝ) (hα : 1/2 < α) :
    ∀ᶠ t : ℕ in atTop, ∀ j : Fin 4, ∀ i : Fin 71,
      (digit t j i : ℝ) ≤ (base t : ℝ)^α := by
  have hδ : 0 < 2*α-1 := by linarith
  have he : ∀ᶠ t : ℕ in atTop, (150000:ℝ) ≤ (t:ℝ)^(2*α-1) :=
    tendsto_atTop.mp ((tendsto_rpow_atTop hδ).comp tendsto_natCast_atTop_atTop) 150000
  filter_upwards [he] with t ht
  intro j i
  let x : ℝ := (t:ℝ)+1000000
  have hx : 1 ≤ x := by dsimp [x]; have := Nat.cast_nonneg (α := ℝ) t; linarith
  have hx0 : 0 < x := by linarith
  have htx : (t:ℝ) ≤ x := by dsimp [x]; linarith
  have hp : (150000:ℝ) ≤ x^(2*α-1) := ht.trans
    (Real.rpow_le_rpow (Nat.cast_nonneg _) htx hδ.le)
  have hb : (base t:ℝ)+1 = 36*x^2 := by
    dsimp [x]
    exact_mod_cast base_formula t
  have hbx : x^2 ≤ (base t:ℝ) := by nlinarith [sq_nonneg (x-1)]
  have hd : (digit t j i:ℝ) ≤ 150000*x := by
    have hh : (digit t j i:ℝ) ≤ (height t:ℝ) := by exact_mod_cast (digit_bound t j i).2
    simpa [height,x] using hh
  calc
    _ ≤ 150000*x := hd
    _ ≤ x^(2*α-1)*x := mul_le_mul_of_nonneg_right hp hx0.le
    _ = x^((2*α-1)+1) := by rw [Real.rpow_add hx0,Real.rpow_one]
    _ = x^(2*α) := by congr 1; ring
    _ = (x^2)^α := by rw [← Real.rpow_natCast_mul hx0.le]; norm_num
    _ ≤ (base t:ℝ)^α := Real.rpow_le_rpow (sq_nonneg x) hbx (by linarith)

lemma small_total (t : ℕ) (j : Fin 4) :
    (∑ i : Fin 71, digit t j i) < base t := by
  rw [common_sum]
  have hb := base_formula t
  nlinarith [Nat.zero_le t]

lemma common_moments (t : ℕ) (j : Fin 4) (k : ℕ) (hk : k ≤ 2) :
    (∑ i : Fin 71, digit t j i ^ k) = ∑ i : Fin 71, digit t 0 i ^ k := by
  interval_cases k
  · simp
  · simpa only [pow_one] using (common_sum t j).trans (common_sum t 0).symm
  · exact (common_norm t j).trans (common_norm t 0).symm

/-- Fixed dimension, arbitrary power bound above the square-root threshold,
and arbitrarily large radices. This is not a statement about prime radices. -/
theorem power_bounded_obstruction (α : ℝ) (hα : 1/2 < α) (L : ℕ) :
    ∃ t : ℕ, L < base t ∧
      (∀ j : Fin 4, digit t j 0 = 6 ∧ digit t j 70 = 1 ∧
        StrictMono (fun i : Fin 70 => digit t j i.castSucc) ∧
        (∀ i : Fin 70, 6 ∣ digit t j i.castSucc) ∧
        (∀ i : Fin 71, 0 < digit t j i ∧ digit t j i < base t ∧
          (digit t j i : ℝ) ≤ (base t : ℝ)^α) ∧
        (∑ i : Fin 71, digit t j i) < base t ∧
        (∀ k ≤ 2, (∑ i : Fin 71, digit t j i ^ k) =
          ∑ i : Fin 71, digit t 0 i ^ k)) ∧
      Function.Injective (root t) ∧
      (∀ j, 0 < root t j ∧ root t j < base t ^ 71) ∧
      ¬ IsSidon ((univ.image (fun j : Fin 4 => root t j ^ 2)) : Set ℕ) := by
  obtain ⟨T,hT⟩ := eventually_atTop.mp (eventual_power_bound α hα)
  let t := max T L
  have htT : T ≤ t := le_max_left _ _
  have htL : L ≤ t := le_max_right _ _
  have hL : L < base t := by
    have hh := height_lt_base t
    dsimp [height] at hh
    omega
  refine ⟨t,hL,?_,root_injective t,?_,not_sidon t⟩
  · intro j
    refine ⟨(endpoint_digits t j).1,(endpoint_digits t j).2,lower_increasing t j,
      lower_divisible t j,?_,small_total t j,common_moments t j⟩
    intro i
    exact ⟨(canonical t j i).1,(canonical t j i).2,hT t htT j i⟩
  · intro j
    exact ⟨root_positive t j,root_height t j⟩


