private lemma word_eq (t : ℕ) (j : Fin 4) : word t j = explicitWord t j := by
  fin_cases j <;> simp [word,digit,slope,offset,explicitWord,List.ofFn_succ]

lemma word_injective (t : ℕ) : Function.Injective (word t) := by
  intro i j h
  have he : digit t i = digit t j := List.ofFn_inj.mp h
  have h7 := congrFun he 7
  have h14 := congrFun he 14
  have hspecial : ∀ j : Fin 4, digit t j 7 = ![5518896,5518884,5518896,5518884] j ∧
      digit t j 14 = ![49375380,49375368,49375368,49375380] j := by
    have hd : ∀ k : Fin 4, slope k 7 = 0 ∧ slope k 14 = 0 ∧
        offset k 7 = ![5518896,5518884,5518896,5518884] k ∧
        offset k 14 = ![49375380,49375368,49375368,49375380] k := by decide +kernel
    intro k
    obtain ⟨h1,h2,h3,h4⟩ := hd k
    simp [digit,h1,h2,h3,h4]
  rw [(hspecial i).1,(hspecial j).1] at h7
  rw [(hspecial i).2,(hspecial j).2] at h14
  have hinj : Function.Injective (fun k : Fin 4 =>
      (![5518896,5518884,5518896,5518884] k,
       ![49375380,49375368,49375368,49375380] k)) := by decide +kernel
  exact hinj (Prod.ext h7 h14)

lemma word_digits (t : ℕ) (j : Fin 4) : ∀ x ∈ word t j, x < base t := by
  intro x hx
  obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hx
  exact (canonical t j i).2

lemma root_injective (t : ℕ) : Function.Injective (root t) := by
  intro i j h
  apply word_injective t
  have hb : 1 < base t := by have := height_lt_base t; dsimp [height] at this; omega
  exact Nat.ofDigits_inj_of_len_eq hb (by simp [word]) (word_digits t i) (word_digits t j) h

lemma root_positive (t : ℕ) (j : Fin 4) : 0 < root t j := by
  unfold root
  rw [word_eq]
  fin_cases j <;> simp [explicitWord,Nat.ofDigits_cons]

lemma root_height (t : ℕ) (j : Fin 4) : root t j < base t ^ 71 := by
  have hb : 1 < base t := by have := height_lt_base t; dsimp [height] at this; omega
  have h := Nat.ofDigits_lt_base_pow_length hb (word_digits t j)
  simpa [root,word] using h

