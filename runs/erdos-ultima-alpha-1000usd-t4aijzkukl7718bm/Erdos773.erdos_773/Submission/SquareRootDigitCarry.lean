def digit (t : ℕ) (j : Fin 4) (i : Fin 71) : ℕ := slope j i*t+offset j i
def word (t : ℕ) (j : Fin 4) : List ℕ := List.ofFn (digit t j)
def root (t : ℕ) (j : Fin 4) : ℕ := Nat.ofDigits (base t) (word t j)

private lemma data_order : ∀ j : Fin 4, ∀ i : Fin 69,
    slope j i.castSucc.castSucc ≤ slope j i.succ.castSucc ∧
    offset j i.castSucc.castSucc < offset j i.succ.castSucc := by
  decide +kernel

private lemma data_bounds : ∀ j : Fin 4, ∀ i : Fin 71,
    slope j i ≤ 150000 ∧ 0 < offset j i ∧ offset j i ≤ 150000000000 := by
  decide +kernel

private lemma data_divisible : ∀ j : Fin 4, ∀ i : Fin 70,
    6 ∣ slope j i.castSucc ∧ 6 ∣ offset j i.castSucc := by
  decide +kernel

private lemma data_ends : ∀ j : Fin 4,
    slope j 0 = 0 ∧ offset j 0 = 6 ∧ slope j 70 = 0 ∧ offset j 70 = 1 := by
  decide +kernel

private lemma data_moments : ∀ j : Fin 4,
    (∑ i : Fin 71, slope j i) = 2500470 ∧
    (∑ i : Fin 71, offset j i) = 2543002994701 ∧
    (∑ i : Fin 71, slope j i ^ 2) = 241614608508 ∧
    (∑ i : Fin 71, 2 * slope j i * offset j i) = 487749350751730200 ∧
    (∑ i : Fin 71, offset j i ^ 2) = 246178670991665724758521 := by
  decide +kernel

lemma endpoint_digits (t : ℕ) (j : Fin 4) :
    digit t j 0 = 6 ∧ digit t j 70 = 1 := by
  obtain ⟨h0,h1,h2,h3⟩ := data_ends j
  simp [digit,h0,h1,h2,h3]

lemma lower_increasing (t : ℕ) (j : Fin 4) :
    StrictMono (fun i : Fin 70 => digit t j i.castSucc) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  intro i
  exact add_lt_add_of_le_of_lt (Nat.mul_le_mul_right t (data_order j i).1)
    (data_order j i).2

lemma lower_divisible (t : ℕ) (j : Fin 4) (i : Fin 70) :
    6 ∣ digit t j i.castSucc :=
  dvd_add (dvd_mul_of_dvd_left (data_divisible j i).1 t) (data_divisible j i).2

lemma digit_bound (t : ℕ) (j : Fin 4) (i : Fin 71) :
    0 < digit t j i ∧ digit t j i ≤ height t := by
  obtain ⟨hs,hp,hb⟩ := data_bounds j i
  constructor
  · exact Nat.add_pos_right _ hp
  · have hh := Nat.mul_le_mul_right t hs
    dsimp [digit,height]
    omega

lemma base_formula (t : ℕ) : base t + 1 = 36*(t+1000000)^2 := by
  have h : 1 ≤ 36*(t+1000000)^2 := by nlinarith [Nat.zero_le t]
  dsimp [base]
  omega

lemma height_lt_base (t : ℕ) : height t < base t := by
  have hb := base_formula t
  have hu : 1000000 ≤ t+1000000 := by omega
  have hh := Nat.mul_le_mul_right (t+1000000) hu
  dsimp [height]
  nlinarith

lemma canonical (t : ℕ) (j : Fin 4) (i : Fin 71) :
    0 < digit t j i ∧ digit t j i < base t :=
  ⟨(digit_bound t j i).1, (digit_bound t j i).2.trans_lt (height_lt_base t)⟩

/-- The digit bound is a fixed constant times the square root of the radix. -/
lemma digit_square_bound (t : ℕ) (j : Fin 4) (i : Fin 71) :
    digit t j i ^ 2 ≤ 625000000 * (base t + 1) := by
  calc
    _ ≤ height t ^ 2 := Nat.pow_le_pow_left (digit_bound t j i).2 2
    _ = _ := by rw [base_formula]; dsimp [height]; ring

lemma common_sum (t : ℕ) (j : Fin 4) :
    (∑ i : Fin 71, digit t j i) = 2500470*t+2543002994701 := by
  simp only [digit,sum_add_distrib,← sum_mul]
  rw [(data_moments j).1,(data_moments j).2.1]

lemma common_norm (t : ℕ) (j : Fin 4) :
    (∑ i : Fin 71, digit t j i ^ 2) =
      241614608508*t^2+487749350751730200*t+246178670991665724758521 := by
  have he (i : Fin 71) : digit t j i ^ 2 = slope j i ^ 2 * t^2 +
      (2*slope j i*offset j i)*t + offset j i ^ 2 := by dsimp [digit]; ring
  simp_rw [he]
  simp only [sum_add_distrib,← sum_mul]
  rw [(data_moments j).2.2.1,(data_moments j).2.2.2.1,(data_moments j).2.2.2.2]

