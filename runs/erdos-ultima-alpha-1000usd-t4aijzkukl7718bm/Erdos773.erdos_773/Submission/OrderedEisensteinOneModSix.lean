lemma square_collision (t : ℕ) :
    root t 0 ^ 2 + root t 1 ^ 2 = root t 2 ^ 2 + root t 3 ^ 2 := by
  have hz : 6000*((t:ℤ)+1000000000000000000000000)-(base t:ℤ)+1 = 0 := by
    simp only [base, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
    ring
  have hd := discrepancy (base t) t
  rw [hz, mul_zero] at hd
  change (root t 0 : ℤ)^2 + (root t 1 : ℤ)^2 -
    (root t 2 : ℤ)^2 - (root t 3 : ℤ)^2 = 0 at hd
  have he : (root t 0 : ℤ)^2 + (root t 1 : ℤ)^2 =
      (root t 2 : ℤ)^2 + (root t 3 : ℤ)^2 := by linarith
  exact_mod_cast he

private lemma image_not_sidon (f : Fin 4 → ℕ) (hf : Function.Injective f)
    (he : f 0 + f 1 = f 2 + f 3) :
    ¬ IsSidon ((univ.image f) : Set ℕ) := by
  intro h
  have hm (j : Fin 4) : f j ∈ (univ.image f : Finset ℕ) :=
    mem_image.mpr ⟨j, mem_univ j, rfl⟩
  rcases h _ (hm 0) _ (hm 2) _ (hm 1) _ (hm 3) he with h | h
  · exact (by decide : (0 : Fin 4) ≠ 2) (hf h.1)
  · exact (by decide : (0 : Fin 4) ≠ 3) (hf h.1)

theorem not_sidon (t : ℕ) :
    ¬ IsSidon ((univ.image (fun j : Fin 4 => root t j ^ 2)) : Set ℕ) := by
  apply image_not_sidon
  · intro i j h
    exact root_injective t (Nat.pow_left_injective (by decide : (2 : ℕ) ≠ 0) h)
  · exact square_collision t

lemma base_mod_six (t : ℕ) : base t % 6 = 1 := by dsimp [base]; omega

lemma bases_unbounded (L : ℕ) : ∃ t : ℕ, L < base t := by
  exact ⟨L, by dsimp [base]; omega⟩

theorem four_roots (t : ℕ) : (univ.image (root t)).card = 4 ∧
    ∀ j, 0 < root t j ∧ root t j < base t ^ 50 := by
  constructor
  · rw [card_image_of_injective _ (root_injective t)]
    simp
  · intro j
    exact ⟨root_positive t j, root_height t j⟩

/-- The examples occur at arbitrarily large prime bases, not just composites. -/
lemma prime_bases_unbounded (L : ℕ) :
    ∃ t : ℕ, L < base t ∧ Nat.Prime (base t) := by
  obtain ⟨p,hp,hgt,hm⟩ := Nat.exists_prime_gt_modEq_one (k := 6000)
    (max L (6000*1000000000000000000000000+1)) (by decide)
  have hmod : p % 6000 = 1 := by simpa [Nat.ModEq] using hm
  have hd := Nat.mod_add_div p 6000
  have hbig : 6000*1000000000000000000000000+1 < p :=
    lt_of_le_of_lt (le_max_right _ _) hgt
  have hL : L < p := lt_of_le_of_lt (le_max_left _ _) hgt
  have hb : base (p / 6000 - 1000000000000000000000000) = p := by
    dsimp [base]
    omega
  refine ⟨p / 6000 - 1000000000000000000000000, ?_, ?_⟩
  · simpa only [hb] using hL
  · simpa only [hb] using hp

lemma common_moments (t : ℕ) (j : Fin 4) (k : ℕ) (hk : k ≤ 2) :
    (∑ i : Fin 50, digit t j i ^ k) = ∑ i : Fin 50, digit t 0 i ^ k := by
  interval_cases k
  · simp
  · simpa only [pow_one] using (common_sum t j).trans (common_sum t 0).symm
  · exact (common_norm t j).trans (common_norm t 0).symm

/-- The complete combination of conditions still permits a nontrivial
collision at unbounded prime bases. This says nothing about a largest Sidon
subclass, or about the common-full-alphabet permutation candidate. -/
theorem combined_prime_obstruction (L : ℕ) :
    ∃ t : ℕ, L < base t ∧ Nat.Prime (base t) ∧
      (∀ j : Fin 4, digit t j 0 = 6 ∧ digit t j 49 = 1 ∧
        StrictMono (fun i : Fin 49 => digit t j i.castSucc) ∧
        (∀ i : Fin 49, 6 ∣ digit t j i.castSucc) ∧
        (∀ i : Fin 50, 0 < digit t j i ∧ digit t j i < base t) ∧
        (∀ k ≤ 2, (∑ i : Fin 50, digit t j i ^ k) =
          ∑ i : Fin 50, digit t 0 i ^ k)) ∧
      Function.Injective (root t) ∧
      (∀ j, 0 < root t j ∧ root t j < base t ^ 50) ∧
      ¬ IsSidon ((univ.image (fun j : Fin 4 => root t j ^ 2)) : Set ℕ) := by
  obtain ⟨t,hL,hp⟩ := prime_bases_unbounded L
  refine ⟨t,hL,hp,?_,root_injective t,(four_roots t).2,not_sidon t⟩
  intro j
  exact ⟨(endpoint_digits t j).1, (endpoint_digits t j).2, lower_increasing t j,
    lower_divisible t j, canonical t j, common_moments t j⟩

