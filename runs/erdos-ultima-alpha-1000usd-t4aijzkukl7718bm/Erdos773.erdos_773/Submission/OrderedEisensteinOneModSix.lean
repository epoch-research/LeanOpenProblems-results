lemma canonical (t : ℕ) (j : Fin 4) (i : Fin 50) :
    0 < digit t j i ∧ digit t j i < base t := by
  fin_cases j <;> fin_cases i <;> norm_num [digit, base] <;> omega

lemma common_sum (t : ℕ) (j : Fin 4) :
    (∑ i : Fin 50, digit t j i) = 5502*t + 5501399939993999399939994001 := by
  fin_cases j <;> norm_num [Fin.sum_univ_succ, digit] <;> ring

lemma common_norm (t : ℕ) (j : Fin 4) :
    (∑ i : Fin 50, digit t j i ^ 2) = 8256492*t^2 + 16512974200800000000000000000000*t + 8256482877957028779570287795702877957042333868297405129 := by
  fin_cases j <;> norm_num [Fin.sum_univ_succ, digit] <;> ring

lemma word_injective (t : ℕ) : Function.Injective (word t) := by
  intro i j h
  have he : digit t i = digit t j := List.ofFn_inj.mp h
  have h2 := congrFun he 2
  have h14 := congrFun he 14
  fin_cases i <;> fin_cases j
  · rfl
  · change 186 = 174 at h2
    omega
  · change 518280000 = 518400000 at h14
    omega
  · change 186 = 174 at h2
    omega
  · change 174 = 186 at h2
    omega
  · rfl
  · change 174 = 186 at h2
    omega
  · change 518400000 = 518280000 at h14
    omega
  · change 518400000 = 518280000 at h14
    omega
  · change 186 = 174 at h2
    omega
  · rfl
  · change 186 = 174 at h2
    omega
  · change 174 = 186 at h2
    omega
  · change 518280000 = 518400000 at h14
    omega
  · change 174 = 186 at h2
    omega
  · rfl

lemma word_digits (t : ℕ) (j : Fin 4) : ∀ x ∈ word t j, x < base t := by
  intro x hx
  obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hx
  exact (canonical t j i).2

lemma root_injective (t : ℕ) : Function.Injective (root t) := by
  intro i j h
  apply word_injective t
  exact Nat.ofDigits_inj_of_len_eq (by dsimp [base]; omega)
    (by simp [word]) (word_digits t i) (word_digits t j) h

lemma root_positive (t : ℕ) (j : Fin 4) : 0 < root t j := by
  fin_cases j <;> simp [root, word, digit, List.ofFn_succ, Nat.ofDigits_cons]

lemma root_height (t : ℕ) (j : Fin 4) : root t j < base t ^ 50 := by
  have h := Nat.ofDigits_lt_base_pow_length
    (by dsimp [base]; omega : 1 < base t) (word_digits t j)
  simpa [root, word] using h

