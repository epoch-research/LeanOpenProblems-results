, 5183318279994, 59999999399940, 185999998259826, 275999996759676, 455999996159616, 515999994359436, 665999993459346, 51834000081668172, 600000000000000060, 1860000000000000174, 2760000000000000324, 4560000000000000384, 5160000000000000564, 6660000000000000654, 518339999999999991834, 6000000000000000000000, 18600000000000000000000, 27600000000000000000000, 45600000000000000000000, 51600000000000000000000, 66600000000000000000000, 6*t + 5183400000000000000000000, 66*t + 66000000000000000000000000, 252*t + 252000000000000000000000000, 528*t + 528000000000000000000000000, 984*t + 984000000000000000000000000, 1500*t + 1500000000000000000000000000, 2166*t + 2166000000000000000000000000, 1] : ℤ)^2 - (Nat.ofDigits B [6, 60, 174, 324, 384, 564, 654, 51834, 600000, 1740000, 3240000, 3840000, 5640000, 6540000, 518280000, 5999400000, 17398140000, 32397240000, 38395440000, 56394840000, 65393340000, 5183481720006, 60000000600060, 174000001860186, 324000002760276, 384000004560456, 564000005160516, 654000006660666, 51833999918331828, 599999999999999940, 1739999999999999814, 3239999999999999724, 3839999999999999544, 5639999999999999484, 6539999999999999334, 518340000000000008166, 6000000000000000000000, 17400000000000000000000, 32400000000000000000000, 38400000000000000000000, 56400000000000000000000, 65400000000000000000000, 6*t + 5183400000000000000000000, 66*t + 66000000000000000000000000, 240*t + 240000000000000000000000000, 564*t + 564000000000000000000000000, 948*t + 948000000000000000000000000, 1512*t + 1512000000000000000000000000, 2166*t + 2166000000000000000000000000, 1] : ℤ)^2 = _
