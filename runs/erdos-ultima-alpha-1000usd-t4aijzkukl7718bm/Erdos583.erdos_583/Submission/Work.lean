  | node (key : ℕ) (value : ℕ) (left right : CertificateTree) : CertificateTree

def CertificateTree.lookup (t : CertificateTree) (key : ℕ) : Option ℕ :=
  match t with
  | .empty => none
  | .node k v l r => if key=k then some v else if key<k then l.lookup key else r.lookup key

