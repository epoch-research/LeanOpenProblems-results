def decodeStep (n : ℕ) : Fin 14 × Bool :=
  (⟨n%14,Nat.mod_lt _ (by decide)⟩,decide (14 ≤ n))

def decodeSteps (n : ℕ) : Steps :=
  (List.range 7).map (fun i ↦ decodeStep ((n/(32^i))%32))

def choice (p : Fin 7 → Fin 7) (d : Fin 6) : Steps × Steps :=
  let n := (CertificateTree.lookup certificates (code p d)).getD 0
  (decodeSteps (n%34359738368),decodeSteps (n/34359738368))

def fromList (a b : Fin 7) (l : List (Fin 7)) (i : Fin 7) : Fin 7 := (a::b::l).getD i.val 0

