lemma finite_certificate_orders : ∀ a b : Fin 7, a ≠ b → ¬adjacent a b →
    ∀ l ∈ ((([0,1,2,3,4,5,6] : List (Fin 7)).erase a).erase b).permutations',
    ¬adjacent (fromList a b l 5) (fromList a b l 6) →
    ∀ g : Fin 6, GoodGap (fromList a b l) g → Valid (fromList a b l) g (choice (fromList a b l) g) := by
  intro a b hab ha
  fin_cases a <;> fin_cases b
  all_goals first
    | exact (hab rfl).elim
    | exact (ha (by decide)).elim
    | exact finite_certificate_orders_0_2
    | exact finite_certificate_orders_0_3
    | exact finite_certificate_orders_0_4
    | exact finite_certificate_orders_0_5
    | exact finite_certificate_orders_1_3
    | exact finite_certificate_orders_1_4
    | exact finite_certificate_orders_1_5
    | exact finite_certificate_orders_1_6
    | exact finite_certificate_orders_2_0
    | exact finite_certificate_orders_2_4
    | exact finite_certificate_orders_2_5
    | exact finite_certificate_orders_2_6
    | exact finite_certificate_orders_3_0
    | exact finite_certificate_orders_3_1
    | exact finite_certificate_orders_3_5
    | exact finite_certificate_orders_3_6
    | exact finite_certificate_orders_4_0
    | exact finite_certificate_orders_4_1
    | exact finite_certificate_orders_4_2
    | exact finite_certificate_orders_4_6
    | exact finite_certificate_orders_5_0
    | exact finite_certificate_orders_5_1
    | exact finite_certificate_orders_5_2
    | exact finite_certificate_orders_5_3
    | exact finite_certificate_orders_6_1
    | exact finite_certificate_orders_6_2
    | exact finite_certificate_orders_6_3
    | exact finite_certificate_orders_6_4

lemma finite_certificate (p : Fin 7 → Fin 7)
    (hp : (List.ofFn p).Nodup) (hf : ¬adjacent (p 0) (p 1)) (hl : ¬adjacent (p 5) (p 6))
    (d : Fin 6) (hg : GoodGap p d) : Valid p d (choice p d) := by
  classical
  have hperm : List.Perm (List.ofFn p) ([0,1,2,3,4,5,6] : List (Fin 7)) := by
    apply (List.perm_ext_iff_of_nodup hp (by decide)).mpr
    intro x
    constructor
    · intro _; fin_cases x <;> decide
    · intro _
      exact List.mem_ofFn.mpr ((Finite.injective_iff_surjective.mp (List.nodup_ofFn.mp hp)) x)
  let q : Fin 5 → Fin 7 := fun i ↦ p i.succ.succ
  have hmem : List.ofFn q ∈ ((([0,1,2,3,4,5,6] : List (Fin 7)).erase (p 0)).erase (p 1)).permutations' := by
    apply List.mem_permutations'.mpr
    have he := (hperm.erase (p 0)).erase (p 1)
    rw [List.ofFn_succ,List.erase_cons_head,List.ofFn_succ] at he
    simp only [show (0 : Fin 6).succ=(1 : Fin 7) by rfl,List.erase_cons_head] at he
    exact he
  have he : fromList (p 0) (p 1) (List.ofFn q)=p := by
    funext i
    fin_cases i <;> rfl
  have h01 : p 0 ≠ p 1 := fun hh ↦ (by decide : (0 : Fin 7) ≠ 1) (List.nodup_ofFn.mp hp hh)
  have hh := finite_certificate_orders (p 0) (p 1) h01 hf (List.ofFn q) hmem
  rw [he] at hh
  exact hh hl d hg

lemma exists_routes (p : Fin 7 → Fin 7) (hp : Function.Injective p)
    (hfirst : ¬adjacent (p 0) (p 1)) (hlast : ¬adjacent (p 5) (p 6)) (d : Fin 6) (hg : GoodGap p d) :
    ∃ X : Route (pieceSource p d) (pieceTarget p d) (p 0).castSucc 7,
    ∃ Y : Route (pieceSource p d) (pieceTarget p d) (p 6).castSucc 7,
      X.support.Nodup ∧ Y.support.Nodup ∧ X.pieces.Disjoint Y.pieces ∧
        ∀ e, e ∈ X.pieces ∨ e ∈ Y.pieces := by
  obtain ⟨ha,hb,hnX,hnY,hd,hc⟩ := finite_certificate p (List.nodup_ofFn.mpr hp) hfirst hlast d hg
  obtain ⟨X,hXs,hXp⟩ := Route.of_compatible (choice p d).1 ha
  obtain ⟨Y,hYs,hYp⟩ := Route.of_compatible (choice p d).2 hb
  exact ⟨X,Y,hXs.symm ▸ hnX,hYs.symm ▸ hnY,by simpa only [hXp,hYp] using hd,
    by simpa only [hXp,hYp] using hc⟩

