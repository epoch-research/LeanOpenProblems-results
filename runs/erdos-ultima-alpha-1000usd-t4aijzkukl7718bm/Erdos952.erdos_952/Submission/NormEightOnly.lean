def packed (u v : Fin 65) : ℕ := (packedRows.getD u.val 0 >>> (16*v.val))%65536

def lift (u v : Fin 65) : ℤ × ℤ :=
  (((packed u v%256 : ℕ) : ℤ)-80, ((packed u v/256 : ℕ) : ℤ)-80)

def delta : Fin 2 → ℤ := ![2,-2]

/-- Every allowed positive-real-direction edge has its exact integer lift. -/
theorem checked : ∀ (u v : Fin 65) (k : Fin 2),
    Allowed u v → Allowed (residue (u.val+2)) (residue (v.val+delta k)) →
    lift (residue (u.val+2)) (residue (v.val+delta k)) =
      ((lift u v).1+2,(lift u v).2+delta k) := by
  decide +kernel

lemma norm_mod_residue (u v p : ℤ) (hp : p ∣ 65) :
    (((residue u).val : ℤ)^2+((residue v).val : ℤ)^2)%p = (u^2+v^2)%p := by
  have hu : ((residue u).val : ℤ) ≡ u [ZMOD p] := by
    change ((residue u).val : ℤ)%p = u%p
    rw [residue_val,Int.emod_emod_of_dvd u hp]
  have hv : ((residue v).val : ℤ) ≡ v [ZMOD p] := by
    change ((residue v).val : ℤ)%p = v%p
    rw [residue_val,Int.emod_emod_of_dvd v hp]
  exact (hu.pow 2).add (hv.pow 2)

lemma prime_allowed {z : GaussianInt} (hz : Prime z) (hl : 169 < z.norm) :
    Allowed (residue z.re) (residue z.im) := by
  unfold Allowed
  rw [norm_mod_residue _ _ _ (by norm_num : (5 : ℤ) ∣ 65),
    norm_mod_residue _ _ _ (by norm_num : (13 : ℤ) ∣ 65),← gaussian_norm_sq]
  exact ⟨prime_large_norm_residue hz (by decide : Nat.Prime 5) (by norm_num; omega),
    prime_large_norm_residue hz (by decide : Nat.Prime 13) (by norm_num; omega)⟩

def anchor (u v : ℤ) : ℤ × ℤ :=
  (u-(lift (residue u) (residue v)).1,v-(lift (residue u) (residue v)).2)

lemma anchor_forward (u v : ℤ) (k : Fin 2)
    (h0 : Allowed (residue u) (residue v))
    (h1 : Allowed (residue (u+2)) (residue (v+delta k))) :
    anchor (u+2) (v+delta k) = anchor u v := by
  rw [residue_add u 2,residue_add v (delta k)] at h1
  have he := checked (residue u) (residue v) k h0 h1
  simp only [anchor,residue_add u 2,residue_add v (delta k),he]
  ext <;> simp

lemma norm_eight_cases {z w : GaussianInt} (h : (w-z).norm = 8) :
    (w.re = z.re+2 ∧ w.im = z.im+2) ∨
    (w.re = z.re+2 ∧ z.im = w.im+2) ∨
    (z.re = w.re+2 ∧ w.im = z.im+2) ∨
    (z.re = w.re+2 ∧ z.im = w.im+2) := by
  let a := w.re-z.re
  let b := w.im-z.im
  have hn : a^2+b^2 = 8 := by simpa only [gaussian_norm_sq,Zsqrtd.re_sub,Zsqrtd.im_sub] using h
  have ha : -2 ≤ a ∧ a ≤ 2 := by constructor <;> nlinarith [sq_nonneg b]
  have hb : -2 ≤ b ∧ b ≤ 2 := by constructor <;> nlinarith [sq_nonneg a]
  rcases ha with ⟨ha₀, ha₁⟩
  rcases hb with ⟨hb₀, hb₁⟩
  have hc : (a=2 ∧ b=2) ∨ (a=2 ∧ b = -2) ∨
      (a = -2 ∧ b=2) ∨ (a = -2 ∧ b = -2) := by
    interval_cases a <;> interval_cases b <;> norm_num at *
  dsimp [a,b] at hc
  omega

lemma anchor_norm_eight {z w : GaussianInt}
    (hz : Allowed (residue z.re) (residue z.im))
    (hw : Allowed (residue w.re) (residue w.im))
    (hs : (w-z).norm = 8) : anchor w.re w.im = anchor z.re z.im := by
  rcases norm_eight_cases hs with ⟨hr,hi⟩ | ⟨hr,hi⟩ | ⟨hr,hi⟩ | ⟨hr,hi⟩
  · rw [hr,hi] at hw ⊢
    exact anchor_forward z.re z.im 0 hz hw
  · have hi' : w.im = z.im-2 := by omega
    rw [hr,hi'] at hw ⊢
    exact anchor_forward z.re z.im 1 hz hw
  · have hi' : z.im = w.im-2 := by omega
    rw [hr,hi'] at hz ⊢
    exact (anchor_forward w.re w.im 1 hw hz).symm
  · rw [hr,hi] at hz ⊢
    exact (anchor_forward w.re w.im 0 hw hz).symm

lemma eq_of_anchor_and_residue {z w : GaussianInt}
    (ha : anchor z.re z.im = anchor w.re w.im)
    (hr : (residue z.re,residue z.im) = (residue w.re,residue w.im)) : z = w := by
  have hre := congrArg Prod.fst hr
  have him := congrArg Prod.snd hr
  change residue z.re = residue w.re at hre
  change residue z.im = residue w.im at him
  have har := congrArg Prod.fst ha
  have hai := congrArg Prod.snd ha
  change z.re - (lift (residue z.re) (residue z.im)).1 =
    w.re - (lift (residue w.re) (residue w.im)).1 at har
  change z.im - (lift (residue z.re) (residue z.im)).2 =
    w.im - (lift (residue w.re) (residue w.im)).2 at hai
  rw [hre,him] at har hai
  exact Zsqrtd.ext (by omega) (by omega)

/-- No injective ray of actual Gaussian primes can use only norm-eight jumps. -/
theorem no_norm_eight_prime_ray (x : ℕ → GaussianInt) (hx : Function.Injective x)
    (hp : ∀ n, Prime (x n)) : ¬ ∀ n, (x (n+1)-x n).norm = 8 := by
  intro hs
  obtain ⟨K,hK⟩ := injective_escapes_norm x hx 169
  let y : ℕ → GaussianInt := fun n => x (K+n)
  have hy : Function.Injective y := fun i j he => Nat.add_left_cancel (hx he)
  have ha (n : ℕ) : Allowed (residue (y n).re) (residue (y n).im) :=
    prime_allowed (hp (K+n)) (hK _ (by omega))
  have hyS (n : ℕ) : (y (n+1)-y n).norm = 8 := by simpa only [y,Nat.add_assoc] using hs (K+n)
  have hanc (n : ℕ) : anchor (y n).re (y n).im = anchor (y 0).re (y 0).im := by
    induction n with
    | zero => rfl
    | succ n ih => exact (anchor_norm_eight (ha n) (ha (n+1)) (hyS n)).trans ih
  have hi : Function.Injective (fun n => (residue (y n).re,residue (y n).im)) := by
    intro i j he
    exact hy (eq_of_anchor_and_residue ((hanc i).trans (hanc j).symm) he)
  letI : Finite ℕ := Finite.of_injective _ hi
  exact not_finite ℕ

