import Submission.Investigation

/-! A finite periodic lift excludes prime rays made solely of squared-norm-eight
jumps. It does not exclude rays mixing these jumps with smaller ones. -/
namespace Erdos952Investigation.NormEightOnly
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option Elab.async false

def residue (u : ℤ) : Fin 65 := ⟨(u%65).toNat,by omega⟩

lemma residue_val (u : ℤ) : ((residue u).val : ℤ) = u%65 := by
  simp only [residue]
  omega

lemma residue_add (u d : ℤ) :
    residue (u+d) = residue ((residue u).val+d) := by
  apply Fin.ext
  have he : (u+d)%65 = (((residue u).val : ℤ)+d)%65 := by
    rw [residue_val,Int.emod_add_emod]
  exact congrArg Int.toNat he

def Allowed (u v : Fin 65) : Prop :=
  (((u.val : ℤ)^2+(v.val : ℤ)^2)%5 ≠ 0) ∧
  (((u.val : ℤ)^2+(v.val : ℤ)^2)%13 ≠ 0)

instance (u v : Fin 65) : Decidable (Allowed u v) := inferInstanceAs (Decidable (_ ∧ _))

