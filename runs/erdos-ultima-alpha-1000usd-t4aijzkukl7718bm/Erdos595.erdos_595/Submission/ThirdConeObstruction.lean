private def leftRow (p : Arc A1) (i : Fin 9) := decode (leftRaw (code p) i)
private def rightRow (p : Arc A1) (i : Fin 9) := decode (rightRaw (code p) i)

local instance : DecidableRel cone.Adj := by
  intro a b
  cases a <;> cases b
  · exact isFalse id
  · exact isTrue trivial
  · exact isTrue trivial
  · exact inferInstanceAs (Decidable (base.Adj _ _))

private theorem rows_adj : ∀ p : Arc A1, ∀ i j : Fin 9,
    cone.Adj (leftRow p i) (rightRow p j) := by
  decide +kernel

private theorem rows_meet : ∀ p q : Arc A1, A2.Adj p q →
    ∃ i j : Fin 9, rightRow p i = leftRow q j := by
  decide +kernel

def sourceHom : A2 →g right cone where
  toFun p := ⟨(Set.range (leftRow p),Set.range (rightRow p)),by
    rintro _ ⟨i,rfl⟩ _ ⟨j,rfl⟩
    exact rows_adj p i j⟩
  map_rel' := by
    intro p q hpq
    obtain ⟨i,j,hij⟩ := rows_meet p q hpq
    obtain ⟨k,l,hkl⟩ := rows_meet q p hpq.symm
    exact ⟨⟨rightRow p i,⟨i,rfl⟩,⟨j,hij.symm⟩⟩,
      ⟨rightRow q k,⟨k,rfl⟩,⟨l,hkl.symm⟩⟩⟩

def cliqueHom : K4 →g third := toRight (toRight sourceHom)

theorem second_cliqueFree : second.CliqueFree 4 :=
  (Erdos595SecondConeCriterion.cliqueFree_iff_noFive base).mpr
    Erdos595OddGraphSeven.noFive

theorem third_not_cliqueFree : ¬third.CliqueFree 4 := by
  intro h
  have hadj : ∀ i j : Fin 4, i ≠ j → third.Adj (cliqueHom i) (cliqueHom j) :=
    fun i j hij => cliqueHom.map_adj hij
  exact Erdos595Work.no_adj_common_neighbors h
    (hadj 0 1 (by decide)) (hadj 0 2 (by decide)) (hadj 1 2 (by decide))
    (hadj 0 3 (by decide)) (hadj 1 3 (by decide)) (hadj 2 3 (by decide))

theorem second_covered : IsCountableUnionOfTriangleFree second :=
  Erdos595SecondConeRight.countable_cover base Erdos595OddGraphSeven.noFive

theorem third_covered : IsCountableUnionOfTriangleFree third := by
  classical
  apply countable_union_of_countable_common_neighbors
  intro a b hab
  exact Set.to_countable _

#print axioms second_cliqueFree
#print axioms third_not_cliqueFree
#print axioms third_covered
