def trace : List (Label × Label × Label) := certificate.map (fun p => triple p.1 p.2)
def generated : Finset Label := trace.foldl (fun S t => insert t.1 S) seeds

theorem certificate_increasing : ∀ p ∈ certificate, StrictMono p.1 := by
  have h : certificate.all (fun p => decide (StrictMono p.1)) = true := by decide
  intro p hp
  exact of_decide_eq_true ((List.all_eq_true.mp h) p hp)

theorem certificate_valid : ValidTrace seeds trace := by decide

theorem seeds_card : seeds.card = 12 := by decide

theorem generated_card : generated.card = 378 := by decide

def bitCount (e : Label) : ℕ := ((Finset.range 12).filter (fun i => e.val.testBit i)).card

def generatedList : List Label := [3330, 804, 553, 2337, 537, 554, 2073, 46, 610, 624, 150, 3216] ++ trace.map (fun t => t.1)

theorem generated_eq_toFinset : generated = generatedList.toFinset := by decide

theorem generated_popcount : ∀ e ∈ generated, bitCount e = 4 := by
  have h : generatedList.all (fun e => decide (bitCount e = 4)) = true := by decide
  intro e he
  rw [generated_eq_toFinset] at he
  exact of_decide_eq_true ((List.all_eq_true.mp h) e (List.mem_toFinset.mp he))

/-- The matched-pair hypergraph has no injective realization by unordered pairs.
Only the labels representing four-element sets are required to map injectively. -/
theorem matched_pair_no_root {V : Type*} (r : Label → Sym2 V)
    (hinj : Set.InjOn r {e | bitCount e = 4})
    (htri : ∀ t : Sextuple, StrictMono t →
      EdgeTriangle (r (faces t 0)) (r (faces t 1)) (r (faces t 2))) : False := by
  have hc := edge_realization_bound r seeds trace certificate_valid
    (fun t ht => ?_) (Set.InjOn.mono (fun e he => generated_popcount e he) hinj)
  · rw [← generated, generated_card, seeds_card] at hc
    exact (by decide : ¬ (378 ≤ Nat.choose 25 2)) hc
  · obtain ⟨p, hp, rfl⟩ := List.mem_map.mp ht
    exact triangle_triple r p.1 (htri p.1 (certificate_increasing p hp)) p.2

