import FormalConjecturesUtil

/-!
# An obstruction to a proposed triangle-hypergraph construction

This auxiliary file does not settle Erdős Problem 595. It checks that one of the
ordered matched-pair hypergraphs considered as a possible construction has no
injective realization by graph edges, even before imposing `K₄`-freeness.
-/

open Set
namespace Erdos595Root

/-- Three unordered pairs are the three sides of a (possibly degenerate) triangle. -/
def EdgeTriangle {V : Type*} (e f g : Sym2 V) : Prop :=
  ∃ a b c, e = s(a, b) ∧ f = s(a, c) ∧ g = s(b, c)

lemma EdgeTriangle.rotate {V : Type*} {e f g : Sym2 V} (h : EdgeTriangle e f g) :
    EdgeTriangle f g e := by
  obtain ⟨a, b, c, rfl, rfl, rfl⟩ := h
  exact ⟨c, a, b, Sym2.eq_swap, Sym2.eq_swap, rfl⟩

lemma EdgeTriangle.support {V : Type*} {e f g : Sym2 V} (h : EdgeTriangle e f g)
    (P : V → Prop) (hf : ∀ v ∈ f, P v) (hg : ∀ v ∈ g, P v) : ∀ v ∈ e, P v := by
  obtain ⟨a, b, c, rfl, rfl, rfl⟩ := h
  intro v hv
  rcases Sym2.mem_iff.mp hv with rfl | rfl
  · exact hf _ (Sym2.mem_mk_left _ _)
  · exact hg _ (Sym2.mem_mk_left _ _)

/-- A trace of completing triples: two old labels produce the first label. -/
def ValidTrace {A : Type*} [DecidableEq A] (S : Finset A) : List (A × A × A) → Prop
  | [] => True
  | (e, f, g) :: ts => f ∈ S ∧ g ∈ S ∧ ValidTrace (insert e S) ts

instance {A : Type*} [DecidableEq A] (S : Finset A) (ts : List (A × A × A)) :
    Decidable (ValidTrace S ts) := by
  induction ts generalizing S with
  | nil => exact isTrue True.intro
  | cons t ts ih =>
    rcases t with ⟨e, f, g⟩
    change Decidable (f ∈ S ∧ g ∈ S ∧ ValidTrace (insert e S) ts)
    exact instDecidableAnd

lemma supported_trace {A V : Type*} [DecidableEq A] (r : A → Sym2 V) (P : V → Prop)
    (S : Finset A) (ts : List (A × A × A)) (h : ValidTrace S ts)
    (htri : ∀ t ∈ ts, EdgeTriangle (r t.1) (r t.2.1) (r t.2.2))
    (hS : ∀ e ∈ S, ∀ v ∈ r e, P v) :
    ∀ e ∈ ts.foldl (fun S t => insert t.1 S) S, ∀ v ∈ r e, P v := by
  induction ts generalizing S with
  | nil => exact hS
  | cons t ts ih =>
    rcases t with ⟨e, f, g⟩
    apply ih (insert e S) h.2.2 (fun t ht => htri t (List.mem_cons_of_mem _ ht))
    intro a ha
    rcases Finset.mem_insert.mp ha with rfl | ha
    · exact (htri (a, f, g) (List.mem_cons_self)).support P (hS f h.1) (hS g h.2.1)
    · exact hS a ha

/-- Endpoint counting bounds any graph-edge realization generated by finitely many seeds. -/
theorem edge_realization_bound {A V : Type*} [DecidableEq A] (r : A → Sym2 V)
    (S : Finset A) (ts : List (A × A × A))
    (h : ValidTrace S ts)
    (htri : ∀ t ∈ ts, EdgeTriangle (r t.1) (r t.2.1) (r t.2.2))
    (hinj : Set.InjOn r ↑(ts.foldl (fun S t => insert t.1 S) S)) :
    (ts.foldl (fun S t => insert t.1 S) S).card ≤ (2 * S.card + 1).choose 2 := by
  classical
  let T := S.biUnion (fun e => (r e).toFinset)
  have hc : T.card ≤ 2 * S.card := by
    apply (Finset.card_biUnion_le_card_mul S (fun e => (r e).toFinset) 2 ?_).trans_eq
      (Nat.mul_comm _ _)
    intro e he
    rw [Sym2.card_toFinset]
    split_ifs <;> omega
  have hs : ∀ e ∈ S, ∀ v ∈ r e, v ∈ T := by
    intro e he v hv
    exact Finset.mem_biUnion.mpr ⟨e, he, Sym2.mem_toFinset.mpr hv⟩
  have ht := supported_trace r (fun v => v ∈ T) S ts h htri hs
  have hsub : (ts.foldl (fun S t => insert t.1 S) S).image r ⊆ T.sym2 := by
    intro e he
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp he
    exact Finset.mem_sym2_iff.mpr (ht a ha)
  have hh := Finset.card_le_card hsub
  rw [Finset.card_image_of_injOn hinj, Finset.card_sym2] at hh
  exact hh.trans (Nat.choose_le_choose 2 (by omega))

abbrev Label := Fin 4096
abbrev Sextuple := Fin 6 → Fin 12

/-- The bit mask of the four selected elements. -/
def mask (a b c d : Fin 12) : Label :=
  (2 : Label) ^ a.val + 2 ^ b.val + 2 ^ c.val + 2 ^ d.val

/-- Delete the matched pairs `(0,2)`, `(1,4)`, `(3,5)` from the six positions. -/
def faces (t : Sextuple) : Fin 3 → Label :=
  ![mask (t 1) (t 3) (t 4) (t 5), mask (t 0) (t 2) (t 3) (t 5),
    mask (t 0) (t 1) (t 2) (t 4)]

def triple (t : Sextuple) (i : Fin 3) : Label × Label × Label :=
  (faces t i, faces t (i + 1), faces t (i + 2))

lemma triangle_triple {V : Type*} (r : Label → Sym2 V) (t : Sextuple)
    (h : EdgeTriangle (r (faces t 0)) (r (faces t 1)) (r (faces t 2))) (i : Fin 3) :
    EdgeTriangle (r (triple t i).1) (r (triple t i).2.1) (r (triple t i).2.2) := by
  fin_cases i
  · exact h
  · exact h.rotate
  · exact h.rotate.rotate

