private theorem certificate1 : ∀ e d : A2,
    (arcGraph (arcGraph K)).Adj e d → H1.Adj (image1 e) (image1 d) := by
  decide +kernel

/-- A fully checked 60-vertex homomorphism certificate. -/
def hom1 : arcGraph (arcGraph K) →g H1 (A := ℕ) where
  toFun := image1
  map_rel' := fun {e d} h => certificate1 e d h

/-- The twice-right-adjoint candidate already contains a four-clique. -/
theorem twice_right_not_cliqueFree1 : ¬(right (right (H1 (A := ℕ)))).CliqueFree 4 :=
  (right_not_cliqueFree_iff (right (H1 (A := ℕ))) 4).mpr ⟨toRight hom1⟩

