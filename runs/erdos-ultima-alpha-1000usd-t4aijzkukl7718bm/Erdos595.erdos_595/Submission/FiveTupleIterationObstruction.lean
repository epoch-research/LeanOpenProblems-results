import Submission.ArcAdjoint

/-!
Exact finite witnesses show that both surviving two-type disjoint
five-coordinate bases develop a K4 after TWO applications of the
biclique right adjoint. This is an obstruction to those iterations,
not a solution to Erdős 595. The first right adjoints are not ruled out.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
open SimpleGraph Set
open Erdos595ArcAdjoint
namespace Erdos595FiveIteration

abbrev Point := Fin 5 → ℕ

def P10 {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Prop :=
  x 0 < x 1 ∧ x 1 < x 2 ∧ x 2 < x 3 ∧ x 3 < y 0 ∧ y 0 < x 4 ∧ x 4 < y 1 ∧ y 1 < y 2 ∧ y 2 < y 3 ∧ y 3 < y 4

def P11 {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Prop :=
  x 0 < x 1 ∧ x 1 < y 0 ∧ y 0 < x 2 ∧ x 2 < y 1 ∧ y 1 < x 3 ∧ x 3 < y 2 ∧ y 2 < x 4 ∧ x 4 < y 3 ∧ y 3 < y 4

instance {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Decidable (P10 x y) :=
  inferInstanceAs (Decidable (x 0 < x 1 ∧ x 1 < x 2 ∧ x 2 < x 3 ∧ x 3 < y 0 ∧ y 0 < x 4 ∧ x 4 < y 1 ∧ y 1 < y 2 ∧ y 2 < y 3 ∧ y 3 < y 4))

instance {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Decidable (P11 x y) :=
  inferInstanceAs (Decidable (x 0 < x 1 ∧ x 1 < y 0 ∧ y 0 < x 2 ∧ x 2 < y 1 ∧ y 1 < x 3 ∧ x 3 < y 2 ∧ y 2 < x 4 ∧ x 4 < y 3 ∧ y 3 < y 4))

def H1 {A : Type*} [LinearOrder A] : SimpleGraph (Fin 5 → A) where
  Adj x y := (P10 x y ∨ P11 x y) ∨ (P10 y x ∨ P11 y x)
  symm := fun _ _ h => h.symm
  loopless := by
    intro x h
    rcases h with (h | h) | (h | h) <;> simp only [P10, P11] at h <;> rcases h with ⟨h1,h2,h3,h4,h5,h6,h7,h8,h9⟩ <;> order

instance {A : Type*} [LinearOrder A] : DecidableRel (H1 (A := A)).Adj := fun x y =>
  inferInstanceAs (Decidable ((P10 x y ∨ P11 x y) ∨ (P10 y x ∨ P11 y x)))

def P20 {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Prop :=
  x 0 < x 1 ∧ x 1 < x 2 ∧ x 2 < y 0 ∧ y 0 < x 3 ∧ x 3 < y 1 ∧ y 1 < x 4 ∧ x 4 < y 2 ∧ y 2 < y 3 ∧ y 3 < y 4

def P21 {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Prop :=
  x 0 < y 0 ∧ y 0 < x 1 ∧ x 1 < x 2 ∧ x 2 < y 1 ∧ y 1 < x 3 ∧ x 3 < y 2 ∧ y 2 < y 3 ∧ y 3 < x 4 ∧ x 4 < y 4

instance {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Decidable (P20 x y) :=
  inferInstanceAs (Decidable (x 0 < x 1 ∧ x 1 < x 2 ∧ x 2 < y 0 ∧ y 0 < x 3 ∧ x 3 < y 1 ∧ y 1 < x 4 ∧ x 4 < y 2 ∧ y 2 < y 3 ∧ y 3 < y 4))

instance {A : Type*} [LinearOrder A] (x y : Fin 5 → A) : Decidable (P21 x y) :=
  inferInstanceAs (Decidable (x 0 < y 0 ∧ y 0 < x 1 ∧ x 1 < x 2 ∧ x 2 < y 1 ∧ y 1 < x 3 ∧ x 3 < y 2 ∧ y 2 < y 3 ∧ y 3 < x 4 ∧ x 4 < y 4))

def H2 {A : Type*} [LinearOrder A] : SimpleGraph (Fin 5 → A) where
  Adj x y := (P20 x y ∨ P21 x y) ∨ (P20 y x ∨ P21 y x)
  symm := fun _ _ h => h.symm
  loopless := by
    intro x h
    rcases h with (h | h) | (h | h) <;> simp only [P20, P21] at h <;> rcases h with ⟨h1,h2,h3,h4,h5,h6,h7,h8,h9⟩ <;> order

instance {A : Type*} [LinearOrder A] : DecidableRel (H2 (A := A)).Adj := fun x y =>
  inferInstanceAs (Decidable ((P20 x y ∨ P21 x y) ∨ (P20 y x ∨ P21 y x)))

private abbrev K := (⊤ : SimpleGraph (Fin 4))
private abbrev A1 := Arc K
private instance : DecidableRel (arcGraph K).Adj := fun p q =>
  inferInstanceAs (Decidable (p.1.2 = q.1.1 ∨ q.1.2 = p.1.1))
private abbrev A2 := Arc (arcGraph K)
private instance : DecidableRel (arcGraph (arcGraph K)).Adj := fun p q =>
  inferInstanceAs (Decidable (p.1.2 = q.1.1 ∨ q.1.2 = p.1.1))

