    (arcGraph (arcGraph K)).Adj e d → H2.Adj (image2 e) (image2 d) := by
  decide +kernel

/-- A fully checked 60-vertex homomorphism certificate. -/
def hom2 : arcGraph (arcGraph K) →g H2 (A := ℕ) where
  toFun := image2
  map_rel' := fun {e d} h => certificate2 e d h

/-- The twice-right-adjoint candidate already contains a four-clique. -/
theorem twice_right_not_cliqueFree2 : ¬(right (right (H2 (A := ℕ)))).CliqueFree 4 :=
  (right_not_cliqueFree_iff (right (H2 (A := ℕ))) 4).mpr ⟨toRight hom2⟩

#print axioms twice_right_not_cliqueFree2

private theorem bound1 : ∀ e : A2, ∀ i : Fin 5, image1 e i < 177 := by
  decide +kernel

private def finiteHom1 : arcGraph (arcGraph K) →g H1 (A := Fin 177) where
  toFun := fun e i => ⟨image1 e i, bound1 e i⟩
  map_rel' := fun {e d} h => certificate1 e d h

/-- Order embeddings transport the strict interleaving relation. -/
def orderMap1 {A B : Type*} [LinearOrder A] [LinearOrder B] (f : A ↪o B) :
    H1 (A := A) →g H1 (A := B) where
  toFun := fun x i => f (x i)
  map_rel' := by
    intro x y h
    change ((P10 (fun i => f (x i)) (fun i => f (y i)) ∨
      P11 (fun i => f (x i)) (fun i => f (y i))) ∨
      (P10 (fun i => f (y i)) (fun i => f (x i)) ∨
      P11 (fun i => f (y i)) (fun i => f (x i))))
    simpa only [P10, P11, f.lt_iff_lt] using h

/-- The obstruction holds at every infinite cardinality, even for linear
orders with no increasing infinite sequence: only a finite chain is needed. -/
theorem infinite_twice_right_not_cliqueFree1 (A : Type*) [LinearOrder A] [Infinite A] :
    ¬(right (right (H1 (A := A)))).CliqueFree 4 := by
  obtain ⟨f⟩ := nonempty_orderEmbedding_of_finite_infinite (Fin 177) A
  let h := (orderMap1 f).comp finiteHom1
  exact (right_not_cliqueFree_iff (right (H1 (A := A))) 4).mpr ⟨toRight h⟩

#print axioms infinite_twice_right_not_cliqueFree1

private theorem bound2 : ∀ e : A2, ∀ i : Fin 5, image2 e i < 131 := by
  decide +kernel

private def finiteHom2 : arcGraph (arcGraph K) →g H2 (A := Fin 131) where
  toFun := fun e i => ⟨image2 e i, bound2 e i⟩
  map_rel' := fun {e d} h => certificate2 e d h

/-- Order embeddings transport the strict interleaving relation. -/
def orderMap2 {A B : Type*} [LinearOrder A] [LinearOrder B] (f : A ↪o B) :
    H2 (A := A) →g H2 (A := B) where
  toFun := fun x i => f (x i)
  map_rel' := by
    intro x y h
    change ((P20 (fun i => f (x i)) (fun i => f (y i)) ∨
      P21 (fun i => f (x i)) (fun i => f (y i))) ∨
      (P20 (fun i => f (y i)) (fun i => f (x i)) ∨
      P21 (fun i => f (y i)) (fun i => f (x i))))
    simpa only [P20, P21, f.lt_iff_lt] using h

/-- The obstruction holds at every infinite cardinality, even for linear
orders with no increasing infinite sequence: only a finite chain is needed. -/
theorem infinite_twice_right_not_cliqueFree2 (A : Type*) [LinearOrder A] [Infinite A] :
    ¬(right (right (H2 (A := A)))).CliqueFree 4 := by
  obtain ⟨f⟩ := nonempty_orderEmbedding_of_finite_infinite (Fin 131) A
  let h := (orderMap2 f).comp finiteHom2
  exact (right_not_cliqueFree_iff (right (H2 (A := A))) 4).mpr ⟨toRight h⟩

#print axioms infinite_twice_right_not_cliqueFree2

end Erdos595FiveIteration
