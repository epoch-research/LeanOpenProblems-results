import FormalConjecturesUtil

/-!
# A finite obstruction to the matched-pair construction

Auxiliary to the investigation of Erdős Problem 595. This file does not settle
the original conjecture. The displayed finite hypergraph cannot map to the
triangle hypergraph of any `K₄`-free simple graph, even non-injectively.
-/

open SimpleGraph Set
namespace Erdos595RootCases

def EdgeTriangle {V : Type*} (e f g : Sym2 V) : Prop :=
  ∃ a b c, e = s(a, b) ∧ f = s(a, c) ∧ g = s(b, c)

lemma EdgeTriangle.rotate {V : Type*} {e f g : Sym2 V} (h : EdgeTriangle e f g) :
    EdgeTriangle f g e := by
  obtain ⟨a, b, c, rfl, rfl, rfl⟩ := h
  exact ⟨c, a, b, Sym2.eq_swap, Sym2.eq_swap, rfl⟩

lemma EdgeTriangle.expand {V : Type*} {a b : V} {f g : Sym2 V}
    (h : EdgeTriangle s(a, b) f g) :
    ∃ c, (f = s(a, c) ∧ g = s(b, c)) ∨ (f = s(b, c) ∧ g = s(a, c)) := by
  obtain ⟨x, y, z, he, hf, hg⟩ := h
  refine ⟨z, ?_⟩
  rcases Sym2.eq_iff.mp he with ⟨he₁, he₂⟩ | ⟨he₁, he₂⟩
  · exact Or.inl ⟨by simpa only [he₁] using hf, by simpa only [he₂] using hg⟩
  · exact Or.inr ⟨by simpa only [he₂] using hf, by simpa only [he₁] using hg⟩

lemma adj_of_edge_eq {V : Type*} {G : SimpleGraph V} {e : Sym2 V} {a b : V}
    (h : e ∈ G.edgeSet) (he : e = s(a, b)) : G.Adj a b := by
  simpa only [he, SimpleGraph.mem_edgeSet] using h

lemma no_four_adj {V : Type*} {G : SimpleGraph V} (hG : G.CliqueFree 4) {a b c d : V}
    (hab : G.Adj a b) (hac : G.Adj a c) (had : G.Adj a d)
    (hbc : G.Adj b c) (hbd : G.Adj b d) (hcd : G.Adj c d) : False := by
  classical
  have ht : G.IsNClique 3 {a, b, c} :=
    SimpleGraph.is3Clique_triple_iff.mpr ⟨hab, hac, hbc⟩
  apply hG _ (ht.insert (a := d) ?_)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl
  · exact had.symm
  · exact hbd.symm
  · exact hcd.symm

