private theorem case_18 {V : Type*} (G : SimpleGraph V) (hG : G.CliqueFree 4)
    (r : Fin 35 → Sym2 V) (hedges : ∀ i, r i ∈ G.edgeSet)
    (htri : ∀ i : Fin 28, EdgeTriangle (r (triangles i).1)
      (r (triangles i).2.1) (r (triangles i).2.2))
    (v0 v1 v2 v3 v4 v5 : V)
    (hE0 : r 0 = s(v0, v1))
    (hE1 : r 1 = s(v0, v2))
    (hE2 : r 2 = s(v0, v2))
    (hE3 : r 3 = s(v1, v3))
    (hE4 : r 4 = s(v1, v3))
    (hE6 : r 6 = s(v1, v4))
    (hE7 : r 7 = s(v0, v3))
    (hE8 : r 8 = s(v0, v5))
    (hE9 : r 9 = s(v2, v3))
    (hE10 : r 10 = s(v2, v3))
    (hE11 : r 11 = s(v2, v3))
    (hE12 : r 12 = s(v0, v1))
    (hE13 : r 13 = s(v0, v1))
    (hE14 : r 14 = s(v0, v1))
    (hE19 : r 19 = s(v0, v4))
    (hE20 : r 20 = s(v1, v3))
    (hE21 : r 21 = s(v1, v5))
    (hE22 : r 22 = s(v2, v3))
    (hE23 : r 23 = s(v2, v5))
    (hE24 : r 24 = s(v2, v5))
    (hE25 : r 25 = s(v0, v3))
    (hE26 : r 26 = s(v0, v3))
    (hE27 : r 27 = s(v0, v3))
    (hE28 : r 28 = s(v0, v3))
    (hE30 : r 30 = s(v0, v4))
    (hE31 : r 31 = s(v0, v4))
    (hE32 : r 32 = s(v1, v3))
    (hE33 : r 33 = s(v1, v3))
    (hE34 : r 34 = s(v0, v1))
    : False := by
  have ht := (htri 19)
  change EdgeTriangle (r 33) (r 15) (r 9) at ht
  rw [hE33] at ht
  obtain ⟨v6, hAlt⟩ := ht.expand
  rcases hAlt with ⟨hE15, hTmpg19_6⟩ | ⟨hE15, hTmpg19_6⟩
  ·
    have hz := hE9.symm.trans hTmpg19_6
    rcases Sym2.eq_iff.mp hz with ⟨heq1, heq2⟩ | ⟨heq1, heq2⟩
    ·
      revert heq2
      subst v3
      intro heq2
      subst v6
      exact G.loopless v2 (adj_of_edge_eq (hedges 22) hE22)
    ·
      revert heq2
      subst v6
      intro heq2
      clear heq2
      exact no_four_adj hG (adj_of_edge_eq (hedges 34) hE34) (adj_of_edge_eq (hedges 2) hE2) (adj_of_edge_eq (hedges 28) hE28) (adj_of_edge_eq (hedges 15) hE15) (adj_of_edge_eq (hedges 33) hE33) (adj_of_edge_eq (hedges 22) hE22)
  ·
    have hz := hE9.symm.trans hTmpg19_6
    rcases Sym2.eq_iff.mp hz with ⟨heq1, heq2⟩ | ⟨heq1, heq2⟩
    ·
      revert heq2
      subst v2
      intro heq2
      subst v6
      exact G.loopless v3 (adj_of_edge_eq (hedges 15) hE15)
    ·
      revert heq2
      subst v6
      intro heq2
      subst v3
      exact G.loopless v1 (adj_of_edge_eq (hedges 33) hE33)

