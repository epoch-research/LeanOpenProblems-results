  exact no_source_map H m h (fun i => f (sourceVertex i))
    (fun i j hij => f.map_adj (sourceVertex_adj hij))

include h in
theorem second_right_cliqueFree : (right (right H)).CliqueFree 4 := by
  by_contra hn
  obtain ⟨f⟩ := (right_not_cliqueFree_iff (right H) 4).mp hn
  exact no_second_arc_four H m h ⟨fromRight f⟩

#print axioms raw_unsat
#print axioms no_second_arc_four
#print axioms second_right_cliqueFree
end Erdos595OneEdgeLocal
