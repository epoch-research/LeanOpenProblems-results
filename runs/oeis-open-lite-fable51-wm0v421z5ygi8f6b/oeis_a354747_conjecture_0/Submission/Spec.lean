import FormalConjectures.Util.ProblemImports

open Nat Set

/--
A354747: Start with $2n-1$; repeatedly triple and add 2 until reaching a prime.
$a(n)$ = number of steps until reaching a prime $> 2n-1$, or 0 if no prime is ever reached.
Equivalently, $a(n)$ is the smallest $m \ge 1$ such that $2 \cdot n \cdot 3^m - 1$ is prime.
-/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

namespace A354747Proof

open LucasLehmer

/-! ### Kernel-friendly natural number computations -/

/-- Force evaluation of a natural number before continuing. -/
def force {α : Type} (n : ℕ) (k : ℕ → α) : α :=
  match n with
  | 0 => k 0
  | n+1 => k (n+1)

theorem force_eq {α : Type} (n : ℕ) (k : ℕ → α) : force n k = k n := by
  cases n <;> rfl

/-- One cubing step of the Lucas `V`-sequence: `t ↦ t^3 - 3t  (mod M)`. -/
def cubeStep (M t : ℕ) : ℕ := (t * ((t * t) % M + (M - 3))) % M

/-- Iterate `cubeStep` `n` times. -/
def chain (M : ℕ) : ℕ → ℕ → ℕ
  | 0, t => t
  | n+1, t => force (cubeStep M t) (fun y => chain M n y)

theorem chain_succ (M n t : ℕ) : chain M (n+1) t = chain M n (cubeStep M t) := by
  rw [chain, force_eq]

theorem chain_add (M n k t : ℕ) : chain M (n + k) t = chain M k (chain M n t) := by
  induction n generalizing t with
  | zero => rw [Nat.zero_add]; rfl
  | succ n ih => rw [Nat.succ_add, chain_succ, ih, chain_succ]

/-- Binary Lucas ladder: `lucasBin M y f n = (V_n, V_{n+1})` (mod `M`) provided `n < 2^f`,
where `V_0 = 2`, `V_1 = y`. -/
def lucasBin (M y : ℕ) : ℕ → ℕ → ℕ × ℕ
  | 0, _ => (2 % M, y % M)
  | f+1, n =>
    if n = 0 then (2 % M, y % M) else
    let p := lucasBin M y f (n / 2)
    if n % 2 = 0 then ((p.1 * p.1 + (M - 2)) % M, (p.1 * p.2 + (M - y % M)) % M)
    else ((p.1 * p.2 + (M - y % M)) % M, (p.2 * p.2 + (M - 2)) % M)

/-- The remaining certificate checks, given `y' = V_{3^(m-1)}`. -/
def checkRest (N y' u v : ℕ) : Bool :=
  let y := cubeStep N y'
  let w := (lucasBin N y' 17 100943).1
  let z := (lucasBin N y 17 100943).1
  ((u * u) % N == (3 * v * v + 1) % N) && (z == N - 2) &&
  (Nat.gcd ((w * w + (N - 4)) % N) N == 1) && (Nat.gcd ((y * y + (N - 4)) % N) N == 1)

/-! ### Casting into `X q` -/

section Cast

variable {q : ℕ} [Fact q.Prime]

theorem natCast_M_X {M : ℕ} (hq : q ∣ M) : ((M : ℕ) : X q) = 0 := by
  apply X.ext
  · simp only [X.fst_natCast, X.zero_fst]
    exact (ZMod.natCast_eq_zero_iff M q).2 hq
  · simp

theorem natCast_mod_X {M : ℕ} (hq : q ∣ M) (x : ℕ) : ((x % M : ℕ) : X q) = (x : X q) := by
  conv_rhs => rw [← Nat.mod_add_div x M]
  push_cast
  rw [natCast_M_X hq]
  simp

theorem natCast_sub_X {M c : ℕ} (hq : q ∣ M) (hc : c ≤ M) :
    ((M - c : ℕ) : X q) = -(c : X q) := by
  rw [Nat.cast_sub hc, natCast_M_X hq, zero_sub]

theorem cubeStep_cast {M : ℕ} (hq : q ∣ M) (hM : 3 ≤ M) (t : ℕ) (a b : X q) (hab : a * b = 1)
    (ht : (t : X q) = a + b) : ((cubeStep M t : ℕ) : X q) = a ^ 3 + b ^ 3 := by
  unfold cubeStep
  rw [natCast_mod_X hq]
  push_cast
  rw [natCast_mod_X hq, natCast_sub_X hq hM]
  push_cast
  rw [ht]
  linear_combination (3 * (a + b)) * hab

theorem chain_cast {M : ℕ} (hq : q ∣ M) (hM : 3 ≤ M) (n : ℕ) :
    ∀ (t : ℕ) (a b : X q), a * b = 1 → (t : X q) = a + b →
      ((chain M n t : ℕ) : X q) = a ^ (3 ^ n) + b ^ (3 ^ n) := by
  induction n with
  | zero => intro t a b _ ht; simpa [chain] using ht
  | succ n ih =>
    intro t a b hab ht
    rw [chain_succ]
    have h3 : a ^ 3 * b ^ 3 = 1 := by rw [← mul_pow, hab, one_pow]
    rw [ih _ _ _ h3 (cubeStep_cast hq hM t a b hab ht), ← pow_mul, ← pow_mul, pow_succ,
      mul_comm (3 ^ n) 3]

theorem lucasBin_cast {M : ℕ} (hq : q ∣ M) (hM : 2 ≤ M) (y : ℕ) (a b : X q) (hab : a * b = 1)
    (hy : (y : X q) = a + b) (f : ℕ) :
    ∀ n : ℕ, n < 2 ^ f →
      (((lucasBin M y f n).1 : ℕ) : X q) = a ^ n + b ^ n ∧
      (((lucasBin M y f n).2 : ℕ) : X q) = a ^ (n + 1) + b ^ (n + 1) := by
  induction f with
  | zero =>
    intro n hn
    have : n = 0 := by simpa using hn
    subst this
    simp only [lucasBin]
    rw [natCast_mod_X hq, natCast_mod_X hq, hy]
    norm_num
  | succ f ih =>
    intro n hn
    by_cases h0 : n = 0
    · subst h0
      simp only [lucasBin, if_true]
      rw [natCast_mod_X hq, natCast_mod_X hq, hy]
      norm_num
    · have hhalf : n / 2 < 2 ^ f := by
        rw [pow_succ] at hn; lia
      obtain ⟨ih1, ih2⟩ := ih (n / 2) hhalf
      simp only [lucasBin, h0, if_false]
      generalize hh : n / 2 = h at ih1 ih2 ⊢
      have hpow : a ^ h * b ^ h = 1 := by rw [← mul_pow, hab, one_pow]
      have hpow' : a ^ (h + 1) * b ^ (h + 1) = 1 := by rw [← mul_pow, hab, one_pow]
      by_cases hpar : n % 2 = 0
      · simp only [hpar, if_true]
        have hn' : n = 2 * h := by lia
        subst hn'
        constructor
        · rw [natCast_mod_X hq]; push_cast
          rw [natCast_sub_X hq hM, ih1]
          push_cast
          rw [pow_mul, pow_mul]
          linear_combination (2 : X q) * hpow
        · rw [natCast_mod_X hq]; push_cast
          rw [natCast_sub_X hq (Nat.mod_lt _ (by lia)).le, natCast_mod_X hq, ih1, ih2, hy]
          linear_combination (a + b) * hpow
      · simp only [hpar, if_false]
        have hn' : n = 2 * h + 1 := by lia
        subst hn'
        constructor
        · rw [natCast_mod_X hq]; push_cast
          rw [natCast_sub_X hq (Nat.mod_lt _ (by lia)).le, natCast_mod_X hq, ih1, ih2, hy]
          linear_combination (a + b) * hpow
        · rw [natCast_mod_X hq]; push_cast
          rw [natCast_sub_X hq hM, ih2]
          push_cast
          have : 2 * h + 1 + 1 = 2 * (h + 1) := by ring
          rw [this, pow_mul, pow_mul]
          linear_combination (2 : X q) * hpow'

theorem lucasBin_fst_cast {M : ℕ} (hq : q ∣ M) (hM : 2 ≤ M) (y : ℕ) (a b : X q) (hab : a * b = 1)
    (hy : (y : X q) = a + b) (f n : ℕ) (hn : n < 2 ^ f) :
    (((lucasBin M y f n).1 : ℕ) : X q) = a ^ n + b ^ n :=
  (lucasBin_cast hq hM y a b hab hy f n hn).1

/-- `X q` is reduced for `q ∉ {2, 3}`. -/
theorem X_sq_eq_zero {x : X q} (h2 : (2 : ZMod q) ≠ 0) (h3 : (3 : ZMod q) ≠ 0)
    (hx : x ^ 2 = 0) : x = 0 := by
  have h1 : x.1 * x.1 + 3 * x.2 * x.2 = 0 := by
    have := congr_arg Prod.fst hx
    rwa [pow_two, X.mul_fst] at this
  have h2' : x.1 * x.2 + x.2 * x.1 = 0 := by
    have := congr_arg Prod.snd hx
    rwa [pow_two, X.mul_snd] at this
  have h22 : 2 * (x.1 * x.2) = 0 := by linear_combination h2'
  rcases mul_eq_zero.1 h22 with h | h
  · exact absurd h h2
  · rcases mul_eq_zero.1 h with h | h
    · have : 3 * x.2 * x.2 = 0 := by rw [h] at h1; simpa using h1
      rcases mul_eq_zero.1 this with h' | h'
      · rcases mul_eq_zero.1 h' with h'' | h''
        · exact absurd h'' h3
        · exact X.ext h h''
      · exact X.ext h h'
    · have : x.1 * x.1 = 0 := by rw [h] at h1; simpa using h1
      exact X.ext (mul_self_eq_zero.1 this) h

end Cast

/-! ### The main theorem -/

theorem prime_100943 : Nat.Prime 100943 := by norm_num

theorem primes_dvd (p m : ℕ) (hp : p.Prime) (h : p ∣ 201886 * 3 ^ m) :
    p = 2 ∨ p = 3 ∨ p = 100943 := by
  have h201886 : (201886 : ℕ) = 2 * 100943 := by norm_num
  rw [h201886] at h
  rcases (Nat.Prime.dvd_mul hp).1 h with h | h
  · rcases (Nat.Prime.dvd_mul hp).1 h with h | h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 h)
    · exact Or.inr (Or.inr ((Nat.prime_dvd_prime_iff_eq hp prime_100943).1 h))
  · exact Or.inr (Or.inl ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1
      (hp.dvd_of_dvd_pow h)))

theorem prime_of_check (m u v y' : ℕ) (hm : 1 ≤ m)
    (hchain : chain (201886 * 3 ^ m - 1) (m - 1) ((2 * u) % (201886 * 3 ^ m - 1)) = y')
    (h : checkRest (201886 * 3 ^ m - 1) y' u v = true) : Nat.Prime (201886 * 3 ^ m - 1) := by
  -- basic facts about `N`
  set N := 201886 * 3 ^ m - 1 with hN
  have h3m : 3 ≤ 3 ^ m := by
    calc 3 = 3 ^ 1 := by norm_num
      _ ≤ 3 ^ m := Nat.pow_le_pow_right (by norm_num) hm
  have hN1 : N + 1 = 201886 * 3 ^ m := by
    rw [hN]; apply Nat.sub_add_cancel; nlinarith
  have hNbig : 605657 ≤ N := by lia
  have hNpos : 0 < N := by lia
  have hN3 : 3 ≤ N := by lia
  have hNodd : N % 2 = 1 := by lia
  have hNmod3 : N % 3 = 2 := by
    have : (201886 * 3 ^ m) % 3 = 0 := by
      rw [Nat.mul_mod, Nat.pow_mod]; simp [show m ≠ 0 by lia]
    lia
  -- unpack the check
  simp only [checkRest, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  -- suppose `N` is not prime
  by_contra hnp
  set q := N.minFac with hq
  have hqprime : q.Prime := Nat.minFac_prime (by lia)
  have hqdvd : q ∣ N := Nat.minFac_dvd N
  have hqsq : q ^ 2 ≤ N := Nat.minFac_sq_le_self hNpos hnp
  have hq2 : q ≠ 2 := by
    rintro hq2; rw [hq2] at hqdvd; have := Nat.mod_eq_zero_of_dvd hqdvd; lia
  have hq3 : q ≠ 3 := by
    rintro hq3; rw [hq3] at hqdvd; have := Nat.mod_eq_zero_of_dvd hqdvd; lia
  have hq2lt : 2 < q := by
    have := hqprime.two_le; lia
  haveI : Fact q.Prime := ⟨hqprime⟩
  haveI : Fact (2 < q) := ⟨hq2lt⟩
  haveI : NeZero q := ⟨hqprime.ne_zero⟩
  have h2Z : (2 : ZMod q) ≠ 0 := by
    intro h; have := (ZMod.natCast_eq_zero_iff 2 q).1 (by exact_mod_cast h)
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hqprime Nat.prime_two).1 this)
  have h3Z : (3 : ZMod q) ≠ 0 := by
    intro h; have := (ZMod.natCast_eq_zero_iff 3 q).1 (by exact_mod_cast h)
    exact hq3 ((Nat.prime_dvd_prime_iff_eq hqprime Nat.prime_three).1 this)
  -- the element `β = u + v√3` and its conjugate
  let β : X q := ((u : ZMod q), (v : ZMod q))
  let β' : X q := ((u : ZMod q), -(v : ZMod q))
  have hββ' : β * β' = 1 := by
    have h1' : ((u * u : ℕ) : X q) = ((3 * v * v + 1 : ℕ) : X q) := by
      rw [← natCast_mod_X hqdvd, h1, natCast_mod_X hqdvd]
    have h1f := congr_arg Prod.fst h1'
    simp only [X.fst_natCast] at h1f
    push_cast at h1f
    apply X.ext
    · simp only [X.mul_fst, X.one_fst, β, β']
      linear_combination h1f
    · simp only [X.mul_snd, X.one_snd, β, β']
      ring
  have hsum : (((2 * u) % N : ℕ) : X q) = β + β' := by
    rw [natCast_mod_X hqdvd]
    apply X.ext
    · simp [β, β']; ring
    · simp [β, β']
  -- the chain values
  set t0 := (2 * u) % N with ht0
  set y := cubeStep N y' with hy
  have hy'cast : ((y' : ℕ) : X q) = β ^ (3 ^ (m - 1)) + β' ^ (3 ^ (m - 1)) := by
    rw [← hchain]; exact chain_cast hqdvd hN3 (m - 1) t0 β β' hββ' hsum
  have hpow_mul : β ^ (3 ^ (m - 1)) * β' ^ (3 ^ (m - 1)) = 1 := by
    rw [← mul_pow, hββ', one_pow]
  have hycast : ((y : ℕ) : X q) = β ^ (3 ^ m) + β' ^ (3 ^ m) := by
    rw [hy, cubeStep_cast hqdvd hN3 y' _ _ hpow_mul hy'cast, ← pow_mul, ← pow_mul,
      ← pow_succ, Nat.sub_add_cancel hm]
  have hpow_mul' : β ^ (3 ^ m) * β' ^ (3 ^ m) = 1 := by
    rw [← mul_pow, hββ', one_pow]
  -- condition (1): β^((N+1)/2) = -1
  obtain ⟨e, he⟩ : ∃ e, e = 3 ^ m * 100943 := ⟨_, rfl⟩
  have h2e : 2 * e = N + 1 := by rw [hN1, he]; ring
  have hβe : β ^ e = -1 := by
    have hV := lucasBin_fst_cast hqdvd (by lia) y _ _ hpow_mul' hycast 17 100943 (by norm_num)
    rw [h2, ← pow_mul, ← pow_mul, ← he] at hV
    have hN2 : ((N - 2 : ℕ) : X q) = -2 := by
      rw [natCast_sub_X hqdvd (by lia)]; norm_num
    rw [hN2] at hV
    have hee : β ^ e * β' ^ e = 1 := by rw [← mul_pow, hββ', one_pow]
    have hsq : (β ^ e + 1) ^ 2 = 0 := by
      linear_combination (-β ^ e) * hV - hee
    have := X_sq_eq_zero h2Z h3Z hsq
    exact eq_neg_of_add_eq_zero_left this
  have hβN1 : β ^ (N + 1) = 1 := by
    rw [← h2e, mul_comm, pow_mul, hβe]; norm_num
  -- condition (2): β^((N+1)/3) ≠ 1
  obtain ⟨f, hf⟩ : ∃ f, f = 3 ^ (m - 1) * 100943 := ⟨_, rfl⟩
  have h3f : 3 * (2 * f) = N + 1 := by
    rw [hN1, hf]
    have : 3 ^ m = 3 * 3 ^ (m - 1) := by
      rw [← _root_.pow_succ', Nat.sub_add_cancel hm]
    rw [this]; ring
  have hβ2f : β ^ (2 * f) ≠ 1 := by
    intro hcon
    set w := (lucasBin N y' 17 100943).1 with hw
    have hV := lucasBin_fst_cast hqdvd (by lia) y' _ _ hpow_mul hy'cast 17 100943 (by norm_num)
    rw [← hw, ← pow_mul, ← pow_mul, ← hf] at hV
    have hff : β ^ f * β' ^ f = 1 := by rw [← mul_pow, hββ', one_pow]
    have hβ'2f : β' ^ (2 * f) = 1 := by
      have : β ^ (2 * f) * β' ^ (2 * f) = 1 := by rw [← mul_pow, hββ', one_pow]
      rwa [hcon, one_mul] at this
    have hw2 : ((w * w + (N - 4) : ℕ) : X q) = 0 := by
      push_cast
      rw [natCast_sub_X hqdvd (by lia), hV]
      have e1 : β ^ f * β ^ f = β ^ (2 * f) := by rw [← pow_add]; ring_nf
      have e2 : β' ^ f * β' ^ f = β' ^ (2 * f) := by rw [← pow_add]; ring_nf
      linear_combination e1 + e2 + hcon + hβ'2f + 2 * hff
    have hw2' : (((w * w + (N - 4)) % N : ℕ) : X q) = 0 := by
      rw [natCast_mod_X hqdvd, hw2]
    have hdvd : q ∣ (w * w + (N - 4)) % N := by
      have := congr_arg Prod.fst hw2'
      simp only [X.fst_natCast, X.zero_fst] at this
      exact (ZMod.natCast_eq_zero_iff _ q).1 this
    have : q ∣ Nat.gcd ((w * w + (N - 4)) % N) N := Nat.dvd_gcd hdvd hqdvd
    rw [h3] at this
    exact hqprime.one_lt.ne' (Nat.dvd_one.1 this)
  -- condition (3): β^((N+1)/100943) ≠ 1
  have h100943 : 100943 * (2 * 3 ^ m) = N + 1 := by rw [hN1]; ring
  have hβ2g : β ^ (2 * 3 ^ m) ≠ 1 := by
    intro hcon
    have hβ'2g : β' ^ (2 * 3 ^ m) = 1 := by
      have : β ^ (2 * 3 ^ m) * β' ^ (2 * 3 ^ m) = 1 := by rw [← mul_pow, hββ', one_pow]
      rwa [hcon, one_mul] at this
    have hw2 : ((y * y + (N - 4) : ℕ) : X q) = 0 := by
      push_cast
      rw [natCast_sub_X hqdvd (by lia), hycast]
      have e1 : β ^ (3 ^ m) * β ^ (3 ^ m) = β ^ (2 * 3 ^ m) := by rw [← pow_add]; ring_nf
      have e2 : β' ^ (3 ^ m) * β' ^ (3 ^ m) = β' ^ (2 * 3 ^ m) := by rw [← pow_add]; ring_nf
      linear_combination e1 + e2 + hcon + hβ'2g + 2 * hpow_mul'
    have hw2' : (((y * y + (N - 4)) % N : ℕ) : X q) = 0 := by
      rw [natCast_mod_X hqdvd, hw2]
    have hdvd : q ∣ (y * y + (N - 4)) % N := by
      have := congr_arg Prod.fst hw2'
      simp only [X.fst_natCast, X.zero_fst] at this
      exact (ZMod.natCast_eq_zero_iff _ q).1 this
    have : q ∣ Nat.gcd ((y * y + (N - 4)) % N) N := Nat.dvd_gcd hdvd hqdvd
    rw [h4] at this
    exact hqprime.one_lt.ne' (Nat.dvd_one.1 this)
  -- the order of β is exactly N + 1
  have hord : orderOf β = N + 1 := by
    apply orderOf_eq_of_pow_and_pow_div_prime (by lia) hβN1
    intro p hp hpdvd
    rw [hN1] at hpdvd
    rcases primes_dvd p m hp hpdvd with rfl | rfl | rfl
    · rw [← h2e, Nat.mul_div_cancel_left _ (by norm_num), hβe]
      intro hcon
      have := congr_arg Prod.fst hcon
      simp only [X.neg_fst, X.one_fst] at this
      exact ZMod.neg_one_ne_one this
    · rw [← h3f, Nat.mul_div_cancel_left _ (by norm_num)]
      exact hβ2f
    · rw [← h100943, Nat.mul_div_cancel_left _ (by norm_num)]
      exact hβ2g
  -- but the order is at most the cardinality of `X q`, which is `q^2 ≤ N`
  have hle : orderOf β ≤ Fintype.card (X q) := orderOf_le_card_univ
  rw [hord, X.card_eq] at hle
  lia


/-! ### The certificate for `m = 39101` -/

-- The chain `V_(3^j)` is computed in 4 chunks so that each kernel computation stays small.

set_option maxRecDepth 100000 in
theorem chunk0 : chain (201886 * 3 ^ 39101 - 1) 9775 4 =  := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem chunk1 : chain (201886 * 3 ^ 39101 - 1) 9775  =  := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem chunk2 : chain (201886 * 3 ^ 39101 - 1) 9775  =  := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem chunk3 : chain (201886 * 3 ^ 39101 - 1) 9775  =  := by
  decide +kernel

theorem chain_total :
    chain (201886 * 3 ^ 39101 - 1) (39101 - 1) ((2 * 2) % (201886 * 3 ^ 39101 - 1)) =  := by
  have h0 : (2 * 2) % (201886 * 3 ^ 39101 - 1) = 4 := by
    decide +kernel
  have hs : (39101 - 1 : ℕ) = 9775 + 9775 + 9775 + 9775 := by norm_num
  rw [h0, hs]
  have e0 : chain (201886 * 3 ^ 39101 - 1) 9775 4 =  := chunk0
  have e1 : chain (201886 * 3 ^ 39101 - 1) (9775 + 9775) 4 =  := by
    rw [chain_add, e0]; exact chunk1
  have e2 : chain (201886 * 3 ^ 39101 - 1) (9775 + 9775 + 9775) 4 =  := by
    rw [chain_add, e1]; exact chunk2
  have e3 : chain (201886 * 3 ^ 39101 - 1) (9775 + 9775 + 9775 + 9775) 4 =  := by
    rw [chain_add, e2]; exact chunk3
  exact e3

set_option maxRecDepth 100000 in
theorem rest_ok : checkRest (201886 * 3 ^ 39101 - 1)  2 1 = true := by
  decide +kernel

theorem final_prime : Nat.Prime (201886 * 3 ^ 39101 - 1) :=
  prime_of_check 39101 2 1 _ (by norm_num) chain_total rest_ok

end A354747Proof

/-- The smallest unknown case is n = 100943. Is a(100943) = 0? -/
theorem oeis_a354747_conjecture_0 : a354747 100943 = 0 := by
  sorry

theorem oeis_a354747_conjecture_0.disproof : ¬ (type_of% @oeis_a354747_conjecture_0) := by
  intro h
  have hprime : Nat.Prime (2 * 100943 * 3 ^ 39101 - 1) := by
    have h2 : (2 * 100943 : ℕ) = 201886 := by norm_num
    rw [h2]
    exact A354747Proof.final_prime
  have hmem : 39101 ∈ {m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} :=
    ⟨by norm_num, hprime⟩
  have hne : ({m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} : Set ℕ).Nonempty := ⟨_, hmem⟩
  have hinf := Nat.sInf_mem hne
  have h' : sInf {m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} = 0 := h
  rw [h'] at hinf
  exact absurd hinf.1 (lt_irrefl 0)
