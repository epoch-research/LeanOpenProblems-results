lemma f_two_pow_lt (v : ℕ) : f (2 ^ v) < 161 / 100 := by
  rcases le_or_gt 9 v with h | h
  · have := f_two_pow_tail h
    have : (0 : ℚ) < 1 / (2 : ℚ) ^ v := by positivity
    rw [f_two_pow_nine] at *
    linarith
  · have := f_two_pow_mono h.le
    rw [f_two_pow_nine] at this
    linarith

lemma f_two_pow_three : f (2 ^ 3) = 54 / 35 := by
