  norm_num

/-! ### Box lemmas: excluding `f (2^v) * (Fa * Fb) = 2` from interval information -/

lemma box_gap {v : ℕ} {Fa Fb lo1 hi1 lo2 hi2 : ℚ} (w : ℕ)
    (h : f (2 ^ v) * (Fa * Fb) = 2)
    (h1 : lo1 ≤ Fa) (h2 : Fa ≤ hi1) (h3 : lo2 ≤ Fb) (h4 : Fb ≤ hi2)
    (hlo1 : 0 ≤ lo1) (hlo2 : 0 ≤ lo2)
    (hw1 : f (2 ^ w) * (hi1 * hi2) < 2) (hw2 : 2 < f (2 ^ (w + 1)) * (lo1 * lo2)) : False := by
  have hG1 : lo1 * lo2 ≤ Fa * Fb := mul_le_mul h1 h3 hlo2 (by linarith)
  have hG2 : Fa * Fb ≤ hi1 * hi2 := mul_le_mul h2 h4 (by linarith) (by linarith)
  have hfw : 0 < f (2 ^ w) := f_pos (by positivity)
  have hfw1 : 0 < f (2 ^ (w + 1)) := f_pos (by positivity)
  rcases le_or_gt v w with hvw | hvw
  · have := f_two_pow_mono hvw
    have : f (2 ^ v) * (Fa * Fb) ≤ f (2 ^ w) * (hi1 * hi2) :=
      mul_le_mul this hG2 (by nlinarith) hfw.le
    linarith
  · have := f_two_pow_mono (show w + 1 ≤ v by omega)
    have : f (2 ^ (w + 1)) * (lo1 * lo2) ≤ f (2 ^ v) * (Fa * Fb) :=
      mul_le_mul this hG1 (by nlinarith) (f_pos (by positivity)).le
    linarith

lemma box_above {v : ℕ} {Fa Fb hi1 hi2 : ℚ}
    (h : f (2 ^ v) * (Fa * Fb) = 2) (h2 : Fa ≤ hi1) (h4 : Fb ≤ hi2) (hFa : 0 ≤ Fa) (hFb : 0 ≤ Fb)
    (hw : SUP * (hi1 * hi2) ≤ 2) : False := by
  have hG2 : Fa * Fb ≤ hi1 * hi2 := mul_le_mul h2 h4 hFb (by linarith)
  have hs := f_two_pow_lt_SUP v
  have hf := f_pos (n := 2 ^ v) (by positivity)
  rcases (mul_nonneg hFa hFb).lt_or_eq with hG | hG
  · have : f (2 ^ v) * (Fa * Fb) < SUP * (hi1 * hi2) :=
      mul_lt_mul hs hG2 hG (by linarith)
    linarith
  · rw [← hG] at h; simp at h

lemma box_below {v : ℕ} (hv : 5 ≤ v) {Fa Fb lo1 lo2 : ℚ}
    (h : f (2 ^ v) * (Fa * Fb) = 2) (h1 : lo1 ≤ Fa) (h3 : lo2 ≤ Fb) (hlo1 : 0 ≤ lo1) (hlo2 : 0 ≤ lo2)
    (hw : 2 < f (2 ^ 5) * (lo1 * lo2)) : False := by
  have hG1 : lo1 * lo2 ≤ Fa * Fb := mul_le_mul h1 h3 hlo2 (by linarith)
  have := f_two_pow_mono hv
  have : f (2 ^ 5) * (lo1 * lo2) ≤ f (2 ^ v) * (Fa * Fb) :=
    mul_le_mul this hG1 (by nlinarith) (f_pos (by positivity)).le
  linarith


