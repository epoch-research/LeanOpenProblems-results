lemma eq_prime_pow_mul_prime_pow_of_card_eq_two {n : ℕ} (hn : n ≠ 0)
    (h : n.primeFactors.card = 2) :
    ∃ p q a b : ℕ, p.Prime ∧ q.Prime ∧ p < q ∧ 1 ≤ a ∧ 1 ≤ b ∧ n = p ^ a * q ^ b := by
  obtain ⟨p, q, hpq, hs⟩ := Finset.card_eq_two.mp h
  have hpm : p ∈ n.primeFactors := by rw [hs]; simp
  have hqm : q ∈ n.primeFactors := by rw [hs]; simp
  have hp : p.Prime := Nat.prime_of_mem_primeFactors hpm
  have hq : q.Prime := Nat.prime_of_mem_primeFactors hqm
  have hfac := Nat.factorization_prod_pow_eq_self hn
  rw [Finsupp.prod, Nat.support_factorization, hs, Finset.prod_pair hpq] at hfac
  have ha : 1 ≤ n.factorization p :=
    Nat.Prime.factorization_pos_of_dvd hp hn (Nat.dvd_of_mem_primeFactors hpm)
  have hb : 1 ≤ n.factorization q :=
    Nat.Prime.factorization_pos_of_dvd hq hn (Nat.dvd_of_mem_primeFactors hqm)
  rcases lt_or_gt_of_ne hpq with hlt | hlt
  · exact ⟨p, q, _, _, hp, hq, hlt, ha, hb, hfac.symm⟩
  · exact ⟨q, p, _, _, hq, hp, hlt, hb, ha, by rw [mul_comm]; exact hfac.symm⟩

/-- Any solution `n > 1` of the conjecture has at least four distinct prime factors. -/
theorem four_le_card_primeFactors {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    4 ≤ n.primeFactors.card := by
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  have hv : 1 ≤ v := by
    by_contra h
    have hv0 : v = 0 := by omega
    subst hv0
    have := even_of_den_eq_one hn hden
    simp at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution hv hden
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton]
  have hpos : 0 < n'.primeFactors.card :=
    Finset.card_pos.mpr (Nat.nonempty_primeFactors.mpr hn'1)
  by_contra hlt
  have hcases : n'.primeFactors.card = 1 ∨ n'.primeFactors.card = 2 := by omega
  rcases hcases with hcard | hcard
  · obtain ⟨p, a, hp, ha, rfl⟩ := (isPrimePow_nat_iff n').mp
      (isPrimePow_iff_card_primeFactors_eq_one.mpr hcard)
    have hpo : Odd p := by
      rcases hp.eq_two_or_odd' with rfl | h
      · exfalso
        have : Even (2 ^ a) := (Nat.even_pow' (by omega)).mpr even_two
        exact (Nat.not_even_iff_odd.mpr hodd) this
      · exact h
    exact two_pow_mul_prime_pow_not_solution hv hp hpo ha hden
  · obtain ⟨p, q, a, b, hp, hq, hpq, ha, hb, rfl⟩ :=
      eq_prime_pow_mul_prime_pow_of_card_eq_two hn'0 hcard
    have hpo : Odd p :=
      Odd.of_dvd_nat hodd (dvd_mul_of_dvd_left (dvd_pow_self p (by omega)) _)
    have hqo : Odd q :=
      Odd.of_dvd_nat hodd (dvd_mul_of_dvd_right (dvd_pow_self q (by omega)) _)
    exact two_pow_mul_two_prime_pow_not_solution hv hp hq hpo hqo hpq ha hb hden


/- ### The 2-adic structure of `f (2^v)`

Writing `1/(2^(j+1) - 1) = 2^(j+1)/(2^(j+1) - 1) - 1`, one gets
`f (2^v) = c N - (v + 1) + (tail of 2-adic valuation ≥ N + 2)` for `v ≥ N`, where
`c N = ∑_{j ≤ N} 2^(j+1)/(2^(j+1) - 1)`.  Hence `v₂ (f (2^v)) ≥ t` forces a congruence
on `v` modulo `2^t`. -/

/-- Truncation of the 2-adic constant `∑_{j ≥ 1} 2^j/(2^j - 1)`. -/
noncomputable def c (N : ℕ) : ℚ := ∑ j ∈ range (N + 1), (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1)

lemma two_pow_sub_one_pos' (j : ℕ) : (0 : ℚ) < (2 : ℚ) ^ (j + 1) - 1 := by
  have : (2 : ℚ) ≤ 2 ^ (j + 1) := by
    calc (2 : ℚ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (j + 1) := pow_le_pow_right₀ (by norm_num) (by omega)
  linarith

lemma f_two_pow_eq_c_sub {N v : ℕ} (hNv : N ≤ v) :
    f (2 ^ v) = c N - (v + 1) +
      ∑ j ∈ Finset.Ico (N + 1) (v + 1), (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1) := by
  rw [f_two_pow_eq_sum]
  have h1 : ∀ j : ℕ, (1 : ℚ) / ((2 : ℚ) ^ (j + 1) - 1)
      = (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1) - 1 := by
    intro j
    have := two_pow_sub_one_pos' j
    field_simp
    ring
  simp_rw [h1]
  rw [Finset.sum_sub_distrib]
  simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
  unfold c
  rw [← Finset.sum_range_add_sum_Ico _ (show N + 1 ≤ v + 1 by omega)]
  push_cast
  ring

lemma padicValRat_two_pow_div (j : ℕ) :
    padicValRat 2 ((2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1)) = j + 1 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hden : (2 : ℚ) ^ (j + 1) - 1 = ((2 ^ (j + 1) - 1 : ℕ) : ℚ) := by
    have : 1 ≤ 2 ^ (j + 1) := Nat.one_le_two_pow
    push_cast [this]
    ring
  have hodd : ¬ 2 ∣ 2 ^ (j + 1) - 1 := by
    have h1 : 1 ≤ 2 ^ (j + 1) := Nat.one_le_two_pow
    have h2 : 2 ∣ 2 ^ (j + 1) := dvd_pow_self 2 (by omega)
    intro h
    have := (Nat.dvd_sub h2 h)
    rw [Nat.sub_sub_self h1] at this
    omega
  have hne : ((2 ^ (j + 1) - 1 : ℕ) : ℚ) ≠ 0 := by
    have := two_pow_sub_one_pos' j
    rw [hden] at this; exact this.ne'
  rw [hden, show (2 : ℚ) ^ (j + 1) = ((2 ^ (j + 1) : ℕ) : ℚ) by push_cast; ring,
    padicValRat.div (by positivity) hne, ← padicValRat_of_nat, ← padicValRat_of_nat,
    padicValNat.prime_pow, padicValNat.eq_zero_of_not_dvd hodd]
  simp

lemma padicValRat_tail_ge {N v : ℕ} (hNv : N < v) :
    ((N : ℤ) + 2) ≤ padicValRat 2
      (∑ j ∈ Finset.Ico (N + 1) (v + 1), (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  apply le_padicValRat_sum
  · intro j _
    have := two_pow_sub_one_pos' j
    positivity
  · intro j hj
    rw [padicValRat_two_pow_div]
    have := (Finset.mem_Ico.mp hj).1
    omega
  · exact ⟨N + 1, Finset.mem_Ico.mpr ⟨le_rfl, by omega⟩⟩

/-- **2-adic congruence.**  If `c N = A / B` (with `B ≠ 0`), `N ≤ v`, `t ≤ N + 2` and
`t ≤ v₂ (f (2^v))`, then `2^t ∣ A - (v + 1) * B`. -/
theorem two_pow_dvd_of_padicValRat_f_two_pow {N v t : ℕ} {A B : ℤ} (hB : B ≠ 0)
    (hc : c N = (A : ℚ) / B) (hNv : N ≤ v) (ht : t ≤ N + 2)
    (hval : (t : ℤ) ≤ padicValRat 2 (f (2 ^ v))) :
    (2 : ℤ) ^ t ∣ A - (v + 1) * B := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set T := ∑ j ∈ Finset.Ico (N + 1) (v + 1), (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1) with hT
  have hf := f_two_pow_eq_c_sub hNv
  rw [← hT] at hf
  -- x := c N - (v+1) has valuation ≥ t
  have hx : (t : ℤ) ≤ padicValRat 2 (c N - (v + 1)) ∨ c N - (v + 1) = 0 := by
    by_cases hx0 : c N - (v + 1) = 0
    · exact Or.inr hx0
    left
    rcases Nat.lt_or_ge N v with hlt | hge
    · have hTv := padicValRat_tail_ge hlt
      rw [← hT] at hTv
      have hTpos : 0 < T := by
        rw [hT]
        apply Finset.sum_pos
        · intro j _; have := two_pow_sub_one_pos' j; positivity
        · exact ⟨N + 1, Finset.mem_Ico.mpr ⟨le_rfl, by omega⟩⟩
      have hfpos : 0 < f (2 ^ v) := f_pos (by positivity)
      have heq : c N - (v + 1) = f (2 ^ v) + (-T) := by linarith
      rw [heq]
      refine le_trans ?_ (padicValRat.min_le_padicValRat_add (p := 2) (by rw [← heq]; exact hx0))
      rw [padicValRat.neg]
      exact le_min hval (by omega)
    · have hvN : v = N := by omega
      subst hvN
      have hT0 : T = 0 := by rw [hT]; simp
      rw [hT0, add_zero] at hf
      rw [← hf]; exact hval
  -- multiply by B
  have hz : ((A - (v + 1) * B : ℤ) : ℚ) = (c N - (v + 1)) * B := by
    rw [hc]; push_cast; field_simp
  by_cases hz0 : (A - (v + 1) * B : ℤ) = 0
  · rw [hz0]; exact dvd_zero _
  have hx0 : c N - (v + 1) ≠ 0 := by
    intro h
    apply hz0
    have : ((A - (v + 1) * B : ℤ) : ℚ) = 0 := by rw [hz, h]; ring
    exact_mod_cast this
  have hx' : (t : ℤ) ≤ padicValRat 2 (c N - (v + 1)) := by
    rcases hx with hx | hx
    · exact hx
    · exact absurd hx hx0
  have hBq : (B : ℚ) ≠ 0 := by exact_mod_cast hB
  have hzval : padicValRat 2 ((A - (v + 1) * B : ℤ) : ℚ)
      = padicValRat 2 (c N - (v + 1)) + padicValRat 2 (B : ℚ) := by
    rw [hz, padicValRat.mul hx0 hBq]
  have hBnn : 0 ≤ padicValRat 2 (B : ℚ) := by
    rw [padicValRat.of_int]; exact Int.natCast_nonneg _
  rw [padicValRat.of_int] at hzval
  have hfin : (t : ℤ) ≤ (padicValInt 2 (A - (v + 1) * B) : ℤ) := by linarith
  have hfin' : t ≤ padicValInt 2 (A - (v + 1) * B) := by exact_mod_cast hfin
  have := (padicValInt_dvd_iff (p := 2) t (A - (v + 1) * B)).mpr (Or.inr hfin')
  exact_mod_cast this


