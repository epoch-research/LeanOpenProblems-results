/-- Upper bound `F p a < B` from `p ≥ P` via `F p a < p/(p-1) ≤ P/(P-1)`. -/
lemma F_lt_of_le {p a P : ℕ} (hp : p.Prime) (hP : 2 ≤ P) (hPp : P ≤ p) :
    F p a < (P : ℚ) / ((P : ℚ) - 1) := by
  have h1 := F_lt (a := a) hp
  have hPq : (2 : ℚ) ≤ P := by exact_mod_cast hP
  have hPpq : (P : ℚ) ≤ p := by exact_mod_cast hPp
  have h2 : (p : ℚ) / (p - 1) ≤ (P : ℚ) / ((P : ℚ) - 1) := by
    rw [div_le_div_iff₀ (by linarith) (by linarith)]
    nlinarith
  linarith

