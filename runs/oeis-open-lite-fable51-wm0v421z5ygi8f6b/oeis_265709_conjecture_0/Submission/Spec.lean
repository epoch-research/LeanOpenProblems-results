import FormalConjectures.Util.ProblemImports

open Nat Finset ArithmeticFunction

/--
A265709: $a(n) = \mathrm{numerator}\left(\sum_{d|n} \frac{1}{\sigma(d)}\right)$.
$\sigma(d)$ is the sum of the divisors of $d$, $\sigma(d) = \sum_{k|d} k$.
-/
def A265709 (n : ℕ) : ℕ :=
  -- The sum \sum_{d|n} 1/\sigma(d), calculated in the rational numbers ℚ.
  let sum_of_reciprocals : ℚ :=
    n.divisors.sum fun d => (1 : ℚ) / (↑((sigma 1) d) : ℚ)

  -- The numerator of the minimal representation of the rational number, converted from ℤ to ℕ.
  sum_of_reciprocals.num.toNat

open scoped ArithmeticFunction.sigma

/-
## Verified partial results

The following lemmas are fully proven (no `sorry`).  They establish structural
constraints on any hypothetical solution `n > 1` of the conjecture:
* `f n` (the sum in the conjecture) is multiplicative, and `f (p ^ a) = F p a`;
* exact 2-adic valuation of `F p a` for odd primes `p`
  (`padicValRat 2 (F p a) = -(v₂(p+1) + log₂(a+1) - 1)`);
* every solution `n > 1` must be even (`even_of_den_eq_one`);
* no power of two is a solution (`two_pow_not_solution`);
* if `n = 2^v * n'` with `n'` odd is a solution then `v` is odd (`odd_v_of_solution`) and
  the number of odd prime factors of `n` is bounded by `padicValRat 2 (f (2^v))`
  (`card_primeFactors_le`);
* no number of the form `2^v * p^a` is a solution (`two_pow_mul_prime_pow_not_solution`);
* no number of the form `2^v * p^a * q^b` is a solution
  (`two_pow_mul_two_prime_pow_not_solution`, via a finite interval analysis);
* hence every solution has at least four distinct prime factors
  (`four_le_card_primeFactors`);
* no number of the form `2^v * p^a * q^b * r^c` is a solution
  (`two_pow_mul_three_prime_pow_not_solution`, via the 2-adic analysis and a finite interval
  analysis with about a thousand boxes), hence every solution has at least five distinct prime
  factors (`five_le_card_primeFactors`);
* the 2-adic structure `f (2^v) ≡ c - (v+1)` (`two_pow_dvd_of_padicValRat_f_two_pow`), whence
  every solution satisfies `v₂(n) ≡ 5 (mod 16)` (`padicValNat_two_mod_sixteen`), and more
  generally `ω(n) ≥ t + 1` forces `v₂(n)` into a single residue class mod `2^t`
  (`v_mod_of_card_four`, …, `v_mod_of_card_twelve`);
* `v₂(n) = 5` is impossible, so every solution has `v₂(n) ≥ 21`
  (`padicValNat_two_ge_twentyone`), and consequently `n ≥ 2^21 · 3 · 5 · 7 · 11 > 2.4 · 10^9`
  (`solution_ge`);
* the general form of this congruence, valid for every `t`
  (`two_pow_dvd_S_of_solution`): if `ω(n) ≥ t + 1` and `t ≤ v₂(n) + 2` then
  `v₂(n) + 1 + ∑_{M < t} τ(M) 2^M ≡ 0 (mod 2^t)`;
* the case `v₂(f(2^{v₂(n)})) ≤ 5` is impossible (`six_le_padicValRat_of_solution`): a solution
  would then have exactly four odd prime factors, all `≡ 1 (mod 4)` with exponents `≤ 2`, value
  `f n = 2` and `v₂(n) ≡ 21 (mod 32)`, and a finite enumeration (`case4_main`, 227 leaves)
  excludes this; hence every solution has `v₂(n) ≡ 53 (mod 64)`
  (`padicValNat_two_mod_sixtyfour`), `v₂(n) ≥ 53` and `n ≥ 2^53 · 3 · 5 · 7 · 11 > 10^19`
  (`solution_ge_fiftythree`);
* an `ℓ`-adic constraint for odd primes `ℓ` (`exists_padicValRat_F_pos_of_orderOf`): if
  `(v₂(n)+1)/2 < ord_ℓ(2) ≤ v₂(n)+1` then `ℓ` divides the numerator of `∑_{b ≤ v_p(n)} 1/σ(p^b)`
  for some odd prime factor `p` of `n`.
-/

namespace A265709Aux

/-- σ(p^b) for b even and p odd is odd. -/
lemma odd_sigma_prime_pow_even {p b : ℕ} (hp : p.Prime) (hpo : Odd p) (hb : Even b) :
    Odd (σ 1 (p ^ b)) := by
  rw [sigma_one_apply_prime_pow hp]
  -- sum of b+1 odd numbers, b+1 odd
  have : ∀ k, Odd (p ^ k) := fun k => hpo.pow
  rw [Nat.odd_iff]
  rw [Finset.sum_nat_mod]
  have h2 : ∀ k ∈ range (b+1), p ^ k % 2 = 1 := fun k _ => Nat.odd_iff.mp (this k)
  rw [Finset.sum_congr rfl h2]
  simp
  obtain ⟨c, rfl⟩ := hb
  omega

/-- (p-1) σ(p^b) = p^(b+1) - 1 -/
lemma sigma_prime_pow_mul {p b : ℕ} (hp : p.Prime) :
    (p - 1) * σ 1 (p ^ b) = p ^ (b + 1) - 1 := by
  rw [sigma_one_apply_prime_pow hp]
  have := Nat.geomSum_eq hp.two_le (b+1)
  rw [this]
  have h1 : (p - 1) ∣ p ^ (b+1) - 1 := by
    simpa using Nat.sub_dvd_pow_sub_pow p 1 (b+1)
  rw [Nat.mul_div_cancel' h1]

/-- 2-adic valuation of σ(p^b) for odd b, odd prime p. -/
lemma v2_sigma_prime_pow_odd {p b : ℕ} (hp : p.Prime) (hpo : Odd p) (hb : Odd b) :
    padicValNat 2 (σ 1 (p ^ b)) + 1 = padicValNat 2 (p + 1) + padicValNat 2 (b + 1) := by
  have h1p : 1 < p := hp.one_lt
  have hx : ¬ 2 ∣ p := by rw [Nat.two_dvd_ne_zero]; exact Nat.odd_iff.mp hpo
  have heven : Even (b+1) := hb.add_one
  have hlte := padicValNat.pow_two_sub_one h1p hx (Nat.succ_ne_zero b) heven
  simp only [Nat.succ_eq_add_one] at hlte
  have hmul := sigma_prime_pow_mul (b := b) hp
  have hp1 : p - 1 ≠ 0 := by omega
  have hs : σ 1 (p ^ b) ≠ 0 := by
    have : 0 < σ 1 (p^b) := sigma_pos_iff.mpr (by positivity)
    omega
  have := padicValNat.mul (p := 2) hp1 hs
  rw [hmul] at this
  omega

end A265709Aux

namespace A265709Aux
variable {p : ℕ} [hp : Fact p.Prime]

/-- Lower bound for the valuation of a sum of positive rationals. -/
lemma le_padicValRat_sum {ι : Type*} [DecidableEq ι] (s : Finset ι) (t : ι → ℚ) (m : ℤ)
    (hpos : ∀ i ∈ s, 0 < t i) (hle : ∀ i ∈ s, m ≤ padicValRat p (t i)) (hne : s.Nonempty) :
    m ≤ padicValRat p (∑ i ∈ s, t i) := by
  induction s using Finset.induction_on with
  | empty => exact absurd hne (by simp)
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha]
    by_cases hs : s.Nonempty
    · have h1 : 0 < ∑ i ∈ s, t i := Finset.sum_pos (fun i hi => hpos i (Finset.mem_insert_of_mem hi)) hs
      have h2 : t a + ∑ i ∈ s, t i ≠ 0 := by
        have := hpos a (Finset.mem_insert_self a s); linarith
      refine le_trans ?_ (padicValRat.min_le_padicValRat_add (p := p) h2)
      refine le_min (hle a (Finset.mem_insert_self a s)) ?_
      exact ih (fun i hi => hpos i (Finset.mem_insert_of_mem hi))
        (fun i hi => hle i (Finset.mem_insert_of_mem hi)) hs
    · rw [Finset.not_nonempty_iff_eq_empty] at hs
      subst hs
      simpa using hle a (Finset.mem_insert_self a ∅)

/-- If one term has strictly smaller valuation than all others, the sum has that valuation. -/
lemma padicValRat_sum_eq_of_unique_min {ι : Type*} [DecidableEq ι] (s : Finset ι) (t : ι → ℚ)
    (i₀ : ι) (hi₀ : i₀ ∈ s) (hpos : ∀ i ∈ s, 0 < t i)
    (hlt : ∀ i ∈ s, i ≠ i₀ → padicValRat p (t i₀) < padicValRat p (t i)) :
    padicValRat p (∑ i ∈ s, t i) = padicValRat p (t i₀) := by
  rw [← Finset.add_sum_erase s t hi₀]
  by_cases hs : (s.erase i₀).Nonempty
  · have hrest : 0 < ∑ i ∈ s.erase i₀, t i :=
      Finset.sum_pos (fun i hi => hpos i (Finset.mem_of_mem_erase hi)) hs
    have hv : padicValRat p (t i₀) < padicValRat p (∑ i ∈ s.erase i₀, t i) := by
      -- minimum over the rest is > v(t i₀); use m = v(t i₀) + 1
      have := le_padicValRat_sum (p := p) (s.erase i₀) t (padicValRat p (t i₀) + 1)
        (fun i hi => hpos i (Finset.mem_of_mem_erase hi))
        (fun i hi => by
          have := hlt i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi); omega) hs
      omega
    have h0 : t i₀ ≠ 0 := (hpos i₀ hi₀).ne'
    have hsum : t i₀ + ∑ i ∈ s.erase i₀, t i ≠ 0 := by have := hpos i₀ hi₀; linarith
    rw [padicValRat.add_eq_min hsum h0 hrest.ne' hv.ne, min_eq_left hv.le]
  · rw [Finset.not_nonempty_iff_eq_empty] at hs
    rw [hs]; simp

end A265709Aux

namespace A265709Aux

/-- The local factor `∑_{b ≤ a} 1/σ(p^b)`. -/
noncomputable def F (p a : ℕ) : ℚ := ∑ b ∈ range (a + 1), (1 : ℚ) / ((σ 1 (p ^ b) : ℕ) : ℚ)

lemma sigma_prime_pow_pos {p b : ℕ} (hp : p.Prime) : 0 < σ 1 (p ^ b) :=
  sigma_pos_iff.mpr (pow_pos hp.pos b)

lemma padicValRat_term {p b : ℕ} (hp : p.Prime) :
    padicValRat 2 ((1 : ℚ) / ((σ 1 (p ^ b) : ℕ) : ℚ)) = -(padicValNat 2 (σ 1 (p ^ b)) : ℤ) := by
  rw [one_div, padicValRat.inv, padicValRat_of_nat]

/-- key: for b ≤ a odd with b ≠ 2^κ - 1, v₂(b+1) < κ where κ = log₂(a+1). -/
lemma v2_lt_log {a b : ℕ} (hb : b ≤ a) (hne : b + 1 ≠ 2 ^ Nat.log 2 (a + 1)) :
    padicValNat 2 (b + 1) < Nat.log 2 (a + 1) := by
  by_contra h
  push_neg at h
  have hdvd : 2 ^ Nat.log 2 (a + 1) ∣ b + 1 :=
    (pow_dvd_pow 2 h).trans pow_padicValNat_dvd
  obtain ⟨c, hc⟩ := hdvd
  have hlt : b + 1 < 2 ^ (Nat.log 2 (a + 1) + 1) :=
    lt_of_le_of_lt (by omega) (Nat.lt_pow_succ_log_self (by norm_num) (a + 1))
  rw [pow_succ] at hlt
  have hc1 : c ≠ 1 := by rintro rfl; rw [mul_one] at hc; exact hne hc
  have hc0 : c ≠ 0 := by rintro rfl; omega
  have : 2 ≤ c := by omega
  have := Nat.mul_le_mul_left (2 ^ Nat.log 2 (a + 1)) this
  omega

/-- The 2-adic valuation of the local factor at an odd prime is exactly
`-(v₂(p+1) + ⌊log₂(a+1)⌋ - 1)`, in particular negative. -/
theorem padicValRat_F {p a : ℕ} (hp : p.Prime) (hpo : Odd p) (ha : 1 ≤ a) :
    padicValRat 2 (F p a) =
      -((padicValNat 2 (p + 1) : ℤ) + (Nat.log 2 (a + 1) : ℤ) - 1) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set κ := Nat.log 2 (a + 1) with hκ
  have hκ1 : 1 ≤ κ := by
    rw [hκ]; exact Nat.le_log_of_pow_le (by norm_num) (by omega)
  have hpow : 2 ^ κ ≤ a + 1 := Nat.pow_log_le_self 2 (by omega)
  have hpow1 : 1 ≤ 2 ^ κ := Nat.one_le_two_pow
  set b₀ := 2 ^ κ - 1 with hb₀
  have hb₀mem : b₀ ∈ range (a + 1) := by rw [Finset.mem_range]; omega
  have hb₀odd : Odd b₀ := by
    rw [hb₀]
    have : 2 ^ κ = 2 * 2 ^ (κ - 1) := by
      rw [← pow_succ']; congr 1; omega
    rw [this]
    exact ⟨2 ^ (κ - 1) - 1, by have := Nat.one_le_two_pow (n := κ - 1); omega⟩
  have hb₀succ : b₀ + 1 = 2 ^ κ := by omega
  have hv2p : 1 ≤ padicValNat 2 (p + 1) := by
    apply one_le_padicValNat_of_dvd (by omega)
    obtain ⟨k, hk⟩ := hpo; exact ⟨k + 1, by omega⟩
  -- valuation of the distinguished term
  have hvb₀ : padicValNat 2 (σ 1 (p ^ b₀)) + 1 = padicValNat 2 (p + 1) + κ := by
    have := v2_sigma_prime_pow_odd hp hpo hb₀odd
    rw [hb₀succ, padicValNat.prime_pow] at this
    exact this
  unfold F
  rw [padicValRat_sum_eq_of_unique_min (p := 2) (range (a + 1)) _ b₀ hb₀mem]
  · rw [padicValRat_term hp]; omega
  · intro i _
    have := sigma_prime_pow_pos (b := i) hp
    positivity
  · intro b hb hne
    rw [padicValRat_term hp, padicValRat_term hp]
    rw [Finset.mem_range] at hb
    rcases Nat.even_or_odd b with hbe | hbo
    · have : padicValNat 2 (σ 1 (p ^ b)) = 0 := by
        apply padicValNat.eq_zero_of_not_dvd
        rw [Nat.two_dvd_ne_zero]
        exact Nat.odd_iff.mp (odd_sigma_prime_pow_even hp hpo hbe)
      rw [this]; omega
    · have h1 := v2_sigma_prime_pow_odd hp hpo hbo
      have h2 : padicValNat 2 (b + 1) < κ := by
        apply v2_lt_log (by omega)
        rw [← hb₀succ]; omega
      omega

theorem padicValRat_F_neg {p a : ℕ} (hp : p.Prime) (hpo : Odd p) (ha : 1 ≤ a) :
    padicValRat 2 (F p a) < 0 := by
  rw [padicValRat_F hp hpo ha]
  have hκ1 : 1 ≤ Nat.log 2 (a + 1) := Nat.le_log_of_pow_le (by norm_num) (by omega)
  have hv2p : 1 ≤ padicValNat 2 (p + 1) := by
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    apply one_le_padicValNat_of_dvd (by omega)
    obtain ⟨k, hk⟩ := hpo; exact ⟨k + 1, by omega⟩
  omega

end A265709Aux

namespace A265709Aux

/-- The function in the conjecture. -/
noncomputable def f (n : ℕ) : ℚ := n.divisors.sum fun d => (1 : ℚ) / (↑((σ 1) d) : ℚ)

/-- `1/σ` as an arithmetic function. -/
noncomputable def h : ArithmeticFunction ℚ :=
  ⟨fun d => (1 : ℚ) / ((σ 1 d : ℕ) : ℚ), by simp⟩

lemma h_apply (d : ℕ) : h d = (1 : ℚ) / ((σ 1 d : ℕ) : ℚ) := rfl

lemma h_isMultiplicative : IsMultiplicative h := by
  refine ⟨by simp [h_apply], ?_⟩
  intro m n hmn
  simp only [h_apply, isMultiplicative_sigma.map_mul_of_coprime hmn, Nat.cast_mul, one_div, mul_inv]

lemma f_eq (n : ℕ) : f n = ((↑(zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℚ) * h) n := by
  rw [coe_zeta_mul_apply]; rfl

lemma f_isMultiplicative : IsMultiplicative ((↑(zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℚ) * h) :=
  isMultiplicative_zeta.natCast.mul h_isMultiplicative

lemma f_prime_pow {p a : ℕ} (hp : p.Prime) : f (p ^ a) = F p a := by
  unfold f F
  rw [Nat.divisors_prime_pow hp, Finset.sum_map]
  rfl

lemma f_pos {n : ℕ} (hn : n ≠ 0) : 0 < f n := by
  unfold f
  apply Finset.sum_pos
  · intro d hd
    have : 0 < σ 1 d := sigma_pos_iff.mpr (Nat.pos_of_mem_divisors hd)
    positivity
  · exact ⟨1, Nat.one_mem_divisors.mpr hn⟩

/-- Factorization of `f` over the prime powers dividing `n`. -/
lemma f_eq_prod {n : ℕ} (hn : n ≠ 0) :
    f n = ∏ p ∈ n.primeFactors, F p (n.factorization p) := by
  rw [f_eq, f_isMultiplicative.multiplicative_factorization _ hn, Finsupp.prod,
    Nat.support_factorization]
  refine Finset.prod_congr rfl fun p hp => ?_
  rw [← f_eq, f_prime_pow (Nat.prime_of_mem_primeFactors hp)]

lemma padicValRat_prod {ι : Type*} (s : Finset ι) (g : ι → ℚ) (q : ℕ) [Fact q.Prime]
    (hg : ∀ i ∈ s, g i ≠ 0) :
    padicValRat q (∏ i ∈ s, g i) = ∑ i ∈ s, padicValRat q (g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha,
      padicValRat.mul (hg a (Finset.mem_insert_self a s))
        (Finset.prod_ne_zero_iff.mpr fun i hi => hg i (Finset.mem_insert_of_mem hi)),
      ih fun i hi => hg i (Finset.mem_insert_of_mem hi)]

/-- For odd `n > 1`, the 2-adic valuation of `f n` is negative. -/
theorem padicValRat_f_odd_neg {n : ℕ} (hn : 1 < n) (hodd : Odd n) : padicValRat 2 (f n) < 0 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hn0 : n ≠ 0 := by omega
  rw [f_eq_prod hn0, padicValRat_prod _ _ 2]
  · apply Finset.sum_neg
    · intro p hp
      have hpp := Nat.prime_of_mem_primeFactors hp
      have hpo : Odd p := by
        rcases hpp.eq_two_or_odd' with rfl | h
        · exfalso
          have : 2 ∣ n := Nat.dvd_of_mem_primeFactors hp
          exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr this)
        · exact h
      have ha : 1 ≤ n.factorization p := by
        have := (Nat.mem_primeFactors.mp hp)
        exact Nat.Prime.factorization_pos_of_dvd hpp hn0 this.2.1
      exact padicValRat_F_neg hpp hpo ha
    · exact Nat.nonempty_primeFactors.mpr hn
  · intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    rw [← f_prime_pow hpp]
    exact (f_pos (pow_ne_zero _ hpp.ne_zero)).ne'

/-- Any solution of the conjecture must be even. -/
theorem even_of_den_eq_one {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) : Even n := by
  by_contra hodd
  rw [Nat.not_even_iff_odd] at hodd
  have hneg := padicValRat_f_odd_neg hn hodd
  have : f n = ((f n).num : ℚ) := (Rat.coe_int_num_of_den_eq_one hden).symm
  rw [this, padicValRat.of_int] at hneg
  have : 0 ≤ padicValInt 2 (f n).num := by unfold padicValInt; positivity
  omega

end A265709Aux

namespace A265709Aux

lemma self_le_sigma_one {d : ℕ} (hd : d ≠ 0) : d ≤ σ 1 d := by
  rw [sigma_one_apply]
  exact Finset.single_le_sum (fun i _ => Nat.zero_le i) (Nat.mem_divisors_self d hd)

/-- `1 < f (2^a) < 2` for `a ≥ 1`. -/
lemma f_two_pow_bounds {a : ℕ} (ha : 1 ≤ a) : 1 < f (2 ^ a) ∧ f (2 ^ a) < 2 := by
  rw [f_prime_pow Nat.prime_two]
  unfold F
  constructor
  · -- the term b = 0 equals 1; the term b = 1 is positive
    rw [Finset.sum_range_succ']
    have h0 : (1 : ℚ) / ((σ 1 (2 ^ 0) : ℕ) : ℚ) = 1 := by simp
    rw [h0]
    have : 0 < ∑ b ∈ range a, (1 : ℚ) / ((σ 1 (2 ^ (b + 1)) : ℕ) : ℚ) := by
      apply Finset.sum_pos
      · intro b _
        have := sigma_prime_pow_pos (b := b + 1) Nat.prime_two
        positivity
      · exact ⟨0, Finset.mem_range.mpr (by omega)⟩
    linarith
  · calc ∑ b ∈ range (a + 1), (1 : ℚ) / ((σ 1 (2 ^ b) : ℕ) : ℚ)
        ≤ ∑ b ∈ range (a + 1), ((1 : ℚ) / 2) ^ b := by
          apply Finset.sum_le_sum
          intro b _
          have h1 : ((2 : ℚ) ^ b) ≤ ((σ 1 (2 ^ b) : ℕ) : ℚ) := by
            have := self_le_sigma_one (pow_ne_zero b two_ne_zero)
            exact_mod_cast this
          have h2 : (0 : ℚ) < (2 : ℚ) ^ b := by positivity
          rw [one_div_pow, one_div, one_div]
          exact inv_anti₀ h2 h1
      _ = ((1 / 2 : ℚ) ^ (a + 1) - 1) / (1 / 2 - 1) := geom_sum_eq (by norm_num) _
      _ = 2 - 2 * (1 / 2 : ℚ) ^ (a + 1) := by ring
      _ < 2 := by
          have : (0 : ℚ) < (1 / 2 : ℚ) ^ (a + 1) := by positivity
          linarith

/-- Powers of two are never solutions. -/
theorem two_pow_not_solution {a : ℕ} (ha : 1 ≤ a) : (f (2 ^ a)).den ≠ 1 := by
  intro hden
  obtain ⟨h1, h2⟩ := f_two_pow_bounds ha
  have : f (2 ^ a) = ((f (2 ^ a)).num : ℚ) := (Rat.coe_int_num_of_den_eq_one hden).symm
  rw [this] at h1 h2
  have h1' : (1 : ℤ) < (f (2 ^ a)).num := by exact_mod_cast h1
  have h2' : (f (2 ^ a)).num < 2 := by exact_mod_cast h2
  omega

/-- The number of odd prime factors of a solution `2^v * n'` is at most `v₂(f(2^v))`. -/
theorem card_primeFactors_le {v n' : ℕ} (hodd : Odd n') (hn' : 1 < n')
    (hden : (f (2 ^ v * n')).den = 1) :
    (n'.primeFactors.card : ℤ) ≤ padicValRat 2 (f (2 ^ v)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hn0 : n' ≠ 0 := by omega
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hmul : f (2 ^ v * n') = f (2 ^ v) * f n' := by
    rw [f_eq, f_eq, f_eq, f_isMultiplicative.map_mul_of_coprime hcop]
  have hpos1 := f_pos (n := 2 ^ v) (by positivity)
  have hpos2 := f_pos hn0
  have hval : padicValRat 2 (f (2 ^ v * n')) = padicValRat 2 (f (2 ^ v)) + padicValRat 2 (f n') := by
    rw [hmul, padicValRat.mul hpos1.ne' hpos2.ne']
  have hnonneg : 0 ≤ padicValRat 2 (f (2 ^ v * n')) := by
    have : f (2 ^ v * n') = ((f (2 ^ v * n')).num : ℚ) := (Rat.coe_int_num_of_den_eq_one hden).symm
    rw [this, padicValRat.of_int]
    unfold padicValInt; positivity
  -- each odd prime contributes at most -1
  have hsum : padicValRat 2 (f n') ≤ -(n'.primeFactors.card : ℤ) := by
    rw [f_eq_prod hn0, padicValRat_prod _ _ 2]
    · have : ∀ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p)) ≤ -1 := by
        intro p hp
        have hpp := Nat.prime_of_mem_primeFactors hp
        have hpo : Odd p := by
          rcases hpp.eq_two_or_odd' with rfl | h
          · exfalso
            have : 2 ∣ n' := Nat.dvd_of_mem_primeFactors hp
            exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr this)
          · exact h
        have ha : 1 ≤ n'.factorization p :=
          Nat.Prime.factorization_pos_of_dvd hpp hn0 (Nat.mem_primeFactors.mp hp).2.1
        have := padicValRat_F_neg hpp hpo ha
        omega
      calc ∑ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p))
          ≤ ∑ p ∈ n'.primeFactors, (-1 : ℤ) := Finset.sum_le_sum this
        _ = -(n'.primeFactors.card : ℤ) := by simp
    · intro p hp
      have hpp := Nat.prime_of_mem_primeFactors hp
      rw [← f_prime_pow hpp]
      exact (f_pos (pow_ne_zero _ hpp.ne_zero)).ne'
  omega

end A265709Aux

