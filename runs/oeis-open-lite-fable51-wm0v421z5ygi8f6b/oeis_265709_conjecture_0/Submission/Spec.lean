/-- No number of the form `2^v * p^a` (with `p` an odd prime, `v, a ≥ 1`) is a solution. -/
theorem two_pow_mul_prime_pow_not_solution {v p a : ℕ} (hv : 1 ≤ v) (hp : p.Prime) (hpo : Odd p)
    (ha : 1 ≤ a) : (f (2 ^ v * p ^ a)).den ≠ 1 := by
  intro hden
  have hodd : Odd (p ^ a) := hpo.pow
  have hn' : 1 < p ^ a := Nat.one_lt_pow (by omega) hp.one_lt
  have hvodd := odd_v_of_solution hodd hn' hden
  have hcop : Nat.Coprime (2 ^ v) (p ^ a) := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hmul : f (2 ^ v * p ^ a) = f (2 ^ v) * F p a := by
    rw [f_eq, f_eq, f_isMultiplicative.map_mul_of_coprime hcop, ← f_eq, ← f_eq, f_prime_pow hp]
  obtain ⟨hf1, hf2⟩ := f_two_pow_bounds hv
  have hF1 := F_gt_one hp ha
  have hF2 := F_lt (a := a) hp
  have hp3 : (3 : ℚ) ≤ p := by
    have : 3 ≤ p := by
      obtain ⟨t, ht⟩ := hpo
      have := hp.two_le
      omega
    exact_mod_cast this
  have hF32 : F p a < 3 / 2 := by
    have : (p : ℚ) / (p - 1) ≤ 3 / 2 := by
      rw [div_le_iff₀ (by linarith)]; linarith
    linarith
  -- the integer value is 2
  have hK : f (2 ^ v * p ^ a) = ((f (2 ^ v * p ^ a)).num : ℚ) :=
    (Rat.coe_int_num_of_den_eq_one hden).symm
  have hlo : (1 : ℚ) < f (2 ^ v * p ^ a) := by
    rw [hmul]; nlinarith
  have hhi : f (2 ^ v * p ^ a) < 3 := by
    rw [hmul]; nlinarith
  rw [hK] at hlo hhi
  have hlo' : (1 : ℤ) < (f (2 ^ v * p ^ a)).num := by exact_mod_cast hlo
  have hhi' : (f (2 ^ v * p ^ a)).num < 3 := by exact_mod_cast hhi
  have hnum : (f (2 ^ v * p ^ a)).num = 2 := by omega
  have h2 : f (2 ^ v) * F p a = 2 := by
    rw [← hmul, hK, hnum]; norm_num
  have hlt := f_two_pow_lt v
  -- F p a > 200/161
  have hFbig : 200 / 161 < F p a := by
    by_contra hcon
    push_neg at hcon
    nlinarith
  rcases lt_or_ge 5 p with h5 | h5
  · -- p ≥ 7
    have h7 : (7 : ℚ) ≤ p := by
      have : 7 ≤ p := by
        obtain ⟨t, rfl⟩ := hpo
        omega
      exact_mod_cast this
    have : (p : ℚ) / (p - 1) ≤ 7 / 6 := by
      rw [div_le_iff₀ (by linarith)]; linarith
    linarith
  · have hp5 : p = 3 ∨ p = 5 := by
      have := hp.two_le
      obtain ⟨t, rfl⟩ := hpo
      omega
    rcases hp5 with rfl | rfl
    · -- p = 3
      rcases Nat.lt_or_ge a 2 with ha1 | ha2
      · have ha1 : a = 1 := by omega
        subst ha1
        rw [F_three_one] at h2
        have hv85 : f (2 ^ v) = 8 / 5 := by linarith
        rcases le_or_gt v 6 with hv6 | hv6
        · have := f_two_pow_mono hv6
          rw [f_two_pow_six, hv85] at this
          norm_num at this
        · have := f_two_pow_mono (show 7 ≤ v by omega)
          rw [f_two_pow_seven, hv85] at this
          norm_num at this
      · have hF := F_mono Nat.prime_three ha2
        rw [F_three_two] at hF
        -- f (2^v) = 2 / F 3 a ≤ 104/69 < f (2^3)
        have hsmall : f (2 ^ v) ≤ 104 / 69 := by
          by_contra hcon
          push_neg at hcon
          nlinarith
        have hv3 : v < 3 := by
          by_contra hcon
          push_neg at hcon
          have := f_two_pow_mono hcon
          rw [f_two_pow_three] at this
          linarith
        have hv1 : v = 1 := by
          obtain ⟨t, rfl⟩ := hvodd
          omega
        subst hv1
        rw [f_two_pow_one] at h2
        have hEq : F 3 a = 3 / 2 := by linarith
        rw [hEq] at hF32
        norm_num at hF32
    · -- p = 5
      have := F_le_fine (a := a) (by norm_num : Nat.Prime 5) ha
      norm_num at this
      linarith

/-- Any solution `n > 1` of the conjecture has at least three distinct prime factors. -/
theorem three_le_card_primeFactors {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    3 ≤ n.primeFactors.card := by
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  have hv : 1 ≤ v := by
    by_contra h
    have hv0 : v = 0 := by omega
    subst hv0
    have := even_of_den_eq_one hn hden
    simp at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution hv hden
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton]
  have hpos : 0 < n'.primeFactors.card :=
    Finset.card_pos.mpr (Nat.nonempty_primeFactors.mpr hn'1)
  by_contra hlt
  have hcard : n'.primeFactors.card = 1 := by omega
  obtain ⟨p, a, hp, ha, rfl⟩ := (isPrimePow_nat_iff n').mp
    (isPrimePow_iff_card_primeFactors_eq_one.mpr hcard)
  have hpo : Odd p := by
    rcases hp.eq_two_or_odd' with rfl | h
    · exfalso
      have : Even (2 ^ a) := (Nat.even_pow' (by omega)).mpr even_two
      exact (Nat.not_even_iff_odd.mpr hodd) this
    · exact h
  exact two_pow_mul_prime_pow_not_solution hv hp hpo ha hden


/-- `F` as an explicit finite sum of rationals (for numerical evaluation). -/
lemma F_eval {p : ℕ} (hp : p.Prime) (a : ℕ) :
    F p a = ∑ b ∈ range (a + 1), 1 / (∑ i ∈ range (b + 1), (p : ℚ) ^ i) := by
  unfold F
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [sigma_one_apply_prime_pow hp]
  push_cast
  rfl

/-- Tail bound for `F` in the exponent. -/
lemma F_tail {p : ℕ} (hp : p.Prime) {a₀ a : ℕ} (h : a₀ ≤ a) :
    F p a ≤ F p a₀ + 1 / ((p : ℚ) ^ a₀ * (p - 1)) - 1 / ((p : ℚ) ^ a * (p - 1)) := by
  induction a, h using Nat.le_induction with
  | base => simp
  | succ a _ ih =>
    rw [F_succ]
    have hp1 : (1 : ℚ) < p := by exact_mod_cast hp.one_lt
    have hp0 : (0 : ℚ) < p := by linarith
    have h1 : (1 : ℚ) / ((σ 1 (p ^ (a + 1)) : ℕ) : ℚ) ≤ 1 / (p : ℚ) ^ (a + 1) := by
      apply one_div_le_one_div_of_le (by positivity)
      have := self_le_sigma_one (pow_ne_zero (a + 1) hp.ne_zero)
      exact_mod_cast this
    have h3 : (1 : ℚ) / (p : ℚ) ^ (a + 1)
        = 1 / ((p : ℚ) ^ a * (p - 1)) - 1 / ((p : ℚ) ^ (a + 1) * (p - 1)) := by
      have : (p : ℚ) - 1 ≠ 0 := by linarith
      field_simp
      ring
    linarith

lemma F_lt_tail {p : ℕ} (hp : p.Prime) {a₀ a : ℕ} (h : a₀ ≤ a) :
    F p a < F p a₀ + 1 / ((p : ℚ) ^ a₀ * (p - 1)) := by
  have := F_tail hp h
  have hp1 : (1 : ℚ) < p := by exact_mod_cast hp.one_lt
  have : (0 : ℚ) < 1 / ((p : ℚ) ^ a * (p - 1)) := by
    apply _root_.div_pos one_pos
    apply mul_pos (by positivity)
    linarith
  linarith

lemma F_ge_one_add {p a : ℕ} (hp : p.Prime) (ha : 1 ≤ a) : 1 + 1 / ((p : ℚ) + 1) ≤ F p a := by
  have h1 : F p 1 ≤ F p a := F_mono hp ha
  have : F p 1 = 1 + 1 / ((p : ℚ) + 1) := by
    rw [F_eval hp]
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one]
    ring
  linarith

/-- Generic tail bound for `f (2^v)`. -/
lemma f_two_pow_tail_gen {v₀ v : ℕ} (hv : v₀ ≤ v) :
    f (2 ^ v) ≤ f (2 ^ v₀) + 1 / 2 ^ v₀ - 1 / (2 : ℚ) ^ v := by
  induction v, hv using Nat.le_induction with
  | base => simp
  | succ v _ ih =>
    rw [f_two_pow_succ]
    have h1 : (1 : ℚ) / ((2 ^ (v + 2) - 1 : ℕ) : ℚ) ≤ 1 / 2 ^ (v + 1) := by
      apply one_div_le_one_div_of_le (by positivity)
      have h2 : 2 ^ (v + 1) ≤ 2 ^ (v + 2) - 1 := by
        have : 2 ^ (v + 2) = 2 * 2 ^ (v + 1) := by ring
        have : 1 ≤ 2 ^ (v + 1) := Nat.one_le_two_pow
        omega
      exact_mod_cast h2
    have h3 : (1 : ℚ) / 2 ^ (v + 1) = 1 / 2 ^ v - 1 / 2 ^ (v + 1) := by
      rw [pow_succ]; field_simp; ring
    linarith

/-- `f (2^v)` as an explicit finite sum. -/
lemma f_two_pow_eq_sum (v : ℕ) :
    f (2 ^ v) = ∑ j ∈ range (v + 1), 1 / ((2 : ℚ) ^ (j + 1) - 1) := by
  rw [f_prime_pow Nat.prime_two, F_eval Nat.prime_two]
  refine Finset.sum_congr rfl fun j _ => ?_
  congr 1
  rw [geom_sum_eq (by norm_num) (j + 1)]
  ring

/-- An explicit upper bound valid for every `f (2^v)`. -/
noncomputable def SUP : ℚ := f (2 ^ 16) + 1 / 2 ^ 16

lemma f_two_pow_lt_SUP (v : ℕ) : f (2 ^ v) < SUP := by
  unfold SUP
  rcases le_or_gt 16 v with h | h
  · have := f_two_pow_tail_gen h
    have : (0 : ℚ) < 1 / (2 : ℚ) ^ v := by positivity
    linarith
  · have h16 : f (2 ^ 16) < f (2 ^ 16) + 1 / 2 ^ 16 := by
      have : (0 : ℚ) < (1 : ℚ) / (2 : ℚ) ^ 16 := by positivity
      linarith
    exact lt_of_le_of_lt (f_two_pow_mono h.le) h16

lemma f_two_pow_five : f (2 ^ 5) = 15536 / 9765 := by
  rw [f_two_pow_eq_sum]; norm_num [Finset.sum_range_succ]
lemma f_two_pow_eight : f (2 ^ 8) = 2469747943 / 1539032355 := by
  rw [f_two_pow_eq_sum]; norm_num [Finset.sum_range_succ]
