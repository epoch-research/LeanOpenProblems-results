  rw [f_two_pow_eq_sum]; norm_num [Finset.sum_range_succ]
/-- Decimal lower bound for `f (2^21)`. -/
lemma LO21_le : (16066949139966937 : ℚ) / 10 ^ 16 ≤ f (2 ^ 21) := by
  rw [f_two_pow_twentyone]; norm_num
/-- Decimal upper bound for `f (2^21)`. -/
lemma lt_HI21 : f (2 ^ 21) < (16066949139966938 : ℚ) / 10 ^ 16 := by
  rw [f_two_pow_twentyone]; norm_num
/-- Decimal lower bound for `f (2^29)`. -/
