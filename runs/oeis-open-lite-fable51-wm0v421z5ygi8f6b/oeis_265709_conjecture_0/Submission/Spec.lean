  rw [f_two_pow_eq_sum]; norm_num [Finset.sum_range_succ]
lemma f_two_pow_sixteen :
    f (2 ^ 16) = 86449773005982522786719469901 / 53806214194338683182649961417 := by
  rw [f_two_pow_eq_sum]; norm_num [Finset.sum_range_succ]
lemma SUP_val : SUP = 86449773005982522786719469901 / 53806214194338683182649961417 + 1 / 2 ^ 16 := by
  rw [SUP, f_two_pow_sixteen]

/-- `f` is multiplicative on coprime arguments. -/
lemma f_mul_coprime {m n : ℕ} (h : Nat.Coprime m n) : f (m * n) = f m * f n := by
  rw [f_eq, f_eq, f_eq, f_isMultiplicative.map_mul_of_coprime h]

/-- Exact 2-adic valuation of `f (2^v * (p^a * q^b))`. -/
lemma padicValRat_f_three {v p a q b : ℕ} (hp : p.Prime) (hq : q.Prime) (hpo : Odd p) (hqo : Odd q)
    (hpq : p ≠ q) :
    padicValRat 2 (f (2 ^ v * (p ^ a * q ^ b))) =
      padicValRat 2 (f (2 ^ v)) + padicValRat 2 (F p a) + padicValRat 2 (F q b) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hodd : Odd (p ^ a * q ^ b) := hpo.pow.mul hqo.pow
  have hcop : Nat.Coprime (2 ^ v) (p ^ a * q ^ b) := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hcop2 : Nat.Coprime (p ^ a) (q ^ b) := ((Nat.coprime_primes hp hq).mpr hpq).pow a b
  rw [f_mul_coprime hcop, f_mul_coprime hcop2, f_prime_pow hp, f_prime_pow hq]
  have h1 := f_pos (n := 2 ^ v) (by positivity)
  have h2 : 0 < F p a := by rw [← f_prime_pow hp]; exact f_pos (pow_ne_zero _ hp.ne_zero)
  have h3 : 0 < F q b := by rw [← f_prime_pow hq]; exact f_pos (pow_ne_zero _ hq.ne_zero)
  rw [padicValRat.mul h1.ne' (mul_pos h2 h3).ne', padicValRat.mul h2.ne' h3.ne', add_assoc]

lemma padicValRat_f_two : padicValRat 2 (f (2 ^ 1)) = 2 := by
  rw [f_two_pow_one, show (4 / 3 : ℚ) = ((4 : ℕ) : ℚ) / ((3 : ℕ) : ℚ) by norm_num,
    padicValRat.div (by norm_num) (by norm_num), ← padicValRat_of_nat, ← padicValRat_of_nat,
    show (4 : ℕ) = 2 ^ 2 by norm_num, padicValNat.prime_pow,
    padicValNat.eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 3)]
  norm_num

lemma padicValRat_f_eight : padicValRat 2 (f (2 ^ 3)) = 1 := by
  rw [f_two_pow_three, show (54 / 35 : ℚ) = ((54 : ℕ) : ℚ) / ((35 : ℕ) : ℚ) by norm_num,
    padicValRat.div (by norm_num) (by norm_num), ← padicValRat_of_nat, ← padicValRat_of_nat,
    show (54 : ℕ) = 2 * 27 by norm_num, padicValNat.mul (by norm_num) (by norm_num),
    padicValNat_self, padicValNat.eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 27),
    padicValNat.eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 35)]
  norm_num

