lemma padicValNat_two_pow_mul_odd {v n' : ℕ} (hodd : Odd n') : padicValNat 2 (2 ^ v * n') = v := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hodd
  rw [padicValNat.mul (by positivity) hn'0, padicValNat.prime_pow,
    padicValNat.eq_zero_of_not_dvd (by rw [← even_iff_two_dvd]; exact Nat.not_even_iff_odd.mpr hodd)]
  simp

/-- **2-adic constraint on solutions.**  Any solution `n > 1` satisfies `v₂(n) ≡ 5 (mod 8)`. -/
theorem padicValNat_two_mod_eight {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    padicValNat 2 n % 8 = 5 := by
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  have hv : 1 ≤ v := by
    by_contra h
    have hv0 : v = 0 := by omega
    subst hv0
    have := even_of_den_eq_one hn hden
    simp at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution hv hden
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have h4 := four_le_card_primeFactors hn hden
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at h4
  have hB := card_primeFactors_le hodd hn'1 hden
  have hv3 : (3 : ℤ) ≤ padicValRat 2 (f (2 ^ v)) := by
    have : (3 : ℤ) ≤ (n'.primeFactors.card : ℤ) := by exact_mod_cast (show 3 ≤ n'.primeFactors.card by omega)
    linarith
  have hv2 : 2 ≤ v := by
    by_contra h
    have hv1 : v = 1 := by omega
    subst hv1
    rw [padicValRat_f_two] at hv3
    norm_num at hv3
  have hdvd := two_pow_dvd_of_padicValRat_f_two_pow (N := 2) (t := 3) (by norm_num) c_two hv2
    (by norm_num) hv3
  rw [padicValNat_two_pow_mul_odd hodd]
  norm_num at hdvd
  omega


