  · obtain ⟨u, rfl⟩ := ho
    have : u ≤ 4 := by omega
    interval_cases u
    · rw [show 2 * 0 + 1 = 1 by norm_num, padicValRat_f_two]; norm_num
    · rw [show 2 * 1 + 1 = 3 by norm_num, padicValRat_f_eight]; norm_num
    · rw [show 2 * 2 + 1 = 5 by norm_num, padicValRat_f_thirtytwo]
    · rw [show 2 * 3 + 1 = 7 by norm_num, padicValRat_f_two_pow_seven]; norm_num
    · rw [show 2 * 4 + 1 = 9 by norm_num, padicValRat_f_two_pow_nine]; norm_num

/-- General 2-adic congruence for solutions: if `n` is a solution with at least `t + 1`
distinct prime factors, `c N = A / B`, `t ≤ N + 2`, and `v₂ (f (2^w)) < t` for all `w < N`, then
`2^t ∣ A - (v₂(n) + 1) * B`. -/
theorem two_pow_dvd_of_solution {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) {t N : ℕ} {A B : ℤ}
    (hB : B ≠ 0) (hc : c N = (A : ℚ) / B) (ht : t ≤ N + 2)
    (hsmall : ∀ w, w < N → padicValRat 2 (f (2 ^ w)) < t)
    (hcard : t + 1 ≤ n.primeFactors.card) :
    (2 : ℤ) ^ t ∣ A - (padicValNat 2 n + 1) * B := by
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  have hv : 1 ≤ v := by
    by_contra h
    have hv0 : v = 0 := by omega
    subst hv0
    have := even_of_den_eq_one hn hden
    simp at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution hv hden
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at hcard
  have hB' := card_primeFactors_le hodd hn'1 hden
  have hval : (t : ℤ) ≤ padicValRat 2 (f (2 ^ v)) := by
    have : (t : ℤ) ≤ (n'.primeFactors.card : ℤ) := by
      exact_mod_cast (show t ≤ n'.primeFactors.card by omega)
    linarith
  have hvN : N ≤ v := by
    by_contra h
    push_neg at h
    have := hsmall v h
    linarith
  rw [padicValNat_two_pow_mul_odd hodd]
  exact two_pow_dvd_of_padicValRat_f_two_pow hB hc hvN ht hval

lemma small_of_le_ten {t N : ℕ} (hN : N ≤ 10) (ht : 5 ≤ t) :
    ∀ w, w < N → padicValRat 2 (f (2 ^ w)) < t := by
  intro w hw
  have := padicValRat_f_two_pow_le_four (show w ≤ 9 by omega)
  have : (5 : ℤ) ≤ t := by exact_mod_cast ht
  linarith

