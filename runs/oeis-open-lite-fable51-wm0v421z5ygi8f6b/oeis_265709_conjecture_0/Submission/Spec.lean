    rw [hvp1] at this; norm_num at this
    obtain ⟨t, ht⟩ := hpo; omega
  · have := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) (a + 1)
    rw [hlog1] at this; norm_num at this; omega

/-- Peeling off the minimum of a finset (ℕ-valued version). -/
lemma peel_min_nat {s : Finset ℕ} (hne : s.Nonempty) (g : ℕ → ℕ) :
    ∏ p ∈ s, g p = g (s.min' hne) * ∏ p ∈ s.erase (s.min' hne), g p ∧
    s.min' hne ∈ s ∧ (∀ p ∈ s.erase (s.min' hne), s.min' hne < p) ∧
    (s.erase (s.min' hne)).card = s.card - 1 := by
  refine ⟨(Finset.mul_prod_erase s g (Finset.min'_mem s hne)).symm, Finset.min'_mem s hne,
    fun p hp => Finset.min'_lt_of_mem_erase_min' s hne hp,
    Finset.card_erase_of_mem (Finset.min'_mem s hne)⟩

/-- Four distinct prime factors: explicit sorted representation. -/
lemma eq_four_prime_pows_of_card_eq_four {n : ℕ} (hn : n ≠ 0)
    (h : n.primeFactors.card = 4) :
    ∃ p q r s a b c d : ℕ, p.Prime ∧ q.Prime ∧ r.Prime ∧ s.Prime ∧ p < q ∧ q < r ∧ r < s ∧
      1 ≤ a ∧ 1 ≤ b ∧ 1 ≤ c ∧ 1 ≤ d ∧ n = p ^ a * q ^ b * r ^ c * s ^ d := by
  have hfac := Nat.factorization_prod_pow_eq_self hn
  rw [Finsupp.prod, Nat.support_factorization] at hfac
  have hne1 : n.primeFactors.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e1, hm1, hgt1, hc1⟩ := peel_min_nat hne1 (fun p => p ^ n.factorization p)
  set S1 := n.primeFactors.erase (n.primeFactors.min' hne1) with hS1
  have hne2 : S1.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e2, hm2, hgt2, hc2⟩ := peel_min_nat hne2 (fun p => p ^ n.factorization p)
  set S2 := S1.erase (S1.min' hne2) with hS2
  have hne3 : S2.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e3, hm3, hgt3, hc3⟩ := peel_min_nat hne3 (fun p => p ^ n.factorization p)
  set S3 := S2.erase (S2.min' hne3) with hS3
  have hne4 : S3.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e4, hm4, _, hc4⟩ := peel_min_nat hne4 (fun p => p ^ n.factorization p)
  have hS4 : S3.erase (S3.min' hne4) = ∅ := Finset.card_eq_zero.mp (by omega)
  rw [hS4, Finset.prod_empty, mul_one] at e4
  have m1 : n.primeFactors.min' hne1 ∈ n.primeFactors := hm1
  have m2 : S1.min' hne2 ∈ n.primeFactors := Finset.mem_of_mem_erase hm2
  have m3 : S2.min' hne3 ∈ n.primeFactors :=
    Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hm3)
  have m4 : S3.min' hne4 ∈ n.primeFactors :=
    Finset.mem_of_mem_erase (Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hm4))
  have hp := Nat.prime_of_mem_primeFactors m1
  have hq := Nat.prime_of_mem_primeFactors m2
  have hr := Nat.prime_of_mem_primeFactors m3
  have hs := Nat.prime_of_mem_primeFactors m4
  refine ⟨_, _, _, _, _, _, _, _, hp, hq, hr, hs, hgt1 _ hm2, hgt2 _ hm3, hgt3 _ hm4,
    Nat.Prime.factorization_pos_of_dvd hp hn (Nat.dvd_of_mem_primeFactors m1),
    Nat.Prime.factorization_pos_of_dvd hq hn (Nat.dvd_of_mem_primeFactors m2),
    Nat.Prime.factorization_pos_of_dvd hr hn (Nat.dvd_of_mem_primeFactors m3),
    Nat.Prime.factorization_pos_of_dvd hs hn (Nat.dvd_of_mem_primeFactors m4), ?_⟩
  refine hfac.symm.trans ?_
  rw [e1, e2, e3, e4]
  ring

lemma f_mul_four {v p a q b r c s d : ℕ} (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hs : s.Prime) (hpo : Odd p) (hqo : Odd q) (hro : Odd r) (hso : Odd s)
    (hpq : p ≠ q) (hpr : p ≠ r) (hps : p ≠ s) (hqr : q ≠ r) (hqs : q ≠ s) (hrs : r ≠ s) :
    f (2 ^ v * (p ^ a * q ^ b * r ^ c * s ^ d)) =
      f (2 ^ v) * (F p a * F q b * F r c * F s d) := by
  have hodd : Odd (p ^ a * q ^ b * r ^ c * s ^ d) :=
    ((hpo.pow.mul hqo.pow).mul hro.pow).mul hso.pow
  have hcop : Nat.Coprime (2 ^ v) (p ^ a * q ^ b * r ^ c * s ^ d) := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hcop2 : Nat.Coprime (p ^ a) (q ^ b) := ((Nat.coprime_primes hp hq).mpr hpq).pow a b
  have hcop3 : Nat.Coprime (p ^ a * q ^ b) (r ^ c) :=
    Nat.Coprime.mul_left (((Nat.coprime_primes hp hr).mpr hpr).pow a c)
      (((Nat.coprime_primes hq hr).mpr hqr).pow b c)
  have hcop4 : Nat.Coprime (p ^ a * q ^ b * r ^ c) (s ^ d) :=
    Nat.Coprime.mul_left (Nat.Coprime.mul_left (((Nat.coprime_primes hp hs).mpr hps).pow a d)
      (((Nat.coprime_primes hq hs).mpr hqs).pow b d)) (((Nat.coprime_primes hr hs).mpr hrs).pow c d)
  rw [f_mul_coprime hcop, f_mul_coprime hcop4, f_mul_coprime hcop3, f_mul_coprime hcop2,
    f_prime_pow hp, f_prime_pow hq, f_prime_pow hr, f_prime_pow hs]

lemma prod4_le {F1 F2 F3 F4 hi1 hi2 hi3 hi4 : ℚ}
    (h1 : F1 ≤ hi1) (h2 : F2 ≤ hi2) (h3 : F3 ≤ hi3) (h4 : F4 ≤ hi4)
    (hF1 : 0 < F1) (hF2 : 0 < F2) (hF3 : 0 < F3) (hF4 : 0 < F4) :
    F1 * F2 * F3 * F4 ≤ hi1 * hi2 * hi3 * hi4 := by
  have a1 : F1 * F2 ≤ hi1 * hi2 := mul_le_mul h1 h2 hF2.le (by linarith)
  have a2 : F1 * F2 * F3 ≤ hi1 * hi2 * hi3 :=
    mul_le_mul a1 h3 hF3.le (mul_nonneg (by linarith) (by linarith))
  exact mul_le_mul a2 h4 hF4.le (mul_nonneg (mul_nonneg (by linarith) (by linarith)) (by linarith))

lemma f_mul_lt {v : ℕ} {F1 F2 F3 F4 hi1 hi2 hi3 hi4 H K : ℚ} (hH : f (2 ^ v) < H)
    (h1 : F1 ≤ hi1) (h2 : F2 ≤ hi2) (h3 : F3 ≤ hi3) (h4 : F4 ≤ hi4)
    (hF1 : 0 < F1) (hF2 : 0 < F2) (hF3 : 0 < F3) (hF4 : 0 < F4)
    (hw : H * (hi1 * hi2 * hi3 * hi4) ≤ K) : f (2 ^ v) * (F1 * F2 * F3 * F4) < K := by
  have hG := prod4_le h1 h2 h3 h4 hF1 hF2 hF3 hF4
  have hpos : 0 < F1 * F2 * F3 * F4 := by positivity
  have e1 : f (2 ^ v) * (F1 * F2 * F3 * F4) < H * (F1 * F2 * F3 * F4) :=
    mul_lt_mul_of_pos_right hH hpos
  have hH0 : 0 < H := lt_trans (f_pos (by positivity)) hH
  have e2 : H * (F1 * F2 * F3 * F4) ≤ H * (hi1 * hi2 * hi3 * hi4) :=
    mul_le_mul_of_nonneg_left hG hH0.le
  linarith

lemma S_five : S 5 = 74 := by
  simp [S, Finset.sum_range_succ, sigma_zero_apply]
  decide

/-- If `v₂(f(2^v)) ≥ 5` and `v ≥ 3` then `v ≡ 21 (mod 32)`. -/
lemma v_mod_32_of_five_le {v : ℕ} (hv : 3 ≤ v) (h : (5 : ℤ) ≤ padicValRat 2 (f (2 ^ v))) :
    v % 32 = 21 := by
  have hdvd := two_pow_dvd_D h
  have hmod : v + 1 + D v 5 ≡ v + 1 + S 5 [MOD 2 ^ 5] := (D_modEq_S (by omega)).add_left _
  have h2 : 2 ^ 5 ∣ v + 1 + S 5 :=
    (Nat.modEq_zero_iff_dvd).mp (hmod.symm.trans (Nat.modEq_zero_iff_dvd.mpr hdvd))
  rw [S_five] at h2
  norm_num at h2
  omega

/-- **Main structural theorem.**  Every solution `n > 1` has `v₂(f(2^{v₂(n)})) ≥ 6`. -/
theorem six_le_padicValRat_of_solution {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    (6 : ℤ) ≤ padicValRat 2 (f (2 ^ padicValNat 2 n)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h5 := five_le_card_primeFactors hn hden
  have h21 := padicValNat_two_ge_twentyone hn hden
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  rw [padicValNat_two_pow_mul_odd hodd] at h21 ⊢
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution (by omega) hden
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at h5
  have hB := card_primeFactors_le hodd hn'1 hden
  by_contra hlt
  push_neg at hlt
  -- general valuation facts
  have hmul : f (2 ^ v * n') = f (2 ^ v) * f n' := f_mul_coprime hcop
  have hpos1 := f_pos (n := 2 ^ v) (by positivity)
  have hpos2 := f_pos hn'0
  have hK : f (2 ^ v * n') = ((f (2 ^ v * n')).num : ℚ) := (Rat.coe_int_num_of_den_eq_one hden).symm
  have hnonneg : 0 ≤ padicValRat 2 (f (2 ^ v * n')) := by
    rw [hK, padicValRat.of_int]
    unfold padicValInt; positivity
  have hval : padicValRat 2 (f (2 ^ v * n')) = padicValRat 2 (f (2 ^ v)) + padicValRat 2 (f n') := by
    rw [hmul, padicValRat.mul hpos1.ne' hpos2.ne']
  have hFne : ∀ p ∈ n'.primeFactors, F p (n'.factorization p) ≠ 0 := by
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    rw [← f_prime_pow hpp]
    exact (f_pos (pow_ne_zero _ hpp.ne_zero)).ne'
  have hprod : padicValRat 2 (f n') =
      ∑ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p)) := by
    rw [f_eq_prod hn'0, padicValRat_prod _ _ 2 hFne]
  have hodd_p : ∀ p ∈ n'.primeFactors, p.Prime ∧ Odd p ∧ 1 ≤ n'.factorization p := by
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    refine ⟨hpp, ?_, Nat.Prime.factorization_pos_of_dvd hpp hn'0 (Nat.mem_primeFactors.mp hp).2.1⟩
    rcases hpp.eq_two_or_odd' with rfl | h
    · exfalso
      have : 2 ∣ n' := Nat.dvd_of_mem_primeFactors hp
      exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr this)
    · exact h
  have hle : ∀ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p)) + 1 ≤ 0 := by
    intro p hp
    obtain ⟨hpp, hpo, ha⟩ := hodd_p p hp
    have := padicValRat_F_neg hpp hpo ha
    omega
  have hk1 : (1 : ℚ) < f (2 ^ v * n') := by
    rw [hmul]
    have := one_le_f hn'0
    obtain ⟨hf1, _⟩ := f_two_pow_bounds (a := v) (by omega)
    nlinarith
  have hHI := f_two_pow_lt_HI v
  have hcard45 : n'.primeFactors.card = 4 ∨ n'.primeFactors.card = 5 := by
    have : (n'.primeFactors.card : ℤ) < 6 := by linarith
    omega
  rcases hcard45 with hcard | hcard
  · -- four odd primes
    obtain ⟨p, q, r, s, a, b, c, d, hp, hq, hr, hs, hpq, hqr, hrs, ha, hb, hc, hd, hn'eq⟩ :=
      eq_four_prime_pows_of_card_eq_four hn'0 hcard
    subst hn'eq
    have hpo : Odd p := Odd.of_dvd_nat hodd
      (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_pow_self p (by omega)) _) _) _)
    have hqo : Odd q := Odd.of_dvd_nat hodd
      (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (dvd_pow_self q (by omega)) _) _) _)
    have hro : Odd r := Odd.of_dvd_nat hodd
      (dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (dvd_pow_self r (by omega)) _) _)
    have hso : Odd s := Odd.of_dvd_nat hodd (dvd_mul_of_dvd_right (dvd_pow_self s (by omega)) _)
    have hmul4 := f_mul_four (v := v) (a := a) (b := b) (c := c) (d := d) hp hq hr hs hpo hqo hro hso
      hpq.ne (hpq.trans hqr).ne ((hpq.trans hqr).trans hrs).ne hqr.ne (hqr.trans hrs).ne hrs.ne
    have hFp : 0 < F p a := by linarith [F_gt_one hp ha]
    have hFq : 0 < F q b := by linarith [F_gt_one hq hb]
    have hFr : 0 < F r c := by linarith [F_gt_one hr hc]
    have hFs : 0 < F s d := by linarith [F_gt_one hs hd]
    have hval4 : padicValRat 2 (f (2 ^ v * (p ^ a * q ^ b * r ^ c * s ^ d))) =
        padicValRat 2 (f (2 ^ v)) + padicValRat 2 (F p a) + padicValRat 2 (F q b) +
          padicValRat 2 (F r c) + padicValRat 2 (F s d) := by
      rw [hmul4, padicValRat.mul hpos1.ne' (by positivity), padicValRat.mul (by positivity) hFs.ne',
        padicValRat.mul (by positivity) hFr.ne', padicValRat.mul hFp.ne' hFq.ne']
      ring
    have hFpv := padicValRat_F hp hpo ha
    have hFqv := padicValRat_F hq hqo hb
    have hFrv := padicValRat_F hr hro hc
    have hFsv := padicValRat_F hs hso hd
    have hFpn := padicValRat_F_neg hp hpo ha
    have hFqn := padicValRat_F_neg hq hqo hb
    have hFrn := padicValRat_F_neg hr hro hc
    have hFsn := padicValRat_F_neg hs hso hd
    -- numeric facts about the primes
    have hp3 : 3 ≤ p := by obtain ⟨t, ht⟩ := hpo; have := hp.two_le; omega
    have hq5 : 5 ≤ q := by obtain ⟨t, ht⟩ := hqo; omega
    have hr7 : 7 ≤ r := by obtain ⟨t, ht⟩ := hro; omega
    have hs9 : 9 ≤ s := by obtain ⟨t, ht⟩ := hso; omega
    have hr9 : r ≠ 9 := by rintro rfl; norm_num at hr
    have hs9' : s ≠ 9 := by rintro rfl; norm_num at hs
    -- size bound: f n < 3
    have hk3 : f (2 ^ v * (p ^ a * q ^ b * r ^ c * s ^ d)) < 3 := by
      rw [hmul4]
      rcases Nat.lt_or_ge p 5 with hp5 | hp5
      · -- p = 3
        have hp3' : p = 3 := by obtain ⟨t, ht⟩ := hpo; omega
        subst hp3'
        have hv4 : padicValNat 2 (3 + 1) = 2 := by
          rw [show (3 + 1 : ℕ) = 2 ^ 2 by norm_num, padicValNat.prime_pow]
        rw [hv4] at hFpv
        have hla : 1 ≤ Nat.log 2 (a + 1) := Nat.le_log_of_pow_le (by norm_num) (by omega)
        -- the other three costs are exactly 1
        have hFqn' : padicValRat 2 (F q b) ≤ -1 := by omega
        have hFrn' : padicValRat 2 (F r c) ≤ -1 := by omega
        have hFsn' : padicValRat 2 (F s d) ≤ -1 := by omega
        have hFpn' : padicValRat 2 (F 3 a) ≤ -1 - (Nat.log 2 (a + 1) : ℤ) := by omega
        have hlaz : (1 : ℤ) ≤ (Nat.log 2 (a + 1) : ℤ) := by exact_mod_cast hla
        have hq1 : padicValRat 2 (F q b) = -1 := by linarith
        have hr1 : padicValRat 2 (F r c) = -1 := by linarith
        have hs1 : padicValRat 2 (F s d) = -1 := by linarith
        have hlog1 : Nat.log 2 (a + 1) = 1 := by
          have : (Nat.log 2 (a + 1) : ℤ) ≤ 1 := by linarith
          omega
        have ha2 : a ≤ 2 := by
          have := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) (a + 1)
          rw [hlog1] at this; norm_num at this; omega
        obtain ⟨hq4, hb2⟩ := mod_four_of_cost_one hq hqo hb hq1
        obtain ⟨hr4, hc2⟩ := mod_four_of_cost_one hr hro hc hr1
        obtain ⟨hs4, hd2⟩ := mod_four_of_cost_one hs hso hd hs1
        have hr13 : 13 ≤ r := by omega
        have hs17 : 17 ≤ s := by omega
        have e1 : F 3 a ≤ 69 / 52 := by
          have := F_mono Nat.prime_three ha2; rw [F_three_two] at this; exact this
        have e2 : F q b ≤ 223 / 186 := by
          have := F_le_Fq_two hq hb2 (by norm_num : 1 ≤ 5) hq5
          rw [Fq_two_eq] at this; norm_num at this; exact this
        have e3 : F r c ≤ 13 / 12 := by
          have := F_lt_of_le (a := c) hr (P := 13) (by norm_num) hr13; norm_num at this; exact this.le
        have e4 : F s d ≤ 17 / 16 := by
          have := F_lt_of_le (a := d) hs (P := 17) (by norm_num) hs17; norm_num at this; exact this.le
        exact f_mul_lt hHI e1 e2 e3 e4 hFp hFq hFr hFs (by norm_num)
      · -- p ≥ 5
        have hq7 : 7 ≤ q := by obtain ⟨t, ht⟩ := hqo; omega
        have hr11 : 11 ≤ r := by obtain ⟨t, ht⟩ := hro; omega
        have hs13 : 13 ≤ s := by obtain ⟨t, ht⟩ := hso; omega
        have e1 : F p a ≤ 5 / 4 := by
          have := F_lt_of_le (a := a) hp (P := 5) (by norm_num) hp5; norm_num at this; exact this.le
        have e2 : F q b ≤ 7 / 6 := by
          have := F_lt_of_le (a := b) hq (P := 7) (by norm_num) hq7; norm_num at this; exact this.le
        have e3 : F r c ≤ 11 / 10 := by
          have := F_lt_of_le (a := c) hr (P := 11) (by norm_num) hr11; norm_num at this; exact this.le
        have e4 : F s d ≤ 13 / 12 := by
          have := F_lt_of_le (a := d) hs (P := 13) (by norm_num) hs13; norm_num at this; exact this.le
        exact f_mul_lt hHI e1 e2 e3 e4 hFp hFq hFr hFs (by norm_num)
    -- hence the value is 2
    have hnum2 : (f (2 ^ v * (p ^ a * q ^ b * r ^ c * s ^ d))).num = 2 := by
      rw [hK] at hk1 hk3
      have h1 : (1 : ℤ) < (f (2 ^ v * (p ^ a * q ^ b * r ^ c * s ^ d))).num := by exact_mod_cast hk1
      have h3 : (f (2 ^ v * (p ^ a * q ^ b * r ^ c * s ^ d))).num < 3 := by exact_mod_cast hk3
      omega
    have h2 : f (2 ^ v) * (F p a * F q b * F r c * F s d) = 2 := by
      rw [← hmul4, hK, hnum2]; norm_num
    have h2v : padicValRat 2 (2 : ℚ) = 1 := by
      have := padicValRat.self (p := 2) one_lt_two; simpa using this
    rw [hmul4, h2, h2v] at hval4
    -- all costs are 1 and t = 5
    have hp1 : padicValRat 2 (F p a) = -1 := by omega
    have hq1 : padicValRat 2 (F q b) = -1 := by omega
    have hr1 : padicValRat 2 (F r c) = -1 := by omega
    have hs1 : padicValRat 2 (F s d) = -1 := by omega
    have ht5 : (5 : ℤ) ≤ padicValRat 2 (f (2 ^ v)) := by omega
    obtain ⟨hp4, ha2⟩ := mod_four_of_cost_one hp hpo ha hp1
    obtain ⟨hq4, hb2⟩ := mod_four_of_cost_one hq hqo hb hq1
    obtain ⟨hr4, hc2⟩ := mod_four_of_cost_one hr hro hc hr1
    obtain ⟨hs4, hd2⟩ := mod_four_of_cost_one hs hso hd hs1
    have hv32 := v_mod_32_of_five_le (by omega) ht5
    exact case4_main hv32 hp hq hr hs hp4 hq4 hr4 hs4 hpq hqr hrs (by omega) (by omega) (by omega)
      (by omega) h2
  · -- five odd primes: the value is odd, hence ≥ 3, but the product is too small
    have hsum : ∑ p ∈ n'.primeFactors, (padicValRat 2 (F p (n'.factorization p)) + 1) = 0 := by
      have h0 : ∑ p ∈ n'.primeFactors, (padicValRat 2 (F p (n'.factorization p)) + 1) ≤ 0 :=
        Finset.sum_nonpos hle
      rw [Finset.sum_add_distrib, Finset.sum_const, hcard] at h0 ⊢
      simp only [nsmul_eq_mul, Nat.cast_ofNat, mul_one] at h0 ⊢
      rw [← hprod] at h0 ⊢
      omega
    have heach := (Finset.sum_eq_zero_iff_of_nonpos hle).mp hsum
    have hmod : ∀ p ∈ n'.primeFactors, p % 4 = 1 := by
      intro p hp
      obtain ⟨hpp, hpo, ha⟩ := hodd_p p hp
      exact (mod_four_of_cost_one hpp hpo ha (by linarith [heach p hp])).1
    have hv0 : padicValRat 2 (f (2 ^ v * n')) = 0 := by
      rw [Finset.sum_add_distrib, Finset.sum_const, hcard] at hsum
      simp only [nsmul_eq_mul, Nat.cast_ofNat, mul_one] at hsum
      rw [← hprod] at hsum
      omega
    have hkodd : ¬ 2 ∣ (f (2 ^ v * n')).num := by
      intro h2
      rw [hK, padicValRat.of_int] at hv0
      have h2' : (2 : ℤ) ^ 1 ∣ (f (2 ^ v * n')).num := by simpa using h2
      have hnum0 : (f (2 ^ v * n')).num ≠ 0 := by
