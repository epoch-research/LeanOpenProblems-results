/-- Any solution `n > 1` of the conjecture has at least five distinct prime factors. -/
theorem five_le_card_primeFactors {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    5 ≤ n.primeFactors.card := by
  have h4 := four_le_card_primeFactors hn hden
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  have hv : 1 ≤ v := by
    by_contra h
    have hv0 : v = 0 := by omega
    subst hv0
    have := even_of_den_eq_one hn hden
    simp at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at h4 ⊢
  by_contra hlt
  have hcard : n'.primeFactors.card = 3 := by omega
  obtain ⟨p, q, r, a, b, c, hp, hq, hr, hpq, hqr, ha, hb, hc, rfl⟩ :=
    eq_three_prime_pows_of_card_eq_three hn'0 hcard
  have hpo : Odd p :=
    Odd.of_dvd_nat hodd (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_pow_self p (by omega)) _) _)
  have hqo : Odd q :=
    Odd.of_dvd_nat hodd (dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (dvd_pow_self q (by omega)) _) _)
  have hro : Odd r :=
    Odd.of_dvd_nat hodd (dvd_mul_of_dvd_right (dvd_pow_self r (by omega)) _)
  exact two_pow_mul_three_prime_pow_not_solution hv hp hq hr hpo hqo hro hpq hqr ha hb hc hden

/-- **2-adic constraint, refined.**  Any solution `n > 1` satisfies `v₂(n) ≡ 5 (mod 16)`. -/
theorem padicValNat_two_mod_sixteen {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    padicValNat 2 n % 16 = 5 :=
  v_mod_of_card_four hn hden (five_le_card_primeFactors hn hden)

/- ### The general 2-adic congruence

`2^j/(2^j - 1) = -∑_{k=1}^{K+1} 2^{jk} + 2^{j(K+2)}/(2^j - 1)`, so modulo `2^t`
`c v ≡ -∑_{j ≤ v+1} ∑_{k ≤ t+1} 2^{jk}`, and `f (2^v) = c v - (v+1)`. -/

lemma two_pow_div_expand (j K : ℕ) :
    (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1) =
      -∑ k ∈ range (K + 1), (2 : ℚ) ^ ((j + 1) * (k + 1)) +
        (2 : ℚ) ^ ((j + 1) * (K + 2)) / ((2 : ℚ) ^ (j + 1) - 1) := by
  have hne : (2 : ℚ) ^ (j + 1) - 1 ≠ 0 := (two_pow_sub_one_pos' j).ne'
  have hgeom : (∑ k ∈ range (K + 1), ((2 : ℚ) ^ (j + 1)) ^ k) * ((2 : ℚ) ^ (j + 1) - 1) =
      ((2 : ℚ) ^ (j + 1)) ^ (K + 1) - 1 := geom_sum_mul _ _
  have hS : ∑ k ∈ range (K + 1), (2 : ℚ) ^ ((j + 1) * (k + 1)) =
      (2 : ℚ) ^ (j + 1) * ∑ k ∈ range (K + 1), ((2 : ℚ) ^ (j + 1)) ^ k := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [← pow_mul, ← pow_add]; congr 1; ring
  rw [hS]
  have hK : (2 : ℚ) ^ ((j + 1) * (K + 2)) = (2 : ℚ) ^ (j + 1) * ((2 : ℚ) ^ (j + 1)) ^ (K + 1) := by
    rw [← pow_mul, ← pow_add]; congr 1; ring
  have key : (2 : ℚ) ^ (j + 1) / ((2 : ℚ) ^ (j + 1) - 1) -
      (2 : ℚ) ^ ((j + 1) * (K + 2)) / ((2 : ℚ) ^ (j + 1) - 1) =
      -((2 : ℚ) ^ (j + 1) * ∑ k ∈ range (K + 1), ((2 : ℚ) ^ (j + 1)) ^ k) := by
    rw [← sub_div, div_eq_iff hne, hK]
    linear_combination ((2 : ℚ) ^ (j + 1)) * hgeom
  linarith

/-- The integer double sum `∑_{j=1}^{v+1} ∑_{k=1}^{t+1} 2^{jk}`. -/
def D (v t : ℕ) : ℕ := ∑ j ∈ range (v + 1), ∑ k ∈ range (t + 1), 2 ^ ((j + 1) * (k + 1))

lemma c_eq_D (v t : ℕ) :
    c v = -(D v t : ℚ) +
      ∑ j ∈ range (v + 1), (2 : ℚ) ^ ((j + 1) * (t + 2)) / ((2 : ℚ) ^ (j + 1) - 1) := by
  unfold c D
  push_cast
  rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  exact two_pow_div_expand j t

lemma padicValRat_err_ge (v t : ℕ) :
    (t : ℤ) ≤ padicValRat 2
      (∑ j ∈ range (v + 1), (2 : ℚ) ^ ((j + 1) * (t + 2)) / ((2 : ℚ) ^ (j + 1) - 1)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  apply le_padicValRat_sum
  · intro j _
    have := two_pow_sub_one_pos' j
    positivity
  · intro j _
    have hne : (2 : ℚ) ^ (j + 1) - 1 ≠ 0 := (two_pow_sub_one_pos' j).ne'
    have h2 : padicValRat 2 (2 : ℚ) = 1 := by
      have := padicValRat.self (p := 2) one_lt_two; simpa using this
    rw [padicValRat.div (by positivity) hne, padicValRat.pow (by norm_num), h2]
    have h0 : padicValRat 2 ((2 : ℚ) ^ (j + 1) - 1) = 0 := by
      have h1 : (2 : ℚ) ^ (j + 1) - 1 = ((2 ^ (j + 1) - 1 : ℕ) : ℚ) := by
        rw [Nat.cast_sub Nat.one_le_two_pow]; push_cast; ring
      rw [h1, ← padicValRat_of_nat, padicValNat.eq_zero_of_not_dvd]
      · simp
      · have : Odd (2 ^ (j + 1) - 1) := by
          have h2 : Even (2 ^ (j + 1)) := (Nat.even_pow' (by omega)).mpr even_two
          exact Nat.Even.sub_odd Nat.one_le_two_pow h2 odd_one
        rw [← even_iff_two_dvd]; exact Nat.not_even_iff_odd.mpr this
    rw [h0, sub_zero, mul_one]
    have : t ≤ (j + 1) * (t + 2) := by nlinarith
    exact_mod_cast this
  · exact ⟨0, by simp⟩

/-- **General 2-adic congruence.**  If `v₂ (f (2^v)) ≥ t` then
`2^t ∣ v + 1 + ∑_{j=1}^{v+1} ∑_{k=1}^{t+1} 2^{jk}`. -/
theorem two_pow_dvd_D {v t : ℕ} (hval : (t : ℤ) ≤ padicValRat 2 (f (2 ^ v))) :
    2 ^ t ∣ v + 1 + D v t := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set E := ∑ j ∈ range (v + 1), (2 : ℚ) ^ ((j + 1) * (t + 2)) / ((2 : ℚ) ^ (j + 1) - 1) with hE
  have hf : f (2 ^ v) = c v - (v + 1) := by
    have := f_two_pow_eq_c_sub (N := v) (v := v) le_rfl
    simpa using this
  have hcD := c_eq_D v t
  rw [← hE] at hcD
  have hEv := padicValRat_err_ge v t
  rw [← hE] at hEv
  have hkey : ((v + 1 + D v t : ℕ) : ℚ) = E + (-f (2 ^ v)) := by
    rw [hf, hcD]; push_cast; ring
  have hfpos : 0 < f (2 ^ v) := f_pos (by positivity)
  have hne : ((v + 1 + D v t : ℕ) : ℚ) ≠ 0 := by positivity
  have hv : (t : ℤ) ≤ padicValRat 2 ((v + 1 + D v t : ℕ) : ℚ) := by
    rw [hkey]
    refine le_trans ?_ (padicValRat.min_le_padicValRat_add (p := 2) (by rw [← hkey]; exact hne))
    rw [padicValRat.neg]
    exact le_min hEv hval
  rw [← padicValRat_of_nat] at hv
  have hv' : t ≤ padicValNat 2 (v + 1 + D v t) := by exact_mod_cast hv
  exact (padicValNat_dvd_iff_le (by positivity)).mpr hv'

/-- `S t = ∑_{M < t} τ(M) 2^M`, where `τ = σ 0` is the number-of-divisors function. -/
def S (t : ℕ) : ℕ := ∑ M ∈ range t, (σ 0 M) * 2 ^ M

/-- Modulo `2^t`, the double sum `D v t` reduces to `S t` as soon as `t ≤ v + 2`. -/
lemma D_modEq_S {v t : ℕ} (ht : t ≤ v + 2) : D v t ≡ S t [MOD 2 ^ t] := by
  classical
  set P := range (v + 1) ×ˢ range (t + 1) with hP
  set g : ℕ × ℕ → ℕ := fun x => (x.1 + 1) * (x.2 + 1) with hg
  have hD : D v t = ∑ x ∈ P, 2 ^ g x := by
    unfold D; rw [hP, Finset.sum_product]
  have hsplit : ∑ x ∈ P, 2 ^ g x =
      ∑ x ∈ P with g x < t, 2 ^ g x + ∑ x ∈ P with ¬ g x < t, 2 ^ g x :=
    (Finset.sum_filter_add_sum_filter_not P (fun x => g x < t) _).symm
  have hbig : 2 ^ t ∣ ∑ x ∈ P with ¬ g x < t, 2 ^ g x := by
    apply Finset.dvd_sum
    intro x hx
    rw [Finset.mem_filter] at hx
    exact pow_dvd_pow 2 (by omega)
  have hsmall : ∑ x ∈ P with g x < t, 2 ^ g x = S t := by
    unfold S
    rw [← Finset.sum_fiberwise_of_maps_to' (t := range t) (g := g)
      (fun x hx => by rw [Finset.mem_filter] at hx; exact Finset.mem_range.mpr hx.2)]
    refine Finset.sum_congr rfl fun M hM => ?_
    rw [Finset.sum_const, smul_eq_mul]
    congr 1
    rw [sigma_zero_apply]
    have hcard : M.divisorsAntidiagonal.card = M.divisors.card := by
      rw [← Nat.map_div_right_divisors, Finset.card_map]
    rw [← hcard]
    have hinj : Function.Injective (fun x : ℕ × ℕ => (x.1 + 1, x.2 + 1)) := by
      intro x y hxy
      simp only [Prod.mk.injEq] at hxy
      exact Prod.ext (by omega) (by omega)
    rw [← Finset.card_image_of_injective _ hinj]
    congr 1
    ext ⟨a, b⟩
    simp only [Finset.mem_image, Finset.mem_filter, hP, Finset.mem_product, Finset.mem_range,
      Nat.mem_divisorsAntidiagonal, Prod.mk.injEq, Prod.exists, hg]
    constructor
    · rintro ⟨j, k, ⟨⟨⟨hj, hk⟩, hlt⟩, hM⟩, rfl, rfl⟩
      exact ⟨hM, by rw [← hM]; exact (Nat.mul_pos (Nat.succ_pos j) (Nat.succ_pos k)).ne'⟩
    · rintro ⟨hab, hM0⟩
      have hMt : M < t := Finset.mem_range.mp hM
      have ha : 1 ≤ a := by
        rcases Nat.eq_zero_or_pos a with h | h
        · subst h; simp at hab; omega
        · exact h
      have hb : 1 ≤ b := by
        rcases Nat.eq_zero_or_pos b with h | h
        · subst h; simp at hab; omega
        · exact h
      have haM : a ≤ M := by rw [← hab]; exact Nat.le_mul_of_pos_right _ hb
      have hbM : b ≤ M := by rw [← hab]; exact Nat.le_mul_of_pos_left _ ha
      refine ⟨a - 1, b - 1, ⟨⟨⟨by omega, by omega⟩, ?_⟩, ?_⟩, by omega, by omega⟩
      · rw [Nat.sub_add_cancel ha, Nat.sub_add_cancel hb, hab]; exact hMt
      · rw [Nat.sub_add_cancel ha, Nat.sub_add_cancel hb, hab]
  rw [hD, hsplit, hsmall]
  have h0 := Nat.ModEq.add_left (S t) (Nat.modEq_zero_iff_dvd.mpr hbig)
  simpa using h0

/-- **General 2-adic congruence for solutions.**  If `n > 1` is a solution with
`ω(n) ≥ t + 1` and `t ≤ v₂(n) + 2`, then
`v₂(n) + 1 + ∑_{M < t} τ(M) 2^M ≡ 0 (mod 2^t)`. -/
theorem two_pow_dvd_S_of_solution {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) {t : ℕ}
    (hcard : t + 1 ≤ n.primeFactors.card) (ht : t ≤ padicValNat 2 n + 2) :
    2 ^ t ∣ padicValNat 2 n + 1 + S t := by
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  have hv : 1 ≤ v := by
    by_contra h
    have hv0 : v = 0 := by omega
    subst hv0
    have := even_of_den_eq_one hn hden
    simp at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution hv hden
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at hcard
  have hB := card_primeFactors_le hodd hn'1 hden
  have hval : (t : ℤ) ≤ padicValRat 2 (f (2 ^ v)) := by
    have : (t : ℤ) ≤ (n'.primeFactors.card : ℤ) := by
      exact_mod_cast (show t ≤ n'.primeFactors.card by omega)
    linarith
  rw [padicValNat_two_pow_mul_odd hodd] at ht ⊢
  have hdvd := two_pow_dvd_D hval
  have hmod : v + 1 + D v t ≡ v + 1 + S t [MOD 2 ^ t] := (D_modEq_S ht).add_left _
  exact (Nat.modEq_zero_iff_dvd).mp (hmod.symm.trans (Nat.modEq_zero_iff_dvd.mpr hdvd))

/-- Sanity check: the case `t = 3` recovers `v₂(n) ≡ 5 (mod 8)`. -/
example : S 3 = 10 := by
  simp [S, Finset.sum_range_succ, sigma_zero_apply]
  decide

/- ### Excluding `v₂(n) = 5`: every solution has `v₂(n) ≥ 21`. -/

lemma div_sub_one_anti {L p : ℕ} (hL : 2 ≤ L) (hLp : L ≤ p) :
    (p : ℚ) / ((p : ℚ) - 1) ≤ (L : ℚ) / ((L : ℚ) - 1) := by
  have hLq : (2 : ℚ) ≤ L := by exact_mod_cast hL
  have hLpq : (L : ℚ) ≤ p := by exact_mod_cast hLp
  rw [div_le_div_iff₀ (by linarith) (by linarith)]
  nlinarith

/-- Peeling off the minimum of a finset. -/
lemma peel_min {s : Finset ℕ} (hne : s.Nonempty) (g : ℕ → ℚ) :
    ∏ p ∈ s, g p = g (s.min' hne) * ∏ p ∈ s.erase (s.min' hne), g p ∧
    s.min' hne ∈ s ∧ (∀ p ∈ s.erase (s.min' hne), s.min' hne < p) ∧
    (s.erase (s.min' hne)).card = s.card - 1 := by
  refine ⟨(Finset.mul_prod_erase s g (Finset.min'_mem s hne)).symm, Finset.min'_mem s hne,
    fun p hp => Finset.min'_lt_of_mem_erase_min' s hne hp,
    Finset.card_erase_of_mem (Finset.min'_mem s hne)⟩

/-- Product bound for four distinct primes `≡ 1 (mod 4)`. -/
lemma prod_four_bound {s : Finset ℕ} (hs : s.card = 4) {g : ℕ → ℚ}
    (hprime : ∀ p ∈ s, p.Prime) (hmod : ∀ p ∈ s, p % 4 = 1)
    (hg0 : ∀ p ∈ s, 0 < g p) (hg : ∀ p ∈ s, g p < (p : ℚ) / ((p : ℚ) - 1)) :
    ∏ p ∈ s, g p < 5 / 4 * (13 / 12) * (17 / 16) * (29 / 28) := by
  have hge5 : ∀ p ∈ s, 5 ≤ p := by
    intro p hp
    have := (hprime p hp).two_le
    have := hmod p hp
    omega
  -- step 1
  have hne1 : s.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e1, hm1, hgt1, hc1⟩ := peel_min hne1 g
  set m1 := s.min' hne1
  set s2 := s.erase m1 with hs2
  have hs2sub : ∀ p ∈ s2, p ∈ s := fun p hp => Finset.mem_of_mem_erase hp
  have hge13 : ∀ p ∈ s2, 13 ≤ p := by
    intro p hp
    have h1 := hgt1 p hp
    have h2 := hge5 m1 hm1
    have h3 := hmod p (hs2sub p hp)
    have h4 : p ≠ 9 := by rintro rfl; have := hprime 9 (hs2sub 9 hp); norm_num at this
    omega
  -- step 2
  have hne2 : s2.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e2, hm2, hgt2, hc2⟩ := peel_min hne2 g
  set m2 := s2.min' hne2
  set s3 := s2.erase m2 with hs3
  have hs3sub : ∀ p ∈ s3, p ∈ s := fun p hp => hs2sub p (Finset.mem_of_mem_erase hp)
  have hge17 : ∀ p ∈ s3, 17 ≤ p := by
    intro p hp
    have h1 := hgt2 p hp
    have h2 := hge13 m2 hm2
    have h3 := hmod p (hs3sub p hp)
    omega
  -- step 3
  have hne3 : s3.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e3, hm3, hgt3, hc3⟩ := peel_min hne3 g
  set m3 := s3.min' hne3
  set s4 := s3.erase m3 with hs4
  have hs4sub : ∀ p ∈ s4, p ∈ s := fun p hp => hs3sub p (Finset.mem_of_mem_erase hp)
  have hge29 : ∀ p ∈ s4, 29 ≤ p := by
    intro p hp
    have h1 := hgt3 p hp
    have h2 := hge17 m3 hm3
    have h3 := hmod p (hs4sub p hp)
    have h4 : p ≠ 21 := by rintro rfl; have := hprime 21 (hs4sub 21 hp); norm_num at this
    have h5 : p ≠ 25 := by rintro rfl; have := hprime 25 (hs4sub 25 hp); norm_num at this
    omega
  -- step 4
  have hne4 : s4.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e4, hm4, _, hc4⟩ := peel_min hne4 g
  set m4 := s4.min' hne4
  have hs5 : s4.erase m4 = ∅ := Finset.card_eq_zero.mp (by omega)
  rw [hs5, Finset.prod_empty, mul_one] at e4
  rw [e1, e2, e3, e4]
  -- bounds
  have hm1s : m1 ∈ s := hm1
  have hm2s : m2 ∈ s := hs2sub m2 hm2
  have hm3s : m3 ∈ s := hs3sub m3 hm3
  have hm4s : m4 ∈ s := hs4sub m4 hm4
  have b1 : g m1 < 5 / 4 := by
    have := (hg m1 hm1s).trans_le (div_sub_one_anti (by norm_num) (hge5 m1 hm1s))
    norm_num at this; exact this
  have b2 : g m2 < 13 / 12 := by
    have := (hg m2 hm2s).trans_le (div_sub_one_anti (by norm_num) (hge13 m2 hm2))
    norm_num at this; exact this
  have b3 : g m3 < 17 / 16 := by
    have := (hg m3 hm3s).trans_le (div_sub_one_anti (by norm_num) (hge17 m3 hm3))
    norm_num at this; exact this
  have b4 : g m4 < 29 / 28 := by
    have := (hg m4 hm4s).trans_le (div_sub_one_anti (by norm_num) (hge29 m4 hm4))
    norm_num at this; exact this
  have p1 := hg0 m1 hm1s
  have p2 := hg0 m2 hm2s
  have p3 := hg0 m3 hm3s
  have p4 := hg0 m4 hm4s
  have h12 : g m1 * g m2 < 5 / 4 * (13 / 12) := mul_lt_mul'' b1 b2 p1.le p2.le
  have h34 : g m3 * g m4 < 17 / 16 * (29 / 28) := mul_lt_mul'' b3 b4 p3.le p4.le
  calc g m1 * (g m2 * (g m3 * g m4)) = (g m1 * g m2) * (g m3 * g m4) := by ring
    _ < 5 / 4 * (13 / 12) * (17 / 16 * (29 / 28)) :=
        mul_lt_mul'' h12 h34 (by positivity) (by positivity)
    _ = 5 / 4 * (13 / 12) * (17 / 16) * (29 / 28) := by ring

lemma one_le_f {n : ℕ} (hn : n ≠ 0) : 1 ≤ f n := by
  unfold f
  have h := Finset.single_le_sum (f := fun d => (1 : ℚ) / ((σ 1 d : ℕ) : ℚ))
    (fun d _ => by positivity) (Nat.one_mem_divisors.mpr hn)
  simpa using h

/-- **Every solution has `v₂(n) ≥ 21`.** -/
theorem padicValNat_two_ge_twentyone {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    21 ≤ padicValNat 2 n := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h16 := padicValNat_two_mod_sixteen hn hden
  have h5 := five_le_card_primeFactors hn hden
  by_contra hlt
  push_neg at hlt
  have hv5 : padicValNat 2 n = 5 := by omega
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  rw [padicValNat_two_pow_mul_odd hodd] at hv5
  subst hv5
  have hn'1 : 1 < n' := by
    by_contra h
    have h1 : n' = 1 := by omega
    subst h1
    rw [mul_one] at hden
    exact two_pow_not_solution (by norm_num) hden
  have hcop : Nat.Coprime (2 ^ 5) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at h5
  have hB := card_primeFactors_le hodd hn'1 hden
  rw [padicValRat_f_thirtytwo] at hB
  have hcard : n'.primeFactors.card = 4 := by
    have : n'.primeFactors.card ≤ 4 := by exact_mod_cast hB
    omega
  -- valuations
  have hmul : f (2 ^ 5 * n') = f (2 ^ 5) * f n' := f_mul_coprime hcop
  have hpos1 := f_pos (n := 2 ^ 5) (by positivity)
  have hpos2 := f_pos hn'0
  have hK : f (2 ^ 5 * n') = ((f (2 ^ 5 * n')).num : ℚ) := (Rat.coe_int_num_of_den_eq_one hden).symm
  have hnonneg : 0 ≤ padicValRat 2 (f (2 ^ 5 * n')) := by
    rw [hK, padicValRat.of_int]
    unfold padicValInt; positivity
  have hval : padicValRat 2 (f (2 ^ 5 * n')) = 4 + padicValRat 2 (f n') := by
    rw [hmul, padicValRat.mul hpos1.ne' hpos2.ne', padicValRat_f_thirtytwo]
  have hFne : ∀ p ∈ n'.primeFactors, F p (n'.factorization p) ≠ 0 := by
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    rw [← f_prime_pow hpp]
    exact (f_pos (pow_ne_zero _ hpp.ne_zero)).ne'
  have hprod : padicValRat 2 (f n') =
      ∑ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p)) := by
    rw [f_eq_prod hn'0, padicValRat_prod _ _ 2 hFne]
  have hodd_p : ∀ p ∈ n'.primeFactors, p.Prime ∧ Odd p ∧ 1 ≤ n'.factorization p := by
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    refine ⟨hpp, ?_, Nat.Prime.factorization_pos_of_dvd hpp hn'0 (Nat.mem_primeFactors.mp hp).2.1⟩
    rcases hpp.eq_two_or_odd' with rfl | h
    · exfalso
      have : 2 ∣ n' := Nat.dvd_of_mem_primeFactors hp
      exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr this)
    · exact h
  have hle : ∀ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p)) + 1 ≤ 0 := by
    intro p hp
    obtain ⟨hpp, hpo, ha⟩ := hodd_p p hp
    have := padicValRat_F_neg hpp hpo ha
    omega
  have hsum4 : ∑ p ∈ n'.primeFactors, (padicValRat 2 (F p (n'.factorization p)) + 1) = 0 := by
    have h0 : ∑ p ∈ n'.primeFactors, (padicValRat 2 (F p (n'.factorization p)) + 1) ≤ 0 :=
      Finset.sum_nonpos hle
    rw [Finset.sum_add_distrib, Finset.sum_const, hcard] at h0 ⊢
    simp only [nsmul_eq_mul, Nat.cast_ofNat, mul_one] at h0 ⊢
    omega
  have heach := (Finset.sum_eq_zero_iff_of_nonpos hle).mp hsum4
  -- every odd prime factor is ≡ 1 (mod 4)
  have hmod : ∀ p ∈ n'.primeFactors, p % 4 = 1 := by
    intro p hp
    obtain ⟨hpp, hpo, ha⟩ := hodd_p p hp
    have h1 := heach p hp
    rw [padicValRat_F hpp hpo ha] at h1
    have hla : 1 ≤ Nat.log 2 ((n'.factorization p) + 1) :=
      Nat.le_log_of_pow_le (by norm_num) (by omega)
    have hvp : 1 ≤ padicValNat 2 (p + 1) := by
      apply one_le_padicValNat_of_dvd (by omega); obtain ⟨t, ht⟩ := hpo; exact ⟨t + 1, by omega⟩
    have hvp1 : padicValNat 2 (p + 1) = 1 := by omega
    have := pow_succ_padicValNat_not_dvd (p := 2) (show p + 1 ≠ 0 by omega)
    rw [hvp1] at this; norm_num at this
    obtain ⟨t, ht⟩ := hpo; omega
  -- the value is odd, hence ≥ 3
  have hv0 : padicValRat 2 (f (2 ^ 5 * n')) = 0 := by
    rw [hval, hprod]
    have : ∑ p ∈ n'.primeFactors, padicValRat 2 (F p (n'.factorization p)) = -4 := by
      rw [Finset.sum_add_distrib, Finset.sum_const, hcard] at hsum4
      simp only [Nat.cast_ofNat, mul_one, nsmul_eq_mul] at hsum4
      omega
    rw [this]; norm_num
  have hkodd : ¬ 2 ∣ (f (2 ^ 5 * n')).num := by
    intro h2
    rw [hK, padicValRat.of_int] at hv0
    have h2' : (2 : ℤ) ^ 1 ∣ (f (2 ^ 5 * n')).num := by simpa using h2
    have hnum0 : (f (2 ^ 5 * n')).num ≠ 0 := by
      intro h0
      have : f (2 ^ 5 * n') = 0 := by rw [hK, h0]; simp
      have := f_pos (n := 2 ^ 5 * n') (by positivity)
      linarith
    have := (padicValInt_dvd_iff (p := 2) 1 _).mp h2'
    rcases this with h | h
    · exact hnum0 h
    · have : (padicValInt 2 (f (2 ^ 5 * n')).num : ℤ) = 0 := hv0
      omega
  have hk1 : (1 : ℚ) < f (2 ^ 5 * n') := by
    rw [hmul]
    have := one_le_f hn'0
    obtain ⟨hf1, _⟩ := f_two_pow_bounds (a := 5) (by norm_num)
    nlinarith
  have hk3 : (3 : ℚ) ≤ f (2 ^ 5 * n') := by
    rw [hK] at hk1 ⊢
    have h1 : (1 : ℤ) < (f (2 ^ 5 * n')).num := by exact_mod_cast hk1
    have h3 : (3 : ℤ) ≤ (f (2 ^ 5 * n')).num := by omega
    exact_mod_cast h3
  -- size bound
  have hfn' : f n' < 5 / 4 * (13 / 12) * (17 / 16) * (29 / 28) := by
    rw [f_eq_prod hn'0]
    apply prod_four_bound hcard (fun p hp => (hodd_p p hp).1) hmod
    · intro p hp
      have hpp := Nat.prime_of_mem_primeFactors hp
      rw [← f_prime_pow hpp]; exact f_pos (pow_ne_zero _ hpp.ne_zero)
    · intro p hp
      exact F_lt (Nat.prime_of_mem_primeFactors hp)
  rw [hmul, f_two_pow_five] at hk3
  have : (15536 / 9765 : ℚ) * f n' < 15536 / 9765 * (5 / 4 * (13 / 12) * (17 / 16) * (29 / 28)) :=
    mul_lt_mul_of_pos_left hfn' (by norm_num)
  norm_num at this
  linarith

/-- Product lower bound for four distinct odd primes. -/
lemma prod_four_lower {s : Finset ℕ} (hs : s.card = 4)
    (hprime : ∀ p ∈ s, p.Prime) (hodd : ∀ p ∈ s, Odd p) :
    3 * 5 * 7 * 11 ≤ ∏ p ∈ s, p := by
  have hge3 : ∀ p ∈ s, 3 ≤ p := by
    intro p hp
    have := (hprime p hp).two_le
    obtain ⟨t, ht⟩ := hodd p hp
    omega
  have hne1 : s.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e1, hm1, hgt1, hc1⟩ := peel_min hne1 (fun p => (p : ℚ))
  set m1 := s.min' hne1
  set s2 := s.erase m1 with hs2
  have hs2sub : ∀ p ∈ s2, p ∈ s := fun p hp => Finset.mem_of_mem_erase hp
  have hge5 : ∀ p ∈ s2, 5 ≤ p := by
    intro p hp
    have h1 := hgt1 p hp
    have h2 := hge3 m1 hm1
    obtain ⟨t, ht⟩ := hodd p (hs2sub p hp)
    omega
  have hne2 : s2.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e2, hm2, hgt2, hc2⟩ := peel_min hne2 (fun p => (p : ℚ))
  set m2 := s2.min' hne2
  set s3 := s2.erase m2 with hs3
  have hs3sub : ∀ p ∈ s3, p ∈ s := fun p hp => hs2sub p (Finset.mem_of_mem_erase hp)
  have hge7 : ∀ p ∈ s3, 7 ≤ p := by
    intro p hp
    have h1 := hgt2 p hp
    have h2 := hge5 m2 hm2
    obtain ⟨t, ht⟩ := hodd p (hs3sub p hp)
    omega
  have hne3 : s3.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e3, hm3, hgt3, hc3⟩ := peel_min hne3 (fun p => (p : ℚ))
  set m3 := s3.min' hne3
  set s4 := s3.erase m3 with hs4
  have hs4sub : ∀ p ∈ s4, p ∈ s := fun p hp => hs3sub p (Finset.mem_of_mem_erase hp)
  have hge11 : ∀ p ∈ s4, 11 ≤ p := by
    intro p hp
    have h1 := hgt3 p hp
    have h2 := hge7 m3 hm3
    obtain ⟨t, ht⟩ := hodd p (hs4sub p hp)
    have h4 : p ≠ 9 := by rintro rfl; have := hprime 9 (hs4sub 9 hp); norm_num at this
    omega
  have hne4 : s4.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨e4, hm4, _, hc4⟩ := peel_min hne4 (fun p => (p : ℚ))
  set m4 := s4.min' hne4
  have hs5 : s4.erase m4 = ∅ := Finset.card_eq_zero.mp (by omega)
  rw [hs5, Finset.prod_empty, mul_one] at e4
  have hq : ((∏ p ∈ s, p : ℕ) : ℚ) = (m1 : ℚ) * ((m2 : ℚ) * ((m3 : ℚ) * (m4 : ℚ))) := by
    push_cast
    rw [e1, e2, e3, e4]
  have hm1q : (3 : ℚ) ≤ m1 := by exact_mod_cast hge3 m1 hm1
  have hm2q : (5 : ℚ) ≤ m2 := by exact_mod_cast hge5 m2 hm2
  have hm3q : (7 : ℚ) ≤ m3 := by exact_mod_cast hge7 m3 hm3
  have hm4q : (11 : ℚ) ≤ m4 := by exact_mod_cast hge11 m4 hm4
  have : ((3 * 5 * 7 * 11 : ℕ) : ℚ) ≤ ((∏ p ∈ s, p : ℕ) : ℚ) := by
    rw [hq]; push_cast
    have h34 : (7 : ℚ) * 11 ≤ (m3 : ℚ) * m4 := mul_le_mul hm3q hm4q (by norm_num) (by linarith)
    have h234 : (5 : ℚ) * (7 * 11) ≤ (m2 : ℚ) * ((m3 : ℚ) * m4) :=
      mul_le_mul hm2q h34 (by norm_num) (by linarith)
    have := mul_le_mul hm1q h234 (by norm_num) (by linarith)
    linarith
  exact_mod_cast this

/-- **Explicit lower bound.**  Any solution `n > 1` satisfies `n ≥ 2^21 · 3 · 5 · 7 · 11`. -/
theorem solution_ge {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    2 ^ 21 * (3 * 5 * 7 * 11) ≤ n := by
  have h21 := padicValNat_two_ge_twentyone hn hden
  have h5 := five_le_card_primeFactors hn hden
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  rw [padicValNat_two_pow_mul_odd hodd] at h21
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at h5
  obtain ⟨t, hts, htc⟩ := Finset.exists_subset_card_eq (show 4 ≤ n'.primeFactors.card by omega)
  have hprime : ∀ p ∈ t, p.Prime := fun p hp => Nat.prime_of_mem_primeFactors (hts hp)
  have hoddp : ∀ p ∈ t, Odd p := by
    intro p hp
    exact Odd.of_dvd_nat hodd (Nat.dvd_of_mem_primeFactors (hts hp))
  have h1 := prod_four_lower htc hprime hoddp
  have h2 : ∏ p ∈ t, p ≤ ∏ p ∈ n'.primeFactors, p :=
    Finset.prod_le_prod_of_subset_of_one_le' hts
      (fun p hp _ => (Nat.prime_of_mem_primeFactors hp).one_lt.le)
  have h3 : ∏ p ∈ n'.primeFactors, p ≤ n' :=
    Nat.le_of_dvd (Nat.pos_of_ne_zero hn'0) (Nat.prod_primeFactors_dvd n')
  have h4 : 2 ^ 21 ≤ 2 ^ v := Nat.pow_le_pow_right (by norm_num) h21
  calc 2 ^ 21 * (3 * 5 * 7 * 11) ≤ 2 ^ v * n' :=
        Nat.mul_le_mul h4 (le_trans h1 (le_trans h2 h3))

/- ### An `ℓ`-adic constraint from the primes dividing `2^j - 1`

If `ℓ` is a prime such that, among `1 ≤ i ≤ v + 1`, `ℓ ∣ 2^i - 1` happens exactly for `i = j`
(e.g. `ℓ` a primitive prime divisor of `2^j - 1` with `(v+1)/2 < j ≤ v+1`), then
`v_ℓ (f (2^v)) < 0`, so some odd prime factor `p` of a solution must have `v_ℓ (F p a) > 0`. -/

lemma padicValRat_two_pow_sub_one_eq_zero {ℓ i : ℕ} [Fact ℓ.Prime] (h : ¬ ℓ ∣ 2 ^ i - 1) :
    padicValRat ℓ ((2 : ℚ) ^ i - 1) = 0 := by
  have h1 : (2 : ℚ) ^ i - 1 = ((2 ^ i - 1 : ℕ) : ℚ) := by
    rw [Nat.cast_sub Nat.one_le_two_pow]; push_cast; ring
  rw [h1, ← padicValRat_of_nat, padicValNat.eq_zero_of_not_dvd h]
  simp

lemma padicValRat_two_pow_sub_one_pos {ℓ i : ℕ} [Fact ℓ.Prime] (hi : 1 ≤ i) (h : ℓ ∣ 2 ^ i - 1) :
    0 < padicValRat ℓ ((2 : ℚ) ^ i - 1) := by
  have h1 : (2 : ℚ) ^ i - 1 = ((2 ^ i - 1 : ℕ) : ℚ) := by
    rw [Nat.cast_sub Nat.one_le_two_pow]; push_cast; ring
  rw [h1, ← padicValRat_of_nat]
  have hne : 2 ^ i - 1 ≠ 0 := by
    have : 2 ≤ 2 ^ i := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ i := Nat.pow_le_pow_right (by norm_num) hi
    omega
  have := one_le_padicValNat_of_dvd hne h
  exact_mod_cast this

/-- If `ℓ ∣ 2^i - 1` (for `1 ≤ i ≤ v+1`) exactly when `i = j`, then `v_ℓ (f (2^v)) < 0`. -/
theorem padicValRat_f_two_pow_neg_of_unique {v ℓ j : ℕ} [Fact ℓ.Prime]
    (hj1 : 1 ≤ j) (hjv : j ≤ v + 1)
    (hord : ∀ i, 1 ≤ i → i ≤ v + 1 → (ℓ ∣ 2 ^ i - 1 ↔ i = j)) :
    padicValRat ℓ (f (2 ^ v)) < 0 := by
  rw [f_two_pow_eq_sum]
  have hterm : ∀ b, padicValRat ℓ (1 / ((2 : ℚ) ^ (b + 1) - 1)) =
      -padicValRat ℓ ((2 : ℚ) ^ (b + 1) - 1) := by
    intro b
    rw [one_div, padicValRat.inv]
  rw [padicValRat_sum_eq_of_unique_min (range (v + 1)) _ (j - 1)
    (Finset.mem_range.mpr (by omega))
    (fun b _ => by have := two_pow_sub_one_pos' b; positivity)]
  · rw [hterm, Nat.sub_add_cancel hj1]
    have := padicValRat_two_pow_sub_one_pos (ℓ := ℓ) hj1 ((hord j hj1 hjv).mpr rfl)
    linarith
  · intro b hb hne
    rw [hterm, hterm, Nat.sub_add_cancel hj1]
    have hb' := Finset.mem_range.mp hb
    have hnot : ¬ ℓ ∣ 2 ^ (b + 1) - 1 := by
      intro h
      have := (hord (b + 1) (by omega) (by omega)).mp h
      omega
    rw [padicValRat_two_pow_sub_one_eq_zero hnot]
    have := padicValRat_two_pow_sub_one_pos (ℓ := ℓ) hj1 ((hord j hj1 hjv).mpr rfl)
    linarith

/-- **`ℓ`-adic constraint.**  Let `n = 2^v * n'` be a solution and `ℓ` a prime such that, for
`1 ≤ i ≤ v + 1`, `ℓ ∣ 2^i - 1` holds exactly for `i = j`.  Then some odd prime factor `p` of `n`
satisfies `v_ℓ (F p (v_p n)) > 0`, i.e. `ℓ` divides the numerator of `∑_{b ≤ v_p n} 1/σ(p^b)`. -/
theorem exists_padicValRat_F_pos {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) {ℓ j : ℕ}
    [Fact ℓ.Prime] (hj1 : 1 ≤ j) (hjv : j ≤ padicValNat 2 n + 1)
    (hord : ∀ i, 1 ≤ i → i ≤ padicValNat 2 n + 1 → (ℓ ∣ 2 ^ i - 1 ↔ i = j)) :
    ∃ p ∈ n.primeFactors, p ≠ 2 ∧ 0 < padicValRat ℓ (F p (n.factorization p)) := by
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  rw [padicValNat_two_pow_mul_odd hodd] at hjv hord
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hmul : f (2 ^ v * n') = f (2 ^ v) * f n' := f_mul_coprime hcop
  have hpos1 := f_pos (n := 2 ^ v) (by positivity)
  have hpos2 := f_pos hn'0
  have hK : f (2 ^ v * n') = ((f (2 ^ v * n')).num : ℚ) :=
    (Rat.coe_int_num_of_den_eq_one hden).symm
  have hnonneg : 0 ≤ padicValRat ℓ (f (2 ^ v * n')) := by
    rw [hK, padicValRat.of_int]
    unfold padicValInt; positivity
  have hneg := padicValRat_f_two_pow_neg_of_unique (v := v) (ℓ := ℓ) hj1 hjv hord
  have hval : padicValRat ℓ (f (2 ^ v * n')) = padicValRat ℓ (f (2 ^ v)) + padicValRat ℓ (f n') := by
    rw [hmul, padicValRat.mul hpos1.ne' hpos2.ne']
  have hn'pos : 0 < padicValRat ℓ (f n') := by linarith
  have hFne : ∀ p ∈ n'.primeFactors, F p (n'.factorization p) ≠ 0 := by
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    rw [← f_prime_pow hpp]
    exact (f_pos (pow_ne_zero _ hpp.ne_zero)).ne'
  rw [f_eq_prod hn'0, padicValRat_prod _ _ ℓ hFne] at hn'pos
  by_contra hcon
  push_neg at hcon
  have hle : ∀ p ∈ n'.primeFactors, padicValRat ℓ (F p (n'.factorization p)) ≤ 0 := by
    intro p hp
    have hpm : p ∈ (2 ^ v * n').primeFactors := by
      rw [Nat.primeFactors_mul (by positivity) hn'0]
      exact Finset.mem_union_right _ hp
    have hp2 : p ≠ 2 := by
      rintro rfl
      have : 2 ∣ n' := Nat.dvd_of_mem_primeFactors hp
      exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr this)
    have hfac : (2 ^ v * n').factorization p = n'.factorization p := by
      rw [Nat.factorization_mul (by positivity) hn'0, Finsupp.add_apply,
        Nat.Prime.factorization_pow Nat.prime_two, Finsupp.single_apply]
      simp [Ne.symm hp2]
    have := hcon p hpm hp2
    rw [hfac] at this
    exact this
  have := Finset.sum_nonpos hle
  linarith

/-- The same constraint phrased with the multiplicative order of `2` modulo `ℓ`: if
`(v₂(n)+1)/2 < ord_ℓ(2) ≤ v₂(n)+1` then `ℓ` divides the numerator of some `F p (v_p n)`,
`p` an odd prime factor of `n`. -/
theorem exists_padicValRat_F_pos_of_orderOf {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) {ℓ : ℕ}
    [Fact ℓ.Prime] (hlt : padicValNat 2 n + 1 < 2 * orderOf (2 : ZMod ℓ))
    (hle : orderOf (2 : ZMod ℓ) ≤ padicValNat 2 n + 1) :
    ∃ p ∈ n.primeFactors, p ≠ 2 ∧ 0 < padicValRat ℓ (F p (n.factorization p)) := by
  haveI : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
  apply exists_padicValRat_F_pos hn hden (j := orderOf (2 : ZMod ℓ)) (by omega) hle
  intro i hi1 hiv
  have hcast : ((2 ^ i - 1 : ℕ) : ZMod ℓ) = (2 : ZMod ℓ) ^ i - 1 := by
    rw [Nat.cast_sub Nat.one_le_two_pow]; push_cast; ring
  rw [← ZMod.natCast_eq_zero_iff, hcast, sub_eq_zero, ← orderOf_dvd_iff_pow_eq_one]
  constructor
  · rintro ⟨m, hm⟩
    have hm1 : m ≠ 0 := by rintro rfl; omega
    have hm2 : m < 2 := by
      by_contra h
      push_neg at h
      have : 2 * orderOf (2 : ZMod ℓ) ≤ orderOf (2 : ZMod ℓ) * m := by nlinarith
      omega
    have : m = 1 := by omega
    subst this; omega
  · rintro rfl; exact dvd_rfl



/- ### Excluding `v₂(f(2^v)) ≤ 5`: every solution has `v₂(n) ≡ 53 (mod 64)` -/

/-! ### Finer windows for `f (2^v)` -/

lemma one_div_two_pow_sub_one_ge (v : ℕ) :
    1 / (2 : ℚ) ^ (v + 2) ≤ 1 / ((2 ^ (v + 2) - 1 : ℕ) : ℚ) := by
  have hpos := two_pow_sub_one_pos v
  apply one_div_le_one_div_of_le hpos
  have h : 2 ^ (v + 2) - 1 ≤ 2 ^ (v + 2) := Nat.sub_le _ _
  have h2 : ((2 ^ (v + 2) - 1 : ℕ) : ℚ) ≤ ((2 ^ (v + 2) : ℕ) : ℚ) := by exact_mod_cast h
  push_cast at h2
  exact h2

lemma one_div_two_pow_sub_one_le (v : ℕ) :
    1 / ((2 ^ (v + 2) - 1 : ℕ) : ℚ) ≤ 1 / (2 : ℚ) ^ (v + 2) + 1 / (2 : ℚ) ^ (2 * v + 3) := by
  have h1 : 1 < 2 ^ (v + 2) := Nat.one_lt_two_pow (by omega)
  have hcast : ((2 ^ (v + 2) - 1 : ℕ) : ℚ) = (2 : ℚ) ^ (v + 2) - 1 := by
    rw [Nat.cast_sub h1.le]; push_cast; ring
  rw [hcast]
  have hx : (4 : ℚ) ≤ (2 : ℚ) ^ (v + 2) := by
    have : (2 : ℚ) ^ 2 ≤ (2 : ℚ) ^ (v + 2) := pow_le_pow_right₀ (by norm_num) (by omega)
    norm_num at this; exact this
  have hy : (2 : ℚ) ^ (2 * v + 3) = 2 ^ (v + 2) * 2 ^ (v + 2) / 2 := by
    rw [← pow_add]; rw [show v + 2 + (v + 2) = 2 * v + 3 + 1 by ring, pow_succ]; ring
  rw [hy]
  set y := (2 : ℚ) ^ (v + 2) with hy'
  have hy0 : 0 < y := by positivity
  have hy1 : 0 < y - 1 := by linarith
  rw [div_add_div _ _ hy0.ne' (by positivity), div_le_div_iff₀ hy1 (by positivity)]
  nlinarith

/-- Lower bound: `f (2^v) ≥ f (2^v₀) + 2^{-(v₀+1)} - 2^{-(v+1)}`. -/
lemma f_two_pow_lower {v₀ v : ℕ} (hv : v₀ ≤ v) :
    f (2 ^ v₀) + (1 / (2 : ℚ) ^ (v₀ + 1) - 1 / (2 : ℚ) ^ (v + 1)) ≤ f (2 ^ v) := by
  induction v, hv using Nat.le_induction with
  | base => simp
  | succ v _ ih =>
    rw [f_two_pow_succ]
    have h1 := one_div_two_pow_sub_one_ge v
    have h3 : (1 : ℚ) / 2 ^ (v + 2) = 1 / 2 ^ (v + 1) - 1 / 2 ^ (v + 1 + 1) := by
      rw [pow_succ (2 : ℚ) (v + 1)]; field_simp; ring
    linarith

/-- Refined upper tail bound. -/
lemma f_two_pow_tail_fine {v₀ v : ℕ} (hv : v₀ ≤ v) :
    f (2 ^ v) ≤ f (2 ^ v₀) + (1 / (2 : ℚ) ^ (v₀ + 1) - 1 / (2 : ℚ) ^ (v + 1)) +
      2 / 3 * (1 / (4 : ℚ) ^ (v₀ + 1) - 1 / (4 : ℚ) ^ (v + 1)) := by
  induction v, hv using Nat.le_induction with
  | base => simp
  | succ v _ ih =>
    rw [f_two_pow_succ]
    have h1 := one_div_two_pow_sub_one_le v
    have h3 : (1 : ℚ) / 2 ^ (v + 2) = 1 / 2 ^ (v + 1) - 1 / 2 ^ (v + 1 + 1) := by
      rw [pow_succ (2 : ℚ) (v + 1)]; field_simp; try ring
    have h4 : (1 : ℚ) / 2 ^ (2 * v + 3) = 2 / 3 * (1 / 4 ^ (v + 1) - 1 / 4 ^ (v + 1 + 1)) := by
      have e : (4 : ℚ) ^ (v + 1) = 2 ^ (2 * v + 2) := by
        rw [show (4 : ℚ) = 2 ^ 2 by norm_num, ← pow_mul]; ring_nf
      have e2 : (4 : ℚ) ^ (v + 1 + 1) = 2 ^ (2 * v + 2) * 4 := by
        rw [pow_succ, e]
      rw [e, e2, show (2 : ℚ) ^ (2 * v + 3) = 2 ^ (2 * v + 2) * 2 by rw [pow_succ]]
      field_simp; ring
    linarith

lemma f_two_pow_thirtytwo_lower {v : ℕ} (hv : 53 ≤ v) :
    (1606695152415291708267632 : ℚ) / 10 ^ 24 ≤ f (2 ^ v) := by
  have h := f_two_pow_lower (v₀ := 32) (by omega : 32 ≤ v)
  have h2 : (1 : ℚ) / 2 ^ (v + 1) ≤ 1 / 2 ^ 54 := by
    apply one_div_le_one_div_of_le (by positivity)
    exact pow_le_pow_right₀ (by norm_num) (by omega)
  rw [f_two_pow_thirtytwo] at h
  have h3 : (1606695152415291708267632 : ℚ) / 10 ^ 24 ≤
      89739037070311544120455579155358762680789706904173956436784397952754625283684634362387575827657731575803 / 55853182193219404047133007451250142910766565346768932645293066884541700793030887454305699594017500648975 + (1 / (2 : ℚ) ^ (32 + 1) - 1 / 2 ^ 54) := by
    norm_num
  linarith

lemma f_two_pow_lt_H85 (v : ℕ) :
    f (2 ^ v) < (1606695152415291763787820 : ℚ) / 10 ^ 24 := by
  have key : f (2 ^ 32) + 1 / (2 : ℚ) ^ (32 + 1) + 2 / 3 * (1 / (4 : ℚ) ^ (32 + 1)) <
      (1606695152415291763787820 : ℚ) / 10 ^ 24 := by
    rw [f_two_pow_thirtytwo]; norm_num
  rcases le_or_gt 32 v with h | h
  · have := f_two_pow_tail_fine h
    have h1 : (0 : ℚ) < 1 / (2 : ℚ) ^ (v + 1) := by positivity
    have h2 : (0 : ℚ) < 1 / (4 : ℚ) ^ (v + 1) := by positivity
    linarith
  · have h32 : f (2 ^ 32) < (1606695152415291763787820 : ℚ) / 10 ^ 24 := by
      rw [f_two_pow_thirtytwo]; norm_num
    exact lt_of_le_of_lt (f_two_pow_mono h.le) h32

/- ### Explicit forms of `Fq` -/

lemma Fq_one_eq (x : ℚ) : Fq x 1 = 1 + 1 / (1 + x) := by
  simp [Fq, Finset.sum_range_succ]

lemma Fq_two_eq (x : ℚ) : Fq x 2 = 1 + 1 / (1 + x) + 1 / (1 + x + x ^ 2) := by
  simp [Fq, Finset.sum_range_succ]

lemma F_le_Fq_two {x e X : ℕ} (hx : x.Prime) (he : e ≤ 2) (hX : 1 ≤ X) (hXx : X ≤ x) :
    F x e ≤ Fq (X : ℚ) 2 :=
  (F_mono hx he).trans (F_upper_exact hx hX hXx)

/- ### Box lemmas for four odd primes -/

lemma box4_below {v : ℕ} {F1 F2 F3 F4 hi1 hi2 hi3 hi4 H : ℚ} (hH : f (2 ^ v) < H)
    (h : f (2 ^ v) * (F1 * F2 * F3 * F4) = 2)
    (h1 : F1 ≤ hi1) (h2 : F2 ≤ hi2) (h3 : F3 ≤ hi3) (h4 : F4 ≤ hi4)
    (hF1 : 0 < F1) (hF2 : 0 < F2) (hF3 : 0 < F3) (hF4 : 0 < F4)
    (hw : H * (hi1 * hi2 * hi3 * hi4) ≤ 2) : False := by
  have hG : F1 * F2 * F3 * F4 ≤ hi1 * hi2 * hi3 * hi4 := by
    have a1 : F1 * F2 ≤ hi1 * hi2 := mul_le_mul h1 h2 hF2.le (by linarith)
    have a2 : F1 * F2 * F3 ≤ hi1 * hi2 * hi3 :=
      mul_le_mul a1 h3 hF3.le (mul_nonneg (by linarith) (by linarith))
    exact mul_le_mul a2 h4 hF4.le (mul_nonneg (mul_nonneg (by linarith) (by linarith)) (by linarith))
  have hpos : 0 < F1 * F2 * F3 * F4 := by positivity
  have e1 : f (2 ^ v) * (F1 * F2 * F3 * F4) < H * (F1 * F2 * F3 * F4) :=
    mul_lt_mul_of_pos_right hH hpos
  have hH0 : 0 < H := lt_trans (f_pos (by positivity)) hH
  have e2 : H * (F1 * F2 * F3 * F4) ≤ H * (hi1 * hi2 * hi3 * hi4) :=
    mul_le_mul_of_nonneg_left hG hH0.le
  linarith

lemma box4_above {v : ℕ} {F1 F2 F3 F4 lo1 lo2 lo3 lo4 L : ℚ} (hL : L ≤ f (2 ^ v))
    (h : f (2 ^ v) * (F1 * F2 * F3 * F4) = 2)
    (h1 : lo1 ≤ F1) (h2 : lo2 ≤ F2) (h3 : lo3 ≤ F3) (h4 : lo4 ≤ F4)
    (hlo1 : 0 ≤ lo1) (hlo2 : 0 ≤ lo2) (hlo3 : 0 ≤ lo3) (hlo4 : 0 ≤ lo4)
    (hw : 2 < L * (lo1 * lo2 * lo3 * lo4)) : False := by
  have hG : lo1 * lo2 * lo3 * lo4 ≤ F1 * F2 * F3 * F4 := by
    have a1 : lo1 * lo2 ≤ F1 * F2 := mul_le_mul h1 h2 hlo2 (by linarith)
    have a2 : lo1 * lo2 * lo3 ≤ F1 * F2 * F3 :=
      mul_le_mul a1 h3 hlo3 (mul_nonneg (by linarith) (by linarith))
    exact mul_le_mul a2 h4 hlo4 (mul_nonneg (mul_nonneg (by linarith) (by linarith)) (by linarith))
  have hf := f_pos (n := 2 ^ v) (by positivity)
  have e1 : L * (lo1 * lo2 * lo3 * lo4) ≤ f (2 ^ v) * (lo1 * lo2 * lo3 * lo4) :=
    mul_le_mul_of_nonneg_right hL (by positivity)
  have e2 : f (2 ^ v) * (lo1 * lo2 * lo3 * lo4) ≤ f (2 ^ v) * (F1 * F2 * F3 * F4) :=
    mul_le_mul_of_nonneg_left hG hf.le
  linarith

/-- Range for the last factor: from `f (2^v) * (B * Fs) = 2` and `L ≤ f (2^v) < H`. -/
lemma Fs_range {v : ℕ} {B Fs L H : ℚ} (hL : L ≤ f (2 ^ v)) (hH : f (2 ^ v) < H)
    (h : f (2 ^ v) * (B * Fs) = 2) (hB : 0 < B) (hL0 : 0 < L) :
    2 / (H * B) < Fs ∧ Fs ≤ 2 / (L * B) := by
  have hf : 0 < f (2 ^ v) := f_pos (by positivity)
  have hH0 : 0 < H := lt_trans hf hH
  have hFs : Fs = 2 / (f (2 ^ v) * B) := by
    rw [eq_div_iff (by positivity)]; linarith [h]
  constructor
  · rw [hFs]
    apply div_lt_div_of_pos_left (by norm_num) (by positivity)
    exact mul_lt_mul_of_pos_right hH hB
  · rw [hFs]
    apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
    exact mul_le_mul_of_nonneg_right hL hB.le

