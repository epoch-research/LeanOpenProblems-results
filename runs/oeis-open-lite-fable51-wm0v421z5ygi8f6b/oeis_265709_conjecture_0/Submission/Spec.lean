/-- **Corollary.**  Every solution has `v₂(n) ≡ 53 (mod 64)`, in particular `v₂(n) ≥ 53`. -/
theorem padicValNat_two_mod_sixtyfour {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    padicValNat 2 n % 64 = 53 := by
  have h6 := six_le_padicValRat_of_solution hn hden
  have h21 := padicValNat_two_ge_twentyone hn hden
  have hdvd := two_pow_dvd_D h6
  have hmod : padicValNat 2 n + 1 + D (padicValNat 2 n) 6 ≡ padicValNat 2 n + 1 + S 6 [MOD 2 ^ 6] :=
    (D_modEq_S (by omega)).add_left _
  have h2 : 2 ^ 6 ∣ padicValNat 2 n + 1 + S 6 :=
    (Nat.modEq_zero_iff_dvd).mp (hmod.symm.trans (Nat.modEq_zero_iff_dvd.mpr hdvd))
  have hS6 : S 6 = 138 := by
    simp [S, Finset.sum_range_succ, sigma_zero_apply]
    decide
  rw [hS6] at h2
  norm_num at h2
  omega

