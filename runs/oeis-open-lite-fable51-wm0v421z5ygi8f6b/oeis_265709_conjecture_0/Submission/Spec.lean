    linarith
  · have h1 := f_two_pow_mono h.le
    have h3 : f (2 ^ 32) < (16066951527 : ℚ) / 10 ^ 10 := by
      rw [f_two_pow_thirtytwo]; norm_num
    exact lt_of_le_of_lt h1 h3

/-- `F` with the prime replaced by an arbitrary rational (via `σ(p^b) = ∑_{i ≤ b} p^i`). -/
noncomputable def Fq (x : ℚ) (c : ℕ) : ℚ := ∑ b ∈ range (c + 1), 1 / (∑ i ∈ range (b + 1), x ^ i)

lemma F_eq_Fq {p : ℕ} (hp : p.Prime) (c : ℕ) : F p c = Fq (p : ℚ) c := F_eval hp c

lemma geom_pos {x : ℚ} (hx : 0 < x) (b : ℕ) : 0 < ∑ i ∈ range (b + 1), x ^ i :=
  Finset.sum_pos (fun i _ => pow_pos hx i) ⟨0, by simp⟩

/-- `Fq x c` is antitone in `x` on `x ≥ 1`. -/
lemma Fq_anti {x y : ℚ} (hx : 1 ≤ x) (hxy : x ≤ y) (c : ℕ) : Fq y c ≤ Fq x c := by
  unfold Fq
  apply Finset.sum_le_sum
  intro b _
  apply one_div_le_one_div_of_le (geom_pos (by linarith) b)
  apply Finset.sum_le_sum
  intro i _
  exact pow_le_pow_left₀ (by linarith) hxy i

lemma F_lower_range {r r2 c1 c : ℕ} (hr : r.Prime) (hrr : r ≤ r2) (hc : c1 ≤ c) :
    Fq (r2 : ℚ) c1 ≤ F r c := by
  have h1 : F r c1 ≤ F r c := F_mono hr hc
  rw [F_eq_Fq hr] at h1
  refine le_trans (Fq_anti ?_ ?_ c1) h1
  · exact_mod_cast hr.one_lt.le
  · exact_mod_cast hrr

lemma F_upper_exact {r r1 c : ℕ} (hr : r.Prime) (h1 : 1 ≤ r1) (hrr : r1 ≤ r) :
    F r c ≤ Fq (r1 : ℚ) c := by
  rw [F_eq_Fq hr]
  exact Fq_anti (by exact_mod_cast h1) (by exact_mod_cast hrr) c

lemma F_upper_range {r r1 c1 c : ℕ} (hr : r.Prime) (h2 : 2 ≤ r1) (hrr : r1 ≤ r) :
    F r c ≤ Fq (r1 : ℚ) c1 + 1 / ((r1 : ℚ) ^ c1 * ((r1 : ℚ) - 1)) := by
  have h1 : F r c ≤ Fq (r : ℚ) c1 + 1 / ((r : ℚ) ^ c1 * ((r : ℚ) - 1)) := by
    have := F_le_all hr c1 c
    rwa [F_eq_Fq hr c1] at this
  have hr1q : (2 : ℚ) ≤ r1 := by exact_mod_cast h2
  have hrrq : (r1 : ℚ) ≤ r := by exact_mod_cast hrr
  have h3 : Fq (r : ℚ) c1 ≤ Fq (r1 : ℚ) c1 := Fq_anti (by linarith) hrrq c1
  have h4 : 1 / ((r : ℚ) ^ c1 * ((r : ℚ) - 1)) ≤ 1 / ((r1 : ℚ) ^ c1 * ((r1 : ℚ) - 1)) := by
    apply one_div_le_one_div_of_le
    · apply mul_pos (by positivity); linarith
    · apply mul_le_mul (pow_le_pow_left₀ (by linarith) hrrq c1) (by linarith) (by linarith)
        (by positivity)
  linarith

/-- Three-factor box lemma: the product is too large. -/
lemma box3_above {v : ℕ} {F1 F2 F3 lo1 lo2 lo3 L k : ℚ} (hL : L ≤ f (2 ^ v))
    (h : f (2 ^ v) * (F1 * F2 * F3) = k)
    (h1 : lo1 ≤ F1) (h2 : lo2 ≤ F2) (h3 : lo3 ≤ F3)
    (hlo1 : 0 ≤ lo1) (hlo2 : 0 ≤ lo2) (hlo3 : 0 ≤ lo3)
    (hw : k < L * (lo1 * lo2 * lo3)) : False := by
  have hG : lo1 * lo2 * lo3 ≤ F1 * F2 * F3 :=
    mul_le_mul (mul_le_mul h1 h2 hlo2 (by linarith)) h3 hlo3 (mul_nonneg (by linarith) (by linarith))
  have hf := f_pos (n := 2 ^ v) (by positivity)
  have e1 : L * (lo1 * lo2 * lo3) ≤ f (2 ^ v) * (lo1 * lo2 * lo3) :=
    mul_le_mul_of_nonneg_right hL (mul_nonneg (mul_nonneg hlo1 hlo2) hlo3)
  have e2 : f (2 ^ v) * (lo1 * lo2 * lo3) ≤ f (2 ^ v) * (F1 * F2 * F3) :=
    mul_le_mul_of_nonneg_left hG hf.le
  linarith

/-- Three-factor box lemma: the product is too small. -/
lemma box3_below {v : ℕ} {F1 F2 F3 hi1 hi2 hi3 H k : ℚ} (hH : f (2 ^ v) < H)
    (h : f (2 ^ v) * (F1 * F2 * F3) = k)
    (h1 : F1 ≤ hi1) (h2 : F2 ≤ hi2) (h3 : F3 ≤ hi3)
    (hF1 : 0 < F1) (hF2 : 0 < F2) (hF3 : 0 < F3)
    (hw : H * (hi1 * hi2 * hi3) ≤ k) : False := by
  have hG : F1 * F2 * F3 ≤ hi1 * hi2 * hi3 :=
    mul_le_mul (mul_le_mul h1 h2 hF2.le (by linarith)) h3 hF3.le (mul_nonneg (by linarith) (by linarith))
  have hpos : 0 < F1 * F2 * F3 := mul_pos (mul_pos hF1 hF2) hF3
  have e1 : f (2 ^ v) * (F1 * F2 * F3) < H * (F1 * F2 * F3) :=
    mul_lt_mul_of_pos_right hH hpos
  have hH0 : 0 < H := lt_trans (f_pos (by positivity)) hH
  have e2 : H * (F1 * F2 * F3) ≤ H * (hi1 * hi2 * hi3) :=
    mul_le_mul_of_nonneg_left hG hH0.le
  linarith

/-- Exact 2-adic valuation of `f (2^v * (p^a * q^b * r^c))`. -/
lemma padicValRat_f_four {v p a q b r c : ℕ} (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hpo : Odd p) (hqo : Odd q) (hro : Odd r) (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    padicValRat 2 (f (2 ^ v * (p ^ a * q ^ b * r ^ c))) =
      padicValRat 2 (f (2 ^ v)) + padicValRat 2 (F p a) + padicValRat 2 (F q b)
        + padicValRat 2 (F r c) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hodd : Odd (p ^ a * q ^ b * r ^ c) := (hpo.pow.mul hqo.pow).mul hro.pow
  have hcop : Nat.Coprime (2 ^ v) (p ^ a * q ^ b * r ^ c) := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hcop2 : Nat.Coprime (p ^ a) (q ^ b) := ((Nat.coprime_primes hp hq).mpr hpq).pow a b
  have hcop3 : Nat.Coprime (p ^ a * q ^ b) (r ^ c) :=
    Nat.Coprime.mul_left (((Nat.coprime_primes hp hr).mpr hpr).pow a c)
      (((Nat.coprime_primes hq hr).mpr hqr).pow b c)
  rw [f_mul_coprime hcop, f_mul_coprime hcop3, f_mul_coprime hcop2, f_prime_pow hp,
    f_prime_pow hq, f_prime_pow hr]
  have h1 := f_pos (n := 2 ^ v) (by positivity)
  have h2 : 0 < F p a := by rw [← f_prime_pow hp]; exact f_pos (pow_ne_zero _ hp.ne_zero)
  have h3 : 0 < F q b := by rw [← f_prime_pow hq]; exact f_pos (pow_ne_zero _ hq.ne_zero)
  have h4 : 0 < F r c := by rw [← f_prime_pow hr]; exact f_pos (pow_ne_zero _ hr.ne_zero)
  rw [padicValRat.mul h1.ne' (by positivity), padicValRat.mul (by positivity) h4.ne',
    padicValRat.mul h2.ne' h3.ne']
  ring

lemma f_mul_three {v p a q b r c : ℕ} (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
    (hpo : Odd p) (hqo : Odd q) (hro : Odd r) (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) :
    f (2 ^ v * (p ^ a * q ^ b * r ^ c)) = f (2 ^ v) * (F p a * F q b * F r c) := by
  have hodd : Odd (p ^ a * q ^ b * r ^ c) := (hpo.pow.mul hqo.pow).mul hro.pow
  have hcop : Nat.Coprime (2 ^ v) (p ^ a * q ^ b * r ^ c) := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  have hcop2 : Nat.Coprime (p ^ a) (q ^ b) := ((Nat.coprime_primes hp hq).mpr hpq).pow a b
  have hcop3 : Nat.Coprime (p ^ a * q ^ b) (r ^ c) :=
    Nat.Coprime.mul_left (((Nat.coprime_primes hp hr).mpr hpr).pow a c)
      (((Nat.coprime_primes hq hr).mpr hqr).pow b c)
  rw [f_mul_coprime hcop, f_mul_coprime hcop3, f_mul_coprime hcop2, f_prime_pow hp,
    f_prime_pow hq, f_prime_pow hr]

lemma eq_three_prime_pows_of_card_eq_three {n : ℕ} (hn : n ≠ 0)
    (h : n.primeFactors.card = 3) :
    ∃ p q r a b c : ℕ, p.Prime ∧ q.Prime ∧ r.Prime ∧ p < q ∧ q < r ∧ 1 ≤ a ∧ 1 ≤ b ∧ 1 ≤ c ∧
      n = p ^ a * q ^ b * r ^ c := by
  obtain ⟨p, q, r, hpq, hpr, hqr, hs⟩ := Finset.card_eq_three.mp h
  have hpm : p ∈ n.primeFactors := by rw [hs]; simp
  have hqm : q ∈ n.primeFactors := by rw [hs]; simp
  have hrm : r ∈ n.primeFactors := by rw [hs]; simp
  have hp : p.Prime := Nat.prime_of_mem_primeFactors hpm
  have hq : q.Prime := Nat.prime_of_mem_primeFactors hqm
  have hr : r.Prime := Nat.prime_of_mem_primeFactors hrm
  have hfac := Nat.factorization_prod_pow_eq_self hn
  rw [Finsupp.prod, Nat.support_factorization, hs, Finset.prod_insert (by simp [hpq, hpr]),
    Finset.prod_pair hqr] at hfac
  have ha : 1 ≤ n.factorization p :=
    Nat.Prime.factorization_pos_of_dvd hp hn (Nat.dvd_of_mem_primeFactors hpm)
  have hb : 1 ≤ n.factorization q :=
    Nat.Prime.factorization_pos_of_dvd hq hn (Nat.dvd_of_mem_primeFactors hqm)
  have hc : 1 ≤ n.factorization r :=
    Nat.Prime.factorization_pos_of_dvd hr hn (Nat.dvd_of_mem_primeFactors hrm)
  -- sort the three primes
  rcases lt_or_gt_of_ne hpq with h1 | h1 <;> rcases lt_or_gt_of_ne hpr with h2 | h2 <;>
    rcases lt_or_gt_of_ne hqr with h3 | h3
  · exact ⟨p, q, r, _, _, _, hp, hq, hr, h1, h3, ha, hb, hc, hfac.symm.trans (by ring)⟩
  · exact ⟨p, r, q, _, _, _, hp, hr, hq, h2, h3, ha, hc, hb, hfac.symm.trans (by ring)⟩
  · omega
  · exact ⟨r, p, q, _, _, _, hr, hp, hq, h2, h1, hc, ha, hb, hfac.symm.trans (by ring)⟩
  · exact ⟨q, p, r, _, _, _, hq, hp, hr, h1, h2, hb, ha, hc, hfac.symm.trans (by ring)⟩
  · omega
  · exact ⟨q, r, p, _, _, _, hq, hr, hp, h3, h2, hb, hc, ha, hfac.symm.trans (by ring)⟩
  · exact ⟨r, q, p, _, _, _, hr, hq, hp, h3, h1, hc, hb, ha, hfac.symm.trans (by ring)⟩

