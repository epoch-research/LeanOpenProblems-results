/-- `F p a ≤ ∑_{b ≤ a} (1/p)^b`. -/
lemma F_le_geom {p a : ℕ} (hp : p.Prime) :
    F p a ≤ ∑ b ∈ range (a + 1), ((1 : ℚ) / p) ^ b := by
  unfold F
  apply Finset.sum_le_sum
  intro b _
  have h1 : ((p : ℚ) ^ b) ≤ ((σ 1 (p ^ b) : ℕ) : ℚ) := by
    have := self_le_sigma_one (pow_ne_zero b hp.ne_zero)
    exact_mod_cast this
  have h2 : (0 : ℚ) < (p : ℚ) ^ b := by
    have : (0 : ℚ) < p := by exact_mod_cast hp.pos
    positivity
  rw [one_div_pow, one_div, one_div]
  exact inv_anti₀ h2 h1

lemma geom_sum_le {p : ℕ} (hp : p.Prime) (N : ℕ) :
    ∑ b ∈ range N, ((1 : ℚ) / p) ^ b ≤ (p : ℚ) / (p - 1) := by
  have hp1 : (1 : ℚ) < p := by exact_mod_cast hp.one_lt
  have hp0 : (0 : ℚ) < p := by linarith
  have hne : (1 : ℚ) / p ≠ 1 := by
    rw [Ne, div_eq_one_iff_eq hp0.ne']; intro h; linarith
  rw [geom_sum_eq hne]
  have hpos : (0 : ℚ) ≤ ((1 : ℚ) / p) ^ N := by positivity
  have hq : (0 : ℚ) < (p : ℚ) / (p - 1) := by apply div_pos hp0; linarith
  have heq : (((1 : ℚ) / p) ^ N - 1) / (1 / p - 1) = (1 - ((1 : ℚ) / p) ^ N) * ((p : ℚ) / (p - 1)) := by
    have h1 : (p : ℚ) - 1 ≠ 0 := by linarith
    have h2 : (1 : ℚ) / p - 1 ≠ 0 := sub_ne_zero.mpr hne
    rw [div_eq_iff h2]
    field_simp
    ring
  rw [heq]
  nlinarith

lemma F_lt {p a : ℕ} (hp : p.Prime) : F p a < (p : ℚ) / (p - 1) := by
  have hp1 : (1 : ℚ) < p := by exact_mod_cast hp.one_lt
  have hp0 : (0 : ℚ) < p := by linarith
  have hne : (1 : ℚ) / p ≠ 1 := by
    rw [Ne, div_eq_one_iff_eq hp0.ne']; intro h; linarith
  have hpos : (0 : ℚ) < ((1 : ℚ) / p) ^ (a + 1) := by positivity
  have hq : (0 : ℚ) < (p : ℚ) / (p - 1) := by apply div_pos hp0; linarith
  have heq : (((1 : ℚ) / p) ^ (a + 1) - 1) / (1 / p - 1)
      = (1 - ((1 : ℚ) / p) ^ (a + 1)) * ((p : ℚ) / (p - 1)) := by
    have h1 : (p : ℚ) - 1 ≠ 0 := by linarith
    have h2 : (1 : ℚ) / p - 1 ≠ 0 := sub_ne_zero.mpr hne
    rw [div_eq_iff h2]
    field_simp
    ring
  calc F p a ≤ ∑ b ∈ range (a + 1), ((1 : ℚ) / p) ^ b := F_le_geom hp
    _ = (((1 : ℚ) / p) ^ (a + 1) - 1) / (1 / p - 1) := geom_sum_eq hne _
    _ = (1 - ((1 : ℚ) / p) ^ (a + 1)) * ((p : ℚ) / (p - 1)) := heq
    _ < (p : ℚ) / (p - 1) := by nlinarith

lemma F_succ (p a : ℕ) : F p (a + 1) = F p a + 1 / ((σ 1 (p ^ (a + 1)) : ℕ) : ℚ) := by
  unfold F; rw [Finset.sum_range_succ]

lemma F_mono {p a b : ℕ} (hp : p.Prime) (h : a ≤ b) : F p a ≤ F p b := by
  induction b, h using Nat.le_induction with
  | base => exact le_rfl
  | succ b _ ih =>
    rw [F_succ]
    have := sigma_prime_pow_pos (b := b + 1) hp
    have : (0 : ℚ) < 1 / ((σ 1 (p ^ (b + 1)) : ℕ) : ℚ) := by positivity
    linarith

lemma F_gt_one {p a : ℕ} (hp : p.Prime) (ha : 1 ≤ a) : 1 < F p a := by
  have h1 : F p 1 ≤ F p a := F_mono hp ha
  have : F p 1 = 1 + 1 / ((σ 1 (p ^ 1) : ℕ) : ℚ) := by
    unfold F; simp [Finset.sum_range_succ]
  have := sigma_prime_pow_pos (b := 1) hp
  have : (0 : ℚ) < 1 / ((σ 1 (p ^ 1) : ℕ) : ℚ) := by positivity
  linarith

/-- Finer bound: `F p a ≤ 1 + 1/(p+1) + 1/(p(p-1))`. -/
lemma F_le_fine {p a : ℕ} (hp : p.Prime) (ha : 1 ≤ a) :
    F p a ≤ 1 + 1 / ((p : ℚ) + 1) + 1 / ((p : ℚ) * (p - 1)) := by
  have hp1 : (1 : ℚ) < p := by exact_mod_cast hp.one_lt
  have hp0 : (0 : ℚ) < p := by linarith
  obtain ⟨c, rfl⟩ : ∃ c, a = c + 1 := ⟨a - 1, by omega⟩
  unfold F
  rw [Finset.sum_range_succ', Finset.sum_range_succ']
  have h0 : (1 : ℚ) / ((σ 1 (p ^ 0) : ℕ) : ℚ) = 1 := by simp
  have h1 : (1 : ℚ) / ((σ 1 (p ^ (0 + 1)) : ℕ) : ℚ) = 1 / ((p : ℚ) + 1) := by
    rw [zero_add, sigma_one_apply_prime_pow hp]
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one]
    push_cast; ring
  rw [h0, h1]
  have h2 : ∑ b ∈ range c, (1 : ℚ) / ((σ 1 (p ^ (b + 1 + 1)) : ℕ) : ℚ)
      ≤ ∑ b ∈ range c, ((1 : ℚ) / p) ^ 2 * ((1 : ℚ) / p) ^ b := by
    apply Finset.sum_le_sum
    intro b _
    have h1 : ((p : ℚ) ^ (b + 1 + 1)) ≤ ((σ 1 (p ^ (b + 1 + 1)) : ℕ) : ℚ) := by
      have := self_le_sigma_one (pow_ne_zero (b + 1 + 1) hp.ne_zero)
      exact_mod_cast this
    have h2 : (0 : ℚ) < (p : ℚ) ^ (b + 1 + 1) := by positivity
    have h3 : ((1 : ℚ) / p) ^ 2 * ((1 : ℚ) / p) ^ b = 1 / (p : ℚ) ^ (b + 1 + 1) := by
      rw [show b + 1 + 1 = 2 + b by ring, pow_add, one_div_pow, one_div_pow, one_div_mul_one_div]
    rw [h3, one_div, one_div]
    exact inv_anti₀ h2 h1
  rw [← Finset.mul_sum] at h2
  have h3 := geom_sum_le hp c
  have h4 : ((1 : ℚ) / p) ^ 2 * ((p : ℚ) / (p - 1)) = 1 / ((p : ℚ) * (p - 1)) := by
    field_simp
  have h5 : (0 : ℚ) ≤ ((1 : ℚ) / p) ^ 2 := by positivity
  have h6 := mul_le_mul_of_nonneg_left h3 h5
  linarith

lemma F_three_one : F 3 1 = 5 / 4 := by
