/-- **Explicit lower bound, improved.**  Any solution `n > 1` satisfies `n ≥ 2^53 · 3 · 5 · 7 · 11`. -/
theorem solution_ge_fiftythree {n : ℕ} (hn : 1 < n) (hden : (f n).den = 1) :
    2 ^ 53 * (3 * 5 * 7 * 11) ≤ n := by
  have h53 := padicValNat_two_ge_fiftythree hn hden
  have h5 := five_le_card_primeFactors hn hden
  have hn0 : n ≠ 0 := by omega
  obtain ⟨v, n', hodd, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn0
  have hn'0 : n' ≠ 0 := by rintro rfl; simp at hn
  rw [padicValNat_two_pow_mul_odd hodd] at h53
  have hcop : Nat.Coprime (2 ^ v) n' := by
    apply Nat.Coprime.pow_left
    rw [Nat.coprime_two_left]; exact hodd
  rw [Nat.primeFactors_mul (by positivity) hn'0, Finset.card_union_of_disjoint
    hcop.disjoint_primeFactors, Nat.primeFactors_prime_pow (by omega) Nat.prime_two,
    Finset.card_singleton] at h5
  obtain ⟨t, hts, htc⟩ := Finset.exists_subset_card_eq (show 4 ≤ n'.primeFactors.card by omega)
  have hprime : ∀ p ∈ t, p.Prime := fun p hp => Nat.prime_of_mem_primeFactors (hts hp)
  have hoddp : ∀ p ∈ t, Odd p := by
    intro p hp
    exact Odd.of_dvd_nat hodd (Nat.dvd_of_mem_primeFactors (hts hp))
  have h1 := prod_four_lower htc hprime hoddp
  have h2 : ∏ p ∈ t, p ≤ ∏ p ∈ n'.primeFactors, p :=
    Finset.prod_le_prod_of_subset_of_one_le' hts
      (fun p hp _ => (Nat.prime_of_mem_primeFactors hp).one_lt.le)
  have h3 : ∏ p ∈ n'.primeFactors, p ≤ n' :=
    Nat.le_of_dvd (Nat.pos_of_ne_zero hn'0) (Nat.prod_primeFactors_dvd n')
  have h4 : 2 ^ 53 ≤ 2 ^ v := Nat.pow_le_pow_right (by norm_num) h53
  calc 2 ^ 53 * (3 * 5 * 7 * 11) ≤ 2 ^ v * n' :=
        Nat.mul_le_mul h4 (le_trans h1 (le_trans h2 h3))

