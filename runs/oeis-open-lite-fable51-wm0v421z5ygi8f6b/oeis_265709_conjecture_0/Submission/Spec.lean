/-- Decimal upper bound for all `f (2^v)`. -/
lemma f_two_pow_lt_HI (v : ℕ) : f (2 ^ v) < (16066951527 : ℚ) / 10 ^ 10 := by
  have key : f (2 ^ 32) + 1 / 2 ^ 32 < (16066951527 : ℚ) / 10 ^ 10 := by
    rw [f_two_pow_thirtytwo]; norm_num
  rcases le_or_gt 32 v with h | h
  · have h1 := f_two_pow_tail_gen h
