lemma odd_prod' {ι : Type*} (s : Finset ι) (g : ι → ℕ) (h : ∀ i ∈ s, Odd (g i)) :
    Odd (∏ i ∈ s, g i) :=
  Finset.prod_induction g Odd (fun _ _ => Odd.mul) odd_one h

lemma odd_sigma_two_pow (b : ℕ) : Odd (σ 1 (2 ^ b)) := by
  rw [sigma_one_apply_prime_pow Nat.prime_two, Nat.geomSum_eq le_rfl,
    show (2 : ℕ) - 1 = 1 from rfl, Nat.div_one]
  have : 2 ≤ 2 ^ (b + 1) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (b + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  obtain ⟨k, hk⟩ : ∃ k, 2 ^ (b + 1) = 2 * k := ⟨2 ^ b, by ring⟩
  exact ⟨k - 1, by omega⟩

/-- `f(2^v) · ∏ σ(2^b)` is an integer which is a sum of `v+1` odd numbers. -/
lemma f_two_pow_mul_prod (v : ℕ) :
    f (2 ^ v) * ((∏ b ∈ range (v + 1), σ 1 (2 ^ b) : ℕ) : ℚ) =
      ((∑ b ∈ range (v + 1), ∏ c ∈ (range (v + 1)).erase b, σ 1 (2 ^ c) : ℕ) : ℚ) := by
  rw [f_prime_pow Nat.prime_two]
  unfold F
  push_cast
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun b hb => ?_
  rw [← Finset.mul_prod_erase _ _ hb]
  have : ((σ 1 (2 ^ b) : ℕ) : ℚ) ≠ 0 := by
    have := sigma_prime_pow_pos (b := b) Nat.prime_two; positivity
  field_simp

/-- For even `v`, `v₂(f(2^v)) = 0`. -/
theorem padicValRat_f_two_pow_even {v : ℕ} (hv : Even v) : padicValRat 2 (f (2 ^ v)) = 0 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set L : ℕ := ∏ b ∈ range (v + 1), σ 1 (2 ^ b) with hL
  set N : ℕ := ∑ b ∈ range (v + 1), ∏ c ∈ (range (v + 1)).erase b, σ 1 (2 ^ c) with hN
  have hLodd : Odd L := odd_prod' _ _ fun b _ => odd_sigma_two_pow b
  have hNodd : Odd N := by
    rw [hN, Nat.odd_iff, Finset.sum_nat_mod]
    have : ∀ b ∈ range (v + 1),
        (∏ c ∈ (range (v + 1)).erase b, σ 1 (2 ^ c)) % 2 = 1 := fun b _ =>
      Nat.odd_iff.mp (odd_prod' _ _ fun c _ => odd_sigma_two_pow c)
    rw [Finset.sum_congr rfl this]
    simp only [Finset.sum_const, Finset.card_range, smul_eq_mul, mul_one]
    obtain ⟨k, rfl⟩ := hv; omega
  have heq := f_two_pow_mul_prod v
  rw [← hL, ← hN] at heq
  have hL0 : (L : ℚ) ≠ 0 := by exact_mod_cast hLodd.pos.ne'
  have hf0 : f (2 ^ v) ≠ 0 := (f_pos (by positivity)).ne'
  have h1 := congrArg (padicValRat 2) heq
  rw [padicValRat.mul hf0 hL0, ← padicValRat_of_nat, ← padicValRat_of_nat] at h1
  have hvL : padicValNat 2 L = 0 :=
    padicValNat.eq_zero_of_not_dvd (by rw [Nat.two_dvd_ne_zero]; exact Nat.odd_iff.mp hLodd)
  have hvN : padicValNat 2 N = 0 :=
    padicValNat.eq_zero_of_not_dvd (by rw [Nat.two_dvd_ne_zero]; exact Nat.odd_iff.mp hNodd)
  rw [hvL, hvN] at h1
  omega

/-- Any solution `2^v * n'` (with `n'` odd, `n' > 1`) has `v` odd. -/
theorem odd_v_of_solution {v n' : ℕ} (hodd : Odd n') (hn' : 1 < n')
    (hden : (f (2 ^ v * n')).den = 1) : Odd v := by
  by_contra hv
  rw [Nat.not_odd_iff_even] at hv
  have h1 := card_primeFactors_le hodd hn' hden
  rw [padicValRat_f_two_pow_even hv] at h1
  have : 0 < n'.primeFactors.card := Finset.card_pos.mpr (Nat.nonempty_primeFactors.mpr hn')
  omega

end A265709Aux

