lemma sigma_two_pow (b : ℕ) : σ 1 (2 ^ b) = 2 ^ (b + 1) - 1 := by
  have := sigma_prime_pow_mul (b := b) Nat.prime_two
  simpa using this

lemma f_two_pow_succ (v : ℕ) :
    f (2 ^ (v + 1)) = f (2 ^ v) + 1 / ((2 ^ (v + 2) - 1 : ℕ) : ℚ) := by
  rw [f_prime_pow Nat.prime_two, f_prime_pow Nat.prime_two]
  unfold F
  rw [Finset.sum_range_succ, sigma_two_pow]

lemma two_pow_sub_one_pos (v : ℕ) : (0 : ℚ) < ((2 ^ (v + 2) - 1 : ℕ) : ℚ) := by
  have : 1 < 2 ^ (v + 2) := Nat.one_lt_two_pow (by omega)
  exact_mod_cast Nat.sub_pos_of_lt this

lemma f_two_pow_mono {v w : ℕ} (h : v ≤ w) : f (2 ^ v) ≤ f (2 ^ w) := by
  induction w, h using Nat.le_induction with
  | base => exact le_rfl
  | succ w _ ih =>
    rw [f_two_pow_succ]
    have := two_pow_sub_one_pos w
    have : (0 : ℚ) < 1 / ((2 ^ (w + 2) - 1 : ℕ) : ℚ) := by positivity
    linarith

lemma f_two_pow_tail {v : ℕ} (hv : 9 ≤ v) :
    f (2 ^ v) ≤ f (2 ^ 9) + 1 / 2 ^ 9 - 1 / (2 : ℚ) ^ v := by
  induction v, hv using Nat.le_induction with
  | base => simp
  | succ v _ ih =>
    rw [f_two_pow_succ]
    have h1 : (1 : ℚ) / ((2 ^ (v + 2) - 1 : ℕ) : ℚ) ≤ 1 / 2 ^ (v + 1) := by
      apply one_div_le_one_div_of_le (by positivity)
      have h2 : 2 ^ (v + 1) ≤ 2 ^ (v + 2) - 1 := by
        have : 2 ^ (v + 2) = 2 * 2 ^ (v + 1) := by ring
        have : 1 ≤ 2 ^ (v + 1) := Nat.one_le_two_pow
        omega
      exact_mod_cast h2
    have h3 : (1 : ℚ) / 2 ^ (v + 1) = 1 / 2 ^ v - 1 / 2 ^ (v + 1) := by
      rw [pow_succ]; field_simp; ring
    linarith

lemma f_two_pow_nine : f (2 ^ 9) = 27183776108 / 16929355905 := by
