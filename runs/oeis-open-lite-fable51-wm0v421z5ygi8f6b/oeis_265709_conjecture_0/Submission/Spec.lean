lemma mod_of_dvd_aux {x : ℕ} {M A B Bi ρ : ℤ}
    (h : M ∣ A - ((x : ℤ) + 1) * B) (hBi : B * Bi ≡ 1 [ZMOD M]) (hρ : A * Bi ≡ ρ [ZMOD M]) :
    ((x : ℤ) + 1) % M = ρ % M := by
  have h1 : ((x : ℤ) + 1) * B ≡ A [ZMOD M] := Int.modEq_iff_dvd.mpr h
  have h2 : ((x : ℤ) + 1) * B * Bi ≡ A * Bi [ZMOD M] := h1.mul_right Bi
  have h3 : ((x : ℤ) + 1) * B * Bi ≡ (x : ℤ) + 1 [ZMOD M] := by
    calc ((x : ℤ) + 1) * B * Bi = ((x : ℤ) + 1) * (B * Bi) := by ring
      _ ≡ ((x : ℤ) + 1) * 1 [ZMOD M] := hBi.mul_left _
      _ = (x : ℤ) + 1 := by ring
  exact (h3.symm.trans h2).trans hρ

