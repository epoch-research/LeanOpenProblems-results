/-- For `w ≤ 9`, `v₂ (f (2^w)) ≤ 4`. -/
lemma padicValRat_f_two_pow_le_four {w : ℕ} (hw : w ≤ 9) : padicValRat 2 (f (2 ^ w)) ≤ 4 := by
  rcases Nat.even_or_odd w with he | ho
