lemma F_one_eq {p : ℕ} (hp : p.Prime) : F p 1 = 1 + 1 / ((p : ℚ) + 1) := by
  rw [F_eval hp]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one]
  ring

lemma F_two_eq {p : ℕ} (hp : p.Prime) :
    F p 2 = 1 + 1 / ((p : ℚ) + 1) + 1 / ((p : ℚ) ^ 2 + p + 1) := by
  rw [F_eval hp]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one]
  ring

/-- Upper bound for `F p a` valid for all `a`. -/
lemma F_le_all {p : ℕ} (hp : p.Prime) (a₀ a : ℕ) :
    F p a ≤ F p a₀ + 1 / ((p : ℚ) ^ a₀ * (p - 1)) := by
  rcases le_or_gt a a₀ with h | h
  · have := F_mono hp h
    have hp1 : (1 : ℚ) < p := by exact_mod_cast hp.one_lt
    have : (0 : ℚ) < 1 / ((p : ℚ) ^ a₀ * (p - 1)) := by
      apply _root_.div_pos one_pos
      apply mul_pos (by positivity)
      linarith
    linarith
  · exact (F_lt_tail hp h.le).le

