import FormalConjectures.Util.ProblemImports

open Nat

/--
A264025: Number of ways to write $n$ as $x^2 + y(2y+1) + \frac{z(z+1)}{2}$
where $x, y$ and $z$ are nonnegative integers with $z$ or $z+1$ prime.
-/
noncomputable def A264025 (n : ℕ) : ℕ :=
  Nat.card { p : ℕ × ℕ × ℕ //
    let (x, y, z) := p
    x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
    (Nat.Prime z ∨ Nat.Prime (z + 1))
  }

/-! ## Reduction infrastructure

We reduce the conjecture to (a) a finite, kernel-checked computation for `n ≤ 1344`, and
(b) the single genuinely open statement `A264025Aux.large` (for every `n > 1344` there are two
distinct admissible triples). -/

namespace A264025Aux

/-- Admissibility of a triple `(x, y, z)`, in projection form. -/
def Ok (n : ℕ) (p : ℕ × ℕ × ℕ) : Prop :=
  p.1 ^ 2 + p.2.1 * (2 * p.2.1 + 1) + p.2.2 * (p.2.2 + 1) / 2 = n ∧
    (Nat.Prime p.2.2 ∨ Nat.Prime (p.2.2 + 1))

instance okDec (n : ℕ) : DecidablePred (Ok n) := fun _ =>
  @instDecidableAnd _ _ (Nat.decEq _ _)
    (@instDecidableOr _ _ (Nat.decidablePrime _) (Nat.decidablePrime _))

def Box (n : ℕ) : Finset (ℕ × ℕ × ℕ) :=
  (Finset.range (n+1)) ×ˢ (Finset.range (n+1)) ×ˢ (Finset.range (n+1))

def BoxB (a b c : ℕ) : Finset (ℕ × ℕ × ℕ) :=
  (Finset.range a) ×ˢ (Finset.range b) ×ˢ (Finset.range c)

def cnt (n : ℕ) : ℕ := ((Box n).filter (Ok n)).card

def cntZ (n a b z : ℕ) : ℕ :=
  ((Finset.range a ×ˢ Finset.range b).filter (fun xy : ℕ × ℕ => Ok n (xy.1, xy.2, z))).card

def Lset : Finset ℕ := {1, 2, 3, 8, 9, 23, 30, 44, 48, 198, 219, 1344}

lemma tri_ge {z : ℕ} : z ≤ z * (z+1) / 2 := by
  have : z * 2 ≤ z * (z+1) := by
    rcases Nat.eq_zero_or_pos z with h | h
    · subst h; simp
    · exact Nat.mul_le_mul_left z (by omega)
  exact Nat.le_div_iff_mul_le (by norm_num) |>.mpr this

lemma ok_bound {n : ℕ} {p : ℕ × ℕ × ℕ} (h : Ok n p) : p ∈ Box n := by
  obtain ⟨x, y, z⟩ := p
  simp only [Ok] at h
  obtain ⟨h1, -⟩ := h
  simp only [Box, Finset.mem_product, Finset.mem_range]
  have hx : x ≤ n := by
    have : x ≤ x ^ 2 := by nlinarith
    omega
  have hy : y ≤ n := by
    have : y ≤ y * (2 * y + 1) := by nlinarith
    omega
  have hz : z ≤ n := by
    have h2 : z ≤ z * (z+1) / 2 := tri_ge
    have : z * (z+1) / 2 ≤ n := by omega
    omega
  omega

lemma A264025_eq_cnt (n : ℕ) : A264025 n = cnt n := by
  unfold A264025 cnt
  have : { p : ℕ × ℕ × ℕ //
    let (x, y, z) := p
    x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
    (Nat.Prime z ∨ Nat.Prime (z + 1)) } = { p : ℕ × ℕ × ℕ // Ok n p } := by
    congr 1
  rw [this]
  have hs : { p : ℕ × ℕ × ℕ // Ok n p } = ↥((Box n).filter (Ok n) : Set (ℕ × ℕ × ℕ)) := by
    congr 1
    ext p
    simp only [Finset.coe_filter, Set.mem_setOf_eq]
    exact ⟨fun h => ⟨ok_bound h, h⟩, fun h => h.2⟩
  rw [hs, Nat.card_coe_set_eq, Set.ncard_coe_finset]

lemma ok_boundB {n a b c : ℕ} (ha : n < a * a) (hb : n < b * (2 * b + 1))
    (hc : n < c * (c + 1) / 2) {p : ℕ × ℕ × ℕ} (h : Ok n p) : p ∈ BoxB a b c := by
  obtain ⟨x, y, z⟩ := p
  simp only [Ok] at h
  obtain ⟨h1, -⟩ := h
  simp only [BoxB, Finset.mem_product, Finset.mem_range]
  refine ⟨?_, ?_, ?_⟩
  · by_contra hx
    push_neg at hx
    have : a * a ≤ x ^ 2 := by nlinarith
    omega
  · by_contra hy
    push_neg at hy
    have : b * (2 * b + 1) ≤ y * (2 * y + 1) := by nlinarith
    omega
  · by_contra hz
    push_neg at hz
    have : c * (c + 1) ≤ z * (z + 1) := by nlinarith
    have : c * (c + 1) / 2 ≤ z * (z + 1) / 2 := Nat.div_le_div_right this
    omega

lemma cnt_eq_boxB (n a b c : ℕ) (ha : n < a * a) (hb : n < b * (2 * b + 1))
    (hc : n < c * (c + 1) / 2) : cnt n = ((BoxB a b c).filter (Ok n)).card := by
  unfold cnt
  congr 1
  ext p
  simp only [Finset.mem_filter]
  exact ⟨fun h => ⟨ok_boundB ha hb hc h.2, h.2⟩, fun h => ⟨ok_bound h.2, h.2⟩⟩

lemma card_boxB_eq_sum (n a b c : ℕ) :
    ((BoxB a b c).filter (Ok n)).card = ∑ z ∈ Finset.range c, cntZ n a b z := by
  unfold cntZ BoxB
  simp only [Finset.card_filter, Finset.sum_product]
  rw [Finset.sum_congr rfl fun x _ => Finset.sum_comm]
  rw [Finset.sum_comm]

lemma two_le {n : ℕ} {p q : ℕ × ℕ × ℕ} (hpq : p ≠ q) (hp : Ok n p) (hq : Ok n q) :
    2 ≤ A264025 n := by
  rw [A264025_eq_cnt, cnt]
  exact Finset.one_lt_card.mpr
    ⟨p, Finset.mem_filter.mpr ⟨ok_bound hp, hp⟩, q, Finset.mem_filter.mpr ⟨ok_bound hq, hq⟩, hpq⟩

lemma pos {n : ℕ} {p : ℕ × ℕ × ℕ} (hp : Ok n p) : 0 < A264025 n := by
  rw [A264025_eq_cnt, cnt]
  exact Finset.card_pos.mpr ⟨p, Finset.mem_filter.mpr ⟨ok_bound hp, hp⟩⟩

lemma val_0 : A264025 0 = 0 := by
  rw [A264025_eq_cnt, cnt_eq_boxB 0 1 1 1 (by norm_num) (by norm_num) (by norm_num)]
  decide

/-- **The open part.** This is the genuinely open analytic statement (a ternary quadratic
problem with a prime variable, of the same depth as Plaksin's `n = p² + x² + y²` theorem but
required effectively and for *all* `n > 1344`).  It has been verified numerically for all
`1344 < n ≤ 8·10⁹`. -/
theorem large (n : ℕ) (hn : 1344 < n) :
    ∃ p q : ℕ × ℕ × ℕ, p ≠ q ∧ Ok n p ∧ Ok n q := by
  sorry


