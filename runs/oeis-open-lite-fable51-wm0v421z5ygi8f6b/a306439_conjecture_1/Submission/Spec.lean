import FormalConjectures.Util.ProblemImports

open Nat Finset Set

/--
The generalized pentagonal number $k(3k+1)/2$ for $k \ge 0$.
-/
noncomputable def P3 (k : ℕ) : ℕ := k * (3 * k + 1) / 2

/--
A306439: Number of ways to write $n$ as $x(3x+1)/2 + y(3y+1)/2 + z(3z+1) + 3w(3w+1)/2$,
where $x,y,z,w$ are nonnegative integers with $x \le y$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  let B := n + 1
  let RangeB := range B

  -- The domain of search is (RangeB x RangeB) x (RangeB x RangeB).
  let search_space : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
    (RangeB.product RangeB).product (RangeB.product RangeB)

  (search_space.filter (fun p =>
    let x := p.fst.fst
    let y := p.fst.snd
    let z := p.snd.fst
    let w := p.snd.snd
    -- The equation is P3(x) + P3(y) + 2*P3(z) + 3*P3(w) = n.
    x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w
  )).card

namespace A306439

noncomputable def sol (n : ℕ) : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
  ((range (n+1) ×ˢ range (n+1)) ×ˢ (range (n+1) ×ˢ range (n+1))).filter
    (fun p => p.1.1 ≤ p.1.2 ∧ n = P3 p.1.1 + P3 p.1.2 + 2 * P3 p.2.1 + 3 * P3 p.2.2)

theorem a_eq (n : ℕ) : a n = (sol n).card := rfl

theorem le_P3 (k : ℕ) : k ≤ P3 k := by
  unfold P3
  rcases Nat.eq_zero_or_pos k with h | h
  · subst h; simp
  · have : k * 2 ≤ k * (3 * k + 1) := Nat.mul_le_mul_left k (by omega)
    omega

theorem mem_sol {n x y z w : ℕ} (hxy : x ≤ y) (h : n = P3 x + P3 y + 2 * P3 z + 3 * P3 w) :
    ((x, y), (z, w)) ∈ sol n := by
  unfold sol
  rw [Finset.mem_filter]
  refine ⟨?_, hxy, h⟩
  have hx := le_P3 x; have hy := le_P3 y; have hz := le_P3 z; have hw := le_P3 w
  simp only [Finset.mem_product, Finset.mem_range]
  omega

theorem two_le_a {n : ℕ} {s t : (ℕ × ℕ) × (ℕ × ℕ)} (hs : s ∈ sol n) (ht : t ∈ sol n) (hst : s ≠ t) :
    2 ≤ a n := by
  rw [a_eq]
  have : ({s, t} : Finset _) ⊆ sol n := by
    intro u hu
    simp only [Finset.mem_insert, Finset.mem_singleton] at hu
    rcases hu with rfl | rfl <;> assumption
  have h2 := Finset.card_le_card this
  rwa [Finset.card_pair hst] at h2

/-! ### Kernel checker for base cases -/

def P3' (k : ℕ) : ℕ := k * (3 * k + 1) / 2
def val (x y z w : ℕ) : ℕ := P3' x + P3' y + 2 * P3' z + 3 * P3' w
def chk1 (n e : ℕ) : Bool :=
  Nat.ble (e % 512) ((e / 512) % 512) &&
    Nat.beq (val (e % 512) ((e / 512) % 512) ((e / 262144) % 512) (e / 134217728)) n
def chkPair (n e : ℕ) : Bool :=
  Nat.blt (e % 68719476736) (e / 68719476736) && chk1 n (e % 68719476736) && chk1 n (e / 68719476736)
def chkChunk (n0 c : ℕ) : ℕ → Bool
  | 0 => true
  | k+1 => chkPair n0 (c % 4722366482869645213696) && chkChunk (n0+1) (c / 4722366482869645213696) k
def chkAll (n0 L : ℕ) : List ℕ → Bool
  | [] => true
  | c :: cs => chkChunk n0 c L && chkAll (n0 + L) L cs

def tup (e : ℕ) : (ℕ × ℕ) × (ℕ × ℕ) := ((e % 512, (e / 512) % 512), ((e / 262144) % 512, e / 134217728))

theorem P3'_eq (k : ℕ) : P3' k = P3 k := rfl

theorem chk1_sound {n e : ℕ} (h : chk1 n e = true) : tup e ∈ sol n := by
  unfold chk1 at h
  rw [Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq] at h
  obtain ⟨h1, h2⟩ := h
  apply mem_sol h1
  rw [← h2]; rfl

theorem tup_inj {e₁ e₂ : ℕ} (h : tup e₁ = tup e₂) : e₁ = e₂ := by
  unfold tup at h
  simp only [Prod.mk.injEq] at h
  obtain ⟨⟨a1, a2⟩, a3, a4⟩ := h
  have := Nat.div_add_mod e₁ 512
  have := Nat.div_add_mod e₂ 512
  have := Nat.div_add_mod (e₁ / 512) 512
  have := Nat.div_add_mod (e₂ / 512) 512
  have := Nat.div_add_mod (e₁ / 262144) 512
  have := Nat.div_add_mod (e₂ / 262144) 512
  have e1a : e₁ / 262144 = e₁ / 512 / 512 := by rw [Nat.div_div_eq_div_mul]
  have e2a : e₂ / 262144 = e₂ / 512 / 512 := by rw [Nat.div_div_eq_div_mul]
  have e1b : e₁ / 134217728 = e₁ / 262144 / 512 := by rw [Nat.div_div_eq_div_mul]
  have e2b : e₂ / 134217728 = e₂ / 262144 / 512 := by rw [Nat.div_div_eq_div_mul]
  omega

theorem chkPair_sound {n e : ℕ} (h : chkPair n e = true) : 2 ≤ a n := by
  unfold chkPair at h
  simp only [Bool.and_eq_true, Nat.blt_eq] at h
  obtain ⟨⟨hlt, h1⟩, h2⟩ := h
  refine two_le_a (chk1_sound h1) (chk1_sound h2) ?_
  intro heq
  have := tup_inj heq
  omega

theorem chkChunk_sound {n0 c k : ℕ} (h : chkChunk n0 c k = true) :
    ∀ n, n0 ≤ n → n < n0 + k → 2 ≤ a n := by
  induction k generalizing n0 c with
  | zero => intro n h1 h2; omega
  | succ k ih =>
    intro n h1 h2
    unfold chkChunk at h
    rw [Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact chkPair_sound h.1
    · exact ih h.2 n (by omega) (by omega)

theorem chkAll_sound {n0 L : ℕ} {cs : List ℕ} (h : chkAll n0 L cs = true) :
    ∀ n, n0 ≤ n → n < n0 + L * cs.length → 2 ≤ a n := by
  induction cs generalizing n0 with
  | nil => intro n h1 h2; simp at h2; omega
  | cons c cs ih =>
    intro n h1 h2
    unfold chkAll at h
    rw [Bool.and_eq_true] at h
    by_cases hn : n < n0 + L
    · exact chkChunk_sound h.1 n h1 hn
    · exact ih h.2 n (by omega) (by simp [List.length_cons] at h2; rw [Nat.mul_succ] at h2; omega)

theorem P3_mono {j k : ℕ} (h : j ≤ k) : P3 j ≤ P3 k := by
  unfold P3
  apply Nat.div_le_div_right
  exact Nat.mul_le_mul h (by omega)

noncomputable def solB (n B : ℕ) : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
  ((range B ×ˢ range B) ×ˢ (range B ×ˢ range B)).filter
    (fun p => p.1.1 ≤ p.1.2 ∧ n = P3 p.1.1 + P3 p.1.2 + 2 * P3 p.2.1 + 3 * P3 p.2.2)

theorem sol_eq_solB (n B : ℕ) (hB : n < P3 B) : sol n = solB n B := by
  ext ⟨⟨x, y⟩, ⟨z, w⟩⟩
  unfold sol solB
  simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range]
  constructor
  · rintro ⟨-, hxy, h⟩
    refine ⟨⟨⟨?_, ?_⟩, ?_, ?_⟩, hxy, h⟩ <;>
    · by_contra hc
      push_neg at hc
      have := P3_mono hc
      omega
  · rintro ⟨-, hxy, h⟩
    have hx := le_P3 x; have hy := le_P3 y; have hz := le_P3 z; have hw := le_P3 w
    refine ⟨⟨⟨?_, ?_⟩, ?_, ?_⟩, hxy, h⟩ <;> omega

def solB' (n B : ℕ) : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
  ((range B ×ˢ range B) ×ˢ (range B ×ˢ range B)).filter
    (fun p => p.1.1 ≤ p.1.2 ∧ n = P3' p.1.1 + P3' p.1.2 + 2 * P3' p.2.1 + 3 * P3' p.2.2)

theorem solB_eq (n B : ℕ) : solB n B = solB' n B := rfl

theorem a_eq_small (n B : ℕ) (hB : n < P3 B) : a n = (solB' n B).card := by
  rw [a_eq, sol_eq_solB n B hB, solB_eq]



structure TF where
  a : ℤ
  b : ℤ
  c : ℤ
  p : ℤ
  q : ℤ
  r : ℤ

namespace TF

def eval (F : TF) (x y z : ℤ) : ℤ :=
  F.a*x^2 + F.b*y^2 + F.c*z^2 + 2*F.p*x*y + 2*F.q*x*z + 2*F.r*y*z

def det (F : TF) : ℤ := F.a*F.b*F.c + 2*F.p*F.q*F.r - F.a*F.r^2 - F.b*F.q^2 - F.c*F.p^2

def PosDef (F : TF) : Prop := ∀ x y z : ℤ, ¬(x = 0 ∧ y = 0 ∧ z = 0) → 0 < F.eval x y z

def bil (F : TF) (x y z x' y' z' : ℤ) : ℤ :=
  F.a*x*x' + F.b*y*y' + F.c*z*z' + F.p*(x*y' + y*x') + F.q*(x*z' + z*x') + F.r*(y*z' + z*y')

def comp (F : TF) (u1 u2 u3 v1 v2 v3 w1 w2 w3 : ℤ) : TF :=
  ⟨F.eval u1 u2 u3, F.eval v1 v2 v3, F.eval w1 w2 w3,
   F.bil u1 u2 u3 v1 v2 v3, F.bil u1 u2 u3 w1 w2 w3, F.bil v1 v2 v3 w1 w2 w3⟩

theorem comp_eval (F : TF) (u1 u2 u3 v1 v2 v3 w1 w2 w3 x y z : ℤ) :
    (F.comp u1 u2 u3 v1 v2 v3 w1 w2 w3).eval x y z =
      F.eval (u1*x + v1*y + w1*z) (u2*x + v2*y + w2*z) (u3*x + v3*y + w3*z) := by
  simp only [comp, eval, bil]; ring

def mdet (u1 u2 u3 v1 v2 v3 w1 w2 w3 : ℤ) : ℤ :=
  u1*(v2*w3 - v3*w2) - v1*(u2*w3 - u3*w2) + w1*(u2*v3 - u3*v2)

theorem comp_det (F : TF) (u1 u2 u3 v1 v2 v3 w1 w2 w3 : ℤ) :
    (F.comp u1 u2 u3 v1 v2 v3 w1 w2 w3).det = (mdet u1 u2 u3 v1 v2 v3 w1 w2 w3)^2 * F.det := by
  simp only [comp, det, eval, bil, mdet]; ring

theorem sylvester_id (F : TF) (x y z : ℤ) :
    F.a * (F.a*F.b - F.p^2) * F.eval x y z =
      (F.a*F.b - F.p^2) * (F.a*x + F.p*y + F.q*z)^2 +
        ((F.a*F.b - F.p^2)*y + (F.a*F.r - F.p*F.q)*z)^2 + F.a * F.det * z^2 := by
  simp only [eval, det]; ring

theorem posDef_of_sylvester (F : TF) (ha : 0 < F.a) (hm : 0 < F.a*F.b - F.p^2) (hd : 0 < F.det) :
    F.PosDef := by
  intro x y z hne
  have hid := sylvester_id F x y z
  by_contra hle
  push_neg at hle
  have h1 : F.a * (F.a*F.b - F.p^2) * F.eval x y z ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (by positivity) hle
  have hz : z = 0 := by
    by_contra hz
    have : 0 < F.a * F.det * z^2 := by positivity
    nlinarith [sq_nonneg (F.a*x + F.p*y + F.q*z), sq_nonneg ((F.a*F.b - F.p^2)*y + (F.a*F.r - F.p*F.q)*z)]
  subst hz
  have hy : y = 0 := by
    by_contra hy
    have : 0 < ((F.a*F.b - F.p^2)*y + (F.a*F.r - F.p*F.q)*0)^2 := by
      simp only [mul_zero, add_zero]; positivity
    nlinarith [sq_nonneg (F.a*x + F.p*y + F.q*0)]
  subst hy
  have hx : x = 0 := by
    by_contra hx
    have : 0 < (F.a*F.b - F.p^2) * (F.a*x + F.p*0 + F.q*0)^2 := by
      simp only [mul_zero, add_zero]; positivity
    nlinarith
  exact hne ⟨hx, rfl, rfl⟩

theorem a_pos_of_posDef (F : TF) (h : F.PosDef) : 0 < F.a := by
  have := h 1 0 0 (by simp)
  simpa [eval] using this

theorem minor_pos_of_posDef (F : TF) (h : F.PosDef) : 0 < F.a*F.b - F.p^2 := by
  have ha := a_pos_of_posDef F h
  have h1 := h (-F.p) F.a 0 (by intro ⟨_, h2, _⟩; omega)
  have : F.eval (-F.p) F.a 0 = F.a * (F.a*F.b - F.p^2) := by simp only [eval]; ring
  rw [this] at h1
  exact pos_of_mul_pos_right h1 ha.le

theorem schur_id (F : TF) (x y z : ℤ) :
    F.a * F.eval x y z = (F.a*x + F.p*y + F.q*z)^2 +
      ((F.a*F.b - F.p^2)*y^2 + 2*(F.a*F.r - F.p*F.q)*y*z + (F.a*F.c - F.q^2)*z^2) := by
  simp only [eval]; ring

theorem schur_det (F : TF) :
    (F.a*F.b - F.p^2)*(F.a*F.c - F.q^2) - (F.a*F.r - F.p*F.q)^2 = F.a * F.det := by
  simp only [det]; ring

/-- adjugate identity: solving M (x,y,z) = (X,Y,Z) -/
theorem adj_left (u1 u2 u3 v1 v2 v3 w1 w2 w3 x y z : ℤ) :
    (v2*w3 - v3*w2)*(u1*x + v1*y + w1*z) + (v3*w1 - v1*w3)*(u2*x + v2*y + w2*z) +
      (v1*w2 - v2*w1)*(u3*x + v3*y + w3*z) = mdet u1 u2 u3 v1 v2 v3 w1 w2 w3 * x ∧
    (u3*w2 - u2*w3)*(u1*x + v1*y + w1*z) + (u1*w3 - u3*w1)*(u2*x + v2*y + w2*z) +
      (u2*w1 - u1*w2)*(u3*x + v3*y + w3*z) = mdet u1 u2 u3 v1 v2 v3 w1 w2 w3 * y ∧
    (u2*v3 - u3*v2)*(u1*x + v1*y + w1*z) + (u3*v1 - u1*v3)*(u2*x + v2*y + w2*z) +
      (u1*v2 - u2*v1)*(u3*x + v3*y + w3*z) = mdet u1 u2 u3 v1 v2 v3 w1 w2 w3 * z := by
  refine ⟨?_, ?_, ?_⟩ <;> simp only [mdet] <;> ring

theorem adj_right (u1 u2 u3 v1 v2 v3 w1 w2 w3 X Y Z : ℤ) :
    u1*((v2*w3 - v3*w2)*X + (v3*w1 - v1*w3)*Y + (v1*w2 - v2*w1)*Z) +
      v1*((u3*w2 - u2*w3)*X + (u1*w3 - u3*w1)*Y + (u2*w1 - u1*w2)*Z) +
      w1*((u2*v3 - u3*v2)*X + (u3*v1 - u1*v3)*Y + (u1*v2 - u2*v1)*Z) =
        mdet u1 u2 u3 v1 v2 v3 w1 w2 w3 * X ∧
    u2*((v2*w3 - v3*w2)*X + (v3*w1 - v1*w3)*Y + (v1*w2 - v2*w1)*Z) +
      v2*((u3*w2 - u2*w3)*X + (u1*w3 - u3*w1)*Y + (u2*w1 - u1*w2)*Z) +
      w2*((u2*v3 - u3*v2)*X + (u3*v1 - u1*v3)*Y + (u1*v2 - u2*v1)*Z) =
        mdet u1 u2 u3 v1 v2 v3 w1 w2 w3 * Y ∧
    u3*((v2*w3 - v3*w2)*X + (v3*w1 - v1*w3)*Y + (v1*w2 - v2*w1)*Z) +
      v3*((u3*w2 - u2*w3)*X + (u1*w3 - u3*w1)*Y + (u2*w1 - u1*w2)*Z) +
      w3*((u2*v3 - u3*v2)*X + (u3*v1 - u1*v3)*Y + (u1*v2 - u2*v1)*Z) =
        mdet u1 u2 u3 v1 v2 v3 w1 w2 w3 * Z := by
  refine ⟨?_, ?_, ?_⟩ <;> simp only [mdet] <;> ring

/-- basis extension in ℤ³ -/
theorem ext_basis (a₁ b₁ c₁ : ℤ) (hg : Int.gcd a₁ (Int.gcd b₁ c₁) = 1) :
    ∃ v1 v2 v3 w1 w2 w3 : ℤ, mdet a₁ b₁ c₁ v1 v2 v3 w1 w2 w3 = 1 := by
  obtain ⟨g, hg'⟩ : ∃ g : ℕ, g = Int.gcd b₁ c₁ := ⟨_, rfl⟩
  rw [← hg'] at hg
  by_cases hg0 : g = 0
  · subst hg0
    have hbc := Int.gcd_eq_zero_iff.mp hg'.symm
    obtain ⟨rfl, rfl⟩ := hbc
    simp only [Nat.cast_zero, Int.gcd_zero_right] at hg
    refine ⟨0, a₁, 0, 0, 0, 1, ?_⟩
    simp only [mdet]
    have : a₁ = 1 ∨ a₁ = -1 := Int.natAbs_eq_natAbs_iff.mp (by simpa using hg) |>.imp id id
    rcases this with h | h <;> subst h <;> norm_num
  · have hgb : (g:ℤ) ∣ b₁ := hg' ▸ Int.gcd_dvd_left b₁ c₁
    have hgc : (g:ℤ) ∣ c₁ := hg' ▸ Int.gcd_dvd_right b₁ c₁
    obtain ⟨b', hb'⟩ := hgb
    obtain ⟨c', hc'⟩ := hgc
    have hbez1 : (g:ℤ) = b₁ * Int.gcdA b₁ c₁ + c₁ * Int.gcdB b₁ c₁ := hg' ▸ Int.gcd_eq_gcd_ab b₁ c₁
    set s := Int.gcdA b₁ c₁
    set t := Int.gcdB b₁ c₁
    have h1 : b' * s + c' * t = 1 := by
      have hgz : (g:ℤ) ≠ 0 := by exact_mod_cast hg0
      have : (g:ℤ) * (b' * s + c' * t) = (g:ℤ) * 1 := by rw [hb', hc'] at hbez1; linarith
      exact mul_left_cancel₀ hgz this
    have hbez2 : ((Int.gcd a₁ g : ℕ) : ℤ) = a₁ * Int.gcdA a₁ g + (g:ℤ) * Int.gcdB a₁ g :=
      Int.gcd_eq_gcd_ab a₁ g
    rw [hg] at hbez2
    set P := Int.gcdA a₁ g
    set Q := Int.gcdB a₁ g
    have h2 : a₁ * P + Q * g = 1 := by push_cast at hbez2; linarith
    refine ⟨-Q, P*b', P*c', 0, -t, s, ?_⟩
    have : mdet a₁ b₁ c₁ (-Q) (P*b') (P*c') 0 (-t) s = (a₁ * P + Q * g) * (b' * s + c' * t) := by
      simp only [mdet]; rw [hb', hc']; ring
    rw [this, h1, h2]; norm_num

end TF


open Classical in
/-- existence of a minimum of a positive integer-valued function on a nonempty set -/
theorem exists_min_pos {α : Type*} (f : α → ℤ) (S : Set α) (hpos : ∀ v ∈ S, 0 < f v)
    (hne : S.Nonempty) : ∃ v ∈ S, ∀ w ∈ S, f v ≤ f w := by
  have hex : ∃ n : ℕ, ∃ v ∈ S, f v = n := by
    obtain ⟨v, hv⟩ := hne
    exact ⟨(f v).toNat, v, hv, (Int.toNat_of_nonneg (hpos v hv).le).symm⟩
  obtain ⟨v, hv, hf⟩ := Nat.find_spec hex
  refine ⟨v, hv, fun w hw => ?_⟩
  have : Nat.find hex ≤ (f w).toNat :=
    Nat.find_min' hex ⟨w, hw, (Int.toNat_of_nonneg (hpos w hw).le).symm⟩
  rw [hf]
  have h2 := Int.toNat_of_nonneg (hpos w hw).le
  omega

/-- rounding: choose Y with |2(μY + B)| ≤ μ -/
theorem exists_round (μ B : ℤ) (hμ : 0 < μ) : ∃ Y : ℤ, (2*(μ*Y + B))^2 ≤ μ^2 := by
  refine ⟨-((2*B + μ) / (2*μ)), ?_⟩
  have h1 := Int.emod_nonneg (2*B + μ) (by omega : (2*μ) ≠ 0)
  have h2 := Int.emod_lt_of_pos (2*B + μ) (by omega : 0 < 2*μ)
  have h3 := Int.mul_ediv_add_emod (2*B + μ) (2*μ)
  have : 2*(μ*(-((2*B + μ) / (2*μ))) + B) = (2*B + μ) % (2*μ) - μ := by linarith
  rw [this]
  nlinarith

/-- Binary Hermite bound -/
theorem binary_hermite (A B C : ℤ) (hA : 0 < A) (hdet : 0 < A*C - B^2) :
    ∃ y z : ℤ, ¬(y = 0 ∧ z = 0) ∧ 3 * (A*y^2 + 2*B*y*z + C*z^2)^2 ≤ 4 * (A*C - B^2) := by
  set G : ℤ × ℤ → ℤ := fun v => A*v.1^2 + 2*B*v.1*v.2 + C*v.2^2 with hG
  have hid : ∀ y z : ℤ, A * (A*y^2 + 2*B*y*z + C*z^2) = (A*y + B*z)^2 + (A*C - B^2)*z^2 := by
    intro y z; ring
  have hpos : ∀ v ∈ {v : ℤ × ℤ | ¬(v.1 = 0 ∧ v.2 = 0)}, 0 < G v := by
    rintro ⟨y, z⟩ hv
    simp only [Set.mem_setOf_eq] at hv
    simp only [hG]
    have h := hid y z
    by_contra hle; push_neg at hle
    have : A * (A*y^2 + 2*B*y*z + C*z^2) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hA.le hle
    by_cases hz : z = 0
    · subst hz
      have hy : y ≠ 0 := fun hy => hv ⟨hy, rfl⟩
      have : 0 < (A*y + B*0)^2 := by simp; positivity
      nlinarith
    · have : 0 < (A*C - B^2)*z^2 := by positivity
      nlinarith [sq_nonneg (A*y + B*z)]
  obtain ⟨⟨y₀, z₀⟩, hv₀, hmin⟩ := exists_min_pos G {v : ℤ × ℤ | ¬(v.1 = 0 ∧ v.2 = 0)} hpos
    ⟨(1, 0), by simp⟩
  simp only [Set.mem_setOf_eq] at hv₀
  set μ := G (y₀, z₀) with hμdef
  have hμpos : 0 < μ := hpos _ hv₀
  -- primitivity
  have hprim : Int.gcd y₀ z₀ = 1 := by
    obtain ⟨g, hg⟩ : ∃ g : ℕ, g = Int.gcd y₀ z₀ := ⟨_, rfl⟩
    have hg0 : g ≠ 0 := by
      intro h0
      rw [h0] at hg
      exact hv₀ (Int.gcd_eq_zero_iff.mp hg.symm)
    have hgy : (g:ℤ) ∣ y₀ := hg ▸ Int.gcd_dvd_left y₀ z₀
    have hgz : (g:ℤ) ∣ z₀ := hg ▸ Int.gcd_dvd_right y₀ z₀
    obtain ⟨y₁, hy₁⟩ := hgy
    obtain ⟨z₁, hz₁⟩ := hgz
    have hv₁ : ¬(y₁ = 0 ∧ z₁ = 0) := by
      rintro ⟨rfl, rfl⟩; simp at hy₁ hz₁; exact hv₀ ⟨hy₁, hz₁⟩
    have h1 := hmin (y₁, z₁) hv₁
    have h2 : G (y₀, z₀) = (g:ℤ)^2 * G (y₁, z₁) := by
      simp only [hG]; rw [hy₁, hz₁]; ring
    have h3 := hpos (y₁, z₁) hv₁
    by_contra hne
    have h4 : (2:ℤ) ≤ g := by
      have : 1 ≤ g := Nat.one_le_iff_ne_zero.mpr hg0
      have : g ≠ 1 := fun h => hne (hg ▸ h)
      omega
    have h5 : (4:ℤ) ≤ (g:ℤ)^2 := by nlinarith
    have h6 : 4 * G (y₁, z₁) ≤ (g:ℤ)^2 * G (y₁, z₁) := by nlinarith
    rw [← hμdef] at h2
    linarith
  -- Bezout
  have hbez : y₀ * Int.gcdA y₀ z₀ + z₀ * Int.gcdB y₀ z₀ = 1 := by
    have := Int.gcd_eq_gcd_ab y₀ z₀
    rw [hprim] at this; exact_mod_cast this.symm
  set s := Int.gcdA y₀ z₀
  set t := Int.gcdB y₀ z₀
  -- new form coefficients
  set B' := A*y₀*(-t) + B*(y₀*s + (-t)*z₀) + C*z₀*s with hB'
  set C' := A*t^2 - 2*B*t*s + C*s^2 with hC'
  have hcomp : ∀ Y Z : ℤ, G (y₀*Y - t*Z, z₀*Y + s*Z) = μ*Y^2 + 2*B'*Y*Z + C'*Z^2 := by
    intro Y Z; simp only [hG, hB', hC', hμdef]; ring
  have hdet' : μ*C' - B'^2 = A*C - B^2 := by
    have : μ*C' - B'^2 = (y₀*s + t*z₀)^2 * (A*C - B^2) := by
      simp only [hG, hB', hC', hμdef]; ring
    rw [this]
    have : y₀*s + t*z₀ = 1 := by linarith
    rw [this]; ring
  obtain ⟨Y, hY⟩ := exists_round μ B' hμpos
  have hne : (y₀*Y - t*1, z₀*Y + s*1) ∈ {v : ℤ × ℤ | ¬(v.1 = 0 ∧ v.2 = 0)} := by
    simp only [Set.mem_setOf_eq]
    rintro ⟨h1, h2⟩
    have ht : t = y₀*Y := by linarith
    have hs : s = -(z₀*Y) := by linarith
    have : y₀ * s + z₀ * t = 0 := by rw [ht, hs]; ring
    linarith
  have hge := hmin (y₀*Y - t*1, z₀*Y + s*1) hne
  rw [hcomp] at hge
  have hid2 : 4*μ*(μ*Y^2 + 2*B'*Y*1 + C'*1^2) = (2*(μ*Y + B'))^2 + 4*(μ*C' - B'^2) := by ring
  refine ⟨y₀, z₀, hv₀, ?_⟩
  have hμeq : A*y₀^2 + 2*B*y₀*z₀ + C*z₀^2 = μ := rfl
  rw [hμeq]
  nlinarith


