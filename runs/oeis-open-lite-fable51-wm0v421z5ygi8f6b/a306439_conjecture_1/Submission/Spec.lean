  have hs1' : 16 * (s:ℤ)^2 ≤ 24*(n:ℤ)+6 := by exact_mod_cast hs1
  have hs2' : 24*(n:ℤ)+6 < 16*((s:ℤ)+1)^2 := by exact_mod_cast hs2
  have hs3' : (566:ℤ) ≤ s := by exact_mod_cast hs3
  obtain ⟨m₂, hm₂⟩ : ∃ m₂ : ℤ, m₂ = (s:ℤ) - ((s:ℤ) - r) % 9 := ⟨_, rfl⟩
  have hm₂r : m₂ % 9 = r := by omega
  have hm₂le : m₂ ≤ s := by omega
  have hm₂ge : (s:ℤ) - 8 ≤ m₂ := by omega
  obtain ⟨m₁, hm₁⟩ : ∃ m₁ : ℤ, m₁ = m₂ - 9 := ⟨_, rfl⟩
  have hm₁r : m₁ % 9 = r := by omega
