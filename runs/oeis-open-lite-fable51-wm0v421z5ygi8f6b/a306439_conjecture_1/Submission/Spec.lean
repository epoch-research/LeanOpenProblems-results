/-- Every positive definite ternary form of determinant D ∈ {1,2} is equivalent to x²+y²+Dz². -/
theorem rep_of_det (F : TF) (hpos : F.PosDef) (hd0 : 0 < F.det) (hd : F.det ≤ 2) (x y z : ℤ) :
    ∃ A B C : ℤ, F.eval x y z = A^2 + B^2 + F.det * C^2 := by
  obtain ⟨a₁, b₁, c₁, h1⟩ := exists_eval_one F hpos hd0 hd
  have hv₁ : ¬(a₁ = 0 ∧ b₁ = 0 ∧ c₁ = 0) := by
    rintro ⟨rfl, rfl, rfl⟩; simp [eval] at h1
  have hprim : Int.gcd a₁ (Int.gcd b₁ c₁) = 1 := by
    obtain ⟨g, hg⟩ : ∃ g : ℕ, g = Int.gcd a₁ (Int.gcd b₁ c₁) := ⟨_, rfl⟩
    have hga : (g:ℤ) ∣ a₁ := hg ▸ Int.gcd_dvd_left _ _
    have hgbc : (g:ℤ) ∣ (Int.gcd b₁ c₁ : ℤ) := hg ▸ Int.gcd_dvd_right _ _
    have hgb : (g:ℤ) ∣ b₁ := hgbc.trans (Int.gcd_dvd_left _ _)
    have hgc : (g:ℤ) ∣ c₁ := hgbc.trans (Int.gcd_dvd_right _ _)
    obtain ⟨a₂, ha₂⟩ := hga
    obtain ⟨b₂, hb₂⟩ := hgb
    obtain ⟨c₂, hc₂⟩ := hgc
    have hg0 : g ≠ 0 := by
      rintro rfl
      simp at ha₂ hb₂ hc₂
      exact hv₁ ⟨ha₂, hb₂, hc₂⟩
    have hv₂ : ¬(a₂ = 0 ∧ b₂ = 0 ∧ c₂ = 0) := by
      rintro ⟨rfl, rfl, rfl⟩; simp at ha₂ hb₂ hc₂; exact hv₁ ⟨ha₂, hb₂, hc₂⟩
    have h2 : F.eval a₁ b₁ c₁ = (g:ℤ)^2 * F.eval a₂ b₂ c₂ := by
      simp only [eval]; rw [ha₂, hb₂, hc₂]; ring
    have h3 := hpos _ _ _ hv₂
    by_contra hne
    have h4 : (2:ℤ) ≤ g := by
      have : 1 ≤ g := Nat.one_le_iff_ne_zero.mpr hg0
      have : g ≠ 1 := fun h => hne (hg ▸ h)
      omega
    have h5 : (4:ℤ) ≤ (g:ℤ)^2 := by nlinarith
    have h6 : 4 * F.eval a₂ b₂ c₂ ≤ (g:ℤ)^2 * F.eval a₂ b₂ c₂ := by nlinarith
    linarith
  obtain ⟨v1, v2, v3, w1, w2, w3, hM⟩ := ext_basis a₁ b₁ c₁ hprim
  set F' := F.comp a₁ b₁ c₁ v1 v2 v3 w1 w2 w3 with hF'
  have hF'a : F'.a = 1 := h1
  have hF'det : F'.det = F.det := by rw [hF', comp_det, hM]; ring
  have hinj : ∀ x y z : ℤ, ¬(x = 0 ∧ y = 0 ∧ z = 0) →
      ¬(a₁*x + v1*y + w1*z = 0 ∧ b₁*x + v2*y + w2*z = 0 ∧ c₁*x + v3*y + w3*z = 0) := by
    intro x y z hne ⟨h1, h2, h3⟩
    obtain ⟨e1, e2, e3⟩ := adj_left a₁ b₁ c₁ v1 v2 v3 w1 w2 w3 x y z
    rw [h1, h2, h3, hM] at e1 e2 e3
    exact hne ⟨by linarith, by linarith, by linarith⟩
  have hF'pos : F'.PosDef := by
    intro x y z hne
    rw [hF', comp_eval]
    exact hpos _ _ _ (hinj x y z hne)
  -- binary form G(y,z) = (b' - p'^2) y^2 + 2 (r' - p' q') y z + (c' - q'^2) z^2 of det D
  have hA : 0 < F'.b - F'.p^2 := by
    have := minor_pos_of_posDef F' hF'pos; rw [hF'a] at this; linarith
  have hdetG : (F'.b - F'.p^2)*(F'.c - F'.q^2) - (F'.r - F'.p*F'.q)^2 = F.det := by
    have := schur_det F'; rw [hF'a, hF'det] at this; linarith
  obtain ⟨y₀, z₀, hyz, hG⟩ := binary_hermite _ _ _ hA (by rw [hdetG]; exact hd0)
  rw [hdetG] at hG
  set Gv := (F'.b - F'.p^2)*y₀^2 + 2*(F'.r - F'.p*F'.q)*y₀*z₀ + (F'.c - F'.q^2)*z₀^2 with hGv
  have hGpos : 0 < Gv := by
    have := hF'pos (-(F'.p*y₀ + F'.q*z₀)) y₀ z₀ (by rintro ⟨-, hy, hz⟩; exact hyz ⟨hy, hz⟩)
    have hid := schur_id F' (-(F'.p*y₀ + F'.q*z₀)) y₀ z₀
    rw [hF'a] at hid
    have : (1*(-(F'.p*y₀ + F'.q*z₀)) + F'.p*y₀ + F'.q*z₀) = 0 := by ring
    rw [this] at hid
    have e : (1*F'.b - F'.p^2)*y₀^2 + 2*(1*F'.r - F'.p*F'.q)*y₀*z₀ + (1*F'.c - F'.q^2)*z₀^2 = Gv := by
      rw [hGv]; ring
    rw [e] at hid
    linarith
  have hG1 : Gv = 1 := by
    by_contra hne
    have : 2 ≤ Gv := by omega
    nlinarith
  -- primitivity of (y₀, z₀)
  have hprim2 : Int.gcd y₀ z₀ = 1 := by
    obtain ⟨g, hg⟩ : ∃ g : ℕ, g = Int.gcd y₀ z₀ := ⟨_, rfl⟩
    have hgy : (g:ℤ) ∣ y₀ := hg ▸ Int.gcd_dvd_left y₀ z₀
    have hgz : (g:ℤ) ∣ z₀ := hg ▸ Int.gcd_dvd_right y₀ z₀
    obtain ⟨y₁, hy₁⟩ := hgy
    obtain ⟨z₁, hz₁⟩ := hgz
    have h2 : Gv = (g:ℤ)^2 * ((F'.b - F'.p^2)*y₁^2 + 2*(F'.r - F'.p*F'.q)*y₁*z₁ + (F'.c - F'.q^2)*z₁^2) := by
      rw [hGv, hy₁, hz₁]; ring
    have hg0 : g ≠ 0 := by
      rintro rfl; simp at hy₁ hz₁; exact hyz ⟨hy₁, hz₁⟩
    by_contra hne
    have h4 : (2:ℤ) ≤ g := by
      have : 1 ≤ g := Nat.one_le_iff_ne_zero.mpr hg0
      have : g ≠ 1 := fun h => hne (hg ▸ h)
      omega
    have h5 : (4:ℤ) ≤ (g:ℤ)^2 := by nlinarith
    have : (g:ℤ)^2 ∣ 1 := ⟨_, hG1 ▸ h2⟩
    have := Int.le_of_dvd one_pos this
    linarith
  have hbez : y₀ * Int.gcdA y₀ z₀ + z₀ * Int.gcdB y₀ z₀ = 1 := by
    have := Int.gcd_eq_gcd_ab y₀ z₀
    rw [hprim2] at this; exact_mod_cast this.symm
  set s := Int.gcdA y₀ z₀
  set t := Int.gcdB y₀ z₀
  -- coordinates of (x,y,z) in the basis M
  obtain ⟨x', hx'⟩ : ∃ x', x' = (v2*w3 - v3*w2)*x + (v3*w1 - v1*w3)*y + (v1*w2 - v2*w1)*z := ⟨_, rfl⟩
  obtain ⟨y', hy'⟩ : ∃ y', y' = (c₁*w2 - b₁*w3)*x + (a₁*w3 - c₁*w1)*y + (b₁*w1 - a₁*w2)*z := ⟨_, rfl⟩
  obtain ⟨z', hz'⟩ : ∃ z', z' = (b₁*v3 - c₁*v2)*x + (c₁*v1 - a₁*v3)*y + (a₁*v2 - b₁*v1)*z := ⟨_, rfl⟩
  have hadj := adj_right a₁ b₁ c₁ v1 v2 v3 w1 w2 w3 x y z
  rw [hM] at hadj
  obtain ⟨e1, e2, e3⟩ := hadj
  have e1' : a₁*x' + v1*y' + w1*z' = x := by rw [hx', hy', hz']; linarith
  have e2' : b₁*x' + v2*y' + w2*z' = y := by rw [hx', hy', hz']; linarith
  have e3' : c₁*x' + v3*y' + w3*z' = z := by rw [hx', hy', hz']; linarith
  have hFF' : F.eval x y z = F'.eval x' y' z' := by
    rw [hF', comp_eval, e1', e2', e3']
  have hschur := schur_id F' x' y' z'
  rw [hF'a] at hschur
  simp only [one_mul] at hschur
  -- binary form coefficients
  obtain ⟨A, hA'⟩ : ∃ A, A = F'.b - F'.p^2 := ⟨_, rfl⟩
  obtain ⟨Bc, hBc⟩ : ∃ Bc, Bc = F'.r - F'.p*F'.q := ⟨_, rfl⟩
  obtain ⟨C, hC⟩ : ∃ C, C = F'.c - F'.q^2 := ⟨_, rfl⟩
  rw [← hA', ← hBc, ← hC] at hschur hdetG hGv
  obtain ⟨Y, hY⟩ : ∃ Y, Y = s*y' + t*z' := ⟨_, rfl⟩
  obtain ⟨Z, hZ⟩ : ∃ Z, Z = -z₀*y' + y₀*z' := ⟨_, rfl⟩
  have hy'' : y' = y₀*Y - t*Z := by rw [hY, hZ]; linear_combination (-y') * hbez
  have hz'' : z' = z₀*Y + s*Z := by rw [hY, hZ]; linear_combination (-z') * hbez
  obtain ⟨B', hB'⟩ : ∃ B', B' = A*y₀*(-t) + Bc*(y₀*s + (-t)*z₀) + C*z₀*s := ⟨_, rfl⟩
  obtain ⟨C', hC'⟩ : ∃ C', C' = A*t^2 - 2*Bc*t*s + C*s^2 := ⟨_, rfl⟩
  have hcomp : A*y'^2 + 2*Bc*y'*z' + C*z'^2 = Gv*Y^2 + 2*B'*Y*Z + C'*Z^2 := by
    rw [hy'', hz'', hB', hC', hGv]; ring
  have hdet' : C' - B'^2 = F.det := by
    have : C' - B'^2 = (y₀*s + t*z₀)^2 * (A*C - Bc^2) - (Gv - 1) * C' := by
      rw [hB', hC', hGv]; ring
    rw [this, hG1, hdetG]
    have h1 : y₀*s + t*z₀ = 1 := by linarith
    rw [h1]; ring
  refine ⟨x' + F'.p*y' + F'.q*z', Y + B'*Z, Z, ?_⟩
  rw [hFF', ← hdet', hschur, hcomp, hG1]
  ring

end TF

/-- Every K ≡ 5 (mod 8) is X² + Y² + 2 Z² : this is the arithmetic core. -/
theorem key_prime (K : ℕ) (hK : K % 8 = 5) :
    ∃ P : ℕ, P.Prime ∧ 8 * K < P ∧ P % 8 = 3 ∧ K ∣ P + 1 := by
  have hK1 : 1 ≤ 4 * K := by omega
  have hcop : Nat.Coprime (4*K - 1) (8*K) := by
    apply Nat.isCoprime_iff_coprime.mp
    push_cast [Nat.cast_sub hK1]
    exact ⟨-(4*(K:ℤ)+1), 2*K, by ring⟩
  have hu : IsUnit (((4*K - 1 : ℕ)) : ZMod (8*K)) := (ZMod.isUnit_iff_coprime _ _).mpr hcop
  haveI : NeZero (8*K) := ⟨by omega⟩
  obtain ⟨P, hPgt, hP, hPmod⟩ := Nat.forall_exists_prime_gt_and_eq_mod hu (8*K)
  rw [ZMod.natCast_eq_natCast_iff'] at hPmod
  have hlt : 4*K - 1 < 8*K := by omega
  rw [Nat.mod_eq_of_lt hlt] at hPmod
  have hdm := Nat.div_add_mod P (8*K)
  rw [hPmod] at hdm
  obtain ⟨t, ht⟩ : ∃ t, t = P / (8*K) := ⟨_, rfl⟩
  rw [← ht] at hdm
  obtain ⟨A, hA⟩ : ∃ A, A = K * t := ⟨_, rfl⟩
  have hdm' : 8 * A + (4*K - 1) = P := by rw [hA]; linarith
  refine ⟨P, hP, hPgt, by omega, ⟨8*t + 4, ?_⟩⟩
  rw [← hdm', hA]; zify [hK1]; ring

theorem rep112 (K : ℕ) (hK : K % 8 = 5) : ∃ X Y Z : ℤ, (K:ℤ) = X^2 + Y^2 + 2*Z^2 := by
  obtain ⟨P, hP, hPgt, hP8, hKP⟩ := key_prime K hK
  haveI := Fact.mk hP
  have hPodd : Odd P := Nat.odd_iff.mpr (by omega)
  have hKodd : Odd K := Nat.odd_iff.mpr (by omega)
  have hK4 : K % 4 = 1 := by omega
  -- Jacobi symbol computation
  have hJ : jacobiSym (-2 * (K:ℤ)) P = 1 := by
    rw [jacobiSym.mul_left, jacobiSym.at_neg_two hPodd, ZMod.χ₈'_nat_eq_if_mod_eight]
    have h1 : ¬ (P % 2 = 0) := by omega
    have h2 : P % 8 = 1 ∨ P % 8 = 3 := Or.inr hP8
    rw [if_neg h1, if_pos h2, one_mul]
    rw [jacobiSym.quadratic_reciprocity_one_mod_four hK4 hPodd]
    have h3 : ((P:ℕ):ℤ) % K = (-1) % K := by
      obtain ⟨c, hc⟩ := hKP
      have : (P:ℤ) = -1 + (K:ℤ) * c := by
        have : ((P + 1 : ℕ) : ℤ) = ((K * c : ℕ) : ℤ) := by rw [hc]
        push_cast at this; linarith
      rw [this, Int.add_mul_emod_self_left]
    rw [jacobiSym.mod_left' h3, jacobiSym.at_neg_one hKodd, ZMod.χ₄_nat_one_mod_four hK4]
  obtain ⟨s, hs⟩ := ZMod.isSquare_of_jacobiSym_eq_one hJ
  have hKne : (K : ZMod P) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro hdvd
    have := Nat.le_of_dvd (by omega) hdvd
    omega
  obtain ⟨e, he⟩ : ∃ e : ZMod P, e = s * (K : ZMod P)⁻¹ := ⟨_, rfl⟩
  have hKe : (K : ZMod P) * e^2 = -2 := by
    rw [he]
    have : (K : ZMod P) * (s * (K : ZMod P)⁻¹)^2 = (s * s) * ((K : ZMod P) * (K : ZMod P)⁻¹) * (K : ZMod P)⁻¹ := by ring
    rw [this, mul_inv_cancel₀ hKne, mul_one]
    push_cast at hs
    rw [← hs]
    have : (-2 * (K : ZMod P)) * (K : ZMod P)⁻¹ = -2 * ((K : ZMod P) * (K : ZMod P)⁻¹) := by ring
    rw [this, mul_inv_cancel₀ hKne, mul_one]
  obtain ⟨e₀, he₀⟩ : ∃ e₀ : ℕ, e₀ = e.val := ⟨_, rfl⟩
  have hPdvd : P ∣ 2 + K * e₀^2 := by
    rw [← ZMod.natCast_eq_zero_iff]
    push_cast
    rw [he₀, ZMod.natCast_zmod_val, hKe]; ring
  obtain ⟨c, hc⟩ := hPdvd
  obtain ⟨b, hb⟩ := hKP
  -- the ternary form
  let F : TF := ⟨K, b, c, 1, 0, e₀⟩
  have hb' : (K:ℤ) * b = P + 1 := by exact_mod_cast hb.symm
  have hc' : (P:ℤ) * c = 2 + K * e₀^2 := by exact_mod_cast hc.symm
  have hdet : F.det = 2 := by
    simp only [TF.det, F]
    linear_combination (c:ℤ) * hb' + hc'
  have hpos : F.PosDef := by
    apply TF.posDef_of_sylvester
    · show (0:ℤ) < K; exact_mod_cast (show 0 < K by omega)
    · show (0:ℤ) < K * b - 1^2; rw [hb']; have : (0:ℤ) < P := by exact_mod_cast hP.pos
      linarith
    · rw [hdet]; norm_num
  obtain ⟨A, B, C, hABC⟩ := TF.rep_of_det F hpos (by rw [hdet]; norm_num) (by rw [hdet]) 1 0 0
  refine ⟨A, B, C, ?_⟩
  rw [hdet] at hABC
  have : F.eval 1 0 0 = K := by simp [TF.eval, F]
  rw [← this, hABC]


theorem sq_mod8 (x : ℤ) : ((x^2 % 8 = 0 ∨ x^2 % 8 = 4) ∧ x % 2 = 0) ∨ (x^2 % 8 = 1 ∧ x % 2 = 1) := by
  have h := Int.emod_emod_of_dvd x (by norm_num : (2:ℤ) ∣ 8)
  have hm : x^2 ≡ (x % 8)^2 [ZMOD 8] := (Int.mod_modEq x 8).symm.pow 2
  have h0 := Int.emod_nonneg x (by norm_num : (8:ℤ) ≠ 0)
  have h1 := Int.emod_lt_of_pos x (by norm_num : (0:ℤ) < 8)
  rw [← h]
  unfold Int.ModEq at hm
  rw [hm]
  obtain ⟨r, hr⟩ : ∃ r, r = x % 8 := ⟨_, rfl⟩
  rw [← hr] at h0 h1 ⊢
  interval_cases r <;> norm_num

theorem odd_of_rep (x y z : ℤ) (h : (3*x^2 + 4*y^2 + 6*z^2) % 8 = 5) : Odd x ∧ Odd y ∧ Odd z := by
  have hx := sq_mod8 x
  have hy := sq_mod8 y
  have hz := sq_mod8 z
  simp only [Int.odd_iff]
  omega

theorem mod3_cases (X Y Z : ℤ) (h : (X^2 + Y^2 + 2*Z^2) % 3 = 1) :
    3 ∣ X - Z ∨ 3 ∣ X + Z ∨ (3 ∣ Y ∧ 3 ∣ Z) := by
  have key : ∀ x y z : ZMod 3, x^2 + y^2 + 2*z^2 = 1 → x - z = 0 ∨ x + z = 0 ∨ (y = 0 ∧ z = 0) := by
    decide
  have h1 : (3:ℤ) ∣ 1 - (X^2 + Y^2 + 2*Z^2) := (Int.ModEq.dvd (h : _ ≡ 1 [ZMOD 3]))
  have h2 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mpr h1
  push_cast at h2
  have h3 : (X:ZMod 3)^2 + (Y:ZMod 3)^2 + 2*(Z:ZMod 3)^2 = 1 := by linear_combination -h2
  rcases key _ _ _ h3 with h4 | h4 | ⟨h4, h5⟩
  · left; exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp (by push_cast; exact h4)
  · right; left; exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp (by push_cast; exact h4)
  · right; right
    exact ⟨(ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp h4, (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp h5⟩

theorem descent (K : ℤ) (hK3 : K % 3 = 1) : ∀ n : ℕ, ∀ X Y Z : ℤ, K = X^2 + Y^2 + 2*Z^2 →
    Y % 2 = 0 → ¬((3:ℤ)^n ∣ Y ∧ (3:ℤ)^n ∣ Z) → ∃ x y z : ℤ, K = 3*x^2 + 4*y^2 + 6*z^2 := by
  intro n
  induction n with
  | zero =>
    intro X Y Z _ _ hn
    exact absurd ⟨by simp, by simp⟩ hn
  | succ n ih =>
    intro X Y Z hK hY hn
    obtain ⟨y, hy⟩ : ∃ y, Y = 2*y := ⟨Y/2, by omega⟩
    rw [hK] at hK3
    rcases mod3_cases X Y Z hK3 with ⟨d, hd⟩ | ⟨d, hd⟩ | ⟨⟨Y₁, hY₁⟩, ⟨Z₁, hZ₁⟩⟩
    · refine ⟨d + Z, y, d, ?_⟩
      have : X = 3*d + Z := by linarith
      rw [hK, this, hy]; ring
    · refine ⟨d - Z, y, d, ?_⟩
      have : X = 3*d - Z := by linarith
      rw [hK, this, hy]; ring
    · have hY₁e : Y₁ % 2 = 0 := by omega
      by_cases h : (3:ℤ)^n ∣ (Y₁ - 4*Z₁) ∧ (3:ℤ)^n ∣ (-2*Y₁ - Z₁)
      · have h' : ¬((3:ℤ)^n ∣ (Y₁ + 4*Z₁) ∧ (3:ℤ)^n ∣ (2*Y₁ - Z₁)) := by
          rintro ⟨h1, h2⟩
          have hcop : IsCoprime ((3:ℤ)^n) 2 := IsCoprime.pow_left ⟨1, -1, by norm_num⟩
          have h3 : (3:ℤ)^n ∣ 2 * Y₁ := by
            have := dvd_add h.1 h1
            have e : Y₁ - 4*Z₁ + (Y₁ + 4*Z₁) = 2 * Y₁ := by ring
            rwa [e] at this
          have h4 : (3:ℤ)^n ∣ 2 * (-4 * Z₁) := by
            have := dvd_sub h.2 h2
            have e : -2*Y₁ - Z₁ - (2*Y₁ - Z₁) = 2 * (-2 * Y₁) := by ring
            rw [e] at this
            have h5 := dvd_sub h1 h.1
            have e2 : Y₁ + 4*Z₁ - (Y₁ - 4*Z₁) = 2 * (4 * Z₁) := by ring
            rw [e2] at h5
            have := dvd_neg.mpr h5
            have e3 : -(2 * (4 * Z₁)) = 2 * (-4 * Z₁) := by ring
            rwa [e3] at this
          have h5 : (3:ℤ)^n ∣ Y₁ := hcop.dvd_of_dvd_mul_left h3
          have h6 : (3:ℤ)^n ∣ -4 * Z₁ := hcop.dvd_of_dvd_mul_left h4
          have hcop4 : IsCoprime ((3:ℤ)^n) (-4) := IsCoprime.pow_left ⟨-1, -1, by norm_num⟩
          have h7 : (3:ℤ)^n ∣ Z₁ := hcop4.dvd_of_dvd_mul_left h6
          apply hn
          rw [pow_succ, hY₁, hZ₁, mul_comm]
          exact ⟨mul_dvd_mul_left 3 h5, mul_dvd_mul_left 3 h7⟩
        apply ih X (Y₁ + 4*Z₁) (2*Y₁ - Z₁) _ (by omega) h'
        rw [hK, hY₁, hZ₁]; ring
      · apply ih X (Y₁ - 4*Z₁) (-2*Y₁ - Z₁) _ (by omega) h
        rw [hK, hY₁, hZ₁]; ring

theorem not_both_dvd (Y Z : ℤ) (hne : ¬(Y = 0 ∧ Z = 0)) :
    ¬((3:ℤ)^(Y.natAbs + Z.natAbs) ∣ Y ∧ (3:ℤ)^(Y.natAbs + Z.natAbs) ∣ Z) := by
  rintro ⟨h1, h2⟩
  have hlt : Y.natAbs + Z.natAbs < 3^(Y.natAbs + Z.natAbs) := Nat.lt_pow_self (by norm_num)
  have h1' := Int.natAbs_dvd_natAbs.mpr h1
  have h2' := Int.natAbs_dvd_natAbs.mpr h2
  have e3 : (3:ℤ).natAbs = 3 := rfl
  simp only [Int.natAbs_pow, e3] at h1' h2'
  by_cases hY : Y = 0
  · have hZ : Z ≠ 0 := fun h => hne ⟨hY, h⟩
    have := Nat.le_of_dvd (Int.natAbs_pos.mpr hZ) h2'
    omega
  · have := Nat.le_of_dvd (Int.natAbs_pos.mpr hY) h1'
    omega

theorem claimB_of_rep (K : ℤ) (hK : K % 24 = 13) (X Y Z : ℤ) (h : K = X^2 + Y^2 + 2*Z^2) :
    ∃ x y z : ℤ, Odd x ∧ Odd y ∧ Odd z ∧ K = 3*x^2 + 4*y^2 + 6*z^2 := by
  have hK3 : K % 3 = 1 := by omega
  have hK8 : K % 8 = 5 := by omega
  have hX := sq_mod8 X
  have hY := sq_mod8 Y
  have hZ := sq_mod8 Z
  suffices hs : ∃ x y z : ℤ, K = 3*x^2 + 4*y^2 + 6*z^2 by
    obtain ⟨x, y, z, hxyz⟩ := hs
    have := odd_of_rep x y z (by rw [← hxyz]; exact hK8)
    exact ⟨x, y, z, this.1, this.2.1, this.2.2, hxyz⟩
  by_cases hXo : X % 2 = 1
  · apply descent K hK3 (Y.natAbs + Z.natAbs) X Y Z h (by omega)
    apply not_both_dvd
    rintro ⟨rfl, rfl⟩
    omega
  · apply descent K hK3 (X.natAbs + Z.natAbs) Y X Z (by rw [h]; ring) (by omega)
    apply not_both_dvd
    rintro ⟨rfl, rfl⟩
    omega

theorem claimB (K : ℕ) (hK : K % 24 = 13) :
    ∃ x y z : ℤ, Odd x ∧ Odd y ∧ Odd z ∧ (K:ℤ) = 3*x^2 + 4*y^2 + 6*z^2 := by
  obtain ⟨X, Y, Z, h⟩ := rep112 K (by omega)
  exact claimB_of_rep K (by omega) X Y Z h

theorem P3_sq (k : ℕ) : ((24 * P3 k + 1 : ℕ) : ℤ) = (6*(k:ℤ)+1)^2 := by
  unfold P3
  have h2 : 2 ∣ k * (3 * k + 1) := by
    rcases Nat.even_or_odd' k with ⟨j, rfl | rfl⟩
    · exact ⟨j * (3 * (2*j) + 1), by ring⟩
    · exact ⟨(2*j+1) * (3*j+2), by ring⟩
  obtain ⟨t, ht⟩ := h2
  rw [ht, Nat.mul_div_cancel_left t (by norm_num)]
  have ht' : ((k * (3*k+1) : ℕ) : ℤ) = ((2 * t : ℕ) : ℤ) := by rw [ht]
  push_cast at ht' ⊢
  linear_combination (-12) * ht'

theorem sq_mod3 (x : ℤ) : (x^2 % 3 = 0 ∧ x % 3 = 0) ∨ (x^2 % 3 = 1 ∧ x % 3 ≠ 0) := by
  have hm : x^2 ≡ (x % 3)^2 [ZMOD 3] := (Int.mod_modEq x 3).symm.pow 2
  have h0 := Int.emod_nonneg x (by norm_num : (3:ℤ) ≠ 0)
  have h1 := Int.emod_lt_of_pos x (by norm_num : (0:ℤ) < 3)
  unfold Int.ModEq at hm
  rw [hm]
  obtain ⟨r, hr⟩ : ∃ r, r = x % 3 := ⟨_, rfl⟩
  rw [← hr] at h0 h1 ⊢
  interval_cases r <;> norm_num

theorem mem_sol_of_int (n : ℕ) (a b c d : ℤ) (ha : a % 6 = 1) (hb : b % 6 = 1) (hc : c % 6 = 1)
    (hd : d % 6 = 1) (ha1 : 0 < a) (hb1 : 0 < b) (hc1 : 0 < c) (hd1 : 0 < d) (hab : a ≤ b)
    (h : a^2 + b^2 + 2*c^2 + 3*d^2 = 24*(n:ℤ) + 7) :
    ∃ x y z w : ℕ, ((x, y), (z, w)) ∈ sol n ∧ a = 6*x+1 ∧ b = 6*y+1 ∧ c = 6*z+1 ∧ d = 6*w+1 := by
  obtain ⟨x, hx⟩ : ∃ x : ℕ, a = 6*x+1 :=
    ⟨((a-1)/6).toNat, by have := Int.toNat_of_nonneg (show 0 ≤ (a-1)/6 by omega); omega⟩
  obtain ⟨y, hy⟩ : ∃ y : ℕ, b = 6*y+1 :=
    ⟨((b-1)/6).toNat, by have := Int.toNat_of_nonneg (show 0 ≤ (b-1)/6 by omega); omega⟩
  obtain ⟨z, hz⟩ : ∃ z : ℕ, c = 6*z+1 :=
    ⟨((c-1)/6).toNat, by have := Int.toNat_of_nonneg (show 0 ≤ (c-1)/6 by omega); omega⟩
  obtain ⟨w, hw⟩ : ∃ w : ℕ, d = 6*w+1 :=
    ⟨((d-1)/6).toNat, by have := Int.toNat_of_nonneg (show 0 ≤ (d-1)/6 by omega); omega⟩
  refine ⟨x, y, z, w, mem_sol (by omega) ?_, hx, hy, hz, hw⟩
  have h1 := P3_sq x
  have h2 := P3_sq y
  have h3 := P3_sq z
  have h4 := P3_sq w
  push_cast at h1 h2 h3 h4
  have : (24:ℤ) * (P3 x + P3 y + 2 * P3 z + 3 * P3 w : ℕ) = 24 * n := by
    push_cast
    rw [hx, hy, hz, hw] at h
    linear_combination h + h1 + h2 + 2*h3 + 3*h4
  have : ((P3 x + P3 y + 2 * P3 z + 3 * P3 w : ℕ) : ℤ) = n := by linarith
  exact_mod_cast this.symm

/-- The design (1,1,1,2): one representation per admissible `m`. -/
theorem design (n : ℕ) (m : ℤ) (hm0 : 0 ≤ m) (hm3 : m % 3 = 1) (hmod : (24*(n:ℤ)+7 - 16*m^2) % 72 = 39)
    (hlt : 16*m^2 < 24*(n:ℤ)+7) (hpos : 15*(24*(n:ℤ)+7) < 256*m^2) :
    ∃ x y z w : ℕ, ((x, y), (z, w)) ∈ sol n ∧
      (6*(x:ℤ)+1) + (6*y+1) + 2*(6*z+1) + 6*(6*w+1) = 16*m := by
  obtain ⟨M, hM⟩ : ∃ M, M = m^2 := ⟨_, rfl⟩
  rw [← hM] at hmod hlt hpos
  obtain ⟨K, hK⟩ : ∃ K : ℕ, (K:ℤ) = (24*(n:ℤ)+7 - 16*M)/3 :=
    ⟨((24*(n:ℤ)+7 - 16*M)/3).toNat, Int.toNat_of_nonneg (by omega)⟩
  have hK3 : 3 * (K:ℤ) = 24*(n:ℤ)+7 - 16*M := by omega
  have hK24 : K % 24 = 13 := by
    have : (K:ℤ) % 24 = 13 := by omega
    omega
  obtain ⟨T₀, y₀, E, hT₀, hy₀, hE, hrep⟩ := claimB K hK24
  rw [Int.odd_iff] at hT₀ hy₀ hE
  have hy3 : y₀ % 3 ≠ 0 := by
    have hA := sq_mod3 T₀
    have hB := sq_mod3 y₀
    have hC := sq_mod3 E
    generalize T₀^2 = A at hA hrep
    generalize y₀^2 = B at hB hrep
    generalize E^2 = C at hC hrep
    omega
  -- choose the sign of y so that y ≡ 5 (mod 6)
  obtain ⟨y, hy5, hysq⟩ : ∃ y : ℤ, y % 6 = 5 ∧ y^2 = y₀^2 := by
    by_cases h : y₀ % 6 = 5
    · exact ⟨y₀, h, rfl⟩
    · refine ⟨-y₀, ?_, by ring⟩
      have h6 : y₀ % 6 = 1 := by omega
      have : -y₀ = 5 + 6 * (-(y₀/6) - 1) := by omega
      rw [this, Int.add_mul_emod_self_left]; norm_num
  -- choose the sign of T so that the parity condition holds
  obtain ⟨g, hg⟩ : ∃ g : ℤ, T₀ = y + 2*g := ⟨(T₀ - y)/2, by omega⟩
  obtain ⟨T, hTsq, hTodd, hpar⟩ : ∃ T : ℤ, T^2 = T₀^2 ∧ T % 2 = 1 ∧ (m + (T - y)/2) % 2 = 1 := by
    by_cases h : (m + g) % 2 = 1
    · exact ⟨T₀, rfl, hT₀, by rw [hg]; omega⟩
    · refine ⟨-T₀, by ring, by omega, ?_⟩
      have : (-T₀ - y)/2 = -y - g := by rw [hg]; omega
      rw [this]; omega
  obtain ⟨g', hg'⟩ : ∃ g' : ℤ, T = y + 2*g' := ⟨(T - y)/2, by omega⟩
  have hpar' : (m + g') % 2 = 1 := by
    have : (T - y)/2 = g' := by rw [hg']; omega
    rwa [this] at hpar
  clear hpar hg g
  have hrep' : (K:ℤ) = 3*(y + 2*g')^2 + 4*y^2 + 6*E^2 := by
    rw [hrep, ← hg', hTsq, hysq]
  -- the four coordinates
  obtain ⟨v₁, hv₁⟩ : ∃ v₁ : ℤ, v₁ = m + 3*E - 3*y - 3*g' := ⟨_, rfl⟩
  obtain ⟨v₂, hv₂⟩ : ∃ v₂ : ℤ, v₂ = m - 3*E - 3*y - 3*g' := ⟨_, rfl⟩
  obtain ⟨v₃, hv₃⟩ : ∃ v₃ : ℤ, v₃ = m + 3*g' := ⟨_, rfl⟩
  obtain ⟨v₄, hv₄⟩ : ∃ v₄ : ℤ, v₄ = 2*m + y := ⟨_, rfl⟩
  have hQ : v₁^2 + v₂^2 + 2*v₃^2 + 3*v₄^2 = 24*(n:ℤ)+7 := by
    rw [hv₁, hv₂, hv₃, hv₄]
    have : 24*(n:ℤ)+7 = 16*m^2 + 3*K := by rw [hK3, hM]; ring
    rw [this, hrep']; ring
  have hN0 : 0 < 24*(n:ℤ)+7 := by omega
  -- positivity
  have hv₁p : 0 < v₁ := by
    by_contra hle; push_neg at hle
    have h1 : m^2 ≤ (-(3*E - 3*y - 3*g'))^2 := pow_le_pow_left₀ hm0 (by rw [hv₁] at hle; linarith) 2
    rw [neg_sq, ← hM] at h1
    have h2 : 7*(45*K - 16*(3*E - 3*y - 3*g')^2) = 18*(7*E + 8*(y+g'))^2 + 45*(6*(y+g') - 7*y)^2 := by
      rw [hrep']; ring
    have h3 : 0 ≤ 18*(7*E + 8*(y+g'))^2 + 45*(6*(y+g') - 7*y)^2 := by positivity
    linarith
  have hv₂p : 0 < v₂ := by
    by_contra hle; push_neg at hle
    have h1 : m^2 ≤ (-(-3*E - 3*y - 3*g'))^2 := pow_le_pow_left₀ hm0 (by rw [hv₂] at hle; linarith) 2
    rw [neg_sq, ← hM] at h1
    have h2 : 7*(45*K - 16*(-3*E - 3*y - 3*g')^2) = 18*(-7*E + 8*(y+g'))^2 + 45*(6*(y+g') - 7*y)^2 := by
      rw [hrep']; ring
    have h3 : 0 ≤ 18*(-7*E + 8*(y+g'))^2 + 45*(6*(y+g') - 7*y)^2 := by positivity
    linarith
  have hv₃p : 0 < v₃ := by
    by_contra hle; push_neg at hle
    have h1 : m^2 ≤ (-(3*g'))^2 := pow_le_pow_left₀ hm0 (by rw [hv₃] at hle; linarith) 2
    rw [neg_sq, ← hM] at h1
    have h2 : 21*K - 16*(3*g')^2 = 3*(6*(y+g') + y)^2 + 126*E^2 := by
      rw [hrep']; ring
    have h3 : 0 ≤ 3*(6*(y+g') + y)^2 + 126*E^2 := by positivity
    linarith
  have hv₄p : 0 < v₄ := by
