/-- Ternary forms of small determinant represent 1 -/
theorem exists_eval_one (F : TF) (hpos : F.PosDef) (hd0 : 0 < F.det) (hd : F.det ≤ 2) :
    ∃ x y z : ℤ, F.eval x y z = 1 := by
  set S : Set (ℤ × ℤ × ℤ) := {v | ¬(v.1 = 0 ∧ v.2.1 = 0 ∧ v.2.2 = 0)} with hS
  have hpos' : ∀ v ∈ S, 0 < F.eval v.1 v.2.1 v.2.2 := fun v hv => hpos _ _ _ hv
  obtain ⟨⟨a₁, b₁, c₁⟩, hv₁, hmin⟩ := exists_min_pos (fun v : ℤ × ℤ × ℤ => F.eval v.1 v.2.1 v.2.2) S hpos'
    ⟨(1, 0, 0), by simp [hS]⟩
  simp only [hS, Set.mem_setOf_eq] at hv₁ hmin
  set m := F.eval a₁ b₁ c₁ with hm
  have hmpos : 0 < m := hpos _ _ _ hv₁
  -- primitivity
  have hprim : Int.gcd a₁ (Int.gcd b₁ c₁) = 1 := by
    obtain ⟨g, hg⟩ : ∃ g : ℕ, g = Int.gcd a₁ (Int.gcd b₁ c₁) := ⟨_, rfl⟩
    have hga : (g:ℤ) ∣ a₁ := hg ▸ Int.gcd_dvd_left _ _
    have hgbc : (g:ℤ) ∣ (Int.gcd b₁ c₁ : ℤ) := hg ▸ Int.gcd_dvd_right _ _
    have hgb : (g:ℤ) ∣ b₁ := hgbc.trans (Int.gcd_dvd_left _ _)
    have hgc : (g:ℤ) ∣ c₁ := hgbc.trans (Int.gcd_dvd_right _ _)
    obtain ⟨a₂, ha₂⟩ := hga
    obtain ⟨b₂, hb₂⟩ := hgb
    obtain ⟨c₂, hc₂⟩ := hgc
    have hg0 : g ≠ 0 := by
      rintro rfl
      simp at ha₂ hb₂ hc₂
      exact hv₁ ⟨ha₂, hb₂, hc₂⟩
    have hv₂ : ¬(a₂ = 0 ∧ b₂ = 0 ∧ c₂ = 0) := by
      rintro ⟨rfl, rfl, rfl⟩; simp at ha₂ hb₂ hc₂; exact hv₁ ⟨ha₂, hb₂, hc₂⟩
    have h1 := hmin (a₂, b₂, c₂) hv₂
    have h2 : F.eval a₁ b₁ c₁ = (g:ℤ)^2 * F.eval a₂ b₂ c₂ := by
      simp only [eval]; rw [ha₂, hb₂, hc₂]; ring
    have h3 := hpos _ _ _ hv₂
    by_contra hne
    have h4 : (2:ℤ) ≤ g := by
      have : 1 ≤ g := Nat.one_le_iff_ne_zero.mpr hg0
      have : g ≠ 1 := fun h => hne (hg ▸ h)
      omega
    have h5 : (4:ℤ) ≤ (g:ℤ)^2 := by nlinarith
    have h6 : 4 * F.eval a₂ b₂ c₂ ≤ (g:ℤ)^2 * F.eval a₂ b₂ c₂ := by nlinarith
    simp only at h1
    linarith
  obtain ⟨v1, v2, v3, w1, w2, w3, hM⟩ := ext_basis a₁ b₁ c₁ hprim
  set F' := F.comp a₁ b₁ c₁ v1 v2 v3 w1 w2 w3 with hF'
  have hF'a : F'.a = m := rfl
  have hF'det : F'.det = F.det := by rw [hF', comp_det, hM]; ring
  have hinj : ∀ x y z : ℤ, ¬(x = 0 ∧ y = 0 ∧ z = 0) →
      ¬(a₁*x + v1*y + w1*z = 0 ∧ b₁*x + v2*y + w2*z = 0 ∧ c₁*x + v3*y + w3*z = 0) := by
    intro x y z hne ⟨h1, h2, h3⟩
    obtain ⟨e1, e2, e3⟩ := adj_left a₁ b₁ c₁ v1 v2 v3 w1 w2 w3 x y z
    rw [h1, h2, h3, hM] at e1 e2 e3
    exact hne ⟨by linarith, by linarith, by linarith⟩
  have hF'pos : F'.PosDef := by
    intro x y z hne
    rw [hF', comp_eval]
    exact hpos _ _ _ (hinj x y z hne)
  have hF'min : ∀ x y z : ℤ, ¬(x = 0 ∧ y = 0 ∧ z = 0) → m ≤ F'.eval x y z := by
    intro x y z hne
    rw [hF', comp_eval]
    exact hmin (_, _, _) (hinj x y z hne)
  -- Schur complement binary form
  have hA : 0 < F'.a*F'.b - F'.p^2 := minor_pos_of_posDef F' hF'pos
  have hdetG : 0 < (F'.a*F'.b - F'.p^2)*(F'.a*F'.c - F'.q^2) - (F'.a*F'.r - F'.p*F'.q)^2 := by
    rw [schur_det, hF'det, hF'a]; positivity
  obtain ⟨y, z, hyz, hG⟩ := binary_hermite _ _ _ hA hdetG
  rw [schur_det, hF'det, hF'a] at hG
  obtain ⟨x, hx⟩ := exists_round m (F'.p*y + F'.q*z) hmpos
  have hid := schur_id F' x y z
  rw [hF'a] at hid
  have hge := hF'min x y z (by rintro ⟨-, hy, hz⟩; exact hyz ⟨hy, hz⟩)
  set G := (m*F'.b - F'.p^2)*y^2 + 2*(m*F'.r - F'.p*F'.q)*y*z + (m*F'.c - F'.q^2)*z^2 with hGdef
  have hx' : (2*(m*x + F'.p*y + F'.q*z))^2 ≤ m^2 := by
    have : 2*(m*x + F'.p*y + F'.q*z) = 2*(m*x + (F'.p*y + F'.q*z)) := by ring
    rw [this]; exact hx
  have hmm := mul_le_mul_of_nonneg_left hge hmpos.le
  have h3 : 3*m^2 ≤ 4*G := by nlinarith
  have hGnn : 0 ≤ G := by nlinarith
  have h4 : (3*m^2)^2 ≤ (4*G)^2 := pow_le_pow_left₀ (by positivity) h3 2
  have h5 : 27*m^4 ≤ 128*m := by
    have h4' : 9*m^4 ≤ 16*G^2 := by nlinarith
    nlinarith
  have h6 : 27*m^3 ≤ 128 := by
    have : m * (27*m^3) ≤ m * 128 := by nlinarith
    exact le_of_mul_le_mul_left this hmpos
  have hm1 : m = 1 := by
    by_contra hne
    have : 2 ≤ m := by omega
    nlinarith
  exact ⟨a₁, b₁, c₁, hm1⟩

