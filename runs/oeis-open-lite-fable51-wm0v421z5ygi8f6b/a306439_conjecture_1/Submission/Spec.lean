theorem res_of_mod9 (n : ℕ) (m r : ℤ) (hm : m % 9 = r) (hr : (24*(n:ℤ)+7 - 16*r^2) % 72 = 39) :
    (24*(n:ℤ)+7 - 16*m^2) % 72 = 39 := by
