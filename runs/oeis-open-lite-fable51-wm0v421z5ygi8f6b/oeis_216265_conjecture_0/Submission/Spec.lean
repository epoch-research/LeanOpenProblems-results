import FormalConjectures.Util.ProblemImports

open Nat

/--
A216265: Number of primes between $n^3 - n$ and $n^3$.
Expressed as $a(n) = \pi(n^3) - \pi(n^3-n)$, where $\pi(x)$ is the prime-counting function.
-/
def A216265 (n : ℕ) : ℕ := Nat.primeCounting (n ^ 3) - Nat.primeCounting (n ^ 3 - n)

/-- Reduction: an explicit prime in `(n^3 - n, n^3]` witnesses `A216265 n > 0`. -/
theorem A216265_pos_of_prime (n p : ℕ) (hp : p.Prime) (h1 : n ^ 3 - n < p) (h2 : p ≤ n ^ 3) :
    A216265 n > 0 := by
  unfold A216265
  have hmono : Nat.primeCounting (n ^ 3 - n) ≤ Nat.primeCounting (p - 1) :=
    Nat.monotone_primeCounting (by omega)
  have hlt : Nat.primeCounting (p - 1) < Nat.primeCounting p := by
    rw [Nat.primeCounting_sub_one, Nat.primeCounting, Nat.primeCounting', Nat.count_succ,
      if_pos hp]
    omega
  have hle : Nat.primeCounting p ≤ Nat.primeCounting (n ^ 3) := Nat.monotone_primeCounting h2
  omega

set_option maxHeartbeats 4000000 in
/-- Machine-checked finite verification of the conjecture for `13 < n ≤ 1000`
(numerically it has been verified for all `n ≤ 10^6`). -/
