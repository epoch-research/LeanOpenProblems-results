/- ### Full check over a range of `z` -/

def checkAll (n0 X0 Y0 : Nat) (L : List (Nat × Nat × Nat)) (PL : List Nat) (zlo zlen : Nat) : Bool :=
  loopAll (fun k => loopAll (fun y => checkPair n0 X0 L PL y (zlo + k)) Y0) zlen

theorem checkAll_spec {n0 X0 Y0 : Nat} {L : List (Nat × Nat × Nat)} {PL : List Nat} {zlo zlen : Nat}
    (h : checkAll n0 X0 Y0 L PL zlo zlen = true)
    (hL : ∀ p ∈ L, GoodTab p.1 p.2.1) (hJ : ∀ p ∈ L, GoodRep p.1 p.2.2 X0)
    (hPL : ∀ p ∈ PL, p.Prime ∧ p % 3 = 2 ∧ p ≠ 2) :
    ∀ w x y z, x < X0 → y < Y0 → zlo ≤ z → z < zlo + zlen →
      (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n0 := by
  intro w x y z hx hy hz1 hz2
  have h1 := loopAll_spec h (z - zlo) (by omega)
  have h2 := loopAll_spec h1 y hy
  have h3 : zlo + (z - zlo) = z := by omega
  rw [h3] at h2
  exact checkPair_spec h2 hL hJ hPL w x hx

