import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A306477: Number of ways to write $n$ as $\binom{w+2}{2} + \binom{x+3}{4} + \binom{y+5}{6} + \binom{z+7}{8}$
with $w,x,y,z$ nonnegative integers, where $\binom{m}{k}$ denotes the binomial coefficient $\frac{m!}{k!(m-k)!}$.
-/
def A306477 (n : ℕ) : ℕ :=
  let R := Finset.range (n + 1)
  R.sum (fun w =>
    R.sum (fun x =>
      R.sum (fun y =>
        R.sum (fun z =>
          if (w + 2).choose 2 + (x + 3).choose 4 + (y + 5).choose 6 + (z + 7).choose 8 = n then 1 else 0
        )
      )
    )
  )


namespace D2468

/- ### Generic kernel-friendly loops -/

/-- `loopAll f len = true` iff `f k = true` for all `k < len`. Written with `Nat.rec` for
fast kernel reduction. -/
def loopAll (f : Nat → Bool) (len : Nat) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun k ih => f k && ih) len

theorem loopAll_succ (f : Nat → Bool) (k : Nat) : loopAll f (k+1) = (f k && loopAll f k) := rfl

theorem loopAll_spec {f : Nat → Bool} {len : Nat} (h : loopAll f len = true) :
    ∀ k, k < len → f k = true := by
  induction len with
  | zero => intro k hk; omega
  | succ n ih =>
    rw [loopAll_succ, Bool.and_eq_true] at h
    intro k hk
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with h1 | h1
    · exact ih h.2 k h1
    · subst h1; exact h.1

/-- fuel-bounded binary search for the position of the top bit (correctness not needed). -/
def lg2 (v : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ r => r)
    (fun k ih v r => cond (Nat.beq (v >>> (2 ^ k)) 0) (ih v r) (ih (v >>> (2 ^ k)) (r + 2 ^ k))) 14 v 0

/-- Iterate over the set bits of `S`, checking `g` on each bit index. Each step verifies
that the chosen bit is set and clears it. -/
def bitLoop (g : Nat → Bool) (fuel : Nat) : Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Bool) (fun S => Nat.beq S 0)
    (fun _ ih S => cond (Nat.beq S 0) true
      (let x := lg2 S
       cond (Nat.beq ((S >>> x) &&& 1) 1) (g x && ih (S ^^^ (1 <<< x))) false)) fuel

theorem bitLoop_zero (g : Nat → Bool) (S : Nat) : bitLoop g 0 S = Nat.beq S 0 := rfl
theorem bitLoop_succ (g : Nat → Bool) (fuel S : Nat) :
    bitLoop g (fuel+1) S = cond (Nat.beq S 0) true
      (let x := lg2 S
       cond (Nat.beq ((S >>> x) &&& 1) 1) (g x && bitLoop g fuel (S ^^^ (1 <<< x))) false) := rfl

theorem testBit_of_shiftRight_and {S x : Nat} (h : (S >>> x) &&& 1 = 1) : S.testBit x = true := by
  rw [Nat.testBit_eq_decide_div_mod_eq, ← Nat.shiftRight_eq_div_pow, ← Nat.and_one_is_mod, h]
  simp

theorem testBit_xor_one_shift {S x i : Nat} (hne : i ≠ x) :
    (S ^^^ (1 <<< x)).testBit i = S.testBit i := by
  rw [Nat.testBit_xor, Nat.testBit_shiftLeft]
  by_cases hge : i ≥ x
  · have : Nat.testBit 1 (i - x) = false := by
      rw [Bool.eq_false_iff]; intro hc
      rw [Nat.testBit_one_eq_true_iff_self_eq_zero] at hc; omega
    simp [hge, this]
  · simp [hge]

theorem bitLoop_spec {g : Nat → Bool} {fuel : Nat} :
    ∀ {S : Nat}, bitLoop g fuel S = true → ∀ i, S.testBit i = true → g i = true := by
  induction fuel with
  | zero =>
    intro S h i hi
    rw [bitLoop_zero] at h
    have : S = 0 := Nat.eq_of_beq_eq_true h
    subst this
    simp at hi
  | succ n ih =>
    intro S h i hi
    rw [bitLoop_succ] at h
    by_cases hS : S = 0
    · subst hS; simp at hi
    · have hb : Nat.beq S 0 = false := by
        cases hb' : Nat.beq S 0 with
        | false => rfl
        | true => exact absurd (Nat.eq_of_beq_eq_true hb') hS
      rw [hb] at h
      simp only [cond_false] at h
      set x := lg2 S with hx
      cases hbit : Nat.beq ((S >>> x) &&& 1) 1 with
      | false => rw [hbit] at h; exact Bool.noConfusion h
      | true =>
        rw [hbit] at h
        simp only [cond_true, Bool.and_eq_true] at h
        by_cases hix : i = x
        · subst hix; exact h.1
        · apply ih h.2 i
          rw [testBit_xor_one_shift hix]; exact hi

/- ### Mask replication by multiplication with a repunit -/

/-- `repunit q K = ∑_{j<K} 2^(q*j)` -/
def repunit (q : Nat) (K : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) 0 (fun j r => 2 ^ (q * j) + r) K

theorem repunit_zero (q : Nat) : repunit q 0 = 0 := rfl
theorem repunit_succ (q K : Nat) : repunit q (K+1) = 2 ^ (q * K) + repunit q K := rfl

theorem rep_spec (E q : Nat) (hE : E < 2 ^ q) (K : Nat) :
    E * repunit q K < 2 ^ (q * K) ∧
      ∀ i, i < q * K → (E * repunit q K).testBit i = E.testBit (i % q) := by
  induction K with
  | zero =>
    rw [repunit_zero]; simp
  | succ K ih =>
    obtain ⟨hb, hbits⟩ := ih
    rw [repunit_succ, Nat.mul_add, Nat.mul_comm E (2 ^ (q*K))]
    have hq1 : q * (K+1) = q * K + q := by ring
    refine ⟨?_, ?_⟩
    · rw [hq1, Nat.pow_add]
      calc 2 ^ (q*K) * E + E * repunit q K < 2 ^ (q*K) * E + 2 ^ (q*K) := by omega
        _ = 2 ^ (q*K) * (E + 1) := by ring
        _ ≤ 2 ^ (q*K) * 2 ^ q := Nat.mul_le_mul_left _ hE
    · intro i hi
      rw [Nat.testBit_two_pow_mul_add E hb]
      split_ifs with hlt
      · exact hbits i hlt
      · rw [hq1] at hi
        have h1 : i - q * K < q := by omega
        congr 1
        rw [← Nat.sub_mul_mod (by omega : q * K ≤ i), Nat.mod_eq_of_lt h1]

/- ### Square test -/

/-- Newton iteration for integer square root (result verified separately). -/
def nsqrt (v : Nat) : Nat :=
  cond (Nat.beq v 0) 0
    (Nat.rec (motive := fun _ => Nat → Nat) (fun g => g)
      (fun _ ih g => let g' := (g + v / g) / 2; cond (Nat.blt g' g) (ih g') g) 100
      (1 <<< (lg2 v / 2 + 1)))

/-- Sound test that `v` is not a perfect square. -/
def isNonSq (v : Nat) : Bool :=
  let r := nsqrt v
  Nat.blt (r * r) v && Nat.blt v ((r + 1) * (r + 1))

theorem isNonSq_spec {v : Nat} (h : isNonSq v = true) : ∀ A, A * A ≠ v := by
  intro A hA
  unfold isNonSq at h
  simp only [Bool.and_eq_true, Nat.blt_eq] at h
  obtain ⟨h1, h2⟩ := h
  have h1' : nsqrt v * nsqrt v < A * A := by rw [hA]; exact h1
  have h2' : A * A < (nsqrt v + 1) * (nsqrt v + 1) := by rw [hA]; exact h2
  have h3 : nsqrt v < A := Nat.mul_self_lt_mul_self_iff.mp h1'
  have h4 : A < nsqrt v + 1 := Nat.mul_self_lt_mul_self_iff.mp h2'
  omega

/- ### Closed forms of the binomial coefficients -/

def Q' (x : Nat) : Nat := (x+3)*(x+2)*(x+1)*x / 24
def S6' (y : Nat) : Nat := (y+5)*(y+4)*(y+3)*(y+2)*(y+1)*y / 720
def S8' (z : Nat) : Nat := (z+7)*(z+6)*(z+5)*(z+4)*(z+3)*(z+2)*(z+1)*z / 40320

theorem Q'_eq (x : Nat) : Q' x = (x+3).choose 4 := by
  rw [Q', Nat.choose_eq_descFactorial_div_factorial]
  congr 1
  simp [Nat.descFactorial_succ]
  ring

theorem S6'_eq (y : Nat) : S6' y = (y+5).choose 6 := by
  rw [S6', Nat.choose_eq_descFactorial_div_factorial]
  congr 1
  simp [Nat.descFactorial_succ]
  ring

theorem S8'_eq (z : Nat) : S8' z = (z+7).choose 8 := by
  rw [S8', Nat.choose_eq_descFactorial_div_factorial]
  congr 1
  simp [Nat.descFactorial_succ]
  ring

theorem tri_identity (w : Nat) : 8 * (w+2).choose 2 + 1 = (2*w+3) * (2*w+3) := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (w+2) 2
  simp [Nat.descFactorial_succ, Nat.factorial] at h
  zify at h ⊢
  linear_combination (-4) * h

theorem quart_identity (x : Nat) : 24 * (x+3).choose 4 + 1 = (x*x+3*x+1) * (x*x+3*x+1) := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (x+3) 4
  simp [Nat.descFactorial_succ, Nat.factorial] at h
  zify at h ⊢
  linear_combination (-1) * h

/- ### −3 is a non-residue mod primes `p ≡ 2 (mod 3)` -/

theorem dvd_of_dvd_sq_add_three_sq {p : Nat} (hp : p.Prime) (hp3 : p % 3 = 2) (hp2 : p ≠ 2)
    {m A : Nat} (h : p ∣ m * m + 3 * (A * A)) : p ∣ m ∧ p ∣ A := by
  haveI := Fact.mk hp
  have hz : ((m : ZMod p) * m + 3 * ((A : ZMod p) * A)) = 0 := by
    have := (ZMod.natCast_eq_zero_iff _ _).mpr h
    push_cast at this
    exact this
  have hA : (A : ZMod p) = 0 := by
    by_contra hA0
    set t : ZMod p := m * (A : ZMod p)⁻¹ with ht
    have hinv : (A : ZMod p) * (A : ZMod p)⁻¹ = 1 := mul_inv_cancel₀ hA0
    have ht2 : t * t = -3 := by
      have h1 : t * t * (A * A) = -3 * (A * A) := by
        rw [ht]
        calc (m : ZMod p) * (A:ZMod p)⁻¹ * (m * (A:ZMod p)⁻¹) * (A * A)
            = (m*m) * ((A * (A:ZMod p)⁻¹) * (A * (A:ZMod p)⁻¹)) := by ring
          _ = m * m := by rw [hinv]; ring
          _ = -3 * (A*A) := by linear_combination hz
      have hAA : (A : ZMod p) * A ≠ 0 := mul_ne_zero hA0 hA0
      exact mul_right_cancel₀ hAA h1
    have h2 : (2 : ZMod p) ≠ 0 := by
      intro h2
      have h2' := (ZMod.natCast_eq_zero_iff 2 p).mp (by exact_mod_cast h2)
      have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h2'
      exact hp2 this
    set ω : ZMod p := (t - 1) * (2 : ZMod p)⁻¹ with hω
    have hω2 : ω * ω + ω + 1 = 0 := by
      have h2inv : (2 : ZMod p) * (2:ZMod p)⁻¹ = 1 := mul_inv_cancel₀ h2
      have h4z : (4 : ZMod p) * (ω * ω + ω + 1) = 0 := by
        rw [hω]
        have e : (4:ZMod p) * ((t - 1) * 2⁻¹ * ((t - 1) * 2⁻¹) + (t - 1) * 2⁻¹ + 1)
            = (t-1)*(t-1) * (2 * 2⁻¹) * (2 * 2⁻¹) + 2 * (t-1) * (2*2⁻¹) + 4 := by ring
        rw [e, h2inv]; linear_combination ht2
      have h4 : (4 : ZMod p) ≠ 0 := by
        have : (4 : ZMod p) = 2 * 2 := by norm_num
        rw [this]; exact mul_ne_zero h2 h2
      exact (mul_eq_zero.mp h4z).resolve_left h4
    have hω3 : ω ^ 3 = 1 := by
      have e : ω ^ 3 - 1 = (ω - 1) * (ω * ω + ω + 1) := by ring
      rw [hω2, mul_zero] at e
      exact sub_eq_zero.mp e
    have hωne : ω ≠ 0 := by
      intro h0; rw [h0] at hω2; simp at hω2
    have hfermat : ω ^ (p - 1) = 1 := ZMod.pow_card_sub_one_eq_one hωne
    obtain ⟨k, hk⟩ : ∃ k, p - 1 = 3 * k + 1 := ⟨(p-1)/3, by omega⟩
    have hω1 : ω = 1 := by
      have e : ω ^ (p-1) = ω := by rw [hk, pow_succ, pow_mul, hω3, one_pow, one_mul]
      rw [hfermat] at e; exact e.symm
    rw [hω1] at hω2
    have h3 : (3 : ZMod p) = 0 := by linear_combination hω2
    have h3' := (ZMod.natCast_eq_zero_iff 3 p).mp (by exact_mod_cast h3)
    have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h3'
    omega
  have hm : (m : ZMod p) = 0 := by
    rw [hA] at hz; simpa using hz
  exact ⟨(ZMod.natCast_eq_zero_iff _ _).mp hm, (ZMod.natCast_eq_zero_iff _ _).mp hA⟩



/- ### Auxiliary facts about the closed forms -/

theorem Q'_mul (x : Nat) : 24 * Q' x = (x+3)*(x+2)*(x+1)*x := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (x+3) 4
  simp [Nat.descFactorial_succ, Nat.factorial] at h
  rw [Q'_eq]; nlinarith [h]

theorem Q'_mono {a b : Nat} (h : a ≤ b) : Q' a ≤ Q' b := by
  rw [Q'_eq, Q'_eq]; exact Nat.choose_le_choose _ (by omega)

theorem S6'_mono {a b : Nat} (h : a ≤ b) : S6' a ≤ S6' b := by
  rw [S6'_eq, S6'_eq]; exact Nat.choose_le_choose _ (by omega)

theorem S8'_mono {a b : Nat} (h : a ≤ b) : S8' a ≤ S8' b := by
  rw [S8'_eq, S8'_eq]; exact Nat.choose_le_choose _ (by omega)

/-- residue of `Q'` depends only on `x mod q` when `q` is coprime to 24 -/
theorem Q'_cast_mod (q : Nat) (hq : Nat.Coprime 24 q) (x : Nat) :
    ((Q' (x % q) : Nat) : ZMod q) = (Q' x : ZMod q) := by
  have hu : IsUnit ((24 : Nat) : ZMod q) := (ZMod.isUnit_iff_coprime 24 q).mpr hq
  apply hu.mul_left_cancel
  have h1 := Q'_mul x
  have h2 := Q'_mul (x % q)
  have e1 : ((24 : Nat) : ZMod q) * (Q' x : ZMod q) = (((x+3)*(x+2)*(x+1)*x : Nat) : ZMod q) := by
    rw [← h1]; push_cast; ring
  have e2 : ((24 : Nat) : ZMod q) * (Q' (x % q) : ZMod q) =
      (((x % q+3)*(x % q+2)*(x % q+1)*(x % q) : Nat) : ZMod q) := by
    rw [← h2]; push_cast; ring
  rw [e1, e2]
  push_cast
  rw [ZMod.natCast_mod]

/- ### Elimination tables -/

/-- the residue class of `8*(D - Q' x) + 1` mod `q`, computed from `ρ = D % q`, `r = x % q` -/
def fq (q ρ r : Nat) : Nat := (8*ρ + 8*(q - Q' r % q) + 1) % q

theorem fq_eq (q : Nat) (hq0 : 0 < q) (hq : Nat.Coprime 24 q) (D x : Nat) (hx : Q' x ≤ D) :
    (8 * (D - Q' x) + 1) % q = fq q (D % q) (x % q) := by
  unfold fq
  rw [← ZMod.natCast_eq_natCast_iff']
  push_cast
  rw [Nat.cast_sub hx, Nat.cast_sub (Nat.mod_lt _ hq0).le]
  rw [ZMod.natCast_mod, ZMod.natCast_mod, ZMod.natCast_self, Q'_cast_mod q hq]
  ring

/-- A valid elimination table `T` for modulus `q`. -/
structure GoodTab (q T : Nat) : Prop where
  pos : 0 < q
  cop : Nat.Coprime 24 q
  sq : ∃ SQ : Nat, (∀ a, a < q → SQ.testBit ((a*a) % q) = true) ∧
        (∀ ρ, ρ < q → ∀ r, r < q → T.testBit (ρ*q + r) = true → SQ.testBit (fq q ρ r) = false)

theorem GoodTab.not_square {q T : Nat} (h : GoodTab q T) {D x A : Nat} (hx : Q' x ≤ D)
    (hA : A * A = 8 * (D - Q' x) + 1) : T.testBit ((D % q) * q + x % q) = false := by
  obtain ⟨SQ, hSQ, hT⟩ := h.sq
  by_contra hc
  rw [Bool.not_eq_false] at hc
  have h1 := hT (D % q) (Nat.mod_lt _ h.pos) (x % q) (Nat.mod_lt _ h.pos) hc
  rw [← fq_eq q h.pos h.cop D x hx, ← hA] at h1
  have h2 := hSQ (A % q) (Nat.mod_lt _ h.pos)
  rw [← Nat.mul_mod] at h2
  rw [h2] at h1; exact Bool.noConfusion h1

/-- Extract the `q`-bit eliminated-residue mask for `ρ = D % q` from table `T`. -/
def emask (T q D : Nat) : Nat := (T >>> ((D % q) * q)) &&& (2 ^ q - 1)

theorem emask_lt (T q D : Nat) : emask T q D < 2 ^ q := by
  unfold emask
  exact Nat.and_lt_two_pow _ (Nat.sub_one_lt (Nat.pos_iff_ne_zero.mp (Nat.two_pow_pos q)))

theorem emask_testBit (T q D r : Nat) (hr : r < q) :
    (emask T q D).testBit r = T.testBit ((D % q) * q + r) := by
  unfold emask
  rw [Nat.testBit_land, Nat.testBit_shiftRight, Nat.testBit_two_pow_sub_one]
  simp [hr]

/-- union of replicated elimination masks over a list of (q, T, R) -/
def elimU (D : Nat) : List (Nat × Nat × Nat) → Nat
  | [] => 0
  | (q, T, R) :: rest => emask T q D * R ||| elimU D rest

theorem elimU_spec (D x : Nat) : ∀ L : List (Nat × Nat × Nat), (elimU D L).testBit x = true →
    ∃ p ∈ L, (emask p.2.1 p.1 D * p.2.2).testBit x = true := by
  intro L
  induction L with
  | nil => intro h; simp [elimU] at h
  | cons p rest ih =>
    intro h
    obtain ⟨q, T, R⟩ := p
    simp only [elimU, Nat.testBit_lor, Bool.or_eq_true] at h
    rcases h with h | h
    · exact ⟨(q, T, R), List.mem_cons_self .., h⟩
    · obtain ⟨p', hp', h'⟩ := ih h
      exact ⟨p', List.mem_cons_of_mem _ hp', h'⟩

/-- `R` is a repunit for `q` covering at least `X0` bits -/
def GoodRep (q R X0 : Nat) : Prop := ∃ K, R = repunit q K ∧ X0 ≤ q * K

/- ### Prime certificates -/

def primeCert (N : Nat) : List Nat → Bool
  | [] => false
  | p :: rest => (Nat.beq (N % p) 0 && (Nat.beq (N % (p*p)) 0).not) || primeCert N rest

theorem primeCert_spec (N : Nat) : ∀ PL : List Nat, primeCert N PL = true →
    (∀ p ∈ PL, p.Prime ∧ p % 3 = 2 ∧ p ≠ 2) → ∀ m A, m * m + 3 * (A * A) ≠ N := by
  intro PL
  induction PL with
  | nil => intro h; simp [primeCert] at h
  | cons p rest ih =>
    intro h hPL m A hmA
    simp only [primeCert, Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, Bool.not_eq_eq_eq_not,
      Bool.not_true] at h
    rcases h with ⟨h1, h2⟩ | h
    · obtain ⟨hp, hp3, hp2⟩ := hPL p (List.mem_cons_self ..)
      have hdvd : p ∣ m * m + 3 * (A * A) := by rw [hmA]; exact Nat.dvd_of_mod_eq_zero h1
      obtain ⟨hm, hA⟩ := dvd_of_dvd_sq_add_three_sq hp hp3 hp2 hdvd
      have : p * p ∣ N := by
        rw [← hmA]
        exact Dvd.dvd.add (Nat.mul_dvd_mul hm hm) (Dvd.dvd.mul_left (Nat.mul_dvd_mul hA hA) 3)
      have := Nat.mod_eq_zero_of_dvd this
      exact absurd this (Nat.ne_of_beq_eq_false h2)
    · exact ih h (fun p' hp' => hPL p' (List.mem_cons_of_mem _ hp')) m A hmA

/- ### The pair check -/

def checkPair (n0 X0 : Nat) (L : List (Nat × Nat × Nat)) (PL : List Nat) (y z : Nat) : Bool :=
  let P := S6' y + S8' z
  cond (Nat.blt n0 P) true
    (let D := n0 - P
     cond (primeCert (24 * D + 4) PL) true
      (let U := elimU D L
       let allX := 2 ^ X0 - 1
       let S := allX ^^^ (U &&& allX)
       bitLoop (fun x => Nat.blt D (Q' x) || isNonSq (8 * (D - Q' x) + 1)) X0 S))

theorem blt_false_of_le {a b : Nat} (h : b ≤ a) : Nat.blt a b = false := by
  cases hc : Nat.blt a b with
  | false => rfl
  | true => exact absurd (Nat.le_of_ble_eq_true hc) (by omega)

theorem checkPair_spec {n0 X0 : Nat} {L : List (Nat × Nat × Nat)} {PL : List Nat} {y z : Nat}
    (h : checkPair n0 X0 L PL y z = true)
    (hL : ∀ p ∈ L, GoodTab p.1 p.2.1) (hJ : ∀ p ∈ L, GoodRep p.1 p.2.2 X0)
    (hPL : ∀ p ∈ PL, p.Prime ∧ p % 3 = 2 ∧ p ≠ 2) :
    ∀ w x, x < X0 → (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n0 := by
  intro w x hx heq
  unfold checkPair at h
  simp only at h
  rw [← S6'_eq, ← S8'_eq, ← Q'_eq] at heq
  have hQe : Q' x = (x+3).choose 4 := Q'_eq x
  have hP : S6' y + S8' z ≤ n0 := by omega
  rw [blt_false_of_le hP, cond_false] at h
  set P := S6' y + S8' z with hPdef
  set D := n0 - P with hDdef
  have hD : D + P = n0 := Nat.sub_add_cancel hP
  have hTQ : (w+2).choose 2 + Q' x = D := by omega
  have hQ : Q' x ≤ D := by omega
  have htri := tri_identity w
  have hquart := quart_identity x
  have hA : (2*w+3)*(2*w+3) = 8 * (D - Q' x) + 1 := by
    have : (w+2).choose 2 = D - Q' x := by omega
    rw [← this, htri]
  by_cases hpc : primeCert (24 * D + 4) PL = true
  · have hne := primeCert_spec (24 * D + 4) PL hpc hPL (x*x+3*x+1) (2*w+3)
    apply hne
    generalize (2*w+3)*(2*w+3) = AA at *
    generalize (x*x+3*x+1)*(x*x+3*x+1) = MM at *
    omega
  · rw [Bool.not_eq_true] at hpc
    rw [hpc, cond_false] at h
    set U := elimU D L with hU
    set allX := 2 ^ X0 - 1 with hallX
    set S := allX ^^^ (U &&& allX) with hS
    by_cases hbit : S.testBit x = true
    · have hg := bitLoop_spec h x hbit
      simp only [Bool.or_eq_true] at hg
      rcases hg with hg | hg
      · rw [Nat.blt_eq] at hg; omega
      · exact isNonSq_spec hg _ hA
    · rw [Bool.not_eq_true] at hbit
      have hUx : U.testBit x = true := by
        rw [hS, Nat.testBit_xor, Nat.testBit_land, hallX, Nat.testBit_two_pow_sub_one] at hbit
        simp [hx] at hbit
        exact hbit
      obtain ⟨p, hp, hrep⟩ := elimU_spec D x L hUx
      have hg := hL p hp
      obtain ⟨K, hK, hXK⟩ := hJ p hp
      rw [hK, (rep_spec (emask p.2.1 p.1 D) p.1 (emask_lt _ _ _) K).2 x (lt_of_lt_of_le hx hXK)] at hrep
      rw [emask_testBit _ _ _ _ (Nat.mod_lt _ hg.pos)] at hrep
      rw [hg.not_square hQ hA] at hrep
      exact Bool.noConfusion hrep



/- ### Concrete tables -/

def sqCheck (SQ q : Nat) : Bool := loopAll (fun a => SQ.testBit ((a*a) % q)) q
def tabCheck (T SQ q : Nat) : Bool :=
  loopAll (fun ρ => loopAll (fun r => !(T.testBit (ρ*q+r)) || !(SQ.testBit (fq q ρ r))) q) q

theorem goodTab_of_checks {q T SQ : Nat} (h0 : 0 < q) (hc : Nat.Coprime 24 q)
    (h1 : sqCheck SQ q = true) (h2 : tabCheck T SQ q = true) : GoodTab q T := by
  refine ⟨h0, hc, SQ, ?_, ?_⟩
  · intro a ha
    exact loopAll_spec h1 a ha
  · intro ρ hρ r hr hT
    have h3 := loopAll_spec (loopAll_spec h2 ρ hρ) r hr
    simp only [Bool.or_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true] at h3
    rcases h3 with h3 | h3
    · rw [hT] at h3; exact Bool.noConfusion h3
    · exact h3

theorem goodRep_of_eq {q R X0 K : Nat} (h : R = repunit q K) (hX : X0 ≤ q * K) : GoodRep q R X0 :=
  ⟨K, h, hX⟩

