theorem bound_x {n0 X0 x : Nat} (hX : n0 < Q' X0) (h : (x+3).choose 4 ≤ n0) : x < X0 := by
  by_contra hc
  have := Q'_mono (Nat.le_of_not_lt hc)
  have e1 := Q'_eq X0; have e2 := Q'_eq x; omega

theorem bound_y {n0 Y0 y : Nat} (hY : n0 < S6' Y0) (h : (y+5).choose 6 ≤ n0) : y < Y0 := by
  by_contra hc
  have := S6'_mono (Nat.le_of_not_lt hc)
  have e1 := S6'_eq Y0; have e2 := S6'_eq y; omega

theorem bound_z {n0 Z0 z : Nat} (hZ : n0 < S8' Z0) (h : (z+7).choose 8 ≤ n0) : z < Z0 := by
  by_contra hc
  have := S8'_mono (Nat.le_of_not_lt hc)
  have e1 := S8'_eq Z0; have e2 := S8'_eq z; omega

