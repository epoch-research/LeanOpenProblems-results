theorem prime_of_pock {p F : ℕ} (hp1 : 1 < p) (hF : ∀ r, r.Prime → r ∣ p → F ∣ r - 1)
    (hlt : p < (F + 1) ^ 2) : p.Prime := by
  by_contra hnp
  have hmin := Nat.minFac_sq_le_self (by omega) hnp
  have hrp : (Nat.minFac p).Prime := Nat.minFac_prime (by omega)
  have hrd : Nat.minFac p ∣ p := Nat.minFac_dvd p
  have h1 := hF _ hrp hrd
  have h2le := hrp.two_le
  have h2 : F ≤ Nat.minFac p - 1 := Nat.le_of_dvd (by omega) h1
  have h3 : F + 1 ≤ Nat.minFac p := by omega
  have h4 : (F + 1) ^ 2 ≤ Nat.minFac p ^ 2 := Nat.pow_le_pow_left h3 2
  exact absurd (lt_of_lt_of_le hlt (h4.trans hmin)) (lt_irrefl _)

theorem primeCert_sound (F17 F316 FB : ℕ) (h17 : F17 = Nat.factorial 17) (h316 : F316 = Nat.factorial 316)
