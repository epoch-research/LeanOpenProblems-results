/- ### Pair certificate: no good representation of `N` -/

def repLoop (pc : ℕ → ℕ → Option ℕ) : ℕ → ℕ → List (ℕ × ℕ) → ℕ → Option (ℕ × List (ℕ × ℕ) × ℕ)
  | 0, m, L, cert => some (m, L, cert)
  | k+1, m, L, cert => readF cert 56 fun p cert => readF cert 6 fun e cert => readF cert 1 fun t cert =>
      match pc p cert with
      | none => none
      | some cert =>
        if t = 1 then
          readF cert 29 fun c cert => readF cert 29 fun d cert =>
            if 0 < d ∧ d < c ∧ c * c + d * d = p + c * d then
              forceN (m * p ^ e) fun m' => repLoop pc k m' (iterP c d e L) cert
            else none
        else
          if p % 3 = 2 ∧ p ≠ 2 then forceN (m * p ^ (2 * e)) fun m' => repLoop pc k m' (iterQ p e L) cert else none

def pairCert (pc : ℕ → ℕ → Option ℕ) (N : ℕ) (cert : ℕ) : Option ℕ :=
  readF cert 2 fun tag cert =>
    if tag = 0 then
      readF cert 56 fun q cert => readF cert 6 fun j cert =>
        if q % 3 = 2 ∧ q ≠ 2 ∧ q ^ (2 * j + 1) ∣ N ∧ ¬ q ∣ N / q ^ (2 * j + 1) then pc q cert else none
    else
      readF cert 4 fun k cert =>
        match repLoop pc k 1 [(1, 0)] cert with
        | none => none
        | some (m, L, cert) => if m = N ∧ L.all (fun x => !badC x) then some cert else none

theorem repLoop_sound (pc : ℕ → ℕ → Option ℕ) (hpc : ∀ q c, (pc q c).isSome → q.Prime) :
    ∀ k m L cert m' L' cert', repLoop pc k m L cert = some (m', L', cert') →
      Complete m L → Complete m' L' := by
  intro k
  induction k with
  | zero =>
    intro m L cert m' L' cert' h hL
    simp only [repLoop, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl⟩ := h
    exact hL
  | succ k ih =>
    intro m L cert m' L' cert' h hL
    unfold repLoop at h
    rw [readF_eq, readF_eq, readF_eq] at h
    set p := cert % 2 ^ 56
    set e := cert / 2 ^ 56 % 2 ^ 6
    set t := cert / 2 ^ 56 / 2 ^ 6 % 2 ^ 1
    set cert1 := cert / 2 ^ 56 / 2 ^ 6 / 2 ^ 1
    cases hq : pc p cert1 with
    | none => rw [hq] at h; simp at h
    | some cert2 =>
      rw [hq] at h
      dsimp only at h
      have hp : p.Prime := hpc p cert1 (by rw [hq]; rfl)
      by_cases ht : t = 1
      · rw [if_pos ht, readF_eq, readF_eq] at h
        split_ifs at h with hcd
        · rw [forceN_eq] at h
          obtain ⟨hd, hc, hcd⟩ := hcd
          set c := cert2 % 2 ^ 29
          set d := cert2 / 2 ^ 29 % 2 ^ 29
          have hQ : Q (c : ℕ) (d : ℕ) = p := by
            unfold Q
            have := congrArg (fun n : ℕ => (n : ℤ)) hcd
            push_cast at this
            linear_combination this
          have := complete_iterP hp hd hc hQ e hL
          apply ih _ _ _ _ _ _ h
          have e' : ((m * p ^ e : ℕ) : ℤ) = (p : ℤ) ^ e * m := by push_cast; ring
          rw [e']; exact this
      · rw [if_neg ht] at h
        split_ifs at h with hq3
        · rw [forceN_eq] at h
          have := complete_iterQ hp hq3.1 hq3.2 e hL
          apply ih _ _ _ _ _ _ h
          have e' : ((m * p ^ (2 * e) : ℕ) : ℤ) = (p : ℤ) ^ (2 * e) * m := by push_cast; ring
          rw [e']; exact this

theorem pairCert_sound (pc : ℕ → ℕ → Option ℕ) (hpc : ∀ q c, (pc q c).isSome → q.Prime)
    (N cert : ℕ) (h : (pairCert pc N cert).isSome) :
    ∀ a b : ℤ, Q a b = N → ¬ good a b := by
  intro a b hab hgood
  unfold pairCert at h
  rw [readF_eq] at h
  split_ifs at h with h0
  · rw [readF_eq, readF_eq] at h
    split_ifs at h with hc
    · obtain ⟨h3, h2, hdvd, hnd⟩ := hc
      set q := cert / 2 ^ 2 % 2 ^ 56
      set j := cert / 2 ^ 2 / 2 ^ 56 % 2 ^ 6
      have hq : q.Prime := hpc _ _ h
      obtain ⟨M, hM⟩ := hdvd
      have hM' : N / q ^ (2 * j + 1) = M := by
        rw [hM]; exact Nat.mul_div_cancel_left M (pow_pos hq.pos _)
      rw [hM'] at hnd
      apply Q_ne_of_odd_exp hq h3 h2 j (M : ℤ) a b
      · intro hd; apply hnd; exact_mod_cast hd
      · rw [hab, hM]; push_cast; ring
    · simp at h
  · rw [readF_eq] at h
    cases hr : repLoop pc (cert / 2 ^ 2 % 2 ^ 4) 1 [(1, 0)] (cert / 2 ^ 2 / 2 ^ 4) with
    | none => rw [hr] at h; simp at h
    | some r =>
      obtain ⟨m, L, cert'⟩ := r
      rw [hr] at h
      dsimp only at h
      split_ifs at h with hc
      · obtain ⟨hm, hall⟩ := hc
        obtain ⟨hcan, hC⟩ : Complete m L := repLoop_sound pc hpc _ _ _ _ _ _ _ hr complete_one
        obtain ⟨x, hxL, hA⟩ := hC a b (by rw [hab, hm])
        rw [List.all_eq_true] at hall
        have := hall x hxL
        rw [badC_of_good hgood (hcan x hxL) hA] at this
        simp at this
      · simp at h

/- ### Outer loops -/

def c6 (Y : ℕ) : ℕ := (Y - 5) * ((Y - 4) * ((Y - 3) * ((Y - 2) * ((Y - 1) * Y)))) / 720
def c8 (Z : ℕ) : ℕ := (Z - 7) * ((Z - 6) * ((Z - 5) * ((Z - 4) * ((Z - 3) * ((Z - 2) * ((Z - 1) * Z)))))) / 40320

theorem c6_eq (Y : ℕ) : c6 Y = Y.choose 6 := by
  have := Nat.descFactorial_eq_factorial_mul_choose Y 6
  simp [Nat.descFactorial_succ, Nat.factorial] at this
  unfold c6; rw [this]; omega

theorem c8_eq (Z : ℕ) : c8 Z = Z.choose 8 := by
  have := Nat.descFactorial_eq_factorial_mul_choose Z 8
  simp [Nat.descFactorial_succ, Nat.factorial] at this
  unfold c8; rw [this]; omega

def yloop (pc : ℕ → ℕ → Option ℕ) (n cz : ℕ) : ℕ → ℕ → List ℕ → Option (List ℕ)
  | 0, _, _ => none
  | f+1, Y, certs =>
    let m2 := c6 Y + cz
    if n ≤ m2 then some certs
    else match certs with
      | [] => none
      | cert :: certs =>
        match pairCert pc (6 * (n - m2) + 1) cert with
        | none => none
        | some _ => forceN (Y + 1) fun Y' => yloop pc n cz f Y' certs

def zloop (pc : ℕ → ℕ → Option ℕ) (n : ℕ) : ℕ → ℕ → List ℕ → Option (List ℕ)
  | 0, _, certs => some certs
  | f+1, Z, certs =>
    let cz := c8 Z
    if n ≤ cz then some certs
    else match yloop pc n cz 4000 5 certs with
      | none => none
      | some certs => forceN (Z + 1) fun Z' => zloop pc n f Z' certs

/-- Decode a length-prefixed stream of certificates (12-bit length, then the certificate). -/
def splitStream : ℕ → ℕ → List ℕ
  | 0, _ => []
  | k+1, v => if v = 0 then [] else readF v 12 fun len v => readF v len fun c v => c :: splitStream k v

/-- Decode a list of packed streams into the list of certificates. -/
def certsOf (L : List ℕ) : List ℕ := L.flatMap (splitStream 400)

/-- No solution with the given `Y` and `cz`. -/
def NoSol (n cz Y : ℕ) : Prop := ∀ W X : ℕ, 2 ≤ W → 3 ≤ X → W.choose 2 + X.choose 4 + Y.choose 6 + cz ≠ n

theorem yloop_sound (pc : ℕ → ℕ → Option ℕ) (hpc : ∀ q c, (pc q c).isSome → q.Prime) (n cz : ℕ) :
    ∀ f Y certs, (yloop pc n cz f Y certs).isSome → ∀ Y', Y ≤ Y' → NoSol n cz Y' := by
  intro f
  induction f with
  | zero => intro Y certs h; simp [yloop] at h
  | succ f ih =>
    intro Y certs h Y' hY' W X hW hX heq
    unfold yloop at h
    simp only at h
    have hmono : Y.choose 6 ≤ Y'.choose 6 := Nat.choose_le_choose 6 hY'
    have hWpos : 0 < W.choose 2 := Nat.choose_pos (by omega)
    split_ifs at h with hle
    · rw [← c6_eq] at hmono; omega
    · cases certs with
      | nil => simp at h
      | cons cert certs =>
        dsimp only at h
        cases hp : pairCert pc (6 * (n - (c6 Y + cz)) + 1) cert with
        | none => rw [hp] at h; simp at h
        | some cert' =>
          rw [hp] at h
          dsimp only at h
          rw [forceN_eq] at h
          rcases Nat.eq_or_lt_of_le hY' with rfl | hlt
          · have hn' : W.choose 2 + X.choose 4 = n - (c6 Y + cz) := by rw [c6_eq]; omega
            obtain ⟨a, b, hab, hgood⟩ := good_of_solution W X _ hW hX hn'
            exact pairCert_sound pc hpc _ _ (by rw [hp]; rfl) a b (by rw [hab]; push_cast; ring) hgood
          · exact ih _ _ h Y' hlt W X hW hX heq

theorem zloop_sound (pc : ℕ → ℕ → Option ℕ) (hpc : ∀ q c, (pc q c).isSome → q.Prime) (n : ℕ) :
    ∀ f Z certs, (zloop pc n f Z certs).isSome → ∀ Z', Z ≤ Z' → Z' < Z + f →
      ∀ Y, 5 ≤ Y → NoSol n (Z'.choose 8) Y := by
  intro f
  induction f with
  | zero => intro Z certs h Z' h1 h2; omega
  | succ f ih =>
    intro Z certs h Z' h1 h2 Y hY W X hW hX heq
    unfold zloop at h
    simp only at h
    have hmono : Z.choose 8 ≤ Z'.choose 8 := Nat.choose_le_choose 8 h1
    have hWpos : 0 < W.choose 2 := Nat.choose_pos (by omega)
    split_ifs at h with hle
    · rw [← c8_eq] at hmono; omega
    · cases hy : yloop pc n (c8 Z) 4000 5 certs with
      | none => rw [hy] at h; simp at h
      | some certs' =>
        rw [hy] at h
        dsimp only at h
        rw [forceN_eq] at h
        rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
        · rw [← c8_eq] at heq
          exact yloop_sound pc hpc n (c8 Z) 4000 5 certs (by rw [hy]; rfl) Y hY W X hW hX heq
        · exact ih _ _ h Z' hlt (by omega) Y hY W X hW hX heq

