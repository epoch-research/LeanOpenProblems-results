theorem noSol_all (Z Y : ℕ) (hY : 5 ≤ Y) (hZ : 7 ≤ Z) : NoSol n0 (Z.choose 8) Y := by
  by_cases hlt : Z < 282
  · exact cov_all Z hZ hlt Y hY
  · intro W X hW hX heq
    have h1 : Nat.choose 282 8 ≤ Z.choose 8 := Nat.choose_le_choose 8 (by omega)
    have h2 : n0 ≤ Nat.choose 282 8 := by rw [← c8_eq]; decide +kernel
    have h3 : 0 < W.choose 2 := Nat.choose_pos (by omega)
    omega

theorem main_ne (W X Y Z : ℕ) (hW : 2 ≤ W) (hX : 3 ≤ X) (hY : 5 ≤ Y) (hZ : 7 ≤ Z) :
    W.choose 2 + X.choose 4 + Y.choose 6 + Z.choose 8 ≠ n0 := noSol_all Z Y hY hZ W X hW hX

