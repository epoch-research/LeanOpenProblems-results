import FormalConjectures.Util.ProblemImports

set_option Elab.async false

namespace Sun2468


/-- The Eisenstein norm form. -/
def Q (a b : ℤ) : ℤ := a * a - a * b + b * b

theorem four_mul_Q (a b : ℤ) : 4 * Q a b = (2 * a - b) ^ 2 + 3 * b ^ 2 := by
  unfold Q; ring

theorem Q_mul (a b c d : ℤ) :
    Q a b * Q c d = Q (c * a - d * b) (c * b + d * a - d * b) := by
  unfold Q; ring

/-- Key identity: `6 * (C(W,2) + C(X,4)) + 1 = Q (u + W) (2W - 1)` with `2u = X(X-3)`. -/
theorem key_identity (W X : ℕ) (hW : 1 ≤ W) (hX : 3 ≤ X) :
    (6 * (W.choose 2 + X.choose 4) + 1 : ℤ) =
      Q ((X * (X - 3) / 2 : ℕ) + W) (2 * W - 1) := by
  have h1 : (2 * W.choose 2 : ℕ) = (W - 1) * W := by
    have := Nat.descFactorial_eq_factorial_mul_choose W 2
    simp [Nat.descFactorial_succ, Nat.factorial] at this
    omega
  have h2 : (24 * X.choose 4 : ℕ) = (X - 3) * ((X - 2) * ((X - 1) * X)) := by
    have := Nat.descFactorial_eq_factorial_mul_choose X 4
    simp [Nat.descFactorial_succ, Nat.factorial] at this
    omega
  have h3 : 2 * (X * (X - 3) / 2) = X * (X - 3) := by
    apply Nat.mul_div_cancel'
    have h : X * (X - 3) = X * (X - 1) - 2 * X := by
      have : X - 3 = (X - 1) - 2 := by omega
      rw [this, Nat.mul_sub, Nat.mul_comm X 2]
    rw [h]
    exact Nat.dvd_sub (even_iff_two_dvd.mp (Nat.even_mul_pred_self X)) (dvd_mul_right 2 X)
  set u := X * (X - 3) / 2 with hu
  have hX1 : (1 : ℕ) ≤ X := by omega
  have hX3 : (3 : ℕ) ≤ X := hX
  have hX2 : (2 : ℕ) ≤ X := by omega
  have h1' : (2 * (W.choose 2 : ℕ) : ℤ) = ((W : ℤ) - 1) * W := by
    have := congrArg (fun t : ℕ => (t : ℤ)) h1; push_cast [Nat.cast_sub hW] at this; linarith
  have h2' : (24 * (X.choose 4 : ℕ) : ℤ) = ((X : ℤ) - 3) * (((X : ℤ) - 2) * (((X : ℤ) - 1) * X)) := by
    have := congrArg (fun t : ℕ => (t : ℤ)) h2
    push_cast [Nat.cast_sub hX1, Nat.cast_sub hX2, Nat.cast_sub hX3] at this; linarith
  have h3' : (2 * (u : ℕ) : ℤ) = (X : ℤ) * ((X : ℤ) - 3) := by
    have := congrArg (fun t : ℕ => (t : ℤ)) h3; push_cast [Nat.cast_sub hX3] at this; linarith
  unfold Q
  have : 4 * (6 * ((W.choose 2 : ℕ) + (X.choose 4 : ℕ)) + 1 : ℤ) =
      4 * (((u : ℕ) + W) * ((u : ℕ) + W) - ((u : ℕ) + W) * (2 * W - 1) + (2 * W - 1) * (2 * W - 1)) := by
    linear_combination (12 : ℤ) * h1' + h2' - (2 * (u : ℤ) + (X : ℤ) * X - 3 * X + 2) * h3'
  linarith

/-- `-3` is not a square mod an odd prime `p ≡ 2 (mod 3)`. -/
theorem no_sqrt_neg_three {p : ℕ} (hp : p.Prime) (h3 : p % 3 = 2) (h2 : p ≠ 2) (u : ZMod p) :
    u * u ≠ -3 := by
  intro hu
  haveI := Fact.mk hp
  have h2' : (2 : ZMod p) ≠ 0 := by
    intro h
    have : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h
    rw [ZMod.natCast_eq_zero_iff] at this
    exact h2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp this)
  set ω : ZMod p := (u - 1) * (2 : ZMod p)⁻¹ with hω
  have hω1 : ω * ω + ω + 1 = 0 := by
    rw [hω]; field_simp; linear_combination hu
  have hω3 : ω ^ 3 = 1 := by linear_combination (ω - 1) * hω1
  have hω0 : ω ≠ 0 := by
    intro h; rw [h] at hω1; simp at hω1
  have hF : ω ^ (p - 1) = 1 := ZMod.pow_card_sub_one_eq_one hω0
  have hq : p - 1 = 3 * ((p - 1) / 3) + 1 := by omega
  rw [hq, pow_succ, pow_mul, hω3, one_pow, one_mul] at hF
  rw [hF] at hω1
  have h33 : ((3 : ℕ) : ZMod p) = 0 := by push_cast; linear_combination hω1
  rw [ZMod.natCast_eq_zero_iff] at h33
  have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h33
  omega

/-- If an odd prime `q ≡ 2 (mod 3)` divides `Q a b`, then it divides both `a` and `b`. -/
theorem dvd_of_dvd_Q {q : ℕ} (hq : q.Prime) (h3 : q % 3 = 2) (h2 : q ≠ 2) {a b : ℤ}
    (h : (q : ℤ) ∣ Q a b) : (q : ℤ) ∣ a ∧ (q : ℤ) ∣ b := by
  haveI := Fact.mk hq
  have h4 : (q : ℤ) ∣ (2 * a - b) ^ 2 + 3 * b ^ 2 := by rw [← four_mul_Q]; exact Dvd.dvd.mul_left h 4
  have hz : (2 * (a : ZMod q) - b) ^ 2 + 3 * (b : ZMod q) ^ 2 = 0 := by
    have := (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mpr h4
    push_cast at this; linear_combination this
  have hb : ((b : ℤ) : ZMod q) = 0 := by
    by_contra hb
    apply no_sqrt_neg_three hq h3 h2 ((2 * (a : ZMod q) - b) * ((b : ℤ) : ZMod q)⁻¹)
    field_simp
    linear_combination hz
  have hb' : (q : ℤ) ∣ b := (ZMod.intCast_zmod_eq_zero_iff_dvd b q).mp hb
  refine ⟨?_, hb'⟩
  have h2q : ((2 : ℤ) : ZMod q) ≠ 0 := by
    intro h
    have : ((2 : ℕ) : ZMod q) = 0 := by exact_mod_cast h
    rw [ZMod.natCast_eq_zero_iff] at this
    exact h2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).mp this)
  have ha : (2 * (a : ZMod q) - b) = 0 := by
    have : (2 * (a : ZMod q) - b) ^ 2 = 0 := by linear_combination hz - 3 * (b : ZMod q) * hb
    exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp this
  have : ((2 * a : ℤ) : ZMod q) = 0 := by
    push_cast at ha hb ⊢; linear_combination ha + hb
  have h2a : (q : ℤ) ∣ 2 * a := (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mp this
  have hqp : Prime (q : ℤ) := Nat.prime_iff_prime_int.mp hq
  rcases hqp.dvd_or_dvd h2a with h | h
  · exfalso
    have : (q : ℤ) ∣ (2 : ℕ) := by exact_mod_cast h
    rw [Int.natCast_dvd_natCast] at this
    exact h2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).mp this)
  · exact h

/-- Non-representability: if `q ≡ 2 (mod 3)` is an odd prime with odd exponent in `N`,
then `N ≠ Q a b`. -/
theorem Q_ne_of_odd_exp {q : ℕ} (hq : q.Prime) (h3 : q % 3 = 2) (h2 : q ≠ 2) :
    ∀ (j : ℕ) (M a b : ℤ), ¬ (q : ℤ) ∣ M → Q a b ≠ (q : ℤ) ^ (2 * j + 1) * M := by
  intro j
  induction j with
  | zero =>
    intro M a b hM h
    have hd : (q : ℤ) ∣ Q a b := by rw [h]; simp
    obtain ⟨⟨a', ha⟩, ⟨b', hb⟩⟩ := dvd_of_dvd_Q hq h3 h2 hd
    subst ha; subst hb
    apply hM
    have hq0 : (q : ℤ) ≠ 0 := by exact_mod_cast hq.ne_zero
    have e : Q ((q : ℤ) * a') ((q : ℤ) * b') = (q : ℤ) * ((q : ℤ) * Q a' b') := by unfold Q; ring
    simp only [Nat.mul_zero, zero_add, pow_one] at h
    rw [e] at h
    have := mul_left_cancel₀ hq0 h
    exact ⟨Q a' b', this.symm⟩
  | succ j ih =>
    intro M a b hM h
    have hd : (q : ℤ) ∣ Q a b := by
      rw [h]; exact dvd_mul_of_dvd_left (dvd_pow_self _ (by omega)) _
    obtain ⟨⟨a', ha⟩, ⟨b', hb⟩⟩ := dvd_of_dvd_Q hq h3 h2 hd
    subst ha; subst hb
    apply ih M a' b' hM
    have hq0 : (q : ℤ) ^ 2 ≠ 0 := pow_ne_zero 2 (by exact_mod_cast hq.ne_zero)
    have : (q : ℤ) ^ 2 * Q a' b' = (q : ℤ) ^ 2 * ((q : ℤ) ^ (2 * j + 1) * M) := by
      have e : Q ((q : ℤ) * a') ((q : ℤ) * b') = (q : ℤ) ^ 2 * Q a' b' := by unfold Q; ring
      rw [← e, h]; ring
    exact mul_left_cancel₀ hq0 this




/-- Eisenstein multiplication `(c + dω)(x₁ + x₂ω)`. -/
def mulE (c d : ℤ) (x : ℤ × ℤ) : ℤ × ℤ := (c * x.1 - d * x.2, c * x.2 + d * x.1 - d * x.2)

theorem Q_mulE (c d : ℤ) (x : ℤ × ℤ) : Q (mulE c d x).1 (mulE c d x).2 = Q c d * Q x.1 x.2 := by
  unfold Q mulE; ring

theorem Q_conj (c d : ℤ) : Q (c - d) (-d) = Q c d := by unfold Q; ring

/-- Euler descent for the form `Q`. -/
theorem descent {p : ℕ} (hp : p.Prime) {c d : ℤ} (hcd : Q c d = p) {a b m : ℤ}
    (h : Q a b = p * m) :
    ∃ x : ℤ × ℤ, Q x.1 x.2 = m ∧ ((a, b) = mulE c d x ∨ (a, b) = mulE (c - d) (-d) x) := by
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have key : (a * d - b * c) * (a * d + b * c - b * d) = (p : ℤ) * (m * d ^ 2 - b ^ 2) := by
    have : Q a b * d ^ 2 - Q c d * b ^ 2 = (a * d - b * c) * (a * d + b * c - b * d) := by
      unfold Q; ring
    rw [← this, h, hcd]; ring
  have hdvd : (p : ℤ) ∣ (a * d - b * c) * (a * d + b * c - b * d) := ⟨_, key⟩
  rcases hpz.dvd_or_dvd hdvd with ⟨v', hv⟩ | ⟨v', hv⟩
  · -- case 1: p ∣ ad - bc ; use conjugate multiplication
    set u := a * c - a * d + b * d with hu
    set v := b * c - a * d with hvdef
    have hQuv : Q u v = (p : ℤ) * (p * m) := by
      have : (u, v) = mulE (c - d) (-d) (a, b) := by simp [mulE, hu, hvdef]; constructor <;> ring
      have e := Q_mulE (c - d) (-d) (a, b)
      rw [← this] at e; simp at e; rw [e, Q_conj, hcd, h]
    have hv' : v = (p : ℤ) * (-v') := by rw [hvdef]; linear_combination -hv
    have hu2 : (p : ℤ) ∣ u * u := by
      have : u * u = Q u v + u * v - v * v := by unfold Q; ring
      rw [this, hQuv, hv']
      exact ⟨p * m + u * (-v') - p * (-v') * (-v'), by ring⟩
    obtain ⟨u', hu'⟩ := hpz.dvd_of_dvd_pow (show (p : ℤ) ∣ u ^ 2 by rw [sq]; exact hu2)
    refine ⟨(u', -v'), ?_, Or.inl ?_⟩
    · have : (p : ℤ) * (p * Q u' (-v')) = (p : ℤ) * (p * m) := by
        rw [← hQuv, hu', hv']; unfold Q; ring
      have := mul_left_cancel₀ hp0 (mul_left_cancel₀ hp0 this)
      simpa using this
    · simp only [mulE, Prod.mk.injEq]
      constructor
      · apply mul_left_cancel₀ hp0
        have e1 : (p : ℤ) * a = c * u - d * v := by rw [hu, hvdef, ← hcd]; unfold Q; ring
        rw [e1, hu', hv']; ring
      · apply mul_left_cancel₀ hp0
        have e2 : (p : ℤ) * b = c * v + d * u - d * v := by rw [hu, hvdef, ← hcd]; unfold Q; ring
        rw [e2, hu', hv']; ring
  · -- case 2: p ∣ ad + bc - bd ; use direct multiplication
    set u := a * c - b * d with hu
    set v := a * d + b * c - b * d with hvdef
    have hQuv : Q u v = (p : ℤ) * (p * m) := by
      have : (u, v) = mulE c d (a, b) := by simp [mulE, hu, hvdef]; constructor <;> ring
      have e := Q_mulE c d (a, b)
      rw [← this] at e; simp at e; rw [e, hcd, h]
    have hv' : v = (p : ℤ) * v' := by rw [hvdef]; linear_combination hv
    have hu2 : (p : ℤ) ∣ u * u := by
      have : u * u = Q u v + u * v - v * v := by unfold Q; ring
      rw [this, hQuv, hv']
      exact ⟨p * m + u * v' - p * v' * v', by ring⟩
    obtain ⟨u', hu'⟩ := hpz.dvd_of_dvd_pow (show (p : ℤ) ∣ u ^ 2 by rw [sq]; exact hu2)
    refine ⟨(u', v'), ?_, Or.inr ?_⟩
    · have : (p : ℤ) * (p * Q u' v') = (p : ℤ) * (p * m) := by
        rw [← hQuv, hu', hv']; unfold Q; ring
      exact mul_left_cancel₀ hp0 (mul_left_cancel₀ hp0 this)
    · simp only [mulE, Prod.mk.injEq]
      constructor
      · apply mul_left_cancel₀ hp0
        have e1 : (p : ℤ) * a = (c - d) * u + d * v := by rw [hu, hvdef, ← hcd]; unfold Q; ring
        rw [e1, hu', hv']; ring
      · apply mul_left_cancel₀ hp0
        have e2 : (p : ℤ) * b = c * v - d * u := by rw [hu, hvdef, ← hcd]; unfold Q; ring
        rw [e2, hu', hv']; ring

/-- Force a natural number to a literal before continuing (kernel-friendly). -/
def forceN {α : Type*} (v : ℕ) (k : ℕ → α) : α := match v with | 0 => k 0 | n+1 => k (n+1)
theorem forceN_eq {α : Type*} (v : ℕ) (k : ℕ → α) : forceN v k = k v := by cases v <;> rfl

/-- Read `w` bits from the certificate stream. -/
def readF {α : Type*} (cert w : ℕ) (k : ℕ → ℕ → α) : α :=
  forceN (cert % 2 ^ w) fun v => forceN (cert / 2 ^ w) fun r => k v r
theorem readF_eq {α : Type*} (cert w : ℕ) (k : ℕ → ℕ → α) : readF cert w k = k (cert % 2 ^ w) (cert / 2 ^ w) := by
  unfold readF; rw [forceN_eq, forceN_eq]

/- ### Integer square root (Newton, unverified) with verified non-square test -/
def sqrtIter (g : ℕ) : ℕ → ℕ → ℕ
  | 0, guess => guess
  | fuel+1, guess =>
    let next := (guess + g / guess) / 2
    if next < guess then sqrtIter g fuel next else guess
def isqrt (g : ℕ) : ℕ := sqrtIter g 64 (1 <<< (g.log2 / 2 + 1))
def notSquare (g : ℕ) : Bool :=
  let r := isqrt g
  decide (r * r < g) && decide (g < (r + 1) * (r + 1))
theorem notSquare_sound {g : ℕ} (h : notSquare g = true) (s : ℕ) : s * s ≠ g := by
  unfold notSquare at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨h1, h2⟩ := h
  intro hs
  have h3 : isqrt g < s := by
    by_contra hc; push_neg at hc; nlinarith
  have h4 : s < isqrt g + 1 := by
    by_contra hc; push_neg at hc; nlinarith
  omega

/- ### Modular exponentiation -/
def powModF (m : ℕ) : ℕ → ℕ → ℕ → ℕ → ℕ
  | 0, _, _, acc => acc
  | f+1, a, e, acc =>
    forceN (a * a % m) fun a' =>
      forceN (cond (Nat.beq (e % 2) 1) (acc * a % m) acc) fun acc' =>
        powModF m f a' (e / 2) acc'
def powMod (a e m : ℕ) : ℕ := powModF m (Nat.log2 e + 1) (a % m) e (1 % m)

theorem powModF_eq (m : ℕ) (hm : 0 < m) :
    ∀ f a e acc, e < 2 ^ f → acc < m → powModF m f a e acc = acc * a ^ e % m := by
  intro f
  induction f with
  | zero => intro a e acc he hacc; simp at he; subst he; simp [powModF, Nat.mod_eq_of_lt hacc]
  | succ f ih =>
    intro a e acc he hacc
    unfold powModF
    rw [forceN_eq, forceN_eq]
    have he2 : e / 2 < 2 ^ f := by
      rw [pow_succ] at he; omega
    have hsplit : a ^ e = a ^ (e % 2) * (a * a) ^ (e / 2) := by
      rw [← pow_two, ← pow_mul, ← pow_add]; congr 1; omega
    rcases Nat.mod_two_eq_zero_or_one e with h | h
    · rw [h]
      simp only [cond]
      rw [ih _ _ _ he2 hacc, hsplit, h, pow_zero, one_mul]
      rw [Nat.mul_mod, Nat.pow_mod, Nat.mod_mod, ← Nat.pow_mod, ← Nat.mul_mod]
    · rw [h]
      simp only [cond]
      rw [ih _ _ _ he2 (Nat.mod_lt _ hm), hsplit, h, pow_one]
      rw [Nat.mul_mod, Nat.mod_mod, Nat.pow_mod, Nat.mod_mod, ← Nat.pow_mod, ← Nat.mul_mod, mul_assoc]

theorem powMod_eq (a e m : ℕ) (hm : 0 < m) : powMod a e m = a ^ e % m := by
  unfold powMod
  rw [powModF_eq m hm _ _ _ _ Nat.lt_log2_self (Nat.mod_lt _ hm)]
  rw [Nat.mul_mod, Nat.mod_mod, Nat.pow_mod, Nat.mod_mod, ← Nat.pow_mod, ← Nat.mul_mod, one_mul]

/- ### Product tree for factorials -/
def prodTree : ℕ → ℕ → ℕ → ℕ
  | 0, n, cnt => n.ascFactorial cnt
  | f+1, n, cnt =>
    if cnt ≤ 8 then n.ascFactorial cnt
    else prodTree f n (cnt / 2) * prodTree f (n + cnt / 2) (cnt - cnt / 2)

theorem ascFactorial_add' (n a : ℕ) : ∀ b, n.ascFactorial (a + b) = n.ascFactorial a * (n + a).ascFactorial b := by
  intro b
  induction b with
  | zero => simp
  | succ b ih =>
    rw [← Nat.add_assoc, Nat.ascFactorial_succ, Nat.ascFactorial_succ, ih]; ring

theorem prodTree_eq : ∀ f n cnt, prodTree f n cnt = n.ascFactorial cnt := by
  intro f
  induction f with
  | zero => intro n cnt; rfl
  | succ f ih =>
    intro n cnt
    unfold prodTree
    split_ifs with h
    · rfl
    · rw [ih, ih, ← ascFactorial_add']; congr 1; omega

def fact (B : ℕ) : ℕ := prodTree 24 1 B
theorem fact_eq (B : ℕ) : fact B = Nat.factorial B := by
  unfold fact; rw [prodTree_eq, Nat.one_ascFactorial]

/- ### Primality certificates -/
theorem prime_of_coprime_factorial {p B : ℕ} (h1 : 1 < p) (h2 : p < (B + 1) ^ 2)
    (h : Nat.gcd p (Nat.factorial B) = 1) : p.Prime := by
  by_contra hnp
  have hmin := Nat.minFac_sq_le_self (by omega) hnp
  have hpos := Nat.minFac_pos p
  have hle : p.minFac ≤ B := by
    by_contra hc; push_neg at hc
    have : (B + 1) ^ 2 ≤ p.minFac ^ 2 := Nat.pow_le_pow_left hc 2
    omega
  have hdvd : p.minFac ∣ Nat.factorial B := Nat.dvd_factorial hpos hle
  have hg : p.minFac ∣ Nat.gcd p (Nat.factorial B) := Nat.dvd_gcd (Nat.minFac_dvd p) hdvd
  rw [h] at hg
  have := Nat.le_of_dvd one_pos hg
  have := (Nat.minFac_prime (by omega : p ≠ 1)).two_le
  omega

theorem prime_of_lucas_powMod (p a : ℕ) (hp : 1 < p) (hp64 : p < 2 ^ 64)
    (ha : powMod a (p - 1) p = 1)
    (qs : List (ℕ × ℕ)) (hqs : ∀ x ∈ qs, x.1.Prime)
    (hprod : p - 1 = (qs.map fun x => x.1 ^ x.2).prod)
    (hd : ∀ x ∈ qs, powMod a ((p - 1) / x.1) p ≠ 1) : p.Prime := by
  apply lucas_primality p (a : ZMod p)
  · rw [powMod_eq _ _ _ (by omega)] at ha
    have := congrArg (fun t : ℕ => (t : ZMod p)) ha
    simpa [ZMod.natCast_mod] using this
  · intro q hq hqd h1
    have hqz : Prime q := Nat.prime_iff.mp hq
    rw [hprod, Prime.dvd_prod_iff hqz] at hqd
    obtain ⟨y, hy, hqy⟩ := hqd
    rw [List.mem_map] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    have hqx : q = x.1 := (Nat.prime_dvd_prime_iff_eq hq (hqs x hx)).mp (hq.dvd_of_dvd_pow hqy)
    apply hd x hx
    rw [← hqx, powMod_eq _ _ _ (by omega)]
    have h2 : ((a ^ ((p - 1) / q) % p : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by
      rw [ZMod.natCast_mod]; push_cast; exact h1
    rw [ZMod.natCast_eq_natCast_iff'] at h2
    rw [Nat.mod_eq_of_lt (Nat.mod_lt _ (by omega)), Nat.mod_eq_of_lt hp] at h2
    exact h2


/- ## Enumeration of representations up to associates, in canonical ℕ form -/

def units : List (ℤ × ℤ) := [(1, 0), (-1, 0), (0, 1), (0, -1), (1, 1), (-1, -1)]

theorem units_complete : ∀ a b : ℤ, Q a b = 1 → (a, b) ∈ units := by
  intro a b h
  have h4 := four_mul_Q a b
  rw [h] at h4
  have hb : b ^ 2 ≤ 1 := by nlinarith [sq_nonneg (2 * a - b)]
  have hb1 : -1 ≤ b := by nlinarith
  have hb2 : b ≤ 1 := by nlinarith
  have ha1 : -1 ≤ a := by nlinarith [sq_nonneg (2 * a - b), sq_nonneg b]
  have ha2 : a ≤ 1 := by nlinarith [sq_nonneg (2 * a - b), sq_nonneg b]
  unfold Q at h
  interval_cases a <;> interval_cases b <;> simp_all [units]

/-- `u` is an associate of `v`: `u = ε v` for a unit `ε`. -/
def Assoc (u v : ℤ × ℤ) : Prop := ∃ e ∈ units, u = mulE e.1 e.2 v

theorem mulE_mulE (c d c' d' : ℤ) (x : ℤ × ℤ) :
    mulE c d (mulE c' d' x) = mulE (mulE c d (c', d')).1 (mulE c d (c', d')).2 x := by
  simp only [mulE, Prod.mk.injEq]; constructor <;> ring

theorem mulE_one (x : ℤ × ℤ) : mulE 1 0 x = x := by
  simp only [mulE]; ext <;> simp

theorem units_mul : ∀ e ∈ units, ∀ e' ∈ units, mulE e.1 e.2 e' ∈ units := by decide

theorem units_inv : ∀ e ∈ units, ∃ e' ∈ units, mulE e'.1 e'.2 e = (1, 0) := by decide

theorem Assoc.refl (v : ℤ × ℤ) : Assoc v v := ⟨(1, 0), by simp [units], (mulE_one v).symm⟩

theorem Assoc.trans {u v w : ℤ × ℤ} (h1 : Assoc u v) (h2 : Assoc v w) : Assoc u w := by
  obtain ⟨e, he, rfl⟩ := h1
  obtain ⟨e', he', rfl⟩ := h2
  exact ⟨_, units_mul e he e' he', mulE_mulE _ _ _ _ w⟩

theorem Assoc.symm {u v : ℤ × ℤ} (h : Assoc u v) : Assoc v u := by
  obtain ⟨e, he, rfl⟩ := h
  obtain ⟨e', he', hee'⟩ := units_inv e he
  refine ⟨e', he', ?_⟩
  rw [mulE_mulE, hee', mulE_one]

theorem assoc_mulE (c d : ℤ) {u v : ℤ × ℤ} (h : Assoc u v) : Assoc (mulE c d u) (mulE c d v) := by
  obtain ⟨e, he, rfl⟩ := h
  refine ⟨e, he, ?_⟩
  simp only [mulE, Prod.mk.injEq]; constructor <;> ring

theorem assoc_smul (q : ℤ) {u v : ℤ × ℤ} (h : Assoc u v) : Assoc (q * u.1, q * u.2) (q * v.1, q * v.2) := by
  obtain ⟨e, he, rfl⟩ := h
  refine ⟨e, he, ?_⟩
  ext <;> simp only [mulE] <;> ring

/-- Multiplication by the conjugate `(c - d) - dω` is, up to a unit, multiplication by `c + (c-d)ω`. -/
theorem assoc_conj (c d : ℤ) (x : ℤ × ℤ) : Assoc (mulE c (c - d) x) (mulE (c - d) (-d) x) := by
  refine ⟨(1, 1), by simp [units], ?_⟩
  simp only [mulE, Prod.mk.injEq]; constructor <;> ring

def toZ (x : ℕ × ℕ) : ℤ × ℤ := ((x.1 : ℤ), (x.2 : ℤ))

/-- Multiply the canonical representative `x` (with `x.2 < x.1`) by `c + dω` (with `d < c`),
returning a canonical representative of the product. -/
def mulN (c d : ℕ) (x : ℕ × ℕ) : ℕ × ℕ :=
  forceN (c * x.1 - d * x.2) fun a' => forceN (c * x.2 + d * x.1 - d * x.2) fun b' =>
    if b' < a' then (a', b') else (b', b' - a')

theorem mulN_spec {c d : ℕ} (hc : d < c) {x : ℕ × ℕ} (hx : x.2 < x.1) :
    Assoc (toZ (mulN c d x)) (mulE c d (toZ x)) ∧ (mulN c d x).2 < (mulN c d x).1 := by
  obtain ⟨a, b⟩ := x
  simp only at hx
  have h1 : d * b < c * a := by nlinarith
  have h2 : d * b ≤ c * b + d * a := by nlinarith
  unfold mulN
  rw [forceN_eq, forceN_eq]
  dsimp only
  split_ifs with h
  · refine ⟨?_, h⟩
    refine ⟨(1, 0), by simp [units], ?_⟩
    simp only [toZ, mulE, Prod.mk.injEq]
    push_cast [Nat.cast_sub h1.le, Nat.cast_sub h2]
    constructor <;> ring
  · refine ⟨?_, by omega⟩
    refine ⟨(0, -1), by simp [units], ?_⟩
    simp only [toZ, mulE, Prod.mk.injEq]
    push_cast [Nat.cast_sub h1.le, Nat.cast_sub h2, Nat.cast_sub (not_lt.mp h)]
    constructor <;> ring

def stepP (c d : ℕ) (L : List (ℕ × ℕ)) : List (ℕ × ℕ) :=
  L.map (mulN c d) ++ L.map (mulN c (c - d))

def stepQ (q : ℕ) (L : List (ℕ × ℕ)) : List (ℕ × ℕ) := L.map (fun x => (q * x.1, q * x.2))

def iterP (c d : ℕ) : ℕ → List (ℕ × ℕ) → List (ℕ × ℕ)
  | 0, L => L
  | e+1, L => iterP c d e (stepP c d L)

def iterQ (q : ℕ) : ℕ → List (ℕ × ℕ) → List (ℕ × ℕ)
  | 0, L => L
  | e+1, L => iterQ q e (stepQ q L)

/-- `L` is a list of canonical representatives containing all representations of `m` up to associates. -/
def Complete (m : ℤ) (L : List (ℕ × ℕ)) : Prop :=
  (∀ x ∈ L, x.2 < x.1) ∧ ∀ a b : ℤ, Q a b = m → ∃ x ∈ L, Assoc (a, b) (toZ x)

theorem complete_one : Complete 1 [(1, 0)] := by
  refine ⟨by simp, ?_⟩
  intro a b h
  have := units_complete a b h
  refine ⟨(1, 0), by simp, (a, b), this, ?_⟩
  simp only [toZ, mulE]; ext <;> simp

theorem complete_stepP {p : ℕ} (hp : p.Prime) {c d : ℕ} (hd : 0 < d) (hc : d < c)
    (hcd : Q c d = p) {m : ℤ} {L : List (ℕ × ℕ)} (hL : Complete m L) :
    Complete (p * m) (stepP c d L) := by
  obtain ⟨hcan, hL⟩ := hL
  constructor
  · intro y hy
    unfold stepP at hy
    rw [List.mem_append, List.mem_map, List.mem_map] at hy
    rcases hy with ⟨x, hx, rfl⟩ | ⟨x, hx, rfl⟩
    · exact (mulN_spec hc (hcan x hx)).2
    · exact (mulN_spec (by omega) (hcan x hx)).2
  intro a b h
  obtain ⟨y, hy, hab⟩ := descent hp hcd h
  obtain ⟨x, hxL, hyx⟩ := hL y.1 y.2 hy
  have hxc := hcan x hxL
  unfold stepP
  rcases hab with hab | hab
  · refine ⟨mulN c d x, ?_, ?_⟩
    · rw [List.mem_append, List.mem_map]; exact Or.inl ⟨x, hxL, rfl⟩
    · rw [hab]
      exact (assoc_mulE c d hyx).trans (mulN_spec hc hxc).1.symm
  · refine ⟨mulN c (c - d) x, ?_, ?_⟩
    · rw [List.mem_append, List.mem_map, List.mem_map]; exact Or.inr ⟨x, hxL, rfl⟩
    · rw [hab]
      have h1 := (assoc_mulE ((c : ℤ) - d) (-(d : ℤ)) hyx)
      have h2 := assoc_conj (c : ℤ) (d : ℤ) (toZ x)
      have h3 := (mulN_spec (by omega : c - d < c) hxc).1
      rw [Nat.cast_sub hc.le] at h3
      exact h1.trans (h2.symm.trans h3.symm)

theorem complete_stepQ {q : ℕ} (hq : q.Prime) (h3 : q % 3 = 2) (h2 : q ≠ 2) {m : ℤ}
    {L : List (ℕ × ℕ)} (hL : Complete m L) : Complete ((q : ℤ) ^ 2 * m) (stepQ q L) := by
  obtain ⟨hcan, hL⟩ := hL
  have hq0 : 0 < q := hq.pos
  constructor
  · intro y hy
    unfold stepQ at hy
    rw [List.mem_map] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    have := hcan x hx
    simp only
    exact Nat.mul_lt_mul_of_pos_left this hq0
  intro a b h
  have hd : (q : ℤ) ∣ Q a b := by rw [h]; exact dvd_mul_of_dvd_left (dvd_pow_self _ (by omega)) _
  obtain ⟨⟨a', ha⟩, ⟨b', hb⟩⟩ := dvd_of_dvd_Q hq h3 h2 hd
  subst ha; subst hb
  have hq0' : (q : ℤ) ^ 2 ≠ 0 := pow_ne_zero 2 (by exact_mod_cast hq.ne_zero)
  have e : Q ((q : ℤ) * a') ((q : ℤ) * b') = (q : ℤ) ^ 2 * Q a' b' := by unfold Q; ring
  rw [e] at h
  obtain ⟨x, hxL, hx⟩ := hL a' b' (mul_left_cancel₀ hq0' h)
  refine ⟨(q * x.1, q * x.2), ?_, ?_⟩
  · unfold stepQ; rw [List.mem_map]; exact ⟨x, hxL, rfl⟩
  · have := assoc_smul (q : ℤ) hx
    simpa [toZ] using this

theorem complete_iterP {p : ℕ} (hp : p.Prime) {c d : ℕ} (hd : 0 < d) (hc : d < c) (hcd : Q c d = p) :
    ∀ (e : ℕ) {m : ℤ} {L : List (ℕ × ℕ)}, Complete m L → Complete ((p : ℤ) ^ e * m) (iterP c d e L) := by
  intro e
  induction e with
  | zero => intro m L h; simpa [iterP] using h
  | succ e ih =>
    intro m L h
    have := ih (complete_stepP hp hd hc hcd h)
    unfold iterP
    have e' : (p : ℤ) ^ (e + 1) * m = (p : ℤ) ^ e * (p * m) := by ring
    rw [e']; exact this

theorem complete_iterQ {q : ℕ} (hq : q.Prime) (h3 : q % 3 = 2) (h2 : q ≠ 2) :
    ∀ (e : ℕ) {m : ℤ} {L : List (ℕ × ℕ)}, Complete m L → Complete ((q : ℤ) ^ (2 * e) * m) (iterQ q e L) := by
  intro e
  induction e with
  | zero => intro m L h; simpa [iterQ] using h
  | succ e ih =>
    intro m L h
    have := ih (complete_stepQ hq h3 h2 h)
    unfold iterQ
    have e' : (q : ℤ) ^ (2 * (e + 1)) * m = (q : ℤ) ^ (2 * e) * ((q : ℤ) ^ 2 * m) := by ring
    rw [e']; exact this

/-- The "good" representations: those coming from an actual solution. -/
def good (a b : ℤ) : Prop := b % 2 = 1 ∧ 3 ≤ b ∧ ∃ t : ℕ, 3 ≤ t ∧ (t : ℤ) * t = 8 * a - 4 * b + 5

/-- Bitmask of the squares modulo `20160 = 64 * 63 * 5`. -/
def sqMask : ℕ := 

def sqRes (r : ℕ) : Bool := Nat.testBit sqMask r

def sqCheck : ℕ → Bool
  | 0 => true
  | r + 1 => sqRes (r * r % 20160) && sqCheck r

theorem sqCheck_sound : ∀ n, sqCheck n = true → ∀ r, r < n → sqRes (r * r % 20160) = true := by
  intro n
  induction n with
  | zero => intro _ r hr; omega
  | succ n ih =>
    intro h r hr
    simp only [sqCheck, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hr with hlt | rfl
    · exact ih h.2 r hlt
    · exact h.1

set_option maxRecDepth 100000 in
theorem sqCheck_all : sqCheck 20160 = true := by decide +kernel

theorem sqRes_sound (s : ℕ) : sqRes (s * s % 20160) = true := by
  rw [Nat.mul_mod]
  exact sqCheck_sound 20160 sqCheck_all _ (Nat.mod_lt _ (by norm_num))

/-- Test for a good representation `(a, b)` with `a b : ℕ`. -/
def badN (a b : ℕ) : Bool :=
  Nat.beq (b % 2) 1 && Nat.ble 3 b && Nat.ble (b + 1) (2 * a) &&
    (sqRes ((8 * a + 5 - 4 * b) % 20160) && !notSquare (8 * a + 5 - 4 * b))

theorem badN_of_good {a b : ℕ} (h : good a b) : badN a b = true := by
  obtain ⟨h1, h2, t, ht, hteq⟩ := h
  have h1' : b % 2 = 1 := by omega
  have h2' : 3 ≤ b := by exact_mod_cast h2
  have h9 : (9 : ℤ) ≤ (t : ℤ) * t := by
    have : (3 : ℤ) ≤ t := by exact_mod_cast ht
    nlinarith
  have h3 : b + 1 ≤ 2 * a := by
    have : (4 * (b : ℤ) + 4 ≤ 8 * a) := by linarith
    omega
  have hg : 8 * a + 5 - 4 * b = t * t := by
    have : ((8 * a + 5 - 4 * b : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by
      rw [Nat.cast_sub (by omega)]; push_cast; linarith
    exact_mod_cast this
  unfold badN
  simp only [Bool.and_eq_true, Nat.beq_eq, Nat.ble_eq, Bool.not_eq_true']
  refine ⟨⟨⟨h1', h2'⟩, h3⟩, ?_, ?_⟩
  · rw [hg]; exact sqRes_sound t
  · by_contra hc
    rw [Bool.not_eq_false] at hc
    exact notSquare_sound hc t hg.symm

/-- Test whether any associate of the canonical representative `x` is good. -/
def badC (x : ℕ × ℕ) : Bool := badN x.1 x.2 || badN (x.1 - x.2) x.1

theorem badC_of_good {a b : ℤ} (hg : good a b) {x : ℕ × ℕ} (hx : x.2 < x.1)
    (hA : Assoc (a, b) (toZ x)) : badC x = true := by
  obtain ⟨e, he, hab⟩ := hA
  obtain ⟨u, v⟩ := x
  simp only at hx
  simp only [toZ, mulE, Prod.mk.injEq] at hab
  obtain ⟨ha, hb⟩ := hab
  have hg' := hg
  obtain ⟨h1, h2, t, ht, hteq⟩ := hg
  have h9 : (9 : ℤ) ≤ (t : ℤ) * t := by
    have : (3 : ℤ) ≤ t := by exact_mod_cast ht
    nlinarith
  have hpos : 0 < a ∧ 0 < b := by constructor <;> linarith
  simp only [units, List.mem_cons, List.mem_nil_iff, or_false] at he
  unfold badC
  rw [Bool.or_eq_true]
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;> simp only at ha hb
  · left
    apply badN_of_good
    have ea : a = u := by rw [ha]; ring
    have eb : b = v := by rw [hb]; ring
    rw [ea, eb] at hg'; exact hg'
  · exfalso; have : b = -(v : ℤ) := by rw [hb]; ring
    omega
  · exfalso; have : a = -(v : ℤ) := by rw [ha]; ring
    omega
  · exfalso; have : b = (v : ℤ) - u := by rw [hb]; ring
    omega
  · right
    apply badN_of_good
    have ea : a = ((u - v : ℕ) : ℤ) := by rw [ha, Nat.cast_sub hx.le]; ring
    have eb : b = u := by rw [hb]; ring
    rw [ea, eb] at hg'; exact hg'
  · exfalso; have : b = -(u : ℤ) := by rw [hb]; ring
    omega

/-- Key lemma: an actual solution yields a good representation. -/
theorem good_of_solution (W X n' : ℕ) (hW : 2 ≤ W) (hX : 3 ≤ X)
    (h : W.choose 2 + X.choose 4 = n') :
    ∃ a b : ℤ, Q a b = 6 * n' + 1 ∧ good a b := by
  obtain ⟨u, hu⟩ : ∃ u : ℕ, u = X * (X - 3) / 2 := ⟨_, rfl⟩
  have key := key_identity W X (by omega) hX
  rw [← hu] at key
  have h3 : 2 * u = X * (X - 3) := by
    rw [hu]
    apply Nat.mul_div_cancel'
    have h : X * (X - 3) = X * (X - 1) - 2 * X := by
      have : X - 3 = (X - 1) - 2 := by omega
      rw [this, Nat.mul_sub, Nat.mul_comm X 2]
    rw [h]
    exact Nat.dvd_sub (even_iff_two_dvd.mp (Nat.even_mul_pred_self X)) (dvd_mul_right 2 X)
  have h3' : (2 * u : ℤ) = (X : ℤ) * ((X : ℤ) - 3) := by
    have := congrArg (fun t : ℕ => (t : ℤ)) h3; push_cast [Nat.cast_sub hX] at this; linarith
  refine ⟨(u : ℤ) + W, 2 * W - 1, ?_, ?_⟩
  · rw [← key, ← h]; push_cast; ring
  · refine ⟨by omega, by omega, 2 * X - 3, by omega, ?_⟩
    push_cast [Nat.cast_sub (by omega : 3 ≤ 2 * X)]
    linear_combination (-4 : ℤ) * h3'

/- ### Primality certificate checker -/

def factorsLoop (pc : ℕ → ℕ → Option ℕ) (p a : ℕ) : ℕ → ℕ → ℕ → Option ℕ
  | 0, r, cert => if r = 1 then some cert else none
  | k+1, r, cert => readF cert 56 fun q cert => readF cert 6 fun f cert =>
      if q ^ f ∣ r ∧ powMod a ((p - 1) / q) p ≠ 1 then
        match pc q cert with
        | none => none
        | some cert => factorsLoop pc p a k (r / q ^ f) cert
      else none

/-- Bitmask of the primes below 64. -/
def smallPrimeMask : ℕ := 0x28208A20A08A28AC

theorem smallPrimeMask_sound : ∀ p, p < 64 → Nat.testBit smallPrimeMask p = true → p.Prime := by
  decide

def pockLoop (pc : ℕ → ℕ → Option ℕ) (p : ℕ) : ℕ → ℕ → ℕ → Option (ℕ × ℕ)
  | 0, F, cert => some (F, cert)
  | k+1, F, cert => readF cert 56 fun q cert => readF cert 16 fun a cert =>
      forceN (powMod a ((p - 1) / q) p) fun x =>
      if q ∣ p - 1 ∧ Nat.gcd F q = 1 ∧ Nat.gcd (x + p - 1) p = 1 ∧ powMod x q p = 1 then
        match pc q cert with
        | none => none
        | some cert => forceN (F * q) fun F' => pockLoop pc p k F' cert
      else none

def primeCert (F17 F316 FB : ℕ) : ℕ → ℕ → ℕ → Option ℕ
  | 0, _, _ => none
  | fuel+1, p, cert => readF cert 3 fun tag cert =>
      if tag = 0 then (if p < 64 ∧ Nat.testBit smallPrimeMask p then some cert else none)
      else if tag = 1 then (if 1 < p ∧ p < 18 ^ 2 ∧ Nat.gcd p F17 = 1 then some cert else none)
      else if tag = 2 then (if 1 < p ∧ p < 317 ^ 2 ∧ Nat.gcd p F316 = 1 then some cert else none)
      else if tag = 3 then (if 1 < p ∧ p < 100001 ^ 2 ∧ Nat.gcd p FB = 1 then some cert else none)
      else if tag = 4 then readF cert 16 fun a cert => readF cert 4 fun k cert =>
        if 1 < p ∧ p < 2 ^ 64 ∧ powMod a (p - 1) p = 1 then
          factorsLoop (primeCert F17 F316 FB fuel) p a k (p - 1) cert
        else none
      else if tag = 5 then readF cert 4 fun k cert =>
        if 1 < p ∧ p < 2 ^ 64 then
          match pockLoop (primeCert F17 F316 FB fuel) p k 1 cert with
          | none => none
          | some (F, cert) => if p < (F + 1) ^ 2 then some cert else none
        else none
      else none

theorem factorsLoop_sound (pc : ℕ → ℕ → Option ℕ) (hpc : ∀ q c, (pc q c).isSome → q.Prime) (p a : ℕ) :
    ∀ k r cert, (factorsLoop pc p a k r cert).isSome →
      ∃ qs : List (ℕ × ℕ), (∀ x ∈ qs, x.1.Prime) ∧ r = (qs.map fun x => x.1 ^ x.2).prod ∧
        ∀ x ∈ qs, powMod a ((p - 1) / x.1) p ≠ 1 := by
  intro k
  induction k with
  | zero =>
    intro r cert h
    unfold factorsLoop at h
    split_ifs at h with hr
    · exact ⟨[], by simp, by simp [hr], by simp⟩
    · simp at h
  | succ k ih =>
    intro r cert h
    unfold factorsLoop at h
    rw [readF_eq, readF_eq] at h
    split_ifs at h with hc
    · obtain ⟨hdvd, hpow⟩ := hc
      set q := cert % 2 ^ 56
      set f := cert / 2 ^ 56 % 2 ^ 6
      set cert1 := cert / 2 ^ 56 / 2 ^ 6
      cases hq : pc q cert1 with
      | none => rw [hq] at h; simp at h
      | some cert2 =>
        rw [hq] at h
        have hqp : q.Prime := hpc q cert1 (by rw [hq]; rfl)
        obtain ⟨qs, h1, h2, h3⟩ := ih _ _ h
        refine ⟨(q, f) :: qs, ?_, ?_, ?_⟩
        · intro x hx; rw [List.mem_cons] at hx; rcases hx with rfl | hx; exact hqp; exact h1 x hx
        · simp only [List.map_cons, List.prod_cons]; rw [← h2]
          exact (Nat.mul_div_cancel' hdvd).symm
        · intro x hx; rw [List.mem_cons] at hx; rcases hx with rfl | hx; exact hpow; exact h3 x hx
    · simp at h

theorem pock_step {p q a x r : ℕ} (hp1 : 1 < p) (hp64 : p < 2 ^ 64) (hq : q.Prime) (hr : r.Prime) (hrp : r ∣ p)
    (hx : x = powMod a ((p - 1) / q) p) (hg : Nat.gcd (x + p - 1) p = 1) (hpow : powMod x q p = 1) :
    q ∣ r - 1 := by
  haveI := Fact.mk hr
  have hp0 : 0 < p := by omega
  have hxlt : x < p := by
    rw [hx, powMod_eq _ _ _ hp0]
    exact Nat.mod_lt _ hp0
  rw [powMod_eq _ _ _ hp0] at hpow
  -- x^q ≡ 1 mod r
  have hxq : ((x : ZMod r)) ^ q = 1 := by
    have h1 : ((x ^ q : ℕ) : ZMod r) = ((1 : ℕ) : ZMod r) := by
      rw [ZMod.natCast_eq_natCast_iff']
      have hmod : x ^ q % p = 1 := hpow
      obtain ⟨k, hk⟩ := hrp
      have : x ^ q % r = (x ^ q % p) % r := by
        rw [hk, Nat.mul_comm]; exact (Nat.mod_mul_left_mod _ _ _).symm
      rw [this, hmod]
    push_cast at h1
    exact h1
  have hx0 : (x : ZMod r) ≠ 0 := by
    intro h0
    rw [h0, zero_pow hq.ne_zero] at hxq
    exact zero_ne_one hxq
  have hx1 : (x : ZMod r) ≠ 1 := by
    intro h1
    have hr0 : ((p : ℕ) : ZMod r) = 0 := (ZMod.natCast_eq_zero_iff p r).mpr hrp
    have : ((x + p - 1 : ℕ) : ZMod r) = 0 := by
      rw [Nat.cast_sub (by omega), Nat.cast_add, h1, hr0]; simp
    have hd : r ∣ x + p - 1 := (ZMod.natCast_eq_zero_iff _ _).mp this
    have : r ∣ Nat.gcd (x + p - 1) p := Nat.dvd_gcd hd hrp
    rw [hg] at this
    exact hr.one_lt.ne' (Nat.dvd_one.mp this)
  have hord : orderOf (x : ZMod r) = q := by
    have hdvd : orderOf (x : ZMod r) ∣ q := orderOf_dvd_of_pow_eq_one hxq
    rcases (Nat.dvd_prime hq).mp hdvd with h | h
    · exfalso; exact hx1 (orderOf_eq_one_iff.mp h)
    · exact h
  rw [← hord]
  exact ZMod.orderOf_dvd_card_sub_one hx0

theorem pockLoop_sound (pc : ℕ → ℕ → Option ℕ) (hpc : ∀ q c, (pc q c).isSome → q.Prime)
    (p : ℕ) (hp1 : 1 < p) (hp64 : p < 2 ^ 64) :
    ∀ k F cert F' cert', pockLoop pc p k F cert = some (F', cert') →
