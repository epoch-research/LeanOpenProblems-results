/-! ## Witness lemma -/

theorem a_pos_of_witness (n k r : ℕ) (hk : 1 ≤ k) (hkn : 2 * k < n)
    (h : φ k * φ (n - k) = r * r) : 0 < a n := by
  unfold a
  have hmem : k ∈ Ico 1 ((n - 1) / 2 + 1) := by
    rw [Finset.mem_Ico]; omega
  have hterm : (fun k => let m := φ k * φ (n - k); if sqrt m ^ 2 = m then 1 else 0) k = 1 := by
    simp only
    rw [h, ← pow_two, Nat.sqrt_eq', if_pos rfl]
  calc 0 < 1 := Nat.one_pos
    _ = (fun k => let m := φ k * φ (n - k); if sqrt m ^ 2 = m then 1 else 0) k := hterm.symm
    _ ≤ _ := Finset.single_le_sum (f := fun k => let m := φ k * φ (n - k); if sqrt m ^ 2 = m then 1 else 0)
          (fun _ _ => Nat.zero_le _) hmem

/-! ## Totient of smooth numbers -/

def pp (p e : ℕ) : ℕ := if e = 0 then 1 else p ^ (e - 1) * (p - 1)

theorem totient_pow_eq_pp (p : ℕ) (hp : p.Prime) (e : ℕ) : φ (p ^ e) = pp p e := by
  unfold pp
  split_ifs with h
  · subst h; simp
  · exact Nat.totient_prime_pow hp (Nat.pos_of_ne_zero h)

theorem coprime_pow_pow_of_primes {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q) (a b : ℕ) :
    Nat.Coprime (p ^ a) (q ^ b) :=
  Nat.Coprime.pow a b ((Nat.coprime_primes hp hq).mpr hne)

theorem phi6 (a b c d e f : ℕ) :
    φ (2 ^ a * 3 ^ b * 5 ^ c * 7 ^ d * 11 ^ e * 13 ^ f) =
      pp 2 a * pp 3 b * pp 5 c * pp 7 d * pp 11 e * pp 13 f := by
  have p2 : Nat.Prime 2 := by norm_num
  have p3 : Nat.Prime 3 := by norm_num
  have p5 : Nat.Prime 5 := by norm_num
  have p7 : Nat.Prime 7 := by norm_num
  have p11 : Nat.Prime 11 := by norm_num
  have p13 : Nat.Prime 13 := by norm_num
  have c1 : Nat.Coprime (2 ^ a) (3 ^ b) := coprime_pow_pow_of_primes p2 p3 (by norm_num) _ _
  have c2 : Nat.Coprime (2 ^ a * 3 ^ b) (5 ^ c) :=
    Nat.Coprime.mul_left (coprime_pow_pow_of_primes p2 p5 (by norm_num) _ _)
      (coprime_pow_pow_of_primes p3 p5 (by norm_num) _ _)
  have c3 : Nat.Coprime (2 ^ a * 3 ^ b * 5 ^ c) (7 ^ d) :=
    Nat.Coprime.mul_left (Nat.Coprime.mul_left (coprime_pow_pow_of_primes p2 p7 (by norm_num) _ _)
      (coprime_pow_pow_of_primes p3 p7 (by norm_num) _ _))
      (coprime_pow_pow_of_primes p5 p7 (by norm_num) _ _)
  have c4 : Nat.Coprime (2 ^ a * 3 ^ b * 5 ^ c * 7 ^ d) (11 ^ e) :=
    Nat.Coprime.mul_left (Nat.Coprime.mul_left (Nat.Coprime.mul
      (coprime_pow_pow_of_primes p2 p11 (by norm_num) _ _)
      (coprime_pow_pow_of_primes p3 p11 (by norm_num) _ _))
      (coprime_pow_pow_of_primes p5 p11 (by norm_num) _ _))
      (coprime_pow_pow_of_primes p7 p11 (by norm_num) _ _)
  have c5 : Nat.Coprime (2 ^ a * 3 ^ b * 5 ^ c * 7 ^ d * 11 ^ e) (13 ^ f) :=
    Nat.Coprime.mul_left (Nat.Coprime.mul_left (Nat.Coprime.mul_left (Nat.Coprime.mul
      (coprime_pow_pow_of_primes p2 p13 (by norm_num) _ _)
      (coprime_pow_pow_of_primes p3 p13 (by norm_num) _ _))
      (coprime_pow_pow_of_primes p5 p13 (by norm_num) _ _))
      (coprime_pow_pow_of_primes p7 p13 (by norm_num) _ _))
      (coprime_pow_pow_of_primes p11 p13 (by norm_num) _ _)
  rw [Nat.totient_mul c5, Nat.totient_mul c4, Nat.totient_mul c3, Nat.totient_mul c2,
    Nat.totient_mul c1, totient_pow_eq_pp _ p2, totient_pow_eq_pp _ p3, totient_pow_eq_pp _ p5,
    totient_pow_eq_pp _ p7, totient_pow_eq_pp _ p11, totient_pow_eq_pp _ p13]

theorem coprime_smooth (P : ℕ) (hP : P.Prime) (h17 : 17 ≤ P) (a b c d e f : ℕ) :
    Nat.Coprime P (2 ^ a * 3 ^ b * 5 ^ c * 7 ^ d * 11 ^ e * 13 ^ f) := by
  have key : ∀ q : ℕ, q.Prime → q < 17 → ∀ m : ℕ, Nat.Coprime P (q ^ m) := fun q hq hlt m =>
    Nat.Coprime.pow_right m ((Nat.coprime_primes hP hq).mpr (by omega))
  refine Nat.Coprime.mul_right (Nat.Coprime.mul_right (Nat.Coprime.mul_right
    (Nat.Coprime.mul_right (Nat.Coprime.mul_right ?_ ?_) ?_) ?_) ?_) ?_
  · exact key 2 (by norm_num) (by norm_num) a
  · exact key 3 (by norm_num) (by norm_num) b
  · exact key 5 (by norm_num) (by norm_num) c
  · exact key 7 (by norm_num) (by norm_num) d
  · exact key 11 (by norm_num) (by norm_num) e
  · exact key 13 (by norm_num) (by norm_num) f

/-! ## Bool helpers -/

theorem ble_false {a b : ℕ} (h : Nat.ble a b = false) : b < a := by
  have e := @Nat.ble_eq a b
  rw [h] at e
  have : ¬ a ≤ b := by rw [← e]; exact Bool.false_ne_true
  omega

theorem beq_false {a b : ℕ} (h : Nat.beq a b = false) : a ≠ b := Nat.ne_of_beq_eq_false h

/-! ## Smooth table (data supplied separately) -/

/-- Table access with raw operations (kernel friendly). The table is a function from block
index to a block of `5120` entries; entry `i` occupies bits `[64 j, 64 j + 64)` of block `i / 5120`
where `j = i % 5120`: `s` (21 bits) | `φ s` (21 bits) | exponents `a(5) b(4) c(4) d(3) e(3) f(3)`. -/
def tabEntry (T : ℕ → ℕ) (i : ℕ) : ℕ :=
  Nat.land (Nat.shiftRight (T (Nat.div i 5120)) (Nat.mul 64 (Nat.mod i 5120))) 18446744073709551615
def tabS (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (tabEntry T i) 2097151
def tabPhi (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (Nat.shiftRight (tabEntry T i) 21) 2097151
def tabE (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.shiftRight (tabEntry T i) 42
def exA (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (tabE T i) 31
def exB (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (Nat.shiftRight (tabE T i) 5) 15
def exC (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (Nat.shiftRight (tabE T i) 9) 15
def exD (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (Nat.shiftRight (tabE T i) 13) 7
def exE (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (Nat.shiftRight (tabE T i) 16) 7
def exF (T : ℕ → ℕ) (i : ℕ) : ℕ := Nat.land (Nat.shiftRight (tabE T i) 19) 7

def smoothOf (T : ℕ → ℕ) (i : ℕ) : ℕ :=
  Nat.mul (Nat.mul (Nat.mul (Nat.mul (Nat.mul (Nat.pow 2 (exA T i)) (Nat.pow 3 (exB T i)))
    (Nat.pow 5 (exC T i))) (Nat.pow 7 (exD T i))) (Nat.pow 11 (exE T i))) (Nat.pow 13 (exF T i))

/-- Raw version of `pp`. -/
def ppR (p e : ℕ) : ℕ := cond (Nat.beq e 0) 1 (Nat.mul (Nat.pow p (Nat.sub e 1)) (Nat.sub p 1))

theorem ppR_eq (p e : ℕ) : ppR p e = pp p e := by
  unfold ppR pp
  cases h : Nat.beq e 0 with
  | true => have : e = 0 := by simpa [Nat.beq_eq] using h
            subst this; simp
  | false => have : e ≠ 0 := beq_false h
             simp [this]

def ppOf (T : ℕ → ℕ) (i : ℕ) : ℕ :=
  Nat.mul (Nat.mul (Nat.mul (Nat.mul (Nat.mul (ppR 2 (exA T i)) (ppR 3 (exB T i)))
    (ppR 5 (exC T i))) (ppR 7 (exD T i))) (ppR 11 (exE T i))) (ppR 13 (exF T i))

def tabCheckOne (T : ℕ → ℕ) (i : ℕ) : Bool :=
  Nat.beq (tabS T i) (smoothOf T i) && Nat.beq (tabPhi T i) (ppOf T i)

/-- Check entries `0, ..., n-1` (accumulator forced at each step). -/
def tabLoop (T : ℕ → ℕ) (n : ℕ) : Bool → Bool :=
  Nat.rec (motive := fun _ => Bool → Bool) (fun acc => acc)
    (fun i ih acc => cond acc (ih (tabCheckOne T i)) false) n

theorem tabLoop_spec (T : ℕ → ℕ) (n : ℕ) : ∀ acc, tabLoop T n acc = true →
    acc = true ∧ ∀ i < n, tabCheckOne T i = true := by
  induction n with
  | zero => intro acc h; exact ⟨h, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  | succ n ih =>
    intro acc h
    change cond acc (tabLoop T n (tabCheckOne T n)) false = true at h
    cases hacc : acc with
    | false => rw [hacc] at h; exact Bool.noConfusion h
    | true =>
      rw [hacc] at h
      simp only [cond_true] at h
      obtain ⟨h1, h2⟩ := ih _ h
      refine ⟨rfl, fun i hi => ?_⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
      · exact h2 i hi
      · exact h1

/-- Correctness property of a table `T` with `n` entries. -/
def TabProp (T : ℕ → ℕ) (n : ℕ) : Prop := ∀ i < n, tabS T i = smoothOf T i ∧ tabPhi T i = ppOf T i

theorem tabProp_of_loop {T : ℕ → ℕ} {n : ℕ} (h : tabLoop T n true = true) : TabProp T n := by
  intro i hi
  have := (tabLoop_spec T n true h).2 i hi
  unfold tabCheckOne at this
  simp only [Bool.and_eq_true, Nat.beq_eq] at this
  exact this

theorem smoothOf_eq (T : ℕ → ℕ) (i : ℕ) : smoothOf T i =
    2 ^ exA T i * 3 ^ exB T i * 5 ^ exC T i * 7 ^ exD T i * 11 ^ exE T i * 13 ^ exF T i := rfl

theorem ppOf_eq (T : ℕ → ℕ) (i : ℕ) : ppOf T i =
    pp 2 (exA T i) * pp 3 (exB T i) * pp 5 (exC T i) * pp 7 (exD T i) * pp 11 (exE T i) *
      pp 13 (exF T i) := by
  unfold ppOf
  simp only [ppR_eq]
  rfl

theorem tab_phi {T : ℕ → ℕ} {n : ℕ} (hT : TabProp T n) {i : ℕ} (hi : i < n) : φ (tabS T i) = tabPhi T i := by
  obtain ⟨h1, h2⟩ := hT i hi
  rw [h1, h2, smoothOf_eq, ppOf_eq, phi6]

theorem tab_coprime {T : ℕ → ℕ} {n : ℕ} (hT : TabProp T n) {i : ℕ} (hi : i < n) (P : ℕ) (hP : P.Prime)
    (h17 : 17 ≤ P) : Nat.Coprime P (tabS T i) := by
  rw [(hT i hi).1, smoothOf_eq]
  exact coprime_smooth P hP h17 _ _ _ _ _ _

/-! ## Primality test: small sieve for `p ≤ 1414`, factorial gcd otherwise -/

/-- `bitClear m p = true` iff bit `p` of `m` is clear. -/
def bitClear (m p : ℕ) : Bool := Nat.beq (Nat.land 1 (Nat.shiftRight m p)) 0

theorem bitClear_eq (m p : ℕ) : bitClear m p = !(m.testBit p) := by
  unfold bitClear Nat.testBit
  have e : Nat.land 1 (Nat.shiftRight m p) = 1 &&& (m >>> p) := rfl
  rw [e]
  rcases Nat.one_and_eq_mod_two (m >>> p) ▸ Nat.mod_two_eq_zero_or_one (m >>> p) with h | h
  · rw [h]; rfl
  · rw [h]; rfl

/-- Primality test; valid for `2 ≤ p ≤ N`. -/
def isPrimeB (p : ℕ) : Bool :=
  cond (Nat.ble p 1414) (bitClear smallSieve p) (Nat.beq (Nat.gcd p PRIM) 1)

theorem prime_of_isPrimeB {p : ℕ} (h2 : 2 ≤ p) (hN : p ≤ N) (h : isPrimeB p = true) : p.Prime := by
  unfold isPrimeB at h
  cases h1 : Nat.ble p 1414 with
  | true =>
    rw [h1, cond_true, bitClear_eq, Bool.not_eq_true'] at h
    exact smallSieve_prime p h2 (Nat.le_of_ble_eq_true h1) h
  | false =>
    rw [h1, cond_false] at h
    exact prime_of_gcd p (ble_false h1) hN (Nat.eq_of_beq_eq_true h)

/-! ## Certificate for the totient of one number -/

/-- Returns the claimed value of `φ x`, or `0` if the certificate is invalid.
`x = s * rest` where `s = tabS T i`; `rest = 1`, or `rest` prime (when `P = 0`), or
`rest = P * Q` with `P < Q` primes. Requires `x ≤ N` for soundness. -/
def certNum (T : ℕ → ℕ) (n x i P : ℕ) : ℕ :=
  cond (Nat.ble n i) 0 <|
  let s := tabS T i
  let rest := Nat.div x s
  cond (Nat.beq x (Nat.mul s rest))
    (cond (Nat.beq rest 1) (tabPhi T i) <|
     cond (Nat.beq P 0)
       (cond (Nat.ble 17 rest)
         (cond (isPrimeB rest) (Nat.mul (tabPhi T i) (Nat.sub rest 1)) 0) 0) <|
     let Q := Nat.div rest P
     cond (Nat.beq rest (Nat.mul P Q))
       (cond (Nat.ble 17 P)
         (cond (Nat.ble (Nat.succ P) Q)
           (cond (isPrimeB P)
             (cond (isPrimeB Q) (Nat.mul (Nat.mul (tabPhi T i) (Nat.sub P 1)) (Nat.sub Q 1)) 0)
             0) 0) 0) 0)
    0

theorem cond_eq_pos {α : Sort _} {c : Bool} {a b y : α} (h : cond c a b = y) (hb : b ≠ y) :
    c = true ∧ a = y := by
  cases c with
  | false => exact absurd h hb
  | true => exact ⟨rfl, h⟩

theorem certNum_correct {T : ℕ → ℕ} {n : ℕ} (hT : TabProp T n) (x i P y : ℕ) (hxN : x ≤ N)
    (h : certNum T n x i P = y) (hy : 0 < y) : φ x = y := by
  have hy0 : (0 : ℕ) ≠ y := by omega
  unfold certNum at h
  -- i < n
  cases hni : Nat.ble n i with
  | true => rw [hni] at h; simp at h; omega
  | false =>
  rw [hni] at h; simp only [cond_false] at h
  have hi : i < n := ble_false hni
  set s := tabS T i with hs
  set rest := Nat.div x s with hrest
  have hphis : φ s = tabPhi T i := tab_phi hT hi
  obtain ⟨hx, h⟩ := cond_eq_pos h hy0
  have hxeq : x = s * rest := by simpa [Nat.beq_eq] using hx
  have hrestN : rest ≤ N := by
    have : rest ≤ x := Nat.div_le_self x s
    omega
  cases hr1 : Nat.beq rest 1 with
  | true =>
    rw [hr1] at h; simp only [cond_true] at h
    have : rest = 1 := by simpa [Nat.beq_eq] using hr1
    rw [hxeq, this, mul_one, hphis, h]
  | false =>
  rw [hr1] at h; simp only [cond_false] at h
  cases hP0 : Nat.beq P 0 with
  | true =>
    rw [hP0] at h; simp only [cond_true] at h
    obtain ⟨h17, h⟩ := cond_eq_pos h hy0
    obtain ⟨hpr, h⟩ := cond_eq_pos h hy0
    have h17' : 17 ≤ rest := Nat.le_of_ble_eq_true h17
    have hp : rest.Prime := prime_of_isPrimeB (by omega) hrestN hpr
    rw [hxeq, Nat.totient_mul (tab_coprime hT hi rest hp h17').symm, hphis, Nat.totient_prime hp]
    exact h
  | false =>
    rw [hP0] at h; simp only [cond_false] at h
    set Q := Nat.div rest P with hQ
    obtain ⟨hrPQ, h⟩ := cond_eq_pos h hy0
    obtain ⟨h17, h⟩ := cond_eq_pos h hy0
    obtain ⟨hPQ, h⟩ := cond_eq_pos h hy0
    obtain ⟨hPp, h⟩ := cond_eq_pos h hy0
    obtain ⟨hQp, h⟩ := cond_eq_pos h hy0
    have hrPQ' : rest = P * Q := by simpa [Nat.beq_eq] using hrPQ
    have h17' : 17 ≤ P := Nat.le_of_ble_eq_true h17
    have hPQ' : P < Q := Nat.le_of_ble_eq_true hPQ
    have hQN : Q ≤ N := by
      have : Q ≤ rest := Nat.div_le_self rest P
      omega
    have hP : P.Prime := prime_of_isPrimeB (by omega) (by omega) hPp
    have hQ' : Q.Prime := prime_of_isPrimeB (by omega) hQN hQp
    have hcPQ : Nat.Coprime P Q := (Nat.coprime_primes hP hQ').mpr (by omega)
    have h17Q : 17 ≤ Q := by omega
    rw [hxeq, hrPQ', Nat.totient_mul, hphis, Nat.totient_mul hcPQ, Nat.totient_prime hP,
      Nat.totient_prime hQ', ← mul_assoc]
    · exact h
    exact Nat.Coprime.mul_right (tab_coprime hT hi P hP h17').symm
      (tab_coprime hT hi Q hQ' h17Q).symm

/-! ## Certificate for one `n` -/

def certEntry (T : ℕ → ℕ) (tn n k r i1 P1 i2 P2 : ℕ) : Bool :=
  cond (Nat.ble n N)
    (cond (Nat.ble 1 k)
      (cond (Nat.ble (Nat.succ (Nat.mul 2 k)) n)
        (let y1 := certNum T tn k i1 P1
         cond (Nat.beq y1 0) false
           (let y2 := certNum T tn (Nat.sub n k) i2 P2
            cond (Nat.beq y2 0) false (Nat.beq (Nat.mul y1 y2) (Nat.mul r r))))
        false) false) false

theorem certEntry_correct {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (n k r i1 P1 i2 P2 : ℕ)
    (h : certEntry T tn n k r i1 P1 i2 P2 = true) : 0 < a n := by
  unfold certEntry at h
  have hft : false ≠ true := Bool.false_ne_true
  obtain ⟨hnN, h⟩ := cond_eq_pos h hft
  obtain ⟨hk, h⟩ := cond_eq_pos h hft
  obtain ⟨hkn, h⟩ := cond_eq_pos h hft
  simp only at h
  cases hy1 : Nat.beq (certNum T tn k i1 P1) 0 with
  | true => rw [hy1] at h; exact absurd h hft
  | false =>
  rw [hy1] at h; simp only [cond_false] at h
  cases hy2 : Nat.beq (certNum T tn (Nat.sub n k) i2 P2) 0 with
  | true => rw [hy2] at h; exact absurd h hft
  | false =>
  rw [hy2] at h; simp only [cond_false] at h
  have hnN' : n ≤ N := Nat.le_of_ble_eq_true hnN
  have hk' : 1 ≤ k := Nat.le_of_ble_eq_true hk
  have hkn' : 2 * k < n := Nat.le_of_ble_eq_true hkn
  have e1 := certNum_correct hT k i1 P1 _ (by omega) rfl (Nat.pos_of_ne_zero (beq_false hy1))
  have e2 := certNum_correct hT (Nat.sub n k) i2 P2 _ (by show n - k ≤ N; omega) rfl
    (Nat.pos_of_ne_zero (beq_false hy2))
  have hsq : certNum T tn k i1 P1 * certNum T tn (Nat.sub n k) i2 P2 = r * r := by
    simpa [Nat.beq_eq] using h
  exact a_pos_of_witness n k r hk' hkn' (by rw [show n - k = Nat.sub n k from rfl, e1, e2]; exact hsq)

end Aux


open Nat Finset

namespace Aux

/-! ## Integer square root (any function works; correctness is checked separately) -/

def isqrtN : ℕ → ℕ → ℕ → ℕ
  | 0, _, g => g
  | fuel + 1, x, g =>
    let g' := (g + x / g) / 2
    if g' < g then isqrtN fuel x g' else g

def isqrt (x : ℕ) : ℕ := if x ≤ 1 then x else isqrtN 200 x x

/-! ## Structural families -/

/-- Divisors of `u` as a list (kernel friendly). -/
def divs (u : ℕ) : List ℕ := (List.range (u + 1)).filter (fun g => g != 0 && u % g == 0)

theorem mem_divs {u g : ℕ} (hu : 0 < u) (hg : g ∣ u) : g ∈ divs u := by
  unfold divs
  rw [List.mem_filter, List.mem_range]
  have hgpos : 0 < g := Nat.pos_of_dvd_of_pos hg hu
  refine ⟨by have := Nat.le_of_dvd hu hg; omega, ?_⟩
  simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq]
  exact ⟨by omega, Nat.mod_eq_zero_of_dvd hg⟩

/-- The decidable hypothesis of a family `(u, v, Q)`. -/
def FamProp (u v : ℕ) (Q : List ℕ) : Prop :=
  ∀ g1 ∈ divs u, ∀ g2 ∈ divs v,
    Nat.gcd g1 v = Nat.gcd g2 u →
    (∀ q ∈ Q, g1 % q ≠ 0) → (∀ q ∈ Q, g2 % q ≠ 0) →
    φ u * φ v * g1 * g2 = φ g1 * φ g2 * (isqrt (φ u * φ v * g1 * g2 / (φ g1 * φ g2))) ^ 2

instance (u v : ℕ) (Q : List ℕ) : Decidable (FamProp u v Q) := by
  unfold FamProp; infer_instance

theorem fam_square (u v m g1 g2 c : ℕ) (hm : 0 < m) (hg1 : Nat.gcd u m = g1)
    (hg2 : Nat.gcd v m = g2) (hc : φ u * φ v * g1 * g2 = φ g1 * φ g2 * c ^ 2) :
    φ (u * m) * φ (v * m) = (φ m * c) * (φ m * c) := by
  have h1 := Nat.totient_gcd_mul_totient_mul u m
  have h2 := Nat.totient_gcd_mul_totient_mul v m
  rw [hg1] at h1
  rw [hg2] at h2
  have hg1pos : 0 < g1 := hg1 ▸ Nat.gcd_pos_of_pos_right _ hm
  have hg2pos : 0 < g2 := hg2 ▸ Nat.gcd_pos_of_pos_right _ hm
  have hpos : 0 < φ g1 * φ g2 :=
    Nat.mul_pos (Nat.totient_pos.mpr hg1pos) (Nat.totient_pos.mpr hg2pos)
  have key : φ g1 * φ g2 * (φ (u * m) * φ (v * m)) =
      φ g1 * φ g2 * ((φ m * c) * (φ m * c)) := by
    calc φ g1 * φ g2 * (φ (u * m) * φ (v * m))
        = (φ g1 * φ (u * m)) * (φ g2 * φ (v * m)) := by ring
      _ = (φ u * φ m * g1) * (φ v * φ m * g2) := by rw [h1, h2]
      _ = (φ u * φ v * g1 * g2) * (φ m * φ m) := by ring
      _ = (φ g1 * φ g2 * c ^ 2) * (φ m * φ m) := by rw [hc]
      _ = φ g1 * φ g2 * ((φ m * c) * (φ m * c)) := by ring
  exact Nat.eq_of_mul_eq_mul_left hpos key

theorem fam_covers (u v : ℕ) (Q : List ℕ) (hu : 0 < u) (huv : u < v) (H : FamProp u v Q)
    (m : ℕ) (hm : 0 < m) (hQ : ∀ q ∈ Q, ¬ q ∣ m) : 0 < a ((u + v) * m) := by
  have hv : 0 < v := by omega
  set g1 := Nat.gcd u m with hg1
  set g2 := Nat.gcd v m with hg2
  have hg1u : g1 ∣ u := Nat.gcd_dvd_left _ _
  have hg2v : g2 ∣ v := Nat.gcd_dvd_left _ _
  have hg1m : g1 ∣ m := Nat.gcd_dvd_right _ _
  have hg2m : g2 ∣ m := Nat.gcd_dvd_right _ _
  have hgg : Nat.gcd g1 v = Nat.gcd g2 u := by
    rw [hg1, hg2, Nat.gcd_comm v m, Nat.gcd_assoc, Nat.gcd_assoc, Nat.gcd_comm m v]
    rw [Nat.gcd_comm u (Nat.gcd v m), Nat.gcd_comm v m, Nat.gcd_assoc]
  have hQ1 : ∀ q ∈ Q, g1 % q ≠ 0 := fun q hq h =>
    hQ q hq (dvd_trans (Nat.dvd_of_mod_eq_zero h) hg1m)
  have hQ2 : ∀ q ∈ Q, g2 % q ≠ 0 := fun q hq h =>
    hQ q hq (dvd_trans (Nat.dvd_of_mod_eq_zero h) hg2m)
  have hc := H g1 (mem_divs hu hg1u) g2 (mem_divs hv hg2v) hgg hQ1 hQ2
  have hsq := fam_square u v m g1 g2 _ hm rfl rfl hc
  apply a_pos_of_witness ((u + v) * m) (u * m) (φ m * isqrt (φ u * φ v * g1 * g2 / (φ g1 * φ g2)))
  · nlinarith
  · nlinarith
  · have e : (u + v) * m - u * m = v * m := by
      rw [Nat.add_mul, Nat.add_sub_cancel_left]
    rw [e, hsq]

/-! ## Bitmask of a family -/

def famMask (u v : ℕ) (Q : List ℕ) : ℕ :=
  let s := u + v
  geo s (qOf s) &&&
    ((Q.foldr (fun q acc => geo (s * q) (qOf (s * q)) ||| acc) 0) ^^^ (2 ^ (N + 1) - 1))

theorem famMask_testBit (u v : ℕ) (Q : List ℕ) (hu : 0 < u) (hQpos : ∀ q ∈ Q, 0 < q)
    (n : ℕ) (hn : n ≤ N) (h : (famMask u v Q).testBit n = true) :
    (u + v) ∣ n ∧ ∀ q ∈ Q, ¬ q ∣ n / (u + v) := by
  unfold famMask at h
  simp only [Nat.testBit_land, Nat.testBit_xor, Nat.testBit_two_pow_sub_one, Bool.and_eq_true,
    geo_testBit (u + v) (by omega), decide_eq_true_eq] at h
  obtain ⟨⟨hdvd, -⟩, hx⟩ := h
  have hnN : n < N + 1 := by omega
  simp only [hnN, decide_true, Bool.xor_true, Bool.not_eq_true'] at hx
  refine ⟨hdvd, fun q hq hqd => ?_⟩
  have hs : 0 < u + v := by omega
  have hq0 := hQpos q hq
  have hsq : (u + v) * q ∣ n := by
    have : n = (u + v) * (n / (u + v)) := (Nat.mul_div_cancel' hdvd).symm
    rw [this]
    exact Nat.mul_dvd_mul_left _ hqd
  have hbit : (geo ((u + v) * q) (qOf ((u + v) * q))).testBit n = true := by
    rw [geo_testBit _ (Nat.mul_pos hs hq0), decide_eq_true_eq]
    exact ⟨hsq, lt_of_le_of_lt hn (lt_mul_qOf _ (Nat.mul_pos hs hq0))⟩
  have := foldr_lor_testBit Q (fun q => geo ((u + v) * q) (qOf ((u + v) * q))) n q hq hbit
  rw [this] at hx
  exact Bool.noConfusion hx

/-- Property of a family list. -/
def FamOK (f : ℕ × ℕ × List ℕ) : Prop :=
  0 < f.1 ∧ f.1 < f.2.1 ∧ (∀ q ∈ f.2.2, 0 < q) ∧ FamProp f.1 f.2.1 f.2.2

instance (f : ℕ × ℕ × List ℕ) : Decidable (FamOK f) := by
  unfold FamOK; infer_instance

def famUnion (l : List (ℕ × ℕ × List ℕ)) : ℕ :=
  l.foldr (fun f acc => famMask f.1 f.2.1 f.2.2 ||| acc) 0

theorem famUnion_correct (l : List (ℕ × ℕ × List ℕ)) (H : ∀ f ∈ l, FamOK f)
    (n : ℕ) (hn9 : 9 ≤ n) (hn : n ≤ N) (h : (famUnion l).testBit n = true) : 0 < a n := by
  induction l with
  | nil => simp [famUnion] at h
  | cons f l ih =>
    simp only [famUnion, List.foldr_cons, Nat.testBit_lor, Bool.or_eq_true] at h
    rcases h with h | h
    · obtain ⟨hu, huv, hQ, hF⟩ := H f (List.mem_cons_self ..)
      obtain ⟨hdvd, hQn⟩ := famMask_testBit f.1 f.2.1 f.2.2 hu hQ n hn h
      have hm : 0 < n / (f.1 + f.2.1) := Nat.div_pos (Nat.le_of_dvd (by omega) hdvd) (by omega)
      have := fam_covers f.1 f.2.1 f.2.2 hu huv hF _ hm hQn
      rwa [Nat.mul_div_cancel' hdvd] at this
    · exact ih (fun g hg => H g (List.mem_cons_of_mem _ hg)) h

end Aux


open Nat Finset

namespace Aux

/-! ## The fold over hard certificates

Entry layout (116 bits, from LSB): gap 9 | k 18 | r 21 | i1 13 | P1 21 | i2 13 | P2 21.
A chunk is `count (8 bits) | entries...`.  Within a chunk we accumulate bits relative to the
value `p0` of `n` at the start of the chunk. -/

/-- Process one entry `e` given previous `n` value `p` and the chunk base `p0`;
returns `(B', n)`. -/
def hardStepB (T : ℕ → ℕ) (tn p0 B p e : ℕ) : ℕ × ℕ :=
  let n := Nat.add p (Nat.land e 511)
  let k := Nat.land (Nat.shiftRight e 9) 262143
  let r := Nat.land (Nat.shiftRight e 27) 2097151
  let i1 := Nat.land (Nat.shiftRight e 48) 8191
  let P1 := Nat.land (Nat.shiftRight e 61) 2097151
  let i2 := Nat.land (Nat.shiftRight e 82) 8191
  let P2 := Nat.shiftRight e 95
  (cond (certEntry T tn n k r i1 P1 i2 P2) (Nat.lor B (Nat.shiftLeft 1 (Nat.sub n p0))) B, n)

/-- Process `fuel` entries from chunk body `c`. -/
def chunkLoop (T : ℕ → ℕ) (tn p0 : ℕ) (fuel : ℕ) : ℕ → ℕ → ℕ → ℕ × ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ → ℕ → ℕ × ℕ) (fun _ B p => (B, p))
    (fun _ ih c B p =>
      let e := Nat.land c 83076749736557242056487941267521535
      let s := hardStepB T tn p0 B p e
      cond (Nat.ble 0 s.1) (ih (Nat.shiftRight c 116) s.1 s.2) (0, p)) fuel

/-- Process all chunks of one group; returns `(V, p)`. -/
def hardFold1 (T : ℕ → ℕ) (tn : ℕ) (l : List ℕ) : ℕ → ℕ → ℕ × ℕ :=
  List.rec (motive := fun _ => ℕ → ℕ → ℕ × ℕ) (fun V p => (V, p))
    (fun c _ ih V p =>
      let s := chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p
      let V' := Nat.lor V (Nat.shiftLeft s.1 p)
      cond (Nat.ble 0 V') (ih V' s.2) (0, p)) l

/-- Process all groups. -/
def hardFold (T : ℕ → ℕ) (tn : ℕ) (ll : List (List ℕ)) : ℕ → ℕ → ℕ :=
  List.rec (motive := fun _ => ℕ → ℕ → ℕ) (fun V _ => V)
    (fun l _ ih V p =>
      let s := hardFold1 T tn l V p
      ih s.1 s.2) ll

/-- Invariant: every set bit is a verified `n`. -/
def Inv (V : ℕ) : Prop := ∀ i, V.testBit i = true → 0 < a i

/-- Relative invariant. -/
def InvAt (p0 B : ℕ) : Prop := ∀ j, B.testBit j = true → 0 < a (p0 + j)

theorem inv_zero : Inv 0 := fun i h => by simp at h

theorem invAt_zero (p0 : ℕ) : InvAt p0 0 := fun j h => by simp at h

theorem hardStepB_inv {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (p0 B p e : ℕ) (hp : p0 ≤ p)
    (hB : InvAt p0 B) :
    p0 ≤ (hardStepB T tn p0 B p e).2 ∧ InvAt p0 (hardStepB T tn p0 B p e).1 := by
  unfold hardStepB
  simp only
  refine ⟨?_, ?_⟩
  · show p0 ≤ Nat.add p (Nat.land e 511)
    exact le_trans hp (Nat.le_add_right _ _)
  intro j hj
  cases hc : certEntry T tn (Nat.add p (Nat.land e 511)) (Nat.land (Nat.shiftRight e 9) 262143)
      (Nat.land (Nat.shiftRight e 27) 2097151) (Nat.land (Nat.shiftRight e 48) 8191)
      (Nat.land (Nat.shiftRight e 61) 2097151) (Nat.land (Nat.shiftRight e 82) 8191)
      (Nat.shiftRight e 95) with
  | false => rw [hc] at hj; exact hB j hj
  | true =>
    rw [hc] at hj
    have e1 : Nat.lor B (Nat.shiftLeft 1 (Nat.sub (Nat.add p (Nat.land e 511)) p0)) =
        B ||| (1 <<< (p + (Nat.land e 511) - p0)) := rfl
    rw [cond_true, e1] at hj
    simp only [Nat.testBit_lor, Nat.testBit_shiftLeft, Bool.or_eq_true,
      Bool.and_eq_true, decide_eq_true_eq, Nat.testBit_one_eq_true_iff_self_eq_zero] at hj
    rcases hj with hj | ⟨hge, hz⟩
    · exact hB j hj
    · have hn : p0 + j = Nat.add p (Nat.land e 511) := by
        show p0 + j = p + Nat.land e 511
        omega
      rw [hn]
      exact certEntry_correct hT _ _ _ _ _ _ _ hc

theorem chunkLoop_inv {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (p0 : ℕ) (fuel : ℕ) :
    ∀ c B p, p0 ≤ p → InvAt p0 B →
      p0 ≤ (chunkLoop T tn p0 fuel c B p).2 ∧ InvAt p0 (chunkLoop T tn p0 fuel c B p).1 := by
  induction fuel with
  | zero => intro c B p hp hB; exact ⟨hp, hB⟩
  | succ fuel ih =>
    intro c B p hp hB
    show p0 ≤ (cond (Nat.ble 0 (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).1)
      (chunkLoop T tn p0 fuel (Nat.shiftRight c 116)
        (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).1
        (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).2) (0, p)).2 ∧
      InvAt p0 (cond (Nat.ble 0 (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).1)
      (chunkLoop T tn p0 fuel (Nat.shiftRight c 116)
        (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).1
        (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).2) (0, p)).1
    obtain ⟨h1, h2⟩ := hardStepB_inv hT p0 B p (Nat.land c 83076749736557242056487941267521535) hp hB
    cases Nat.ble 0 (hardStepB T tn p0 B p (Nat.land c 83076749736557242056487941267521535)).1 with
    | false => exact ⟨hp, invAt_zero p0⟩
    | true => exact ih _ _ _ h1 h2

theorem inv_lor_shift {V p0 B : ℕ} (hV : Inv V) (hB : InvAt p0 B) :
    Inv (Nat.lor V (Nat.shiftLeft B p0)) := by
  intro i hi
  have e : Nat.lor V (Nat.shiftLeft B p0) = V ||| (B <<< p0) := rfl
  rw [e, Nat.testBit_lor, Nat.testBit_shiftLeft, Bool.or_eq_true, Bool.and_eq_true,
    decide_eq_true_eq] at hi
  rcases hi with hi | ⟨hge, hb⟩
  · exact hV i hi
  · have := hB _ hb
    rwa [Nat.add_sub_cancel' hge] at this

theorem hardFold1_inv {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (l : List ℕ) :
    ∀ V p, Inv V → Inv (hardFold1 T tn l V p).1 := by
  induction l with
  | nil => intro V p hV; exact hV
  | cons c l ih =>
    intro V p hV
    show Inv (cond (Nat.ble 0 (Nat.lor V (Nat.shiftLeft
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).1 p)))
      (hardFold1 T tn l (Nat.lor V (Nat.shiftLeft
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).1 p))
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).2) (0, p)).1
    obtain ⟨-, h2⟩ := chunkLoop_inv hT p (Nat.land c 255) (Nat.shiftRight c 8) 0 p le_rfl
      (invAt_zero p)
    cases Nat.ble 0 (Nat.lor V (Nat.shiftLeft
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).1 p)) with
    | false => exact inv_zero
    | true => exact ih _ _ (inv_lor_shift hV h2)

theorem hardFold_inv {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (ll : List (List ℕ)) :
    ∀ V p, Inv V → Inv (hardFold T tn ll V p) := by
  induction ll with
  | nil => intro V p hV; exact hV
  | cons l ll ih =>
    intro V p hV
    show Inv (hardFold T tn ll (hardFold1 T tn l V p).1 (hardFold1 T tn l V p).2)
    exact ih _ _ (hardFold1_inv hT l V p hV)

/-! ## Final assembly -/

def rangeMask : ℕ := (2 ^ (N + 1) - 1) ^^^ (2 ^ 9 - 1)

theorem rangeMask_testBit (n : ℕ) (h9 : 9 ≤ n) (hN : n ≤ N) : rangeMask.testBit n = true := by
  unfold rangeMask
  rw [Nat.testBit_xor, Nat.testBit_two_pow_sub_one, Nat.testBit_two_pow_sub_one]
  have h1 : n < N + 1 := by omega
  have h2 : ¬ n < 9 := by omega
  simp [h1, h2]

/-- The final theorem, parametrized by the data and the three verified facts. -/
theorem main_of_data (T : ℕ → ℕ) (tn : ℕ) (hT : TabProp T tn) (fl : List (ℕ × ℕ × List ℕ))
    (hfl : ∀ f ∈ fl, FamOK f) (hd : List (List ℕ))
    (hcheck : Nat.beq (Nat.land rangeMask (Nat.lor (famUnion fl) (hardFold T tn hd 0 0)))
      rangeMask = true)
    (n : ℕ) (h9 : 9 ≤ n) (hN : n ≤ N) : 0 < a n := by
  have heq := Nat.eq_of_beq_eq_true hcheck
  have h1 := rangeMask_testBit n h9 hN
  have h2 : (Nat.land rangeMask (Nat.lor (famUnion fl) (hardFold T tn hd 0 0))).testBit n = true := by
    rw [heq]; exact h1
  have e : Nat.land rangeMask (Nat.lor (famUnion fl) (hardFold T tn hd 0 0)) =
    rangeMask &&& (famUnion fl ||| hardFold T tn hd 0 0) := rfl
  rw [e, Nat.testBit_land, Nat.testBit_lor, h1, Bool.true_and, Bool.or_eq_true] at h2
  rcases h2 with h2 | h2
  · exact famUnion_correct fl hfl n h9 hN h2
  · exact hardFold_inv hT hd 0 0 inv_zero n h2

end Aux


open Nat Finset

namespace Aux

/-! ## Per-group folds (relative to the group base `p0`) -/

/-- Process all chunks of one group, accumulating bits relative to `p0`; returns `(B, p)`. -/
def hardFold1R (T : ℕ → ℕ) (tn : ℕ) (l : List ℕ) (p0 : ℕ) : ℕ → ℕ → ℕ × ℕ :=
  List.rec (motive := fun _ => ℕ → ℕ → ℕ × ℕ) (fun V p => (V, p))
    (fun c _ ih V p =>
      let s := chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p
      let V' := Nat.lor V (Nat.shiftLeft s.1 (Nat.sub p p0))
      cond (Nat.ble 0 V') (ih V' s.2) (0, p)) l

/-- Check one group against its claimed result. -/
def chkGroup (T : ℕ → ℕ) (tn : ℕ) (l : List ℕ) (p0 B p1 : ℕ) : Bool :=
  let s := hardFold1R T tn l p0 0 p0
  and (Nat.beq s.1 B) (Nat.beq s.2 p1)

theorem invAt_lor_shift {p0 V p B : ℕ} (hp : p0 ≤ p) (hV : InvAt p0 V) (hB : InvAt p B) :
    InvAt p0 (Nat.lor V (Nat.shiftLeft B (Nat.sub p p0))) := by
  intro j hj
  have e : Nat.lor V (Nat.shiftLeft B (Nat.sub p p0)) = V ||| (B <<< (p - p0)) := rfl
  rw [e, Nat.testBit_lor, Nat.testBit_shiftLeft, Bool.or_eq_true, Bool.and_eq_true,
    decide_eq_true_eq] at hj
  rcases hj with hj | ⟨hge, hb⟩
  · exact hV j hj
  · have := hB _ hb
    have e2 : p + (j - (p - p0)) = p0 + j := by omega
    rwa [e2] at this

theorem hardFold1R_inv {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (l : List ℕ) (p0 : ℕ) :
    ∀ V p, p0 ≤ p → InvAt p0 V → InvAt p0 (hardFold1R T tn l p0 V p).1 := by
  induction l with
  | nil => intro V p _ hV; exact hV
  | cons c l ih =>
    intro V p hp hV
    show InvAt p0 (cond (Nat.ble 0 (Nat.lor V (Nat.shiftLeft
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).1 (Nat.sub p p0))))
      (hardFold1R T tn l p0 (Nat.lor V (Nat.shiftLeft
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).1 (Nat.sub p p0)))
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).2) (0, p)).1
    obtain ⟨h1, h2⟩ := chunkLoop_inv hT p (Nat.land c 255) (Nat.shiftRight c 8) 0 p le_rfl
      (invAt_zero p)
    cases Nat.ble 0 (Nat.lor V (Nat.shiftLeft
        (chunkLoop T tn p (Nat.land c 255) (Nat.shiftRight c 8) 0 p).1 (Nat.sub p p0))) with
    | false => exact invAt_zero p0
    | true => exact ih _ _ (le_trans hp h1) (invAt_lor_shift hp hV h2)

theorem invAt_of_chkGroup {T : ℕ → ℕ} {tn : ℕ} (hT : TabProp T tn) (l : List ℕ) (p0 B p1 : ℕ)
    (h : chkGroup T tn l p0 B p1 = true) : InvAt p0 B := by
  unfold chkGroup at h
  simp only at h
  rw [Bool.and_eq_true] at h
  have hB := Nat.eq_of_beq_eq_true h.1
  rw [← hB]
  exact hardFold1R_inv hT l p0 0 p0 le_rfl (invAt_zero p0)

/-- Combine the group results. -/
def combine : List (ℕ × ℕ) → ℕ
  | [] => 0
  | (p, B) :: t => Nat.lor (combine t) (Nat.shiftLeft B p)

theorem combine_inv (gl : List (ℕ × ℕ)) (h : ∀ x ∈ gl, InvAt x.1 x.2) : Inv (combine gl) := by
  induction gl with
  | nil => exact inv_zero
  | cons x t ih =>
    obtain ⟨p, B⟩ := x
    show Inv (Nat.lor (combine t) (Nat.shiftLeft B p))
    exact inv_lor_shift (ih fun y hy => h y (List.mem_cons_of_mem _ hy))
      (h (p, B) (List.mem_cons_self ..))

/-- The final theorem, parametrized by the data and the verified facts. -/
theorem main_of_groups (fl : List (ℕ × ℕ × List ℕ))
    (hfl : ∀ f ∈ fl, FamOK f) (gl : List (ℕ × ℕ)) (hgl : ∀ x ∈ gl, InvAt x.1 x.2)
    (hcheck : Nat.beq (Nat.land rangeMask (Nat.lor (famUnion fl) (combine gl)))
      rangeMask = true)
    (n : ℕ) (h9 : 9 ≤ n) (hN : n ≤ N) : 0 < a n := by
  have heq := Nat.eq_of_beq_eq_true hcheck
  have h1 := rangeMask_testBit n h9 hN
  have h2 : (Nat.land rangeMask (Nat.lor (famUnion fl) (combine gl))).testBit n = true := by
    rw [heq]; exact h1
  have e : Nat.land rangeMask (Nat.lor (famUnion fl) (combine gl)) =
    rangeMask &&& (famUnion fl ||| combine gl) := rfl
  rw [e, Nat.testBit_land, Nat.testBit_lor, h1, Bool.true_and, Bool.or_eq_true] at h2
  rcases h2 with h2 | h2
  · exact famUnion_correct fl hfl n h9 hN h2
  · exact combine_inv gl hgl n h2

end Aux


