/-! ## Geometric bit masks -/

/-- Specification: `Σ_{j<q} 2^{j d}`. -/
def geoR (d : ℕ) : ℕ → ℕ
  | 0 => 0
  | q + 1 => 2 ^ d * geoR d q + 1

theorem geoR_testBit (d : ℕ) (hd : 0 < d) (q i : ℕ) :
    (geoR d q).testBit i = decide (d ∣ i ∧ i < d * q) := by
  induction q generalizing i with
  | zero => simp [geoR]
  | succ q ih =>
    have h1 : 1 < 2 ^ d := Nat.one_lt_two_pow (by omega)
    rw [geoR, Nat.testBit_two_pow_mul_add _ h1]
    split_ifs with h
    · -- i < d
      rw [Bool.eq_iff_iff, Nat.testBit_one_eq_true_iff_self_eq_zero, decide_eq_true_iff]
      constructor
      · rintro rfl; exact ⟨dvd_zero _, by nlinarith⟩
      · rintro ⟨hdi, -⟩; exact Nat.eq_zero_of_dvd_of_lt hdi h
    · push_neg at h
      rw [ih, Bool.eq_iff_iff, decide_eq_true_iff, decide_eq_true_iff]
      have e : i = (i - d) + d := by omega
      constructor
      · rintro ⟨hdi, hlt⟩
        refine ⟨?_, ?_⟩
        · rw [e]; exact (Nat.dvd_add_right hdi).mpr dvd_rfl
        · rw [Nat.mul_succ]; omega
      · rintro ⟨hdi, hlt⟩
        refine ⟨?_, ?_⟩
        · rw [e] at hdi; exact (Nat.dvd_add_right (dvd_refl d)).mp (by simpa [add_comm] using hdi)
        · rw [Nat.mul_succ] at hlt; omega

theorem geoR_mul (d q : ℕ) : (2 ^ d - 1) * geoR d q = 2 ^ (d * q) - 1 := by
  induction q with
  | zero => simp [geoR]
  | succ q ih =>
    have h1 : 1 ≤ 2 ^ d := Nat.one_le_two_pow
    have h2 : 1 ≤ 2 ^ (d * q) := Nat.one_le_two_pow
    have e : 2 ^ (d * (q + 1)) = 2 ^ (d * q) * 2 ^ d := by rw [Nat.mul_succ, pow_add]
    rw [geoR, e]
    have h3 : 1 ≤ 2 ^ (d * q) * 2 ^ d := Nat.one_le_iff_ne_zero.mpr (by positivity)
    zify [h1, h2, h3] at ih ⊢
    push_cast
    linear_combination (2:ℤ) ^ d * ih

/-- Kernel-friendly geometric mask. -/
def geo (d q : ℕ) : ℕ := (2 ^ (d * q) - 1) / (2 ^ d - 1)

theorem geo_eq (d : ℕ) (hd : 0 < d) (q : ℕ) : geo d q = geoR d q := by
  unfold geo
  rw [← geoR_mul]
  have h : 0 < 2 ^ d - 1 := by
    have := Nat.one_lt_two_pow (n := d) (by omega); omega
  rw [Nat.mul_div_cancel_left _ h]

theorem geo_testBit (d : ℕ) (hd : 0 < d) (q i : ℕ) :
    (geo d q).testBit i = decide (d ∣ i ∧ i < d * q) := by
  rw [geo_eq d hd, geoR_testBit d hd]

/-! ## Small sieve and factorial-based primality test -/

/-- The bound. -/
def N : ℕ := 2000000

/-- Number of periods so that `d * qOfM M d > M`. -/
def qOfM (M d : ℕ) : ℕ := M / d + 1

theorem lt_mul_qOfM (M d : ℕ) (hd : 0 < d) : M < d * qOfM M d := by
  unfold qOfM
  rw [Nat.mul_succ]
  have := Nat.div_add_mod M d
  have := Nat.mod_lt M hd
  omega

/-- Number of periods for the bound `N`. -/
def qOf (d : ℕ) : ℕ := qOfM N d

theorem lt_mul_qOf (d : ℕ) (hd : 0 < d) : N < d * qOf d := lt_mul_qOfM N d hd

/-- Bits `2d, 3d, 4d, ...` (multiples of `d` that are at least `2d`), covering `[0, M]`. -/
def multMaskM (M d : ℕ) : ℕ := geo d (qOfM M d) <<< (2 * d)

theorem multMaskM_testBit (M d : ℕ) (hd : 0 < d) (p : ℕ) (hp : d ∣ p) (h2 : 2 * d ≤ p)
    (hM : p ≤ M) : (multMaskM M d).testBit p = true := by
  unfold multMaskM
  rw [Nat.testBit_shiftLeft, geo_testBit d hd]
  simp only [ge_iff_le, h2, decide_true, Bool.true_and, decide_eq_true_eq]
  refine ⟨?_, ?_⟩
  · exact Nat.dvd_sub hp (dvd_mul_left d 2)
  · have := lt_mul_qOfM M d hd; omega

/-- Sieve for `[0, M]` using divisors `d ∈ [2, D+1]`. -/
def sieveM (M D : ℕ) : ℕ := (List.range' 2 D).foldr (fun d acc => multMaskM M d ||| acc) 0

theorem foldr_lor_testBit (l : List ℕ) (f : ℕ → ℕ) (i : ℕ) (d : ℕ) (hd : d ∈ l)
    (h : (f d).testBit i = true) :
    (l.foldr (fun d acc => f d ||| acc) 0).testBit i = true := by
  induction l with
  | nil => simp at hd
  | cons a l ih =>
    simp only [List.foldr_cons, Nat.testBit_lor]
    rcases List.mem_cons.mp hd with rfl | hd'
    · simp [h]
    · simp [ih hd']

theorem sieveM_testBit_composite (M D : ℕ) (hD : M < (D + 2) * (D + 2)) (p : ℕ) (h2 : 2 ≤ p)
    (hM : p ≤ M) (hnp : ¬ p.Prime) : (sieveM M D).testBit p = true := by
  set d := p.minFac with hd
  have hdp : d ∣ p := Nat.minFac_dvd p
  have hdprime : d.Prime := Nat.minFac_prime (by omega)
  have hd2 : 2 ≤ d := hdprime.two_le
  have hdlt : d < p := (Nat.not_prime_iff_minFac_lt h2).mp hnp
  have hsq : d ^ 2 ≤ p := Nat.minFac_sq_le_self (by omega) hnp
  have hdD : d ≤ D + 1 := by
    by_contra hc
    push_neg at hc
    have : (D + 2) * (D + 2) ≤ d * d := Nat.mul_le_mul hc hc
    have : d * d ≤ p := by rw [← pow_two]; exact hsq
    omega
  have h2d : 2 * d ≤ p := by
    obtain ⟨t, ht⟩ := hdp
    have : t ≠ 0 := by rintro rfl; omega
    have : t ≠ 1 := by rintro rfl; omega
    have : 2 ≤ t := by omega
    nlinarith
  unfold sieveM
  apply foldr_lor_testBit _ _ _ d
  · rw [List.mem_range']
    exact ⟨d - 2, by omega, by omega⟩
  · exact multMaskM_testBit M d (by omega) p hdp h2d hM

/-- Sieve for `p ≤ 1414` (divisors up to `37`). -/
def smallSieve : ℕ := sieveM 1414 36

theorem smallSieve_prime (p : ℕ) (h2 : 2 ≤ p) (hp : p ≤ 1414) (hs : smallSieve.testBit p = false) :
    p.Prime := by
  by_contra h
  have := sieveM_testBit_composite 1414 36 (by norm_num) p h2 hp h
  unfold smallSieve at hs
  rw [this] at hs
  exact Bool.noConfusion hs

/-- `1414!` as a literal. -/
@[irreducible] def PRIM : ℕ := nat_lit 

set_option maxHeartbeats 0 in
theorem PRIM_eq : PRIM = Nat.factorial 1414 := by
  unfold PRIM
  decide +kernel

/-- Primality from the factorial gcd test, for `1414 < p ≤ N`. -/
theorem prime_of_gcd (p : ℕ) (hlo : 1414 < p) (hN : p ≤ N) (hg : Nat.gcd p PRIM = 1) : p.Prime := by
  by_contra h
  have h2 : 2 ≤ p := by omega
  set d := p.minFac with hd
  have hdp : d ∣ p := Nat.minFac_dvd p
  have hdprime : d.Prime := Nat.minFac_prime (by omega)
  have hd2 : 2 ≤ d := hdprime.two_le
  have hsq : d ^ 2 ≤ p := Nat.minFac_sq_le_self (by omega) h
  have hdD : d ≤ 1414 := by
    by_contra hc
    push_neg at hc
    have : 1415 * 1415 ≤ d * d := Nat.mul_le_mul hc hc
    have : d * d ≤ p := by rw [← pow_two]; exact hsq
    have : p ≤ 2000000 := hN
    omega
  have hdF : d ∣ PRIM := by
    rw [PRIM_eq]
    exact Nat.dvd_factorial (by omega) hdD
  have : d ∣ Nat.gcd p PRIM := Nat.dvd_gcd hdp hdF
  rw [hg] at this
  have := Nat.le_of_dvd Nat.one_pos this
  omega

