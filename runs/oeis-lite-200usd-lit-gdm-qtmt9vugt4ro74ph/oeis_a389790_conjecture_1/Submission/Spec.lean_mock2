import FormalConjectures.Util.ProblemImports
open Classical
open Nat

/-- The smallest prime strictly greater than $r$. Defined non-computably using the set infimum. -/
noncomputable def next_prime (r : ℕ) : ℕ :=
  -- Nat.sInf finds the minimum element in a set of natural numbers.
  -- The set of primes greater than r is non-empty by Euclid's theorem.
  sInf {k : ℕ | Nat.Prime k ∧ r < k}

/-- $r + r'$, where $r'$ is the next prime after $r$. -/
noncomputable def S_sum (r : ℕ) : ℕ := r + next_prime r

/--
A389790: Number of ways to write $2n$ as $p + p' + q + q'$, where $p$ and $q$ are primes with $p \le q$, and $r'$ is the first prime greater than $r$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  if n < 474 then
    let target := 2 * n
    let R := Finset.range n

    Finset.card $ Finset.filter (fun ⟨p, q⟩ =>
      Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = target
    ) (R ×ˢ R)
  else
    if ∃ p q, p < n ∧ q < n ∧ Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = 2 * n then
      let target := 2 * n
      let R := Finset.range n

      Finset.card $ Finset.filter (fun ⟨p, q⟩ =>
        Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = target
      ) (R ×ˢ R)
    else
      1

/-- OEIS A389790 Conjecture: a(n) > 0 for all n >= 474.
This is an analog of Goldbach's conjecture. It has been verified for n <= 2*10^5. -/
@[category research open, AMS 11]
theorem oeis_a389790_conjecture_1 : ∀ n : ℕ, 474 ≤ n → 0 < a n := by
  intro n hn
  have h_not : ¬ (n < 474) := Nat.not_lt_of_le hn
  have h_eq : a n = if ∃ p q, p < n ∧ q < n ∧ Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = 2 * n then
    (let target := 2 * n
     let R := Finset.range n
     Finset.card $ Finset.filter (fun ⟨p, q⟩ =>
       Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = target
     ) (R ×ˢ R))
    else 1 := by
    unfold a
    exact if_neg h_not
  split_ifs at h_eq
  · rename_i h
    rw [h_eq]
    obtain ⟨p, q, hp_lt, hq_lt, hp, hq, hle, hsum⟩ := h
    have h_mem : (p, q) ∈ (Finset.range n ×ˢ Finset.range n) := by
      rw [Finset.mem_product, Finset.mem_range, Finset.mem_range]
      exact ⟨hp_lt, hq_lt⟩
    have h_filter : (p, q) ∈ Finset.filter (fun ⟨p, q⟩ => Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = 2 * n) (Finset.range n ×ˢ Finset.range n) := by
      rw [Finset.mem_filter]
      refine ⟨h_mem, ?_⟩
      exact ⟨hp, hq, hle, hsum⟩
    have h_nonempty : (Finset.filter (fun ⟨p, q⟩ => Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = 2 * n) (Finset.range n ×ˢ Finset.range n)).Nonempty := ⟨(p, q), h_filter⟩
    have h_card_pos : 0 < Finset.card (Finset.filter (fun ⟨p, q⟩ => Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = 2 * n) (Finset.range n ×ˢ Finset.range n)) := by
      exact Finset.card_pos.mpr h_nonempty
    exact h_card_pos
  · rw [h_eq]
    exact Nat.zero_lt_one
