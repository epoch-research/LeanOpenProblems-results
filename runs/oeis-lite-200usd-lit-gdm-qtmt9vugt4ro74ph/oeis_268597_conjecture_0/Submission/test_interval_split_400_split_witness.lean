def witness (n : ℕ) : ℕ :=
  if n < 200 then witness_0_199 n else witness_200_399 n

lemma witness_pos_and_mod_0 (n : ℕ) (hn : n < 200) : witness n > 0 ∧ (witness n - 1) % Nat.totient (witness n) = n := by
  have h_wit : witness n = witness_0_199 n := by
    unfold witness; split_ifs <;> rfl
  rw [h_wit]
  interval_cases n <;> decide

lemma witness_pos_and_mod_1 (n : ℕ) (h1 : 200 ≤ n) (h2 : n < 400) : witness n > 0 ∧ (witness n - 1) % Nat.totient (witness n) = n := by
  have h_wit : witness n = witness_200_399 n := by
    unfold witness; split_ifs <;> try omega; rfl
  rw [h_wit]
  interval_cases n <;> decide

lemma witness_pos_and_mod (n : ℕ) (hn : n < 400) : witness n > 0 ∧ (witness n - 1) % Nat.totient (witness n) = n := by
  by_cases h : n < 200
  · exact witness_pos_and_mod_0 n h
  · have h2 : 200 ≤ n := by omega
    exact witness_pos_and_mod_1 n h2 hn
