  | 999 => 5000
  | _ => 1

lemma witness_pos_and_mod_all : ∀ n < 1000, witness n > 0 ∧ (witness n - 1) % Nat.totient (witness n) = n := by
  decide

lemma witness_pos_and_mod (n : ℕ) (hn : n < 1000) : witness n > 0 ∧ (witness n - 1) % Nat.totient (witness n) = n := by
  exact witness_pos_and_mod_all n hn
