lemma no_integer_in_short_interval {x : ℝ} {δ : ℝ} (hδ : δ < 1) (k : ℤ) :
    x < (k : ℝ) → (k : ℝ) < x + δ → k = Int.floor x + 1 := by
  intro h1 h2
  have h3 : (Int.floor x : ℝ) ≤ x := Int.floor_le x
  have h4 : x < (Int.floor x : ℝ) + 1 := Int.lt_floor_add_one x
  have h5 : (k : ℝ) < (Int.floor x : ℝ) + 1 + δ := by linarith [h2, h4]
  have h6 : (Int.floor x : ℝ) < (k : ℝ) := by linarith [h1, h3]
  have hk1 : Int.floor x < k := by exact_mod_cast h6
  have hk2 : k < Int.floor x + 2 := by
    have : (k : ℝ) < (Int.floor x : ℝ) + 2 := by linarith [h5, hδ]
    exact_mod_cast this
  omega
