lemma m_q_le_311 : ∃ m ≤ 311^2 - 2, m ≥ 1 ∧ 311 ∣ x_seq m := by
  have h_seq : x_seq 1553 = x_seq_loop 1552 1 1 := x_seq_eq_loop 1553 (by decide)
  use 1553
  rw [h_seq]
  decide

