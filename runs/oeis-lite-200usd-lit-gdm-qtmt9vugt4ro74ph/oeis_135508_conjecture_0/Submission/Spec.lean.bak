    ∃ m ≤ q^2 - 2, m ≥ 1 ∧ q ∣ x_seq m := by
  have hk : q - 303 < 9 := by omega
  have hq_eq : q = (q - 303) + 303 := by omega
  generalize h_k : q - 303 = k at hk hq_eq
  interval_cases k
  · rw [hq_eq] at hq; contradiction
  · rw [hq_eq] at hq; contradiction
  · rw [hq_eq] at hq; contradiction
  · rw [hq_eq] at hq; contradiction
