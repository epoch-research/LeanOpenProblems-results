lemma m_q_le_107 : ∃ m ≤ 107^2 - 2, m ≥ 1 ∧ 107 ∣ x_seq m := by
  have h_seq : x_seq 2459 = x_seq_loop 2458 1 1 := x_seq_eq_loop 2459 (by decide)
  use 2459
  rw [h_seq]
  decide

