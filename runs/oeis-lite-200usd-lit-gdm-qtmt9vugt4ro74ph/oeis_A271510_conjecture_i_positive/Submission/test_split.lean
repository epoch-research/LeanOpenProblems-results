def sol_of_nat (n : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  if n < 500 then sol_part0 n
  else if n < 1000 then sol_part1 n
  else if n < 1500 then sol_part2 n
  else if n < 2000 then sol_part3 n
  else if n = 2000 then (0, 0, 20, 40)
  else (0, 0, 0, 0)

def sol_r (n : ℕ) : ℕ :=
  if n < 500 then sol_r_part0 n
  else if n < 1000 then sol_r_part1 n
  else if n < 1500 then sol_r_part2 n
  else if n < 2000 then sol_r_part3 n
  else if n = 2000 then 80
  else 0

lemma sol_of_nat_correct_bounded_r : ∀ (n : ℕ), n ≤ 2000 →
  let s := sol_of_nat n
  s.1^2 + s.2.1^2 + s.2.2.1^2 + s.2.2.2^2 = n ∧ s.1 ≥ s.2.1 ∧
  (sol_r n)^2 = s.1^2 + 8*s.2.1^2 + 16*s.2.2.1^2 := by
  decide
