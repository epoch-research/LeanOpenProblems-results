def sol_of_nat (n : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  (sol_list.get? n).getD (0, 0, 0, 0)

def sol_r (n : ℕ) : ℕ :=
  (sol_r_list.get? n).getD 0

lemma sol_of_nat_correct_bounded_r : ∀ (n : ℕ), n ≤ 2000 →
  let s := sol_of_nat n
  s.1^2 + s.2.1^2 + s.2.2.1^2 + s.2.2.2^2 = n ∧ s.1 ≥ s.2.1 ∧
  (sol_r n)^2 = s.1^2 + 8*s.2.1^2 + 16*s.2.2.1^2 := by
  decide
