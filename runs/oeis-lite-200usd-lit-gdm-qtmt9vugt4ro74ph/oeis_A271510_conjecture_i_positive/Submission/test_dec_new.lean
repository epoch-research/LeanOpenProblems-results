lemma has_sol_w0_of_is_H0 {q : ℕ} (h : is_H0 q = true) :
  ∃ x y z, x^2 + y^2 + z^2 = q ∧ x ≥ y ∧ (x^2 + 8*y^2 + 16*z^2).sqrt * (x^2 + 8*y^2 + 16*z^2).sqrt = x^2 + 8*y^2 + 16*z^2 := by
  have h_corr := sol_w0_correct q h
  generalize h_sol : sol_w0_of_nat q = s
  rw [h_sol] at h_corr
  rcases h_corr with ⟨h1, h2, h3⟩
  use s.1, s.2.1, s.2.2.1
  refine ⟨h1, h2, ?_⟩
  rw [← h3]
  rw [Nat.sqrt_eq', sq]
