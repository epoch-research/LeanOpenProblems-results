theorem p_prime : p.Prime := by
  have hp : 1 < p := by
    dsimp [p]
    omega
  apply prime_of_lucas p hp y0
  · -- Proof of y0 ^ (p + 1) = 1 without complex motive normalization
    have step_y_final : (XPow w_16 302829) ^ 2 = 1 := by decide
    have h_p_eq_fast : p + 1 = pow_3_39100 * 302829 * 2 := by decide
    have h_p_eq : p + 1 = 3 ^ 39100 * 302829 * 2 := by
      rw [← pow_3_39100_eq]
      exact h_p_eq_fast
    have h_split : y0 ^ (p + 1) = ((y0 ^ (3 ^ 39100)) ^ 302829) ^ 2 := by
      rw [h_p_eq, pow_mul, pow_mul]
    have h_step1 : ((y0 ^ (3 ^ 39100)) ^ 302829) ^ 2 = (w_16 ^ 302829) ^ 2 :=
      congrArg (fun x => (x ^ 302829) ^ 2) h_w_chain_base
    have h_step2 : (w_16 ^ 302829) ^ 2 = (XPow w_16 302829) ^ 2 :=
      congrArg (fun x => x ^ 2) (XPow_eq_pow w_16 302829 (by decide)).symm
    have h_trans1 : y0 ^ (p + 1) = (w_16 ^ 302829) ^ 2 := Eq.trans h_split h_step1
    have h_trans2 : y0 ^ (p + 1) = (XPow w_16 302829) ^ 2 := Eq.trans h_trans1 h_step2
    exact Eq.trans h_trans2 step_y_final

  intro r hr hr_dvd
  have h_p_eq : p + 1 = 2 * (100943 * 3 ^ 39101) := rfl
  have h_factors := prime_factors_of_p_plus_one r hr hr_dvd
  rcases h_factors with hr2 | hr3 | hr100943
  · subst hr2
    have step_inv_u2 : ((XPow w_16 302829) - 1) * inv_u2 = 1 := by decide
    have h_eq : y0 ^ ((p + 1) / 2) = XPow w_16 302829 := by
      have h_div_two_fast : (p + 1) / 2 = pow_3_39100 * 302829 := by decide
      have h_div_two : (p + 1) / 2 = 3 ^ 39100 * 302829 := by
        rw [← pow_3_39100_eq]
        exact h_div_two_fast
      rw [h_div_two, pow_mul, h_w_chain_base]
      exact (XPow_eq_pow w_16 302829 (by decide)).symm
    have h_is_unit : IsUnit (XPow w_16 302829 - 1) :=
      our_isUnit_of_mul_eq_one _ inv_u2 step_inv_u2
    exact h_eq.symm ▸ h_is_unit
  · subst hr3
    have step_inv_u3 : ((XPow w_16 201886) - 1) * inv_u3 = 1 := by decide
    have h_eq : y0 ^ ((p + 1) / 3) = XPow w_16 201886 := by
      have h_div_three_fast : (p + 1) / 3 = pow_3_39100 * 201886 := by decide
      have h_div_three : (p + 1) / 3 = 3 ^ 39100 * 201886 := by
        rw [← pow_3_39100_eq]
        exact h_div_three_fast
      rw [h_div_three, pow_mul, h_w_chain_base]
      exact (XPow_eq_pow w_16 201886 (by decide)).symm
    have h_is_unit : IsUnit (XPow w_16 201886 - 1) :=
      our_isUnit_of_mul_eq_one _ inv_u3 step_inv_u3
    exact h_eq.symm ▸ h_is_unit
  · subst hr100943
    have step_inv_u100943 : ((XPow w_16 6) - 1) * inv_u100943 = 1 := by decide
    have h_eq : y0 ^ ((p + 1) / 100943) = XPow w_16 6 := by
      have h_div_100943_fast : (p + 1) / 100943 = pow_3_39100 * 6 := by decide
      have h_div_100943 : (p + 1) / 100943 = 3 ^ 39100 * 6 := by
        rw [← pow_3_39100_eq]
        exact h_div_100943_fast
      rw [h_div_100943, pow_mul, h_w_chain_base]
      exact (XPow_eq_pow w_16 6 (by decide)).symm
