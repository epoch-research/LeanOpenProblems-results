  repeat rw [pow_mul]
  rw [← XPow_eq_pow y0 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_1]
