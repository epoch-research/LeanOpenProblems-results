instance : NeZero p := ⟨by dsimp [p]; omega⟩

instance (q : ℕ) [NeZero q] : Fintype (X q) := by
  dsimp [X]
  infer_instance

def castX (q p : ℕ) (h : q ∣ p) : X p →+* X q where
  toFun x := (ZMod.castHom h (ZMod q) x.1, ZMod.castHom h (ZMod q) x.2)
  map_one' := by ext <;> simp [map_one, map_zero]
  map_mul' x y := by ext <;> simp [map_add, map_mul, map_ofNat]
  map_zero' := by ext <;> simp [map_zero]
  map_add' x y := by ext <;> simp [map_add]

lemma our_isUnit_of_mul_eq_one (a b : X p) (h : a * b = 1) : IsUnit a := by
  use ⟨a, b, h, by rw [mul_comm, h]⟩

lemma prime_eq_of_dvd_prime {r q : ℕ} (hr : r.Prime) (hq : q.Prime) (hdvd : r ∣ q) : r = q := by
  have h := Nat.Prime.eq_one_or_self_of_dvd hq r hdvd
  rcases h with h1 | h2
  · subst h1; contradiction
  · exact h2

lemma prime_factors_of_p_plus_one (r : ℕ) (hr : r.Prime) (hdvd : r ∣ 2 * 100943 * 3 ^ 39101) :
    r = 2 ∨ r = 3 ∨ r = 100943 := by
  have h1 : r ∣ 2 * 100943 ∨ r ∣ 3 ^ 39101 := (Nat.Prime.dvd_mul hr).mp hdvd
  rcases h1 with h2 | h3
  · have h3 : r ∣ 2 ∨ r ∣ 100943 := (Nat.Prime.dvd_mul hr).mp h2
    rcases h3 with h4 | h5
    · left
      have hq : Nat.Prime 2 := by norm_num
      exact prime_eq_of_dvd_prime hr hq h4
    · right; right
      have hq : Nat.Prime 100943 := by norm_num
      exact prime_eq_of_dvd_prime hr hq h5
  · right; left
    have hq : Nat.Prime 3 := by norm_num
    have h4 : r ∣ 3 := Nat.Prime.dvd_of_dvd_pow hr h3
    exact prime_eq_of_dvd_prime hr hq h4

lemma prime_of_prime_factors_sq (p : ℕ) (hp : 1 < p) (h : ∀ q, q.Prime → q ∣ p → p < q ^ 2) : p.Prime := by
  by_contra h_comp
  have h_sq := minFac_sq_le_self (by omega) h_comp
  have h_prime := minFac_prime hp.ne'
  have h_dvd := minFac_dvd p
  have h_lt := h (minFac p) h_prime h_dvd
  exact (lt_self_iff_false (minFac p ^ 2)).mp (lt_of_le_of_lt h_sq h_lt)

theorem prime_of_lucas (p : ℕ) (hp : 1 < p) (x : X p)
    (h_pow : x ^ (p + 1) = 1)
    (h_div : ∀ r : ℕ, r.Prime → r ∣ p + 1 → IsUnit (x ^ ((p + 1) / r) - 1)) : p.Prime := by
  apply prime_of_prime_factors_sq p hp
  intro q hq hq_dvd
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI : Fact (0 < q) := ⟨hq.pos⟩
  haveI : Fact (1 < q) := ⟨hq.one_lt⟩
  haveI : NeZero (1 : ZMod q) := ⟨by
    intro hc
    have hc_val : (1 : ZMod q).val = (0 : ZMod q).val := by rw [hc]
    rw [ZMod.val_one, ZMod.val_zero] at hc_val
    omega⟩
  by_contra! h_le
  let y := castX q p hq_dvd x
  have h_y_pow : y ^ (p + 1) = 1 := by
    rw [← map_pow, h_pow, map_one]
  have h_y_div : ∀ r : ℕ, r.Prime → r ∣ p + 1 → y ^ ((p + 1) / r) ≠ 1 := by
    intro r hr hr_dvd h_one
    have h_unit := h_div r hr hr_dvd
    have h_unit_y := IsUnit.map (castX q p hq_dvd) h_unit
    have h_zero : (castX q p hq_dvd) (x ^ ((p + 1) / r) - 1) = 0 := by
      rw [map_sub, map_pow, map_one, h_one, sub_self]
    rw [h_zero] at h_unit_y
    rcases h_unit_y with ⟨u, hu⟩
    have h_mul := u.val_inv
    rw [hu] at h_mul
    have h_zero_mul : (0 : X q) * u.inv = 0 := zero_mul _
    rw [h_zero_mul] at h_mul
    have h_ne_one : (0 : X q) ≠ 1 := by
      intro hc
      injection hc with hc1 hc2
      have : (0 : ZMod q) = 1 := hc1
      exact zero_ne_one' (ZMod q) this
    exact h_ne_one h_mul
  have h_order := orderOf_eq_of_pow_and_pow_div_prime (by omega) h_y_pow h_y_div
  have h_le_card := orderOf_le_card_univ (x := y)
  have h_card : Fintype.card (X q) = q ^ 2 := by
    dsimp [X]
    rw [Fintype.card_prod, ZMod.card q, sq]
  rw [h_order, h_card] at h_le_card
  omega

def nat_pow_fast_loop : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, acc => acc
  | fuel + 1, base, e, acc =>
    if e = 0 then acc
    else
      nat_pow_fast_loop fuel (base * base) (e / 2) (if e % 2 = 1 then acc * base else acc)

lemma nat_pow_fast_loop_eq (fuel : Nat) (base e acc : Nat) (h_fuel : e < 2 ^ fuel) :
    nat_pow_fast_loop fuel base e acc = acc * base ^ e := by
  induction fuel generalizing base e acc with
  | zero =>
    have : e = 0 := by omega
    subst this
    simp [nat_pow_fast_loop]
  | succ fuel' ih =>
    rw [nat_pow_fast_loop]
    split_ifs with h h_odd
    · subst h
      simp
    · have h_lt : e / 2 < 2 ^ fuel' := by
        have : 2 ^ (fuel' + 1) = 2 ^ fuel' * 2 := by ring
        omega
      rw [ih (base * base) (e / 2) _ h_lt]
      have h_eq : e = 2 * (e / 2) + 1 := by omega
      have h_div_two : (2 * (e / 2) + 1) / 2 = e / 2 := by omega
      rw [h_eq, h_div_two, pow_succ, pow_mul, ← pow_two]
      ring
    · have h_lt : e / 2 < 2 ^ fuel' := by
        have : 2 ^ (fuel' + 1) = 2 ^ fuel' * 2 := by ring
        omega
      rw [ih (base * base) (e / 2) _ h_lt]
      have h_even : e % 2 = 0 := by omega
      have h_eq : e = 2 * (e / 2) := by omega
      have h_div_two : (2 * (e / 2)) / 2 = e / 2 := by omega
      rw [h_eq, h_div_two, pow_mul, ← pow_two]

def nat_pow_fast (base : Nat) (e : Nat) : Nat :=
  nat_pow_fast_loop 20 base e 1

theorem nat_pow_fast_eq (base : Nat) (e : Nat) (h_fuel : e < 2 ^ 20) : nat_pow_fast base e = base ^ e := by
  dsimp [nat_pow_fast]
  rw [nat_pow_fast_loop_eq 20 base e 1 h_fuel, one_mul]

noncomputable def mulNat (x y : Nat × Nat) : Nat × Nat :=
  ((x.1 * y.1 + 3 * x.2 * y.2) % p, (x.1 * y.2 + x.2 * y.1) % p)

noncomputable def XPowNat_loop : Nat → Nat × Nat → Nat → Nat × Nat → Nat × Nat
  | 0, _, _, acc => acc
  | fuel + 1, b, e, acc =>
    if e = 0 then acc
    else
      XPowNat_loop fuel (mulNat b b) (e / 2) (if e % 2 = 1 then mulNat acc b else acc)

noncomputable def XPowNat (b : Nat × Nat) (e : Nat) : Nat × Nat :=
  XPowNat_loop 30000 b e (1, 0)

noncomputable def toX (x : Nat × Nat) : X p :=
  (x.1, x.2)

lemma toX_one : toX (1, 0) = 1 := by
  ext <;> rfl

lemma toX_mul (x y : Nat × Nat) : toX (mulNat x y) = toX x * toX y := by
  ext <;> simp [toX, mulNat]

lemma toX_XPowNat_loop (fuel : Nat) (b : Nat × Nat) (e : Nat) (acc : Nat × Nat) (h_fuel : e < 2 ^ fuel) :
    toX (XPowNat_loop fuel b e acc) = toX acc * (toX b) ^ e := by
  induction fuel generalizing b e acc with
  | zero =>
    have : e = 0 := by omega
    subst this
    simp [XPowNat_loop]
  | succ fuel' ih =>
    rw [XPowNat_loop]
    split_ifs with h h_odd
    · subst h
      simp
    · have h_lt : e / 2 < 2 ^ fuel' := by
        have : 2 ^ (fuel' + 1) = 2 ^ fuel' * 2 := by ring
        omega
      rw [ih (mulNat b b) (e / 2) _ h_lt]
      rw [toX_mul, toX_mul]
      have h_eq : e = 2 * (e / 2) + 1 := by omega
      have h_div_two : (2 * (e / 2) + 1) / 2 = e / 2 := by omega
      rw [h_eq, h_div_two, pow_succ, pow_mul, ← pow_two]
      ring
    · have h_lt : e / 2 < 2 ^ fuel' := by
        have : 2 ^ (fuel' + 1) = 2 ^ fuel' * 2 := by ring
        omega
      rw [ih (mulNat b b) (e / 2) _ h_lt]
      rw [toX_mul]
      have h_even : e % 2 = 0 := by omega
      have h_eq : e = 2 * (e / 2) := by omega
      have h_div_two : (2 * (e / 2)) / 2 = e / 2 := by omega
      rw [h_eq, h_div_two, pow_mul, ← pow_two]

theorem XPowNat_eq_pow (b : Nat × Nat) (e : Nat) (h_fuel : e < 2 ^ 30000) : toX (XPowNat b e) = toX b ^ e := by
  dsimp [XPowNat]
  rw [toX_XPowNat_loop 30000 b e (1, 0) h_fuel, toX_one, one_mul]

noncomputable def XPow (b : X p) (e : Nat) : X p :=
  toX (XPowNat (b.1.val, b.2.val) e)

lemma toX_val_eq (b : X p) : toX (b.1.val, b.2.val) = b := by
  ext <;> simp [toX]

theorem XPow_eq_pow (b : X p) (e : Nat) (h_fuel : e < 2 ^ 30000) : XPow b e = b ^ e := by
  dsimp [XPow]
  rw [XPowNat_eq_pow _ _ h_fuel]
  rw [toX_val_eq]

