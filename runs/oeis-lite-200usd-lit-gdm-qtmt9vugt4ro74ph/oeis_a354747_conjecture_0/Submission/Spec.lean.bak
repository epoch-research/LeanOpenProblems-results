  have step_w_12 : XPow w_11 pow_3_2600 = w_12 := by decide
  have step_w_13 : XPow w_12 pow_3_2600 = w_13 := by decide
  have step_w_14 : XPow w_13 pow_3_2600 = w_14 := by decide
  have step_w_15 : XPow w_14 pow_3_2600 = w_15 := by decide
  have step_w_16 : XPow w_15 pow_3_100 = w_16 := by decide
  have h_split_base_fast : pow_3_39100 = pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_2600 * pow_3_100 := by decide
  have h_split_base : 3 ^ 39100 = 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 2600 * 3 ^ 100 := by
    rw [← pow_3_39100_eq, ← pow_3_2600_eq, ← pow_3_100_eq] at h_split_base_fast
    exact h_split_base_fast
  rw [h_split_base]
  repeat rw [pow_mul]
  rw [← XPow_eq_pow y0 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_1]
  rw [← XPow_eq_pow w_1 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_2]
  rw [← XPow_eq_pow w_2 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_3]
  rw [← XPow_eq_pow w_3 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_4]
  rw [← XPow_eq_pow w_4 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_5]
  rw [← XPow_eq_pow w_5 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_6]
  rw [← XPow_eq_pow w_6 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_7]
  rw [← XPow_eq_pow w_7 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_8]
  rw [← XPow_eq_pow w_8 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_9]
  rw [← XPow_eq_pow w_9 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_10]
  rw [← XPow_eq_pow w_10 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_11]
  rw [← XPow_eq_pow w_11 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_12]
  rw [← XPow_eq_pow w_12 (3 ^ 2600) (pow_3_2600_eq ▸ (by decide : pow_3_2600 < 2 ^ 30000)), pow_3_2600_eq ▸ step_w_13]
