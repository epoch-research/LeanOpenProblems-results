def pow_3_2600 : Nat := nat_pow_fast 3 2600
def pow_3_100 : Nat := nat_pow_fast 3 100
def pow_3_39100 : Nat := nat_pow_fast 3 39100
def pow_3_39101 : Nat := nat_pow_fast 3 39101

lemma pow_3_2600_eq : pow_3_2600 = 3 ^ 2600 := nat_pow_fast_eq 3 2600 (by decide)
lemma pow_3_100_eq : pow_3_100 = 3 ^ 100 := nat_pow_fast_eq 3 100 (by decide)
lemma pow_3_39100_eq : pow_3_39100 = 3 ^ 39100 := nat_pow_fast_eq 3 39100 (by decide)
lemma pow_3_39101_eq : pow_3_39101 = 3 ^ 39101 := nat_pow_fast_eq 3 39101 (by decide)

lemma h_w_chain_base : y0 ^ (3 ^ 39100) = w_16 := by
  have step_w_1 : XPow y0 pow_3_2600 = w_1 := by decide
  have step_w_2 : XPow w_1 pow_3_2600 = w_2 := by decide
  have step_w_3 : XPow w_2 pow_3_2600 = w_3 := by decide
  have step_w_4 : XPow w_3 pow_3_2600 = w_4 := by decide
  have step_w_5 : XPow w_4 pow_3_2600 = w_5 := by decide
  have step_w_6 : XPow w_5 pow_3_2600 = w_6 := by decide
  have step_w_7 : XPow w_6 pow_3_2600 = w_7 := by decide
