open Nat Finset
theorem single_le_sum {α : Type*} (f : α → ℕ) {s : Finset α} {i : α} (hi : i ∈ s) : f i ≤ ∑ x ∈ s, f x := by
  classical
  have h1 : s = insert i (s.erase i) := (Finset.insert_erase hi).symm
  rw [h1]
  rw [Finset.sum_insert (by simp)]
  omega


/--
A347865: Number of ways to write $n$ as $w^2 + 2x^2 + y^4 + 3z^4$, where $w,x,y,z$ are nonnegative integers.
-/
def a (n : ℕ) : ℕ :=
  -- Helper to check if a natural number is a perfect square, using the integer square root.
  let is_perfect_square (m : ℕ) : Prop := (Nat.sqrt m) ^ 2 = m

  -- Upper bounds derived from components $\le n$:
  -- w^2 <= n implies w <= sqrt(n). We use Nat.sqrt n + 1 for the range.
  let max_sq_term_root := Nat.sqrt n + 1
  -- y^4 <= n implies y <= n^(1/4) = sqrt(sqrt(n)).
  let max_quad_term_root := Nat.sqrt (Nat.sqrt n) + 1

  -- We iterate over the bounded ranges of $x, y, z$.
  Finset.sum (range max_quad_term_root) fun z =>
    Finset.sum (range max_quad_term_root) fun y =>
      Finset.sum (range max_sq_term_root) fun x =>
        let rest : ℕ := 2 * x^2 + y^4 + 3 * z^4

        -- Check if $w^2 = n - rest$ is possible in $\mathbb{N}$.
        if rest ≤ n then
          -- The remainder $n - rest$ must be a perfect square for a solution $w$ to exist.
          if is_perfect_square (n - rest) then 1 else 0
        else
          0


set_option maxHeartbeats 100000000
set_option maxRecDepth 2000000

theorem Nat.sqrt_eq_iff_of_properties (n s : ℕ) : n.sqrt = s ↔ (s * s ≤ n ∧ n < (s + 1) * (s + 1)) := by
  constructor
  · rintro rfl
    constructor
    · exact Nat.sqrt_le n
    · have h : ¬ (n.sqrt + 1) * (n.sqrt + 1) ≤ n := by
        intro h'
        have h'' : n.sqrt + 1 ≤ n.sqrt := by rwa [← Nat.le_sqrt] at h'
        omega
      omega
  · rintro ⟨h1, h2⟩
    have l1 : s ≤ n.sqrt := by rwa [Nat.le_sqrt]
    have l2 : n.sqrt < s + 1 := by
      have h3 : ¬ (s + 1) * (s + 1) ≤ n := by omega
      have h4 : ¬ s + 1 ≤ n.sqrt := by rwa [← Nat.le_sqrt] at h3
      omega
    omega

def my_sqrt_aux : ℕ → ℕ → ℕ
  | 0, _ => 0
  | fuel + 1, m => if (fuel + 1) * (fuel + 1) ≤ m then fuel + 1 else my_sqrt_aux fuel m

def my_sqrt (m : ℕ) : ℕ := my_sqrt_aux 30 m
def a_fast (n : ℕ) : ℕ :=
  let is_perfect_square (m : ℕ) : Prop := (my_sqrt m) ^ 2 = m
  let max_sq_term_root := my_sqrt n + 1
  let max_quad_term_root := my_sqrt (my_sqrt n) + 1
  Finset.sum (range max_quad_term_root) fun z =>
    Finset.sum (range max_quad_term_root) fun y =>
      Finset.sum (range max_sq_term_root) fun x =>
        let rest : ℕ := 2 * x^2 + y^4 + 3 * z^4
        if rest ≤ n then
          if is_perfect_square (n - rest) then 1 else 0
        else
          0


theorem my_sqrt_prop_all : ∀ m ≤ 744, (my_sqrt m) * (my_sqrt m) ≤ m ∧ m < (my_sqrt m + 1) * (my_sqrt m + 1) := by decide

theorem my_sqrt_eq_Nat_sqrt (m : ℕ) (h : m ≤ 744) : my_sqrt m = Nat.sqrt m := by
  have prop := my_sqrt_prop_all m h
  symm
  rw [Nat.sqrt_eq_iff_of_properties]
  exact prop

theorem sqrt_744 : Nat.sqrt 744 = 27 := by
  have h : my_sqrt 744 = Nat.sqrt 744 := my_sqrt_eq_Nat_sqrt 744 (by omega)
  rw [← h]
  rfl

theorem sqrt_27 : Nat.sqrt 27 = 5 := by
  have h : my_sqrt 27 = Nat.sqrt 27 := my_sqrt_eq_Nat_sqrt 27 (by omega)
  rw [← h]
  rfl

theorem a_eq_a_fast (n : ℕ) (h : n ≤ 744) : a n = a_fast n := by
  dsimp [a, a_fast]
  have h1 : my_sqrt n = Nat.sqrt n := my_sqrt_eq_Nat_sqrt n h
  have h2 : my_sqrt (Nat.sqrt n) = Nat.sqrt (Nat.sqrt n) := my_sqrt_eq_Nat_sqrt (Nat.sqrt n) (by
    have h1' := Nat.sqrt_le_self n
    omega)
  have h3 : my_sqrt (my_sqrt n) = my_sqrt (Nat.sqrt n) := by rw [h1]
  have h_quad : my_sqrt (my_sqrt n) = Nat.sqrt (Nat.sqrt n) := by rw [h3, h2]
  rw [← h_quad, ← h1]
  congr 1
  funext z
  congr 1
  funext y
  congr 1
  funext x
  by_cases h_rest : 2 * x^2 + y^4 + 3 * z^4 ≤ n
  · rw [if_pos h_rest, if_pos h_rest]
    have h_sub : n - (2 * x^2 + y^4 + 3 * z^4) ≤ 744 := by omega
    have h4 : my_sqrt (n - (2 * x^2 + y^4 + 3 * z^4)) = Nat.sqrt (n - (2 * x^2 + y^4 + 3 * z^4)) := my_sqrt_eq_Nat_sqrt _ h_sub
    rw [h4]
  · rw [if_neg h_rest, if_neg h_rest]

theorem a_fast_pos_of_witness (n : ℕ) (w x y z : ℕ)
    (h_sum : w^2 + 2 * x^2 + y^4 + 3 * z^4 = n)
    (hz : z < my_sqrt (my_sqrt n) + 1)
    (hy : y < my_sqrt (my_sqrt n) + 1)
    (hx : x < my_sqrt n + 1)
    (hw : (my_sqrt (n - (2 * x^2 + y^4 + 3 * z^4)))^2 = n - (2 * x^2 + y^4 + 3 * z^4)) :
    a_fast n > 0 := by
  dsimp [a_fast]
  have hz_mem : z ∈ range (my_sqrt (my_sqrt n) + 1) := mem_range.mpr hz
  have hy_mem : y ∈ range (my_sqrt (my_sqrt n) + 1) := mem_range.mpr hy
  have hx_mem : x ∈ range (my_sqrt n + 1) := mem_range.mpr hx
  have h1 := single_le_sum (fun z_1 => ∑ y_1 ∈ range (my_sqrt (my_sqrt n) + 1), ∑ x_1 ∈ range (my_sqrt n + 1), (if 2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z_1 ^ 4 ≤ n then if (my_sqrt (n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z_1 ^ 4))) ^ 2 = n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z_1 ^ 4) then 1 else 0 else 0)) hz_mem
  have h2 := single_le_sum (fun y_1 => ∑ x_1 ∈ range (my_sqrt n + 1), (if 2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z ^ 4 ≤ n then if (my_sqrt (n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z ^ 4))) ^ 2 = n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z ^ 4) then 1 else 0 else 0)) hy_mem
  have h3 := single_le_sum (fun x_1 => (if 2 * x_1 ^ 2 + y ^ 4 + 3 * z ^ 4 ≤ n then if (my_sqrt (n - (2 * x_1 ^ 2 + y ^ 4 + 3 * z ^ 4))) ^ 2 = n - (2 * x_1 ^ 2 + y ^ 4 + 3 * z ^ 4) then 1 else 0 else 0)) hx_mem
  dsimp only at h1 h2 h3
  have h_rest : 2 * x^2 + y^4 + 3 * z^4 ≤ n := by omega
  have h_term : (if 2 * x ^ 2 + y ^ 4 + 3 * z ^ 4 ≤ n then if (my_sqrt (n - (2 * x ^ 2 + y ^ 4 + 3 * z ^ 4))) ^ 2 = n - (2 * x ^ 2 + y ^ 4 + 3 * z ^ 4) then 1 else 0 else 0) = 1 := by
    rw [if_pos h_rest, if_pos hw]
  omega

theorem a_pos_of_witness (n : ℕ) (w x y z : ℕ)
    (h_sum : w^2 + 2 * x^2 + y^4 + 3 * z^4 = n)
    (hz : z < Nat.sqrt (Nat.sqrt n) + 1)
    (hy : y < Nat.sqrt (Nat.sqrt n) + 1)
    (hx : x < Nat.sqrt n + 1)
    (hw : (Nat.sqrt (n - (2 * x^2 + y^4 + 3 * z^4)))^2 = n - (2 * x^2 + y^4 + 3 * z^4)) :
    a n > 0 := by
  dsimp [a]
  have hz_mem : z ∈ range (Nat.sqrt (Nat.sqrt n) + 1) := mem_range.mpr hz
  have hy_mem : y ∈ range (Nat.sqrt (Nat.sqrt n) + 1) := mem_range.mpr hy
  have hx_mem : x ∈ range (Nat.sqrt n + 1) := mem_range.mpr hx
  have h1 := single_le_sum (fun z_1 => ∑ y_1 ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x_1 ∈ range (Nat.sqrt n + 1), (if 2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z_1 ^ 4 ≤ n then if (Nat.sqrt (n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z_1 ^ 4))) ^ 2 = n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z_1 ^ 4) then 1 else 0 else 0)) hz_mem
  have h2 := single_le_sum (fun y_1 => ∑ x_1 ∈ range (Nat.sqrt n + 1), (if 2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z ^ 4 ≤ n then if (Nat.sqrt (n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z ^ 4))) ^ 2 = n - (2 * x_1 ^ 2 + y_1 ^ 4 + 3 * z ^ 4) then 1 else 0 else 0)) hy_mem
  have h3 := single_le_sum (fun x_1 => (if 2 * x_1 ^ 2 + y ^ 4 + 3 * z ^ 4 ≤ n then if (Nat.sqrt (n - (2 * x_1 ^ 2 + y ^ 4 + 3 * z ^ 4))) ^ 2 = n - (2 * x_1 ^ 2 + y ^ 4 + 3 * z ^ 4) then 1 else 0 else 0)) hx_mem
  dsimp only at h1 h2 h3
  have h_rest : 2 * x^2 + y^4 + 3 * z^4 ≤ n := by omega
  have h_term : (if 2 * x ^ 2 + y ^ 4 + 3 * z ^ 4 ≤ n then if (Nat.sqrt (n - (2 * x ^ 2 + y ^ 4 + 3 * z ^ 4))) ^ 2 = n - (2 * x ^ 2 + y ^ 4 + 3 * z ^ 4) then 1 else 0 else 0) = 1 := by
    rw [if_pos h_rest, if_pos hw]
  omega

theorem a_744_eq_sum : a 744 = ∑ z ∈ range 6, ∑ y ∈ range 6, ∑ x ∈ range 28, if 2 * x^2 + y^4 + 3 * z^4 ≤ 744 then (if (Nat.sqrt (744 - (2 * x^2 + y^4 + 3 * z^4)))^2 = 744 - (2 * x^2 + y^4 + 3 * z^4) then 1 else 0) else 0 := by
  dsimp [a]
  rw [sqrt_744, sqrt_27]

theorem sum_range_eq_list_sum_range (k : ℕ) (f : ℕ → ℕ) : ∑ x ∈ Finset.range k, f x = ((List.range k).map f).sum := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append, List.sum_append]
    rfl

theorem a_744_eq_list_sum : a 744 =
  ( (List.range 6).map fun z =>
    ( (List.range 6).map fun y =>
      ( (List.range 28).map fun x =>
        if 2 * x^2 + y^4 + 3 * z^4 ≤ 744 then
          if (Nat.sqrt (744 - (2 * x^2 + y^4 + 3 * z^4)))^2 = 744 - (2 * x^2 + y^4 + 3 * z^4) then 1 else 0
        else 0
      ).sum
    ).sum
  ).sum := by
  rw [a_744_eq_sum]
  rw [sum_range_eq_list_sum_range]
  congr 1

def a_fast_eval : ℕ :=
  ( (List.range 6).map fun z =>
    ( (List.range 6).map fun y =>
      ( (List.range 28).map fun x =>
        let rest := 2 * x^2 + y^4 + 3 * z^4
        if rest ≤ 744 then
          if (my_sqrt (744 - rest))^2 = 744 - rest then 1 else 0
        else 0
      ).sum
    ).sum
  ).sum

theorem a_fast_eval_eq : a_fast_eval = 0 := rfl

theorem a_744_eq_fast_eval :
  ( (List.range 6).map fun z =>
    ( (List.range 6).map fun y =>
      ( (List.range 28).map fun x =>
        if 2 * x^2 + y^4 + 3 * z^4 ≤ 744 then
          if (Nat.sqrt (744 - (2 * x^2 + y^4 + 3 * z^4)))^2 = 744 - (2 * x^2 + y^4 + 3 * z^4) then 1 else 0
        else 0
      ).sum
    ).sum
  ).sum = a_fast_eval := by
  dsimp [a_fast_eval]
  apply congr_arg List.sum
  apply congr_arg (List.map · (List.range 6))
  funext z
  apply congr_arg List.sum
  apply congr_arg (List.map · (List.range 6))
  funext y
  apply congr_arg List.sum
  apply congr_arg (List.map · (List.range 28))
  funext x
  have h2 : 744 - (2 * x^2 + y^4 + 3 * z^4) ≤ 744 := by omega
  rw [← my_sqrt_eq_Nat_sqrt _ h2]

theorem a_744_eq_zero : a 744 = 0 := by
  rw [a_744_eq_list_sum, a_744_eq_fast_eval, a_fast_eval_eq]

