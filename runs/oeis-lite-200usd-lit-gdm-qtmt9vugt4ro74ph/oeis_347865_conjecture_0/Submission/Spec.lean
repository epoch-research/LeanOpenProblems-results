def w_of (n : ℕ) : ℕ := (get_witness n).1
def x_of (n : ℕ) : ℕ := (get_witness n).2.1
def y_of (n : ℕ) : ℕ := (get_witness n).2.2.1
def z_of (n : ℕ) : ℕ := (get_witness n).2.2.2

theorem witness_eq : ∀ n ≤ 743, (w_of n)^2 + 2 * (x_of n)^2 + (y_of n)^4 + 3 * (z_of n)^4 = n := by decide

theorem witness_bounds : ∀ n ≤ 743,
    z_of n < my_sqrt (my_sqrt n) + 1 ∧
    y_of n < my_sqrt (my_sqrt n) + 1 ∧
    x_of n < my_sqrt n + 1 ∧
    (my_sqrt (n - (2 * (x_of n)^2 + (y_of n)^4 + 3 * (z_of n)^4)))^2 = n - (2 * (x_of n)^2 + (y_of n)^4 + 3 * (z_of n)^4) := by decide

theorem test : ∀ n ≤ 743, a n > 0 := by
  intro n h
  rw [a_eq_a_fast n (by omega)]
  have h_sum := witness_eq n h
  have hb := witness_bounds n h
  exact a_fast_pos_of_witness n (w_of n) (x_of n) (y_of n) (z_of n) h_sum hb.1 hb.2.1 hb.2.2.1 hb.2.2.2


