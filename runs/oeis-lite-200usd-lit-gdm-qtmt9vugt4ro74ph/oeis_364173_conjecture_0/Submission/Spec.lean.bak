  rw [h_g28, h_g7, h_g13, h_g10, h_g4]
  -- Simplify additions
  have h_add1 : (11 / 2 : ℝ) + 1 = 13 / 2 := by norm_num
  have h_add2 : (13 / 2 : ℝ) + 1 = 15 / 2 := by norm_num
  have h_add3 : (15 / 2 : ℝ) + 1 = 17 / 2 := by norm_num
