      _ = ((Nat.factorial 45 * Nat.factorial 10 : ℝ) * Real.Gamma (17 / 2)) / (((45/2 * 43/2 * 41/2 * 39/2 * 37/2 * 35/2 * 33/2 * 31/2 * 29/2 * 27/2 * 25/2 * 23/2 * 21/2 * 19/2 * 17/2 * Nat.factorial 20 * Nat.factorial 15 * Nat.factorial 5 : ℝ)) * Real.Gamma (17 / 2)) := by
