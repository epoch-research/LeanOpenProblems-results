  have hy2 : ((11 * y : ℤ) : ℝ) = ((1288415796384780 : ℤ) : ℝ) := by
    calc ((11 * y : ℤ) : ℝ)
      _ = 11 * (y : ℝ) := by push_cast; ring
      _ = 11 * (1288415796384780 / 11 : ℝ) := by rw [hy]
      _ = ((1288415796384780 : ℤ) : ℝ) := by norm_num
  have hy3 : 11 * y = 1288415796384780 := Int.cast_injective hy2
  have h_mod : (11 * y) % 11 = 1288415796384780 % 11 := by rw [hy3]
