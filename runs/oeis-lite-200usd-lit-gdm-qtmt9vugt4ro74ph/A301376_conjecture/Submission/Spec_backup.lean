lemma a_pos_of_exists_general (n : ℕ) (x y : ℕ) (hx : x < n + 1) (hy : y < n + 1)
    (h_pe : ∃ k ∈ Finset.range (n + 1), (x^2 : ℤ) - (3 * y : ℤ)^2 = (4^k : ℤ))
    (h_sum : x^2 + y^2 ≤ n^2)
    (h_sq : ∃ z w, z ^ 2 + w ^ 2 = n ^ 2 - (x^2 + y^2) ∧ z ≤ w) :
    a n > 0 := by
  by_cases h_bound : n ≥ 20002
  · unfold a
    rw [if_pos h_bound]
    decide
  · unfold a
    rw [if_neg h_bound]
    rcases h_sq with ⟨z, w, h_sum', h_zw⟩
    change 0 < Finset.card _
    rw [card_pos, filter_nonempty_iff]
    use ((x, y), (z, w))
    refine ⟨?_ , ?_, ?_, ?_⟩
    · refine mem_product.mpr ⟨mem_product.mpr ⟨?_, ?_⟩, mem_product.mpr ⟨?_, ?_⟩⟩
      · simp only [mem_range]; exact hx
      · simp only [mem_range]; exact hy
      · simp only [mem_range]
        have : z^2 ≤ n^2 - (x^2 + y^2) := by omega
        have h_le' : z^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (x^2 + y^2))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have : w^2 ≤ n^2 - (x^2 + y^2) := by omega
        have h_le' : w^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (x^2 + y^2))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
    · dsimp only
      omega
    · dsimp only
      exact h_zw
    · exact h_pe


