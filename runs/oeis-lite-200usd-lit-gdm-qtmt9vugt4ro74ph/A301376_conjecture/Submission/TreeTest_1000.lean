def check_correctness (start count : Nat) : Bool :=
  match count with
  | 0 => true
  | c + 1 =>
    let m := start
    let w := get_witness_tree m
    let n := 2 * m + 1
    let cond :=
      if w.1 == 0 then
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        (4^j == n^2 - (z^2 + w_val^2)) && (z <= w_val) && (j < n + 1) && (4^j <= n^2)
      else if w.1 == 1 then
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        (26 * 4^j == n^2 - (z^2 + w_val^2)) && (z <= w_val) && (j + 2 < n + 1) && (26 * 4^j <= n^2)
      else
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        (1256 * 4^j == n^2 - (z^2 + w_val^2)) && (z <= w_val) && (j + 4 < n + 1) && (1256 * 4^j <= n^2)
    cond && check_correctness (start + 1) c

