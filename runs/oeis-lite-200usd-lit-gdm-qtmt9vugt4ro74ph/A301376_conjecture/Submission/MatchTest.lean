def check_correctness (start count : Nat) : Bool :=
  match count with
  | 0 => true
  | c + 1 =>
    let m := start
    let w := get_witness_match m
    let n := 2 * m + 1
    let n2 := n * n
    let cond :=
      if w.1 == 0 then
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        (4^j == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j < n + 1) && (4^j <= n2)
