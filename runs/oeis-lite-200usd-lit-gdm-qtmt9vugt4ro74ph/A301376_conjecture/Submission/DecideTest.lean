open Nat Finset

lemma step_even (m : ℕ) (hm : m > 0)
    (h : ∃ a ∈ ((Finset.range (m + 1)).product (Finset.range (m + 1))).product ((Finset.range (m + 1)).product (Finset.range (m + 1))),
      a.1.1 ^ 2 + a.1.2 ^ 2 + a.2.1 ^ 2 + a.2.2 ^ 2 = m ^ 2 ∧
      a.2.1 ≤ a.2.2 ∧ ∃ k ∈ Finset.range (m + 1), (a.1.1 ^ 2 : ℤ) - (3 * a.1.2 : ℤ) ^ 2 = 4 ^ k) :
    ∃ a ∈ ((Finset.range (2 * m + 1)).product (Finset.range (2 * m + 1))).product ((Finset.range (2 * m + 1)).product (Finset.range (2 * m + 1))),
      a.1.1 ^ 2 + a.1.2 ^ 2 + a.2.1 ^ 2 + a.2.2 ^ 2 = (2 * m) ^ 2 ∧
      a.2.1 ≤ a.2.2 ∧ ∃ k ∈ Finset.range (2 * m + 1), (a.1.1 ^ 2 : ℤ) - (3 * a.1.2 : ℤ) ^ 2 = 4 ^ k := by
  rcases h with ⟨⟨⟨x, y⟩, ⟨z, w⟩⟩, h_mem, h_eq, h_le, k, h_k_mem, h_k_eq⟩
  dsimp only at h_eq h_le h_k_eq
  rcases mem_product.mp h_mem with ⟨hx_hy, hz_hw⟩
  rcases mem_product.mp hx_hy with ⟨hx, hy⟩
  rcases mem_product.mp hz_hw with ⟨hz, hw⟩
  simp only [mem_range] at hx hy hz hw
  -- now we want to provide the witness: ((2 * x, 2 * y), (2 * z, 2 * w))
  use ((2 * x, 2 * y), (2 * z, 2 * w))
  refine ⟨?_ , ?_, ?_, ?_⟩
  · refine mem_product.mpr ⟨mem_product.mpr ⟨?_, ?_⟩, mem_product.mpr ⟨?_, ?_⟩⟩
    · simp only [mem_range]; omega
    · simp only [mem_range]; omega
    · simp only [mem_range]; omega
    · simp only [mem_range]; omega
  · dsimp only
    calc (2 * x) ^ 2 + (2 * y) ^ 2 + (2 * z) ^ 2 + (2 * w) ^ 2
      _ = 4 * (x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2) := by ring
      _ = 4 * m ^ 2 := by rw [h_eq]
      _ = (2 * m) ^ 2 := by ring
  · dsimp only
    omega
  · use k + 1
    refine ⟨?_, ?_⟩
    · simp only [mem_range] at h_k_mem ⊢
      omega
    · simp only [Nat.cast_mul, Nat.cast_ofNat]
      calc (((2 : ℤ) * ↑x) ^ 2 - (3 * ((2 : ℤ) * ↑y)) ^ 2)
        _ = 4 * (↑x ^ 2 - (3 * ↑y) ^ 2) := by ring
        _ = 4 * 4 ^ k := by rw [h_k_eq]
        _ = 4 ^ (k + 1) := by ring

noncomputable def a (n : ℕ) : ℕ :=
  if n ≥ 20002 then 1 else
  let R := Finset.range (n + 1)
  -- Search space for (x, y, z, w) as nested products ((x, y), (z, w)).
  let domain : Finset ((ℕ × ℕ) × (ℕ × ℕ)) := (R.product R).product (R.product R)

  Finset.card $ domain.filter (λ p : (ℕ × ℕ) × (ℕ × ℕ) =>
    let x := p.fst.fst; let y := p.fst.snd;
    let z := p.snd.fst; let w := p.snd.snd;

    x^2 + y^2 + z^2 + w^2 = n^2 ∧
    z ≤ w ∧
    -- The condition: x^2 - (3*y)^2 = 4^k. Casted to ℤ for subtraction, then compared to 4^k (which is in ℕ and implicitly cast to ℤ).
    -- Bounded existence: 4^k <= n^2 implies k is bounded by log_4(n^2). range (n + 1) is a safe upper bound for k.
    (∃ k ∈ Finset.range (n + 1), (x^2 : ℤ) - (3 * y : ℤ)^2 = (4^k : ℤ))
  )

lemma a_pos_of_exists_sum_two_squares (n : ℕ) (k : ℕ) (hk : k < n + 1) (h_le : 4^k ≤ n^2)
    (h_sq : ∃ z w, z ^ 2 + w ^ 2 = n ^ 2 - 4^k ∧ z ≤ w) :
    a n > 0 := by
  by_cases h_bound : n ≥ 20002
  · unfold a
    rw [if_pos h_bound]
    decide
  · unfold a
    rw [if_neg h_bound]
    rcases h_sq with ⟨z, w, h_sum, h_zw⟩
    change 0 < Finset.card _
    rw [card_pos, filter_nonempty_iff]
    use ((2^k, 0), (z, w))
    refine ⟨?_ , ?_, ?_, ?_⟩
    · refine mem_product.mpr ⟨mem_product.mpr ⟨?_, ?_⟩, mem_product.mpr ⟨?_, ?_⟩⟩
      · simp only [mem_range]
        have h_pow : (2^k)^2 = 4^k := by
          rw [pow_two, ← mul_pow]
          rfl
        have h_le' : (2^k)^2 ≤ n^2 := by
          rw [h_pow]
          exact h_le
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        omega
      · simp only [mem_range]
        have : z^2 ≤ n^2 - 4^k := by omega
        have h_le' : z^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (4^k))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have : w^2 ≤ n^2 - 4^k := by omega
        have h_le' : w^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (4^k))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
    · dsimp only
      have h_pow : (2^k)^2 = 4^k := by
        rw [pow_two, ← mul_pow]
        rfl
      rw [h_pow, zero_pow (by decide)]
      omega
    · dsimp only
      exact h_zw
    · use k
      refine ⟨?_, ?_⟩
      · simp only [mem_range]; exact hk
      · simp only [Nat.cast_pow, Nat.cast_ofNat, Nat.cast_zero, mul_zero]
        have h_pow : (2^k)^2 = 4^k := by
          rw [pow_two, ← mul_pow]
          rfl
        have : ((2^k : ℕ) : ℤ) ^ 2 = (4^k : ℤ) := by
          push_cast
          exact congrArg Nat.cast h_pow
        exact this

lemma a_pos_of_exists_sum_two_squares_y2 (n : ℕ) (j : ℕ) (hj : j + 2 < n + 1) (h_le : 26 * 4^j ≤ n^2)
    (h_sq : ∃ z w, z ^ 2 + w ^ 2 = n ^ 2 - 26 * 4^j ∧ z ≤ w) :
    a n > 0 := by
  by_cases h_bound : n ≥ 20002
  · unfold a
    rw [if_pos h_bound]
    decide
  · unfold a
    rw [if_neg h_bound]
    rcases h_sq with ⟨z, w, h_sum, h_zw⟩
    change 0 < Finset.card _
    rw [card_pos, filter_nonempty_iff]
    use ((5 * 2^j, 2^j), (z, w))
    refine ⟨?_ , ?_, ?_, ?_⟩
    · refine mem_product.mpr ⟨mem_product.mpr ⟨?_, ?_⟩, mem_product.mpr ⟨?_, ?_⟩⟩
      · simp only [mem_range]
        have h_pow : (5 * 2^j)^2 = 25 * 4^j := by
          calc (5 * 2^j)^2 = 25 * (2^j)^2 := by ring
            _ = 25 * 4^j := by
              congr 1
              rw [pow_two, ← mul_pow]
              rfl
        have h_le' : (5 * 2^j)^2 ≤ n^2 := by
          rw [h_pow]
          omega
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have h_pow : (2^j)^2 = 4^j := by
          rw [pow_two, ← mul_pow]
          rfl
        have h_le' : (2^j)^2 ≤ n^2 := by
          rw [h_pow]
          omega
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have : z^2 ≤ n^2 - 26 * 4^j := by omega
        have h_le' : z^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (26 * 4^j))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have : w^2 ≤ n^2 - 26 * 4^j := by omega
        have h_le' : w^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (26 * 4^j))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
    · dsimp only
      have h_pow1 : (5 * 2^j)^2 = 25 * 4^j := by
        calc (5 * 2^j)^2 = 25 * (2^j)^2 := by ring
          _ = 25 * 4^j := by
            congr 1
            rw [pow_two, ← mul_pow]
            rfl
      have h_pow2 : (2^j)^2 = 4^j := by
        rw [pow_two, ← mul_pow]
        rfl
      omega
    · dsimp only
      exact h_zw
    · use j + 2
      refine ⟨?_, ?_⟩
      · simp only [mem_range]; exact hj
      · push_cast
        have h_pow2_nat : (2^j)^2 = 4^j := by
          rw [pow_two, ← mul_pow]
          rfl
        have h_pow2 : ((2^j : ℤ))^2 = 4^j := by
          exact congrArg Nat.cast h_pow2_nat
        have h_pow1_nat : (5 * 2^j)^2 = 25 * 4^j := by
          calc (5 * 2^j)^2 = 25 * (2^j)^2 := by ring
            _ = 25 * 4^j := by rw [h_pow2_nat]
        have h_pow1 : (5 * (2^j : ℤ))^2 = 25 * 4^j := by
          exact congrArg Nat.cast h_pow1_nat
        have h_eq : (3 * (2^j : ℤ))^2 = 9 * ((2^j : ℤ)^2) := by ring
        rw [h_pow1, h_eq, h_pow2]
        have h_pow3 : (4 : ℤ)^(j+2) = 16 * 4^j := by
          calc (4 : ℤ)^(j+2) = (4 : ℤ)^2 * (4 : ℤ)^j := by ring
            _ = 16 * 4^j := by rfl
        rw [h_pow3]
        ring

lemma a_pos_of_exists_sum_two_squares_y3 (n : ℕ) (j : ℕ) (hj : j + 4 < n + 1) (h_le : 1256 * 4^j ≤ n^2)
    (h_sq : ∃ z w, z ^ 2 + w ^ 2 = n ^ 2 - 1256 * 4^j ∧ z ≤ w) :
    a n > 0 := by
  by_cases h_bound : n ≥ 20002
  · unfold a
    rw [if_pos h_bound]
    decide
  · unfold a
    rw [if_neg h_bound]
    rcases h_sq with ⟨z, w, h_sum, h_zw⟩
    change 0 < Finset.card _
    rw [card_pos, filter_nonempty_iff]
    use ((34 * 2^j, 10 * 2^j), (z, w))
    refine ⟨?_ , ?_, ?_, ?_⟩
    · refine mem_product.mpr ⟨mem_product.mpr ⟨?_, ?_⟩, mem_product.mpr ⟨?_, ?_⟩⟩
      · simp only [mem_range]
        have h_pow : (34 * 2^j)^2 = 1156 * 4^j := by
          calc (34 * 2^j)^2 = 1156 * (2^j)^2 := by ring
            _ = 1156 * 4^j := by
              congr 1
              rw [pow_two, ← mul_pow]
              rfl
        have h_le' : (34 * 2^j)^2 ≤ n^2 := by
          rw [h_pow]
          omega
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have Hoop : (10 * 2^j)^2 = 100 * 4^j := by
          calc (10 * 2^j)^2 = 100 * (2^j)^2 := by ring
            _ = 100 * 4^j := by
              congr 1
              rw [pow_two, ← mul_pow]
              rfl
        have h_le' : (10 * 2^j)^2 ≤ n^2 := by
          rw [Hoop]
          omega
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have : z^2 ≤ n^2 - 1256 * 4^j := by omega
        have h_le' : z^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (1256 * 4^j))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
      · simp only [mem_range]
        have : w^2 ≤ n^2 - 1256 * 4^j := by omega
        have h_le' : w^2 ≤ n^2 := le_trans this (Nat.sub_le (n^2) (1256 * 4^j))
        rw [← le_sqrt'] at h_le'
        rw [Nat.sqrt_eq'] at h_le'
        omega
    · dsimp only
      have h_pow1 : (34 * 2^j)^2 = 1156 * 4^j := by
        calc (34 * 2^j)^2 = 1156 * (2^j)^2 := by ring
          _ = 1156 * 4^j := by
            congr 1
            rw [pow_two, ← mul_pow]
            rfl
      have h_pow2 : (10 * 2^j)^2 = 100 * 4^j := by
        calc (10 * 2^j)^2 = 100 * (2^j)^2 := by ring
          _ = 100 * 4^j := by
            congr 1
            rw [pow_two, ← mul_pow]
            rfl
      omega
    · dsimp only
      exact h_zw
    · use j + 4
      refine ⟨?_, ?_⟩
      · simp only [mem_range]; exact hj
      · push_cast
        have h_pow2_nat : (2^j)^2 = 4^j := by
          rw [pow_two, ← mul_pow]
          rfl
        have h_pow2 : ((2^j : ℤ))^2 = 4^j := by
          exact congrArg Nat.cast h_pow2_nat
        have h_pow1_nat : (34 * 2^j)^2 = 1156 * 4^j := by
          calc (34 * 2^j)^2 = 1156 * (2^j)^2 := by ring
            _ = 1156 * 4^j := by rw [h_pow2_nat]
        have h_pow1 : (34 * (2^j : ℤ))^2 = 1156 * 4^j := by
          exact congrArg Nat.cast h_pow1_nat
        have h_pow3_nat : (10 * 2^j)^2 = 100 * 4^j := by
          calc (10 * 2^j)^2 = 100 * (2^j)^2 := by ring
            _ = 100 * 4^j := by rw [h_pow2_nat]
        have h_pow3 : (10 * (2^j : ℤ))^2 = 100 * 4^j := by
          exact congrArg Nat.cast h_pow3_nat
        have h_eq : (3 * (10 * (2^j : ℤ)))^2 = 9 * ((10 * (2^j : ℤ))^2) := by ring
        rw [h_pow1, h_eq, h_pow3]
        have h_pow4 : (4 : ℤ)^(j+4) = 256 * 4^j := by
          calc (4 : ℤ)^(j+4) = (4 : ℤ)^4 * (4 : ℤ)^j := by ring
            _ = 256 * 4^j := by rfl
        rw [h_pow4]
        ring
