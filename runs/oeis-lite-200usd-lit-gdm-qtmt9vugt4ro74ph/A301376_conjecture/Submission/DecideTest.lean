def get_witness (m : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  if m - 1 ≤ 5999 then if m - 1 ≤ 3999 then if m - 1 ≤ 1999 then chunk_0.getD (m - 1 - 0) (0, 0, 0, 0) else chunk_1.getD (m - 1 - 2000) (0, 0, 0, 0) else chunk_2.getD (m - 1 - 4000) (0, 0, 0, 0) else if m - 1 ≤ 7999 then chunk_3.getD (m - 1 - 6000) (0, 0, 0, 0) else chunk_4.getD (m - 1 - 8000) (0, 0, 0, 0)

def correctness (m : ℕ) (family j z w : ℕ) : Prop :=
  let n := 2 * m + 1
  if family = 0 then
    4^j = n^2 - (z^2 + w^2) ∧ z ≤ w ∧ j < n + 1 ∧ 4^j ≤ n^2
  else if family = 1 then
    26 * 4^j = n^2 - (z^2 + w^2) ∧ z ≤ w ∧ j + 2 < n + 1 ∧ 26 * 4^j ≤ n^2
  else
    1256 * 4^j = n^2 - (z^2 + w^2) ∧ z ≤ w ∧ j + 4 < n + 1 ∧ 1256 * 4^j ≤ n^2

instance (m family j z w : ℕ) : Decidable (correctness m family j z w) := by
  unfold correctness
  split_ifs <;> exact instDecidableAnd

theorem witnesses_correct_0 : ∀ m ∈ Finset.range 2001, m ≥ 1 → (let w := get_witness m; correctness m w.1 w.2.1 w.2.2.1 w.2.2.2) := by
  decide

