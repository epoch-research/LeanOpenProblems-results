def check_correctness (start count : Nat) : Bool :=
  match count with
  | 0 => true
  | c + 1 =>
    let m := start
    let w := get_witness_tree m
    let n := 2 * m + 1
    let n2 := n * n
    let cond :=
      if w.1 == 0 then
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        let p := 1 <<< (2 * j)
        (p == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j < n + 1) && (p <= n2)
      else if w.1 == 1 then
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        let p := 26 * (1 <<< (2 * j))
        (p == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j + 2 < n + 1) && (p <= n2)
      else
        let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
        let p := 1256 * (1 <<< (2 * j))
        (p == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j + 4 < n + 1) && (p <= n2)
    cond && check_correctness (start + 1) c

