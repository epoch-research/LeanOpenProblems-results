theorem A301376_conjecture : ∀ (n : ℕ), n > 0 → a n > 0 := by
  intro n
  induction' n using Nat.strong_induction_on with n ih
  intro hn
  by_cases h_bound : n ≥ 20002
  · unfold a
    rw [if_pos h_bound]
    decide
  · by_cases h_even : Even n
    · rcases h_even with ⟨m, rfl⟩
      have hm : m > 0 := by omega
      have h_am : a m > 0 := ih m (by omega) hm
      have h_eq : m + m = 2 * m := by ring
      rw [h_eq]
      change 0 < a (2 * m)
      unfold a
      have h_2m_lt : ¬ 2 * m ≥ 20002 := by omega
      rw [if_neg h_2m_lt]
      rw [card_pos, filter_nonempty_iff]
      dsimp only
      have h_am_unfolded : ∃ a ∈ ((Finset.range (m + 1)).product (Finset.range (m + 1))).product ((Finset.range (m + 1)).product (Finset.range (m + 1))),
          a.1.1 ^ 2 + a.1.2 ^ 2 + a.2.1 ^ 2 + a.2.2 ^ 2 = m ^ 2 ∧
          a.2.1 ≤ a.2.2 ∧ ∃ k ∈ Finset.range (m + 1), (a.1.1 ^ 2 : ℤ) - (3 * a.1.2 : ℤ) ^ 2 = 4 ^ k := by
        have h_temp : 0 < a m := h_am
        unfold a at h_temp
        have h_m_lt' : ¬ m ≥ 20002 := by omega
        rw [if_neg h_m_lt'] at h_temp
        rw [card_pos, filter_nonempty_iff] at h_temp
        exact h_temp
      exact step_even m hm h_am_unfolded
    · rcases Nat.even_or_odd n with h_even' | h_odd
      · contradiction
      · rcases h_odd with ⟨m, rfl⟩
        by_cases h_m_lt : m < 10001
        · by_cases hm1 : m > 0
          · by_cases hc0 : m ≤ 500
            · have h_corr_tree := correctness_of_check_correctness 0 500 get_witness_tree_0 witnesses_correct_0 m (by omega) (by omega)
