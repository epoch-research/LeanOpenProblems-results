def correctness (m : ℕ) (family j z w : ℕ) : Prop :=
  let n := 2 * m + 1
  if family = 0 then
    4^j = n^2 - (z^2 + w^2) ∧ z ≤ w ∧ j < n + 1 ∧ 4^j ≤ n^2
  else if family = 1 then
    26 * 4^j = n^2 - (z^2 + w^2) ∧ z ≤ w ∧ j + 2 < n + 1 ∧ 26 * 4^j ≤ n^2
  else
    1256 * 4^j = n^2 - (z^2 + w^2) ∧ z ≤ w ∧ j + 4 < n + 1 ∧ 1256 * 4^j ≤ n^2

instance (m family j z w : ℕ) : Decidable (correctness m family j z w) := by
  unfold correctness
  split_ifs <;> exact instDecidableAnd

def correctness_eval (m : ℕ) (w : ℕ × ℕ × ℕ × ℕ) : Bool :=
  let n := 2 * m + 1
  let n2 := n * n
  if w.1 == 0 then
    let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
    let p := 1 <<< (2 * j)
    (p == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j < n + 1) && (p <= n2)
  else if w.1 == 1 then
    let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
    let p := 26 * (1 <<< (2 * j))
    (p == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j + 2 < n + 1) && (p <= n2)
  else
    let j := w.2.1; let z := w.2.2.1; let w_val := w.2.2.2
    let p := 1256 * (1 <<< (2 * j))
    (p == n2 - (z * z + w_val * w_val)) && (z <= w_val) && (j + 4 < n + 1) && (p <= n2)

lemma shiftLeft_two_pow (j : ℕ) : 1 <<< (2 * j) = 4 ^ j := by
  rw [Nat.shiftLeft_eq_mul_pow, one_mul]
  have : 2 ^ (2 * j) = (2 ^ 2) ^ j := by rw [pow_mul]
  rw [this]
  rfl

lemma correctness_of_eval (m : ℕ) (w : ℕ × ℕ × ℕ × ℕ) (h : correctness_eval m w = true) :
    correctness m w.1 w.2.1 w.2.2.1 w.2.2.2 := by
  unfold correctness correctness_eval at *
  rcases w with ⟨family, j, z, w_val⟩
  dsimp only at *
  split_ifs at h with h_fam1 h_fam2
  · simp only [Bool.and_eq_true, decide_eq_true_iff] at h
    rcases h with ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩
    rw [beq_iff_eq] at h1
    rw [shiftLeft_two_pow] at h1 h4
    have h_sq1 : z * z + w_val * w_val = z^2 + w_val^2 := by ring
    have h_sq2 : (2 * m + 1) * (2 * m + 1) = (2 * m + 1)^2 := by ring
    rw [h_sq1, h_sq2] at h1
    rw [h_sq2] at h4
    refine ⟨h1, h2, h3, h4⟩
  · simp only [Bool.and_eq_true, decide_eq_true_iff] at h
    rcases h with ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩
    rw [beq_iff_eq] at h1
    have h_p : 26 * (1 <<< (2 * j)) = 26 * 4^j := by rw [shiftLeft_two_pow]
    rw [h_p] at h1 h4
    have h_sq1 : z * z + w_val * w_val = z^2 + w_val^2 := by ring
    have h_sq2 : (2 * m + 1) * (2 * m + 1) = (2 * m + 1)^2 := by ring
    rw [h_sq1, h_sq2] at h1
    rw [h_sq2] at h4
    refine ⟨h1, h2, h3, h4⟩
  · simp only [Bool.and_eq_true, decide_eq_true_iff] at h
    rcases h with ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩
    rw [beq_iff_eq] at h1
    have h_p : 1256 * (1 <<< (2 * j)) = 1256 * 4^j := by rw [shiftLeft_two_pow]
    rw [h_p] at h1 h4
    have h_sq1 : z * z + w_val * w_val = z^2 + w_val^2 := by ring
    have h_sq2 : (2 * m + 1) * (2 * m + 1) = (2 * m + 1)^2 := by ring
    rw [h_sq1, h_sq2] at h1
    rw [h_sq2] at h4
    refine ⟨h1, h2, h3, h4⟩

def check_correctness (offset : Nat) (count : Nat) (get_wit : Nat → Nat × Nat × Nat × Nat) : Bool :=
  match count with
  | 0 => true
  | c + 1 =>
    let m := offset + c + 1
    let w := get_wit (c + 1)
    correctness_eval m w && check_correctness offset c get_wit

lemma correctness_of_check_correctness (offset : Nat) (count : Nat) (get_wit : Nat → Nat × Nat × Nat × Nat)
    (h_check : check_correctness offset count get_wit = true) :
    ∀ m, offset < m → m ≤ offset + count → correctness m (get_wit (m - offset)).1 (get_wit (m - offset)).2.1 (get_wit (m - offset)).2.2.1 (get_wit (m - offset)).2.2.2 := by
  induction' count with c ih
  · intro m h_gt h_le
    omega
  · simp only [check_correctness, Bool.and_eq_true] at h_check
    rcases h_check with ⟨h_eval, h_sub⟩
    intro m h_gt h_le
    have h_cases : m ≤ offset + c ∨ m = offset + c + 1 := by omega
    rcases h_cases with h_case1 | h_case2
    · exact ih h_sub m h_gt h_case1
    · subst h_case2
      have h_sub_eq : offset + c + 1 - offset = c + 1 := by omega
      rw [h_sub_eq]
      exact correctness_of_eval (offset + c + 1) (get_wit (c + 1)) h_eval

lemma a_pos_from_correct (m : ℕ) (family j z w : ℕ) (h : correctness m family j z w) : a (2 * m + 1) > 0 := by
  unfold correctness at h
  split_ifs at h with h_fam1 h_fam2
  · rcases h with ⟨h_sum, h_le, h_lt, h_pow⟩
    have h_sq : ∃ z w, z^2 + w^2 = (2 * m + 1)^2 - 4^j ∧ z ≤ w := by
      use z, w
      refine ⟨?_, h_le⟩
      have h_pos : 4^j > 0 := by positivity
      generalize (2 * m + 1)^2 = N at h_sum h_pow ⊢
      generalize 4^j = P at h_sum h_pow h_pos ⊢
      generalize z^2 = Z at h_sum ⊢
      generalize w^2 = W at h_sum ⊢
      omega
    exact a_pos_of_exists_sum_two_squares (2 * m + 1) j h_lt h_pow h_sq
  · rcases h with ⟨h_sum, h_le, h_lt, h_pow⟩
    have h_sq : ∃ z w, z^2 + w^2 = (2 * m + 1)^2 - 26 * 4^j ∧ z ≤ w := by
      use z, w
      refine ⟨?_, h_le⟩
      have h_pos : 26 * 4^j > 0 := by positivity
      generalize (2 * m + 1)^2 = N at h_sum h_pow ⊢
      generalize 26 * 4^j = P at h_sum h_pow h_pos ⊢
      generalize z^2 = Z at h_sum ⊢
      generalize w^2 = W at h_sum ⊢
      omega
    exact a_pos_of_exists_sum_two_squares_y2 (2 * m + 1) j h_lt h_pow h_sq
  · rcases h with ⟨h_sum, h_le, h_lt, h_pow⟩
    have h_sq : ∃ z w, z^2 + w^2 = (2 * m + 1)^2 - 1256 * 4^j ∧ z ≤ w := by
      use z, w
      refine ⟨?_, h_le⟩
      have h_pos : 1256 * 4^j > 0 := by positivity
      generalize (2 * m + 1)^2 = N at h_sum h_pow ⊢
      generalize 1256 * 4^j = P at h_sum h_pow h_pos ⊢
      generalize z^2 = Z at h_sum ⊢
      generalize w^2 = W at h_sum ⊢
      omega
    have h_eq_314 : 314 * 4^(j+1) = 1256 * 4^j := by ring
    have h_pow' : 314 * 4^(j+1) ≤ (2 * m + 1)^2 := by
      rw [h_eq_314]
      exact h_pow
    have h_sq' : ∃ z w, z^2 + w^2 = (2 * m + 1)^2 - 314 * 4^(j+1) ∧ z ≤ w := by
      rw [h_eq_314]
      exact h_sq
    exact a_pos_of_exists_sum_two_squares_y3 (2 * m + 1) j h_lt h_pow' h_sq'

