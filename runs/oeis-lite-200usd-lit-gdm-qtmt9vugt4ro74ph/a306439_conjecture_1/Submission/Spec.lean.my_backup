import FormalConjectures.Util.ProblemImports

open Nat Finset Set

/--
The generalized pentagonal number (3k+1)/2$ for  \ge 0$.
-/
noncomputable def P3 (k : ℕ) : ℕ := k * (3 * k + 1) / 2

/--
A306439: Number of ways to write $ as (3x+1)/2 + y(3y+1)/2 + z(3z+1) + 3w(3w+1)/2$,
where ,y,z,w$ are nonnegative integers with  \le y$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  let B := n + 1
  let RangeB := range B

  -- The domain of search is (RangeB x RangeB) x (RangeB x RangeB).
  let search_space : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
    (RangeB.product RangeB).product (RangeB.product RangeB)

  (search_space.filter (fun p =>
    let x := p.fst.fst
    let y := p.fst.snd
    let z := p.snd.fst
    let w := p.snd.snd
    -- The equation is P3(x) + P3(y) + 2*P3(z) + 3*P3(w) = n.
    x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w
  )).card

lemma P3_mono {a b : ℕ} (h : a ≤ b) : P3 a ≤ P3 b := by
  unfold P3
  apply Nat.div_le_div_right
  apply Nat.mul_le_mul h
  omega

lemma a_eq_card_filter_small {n X Y Z W : ℕ}
  (hX_le : X ≤ n + 1) (hY_le : Y ≤ n + 1) (hZ_le : Z ≤ n + 1) (hW_le : W ≤ n + 1)
  (hX : P3 X > n) (hY : P3 Y > n) (hZ : 2 * P3 Z > n) (hW : 3 * P3 W > n) :
  let small_space : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
    ((Finset.range X).product (Finset.range Y)).product ((Finset.range Z).product (Finset.range W))
  a n = (small_space.filter (fun p =>
    let x := p.fst.fst
    let y := p.fst.snd
    let z := p.snd.fst
    let w := p.snd.snd
    x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w
  )).card := by
  intro small_space
  unfold a
  change
    (Finset.filter (fun (p : (ℕ × ℕ) × (ℕ × ℕ)) =>
      let x := p.fst.fst
      let y := p.fst.snd
      let z := p.snd.fst
      let w := p.snd.snd
      x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w
    ) (((Finset.range (n+1) ×ˢ Finset.range (n+1)) ×ˢ (Finset.range (n+1) ×ˢ Finset.range (n+1))))).card =
    (Finset.filter (fun (p : (ℕ × ℕ) × (ℕ × ℕ)) =>
      let x := p.fst.fst
      let y := p.fst.snd
      let z := p.snd.fst
      let w := p.snd.snd
      x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w
    ) (((Finset.range X ×ˢ Finset.range Y) ×ˢ (Finset.range Z ×ˢ Finset.range W)))).card
  apply congrArg Finset.card
  ext p
  rcases p with ⟨⟨x, y⟩, ⟨z, w⟩⟩
  simp only [mem_filter, Finset.mem_product, Finset.mem_range]
  constructor
  · rintro ⟨⟨⟨hx, hy⟩, ⟨hz, hw⟩⟩, h_xy, h_eq⟩
    refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, h_xy, h_eq⟩
    · by_contra! h
      have h1 : P3 X ≤ P3 x := P3_mono h
      have h2 : P3 x ≤ n := by omega
      omega
    · by_contra! h
      have h1 : P3 Y ≤ P3 y := P3_mono h
      have h2 : P3 y ≤ n := by omega
      omega
    · by_contra! h
      have h1 : P3 Z ≤ P3 z := P3_mono h
      have h2 : 2 * P3 Z ≤ 2 * P3 z := by omega
      have h3 : 2 * P3 z ≤ n := by omega
      omega
    · by_contra! h
      have h1 : P3 W ≤ P3 w := P3_mono h
      have h2 : 3 * P3 W ≤ 3 * P3 w := by omega
      have h3 : 3 * P3 w ≤ n := by omega
      omega
  · rintro ⟨⟨⟨hx, hy⟩, ⟨hz, hw⟩⟩, h_xy, h_eq⟩
    refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, h_xy, h_eq⟩
    · omega
    · omega
    · omega
    · omega

/--
OEIS A306439 Conjecture 1: a(n) > 0 for all n > 5, and a(n) = 1 only for n = 0, 2, 7, 9, 11, 12, 16, 31, 33, 41.
-/
theorem a306439_conjecture_1 :
  (∀ n, 5 < n → a n > 0) ∧
  (∀ n, a n = 1 ↔ n ∈ ({0, 2, 7, 9, 11, 12, 16, 31, 33, 41} : Set ℕ))
:= by
  constructor
  · intro n hn
    by_cases h41 : n ≤ 41
    · interval_cases n
      · rw [a_eq_card_filter_small (by omega : 2 ≤ 6 + 1) (by omega : 2 ≤ 6 + 1) (by omega : 2 ≤ 6 + 1) (by omega : 2 ≤ 6 + 1) (by decide : P3 2 > 6) (by decide : P3 2 > 6) (by decide : 2 * P3 2 > 6) (by decide : 3 * P3 2 > 6)]
        decide
      · rw [a_eq_card_filter_small (by omega : 3 ≤ 7 + 1) (by omega : 3 ≤ 7 + 1) (by omega : 2 ≤ 7 + 1) (by omega : 2 ≤ 7 + 1) (by decide : P3 3 > 7) (by decide : P3 3 > 7) (by decide : 2 * P3 2 > 7) (by decide : 3 * P3 2 > 7)]
        decide
