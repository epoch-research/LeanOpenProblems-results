theorem bounds_of_le (a b : ℕ) (h : 2 ^ a * 3 ^ b ≤ 299889760893881640982) : a < 69 ∧ b < 44 := by
  have ha : a < 69 := by
    by_contra! h_gt
    have h2 : 2 ^ 69 ≤ 2 ^ a * 3 ^ b := by
      have : 2 ^ 69 ≤ 2 ^ a := Nat.pow_le_pow_right (by omega) h_gt
      calc 2 ^ 69 ≤ 2 ^ a := this
      _ ≤ 2 ^ a * 3 ^ b := Nat.le_mul_of_pos_right _ (by positivity)
    omega
  have hb : b < 44 := by
    by_contra! h_gt
    have h3 : 3 ^ 44 ≤ 2 ^ a * 3 ^ b := by
      have : 3 ^ 44 ≤ 3 ^ b := Nat.pow_le_pow_right (by omega) h_gt
      calc 3 ^ 44 ≤ 3 ^ b := this
      _ ≤ 2 ^ a * 3 ^ b := Nat.le_mul_of_pos_left _ (by positivity)
    omega
  exact ⟨ha, hb⟩

theorem bounds_of_lt (a b : ℕ) (h : 2 ^ a * 3 ^ b < 299889760893881640982) : a < 69 ∧ b < 44 := by
  have : 2 ^ a * 3 ^ b ≤ 299889760893881640982 := by omega
  exact bounds_of_le a b this

theorem factor_p1_all : ∀ a < 69, ∀ b < 44,
  2^a * 3^b ≤ 299889760893881640982 →
    let val := 6 * (299889760893881640982 - 2 ^ a * 3 ^ b) + 1
    let f := factor_p1 a b
    f ∣ val ∧ 2 ≤ f ∧ f < val := by decide

theorem factor_p2_all : ∀ a < 69, ∀ b < 44,
  2^a * 3^b < 299889760893881640982 →
    let val := 6 * (299889760893881640982 - 2 ^ a * 3 ^ b) - 1
    let f := factor_p2 a b
    f ∣ val ∧ 2 ≤ f ∧ f < val := by decide

theorem oeis_308950_conjecture.disproof :
  ¬ (∀ n : ℕ, 1 < n →
    (∃ (a b : ℕ),
        2 ^ a * 3 ^ b ≤ n ∧ Nat.Prime (6 * (n - 2 ^ a * 3 ^ b) + 1)
    )
    ∨
    (∃ (a b : ℕ),
        2 ^ a * 3 ^ b < n ∧ Nat.Prime (6 * (n - 2 ^ a * 3 ^ b) - 1)
    )) := by
  intro h
  have h_contra := h 299889760893881640982 (by decide)
  rcases h_contra with ⟨a, b, h_le, h_prime⟩ | ⟨a, b, h_lt, h_prime⟩
  · have ⟨ha, hb⟩ := bounds_of_le a b h_le
    have h_div := factor_p1_all a ha b hb h_le
    have h_composite : ¬ Nat.Prime (6 * (299889760893881640982 - 2 ^ a * 3 ^ b) + 1) := by
      let val := 6 * (299889760893881640982 - 2 ^ a * 3 ^ b) + 1
      let f := factor_p1 a b
      have h_f : f ∣ val := h_div.1
      have h2 : 2 ≤ f := h_div.2.1
      have h3 : f < val := h_div.2.2
      have h_eq : val = f * (val / f) := (Nat.mul_div_cancel' h_f).symm
      have h4 : 2 ≤ val / f := div_ge_two_of_dvd_of_lt val f h_f h2 h3
      exact composite_of_factor val f (val / f) h_eq h2 h4
    exact h_composite h_prime
  · have ⟨ha, hb⟩ := bounds_of_lt a b h_lt
    have h_div := factor_p2_all a ha b hb h_lt
    have h_composite : ¬ Nat.Prime (6 * (299889760893881640982 - 2 ^ a * 3 ^ b) - 1) := by
      let val := 6 * (299889760893881640982 - 2 ^ a * 3 ^ b) - 1
      let f := factor_p2 a b
      have h_f : f ∣ val := h_div.1
      have h2 : 2 ≤ f := h_div.2.1
      have h3 : f < val := h_div.2.2
      have h_eq : val = f * (val / f) := (Nat.mul_div_cancel' h_f).symm
      have h4 : 2 ≤ val / f := div_ge_two_of_dvd_of_lt val f h_f h2 h3
      exact composite_of_factor val f (val / f) h_eq h2 h4
    exact h_composite h_prime

