import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A308950: Number of ways to write $n$ as $(p-1)/6 + 2^a 3^b$, where $p$ is a prime, and $a$ and $b$ are nonnegative integers.
$a(n)$ is the number of pairs $(a, b) \in \mathbb{N}^2$ such that $2^a 3^b \le n$ and $6(n - 2^a 3^b) + 1$ is prime.
-/
noncomputable def A308950 (n : ℕ) : ℕ :=
  Finset.card $
    (Finset.range (n + 1)).product (Finset.range (n + 1)) |>.filter
    (fun p_ab =>
      let a := p_ab.fst
      let b := p_ab.snd
      let m := 2 ^ a * 3 ^ b
      m ≤ n ∧
      Nat.Prime (6 * (n - m) + 1)
    )

theorem composite_of_factor (n a b : ℕ) (h : n = a * b) (ha : 2 ≤ a) (hb : 2 ≤ b) : ¬ Nat.Prime n := by
  intro hp
  have h_div : a ∣ n := by
    use b
  have h_eq := hp.eq_one_or_self_of_dvd a h_div
  rcases b with _ | _ | c
  · omega
  · omega
  · -- b = c + 2
    have : a < a * (c + 2) := by
      have h_mul : a * (c + 2) = a * c + a + a := by ring
      rw [h_mul]
      omega
    subst h
    rcases h_eq with h_eq | h_eq
    · omega
    · rw [← h_eq] at this
      omega

theorem div_ge_two_of_dvd_of_lt (val f : ℕ) (h_f : f ∣ val) (h2 : 2 ≤ f) (h3 : f < val) : 2 ≤ val / f := by
  by_contra! h
  have h_eq : val = f * (val / f) := (Nat.mul_div_cancel' h_f).symm
  interval_cases val / f
  · rw [h_eq] at h3
    omega
  · rw [h_eq] at h3
    omega

