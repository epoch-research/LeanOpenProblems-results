  have hk2 : k ≤ 16331503 := hk_icc.2
  have h_neq := no_sol_13573 k hk1 hk2
  exact h_neq hk_eq

theorem A232616_ge : 16331504 ≤ A232616 550172 := by
  unfold A232616
  have h_ne : 550172 ≠ 0 := by decide
  rw [dif_neg h_ne]
