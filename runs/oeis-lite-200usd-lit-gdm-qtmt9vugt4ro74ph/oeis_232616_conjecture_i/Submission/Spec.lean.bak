theorem k_cond (k : ℕ) (hk1 : 1 ≤ k) (h : ((2^k - k : ℕ) : ZMod 550172) = 13573) :
    k % 588 = 183 ∨ k % 588 = 415 ∨ k % 588 = 431 :=
