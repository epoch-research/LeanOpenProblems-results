  rw [h_val] at h_eq
  have h_cast : ((2^k - k : ℕ) : ZMod 4) = ((550172 * ((2^k - k) / 550172) + 13573 : ℕ) : ZMod 4) := by nth_rw 1 [h_eq]
  rw [h_cast]
