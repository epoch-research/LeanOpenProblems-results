def verify_linear_aux (c : ZMod 550172) (val_j : ZMod 550172) : ℕ → Bool
  | 0 => true
  | count + 1 =>
    if (val_j * (2 : ZMod 550172) ^ 183 - (c + 183 : ZMod 550172) != 13573) &&
       (val_j * (2 : ZMod 550172) ^ 415 - (c + 415 : ZMod 550172) != 13573) &&
       (val_j * (2 : ZMod 550172) ^ 431 - (c + 431 : ZMod 550172) != 13573) then
      verify_linear_aux (c + 588) (val_j * 433896) count
    else
      false

theorem verify_linear_aux_spec (count : ℕ) (j : ℕ) (c : ZMod 550172) (val_j : ZMod 550172)
    (h_c : c = ((588 * j : ℕ) : ZMod 550172))
    (h_val : val_j = (433896 : ZMod 550172) ^ j)
    (h : verify_linear_aux c val_j count = true) :
    ∀ k < count, check_j_fast (j + k) = true := by
  induction count generalizing j c val_j with
  | zero =>
    intro k hk
    omega
  | succ count ih =>
    intro k hk
    unfold verify_linear_aux at h
    have h_cond : (val_j * (2 : ZMod 550172) ^ 183 - (c + 183 : ZMod 550172) != 13573) &&
                  (val_j * (2 : ZMod 550172) ^ 415 - (c + 415 : ZMod 550172) != 13573) &&
                  (val_j * (2 : ZMod 550172) ^ 431 - (c + 431 : ZMod 550172) != 13573) = true := by
      split at h
      · simp at *
        assumption
      · contradiction
    have h_next : verify_linear_aux (c + 588) (val_j * 433896) count = true := by
      split at h
      · exact h
      · contradiction
    rcases k with _ | k'
    · simp only [add_zero]
      unfold check_j_fast
      simp at h_cond
      simp
      rw [← h_val]
      have h_c_eq1 : (c + 183 : ZMod 550172) = ((588 * j + 183 : ℕ) : ZMod 550172) := by
        rw [h_c]
        push_cast
        rfl
      have h_c_eq2 : (c + 415 : ZMod 550172) = ((588 * j + 415 : ℕ) : ZMod 550172) := by
        rw [h_c]
        push_cast
        rfl
      have h_c_eq3 : (c + 431 : ZMod 550172) = ((588 * j + 431 : ℕ) : ZMod 550172) := by
        rw [h_c]
        push_cast
        rfl
      rw [h_c_eq1, h_c_eq2, h_c_eq3] at h_cond
      push_cast at h_cond
      exact h_cond
    · have hk_lt : k' < count := by omega
      have h_val_next : val_j * 433896 = (433896 : ZMod 550172) ^ (j + 1) := by
        rw [h_val, pow_succ]
      have h_c_next : c + 588 = ((588 * (j + 1) : ℕ) : ZMod 550172) := by
        rw [h_c]
        push_cast
        ring_nf
      have ih_res := ih (j + 1) (c + 588) (val_j * 433896) h_c_next h_val_next h_next k' hk_lt
      have h_eq : j + 1 + k' = j + Nat.succ k' := by omega
      rwa [h_eq] at ih_res

