def witness_coprime (n : Nat) : Nat :=
  if n < 2500 then witness_coprime_0 n
  else if n < 5000 then witness_coprime_1 n
  else if n < 7500 then witness_coprime_2 n
  else witness_coprime_3 n

def check_digits_01_fuel : Nat → Nat → Bool
  | 0, _ => false
  | fuel + 1, n =>
    if n == 0 then true
    else if n % 10 == 0 || n % 10 == 1 then check_digits_01_fuel fuel (n / 10)
    else false

def verify_witness_coprime (n : Nat) : Bool :=
  let w := witness_coprime n
  (0 < w) && (w % n == 0) && check_digits_01_fuel 30 w && (w < (10^29 - 1) / 9)

def check_range_coprime (start : Nat) (count : Nat) : Bool :=
  match count with
  | 0 => true
  | c + 1 =>
    if start % 10 == 1 || start % 10 == 3 || start % 10 == 7 || start % 10 == 9 then
      verify_witness_coprime start && check_range_coprime (start + 1) c
    else
      check_range_coprime (start + 1) c

theorem test_range_coprime_17_9998 : check_range_coprime 17 9982 = true := by decide
