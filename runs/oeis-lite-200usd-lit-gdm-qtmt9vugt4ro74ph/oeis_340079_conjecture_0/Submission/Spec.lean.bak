import FormalConjectures.Util.ProblemImports

set_option maxHeartbeats 0

open Nat BigOperators Finset

/--
A340079: $a(n) = n / \gcd(n, 1+A018804(n))$, where $A018804(n) = \sum_{k=1..n} \gcd(k, n)$.
$$a(n) = \frac{n}{\gcd(n, 1+\sum_{k=1}^n \gcd(k, n))}$$
-/
def a (n : ℕ) : ℕ :=
  let A018804_n : ℕ := (Finset.Ico 1 (n + 1)).sum fun k => Nat.gcd k n
  n / Nat.gcd n (1 + A018804_n)

def A018804 (n : ℕ) : ℕ :=
  (Finset.Ico 1 (n + 1)).sum fun k => Nat.gcd k n

theorem A018804_prime {p : ℕ} (hp : Nat.Prime p) : A018804 p = 2 * p - 1 := by
  dsimp [A018804]
  have h1 : 1 ≤ p := by
    have := hp.two_le
    omega
  rw [sum_Ico_succ_top h1]
  have h_gcd : ∀ k ∈ Finset.Ico 1 p, Nat.gcd k p = 1 := by
    intro k hk
    rw [mem_Ico] at hk
    have h_not_dvd : ¬ p ∣ k := by
      intro hd
      have h_le := Nat.le_of_dvd (by omega) hd
      omega
    have h_cop := hp.coprime_iff_not_dvd.mpr h_not_dvd
    rw [Nat.gcd_comm]
    exact h_cop
  have h_sum_ones : (Finset.Ico 1 p).sum (fun k => Nat.gcd k p) = (Finset.Ico 1 p).sum (fun k => 1) := by
    apply Finset.sum_congr rfl
    exact h_gcd
  rw [h_sum_ones]
  rw [sum_const, smul_eq_mul, mul_one, card_Ico]
  have h_gcd_p_p : Nat.gcd p p = p := Nat.gcd_self p
  rw [h_gcd_p_p]
  omega

theorem a_one : a 1 = 1 := by
  rfl

theorem a_prime {p : ℕ} (hp : Nat.Prime p) : a p = 1 := by
  change p / Nat.gcd p (1 + A018804 p) = 1
  have h_A : A018804 p = 2 * p - 1 := A018804_prime hp
  rw [h_A]
  have h_gcd : Nat.gcd p (1 + (2 * p - 1)) = p := by
    have hp2 := hp.two_le
    have h_eq : 1 + (2 * p - 1) = 2 * p := by omega
    rw [h_eq]
    exact Nat.gcd_mul_left_right 2 p
  rw [h_gcd]
  have hp_pos : 0 < p := by
    have hp2 := hp.two_le
    omega
  exact Nat.div_self hp_pos

theorem a_ne_one_of_not_dvd {n : ℕ} {p : ℕ} (hp : p ∣ n) (h_not : ¬ p ∣ 1 + A018804 n) : a n ≠ 1 := by
  intro ha
  change n / Nat.gcd n (1 + A018804 n) = 1 at ha
  have h_gcd : Nat.gcd n (1 + A018804 n) = n := by
    have h_div : Nat.gcd n (1 + A018804 n) ∣ n := Nat.gcd_dvd_left n _
    have h_eq : n = Nat.gcd n (1 + A018804 n) * (n / Nat.gcd n (1 + A018804 n)) := (Nat.mul_div_cancel' h_div).symm
    rw [ha] at h_eq
    rw [mul_one] at h_eq
    exact h_eq.symm
  have h_dvd : p ∣ Nat.gcd n (1 + A018804 n) := by
    rw [h_gcd]
    exact hp
  have h_dvd2 : p ∣ 1 + A018804 n := (Nat.dvd_gcd_iff.mp h_dvd).right
  exact h_not h_dvd2

theorem sum_gcd_range_eq_totient_sum {n : ℕ} (hn : 0 < n) :
    (Finset.range n).sum (fun k => Nat.gcd k n) = n.divisors.sum (fun d => d * (n / d).totient) := by
  have H : ∀ i ∈ Finset.range n, Nat.gcd i n ∈ n.divisors := by
    intro i _
    rw [mem_divisors]
    refine ⟨Nat.gcd_dvd_right i n, by omega⟩
  have h_fiber := sum_fiberwise_of_maps_to (g := fun k => Nat.gcd k n) H (fun k => Nat.gcd k n)
  have h_LHS : ∑ d ∈ n.divisors, ∑ i ∈ Finset.filter (fun i => Nat.gcd i n = d) (Finset.range n), d =
               ∑ d ∈ n.divisors, ∑ i ∈ Finset.filter (fun i => Nat.gcd i n = d) (Finset.range n), Nat.gcd i n := by
    apply Finset.sum_congr rfl
    intro d hd
    apply Finset.sum_congr rfl
    intro i hi
    rw [mem_filter] at hi
    rw [hi.right]
  have h_inner : ∀ d ∈ n.divisors, ∑ i ∈ Finset.filter (fun i => Nat.gcd i n = d) (Finset.range n), d = d * (n / d).totient := by
    intro d hd
    rw [mem_divisors] at hd
    rw [sum_const, smul_eq_mul, mul_comm]
    have h_tot : (n / d).totient = (Finset.filter (fun i => Nat.gcd i n = d) (Finset.range n)).card := by
      have h_comm : Finset.filter (fun i => Nat.gcd i n = d) (Finset.range n) = Finset.filter (fun i => Nat.gcd n i = d) (Finset.range n) := by
        apply Finset.filter_congr
        intro i hi
        simp only [Nat.gcd_comm]
      rw [h_comm]
      exact totient_div_of_dvd hd.left
    rw [← h_tot]
  rw [← h_fiber]
  rw [← h_LHS]
  apply Finset.sum_congr rfl
  exact h_inner

theorem sum_gcd_range_eq_Ico {n : ℕ} (hn : 0 < n) :
    (Finset.Ico 1 (n + 1)).sum (fun k => Nat.gcd k n) = (Finset.range n).sum (fun k => Nat.gcd k n) := by
  rw [range_eq_Ico]
  rw [Finset.sum_eq_sum_Ico_succ_bot hn]
  have h_zero_add : 0 + 1 = 1 := rfl
  rw [h_zero_add]
  have h1 : 1 ≤ n := hn
  rw [sum_Ico_succ_top h1]
  have h_gcd_n_n : Nat.gcd n n = n := Nat.gcd_self n
  have h_gcd_0_n : Nat.gcd 0 n = n := Nat.gcd_zero_left n
  rw [h_gcd_n_n, h_gcd_0_n]
  omega

theorem A018804_eq_totient_sum {n : ℕ} (hn : 0 < n) :
    A018804 n = n.divisors.sum (fun d => d * (n / d).totient) := by
  change (Finset.Ico 1 (n + 1)).sum (fun k => Nat.gcd k n) = n.divisors.sum (fun d => d * (n / d).totient)
  rw [sum_gcd_range_eq_Ico hn]
  exact sum_gcd_range_eq_totient_sum hn



lemma n_dvd_1_add_A018804 {n : ℕ} (ha : a n = 1) : n ∣ 1 + A018804 n := by
  have h_gcd : Nat.gcd n (1 + A018804 n) = n := by
    have h_div : Nat.gcd n (1 + A018804 n) ∣ n := Nat.gcd_dvd_left n _
    have h_eq : n = Nat.gcd n (1 + A018804 n) * (n / Nat.gcd n (1 + A018804 n)) := (Nat.mul_div_cancel' h_div).symm
    change n / Nat.gcd n (1 + A018804 n) = 1 at ha
    rw [ha] at h_eq
    rw [mul_one] at h_eq
    exact h_eq.symm
  have h_dvd2 : Nat.gcd n (1 + A018804 n) ∣ 1 + A018804 n := Nat.gcd_dvd_right _ _
  rw [h_gcd] at h_dvd2
  exact h_dvd2


theorem totient_dvd_of_prime_square_dvd {p x : ℕ} (hp : Nat.Prime p) (h : p ^ 2 ∣ x) : p ∣ x.totient := by
  have hp_pos : 0 < p := hp.pos
  rw [pow_two] at h
  rcases h with ⟨m, rfl⟩
  have h_div : p * p * m / p = p * m := by
    rw [mul_assoc]
    exact Nat.mul_div_cancel_left (p * m) hp_pos
  have h_dvd : p ∣ p * p * m / p := by
    rw [h_div]
    exact dvd_mul_right p m
  have h_tot : (p * (p * p * m / p)).totient = p * (p * p * m / p).totient := by
    apply totient_mul_of_prime_of_dvd hp h_dvd
  have h_eq2 : p * p * m = p * (p * p * m / p) := by
    rw [h_div]
    rw [mul_assoc]
  rw [h_eq2]
  rw [h_tot]
  exact dvd_mul_right p _

theorem A018804_dvd_of_square_dvd {n p : ℕ} (hp : Nat.Prime p) (h : p ^ 2 ∣ n) : p ∣ A018804 n := by
  by_cases hn0 : n = 0
  · rw [hn0]
    change p ∣ (Finset.Ico 1 1).sum (fun k => Nat.gcd k 0)
    rw [Ico_self, sum_empty]
    exact dvd_zero p
  · have hn : 0 < n := Nat.pos_of_ne_zero hn0
    rw [A018804_eq_totient_sum hn]
    apply Finset.dvd_sum
    intro d hd
    rw [mem_divisors] at hd
    by_cases hpd : p ∣ d
    · exact dvd_mul_of_dvd_left hpd _
    · apply dvd_mul_of_dvd_right
      apply totient_dvd_of_prime_square_dvd hp
      have h_cop : Nat.Coprime (p^2) d := by
        rw [coprime_pow_left_iff (by decide)]
        exact hp.coprime_iff_not_dvd.mpr hpd
      have h_div_n : n = d * (n / d) := (Nat.mul_div_cancel' hd.left).symm
      have h_dvd_mul : p^2 ∣ d * (n / d) := by
        rw [← h_div_n]
        exact h
      rw [mul_comm] at h_dvd_mul
      exact Nat.Coprime.dvd_of_dvd_mul_right h_cop h_dvd_mul


theorem disjoint_divisors_prime_mul {p m : ℕ} (hp : Nat.Prime p) (hco : Nat.Coprime p m) :
    Disjoint m.divisors (m.divisors.image (fun d => p * d)) := by
  rw [disjoint_iff_ne]
  rintro x hx z h_img rfl
  rcases Finset.mem_image.mp h_img with ⟨y, hy, rfl⟩
  rw [mem_divisors] at hx hy
  have h_dvd : p ∣ m := by
    apply dvd_trans (dvd_mul_right p y) hx.left
  have h_not : ¬ p ∣ m := hp.coprime_iff_not_dvd.mp hco
  exact h_not h_dvd

theorem divisors_mul_prime_eq_union {p m : ℕ} (hp : Nat.Prime p) (hm : 0 < m) :
    (p * m).divisors = m.divisors ∪ m.divisors.image (fun d => p * d) := by
  ext d
  rw [mem_union, mem_divisors, mem_image]
  have hp_pos : 0 < p := hp.pos
  have hpm_pos : 0 < p * m := Nat.mul_pos hp_pos hm
  constructor
  · rintro ⟨hd, _⟩
    by_cases hpd : p ∣ d
    · right
      rcases hpd with ⟨k, rfl⟩
      have h_dvd : k ∣ m := by
        rw [mul_comm p k] at hd
        rw [mul_comm p m] at hd
        exact Nat.dvd_of_mul_dvd_mul_right hp_pos hd
      refine ⟨k, ?_, rfl⟩
      rw [mem_divisors]
      exact ⟨h_dvd, by omega⟩
    · left
      rw [mem_divisors]
      have h_cop : Nat.Coprime p d := hp.coprime_iff_not_dvd.mpr hpd
      have h_dvd : d ∣ m := Nat.Coprime.dvd_of_dvd_mul_left h_cop.symm hd
      exact ⟨h_dvd, by omega⟩
  · rintro (hd | ⟨k, hk, rfl⟩)
    · rw [mem_divisors] at hd
      refine ⟨dvd_mul_of_dvd_right hd.left p, by omega⟩
    · rw [mem_divisors] at hk
      refine ⟨mul_dvd_mul_left p hk.left, by omega⟩

theorem A018804_mul_prime {p m : ℕ} (hp : Nat.Prime p) (hco : Nat.Coprime p m) (hm : 0 < m) :
    A018804 (p * m) = (2 * p - 1) * A018804 m := by
  have hp_pos : 0 < p := hp.pos
  have hpm : 0 < p * m := Nat.mul_pos hp_pos hm
  rw [A018804_eq_totient_sum hpm]
  rw [A018804_eq_totient_sum hm]
  rw [divisors_mul_prime_eq_union hp hm]
  have h_disj := disjoint_divisors_prime_mul hp hco
  rw [sum_union h_disj]
  have h_inj : Set.InjOn (fun d => p * d) m.divisors := by
    intro x _ y _ h_eq
    exact Nat.eq_of_mul_eq_mul_left hp_pos h_eq
  rw [sum_image h_inj]
  have h_div_cancel : ∀ d ∈ m.divisors, (p * m) / (p * d) = m / d := by
    intro d hd
    rw [mem_divisors] at hd
    have hd_pos : 0 < d := by
      have h_dvd : d ∣ m := hd.left
      by_contra hc
      have : d = 0 := by omega
      subst this
      have : m = 0 := zero_dvd_iff.mp h_dvd
      omega
    rw [mul_comm p m, mul_comm p d]
    exact Nat.mul_div_mul_right m d hp_pos
  have h_second_sum : ∑ d ∈ m.divisors, (p * d) * ((p * m) / (p * d)).totient =
                      ∑ d ∈ m.divisors, p * (d * (m / d).totient) := by
    apply Finset.sum_congr rfl
    intro d hd
    rw [h_div_cancel d hd]
    ring
  rw [h_second_sum]
  have h_div_p : ∀ d ∈ m.divisors, (p * m) / d = p * (m / d) := by
    intro d hd
    rw [mem_divisors] at hd
    exact Nat.mul_div_assoc p hd.left
  have h_tot_p : ∀ d ∈ m.divisors, (p * (m / d)).totient = (p - 1) * (m / d).totient := by
    intro d hd
    rw [mem_divisors] at hd
    have hco_d : Nat.Coprime p (m / d) := hco.of_dvd_right (Nat.div_dvd_of_dvd hd.left)
    have h_not : ¬ p ∣ m / d := hp.coprime_iff_not_dvd.mp hco_d
    exact totient_mul_of_prime_of_not_dvd hp h_not
  have h_first_sum : ∑ d ∈ m.divisors, d * ((p * m) / d).totient =
                     ∑ d ∈ m.divisors, (p - 1) * (d * (m / d).totient) := by
    apply Finset.sum_congr rfl
    intro d hd
    rw [h_div_p d hd]
    rw [h_tot_p d hd]
    ring
  rw [h_first_sum]
  rw [← sum_add_distrib]
  have h_combine : ∀ d ∈ m.divisors, (p - 1) * (d * (m / d).totient) + p * (d * (m / d).totient) = (2 * p - 1) * (d * (m / d).totient) := by
    intro d hd
    rw [← add_mul]
    congr 1
    have hp2 := hp.two_le
    omega
  have h_sum_congr : ∑ d ∈ m.divisors, ((p - 1) * (d * (m / d).totient) + p * (d * (m / d).totient)) =
                     ∑ d ∈ m.divisors, (2 * p - 1) * (d * (m / d).totient) := by
    apply Finset.sum_congr rfl
    exact h_combine
  rw [h_sum_congr]
  rw [← mul_sum]



theorem exists_prime_square_dvd_of_not_squarefree {n : ℕ} (h : ¬ Squarefree n) :
    ∃ p : ℕ, Nat.Prime p ∧ p ^ 2 ∣ n := by
  rw [squarefree_iff_prime_squarefree] at h
  push_neg at h
  rcases h with ⟨p, hp, h_dvd⟩
  refine ⟨p, hp, ?_⟩
  rw [pow_two]
  exact h_dvd



lemma helper_div_sub (q a Y : ℕ) (hq : 2 ≤ q) (h : q * a + Y = 2 * q * Y + 1) : Y - 1 = q * (2 * Y - a) := by
  have hY : Y ≠ 0 := by
    intro hc
    subst hc
    simp only [mul_zero, add_zero] at h
    rcases a with rfl | a
    · simp only [mul_zero] at h; omega
    · have : q * (a + 1) ≥ 2 := by
        calc q * (a + 1) ≥ 2 * 1 := Nat.mul_le_mul hq (by omega)
             _ = 2 := by rfl
      omega
  have hY_pos : 1 ≤ Y := Nat.pos_of_ne_zero hY
  have h2 : q * a + (Y - 1) = 2 * q * Y := by omega
  have h3 : Y - 1 = 2 * q * Y - q * a := by omega
  have h4 : q * (2 * Y - a) = 2 * q * Y - q * a := by
    rw [Nat.mul_sub_left_distrib]
    congr 1
    ring
  rw [h3, h4]

lemma contra_p3_case1 (q_val r_val : ℕ) (hq : q_val ≥ 5) (hr : r_val ≥ 7)
    (hK : 12 * q_val + 4 * (q_val * r_val) + 12 * r_val - (6 + 2 * q_val + 2 * r_val) = 3 * (q_val * r_val)) : False := by
  have h_le : 6 + 2 * q_val + 2 * r_val ≤ 12 * q_val + 4 * (q_val * r_val) + 12 * r_val := by omega
  have h_add : 12 * q_val + 4 * (q_val * r_val) + 12 * r_val = 3 * (q_val * r_val) + (6 + 2 * q_val + 2 * r_val) := by omega
  have h_z : 12 * (q_val : ℤ) + 4 * ((q_val : ℤ) * r_val) + 12 * r_val = 3 * (q_val * r_val) + (6 + 2 * q_val + 2 * r_val) := by exact_mod_cast h_add
  have h_q_z : (q_val : ℤ) ≥ 5 := by omega
  have h_r_z : (r_val : ℤ) ≥ 7 := by omega
  nlinarith

lemma contra_p11_case1 (q_val r_val : ℕ) (hq : q_val ≥ 13) (hr : r_val ≥ 17)
    (hK : 44 * q_val + 4 * (q_val * r_val) + 44 * r_val - (22 + 2 * q_val + 2 * r_val) = 11 * (q_val * r_val)) : False := by
  have h_le : 22 + 2 * q_val + 2 * r_val ≤ 44 * q_val + 4 * (q_val * r_val) + 44 * r_val := by omega
  have h_add : 44 * q_val + 4 * (q_val * r_val) + 44 * r_val = 11 * (q_val * r_val) + (22 + 2 * q_val + 2 * r_val) := by omega
  have h_z : 44 * (q_val : ℤ) + 4 * ((q_val : ℤ) * r_val) + 44 * r_val = 11 * (q_val * r_val) + (22 + 2 * q_val + 2 * r_val) := by exact_mod_cast h_add
  have h_q_z : (q_val : ℤ) ≥ 13 := by omega
  have h_r_z : (r_val : ℤ) ≥ 17 := by omega
  nlinarith


lemma helper_omega_le (a_s W : ℕ) (h : 2 * a_s ≤ W - 1) : a_s ≤ 2 * W := by
  omega


lemma helper_omega_goal (X CY C : ℕ) (h_C_ge : 3 ≤ C) (h_CY_ge : 1 ≤ CY) (h_X_ge : CY + C ≤ X) :
    X - (CY - 1) - (X - CY - C) = C + 1 := by
  omega


/--
It is conjectured that $a(n) = 1$ if and only if $n$ is 1 or a prime number.
A340079: It is conjectured that this is 1 iff n is 1 or a prime. See _Thomas Ordowski_'s Oct 22 2014 comment in A018804.
-/
theorem oeis_340079_conjecture_0 (n : ℕ) : a n = 1 ↔ (n = 1 ∨ Nat.Prime n) := by
  constructor
  · intro h
    by_cases hn1 : n = 1
    · left; exact hn1
    · right
      by_cases hp : Nat.Prime n
      · exact hp
      · by_cases hn0 : n = 0
        · rw [hn0] at h
          change 0 / Nat.gcd 0 (1 + A018804 0) = 1 at h
          simp at h
        · have hp_prime : Nat.Prime (Nat.minFac n) := Nat.minFac_prime hn1
          have h_dvd : Nat.minFac n ∣ n := Nat.minFac_dvd n
          by_cases h_sq : ¬ Squarefree n
          · rcases exists_prime_square_dvd_of_not_squarefree h_sq with ⟨p, hp, hdvd⟩
            have h_A : p ∣ A018804 n := A018804_dvd_of_square_dvd hp hdvd
            have h_not : ¬ p ∣ 1 + A018804 n := by
              intro hd
              rw [add_comm] at hd
              have h_dvd_one : p ∣ 1 := (Nat.dvd_add_right h_A).mp hd
              have h_eq_one : p = 1 := Nat.eq_one_of_dvd_one h_dvd_one
              have : p ≥ 2 := hp.two_le
              omega
            have hp_dvd : p ∣ n := by
              have hd_sq : p ^ 2 ∣ n := hdvd
              rw [pow_two] at hd_sq
              exact dvd_of_mul_left_dvd hd_sq
            have h_ne := a_ne_one_of_not_dvd hp_dvd h_not
            exact (h_ne h).elim
          · push_neg at h_sq
            have h_fac_len : 2 ≤ n.primeFactorsList.length := by
              by_contra hc
              have h_lt : n.primeFactorsList.length < 2 := by omega
              interval_cases h_len : n.primeFactorsList.length
              · have h_nil := List.eq_nil_of_length_eq_zero h_len
                have h_prod : n.primeFactorsList.prod = 1 := by rw [h_nil]; rfl
                rw [Nat.prod_primeFactorsList hn0] at h_prod
                exact hn1 h_prod
              · rcases List.length_eq_one_iff.mp h_len with ⟨q, h_q⟩
                have h_mem : q ∈ n.primeFactorsList := by rw [h_q]; simp
                have h_prime : Nat.Prime q := Nat.prime_of_mem_primeFactorsList h_mem
                have h_prod : n.primeFactorsList.prod = q := by rw [h_q]; simp
                rw [Nat.prod_primeFactorsList hn0] at h_prod
                subst h_prod
                exact hp h_prime
            set p := Nat.minFac n
            set m := n / p
            have hp_pos : 0 < p := hp_prime.pos
            have h_pm : n = p * m := (Nat.mul_div_cancel' h_dvd).symm
            have hm_pos : 0 < m := by
              by_contra hc
              have : m = 0 := Nat.le_zero.mp (Nat.not_lt.mp hc)
              rw [this] at h_pm
              simp [h_pm] at hn0
            have h_p_not_dvd_m : ¬ p ∣ m := by
              intro hd
              have h_sq_dvd : p ^ 2 ∣ n := by
                rw [pow_two]
                rw [h_pm]
                exact mul_dvd_mul_left p hd
              have hp_sqfree : ∀ x : ℕ, x * x ∣ n → x = 1 := by
                intro x hx
                have h_unit := h_sq x hx
                rw [Nat.isUnit_iff] at h_unit
                exact h_unit
              have hp_eq_one := hp_sqfree p (by rw [← pow_two]; exact h_sq_dvd)
              have : p ≥ 2 := hp_prime.two_le
              omega
            have hco : Nat.Coprime p m := hp_prime.coprime_iff_not_dvd.mpr h_p_not_dvd_m
            have h_A_pm : A018804 n = (2 * p - 1) * A018804 m := by
              rw [h_pm]
              exact A018804_mul_prime hp_prime hco hm_pos
            have h_n_dvd_A : n ∣ 1 + A018804 n := by
              have ha : n / Nat.gcd n (1 + A018804 n) = 1 := h
              have h_gcd : Nat.gcd n (1 + A018804 n) = n := by
                have h_div : Nat.gcd n (1 + A018804 n) ∣ n := Nat.gcd_dvd_left n _
                have h_eq : n = Nat.gcd n (1 + A018804 n) * (n / Nat.gcd n (1 + A018804 n)) := (Nat.mul_div_cancel' h_div).symm
