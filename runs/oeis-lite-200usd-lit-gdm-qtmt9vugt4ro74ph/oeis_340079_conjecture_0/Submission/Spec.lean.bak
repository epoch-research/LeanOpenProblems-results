                              rw [← h_qr]
                              have : (5 : ℤ) ≤ q := by omega
                              have : (7 : ℤ) ≤ r := by omega
                              nomega
                            have : (18 : ℤ) ≤ 3 * QR := by omega
                            have : (0 : ℤ) ≤ s := by positivity
                            nomega
                          _ = 3 * QRS := by rw [← h_qrs, ← h_qr]; ring
                        omega
                      omega
                    · have hq3 : q = 3 := by omega
                      have hr_ge : 5 ≤ r := by
                        rw [hq3] at hq_lt_r
                        have : r ≠ 4 := by
                          intro hc
                          rw [hc] at hr_prime
                          revert hr_prime; decide
                        omega
                      have hs_ge : 7 ≤ s := by
                        have : r < s := hr_lt_s
                        have : s ≠ 6 := by intro hc; rw [hc] at hs_prime; revert hs_prime; decide
                        omega
                      have h_gs_eq_rew : 6 * r * s * g_s_prime = 15 * (2 * r - 1) * (2 * s - 1) * Y' + 3 := by
                        rw [hq3] at h_gs_eq
                        rw [h_Y_eq] at h_gs_eq
                        have h_ring_LHS : 2 * 3 * r * s * g_s_prime = 6 * r * s * g_s_prime := by ring
                        rw [h_ring_LHS] at h_gs_eq
                        have h_ring_RHS : 3 * (2 * 3 - 1) * (2 * r - 1) * ((2 * s - 1) * Y') + 1 = 15 * (2 * r - 1) * (2 * s - 1) * Y' + 1 := by ring
                        rw [h_ring_RHS] at h_gs_eq
                        omega
                      have h_le_54 : 6 * r * s * g_s_prime ≤ 54 * r * s * Y' := by
                        have : 6 * r * s * g_s_prime = (6 * r * s) * g_s_prime := by ring
                        rw [this]
                        have h_gs_prime_le : g_s_prime ≤ 9 * Y' := by
                          have h_prod_gs_prime : 6 * r * g_s_prime = 30 * (2 * r - 1) * Y' - a_s := by
                            rw [hq3] at h_prod_gs_prime
                            have h_ring1 : 2 * 3 * r * g_s_prime = 6 * r * g_s_prime := by ring
                            rw [h_ring1] at h_prod_gs_prime
                            have h_ring2 : 2 * C * A * B * Y' = 2 * (2 * r - 1) * 3 * (2 * 3 - 1) * Y' := by rw [hA_val]; rfl
                            have h_ring3 : 2 * (2 * r - 1) * 3 * (2 * 3 - 1) * Y' = 30 * (2 * r - 1) * Y' := by ring
                            rw [h_ring2, h_ring3] at h_prod_gs_prime
                            exact h_prod_gs_prime
                          have h_as_pos : 1 ≤ a_s := by
                            have h_A_ge : 3 ≤ A := by dsimp [A]; have := hp_prime.two_le; omega
                            have h_B_ge : 5 ≤ B := by dsimp [B]; have := hq_prime.two_le; omega
                            have h_C_ge : 3 ≤ C := by dsimp [C]; have := hr_prime.two_le; omega
                            have h_Y_ge : 1 ≤ Y' := h_Y'_pos
                            have h_ABY_ge : 15 ≤ A * B * Y' := by
                              have : 15 = 3 * 5 * 1 := rfl
                              rw [this]
                              exact Nat.mul_le_mul h_A_ge h_B_ge
                            have h_CABY_ge : 45 ≤ C * (A * B * Y') := by
                              have : 45 = 3 * 15 := rfl
                              rw [this]
                              exact Nat.mul_le_mul h_C_ge h_ABY_ge
                            have ha_s_W : s * a_s = C * (A * B * Y') - 1 := by
                              have : A * B * C * Y' = C * (A * B * Y') := by ring
                              rw [← this]
                              exact ha_s.symm
                            omega
                          have h_gs_prime_lt : 6 * r * g_s_prime < 30 * (2 * r - 1) * Y' := by
                            rw [h_prod_gs_prime]
                            omega
                          have h_gs_prime_le_9 : g_s_prime ≤ 9 * Y' := by
                            have h_strict : 30 * (2 * r - 1) * Y' < 60 * r * Y' := by
                              zify
                              have : (0 : ℤ) < Y' := by zify at h_Y'_pos; omega
                              nomega
                            have h_lt : 6 * r * g_s_prime < 60 * r * Y' := h_gs_prime_lt.trans h_strict
                            have h_lt2 : g_s_prime < 10 * Y' := by
                              have h_pos : 0 < 6 * r := by positivity
                              have h_ring1 : 6 * r * g_s_prime = (6 * r) * g_s_prime := by ring
                              have h_ring2 : 60 * r * Y' = (6 * r) * (10 * Y') := by ring
                              rw [h_ring1, h_ring2] at h_lt
                              exact Nat.lt_of_mul_lt_mul_left h_lt
                            omega
                          exact h_gs_prime_le_9
                        have h_mul := Nat.mul_le_mul_left (6 * r * s) h_gs_prime_le
                        have h_ring : 6 * r * s * (9 * Y') = 54 * r * s * Y' := by ring
                        rw [h_ring] at h_mul
                        exact h_mul
                      have h_final_ineq : 15 * (2 * r - 1) * (2 * s - 1) * Y' + 3 ≤ 54 * r * s * Y' := by
                        rwa [← h_gs_eq_rew]
                      have h_strict_lt : 15 * (2 * r - 1) * (2 * s - 1) * Y' < 54 * r * s * Y' := by
                        omega
                      have h_div_3_Y' : 5 * (2 * r - 1) * (2 * s - 1) < 18 * r * s := by
                        have h_mul_lt : 3 * (5 * (2 * r - 1) * (2 * s - 1)) * Y' < 3 * (18 * r * s) * Y' := by
                          have : 3 * (18 * r * s) * Y' = 54 * r * s * Y' := by ring
                          rw [this]
                          have h_ring_LHS : 3 * (5 * (2 * r - 1) * (2 * s - 1)) * Y' = 15 * (2 * r - 1) * (2 * s - 1) * Y' := by ring
                          rwa [h_ring_LHS]
                        have h_3_Y'_pos : 0 < 3 * Y' := by omega
                        exact Nat.lt_of_mul_lt_mul_right h_mul_lt
                      have h_LHS_ge : 18 * r * s ≤ 5 * (2 * r - 1) * (2 * s - 1) := by
                        have h1 : 7 * r ≤ r * s := by
                          calc 7 * r ≤ s * r := Nat.mul_le_mul_right r hs_ge
                          _ = r * s := by ring
                        have h2 : 5 * s ≤ r * s := by
                          calc 5 * s ≤ r * s := Nat.mul_le_mul_right s hr_ge
                        zify [hr_ge, hs_ge, hr_lt_s]
                        have h_r_cast : ((2 * r - 1 : ℕ) : ℤ) = 2 * (r : ℤ) - 1 := by
                          have : 1 ≤ 2 * r := by omega
                          exact Nat.cast_sub this
                        have h_s_cast : ((2 * s - 1 : ℕ) : ℤ) = 2 * (s : ℤ) - 1 := by
                          have : 1 ≤ 2 * s := by omega
                          exact Nat.cast_sub this
                        rw [h_r_cast, h_s_cast]
                        have h_expand : 5 * (2 * (r : ℤ) - 1) * (2 * (s : ℤ) - 1) = 20 * (r * s) - 10 * r - 10 * s + 5 := by ring
                        rw [h_expand]
                        generalize h_rs : (r : ℤ) * s = RS at h1 h2 ⊢
                        omega
                      omega
                  · have hp3 : p ≥ 3 := by
                      have : p ≠ 2 := hp2
                      have : p ≥ 2 := hp_prime.two_le
                      omega
                    have h_q_g_s_int : (q : ℤ) * g_s = 4 * A * B * Y' - k_s := by zify; omega [h_q_g_s]
                    have h_rk_eq_int : (r : ℤ) * k_s = 2 * (A * B * Y') + a_s := by zify; omega [h_rk_eq]
                    have ha_s_int : (A : ℤ) * B * C * Y' - 1 = s * a_s := by
                      have : A * B * C * Y' - 1 = s * a_s := by
                        rw [← ha_s]
                        ring
                      zify; omega [this]
                    have hY_eq_int : (Y : ℤ) = (2 * s - 1) * Y' := by zify; omega [h_Y_eq]
                    have h_prod_int : (q * r * s * g_s : ℤ) = A * B * C * Y + 1 := by
                      linear_combination
                        ((r : ℤ) * s) * h_q_g_s_int - (s : ℤ) * h_rk_eq_int - ha_s_int - ((A : ℤ) * B * C) * hY_eq_int
                    have h_prod : q * r * s * g_s = A * B * C * Y + 1 := by
                      exact_mod_cast h_prod_int
                    have hq5 : q ≥ 5 := by
                      have : p < q := hp_lt_q
                      have : 3 ≤ p := hp3
                      omega
                    have hr_ge : 7 ≤ r := by
                      have : q < r := hq_lt_r
                      have : r ≠ 6 := by
                        intro hc
                        rw [hc] at hr_prime
                        revert hr_prime; decide
                      omega
                    have hs_ge : 11 ≤ s := by
                      have : r < s := hr_lt_s
                      have : s ≠ 8 := by intro hc; rw [hc] at hs_prime; revert hs_prime; decide
                      have : s ≠ 9 := by intro hc; rw [hc] at hs_prime; revert hs_prime; decide
                      have : s ≠ 10 := by intro hc; rw [hc] at hs_prime; revert hs_prime; decide
                      omega
                    have h_as_pos : 1 ≤ a_s := by
                      have h_A_ge : 5 ≤ A := by dsimp [A]; omega
                      have h_B_ge : 9 ≤ B := by dsimp [B]; omega
                      have h_C_ge : 13 ≤ C := by dsimp [C]; omega
                      have h_Y_ge : 1 ≤ Y' := h_Y'_pos
                      have h_ABY_ge : 45 ≤ A * B * Y' := by
                        have : 45 = 5 * 9 * 1 := by decide
                        rw [this]
                        exact Nat.mul_le_mul h_A_ge h_B_ge
                      have h_CABY_ge : 585 ≤ C * (A * B * Y') := by
                        have : 585 = 13 * 45 := by decide
                        rw [this]
                        exact Nat.mul_le_mul h_C_ge h_ABY_ge
                      have ha_s_W : s * a_s = C * (A * B * Y') - 1 := by
                        have : A * B * C * Y' = C * (A * B * Y') := by ring
                        rw [← this]
                        exact ha_s.symm
                      omega
                    have h_q_gs_lt : q * g_s < 4 * A * B * Y' := by
                      rw [h_q_g_s]
                      have : 1 ≤ k_s := by
                        have h_A_ge : 5 ≤ A := by dsimp [A]; omega
                        have h_B_ge : 9 ≤ B := by dsimp [B]; omega
                        have h_Y_ge : 1 ≤ Y' := h_Y'_pos
                        have h_ABY_ge : 45 ≤ A * B * Y' := by
                          have : 45 = 5 * 9 * 1 := by decide
                          rw [this]
                          exact Nat.mul_le_mul h_A_ge h_B_ge
                        omega
                      omega
                    have h_gs_lt : q * r * s * g_s < 4 * A * B * r * s * Y' := by
                      calc q * r * s * g_s = (q * g_s) * r * s := by ring
                      _ < (4 * A * B * Y') * r * s := Nat.mul_lt_mul_of_pos_right h_q_gs_lt (by positivity)
                      _ = 4 * A * B * r * s * Y' := by ring
                    have h_gs_eq_rew : q * r * s * g_s = A * B * C * (2 * s - 1) * Y' + 1 := by
                      rw [h_Y_eq] at h_prod
                      have : A * B * C * ((2 * s - 1) * Y') = A * B * C * (2 * s - 1) * Y' := by ring
                      rw [this] at h_prod
                      exact h_prod
                    have h_final_ineq : A * B * C * (2 * s - 1) * Y' + 1 < 4 * A * B * r * s * Y' := by
                      rwa [h_gs_eq_rew] at h_gs_lt
                    have h_strict_lt : A * B * C * (2 * s - 1) * Y' < 4 * A * B * r * s * Y' := by
                      omega
                    have h_div : C * (2 * s - 1) < 4 * r * s := by
                      have h_mul_lt : A * B * (C * (2 * s - 1)) * Y' < A * B * (4 * r * s) * Y' := by
                        calc A * B * (C * (2 * s - 1)) * Y' = A * B * C * (2 * s - 1) * Y' := by ring
                        _ < 4 * A * B * r * s * Y' := h_strict_lt
                        _ = A * B * (4 * r * s) * Y' := by ring
                      have h_AB_Y'_pos : 0 < A * B * Y' := by positivity
                      exact Nat.lt_of_mul_lt_mul_left (Nat.lt_of_mul_lt_mul_right h_mul_lt)
                    have h_C_s_ge : 4 * r * s ≤ C * (2 * s - 1) := by
                      have h_C_eq : C = 2 * r - 1 := rfl
                      rw [h_C_eq]
                      have h1 : 11 * r ≤ r * s := by
                        calc 11 * r ≤ s * r := Nat.mul_le_mul_right r hs_ge
                        _ = r * s := by ring
                      have h2 : 7 * s ≤ r * s := by
                        calc 7 * s ≤ r * s := Nat.mul_le_mul_right s hr_ge
                      zify [hr_ge, hs_ge, hr_lt_s]
                      have h_r_cast : ((2 * r - 1 : ℕ) : ℤ) = 2 * (r : ℤ) - 1 := by
                        have : 1 ≤ 2 * r := by omega
                        exact Nat.cast_sub this
                      have h_s_cast : ((2 * s - 1 : ℕ) : ℤ) = 2 * (s : ℤ) - 1 := by
                        have : 1 ≤ 2 * s := by omega
                        exact Nat.cast_sub this
                      rw [h_r_cast, h_s_cast]
                      have h_expand : (2 * (r : ℤ) - 1) * (2 * s - 1) = 4 * (r * s) - 2 * r - 2 * s + 1 := by ring
                      rw [h_expand]
                      generalize h_rs : (r : ℤ) * s = RS at h1 h2 ⊢
                      sorry
                    omega

                subst h_c_zero
                have h_le_ABC : 15 ≤ A * B * Y := by
                  have h_A_ge : 3 ≤ A := by dsimp [A]; have := hp_prime.two_le; omega
                  have h_B_ge : 5 ≤ B := by dsimp [B]; have := hq_prime.two_le; omega
                  have h_Y_ge : 1 ≤ Y := h_Y_pos
                  have h_AB : 15 ≤ A * B := by
                    have : 15 = 3 * 5 := rfl
                    rw [this]
                    exact Nat.mul_le_mul h_A_ge h_B_ge
                  have h_final : (15 * 1) ≤ (A * B) * Y := Nat.mul_le_mul h_AB h_Y_ge
                  rw [mul_one] at h_final
                  exact h_final
                exfalso
                omega
  · rintro (rfl | hp)
    · exact a_one
    · exact a_prime hp
