    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + q := by
  rcases heven with ⟨k, rfl⟩
  have hk_ge : 1001 ≤ k := by omega
  have hk_le : k ≤ 2000 := by omega
  interval_cases k
