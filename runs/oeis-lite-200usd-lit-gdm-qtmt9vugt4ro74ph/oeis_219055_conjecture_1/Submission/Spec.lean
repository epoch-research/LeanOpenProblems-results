theorem goldbach_up_to_8012 (n : ℕ) (h4 : 4 ≤ n) (hn : n ≤ 8012) (heven : Even n) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + q := by
  rcases heven with ⟨k, rfl⟩
  if h : k + k ≤ 2000 then
    exact goldbach_up_to_2000 (k + k) h4 h ⟨k, rfl⟩
  else if h2 : k + k ≤ 4000 then
    have h_gt : 2002 ≤ k + k := by omega
    exact goldbach_2002_to_4000 (k + k) h_gt h2 ⟨k, rfl⟩
  else if h3 : k + k ≤ 6000 then
    have h_gt : 4002 ≤ k + k := by omega
    exact goldbach_4002_to_6000 (k + k) h_gt h3 ⟨k, rfl⟩
  else
    have h_gt : 6002 ≤ k + k := by omega
    exact goldbach_6002_to_8012 (k + k) h_gt hn ⟨k, rfl⟩

theorem lemoine_up_to_2001 (n : ℕ) (h_start : 7 ≤ n) (h_end : n ≤ 2001) (hodd : Odd n) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + 2 * q := by
  rcases hodd with ⟨k, rfl⟩
  have hk_ge : 3 ≤ k := by omega
  have hk_le : k ≤ 1000 := by omega
  interval_cases k
