theorem lemoine_up_to_15727 (n : ℕ) (h7 : 7 ≤ n) (hn : n ≤ 15727) (hodd : Odd n) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + 2 * q := by
  rcases hodd with ⟨k, rfl⟩
  if h : 2 * k + 1 ≤ 2001 then
    exact lemoine_up_to_2001 (2 * k + 1) h7 h ⟨k, rfl⟩
  else if h2 : 2 * k + 1 ≤ 4001 then
    have h_gt : 2003 ≤ 2 * k + 1 := by omega
    exact lemoine_2003_to_4001 (2 * k + 1) h_gt h2 ⟨k, rfl⟩
  else if h3 : 2 * k + 1 ≤ 6001 then
    have h_gt : 4003 ≤ 2 * k + 1 := by omega
    exact lemoine_4003_to_6001 (2 * k + 1) h_gt h3 ⟨k, rfl⟩
  else if h4 : 2 * k + 1 ≤ 8001 then
    have h_gt : 6003 ≤ 2 * k + 1 := by omega
    exact lemoine_6003_to_8001 (2 * k + 1) h_gt h4 ⟨k, rfl⟩
  else if h5 : 2 * k + 1 ≤ 10001 then
    have h_gt : 8003 ≤ 2 * k + 1 := by omega
    exact lemoine_8003_to_10001 (2 * k + 1) h_gt h5 ⟨k, rfl⟩
  else if h6 : 2 * k + 1 ≤ 12001 then
    have h_gt : 10003 ≤ 2 * k + 1 := by omega
    exact lemoine_10003_to_12001 (2 * k + 1) h_gt h6 ⟨k, rfl⟩
  else if h7 : 2 * k + 1 ≤ 14001 then
    have h_gt : 12003 ≤ 2 * k + 1 := by omega
    exact lemoine_12003_to_14001 (2 * k + 1) h_gt h7 ⟨k, rfl⟩
  else
    have h_gt : 14003 ≤ 2 * k + 1 := by omega
    exact lemoine_14003_to_15727 (2 * k + 1) h_gt hn ⟨k, rfl⟩

/--
A219055, Conjecture 1: The core conjecture for A219055 implies Goldbach's conjecture,
Lemoine's conjecture and the conjecture that there are infinitely many primes p with p+6 also prime.
-/
theorem oeis_219055_conjecture_1 :
    a219055_core_conjecture → goldbach_conjecture ∧ lemoine_conjecture ∧ six_prime_gap_conjecture := by
  intro h_core
  refine ⟨?_, ?_, ?_⟩
  · -- Prove goldbach_conjecture
    unfold goldbach_conjecture
    intro n h4 heven
    by_cases hn : n ≤ 8012
    · exact goldbach_up_to_8012 n h4 hn heven
    · -- n > 8012
      have h_gt : 8012 < n := by omega
      have h_cond : (Even n ∧ 8012 < n) ∨ (Odd n ∧ 15727 < n) := Or.inl ⟨heven, h_gt⟩
      have h_a219055 := h_core n h_cond
      unfold A219055 at h_a219055
      -- Since Card > 0, there exists an element in the filter
      have h_nonempty : (Finset.filter (fun q =>
        ((1 + n % 2) + 1) * q < n ∧
        q.Prime ∧
        (q + 6).Prime ∧
        (n - (1 + n % 2) * q).Prime ∧
        (n - (1 + n % 2) * q - 6).Prime) (Finset.range n)).Nonempty := Finset.card_pos.mp h_a219055
      rcases h_nonempty with ⟨q, hq⟩
      rw [Finset.mem_filter] at hq
      rcases hq with ⟨_, hq_cond⟩
      rcases hq_cond with ⟨h_ineq, h_q_prime, _, h_p_prime, _⟩
      -- Since Even n, we have n % 2 = 0
      have hn_mod : n % 2 = 0 := by rwa [Nat.even_iff] at heven
      have hc : 1 + n % 2 = 1 := by omega
      rw [hc] at h_ineq h_p_prime
      simp only [one_mul] at h_ineq h_p_prime
      use n - q, q
      refine ⟨h_p_prime, h_q_prime, ?_⟩
      omega
  · -- Prove lemoine_conjecture
    unfold lemoine_conjecture
    intro n h7 hodd
    by_cases hn : n ≤ 15727
    · exact lemoine_up_to_15727 n h7 hn hodd
    · -- n > 15727
      have h_gt : 15727 < n := by omega
      have h_cond : (Even n ∧ 8012 < n) ∨ (Odd n ∧ 15727 < n) := Or.inr ⟨hodd, h_gt⟩
      have h_a219055 := h_core n h_cond
      unfold A219055 at h_a219055
      have h_nonempty : (Finset.filter (fun q =>
        ((1 + n % 2) + 1) * q < n ∧
        q.Prime ∧
        (q + 6).Prime ∧
        (n - (1 + n % 2) * q).Prime ∧
        (n - (1 + n % 2) * q - 6).Prime) (Finset.range n)).Nonempty := Finset.card_pos.mp h_a219055
      rcases h_nonempty with ⟨q, hq⟩
      rw [Finset.mem_filter] at hq
      rcases hq with ⟨_, hq_cond⟩
      rcases hq_cond with ⟨h_ineq, h_q_prime, _, h_p_prime, _⟩
      -- Since Odd n, we have n % 2 = 1
      have hn_mod : n % 2 = 1 := by rwa [Nat.odd_iff] at hodd
      have hc : 1 + n % 2 = 2 := by omega
      rw [hc] at h_ineq h_p_prime
      use n - 2 * q, q
      refine ⟨h_p_prime, h_q_prime, ?_⟩
      omega
  · -- Prove six_prime_gap_conjecture
    unfold six_prime_gap_conjecture
    rw [Set.infinite_iff_exists_gt]
    intro a
    -- Choose n = 2 * (a + 8012 + 6)
    let n := 2 * (a + 8012 + 6)
    have heven : Even n := ⟨a + 8012 + 6, by omega⟩
    have h_gt_8012 : 8012 < n := by
      unfold n
      omega
    have h_cond : (Even n ∧ 8012 < n) ∨ (Odd n ∧ 15727 < n) := Or.inl ⟨heven, h_gt_8012⟩
    have h_a219055 := h_core n h_cond
    unfold A219055 at h_a219055
    have h_nonempty : (Finset.filter (fun q =>
      ((1 + n % 2) + 1) * q < n ∧
      q.Prime ∧
      (q + 6).Prime ∧
      (n - (1 + n % 2) * q).Prime ∧
      (n - (1 + n % 2) * q - 6).Prime) (Finset.range n)).Nonempty := Finset.card_pos.mp h_a219055
    rcases h_nonempty with ⟨q, hq⟩
    rw [Finset.mem_filter] at hq
    rcases hq with ⟨_, hq_cond⟩
    rcases hq_cond with ⟨h_ineq, _, _, h_p_prime, h_p6_prime⟩
    -- Since Even n, n % 2 = 0
    have hn_mod : n % 2 = 0 := by omega
    have hc : 1 + n % 2 = 1 := by omega
    rw [hc] at h_ineq h_p_prime h_p6_prime
    simp only [one_mul] at h_ineq h_p_prime h_p6_prime
    -- Let b = n - q - 6
    let b := n - q - 6
    use b
    refine ⟨?_, ?_⟩
    · -- Prove b ∈ {p | p.Prime ∧ (p+6).Prime}
      simp only [Set.mem_setOf_eq]
      refine ⟨h_p6_prime, ?_⟩
      -- show b + 6 = n - q
      have hb6 : b + 6 = n - q := by
        unfold b
        omega
      rw [hb6]
      exact h_p_prime
    · -- Prove a < b
      -- We have 2 * q < n, so q < n / 2
      have hq_lt : q < a + 8012 + 6 := by
        unfold n at h_ineq
        omega
      unfold b n
      omega
