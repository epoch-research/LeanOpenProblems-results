import FormalConjectures.Util.ProblemImports

open Nat Finset

set_option maxRecDepth 2000000
set_option maxHeartbeats 0

/--
A236998: a(n) = |{0 < k < n/2: phi(k)*phi(n-k) is a square}|, where phi(.) is Euler's totient function.
-/
def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

lemma a_pos_of_exists (n : ℕ) (k : ℕ) (hk1 : 1 ≤ k) (hk2 : k ≤ (n - 1) / 2)
    (h_sq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k)) : a n > 0 := by
  have hk : k ∈ Ico 1 ((n - 1) / 2 + 1) := by
    rw [mem_Ico]
    omega
  have h_term : (if sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) then 1 else 0) = 1 := by
    rw [if_pos h_sq]
  have h_nonneg : ∀ x ∈ Ico 1 ((n - 1) / 2 + 1), 0 ≤ if sqrt (totient x * totient (n - x)) ^ 2 = totient x * totient (n - x) then 1 else 0 := by
    intro x _
    split_ifs <;> omega
  have h_le := Finset.single_le_sum h_nonneg hk
  rw [h_term] at h_le
  exact h_le

lemma coprime_two_of_odd (u : ℕ) (h_odd : Odd u) : Coprime 2 u := by
  rwa [coprime_two_left]

lemma coprime_eight_of_odd (u : ℕ) (h_odd : Odd u) : Coprime 8 u := by
  have h2 : Coprime 2 u := coprime_two_of_odd u h_odd
  have h8 : 8 = 2 ^ 3 := by rfl
  rw [h8]
  exact Coprime.pow_left 3 h2

lemma totient_sixteen_v (v : ℕ) : totient (16 * v) = 4 * totient (4 * v) := by
  have h_dvd1 : 2 ∣ 8 * v := by use 4 * v; ring
  have h_dvd2 : 2 ∣ 4 * v := by use 2 * v; ring
  have hp : Nat.Prime 2 := Nat.prime_two
  have h16 : 16 * v = 2 * (8 * v) := by ring
  have h8 : 8 * v = 2 * (4 * v) := by ring
  rw [h16, totient_mul_of_prime_of_dvd hp h_dvd1]
  rw [h8, totient_mul_of_prime_of_dvd hp h_dvd2]
  ring

theorem a_pos_of_mul_ten (u : ℕ) (h_u : 1 ≤ u) : a (10 * u) > 0 := by
  have hk1 : 1 ≤ 2 * u := by omega
  have hk2 : 2 * u ≤ (10 * u - 1) / 2 := by omega
  have h_sq : sqrt (totient (2 * u) * totient (10 * u - 2 * u)) ^ 2 = totient (2 * u) * totient (10 * u - 2 * u) := by
    have h10_2 : 10 * u - 2 * u = 8 * u := by omega
    rw [h10_2]
    rcases Nat.even_or_odd u with h_even | h_odd
    · rcases h_even with ⟨v, rfl⟩
      have h2u : 2 * (v + v) = 4 * v := by ring
      have h8u : 8 * (v + v) = 16 * v := by ring
      rw [h2u, h8u]
      rw [totient_sixteen_v v]
      have h_prod : totient (4 * v) * (4 * totient (4 * v)) = (2 * totient (4 * v)) ^ 2 := by ring
      rw [h_prod]
      rw [sqrt_eq']
    · have h_coprime : Coprime 8 u := coprime_eight_of_odd u h_odd
      have h8_mul : 8 * u = 8 * u := rfl
      rw [h8_mul, totient_mul h_coprime]
      rw [totient_two_mul_of_odd h_odd]
      have h_tot8 : totient 8 = 4 := by rfl
      rw [h_tot8]
      have h_prod : totient u * (4 * totient u) = (2 * totient u) ^ 2 := by ring
      rw [h_prod]
      rw [sqrt_eq']
  exact a_pos_of_exists (10 * u) (2 * u) hk1 hk2 h_sq

theorem a_pos_of_odd_mul_three (u : ℕ) (h_odd : Odd u) (h_u : 3 ≤ u) : a (3 * u) > 0 := by
  have hk1 : 1 ≤ u := by omega
  have hk2 : u ≤ (3 * u - 1) / 2 := by omega
  have h_sq : sqrt (totient u * totient (3 * u - u)) ^ 2 = totient u * totient (3 * u - u) := by
    have h3u_u : 3 * u - u = 2 * u := by omega
    rw [h3u_u]
    rw [totient_two_mul_of_odd h_odd]
    have h_prod : totient u * totient u = (totient u) ^ 2 := by ring
    rw [h_prod]
    rw [sqrt_eq']
  exact a_pos_of_exists (3 * u) u hk1 hk2 h_sq

theorem a_pos_of_mul_three (u : ℕ) (h_u : 9 ≤ 3 * u) : a (3 * u) > 0 := by
  rcases Nat.even_or_odd u with h_even | h_odd
  · rcases h_even with ⟨v, rfl⟩
    have h_v_ge1 : 1 ≤ v := by omega
    rcases em (5 ∣ v) with h5 | hnot5
    · rcases h5 with ⟨w, rfl⟩
      have h30 : 3 * (5 * w + 5 * w) = 10 * (3 * w) := by ring
      rw [h30]
      have h_3w_ge1 : 1 ≤ 3 * w := by omega
      exact a_pos_of_mul_ten (3 * w) h_3w_ge1
    · have hk1 : 1 ≤ v := h_v_ge1
      have hk2 : v ≤ (3 * (v + v) - 1) / 2 := by omega
      have h_sq : sqrt (totient v * totient (3 * (v + v) - v)) ^ 2 = totient v * totient (3 * (v + v) - v) := by
        have h5v : 3 * (v + v) - v = 5 * v := by omega
        rw [h5v]
        have hp5 : Nat.Prime 5 := by decide
        rw [totient_mul_of_prime_of_not_dvd hp5 hnot5]
        have h_prod : totient v * ((5 - 1) * totient v) = (2 * totient v) ^ 2 := by ring
        rw [h_prod]
        rw [sqrt_eq']
      exact a_pos_of_exists (3 * (v + v)) v hk1 hk2 h_sq
  · have h_u_ge3 : 3 ≤ u := by omega
    exact a_pos_of_odd_mul_three u h_odd h_u_ge3

theorem a_pos_of_coprime_rule (p : ℕ) (A : ℕ) (u : ℕ)
    (h_A1 : 1 ≤ A) (h_A2 : 2 * A < p)
    (h_u : 1 ≤ u)
    (h_copA : Coprime A u) (h_copB : Coprime (p - A) u)
    (h_sq : sqrt (totient A * totient (p - A)) ^ 2 = totient A * totient (p - A)) :
    a (p * u) > 0 := by
  have hk1 : 1 ≤ A * u := by
    have h_posA : 0 < A := by omega
    have h_posu : 0 < u := by omega
    have h_pos : 0 < A * u := Nat.mul_pos h_posA h_posu
    omega
  have hk2 : A * u ≤ (p * u - 1) / 2 := by
    rw [Nat.le_div_iff_mul_le (by decide)]
    have h_eq : A * u * 2 = 2 * A * u := by ring
    have h_ineq : 2 * A + 1 ≤ p := by omega
    have h_ineq2 : (2 * A + 1) * u ≤ p * u := Nat.mul_le_mul_right u h_ineq
    have h_dist : (2 * A + 1) * u = 2 * A * u + u := by ring
    rw [h_dist] at h_ineq2
    omega
  have h_sq_term : sqrt (totient (A * u) * totient (p * u - A * u)) ^ 2 = totient (A * u) * totient (p * u - A * u) := by
    have h_sub : p * u - A * u = (p - A) * u := by
      rw [← Nat.sub_mul]
    rw [h_sub]
    rw [totient_mul h_copA, totient_mul h_copB]
    have h_reorder : (totient A * totient u) * (totient (p - A) * totient u) = (totient A * totient (p - A)) * (totient u) ^ 2 := by
      ring
    rw [h_reorder]
    let S := sqrt (totient A * totient (p - A))
    have h_S2 : S ^ 2 = totient A * totient (p - A) := h_sq
    have h_prod : (totient A * totient (p - A)) * (totient u) ^ 2 = (S * totient u) ^ 2 := by
      rw [← h_S2]
      ring
    rw [h_prod]
    rw [sqrt_eq']
  exact a_pos_of_exists (p * u) (A * u) hk1 hk2 h_sq_term

lemma solve_branch_helper (n : ℕ) (C A S : ℕ)
    (h_cond : n % C = 0 ∧ Coprime A (n / C) ∧ Coprime (C - A) (n / C))
    (h_n : 9 ≤ n)
    (h_A1 : 1 ≤ A) (h_A2 : 2 * A < C)
    (h_prod : totient A * totient (C - A) = S ^ 2) :
    a n > 0 := by
  have h_dvd : C ∣ n := Nat.dvd_of_mod_eq_zero h_cond.1
  rcases h_dvd with ⟨v, rfl⟩
  have h_v0 : 0 < C := by omega
  have h_div : C * v / C = v := Nat.mul_div_cancel_left v h_v0
  have h_v : 1 ≤ v := by
    by_contra hc
    have h_v_eq : v = 0 := by omega
    subst h_v_eq
    omega
  have h_copA : Coprime A v := by
    have h_copA_raw := h_cond.2.1
    rwa [h_div] at h_copA_raw
  have h_copB : Coprime (C - A) v := by
    have h_copB_raw := h_cond.2.2
    rwa [h_div] at h_copB_raw
  have h_sq : sqrt (totient A * totient (C - A)) ^ 2 = totient A * totient (C - A) := by
    rw [h_prod, sqrt_eq']
  exact a_pos_of_coprime_rule C A v h_A1 h_A2 h_v h_copA h_copB h_sq

lemma bind_some_eq_some {α β : Type} (x : Option α) (f : α → Option β) (y : β) :
    x.bind f = some y ↔ ∃ a, x = some a ∧ f a = some y := by
  cases x with
  | none =>
    simp [Option.bind]
  | some a =>
    simp [Option.bind]

def parseHexChar (c : Char) : Nat :=
  if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat
  else if 'a' ≤ c && c ≤ 'f' then c.toNat - 'a'.toNat + 10
  else if 'A' ≤ c && c ≤ 'F' then c.toNat - 'A'.toNat + 10
  else 0

def hexToByteArray (s : String) : ByteArray :=
  let rec loop (idx : Nat) (acc : ByteArray) (fuel : Nat) : ByteArray :=
    if fuel = 0 then acc
    else
      if idx < s.length then
        let c1 := s.get ⟨idx⟩
        if idx + 1 < s.length then
          let c2 := s.get ⟨idx + 1⟩
          let val := parseHexChar c1 * 16 + parseHexChar c2
          loop (idx + 2) (acc.push val.toUInt8) (fuel - 1)
        else acc
      else acc
  loop 0 ByteArray.empty s.length

def getByte (arr : ByteArray) (idx : Nat) : Nat :=
  arr.get! idx |>.toNat

def get3Bytes (arr : ByteArray) (idx : Nat) : Nat :=
  let b0 := getByte arr idx
  let b1 := getByte arr (idx + 1)
  let b2 := getByte arr (idx + 2)
  b0 + b1 * 256 + b2 * 65536

def binarySearchLoop (target : Nat) (arr : ByteArray) (bytes_per_entry : Nat) (low : Nat) (high : Nat) : Nat → Option Nat
  | 0 => none
  | fuel + 1 =>
    if low > high then none
    else
      let mid := (low + high) / 2
      let val := get3Bytes arr (mid * bytes_per_entry)
      if val = target then some mid
      else if val < target then binarySearchLoop target arr bytes_per_entry (mid + 1) high fuel
      else if mid = 0 then none
      else binarySearchLoop target arr bytes_per_entry low (mid - 1) fuel

def binarySearch (target : Nat) (arr : ByteArray) (len : Nat) (bytes_per_entry : Nat) : Option Nat :=
  binarySearchLoop target arr bytes_per_entry 0 (len - 1) 25

def get_rule_for_C_generic (rules : ByteArray) (C : ℕ) : Option (ℕ × ℕ) :=
  (binarySearch C rules 309004 9).bind (fun idx =>
    let A := get3Bytes rules (idx * 9 + 3)
    let S := get3Bytes rules (idx * 9 + 6)
    if (1 ≤ A) && (2 * A < C) && (totient A * totient (C - A) == S ^ 2) then some (A, S) else none
  )

theorem get_rule_for_C_generic_correct (rules : ByteArray) (C A S : ℕ) (h : get_rule_for_C_generic rules C = some (A, S)) :
    1 ≤ A ∧ 2 * A < C ∧ totient A * totient (C - A) = S ^ 2 := by
  unfold get_rule_for_C_generic at h
  rw [bind_some_eq_some] at h
  rcases h with ⟨idx, h_search, h_cond⟩
  dsimp only at h_cond
  split_ifs at h_cond with h_bool
  · injection h_cond with h_pair
    injection h_pair with hA hS
    subst hA hS
    rw [Bool.and_eq_true, Bool.and_eq_true] at h_bool
    rcases h_bool with ⟨⟨h1, h2⟩, h3⟩
    exact ⟨of_decide_eq_true h1, of_decide_eq_true h2, beq_iff_eq.mp h3⟩

