def get_rule_for_C (C : ℕ) : Option (ℕ × ℕ) :=
  get_rule_for_C_generic my_rules C

theorem get_rule_for_C_correct (C A S : ℕ) (h : get_rule_for_C C = some (A, S)) :
    1 ≤ A ∧ 2 * A < C ∧ totient A * totient (C - A) = S ^ 2 := by
  exact get_rule_for_C_generic_correct my_rules C A S h

def check_single_rule (n : ℕ) (p : ℕ) (k : ℕ) : Option (ℕ × ℕ × ℕ) :=
  if n % (k * p) = 0 then
    match get_rule_for_C (k * p) with
    | some (A, S) =>
      if Coprime A (n / (k * p)) && Coprime ((k * p) - A) (n / (k * p)) then
        some (k * p, A, S)
      else none
    | none => none
  else none

theorem check_single_rule_correct (n : ℕ) (p : ℕ) (k : ℕ) (C A S : ℕ)
    (h_res : check_single_rule n p k = some (C, A, S)) (h_n : 9 ≤ n) :
    a n > 0 := by
  unfold check_single_rule at h_res
  split_ifs at h_res with h_mod
  · match h_match : get_rule_for_C (k * p) with
    | none =>
      rw [h_match] at h_res
      contradiction
    | some (A_val, S_val) =>
      rw [h_match] at h_res
      dsimp only at h_res
      split_ifs at h_res with h_cop
      · injection h_res with h_pair
        injection h_pair with hC h_pair2
        injection h_pair2 with hA hS
        cases hC
        cases hA
        cases hS
        have h_rule := get_rule_for_C_correct (k * p) A S h_match
        rw [Bool.and_eq_true] at h_cop
        have h_cop_right : Coprime A (n / (k * p)) ∧ Coprime (k * p - A) (n / (k * p)) := by
          exact ⟨of_decide_eq_true h_cop.1, of_decide_eq_true h_cop.2⟩
        have h_cond : n % (k * p) = 0 ∧ Coprime A (n / (k * p)) ∧ Coprime ((k * p) - A) (n / (k * p)) := ⟨h_mod, h_cop_right.1, h_cop_right.2⟩
        exact solve_branch_helper n (k * p) A S h_cond h_n h_rule.1 h_rule.2.1 h_rule.2.2

def check_prime_rules (n : ℕ) (p : ℕ) : Option (ℕ × ℕ × ℕ) :=
  match check_single_rule n p 1 with
  | some res => some res
  | none =>
  match check_single_rule n p 2 with
  | some res => some res
  | none =>
  match check_single_rule n p 4 with
  | some res => some res
  | none =>
  match check_single_rule n p 8 with
  | some res => some res
  | none =>
  match check_single_rule n p 16 with
  | some res => some res
  | none =>
  match check_single_rule n p 32 with
  | some res => some res
  | none => none

theorem check_prime_rules_correct (n : ℕ) (p : ℕ) (C A S : ℕ)
    (h_res : check_prime_rules n p = some (C, A, S)) (h_n : 9 ≤ n) :
    a n > 0 := by
  unfold check_prime_rules at h_res
  match h0 : check_single_rule n p 1 with
  | some res =>
    rw [h0] at h_res
    injection h_res with h_eq
    subst h_eq
    exact check_single_rule_correct n p 1 C A S h0 h_n
  | none =>
    rw [h0] at h_res
    dsimp only at h_res
    match h1 : check_single_rule n p 2 with
    | some res =>
      rw [h1] at h_res
      injection h_res with h_eq
      subst h_eq
      exact check_single_rule_correct n p 2 C A S h1 h_n
    | none =>
      rw [h1] at h_res
      dsimp only at h_res
      match h2 : check_single_rule n p 4 with
      | some res =>
        rw [h2] at h_res
        injection h_res with h_eq
        subst h_eq
        exact check_single_rule_correct n p 4 C A S h2 h_n
      | none =>
        rw [h2] at h_res
        dsimp only at h_res
        match h3 : check_single_rule n p 8 with
        | some res =>
          rw [h3] at h_res
          injection h_res with h_eq
          subst h_eq
          exact check_single_rule_correct n p 8 C A S h3 h_n
        | none =>
          rw [h3] at h_res
          dsimp only at h_res
          match h4 : check_single_rule n p 16 with
          | some res =>
            rw [h4] at h_res
            injection h_res with h_eq
            subst h_eq
            exact check_single_rule_correct n p 16 C A S h4 h_n
          | none =>
            rw [h4] at h_res
            dsimp only at h_res
            match h5 : check_single_rule n p 32 with
            | some res =>
              rw [h5] at h_res
              injection h_res with h_eq
              subst h_eq
              exact check_single_rule_correct n p 32 C A S h5 h_n
            | none =>
              rw [h5] at h_res
              contradiction


def get_exception_witness (n : ℕ) : ℕ × ℕ :=
  match binarySearch n my_exceptions 57206 9 with
  | some idx =>
    let k := get3Bytes my_exceptions (idx * 9 + 3)
    let S := get3Bytes my_exceptions (idx * 9 + 6)
    (k, S)
  | none => (0, 0)

def has_witness (n : ℕ) : Bool :=
  let ks := get_exception_witness n
  let k := ks.1
  let S := ks.2
  (k > 0) && (k ≤ (n - 1) / 2) && (totient k * totient (n - k) == S ^ 2)

theorem a_pos_of_has_witness (n : ℕ) (h : has_witness n = true) : a n > 0 := by
  unfold has_witness at h
  rw [Bool.and_eq_true] at h
  rcases h with ⟨h_and1, h_eq⟩
  rw [Bool.and_eq_true] at h_and1
  rcases h_and1 with ⟨h_k1_bool, h_k2_bool⟩
  have h_k1 : 0 < (get_exception_witness n).1 := of_decide_eq_true h_k1_bool
  have h_k1_le : 1 ≤ (get_exception_witness n).1 := h_k1
  have h_k2 : (get_exception_witness n).1 ≤ (n - 1) / 2 := of_decide_eq_true h_k2_bool
  have h_sq : totient (get_exception_witness n).1 * totient (n - (get_exception_witness n).1) = (get_exception_witness n).2 ^ 2 := by
    rwa [beq_iff_eq] at h_eq
  have h_sq_sqrt : sqrt (totient (get_exception_witness n).1 * totient (n - (get_exception_witness n).1)) ^ 2 = totient (get_exception_witness n).1 * totient (n - (get_exception_witness n).1) := by
    rw [h_sq, sqrt_eq']
  exact a_pos_of_exists n (get_exception_witness n).1 h_k1_le h_k2 h_sq_sqrt

def factorLoop (n : Nat) (d : Nat) (fuel : Nat) : List Nat :=
  match fuel with
  | 0 => []
  | fuel + 1 =>
    if n <= 1 then []
    else if d * d > n then [n]
    else if n % d = 0 then
      d :: factorLoop (n / d) d fuel
    else if d = 2 then
      factorLoop n 3 fuel
    else
      factorLoop n (d + 2) fuel

def get_prime_factors (n : Nat) : List Nat :=
  factorLoop n 2 1000

def find_working_prime (n : ℕ) : List ℕ → Option (ℕ × ℕ × ℕ)
  | [] => none
  | p :: ps =>
    if p < 5 then find_working_prime n ps
    else
      match check_prime_rules n p with
      | some (C, A, S) => some (C, A, S)
      | none => find_working_prime n ps

theorem find_working_prime_correct (n : ℕ) (factors : List ℕ) (C A S : ℕ)
    (h_solve : find_working_prime n factors = some (C, A, S)) (h_n : 9 ≤ n) :
    a n > 0 := by
  induction factors with
  | nil =>
    unfold find_working_prime at h_solve
    nomatch h_solve
  | cons p ps ih =>
    unfold find_working_prime at h_solve
    split_ifs at h_solve with hp5
    · exact ih h_solve
    · match h_match : check_prime_rules n p with
      | some (C', A', S') =>
        rw [h_match] at h_solve
        dsimp only at h_solve
        rcases Option.some.inj h_solve with ⟨rfl, rfl, rfl⟩
        exact check_prime_rules_correct n p C A S h_match h_n
      | none =>
        rw [h_match] at h_solve
        dsimp only at h_solve
        exact ih h_solve

def has_valid_witness_or_rule (n : ℕ) : Bool :=
  if n < 9 || n > 2000000 then false
  else if n % 3 == 0 then true
  else if n % 10 == 0 then true
  else
    match find_working_prime n (get_prime_factors n) with
    | some _ => true
    | none => has_witness n

theorem a_pos_of_valid_witness_or_rule (n : ℕ) (h_n : 9 ≤ n ∧ n ≤ 2 * 10^6) (h : has_valid_witness_or_rule n = true) : a n > 0 := by
  unfold has_valid_witness_or_rule at h
  split_ifs at h with h_or h_mod3 h_mod10
  · -- n % 3 == 0
    have h_eq : 3 * (n / 3) = n := Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero (beq_iff_eq.mp h_mod3))
    rw [← h_eq]
    exact a_pos_of_mul_three (n / 3) (by omega)
  · -- n % 10 == 0
    have h_eq : 10 * (n / 10) = n := Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero (beq_iff_eq.mp h_mod10))
    rw [← h_eq]
    exact a_pos_of_mul_ten (n / 10) (by omega)
  · -- find_working_prime or has_witness
    match h_match : find_working_prime n (get_prime_factors n) with
    | some (C, A, S) =>
      exact find_working_prime_correct n (get_prime_factors n) C A S h_match h_n.1
    | none =>
      rw [h_match] at h
      dsimp only at h
      exact a_pos_of_has_witness n h

def check_range_loop (L : ℕ) (len : ℕ) : Bool :=
  match len with
  | 0 => true
  | len + 1 =>
    if has_valid_witness_or_rule L then
      check_range_loop (L + 1) len
    else
      false

theorem check_range_loop_correct (L len : ℕ) (h : check_range_loop L len = true) :
    ∀ n, L ≤ n → n < L + len → has_valid_witness_or_rule n = true := by
  induction len generalizing L with
  | zero =>
    intro n h_low h_high
    omega
  | succ len ih =>
    unfold check_range_loop at h
    split_ifs at h with h_cond
    · intro n h_low h_high
      rcases eq_or_lt_of_le h_low with rfl | h_gt
      · exact h_cond
      · have h_low2 : L + 1 ≤ n := h_gt
        have h_high2 : n < L + 1 + len := by omega
        exact ih (L + 1) h n h_low2 h_high2

theorem has_valid_witness_or_rule_range_9_1999 (n : ℕ) (h_low : 9 ≤ n) (h_high : n ≤ 1999) : has_valid_witness_or_rule n = true := by
  have h_lt : n < 9 + 1991 := by omega
  exact check_range_loop_correct 9 1991 (by decide) n h_low h_lt

theorem has_valid_witness_or_rule_range_2000_3999 (n : ℕ) (h_low : 2000 ≤ n) (h_high : n ≤ 3999) : has_valid_witness_or_rule n = true := by
  have h_lt : n < 2000 + 2000 := by omega
  exact check_range_loop_correct 2000 2000 (by decide) n h_low h_lt

