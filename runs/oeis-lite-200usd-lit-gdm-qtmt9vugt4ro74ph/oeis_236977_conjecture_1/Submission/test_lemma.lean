def my_rules_str_1 : String := ""
def my_rules_str_2 : String := ""
def my_rules_str_3 : String := ""
def my_rules_str_4 : String := ""
def my_rules_str_5 : String := ""
@[irreducible] def my_rules : ByteArray :=
  hexToByteArray my_rules_str_0 ++ hexToByteArray my_rules_str_1 ++ hexToByteArray my_rules_str_2 ++ hexToByteArray my_rules_str_3 ++ hexToByteArray my_rules_str_4 ++ hexToByteArray my_rules_str_5


