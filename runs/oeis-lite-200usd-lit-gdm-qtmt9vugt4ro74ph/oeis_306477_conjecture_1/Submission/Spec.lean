lemma sum_pos_of_exists {ι : Type*} {s : Finset ι} {f : ι → ℕ}
  (h_exists : ∃ i ∈ s, 0 < f i) : 0 < ∑ i ∈ s, f i := by
  rcases h_exists with ⟨i, hi, h_pos⟩
  rw [← add_sum_erase s f hi]
  omega

private def find_choose_bound (k : ℕ) (n : ℕ) (bound : ℕ) : ℕ :=
  (List.range (bound + 2)).foldl (fun acc i =>
    if (i + k - 1).choose k ≤ n then i + 1 else acc
  ) 0

