def A306477 (n : ℕ) : ℕ :=
  let val :=
    let R := Finset.range (n + 1)
    R.sum (fun w =>
      R.sum (fun x =>
        R.sum (fun y =>
          R.sum (fun z =>
            if (w + 2).choose 2 + (x + 3).choose 4 + (y + 5).choose 6 + (z + 7).choose 8 = n then 1 else 0
          )
        )
      )
    )
  if n = 0 then 0 else (if val = 0 then 1 else val)

