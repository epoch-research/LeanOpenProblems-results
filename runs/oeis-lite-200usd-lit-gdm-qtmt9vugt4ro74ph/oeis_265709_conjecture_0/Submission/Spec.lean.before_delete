lemma padicValRat_two_sum_divisors_pow_odd_prime_le (p : ℕ) (hp : p.Prime) (hp_odd : p % 2 = 1) (a : ℕ) (ha : a ≥ 1) :
  padicValRat 2 ((p^a).divisors.sum fun d => (1 : ℚ) / (↑((sigma 1) d) : ℚ)) ≤ - (padicValNat 2 (p + 1) : ℤ) := by
  rw [sum_divisors_pow_prime p hp a]
