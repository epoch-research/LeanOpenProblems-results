  rw [Finset.mem_Icc] at hk0_in
  let k0 := 2 ^ Nat.log 2 K
  have hk0_eq : k0 = 2 ^ Nat.log 2 K := rfl
  let i0 := k0 - 1
  have hk0_def : i0 + 1 = k0 := by omega
  let j0 := 2 * i0 + 1
  have hj0_in : j0 ∈ range (a + 1) := by
    rw [Finset.mem_range]
    have : 2 * k0 ≤ a + 1 := by
