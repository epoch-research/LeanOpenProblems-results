    intro j
    have hp_fact : Fact p.Prime := ⟨hp⟩
    rw [sigma_one_pow_prime p j]
    have h_sum_ge : (∑ x ∈ range (j + 1), p^x) ≥ 1 := by
      rw [sum_range_succ']
      have : p^0 = 1 := rfl
      rw [this]
      have : (∑ x ∈ range j, p^(x+1)) ≥ 0 := by
        apply sum_nonneg
        intro x _
        positivity
      omega
    have h_cast : (↑(∑ x ∈ range (j + 1), p^x) : ℚ) ≥ 1 := by
      exact_mod_cast h_sum_ge
    positivity
