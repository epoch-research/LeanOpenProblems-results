def SunflowerReduction.OriginalTarget : Prop :=
∃ c, ∀ (n k : ℕ), 0 < n → SunflowerFoundation.f n k < c k ^ n
def SunflowerReduction.UniformFreeBound : ℕ → ℕ → Prop :=
fun k C =>
  ∀ (n : ℕ),
    0 < n →
      ∀ {α : Type} (F : Finset (Set α)),
        (∀ A ∈ F, A.ncard = n) → (∀ A ∈ F, A.Finite) → ¬SunflowerFoundation.HasSunflower F k → F.card ≤ C ^ n
def SunflowerReduction.AbsoluteProfile.{u_1} : {α : Type u_1} → Finset (Set α) → ℕ → ℕ → Prop :=
fun {α} F m r => r ^ m < F.card ∧ ∀ (U : Finset α), U.Nonempty → SunflowerReduction.codegree F U ≤ r ^ (m - U.card)
def SunflowerReduction.AbsoluteProfileSunflower : ℕ → ℕ → Prop :=
fun k r =>
  ∀ (m : ℕ),
    0 < m →
      ∀ {α : Type} (F : Finset (Set α)),
        (∀ A ∈ F, A.ncard = m) →
          (∀ A ∈ F, A.Finite) → SunflowerReduction.AbsoluteProfile F m r → SunflowerFoundation.HasSunflower F k
SunflowerReduction.originalTarget_iff_uniformFreeBound :
  SunflowerReduction.OriginalTarget ↔ ∀ (k : ℕ), ∃ C, SunflowerReduction.UniformFreeBound k C
SunflowerReduction.exists_maximal_large_link.{u_1} {α : Type u_1} (F : Finset (Set α)) (n r : ℕ)
  (hfinite : ∀ A ∈ F, A.Finite) (hlarge : r ^ n < F.card) :
  ∃ T, Maximal (fun T => r ^ (n - T.card) < (SunflowerReduction.link F T).card) T
SunflowerReduction.exists_free_absolute_profile_link.{u_1} {α : Type u_1} (F : Finset (Set α)) (n k r : ℕ)
  (hfinite : ∀ A ∈ F, A.Finite) (huniform : ∀ A ∈ F, A.ncard = n) (hfree : ¬SunflowerFoundation.HasSunflower F k)
  (hlarge : r ^ n < F.card) :
  ∃ T,
    T.card < n ∧
      (∀ A ∈ SunflowerReduction.link F T, A.Finite) ∧
        (∀ A ∈ SunflowerReduction.link F T, A.ncard = n - T.card) ∧
          ¬SunflowerFoundation.HasSunflower (SunflowerReduction.link F T) k ∧
            SunflowerReduction.AbsoluteProfile (SunflowerReduction.link F T) (n - T.card) r
SunflowerReduction.originalTarget_iff_absoluteProfileSunflower :
  SunflowerReduction.OriginalTarget ↔ ∀ (k : ℕ), ∃ r, SunflowerReduction.AbsoluteProfileSunflower k r
