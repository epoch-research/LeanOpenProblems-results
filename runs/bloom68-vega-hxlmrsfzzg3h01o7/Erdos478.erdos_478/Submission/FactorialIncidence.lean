import Mathlib

/-!
# An elementary reduction from factorial residues to Cartesian-product incidences

For a finite subset `A` of a field, avoiding zero, let `T A` count the triples
`(a,b,c) ∈ A³` with `a*c = a*b + b²`.  We use the canonical coefficient-pair
representation `(slope, intercept)` of the nonvertical affine line
`y = slope*x + intercept`.

This file proves the finite algebra and counting reduction only.  In particular,
no Stevens–de Zeeuw incidence estimate is assumed here, and no asymptotic bound
for factorial support (or conjecture about its density) is claimed.
-/

set_option autoImplicit false

namespace FactorialIncidence

open Finset

noncomputable section

variable {K : Type*} [Field K]

/-- The third coordinate determined by the first two coordinates of a triple. -/
def value (a b : K) : K := b + b ^ 2 / a

/-- The admissible second coordinates for a fixed first coordinate. -/
def fiber (A : Finset K) (a : K) : Finset K := by
  classical
  exact A.filter (fun b => value a b ∈ A)

/-- `r(a) = #{b ∈ A : b + b²/a ∈ A}`. -/
def r (A : Finset K) (a : K) : ℕ := (fiber A a).card

/-- The actual set of ordered triples, not triples with multiplicity. -/
def tripleSet (A : Finset K) : Finset (K × K × K) := by
  classical
  exact (A ×ˢ (A ×ˢ A)).filter (fun t => t.1 * t.2.2 = t.1 * t.2.1 + t.2.1 ^ 2)

/-- The number of solutions of `ac = ab + b²` in `A³`. -/
def T (A : Finset K) : ℕ := (tripleSet A).card

@[simp] lemma mem_fiber (A : Finset K) (a b : K) :
    b ∈ fiber A a ↔ b ∈ A ∧ value a b ∈ A := by
  classical
  simp [fiber]

@[simp] lemma mem_tripleSet (A : Finset K) (a b c : K) :
    (a, b, c) ∈ tripleSet A ↔
      a ∈ A ∧ b ∈ A ∧ c ∈ A ∧ a * c = a * b + b ^ 2 := by
  classical
  simp [tripleSet, and_assoc]

lemma mul_value {a : K} (ha : a ≠ 0) (b : K) :
    a * value a b = a * b + b ^ 2 := by
  dsimp [value]
  field_simp

lemma value_eq_iff {a b c : K} (ha : a ≠ 0) :
    value a b = c ↔ a * c = a * b + b ^ 2 := by
  constructor
  · intro h
    simpa only [h] using mul_value ha b
  · intro h
    apply mul_left_cancel₀ ha
    exact (mul_value ha b).trans h.symm

lemma value_sub (a b : K) : value a b - b = b ^ 2 / a := by
  simp [value]

lemma value_sub_ne_zero {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) :
    value a b - b ≠ 0 := by
  rw [value_sub]
  exact div_ne_zero (pow_ne_zero 2 hb) ha

/-- The injective reconstruction used when counting off-diagonal witnesses. -/
lemma reconstruct_a {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) :
    b ^ 2 / (value a b - b) = a := by
  rw [value_sub]
  field_simp

lemma reconstruct_of_triple {a b c : K} (ha : a ≠ 0) (hb : b ≠ 0)
    (h : a * c = a * b + b ^ 2) : c - b ≠ 0 ∧ a = b ^ 2 / (c - b) := by
  have hc := (value_eq_iff ha).2 h
  simpa only [hc] using
    And.intro (value_sub_ne_zero ha hb) (reconstruct_a ha hb).symm

lemma T_eq_sum_r (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    T A = ∑ a ∈ A, r A a := by
  classical
  have hcard : (A.sigma (fun a => fiber A a)).card = (tripleSet A).card := by
    apply card_bij (fun ab _ => (ab.1, ab.2, value ab.1 ab.2))
    · intro ab hab
      obtain ⟨ha, hb⟩ := mem_sigma.mp hab
      obtain ⟨hb, hc⟩ := (mem_fiber _ _ _).mp hb
      exact (mem_tripleSet _ _ _ _).mpr ⟨ha, hb, hc, mul_value (hA _ ha) _⟩
    · rintro ⟨a, b⟩ hab ⟨a', b'⟩ hab' h
      have ha : a = a' := congrArg Prod.fst h
      have hb : b = b' := congrArg (fun t : K × K × K => t.2.1) h
      subst a'
      subst b'
      rfl
    · rintro ⟨a, b, c⟩ ht
      obtain ⟨ha, hb, hc, he⟩ := (mem_tripleSet _ _ _ _).mp ht
      have hv : value a b = c := (value_eq_iff (hA _ ha)).2 he
      refine ⟨⟨a, b⟩, mem_sigma.mpr ⟨ha, (mem_fiber _ _ _).mpr ⟨hb, ?_⟩⟩, ?_⟩
      · simpa only [hv] using hc
      · simp only [hv]
  exact hcard.symm.trans (card_sigma _ _)

lemma r_le_card (A : Finset K) (a : K) : r A a ≤ A.card := by
  classical
  exact card_filter_le _ _

lemma T_le_card_sq (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) : T A ≤ A.card ^ 2 := by
  rw [T_eq_sum_r A hA]
  calc
    _ ≤ ∑ _a ∈ A, A.card := sum_le_sum (fun a _ => r_le_card A a)
    _ = A.card ^ 2 := by simp [sq]

/-- The ratio attached to an ordered generator `(b,b')`. -/
def ratio (bb : K × K) : K := bb.2 / bb.1

/-- The line generated by `(b,b')`: slope `(b'/b)²`, intercept `b' - b'²/b`. -/
def generatorLine (bb : K × K) : K × K :=
  ((ratio bb) ^ 2, bb.2 - bb.2 ^ 2 / bb.1)

/-- The set of distinct lines, generated only by off-diagonal ordered pairs. -/
def lineSet (A : Finset K) : Finset (K × K) := by
  classical
  exact A.offDiag.image generatorLine

/-- Point-line incidence for a coefficient pair representing a nonvertical line. -/
def OnLine (l xy : K × K) : Prop := xy.2 = l.1 * xy.1 + l.2

/-- The incidence set of the Cartesian product `A × A` with the distinct lines `L`. -/
def incidenceSet (A : Finset K) (L : Finset (K × K)) :
    Finset ((K × K) × (K × K)) := by
  classical
  exact ((A ×ˢ A) ×ˢ L).filter (fun pl => OnLine pl.2 pl.1)

/-- `I(A × A,L)`, counting each point-line pair once. -/
def I (A : Finset K) (L : Finset (K × K)) : ℕ := (incidenceSet A L).card

lemma intercept_factor (bb : K × K) :
    (generatorLine bb).2 = bb.2 * (1 - ratio bb) := by
  dsimp [generatorLine, ratio]
  ring

lemma ratio_ne_one {bb : K × K} (hb : bb.1 ≠ 0) (hdiag : bb.1 ≠ bb.2) :
    ratio bb ≠ 1 := by
  intro h
  exact hdiag ((div_eq_one_iff_eq hb).mp h).symm

/-- Equality of coefficient pairs reduces to equality up to sign of the ratios. -/
lemma generatorLine_eq_iff (bb dd : K × K) :
    generatorLine bb = generatorLine dd ↔
      (ratio bb = ratio dd ∨ ratio bb = -ratio dd) ∧
        bb.2 * (1 - ratio bb) = dd.2 * (1 - ratio dd) := by
  rw [Prod.ext_iff]
  change (ratio bb ^ 2 = ratio dd ^ 2 ∧
      (generatorLine bb).2 = (generatorLine dd).2) ↔ _
  rw [sq_eq_sq_iff_eq_or_eq_neg, intercept_factor, intercept_factor]

/-- For an off-diagonal nonzero generator, the line and ratio recover both entries. -/
lemma generator_eq_of_line_eq_of_ratio_eq {bb dd : K × K}
    (hb : bb.1 ≠ 0) (hb' : bb.2 ≠ 0) (hd : dd.1 ≠ 0)
    (hdiag : bb.1 ≠ bb.2) (hl : generatorLine bb = generatorLine dd)
    (hr : ratio bb = ratio dd) : bb = dd := by
  have he := ((generatorLine_eq_iff bb dd).mp hl).2
  rw [← hr] at he
  have hsnd : bb.2 = dd.2 :=
    mul_right_cancel₀ (sub_ne_zero.mpr (ratio_ne_one hb hdiag).symm) he
  have hfst : bb.1 = dd.1 := by
    apply mul_left_cancel₀ (div_ne_zero hb' hb)
    calc
      ratio bb * bb.1 = bb.2 := div_mul_cancel₀ _ hb
      _ = dd.2 := hsnd
      _ = ratio bb * dd.1 := by rw [hr]; exact (div_mul_cancel₀ _ hd).symm
  exact Prod.ext hfst hsnd

/-- Exact collision characterization: aside from the identical generator, the ratios
must be negatives, with the same intercept.  This also applies in characteristic two. -/
lemma generatorLine_eq_iff_eq_or_neg_ratio {bb dd : K × K}
    (hb : bb.1 ≠ 0) (hb' : bb.2 ≠ 0) (hd : dd.1 ≠ 0) (hdiag : bb.1 ≠ bb.2) :
    generatorLine bb = generatorLine dd ↔
      bb = dd ∨ (ratio bb = -ratio dd ∧
        bb.2 * (1 - ratio bb) = dd.2 * (1 - ratio dd)) := by
  constructor
  · intro hl
    rcases (generatorLine_eq_iff bb dd).mp hl with ⟨hr | hr, he⟩
    · exact Or.inl (generator_eq_of_line_eq_of_ratio_eq hb hb' hd hdiag hl hr)
    · exact Or.inr ⟨hr, he⟩
  · rintro (rfl | ⟨hr, he⟩)
    · rfl
    · exact (generatorLine_eq_iff bb dd).mpr ⟨Or.inr hr, he⟩

open scoped Classical in
/-- Every distinct line has at most two off-diagonal generators in `A²`. -/
lemma line_fiber_card_le_two (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) (l : K × K) :
    (A.offDiag.filter (fun bb => generatorLine bb = l)).card ≤ 2 := by
  classical
  let S := A.offDiag.filter (fun bb => generatorLine bb = l)
  change S.card ≤ 2
  by_cases hS : S.Nonempty
  · obtain ⟨q, hq⟩ := hS
    have hql : generatorLine q = l := (mem_filter.mp hq).2
    calc
      S.card ≤ ({ratio q, -ratio q} : Finset K).card := by
        apply card_le_card_of_injOn ratio
        · intro bb hbb
          have hbl : generatorLine bb = l := (mem_filter.mp hbb).2
          have hr := ((generatorLine_eq_iff bb q).mp (hbl.trans hql.symm)).1
          change ratio bb ∈ ({ratio q, -ratio q} : Finset K)
          simpa only [mem_insert, mem_singleton] using hr
        · intro bb hbb dd hdd hr
          obtain ⟨hbbA, hbl⟩ := mem_filter.mp hbb
          obtain ⟨hddA, hdl⟩ := mem_filter.mp hdd
          obtain ⟨hb, hb', hdiag⟩ := mem_offDiag.mp hbbA
          obtain ⟨hd, hd', hdiag'⟩ := mem_offDiag.mp hddA
          exact generator_eq_of_line_eq_of_ratio_eq (hA _ hb) (hA _ hb')
            (hA _ hd) hdiag (hbl.trans hdl.symm) hr
      _ ≤ 2 := card_le_two
  · rw [not_nonempty_iff_eq_empty.mp hS]
    simp

/-- Cross-multiplied lower bound; stronger than the floor-division version. -/
lemma offDiag_card_le_two_mul_lines (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    A.card * (A.card - 1) ≤ 2 * (lineSet A).card := by
  classical
  have h := card_le_mul_card_image (f := generatorLine) A.offDiag 2
    (fun l _ => line_fiber_card_le_two A hA l)
  simpa only [lineSet, offDiag_card, Nat.mul_sub_left_distrib, mul_one] using h

lemma line_card_le_offDiag (A : Finset K) :
    (lineSet A).card ≤ A.card * (A.card - 1) := by
  classical
  have h := card_image_le (s := A.offDiag) (f := generatorLine)
  simpa only [lineSet, offDiag_card, Nat.mul_sub_left_distrib, mul_one] using h

lemma line_card_bounds (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    A.card * (A.card - 1) / 2 ≤ (lineSet A).card ∧
      (lineSet A).card ≤ A.card * (A.card - 1) :=
  ⟨Nat.div_le_of_le_mul (offDiag_card_le_two_mul_lines A hA), line_card_le_offDiag A⟩

/-- Coefficient pairs really distinguish lines as sets of field-valued points. -/
lemma line_eq_of_same_points {l k : K × K}
    (h : ∀ xy, OnLine l xy ↔ OnLine k xy) : l = k := by
  have he : l.2 = k.2 := by
    have hh := (h (0, l.2)).mp (by simp [OnLine])
    simpa [OnLine] using hh
  have hs : l.1 = k.1 := by
    have hh := (h (1, l.1 + l.2)).mp (by simp [OnLine])
    simp only [OnLine, mul_one] at hh
    rw [he] at hh
    exact add_right_cancel hh
  exact Prod.ext hs he

@[simp] lemma mem_incidenceSet (A : Finset K) (L : Finset (K × K)) (xy l : K × K) :
    (xy, l) ∈ incidenceSet A L ↔
      xy.1 ∈ A ∧ xy.2 ∈ A ∧ l ∈ L ∧ OnLine l xy := by
  classical
  simp [incidenceSet, and_assoc]

/-- Eliminating `a` from two triples gives the advertised affine line. -/
lemma onLine_generator {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) (b' : K) :
    OnLine (generatorLine (b, b')) (value a b, value a b') := by
  dsimp [OnLine, generatorLine, ratio, value]
  field_simp
  ring

/-- Off-diagonal pairs of admissible second coordinates, with their common `a`. -/
def offDiagWitnesses (A : Finset K) : Finset (Σ _a : K, K × K) :=
  A.sigma (fun a => (fiber A a).offDiag)

/-- The incidence associated to a witness `(a,b,b')`. -/
def witnessIncidence (w : Σ _a : K, K × K) : (K × K) × (K × K) :=
  ((value w.1 w.2.1, value w.1 w.2.2), generatorLine w.2)

lemma witnessIncidence_mem (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0)
    {w : Σ _a : K, K × K} (hw : w ∈ offDiagWitnesses A) :
    witnessIncidence w ∈ incidenceSet A (lineSet A) := by
  classical
  obtain ⟨ha, hbb⟩ := mem_sigma.mp hw
  obtain ⟨hb, hb', hdiag⟩ := mem_offDiag.mp hbb
  obtain ⟨hb, hc⟩ := (mem_fiber _ _ _).mp hb
  obtain ⟨hb', hc'⟩ := (mem_fiber _ _ _).mp hb'
  apply (mem_incidenceSet _ _ _ _).mpr
  refine ⟨hc, hc', ?_, onLine_generator (hA _ ha) (hA _ hb) _⟩
  exact mem_image.mpr ⟨w.2, mem_offDiag.mpr ⟨hb, hb', hdiag⟩, rfl⟩

/-- Fixing the generator and its incidence uniquely recovers the witness, because
`a = b²/(c-b)`. -/
lemma witness_eq_of_pair_and_incidence (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0)
    {u v : Σ _a : K, K × K} (hu : u ∈ offDiagWitnesses A)
    (hv : v ∈ offDiagWitnesses A) (hpair : u.2 = v.2)
    (hinc : witnessIncidence u = witnessIncidence v) : u = v := by
  have hua : u.1 ∈ A := (mem_sigma.mp hu).1
  have hva : v.1 ∈ A := (mem_sigma.mp hv).1
  have hub : u.2.1 ∈ A :=
    ((mem_fiber _ _ _).mp (mem_offDiag.mp (mem_sigma.mp hu).2).1).1
  have hvb : v.2.1 ∈ A :=
    ((mem_fiber _ _ _).mp (mem_offDiag.mp (mem_sigma.mp hv).2).1).1
  have hc : value u.1 u.2.1 = value v.1 v.2.1 :=
    congrArg (fun z : (K × K) × (K × K) => z.1.1) hinc
  have ha : u.1 = v.1 := by
    calc
      u.1 = u.2.1 ^ 2 / (value u.1 u.2.1 - u.2.1) :=
        (reconstruct_a (hA _ hua) (hA _ hub)).symm
      _ = v.2.1 ^ 2 / (value v.1 v.2.1 - v.2.1) := by rw [hc, hpair]
      _ = v.1 := reconstruct_a (hA _ hva) (hA _ hvb)
  exact Sigma.ext ha (heq_of_eq hpair)

open scoped Classical in
/-- At most two off-diagonal witnesses can produce a fixed incidence. -/
lemma witness_fiber_card_le_two (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0)
    (pl : (K × K) × (K × K)) :
    ((offDiagWitnesses A).filter (fun w => witnessIncidence w = pl)).card ≤ 2 := by
  classical
  apply le_trans _ (line_fiber_card_le_two A hA pl.2)
  apply card_le_card_of_injOn (fun w : Σ _a : K, K × K => w.2)
  · intro w hw
    obtain ⟨hw, he⟩ := mem_filter.mp hw
    have hsub : fiber A w.1 ⊆ A := filter_subset _ _
    exact mem_filter.mpr ⟨offDiag_mono hsub (mem_sigma.mp hw).2,
      congrArg Prod.snd he⟩
  · intro u hu v hv hpair
    exact witness_eq_of_pair_and_incidence A hA (mem_filter.mp hu).1
      (mem_filter.mp hv).1 hpair ((mem_filter.mp hu).2.trans (mem_filter.mp hv).2.symm)

lemma offDiagWitnesses_card_le_two_mul_I (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    (offDiagWitnesses A).card ≤ 2 * I A (lineSet A) := by
  classical
  exact card_le_mul_card_image_of_maps_to
    (fun w hw => witnessIncidence_mem A hA hw) 2
    (fun pl _ => witness_fiber_card_le_two A hA pl)

/-- Separate the diagonal `b=b'` from the second moment of `r`. -/
lemma sum_r_sq_eq_T_add_witnesses (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    (∑ a ∈ A, r A a ^ 2) = T A + (offDiagWitnesses A).card := by
  rw [T_eq_sum_r A hA, offDiagWitnesses, card_sigma, ← sum_add_distrib]
  apply sum_congr rfl
  intro a _
  change (fiber A a).card ^ 2 = (fiber A a).card + (fiber A a).offDiag.card
  rw [offDiag_card, sq]
  have h := Nat.le_mul_self (fiber A a).card
  omega

/-- The exact second-moment inequality, before invoking any incidence estimate. -/
theorem sum_r_sq_le_T_add_two_I (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    (∑ a ∈ A, r A a ^ 2) ≤ T A + 2 * I A (lineSet A) := by
  rw [sum_r_sq_eq_T_add_witnesses A hA]
  exact Nat.add_le_add_left (offDiagWitnesses_card_le_two_mul_I A hA) _

/-- Cauchy–Schwarz, entirely in the natural-number counting semiring. -/
theorem T_sq_le_card_mul_sum_r_sq (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    T A ^ 2 ≤ A.card * ∑ a ∈ A, r A a ^ 2 := by
  rw [T_eq_sum_r A hA]
  simpa using sum_mul_sq_le_sq_mul_sq A (fun _ => (1 : ℕ)) (r A)

/-- The sharp elementary reduction with the diagonal term still equal to `T`. -/
theorem exact_incidence_reduction (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    T A ^ 2 ≤ A.card * (T A + 2 * I A (lineSet A)) :=
  (T_sq_le_card_mul_sum_r_sq A hA).trans
    (Nat.mul_le_mul_left _ (sum_r_sq_le_T_add_two_I A hA))

/-- A convenient weaker form, using `T ≤ |A|²`. -/
theorem incidence_reduction (A : Finset K) (hA : ∀ a ∈ A, a ≠ 0) :
    T A ^ 2 ≤ A.card * (A.card ^ 2 + 2 * I A (lineSet A)) :=
  (exact_incidence_reduction A hA).trans
    (Nat.mul_le_mul_left _ (Nat.add_le_add_right (T_le_card_sq A hA) _))

/-! ## Specialization to factorial residues modulo a prime -/

/-- The support uses the conventional indices `1 ≤ n < p`. -/
def factorialSupport (p : ℕ) : Finset (ZMod p) :=
  (Ico 1 p).image (fun n => (n.factorial : ZMod p))

lemma factorial_ne_zero {p n : ℕ} [Fact p.Prime] (hn : n < p) :
    (n.factorial : ZMod p) ≠ 0 := by
  rw [Ne, ZMod.natCast_eq_zero_iff, (Fact.out : p.Prime).dvd_factorial]
  exact not_le.mpr hn

/-- In particular, index zero is allowed: its value equals that at index one. -/
lemma factorial_mem_support {p n : ℕ} [Fact p.Prime] (hn : n < p) :
    (n.factorial : ZMod p) ∈ factorialSupport p := by
  classical
  by_cases hn0 : n = 0
  · have hp := (Fact.out : p.Prime).two_le
    exact mem_image.mpr ⟨1, mem_Ico.mpr ⟨by omega, by omega⟩, by simp [hn0]⟩
  · exact mem_image.mpr ⟨n, mem_Ico.mpr ⟨by omega, hn⟩, rfl⟩

lemma support_ne_zero {p : ℕ} [Fact p.Prime] {a : ZMod p}
    (ha : a ∈ factorialSupport p) : a ≠ 0 := by
  obtain ⟨n, hn, rfl⟩ := mem_image.mp ha
  exact factorial_ne_zero (mem_Ico.mp hn).2

/-- Adding index zero does not change factorial support. -/
lemma factorialSupport_eq_range_image {p : ℕ} [Fact p.Prime] :
    factorialSupport p = (range p).image (fun n => (n.factorial : ZMod p)) := by
  classical
  apply Subset.antisymm
  · intro a ha
    obtain ⟨n, hn, rfl⟩ := mem_image.mp ha
    exact mem_image.mpr ⟨n, mem_range.mpr (mem_Ico.mp hn).2, rfl⟩
  · intro a ha
    obtain ⟨n, hn, rfl⟩ := mem_image.mp ha
    exact factorial_mem_support (mem_range.mp hn)

/-- This is the cardinality of the usual natural-number residue support. -/
lemma factorialSupport_card_eq_nat {p : ℕ} [Fact p.Prime] :
    (factorialSupport p).card =
      ((Ico 1 p).image (fun n => n.factorial % p)).card := by
  classical
  have h := card_image_of_injective (factorialSupport p) (ZMod.val_injective p)
  simpa [factorialSupport, image_image, Function.comp_def, ZMod.val_natCast] using h.symm

/-- Consecutive factorials satisfy the triple equation over any field. -/
lemma factorial_triple_identity (n : ℕ) :
    (n.factorial : K) * ((n + 2).factorial : K) =
      (n.factorial : K) * ((n + 1).factorial : K) + ((n + 1).factorial : K) ^ 2 := by
  simp only [show n + 2 = (n + 1) + 1 by omega, Nat.factorial_succ,
    Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  ring

/-- The triple at index `n` is `(n!, (n+1)!, (n+2)!)`. -/
def factorialTriple (p n : ℕ) : ZMod p × ZMod p × ZMod p :=
  ((n.factorial : ZMod p), ((n + 1).factorial : ZMod p), ((n + 2).factorial : ZMod p))

lemma factorialTriple_mem {p n : ℕ} [Fact p.Prime] (hn : n < p - 2) :
    factorialTriple p n ∈ tripleSet (factorialSupport p) := by
  apply (mem_tripleSet _ _ _ _).mpr
  exact ⟨factorial_mem_support (by omega), factorial_mem_support (by omega),
    factorial_mem_support (by omega), factorial_triple_identity n⟩

lemma factorial_succ_div {p n : ℕ} [Fact p.Prime] (hn : n < p) :
    ((n + 1).factorial : ZMod p) / (n.factorial : ZMod p) = ((n + 1 : ℕ) : ZMod p) := by
  rw [Nat.factorial_succ, Nat.cast_mul, mul_div_cancel_right₀ _ (factorial_ne_zero hn)]

/-- The ratio of the second and first coordinates recovers `n+1` modulo `p`;
the chosen integer range then recovers `n` itself. -/
lemma factorialTriple_injective {p n k : ℕ} [Fact p.Prime]
    (hn : n < p - 2) (hk : k < p - 2)
    (h : factorialTriple p n = factorialTriple p k) : n = k := by
  have hquot := congrArg (fun t : ZMod p × ZMod p × ZMod p => t.2.1 / t.1) h
  change ((n + 1).factorial : ZMod p) / (n.factorial : ZMod p) =
    ((k + 1).factorial : ZMod p) / (k.factorial : ZMod p) at hquot
  rw [factorial_succ_div (by omega : n < p), factorial_succ_div (by omega : k < p)] at hquot
  have hv := congrArg ZMod.val hquot
  simp only [ZMod.val_natCast, Nat.mod_eq_of_lt (by omega : n + 1 < p),
    Nat.mod_eq_of_lt (by omega : k + 1 < p)] at hv
  omega

/-- The `p-2` indices `0, …, p-3` give distinct triples in the support. -/
theorem factorial_T_lower_bound {p : ℕ} [Fact p.Prime] :
    p - 2 ≤ T (factorialSupport p) := by
  exact le_card_of_inj_on_range (factorialTriple p)
    (fun n hn => factorialTriple_mem hn)
    (fun n hn k hk h => factorialTriple_injective hn hk h)

/-- The factorial reduction with the exact diagonal contribution. -/
theorem factorial_exact_incidence_reduction {p : ℕ} [Fact p.Prime] :
    (p - 2) ^ 2 ≤ (factorialSupport p).card *
      (T (factorialSupport p) + 2 * I (factorialSupport p) (lineSet (factorialSupport p))) :=
  (pow_le_pow_left' (factorial_T_lower_bound (p := p)) 2).trans
    (exact_incidence_reduction (factorialSupport p) (fun _ ha => support_ne_zero ha))

/-- Main elementary factorial inequality, ready for a separately proved incidence bound.
There is no Stevens–de Zeeuw hypothesis or conclusion hidden in this statement. -/
theorem factorial_incidence_reduction {p : ℕ} [Fact p.Prime] :
    (p - 2) ^ 2 ≤ (factorialSupport p).card *
      ((factorialSupport p).card ^ 2 +
        2 * I (factorialSupport p) (lineSet (factorialSupport p))) :=
  (pow_le_pow_left' (factorial_T_lower_bound (p := p)) 2).trans
    (incidence_reduction (factorialSupport p) (fun _ ha => support_ne_zero ha))

/-- Both cardinality bounds for the distinct factorial-generated lines. -/
theorem factorial_line_card_bounds {p : ℕ} [Fact p.Prime] :
    (factorialSupport p).card * ((factorialSupport p).card - 1) ≤
        2 * (lineSet (factorialSupport p)).card ∧
      (lineSet (factorialSupport p)).card ≤
        (factorialSupport p).card * ((factorialSupport p).card - 1) :=
  ⟨offDiag_card_le_two_mul_lines (factorialSupport p) (fun _ ha => support_ne_zero ha),
    line_card_le_offDiag (factorialSupport p)⟩

end

end FactorialIncidence
