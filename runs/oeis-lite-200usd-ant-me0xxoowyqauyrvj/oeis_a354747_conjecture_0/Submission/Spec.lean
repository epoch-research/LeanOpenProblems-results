attribute [irreducible] Nn

open X in
theorem Nn_prime : Nn.Prime := by
  by_contra hcomp
  have hN1 : Nn ≠ 1 := Nat.ne_of_gt one_lt_Nn
  obtain ⟨q, hqdef⟩ : ∃ q, q = Nn.minFac := ⟨_, rfl⟩
  have hqprime : q.Prime := by rw [hqdef]; exact Nat.minFac_prime hN1
  have hq2 : 2 ≤ q := hqprime.two_le
  have hqN : q ∣ Nn := by rw [hqdef]; exact Nn.minFac_dvd
  haveI : NeZero q := ⟨by omega⟩
  haveI : Fact (1 < q) := ⟨by omega⟩
  set ω : X q := toR q (0, 1) with hω
  set ωinv : X q := ((pp : ZMod q), (-1 : ZMod q)) with hinv
  have hmul : ω * ωinv = 1 := by
    rw [hω, hinv]; ext <;> simp [toR]
  set ωu : (X q)ˣ := Units.mkOfMulEqOne ω ωinv hmul with hωu
  have hωu_coe : (ωu : X q) = ω := rfl
  have hB : citer mm (0, 1) = (, ) := chain_B
  have hBp : citer (mm - 1) (0, 1) = (, ) := chain_Bp
  have hpowN1 : cpow (, ) (2 * nn) = (1, 0) := pow_N1
  have hpow2 : cpow (, ) nn = (, 0) := pow_2
  have hpowN : cpow (, ) 2 = (, ) := pow_N
  have hpow3 : cpow (, ) (2 * nn) = (, ) := pow_3
  have key : ω ^ (3 ^ mm) = toR q (, ) := by
    rw [hω, ← toR_citer hqN mm (0, 1), hB]
  have keyP : ω ^ (3 ^ (mm - 1)) = toR q (, ) := by
    rw [hω, ← toR_citer hqN (mm - 1) (0, 1), hBp]
  have hbound : ∀ e : ℕ, e ≤ 2 * nn → e < 2 ^ 40 := by
    intro e he; have : nn < 2 ^ 39 := by unfold nn; norm_num
    calc e ≤ 2 * nn := he
      _ < 2 * 2 ^ 39 := by omega
      _ = 2 ^ 40 := by ring
  have e1 : ω ^ (Nn + 1) = 1 := by
    have hc := toR_cpow hqN (, ) (2 * nn) (hbound _ le_rfl)
    rw [Nadd1, show 2 * nn * 3 ^ mm = 3 ^ mm * (2 * nn) by ring, pow_mul, key,
        ← hc, hpowN1, toR_one]
  have hdiv2 : (Nn + 1) / 2 = nn * 3 ^ mm := by
    rw [Nadd1, show 2 * nn * 3 ^ mm = 2 * (nn * 3 ^ mm) by ring, Nat.mul_div_cancel_left _ (by norm_num)]
  have hdivn : (Nn + 1) / nn = 2 * 3 ^ mm := by
    rw [Nadd1, show 2 * nn * 3 ^ mm = nn * (2 * 3 ^ mm) by ring,
        Nat.mul_div_cancel_left _ (by have := one_le_nn; omega)]
  have hdiv3 : (Nn + 1) / 3 = 2 * nn * 3 ^ (mm - 1) := by
    rw [Nadd1, show 2 * nn * 3 ^ mm = 3 * (2 * nn * 3 ^ (mm - 1)) by rw [pow3_split]; ring,
        Nat.mul_div_cancel_left _ (by norm_num)]
  have ne2 : ω ^ ((Nn + 1) / 2) ≠ 1 := by
    have hc := toR_cpow hqN (, ) nn (hbound _ (by omega))
    rw [hdiv2, show nn * 3 ^ mm = 3 ^ mm * nn by ring, pow_mul, key, ← hc, hpow2]
    exact ne_one_of_gcd hq2 hqN  0 (by norm_num) gcd_2
  have neN : ω ^ ((Nn + 1) / nn) ≠ 1 := by
    have hc := toR_cpow hqN (, ) 2 (hbound _ (by have := one_le_nn; omega))
    rw [hdivn, show 2 * 3 ^ mm = 3 ^ mm * 2 by ring, pow_mul, key, ← hc, hpowN]
    exact ne_one_of_gcd hq2 hqN   (by norm_num) gcd_N
  have ne3 : ω ^ ((Nn + 1) / 3) ≠ 1 := by
    have hc := toR_cpow hqN (, ) (2 * nn) (hbound _ le_rfl)
    rw [hdiv3, show 2 * nn * 3 ^ (mm - 1) = 3 ^ (mm - 1) * (2 * nn) by ring, pow_mul, keyP,
        ← hc, hpow3]
    exact ne_one_of_gcd hq2 hqN   (by norm_num) gcd_3
  have hord : orderOf ωu = Nn + 1 := by
    apply orderOf_eq_of_pow_and_pow_div_prime (by omega)
    · apply Units.ext
      rw [Units.val_pow_eq_pow_val, hωu_coe, e1, Units.val_one]
    · intro p hp hpdvd
      rw [Nadd1] at hpdvd
      have hcases : p = 2 ∨ p = 3 ∨ p = nn := by
        rcases (Nat.Prime.dvd_mul hp).mp hpdvd with h | h
        · rcases (Nat.Prime.dvd_mul hp).mp h with h2 | h2
          · left; exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h2
          · right; right; exact (Nat.prime_dvd_prime_iff_eq hp nn_prime).mp h2
        · right; left
          exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp (hp.dvd_of_dvd_pow h)
      have lift : ∀ k : ℕ, ω ^ k ≠ 1 → ωu ^ k ≠ 1 := by
        intro k hk hcontra
        apply hk
