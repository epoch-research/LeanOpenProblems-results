import FormalConjectures.Util.ProblemImports

open Nat Set

open Lean Elab Tactic Meta in
/-- Close a goal `lhs = rhs` by `Eq.refl rhs`, deferring the defeq check to the kernel.
This produces an ordinary proof term (no extra axioms); the kernel performs the
definitional-equality check, which can handle deeper reductions than the elaborator. -/
elab "kernel_rfl" : tactic => do
  let goal ← getMainGoal
  let ty ← instantiateMVars (← goal.getType)
  match ty.eq? with
  | some (_, _lhs, rhs) => goal.assign (← mkEqRefl rhs)
  | none => throwError "kernel_rfl: goal is not an equality"

/--
A354747: Start with $2n-1$; repeatedly triple and add 2 until reaching a prime.
$a(n)$ = number of steps until reaching a prime $> 2n-1$, or 0 if no prime is ever reached.
Equivalently, $a(n)$ is the smallest $m \ge 1$ such that $2 \cdot n \cdot 3^m - 1$ is prime.
-/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

namespace A354747Cert

set_option maxRecDepth 100000

def pp : ℕ := 4
def nn : ℕ := 100943
def mm : ℕ := 39101
def Nn : ℕ := 2 * nn * 3 ^ mm - 1

/-- The ring `ZMod q [x] / (x^2 - pp x + 1)`, represented as `ZMod q × ZMod q`. -/
def X (q : ℕ) := ZMod q × ZMod q

namespace X
variable {q : ℕ}

instance : Inhabited (X q) := inferInstanceAs (Inhabited (ZMod q × ZMod q))
instance : DecidableEq (X q) := inferInstanceAs (DecidableEq (ZMod q × ZMod q))
instance : AddCommGroup (X q) := inferInstanceAs (AddCommGroup (ZMod q × ZMod q))

@[ext] theorem ext {a b : X q} (h1 : a.1 = b.1) (h2 : a.2 = b.2) : a = b := Prod.ext h1 h2

@[simp] theorem zero_fst : (0 : X q).1 = 0 := rfl
@[simp] theorem zero_snd : (0 : X q).2 = 0 := rfl
@[simp] theorem add_fst (a b : X q) : (a + b).1 = a.1 + b.1 := rfl
@[simp] theorem add_snd (a b : X q) : (a + b).2 = a.2 + b.2 := rfl
@[simp] theorem neg_fst (a : X q) : (-a).1 = -a.1 := rfl
@[simp] theorem neg_snd (a : X q) : (-a).2 = -a.2 := rfl

instance : Mul (X q) where
  mul a b := (a.1 * b.1 - a.2 * b.2, a.1 * b.2 + a.2 * b.1 + (pp : ZMod q) * (a.2 * b.2))
@[simp] theorem mul_fst (a b : X q) : (a * b).1 = a.1 * b.1 - a.2 * b.2 := rfl
@[simp] theorem mul_snd (a b : X q) : (a * b).2 = a.1 * b.2 + a.2 * b.1 + (pp : ZMod q) * (a.2 * b.2) := rfl

instance : One (X q) where one := ⟨1, 0⟩
@[simp] theorem one_fst : (1 : X q).1 = 1 := rfl
@[simp] theorem one_snd : (1 : X q).2 = 0 := rfl

instance : Monoid (X q) :=
  { inferInstanceAs (Mul (X q)), inferInstanceAs (One (X q)) with
    mul_assoc := fun a b c => by ext <;> dsimp <;> ring
    one_mul := fun a => by ext <;> simp
    mul_one := fun a => by ext <;> simp }

instance : NatCast (X q) where natCast n := ⟨n, 0⟩
@[simp] theorem fst_natCast (n : ℕ) : (n : X q).fst = (n : ZMod q) := rfl
@[simp] theorem snd_natCast (n : ℕ) : (n : X q).snd = (0 : ZMod q) := rfl

instance : AddGroupWithOne (X q) :=
  { inferInstanceAs (Monoid (X q)), inferInstanceAs (AddCommGroup (X q)),
      inferInstanceAs (NatCast (X q)) with
    natCast_zero := by ext <;> simp
    natCast_succ := fun _ => by ext <;> simp
    intCast := fun n => ⟨n, 0⟩
    intCast_ofNat := fun n => by ext <;> simp
    intCast_negSucc := fun n => by ext <;> simp }

theorem left_distrib (a b c : X q) : a * (b + c) = a * b + a * c := by ext <;> dsimp <;> ring
theorem right_distrib (a b c : X q) : (a + b) * c = a * c + b * c := by ext <;> dsimp <;> ring

instance : CommRing (X q) :=
  { inferInstanceAs (AddGroupWithOne (X q)), inferInstanceAs (AddCommGroup (X q)),
      inferInstanceAs (Monoid (X q)) with
    left_distrib := left_distrib
    right_distrib := right_distrib
    mul_zero := fun _ => by ext <;> simp
    zero_mul := fun _ => by ext <;> simp
    mul_comm := fun a b => by ext <;> dsimp <;> ring }

instance [NeZero q] : Fintype (X q) := inferInstanceAs (Fintype (ZMod q × ZMod q))

instance [Fact (1 < q)] : Nontrivial (X q) :=
  ⟨⟨0, 1, fun h => by simpa using congrArg Prod.fst h⟩⟩

theorem card_eq [NeZero q] : Fintype.card (X q) = q ^ 2 := by
  show Fintype.card (ZMod q × ZMod q) = q ^ 2
  rw [Fintype.card_prod, ZMod.card, sq]

/-- Cast a concrete `ℕ × ℕ` pair into the ring `X q`. -/
def toR (q : ℕ) (a : ℕ × ℕ) : X q := ((a.1 : ZMod q), (a.2 : ZMod q))

@[simp] theorem toR_fst (q : ℕ) (a : ℕ × ℕ) : (toR q a).1 = (a.1 : ZMod q) := rfl
@[simp] theorem toR_snd (q : ℕ) (a : ℕ × ℕ) : (toR q a).2 = (a.2 : ZMod q) := rfl

end X

theorem one_le_nn : 1 ≤ nn := by unfold nn; norm_num
theorem one_le_mm : 1 ≤ mm := by unfold mm; norm_num
theorem nn_prime : nn.Prime := by unfold nn; norm_num

theorem two_le_prod : 2 ≤ 2 * nn * 3 ^ mm := by
  have h1 : 1 ≤ nn := one_le_nn
  have h2 : 1 ≤ 3 ^ mm := Nat.one_le_pow _ _ (by norm_num)
  calc 2 = 2 * 1 * 1 := by ring
  _ ≤ 2 * nn * 3 ^ mm := by gcongr

theorem Nn_pos : 0 < Nn := by have := two_le_prod; simp only [Nn]; omega

def cmul (a b : ℕ × ℕ) : ℕ × ℕ :=
  ( ((a.1 * b.1) % Nn + Nn - (a.2 * b.2) % Nn) % Nn,
    ((a.1 * b.2) % Nn + (a.2 * b.1) % Nn + (pp * (a.2 * b.2)) % Nn) % Nn )

def ccube (a : ℕ × ℕ) : ℕ × ℕ := cmul (cmul a a) a

def citer : ℕ → ℕ × ℕ → ℕ × ℕ
  | 0, a => a
  | (k+1), a => ccube (citer k a)

theorem citer_add (a b : ℕ) (x : ℕ × ℕ) : citer (a + b) x = citer a (citer b x) := by
  induction a with
  | zero => rw [Nat.zero_add]; rfl
  | succ a ih =>
      rw [Nat.succ_add]
      show ccube (citer (a + b) x) = ccube (citer a (citer b x))
      rw [ih]

def cpowAux : ℕ → (ℕ × ℕ) → ℕ → ℕ × ℕ
  | 0, _, _ => (1, 0)
  | (f+1), a, e =>
      if e = 0 then (1, 0)
      else
        let h := cpowAux f a (e / 2)
        if e % 2 = 0 then cmul h h else cmul (cmul h h) a

def cpow (a : ℕ × ℕ) (e : ℕ) : ℕ × ℕ := cpowAux 40 a e

namespace X
variable {q : ℕ}

theorem castmod [NeZero q] (hq : q ∣ Nn) (x : ℕ) : ((x % Nn : ℕ) : ZMod q) = (x : ZMod q) := by
  have hN0 : (Nn : ZMod q) = 0 := by rw [ZMod.natCast_eq_zero_iff]; exact hq
  conv_rhs => rw [← Nat.div_add_mod x Nn]
  push_cast [hN0]
  ring

theorem toR_cmul [NeZero q] (hq : q ∣ Nn) (a b : ℕ × ℕ) :
    (toR q (cmul a b)) = toR q a * toR q b := by
  have hle : (a.2 * b.2) % Nn ≤ (a.1 * b.1) % Nn + Nn :=
    le_trans (le_of_lt (Nat.mod_lt _ Nn_pos)) (Nat.le_add_left _ _)
  ext
  · show ((((a.1 * b.1) % Nn + Nn - (a.2 * b.2) % Nn) % Nn : ℕ) : ZMod q)
        = (a.1 : ZMod q) * b.1 - (a.2 : ZMod q) * b.2
    rw [castmod hq, Nat.cast_sub hle]
    push_cast [castmod hq]
    have hN0 : (Nn : ZMod q) = 0 := by rw [ZMod.natCast_eq_zero_iff]; exact hq
    rw [hN0]; ring
  · show ((((a.1 * b.2) % Nn + (a.2 * b.1) % Nn + (pp * (a.2 * b.2)) % Nn) % Nn : ℕ) : ZMod q)
        = (a.1 : ZMod q) * b.2 + (a.2 : ZMod q) * b.1 + (pp : ZMod q) * ((a.2 : ZMod q) * b.2)
    rw [castmod hq]
    push_cast [castmod hq]
    ring

theorem toR_one [NeZero q] : toR q (1, 0) = 1 := by ext <;> simp [toR]

theorem toR_ccube [NeZero q] (hq : q ∣ Nn) (a : ℕ × ℕ) : toR q (ccube a) = (toR q a)^3 := by
  rw [ccube, toR_cmul hq, toR_cmul hq]; ring

theorem toR_citer [NeZero q] (hq : q ∣ Nn) (k : ℕ) (a : ℕ × ℕ) :
    toR q (citer k a) = (toR q a) ^ (3 ^ k) := by
  induction k with
  | zero => simp [citer]
  | succ k ih => rw [citer, toR_ccube hq, ih, ← pow_mul, pow_succ]

theorem toR_cpowAux [NeZero q] (hq : q ∣ Nn) (a : ℕ × ℕ) :
    ∀ f e, e < 2 ^ f → toR q (cpowAux f a e) = (toR q a) ^ e := by
  intro f
  induction f with
  | zero =>
    intro e he
    have : e = 0 := by simpa using he
    subst this; simp [cpowAux, toR_one]
  | succ f ih =>
    intro e he
    have htwo : (2 : ℕ) ^ (f + 1) = 2 * 2 ^ f := by rw [pow_succ]; ring
    by_cases he0 : e = 0
    · subst he0; simp [cpowAux, toR_one]
    · have hhalf : e / 2 < 2 ^ f := by omega
      have hih := ih (e / 2) hhalf
      rw [cpowAux]
      simp only [he0, if_false]
      by_cases hpar : e % 2 = 0
      · simp only [hpar, if_true]
        rw [toR_cmul hq, hih, ← pow_add]
        congr 1; omega
      · simp only [hpar, if_false]
        rw [toR_cmul hq, toR_cmul hq, hih, ← pow_add, ← pow_succ]
        congr 1; omega

theorem toR_cpow [NeZero q] (hq : q ∣ Nn) (a : ℕ × ℕ) (e : ℕ) (he : e < 2 ^ 40) :
    toR q (cpow a e) = (toR q a) ^ e := by
  rw [cpow]; exact toR_cpowAux hq a 40 e he

theorem ne_one_of_gcd {q : ℕ} [NeZero q] (hq2 : 2 ≤ q) (hqN : q ∣ Nn) (s t : ℕ) (hs : 1 ≤ s)
    (hgcd : Nat.gcd Nn (Nat.gcd (s - 1) t) = 1) : toR q (s, t) ≠ 1 := by
  intro h
  have h1 : (s : ZMod q) = 1 := by have := congrArg Prod.fst h; simpa [toR] using this
  have h2 : (t : ZMod q) = 0 := by have := congrArg Prod.snd h; simpa [toR] using this
  have hqs : q ∣ (s - 1) := by
    have : ((s - 1 : ℕ) : ZMod q) = 0 := by rw [Nat.cast_sub hs]; simp [h1]
    exact (ZMod.natCast_eq_zero_iff _ _).mp this
  have hqt : q ∣ t := (ZMod.natCast_eq_zero_iff _ _).mp h2
  have hqgg : q ∣ Nat.gcd Nn (Nat.gcd (s - 1) t) := Nat.dvd_gcd hqN (Nat.dvd_gcd hqs hqt)
  rw [hgcd] at hqgg
  have := Nat.le_of_dvd one_pos hqgg
  omega

end X

theorem pow3_split : 3 ^ mm = 3 * 3 ^ (mm - 1) := by
  conv_lhs => rw [show mm = (mm - 1) + 1 by have := one_le_mm; omega]
  rw [pow_succ]; ring

theorem one_lt_Nn : 1 < Nn := by
  have h1 : 1 ≤ nn := one_le_nn
  have h2 : 3 ≤ 3 ^ mm := by
    calc 3 = 3 ^ 1 := (pow_one 3).symm
    _ ≤ 3 ^ mm := Nat.pow_le_pow_right (by norm_num) one_le_mm
  have : 6 ≤ 2 * nn * 3 ^ mm := by
    calc 6 = 2 * 1 * 3 := by ring
    _ ≤ 2 * nn * 3 ^ mm := by gcongr
  simp only [Nn]; omega

theorem Nadd1 : Nn + 1 = 2 * nn * 3 ^ mm := by have := two_le_prod; simp only [Nn]; omega

