import FormalConjectures.Util.ProblemImports
open Nat Finset
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
set_option Elab.async false
set_option linter.all false
set_option linter.unnecessarySeqFocus false
def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

def stripPow : Nat → Nat → Nat → Nat × Nat
  | 0, _, m => (m, 1)
  | (F+1), d, m => if d ∣ m then (let r := stripPow F d (m / d); (r.1, r.2 * d)) else (m, 1)

theorem stripPow_spec (d : Nat) (hd : 2 ≤ d) :
    ∀ (F m : Nat), 1 ≤ m → m ≤ F →
      let r := stripPow F d m
      m = r.1 * r.2 ∧ ¬ d ∣ r.1 ∧ ∃ v, r.2 = d ^ v := by
  intro F
  induction F with
  | zero => intro m hm hmF; omega
  | succ F ih =>
    intro m hm hmF
    by_cases hdvd : d ∣ m
    · have hmd : 1 ≤ m / d := by
        rcases hdvd with ⟨k, rfl⟩
        have hk : 1 ≤ k := by
          rcases Nat.eq_zero_or_pos k with h | h
          · simp [h] at hm
          · exact h
        rw [Nat.mul_div_cancel_left _ (by omega)]; exact hk
      have hmdF : m / d ≤ F := by
        have : m / d < m := Nat.div_lt_self (by omega) (by omega)
        omega
      obtain ⟨he, hnd, v, hv⟩ := ih (m / d) hmd hmdF
      have hred : stripPow (F+1) d m
          = ((stripPow F d (m / d)).1, (stripPow F d (m / d)).2 * d) := by
        simp only [stripPow, hdvd, if_true]
      rw [hred]
      refine ⟨?_, hnd, ⟨v + 1, by rw [hv]; ring⟩⟩
      rw [← mul_assoc, ← he, Nat.div_mul_cancel hdvd]
    · have hred : stripPow (F+1) d m = (m, 1) := by
        simp only [stripPow, hdvd, if_false]
      rw [hred]; exact ⟨by ring, hdvd, ⟨0, by simp⟩⟩

def tot : Nat → Nat → Nat → Nat
  | 0, _, _ => 1
  | (F+1), d, m =>
      if m ≤ 1 then 1
      else if m < d * d then m - 1
      else
        let d' := if d = 2 then 3 else d + 2
        if d ∣ m then
          let r := stripPow m d m
          (r.2 - r.2 / d) * tot F d' r.1
        else tot F d' m

-- helper: m has a nontrivial factorization forcing d*d ≤ m when not prime and minFac ≥ d
theorem tot_eq (M : Nat) :
    ∀ F d m, 2 ≤ d → 1 ≤ m → m ≤ M → m + M ≤ F + d →
      (d = 2 ∨ (d % 2 = 1 ∧ m % 2 = 1)) →
      (∀ p, p.Prime → p ∣ m → d ≤ p) →
      tot F d m = Nat.totient m := by
  intro F
  induction F with
  | zero =>
    intro d m hd hm hmM hsum hodd hpf
    have hm1 : m = 1 := by
      by_contra hne
      have hm2 : 2 ≤ m := by omega
      have hpp := Nat.minFac_prime (show m ≠ 1 by omega)
      have hpd := Nat.minFac_dvd m
      have := hpf _ hpp hpd
      have hle := Nat.minFac_le (show 0 < m by omega)
      omega
    subst hm1; simp [tot]
  | succ F ih =>
    intro d m hd hm hmM hsum hodd hpf
    by_cases hm1 : m ≤ 1
    · have : m = 1 := by omega
      subst this; simp [tot]
    · have hm2 : 2 ≤ m := by omega
      by_cases hsq : m < d * d
      · have hred : tot (F+1) d m = m - 1 := by
          simp only [tot]; rw [if_neg hm1, if_pos hsq]
        rw [hred]
        have hmprime : m.Prime := by
          rw [Nat.prime_def_minFac]
          refine ⟨by omega, ?_⟩
          by_contra hne
          have hpd := Nat.minFac_dvd m
          have hpp := Nat.minFac_prime (show m ≠ 1 by omega)
          have hpge := hpf _ hpp hpd
          have hlt : m.minFac < m := lt_of_le_of_ne (Nat.minFac_le (by omega)) hne
          have hcdvd : m / m.minFac ∣ m := Nat.div_dvd_of_dvd hpd
          have hc : m = m.minFac * (m / m.minFac) := (Nat.mul_div_cancel' hpd).symm
          have hcge2 : 2 ≤ m / m.minFac := by
            have hpos : 0 < m / m.minFac := Nat.div_pos (Nat.minFac_le (by omega)) (Nat.minFac_pos m)
            rcases Nat.lt_or_ge (m / m.minFac) 2 with h | h
            · have : m / m.minFac = 1 := by omega
              rw [this, mul_one] at hc; omega
            · exact h
          have hqp := Nat.minFac_prime (show m / m.minFac ≠ 1 by omega)
          have hqd := Nat.minFac_dvd (m / m.minFac)
          have hqm : (m / m.minFac).minFac ∣ m := hqd.trans hcdvd
          have hqge : d ≤ (m / m.minFac).minFac := hpf _ hqp hqm
          have hple : m.minFac ≤ (m / m.minFac).minFac :=
            Nat.minFac_le_of_dvd hqp.two_le hqm
          have hqle : (m / m.minFac).minFac ≤ m / m.minFac :=
            Nat.minFac_le (by omega)
          have h1 : m.minFac * (m / m.minFac).minFac ≤ m.minFac * (m / m.minFac) :=
            Nat.mul_le_mul_left _ hqle
          have h2 : d * d ≤ m.minFac * (m / m.minFac).minFac :=
            Nat.mul_le_mul hpge (le_trans hpge hple)
          have : d * d ≤ m := by rw [hc]; omega
          omega
        rw [Nat.totient_prime hmprime]
      · have hmdd : d * d ≤ m := by omega
        -- define d'
        set d' := if d = 2 then 3 else d + 2 with hd'
        have hd'ge : d + 1 ≤ d' := by rw [hd']; split <;> omega
        have hd'2 : 2 ≤ d' := by omega
        have hd'le : d' ≤ d * d := by rw [hd']; split <;> nlinarith [hd]
        have hdlt : d' ≤ M := by omega
        by_cases hdvd : d ∣ m
        · have hdp : d.Prime := by
            have hpp := Nat.minFac_prime (show d ≠ 1 by omega)
            have hpd : d.minFac ∣ d := Nat.minFac_dvd d
            have hpm : d.minFac ∣ m := hpd.trans hdvd
            have hge : d ≤ d.minFac := hpf _ hpp hpm
            have hle : d.minFac ≤ d := Nat.minFac_le (by omega)
            rw [Nat.prime_def_minFac]; exact ⟨by omega, le_antisymm hle hge⟩
          obtain ⟨he, hnd, v, hv⟩ := stripPow_spec d hd m m (by omega) (le_refl m)
          set c := (stripPow m d m).1 with hcdef
          set q := (stripPow m d m).2 with hqdef
          have hred : tot (F+1) d m = (q - q / d) * tot F d' c := by
            simp only [tot]; rw [if_neg hm1, if_neg hsq, if_pos hdvd]
          rw [hred]
          have hv1 : 1 ≤ v := by
            rcases Nat.eq_zero_or_pos v with h0 | h0
            · exfalso; rw [h0, pow_zero] at hv
              rw [hv, mul_one] at he; exact hnd (he ▸ hdvd)
            · exact h0
          have hqval : q = d ^ v := hv
          have htotq : Nat.totient q = q - q / d := by
            obtain ⟨w, rfl⟩ : ∃ w, v = w + 1 := ⟨v - 1, by omega⟩
            rw [hqval, Nat.totient_prime_pow_succ hdp]
            rw [pow_succ, Nat.mul_div_cancel _ (by omega : 0 < d)]
            rw [Nat.mul_sub_one]
          have hcop : Nat.Coprime q c := by
            rw [hqval]
            exact (Nat.Coprime.pow_left v ((hdp.coprime_iff_not_dvd).mpr hnd))
          have hcge1 : 1 ≤ c := by
            rcases Nat.eq_zero_or_pos c with h0 | h0
            · rw [h0, zero_mul] at he; omega
            · exact h0
          have hqge2 : 2 ≤ q := by
            rw [hqval]; calc 2 ≤ d := hd
              _ ≤ d ^ v := Nat.le_self_pow (by omega) d
          have hclt : c < m := by
            rw [he]; nlinarith [hcge1, hqge2]
          -- c's prime factors: ≥ d, ≠ d, and oddness
          have hcdm : c ∣ m := ⟨q, he⟩
          have hpfc : ∀ p, p.Prime → p ∣ c → d' ≤ p := by
            intro p hp hpc
            have hpm : p ∣ m := hpc.trans hcdm
            have hpge : d ≤ p := hpf p hp hpm
            have hpne : p ≠ d := by rintro rfl; exact hnd hpc
            rcases hodd with hde2 | ⟨hdo, hmo⟩
            · subst hde2
              have hd'3 : d' = 3 := by rw [hd']; decide
              rcases hp.eq_two_or_odd with h2 | hodd2
              · exact absurd h2 hpne
              · omega
            · have hd'v : d' = d + 2 := by rw [hd', if_neg (show d ≠ 2 by omega)]
              rcases hp.eq_two_or_odd with h2 | hpo
              · exfalso; have : (2 : Nat) ∣ m := h2 ▸ hpm; omega
              · omega
          have hmo' : c % 2 = 1 := by
            rcases hodd with hde2 | ⟨hdo, hmo⟩
            · subst hde2; omega
            · rcases Nat.even_or_odd c with hce | hco
              · exfalso
                obtain ⟨j, hj⟩ := hce
                have h2c : (2:Nat) ∣ c := ⟨j, by omega⟩
                have : (2:Nat) ∣ m := h2c.trans hcdm
                omega
              · exact Nat.odd_iff.mp hco
          have hodd' : d' = 2 ∨ (d' % 2 = 1 ∧ c % 2 = 1) := by
            right
            refine ⟨?_, hmo'⟩
            rcases hodd with hde2 | ⟨hdo, hmo⟩
            · subst hde2; rw [hd']; decide
            · rw [hd', if_neg (show d ≠ 2 by omega)]; omega
          have hih : tot F d' c = Nat.totient c := by
            apply ih d' c hd'2 hcge1 (by omega) (by omega) hodd' hpfc
          rw [hih, ← htotq, ← Nat.totient_mul hcop, mul_comm q c, ← he]
        · have hred : tot (F+1) d m = tot F d' m := by
            simp only [tot]; rw [if_neg hm1, if_neg hsq, if_neg hdvd]
          rw [hred]
          have hpfm : ∀ p, p.Prime → p ∣ m → d' ≤ p := by
            intro p hp hpm
            have hpge : d ≤ p := hpf p hp hpm
            have hpne : p ≠ d := by rintro rfl; exact hdvd hpm
            rcases hodd with hde2 | ⟨hdo, hmo⟩
            · subst hde2
              have hd'3 : d' = 3 := by rw [hd']; decide
              rcases hp.eq_two_or_odd with h2 | hpo
              · exact absurd h2 hpne
              · omega
            · have hd'v : d' = d + 2 := by rw [hd', if_neg (show d ≠ 2 by omega)]
              rcases hp.eq_two_or_odd with h2 | hpo
              · exfalso; have : (2:Nat) ∣ m := h2 ▸ hpm; omega
              · omega
          have hodd' : d' = 2 ∨ (d' % 2 = 1 ∧ m % 2 = 1) := by
            right
            rcases hodd with hde2 | ⟨hdo, hmo⟩
            · subst hde2
              refine ⟨by rw [hd']; decide, ?_⟩
              omega
            · exact ⟨by rw [hd', if_neg (show d ≠ 2 by omega)]; omega, hmo⟩
          apply ih d' m hd'2 hm hmM (by omega) hodd' hpfm

def myTot (n : Nat) : Nat := if n = 0 then 0 else tot (2 * n + 2) 2 n

theorem myTot_eq (n : Nat) : myTot n = Nat.totient n := by
  unfold myTot
  by_cases hn : n = 0
  · subst hn; simp
  · rw [if_neg hn]
    have hn1 : 1 ≤ n := by omega
    apply tot_eq n (2 * n + 2) 2 n (le_refl 2) hn1 (le_refl n) (by omega) (Or.inl rfl)
    intro p hp hpn; exact hp.two_le


def sqrtIter (m : Nat) : Nat → Nat → Nat
  | 0, x => x
  | Nat.succ fuel, x =>
    let x' := (x + m / x) / 2
    if x' < x then sqrtIter m fuel x' else x

def mySqrt (m : Nat) : Nat := if m ≤ 1 then m else sqrtIter m 100 (min (m / 2 + 1) 2097152)

-- fuel-based gcd
def myGcd : Nat → Nat → Nat → Nat
  | 0, a, _ => a
  | (F+1), a, b => if a = 0 then b else myGcd F (b % a) a

theorem myGcd_eq : ∀ F a b, a < F → myGcd F a b = Nat.gcd a b := by
  intro F
  induction F with
  | zero => intro a b h; omega
  | succ F ih =>
    intro a b h
    by_cases ha : a = 0
    · subst ha; simp [myGcd, Nat.gcd_zero_left]
    · have hpos : 0 < a := by omega
      have hmod : b % a < a := Nat.mod_lt _ hpos
      have e : myGcd (F+1) a b = myGcd F (b % a) a := by simp [myGcd, ha]
      rw [e, ih (b % a) a (by omega), Nat.gcd_rec a b]

-- The scaling soundness lemma.
-- store (s, t0); if t0 = 0, it's "direct" with t = n - s.
def verifyS (n s t0 : Nat) : Bool :=
  let t := if t0 = 0 then n - s else t0
  let cc := n / (s + t)
  decide (1 ≤ s) && decide (s < t) && decide ((s + t) ∣ n) &&
  decide (myGcd (cc + 1) cc s = 1) && decide (myGcd (cc + 1) cc t = 1) &&
  (let p := myTot s * myTot t; let q := mySqrt p; decide (q * q = p))

theorem verifyS_sound (n s t0 : Nat) (h : verifyS n s t0 = true) : a n > 0 := by
  unfold verifyS at h
  set t := if t0 = 0 then n - s else t0 with ht
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨hs1, hst⟩, hdvd⟩, hg1⟩, hg2⟩, hsq⟩ := h
  set c := n / (s + t) with hc
  have hdpos : 0 < s + t := by omega
  have hcn : c * (s + t) = n := Nat.div_mul_cancel hdvd
  -- coprimality
  have hcop1 : Nat.Coprime c s := by
    have := myGcd_eq (c + 1) c s (Nat.lt_succ_self c); rw [this] at hg1; exact hg1
  have hcop2 : Nat.Coprime c t := by
    have := myGcd_eq (c + 1) c t (Nat.lt_succ_self c); rw [this] at hg2; exact hg2
  -- c ≥ 1
  have hcge1 : 1 ≤ c := by
    rcases Nat.eq_zero_or_pos c with h0 | h0
    · exfalso; rw [h0, Nat.coprime_zero_left] at hcop2; omega
    · exact h0
  -- k = c * s
  set k := c * s with hk
  have hk1 : 1 ≤ k := by
    rw [hk]; exact Nat.one_le_iff_ne_zero.mpr (by positivity)
  -- n = c*s + c*t
  have hnsum : n = c * s + c * t := by rw [← hcn, Nat.mul_add]
  -- n - k = c * t
  have hnk : n - k = c * t := by omega
  -- bound 2k ≤ n - 1
  have hkt : c * s < c * t := by nlinarith [hcge1, hst]
  have h2k : 2 * k ≤ n - 1 := by omega
  -- totient computations
  set P := myTot s * myTot t with hP
  set r := mySqrt P with hr
  -- hsq : r * r = P
  have hst_tot : myTot s * myTot t = totient s * totient t := by rw [myTot_eq, myTot_eq]
  have key : totient s * totient t = r * r := by
    rw [← hst_tot, ← hP]; exact hsq.symm
  -- totient k * totient (n-k) = (totient c * r)^2
  have hprod : totient k * totient (n - k) = (totient c * r) ^ 2 := by
    rw [hk, hnk, Nat.totient_mul hcop1, Nat.totient_mul hcop2]
    rw [show totient c * totient s * (totient c * totient t)
          = (totient c) * (totient c) * (totient s * totient t) by ring, key]
    ring
  unfold a
  apply Finset.sum_pos'
  · intro i _; positivity
  · refine ⟨k, ?_, ?_⟩
    · rw [Finset.mem_Ico]; omega
    · simp only
      rw [hprod]
      have : Nat.sqrt ((totient c * r) ^ 2) = totient c * r := by
        rw [pow_two, Nat.sqrt_eq]
      rw [this]
      simp
theorem scale_sound (n c s t r : ℕ) (hn : n = c * (s + t)) (hc : 1 ≤ c)
    (hs : 1 ≤ s) (hst : s < t) (h1 : Nat.Coprime c s) (h2 : Nat.Coprime c t)
    (hr : Nat.totient s * Nat.totient t = r * r) : a n > 0 := by
  set k := c * s with hk
  have hk1 : 1 ≤ k := Nat.one_le_iff_ne_zero.mpr (by positivity)
  have hnsum : n = c * s + c * t := by rw [hn]; ring
  have hnk : n - k = c * t := by rw [hnsum, hk]; omega
  have hkt : c * s < c * t := by nlinarith [hc, hst]
  have h2k : 2 * k ≤ n - 1 := by rw [hk]; omega
  have hprod : totient k * totient (n - k) = (totient c * r) ^ 2 := by
    rw [hk, hnk, Nat.totient_mul h1, Nat.totient_mul h2]
    rw [show totient c * totient s * (totient c * totient t)
          = totient c * totient c * (totient s * totient t) by ring, hr]
    ring
  unfold a
  apply Finset.sum_pos'
  · intro i _; positivity
  · refine ⟨k, ?_, ?_⟩
    · rw [Finset.mem_Ico]; exact ⟨hk1, by omega⟩
    · simp only
      rw [hprod]
      have : Nat.sqrt ((totient c * r) ^ 2) = totient c * r := by rw [pow_two, Nat.sqrt_eq]
      rw [this]; simp

-- coprime helper
theorem cop_p (c p : ℕ) (hp : p.Prime) (h : ¬ p ∣ c) : Nat.Coprime c p := by
  rw [Nat.coprime_comm]; exact (hp.coprime_iff_not_dvd).mpr h

-- single packed code per element: code = s*8192 + t0 (t0<8192, s<32768), base B=2^28=268435456
def checkProg : Nat → Nat → Nat → Nat → Bool
  | _, _, _, 0 => true
  | n, step, D, (fuel+1) =>
      verifyS n (D % 268435456 / 8192) (D % 268435456 % 8192) && checkProg (n+step) step (D / 268435456) fuel
theorem chunkProg_sound : ∀ (fuel n step D : ℕ), checkProg n step D fuel = true →
    ∀ i, i < fuel → a (n + step * i) > 0 := by
  intro fuel
  induction fuel with
  | zero => intro n step D _ i hi; omega
  | succ f ih =>
    intro n step D hyp i hi
    rw [checkProg, Bool.and_eq_true] at hyp
    obtain ⟨hv, hr⟩ := hyp
    rcases Nat.eq_zero_or_pos i with h0 | hpos
    · subst h0; simpa using verifyS_sound n (D % 268435456 / 8192) (D % 268435456 % 8192) hv
    · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i-1, by omega⟩
      have e : n + step * (j+1) = (n+step) + step * j := by ring
      rw [e]
      exact ih (n+step) step (D / 268435456) hr j (by omega)
theorem ruleR_3 (n:ℕ) (h: n%420=3) (h9: 9≤n) : a n > 0 := by
  apply scale_sound n (n/3) 1 2 1
  · omega
  · omega
  · norm_num
  · norm_num
  · exact Nat.coprime_one_right (n/3)
  · show Nat.Coprime (n/3) 2
    have hc2 : ¬ (2 ∣ (n/3)) := by omega
    rw [show (2:ℕ) = 2^1 by norm_num]
    exact (cop_p (n/3) 2 (by norm_num) hc2)
  · rw [← myTot_eq, ← myTot_eq]; decide
