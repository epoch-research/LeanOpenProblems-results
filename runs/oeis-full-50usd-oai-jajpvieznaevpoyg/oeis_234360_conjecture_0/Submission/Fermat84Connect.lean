import FormalConjectures.Util.ProblemImports
private def powMod (a m e : ℕ) : ℕ :=
  Nat.binaryRec (1 % m)
    (fun b _ r =>
      let sq := (r * r) % m
      if b then (a * sq) % m else sq)
    e
axiom powMod_eq_test (a m e : ℕ) : powMod a m e = a ^ e % m
example (hp : Nat.Prime ()) : False := by
  have hndvd : ¬ ( ∣ 2) := by native_decide
  have hc : Nat.Coprime 2 () := (hp.coprime_iff_not_dvd).2 hndvd
  have hfer := Nat.ModEq.pow_card_sub_one_eq_one hp hc
  have hcalc : powMod 2 () (() - 1) ≠ 1 % () := by native_decide
  rw [powMod_eq_test] at hcalc
  exact hcalc hfer
