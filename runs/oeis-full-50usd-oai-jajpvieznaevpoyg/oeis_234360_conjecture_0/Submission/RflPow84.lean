import FormalConjectures.Util.ProblemImports
set_option maxRecDepth 1000000
set_option maxHeartbeats 20000000
private def powMod (a m e : ℕ) : ℕ :=
  Nat.binaryRec (1 % m)
    (fun b _ r =>
      let sq := (r * r) % m
      if b then (a * sq) % m else sq)
    e
example : powMod 2 () (() - 1) =  := by
  rfl
example :  ≠ 1 % () := by
  norm_num
