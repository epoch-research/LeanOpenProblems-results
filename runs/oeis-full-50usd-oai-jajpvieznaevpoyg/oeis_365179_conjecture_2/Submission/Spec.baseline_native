def commP (x y : P) : P := x⁻¹ * y⁻¹ * x * y
def x3 (u v : P) : P := commP v u
def x5 (u v : P) : P := commP (x3 u v) u
def x6 (u v : P) : P := u ^ 9
def exactOrders (u v : P) : Prop := u ^ 27 = 1 ∧ u ^ 9 ≠ 1 ∧ v ^ 3 = 1 ∧ v ≠ 1
def twoRels (u v : P) : Prop := commP (x5 u v) u = x6 u v ∧ commP (x3 u v) v = x5 u v * x6 u v
instance exactOrdersDecidable (u v : P) : Decidable (exactOrders u v) := by unfold exactOrders; infer_instance
instance twoRelsDecidable (u v : P) : Decidable (twoRels u v) := by unfold twoRels commP x3 x5 x6; infer_instance
instance allowedPredDecidable2 (q : P × P) : Decidable (exactOrders q.1 q.2 ∧ twoRels q.1 q.2) := by infer_instance
def AllowedPair := {q : P × P // exactOrders q.1 q.2 ∧ twoRels q.1 q.2}
instance : Fintype AllowedPair := Subtype.fintype _
theorem allowedPair_card : Fintype.card AllowedPair = 2187 := by native_decide
theorem exactOrders_ab : exactOrders a b := by native_decide
theorem twoRels_ab : twoRels a b := by native_decide
abbrev C2 := Multiplicative (ZMod 2)
abbrev Q := P × C2

def A : Q := (a, 1)
def B : Q := (b, 1)
def C : Q := (1, Multiplicative.ofAdd (1 : ZMod 2))

def commQ (x y : Q) : Q := x⁻¹ * y⁻¹ * x * y
def x3Q (u v : Q) : Q := commQ v u
def x5Q (u v : Q) : Q := commQ (x3Q u v) u
def x6Q (u v : Q) : Q := u ^ 9

def evalPairQ (u v : Q) (w : P) : Q :=
  let y3 := x3Q u v; let y5 := x5Q u v; let y6 := x6Q u v
  (((((u ^ expAt w.val 0) * (v ^ expAt w.val 1)) * (y3 ^ expAt w.val 2)) * (u ^ 3) ^ expAt w.val 3) * (y5 ^ expAt w.val 4)) * (y6 ^ expAt w.val 5)

def evalWordQ (u v c : Q) (q : Q) : Q :=
  let ppart := evalPairQ u v q.1
  if q.2 = 1 then ppart else ppart * c

theorem evalWordQ_ABC : ∀ q : Q, evalWordQ A B C q = q := by native_decide

theorem map_commQ (phi : MulAut Q) (x y : Q) : phi (commQ x y) = commQ (phi x) (phi y) := by
  unfold commQ
  rw [map_mul, map_mul, map_mul, map_inv, map_inv]

theorem map_evalPairQ (phi : MulAut Q) (u v : Q) (w : P) :
    phi (evalPairQ u v w) = evalPairQ (phi u) (phi v) w := by
  simp [evalPairQ, x3Q, x5Q, x6Q, map_commQ, map_mul, map_pow]

theorem map_evalWordQ (phi : MulAut Q) (q : Q) :
    phi (evalWordQ A B C q) = evalWordQ (phi A) (phi B) (phi C) q := by
  by_cases h : q.2 = 1
  · simp [evalWordQ, h, map_evalPairQ]
  · simp [evalWordQ, h, map_evalPairQ, map_mul]

noncomputable def qAutParam (i : Fin 2187) : MulAut Q :=
  { Equiv.prodCongr (autParam i).toEquiv (Equiv.refl C2) with
    map_mul' := by intro x y; ext <;> simp }

theorem qAutParam_inj : Function.Injective qAutParam := by
  intro i j h
  apply autParam_inj
  ext x
  have hh := congrArg (fun (phi : MulAut Q) => (phi (x, (1 : C2))).1) h
  simpa [qAutParam] using hh

theorem q_order27_fst : ∀ q : Q, q ^ 27 = 1 → q ^ 9 ≠ 1 → q.1 ^ 27 = 1 ∧ q.1 ^ 9 ≠ 1 := by native_decide
theorem q_order3_fst : ∀ q : Q, q ^ 3 = 1 → q ≠ 1 → q.1 ^ 3 = 1 ∧ q.1 ≠ 1 := by native_decide
theorem q_order27_snd : ∀ q : Q, q ^ 27 = 1 → q.2 = 1 := by native_decide
theorem q_order3_snd : ∀ q : Q, q ^ 3 = 1 → q.2 = 1 := by native_decide

theorem q_twoRels_images (phi : MulAut Q) : twoRels (phi A).1 (phi B).1 := by
  constructor
  · have r1 : commQ (x5Q A B) A = x6Q A B := by native_decide
    have mh := congrArg phi r1
    unfold x5Q x3Q x6Q at mh
    repeat rw [map_commQ] at mh
    repeat rw [map_pow] at mh
    have hh := congrArg Prod.fst mh
    change commP (x5 (phi A).1 (phi B).1) (phi A).1 = x6 (phi A).1 (phi B).1
    simpa [commQ, commP, x3Q, x5Q, x6Q, x3, x5, x6] using hh
  · have r2 : commQ (x3Q A B) B = x5Q A B * x6Q A B := by native_decide
    have mh := congrArg phi r2
    unfold x5Q x3Q x6Q at mh
    repeat rw [map_commQ] at mh
    repeat rw [map_pow] at mh
    rw [map_mul] at mh
    repeat rw [map_commQ] at mh
    have hh := congrArg Prod.fst mh
    change commP (x3 (phi A).1 (phi B).1) (phi B).1 = x5 (phi A).1 (phi B).1 * x6 (phi A).1 (phi B).1
    simpa [commQ, commP, x3Q, x5Q, x6Q, x3, x5, x6] using hh

def pairOfAutQ (phi : MulAut Q) : AllowedPair := by
  refine ⟨((phi A).1, (phi B).1), ?_, ?_⟩
  · have hA27 : (phi A) ^ 27 = 1 := by simpa [map_pow] using congrArg phi (by native_decide : A ^ 27 = 1)
    have hA9 : (phi A) ^ 9 ≠ 1 := by
      intro hbad
      have : A ^ 9 = 1 := by apply phi.injective; simpa [map_pow] using hbad
      exact (by native_decide : A ^ 9 ≠ 1) this
    have hB3 : (phi B) ^ 3 = 1 := by simpa [map_pow] using congrArg phi (by native_decide : B ^ 3 = 1)
    have hBne : phi B ≠ 1 := by
      intro hb
      have : B = 1 := by apply phi.injective; simpa using hb
      exact (by native_decide : B ≠ 1) this
    rcases q_order27_fst (phi A) hA27 hA9 with ⟨ha27,ha9⟩
    rcases q_order3_fst (phi B) hB3 hBne with ⟨hb3,hbne⟩
    exact ⟨ha27, ha9, hb3, hbne⟩
  · exact q_twoRels_images phi

theorem c_ne_one : C ≠ 1 := by native_decide
theorem c_sq : C ^ 2 = 1 := by native_decide

theorem unique_C (q : Q) (h2 : q ^ 2 = 1) (hne : q ≠ 1) : q = C := by
  revert q h2 hne
  native_decide

theorem aut_fixes_C (phi : MulAut Q) : phi C = C := by
  apply unique_C
  · simpa [map_pow] using congrArg phi c_sq
  · intro h
    apply c_ne_one
    apply phi.injective
    simpa using h

theorem image_A_snd (phi : MulAut Q) : (phi A).2 = 1 := by
  apply q_order27_snd
  simpa [map_pow] using congrArg phi (by native_decide : A ^ 27 = 1)

theorem image_B_snd (phi : MulAut Q) : (phi B).2 = 1 := by
  apply q_order3_snd
  simpa [map_pow] using congrArg phi (by native_decide : B ^ 3 = 1)

theorem pairOfAutQ_inj : Function.Injective pairOfAutQ := by
  intro phi psi h
  have hA1 : (phi A).1 = (psi A).1 := by simpa [pairOfAutQ] using congrArg (fun r : AllowedPair => r.1.1) h
  have hB1 : (phi B).1 = (psi B).1 := by simpa [pairOfAutQ] using congrArg (fun r : AllowedPair => r.1.2) h
  have hA : phi A = psi A := by ext <;> simp [hA1, image_A_snd phi, image_A_snd psi]
  have hB : phi B = psi B := by ext <;> simp [hB1, image_B_snd phi, image_B_snd psi]
  have hC : phi C = psi C := by rw [aut_fixes_C phi, aut_fixes_C psi]
  apply MulEquiv.ext
  intro q
  have r := evalWordQ_ABC q
  calc
    phi q = phi (evalWordQ A B C q) := by rw [r]
    _ = evalWordQ (phi A) (phi B) (phi C) q := map_evalWordQ phi q
    _ = evalWordQ (psi A) (psi B) (psi C) q := by rw [hA, hB, hC]
    _ = psi (evalWordQ A B C q) := (map_evalWordQ psi q).symm
    _ = psi q := by rw [r]

theorem card_autQ : Fintype.card (MulAut Q) = 2187 := by
  apply le_antisymm
  · calc
      Fintype.card (MulAut Q) ≤ Fintype.card AllowedPair := Fintype.card_le_of_injective pairOfAutQ pairOfAutQ_inj
      _ = 2187 := allowedPair_card
  · simpa using Fintype.card_le_of_injective qAutParam qAutParam_inj

