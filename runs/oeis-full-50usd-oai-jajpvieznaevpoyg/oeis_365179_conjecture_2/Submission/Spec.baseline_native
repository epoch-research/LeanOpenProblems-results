theorem oeis_365179_conjecture_2.disproof :
  ¬ (∀ (n : ℕ) (hn : 2 ≤ n),
    ∀ (G : Type u) [Group G] [Fintype G] [Fintype (MulAut G)],
      (Fintype.card (MulAut G) = A365179 n) →
      -- Part 1: Order relation, substituting p_n = Nat.nth Nat.Prime (n - 1)
      (Fintype.card G = A365179 n / Nat.nth Nat.Prime (n - 1)) ∧
      -- Part 2: Uniqueness up to isomorphism
      (Nat.nth Nat.Prime (n - 1) % 3 = 2 →
       ∀ (H : Type u) [Group H] [Fintype H] [Fintype (MulAut H)],
          Fintype.card (MulAut H) = A365179 n →
          Nonempty (G ≃* H))) := by
  intro h
  let G0 : Type u := ULift.{u} PAction.Q
  have hbad := (h 2 (by norm_num) G0 (by simpa [G0, PAction.A365179_two] using PAction.card_aut_ULift_Q)).1
  have hne : Fintype.card G0 ≠ A365179 2 / Nat.nth Nat.Prime (2 - 1) := by
    change Fintype.card (ULift.{u} PAction.Q) ≠ A365179 2 / Nat.nth Nat.Prime (2 - 1)
    rw [PAction.card_ULift_Q, PAction.A365179_two, PAction.nth_prime_one]
    norm_num
  exact hne hbad
