  toFun f := ((MulEquiv.ulift : ULift Q ≃* Q).symm.trans f).trans (MulEquiv.ulift : ULift Q ≃* Q)
  invFun g := ((MulEquiv.ulift : ULift Q ≃* Q).trans g).trans (MulEquiv.ulift : ULift Q ≃* Q).symm
  left_inv f := by ext x <;> rfl
