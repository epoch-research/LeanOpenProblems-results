theorem actWord_assoc (w : List (Fin 6)) : ∀ x y : P, actWord w (x * y) = x * actWord w y := by
  induction w with
  | nil => intro x y; rfl
  | cons k ks ih =>
      intro x y
      simp [actWord, List.foldl_cons]
      rw [assoc_gen k x y]
      change actWord ks (x * app k y) = x * actWord ks (app k y)
      exact ih x (app k y)
