import FormalConjectures.Util.ProblemImports
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

open Nat Real

/--
A318199: $a(n)$ is the largest integer $m$ such that $m^n \le n^{\mathrm{prime}(n)}$.
Equivalently, $a(n) = \lfloor n^{\mathrm{prime}(n)/n} \rfloor$.
-/
noncomputable def A318199 (n : ℕ) : ℕ :=
  if n = 0 then 0
  else
    -- The $n$-th prime (1-indexed) is Nat.nth Nat.Prime (n - 1).
    let p_n : ℕ := Nat.nth Nat.Prime (n - 1)

    -- Calculate result := n ^ (p_n / n) using Rpow.
    let result_real : ℝ := (n : ℝ) ^ ((p_n : ℝ) / n)

    -- Get $\lfloor x \rfloor$ as a Natural number.
    (Int.toNat (floor result_real))

/-- Ceiling division, used by the segmented sieve below. -/
def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b

/-- Mark array entries in an arithmetic progression as composite. -/
partial def markStep (a : Array Bool) (j step : Nat) : Array Bool :=
  if j < a.size then markStep (a.set! j false) (j + step) step else a

/-- In a segment of odd numbers whose first value is `lowVal`, mark multiples of odd primes. -/
partial def markPrimesInSegment (a : Array Bool) (p n lowVal : Nat) : Array Bool :=
  if p * p < n then
    let a := if Nat.Prime p then
      let start0 := max (p * p) lowVal
      let q := ceilDiv start0 p
      let m := if q % 2 = 0 then (q + 1) * p else q * p
      let j := (m - lowVal) / 2
      markStep a j p
    else a
    markPrimesInSegment a (p + 2) n lowVal
  else a

def countTrueLoop (a : Array Bool) (i acc : Nat) : Nat :=
  if _h : i < a.size then countTrueLoop a (i + 1) (if a.getD i false then acc + 1 else acc)
  else acc
termination_by a.size - i

def segSize : Nat := 100000

/-- Segmented odd sieve count of primes below `n`; used as efficient compiled code only. -/
partial def segLoop (n idx totalLen acc : Nat) : Nat :=
  if idx < totalLen then
    let len := min segSize (totalLen - idx)
    let lowVal := 2 * idx + 3
    let a := Array.replicate len true
    let a := markPrimesInSegment a 3 n lowVal
    segLoop n (idx + len) totalLen (acc + countTrueLoop a 0 0)
  else acc

def segSieveCount (n : Nat) : Nat :=
  if n ≤ 2 then 0 else
    let totalLen := (n - 3 + 1) / 2
    segLoop n 0 totalLen 1

def countPrimeLoopFast (n acc : ℕ) : ℕ := acc + segSieveCount n


/-- Tail-recursive prime count, with a fast compiled implementation below. -/
@[implemented_by countPrimeLoopFast]
def countPrimeLoop : ℕ → ℕ → ℕ
  | 0, acc => acc
  | n + 1, acc => countPrimeLoop n (if Nat.Prime n then acc + 1 else acc)

lemma countPrimeLoop_eq (n acc : ℕ) :
    countPrimeLoop n acc = acc + Nat.count Nat.Prime n := by
  induction n generalizing acc with
  | zero => simp [countPrimeLoop]
  | succ n ih =>
      rw [countPrimeLoop, ih]
      rw [Nat.count_succ]
      by_cases h : Nat.Prime n <;> simp [h, Nat.add_comm, Nat.add_left_comm]

lemma base_count_of_fast (hfast : countPrimeLoop 180820951 0 = 10073435) :
    Nat.count Nat.Prime 180820951 = 10073435 := by
  have h := countPrimeLoop_eq 180820951 0
  omega

lemma base_count : Nat.count Nat.Prime 180820951 = 10073435 := by
  have hfast : countPrimeLoop 180820951 0 = 10073435 := by native_decide
  exact base_count_of_fast hfast



lemma rpow_step_gap {n p g : ℕ} (hn : 1 < n) (hpn : n + 3 ≤ p) (hgap : p ≤ g * n) :
    ((n : ℝ) ^ ((p : ℝ) / n)) + 1 <
      (((n + 1 : ℕ) : ℝ) ^ (((p + g : ℕ) : ℝ) / ((n + 1 : ℕ) : ℝ))) := by
  let x : ℝ := (n : ℝ) ^ ((p : ℝ) / n)
  let y : ℝ := (((n + 1 : ℕ) : ℝ) ^ (((p + g : ℕ) : ℝ) / ((n + 1 : ℕ) : ℝ)))
  have hn0 : (0:ℝ) < n := by exact_mod_cast (lt_trans Nat.zero_lt_one hn)
  have hn1 : (1:ℝ) < n := by exact_mod_cast hn
  have hn1pos : (0:ℝ) < (n + 1 : ℕ) := by positivity
  have hnp : (n : ℝ) < p := by exact_mod_cast (lt_of_lt_of_le (by omega : n < n+3) hpn)
  have hpexp : (1:ℝ) < (p:ℝ) / n := by
    rw [one_lt_div hn0]
    exact hnp
  have hxpos : 0 < x := by dsimp [x]; positivity
  have hypos : 0 < y := by dsimp [y]; positivity
  have hx_gt_n : (n:ℝ) < x := by
    dsimp [x]
    simpa using (Real.rpow_lt_rpow_left_iff hn1).2 hpexp
  have hx_div_gt_one : 1 < x / (n:ℝ) := (one_lt_div hn0).2 hx_gt_n
  have hx_add : x + 1 < x * (1 + 1 / (n:ℝ)) := by
    have hrew : x * (1 + 1 / (n:ℝ)) = x + x / (n:ℝ) := by
      field_simp [hn0.ne']
    rw [hrew]
    linarith
  have hlog_up : Real.log (1 + 1 / (n:ℝ)) ≤ 1 / (n:ℝ) := by
    have hp : 0 < 1 + 1 / (n:ℝ) := by positivity
    have := Real.log_le_sub_one_of_pos hp
    nlinarith
  have hlog_low : (1 / ((n + 1 : ℕ):ℝ)) ≤ Real.log (1 + 1 / (n:ℝ)) := by
    have ht : 0 < (1 / (n:ℝ)) := by positivity
    have hlt := Real.lt_log_one_add_of_pos ht
    -- 2*t/(t+2) > 1/(n+1)
    have hcalc : (1 / ((n + 1 : ℕ):ℝ)) < 2 * (1 / (n:ℝ)) / (1 / (n:ℝ) + 2) := by
      field_simp [hn0.ne', show ((n+1:ℕ):ℝ) ≠ 0 by positivity]
      norm_num [Nat.cast_add]
      linarith
    exact hcalc.le.trans hlt.le
  have hlogn_nonneg : 0 ≤ Real.log (n:ℝ) := Real.log_nonneg hn1.le
  have hlog_succ_lower : Real.log ((n + 1 : ℕ):ℝ) ≥ Real.log (n:ℝ) + 1 / ((n + 1 : ℕ):ℝ) := by
    have hn_ne : (n:ℝ) ≠ 0 := ne_of_gt hn0
    have hmul : ((n + 1 : ℕ):ℝ) = (n:ℝ) * (1 + 1/(n:ℝ)) := by
      norm_num
      field_simp [hn_ne]
    nth_rw 1 [hmul]
    rw [Real.log_mul hn0.ne' (by positivity)]
    linarith
  have hdiff : Real.log (x * (1 + 1 / (n:ℝ))) < Real.log y := by
    rw [Real.log_mul hxpos.ne' (by positivity), Real.log_rpow hn0, Real.log_rpow hn1pos]
    -- goal is log x + log(1+1/n) < log y, after rpow rewrites
    have hmain : ((p:ℝ) / (n:ℝ)) * Real.log (n:ℝ) + 1/(n:ℝ) <
        (((p+g:ℕ):ℝ) / ((n+1:ℕ):ℝ)) * Real.log ((n+1:ℕ):ℝ) := by
      have hA : ((p:ℝ) / (n:ℝ)) * Real.log (n:ℝ) + 1/(n:ℝ) <
          (((p+g:ℕ):ℝ) / ((n+1:ℕ):ℝ)) * (Real.log (n:ℝ) + 1 / ((n + 1 : ℕ):ℝ)) := by
        have hcoef_nonneg : 0 ≤ (((p+g:ℕ):ℝ) / ((n+1:ℕ):ℝ)) := by positivity
        have hmul_lower := mul_le_mul_of_nonneg_left hlog_succ_lower hcoef_nonneg
        -- prove strict lower target beats LHS by arithmetic
        have harith : ((p:ℝ) / (n:ℝ)) * Real.log (n:ℝ) + 1/(n:ℝ) <
          (((p+g:ℕ):ℝ) / ((n+1:ℕ):ℝ)) * (Real.log (n:ℝ) + 1 / ((n + 1 : ℕ):ℝ)) := by
          have hgapR : (p:ℝ) ≤ (g:ℝ) * (n:ℝ) := by exact_mod_cast hgap
          have hpbigR : ((n:ℝ) + 3) ≤ (p:ℝ) := by exact_mod_cast hpn
          have hgposNat : 1 ≤ g := by
            have hp_pos : 0 < p := by omega
            have hgn_pos : 0 < g * n := lt_of_lt_of_le hp_pos hgap
            exact Nat.succ_le_iff.mpr (Nat.pos_of_mul_pos_right hgn_pos)
          have hgposR : (1:ℝ) ≤ g := by exact_mod_cast hgposNat
          have hgap_sub : 0 ≤ (n:ℝ) * (g:ℝ) - (p:ℝ) := by nlinarith [hgapR]
          have hlogpart : 0 ≤ Real.log (n:ℝ) * (((n:ℝ) + 1) * ((n:ℝ) * (g:ℝ) - (p:ℝ))) := by
            positivity
          have hsec : 0 < (n:ℝ) * (p:ℝ) + (n:ℝ) * (g:ℝ) - ((n:ℝ)^2 + 2*(n:ℝ) + 1) := by
            nlinarith [hpbigR, hgposR, hn1]
          field_simp [hn0.ne', show ((n+1:ℕ):ℝ) ≠ 0 by positivity]
          norm_num [Nat.cast_add, Nat.cast_mul]
          ring_nf
          nlinarith [hlogpart, hsec]
        exact harith
      exact hA.trans_le (mul_le_mul_of_nonneg_left hlog_succ_lower (by positivity))
    linarith [hlog_up]
  have hxy : x * (1 + 1 / (n:ℝ)) < y := (Real.log_lt_log_iff (by positivity) hypos).1 hdiff
  exact hx_add.trans hxy


lemma floor_toNat_lt_of_add_one_lt {x y : ℝ} (hx : 0 ≤ x) (hxy : x + 1 < y) :
    Int.toNat (⌊x⌋) < Int.toNat (⌊y⌋) := by
  have hy : 0 ≤ y := by linarith
  rw [Int.floor_toNat x, Int.floor_toNat y]
  rw [← Nat.add_one_le_iff]
  rw [Nat.le_floor_iff hy]
  norm_num
  linarith [Nat.floor_le hx]

lemma A_step_of_gap {n p g : ℕ} (hn : 1 < n) (hp0 : Nat.nth Nat.Prime (n - 1) = p)
    (hp1 : Nat.nth Nat.Prime n = p + g) (hpn : n + 3 ≤ p) (hgap : p ≤ g * n) :
    A318199 n < A318199 (n+1) := by
  have hn_ne : n ≠ 0 := by omega
  have hpow := rpow_step_gap (n:=n) (p:=p) (g:=g) hn hpn hgap
  unfold A318199
  simp [hn_ne]
  simp only [hp0, hp1]
  have hpow' : (n : ℝ) ^ ((p : ℝ) / n) + 1 <
      ((n : ℝ) + 1) ^ (((p + g : ℕ) : ℝ) / ((n : ℝ) + 1)) := by
    simpa [Nat.cast_add] using hpow
  exact floor_toNat_lt_of_add_one_lt (by positivity) hpow'


