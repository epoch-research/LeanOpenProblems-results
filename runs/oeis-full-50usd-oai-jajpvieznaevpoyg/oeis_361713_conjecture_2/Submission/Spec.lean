lemma fact7_mul (y : ℕ) (hy : y ≠ 0) : (7*y).factorization 7 = y.factorization 7 + 1 := by
  rw [Nat.factorization_mul (by norm_num) hy]
  simp [Nat.Prime.factorization_self (by norm_num : Nat.Prime 7), add_comm]

lemma ordCompl7_mul (y : ℕ) : ordCompl[7] (7*y) = ordCompl[7] y := by
  simpa [pow_one] using (Nat.ordCompl_self_pow_mul y 1 (p:=7) (by norm_num : Nat.Prime 7))

lemma strip7Aux_spec : ∀ fuel x, x ≠ 0 → x < 7^(fuel+1) →
    strip7Aux fuel x = (x.factorization 7, ordCompl[7] x)
| 0, x, hx0, hxlt => by
    simp [strip7Aux]
    have hnot : ¬ 7 ∣ x := by
      intro hd
      have hle : 7 ≤ x := Nat.le_of_dvd (Nat.pos_of_ne_zero hx0) hd
      have : x < 7 := by simpa using hxlt
      omega
    constructor
    · exact (Nat.factorization_eq_zero_of_not_dvd hnot).symm
    · exact ((Nat.ordCompl_eq_self_iff_zero_or_not_dvd x (by norm_num : Nat.Prime 7)).2 (Or.inr hnot)).symm
| fuel+1, x, hx0, hxlt => by
    simp [strip7Aux]
    by_cases hdiv : x % 7 = 0
    · simp [hdiv]
      let y := x / 7
      have hdvd : 7 ∣ x := Nat.dvd_of_mod_eq_zero hdiv
      have hy0 : y ≠ 0 := by
        dsimp [y]
        exact _root_.ne_of_gt (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hx0) hdvd) (by norm_num : 0 < 7))
      have hxy : x = 7 * y := by
        dsimp [y]
        exact (Nat.div_mul_cancel hdvd).symm.trans (mul_comm _ _)
      have hylt : y < 7^(fuel+1) := by
        have : 7*y < 7 * 7^(fuel+1) := by
          simpa [← hxy, pow_succ, mul_comm, mul_left_comm, mul_assoc] using hxlt
        exact (Nat.mul_lt_mul_left (by norm_num : 0 < 7)).mp this
      have hs := strip7Aux_spec fuel y hy0 hylt
      rw [hs]
      constructor
      · simp
        rw [hxy, fact7_mul y hy0]
      · simp
        rw [hxy, ordCompl7_mul y]
    · simp [hdiv]
      have hnot : ¬ 7 ∣ x := by
        intro hd; exact hdiv (Nat.mod_eq_zero_of_dvd hd)
      constructor
      · exact (Nat.factorization_eq_zero_of_not_dvd hnot).symm
      · exact ((Nat.ordCompl_eq_self_iff_zero_or_not_dvd x (by norm_num : Nat.Prime 7)).2 (Or.inr hnot)).symm

lemma strip7_spec {x : ℕ} (hx0 : x ≠ 0) (hxlt : x < 7^7) :
    strip7 x = (x.factorization 7, ordCompl[7] x) := by
  simpa [strip7] using strip7Aux_spec 6 x hx0 (by simpa using hxlt)

lemma invStep_cast_pos {m a x : ℕ} (hm : m ≠ 0) :
    (invStep m a x : ZMod m) = (x : ZMod m) * (2 - (a : ZMod m) * (x : ZMod m)) := by
  haveI : NeZero m := ⟨hm⟩
  let t := (a % m) * x % m
  have ht : t < m := Nat.mod_lt _ (Nat.pos_of_ne_zero hm)
  have hle : t ≤ 2 + m := by omega
  have hsub : ((2 + m - t) % m : ZMod m) = (2 : ZMod m) - (t : ZMod m) := by
    rw [ZMod.natCast_mod]
    rw [Nat.cast_sub hle]
    simp
  simp only [invStep]
  rw [ZMod.natCast_mod]
  rw [Nat.cast_mul]
  change (x : ZMod m) * (((2 + m - t) % m : ℕ) : ZMod m) = _
  rw [hsub]
  have htcast : (t : ZMod m) = (a : ZMod m) * (x : ZMod m) := by
    simp [t, ZMod.natCast_mod]
  rw [htcast]

lemma newton_error {R} [CommRing R] (a x : R) :
    a * (x * (2 - a*x)) - 1 = - (a*x - 1)^2 := by ring

lemma base_error (a : ℕ) (ha : ¬ 7 ∣ a) :
    ∃ c : ZMod (7^25), (a : ZMod (7^25)) * (inv7base a : ZMod (7^25)) - 1 = (7 : ZMod (7^25)) * c := by
  have hlt := Nat.mod_lt a (by norm_num : 0 < 7)
  have hnz : a % 7 ≠ 0 := by intro h; exact ha (Nat.dvd_of_mod_eq_zero h)
  have hdecomp : (a : ZMod (7^25)) = (7 : ZMod (7^25)) * ((a / 7 : ℕ) : ZMod (7^25)) + ((a % 7 : ℕ) : ZMod (7^25)) := by
    have hn : a = 7 * (a / 7) + a % 7 := by
      have h := Nat.mod_add_div a 7
      omega
    have hc := congrArg (fun n : ℕ => (n : ZMod (7^25))) hn
    simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] using hc
  by_cases h1 : a % 7 = 1
  · use ((a/7 : ℕ) : ZMod (7^25)); simp [inv7base, h1, hdecomp]
  by_cases h2 : a % 7 = 2
  · use (4*((a/7 : ℕ) : ZMod (7^25))+1); simp [inv7base, h2, hdecomp]; ring
  by_cases h3 : a % 7 = 3
  · use (5*((a/7 : ℕ) : ZMod (7^25))+2); simp [inv7base, h3, hdecomp]; ring
  by_cases h4 : a % 7 = 4
  · use (2*((a/7 : ℕ) : ZMod (7^25))+1); simp [inv7base, h4, hdecomp]; ring
  by_cases h5 : a % 7 = 5
  · use (3*((a/7 : ℕ) : ZMod (7^25))+2); simp [inv7base, h5, hdecomp]; ring
  have h6 : a % 7 = 6 := by omega
  use (6*((a/7 : ℕ) : ZMod (7^25))+5); simp [inv7base, h6, hdecomp]; ring

lemma step_error {R} [CommRing R] {a x e : R} {q : ℕ}
    (he : a*x - 1 = (7 : R)^q * e) :
    ∃ e' : R, a*(x*(2-a*x))-1 = (7 : R)^(2*q) * e' := by
  use (-(e^2))
  rw [newton_error, he]
  rw [show (7 : R) ^ (2*q) = ((7 : R)^q)^2 by rw [show 2*q = q*2 by omega, pow_mul]]
  ring

lemma step_error_inv {a x q : ℕ} {e : ZMod (7^25)}
    (he : (a : ZMod (7^25))*(x : ZMod (7^25))-1 = (7 : ZMod (7^25))^q * e) :
    ∃ e' : ZMod (7^25), (a : ZMod (7^25))*(invStep (7^25) a x : ZMod (7^25))-1 = (7 : ZMod (7^25))^(2*q) * e' := by
  rw [invStep_cast_pos (by norm_num : 7^25 ≠ 0)]
  exact step_error (a := (a : ZMod (7^25))) (x := (x : ZMod (7^25))) (q := q) he

lemma invFast_spec (a : ℕ) (ha : ¬ 7 ∣ a) :
    (a : ZMod (7^25)) * (invFast a : ZMod (7^25)) = 1 := by
  obtain ⟨e0, he0⟩ := base_error a ha
  obtain ⟨e1, he1'⟩ := step_error_inv (a:=a) (x:=inv7base a) (q:=1) he0
  have he1 : (a : ZMod (7^25))*(invStep (7^25) a (inv7base a) : ZMod (7^25))-1 = (7 : ZMod (7^25))^2 * e1 := by simpa using he1'
  obtain ⟨e2, he2'⟩ := step_error_inv (a:=a) (x:=invStep (7^25) a (inv7base a)) (q:=2) he1
  have he2 : (a : ZMod (7^25))*(invStep (7^25) a (invStep (7^25) a (inv7base a)) : ZMod (7^25))-1 = (7 : ZMod (7^25))^4 * e2 := by simpa using he2'
  obtain ⟨e3, he3'⟩ := step_error_inv (a:=a) (x:=invStep (7^25) a (invStep (7^25) a (inv7base a))) (q:=4) he2
  have he3 : (a : ZMod (7^25))*(invStep (7^25) a (invStep (7^25) a (invStep (7^25) a (inv7base a))) : ZMod (7^25))-1 = (7 : ZMod (7^25))^8 * e3 := by simpa using he3'
  obtain ⟨e4, he4'⟩ := step_error_inv (a:=a) (x:=invStep (7^25) a (invStep (7^25) a (invStep (7^25) a (inv7base a)))) (q:=8) he3
  have he4 : (a : ZMod (7^25))*(invStep (7^25) a (invStep (7^25) a (invStep (7^25) a (invStep (7^25) a (inv7base a)))) : ZMod (7^25))-1 = (7 : ZMod (7^25))^16 * e4 := by simpa using he4'
  obtain ⟨e5, he5'⟩ := step_error_inv (a:=a) (x:=invStep (7^25) a (invStep (7^25) a (invStep (7^25) a (invStep (7^25) a (inv7base a))))) (q:=16) he4
  have he5 : (a : ZMod (7^25))*(invFast a : ZMod (7^25))-1 = (7 : ZMod (7^25))^32 * e5 := by
    simpa [invFast] using he5'
  have hpzero : (7 : ZMod (7^25))^32 = 0 := by
    change ((7^32 : ℕ) : ZMod (7^25)) = 0
    rw [ZMod.natCast_eq_zero_iff]
    exact pow_dvd_pow 7 (by norm_num : 25 ≤ 32)
  have herr : (a : ZMod (7^25))*(invFast a : ZMod (7^25))-1 = 0 := by rw [he5, hpzero, zero_mul]
  exact sub_eq_zero.mp herr

lemma termVal_cast (v1 u1 v2 u2 : ℕ) :
    (termVal (7^25) v1 u1 v2 u2 : ZMod (7^25)) =
      ((7 : ZMod (7^25))^v1 * (u1 : ZMod (7^25)))^2 *
      (((7 : ZMod (7^25))^v2 * (u2 : ZMod (7^25)))^2) := by
  unfold termVal
  by_cases h : 2*v1 + 2*v2 < 25
  · simp [h, ZMod.natCast_mod]
    ring_nf
  · simp [h]
    have hle : 25 ≤ 2*v1 + 2*v2 := by omega
    have hpzero : (7 : ZMod (7^25))^(2*v1+2*v2) = 0 := by
      have hdvd : 7^25 ∣ 7^(2*v1+2*v2) := pow_dvd_pow 7 hle
      simpa [← Nat.cast_pow] using (ZMod.natCast_eq_zero_iff (7^(2*v1+2*v2)) (7^25)).2 hdvd
    ring_nf
    have hprod : (7 : ZMod (7^25))^(v1*2) * (7 : ZMod (7^25))^(v2*2) = 0 := by
      rw [show v1*2 = 2*v1 by omega, show v2*2 = 2*v2 by omega, ← pow_add, hpzero]
    have hright : (u1 : ZMod (7^25)) ^ 2 * (u2 : ZMod (7^25)) ^ 2 * (7 : ZMod (7^25)) ^ (v1 * 2) * (7 : ZMod (7^25)) ^ (v2 * 2) = 0 := by
      calc
        (u1 : ZMod (7^25)) ^ 2 * (u2 : ZMod (7^25)) ^ 2 * (7 : ZMod (7^25)) ^ (v1 * 2) * (7 : ZMod (7^25)) ^ (v2 * 2)
            = ((u1 : ZMod (7^25)) ^ 2 * (u2 : ZMod (7^25)) ^ 2) * ((7 : ZMod (7^25)) ^ (v1 * 2) * (7 : ZMod (7^25)) ^ (v2 * 2)) := by ring
        _ = 0 := by rw [hprod, mul_zero]
    rw [hright]

lemma fact_update7 {C C' x y : ℕ} (hC' : C' ≠ 0) (hy : y ≠ 0) (hC : C ≠ 0) (hx : x ≠ 0)
    (hmul : C' * y = C * x) :
    C'.factorization 7 = C.factorization 7 + x.factorization 7 - y.factorization 7 := by
  have hf := congrArg (fun z : ℕ => z.factorization 7) hmul
  change (C' * y).factorization 7 = (C * x).factorization 7 at hf
  rw [Nat.factorization_mul hC' hy, Nat.factorization_mul hC hx] at hf
  change C'.factorization 7 + y.factorization 7 = C.factorization 7 + x.factorization 7 at hf
  omega

lemma unit_update7 {C C' x y : ℕ} (hy : y ≠ 0) (hmul : C' * y = C * x) :
    ((ordCompl[7] C' : ℕ) : ZMod (7^25)) =
      ((ordCompl[7] C : ℕ) : ZMod (7^25)) * ((ordCompl[7] x : ℕ) : ZMod (7^25)) * (invFast (ordCompl[7] y) : ZMod (7^25)) := by
  have hU := congrArg (fun z : ℕ => ordCompl[7] z) hmul
  change ordCompl[7] (C' * y) = ordCompl[7] (C * x) at hU
  rw [Nat.ordCompl_mul, Nat.ordCompl_mul] at hU
  have hUz : ((ordCompl[7] C' : ℕ) : ZMod (7^25)) * ((ordCompl[7] y : ℕ) : ZMod (7^25)) =
      ((ordCompl[7] C : ℕ) : ZMod (7^25)) * ((ordCompl[7] x : ℕ) : ZMod (7^25)) := by
    have hc := congrArg (fun n : ℕ => (n : ZMod (7^25))) hU
    simpa only [Nat.cast_mul] using hc
  have hnot : ¬ 7 ∣ ordCompl[7] y := Nat.not_dvd_ordCompl (by norm_num : Nat.Prime 7) hy
  have hinv : ((ordCompl[7] y : ℕ) : ZMod (7^25)) * (invFast (ordCompl[7] y) : ZMod (7^25)) = 1 := invFast_spec _ hnot
  calc
    ((ordCompl[7] C' : ℕ) : ZMod (7^25)) = ((ordCompl[7] C' : ℕ) : ZMod (7^25)) * 1 := by ring
    _ = ((ordCompl[7] C' : ℕ) : ZMod (7^25)) * (((ordCompl[7] y : ℕ) : ZMod (7^25)) * (invFast (ordCompl[7] y) : ZMod (7^25))) := by rw [hinv]
    _ = (((ordCompl[7] C' : ℕ) : ZMod (7^25)) * ((ordCompl[7] y : ℕ) : ZMod (7^25))) * (invFast (ordCompl[7] y) : ZMod (7^25)) := by ring
    _ = (((ordCompl[7] C : ℕ) : ZMod (7^25)) * ((ordCompl[7] x : ℕ) : ZMod (7^25))) * (invFast (ordCompl[7] y) : ZMod (7^25)) := by rw [hUz]
    _ = ((ordCompl[7] C : ℕ) : ZMod (7^25)) * ((ordCompl[7] x : ℕ) : ZMod (7^25)) * (invFast (ordCompl[7] y) : ZMod (7^25)) := by ring

lemma choose_hmul1 {n k : ℕ} (hk : k < n) : n.choose (k+1) * (k+1) = n.choose k * (n-k) := by
  have h := Nat.choose_succ_right_eq n k
  exact h

lemma choose_hmul2 {n k : ℕ} (hn : 0 < n) :
    ((n+(k+1)-1).choose (k+1)) * (k+1) = ((n+k-1).choose k) * (n+k) := by
  let N := n+k-1
  have hN : N + 1 = n+k := by omega
  have hR : n+(k+1)-1 = n+k := by omega
  have h := Nat.succ_mul_choose_eq N k
  change (N+1) * N.choose k = (N+1).choose (k+1) * (k+1) at h
  rw [hN] at h
  have h' := h.symm
  rw [← hR] at h'
  simpa [N, mul_comm] using h'

lemma cast_factor (C : ℕ) : ((C : ℕ) : ZMod (7^25)) = (7 : ZMod (7^25))^(C.factorization 7) * ((ordCompl[7] C : ℕ) : ZMod (7^25)) := by
  have h := Nat.ordProj_mul_ordCompl_eq_self C 7
  change 7 ^ C.factorization 7 * ordCompl[7] C = C at h
  have hc := congrArg (fun n : ℕ => (n : ZMod (7^25))) h
  simpa only [Nat.cast_mul, Nat.cast_pow] using hc.symm


@[irreducible] def Good (n : ℕ) (st : PState) : Prop :=
  match st with
  | (k,v1,u1,v2,u2,s) =>
    k ≤ n ∧
    v1 = (n.choose k).factorization 7 ∧ ((u1 : ℕ) : ZMod (7^25)) = ((ordCompl[7] (n.choose k) : ℕ) : ZMod (7^25)) ∧
    v2 = ((n+k-1).choose k).factorization 7 ∧ ((u2 : ℕ) : ZMod (7^25)) = ((ordCompl[7] ((n+k-1).choose k) : ℕ) : ZMod (7^25)) ∧
    ((s : ℕ) : ZMod (7^25)) = ((pref n k : ℕ) : ZMod (7^25))

lemma step_sound_ord {n st} (hn : 0 < n) (hst : Good n st) (hklt : st.1 < n) : Good n (pstepOrd n (7^25) st) := by
  rcases st with ⟨k,v1,u1,v2,u2,s⟩
  simp only at hklt
  unfold Good at hst ⊢
  rcases hst with ⟨hkn,hv1,hu1,hv2,hu2,hs⟩
  have hk1le : k+1 ≤ n := by omega
  have C1nz : n.choose k ≠ 0 := (Nat.choose_pos (by omega)).ne'
  have C1'nz : n.choose (k+1) ≠ 0 := (Nat.choose_pos hk1le).ne'
  have x1nz : n-k ≠ 0 := by omega
  have ynz : k+1 ≠ 0 := by omega
  have C2nz : (n+k-1).choose k ≠ 0 := (Nat.choose_pos (by omega)).ne'
  have C2'nz : (n+(k+1)-1).choose (k+1) ≠ 0 := (Nat.choose_pos (by omega)).ne'
  have x2nz : n+k ≠ 0 := by omega
  constructor
  · exact hk1le
  constructor
  · simp [pstepOrd, hv1]
    exact (fact_update7 C1'nz ynz C1nz x1nz (choose_hmul1 hklt)).symm
  constructor
  · simp [pstepOrd]
    rw [hu1]
    exact (unit_update7 ynz (choose_hmul1 hklt)).symm
  constructor
  · simp [pstepOrd, hv2]
    simpa [show n+(k+1)-1 = n+k by omega] using (fact_update7 C2'nz ynz C2nz x2nz (choose_hmul2 hn)).symm
  constructor
  · simp [pstepOrd]
    rw [hu2]
    simpa [show n+(k+1)-1 = n+k by omega] using (unit_update7 ynz (choose_hmul2 hn)).symm
  · simp [pstepOrd]
    rw [hs]
    have htv : (termVal 1341068619663964900807 v1 u1 v2 u2 : ZMod (7^25)) =
      ((7 : ZMod (7^25))^v1 * (u1 : ZMod (7^25)))^2 *
      (((7 : ZMod (7^25))^v2 * (u2 : ZMod (7^25)))^2) := by
      convert termVal_cast v1 u1 v2 u2 <;> norm_num
    rw [htv]
    rw [hu1, hu2, hv1, hv2]
    rw [← cast_factor (n.choose k), ← cast_factor ((n+k-1).choose k)]
    simp [term]
    unfold pref
    rw [Finset.sum_range_succ]
    simp [term]

lemma pstep_eq_pstepOrd {n st} (hnle : n ≤ 7^6) (hklt : st.1 < n) :
    pstep n (7^25) st = pstepOrd n (7^25) st := by
  rcases st with ⟨k,v1,u1,v2,u2,s⟩
  simp only at hklt
  have x1nz : n-k ≠ 0 := by omega
  have ynz : k+1 ≠ 0 := by omega
  have x2nz : n+k ≠ 0 := by omega
  have sx1 : strip7 (n-k) = ((n-k).factorization 7, ordCompl[7] (n-k)) := by
    exact strip7_spec x1nz (by
      have hle : n-k ≤ n := Nat.sub_le n k
      have hnlt : n < 7^7 := by omega
      exact lt_of_le_of_lt hle hnlt)
  have sy : strip7 (k+1) = ((k+1).factorization 7, ordCompl[7] (k+1)) := by
    exact strip7_spec ynz (by
      have hnlt : n < 7^7 := by omega
      omega)
  have sx2 : strip7 (n+k) = ((n+k).factorization 7, ordCompl[7] (n+k)) := by
    exact strip7_spec x2nz (by
      have : n+k ≤ n+(n-1) := by omega
      omega)
  simp [pstep, pstepOrd, sx1, sy, sx2]

lemma step_sound {n st} (hn : 0 < n) (hnle : n ≤ 7^6) (hst : Good n st) (hklt : st.1 < n) : Good n (pstep n (7^25) st) := by
  rw [pstep_eq_pstepOrd (n:=n) (st:=st) hnle hklt]
  exact step_sound_ord hn hst hklt

lemma pstep_fst (n m : ℕ) (st : PState) : (pstep n m st).1 = st.1 + 1 := by
  cases st with
  | mk k rest =>
    cases rest with
    | mk v1 rest =>
      cases rest with
      | mk u1 rest =>
        cases rest with
        | mk v2 rest =>
          cases rest with
          | mk u2 s => rfl

lemma runRepeat_fst (n m : ℕ) : ∀ q st, (runRepeat n m q st).1 = st.1 + q := by
  intro q
  induction q with
  | zero => intro st; rfl
  | succ q ih =>
      intro st
      change (pstep n m (runRepeat n m q st)).1 = st.1 + (q+1)
      rw [pstep_fst, ih]
      omega


lemma repeat_add {α} (f : α → α) : ∀ q r a, Nat.repeat f (q+r) a = Nat.repeat f r (Nat.repeat f q a) := by
  intro q r
  induction r with
  | zero => intro a; change Nat.repeat f q a = Nat.repeat f q a; rfl
  | succ r ih =>
      intro a
      rw [show q + (r+1) = q+r+1 by omega]
      change f (Nat.repeat f (q+r) a) = f (Nat.repeat f r (Nat.repeat f q a))
      rw [ih]

lemma runRepeat_add (n m q r : ℕ) (st : PState) :
    runRepeat n m (q+r) st = runRepeat n m r (runRepeat n m q st) := by
  exact repeat_add (pstep n m) q r st

lemma runRepeat_sound {n q st} (hn : 0 < n) (hnle : n ≤ 7^6)
    (hg : Good n st) (hbound : st.1 + q ≤ n) : Good n (runRepeat n (7^25) q st) := by
  induction q generalizing st with
  | zero => simpa [runRepeat] using hg
  | succ q ih =>
      change Good n (pstep n (7^25) (runRepeat n (7^25) q st))
      have hbq : st.1 + q ≤ n := by omega
      have gq := ih hg hbq
      have hklt : (runRepeat n (7^25) q st).1 < n := by
        rw [runRepeat_fst]
        omega
      exact step_sound hn hnle gq hklt

lemma good_init (n : ℕ) (hn : 0 < n) : Good n (0,0,1,0,1,0) := by
  unfold Good
  simp [pref, hn]

lemma a_eq_pref (n : ℕ) : a n = pref n n := by
  simp [a, pref, term]

