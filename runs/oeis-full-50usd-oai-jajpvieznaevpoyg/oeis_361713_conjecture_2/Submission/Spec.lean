open Finset Nat

def a (n : ℕ) : ℕ :=
  Finset.sum (Finset.range n) fun k => (n.choose k) ^ 2 * ((n + k - 1).choose k) ^ 2

def term (n k : Nat) : Nat := (n.choose k)^2 * ((n+k-1).choose k)^2

def pref (n k : ℕ) : ℕ := ∑ i ∈ Finset.range k, term n i

def strip7Aux : ℕ → ℕ → ℕ × ℕ
| 0, n => (0, n)
| fuel+1, n =>
    if n % 7 = 0 then
      let r := strip7Aux fuel (n / 7)
      (r.1 + 1, r.2)
    else (0, n)

def strip7 (n : ℕ) : ℕ × ℕ := strip7Aux 6 n

def inv7base (a : ℕ) : ℕ :=
  match a % 7 with
  | 1 => 1 | 2 => 4 | 3 => 5 | 4 => 2 | 5 => 3 | 6 => 6 | _ => 0

def invStep (m a x : ℕ) : ℕ := (x * ((2 + m - ((a % m) * x % m)) % m)) % m

def invFast (a : ℕ) : ℕ :=
  let m := 7^25
  let x0 := inv7base a
  let x1 := invStep m a x0
  let x2 := invStep m a x1
  let x3 := invStep m a x2
  let x4 := invStep m a x3
  let x5 := invStep m a x4
  x5

def termVal (m : ℕ) (v1 u1 v2 u2 : ℕ) : ℕ :=
  let v := 2*v1 + 2*v2
  if v < 25 then (7^v * (u1^2 % m) * (u2^2 % m)) % m else 0

abbrev PState := ℕ × ℕ × ℕ × ℕ × ℕ × ℕ
abbrev ps (st : PState) := st.2.2.2.2.2

def pstep (n m : ℕ) (st : PState) : PState :=
  match st with
  | (k, v1, u1, v2, u2, s) =>
      let s' := (s + termVal m v1 u1 v2 u2) % m
      let x1 := strip7 (n-k)
      let y := strip7 (k+1)
      let x2 := strip7 (n+k)
      let v1' := v1 + x1.1 - y.1
      let u1' := (u1 * (x1.2 % m) * invFast y.2) % m
      let v2' := v2 + x2.1 - y.1
      let u2' := (u2 * (x2.2 % m) * invFast y.2) % m
      (k+1, v1', u1', v2', u2', s')

def pstepOrd (n m : ℕ) (st : PState) : PState :=
  match st with
  | (k, v1, u1, v2, u2, s) =>
      let s' := (s + termVal m v1 u1 v2 u2) % m
      let y := (ordCompl[7] (k+1))
      let v1' := v1 + (n-k).factorization 7 - (k+1).factorization 7
      let u1' := (u1 * ((ordCompl[7] (n-k)) % m) * invFast y) % m
      let v2' := v2 + (n+k).factorization 7 - (k+1).factorization 7
      let u2' := (u2 * ((ordCompl[7] (n+k)) % m) * invFast y) % m
      (k+1, v1', u1', v2', u2', s')

def runRepeat (n m q : ℕ) (st : PState) : PState := Nat.repeat (pstep n m) q st
