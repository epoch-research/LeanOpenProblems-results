private def exceptionGoodB (n k : Nat) : Bool :=
  let m := phiList k * phiList (n-k)
  if k ∈ Ico 1 ((n - 1) / 2 + 1) then
    if sqrt m ^ 2 = m then true else false
  else false

private lemma exceptionGood_sound {n k : Nat} (h : exceptionGoodB n k = true) :
    ∃ k ∈ Finset.Ico 1 ((n - 1) / 2 + 1), Nat.sqrt (Nat.totient k * Nat.totient (n-k)) ^ 2 = Nat.totient k * Nat.totient (n-k) := by
  unfold exceptionGoodB at h
  split at h <;> try contradiction
  rename_i hk
  dsimp at h
  split at h <;> try contradiction
  rename_i hm
  refine ⟨k, hk, ?_⟩
  simpa [phiList_eq_totient] using hm

private def recordBytes : ByteArray := recordData.toUTF8

@[inline] private def decByte (b : UInt8) : Nat := b.toNat - 33
@[inline] private def decodeWitnessAt (pos : Nat) : Nat :=
  94 * decByte (recordBytes.get! pos) + decByte (recordBytes.get! (pos + 1))

@[inline] private def decodeNat4At (pos : Nat) : Nat :=
  94^3 * decByte (recordBytes.get! pos) + 94^2 * decByte (recordBytes.get! (pos+1)) +
  94 * decByte (recordBytes.get! (pos+2)) + decByte (recordBytes.get! (pos+3))

private def decodeGapAt (pos : Nat) : Nat × Nat :=
  let b := recordBytes.get! pos
  if b.toNat = 126 then
    (94 * decByte (recordBytes.get! (pos + 1)) + decByte (recordBytes.get! (pos + 2)), pos + 3)
  else (decByte b, pos + 1)





private def checkAllCore : Nat → Nat → Nat → Bool
| 0, _, _ => true
| fuel+1, n, pos =>
  let code := decByte (recordBytes.get! pos)
  if code < directRuleCount then
    if ruleCodeGoodB code n then checkAllCore fuel (n+1) (pos+1) else false
  else if code = exceptionMarker then
    let k := decodeWitnessAt (pos+1)
    let g := Nat.gcd n k
    let q := n / g
    let d := k / g
    if ruleGoodBFast q d n then checkAllCore fuel (n+1) (pos+3) else false
  else
    let idx := decodeWitnessAt (pos+1)
    if ruleCodeGoodB idx n then checkAllCore fuel (n+1) (pos+3) else false

private def checkFrom (fuel start gap pos : Nat) : Bool :=
  checkAllCore fuel start 0

