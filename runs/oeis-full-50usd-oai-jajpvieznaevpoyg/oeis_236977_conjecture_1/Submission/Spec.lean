private def rulesGoodB : List Rule → Nat → Bool
| [], _ => false
| r::rs, n => ruleGoodB' r n || rulesGoodB rs n

private lemma rulesGood_sound {rs : List Rule} {n : Nat} (h : rulesGoodB rs n = true) :
    ∃ k ∈ Finset.Ico 1 ((n - 1) / 2 + 1), Nat.sqrt (Nat.totient k * Nat.totient (n-k)) ^ 2 = Nat.totient k * Nat.totient (n-k) := by
  induction rs with
  | nil => simp [rulesGoodB] at h
  | cons r rs ih =>
    simp [rulesGoodB, Bool.or_eq_true] at h
    rcases h with h | h
    · exact ruleGood_sound' h
    · exact ih h

private def ruleCount : Nat := 194
private def directRuleCount : Nat := 92
private def exceptionMarker : Nat := 92

private def smallRules : Array Rule := rules.toArray

private def ruleCodeGoodB (idx n : Nat) : Bool :=
  match smallRules[idx]? with
  | some r => ruleGoodFast r n
  | none => false

private lemma ruleCodeGood_sound {idx n : Nat} (h : ruleCodeGoodB idx n = true) :
    ∃ k ∈ Finset.Ico 1 ((n - 1) / 2 + 1), Nat.sqrt (Nat.totient k * Nat.totient (n-k)) ^ 2 = Nat.totient k * Nat.totient (n-k) := by
  unfold ruleCodeGoodB at h
  split at h
  · exact ruleGood_sound' (ruleGoodFast_sound h)
  · contradiction

