open Nat Finset

/--
A236998: a(n) = |{0 < k < n/2: phi(k)*phi(n-k) is a square}|, where phi(.) is Euler's totient function.
-/
def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0


private def phiRec : Nat → Nat
| 0 => 0
| 1 => 1
| n+2 =>
  let p := Nat.minFac (n+2)
  let m := (n+2)/p
  if m % p = 0 then p * phiRec m else (p-1) * phiRec m
termination_by n => n
decreasing_by
  all_goals
    have hp : 2 ≤ (n + 2).minFac := Nat.minFac_prime (by omega) |>.two_le
    have hpos : 0 < n + 2 := by omega
    exact Nat.div_lt_self hpos hp

private lemma phiRec_eq_totient (n : Nat) : phiRec n = Nat.totient n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | _ | n
    · simp [phiRec]
    · simp [phiRec]
    · simp only [phiRec]
      let p := (n+2).minFac
      let m := (n+2)/p
      have hp : Nat.Prime p := Nat.minFac_prime (by omega)
      have hdiv : p ∣ n+2 := Nat.minFac_dvd (n+2)
      have hm_lt : m < n+2 := by
        dsimp [m, p]
        have hp2 : 2 ≤ (n+2).minFac := hp.two_le
        exact Nat.div_lt_self (by omega) hp2
      have hn_eq : n+2 = p*m := by
        dsimp [m, p]
        exact (Nat.div_mul_cancel hdiv).symm.trans (mul_comm _ _)
      by_cases hd : p ∣ m
      · have hmod : m % p = 0 := Nat.mod_eq_zero_of_dvd hd
        rw [if_pos hmod]
        change p * phiRec m = Nat.totient (n+2)
        rw [ih m hm_lt, hn_eq, Nat.totient_mul_of_prime_of_dvd hp hd]
      · have hmod : ¬ m % p = 0 := by intro hm; exact hd (Nat.dvd_of_mod_eq_zero hm)
        rw [if_neg hmod]
        change (p - 1) * phiRec m = Nat.totient (n+2)
        rw [ih m hm_lt, hn_eq, Nat.totient_mul_of_prime_of_not_dvd hp hd]











private def phiList (n : Nat) : Nat :=
  let S := n.primeFactorsList.toFinset
  (n / S.prod (fun p => p)) * S.prod (fun p => p - 1)

private lemma phiList_eq_totient (n : Nat) : phiList n = Nat.totient n := by
  rw [Nat.totient_eq_div_primeFactors_mul]
  rfl

private def bound : Nat := 2 * 10^6

private def updateMultiples (arr : Array Nat) (p : Nat) : Array Nat := Id.run do
  let mut a := arr
  let mut j := p
  while j < a.size do
    let v := a[j]!
    a := a.set! j (v - v / p)
    j := j + p
  return a

private def mkPhi (N : Nat) : Array Nat := Id.run do
  let mut a := Array.ofFn (fun i : Fin (N+1) => i.val)
  let mut p := 2
  while p < a.size do
    if a[p]! = p then
      a := updateMultiples a p
    p := p + 1
  return a

private def phiSieveArr : Array Nat := mkPhi bound

@[inline] private def phiSieve (tab : Array Nat) (n : Nat) : Nat := tab[n]!


private def ratioList : List Nat → Nat → Nat
| [], _ => 1
| p::ps, m =>
  let x := ps.prod * m
  (if p ∣ x then p else p-1) * ratioList ps m

private lemma totient_prod_mul_eq_ratioList (l : List Nat) (hl : ∀ p ∈ l, Nat.Prime p) (m : Nat) :
    Nat.totient (l.prod * m) = ratioList l m * Nat.totient m := by
  induction l with
  | nil => simp [ratioList]
  | cons p ps ih =>
    have hp : Nat.Prime p := hl p (by simp)
    have hps : ∀ q ∈ ps, Nat.Prime q := by intro q hq; exact hl q (by simp [hq])
    simp only [List.prod_cons]
    have ih' := ih hps
    rw [mul_assoc]
    by_cases hd : p ∣ ps.prod * m
    · rw [Nat.totient_mul_of_prime_of_dvd hp hd, ih']
      simp [ratioList, hd, mul_assoc]
    · rw [Nat.totient_mul_of_prime_of_not_dvd hp hd, ih']
      simp [ratioList, hd, mul_assoc]

private lemma totient_mul_coeff {a m : Nat} (ha : a ≠ 0) :
    Nat.totient (a * m) = ratioList a.primeFactorsList m * Nat.totient m := by
  have hprod : a.primeFactorsList.prod = a := Nat.prod_primeFactorsList ha
  calc
    Nat.totient (a * m) = Nat.totient (a.primeFactorsList.prod * m) := by rw [hprod]
    _ = ratioList a.primeFactorsList m * Nat.totient m :=
      totient_prod_mul_eq_ratioList _ (fun p hp => Nat.prime_of_mem_primeFactorsList hp) m

private def ruleGoodB (q d n : Nat) : Bool :=
  if hq : q ∣ n then
    let m := n / q
    let b := q - d
    let r := ratioList d.primeFactorsList m * ratioList b.primeFactorsList m
    decide (0 < m ∧ 0 < d ∧ d < b) && decide (Nat.sqrt r ^ 2 = r)
  else false


private def ruleGoodBFast (q d n : Nat) : Bool :=
  if n % q = 0 then
    let m := n / q
    let b := q - d
    let r := ratioList d.primeFactorsList m * ratioList b.primeFactorsList m
    (m != 0) && (d != 0) && (d < b) && (Nat.sqrt r ^ 2 == r)
  else false

private lemma ruleGoodBFast_sound {q d n : Nat} (h : ruleGoodBFast q d n = true) : ruleGoodB q d n = true := by
  unfold ruleGoodBFast at h
  unfold ruleGoodB
  split at h <;> try contradiction
  rename_i hmod
  have hq : q ∣ n := Nat.dvd_of_mod_eq_zero hmod
  rw [dif_pos hq]
  simp [Bool.and_eq_true, bne_iff_ne, decide_eq_true_eq, beq_iff_eq, Nat.pos_iff_ne_zero] at h ⊢
  rcases h with ⟨⟨⟨hm, hd⟩, hdb⟩, hs⟩
  exact ⟨⟨hm, ⟨hd, hdb⟩⟩, hs⟩

private lemma ruleGood_sound {q d n : Nat} (h : ruleGoodB q d n = true) :
    ∃ k ∈ Finset.Ico 1 ((n - 1) / 2 + 1), Nat.sqrt (Nat.totient k * Nat.totient (n-k)) ^ 2 = Nat.totient k * Nat.totient (n-k) := by
  unfold ruleGoodB at h
  split at h <;> try contradiction
  rename_i hq
  let m := n / q
  let b := q - d
  let r := ratioList d.primeFactorsList m * ratioList b.primeFactorsList m
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h with ⟨hcond, hr⟩
  rcases hcond with ⟨hmpos, hdpos, hdb_lt⟩
  have hbpos : 0 < b := by omega
  have hdne : d ≠ 0 := by omega
  have hbne : b ≠ 0 := by omega
  have hdleq : d ≤ q := by omega
  have hqeq : q = d + b := by dsimp [b]; omega
  have hnq' : n = m * q := (Nat.div_mul_cancel hq).symm
  have hnq : n = q * m := by rw [hnq', mul_comm]
  let k := d * m
  refine ⟨k, ?_, ?_⟩
  · simp [Finset.mem_Ico]
    constructor
    · exact Nat.mul_pos hdpos hmpos
    · have hn_eq : n = (d + b) * m := by rw [hnq, hqeq]
      have h2d : 2 * d < d + b := by omega
      have hmul := Nat.mul_lt_mul_of_pos_right h2d hmpos
      have : 2 * (d * m) < n := by
        calc
          2 * (d * m) = (2 * d) * m := by ring
          _ < (d + b) * m := hmul
          _ = n := by rw [hn_eq]
      omega
  · have hn_eq : n = (d + b) * m := by rw [hnq, hqeq]
    have hnk : n - k = b * m := by
      dsimp [k]
      rw [hn_eq, Nat.add_mul]
      omega
    have htd : Nat.totient k = ratioList d.primeFactorsList m * Nat.totient m := by
      dsimp [k]
      exact totient_mul_coeff hdne
    have htb : Nat.totient (n-k) = ratioList b.primeFactorsList m * Nat.totient m := by
      rw [hnk]
      exact totient_mul_coeff hbne
    let s := Nat.sqrt r
    have hs : s * s = r := by simpa [pow_two, s] using hr
    have hs' : ratioList d.primeFactorsList m * ratioList b.primeFactorsList m = s * s := by
      simpa [r, pow_two, s] using hr.symm
    have hprod : Nat.totient k * Nat.totient (n-k) = (s * Nat.totient m) * (s * Nat.totient m) := by
      rw [htd, htb]
      calc
        (ratioList d.primeFactorsList m * Nat.totient m) *
            (ratioList b.primeFactorsList m * Nat.totient m)
            = (ratioList d.primeFactorsList m * ratioList b.primeFactorsList m) *
              (Nat.totient m * Nat.totient m) := by ring
        _ = (s * s) * (Nat.totient m * Nat.totient m) := by rw [hs']
        _ = (s * Nat.totient m) * (s * Nat.totient m) := by ring
    rw [hprod, Nat.sqrt_eq]
    ring

private structure Rule where
  q : Nat
  d : Nat
  ld : List Nat
  lb : List Nat
  hld : ld.prod = d
  hlb : lb.prod = q - d
  hpld : ∀ p ∈ ld, Nat.Prime p
  hplb : ∀ p ∈ lb, Nat.Prime p

private def ruleGoodB' (r : Rule) (n : Nat) : Bool :=
  if hq : r.q ∣ n then
    let m := n / r.q
    let b := r.q - r.d
    let rr := ratioList r.ld m * ratioList r.lb m
    decide (0 < m ∧ 0 < r.d ∧ r.d < b) && decide (Nat.sqrt rr ^ 2 = rr)
  else false

private def ruleGoodFast (r : Rule) (n : Nat) : Bool :=
  if n % r.q = 0 then
    let m := n / r.q
    let b := r.q - r.d
    let rr := ratioList r.ld m * ratioList r.lb m
    (m != 0) && (r.d != 0) && (r.d < b) && (Nat.sqrt rr ^ 2 == rr)
  else false

private lemma ruleGoodFast_sound {r : Rule} {n : Nat} (h : ruleGoodFast r n = true) : ruleGoodB' r n = true := by
  unfold ruleGoodFast at h
  unfold ruleGoodB'
  split at h <;> try contradiction
  rename_i hmod
  have hq : r.q ∣ n := Nat.dvd_of_mod_eq_zero hmod
  rw [dif_pos hq]
  simp [Bool.and_eq_true, bne_iff_ne, decide_eq_true_eq, beq_iff_eq, Nat.pos_iff_ne_zero] at h ⊢
  rcases h with ⟨⟨⟨hm, hd⟩, hdb⟩, hs⟩
  exact ⟨⟨hm, ⟨hd, hdb⟩⟩, hs⟩

private lemma ruleGood_sound' {r : Rule} {n : Nat} (h : ruleGoodB' r n = true) :
    ∃ k ∈ Finset.Ico 1 ((n - 1) / 2 + 1), Nat.sqrt (Nat.totient k * Nat.totient (n-k)) ^ 2 = Nat.totient k * Nat.totient (n-k) := by
  rcases r with ⟨q,d,ld,lb,hld,hlb,hpld,hplb⟩
  unfold ruleGoodB' at h
  simp only at h
  split at h <;> try contradiction
  rename_i hq
  let m := n / q
  let b := q - d
  let rr := ratioList ld m * ratioList lb m
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h with ⟨hcond, hr⟩
  rcases hcond with ⟨hmpos, hdpos, hdb_lt⟩
  have hbpos : 0 < b := by omega
  have hdne : d ≠ 0 := by omega
  have hbne : b ≠ 0 := by omega
  have hqeq : q = d + b := by dsimp [b]; omega
  have hnq' : n = m * q := (Nat.div_mul_cancel hq).symm
  have hnq : n = q * m := by rw [hnq', mul_comm]
  let k := d * m
  refine ⟨k, ?_, ?_⟩
  · simp [Finset.mem_Ico]
    constructor
    · exact Nat.mul_pos hdpos hmpos
    · have hn_eq : n = (d + b) * m := by rw [hnq, hqeq]
      have h2d : 2 * d < d + b := by omega
      have hmul := Nat.mul_lt_mul_of_pos_right h2d hmpos
      have : 2 * (d * m) < n := by
        calc
          2 * (d * m) = (2 * d) * m := by ring
          _ < (d + b) * m := hmul
          _ = n := by rw [hn_eq]
      omega
  · have hn_eq : n = (d + b) * m := by rw [hnq, hqeq]
    have hnk : n - k = b * m := by
      dsimp [k]
      rw [hn_eq, Nat.add_mul]
      omega
    have htd : Nat.totient k = ratioList ld m * Nat.totient m := by
      dsimp [k]
      rw [← hld]
      exact totient_prod_mul_eq_ratioList ld hpld m
    have htb : Nat.totient (n-k) = ratioList lb m * Nat.totient m := by
      rw [hnk]
      have hlb' : lb.prod = b := by dsimp [b]; exact hlb
      rw [← hlb']
      exact totient_prod_mul_eq_ratioList lb hplb m
    let s := Nat.sqrt rr
    have hs' : ratioList ld m * ratioList lb m = s * s := by
      simpa [rr, pow_two, s] using hr.symm
    have hprod : Nat.totient k * Nat.totient (n-k) = (s * Nat.totient m) * (s * Nat.totient m) := by
      rw [htd, htb]
      calc
        (ratioList ld m * Nat.totient m) * (ratioList lb m * Nat.totient m)
            = (ratioList ld m * ratioList lb m) * (Nat.totient m * Nat.totient m) := by ring
        _ = (s * s) * (Nat.totient m * Nat.totient m) := by rw [hs']
        _ = (s * Nat.totient m) * (s * Nat.totient m) := by ring
    rw [hprod, Nat.sqrt_eq]
    ring

