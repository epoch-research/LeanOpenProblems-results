private lemma checkAllCore_sound {fuel start n pos : Nat} (h : checkAllCore fuel start pos = true)
    (hlo : start ≤ n) (hhi : n < start + fuel) :
    ∃ k ∈ Finset.Ico 1 ((n - 1) / 2 + 1), Nat.sqrt (Nat.totient k * Nat.totient (n-k)) ^ 2 = Nat.totient k * Nat.totient (n-k) := by
  induction fuel generalizing start pos with
  | zero => omega
  | succ fuel ih =>
      by_cases hn : n = start
      · subst n
        unfold checkAllCore at h
        dsimp at h
        by_cases hc : decByte (recordBytes.get! pos) < directRuleCount
        · simp [hc] at h
          by_cases hr : ruleCodeGoodB (decByte (recordBytes.get! pos)) start = true
          · exact ruleCodeGood_sound hr
          · simp [hr] at h
        · simp [hc] at h
          by_cases hec : decByte (recordBytes.get! pos) = exceptionMarker
          · simp [hec] at h
            by_cases he : ruleGoodBFast (start / Nat.gcd start (decodeWitnessAt (pos + 1))) (decodeWitnessAt (pos + 1) / Nat.gcd start (decodeWitnessAt (pos + 1))) start = true
            · exact ruleGood_sound (ruleGoodBFast_sound he)
            · simp [he] at h
          · simp [hec] at h
            by_cases hr : ruleCodeGoodB (decodeWitnessAt (pos + 1)) start = true
            · exact ruleCodeGood_sound hr
            · simp [hr] at h
      · unfold checkAllCore at h
        dsimp at h
        by_cases hc : decByte (recordBytes.get! pos) < directRuleCount
        · simp [hc] at h
          by_cases hr : ruleCodeGoodB (decByte (recordBytes.get! pos)) start = true
          · simp [hr] at h
            exact ih h (by omega) (by omega)
          · simp [hr] at h
        · simp [hc] at h
          by_cases hec : decByte (recordBytes.get! pos) = exceptionMarker
          · simp [hec] at h
            by_cases he : ruleGoodBFast (start / Nat.gcd start (decodeWitnessAt (pos + 1))) (decodeWitnessAt (pos + 1) / Nat.gcd start (decodeWitnessAt (pos + 1))) start = true
            · simp [he] at h
              exact ih h (by omega) (by omega)
            · simp [he] at h
          · simp [hec] at h
            by_cases hr : ruleCodeGoodB (decodeWitnessAt (pos + 1)) start = true
            · simp [hr] at h
              exact ih h (by omega) (by omega)
            · simp [hr] at h


private lemma a_pos_of_good {n k : Nat}
    (hk : k ∈ Ico 1 ((n - 1) / 2 + 1))
    (hm : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k)) :
    a n > 0 := by
  unfold a
  let f : Nat → Nat := fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0
  change 0 < (Ico 1 ((n - 1) / 2 + 1)).sum f
  have hle : f k ≤ (Ico 1 ((n - 1) / 2 + 1)).sum f := by
    exact Finset.single_le_sum (fun x hx => Nat.zero_le (f x)) hk
  have hfk : f k = 1 := by
    simp [f, hm]
  omega

