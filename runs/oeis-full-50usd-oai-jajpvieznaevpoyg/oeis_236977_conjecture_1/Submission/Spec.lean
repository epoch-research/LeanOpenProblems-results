          exact a_pos_of_good hk hm
        ·
          by_cases h4 : n < 500009
          · rcases @checkAllCore_sound 100000 400009 n 567608 checked_witnesses4 (by omega) (by omega) with ⟨k, hk, hm⟩
            exact a_pos_of_good hk hm
          ·
            by_cases h5 : n < 600009
            · rcases @checkAllCore_sound 100000 500009 n 710080 checked_witnesses5 (by omega) (by omega) with ⟨k, hk, hm⟩
              exact a_pos_of_good hk hm
            ·
              by_cases h6 : n < 700009
              · rcases @checkAllCore_sound 100000 600009 n 852674 checked_witnesses6 (by omega) (by omega) with ⟨k, hk, hm⟩
                exact a_pos_of_good hk hm
              ·
                by_cases h7 : n < 800009
                · rcases @checkAllCore_sound 100000 700009 n 995522 checked_witnesses7 (by omega) (by omega) with ⟨k, hk, hm⟩
                  exact a_pos_of_good hk hm
                ·
                  by_cases h8 : n < 900009
                  · rcases @checkAllCore_sound 100000 800009 n 1138532 checked_witnesses8 (by omega) (by omega) with ⟨k, hk, hm⟩
                    exact a_pos_of_good hk hm
                  ·
                    by_cases h9 : n < 1000009
                    · rcases @checkAllCore_sound 100000 900009 n 1281542 checked_witnesses9 (by omega) (by omega) with ⟨k, hk, hm⟩
                      exact a_pos_of_good hk hm
                    ·
                      by_cases h10 : n < 1100009
                      · rcases @checkAllCore_sound 100000 1000009 n 1424656 checked_witnesses10 (by omega) (by omega) with ⟨k, hk, hm⟩
                        exact a_pos_of_good hk hm
                      ·
                        by_cases h11 : n < 1200009
                        · rcases @checkAllCore_sound 100000 1100009 n 1567902 checked_witnesses11 (by omega) (by omega) with ⟨k, hk, hm⟩
