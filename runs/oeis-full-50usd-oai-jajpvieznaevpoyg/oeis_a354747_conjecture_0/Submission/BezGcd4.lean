import FormalConjectures.Util.ProblemImports
set_option maxHeartbeats 0

lemma gcd_eq_one_of_linear (a n : Nat) (A B : Int)
    (hlin : A * (a:Int) + B * (n:Int) = 1) : Nat.gcd a n = 1 := by
  let g := Nat.gcd a n
  have hga_nat : g ∣ a := Nat.gcd_dvd_left _ _
  have hgn_nat : g ∣ n := Nat.gcd_dvd_right _ _
  have hga : (g:Int) ∣ (a:Int) := Int.ofNat_dvd.mpr hga_nat
  have hgn : (g:Int) ∣ (n:Int) := Int.ofNat_dvd.mpr hgn_nat
  have hgd : (g:Int) ∣ (1:Int) := by
    rw [← hlin]
    exact dvd_add (dvd_mul_of_dvd_right hga A) (dvd_mul_of_dvd_right hgn B)
  have hg1 : g ∣ 1 := Int.ofNat_dvd.mp hgd
  exact Nat.eq_one_of_dvd_one hg1

theorem gcd_coord_4 : Nat.gcd   = 1 := by
  apply gcd_eq_one_of_linear (A := (:Int)) (B := (-:Int))
  norm_num
#print axioms gcd_coord_4
