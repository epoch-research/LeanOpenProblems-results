import FormalConjectures.Util.ProblemImports
set_option maxRecDepth 200000
set_option maxHeartbeats 0
namespace T
structure Elt where
  u : Nat
  v : Nat
  deriving BEq, DecidableEq
structure State where
  base : Elt
  a1 : Elt
  a2 : Elt
  a3 : Elt
  a4 : Elt
  e1 : Nat
  e2 : Nat
  e3 : Nat
  e4 : Nat
  deriving BEq, DecidableEq

def N : Nat := 
def emul (m : Nat) (x y : Elt) : Elt := ⟨(x.u*y.u + x.u*y.v + x.v*y.u) % m, (5*x.u*y.u + x.v*y.v) % m⟩
def stepAcc (m : Nat) (base acc : Elt) (e : Nat) : Elt := if e % 2 = 1 then emul m acc base else acc
def advStep (m : Nat) (s : State) : State := { base := emul m s.base s.base, a1 := stepAcc m s.base s.a1 s.e1, a2 := stepAcc m s.base s.a2 s.e2, a3 := stepAcc m s.base s.a3 s.e3, a4 := stepAcc m s.base s.a4 s.e4, e1 := s.e1/2, e2 := s.e2/2, e3 := s.e3/2, e4 := s.e4/2 }
def advAux : Nat → Nat → State → State | 0, m, s => s | n+1, m, s => advAux n m (advStep m s)

def s0 : State := { base := { u := , v :=  }, a1 := { u := 0, v := 1 }, a2 := { u := 0, v := 1 }, a3 := { u := 0, v := 1 }, a4 := { u := 0, v := 1 }, e1 := , e2 := , e3 := , e4 :=  }
def s1 : State := { base := { u := , v :=  }, a1 := { u := , v :=  }, a2 := { u := , v :=  }, a3 := { u := , v :=  }, a4 := { u := , v :=  }, e1 := , e2 := , e3 := , e4 :=  }
theorem seg_test : advAux 200 N s0 = s1 := by decide +kernel
#print axioms seg_test
end T
