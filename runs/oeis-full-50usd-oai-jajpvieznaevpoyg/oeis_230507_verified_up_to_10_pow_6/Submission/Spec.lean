private def pairA (k : Nat) : Nat × Nat := Id.run do
  let mut ans := (0,0)
  for a in SsmallArr do
    let b := k - a
    if ans == (0,0) && a ≤ b && a + b == k && isSsmall b then
      ans := (a,b)
  return ans

private def pairB (k : Nat) : Nat × Nat := Id.run do
  let mut ans := (0,0)
  for a in PsmallArr do
    let b := k - a
    if ans == (0,0) && a + b == k && isPsmall b then
      ans := (a,b)
  return ans

private def PairBaseA (k : Nat) : Prop :=
  let p := pairA k
  p.1 + p.2 = k ∧ 1 ≤ p.1 ∧ p.1 ≤ p.2 ∧ isSsmall p.1 = true ∧ isSsmall p.2 = true
private def PairBaseB (k : Nat) : Prop :=
  let p := pairB k
  p.1 + p.2 = k ∧ isPsmall p.1 = true ∧ isPsmall p.2 = true

private def GoodOffA (O : Off) : Prop :=
  O.l ≤ O.r ∧ O.r ≤ 50000 ∧ ∀ j : Fin (O.r + 1 - O.l), PairBaseA (O.l + j.1)
private def GoodOffB (O : Off) : Prop :=
  O.l ≤ O.r ∧ O.r ≤ 50000 ∧ ∀ j : Fin (O.r + 1 - O.l), PairBaseB (O.l + j.1)
private def AllGoodOffA : List Off → Prop | [] => True | O::t => GoodOffA O ∧ AllGoodOffA t
private def AllGoodOffB : List Off → Prop | [] => True | O::t => GoodOffB O ∧ AllGoodOffB t

