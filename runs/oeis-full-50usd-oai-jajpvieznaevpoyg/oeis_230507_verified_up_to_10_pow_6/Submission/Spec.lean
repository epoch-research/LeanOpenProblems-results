private instance decidableChainCovers (start stop : Nat) : (L : List Intv) → Decidable (ChainCovers start stop L)
  | [] => inferInstanceAs (Decidable (stop < start))
  | I :: t => by
      have htail : Decidable (ChainCovers (I.hi + 1) stop t) := decidableChainCovers (I.hi + 1) stop t
      exact inferInstanceAs (Decidable (I.lo ≤ start ∧ start ≤ I.hi ∧ ChainCovers (I.hi + 1) stop t))

