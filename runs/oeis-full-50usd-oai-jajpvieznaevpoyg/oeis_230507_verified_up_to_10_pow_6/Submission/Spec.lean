private theorem hSmallA : ∀ i : Fin 97,
    let t := smallAarr.getD i.1 (0,0,0)
    1 ≤ t.1 ∧ t.1 ≤ t.2.1 ∧ t.2.1 ≤ t.2.2 ∧
    i.1 + 3 = t.1 + t.2.1 + t.2.2 ∧
    S_condition t.1 ∧ S_condition t.2.1 ∧ S_condition t.2.2 := by
  native_decide

/-- oeis_230507_conjecture_2: We have verified the conjecture for n up to 10^6.

This formalizes the claim that both parts of the conjecture hold for $n$ up to $10^6$. -/
theorem oeis_230507_verified_up_to_10_pow_6 :
  (∀ n : ℕ, n > 2 ∧ n ≤ 10^6 → A230507 n > 0)
  ∧
  (∀ n : ℕ, n > 8 ∧ n ≤ 10^6 → ∃ (x y z : ℕ), n = x + y + z ∧ P2_condition x ∧ P2_condition y ∧ Z_condition z) := by
  constructor
  · intro n hn
    by_cases hsmall : n < 100
    · have hn3 : 3 ≤ n := by omega
      have hi : n - 3 < 97 := by omega
      let i : Fin 97 := ⟨n-3, hi⟩
      have heq : i.1 + 3 = n := by dsimp [i]; omega
      have hc := hSmallA i
      let t := smallAarr.getD i.1 (0,0,0)
      dsimp at hc
      change 1 ≤ t.1 ∧ t.1 ≤ t.2.1 ∧ t.2.1 ≤ t.2.2 ∧ i.1 + 3 = t.1 + t.2.1 + t.2.2 ∧ S_condition t.1 ∧ S_condition t.2.1 ∧ S_condition t.2.2 at hc
      rcases hc with ⟨ha1, hab, hbc, hsum, hSa, hSb, hSc⟩
      apply A230507_pos_of_witness (a := t.1) (b := t.2.1) (c := t.2.2)
      · exact ha1
      · exact hab
      · exact hbc
      · omega
      · exact hSa
      · exact hSb
      · exact hSc
    · have hn100 : 100 ≤ n := by omega
      have hnN : n ≤ 1000000 := by norm_num at hn ⊢; omega
      rcases exists_interval_of_chain hCoverA_chain hn100 hnN with ⟨I,hImem,hIlo,hIhi⟩
      have hG := goodA_of_mem hCoverA_good hImem
      dsimp [GoodA] at hG
      rcases hG with ⟨hloeq,hhieq,hlr,hrK,hrc,hSc_bool,hOffmem⟩
      have hSc := isSsmall_sound I.c hSc_bool
      let k := n - I.c
      have hk_l : I.l ≤ k := by dsimp [k]; omega
      have hk_r : k ≤ I.r := by dsimp [k]; omega
      have hOffG := goodOffA_of_mem hOffA_good hOffmem
      dsimp [GoodOffA] at hOffG
      rcases hOffG with ⟨_,_,hbaseAll⟩
      have hjbound : k - I.l < I.r + 1 - I.l := by omega
      have hbase := hbaseAll ⟨k-I.l,hjbound⟩
      have hkeq : I.l + (k-I.l)=k := by omega
      rw [hkeq] at hbase
      dsimp [PairBaseA] at hbase
      let p := pairA k
      change p.1 + p.2 = k ∧ 1 ≤ p.1 ∧ p.1 ≤ p.2 ∧ isSsmall p.1 = true ∧ isSsmall p.2 = true at hbase

      rcases hbase with ⟨hsumk,ha1,hab,hSa_bool,hSb_bool⟩
      have hSa := isSsmall_sound p.1 hSa_bool
      have hSb := isSsmall_sound p.2 hSb_bool
      have hkK : k < 50000+1 := by omega
      apply A230507_pos_of_witness (a:=p.1) (b:=p.2) (c:=I.c)
      · exact ha1
      · exact hab
      · dsimp [p,k] at hsumk ⊢; omega
      · dsimp [p,k] at hsumk ⊢; omega
      · exact hSa
      · exact hSb
      · exact hSc
  · intro n hn
    have hn9 : 9 ≤ n := by omega
    have hnN : n ≤ 1000000 := by norm_num at hn ⊢; omega
    rcases exists_interval_of_chain hCoverB_chain hn9 hnN with ⟨I,hImem,hIlo,hIhi⟩
    have hG := goodB_of_mem hCoverB_good hImem
    dsimp [GoodB] at hG
    rcases hG with ⟨hloeq,hhieq,hlr,hrK,hZc_bool,hOffmem⟩
    have hZc := isZgood_sound I.c hZc_bool
    let k := n - I.c
    have hk_l : I.l ≤ k := by dsimp [k]; omega
    have hk_r : k ≤ I.r := by dsimp [k]; omega
    have hOffG := goodOffB_of_mem hOffB_good hOffmem
    dsimp [GoodOffB] at hOffG
    rcases hOffG with ⟨_,_,hbaseAll⟩
    have hjbound : k - I.l < I.r + 1 - I.l := by omega
    have hbase := hbaseAll ⟨k-I.l,hjbound⟩
    have hkeq : I.l + (k-I.l)=k := by omega
    rw [hkeq] at hbase
    dsimp [PairBaseB] at hbase
    let p := pairB k
    change p.1 + p.2 = k ∧ isPsmall p.1 = true ∧ isPsmall p.2 = true at hbase
    rcases hbase with ⟨hsumk,hPx_bool,hPy_bool⟩
    have hPx := isPsmall_sound p.1 hPx_bool
    have hPy := isPsmall_sound p.2 hPy_bool
    refine ⟨p.1,p.2,I.c,?_,hPx,hPy,hZc⟩
    dsimp [p,k] at hsumk ⊢; omega

