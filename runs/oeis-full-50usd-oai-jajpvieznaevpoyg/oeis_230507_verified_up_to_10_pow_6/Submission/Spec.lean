private lemma prime_dvd_list_prod {q : Nat} (L : List Nat)
    (hL : ∀ p ∈ L, Nat.Prime p) (hq : Nat.Prime q) :
    q ∣ L.prod → q ∈ L := by
  induction L with
  | nil =>
      intro hdiv
      simp at hdiv
      exact False.elim (hq.ne_one hdiv)
  | cons a t ih =>
      intro hdiv
      simp at hdiv ⊢
      have ha : Nat.Prime a := hL a (by simp)
      have ht : ∀ p ∈ t, Nat.Prime p := by
        intro p hp; exact hL p (by simp [hp])
      have hsplit := hq.dvd_mul.mp hdiv
      rcases hsplit with hqa | hqt
      · rcases ha.eq_one_or_self_of_dvd q hqa with hq1 | hqa_eq
        · exact False.elim (hq.ne_one hq1)
        · left; exact hqa_eq
      · right
        exact ih ht hqt


lemma prime_dvd_list_prod {q : Nat} (L : List Nat)
    (hL : ∀ p ∈ L, Nat.Prime p) (hq : Nat.Prime q) :
    q ∣ L.prod → q ∈ L := by
  induction L with
  | nil => intro h; exact (hq.not_dvd_one h).elim
  | cons a t ih =>
      intro hdiv
      simp at hL ⊢
      have hqa : q ∣ a ∨ q ∣ t.prod := by simpa using (Nat.Prime.dvd_mul hq).mp hdiv
      rcases hqa with hqa | hqt
      · exact Or.inl ((Nat.Prime.dvd_iff_eq hL.1 hq.ne_one).mp hqa).symm
      · exact Or.inr (ih (by intro p hp; exact hL.2 p hp) hqt)

lemma dvd_of_prime_dvd_all_distinct {L : List Nat} {d : Nat}
    (hprime : ∀ q ∈ L, Nat.Prime q) (hdist : L.Nodup)
    (hdiv : ∀ q ∈ L, q ∣ d) : L.prod ∣ d := by
  induction L with
  | nil => simp
  | cons q qs ih =>
      simp at hdist hprime hdiv ⊢
      have hqsdiv : qs.prod ∣ d := ih (by intro r hr; exact hprime.2 r hr) hdist.2 (by intro r hr; exact hdiv.2 r hr)
      have hcop : Nat.Coprime q qs.prod := by
        apply hprime.1.coprime_iff_not_dvd.mpr
        intro hqd
        exact hdist.1 (prime_dvd_list_prod qs (by intro r hr; exact hprime.2 r hr) hprime.1 hqd)
      exact hcop.mul_dvd_of_dvd_of_dvd hdiv.1 hqsdiv

lemma dvd_div_of_prime_not_dvd {q d N : Nat} (hq : Nat.Prime q) (hqN : q ∣ N) (hdN : d ∣ N)
    (hqd : ¬ q ∣ d) : d ∣ N / q := by
  have hc : Nat.Coprime d q := (hq.coprime_iff_not_dvd.mpr hqd).symm
  have hdq : d * q ∣ N := hc.mul_dvd_of_dvd_of_dvd hdN hqN
  rw [Nat.dvd_div_iff_mul_dvd hqN]
  simpa [mul_comm] using hdq

lemma pocklington_list (n a : Nat) (L : List Nat)
    (hn2 : 2 ≤ n) (hLprime : ∀ q ∈ L, Nat.Prime q) (hLnodup : L.Nodup)
    (hLdiv : L.prod ∣ n - 1) (hlarge : n < L.prod * L.prod)
    (ha : (a : ZMod n) ^ (n - 1) = 1)
    (hneq : ∀ q ∈ L, IsUnit ((a : ZMod n) ^ ((n - 1) / q) - 1)) : Nat.Prime n := by
  rw [Nat.prime_def_le_sqrt]
  refine ⟨hn2, ?_⟩
  intro m hm2 hmsqrt hmn
  have hm1 : 1 < m := lt_of_lt_of_le (by decide : 1 < 2) hm2
  let f : ZMod n →+* ZMod m := ZMod.castHom hmn (ZMod m)
  haveI : Fact (1 < m) := ⟨hm1⟩
  haveI : NeZero m := ⟨by omega⟩
  have ha_m : (a : ZMod m) ^ (n - 1) = 1 := by
    have hmap := congrArg f ha
    change ZMod.cast ((a : ZMod n) ^ (n - 1)) = (ZMod.cast (1 : ZMod n) : ZMod m) at hmap
    simpa [ZMod.cast_pow (R := ZMod m) hmn, ZMod.cast_one (R := ZMod m) hmn, ZMod.cast_natCast (R := ZMod m) hmn] using hmap
  have hn1ne : n - 1 ≠ 0 := by omega
  have hau : IsUnit (a : ZMod m) := IsUnit.of_pow_eq_one ha_m hn1ne
  obtain ⟨u, huval⟩ := hau
  have order_dvd_N : orderOf u ∣ n - 1 := by
    apply orderOf_dvd_of_pow_eq_one
    ext
    simp [huval, ha_m]
  have q_dvd_order : ∀ q ∈ L, q ∣ orderOf u := by
    intro q hqmem
    have hqprime := hLprime q hqmem
    have hqdivN : q ∣ n - 1 := dvd_trans (List.dvd_prod hqmem) hLdiv
    have hnot : ¬ orderOf u ∣ (n - 1) / q := by
      intro hd
      have poweq : (a : ZMod m) ^ ((n - 1) / q) = 1 := by
        have hu := orderOf_dvd_iff_pow_eq_one.mp hd
        replace hu := congrArg Units.val hu
        simpa [huval] using hu
      have unit_n : IsUnit ((a : ZMod n) ^ ((n - 1) / q) - 1) := hneq q hqmem
      have unit_m : IsUnit (f ((a : ZMod n) ^ ((n - 1) / q) - 1)) := unit_n.map f
      have hz : f ((a : ZMod n) ^ ((n - 1) / q) - 1) = (0 : ZMod m) := by
        change ZMod.cast (((a : ZMod n) ^ ((n - 1) / q) - 1)) = (0 : ZMod m)
        rw [ZMod.cast_sub (R := ZMod m) hmn, ZMod.cast_pow (R := ZMod m) hmn, ZMod.cast_natCast (R := ZMod m) hmn, ZMod.cast_one (R := ZMod m) hmn, poweq]
        simp
      have unit_zero : IsUnit (0 : ZMod m) := by
        rwa [← hz]
      exact (not_isUnit_zero (M₀ := ZMod m)) unit_zero
    by_contra hqord
    exact hnot (dvd_div_of_prime_not_dvd hqprime hqdivN order_dvd_N hqord)
  have L_dvd_order : L.prod ∣ orderOf u := dvd_of_prime_dvd_all_distinct hLprime hLnodup q_dvd_order
  have hLeOrder := Nat.le_of_dvd (orderOf_pos u) L_dvd_order
  have hOrderLe : orderOf u ≤ m - 1 := by
    calc orderOf u ≤ Fintype.card (ZMod m)ˣ := orderOf_le_card_univ
      _ ≤ m - 1 := Nat.card_units_zmod_lt_sub_one hm1
  have hLle : L.prod ≤ m - 1 := le_trans hLeOrder hOrderLe
  have hLsqrt : L.prod ≤ sqrt n := by omega
  exact not_lt_of_ge (Nat.le_sqrt.mp hLsqrt) hlarge

