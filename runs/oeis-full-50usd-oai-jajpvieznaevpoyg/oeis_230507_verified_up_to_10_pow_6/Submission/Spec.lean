private instance decidableAllGoodOffA : (L : List Off) → Decidable (AllGoodOffA L)
  | [] => isTrue trivial
  | O :: t => by
      have htail : Decidable (AllGoodOffA t) := decidableAllGoodOffA t
      exact inferInstanceAs (Decidable (GoodOffA O ∧ AllGoodOffA t))
private instance decidableAllGoodOffB : (L : List Off) → Decidable (AllGoodOffB L)
  | [] => isTrue trivial
