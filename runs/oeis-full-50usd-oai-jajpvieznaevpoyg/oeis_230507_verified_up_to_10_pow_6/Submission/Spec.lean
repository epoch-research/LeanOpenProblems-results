private lemma A230507_pos_of_witness {n a b c : ℕ}
    (ha1 : 1 ≤ a) (hab : a ≤ b) (hbc : b ≤ c)
    (hsum : n = a + b + c)
    (hSa : S_condition a) (hSb : S_condition b) (hSc : S_condition c) :
    A230507 n > 0 := by
  unfold A230507
  apply Finset.sum_pos'
  · intro x hx
    apply Finset.sum_nonneg
    intro y hy
    by_cases hcond : S_condition x ∧ S_condition y ∧ S_condition (n - x - y)
    · simp [hcond]
    · simp [hcond]
  · have ha_mem : a ∈ Finset.Icc 1 (n / 3) := by
      simp only [Finset.mem_Icc]
      constructor
      · exact ha1
      · rw [hsum]
        apply (Nat.le_div_iff_mul_le (by norm_num : 0 < 3)).2
        nlinarith [hab, hbc]
    refine ⟨a, ha_mem, ?_⟩
    apply Finset.sum_pos'
    · intro y hy
      by_cases hcond : S_condition a ∧ S_condition y ∧ S_condition (n - a - y)
      · simp [hcond]
      · simp [hcond]
    · have hb_mem : b ∈ Finset.Icc a ((n - a) / 2) := by
        simp only [Finset.mem_Icc]
        constructor
        · exact hab
        · rw [hsum]
          have hsub : a + b + c - a = b + c := by omega
          rw [hsub]
          apply (Nat.le_div_iff_mul_le (by norm_num : 0 < 2)).2
          nlinarith [hbc]
      refine ⟨b, hb_mem, ?_⟩
      have hc_eq : n - a - b = c := by omega
      rw [hc_eq]
      simp [hSa, hSb, hSc]

private lemma exists_interval_of_chain {L : List Intv} {start stop n : Nat}
    (hcov : ChainCovers start stop L) (hn₁ : start ≤ n) (hn₂ : n ≤ stop) :
    ∃ I, I ∈ L ∧ I.lo ≤ n ∧ n ≤ I.hi := by
  induction L generalizing start with
  | nil =>
      simp [ChainCovers] at hcov
      omega
  | cons I t ih =>
      simp [ChainCovers] at hcov
      rcases hcov with ⟨hlo, hstarthi, hrest⟩
      by_cases hnhi : n ≤ I.hi
      · exact ⟨I, by simp, le_trans hlo hn₁, hnhi⟩
      · have hnnext : I.hi + 1 ≤ n := by omega
        rcases ih (start := I.hi + 1) hrest hnnext with ⟨J, hJmem, hJlo, hJhi⟩
        exact ⟨J, by simp [hJmem], hJlo, hJhi⟩

private lemma goodA_of_mem {I : Intv} : ∀ {L : List Intv}, AllGoodA L → I ∈ L → GoodA I
  | [], h, hm => by simp at hm
  | J :: t, h, hm => by
      simp [AllGoodA] at h
      rcases h with ⟨hJ, ht⟩
      simp at hm
      rcases hm with rfl | hm
      · exact hJ
      · exact goodA_of_mem ht hm

