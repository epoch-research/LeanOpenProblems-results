private unsafe def parseCertsFast (s : String) : Array TopCert := Id.run do
  let it0 := String.Legacy.mkIterator s
  if ¬ it0.hasNext then return #[]
  let (cnt, it1) := readVarFast it0
  let mut it := it1
  let mut arr : Array TopCert := #[]
  let mut t := 0
  while t < cnt do
    let (k, it2) := readVarFast it
    let (aa, it3) := readVarFast it2
    let (fc, it4) := readVarFast it3
    it := it4
    let mut fs : List (ℕ × ℕ) := []
    let mut j := 0
    while j < fc do
      let (q, ita) := readVarFast it
      let (e, itb) := readVarFast ita
      it := itb
      fs := (q,e) :: fs
      j := j + 1
    arr := arr.push ⟨k, aa, fs.reverse⟩
    t := t + 1
  return arr


