private def certs : Array TopCert := parseCerts certData

def TopOK (t : ℕ) : Prop :=
  let c := certs.getD t defaultCert
  let n := t + 1
  let p := c.k ^ 4 + (2 * n + 1 - c.k) ^ 4
  c.k ∈ Finset.Icc 1 n ∧ CertOK p c
instance (t : ℕ) : Decidable (TopOK t) := by unfold TopOK; infer_instance

private unsafe def checkAllTopFast (start fuel : ℕ) : Bool := Id.run do
  let it0 := String.Legacy.mkIterator certData
  if ¬ it0.hasNext then return false
  let (cnt,it1) := readVarFast it0
  if cnt ≠ 499999 then return false
  let mut it := it1
  let mut t := 0
  while t < cnt ∧ t < start + fuel do
    let (k,it2) := readVarFast it
    let (aa,it3) := readVarFast it2
    let (fc,it4) := readVarFast it3
    it := it4
    let n := t+1
    if ¬ (1 ≤ k ∧ k ≤ n) then return false
    let p := k^4 + (2*n+1-k)^4
    if ¬ (2 < p) then return false
    let mut prod := 1
    let mut fcount := fc
    while 0 < fcount do
      let (q,ita) := readVarFast it
      let (e,itb) := readVarFast ita
      it := itb
      if ¬ (0 < e) then return false
      prod := q^e * prod
      fcount := fcount - 1
    if prod ≠ p-1 then return false
    t := t+1
  return true

@[implemented_by checkAllTopFast]
private def checkTopFrom : ℕ → ℕ → Bool
  | start, 0 => true
  | start, fuel + 1 => if decide (TopOK start) then checkTopFrom (start + 1) fuel else false

private lemma checkTopFrom_true {start fuel : ℕ} (h : checkTopFrom start fuel = true) :
    ∀ o, o < fuel → TopOK (start + o) := by
  induction fuel generalizing start with
  | zero => intro o ho; omega
  | succ fuel ih =>
      intro o ho
      unfold checkTopFrom at h
      by_cases htop : TopOK start
      · have hdec : decide (TopOK start) = true := decide_eq_true htop
        rw [hdec] at h
        cases o with
        | zero => simpa using htop
        | succ o =>
            have ho' : o < fuel := by omega
            have hs := ih h o ho'
            have hadd : start + Nat.succ o = start + 1 + o := by omega
            simpa [hadd] using hs
      · have hdec : decide (TopOK start) = false := decide_eq_false htop
        rw [hdec] at h
        contradiction

private theorem all_top_ok : checkTopFrom 0 499999 = true := by native_decide

private theorem top_good (t : ℕ) (ht : t < 499999) : TopOK t := by
  simpa using (checkTopFrom_true all_top_ok t ht)

theorem oeis_A218656_verified_range (n : ℕ) (hval : n ≤ 499999) (hn : 0 < n) : a n > 0 := by
  have ht : n - 1 < 499999 := by omega
  let c := certs.getD (n - 1) defaultCert
  have hnsub : n - 1 + 1 = n := by omega
  have htop : c.k ∈ Finset.Icc 1 n ∧ CertOK (c.k ^ 4 + (2 * n + 1 - c.k) ^ 4) c := by
    have h := top_good (n - 1) ht
    change (let c := certs.getD (n - 1) defaultCert;
      let m := n - 1 + 1;
      c.k ∈ Finset.Icc 1 m ∧ CertOK (c.k ^ 4 + (2 * m + 1 - c.k) ^ 4) c) at h
    simpa [hnsub] using h
  rcases htop with ⟨hkIcc, hc⟩
  have hp : Nat.Prime (c.k ^ 4 + (2 * n + 1 - c.k) ^ 4) := prime_of_cert hc
  have hk1 : 1 ≤ c.k := (Finset.mem_Icc.mp hkIcc).1
  have hkn : c.k ≤ n := (Finset.mem_Icc.mp hkIcc).2
  unfold a
  exact Finset.card_pos.mpr ⟨c.k, by simp [hk1, hkn, hp]⟩
