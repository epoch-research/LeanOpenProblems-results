import FormalConjectures.Util.ProblemImports

set_option maxRecDepth 10000000
set_option linter.unusedVariables false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedTactic false




open Nat Finset

def a (n : ℕ) : ℕ :=
  card ((Icc 1 n).filter fun k : ℕ => Nat.Prime (k ^ 4 + (2 * n + 1 - k) ^ 4))

structure TopCert where
  k : ℕ
  a : ℕ
  factors : List (ℕ × ℕ)

def defaultCert : TopCert := ⟨1, 2, [(2,1)]⟩

def certFactorProd : List (ℕ × ℕ) → ℕ
  | [] => 1
  | f :: fs => f.1 ^ f.2 * certFactorProd fs

def FactorOK (f : ℕ × ℕ) : Prop := 0 < f.2 ∧ Nat.Prime f.1
instance (f : ℕ × ℕ) : Decidable (FactorOK f) := by unfold FactorOK; infer_instance

def CertOK (p : ℕ) (c : TopCert) : Prop :=
  2 < p ∧
  (c.factors.all (fun f => decide (FactorOK f)) = true) ∧
  certFactorProd c.factors = p - 1 ∧
  ((c.a : ZMod p) ^ (p - 1) = 1) ∧
  (c.factors.all (fun f => decide (((c.a : ZMod p) ^ ((p - 1) / f.1) ≠ 1))) = true)
instance (p : ℕ) (c : TopCert) : Decidable (CertOK p c) := by unfold CertOK; infer_instance

lemma prime_dvd_certFactorProd {q : ℕ} (hq : q.Prime) :
    ∀ {fs : List (ℕ × ℕ)},
      (∀ f ∈ fs, FactorOK f) →
      q ∣ certFactorProd fs → ∃ f ∈ fs, q = f.1 := by
  intro fs hall hdiv
  induction fs with
  | nil =>
      have h : q ∣ 1 := by simpa [certFactorProd] using hdiv
      exact (hq.not_dvd_one h).elim
  | cons f rest ih =>
      have hfok := hall f (by simp)
      have hallrest : ∀ x ∈ rest, FactorOK x := by intro x hx; exact hall x (by simp [hx])
      have hdiv' : q ∣ f.1 ^ f.2 * certFactorProd rest := by simpa [certFactorProd] using hdiv
      rcases hq.dvd_mul.mp hdiv' with hqpow | hqrest
      · have hqnum : q ∣ f.1 := hq.dvd_of_dvd_pow hqpow
        have hpnum : f.1.Prime := hfok.2
        have heq : q = f.1 := (Nat.prime_dvd_prime_iff_eq hq hpnum).mp hqnum
        exact ⟨f, by simp, heq⟩
      · rcases ih hallrest hqrest with ⟨g,hg,heq⟩
        exact ⟨g, by simp [hg], heq⟩

theorem prime_of_cert {p : ℕ} {c : TopCert} (h : CertOK p c) : Nat.Prime p := by
  unfold CertOK at h
  rcases h with ⟨h2p, hallBool, hprod, hpow, hnotBool⟩
  have hall : ∀ f ∈ c.factors, FactorOK f := by
    intro f hf
    exact of_decide_eq_true ((List.all_eq_true.mp hallBool) f hf)
  have hnot : ∀ f ∈ c.factors, ((c.a : ZMod p) ^ ((p - 1) / f.1) ≠ 1) := by
    intro f hf
    exact of_decide_eq_true ((List.all_eq_true.mp hnotBool) f hf)
  refine lucas_primality p (c.a : ZMod p) hpow ?_
  intro q hq hqdiv
  have hqprod : q ∣ certFactorProd c.factors := by simpa [hprod] using hqdiv
  rcases prime_dvd_certFactorProd hq hall hqprod with ⟨f,hf,heq⟩
  subst heq
  exact hnot f hf

private def digit? (c : Char) : Option ℕ :=
  let v := c.toNat
  if 35 ≤ v ∧ v < 92 then some (v - 35)
  else if 92 < v ∧ v < 126 then some (v - 36)
  else none
private def valOf (c : Char) : ℕ := match digit? c with | some v => v | none => 0
private def varDigit (c : Char) : ℕ := let v := valOf c; if v < 45 then v else v - 45
private def varMore (c : Char) : Bool := 45 ≤ valOf c
private def readVar (it : String.Legacy.Iterator) (acc mul : ℕ) : ℕ × String.Legacy.Iterator :=
  if h : it.hasNext then
    let d := varDigit it.curr
    let acc' := acc + mul * d
    if varMore it.curr then readVar it.next acc' (mul * 45) else (acc', it.next)
  else (acc, it)
termination_by sizeOf it
decreasing_by exact String.Legacy.Iterator.sizeOf_next_lt_of_hasNext it h
private def nextNat? (it : String.Legacy.Iterator) : Option (ℕ × String.Legacy.Iterator) := if it.hasNext then some (readVar it 0 1) else none

private unsafe def readVarFast (it0 : String.Legacy.Iterator) : ℕ × String.Legacy.Iterator := Id.run do
  let mut it := it0; let mut acc := 0; let mut mul := 1
  while it.hasNext do
    let d := varDigit it.curr; acc := acc + mul * d
    if varMore it.curr then mul := mul * 45; it := it.next
    else it := it.next; return (acc,it)
  return (acc,it)

private def takeFactors : ℕ → String.Legacy.Iterator → List (ℕ × ℕ) → List (ℕ × ℕ) × String.Legacy.Iterator
  | 0, it, acc => (acc.reverse, it)
  | n+1, it, acc =>
    match nextNat? it with
    | some (q,it1) => match nextNat? it1 with
      | some (e,it2) => takeFactors n it2 ((q,e)::acc)
      | none => (acc.reverse,it1)
    | none => (acc.reverse,it)
private def parseCertsAux : ℕ → String.Legacy.Iterator → Array TopCert → Array TopCert
  | 0, _, arr => arr
  | n+1, it, arr =>
    match nextNat? it with
    | some (k,it1) => match nextNat? it1 with
      | some (a,it2) => match nextNat? it2 with
        | some (fc,it3) => let r:=takeFactors fc it3 []; parseCertsAux n r.2 (arr.push ⟨k,a,r.1⟩)
        | none => arr
      | none => arr
    | none => arr
private def parseCerts (s : String) : Array TopCert :=
  let it:=String.Legacy.mkIterator s
  match nextNat? it with | some (c,it') => parseCertsAux c it' #[] | none => #[]

private unsafe def powModFast (a e m : ℕ) : ℕ := Id.run do
  if m=0 then return 0
  let mut b:=a%m; let mut r:=1%m; let mut k:=e
  while 0<k do
    if k%2=1 then r := (r*b)%m
    b := (b*b)%m; k := k/2
  return r

