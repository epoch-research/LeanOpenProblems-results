def pairwiseCoprimeB : List ℕ → Bool
  | [] => true
  | x :: xs => xs.all (fun y => Nat.gcd x y == 1) && pairwiseCoprimeB xs

def pairwiseCoprimePowersB (l : List (ℕ × ℕ)) : Bool :=
  pairwiseCoprimeB (l.map (fun qe => qe.1 ^ qe.2))

lemma pairwiseCoprimeB_sound : ∀ {l : List ℕ}, pairwiseCoprimeB l = true → l.Pairwise Nat.Coprime
  | [], _ => List.Pairwise.nil
  | x :: xs, h => by
      simp only [pairwiseCoprimeB, Bool.and_eq_true, List.all_eq_true] at h
      exact List.Pairwise.cons (by
        intro y hy
        have hg := h.1 y hy
        rw [beq_iff_eq] at hg
        simpa [Nat.Coprime] using hg) (pairwiseCoprimeB_sound h.2)

lemma pairwiseCoprimePowersB_sound {l : List (ℕ × ℕ)} (h : pairwiseCoprimePowersB l = true) :
    pairwiseCoprimePowers l := by
  unfold pairwiseCoprimePowers
  exact pairwiseCoprimeB_sound h

def validPockEntryB (prev : List ℕ) (e : PEntry) : Bool :=
  (e.n == 2) ||
  (Nat.ble 3 e.n &&
    e.factors.all (fun ie => Nat.blt ie.1 prev.length && Nat.ble 1 ie.2) &&
    pairwiseCoprimePowersB (factorPairs prev e) &&
    Nat.ble 1 (ppProd (factorPairs prev e)) &&
    Nat.blt e.n ((ppProd (factorPairs prev e))^2) &&
    (((e.n - 1) % (ppProd (factorPairs prev e))) == 0) &&
    ((modPow e.a (e.n - 1) e.n % e.n) == (1 % e.n)) &&
    e.factors.all (fun ie => (Nat.gcd (modPow e.a ((e.n - 1) / (prev.getD ie.1 0)) e.n - 1) e.n) == 1))

lemma validPockEntryB_sound {prev : List ℕ} {e : PEntry} (h : validPockEntryB prev e = true) :
    ValidPockEntry prev e := by
  unfold validPockEntryB at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, List.all_eq_true] at h
  cases h with
  | inl h2 =>
      rw [beq_iff_eq] at h2
      exact Or.inl h2
  | inr hr =>
      right
      rcases hr with ⟨⟨⟨⟨⟨⟨⟨hn, hidx⟩, hpw⟩, hFpos⟩, hFgt⟩, hFmod⟩, hpow⟩, hg⟩
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · exact (Nat.lt_of_succ_le (Nat.ble_eq.mp hn))
      · intro ie hie
        have hi := hidx ie hie
        simp only [Bool.and_eq_true] at hi
        exact ⟨Nat.blt_eq.mp hi.1, Nat.ble_eq.mp hi.2⟩
      · exact pairwiseCoprimePowersB_sound hpw
      · exact Nat.ble_eq.mp hFpos
      · exact Nat.blt_eq.mp hFgt
      · rw [beq_iff_eq] at hFmod
        exact hFmod
      · rw [beq_iff_eq] at hpow
        exact hpow
      · intro ie hie
        have hh := hg ie hie
        rw [beq_iff_eq] at hh
        exact hh

def checkPockDB : List ℕ → List PEntry → Bool
  | _, [] => true
  | prev, e :: es => if validPockEntryB prev e then checkPockDB (e.n :: prev) es else false

lemma checkPockDB_sound : ∀ {prev es}, checkPockDB prev es = true → ValidPockDB prev es
  | prev, [], h => by simp [ValidPockDB]
  | prev, e :: es, h => by
      simp only [checkPockDB] at h
      split at h
      · exact ⟨validPockEntryB_sound ‹validPockEntryB prev e = true›, checkPockDB_sound h⟩
      · contradiction
