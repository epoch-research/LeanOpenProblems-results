open Nat Finset
open scoped Nat.Prime BigOperators

def a (n : ℕ) : ℕ :=
  (Ico 1 n).sum fun s => if Nat.Prime (n^2 + s^2) then 1 else 0

structure PEntry where
  n : ℕ
  a : ℕ
  factors : List (ℕ × ℕ)
  deriving Repr, DecidableEq

structure Target where
  s : ℕ
  idx : ℕ
  deriving Repr, DecidableEq

def takePairs : ℕ → List ℕ → List (ℕ × ℕ) × List ℕ
  | 0, xs => ([], xs)
  | _+1, [] => ([], [])
  | _+1, [_] => ([], [])
  | k+1, i::e::xs => let r := takePairs k xs; ((i,e) :: r.1, r.2)

def parsePEntriesAux : ℕ → List ℕ → List PEntry → List PEntry × List ℕ
  | 0, xs, acc => (acc.reverse, xs)
  | _+1, [], _ => ([], [])
  | _+1, [_], _ => ([], [])
  | _+1, [_, _], _ => ([], [])
  | k+1, n::a::m::xs, acc =>
      let r := takePairs m xs
      parsePEntriesAux k r.2 ({ n := n, a := a, factors := r.1 } :: acc)

def parsePEntries (k : ℕ) (xs : List ℕ) : List PEntry := (parsePEntriesAux k xs []).1

def parseTargetsAux : ℕ → List ℕ → List Target → List Target × List ℕ
  | 0, xs, acc => (acc.reverse, xs)
  | _+1, [], _ => ([], [])
  | _+1, [_], _ => ([], [])
  | k+1, s::idx::xs, acc => parseTargetsAux k xs ({ s := s, idx := idx } :: acc)

def parseTargets (k : ℕ) (xs : List ℕ) : List Target := (parseTargetsAux k xs []).1

def modPow (a : ℕ) : ℕ → ℕ → ℕ
  | 0, m => 1 % m
  | e+1, m =>
      let t := modPow a ((e+1)/2) m
      if (e+1) % 2 = 0 then (t * t) % m else ((t * t) % m * a) % m
termination_by e m => e
 decreasing_by
  have hpos : 0 < e + 1 := Nat.succ_pos e
  have h2 : 1 < 2 := by norm_num
  exact Nat.div_lt_self hpos h2

lemma modPow_modEq (a e m : ℕ) : modPow a e m ≡ a^e [MOD m] := by
  induction e using Nat.strong_induction_on generalizing m with
  | h e ih =>
    cases e with
    | zero =>
        simp [modPow]
        exact Nat.mod_modEq 1 m
    | succ e =>
        simp only [modPow]
        set k := (e+1)/2
        have ihk : modPow a k m ≡ a^k [MOD m] := ih k (by
          have hpos : 0 < e + 1 := Nat.succ_pos e
          have h2 : 1 < 2 := by norm_num
          exact Nat.div_lt_self hpos h2) m
        by_cases hpar : (e+1) % 2 = 0
        · simp [hpar]
          have hmod : (modPow a k m * modPow a k m) % m ≡ modPow a k m * modPow a k m [MOD m] := Nat.mod_modEq _ _
          have hsq : modPow a k m * modPow a k m ≡ a^k * a^k [MOD m] := ihk.mul ihk
          have hpow : a ^ (e+1) = a^k * a^k := by
            have hdecomp := Nat.div_add_mod (e+1) 2
            have heq : e+1 = 2*k := by omega
            rw [heq, two_mul, pow_add]
          exact hmod.trans (hsq.trans (by rw [hpow]))
        · simp [hpar]
          have hmod : (modPow a k m * modPow a k m * a) % m ≡ (modPow a k m * modPow a k m * a) [MOD m] := Nat.mod_modEq _ _
          have hsq : modPow a k m * modPow a k m ≡ a^k * a^k [MOD m] := ihk.mul ihk
          have hcomb : (modPow a k m * modPow a k m * a) ≡ (a^k * a^k) * a [MOD m] := by
            simpa [mul_assoc] using hsq.mul_right a
          have hpow : a ^ (e+1) = (a^k * a^k) * a := by
            have hdecomp := Nat.div_add_mod (e+1) 2
            have hmodtwo : (e+1)%2 = 1 := by omega
            have heq : e+1 = 2*k + 1 := by omega
            rw [heq, pow_succ, two_mul, pow_add]
          exact hmod.trans (hcomb.trans (by rw [← hpow]))

lemma zmod_pow_eq_one_of_modPow {a e m : ℕ} (h : modPow a e m % m = 1 % m) :
    ((a : ZMod m)^e = 1) := by
  have hz : ((a^e : ℕ) : ZMod m) = (modPow a e m : ZMod m) := by
    rw [ZMod.natCast_eq_natCast_iff]
    exact (modPow_modEq a e m).symm
  rw [← Nat.cast_pow, hz]
  simpa using (ZMod.natCast_eq_natCast_iff' (modPow a e m) 1 m).2 h

lemma zmod_pow_ne_one_of_modPow {a e m : ℕ} (h : modPow a e m % m ≠ 1 % m) :
    ((a : ZMod m)^e ≠ 1) := by
  intro hzpow
  apply h
  have hz : ((a^e : ℕ) : ZMod m) = (modPow a e m : ZMod m) := by
    rw [ZMod.natCast_eq_natCast_iff]
    exact (modPow_modEq a e m).symm
  have hz2 : (modPow a e m : ZMod m) = (1 : ZMod m) := by
    rw [← hz]
    simpa [Nat.cast_pow] using hzpow
  exact (ZMod.natCast_eq_natCast_iff' (modPow a e m) 1 m).1 (by simpa using hz2)

lemma zmod_pow_ne_one_of_gcd {a E n r : ℕ} (hr : r.Prime) (hrn : r ∣ n)
    (hg : Nat.gcd (modPow a E n - 1) n = 1) : ((a : ZMod r)^E ≠ 1) := by
  intro hpow
  have hz : ((modPow a E n : ℕ) : ZMod r) = ((a^E : ℕ) : ZMod r) := by
    rw [ZMod.natCast_eq_natCast_iff]
    exact Nat.ModEq.of_dvd hrn (modPow_modEq a E n)
  have hm_eq : ((modPow a E n : ℕ) : ZMod r) = (1 : ZMod r) := by
    rw [hz]
    simpa [Nat.cast_pow] using hpow
  have hm_ge : 1 ≤ modPow a E n := by
    by_contra hlt
    have hm0 : modPow a E n = 0 := by omega
    have hdiv1 : r ∣ 1 := by
      have h10 : ((1:ℕ) : ZMod r) = 0 := by simpa [hm0] using hm_eq.symm
      exact (ZMod.natCast_eq_zero_iff 1 r).mp h10
    exact hr.not_dvd_one hdiv1
  have hmod : modPow a E n ≡ 1 [MOD r] := by
    exact (ZMod.natCast_eq_natCast_iff (modPow a E n) 1 r).mp (by simpa using hm_eq)
  have hdiv_sub : r ∣ modPow a E n - 1 := (Nat.modEq_iff_dvd' hm_ge).mp hmod.symm
  have hdiv_gcd : r ∣ Nat.gcd (modPow a E n - 1) n := Nat.dvd_gcd hdiv_sub hrn
  rw [hg] at hdiv_gcd
  exact hr.not_dvd_one hdiv_gcd


lemma dvd_div_prime_of_factorization_lt {d N q : ℕ} (hq : q.Prime) (hdN : d ∣ N)
    (hd0 : d ≠ 0) (hN0 : N ≠ 0) (hlt : d.factorization q < N.factorization q) :
    d ∣ N / q := by
  have hqN : q ∣ N := by
    rw [hq.dvd_iff_one_le_factorization hN0]
    omega
  have hqleN : q ≤ N := Nat.le_of_dvd (Nat.pos_of_ne_zero hN0) hqN
  have hdiv0 : N / q ≠ 0 := (Nat.div_pos hqleN hq.pos).ne'
  rw [← Nat.factorization_le_iff_dvd hd0 hdiv0]
  intro p
  rw [Nat.factorization_div hqN]
  by_cases hpq : p = q
  · subst hpq
    simpa [hq.factorization_self] using Nat.le_pred_of_lt hlt
  · have hqfac0 : q.factorization p = 0 := by
      by_cases hpprime : Nat.Prime p
      · exact Nat.factorization_eq_zero_of_not_dvd (by
          intro hdiv
          have heq : p = q := (Nat.prime_dvd_prime_iff_eq hpprime hq).mp hdiv
          exact hpq heq)
      · exact Nat.factorization_eq_zero_of_not_prime q hpprime
    simp [hqfac0]
    exact (Nat.factorization_le_iff_dvd hd0 hN0).mpr hdN p

lemma primepow_dvd_orderOf_of_pock {n a F q e r : ℕ} (hn2 : 2 < n) (hr : r.Prime) (hrn : r ∣ n)
    (hFN : F ∣ n - 1) (hq : q.Prime) (hqeF : q^e ∣ F) (hepos : 0 < e)
    (hpow : modPow a (n-1) n % n = 1 % n)
    (hg : Nat.gcd (modPow a ((n-1)/q) n - 1) n = 1) : q^e ∣ orderOf (a : ZMod r) := by
  have hN0 : n - 1 ≠ 0 := by omega
  have hpowr : ((a : ZMod r)^(n-1) = 1) := by
    have hzN : ((a : ZMod n)^(n-1) = 1) := zmod_pow_eq_one_of_modPow hpow
    have h2 := congrArg (ZMod.castHom hrn (ZMod r)) hzN
    simp only [ZMod.castHom_apply, map_one] at h2
    rw [ZMod.cast_pow (R := ZMod r) hrn, ZMod.cast_natCast hrn a] at h2
    exact h2
  have hordN : orderOf (a : ZMod r) ∣ n - 1 := by
    rw [orderOf_dvd_iff_pow_eq_one]
    exact hpowr
  by_contra hnot
  have horder0 : orderOf (a : ZMod r) ≠ 0 := by
    exact (Nat.pos_of_dvd_of_pos hordN (by omega)).ne'
  have hqeN : q^e ∣ n - 1 := hqeF.trans hFN
  have hNfac_ge : e ≤ (n-1).factorization q := by
    simpa using (hq.pow_dvd_iff_le_factorization hN0).mp hqeN
  have hnotle : ¬ e ≤ (orderOf (a : ZMod r)).factorization q := by
    intro hle
    apply hnot
    simpa using (hq.pow_dvd_iff_le_factorization horder0).mpr hle
  have hfaclt : (orderOf (a : ZMod r)).factorization q < (n-1).factorization q := by omega
  have hd : orderOf (a : ZMod r) ∣ (n-1)/q := dvd_div_prime_of_factorization_lt hq hordN horder0 hN0 hfaclt
  have hpoweq : ((a : ZMod r)^((n-1)/q) = 1) := by
    rwa [← orderOf_dvd_iff_pow_eq_one]
  exact zmod_pow_ne_one_of_gcd hr hrn hg hpoweq

def ppProd (l : List (ℕ × ℕ)) : ℕ := (l.map (fun qe => qe.1 ^ qe.2)).prod

def pairwiseCoprimePowers (l : List (ℕ × ℕ)) : Prop :=
  (l.map (fun qe => qe.1 ^ qe.2)).Pairwise Nat.Coprime


lemma coprime_list_prod_right {x : ℕ} : ∀ {l : List ℕ}, (∀ y ∈ l, Nat.Coprime x y) → Nat.Coprime x l.prod
  | [], h => by simp
  | y :: ys, h => by
      rw [List.prod_cons]
      exact (Nat.coprime_mul_iff_right).mpr ⟨h y (by simp), coprime_list_prod_right (by intro z hz; exact h z (by simp [hz]))⟩

lemma prod_dvd_of_pairwise_coprime {l : List ℕ} {m : ℕ}
    (hpw : l.Pairwise Nat.Coprime) (hd : ∀ x ∈ l, x ∣ m) : l.prod ∣ m := by
  induction l with
  | nil => simp
  | cons x xs ih =>
      simp only [List.prod_cons]
      cases hpw with
      | cons hhead htail =>
      have hx : x ∣ m := hd x (by simp)
      have hxs : xs.prod ∣ m := ih htail (by intro y hy; exact hd y (by simp [hy]))
      have hcopx : Nat.Coprime x xs.prod := coprime_list_prod_right (by intro y hy; exact hhead y hy)
      exact hcopx.mul_dvd_of_dvd_of_dvd hx hxs

lemma pocklington_abs {n a : ℕ} {l : List (ℕ × ℕ)} (hn2 : 2 < n)
    (hFgt : n < (ppProd l)^2) (hFN : ppProd l ∣ n - 1)
    (hpw : pairwiseCoprimePowers l)
    (hprime : ∀ qe ∈ l, Nat.Prime qe.1 ∧ 0 < qe.2)
    (hpow : modPow a (n-1) n % n = 1 % n)
    (hg : ∀ qe ∈ l, Nat.gcd (modPow a ((n-1)/qe.1) n - 1) n = 1) : Nat.Prime n := by
  let r := Nat.minFac n
  have hn1 : n ≠ 1 := by omega
  have hr : Nat.Prime r := Nat.minFac_prime hn1
  have hrn : r ∣ n := Nat.minFac_dvd n
  have hF_order : ppProd l ∣ orderOf (a : ZMod r) := by
    unfold ppProd
    apply prod_dvd_of_pairwise_coprime (by simpa [pairwiseCoprimePowers] using hpw)
    intro x hx
    simp only [List.mem_map] at hx
    rcases hx with ⟨qe, hqemem, rfl⟩
    rcases qe with ⟨q,e⟩
    have hpqe := hprime (q,e) hqemem
    apply primepow_dvd_orderOf_of_pock (n:=n) (a:=a) (F:=ppProd l) (q:=q) (e:=e) (r:=r) hn2 hr hrn hFN hpqe.1
    · unfold ppProd
      exact List.dvd_prod (l := l.map (fun qe : ℕ × ℕ => qe.1 ^ qe.2)) (by exact List.mem_map_of_mem (f := fun qe : ℕ × ℕ => qe.1 ^ qe.2) hqemem)
    · exact hpqe.2
    · exact hpow
    · exact hg (q,e) hqemem
  have hpowr : ((a : ZMod r)^(n-1) = 1) := by
    have hzN : ((a : ZMod n)^(n-1) = 1) := zmod_pow_eq_one_of_modPow hpow
    have h2 := congrArg (ZMod.castHom hrn (ZMod r)) hzN
    simp only [ZMod.castHom_apply, map_one] at h2
    rw [ZMod.cast_pow (R := ZMod r) hrn, ZMod.cast_natCast hrn a] at h2
    exact h2
  haveI : NeZero r := ⟨hr.ne_zero⟩
  have ha_ne : (a : ZMod r) ≠ 0 := by
    intro hz
    have hzpow : ((a : ZMod r)^(n-1) = 0) := by
      rw [hz]
      exact zero_pow (by omega)
    rw [hpowr] at hzpow
    have h10 : ((1:ℕ) : ZMod r) = 0 := by simpa using hzpow
    have hdiv1 : r ∣ 1 := (ZMod.natCast_eq_zero_iff 1 r).mp h10
    exact hr.not_dvd_one hdiv1
  haveI : Fact r.Prime := ⟨hr⟩
  have horder_r : orderOf (a : ZMod r) ∣ r - 1 := ZMod.orderOf_dvd_card_sub_one ha_ne
  have hF_rminus : ppProd l ∣ r - 1 := hF_order.trans horder_r
  have hFle : ppProd l ≤ r - 1 := Nat.le_of_dvd (Nat.sub_pos_of_lt hr.one_lt) hF_rminus
  have hFlt_r : ppProd l < r := Nat.lt_of_le_pred hr.pos (by simpa [Nat.pred_eq_sub_one] using hFle)
  by_cases hprime_n : Nat.Prime n
  · exact hprime_n
  · have hr_le_div : r ≤ n / r := Nat.minFac_le_div (by omega) hprime_n
    have hmul : r * r ≤ n := by
      calc
        r * r ≤ r * (n / r) := Nat.mul_le_mul_left r hr_le_div
        _ ≤ n := Nat.mul_div_le n r
    have hsq_lt : (ppProd l)^2 < r^2 := by
      nlinarith
    nlinarith

def factorPairs (prev : List ℕ) (e : PEntry) : List (ℕ × ℕ) :=
  e.factors.map (fun ie => (prev.getD ie.1 0, ie.2))

def ValidPockEntry (prev : List ℕ) (e : PEntry) : Prop :=
  e.n = 2 ∨
  (2 < e.n ∧
    (∀ ie ∈ e.factors, ie.1 < prev.length ∧ 0 < ie.2) ∧
    pairwiseCoprimePowers (factorPairs prev e) ∧
    0 < ppProd (factorPairs prev e) ∧
    e.n < (ppProd (factorPairs prev e))^2 ∧
    (e.n - 1) % (ppProd (factorPairs prev e)) = 0 ∧
    (modPow e.a (e.n - 1) e.n % e.n = 1 % e.n) ∧
    (∀ ie ∈ e.factors, Nat.gcd (modPow e.a ((e.n - 1) / (prev.getD ie.1 0)) e.n - 1) e.n = 1))

def ValidPockDB : List ℕ → List PEntry → Prop
  | _, [] => True
  | prev, e :: es => ValidPockEntry prev e ∧ ValidPockDB (e.n :: prev) es

def processPockDB : List ℕ → List PEntry → List ℕ
  | prev, [] => prev
  | prev, e :: es => processPockDB (e.n :: prev) es

def AllPrime (l : List ℕ) : Prop := ∀ p, p ∈ l → Nat.Prime p
lemma getD_mem_of_lt {l : List ℕ} {i : ℕ} (hi : i < l.length) : l.getD i 0 ∈ l := by
  rw [List.getD_eq_getElem l 0 hi]
  exact List.getElem_mem (l := l) (n := i) (h := hi)
lemma validPockEntry_prime {prev : List ℕ} {e : PEntry} (hp : AllPrime prev)
    (hv : ValidPockEntry prev e) : Nat.Prime e.n := by
  rcases hv with hn | hv
  · exact hn.symm ▸ Nat.prime_two
  rcases hv with ⟨hn2, hidx, hpw, hFpos, hFgt, hFmod, hpow, hg⟩
  apply pocklington_abs (n:=e.n) (a:=e.a) (l:=factorPairs prev e) hn2 hFgt (Nat.dvd_of_mod_eq_zero hFmod) hpw
  · intro qe hqe
    simp only [factorPairs, List.mem_map] at hqe
    rcases hqe with ⟨ie, hiemem, hqeeq⟩
    rcases ie with ⟨i,ex⟩
    simp at hqeeq
    cases hqeeq
    exact ⟨hp _ (getD_mem_of_lt (hidx (i,ex) hiemem).1), (hidx (i,ex) hiemem).2⟩
  · exact hpow
  · intro qe hqe
    simp only [factorPairs, List.mem_map] at hqe
    rcases hqe with ⟨ie, hiemem, hqeeq⟩
    rcases ie with ⟨i,ex⟩
    simp at hqeeq
    cases hqeeq
    exact hg (i,ex) hiemem
lemma validPockDB_allPrime : ∀ {prev es}, ValidPockDB prev es → AllPrime prev → AllPrime (processPockDB prev es)
  | prev, [], hv, hp => hp
  | prev, e :: es, hv, hp => by
      rcases hv with ⟨hve, hves⟩
      apply validPockDB_allPrime hves
      intro p hp_mem
      simp [processPockDB] at hp_mem
      rcases hp_mem with rfl | hprev
      · exact validPockEntry_prime hp hve
      · exact hp p hprev
def ValidTargets (vals : List ℕ) (n : ℕ) (ts : List Target) : Prop :=
  (ts.map Target.s).Nodup ∧
  ∀ t ∈ ts, t.idx < vals.length ∧ vals.getD t.idx 0 = n^2 + t.s^2 ∧ 1 ≤ t.s ∧ t.s < n
lemma target_lower {n : ℕ} {ts : List Target} {vals : List ℕ}
    (hpvals : AllPrime vals) (ht : ValidTargets vals n ts) : (ts.map Target.s).length ≤ a n := by
  rcases ht with ⟨hnodup, htprop⟩
  let ss := ts.map Target.s; let T : Finset ℕ := ss.toFinset
  have hcard : T.card = ss.length := by simpa [T, ss] using List.toFinset_card_of_nodup (l := ss) hnodup
  have hsub : T ⊆ Ico 1 n := by
    intro s hs; have hslist : s ∈ ss := by simpa [T] using hs
    simp only [ss, List.mem_map] at hslist; obtain ⟨t, htmem, rfl⟩ := hslist
    exact (mem_Ico).2 ⟨(htprop t htmem).2.2.1, (htprop t htmem).2.2.2⟩
  have hones : ∀ s ∈ T, (if Nat.Prime (n ^ 2 + s ^ 2) then 1 else 0) = (1 : ℕ) := by
    intro s hs; have hslist : s ∈ ss := by simpa [T] using hs
    simp only [ss, List.mem_map] at hslist; obtain ⟨t, htmem, rfl⟩ := hslist
    have htv := htprop t htmem
    have hp : Nat.Prime (n^2 + t.s^2) := by rw [← htv.2.1]; exact hpvals _ (getD_mem_of_lt htv.1)
    simp [hp]
  calc
    ss.length = T.card := hcard.symm
    _ = T.sum (fun s => (1 : ℕ)) := by simp
    _ = T.sum (fun s => (if Nat.Prime (n ^ 2 + s ^ 2) then 1 else 0)) := by
      apply Finset.sum_congr rfl; intro s hs; rw [hones s hs]
    _ ≤ (Ico 1 n).sum (fun s => (if Nat.Prime (n ^ 2 + s ^ 2) then 1 else 0)) := by
      exact sum_le_sum_of_subset_of_nonneg hsub (by intro x hxT hxI; by_cases h : Nat.Prime (n ^ 2 + x ^ 2) <;> simp [h])
    _ = a n := rfl


