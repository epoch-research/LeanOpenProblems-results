def validTargetB (vals : List ℕ) (n : ℕ) (t : Target) : Bool :=
  Nat.blt t.idx vals.length && ((vals.getD t.idx 0) == n^2 + t.s^2) && Nat.ble 1 t.s && Nat.blt t.s n

def validTargetsB (vals : List ℕ) (n : ℕ) (ts : List Target) : Bool :=
  (ts.map Target.s).Nodup && ts.all (validTargetB vals n)

lemma validTargetB_sound {vals : List ℕ} {n : ℕ} {t : Target} (h : validTargetB vals n t = true) :
    t.idx < vals.length ∧ vals.getD t.idx 0 = n^2 + t.s^2 ∧ 1 ≤ t.s ∧ t.s < n := by
  unfold validTargetB at h
  simp only [Bool.and_eq_true] at h
  rcases h with ⟨⟨⟨hidx, heq⟩, hs1⟩, hsn⟩
  rw [beq_iff_eq] at heq
  exact ⟨Nat.blt_eq.mp hidx, heq, Nat.ble_eq.mp hs1, Nat.blt_eq.mp hsn⟩

lemma validTargetsB_sound {vals : List ℕ} {n : ℕ} {ts : List Target} (h : validTargetsB vals n ts = true) :
    ValidTargets vals n ts := by
  unfold validTargetsB at h
  simp only [Bool.and_eq_true, List.all_eq_true] at h
  exact ⟨of_decide_eq_true h.1, by intro t ht; exact validTargetB_sound (h.2 t ht)⟩
