private theorem A281977_lastVerified : A281977_check (10 ^ 6) 46746306 = true := by decide +kernel

/-- We have verified the conjecture for all n = 0..10^6. -/
theorem A281977_verified_up_to_1e6 (n : ℕ) (h : n ≤ 10^6) : A281977 n > 0 := by
  by_cases hlast : n = 10 ^ 6
  · subst n
    have hc : A281977_check (10 ^ 6) (A281977_certCode (10 ^ 6)) = true := by
      change A281977_check (10 ^ 6) 46746306 = true
      exact A281977_lastVerified
    exact A281977_pos_of_witness (A281977_witnessProp_of_arith (A281977_arith_of_check hc))
  · have hnlt : n < 10 ^ 6 := by omega
    let j : ℕ := n / A281977_CE
    let i : ℕ := n % A281977_CE
    let B : ℕ := j / 10
    let k : ℕ := j % 10
    have hj : j ≤ 9999 := by dsimp [j, A281977_CE]; omega
    have hB : B ≤ 99 := by dsimp [B]; omega
    have hk_mem : k ∈ List.range 10 := by rw [List.mem_range]; dsimp [k]; exact Nat.mod_lt j (by decide)
    have hj_eq : 10 * B + k = j := by dsimp [B, k]; omega
    have hblock : A281977_block10Bool B = true := A281977_block10Ok B hB
    have hchunk' : A281977_chunkBool (10 * B + k) = true := (List.all_eq_true.mp hblock) k hk_mem
    have hchunk : A281977_chunkBool j = true := by simpa [hj_eq] using hchunk'
    have hi_lt : i < A281977_CE := by dsimp [i, A281977_CE]; exact Nat.mod_lt n (by decide)
    have hc' : A281977_check (A281977_CE * j + i)
        (((A281977_packList (j / 10)).getD (j % 10) 0 / (A281977_base ^ i)) % A281977_base) = true := by
      unfold A281977_chunkBool at hchunk
      simpa [Nat.zero_add] using A281977_chunkAux_get (j := j) (i := 0)
        (packed := (A281977_packList (j / 10)).getD (j % 10) 0)
        (fuel := A281977_CE) (t := i) hchunk hi_lt
    have hn_eq : A281977_CE * j + i = n := by dsimp [j, i, A281977_CE]; omega
    have hc : A281977_check n (A281977_certCode n) = true := by
      rw [← hn_eq]
      have hne : A281977_CE * j + i ≠ 10 ^ 6 := by omega
      simp [A281977_certCode, A281977_codeCompact, hne]
      have hdiv : (A281977_CE * j + i) / A281977_CE = j := by dsimp [A281977_CE] at *; omega
      have hmod : (A281977_CE * j + i) % A281977_CE = i := by dsimp [A281977_CE] at *; omega
      rw [hdiv, hmod]
      exact hc'
    exact A281977_pos_of_witness (A281977_witnessProp_of_arith (A281977_arith_of_check hc))
