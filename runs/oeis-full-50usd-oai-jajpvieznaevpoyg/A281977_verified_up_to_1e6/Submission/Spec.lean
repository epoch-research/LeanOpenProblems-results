private def A281977_codeCompact (n : ℕ) : ℕ :=
  let packed := (A281977_packList ((n / A281977_CE) / 10)).getD ((n / A281977_CE) % 10) 0
  (packed / (A281977_base ^ (n % A281977_CE))) % A281977_base

private def A281977_fields (c : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  if c < A281977_flag then
    (c % 32, (c / 32) % 128, (c / 4096) % 256, (c / 1048576) % 256)
  else
    let d := A281977_exc.getD (c - A281977_flag) 0
    (d % 32, (d / 32) % 256, (d / 8192) % 1024, (d / 8388608) % 1024)

private def A281977_expand (c : ℕ) : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ :=
  let q := A281977_fields c
  let a := q.1
  let b := q.2.1
  let y := q.2.2.1
  let w := q.2.2.2
  let x := a * a
  let C := (b * b + 7 * x) / 8
  let z := y + C - 2 * w
  (a, b, x, y, z, w)

private def A281977_check (n c : ℕ) : Bool :=
  let q := A281977_fields c
  let a := q.1
  let b := q.2.1
  let y := q.2.2.1
  let w := q.2.2.2
  let x := a * a
  let C := (b * b + 7 * x) / 8
  let z := y + C - 2 * w
  ((b * b + 7 * x) % 8 == 0) &&
    (2 * w ≤ y + C) &&
    (x * x + y * y + z * z + w * w == n)

private def A281977_certCode (n : ℕ) : ℕ :=
  if n = 10 ^ 6 then 46746306 else A281977_codeCompact n

private def A281977_certifiedWitness (n : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  let q := A281977_expand (A281977_certCode n)
  (q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2)
private def A281977_witnessProp (n : ℕ) (p : ℕ × ℕ × ℕ × ℕ) : Prop :=
  let x := p.1
  let y := p.2.1
  let z := p.2.2.1
  let w := p.2.2.2
  x ≤ n.sqrt ∧ y ≤ n.sqrt ∧ z ≤ n.sqrt ∧ w ≤ n.sqrt ∧
  x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
  x.sqrt * x.sqrt = x ∧
  (let L : ℤ := -7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ)
   L ≥ 0 ∧ L.sqrt * L.sqrt = L)

private def A281977_arithProp (n : ℕ) (q : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : Prop :=
  let a := q.1
  let b := q.2.1
  let x := q.2.2.1
  let y := q.2.2.2.1
  let z := q.2.2.2.2.1
  let w := q.2.2.2.2.2
  x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
    a * a = x ∧
    (-7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ)) = (b : ℤ) * (b : ℤ)

private theorem A281977_arith_of_check {n c : ℕ}
    (h : A281977_check n c = true) : A281977_arithProp n (A281977_expand c) := by
  unfold A281977_check at h
  rcases hq : A281977_fields c with ⟨a, b, y, w⟩
  rw [hq] at h
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  rcases h with ⟨⟨hmod, hle⟩, hsum⟩
  unfold A281977_expand A281977_arithProp
  rw [hq]
  dsimp
  constructor
  · simpa [pow_two] using hsum
  constructor
  · rfl
  · let x := a * a
    let S := b * b + 7 * x
    let C := S / 8
    let z := y + C - 2 * w
    have hC : 8 * C = S := by
      dsimp [C, S, x]
      simpa [hmod] using (Nat.div_add_mod (b * b + 7 * (a * a)) 8)
    have hz : y + C = z + 2 * w := by
      dsimp [z]
      omega
    have hlin_nat : 7 * x + 8 * y + b * b = 8 * z + 16 * w := by
      dsimp [S] at hC
      nlinarith
    have hlin_int : (7 : ℤ) * (x : ℕ) + 8 * (y : ℕ) + (b * b : ℕ) =
        8 * (z : ℕ) + 16 * (w : ℕ) := by
      exact_mod_cast hlin_nat
    omega

private theorem A281977_witnessProp_of_arith {n : ℕ} {q : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ}
    (h : A281977_arithProp n q) :
    A281977_witnessProp n (q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) := by
  rcases q with ⟨a, b, x, y, z, w⟩
  simp only [A281977_arithProp] at h
  rcases h with ⟨hsum, hxsq, hL⟩
  have hx2 : x * x ≤ n := by nlinarith [hsum]
  have hy2 : y * y ≤ n := by nlinarith [hsum]
  have hz2 : z * z ≤ n := by nlinarith [hsum]
  have hw2 : w * w ≤ n := by nlinarith [hsum]
  have hxB : x ≤ n.sqrt := (Nat.le_sqrt).2 hx2
  have hyB : y ≤ n.sqrt := (Nat.le_sqrt).2 hy2
  have hzB : z ≤ n.sqrt := (Nat.le_sqrt).2 hz2
  have hwB : w ≤ n.sqrt := (Nat.le_sqrt).2 hw2
  have hxSq : x.sqrt * x.sqrt = x := by rw [← hxsq, Nat.sqrt_eq]
  have hLnonneg : 0 ≤ -7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ) := by
    rw [hL]
    positivity
  have hLsq : Int.sqrt (-7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ)) *
      Int.sqrt (-7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ)) =
      -7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ) := by
    rw [hL, Int.sqrt_eq]
    simp
  simp only [A281977_witnessProp]
  exact ⟨hxB, hyB, hzB, hwB, hsum, hxSq, hLnonneg, hLsq⟩

private theorem A281977_pos_of_witness {n : ℕ} {p : ℕ × ℕ × ℕ × ℕ}
    (hp : A281977_witnessProp n p) : A281977 n > 0 := by
  rcases p with ⟨x, y, z, w⟩
  simp only [A281977_witnessProp] at hp
  rcases hp with ⟨hxB, hyB, hzB, hwB, hsum, hxSq, hL⟩
  let B : ℕ := n.sqrt
  let R : Finset ℕ := Finset.range (B + 1)
  let F : ℕ → ℕ → ℕ → ℕ → ℕ := fun x y z w =>
    let sum_sq_eq := x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n
    let x_is_sq := x.sqrt * x.sqrt = x
    let L : ℤ := -7 * (x : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ)
    let L_is_sq := L ≥ 0 ∧ L.sqrt * L.sqrt = L
    if sum_sq_eq ∧ x_is_sq ∧ L_is_sq then 1 else 0
  have hxmem : x ∈ R := by simp [R, B, hxB]
  have hymem : y ∈ R := by simp [R, B, hyB]
  have hzmem : z ∈ R := by simp [R, B, hzB]
  have hwmem : w ∈ R := by simp [R, B, hwB]
  rcases hL with ⟨hLnonneg, hLsq⟩
  have hF : F x y z w = 1 := by
    simp [F, hsum, hxSq]
    constructor
    · ring_nf at hLnonneg ⊢; exact hLnonneg
    · ring_nf at hLsq ⊢; exact hLsq
  have hw_le : 1 ≤ R.sum (fun w' => F x y z w') := by
    calc
      1 = F x y z w := by rw [hF]
      _ ≤ R.sum (fun w' => F x y z w') := by
        simpa using (Finset.single_le_sum (s := R) (f := fun w' => F x y z w') (by intro a ha; exact Nat.zero_le _) hwmem)
  have hz_single : R.sum (fun w' => F x y z w') ≤ R.sum (fun z' => R.sum (fun w' => F x y z' w')) := by
    simpa using (Finset.single_le_sum (s := R) (f := fun z' => R.sum (fun w' => F x y z' w')) (by intro a ha; exact Nat.zero_le _) hzmem)
  have hz_le : 1 ≤ R.sum (fun z' => R.sum (fun w' => F x y z' w')) := le_trans hw_le hz_single
  have hy_single : R.sum (fun z' => R.sum (fun w' => F x y z' w')) ≤ R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x y' z' w'))) := by
    simpa using (Finset.single_le_sum (s := R) (f := fun y' => R.sum (fun z' => R.sum (fun w' => F x y' z' w'))) (by intro a ha; exact Nat.zero_le _) hymem)
  have hy_le : 1 ≤ R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x y' z' w'))) := le_trans hz_le hy_single
  have hx_single : R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x y' z' w'))) ≤ R.sum (fun x' => R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x' y' z' w')))) := by
    simpa using (Finset.single_le_sum (s := R) (f := fun x' => R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x' y' z' w')))) (by intro a ha; exact Nat.zero_le _) hxmem)
  have hx_le : 1 ≤ R.sum (fun x' => R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x' y' z' w')))) := le_trans hy_le hx_single
  have hA : A281977 n = R.sum (fun x' => R.sum (fun y' => R.sum (fun z' => R.sum (fun w' => F x' y' z' w')))) := by rfl
  rw [hA]
  exact lt_of_lt_of_le Nat.zero_lt_one hx_le



private def A281977_chunkAux (j i packed fuel : ℕ) : Bool :=
  match fuel with
  | 0 => true
  | fuel + 1 => A281977_check (A281977_CE * j + i) (packed % A281977_base) &&
      A281977_chunkAux j (i + 1) (packed / A281977_base) fuel

private def A281977_chunkBool (j : ℕ) : Bool :=
  let packed := (A281977_packList (j / 10)).getD (j % 10) 0
  A281977_chunkAux j 0 packed A281977_CE

private def A281977_block100Bool (B : ℕ) : Bool :=
  (List.range 100).all (fun k => A281977_chunkBool (100 * B + k))


private theorem A281977_chunkAux_get {j i packed fuel t : ℕ}
    (h : A281977_chunkAux j i packed fuel = true) (ht : t < fuel) :
    A281977_check (A281977_CE * j + (i + t))
      ((packed / (A281977_base ^ t)) % A281977_base) = true := by
  induction fuel generalizing i packed t with
  | zero => omega
  | succ fuel ih =>
      cases t with
      | zero =>
          simp [A281977_chunkAux] at h ⊢
          exact h.1
      | succ t =>
          simp [A281977_chunkAux] at h
          have ht' : t < fuel := by omega
          have hh := ih (i := i + 1) (packed := packed / A281977_base) (t := t) h.2 ht'
          convert hh using 2
          · omega
          · rw [Nat.div_div_eq_div_mul]
            congr 1
            rw [pow_succ]
            simp [A281977_base]
            ring

private def A281977_block10Bool (B : ℕ) : Bool :=
  (List.range 10).all (fun k => A281977_chunkBool (10 * B + k))

