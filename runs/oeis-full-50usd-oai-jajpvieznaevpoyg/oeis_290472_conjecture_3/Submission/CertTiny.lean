import FormalConjectures.Util.ProblemImports
open Nat
abbrev Triple := ℕ × ℕ × ℕ

def cert : String := ""

def b64 (c : Char) : Nat :=
  let n := c.toNat
  if 65 ≤ n ∧ n ≤ 90 then n - 65 else
  if 97 ≤ n ∧ n ≤ 122 then n - 97 + 26 else
  if 48 ≤ n ∧ n ≤ 57 then n - 48 + 52 else
  if n = 43 then 62 else 63

def getC (i : Nat) : Nat := b64 (String.get! cert ⟨i⟩)

def decPair (pos : Nat) : Nat × Nat :=
  let v := getC pos * 4096 + getC (pos+1) * 64 + getC (pos+2)
  (v / 651, v % 651)

def repB (N : ℕ) (t : Triple) : Bool :=
  let x := t.1; let y := t.2.1; let z := t.2.2
  decide (0 < x) && decide (x*x + 3*y*y + 7*z*z = N)

def checkOne (n k pos : Nat) : Bool :=
  let N := 6*n+1
  let p1 := decPair pos; let p2 := decPair (pos+3)
  let d1 := p1.1; let z1 := p1.2; let x1 := k-d1
  let rem1 := (N - x1*x1 - 7*z1*z1)/3; let y1 := Nat.sqrt rem1
  let d2 := p2.1; let z2 := p2.2; let x2 := k-d2
  let rem2 := (N - x2*x2 - 7*z2*z2)/3; let y2 := Nat.sqrt rem2
  repB N (x1,y1,z1) && repB N (x2,y2,z2) && decide ((x1,(y1,z1)) ≠ (x2,(y2,z2)))

def baseN : Nat := 287

def posOf (n : Nat) : Nat := 6 * (n - baseN)

def checkAt (n : Nat) : Bool := checkOne n (Nat.sqrt (6*n+1)) (posOf n)

def checkRangeFuel (fuel lo len : Nat) : Bool :=
  match fuel with
  | 0 => decide (len = 0)
  | fuel'+1 =>
    if len = 0 then true else
    if len = 1 then checkAt lo else
    let half := len / 2
    checkRangeFuel fuel' lo half && checkRangeFuel fuel' (lo + half) (len - half)

set_option maxRecDepth 200000
set_option maxHeartbeats 0

theorem bench : String.length cert = 60000 := by decide
