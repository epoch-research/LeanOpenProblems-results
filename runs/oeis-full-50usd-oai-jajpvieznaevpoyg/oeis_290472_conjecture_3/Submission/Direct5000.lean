def repB (N : ℕ) (t : Triple) : Bool :=
  let x:=t.1; let y:=t.2.1; let z:=t.2.2
  decide (0<x) && decide (x*x+3*y*y+7*z*z=N)

def checkIdx (i : Nat) : Bool :=
  let n:=287+i; let N:=6*n+1; let p:=cert i
  repB N p.1 && repB N p.2 && decide (p.1≠p.2)

def checkRangeFuel (fuel lo len : Nat) : Bool :=
  match fuel with
  | 0 => decide (len=0)
  | f+1 => if len=0 then true else if len=1 then checkIdx lo else let h:=len/2; checkRangeFuel f lo h && checkRangeFuel f (lo+h) (len-h)

theorem bench : checkRangeFuel 20 0 5000 = true := by decide +kernel
#print axioms bench
