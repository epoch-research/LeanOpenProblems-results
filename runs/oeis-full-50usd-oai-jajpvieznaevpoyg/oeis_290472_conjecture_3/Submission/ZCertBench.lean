def sqMod64 (r : Nat) : Bool :=
  r = 0 || r = 1 || r = 4 || r = 9 || r = 16 || r = 17 || r = 25 || r = 33 || r = 36 || r = 41 || r = 49 || r = 57
def sqMod9 (r : Nat) : Bool := r = 0 || r = 1 || r = 4 || r = 7
def sqMod5 (r : Nat) : Bool := r = 0 || r = 1 || r = 4
def sqMod7 (r : Nat) : Bool := r = 0 || r = 1 || r = 2 || r = 4
def sqMod11 (r : Nat) : Bool := r = 0 || r = 1 || r = 3 || r = 4 || r = 5 || r = 9
def sqMod13 (r : Nat) : Bool := r = 0 || r = 1 || r = 3 || r = 4 || r = 9 || r = 10 || r = 12
def preSq (q : Nat) : Bool := sqMod64 (q%64) && sqMod9 (q%9) && sqMod5 (q%5) && sqMod7 (q%7) && sqMod11 (q%11) && sqMod13 (q%13)

def sqrtOptAux (fuel lo hi q : Nat) : Option Nat :=
  match fuel with
  | 0 => none
  | fuel'+1 =>
    let mid := (lo+hi)/2; let m2 := mid*mid
    if m2 = q then some mid else if m2 < q then sqrtOptAux fuel' (mid+1) hi q else sqrtOptAux fuel' lo mid q

def sqrtOpt (q : Nat) : Option Nat := sqrtOptAux 14 0 8000 q

def repB (N : ℕ) (t : Triple) : Bool :=
  let x:=t.1; let y:=t.2.1; let z:=t.2.2
  decide (0<x) && decide (x*x+3*y*y+7*z*z=N)

def searchYforZ (fuel N z y : Nat) : Option Triple :=
  match fuel with
  | 0 => none
  | fuel'+1 =>
    let rem := N - 7*z*z
    let yy := 3*y*y
    if yy > rem then none else
    let q := rem - yy
    if preSq q then
      match sqrtOpt q with
      | some x => if repB N (x,y,z) then some (x,y,z) else searchYforZ fuel' N z (y+1)
      | none => searchYforZ fuel' N z (y+1)
    else searchYforZ fuel' N z (y+1)

def findForZ (N z : Nat) : Option Triple := searchYforZ 4474 N z 0

def checkIdx (i : Nat) : Bool :=
  let n:=287+i; let N:=6*n+1; let zs:=zcert i
  match findForZ N zs.1, findForZ N zs.2 with
  | some u, some v => repB N u && repB N v && decide (u≠v)
  | _, _ => false

def checkFuel (fuel i : Nat) : Bool := match fuel with | 0 => true | f+1 => checkIdx i && checkFuel f (i+1)

theorem bench : checkFuel 1000 0 = true := by decide +kernel
#print axioms bench
