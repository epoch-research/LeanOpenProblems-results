def repB (N : ℕ) (t : Triple) : Bool :=
  let x := t.1; let y := t.2.1; let z := t.2.2
  decide (0 < x) && decide (x*x + 3*y*y + 7*z*z = N)

def checkIdx (i : Nat) : Bool :=
  let n := 287+i; let N := 6*n+1; let p := cert i
  repB N p.1 && repB N p.2 && decide (p.1 ≠ p.2)

def checkFuel (fuel i : Nat) : Bool :=
  match fuel with
  | 0 => true
  | f+1 => checkIdx i && checkFuel f (i+1)

set_option maxRecDepth 200000
set_option maxHeartbeats 0

theorem bench : checkFuel 1000 0 = true := by decide
#print axioms bench
