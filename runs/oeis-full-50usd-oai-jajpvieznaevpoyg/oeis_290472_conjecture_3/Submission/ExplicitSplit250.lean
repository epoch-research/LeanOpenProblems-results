def goodRow (n : Nat) (r : Row) : Bool :=
  let (x1,y1,z1,x2,y2,z2) := r
  decide (0 < x1 ∧ x1*x1+3*y1*y1+7*z1*z1 = 6*n+1 ∧ 0<x2 ∧ x2*x2+3*y2*y2+7*z2*z2=6*n+1 ∧ (x1,y1,z1) ≠ (x2,y2,z2))

