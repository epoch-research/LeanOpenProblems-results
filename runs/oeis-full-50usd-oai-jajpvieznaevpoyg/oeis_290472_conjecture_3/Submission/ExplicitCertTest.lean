def goodRow (n : Nat) (r : Row) : Bool :=
  let (x1,y1,z1,x2,y2,z2) := r
  decide (0 < x1 ∧ x1*x1+3*y1*y1+7*z1*z1 = 6*n+1 ∧ 0<x2 ∧ x2*x2+3*y2*y2+7*z2*z2=6*n+1 ∧ (x1,y1,z1) ≠ (x2,y2,z2))

def checkRowsAux (i fuel : Nat) : Bool :=
  match fuel with
  | 0 => true
  | fuel'+1 => goodRow (287+i) (rows.getD i (0,0,0,0,0,0)) && checkRowsAux (i+1) fuel'

theorem test : checkRowsAux 0 100 = true := by decide +kernel
#print axioms test
