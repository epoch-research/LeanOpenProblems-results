def sqrtOptAux (fuel lo hi q : Nat) : Option Nat :=
  match fuel with
  | 0 => none
  | fuel'+1 =>
    let mid := (lo+hi)/2; let m2 := mid*mid
    if m2 = q then some mid else if m2 < q then sqrtOptAux fuel' (mid+1) hi q else sqrtOptAux fuel' lo mid q

def sqrtOpt (q : Nat) : Option Nat := sqrtOptAux 13 0 5000 q

def repB (N : ℕ) (t : Triple) : Bool :=
  let x:=t.1; let y:=t.2.1; let z:=t.2.2
  decide (0<x) && decide (x*x+3*y*y+7*z*z=N)

def upd (N : Nat) (x z : Nat) (fst : Option Triple) : Sum (Triple × Triple) (Option Triple) :=
  let rem := (N - x*x - 7*z*z)/3
  match sqrtOpt rem with
  | none => Sum.inr fst
  | some y =>
    let t : Triple := (x,y,z)
    if repB N t then match fst with | none => Sum.inr (some t) | some u => if decide (u=t) then Sum.inr fst else Sum.inl (u,t) else Sum.inr fst

def searchZList (zs : List Nat) (Nu ku du : UInt64) (N k d : Nat) (fst : Option Triple) : Sum (Triple × Triple) (Option Triple) :=
  match zs with
  | [] => Sum.inr fst
  | z::zs' =>
    let zu := UInt64.ofNat z; let x := k-d; let xu := ku - du
    let rem0u := Nu - xu*xu; let zzu := 7*zu*zu
    if zzu > rem0u then Sum.inr fst else
    let remu := rem0u - zzu
    if remu % 3 = 0 then
      match upd N x z fst with
      | Sum.inl p => Sum.inl p
      | Sum.inr fst' => searchZList zs' Nu ku du N k d fst'
    else searchZList zs' Nu ku du N k d fst

def searchDFuel (fuel : Nat) (Nu ku du : UInt64) (N k d : Nat) (fst : Option Triple) : Option (Triple × Triple) :=
  match fuel with
  | 0 => none
  | fuel'+1 =>
    let xu := ku-du; let rem0u := Nu - xu*xu
    match searchZList (allowed (rem0u.toNat % 192)) Nu ku du N k d fst with
    | Sum.inl p => some p
    | Sum.inr fst' => searchDFuel fuel' Nu ku (du+1) N k (d+1) fst'

def checkTopCand (N k : Nat) (p : Nat×Nat) (fst : Option Triple) : Sum (Triple×Triple) (Option Triple) :=
  let d:=p.1; let z:=p.2; let x:=k-d
  let rem := N - x*x - 7*z*z
  if rem % 3 = 0 then
    match sqrtOpt (rem/3) with
    | some y =>
      let t : Triple := (x,y,z)
      if repB N t then match fst with | none => Sum.inr (some t) | some u => if decide (u=t) then Sum.inr fst else Sum.inl (u,t) else Sum.inr fst
    | none => Sum.inr fst
  else Sum.inr fst

def searchTop (N k : Nat) (xs : List (Nat×Nat)) (fst : Option Triple) : Sum (Triple×Triple) (Option Triple) :=
  match xs with
  | [] => Sum.inr fst
  | p::ps =>
    match checkTopCand N k p fst with
    | Sum.inl q => Sum.inl q
    | Sum.inr fst' => searchTop N k ps fst'

def findTwoK (n k : Nat) : Option (Triple × Triple) := let N:=6*n+1; match searchTop N k cands none with | Sum.inl p => some p | Sum.inr fst => searchDFuel 233 (UInt64.ofNat N) (UInt64.ofNat k) 0 N k 0 fst

def checkOneK (n k : Nat) : Bool := match findTwoK n k with | some (u,v) => repB (6*n+1) u && repB (6*n+1) v && decide (u≠v) | none => false

def nextK (n k : Nat) : Nat := if (k+1)*(k+1) ≤ 6*(n+1)+1 then k+1 else k

def checkFuelK (fuel n k : Nat) : Bool := match fuel with | 0 => true | fuel'+1 => checkOneK n k && checkFuelK fuel' (n+1) (nextK n k)

theorem bench : checkFuelK 100 287 41 = true := by decide +kernel
#print axioms bench
