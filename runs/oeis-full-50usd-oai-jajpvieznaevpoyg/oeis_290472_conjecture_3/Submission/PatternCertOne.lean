def dec (w : Nat) : (Nat×Nat)×(Nat×Nat) :=
  let v1 := w / 200000; let v2 := w % 200000
  ((v1 / 651, v1 % 651), (v2 / 651, v2 % 651))

def repB (N : ℕ) (t : Triple) : Bool :=
  let x := t.1; let y := t.2.1; let z := t.2.2
  decide (0 < x) && decide (x*x + 3*y*y + 7*z*z = N)

def checkIdx (i : Nat) : Bool :=
  let n := 287+i; let N := 6*n+1; let k := Nat.sqrt N
  let p := dec (cert i)
  let d1 := p.1.1; let z1 := p.1.2; let x1 := k-d1
  let y1 := Nat.sqrt ((N - x1*x1 - 7*z1*z1)/3)
  let d2 := p.2.1; let z2 := p.2.2; let x2 := k-d2
  let y2 := Nat.sqrt ((N - x2*x2 - 7*z2*z2)/3)
  repB N (x1,y1,z1) && repB N (x2,y2,z2) && decide ((x1,(y1,z1)) ≠ (x2,(y2,z2)))

def checkFuel (fuel i : Nat) : Bool :=
  match fuel with
  | 0 => true
  | f+1 => checkIdx i && checkFuel f (i+1)

set_option maxRecDepth 200000
set_option maxHeartbeats 0

theorem bench : checkIdx 0 = true := by decide
#print axioms bench
#eval checkIdx 0
