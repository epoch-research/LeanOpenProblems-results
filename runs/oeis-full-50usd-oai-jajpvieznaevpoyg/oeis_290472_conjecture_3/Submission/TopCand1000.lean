def sqrtOptAux (fuel lo hi q : Nat) : Option Nat :=
  match fuel with
  | 0 => none
  | fuel'+1 =>
    let mid := (lo+hi)/2; let m2 := mid*mid
    if m2 = q then some mid else if m2 < q then sqrtOptAux fuel' (mid+1) hi q else sqrtOptAux fuel' lo mid q

def sqrtOpt (q : Nat) : Option Nat := sqrtOptAux 13 0 5000 q

def repB (N : ℕ) (t : Triple) : Bool :=
  let x:=t.1; let y:=t.2.1; let z:=t.2.2
  decide (0<x) && decide (x*x+3*y*y+7*z*z=N)

def upd (N : ℕ) (t : Triple) (fst : Option Triple) : Sum (Triple × Triple) (Option Triple) :=
  if repB N t then match fst with | none => Sum.inr (some t) | some u => if decide (u=t) then Sum.inr fst else Sum.inl (u,t) else Sum.inr fst

def checkCand (N k : Nat) (p : Nat×Nat) (fst : Option Triple) : Sum (Triple×Triple) (Option Triple) :=
  let d:=p.1; let z:=p.2; let x:=k-d
  let rem := N - x*x - 7*z*z
  if rem % 3 = 0 then
    match sqrtOpt (rem/3) with
    | some y => upd N (x,y,z) fst
    | none => Sum.inr fst
  else Sum.inr fst

def searchList (N k : Nat) (xs : List (Nat×Nat)) (fst : Option Triple) : Option (Triple×Triple) :=
  match xs with
  | [] => none
  | p::ps =>
    match checkCand N k p fst with
    | Sum.inl q => some q
    | Sum.inr fst' => searchList N k ps fst'

def findTwoTop (n k : Nat) : Option (Triple×Triple) := searchList (6*n+1) k cands none

def checkOneK (n k : Nat) : Bool := match findTwoTop n k with | some (u,v) => repB (6*n+1) u && repB (6*n+1) v && decide (u≠v) | none => false

def nextK (n k : Nat) : Nat := if (k+1)*(k+1) ≤ 6*(n+1)+1 then k+1 else k

def checkFuelK (fuel n k : Nat) : Bool := match fuel with | 0 => true | fuel'+1 => checkOneK n k && checkFuelK fuel' (n+1) (nextK n k)

theorem bench : checkFuelK 100 287 41 = true := by decide +kernel
#print axioms bench
