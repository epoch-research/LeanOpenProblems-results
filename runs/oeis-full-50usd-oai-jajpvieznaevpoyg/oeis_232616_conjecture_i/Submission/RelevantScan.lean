def baseValP (a p : Nat) : Nat := ((p + 550172 - a % 550172) % 550172) % 196

def goodRel (a p : Nat) : Bool :=
  if 2 ≤ a ∧ baseValP a p = 49 then a ∈ relList else true

def checkRel : Nat → Nat → Nat → Bool
