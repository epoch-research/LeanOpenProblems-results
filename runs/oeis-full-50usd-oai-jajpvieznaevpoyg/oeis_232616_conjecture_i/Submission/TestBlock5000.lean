lemma L5000_nodup : L5000.Nodup := by decide
lemma L5000_bound : L5000.Forall (fun x => x < 5000) := by
  repeat constructor <;> norm_num
lemma L5000_prime : L5000.Forall (fun x => Nat.Prime (8000000 + x)) := by
  repeat constructor <;> norm_num
lemma blockL5000 : 318 ≤ Nat.count (fun k => Nat.Prime (8000000 + k)) 5000 := by
  rw [Nat.count_eq_card_filter_range]
  have hcard : L5000.toFinset.card = 318 := by
    rw [List.toFinset_card_of_nodup L5000_nodup]
    rfl
  rw [← hcard]
  apply Finset.card_le_card
  intro x hx
  have hxL : x ∈ L5000 := by simpa using (List.mem_toFinset.mp hx)
  simp only [Finset.mem_filter, Finset.mem_range]
  exact ⟨(List.forall_iff_forall_mem.mp L5000_bound) x hxL, (List.forall_iff_forall_mem.mp L5000_prime) x hxL⟩
