  have H1 : 1229 ≤ Nat.count Nat.Prime 10000 := by
    rw [show 10000 = 5000 + 5000 by norm_num, Nat.count_add]
    have hb := block1
    omega
  have H2 : 1754 ≤ Nat.count Nat.Prime 15000 := by
    rw [show 15000 = 10000 + 5000 by norm_num, Nat.count_add]
    have hb := block2
