    (getB i + getB j) % 47 = 10 ∧ (getB i + getB j) % 2209 ≠ 10 := by
  have hc := of_decide_eq_true h
  have hri := res16_correct hi
  have hrj := res16_correct hj
  have hsumM : (getB i + getB j) % 2209 = (res16 i + res16 j) % 2209 := by rw [Nat.add_mod, hri, hrj]
  have hsumP : (getB i + getB j) % 47 = (res16 i + res16 j) % 47 := by
    calc
      (getB i + getB j) % 47 = ((getB i + getB j) % 2209) % 47 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 47 ∣ 2209)).symm
      _ = ((res16 i + res16 j) % 2209) % 47 := by rw [hsumM]
      _ = (res16 i + res16 j) % 47 := Nat.mod_mod_of_dvd (res16 i + res16 j) (by decide : 47 ∣ 2209)
  exact ⟨hsumP.trans hc.1, by intro hh; exact hc.2 (by simpa [hsumM] using hh)⟩
