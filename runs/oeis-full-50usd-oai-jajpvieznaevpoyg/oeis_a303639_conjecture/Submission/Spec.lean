private def Brec : Nat -> Nat
| 0 => 1
| k+1 => (2 * (2*k+3) * Brec k) / (k+2)
private lemma choose_middle_even (k : Nat) : (2*k+2).choose (k+1) = 2 * Bfun k := by
  have hpas := Nat.choose_succ_succ (2*k+1) k
  -- hpas: choose(2k+2,k+1)=choose(2k+1,k)+choose(2k+1,k+1)
  have hsym : (2*k+1).choose (k+1) = Bfun k := by
    dsimp [Bfun]
    rw [Nat.choose_symm_of_eq_add (n:=2*k+1) (a:=k+1) (b:=k)]
    omega
  change (2 * k + 2).choose (k + 1) = 2 * ((2 * k + 1).choose k)
  rw [hpas, hsym]
  dsimp [Bfun]
  omega

private lemma Bfun_rec_mul (k : Nat) : (k+2) * Bfun (k+1) = 2 * (2*k+3) * Bfun k := by
  have hbase := Nat.add_one_mul_choose_eq (2*k+2) (k+1)
  -- (2k+3)*choose(2k+2,k+1)=choose(2k+3,k+2)*(k+2)
  have hsym : (2*k+3).choose (k+2) = Bfun (k+1) := by
    change (2*k+3).choose (k+2) = (2*k+3).choose (k+1)
    exact Nat.choose_symm_of_eq_add (by omega)
  rw [choose_middle_even k, hsym] at hbase
  -- hbase orientation: (2k+3)*(2*B) = Bnext*(k+2)
  nlinarith [hbase]

private lemma Brec_eq_Bfun : ∀ k, Brec k = Bfun k
| 0 => by simp [Brec, Bfun]
| k+1 => by
  rw [Brec, Brec_eq_Bfun k]
  have hmul := Bfun_rec_mul k
  exact Nat.div_eq_of_eq_mul_left (n:=k+2) (m:=2 * (2 * k + 3) * Bfun k) (k:=Bfun (k+1)) (by omega) (by simpa [mul_comm, mul_left_comm, mul_assoc] using hmul.symm)


