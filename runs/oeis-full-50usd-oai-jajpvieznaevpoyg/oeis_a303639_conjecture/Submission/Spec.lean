private def coverF2 (i j : Nat) : Bool := decide (((res2 i + res2 j) % 11 = 0) ∧ ((res2 i + res2 j) % 121 ≠ 22))
private lemma coverF2_sound {i j : Nat} (hi : i ≤ K) (hj : j ≤ K) (h : coverF2 i j = true) :
    (getB i + getB j) % 11 = 0 ∧ (getB i + getB j) % 121 ≠ 22 := by
  have hc := of_decide_eq_true h
  have hri := res2_correct hi
  have hrj := res2_correct hj
  have hsumM : (getB i + getB j) % 121 = (res2 i + res2 j) % 121 := by rw [Nat.add_mod, hri, hrj]
  have hsumP : (getB i + getB j) % 11 = (res2 i + res2 j) % 11 := by
    calc
      (getB i + getB j) % 11 = ((getB i + getB j) % 121) % 11 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 11 ∣ 121)).symm
      _ = ((res2 i + res2 j) % 121) % 11 := by rw [hsumM]
      _ = (res2 i + res2 j) % 11 := Nat.mod_mod_of_dvd (res2 i + res2 j) (by decide : 11 ∣ 121)
  exact ⟨hsumP.trans hc.1, by intro hh; exact hc.2 (by simpa [hsumM] using hh)⟩
