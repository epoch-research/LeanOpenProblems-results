private lemma exists_rep_of_a_pos {n : Nat} (ha : 0 < a n) : ∃ x y c d : Nat, x ≤ n.sqrt ∧ y ≤ n.sqrt ∧ c ≤ n ∧ d ≤ n ∧ x ≤ y ∧ c ≤ d ∧ x^2 + y^2 + (2*c+1).choose c + (2*d+1).choose d = n := by
  dsimp [a] at ha
  let R_sq := Finset.range (n.sqrt+1); let R_binom := Finset.range (n+1)
  have hne0 : (∑ x ∈ R_sq, ∑ y ∈ R_sq, ∑ c ∈ R_binom, ∑ d ∈ R_binom, if x ≤ y ∧ c ≤ d ∧ x^2 + y^2 + (2*c+1).choose c + (2*d+1).choose d = n then 1 else 0) ≠ 0 := Nat.ne_of_gt ha
  obtain ⟨x,hxmem,hxne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne0
  obtain ⟨y,hymem,hyne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hxne
  obtain ⟨c,hcmem,hcne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hyne
  obtain ⟨d,hdmem,hdne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hcne
  have hprop : x ≤ y ∧ c ≤ d ∧ x^2 + y^2 + (2*c+1).choose c + (2*d+1).choose d = n := by by_contra h; simp [h] at hdne
  refine ⟨x,y,c,d,?_,?_,?_,?_,hprop.1,hprop.2.1,hprop.2.2⟩
  · have hxlt : x < n.sqrt + 1 := by simpa [R_sq] using hxmem
    exact Nat.lt_succ_iff.mp hxlt
  · have hylt : y < n.sqrt + 1 := by simpa [R_sq] using hymem
    exact Nat.lt_succ_iff.mp hylt
  · have hclt : c < n + 1 := by simpa [R_binom] using hcmem
    exact Nat.lt_succ_iff.mp hclt
  · have hdlt : d < n + 1 := by simpa [R_binom] using hdmem
    exact Nat.lt_succ_iff.mp hdlt
private lemma prime_three_mod_four_sq_dvd_of_dvd_sq_add_sq {p x y m : Nat} [Fact p.Prime] (hp3 : p % 4 = 3) (hm : m = x^2+y^2) (hdiv : p ∣ m) : p^2 ∣ m := by
  have hz : (x : ZMod p)^2 + (y : ZMod p)^2 = 0 := by
    have hm0 : (m : ZMod p)=0 := by rw [ZMod.natCast_eq_zero_iff]; exact hdiv
    rw [hm] at hm0; simpa using hm0
  have hpxy : p ∣ x ∧ p ∣ y := by
    by_cases hy0 : (y : ZMod p)=0
    · have hpy : p ∣ y := by rw [← ZMod.natCast_eq_zero_iff]; exact hy0
      have hx2 : (x : ZMod p)^2=0 := by simpa [hy0] using hz
      have hx0 : (x : ZMod p)=0 := sq_eq_zero_iff.mp hx2
      have hpx : p ∣ x := by rw [← ZMod.natCast_eq_zero_iff]; exact hx0
      exact ⟨hpx,hpy⟩
    · have hxy : (x : ZMod p)^2 = - (y : ZMod p)^2 := by rw [eq_neg_iff_add_eq_zero]; exact hz
      exact False.elim ((ZMod.mod_four_ne_three_of_sq_eq_neg_sq' hy0 hxy) hp3)
  obtain ⟨u,rfl⟩ := hpxy.1; obtain ⟨v,rfl⟩ := hpxy.2; rw [hm]
  exact dvd_add ⟨u^2, by ring⟩ ⟨v^2, by ring⟩
private lemma core_obstruction {x y S p R : Nat} (hp : p.Prime) (hp3 : p % 4 = 3) (hN : N % (p*p)=R) (hSmod : S%p=R%p) (hSmod2 : S%(p*p)≠R) (heq : x^2+y^2+S=N) : False := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hp2dvd : p ∣ p*p := ⟨p, by rw [mul_comm]⟩
  have hNmod : N % p = R % p := by
    calc
      N % p = (N % (p*p)) % p := (mod_mod_of_dvd N hp2dvd).symm
      _ = R % p := by rw [hN]
  let m := x^2 + y^2
  have hm_cast_p : (m : ZMod p) = 0 := by
    have heqz : ((m + S : Nat) : ZMod p) = (N : ZMod p) := by
      dsimp [m]
      rw [heq]
    have hNS : (N : ZMod p) = (S : ZMod p) := by
      rw [ZMod.natCast_eq_natCast_iff']
      exact hNmod.trans hSmod.symm
    have : (m : ZMod p) + (S : ZMod p) = (S : ZMod p) := by
      simpa [Nat.cast_add] using heqz.trans hNS
    exact add_right_cancel (by simpa only [zero_add] using this : (m : ZMod p) + (S : ZMod p) = 0 + (S : ZMod p))
  have hdiv : p ∣ m := by
    rw [← ZMod.natCast_eq_zero_iff]
    exact hm_cast_p
  have hp2div : p^2 ∣ m := prime_three_mod_four_sq_dvd_of_dvd_sq_add_sq hp3 rfl hdiv
  have hm_cast_p2 : (m : ZMod (p*p)) = 0 := by
    rw [ZMod.natCast_eq_zero_iff]
    simpa [pow_two] using hp2div
  have hNS2 : (N : ZMod (p*p)) = (S : ZMod (p*p)) := by
    have heqz : ((m + S : Nat) : ZMod (p*p)) = (N : ZMod (p*p)) := by
      dsimp [m]
      rw [heq]
    have : (S : ZMod (p*p)) = (N : ZMod (p*p)) := by
      simpa [Nat.cast_add, hm_cast_p2] using heqz
