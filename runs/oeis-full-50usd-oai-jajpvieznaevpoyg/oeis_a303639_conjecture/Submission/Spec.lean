    (getB i + getB j) % 23 = 0 ∧ (getB i + getB j) % 529 ≠ 92 := by
  have hc := of_decide_eq_true h
  have hri := res3_correct hi
  have hrj := res3_correct hj
  have hsumM : (getB i + getB j) % 529 = (res3 i + res3 j) % 529 := by rw [Nat.add_mod, hri, hrj]
  have hsumP : (getB i + getB j) % 23 = (res3 i + res3 j) % 23 := by
    calc
      (getB i + getB j) % 23 = ((getB i + getB j) % 529) % 23 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 23 ∣ 529)).symm
      _ = ((res3 i + res3 j) % 529) % 23 := by rw [hsumM]
      _ = (res3 i + res3 j) % 23 := Nat.mod_mod_of_dvd (res3 i + res3 j) (by decide : 23 ∣ 529)
  exact ⟨hsumP.trans hc.1, by intro hh; exact hc.2 (by simpa [hsumM] using hh)⟩
