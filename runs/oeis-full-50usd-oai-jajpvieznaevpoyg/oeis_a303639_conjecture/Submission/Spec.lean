  have hsumP : (getB i + getB j) % 251 = (res7 i + res7 j) % 251 := by
    calc
      (getB i + getB j) % 251 = ((getB i + getB j) % 63001) % 251 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 251 ∣ 63001)).symm
      _ = ((res7 i + res7 j) % 63001) % 251 := by rw [hsumM]
      _ = (res7 i + res7 j) % 251 := Nat.mod_mod_of_dvd (res7 i + res7 j) (by decide : 251 ∣ 63001)
  exact ⟨hsumP.trans hc.1, by intro hh; exact hc.2 (by simpa [hsumM] using hh)⟩
