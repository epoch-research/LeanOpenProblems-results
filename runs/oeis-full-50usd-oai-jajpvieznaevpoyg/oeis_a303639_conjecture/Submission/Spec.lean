private lemma coverF0_sound {i j : Nat} (hi : i ≤ K) (hj : j ≤ K) (h : coverF0 i j = true) :
    (getB i + getB j) % 3 = 0 ∧ (getB i + getB j) % 9 ≠ 3 := by
  have hc := of_decide_eq_true h
  have hri := res0_correct hi
  have hrj := res0_correct hj
  have hsumM : (getB i + getB j) % 9 = (res0 i + res0 j) % 9 := by rw [Nat.add_mod, hri, hrj]
  have hsumP : (getB i + getB j) % 3 = (res0 i + res0 j) % 3 := by
    calc
      (getB i + getB j) % 3 = ((getB i + getB j) % 9) % 3 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 3 ∣ 9)).symm
      _ = ((res0 i + res0 j) % 9) % 3 := by rw [hsumM]
      _ = (res0 i + res0 j) % 3 := Nat.mod_mod_of_dvd (res0 i + res0 j) (by decide : 3 ∣ 9)
  exact ⟨hsumP.trans hc.1, by intro hh; exact hc.2 (by simpa [hsumM] using hh)⟩
