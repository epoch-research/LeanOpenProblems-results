      _ = ((res8 i + res8 j) % 3481) % 59 := by rw [hsumM]
      _ = (res8 i + res8 j) % 59 := Nat.mod_mod_of_dvd (res8 i + res8 j) (by decide : 59 ∣ 3481)
  exact ⟨hsumP.trans hc.1, by intro hh; exact hc.2 (by simpa [hsumM] using hh)⟩
