private opaque N_lt_B_next : N < Bfun (K+1) := by
  have hN2 : N < 2 ^ 8993 := by decide
  have hK2 : K + 2 < 2 ^ 13 := by norm_num [K]
  have hpow : (K + 2) * N < 4 ^ (K + 1) := by
    have hmul1 : (K + 2) * N < 2 ^ 13 * 2 ^ 8993 := mul_lt_mul'' hK2 hN2 (by positivity) (by positivity)
    have hmul2 : 2 ^ 13 * 2 ^ 8993 = 2 ^ 9006 := by rw [← pow_add]
    have hle : 2 ^ 9006 ≤ 4 ^ (K + 1) := by
      have hpoweq : 4 ^ (K + 1) = 2 ^ (2 * (K + 1)) := by rw [show 4 = 2 ^ 2 by norm_num, pow_mul]
      rw [hpoweq]
      exact pow_le_pow_right₀ (by norm_num : (1:Nat) ≤ 2) (by norm_num [K] : 9006 ≤ 2 * (K + 1))
    exact lt_of_lt_of_le (by simpa [hmul2] using hmul1) hle
  have hsum : (∑ i ∈ Finset.range (K + 2), (2 * (K + 1) + 1).choose i) = 4 ^ (K + 1) := by
    simpa [Nat.add_assoc] using Nat.sum_range_choose_halfway (K+1)
  have hterm : ∀ i ∈ Finset.range (K + 2), (2 * (K + 1) + 1).choose i ≤ Bfun (K+1) := by
    intro i hi; dsimp [Bfun]
    have := Nat.choose_le_middle i (2 * (K+1)+1)
    have hmid : (2 * (K + 1) + 1) / 2 = K + 1 := by norm_num [K]
    simpa [hmid] using this
  have hsumle : 4 ^ (K + 1) ≤ (K + 2) * Bfun (K+1) := by
    rw [← hsum]
    calc
      (∑ i ∈ Finset.range (K + 2), (2 * (K + 1) + 1).choose i) ≤ ∑ i ∈ Finset.range (K + 2), Bfun (K+1) := Finset.sum_le_sum hterm
      _ = (K + 2) * Bfun (K+1) := by rw [Finset.sum_const, Finset.card_range, Nat.nsmul_eq_mul]
  have hmul : (K+2) * N < (K+2) * Bfun (K+1) := lt_of_lt_of_le hpow hsumle
  exact (Nat.mul_lt_mul_left (by norm_num [K] : 0 < K+2)).mp hmul
private lemma B_le_succ (k : Nat) : Bfun k ≤ Bfun (k+1) := by
  dsimp [Bfun]
  have h1 : (2 * k + 1).choose k ≤ (2 * (k+1) + 1).choose k := by
    apply Nat.choose_le_choose; omega
  have hhalf : k < (2 * (k+1) + 1) / 2 := by omega
  have h2 : (2 * (k+1) + 1).choose k ≤ (2 * (k+1) + 1).choose (k+1) := by
    simpa [Nat.succ_eq_add_one] using (Nat.choose_le_succ_of_lt_half_left (r:=k) (n:=2*(k+1)+1) hhalf)
  exact h1.trans h2
private lemma B_mono : Monotone Bfun := by
  intro i j hij; induction hij with | refl => rfl | @step j hij ih => exact ih.trans (B_le_succ j)
