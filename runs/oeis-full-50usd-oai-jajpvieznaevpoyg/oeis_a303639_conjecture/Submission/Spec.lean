  have hsumP : (getB i + getB j) % 103 = (res10 i + res10 j) % 103 := by
    calc
      (getB i + getB j) % 103 = ((getB i + getB j) % 10609) % 103 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 103 ∣ 10609)).symm
      _ = ((res10 i + res10 j) % 10609) % 103 := by rw [hsumM]
      _ = (res10 i + res10 j) % 103 := Nat.mod_mod_of_dvd (res10 i + res10 j) (by decide : 103 ∣ 10609)
