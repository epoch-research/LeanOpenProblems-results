  have hsumP : (getB i + getB j) % 7 = (res1 i + res1 j) % 7 := by
    calc
      (getB i + getB j) % 7 = ((getB i + getB j) % 49) % 7 := (Nat.mod_mod_of_dvd (getB i + getB j) (by decide : 7 ∣ 49)).symm
      _ = ((res1 i + res1 j) % 49) % 7 := by rw [hsumM]
      _ = (res1 i + res1 j) % 7 := Nat.mod_mod_of_dvd (res1 i + res1 j) (by decide : 7 ∣ 49)
