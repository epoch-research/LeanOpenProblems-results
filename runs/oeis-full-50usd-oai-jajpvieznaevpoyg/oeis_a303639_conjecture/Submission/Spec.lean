/-- A303639. -/
def a (n : ℕ) : ℕ :=
  let B (k : ℕ) : ℕ := (2 * k + 1).choose k
  let R_sq := Finset.range (n.sqrt + 1)
  let R_binom := Finset.range (n + 1)
  R_sq.sum fun a =>
    R_sq.sum fun b =>
      R_binom.sum fun c =>
        R_binom.sum fun d =>
          if a ≤ b ∧ c ≤ d ∧ a ^ 2 + b ^ 2 + B c + B d = n then 1 else 0

private def Bfun (k : Nat) : Nat := (2*k+1).choose k
