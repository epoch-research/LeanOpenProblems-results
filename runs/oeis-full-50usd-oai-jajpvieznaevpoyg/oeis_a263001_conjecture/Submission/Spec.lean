private lemma no_large_fst {p : ℕ × ℕ}
    (hge : 792 ≤ p.fst)
    (hsum : Nat.primeCounting (p.fst * (p.fst + 1)) +
      Nat.primeCounting (p.snd * (p.snd + 1) / 2) = 51156) : False := by
  have harg : 628056 ≤ p.fst * (p.fst + 1) := by
    nlinarith [hge]
  have hpc : 51200 ≤ Nat.primeCounting (p.fst * (p.fst + 1)) := by
    rw [← pc_628056]
    exact Nat.monotone_primeCounting harg
  omega

private lemma no_large_snd {p : ℕ × ℕ}
    (hge : 1120 ≤ p.snd)
    (hsum : Nat.primeCounting (p.fst * (p.fst + 1)) +
      Nat.primeCounting (p.snd * (p.snd + 1) / 2) = 51156) : False := by
  have hmul : 1120 * 1121 ≤ p.snd * (p.snd + 1) := by
    nlinarith [hge]
  have harg' : 1120 * 1121 / 2 ≤ p.snd * (p.snd + 1) / 2 :=
    Nat.div_le_div_right hmul
  have harg : 627760 ≤ p.snd * (p.snd + 1) / 2 := by
    norm_num at harg' ⊢
    exact harg'
  have hpc : 51179 ≤ Nat.primeCounting (p.snd * (p.snd + 1) / 2) := by
    rw [← pc_627760]
    exact Nat.monotone_primeCounting harg
  omega

