theorem hcheckY : GR.ncheckChain M (2,1) W (1,0) fullY = true := by
  unfold fullY
  exact GR.ncheckChain_append M (2,1) W segY_1 (1,0) _ segY_1_thm
    (GR.ncheckChain_append M (2,1) W segY_2 _ _ segY_2_thm
      (GR.ncheckChain_append M (2,1) W segY_3 _ _ segY_3_thm
        (GR.ncheckChain_append M (2,1) W segY_4 _ _ segY_4_thm
          segY_5_thm)))

theorem hyv : GR.toGR M ypair = (GR.om : GR M) ^ (3 ^ 39100) := by
  have h := GR.cert_value M W ypair fullY P39100 hcheckY (by decide) (by decide)
  have hP : P39100 = 3 ^ 39100 := by unfold P39100; norm_num
  rw [hP] at h; exact h

theorem checkUnit (e Eq : ℕ) (invpair : ℕ × ℕ) (he : e < 2 ^ 20)
    (hEq : Eq = 3 ^ 39100 * e)
    (hinv : GR.nmul M (GR.nsub M (GR.nstep M ypair (1,0) e 20) (1,0)) invpair = (1,0)) :
    IsUnit ((GR.om : GR M) ^ Eq - 1) := by
  rw [hEq, pow_mul, ← hyv]
  have ht := GR.toGR_nstep M ypair e 20 (1,0)
  rw [GR.toGR_one, one_pow, one_mul, Nat.mod_eq_of_lt he] at ht
  rw [← ht]
  have hcg := congrArg (GR.toGR M) hinv
  rw [GR.toGR_mul, GR.toGR_sub M _ (1,0) (by unfold M; norm_num) (Nat.zero_le M), GR.toGR_one] at hcg
  exact IsUnit.of_mul_eq_one _ hcg

theorem M_prime : Nat.Prime M := by
  apply primality_test M
  · unfold M; norm_num
  · unfold M; decide
  · unfold M; decide
  · have key : M + 1 = 3 ^ 39100 * 605658 := by
      have h3 : (3:ℕ) ^ 39101 = 3 ^ 39100 * 3 := by rw [pow_succ]
      rw [hMfact, h3]; generalize (3:ℕ) ^ 39100 = X; ring
    rw [key, pow_mul, ← hyv]
    have ht := GR.toGR_nstep M ypair 605658 20 (1,0)
    have hnp : GR.nstep M ypair (1,0) 605658 20 = (1,0) := by decide
    rw [hnp, GR.toGR_one, one_pow, one_mul,
      Nat.mod_eq_of_lt (by norm_num : (605658:ℕ) < 2 ^ 20)] at ht
    exact ht.symm
  · intro q hq hqd
    rw [hMfact, mul_assoc] at hqd
    have hqmem : q = 2 ∨ q = 3 ∨ q = 100943 := by
      rcases (Nat.Prime.dvd_mul hq).1 hqd with h | h
      · left; exact (Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 h
      · rcases (Nat.Prime.dvd_mul hq).1 h with h2 | h2
        · right; right; exact (Nat.prime_dvd_prime_iff_eq hq (by norm_num)).1 h2
        · right; left
          exact (Nat.prime_dvd_prime_iff_eq hq Nat.prime_three).1 (hq.dvd_of_dvd_pow h2)
    rcases hqmem with rfl | rfl | rfl
    · refine checkUnit 302829 ((M+1)/2) inv2pair (by norm_num) ?_ (by decide)
      have h3 : (3:ℕ) ^ 39101 = 3 ^ 39100 * 3 := by rw [pow_succ]
      have hm : M + 1 = 2 * (3 ^ 39100 * 302829) := by
        rw [hMfact, h3]; generalize (3:ℕ) ^ 39100 = X; ring
      omega
    · refine checkUnit 201886 ((M+1)/3) inv3pair (by norm_num) ?_ (by decide)
      have h3 : (3:ℕ) ^ 39101 = 3 ^ 39100 * 3 := by rw [pow_succ]
      have hm : M + 1 = 3 * (3 ^ 39100 * 201886) := by
        rw [hMfact, h3]; generalize (3:ℕ) ^ 39100 = X; ring
      omega
    · refine checkUnit 6 ((M+1)/100943) invppair (by norm_num) ?_ (by decide)
      have h3 : (3:ℕ) ^ 39101 = 3 ^ 39100 * 3 := by rw [pow_succ]
      have hm : M + 1 = 100943 * (3 ^ 39100 * 6) := by
        rw [hMfact, h3]; generalize (3:ℕ) ^ 39100 = X; ring
      omega

theorem oeis_a354747_conjecture_0.disproof : ¬ (a354747 100943 = 0) := by
  have hprime : Nat.Prime (2 * 100943 * 3 ^ 39101 - 1) := by
    have hv : 2 * 100943 * 3 ^ 39101 - 1 = M := by have := hMfact; omega
    rw [hv]; exact M_prime
  have hne : ({m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)}).Nonempty :=
    ⟨39101, by norm_num, hprime⟩
  intro h
  have hin := Nat.sInf_mem hne
  have heq : a354747 100943 = sInf {m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} := rfl
  rw [heq] at h
  rw [h] at hin
  exact absurd hin.1 (lt_irrefl 0)
