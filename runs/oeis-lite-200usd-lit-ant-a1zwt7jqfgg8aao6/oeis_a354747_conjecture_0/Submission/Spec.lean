theorem segY_1_thm : GR.ncheckChain M (2,1) W startY_1 segY_1 = true := by decide
theorem segY_2_thm : GR.ncheckChain M (2,1) W startY_2 segY_2 = true := by decide
theorem segY_3_thm : GR.ncheckChain M (2,1) W startY_3 segY_3 = true := by decide
