import FormalConjectures.Util.ProblemImports

open Nat Int Rat Finset
open scoped BigOperators

set_option maxRecDepth 1000000
set_option maxHeartbeats 10000000

/-- The $n$-th harmonic number $\sum_{k=1}^n 1/k$, as a rational number. -/
noncomputable def harmonic_number (n : ℕ) : ℚ :=
  (Finset.range n).sum fun k => (1 : ℚ) / (((k + 1) : ℕ) : ℚ)

noncomputable def A309391 (n : ℕ) : ℕ :=
  if n < 3 then 0 else
  let m : ℕ := n - 2
  let r : ℚ := harmonic_number m
  let num_minus_den : ℤ := r.num - (r.den : ℤ)
  Nat.gcd n num_minus_den.natAbs

theorem key_lemma (M : ℕ) [NeZero M] :
    ∀ (L : List (ℕ × ℕ)),
      (∀ p ∈ L, Nat.Coprime p.1 M) →
      (∀ p ∈ L, (p.1 * p.2) % M = 1) →
      (L.map (fun p => ((p.1 : ZMod M))⁻¹)).sum = (L.map (fun p => ((p.2 : ZMod M)))).sum := by
  intro L
  induction L with
  | nil => intro _ _; simp
  | cons hd tl ih =>
    intro hcop hinv
    simp only [List.map_cons, List.sum_cons]
    have hcop_hd : Nat.Coprime hd.1 M := hcop hd (by simp)
    have hinv_hd : (hd.1 * hd.2) % M = 1 := hinv hd (by simp)
    have hmul : (hd.1 : ZMod M) * (hd.2 : ZMod M) = 1 := by
      have h2 : ((hd.1 * hd.2 : ℕ) : ZMod M) = ((1 : ℕ) : ZMod M) := by
        rw [← ZMod.natCast_mod, hinv_hd]
      push_cast at h2; exact h2
    have hjinv : (hd.1 : ZMod M) * (hd.1 : ZMod M)⁻¹ = 1 := ZMod.coe_mul_inv_eq_one hd.1 hcop_hd
    have heq : (hd.1 : ZMod M)⁻¹ = (hd.2 : ZMod M) := by
      calc (hd.1 : ZMod M)⁻¹ = 1 * (hd.1 : ZMod M)⁻¹ := (one_mul _).symm
        _ = ((hd.1 : ZMod M) * (hd.2 : ZMod M)) * (hd.1 : ZMod M)⁻¹ := by rw [hmul]
        _ = (hd.2 : ZMod M) * ((hd.1 : ZMod M) * (hd.1 : ZMod M)⁻¹) := by ring
        _ = (hd.2 : ZMod M) := by rw [hjinv, mul_one]
    rw [heq, ih (fun p hp => hcop p (by simp [hp])) (fun p hp => hinv p (by simp [hp]))]

-- bridge: Finset.range sum to List.range mapped sum
theorem range_sum (M : ℕ) (n : ℕ) (g : ℕ → ZMod M) :
    ∑ j ∈ Finset.range n, g j = ((List.range n).map g).sum := by
  rw [Finset.sum]; rfl

theorem cert_sum (M : ℕ) [NeZero M] (a n : ℕ) (C : List ℕ)
    (hlen : C.length = n)
    (hcop : ∀ i, i < n → Nat.Coprime (a + i) M)
    (hinv : ∀ p ∈ ((List.range n).map (fun i => a + i)).zip C, (p.1 * p.2) % M = 1) :
    (∑ j ∈ Finset.Ico a (a + n), (j : ZMod M)⁻¹) = ((C.sum : ℕ) : ZMod M) := by
  set A : List ℕ := (List.range n).map (fun i => a + i) with hA
  have hAlen : A.length = n := by rw [hA, List.length_map, List.length_range]
  set L : List (ℕ × ℕ) := A.zip C with hL
  have hfst : L.map Prod.fst = A := by
    rw [hL]; exact List.map_fst_zip (by rw [hAlen, hlen])
  have hsnd : L.map Prod.snd = C := by
    rw [hL]; exact List.map_snd_zip (by rw [hAlen, hlen])
  -- step 1: Ico to range
  rw [Finset.sum_Ico_eq_sum_range]
  have hn : a + n - a = n := by omega
  rw [hn]
  -- step 2: range to list
  rw [range_sum M n (fun i => (((a + i : ℕ) : ZMod M))⁻¹)]
  -- step 3: express as L.map (inv of fst)
  have hmapL : L.map (fun p : ℕ × ℕ => ((p.1 : ZMod M))⁻¹)
      = (List.range n).map (fun i => (((a + i : ℕ) : ZMod M))⁻¹) := by
    have h1 : L.map (fun p : ℕ × ℕ => ((p.1 : ZMod M))⁻¹)
        = (L.map Prod.fst).map (fun (j:ℕ) => ((j : ZMod M))⁻¹) := by rw [List.map_map]; rfl
    rw [h1, hfst, hA, List.map_map]; rfl
  rw [← hmapL]
  -- key lemma
  have hkey := key_lemma M L
    (by intro p hp
        have hmem : p.1 ∈ A := by rw [← hfst]; exact List.mem_map_of_mem hp
        rw [hA] at hmem
        obtain ⟨i, hi, hpi⟩ := List.mem_map.mp hmem
        rw [List.mem_range] at hi
        rw [← hpi]; exact hcop i hi)
    (by intro p hp; exact hinv p (by rw [hL] at hp; exact hp))
  rw [hkey]
  -- now: (L.map (fun p => (p.2:ZMod M))).sum = (C.sum : ZMod M)
  have hmap2 : L.map (fun p : ℕ × ℕ => ((p.2 : ZMod M))) = C.map (fun (c:ℕ) => ((c : ZMod M))) := by
    rw [← hsnd, List.map_map]; rfl
  rw [hmap2]
  exact (Nat.cast_list_sum C).symm

theorem hp_prime : Nat.Prime 16843 := by norm_num

theorem cop_helper (a i : ℕ) (h1 : 1 ≤ a) (h2 : a + i < 16843) :
    Nat.Coprime (a + i) (16843^3) := by
  apply Nat.Coprime.pow_right
  rw [Nat.coprime_comm]
  exact (hp_prime.coprime_iff_not_dvd).mpr (fun hcon => by have := Nat.le_of_dvd (by omega) hcon; omega)

