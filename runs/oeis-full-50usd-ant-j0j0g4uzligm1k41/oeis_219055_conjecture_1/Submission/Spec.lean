def hasOdd (n d fuel : ℕ) : Bool :=
  match fuel with
  | 0 => false
  | fuel+1 => bif Nat.blt n (d*d) then false
              else bif Nat.beq (n % d) 0 then true
              else hasOdd n (d+2) fuel

def isPrimeB (n : ℕ) : Bool :=
  bif Nat.beq n 2 then true
  else bif Nat.blt 2 n && Nat.beq (n % 2) 1 then !(hasOdd n 3 130)
  else false

theorem hasOdd_false : ∀ (fuel n d : ℕ), hasOdd n d fuel = false →
    ∀ m, d ≤ m → m < d + 2 * fuel → m * m ≤ n → (∃ t, m = d + 2 * t) → ¬ m ∣ n := by
  intro fuel
  induction fuel with
  | zero => intro n d _ m hdm hmlt _ _ hdvd; omega
  | succ fuel ih =>
    intro n d h m hdm hmlt hmm ht hdvd
    rw [hasOdd] at h
    cases hblt : Nat.blt n (d * d) with
    | true =>
        rw [Nat.blt_eq] at hblt
        have : d * d ≤ m * m := Nat.mul_le_mul hdm hdm
        omega
    | false =>
        simp only [hblt, cond_false] at h
        cases hbeq : Nat.beq (n % d) 0 with
        | true => simp only [hbeq, cond_true] at h; exact absurd h (by decide)
        | false =>
            simp only [hbeq, cond_false] at h
            have hdn : ¬ d ∣ n := by
              rw [Nat.dvd_iff_mod_eq_zero]
              intro hz; rw [hz] at hbeq; exact absurd hbeq (by decide)
            rcases Nat.lt_or_ge d m with hdm2 | hdm2
            · obtain ⟨t, rfl⟩ := ht
              exact ih n (d+2) h (d + 2*t) (by omega) (by omega) hmm ⟨t-1, by omega⟩ hdvd
            · have : m = d := by omega
              rw [this] at hdvd
              exact hdn hdvd

theorem isPrimeB_prime (n : ℕ) (hn : n ≤ 40000) (h : isPrimeB n = true) : n.Prime := by
  unfold isPrimeB at h
  cases h2 : Nat.beq n 2 with
  | true => rw [Nat.beq_eq] at h2; subst h2; exact Nat.prime_two
  | false =>
    simp only [h2, cond_false] at h
    cases hodd : (Nat.blt 2 n && Nat.beq (n % 2) 1) with
    | false => simp only [hodd, cond_false] at h; exact absurd h (by decide)
    | true =>
      simp only [hodd, cond_true] at h
      rw [Bool.not_eq_true'] at h
      rw [Bool.and_eq_true] at hodd
      obtain ⟨hn2, hnmod⟩ := hodd
      rw [Nat.blt_eq] at hn2
      rw [Nat.beq_eq] at hnmod
      rw [Nat.prime_def_le_sqrt]
      refine ⟨by omega, ?_⟩
      intro m hm2 hmsqrt hdvd
      have hmm : m * m ≤ n := (Nat.le_sqrt).1 hmsqrt
      have hmm40 : m * m ≤ 40000 := le_trans hmm hn
      have hm200 : m ≤ 200 := by
        by_contra hc; push_neg at hc
        have : 201 * 201 ≤ m * m := Nat.mul_le_mul (by omega) (by omega)
        omega
      by_cases hmeven : m % 2 = 0
      · obtain ⟨j, rfl⟩ : ∃ j, m = 2 * j := ⟨m/2, by omega⟩
        have : (2 : ℕ) ∣ n := dvd_trans ⟨j, by ring⟩ hdvd
        omega
      · have hm3 : 3 ≤ m := by omega
        have hmt : ∃ t, m = 3 + 2 * t := ⟨(m - 3) / 2, by omega⟩
        exact hasOdd_false 130 n 3 h m hm3 (by omega) hmm hmt hdvd

def checkG (code n fuel : ℕ) : Bool :=
  match fuel with
  | 0 => true
  | fuel+1 =>
      (isPrimeB (code % 256) && isPrimeB (n - code % 256)) && checkG (code / 256) (n+2) fuel

theorem checkG_sound : ∀ (fuel code n : ℕ), checkG code n fuel = true →
    n + 2 * fuel ≤ 40000 →
    ∀ i, i < fuel → ∃ p q, p.Prime ∧ q.Prime ∧ (n + 2 * i) = p + q := by
  intro fuel
  induction fuel with
  | zero => intro code n _ _ i hi; omega
  | succ fuel ih =>
    intro code n h hb i hi
    rw [checkG] at h
    rw [Bool.and_eq_true] at h
    obtain ⟨h1, h2⟩ := h
    rw [Bool.and_eq_true] at h1
    obtain ⟨hq, hnq⟩ := h1
    rcases Nat.eq_zero_or_pos i with hi0 | hipos
    · subst hi0
      set q := code % 256 with hqdef
      have hqp : q.Prime := isPrimeB_prime q (by omega) hq
      have hnqp : (n - q).Prime := isPrimeB_prime (n - q) (by omega) hnq
      have hq2 : 2 ≤ n - q := hnqp.two_le
      refine ⟨n - q, q, hnqp, hqp, ?_⟩
      omega
    · obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      obtain ⟨p, q, hp, hq2, he⟩ := ih (code / 256) (n + 2) h2 (by omega) i' (by omega)
      refine ⟨p, q, hp, hq2, ?_⟩
      omega

def checkL (code n fuel : ℕ) : Bool :=
  match fuel with
  | 0 => true
  | fuel+1 =>
      (isPrimeB (code % 256) && isPrimeB (n - 2 * (code % 256))) && checkL (code / 256) (n+2) fuel

theorem checkL_sound : ∀ (fuel code n : ℕ), checkL code n fuel = true →
    n + 2 * fuel ≤ 40000 →
    ∀ i, i < fuel → ∃ p q, p.Prime ∧ q.Prime ∧ (n + 2 * i) = p + 2 * q := by
  intro fuel
  induction fuel with
  | zero => intro code n _ _ i hi; omega
  | succ fuel ih =>
    intro code n h hb i hi
    rw [checkL] at h
    rw [Bool.and_eq_true] at h
    obtain ⟨h1, h2⟩ := h
    rw [Bool.and_eq_true] at h1
    obtain ⟨hq, hnq⟩ := h1
    rcases Nat.eq_zero_or_pos i with hi0 | hipos
    · subst hi0
      set q := code % 256 with hqdef
      have hqp : q.Prime := isPrimeB_prime q (by omega) hq
      have hnqp : (n - 2 * q).Prime := isPrimeB_prime (n - 2 * q) (by omega) hnq
      have hq2 : 2 ≤ n - 2 * q := hnqp.two_le
      refine ⟨n - 2 * q, q, hnqp, hqp, ?_⟩
      omega
    · obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
      obtain ⟨p, q, hp, hq2, he⟩ := ih (code / 256) (n + 2) h2 (by omega) i' (by omega)
      refine ⟨p, q, hp, hq2, ?_⟩
      omega

theorem gchunk_sound (code startN len : ℕ) (hchk : checkG code startN len = true)
    (hb : startN + 2 * len ≤ 40000) (hse : startN % 2 = 0) (n : ℕ) (he : Even n)
    (hlo : startN ≤ n) (hhi : n < startN + 2 * len) :
    ∃ p q, p.Prime ∧ q.Prime ∧ n = p + q := by
  obtain ⟨k, hk⟩ := he
  obtain ⟨p, q, hp, hq, heq⟩ :=
    checkG_sound len code startN hchk hb ((n - startN) / 2) (by omega)
  exact ⟨p, q, hp, hq, by omega⟩

theorem lchunk_sound (code startN len : ℕ) (hchk : checkL code startN len = true)
    (hb : startN + 2 * len ≤ 40000) (hso : startN % 2 = 1) (n : ℕ) (ho : Odd n)
    (hlo : startN ≤ n) (hhi : n < startN + 2 * len) :
    ∃ p q, p.Prime ∧ q.Prime ∧ n = p + 2 * q := by
  obtain ⟨k, hk⟩ := ho
  obtain ⟨p, q, hp, hq, heq⟩ :=
    checkL_sound len code startN hchk hb ((n - startN) / 2) (by omega)
  exact ⟨p, q, hp, hq, by omega⟩

