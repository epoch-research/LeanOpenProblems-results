theorem core_even (hcore : a219055_core_conjecture) (n : ℕ) (he : Even n) (hn : 8012 < n) :
    ∃ q, 2 * q < n ∧ q.Prime ∧ (q + 6).Prime ∧ (n - q).Prime ∧ (n - q - 6).Prime := by
  have hpos : A219055 n > 0 := hcore n (Or.inl ⟨he, hn⟩)
  unfold A219055 at hpos
  obtain ⟨q, hq⟩ := Finset.card_pos.mp hpos
  rw [Finset.mem_filter] at hq
  obtain ⟨_, hlt, hqp, hq6, hpp, hp6⟩ := hq
  have hmod : n % 2 = 0 := Nat.even_iff.mp he
  have hc : 1 + n % 2 = 1 := by rw [hmod]
  rw [hc] at hlt hpp hp6
  simp only [Nat.one_mul] at hpp hp6
  exact ⟨q, by omega, hqp, hq6, hpp, hp6⟩

theorem core_odd (hcore : a219055_core_conjecture) (n : ℕ) (ho : Odd n) (hn : 15727 < n) :
    ∃ q, 3 * q < n ∧ q.Prime ∧ (q + 6).Prime ∧ (n - 2 * q).Prime ∧ (n - 2 * q - 6).Prime := by
  have hpos : A219055 n > 0 := hcore n (Or.inr ⟨ho, hn⟩)
  unfold A219055 at hpos
  obtain ⟨q, hq⟩ := Finset.card_pos.mp hpos
  rw [Finset.mem_filter] at hq
  obtain ⟨_, hlt, hqp, hq6, hpp, hp6⟩ := hq
  have hmod : n % 2 = 1 := Nat.odd_iff.mp ho
  have hc : 1 + n % 2 = 2 := by rw [hmod]
  rw [hc] at hlt hpp hp6
  exact ⟨q, by omega, hqp, hq6, hpp, hp6⟩

/--
A219055, Conjecture 1: The core conjecture for A219055 implies Goldbach's conjecture,
Lemoine's conjecture and the conjecture that there are infinitely many primes p with p+6 also prime.
-/
theorem oeis_219055_conjecture_1 :
    a219055_core_conjecture → goldbach_conjecture ∧ lemoine_conjecture ∧ six_prime_gap_conjecture := by
  intro hcore
  refine ⟨?_, ?_, ?_⟩
  · intro n h4 he
    by_cases hle : n ≤ 8012
    · exact goldbach_small n h4 hle he
    · push_neg at hle
      obtain ⟨q, hlt, hqp, hq6, hpp, hp6⟩ := core_even hcore n he hle
      exact ⟨n - q, q, hpp, hqp, by omega⟩
  · intro n h7 ho
    by_cases hle : n ≤ 15727
    · exact lemoine_small n h7 hle ho
    · push_neg at hle
      obtain ⟨q, hlt, hqp, hq6, hpp, hp6⟩ := core_odd hcore n ho hle
      exact ⟨n - 2 * q, q, hpp, hqp, by omega⟩
  · apply Set.infinite_of_not_bddAbove
    rw [not_bddAbove_iff]
    intro N
    set n : ℕ := 2 * (N + 4007) with hndef
    have hne : Even n := ⟨N + 4007, by omega⟩
    have hnb : 8012 < n := by omega
    obtain ⟨q, hlt, hqp, hq6, hpp, hp6⟩ := core_even hcore n hne hnb
    refine ⟨n - q - 6, ?_, ?_⟩
    · refine ⟨hp6, ?_⟩
      have h2 : 2 ≤ n - q - 6 := hp6.two_le
      have : n - q - 6 + 6 = n - q := by omega
      rw [this]; exact hpp
    · have h2 : 2 ≤ n - q - 6 := hp6.two_le
      omega
