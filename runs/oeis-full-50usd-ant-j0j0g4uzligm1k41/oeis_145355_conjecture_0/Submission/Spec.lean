import FormalConjectures.Util.ProblemImports

open Real

/--
A145355: $a(n) = \mathrm{round}(\mathrm{round}(\sqrt{n!})/|(\mathrm{round}(\sqrt{n!}))^2 - n!|)$.
The provided sequence starts at $n=2$. The definition works for $n=0, 1$ as well, provided we accept the behavior of $\mathbb{R}$ division by zero, which in Mathlib is typically $0$ but the result is not significant since the sequence is defined for $n \ge 2$ where the denominator is nonzero.
-/
noncomputable def a (n : ℕ) : ℕ :=
  let fact_r : ℝ := Nat.cast (Nat.factorial n)
  let r_int : ℤ := round (sqrt fact_r)
  let r_real : ℝ := Int.cast r_int
  let den_val : ℝ := abs (r_real^2 - fact_r)
  (round (r_real / den_val)).toNat

/-- If `m ≥ 1`, `m*m < N + m` and `N ≤ m*m + m`, then `round (√N) = m`
(i.e. `m` is the nearest integer to `√N`). -/
theorem round_sqrt_eq (N m : ℕ) (hm : 1 ≤ m)
    (h1 : m * m < N + m) (h2 : N ≤ m * m + m) :
    round (Real.sqrt (N : ℝ)) = (m : ℤ) := by
  have hmh : (0:ℝ) ≤ (m:ℝ) - 1/2 := by
    have : (1:ℝ) ≤ m := by exact_mod_cast hm
    linarith
  rw [round_eq]
  have hlow : (m : ℝ) - 1/2 ≤ Real.sqrt N := by
    rw [show (m:ℝ) - 1/2 = Real.sqrt (((m:ℝ) - 1/2)^2) by rw [Real.sqrt_sq hmh]]
    apply Real.sqrt_le_sqrt
    have hN : (m:ℝ)*m + 1 ≤ (N:ℝ) + m := by exact_mod_cast Nat.succ_le_of_lt h1
    nlinarith [hN]
  have hhigh : Real.sqrt N < (m : ℝ) + 1/2 := by
    rw [show (m:ℝ) + 1/2 = Real.sqrt (((m:ℝ) + 1/2)^2) by rw [Real.sqrt_sq (by positivity)]]
    apply Real.sqrt_lt_sqrt (by positivity)
    have hN : (N:ℝ) ≤ (m:ℝ)*m + m := by exact_mod_cast h2
    nlinarith [hN]
  rw [Int.floor_eq_iff]
  refine ⟨by push_cast; linarith, by push_cast; linarith⟩

/-- Concrete witness 1: `a 7 = 71` (since `7! = 5040` and `71² = 5041`,
giving denominator `1`). This already refutes the conjecture for every `C < 71`. -/
theorem a_seven : a 7 = 71 := by
  have hf : (Nat.factorial 7 : ℝ) = 5040 := by norm_num [Nat.factorial]
  have hr : round (Real.sqrt (5040 : ℝ)) = (71 : ℤ) := by
    have := round_sqrt_eq 5040 71 (by norm_num) (by norm_num) (by norm_num)
    norm_num at this ⊢
    convert this using 3
  unfold a
  simp only [hf, hr]
  norm_num
  rfl

set_option maxRecDepth 10000

