import FormalConjectures.Util.ProblemImports
open Nat
set_option maxRecDepth 8000
namespace Cert
def powMod (m : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 1 % m
  | fuel+1, a, e =>
      if e = 0 then 1 % m
      else
        let h := powMod m fuel ((a*a) % m) (e/2)
        if e % 2 = 1 then (h * (a % m)) % m else h
theorem powMod_correct (m : ℕ) : ∀ (fuel a e : ℕ), e < 2^fuel → powMod m fuel a e = a^e % m := by
  intro fuel
  induction fuel with
  | zero => intro a e he; simp only [pow_zero] at he; interval_cases e; simp [powMod]
  | succ f ih =>
    intro a e he
    rw [powMod]
    by_cases h0 : e = 0
    · subst h0; simp
    · simp only [if_neg h0]
      have hlt : e / 2 < 2 ^ f := by rw [pow_succ] at he; omega
      have hih := ih ((a*a) % m) (e/2) hlt
      have key : ((a*a) % m)^(e/2) % m = a^(2*(e/2)) % m := by rw [← Nat.pow_mod, ← pow_two, ← pow_mul]
      by_cases hodd : e % 2 = 1
      · simp only [if_pos hodd, hih, key, ← Nat.mul_mod, ← pow_succ]; rw [show 2*(e/2)+1 = e from by omega]
      · simp only [if_neg hodd, hih, key]; rw [show 2*(e/2) = e from by omega]
theorem cast_eq_one_iff (p x : ℕ) : ((x : ZMod p) = 1) ↔ x % p = 1 % p := by
  rw [show (1 : ZMod p) = ((1:ℕ) : ZMod p) by simp, ZMod.natCast_eq_natCast_iff]; rfl
def prodPP : List (ℕ × ℕ) → ℕ
  | [] => 1
  | (q,e)::t => q^e * prodPP t
theorem primeFactors_subset (L : List (ℕ×ℕ)) (hL : ∀ x ∈ L, (x.1).Prime) :
    ∀ q, q.Prime → q ∣ prodPP L → q ∈ L.map Prod.fst := by
  induction L with
  | nil => intro q hq hd; rw [prodPP] at hd; exact absurd (Nat.eq_one_of_dvd_one hd) hq.one_lt.ne'
  | cons hd t ih =>
    intro q hq hdvd
    rw [prodPP] at hdvd
    rcases (Nat.Prime.dvd_mul hq).mp hdvd with h1 | h2
    · have hpr := hL hd (by simp)
      have : q = hd.1 := (Nat.prime_dvd_prime_iff_eq hq hpr).mp (hq.dvd_of_dvd_pow h1)
      simp [this]
    · exact List.mem_cons_of_mem _ (ih (fun x hx => hL x (List.mem_cons_of_mem _ hx)) q hq h2)
theorem lucas_of (p a fuel : ℕ) (hp : 1 < p) (hfuel : p - 1 < 2^fuel)
    (L : List (ℕ × ℕ)) (hpfac : p - 1 = prodPP L) (hLp : ∀ x ∈ L, (x.1).Prime)
    (ha : powMod p fuel a (p-1) = 1 % p)
    (hcheck : ∀ q ∈ L.map Prod.fst, powMod p fuel a ((p-1)/q) ≠ 1 % p) : p.Prime := by
  apply lucas_primality p (a : ZMod p)
  · rw [← Nat.cast_pow, cast_eq_one_iff, ← powMod_correct p fuel a (p-1) hfuel, ha]
  · intro q hq hqd
    have hqin : q ∈ L.map Prod.fst := primeFactors_subset L hLp q hq (hpfac ▸ hqd)
    have hd : (p-1)/q < 2^fuel := lt_of_le_of_lt (Nat.div_le_self _ _) hfuel
    rw [ne_eq, ← Nat.cast_pow, cast_eq_one_iff, ← powMod_correct p fuel a ((p-1)/q) hd]
    exact hcheck q hqin
end Cert

open Nat
set_option maxRecDepth 100000
set_option maxHeartbeats 20000000
def S_condition (m:ℕ):Prop:=Nat.Prime(2*m+1)∧Nat.Prime(2*m^3+1)
def checkPair (SL : List ℕ) : ℕ → List (ℕ×ℕ) → Bool
  | _, [] => true
  | t, (a,b)::rest => decide (a+b=t ∧ a ∈ SL ∧ b ∈ SL) && checkPair SL (t+1) rest
theorem checkPair_sound (SL : List ℕ) :
    ∀ (lo : ℕ) (wits : List (ℕ×ℕ)), checkPair SL lo wits = true →
    ∀ t, lo ≤ t → t < lo + wits.length → ∃ a b, a+b=t ∧ a ∈ SL ∧ b ∈ SL := by
  intro lo wits
  induction wits generalizing lo with
  | nil => intro _ t hlo ht; simp only [List.length_nil, Nat.add_zero] at ht; omega
  | cons w rest ih =>
    obtain ⟨a,b⟩ := w
    intro hchk t hlo ht
    rw [checkPair, Bool.and_eq_true] at hchk
    obtain ⟨hd, hrest⟩ := hchk
    by_cases ht0 : t = lo
    · subst ht0; obtain ⟨hsum, hma, hmb⟩ := of_decide_eq_true hd; exact ⟨a,b,hsum,hma,hmb⟩
    · have hlen : t < (lo+1) + rest.length := by simp only [List.length_cons] at ht; omega
      exact ih (lo+1) hrest t (by omega) hlen
def gapChainB (d : ℕ) : ℕ → List ℕ → Bool
  | _, [] => true
  | c1, c2 :: rest => decide (c2 ≤ c1 + (d+1)) && gapChainB d c2 rest
theorem cover_exists (wl d : ℕ) : ∀ (C : List ℕ) (c1 n : ℕ),
    gapChainB d c1 C = true → c1 + wl ≤ n → n ≤ (C.getLastD c1) + wl + d →
    ∃ c, (c = c1 ∨ c ∈ C) ∧ c + wl ≤ n ∧ n ≤ c + wl + d := by
  intro C
  induction C with
  | nil => intro c1 n _ hlo hub; exact ⟨c1, Or.inl rfl, hlo, by simpa using hub⟩
  | cons c2 rest ih =>
    intro c1 n hchain hlo hub
    rw [gapChainB, Bool.and_eq_true] at hchain
    obtain ⟨hstep, hchain'⟩ := hchain
    have hstep' : c2 ≤ c1 + (d+1) := of_decide_eq_true hstep
    by_cases hlt : n < c2 + wl
    · exact ⟨c1, Or.inl rfl, hlo, by omega⟩
    · have hub2 : n ≤ (rest.getLastD c2) + wl + d := by rwa [List.getLastD_cons] at hub
      obtain ⟨c, hc, h1, h2⟩ := ih c2 n hchain' (by omega) hub2
      refine ⟨c, ?_, h1, h2⟩
      rcases hc with h | h
      · exact Or.inr (h ▸ List.mem_cons_self ..)
      · exact Or.inr (List.mem_cons_of_mem _ h)
theorem large_rep (SL Clist : List ℕ) (c0 wl d : ℕ) (wits : List (ℕ×ℕ))
    (hpair : checkPair SL wl wits = true) (hd : d + 1 = wits.length)
    (hgap : gapChainB d c0 Clist = true) (hc0mem : c0 ∈ SL) (hClistmem : ∀ c ∈ Clist, c ∈ SL) :
    ∀ n, c0 + wl ≤ n → n ≤ (Clist.getLastD c0) + wl + d →
      ∃ x y z, x+y+z = n ∧ x ∈ SL ∧ y ∈ SL ∧ z ∈ SL := by
  intro n hlo hub
  obtain ⟨c, hc, h1, h2⟩ := cover_exists wl d Clist c0 n hgap hlo hub
  have hcmem : c ∈ SL := by rcases hc with h | h; · exact h ▸ hc0mem; · exact hClistmem c h
  obtain ⟨s1,s2,hs,hm1,hm2⟩ := checkPair_sound SL wl wits hpair (n-c) (by omega) (by omega)
  exact ⟨s1,s2,c, by omega, hm1, hm2, hcmem⟩
