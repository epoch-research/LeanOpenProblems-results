theorem S_condition_pos {m : ℕ} (h : S_condition m) : 1 ≤ m := by
  rcases Nat.eq_zero_or_pos m with h0 | h0
  · subst h0; exact absurd h.1 (by norm_num)
  · exact h0
theorem A230507_pos_of_ordered (n a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c)
    (ha1 : 1 ≤ a) (hsum : a + b + c = n)
    (hsa : S_condition a) (hsb : S_condition b) (hsc : S_condition c) : 0 < A230507 n := by
  have haI : a ∈ Finset.Icc 1 (n/3) := by
    rw [Finset.mem_Icc]; exact ⟨ha1, (Nat.le_div_iff_mul_le (by norm_num)).2 (by omega)⟩
  have hbI : b ∈ Finset.Icc a ((n-a)/2) := by
    rw [Finset.mem_Icc]; exact ⟨hab, (Nat.le_div_iff_mul_le (by norm_num)).2 (by omega)⟩
  have hc : n - a - b = c := by omega
  apply Finset.sum_pos'
  · intro i _; exact Nat.zero_le _
  · refine ⟨a, haI, ?_⟩
    apply Finset.sum_pos'
    · intro i _; exact Nat.zero_le _
    · refine ⟨b, hbI, ?_⟩; simp only [hc]; rw [if_pos ⟨hsa, hsb, hsc⟩]; exact Nat.one_pos
theorem A230507_pos_of_rep (n x y z : ℕ)
    (hx : 1 ≤ x) (hy : 1 ≤ y) (hz : 1 ≤ z) (hsum : x + y + z = n)
    (hsx : S_condition x) (hsy : S_condition y) (hsz : S_condition z) : 0 < A230507 n := by
  rcases le_total x y with hxy | hxy <;> rcases le_total y z with hyz | hyz <;>
    rcases le_total x z with hxz | hxz
  · exact A230507_pos_of_ordered n x y z (by omega) (by omega) (by omega) (by omega) hsx hsy hsz
  · exact A230507_pos_of_ordered n x y z (by omega) (by omega) (by omega) (by omega) hsx hsy hsz
  · exact A230507_pos_of_ordered n x z y (by omega) (by omega) (by omega) (by omega) hsx hsz hsy
  · exact A230507_pos_of_ordered n z x y (by omega) (by omega) (by omega) (by omega) hsz hsx hsy
  · exact A230507_pos_of_ordered n y x z (by omega) (by omega) (by omega) (by omega) hsy hsx hsz
  · exact A230507_pos_of_ordered n y z x (by omega) (by omega) (by omega) (by omega) hsy hsz hsx
  · exact A230507_pos_of_ordered n z y x (by omega) (by omega) (by omega) (by omega) hsz hsy hsx
  · exact A230507_pos_of_ordered n z y x (by omega) (by omega) (by omega) (by omega) hsz hsy hsx
theorem rep_to_pos (L : List ℕ) (hL : ∀ x ∈ L, S_condition x) (n x y z : ℕ)
    (hs : x+y+z=n) (hx : x∈L) (hy : y∈L) (hz : z∈L) : 0 < A230507 n := by
  have sx := hL x hx; have sy := hL y hy; have sz := hL z hz
  exact A230507_pos_of_rep n x y z (S_condition_pos sx) (S_condition_pos sy) (S_condition_pos sz) hs sx sy sz


def checkWit (SL : List ℕ) : ℕ → List (ℕ×ℕ×ℕ) → Bool
  | _, [] => true
  | n, (a,b,c)::t => decide (a+b+c=n ∧ a ∈ SL ∧ b ∈ SL ∧ c ∈ SL) && checkWit SL (n+1) t
theorem checkWit_sound (SL : List ℕ) :
    ∀ (lo : ℕ) (wits : List (ℕ×ℕ×ℕ)), checkWit SL lo wits = true →
    ∀ n, lo ≤ n → n < lo + wits.length →
      ∃ a b c, a+b+c=n ∧ a ∈ SL ∧ b ∈ SL ∧ c ∈ SL := by
  intro lo wits
  induction wits generalizing lo with
  | nil => intro _ n hlo hn; simp only [List.length_nil, Nat.add_zero] at hn; omega
  | cons w t ih =>
    obtain ⟨a,b,c⟩ := w
    intro hchk n hlo hn
    rw [checkWit, Bool.and_eq_true] at hchk
    obtain ⟨hd, hrest⟩ := hchk
    by_cases hn0 : n = lo
    · subst hn0; obtain ⟨hsum, hma, hmb, hmc⟩ := of_decide_eq_true hd; exact ⟨a,b,c, hsum, hma, hmb, hmc⟩
    · have hlen : n < (lo+1) + t.length := by simp only [List.length_cons] at hn; omega
      exact ih (lo+1) hrest n (by omega) hlen
def checkPair (SL : List ℕ) : ℕ → List (ℕ×ℕ) → Bool
  | _, [] => true
  | t, (a,b)::rest => decide (a+b=t ∧ a ∈ SL ∧ b ∈ SL) && checkPair SL (t+1) rest
theorem checkPair_sound (SL : List ℕ) :
    ∀ (lo : ℕ) (wits : List (ℕ×ℕ)), checkPair SL lo wits = true →
    ∀ t, lo ≤ t → t < lo + wits.length → ∃ a b, a+b=t ∧ a ∈ SL ∧ b ∈ SL := by
  intro lo wits
  induction wits generalizing lo with
  | nil => intro _ t hlo ht; simp only [List.length_nil, Nat.add_zero] at ht; omega
  | cons w rest ih =>
    obtain ⟨a,b⟩ := w
    intro hchk t hlo ht
    rw [checkPair, Bool.and_eq_true] at hchk
    obtain ⟨hd, hrest⟩ := hchk
    by_cases ht0 : t = lo
    · subst ht0; obtain ⟨hsum, hma, hmb⟩ := of_decide_eq_true hd; exact ⟨a,b,hsum,hma,hmb⟩
    · have hlen : t < (lo+1) + rest.length := by simp only [List.length_cons] at ht; omega
      exact ih (lo+1) hrest t (by omega) hlen
def gapChainB (d : ℕ) : ℕ → List ℕ → Bool
  | _, [] => true
  | c1, c2 :: rest => decide (c2 ≤ c1 + (d+1)) && gapChainB d c2 rest
theorem cover_exists (wl d : ℕ) : ∀ (C : List ℕ) (c1 n : ℕ),
    gapChainB d c1 C = true → c1 + wl ≤ n → n ≤ (C.getLastD c1) + wl + d →
    ∃ c, (c = c1 ∨ c ∈ C) ∧ c + wl ≤ n ∧ n ≤ c + wl + d := by
  intro C
  induction C with
  | nil => intro c1 n _ hlo hub; exact ⟨c1, Or.inl rfl, hlo, by simpa using hub⟩
  | cons c2 rest ih =>
    intro c1 n hchain hlo hub
    rw [gapChainB, Bool.and_eq_true] at hchain
    obtain ⟨hstep, hchain'⟩ := hchain
    have hstep' : c2 ≤ c1 + (d+1) := of_decide_eq_true hstep
    by_cases hlt : n < c2 + wl
    · exact ⟨c1, Or.inl rfl, hlo, by omega⟩
    · have hub2 : n ≤ (rest.getLastD c2) + wl + d := by rwa [List.getLastD_cons] at hub
      obtain ⟨c, hc, h1, h2⟩ := ih c2 n hchain' (by omega) hub2
      refine ⟨c, ?_, h1, h2⟩
      rcases hc with h | h
      · exact Or.inr (h ▸ List.mem_cons_self ..)
      · exact Or.inr (List.mem_cons_of_mem _ h)
theorem large_rep (Clist : List ℕ) (c0 wl d : ℕ)
    (hwin : ∀ t, wl ≤ t → t ≤ wl + d → ∃ a b, a+b=t ∧ S_condition a ∧ S_condition b)
    (hgap : gapChainB d c0 Clist = true) (hSc0 : S_condition c0)
    (hSClist : ∀ c ∈ Clist, S_condition c) :
    ∀ n, c0 + wl ≤ n → n ≤ (Clist.getLastD c0) + wl + d → 0 < A230507 n := by
  intro n hlo hub
  obtain ⟨c, hc, h1, h2⟩ := cover_exists wl d Clist c0 n hgap hlo hub
  have hSc : S_condition c := hc.elim (fun h => by rw [h]; exact hSc0) (fun h => hSClist c h)
  obtain ⟨s1,s2,hs,Ss1,Ss2⟩ := hwin (n-c) (by omega) (by omega)
  exact A230507_pos_of_rep n s1 s2 c (S_condition_pos Ss1) (S_condition_pos Ss2)
    (S_condition_pos hSc) (by omega) Ss1 Ss2 hSc

