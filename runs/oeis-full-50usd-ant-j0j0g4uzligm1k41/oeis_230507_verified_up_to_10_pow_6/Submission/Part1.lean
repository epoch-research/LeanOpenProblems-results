noncomputable section
def S_condition (m : ℕ) : Prop := Nat.Prime (2 * m + 1) ∧ Nat.Prime (2 * m ^ 3 + 1)
noncomputable def A230507 (n : ℕ) : ℕ :=
  Finset.sum (Finset.Icc 1 (n / 3)) fun a ↦
    Finset.sum (Finset.Icc a ((n - a) / 2)) fun b ↦
      let c := n - a - b
      if S_condition a ∧ S_condition b ∧ S_condition c then 1 else 0
