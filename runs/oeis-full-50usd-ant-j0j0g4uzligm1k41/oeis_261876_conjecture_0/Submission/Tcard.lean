  simp only [Lall3, List.forall_mem_append]
  exact ⟨chM0, chM1, chM2, chM3, chM4, chM5, chM6, chM7, chM8, chM9, chM10, chM11⟩

lemma Lall3_subset : Lall3.toFinset ⊆ S3 := by
  intro p hp
  rw [List.mem_toFinset] at hp
  obtain ⟨h1,h2,h3,h4,h5,h6⟩ := Lall3_mem p hp
  rw [S3, Finset.mem_filter]
  refine ⟨?_, h4, h5, h6⟩
  rw [Finset.mem_product, Finset.mem_product]
  exact ⟨Finset.mem_range.mpr h1, Finset.mem_range.mpr h2, Finset.mem_range.mpr h3⟩

