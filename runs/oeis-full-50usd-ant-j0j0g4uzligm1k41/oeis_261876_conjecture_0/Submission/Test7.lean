import FormalConjectures.Util.ProblemImports
set_option maxHeartbeats 0

def treeCount (mask : Nat) : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | _, _, 0 => 0
  | _, lo, (Nat.succ 0) => if mask.testBit lo then 1 else 0
  | (fuel+1), lo, len =>
      let h := len / 2
      treeCount mask fuel lo h + treeCount mask fuel (lo+h) (len-h)

