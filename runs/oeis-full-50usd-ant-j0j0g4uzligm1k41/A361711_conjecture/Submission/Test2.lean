import Mathlib
open Finset BigOperators Nat
set_option maxHeartbeats 2000000 in
noncomputable def CertN (n k : ℚ) : ℚ :=
  84*k^3*n^9+(436*k^3-234*k^4)*n^8+(261*k^5-981*k^4+786*k^3)*n^7
   +((-135)*k^6+840*k^5-1375*k^4+466*k^3)*n^6
   +(27*k^7-306*k^6+833*k^5-452*k^4-318*k^3)*n^5
   +(36*k^7-165*k^6-64*k^5+859*k^4-702*k^3)*n^4
   +((-3)*k^7+172*k^6-808*k^5+1183*k^4-484*k^3)*n^3
   +((-34)*k^7+274*k^6-718*k^5+704*k^4-188*k^3)*n^2
   +((-22)*k^7+136*k^6-292*k^5+248*k^4-64*k^3)*n
   -4*k^7+24*k^6-52*k^5+48*k^4-16*k^3
set_option maxHeartbeats 4000000 in
example (a k : ℚ) (P Q R : ℚ) (hP : P ≠ 0) (hQ : Q ≠ 0) (hR : R ≠ 0)
    (h1 : a+1 ≠ 0) (h2 : a+2 ≠ 0) (h3 : a+3 ≠ 0) (h4 : a+4 ≠ 0)
    (g1 : a+k+1 ≠ 0) (g2 : a+k+2 ≠ 0) (g3 : a+k+3 ≠ 0) (g4 : a+k+4 ≠ 0)
    (hk : k+1 ≠ 0) :
    ((a+k+2)*((a+k+2)-1)*((a+k+2)+1)^2*((a+k+2)+2)^2) * ((-3*((a+k+2)-1)*(a+k+2)*(3*(a+k+2)+1)*(3*(a+k+2)+2)*(3*(a+k+2)^2+4*(a+k+2)+2)) * (((a+k+2)*(a+k+1)*P)/(R*((a+2)*(a+1)*Q)))^2 * (P/(R*Q)) + (-6*(a+k+2)*(6*(a+k+2)^3+12*(a+k+2)^2+5*(a+k+2)+1)) * (((a+k+3)*(a+k+2)*(a+k+1)*P)/(R*((a+3)*(a+2)*(a+1)*Q)))^2 * (((a+k+1)*P)/(R*((a+1)*Q))) + (-(a+k+2)^2*((a+k+2)+2)^2*(3*(a+k+2)^2-2*(a+k+2)+1)) * (((a+k+4)*(a+k+3)*(a+k+2)*(a+k+1)*P)/(R*((a+4)*(a+3)*(a+2)*(a+1)*Q)))^2 * (((a+k+2)*(a+k+1)*P)/(R*((a+2)*(a+1)*Q))))
      = - CertN (a+k+2) (k+1) * (((a+k+2)*(a+k+1)*P)/(((k+1)*R)*((a+1)*Q))) * (((a+k+4)*(a+k+3)*(a+k+2)*(a+k+1)*P)/(((k+1)*R)*((a+3)*(a+2)*(a+1)*Q)))^2 - CertN (a+k+2) k * (((a+k+2)*(a+k+1)*P)/(R*((a+2)*(a+1)*Q))) * (((a+k+4)*(a+k+3)*(a+k+2)*(a+k+1)*P)/(R*((a+4)*(a+3)*(a+2)*(a+1)*Q)))^2 := by
  simp only [CertN]
  field_simp
  ring
