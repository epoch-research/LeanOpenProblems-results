import FormalConjecturesUtil

/-!
# Finite zero-winding certificate for squared Gaussian steps below four

The coordinates here are `w`, with `z = 1 + (1+i)w`.  The period is 65.
There are 2304 live residues and 243 components.  The potential values were
extracted from `gaussian_sqrt2_potential_certificate.json`; the edge identities
below are proved by ordinary `decide`, and hence checked by the Lean kernel.
No external computation is used as a proof.
-/

namespace GaussianSmallStep.Certificate

abbrev Residue := ZMod 65 × ZMod 65

def residue (w : GaussianInt) : Residue := (w.re, w.im)

@[simp] theorem residue_add (u v : GaussianInt) :
    residue (u + v) = residue u + residue v := by
  apply Prod.ext <;> simp [residue]

@[simp] theorem residue_zero : residue 0 = 0 := by simp [residue]

def alpha : GaussianInt := ⟨1, 1⟩

def gaussian (w : GaussianInt) : GaussianInt := 1 + alpha * w

/-- Reduction of the Gaussian squared norm to a divisor of the period. -/
def reducedNorm (p : ℕ) (hp : p ∣ 65) (r : Residue) : ZMod p :=
  let f := ZMod.castHom hp (ZMod p)
  (1 + f r.1 - f r.2) ^ 2 + (f r.1 + f r.2) ^ 2

def Live (r : Residue) : Prop :=
  reducedNorm 5 (by decide) r ≠ 0 ∧ reducedNorm 13 (by decide) r ≠ 0

instance (r : Residue) : Decidable (Live r) := inferInstanceAs
  (Decidable (_ ≠ (0 : ZMod 5) ∧ _ ≠ (0 : ZMod 13)))

theorem reducedNorm_residue (p : ℕ) (hp : p ∣ 65) (w : GaussianInt) :
    reducedNorm p hp (residue w) = ((gaussian w).norm : ZMod p) := by
  simp only [reducedNorm, residue, map_intCast]
  simp [gaussian, alpha, Zsqrtd.norm, pow_two]
  ring

/-- The four oriented nearest-neighbor steps in the transformed lattice. -/
def step (j : Fin 4) : GaussianInt :=
  if j = 0 then ⟨1, 0⟩ else if j = 1 then ⟨-1, 0⟩ else
  if j = 2 then ⟨0, 1⟩ else ⟨0, -1⟩

