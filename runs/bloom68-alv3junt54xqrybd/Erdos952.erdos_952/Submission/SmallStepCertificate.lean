    (h' : Live (r + residue (step j))) :
    potential (r + residue (step j)) = potential r + step j := by
  rcases r with ⟨a, b⟩
  have hc : EdgesAt (a, b) := by
    change Fin 65 at a
    fin_cases a
    · exact check_row0 b
