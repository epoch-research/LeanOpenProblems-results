/-- A lift of each live residue, and zero for unused residues. -/
def potential (r : Residue) : GaussianInt :=
  let p := (table.getD r.1.val #[]).getD r.2.val (0, 0)
  ⟨p.1, p.2⟩

/-- The certificate assertion at one residue. -/
def EdgesAt (r : Residue) : Prop :=
  ∀ j : Fin 4, Live r → Live (r + residue (step j)) →
    potential (r + residue (step j)) = potential r + step j

instance (r : Residue) : Decidable (EdgesAt r) := inferInstanceAs
  (Decidable (∀ j : Fin 4, Live r → Live (r + residue (step j)) →
    potential (r + residue (step j)) = potential r + step j))

