import Submission.RootMeanIdealMobius
import Submission.RootMeanHensel

/-!
# Uniform finite local inverses for ideal norm coefficients

The explicitly defined ideal-norm Möbius inverse vanishes at `p^k` for
`k > [K : ℚ]`, and its absolute value is at most `2^[K : ℚ]`, at every
rational prime, including ramified primes. Its local polynomial is exactly
`∏ P | p, (1 - X ^ residueDegree P)`. In fact the total absolute local mass
is at most `2^[K : ℚ]`. These are unconditional number-field lemmas, not
hypotheses on a putative Euler correction.

For `h = b * ρ`, these estimates give `‖h(p^k)‖ ≤ 2^[K : ℚ] * C` whenever
`‖ρ(p^j)‖ ≤ C` for all `j`. The file specializes this to the good-prime
Hensel/degree bound and to the unconditional resultant-valuation bound at
arbitrary primes for nonconstant irreducible integer polynomials. The
Kummer--Dedekind prime-coefficient match supplies first-order cancellation.
No summability, general polynomial mean, or balanced divisor-sum theorem
is assumed or claimed here.
-/

namespace Erdos975Support

open Polynomial NumberField Ideal UniqueFactorizationMonoid
open scoped nonZeroDivisors

namespace IdealEuler

variable (K : Type*) [Field K] [NumberField K]

/-- The principal ideal generated by a rational integer has the expected norm. -/
theorem absNorm_span_natCast (p : ℕ) :
    absNorm (Ideal.span {(p : 𝓞 K)}) = p ^ Module.finrank ℚ K := by
  rw [Ideal.absNorm_span_singleton]
  have hnorm : Algebra.norm ℤ (p : 𝓞 K) = (p : ℤ) ^ Module.finrank ℤ (𝓞 K) := by
    simpa only [map_natCast, ← Module.finrank_eq_card_basis
      (Module.Free.chooseBasis ℤ (𝓞 K))] using
      Algebra.norm_algebraMap_of_basis (Module.Free.chooseBasis ℤ (𝓞 K)) (p : ℤ)
  rw [hnorm, Int.natAbs_pow, Int.natAbs_natCast, RingOfIntegers.rank]

/-- The finite set of prime ideals above a rational integer. -/
noncomputable def primesAbove (p : ℕ) : Finset (Ideal (𝓞 K)) :=
  primesOverFinset (Ideal.span {(p : ℤ)}) (𝓞 K)

open Classical in
/-- This set is exactly the set of distinct prime factors of `(p)`. -/
theorem primesAbove_eq_factors_span (p : ℕ) :
    primesAbove K p = (normalizedFactors (Ideal.span {(p : 𝓞 K)})).toFinset := by
  simp [primesAbove, primesOverFinset, Ideal.map_span, factors_eq_normalizedFactors]

/-- Even at a ramified prime, there are at most `[K : ℚ]` primes above it. -/
theorem card_primesAbove_le (p : ℕ) (hp : p.Prime) :
    (primesAbove K p).card ≤ Module.finrank ℚ K := by
  letI : Fact p.Prime := ⟨hp⟩
  have hp0 : (Ideal.span {(p : ℤ)} : Ideal ℤ) ≠ ⊥ := by
    simpa only [ne_eq, Ideal.span_singleton_eq_bot, Int.natCast_eq_zero] using hp.ne_zero
  exact Ideal.card_primesOverFinset_le_finrank (𝓞 K) ℚ K hp0

variable {K}

/-- The scalar absolute norm belongs to the ideal. -/
theorem absNorm_natCast_mem (I : Ideal (𝓞 K)) : (absNorm I : 𝓞 K) ∈ I := by
  rw [← Int.cast_natCast, Int.cast_mem_ideal_iff, Int.natCast_dvd_natCast]
  exact Int.absNorm_under_dvd_absNorm I

/-- A squarefree ideal of prime-power norm divides `(p)`, not merely `(p^k)`. -/
theorem squarefree_dvd_span_of_absNorm_primePow {I : Ideal (𝓞 K)} (hs : Squarefree I)
    {p k : ℕ} (hI : absNorm I = p ^ k) : I ∣ Ideal.span {(p : 𝓞 K)} := by
  by_cases hk : k = 0
  · have hI1 : I = 1 := by
      rw [hk, pow_zero, Ideal.absNorm_eq_one_iff] at hI
      simpa only [Ideal.one_eq_top] using hI
    rw [hI1]
    exact one_dvd _
  · apply (hs.dvd_pow_iff_dvd hk).mp
    rw [Ideal.span_singleton_pow, ← Nat.cast_pow, ← hI]
    exact Ideal.dvd_span_singleton.mpr (absNorm_natCast_mem I)

variable (K)

/-- A squarefree ideal of norm `p^k` has `k ≤ [K : ℚ]`. -/
theorem squarefree_primePow_exponent_le {I : Ideal (𝓞 K)} (hs : Squarefree I)
    {p k : ℕ} (hp : p.Prime) (hI : absNorm I = p ^ k) : k ≤ Module.finrank ℚ K := by
  have hdvd := map_dvd absNorm (squarefree_dvd_span_of_absNorm_primePow hs hI)
  rw [hI, absNorm_span_natCast] at hdvd
  exact (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd

open Classical in
/-- Every squarefree prime-power norm fiber embeds into the prime-factor powerset. -/
theorem card_squarefree_normFiber_primePow_le (p : ℕ) (hp : p.Prime) (k : ℕ) :
    ((normFiber K (p ^ k)).filter (fun (I : (Ideal (𝓞 K))⁰) ↦ Squarefree (I : Ideal (𝓞 K)))).card ≤
      2 ^ Module.finrank ℚ K := by
  classical
  have hp0 : (Ideal.span {(p : 𝓞 K)} : Ideal (𝓞 K)) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact Nat.cast_ne_zero.mpr hp.ne_zero
  have hcard :
      ((normFiber K (p ^ k)).filter (fun (I : (Ideal (𝓞 K))⁰) ↦ Squarefree (I : Ideal (𝓞 K)))).card ≤
        (primesAbove K p).powerset.card := by
    refine Finset.card_le_card_of_injOn
      (fun I : (Ideal (𝓞 K))⁰ ↦ (normalizedFactors (I : Ideal (𝓞 K))).toFinset)
      ?_ ?_
    · intro I hI
      rw [Finset.mem_coe, Finset.mem_filter] at hI
      rw [Finset.mem_coe, Finset.mem_powerset, primesAbove_eq_factors_span]
      exact Multiset.toFinset_subset.mpr (Multiset.subset_of_le
        ((dvd_iff_normalizedFactors_le_normalizedFactors
          (nonZeroDivisors.coe_ne_zero I) hp0).mp
          (squarefree_dvd_span_of_absNorm_primePow hI.2 ((mem_normFiber K).mp hI.1))))
    · intro I hI J hJ h
      rw [Finset.mem_coe, Finset.mem_filter] at hI hJ
      exact Subtype.ext (eq_of_squarefree_factors_eq
        (nonZeroDivisors.coe_ne_zero I) (nonZeroDivisors.coe_ne_zero J) hI.2 hJ.2 h)
  calc
    _ ≤ (primesAbove K p).powerset.card := hcard
    _ = 2 ^ (primesAbove K p).card := Finset.card_powerset _
    _ ≤ 2 ^ Module.finrank ℚ K := Nat.pow_le_pow_right (by decide) (card_primesAbove_le K p hp)

end IdealEuler

/-- The actual integer inverse is supported in local degrees at most `[K : ℚ]`. -/
theorem idealNormMobiusIntegerCoefficients_primePow_eq_zero
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ)
    (hk : Module.finrank ℚ K < k) : idealNormMobiusIntegerCoefficients K (p ^ k) = 0 := by
  classical
  rw [idealNormMobiusIntegerCoefficients, IdealEuler.normCoeff_apply]
  refine Finset.sum_eq_zero fun I hI ↦ ?_
  apply idealMobius_of_not_squarefree
  intro hs
  exact (not_le_of_gt hk) (IdealEuler.squarefree_primePow_exponent_le K hs hp
    ((IdealEuler.mem_normFiber K).mp hI))

/-- The real inverse has the same unconditional finite local support. -/
theorem idealNormMobiusCoefficients_primePow_eq_zero
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ)
    (hk : Module.finrank ℚ K < k) : idealNormMobiusCoefficients K (p ^ k) = 0 := by
  simp [idealNormMobiusCoefficients,
    idealNormMobiusIntegerCoefficients_primePow_eq_zero K p hp k hk]

/-- The integer local inverse bound, uniform in both the rational prime and exponent. -/
theorem abs_idealNormMobiusIntegerCoefficients_primePow_le
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ) :
    |idealNormMobiusIntegerCoefficients K (p ^ k)| ≤ (2 : ℤ) ^ Module.finrank ℚ K := by
  classical
  rw [idealNormMobiusIntegerCoefficients, IdealEuler.normCoeff_apply,
    ← Finset.sum_filter_of_ne
      (p := fun I : (Ideal (𝓞 K))⁰ ↦ Squarefree (I : Ideal (𝓞 K)))
      (fun I _ hI ↦ by
        by_contra h
        exact hI (idealMobius_of_not_squarefree h))]
  calc
    |∑ I ∈ (IdealEuler.normFiber K (p ^ k)).filter
        (fun (I : (Ideal (𝓞 K))⁰) ↦ Squarefree (I : Ideal (𝓞 K))), idealMobius (I : Ideal (𝓞 K))| ≤
        ∑ I ∈ (IdealEuler.normFiber K (p ^ k)).filter
          (fun (I : (Ideal (𝓞 K))⁰) ↦ Squarefree (I : Ideal (𝓞 K))), |idealMobius (I : Ideal (𝓞 K))| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _I ∈ (IdealEuler.normFiber K (p ^ k)).filter
        (fun (I : (Ideal (𝓞 K))⁰) ↦ Squarefree (I : Ideal (𝓞 K))), (1 : ℤ) :=
      Finset.sum_le_sum fun I _ ↦ abs_idealMobius_le_one _
    _ = (((IdealEuler.normFiber K (p ^ k)).filter
        (fun (I : (Ideal (𝓞 K))⁰) ↦ Squarefree (I : Ideal (𝓞 K)))).card : ℤ) := by simp
    _ ≤ (2 : ℤ) ^ Module.finrank ℚ K := by
      exact_mod_cast IdealEuler.card_squarefree_normFiber_primePow_le K p hp k

/-- The real local inverse bound, with no unramified-prime assumption. -/
theorem abs_idealNormMobiusCoefficients_primePow_le
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ) :
    |idealNormMobiusCoefficients K (p ^ k)| ≤ (2 : ℝ) ^ Module.finrank ℚ K := by
  change |(idealNormMobiusIntegerCoefficients K (p ^ k) : ℝ)| ≤ _
  exact_mod_cast abs_idealNormMobiusIntegerCoefficients_primePow_le K p hp k

theorem norm_idealNormMobiusCoefficients_primePow_le
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ) :
    ‖idealNormMobiusCoefficients K (p ^ k)‖ ≤ (2 : ℝ) ^ Module.finrank ℚ K := by
  rw [Real.norm_eq_abs]
  exact abs_idealNormMobiusCoefficients_primePow_le K p hp k

namespace IdealEuler

variable (K : Type*) [Field K] [NumberField K]

/-- The squarefree part of a finite ideal norm fiber. -/
noncomputable def squarefreeNormFiber (n : ℕ) : Finset ((Ideal (𝓞 K))⁰) := by
  classical
  exact (normFiber K n).filter (fun I ↦ Squarefree (I : Ideal (𝓞 K)))

@[simp]
theorem mem_squarefreeNormFiber {I : (Ideal (𝓞 K))⁰} {n : ℕ} :
    I ∈ squarefreeNormFiber K n ↔ absNorm (I : Ideal (𝓞 K)) = n ∧
      Squarefree (I : Ideal (𝓞 K)) := by
  classical
  simp [squarefreeNormFiber]

/-- The squarefree fibers at different powers of one prime are disjoint;
collectively they still inject into the single prime-ideal powerset. -/
theorem card_squarefree_primePow_fibers_le (p : ℕ) (hp : p.Prime) (k : ℕ) :
    ((Finset.range (k + 1)).sigma (fun i ↦ squarefreeNormFiber K (p ^ i))).card ≤
      2 ^ Module.finrank ℚ K := by
  classical
  have hp0 : (Ideal.span {(p : 𝓞 K)} : Ideal (𝓞 K)) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact Nat.cast_ne_zero.mpr hp.ne_zero
  have hcard :
      ((Finset.range (k + 1)).sigma (fun i ↦ squarefreeNormFiber K (p ^ i))).card ≤
        (primesAbove K p).powerset.card := by
    refine Finset.card_le_card_of_injOn
      (fun q : Σ _i : ℕ, (Ideal (𝓞 K))⁰ ↦
        (normalizedFactors (q.2 : Ideal (𝓞 K))).toFinset) ?_ ?_
    · intro q hq
      rw [Finset.mem_coe, Finset.mem_sigma, mem_squarefreeNormFiber] at hq
      rw [Finset.mem_coe, Finset.mem_powerset, primesAbove_eq_factors_span]
      exact Multiset.toFinset_subset.mpr (Multiset.subset_of_le
        ((dvd_iff_normalizedFactors_le_normalizedFactors
          (nonZeroDivisors.coe_ne_zero q.2) hp0).mp
          (squarefree_dvd_span_of_absNorm_primePow hq.2.2 hq.2.1)))
    · intro q hq r hr h
      rw [Finset.mem_coe, Finset.mem_sigma, mem_squarefreeNormFiber] at hq hr
      have hI : q.2 = r.2 := Subtype.ext (eq_of_squarefree_factors_eq
        (nonZeroDivisors.coe_ne_zero q.2) (nonZeroDivisors.coe_ne_zero r.2)
        hq.2.2 hr.2.2 h)
      have hi : q.1 = r.1 := Nat.pow_right_injective hp.two_le (by
        change p ^ q.1 = p ^ r.1
        rw [← hq.2.1, ← hr.2.1, hI])
      exact Sigma.ext hi (heq_of_eq hI)
  calc
    _ ≤ (primesAbove K p).powerset.card := hcard
    _ = 2 ^ (primesAbove K p).card := Finset.card_powerset _
    _ ≤ 2 ^ Module.finrank ℚ K := Nat.pow_le_pow_right (by decide) (card_primesAbove_le K p hp)

end IdealEuler

/-- Cancellation inside one fiber can only reduce its absolute Möbius mass. -/
theorem abs_idealNormMobiusIntegerCoefficients_le_card_squarefreeNormFiber
    (K : Type*) [Field K] [NumberField K] (n : ℕ) :
    |idealNormMobiusIntegerCoefficients K n| ≤
      ((IdealEuler.squarefreeNormFiber K n).card : ℤ) := by
  classical
  rw [idealNormMobiusIntegerCoefficients, IdealEuler.normCoeff_apply,
    ← Finset.sum_filter_of_ne
      (p := fun I : (Ideal (𝓞 K))⁰ ↦ Squarefree (I : Ideal (𝓞 K)))
      (fun I _ hI ↦ by
        by_contra h
        exact hI (idealMobius_of_not_squarefree h))]
  change |∑ I ∈ IdealEuler.squarefreeNormFiber K n, idealMobius (I : Ideal (𝓞 K))| ≤ _
  calc
    _ ≤ ∑ I ∈ IdealEuler.squarefreeNormFiber K n, |idealMobius (I : Ideal (𝓞 K))| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _I ∈ IdealEuler.squarefreeNormFiber K n, (1 : ℤ) :=
      Finset.sum_le_sum fun I _ ↦ abs_idealMobius_le_one _
    _ = _ := by simp

/-- A stronger local bound: the total absolute mass of the inverse Euler
polynomial is at most `2^[K : ℚ]`, uniformly at every prime. -/
theorem sum_norm_idealNormMobiusCoefficients_primePow_le
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ) :
    (∑ i ∈ Finset.range (k + 1), ‖idealNormMobiusCoefficients K (p ^ i)‖) ≤
      (2 : ℝ) ^ Module.finrank ℚ K := by
  have hbound (i : ℕ) : ‖idealNormMobiusCoefficients K (p ^ i)‖ ≤
      ((IdealEuler.squarefreeNormFiber K (p ^ i)).card : ℝ) := by
    rw [Real.norm_eq_abs]
    change |(idealNormMobiusIntegerCoefficients K (p ^ i) : ℝ)| ≤ _
    exact_mod_cast abs_idealNormMobiusIntegerCoefficients_le_card_squarefreeNormFiber K (p ^ i)
  calc
    _ ≤ ∑ i ∈ Finset.range (k + 1), ((IdealEuler.squarefreeNormFiber K (p ^ i)).card : ℝ) :=
      Finset.sum_le_sum fun i _ ↦ hbound i
    _ = (((Finset.range (k + 1)).sigma
        (fun i ↦ IdealEuler.squarefreeNormFiber K (p ^ i))).card : ℝ) := by
      rw [← Nat.cast_sum, ← Finset.card_sigma]
    _ ≤ _ := by exact_mod_cast IdealEuler.card_squarefree_primePow_fibers_le K p hp k

/-- The correction attached to an arbitrary real arithmetic function. -/
noncomputable def idealEulerCorrection (K : Type*) [Field K] [NumberField K]
    (ρ : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  idealNormMobiusCoefficients K * ρ

/-- No existence hypothesis is needed to deconvolve the ideal coefficients. -/
@[simp]
theorem idealNormCoefficients_mul_idealEulerCorrection
    (K : Type*) [Field K] [NumberField K] (ρ : ArithmeticFunction ℝ) :
    idealNormCoefficients K * idealEulerCorrection K ρ = ρ := by
  rw [idealEulerCorrection, ← mul_assoc,
    idealNormCoefficients_mul_idealNormMobiusCoefficients, one_mul]

@[simp]
theorem idealEulerCorrection_one (K : Type*) [Field K] [NumberField K]
    (ρ : ArithmeticFunction ℝ) : idealEulerCorrection K ρ 1 = ρ 1 := by
  simp [idealEulerCorrection]

theorem isMultiplicative_idealEulerCorrection (K : Type*) [Field K] [NumberField K]
    (ρ : ArithmeticFunction ℝ) (hρ : ρ.IsMultiplicative) :
    (idealEulerCorrection K ρ).IsMultiplicative :=
  (isMultiplicative_idealNormMobiusCoefficients K).mul hρ

/-- A bound on all local values of `ρ` gives a bound independent of the
prime-power exponent for the actual correction, using the proved inverse mass. -/
theorem norm_idealEulerCorrection_primePow_le
    (K : Type*) [Field K] [NumberField K] (ρ : ArithmeticFunction ℝ)
    (p : ℕ) (hp : p.Prime) (C : ℝ)
    (hρ : ∀ j : ℕ, ‖ρ (p ^ j)‖ ≤ C) (k : ℕ) :
    ‖idealEulerCorrection K ρ (p ^ k)‖ ≤ (2 : ℝ) ^ Module.finrank ℚ K * C := by
  have hC : 0 ≤ C := (norm_nonneg _).trans (hρ 0)
  rw [idealEulerCorrection, ArithmeticFunction.mul_apply,
    Nat.sum_divisorsAntidiagonal (fun a b ↦ idealNormMobiusCoefficients K a * ρ b),
    Nat.sum_divisors_prime_pow hp]
  calc
    _ ≤ ∑ i ∈ Finset.range (k + 1),
        ‖idealNormMobiusCoefficients K (p ^ i) * ρ (p ^ k / p ^ i)‖ := norm_sum_le _ _
    _ ≤ ∑ i ∈ Finset.range (k + 1), ‖idealNormMobiusCoefficients K (p ^ i)‖ * C := by
      refine Finset.sum_le_sum fun i hi ↦ ?_
      rw [norm_mul, Nat.pow_div (Nat.le_of_lt_succ (Finset.mem_range.mp hi)) hp.pos]
      exact mul_le_mul_of_nonneg_left (hρ _) (norm_nonneg _)
    _ = (∑ i ∈ Finset.range (k + 1), ‖idealNormMobiusCoefficients K (p ^ i)‖) * C :=
      (Finset.sum_mul _ _ _).symm
    _ ≤ (2 : ℝ) ^ Module.finrank ℚ K * C := mul_le_mul_of_nonneg_right
      (sum_norm_idealNormMobiusCoefficients_primePow_le K p hp k) hC

/-- Polynomial root coefficients are multiplicative, as supplied by the CRT. -/
theorem isMultiplicative_polynomialRootCoefficients (f : ℤ[X]) :
    (polynomialRootCoefficients f).IsMultiplicative := by
  refine ⟨by simp [polynomialRootCoefficients], ?_⟩
  intro m n hmn
  change (rootCount (polynomialAbsValue f) (m * n) : ℝ) =
    (rootCount (polynomialAbsValue f) m : ℝ) * (rootCount (polynomialAbsValue f) n : ℝ)
  exact_mod_cast rootCount_polynomial_mul f hmn

@[simp]
theorem polynomialRootCoefficients_one (f : ℤ[X]) : polynomialRootCoefficients f 1 = 1 := by
  simp [polynomialRootCoefficients]

theorem isMultiplicative_idealEulerCorrection_polynomial
    (K : Type*) [Field K] [NumberField K] (f : ℤ[X]) :
    (idealEulerCorrection K (polynomialRootCoefficients f)).IsMultiplicative :=
  isMultiplicative_idealEulerCorrection K _ (isMultiplicative_polynomialRootCoefficients f)

namespace IdealEuler

/-- The two divisor terms at a rational prime. -/
theorem dirichlet_mul_apply_prime (a b : ArithmeticFunction ℝ) (p : ℕ) (hp : p.Prime) :
    (a * b) p = a 1 * b p + a p * b 1 := by
  rw [ArithmeticFunction.mul_apply, Nat.sum_divisorsAntidiagonal (fun m n ↦ a m * b n)]
  have hsum := Nat.sum_divisors_prime_pow (k := 1) (f := fun d ↦ a d * b (p / d)) hp
  simp only [pow_one] at hsum
  rw [hsum]
  simp [Finset.sum_range_succ, Nat.div_self hp.pos]

end IdealEuler

/-- The first inverse coefficient is the negative of the ideal prime coefficient. -/
theorem idealNormMobiusCoefficients_prime (K : Type*) [Field K] [NumberField K]
    (p : ℕ) (hp : p.Prime) :
    idealNormMobiusCoefficients K p = - idealNormCoefficients K p := by
  have h := congrArg (fun a : ArithmeticFunction ℝ ↦ a p)
    (idealNormMobiusCoefficients_mul_idealNormCoefficients K)
  change (idealNormMobiusCoefficients K * idealNormCoefficients K) p =
    (1 : ArithmeticFunction ℝ) p at h
  rw [IdealEuler.dirichlet_mul_apply_prime _ _ p hp] at h
  simp only [idealNormMobiusCoefficients_one, idealNormCoefficients_one,
    one_mul, mul_one, ArithmeticFunction.one_apply, if_neg hp.ne_one] at h
  linarith

/-- The correction at a prime is the coefficient discrepancy. -/
theorem idealEulerCorrection_prime (K : Type*) [Field K] [NumberField K]
    (ρ : ArithmeticFunction ℝ) (hρ1 : ρ 1 = 1) (p : ℕ) (hp : p.Prime) :
    idealEulerCorrection K ρ p = ρ p - idealNormCoefficients K p := by
  rw [idealEulerCorrection, IdealEuler.dirichlet_mul_apply_prime _ _ p hp,
    idealNormMobiusCoefficients_one, idealNormMobiusCoefficients_prime K p hp, hρ1]
  ring

/-- Prime coefficients cancel whenever the root and ideal coefficients agree. -/
theorem idealEulerCorrection_prime_eq_zero_of_agree
    (K : Type*) [Field K] [NumberField K] (ρ : ArithmeticFunction ℝ)
    (hρ1 : ρ 1 = 1) (p : ℕ) (hp : p.Prime)
    (hρp : ρ p = idealNormCoefficients K p) : idealEulerCorrection K ρ p = 0 := by
  rw [idealEulerCorrection_prime K ρ hρ1 p hp, hρp, sub_self]

/-- Kummer--Dedekind supplies the required cancellation, not an assumed match. -/
theorem idealEulerCorrection_minpoly_prime_eq_zero
    (K : Type*) [Field K] [NumberField K] (θ : 𝓞 K) (p : ℕ) [Fact p.Prime]
    (hp : ¬ p ∣ RingOfIntegers.exponent θ) :
    idealEulerCorrection K (polynomialRootCoefficients (minpoly ℤ θ)) p = 0 :=
  idealEulerCorrection_prime_eq_zero_of_agree K _ (polynomialRootCoefficients_one _)
    p Fact.out (polynomialRootCoefficients_minpoly_prime K θ p hp)

/-- The requested uniform good-prime estimate. Only the actual local behavior
of `ρ` is hypothesized; the finite-support and mass bounds for the inverse
have already been proved unconditionally above. -/
theorem norm_idealEulerCorrection_primePow_le_of_constant
    (K : Type*) [Field K] [NumberField K] (ρ : ArithmeticFunction ℝ)
    (hρ1 : ρ 1 = 1) (p : ℕ) (hp : p.Prime)
    (hρpow : ∀ j : ℕ, 1 ≤ j → ρ (p ^ j) = ρ p)
    (hρp : ‖ρ p‖ ≤ (Module.finrank ℚ K : ℝ)) (k : ℕ) :
    ‖idealEulerCorrection K ρ (p ^ k)‖ ≤
      ((Module.finrank ℚ K : ℝ) + 1) * (2 : ℝ) ^ Module.finrank ℚ K := by
  have hρall (j : ℕ) : ‖ρ (p ^ j)‖ ≤ (Module.finrank ℚ K : ℝ) := by
    by_cases hj : j = 0
    · simp only [hj, pow_zero, hρ1, norm_one]
      exact_mod_cast (Module.finrank_pos (R := ℚ) (M := K))
    · rw [hρpow j (Nat.one_le_iff_ne_zero.mpr hj)]
      exact hρp
  calc
    _ ≤ (2 : ℝ) ^ Module.finrank ℚ K * (Module.finrank ℚ K : ℝ) :=
      norm_idealEulerCorrection_primePow_le K ρ p hp _ hρall k
    _ ≤ ((Module.finrank ℚ K : ℝ) + 1) * (2 : ℝ) ^ Module.finrank ℚ K := by
      nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) (Module.finrank ℚ K)]

/-- Good-prime Hensel lifting and the degree bound give an exponent-uniform
bound for the actual polynomial correction. -/
theorem norm_idealEulerCorrection_polynomial_primePow_le_of_simple
    (K : Type*) [Field K] [NumberField K] (f : ℤ[X]) (hf : f.IsPrimitive)
    (hdeg : f.natDegree ≤ Module.finrank ℚ K) (p : ℕ) (hp : p.Prime)
    (hs : PolynomialSimpleRootsMod f p) (k : ℕ) :
    ‖idealEulerCorrection K (polynomialRootCoefficients f) (p ^ k)‖ ≤
      ((Module.finrank ℚ K : ℝ) + 1) * (2 : ℝ) ^ Module.finrank ℚ K := by
  apply norm_idealEulerCorrection_primePow_le_of_constant K _
    (polynomialRootCoefficients_one f) p hp _ _ k
  · intro j hj
    change (rootCount (polynomialAbsValue f) (p ^ j) : ℝ) =
      (rootCount (polynomialAbsValue f) p : ℝ)
    exact_mod_cast rootCount_polynomial_prime_pow_eq f p hp hs j hj
  · change ‖(rootCount (polynomialAbsValue f) p : ℝ)‖ ≤ (Module.finrank ℚ K : ℝ)
    rw [Real.norm_natCast]
    exact_mod_cast (rootCount_polynomial_prime_le f hf p hp).trans hdeg

/-- The arbitrary-prime resultant/Hensel bound gives a genuine exponent-uniform
bound at every bad prime too. The local inverse bound is not an extra hypothesis. -/
theorem norm_idealEulerCorrection_irreducible_primePow_le_resultant_valuation
    (K : Type*) [Field K] [NumberField K] (f : ℤ[X]) (hf : Irreducible f)
    (hdeg : f.natDegree ≠ 0) (p : ℕ) (hp : p.Prime) (k : ℕ) :
    ‖idealEulerCorrection K (polynomialRootCoefficients f) (p ^ k)‖ ≤
      (2 : ℝ) ^ Module.finrank ℚ K *
        (p : ℝ) ^ (2 * padicValInt p (f.resultant f.derivative) + 1) := by
  apply norm_idealEulerCorrection_primePow_le K _ p hp _ _ k
  intro j
  change ‖(rootCount (polynomialAbsValue f) (p ^ j) : ℝ)‖ ≤ _
  rw [Real.norm_natCast]
  exact_mod_cast rootCount_irreducible_polynomial_prime_pow_le_resultant_valuation
    f hf hdeg p hp j

namespace IdealEuler

variable (K : Type*) [Field K] [NumberField K]

/-- The ideal-monoid primality of each prime above `p`. -/
theorem prime_of_mem_primesAbove (p : ℕ) {P : Ideal (𝓞 K)} (hP : P ∈ primesAbove K p) :
    Prime P := by
  classical
  rw [primesAbove_eq_factors_span, Multiset.mem_toFinset] at hP
  exact prime_of_normalized_factor P hP

/-- A product of a subset of the primes above `p` is nonzero. -/
theorem subset_primesAbove_prod_ne_zero (p : ℕ) (S : Finset (Ideal (𝓞 K)))
    (hS : S ⊆ primesAbove K p) : S.val.prod ≠ 0 :=
  Multiset.prod_ne_zero (by
    intro h
    exact (prime_of_mem_primesAbove K p (hS (Finset.mem_val.mp h))).ne_zero rfl)

/-- Its normalized factors are exactly the selected primes, each occurring once. -/
theorem normalizedFactors_subset_primesAbove_prod (p : ℕ) (S : Finset (Ideal (𝓞 K)))
    (hS : S ⊆ primesAbove K p) : normalizedFactors S.val.prod = S.val :=
  normalizedFactors_prod_of_prime (fun _ hP ↦
    prime_of_mem_primesAbove K p (hS (Finset.mem_val.mp hP)))

/-- Products of distinct primes above `p` are squarefree. -/
theorem squarefree_subset_primesAbove_prod (p : ℕ) (S : Finset (Ideal (𝓞 K)))
    (hS : S ⊆ primesAbove K p) : Squarefree S.val.prod := by
  rw [squarefree_iff_nodup_normalizedFactors (subset_primesAbove_prod_ne_zero K p S hS),
    normalizedFactors_subset_primesAbove_prod K p S hS]
  exact S.nodup

/-- The norm exponent of such a subset product is the sum of its residue degrees. -/
theorem absNorm_subset_primesAbove_prod (p : ℕ) (hp : p.Prime) (S : Finset (Ideal (𝓞 K)))
    (hS : S ⊆ primesAbove K p) :
    absNorm S.val.prod = p ^ (∑ P ∈ S, (Ideal.span {(p : ℤ)}).inertiaDeg P) := by
  letI : Fact p.Prime := ⟨hp⟩
  have hp0 : (Ideal.span {(p : ℤ)} : Ideal ℤ) ≠ ⊥ := by
    simpa only [ne_eq, Ideal.span_singleton_eq_bot, Int.natCast_eq_zero] using hp.ne_zero
  have hnorm (P : Ideal (𝓞 K)) (hP : P ∈ S) :
      absNorm P = p ^ (Ideal.span {(p : ℤ)}).inertiaDeg P := by
    have hOver := ((mem_primesOverFinset_iff hp0 (𝓞 K)).mp (hS hP)).2
    letI : P.LiesOver (Ideal.span {(p : ℤ)}) := hOver
    exact Ideal.absNorm_eq_pow_inertiaDeg' P hp
  calc
    absNorm S.val.prod = ∏ P ∈ S, absNorm P := by
      rw [map_multiset_prod, Finset.prod_eq_multiset_prod]
    _ = ∏ P ∈ S, p ^ (Ideal.span {(p : ℤ)}).inertiaDeg P := Finset.prod_congr rfl hnorm
    _ = _ := Finset.prod_pow_eq_pow_sum _ _ _

end IdealEuler

/-- The explicit polynomial inverse Euler factor at a rational prime. Its
exponents are residue degrees; ramification indices are deliberately absent. -/
noncomputable def idealNormMobiusLocalPolynomial
    (K : Type*) [Field K] [NumberField K] (p : ℕ) : ℤ[X] :=
  ∏ P ∈ IdealEuler.primesAbove K p,
    (1 - X ^ (Ideal.span {(p : ℤ)}).inertiaDeg P)

/-- Expanding the local inverse product selects subsets of primes above `p`. -/
theorem idealNormMobiusLocalPolynomial_eq_sum_subsets
    (K : Type*) [Field K] [NumberField K] (p : ℕ) :
    idealNormMobiusLocalPolynomial K p =
      ∑ S ∈ (IdealEuler.primesAbove K p).powerset,
        C ((-1 : ℤ) ^ S.card) * X ^ (∑ P ∈ S, (Ideal.span {(p : ℤ)}).inertiaDeg P) := by
  classical
  rw [idealNormMobiusLocalPolynomial]
  simp_rw [sub_eq_add_neg]
  rw [Finset.prod_one_add]
  refine Finset.sum_congr rfl fun S _ ↦ ?_
  rw [Finset.prod_neg, Finset.prod_pow_eq_pow_sum]
  simp

/-- The actual norm-fiber inverse coefficient is exactly the coefficient of
`∏_{P | p} (1 - X ^ f(P))`. This includes ramified rational primes. -/
theorem idealNormMobiusLocalPolynomial_coeff
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ) :
    (idealNormMobiusLocalPolynomial K p).coeff k =
      idealNormMobiusIntegerCoefficients K (p ^ k) := by
  classical
  rw [idealNormMobiusLocalPolynomial_eq_sum_subsets, Polynomial.finset_sum_coeff]
  simp_rw [Polynomial.coeff_C_mul_X_pow]
  rw [← Finset.sum_filter]
  rw [idealNormMobiusIntegerCoefficients, IdealEuler.normCoeff_apply,
    ← Finset.sum_filter_of_ne
      (p := fun I : (Ideal (𝓞 K))⁰ ↦ Squarefree (I : Ideal (𝓞 K)))
      (fun I _ hI ↦ by
        by_contra h
        exact hI (idealMobius_of_not_squarefree h))]
  change (∑ S ∈ (IdealEuler.primesAbove K p).powerset.filter
      (fun S ↦ k = ∑ P ∈ S, (Ideal.span {(p : ℤ)}).inertiaDeg P), (-1 : ℤ) ^ S.card) =
    ∑ I ∈ IdealEuler.squarefreeNormFiber K (p ^ k), idealMobius (I : Ideal (𝓞 K))
  refine Finset.sum_bij
    (fun S hS ↦ (⟨S.val.prod, mem_nonZeroDivisors_of_ne_zero
      (IdealEuler.subset_primesAbove_prod_ne_zero K p S
        (Finset.mem_powerset.mp (Finset.mem_filter.mp hS).1))⟩ : (Ideal (𝓞 K))⁰))
    ?_ ?_ ?_ ?_
  · intro S hS
    rw [Finset.mem_filter, Finset.mem_powerset] at hS
    rw [IdealEuler.mem_squarefreeNormFiber]
    refine ⟨?_, IdealEuler.squarefree_subset_primesAbove_prod K p S hS.1⟩
    change absNorm S.val.prod = p ^ k
    rw [IdealEuler.absNorm_subset_primesAbove_prod K p hp S hS.1, ← hS.2]
  · intro S hS T hT h
    have hS' := Finset.mem_powerset.mp (Finset.mem_filter.mp hS).1
    have hT' := Finset.mem_powerset.mp (Finset.mem_filter.mp hT).1
    have hprod : S.val.prod = T.val.prod := congrArg Subtype.val h
    have hfac := congrArg normalizedFactors hprod
    rw [IdealEuler.normalizedFactors_subset_primesAbove_prod K p S hS',
      IdealEuler.normalizedFactors_subset_primesAbove_prod K p T hT'] at hfac
    exact Finset.val_injective hfac
  · intro I hI
    rw [IdealEuler.mem_squarefreeNormFiber] at hI
    let S := (normalizedFactors (I : Ideal (𝓞 K))).toFinset
    have hI0 : (I : Ideal (𝓞 K)) ≠ 0 := nonZeroDivisors.coe_ne_zero I
    have hp0 : (Ideal.span {(p : 𝓞 K)} : Ideal (𝓞 K)) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact Nat.cast_ne_zero.mpr hp.ne_zero
    have hS : S ⊆ IdealEuler.primesAbove K p := by
      rw [IdealEuler.primesAbove_eq_factors_span]
      exact Multiset.toFinset_subset.mpr (Multiset.subset_of_le
        ((dvd_iff_normalizedFactors_le_normalizedFactors hI0 hp0).mp
          (IdealEuler.squarefree_dvd_span_of_absNorm_primePow hI.2 hI.1)))
    have hprod : S.val.prod = (I : Ideal (𝓞 K)) := by
      dsimp [S]
      rw [((squarefree_iff_nodup_normalizedFactors hI0).mp hI.2).dedup]
      exact associated_iff_eq.mp (prod_normalizedFactors hI0)
    have hsum : k = ∑ P ∈ S, (Ideal.span {(p : ℤ)}).inertiaDeg P := by
      apply (Nat.pow_right_inj hp.one_lt).mp
      calc
        p ^ k = absNorm (I : Ideal (𝓞 K)) := hI.1.symm
        _ = absNorm S.val.prod := congrArg absNorm hprod.symm
        _ = _ := IdealEuler.absNorm_subset_primesAbove_prod K p hp S hS
    exact ⟨S, Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hS, hsum⟩, Subtype.ext hprod⟩
  · intro S hS
    have hS' := Finset.mem_powerset.mp (Finset.mem_filter.mp hS).1
    change (-1 : ℤ) ^ S.card = idealMobius S.val.prod
    rw [idealMobius_of_squarefree (IdealEuler.squarefree_subset_primesAbove_prod K p S hS'),
      IdealEuler.normalizedFactors_subset_primesAbove_prod K p S hS']
    rfl

/-- The inverse Euler polynomial has degree at most the number-field degree. -/
theorem idealNormMobiusLocalPolynomial_natDegree_le
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) :
    (idealNormMobiusLocalPolynomial K p).natDegree ≤ Module.finrank ℚ K := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [idealNormMobiusLocalPolynomial_coeff K p hp k]
  exact idealNormMobiusIntegerCoefficients_primePow_eq_zero K p hp k hk

/-- The corresponding exact coefficient formula for the real inverse. -/
theorem idealNormMobiusCoefficients_primePow_eq_localPolynomial_coeff
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) (k : ℕ) :
    idealNormMobiusCoefficients K (p ^ k) =
      ((idealNormMobiusLocalPolynomial K p).coeff k : ℝ) := by
  change (idealNormMobiusIntegerCoefficients K (p ^ k) : ℝ) = _
  rw [idealNormMobiusLocalPolynomial_coeff K p hp k]

end Erdos975Support
