def c4 (x : Nat) := x*(x+1)*(x+2)*(x+3)/24
def c6 (y : Nat) := y*(y+1)*(y+2)*(y+3)*(y+4)*(y+5)/720
def c8 (z : Nat) := z*(z+1)*(z+2)*(z+3)*(z+4)*(z+5)*(z+6)*(z+7)/40320

def fullMask : Nat := 

def masksFor (b : Nat) : Array Nat := (List.range primes.size).toArray.map fun i =>
  let p := primes[i]!
  (rejectMasks[i]!).getD (b % p) 0

def coverMask (b : Nat) : Nat := (masksFor b).foldl (· ||| ·) 0

def coverPair (k : Nat) : Bool :=
  let y := k % 928
  let z := k / 928
  let s := c6 y + c8 z
  if s ≤ 896315812331399 then
    coverMask (896315812331399-s) &&& fullMask == fullMask
  else true

def grid : Nat → Nat → Bool
 | 0,k => if k < 255200 then coverPair k else true
 | d+1,k => grid d k && grid d (k+2^d)

def checker := grid 18 0


def validLeaf (k : Nat) : Bool :=
  let x := k % 12110
  let t := k / 12110
  let b := t % 137
  let i := t / 137
  if hi : i < primes.size then
    let p := primes[i]!
    if hb : b < p then
      let m := (rejectMasks[i]!)[b]!
      let q := squareMasks[i]!
      if m.testBit x then
        !(q.testBit ((8*((b+p-c4 x%p)%p)+1)%p))
      else true
    else true
  else true

def validGrid : Nat → Nat → Bool
 | 0,k => validLeaf k
 | d+1,k => validGrid d k && validGrid d (k+2^d)

def validChecker := validGrid 26 0

def squareLeaf (k : Nat) : Bool :=
  let s := k % 137
  let i := k / 137
  if hi : i < primes.size then
    let p := primes[i]!
    if s < p then (squareMasks[i]!).testBit ((s*s)%p) else true
  else true

def squareGrid : Nat → Nat → Bool
 | 0,k => squareLeaf k
 | d+1,k => squareGrid d k && squareGrid d (k+2^d)

def squareChecker := squareGrid 13 0

