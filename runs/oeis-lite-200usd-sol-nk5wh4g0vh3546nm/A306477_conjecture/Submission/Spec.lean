lemma grid_get (d k j : Nat) (hj : j < 2^d) (h : grid d k = true) :
    coverPair (k+j) = true := by
  induction d generalizing k j with
  | zero =>
    have : j = 0 := by omega
    subst j
    simpa [grid] using h
  | succ d ih =>
    have hp : 2^(d+1) = 2^d * 2 := by rw [pow_succ]
    have hh : grid d k = true ∧ grid d (k+2^d) = true := by
      simpa [grid] using h
    by_cases hj' : j < 2^d
    · exact ih k j hj' hh.1
    · have hj2 : j-2^d < 2^d := by omega
      have := ih (k+2^d) (j-2^d) hj2 hh.2
      convert this using 1 <;> omega

lemma validGrid_get (d k j : Nat) (hj : j < 2^d) (h : validGrid d k = true) :
    validLeaf (k+j) = true := by
  induction d generalizing k j with
  | zero =>
    have : j = 0 := by omega
    subst j
    simpa [validGrid] using h
  | succ d ih =>
    have hp : 2^(d+1) = 2^d * 2 := by rw [pow_succ]
    have hh : validGrid d k = true ∧ validGrid d (k+2^d) = true := by
      simpa [validGrid] using h
    by_cases hj' : j < 2^d
    · exact ih k j hj' hh.1
    · have hj2 : j-2^d < 2^d := by omega
      have := ih (k+2^d) (j-2^d) hj2 hh.2
      convert this using 1 <;> omega

lemma squareGrid_get (d k j : Nat) (hj : j < 2^d) (h : squareGrid d k = true) :
    squareLeaf (k+j) = true := by
  induction d generalizing k j with
  | zero =>
    have : j = 0 := by omega
    subst j
    simpa [squareGrid] using h
  | succ d ih =>
    have hp : 2^(d+1) = 2^d * 2 := by rw [pow_succ]
    have hh : squareGrid d k = true ∧ squareGrid d (k+2^d) = true := by
      simpa [squareGrid] using h
    by_cases hj' : j < 2^d
    · exact ih k j hj' hh.1
    · have hj2 : j-2^d < 2^d := by omega
      have := ih (k+2^d) (j-2^d) hj2 hh.2
      convert this using 1 <;> omega


lemma coverPair_ok {k : Nat} (hk : k < 255200) : coverPair k = true := by
  apply grid_get 18 0 k (by norm_num; omega)
  simpa [checker] using checker_ok

lemma cover_ok {y z : Nat} (hy : y ≤ 927) (hz : z ≤ 274)
    (hs : c6 y + c8 z ≤ 896315812331399) :
    coverMask (896315812331399-(c6 y+c8 z)) &&& fullMask = fullMask := by
  let k := z*928+y
  have hk : k < 255200 := by dsimp [k]; omega
  have h := coverPair_ok hk
  simp only [coverPair] at h
  have hmod : k % 928 = y := by dsimp [k]; omega
  have hdiv : k / 928 = z := by dsimp [k]; omega
  simp [hmod, hdiv, hs, Bool.and_eq_true] at h
  exact h

lemma valid_lookup {i b x : Nat} (hi : i < primes.size) (hb : b < primes[i]!)
    (hx : x < 12110)
    (hr : ((rejectMasks[i]!)[b]!).testBit x = true) :
    (squareMasks[i]!).testBit
      ((8*((b+primes[i]!-c4 x%primes[i]!)%primes[i]!)+1)%primes[i]!) = false := by
  let k := (i*137+b)*12110+x
  have hk : k < 2^26 := by
    have hp : primes[i]! ≤ 137 := by
      -- all entries of the fixed prime table are at most 137
      have : i ≤ 30 := by norm_num [primes] at hi ⊢; omega
      interval_cases i <;> norm_num [primes]
    dsimp [k]
    omega
  have h := validGrid_get 26 0 k hk (by simpa [validChecker] using validChecker_ok)
  have hkmod : k % 12110 = x := by dsimp [k]; omega
  have hkdiv : k / 12110 = i*137+b := by dsimp [k]; omega
  have hb137 : b < 137 := lt_of_lt_of_le hb (by
    have hp : primes[i]! ≤ 137 := by
      have : i ≤ 30 := by norm_num [primes] at hi ⊢; omega
      interval_cases i <;> norm_num [primes]
    exact hp)
  have htmod : (i*137+b)%137=b := by omega
  have htdiv : (i*137+b)/137=i := by omega
  simp [validLeaf, hkmod, hkdiv, htmod, htdiv, hi, hb, hr] at h
  exact h

lemma square_lookup {i s : Nat} (hi : i < primes.size) (hs : s < primes[i]!) :
    (squareMasks[i]!).testBit ((s*s)%primes[i]!) = true := by
  let k := i*137+s
  have hk : k < 2^13 := by
    have : i ≤ 30 := by norm_num [primes] at hi ⊢; omega
    have hp : primes[i]! ≤ 137 := by interval_cases i <;> norm_num [primes]
    dsimp [k]; omega
  have h := squareGrid_get 13 0 k hk (by simpa [squareChecker] using squareChecker_ok)
  have hkmod : k%137=s := by
    have hp : primes[i]! ≤ 137 := by
      have : i ≤ 30 := by norm_num [primes] at hi ⊢; omega
      interval_cases i <;> norm_num [primes]
    dsimp [k]; omega
  have hkdiv : k/137=i := by dsimp [k]; omega
  simp [squareLeaf, hkmod, hkdiv, hi, hs] at h
  exact h


lemma testBit_foldl (l : List Nat) (a x : Nat)
    (h : (l.foldl (· ||| ·) a).testBit x = true) :
    a.testBit x = true ∨ ∃ m ∈ l, m.testBit x = true := by
  induction l generalizing a with
  | nil => exact Or.inl h
  | cons m l ih =>
    have q := ih (a ||| m) h
    rcases q with q | q
    · simp only [Nat.testBit_lor, Bool.or_eq_true] at q
      rcases q with q | q
      · exact Or.inl q
      · exact Or.inr ⟨m, by simp, q⟩
    · rcases q with ⟨u, hu, hut⟩
      exact Or.inr ⟨u, by simp [hu], hut⟩

lemma exists_reject {b x : Nat} (hx : x < 12110)
    (hc : coverMask b &&& fullMask = fullMask) :
    ∃ i, i < primes.size ∧ ((rejectMasks[i]!).getD (b % primes[i]!) 0).testBit x = true := by
  have he := congrArg (fun n : Nat => n.testBit x) hc
  simp only [Nat.testBit_land, Nat.testBit_two_pow_sub_one, fullMask] at he
  have hfull : fullMask.testBit x = true := by
    simp [fullMask, Nat.testBit_two_pow_sub_one, hx]
  rw [hfull, Bool.and_true] at he
  have hf : (masksFor b).foldl (· ||| ·) 0 |>.testBit x = true := he
  rw [← Array.foldl_toList] at hf
  obtain hzero | ⟨m, hm, hmt⟩ := testBit_foldl (masksFor b).toList 0 x hf
  · simp at hzero
  · have hma : m ∈ masksFor b := by simpa using hm
    rw [Array.mem_map] at hma
    obtain ⟨i, hi, rfl⟩ := hma
    have hir : i < primes.size := by simpa using hi
    exact ⟨i, hir, hmt⟩


lemma prime_pos {i : Nat} (hi : i < primes.size) : 0 < primes[i]! := by
  have : i ≤ 30 := by norm_num [primes] at hi ⊢; omega
  interval_cases i <;> norm_num [primes]

lemma reject_size {i : Nat} (hi : i < primes.size) :
    (rejectMasks[i]!).size = primes[i]! := by
  have : i ≤ 30 := by norm_num [primes] at hi ⊢; omega
  interval_cases i <;> norm_num [rejectMasks, primes]

lemma c4_eq (x : Nat) : c4 x = (x+3).choose 4 := by
  rw [Nat.choose_eq_asc_factorial_div_factorial']
  simp [c4, Nat.ascFactorial_succ]
  congr 1
  ring

lemma c6_eq (x : Nat) : c6 x = (x+5).choose 6 := by
  rw [Nat.choose_eq_asc_factorial_div_factorial']
  simp [c6, Nat.ascFactorial_succ]
  congr 1
  ring

lemma c8_eq (x : Nat) : c8 x = (x+7).choose 8 := by
  rw [Nat.choose_eq_asc_factorial_div_factorial']
  simp [c8, Nat.ascFactorial_succ]
  congr 1
  ring

lemma c2_scaled (w : Nat) : 2*(w+2).choose 2=(w+1)*(w+2) := by
  have h := Nat.ascFactorial_eq_factorial_mul_choose' (w+1) 2
  norm_num [Nat.ascFactorial_succ] at h ⊢
  rw [←h]
  ac_rfl

theorem _root_.A306477_conjecture.disproof :
    ¬ (∀ n : ℕ, n > 0 → A306477 n > 0) := by
  intro hall
  have hnr (w x y z : Nat)
      (h : (w+2).choose 2+(x+3).choose 4+(y+5).choose 6+(z+7).choose 8
        = 896315812331399) : False := by
    have hwc : (w+2).choose 2 ≤ 896315812331399 := by omega
    have hxc : (x+3).choose 4 ≤ 896315812331399 := by omega
    have hyc : (y+5).choose 6 ≤ 896315812331399 := by omega
    have hzc : (z+7).choose 8 ≤ 896315812331399 := by omega
    have hx : x ≤ 12109 := by
      by_contra hn
      have hl : (12113).choose 4 ≤ (x+3).choose 4 := Nat.choose_mono 4 (by omega)
      have hv : (12113).choose 4 = 896562324551740 := by
        have q := Nat.ascFactorial_eq_factorial_mul_choose' 12110 4
        norm_num [Nat.ascFactorial_succ] at q ⊢
        omega
      rw [hv] at hl
      omega
    have hy : y ≤ 927 := by
      by_contra hn
      have hl : (933).choose 6 ≤ (y+5).choose 6 := Nat.choose_mono 6 (by omega)
      have hv : (933).choose 6 = 901490966993008 := by
        have q := Nat.ascFactorial_eq_factorial_mul_choose' 928 6
        norm_num [Nat.ascFactorial_succ] at q ⊢
        omega
      rw [hv] at hl
      omega
    have hz : z ≤ 274 := by
      by_contra hn
      have hl : (282).choose 8 ≤ (z+7).choose 8 := Nat.choose_mono 8 (by omega)
      have hv : (282).choose 8 = 897353333100675 := by
        have q := Nat.ascFactorial_eq_factorial_mul_choose' 275 8
        norm_num [Nat.ascFactorial_succ] at q ⊢
        omega
      rw [hv] at hl
      omega
    have hs : c6 y+c8 z ≤ 896315812331399 := by rw [c6_eq, c8_eq]; omega
    have hc := cover_ok hy hz hs
    obtain ⟨i, hi, hr⟩ := exists_reject (b := 896315812331399-(c6 y+c8 z))
      (x := x) (by omega) hc
    let p := primes[i]!
    let b := (896315812331399-(c6 y+c8 z)) % p
    have hp : 0 < p := prime_pos hi
    have hb : b < p := Nat.mod_lt _ hp
    have hsize := reject_size hi
    have hget : (rejectMasks[i]!).getD b 0 = (rejectMasks[i]!)[b]! := by
      simp [Array.getD, hsize, hb]
    rw [hget] at hr
    have hnonsq := valid_lookup hi hb (by omega) hr
    let ss := (2*w+3)%p
    have hss : ss < p := Nat.mod_lt _ hp
    have hsq := square_lookup hi hss
    have hbexact : 896315812331399-(c6 y+c8 z) = c4 x+(w+2).choose 2 := by
      rw [c4_eq, c6_eq, c8_eq]
      omega
    have htri : 8*((w+2).choose 2)+1=(2*w+3)^2 := by
      have q := c2_scaled w
      nlinarith
    have hres : ((b+p-c4 x%p)%p) = ((w+2).choose 2)%p := by
      dsimp [b]
      rw [hbexact]
      simp only [Nat.add_mod]
      have hcmod : c4 x % p < p := Nat.mod_lt _ hp
      have htmod : (w+2).choose 2 % p < p := Nat.mod_lt _ hp
      omega
    have hind :
        ((8*((b+p-c4 x%p)%p)+1)%p) = (ss*ss)%p := by
      rw [hres]
      dsimp [ss]
      have ht := congrArg (fun n : Nat => n%p) htri
      simp only [Nat.add_mod, Nat.mul_mod, Nat.pow_two] at ht
      exact ht
    rw [hind] at hnonsq
    exact Bool.noConfusion (hnonsq.symm.trans hsq)
  have hz : A306477 896315812331399 = 0 :=
    A306477_eq_zero_of_no_rep _ (by
      intro w x y z h
      exact hnr w x y z h)
  have hp := hall 896315812331399 (by norm_num)
  omega

