    ((1 : ℕ) : ZMod certN)
  rw [ZMod.natCast_eq_natCast_iff]
  norm_num [Nat.ModEq, cb101, certN]

private theorem certN_eq : certN = 201886 * 3 ^ 39101 - 1 := by
  set_option exponentiation.threshold 40000 in
    norm_num [certN]

private theorem certN_prime : certN.Prime := by
  have hplus : certN + 1 = 201886 * 3 ^ 39101 := by
    rw [certN_eq, Nat.sub_add_cancel (by
      have hp : 0 < 3 ^ 39101 := pow_pos (by norm_num) _
      omega)]
  have hA101 := Compute.certFast39101 certN Compute.bits100943
  rw [compA101, Compute.value_bits100943] at hA101
  have hA100 := Compute.certFast39100 certN Compute.bits100943
  rw [compA100, Compute.value_bits100943] at hA100
  have hB101 := Compute.certFast39101 certN Compute.bits2
  rw [compB101, Compute.value_bits2] at hB101
  apply LucasCert.prime_of_full_order_omega certN (by norm_num [certN])
  · have hc : ca101 = (certN - 1, 0) := by rfl
    have hneg : Compute.toX certN ca101 = (-1 : X certN) := by
      rw [hc]
      ext
      · change (((certN - 1 : ℕ) : ZMod certN)) = -1
        rw [Nat.cast_sub (by norm_num [certN] : 1 ≤ certN), ZMod.natCast_self]
        simp
      · simp [Compute.toX]
    have hp : (X.ω : X certN) ^ (100943 * 3 ^ 39101) = -1 := by
      rw [← hA101, hneg]
    rw [hplus, show 201886 * 3 ^ 39101 = (100943 * 3 ^ 39101) * 2 by ring,
      pow_mul, hp]
    norm_num
  · intro r hr hrd
    have hre : r = 2 ∨ r = 100943 ∨ r = 3 := by
      rw [hplus, show 201886 * 3 ^ 39101 = (2 * 100943) * 3 ^ 39101 by ring] at hrd
      rcases (hr.dvd_mul.mp hrd) with h | h
      · rcases (hr.dvd_mul.mp h) with h | h
        · exact Or.inl ((Nat.dvd_prime Nat.prime_two).mp h |>.resolve_left hr.ne_one)
        · exact Or.inr <| Or.inl <|
            ((Nat.dvd_prime (by norm_num : Nat.Prime 100943)).mp h).resolve_left hr.ne_one
      · have h3 : r ∣ 3 := hr.dvd_of_dvd_pow h
        exact Or.inr <| Or.inr <|
          ((Nat.dvd_prime (by norm_num : Nat.Prime 3)).mp h3).resolve_left hr.ne_one
    rcases hre with rfl | rfl | rfl
    · left
      have he : (certN + 1) / 2 = 100943 * 3 ^ 39101 := by rw [hplus]; omega
      rw [he, ← hA101]
      exact unit_ca101
    · left
      have he : (certN + 1) / 100943 = 2 * 3 ^ 39101 := by rw [hplus]; omega
      rw [he, ← hB101]
      exact unit_cb101
    · left
      have he : (certN + 1) / 3 = (100943 * 3 ^ 39100) * 2 := by
        rw [hplus, pow_succ]
        omega
      rw [he, pow_mul, ← hA100, pow_two, ← Compute.toX_pmul, r3pair_eq]
      exact unit_r3pair


/-- A354747: the least positive exponent producing a prime, with the empty-set
value represented by `0`. -/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

/-- The proposed zero value is false: exponent 39101 gives a prime. -/
theorem oeis_a354747_conjecture_0.disproof : ¬ a354747 100943 = 0 := by
  have hp : Nat.Prime (2 * 100943 * 3 ^ 39101 - 1) := by
    rw [show 2 * 100943 = 201886 by norm_num, ← certN_eq]
    exact certN_prime
  intro hz
  let S : Set ℕ := {m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)}
  have hs : S.Nonempty := by
    refine ⟨39101, ?_⟩
    exact ⟨by norm_num, hp⟩
  have hm := Nat.sInf_mem hs
  have hz' : sInf S = 0 := by simpa [a354747, S] using hz
  rw [hz'] at hm
  exact (Nat.not_lt_zero 0 hm.1)
