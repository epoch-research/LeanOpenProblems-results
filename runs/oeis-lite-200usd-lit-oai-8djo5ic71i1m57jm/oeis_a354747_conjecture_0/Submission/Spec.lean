structure Quad (p : Nat) where
  re : ZMod p
  im : ZMod p
deriving DecidableEq

def qone {p} : Quad p := ⟨1,0⟩
def qmul {p} (x y : Quad p) : Quad p := ⟨x.re*y.re + 41*x.im*y.im, x.re*y.im + x.im*y.re⟩
instance {p} : One (Quad p) := ⟨qone⟩
instance {p} : Mul (Quad p) := ⟨qmul⟩
@[ext] theorem Quad.ext {p} {x y : Quad p} (hre : x.re = y.re) (him : x.im = y.im) : x = y := by cases x; cases y; simp_all
instance {p} : CommMonoid (Quad p) where
  one := 1; mul := (· * ·); npow := npowRec
  mul_assoc := by intro a b c; cases a; cases b; cases c; change qmul (qmul ⟨_,_⟩ ⟨_,_⟩) ⟨_,_⟩ = qmul ⟨_,_⟩ (qmul ⟨_,_⟩ ⟨_,_⟩); apply Quad.ext <;> dsimp [qmul] <;> ring_nf
  one_mul := by intro a; cases a; change qmul qone ⟨_,_⟩ = ⟨_,_⟩; apply Quad.ext <;> dsimp [qmul,qone] <;> ring_nf
  mul_one := by intro a; cases a; change qmul ⟨_,_⟩ qone = ⟨_,_⟩; apply Quad.ext <;> dsimp [qmul,qone] <;> ring_nf
  mul_comm := by intro a b; cases a; cases b; change qmul ⟨_,_⟩ ⟨_,_⟩ = qmul ⟨_,_⟩ ⟨_,_⟩; apply Quad.ext <;> dsimp [qmul] <;> ring_nf

structure Pair where
  re : Nat
  im : Nat
deriving DecidableEq
@[inline] def pmul (n : Nat) (x y : Pair) : Pair :=
  { re := (x.re*y.re + 41*x.im*y.im) % n,
    im := (x.re*y.im + x.im*y.re) % n }

def toQuad (p : Nat) (x : Pair) : Quad p := ⟨x.re, x.im⟩

lemma cast_mod_of_dvd {p n z : Nat} (hpn : p ∣ n) : ((z % n : Nat) : ZMod p) = (z : ZMod p) := by
  rw [ZMod.natCast_eq_natCast_iff]
  exact (Nat.mod_modEq z n).of_dvd hpn

lemma toQuad_pmul {p n : Nat} (hpn : p ∣ n) (x y : Pair) :
    toQuad p (pmul n x y) = toQuad p x * toQuad p y := by
  cases x with
  | mk xr xi =>
  cases y with
  | mk yr yi =>
  change toQuad p (pmul n ⟨xr,xi⟩ ⟨yr,yi⟩) = qmul (toQuad p ⟨xr,xi⟩) (toQuad p ⟨yr,yi⟩)
  apply Quad.ext
  · dsimp [toQuad, pmul, qmul]
    rw [cast_mod_of_dvd hpn]
    norm_num
  · dsimp [toQuad, pmul, qmul]
    rw [cast_mod_of_dvd hpn]
    norm_num

@[inline] def stepPair (n : Nat) (g s : Pair) (bit : Nat) : Pair :=
  let d := pmul n s s
  if bit = 0 then d else pmul n d g
@[inline] def stepQ {p} (g s : Quad p) (bit : Nat) : Quad p :=
  let d := s*s
  if bit = 0 then d else d*g

lemma toQuad_step {p n} (hpn : p ∣ n) (g s : Pair) (bit : Nat) :
    toQuad p (stepPair n g s bit) = stepQ (toQuad p g) (toQuad p s) bit := by
  unfold stepPair stepQ
  split <;> simp [toQuad_pmul hpn]


def processBitsPair : Nat → Nat → Nat → Pair → Pair → Pair
| 0, lo, n, g, s => s
| j+1, lo, n, g, s =>
  let bit := (lo / (2^j)) % 2
  processBitsPair j lo n g (stepPair n g s bit)

def processBitsQ {p} : Nat → Nat → Quad p → Quad p → Quad p
| 0, lo, g, s => s
| j+1, lo, g, s =>
  let bit := (lo / (2^j)) % 2
  processBitsQ j lo g (stepQ g s bit)

lemma toQuad_processBits {p n} (hpn : p ∣ n) (k lo : Nat) (g s : Pair) :
    toQuad p (processBitsPair k lo n g s) = processBitsQ k lo (toQuad p g) (toQuad p s) := by
  induction k generalizing s with
  | zero => simp [processBitsPair, processBitsQ]
  | succ j ih =>
    simp [processBitsPair, processBitsQ]
    rw [ih (stepPair n g s ((lo / 2 ^ j) % 2))]
    rw [toQuad_step hpn]

def processBitsExp : Nat → Nat → Nat → Nat
| 0, lo, r => r
| j+1, lo, r =>
  let bit := (lo / (2^j)) % 2
  processBitsExp j lo (2*r + bit)

lemma stepQ_pow {p} (g : Quad p) (r bit : Nat) (hbit : bit < 2) :
    stepQ g (g^r) bit = g^(2*r + bit) := by
  unfold stepQ
  have hb : bit = 0 ∨ bit = 1 := by omega
  rcases hb with h | h
  · subst bit; simp [pow_add, two_mul]
  · subst bit; simp [pow_add, two_mul, pow_succ]

lemma processBitsQ_pow {p} (k lo r : Nat) (g : Quad p) :
    processBitsQ k lo g (g^r) = g^(processBitsExp k lo r) := by
  induction k generalizing r with
  | zero => simp [processBitsQ, processBitsExp]
  | succ j ih =>
    simp [processBitsQ, processBitsExp]
    rw [stepQ_pow]
    · exact ih (2*r + (lo / 2 ^ j) % 2)
    · exact Nat.mod_lt _ (by decide : 0 < 2)

def processChunksPair (width : Nat) : List Nat → Nat → Pair → Pair → Pair
| [], n, g, s => s
| lo::xs, n, g, s => processChunksPair width xs n g (processBitsPair width lo n g s)

def processChunksQ {p} (width : Nat) : List Nat → Quad p → Quad p → Quad p
| [], g, s => s
| lo::xs, g, s => processChunksQ width xs g (processBitsQ width lo g s)

def processChunksExp (width : Nat) : List Nat → Nat → Nat
| [], r => r
| lo::xs, r => processChunksExp width xs (processBitsExp width lo r)

lemma toQuad_processChunks {p n} (hpn : p ∣ n) (width : Nat) (chunks : List Nat) (g s : Pair) :
    toQuad p (processChunksPair width chunks n g s) = processChunksQ width chunks (toQuad p g) (toQuad p s) := by
  induction chunks generalizing s with
  | nil => simp [processChunksPair, processChunksQ]
  | cons lo xs ih =>
    simp [processChunksPair, processChunksQ]
    rw [ih (processBitsPair width lo n g s)]
    rw [toQuad_processBits hpn]

lemma processChunksQ_pow {p} (width : Nat) (chunks : List Nat) (r : Nat) (g : Quad p) :
    processChunksQ width chunks g (g^r) = g^(processChunksExp width chunks r) := by
  induction chunks generalizing r with
  | nil => simp [processChunksQ, processChunksExp]
  | cons lo xs ih =>
    simp [processChunksQ, processChunksExp]
    rw [processBitsQ_pow]
    exact ih (processBitsExp width lo r)


