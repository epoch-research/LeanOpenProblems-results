instance {p} [NeZero p] : Fintype (Quad p) := by
  classical
  exact Fintype.ofEquiv (ZMod p × ZMod p)
    { toFun := fun x => ⟨x.1,x.2⟩,
      invFun := fun q => (q.re,q.im),
      left_inv := by intro x; rfl,
      right_inv := by intro q; cases q; rfl }

lemma card_quad (p : Nat) [NeZero p] : Fintype.card (Quad p) = p * p := by
  classical
  let e : (ZMod p × ZMod p) ≃ Quad p :=
    { toFun := fun x => ⟨x.1,x.2⟩,
      invFun := fun q => (q.re,q.im),
      left_inv := by intro x; rfl,
      right_inv := by intro q; cases q; rfl }
  rw [← Fintype.card_congr e]
  simp [Fintype.card_prod, ZMod.card]

lemma pair_ne_one_of_gcd {p N : Nat} (hpn : p ∣ N) (hp : p.Prime) (hNpos : 0 < N) (x : Pair)
    (hg : Nat.gcd (((x.re + N - 1) % N)) N = 1) :
    toQuad p x ≠ 1 := by
  intro h
  have hre : ((x.re : Nat) : ZMod p) = (1 : ZMod p) := by
    have := congrArg Quad.re h
    simpa [toQuad, qone] using this
  have hN0 : ((N : Nat) : ZMod p) = 0 := by
    rw [ZMod.natCast_eq_zero_iff]
    exact hpn
  have hxN0 : (((x.re + N - 1) : Nat) : ZMod p) = 0 := by
    have hsum : (((x.re + N) : Nat) : ZMod p) = (1 : ZMod p) := by
      rw [Nat.cast_add, hre, hN0]
      simp
    have hxNpos : 1 ≤ x.re + N := by omega
    have hsubeq : x.re + N - 1 + 1 = x.re + N := Nat.sub_add_cancel hxNpos
    have hc : ((((x.re + N - 1) + 1 : Nat) : ZMod p) = (1 : ZMod p)) := by
      rw [hsubeq]
      exact hsum
    rw [Nat.cast_add, Nat.cast_one] at hc
    have hc2 : (((x.re + N - 1 : Nat) : ZMod p) + 1 = (0 : ZMod p) + 1) := by
      simpa using hc
    exact add_right_cancel hc2
  have hsub : x.re + N - 1 ≡ 0 [MOD p] := by
    rw [← ZMod.natCast_eq_natCast_iff]
    simpa using hxN0
  have hd : p ∣ ((x.re + N - 1) % N) := by
    have hz : (x.re + N - 1) % N ≡ 0 [MOD p] :=
      ((Nat.mod_modEq (x.re + N - 1) N).of_dvd hpn).trans hsub
    exact Nat.modEq_zero_iff_dvd.mp hz
  have hpg : p ∣ Nat.gcd (((x.re + N - 1) % N)) N := Nat.dvd_gcd hd hpn
  rw [hg] at hpg
  exact hp.not_dvd_one hpg

lemma cert_pow {p : Nat} (hpn : p ∣ Nlit)
    {chunks : List Nat} {S0 S1 : Pair} {E0 E1 : Nat}
    (heval : processChunksPair 1024 chunks Nlit gammaPair S0 = S1)
    (hexp : processChunksExp 1024 chunks E0 = E1)
    (hS0 : S0 = {re := 1, im := 0}) (hE0 : E0 = 0) :
    (toQuad p gammaPair) ^ E1 = toQuad p S1 := by
  have hpair := congrArg (toQuad p) heval
  rw [toQuad_processChunks hpn] at hpair
  have hsem := processChunksQ_pow (p:=p) 1024 chunks 0 (toQuad p gammaPair)
  have hstart : toQuad p S0 = (toQuad p gammaPair) ^ 0 := by
    rw [hS0, pow_zero]
    change toQuad p {re := 1, im := 0} = qone
    apply Quad.ext <;> simp [toQuad, qone]
  rw [hstart] at hpair
  rw [hsem] at hpair
  have hexp0 : processChunksExp 1024 chunks 0 = E1 := by simpa [hE0] using hexp
  rw [hexp0] at hpair
  exact hpair

lemma order_card_contra {N M p : Nat} (hp : p.Prime)
    (hp2leN : p ^ 2 ≤ N) (hMgtN : N < M) (g : Quad p)
    (hord : orderOf g = M) : False := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  have hcard : Fintype.card (Quad p) = p * p := card_quad p
  have hlecard : orderOf g ≤ Fintype.card (Quad p) := orderOf_le_card_univ
  have hMlepp : M ≤ p * p := by simpa [hord, hcard, pow_two] using hlecard
  have hMleN : M ≤ N := le_trans hMlepp (by simpa [pow_two] using hp2leN)
  exact (not_lt_of_ge hMleN) hMgtN

lemma prime_div_cases (q : Nat) (hq : q.Prime) (hqd : q ∣ 2 * 100943 * 3^39101) :
    q = 2 ∨ q = 3 ∨ q = 100943 := by
  have h100943 : Nat.Prime 100943 := by norm_num
  have hq2_or : q ∣ 2 ∨ q ∣ 100943 * 3^39101 := hq.dvd_mul.mp (by simpa [mul_assoc] using hqd)
  rcases hq2_or with hq2 | hrest
  · left
    exact (Nat.dvd_prime (by norm_num : Nat.Prime 2)).mp hq2 |>.resolve_left hq.ne_one
  have hq100_or : q ∣ 100943 ∨ q ∣ 3^39101 := hq.dvd_mul.mp hrest
  rcases hq100_or with hq100 | hq3pow
  · right; right
    exact (Nat.dvd_prime h100943).mp hq100 |>.resolve_left hq.ne_one
  · right; left
    have : q ∣ 3 := hq.dvd_of_dvd_pow hq3pow
    exact (Nat.dvd_prime (by norm_num : Nat.Prime 3)).mp this |>.resolve_left hq.ne_one

