lemma Nlit_pos : 0 < Nlit := by decide
lemma Nlit_ne_one : Nlit ≠ 1 := by decide
lemma Nlit_factor : Nlit + 1 = 2 * 100943 * 3^39101 := by decide
lemma Nlit_eq_target : Nlit = 2 * 100943 * 3^39101 - 1 := by decide

lemma Nlit_prime_from_certs : Nat.Prime Nlit := by
  by_contra hcomp
  let p := Nat.minFac Nlit
  have hp : p.Prime := Nat.minFac_prime Nlit_ne_one
  have hpn : p ∣ Nlit := Nat.minFac_dvd Nlit
  have hp2 : p ^ 2 ≤ Nlit := Nat.minFac_sq_le_self Nlit_pos hcomp
  let g : Quad p := toQuad p gammaPair
  have hx : g ^ (Nlit + 1) = 1 := gamma_pow_M hpn
  have hnot2 : g ^ ((Nlit + 1) / 2) ≠ 1 := gamma_pow_M2_ne_one hpn hp Nlit_pos
  have hnot3 : g ^ ((Nlit + 1) / 3) ≠ 1 := gamma_pow_M3_ne_one hpn hp Nlit_pos
  have hnotq : g ^ ((Nlit + 1) / 100943) ≠ 1 := gamma_pow_Mq_ne_one hpn hp Nlit_pos
  have hord : orderOf g = Nlit + 1 := by
    refine orderOf_eq_of_pow_and_pow_div_prime (x:=g) (n:=Nlit+1) (Nat.succ_pos _) hx ?_
    intro q hq hqd
    have hqd' : q ∣ 2 * 100943 * 3^39101 := by
      rwa [Nlit_factor] at hqd
    rcases prime_div_cases q hq hqd' with hq2 | hq3 | hqq
    · subst q
      simpa using hnot2
    · subst q
      simpa using hnot3
    · subst q
      simpa using hnotq
  exact order_card_contra hp hp2 (Nat.lt_succ_self Nlit) g hord

lemma witness_prime : Nat.Prime (2 * 100943 * 3^39101 - 1) := by
  simpa [← Nlit_eq_target] using Nlit_prime_from_certs

/-- Disproof: the prime occurs after 39101 steps. -/
theorem oeis_a354747_conjecture_0.disproof : ¬ a354747 100943 = 0 := by
  intro h
  have hmem : 39101 ∈ ({m : Nat | m > 0 ∧ Nat.Prime (2 * 100943 * 3^m - 1)} : Set Nat) := by
    constructor
    · norm_num
    · simpa using witness_prime
  unfold a354747 at h
  rcases (Nat.sInf_eq_zero.mp h) with hzero | hempty
  · exact (Nat.lt_irrefl 0) hzero.1
  · have : 39101 ∈ (∅ : Set Nat) := by simpa [hempty] using hmem
    simpa using this
