lemma gamma_pow_M {p : Nat} (hpn : p ∣ Nlit) : (toQuad p gammaPair) ^ (Nlit + 1) = 1 := by
  have h := cert_pow (p:=p) hpn M_eval M_expeval (by rfl : M_S_0 = {re := 1, im := 0}) (by rfl : M_E_0 = 0)
  rw [M_Efinal_Nlit] at h
  simpa [M_S_61, toQuad, qone] using h

