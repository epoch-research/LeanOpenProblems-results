def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

private def phiMF : Nat -> Nat
| 0 => 0
| 1 => 1
| n+2 =>
  let p := Nat.minFac (n+2)
  let m := (n+2) / p
  if p ∣ m then p * phiMF m else (p-1) * phiMF m
termination_by n => n
decreasing_by
  all_goals
    change (n + 2) / (n + 2).minFac < n + 2
    exact Nat.factors_lemma

private theorem phiMF_eq_totient (n : Nat) : phiMF n = Nat.totient n := by
  refine Nat.strong_induction_on n ?_
  intro N ih
  cases N with
  | zero => simp [phiMF]
  | succ N1 =>
      cases N1 with
      | zero => simp [phiMF, Nat.totient_one]
      | succ n =>
          let N := n + 2
          let p := Nat.minFac N
          let m := N / p
          have hlt : m < N := by
            dsimp [m, N]
            simpa [Nat.succ_eq_add_one, Nat.add_assoc] using (Nat.factors_lemma (k:=n))
          have hrec : phiMF m = Nat.totient m := ih m (by exact hlt)
          have hp : p.Prime := Nat.minFac_prime (by dsimp [N]; omega)
          have hN : N = p * m := by
            dsimp [m, p]
            exact (Nat.div_mul_cancel (Nat.minFac_dvd N)).symm.trans (by rw [Nat.mul_comm])
          change phiMF N = Nat.totient N
          rw [phiMF]
          by_cases hd : p ∣ m
          · rw [if_pos hd, hrec]
            calc
              p * Nat.totient m = Nat.totient (p * m) := (Nat.totient_mul_of_prime_of_dvd hp hd).symm
              _ = Nat.totient N := by rw [hN]
          · rw [if_neg hd, hrec]
            calc
              (p - 1) * Nat.totient m = Nat.totient (p * m) := (Nat.totient_mul_of_prime_of_not_dvd hp hd).symm
              _ = Nat.totient N := by rw [hN]

