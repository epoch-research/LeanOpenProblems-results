private def pairAt (i : Nat) : Nat × Nat × Nat := coverPairs.getD i (0,0,0)
private def validPairB (p : Nat × Nat × Nat) : Bool :=
  (0 < p.1) && (p.1 < p.2.1) && (phiMF p.1 * phiMF p.2.1 == p.2.2 * p.2.2)
private def coverPairFastB (n : Nat) (p : Nat × Nat × Nat) : Bool :=
  (n % (p.1 + p.2.1) == 0) && (Nat.gcd (n/(p.1+p.2.1)) (p.1*p.2.1) == 1)
private theorem coverPair_fast_actual {n : Nat} {p : Nat × Nat × Nat} (hn9 : 9 ≤ n)
    (hv : validPairB p = true) (hf : coverPairFastB n p = true) : a n > 0 := by
  rcases p with ⟨x,y,r⟩
  simp only [validPairB] at hv
  simp only [coverPairFastB] at hf
  repeat rw [Bool.and_eq_true_iff] at hv
  rw [Bool.and_eq_true_iff] at hf
  have hdiv : x + y ∣ n := Nat.dvd_of_mod_eq_zero (beq_iff_eq.mp hf.1)
  have hcover : coverPairB n x y r = true := by
    simp only [coverPairB]
    repeat rw [Bool.and_eq_true_iff]
    exact ⟨⟨⟨⟨hv.1.1, hv.1.2⟩, decide_eq_true hdiv⟩, hf.2⟩, hv.2⟩
  exact coverPair_actual hn9 hcover

private def coverS : Nat := 
private def coverP : Nat := 
private def sumAt (tag : Nat) : Nat := getP 12 coverS tag
private def prodAt (tag : Nat) : Nat := getP 22 coverP tag
private def tagGoodB (n tag : Nat) : Bool :=
  (n % sumAt tag == 0) && (Nat.gcd (n / sumAt tag) (prodAt tag) == 1)
private theorem coverTags_valid (tag : Nat) (ht : tag < coverPairs.size) :
    validPairB (pairAt tag) = true ∧
    sumAt tag = (pairAt tag).1 + (pairAt tag).2.1 ∧
    prodAt tag = (pairAt tag).1 * (pairAt tag).2.1 := by
  have htag : tag < 255 := by simpa [coverPairs] using ht
  interval_cases tag <;> decide +kernel
private theorem tagGood_actual {n tag : Nat} (hn9 : 9 ≤ n) (ht : tag < coverPairs.size) (h : tagGoodB n tag = true) : a n > 0 := by
  have hv := coverTags_valid tag ht
  have hfast : coverPairFastB n (pairAt tag) = true := by
    simp only [tagGoodB] at h
    simp only [coverPairFastB]
    rw [← hv.2.1, ← hv.2.2]
    exact h
  exact coverPair_fast_actual hn9 hv.1 hfast










private def checkPackedN : Nat -> Nat -> Nat -> Nat -> Nat -> Bool
| lo, 0, tags, ks, rs => true
| lo, len+1, tags, ks, rs =>
    let tag := tags % 256
    let tags' := tags / 256
    if Nat.blt tag 255 then tagGoodB lo tag && checkPackedN (lo+1) len tags' ks rs
    else
      let k := ks % (2^14)
      let r := rs % (2^17)
      goodB lo k r && checkPackedN (lo+1) len tags' (ks/(2^14)) (rs/(2^17))

private theorem actual_of_checkPackedN {lo t len tags ks rs : Nat} (hlo : 9 ≤ lo) :
    checkPackedN lo len tags ks rs = true -> t < len -> a (lo+t) > 0 := by
  revert lo len tags ks rs
  induction t with
  | zero =>
      intro lo len tags ks rs hlo h ht
      cases len with
      | zero => simp at ht
      | succ len =>
          simp only [checkPackedN] at h
          by_cases htag : tags % 256 < 255
          · have hb : Nat.blt (tags % 256) 255 = true := Nat.blt_eq.mpr htag
            have hg := (Bool.and_eq_true_iff.mp (by simpa [hb] using h)).1
            have hts : tags % 256 < coverPairs.size := by simpa [coverPairs] using htag
            exact tagGood_actual hlo hts hg
          · have hb : Nat.blt (tags % 256) 255 = false := Bool.eq_false_iff.mpr (by intro hb; exact htag (Nat.blt_eq.mp hb))
            have hg := (Bool.and_eq_true_iff.mp (by simpa [hb] using h)).1
            exact good_actual (by simpa [Nat.zero_add] using hg)
  | succ t ih =>
      intro lo len tags ks rs hlo h ht
      cases len with
      | zero => simp at ht
      | succ len =>
          simp only [checkPackedN] at h
          by_cases htag : tags % 256 < 255
          · have hb : Nat.blt (tags % 256) 255 = true := Nat.blt_eq.mpr htag
            have htail : checkPackedN (lo+1) len (tags / 256) ks rs = true := (Bool.and_eq_true_iff.mp (by simpa [hb] using h)).2
            have ht' : t < len := Nat.lt_of_succ_lt_succ (by simpa using ht)
            have this := @ih (lo+1) len (tags/256) ks rs (by omega) htail ht'
            have heq : lo + Nat.succ t = lo + 1 + t := by omega
            rwa [heq]
          · have hb : Nat.blt (tags % 256) 255 = false := Bool.eq_false_iff.mpr (by intro hb; exact htag (Nat.blt_eq.mp hb))
            have htail : checkPackedN (lo+1) len (tags / 256) (ks/(2^14)) (rs/(2^17)) = true := (Bool.and_eq_true_iff.mp (by simpa [hb] using h)).2
            have ht' : t < len := Nat.lt_of_succ_lt_succ (by simpa using ht)
            have this := @ih (lo+1) len (tags/256) (ks/(2^14)) (rs/(2^17)) (by omega) htail ht'
            have heq : lo + Nat.succ t = lo + 1 + t := by omega
            rwa [heq]


