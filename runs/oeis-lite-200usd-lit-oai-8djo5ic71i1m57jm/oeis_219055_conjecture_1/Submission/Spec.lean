/--
A219055, Conjecture 1: The core conjecture for A219055 implies Goldbach's conjecture,
Lemoine's conjecture and the conjecture that there are infinitely many primes p with p+6 also prime.
-/
theorem oeis_219055_conjecture_1 :
    a219055_core_conjecture → goldbach_conjecture ∧ lemoine_conjecture ∧ six_prime_gap_conjecture :=
  by
    intro hcore
    constructor
    · intro n hn4 heven
      by_cases hlarge : 8012 < n
      · have hA : A219055 n > 0 := hcore n (Or.inl ⟨heven, hlarge⟩)
        rw [A219055, gt_iff_lt, Finset.card_pos] at hA
        rcases hA with ⟨q, hqmem⟩
        rw [Finset.mem_filter] at hqmem
        rcases hqmem with ⟨hqrange, hineq, hqprime, hq6prime, hpprime, hp6prime⟩
        refine ⟨n - q, q, ?_, hqprime, ?_⟩
        · have hnmod : n % 2 = 0 := Nat.even_iff.mp heven
          simpa [hnmod] using hpprime
        · have hqle : q ≤ n := Nat.le_of_lt (Finset.mem_range.mp hqrange)
          omega
      · have hnle : n ≤ 8012 := by omega
        exact goldbach_small_cert n hn4 hnle heven
    · constructor
      · intro n hn7 hodd
        by_cases hlarge : 15727 < n
        · have hA : A219055 n > 0 := hcore n (Or.inr ⟨hodd, hlarge⟩)
          rw [A219055, gt_iff_lt, Finset.card_pos] at hA
          rcases hA with ⟨q, hqmem⟩
          rw [Finset.mem_filter] at hqmem
          rcases hqmem with ⟨hqrange, hineq, hqprime, hq6prime, hpprime, hp6prime⟩
          refine ⟨n - 2 * q, q, ?_, hqprime, ?_⟩
          · have hnmod : n % 2 = 1 := Nat.odd_iff.mp hodd
            simpa [hnmod] using hpprime
          · have h2qle : 2 * q ≤ n := by
              have hnmod : n % 2 = 1 := Nat.odd_iff.mp hodd
              have h3 : 3 * q < n := by simpa [hnmod] using hineq
              omega
            omega
        · have hnle : n ≤ 15727 := by omega
          exact lemoine_small_cert n hn7 hnle hodd
      · rw [six_prime_gap_conjecture, ← Set.not_finite]
        intro hfin
        obtain ⟨B, hB⟩ := hfin.bddAbove
        let N : ℕ := max B 8013 + 1
        let n : ℕ := 2 * N.factorial
        have heven : Even n := by
          refine ⟨N.factorial, ?_⟩
          dsimp [n]
          omega
        have hlarge : 8012 < n := by
          have hN : 8013 ≤ N := by dsimp [N]; omega
          have hfact : N ≤ N.factorial := Nat.self_le_factorial N
          dsimp [n]
          omega
        have hA : A219055 n > 0 := hcore n (Or.inl ⟨heven, hlarge⟩)
        rw [A219055, gt_iff_lt, Finset.card_pos] at hA
        rcases hA with ⟨q, hqmem⟩
        rw [Finset.mem_filter] at hqmem
        rcases hqmem with ⟨hqrange, hineq, hqprime, hq6prime, hpprime, hp6prime⟩
        have hqB : q ≤ B := hB (by exact ⟨hqprime, hq6prime⟩)
        have hqpos : 0 < q := hqprime.pos
        have hqN : q ≤ N := by dsimp [N]; omega
        have hq_dvd_fact : q ∣ N.factorial := Nat.dvd_factorial hqpos hqN
        have hq_dvd_n : q ∣ n := by
          dsimp [n]
          exact dvd_mul_of_dvd_right hq_dvd_fact 2
        have hq_dvd_sub : q ∣ n - q := Nat.dvd_sub hq_dvd_n (dvd_refl q)
        have hpprime' : (n - q).Prime := by
          have hnmod : n % 2 = 0 := Nat.even_iff.mp heven
          simpa [hnmod] using hpprime
        have hq_ne_one : q ≠ 1 := by
          have hq2 : 2 ≤ q := hqprime.two_le
          omega
        have hsub_eq : n - q = q := (hpprime'.dvd_iff_eq hq_ne_one).mp hq_dvd_sub
        have hn_gt_2q : 2 * q < n := by
          have hnmod : n % 2 = 0 := Nat.even_iff.mp heven
          simpa [hnmod] using hineq
        omega
