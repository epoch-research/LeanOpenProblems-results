def conjectureProp : Prop :=
  ∀ (n : ℕ), 3775 ≤ n →
    (A355898 n = 1 + A355898 (n - 1) + A355898 (n - 2))
    ∧ (A355898 n = 2 * A355898 (n - 1) - A355898 (n - 3))
    ∧ (A355898 n = (A355898 3774 + 1) * Nat.fib (n - 3772) - (A355898 3772 + 1) * Nat.fib (n - 3774) - 1)

def bZ (i : ℕ) : ZMod badP := ((A355898 (3773 + i) + 1 : ℕ) : ZMod badP)

lemma bZ_rec (H : conjectureProp) (i : ℕ) : bZ (i + 2) = bZ (i + 1) + bZ i := by
  have h1 := (H (3775 + i) (by omega)).1
  dsimp [bZ]
  rw [show 3773 + (i + 2) = 3775 + i by omega,
      show 3773 + (i + 1) = (3775 + i) - 1 by omega,
      show 3773 + i = (3775 + i) - 2 by omega]
  rw [h1]
  norm_num
  ring

lemma bZ_iter (H : conjectureProp) (i : ℕ) :
    (zstep^[i]) (bZ 1, bZ 0) = (bZ (i + 1), bZ i) := by
  induction i with
  | zero => rfl
  | succ i ih =>
    rw [Function.iterate_succ_apply']
    rw [ih]
    simp only [zstep]
    rw [bZ_rec H i]

lemma gcd_step_lt {x y g : ℕ} (hg : g = Nat.gcd x y) (hx : 0 < x) (hy : 0 < y) (hg2 : 2 ≤ g) :
    g + (x + y) / g < 1 + x + y := by
  have hgpos : 0 < g := by omega
  have hgdx : g ∣ x := by simpa [hg] using Nat.gcd_dvd_left x y
  have hgdy : g ∣ y := by simpa [hg] using Nat.gcd_dvd_right x y
  have hgds : g ∣ x + y := Nat.dvd_add hgdx hgdy
  let q := (x + y) / g
  have hs : x + y = q * g := by
    exact (Nat.div_mul_cancel hgds).symm
  have hxg : g ≤ x := Nat.le_of_dvd hx hgdx
  have hyg : g ≤ y := Nat.le_of_dvd hy hgdy
  have hsge : 2 * g ≤ x + y := by omega
  have hq2 : 2 ≤ q := by
    have : 2 * g ≤ q * g := by omega
    exact Nat.le_of_mul_le_mul_right this hgpos
  change g + q < 1 + x + y
  have hs' : 1 + x + y = 1 + q * g := by omega
  rw [hs']
  nlinarith

theorem oeis_a355898_conjecture.disproof :
  ¬ (∀ (n : ℕ), 3775 ≤ n →
    (A355898 n = 1 + A355898 (n - 1) + A355898 (n - 2))
    ∧ (A355898 n = 2 * A355898 (n - 1) - A355898 (n - 3))
    ∧ (A355898 n = (A355898 3774 + 1) * Nat.fib (n - 3772) - (A355898 3772 + 1) * Nat.fib (n - 3774) - 1)) := by
  change ¬ conjectureProp
  intro H
  let x := A355898 (badK + 3774)
  let y := A355898 (badK + 3773)
  let g := Nat.gcd x y
  have happ : (zstep^[badK]) (bZ 1, bZ 0) = (1, 1) := by
    rw [← app_powM]
    change Mat2Z.app (Mat2Z.powM badK)
      (((A355898 3774 + 1 : ℕ) : ZMod badP), ((A355898 3773 + 1 : ℕ) : ZMod badP)) = (1, 1)
    exact bad_matrix_hits
  have hstate := bZ_iter H badK
  have hpair : (bZ (badK + 1), bZ badK) = (1, 1) := by
    rw [← hstate]
    exact happ
  have hxz1 : ((x + 1 : ℕ) : ZMod badP) = 1 := by
    have hx1 := congrArg Prod.fst hpair
    change bZ (badK + 1) = 1 at hx1
    unfold bZ at hx1
    rw [show 3773 + (badK + 1) = badK + 3774 by omega] at hx1
    change ((A355898 (badK + 3774) + 1 : ℕ) : ZMod badP) = 1
    exact hx1
  have hyz1 : ((y + 1 : ℕ) : ZMod badP) = 1 := by
    have hy1 := congrArg Prod.snd hpair
    change bZ badK = 1 at hy1
    unfold bZ at hy1
    rw [show 3773 + badK = badK + 3773 by omega] at hy1
    change ((A355898 (badK + 3773) + 1 : ℕ) : ZMod badP) = 1
    exact hy1
  have hxz : ((x : ℕ) : ZMod badP) = 0 := by
    have h := congrArg (fun z : ZMod badP => z - 1) hxz1
    simpa only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right, sub_self] using h
  have hyz : ((y : ℕ) : ZMod badP) = 0 := by
    have h := congrArg (fun z : ZMod badP => z - 1) hyz1
    simpa only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right, sub_self] using h
  have hpdvdx : badP ∣ x := (ZMod.natCast_eq_zero_iff x badP).1 hxz
  have hpdvdy : badP ∣ y := (ZMod.natCast_eq_zero_iff y badP).1 hyz
  have hxpos : 0 < x := by
    have hxeq := (H (badK + 3774) (by decide)).1
    omega
  have hypos : 0 < y := by
    have hyeq := (H (badK + 3773) (by decide)).1
    omega
  have hpdvdg : badP ∣ g := by
    dsimp [g]
    exact Nat.dvd_gcd hpdvdx hpdvdy
  have hgpos : 0 < g := by
    dsimp [g]
    exact Nat.gcd_pos_of_pos_left y hxpos
  have hg2 : 2 ≤ g := by
    have hp2 : 2 ≤ badP := by decide
    exact le_trans hp2 (Nat.le_of_dvd hgpos hpdvdg)
  have hrec : A355898 badN = g + (x + y) / g := by
    rw [show badN = (badK + 3772) + 3 by decide]
    rw [A355898]
  have hfirst : A355898 badN = 1 + x + y := by
    have hf := (H badN (by decide)).1
    rw [show badN - 1 = badK + 3774 by decide,
        show badN - 2 = badK + 3773 by decide] at hf
    change A355898 badN = 1 + A355898 (badK + 3774) + A355898 (badK + 3773) at hf
    change A355898 badN = 1 + x + y
    exact hf
  have hlt : g + (x + y) / g < 1 + x + y := gcd_step_lt rfl hxpos hypos hg2
  have heq : g + (x + y) / g = 1 + x + y := by
    rw [← hrec, hfirst]
  exact (Nat.ne_of_lt hlt) heq
