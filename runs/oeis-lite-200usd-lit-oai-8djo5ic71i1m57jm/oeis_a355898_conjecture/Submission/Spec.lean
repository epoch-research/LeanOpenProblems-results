lemma base3774_mod : ((A355898 3774 + 1 : ℕ) : ZMod badP) = (99768150822 : ZMod badP) := by
  rw [A3774_cert]
  change ((( + 1 : ℕ) : ZMod badP) = ((99768150822 : ℕ) : ZMod badP))
