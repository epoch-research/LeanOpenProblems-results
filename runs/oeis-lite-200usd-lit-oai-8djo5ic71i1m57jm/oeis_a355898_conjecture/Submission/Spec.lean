lemma A3773_cert : A355898 3773 =  := by
  have h := runCert_sound (p := 1) (q := 1) (u := ) (v := )
    (xs := certTail) (i := 1) rfl rfl (by decide) cert_run
  rw [cert_len] at h
  simpa using h.1.symm

