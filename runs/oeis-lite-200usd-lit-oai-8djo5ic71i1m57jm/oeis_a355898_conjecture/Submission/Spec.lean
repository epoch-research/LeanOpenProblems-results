structure Mat2Z where
  a : ZMod badP
  b : ZMod badP
  c : ZMod badP
  d : ZMod badP
  deriving DecidableEq, Repr

namespace Mat2Z

def mul (X Y : Mat2Z) : Mat2Z :=
  ⟨X.a * Y.a + X.b * Y.c, X.a * Y.b + X.b * Y.d,
   X.c * Y.a + X.d * Y.c, X.c * Y.b + X.d * Y.d⟩

def I : Mat2Z := ⟨1, 0, 0, 1⟩
def M : Mat2Z := ⟨1, 1, 1, 0⟩

def powM : ℕ → Mat2Z :=
  Nat.binaryRec I (fun bit _ P => if bit then mul (mul P P) M else mul P P)

def app (X : Mat2Z) (s : ZMod badP × ZMod badP) : ZMod badP × ZMod badP :=
  (X.a * s.1 + X.b * s.2, X.c * s.1 + X.d * s.2)

lemma app_mul (X Y : Mat2Z) (s : ZMod badP × ZMod badP) :
    app (mul X Y) s = app X (app Y s) := by
  rcases X with ⟨a,b,c,d⟩
  rcases Y with ⟨e,f,g,h⟩
  rcases s with ⟨x,y⟩
  change (((a * e + b * g) * x + (a * f + b * h) * y,
      (c * e + d * g) * x + (c * f + d * h) * y) =
    (a * (e * x + f * y) + b * (g * x + h * y),
      c * (e * x + f * y) + d * (g * x + h * y)))
  apply Prod.ext <;> ring

lemma app_M (s : ZMod badP × ZMod badP) : app M s = (s.1 + s.2, s.1) := by
  cases s
  ext <;> simp only [app, M, one_mul, zero_mul, add_zero]

end Mat2Z

def zstep (s : ZMod badP × ZMod badP) : ZMod badP × ZMod badP := (s.1 + s.2, s.1)

lemma iterate_zstep_add (m n : ℕ) (s : ZMod badP × ZMod badP) :
    (zstep^[m + n]) s = (zstep^[m]) ((zstep^[n]) s) := by
  rw [Function.iterate_add_apply]


lemma zstep_iterate_comm (m : ℕ) (s : ZMod badP × ZMod badP) :
    zstep ((zstep^[m]) s) = (zstep^[m]) (zstep s) := by
  rw [← Function.iterate_succ_apply' zstep m s]
  rw [← Function.iterate_succ_apply zstep m s]

lemma app_powM (n : ℕ) (s : ZMod badP × ZMod badP) :
    Mat2Z.app (Mat2Z.powM n) s = (zstep^[n]) s := by
  suffices h : ∀ s : ZMod badP × ZMod badP, Mat2Z.app (Mat2Z.powM n) s = (zstep^[n]) s from h s
  refine Nat.binaryRec ?base ?bit n
  · intro s
    simp [Mat2Z.powM, Mat2Z.app, Mat2Z.I]
  · intro b n ih s
    cases b
    · rw [Mat2Z.powM, Nat.binaryRec_eq]
      · simp only [Bool.false_eq_true, if_false]
        change Mat2Z.app (Mat2Z.mul (Mat2Z.powM n) (Mat2Z.powM n)) s = (zstep^[bit false n]) s
        rw [Mat2Z.app_mul, ih, ih]
        rw [show bit false n = n + n by simp [bit, two_mul]]
        rw [iterate_zstep_add]
      · left
        decide
    · rw [Mat2Z.powM, Nat.binaryRec_eq]
      · simp only [if_true]
        change Mat2Z.app (Mat2Z.mul (Mat2Z.mul (Mat2Z.powM n) (Mat2Z.powM n)) Mat2Z.M) s = (zstep^[bit true n]) s
        rw [Mat2Z.app_mul, Mat2Z.app_mul, Mat2Z.app_M, ih, ih]
        change (zstep^[n]) ((zstep^[n]) (zstep s)) = (zstep^[bit true n]) s
        rw [show bit true n = n + n + 1 by simp [bit, two_mul, Nat.add_assoc]]
        rw [show (zstep^[n + n + 1]) s = (zstep^[n + n]) (zstep s) by
          rw [show n + n + 1 = (n + n).succ by omega, Function.iterate_succ_apply]]
        rw [iterate_zstep_add]
      · left
        decide

