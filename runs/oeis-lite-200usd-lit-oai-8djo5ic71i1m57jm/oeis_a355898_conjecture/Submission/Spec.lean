def runCert (p q : ℕ) : List ℕ → Option (ℕ × ℕ)
| [] => some (p, q)
| x :: xs => if x = astep p q then runCert q x xs else none

lemma A_step {i : ℕ} (hi : 1 ≤ i) :
    astep (A355898 i) (A355898 (i + 1)) = A355898 (i + 2) := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hi
  rw [show 1 + j = j + 1 by omega]
  change astep (A355898 (j + 1)) (A355898 (j + 2)) = A355898 (j + 3)
  rw [A355898]
  simp [astep]

lemma runCert_sound {p q u v : ℕ} {xs : List ℕ} {i : ℕ}
    (hp : p = A355898 i) (hq : q = A355898 (i + 1)) (hi : 1 ≤ i) :
    runCert p q xs = some (u, v) →
      u = A355898 (i + xs.length) ∧ v = A355898 (i + xs.length + 1) := by
  induction xs generalizing p q i with
  | nil =>
      intro h
      injection h with hpair
      cases hpair
      simp [hp, hq]
  | cons x xs ih =>
      intro h
      by_cases hx : x = astep p q
      · simp [runCert, hx] at h
        have hxA : astep p q = A355898 (i + 2) := by rw [hp, hq, A_step hi]
        have hs := ih (p := q) (q := astep p q) (i := i + 1) hq hxA (by omega) h
        simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hs
      · simp [runCert, hx] at h

lemma cert_run : runCert 1 1 certTail = some (, ) := by
  decide

lemma cert_len : certTail.length = 3772 := by
