private lemma powM_val_1 : Mat2Z.powM 1 = ⟨1, 1, 1, 0⟩ := by
  change Mat2Z.powM (Nat.bit true 0) = ⟨1, 1, 1, 0⟩
  rw [Mat2Z.powM, Nat.binaryRec_eq]
  · simp only [if_true]
    change Mat2Z.mul (Mat2Z.mul (Mat2Z.powM 0) (Mat2Z.powM 0)) Mat2Z.M = ⟨1, 1, 1, 0⟩
    rw [powM_val_0]
    decide
  · right
    intro _
    rfl
