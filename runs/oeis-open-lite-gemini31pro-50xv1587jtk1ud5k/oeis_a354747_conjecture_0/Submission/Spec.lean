section Sqrt3
variable (p : ℕ) [Fact p.Prime]

def mat (A B : ZMod p) : Matrix (Fin 2) (Fin 2) (ZMod p) := ![![A, 3*B], ![B, A]]

lemma mat_mul (A B C D : ZMod p) : mat p A B * mat p C D = mat p (A*C + 3*B*D) (A*D + B*C) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [mat, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma mat_pow_is_mat (A B : ZMod p) (n : ℕ) : ∃ C D : ZMod p, (mat p A B) ^ n = mat p C D := by
  induction n with
  | zero => 
    use 1, 0
    ext i j
    fin_cases i <;> fin_cases j <;> simp [mat]
  | succ n ih =>
    rcases ih with ⟨C, D, hCD⟩
    use C * A + 3 * D * B, C * B + D * A
    rw [pow_succ, hCD, mat_mul]

def ptrace (M : Matrix (Fin 2) (Fin 2) (ZMod p)) : ZMod p := M 0 0 + M 1 1

lemma ptrace_mat (A B : ZMod p) : ptrace p (mat p A B) = 2 * A := by
  dsimp [ptrace, mat]
  ring

lemma det_mat (A B : ZMod p) : (mat p A B).det = A^2 - 3 * B^2 := by
  simp [mat, Matrix.det_fin_two]
  ring

lemma zmod_two_ne_zero (hp2 : p ≠ 2) : (2 : ZMod p) ≠ 0 := by
  intro h
  have hdvd : p ∣ 2 := (CharP.cast_eq_zero_iff (ZMod p) p 2).mp h
  have hp2_eq : p = 2 := Nat.Prime.eq_two_or_odd (Fact.out (p:=Nat.Prime p)) |>.resolve_right (by
    intro h_odd
    have p_ge_2 : p ≥ 2 := Nat.Prime.two_le (Fact.out)
    have hdvd_2 : p ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
    omega
  )
  exact hp2 hp2_eq

lemma eq_one_of_ptrace_eq_two (hp2 : p ≠ 2) (hp3 : p ≠ 3) (A B : ZMod p) (htr : ptrace p (mat p A B) = 2) (hdet : (mat p A B).det = 1) :
  mat p A B = 1 := by
  have hA : 2 * A = 2 := by rw [←ptrace_mat p A B, htr]
  have hA_sub : 2 * (A - 1) = 0 := by linear_combination hA
  cases mul_eq_zero.mp hA_sub with
  | inl h2 => exact False.elim (zmod_two_ne_zero p hp2 h2)
  | inr hA1 =>
    have hA_eq_1 : A = 1 := sub_eq_zero.mp hA1
    have hdet2 : A^2 - 3 * B^2 = 1 := by rw [←det_mat p A B, hdet]
    rw [hA_eq_1] at hdet2
    have hB : 3 * B^2 = 0 := by
      calc 3 * B^2 = 1^2 - (1^2 - 3 * B^2) := by ring
        _ = 1 - 1 := by rw [hdet2, one_pow]
        _ = 0 := by ring
    have h3 : (3 : ZMod p) ≠ 0 := by
      intro h
      have hdvd : p ∣ 3 := (CharP.cast_eq_zero_iff (ZMod p) p 3).mp h
      have hp3_eq : p = 3 := Nat.Prime.eq_one_or_self_of_dvd (by norm_num) p hdvd |>.resolve_left (Fact.out (p:=Nat.Prime p)).ne_one
      exact hp3 hp3_eq
    cases mul_eq_zero.mp hB with
    | inl h3_0 => exact False.elim (h3 h3_0)
    | inr hB2 =>
      have hB_eq_0 : B = 0 := sq_eq_zero_iff.mp hB2
      ext i j
      fin_cases i <;> fin_cases j <;> simp [hA_eq_1, hB_eq_0, mat] <;> rfl

def sW : Matrix (Fin 2) (Fin 2) (ZMod p) := ![![0, 3], ![1, 0]]
def sTwo : Matrix (Fin 2) (Fin 2) (ZMod p) := ![![2, 0], ![0, 2]]

lemma sW_sq : sW p ^ 2 = ![![3, 0], ![0, 3]] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sW, sq, Matrix.mul_apply, Fin.sum_univ_two]

lemma sW_pow_even (k : ℕ) : sW p ^ (2 * k) = (3^k : ZMod p) • 1 := by
  induction k with
  | zero => simp
  | succ k ih =>
    have h : sW p ^ (2 * (k + 1)) = sW p ^ (2 * k) * sW p ^ 2 := by
      rw [mul_add, mul_one, pow_add]
    rw [h, ih, sW_sq p]
    have h3 : ![![3, 0], ![0, 3]] = (3 : ZMod p) • (1 : Matrix (Fin 2) (Fin 2) (ZMod p)) := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.smul_apply]
    rw [h3, Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul, smul_smul, pow_succ]

lemma sW_pow_p (hp2 : p ≠ 2) : sW p ^ p = (3^((p-1)/2) : ZMod p) • sW p := by
  have hp_odd : p = 2 * ((p-1)/2) + 1 := by
    have hp_odd2 : p % 2 = 1 := Nat.Prime.eq_two_or_odd (Fact.out) |>.resolve_left hp2
    omega
  have h_pow : sW p ^ p = sW p ^ (2 * ((p-1)/2) + 1) := congrArg (fun n => sW p ^ n) hp_odd
  rw [h_pow, pow_add, pow_one, sW_pow_even p ((p-1)/2)]
  have h_smul : (3^((p-1)/2) : ZMod p) • (1 : Matrix (Fin 2) (Fin 2) (ZMod p)) * sW p = (3^((p-1)/2) : ZMod p) • (1 * sW p) := Matrix.smul_mul _ _ _
  rw [h_smul, Matrix.one_mul]

lemma sTwo_eq_two : sTwo p = 2 := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

lemma sW_comm_two : Commute (sTwo p) (sW p) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sW, sTwo, Matrix.mul_apply, Fin.sum_univ_two]
  · ring

lemma add_pow_p : (sTwo p + sW p) ^ p = sTwo p + sW p ^ p := by
  haveI : CharP (Matrix (Fin 2) (Fin 2) (ZMod p)) p := inferInstance
  have h_add := add_pow_char_of_commute p (sW_comm_two p)
  have h_zmod : (2 : ZMod p) ^ p = 2 := ZMod.pow_card 2
  have h_pow2 : sTwo p ^ p = sTwo p := by
    rw [sTwo_eq_two]
    have h_map : (2 : Matrix (Fin 2) (Fin 2) (ZMod p)) = (algebraMap (ZMod p) (Matrix (Fin 2) (Fin 2) (ZMod p))) 2 := by rfl
    rw [h_map, ←map_pow, h_zmod]
  rw [h_pow2] at h_add
  exact h_add

lemma two_add_sw_inv : (sTwo p + sW p) * (sTwo p - sW p) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sW, sTwo, Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply] <;> ring

lemma two_add_sw_inv2 : (sTwo p - sW p) * (sTwo p + sW p) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sW, sTwo, Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply] <;> ring

lemma sW_root_order (hp2 : p ≠ 2) (hp3 : p ≠ 3) : 
  (sTwo p + sW p)^(p-1) = 1 ∨ (sTwo p + sW p)^(p+1) = 1 := by
  let k : ZMod p := 3^((p-1)/2)
  have hk2 : k^2 = 1 := by
    dsimp [k]
    have hp_odd : p - 1 = 2 * ((p-1)/2) := by
      have hp_odd2 : p % 2 = 1 := Nat.Prime.eq_two_or_odd (Fact.out) |>.resolve_left hp2
      omega
    have h_pow2 : (3^((p-1)/2) : ZMod p)^2 = 3^(p-1) := by
      rw [←pow_mul, mul_comm, ←hp_odd]
    rw [h_pow2]
    have h_3_ne_0 : (3 : ZMod p) ≠ 0 := by
      intro h
      have h_dvd : p ∣ 3 := (CharP.cast_eq_zero_iff (ZMod p) p 3).mp h
      have hp3_eq : p = 3 := Nat.Prime.eq_one_or_self_of_dvd (by norm_num) p h_dvd |>.resolve_left (Fact.out (p:=Nat.Prime p)).ne_one
      exact hp3 hp3_eq
    exact ZMod.pow_card_sub_one_eq_one h_3_ne_0
  have hk_eq : k = 1 ∨ k = -1 := sq_eq_one_iff.mp hk2
  cases hk_eq with
  | inl h1 =>
    left
    have h_pow : (sTwo p + sW p)^p = sTwo p + sW p := by
      rw [add_pow_p p]
      have h_sw : sW p ^ p = sW p := by
        rw [sW_pow_p p hp2]
        rw [show (3^((p-1)/2) : ZMod p) = k from rfl]
        rw [h1, one_smul]
      rw [h_sw]
    have h_pow2 : (sTwo p + sW p)^p = (sTwo p + sW p)^(p-1) * (sTwo p + sW p) := by
      have hp_pos : p > 0 := Nat.Prime.pos (Fact.out)
      rw [←pow_succ, Nat.sub_add_cancel (by omega)]
    rw [h_pow2] at h_pow
    have h_assoc : (sTwo p + sW p)^(p-1) * ((sTwo p + sW p) * (sTwo p - sW p)) = (sTwo p + sW p)^(p-1) * (sTwo p + sW p) * (sTwo p - sW p) := (Matrix.mul_assoc _ _ _).symm
    calc (sTwo p + sW p)^(p-1) = (sTwo p + sW p)^(p-1) * 1 := by rw [Matrix.mul_one]
      _ = (sTwo p + sW p)^(p-1) * ((sTwo p + sW p) * (sTwo p - sW p)) := by rw [two_add_sw_inv p]
      _ = (sTwo p + sW p)^(p-1) * (sTwo p + sW p) * (sTwo p - sW p) := h_assoc
      _ = (sTwo p + sW p) * (sTwo p - sW p) := by rw [h_pow]
      _ = 1 := by rw [two_add_sw_inv p]
  | inr h_minus_1 =>
    right
    have h_pow : (sTwo p + sW p)^p = sTwo p - sW p := by
      rw [add_pow_p p]
      have h_sw : sW p ^ p = - sW p := by
        rw [sW_pow_p p hp2]
        rw [show (3^((p-1)/2) : ZMod p) = k from rfl]
        rw [h_minus_1, neg_one_smul]
      rw [h_sw]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [sTwo, sW]
    have h_pow2 : (sTwo p + sW p)^(p+1) = (sTwo p + sW p)^p * (sTwo p + sW p) := by
      rw [pow_succ]
    rw [h_pow2, h_pow]
    exact two_add_sw_inv2 p

end Sqrt3

section MatGcd
variable {R : Type} [CommRing R]

lemma mat_pow_mod (M : Matrix (Fin 2) (Fin 2) R) (a b : ℕ) (ha : M ^ a = 1) : M ^ (b % a) = M ^ b := by
  have h_div : a * (b / a) + b % a = b := Nat.div_add_mod b a
  calc M ^ (b % a) = 1 * M ^ (b % a) := by rw [Matrix.one_mul]
    _ = (M ^ a) ^ (b / a) * M ^ (b % a) := by rw [ha, one_pow]
    _ = M ^ (a * (b / a)) * M ^ (b % a) := by rw [pow_mul]
    _ = M ^ (a * (b / a) + b % a) := by rw [pow_add]
    _ = M ^ b := by rw [h_div]

lemma mat_pow_gcd (M : Matrix (Fin 2) (Fin 2) R) (a b : ℕ) (ha : M ^ a = 1) (hb : M ^ b = 1) : M ^ (Nat.gcd a b) = 1 := by
  revert a b
  intro a b
  induction a, b using Nat.gcd.induction with
  | H0 n => 
    intro _ hn
    rw [Nat.gcd_zero_left]
    exact hn
  | H1 m n m_pos ih =>
    intro hm hn
    have h_mod := mat_pow_mod M m n hm
    rw [hn] at h_mod
    have h_gcd : Nat.gcd m n = Nat.gcd (n % m) m := by rw [Nat.gcd_rec m n]
    rw [h_gcd]
    exact ih h_mod hm

lemma dvd_pow_3_of_lt {k m : ℕ} (hk : k < 3^m) (hdvd : k ∣ 3^m) : k ∣ 3^(m-1) := by
  have h_prime : Nat.Prime 3 := by norm_num
  obtain ⟨j, hj, hk_eq⟩ := (Nat.dvd_prime_pow h_prime).mp hdvd
  have hj_lt : j < m := by
    rw [hk_eq] at hk
    exact (Nat.pow_lt_pow_iff_right h_prime.one_lt).mp hk
  have hj_le : j ≤ m - 1 := Nat.le_sub_one_of_lt hj_lt
  rw [hk_eq]
  exact Nat.pow_dvd_pow 3 hj_le

lemma mat_pow_not_div (M : Matrix (Fin 2) (Fin 2) R) (m k : ℕ) (h_m : M ^ (3^m) = 1) (h_prev : M ^ (3^(m-1)) ≠ 1) (hk : M ^ k = 1) : 3^m ∣ k := by
  by_contra h_ndvd
  have h_gcd : M ^ (Nat.gcd k (3^m)) = 1 := mat_pow_gcd M k (3^m) hk h_m
  have h_dvd1 : Nat.gcd k (3^m) ∣ 3^m := Nat.gcd_dvd_right k (3^m)
  have h_lt : Nat.gcd k (3^m) < 3^m := by
    have h_le : Nat.gcd k (3^m) ≤ 3^m := Nat.le_of_dvd (by positivity) h_dvd1
    exact lt_of_le_of_ne h_le (by
      intro h_eq
      have h_dvd2 : Nat.gcd k (3^m) ∣ k := Nat.gcd_dvd_left k (3^m)
      rw [h_eq] at h_dvd2
      exact h_ndvd h_dvd2
    )
  have h_dvd2 : Nat.gcd k (3^m) ∣ 3^(m-1) := dvd_pow_3_of_lt h_lt h_dvd1
  obtain ⟨c, hc⟩ := h_dvd2
  have h_pow : M ^ (3^(m-1)) = 1 := by
    calc M ^ (3^(m-1)) = M ^ (Nat.gcd k (3^m) * c) := by rw [hc]
      _ = (M ^ (Nat.gcd k (3^m))) ^ c := by rw [pow_mul]
      _ = (1 : Matrix (Fin 2) (Fin 2) R) ^ c := by rw [h_gcd]
      _ = 1 := one_pow c
  exact h_prev h_pow

end MatGcd


section Traces
variable {R : Type} [CommRing R]

def tr (M : Matrix (Fin 2) (Fin 2) R) : R := M 0 0 + M 1 1

lemma tr_cube_of_det_one (M : Matrix (Fin 2) (Fin 2) R) (h_det : M.det = 1) :
  tr (M ^ 3) = (tr M)^3 - 3 * tr M := by
  have hM3 : M ^ 3 = M * M * M := by
    calc M ^ 3 = M ^ 2 * M := by rw [pow_succ]
      _ = (M * M) * M := by rw [pow_two]
  rw [hM3]
  have h_det2 : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    calc M 0 0 * M 1 1 - M 0 1 * M 1 0 = M.det := Matrix.det_fin_two M |>.symm
      _ = 1 := h_det
  simp only [tr, Matrix.mul_apply, Fin.sum_univ_two]
  linear_combination (-3 * M 0 0 - 3 * M 1 1) * h_det2

def step (T : R) : R := T^3 - 3 * T

def step_n : ℕ → R → R
| 0, T => T
| n + 1, T => step (step_n n T)

lemma tr_M_3_pow (A : Matrix (Fin 2) (Fin 2) R) (h_det : A.det = 1) (m : ℕ) :
  tr (A ^ (3^m)) = step_n m (tr A) := by
  induction m with
  | zero => 
    simp [step_n]
  | succ m ih =>
    have h_pow : A ^ (3^(m+1)) = (A ^ (3^m)) ^ 3 := by
      calc A ^ (3^(m+1)) = A ^ (3^m * 3) := by rw [pow_succ]
        _ = (A ^ (3^m)) ^ 3 := by rw [pow_mul]
    rw [h_pow]
    have h_det_pow : (A ^ (3^m)).det = 1 := by
      rw [Matrix.det_pow, h_det, one_pow]
    rw [tr_cube_of_det_one (A ^ (3^m)) h_det_pow]
    rw [ih]
    rfl

end Traces





def step_mod_test (N v : ℕ) : ℕ :=
  let v2 := (v * v) % N
  let v3 := (v2 * v) % N
  (v3 + 3 * (N - (v % N))) % N

lemma zmod_dvd (p N : ℕ) [Fact p.Prime] (h_p : p ∣ N) : (N : ZMod p) = 0 := by
  exact (CharP.cast_eq_zero_iff (ZMod p) p N).mpr h_p

lemma mod_cast_p (p N x : ℕ) [Fact p.Prime] (h_p : p ∣ N) : ((x % N : ℕ) : ZMod p) = (x : ZMod p) := by
  have h_eq : x = N * (x / N) + x % N := (Nat.div_add_mod x N).symm
  have h_cast : (x : ZMod p) = ((N * (x / N) + x % N : ℕ) : ZMod p) := by nth_rw 1 [h_eq]
  rw [Nat.cast_add, Nat.cast_mul] at h_cast
  rw [zmod_dvd p N h_p, zero_mul, zero_add] at h_cast
  exact h_cast.symm

lemma step_mod_test_p (p N v : ℕ) [Fact p.Prime] (h_p : p ∣ N) (hN_pos : N > 0) :
  (step_mod_test N v : ZMod p) = (v : ZMod p)^3 - 3 * (v : ZMod p) := by
  dsimp [step_mod_test]
  have hN : (N : ZMod p) = 0 := zmod_dvd p N h_p
  have h1 : ((((v * v) % N * v) % N : ℕ) : ZMod p) = (v : ZMod p)^3 := by
    calc ((((v * v) % N * v) % N : ℕ) : ZMod p) = (((v * v) % N * v : ℕ) : ZMod p) := mod_cast_p p N _ h_p
      _ = (((v * v) % N : ℕ) : ZMod p) * (v : ZMod p) := by rw [Nat.cast_mul]
      _ = ((v * v : ℕ) : ZMod p) * (v : ZMod p) := by rw [mod_cast_p p N _ h_p]
      _ = (v : ZMod p)^3 := by push_cast; ring
  calc (((v * v % N * v % N + 3 * (N - v % N)) % N : ℕ) : ZMod p)
    _ = ((v * v % N * v % N + 3 * (N - v % N) : ℕ) : ZMod p) := mod_cast_p p N _ h_p
    _ = (((v * v % N * v % N) : ℕ) : ZMod p) + (3 : ZMod p) * (((N - v % N) : ℕ) : ZMod p) := by push_cast; rfl
    _ = (v : ZMod p)^3 + 3 * (((N - v % N) : ℕ) : ZMod p) := by rw [h1]
    _ = (v : ZMod p)^3 + 3 * ((N : ZMod p) - ((v % N : ℕ) : ZMod p)) := by
      have h_sub : (((N - v % N) : ℕ) : ZMod p) = (N : ZMod p) - ((v % N : ℕ) : ZMod p) := by
        apply Nat.cast_sub
        exact le_of_lt (Nat.mod_lt v hN_pos)
      rw [h_sub]
    _ = (v : ZMod p)^3 + 3 * (0 - (v : ZMod p)) := by rw [hN, mod_cast_p p N v h_p]
    _ = (v : ZMod p)^3 - 3 * (v : ZMod p) := by ring



def step_mod_n_test (N : ℕ) : ℕ → ℕ → ℕ
| 0, v => v
| k + 1, v => step_mod_n_test N k (step_mod_test N v)

lemma step_n_bottom_up {R : Type} [CommRing R] (k : ℕ) (T : R) :
  step_n (k + 1) T = step_n k (step T) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    calc step_n (k + 1 + 1) T = step (step_n (k + 1) T) := rfl
      _ = step (step_n k (step T)) := by rw [ih]
      _ = step_n (k + 1) (step T) := rfl

lemma step_mod_n_test_p (p N v k : ℕ) [Fact p.Prime] (h_p : p ∣ N) (hN_pos : N > 0) :
  (step_mod_n_test N k v : ZMod p) = step_n k (v : ZMod p) := by
  induction k generalizing v with
  | zero => rfl
  | succ k ih =>
    calc (step_mod_n_test N (k + 1) v : ZMod p) = (step_mod_n_test N k (step_mod_test N v) : ZMod p) := rfl
      _ = step_n k (step_mod_test N v : ZMod p) := ih (step_mod_test N v)
      _ = step_n k (step (v : ZMod p)) := by 
        have h_step : (step_mod_test N v : ZMod p) = step (v : ZMod p) := step_mod_test_p p N v h_p hN_pos
        rw [h_step]
      _ = step_n (k + 1) (v : ZMod p) := (step_n_bottom_up k (v : ZMod p)).symm




lemma int_cast_eq {N p : ℕ} (h_dvd : p ∣ N) (a : ℤ) (h_eq : (a : ZMod N) = 0) : (a : ZMod p) = 0 := by
  have hdvd_a : (N : ℤ) ∣ a := (CharP.intCast_eq_zero_iff (ZMod N) N a).mp h_eq
  have hdvd_a_p : (p : ℤ) ∣ a := dvd_trans (Int.ofNat_dvd.mpr h_dvd) hdvd_a
  exact (CharP.intCast_eq_zero_iff (ZMod p) p a).mpr hdvd_a_p


lemma eq_zero_of_idempotent {N e : ℕ} (hN : N > 0) 
  (h_idem : N ∣ e * (e - 1)) 
  (h_prime : ∀ p : ℕ, p.Prime → p ∣ N → p ∣ e) : N ∣ e := by
  by_cases he : e = 0
  · rw [he]; exact dvd_zero N
  · have h_coprime : Nat.Coprime N (e - 1) := by
      rw [Nat.Coprime, Nat.gcd_comm]
      by_contra h_not_coprime
      have h_gcd_gt_1 : Nat.gcd (e - 1) N > 1 := by
        have h_gcd_ne_0 : Nat.gcd (e - 1) N ≠ 0 := by
          intro h0
          have := Nat.gcd_eq_zero_iff.mp h0
          omega
        omega
      obtain ⟨p, hp_prime, hp_dvd⟩ := Nat.exists_prime_and_dvd h_gcd_gt_1.ne'
      have hp_N : p ∣ N := Nat.dvd_trans hp_dvd (Nat.gcd_dvd_right _ _)
      have hp_e_sub_1 : p ∣ e - 1 := Nat.dvd_trans hp_dvd (Nat.gcd_dvd_left _ _)
      have hp_e : p ∣ e := h_prime p hp_prime hp_N
      have hp_1 : p ∣ 1 := by
        have h1 : e = (e - 1) + 1 := by omega
        rw [h1] at hp_e
        exact (Nat.dvd_add_right hp_e_sub_1).mp hp_e
      exact Nat.Prime.not_dvd_one hp_prime hp_1
    exact Nat.Coprime.dvd_of_dvd_mul_right h_coprime h_idem

lemma zmod_eq_zero_of_y_eq_y_sq_c {N : ℕ} [NeZero N] (y c : ZMod N) (hy : y = y^2 * c)
  (h_prime : ∀ p : ℕ, p.Prime → p ∣ N → p ∣ y.val) : y = 0 := by
  let e := c * y
  have he : e = e^2 := by
    calc e = c * y := rfl
      _ = c * (y^2 * c) := by rw [←hy]
      _ = c^2 * y^2 := by ring
      _ = (c * y)^2 := by ring
      _ = e^2 := rfl
  have he_zero : e * (e - 1) = 0 := by
    calc e * (e - 1) = e^2 - e := by ring
      _ = e - e := by rw [←he]
      _ = 0 := sub_self e
  by_cases he_val : e.val = 0
  · have he_eq_0 : e = 0 := by
      calc e = (e.val : ZMod N) := by simp
        _ = (0 : ℕ) := by rw [he_val]
        _ = 0 := Nat.cast_zero
    calc y = y^2 * c := hy
      _ = y * (c * y) := by ring
      _ = y * e := rfl
      _ = y * 0 := by rw [he_eq_0]
      _ = 0 := mul_zero y
  · have he_pos : e.val > 0 := Nat.pos_of_ne_zero he_val
    have hN : N > 0 := NeZero.pos N
    have hdvd_idem : N ∣ e.val * (e.val - 1) := by
      have h_cast : (((e.val * (e.val - 1) : ℕ) : ZMod N)) = 0 := by
        have h_sub : ((e.val - 1 : ℕ) : ZMod N) = e - 1 := by
          have h1 : ((e.val - 1 + 1 : ℕ) : ZMod N) = (e.val : ZMod N) := by
            rw [Nat.sub_add_cancel he_pos]
          have h2 : ((e.val - 1 : ℕ) : ZMod N) + 1 = e := by
            calc ((e.val - 1 : ℕ) : ZMod N) + 1 = ((e.val - 1 : ℕ) : ZMod N) + (1 : ℕ) := by rw [Nat.cast_one]
              _ = (((e.val - 1 + 1) : ℕ) : ZMod N) := (Nat.cast_add _ _).symm
              _ = (e.val : ZMod N) := h1
              _ = e := by simp
          calc ((e.val - 1 : ℕ) : ZMod N) = ((e.val - 1 : ℕ) : ZMod N) + 1 - 1 := by ring
            _ = e - 1 := by rw [h2]
        calc (((e.val * (e.val - 1) : ℕ) : ZMod N)) = (e.val : ZMod N) * ((e.val - 1 : ℕ) : ZMod N) := Nat.cast_mul _ _
          _ = e * ((e.val - 1 : ℕ) : ZMod N) := by
            have : (e.val : ZMod N) = e := by simp
            rw [this]
          _ = e * (e - 1) := by rw [h_sub]
          _ = 0 := he_zero
      exact (CharP.cast_eq_zero_iff (ZMod N) N (e.val * (e.val - 1))).mp h_cast
    have he_zero2 : N ∣ e.val := by
      apply eq_zero_of_idempotent hN hdvd_idem
      intro p hp hpN
      have hy_p : p ∣ y.val := h_prime p hp hpN
      have he_val_eq : e.val = (c.val * y.val) % N := ZMod.val_mul c y
      have hp_cy : p ∣ c.val * y.val := dvd_mul_of_dvd_right hy_p c.val
      have h_eq : c.val * y.val = N * (c.val * y.val / N) + e.val := by
        rw [he_val_eq]
        exact (Nat.div_add_mod (c.val * y.val) N).symm
      have hp_N_mul : p ∣ N * (c.val * y.val / N) := dvd_mul_of_dvd_left hpN _
      have hp_add : p ∣ N * (c.val * y.val / N) + e.val := by
        rw [←h_eq]
        exact hp_cy
      exact (Nat.dvd_add_right hp_N_mul).mp hp_add
    have he_zero3 : e = 0 := by
      calc e = (e.val : ZMod N) := by simp
        _ = 0 := (CharP.cast_eq_zero_iff (ZMod N) N e.val).mpr he_zero2
    calc y = y^2 * c := hy
      _ = y * (c * y) := by ring
      _ = y * e := rfl
      _ = y * 0 := by rw [he_zero3]
      _ = 0 := mul_zero y


lemma y_eq_y_sq_c_of_x_cube_eq (N : ℕ) [NeZero N] (h3 : Nat.gcd 3 N = 1) (x : ZMod N) (h_eq : x^3 - 3 * x - 2 = 0) :
  ∃ c : ZMod N, (x - 2) = (x - 2)^2 * c := by
  let y := x - 2
  have h1 : (y + 3)^2 * y = 0 := by
    calc (y + 3)^2 * y = y^3 + 6 * y^2 + 9 * y := by ring
      _ = x^3 - 3 * x - 2 := by
        dsimp [y]
        ring
      _ = 0 := h_eq
  have h2 : 9 * y = - y^2 * (y + 6) := by
    calc 9 * y = (y + 3)^2 * y - y^2 * (y + 6) := by ring
      _ = 0 - y^2 * (y + 6) := by rw [h1]
      _ = - y^2 * (y + 6) := by ring
  have h3_unit : IsUnit (3 : ZMod N) := by
    have h_gcd : Nat.gcd 3 N = 1 := h3
    exact (ZMod.unitOfCoprime 3 h_gcd).isUnit
  have h9_unit : IsUnit (9 : ZMod N) := by
    have : (9 : ZMod N) = 3^2 := by norm_num
    rw [this]
    exact IsUnit.pow 2 h3_unit
  obtain ⟨inv9, hinv9⟩ := h9_unit.exists_right_inv
  use - (y + 6) * inv9
  calc y = (9 * y) * inv9 := by rw [mul_comm 9, mul_assoc, hinv9, mul_one]
    _ = (- y^2 * (y + 6)) * inv9 := by rw [h2]
    _ = y^2 * (- (y + 6) * inv9) := by ring

lemma not_prime_of_sequence (N : ℕ) [NeZero N] (h3 : Nat.gcd 3 N = 1) (x : ℕ)
  (h_cube : (x : ZMod N)^3 - 3 * (x : ZMod N) - 2 = 0)
  (hx_ne : (x : ZMod N) ≠ 2)
  (hp_cond : ∀ p : ℕ, p.Prime → p ∣ N → (x : ZMod p) = 2) : False := by
  obtain ⟨c, hc⟩ := y_eq_y_sq_c_of_x_cube_eq N h3 (x : ZMod N) h_cube
  let y := (x : ZMod N) - 2
  have h_y_zero : y = 0 := by
    apply zmod_eq_zero_of_y_eq_y_sq_c y c hc
    intro p hp hpN
    have hy_p : ((y.val : ℤ) : ZMod p) = 0 := by
      let a : ℤ := (y.val : ℤ) - ((x : ℤ) - 2)
      have h1 : (a : ZMod N) = 0 := by
        dsimp [a]
        push_cast
        calc (y.val : ZMod N) - ((x : ZMod N) - 2) = y - ((x : ZMod N) - 2) := by simp
          _ = ((x : ZMod N) - 2) - ((x : ZMod N) - 2) := rfl
          _ = 0 := sub_self _
      have h2 : (a : ZMod p) = 0 := int_cast_eq hpN a h1
      have h3_p : ((x : ℤ) - 2 : ZMod p) = 0 := by
        push_cast
        rw [hp_cond p hp hpN]
        ring
      calc ((y.val : ℤ) : ZMod p) = (a : ZMod p) + ((x : ℤ) - 2 : ZMod p) := by dsimp [a]; push_cast; ring
        _ = 0 + 0 := by rw [h2, h3_p]
        _ = 0 := add_zero 0
    exact Int.ofNat_dvd.mp ((CharP.intCast_eq_zero_iff (ZMod p) p y.val).mp hy_p)
  have hx_eq_2 : (x : ZMod N) = 2 := by
    calc (x : ZMod N) = y + 2 := by dsimp [y]; ring
      _ = 0 + 2 := by rw [h_y_zero]
      _ = 2 := by ring
  exact hx_ne hx_eq_2




lemma k_eq_one_of_mod (q k a : ℕ) (hq : q > 201886 + 1) (hk : k ≤ 201886) (hk_pos : k > 0)
  (h_eq : 201886 * q - 1 = k * (a * q - 1) ∨ 201886 * q - 1 = k * (a * q + 1)) : k = 1 := by
  have hq_pos : q > 0 := by omega
  cases h_eq with
  | inl h_minus =>
    have haq : a * q ≥ 1 := by
      by_contra haq_zero
      have : a * q = 0 := by omega
      rw [this] at h_minus
      have : k * (0 - 1) = 0 := by rfl
      rw [this] at h_minus
      omega
    have h1 : (201886 : ℤ) * q - 1 = (k : ℤ) * (a * q - 1) := by
      have h_nat : 201886 * q ≥ 1 := by omega
      zify [h_nat, haq] at h_minus
      exact h_minus
    have h2 : (k : ℤ) - 1 = ((k : ℤ) * a - 201886) * q := by
      calc (k : ℤ) - 1 = (k : ℤ) * a * q - 201886 * q := by linear_combination h1
        _ = ((k : ℤ) * a - 201886) * q := by ring
    have h3 : (q : ℤ) ∣ (k : ℤ) - 1 := ⟨(k : ℤ) * a - 201886, by rw [h2, mul_comm]⟩
    obtain ⟨c, hc⟩ := h3
    have hk_bound : (k : ℤ) - 1 < q := by omega
    have hk_bound2 : (k : ℤ) - 1 ≥ 0 := by omega
    have hc_0 : c = 0 := by
      by_contra hc_ne
      rcases lt_trichotomy c 0 with hc_lt | hc_eq | hc_gt
      · have : (q : ℤ) * c < 0 := mul_neg_of_pos_of_neg (by omega) hc_lt
        omega
      · exact hc_ne hc_eq
      · have : (q : ℤ) * c ≥ q := by
          calc (q : ℤ) * c ≥ q * 1 := mul_le_mul_of_nonneg_left (by omega) (by omega)
            _ = q := mul_one _
        omega
    rw [hc_0, mul_zero] at hc
    omega
  | inr h_plus =>
    have h1 : (201886 : ℤ) * q - 1 = (k : ℤ) * (a * q + 1) := by
      have h_nat : 201886 * q ≥ 1 := by omega
      zify [h_nat] at h_plus
      exact h_plus
    have h2 : (k : ℤ) + 1 = (201886 - (k : ℤ) * a) * q := by
      calc (k : ℤ) + 1 = 201886 * q - (k : ℤ) * a * q := by linear_combination -h1
        _ = (201886 - (k : ℤ) * a) * q := by ring
    have h3 : (q : ℤ) ∣ (k : ℤ) + 1 := ⟨201886 - (k : ℤ) * a, by rw [h2, mul_comm]⟩
    obtain ⟨c, hc⟩ := h3
    have hk_bound : (k : ℤ) + 1 < q := by omega
    have hk_bound2 : (k : ℤ) + 1 > 0 := by omega
    have hc_0 : c = 0 := by
      by_contra hc_ne
      rcases lt_trichotomy c 0 with hc_lt | hc_eq | hc_gt
      · have : (q : ℤ) * c < 0 := mul_neg_of_pos_of_neg (by omega) hc_lt
        omega
      · exact hc_ne hc_eq
      · have : (q : ℤ) * c ≥ q := by
          calc (q : ℤ) * c ≥ q * 1 := mul_le_mul_of_nonneg_left (by omega) (by omega)
            _ = q := mul_one _
        omega
    rw [hc_0, mul_zero] at hc
    omega



def q : ℕ := 3^39101
lemma q_def : q = 3^39101 := rfl
attribute [irreducible] q

set_option exponentiation.threshold 200000
lemma N_eq : 2 * 100943 * q - 1 = N := by rw [q_def]; decide


lemma M_eq_mat_s (p : ℕ) [Fact p.Prime] : sTwo p + sW p = mat p 2 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [mat, sW, sTwo, Matrix.add_apply] <;> ring

lemma M_det (p : ℕ) [Fact p.Prime] : (mat p 2 1).det = 1 := by
  rw [det_mat]
  ring

lemma M_trace (p : ℕ) [Fact p.Prime] : tr (mat p 2 1) = 4 := by
  have h1 : tr (mat p 2 1) = ptrace p (mat p 2 1) := rfl
  rw [h1, ptrace_mat]
  norm_num

lemma nat_prime_of_pock (N_val : ℕ) (hN_gt_1 : N_val > 1) 
  (h_pock : ∃ p : ℕ, p.Prime ∧ p ∣ N_val ∧ p = N_val) : Nat.Prime N_val := by
  rcases h_pock with ⟨p, hp, hdvd, heq⟩
  rw [←heq]
  exact hp

lemma p_ge_of_divides (p m : ℕ) (h_div : m ∣ p - 1 ∨ m ∣ p + 1) (hp : p ≥ 2) (hm : m > 0) : p ≥ m - 1 := by
  cases h_div with
  | inl h1 =>
    have h1_pos : p - 1 > 0 := by omega
    have h1_le : m ≤ p - 1 := Nat.le_of_dvd h1_pos h1
    omega
  | inr h2 =>
    have h2_pos : p + 1 > 0 := by omega
    have h2_le : m ≤ p + 1 := Nat.le_of_dvd h2_pos h2
    omega


lemma pow_pos_3 (m : ℕ) : 3^m ≥ 1 := by
  induction m with
  | zero => exact Nat.le_refl 1
  | succ m ih =>
    rw [pow_succ]
    omega

lemma M_p_order_ge (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (hp3 : p ≠ 3)
  (M : Matrix (Fin 2) (Fin 2) (ZMod p)) (m : ℕ) (hm : m > 0)
  (h_pow_m : M ^ (3^m) = 1) (h_pow_prev : M ^ (3^(m-1)) ≠ 1)
