def step_mod (v : ℕ) : ℕ :=
  let v2 := (v * v) % N
  let v3 := (v2 * v) % N
  (v3 + 3 * (N - (v % N))) % N

def step_mod_n : ℕ → ℕ → ℕ
| 0, v => v
| k + 1, v => step_mod_n k (step_mod v)

