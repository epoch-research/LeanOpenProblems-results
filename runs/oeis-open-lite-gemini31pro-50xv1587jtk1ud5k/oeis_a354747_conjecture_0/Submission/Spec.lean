lemma step_mod_n_add (a b v : ℕ) : step_mod_n (a + b) v = step_mod_n a (step_mod_n b v) := by
  induction b generalizing v with
  | zero => rw [Nat.add_zero]; rfl
  | succ b ih =>
    rw [Nat.add_succ]
    exact ih (step_mod v)

