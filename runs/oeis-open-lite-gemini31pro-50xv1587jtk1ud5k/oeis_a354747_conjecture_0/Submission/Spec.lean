lemma N_is_prime : Nat.Prime N := by
  haveI : NeZero N := ⟨hN_pos.ne.symm⟩
  apply nat_prime_of_pock N hN_gt_1
  
  -- have h_v39101 : step_mod_test N (step_mod_n_test N 39100 V0) = 2 := t41
  -- generalize hx : step_mod_n_test N 39100 V0 = x
  -- rw [hx] at h_v39101
  let x : ℕ := 
  have h_cube : ((x : ZMod N)^3 - 3 * (x : ZMod N) - 2) = 0 := by decide
    
  have hx_ne : (x : ZMod N) ≠ 2 := by decide
    
  by_contra h_pock_not
  push_neg at h_pock_not
  have h_p : ∃ p : ℕ, p.Prime ∧ p ∣ N ∧ (x : ZMod p) ≠ 2 := by
    by_contra h_all
    push_neg at h_all
    exact not_prime_of_sequence N hN_coprime x h_cube hx_ne h_all
  
  rcases h_p with ⟨p, hp, hdvd, hp_ne_2⟩
  haveI : Fact p.Prime := ⟨hp⟩
  have hp2 : p ≠ 2 := by
    intro h
    subst h
    have h_mod2 : N % 2 = 1 := by
      rw [←N_eq, q_def]
      omega
    have : N % 2 = 0 := Nat.mod_eq_zero_of_dvd hdvd
    omega
  have hp3 : p ≠ 3 := by
    intro h
    subst h
    have h_mod3 : N % 3 = 2 := by
      rw [←N_eq, q_def]
      have h3_pos : 3 > 0 := by omega
      have h_pow_pos : 3 ^ 39101 = 3 * 3 ^ 39100 := by rfl
      rw [h_pow_pos]
      omega
    have : N % 3 = 0 := Nat.mod_eq_zero_of_dvd hdvd
    omega
    
  let M0 := mat p 2 1
  let M := M0 ^ 201886
  have h_det_M0 : M0.det = 1 := M_det p
  have h_det : M.det = 1 := by
    dsimp [M]
    rw [Matrix.det_pow, h_det_M0, one_pow]
  have h_tr : tr M = (V0 : ZMod p) := h_tr_eval p hp_dvd

  
  have h_pow_m : M ^ (3^39101) = 1 := by
    have h_tr_pow : tr (M ^ (3^39101)) = step_n 39101 (tr M) := tr_M_3_pow M h_det 39101
    rw [h_tr] at h_tr_pow
    have h_test_eq : step_mod_n_test N 39101 V0 = step_mod_n 39101 V0 := rfl
    have h_v : step_mod_n_test N 39101 V0 = 2 := by
      rw [h_test_eq]
      exact v39101_eq
    have h_ZMod : (step_mod_n_test N 39101 V0 : ZMod p) = 2 := by rw [h_v]; push_cast; rfl
    have h_step : step_n 39101 (V0 : ZMod p) = 2 := by
      rw [←step_mod_n_test_p p N V0 39101 hdvd hN_pos]
      exact h_ZMod
    rw [h_step] at h_tr_pow
    obtain ⟨A, B, hAB⟩ := mat_pow_is_mat p 2 1 (201886 * 3^39101)
    have h_M_pow : M ^ (3^39101) = mat p A B := by
      calc M ^ (3^39101) = (M0 ^ 201886) ^ (3^39101) := rfl
        _ = M0 ^ (201886 * 3^39101) := by rw [←pow_mul]
        _ = mat p A B := hAB
    have h_ptrace : ptrace p (mat p A B) = 2 := by
      calc ptrace p (mat p A B) = tr (mat p A B) := rfl
        _ = tr (M ^ (3^39101)) := by rw [←h_M_pow]
        _ = 2 := h_tr_pow
    have h_det_mat : (mat p A B).det = 1 := by
      rw [←h_M_pow]
      rw [Matrix.det_pow, h_det, one_pow]
    have h_eq_1 := eq_one_of_ptrace_eq_two p hp2 hp3 A B h_ptrace h_det_mat
    rw [h_M_pow]
    exact h_eq_1

    
  have h_pow_prev : M ^ (3^39100) ≠ 1 := by
    intro h_eq_1
    have h_tr_pow : tr (M ^ (3^39100)) = step_n 39100 (tr M) := tr_M_3_pow M h_det 39100
    rw [h_tr] at h_tr_pow
    have h_test_eq : step_mod_n_test N 39100 V0 = step_mod_n 39100 V0 := rfl
    have h_x_eq : step_mod_n_test N 39100 V0 = x := by
      rw [h_test_eq]
      exact step_mod_n_39100
    have h_ZMod : (step_mod_n_test N 39100 V0 : ZMod p) = (x : ZMod p) := by rw [h_x_eq]
    have h_step : step_n 39100 (V0 : ZMod p) = (x : ZMod p) := by
      rw [←step_mod_n_test_p p N V0 39100 hdvd hN_pos]
      exact h_ZMod
    rw [h_step] at h_tr_pow
    have h_tr_1 : tr (M ^ (3^39100)) = 2 := by
      rw [h_eq_1]
      rfl
    rw [h_tr_1] at h_tr_pow
    exact hp_ne_2 h_tr_pow.symm

    
  have h_root : M^(p-1) = 1 ∨ M^(p+1) = 1 := by
    have h_s : sTwo p + sW p = M := M_eq_mat_s p
    rw [←h_s]
    exact sW_root_order p hp2 hp3
    
  have h_p_ge : p ≥ 3^39101 - 1 := M_p_order_ge p hp2 hp3 M 39101 (by decide) h_pow_m h_pow_prev h_root
  
  have h_p_ge_q : p ≥ q - 1 := by
    rw [q_def]
    exact h_p_ge

  have h_p_gt : p > 201886 + 1 := h_p_gt_lem p h_p_ge_q
    
  have hk_def : ∃ k, N = k * p := by
    obtain ⟨k, hk⟩ := hdvd
    exact ⟨k, by rw [mul_comm, hk]⟩
  rcases hk_def with ⟨k, hk_eq⟩
  
  have hk_le : k ≤ 201886 := hk_le_lem k p N hk_eq h_p_ge_q N_eq.symm
    
  have hk_pos : k > 0 := by
    by_contra h0
    have : k = 0 := by omega
    subst this
    rw [zero_mul] at hk_eq
    have h_pos2 := hN_pos
    rw [hk_eq] at h_pos2
    omega
    
  have hp_form : ∃ a, p = a * q - 1 ∨ p = a * q + 1 := by
    have h_div : 3^39101 ∣ p - 1 ∨ 3^39101 ∣ p + 1 := by
      cases h_root with
      | inl h1 => left; exact mat_pow_not_div M 39101 (p-1) h_pow_m h_pow_prev h1
      | inr h2 => right; exact mat_pow_not_div M 39101 (p+1) h_pow_m h_pow_prev h2
    cases h_div with
    | inl h1 =>
      obtain ⟨a, ha⟩ := h1
      use a
      right
      rw [←q_def] at ha
      generalize hq : q = Q at ha
      omega
    | inr h2 =>
      obtain ⟨a, ha⟩ := h2
      use a
      left
      rw [←q_def] at ha
      generalize hq : q = Q at ha
      omega

  obtain ⟨a, hp_a⟩ := hp_form
  have h_eq_mod : 201886 * q - 1 = k * (a * q - 1) ∨ 201886 * q - 1 = k * (a * q + 1) := by
    have h_N2 : 201886 * q - 1 = N := by
      calc 201886 * q - 1 = 2 * 100943 * q - 1 := by rfl
        _ = N := N_eq
    rw [h_N2, hk_eq]
    cases hp_a with
    | inl h1 => left; rw [h1]
    | inr h2 => right; rw [h2]

  have h_q_gt : q > 201886 + 1 := by
    rw [q_def]
    have h3_pos : 3 > 0 := by omega
    have h_pow_pos : 3 ^ 39101 = 3 * 3 ^ 39100 := by rfl
    rw [h_pow_pos]
    omega

  have h_k_1 : k = 1 := k_eq_one_of_mod q k a h_q_gt hk_le hk_pos h_eq_mod
  rw [h_k_1, one_mul] at hk_eq
  exact h_pock_not ⟨p, hp, hdvd, hk_eq.symm⟩

