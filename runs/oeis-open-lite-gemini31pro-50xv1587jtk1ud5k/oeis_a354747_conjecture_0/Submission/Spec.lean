lemma test_tr_sq (p : ℕ) [Fact p.Prime] (M : Matrix (Fin 2) (Fin 2) (ZMod p)) (h_det : M.det = 1) : tr (M ^ 2) = (tr M)^2 - 2 := by
  have hd : M.det = M 0 0 * M 1 1 - M 0 1 * M 1 0 := Matrix.det_fin_two M
  rw [h_det] at hd
  have h_pow : M ^ 2 = M * M := pow_two M
  have ht1 : tr (M * M) = (M * M) 0 0 + (M * M) 1 1 := rfl
  have ht2 : tr M = M 0 0 + M 1 1 := rfl
  have hm00 : (M * M) 0 0 = M 0 0 * M 0 0 + M 0 1 * M 1 0 := by
    rw [Matrix.mul_apply]
    rw [Fin.sum_univ_two]
  have hm11 : (M * M) 1 1 = M 1 0 * M 0 1 + M 1 1 * M 1 1 := by
    rw [Matrix.mul_apply]
    rw [Fin.sum_univ_two]
  rw [h_pow, ht1, ht2, hm00, hm11]
  linear_combination 2 * hd
