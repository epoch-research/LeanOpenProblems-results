def factorize_compute (n : Nat) : List (Nat × Nat) := Id.run do
  let mut factors := []
  let mut x := n
  let mut p := 2
  while p * p <= x do
    if x % p == 0 then
      let mut count := 0
      while x % p == 0 do
        count := count + 1
        x := x / p
      factors := factors ++ [(p, count)]
    p := p + 1
  if x > 1 then
    factors := factors ++ [(x, 1)]
  factors

def compute_tot_pow (p e : Nat) : Nat :=
  if e == 1 then p - 1 else p^(e-1) * (p - 1)

def rfl_true : Expr := mkApp2 (mkConst ``Eq.refl [levelOne]) (mkConst ``Bool) (mkConst ``Bool.true)

def mkTotient1 : Expr := mkConst ``totient_1_lem

def mkTotientPrime (p v : Nat) : Expr :=
  mkAppN (mkConst ``totient_prime_lem) #[
    mkNatLit p, mkNatLit v,
    mkConst (Name.mkSimple s!"prime_proof_{p}"),
    rfl_true
  ]

def mkTotientPrimePow (p e v : Nat) : Expr :=
  mkAppN (mkConst ``totient_prime_pow_lem) #[
    mkNatLit p, mkNatLit e, mkNatLit v,
    mkConst (Name.mkSimple s!"prime_proof_{p}"),
    rfl_true, rfl_true
  ]

def mkTotientMul (a b v ma mb : Nat) (pa pb : Expr) : Expr :=
  mkAppN (mkConst ``totient_mul_lem) #[
    mkNatLit a, mkNatLit b, mkNatLit v, mkNatLit ma, mkNatLit mb,
    rfl_true, pa, pb, rfl_true
  ]

partial def prove_totient_factors (factors : List (Nat × Nat)) : Nat × Nat × Expr :=
  match factors with
  | [] => (1, 1, mkTotient1)
  | [(p, e)] =>
    let v := compute_tot_pow p e
    let pr := if e == 1 then mkTotientPrime p v else mkTotientPrimePow p e v
    (p^e, v, pr)
  | (p, e) :: t =>
    let (b, vb, proof_b) := prove_totient_factors t
    let a := p^e
    let va := compute_tot_pow p e
    let v := va * vb
    let proof_a := if e == 1 then mkTotientPrime p va else mkTotientPrimePow p e va
    let proof_mul := mkTotientMul a b v va vb proof_a proof_b
    (a * b, v, proof_mul)

def prove_totient (x : Nat) : Nat × Expr :=
  let factors := factorize_compute x
  let (_, v, proof) := prove_totient_factors factors
  (v, proof)

def get_sqrt (n : Nat) : Nat := Nat.sqrt n

def mkProofCase (n k : Nat) : Expr :=
  let (m1, proof_k) := prove_totient k
  let (m2, proof_nk) := prove_totient (n - k)
  let m := m1 * m2
  let r := get_sqrt m
  mkAppN (mkConst ``a_pos_of_witness_lem) #[
    mkNatLit n, mkNatLit k, mkNatLit m1, mkNatLit m2, mkNatLit m, mkNatLit r,
    rfl_true, rfl_true, proof_k, proof_nk, rfl_true, rfl_true
  ]

partial def mkBalancedProof (arr : Array Nat) (start len : Nat) : Expr :=
  if len == 1 then
    let k := arr[start - 9]!
    let proof := mkProofCase start k
    mkAppN (mkConst ``check_range_one) #[mkNatLit start, proof]
  else
    let half := len / 2
    let left := mkBalancedProof arr start half
    let right := mkBalancedProof arr (start + half) (len - half)
    mkAppN (mkConst ``check_range_split) #[mkNatLit start, mkNatLit half, mkNatLit (len - half), left, right]

elab "prove_huge" start_stx:num len_stx:num : tactic => do
  let start_n := start_stx.getNat
  let len_n := len_stx.getNat
  let arr := decode_k
  let p := mkBalancedProof arr start_n len_n
  let mvarId ← getMainGoal
  mvarId.assign p
