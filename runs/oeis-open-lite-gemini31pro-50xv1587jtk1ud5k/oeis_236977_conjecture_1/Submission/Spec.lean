import FormalConjectures.Util.ProblemImports

open Nat Finset

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

-- Base64 Decoder
def b64_char_to_val (c : Char) : Nat :=
  let v := c.val.toNat
  if 65 ≤ v ∧ v ≤ 90 then v - 65
  else if 97 ≤ v ∧ v ≤ 122 then v - 97 + 26
  else if 48 ≤ v ∧ v ≤ 57 then v - 48 + 52
  else if v == 43 then 62
  else if v == 47 then 63
  else 0

def k_data : String := ""

open Lean Meta Elab Tactic

def decode_k : Array Nat := Id.run do
  let mut arr := Array.mkEmpty 2000000
  let s := k_data
  let mut i := 0
  let len := s.length
  while i + 7 < len do
    let c1 := b64_char_to_val (String.Pos.Raw.get s ⟨i⟩)
    let c2 := b64_char_to_val (String.Pos.Raw.get s ⟨i+1⟩)
    let c3 := b64_char_to_val (String.Pos.Raw.get s ⟨i+2⟩)
    let c4 := b64_char_to_val (String.Pos.Raw.get s ⟨i+3⟩)
    let c5 := b64_char_to_val (String.Pos.Raw.get s ⟨i+4⟩)
    let c6 := b64_char_to_val (String.Pos.Raw.get s ⟨i+5⟩)
    let c7 := b64_char_to_val (String.Pos.Raw.get s ⟨i+6⟩)
    let c8 := b64_char_to_val (String.Pos.Raw.get s ⟨i+7⟩)
    let b1 := (c1 <<< 2) ||| (c2 >>> 4)
    let b2 := ((c2 &&& 15) <<< 4) ||| (c3 >>> 2)
    let b3 := ((c3 &&& 3) <<< 6) ||| c4
    let b4 := (c5 <<< 2) ||| (c6 >>> 4)
    let b5 := ((c6 &&& 15) <<< 4) ||| (c7 >>> 2)
    let b6 := ((c7 &&& 3) <<< 6) ||| c8
    let k1 := b1 ||| (b2 <<< 8)
    let k2 := b3 ||| (b4 <<< 8)
    let k3 := b5 ||| (b6 <<< 8)
    arr := arr.push k1
    arr := arr.push k2
    arr := arr.push k3
    i := i + 8
  arr

def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

def check_range (start len : Nat) : Prop :=
  ∀ n, start ≤ n ∧ n < start + len → a n > 0

lemma check_range_one (start : Nat) (h : a start > 0) : check_range start 1 := by
  intro n ⟨h1, h2⟩
  have eq : n = start := by omega
  rwa [eq]

lemma check_range_split (start len1 len2 : Nat)
  (h1 : check_range start len1)
  (h2 : check_range (start + len1) len2) : check_range start (len1 + len2) := by
  intro n ⟨h3, h4⟩
  by_cases h : n < start + len1
  · exact h1 n ⟨h3, h⟩
  · apply h2 n
    omega

-- Fast helper lemmas
lemma totient_prime_pow_lem (p e v : Nat) (hp : Nat.Prime p) (he : decide (0 < e) = true) (eq : decide (p^(e-1) * (p - 1) = v) = true) : Nat.totient (p^e) = v := by
  rw [Nat.totient_prime_pow hp (of_decide_eq_true he)]
  exact of_decide_eq_true eq

lemma totient_prime_lem (p v : Nat) (hp : Nat.Prime p) (eq : decide (p - 1 = v) = true) : Nat.totient p = v := by
  rw [Nat.totient_prime hp]
  exact of_decide_eq_true eq

lemma totient_mul_lem (a b v m_a m_b : Nat) (h_coprime : decide (Nat.Coprime a b) = true)
  (ha : Nat.totient a = m_a) (hb : Nat.totient b = m_b) (eq : decide (m_a * m_b = v) = true) : Nat.totient (a * b) = v := by
  rw [Nat.totient_mul (of_decide_eq_true h_coprime), ha, hb]
  exact of_decide_eq_true eq

lemma a_pos_of_witness_lem (n k m1 m2 m r : Nat)
  (h1 : decide (1 ≤ k) = true)
  (h2 : decide (k < (n - 1) / 2 + 1) = true)
  (h_tot_k : Nat.totient k = m1)
  (h_tot_nk : Nat.totient (n - k) = m2)
  (h_mul : decide (m1 * m2 = m) = true)
  (h_sq : decide (r * r = m) = true) : a n > 0 := by
  have h_m : Nat.totient k * Nat.totient (n - k) = m := by
    rw [h_tot_k, h_tot_nk]
    exact of_decide_eq_true h_mul
  have h_sqrt : Nat.sqrt m ^ 2 = m := by
    have hs : r * r = m := of_decide_eq_true h_sq
    rw [← hs]
    rw [Nat.sqrt_eq]
    exact Nat.pow_two r
  have h_term : (let m_val := Nat.totient k * Nat.totient (n - k); if Nat.sqrt m_val ^ 2 = m_val then 1 else 0) = 1 := by
    dsimp
    rw [h_m, h_sqrt]
    exact if_pos rfl
  have h_mem : k ∈ Finset.Ico 1 ((n - 1) / 2 + 1) := Finset.mem_Ico.mpr ⟨of_decide_eq_true h1, of_decide_eq_true h2⟩
  apply Finset.sum_pos'
  · intro i _
    dsimp
    split <;> decide
  · use k
    exact ⟨h_mem, by rw [h_term]; decide⟩

lemma totient_1_lem : Nat.totient 1 = 1 := Nat.totient_one

