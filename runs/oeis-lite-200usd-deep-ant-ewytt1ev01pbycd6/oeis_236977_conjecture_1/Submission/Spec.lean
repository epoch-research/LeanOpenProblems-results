def idxOf (p : Nat × Nat) : Nat := p.1 * 301 + p.2
def maskOf : List (Nat × Nat) → Nat
  | [] => 0
  | p :: t => (1 <<< (idxOf p)) ||| maskOf t
def MASKV : Nat := 

theorem maskOf_testBit : ∀ (L : List (Nat×Nat)) (i : Nat),
    (maskOf L).testBit i = true → ∃ p ∈ L, idxOf p = i := by
  intro L
  induction L with
  | nil => intro i h; simp [maskOf] at h
  | cons p t ih =>
    intro i h
    rw [maskOf, Nat.testBit_or, Bool.or_eq_true] at h
    rcases h with h1 | h2
    · rw [Nat.one_shiftLeft, Nat.testBit_two_pow] at h1
      have : idxOf p = i := of_decide_eq_true h1
      exact ⟨p, List.mem_cons_self, this⟩
    · obtain ⟨q, hq, hqi⟩ := ih i h2
      exact ⟨q, List.mem_cons_of_mem _ hq, hqi⟩

theorem maskEq : MASKV = maskOf goodPairsL := by decide

theorem goodAll : ∀ p ∈ goodPairsL, issq (ftotP p.1 * ftotP p.2) = true := by decide
theorem pairBound : ∀ p ∈ goodPairsL, p.1 < 301 ∧ p.2 < 301 := by decide

def familyChkN (n q1 q2 : Nat) : Bool :=
  decide (1 ≤ q1 ∧ q1 < q2) && (n % (q1+q2) == 0)
    && (Nat.gcd (n/(q1+q2)) (q1*q2) == 1)
    && MASKV.testBit (q1*301+q2)

theorem familyChkN_sound (n q1 q2 : Nat) (hnpos : 0 < n)
    (hq1lt : q1 < 301) (hq2lt : q2 < 301)
    (h : familyChkN n q1 q2 = true) : 0 < a n := by
  unfold familyChkN at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true,
      decide_eq_true_eq, beq_iff_eq, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨hq1, hq12⟩, hmod⟩, hgcd⟩, htb⟩ := h
  have hsdvd : (q1 + q2) ∣ n := Nat.dvd_of_mod_eq_zero hmod
  have hcop : Nat.Coprime (n/(q1+q2)) (q1*q2) := hgcd
  have hg1 : Nat.gcd (n/(q1+q2)) q1 = 1 := hcop.coprime_dvd_right ⟨q2, rfl⟩
  have hg2 : Nat.gcd (n/(q1+q2)) q2 = 1 := hcop.coprime_dvd_right ⟨q1, Nat.mul_comm q1 q2⟩
  rw [maskEq] at htb
  obtain ⟨p, hpmem, hpidx⟩ := maskOf_testBit goodPairsL (q1*301+q2) htb
  obtain ⟨hpb1, hpb2⟩ := pairBound p hpmem
  have hpeq1 : p.1 = q1 ∧ p.2 = q2 := by
    unfold idxOf at hpidx; omega
  have hsq : issq (ftotP q1 * ftotP q2) = true := by
    have := goodAll p hpmem
    rw [hpeq1.1, hpeq1.2] at this; exact this
  exact family_lemma2 n q1 q2 hq1 hq12 hsdvd hnpos hg1 hg2 (by omega) hsq
def tableChk2 (n kk r : Nat) : Bool :=
  decide (1 ≤ kk ∧ kk ≤ (n-1)/2) && (ftotP kk * ftotP (n - kk) == r * r)
theorem tableChk2_sound (n kk r : Nat) (hn : n ≤ 2000000)
    (h : tableChk2 n kk r = true) : 0 < a n := by
  unfold tableChk2 at h
  rw [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  have hkn : kk ≤ 2000000 := by omega
  have hnk : n - kk ≤ 2000000 := by omega
  apply a_pos_of_witness n kk
  · rw [Finset.mem_Ico]; omega
  · have e1 : ftotP kk = Nat.totient kk := ftotP_eq kk hkn
    have e2 : ftotP (n-kk) = Nat.totient (n-kk) := ftotP_eq (n-kk) hnk
    rw [e1, e2] at h3
    rw [h3, Nat.sqrt_eq, sq]
def goChunkV (lo : Nat) : Nat → Nat → Bool
  | 0, _ => true
  | (cnt+1), data =>
      if data % 2 == 0 then
        familyChkN lo (data / 2 % 90601 / 301) (data / 2 % 90601 % 301)
          && goChunkV (lo+1) cnt (data / 2 / 90601)
      else
        tableChk2 lo (data / 2 % 2097152) (data / 2 / 2097152 % 2097152)
          && goChunkV (lo+1) cnt (data / 2 / 2097152 / 2097152)
theorem goChunkV_sound : ∀ (cnt lo data : Nat), 1 ≤ lo → lo + cnt ≤ 2000001 →
    goChunkV lo cnt data = true → ∀ n, lo ≤ n → n < lo + cnt → 0 < a n := by
  intro cnt
  induction cnt with
  | zero => intro lo data _ _ _ n h1 h2; omega
  | succ cnt ih =>
      intro lo data hlo hb hgc n h1 h2
      rw [goChunkV] at hgc
      rcases Nat.lt_or_ge lo n with hlt | hge
      · by_cases hpar : data % 2 == 0
        · rw [if_pos hpar, Bool.and_eq_true] at hgc
          exact ih (lo+1) (data / 2 / 90601) (by omega) (by omega) hgc.2 n (by omega) (by omega)
        · rw [if_neg hpar, Bool.and_eq_true] at hgc
          exact ih (lo+1) (data / 2 / 2097152 / 2097152) (by omega) (by omega) hgc.2 n (by omega) (by omega)
      · have hle : lo = n := by omega
        subst hle
        by_cases hpar : data % 2 == 0
        · rw [if_pos hpar, Bool.and_eq_true] at hgc
          have hq1 : data / 2 % 90601 / 301 < 301 := by
            rw [Nat.div_lt_iff_lt_mul (by norm_num)]
            have := Nat.mod_lt (data/2) (show 0 < 90601 by norm_num); omega
          have hq2 : data / 2 % 90601 % 301 < 301 := Nat.mod_lt _ (by norm_num)
          exact familyChkN_sound lo _ _ (by omega) hq1 hq2 hgc.1
        · rw [if_neg hpar, Bool.and_eq_true] at hgc
          exact tableChk2_sound lo _ _ (by omega) hgc.1
theorem chunkV_OK (lo hi cnt data : Nat) (hlo : 1 ≤ lo) (hlen : lo + cnt = hi)
    (hb : hi ≤ 2000001) (hgc : goChunkV lo cnt data = true) :
    ∀ n, lo ≤ n → n < hi → 0 < a n := by
  subst hlen
  exact goChunkV_sound cnt lo data hlo hb hgc
theorem combineRange {P : Nat → Prop} {lo mid hi : Nat}
    (h1 : ∀ n, lo ≤ n → n < mid → P n) (h2 : ∀ n, mid ≤ n → n < hi → P n) :
    ∀ n, lo ≤ n → n < hi → P n := by
  intro n hlo hhi
  rcases Nat.lt_or_ge n mid with h | h
  · exact h1 n hlo h
  · exact h2 n h hhi
