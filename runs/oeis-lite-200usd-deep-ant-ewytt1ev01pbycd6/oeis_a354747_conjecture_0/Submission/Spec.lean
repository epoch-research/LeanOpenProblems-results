noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

namespace NPlusOne

variable {N : ℕ}

/-- The componentwise reduction map `X N → X q` for `q ∣ N`, as a ring hom. -/
noncomputable def phi {q : ℕ} (h : q ∣ N) : X N →+* X q where
  toFun x := (ZMod.castHom h (ZMod q) x.1, ZMod.castHom h (ZMod q) x.2)
  map_one' := by ext <;> simp only [X.one_fst, X.one_snd, map_one, map_zero]
  map_mul' x y := by ext <;> simp only [X.mul_fst, X.mul_snd, map_add, map_mul, map_ofNat]
  map_zero' := by ext <;> simp only [X.zero_fst, X.zero_snd, map_zero]
  map_add' x y := by ext <;> simp only [X.add_fst, X.add_snd, map_add]

@[simp] theorem phi_ω {q : ℕ} (h : q ∣ N) : phi h (X.ω : X N) = (X.ω : X q) := by
  ext <;> simp only [phi, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, X.ω, map_ofNat, map_one]

/-- `ω` as a unit of `X q`. -/
def ωu (q : ℕ) : (X q)ˣ where
  val := X.ω
  inv := X.ωb
  val_inv := X.ω_mul_ωb
  inv_val := X.ωb_mul_ω

theorem prime_of (hN : 1 < N)
    (hpow : (X.ω : X N) ^ (N + 1) = 1)
    (hunit : ∀ p : ℕ, p.Prime → p ∣ (N + 1) →
      IsUnit ((X.ω : X N) ^ ((N + 1) / p) - 1)) :
    N.Prime := by
  set q := N.minFac with hq
  have hqd : q ∣ N := Nat.minFac_dvd N
  have hqp : q.Prime := Nat.minFac_prime (by lia)
  have hq1 : 1 < q := hqp.one_lt
  have : NeZero q := ⟨hqp.pos.ne'⟩
  have : Fact (1 < q) := ⟨hq1⟩
  have hpowq : (X.ω : X q) ^ (N + 1) = 1 := by
    have := congrArg (phi hqd) hpow
    rwa [map_pow, phi_ω, map_one] at this
  have hdivq : ∀ p : ℕ, p.Prime → p ∣ (N + 1) → (X.ω : X q) ^ ((N + 1) / p) ≠ 1 := by
    intro p hp hpd
    have hu := (hunit p hp hpd).map (phi hqd)
    rw [map_sub, map_pow, phi_ω, map_one] at hu
    intro hcontra
    rw [hcontra, sub_self] at hu
    exact (not_isUnit_zero) hu
  have horder : orderOf (X.ω : X q) = N + 1 :=
    orderOf_eq_of_pow_and_pow_div_prime (by lia) hpowq hdivq
  have horderu : orderOf (ωu q) = N + 1 := by
    have h1 : orderOf ((Units.coeHom (X q)) (ωu q)) = orderOf (ωu q) :=
      orderOf_injective (Units.coeHom (X q)) Units.val_injective (ωu q)
    have h2 : (Units.coeHom (X q)) (ωu q) = (X.ω : X q) := rfl
    rw [h2] at h1
    rw [← h1]; exact horder
  have hle : N + 1 ≤ Fintype.card (X q)ˣ := horderu ▸ orderOf_le_card_univ
  have hlt : Fintype.card (X q)ˣ < q ^ 2 := by
    have := X.card_units_lt (q := q) hq1
    simpa [X.card_eq] using this
  by_contra hnp
  have hsq : q ^ 2 ≤ N := Nat.minFac_sq_le_self (by lia) hnp
  have : N + 1 < N := lt_of_le_of_lt hle (lt_of_lt_of_le hlt hsq)
  lia

/-- ℕ-pair multiplication mod N representing multiplication in `X N`. -/
def mm (N : ℕ) : (ℕ × ℕ) → (ℕ × ℕ) → (ℕ × ℕ)
  | (a, b), (c, d) => ((a * c + 3 * b * d) % N, (a * d + b * c) % N)

/-- Interpret a ℕ-pair as an element of `X N`. -/
def toX (N : ℕ) (p : ℕ × ℕ) : X N := ((p.1 : ZMod N), (p.2 : ZMod N))

@[simp] theorem toX_fst (N : ℕ) (p : ℕ × ℕ) : (toX N p).1 = (p.1 : ZMod N) := rfl
@[simp] theorem toX_snd (N : ℕ) (p : ℕ × ℕ) : (toX N p).2 = (p.2 : ZMod N) := rfl

theorem toX_mm (N : ℕ) (x y : ℕ × ℕ) : toX N (mm N x y) = toX N x * toX N y := by
  obtain ⟨a, b⟩ := x; obtain ⟨c, d⟩ := y
  apply X.ext
  · simp only [mm, toX, X.mul_fst]; push_cast [ZMod.natCast_mod]; ring
  · simp only [mm, toX, X.mul_snd]; push_cast [ZMod.natCast_mod]; ring

theorem toX_one (N : ℕ) : toX N (1, 0) = 1 := by
  apply X.ext <;> simp [toX]

theorem toX_omega (N : ℕ) : toX N (2, 1) = (X.ω : X N) := by
  apply X.ext <;> simp [toX, X.ω]

/-- Cubing in the ℕ-pair representation. -/
def pcube (N : ℕ) (x : ℕ × ℕ) : ℕ × ℕ := mm N (mm N x x) x

/-- Iterated cubing. -/
def pit (N : ℕ) : ℕ → (ℕ × ℕ) → (ℕ × ℕ)
  | 0, x => x
  | k + 1, x => pit N k (pcube N x)

theorem toX_pcube (N : ℕ) (x : ℕ × ℕ) : toX N (pcube N x) = (toX N x) ^ 3 := by
  simp only [pcube, toX_mm]; ring

theorem toX_pit (N : ℕ) (k : ℕ) (x : ℕ × ℕ) :
    toX N (pit N k x) = (toX N x) ^ (3 ^ k) := by
  induction k generalizing x with
  | zero => simp [pit]
  | succ k ih => rw [pit, ih, toX_pcube, ← pow_mul, ← pow_succ']

theorem pit_add (N : ℕ) (a b : ℕ) (x : ℕ × ℕ) :
    pit N (a + b) x = pit N b (pit N a x) := by
  induction a generalizing x with
  | zero => simp [pit]
  | succ a ih => rw [Nat.succ_add, pit, pit, ih]

/-- Fast exponentiation in the ℕ-pair representation. -/
def ppow (N : ℕ) : ℕ → (ℕ × ℕ) → ℕ → (ℕ × ℕ)
  | 0, _, _ => (1, 0)
  | fuel + 1, x, e =>
      if e = 0 then (1, 0)
      else if e % 2 = 1 then mm N x (ppow N fuel (mm N x x) (e / 2))
        else ppow N fuel (mm N x x) (e / 2)

theorem toX_ppow (N : ℕ) (fuel : ℕ) :
    ∀ (x : ℕ × ℕ) (e : ℕ), e < 2 ^ fuel → toX N (ppow N fuel x e) = (toX N x) ^ e := by
  induction fuel with
  | zero =>
    intro x e he
    simp only [pow_zero, Nat.lt_one_iff] at he
    subst he; rw [ppow, pow_zero]; apply X.ext <;> simp [toX]
  | succ fuel ih =>
    intro x e he
    rw [ppow]
    by_cases he0 : e = 0
    · subst he0; rw [pow_zero]; simp only [if_pos rfl]; apply X.ext <;> simp [toX]
    · have hhalf : e / 2 < 2 ^ fuel := by rw [pow_succ] at he; omega
      by_cases hodd : e % 2 = 1
      · simp only [he0, if_false, hodd, if_true]
        rw [toX_mm, ih _ _ hhalf, toX_mm, ← pow_two, ← pow_mul, mul_comm, ← pow_succ]
        congr 1; omega
      · simp only [he0, if_false, hodd, if_false]
        rw [ih _ _ hhalf, toX_mm, ← pow_two, ← pow_mul]
        congr 1; omega

theorem isUnit_zmod (N nr inv : ℕ) (h : nr * inv % N = 1 % N) :
    IsUnit (nr : ZMod N) := by
  have key : (nr : ZMod N) * (inv : ZMod N) = 1 := by
    rw [← Nat.cast_mul, ← Nat.cast_one, ZMod.natCast_eq_natCast_iff]; exact h
  exact IsUnit.of_mul_eq_one _ key

theorem isUnit_of_normUnit (N : ℕ) (w : X N)
    (hn : IsUnit (w.1 ^ 2 - 3 * w.2 ^ 2)) : IsUnit w := by
  set n := w.1 ^ 2 - 3 * w.2 ^ 2 with hndef
  have hww : w * (show X N from (w.1, -w.2)) = (show X N from (n, 0)) := by
    apply X.ext
    · simp only [X.mul_fst, hndef]; ring
    · simp only [X.mul_snd]; ring
  have hu0 : IsUnit (show X N from (n, 0)) := by
    obtain ⟨u, hu⟩ := hn
    refine IsUnit.of_mul_eq_one (show X N from (((u⁻¹ : (ZMod N)ˣ) : ZMod N), (0 : ZMod N))) ?_
    apply X.ext
    · simp only [X.mul_fst, X.one_fst, mul_zero, add_zero]; rw [← hu]; exact u.mul_inv
    · simp only [X.mul_snd, X.one_snd]; ring
  rw [← hww] at hu0
  exact isUnit_of_mul_isUnit_left hu0

theorem isUnit_toX_sub_one (N a b nr inv : ℕ)
    (hnorm : ((a : ZMod N) - 1) ^ 2 - 3 * (b : ZMod N) ^ 2 = (nr : ZMod N))
    (hinv : nr * inv % N = 1 % N) :
    IsUnit (toX N (a, b) - 1) := by
  apply isUnit_of_normUnit
  have h1 : (toX N (a, b) - 1 : X N).1 = (a : ZMod N) - 1 := rfl
  have h2 : (toX N (a, b) - 1 : X N).2 = (b : ZMod N) := by
    show (toX N (a, b)).2 - (1 : X N).2 = _
    rw [toX_snd, X.one_snd, sub_zero]
  rw [h1, h2, hnorm]
  exact isUnit_zmod N nr inv hinv

/-- Iterated multiplication by 3, for computing exact powers of 3. -/
def p3it : ℕ → ℕ → ℕ
  | 0, acc => acc
  | k + 1, acc => p3it k (acc * 3)

theorem p3it_eq (k acc : ℕ) : p3it k acc = acc * 3 ^ k := by
  induction k generalizing acc with
  | zero => simp [p3it]
  | succ k ih => rw [p3it, ih]; ring

theorem p3it_add (a b acc : ℕ) : p3it (a + b) acc = p3it b (p3it a acc) := by
  induction a generalizing acc with
  | zero => simp [p3it]
  | succ a ih => rw [Nat.succ_add, p3it, p3it, ih]

