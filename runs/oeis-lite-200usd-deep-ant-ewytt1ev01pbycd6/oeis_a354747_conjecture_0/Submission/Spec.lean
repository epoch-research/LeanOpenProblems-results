  have hmem : 39101 ∈ { m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) } := ⟨by norm_num, hp⟩
  have hne : ({ m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) } : Set ℕ).Nonempty := ⟨39101, hmem⟩
  have hin := Nat.sInf_mem hne
