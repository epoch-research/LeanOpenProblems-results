theorem hNprime : Nat.Prime N := by
  have hCPhi : (X.ω : X N) ^ (3 ^ 39101) = toX N CPhi := by
    rw [← toX_omega, ← toX_pit, hpitHi]
  have hCPlo : (X.ω : X N) ^ (3 ^ 39100) = toX N CPlo := by
    rw [← toX_omega, ← toX_pit, hpitLo]
  have hNp1 : N + 1 = 201886 * 3 ^ 39101 := by rw [hp3]; decide
  apply prime_of (by decide)
  · rw [hNp1, Nat.mul_comm 201886 (3 ^ 39101), pow_mul, hCPhi,
        ← toX_ppow N 20 CPhi 201886 (by decide),
        show ppow N 20 CPhi 201886 = (1, 0) from by rfl]
    exact toX_one N
  · intro p hp hpd
    have hfact : N + 1 = 2 * 100943 * 3 ^ 39101 := by rw [hNp1]
    have h100943 : Nat.Prime 100943 := by norm_num
    rw [hfact] at hpd
    rcases (hp.dvd_mul.mp hpd) with h1 | h2
    · rcases (hp.dvd_mul.mp h1) with ha | hb
      · obtain rfl : p = 2 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp ha
        have hd : (N + 1) / 2 = 100943 * 3 ^ 39101 := by rw [hp3]; decide
        rw [hd, Nat.mul_comm 100943 (3 ^ 39101), pow_mul, hCPhi,
            ← toX_ppow N 20 CPhi 100943 (by decide),
            show ppow N 20 CPhi 100943 = (, 0) from by rfl]
        exact isUnit_toX_sub_one N  0 4  (by decide) (by decide)
      · obtain rfl : p = 100943 := (Nat.prime_dvd_prime_iff_eq hp h100943).mp hb
        have hd : (N + 1) / 100943 = 2 * 3 ^ 39101 := by rw [hp3]; decide
        rw [hd, Nat.mul_comm 2 (3 ^ 39101), pow_mul, hCPhi,
            ← toX_ppow N 20 CPhi 2 (by decide),
            show ppow N 20 CPhi 2 = (, ) from by rfl]
        exact isUnit_toX_sub_one N     (by decide) (by decide)
    · have hp3d : p ∣ 3 := hp.dvd_of_dvd_pow h2
      obtain rfl : p = 3 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp hp3d
      have hd : (N + 1) / 3 = 201886 * 3 ^ 39100 := by rw [hp3lo]; decide
      rw [hd, Nat.mul_comm 201886 (3 ^ 39100), pow_mul, hCPlo,
          ← toX_ppow N 20 CPlo 201886 (by decide),
          show ppow N 20 CPlo 201886 = (, ) from by rfl]
      exact isUnit_toX_sub_one N   3  (by decide) (by decide)

