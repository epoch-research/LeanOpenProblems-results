lemma triple_D3_zero : tripleVal NN st_D3_57.1 st_D3_57.2 = 0 := by decide

lemma MM_eq_twoF : MM = 2 * F := by decide
lemma MM_div3_mul : 3 * (MM / 3) = MM := by decide
lemma MM_divQ_mul : Q * (MM / Q) = MM := by decide

lemma pow3_dvd_MM : 3^E ∣ MM := by
  rw [MM_eq_twoF]
  refine ⟨2*Q, ?_⟩
  unfold F
  ring

lemma Q_dvd_MM : Q ∣ MM := by
  rw [MM_eq_twoF]
  refine ⟨2*3^E, ?_⟩
  unfold F
  ring

lemma Q_coprime_pow3 : Nat.Coprime Q (3^E) := by
  exact Nat.prime_three.coprime_pow_of_not_dvd (m:=E) (a:=Q) (by norm_num [Q])

lemma period_factor_lower (r : ℕ) (hdiv : r ∣ MM)
    (h3 : ¬ r ∣ MM/3) (hQ : ¬ r ∣ MM/Q) : F ∣ r := by
  rcases hdiv with ⟨d, hd⟩
  have hnot3d : ¬ 3 ∣ d := by
    intro hd3
    rcases hd3 with ⟨d3, rfl⟩
    apply h3
    refine ⟨d3, ?_⟩
    have h : 3 * (MM / 3) = 3 * (r * d3) := by
      rw [MM_div3_mul, hd]
      ring
    exact Nat.mul_left_cancel (show 0 < 3 by norm_num) h
  have h3pow_r : 3^E ∣ r := by
    have hrd : 3^E ∣ r*d := by rw [← hd]; exact pow3_dvd_MM
    have hcop : Nat.Coprime (3^E) d := (Nat.prime_three.coprime_pow_of_not_dvd hnot3d).symm
    exact (hcop.dvd_mul_right).mp hrd
  have hnotQd : ¬ Q ∣ d := by
    intro hdQ
    rcases hdQ with ⟨dQ, rfl⟩
    apply hQ
    refine ⟨dQ, ?_⟩
    have h : Q * (MM / Q) = Q * (r * dQ) := by
      rw [MM_divQ_mul, hd]
      ring
    exact Nat.mul_left_cancel Q_prime.pos h
  have hQ_r : Q ∣ r := by
    have hrd : Q ∣ r*d := by rw [← hd]; exact Q_dvd_MM
    have hcop : Nat.Coprime Q d := (Q_prime.coprime_iff_not_dvd).2 hnotQd
    exact (hcop.dvd_mul_right).mp hrd
  unfold F
  exact Q_coprime_pow3.mul_dvd_of_dvd_of_dvd hQ_r h3pow_r

lemma not_period_dvd_div (p k res : ℕ) [Fact p.Prime] (hp : p.Prime) (hp3 : p ≠ 3)
    (hpdvd : p ∣ NN) (hcert : ((res : ℕ) : ZMod p) = U (R:=ZMod p) k)
    (hg : Nat.gcd res NN = 1) : ¬ minimalPeriod (step p) none ∣ k := by
  intro hdv
  have hper : IsPeriodicPt (step p) k (none : Option (ZMod p)) := by
    exact (Function.isPeriodicPt_iff_minimalPeriod_dvd).mpr hdv
  have hproj : proj p k = none := by
    simpa [Function.IsPeriodicPt, Function.IsFixedPt, step_iterate_none hp3] using hper
  have hU : U (R:=ZMod p) k = 0 := by
    by_contra hne
    simp [proj, hne] at hproj
  have hcast : (res : ZMod p) = 0 := by
    rw [hcert, hU]
  have hp_dvd_res : p ∣ res := (ZMod.natCast_eq_zero_iff res p).mp hcast
  have hp_dvd_g : p ∣ Nat.gcd res NN := Nat.dvd_gcd hp_dvd_res hpdvd
  have hp_dvd_one : p ∣ 1 := by simpa [hg] using hp_dvd_g
  exact hp.not_dvd_one hp_dvd_one

lemma prime_divisor_large {p : ℕ} (hp : p.Prime) (hpdvd : p ∣ NN) : F ≤ p + 1 := by
  letI : Fact p.Prime := ⟨hp⟩
  have hp3 : p ≠ 3 := by
    intro h
    exact NN_not_dvd_three (by simpa [h] using hpdvd)
  let r := minimalPeriod (step p) (none : Option (ZMod p))
  have hU_M : U (R:=ZMod p) MM = 0 := by
    have h1 := cert_D3_cast hpdvd
    have h2 := cert_D3_cast_snd hpdvd
    have htri : ((tripleVal NN st_D3_57.1 st_D3_57.2 : ℕ) : ZMod p) = 0 := by
      simp [triple_D3_zero]
    rw [cast_tripleVal_of_dvd NN_ne_zero hpdvd] at htri
    rw [h1, h2] at htri
    have htrip : U (R:=ZMod p) (3 * ix_D3_57) = 0 := by
      rw [U_triple0]
      exact htri
    simpa [ix_D3_57, MM_div3_mul] using htrip
  have hperM : IsPeriodicPt (step p) MM (none : Option (ZMod p)) := by
    rw [Function.IsPeriodicPt, Function.IsFixedPt, step_iterate_none hp3]
    simp [proj, hU_M]
  have hrdvdM : r ∣ MM := by
    exact (Function.isPeriodicPt_iff_minimalPeriod_dvd).mp hperM
  have hnot3 : ¬ r ∣ MM / 3 :=
    not_period_dvd_div p (MM/3) st_D3_57.1 hp hp3 hpdvd (cert_D3_cast hpdvd) gcd_D3
  have hnotQ : ¬ r ∣ MM / Q :=
    not_period_dvd_div p (MM/Q) st_DQ_57.1 hp hp3 hpdvd (cert_DQ_cast hpdvd) gcd_DQ
  have hFdvdr : F ∣ r := period_factor_lower r hrdvdM hnot3 hnotQ
  have hrpos : 0 < r := (Function.IsPeriodicPt.minimalPeriod_pos (by decide : 0 < MM) hperM)
  have hFleR : F ≤ r := Nat.le_of_dvd hrpos hFdvdr
  have hrle : r ≤ p + 1 := by
    simpa using (minimalPeriod_le_card (f:=step p) (x:=(none : Option (ZMod p))))
  exact hFleR.trans hrle

lemma F_ge4 : 4 ≤ F := by
  unfold F Q
  have hpow : 1 ≤ 3 ^ E := Nat.one_le_pow E 3 (by norm_num)
  nlinarith

lemma sqrtNN_add_one_lt_F : Nat.sqrt NN + 1 < F := by
  have hN : NN = 2*F - 1 := by
    have h := MM_eq_twoF
    unfold MM at h
    omega
  have hF : 4 ≤ F := F_ge4
  let G := F - 1
  have hFG : F = G + 1 := by dsimp [G]; omega
  have hG3 : 3 ≤ G := by dsimp [G]; omega
  have hN' : NN = 2*G + 1 := by rw [hN, hFG]; omega
  have hsq : NN < G*G := by
    rw [hN']
    nlinarith
  have hsqrt : Nat.sqrt NN < G := (Nat.sqrt_lt).2 hsq
  dsimp [G] at hsqrt
  omega

lemma NN_prime : Nat.Prime NN := by
  rw [Nat.prime_def_le_sqrt]
  constructor
  · decide
  · intro m hm2 hmsqrt hmdvd
    obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd (show m ≠ 1 by omega)
    have hp_dvd_NN : p ∣ NN := hpm.trans hmdvd
    have hlarge : F ≤ p + 1 := prime_divisor_large hp hp_dvd_NN
    have hplem : p ≤ m := Nat.le_of_dvd (show 0 < m by omega) hpm
    have hpsqrt : p + 1 ≤ Nat.sqrt NN + 1 := by omega
    have : p + 1 < F := hpsqrt.trans_lt sqrtNN_add_one_lt_F
    omega

/-- The smallest unknown case is n = 100943. Is a(100943) = 0? -/
theorem oeis_a354747_conjecture_0.disproof : ¬ a354747 100943 = 0 := by
  intro h
  let S : Set ℕ := { m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) }
  have hS : sInf S = 0 := by
    simpa [a354747, S] using h
  have hEmpty : S = ∅ := by
    rw [Nat.sInf_eq_zero] at hS
    rcases hS with h0 | hEmpty
    · exfalso
      simp [S] at h0
    · exact hEmpty
  have hm : (39101 : ℕ) ∈ S := by
    constructor
    · norm_num
    · simpa [NN, E] using NN_prime
  rw [hEmpty] at hm
  exact hm
