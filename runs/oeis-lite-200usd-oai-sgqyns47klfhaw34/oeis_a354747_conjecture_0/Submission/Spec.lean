import FormalConjectures.Util.ProblemImports

set_option maxRecDepth 100000
set_option exponentiation.threshold 40000

open Nat Set Function

/--
A354747: Start with $2n-1$; repeatedly triple and add 2 until reaching a prime.
$a(n)$ = number of steps until reaching a prime $> 2n-1$, or 0 if no prime is ever reached.
Equivalently, $a(n)$ is the smallest $m \ge 1$ such that $2 \cdot n \cdot 3^m - 1$ is prime.
-/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

def U {R : Type*} [CommRing R] : ℕ → R
  | 0 => 0
  | 1 => 1
  | n+2 => U (n+1) - 3 * U n

lemma U_add {R : Type*} [CommRing R] (m n : ℕ) :
    U (R:=R) (m+n+1) = U (R:=R) (m+1) * U (R:=R) (n+1) - 3 * U (R:=R) m * U (R:=R) n := by
  induction n using Nat.twoStepInduction with
  | zero => simp [U]
  | one => simp [U]
  | more n ih0 ih1 =>
      rw [show m + (n+2) + 1 = (m+n+1)+2 by omega]
      rw [U]
      rw [show m + n + 1 + 1 = m + (n+1) + 1 by omega, ih1]
      rw [ih0]
      rw [show U (R:=R) (n+2) = U (R:=R) (n+1) - 3 * U (R:=R) n by simp [U]]
      rw [show U (R:=R) (n+2+1) = U (R:=R) (n+2) - 3 * U (R:=R) (n+1) by simp [U]]
      rw [show U (R:=R) (n+2) = U (R:=R) (n+1) - 3 * U (R:=R) n by simp [U]]
      ring

lemma U_double1 {R : Type*} [CommRing R] (k : ℕ) :
    U (R:=R) (2*k+1) = U (R:=R) (k+1)^2 - 3 * U (R:=R) k^2 := by
  have h := U_add (R:=R) k k
  rw [show 2*k+1 = k+k+1 by omega]
  rw [h]
  ring

lemma U_double0 {R : Type*} [CommRing R] (k : ℕ) :
    U (R:=R) (2*k) = U (R:=R) k * (2 * U (R:=R) (k+1) - U (R:=R) k) := by
  cases k with
  | zero => simp [U]
  | succ k =>
      have h := U_add (R:=R) (k+1) k
      have hrec : U (R:=R) (k+1+1) = U (R:=R) (k+1) - 3 * U (R:=R) k := by simp [U]
      rw [hrec] at h
      rw [show 2 * (k+1) = (k+1)+k+1 by omega]
      rw [h]
      rw [hrec]
      ring


lemma U_triple0 {R : Type*} [CommRing R] (k : ℕ) :
    U (R:=R) (3*k) = U (R:=R) k * (3 * U (R:=R) (k+1)^2 - 3 * U (R:=R) k * U (R:=R) (k+1) - 2 * U (R:=R) k^2) := by
  cases k with
  | zero => simp [U]
  | succ k =>
      let j := k+1
      have hadd := U_add (R:=R) (2*j-1) j
      have hd0 := U_double0 (R:=R) j
      have hd1 := U_double1 (R:=R) j
      have hrec : U (R:=R) (2*j+1) = U (R:=R) (2*j) - 3 * U (R:=R) (2*j-1) := by
        rw [show 2*j+1 = (2*j-1)+2 by omega]
        simp only [U]
        rw [show (2*j-1)+1 = 2*j by omega]
      have hprev : 3 * U (R:=R) (2*j-1) = U (R:=R) (2*j) - U (R:=R) (2*j+1) := by
        rw [hrec]
        ring
      rw [show 3*(k+1) = (2*j-1)+j+1 by dsimp [j]; omega]
      rw [hadd]
      rw [show (2*j-1)+1 = 2*j by omega]
      have hterm : 3 * U (R:=R) (2*j-1) * U (R:=R) j = (U (R:=R) (2*j) - U (R:=R) (2*j+1)) * U (R:=R) j := by
        rw [← hprev]
      rw [hterm]
      rw [hd0, hd1]
      dsimp [j]
      rw [show U (R:=R) (k+1+1) = U (R:=R) (k+1) - 3 * U (R:=R) k by simp [U]]
      ring

lemma U_invariant {R : Type*} [CommRing R] (n : ℕ) :
    U (R:=R) (n+1)^2 - U (R:=R) (n+1) * U (R:=R) n + 3 * U (R:=R) n^2 = (3 : R)^n := by
  induction n with
  | zero => simp [U]
  | succ n ih =>
      rw [show (3 : R) ^ (n + 1) = 3 * (3 : R)^n by rw [pow_succ]; ring]
      rw [← ih]
      simp only [U]
      ring

def subMod (n x y : ℕ) : ℕ := (x + n - (y % n)) % n

def tripleVal (n a b : ℕ) : ℕ := (a * subMod n (3*b*b) (3*a*b + 2*a*a)) % n


def dblStep (n : ℕ) (bit : Bool) (s : ℕ × ℕ) : ℕ × ℕ :=
  let (a,b) := s
  let u2 := (a * subMod n (2*b) a) % n
  let u21 := subMod n (b*b) (3*a*a)
  if bit then (u21, subMod n u21 (3*u2)) else (u2,u21)

def idxStep (bit : Bool) (k : ℕ) : ℕ := 2*k + if bit then 1 else 0

lemma cast_mod_of_dvd {n p A : ℕ} (hpn : p ∣ n) :
    (((A % n : ℕ) : ZMod p) = (A : ZMod p)) := by
  rw [ZMod.natCast_eq_natCast_iff]
  exact Nat.ModEq.of_dvd hpn (Nat.mod_modEq A n)

lemma cast_subMod_of_dvd {n p x y : ℕ} (hn : n ≠ 0) (hpn : p ∣ n) :
    ((subMod n x y : ℕ) : ZMod p) = (x : ZMod p) - (y : ZMod p) := by
  unfold subMod
  rw [cast_mod_of_dvd hpn]
  have hle : y % n ≤ x + n := (Nat.mod_lt _ (Nat.pos_of_ne_zero hn)).le.trans (Nat.le_add_left _ _)
  rw [Nat.cast_sub hle, Nat.cast_add]
  have hnzero : (n : ZMod p) = 0 := by
    rw [ZMod.natCast_eq_zero_iff]
    exact hpn
  have hy : (((y % n : ℕ) : ZMod p) = (y : ZMod p)) := cast_mod_of_dvd hpn
  rw [hy]
  simp [hnzero]

lemma cast_tripleVal_of_dvd {n p a b : ℕ} (hn : n ≠ 0) (hpn : p ∣ n) :
    ((tripleVal n a b : ℕ) : ZMod p) =
      (a : ZMod p) * (3 * (b : ZMod p)^2 - 3 * (a : ZMod p) * (b : ZMod p) - 2 * (a : ZMod p)^2) := by
  unfold tripleVal
  rw [cast_mod_of_dvd hpn, Nat.cast_mul, cast_subMod_of_dvd hn hpn]
  simp only [Nat.cast_mul, Nat.cast_add]
  ring

lemma dblStep_correct {n p k : ℕ} (hn : n ≠ 0) (hpn : p ∣ n) (bit : Bool) (s : ℕ × ℕ)
    (hs1 : (s.1 : ZMod p) = U (R:=ZMod p) k)
    (hs2 : (s.2 : ZMod p) = U (R:=ZMod p) (k+1)) :
    (((dblStep n bit s).1 : ZMod p) = U (R:=ZMod p) (idxStep bit k) ∧
     ((dblStep n bit s).2 : ZMod p) = U (R:=ZMod p) (idxStep bit k + 1)) := by
  rcases s with ⟨a,b⟩
  simp only at hs1 hs2
  unfold dblStep idxStep
  have hu2 : (((a * subMod n (2*b) a) % n : ℕ) : ZMod p) = U (R:=ZMod p) (2*k) := by
    rw [cast_mod_of_dvd hpn, Nat.cast_mul, cast_subMod_of_dvd hn hpn, Nat.cast_mul, hs1, hs2]
    rw [U_double0]
    ring
  have hu21 : ((subMod n (b*b) (3*a*a) : ℕ) : ZMod p) = U (R:=ZMod p) (2*k+1) := by
    rw [cast_subMod_of_dvd hn hpn]
    simp only [Nat.cast_mul, hs1, hs2]
    rw [U_double1]
    ring
  cases bit
  · simp [hu2, hu21]
  · simp [hu21]
    have hnext : U (R:=ZMod p) (2*k+1+1) = U (R:=ZMod p) (2*k+1) - 3 * U (R:=ZMod p) (2*k) := by
      rw [show 2*k+1+1 = (2*k)+2 by omega]
      simp [U]
    rw [cast_subMod_of_dvd hn hpn, Nat.cast_mul, hu2, hu21, hnext]
    simp

lemma fold_correct {n p : ℕ} (hn : n ≠ 0) (hpn : p ∣ n) (bits : List Bool) (s : ℕ × ℕ) (k : ℕ)
    (hs1 : (s.1 : ZMod p) = U (R:=ZMod p) k)
    (hs2 : (s.2 : ZMod p) = U (R:=ZMod p) (k+1)) :
    (((bits.foldl (fun s bit => dblStep n bit s) s).1 : ZMod p) = U (R:=ZMod p) (bits.foldl (fun k bit => idxStep bit k) k) ∧
     ((bits.foldl (fun s bit => dblStep n bit s) s).2 : ZMod p) = U (R:=ZMod p) ((bits.foldl (fun k bit => idxStep bit k) k)+1)) := by
  revert s k
  induction bits with
  | nil => intro s k hs1 hs2; simpa using And.intro hs1 hs2
  | cons bit bits ih =>
      intro s k hs1 hs2
      have hstep := dblStep_correct hn hpn bit s hs1 hs2
      exact ih (dblStep n bit s) (idxStep bit k) hstep.1 hstep.2

def step (p : ℕ) [Fact p.Prime] : Option (ZMod p) → Option (ZMod p)
  | none => some 1
  | some x => if x = 0 then none else some ((1 : ZMod p) - (3 : ZMod p) / x)

def proj (p : ℕ) [Fact p.Prime] (k : ℕ) : Option (ZMod p) :=
  if U (R:=ZMod p) k = 0 then none else some (U (R:=ZMod p) (k+1) / U (R:=ZMod p) k)

lemma three_ne_zero_zmod {p : ℕ} (hp : p.Prime) (hp3 : p ≠ 3) : (3 : ZMod p) ≠ 0 := by
  intro h
  have hdiv : p ∣ 3 := (ZMod.natCast_eq_zero_iff 3 p).mp h
  exact hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp hdiv)

lemma U_no_consec_zero {p k : ℕ} (hp : p.Prime) (hp3 : p ≠ 3)
    (h0 : U (R:=ZMod p) k = 0) : U (R:=ZMod p) (k+1) ≠ 0 := by
  letI : Fact p.Prime := ⟨hp⟩
  intro h1
  have hinv := U_invariant (R:=ZMod p) k
  rw [h0, h1] at hinv
  have hpow : (3 : ZMod p)^k ≠ 0 := pow_ne_zero _ (three_ne_zero_zmod hp hp3)
  exact hpow (by simpa using hinv.symm)

lemma proj_zero {p : ℕ} [Fact p.Prime] : proj p 0 = none := by simp [proj, U]

lemma step_proj {p k : ℕ} [Fact p.Prime] (hp3 : p ≠ 3) :
    step p (proj p k) = proj p (k+1) := by
  have hp : p.Prime := Fact.out
  unfold proj
  by_cases hk : U (R:=ZMod p) k = 0
  · simp [hk, step]
    have hk1 : U (R:=ZMod p) (k+1) ≠ 0 := U_no_consec_zero hp hp3 hk
    simp [hk1]
    have hrec : U (R:=ZMod p) (k + 1 + 1) = U (R:=ZMod p) (k+1) := by simp [U, hk]
    rw [hrec]
    field_simp [hk1]
  · simp [hk, step]
    by_cases hk1 : U (R:=ZMod p) (k+1) = 0
    · simp [hk1]
    · simp [hk1]
      have hrec : U (R:=ZMod p) (k + 1 + 1) = U (R:=ZMod p) (k+1) - 3 * U (R:=ZMod p) k := by simp [U]
      rw [hrec]
      field_simp [hk, hk1]

lemma step_iterate_none {p k : ℕ} [Fact p.Prime] (hp3 : p ≠ 3) :
    (step p)^[k] none = proj p k := by
  induction k with
  | zero => simp [proj_zero]
  | succ k ih =>
      rw [Function.iterate_succ_apply', ih, step_proj hp3]

lemma gcd_eq_one_of_int_bez {a b : ℕ} {x y : ℤ}
    (h : x * (a : ℤ) + y * (b : ℤ) = 1) : Nat.gcd a b = 1 := by
  have hdvd : ((Nat.gcd a b : ℕ) : ℤ) ∣ (1 : ℤ) := by
    rw [← h]
    exact dvd_add (dvd_mul_of_dvd_right (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_left a b)) x)
      (dvd_mul_of_dvd_right (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_right a b)) y)
  have hdvd_nat : Nat.gcd a b ∣ 1 := by
    rw [← Int.natCast_dvd_natCast]
    exact hdvd
  exact Nat.dvd_one.mp hdvd_nat

