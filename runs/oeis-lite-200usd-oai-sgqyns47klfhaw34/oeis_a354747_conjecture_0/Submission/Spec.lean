  have hnext := fold_correct NN_ne_zero hpdvd bits_DQ_54b (bits_DQ_54a.foldl (fun s bit => dblStep NN bit s) st_DQ_54) (bits_DQ_54a.foldl (fun k bit => idxStep bit k) ix_DQ_54) hmid.1 hmid.2
  rw [st_ok_DQ_54, ix_ok_DQ_54] at hnext
  have hcur : ((st_DQ_55.1 : ℕ) : ZMod p) = U (R:=ZMod p) ix_DQ_55 ∧ ((st_DQ_55.2 : ℕ) : ZMod p) = U (R:=ZMod p) (ix_DQ_55 + 1) := hnext
  have hmid := fold_correct NN_ne_zero hpdvd bits_DQ_55a st_DQ_55 ix_DQ_55 hcur.1 hcur.2
