def idxAt (j c : ℕ) : ℕ := getBits 13 (idxPackAt j) c
def rootAt (j c : ℕ) : ℕ := rValAt (getBits 12 (ridPackAt j) c)
def aAt (j c : ℕ) : ℕ := aValAt (idxAt j c)

def goodBool (n A r : ℕ) : Bool :=
 let B:=n-A; let pA:=phiFastMed A; let pB:=phiFastMed B
 decide (1≤A ∧ A<((n-1)/2+1)) && decide (pA≠0) && decide (pB≠0) && decide (pA*pB=r*r)

def allB (j c : ℕ) : Bool :=
 let n:=j*10000+c+9
 goodBool n (aAt j c) (rootAt j c)

lemma a_pos_of_witness {n k : ℕ}
    (hk : k ∈ Ico 1 ((n - 1) / 2 + 1) ∧ sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k)) :
    a n > 0 := by
  rw [a]
  let f := fun k => let m := totient k * totient (n - k); if sqrt m ^ 2 = m then 1 else 0
  have hterm : f k = 1 := by dsimp [f]; rw [if_pos hk.2]
  have hle0 : f k ≤ (Ico 1 ((n - 1) / 2 + 1)).sum f := by
    exact Finset.single_le_sum (s := Ico 1 ((n - 1) / 2 + 1)) (f := f) (by intro x hx; exact Nat.zero_le _) hk.1
  have hle : 1 ≤ (Ico 1 ((n - 1) / 2 + 1)).sum f := by simpa [hterm] using hle0
  exact Nat.lt_of_lt_of_le zero_lt_one hle

lemma goodBool_sound {n A r : ℕ} (h : goodBool n A r = true) : a n > 0 := by
  unfold goodBool at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h with ⟨⟨⟨hmem,hA0⟩,hB0⟩,hsq⟩
  let B := n-A
  have hAphi := phiFastMed_eq_totient_of_ne_zero A hA0
  have hBphi := phiFastMed_eq_totient_of_ne_zero B hB0
  have hm : totient A * totient (n-A) = r*r := by
    rw [← hAphi, ← hBphi]
    simpa [B] using hsq
  have hs : sqrt (totient A * totient (n-A)) * sqrt (totient A * totient (n-A)) = totient A * totient (n-A) := (Nat.exists_mul_self _).mp ⟨r, hm.symm⟩
  exact a_pos_of_witness ⟨by simpa [Finset.mem_Ico] using hmem, by simpa [Nat.pow_two] using hs⟩

def checkBal (F : ℕ → Bool) : ℕ → ℕ → ℕ → Bool
| 0, off, len => if len = 0 then true else false
| fuel+1, off, len =>
  match len with
  | 0 => true
  | 1 => F off
  | len+2 =>
    let h := (len+2)/2
    checkBal F fuel off h && checkBal F fuel (off+h) (len+2-h)

lemma half_le_of_le_two_mul {m P : ℕ} (hm : m ≤ 2 * P) : m/2 ≤ P := by
  by_contra h
  have hP : P < m/2 := Nat.lt_of_not_ge h
  have h2 : 2 * P < 2 * (m/2) := by nlinarith
  have hle : 2 * (m/2) ≤ m := by exact Nat.mul_div_le m 2
  omega

lemma sub_half_le_of_le_two_mul {m P : ℕ} (hm : m ≤ 2 * P) : m - m/2 ≤ P := by
  have hmod : m % 2 < 2 := Nat.mod_lt _ (by norm_num)
  have hdecomp : m = 2*(m/2) + m%2 := (Nat.div_add_mod m 2).symm
  by_cases he : m % 2 = 0
  · have : m - m/2 = m/2 := by omega
    rw [this]
    exact half_le_of_le_two_mul hm
  · have hmod1 : m % 2 = 1 := by omega
    have hmexpr : m = 2*(m/2)+1 := by omega
    have hleP : m/2 < P := by
      by_contra hnp
      have hge : P ≤ m/2 := Nat.le_of_not_gt hnp
      nlinarith
    omega

lemma checkBal_get {F : ℕ → Bool} {fuel off len c : ℕ} (h : checkBal F fuel off len = true) (hlen : len ≤ 2^fuel) (hc : c < len) : F (off+c) = true := by
  induction fuel generalizing off len c with
  | zero => cases len <;> simp [checkBal] at h hc
  | succ fuel ih =>
    cases len with
    | zero => omega
    | succ len1 =>
      cases len1 with
      | zero =>
        have hc0 : c = 0 := by omega
        subst c
        simpa [checkBal] using h
      | succ len =>
        dsimp [checkBal] at h
        simp only [Bool.and_eq_true] at h
        let m := len+2
        let hh := m/2
        have hmle : m ≤ 2 * 2^fuel := by simpa [pow_succ, Nat.mul_comm, m] using hlen
        by_cases hcL : c < hh
        · have hpow : hh ≤ 2^fuel := half_le_of_le_two_mul hmle
          have hrec := ih h.1 hpow hcL
          simpa [hh, Nat.add_assoc] using hrec
        · have hcR : c - hh < m - hh := by omega
          have hpow : m - hh ≤ 2^fuel := by simpa [hh] using sub_half_le_of_le_two_mul hmle
          have hrec := ih h.2 hpow hcR
          have hoff : off + hh + (c - hh) = off + c := by omega
          rw [hoff] at hrec
          exact hrec

lemma allB_sound {j c : ℕ} (h : allB j c = true) : a (j*10000+c+9)>0 := by
  unfold allB at h
  exact goodBool_sound h

lemma checked_chunk {j start len i : ℕ} (hstart : start = j*10000) (hc : checkBal (allB j) 15 0 len = true) (hlen : len ≤ 2^15) (hlo : start ≤ i) (hhi : i < start + len) : a (i+9) > 0 := by
  let c := i - start
  have hclt : c < len := by omega
  have hb := checkBal_get hc hlen hclt
  have ha := allB_sound hb
  have hn : j*10000 + c + 9 = i + 9 := by dsimp [c]; rw [hstart]; omega
  simpa [hn] using ha
