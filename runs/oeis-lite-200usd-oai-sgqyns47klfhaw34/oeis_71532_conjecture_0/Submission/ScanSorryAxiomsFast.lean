import FormalConjectures.Util.ProblemImports
open Lean Meta Elab Command
#eval show CoreM Unit from do
  let env ← getEnv
  let mut arr := #[]
  let mut checked := 0
  for (n, ci) in env.constants.toList do
    let s := toString n
    -- skip enormous autogenerated private std names to finish faster? no, collect only obvious non-imported project too
    if s.startsWith "FormalConjectures" || s.startsWith "Mathlib" || s.startsWith "Google" then
      checked := checked + 1
      let axs ← Lean.collectAxioms n
      if axs.contains `sorryAx then arr := arr.push n
  IO.println s!"checked {checked}; sorryAx count {arr.size}"
  for n in arr.qsort (fun a b => toString a < toString b) do IO.println n
