private lemma small_lemoine (n : ℕ) (h7 : 7 ≤ n) (hn : n ≤ 15727) (ho : Odd n) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + 2 * q := by
  rcases ho with ⟨k, hk⟩
  subst n
  have hk3 : 3 ≤ k := by omega
  have hkhi : k ≤ 7863 := by omega
  exact small_lemoine_odd k hk3 hkhi

private lemma goldbach_of_core (hcore : a219055_core_conjecture) : goldbach_conjecture := by
  intro n h4 he
  by_cases hlarge : 8012 < n
  · have hpos : A219055 n > 0 := hcore n (Or.inl ⟨he, hlarge⟩)
    rw [A219055] at hpos
    rcases (Finset.card_pos.mp hpos) with ⟨q, hq⟩
    rw [Finset.mem_filter] at hq
    rcases hq with ⟨hqrange, hqcond⟩
    have hnmod : n % 2 = 0 := Nat.even_iff.mp he
    simp [hnmod] at hqcond
    rcases hqcond with ⟨hlt, hqprime, hq6prime, hpprime, hp6prime⟩
    refine ⟨n - q, q, hpprime, hqprime, ?_⟩
    omega
  · have hnle : n ≤ 8012 := by omega
    exact small_goldbach n h4 hnle he

private lemma lemoine_of_core (hcore : a219055_core_conjecture) : lemoine_conjecture := by
  intro n h7 ho
  by_cases hlarge : 15727 < n
  · have hpos : A219055 n > 0 := hcore n (Or.inr ⟨ho, hlarge⟩)
    rw [A219055] at hpos
    rcases (Finset.card_pos.mp hpos) with ⟨q, hq⟩
    rw [Finset.mem_filter] at hq
    rcases hq with ⟨hqrange, hqcond⟩
    have hnmod : n % 2 = 1 := Nat.odd_iff.mp ho
    simp [hnmod] at hqcond
    rcases hqcond with ⟨hlt, hqprime, hq6prime, hpprime, hp6prime⟩
    refine ⟨n - 2 * q, q, hpprime, hqprime, ?_⟩
    omega
  · have hnle : n ≤ 15727 := by omega
    exact small_lemoine n h7 hnle ho

private lemma six_prime_gap_of_core (hcore : a219055_core_conjecture) : six_prime_gap_conjecture := by
  rw [six_prime_gap_conjecture]
  rw [← Set.not_finite]
  intro hfin
  rcases hfin.bddAbove with ⟨B, hB⟩
  let n : ℕ := 2 * (B + 4010)
  have he : Even n := by
    use B + 4010
    ring
  have hlarge : 8012 < n := by
    dsimp [n]
    omega
  have hpos : A219055 n > 0 := hcore n (Or.inl ⟨he, hlarge⟩)
  rw [A219055] at hpos
  rcases (Finset.card_pos.mp hpos) with ⟨q, hq⟩
  rw [Finset.mem_filter] at hq
  rcases hq with ⟨hqrange, hqcond⟩
  have hnmod : n % 2 = 0 := Nat.even_iff.mp he
  simp [hnmod] at hqcond
  rcases hqcond with ⟨hlt, hqprime, hq6prime, hpprime, hp6prime⟩
  have hqB : q ≤ B := hB ⟨hqprime, hq6prime⟩
  let r : ℕ := n - q - 6
  have hr_mem : r ∈ {p : ℕ | p.Prime ∧ (p + 6).Prime} := by
    dsimp [r]
    refine ⟨hp6prime, ?_⟩
    have hp6ge : 2 ≤ n - q - 6 := hp6prime.two_le
    have hadd : n - q - 6 + 6 = n - q := by omega
    simpa [hadd] using hpprime
  have hrB : r ≤ B := hB hr_mem
  have hn_eq : n = q + r + 6 := by
    dsimp [r]
    have hp6ge : 2 ≤ n - q - 6 := hp6prime.two_le
    omega
  have hle : n ≤ 2 * B + 6 := by omega
  have hnle : ¬ n ≤ 2 * B + 6 := by
    dsimp [n]
    omega
  exact hnle hle

/--
A219055, Conjecture 1: The core conjecture for A219055 implies Goldbach's conjecture,
Lemoine's conjecture and the conjecture that there are infinitely many primes p with p+6 also prime.
-/
theorem oeis_219055_conjecture_1 :
    a219055_core_conjecture → goldbach_conjecture ∧ lemoine_conjecture ∧ six_prime_gap_conjecture := by
  intro hcore
  exact ⟨goldbach_of_core hcore, lemoine_of_core hcore, six_prime_gap_of_core hcore⟩
