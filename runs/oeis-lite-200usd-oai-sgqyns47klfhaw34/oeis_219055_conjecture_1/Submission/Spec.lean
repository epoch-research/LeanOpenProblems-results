private lemma small_goldbach (n : ℕ) (h4 : 4 ≤ n) (hn : n ≤ 8012) (he : Even n) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + q := by
  rcases he with ⟨k, hk⟩
  subst n
  have hk2 : 2 ≤ k := by omega
  have hkhi : k ≤ 4006 := by omega
  simpa [two_mul] using small_goldbach_even k hk2 hkhi

