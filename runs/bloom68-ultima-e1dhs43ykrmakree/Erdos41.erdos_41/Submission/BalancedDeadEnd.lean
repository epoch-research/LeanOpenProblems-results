/-- Adjacent comparison is linear in the number of certificate entries. -/
private theorem triples_sorted :
    List.IsChain (· < ·) (triples.map (fun I => ∑ a ∈ I, a)) := by
  decide +kernel

private theorem triples_members :
    ∀ I ∈ triples, I ⊆ values.toFinset ∧ I.card = 3 := by
  decide +kernel

private theorem triples_length : triples.length = values.toFinset.card.choose 3 := by
  decide +kernel

/-- Completeness of a duplicate-free list is certified by the binomial count. -/
private theorem condition_of_finset_list {S : Finset ℕ} (T : List (Finset ℕ))
    (hm : ∀ I ∈ T, I ⊆ S ∧ I.card = 3)
    (hlen : T.length = S.card.choose 3)
    (hnd : (T.map (fun I => ∑ a ∈ I, a)).Nodup) :
    NtupleCondition (↑S : Set ℕ) 3 := by
  have hsub : T.toFinset ⊆ S.powersetCard 3 := by
    intro I hI
    exact Finset.mem_powersetCard.mpr (hm I (List.mem_toFinset.mp hI))
  have heq : T.toFinset = S.powersetCard 3 := by
    apply Finset.eq_of_subset_of_card_le hsub
    rw [List.toFinset_card_of_nodup (hnd.of_map _), Finset.card_powersetCard, hlen]
  apply ntupleCondition_of_sum_injOn_powersetCard
  intro I hI J hJ hsum
  rw [← heq] at hI hJ
  exact List.inj_on_of_nodup_map hnd (List.mem_toFinset.mp hI)
    (List.mem_toFinset.mp hJ) hsum

/-- Distinct three-element subsets of the parent have distinct sums. -/
theorem R_triples : NtupleCondition (Set.range R) 3 := by
  rw [range_R]
  exact condition_of_finset_list triples triples_members triples_length
    (triples_sorted.pairwise.imp (fun h => Nat.ne_of_lt h))

theorem finiteCubicFlag_one_eighteen : FiniteCubicFlag 1 18 :=
  ⟨R, R_strictMono, by simpa using R_cubic_bound, R_triples⟩

