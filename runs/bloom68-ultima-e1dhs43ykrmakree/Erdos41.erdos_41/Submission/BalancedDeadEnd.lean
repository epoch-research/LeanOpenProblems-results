import Submission.FlagExamples

/-!
# A cubic-bounded restricted-B3 parent with no cubic-bounded next point

This is a finite, parent-specific obstruction: it refutes arbitrary-parent
one-step extension, not the original asymptotic problem or the existence of
other flags. All computations below are checked by Lean's kernel.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

namespace Work.BalancedDeadEnd

/-- The fixed parent, indexed from zero. -/
def R : Fin 18 → ℕ :=
  ![0, 1, 4, 13, 32, 71, 124, 218, 375, 572, 744, 1208, 1556, 2441, 3097,
    4047, 4164, 5419]

private def values : List ℕ :=
  [0, 1, 4, 13, 32, 71, 124, 218, 375, 572, 744, 1208, 1556, 2441, 3097,
    4047, 4164, 5419]

theorem R_strictMono : StrictMono R := by decide

theorem R_cubic_bound : ∀ i, R i ≤ (i.val + 1)^3 := by decide

private theorem range_R : Set.range R = (↑values.toFinset : Set ℕ) := by
  have h : (Finset.univ.image R) = values.toFinset := by decide
  rw [← h]
  ext a
  simp

