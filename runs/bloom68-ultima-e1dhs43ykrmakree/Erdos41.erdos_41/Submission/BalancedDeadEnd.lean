private theorem witnesses_length : witnesses.length = 1440 := by decide +kernel

/-- One kernel check per row; no existential search over triples. -/
private theorem witnesses_valid :
    ∀ p ∈ witnesses.zipIdx 5420, Valid p.2 p.1 := by
  decide +kernel

private theorem covered {x : ℕ} (hl : 5419 < x) (hu : x ≤ 6859) :
    ∃ w, Valid x w := by
  have hi : x - 5420 < witnesses.length := by rw [witnesses_length]; omega
  have hz : x - 5420 < (witnesses.zipIdx 5420).length := by simpa using hi
  have hv := witnesses_valid _ (List.getElem_mem hz)
  refine ⟨witnesses[x - 5420], ?_⟩
  simpa only [List.getElem_zipIdx, Nat.add_sub_of_le (by omega : 5420 ≤ x)] using hv

/-- Every candidate above the parent maximum and at most 19³ destroys the
restricted triple-subset-sum condition. This assertion is parent-specific. -/
theorem no_extension {x : ℕ} (hl : 5419 < x) (hu : x ≤ 6859) :
    ¬ NtupleCondition (Set.range R ∪ {x}) 3 := by
  rw [range_R]
  obtain ⟨w, hw⟩ := covered hl hu
  exact valid_not_condition w hw

/-- No strictly increasing cubic-bounded flag of length 19 extends this
particular length-18 parent. This does not deny the existence of other flags
of length 19 (or address an unbounded family). -/
theorem no_Fin19_extension :
    ¬ ∃ f : Fin 19 → ℕ,
      StrictMono f ∧
      (∀ i, f i ≤ (i.val + 1)^3) ∧
      (∀ i : Fin 18, f i.castSucc = R i) ∧
      NtupleCondition (Set.range f) 3 := by
  rintro ⟨f, hf, hbound, hprefix, hTriple⟩
  have hlo : 5419 < f (Fin.last 18) := by
    have h := hf (Fin.castSucc_lt_last (17 : Fin 18))
    rw [hprefix] at h
    exact h
  have hhi : f (Fin.last 18) ≤ 6859 := hbound (Fin.last 18)
  apply no_extension hlo hhi
  apply hTriple.mono
  intro y hy
  rcases hy with hy | hy
  · obtain ⟨i, rfl⟩ := hy
    exact ⟨i.castSucc, hprefix i⟩
  · have hyx : y = f (Fin.last 18) := Set.mem_singleton_iff.mp hy
    exact ⟨Fin.last 18, hyx.symm⟩

end Work.BalancedDeadEnd

