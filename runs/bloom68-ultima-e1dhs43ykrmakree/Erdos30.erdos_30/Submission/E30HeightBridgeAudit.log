Erdos30Research.int_isSidon_iff_differences (S : Set ℤ) :
  IsSidon S ↔ ∀ a ∈ S, ∀ b ∈ S, ∀ c ∈ S, ∀ d ∈ S, a ≠ b → a - b = c - d → a = c ∧ b = d
def Erdos30Research.EdgeRowsInjective.{u_1} : {ι : Type u_1} → ℤ → (ι → ℤ) → (ι → ℤ) → Prop :=
fun {ι : Type u_1} (m : ℤ) (r v : ι → ℤ) =>
  ∀ (t : ℤ),
    0 < t →
      t < m →
        Function.Injective fun (e : { e : ι × ι // Erdos30Research.edgeResidue m r e = t }) =>
          Erdos30Research.edgeHeight r v ↑e
structure Erdos30Research.AllHeightBox (p L : ℕ) : Type
number of parameters: 2
fields:
  Erdos30Research.AllHeightBox.A : Finset ℤ
  Erdos30Research.AllHeightBox.b : ℤ → ℤ
  Erdos30Research.AllHeightBox.heavy_sidon : IsSidon ↑self.A
  Erdos30Research.AllHeightBox.heavy_card : self.A.card = p + 1
  Erdos30Research.AllHeightBox.rows : Erdos30Research.EdgeRowsInjective (↑(p ^ 2 - p + 1)) Erdos30Research.liftResidue
      (Erdos30Research.liftHeight self.b)
  Erdos30Research.AllHeightBox.heavy_box : ∀ a ∈ self.A, 0 ≤ a ∧ a ≤ ↑L
  Erdos30Research.AllHeightBox.light_box : ∀ (s : ℤ), 1 ≤ s → s < ↑(p ^ 2 - p + 1) → 0 ≤ self.b s ∧ self.b s ≤ ↑L
constructor:
  Erdos30Research.AllHeightBox.mk {p L : ℕ} (A : Finset ℤ) (b : ℤ → ℤ) (heavy_sidon : IsSidon ↑A)
    (heavy_card : A.card = p + 1)
    (rows :
      Erdos30Research.EdgeRowsInjective (↑(p ^ 2 - p + 1)) Erdos30Research.liftResidue (Erdos30Research.liftHeight b))
    (heavy_box : ∀ a ∈ A, 0 ≤ a ∧ a ≤ ↑L) (light_box : ∀ (s : ℤ), 1 ≤ s → s < ↑(p ^ 2 - p + 1) → 0 ≤ b s ∧ b s ≤ ↑L) :
    Erdos30Research.AllHeightBox p L
