Erdos30Research.edge_quotient_remainder.{u_1} {ι : Type u_1} {m : ℤ} {r v : ι → ℤ} (hm : 0 < m)
  (hr : ∀ (i : ι), 0 ≤ r i ∧ r i < m) (e : ι × ι) :
  Erdos30Research.edgeResidue m r e = (r e.1 - r e.2) % m ∧
    Erdos30Research.edgeHeight r v e = v e.1 - v e.2 + (r e.1 - r e.2) / m
Erdos30Research.heavy_light_carries {m : ℕ} {A : Finset ℤ} (b : ℤ → ℤ) (a : ↥A) (s : Fin (m - 1)) :
  Erdos30Research.edgeHeight Erdos30Research.liftResidue (Erdos30Research.liftHeight b) (Sum.inr s, Sum.inl a) =
      b (↑↑s + 1) - ↑a ∧
    Erdos30Research.edgeHeight Erdos30Research.liftResidue (Erdos30Research.liftHeight b) (Sum.inl a, Sum.inr s) =
      ↑a - b (↑↑s + 1) - 1
Erdos30Research.light_light_carry {m : ℕ} {A : Finset ℤ} (b : ℤ → ℤ) (s t : Fin (m - 1)) :
  Erdos30Research.edgeHeight Erdos30Research.liftResidue (Erdos30Research.liftHeight b) (Sum.inr s, Sum.inr t) =
    b (↑↑s + 1) - b (↑↑t + 1) + if ↑s < ↑t then -1 else 0
