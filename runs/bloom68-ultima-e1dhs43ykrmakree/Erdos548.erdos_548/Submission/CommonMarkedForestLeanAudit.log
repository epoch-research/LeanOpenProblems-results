@CommonMarkedForest.CL : ∀ {V : Type u_1} [inst : Fintype V] (F : SimpleGraph V),
  F.IsAcyclic →
    ∀ (roots : F.ConnectedComponent → V),
      (∀ (C : F.ConnectedComponent), roots C ∈ C) →
        ∀ {W : Type u_2} [inst_1 : Fintype W] (H : SimpleGraph W) (A : Set W),
          F.edgeSet.ncard ≤ H.minDegree → Fintype.card V ≤ A.ncard → ∃ f, ∀ (C : F.ConnectedComponent), f (roots C) ∈ A
@CommonMarkedForest.common_list_family : ∀ {I : Type u_1} [inst : Fintype I] (T : I → CommonMarkedForest.RootedTree)
  {W : Type u_2} [inst_1 : Fintype W] (H : SimpleGraph W) (A : Finset W),
  (∀ (s : W), CommonMarkedForest.totalEdges T ≤ H.degree s) →
    CommonMarkedForest.totalOrder T ≤ #A → ∃ f, CommonMarkedForest.Marked T f A
@CommonMarkedForest.common_list_forest : ∀ {V : Type u_1} [inst : Fintype V] (F : SimpleGraph V),
  F.IsAcyclic →
    ∀ (root : (C : F.ConnectedComponent) → ↥C) {W : Type u_2} [inst_1 : Fintype W] (H : SimpleGraph W) (A : Finset W),
      (∀ (s : W), #F.edgeFinset ≤ H.degree s) → Fintype.card V ≤ #A → ∃ f, ∀ (C : F.ConnectedComponent), f ↑(root C) ∈ A
