@rooted_parity_kernel : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V},
  G.IsTree →
    ∀ (χ : G.Coloring (Fin 2)) (r : V) (c : ℕ),
      (∀ (i : Fin 2), c < #{x | χ x = i}) → ∃ R U W, IsParityKernel G c R U W ∧ r ∈ R
@exists_parity_kernel_of_card : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V},
  G.IsTree → ∀ (c : ℕ), 2 * c < Fintype.card V → ∃ R U W, IsParityKernel G c R U W
@parity_kernel : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V},
  G.IsTree →
    ∀ {k c : ℕ},
      #G.edgeFinset = k →
        1 ≤ c →
          c ≤ k / 2 →
            ∃ R U W,
              IsParityKernel G c R U W ∧
                R ⊂ univ ∧ 2 * c ≤ #(univ \ R) ∧ (induce (↑R) G).IsTree ∧ #(induce (↑R) G).edgeFinset ≤ k - 2 * c
parity_kernel_fin : ∀ (k c : ℕ) (G : SimpleGraph (Fin (k + 1))),
  G.IsTree →
    1 ≤ c →
      c ≤ k / 2 →
        ∃ R U W,
          IsParityKernel G c R U W ∧
            R ⊂ univ ∧ 2 * c ≤ #(univ \ R) ∧ (induce (↑R) G).IsTree ∧ #(induce (↑R) G).edgeFinset ≤ k - 2 * c
