import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A236998: a(n) = |{0 < k < n/2: phi(k)*phi(n-k) is a square}|, where phi(.) is Euler's totient function.
-/
def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0


/-!
The finite verification below uses the sumset of numbers with square totient.
A balanced tree is used for the certificates, and natural-number bitsets for
checking the sumset. All computations are checked by the Lean kernel.
-/
namespace OEIS236998Certificate

set_option maxRecDepth 100000
set_option maxHeartbeats 0

def smallFacAux (n : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => n
  | f+1, k => if n < k*k then n else
    if n % k = 0 then k else smallFacAux n f (k+2)

theorem smallFacAux_eq (n f k : ℕ) (hk : 1 ≤ k) (h : n < k + 2*f) :
    smallFacAux n f k = Nat.minFacAux n k := by
  induction f generalizing k with
  | zero =>
    have hh : n < k*k := lt_of_lt_of_le (by simpa using h) (Nat.le_mul_self k)
    rw [smallFacAux, Nat.minFacAux, if_pos hh]
  | succ f ih =>
    rw [smallFacAux, Nat.minFacAux]
    by_cases hh : n < k*k
    · simp [hh]
    · simp only [hh, ↓reduceIte, Nat.dvd_iff_mod_eq_zero]
      by_cases hd : n % k = 0
      · simp [hd]
      · simp only [hd, ↓reduceIte]
        exact ih (k+2) (by omega) (by omega)

def smallFac (n : ℕ) := if n % 2 = 0 then 2 else smallFacAux n n 3

theorem smallFac_eq (n : ℕ) : smallFac n = n.minFac := by
  simp only [smallFac, Nat.minFac, Nat.dvd_iff_mod_eq_zero]
  rw [smallFacAux_eq n n 3 (by omega) (by omega)]

def fastPhi : ℕ → ℕ → ℕ
  | 0, n => n
  | f+1, n =>
    if n < 2 then n else
    let p := smallFac n
    let m := n / p
    (if m % p = 0 then p else p - 1) * fastPhi f m

theorem fastPhi_eq (f n : ℕ) (hn : n < 2 ^ (f+1)) : fastPhi f n = n.totient := by
  induction f generalizing n with
  | zero =>
    have : n = 0 ∨ n = 1 := by norm_num at hn; omega
    rcases this with rfl | rfl <;> simp [fastPhi]
  | succ f ih =>
    simp only [fastPhi, smallFac_eq]
    by_cases h : n < 2
    · rw [if_pos h]
      have : n = 0 ∨ n = 1 := by omega
      rcases this with rfl | rfl <;> simp
    · rw [if_neg h]
      have hp : n.minFac.Prime := Nat.minFac_prime (by omega)
      have hd := Nat.minFac_dvd n
      have he : n.minFac * (n / n.minFac) = n := Nat.mul_div_cancel' hd
      have hb : n / n.minFac < 2 ^ (f+1) := by
        apply (Nat.div_lt_iff_lt_mul hp.pos).mpr
        calc
          n < 2 ^ (f + 1 + 1) := hn
          _ = 2 ^ (f + 1) * 2 := by rw [pow_succ]
          _ ≤ 2 ^ (f + 1) * n.minFac := Nat.mul_le_mul_left _ hp.two_le
      rw [ih _ hb]
      split_ifs with hm
      · have hd' : n.minFac ∣ n / n.minFac := Nat.dvd_of_mod_eq_zero hm
        simpa only [he] using (Nat.totient_mul_of_prime_of_dvd hp hd').symm
      · have hd' : ¬ n.minFac ∣ n / n.minFac := by simpa only [Nat.dvd_iff_mod_eq_zero] using hm
        simpa only [he] using (Nat.totient_mul_of_prime_of_not_dvd hp hd').symm

def checkOne (n k : ℕ) : Bool :=
  0 < k && 2*k < n &&
    let m := fastPhi 21 k * fastPhi 21 (n-k)
    m.sqrt ^ 2 == m

def squareCheck (n : ℕ) : Bool :=
  let t := fastPhi 21 n
  0 < n && n < 2^22 && t.sqrt ^ 2 == t

theorem positive_of_witness (n k : ℕ) (hk : 0 < k) (hkn : 2*k < n)
    (hs : (totient k * totient (n-k)).sqrt ^ 2 = totient k * totient (n-k)) :
    0 < a n := by
  apply Finset.sum_pos_iff.mpr
  refine ⟨k, Finset.mem_Ico.mpr ⟨hk, by omega⟩, ?_⟩
  simp [hs]

def SquarePhi (n : ℕ) : Prop := 0 < n ∧ ∃ r : ℕ, n.totient = r^2

theorem squareCheck_sound (n : ℕ) (h : squareCheck n = true) : SquarePhi n := by
  simp only [squareCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  refine ⟨h.1.1, (fastPhi 21 n).sqrt, ?_⟩
  rw [fastPhi_eq 21 n h.1.2]
  simpa only [fastPhi_eq 21 n h.1.2] using h.2.symm

theorem positive_of_squarePhi (n k : ℕ) (hk : SquarePhi k)
    (hl : SquarePhi (n-k)) (hkn : 2*k < n) : 0 < a n := by
  obtain ⟨hk0, r, hr⟩ := hk
  obtain ⟨hl0, s, hs⟩ := hl
  apply positive_of_witness n k hk0 hkn
  rw [hr, hs, ← mul_pow, Nat.sqrt_eq']


inductive NumTree where
  | leaf : ℕ → NumTree
  | branch : NumTree → NumTree → NumTree
open NumTree

def treeAll (p : ℕ → Bool) : NumTree → Bool
  | leaf n => p n
  | branch l r => treeAll p l && treeAll p r

def treeBits : NumTree → ℕ
  | leaf n => 1 <<< n
  | branch l r => treeBits l ||| treeBits r

def treeSums (b : ℕ) : NumTree → ℕ
  | leaf k => (b >>> (k+1)) <<< (2*k+1)
  | branch l r => treeSums b l ||| treeSums b r

theorem treeAll_sound (p : ℕ → Bool) (t : NumTree) (ht : treeAll p t = true)
    (n : ℕ) (hn : (treeBits t).testBit n = true) : p n = true := by
  induction t with
  | leaf k =>
    simp only [treeBits, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow,
      decide_eq_true_eq] at hn
    subst n
    exact ht
  | branch l r il ir =>
    simp only [treeAll, Bool.and_eq_true] at ht
    simp only [treeBits, Nat.testBit_or, Bool.or_eq_true] at hn
    rcases hn with hn | hn
    · exact il ht.1 hn
    · exact ir ht.2 hn

theorem treeSums_sound (b : ℕ) (t : NumTree)
    (hb : ∀ n, b.testBit n = true → SquarePhi n)
    (ht : treeAll squareCheck t = true)
    (n : ℕ) (hn : (treeSums b t).testBit n = true) : 0 < a n := by
  induction t with
  | leaf k =>
    simp only [treeSums, Nat.testBit_shiftLeft, Nat.testBit_shiftRight,
      Bool.and_eq_true, decide_eq_true_eq] at hn
    have he : k + 1 + (n - (2*k+1)) = n-k := by omega
    rw [he] at hn
    exact positive_of_squarePhi n k (squareCheck_sound k ht) (hb _ hn.2) (by omega)
  | branch l r il ir =>
    simp only [treeAll, Bool.and_eq_true] at ht
    simp only [treeSums, Nat.testBit_or, Bool.or_eq_true] at hn
    rcases hn with hn | hn
    · exact il ht.1 hn
    · exact ir ht.2 hn

theorem checkOne_sound (n k : ℕ) (hn : n < 2^22) (h : checkOne n k = true) :
    0 < a n := by
  simp only [checkOne, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  apply positive_of_witness n k h.1.1 h.1.2
  have hk : k < 2^22 := by omega
  have hl : n-k < 2^22 := by omega
  simpa only [fastPhi_eq 21 k hk, fastPhi_eq 21 (n-k) hl] using h.2

theorem covered_bit {c : ℕ}
    (hc : (c >>> 9) % 2^1999992 = 2^1999992-1)
    (n : ℕ) (hn : 9 ≤ n ∧ n ≤ 2*10^6) : c.testBit n = true := by
  have h := congrArg (fun b : ℕ => b.testBit (n-9)) hc
  have hi : n - 9 < 1999992 := by omega
  simpa only [Nat.testBit_mod_two_pow, Nat.testBit_shiftRight,
    Nat.testBit_two_pow_sub_one, hi, decide_true, Bool.true_and,
    show 9+(n-9)=n by omega] using h

-- Checking a tree checks every one of its leaves.
def treeCheck (t : NumTree) : Bool := treeAll squareCheck t

theorem treeCheck_branch (l r : NumTree)
    (hl : treeCheck l = true) (hr : treeCheck r = true) :
    treeCheck (branch l r) = true := by
  change (treeCheck l && treeCheck r) = true
  simp only [hl, hr, Bool.and_self]

