import FormalConjectures.Util.ProblemImports

open Nat Set

/--
A354747: Start with $2n-1$; repeatedly triple and add 2 until reaching a prime.
$a(n)$ = number of steps until reaching a prime $> 2n-1$, or 0 if no prime is ever reached.
Equivalently, $a(n)$ is the smallest $m \ge 1$ such that $2 \cdot n \cdot 3^m - 1$ is prime.
-/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

open LucasLehmer

namespace QuadTest

def reduce {N q : ℕ} (h : q ∣ N) : X N →+* X q where
  toFun x := (ZMod.castHom h (ZMod q) x.1, ZMod.castHom h (ZMod q) x.2)
  map_one' := by apply X.ext <;> simp only [X.one_fst, X.one_snd, map_one, map_zero]
  map_mul' x y := by apply X.ext <;> simp only [X.mul_fst, X.mul_snd, map_add, map_mul, map_ofNat]
  map_zero' := by apply X.ext <;> simp only [X.zero_fst, X.zero_snd, map_zero]
  map_add' x y := by apply X.ext <;> simp only [X.add_fst, X.add_snd, map_add]

lemma fst_reduce {N q : ℕ} (h : q ∣ N) (x : X N) :
    (reduce h x).1 = ZMod.castHom h (ZMod q) x.1 := rfl

-- A full-order certificate in the quadratic ring suffices because its group
-- of units modulo a proper prime factor has fewer than q^2 elements.
theorem prime_of_certificate (N : ℕ) (hN : 1 < N) (x : X N)
    (hpow : x ^ (N+1) = 1)
    (hcert : ∀ r : ℕ, r.Prime → r ∣ N+1 →
      Nat.Coprime (((x ^ ((N+1)/r)).1).val + N - 1) N) : N.Prime := by
  by_contra hnp
  let q := N.minFac
  have hq : q.Prime := Nat.minFac_prime (by omega)
  have hqd : q ∣ N := Nat.minFac_dvd N
  have hq2 : q ^ 2 ≤ N := Nat.minFac_sq_le_self (by omega) hnp
  letI : Fact q.Prime := ⟨hq⟩
  letI : NeZero N := ⟨by omega⟩
  let y := reduce hqd x
  have hy : y ^ (N+1) = 1 := by
    dsimp [y]
    rw [← map_pow, hpow, map_one]
  have hlower (r : ℕ) (hr : r.Prime) (hrd : r ∣ N+1) : y ^ ((N+1)/r) ≠ 1 := by
    intro heq
    have hc := hcert r hr hrd
    have heq' : ZMod.castHom hqd (ZMod q) ((x ^ ((N+1)/r)).1) = 1 := by
      have := congrArg Prod.fst heq
      simpa [y, ← map_pow, fst_reduce] using this
    have hcast : ((((x ^ ((N+1)/r)).1).val : ℕ) : ZMod q) = 1 := by
      simpa only [ZMod.castHom_apply, ZMod.cast_eq_val] using heq'
    have hd : q ∣ ((x ^ ((N+1)/r)).1).val + N - 1 := by
      apply (ZMod.natCast_eq_zero_iff _ _).mp
      rw [Nat.cast_sub (by omega), Nat.cast_add, hcast]
      have : (N : ZMod q) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr hqd
      simp [this]
    have : q ∣ 1 := (Nat.dvd_gcd hd hqd).trans (by rw [hc.gcd_eq_one])
    exact hq.not_dvd_one this
  have ho : orderOf y = N+1 :=
    orderOf_eq_of_pow_and_pow_div_prime (by omega) hy hlower
  let u : (X q)ˣ := Units.mkOfMulEqOne y (y^N) (by simpa [_root_.pow_succ'] using hy)
  have hou : orderOf u = N+1 := by
    rw [← orderOf_injective (Units.coeHom _) Units.val_injective u]
    exact ho
  have hu : orderOf u ≤ Fintype.card (X q)ˣ := orderOf_le_card_univ
  have hcard := X.card_units_lt hq.one_lt
  rw [hou] at hu
  omega

def ofPair (N : ℕ) (a : ℕ × ℕ) : X N := (a.1, a.2)

def mulMod (N : ℕ) (a b : ℕ × ℕ) : ℕ × ℕ :=
  ((a.1 * b.1 + 3 * a.2 * b.2) % N, (a.1 * b.2 + a.2 * b.1) % N)

lemma ofPair_mulMod (N : ℕ) (a b : ℕ × ℕ) :
    ofPair N (mulMod N a b) = ofPair N a * ofPair N b := by
  apply X.ext <;> simp [ofPair, mulMod, Nat.cast_add, Nat.cast_mul]

def cubeMod (N : ℕ) (a : ℕ × ℕ) : ℕ × ℕ :=
  mulMod N (mulMod N a a) a

lemma ofPair_cubeMod (N : ℕ) (a : ℕ × ℕ) :
    ofPair N (cubeMod N a) = ofPair N a ^ 3 := by
  simp only [cubeMod, ofPair_mulMod]
  ring

def cubes (N : ℕ) : ℕ → (ℕ × ℕ) → (ℕ × ℕ)
  | 0, a => a
  | n+1, a => cubes N n (cubeMod N a)

lemma ofPair_cubes (N n : ℕ) (a : ℕ × ℕ) :
    ofPair N (cubes N n a) = ofPair N a ^ (3^n) := by
  induction n generalizing a with
  | zero => simp [cubes]
  | succ n ih =>
    rw [cubes, ih, ofPair_cubeMod, ← pow_mul, Nat.pow_succ']

def powMod (N : ℕ) (a : ℕ × ℕ) : ℕ → ℕ × ℕ :=
  Nat.binaryRec (1,0) fun b _ z =>
    if b then mulMod N (mulMod N z z) a else mulMod N z z

lemma ofPair_powMod (N : ℕ) (a : ℕ × ℕ) (n : ℕ) :
    ofPair N (powMod N a n) = ofPair N a ^ n := by
  induction n using Nat.binaryRec' with
  | zero => simp [powMod, Nat.binaryRec_zero, ofPair]; rfl
  | bit b n h ih =>
    unfold powMod
    rw [Nat.binaryRec_eq b n (by right; exact h)]
    cases b <;> simp only [Bool.false_eq_true, ↓reduceIte, ofPair_mulMod]
    · rw [← powMod, ih, Nat.bit_false, pow_mul]
      ring
    · rw [← powMod, ih, Nat.bit_true, _root_.pow_succ, pow_mul]
      ring

lemma factors (m r : ℕ) (hr : r.Prime) (hd : r ∣ 605658 * 3^m) :
    r = 2 ∨ r = 3 ∨ r = 100943 := by
  have hbig : Nat.Prime 100943 := by norm_num
  rcases hr.dvd_mul.mp hd with h | h
  · have heq : (605658 : ℕ) = 2*3*100943 := by norm_num
    rw [heq, hr.dvd_mul, hr.dvd_mul] at h
    simp only [Nat.prime_dvd_prime_iff_eq hr Nat.prime_two,
      Nat.prime_dvd_prime_iff_eq hr Nat.prime_three,
      Nat.prime_dvd_prime_iff_eq hr hbig] at h
    rcases h with (h | h) | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr h)
  · exact Or.inr (Or.inl ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_three).mp
      (hr.dvd_of_dvd_pow h)))

theorem prime_of_cubes (N m : ℕ) (hN : 1 < N) (heq : N+1 = 605658 * 3^m)
    (z : ℕ × ℕ) (hz : cubes N m (2,1) = z)
    (hu : powMod N z 605658 = (1,0))
    (h2 : Nat.Coprime ((powMod N z 302829).1 % N + N - 1) N)
    (h3 : Nat.Coprime ((powMod N z 201886).1 % N + N - 1) N)
    (hP : Nat.Coprime ((powMod N z 6).1 % N + N - 1) N) : N.Prime := by
  let x := ofPair N (2,1)
  have hz' : x ^ (3^m) = ofPair N z := by
    rw [← ofPair_cubes, hz]
  apply prime_of_certificate N hN x
  · rw [heq, mul_comm 605658, pow_mul, hz', ← ofPair_powMod, hu]
    apply X.ext <;> simp [ofPair]
  · intro r hr hd
    have hx (hd' : r ∣ 605658) :
        x ^ ((N+1)/r) = ofPair N (powMod N z (605658/r)) := by
      rw [heq, mul_comm 605658, Nat.mul_div_assoc _ hd', pow_mul, hz', ofPair_powMod]
    rcases factors m r hr (heq ▸ hd) with rfl | rfl | rfl
    · rw [hx (by norm_num)]
      simpa only [ofPair, ZMod.val_natCast, Nat.reduceDiv] using h2
    · rw [hx (by norm_num)]
      simpa only [ofPair, ZMod.val_natCast, Nat.reduceDiv] using h3
    · rw [hx (by norm_num)]
      simpa only [ofPair, ZMod.val_natCast, Nat.reduceDiv] using hP

/-- Force both natural-number coordinates before the next iteration.
This keeps kernel evaluation of the modular recurrence stack-safe. -/
def forcePair {α : Sort*} (a : ℕ × ℕ) (f : (ℕ × ℕ) → α) : α :=
  match a.1, a.2 with
  | 0, 0 => f (0,0)
  | 0, b+1 => f (0,b+1)
  | a+1, 0 => f (a+1,0)
  | a+1, b+1 => f (a+1,b+1)

lemma forcePair_eq {α : Sort*} (a : ℕ × ℕ) (f : (ℕ × ℕ) → α) : forcePair a f = f a := by
  rcases a with ⟨a,b⟩
  cases a <;> cases b <;> rfl

def cubesStrict (N : ℕ) : ℕ → (ℕ × ℕ) → (ℕ × ℕ)
  | 0, a => a
  | n+1, a => forcePair (cubeMod N a) (cubesStrict N n)

lemma cubesStrict_eq (N n : ℕ) (a : ℕ × ℕ) : cubesStrict N n a = cubes N n a := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => rw [cubesStrict, forcePair_eq, ih, cubes]

end QuadTest

/- A full-order certificate for 201886 * 3^39101 - 1.
All numerical identities below are checked by kernel reduction. -/
namespace QuadCertificate
open QuadTest
def N : ℕ := 
def z : ℕ × ℕ := (,)
theorem residue : cubes N 39100 (2,1) = z := by
  rw [← cubesStrict_eq]
  decide +kernel
theorem upper : powMod N z 605658 = (1,0) := by decide +kernel
theorem co2 : Nat.Coprime ((powMod N z 302829).1 % N + N - 1) N :=
  Nat.coprime_of_mul_modEq_one  (by decide +kernel)
theorem co3 : Nat.Coprime ((powMod N z 201886).1 % N + N - 1) N :=
  Nat.coprime_of_mul_modEq_one  (by decide +kernel)
theorem co100943 : Nat.Coprime ((powMod N z 6).1 % N + N - 1) N :=
  Nat.coprime_of_mul_modEq_one  (by decide +kernel)
theorem is_prime : N.Prime :=
  prime_of_cubes N 39100 (by decide +kernel) (by decide +kernel) z residue upper co2 co3 co100943
theorem shape : 2 * 100943 * 3^39101 - 1 = N := by decide +kernel
end QuadCertificate

/-- The smallest unknown case is n = 100943. Is a(100943) = 0? -/
theorem oeis_a354747_conjecture_0 : a354747 100943 = 0 := by
  sorry

theorem oeis_a354747_conjecture_0.disproof : ¬ (type_of% @oeis_a354747_conjecture_0) := by
  intro h
  have hp : Nat.Prime (2 * 100943 * 3 ^ 39101 - 1) := by
    rw [QuadCertificate.shape]
    exact QuadCertificate.is_prime
  change sInf {m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} = 0 at h
  rcases Nat.sInf_eq_zero.mp h with hzero | hempty
  · exact Nat.lt_irrefl 0 hzero.1
  · have hm : 39101 ∈ {m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} :=
      ⟨by decide, hp⟩
    rw [hempty] at hm
    exact hm
