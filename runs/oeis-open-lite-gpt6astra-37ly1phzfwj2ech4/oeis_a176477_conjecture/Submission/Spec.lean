/- IntFactorial -/
namespace SunProof

def F (n : ℤ) : ℚ := n.toNat.factorial
lemma F_ne_zero (n : ℤ) : F n ≠ 0 := by unfold F; positivity
lemma F_nat (n : ℕ) : F n = (n.factorial : ℚ) := by simp [F]
lemma F_succ (n : ℤ) (hn : 0 ≤ n) : F (n+1) = (n+1)*F n := by
  unfold F
  rw [Int.toNat_add hn (by omega), Int.toNat_one, Nat.factorial_succ]
  push_cast
  rw [show (n.toNat : ℚ) = n by exact_mod_cast Int.toNat_of_nonneg hn]
lemma rf_int (a : ℤ) (ha : 1 ≤ a) (k : ℕ) :
    rf a k = F (a+k-1) / F (a-1) := by
  have ha' : (↑(a-1).toNat : ℚ)+1 = a := by
    rw [show ((a-1).toNat : ℚ) = (a-1 : ℤ) by exact_mod_cast Int.toNat_of_nonneg (by omega : 0 ≤ a-1)]
    push_cast
    ring
  rw [← ha', rf_nat]
  congr 1
  · unfold F
    congr 1
    congr 1
    rw [show a+(k : ℤ)-1 = (a-1)+k by ring, Int.toNat_add (by omega) (by omega), Int.toNat_natCast]
lemma rf_half_int (a : ℤ) (ha : 0 ≤ a) (k : ℕ) :
    rf ((a : ℚ)+1/2) k = F (2*a+2*k)*F a / (4^k*F (a+k)*F (2*a)) := by
  lift a to ℕ using ha
  have h₂ : (2*(a : ℤ)+2*k).toNat = 2*(a+k) := by omega
  have h₃ : (2*(a : ℤ)).toNat = 2*a := by omega
  have h₄ : ((a : ℤ)+k).toNat = a+k := by omega
  simpa only [F, h₂, h₃, h₄, Int.toNat_natCast, Int.cast_natCast] using rf_half a k
lemma rf_neg_int (n k : ℕ) (hk : k ≤ n) :
    rf (-(n : ℚ)) k = (-1)^k*F n / F ((n : ℤ)-k) := by
  rw [rf_neg n k hk]
  simp [F, Int.toNat_sub]

lemma F_prod_integer (P Q : List ℤ) (hP : ∀ x ∈ P, 0 ≤ x) (hQ : ∀ x ∈ Q, 0 ≤ x)
    (h : ∀ q : ℤ, 2 ≤ q → (Q.map (fun n => n/q)).sum ≤ (P.map (fun n => n/q)).sum) :
    ∃ z : ℤ, (P.map F).prod / (Q.map F).prod = z := by
  have hp (L : List ℤ) : (L.map F).prod = (facProd (L.map Int.toNat) : ℚ) := by
    simp only [facProd, List.map_map, Nat.cast_list_prod, Function.comp_def]
    rfl
  rw [hp, hp]
  apply facProd_integer
  intro q hq
  have hh := h q (by exact_mod_cast hq)
  have he (L : List ℤ) (hL : ∀ x ∈ L, 0 ≤ x) :
      (((L.map Int.toNat).map (fun n => n/q)).sum : ℤ) = (L.map (fun n => n/(q : ℤ))).sum := by
    rw [Nat.cast_list_sum, List.map_map, List.map_map]
    apply congrArg List.sum
    apply List.map_congr_left
    intro x hx
    simp only [Function.comp_apply, Int.natCast_ediv, Int.toNat_of_nonneg (hL x hx)]
  exact_mod_cast (show (((Q.map Int.toNat).map (fun n => n/q)).sum : ℤ) ≤
      (((P.map Int.toNat).map (fun n => n/q)).sum : ℤ) by rw [he Q hQ, he P hP]; exact hh)
end SunProof

/- Ratios -/



namespace SunProof

def FP0 (t i j : ℤ) : List ℤ := [2*t, 2*t - 1, 2*t - 1, 4*t + 1, 1*t + 1*i - 1, 4*t + 2*i, 4*t + 2*i - 2, 4*t + 2*i + 2*j, 4*t + 2*i + 2*j, 1*t + 1*i + 1*j, 1*t + 1*i + 1*j + 1, 2*t + 2, 1*t - 1]

def FQ0 (t i j : ℤ) : List ℤ := [4*t, 2*t - 2, 2*t + 1, 4*t - 1, 1*t + 1*i, 1*i + 1*j, 1*t - 1*i - 1*j, 1*j, 1*t - 1*j - 1, 2*t + 1*i, 2*t + 1*i - 1, 3*t + 1*i - 1, 1*i, 2*t + 1*i + 1*j, 2*t + 1*i + 1*j, 2*t + 2*i + 2*j, 2*t + 2*i + 2*j + 2, 1*t + 1, 1*t]

def FR0 (t i j : ℤ) : ℚ := ((FP0 t i j).map F).prod / ((FQ0 t i j).map F).prod

lemma FR0_integer (t i j : ℤ) (ht : 1 ≤ t) (hi : 0 ≤ i) (hj : 0 ≤ j)
    (hij : i+j ≤ t) (hjt : j < t) : ∃ z : ℤ, FR0 t i j = z := by
  apply F_prod_integer
  · simp only [FP0, List.mem_cons, List.not_mem_nil, or_false]
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega
  · simp only [FQ0, List.mem_cons, List.not_mem_nil, or_false]
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega
  · intro q hq
    have h := floor0_all q t i j hq
    simp only [FP0, FQ0, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
    have e : ∀ a b c d : ℤ, a*t+b*i+c*j+d = a*t+b*i+c*j+d := by intros; rfl
    ring_nf at h ⊢
    linarith only [h]


def FP1 (t i j : ℤ) : List ℤ := [1*t, 1*t + 1*i, 4*t + 2*i + 2, 4*t + 2*i + 2, 4*t + 2*i + 2*j + 2, 4*t + 2*i + 2*j + 2, 1*t + 1*i + 1*j + 1, 1*t + 1*i + 1*j + 1, 2*t + 2, 2*t + 2]

def FQ1 (t i j : ℤ) : List ℤ := [4*t + 2, 1*t + 1, 1*t + 1, 1*t + 1*i + 1, 1*i + 1*j, 1*t - 1*i - 1*j, 1*j, 1*t - 1*j, 2*t + 1*i + 1, 2*t + 1*i + 1, 3*t + 1*i + 1, 1*i, 2*t + 1*i + 1*j + 1, 2*t + 1*i + 1*j + 1, 2*t + 2*i + 2*j + 2, 2*t + 2*i + 2*j + 2]

def FR1 (t i j : ℤ) : ℚ := ((FP1 t i j).map F).prod / ((FQ1 t i j).map F).prod

lemma FR1_integer (t i j : ℤ) (ht : 1 ≤ t) (hi : 0 ≤ i) (hj : 0 ≤ j)
    (hij : i+j ≤ t) : ∃ z : ℤ, FR1 t i j = z := by
  apply F_prod_integer
  · simp only [FP1, List.mem_cons, List.not_mem_nil, or_false]
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega
  · simp only [FQ1, List.mem_cons, List.not_mem_nil, or_false]
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega
  · intro q hq
    have h := floor1_all q t i j hq
    simp only [FP1, FQ1, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
    have e : ∀ a b c d : ℤ, a*t+b*i+c*j+d = a*t+b*i+c*j+d := by intros; rfl
    ring_nf at h ⊢
    linarith only [h]


end SunProof

/- Specialize -/
namespace SunProof
open Finset

def CB (m : ℤ) : ℚ := F (2*m) / F m ^ 2
def base0 (t : ℤ) : ℚ := CB (2*t)^4 * 3 * (2*t-1) * (4*t+1) / (512*(2*t+1)*(4*t-1))
def base1 (t : ℤ) : ℚ := CB (2*t+1)^4 * (6*t+4) / (512*(2*t+2))

def DT0 (t i j : ℕ) : ℚ :=
  base0 t * (t.factorial : ℚ) * rf ((3*(t : ℤ)+1 : ℤ) : ℚ) t /
    rf ((t : ℚ)+1/2) t ^ 2 *
  rf (((2*(t : ℤ) : ℤ) : ℚ)+1/2) (i+j) ^ 2 * ec (-(t : ℚ)) (t-(i+j)) /
    (rf ((t : ℚ)+1/2) (i+j) * rf (((t : ℤ)+1 : ℤ)+1/2) (i+j)) *
  rf (((2*(t : ℤ) : ℤ) : ℚ)+1/2) i * rf (((2*(t : ℤ)-1 : ℤ) : ℚ)+1/2) i *
    ec (-((t-1 : ℕ) : ℚ)) j * ec (t : ℚ) i /
    (rf ((3*(t : ℤ) : ℤ) : ℚ) i * rf (((t : ℤ)+1 : ℤ) : ℚ) i)

def DT1 (t i j : ℕ) : ℚ :=
  base1 t * (t.factorial : ℚ) * rf ((3*(t : ℤ)+3 : ℤ) : ℚ) t /
    rf (((t : ℤ)+1 : ℤ)+1/2) t ^ 2 *
  rf (((2*(t : ℤ)+1 : ℤ) : ℚ)+1/2) (i+j) ^ 2 * ec (-(t : ℚ)) (t-(i+j)) /
    (rf (((t : ℤ)+1 : ℤ)+1/2) (i+j) * rf (((t : ℤ)+1 : ℤ)+1/2) (i+j)) *
  rf (((2*(t : ℤ)+1 : ℤ) : ℚ)+1/2) i * rf (((2*(t : ℤ)+1 : ℤ) : ℚ)+1/2) i *
    ec (-(t : ℚ)) j * ec (((t : ℤ)+1 : ℤ) : ℚ) i /
    (rf ((3*(t : ℤ)+2 : ℤ) : ℚ) i * rf (((t : ℤ)+2 : ℤ) : ℚ) i)







lemma DT0_factor (t i j : ℕ) (ht : 1 ≤ t) (hij : i+j ≤ t) (hjt : j < t) :
    512 * ((4 : ℚ)^i) ^ 2 * DT0 t i j =
      (-1 : ℚ)^(t-(i+j)) * (-1 : ℚ)^j * ((4 : ℚ)^t) ^ 2 * 1 * FR0 t i j := by
  unfold DT0 ec base0 CB FR0 FP0 FQ0
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
  simp only [← Int.cast_natCast (R := ℚ)]
  rw [rf_int (3*(t : ℤ)+1) (by omega), rf_half_int ((t : ℤ)) (by omega),
    rf_half_int (2*(t : ℤ)) (by omega) (i+j), rf_half_int ((t : ℤ)) (by omega) (i+j),
    rf_half_int ((t : ℤ)+1) (by omega) (i+j),
    rf_half_int (2*(t : ℤ)) (by omega) i,
    rf_half_int (2*(t : ℤ)-1) (by omega) i,
    rf_int ((t : ℤ)) (by omega) i, rf_int (3*(t : ℤ)) (by omega) i, rf_int ((t : ℤ)+1) (by omega) i]
  simp only [Int.cast_natCast]
  rw [rf_neg_int t (t-(i+j)) (by omega), rf_neg_int (t-1) j (by omega)]
  simp only [← F_nat]
  rw [show (↑(t-(i+j)) : ℤ) = (t : ℤ)-i-j by omega]
  rw [show (↑(t-1) : ℤ) = (t : ℤ)-1 by omega]
  try simp only [Nat.cast_add, Int.cast_add, Int.cast_mul, Int.cast_sub, Int.cast_ofNat, Int.cast_natCast]
  conv => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf0 : F (4*(t : ℤ) + 1) = ((4*(t : ℤ) + 1 : ℤ) : ℚ) * F (4*(t : ℤ)) := by
    convert F_succ (4*(t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf0 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf1 : F (4*(t : ℤ)) = ((4*(t : ℤ) : ℤ) : ℚ) * F (4*(t : ℤ) - 1) := by
    convert F_succ (4*(t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf1 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf2 : F (4*(t : ℤ) - 1) = ((4*(t : ℤ) - 1 : ℤ) : ℚ) * F (4*(t : ℤ) - 2) := by
    convert F_succ (4*(t : ℤ) - 2) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf2 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf3 : F ((t : ℤ) + 1) = (((t : ℤ) + 1 : ℤ) : ℚ) * F ((t : ℤ)) := by
    convert F_succ ((t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf3 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf4 : F ((t : ℤ)) = (((t : ℤ) : ℤ) : ℚ) * F ((t : ℤ) - 1) := by
    convert F_succ ((t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf4 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf5 : F (2*(t : ℤ) + 2) = ((2*(t : ℤ) + 2 : ℤ) : ℚ) * F (2*(t : ℤ) + 1) := by
    convert F_succ (2*(t : ℤ) + 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf5 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf6 : F (2*(t : ℤ) + 1) = ((2*(t : ℤ) + 1 : ℤ) : ℚ) * F (2*(t : ℤ)) := by
    convert F_succ (2*(t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf6 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf7 : F (2*(t : ℤ)) = ((2*(t : ℤ) : ℤ) : ℚ) * F (2*(t : ℤ) - 1) := by
    convert F_succ (2*(t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf7 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf8 : F (2*(t : ℤ) - 1) = ((2*(t : ℤ) - 1 : ℤ) : ℚ) * F (2*(t : ℤ) - 2) := by
    convert F_succ (2*(t : ℤ) - 2) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf8 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf9 : F (2*(i : ℤ) + 4*(t : ℤ)) = ((2*(i : ℤ) + 4*(t : ℤ) : ℤ) : ℚ) * F (2*(i : ℤ) + 4*(t : ℤ) - 1) := by
    convert F_succ (2*(i : ℤ) + 4*(t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf9 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf10 : F (2*(i : ℤ) + 4*(t : ℤ) - 1) = ((2*(i : ℤ) + 4*(t : ℤ) - 1 : ℤ) : ℚ) * F (2*(i : ℤ) + 4*(t : ℤ) - 2) := by
    convert F_succ (2*(i : ℤ) + 4*(t : ℤ) - 2) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf10 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf11 : F (3*(t : ℤ)) = ((3*(t : ℤ) : ℤ) : ℚ) * F (3*(t : ℤ) - 1) := by
    convert F_succ (3*(t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf11 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf12 : F (2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ) + 2) = ((2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ) + 2 : ℤ) : ℚ) * F (2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ) + 1) := by
    convert F_succ (2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ) + 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf12 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf13 : F (2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ) + 1) = ((2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ) + 1 : ℤ) : ℚ) * F (2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ)) := by
    convert F_succ (2*(i : ℤ) + 2*(j : ℤ) + 2*(t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf13 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf14 : F ((i : ℤ) + (t : ℤ)) = (((i : ℤ) + (t : ℤ) : ℤ) : ℚ) * F ((i : ℤ) + (t : ℤ) - 1) := by
    convert F_succ ((i : ℤ) + (t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf14 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf15 : F ((i : ℤ) + 2*(t : ℤ)) = (((i : ℤ) + 2*(t : ℤ) : ℤ) : ℚ) * F ((i : ℤ) + 2*(t : ℤ) - 1) := by
    convert F_succ ((i : ℤ) + 2*(t : ℤ) - 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf15 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf16 : F ((i : ℤ) + (j : ℤ) + (t : ℤ) + 1) = (((i : ℤ) + (j : ℤ) + (t : ℤ) + 1 : ℤ) : ℚ) * F ((i : ℤ) + (j : ℤ) + (t : ℤ)) := by
    convert F_succ ((i : ℤ) + (j : ℤ) + (t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf16 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  simp only [hf0, hf1, hf2, hf3, hf4, hf5, hf6, hf7, hf8, hf9, hf10, hf11, hf12, hf13, hf14, hf15, hf16]
  try simp only [Nat.cast_add, Int.cast_add, Int.cast_mul, Int.cast_sub, Int.cast_ofNat, Int.cast_natCast]
  have htq : (1 : ℚ) ≤ t := by exact_mod_cast ht
  have hiq : (0 : ℚ) ≤ i := by positivity
  have hjq : (0 : ℚ) ≤ j := by positivity
  field_simp (disch := first | apply F_ne_zero | positivity | linarith only [htq, hiq, hjq])
  ring

lemma DT1_factor (t i j : ℕ) (ht : 1 ≤ t) (hij : i+j ≤ t) :
    512 * ((4 : ℚ)^i) ^ 2 * DT1 t i j =
      (-1 : ℚ)^(t-(i+j)) * (-1 : ℚ)^j * ((4 : ℚ)^t) ^ 2 * 4 * FR1 t i j := by
  unfold DT1 ec base1 CB FR1 FP1 FQ1
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
  simp only [← Int.cast_natCast (R := ℚ)]
  rw [rf_int (3*(t : ℤ)+3) (by omega), rf_half_int ((t : ℤ)+1) (by omega),
    rf_half_int (2*(t : ℤ)+1) (by omega) (i+j), rf_half_int ((t : ℤ)+1) (by omega) (i+j),
    rf_half_int (2*(t : ℤ)+1) (by omega) i,
    rf_int ((t : ℤ)+1) (by omega) i, rf_int (3*(t : ℤ)+2) (by omega) i, rf_int ((t : ℤ)+2) (by omega) i]
  simp only [Int.cast_natCast]
  rw [rf_neg_int t (t-(i+j)) (by omega), rf_neg_int t j (by omega)]
  simp only [← F_nat]
  rw [show (↑(t-(i+j)) : ℤ) = (t : ℤ)-i-j by omega]
  try simp only [Nat.cast_add, Int.cast_add, Int.cast_mul, Int.cast_sub, Int.cast_ofNat, Int.cast_natCast]
  conv => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf0 : F ((t : ℤ) + 1) = (((t : ℤ) + 1 : ℤ) : ℚ) * F ((t : ℤ)) := by
    convert F_succ ((t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf0 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf1 : F (2*(t : ℤ) + 2) = ((2*(t : ℤ) + 2 : ℤ) : ℚ) * F (2*(t : ℤ) + 1) := by
    convert F_succ (2*(t : ℤ) + 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf1 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf2 : F (3*(t : ℤ) + 2) = ((3*(t : ℤ) + 2 : ℤ) : ℚ) * F (3*(t : ℤ) + 1) := by
    convert F_succ (3*(t : ℤ) + 1) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf2 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  have hf3 : F ((i : ℤ) + (t : ℤ) + 1) = (((i : ℤ) + (t : ℤ) + 1 : ℤ) : ℚ) * F ((i : ℤ) + (t : ℤ)) := by
    convert F_succ ((i : ℤ) + (t : ℤ)) (by omega) using 1 <;> push_cast <;> congr 1 <;> ring
  conv at hf3 => pattern (occs := *) F _; all_goals (arg 1; ring_nf)
  simp only [hf0, hf1, hf2, hf3]
  try simp only [Nat.cast_add, Int.cast_add, Int.cast_mul, Int.cast_sub, Int.cast_ofNat, Int.cast_natCast]
  have htq : (1 : ℚ) ≤ t := by exact_mod_cast ht
  have hiq : (0 : ℚ) ≤ i := by positivity
  have hjq : (0 : ℚ) ≤ j := by positivity
  field_simp (disch := first | apply F_ne_zero | positivity | linarith only [htq, hiq, hjq])
  ring
end SunProof

/- Dyadic -/
namespace SunProof
open Finset

def Dyadic (x : ℚ) : Prop := ∃ r : ℕ, ∃ z : ℤ, (2 : ℚ)^r*x = z
lemma dyadic_int (z : ℤ) : Dyadic z := ⟨0,z,by simp⟩
lemma dyadic_add {x y : ℚ} (hx : Dyadic x) (hy : Dyadic y) : Dyadic (x+y) := by
  obtain ⟨r,z,hz⟩ := hx
  obtain ⟨s,w,hw⟩ := hy
  refine ⟨r+s, 2^s*z+2^r*w, ?_⟩
  push_cast
  rw [pow_add]
  linear_combination (2:ℚ)^s*hz + (2:ℚ)^r*hw
lemma dyadic_mul {x y : ℚ} (hx : Dyadic x) (hy : Dyadic y) : Dyadic (x*y) := by
  obtain ⟨r,z,hz⟩ := hx
  obtain ⟨s,w,hw⟩ := hy
  refine ⟨r+s, z*w, ?_⟩
  push_cast
  rw [pow_add]
  calc
    _ = ((2:ℚ)^r*x)*((2:ℚ)^s*y) := by ring
    _ = _ := by rw [hz,hw]
lemma dyadic_sum {ι : Type*} (S : Finset ι) (f : ι → ℚ) (h : ∀ i ∈ S, Dyadic (f i)) :
    Dyadic (∑ i ∈ S, f i) := by
  classical
  induction S using Finset.induction_on with
  | empty => simpa using dyadic_int 0
  | @insert a S ha ih =>
    rw [sum_insert ha]
    exact dyadic_add (h a (by simp)) (ih (fun i hi => h i (by simp [hi])))
lemma dyadic_den {x : ℚ} (hx : Dyadic x) : ∃ r : ℕ, x.den ∣ 2^r := by
  obtain ⟨r,z,hz⟩ := hx
  refine ⟨r, ?_⟩
  have he : x = (z : ℚ)/(2:ℚ)^r := by
    apply (eq_div_iff (by positivity)).2
    simpa [mul_comm] using hz
  rw [he]
  have hh := Rat.den_dvd z ((2:ℤ)^r)
  rw [Rat.divInt_eq_div] at hh
  norm_cast at hh ⊢

lemma DT0_dyadic (t i j : ℕ) (ht : 1 ≤ t) (hij : i+j ≤ t) : Dyadic (DT0 t i j) := by
  by_cases hjt : j < t
  · obtain ⟨z,hz⟩ := FR0_integer t i j (by omega) (by omega) (by omega) (by omega) (by omega)
    have h := DT0_factor t i j ht hij hjt
    rw [hz] at h
    refine ⟨9+2*i*2, (-1)^(t-(i+j)) * (-1)^j * ((4:ℤ)^t)^2 * z, ?_⟩
    have hp : (2:ℚ)^(9+2*i*2) = 512*((4:ℚ)^i)^2 := by norm_num [pow_add, pow_mul]
    rw [hp]
    simpa using h
  · have hj : t-1 < j := by omega
    have he : DT0 t i j = 0 := by simp [DT0, ec, rf_neg_zero (t-1) j hj]
    rw [he]
    exact dyadic_int 0
lemma DT1_dyadic (t i j : ℕ) (ht : 1 ≤ t) (hij : i+j ≤ t) : Dyadic (DT1 t i j) := by
  obtain ⟨z,hz⟩ := FR1_integer t i j (by omega) (by omega) (by omega) (by omega)
  have h := DT1_factor t i j ht hij
  rw [hz] at h
  refine ⟨9+2*i*2, (-1)^(t-(i+j)) * (-1)^j * ((4:ℤ)^t)^2 * 4 * z, ?_⟩
  have hp : (2:ℚ)^(9+2*i*2) = 512*((4:ℚ)^i)^2 := by norm_num [pow_add, pow_mul]
  rw [hp]
  simpa using h
end SunProof

/- TailTransform -/
set_option maxHeartbeats 0
set_option maxRecDepth 10000
namespace SunProof
open Finset

def tailTerm (a b c d e f : ℚ) (n k : ℕ) : ℚ :=
  (a+2*k)/a * rf (-(n : ℚ)) k * rf b k * rf c k * rf d k * rf e k * rf f k /
    (rf (a+1+n) k * rf (a+1-b) k * rf (a+1-c) k * rf (a+1-d) k *
      rf (a+1-e) k * rf (a+1-f) k)

lemma tailTerm_BT {a b c d e f : ℚ} (ha : 0 < a)
    (hb : 0 < a+1-b) (hc : 0 < a+1-c) (hd : 0 < a+1-d)
    (he : 0 < a+1-e) (hf : 0 < a+1-f) (n k : ℕ) (hk : k ≤ n) :
    (n.factorial : ℚ)*rf (a+1) n *
      ((rf e k * rf f k / (rf (a+1-e) k * rf (a+1-f) k) *
      (rf c k * rf d k / (rf (a+1-c) k * rf (a+1-d) k) *
      (rf 1 k * rf b k / (rf a k * rf (a+1-b) k) * unitAlpha a k))) /
        ((n-k).factorial * rf (a+1) (n+k))) = tailTerm a b c d e f n k := by
  unfold tailTerm unitAlpha
  rw [rf_neg n k hk, rf_one, rf_add]
  have hn : (n.factorial : ℚ) ≠ 0 := by positivity
  have hnk : ((n-k).factorial : ℚ) ≠ 0 := by positivity
  have hkf : (k.factorial : ℚ) ≠ 0 := by positivity
  have hA : a ≠ 0 := ne_of_gt ha
  have h0 : rf a k ≠ 0 := ne_of_gt (rf_pos ha k)
  have h1 : rf (a+1) n ≠ 0 := ne_of_gt (rf_pos (by linarith) n)
  have h2 : rf (a+1+n) k ≠ 0 := ne_of_gt (rf_pos (by positivity) k)
  have h3 : rf (a+1-b) k ≠ 0 := ne_of_gt (rf_pos hb k)
  have h4 : rf (a+1-c) k ≠ 0 := ne_of_gt (rf_pos hc k)
  have h5 : rf (a+1-d) k ≠ 0 := ne_of_gt (rf_pos hd k)
  have h6 : rf (a+1-e) k ≠ 0 := ne_of_gt (rf_pos he k)
  have h7 : rf (a+1-f) k ≠ 0 := ne_of_gt (rf_pos hf k)
  field_simp
  <;> ring

lemma tail_double {a b c d e f : ℚ} (ha : 0 < a)
    (hb : 0 < a+1-b) (hc : 0 < a+1-c) (hd : 0 < a+1-d)
    (he : 0 < a+1-e) (hf : 0 < a+1-f) (n : ℕ) :
    ∑ k ∈ range (n+1), tailTerm a b c d e f n k =
      (n.factorial : ℚ)*rf (a+1) n *
      ((∑ j ∈ range (n+1), rf e j * rf f j * ec (a+1-e-f) (n-j) *
        ((∑ k ∈ range (j+1), rf c k * rf d k * ec (a+1-c-d) (j-k) *
          (ec (a-b) k / (rf a k * rf (a+1-b) k))) /
          (rf (a+1-c) j * rf (a+1-d) j))) /
        (rf (a+1-e) n * rf (a+1-f) n)) := by
  calc
    _ = (n.factorial : ℚ)*rf (a+1) n *
        BT a (fun k =>
          rf e k * rf f k / (rf (a+1-e) k * rf (a+1-f) k) *
          (rf c k * rf d k / (rf (a+1-c) k * rf (a+1-d) k) *
          (rf 1 k * rf b k / (rf a k * rf (a+1-b) k) * unitAlpha a k))) n := by
      unfold BT
      rw [mul_sum]
      apply sum_congr rfl
      intro k hk
      exact (tailTerm_BT ha hb hc hd he hf n k (by simpa using hk)).symm
    _ = _ := by
      have h := bailey_three (a := a) (b := 1) (c := b) (d := c) (e := d) (f := e) (g := f)
        ha (by linarith) hb hc hd he hf n
      simp only [add_sub_cancel_right, show a+1-1-b = a-b by ring] at h
      rw [h]

def U0 (t k : ℕ) : ℚ := base0 t * tailTerm (3*t) (2*t) (2*t+1/2) (2*t-1/2) (2*t+1/2) (2*t+1/2) t k
def U1 (t k : ℕ) : ℚ := base1 t * tailTerm (3*t+2) (2*t+1) (2*t+3/2) (2*t+3/2) (2*t+3/2) (2*t+3/2) t k

lemma U0_double (t : ℕ) (ht : 1 ≤ t) :
    ∑ k ∈ range (t+1), U0 t k = ∑ i ∈ range (t+1), ∑ j ∈ range (t-i+1), DT0 t i j := by
  have htq : (1 : ℚ) ≤ t := by exact_mod_cast ht
  simp only [U0, ← mul_sum]
  rw [tail_double (by positivity) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)]
  simp only [sum_div, mul_sum, sum_mul]
  rw [sum_triangle]
  apply sum_congr rfl
  intro i hi
  apply sum_congr rfl
  intro j hj
  simp only [Nat.add_sub_cancel_left]
  unfold DT0
  rw [show (((t-1 : ℕ) : ℚ)) = (t : ℚ)-1 by norm_cast]
  push_cast
  conv => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  conv => pattern (occs := *) ec _ _; all_goals (arg 1; ring_nf)
  simp only [div_eq_mul_inv, mul_inv_rev, inv_pow]
  ring

lemma U1_double (t : ℕ) (ht : 1 ≤ t) :
    ∑ k ∈ range (t+1), U1 t k = ∑ i ∈ range (t+1), ∑ j ∈ range (t-i+1), DT1 t i j := by
  have htq : (1 : ℚ) ≤ t := by exact_mod_cast ht
  simp only [U1, ← mul_sum]
  rw [tail_double (by positivity) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)]
  simp only [sum_div, mul_sum, sum_mul]
  rw [sum_triangle]
  apply sum_congr rfl
  intro i hi
  apply sum_congr rfl
  intro j hj
  simp only [Nat.add_sub_cancel_left]
  unfold DT1
  push_cast
  conv => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  conv => pattern (occs := *) ec _ _; all_goals (arg 1; ring_nf)
  simp only [div_eq_mul_inv, mul_inv_rev, inv_pow]
  ring

lemma U0_dyadic (t : ℕ) (ht : 1 ≤ t) : Dyadic (∑ k ∈ range (t+1), U0 t k) := by
  rw [U0_double t ht]
  apply dyadic_sum
  intro i hi
  apply dyadic_sum
  intro j hj
  apply DT0_dyadic t i j ht
  simp only [mem_range] at hi hj
  omega
lemma U1_dyadic (t : ℕ) (ht : 1 ≤ t) : Dyadic (∑ k ∈ range (t+1), U1 t k) := by
  rw [U1_double t ht]
  apply dyadic_sum
  intro i hi
  apply dyadic_sum
  intro j hj
  apply DT1_dyadic t i j ht
  simp only [mem_range] at hi hj
  omega
end SunProof

/- Base -/
namespace SunProof
lemma CB_nat (m : ℕ) : CB m = (Nat.centralBinom m : ℚ) := by
  unfold CB
  rw [Nat.centralBinom, Nat.cast_choose ℚ (by omega : m ≤ 2*m)]
  rw [show 2*m-m=m by omega]
  have hf : F (2*(m : ℤ)) = ((2*m).factorial : ℚ) := by
    rw [show 2*(m : ℤ) = ((2*m : ℕ) : ℤ) by push_cast; ring, F_nat]
  rw [hf, F_nat, pow_two]
lemma CB_succ (m : ℤ) (hm : 0 ≤ m) :
    CB (m+1) = 2*(2*m+1)/(m+1)*CB m := by
  lift m to ℕ using hm
  rw [show (m : ℤ)+1 = ((m+1 : ℕ) : ℤ) by push_cast; ring, CB_nat, CB_nat]
  have hh : (m+1 : ℚ) * (Nat.centralBinom (m+1) : ℚ) = 2*(2*m+1)*(Nat.centralBinom m : ℚ) := by
    exact_mod_cast Nat.succ_mul_centralBinom_succ m
  push_cast
  rw [div_mul_eq_mul_div]
  apply (eq_div_iff (by positivity : (m+1 : ℚ) ≠ 0)).2
  simpa [mul_comm] using hh

lemma CB_div_odd (m : ℕ) (hm : 1 ≤ m) :
    CB m / (2*(m : ℚ)-1) = 2*(catalan (m-1) : ℚ) := by
  obtain ⟨n,rfl⟩ := Nat.exists_eq_add_of_le hm
  rw [show 1+n = n+1 by omega, Nat.add_sub_cancel]
  rw [CB_nat]
  have h₁ := Nat.succ_mul_centralBinom_succ n
  have h₂ := succ_mul_catalan_eq_centralBinom n
  have h₃ : (n+1 : ℚ) * (Nat.centralBinom (n+1) : ℚ) =
      2*(2*n+1)*((n+1)* (catalan n : ℚ)) := by exact_mod_cast (by rw [h₂]; exact h₁)
  have hn : (n+1 : ℚ) ≠ 0 := by positivity
  have ho : 2*((n+1 : ℕ) : ℚ)-1 ≠ 0 := by
    have hnq : (0:ℚ) ≤ n := by positivity
    push_cast
    linarith
  apply (div_eq_iff ho).2
  push_cast
  apply mul_left_cancel₀ hn
  linear_combination h₃

def delta0 (t : ℕ) : ℚ := CB (2*(t : ℤ))^4 / (256*(4*(t : ℚ)-1))
lemma delta0_dyadic (t : ℕ) (ht : 1 ≤ t) : Dyadic (delta0 t) := by
  have he := CB_div_odd (2*t) (by omega)
  have hC : CB (2*(t : ℤ)) = (Nat.centralBinom (2*t) : ℚ) := by
    rw [show 2*(t : ℤ) = ((2*t : ℕ) : ℤ) by push_cast; ring, CB_nat]
  unfold Dyadic
  refine ⟨8, 2*(catalan (2*t-1) : ℤ)*(Nat.centralBinom (2*t) : ℤ)^3, ?_⟩
  unfold delta0
  have htq : (1 : ℚ) ≤ t := by exact_mod_cast ht
  have ho : 4*(t : ℚ)-1 ≠ 0 := by linarith
  norm_num only [Nat.reducePow]
  rw [show ((2*t : ℕ) : ℤ) = 2*(t : ℤ) by push_cast; ring] at he
  push_cast at he ⊢
  have he' : CB (2*(t : ℤ)) = 2 * (catalan (2*t-1) : ℚ) * (4*(t : ℚ)-1) := by
    apply (div_eq_iff ho).mp
    convert he using 1 <;> congr 1 <;> ring
  field_simp
  rw [hC] at he'
  rw [hC]
  linear_combination (Nat.centralBinom (2*t) : ℚ)^3 * he'
end SunProof

/- Certificates -/


set_option maxHeartbeats 0

set_option maxRecDepth 10000

namespace SunProof

def R0 (t k : ℚ) : ℚ := (-1 * (1 + 2 * k + 4 * t) ^ (3) * (k + 2 * t) * (t + -1 * k) * (-1 + 2 * k + 4 * t) * (2 + 2 * k + 3 * t)) / ((1 + 2 * k + 2 * t) ^ (3) * (2 * k + 3 * t) * (1 + k + t) * (1 + k + 4 * t) * (3 + 2 * k + 2 * t))

def Inv0 (t k : ℚ) : ℚ := ((1 + 2 * k + 2 * t) ^ (3) * (-1 + 2 * t) * (2 * k + 3 * t) * (1 + k + t) * (1 + k + 4 * t) * (2 + k + 4 * t)) / (16 * (1 + 2 * k + 4 * t) ^ (4) * (1 + 2 * t) * (k + 2 * t) * (-1 + 2 * k + 4 * t) * (2 + 2 * k + 3 * t))

def Q0 (t k : ℚ) : ℚ := ((1 + 2 * k + 2 * t) ^ (4) * (-1 + -1 * k + -1 * t) * (2 + k + 4 * t) * (-1 * k + -48 * (t) ^ (3) + -24 * (t) ^ (2) + -2 * t + -2 * (k) ^ (2) + 4 * (k) ^ (3) + 8 * (k) ^ (4) + 400 * (t) ^ (4) + 1344 * (t) ^ (5) + -16 * k * t + -16 * k * (t) ^ (2) + 12 * t * (k) ^ (2) + 48 * t * (k) ^ (4) + 96 * t * (k) ^ (3) + 392 * (k) ^ (2) * (t) ^ (2) + 432 * (k) ^ (3) * (t) ^ (2) + 672 * k * (t) ^ (3) + 1488 * (k) ^ (2) * (t) ^ (3) + 2320 * k * (t) ^ (4))) / ((1 + 2 * k + 4 * t) ^ (4) * (1 + 2 * t) * (k + 2 * t) * (-1 + 2 * k + 4 * t) * (2 + 2 * k + 3 * t))

def R1 (t k : ℚ) : ℚ := (-1 * (3 + 2 * k + 4 * t) ^ (4) * (t + -1 * k) * (1 + k + 2 * t) * (4 + 2 * k + 3 * t)) / ((3 + 2 * k + 2 * t) ^ (4) * (2 + k + t) * (2 + 2 * k + 3 * t) * (3 + k + 4 * t))

def Inv1 (t k : ℚ) : ℚ := ((1 + t) ^ (2) * (1 + t + -1 * k) * (2 + 2 * k + 3 * t) * (3 + k + 4 * t) * (3 + 2 * k + 2 * t) * (4 + k + 4 * t)) / (4 * (3 + 2 * k + 4 * t) ^ (3) * (3 + 4 * t) * (5 + 4 * t) * (1 + k + 2 * t) * (3 + 2 * k + 3 * t))

def Q1 (t k : ℚ) : ℚ := ((1 + 2 * k + 2 * t) ^ (3) * (-1 + -1 * k + -1 * t) * (3 + 2 * k + 2 * t) * (4 + k + 4 * t) * (309 + 98 * (k) ^ (2) + 343 * k + 1344 * (t) ^ (5) + 2086 * t + 5040 * (t) ^ (4) + 5616 * (t) ^ (2) + 7536 * (t) ^ (3) + 208 * (k) ^ (2) * (t) ^ (3) + 380 * t * (k) ^ (2) + 488 * (k) ^ (2) * (t) ^ (2) + 1040 * k * (t) ^ (4) + 1820 * k * t + 3168 * k * (t) ^ (3) + 3608 * k * (t) ^ (2))) / ((3 + 2 * k + 4 * t) ^ (3) * (2 + 2 * t) * (3 + 4 * t) * (5 + 4 * t) * (1 + k + 2 * t) * (3 + 2 * k + 3 * t))

lemma certificate0 (t k : ℚ) (ht : 1 ≤ t) (hk : 0 ≤ k) :
    R1 t k * Q0 t (k+1) - Q0 t k =
      (4*t+1)^3 - 32*(2*t+0)^3*Inv0 t k := by
  unfold R1 Q0 Inv0
  field_simp (disch := first | positivity | linarith only [ht, hk])
  ring


lemma certificate1 (t k : ℚ) (ht : 1 ≤ t) (hk : 0 ≤ k) :
    R0 (t+1) k * Q1 t (k+1) - Q1 t k =
      (4*t+3)^3 - 32*(2*t+1)^3*Inv1 t k := by
  unfold R0 Q1 Inv1
  field_simp (disch := first | positivity | linarith only [ht, hk])
  ring


end SunProof

/- WZ -/
set_option maxHeartbeats 0
set_option maxRecDepth 10000
namespace SunProof
open Finset

lemma U0_explicit (t k : ℕ) :
    U0 t k = base0 t * (3*t+2*k)/(3*t) * rf (-(t : ℚ)) k *
      (rf (2*t+1/2) k)^3 * rf (2*t-1/2) k * rf (2*t) k /
      (rf (4*t+1) k * (rf (t+1/2) k)^3 * rf (t+3/2) k * rf (t+1) k) := by
  unfold U0 tailTerm
  conv => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  simp only [div_eq_mul_inv, mul_inv_rev, inv_pow]
  ring
lemma U1_explicit (t k : ℕ) :
    U1 t k = base1 t * (3*t+2+2*k)/(3*t+2) * rf (-(t : ℚ)) k *
      (rf (2*t+3/2) k)^4 * rf (2*t+1) k /
      (rf (4*t+3) k * (rf (t+3/2) k)^4 * rf (t+2) k) := by
  unfold U1 tailTerm
  conv => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  simp only [div_eq_mul_inv, mul_inv_rev, inv_pow]
  ring

lemma U0_rec (t k : ℕ) (ht : 1 ≤ t) : U0 t (k+1) = R0 t k * U0 t k := by
  rw [U0_explicit, U0_explicit]
  simp only [rf_succ, Nat.cast_add, Nat.cast_one]
  unfold R0
  have htq : (1:ℚ) ≤ t := by exact_mod_cast ht
  have hkq : (0:ℚ) ≤ k := by positivity
  field_simp (disch := first | exact ne_of_gt (rf_pos (by linarith only [htq, hkq]) _) | positivity | linarith only [htq, hkq])
  ring
lemma U1_rec (t k : ℕ) (ht : 1 ≤ t) : U1 t (k+1) = R1 t k * U1 t k := by
  rw [U1_explicit, U1_explicit]
  simp only [rf_succ, Nat.cast_add, Nat.cast_one]
  unfold R1
  have htq : (1:ℚ) ≤ t := by exact_mod_cast ht
  have hkq : (0:ℚ) ≤ k := by positivity
  field_simp (disch := first | exact ne_of_gt (rf_pos (by linarith only [htq, hkq]) _) | positivity | linarith only [htq, hkq])
  ring

lemma rf_param (x : ℚ) (hx : x ≠ 0) (k : ℕ) :
    rf (x+1) k = rf x k * (x+k) / x := by
  apply (eq_div_iff hx).2
  simpa only [mul_comm] using rf_shift x k

lemma U_contig0 (t k : ℕ) (ht : 1 ≤ t) :
    U0 t k = Inv0 t k * U1 t k := by
  rw [U0_explicit, U1_explicit]
  unfold base0 base1
  rw [CB_succ (2*(t : ℤ)) (by omega)]
  push_cast
  have htq : (1:ℚ) ≤ t := by exact_mod_cast ht
  have hkq : (0:ℚ) ≤ k := by positivity
  have h0 := rf_param (2*(t : ℚ)) (by linarith only [htq]) k
  conv at h0 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h1 := rf_param (2*(t : ℚ)-1/2) (by linarith only [htq]) k
  conv at h1 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h2 := rf_param (2*(t : ℚ)+1/2) (by linarith only [htq]) k
  conv at h2 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h3 := rf_param (4*(t : ℚ)+1) (by linarith only [htq]) k
  conv at h3 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h4 := rf_param (4*(t : ℚ)+2) (by linarith only [htq]) k
  conv at h4 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h5 := rf_param ((t : ℚ)+1/2) (by linarith only [htq]) k
  conv at h5 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h6 := rf_param ((t : ℚ)+1) (by linarith only [htq]) k
  conv at h6 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  conv => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  simp only [h6, h5, h4, h3, h2, h1, h0]
  unfold Inv0
  field_simp (disch := first | exact ne_of_gt (rf_pos (by linarith only [htq, hkq]) _) | positivity | linarith only [htq, hkq])
  ring

lemma U_contig1 (t k : ℕ) (ht : 1 ≤ t) :
    U1 t k = Inv1 t k * U0 (t+1) k := by
  rw [U1_explicit, U0_explicit]
  unfold base0 base1
  rw [show 2*((t+1 : ℕ) : ℤ) = (2*(t : ℤ)+1)+1 by omega, CB_succ (2*(t : ℤ)+1) (by omega)]
  push_cast
  have htq : (1:ℚ) ≤ t := by exact_mod_cast ht
  have hkq : (0:ℚ) ≤ k := by positivity
  have h0 := rf_param (-(t : ℚ)-1) (by linarith only [htq]) k
  conv at h0 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h1 := rf_param (2*(t : ℚ)+1) (by linarith only [htq]) k
  conv at h1 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h2 := rf_param (2*(t : ℚ)+3/2) (by linarith only [htq]) k
  conv at h2 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h3 := rf_param (4*(t : ℚ)+3) (by linarith only [htq]) k
  conv at h3 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h4 := rf_param (4*(t : ℚ)+4) (by linarith only [htq]) k
  conv at h4 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  have h5 := rf_param ((t : ℚ)+3/2) (by linarith only [htq]) k
  conv at h5 => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  conv => pattern (occs := *) rf _ _; all_goals (arg 1; ring_nf)
  simp only [h5, h4, h3, h2, h1, h0]
  unfold Inv1
  field_simp (disch := first | exact ne_of_gt (rf_pos (by linarith only [htq, hkq]) _) | positivity | linarith only [htq, hkq])
  ring

end SunProof

/- Boundaries -/
set_option maxHeartbeats 0
set_option maxRecDepth 10000
namespace SunProof

def Pq (m : ℚ) : ℚ := 21*m^3+22*m^2+8*m+1
lemma boundary0 (t : ℕ) (ht : 1 ≤ t) :
    -Q0 t 0 * base1 t - 32*(2*(t : ℚ))^3*delta0 t =
      Pq (2*t) * CB (2*(t : ℤ))^4 / 16 := by
  unfold base1 delta0 Pq Q0
  rw [CB_succ (2*(t : ℤ)) (by omega)]
  push_cast
  have htq : (1:ℚ) ≤ t := by exact_mod_cast ht
  field_simp (disch := first | positivity | linarith only [htq])
  ring
lemma boundary1 (t : ℕ) (ht : 1 ≤ t) :
    -Q1 t 0 * base0 (t+1 : ℕ) + (4*(t : ℚ)+3)^3*delta0 (t+1) =
      Pq (2*t+1) * CB (2*(t : ℤ)+1)^4 / 16 := by
  unfold base0 delta0 Pq Q1
  rw [show 2*((t+1 : ℕ) : ℤ) = (2*(t : ℤ)+1)+1 by omega, CB_succ (2*(t : ℤ)+1) (by omega)]
  push_cast
  have htq : (1:ℚ) ≤ t := by exact_mod_cast ht
  field_simp (disch := first | positivity | linarith only [htq])
  ring
end SunProof

/- Values -/
set_option maxHeartbeats 0
set_option maxRecDepth 10000
namespace SunProof
open Finset

lemma U0_zero (t k : ℕ) (hk : t < k) : U0 t k = 0 := by
  simp [U0, tailTerm, rf_neg_zero t k hk]
lemma U1_zero (t k : ℕ) (hk : t < k) : U1 t k = 0 := by
  simp [U1, tailTerm, rf_neg_zero t k hk]
lemma U0_init (t : ℕ) (ht : 1 ≤ t) : U0 t 0 = base0 t := by
  have htq : (0:ℚ) < t := by exact_mod_cast (by omega : 0 < t)
  simp [U0, tailTerm, rf, ne_of_gt htq]
lemma U1_init (t : ℕ) (ht : 1 ≤ t) : U1 t 0 = base1 t := by
  have htq : (0:ℚ) < t := by exact_mod_cast (by omega : 0 < t)
  have hh : 3*(t : ℚ)+2 ≠ 0 := by positivity
  simp [U1, tailTerm, rf, hh]

lemma WZ0 (t k : ℕ) (ht : 1 ≤ t) :
    (4*(t : ℚ)+1)^3 * U1 t k - 32*(2*(t : ℚ))^3*U0 t k =
      Q0 t (k+1) * U1 t (k+1) - Q0 t k * U1 t k := by
  have h := certificate0 (t : ℚ) (k : ℚ) (by exact_mod_cast ht) (by positivity)
  rw [U1_rec t k ht, U_contig0 t k ht]
  linear_combination -U1 t k * h
lemma WZ1 (t k : ℕ) (ht : 1 ≤ t) :
    (4*(t : ℚ)+3)^3 * U0 (t+1) k - 32*(2*(t : ℚ)+1)^3*U1 t k =
      Q1 t (k+1) * U0 (t+1) (k+1) - Q1 t k * U0 (t+1) k := by
  have h := certificate1 (t : ℚ) (k : ℚ) (by exact_mod_cast ht) (by positivity)
  rw [U0_rec (t+1) k (by omega), U_contig1 t k ht]
  push_cast
  linear_combination -U0 (t+1) k * h

def V0 (t : ℕ) : ℚ := delta0 t + ∑ k ∈ range (t+1), U0 t k
def V1 (t : ℕ) : ℚ := ∑ k ∈ range (t+1), U1 t k
lemma V0_dyadic (t : ℕ) (ht : 1 ≤ t) : Dyadic (V0 t) :=
  dyadic_add (delta0_dyadic t ht) (U0_dyadic t ht)
lemma V1_dyadic (t : ℕ) (ht : 1 ≤ t) : Dyadic (V1 t) := U1_dyadic t ht

lemma V_step0 (t : ℕ) (ht : 1 ≤ t) :
    (4*(t : ℚ)+1)^3 * V1 t = 32*(2*(t : ℚ))^3*V0 t + Pq (2*t)*CB (2*(t : ℤ))^4/16 := by
  have hs : (4*(t : ℚ)+1)^3 * (∑ k ∈ range (t+1), U1 t k) -
      32*(2*(t : ℚ))^3 * (∑ k ∈ range (t+1), U0 t k) = -Q0 t 0 * base1 t := by
    rw [mul_sum, mul_sum, ← sum_sub_distrib]
    simp_rw [WZ0 t _ ht]
    have hh := sum_range_sub (fun k => Q0 t k * U1 t k) (t+1)
    simp only [Nat.cast_add, Nat.cast_one, Nat.cast_zero] at hh
    rw [hh]
    rw [U1_zero t (t+1) (by omega), U1_init t ht]
    ring
  have hb := boundary0 t ht
  unfold V0 V1
  linear_combination hs + hb
lemma V_step1 (t : ℕ) (ht : 1 ≤ t) :
    (4*(t : ℚ)+3)^3 * V0 (t+1) = 32*(2*(t : ℚ)+1)^3*V1 t + Pq (2*t+1)*CB (2*(t : ℤ)+1)^4/16 := by
  have hs : (4*(t : ℚ)+3)^3 * (∑ k ∈ range (t+2), U0 (t+1) k) -
      32*(2*(t : ℚ)+1)^3 * (∑ k ∈ range (t+2), U1 t k) = -Q1 t 0 * base0 (t+1 : ℕ) := by
    rw [mul_sum, mul_sum, ← sum_sub_distrib]
    simp_rw [WZ1 t _ ht]
    have hh := sum_range_sub (fun k => Q1 t k * U0 (t+1) k) (t+2)
    simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one, Nat.cast_zero] at hh
    rw [hh]
    rw [U0_zero (t+1) (t+2) (by omega), U0_init (t+1) (by omega)]
    ring
  rw [sum_range_succ (n := t+1) (f := U1 t), U1_zero t (t+1) (by omega), add_zero] at hs
  have hb := boundary1 t ht
  unfold V0 V1
  change (4*(t : ℚ)+3)^3 * (delta0 (t+1) + ∑ k ∈ range (t+2), U0 (t+1) k) = _
  linear_combination hs + hb

lemma V0_initial : V0 1 = 2 := by
  norm_num [V0, delta0, base0, U0, tailTerm, CB, F, rf, sum_range_succ, Int.toNat, Nat.factorial]
end SunProof

/- Match -/
namespace SunProof
lemma central_half' (n : ℕ) :
    Nat.centralBinom (n+1) = 2*Nat.choose (2*(n+1)-1) (n+1) := by
  rw [Nat.centralBinom_eq_two_mul_choose]
  have h : 2*(n+1) = (2*n+1)+1 := by omega
  rw [h, Nat.choose_succ_succ]
  have hs : Nat.choose (2*n+1) n = Nat.choose (2*n+1) (n+1) := by
    simpa only [show 2*n+1-n=n+1 by omega] using
      (Nat.choose_symm (n := 2*n+1) (k := n) (by omega)).symm
  rw [hs]
  simp [Nat.succ_eq_add_one, two_mul]
lemma aQ_central (n : ℕ) (hn : 2 ≤ n) :
    (2*(n : ℚ)+1)^3*a_Q n = 32*(n : ℚ)^3*a_Q (n-1)+ Pq n * CB n ^4 /16 := by
  rw [CB_nat]
  rcases n with _ | (_ | k)
  · omega
  · omega
  · rw [a_Q, central_half' (k+1)]
    unfold Pq
    push_cast
    field_simp
    ring

lemma match_step0 (t : ℕ) (ht : 1 ≤ t) (h : a_Q (2*t-1) = V0 t) :
    a_Q (2*t) = V1 t := by
  have hh := aQ_central (2*t) (by omega)
  rw [h] at hh
  push_cast at hh
  have hv := V_step0 t ht
  apply mul_left_cancel₀ (show (4*(t : ℚ)+1)^3 ≠ 0 by positivity)
  linear_combination hh - hv
lemma match_step1 (t : ℕ) (ht : 1 ≤ t) (h : a_Q (2*t) = V1 t) :
    a_Q (2*(t+1)-1) = V0 (t+1) := by
  rw [show 2*(t+1)-1=2*t+1 by omega]
  have hh := aQ_central (2*t+1) (by omega)
  rw [Nat.add_sub_cancel, h] at hh
  push_cast at hh
  have hv := V_step1 t ht
  apply mul_left_cancel₀ (show (4*(t : ℚ)+3)^3 ≠ 0 by positivity)
  linear_combination hh - hv

lemma match_pair (k : ℕ) :
    a_Q (2*(k+1)-1) = V0 (k+1) ∧ a_Q (2*(k+1)) = V1 (k+1) := by
  induction k with
  | zero =>
    have h0 : a_Q (2*(0+1)-1) = V0 (0+1) := by rw [V0_initial]; rfl
    exact ⟨h0, match_step0 1 (by omega) h0⟩
  | succ k ih =>
    have h0 := match_step1 (k+1) (by omega) ih.2
    exact ⟨h0, match_step0 (k+1+1) (by omega) h0⟩

lemma aQ_dyadic (n : ℕ) (hn : 1 ≤ n) : Dyadic (a_Q n) := by
  rcases Nat.even_or_odd n with he | ho
  · obtain ⟨t,rfl⟩ := even_iff_exists_two_mul.mp he
    have ht : 1 ≤ t := by omega
    have h := (match_pair (t-1)).2
    rw [Nat.sub_add_cancel ht] at h
    rw [h]
    exact V1_dyadic t ht
  · obtain ⟨k,rfl⟩ := odd_iff_exists_bit1.mp ho
    have h := (match_pair k).1
    rw [show 2*(k+1)-1=2*k+1 by omega] at h
    rw [h]
    exact V0_dyadic (k+1) (by omega)

 theorem settled (n : ℕ) (hn : 1 ≤ n) :
    a n > 0 ∧ (Odd (a n) ↔ ∃ m : ℕ, m ≥ 1 ∧ n = 2^m) := by
  apply conjecture_of_dyadic_den (fun k hk => dyadic_den (aQ_dyadic k hk)) n hn
end SunProof

/--
Conjecture of Zhi-Wei Sun (A176477):
Each term $a(n)$ is a positive integer.
Also, $a(n)$ is odd if and only if $n = 2^m$ for some $m \in \mathbb{Z}_{>0}$.
-/
theorem oeis_a176477_conjecture (n : ℕ) (hn : n ≥ 1) :
  a n > 0 ∧ (Odd (a n) ↔ ∃ m : ℕ, m ≥ 1 ∧ n = 2^m) := by
  exact SunProof.settled n hn

theorem oeis_a176477_conjecture.disproof : ¬ (type_of% @oeis_a176477_conjecture) := sorry

