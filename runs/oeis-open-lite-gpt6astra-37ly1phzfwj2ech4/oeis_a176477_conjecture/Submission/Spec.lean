import FormalConjectures.Util.ProblemImports

open Nat

/-- Helper function for the recurrence relation, defined over $\mathbb{Q}$. -/
noncomputable def a_Q (n : ℕ) : ℚ :=
  match n with
  | 0 => 0
  | 1 => 2
  | k + 2 => -- Index $n = k+2$, $n \ge 2$
    let n_idx := k + 2
    let n_q : ℚ := n_idx
    -- The subtraction n_idx - 1 is safe since n_idx ≥ 2
    let a_prev : ℚ := a_Q (n_idx - 1)

    -- Numerator Term 1: $32n^3 a(n-1)$
    let term1 : ℚ := 32 * n_q ^ 3 * a_prev

    -- Polynomial coefficient Term 2
    let P_n : ℚ := 21 * n_q ^ 3 + 22 * n_q ^ 2 + 8 * n_q + 1

    -- Binomial Term 2: $\binom{2n-1}{n}^4$. Subtraction is safe since $2n-1 \ge 3$
    let binom_pow4 : ℚ := (Nat.choose (2 * n_idx - 1) n_idx : ℚ) ^ 4

    let numerator : ℚ := term1 + P_n * binom_pow4
    let denominator : ℚ := (2 * n_q + 1) ^ 3

    numerator / denominator

/--
A176477: $a(1)=2$; for $n \ge 2$,
$$(2n+1)^3 a(n) = 32n^3 a(n-1) + (21n^3 + 22n^2 + 8n + 1) \binom{2n-1}{n}^4.$$
The sequence terms are non-negative integers. We compute the result using the rational recurrence and cast the result to $\mathbb{N}$.
-/
noncomputable def a (n : ℕ) : ℕ := (a_Q n).floor.toNat


/-!
Proof outline: positivity and parity reduce the assertion to integrality.
The reduced denominators of the recurrence are odd. A terminating
very-well-poised sum, verified by two telescoping certificates, gives
the recurrence terms. Three Bailey transformations express that sum
as a double sum with dyadic summands. The factorial ratios occurring
in these summands are integral by Legendre's formula and the two
finite, Lean-checked floor-inequality case analyses below.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000

lemma a_Q_ge_one (n : ℕ) (hn : 1 ≤ n) : 1 ≤ a_Q n := by
  induction n using Nat.twoStepInduction with
  | zero => omega
  | one => norm_num [a_Q]
  | more n ih₀ ih₁ =>
    have hp : 1 ≤ a_Q (n + 1) := ih₁ (by omega)
    have hq : (0 : ℚ) ≤ n := by positivity
    have hc : (0 : ℚ) ≤ ((2 * (n + 2) - 1).choose (n + 2) : ℚ) ^ 4 := by positivity
    simp only [a_Q]
    push_cast
    apply (le_div_iff₀ (by positivity)).2
    have hprod : 32 * ((n : ℚ) + 2) ^ 3 ≤
        32 * ((n : ℚ) + 2) ^ 3 * a_Q (n + 1) := by
      nlinarith [mul_nonneg (show (0 : ℚ) ≤ 32 * ((n : ℚ) + 2) ^ 3 by positivity)
        (sub_nonneg.mpr hp)]
    have hterm : (0 : ℚ) ≤
        (21 * ((n : ℚ) + 2) ^ 3 + 22 * ((n : ℚ) + 2) ^ 2 + 8 * ((n : ℚ) + 2) + 1) *
        ((2 * (n + 2) - 1).choose (n + 2) : ℚ) ^ 4 := by positivity
    nlinarith [sq_nonneg (n : ℚ), pow_nonneg hq 3]

lemma a_pos (n : ℕ) (hn : 1 ≤ n) : 0 < a n := by
  have h := a_Q_ge_one n hn
  unfold a
  have hf : (1 : ℤ) ≤ (a_Q n).floor := by
    exact (Int.le_floor).2 (by simpa using h)
  omega

lemma half_choose_double_mod (k : ℕ) (hk : 1 ≤ k) :
    (Nat.choose (2 * (2 * k) - 1) (2 * k)) % 2 =
      (Nat.choose (2 * k - 1) k) % 2 := by
  have h := Choose.choose_modEq_choose_mod_mul_choose_div_nat
    (n := 2 * (2 * k) - 1) (k := 2 * k) (p := 2)
  have he₁ : (2 * (2 * k) - 1) % 2 = 1 := by omega
  have he₂ : (2 * (2 * k) - 1) / 2 = 2 * k - 1 := by omega
  simpa [Nat.ModEq, he₁, he₂] using h

lemma half_choose_odd_mod (k : ℕ) (hk : 1 ≤ k) :
    (Nat.choose (2 * (2 * k + 1) - 1) (2 * k + 1)) % 2 = 0 := by
  have h := Choose.choose_modEq_choose_mod_mul_choose_div_nat
    (n := 2 * (2 * k + 1) - 1) (k := 2 * k + 1) (p := 2)
  have he₁ : (2 * (2 * k + 1) - 1) % 2 = 1 := by omega
  have he₂ : (2 * (2 * k + 1) - 1) / 2 = 2 * k := by omega
  have he₃ : (2 * k + 1) / 2 = k := by omega
  have hd : (Nat.choose (2 * k) k) % 2 = 0 :=
    Nat.mod_eq_zero_of_dvd (Nat.two_dvd_centralBinom_of_one_le hk)
  simpa [Nat.ModEq, he₁, he₂, he₃, Nat.add_mod, hd] using h

lemma half_choose_odd_iff (n : ℕ) (hn : 1 ≤ n) :
    Odd (Nat.choose (2 * n - 1) n) ↔ ∃ m : ℕ, n = 2 ^ m := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases Nat.even_or_odd n with he | ho
    · obtain ⟨k, hk⟩ := even_iff_exists_two_mul.mp he
      subst n
      have hkpos : 1 ≤ k := by omega
      have hklt : k < 2 * k := by omega
      rw [Nat.odd_iff, half_choose_double_mod k hkpos, ← Nat.odd_iff,
        ih k hklt hkpos]
      constructor
      · rintro ⟨m, hm⟩
        exact ⟨m + 1, by rw [hm, pow_succ]; omega⟩
      · rintro ⟨m, hm⟩
        cases m with
        | zero => simp at hm
        | succ m =>
          refine ⟨m, ?_⟩
          rw [pow_succ] at hm
          omega
    · obtain ⟨k, hk⟩ := odd_iff_exists_bit1.mp ho
      subst n
      by_cases hk0 : k = 0
      · subst k
        simp only [mul_zero, zero_add, Nat.reduceMul, Nat.reduceSub, Nat.choose_self]
        constructor
        · intro _; exact ⟨0, by norm_num⟩
        · intro _; exact ⟨0, by norm_num⟩
      · have hnodd : ¬ Odd (Nat.choose (2 * (2 * k + 1) - 1) (2 * k + 1)) := by
          rw [Nat.odd_iff, half_choose_odd_mod k (by omega)]
          omega
        constructor
        · intro h; exact (hnodd h).elim
        · rintro ⟨m, hm⟩
          cases m with
          | zero => simp at hm; omega
          | succ m =>
            rw [pow_succ] at hm
            omega

lemma a_nat_rec_of_cast
    (hI : ∀ n : ℕ, 1 ≤ n → (a n : ℚ) = a_Q n) (k : ℕ) :
    (2 * (k + 2) + 1) ^ 3 * a (k + 2) =
      32 * (k + 2) ^ 3 * a (k + 1) +
      (21 * (k + 2) ^ 3 + 22 * (k + 2) ^ 2 + 8 * (k + 2) + 1) *
        (Nat.choose (2 * (k + 2) - 1) (k + 2)) ^ 4 := by
  apply Nat.cast_injective (R := ℚ)
  push_cast
  rw [hI (k + 2) (by omega), hI (k + 1) (by omega)]
  rw [a_Q]
  push_cast
  field_simp

lemma a_mod_two_of_cast
    (hI : ∀ n : ℕ, 1 ≤ n → (a n : ℚ) = a_Q n) (k : ℕ) :
    (a (k + 2)) % 2 =
      ((k + 2 + 1) * Nat.choose (2 * (k + 2) - 1) (k + 2)) % 2 := by
  have h := congrArg (fun z : ℕ => z % 2) (a_nat_rec_of_cast hI k)
  have hk := Nat.mod_lt (k + 2) (by norm_num : 0 < 2)
  have hb := Nat.mod_lt (Nat.choose (2 * (k + 2) - 1) (k + 2)) (by norm_num : 0 < 2)
  rcases (show (k + 2) % 2 = 0 ∨ (k + 2) % 2 = 1 by omega) with he | he <;>
    rcases (show (Nat.choose (2 * (k + 2) - 1) (k + 2)) % 2 = 0 ∨
      (Nat.choose (2 * (k + 2) - 1) (k + 2)) % 2 = 1 by omega) with hc | hc <;>
    simpa [Nat.add_mod, Nat.mul_mod, Nat.pow_mod, he, hc] using h

lemma conjecture_of_cast
    (hI : ∀ n : ℕ, 1 ≤ n → (a n : ℚ) = a_Q n) (n : ℕ) (hn : 1 ≤ n) :
    a n > 0 ∧ (Odd (a n) ↔ ∃ m : ℕ, m ≥ 1 ∧ n = 2 ^ m) := by
  refine ⟨a_pos n hn, ?_⟩
  rcases n with _ | (_ | k)
  · omega
  · have ha1 : a 1 = 2 := rfl
    change Odd (a 1) ↔ ∃ m, 1 ≤ m ∧ 1 = 2 ^ m
    rw [ha1]
    norm_num [Nat.odd_iff]
    intro m hm he
    have : 2 ≤ 2 ^ m := by
      simpa using Nat.pow_le_pow_right (by norm_num : 1 ≤ 2) hm
    omega
  · change Odd (a (k + 2)) ↔ ∃ m : ℕ, 1 ≤ m ∧ k + 2 = 2 ^ m
    rw [Nat.odd_iff, a_mod_two_of_cast hI, ← Nat.odd_iff, Nat.odd_mul,
      half_choose_odd_iff (k + 2) (by omega)]
    constructor
    · rintro ⟨_, m, hm⟩
      refine ⟨m, ?_, hm⟩
      cases m with
      | zero => simp at hm
      | succ m => omega
    · rintro ⟨m, hm, he⟩
      refine ⟨?_, m, he⟩
      cases m with
      | zero => omega
      | succ m =>
        rw [he, pow_succ]
        exact ⟨2 ^ m, by omega⟩

lemma conjecture_of_integral
    (hI : ∀ n : ℕ, 1 ≤ n → ∃ z : ℤ, (z : ℚ) = a_Q n)
    (n : ℕ) (hn : 1 ≤ n) :
    a n > 0 ∧ (Odd (a n) ↔ ∃ m : ℕ, m ≥ 1 ∧ n = 2 ^ m) := by
  apply conjecture_of_cast ?_ n hn
  intro m hm
  obtain ⟨z, hz⟩ := hI m hm
  have hznonneg : 0 ≤ z := by
    have hq := (a_Q_ge_one m hm).trans' (by norm_num : (0 : ℚ) ≤ 1)
    rw [← hz] at hq
    exact_mod_cast hq
  unfold a
  rw [← hz]
  change (((⌊(z : ℚ)⌋).toNat : ℕ) : ℚ) = (z : ℚ)
  rw [Int.floor_intCast]
  exact_mod_cast Int.toNat_of_nonneg hznonneg

private def poly (n : ℕ) : ℕ := 21 * n ^ 3 + 22 * n ^ 2 + 8 * n + 1
private lemma odd_den_add {x y : ℚ} (hx : Odd x.den) (hy : Odd y.den) :
    Odd (x + y).den :=
  (hx.mul hy).of_dvd_nat (Rat.add_den_dvd x y)

private lemma odd_den_mul {x y : ℚ} (hx : Odd x.den) (hy : Odd y.den) :
    Odd (x * y).den :=
  (hx.mul hy).of_dvd_nat (Rat.mul_den_dvd x y)

private lemma odd_den_div_nat {x : ℚ} {d : ℕ} (hx : Odd x.den) (hd : Odd d) :
    Odd (x / (d : ℚ)).den := by
  rw [div_eq_mul_inv]
  apply odd_den_mul hx
  rw [Rat.den_inv]
  simp only [Rat.num_natCast, Int.natCast_eq_zero, Int.natAbs_natCast]
  split_ifs with h
  · simp
  · exact hd

lemma a_Q_den_odd (n : ℕ) : Odd (a_Q n).den := by
  induction n using Nat.twoStepInduction with
  | zero => norm_num [a_Q]
  | one => norm_num [a_Q]
  | more n ih₀ ih₁ =>
    have he : a_Q (n + 2) =
        (((32 * (n + 2) ^ 3 : ℕ) : ℚ) * a_Q (n + 1) +
          ((poly (n + 2) * (Nat.choose (2 * (n + 2) - 1) (n + 2)) ^ 4 : ℕ) : ℚ)) /
          (((2 * (n + 2) + 1) ^ 3 : ℕ) : ℚ) := by
      simp only [a_Q, poly]
      push_cast
      rfl
    rw [he]
    apply odd_den_div_nat
    · apply odd_den_add
      · apply odd_den_mul _ ih₁
        simp only [Rat.den_natCast, odd_one]
      · simp only [Rat.den_natCast, odd_one]
    · exact (show Odd (2 * (n + 2) + 1) from ⟨n + 2, by omega⟩).pow

#print axioms a_Q_den_odd

lemma conjecture_of_dyadic_den
    (hD : ∀ n : ℕ, 1 ≤ n → ∃ r : ℕ, (a_Q n).den ∣ 2 ^ r)
    (n : ℕ) (hn : 1 ≤ n) :
    a n > 0 ∧ (Odd (a n) ↔ ∃ m : ℕ, 1 ≤ m ∧ n = 2 ^ m) := by
  apply conjecture_of_integral ?_ n hn
  intro k hk
  obtain ⟨r, hr⟩ := hD k hk
  have hc : (a_Q k).den.Coprime (2 ^ r) :=
    (Nat.coprime_two_right.mpr (a_Q_den_odd k)).pow_right r
  exact ⟨(a_Q k).num, (Rat.den_eq_one_iff _).mp (hc.eq_one_of_dvd hr)⟩

/- Hypergeom -/

namespace SunProof
open Finset PowerSeries

def rf (x : ℚ) : ℕ → ℚ
  | 0 => 1
  | n + 1 => rf x n * (x + n)

lemma rf_zero (x : ℚ) : rf x 0 = 1 := rfl
lemma rf_succ (x : ℚ) (n : ℕ) : rf x (n+1) = rf x n * (x+n) := rfl
lemma rf_pos {x : ℚ} (hx : 0 < x) (n : ℕ) : 0 < rf x n := by
  induction n with
  | zero => norm_num [rf]
  | succ n ih => rw [rf_succ]; positivity

lemma rf_add (x : ℚ) (n m : ℕ) :
    rf x (n+m) = rf x n * rf (x+n) m := by
  induction m with
  | zero => simp [rf]
  | succ m ih =>
    rw [Nat.add_succ, rf_succ, ih, rf_succ]
    push_cast
    ring

def ec (d : ℚ) (n : ℕ) : ℚ := rf d n / n.factorial
def hc (a b c : ℚ) (n : ℕ) : ℚ := rf b n * rf c n / (rf a n * n.factorial)
lemma ec_rec (d : ℚ) (n : ℕ) :
    (n+1 : ℚ) * ec d (n+1) = (d+n) * ec d n := by
  unfold ec
  rw [rf_succ, Nat.factorial_succ]
  push_cast
  have hn : (n.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hn' : (n : ℚ)+1 ≠ 0 := by positivity
  field_simp
  <;> ring

lemma hc_rec {a : ℚ} (ha : 0 < a) (b c : ℚ) (n : ℕ) :
    (n+1 : ℚ) * (a+n) * hc a b c (n+1) = (b+n)*(c+n)*hc a b c n := by
  unfold hc
  rw [rf_succ, rf_succ, rf_succ, Nat.factorial_succ]
  push_cast
  have hn : (n.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hn' : (n : ℚ)+1 ≠ 0 := by positivity
  have hr : rf a n ≠ 0 := ne_of_gt (rf_pos ha n)
  have har : a+(n : ℚ) ≠ 0 := by positivity
  field_simp
  <;> ring

noncomputable def ES (d : ℚ) : PowerSeries ℚ := PowerSeries.mk (ec d)
noncomputable def HS (a b c : ℚ) : PowerSeries ℚ := PowerSeries.mk (hc a b c)
noncomputable abbrev D := PowerSeries.derivative ℚ
noncomputable def ode (a b c : ℚ) (f : PowerSeries ℚ) : PowerSeries ℚ :=
  X * (1-X) * D (D f) + (C a - C (b+c+1)*X) * D f - C (b*c)*f

lemma ode_expand (a b c : ℚ) (f : PowerSeries ℚ) :
    ode a b c f = X * D (D f) - X*(X*D (D f)) + C a * D f -
      C (b+c+1)*(X*D f) - C (b*c)*f := by
  unfold ode
  ring

lemma coeff_ode (a b c : ℚ) (f : PowerSeries ℚ) (n : ℕ) :
    coeff n (ode a b c f) =
      (n+1 : ℚ)*(a+n)*coeff (n+1) f - (b+n)*(c+n)*coeff n f := by
  rw [ode_expand]
  rcases n with _ | (_ | n) <;>
    simp only [map_sub, map_add, coeff_C_mul, coeff_zero_X_mul, coeff_succ_X_mul,
      coeff_derivative, Nat.cast_add, Nat.cast_one, Nat.cast_zero, add_mul, mul_assoc] <;> ring

lemma ES_equation (d : ℚ) : (1-X)*D (ES d) = C d * ES d := by
  ext n
  rw [sub_mul, one_mul]
  cases n with
  | zero =>
    simp only [map_sub, coeff_derivative, coeff_zero_X_mul, coeff_C_mul, ES, coeff_mk]
    norm_num [ec, rf]
  | succ n =>
    simp only [map_sub, coeff_derivative, coeff_succ_X_mul, coeff_C_mul,
      ES, coeff_mk]
    have h := ec_rec d (n+1)
    push_cast at h ⊢
    linear_combination h

lemma HS_equation {a : ℚ} (ha : 0 < a) (b c : ℚ) :
    ode a b c (HS a b c) = 0 := by
  ext n
  rw [coeff_ode]
  simp only [HS, coeff_mk, map_zero]
  exact sub_eq_zero.mpr (hc_rec ha b c n)

lemma ode_unique {a b c : ℚ} (ha : 0 < a) {f g : PowerSeries ℚ}
    (hf : ode a b c f = 0) (hg : ode a b c g = 0)
    (h0 : coeff 0 f = coeff 0 g) : f = g := by
  ext n
  induction n with
  | zero => exact h0
  | succ n ih =>
    have h₁ := congrArg (coeff n) hf
    have h₂ := congrArg (coeff n) hg
    rw [coeff_ode] at h₁ h₂
    simp only [map_zero] at h₁ h₂
    have hn : (n+1 : ℚ)*(a+n) ≠ 0 := by positivity
    apply mul_left_cancel₀ hn
    linear_combination h₁ - h₂ + (b+n)*(c+n)*ih

lemma ES_equation_two (d : ℚ) :
    (1-X)*D (D (ES d)) = C (d+1)*D (ES d) := by
  have h := congrArg D (ES_equation d)
  simp only [D, Derivation.leibniz, smul_eq_mul, map_sub, Derivation.map_one_eq_zero, derivative_X, derivative_C, zero_sub,
    zero_mul, add_zero] at h
  simp only [map_add, map_one]
  linear_combination h

lemma euler_ode {a b c : ℚ} (ha : 0 < a) :
    ode a (a-b) (a-c) (ES (a-b-c) * HS a b c) = 0 := by
  let E := ES (a-b-c)
  let F := HS a b c
  have h₁ : (1-X)*D E = C (a-b-c)*E := ES_equation _
  have h₂ : (1-X)*D (D E) = C (a-b-c+1)*D E := ES_equation_two _
  have h₃ : ode a b c F = 0 := HS_equation ha b c
  change ode a (a-b) (a-c) (E*F) = 0
  unfold ode at h₃ ⊢
  simp only [D, Derivation.leibniz, smul_eq_mul, map_add]
  simp only [map_sub, map_add, map_mul, map_one] at h₁ h₂ h₃ ⊢
  linear_combination E*h₃ + X*F*h₂ + (C a * F + 2*X*D F)*h₁

theorem hypergeom_euler {a : ℚ} (ha : 0 < a) (b c : ℚ) :
    ES (a-b-c) * HS a b c = HS a (a-b) (a-c) := by
  apply ode_unique ha (euler_ode ha) (HS_equation ha _ _)
  simp [ES, HS, coeff_mul, Nat.antidiagonal_zero, ec, hc, rf]

lemma saalschuetz {a : ℚ} (ha : 0 < a) (b c : ℚ) (n : ℕ) :
    ∑ k ∈ range (n+1), hc a b c k * ec (a-b-c) (n-k) = hc a (a-b) (a-c) n := by
  have h : HS a b c * ES (a-b-c) = HS a (a-b) (a-c) := by
    rw [mul_comm]
    exact hypergeom_euler ha b c
  have h' := congrArg (coeff n) h
  rw [coeff_mul] at h'
  simp only [HS, ES, coeff_mk] at h'
  rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun k l => hc a b c k * ec (a-b-c) l)] at h'
  exact h'

lemma bailey_kernel {a b c : ℚ} (ha : 0 < a+1)
    (hb : 0 < a+1-b) (hc' : 0 < a+1-c) (k n : ℕ) :
    (∑ l ∈ range (n+1),
      rf b (k+l) * rf c (k+l) * rf (a+1-b-c) (n-l) /
        ((n-l).factorial * l.factorial * rf (a+1) (2*k+l))) =
      rf b k * rf c k * rf (a+1-b) (k+n) * rf (a+1-c) (k+n) /
        (rf (a+1-b) k * rf (a+1-c) k * n.factorial * rf (a+1) (2*k+n)) := by
  have hap : 0 < a+1+(2*k : ℕ) := by positivity
  have h := saalschuetz hap (b+k) (c+k) n
  have he : a+1+(2*k : ℕ)-(b+k)-(c+k) = a+1-b-c := by push_cast; ring
  rw [he] at h
  have hA : rf (a+1) (2*k) ≠ 0 := ne_of_gt (rf_pos ha _)
  have hB : rf (a+1-b) k ≠ 0 := ne_of_gt (rf_pos hb _)
  have hC : rf (a+1-c) k ≠ 0 := ne_of_gt (rf_pos hc' _)
  calc
    _ = (rf b k * rf c k / rf (a+1) (2*k)) *
        ∑ l ∈ range (n+1), hc (a+1+(2*k : ℕ)) (b+k) (c+k) l * ec (a+1-b-c) (n-l) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro l hl
      rw [rf_add b k l, rf_add c k l, rf_add (a+1) (2*k) l]
      unfold hc ec
      field_simp
    _ = _ := by
      rw [h]
      unfold hc
      rw [rf_add (a+1-b) k n, rf_add (a+1-c) k n, rf_add (a+1) (2*k) n]
      have h₁ : a+1+(2*k : ℕ)-(b+k) = (a+1-b)+k := by push_cast; ring
      have h₂ : a+1+(2*k : ℕ)-(c+k) = (a+1-c)+k := by push_cast; ring
      rw [h₁, h₂]
      field_simp

lemma sum_triangle (F : ℕ → ℕ → ℚ) (n : ℕ) :
    (∑ j ∈ range (n+1), ∑ k ∈ range (j+1), F j k) =
      ∑ k ∈ range (n+1), ∑ l ∈ range (n-k+1), F (k+l) k := by
  have h := sum_range_diag_flip (n+1) (fun k l => F (k+l) k)
  calc
    _ = ∑ j ∈ range (n+1), ∑ k ∈ range (j+1), F (k+(j-k)) k := by
      apply sum_congr rfl
      intro j hj
      apply sum_congr rfl
      intro k hk
      rw [Nat.add_sub_of_le (show k ≤ j by simpa using hk)]
    _ = _ := by
      rw [h]
      apply sum_congr rfl
      intro k hk
      have hk' : k ≤ n := by simpa using hk
      rw [show n+1-k = n-k+1 by omega]

def BT (a : ℚ) (f : ℕ → ℚ) (n : ℕ) : ℚ :=
  ∑ k ∈ range (n+1), f k / ((n-k).factorial * rf (a+1) (n+k))

theorem bailey_transform {a b c : ℚ} (ha : 0 < a+1)
    (hb : 0 < a+1-b) (hc' : 0 < a+1-c) (f : ℕ → ℚ) (n : ℕ) :
    BT a (fun k => rf b k * rf c k / (rf (a+1-b) k * rf (a+1-c) k) * f k) n =
      (∑ j ∈ range (n+1), rf b j * rf c j * ec (a+1-b-c) (n-j) * BT a f j) /
        (rf (a+1-b) n * rf (a+1-c) n) := by
  have hB : rf (a+1-b) n ≠ 0 := ne_of_gt (rf_pos hb _)
  have hC : rf (a+1-c) n ≠ 0 := ne_of_gt (rf_pos hc' _)
  symm
  calc
    _ = (∑ j ∈ range (n+1), ∑ k ∈ range (j+1),
        f k * (rf b j * rf c j * rf (a+1-b-c) (n-j) /
          ((n-j).factorial * (j-k).factorial * rf (a+1) (j+k)))) /
          (rf (a+1-b) n * rf (a+1-c) n) := by
      congr 1
      apply sum_congr rfl
      intro j hj
      unfold BT ec
      rw [mul_sum]
      apply sum_congr rfl
      intro k hk
      field_simp
    _ = (∑ k ∈ range (n+1), f k *
        (∑ l ∈ range (n-k+1), rf b (k+l) * rf c (k+l) * rf (a+1-b-c) (n-k-l) /
          ((n-k-l).factorial * l.factorial * rf (a+1) (2*k+l)))) /
          (rf (a+1-b) n * rf (a+1-c) n) := by
      rw [sum_triangle]
      congr 1
      apply sum_congr rfl
      intro k hk
      rw [mul_sum]
      apply sum_congr rfl
      intro l hl
      rw [Nat.sub_add_eq, Nat.add_sub_cancel_left]
      rw [show k+l+k = 2*k+l by omega]
    _ = _ := by
      unfold BT
      rw [sum_div]
      apply sum_congr rfl
      intro k hk
      have hkn : k ≤ n := by simpa using hk
      rw [bailey_kernel ha hb hc']
      rw [Nat.add_sub_of_le hkn, show 2*k+(n-k) = n+k by omega]
      field_simp

lemma rf_shift (x : ℚ) (n : ℕ) :
    x * rf (x+1) n = rf x n * (x+n) := by
  have h := rf_add x 1 n
  rw [show 1+n = n+1 by omega, rf_succ] at h
  simpa [rf] using h.symm

def unitTerm (a : ℚ) (N k : ℕ) : ℚ :=
  (-1)^k * (a+2*k) / (k.factorial * (N-k).factorial * rf (a+k) (N+1))
def unitG (a : ℚ) (N k : ℕ) : ℚ :=
  -(-1)^k * k / (N * k.factorial * (N-k).factorial * rf (a+k) N)

lemma unit_diff {a : ℚ} (ha : 0 < a) (N k : ℕ) (hk : k < N) :
    unitG a N (k+1) - unitG a N k = unitTerm a N k := by
  have hN : (N : ℚ) ≠ 0 := by exact_mod_cast (by omega : N ≠ 0)
  have hkf : (k.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
  have hnkf : ((N-(k+1)).factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero _
  have hr : rf (a+k) N ≠ 0 := ne_of_gt (rf_pos (by positivity) N)
  have hak : a+(k : ℚ) ≠ 0 := by positivity
  have hkn : a+(k : ℚ)+N ≠ 0 := by positivity
  have hk1 : (k : ℚ)+1 ≠ 0 := by positivity
  have hnk : (N : ℚ)-k ≠ 0 := by exact_mod_cast (show (N : ℤ)-(k : ℤ) ≠ 0 by omega)
  have he : rf (a+(k+1 : ℕ)) N = rf (a+k) N * (a+k+N) / (a+k) := by
    apply (eq_div_iff hak).2
    simpa [Nat.cast_add, Nat.cast_one, add_assoc, mul_comm] using rf_shift (a+k) N
  unfold unitG unitTerm
  rw [he, rf_succ, show N-k = N-(k+1)+1 by omega, Nat.factorial_succ, Nat.factorial_succ]
  rw [pow_succ]
  push_cast
  rw [show (↑(N-(k+1)) : ℚ) = N-k-1 by push_cast [Nat.cast_sub (by omega : k+1 ≤ N)]; ring]
  field_simp
  ring_nf
  field_simp [show -(k : ℚ)+N ≠ 0 by simpa [sub_eq_add_neg, add_comm] using hnk]
  <;> ring

lemma unit_last {a : ℚ} (ha : 0 < a) (N : ℕ) (hN : 0 < N) :
    unitTerm a N N = -unitG a N N := by
  unfold unitTerm unitG
  rw [rf_succ]
  simp only [Nat.sub_self, Nat.factorial_zero, Nat.cast_one, mul_one]
  have hn : (N : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hN)
  have hr : rf (a+N) N ≠ 0 := ne_of_gt (rf_pos (by positivity) N)
  have hA : a+(N : ℚ)+N ≠ 0 := by positivity
  field_simp
  <;> ring

lemma sum_unitTerm {a : ℚ} (ha : 0 < a) (N : ℕ) (hN : 0 < N) :
    ∑ k ∈ range (N+1), unitTerm a N k = 0 := by
  rw [sum_range_succ]
  have he : ∑ k ∈ range N, unitTerm a N k = unitG a N N - unitG a N 0 := by
    calc
      _ = ∑ k ∈ range N, (unitG a N (k+1) - unitG a N k) := by
        apply sum_congr rfl
        intro k hk
        exact (unit_diff ha N k (mem_range.mp hk)).symm
      _ = _ := sum_range_sub _ _
  rw [he, unit_last ha N hN]
  simp [unitG]

def unitAlpha (a : ℚ) (k : ℕ) : ℚ :=
  (-1)^k * (a+2*k) / a * rf a k / k.factorial

lemma unit_term {a : ℚ} (ha : 0 < a) (N k : ℕ) :
    unitAlpha a k / ((N-k).factorial * rf (a+1) (N+k)) = unitTerm a N k := by
  have h : rf a k * rf (a+k) (N+1) = a * rf (a+1) (N+k) := by
    rw [← rf_add, show k+(N+1) = 1+(N+k) by omega, rf_add]
    simp [rf]
  have hr₁ : rf a k ≠ 0 := ne_of_gt (rf_pos ha k)
  have hr₂ : rf (a+k) (N+1) ≠ 0 := ne_of_gt (rf_pos (by positivity) _)
  have hr₃ : rf (a+1) (N+k) ≠ 0 := ne_of_gt (rf_pos (by positivity) _)
  have han : a ≠ 0 := ne_of_gt ha
  have hkf : (k.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
  have hnkf : ((N-k).factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero _
  unfold unitAlpha unitTerm
  field_simp
  exact h

lemma bailey_unit {a : ℚ} (ha : 0 < a) (N : ℕ) :
    BT a (unitAlpha a) N = if N = 0 then 1 else 0 := by
  by_cases hN : N = 0
  · subst N
    simp [BT, unitAlpha, rf, ne_of_gt ha]
  · rw [if_neg hN]
    unfold BT
    simp_rw [unit_term ha]
    exact sum_unitTerm ha N (Nat.pos_of_ne_zero hN)

lemma bailey_first {a b c : ℚ} (ha : 0 < a)
    (hb : 0 < a+1-b) (hc' : 0 < a+1-c) (n : ℕ) :
    BT a (fun k => rf b k * rf c k / (rf (a+1-b) k * rf (a+1-c) k) * unitAlpha a k) n =
      ec (a+1-b-c) n / (rf (a+1-b) n * rf (a+1-c) n) := by
  rw [bailey_transform (by linarith) hb hc']
  congr 1
  rw [sum_eq_single 0]
  · simp [bailey_unit ha, rf]
  · intro k hk hk0
    simp [bailey_unit ha, hk0]
  · simp

lemma bailey_three {a b c d e f g : ℚ} (ha : 0 < a)
    (hb : 0 < a+1-b) (hc' : 0 < a+1-c)
    (hd : 0 < a+1-d) (he : 0 < a+1-e)
    (hf : 0 < a+1-f) (hg : 0 < a+1-g) (n : ℕ) :
    BT a (fun k =>
      rf f k * rf g k / (rf (a+1-f) k * rf (a+1-g) k) *
      (rf d k * rf e k / (rf (a+1-d) k * rf (a+1-e) k) *
      (rf b k * rf c k / (rf (a+1-b) k * rf (a+1-c) k) * unitAlpha a k))) n =
    (∑ j ∈ range (n+1), rf f j * rf g j * ec (a+1-f-g) (n-j) *
      ((∑ k ∈ range (j+1), rf d k * rf e k * ec (a+1-d-e) (j-k) *
        (ec (a+1-b-c) k / (rf (a+1-b) k * rf (a+1-c) k))) /
        (rf (a+1-d) j * rf (a+1-e) j))) /
      (rf (a+1-f) n * rf (a+1-g) n) := by
  rw [bailey_transform (by linarith) hf hg]
  simp_rw [bailey_transform (by linarith : 0 < a+1) hd he, bailey_first ha hb hc']

lemma rf_nat (n k : ℕ) :
    rf (n+1) k = ((n+k).factorial : ℚ) / n.factorial := by
  induction k with
  | zero => simp [rf, Nat.factorial_ne_zero]
  | succ k ih =>
    rw [rf_succ, ih, Nat.add_succ, Nat.factorial_succ]
    push_cast
    ring

lemma rf_one (k : ℕ) : rf 1 k = k.factorial := by
  simpa using rf_nat 0 k

lemma rf_half (n k : ℕ) :
    rf (n+1/2) k = ((2*(n+k)).factorial : ℚ) * n.factorial /
      (4^k * (n+k).factorial * (2*n).factorial) := by
  induction k with
  | zero =>
    simp only [rf, Nat.add_zero, pow_zero, one_mul]
    rw [mul_comm (↑(2*n).factorial : ℚ), div_self (by positivity)]
  | succ k ih =>
    rw [rf_succ, ih, show 2*(n+(k+1)) = 2*(n+k)+1+1 by omega,
      Nat.factorial_succ, Nat.factorial_succ, show n+(k+1) = (n+k)+1 by omega, Nat.factorial_succ, pow_succ]
    push_cast
    have hn : ((n+k).factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero _
    have h2n : ((2*n).factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero _
    have hp : (n : ℚ)+k+1 ≠ 0 := by positivity
    field_simp
    <;> ring

lemma rf_neg (n k : ℕ) (hk : k ≤ n) :
    rf (-(n : ℚ)) k = (-1)^k * n.factorial / (n-k).factorial := by
  induction k with
  | zero => simp [rf, Nat.factorial_ne_zero]
  | succ k ih =>
    rw [rf_succ, ih (by omega), show n-k = n-(k+1)+1 by omega, Nat.factorial_succ, pow_succ]
    push_cast
    have hnk : ((n-(k+1)).factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero _
    have hp : (↑(n-(k+1)) : ℚ)+1 ≠ 0 := by positivity
    rw [show (↑(n-(k+1)) : ℚ) = n-k-1 by push_cast [Nat.cast_sub (by omega : k+1 ≤ n)]; ring] at hp ⊢
    field_simp
    <;> ring

lemma rf_neg_zero (n k : ℕ) (hk : n < k) : rf (-(n : ℚ)) k = 0 := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le (show n+1 ≤ k by omega)
  rw [rf_add, rf_succ]
  simp

lemma ec_neg (n k : ℕ) :
    ec (-(n : ℚ)) k = (-1)^k * (n.choose k : ℚ) := by
  by_cases hk : k ≤ n
  · unfold ec
    rw [rf_neg n k hk, Nat.choose_eq_factorial_div_factorial hk]
    rw [Nat.cast_div (Nat.factorial_mul_factorial_dvd_factorial hk) (by positivity)]
    push_cast
    ring
  · simp [ec, rf_neg_zero n k (by omega), Nat.choose_eq_zero_of_lt (by omega : n < k)]

end SunProof

/- FactorialRatio -/
namespace SunProof
open Finset

def facProd (L : List ℕ) : ℕ := (L.map Nat.factorial).prod
lemma facProd_ne_zero (L : List ℕ) : facProd L ≠ 0 := by
  apply List.prod_ne_zero
  simp [Nat.factorial_ne_zero]

lemma facProd_val (L : List ℕ) {p : ℕ} (hp : Nat.Prime p) (b : ℕ)
    (hb : ∀ n ∈ L, n < b) :
    (facProd L).factorization p = ∑ k ∈ Ico 1 b, (L.map (fun n => n / p^k)).sum := by
  induction L with
  | nil => simp [facProd]
  | cons n L ih =>
    have hn : Nat.log p n < b := lt_of_le_of_lt (Nat.log_le_self _ _) (hb n (by simp))
    have hL : ∀ n ∈ L, n < b := fun n hn => hb n (by simp [hn])
    change (n.factorial * facProd L).factorization p = _
    rw [Nat.factorization_mul (Nat.factorial_ne_zero _) (facProd_ne_zero _)]
    simp only [Finsupp.add_apply, Nat.factorization_factorial hp hn, ih hL,
      List.map_cons, List.sum_cons, sum_add_distrib]

lemma facProd_dvd (P Q : List ℕ)
    (h : ∀ q : ℕ, 2 ≤ q → (Q.map (fun n => n/q)).sum ≤ (P.map (fun n => n/q)).sum) :
    facProd Q ∣ facProd P := by
  apply (Nat.factorization_prime_le_iff_dvd (facProd_ne_zero Q) (facProd_ne_zero P)).mp
  intro p hp
  let b := P.sum + Q.sum + 1
  have hP : ∀ n ∈ P, n < b := by
    intro n hn
    have := List.le_sum_of_mem hn
    dsimp [b]
    omega
  have hQ : ∀ n ∈ Q, n < b := by
    intro n hn
    have := List.le_sum_of_mem hn
    dsimp [b]
    omega
  rw [facProd_val Q hp b hQ, facProd_val P hp b hP]
  apply sum_le_sum
  intro k hk
  exact h (p^k) (le_trans hp.two_le (Nat.le_pow (by simpa using (mem_Ico.mp hk).1)))

lemma facProd_integer (P Q : List ℕ)
    (h : ∀ q : ℕ, 2 ≤ q → (Q.map (fun n => n/q)).sum ≤ (P.map (fun n => n/q)).sum) :
    ∃ z : ℤ, (facProd P : ℚ) / facProd Q = z := by
  obtain ⟨k, hk⟩ := facProd_dvd P Q h
  refine ⟨k, ?_⟩
  rw [hk]
  push_cast
  field_simp [facProd_ne_zero Q]
end SunProof

