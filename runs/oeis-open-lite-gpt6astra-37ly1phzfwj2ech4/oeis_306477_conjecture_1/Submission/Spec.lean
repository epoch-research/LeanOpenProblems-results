def pockProof (pn an qn : Nat) : MetaM Expr := do
  let pe : Q(ℕ) ← pure (mkNatLit pn)
  let ae : Q(ℕ) ← pure (mkNatLit an)
  let qe : Q(ℕ) ← pure (mkNatLit qn)
  let (_, ha) := buildRawTrace an (pn-1) pn
  let (rn, hr) := buildRawTrace an ((pn-1)/qn) pn
  let re := mkNatLit rn
  let hc ← mkEqRefl (mkConst ``Bool.true)
  return mkAppN (mkConst ``prime_of_pockCheck) #[pe,ae,qe,re,mkConst (primeName qn),ha,hr,hc]

elab "certified_primes " data:str : command => do
  withEnableInfoTree false do
    let .ok d := readData data.getString | throwError "Invalid prime records"
    liftTermElabM do
      let mut i := 0
      while i < d.size do
        let pn := d[i]!
        let an := d[i+1]!
        let len := d[i+2]!
        let fs := (d.toList.drop (i+3)).take len
        let pr ← if len == 1 && pn < fs.head!*fs.head! then pockProof pn an fs.head!
          else prattProof pn an fs
        addDecl (.thmDecl {
          name := primeName pn
          levelParams := []
          type := mkApp (mkConst ``Nat.Prime) (mkNatLit pn)
          value := Lean.ShareCommon.shareCommon pr })
        i := i+3+len

end BinomialCertificate
