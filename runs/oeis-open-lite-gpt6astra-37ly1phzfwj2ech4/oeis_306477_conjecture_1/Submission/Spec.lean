open Lean Meta Elab Command Qq

elab "certified_counterexample " start:num count:num pd:str td:str : command => do
  withEnableInfoTree false do
    let .ok primesData := decodeNumbers pd.getString | throwError "Invalid prime data"
    let .ok trees := decodeNumbers td.getString | throwError "Invalid tree data"
    let mut primes : Array PrimeInfo := #[⟨2,0,0⟩]
    let mut pos := 0
    while pos < primesData.size do
      let pn := primes.back!.p+primesData[pos]!
      let an := primesData[pos+1]!
      let len := primesData[pos+2]!
      let fs := ((primesData.toSubarray (pos+3) (pos+3+len)).toArray.toList).map (fun i => primes[i]!.p)
      liftTermElabM do
        let pr ← if len == 1 && pn < fs.head!*fs.head! then pockProof pn an fs.head!
          else prattProof pn an fs
        addDecl (.thmDecl {
          name := primeName pn
          levelParams := []
          type := mkApp (mkConst ``Nat.Prime) (mkNatLit pn)
          value := Lean.ShareCommon.shareCommon pr })
      let (c,d) := normCoordinates pn an
      primes := primes.push ⟨pn,c,d⟩
      pos := pos+3+len
    logInfo m!"Primality certificates checked: {primes.size}"
    let n := 896315812331399
    let Z := 275
    let mut cache : CoverCache := {}
    let mut offset := 0
    for yn in [start.getNat:start.getNat+count.getNat] do
      let (next,newCache) ← liftTermElabM do
        let ((pf,next),newCache) ← (makeRowProof primes n yn Z trees offset).run cache
        addDecl (.thmDecl {
          name := Name.str `BinomialCertificate s!"cr_{yn}"
          levelParams := []
          type := mkApp3 (mkConst ``RowValid) (mkNatLit n) (mkNatLit yn) (mkNatLit Z)
          value := Lean.ShareCommon.shareCommon pf })
        return (next,newCache)
      offset := next
      cache := newCache
      if (yn+1)%100 == 0 then logInfo m!"Norm rows checked through {yn}"
    if offset != trees.size then throwError "Excess tree data"

end BinomialCertificate

