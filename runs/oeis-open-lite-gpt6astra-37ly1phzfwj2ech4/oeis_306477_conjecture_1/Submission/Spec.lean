noncomputable def pockCheck (p q r : Nat) : Bool :=
  Bool.and' (Nat.ble 2 p)
    (Bool.and' (Nat.beq (Nat.mod (Nat.sub p 1) q) 0)
      (Bool.and' (Nat.blt p (Nat.mul q q))
        (Nat.beq (Nat.gcd (Nat.sub (Nat.add r p) 1) p) 1)))

theorem prime_of_pockCheck (p a q r : Nat) (hq : q.Prime)
    (ha : PowerMod a (p-1) p 1) (hr : PowerMod a ((p-1)/q) p r)
    (hc : pockCheck p q r = true) : p.Prime := by
  simp only [pockCheck, Bool.and'_eq_and, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, Nat.blt_eq] at hc
  apply prime_of_pocklington p a q r hc.1 hq (Nat.dvd_of_mod_eq_zero hc.2.1) hc.2.2.1 ha hr
  exact hc.2.2.2

theorem NontrivialPowers.consFast (a p q : Nat) (qs : List Nat) (r : Nat)
    (hr : PowerMod a ((p-1)/q) p r) (hn : Nat.beq r 1 = false)
    (ht : NontrivialPowers a p qs) : NontrivialPowers a p (q::qs) := by
  apply NontrivialPowers.cons a p q qs r hr ?_ ht
  intro h
  subst r
  contradiction

theorem prime_of_pratt_fast (p a : Nat) (qs : List Nat) (hp : Nat.ble 2 p = true)
    (hf : qs.prod = p-1) (hprime : AllPrime qs)
    (ha : PowerMod a (p-1) p 1) (hpow : NontrivialPowers a p qs) : p.Prime :=
  prime_of_pratt_cert p a qs (Nat.le_of_ble_eq_true hp) hf hprime ha hpow
end BinomialCertificate
