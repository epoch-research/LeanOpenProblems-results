open Lean Meta Elab Command Qq

def integerExpr : Int → Expr
  | .ofNat n => mkApp (mkConst ``Int.ofNat) (mkNatLit n)
  | .negSucc n => mkApp (mkConst ``Int.negSucc) (mkNatLit n)

def pairType : Expr := mkApp2 (mkConst ``Prod [0,0]) (mkConst ``Int) (mkConst ``Int)
def pairExpr (v : Int × Int) : Expr :=
  mkApp4 (mkConst ``Prod.mk [0,0]) (mkConst ``Int) (mkConst ``Int) (integerExpr v.1) (integerExpr v.2)
def listExpr (ty : Expr) (xs : List Expr) : Expr :=
  xs.foldr (fun x xs => mkApp3 (mkConst ``List.cons [0]) ty x xs) (mkApp (mkConst ``List.nil [0]) ty)
def pairsExpr (xs : List (Int × Int)) : Expr := listExpr pairType (xs.map pairExpr)
def natsExpr (xs : List Nat) : Expr := listExpr (mkConst ``Nat) (xs.map mkNatLit)
def primeName (p : Nat) : Name := Name.str `BinomialCertificate s!"pp_{p}"

def prattProof (pn an : Nat) (factors : List Nat) : MetaM Expr := do
  let pe : Q(ℕ) ← pure (mkNatLit pn)
  let ae : Q(ℕ) ← pure (mkNatLit an)
  let mut fs : List Expr := []
  let mut hprime := mkConst ``True.intro
  let mut hpows := mkConst ``True.intro
  for qn in factors.reverse do
    let qe := mkNatLit qn
    let rest := listExpr (mkConst ``Nat) fs
    let pq := mkConst (primeName qn)
    hprime := mkApp4 (mkConst ``AllPrime.cons) qe rest pq hprime
    let (rn, hr) := buildRawTrace an ((pn-1)/qn) pn
    let re : Q(ℕ) ← pure (mkNatLit rn)
    let hn ← mkEqRefl (mkConst ``Bool.false)
    hpows := mkAppN (mkConst ``NontrivialPowers.consFast) #[ae, pe, qe, rest, re, hr, hn, hpows]
    fs := qe :: fs
  let fl : Q(List ℕ) ← pure (listExpr (mkConst ``Nat) fs)
  let hp ← mkEqRefl (mkConst ``Bool.true)
  let hf ← mkEqRefl (mkNatLit (pn-1))
  let (_, ha) := buildRawTrace an (pn-1) pn
  return mkAppN (mkConst ``prime_of_pratt_fast) #[pe, ae, fl, hp, hf, hprime, ha, hpows]

-- This uses the ordinary kernel-checking declaration API, not an unchecked environment update.
elab "certified_prime " p:num a:num " [" qs:num,* "]" : command => do
  liftTermElabM do
    let pn := p.getNat
    let pr ← prattProof pn a.getNat (qs.getElems.toList.map (·.getNat))
    addDecl (.thmDecl {
      name := primeName pn
      levelParams := []
      type := mkApp (mkConst ``Nat.Prime) (mkNatLit pn),
      value := Lean.ShareCommon.shareCommon pr })

structure CoverResult where
  value : Int
  points : List (Int × Int)
  pointsExpr : Expr
  proof : Expr
  next : Nat

def readData (s : String) : Except String (Array Nat) := do
  let mut out := #[]
  for w in s.splitOn " " do
    if w != "" then
      let some n := w.toNat? | throw "Invalid certificate numeral"
      out := out.push n
  return out

def signedData (n : Nat) : Int := if n % 2 == 0 then (n/2 : Nat) else -((n/2+1 : Nat) : Int)

abbrev CoverCache := Std.HashMap Int CoverResult
abbrev CoverM := StateT CoverCache MetaM

def addCoverData (m : Int) (vs : List (Int × Int)) : CoverM Expr := do
  let name := Name.str `BinomialCertificate s!"pts_{m}"
  addDecl (.defnDecl {
    name := name
    levelParams := []
    type := mkApp (mkConst ``List [0]) pairType
    value := Lean.ShareCommon.shareCommon (pairsExpr vs)
    hints := .abbrev
    safety := .safe })
  return mkConst name

def saveCover (m : Int) (vs : List (Int × Int)) (ve pf : Expr) (next : Nat) : CoverM CoverResult := do
  let name := Name.str `BinomialCertificate s!"cv_{m}"
  addDecl (.thmDecl {
    name := name
    levelParams := []
    type := mkApp2 (mkConst ``OrbitCover) (integerExpr m) ve
    value := Lean.ShareCommon.shareCommon pf })
  let r : CoverResult := ⟨m, vs, ve, mkConst name, next⟩
  modify (·.insert m r)
  return r

partial def buildCover (primes : Array PrimeInfo) (M : Nat) (data : Array Nat) (i : Nat) : CoverM CoverResult := do
  if i ≥ data.size then throwError "Truncated cover"
  let code := data[i]!
  let tag := code%4
  let pi := primes[code/4-1]!
  if tag == 0 then
    let vs := [(1,0)]
    return ⟨1, vs, pairsExpr vs, mkConst ``OrbitCover.unit, i+1⟩
  else if tag == 1 then
    let p := pi.p
    let m := M/p
    let pe : Q(ℕ) ← pure (mkNatLit p)
    let me : Q(ℕ) ← pure (mkNatLit m)
    let hp := mkConst (primeName p)
    let hmod ← mkDecideProof q($pe % 3 = 2)
    let hm ← mkDecideProof q($me % $pe ≠ 0)
    return ⟨(p : Int)*m, [], pairsExpr [],
      mkAppN (mkConst ``OrbitCover.rejectNat) #[pe,hp,hmod,me,hm], i+1⟩
  else if tag == 2 then
    let p := pi.p
    let r ← buildCover primes (M/(p*p)) data (i+1)
    let m := (p : Int)^2*r.value
    if let some saved := (← get).get? m then
      return { saved with next := r.next }
    let vs := r.points.map (fun (a,b) => ((p : Int)*a, (p : Int)*b))
    let pe : Q(ℕ) ← pure (mkNatLit p)
    let me := integerExpr r.value
    let xe : Q(List (ℤ × ℤ)) ← pure r.pointsExpr
    let ye : Q(List (ℤ × ℤ)) ← addCoverData m vs
    let hp := mkConst (primeName p)
    let hmod ← mkDecideProof q($pe % 3 = 2)
    let hc ← mkEqRefl (mkConst ``Bool.true)
    saveCover m vs ye (mkAppN (mkConst ``OrbitCover.scale) #[pe,hp,hmod,me,xe,ye,r.proof,hc]) r.next
  else if tag == 3 then
    let p := pi.p
    let c := pi.c
    let d := pi.d
    let r ← buildCover primes (M/p) data (i+1)
    let m := (p : Int)*r.value
    if let some saved := (← get).get? m then
      return { saved with next := r.next }
    let vs := r.points.flatMap (fun (e,f) =>
      [(e*c-f*d,e*d+f*c-f*d),(e*(c-d)+f*d,-e*d+f*c)])
    let pe : Q(ℕ) ← pure (mkNatLit p)
    let ce : Q(ℕ) ← pure (mkNatLit c.toNat)
    let de : Q(ℕ) ← pure (mkNatLit d.toNat)
    let xe : Q(List (ℤ × ℤ)) ← pure r.pointsExpr
    let ye : Q(List (ℤ × ℤ)) ← addCoverData m vs
    let me := integerExpr r.value
    let hp := mkConst (primeName p)
    let hcd ← mkEqRefl (mkNatLit (p+c.toNat*d.toNat))
    let hd ← mkDecideProof q($de % $pe ≠ 0)
    let hc ← mkEqRefl (mkConst ``Bool.true)
    saveCover m vs ye (mkAppN (mkConst ``OrbitCover.splitFast) #[pe,hp,ce,de,hcd,hd,me,xe,ye,r.proof,hc]) r.next
  else throwError "Invalid cover tag"

def makeRowProof (primes : Array PrimeInfo) (n y Z : Nat) (data : Array Nat) (start : Nat) : CoverM (Expr × Nat) := do
  let ne : Q(ℕ) ← pure (mkNatLit n)
  let ye : Q(ℕ) ← pure (mkNatLit y)
  let cy := Nat.fast_choose (y+5) 6
  let cye : Q(ℕ) ← pure (mkNatLit cy)
  let hcy ← mkEqRefl cye
  let mut cells : Array Expr := #[]
  let mut pos := start
  for z in List.range Z do
    let ze : Q(ℕ) ← pure (mkNatLit z)
    let cz := Nat.fast_choose (z+7) 8
    let M := 6*(n-cy-cz)+1
    if n ≤ cy+cz then
      if data[pos]! != 0 then throwError "Invalid skipped cell"
      pos := pos+1
      cells := cells.push (mkConst ``RowCell.skip)
    else if data[pos]!%4 == 1 then
      let p := primes[data[pos]!/4-1]!.p
      let m := M/p
      pos := pos+1
      cells := cells.push (mkApp3 (mkConst ``RowCell.reject) (mkNatLit p) (mkConst (primeName p)) (mkNatLit m))
    else
      let r ← buildCover primes M data pos
      pos := r.next
      let k := n-cy-cz
      let ke : Q(ℕ) ← pure (mkNatLit k)
      let me : Q(ℤ) ← pure (integerExpr r.value)
      let xe : Q(List (ℤ × ℤ)) ← pure r.pointsExpr
      let mut cleans : List Expr := []
      for v in r.points do
        let some (A,B) := (orbit v).find? (fun (a,b) => b ≥ 0 && a ≥ b)
          | throwError "No positive unit image"
        let a := A.toNat
        let b := B.toNat
        let u := (orbit (A,B)).idxOf v
        let r := (4*(2*a-b)+5).sqrt
        let s := (4*(a-2*b)+5).sqrt
        cleans := mkAppN (mkConst ``CleanSeed.mk) (#[a,b,u,r,s].map mkNatLit) :: cleans
      let re : Q(List CleanSeed) ← pure (listExpr (mkConst ``CleanSeed) cleans.reverse)
      let hm ← mkEqRefl me
      let hd ← mkEqRefl (mkConst ``Bool.true)
      let bi := mkAppN (mkConst ``BinaryImpossible.of_fastCover) #[ke,me,xe,re,r.proof,hm,hd]
      cells := cells.push (mkApp2 (mkConst ``RowCell.exclude) ke bi)
  let cse : Q(List RowCell) ← pure (listExpr (mkConst ``RowCell) cells.toList)
  let Ze : Q(ℕ) ← pure (mkNatLit Z)
  let hl ← mkEqRefl Ze
  let hc ← mkEqRefl (mkConst ``Bool.true)
  return (mkAppN (mkConst ``RowValid.checkedFast) #[ne,ye,cye,Ze,cse,hcy,hl,hc],pos)


end BinomialCertificate
