-- Combine the individually checked rows without any further arithmetic search.
elab "assemble_all_rows" : command => do
  withEnableInfoTree false do
    liftTermElabM do
      let ne := mkNatLit 896315812331399
      let ze := mkNatLit 275
      let mut pf := mkApp3 (mkConst ``RowSegment.nil) ne ze (mkNatLit 928)
      for y in (List.range 928).reverse do
        pf := mkAppN (mkConst ``RowSegment.cons)
          #[ne,ze,mkNatLit y,mkNatLit (927-y),
            mkConst (Name.str `BinomialCertificate s!"cr_{y}"),pf]
      addDecl (.thmDecl {
        name := `BinomialCertificate.allRows
        levelParams := []
        type := mkAppN (mkConst ``RowSegment) #[ne,ze,mkNatLit 0,mkNatLit 928]
        value := Lean.ShareCommon.shareCommon pf })

assemble_all_rows

theorem counterexample_zero : A306477 896315812331399 = 0 := by
  apply zero_of_rowSegment 896315812331399 928 275 allRows
  · rw [Nat.choose_eq_fast_choose]
    decide +kernel
  · rw [Nat.choose_eq_fast_choose]
    decide +kernel

