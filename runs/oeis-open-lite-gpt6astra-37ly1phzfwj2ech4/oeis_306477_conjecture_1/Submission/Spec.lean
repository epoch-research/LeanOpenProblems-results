noncomputable def powerTrace (a m : ℕ) : ℕ → ℕ → List ℕ → Bool
  | n, r, [] => Bool.and' (Nat.beq n 0) (Nat.beq r (1%m))
  | n, r, c::cs => Bool.and'
      (Nat.beq r ((cond (Nat.beq (n%2) 0) (c*c) (c*c*a)) % m))
      (powerTrace a m (n/2) c cs)

theorem powerTrace_sound (a m n r : ℕ) (cs : List ℕ)
    (h : powerTrace a m n r cs = true) : PowerMod a n m r := by
  induction cs generalizing n r with
  | nil =>
    simp only [powerTrace, Bool.and'_eq_and, Bool.and_eq_true, Nat.beq_eq] at h
    rw [h.1,h.2]; exact PowerMod.zero a m
  | cons c cs ih =>
    simp only [powerTrace, Bool.and'_eq_and, Bool.and_eq_true, Nat.beq_eq] at h
    have hc := ih (n/2) c h.2
    by_cases hn : n%2 = 0
    · have hnn : Nat.beq (n%2) 0 = true := by simpa only [Nat.beq_eq] using hn
      rw [hnn] at h
      simp only [cond_true] at h
      have he : 2*(n/2) = n := by omega
      rw [h.1, ← he]
      exact hc.bit0 a (n/2) m c
    · have hnn : Nat.beq (n%2) 0 = false := by cases hh : Nat.beq (n%2) 0 <;> simp_all only [Nat.beq_eq]
      rw [hnn] at h
      simp only [cond_false] at h
      have he : 2*(n/2)+1 = n := by omega
      rw [h.1, ← he]
      exact hc.bit1 a (n/2) m c

end BinomialCertificate
