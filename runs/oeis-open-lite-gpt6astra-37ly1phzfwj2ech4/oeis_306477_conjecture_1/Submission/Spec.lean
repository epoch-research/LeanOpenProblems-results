structure PrimeInfo where
  p : Nat
  c : Int
  d : Int
  deriving Inhabited

def normCoordinates (p a : Nat) : Int × Int := Id.run do
  if p % 3 != 1 then return (0,0)
  let w := modPow a ((p-1)/3) p
  let mut u := p
  let mut v := (2*w+1)%p
  while v*v > p do
    let r := u%v
    u := v
    v := r
  let b := ((p-v*v)/3).sqrt
  let c := v+b
  let d := 2*b
  return if c ≥ d then (c,d) else (d,c)

def decodeNumbers (s : String) : Except String (Array Nat) := do
  let mut out := #[]
  let mut value := 0
  let mut place := 1
  for c in s.toList do
    let n := c.toNat
    let digit ← if 65 ≤ n && n ≤ 90 then pure (n-65)
      else if 97 ≤ n && n ≤ 122 then pure (n-97+26)
      else if 48 ≤ n && n ≤ 57 then pure (n-48+52)
      else if n == 43 then pure 62
      else if n == 47 then pure 63
      else throw "Invalid certificate character"
    value := value+(digit%32)*place
    if digit < 32 then
      out := out.push value
      value := 0
      place := 1
    else
      place := place*32
  if place != 1 then throw "Incomplete certificate numeral"
  return out

end BinomialCertificate
