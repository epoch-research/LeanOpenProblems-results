def orbit (v : ℤ × ℤ) : List (ℤ × ℤ) :=
  [(v.1,v.2), (-v.1,-v.2), (-v.2,v.1-v.2), (v.2,v.2-v.1),
   (v.1-v.2,v.1), (v.2-v.1,-v.1)]

def mulPair (v t : ℤ × ℤ) : ℤ × ℤ :=
  (v.1*t.1-v.2*t.2, v.1*t.2+v.2*t.1-v.2*t.2)

theorem orbit_trans (u v s : ℤ × ℤ) (hu : u ∈ orbit v) (hv : v ∈ orbit s) :
    u ∈ orbit s := by
  rcases s with ⟨a,b⟩
  simp only [orbit, List.mem_cons, List.not_mem_nil, or_false] at hv
  rcases hv with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [orbit, List.mem_cons, List.not_mem_nil, or_false, Prod.fst, Prod.snd] at hu ⊢ <;>
    ring_nf at hu ⊢ <;> tauto

theorem orbit_mul (s t : ℤ × ℤ) :
    (orbit s).map (fun v => mulPair v t) = orbit (mulPair s t) := by
  rcases s with ⟨a,b⟩; rcases t with ⟨c,d⟩
  simp only [orbit, List.map_cons, List.map_nil, mulPair, Prod.fst, Prod.snd]
  congr 1 <;> congr 1 <;> ring_nf

theorem orbit_scale (s : ℤ × ℤ) (p : ℤ) :
    (orbit s).map (fun v => (p*v.1,p*v.2)) = orbit (p*s.1,p*s.2) := by
  rcases s with ⟨a,b⟩
  simp only [orbit, List.map_cons, List.map_nil, Prod.fst, Prod.snd]
  congr 1 <;> congr 1 <;> ring_nf

structure OrbitCover (m : ℤ) (vs : List (ℤ × ℤ)) : Prop where
  complete : ∀ a b : ℤ, norm a b = m → ∃ s ∈ vs, (a,b) ∈ orbit s

theorem OrbitCover.unit : OrbitCover 1 [(1,0)] := by
  constructor
  intro a b h
  refine ⟨(1,0), by simp, ?_⟩
  have hh := norm_eq_one a b h
  simp only [orbit, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
  norm_num at ⊢
  tauto

theorem OrbitCover.split (p : ℕ) (hp : p.Prime) (c d : ℤ)
    (hcd : norm c d = p) (hd : ¬ (p : ℤ) ∣ d)
    (m : ℤ) (xs ys : List (ℤ × ℤ)) (child : OrbitCover m xs)
    (hc : splitCheck c d xs ys = true) : OrbitCover ((p : ℤ) * m) ys := by
  constructor
  intro a b h
  obtain ⟨e,f,he, ha | ha⟩ := split_norm_prime hp c d hcd hd a b m h
  · obtain ⟨s,hs,hs'⟩ := child.complete e f he
    refine ⟨mulPair s (c,d), ?_, ?_⟩
    · rw [splitCheck_eq c d xs ys hc]
      exact List.mem_flatMap.mpr ⟨s,hs, by simp [splitImages, mulPair]⟩
    · rw [← orbit_mul]
      exact List.mem_map.mpr ⟨(e,f),hs', Prod.ext ha.1.symm ha.2.symm⟩
  · obtain ⟨s,hs,hs'⟩ := child.complete e f he
    refine ⟨mulPair s (c-d,-d), ?_, ?_⟩
    · rw [splitCheck_eq c d xs ys hc]
      apply List.mem_flatMap.mpr
      refine ⟨s, hs, ?_⟩
      simp [splitImages, mulPair]
      right; ring
    · rw [← orbit_mul]
      apply List.mem_map.mpr
      refine ⟨(e,f),hs', ?_⟩
      apply Prod.ext <;> simp only [mulPair, Prod.fst, Prod.snd]
      · rw [ha.1]; ring
      · rw [ha.2]; ring

theorem OrbitCover.scale (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2)
    (m : ℤ) (xs ys : List (ℤ × ℤ)) (child : OrbitCover m xs)
    (hc : scaleCheck p xs ys = true) : OrbitCover ((p : ℤ)^2 * m) ys := by
  constructor
  intro a b h
  obtain ⟨e,f,he,ha,hb⟩ := inert_divide hp hmod a b m h
  obtain ⟨s,hs,hs'⟩ := child.complete e f he
  refine ⟨((p : ℤ)*s.1, (p : ℤ)*s.2), ?_, ?_⟩
  · rw [scaleCheck_eq p xs ys hc]
    exact List.mem_map.mpr ⟨s,hs,rfl⟩
  · rw [← orbit_scale]
    exact List.mem_map.mpr ⟨(e,f),hs',Prod.ext ha.symm hb.symm⟩

theorem OrbitCover.reject (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2)
    (m : ℤ) (hm : ¬ (p : ℤ) ∣ m) : OrbitCover ((p : ℤ)*m) [] := by
  constructor
  intro a b h
  exact (inert_reject hp hmod m hm a b h).elim

end BinomialCertificate
namespace BinomialCertificate

structure CleanSeed where
  a : ℕ
  b : ℕ
  u : ℕ
  r : ℕ
  s : ℕ

def seedCheck (a b r s : ℕ) : Bool :=
  decide (b ≤ a) &&
  (if 3 ≤ b ∧ b % 2 = 1 then decide (r*r < 4*(2*a-b)+5 ∧ 4*(2*a-b)+5 < (r+1)*(r+1)) else true) &&
  (if 3 ≤ a ∧ a % 2 = 1 ∧ 2*b < a then decide (s*s < 4*(a-2*b)+5 ∧ 4*(a-2*b)+5 < (s+1)*(s+1)) else true)

theorem square_not_between (t r D : ℕ) (h : r*r < D ∧ D < (r+1)*(r+1)) : t*t ≠ D := by
  intro he
  have h₁ : r < t := by nlinarith
  have h₂ : t < r+1 := by nlinarith
  omega

theorem seedCheck_excludes (a b r s w x : ℕ) (h : seedCheck a b r s = true) :
    representationPair w x ∉ orbit ((a : ℤ),(b : ℤ)) := by
  intro ho
  have hel := representationPair_eligible w x
  simp only [pairEligible, Bool.and_eq_true, decide_eq_true_eq] at hel
  have hD := representationPair_discriminant w x
  simp only [seedCheck, Bool.and_eq_true] at h
  have hab : b ≤ a := of_decide_eq_true h.1.1
  have hb := h.1.2
  have ha := h.2
  simp only [orbit, List.mem_cons, List.not_mem_nil, or_false] at ho
  rcases ho with ho | ho | ho | ho | ho | ho
  · rw [ho] at hel hD
    simp only [Prod.fst, Prod.snd] at hel hD
    have hb3 : 3 ≤ b ∧ b % 2 = 1 := by exact_mod_cast hel.1
    simp only [if_pos hb3, decide_eq_true_eq] at hb
    apply square_not_between (2*x+3) r (4*(2*a-b)+5) hb
    have hsub : b ≤ 2*a := by omega
    have he : ((4*(2*a-b)+5 : ℕ) : ℤ) = 8*(a : ℤ)-4*(b : ℤ)+5 := by
      rw [Nat.cast_add, Nat.cast_mul, Nat.cast_sub hsub]
      push_cast; ring
    have hh : (((2*x+3)*(2*x+3) : ℕ) : ℤ) = ((4*(2*a-b)+5 : ℕ) : ℤ) := by
      rw [he, hD, Nat.cast_mul, pow_two]
    exact_mod_cast hh
  · rw [ho] at hel; simp only [Prod.snd] at hel; omega
  · rw [ho] at hel; simp only [Prod.fst, Prod.snd] at hel
    have ha0 : (0 : ℤ) ≤ a := by positivity
    have hb0 : (0 : ℤ) ≤ b := by positivity
    omega
  · rw [ho] at hel; simp only [Prod.snd] at hel; omega
  · rw [ho] at hel hD
    simp only [Prod.fst, Prod.snd] at hel hD
    have ha3 : 3 ≤ a ∧ a % 2 = 1 := by exact_mod_cast hel.1
    have hba : 2*b < a := by omega
    have hcond : 3 ≤ a ∧ a % 2 = 1 ∧ 2*b < a := ⟨ha3.1,ha3.2,hba⟩
    simp only [if_pos hcond, decide_eq_true_eq] at ha
    apply square_not_between (2*x+3) s (4*(a-2*b)+5) ha
    have he : ((4*(a-2*b)+5 : ℕ) : ℤ) = 8*((a : ℤ)-(b : ℤ))-4*(a : ℤ)+5 := by
      rw [Nat.cast_add, Nat.cast_mul, Nat.cast_sub (Nat.le_of_lt hba)]
      push_cast; ring
    have hh : (((2*x+3)*(2*x+3) : ℕ) : ℤ) = ((4*(a-2*b)+5 : ℕ) : ℤ) := by
      rw [he,hD,Nat.cast_mul,pow_two]
    exact_mod_cast hh
  · rw [ho] at hel; simp only [Prod.snd] at hel; omega

def cleanCheck (v : ℤ × ℤ) (c : CleanSeed) : Bool :=
  decide (c.u < 6) && decide (v = (orbit ((c.a : ℤ),(c.b : ℤ))).getD c.u (0,0)) &&
  seedCheck c.a c.b c.r c.s

def cleanListCheck : List (ℤ × ℤ) → List CleanSeed → Bool
  | [], [] => true
  | v::vs, c::cs => cleanCheck v c && cleanListCheck vs cs
  | _, _ => false

theorem cleanCheck_excludes (v : ℤ × ℤ) (c : CleanSeed) (w x : ℕ)
    (h : cleanCheck v c = true) : representationPair w x ∉ orbit v := by
  simp only [cleanCheck, Bool.and_eq_true, decide_eq_true_eq] at h
  have hv : v ∈ orbit ((c.a : ℤ),(c.b : ℤ)) := by
    rw [h.1.2]
    have hh := h.1.1
    rcases c with ⟨a,b,u,r,s⟩
    simp only at hh ⊢
    interval_cases u <;> simp [orbit, List.getD]
  exact fun ho => seedCheck_excludes c.a c.b c.r c.s w x h.2
    (orbit_trans _ _ _ ho hv)

theorem cleanListCheck_excludes (vs : List (ℤ × ℤ)) (cs : List CleanSeed)
    (h : cleanListCheck vs cs = true) (v : ℤ × ℤ) (hv : v ∈ vs) (w x : ℕ) :
    representationPair w x ∉ orbit v := by
  induction vs generalizing cs with
  | nil => simp at hv
  | cons t ts ih =>
    cases cs with
    | nil => simp [cleanListCheck] at h
    | cons c cs =>
      simp only [cleanListCheck, Bool.and_eq_true] at h
      rcases List.mem_cons.mp hv with rfl | hv
      · exact cleanCheck_excludes v c w x h.1
      · exact ih cs h.2 hv

theorem BinaryImpossible.of_orbitCover (k : ℕ) (m : ℤ) (xs : List (ℤ × ℤ))
    (cs : List CleanSeed) (hc : OrbitCover m xs) (hm : m = 6*(k : ℤ)+1)
    (hr : cleanListCheck xs cs = true) : BinaryImpossible k := by
  constructor
  intro w x heq
  have hn := representationPair_norm w x
  have hk : ((w+2).choose 2 : ℤ) + ((x+3).choose 4 : ℤ) = k := by exact_mod_cast heq
  rw [hk, ← hm] at hn
  obtain ⟨s,hs,hs'⟩ := hc.complete _ _ hn
  exact cleanListCheck_excludes xs cs hr s hs w x hs'

end BinomialCertificate
namespace BinomialCertificate

theorem OrbitCover.rejectNat (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2)
    (m : ℕ) (hm : m % p ≠ 0) : OrbitCover ((p*m : ℕ) : ℤ) [] := by
  rw [Nat.cast_mul]
  apply OrbitCover.reject p hp hmod
  intro h
  apply hm
  exact Nat.mod_eq_zero_of_dvd (by exact_mod_cast h)

theorem nat_norm (p c d : ℕ) (h : c*c+d*d = p+c*d) : norm (c : ℤ) (d : ℤ) = p := by
  have hh : (c : ℤ)*(c : ℤ)+(d : ℤ)*(d : ℤ) = (p : ℤ)+(c : ℤ)*(d : ℤ) := by exact_mod_cast h
  dsimp [norm]; nlinarith

theorem OrbitCover.splitNat (p : ℕ) (hp : p.Prime) (c d : ℕ)
    (hcd : c*c+d*d = p+c*d) (hd : d % p ≠ 0)
    (m : ℤ) (xs ys : List (ℤ × ℤ)) (child : OrbitCover m xs)
    (hc : splitCheck (c : ℤ) (d : ℤ) xs ys = true) : OrbitCover ((p : ℤ) * m) ys := by
  apply OrbitCover.split p hp c d (nat_norm p c d hcd) ?_ m xs ys child hc
  intro h
  apply hd
  exact Nat.mod_eq_zero_of_dvd (by exact_mod_cast h)

end BinomialCertificate
namespace BinomialCertificate

theorem PowerMod.cast_dvd (a n p r l : ℕ) (h : PowerMod a n p r) (hl : l ∣ p) :
    (a : ZMod l)^n = (r : ZMod l) := by
  rw [← Nat.cast_pow, ← h.eq]
  apply (ZMod.natCast_eq_natCast_iff _ _ _).mpr
  exact (Nat.mod_mod_of_dvd (a^n) hl).symm

theorem prime_of_pocklington (p a q r : ℕ) (hp : 1 < p) (hq : q.Prime)
    (hqd : q ∣ p-1) (hbound : p < q*q)
    (ha : PowerMod a (p-1) p 1) (hr : PowerMod a ((p-1)/q) p r)
    (hg : Nat.Coprime (r+p-1) p) : p.Prime := by
  by_contra hn
  let l := p.minFac
  have hlp : l.Prime := Nat.minFac_prime (by omega : p ≠ 1)
  have hld : l ∣ p := Nat.minFac_dvd p
  have hlsq : l^2 ≤ p := Nat.minFac_sq_le_self (by omega) hn
  have hlq : l < q := by nlinarith
  haveI : Fact l.Prime := ⟨hlp⟩
  have ha₁ : (a : ZMod l)^(p-1) = 1 := by simpa using ha.cast_dvd a (p-1) p 1 l hld
  have ha₀ : (a : ZMod l) ≠ 0 := by
    intro hz
    rw [hz, zero_pow (by omega : p-1 ≠ 0)] at ha₁
    exact zero_ne_one ha₁
  let d := orderOf (a : ZMod l)
  have hd₁ : d ∣ p-1 := orderOf_dvd_of_pow_eq_one ha₁
  have hd₂ : d ∣ l-1 := ZMod.orderOf_dvd_card_sub_one ha₀
  have hdpos : 0 < d := Nat.pos_of_dvd_of_pos hd₂ (by have := hlp.two_le; omega)
  have hdsmall : d < q := lt_of_le_of_lt (Nat.le_of_dvd (by have := hlp.two_le; omega) hd₂) (by omega)
  have hcop : Nat.Coprime d q := (hq.coprime_iff_not_dvd).mpr (by
    intro hh
    exact (not_le_of_gt hdsmall) (Nat.le_of_dvd hdpos hh)) |>.symm
  have hdq : d ∣ (p-1)/q := by
    apply hcop.dvd_of_dvd_mul_left
    simpa only [Nat.mul_div_cancel' hqd] using hd₁
  have ha₂ : (a : ZMod l)^((p-1)/q) = 1 := (orderOf_dvd_iff_pow_eq_one).mp hdq
  have hr₁ : (r : ZMod l) = 1 := by rw [← hr.cast_dvd a ((p-1)/q) p r l hld]; exact ha₂
  have hp₀ : (p : ZMod l) = 0 := (ZMod.natCast_eq_zero_iff p l).mpr hld
  have hcast : ((r+p-1 : ℕ) : ZMod l) = 0 := by
    rw [Nat.cast_sub (by omega : 1 ≤ r+p), Nat.cast_add, Nat.cast_one, hr₁, hp₀]
    ring
  have hlr : l ∣ r+p-1 := (ZMod.natCast_eq_zero_iff _ _).mp hcast
  have hlone : l ∣ 1 := by simpa [hg.gcd_eq_one] using Nat.dvd_gcd hlr hld
  exact hlp.not_dvd_one hlone

end BinomialCertificate
namespace BinomialCertificate

inductive RowCell where
  | reject (p : ℕ) (hp : p.Prime) (m : ℕ)
  | exclude (k : ℕ) (hk : BinaryImpossible k)
  | skip

def RowCell.check (n cy cz : ℕ) : RowCell → Bool
  | .reject p _ m => decide (p % 3 = 2 ∧ m % p ≠ 0 ∧
      6*(n-cy-cz)+1 = p*m ∧ cy+cz < n)
  | .exclude k _ => decide (cy+cz+k = n)
  | .skip => decide (n ≤ cy+cz)

theorem RowCell.sound (n y z cy cz : ℕ) (c : RowCell)
    (hy : (y+5).choose 6 = cy) (hz : (z+7).choose 8 = cz)
    (hc : c.check n cy cz = true) : CellImpossible n y z := by
  cases c with
  | skip =>
    apply CellImpossible.skip n y z cy cz
    · rwa [← Nat.choose_eq_fast_choose]
    · rwa [← Nat.choose_eq_fast_choose]
    · exact of_decide_eq_true hc
  | exclude k hk =>
    apply CellImpossible.of_binary n y z cy cz k
    · rwa [← Nat.choose_eq_fast_choose]
    · rwa [← Nat.choose_eq_fast_choose]
    · exact of_decide_eq_true hc
    · exact hk
  | reject p hp m =>
    have hh : p % 3 = 2 ∧ m % p ≠ 0 ∧ 6*(n-cy-cz)+1 = p*m ∧ cy+cz < n := of_decide_eq_true hc
    constructor
    intro w x heq
    rw [hy,hz] at heq
    have hk : (w+2).choose 2 + (x+3).choose 4 = n-cy-cz := by omega
    have hn := representationPair_norm w x
    have hk' : ((w+2).choose 2 : ℤ) + ((x+3).choose 4 : ℤ) = ((n-cy-cz : ℕ) : ℤ) := by exact_mod_cast hk
    have hn' : norm (representationPair w x).1 (representationPair w x).2 = ((p*m : ℕ) : ℤ) := by
      rw [hn,hk', ← hh.2.2.1]; push_cast; rfl
    obtain ⟨s,hs,_⟩ := (OrbitCover.rejectNat p hp hh.1 m hh.2.1).complete _ _ hn'
    simp at hs

def checkCells (n cy : ℕ) : ℕ → List RowCell → Bool
  | _, [] => true
  | z, c::cs => c.check n cy (Nat.fast_choose (z+7) 8) && checkCells n cy (z+1) cs

theorem checkCells_sound (n y cy : ℕ) (hy : (y+5).choose 6 = cy)
    (z : ℕ) (cs : List RowCell) (hc : checkCells n cy z cs = true) :
    Segment n y z cs.length := by
  induction cs generalizing z with
  | nil => exact Segment.nil z
  | cons c cs ih =>
    simp only [checkCells, Bool.and_eq_true] at hc
    apply Segment.cons
    · exact c.sound n y z cy (Nat.fast_choose (z+7) 8) hy (by rw [Nat.choose_eq_fast_choose]) hc.1
    · exact ih (z+1) hc.2

theorem RowValid.checked (n y cy Z : ℕ) (cs : List RowCell)
    (hy : Nat.fast_choose (y+5) 6 = cy) (hl : cs.length = Z)
    (hc : checkCells n cy 0 cs = true) : RowValid n y Z := by
  subst Z
  exact RowValid.of_segment n y cs.length (checkCells_sound n y cy (by rwa [Nat.choose_eq_fast_choose]) 0 cs hc)

end BinomialCertificate
namespace BinomialCertificate

noncomputable def iAdd (a b : ℤ) : ℤ :=
  Int.rec
    (fun a => Int.rec (fun b => Int.ofNat (Nat.add a b)) (fun b => Int.subNatNat a (Nat.succ b)) b)
    (fun a => Int.rec (fun b => Int.subNatNat b (Nat.succ a)) (fun b => Int.negSucc (Nat.succ (Nat.add a b))) b) a
noncomputable def iMul (a b : ℤ) : ℤ :=
  Int.rec
    (fun a => Int.rec (fun b => Int.ofNat (Nat.mul a b)) (fun b => Int.negOfNat (Nat.mul a (Nat.succ b))) b)
    (fun a => Int.rec (fun b => Int.negOfNat (Nat.mul (Nat.succ a) b)) (fun b => Int.ofNat (Nat.mul (Nat.succ a) (Nat.succ b))) b) a
noncomputable def iNeg (a : ℤ) : ℤ := Int.rec Int.negOfNat (fun a => Int.ofNat (Nat.succ a)) a
noncomputable def iSub (a b : ℤ) : ℤ := iAdd a (iNeg b)

@[simp] theorem iAdd_eq (a b : ℤ) : iAdd a b = a+b := by cases a <;> cases b <;> rfl
@[simp] theorem iMul_eq (a b : ℤ) : iMul a b = a*b := by cases a <;> cases b <;> rfl
@[simp] theorem iNeg_eq (a : ℤ) : iNeg a = -a := by cases a <;> rfl
@[simp] theorem iSub_eq (a b : ℤ) : iSub a b = a-b := by simp [iSub, sub_eq_add_neg]

noncomputable def pairBeq (a b : ℤ × ℤ) : Bool :=
  Bool.and' (Int.beq' a.1 b.1) (Int.beq' a.2 b.2)
@[simp] theorem pairBeq_iff (a b : ℤ × ℤ) : pairBeq a b = true ↔ a = b := by
  simp [pairBeq, Bool.and'_eq_and, Int.beq'_eq_beq, Prod.ext_iff]

noncomputable def splitCheckFast (c d : ℤ) (xs ys : List (ℤ × ℤ)) : Bool :=
  List.rec (fun ys => List.casesOn ys true (fun _ _ => false))
    (fun v _ ih ys => List.casesOn ys false (fun a rest =>
      List.casesOn rest false (fun b rest =>
        Bool.and' (pairBeq a (iSub (iMul v.1 c) (iMul v.2 d),
          iSub (iAdd (iMul v.1 d) (iMul v.2 c)) (iMul v.2 d)))
          (Bool.and' (pairBeq b (iAdd (iMul v.1 (iSub c d)) (iMul v.2 d),
            iAdd (iMul (iNeg v.1) d) (iMul v.2 c))) (ih rest))))) xs ys

theorem splitCheckFast_cons (c d : ℤ) (v : ℤ × ℤ) (xs : List (ℤ × ℤ)) (a b : ℤ × ℤ) (ys : List (ℤ × ℤ)) :
    splitCheckFast c d (v::xs) (a::b::ys) =
      Bool.and' (pairBeq a (iSub (iMul v.1 c) (iMul v.2 d),
        iSub (iAdd (iMul v.1 d) (iMul v.2 c)) (iMul v.2 d)))
        (Bool.and' (pairBeq b (iAdd (iMul v.1 (iSub c d)) (iMul v.2 d),
          iAdd (iMul (iNeg v.1) d) (iMul v.2 c))) (splitCheckFast c d xs ys)) := rfl

theorem splitCheckFast_sound (c d : ℤ) (xs ys : List (ℤ × ℤ)) :
    splitCheckFast c d xs ys = true ↔ splitCheck c d xs ys = true := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp [splitCheckFast, splitCheck]
  | cons v xs ih =>
    cases ys with
    | nil => simp [splitCheckFast, splitCheck]
    | cons a ys =>
      cases ys with
      | nil => simp [splitCheckFast, splitCheck]
      | cons b ys =>
        simp only [splitCheckFast_cons, splitCheck, Bool.and'_eq_and, Bool.and_eq_true,
          pairBeq_iff, iAdd_eq, iSub_eq, iMul_eq, iNeg_eq, decide_eq_true_eq, ih]
        tauto

theorem OrbitCover.splitFast (p : ℕ) (hp : p.Prime) (c d : ℕ)
    (hcd : c*c+d*d = p+c*d) (hd : d % p ≠ 0)
    (m : ℤ) (xs ys : List (ℤ × ℤ)) (child : OrbitCover m xs)
    (hc : splitCheckFast (c : ℤ) (d : ℤ) xs ys = true) : OrbitCover ((p : ℤ) * m) ys :=
  OrbitCover.splitNat p hp c d hcd hd m xs ys child ((splitCheckFast_sound _ _ _ _).mp hc)

noncomputable def unitImage (a b : ℤ) (u : ℕ) : ℤ × ℤ :=
  match u with
  | 0 => (a,b)
  | 1 => (iNeg a,iNeg b)
  | 2 => (iNeg b,iSub a b)
  | 3 => (b,iSub b a)
  | 4 => (iSub a b,a)
  | _ => (iSub b a,iNeg a)

theorem unitImage_eq (a b : ℤ) (u : ℕ) (hu : u < 6) :
    unitImage a b u = (orbit (a,b)).getD u (0,0) := by
  interval_cases u <;> simp [unitImage, orbit, List.getD]

noncomputable def seedCheckFast (a b r s : ℕ) : Bool :=
  Bool.and' (Nat.ble b a)
    (Bool.and'
      (Bool.rec true
        (Bool.and' (Nat.blt (Nat.mul r r) (Nat.add (Nat.mul 4 (Nat.sub (Nat.mul 2 a) b)) 5))
          (Nat.blt (Nat.add (Nat.mul 4 (Nat.sub (Nat.mul 2 a) b)) 5) (Nat.mul (Nat.succ r) (Nat.succ r))))
        (Bool.and' (Nat.ble 3 b) (Nat.beq (Nat.mod b 2) 1)))
      (Bool.rec true
        (Bool.and' (Nat.blt (Nat.mul s s) (Nat.add (Nat.mul 4 (Nat.sub a (Nat.mul 2 b))) 5))
          (Nat.blt (Nat.add (Nat.mul 4 (Nat.sub a (Nat.mul 2 b))) 5) (Nat.mul (Nat.succ s) (Nat.succ s))))
        (Bool.and' (Nat.ble 3 a) (Bool.and' (Nat.beq (Nat.mod a 2) 1) (Nat.blt (Nat.mul 2 b) a)))))

theorem seedCheckFast_sound (a b r s : ℕ) : seedCheckFast a b r s = seedCheck a b r s := by
  have rec_eq (p q : Bool) : Bool.rec true q p = cond p q true := by cases p <;> rfl
  apply Bool.eq_iff_iff.mpr
  simp only [seedCheckFast, rec_eq, Bool.and'_eq_and, Bool.and_eq_true, Bool.cond_eq_true_distrib,
    Nat.ble_eq, Nat.blt_eq, Nat.beq_eq, seedCheck, decide_eq_true_eq]
  split_ifs <;> simp only [decide_eq_true_eq] <;> tauto

noncomputable def cleanCheckFast (v : ℤ × ℤ) (c : CleanSeed) : Bool :=
  Bool.and' (Nat.blt c.u 6) (Bool.and' (pairBeq v (unitImage (Int.ofNat c.a) (Int.ofNat c.b) c.u))
    (seedCheckFast c.a c.b c.r c.s))

noncomputable def cleanListCheckFast (xs : List (ℤ × ℤ)) (cs : List CleanSeed) : Bool :=
  List.rec (fun cs => List.casesOn cs true (fun _ _ => false))
    (fun v _ ih cs => List.casesOn cs false (fun c cs => Bool.and' (cleanCheckFast v c) (ih cs))) xs cs

theorem cleanListCheckFast_cons (v : ℤ × ℤ) (xs : List (ℤ × ℤ)) (c : CleanSeed) (cs : List CleanSeed) :
    cleanListCheckFast (v::xs) (c::cs) = Bool.and' (cleanCheckFast v c) (cleanListCheckFast xs cs) := rfl

theorem cleanCheckFast_sound (v : ℤ × ℤ) (c : CleanSeed)
    (h : cleanCheckFast v c = true) : cleanCheck v c = true := by
  simp only [cleanCheckFast, Bool.and'_eq_and, Bool.and_eq_true, pairBeq_iff, Nat.blt_eq, seedCheckFast_sound] at h
  simp only [cleanCheck, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨⟨h.1, h.2.1.trans (unitImage_eq _ _ _ h.1)⟩, h.2.2⟩

theorem cleanListCheckFast_sound (xs : List (ℤ × ℤ)) (cs : List CleanSeed)
    (h : cleanListCheckFast xs cs = true) : cleanListCheck xs cs = true := by
  induction xs generalizing cs with
  | nil => cases cs <;> simpa [cleanListCheckFast, cleanListCheck] using h
  | cons v xs ih =>
    cases cs with
    | nil => simp [cleanListCheckFast] at h
    | cons c cs =>
      simp only [cleanListCheckFast_cons, Bool.and'_eq_and, Bool.and_eq_true] at h
      simp only [cleanListCheck, Bool.and_eq_true]
      exact ⟨cleanCheckFast_sound _ _ h.1, ih cs h.2⟩

theorem BinaryImpossible.of_fastCover (k : ℕ) (m : ℤ) (xs : List (ℤ × ℤ))
    (cs : List CleanSeed) (hc : OrbitCover m xs) (hm : m = 6*(k : ℤ)+1)
    (hr : cleanListCheckFast xs cs = true) : BinaryImpossible k :=
  BinaryImpossible.of_orbitCover k m xs cs hc hm (cleanListCheckFast_sound xs cs hr)

end BinomialCertificate
