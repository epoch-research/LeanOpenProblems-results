noncomputable def rawTrace (a m n r : Nat) (cs : List Nat) : Bool :=
  List.rec (fun n r => Bool.and' (Nat.beq n 0) (Nat.beq r (Nat.mod 1 m)))
    (fun c _ ih n r => Bool.and'
      (Nat.beq r (Nat.mod (Bool.rec (Nat.mul (Nat.mul c c) a) (Nat.mul c c) (Nat.beq (Nat.mod n 2) 0)) m))
      (ih (Nat.div n 2) c)) cs n r

theorem rawTrace_eq (a m n r : Nat) (cs : List Nat) : rawTrace a m n r cs = powerTrace a m n r cs := by
  induction cs generalizing n r with
  | nil => rfl
  | cons c cs ih =>
    change Bool.and' _ (rawTrace a m (n/2) c cs) = Bool.and' _ (powerTrace a m (n/2) c cs)
    rw [ih]
    cases Nat.beq (n%2) 0 <;> rfl

theorem rawTrace_sound (a m n r : Nat) (cs : List Nat) (h : rawTrace a m n r cs = true) : PowerMod a n m r :=
  powerTrace_sound a m n r cs ((rawTrace_eq a m n r cs).symm.trans h)

open Lean Meta Elab Command Qq

def buildRawTrace (a n m : Nat) : Nat × Expr := Id.run do
  let mut cs : List Nat := []
  let mut c := 1 % m
  for i in (List.range (n.log2+1)).reverse do
    cs := c::cs
    c := (if n / 2^i % 2 == 0 then c*c else c*c*a) % m
  let ce := cs.foldr (fun x xs => mkApp3 (mkConst ``List.cons [0]) (mkConst ``Nat) (mkNatLit x) xs)
    (mkApp (mkConst ``List.nil [0]) (mkConst ``Nat))
  let hf := mkApp2 (mkConst ``Eq.refl [1]) (mkConst ``Bool) (mkConst ``Bool.true)
  return (c, mkAppN (mkConst ``rawTrace_sound) #[mkNatLit a,mkNatLit m,mkNatLit n,mkNatLit c,ce,hf])

end BinomialCertificate
