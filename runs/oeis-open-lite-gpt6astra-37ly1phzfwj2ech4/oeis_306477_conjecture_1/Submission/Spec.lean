noncomputable def RowCell.checkFast (n cy cz : ℕ) (c : RowCell) : Bool :=
  RowCell.rec
    (fun p _ m => Bool.and' (Nat.beq (p%3) 2)
      (Bool.and' (Bool.not (Nat.beq (m%p) 0))
        (Bool.and' (Nat.beq (6*(n-cy-cz)+1) (p*m)) (Nat.blt (cy+cz) n))))
    (fun k _ => Nat.beq (cy+cz+k) n)
    (Nat.ble n (cy+cz)) c

theorem RowCell.checkFast_sound (n cy cz : ℕ) (c : RowCell) :
    c.checkFast n cy cz = true ↔ c.check n cy cz = true := by
  cases c <;> simp [RowCell.checkFast, RowCell.check, Bool.and'_eq_and, Bool.eq_false_iff]

noncomputable def checkCellsFast (n cy z : ℕ) (cs : List RowCell) : Bool :=
  List.rec (fun _ => true)
    (fun c _ ih z => Bool.and' (c.checkFast n cy (Nat.fast_choose (z+7) 8)) (ih (z+1))) cs z

theorem checkCellsFast_sound (n cy z : ℕ) (cs : List RowCell) :
    checkCellsFast n cy z cs = true ↔ checkCells n cy z cs = true := by
  induction cs generalizing z with
  | nil => simp [checkCellsFast,checkCells]
  | cons c cs ih =>
    simpa only [checkCellsFast, checkCells, Bool.and'_eq_and, Bool.and_eq_true,
      RowCell.checkFast_sound] using and_congr Iff.rfl (ih (z+1))

theorem RowValid.checkedFast (n y cy Z : ℕ) (cs : List RowCell)
    (hy : Nat.fast_choose (y+5) 6 = cy) (hl : cs.length = Z)
    (hc : checkCellsFast n cy 0 cs = true) : RowValid n y Z :=
  RowValid.checked n y cy Z cs hy hl ((checkCellsFast_sound _ _ _ _).mp hc)

end BinomialCertificate
