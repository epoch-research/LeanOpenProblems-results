import FormalConjectures.Util.ProblemImports

set_option maxRecDepth 100000
set_option Elab.async false
set_option linter.all false
set_option linter.unreachableTactic false
set_option maxHeartbeats 0
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false

/-
The counterexample is 896315812331399.  The certificate below excludes every
pair y < 928, z < 275; larger indices already contribute more than this number.
For each pair, factorization of an integral quadratic norm gives a complete
list of possible binary representations.  All arithmetic and primality
certificates are checked by the kernel.  The custom elaborators only construct
ordinary proof terms, all checked by Lean's kernel. Primality is certified
by Lucas and Pocklington criteria. Norm solutions are enumerated up to the six
units, and explicit intervals between consecutive squares exclude every
remaining candidate. The encoded strings contain only untrusted certificate
data: their decoding and all search computations must produce checked proofs.
-/

open Nat Finset

/--
A306477: Number of ways to write $n$ as $\binom{w+2}{2} + \binom{x+3}{4} + \binom{y+5}{6} + \binom{z+7}{8}$
with $w,x,y,z$ nonnegative integers, where $\binom{m}{k}$ denotes the binomial coefficient $\frac{m!}{k!(m-k)!}$.
-/
def A306477 (n : ℕ) : ℕ :=
  let R := Finset.range (n + 1)
  R.sum (fun w =>
    R.sum (fun x =>
      R.sum (fun y =>
        R.sum (fun z =>
          if (w + 2).choose 2 + (x + 3).choose 4 + (y + 5).choose 6 + (z + 7).choose 8 = n then 1 else 0
        )
      )
    )
  )


theorem index_le_shifted_choose (x k : ℕ) : x ≤ (x + k).choose (k + 1) := by
  induction x with
  | zero => omega
  | succ x ih =>
    have hpos : 0 < (x + k).choose k := Nat.choose_pos (by omega)
    have heq : (x + 1 + k).choose (k + 1) =
        (x + k).choose k + (x + k).choose (k + 1) := by
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        Nat.choose_succ_succ (x + k) k
    change x + 1 ≤ (x + 1 + k).choose (k + 1)
    rw [heq]
    omega

theorem A306477_pos_iff_bounded (n : ℕ) : 0 < A306477 n ↔
    ∃ w ≤ n, ∃ x ≤ n, ∃ y ≤ n, ∃ z ≤ n,
      (w + 2).choose 2 + (x + 3).choose 4 +
      (y + 5).choose 6 + (z + 7).choose 8 = n := by
  have hi (p : Prop) [Decidable p] : (0 < if p then (1 : ℕ) else 0) ↔ p := by
    by_cases hp : p <;> simp [hp]
  simp only [A306477, Finset.sum_pos_iff]
  simp [hi]

theorem A306477_pos_iff_representation (n : ℕ) : 0 < A306477 n ↔
    ∃ w x y z : ℕ,
      (w + 2).choose 2 + (x + 3).choose 4 +
      (y + 5).choose 6 + (z + 7).choose 8 = n := by
  rw [A306477_pos_iff_bounded]
  constructor
  · rintro ⟨w, _, x, _, y, _, z, _, h⟩
    exact ⟨w, x, y, z, h⟩
  · rintro ⟨w, x, y, z, h⟩
    have hw := index_le_shifted_choose (w + 1) 1
    have hx := index_le_shifted_choose x 3
    have hy := index_le_shifted_choose y 5
    have hz := index_le_shifted_choose z 7
    norm_num [Nat.add_assoc] at hw hx hy hz
    refine ⟨w, ?_, x, ?_, y, ?_, z, ?_, h⟩ <;> omega


namespace BinomialCertificate

def norm (a b : ℤ) : ℤ := a ^ 2 - a * b + b ^ 2

theorem norm_mul (a b c d : ℤ) :
    norm (a * c - b * d) (a * d + b * c - b * d) = norm a b * norm c d := by
  simp only [norm]
  ring

theorem norm_nonneg (a b : ℤ) : 0 ≤ norm a b := by
  dsimp [norm]
  nlinarith [sq_nonneg (2 * a - b), sq_nonneg b]

theorem norm_eq_one (a b : ℤ) (h : norm a b = 1) :
    (a = 1 ∧ b = 0) ∨ (a = -1 ∧ b = 0) ∨ (a = 0 ∧ b = 1) ∨
    (a = 0 ∧ b = -1) ∨ (a = 1 ∧ b = 1) ∨ (a = -1 ∧ b = -1) := by
  dsimp [norm] at h
  have ha : -1 ≤ a ∧ a ≤ 1 := by
    constructor <;> by_contra hh
    · have : a ≤ -2 := by omega
      nlinarith [sq_nonneg (a + 1), sq_nonneg (a - 2 * b)]
    · have : 2 ≤ a := by omega
      nlinarith [sq_nonneg (a - 1), sq_nonneg (a - 2 * b)]
  have hb : -1 ≤ b ∧ b ≤ 1 := by
    constructor <;> by_contra hh
    · have : b ≤ -2 := by omega
      nlinarith [sq_nonneg (b + 1), sq_nonneg (2 * a - b)]
    · have : 2 ≤ b := by omega
      nlinarith [sq_nonneg (b - 1), sq_nonneg (2 * a - b)]
  obtain ⟨ha1, ha2⟩ := ha
  obtain ⟨hb1, hb2⟩ := hb
  interval_cases a <;> interval_cases b <;> norm_num at *

theorem inert_dvd_norm {p : ℕ} (hp : p.Prime) (hp3 : p % 3 = 2)
    (a b : ℤ) (h : (p : ℤ) ∣ norm a b) : (p : ℤ) ∣ a ∧ (p : ℤ) ∣ b := by
  letI : Fact p.Prime := ⟨hp⟩
  have h3 : (3 : ZMod p) ≠ 0 := by
    intro hh
    have hd : p ∣ 3 := (ZMod.natCast_eq_zero_iff 3 p).mp hh
    have heq := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp hd
    omega
  have hn : (a : ZMod p) ^ 2 - (a : ZMod p) * (b : ZMod p) + (b : ZMod p) ^ 2 = 0 := by
    have hh := (ZMod.intCast_zmod_eq_zero_iff_dvd (norm a b) p).mpr h
    simpa [norm] using hh
  have hb : (b : ZMod p) = 0 := by
    by_contra hb
    let r : ZMod p := (a : ZMod p) / (b : ZMod p)
    have hr : r ^ 2 - r + 1 = 0 := by
      dsimp [r]
      field_simp
      linear_combination hn
    have hr0 : -r ≠ 0 := by
      intro hh
      have : r = 0 := neg_eq_zero.mp hh
      simp [this] at hr
    have hc : (-r) ^ 3 = 1 := by
      linear_combination -(r + 1) * hr
    have hf := ZMod.pow_card_sub_one_eq_one hr0
    have he : p - 1 = 3 * ((p - 1) / 3) + 1 := by
      have hp2 := hp.two_le
      omega
    rw [he, pow_add, pow_mul, hc, one_pow, one_mul, pow_one] at hf
    have hre : r = -1 := by linear_combination -hf
    apply h3
    rw [hre] at hr
    linear_combination hr
  have ha : (a : ZMod p) = 0 := by
    simpa [hb, sq_eq_zero_iff] using hn
  exact ⟨(ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp ha,
    (ZMod.intCast_zmod_eq_zero_iff_dvd b p).mp hb⟩


theorem divide_of_dvd_linear {p : ℕ} (hp : p.Prime)
    (c d : ℤ) (hcd : norm c d = p) (hd : ¬ (p : ℤ) ∣ d)
    (a b m : ℤ) (hn : norm a b = p * m)
    (hl : (p : ℤ) ∣ b * c - a * d) :
    ∃ e f : ℤ, norm e f = m ∧ a = e * c - f * d ∧ b = e * d + f * c - f * d := by
  letI : Fact p.Prime := ⟨hp⟩
  have hD : (d : ZMod p) ≠ 0 := by
    exact fun h => hd ((ZMod.intCast_zmod_eq_zero_iff_dvd d p).mp h)
  have hCD : (c : ZMod p) ^ 2 - (c : ZMod p) * (d : ZMod p) + (d : ZMod p) ^ 2 = 0 := by
    have h := congrArg (fun t : ℤ => (t : ZMod p)) hcd
    simpa [norm] using h
  have hL : (b : ZMod p) * (c : ZMod p) - (a : ZMod p) * (d : ZMod p) = 0 := by
    have h := (ZMod.intCast_zmod_eq_zero_iff_dvd (b * c - a * d) p).mpr hl
    simpa using h
  have hA : (a : ZMod p) * ((c : ZMod p) - (d : ZMod p)) +
      (b : ZMod p) * (d : ZMod p) = 0 := by
    have hh : ((a : ZMod p) * ((c : ZMod p) - (d : ZMod p)) +
        (b : ZMod p) * (d : ZMod p)) * (d : ZMod p) = 0 := by
      linear_combination -((c : ZMod p) - (d : ZMod p)) * hL + (b : ZMod p) * hCD
    exact (mul_eq_zero.mp hh).resolve_right hD
  have hAd : (p : ℤ) ∣ a * (c - d) + b * d := by
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
    simpa using hA
  obtain ⟨e, he⟩ := hAd
  obtain ⟨f, hf⟩ := hl
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have ha : a = e * c - f * d := by
    apply mul_left_cancel₀ hp0
    calc
      (p : ℤ) * a = norm c d * a := by rw [hcd]
      _ = (a * (c - d) + b * d) * c - (b * c - a * d) * d := by simp only [norm]; ring
      _ = p * (e * c - f * d) := by rw [he, hf]; ring
  have hb : b = e * d + f * c - f * d := by
    apply mul_left_cancel₀ hp0
    calc
      (p : ℤ) * b = norm c d * b := by rw [hcd]
      _ = (a * (c - d) + b * d) * d + (b * c - a * d) * c -
          (b * c - a * d) * d := by simp only [norm]; ring
      _ = p * (e * d + f * c - f * d) := by rw [he, hf]; ring
  refine ⟨e, f, ?_, ha, hb⟩
  apply mul_right_cancel₀ hp0
  calc
    norm e f * p = norm a b := by rw [← hcd, ← norm_mul, ← ha, ← hb]
    _ = m * p := by rw [hn]; ring

theorem split_norm_prime {p : ℕ} (hp : p.Prime)
    (c d : ℤ) (hcd : norm c d = p) (hd : ¬ (p : ℤ) ∣ d)
    (a b m : ℤ) (hn : norm a b = p * m) :
    ∃ e f : ℤ, norm e f = m ∧
      ((a = e * c - f * d ∧ b = e * d + f * c - f * d) ∨
       (a = e * (c - d) + f * d ∧ b = -e * d + f * c)) := by
  letI : Fact p.Prime := ⟨hp⟩
  have hCD : (c : ZMod p) ^ 2 - (c : ZMod p) * (d : ZMod p) + (d : ZMod p) ^ 2 = 0 := by
    have h := congrArg (fun t : ℤ => (t : ZMod p)) hcd
    simpa [norm] using h
  have hAB : (a : ZMod p) ^ 2 - (a : ZMod p) * (b : ZMod p) + (b : ZMod p) ^ 2 = 0 := by
    have h := congrArg (fun t : ℤ => (t : ZMod p)) hn
    simpa [norm] using h
  have hh : ((a : ZMod p) * (d : ZMod p) - (b : ZMod p) * (c : ZMod p)) *
      ((a : ZMod p) * (d : ZMod p) - (b : ZMod p) * ((d : ZMod p) - (c : ZMod p))) = 0 := by
    linear_combination (d : ZMod p) ^ 2 * hAB - (b : ZMod p) ^ 2 * hCD
  rcases mul_eq_zero.mp hh with hL | hR
  · have hl : (p : ℤ) ∣ b * c - a * d := by
      apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
      push_cast
      linear_combination -hL
    obtain ⟨e, f, he, ha, hb⟩ := divide_of_dvd_linear hp c d hcd hd a b m hn hl
    exact ⟨e, f, he, Or.inl ⟨ha, hb⟩⟩
  · have hconj : norm (c - d) (-d) = p := by rw [← hcd]; simp only [norm]; ring
    have hdconj : ¬ (p : ℤ) ∣ -d := by simpa using hd
    have hl : (p : ℤ) ∣ b * (c - d) - a * (-d) := by
      apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
      push_cast
      linear_combination hR
    obtain ⟨e, f, he, ha, hb⟩ := divide_of_dvd_linear hp (c - d) (-d) hconj hdconj a b m hn hl
    refine ⟨e, f, he, Or.inr ⟨?_, ?_⟩⟩
    · linear_combination ha
    · linear_combination hb


theorem norm_scale (p a b : ℤ) : norm (p * a) (p * b) = p ^ 2 * norm a b := by
  simp only [norm]
  ring

theorem inert_divide {p : ℕ} (hp : p.Prime) (hp3 : p % 3 = 2)
    (a b m : ℤ) (hn : norm a b = (p : ℤ) ^ 2 * m) :
    ∃ e f : ℤ, norm e f = m ∧ a = p * e ∧ b = p * f := by
  have hd : (p : ℤ) ∣ norm a b := by
    rw [hn, pow_two, mul_assoc]
    exact dvd_mul_right _ _
  obtain ⟨ha, hb⟩ := inert_dvd_norm hp hp3 a b hd
  obtain ⟨e, he⟩ := ha
  obtain ⟨f, hf⟩ := hb
  have hp0 : (p : ℤ) ^ 2 ≠ 0 := pow_ne_zero _ (by exact_mod_cast hp.ne_zero)
  refine ⟨e, f, ?_, he, hf⟩
  apply mul_left_cancel₀ hp0
  rw [← norm_scale, ← he, ← hf, hn]

theorem inert_reject {p : ℕ} (hp : p.Prime) (hp3 : p % 3 = 2)
    (m : ℤ) (hm : ¬ (p : ℤ) ∣ m) (a b : ℤ) : norm a b ≠ p * m := by
  intro hn
  have hd : (p : ℤ) ∣ norm a b := by rw [hn]; exact dvd_mul_right _ _
  obtain ⟨ha, hb⟩ := inert_dvd_norm hp hp3 a b hd
  obtain ⟨e, he⟩ := ha
  obtain ⟨f, hf⟩ := hb
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  apply hm
  have hme : m = p * norm e f := by
    apply mul_left_cancel₀ hp0
    calc
      (p : ℤ) * m = norm a b := hn.symm
      _ = (p : ℤ) * (p * norm e f) := by rw [he, hf, norm_scale]; ring
  rw [hme]
  exact dvd_mul_right _ _


inductive Cert where
  | unit
  | split (p : ℕ) (hp : p.Prime) (c d : ℤ)
      (hcd : norm c d = p) (hd : ¬ (p : ℤ) ∣ d) (child : Cert)
  | scale (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2) (child : Cert)
  | reject (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2)
      (m : ℤ) (hm : ¬ (p : ℤ) ∣ m)

def Cert.value : Cert → ℤ
  | .unit => 1
  | .split p _ _ _ _ _ child => p * child.value
  | .scale p _ _ child => (p : ℤ) ^ 2 * child.value
  | .reject p _ _ m _ => p * m

def Cert.solutions : Cert → List (ℤ × ℤ)
  | .unit => [(1, 0), (-1, 0), (0, 1), (0, -1), (1, 1), (-1, -1)]
  | .split _ _ c d _ _ child => child.solutions.flatMap (fun (e, f) =>
      [(e * c - f * d, e * d + f * c - f * d),
       (e * (c - d) + f * d, -e * d + f * c)])
  | .scale p _ _ child => child.solutions.map (fun (e, f) => (p * e, p * f))
  | .reject _ _ _ _ _ => []

theorem Cert.complete (t : Cert) (a b : ℤ) (h : norm a b = t.value) :
    (a, b) ∈ t.solutions := by
  induction t generalizing a b with
  | unit =>
    have hu := norm_eq_one a b h
    simpa only [Cert.solutions, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] using hu
  | split p hp c d hcd hd child ih =>
    obtain ⟨e, f, he, ha | ha⟩ := split_norm_prime hp c d hcd hd a b child.value h
    · apply List.mem_flatMap.mpr
      refine ⟨(e, f), ih e f he, ?_⟩
      simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
      exact Or.inl ha
    · apply List.mem_flatMap.mpr
      refine ⟨(e, f), ih e f he, ?_⟩
      simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
      exact Or.inr ha
  | scale p hp hmod child ih =>
    obtain ⟨e, f, he, ha, hb⟩ := inert_divide hp hmod a b child.value h
    apply List.mem_map.mpr
    exact ⟨(e, f), ih e f he, by simp only; exact Prod.ext ha.symm hb.symm⟩
  | reject p hp hmod m hm =>
    exact (inert_reject hp hmod m hm a b h).elim


theorem choose_two_identity (x : ℕ) :
    2 * (x + 2).choose 2 = x ^ 2 + 3 * x + 2 := by
  have h := Nat.add_one_mul_choose_eq (x + 1) 1
  simp only [Nat.choose_one_right] at h
  nlinarith

theorem choose_four_identity (x : ℕ) :
    (x ^ 2 + 3 * x + 1) ^ 2 = 24 * (x + 3).choose 4 + 1 := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (x + 3) 4
  norm_num [Nat.descFactorial, Nat.factorial] at h
  have he : x + 3 - 2 = x + 1 := by omega
  rw [he] at h
  nlinarith

def representationPair (w x : ℕ) : ℤ × ℤ :=
  ((x + 2).choose 2 + (w : ℤ) + 1, 2 * (w : ℤ) + 3)

theorem representationPair_norm (w x : ℕ) :
    norm (representationPair w x).1 (representationPair w x).2 =
      6 * (((w + 2).choose 2 : ℤ) + ((x + 3).choose 4 : ℤ)) + 1 := by
  have hw : 2 * ((w + 2).choose 2 : ℤ) = (w : ℤ) ^ 2 + 3 * w + 2 := by
    exact_mod_cast choose_two_identity w
  have hx : 2 * ((x + 2).choose 2 : ℤ) = (x : ℤ) ^ 2 + 3 * x + 2 := by
    exact_mod_cast choose_two_identity x
  have hx4 : ((x : ℤ) ^ 2 + 3 * x + 1) ^ 2 = 24 * ((x + 3).choose 4 : ℤ) + 1 := by
    exact_mod_cast choose_four_identity x
  have hP : 2 * (representationPair w x).1 - (representationPair w x).2 =
      (x : ℤ) ^ 2 + 3 * x + 1 := by simp only [representationPair]; linarith
  have hQ : (representationPair w x).2 ^ 2 = 8 * ((w + 2).choose 2 : ℤ) + 1 := by
    simp only [representationPair]
    nlinarith
  have hid : 4 * norm (representationPair w x).1 (representationPair w x).2 =
      (2 * (representationPair w x).1 - (representationPair w x).2) ^ 2 +
        3 * (representationPair w x).2 ^ 2 := by simp only [norm]; ring
  rw [hP, hx4, hQ] at hid
  linarith

theorem representationPair_discriminant (w x : ℕ) :
    8 * (representationPair w x).1 - 4 * (representationPair w x).2 + 5 =
      ((2 * x + 3 : ℕ) : ℤ) ^ 2 := by
  have hx : 2 * ((x + 2).choose 2 : ℤ) = (x : ℤ) ^ 2 + 3 * x + 2 := by
    exact_mod_cast choose_two_identity x
  simp only [representationPair]
  push_cast
  nlinarith

def potentialRepresentation (v : ℤ × ℤ) : Bool :=
  let D := 8 * v.1 - 4 * v.2 + 5
  decide (3 ≤ v.2) && decide (v.2 % 2 = 1) && decide (9 ≤ D) &&
    decide (D.toNat.sqrt ^ 2 = D.toNat)

theorem representationPair_potential (w x : ℕ) :
    potentialRepresentation (representationPair w x) = true := by
  have hD := representationPair_discriminant w x
  have hb : 3 ≤ (representationPair w x).2 := by simp [representationPair]
  have hb2 : (representationPair w x).2 % 2 = 1 := by
    simp [representationPair, Int.add_emod, Int.mul_emod]
  have hD9 : 9 ≤ 8 * (representationPair w x).1 - 4 * (representationPair w x).2 + 5 := by
    rw [hD]
    have hx0 : (0 : ℤ) ≤ x := by positivity
    push_cast
    nlinarith
  simp only [potentialRepresentation, hD, decide_eq_true_eq, Bool.and_eq_true]
  refine ⟨⟨⟨hb, hb2⟩, ?_⟩, ?_⟩
  · rwa [hD] at hD9
  · norm_cast
    rw [Nat.sqrt_eq']

def Cert.rulesOut (t : Cert) : Bool :=
  t.solutions.all (fun v => !potentialRepresentation v)

theorem Cert.not_representation_norm (t : Cert) (ht : t.rulesOut = true) (w x : ℕ) :
    norm (representationPair w x).1 (representationPair w x).2 ≠ t.value := by
  intro h
  have hm := t.complete _ _ h
  have hf := (List.all_eq_true.mp ht) (representationPair w x) hm
  simpa [representationPair_potential] using hf


end BinomialCertificate


namespace BinomialCertificate

def certificateCheck (n Y Z : ℕ) (table : ℕ → ℕ → Cert) : Bool :=
  (List.range Y).all (fun y => (List.range Z).all (fun z =>
    let S := Nat.fast_choose (y + 5) 6 + Nat.fast_choose (z + 7) 8
    if S < n then
      decide ((table y z).value = 6 * (n - S : ℕ) + 1) && (table y z).rulesOut
    else true))

theorem zero_of_certificate (n Y Z : ℕ) (table : ℕ → ℕ → Cert)
    (hY : n < (Y + 5).choose 6) (hZ : n < (Z + 7).choose 8)
    (hcheck : certificateCheck n Y Z table = true) : A306477 n = 0 := by
  by_contra h
  have hpos : 0 < A306477 n := Nat.pos_of_ne_zero h
  obtain ⟨w, x, y, z, heq⟩ := (A306477_pos_iff_representation n).mp hpos
  have hy : y < Y := by
    by_contra hh
    have hc := Nat.choose_le_choose 6 (show Y + 5 ≤ y + 5 by omega)
    omega
  have hz : z < Z := by
    by_contra hh
    have hc := Nat.choose_le_choose 8 (show Z + 7 ≤ z + 7 by omega)
    omega
  have hw : 0 < (w + 2).choose 2 := Nat.choose_pos (by omega)
  have hs : (y + 5).choose 6 + (z + 7).choose 8 < n := by omega
  have hd : n - ((y + 5).choose 6 + (z + 7).choose 8) =
      (w + 2).choose 2 + (x + 3).choose 4 := by omega
  simp only [certificateCheck, List.all_eq_true, List.mem_range] at hcheck
  have hc := hcheck y hy z hz
  simp only [← Nat.choose_eq_fast_choose, if_pos hs, Bool.and_eq_true, decide_eq_true_eq] at hc
  apply (table y z).not_representation_norm hc.2 w x
  rw [representationPair_norm, hc.1, hd]
  push_cast
  ring


end BinomialCertificate

namespace BinomialCertificate

def modPowAux (a m : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 1 % m
  | fuel + 1, n =>
      if n = 0 then 1 % m else
        let b := modPowAux a m fuel (n / 2)
        (if n % 2 = 0 then b * b else b * b * a) % m

theorem modPowAux_sound (a m fuel n : ℕ) (h : n < 2 ^ fuel) :
    modPowAux a m fuel n = a ^ n % m := by
  induction fuel generalizing n with
  | zero =>
    have : n = 0 := by omega
    subst n
    rfl
  | succ fuel ih =>
    by_cases hn : n = 0
    · simp [modPowAux, hn]
    · rw [modPowAux, if_neg hn]
      have hlt : n / 2 < 2 ^ fuel := by
        rw [pow_succ] at h
        omega
      rw [ih _ hlt]
      split_ifs with he
      · have heq : n = n / 2 + n / 2 := by omega
        conv_rhs => rw [heq, pow_add]
        simp [Nat.mul_mod]
      · have heq : n = n / 2 + n / 2 + 1 := by omega
        conv_rhs => rw [heq, pow_add, pow_add, pow_one]
        simp [Nat.mul_mod]

def modPow (a n m : ℕ) : ℕ := modPowAux a m (n.log2 + 1) n

theorem modPow_sound (a n m : ℕ) : modPow a n m = a ^ n % m :=
  modPowAux_sound a m (n.log2 + 1) n Nat.lt_log2_self

theorem modPow_cast (a n m : ℕ) :
    (modPow a n m : ZMod m) = (a : ZMod m) ^ n := by
  rw [modPow_sound]
  simp


theorem modPow_eq_one_iff (a n m : ℕ) (hm : 1 < m) :
    modPow a n m = 1 ↔ (a : ZMod m) ^ n = 1 := by
  constructor
  · intro h
    rw [← modPow_cast, h]
    simp
  · intro h
    have hl : modPow a n m < m := by
      rw [modPow_sound]
      exact Nat.mod_lt _ (by omega)
    have hc : (modPow a n m : ZMod m) = (1 : ℕ) := by
      simpa only [modPow_cast, Nat.cast_one] using h
    have hh := (ZMod.natCast_eq_natCast_iff' (modPow a n m) 1 m).mp hc
    simpa only [Nat.mod_eq_of_lt hl, Nat.mod_eq_of_lt hm] using hh

theorem prime_mem_of_dvd_prod {q : ℕ} (hq : q.Prime) (l : List ℕ)
    (hl : ∀ p ∈ l, p.Prime) (hd : q ∣ l.prod) : q ∈ l := by
  induction l with
  | nil =>
    simp only [List.prod_nil] at hd
    have hle := Nat.le_of_dvd (by decide : 0 < 1) hd
    have htwo := hq.two_le
    omega
  | cons p ps ih =>
    rw [List.prod_cons] at hd
    rcases hq.dvd_mul.mp hd with h | h
    · have hp := hl p (by simp)
      have he := (Nat.prime_dvd_prime_iff_eq hq hp).mp h
      simp [he]
    · exact List.mem_cons_of_mem p (ih (fun t ht => hl t (List.mem_cons_of_mem p ht)) h)

theorem prime_of_pratt (p a : ℕ) (factors : List ℕ) (hp : 1 < p)
    (hf : factors.prod = p - 1) (hprime : ∀ q ∈ factors, q.Prime)
    (ha : modPow a (p - 1) p = 1)
    (hpow : factors.all (fun q => decide (modPow a ((p - 1) / q) p ≠ 1)) = true) : p.Prime := by
  apply lucas_primality p (a : ZMod p) ((modPow_eq_one_iff a _ p hp).mp ha)
  intro q hq hqd
  have hmem : q ∈ factors := prime_mem_of_dvd_prod hq factors hprime (by simpa [hf] using hqd)
  have hneq : modPow a ((p - 1) / q) p ≠ 1 := by
    simpa using (List.all_eq_true.mp hpow) q hmem
  exact fun he => hneq ((modPow_eq_one_iff a _ p hp).mpr he)


end BinomialCertificate

namespace BinomialCertificate

def AllPrime : List ℕ → Prop
  | [] => True
  | p :: ps => p.Prime ∧ AllPrime ps

theorem AllPrime.mem (ps : List ℕ) (h : AllPrime ps) (p : ℕ) (hp : p ∈ ps) : p.Prime := by
  induction ps with
  | nil => simp at hp
  | cons q qs ih =>
    rcases List.mem_cons.mp hp with he | hm
    · subst p; exact h.1
    · exact ih h.2 hm

theorem prime_of_pratt_list (p a : ℕ) (factors : List ℕ) (hp : 1 < p)
    (hf : factors.prod = p - 1) (hprime : AllPrime factors)
    (ha : modPow a (p - 1) p = 1)
    (hpow : factors.all (fun q => decide (modPow a ((p - 1) / q) p ≠ 1)) = true) : p.Prime :=
  prime_of_pratt p a factors hp hf (AllPrime.mem factors hprime) ha hpow

def cellCheck (n cy z : ℕ) (t : Cert) : Bool :=
  let S := cy + Nat.fast_choose (z + 7) 8
  if S < n then
    decide (t.value = 6 * (n - S : ℕ) + 1) && t.rulesOut
  else true

def rowCheckAux (n cy z : ℕ) : List Cert → Bool
  | [] => true
  | t :: ts => cellCheck n cy z t && rowCheckAux n cy (z + 1) ts

theorem rowCheckAux_get (n cy : ℕ) (ts : List Cert) (z : ℕ)
    (h : rowCheckAux n cy z ts = true) (i : ℕ) (hi : i < ts.length) :
    cellCheck n cy (z + i) (ts.getD i .unit) = true := by
  induction ts generalizing z i with
  | nil => simp at hi
  | cons t ts ih =>
    simp only [rowCheckAux, Bool.and_eq_true] at h
    cases i with
    | zero => simpa using h.1
    | succ i =>
      have hit : i < ts.length := by simpa using hi
      have hh := ih (z + 1) h.2 i hit
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hh

def rowCheck (n y Z : ℕ) (row : Array Cert) : Bool :=
  (List.range Z).all (fun z => cellCheck n (Nat.fast_choose (y + 5) 6) z
    (row.toList.getD z .unit))

theorem rowCheck_of_aux (n y Z : ℕ) (row : Array Cert)
    (hlen : row.toList.length = Z)
    (h : rowCheckAux n (Nat.fast_choose (y + 5) 6) 0 row.toList = true) :
    rowCheck n y Z row = true := by
  apply List.all_eq_true.mpr
  intro z hz
  have hi : z < row.toList.length := by simpa [hlen] using List.mem_range.mp hz
  have hh := rowCheckAux_get n (Nat.fast_choose (y + 5) 6) row.toList 0 h z hi
  simpa using hh

theorem all_range_next (f : ℕ → Bool) (i : ℕ)
    (h : (List.range i).all f = true) (hi : f i = true) :
    (List.range (i + 1)).all f = true := by
  simp [List.range_succ, List.all_append, h, hi]

end BinomialCertificate

namespace BinomialCertificate

structure PowerMod (a n m c : ℕ) : Prop where
  eq : a ^ n % m = c

theorem PowerMod.zero (a m : ℕ) : PowerMod a 0 m (1 % m) := ⟨rfl⟩
theorem PowerMod.bit0 (a n m c : ℕ) (h : PowerMod a n m c) :
    PowerMod a (2 * n) m (c * c % m) := by
  constructor
  rw [two_mul, pow_add, Nat.mul_mod, h.eq]

theorem PowerMod.bit1 (a n m c : ℕ) (h : PowerMod a n m c) :
    PowerMod a (2 * n + 1) m (c * c * a % m) := by
  constructor
  rw [pow_add, two_mul, pow_add, pow_one]
  simp only [Nat.mul_mod, h.eq, Nat.mod_mod]

theorem PowerMod.eq_result (a n m c r : ℕ) (h : PowerMod a n m c) (hc : c = r) :
    a ^ n % m = r := h.eq.trans hc

theorem PowerMod.ne_result (a n m c r : ℕ) (h : PowerMod a n m c) (hc : c ≠ r) :
    a ^ n % m ≠ r := ne_of_eq_of_ne h.eq hc

open Lean Meta Elab Tactic Qq

def buildPowerMod (a n m : Nat) : Nat × Expr := Id.run do
  let ae := mkNatLit a
  let me := mkNatLit m
  let mut pf := mkApp2 (mkConst ``PowerMod.zero) ae me
  let mut k := 0
  let mut c := 1 % m
  for i in (List.range (n.log2 + 1)).reverse do
    let b := n / 2 ^ i % 2
    pf := mkApp5 (mkConst (if b == 0 then ``PowerMod.bit0 else ``PowerMod.bit1))
      ae (mkNatLit k) me (mkNatLit c) pf
    k := 2*k + b
    c := (if b == 0 then c*c else c*c*a) % m
  return (c, pf)

elab "cert_pow_mod" : tactic => withMainContext do
  let goal ← getMainGoal
  let target : Q(Prop) ← goal.getType
  match target with
  | ~q(PowerMod $a $n $m $c) =>
    let a' : Q(ℕ) ← reduce a
    let n' : Q(ℕ) ← reduce n
    let m' : Q(ℕ) ← reduce m
    let (_, pf) := buildPowerMod a'.natLit! n'.natLit! m'.natLit!
    goal.assign pf
    replaceMainGoal []
  | ~q(($a : ℕ) ^ $n % $m = $r) =>
    let a' : Q(ℕ) ← reduce a
    let n' : Q(ℕ) ← reduce n
    let m' : Q(ℕ) ← reduce m
    let (cv, pf) := buildPowerMod a'.natLit! n'.natLit! m'.natLit!
    let c : Q(ℕ) ← pure (mkRawNatLit cv)
    let pf : Q(PowerMod $a' $n' $m' $c) := pf
    let heq : Q($c = $r) ← mkDecideProof q($c = $r)
    goal.assign q(PowerMod.eq_result $a' $n' $m' $c $r $pf $heq)
    replaceMainGoal []
  | ~q(($a : ℕ) ^ $n % $m ≠ $r) =>
    let a' : Q(ℕ) ← reduce a
    let n' : Q(ℕ) ← reduce n
    let m' : Q(ℕ) ← reduce m
    let (cv, pf) := buildPowerMod a'.natLit! n'.natLit! m'.natLit!
    let c : Q(ℕ) ← pure (mkRawNatLit cv)
    let pf : Q(PowerMod $a' $n' $m' $c) := pf
    let pne : Q($c ≠ $r) ← mkDecideProof q($c ≠ $r)
    goal.assign q(PowerMod.ne_result $a' $n' $m' $c $r $pf $pne)
    replaceMainGoal []
  | _ => throwError "Expected a modular power equality or inequality"


end BinomialCertificate

namespace BinomialCertificate
def NontrivialPowers (a p : ℕ) : List ℕ → Prop
  | [] => True
  | q :: qs => (∃ r, PowerMod a ((p - 1) / q) p r ∧ r ≠ 1) ∧ NontrivialPowers a p qs

theorem NontrivialPowers.mem (a p : ℕ) (qs : List ℕ) (h : NontrivialPowers a p qs)
    (q : ℕ) (hq : q ∈ qs) : ∃ r, PowerMod a ((p - 1) / q) p r ∧ r ≠ 1 := by
  induction qs with
  | nil => simp at hq
  | cons t ts ih =>
    rcases List.mem_cons.mp hq with he | hm
    · subst q; exact h.1
    · exact ih h.2 hm

theorem prime_of_pratt_cert (p a : ℕ) (qs : List ℕ) (hp : 1 < p)
    (hf : qs.prod = p - 1) (hprime : AllPrime qs)
    (ha : PowerMod a (p - 1) p 1) (hpow : NontrivialPowers a p qs) : p.Prime := by
  have ha' : modPow a (p - 1) p = 1 := by rw [modPow_sound]; exact ha.eq
  apply lucas_primality p (a : ZMod p) ((modPow_eq_one_iff a _ p hp).mp ha')
  intro q hq hqd
  have hmem : q ∈ qs := prime_mem_of_dvd_prod hq qs (AllPrime.mem qs hprime) (by simpa [hf] using hqd)
  obtain ⟨r, hr, hn⟩ := NontrivialPowers.mem a p qs hpow q hmem
  intro he
  apply hn
  have hm := (modPow_eq_one_iff a ((p - 1) / q) p hp).mpr he
  rw [modPow_sound, hr.eq] at hm
  exact hm

end BinomialCertificate

namespace BinomialCertificate
theorem AllPrime.cons (p : ℕ) (ps : List ℕ) (hp : p.Prime) (hs : AllPrime ps) :
    AllPrime (p :: ps) := ⟨hp, hs⟩

theorem NontrivialPowers.cons (a p q : ℕ) (qs : List ℕ) (r : ℕ)
    (hr : PowerMod a ((p - 1) / q) p r) (hn : r ≠ 1)
    (hs : NontrivialPowers a p qs) : NontrivialPowers a p (q :: qs) :=
  ⟨⟨r, hr, hn⟩, hs⟩

open Lean Meta Elab Tactic Qq
elab "cert_prime " a:num " [" qs:num,* "]" : tactic => withMainContext do
  let goal ← getMainGoal
  let target : Q(Prop) ← goal.getType
  let ~q(Nat.Prime $p) := target | throwError "Expected primality"
  let pe : Q(ℕ) ← reduce p
  let pn := pe.natLit!
  let an := a.getNat
  let ae : Q(ℕ) ← pure (mkRawNatLit an)
  let factors := qs.getElems.toList.map (·.getNat)
  let mut fs : List Expr := []
  let mut hprime := mkConst ``True.intro
  let mut hpows := mkConst ``True.intro
  for qn in factors.reverse do
    let qe := mkNatLit qn
    let rest ← mkListLit (mkConst ``Nat) fs
    let pq := mkConst (Name.str `BinomialCertificate s!"pp_{qn}")
    hprime := mkApp4 (mkConst ``AllPrime.cons) qe rest pq hprime
    let (rn, hr) := buildPowerMod an ((pn-1)/qn) pn
    let re : Q(ℕ) ← pure (mkRawNatLit rn)
    let hn ← mkDecideProof q($re ≠ 1)
    hpows := mkAppN (mkConst ``NontrivialPowers.cons) #[ae, pe, qe, rest, re, hr, hn, hpows]
    fs := qe :: fs
  let fl : Q(List ℕ) ← mkListLit (mkConst ``Nat) fs
  let hp ← mkDecideProof q(1 < $pe)
  let hf ← mkDecideProof q(List.prod $fl = $pe - 1)
  let (_, ha) := buildPowerMod an (pn-1) pn
  let result := mkAppN (mkConst ``prime_of_pratt_cert) #[pe, ae, fl, hp, hf, hprime, ha, hpows]
  goal.assign result
  replaceMainGoal []

end BinomialCertificate

namespace BinomialCertificate


open Lean Elab Command in
-- Batch standard elaboration to keep certificate bookkeeping bounded.
elab "certificate_block" "{" cs:command* "}" : command =>
  withEnableInfoTree false do
    for c in cs do
      elabCommand c
    discard <| IO.wait (← getEnv).checked
    trace[Elab.async] "Checked certificate batch at {cs[0]!.raw.getPos?}"

end BinomialCertificate
namespace BinomialCertificate

def pairEligible (v : ℤ × ℤ) : Bool :=
  let D := 8 * v.1 - 4 * v.2 + 5
  decide (3 ≤ v.2) && decide (v.2 % 2 = 1) && decide (9 ≤ D)

def strictlyBetween (v : ℤ × ℤ) (r : ℕ) : Bool :=
  let D := 8 * v.1 - 4 * v.2 + 5
  decide ((r : ℤ)^2 < D ∧ D < ((r : ℤ) + 1)^2)

def denySolutions : List (ℤ × ℤ) → List ℕ → Bool
  | [] => fun _ => true
  | v :: vs => fun rs =>
      if pairEligible v then
        match rs with
        | [] => false
        | r :: rest => strictlyBetween v r && denySolutions vs rest
      else denySolutions vs rs

theorem denySolutions_mem (vs : List (ℤ × ℤ)) (rs : List ℕ)
    (h : denySolutions vs rs = true) (v : ℤ × ℤ) (hv : v ∈ vs)
    (he : pairEligible v = true) : ∃ r, strictlyBetween v r = true := by
  induction vs generalizing rs with
  | nil => simp at hv
  | cons t ts ih =>
    rw [denySolutions] at h
    by_cases ht : pairEligible t = true
    · rw [ht] at h
      cases rs with
      | nil => simp at h
      | cons r rest =>
        simp only [Bool.true_eq, ↓reduceIte, Bool.and_eq_true] at h
        rcases List.mem_cons.mp hv with hvt | hvt
        · subst t; exact ⟨r, h.1⟩
        · exact ih rest h.2 hvt
    · have ht' : pairEligible t = false := by cases hh : pairEligible t <;> simp_all
      rw [ht'] at h
      simp only [Bool.false_eq_true, ↓reduceIte] at h
      rcases List.mem_cons.mp hv with hvt | hvt
      · subst t; simp [he] at ht'
      · exact ih rs h hvt

theorem representationPair_eligible (w x : ℕ) : pairEligible (representationPair w x) = true := by
  have h := representationPair_potential w x
  simp only [potentialRepresentation, Bool.and_eq_true] at h
  simpa only [pairEligible, Bool.and_eq_true] using h.1

theorem representationPair_not_between (w x r : ℕ) :
    strictlyBetween (representationPair w x) r ≠ true := by
  intro h
  dsimp [strictlyBetween] at h
  simp only [decide_eq_true_eq] at h
  rw [representationPair_discriminant] at h
  obtain ⟨h₁, h₂⟩ := h
  have hr : (0 : ℤ) ≤ r := by positivity
  have hx : (0 : ℤ) ≤ ((2*x+3 : ℕ) : ℤ) := by positivity
  have hh : (r : ℤ) < ((2*x+3 : ℕ) : ℤ) := by nlinarith
  have hh' : ((2*x+3 : ℕ) : ℤ) < (r : ℤ) + 1 := by nlinarith
  omega

theorem Cert.not_representation_fast (t : Cert) (rs : List ℕ)
    (ht : denySolutions t.solutions rs = true) (w x : ℕ) :
    norm (representationPair w x).1 (representationPair w x).2 ≠ t.value := by
  intro h
  obtain ⟨r, hr⟩ := denySolutions_mem t.solutions rs ht _ (t.complete _ _ h)
    (representationPair_eligible w x)
  exact representationPair_not_between w x r hr

end BinomialCertificate
namespace BinomialCertificate

structure Cover (m : ℤ) (vs : List (ℤ × ℤ)) : Prop where
  complete : ∀ a b : ℤ, norm a b = m → (a,b) ∈ vs

def splitImages (c d : ℤ) (v : ℤ × ℤ) : List (ℤ × ℤ) :=
  [(v.1*c-v.2*d, v.1*d+v.2*c-v.2*d), (v.1*(c-d)+v.2*d, -v.1*d+v.2*c)]

def splitCheck (c d : ℤ) : List (ℤ × ℤ) → List (ℤ × ℤ) → Bool
  | [], [] => true
  | v :: vs, a :: b :: rest =>
      decide (a = (v.1*c-v.2*d, v.1*d+v.2*c-v.2*d) ∧
        b = (v.1*(c-d)+v.2*d, -v.1*d+v.2*c)) && splitCheck c d vs rest
  | _, _ => false

theorem splitCheck_eq (c d : ℤ) (xs ys : List (ℤ × ℤ))
    (h : splitCheck c d xs ys = true) : ys = xs.flatMap (splitImages c d) := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp_all [splitCheck]
  | cons v xs ih =>
    cases ys with
    | nil => simp [splitCheck] at h
    | cons a ys =>
      cases ys with
      | nil => simp [splitCheck] at h
      | cons b ys =>
        simp only [splitCheck, Bool.and_eq_true, decide_eq_true_eq] at h
        rcases h with ⟨⟨ha, hb⟩, ht⟩
        rw [ha, hb, ih ys ht]
        rfl

def scaleCheck (p : ℕ) : List (ℤ × ℤ) → List (ℤ × ℤ) → Bool
  | [], [] => true
  | v :: vs, a :: rest =>
      decide (a = ((p : ℤ)*v.1, (p : ℤ)*v.2)) && scaleCheck p vs rest
  | _, _ => false

theorem scaleCheck_eq (p : ℕ) (xs ys : List (ℤ × ℤ))
    (h : scaleCheck p xs ys = true) : ys = xs.map (fun v => ((p : ℤ)*v.1, (p : ℤ)*v.2)) := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp_all [scaleCheck]
  | cons v xs ih =>
    cases ys with
    | nil => simp [scaleCheck] at h
    | cons a ys =>
      simp only [scaleCheck, Bool.and_eq_true, decide_eq_true_eq] at h
      rw [h.1, ih ys h.2]
      rfl

theorem Cover.unit : Cover 1 [(1,0),(-1,0),(0,1),(0,-1),(1,1),(-1,-1)] := by
  constructor
  intro a b h
  simpa only [List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] using norm_eq_one a b h

theorem Cover.split (p : ℕ) (hp : p.Prime) (c d : ℤ)
    (hcd : norm c d = p) (hd : ¬ (p : ℤ) ∣ d)
    (m : ℤ) (xs ys : List (ℤ × ℤ)) (child : Cover m xs)
    (hc : splitCheck c d xs ys = true) : Cover ((p : ℤ) * m) ys := by
  constructor
  intro a b h
  obtain ⟨e,f,he, ha | ha⟩ := split_norm_prime hp c d hcd hd a b m h
  · rw [splitCheck_eq c d xs ys hc]
    apply List.mem_flatMap.mpr
    refine ⟨(e,f), child.complete e f he, ?_⟩
    simp only [splitImages, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
    exact Or.inl ha
  · rw [splitCheck_eq c d xs ys hc]
    apply List.mem_flatMap.mpr
    refine ⟨(e,f), child.complete e f he, ?_⟩
    simp only [splitImages, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
    exact Or.inr ha

theorem Cover.scale (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2)
    (m : ℤ) (xs ys : List (ℤ × ℤ)) (child : Cover m xs)
    (hc : scaleCheck p xs ys = true) : Cover ((p : ℤ)^2 * m) ys := by
  constructor
  intro a b h
  obtain ⟨e,f,he,ha,hb⟩ := inert_divide hp hmod a b m h
  rw [scaleCheck_eq p xs ys hc]
  apply List.mem_map.mpr
  exact ⟨(e,f), child.complete e f he, by simp only; exact Prod.ext ha.symm hb.symm⟩

theorem Cover.reject (p : ℕ) (hp : p.Prime) (hmod : p % 3 = 2)
    (m : ℤ) (hm : ¬ (p : ℤ) ∣ m) : Cover ((p : ℤ)*m) [] := by
  constructor
  intro a b h
  exact (inert_reject hp hmod m hm a b h).elim

structure BinaryImpossible (k : ℕ) : Prop where
  notRep : ∀ w x : ℕ, (w+2).choose 2 + (x+3).choose 4 ≠ k

theorem BinaryImpossible.of_cover (k : ℕ) (m : ℤ) (xs : List (ℤ × ℤ)) (rs : List ℕ)
    (hc : Cover m xs) (hm : m = 6*(k : ℤ)+1) (hr : denySolutions xs rs = true) :
    BinaryImpossible k := by
  constructor
  intro w x heq
  have hn := representationPair_norm w x
  have hk : ((w+2).choose 2 : ℤ) + ((x+3).choose 4 : ℤ) = k := by exact_mod_cast heq
  rw [hk, ← hm] at hn
  obtain ⟨r, hh⟩ := denySolutions_mem xs rs hr _ (hc.complete _ _ hn) (representationPair_eligible w x)
  exact representationPair_not_between w x r hh

structure CellImpossible (n y z : ℕ) : Prop where
  notRep : ∀ w x : ℕ,
    (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n

theorem CellImpossible.of_binary (n y z cy cz k : ℕ)
    (hy : Nat.fast_choose (y+5) 6 = cy) (hz : Nat.fast_choose (z+7) 8 = cz)
    (hk : cy + cz + k = n) (hb : BinaryImpossible k) : CellImpossible n y z := by
  constructor
  intro w x heq
  have hcy : (y+5).choose 6 = cy := by rwa [Nat.choose_eq_fast_choose]
  have hcz : (z+7).choose 8 = cz := by rwa [Nat.choose_eq_fast_choose]
  rw [hcy, hcz] at heq
  exact hb.notRep w x (by omega)

theorem CellImpossible.skip (n y z cy cz : ℕ)
    (hy : Nat.fast_choose (y+5) 6 = cy) (hz : Nat.fast_choose (z+7) 8 = cz)
    (hk : n ≤ cy+cz) : CellImpossible n y z := by
  constructor
  intro w x heq
  have hcy : (y+5).choose 6 = cy := by rwa [Nat.choose_eq_fast_choose]
  have hcz : (z+7).choose 8 = cz := by rwa [Nat.choose_eq_fast_choose]
  have hw : 0 < (w+2).choose 2 := Nat.choose_pos (by omega)
  rw [hcy,hcz] at heq
  omega

inductive Segment (n y : ℕ) : ℕ → ℕ → Prop
  | nil (z : ℕ) : Segment n y z 0
  | cons (z k : ℕ) (h : CellImpossible n y z) (tail : Segment n y (z+1) k) : Segment n y z (k+1)

theorem Segment.get {n y z k : ℕ} (h : Segment n y z k) (i : ℕ) (hi : i < k) :
    CellImpossible n y (z+i) := by
  induction h generalizing i with
  | nil => omega
  | cons z k hc ht ih =>
    cases i with
    | zero => simpa using hc
    | succ i =>
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ih i (by omega)

structure RowValid (n y Z : ℕ) : Prop where
  get : ∀ z < Z, CellImpossible n y z

theorem RowValid.of_segment (n y Z : ℕ) (h : Segment n y 0 Z) : RowValid n y Z := by
  constructor
  intro z hz
  simpa using h.get z hz

inductive RowSegment (n Z : ℕ) : ℕ → ℕ → Prop
  | nil (y : ℕ) : RowSegment n Z y 0
  | cons (y k : ℕ) (h : RowValid n y Z) (tail : RowSegment n Z (y+1) k) : RowSegment n Z y (k+1)

theorem RowSegment.get {n Z y k : ℕ} (h : RowSegment n Z y k) (i : ℕ) (hi : i < k) :
    RowValid n (y+i) Z := by
  induction h generalizing i with
  | nil => omega
  | cons y k hc ht ih =>
    cases i with
    | zero => simpa using hc
    | succ i =>
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ih i (by omega)

theorem zero_of_rowSegment (n Y Z : ℕ) (h : RowSegment n Z 0 Y)
    (hY : n < (Y+5).choose 6) (hZ : n < (Z+7).choose 8) : A306477 n = 0 := by
  by_contra hn
  obtain ⟨w,x,y,z,he⟩ := (A306477_pos_iff_representation n).mp (Nat.pos_of_ne_zero hn)
  have hy : y < Y := by
    by_contra hh
    have hc := Nat.choose_le_choose 6 (show Y+5 ≤ y+5 by omega)
    omega
  have hz : z < Z := by
    by_contra hh
    have hc := Nat.choose_le_choose 8 (show Z+7 ≤ z+7 by omega)
    omega
  have hh : RowValid n y Z := by simpa using h.get y hy
  exact (hh.get z hz).notRep w x he

end BinomialCertificate
