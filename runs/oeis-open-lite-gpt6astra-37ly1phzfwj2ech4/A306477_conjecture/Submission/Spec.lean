theorem no_representation : ¬ ∃ w x y z : ℕ,
    (w + 2).choose 2 + (x + 3).choose 4 + (y + 5).choose 6 + (z + 7).choose 8 = N :=
  no_representation_from_sieve mods mods_good rows_good

end Counter2468

theorem A306477_pos_iff_bounded (n : ℕ) : A306477 n > 0 ↔
    ∃ w ≤ n, ∃ x ≤ n, ∃ y ≤ n, ∃ z ≤ n,
      (w + 2).choose 2 + (x + 3).choose 4 + (y + 5).choose 6 +
        (z + 7).choose 8 = n := by
  simp only [A306477, Finset.sum_pos_iff, Finset.mem_range, Nat.lt_succ_iff]
  have h (p : Prop) [Decidable p] : (0 < if p then (1 : ℕ) else 0) ↔ p := by
    split_ifs <;> simp_all
  simp only [h]


theorem A306477_conjecture.disproof : ¬ (type_of% @A306477_conjecture) := by
  intro h
  have hn : Counter2468.N > 0 := by decide +kernel
  have hp := h Counter2468.N hn
  obtain ⟨w, _, x, _, y, _, z, _, heq⟩ :=
    (A306477_pos_iff_bounded Counter2468.N).mp hp
  exact Counter2468.no_representation ⟨w, x, y, z, heq⟩

