-- Fast integer-valued versions of the three higher-order binomial terms.
def p4 (x : ℕ) : ℕ := x * (x + 1) * (x + 2) * (x + 3) / 24
def p6 (y : ℕ) : ℕ := y * (y + 1) * (y + 2) * (y + 3) * (y + 4) * (y + 5) / 720
def p8 (z : ℕ) : ℕ := z * (z + 1) * (z + 2) * (z + 3) * (z + 4) * (z + 5) *
  (z + 6) * (z + 7) / 40320

lemma p4_eq (x : ℕ) : p4 x = (x + 3).choose 4 := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (x + 3) 4
  norm_num [Nat.descFactorial_succ] at h
  rw [show x + 3 - 2 = x + 1 by omega] at h
  unfold p4
  have he : x * (x + 1) * (x + 2) * (x + 3) = 24 * (x + 3).choose 4 := by
    nlinarith
  rw [he, Nat.mul_div_right _ (by decide : 0 < 24)]

lemma p6_eq (y : ℕ) : p6 y = (y + 5).choose 6 := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (y + 5) 6
  norm_num [Nat.descFactorial_succ] at h
  rw [show y + 5 - 4 = y + 1 by omega, show y + 5 - 3 = y + 2 by omega,
    show y + 5 - 2 = y + 3 by omega] at h
  unfold p6
  have he : y * (y + 1) * (y + 2) * (y + 3) * (y + 4) * (y + 5) =
      720 * (y + 5).choose 6 := by nlinarith
  rw [he, Nat.mul_div_right _ (by decide : 0 < 720)]

lemma p8_eq (z : ℕ) : p8 z = (z + 7).choose 8 := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (z + 7) 8
  norm_num [Nat.descFactorial_succ] at h
  rw [show z + 7 - 6 = z + 1 by omega, show z + 7 - 5 = z + 2 by omega,
    show z + 7 - 4 = z + 3 by omega, show z + 7 - 3 = z + 4 by omega,
    show z + 7 - 2 = z + 5 by omega] at h
  unfold p8
  have he : z * (z + 1) * (z + 2) * (z + 3) * (z + 4) * (z + 5) * (z + 6) * (z + 7) =
      40320 * (z + 7).choose 8 := by nlinarith
  rw [he, Nat.mul_div_right _ (by decide : 0 < 40320)]

lemma mul_p4 (x : ℕ) : 24 * p4 x = x * (x + 1) * (x + 2) * (x + 3) := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (x + 3) 4
  norm_num [Nat.descFactorial_succ] at h
  rw [show x + 3 - 2 = x + 1 by omega, ← p4_eq] at h
  nlinarith

lemma p4_mod_period (p x : ℕ) (hc : p.Coprime 24) :
    (8 * p4 (x % p)) % p = (8 * p4 x) % p := by
  have h0 : x % p ≡ x [MOD p] := Nat.mod_mod x p
  have h1 := h0.add (Nat.ModEq.refl 1)
  have h2 := h0.add (Nat.ModEq.refl 2)
  have h3 := h0.add (Nat.ModEq.refl 3)
  have hprod := ((h0.mul h1).mul h2).mul h3
  rw [← mul_p4, ← mul_p4] at hprod
  exact (Nat.ModEq.cancel_left_of_coprime hc hprod).mul_left 8

def repeatBits (v p : ℕ) : ℕ → ℕ
  | 0 => v
  | d + 1 => let w := repeatBits v p d; w + (w <<< (p * 2 ^ d))

lemma repeatBits_lt (v p d : ℕ) (hv : v < 2 ^ p) :
    repeatBits v p d < 2 ^ (p * 2 ^ d) := by
  induction d with
  | zero => simpa only [repeatBits, pow_zero, mul_one] using hv
  | succ d ih =>
    simp only [repeatBits, Nat.shiftLeft_eq]
    have he : p * 2 ^ (d + 1) = (p * 2 ^ d) * 2 := by ring
    have he2 : 2 ^ (p * 2 ^ (d + 1)) = (2 ^ (p * 2 ^ d)) ^ 2 := by rw [he, pow_mul]
    rw [he2]
    nlinarith [Nat.mul_le_mul_right (2 ^ (p * 2 ^ d) + 1) (Nat.succ_le_iff.mpr ih)]

lemma repeatBits_mul (v p d : ℕ) : repeatBits v p d = v * repeatBits 1 p d := by
  induction d with
  | zero => simp [repeatBits]
  | succ d ih => simp only [repeatBits, Nat.shiftLeft_eq, ih]; ring

lemma repeatBits_testBit (v p d i : ℕ) (hv : v < 2 ^ p) :
    (repeatBits v p d).testBit i = (if i < p * 2 ^ d then v.testBit (i % p) else false) := by
  induction d generalizing i with
  | zero =>
    simp only [repeatBits, pow_zero, mul_one]
    by_cases hi : i < p
    · rw [if_pos hi, Nat.mod_eq_of_lt hi]
    · rw [if_neg hi]
      exact Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hv (Nat.pow_le_pow_right (by decide) (by omega)))
  | succ d ih =>
    have heval : repeatBits v p (d + 1) =
        2 ^ (p * 2 ^ d) * repeatBits v p d + repeatBits v p d := by
      simp only [repeatBits, Nat.shiftLeft_eq]; ring
    rw [heval, Nat.testBit_two_pow_mul_add _ (repeatBits_lt v p d hv)]
    simp only [ih]
    have he : p * 2 ^ (d + 1) = p * 2 ^ d * 2 := by ring
    rw [he]
    by_cases hi : i < p * 2 ^ d
    · have hi2 : i < p * 2 ^ d * 2 := by omega
      simp [hi, hi2]
    · have hni : p * 2 ^ d ≤ i := by omega
      have he' : i - p * 2 ^ d < p * 2 ^ d ↔ i < p * 2 ^ d * 2 := by omega
      have hm : (i - p * 2 ^ d) % p = i % p := by
        have h := congrArg (fun n => n % p) (Nat.sub_add_cancel hni)
        simpa only [Nat.add_mod, Nat.mul_mod_right, add_zero, Nat.mod_mod] using h
      simp [hi, he', hm]

structure Modulus where
  p : ℕ
  qr : ℕ
  depth : ℕ
  factor : ℕ
  base : ℕ → ℕ

def residue (p r c : ℕ) : ℕ := (r + p - c % p) % p

def bitPredicate (m : Modulus) (r x : ℕ) : Bool :=
  m.qr.testBit (residue m.p r (8 * p4 x))

lemma bitPredicate_period (m : Modulus) (hc : m.p.Coprime 24) (r x : ℕ) :
    bitPredicate m r (x % m.p) = bitPredicate m r x := by
  unfold bitPredicate residue
  rw [p4_mod_period m.p x hc]

def goodCheck (m : Modulus) : Bool :=
  decide (0 < m.p) && decide (m.p.Coprime 24) && decide (12110 ≤ m.p * 2 ^ m.depth) &&
    (m.factor == repeatBits 1 m.p m.depth) &&
    ((List.range m.p).all fun t => m.qr.testBit (t ^ 2 % m.p)) &&
    ((List.range m.p).all fun r =>
      decide (m.base r < 2 ^ m.p) &&
      ((List.range m.p).all fun x => (m.base r).testBit x == bitPredicate m r x))

def Good (m : Modulus) : Prop :=
  0 < m.p ∧ m.p.Coprime 24 ∧ 12110 ≤ m.p * 2 ^ m.depth ∧
    m.factor = repeatBits 1 m.p m.depth ∧
    (∀ t < m.p, m.qr.testBit (t ^ 2 % m.p) = true) ∧
    (∀ r < m.p, m.base r < 2 ^ m.p ∧
      (∀ x < m.p, (m.base r).testBit x = bitPredicate m r x))

lemma goodCheck_sound (m : Modulus) (h : goodCheck m = true) : Good m := by
  simpa only [goodCheck, Good, Bool.and_eq_true, decide_eq_true_eq,
    List.all_eq_true, List.mem_range, beq_iff_eq, and_assoc] using h

def mask (m : Modulus) (r : ℕ) : ℕ := m.base r * m.factor

lemma residue_eq_square (p r t c : ℕ) (hp : 0 < p) (h : t ^ 2 + c = r) :
    residue p (r % p) c = t ^ 2 % p := by
  unfold residue
  rw [← h, Nat.add_mod]
  have ha := Nat.mod_lt (t ^ 2) hp
  have hb := Nat.mod_lt c hp
  by_cases hab : t ^ 2 % p + c % p < p
  · rw [Nat.mod_eq_of_lt hab]
    have he : t ^ 2 % p + c % p + p - c % p = t ^ 2 % p + p := by omega
    rw [he, Nat.add_mod, Nat.mod_self, add_zero]
    simp only [Nat.mod_mod]
  · have he : (t ^ 2 % p + c % p) % p = t ^ 2 % p + c % p - p := by
      rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
    rw [he]
    have he' : t ^ 2 % p + c % p - p + p - c % p = t ^ 2 % p := by omega
    rw [he', Nat.mod_mod]

lemma mask_keeps_solution (m : Modulus) (hm : Good m) (r t x : ℕ)
    (hx : x < 12110) (h : t ^ 2 + 8 * p4 x = r) :
    (mask m (r % m.p)).testBit x = true := by
  have hr := hm.2.2.2.2.2 (r % m.p) (Nat.mod_lt _ hm.1)
  rw [mask, hm.2.2.2.1, ← repeatBits_mul, repeatBits_testBit _ _ _ _ hr.1,
    if_pos (lt_of_lt_of_le hx hm.2.2.1)]
  rw [hr.2 _ (Nat.mod_lt _ hm.1), bitPredicate_period m hm.2.1]
  unfold bitPredicate
  rw [residue_eq_square m.p r t (8 * p4 x) hm.1 h]
  have hqr := hm.2.2.2.2.1 (t % m.p) (Nat.mod_lt _ hm.1)
  rw [← Nat.pow_mod] at hqr
  exact hqr

def sift : List Modulus → ℕ → ℕ → ℕ
  | [], _, acc => acc
  | m :: ms, r, acc => if acc = 0 then 0 else sift ms r (acc &&& mask m (r % m.p))

lemma sift_keeps_solution (ms : List Modulus) (hms : ∀ m ∈ ms, Good m)
    (r t x acc : ℕ) (hx : x < 12110) (h : t ^ 2 + 8 * p4 x = r)
    (ha : acc.testBit x = true) : (sift ms r acc).testBit x = true := by
  induction ms generalizing acc with
  | nil => exact ha
  | cons m ms ih =>
    have ha0 : acc ≠ 0 := by intro he; subst acc; simp at ha
    simp only [sift, if_neg ha0]
    apply ih (fun m hm => hms m (by simp [hm]))
    rw [Nat.testBit_land, ha, mask_keeps_solution m (hms m (by simp)) r t x hx h]
    rfl

def sieve (ms : List Modulus) (r : ℕ) : ℕ := sift ms r (2 ^ 12110 - 1)

lemma sieve_nonzero (ms : List Modulus) (hms : ∀ m ∈ ms, Good m)
    (r t x : ℕ) (hx : x < 12110) (h : t ^ 2 + 8 * p4 x = r) : sieve ms r ≠ 0 := by
  have ht := sift_keeps_solution ms hms r t x (2 ^ 12110 - 1) hx h
    (by simp only [Nat.testBit_two_pow_sub_one, hx, decide_true])
  intro he
  rw [show sift ms r (2 ^ 12110 - 1) = 0 from he] at ht
  simp at ht

def checkRow (ms : List Modulus) (n z : ℕ) : Bool :=
  let bz := p8 z
  (List.range 928).all fun y =>
    if n ≤ p6 y + bz then true else sieve ms (8 * (n - p6 y - bz) + 1) == 0

lemma checkRow_sound (ms : List Modulus) (n z : ℕ) (h : checkRow ms n z = true)
    (y : ℕ) (hy : y < 928) (hs : p6 y + p8 z < n) :
    sieve ms (8 * (n - p6 y - p8 z) + 1) = 0 := by
  have hh := (List.all_eq_true.mp h) y (List.mem_range.mpr hy)
  simpa only [show ¬ n ≤ p6 y + p8 z by omega, if_false, beq_iff_eq] using hh


def N : ℕ := 896315812331399

lemma eight_mul_choose (w : ℕ) :
    8 * (w + 2).choose 2 + 1 = (2 * w + 3) ^ 2 := by
  have h := Nat.descFactorial_eq_factorial_mul_choose (w + 2) 2
  norm_num [Nat.descFactorial_succ] at h
  nlinarith

lemma no_representation_from_sieve (ms : List Modulus) (hms : ∀ m ∈ ms, Good m)
    (hrows : ∀ z < 275, checkRow ms N z = true) :
    ¬ ∃ w x y z : ℕ, (w + 2).choose 2 + (x + 3).choose 4 +
      (y + 5).choose 6 + (z + 7).choose 8 = N := by
  rintro ⟨w, x, y, z, h⟩
  have heq : (w + 2).choose 2 + p4 x + p6 y + p8 z = N := by
    simpa only [p4_eq, p6_eq, p8_eq] using h
  have hxlarge : N < p4 12110 := by decide +kernel
  have hylarge : N < p6 928 := by decide +kernel
  have hzlarge : N < p8 275 := by decide +kernel
  have hx : x < 12110 := by
    by_contra hh
    have hc : p4 12110 ≤ p4 x := by
      simp only [p4_eq]
      exact Nat.choose_le_choose 4 (by omega)
    omega
  have hy : y < 928 := by
    by_contra hh
    have hc : p6 928 ≤ p6 y := by
      simp only [p6_eq]
      exact Nat.choose_le_choose 6 (by omega)
    omega
  have hz : z < 275 := by
    by_contra hh
    have hc : p8 275 ≤ p8 z := by
      simp only [p8_eq]
      exact Nat.choose_le_choose 8 (by omega)
    omega
  have htpos : 0 < (w + 2).choose 2 := Nat.choose_pos (by omega)
  have hs : p6 y + p8 z < N := by omega
  have ht := eight_mul_choose w
  have hr : (2 * w + 3) ^ 2 + 8 * p4 x = 8 * (N - p6 y - p8 z) + 1 := by omega
  have hnz := sieve_nonzero ms hms _ (2 * w + 3) x hx hr
  exact hnz (checkRow_sound ms N z (hrows z hz) y hy hs)


