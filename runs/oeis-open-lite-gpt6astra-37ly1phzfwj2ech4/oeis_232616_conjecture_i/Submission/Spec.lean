set_option maxHeartbeats 0

/- The counterexample is n = 550172 = 4 * 7^3 * 401.
   We certify a prime-index bound and the absence of residue 63945 below 2^24.
   All finite certificates below are checked by the Lean kernel. -/

-- The product used for trial division.  Its covering property is checked below.
private def smallProduct : ℕ := 

private def primeTest (n : ℕ) : Bool := decide (3000 < n) && (Nat.gcd smallProduct n == 1)

private theorem smallProduct_cover : ∀ d : Fin 3001,
    2 ≤ d.val → Nat.gcd smallProduct d.val ≠ 1 := by
  decide +kernel

private theorem primeTest_sound {n : ℕ} (hn : n < 8388608)
    (h : primeTest n = true) : Nat.Prime n := by
  simp only [primeTest, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  apply Nat.prime_def_le_sqrt.mpr
  refine ⟨by omega, ?_⟩
  intro d hd hds hdn
  have hs : Nat.sqrt 8388608 ≤ 3000 :=
    Nat.le_of_lt_succ (Nat.sqrt_lt.mpr (by decide))
  have hd' : d < 3001 := by
    have := Nat.sqrt_le_sqrt hn.le
    omega
  have hcop : Nat.Coprime smallProduct n := h.2
  exact smallProduct_cover ⟨d,hd'⟩ hd (hcop.of_dvd_right hdn)


-- This cardinality formulation keeps arithmetic proofs independent of the
-- executable prime-counting function; the following lemma identifies the two.
private noncomputable def primeCount (n : ℕ) : ℕ := Nat.card {i : ℕ // i < n ∧ Nat.Prime i}

private theorem primeCount_eq (n : ℕ) : primeCount n = Nat.count Nat.Prime n := by
  letI := Nat.CountSet.fintype Nat.Prime n
  exact Nat.card_eq_fintype_card.trans (Nat.count_eq_card_fintype Nat.Prime n).symm

private theorem primeCount_mono {a b : ℕ} (h : a ≤ b) : primeCount a ≤ primeCount b := by
  simpa only [primeCount_eq] using Nat.count_monotone Nat.Prime h

private theorem primeCount_succ (n : ℕ) :
    primeCount (n+1) = primeCount n + if Nat.Prime n then 1 else 0 := by
  simpa only [primeCount_eq] using Nat.count_succ Nat.Prime n



-- The hexadecimal certificates pack increasing primes into 24-bit fields.
-- The checker verifies coprimality and the ordering at every binary split.
private def packedPrime (code i : ℕ) : ℕ := (code >>> (24*i)) % 16777216

private def packedCheck (code i : ℕ) : ℕ → Bool
| 0 => Nat.gcd smallProduct (packedPrime code i) == 1
| d+1 => packedCheck code i d && packedCheck code (i+2^d) d &&
    decide (packedPrime code (i+2^d-1) < packedPrime code (i+2^d))

private theorem packed_ordered (code d i : ℕ) (h : packedCheck code i d = true) :
    packedPrime code i ≤ packedPrime code (i+2^d-1) := by
  induction d generalizing i with
  | zero => simp
  | succ d ih =>
    simp only [packedCheck, Bool.and_eq_true, decide_eq_true_eq] at h
    have ha := ih i h.1.1
    have hb := ih (i+2^d) h.1.2
    have he : i+2^(d+1)-1 = (i+2^d)+2^d-1 := by rw [pow_succ]; omega
    rw [he]
    exact ha.trans (h.2.le.trans hb)

private theorem packed_bound (code d i : ℕ) (h : packedCheck code i d = true)
    (hl : 3000 < packedPrime code i) (hh : packedPrime code (i+2^d-1) < 8388608) :
    primeCount (packedPrime code i) + 2^d ≤ primeCount (packedPrime code (i+2^d-1)+1) := by
  induction d generalizing i with
  | zero =>
    simp only [pow_zero, Nat.add_sub_cancel] at hh ⊢
    have hp : Nat.Prime (packedPrime code i) := primeTest_sound hh (by
      simp only [primeTest, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨hl,h⟩)
    rw [primeCount_succ, if_pos hp]
  | succ d ih =>
    simp only [packedCheck, Bool.and_eq_true, decide_eq_true_eq] at h
    have ha := packed_ordered code d i h.1.1
    have hb := packed_ordered code d (i+2^d) h.1.2
    have he : i+2^(d+1)-1 = (i+2^d)+2^d-1 := by rw [pow_succ]; omega
    rw [he] at hh ⊢
    have hal := ih i h.1.1 hl (by omega)
    have hbl := ih (i+2^d) h.1.2 (by omega) hh
    have hm : primeCount (packedPrime code (i+2^d-1)+1) ≤
        primeCount (packedPrime code (i+2^d)) := primeCount_mono (by omega)
    rw [pow_succ, Nat.mul_two]
    omega

private theorem packed_block_bound (code lo hi d : ℕ)
    (hlo : packedPrime code 0 = lo) (hhi : packedPrime code (2^d-1) = hi)
    (hc : packedCheck code 0 d = true) (hl : 3000 < lo) (hh : hi < 8388608) :
    primeCount lo + 2^d ≤ primeCount (hi+1) := by
  have h := packed_bound code d 0 hc (hlo ▸ hl) (by simpa only [Nat.zero_add, hhi] using hh)
  simpa only [Nat.zero_add, hlo, hhi] using h

private theorem primeCount_chain (a b c s l : ℕ)
    (hprev : s ≤ primeCount a) (hsep : a ≤ b)
    (hblock : primeCount b+l ≤ primeCount c) : s+l ≤ primeCount c :=
  (Nat.add_le_add_right (hprev.trans (primeCount_mono hsep)) l).trans hblock

