private theorem residues_exist (r : ℕ) (hr : r < 550172) :
    ∃ k, 1 ≤ k ∧ (2^k-k)%550172 = r := by
  let s := seed (r%196)
  have hs := seed_spec ⟨r%196, Nat.mod_lt _ (by decide)⟩
  change 2 ≤ s ∧ s < 29400 ∧ (2^s-s)%196 = r%196 at hs
  have hs2 : s ≤ 2^s := Nat.lt_two_pow_self.le
  have hc : Nat.ModEq (Nat.gcd 29400 550172) s (2^s+550172-r) := by
    change s%196 = (2^s+550172-r)%196
    omega
  let x := Nat.chineseRemainder' hc
  have hx₁ : x.val % 29400 = s % 29400 := x.property.1
  have hx₂ : x.val % 550172 = (2^s+550172-r)%550172 := x.property.2
  have hxs : x.val = s+29400*(x.val/29400) := by omega
  have hxpos : 2 ≤ x.val := by omega
  have hp : 2^x.val % 550172 = 2^s % 550172 := by
    have h := pow_period_general 550172 2 2 29400 (s-2) (x.val/29400) pow_start_period
    have he : 2+(s-2) = s := by omega
    simpa only [he, ← hxs] using h
  refine ⟨x.val, by omega, ?_⟩
  have hxpow : x.val ≤ 2^x.val := Nat.lt_two_pow_self.le
  omega

private theorem complete_exists : ∃ m, A232616_prop 550172 m := by
  classical
  choose k hk he using fun r : ZMod 550172 => residues_exist r.val (ZMod.val_lt r)
  refine ⟨Finset.univ.sup k, ?_⟩
  apply Finset.Subset.antisymm
  · intro r hr
    apply Finset.mem_image.mpr
    refine ⟨k r, Finset.mem_Icc.mpr ⟨hk r, Finset.le_sup (f := k) hr⟩, ?_⟩
    apply ZMod.val_injective
    simpa only [ZMod.val_natCast] using he r
  · exact Finset.subset_univ _

/--
Conjecture (i): $a(n) < 2 \cdot (\text{prime}(n) - 1)$ for all $n > 0$,
where $\text{prime}(n)$ is the $n$-th prime number (1-indexed).
-/
theorem oeis_232616_conjecture_i (n : ℕ) (hn : 0 < n) :
    A232616 n < 2 * (Nat.nth Nat.Prime (n - 1) - 1) := by
  sorry

theorem oeis_232616_conjecture_i.disproof : ¬ (type_of% @oeis_232616_conjecture_i) := by
  intro h
