-- A modular-period certificate for the missing residue.
private def modPow (n b e : ℕ) : ℕ → ℕ
| 0 => 1 % n
| f+1 =>
  let v := modPow n b (e/2) f
  if e % 2 = 0 then (v*v)%n else (v*v*b)%n

private theorem modPow_spec (n b e f : ℕ) (he : e < 2^f) :
    modPow n b e f = b^e % n := by
  induction f generalizing e with
  | zero =>
    have : e = 0 := by simpa using he
    subst e
    rfl
  | succ f ih =>
    have hd : e/2 < 2^f := by
      simp only [pow_succ, Nat.mul_two] at he
      omega
    have hh := ih (e/2) hd
    have heq : e = e/2+e/2+e%2 := by omega
    rcases Nat.mod_two_eq_zero_or_one e with h | h
    · rw [modPow, if_pos h, hh]
      conv_rhs => rw [heq, h, Nat.add_zero, pow_add]
      exact (Nat.mul_mod _ _ _).symm
    · rw [modPow, if_neg (by omega), hh]
      conv_rhs => rw [heq, h, pow_add, pow_add, pow_one]
      simp only [Nat.mul_mod, Nat.mod_mod]

-- Write k = j + 2 + 29400*q.  Since gcd(29400,550172) = 196,
-- a hit requires b % 196 = 0.  The inverse of 150 modulo 2807 is 131,
-- so the least possible q is (b / 196 * 131) % 2807.
private def rawMissingCheck (j : ℕ) : Bool :=
  let b := (modPow 550172 2 (j+2) 16 + 550172 - (j+2+63945)%550172)%550172
  (b % 196 != 0) || decide (16777216 ≤ j+2+29400*((b/196*131)%2807))

