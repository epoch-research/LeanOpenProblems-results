  if j%588 = 181 ∨ j%588 = 413 ∨ j%588 = 429 then rawMissingCheck j else true

private def allBlock (test : ℕ → Bool) (lo : ℕ) : ℕ → Bool
| 0 => test lo
| k+1 => allBlock test lo k && allBlock test (lo+2^k) k

private theorem allBlock_spec (test : ℕ → Bool) (lo k : ℕ)
    (h : allBlock test lo k = true) :
    ∀ i, lo ≤ i → i < lo+2^k → test i = true := by
  induction k generalizing lo with
  | zero =>
    intro i hi hi'
    have : i = lo := by omega
    subst i
    exact h
  | succ k ih =>
    simp only [allBlock, Bool.and_eq_true] at h
    intro i hi hi'
    by_cases hl : i < lo+2^k
    · exact ih lo h.1 i hi hl
    · apply ih (lo+2^k) h.2 i (by omega)
      simp only [pow_succ, Nat.mul_two] at hi'
      omega

private theorem allBlock_join (test : ℕ → Bool) (lo k : ℕ)
    (ha : allBlock test lo k = true) (hb : allBlock test (lo+2^k) k = true) :
    allBlock test lo (k+1) = true := by
  change (allBlock test lo k && allBlock test (lo+2^k) k) = true
  rw [ha, hb]
  rfl

