private theorem pow_start_period : Nat.ModEq 550172 (2^(2+29400)) (2^2) := by
  change 2^(2+29400)%550172 = 2^2%550172
  rw [← modPow_spec 550172 2 (2+29400) 16 (by norm_num)]
  decide +kernel

private lemma pow_period_general (n a s D j q : ℕ)
    (h : Nat.ModEq n (a^(s+D)) (a^s)) :
    Nat.ModEq n (a^(s+j+D*q)) (a^(s+j)) := by
  induction q with
  | zero => simp [Nat.ModEq]
  | succ q ih =>
    have hmul := h.mul_right (a^(j+D*q))
    rw [← pow_add, ← pow_add] at hmul
    have hmul' : Nat.ModEq n (a^(s+j+D*(q+1))) (a^(s+j+D*q)) := by
      convert hmul using 1 <;> congr 1 <;> ring
    exact hmul'.trans ih

private theorem index_certificate : ∀ t : Fin 588,
    (2^(t.val+2)-(t.val+2))%196 = 49 →
      t.val = 181 ∨ t.val = 413 ∨ t.val = 429 := by
  decide +kernel

private theorem small_period : Nat.ModEq 196 (2^(2+588)) (2^2) := by
  decide +kernel

private theorem necessary_index (k : ℕ) (hk : 2 ≤ k)
    (heq : (2^k-k)%550172 = 63945) :
    (k-2)%588 = 181 ∨ (k-2)%588 = 413 ∨ (k-2)%588 = 429 := by
  let t := (k-2)%588
  let q := (k-2)/588
  have ht : t < 588 := Nat.mod_lt _ (by decide)
  have hkt : k = t+2+588*q := by dsimp [t,q]; omega
  have hp : 2^k%196 = 2^(t+2)%196 := by
    have h := pow_period_general 196 2 2 588 t q small_period
    simpa only [Nat.add_comm 2 t, ← hkt] using h
  have hA : k ≤ 2^k := Nat.lt_two_pow_self.le
  have ha : t+2 ≤ 2^(t+2) := Nat.lt_two_pow_self.le
  have hr : (2^k-k)%196 = 49 := by omega
  have htq : (2^(t+2)-(t+2))%196 = 49 := by omega
  exact index_certificate ⟨t,ht⟩ htq

private theorem missing_residue (k : ℕ) (hk : 1 ≤ k) (hbound : k < 16777216) :
    (2^k-k) % 550172 ≠ 63945 := by
  intro heq
  by_cases hsmall : k < 2
  · have : k = 1 := by omega
    subst k
    norm_num at heq
  let j := (k-2) % 29400
  let q := (k-2) / 29400
  have hj : j < 29400 := Nat.mod_lt _ (by decide)
  have hk' : k = j+2+29400*q := by
    dsimp [j, q]
    omega
  have hq : q ≤ 570 := by omega
  have hp : 2^k % 550172 = 2^(j+2) % 550172 := by
    have h := pow_period_general 550172 2 2 29400 j q pow_start_period
    simpa only [Nat.add_comm 2 j, ← hk'] using h
  have hA : k ≤ 2^k := Nat.lt_two_pow_self.le
  have ha : j+2 ≤ 2^(j+2) := Nat.lt_two_pow_self.le
  have hmp := modPow_spec 550172 2 (j+2) 16 (by norm_num; omega)
  let b := (modPow 550172 2 (j+2) 16 + 550172 - (j+2+63945)%550172)%550172
  have hb : b = 29400*q % 550172 := by dsimp [b]; omega
  have hbq : b % 196 = 0 ∧ (b/196*131)%2807 = q := by omega
  have hneed := necessary_index k (by omega) heq
  have hgood : j%588 = 181 ∨ j%588 = 413 ∨ j%588 = 429 := by
    dsimp [j]
    omega
  have hc := missing_cert ⟨j,hj⟩ hgood
  change ((b % 196 != 0) || decide (16777216 ≤ j+2+29400*((b/196*131)%2807))) = true at hc
  simp only [hbq.1, bne_self_eq_false, Bool.false_or, decide_eq_true_eq, hbq.2] at hc
  omega

