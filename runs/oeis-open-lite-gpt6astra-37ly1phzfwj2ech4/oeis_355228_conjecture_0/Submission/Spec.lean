def lookupRec (m : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, lo, _ => lo
  | f+1, lo, hi =>
    if lo+1 < hi then
      let mid := (lo+hi)/2
      if recN mid ≤ m then lookupRec m f mid hi else lookupRec m f lo mid
    else lo

def chooseRec (m : ℕ) := lookupRec m 10 0 796
noncomputable def dominanceCheck (r : ℕ) : Bool := (enumVectors r).all fun es =>
  let i := chooseRec (fastNumber 0 es)
  decide (i < 796 ∧ recN i ≤ fastNumber 0 es ∧ fastCount es ≤ recC i)
lemma dominance_0 : dominanceCheck 0 = true := by decide +kernel
lemma dominance_1 : dominanceCheck 1 = true := by decide +kernel
lemma dominance_2 : dominanceCheck 2 = true := by decide +kernel
lemma dominance_3 : dominanceCheck 3 = true := by decide +kernel
