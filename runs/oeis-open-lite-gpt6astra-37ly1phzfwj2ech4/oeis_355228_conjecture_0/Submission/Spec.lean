namespace Solution
open Finset Nat

lemma primeAt_le_pow (i : ℕ) : primeAt i ≤ 2^(i+1) := by
  induction i with
  | zero => simp [primeAt_zero]
  | succ i ih =>
    have := primeAt_succ_le i
    calc
      primeAt (i+1) ≤ 2*primeAt i := this
      _ ≤ 2*2^(i+1) := Nat.mul_le_mul_left 2 ih
      _ = 2^(i+1+1) := by ring

lemma tailCount_lower {es : List ℕ} (he : ∀ i, i < es.length → 0 < es.getD i 0) (k : ℕ) :
    2^(es.length-k) ≤ tailCount es k := by
  calc
    2^(es.length-k) = ∏ _i ∈ Finset.range (es.length-k), (2 : ℕ) := by simp
    _ ≤ _ := Finset.prod_le_prod' fun i hi => by
      have := he (i+k) (by have := Finset.mem_range.mp hi; omega)
      omega

lemma tailNumber_lower {es : List ℕ} (he : ∀ i, i < es.length → 0 < es.getD i 0) :
    4^(es.length-2) ≤ tailNumber es 2 := by
  calc
    4^(es.length-2) = ∏ _i ∈ Finset.range (es.length-2), (4 : ℕ) := by simp
    _ ≤ _ := Finset.prod_le_prod' fun i hi => by
      have hepos := he (i+2) (by have := Finset.mem_range.mp hi; omega)
      have hp : 4 ≤ primeAt (i+2) := by
        have := primeAt_strictMono.monotone (show 2 ≤ i+2 by omega)
        change 5 ≤ primeAt (i+2) at this
        omega
      exact hp.trans (Nat.le_self_pow (by omega) _)

lemma smallest_cost_bound {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hr : 25 ≤ es.length) :
    coinCost es ≤ 8*es.length^3 := by
  let r := es.length
  have hf : (number es).factorization 2 = es.getD 0 0 := by
    simpa [primeAt_zero, show 0 < es.length by omega] using factorization_number es 0
  have ha := h.exponent_two_upper (number_prefix he) hr
  rw [hf] at ha
  have ha2 : es.getD 0 0 ≤ 2*r := by dsimp [r]; omega
  have heb : ∀ i, i < r → es.getD i 0 ≤ 2*r := by
    intro i hi
    by_cases hiz : i=0
    · simpa [hiz] using ha2
    · have hh := h.antitone Nat.prime_two (primeAt_prime i)
        (by simpa [primeAt_zero] using primeAt_strictMono (show 0 < i by omega))
      rw [hf, factorization_number, if_pos hi] at hh
      exact hh.trans ha2
  have hlb : ∀ i, i < r → Nat.log 2 (primeAt i)+1 ≤ r+1 := by
    intro i hi
    have hp : primeAt i ≤ 2^r := (primeAt_le_pow i).trans
      (Nat.pow_le_pow_right (by decide) (by omega))
    have hh := Nat.log_mono_right (b:=2) hp
    rw [Nat.log_pow (by decide : 1 < 2)] at hh
    omega
  have hsum : (∑ i ∈ Finset.range (r-1), es.getD (i+1) 0 * (Nat.log 2 (primeAt (i+1))+1))
      ≤ (r-1)*(2*r*(r+1)) := by
    calc
      _ ≤ ∑ _i ∈ Finset.range (r-1), 2*r*(r+1) := Finset.sum_le_sum fun i hi =>
        Nat.mul_le_mul (heb (i+1) (by have := Finset.mem_range.mp hi; omega))
          (hlb (i+1) (by have := Finset.mem_range.mp hi; omega))
      _ = _ := by simp
  change es.getD 0 0+1 + _ ≤ 8*r^3
  have hrpos : 1 ≤ r := by dsimp [r]; omega
  have hs := Nat.mul_le_mul_right (2*r*(r+1)) (show r-1 ≤ r by omega)
  nlinarith [sq_nonneg (r-1 : ℤ)]

lemma cubic_exp_bound (t : ℕ) : 32*(25+t)^3 ≤ 2^(23+t) := by
  induction t with
  | zero => norm_num
  | succ t ih =>
    have hg : (25+(t+1))^3 ≤ 2*(25+t)^3 := by nlinarith [Nat.zero_le (t^3), Nat.zero_le (t^2)]
    calc
      32*(25+(t+1))^3 ≤ 2*(32*(25+t)^3) := by nlinarith
      _ ≤ 2*2^(23+t) := Nat.mul_le_mul_left 2 ih
      _ = 2^(23+(t+1)) := by ring

lemma tailCount_split {es : List ℕ} {k l : ℕ} (hl : k+l ≤ es.length) :
    tailCount es k = (∏ i ∈ Finset.range l, (es.getD (i+k) 0+1)) * tailCount es (k+l) := by
  unfold tailCount
  conv_lhs => rw [show es.length-k = l+(es.length-(k+l)) by omega, Finset.prod_range_add]
  simp only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]

lemma smallest_K_lower {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hr : 25 ≤ es.length) :
    45*2^(es.length-4) ≤ tailCount es 1 := by
  have hp : primeAt 24 ≤ primeAt (es.length-1) := primeAt_strictMono.monotone (by omega)
  have hb : ∀ i, i < es.length → Nat.log (primeAt i) (primeAt 24) ≤ es.getD i 0 := by
    intro i hi
    have hh := (h.exponent_bounds (number_prefix he) hi).1
    rw [factorization_number,if_pos hi] at hh
    exact (Nat.log_mono_right hp).trans hh
  have h1 := hb 1 (by omega)
  have h2 := hb 2 (by omega)
  have h3 := hb 3 (by omega)
  change 4 ≤ es.getD 1 0 at h1
  change 2 ≤ es.getD 2 0 at h2
  change 2 ≤ es.getD 3 0 at h3
  rw [tailCount_split (k:=1) (l:=3) (by omega)]
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul]
  have hprod : 45 ≤ (es.getD 1 0+1)*(es.getD 2 0+1)*(es.getD 3 0+1) := by
    exact Nat.mul_le_mul (Nat.mul_le_mul (show 5 ≤ _ by omega) (show 3 ≤ _ by omega)) (show 3 ≤ _ by omega)
  exact Nat.mul_le_mul hprod (tailCount_lower he 4)

lemma moment_growth (t : ℕ) :
    2*(16+2*(t : ℚ))*1100^2*(100/81 : ℚ)^t ≤ (9/16 : ℚ)*45*2^(21+t) := by
  induction t with
  | zero => norm_num
  | succ t ih =>
    have hpow : 0 ≤ (100/81 : ℚ)^t := by positivity
    have hstep : 2*(16+2*((t : ℚ)+1))*1100^2*(100/81 : ℚ)^t*(100/81)
        ≤ 2*(2*(16+2*(t : ℚ))*1100^2*(100/81 : ℚ)^t) := by
      have ht : 0 ≤ (t : ℚ)*(100/81 : ℚ)^t := by positivity
      nlinarith
    push_cast
    rw [show 21+(t+1) = (21+t)+1 by omega,pow_succ (100/81 : ℚ) t,pow_succ (2 : ℚ) (21+t)]
    nlinarith

lemma large_moment_bound {a K T t : ℕ}
    (ha : a+2 ≤ 16+2*t) (hK : 45*2^(21+t) ≤ K) (hT : 8*T ≤ K) :
    (2*((a+2)*K) : ℚ)*(factorProduct (25+t))^2 ≤ ((K-2*T : ℕ) : ℚ)^2 := by
  have hKg : (45*2^(21+t) : ℚ) ≤ K := by exact_mod_cast hK
  have ha' : (a : ℚ)+2 ≤ 16+2*(t : ℚ) := by exact_mod_cast ha
  have hT' : 8*(T : ℚ) ≤ K := by exact_mod_cast hT
  have hsub : ((K-2*T : ℕ) : ℚ) = (K : ℚ)-2*T := by
    rw [Nat.cast_sub (by omega),Nat.cast_mul,Nat.cast_ofNat]
  rw [hsub]
  have hfac := factorProduct_large t
  have hf0 := factorProduct_nonneg (25+t)
  have hB0 : 0 ≤ 1100*(10/9 : ℚ)^t := by positivity
  have hf2 : (factorProduct (25+t))^2 ≤ (1100*(10/9 : ℚ)^t)^2 := by nlinarith
  have hg := moment_growth t
  have hpower : ((10/9 : ℚ)^t)^2 = (100/81 : ℚ)^t := by rw [← pow_mul, mul_comm t 2,pow_mul]; norm_num
  rw [mul_pow,hpower] at hf2
  have hpre : 2*((a : ℚ)+2)*(factorProduct (25+t))^2 ≤ (9/16 : ℚ)*K := by
    calc
      _ ≤ 2*(16+2*(t : ℚ))*(1100^2*(100/81 : ℚ)^t) :=
        mul_le_mul (by linarith) hf2 (sq_nonneg _) (by positivity)
      _ ≤ (9/16 : ℚ)*(45*2^(21+t)) := by nlinarith only [hg]
      _ ≤ _ := mul_le_mul_of_nonneg_left hKg (by norm_num)
  have hm := mul_le_mul_of_nonneg_right hpre (Nat.cast_nonneg K : (0 : ℚ) ≤ K)
  have hrem : 0 ≤ (K : ℚ)-2*T := by linarith
  have hsq : ((3/4 : ℚ)*K)^2 ≤ ((K : ℚ)-2*T)^2 := by nlinarith
  nlinarith

lemma smallest_large {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hr : 25 ≤ es.length) :
    Prim n (2*number es) := by
  let t := es.length-25
  let T := 8*es.length^3
  have hrval : es.length = 25+t := by dsimp [t]; omega
  have hscalar : 4*T ≤ 2^(es.length-2) := by
    have := cubic_exp_bound t
    dsimp [T]
    rw [hrval,show 25+t-2=23+t by omega]
    nlinarith only [this]
  have hTc : 4*T ≤ tailCount es 2 := hscalar.trans (tailCount_lower he 2)
  have hTs : (4*T)^2 ≤ tailNumber es 2 := by
    calc
      (4*T)^2 ≤ (2^(es.length-2))^2 := Nat.pow_le_pow_left hscalar 2
      _ = 4^(es.length-2) := by rw [← pow_mul, mul_comm (es.length-2) 2,pow_mul]; rfl
      _ ≤ _ := tailNumber_lower he
  have h8T : 8*T ≤ tailCount es 1 := by
    have hp : 2^(es.length-1) = 2*2^(es.length-2) := by
      rw [show es.length-1 = (es.length-2)+1 by omega,pow_succ]; ring
    have hb := tailCount_lower he 1
    rw [hp] at hb
    omega
  have hsize : 4*T+2 ≤ dcount es := by
    have hb := tailCount_lower he 0
    have heq : tailCount es 0 = dcount es := by simp [tailCount,dcount]
    rw [heq,Nat.sub_zero] at hb
    have hp : 2^es.length = 4*2^(es.length-2) := by
      conv_lhs => rw [show es.length = (es.length-2)+2 by omega,pow_add]
      norm_num; ring
    rw [hp] at hb
    have hpos : 0 < 2^(es.length-2) := by positivity
    omega
  apply generic_from_moment h he (by omega) (smallest_cost_bound h he hr) hsize hTc hTs (by omega)
  rw [hrval]
  apply large_moment_bound
  · have ha := h.exponent_two_upper (number_prefix he) hr
    have hf : (number es).factorization 2 = es.getD 0 0 := by
      simpa [primeAt_zero,show 0 < es.length by omega] using factorization_number es 0
    rw [hf] at ha
    dsimp [t]
    omega
  · have hb := smallest_K_lower h he hr
    rw [hrval,show 25+t-4=21+t by omega] at hb
    exact hb
  · simpa only [T,hrval] using h8T

end Solution

/- RootMoment -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
noncomputable def rootWeight (k d : ℕ) : ℝ := ((d : ℝ)^((k : ℝ)⁻¹))⁻¹
noncomputable def rootSum (k m : ℕ) : ℝ := ∑ d ∈ m.divisors, rootWeight k d

lemma rootWeight_nonneg (k d : ℕ) : 0 ≤ rootWeight k d := by unfold rootWeight; positivity
lemma rootWeight_mul (k a b : ℕ) : rootWeight k (a*b) = rootWeight k a * rootWeight k b := by
  simp [rootWeight,Real.mul_rpow (Nat.cast_nonneg a) (Nat.cast_nonneg b),mul_inv_rev,mul_comm]
lemma rootWeight_one (k : ℕ) : rootWeight k 1 = 1 := by simp [rootWeight]
lemma rootWeight_pow (k p a : ℕ) : rootWeight k (p^a) = rootWeight k p ^ a := by
  induction a with
  | zero => simp [rootWeight_one]
  | succ a ih => rw [pow_succ,rootWeight_mul,ih,pow_succ]
lemma rootSum_nonneg (k m : ℕ) : 0 ≤ rootSum k m := Finset.sum_nonneg fun d _ => rootWeight_nonneg k d

lemma root_pow {k : ℕ} (hk : 0 < k) {x : ℝ} (hx : 0 ≤ x) : (x^((k : ℝ)⁻¹))^k = x := by
  rw [← Real.rpow_mul_natCast hx]
  have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
  rw [inv_mul_cancel₀ hk0,Real.rpow_one]

lemma rootWeight_bound {k p : ℕ} {q : ℝ} (hk : 0 < k) (hp : 0 < p)
    (hq : 0 ≤ q) (hb : 1 ≤ q^k*(p : ℝ)) : rootWeight k p ≤ q := by
  have hp0 : 0 < (p : ℝ) := by exact_mod_cast hp
  have hroot : 0 < (p : ℝ)^((k : ℝ)⁻¹) := Real.rpow_pos_of_pos hp0 _
  unfold rootWeight
  apply (inv_le_iff_one_le_mul₀ hroot).mpr
  apply (pow_le_pow_iff_left₀ (by positivity) (by positivity) hk.ne').mp
  rw [mul_pow,root_pow hk hp0.le,one_pow]
  simpa only [mul_comm] using hb

lemma rootSum_mul_le (k a b : ℕ) : rootSum k (a*b) ≤ rootSum k a * rootSum k b := by
  unfold rootSum
  rw [Nat.divisors_mul,Finset.mul_def]
  calc
    _ ≤ ∑ d ∈ a.divisors ×ˢ b.divisors, rootWeight k (d.1*d.2) :=
      Finset.sum_image_le_of_nonneg (fun d _ => rootWeight_nonneg k d)
    _ = _ := by rw [Finset.sum_product,Finset.sum_mul_sum]; simp_rw [rootWeight_mul]

lemma rootSum_prime_pow {k p a : ℕ} {q : ℝ} (hp : p.Prime)
    (hq : rootWeight k p ≤ q) :
    rootSum k (p^a) ≤ ∑ j ∈ Finset.range (a+1), q^j := by
  simp only [rootSum,Nat.divisors_prime_pow hp,Finset.sum_map,Function.Embedding.coeFn_mk,rootWeight_pow]
  exact Finset.sum_le_sum fun j _ => pow_le_pow_left₀ (rootWeight_nonneg _ _) hq _

lemma rootSum_prod {ι : Type*} [DecidableEq ι] (A : Finset ι) (k : ℕ)
    (p e : ι → ℕ) (q : ι → ℝ) (hp : ∀ i ∈ A, (p i).Prime)
    (hq : ∀ i ∈ A, rootWeight k (p i) ≤ q i) :
    rootSum k (∏ i ∈ A, p i ^ e i) ≤ ∏ i ∈ A, ∑ j ∈ Finset.range (e i+1), q i ^ j := by
  induction A using Finset.induction_on with
  | empty => simp [rootSum,rootWeight_one]
  | @insert i A hn ih =>
    have hpA : ∀ j ∈ A, (p j).Prime := fun j hj => hp j (Finset.mem_insert_of_mem hj)
    have hqA : ∀ j ∈ A, rootWeight k (p j) ≤ q j := fun j hj => hq j (Finset.mem_insert_of_mem hj)
    have hpi := hp i (Finset.mem_insert_self _ _)
    have hqi := hq i (Finset.mem_insert_self _ _)
    rw [Finset.prod_insert hn,Finset.prod_insert hn]
    exact (rootSum_mul_le _ _ _).trans (mul_le_mul (rootSum_prime_pow hpi hqi) (ih hpA hqA)
      (rootSum_nonneg _ _) (Finset.sum_nonneg fun j _ => pow_nonneg ((rootWeight_nonneg _ _).trans hqi) _))

lemma count_le_of_rootSum {k m L K : ℕ} {B : ℝ} (hk : 0 < k)
    (hB : 0 ≤ B) (hw : rootSum k m ≤ B) (hb : (L : ℝ)*B^k ≤ (K : ℝ)^k) :
    (m.divisors.filter (fun d => d ≤ L)).card ≤ K := by
  let A := m.divisors.filter (fun d => d ≤ L)
  have hc : (A.card : ℝ) ≤ (L : ℝ)^((k : ℝ)⁻¹)*rootSum k m := by
    have hterm : ∀ d ∈ A, (1 : ℝ) ≤ (L : ℝ)^((k : ℝ)⁻¹)*rootWeight k d := by
      intro d hd
      obtain ⟨hdm,hdL⟩ := Finset.mem_filter.mp hd
      have hdpos : 0 < (d : ℝ) := by exact_mod_cast Nat.pos_of_mem_divisors hdm
      have hrpos := Real.rpow_pos_of_pos hdpos ((k : ℝ)⁻¹)
      change 1 ≤ (L : ℝ)^((k : ℝ)⁻¹) / (d : ℝ)^((k : ℝ)⁻¹)
      apply (le_div_iff₀ hrpos).mpr
      simpa using Real.rpow_le_rpow hdpos.le (by exact_mod_cast hdL) (by positivity : 0 ≤ (k : ℝ)⁻¹)
    have h₁ := Finset.sum_le_sum hterm
    simp only [Finset.sum_const,nsmul_eq_mul,mul_one,← Finset.mul_sum] at h₁
    have h₂ : ∑ d ∈ A, rootWeight k d ≤ rootSum k m :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) (fun d _ _ => rootWeight_nonneg k d)
    exact h₁.trans (mul_le_mul_of_nonneg_left h₂ (by positivity))
  have hcB : (A.card : ℝ) ≤ (L : ℝ)^((k : ℝ)⁻¹)*B := hc.trans (mul_le_mul_of_nonneg_left hw (by positivity))
  have hpower : ((L : ℝ)^((k : ℝ)⁻¹)*B)^k ≤ (K : ℝ)^k := by
    rwa [mul_pow,root_pow hk (Nat.cast_nonneg L)]
  have hle : (L : ℝ)^((k : ℝ)⁻¹)*B ≤ K :=
    (pow_le_pow_iff_left₀ (by positivity) (Nat.cast_nonneg K) hk.ne').mp hpower
  exact_mod_cast hcB.trans hle

def geomN (q Q : ℕ) : ℕ → ℕ
  | 0 => 1
  | e+1 => Q*geomN q Q e + q^(e+1)

lemma geomN_cast {Q : ℕ} (hQ : 0 < Q) (q e : ℕ) :
    (∑ j ∈ Finset.range (e+1), ((q : ℝ)/Q)^j) = (geomN q Q e : ℝ)/(Q : ℝ)^e := by
  have hQ0 : (Q : ℝ) ≠ 0 := by exact_mod_cast hQ.ne'
  induction e with
  | zero => simp [geomN]
  | succ e ih =>
    rw [Finset.sum_range_succ,ih,geomN]
    push_cast
    rw [div_pow]
    field_simp
    ring

def twiceExp (es : List ℕ) (i : ℕ) := es.getD i 0 + if i=0 then 1 else 0

lemma twice_product {es : List ℕ} (hl : 0 < es.length) :
    2*number es = ∏ i ∈ Finset.range es.length, primeAt i ^ twiceExp es i := by
  rw [number_one_split hl]
  conv_rhs => rw [show es.length = 1+(es.length-1) by omega,Finset.prod_range_add]
  simp only [Finset.prod_range_succ,Finset.prod_range_zero,one_mul,twiceExp,
    primeAt_zero,ite_true,show ∀ i : ℕ, ¬1+i=0 by omega,ite_false,Nat.add_zero]
  simp only [Nat.add_comm 1,tailNumber]
  ring

def momentNum (es qs : List ℕ) (Q : ℕ) : ℕ :=
  ∏ i ∈ Finset.range es.length, geomN (qs.getD i 0) Q (twiceExp es i)
def momentDen (es : List ℕ) (Q : ℕ) : ℕ :=
  ∏ i ∈ Finset.range es.length, Q ^ twiceExp es i

lemma moment_integer {es qs : List ℕ} {k Q L K : ℕ}
    (hl : 0 < es.length) (hk : 0 < k) (hQ : 0 < Q)
    (hq : ∀ i, i < es.length → Q^k ≤ (qs.getD i 0)^k*primeAt i)
    (hb : L*(momentNum es qs Q)^k ≤ K^k*(momentDen es Q)^k) :
    ((2*number es).divisors.filter (fun d => d ≤ L)).card ≤ K := by
  have hden : 0 < momentDen es Q := Finset.prod_pos fun i _ => pow_pos hQ _
  let B : ℝ := (momentNum es qs Q : ℝ) / momentDen es Q
  have hq' : ∀ i ∈ Finset.range es.length, rootWeight k (primeAt i) ≤ (qs.getD i 0 : ℝ)/Q := by
    intro i hi
    apply rootWeight_bound hk (primeAt_prime i).pos (by positivity)
    have hh : (Q : ℝ)^k ≤ (qs.getD i 0 : ℝ)^k*(primeAt i : ℝ) := by exact_mod_cast hq i (Finset.mem_range.mp hi)
    rw [div_pow]
    have hp : 0 < (Q : ℝ)^k := by positivity
    rw [div_mul_eq_mul_div]
    exact (le_div_iff₀ hp).mpr (by simpa using hh)
  have hbound : rootSum k (2*number es) ≤ B := by
    rw [twice_product hl]
    have hh := rootSum_prod (Finset.range es.length) k primeAt (twiceExp es)
      (fun i => (qs.getD i 0 : ℝ)/Q) (fun i _ => primeAt_prime i) hq'
    simp_rw [geomN_cast hQ] at hh
    simpa [B,momentNum,momentDen,Finset.prod_div_distrib] using hh
  apply count_le_of_rootSum hk (by dsimp [B]; positivity) hbound
  have hb' : (L : ℝ)*(momentNum es qs Q : ℝ)^k ≤ (K : ℝ)^k*(momentDen es Q : ℝ)^k := by exact_mod_cast hb
  dsimp [B]
  rw [div_pow,← mul_div_assoc]
  exact (div_le_iff₀ (by positivity)).mpr hb'

end Solution

/- Enumeration -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def expList (f : ℕ → ℕ) (i r : ℕ) : List ℕ := (List.range r).map (fun j => f (i+j))
lemma expList_length (f : ℕ → ℕ) (i r : ℕ) : (expList f i r).length = r := by simp [expList]
lemma expList_getD (f : ℕ → ℕ) (i r j : ℕ) (hj : j < r) :
    (expList f i r).getD j 0 = f (i+j) := by
  simp [expList,List.getD_eq_getElem?_getD,List.getElem?_map,List.getElem?_range,hj]
lemma expList_succ (f : ℕ → ℕ) (i r : ℕ) : expList f i (r+1) = f i :: expList f (i+1) r := by
  simp only [expList,List.range_succ_eq_map,List.map_cons,List.map_map,Nat.add_zero]
  congr 1
  apply List.map_congr_left
  intro j hj
  simp [Function.comp_def,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]

noncomputable def lowerExp (r i : ℕ) := max 1 (Nat.log (primeAt i) (primeAt (r-1)))
noncomputable def upperExp (r i : ℕ) := 2 * Nat.log (primeAt i) (primeAt r)
noncomputable def enumAux (r i : ℕ) : ℕ → ℕ → List (List ℕ)
  | 0, _ => [[]]
  | len+1, cap => ((List.range (min cap (upperExp r i)+1)).filter (fun e => lowerExp r i ≤ e)).flatMap
      (fun e => (enumAux r (i+1) len e).map (e :: ·))
noncomputable def enumVectors (r : ℕ) := enumAux r 0 r (upperExp r 0)

lemma enumAux_complete (f : ℕ → ℕ) (r i len cap : ℕ)
    (hb : ∀ j, j < len → lowerExp r (i+j) ≤ f (i+j) ∧ f (i+j) ≤ upperExp r (i+j))
    (hc : ∀ j, j < len → f (i+j) ≤ cap)
    (ha : ∀ j, j+1 < len → f (i+(j+1)) ≤ f (i+j)) :
    expList f i len ∈ enumAux r i len cap := by
  induction len generalizing i cap with
  | zero => simp [enumAux,expList]
  | succ len ih =>
    rw [enumAux,expList_succ]
    apply List.mem_flatMap.mpr
    refine ⟨f i, ?_, ?_⟩
    · apply List.mem_filter.mpr
      have hh := hb 0 (by omega)
      have hhc := hc 0 (by omega)
      simp only [Nat.add_zero] at hh hhc
      exact ⟨List.mem_range.mpr (by omega),by simpa using hh.1⟩
    · apply List.mem_map.mpr
      refine ⟨expList f (i+1) len, ?_, rfl⟩
      apply ih
      · intro j hj
        simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hb (j+1) (by omega)
      · intro j hj
        have hanti : ∀ j, j < len+1 → f (i+j) ≤ f i := by
          intro j hj
          induction j with
          | zero => simp
          | succ j ih => exact (ha j (by omega)).trans (ih (by omega))
        simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hanti (j+1) (by omega)
      · intro j hj
        simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using ha (j+1) (by omega)

lemma smallest_vector {n H : ℕ} (h : Smallest n H) :
    ∃ es : List ℕ, H = number es ∧
      (∀ i, i < es.length → 0 < es.getD i 0) ∧ es ∈ enumVectors es.length := by
  obtain ⟨r,hpref⟩ := h.prefix
  let f := fun i => H.factorization (primeAt i)
  let es := expList f 0 r
  have hlen : es.length = r := expList_length _ _ _
  have hget : ∀ i, i < r → es.getD i 0 = f i := by
    intro i hi
    simpa only [Nat.zero_add] using expList_getD f 0 r i hi
  have hvalue : H = number es := by
    calc
      H = ∏ i ∈ Finset.range r, primeAt i ^ f i := prefix_value h.1 hpref
      _ = number es := by
        unfold number
        rw [hlen]
        exact Finset.prod_congr rfl fun i hi => by rw [hget i (Finset.mem_range.mp hi)]
  have hpositive : ∀ i, i < es.length → 0 < es.getD i 0 := by
    intro i hi
    rw [hlen] at hi
    rw [hget i hi]
    exact prefix_positive h.1 hpref hi
  refine ⟨es,hvalue,hpositive,?_⟩
  rw [hlen]
  apply enumAux_complete
  · intro j hj
    simp only [Nat.zero_add]
    have hb := h.exponent_bounds hpref hj
    have hp := prefix_positive h.1 hpref hj
    exact ⟨by dsimp [lowerExp,f]; omega, hb.2⟩
  · intro j hj
    simp only [Nat.zero_add]
    by_cases hj0 : j=0
    · subst j; exact (h.exponent_bounds hpref hj).2
    · have ha := h.antitone (primeAt_prime 0) (primeAt_prime j) (primeAt_strictMono (by omega))
      have hb := (h.exponent_bounds hpref (show 0 < r by omega)).2
      exact ha.trans hb
  · intro j hj
    simp only [Nat.zero_add]
    exact h.antitone (primeAt_prime j) (primeAt_prime (j+1)) (primeAt_strictMono (by omega))

end Solution

/- NumberFast -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
noncomputable def fastNumber (i : ℕ) : List ℕ → ℕ
  | [] => 1
  | e::es => primeAt i ^ e * fastNumber (i+1) es

def fastCount : List ℕ → ℕ
  | [] => 1
  | e::es => (e+1)*fastCount es

lemma fastNumber_prod (i : ℕ) (es : List ℕ) :
    fastNumber i es = ∏ j ∈ Finset.range es.length, primeAt (i+j) ^ es.getD j 0 := by
  induction es generalizing i with
  | nil => simp [fastNumber]
  | cons e es ih =>
    rw [fastNumber,List.length_cons,Finset.prod_range_succ']
    simp only [List.getD_cons_zero,Nat.add_zero,List.getD_cons_succ,ih]
    rw [Nat.mul_comm (primeAt i ^ e)]
    congr 1
    apply Finset.prod_congr rfl
    intro j hj
    simp only [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]

lemma fastNumber_eq (es : List ℕ) : fastNumber 0 es = number es := by
  simpa only [Nat.zero_add,number] using fastNumber_prod 0 es

lemma fastCount_eq (es : List ℕ) : fastCount es = dcount es := by
  induction es with
  | nil => simp [fastCount,dcount]
  | cons e es ih =>
    rw [fastCount,dcount,List.length_cons,Finset.prod_range_succ']
    simp only [List.getD_cons_zero,List.getD_cons_succ,ih,dcount]
    ring
end Solution

/- CubeCert -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def cubeCaps : List ℕ := [79371,69337,58481,52276,44965,42530,38892,37476,35164,32549,31834,30011,
  29001,28544,27710,26623,25688,25404,24622,24150,23928,23306,22925,22398]
lemma cubeCaps_bound (i : ℕ) (hi : i < 24) : 100000^3 ≤ (cubeCaps.getD i 0)^3 * primeAt i := by
  interval_cases i <;> decide

noncomputable def cubeCheck (es : List ℕ) : Bool := decide (
  8 ≤ es.length ∧ es.length ≤ 24 ∧
  4*coinCost es+2 ≤ dcount es ∧
  4*coinCost es ≤ tailCount es 2 ∧
  (4*coinCost es)^2 ≤ tailNumber es 2 ∧
  2*coinCost es ≤ tailCount es 1 ∧
  2*((es.getD 0 0+2)*tailCount es 1)*(momentNum es cubeCaps 100000)^3
    ≤ (tailCount es 1 - 2*coinCost es)^3*(momentDen es 100000)^3)

lemma cubeCheck_sound {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hc : cubeCheck es = true) : Prim n (2*number es) := by
  obtain ⟨hl,hu,hsize,hRc,hRs,hK,hb⟩ := of_decide_eq_true hc
  apply generic_from_count h he hl le_rfl hsize hRc hRs hK
  apply moment_integer (k:=3) (Q:=100000) (qs:=cubeCaps) (by omega) (by decide) (by decide)
  · intro i hi
    exact cubeCaps_bound i (by omega)
  · change (2*tau (2*number es)) * _ ≤ _
    rwa [tau_twice_number (by omega)]

end Solution

/- Stats -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
open scoped Pointwise

def fnumber : List (ℕ×ℕ) → ℕ
  | [] => 1
  | (p,e)::fs => p^e*fnumber fs

def divisorList : List (ℕ×ℕ) → List ℕ
  | [] => [1]
  | (p,e)::fs => (List.range (e+1)).flatMap fun j => (divisorList fs).map (fun d => p^j*d)

def ValidFactors (fs : List (ℕ×ℕ)) := ∀ pe ∈ fs, pe.1.Prime

lemma divisorList_toFinset {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) :
    (divisorList fs).toFinset = (fnumber fs).divisors := by
  induction fs with
  | nil => simp [divisorList,fnumber]
  | cons pe fs ih =>
    obtain ⟨p,e⟩ := pe
    have hp := hf (p,e) (by simp)
    have hfs : ValidFactors fs := fun pe hpe => hf pe (by simp [hpe])
    ext d
    simp only [divisorList,List.mem_toFinset,List.mem_flatMap,List.mem_range,List.mem_map,
      fnumber,Nat.divisors_mul,Finset.mem_mul]
    constructor
    · rintro ⟨j,hj,x,hx,rfl⟩
      refine ⟨p^j, ?_, x, ?_,rfl⟩
      · rw [Nat.divisors_prime_pow hp]
        exact Finset.mem_map.mpr ⟨j,Finset.mem_range.mpr hj,rfl⟩
      · rw [← ih hfs]; exact List.mem_toFinset.mpr hx
    · rintro ⟨x,hx,y,hy,rfl⟩
      rw [Nat.divisors_prime_pow hp] at hx
      obtain ⟨j,hj,rfl⟩ := Finset.mem_map.mp hx
      refine ⟨j,Finset.mem_range.mp hj,y,?_,rfl⟩
      rw [← ih hfs] at hy
      exact List.mem_toFinset.mp hy

lemma fnumber_pos {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) : 0 < fnumber fs := by
  induction fs with
  | nil => simp [fnumber]
  | cons pe fs ih =>
    have hp := hf pe (by simp)
    have ht := ih (fun pe hpe => hf pe (by simp [hpe]))
    simp only [fnumber]
    exact Nat.mul_pos (pow_pos hp.pos _) ht

lemma divisorList_bound {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) {d : ℕ} (hd : d ∈ divisorList fs) :
    0 < d ∧ d ≤ fnumber fs := by
  have hm : d ∈ (fnumber fs).divisors := by rw [← divisorList_toFinset hf]; exact List.mem_toFinset.mpr hd
  exact ⟨Nat.pos_of_mem_divisors hm,Nat.le_of_dvd (fnumber_pos hf) (Nat.mem_divisors.mp hm).1⟩

lemma list_finset_sum_le (l : List ℕ) : l.toFinset.sum id ≤ l.sum := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.toFinset_cons,List.sum_cons]
    by_cases ha : a ∈ l.toFinset
    · rw [Finset.insert_eq_of_mem ha]; exact ih.trans (Nat.le_add_left _ _)
    · rw [Finset.sum_insert ha]; simpa only [id_eq] using Nat.add_le_add_left ih a

lemma list_sum_flatMap {α : Type*} (l : List α) (f : α → List ℕ) :
    (l.flatMap f).sum = (l.map (fun a => (f a).sum)).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp [ih]

def fullCount : List (ℕ×ℕ) → ℕ
  | [] => 1
  | (_,e)::fs => (e+1)*fullCount fs

def fullSum : List (ℕ×ℕ) → ℕ
  | [] => 1
  | (p,e)::fs => ((List.range (e+1)).map (fun j => p^j)).sum * fullSum fs

lemma divisorList_length (fs : List (ℕ×ℕ)) : (divisorList fs).length = fullCount fs := by
  induction fs with
  | nil => simp [divisorList,fullCount]
  | cons pe fs ih =>
    simp [divisorList,fullCount,List.length_flatMap,ih]

lemma divisorList_sum (fs : List (ℕ×ℕ)) : (divisorList fs).sum = fullSum fs := by
  induction fs with
  | nil => simp [divisorList,fullSum]
  | cons pe fs ih =>
    obtain ⟨p,e⟩ := pe
    simp only [divisorList,fullSum,list_sum_flatMap]
    have hm : ∀ j, ((divisorList fs).map (fun d => p^j*d)).sum = p^j*fullSum fs := by
      intro j
      simpa only [id_eq,List.map_id,ih] using List.sum_map_mul_left (divisorList fs) id (p^j)
    simp_rw [hm]
    exact List.sum_map_mul_right _ _ _

def cutList (fs : List (ℕ×ℕ)) (L : ℕ) := (divisorList fs).filter (fun d => d ≤ L)

def boundedCount : List (ℕ×ℕ) → ℕ → ℕ
  | [], L => if 1 ≤ L then 1 else 0
  | (p,e)::fs, L => if L=0 then 0 else if fnumber ((p,e)::fs) ≤ L then fullCount ((p,e)::fs)
    else ((List.range (e+1)).map (fun j => boundedCount fs (L/p^j))).sum

def boundedSum : List (ℕ×ℕ) → ℕ → ℕ
  | [], L => if 1 ≤ L then 1 else 0
  | (p,e)::fs, L => if L=0 then 0 else if fnumber ((p,e)::fs) ≤ L then fullSum ((p,e)::fs)
    else ((List.range (e+1)).map (fun j => p^j*boundedSum fs (L/p^j))).sum

lemma cutList_zero {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) : cutList fs 0 = [] := by
  apply List.filter_eq_nil_iff.mpr
  intro d hd
  have hp := (divisorList_bound hf hd).1
  simp [hp.ne']

lemma cutList_full {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) {L : ℕ} (hL : fnumber fs ≤ L) :
    cutList fs L = divisorList fs := by
  apply List.filter_eq_self.mpr
  intro d hd
  exact decide_eq_true ((divisorList_bound hf hd).2.trans hL)

lemma cutList_cons {p e L : ℕ} {fs : List (ℕ×ℕ)} (hp : p.Prime) :
    cutList ((p,e)::fs) L = (List.range (e+1)).flatMap (fun j => (cutList fs (L/p^j)).map (fun d => p^j*d)) := by
  unfold cutList
  rw [divisorList,List.filter_flatMap]
  congr 1
  funext j
  rw [List.filter_map]
  congr 1
  apply List.filter_congr
  intro d hd
  simp only [Function.comp_def]
  congr 1
  exact propext (by rw [Nat.le_div_iff_mul_le (pow_pos hp.pos j),Nat.mul_comm])

lemma boundedCount_eq {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) (L : ℕ) :
    boundedCount fs L = (cutList fs L).length := by
  induction fs generalizing L with
  | nil => simp [boundedCount,cutList,divisorList]; split_ifs <;> simp_all
  | cons pe fs ih =>
    obtain ⟨p,e⟩ := pe
    have hp := hf (p,e) (by simp)
    have hfs : ValidFactors fs := fun pe hpe => hf pe (by simp [hpe])
    rw [boundedCount]
    split_ifs with h0 hfull
    · subst L; rw [cutList_zero hf]; rfl
    · rw [cutList_full hf hfull,divisorList_length]
    · rw [cutList_cons hp,List.length_flatMap]
      simp only [List.length_map,ih hfs]

lemma boundedSum_eq {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) (L : ℕ) :
    boundedSum fs L = (cutList fs L).sum := by
  induction fs generalizing L with
  | nil => simp [boundedSum,cutList,divisorList]; split_ifs <;> simp_all
  | cons pe fs ih =>
    obtain ⟨p,e⟩ := pe
    have hp := hf (p,e) (by simp)
    have hfs : ValidFactors fs := fun pe hpe => hf pe (by simp [hpe])
    rw [boundedSum]
    split_ifs with h0 hfull
    · subst L; rw [cutList_zero hf]; rfl
    · rw [cutList_full hf hfull,divisorList_sum]
    · rw [cutList_cons hp,list_sum_flatMap]
      have hm : ∀ j, ((cutList fs (L/p^j)).map (fun d => p^j*d)).sum = p^j*(cutList fs (L/p^j)).sum := by
        intro j
        simpa only [id_eq,List.map_id] using List.sum_map_mul_left (cutList fs (L/p^j)) id (p^j)
      simp_rw [hm,ih hfs]

lemma cutList_toFinset {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) (L : ℕ) :
    (cutList fs L).toFinset = (fnumber fs).divisors.filter (fun d => d ≤ L) := by
  simp [cutList,List.toFinset_filter,divisorList_toFinset hf]

lemma boundedCount_upper {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) (L : ℕ) :
    ((fnumber fs).divisors.filter (fun d => d ≤ L)).card ≤ boundedCount fs L := by
  rw [← cutList_toFinset hf,boundedCount_eq hf]
  exact List.toFinset_card_le _

lemma boundedSum_upper {fs : List (ℕ×ℕ)} (hf : ValidFactors fs) (L : ℕ) :
    ((fnumber fs).divisors.filter (fun d => d ≤ L)).sum id ≤ boundedSum fs L := by
  rw [← cutList_toFinset hf,boundedSum_eq hf]
  exact list_finset_sum_le _

noncomputable def twiceFactors (es : List ℕ) : List (ℕ×ℕ) :=
  (List.range es.length).map fun i => (primeAt i,twiceExp es i)

lemma twiceFactors_valid (es : List ℕ) : ValidFactors (twiceFactors es) := by
  intro pe hpe
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hpe
  exact primeAt_prime i

lemma fnumber_eq_prod (fs : List (ℕ×ℕ)) : fnumber fs = (fs.map (fun pe => pe.1^pe.2)).prod := by
  induction fs with
  | nil => simp [fnumber]
  | cons pe fs ih => simp [fnumber,ih]

lemma twiceFactors_number {es : List ℕ} (hl : 0 < es.length) : fnumber (twiceFactors es) = 2*number es := by
  rw [fnumber_eq_prod,twiceFactors,List.map_map,twice_product hl]
  symm
  simpa only [List.toFinset_range,Function.comp_def] using
    List.prod_toFinset (fun i => primeAt i ^ twiceExp es i) (List.nodup_range (n:=es.length))

lemma upper_tail_count {m L : ℕ} (hm : 0 < m) :
    (m.divisors.filter (fun d => ¬d ≤ L)).card ≤
      (m.divisors.filter (fun d => d ≤ m/(L+1))).card := by
  let A := m.divisors.filter (fun d => ¬d ≤ L)
  let B := m.divisors.filter (fun d => d ≤ m/(L+1))
  apply Finset.card_le_card_of_injOn (fun d => m/d)
  · intro d hd
    change d ∈ m.divisors.filter (fun d => ¬d ≤ L) at hd
    obtain ⟨hdv,hdL⟩ := Finset.mem_filter.mp hd
    have hdvd := (Nat.mem_divisors.mp hdv).1
    have hmul := Nat.div_mul_cancel hdvd
    change m/d ∈ m.divisors.filter (fun d => d ≤ m/(L+1))
    apply Finset.mem_filter.mpr
    refine ⟨Nat.mem_divisors.mpr ⟨Nat.div_dvd_of_dvd hdvd,hm.ne'⟩,?_⟩
    apply (Nat.le_div_iff_mul_le (by omega : 0 < L+1)).mpr
    nlinarith
  · intro d hd e he hde
    change d ∈ m.divisors.filter (fun d => ¬d ≤ L) at hd
    change e ∈ m.divisors.filter (fun d => ¬d ≤ L) at he
    have hdvd := (Nat.mem_divisors.mp (Finset.mem_filter.mp hd).1).1
    have hevd := (Nat.mem_divisors.mp (Finset.mem_filter.mp he).1).1
    have hh := congrArg (fun x => m/x) hde
    simpa only [Nat.div_div_self hdvd hm.ne',Nat.div_div_self hevd hm.ne'] using hh

lemma bounded_pool {fs : List (ℕ×ℕ)} {m L N S : ℕ} {R : Finset ℕ}
    (hf : ValidFactors fs) (hm : fnumber fs = m) (hR : R ⊆ m.divisors)
    (hc : N + (R.filter (fun d => d ≤ L)).card + boundedCount fs (m/(L+1)) ≤ tau m)
    (hs : boundedSum fs L ≤ S + (R.filter (fun d => d ≤ L)).sum id) :
    ∃ B, B ⊆ m.divisors ∧ Disjoint R B ∧ N ≤ B.card ∧ B.sum id ≤ S := by
  let G := m.divisors.filter (fun d => d ≤ L)
  let X := R.filter (fun d => d ≤ L)
  let B := G \ R
  have hmpos : 0 < m := hm ▸ fnumber_pos hf
  have hXsub : X ⊆ G := Finset.filter_subset_filter _ hR
  have hXR : G ∩ R = X := by
    ext d
    simp only [G,X,Finset.mem_inter,Finset.mem_filter]
    exact ⟨fun hd => ⟨hd.2,hd.1.2⟩,fun hd => ⟨⟨hR hd.1,hd.2⟩,hd.1⟩⟩
  have hGB : G \ R = G \ X := by
    ext d
    simp only [G,X,Finset.mem_sdiff,Finset.mem_filter]
    tauto
  have hcB : N ≤ B.card := by
    have htail := upper_tail_count (L:=L) hmpos
    have hub := boundedCount_upper hf (m/(L+1))
    rw [hm] at hub
    have hsplit := Finset.card_filter_add_card_filter_not (s:=m.divisors) (fun d => d ≤ L)
    have hdiff := Finset.card_sdiff_add_card_inter G R
    rw [hXR] at hdiff
    change B.card + X.card = G.card at hdiff
    change G.card + _ = tau m at hsplit
    change N + X.card + _ ≤ tau m at hc
    omega
  have hsB : B.sum id ≤ S := by
    have hsum := Finset.sum_sdiff hXsub (f:=id)
    have hub := boundedSum_upper hf L
    rw [hm] at hub
    change G.sum id ≤ _ at hub
    change _ ≤ S+X.sum id at hs
    change (G \ X).sum id + X.sum id = G.sum id at hsum
    rw [← hGB] at hsum
    change B.sum id + X.sum id = G.sum id at hsum
    omega
  refine ⟨B,Finset.sdiff_subset.trans (Finset.filter_subset _ _),?_,hcB,hsB⟩
  exact Finset.disjoint_left.mpr fun d hd hb => (Finset.mem_sdiff.mp hb).2 hd

end Solution

/- CountFast -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution

def cCount : List (ℕ×ℕ) → ℕ → ℕ
  | [],0 => 0
  | [],_+1 => 1
  | _::_,0 => 0
  | (p,e)::fs,L+1 => if fnumber ((p,e)::fs) ≤ L+1 then fullCount ((p,e)::fs)
    else ((List.range (e+1)).map (fun j => cCount fs ((L+1)/p^j))).sum

def cSum : List (ℕ×ℕ) → ℕ → ℕ
  | [],0 => 0
  | [],_+1 => 1
  | _::_,0 => 0
  | (p,e)::fs,L+1 => if fnumber ((p,e)::fs) ≤ L+1 then fullSum ((p,e)::fs)
    else ((List.range (e+1)).map (fun j => p^j*cSum fs ((L+1)/p^j))).sum

lemma cCount_eq (fs : List (ℕ×ℕ)) (L : ℕ) : cCount fs L = boundedCount fs L := by
  induction fs generalizing L with
  | nil => cases L <;> simp [cCount,boundedCount]
  | cons pe fs ih =>
    obtain ⟨p,e⟩ := pe
    cases L <;> simp [cCount,boundedCount,ih]

lemma cSum_eq (fs : List (ℕ×ℕ)) (L : ℕ) : cSum fs L = boundedSum fs L := by
  induction fs generalizing L with
  | nil => cases L <;> simp [cSum,boundedSum]
  | cons pe fs ih =>
    obtain ⟨p,e⟩ := pe
    cases L <;> simp [cSum,boundedSum,ih]
end Solution

