lemma small_pool {m N : ℕ} (hm : 0 < m)
    (hc : N + (m.divisors.filter (fun d => d ≤ 2*m.divisors.card)).card ≤ m.divisors.card) :
    ∃ G, G ⊆ m.divisors ∧ N ≤ G.card ∧ 2*G.sum id ≤ m := by
  let t := m.divisors.card
  let G := m.divisors.filter (fun d => 2*t*d ≤ m)
  let B := m.divisors.filter (fun d => ¬2*t*d ≤ m)
  let A := m.divisors.filter (fun d => d ≤ 2*t)
  have hmap : Set.MapsTo (fun d => m/d) (↑B : Set ℕ) (↑A : Set ℕ) := by
    intro d hd
    change d ∈ m.divisors.filter (fun d => ¬2*t*d ≤ m) at hd
    obtain ⟨hdv,hbig⟩ := Finset.mem_filter.mp hd
    have hdvd := (Nat.mem_divisors.mp hdv).1
    have hmul := Nat.div_mul_cancel hdvd
    have hpos := Nat.pos_of_mem_divisors hdv
    change m/d ∈ m.divisors.filter (fun d => d ≤ 2*t)
    refine Finset.mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨Nat.div_dvd_of_dvd hdvd,hm.ne'⟩,?_⟩
    nlinarith
  have hinj : Set.InjOn (fun d => m/d) (↑B : Set ℕ) := by
    intro d hd e he hde
    change d ∈ m.divisors.filter (fun d => ¬2*t*d ≤ m) at hd
    change e ∈ m.divisors.filter (fun d => ¬2*t*d ≤ m) at he
    have hdvd := (Nat.mem_divisors.mp (Finset.mem_filter.mp hd).1).1
    have hevd := (Nat.mem_divisors.mp (Finset.mem_filter.mp he).1).1
    have hh := congrArg (fun x => m/x) hde
    simpa only [Nat.div_div_self hdvd hm.ne',Nat.div_div_self hevd hm.ne'] using hh
  have hcardB : B.card ≤ A.card := Finset.card_le_card_of_injOn _ hmap hinj
  have hsplit := Finset.card_filter_add_card_filter_not (s := m.divisors) (fun d => 2*t*d ≤ m)
  change G.card + B.card = t at hsplit
  have hcardG : N ≤ G.card := by change N + A.card ≤ t at hc; omega
  have hGsub : G ⊆ m.divisors := Finset.filter_subset _ _
  have hsum : ∑ d ∈ G, 2*t*d ≤ ∑ _d ∈ G, m := by
    exact Finset.sum_le_sum fun d hd => (Finset.mem_filter.mp hd).2
  rw [← Finset.mul_sum] at hsum
  simp only [Finset.sum_const, smul_eq_mul] at hsum
  have ht : 0 < t := by
    have hmem : 1 ∈ m.divisors := Nat.one_mem_divisors.mpr hm.ne'
    exact Finset.card_pos.mpr ⟨1,hmem⟩
  have hgcard : G.card ≤ t := Finset.card_le_card hGsub
  have htotal : t*(2*G.sum id) ≤ t*m := by
    change 2*t*G.sum id ≤ G.card*m at hsum
    nlinarith [Nat.mul_le_mul_right m hgcard]
  exact ⟨G,hGsub,hcardG,Nat.le_of_mul_le_mul_left htotal ht⟩

lemma reserve_from_pool {m n T W : ℕ} {U E F G : Finset ℕ}
    (hm : 0 < m)
    (hU : U ⊆ m.divisors) (hE : E ⊆ m.divisors)
    (hF : F ⊆ m.divisors) (hG : G ⊆ m.divisors)
    (hUE : Disjoint U E) (hUF : Disjoint U F) (hEF : Disjoint E F)
    (hUc : U.card = 2) (hlcm : U.lcm id = m) (hupos : 0 < U.sum id)
    (hcomplete : Complete E) (hecover : m ≤ E.sum id + 1) (hecard : E.card ≤ T)
    (hpad : Pads F T W) (hFc : F.card ≤ 3*T)
    (hn : 2+2*T ≤ n) (hGc : n+2*T ≤ G.card)
    (hGs : 2*G.sum id ≤ m) (hWs : 8*W ≤ m) (hUs : 8*U.sum id ≤ m) : Prim n m := by
  let R := (E ∪ F) ∪ U
  let B := G \ R
  have hB : B ⊆ m.divisors := Finset.sdiff_subset.trans hG
  have hr : R.card ≤ 4*T+2 := by
    have h₁ := Finset.card_union_le (s := E) (t := F)
    have h₂ := Finset.card_union_le (s := E ∪ F) (t := U)
    change R.card ≤ (E ∪ F).card + U.card at h₂
    omega
  have hbc : n-U.card-2*T ≤ B.card := by
    have hi : (G ∩ R).card ≤ R.card := Finset.card_le_card Finset.inter_subset_right
    have hs := Finset.card_sdiff_add_card_inter G R
    change B.card + (G ∩ R).card = G.card at hs
    omega
  have hUB : Disjoint U B := by
    apply Finset.disjoint_left.mpr
    intro x hx hb
    exact (Finset.mem_sdiff.mp hb).2 (Finset.mem_union_right _ hx)
  have hEB : Disjoint E B := by
    apply Finset.disjoint_left.mpr
    intro x hx hb
    exact (Finset.mem_sdiff.mp hb).2 (Finset.mem_union_left _ (Finset.mem_union_left _ hx))
  have hFB : Disjoint F B := by
    apply Finset.disjoint_left.mpr
    intro x hx hb
    exact (Finset.mem_sdiff.mp hb).2 (Finset.mem_union_left _ (Finset.mem_union_right _ hx))
  have hbs : B.sum id ≤ G.sum id := Finset.sum_le_sum_of_subset Finset.sdiff_subset
  have hbudget : B.sum id + W + U.sum id ≤ m := by omega
  exact reserve hm hU hE hF hB hUE hUF hUB hEF hEB hFB hlcm hupos
    hcomplete hecover hecard hpad (by omega) hbc hbudget

lemma fixed_lcm_pair {H : ℕ} (hH : 0 < H) (hd : 323 ∣ H) :
    ∃ U : Finset ℕ, U ⊆ (2*H).divisors ∧ Disjoint U H.divisors ∧
      U.card = 2 ∧ U.lcm id = 2*H ∧ 0 < U.sum id ∧ 8*U.sum id ≤ 2*H := by
  obtain ⟨K,rfl⟩ := hd
  have hK : 0 < K := by omega
  let U : Finset ℕ := {38*K,34*K}
  have hne : 38*K ≠ 34*K := by omega
  have hsub : U ⊆ (2*(323*K)).divisors := by
    intro x hx
    simp only [U,Finset.mem_insert,Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact Nat.mem_divisors.mpr ⟨⟨17,by ring⟩,by omega⟩
    · exact Nat.mem_divisors.mpr ⟨⟨19,by ring⟩,by omega⟩
  have hdis : Disjoint U (323*K).divisors := by
    apply Finset.disjoint_left.mpr
    intro x hx hxd
    have hdvd := (Nat.mem_divisors.mp hxd).1
    simp only [U,Finset.mem_insert,Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · have := (Nat.mul_dvd_mul_iff_right hK).mp hdvd
      norm_num at this
    · have := (Nat.mul_dvd_mul_iff_right hK).mp hdvd
      norm_num at this
  have hlcm : U.lcm id = 2*(323*K) := by
    simp only [U,Finset.lcm_insert,Finset.lcm_singleton,id_eq]
    rw [normalize_eq]
    change Nat.lcm (38*K) (34*K) = 2*(323*K)
    rw [Nat.lcm_mul_right]
    norm_num
    ring
  have hsum : U.sum id = 72*K := by
    simp [U,hne]
    ring
  refine ⟨U,hsub,hdis,by simp [U,hne],hlcm,?_,?_⟩ <;> rw [hsum] <;> omega

lemma construct_from_count {n H R T : ℕ} {E : Finset ℕ}
    (hH : 0 < H) (h323 : 323 ∣ H)
    (hE : E ⊆ H.divisors) (hcoins : GoodCoins E H T)
    (hR : 0 < R) (hR6 : Nat.Coprime 6 R) (hRd : 6*R ∣ H)
    (hRc : 4*T ≤ R.divisors.card) (hRsize : (4*T)^2 ≤ R)
    (hn : 2+2*T ≤ n)
    (hcount : n+2*T + ((2*H).divisors.filter (fun d => d ≤ 2*(2*H).divisors.card)).card
      ≤ (2*H).divisors.card) : Prim n (2*H) := by
  have hm : 0 < 2*H := by omega
  obtain ⟨U,hU,hUd,hUc,hUl,hUp,hUs⟩ := fixed_lcm_pair hH h323
  obtain ⟨F,W,hF,hEF,hFc,hpad,hWs⟩ := padding_exists hR hH hR6 hRd hRc hRsize hcoins.2.2.2
  obtain ⟨G,hG,hGc,hGs⟩ := small_pool hm hcount
  have hdiv : H.divisors ⊆ (2*H).divisors := by
    intro d hd
    exact Nat.mem_divisors.mpr ⟨(Nat.mem_divisors.mp hd).1.trans ⟨2,by ring⟩,hm.ne'⟩
  exact reserve_from_pool hm hU (hE.trans hdiv) (hF.trans hdiv) hG
    (hUd.mono_right hE) (hUd.mono_right hF) hEF hUc hUl hUp
    hcoins.1 hcoins.2.2.1 hcoins.2.2.2 hpad hFc hn hGc hGs (by omega) hUs

end Solution

/- Data -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

noncomputable def number (es : List ℕ) : ℕ :=
  ∏ i ∈ Finset.range es.length, primeAt i ^ es.getD i 0

def dcount (es : List ℕ) : ℕ :=
  ∏ i ∈ Finset.range es.length, (es.getD i 0+1)

noncomputable def tailNumber (es : List ℕ) (k : ℕ) : ℕ :=
  ∏ i ∈ Finset.range (es.length-k), primeAt (i+k) ^ es.getD (i+k) 0

def tailCount (es : List ℕ) (k : ℕ) : ℕ :=
  ∏ i ∈ Finset.range (es.length-k), (es.getD (i+k) 0+1)

noncomputable def coinCost (es : List ℕ) : ℕ :=
  es.getD 0 0 + 1 + ∑ i ∈ Finset.range (es.length-1),
    es.getD (i+1) 0 * (Nat.log 2 (primeAt (i+1))+1)

lemma number_pos (es : List ℕ) : 0 < number es := by
  apply Finset.prod_pos
  intro i hi
  exact pow_pos (primeAt_prime i).pos _

lemma tailNumber_pos (es : List ℕ) (k : ℕ) : 0 < tailNumber es k := by
  apply Finset.prod_pos
  intro i hi
  exact pow_pos (primeAt_prime (i+k)).pos _

lemma tau_number (es : List ℕ) : tau (number es) = dcount es := by
  exact tau_prod_prime_powers _ _ _ (fun i _ => primeAt_prime i) primeAt_strictMono.injective.injOn

lemma tau_tailNumber (es : List ℕ) (k : ℕ) : tau (tailNumber es k) = tailCount es k := by
  apply tau_prod_prime_powers _ _ _ (fun i _ => primeAt_prime (i+k))
  intro i hi j hj hij
  have hh := primeAt_strictMono.injective hij
  omega

lemma factorization_number (es : List ℕ) (i : ℕ) :
    (number es).factorization (primeAt i) = if i < es.length then es.getD i 0 else 0 := by
  rw [number, Nat.factorization_prod (fun j _ => pow_ne_zero _ (primeAt_prime j).ne_zero)]
  simp only [Finsupp.finset_sum_apply, Nat.factorization_pow, Finsupp.smul_apply,
    (primeAt_prime _).factorization, smul_eq_mul]
  have heq : ∀ j, (Finsupp.single (primeAt j) 1 : ℕ →₀ ℕ) (primeAt i) = if j=i then 1 else 0 := by
    intro j
    by_cases hji : j=i
    · subst j; simp
    · have hne := primeAt_strictMono.injective.ne hji
      simp [Finsupp.single_apply,hne,hne.symm,hji]
  simp_rw [heq]
  simp [Finset.mem_range]

lemma number_prefix {es : List ℕ} (he : ∀ i, i < es.length → 0 < es.getD i 0) :
    ∀ i, primeAt i ∣ number es ↔ i < es.length := by
  intro i
  rw [(primeAt_prime i).dvd_iff_one_le_factorization (number_pos es).ne', factorization_number]
  split_ifs with hi
  · exact ⟨fun _ => hi, fun _ => he i hi⟩
  · simp [hi]

lemma number_one_split {es : List ℕ} (hl : 1 ≤ es.length) :
    number es = 2^(es.getD 0 0) * tailNumber es 1 := by
  unfold number tailNumber
  conv_lhs => rw [show es.length = 1+(es.length-1) by omega, Finset.prod_range_add]
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul, primeAt_zero]
  simp only [Nat.add_comm 1]

lemma number_two_split {es : List ℕ} (hl : 2 ≤ es.length) :
    number es = 2^(es.getD 0 0) * (3^(es.getD 1 0) * tailNumber es 2) := by
  unfold number tailNumber
  conv_lhs => rw [show es.length = 2+(es.length-2) by omega, Finset.prod_range_add]
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul, primeAt_zero,
    show primeAt 1 = 3 from rfl]
  simp only [Nat.add_comm 2]
  ring

lemma dcount_one_split {es : List ℕ} (hl : 1 ≤ es.length) :
    dcount es = (es.getD 0 0+1) * tailCount es 1 := by
  unfold dcount tailCount
  conv_lhs => rw [show es.length = 1+(es.length-1) by omega, Finset.prod_range_add]
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul, Nat.add_comm 1]

lemma dcount_two_split {es : List ℕ} (hl : 2 ≤ es.length) :
    dcount es = (es.getD 0 0+1) * ((es.getD 1 0+1) * tailCount es 2) := by
  unfold dcount tailCount
  conv_lhs => rw [show es.length = 2+(es.length-2) by omega, Finset.prod_range_add]
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul, Nat.add_comm 2]
  ring

lemma coprime_prime_tail {es : List ℕ} {i k : ℕ} (hik : i < k) :
    (primeAt i).Coprime (tailNumber es k) := by
  apply Nat.Coprime.prod_right
  intro j hj
  apply Nat.Coprime.pow_right
  apply (Nat.coprime_primes (primeAt_prime i) (primeAt_prime (j+k))).mpr
  exact primeAt_strictMono.injective.ne (by omega)

lemma tau_twice_number {es : List ℕ} (hl : 1 ≤ es.length) :
    tau (2*number es) = (es.getD 0 0+2) * tailCount es 1 := by
  have hc : Nat.Coprime 2 (tailNumber es 1) := by
    simpa [primeAt_zero] using (coprime_prime_tail (es:=es) (i:=0) (k:=1) (by decide))
  rw [number_one_split hl]
  have hv : 2*(2^es.getD 0 0*tailNumber es 1) = 2^(es.getD 0 0+1)*tailNumber es 1 := by ring
  rw [hv,tau_mul (hc.pow_left _),tau_pow Nat.prime_two,tau_tailNumber]

lemma smallest_goodCoins {n : ℕ} {es : List ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hl : 1 ≤ es.length) :
    ∃ E, E ⊆ (number es).divisors ∧ GoodCoins E (number es) (coinCost es) := by
  have hpref := number_prefix he
  have hp : ∀ i ∈ Finset.range (es.length-1),
      (primeAt (i+1)).Prime ∧ primeAt (i+1) ≠ 2 ∧ primeAt (i+1) < 2^(es.getD 0 0+1) := by
    intro i hi
    have hil : i+1 < es.length := by have := Finset.mem_range.mp hi; omega
    have hne : primeAt (i+1) ≠ 2 := by
      rw [← primeAt_zero]
      exact primeAt_strictMono.injective.ne (by omega)
    refine ⟨primeAt_prime _,hne,?_⟩
    have hb := h.prime_power_lower Nat.prime_two (primeAt_prime (i+1)) ((hpref _).mpr hil)
    have hf : (number es).factorization 2 = es.getD 0 0 := by
      simpa [primeAt_zero,show 0 < es.length by omega] using factorization_number es 0
    rw [hf] at hb
    have hneq : primeAt (i+1) ≠ 2^(es.getD 0 0+1) := by
      intro heq
      exact hne (((primeAt_prime (i+1)).pow_eq_iff.mp heq.symm).1.symm)
    exact lt_of_le_of_ne hb hneq
  obtain ⟨E,hE,hG⟩ := product_goodCoins (Finset.range (es.length-1))
    (fun i => primeAt (i+1)) (fun i => es.getD (i+1) 0) (es.getD 0 0) hp
  refine ⟨E,?_,?_⟩
  · rw [number_one_split hl]; exact hE
  · rw [number_one_split hl]; exact hG

end Solution

/- Moment -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
open scoped Pointwise

noncomputable def weight (d : ℕ) : ℝ := (Real.sqrt (d : ℝ))⁻¹
noncomputable def divisorWeight (m : ℕ) : ℝ := ∑ d ∈ m.divisors, weight d

lemma weight_nonneg (d : ℕ) : 0 ≤ weight d := by unfold weight; positivity
lemma weight_mul (a b : ℕ) : weight (a*b) = weight a * weight b := by
  simp [weight, Nat.cast_mul, Real.sqrt_mul (Nat.cast_nonneg a), mul_inv_rev, mul_comm]
lemma weight_one : weight 1 = 1 := by simp [weight]
lemma weight_pow (p a : ℕ) : weight (p^a) = weight p ^ a := by
  induction a with
  | zero => simp [weight_one]
  | succ a ih => rw [pow_succ,weight_mul,ih,pow_succ]
lemma divisorWeight_nonneg (m : ℕ) : 0 ≤ divisorWeight m :=
  Finset.sum_nonneg fun d _ => weight_nonneg d

lemma divisorWeight_mul_le (a b : ℕ) : divisorWeight (a*b) ≤ divisorWeight a * divisorWeight b := by
  unfold divisorWeight
  rw [Nat.divisors_mul, Finset.mul_def]
  calc
    (∑ d ∈ Finset.image (fun p : ℕ×ℕ => p.1*p.2) (a.divisors ×ˢ b.divisors), weight d)
      ≤ ∑ d ∈ a.divisors ×ˢ b.divisors, weight (d.1*d.2) :=
        Finset.sum_image_le_of_nonneg (fun d _ => weight_nonneg d)
    _ = _ := by
      rw [Finset.sum_product,Finset.sum_mul_sum]
      simp_rw [weight_mul]

lemma divisorWeight_prime_pow_le {p a : ℕ} {c : ℝ} (hp : p.Prime)
    (hc : 1 < c) (hbound : c^2 ≤ (c-1)^2*(p : ℝ)) : divisorWeight (p^a) ≤ c := by
  have hp0 : 0 < (p : ℝ) := by exact_mod_cast hp.pos
  have hsqrt : 0 < Real.sqrt (p : ℝ) := Real.sqrt_pos.mpr hp0
  have hsq : ((c-1)*Real.sqrt (p : ℝ))^2 ≥ c^2 := by
    rw [mul_pow,Real.sq_sqrt hp0.le]
    exact hbound
  have hprod : c ≤ (c-1)*Real.sqrt (p : ℝ) := by
    have hn : 0 ≤ (c-1)*Real.sqrt (p : ℝ) := mul_nonneg (by linarith) hsqrt.le
    nlinarith
  have hw : c*weight p ≤ c-1 := by
    change c / Real.sqrt (p : ℝ) ≤ c-1
    exact (div_le_iff₀ hsqrt).mpr hprod
  have hwp : 0 ≤ weight p := weight_nonneg p
  have hwlt : weight p < 1 := by nlinarith
  have hrel : 1 ≤ c*(1-weight p) := by nlinarith
  have hsum : (∑ i ∈ Finset.range (a+1), weight p ^ i) * (1-weight p) ≤ 1 := by
    rw [geom_sum_mul_neg]
    have : 0 ≤ weight p ^ (a+1) := pow_nonneg hwp _
    linarith
  have hres : (∑ i ∈ Finset.range (a+1), weight p ^ i) ≤ c := by
    apply (mul_le_mul_iff_left₀ (by linarith : 0 < 1-weight p)).mp
    exact hsum.trans hrel
  simpa only [divisorWeight,Nat.divisors_prime_pow hp,Finset.sum_map,
    Function.Embedding.coeFn_mk,weight_pow] using hres

lemma divisorWeight_prod_le {ι : Type*} [DecidableEq ι] (A : Finset ι)
    (p e : ι → ℕ) (c : ι → ℝ)
    (hp : ∀ i ∈ A, (p i).Prime)
    (hc : ∀ i ∈ A, 1 < c i ∧ (c i)^2 ≤ (c i-1)^2*(p i : ℝ)) :
    divisorWeight (∏ i ∈ A, p i ^ e i) ≤ ∏ i ∈ A, c i := by
  induction A using Finset.induction_on with
  | empty => simp [divisorWeight,weight_one]
  | @insert i A hn ih =>
    have hpA : ∀ j ∈ A, (p j).Prime := fun j hj => hp j (Finset.mem_insert_of_mem hj)
    have hcA : ∀ j ∈ A, 1 < c j ∧ (c j)^2 ≤ (c j-1)^2*(p j : ℝ) :=
      fun j hj => hc j (Finset.mem_insert_of_mem hj)
    have hpi := hp i (Finset.mem_insert_self _ _)
    have hci := hc i (Finset.mem_insert_self _ _)
    rw [Finset.prod_insert hn,Finset.prod_insert hn]
    exact (divisorWeight_mul_le _ _).trans
      (mul_le_mul (divisorWeight_prime_pow_le hpi hci.1 hci.2) (ih hpA hcA)
        (divisorWeight_nonneg _) (by linarith))

lemma count_le_of_divisorWeight {m L K : ℕ} {B : ℝ}
    (hm : 0 < m) (hB : 0 ≤ B) (hw : divisorWeight m ≤ B)
    (hsq : (L : ℝ)*B^2 ≤ (K : ℝ)^2) :
    (m.divisors.filter (fun d => d ≤ L)).card ≤ K := by
  let A := m.divisors.filter (fun d => d ≤ L)
  have hc : (A.card : ℝ) ≤ Real.sqrt (L : ℝ)*divisorWeight m := by
    have hterm : ∀ d ∈ A, (1 : ℝ) ≤ Real.sqrt (L : ℝ)*weight d := by
      intro d hd
      obtain ⟨hdm,hdL⟩ := Finset.mem_filter.mp hd
      have hdpos : 0 < (d : ℝ) := by exact_mod_cast Nat.pos_of_mem_divisors hdm
      have hspos : 0 < Real.sqrt (d : ℝ) := Real.sqrt_pos.mpr hdpos
      change 1 ≤ Real.sqrt (L : ℝ) / Real.sqrt (d : ℝ)
      apply (le_div_iff₀ hspos).mpr
      simpa only [one_mul] using Real.sqrt_le_sqrt (by exact_mod_cast hdL)
    have h₁ := Finset.sum_le_sum hterm
    simp only [Finset.sum_const, nsmul_eq_mul, mul_one, ← Finset.mul_sum] at h₁
    have h₂ : ∑ d ∈ A, weight d ≤ divisorWeight m :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        (fun d _ _ => weight_nonneg d)
    exact h₁.trans (mul_le_mul_of_nonneg_left h₂ (Real.sqrt_nonneg _))
  have hcB : (A.card : ℝ) ≤ Real.sqrt (L : ℝ)*B :=
    hc.trans (mul_le_mul_of_nonneg_left hw (Real.sqrt_nonneg _))
  have hroot : (Real.sqrt (L : ℝ)*B)^2 ≤ (K : ℝ)^2 := by
    rw [mul_pow,Real.sq_sqrt (Nat.cast_nonneg L)]
    exact hsq
  have hK : (0 : ℝ) ≤ K := Nat.cast_nonneg K
  have hnon : 0 ≤ Real.sqrt (L : ℝ)*B := mul_nonneg (Real.sqrt_nonneg _) hB
  have hle : (A.card : ℝ) ≤ K := by nlinarith
  exact_mod_cast hle

def factorNumerators : List ℕ :=
  [3415,2367,1810,1608,1432,1384,1321,1298,1264,1229,1219,1197,1186,
    1180,1171,1160,1150,1147,1140,1135,1133,1127,1124,1119,1114]

def factorCap (i : ℕ) : ℚ :=
  if i < 25 then (factorNumerators.getD i 1000 : ℚ)/1000 else 10/9

def factorProduct (r : ℕ) : ℚ := ∏ i ∈ Finset.range r, factorCap i

lemma factorCap_small (i : ℕ) (hi : i < 25) :
    (1 : ℚ) < factorCap i ∧ (factorCap i)^2 ≤ (factorCap i-1)^2*(primeAt i : ℚ) := by
  interval_cases i <;> norm_num [factorCap, factorNumerators, primeAt, smallPrimes, List.getD]

lemma factorCap_bound (i : ℕ) :
    (1 : ℝ) < (factorCap i : ℝ) ∧ (factorCap i : ℝ)^2 ≤ (factorCap i-1 : ℝ)^2*(primeAt i : ℝ) := by
  by_cases hi : i < 25
  · have hh := factorCap_small i hi
    exact_mod_cast hh
  · have hp : 101 ≤ primeAt i := by
      have hh := primeAt_strictMono.monotone (show 25 ≤ i by omega)
      change 101 ≤ primeAt i at hh
      exact hh
    have hpr : (101 : ℝ) ≤ primeAt i := by exact_mod_cast hp
    norm_num [factorCap,hi]
    nlinarith

lemma factorCap_pos (i : ℕ) : 0 < factorCap i := by
  have hh := (factorCap_bound i).1
  have : (0 : ℝ) < (factorCap i : ℝ) := by linarith
  exact_mod_cast this

lemma factorProduct_nonneg (r : ℕ) : 0 ≤ factorProduct r :=
  Finset.prod_nonneg fun i _ => (factorCap_pos i).le

lemma factorProduct_25 : factorProduct 25 ≤ 1100 := by
  norm_num [factorProduct, Finset.prod_range_succ, factorCap, factorNumerators, List.getD]

lemma factorProduct_large (t : ℕ) : factorProduct (25+t) ≤ 1100*(10/9 : ℚ)^t := by
  unfold factorProduct
  rw [Finset.prod_range_add]
  have heq : ∏ i ∈ Finset.range t, factorCap (25+i) = (10/9 : ℚ)^t := by
    simp [factorCap,show ∀ i : ℕ, ¬25+i < 25 by omega, div_pow]
  rw [heq]
  exact mul_le_mul_of_nonneg_right factorProduct_25 (by positivity)

lemma divisorWeight_prefix_le {M r : ℕ} (hM : 0 < M)
    (hpref : ∀ i, primeAt i ∣ M ↔ i < r) : divisorWeight M ≤ (factorProduct r : ℝ) := by
  calc
    divisorWeight M = divisorWeight (∏ i ∈ Finset.range r, primeAt i ^ M.factorization (primeAt i)) :=
      congrArg divisorWeight (prefix_value hM hpref)
    _ ≤ ∏ i ∈ Finset.range r, (factorCap i : ℝ) :=
      divisorWeight_prod_le _ _ _ _ (fun i _ => primeAt_prime i) (fun i _ => factorCap_bound i)
    _ = _ := by simp [factorProduct]

lemma prefix_twice {H r : ℕ} (hH : 0 < H)
    (hpref : ∀ i, primeAt i ∣ H ↔ i < r) (hr : 0 < r) :
    ∀ i, primeAt i ∣ 2*H ↔ i < r := by
  have h2d : 2 ∣ H := by simpa [primeAt_zero] using (hpref 0).mpr hr
  intro i
  constructor
  · intro hd
    rcases (primeAt_prime i).dvd_mul.mp hd with hd | hd
    · rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
      · exact False.elim ((primeAt_prime i).ne_one h1)
      · apply (hpref i).mp
        rwa [h2]
    · exact (hpref i).mp hd
  · intro hi
    exact ((hpref i).mpr hi).trans ⟨2,by ring⟩

lemma count_twice_le_of_factorProduct {H r K : ℕ} (hH : 0 < H)
    (hpref : ∀ i, primeAt i ∣ H ↔ i < r) (hr : 0 < r)
    (hb : (2*tau (2*H) : ℚ)*(factorProduct r)^2 ≤ (K : ℚ)^2) :
    ((2*H).divisors.filter (fun d => d ≤ 2*(2*H).divisors.card)).card ≤ K := by
  have hm : 0 < 2*H := by omega
  apply count_le_of_divisorWeight (B := (factorProduct r : ℝ)) hm
  · exact_mod_cast factorProduct_nonneg r
  · exact divisorWeight_prefix_le hm (prefix_twice hH hpref hr)
  · change ((2*tau (2*H) : ℕ) : ℝ)*(factorProduct r : ℝ)^2 ≤ (K : ℝ)^2
    exact_mod_cast hb

end Solution

