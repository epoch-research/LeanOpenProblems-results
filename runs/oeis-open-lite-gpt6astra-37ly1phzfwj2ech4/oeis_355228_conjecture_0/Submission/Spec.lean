/- HighCert -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
lemma certify_high {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (hc : n ≤ 512 ∨ Prim n (2*number es))
    (hb : number [7,3,1,1,1,1] < number es) :
    ∃ w, Prim n w ∧ w ≤ 2*number es := by
  have hn : ¬n ≤ 512 := by
    intro hn
    have ht : n ≤ tau (number [7,3,1,1,1,1]) := by
      rw [tau_number]
      exact hn
    have hh := h.2.2 (number [7,3,1,1,1,1]) (number_pos _) ht
    omega
  exact ⟨2*number es,hc.resolve_left hn,le_rfl⟩
end Solution

