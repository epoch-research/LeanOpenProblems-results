set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

lemma tail_six {es : List ℕ} (hl : 2 ≤ es.length)
    (he : ∀ i, i < es.length → 0 < es.getD i 0) :
    Nat.Coprime 6 (tailNumber es 2) ∧ 6*tailNumber es 2 ∣ number es := by
  have h2 : Nat.Coprime 2 (tailNumber es 2) := coprime_prime_tail (i:=0) (by decide)
  have h3 : Nat.Coprime 3 (tailNumber es 2) := coprime_prime_tail (i:=1) (by decide)
  refine ⟨h2.mul_left h3, ?_⟩
  rw [number_two_split hl]
  have hd2 : 2 ∣ 2^es.getD 0 0 := dvd_pow_self _ (by have := he 0 (by omega); omega)
  have hd3 : 3 ∣ 3^es.getD 1 0 := dvd_pow_self _ (by have := he 1 (by omega); omega)
  simpa only [← Nat.mul_assoc, show 2*3=6 from rfl] using Nat.mul_dvd_mul (Nat.mul_dvd_mul hd2 hd3) (dvd_refl (tailNumber es 2))

lemma number_dvd_323 {es : List ℕ} (hl : 8 ≤ es.length)
    (he : ∀ i, i < es.length → 0 < es.getD i 0) : 323 ∣ number es := by
  have hd17 : 17 ∣ number es := (number_prefix he 6).mpr (by omega)
  have hd19 : 19 ∣ number es := (number_prefix he 7).mpr (by omega)
  exact (show Nat.Coprime 17 19 by decide).mul_dvd_of_dvd_of_dvd hd17 hd19

lemma generic_from_count {n T : ℕ} {es : List ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hl : 8 ≤ es.length)
    (hT : coinCost es ≤ T)
    (hsize : 4*T+2 ≤ dcount es)
    (hRc : 4*T ≤ tailCount es 2) (hRs : (4*T)^2 ≤ tailNumber es 2)
    (hK : 2*T ≤ tailCount es 1)
    (hc : ((2*number es).divisors.filter (fun d => d ≤ 2*(2*number es).divisors.card)).card
      ≤ tailCount es 1 - 2*T) : Prim n (2*number es) := by
  have hl1 : 1 ≤ es.length := by omega
  have hl2 : 2 ≤ es.length := by omega
  obtain ⟨E,hE,hcoins⟩ := smallest_goodCoins h he hl1
  have hcoins' : GoodCoins E (number es) T :=
    ⟨hcoins.1,hcoins.2.1,hcoins.2.2.1,hcoins.2.2.2.trans hT⟩
  have hH1 : 1 < number es := by
    have hd : 2 ∣ number es := (number_prefix he 0).mpr (by omega)
    have := Nat.le_of_dvd (number_pos es) hd
    omega
  have ht := h.tau_lt_twice hH1
  rw [tau_number] at ht
  have hn : 2+2*T ≤ n := by omega
  have hcount : n+2*T + ((2*number es).divisors.filter (fun d => d ≤ 2*(2*number es).divisors.card)).card
      ≤ (2*number es).divisors.card := by
    have hnupper := h.2.1
    rw [tau_number,dcount_one_split hl1] at hnupper
    change _ ≤ tau (2*number es)
    rw [tau_twice_number hl1]
    have hgap : 2*T + ((2*number es).divisors.filter (fun d => d ≤ 2*(2*number es).divisors.card)).card
        ≤ tailCount es 1 := by omega
    nlinarith
  have h6 := tail_six hl2 he
  exact construct_from_count (number_pos es) (number_dvd_323 hl he) hE hcoins'
    (tailNumber_pos es 2) h6.1 h6.2 (by rwa [← tau_tailNumber] at hRc) hRs hn hcount

lemma generic_from_moment {n T : ℕ} {es : List ℕ} (h : Smallest n (number es))
    (he : ∀ i, i < es.length → 0 < es.getD i 0) (hl : 8 ≤ es.length)
    (hT : coinCost es ≤ T)
    (hsize : 4*T+2 ≤ dcount es)
    (hRc : 4*T ≤ tailCount es 2) (hRs : (4*T)^2 ≤ tailNumber es 2)
    (hK : 2*T ≤ tailCount es 1)
    (hc : (2*((es.getD 0 0+2)*tailCount es 1) : ℚ)*(factorProduct es.length)^2
      ≤ ((tailCount es 1 - 2*T : ℕ) : ℚ)^2) : Prim n (2*number es) := by
  apply generic_from_count h he hl hT hsize hRc hRs hK
  apply count_twice_le_of_factorProduct (number_pos es) (number_prefix he) (by omega)
  simpa only [tau_twice_number (show 1 ≤ es.length by omega),Nat.cast_mul,Nat.cast_add,Nat.cast_ofNat] using hc

end Solution

