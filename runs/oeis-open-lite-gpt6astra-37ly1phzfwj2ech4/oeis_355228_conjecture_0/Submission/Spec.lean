/- Records -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
lemma smallest_finite_record {n : ℕ} {es : List ℕ} (h : Smallest n (number es))
    (he : es ∈ enumVectors es.length) (hl : es.length < 25) :
    ∃ i, i < 796 ∧ number es = number (recV i) := by
  have hcheck := List.all_eq_true.mp (dominance_all es.length hl) es he
  dsimp only at hcheck
  simp only [fastNumber_eq,fastCount_eq] at hcheck
  obtain ⟨hi,hnum,hcount⟩ := of_decide_eq_true hcheck
  have hd := records_data _ (Finset.mem_range.mpr hi)
  rw [hd.1] at hnum
  rw [hd.2] at hcount
  have hn : n ≤ dcount es := by simpa only [tau_number] using h.2.1
  have hsmall := h.2.2 (number (recV (chooseRec (number es)))) (number_pos _)
    (by rw [tau_number]; exact hn.trans hcount)
  exact ⟨_,hi,Nat.le_antisymm hsmall hnum⟩
end Solution

