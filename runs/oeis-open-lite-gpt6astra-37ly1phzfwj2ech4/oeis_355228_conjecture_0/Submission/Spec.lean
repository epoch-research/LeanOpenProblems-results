    boundedSum (twiceFactors es) c.cutoff ≤
      (2*number es - c.W - c.U.sum id) + (c.R.filter (fun d => d ≤ c.cutoff)).sum id)

lemma reserveFast_sound {es : List ℕ} {c : ReserveData} {n : ℕ}
    (h : Smallest n (number es)) (hc : reserveFast es c = true) : Prim n (2*number es) := by
  obtain ⟨hcomplete,hc⟩ := Bool.and_eq_true_iff.mp hc
  obtain ⟨hl,hUc,hUl,hUp,hdiv,hUE,hUF,hEF,hcov,hEc,hAp,hAd,hsize,hbudget,hcount,hsum⟩ := of_decide_eq_true hc
  have hm : 0 < 2*number es := by have := number_pos es; omega
  have hR : c.R ⊆ (2*number es).divisors := fun d hd => Nat.mem_divisors.mpr ⟨hdiv d hd,hm.ne'⟩
  have hE : c.E ⊆ c.R := Finset.subset_union_left.trans Finset.subset_union_left
  have hF : c.F ⊆ c.R := Finset.subset_union_right.trans Finset.subset_union_left
  have hU : c.U ⊆ c.R := Finset.subset_union_right
  have htau : tau (2*number es) = dcount es + tailCount es 1 := by
    rw [tau_twice_number hl,dcount_one_split hl]; ring
  rw [← htau] at hcount
  obtain ⟨B,hB,hRB,hBc,hBs⟩ := bounded_pool (twiceFactors_valid es) (twiceFactors_number hl) hR hcount hsum
  have hH1 : 1 < number es := by
    by_contra hh
    have hH : number es = 1 := by have := number_pos es; omega
    have ht : dcount es = 1 := by rw [← tau_number,hH]; rfl
    omega
  have ht := h.tau_lt_twice hH1
  rw [tau_number] at ht
  have hn : c.U.card + 2*c.T ≤ n := by omega
  have hnu : n ≤ dcount es := by simpa only [tau_number] using h.2.1
  have hBcn : n-c.U.card-2*c.T ≤ B.card := by omega
  have hpad : Pads c.F c.T c.W := pads_biUnion_of_card hAp hAd
  have hb : B.sum id+c.W+c.U.sum id ≤ 2*number es := by omega
  exact reserve hm (hU.trans hR) (hE.trans hR) (hF.trans hR) hB hUE hUF
    (hRB.mono_left hU) hEF (hRB.mono_left hE) (hRB.mono_left hF) hUl hUp
    (completeCheck_sound hcomplete) hcov hEc hpad hn hBcn hb

lemma certify_reserve_fast {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (c : ReserveData) (hc : reserveFast es c = true) : n ≤ 512 ∨ Prim n (2*number es) :=
  Or.inr (reserveFast_sound h hc)
