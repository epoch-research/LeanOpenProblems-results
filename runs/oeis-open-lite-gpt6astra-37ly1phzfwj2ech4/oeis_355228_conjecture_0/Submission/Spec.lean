lemma twice_bound {n : ℕ} (hn : 3 ≤ n) (hne : ¬Exceptional n) : TwiceBound n := by
  intro H h
  obtain ⟨es,hvalue,he,henum⟩ := smallest_vector h
  subst H
  by_cases hl : es.length < 25
  · obtain ⟨i,hi,hEq⟩ := smallest_finite_record h henum hl
    have h' : Smallest n (number (recV i)) := hEq ▸ h
    obtain ⟨w,hw,hwle⟩ := record_solved i hi h' hn hne
    rw [← hEq] at hwle
    exact ⟨w,hw,hwle⟩
  · exact ⟨2*number es,smallest_large h he (by omega),le_rfl⟩

lemma all_dominates (n : ℕ) (h4 : n ≠ 4) (h5 : n ≠ 5) : Dominates n := by
  by_cases hn : n < 3
  · interval_cases n
    · exact dominates_zero
    · exact dominates_one
    · exact dominates_two
  · by_cases hx : Exceptional n
    · rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact False.elim (h4 rfl)
      · exact False.elim (h5 rfl)
      · exact dominates_8
      · exact dominates_9
      · exact dominates_10
      · exact dominates_16
      · exact dominates_20
      · exact dominates_24
      · exact dominates_30
    · exact (twice_bound (by omega) hx).dominates

lemma final_conjecture (n : ℕ) : (a n > a081512 n) ↔ (n=4 ∨ n=5) := by
  constructor
  · intro h
    by_contra hh
    have h4 : n ≠ 4 := fun h4 => hh (Or.inl h4)
    have h5 : n ≠ 5 := fun h5 => hh (Or.inr h5)
    have hle := a_le_of_dominates (all_dominates n h4 h5)
    omega
  · rintro (rfl | rfl)
    · exact strict_four
    · exact strict_five

end Solution

/--
A355228 a(n) >= A081512(n) because in A081512, it is not required that m = lcm(d_1, d_2, ..., d_n).
Currently, the strict inequality happens for n = 4 and n = 5; are there other such cases?

This conjecture states that the set of natural numbers $n$ for which the strict inequality $a(n) > a_081512(n)$ holds is exactly $\{4, 5\}$.
-/
theorem oeis_355228_conjecture_0 (n : ℕ) :
  (a n > a081512 n) ↔ (n = 4 ∨ n = 5) := by
  exact Solution.final_conjecture n

theorem oeis_355228_conjecture_0.disproof : ¬ (type_of% @oeis_355228_conjecture_0) := sorry
