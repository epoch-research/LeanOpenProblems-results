/- SubsetBounds -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

lemma sum_take_succ_le (l : List ℕ) (a n : ℕ) (ha : ∀ x ∈ l, x ≤ a) :
    (l.take (n+1)).sum ≤ (l.take n).sum+a := by
  induction n generalizing l with
  | zero => cases l with
    | nil => simp
    | cons x l => simpa using ha x (by simp)
  | succ n ih =>
    cases l with
    | nil => simp
    | cons x l =>
      simp only [List.take_succ_cons,List.sum_cons]
      have hh := ih l (fun y hy => ha y (by simp [hy]))
      omega

lemma sublist_sum_le_take {s l : List ℕ} (hs : s.Sublist l) (hl : l.Pairwise (· ≥ ·)) :
    s.sum ≤ (l.take s.length).sum := by
  induction hs with
  | slnil => simp
  | @cons s l a hs ih =>
    have hh := List.pairwise_cons.mp hl
    have hb := ih hh.2
    cases hn : s.length with
    | zero => have hz := List.length_eq_zero_iff.mp hn; subst s; simp
    | succ n =>
      have ht := sum_take_succ_le l a n hh.1
      simp only [hn,List.take_succ_cons,List.sum_cons]
      rw [hn] at hb
      omega
  | @cons₂ s l a hs ih =>
    have hh := List.pairwise_cons.mp hl
    have hb := ih hh.2
    simpa only [List.length_cons,List.take_succ_cons,List.sum_cons] using Nat.add_le_add_left hb a

lemma finset_sum_le_take {D : Finset ℕ} {l : List ℕ} (hD : D ⊆ l.toFinset)
    (hn : l.Nodup) (hl : l.Pairwise (· ≥ ·)) : D.sum id ≤ (l.take D.card).sum := by
  let s := l.filter (fun d => d ∈ D)
  have hs : s.toFinset = D := by
    ext d
    simp only [s,List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
    exact ⟨fun hd => hd.2,fun hd => ⟨List.mem_toFinset.mp (hD hd),hd⟩⟩
  have hsn : s.Nodup := hn.filter _
  have hlen : s.length = D.card := by rw [← hs,List.toFinset_card_of_nodup hsn]
  have hsum : s.sum = D.sum id := by rw [← hs,List.sum_toFinset id hsn,List.map_id]
  have hb := sublist_sum_le_take (List.filter_sublist (p:=fun d => decide (d ∈ D)) (l:=l)) hl
  change s.sum ≤ (l.take s.length).sum at hb
  rwa [hlen,hsum] at hb

lemma finset_sum_bounds {D : Finset ℕ} {l : List ℕ} (hD : D ⊆ l.toFinset)
    (hn : l.Nodup) (hl : l.Pairwise (· ≥ ·)) :
    D.card ≤ l.length ∧ l.sum - (l.take (l.length-D.card)).sum ≤ D.sum id ∧
      D.sum id ≤ (l.take D.card).sum := by
  have hc := Finset.card_le_card hD
  rw [List.toFinset_card_of_nodup hn] at hc
  refine ⟨hc,?_,finset_sum_le_take hD hn hl⟩
  have hb := finset_sum_le_take (D:=l.toFinset \ D) Finset.sdiff_subset hn hl
  have hcard := Finset.card_sdiff_of_subset hD
  rw [List.toFinset_card_of_nodup hn] at hcard
  rw [hcard] at hb
  have hsum := Finset.sum_sdiff hD (f:=id)
  rw [List.sum_toFinset id hn,List.map_id] at hsum
  change (l.toFinset \ D).sum id + D.sum id = l.sum at hsum
  omega

end Solution

/- Possible -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def possible (need : Bool) (M : ℕ) : List ℕ → ℕ → ℕ → ℕ → Bool
  | l,n,s,g =>
    if n=0 then decide (s=0 ∧ (need=true → g=M))
    else if n ≤ l.length ∧ l.sum-(l.take (l.length-n)).sum ≤ s ∧ s ≤ (l.take n).sum then
      match l with
      | [] => false
      | x::xs => possible need M xs n s g ||
          (decide (x ≤ s) && possible need M xs (n-1) (s-x) (Nat.lcm g x))
    else false
termination_by l => l.length

lemma possible_complete {need : Bool} {M g n s : ℕ} {l : List ℕ} {D : Finset ℕ}
    (hD : D ⊆ l.toFinset) (hnod : l.Nodup) (hord : l.Pairwise (· ≥ ·))
    (hcard : D.card = n) (hsum : D.sum id = s)
    (hlcm : need=true → Nat.lcm g (D.lcm id) = M) : possible need M l n s g = true := by
  induction l generalizing D n s g with
  | nil =>
    have hDe : D=∅ := Finset.eq_empty_iff_forall_notMem.mpr (fun d hd => by simpa using hD hd)
    subst D
    simp only [Finset.card_empty] at hcard
    simp only [Finset.sum_empty] at hsum
    subst n; subst s
    simp only [Finset.lcm_empty,Nat.lcm_one_right] at hlcm
    cases need <;> simp_all [possible]
  | cons x xs ih =>
    by_cases hn : n=0
    · have hDe : D=∅ := Finset.card_eq_zero.mp (hcard.trans hn)
      subst D
      simp only [Finset.sum_empty] at hsum
      subst s
      simp only [Finset.lcm_empty,Nat.lcm_one_right] at hlcm
      cases need <;> simp_all [possible]
    · have hb := finset_sum_bounds hD hnod hord
      rw [hcard,hsum] at hb
      rw [possible,if_neg hn,if_pos hb]
      have ht := (List.pairwise_cons.mp hord).2
      have hnt := (List.nodup_cons.mp hnod).2
      by_cases hx : x ∈ D
      · apply Bool.or_eq_true_iff.mpr
        right
        have hDE : D.erase x ⊆ xs.toFinset := by
          intro d hd
          have hdm := (Finset.mem_erase.mp hd).2
          have hdx := (Finset.mem_erase.mp hd).1
          have hh := hD hdm
          simp only [List.toFinset_cons,Finset.mem_insert] at hh
          rcases hh with hh | hh
          · exact False.elim (hdx hh)
          · exact hh
        have hce : (D.erase x).card = n-1 := by rw [Finset.card_erase_of_mem hx,hcard]
        have hse := Finset.sum_erase_add _ id hx
        change (D.erase x).sum id + x = D.sum id at hse
        rw [hsum] at hse
        have hxe : x ≤ s := by omega
        have hsumE : (D.erase x).sum id = s-x := by omega
        apply Bool.and_eq_true_iff.mpr
        refine ⟨decide_eq_true hxe,ih hDE hnt ht hce hsumE ?_⟩
        intro hneed
        have hdL : D.lcm id = Nat.lcm x ((D.erase x).lcm id) := by
          conv_lhs => rw [← Finset.insert_erase hx,Finset.lcm_insert]
          rfl
        rw [Nat.lcm_assoc,← hdL]
        exact hlcm hneed
      · apply Bool.or_eq_true_iff.mpr
        left
        apply ih (D:=D) ?_ hnt ht hcard hsum hlcm
        intro d hd
        have hh := hD hd
        simp only [List.toFinset_cons,Finset.mem_insert] at hh
        rcases hh with rfl | hh
        · exact False.elim (hx hd)
        · exact hh

def descendingDivisors (m : ℕ) : List ℕ := ((List.range (m+1)).reverse).filter (fun d => 0 < d ∧ d ∣ m)

lemma descendingDivisors_toFinset (m : ℕ) : (descendingDivisors m).toFinset = m.divisors := by
  ext d
  simp only [descendingDivisors,List.mem_toFinset,List.mem_filter,List.mem_reverse,List.mem_range,
    decide_eq_true_eq,Nat.divisors,Finset.mem_filter,Finset.mem_Ico]
  omega

lemma descendingDivisors_nodup (m : ℕ) : (descendingDivisors m).Nodup :=
  List.Nodup.filter _ (List.nodup_reverse.mpr List.nodup_range)

lemma descendingDivisors_order (m : ℕ) : (descendingDivisors m).Pairwise (· ≥ ·) :=
  (List.pairwise_reverse.mpr List.pairwise_le_range).filter _

def candidateCheck (need : Bool) (n m : ℕ) : Bool :=
  possible need m (descendingDivisors m) n m 1

lemma candidateCheck_complete {n m : ℕ} (h : Cand n m) : candidateCheck false n m = true := by
  obtain ⟨hm,D,hD,hc,hs⟩ := h
  apply possible_complete (D:=D) ?_ (descendingDivisors_nodup _) (descendingDivisors_order _) hc hs
  · intro hh; contradiction
  · simpa only [descendingDivisors_toFinset] using hD

lemma primitiveCheck_complete {n m : ℕ} (h : Prim n m) : candidateCheck true n m = true := by
  obtain ⟨hm,D,hD,hc,hs,hl⟩ := h
  apply possible_complete (D:=D) ?_ (descendingDivisors_nodup _) (descendingDivisors_order _) hc hs
  · intro _; simpa only [Nat.lcm_one_left] using hl
  · simpa only [descendingDivisors_toFinset] using hD

end Solution

/- PossibleFast -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def fastPossible (need : Bool) (M : ℕ) : List ℕ → ℕ → ℕ → ℕ → Bool
  | [],n,s,g => if n=0 then decide (s=0 ∧ (need=true → g=M)) else false
  | x::xs,n,s,g =>
    if n=0 then decide (s=0 ∧ (need=true → g=M))
    else if n ≤ (x::xs).length ∧ (x::xs).sum-((x::xs).take ((x::xs).length-n)).sum ≤ s ∧ s ≤ ((x::xs).take n).sum then
      fastPossible need M xs n s g ||
          (decide (x ≤ s) && fastPossible need M xs (n-1) (s-x) (Nat.lcm g x))
    else false

lemma fastPossible_eq (need : Bool) (M : ℕ) (l : List ℕ) (n s g : ℕ) :
    fastPossible need M l n s g = possible need M l n s g := by
  induction l generalizing n s g with
  | nil =>
    by_cases hn : n=0
    · simp [fastPossible,possible,hn]
    · simp [fastPossible,possible,hn]
  | cons x xs ih =>
    rw [fastPossible,possible]
    simp only [ih]

def fastCandidateCheck (need : Bool) (n m : ℕ) : Bool :=
  fastPossible need m (descendingDivisors m) n m 1

lemma fastCandidateCheck_eq (need : Bool) (n m : ℕ) :
    fastCandidateCheck need n m = candidateCheck need n m := fastPossible_eq _ _ _ _ _ _
end Solution

/- SmallDivisors -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def sortedUnique (l : List ℕ) : List ℕ := l.dedup.insertionSort (· ≥ ·)
lemma sortedUnique_nodup (l : List ℕ) : (sortedUnique l).Nodup :=
  (List.nodup_dedup l).perm (List.perm_insertionSort _ _).symm
lemma sortedUnique_order (l : List ℕ) : (sortedUnique l).Pairwise (· ≥ ·) :=
  List.pairwise_insertionSort _ _
lemma sortedUnique_toFinset (l : List ℕ) : (sortedUnique l).toFinset = l.toFinset := by
  ext x
  simp only [List.mem_toFinset,sortedUnique,List.mem_insertionSort,List.mem_dedup]

def smallDivisors (m : ℕ) : List ℕ := if m=0 then [] else sortedUnique (divisorList (smallFactors m))
lemma smallDivisors_eq (m : ℕ) (hm : m < 1680) : smallDivisors m = descendingDivisors m := by
  by_cases h0 : m=0
  · subst m; simp [smallDivisors,descendingDivisors]
  · have hf := smallFactors_correct m (by omega) hm
    have he : (smallDivisors m).toFinset = (descendingDivisors m).toFinset := by
      rw [smallDivisors,if_neg h0,sortedUnique_toFinset,divisorList_toFinset hf.1,hf.2,
        descendingDivisors_toFinset]
    have hn : (smallDivisors m).Nodup := by rw [smallDivisors,if_neg h0]; exact sortedUnique_nodup _
    have ho : (smallDivisors m).Pairwise (· ≥ ·) := by rw [smallDivisors,if_neg h0]; exact sortedUnique_order _
    exact List.Perm.eq_of_pairwise' ho (descendingDivisors_order m)
      (List.perm_of_nodup_nodup_toFinset_eq hn (descendingDivisors_nodup m) he)

def smallCheck (need : Bool) (n m : ℕ) : Bool := fastPossible need m (smallDivisors m) n m 1
lemma smallCheck_eq (need : Bool) (n m : ℕ) (hm : m < 1680) : smallCheck need n m = candidateCheck need n m := by
  unfold smallCheck candidateCheck
  rw [smallDivisors_eq m hm,fastPossible_eq]
end Solution

/- BasicCases -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

lemma dominates_zero : Dominates 0 := by
  intro m hm
  obtain ⟨hm,D,hD,hc,hs⟩ := hm
  have hDe : D=∅ := Finset.card_eq_zero.mp hc
  simp [hDe] at hs
  omega

lemma dominates_one : Dominates 1 := by
  intro m hm
  obtain ⟨hm,D,hD,hc,hs⟩ := hm
  obtain ⟨d,rfl⟩ := Finset.card_eq_one.mp hc
  have heq : d=m := by simpa using hs
  subst d
  exact ⟨m,⟨hm,{m},hD,by simp,by simp,by simp⟩,le_rfl⟩

lemma proper_divisor_twice {d m : ℕ} (hd : d ∣ m) (hlt : d < m) : 2*d ≤ m := by
  obtain ⟨q,hq⟩ := hd
  have hq2 : 2 ≤ q := by
    by_contra hh
    interval_cases q <;> simp_all
  rw [hq]
  nlinarith

lemma dominates_two : Dominates 2 := by
  intro m hm
  obtain ⟨hm,D,hD,hc,hs⟩ := hm
  obtain ⟨x,y,hxy,rfl⟩ := Finset.card_eq_two.mp hc
  have hx := hD (Finset.mem_insert_self _ _)
  have hy := hD (Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
  have hxp := Nat.pos_of_mem_divisors hx
  have hyp := Nat.pos_of_mem_divisors hy
  have hxd := (Nat.mem_divisors.mp hx).1
  have hyd := (Nat.mem_divisors.mp hy).1
  have hsum : x+y=m := by simpa [hxy] using hs
  have hx2 := proper_divisor_twice hxd (show x < m by omega)
  have hy2 := proper_divisor_twice hyd (show y < m by omega)
  omega

lemma dominates_from_check {n M : ℕ} (hw : Prim n M)
    (hc : ∀ m ∈ Finset.range M, candidateCheck false n m = false) : Dominates n := by
  intro m hm
  refine ⟨M,hw,?_⟩
  by_contra hh
  have ht := hc m (Finset.mem_range.mpr (by omega))
  rw [candidateCheck_complete hm] at ht
  contradiction

lemma strict_from_checks {n C P : ℕ} (hc : Cand n C) (hp : Prim n P)
    (hn : ∀ m ∈ Finset.range (C+1), candidateCheck true n m = false) : a081512 n < a n := by
  classical
  have hC : a081512 n ≤ C := Nat.sInf_le hc
  have hmin : Prim n (a n) := Nat.sInf_mem (show ({m | Prim n m} : Set ℕ).Nonempty from ⟨P,hp⟩)
  have ha : C < a n := by
    by_contra hh
    have ht := hn (a n) (Finset.mem_range.mpr (by omega))
    rw [primitiveCheck_complete hmin] at ht
    contradiction
  exact hC.trans_lt ha

end Solution

