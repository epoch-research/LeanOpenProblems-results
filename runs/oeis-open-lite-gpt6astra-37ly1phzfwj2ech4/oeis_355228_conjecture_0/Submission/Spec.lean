/- CardPads -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
lemma triple_card {d : ℕ} (hd : 0 < d) : (triple d).card = 3 := by
  simp [triple,show d ≠ 2*d by omega,show d ≠ 3*d by omega,show 2*d ≠ 3*d by omega]

lemma triples_card_le {A : Finset ℕ} (hp : ∀ d ∈ A, 0 < d) :
    (A.biUnion triple).card ≤ 3*A.card := by
  have hh := Finset.card_biUnion_le (s:=A) (t:=triple)
  have hs : (∑ d ∈ A, (triple d).card) = 3*A.card := by
    simp_rw [Finset.sum_congr rfl (fun d hd => triple_card (hp d hd))]
    simp; ring
  exact hh.trans_eq hs

lemma pads_biUnion_of_card {A : Finset ℕ} (hp : ∀ d ∈ A, 0 < d)
    (hc : (A.biUnion triple).card = 3*A.card) : Pads (A.biUnion triple) A.card (A.sum (fun d => 3*d)) := by
  induction A using Finset.induction_on with
  | empty =>
    apply pads_biUnion <;> simp
  | @insert d A hn ih =>
    have hpA : ∀ e ∈ A, 0 < e := fun e he => hp e (Finset.mem_insert_of_mem he)
    have hpd : 0 < d := hp d (Finset.mem_insert_self _ _)
    have hd3 := triple_card hpd
    rw [Finset.biUnion_insert,Finset.card_insert_of_notMem hn] at hc
    have hbound := triples_card_le hpA
    have hsumcard := Finset.card_union_add_card_inter (triple d) (A.biUnion triple)
    rw [hd3,hc] at hsumcard
    have hce : (A.biUnion triple).card = 3*A.card := by omega
    have hi0 : ((triple d) ∩ A.biUnion triple).card = 0 := by omega
    have hdis : Disjoint (triple d) (A.biUnion triple) := Finset.disjoint_iff_inter_eq_empty.mpr
      (Finset.card_eq_zero.mp hi0)
    have hh := pads_union (pads_triple hpd) (ih hpA hce) hdis
    simpa only [Finset.biUnion_insert,Finset.card_insert_of_notMem hn,Finset.sum_insert hn,Nat.add_comm 1] using hh
end Solution

/- ReserveCert -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def completeCheck : List ℕ → Bool
  | [] => true
  | x::xs => decide (x ∉ xs.toFinset ∧ x ≤ xs.toFinset.sum id+1) && completeCheck xs

lemma completeCheck_sound {xs : List ℕ} (h : completeCheck xs = true) : Complete xs.toFinset := by
  induction xs with
  | nil => exact complete_empty
  | cons x xs ih =>
    obtain ⟨h1,h2⟩ := Bool.and_eq_true_iff.mp h
    obtain ⟨hx,hbound⟩ := of_decide_eq_true h1
    simpa only [List.toFinset_cons] using complete_insert (ih h2) hx hbound

structure ReserveData where
  coins : List ℕ
  bases : List ℕ
  u : ℕ
  v : ℕ
  cutoff : ℕ
  deriving Inhabited

def ReserveData.E (c : ReserveData) := c.coins.toFinset
def ReserveData.A (c : ReserveData) := c.bases.toFinset
def ReserveData.F (c : ReserveData) := c.A.biUnion triple
def ReserveData.U (c : ReserveData) : Finset ℕ := {c.u,c.v}
def ReserveData.R (c : ReserveData) := (c.E ∪ c.F) ∪ c.U
def ReserveData.T (c : ReserveData) := c.A.card
def ReserveData.W (c : ReserveData) := c.A.sum (fun d => 3*d)

noncomputable def reserveCheck (es : List ℕ) (c : ReserveData) : Bool :=
  completeCheck c.coins && decide (
    0 < es.length ∧
    c.U.card = 2 ∧ c.U.lcm id = 2*number es ∧ 0 < c.U.sum id ∧
    (∀ d ∈ c.R, d ∣ 2*number es) ∧
    Disjoint c.U c.E ∧ Disjoint c.U c.F ∧ Disjoint c.E c.F ∧
    2*number es ≤ c.E.sum id+1 ∧ c.E.card ≤ c.T ∧
    (∀ d ∈ c.A, 0 < d) ∧
    (∀ d ∈ c.A, ∀ e ∈ c.A, d ≠ e → Disjoint (triple d) (triple e)) ∧
    4*c.T+2 ≤ dcount es ∧
    c.W+c.U.sum id ≤ 2*number es ∧
    (dcount es - 2 - 2*c.T) + (c.R.filter (fun d => d ≤ c.cutoff)).card +
      boundedCount (twiceFactors es) ((2*number es)/(c.cutoff+1)) ≤ dcount es + tailCount es 1 ∧
    boundedSum (twiceFactors es) c.cutoff ≤
      (2*number es - c.W - c.U.sum id) + (c.R.filter (fun d => d ≤ c.cutoff)).sum id)

lemma reserveCheck_sound {es : List ℕ} {c : ReserveData} {n : ℕ}
    (h : Smallest n (number es)) (hc : reserveCheck es c = true) : Prim n (2*number es) := by
  obtain ⟨hcomplete,hc⟩ := Bool.and_eq_true_iff.mp hc
  obtain ⟨hl,hUc,hUl,hUp,hdiv,hUE,hUF,hEF,hcov,hEc,hAp,hAd,hsize,hbudget,hcount,hsum⟩ := of_decide_eq_true hc
  have hm : 0 < 2*number es := by have := number_pos es; omega
  have hR : c.R ⊆ (2*number es).divisors := fun d hd => Nat.mem_divisors.mpr ⟨hdiv d hd,hm.ne'⟩
  have hE : c.E ⊆ c.R := Finset.subset_union_left.trans Finset.subset_union_left
  have hF : c.F ⊆ c.R := Finset.subset_union_right.trans Finset.subset_union_left
  have hU : c.U ⊆ c.R := Finset.subset_union_right
  have htau : tau (2*number es) = dcount es + tailCount es 1 := by
    rw [tau_twice_number hl,dcount_one_split hl]; ring
  rw [← htau] at hcount
  obtain ⟨B,hB,hRB,hBc,hBs⟩ := bounded_pool (twiceFactors_valid es) (twiceFactors_number hl) hR hcount hsum
  have hH1 : 1 < number es := by
    by_contra hh
    have hH : number es = 1 := by have := number_pos es; omega
    have ht : dcount es = 1 := by rw [← tau_number,hH]; rfl
    omega
  have ht := h.tau_lt_twice hH1
  rw [tau_number] at ht
  have hn : c.U.card + 2*c.T ≤ n := by omega
  have hnu : n ≤ dcount es := by simpa only [tau_number] using h.2.1
  have hBcn : n-c.U.card-2*c.T ≤ B.card := by omega
  have hpad : Pads c.F c.T c.W := pads_biUnion hAp hAd
  have hb : B.sum id+c.W+c.U.sum id ≤ 2*number es := by omega
  exact reserve hm (hU.trans hR) (hE.trans hR) (hF.trans hR) hB hUE hUF
    (hRB.mono_left hU) hEF (hRB.mono_left hE) (hRB.mono_left hF) hUl hUp
    (completeCheck_sound hcomplete) hcov hEc hpad hn hBcn hb

end Solution

/- CertHelper -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
lemma certify_cube {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (hp : ∀ i : Fin es.length, 0 < es.getD i 0) (hc : cubeCheck es = true) :
    n ≤ 512 ∨ Prim n (2*number es) := by
  exact Or.inr (cubeCheck_sound h (fun i hi => hp ⟨i,hi⟩) hc)
lemma certify_small {es : List ℕ} {n : ℕ} (h : Smallest n (number es)) (hc : dcount es ≤ 512) :
    n ≤ 512 ∨ Prim n (2*number es) := by
  apply Or.inl
  have hn := h.2.1
  rw [tau_number] at hn
  exact hn.trans hc
lemma certify_reserve {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (c : ReserveData) (hc : reserveCheck es c = true) : n ≤ 512 ∨ Prim n (2*number es) :=
  Or.inr (reserveCheck_sound h hc)
end Solution

/- ExactCert -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
noncomputable def exactCheck (es : List ℕ) : Bool := decide (
  8 ≤ es.length ∧
  4*coinCost es+2 ≤ dcount es ∧
  4*coinCost es ≤ tailCount es 2 ∧
  (4*coinCost es)^2 ≤ tailNumber es 2 ∧
  2*coinCost es ≤ tailCount es 1 ∧
  boundedCount (twiceFactors es) (2*((es.getD 0 0+2)*tailCount es 1)) ≤ tailCount es 1-2*coinCost es)

lemma certify_exact {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (hp : ∀ i : Fin es.length, 0 < es.getD i 0) (hc : exactCheck es = true) :
    n ≤ 512 ∨ Prim n (2*number es) := by
  obtain ⟨hl,hsize,hRc,hRs,hK,hcount⟩ := of_decide_eq_true hc
  apply Or.inr
  apply generic_from_count h (fun i hi => hp ⟨i,hi⟩) hl le_rfl hsize hRc hRs hK
  have hb := boundedCount_upper (twiceFactors_valid es) (2*((es.getD 0 0+2)*tailCount es 1))
  rw [twiceFactors_number (by omega)] at hb
  have ht := tau_twice_number (es:=es) (by omega : 1 ≤ es.length)
  change (2*number es).divisors.card = _ at ht
  rw [← ht] at hb hcount
  exact hb.trans hcount
end Solution

