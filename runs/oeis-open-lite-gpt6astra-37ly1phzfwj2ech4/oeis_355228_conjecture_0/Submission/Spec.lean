/- MemoCert -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat
noncomputable def exactMemo (es : List ℕ) : Bool := decide (
  8 ≤ es.length ∧
  4*coinCost es+2 ≤ dcount es ∧
  4*coinCost es ≤ tailCount es 2 ∧
  (4*coinCost es)^2 ≤ tailNumber es 2 ∧
  2*coinCost es ≤ tailCount es 1 ∧
  cCount (twiceFactors es) (2*((es.getD 0 0+2)*tailCount es 1)) ≤ tailCount es 1-2*coinCost es)

noncomputable def reserveMemo (es : List ℕ) (c : ReserveData) : Bool :=
  completeCheck c.coins && decide (
    0 < es.length ∧
    c.U.card = 2 ∧ c.U.lcm id = 2*number es ∧ 0 < c.U.sum id ∧
    (∀ d ∈ c.R, d ∣ 2*number es) ∧
    Disjoint c.U c.E ∧ Disjoint c.U c.F ∧ Disjoint c.E c.F ∧
    2*number es ≤ c.E.sum id+1 ∧ c.E.card ≤ c.T ∧
    (∀ d ∈ c.A, 0 < d) ∧
    c.F.card = 3*c.T ∧
    4*c.T+2 ≤ dcount es ∧
    c.W+c.U.sum id ≤ 2*number es ∧
    (dcount es - 2 - 2*c.T) + (c.R.filter (fun d => d ≤ c.cutoff)).card +
      cCount (twiceFactors es) ((2*number es)/(c.cutoff+1)) ≤ dcount es + tailCount es 1 ∧
    cSum (twiceFactors es) c.cutoff ≤
      (2*number es - c.W - c.U.sum id) + (c.R.filter (fun d => d ≤ c.cutoff)).sum id)


lemma exactMemo_eq (es : List ℕ) : exactMemo es = exactCheck es := by
  simp only [exactMemo,exactCheck,cCount_eq]
lemma reserveMemo_eq (es : List ℕ) (c : ReserveData) : reserveMemo es c = reserveFast es c := by
  simp only [reserveMemo,reserveFast,cCount_eq,cSum_eq]

lemma certify_exact_memo {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (hp : ∀ i : Fin es.length, 0 < es.getD i 0) (hc : exactMemo es = true) :
    n ≤ 512 ∨ Prim n (2*number es) := by
  rw [exactMemo_eq] at hc
  exact certify_exact h hp hc
lemma certify_reserve_memo {es : List ℕ} {n : ℕ} (h : Smallest n (number es))
    (c : ReserveData) (hc : reserveMemo es c = true) : n ≤ 512 ∨ Prim n (2*number es) := by
  rw [reserveMemo_eq] at hc
  exact certify_reserve_fast h c hc
end Solution

/- Witness -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Solution
open Finset Nat

def ascending : List ℕ → Bool
  | [] => true
  | [_] => true
  | a::b::l => decide (a < b) && ascending (b::l)

lemma ascending_pairwise {l : List ℕ} (h : ascending l = true) : l.Pairwise (· < ·) := by
  induction l with
  | nil => exact List.Pairwise.nil
  | cons a l ih =>
    cases l with
    | nil => simp
    | cons b l =>
      obtain ⟨hab,hbl⟩ := Bool.and_eq_true_iff.mp h
      have hab : a < b := of_decide_eq_true hab
      have hp := ih hbl
      apply List.pairwise_cons.mpr
      refine ⟨?_,hp⟩
      intro c hc
      rcases List.mem_cons.mp hc with rfl | hc
      · exact hab
      · exact hab.trans ((List.pairwise_cons.mp hp).1 c hc)

def listLcm : List ℕ → ℕ
  | [] => 1
  | x::l => Nat.lcm x (listLcm l)

lemma listLcm_eq (l : List ℕ) : l.toFinset.lcm id = listLcm l := by
  induction l with
  | nil => simp [listLcm]
  | cons a l ih =>
    simp only [List.toFinset_cons,Finset.lcm_insert,listLcm,ih,id_eq]
    rfl

def witnessCheck (n m : ℕ) (l : List ℕ) : Bool := ascending l && decide
  (0 < m ∧ l.length = n ∧ l.sum = m ∧ listLcm l = m ∧ ∀ d ∈ l, d ∣ m)

lemma witnessCheck_sound {n m : ℕ} {l : List ℕ} (h : witnessCheck n m l = true) : Prim n m := by
  obtain ⟨ha,hc⟩ := Bool.and_eq_true_iff.mp h
  obtain ⟨hm,hlen,hsum,hlcm,hdiv⟩ := of_decide_eq_true hc
  have hn : l.Nodup := (ascending_pairwise ha).imp (fun hlt => Nat.ne_of_lt hlt)
  refine ⟨hm,l.toFinset,?_,?_,?_,?_⟩
  · intro d hd
    exact Nat.mem_divisors.mpr ⟨hdiv d (List.mem_toFinset.mp hd),hm.ne'⟩
  · simpa only [List.toFinset_card_of_nodup hn] using hlen
  · rw [List.sum_toFinset id hn]
    simpa only [List.map_id] using hsum
  · simpa only [listLcm_eq] using hlcm

def Exceptional (n : ℕ) : Prop := n=4 ∨ n=5 ∨ n=8 ∨ n=9 ∨ n=10 ∨ n=16 ∨ n=20 ∨ n=24 ∨ n=30
instance (n : ℕ) : Decidable (Exceptional n) := inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ _ ∨ _ ∨ _ ∨ _ ∨ _ ∨ _))

end Solution

