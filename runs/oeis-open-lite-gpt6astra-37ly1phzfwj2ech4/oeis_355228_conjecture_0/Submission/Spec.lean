    (∀ d ∈ c.R, d ∣ 2*number es) ∧
    Disjoint c.U c.E ∧ Disjoint c.U c.F ∧ Disjoint c.E c.F ∧
    2*number es ≤ c.E.sum id+1 ∧ c.E.card ≤ c.T ∧
