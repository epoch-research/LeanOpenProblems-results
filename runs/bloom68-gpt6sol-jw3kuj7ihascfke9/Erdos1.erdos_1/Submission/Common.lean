import FormalConjecturesUtil

/-! Basic rational lattice predicate used in the disproof construction. -/

namespace Erdos1Aux

/-- The integer lattice generated by the columns of `B` has no nonzero point strictly
inside the cube cut by the slab `|∑ xᵢ| < 1`. -/
def CubeSlabAdmissible {d : ℕ} (B : Matrix (Fin d) (Fin d) ℚ) : Prop :=
  ∀ z : Fin d → ℤ,
    (∀ i : Fin d, |B.mulVec (fun j => (z j : ℚ)) i| < 1) →
    |∑ i : Fin d, B.mulVec (fun j => (z j : ℚ)) i| < 1 →
    z = 0

end Erdos1Aux
