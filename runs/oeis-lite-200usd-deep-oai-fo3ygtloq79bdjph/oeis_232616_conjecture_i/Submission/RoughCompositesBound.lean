open Nat Finset Classical

def RoughSet (X a : Nat) : Finset Nat :=
  (Finset.Icc 1 X).filter fun n => ∀ i, i < a → ¬ pAt i ∣ n

def basePred (n : Nat) : Prop := ∀ i, i < 4 → ¬ pAt i ∣ n

lemma pAt_dvd_210 {i : Nat} (hi : i < 4) : pAt i ∣ 210 := by
  interval_cases i <;> norm_num [pAt]

lemma basePred_periodic : Function.Periodic basePred 210 := by
  intro n
  apply propext
  constructor
  · intro h i hi hd
    exact h i hi (dvd_add hd (pAt_dvd_210 hi))
  · intro h i hi hd
    exact h i hi ((Nat.dvd_add_iff_left (k := pAt i) (m := n) (n := 210) (pAt_dvd_210 hi)).mpr hd)

lemma basePred_mod (n : Nat) : basePred (n % 210) ↔ basePred n := by
  exact propext_iff.mp (basePred_periodic.map_mod_nat n)

lemma wheelPrefix_zero : wheelPrefix 0 = 0 := by rfl

lemma wheelPrefix_209 : wheelPrefix 209 = 48 := by rfl

lemma not_basePred_0 : ¬ basePred 0 := by
  intro h
  exact h 0 (by norm_num) (by simp [pAt])

lemma RoughSet_succ_card (X : Nat) :
    (RoughSet (X + 1) 4).card = (RoughSet X 4).card + (if basePred (X + 1) then 1 else 0) := by
  classical
  rw [RoughSet, RoughSet]
  have hI : Finset.Icc 1 (X + 1) = insert (X + 1) (Finset.Icc 1 X) := by
    simpa using (Finset.insert_Icc_right_eq_Icc_succ (a := 1) (b := X) (Nat.succ_pos X)).symm
  rw [hI, Finset.filter_insert]
  have hnot : X + 1 ∉ (Finset.Icc 1 X).filter (fun n => ∀ i, i < 4 → ¬ pAt i ∣ n) := by
    simp
  by_cases hP : ∀ i, i < 4 → ¬ pAt i ∣ X + 1
  · have hPb : basePred (X + 1) := hP
    rw [if_pos hP, if_pos hPb, Finset.card_insert_eq_ite]
    simp
  · have hPb : ¬ basePred (X + 1) := by simpa [basePred] using hP
    rw [if_neg hP, if_neg hPb]
    simp
