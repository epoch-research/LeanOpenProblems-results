lemma hne_of_gcd {p q : Nat} [NeZero bigN] (hp : p.Prime) (hpN : p ∣ bigN)
    (hg : certGcd3 (smallX ^ (bigE / q)) = 1) :
    ((Quad.map (D := 3) hpN) smallX) ^ (bigE / q) ≠ (1 : Quad p 3) := by
  intro hpow
  let z := smallX ^ (bigE / q)
  have hzmap : (Quad.map (D := 3) hpN) z = (1 : Quad p 3) := by
    dsimp [z]
    simpa using (map_pow (Quad.map (D := 3) hpN) smallX (bigE / q) ▸ hpow)
  have hpd1 : p ∣ z.fst.val + bigN - 1 := dvd_val_add_of_cast_eq_one hpN z.fst (by simpa [Quad.map] using congrArg Quad.fst hzmap)
  have hpd2 : p ∣ z.snd.val := dvd_val_of_cast_eq_zero hpN z.snd (by simpa [Quad.map] using congrArg Quad.snd hzmap)
  have hpg : p ∣ certGcd3 z := Nat.dvd_gcd (Nat.dvd_gcd hpN hpd1) hpd2
  rw [hg] at hpg
  exact hp.not_dvd_one hpg
