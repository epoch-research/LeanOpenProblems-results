/--
A354747: Start with $2n-1$; repeatedly triple and add 2 until reaching a prime.
$a(n)$ = number of steps until reaching a prime $> 2n-1$, or 0 if no prime is ever reached.
Equivalently, $a(n)$ is the smallest $m \ge 1$ such that $2 \cdot n \cdot 3^m - 1$ is prime.
-/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

structure Quad (n D : ℕ) where
  fst : ZMod n
  snd : ZMod n
deriving DecidableEq

@[ext] theorem Quad.ext {n D : ℕ} {x y : Quad n D} (h₁ : x.fst = y.fst) (h₂ : x.snd = y.snd) : x = y := by
  cases x; cases y; simp_all

instance (n D : ℕ) [Fintype (ZMod n)] : Fintype (Quad n D) :=
  Fintype.ofEquiv (ZMod n × ZMod n) { toFun := fun x => ⟨x.1,x.2⟩, invFun := fun x => (x.fst,x.snd), left_inv := by intro x; rfl, right_inv := by intro x; cases x; rfl }

namespace Quad

instance (n D : ℕ) : One (Quad n D) := ⟨⟨1, 0⟩⟩
instance (n D : ℕ) : Mul (Quad n D) :=
  ⟨fun x y => ⟨x.fst * y.fst + (D : ZMod n) * x.snd * y.snd, x.fst * y.snd + x.snd * y.fst⟩⟩

@[simp] theorem one_fst (n D) : ((1 : Quad n D).fst) = (1 : ZMod n) := rfl
@[simp] theorem one_snd (n D) : ((1 : Quad n D).snd) = (0 : ZMod n) := rfl
@[simp] theorem mul_fst {n D} (x y : Quad n D) :
    (x * y).fst = x.fst * y.fst + (D : ZMod n) * x.snd * y.snd := rfl
@[simp] theorem mul_snd {n D} (x y : Quad n D) :
    (x * y).snd = x.fst * y.snd + x.snd * y.fst := rfl

instance (n D : ℕ) : CommMonoid (Quad n D) where
  one := 1
  mul := (· * ·)
  one_mul := by intro x; ext <;> simp
  mul_one := by intro x; ext <;> simp
  mul_assoc := by
    intro x y z
    ext <;> simp [mul_assoc, mul_left_comm, mul_comm, add_assoc, add_left_comm,
      add_comm, left_distrib, right_distrib]
  mul_comm := by intro x y; ext <;> simp [mul_comm, mul_left_comm, add_comm]

def map {p n D : ℕ} (h : p ∣ n) : Quad n D →* Quad p D where
  toFun x := ⟨ZMod.castHom h (ZMod p) x.fst, ZMod.castHom h (ZMod p) x.snd⟩
  map_one' := by
    apply Quad.ext
    · exact (ZMod.castHom h (ZMod p)).map_one
    · exact (ZMod.castHom h (ZMod p)).map_zero
  map_mul' := by
    intro x y
    ext <;> simp [map_mul, map_add, mul_assoc]

end Quad

def fastPow {M} [Monoid M] (base acc : M) (e : Nat) : M :=
  if h : e = 0 then acc else
    let acc := if e % 2 = 1 then acc * base else acc
    let base := base * base
    fastPow base acc (e / 2)
termination_by e
decreasing_by exact Nat.div_lt_self (Nat.pos_of_ne_zero h) (by decide : 1 < 2)

theorem fastPow_eq {M} [CommMonoid M] (base acc : M) (e : Nat) :
    fastPow base acc e = acc * base ^ e := by
  rw [fastPow]
  split
  next h => simp [h]
  next h =>
    dsimp only
    rw [fastPow_eq]
    by_cases hodd : e % 2 = 1
    · simp [hodd]
      have hdecomp : e = 2 * (e / 2) + 1 := by
        have := Nat.div_add_mod e 2
        omega
      have hdiv : (2 * (e / 2) + 1) / 2 = e / 2 := by omega
      rw [hdecomp, hdiv]
      simp [pow_mul, pow_succ, mul_assoc, mul_comm, mul_left_comm]
    · have hmod0 : e % 2 = 0 := by omega
      simp [hodd]
      have hdecomp : e = 2 * (e / 2) := by
        have := Nat.div_add_mod e 2
        omega
      rw [hdecomp]
      simp [pow_mul, pow_two]
termination_by e

lemma map_fastPow {M N} [Monoid M] [Monoid N] (f : M →* N) (base acc : M) (e : Nat) :
    f (fastPow base acc e) = fastPow (f base) (f acc) e := by
  rw [fastPow]
  split
  next h => simp [h, fastPow]
  next h =>
    dsimp only
    rw [map_fastPow]
    by_cases hodd : e % 2 = 1
    · conv_rhs => rw [fastPow]
      simp [h, hodd]
    · conv_rhs => rw [fastPow]
      simp [h, hodd]
termination_by e

lemma dvd_val_add_of_cast_eq_one {p N : Nat} [NeZero N] (hpN : p ∣ N) (z : ZMod N)
    (hz : ZMod.castHom hpN (ZMod p) z = 1) : p ∣ z.val + N - 1 := by
  have hz' : ((z.val : Nat) : ZMod p) = ((1 : Nat) : ZMod p) := by
    calc ((z.val : Nat) : ZMod p) = ZMod.castHom hpN (ZMod p) ((z.val : Nat) : ZMod N) := by
          simp [ZMod.castHom_apply]
      _ = ZMod.castHom hpN (ZMod p) z := by rw [ZMod.natCast_zmod_val]
      _ = 1 := hz
      _ = ((1 : Nat) : ZMod p) := by simp
  have hzmod : z.val ≡ 1 [MOD p] := (ZMod.natCast_eq_natCast_iff z.val 1 p).mp hz'
  have hNmod : N ≡ 0 [MOD p] := hpN.modEq_zero_nat
  have hsum : z.val + N ≡ 1 + 0 [MOD p] := hzmod.add hNmod
  have hsub : z.val + N - 1 ≡ 1 + 0 - 1 [MOD p] := by
    apply Nat.ModEq.sub
    · have : 0 < N := NeZero.pos N
      omega
    · omega
    · exact hsum
    · rfl
  simpa using (Nat.modEq_zero_iff_dvd.mp hsub)

lemma dvd_val_of_cast_eq_zero {p N : Nat} [NeZero N] (hpN : p ∣ N) (z : ZMod N)
    (hz : ZMod.castHom hpN (ZMod p) z = 0) : p ∣ z.val := by
  have hz' : ((z.val : Nat) : ZMod p) = ((0 : Nat) : ZMod p) := by
    calc ((z.val : Nat) : ZMod p) = ZMod.castHom hpN (ZMod p) ((z.val : Nat) : ZMod N) := by
          simp [ZMod.castHom_apply]
      _ = ZMod.castHom hpN (ZMod p) z := by rw [ZMod.natCast_zmod_val]
      _ = 0 := hz
      _ = ((0 : Nat) : ZMod p) := by simp
  exact Nat.modEq_zero_iff_dvd.mp ((ZMod.natCast_eq_natCast_iff z.val 0 p).mp hz')

