def qnorm {p} (z : Quad p 3) : ZMod p := z.fst*z.fst - (3:ZMod p)*z.snd*z.snd
lemma qnorm_one (p) : qnorm (1:Quad p 3)=1 := by simp [qnorm]
lemma qnorm_mul {p}(x y:Quad p 3) : qnorm (x*y)=qnorm x * qnorm y := by simp [qnorm]; ring

def NormOne (p:Nat) := {z : Quad p 3 // qnorm z = 1}
namespace NormOne
instance (p) : One (NormOne p) := ⟨⟨1, qnorm_one p⟩⟩
instance (p) : Mul (NormOne p) := ⟨fun x y => ⟨x.1*y.1, by rw [qnorm_mul, x.2, y.2, mul_one]⟩⟩
@[simp] lemma val_one {p}: ((1:NormOne p).1)=(1:Quad p 3):=rfl
@[simp] lemma val_mul {p}(x y:NormOne p): ((x*y).1)=x.1*y.1:=rfl
instance (p) : CommMonoid (NormOne p) where
  one:=1; mul:=(·*·)
  one_mul:=by intro x; apply Subtype.ext; simp
  mul_one:=by intro x; apply Subtype.ext; simp
  mul_assoc:=by intro x y z; apply Subtype.ext; simp [mul_assoc]
  mul_comm:=by intro x y; apply Subtype.ext; simp [mul_comm]
end NormOne

instance (p) [Fintype (ZMod p)] : Fintype (Quad p 3) :=
  Fintype.ofEquiv (ZMod p × ZMod p) {toFun:=fun x=>⟨x.1,x.2⟩, invFun:=fun x=>(x.fst,x.snd), left_inv:=by intro x; rfl, right_inv:=by intro x; cases x; rfl}
instance (p) [Fintype (ZMod p)] : Fintype (NormOne p) := by classical unfold NormOne; infer_instance

noncomputable def root (p:Nat) (b:ZMod p) : ZMod p := by
  classical
  exact if h : ∃ a : ZMod p, a*a = 1 + (3:ZMod p)*b*b then Classical.choose h else 0

lemma root_spec {p} {b:ZMod p} (h : ∃ a : ZMod p, a*a = 1 + (3:ZMod p)*b*b) :
    root p b * root p b = 1 + (3:ZMod p)*b*b := by
  classical
  rw [root, dif_pos h]
  exact Classical.choose_spec h

lemma sq_eq_sq_or_neg {p} [Fact p.Prime] {a r : ZMod p} (h : a*a = r*r) : a = r ∨ a = -r := by
  have h0 : (a-r)*(a+r)=0 := by linear_combination h
  rcases mul_eq_zero.mp h0 with h1 | h2
  · left; linear_combination h1
  · right; linear_combination h2

noncomputable def code (p:Nat) (z:NormOne p) : ZMod p × Bool :=
  (z.1.snd, z.1.fst = root p z.1.snd)

lemma code_injective {p} [Fact p.Prime] : Function.Injective (code p) := by
  intro x y hxy
  apply Subtype.ext
  apply Quad.ext
  · have hb : x.1.snd = y.1.snd := by simpa [code] using congrArg Prod.fst hxy
    have hbool : (x.1.fst = root p x.1.snd) = (y.1.fst = root p y.1.snd) := by simpa [code] using congrArg Prod.snd hxy
    rw [hb] at hbool
    by_cases hx : x.1.fst = root p y.1.snd
    · have hy : y.1.fst = root p y.1.snd := by simpa [hx] using hbool.symm
      exact hx.trans hy.symm
    · have hy : ¬ y.1.fst = root p y.1.snd := by simpa [hx] using hbool.symm
      have ex : ∃ a : ZMod p, a*a = 1 + (3:ZMod p)*y.1.snd*y.1.snd := ⟨y.1.fst, by
        have yy := y.2; dsimp [qnorm] at yy; linear_combination yy⟩
      have rr := root_spec (p:=p) (b:=y.1.snd) ex
      have xsq : x.1.fst*x.1.fst = (root p y.1.snd)*(root p y.1.snd) := by
        rw [rr]
        have xx := x.2; dsimp [qnorm] at xx; rw [hb] at xx; linear_combination xx
      have ysq : y.1.fst*y.1.fst = (root p y.1.snd)*(root p y.1.snd) := by
        rw [rr]
        have yy := y.2; dsimp [qnorm] at yy; linear_combination yy
      rcases sq_eq_sq_or_neg xsq with hx' | hx'
      · contradiction
      rcases sq_eq_sq_or_neg ysq with hy' | hy'
      · contradiction
      · rw [hx', hy']
  · simpa [code] using congrArg Prod.fst hxy

lemma card_normOne_le {p} [Fact p.Prime] : Fintype.card (NormOne p) ≤ 2 * p := by
  classical
  have h := Fintype.card_le_of_injective (code p) (code_injective (p:=p))
  -- h : card NormOne <= card (ZMod p × Bool)
  calc Fintype.card (NormOne p) ≤ Fintype.card (ZMod p × Bool) := h
    _ = p * 2 := by simp [Fintype.card_prod]
    _ = 2 * p := by ring



