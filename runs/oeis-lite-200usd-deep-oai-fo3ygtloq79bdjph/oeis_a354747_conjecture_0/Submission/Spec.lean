def certGcd3 (z : Quad bigN 3) : Nat := Nat.gcd (Nat.gcd bigN (z.fst.val + bigN - 1)) z.snd.val

def mul3Nat (x y : Nat × Nat) : Nat × Nat := ((x.1*y.1 + 3*x.2*y.2) % bigN, (x.1*y.2 + x.2*y.1) % bigN)
def cube3Nat (x : Nat × Nat) : Nat × Nat := mul3Nat (mul3Nat x x) x
def iterCube3 : Nat → Nat × Nat → Nat × Nat
| 0, x => x
| k+1, x => iterCube3 k (cube3Nat x)

def base3Nat : Nat × Nat := (2,1)
def toQ3 (x : Nat × Nat) : Quad bigN 3 := ⟨(x.1 : ZMod bigN), (x.2 : ZMod bigN)⟩
lemma toQ3_base : toQ3 base3Nat = smallX := by rfl
lemma toQ3_mul3Nat (x y : Nat × Nat) : toQ3 (mul3Nat x y) = toQ3 x * toQ3 y := by
  apply Quad.ext <;> simp [toQ3, mul3Nat, Nat.cast_add, Nat.cast_mul]
lemma toQ3_cube3Nat (x : Nat × Nat) : toQ3 (cube3Nat x) = toQ3 x ^ 3 := by
  rw [cube3Nat, toQ3_mul3Nat, toQ3_mul3Nat]
  simp [pow_succ, pow_two, mul_assoc]
lemma toQ3_iterCube3 (k : Nat) (x : Nat × Nat) : toQ3 (iterCube3 k x) = toQ3 x ^ (3^k) := by
  induction k generalizing x with
  | zero => simp [iterCube3]
  | succ k ih =>
      rw [iterCube3, ih, toQ3_cube3Nat]
      rw [← pow_mul]
      congr 1
      rw [pow_succ']
lemma iterCube3_add (m n : Nat) (x : Nat × Nat) : iterCube3 (m+n) x = iterCube3 n (iterCube3 m x) := by
  induction m generalizing x with
  | zero => simp [iterCube3]
  | succ m ih =>
      rw [Nat.succ_add, iterCube3, ih]
      rfl


