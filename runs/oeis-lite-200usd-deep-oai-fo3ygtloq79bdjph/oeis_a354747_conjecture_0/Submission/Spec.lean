lemma fac_pow3_ne {q k : Nat} (hq : q.Prime) (hq3 : q ≠ 3) : (3^k).factorization q = 0 := by
  rw [Nat.factorization_eq_zero_of_not_dvd]
  intro h
  have hqdiv3 : q ∣ 3 := hq.dvd_of_dvd_pow h
  exact hq3 ((Nat.prime_dvd_prime_iff_eq hq (by norm_num : Nat.Prime 3)).mp hqdiv3)

lemma dvd_reduced {d : Nat} (hd0 : d ≠ 0)
    (hd : d ∣ 2 * 100943 * 3^39101) (hnd : ¬ 3^19557 ∣ d) :
    d ∣ 2 * 100943 * 3^19556 := by
  rw [← Nat.factorization_prime_le_iff_dvd hd0 (by norm_num : 2 * 100943 * 3^19556 ≠ 0)]
  intro q hq
  by_cases hq3 : q = 3
  · subst q
    have hp3 : Nat.Prime 3 := by norm_num
    have hfaclt : d.factorization 3 < 19557 := by
      have hiff := hp3.pow_dvd_iff_le_factorization (k:=19557) hd0
      rw [hiff] at hnd
      omega
    have htarget : (2 * 100943 * 3 ^ 19556).factorization 3 = 19556 := by
      rw [show 2*100943=201886 by norm_num, Nat.factorization_mul_apply_of_coprime]
      · rw [Nat.factorization_pow]
        simp [fac_201886_3, Nat.Prime.factorization_self hp3]
      · norm_num
    rw [htarget]
    omega
  · have hqle := (Nat.factorization_prime_le_iff_dvd hd0 (by norm_num : 2 * 100943 * 3^39101 ≠ 0)).mpr hd q hq
    have htarget1 : (2 * 100943 * 3 ^ 39101).factorization q = (2 * 100943 * 3 ^ 19556).factorization q := by
      rw [show 2*100943=201886 by norm_num]
      change (201886 * 3 ^ 39101).factorization q = (201886 * 3 ^ 19556).factorization q
      rw [Nat.factorization_mul_apply_of_coprime, Nat.factorization_mul_apply_of_coprime]
      · rw [fac_pow3_ne hq hq3, fac_pow3_ne hq hq3]
      all_goals norm_num
    rwa [← htarget1]



lemma pow3_dvd_of_order {p : Nat} [Fintype (ZMod p)] (xp : NormOne p)
    (horder_dvd : orderOf xp ∣ bigE)
    (hnot_dvd_R : ¬ orderOf xp ∣ bigE / (3^19545)) :
    3^19557 ∣ orderOf xp := by
  have horder_pos : 0 < orderOf xp := by
    rcases horder_dvd with ⟨c, hc⟩
    by_contra hnot
    have h0 : orderOf xp = 0 := Nat.eq_zero_of_not_pos hnot
    rw [h0, zero_mul] at hc
    have hEpos : 0 < bigE := by dsimp [bigE]; omega
    omega
  by_contra hnd
  have hdR : orderOf xp ∣ 2 * 100943 * 3 ^ 19556 :=
    dvd_reduced horder_pos.ne' (by simpa [bigE_factor] using horder_dvd) hnd
  have hR_eq : bigE / (3^19545) = 2 * 100943 * 3 ^ 19556 := by decide +kernel
  exact hnot_dvd_R (by simpa [hR_eq] using hdR)

lemma two_mul_lt_pow_of_sq_le {p : Nat} (hp_sq_le : p * p ≤ bigN) : 2 * p < 3^19557 := by
  by_contra hnp
  have hsquare : (3^19557) * (3^19557) ≤ (2*p) * (2*p) := Nat.mul_le_mul (le_of_not_gt hnp) (le_of_not_gt hnp)
  have hpp : (2*p) * (2*p) = 4 * (p*p) := by ring
  rw [hpp] at hsquare
  have h4N : 4 * bigN < 3^19557 * 3^19557 := by
    rw [bigN_formula]
    have hcoef : 4 * 201886 < 3^13 := by norm_num
    have hpowpos : 0 < 3^39101 := by positivity
    calc 4 * (201886 * 3^39101 - 1) < 4 * (201886 * 3^39101) := by omega
      _ = (4*201886) * 3^39101 := by ring
      _ < 3^13 * 3^39101 := Nat.mul_lt_mul_of_pos_right hcoef hpowpos
      _ = 3^39114 := by rw [← pow_add]
      _ = 3^19557 * 3^19557 := by rw [← pow_add]
  have h4ppN : 4 * (p*p) ≤ 4 * bigN := Nat.mul_le_mul_left 4 hp_sq_le
  omega


def xp0Of (p : Nat) : Quad p 3 := ⟨(2 : ZMod p), (1 : ZMod p)⟩

lemma xp0Of_norm (p : Nat) : qnorm (xp0Of p) = 1 := by
  dsimp [xp0Of, qnorm]
  norm_num

def xpOf (p : Nat) : NormOne p := ⟨xp0Of p, xp0Of_norm p⟩

lemma map_smallX_eq {p : Nat} [NeZero bigN] (hpN : p ∣ bigN) :
    (Quad.map (D := 3) hpN) smallX = xp0Of p := by
  apply Quad.ext <;> dsimp [Quad.map, smallX, xp0Of]
  · change ((ZMod.cast (2 : ZMod bigN) : ZMod p) = 2)
    exact ZMod.cast_natCast (R := ZMod p) (n := bigN) (m := p) hpN 2
  · change ((ZMod.cast (1 : ZMod bigN) : ZMod p) = 1)
    simpa using (ZMod.cast_natCast (R := ZMod p) (n := bigN) (m := p) hpN 1)

lemma xpOf_powE {p : Nat} [NeZero bigN] (hpN : p ∣ bigN) :
    (xpOf p) ^ bigE = (1 : NormOne p) := by
  apply Subtype.ext
  rw [NormOne.val_pow]
  change (xp0Of p) ^ bigE = (1 : Quad p 3)
  rw [← map_smallX_eq hpN]
  rw [← map_pow]
  have hm := congrArg (Quad.map (D := 3) hpN) cert_pow
  simpa using hm

lemma xpOf_notR {p : Nat} [NeZero bigN] (hp : p.Prime) (hpN : p ∣ bigN) :
    (xpOf p) ^ (bigE / (3^19545)) ≠ (1 : NormOne p) := by
  intro h
  have hv : (xp0Of p) ^ (bigE / (3^19545)) = (1 : Quad p 3) := by
    have hv0 := congrArg Subtype.val h
    rw [NormOne.val_pow] at hv0
    exact hv0
  have hv' : ((Quad.map (D := 3) hpN) smallX) ^ (bigE / (3^19545)) = (1 : Quad p 3) := by
    rw [map_smallX_eq hpN]
    exact hv
  exact hne_of_gcd hp hpN cert_gcdR_power hv'

lemma bigN_prime : Nat.Prime bigN := by
  by_contra hcomp
  let p := Nat.minFac bigN
  have hp : p.Prime := Nat.minFac_prime bigN_ne_one
  have hpN : p ∣ bigN := Nat.minFac_dvd bigN
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : NeZero bigN := ⟨Nat.ne_of_gt bigN_pos⟩
  let xp : NormOne p := xpOf p
  have hpowE : xp ^ bigE = (1 : NormOne p) := xpOf_powE hpN
  have hneR : xp ^ (bigE / (3^19545)) ≠ (1 : NormOne p) := xpOf_notR hp hpN
  have horder_dvd : orderOf xp ∣ bigE := orderOf_dvd_of_pow_eq_one hpowE
  have hnot_dvd_R : ¬ orderOf xp ∣ bigE / (3^19545) := by
    intro hd
    exact hneR ((orderOf_dvd_iff_pow_eq_one).mp hd)
  have h3pow_dvd_order : 3^19557 ∣ orderOf xp := pow3_dvd_of_order xp horder_dvd hnot_dvd_R
  have horder_pos : 0 < orderOf xp := by
    rcases horder_dvd with ⟨c, hc⟩
    by_contra hnot
    have h0 : orderOf xp = 0 := Nat.eq_zero_of_not_pos hnot
    rw [h0, zero_mul] at hc
    have hEpos : 0 < bigE := by dsimp [bigE]; omega
    omega
  have hlarge : 3^19557 ≤ orderOf xp := Nat.le_of_dvd horder_pos h3pow_dvd_order
  have hlecard : orderOf xp ≤ Fintype.card (NormOne p) := orderOf_le_card_univ
  have hcardle : Fintype.card (NormOne p) ≤ 2 * p := card_normOne_le (p:=p)
  have hp_sq_le : p * p ≤ bigN := by simpa [p, pow_two] using Nat.minFac_sq_le_self bigN_pos hcomp
  have hp_bound : 2 * p < 3^19557 := two_mul_lt_pow_of_sq_le hp_sq_le
  have : 3^19557 ≤ 2 * p := le_trans hlarge (le_trans hlecard hcardle)
  omega

/-- The conjecture is false: the exponent `39101` gives a prime. -/
theorem oeis_a354747_conjecture_0.disproof : ¬ a354747 100943 = 0 := by
  intro hzero
  have hmem : 39101 ∈ ({m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} : Set ℕ) := by
    constructor
    · norm_num
    · have hN : 2 * 100943 * 3^39101 - 1 = bigN := by
        simpa [show 2 * 100943 = 201886 by norm_num] using bigN_formula.symm
      simpa [hN] using bigN_prime
  have hs0 : sInf ({m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1)} : Set ℕ) = 0 := by
    simpa [a354747] using hzero
  have hsInf := Nat.sInf_eq_zero.mp hs0
  rcases hsInf with h0mem | hempty
  · exact (Nat.not_lt_zero 0) h0mem.1
  · have : 39101 ∈ (∅ : Set ℕ) := by simpa [hempty] using hmem
    simpa using this
