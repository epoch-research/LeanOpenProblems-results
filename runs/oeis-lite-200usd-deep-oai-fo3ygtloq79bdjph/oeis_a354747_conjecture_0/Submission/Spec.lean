def fp3Nat : Nat → Nat × Nat → Nat × Nat → Nat → Nat × Nat
| 0, b, a, e => a
| k+1, b, a, e => if e = 0 then a else fp3Nat k (mul3Nat b b) (if e%2=1 then mul3Nat a b else a) (e/2)
def none3 : Nat × Nat := (1,0)
lemma toQ3_none : toQ3 none3 = (1 : Quad bigN 3) := by rfl
lemma toQ3_fp3Nat (fuel : Nat) (b a : Nat × Nat) (e : Nat) (hbound : e < 2^fuel) :
    toQ3 (fp3Nat fuel b a e) = fastPow (toQ3 b) (toQ3 a) e := by
  induction fuel generalizing b a e with
  | zero =>
      have he : e = 0 := by simpa using hbound
      simp [fp3Nat, fastPow, he]
  | succ fuel ih =>
      rw [fp3Nat, fastPow]
      split
      next h => simp [h]
      next h =>
        have hdiv : e / 2 < 2^fuel := by rw [pow_succ'] at hbound; omega
        rw [ih _ _ _ hdiv]
        dsimp only
        by_cases ho : e % 2 = 1 <;> simp [h, ho, toQ3_mul3Nat]
