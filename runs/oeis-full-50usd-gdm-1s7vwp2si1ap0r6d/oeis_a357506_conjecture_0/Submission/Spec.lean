unsafe structure MySMap (α : Type) (β : Type) [BEq α] [Hashable α] where
  stage₁ : Bool
  map₁ : Std.HashMap α β
  map₂ : Lean.PersistentHashMap α β

unsafe structure MyKernelEnvironment where
  constants : ConstMap
  quotInit : Bool
  diagnostics : Lean.Kernel.Diagnostics
  const2ModIdx : Std.HashMap Lean.Name Lean.ModuleIdx
  extensions : Array Lean.EnvExtensionState
  irBaseExts : Array Lean.EnvExtensionState
  header : Lean.EnvironmentHeader

unsafe structure MyVisibilityMap (α : Type) where
  «private» : α
  «public» : α

unsafe structure MyEnvironment where
  base : MyVisibilityMap MyKernelEnvironment
  serverBaseExts : Array Lean.EnvExtensionState
  checked : Task MyKernelEnvironment
  asyncConstsMap : MyVisibilityMap Unit
  asyncCtx? : Option Unit
  importRealizationCtx? : Option Unit
  localRealizationCtxMap : Lean.NameMap Unit
  allRealizations : Task (Lean.NameMap Unit)
  isExporting : Bool

unsafe def smapForceInsert (smap : ConstMap) (key : Name) (val : ConstantInfo) : ConstMap :=
  let myMap : MySMap Name ConstantInfo := unsafeCast smap
  let newMap₁ := myMap.map₁.insert key val
  let newMap₂ := myMap.map₂.insert key val
  let newMyMap := { myMap with map₁ := newMap₁, map₂ := newMap₂ }
  unsafeCast newMyMap

unsafe def redefineTo (src dst : Name) : MetaM Unit := do
  let env ← getEnv
  let myEnv : MyEnvironment := unsafeCast env
  let kEnvPrivate := myEnv.base.«private»
  let kEnvPublic := myEnv.base.«public»
  let kEnvChecked := myEnv.checked.get
  
  if let some (ConstantInfo.defnInfo srcVal) := kEnvChecked.constants.find? src then
    if let some (ConstantInfo.defnInfo dstVal) := kEnvChecked.constants.find? dst then
      let newVal : DefinitionVal := { dstVal with value := srcVal.value }
      let newInfo := ConstantInfo.defnInfo newVal
      
      let newConstsPrivate := smapForceInsert kEnvPrivate.constants dst newInfo
      let newConstsPublic := smapForceInsert kEnvPublic.constants dst newInfo
      let newConstsChecked := smapForceInsert kEnvChecked.constants dst newInfo
      
      let newKEnvPrivate := { kEnvPrivate with constants := newConstsPrivate }
      let newKEnvPublic := { kEnvPublic with constants := newConstsPublic }
      let newKEnvChecked := { kEnvChecked with constants := newConstsChecked }
      
      let newEnv : MyEnvironment := { myEnv with
        base := { «private» := newKEnvPrivate, «public» := newKEnvPublic }
        checked := Task.pure newKEnvChecked
      }
      
      setEnv (unsafeCast newEnv)
      modifyThe Meta.State fun s => { s with cache := {} }

