theorem A217317_foursevensixfivesonesix_eq_zero : A217317 4765516 = 0 := by
  dsimp [A217317]
  have hC : 4765516 > 1 := by norm_num
  have hb : 55 > 0 := by norm_num
  have hl : 2^1220 ≤ 4765516^55 := by norm_num
  have hu : 4765516^55 < 2^1221 := by norm_num
  have h_bounds := logb_two_bounds hC hb hl hu
  have h1 : (1220 : ℝ) / (55 : ℝ) ≤ Real.logb 2 4765516 := h_bounds.left
  have h2 : Real.logb 2 4765516 < (1221 : ℝ) / (55 : ℝ) := h_bounds.right
  have h3 : (0 : ℝ) ≤ (1220 : ℝ) / (55 : ℝ) := by norm_num
  have h_low : ((1220 : ℝ) / (55 : ℝ))^2 ≤ (Real.logb 2 4765516)^2 := by nlinarith
  have h_up : (Real.logb 2 4765516)^2 < ((1221 : ℝ) / (55 : ℝ))^2 := by nlinarith
  have h_low_val : (492 : ℝ) ≤ ((1220 : ℝ) / (55 : ℝ))^2 := by norm_num
  have h_up_val : ((1221 : ℝ) / (55 : ℝ))^2 < (493 : ℝ) := by norm_num
  have h_L_low : (492 : ℝ) ≤ (Real.logb 2 4765516)^2 := by linarith
  have h_L_up : (Real.logb 2 4765516)^2 < (493 : ℝ) := by linarith
  have h_floor_low : (22710142746748 : ℝ) ≤ (4765516 : ℝ)^2 + (Real.logb 2 4765516)^2 := by linarith
  have h_floor_up : (4765516 : ℝ)^2 + (Real.logb 2 4765516)^2 < (22710142746748 : ℝ) + 1 := by linarith
  have h_floor : Int.floor ((4765516 : ℝ)^2 + (Real.logb 2 4765516)^2) = (22710142746748 : ℤ) := by
    rw [Int.floor_eq_iff]
    exact ⟨h_floor_low, h_floor_up⟩
  have h_to_nat : Int.toNat (Int.floor ((4765516 : ℝ)^2 + (Real.logb 2 4765516)^2)) = 22710142746748 := by
    rw [h_floor]
    rfl
  change Nat.primeCounting (Int.toNat (Int.floor ((4765516 : ℝ)^2 + (Real.logb 2 4765516)^2))) - Nat.primeCounting (4765516^2) = 0
  rw [h_to_nat]
  have h_pc : Nat.primeCounting 22710142746748 = Nat.primeCounting 22710142746256 := by
    rw [pc_step1, pc_step2, pc_step3, pc_step4, pc_step5, pc_step6, pc_step7, pc_step8, pc_step9, pc_step10]
  rw [h_pc]
  rfl

/--
Conjecture: $A217317(n) > 0$ for $n > 4765516$.
-/
theorem oeis_217317_conjecture_0 : ∀ (n : ℕ), n > 4765516 → A217317 n > 0 :=
  by sorry
