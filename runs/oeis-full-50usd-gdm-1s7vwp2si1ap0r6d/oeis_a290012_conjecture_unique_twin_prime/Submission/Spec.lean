theorem A_one : A290012 1 = 2 := by
  unfold A290012; dsimp only
  have hS : (Finset.range 1).sum (fun k => (Nat.nth Nat.Prime k) ^ 2) = 4 := by
    rw [Finset.sum_range_one, nth_prime_0]
  rw [hS]
  have h_mem : 2 ∈ { p : ℕ | p.Prime ∧ 4 ≤ p ^ 2 } := by simp [Nat.prime_two]
  have h_le : sInf { p : ℕ | p.Prime ∧ 4 ≤ p ^ 2 } ≤ 2 := Nat.sInf_le h_mem
  have h_nonempty : { p : ℕ | p.Prime ∧ 4 ≤ p ^ 2 }.Nonempty := ⟨2, h_mem⟩
  have h_in : sInf { p : ℕ | p.Prime ∧ 4 ≤ p ^ 2 } ∈ { p : ℕ | p.Prime ∧ 4 ≤ p ^ 2 } := Nat.sInf_mem h_nonempty
  have h_ge : 2 ≤ sInf { p : ℕ | p.Prime ∧ 4 ≤ p ^ 2 } := h_in.1.two_le
  exact le_antisymm h_le h_ge

theorem A_two : A290012 2 = 5 := by
  unfold A290012; dsimp only
  have hS : (Finset.range 2).sum (fun k => (Nat.nth Nat.Prime k) ^ 2) = 13 := by
    rw [Finset.sum_range_succ, Finset.sum_range_one]
    rw [nth_prime_1, nth_prime_0]
    decide
  rw [hS]
  have h_mem : 5 ∈ { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 } := by
    refine ⟨Nat.prime_five, by norm_num⟩
  have h_le : sInf { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 } ≤ 5 := Nat.sInf_le h_mem
  have h_nonempty : { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 }.Nonempty := ⟨5, h_mem⟩
  have h_in : sInf { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 } ∈ { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 } := Nat.sInf_mem h_nonempty
  have h_ge : 5 ≤ sInf { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 } := by
    by_contra! h_lt
    have h_p : (sInf { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 }).Prime := h_in.1
    have h_sq : 13 ≤ (sInf { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 }) ^ 2 := h_in.2
    interval_cases sInf { p : ℕ | p.Prime ∧ 13 ≤ p ^ 2 }
    · exact Nat.not_prime_zero h_p
    · exact Nat.not_prime_one h_p
    · revert h_sq; decide
    · revert h_sq; decide
    · revert h_p; decide
  exact le_antisymm h_le h_ge

