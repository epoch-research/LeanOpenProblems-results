lemma count_a_eq_invariant_strong (m : ℕ) (hm : m ≠ 8) (N : ℕ) (hN : 120 ≤ N) : count_a_eq N m + (if a N = m then 2 else 1) ≤ count_a_eq N 8 := by
  induction' N using Nat.strong_induction_on with N ih
  by_cases h_small : N ≤ 140
  · exact count_a_eq_invariant_small m hm N (by omega) h_small
  · have h_gt : N > 140 := by omega
    by_cases h_m : a N = m
    · rw [if_pos h_m]
      exact count_a_eq_invariant_strong_pos m hm N h_gt h_m ih
    · rw [if_neg h_m]
      exact count_a_eq_invariant_strong_neg m hm N h_gt h_m ih


lemma count_a_eq_invariant_step_back (m : ℕ) (hm : m ≠ 8) (n : ℕ) (hn : 72 ≤ n) (ha : a (n + 1) = m) : count_a_eq n m + 1 ≤ count_a_eq n 8 := by
  by_cases hn120 : n < 120
  · have hn_le : n ≤ 140 := by omega
    exact count_a_eq_invariant_step_back_small m hm n hn hn_le ha
  · have hn120_ge : 120 ≤ n := by omega
    have h_inv := count_a_eq_invariant_strong m hm n hn120_ge
    have h_nm : a n ≠ m := by
      have h_ne := a_ne_a_succ n
      rw [ha] at h_ne
      exact h_ne
    rw [if_neg h_nm] at h_inv
    omega

lemma count_a_eq_invariant (m : ℕ) (hm : m ≠ 8) (N : ℕ) (hN : 72 ≤ N) : count_a_eq N m + (if a N = m then 1 else 0) ≤ count_a_eq N 8 := by
  induction N, hN using Nat.le_induction with
  | base =>
    have h_le := count_a_eq_le_72_120 m 72 (by omega) (by omega)
    have h_a : a 72 = 9 := by
      rw [a_eq_a_fast_200 72 (by omega)]
      decide
    rw [h_a]
    by_cases h9 : m = 9
    · subst h9
      have h_72 : count_a_eq 72 9 = 6 := by
        rw [count_a_eq_eq_count_a_fast_200 9 72 (by omega)]
        decide
      have h_72_8 : count_a_eq 72 8 = 8 := by
        rw [count_a_eq_eq_count_a_fast_200 8 72 (by omega)]
        decide
      rw [h_72, h_72_8]
      simp
    · have h9_symm : 9 ≠ m := Ne.symm h9
      rw [if_neg h9_symm]
      exact h_le
  | succ n hn ih =>
    rw [count_a_eq_succ n m, count_a_eq_succ n 8]
    by_cases h1 : a n = m
    · have h2 : a n ≠ 8 := by omega
      rw [if_pos h1] at ih
      rw [if_pos h1, if_neg h2]
      have h_ne := a_ne_a_succ n
      rw [h1] at h_ne
      have h_ne2 : a (n + 1) ≠ m := h_ne.symm
      rw [if_neg h_ne2]
      omega
    · rw [if_neg h1] at ih
      by_cases h2 : a n = 8
      · rw [if_neg h1, if_pos h2]
        split_ifs <;> omega
      · rw [if_neg h1, if_neg h2]
        by_cases h3 : a (n + 1) = m
        · rw [if_pos h3]
          have h_sb := count_a_eq_invariant_step_back m hm n hn h3
          omega
        · rw [if_neg h3]
          omega

lemma count_a_eq_le (m : ℕ) (N : ℕ) (hN : 72 ≤ N) : count_a_eq N m ≤ count_a_eq N 8 := by
  by_cases hm : m = 8
  · subst hm
    omega
  · have h_inv := count_a_eq_invariant m hm N hN
    split_ifs at h_inv <;> omega


/--
oeis_326746_conjecture_0:
The frequency of occurrence for the values of a(n) for large values of n has an interesting distribution - it is a bell-shaped curve but with large increases for a(n) = 8, and a smaller increase for a(n) = 17. The value a(n) = 8 is likely the most common value as every time n increases by 100 the value of a(n) goes through ten smaller cycles, and 8 appears to be the only value that is present in all ten cycles. The reason a(n) = 17 also appears more often is not clear, although the distribution for n up to 10^10 also shows a slight increase in the number of occurrences for a(n) = 26, suggesting that a(n) values of the form a(n) = 8 + 9 * k, where k >= 0, occur more frequently than one would predicted from the surrounding bell-curve distribution.

We formalize the core claim that 8 is the most common value by asserting that its asymptotic frequency is at least that of any other value $m$.
The asymptotic frequency is captured by the $\limsup$ of the proportion of occurrences up to $N$.
-/
theorem oeis_326746_conjecture_0 :
  ∀ m : ℕ,
    Filter.limsup (fun N : ℕ => (count_a_eq N 8 : ℝ) / N) atTop
    ≥
    Filter.limsup (fun N : ℕ => (count_a_eq N m : ℝ) / N) atTop
    := by
  intro m
  have hu0 : IsBoundedUnder (fun x y => y ≤ x) atTop (fun N => (count_a_eq N m : ℝ) / N) := isBoundedUnder_of (f := atTop) (r := fun x y => y ≤ x) ⟨0, fun N => count_div_nonneg N m⟩
  have hu : IsCoboundedUnder (fun x1 x2 => x1 ≤ x2) atTop (fun N => (count_a_eq N m : ℝ) / N) := IsBoundedUnder.isCoboundedUnder_le hu0
  have hv : IsBoundedUnder (fun x1 x2 => x1 ≤ x2) atTop (fun N => (count_a_eq N 8 : ℝ) / N) := isBoundedUnder_of (f := atTop) (r := fun x y => x ≤ y) ⟨1, fun N => count_div_le_one N 8⟩
  apply limsup_le_limsup (hu := hu) (hv := hv)
  · rw [Filter.EventuallyLE]
    rw [eventually_atTop]
    use 72
    intro N hN
    have h1 : 72 ≤ N := hN
    have h2 := count_a_eq_le m N h1
    have h3 : (count_a_eq N m : ℝ) ≤ (count_a_eq N 8 : ℝ) := by
      exact Nat.cast_le.mpr h2
    have h_N_pos : (N : ℝ) > 0 := by
      have : N ≥ 72 := h1
      have : N > 0 := by omega
      exact Nat.cast_pos.mpr this
    exact div_le_div_of_nonneg_right h3 (by linarith)
