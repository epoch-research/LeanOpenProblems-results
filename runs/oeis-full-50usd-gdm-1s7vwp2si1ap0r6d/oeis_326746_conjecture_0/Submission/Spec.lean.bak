import FormalConjectures.Util.ProblemImports

open Nat List

/--
A326746: $a(n) = (\text{sum of digits of } n) \bmod (\text{sum of digits of } n+1)$.
-/
def a (n : ℕ) : ℕ :=
  (Nat.digits 10 n).sum % (Nat.digits 10 (n + 1)).sum

/-- The count of non-negative integers $n < N$ such that $a(n) = m$. -/
def count_a_eq (N m : ℕ) : ℕ :=
  (List.range N).countP fun n => a n = m

open Filter Real

def my_sum_digits (fuel : ℕ) (n : ℕ) : ℕ :=
  match fuel with
  | 0 => 0
  | f + 1 => if n = 0 then 0 else n % 10 + my_sum_digits f (n / 10)

def a_fast (n : ℕ) : ℕ :=
  my_sum_digits 75 n % my_sum_digits 75 (n + 1)

def count_a_fast (N m : ℕ) : ℕ :=
  (List.range N).countP fun n => a_fast n = m

lemma a_fast_lt_18 (n : ℕ) (hn : n < 72) : a_fast n < 18 := by
  revert n hn; decide

lemma count_a_fast_eq_zero (m : ℕ) (hm : 18 ≤ m) : count_a_fast 72 m = 0 := by
  unfold count_a_fast
  rw [List.countP_eq_zero]
  intro n hn
  rw [List.mem_range] at hn
  have h_lt := a_fast_lt_18 n hn
  intro h_eq
  rw [decide_eq_true_iff] at h_eq
  omega

theorem digits_sum_eq_my_sum (fuel : ℕ) : ∀ n : ℕ, n < fuel → (Nat.digits 10 n).sum = my_sum_digits fuel n := by
  induction fuel with
  | zero =>
    intro n hn
    omega
  | succ f ih =>
    intro n hn
    by_cases hn0 : n = 0
    · subst hn0
      simp [my_sum_digits, Nat.digits_zero]
    · rw [my_sum_digits]
      simp only [hn0, ↓reduceIte]
      have h10 : 1 < 10 := by decide
      rw [Nat.digits_eq_cons_digits_div h10 hn0]
      simp only [List.sum_cons]
      have h_div_lt : n / 10 < f := by
        have : n / 10 < n := Nat.div_lt_self (Nat.pos_of_ne_zero hn0) (by decide)
        omega
      rw [ih (n / 10) h_div_lt]

lemma a_eq_a_fast (n : ℕ) (hn : n < 72) : a n = a_fast n := by
  unfold a a_fast
  have h1 : (Nat.digits 10 n).sum = my_sum_digits 75 n := by
    apply digits_sum_eq_my_sum
    omega
  have h2 : (Nat.digits 10 (n + 1)).sum = my_sum_digits 75 (n + 1) := by
    apply digits_sum_eq_my_sum
    omega
  rw [h1, h2]

lemma count_a_eq_eq_count_a_fast (m : ℕ) : count_a_eq 72 m = count_a_fast 72 m := by
  unfold count_a_eq count_a_fast
  apply List.countP_congr
  intro n hn
  rw [List.mem_range] at hn
  rw [a_eq_a_fast n hn]

lemma count_a_fast_le_eight (m : ℕ) : count_a_fast 72 m ≤ count_a_fast 72 8 := by
  by_cases h : m < 18
  · revert m h; decide
  · have hm : 18 ≤ m := by omega
    rw [count_a_fast_eq_zero m hm]
    omega

lemma count_a_eq_72_le (m : ℕ) : count_a_eq 72 m ≤ count_a_eq 72 8 := by
  rw [count_a_eq_eq_count_a_fast m, count_a_eq_eq_count_a_fast 8]
  exact count_a_fast_le_eight m

lemma count_a_eq_le_self (N m : ℕ) : count_a_eq N m ≤ N := by
  unfold count_a_eq
  have h : List.countP (fun n => a n = m) (List.range N) ≤ (List.range N).length := List.countP_le_length
  rw [List.length_range] at h
  exact h

lemma count_div_le_one (N m : ℕ) : (count_a_eq N m : ℝ) / N ≤ 1 := by
  by_cases hN : N = 0
  · subst hN
    simp
  · have h_pos : (N : ℝ) > 0 := by
      exact Nat.cast_pos.mpr (by omega)
    have h_le := count_a_eq_le_self N m
    rw [div_le_iff₀ h_pos]
    simp
    exact h_le

lemma count_div_nonneg (N m : ℕ) : 0 ≤ (count_a_eq N m : ℝ) / N := by
  apply div_nonneg
  · exact Nat.cast_nonneg _
  · exact Nat.cast_nonneg _


lemma my_sum_le_ofDigits (L : List ℕ) : L.sum ≤ Nat.ofDigits 10 L := by
  induction L with
  | nil => simp [Nat.ofDigits]
  | cons x xs ih =>
    simp [Nat.ofDigits]
    have h1 : xs.sum ≤ Nat.ofDigits 10 xs := ih
    have h2 : Nat.ofDigits 10 xs ≤ 10 * Nat.ofDigits 10 xs := by omega
    omega

lemma sum_digits_le (n : ℕ) : (Nat.digits 10 n).sum ≤ n := by
  have h := my_sum_le_ofDigits (Nat.digits 10 n)
  rw [Nat.ofDigits_digits] at h
  exact h

lemma ofDigits_eq_zero_of_sum_eq_zero (L : List ℕ) (h : L.sum = 0) : Nat.ofDigits 10 L = 0 := by
  induction L with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.sum_cons] at h
    have hx : x = 0 := by omega
    have hxs : xs.sum = 0 := by omega
    subst hx
    unfold Nat.ofDigits
    rw [ih hxs]
    omega

lemma digits_sum_pos (n : ℕ) (hn : n ≠ 0) : 0 < (Nat.digits 10 n).sum := by
  have h : (Nat.digits 10 n).sum ≠ 0 := by
    intro h_sum
    have h_of := ofDigits_eq_zero_of_sum_eq_zero (Nat.digits 10 n) h_sum
    rw [Nat.ofDigits_digits] at h_of
    exact hn h_of
  omega

lemma my_sum_digits_zero (fuel : ℕ) : my_sum_digits fuel 0 = 0 := by
  induction fuel with
  | zero => rfl
  | succ f ih =>
    unfold my_sum_digits
    rfl

lemma my_sum_digits_succ_le (fuel : ℕ) : ∀ n : ℕ, my_sum_digits fuel (n + 1) ≤ my_sum_digits fuel n + 1 := by
  induction fuel with
  | zero =>
    intro n
    unfold my_sum_digits
    omega
  | succ f ih =>
    intro n
    by_cases hn0 : n = 0
    · subst hn0
      unfold my_sum_digits
      rw [my_sum_digits_zero f]
      simp
    · unfold my_sum_digits
      simp only [hn0, ↓reduceIte]
      have h1 : n + 1 ≠ 0 := by omega
      simp only [h1, ↓reduceIte]
      by_cases h_mod : (n + 1) % 10 = 0
      · have hn9 : n % 10 = 9 := by omega
        have h_div : (n + 1) / 10 = n / 10 + 1 := by omega
        rw [hn9, h_mod, h_div]
        have h_ih := ih (n / 10)
        omega
      · have h_mod2 : (n + 1) % 10 = n % 10 + 1 := by omega
        have h_div2 : (n + 1) / 10 = n / 10 := by omega
        rw [h_mod2, h_div2]
        omega

lemma digits_sum_succ_le (n : ℕ) : (Nat.digits 10 (n + 1)).sum ≤ (Nat.digits 10 n).sum + 1 := by
  have h1 : (Nat.digits 10 (n + 1)).sum = my_sum_digits (n + 2) (n + 1) := by
    apply digits_sum_eq_my_sum
    omega
  have h2 : (Nat.digits 10 n).sum = my_sum_digits (n + 2) n := by
    apply digits_sum_eq_my_sum
    omega
  rw [h1, h2]
  apply my_sum_digits_succ_le

lemma my_sum_digits_succ_of_mod_ten (f : ℕ) (n : ℕ) (h : (n + 1) % 10 = 0) : my_sum_digits (f + 1) (n + 2) = my_sum_digits (f + 1) (n + 1) + 1 := by
  have h_div : (n + 2) / 10 = (n + 1) / 10 := by omega
  have h_mod1 : (n + 2) % 10 = 1 := by omega
  have h_mod2 : (n + 1) % 10 = 0 := by omega
  unfold my_sum_digits
  have hn2 : n + 2 ≠ 0 := by omega
  have hn1 : n + 1 ≠ 0 := by omega
  simp only [hn2, hn1, ↓reduceIte]
  rw [h_div, h_mod1, h_mod2]
  omega

lemma digits_sum_succ_of_mod_ten (n : ℕ) (h : (n + 1) % 10 = 0) : (Nat.digits 10 (n + 2)).sum = (Nat.digits 10 (n + 1)).sum + 1 := by
  have h1 : (Nat.digits 10 (n + 2)).sum = my_sum_digits (n + 2 + 1) (n + 2) := by
    apply digits_sum_eq_my_sum
    omega
  have h2 : (Nat.digits 10 (n + 1)).sum = my_sum_digits (n + 2 + 1) (n + 1) := by
    apply digits_sum_eq_my_sum
    omega
  rw [h1, h2]
  apply my_sum_digits_succ_of_mod_ten
  exact h

lemma my_sum_digits_not_carry (f : ℕ) (n : ℕ) (h : (n + 1) % 10 ≠ 0) : my_sum_digits (f + 1) (n + 1) = my_sum_digits (f + 1) n + 1 := by
  by_cases hn0 : n = 0
  · subst hn0
    unfold my_sum_digits
    rw [my_sum_digits_zero f]
    simp
  · unfold my_sum_digits
    simp only [hn0, ↓reduceIte]
    have h1 : n + 1 ≠ 0 := by omega
    simp only [h1, ↓reduceIte]
    have h_mod2 : (n + 1) % 10 = n % 10 + 1 := by omega
    have h_div2 : (n + 1) / 10 = n / 10 := by omega
    rw [h_mod2, h_div2]
    omega

lemma my_sum_digits_cases (f : ℕ) : ∀ n : ℕ, my_sum_digits (f + 1) (n + 1) = my_sum_digits (f + 1) n + 1 ∨ my_sum_digits (f + 1) (n + 1) + 8 ≤ my_sum_digits (f + 1) n := by
  induction f with
  | zero =>
    intro n
    by_cases hn0 : n = 0
    · subst hn0
      simp [my_sum_digits]
    · simp [my_sum_digits, hn0]
      by_cases h_mod : (n + 1) % 10 = 0
      · omega
      · omega
  | succ f ih =>
    intro n
    by_cases hn0 : n = 0
    · subst hn0
      unfold my_sum_digits
      rw [my_sum_digits_zero (f + 1)]
      simp
    · unfold my_sum_digits
      simp only [hn0, ↓reduceIte]
      have h1 : n + 1 ≠ 0 := by omega
      simp only [h1, ↓reduceIte]
      by_cases h_mod : (n + 1) % 10 = 0
      · have hn9 : n % 10 = 9 := by omega
        have h_div : (n + 1) / 10 = n / 10 + 1 := by omega
        rw [hn9, h_mod, h_div]
        have h_le := my_sum_digits_succ_le (f + 1) (n / 10)
        omega
      · have h_mod2 : (n + 1) % 10 = n % 10 + 1 := by omega
        have h_div2 : (n + 1) / 10 = n / 10 := by omega
        rw [h_mod2, h_div2]
        omega

lemma digits_sum_cases (n : ℕ) : (Nat.digits 10 (n + 1)).sum = (Nat.digits 10 n).sum + 1 ∨ (Nat.digits 10 (n + 1)).sum + 8 ≤ (Nat.digits 10 n).sum := by
  have h1 : (Nat.digits 10 (n + 1)).sum = my_sum_digits (n + 1 + 1) (n + 1) := by
    apply digits_sum_eq_my_sum
    omega
  have h2 : (Nat.digits 10 n).sum = my_sum_digits (n + 1 + 1) n := by
    apply digits_sum_eq_my_sum
    omega
  rw [h1, h2]
  apply my_sum_digits_cases

lemma mod_ten_of_carry_fuel (f : ℕ) (n : ℕ) (h : my_sum_digits (f + 1) (n + 1) + 8 ≤ my_sum_digits (f + 1) n) : (n + 1) % 10 = 0 := by
  by_cases h_mod : (n + 1) % 10 = 0
  · exact h_mod
  · have h_nc := my_sum_digits_not_carry f n h_mod
    omega

lemma mod_ten_of_carry (n : ℕ) (h : (Nat.digits 10 (n + 1)).sum + 8 ≤ (Nat.digits 10 n).sum) : (n + 1) % 10 = 0 := by
  have h1 : (Nat.digits 10 (n + 1)).sum = my_sum_digits (n + 2) (n + 1) := by
    apply digits_sum_eq_my_sum
    omega
  have h2 : (Nat.digits 10 n).sum = my_sum_digits (n + 2) n := by
    apply digits_sum_eq_my_sum
    omega
  rw [h1, h2] at h
  apply mod_ten_of_carry_fuel (n + 1) n h

lemma le_sub_eight_of_modEq_add_one {x y : ℕ} (h_mod : (x + 1) % 9 = y % 9) (h_le : y ≤ x) : y + 8 ≤ x := by
  omega

lemma digits_sum_pos_succ (n : ℕ) : 0 < (Nat.digits 10 (n + 1)).sum := by
  apply digits_sum_pos
  omega

lemma a_ne_a_succ (n : ℕ) : a n ≠ a (n + 1) := by
  intro h
  unfold a at h
  set s1 := (Nat.digits 10 n).sum
  set s2 := (Nat.digits 10 (n + 1)).sum
  set s3 := (Nat.digits 10 (n + 2)).sum
  have hs2 : 0 < s2 := digits_sum_pos_succ n
  have hs3 : 0 < s3 := digits_sum_pos_succ (n + 1)
  have h1 : s1 % s2 < s2 := Nat.mod_lt s1 hs2
  have h2 : s2 % s3 = s1 % s2 := h.symm
  by_cases hlt : s2 < s3
  · rw [Nat.mod_eq_of_lt hlt] at h2
    omega
  · have hge : s3 ≤ s2 := by omega
    have h_mod1 : s1 % 9 = n % 9 := (Nat.modEq_nine_digits_sum n).symm
    have h_mod2 : s2 % 9 = (n + 1) % 9 := (Nat.modEq_nine_digits_sum (n + 1)).symm
    have h_mod3 : s3 % 9 = (n + 2) % 9 := (Nat.modEq_nine_digits_sum (n + 2)).symm
    have h_le12 : s2 ≤ s1 + 1 := digits_sum_succ_le n
    have h_mod_add : (s2 + 1) % 9 = s3 % 9 := by omega
    have h_le32 : s3 + 8 ≤ s2 := le_sub_eight_of_modEq_add_one h_mod_add hge
    have h_v2 : s2 % s3 = s1 % s2 := h2
    have h_cases : s2 = s1 + 1 ∨ s2 + 8 ≤ s1 := digits_sum_cases n
    rcases h_cases with h_eq | h_le
    · have h_s1_mod : s1 % s2 = s1 := Nat.mod_eq_of_lt (by omega)
      rw [h_s1_mod] at h_v2
      have h_s2_mod : s2 % s3 < s3 := Nat.mod_lt s2 hs3
      omega
    · have h_mod_ten : (n + 1) % 10 = 0 := mod_ten_of_carry n h_le
      have h_s3_eq : s3 = s2 + 1 := digits_sum_succ_of_mod_ten n h_mod_ten
      omega

lemma a_ne_a_succ_succ (n : ℕ) : a n ≠ a (n + 2) := by
  intro h
  unfold a at h
  set s1 := (Nat.digits 10 n).sum
  set s2 := (Nat.digits 10 (n + 1)).sum
  set s3 := (Nat.digits 10 (n + 2)).sum
  set s4 := (Nat.digits 10 (n + 3)).sum
  have hs2 : 0 < s2 := digits_sum_pos_succ n
  have hs3 : 0 < s3 := digits_sum_pos_succ (n + 1)
  have hs4 : 0 < s4 := digits_sum_pos_succ (n + 2)
  have h_cases1 : s2 = s1 + 1 ∨ s2 + 8 ≤ s1 := digits_sum_cases n
  have h_cases2 : s3 = s2 + 1 ∨ s3 + 8 ≤ s2 := digits_sum_cases (n + 1)
  have h_cases3 : s4 = s3 + 1 ∨ s4 + 8 ≤ s3 := digits_sum_cases (n + 2)
  rcases h_cases1 with h_eq1 | h_le1
  · rcases h_cases2 with h_eq2 | h_le2
    · rcases h_cases3 with h_eq3 | h_le3
      · have h_mod1 : s1 % s2 = s1 := Nat.mod_eq_of_lt (by omega)
        have h_mod2 : s3 % s4 = s3 := Nat.mod_eq_of_lt (by omega)
        omega
      · have h_mod1 : s1 % s2 = s1 := Nat.mod_eq_of_lt (by omega)
        have h_mod2 : s3 % s4 < s4 := Nat.mod_lt s3 hs4
        omega
    · rcases h_cases3 with h_eq3 | h_le3
      · have h_mod1 : s1 % s2 = s1 := Nat.mod_eq_of_lt (by omega)
        have h_mod2 : s3 % s4 = s3 := Nat.mod_eq_of_lt (by omega)
        rw [h_mod1, h_mod2] at h
        omega
      · have h_mod_ten1 : (n + 2) % 10 = 0 := mod_ten_of_carry (n + 1) h_le2
        have h_mod_ten2 : (n + 3) % 10 = 0 := mod_ten_of_carry (n + 2) h_le3
        omega
  · have h_mod_ten : (n + 1) % 10 = 0 := mod_ten_of_carry n h_le1
    have h_s3 : s3 = s2 + 1 := digits_sum_succ_of_mod_ten n h_mod_ten
    have h_mod_ten2 : (n + 2) % 10 = 1 := by omega
    have h_mod_ten3 : (n + 2 + 1) % 10 ≠ 0 := by omega
    have h_s4 : s4 = s3 + 1 := by
      have h_not := my_sum_digits_not_carry (n + 3) (n + 2) h_mod_ten3
      have h_digits3 : (Nat.digits 10 (n + 3)).sum = my_sum_digits (n + 4) (n + 3) := by
        apply digits_sum_eq_my_sum; omega
      have h_digits2 : (Nat.digits 10 (n + 2)).sum = my_sum_digits (n + 4) (n + 2) := by
        apply digits_sum_eq_my_sum; omega
      change (Nat.digits 10 (n + 3)).sum = (Nat.digits 10 (n + 2)).sum + 1
      rw [h_digits3, h_digits2]
      apply my_sum_digits_not_carry (n + 3) (n + 2)
      exact h_mod_ten3
    have h_mod2 : s3 % s4 = s3 := Nat.mod_eq_of_lt (by omega)
    have h_mod1 : s1 % s2 < s2 := Nat.mod_lt s1 hs2
    omega

def a_fast_200 (n : ℕ) : ℕ :=
  my_sum_digits 200 n % my_sum_digits 200 (n + 1)

def count_a_fast_200 (N m : ℕ) : ℕ :=
  (List.range N).countP fun n => a_fast_200 n = m

lemma a_eq_a_fast_200 (n : ℕ) (hn : n < 199) : a n = a_fast_200 n := by
  unfold a a_fast_200
  have h1 : (Nat.digits 10 n).sum = my_sum_digits 200 n := by
    apply digits_sum_eq_my_sum
    omega
  have h2 : (Nat.digits 10 (n + 1)).sum = my_sum_digits 200 (n + 1) := by
    apply digits_sum_eq_my_sum
    omega
  rw [h1, h2]

set_option maxRecDepth 1000000

lemma a_fast_200_lt_18 (n : ℕ) (hn : n < 180) : a_fast_200 n < 18 := by
  revert n hn; decide

lemma count_a_fast_200_eq_zero (m : ℕ) (hm : 18 ≤ m) (N : ℕ) (hN : N ≤ 180) : count_a_fast_200 N m = 0 := by
  unfold count_a_fast_200
  rw [List.countP_eq_zero]
  intro n hn
  rw [List.mem_range] at hn
  have hn_lt : n < 180 := by omega
  have h_lt := a_fast_200_lt_18 n hn_lt
  intro h_eq
  rw [decide_eq_true_iff] at h_eq
  omega

lemma count_a_eq_eq_count_a_fast_200 (m : ℕ) (N : ℕ) (hN : N ≤ 140) : count_a_eq N m = count_a_fast_200 N m := by
  unfold count_a_eq count_a_fast_200
  apply List.countP_congr
  intro n hn
  rw [List.mem_range] at hn
  have hn_lt : n < 199 := by omega
  rw [a_eq_a_fast_200 n hn_lt]

lemma count_a_eq_le_72_120 (m : ℕ) (N : ℕ) (h72 : 72 ≤ N) (h120 : N ≤ 120) : count_a_eq N m ≤ count_a_eq N 8 := by
  have hN_fast : count_a_eq N m = count_a_fast_200 N m := count_a_eq_eq_count_a_fast_200 m N (by omega)
  have h8_fast : count_a_eq N 8 = count_a_fast_200 N 8 := count_a_eq_eq_count_a_fast_200 8 N (by omega)
  rw [hN_fast, h8_fast]
  have hN : N = 72 ∨ N = 73 ∨ N = 74 ∨ N = 75 ∨ N = 76 ∨ N = 77 ∨ N = 78 ∨ N = 79 ∨ N = 80 ∨
            N = 81 ∨ N = 82 ∨ N = 83 ∨ N = 84 ∨ N = 85 ∨ N = 86 ∨ N = 87 ∨ N = 88 ∨ N = 89 ∨ N = 90 ∨
            N = 91 ∨ N = 92 ∨ N = 93 ∨ N = 94 ∨ N = 95 ∨ N = 96 ∨ N = 97 ∨ N = 98 ∨ N = 99 ∨ N = 100 ∨
            N = 101 ∨ N = 102 ∨ N = 103 ∨ N = 104 ∨ N = 105 ∨ N = 106 ∨ N = 107 ∨ N = 108 ∨ N = 109 ∨ N = 110 ∨
            N = 111 ∨ N = 112 ∨ N = 113 ∨ N = 114 ∨ N = 115 ∨ N = 116 ∨ N = 117 ∨ N = 118 ∨ N = 119 ∨ N = 120 := by omega
  rcases hN with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  all_goals
    clear hN_fast h8_fast
    by_cases h : m < 18
    · revert m h; decide
    · have hm : 18 ≤ m := by omega
      rw [count_a_fast_200_eq_zero m hm _ (by omega)]
      omega

lemma count_a_eq_succ (n m : ℕ) : count_a_eq (n + 1) m = count_a_eq n m + (if a n = m then 1 else 0) := by
  unfold count_a_eq
  simp [List.range_succ]


lemma count_a_eq_eq_of_ne (m : ℕ) (n : ℕ) (k : ℕ) (hk : k ≤ n) (h_ne : ∀ i, k ≤ i ∧ i < n → a i ≠ m) : count_a_eq n m = count_a_eq k m := by
  induction n, hk using Nat.le_induction with
  | base => rfl
  | succ i hi ih =>
    rw [count_a_eq_succ i m]
    have h_nei : a i ≠ m := by
      apply h_ne
      omega
    rw [if_neg h_nei]
    apply ih
    intro j hj
    apply h_ne
    omega

lemma count_a_eq_eq_of_one_eight (n : ℕ) (k : ℕ) (hk : k < n) (h_8 : a k = 8) (h_ne : ∀ i, k < i ∧ i < n → a i ≠ 8) : count_a_eq n 8 = count_a_eq k 8 + 1 := by
  have h_eq : count_a_eq n 8 = count_a_eq (k + 1) 8 := by
    apply count_a_eq_eq_of_ne 8 n (k + 1) (by omega)
    intro i hi
    apply h_ne
    omega
  rw [h_eq]
  rw [count_a_eq_succ k 8]
  rw [if_pos h_8]


lemma count_a_eq_invariant_small (m : ℕ) (hm : m ≠ 8) (N : ℕ) (hN : 120 ≤ N) (h140 : N ≤ 140) : count_a_eq N m + (if a N = m then 2 else 1) ≤ count_a_eq N 8 := by
  have hN_fast : count_a_eq N m = count_a_fast_200 N m := count_a_eq_eq_count_a_fast_200 m N h140
  have h8_fast : count_a_eq N 8 = count_a_fast_200 N 8 := count_a_eq_eq_count_a_fast_200 8 N h140
  rw [hN_fast, h8_fast]
