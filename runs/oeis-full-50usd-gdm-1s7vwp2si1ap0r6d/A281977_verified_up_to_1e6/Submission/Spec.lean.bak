def get_chunk (chunk_idx : ℕ) : ℕ :=
  match chunk_idx with
  | 0 => myData_0
  | 1 => myData_1
  | 2 => myData_2
  | 3 => myData_3
  | 4 => myData_4
  | 5 => myData_5
  | 6 => myData_6
  | 7 => myData_7
  | 8 => myData_8
  | 9 => myData_9
  | 10 => myData_10
  | _ => 0

def get_witness (n : ℕ) : ℕ × ℕ × ℕ × ℕ × ℕ :=
  let chunk_idx := n / 100000
  let offset := n % 100000
  let data := get_chunk chunk_idx
  let val := (data >>> (48 * offset)) &&& 0xffffffffffff
  let v := val % 256
  let val1 := val / 256
  let w := val1 % 1024
  let val2 := val1 / 1024
  let z := val2 % 1024
  let val3 := val2 / 1024
  let y := val3 % 1024
  let s := val3 / 1024
  (s, y, z, w, v)

def verify_witness (n : ℕ) : Bool :=
  let (s, y, z, w, v) := get_witness n
  ((s * s) ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 == n) &&
  (-7 * (s * s : ℤ) - 8 * (y : ℤ) + 8 * (z : ℤ) + 16 * (w : ℤ) == (v * v : ℤ))

lemma A281977_pos_of_verified (n : ℕ) (h : verify_witness n = true) : A281977 n > 0 := by
  dsimp [verify_witness] at h
  rw [Bool.and_eq_true] at h
  have h_sum := of_decide_eq_true h.1
  have h_L := of_decide_eq_true h.2
  exact A281977_pos_of_witness n (get_witness n).1 (get_witness n).2.1 (get_witness n).2.2.1 (get_witness n).2.2.2.1 (get_witness n).2.2.2.2 h_sum h_L

def check_range (lo : ℕ) (len : ℕ) (fuel : ℕ) : Bool :=
  if len = 0 then true
  else if len = 1 then verify_witness lo
  else
    match fuel with
    | 0 => false
    | fuel + 1 =>
      check_range lo (len / 2) fuel && check_range (lo + len / 2) (len - len / 2) fuel

lemma check_range_correct (lo len : ℕ) (fuel : ℕ) (h_check : check_range lo len fuel = true) (n : ℕ) (h_in : n ≥ lo ∧ n < lo + len) : verify_witness n = true := by
  induction fuel generalizing lo len n with
  | zero =>
    if h_zero : len = 0 then
      omega
    else if h_one : len = 1 then
      have : n = lo := by omega
      subst this
      unfold check_range at h_check
      simp [h_one] at h_check
      exact h_check
    else
      unfold check_range at h_check
      simp [h_zero, h_one] at h_check
  | succ fuel ih =>
    if h_zero : len = 0 then
      omega
    else if h_one : len = 1 then
      have : n = lo := by omega
      subst this
      unfold check_range at h_check
      simp [h_one] at h_check
      exact h_check
    else
      unfold check_range at h_check
      simp [h_zero, h_one] at h_check
      have h1 := h_check.1
      have h2 := h_check.2
      let half := len / 2
      by_cases hn : n < lo + half
      · apply ih lo half h1 n (by omega)
      · apply ih (lo + half) (len - half) h2 n (by omega)
