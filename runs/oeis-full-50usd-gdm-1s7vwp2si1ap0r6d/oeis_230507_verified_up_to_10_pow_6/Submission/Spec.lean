theorem spec_of_mem_cons_S {x : ℕ} {xs : List ℕ} (hx : S_condition x) (h_tail : ∀ y ∈ xs, S_condition y) :
    ∀ y ∈ x :: xs, S_condition y := by
  intro y hy
  simp only [List.mem_cons] at hy
  rcases hy with rfl | hy
  · exact hx
  · exact h_tail y hy

theorem spec_of_mem_nil_S : ∀ y ∈ ([] : List ℕ), S_condition y := by
  intro y hy
  nomatch hy

