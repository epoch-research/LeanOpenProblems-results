def string_to_array_bin_aux (s : String) (start len : ℕ) : ℕ → Array ℕ
  | 0 => #[]
  | fuel + 1 =>
    if len = 0 then #[]
    else if len = 1 then #[(String.Pos.Raw.get s (String.Pos.Raw.mk (2 * start))).toNat - 256]
    else
      let half := len / 2
      string_to_array_bin_aux s start half fuel ++ string_to_array_bin_aux s (start + half) (len - half) fuel

def string_to_array_bin (s : String) : Array ℕ :=
  string_to_array_bin_aux s 0 s.length 20

