def A230507_underestimate (n : ℕ) : ℕ :=
  Finset.sum (Finset.Icc 1 (n / 3)) fun a ↦
    Finset.sum (Finset.Icc a ((n - a) / 2)) fun b ↦
      let c := n - a - b
      if CustomS a && CustomS b && CustomS c
      then 1
      else 0

theorem A230507_underestimate_le (n : ℕ) : A230507_underestimate n ≤ A230507 n := by
  apply Finset.sum_le_sum
  intro a ha
  apply Finset.sum_le_sum
  intro b hb
  dsimp
  cases h : CustomS a && CustomS b && CustomS (n - a - b)
  · simp
  · rw [Bool.and_eq_true, Bool.and_eq_true] at h
    rcases h with ⟨⟨ha1, hb1⟩, hc1⟩
    have h_a_cond := CustomS_spec a ha1
    have h_b_cond := CustomS_spec b hb1
    have h_c_cond := CustomS_spec (n - a - b) hc1
    have h_all : S_condition a ∧ S_condition b ∧ S_condition (n - a - b) := ⟨h_a_cond, h_b_cond, h_c_cond⟩
    rw [if_pos h_all]
    simp

def check_S_witness (n : ℕ) : Bool :=
  if n < 3 then true
  else
    let idx := n - 3
    let a_idx := witness_S_all.getD (2 * idx) 0
    let b_idx := witness_S_all.getD (2 * idx + 1) 0
    let a := C_array.getD a_idx 0
    let b := C_array.getD b_idx 0
    let c := n - a - b
    1 ≤ a ∧ a ≤ n / 3 ∧ a ≤ b ∧ b ≤ (n - a) / 2 ∧ CustomS a ∧ CustomS b ∧ CustomS c


theorem claim1_part1 : check_range_2d check_S_witness 0 200 100 = true := by decide

end OeisA230507
