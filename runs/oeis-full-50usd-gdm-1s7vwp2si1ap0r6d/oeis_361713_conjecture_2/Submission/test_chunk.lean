import FormalConjectures.Util.ProblemImports
open Finset Nat
set_option maxRecDepth 200000
abbrev State := ℕ × ℕ × ℕ × ℕ
def a_loop (n : ℕ) : ℕ → State → State
  | 0, s => s
  | d + 1, (k, c1, c2, acc) =>
    if k < n then
      a_loop n d (k + 1, c1 * (n - k) / (k + 1), c2 * (n + k) / (k + 1), acc + c1^2 * c2^2)
    else
      (k, c1, c2, acc)
def step_1000 (n : ℕ) (s : State) : State := a_loop n 1000 s
def step_807 (n : ℕ) (s : State) : State := a_loop n 807 s
def t0 : State := (0, 1, 1, 0)
def t1 : State := (1000, , , )
theorem t_step_0 : step_1000 16807 t0 = t1 := by decide
