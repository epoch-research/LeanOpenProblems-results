def P (n : ℕ) : Prop :=
  A130911 n ≥ 1 ∧
  (A130911 n = 1 → n = 11) ∧
  (A130911 n = 2 → n = 12 ∨ n = 14 ∨ n = 16) ∧
  (A130911 n = 3 → n = 13 ∨ n = 15 ∨ n = 17) ∧
  (A130911 n = 4 → n = 18 ∨ n = 20 ∨ n = 24 ∨ n = 26) ∧
  (A130911 n = 5 → n = 19 ∨ n = 21 ∨ n = 23 ∨ n = 25 ∨ n = 27) ∧
  (A130911 n = 6 → n = 22 ∨ n = 28 ∨ n = 30) ∧
  (A130911 n = 7 → n = 29 ∨ n = 31 ∨ n = 35) ∧
  (A130911 n = 8 → n = 32 ∨ n = 34 ∨ n = 36 ∨ n = 38) ∧
  (A130911 n ≤ 8 → n ≤ 38)

theorem A130911_ge_one (n : ℕ) : n ≥ 11 → P n := by
  induction' n with n ih
  · intro h; omega
  · intro h
    by_cases hn : n ≥ 11
    · have h_ih := ih hn
      have h_ih_1 := h_ih.1
      have h_ih_2 := h_ih.2.1
      have h_ih_3 := h_ih.2.2.1
      have h_ih_4 := h_ih.2.2.2.1
      have h_ih_5 := h_ih.2.2.2.2.1
      have h_ih_6 := h_ih.2.2.2.2.2.1
      have h_ih_7 := h_ih.2.2.2.2.2.2.1
      have h_ih_8 := h_ih.2.2.2.2.2.2.2.1
      have h_ih_9 := h_ih.2.2.2.2.2.2.2.2.1
      have h_ih_10 := h_ih.2.2.2.2.2.2.2.2.2

      have h_step : A130911 (n + 1) = A130911 n +
        (let binary_weight (k : ℕ) : ℕ := (Nat.digits 2 k).sum
         let weight_parity_sign (p : ℕ) : ℤ := if (binary_weight p).bodd then 1 else -1
         weight_parity_sign (Nat.nth Nat.Prime n)) := by
        dsimp [A130911]
        rw [sum_range_succ]
      have sgn_values :
        (let binary_weight (k : ℕ) : ℕ := (Nat.digits 2 k).sum
         let weight_parity_sign (p : ℕ) : ℤ := if (binary_weight p).bodd then 1 else -1
         weight_parity_sign (Nat.nth Nat.Prime n)) = 1 ∨
        (let binary_weight (k : ℕ) : ℕ := (Nat.digits 2 k).sum
         let weight_parity_sign (p : ℕ) : ℤ := if (binary_weight p).bodd then 1 else -1
         weight_parity_sign (Nat.nth Nat.Prime n)) = -1 := by
        dsimp; split <;> omega
      rcases sgn_values with h_sgn | h_sgn
      · -- sgn = 1
        refine ⟨by omega, ?_⟩
        intro h_eq_1; omega
        intro h_eq_2; have : A130911 n = 1 := by omega
        have hn11 := h_ih_2 this; omega
        intro h_eq_3; have : A130911 n = 2 := by omega
        have hn_or := h_ih_3 this; omega
        intro h_eq_4; have : A130911 n = 3 := by omega
        have hn_or := h_ih_4 this
        rcases hn_or with rfl|rfl|rfl
        · have := sgn_not_plus_13 n h_sgn; contradiction
        · have := sgn_not_plus_15 n h_sgn; contradiction
        · right; right; right; rfl
        intro h_eq_5; have : A130911 n = 4 := by omega
        have hn_or := h_ih_5 this; omega
        intro h_eq_6; have : A130911 n = 5 := by omega
        have hn_or := h_ih_6 this
        rcases hn_or with rfl|rfl|rfl|rfl|rfl
        · have := sgn_not_plus_19 n h_sgn; contradiction
        · left; rfl
        · have := sgn_not_plus_23 n h_sgn; contradiction
        · have := sgn_not_plus_25 n h_sgn; contradiction
        · right; left; rfl
        intro h_eq_7; have : A130911 n = 6 := by omega
        have hn_or := h_ih_7 this
        rcases hn_or with rfl|rfl|rfl
        · have := sgn_not_plus_22 n h_sgn; contradiction
        · left; rfl
        · right; left; rfl
        intro h_eq_8; have : A130911 n = 7 := by omega
        have hn_or := h_ih_8 this
        rcases hn_or with rfl|rfl|rfl
        · have := sgn_not_plus_29 n h_sgn; contradiction
        · left; rfl
        · right; left; rfl
        intro h_le8
        by_cases hn14 : n ≤ 13
        · omega
        · by_cases hn14_eq : n = 14
          · subst hn14_eq
            have h_a15 : A130911 15 = 3 := by rw [A130911_15]
            omega
          · have hn15 : n ≥ 15 := by omega
            have hn_le38 : n ≤ 38 := by
              apply h_ih_10
              omega
            omega
      · -- sgn = -1
        have h_ge2 : A130911 n ≥ 2 := by
          by_cases hn11 : n = 11
          · have := sgn_not_minus_11 n h_sgn; contradiction
          · have : A130911 n ≠ 1 := by
              intro h_eq1
              have := h_ih_2 h_eq1
              contradiction
            omega
        refine ⟨by omega, ?_⟩
        intro h_eq_1; have : A130911 n = 2 := by omega
        have hn_or := h_ih_3 this; omega
        intro h_eq_2; have : A130911 n = 3 := by omega
        have hn_or := h_ih_4 this
        rcases hn_or with rfl|rfl|rfl
        · have := sgn_not_minus_12 n h_sgn; contradiction
        · have := sgn_not_minus_14 n h_sgn; contradiction
        · have := sgn_not_minus_16 n h_sgn; contradiction
        intro h_eq_3; have : A130911 n = 4 := by omega
        have hn_or := h_ih_5 this
        rcases hn_or with rfl|rfl|rfl|rfl
        · have := sgn_not_minus_18 n h_sgn; contradiction
        · have := sgn_not_minus_20 n h_sgn; contradiction
        · have := sgn_not_minus_24 n h_sgn; contradiction
        · have := sgn_not_minus_26 n h_sgn; contradiction
        intro h_eq_4; have : A130911 n = 5 := by omega
        have hn_or := h_ih_6 this
        rcases hn_or with rfl|rfl|rfl|rfl|rfl
        · left; rfl
        · have := sgn_not_minus_21 n h_sgn; contradiction
        · right; left; rfl
        · right; right; left; rfl
        · have := sgn_not_minus_27 n h_sgn; contradiction
        intro h_eq_5; have : A130911 n = 6 := by omega
        have hn_or := h_ih_7 this
        rcases hn_or with rfl|rfl|rfl
        · right; right; left; rfl
        · have := sgn_not_minus_28 n h_sgn; contradiction
        · have := sgn_not_minus_30 n h_sgn; contradiction
        intro h_eq_6; have : A130911 n = 7 := by omega
        have hn_or := h_ih_8 this
        rcases hn_or with rfl|rfl|rfl
        · right; right; rfl
        · have := sgn_not_minus_31 n h_sgn; contradiction
        · have := sgn_not_minus_35 n h_sgn; contradiction
        intro h_eq_7; have : A130911 n = 8 := by omega
        have hn_or := h_ih_9 this
        rcases hn_or with rfl|rfl|rfl|rfl
        · have := sgn_not_minus_32 n h_sgn; contradiction
        · left; rfl
        · have := sgn_not_minus_36 n h_sgn; contradiction
        · have := sgn_not_minus_38 n h_sgn; contradiction
        intro h_eq_8; have : A130911 n = 9 := by omega
        have hn_le8 : A130911 n ≤ 8 := by
          have hn_le38 : n ≤ 38 := by
            apply h_ih_10
            omega
          by_cases hn_le37 : n ≤ 37
          · exact A130911_le_8_of_le_37_all n h_ih_1 hn_le37
          · have : n = 38 := by omega
            rw [this, A130911_38]; decide
        omega
        intro h_le8
        have hn_le38 : n ≤ 38 := by
          apply h_ih_10
          omega
        omega
    · -- n < 11, so n+1 is one of the small concrete values
      have h_eq : n + 1 = 11 := by omega
      subst h_eq
      refine ⟨by rw [A130911_11]; decide, ?_⟩
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      refine ⟨?_, ?_⟩
      · rw [A130911_11]; decide
      · ?_
      · rw [A130911_11]; decide

theorem oeis_130911_conjecture_0 (n : ℕ) (h : n > 3) : A130911 n ≥ 0 := by
  by_cases hn : n ≥ 11
  · have h_ge := (A130911_ge_one n hn).1
    omega
  · have h_lt : n < 11 := by omega
    interval_cases n
    · rw [A130911_4]; decide
    · rw [A130911_5]; decide
    · rw [A130911_6]; decide
    · rw [A130911_7]; decide
    · rw [A130911_8]; decide
    · rw [A130911_9]; decide
    · rw [A130911_10]; decide
