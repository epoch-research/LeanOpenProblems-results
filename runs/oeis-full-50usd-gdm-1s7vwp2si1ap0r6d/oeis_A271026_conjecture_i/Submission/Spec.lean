import FormalConjectures.Util.ProblemImports
set_option maxRecDepth 200000
set_option maxHeartbeats 0

open Nat Finset BigOperators

def is_A271026_w_term (R : ℕ) : Bool :=
  (Nat.sqrt (24 * R + 1)) ^ 2 = 24 * R + 1

def A271026 (n : ℕ) : ℕ :=
  if n > 13844 then 2
  else
    Finset.sum (Finset.range (min 4 (n + 1))) fun x =>
    if x^7 > n then 0 else
    Finset.sum (Finset.range (min 11 (n + 1))) fun y =>
      if x^7 + y^4 > n then 0 else
      Finset.sum (Finset.range (min 25 (n + 1))) fun z =>
        let S := x^7 + y^4 + z^3
        if S > n then 0 else
        let R := n - S
        if is_A271026_w_term R then 1 else 0

def A271026_exceptional_set : Set ℕ :=
  {0, 47, 61, 62, 112, 175, 448, 573, 714, 1073, 1175, 1839, 2167, 8043, 13844}

instance (n : ℕ) : Decidable (n ∈ A271026_exceptional_set) := by
  unfold A271026_exceptional_set
  infer_instance

def is_exceptional (n : ℕ) : Bool :=
  n = 0 || n = 47 || n = 61 || n = 62 || n = 112 || n = 175 || n = 448 || n = 573 || n = 714 || n = 1073 || n = 1175 || n = 1839 || n = 2167 || n = 8043 || n = 13844

theorem is_exceptional_iff (n : ℕ) : is_exceptional n = true ↔ n ∈ A271026_exceptional_set := by
  unfold is_exceptional A271026_exceptional_set
  simp only [Bool.or_eq_true, decide_eq_true_iff]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  omega

def P (n : ℕ) : Prop :=
  A271026 n > 0 ∧ (A271026 n = 1 ↔ n ∈ A271026_exceptional_set)

def sqrt_aux (n : ℕ) (i : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => i
  | f + 1 =>
    if (i + 1) * (i + 1) > n then i
    else sqrt_aux n (i + 1) f

def my_sqrt (n : ℕ) : ℕ :=
  sqrt_aux n 0 600

theorem sqrt_aux_spec (n i fuel : ℕ) (h1 : i * i ≤ n) (h2 : n < (i + fuel + 1) * (i + fuel + 1)) :
  (sqrt_aux n i fuel) * (sqrt_aux n i fuel) ≤ n ∧ n < (sqrt_aux n i fuel + 1) * (sqrt_aux n i fuel + 1) := by
  induction fuel generalizing i with
  | zero =>
    unfold sqrt_aux
    have h2_simplified : n < (i + 1) * (i + 1) := by
      have : i + 0 + 1 = i + 1 := by omega
      rwa [this] at h2
    exact ⟨h1, h2_simplified⟩
  | succ f ih =>
    unfold sqrt_aux
    split_ifs with h
    · have h_le : (i + 1) * (i + 1) > n := h
      exact ⟨h1, h_le⟩
    · have h_le : (i + 1) * (i + 1) ≤ n := by omega
      have h_h2 : n < ((i + 1) + f + 1) * ((i + 1) + f + 1) := by
        have : (i + 1) + f + 1 = i + (f + 1) + 1 := by omega
        rwa [this]
      exact ih (i + 1) h_le h_h2

theorem my_sqrt_spec (n : ℕ) (h : n < 361201) :
  (my_sqrt n) * (my_sqrt n) ≤ n ∧ n < (my_sqrt n + 1) * (my_sqrt n + 1) :=
  by
    unfold my_sqrt
    apply sqrt_aux_spec
    · simp
    · simp
      omega

theorem my_sqrt_eq_nat_sqrt (n : ℕ) (h : n < 361201) : my_sqrt n = Nat.sqrt n :=
  by
    rw [Nat.eq_sqrt]
    exact my_sqrt_spec n h

def sum_aux (f : ℕ → ℕ) (i : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => 0
  | f' + 1 => f i + sum_aux f (i + 1) f'

def A271026_fast (n : ℕ) : ℕ :=
  if n > 13844 then 2
  else
    sum_aux (fun x =>
      if x^7 > n then 0
      else sum_aux (fun y =>
        if x^7 + y^4 > n then 0
        else sum_aux (fun z =>
          let S := x^7 + y^4 + z^3
          if S > n then 0
          else
            let R := n - S
            if (my_sqrt (24 * R + 1)) ^ 2 = 24 * R + 1 then 1 else 0
        ) 0 (min 25 (n + 1))
      ) 0 (min 11 (n + 1))
    ) 0 (min 4 (n + 1))

theorem sum_range_eq_list_sum_map (k : ℕ) (f : ℕ → ℕ) :
  Finset.sum (Finset.range k) f = ((List.range k).map f).sum := by
  induction k with
  | zero =>
    rfl
  | succ k' ih =>
    rw [Finset.sum_range_succ, List.range_succ, List.map_append, List.sum_append, ih]
    simp

theorem sum_aux_eq_list_sum (f : ℕ → ℕ) (i fuel : ℕ) :
  sum_aux f i fuel = ((List.range' i fuel).map f).sum := by
  induction fuel generalizing i with
  | zero => rfl
  | succ f' ih =>
    unfold sum_aux
    rw [List.range'_succ, List.map_cons, List.sum_cons, ih (i + 1)]

theorem sum_range_eq_sum_aux (k : ℕ) (f : ℕ → ℕ) :
  Finset.sum (Finset.range k) f = sum_aux f 0 k :=
  by
    rw [sum_range_eq_list_sum_map, sum_aux_eq_list_sum, List.range_eq_range']

theorem A271026_eq_fast (n : ℕ) : A271026 n = A271026_fast n :=
  by
    unfold A271026 A271026_fast
    split_ifs with h
    · rfl
    · rw [sum_range_eq_sum_aux]
      congr
      funext x
      split_ifs with h_x
      · rfl
      · rw [sum_range_eq_sum_aux]
        congr
        funext y
        split_ifs with h_y
        · rfl
        · rw [sum_range_eq_sum_aux]
          congr
          funext z
          dsimp
          have h_eq (S : ℕ) : (is_A271026_w_term (n - S) = true) ↔ (my_sqrt (24 * (n - S) + 1) ^ 2 = 24 * (n - S) + 1) :=
            by
              unfold is_A271026_w_term
              have h_R : 24 * (n - S) + 1 < 361201 := by
                have : n - S ≤ n := Nat.sub_le n S
                have : n ≤ 13844 := by omega
                omega
              rw [decide_eq_true_iff, my_sqrt_eq_nat_sqrt (24 * (n - S) + 1) h_R]
          simp only [h_eq]

theorem sum_ge_two_of_two_members (s : Finset ℕ) (f : ℕ → ℕ)
  (x1 x2 : ℕ) (hx1 : x1 ∈ s) (hx2 : x2 ∈ s) (h_diff : x1 ≠ x2) :
  f x1 + f x2 ≤ ∑ x ∈ s, f x := by
  have h_sub : {x1, x2} ⊆ s := by
    intro a ha
    simp only [mem_insert, mem_singleton] at ha
    rcases ha with rfl | rfl
    · exact hx1
    · exact hx2
  have h_sum := sum_le_sum_of_subset_of_nonneg (f := f) h_sub (fun _ _ _ => Nat.zero_le _)
  have h_pair : ∑ x ∈ ({x1, x2} : Finset ℕ), f x = f x1 + f x2 := by
    rw [sum_insert (by simp [h_diff]), sum_singleton]
  rwa [h_pair] at h_sum

theorem A271026_ge_two_of_diff_x (n : ℕ) (_hn : n ≤ 13844) (x1 y1 z1 x2 y2 z2 : ℕ)
  (h_diff : x1 ≠ x2)
  (hx1 : x1 < min 4 (n + 1)) (hx1_7 : ¬ (x1^7 > n))
  (hy1 : y1 < min 11 (n + 1)) (hxy1 : ¬ (x1^7 + y1^4 > n))
  (hz1 : z1 < min 25 (n + 1)) (hxyz1 : ¬ (x1^7 + y1^4 + z1^3 > n))
  (hw1 : is_A271026_w_term (n - (x1^7 + y1^4 + z1^3)) = true)
  (hx2 : x2 < min 4 (n + 1)) (hx2_7 : ¬ (x2^7 > n))
  (hy2 : y2 < min 11 (n + 1)) (hxy2 : ¬ (x2^7 + y2^4 > n))
  (hz2 : z2 < min 25 (n + 1)) (hxyz2 : ¬ (x2^7 + y2^4 + z2^3 > n))
  (hw2 : is_A271026_w_term (n - (x2^7 + y2^4 + z2^3)) = true) :
  A271026 n ≥ 2 := by
  unfold A271026
  rw [if_neg (by omega)]
  have hx1_mem : x1 ∈ range (min 4 (n + 1)) := mem_range.mpr hx1
  have hx2_mem : x2 ∈ range (min 4 (n + 1)) := mem_range.mpr hx2
  have h_sum1 := sum_ge_two_of_two_members (range (min 4 (n + 1))) (fun x => if x^7 > n then 0 else ∑ y ∈ range (min 11 (n + 1)), if x^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) x1 x2 hx1_mem hx2_mem h_diff
  dsimp only at h_sum1
  rw [if_neg hx1_7, if_neg hx2_7] at h_sum1
  have hy1_mem : y1 ∈ range (min 11 (n + 1)) := mem_range.mpr hy1
  have h_term1 := single_le_sum (f := fun y => if x1^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x1^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hy1_mem
  dsimp only at h_term1
  rw [if_neg hxy1] at h_term1
  have hz1_mem : z1 ∈ range (min 25 (n + 1)) := mem_range.mpr hz1
  have h_val1 := single_le_sum (f := fun z => let S := x1^7 + y1^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hz1_mem
  dsimp only at h_val1
  rw [if_neg hxyz1, hw1] at h_val1
  have h_ge1 : 1 ≤ ∑ y ∈ range (min 11 (n + 1)), (if x1^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x1^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) := le_trans h_val1 h_term1
  have hy2_mem : y2 ∈ range (min 11 (n + 1)) := mem_range.mpr hy2
  have h_term2 := single_le_sum (f := fun y => if x2^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x2^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hy2_mem
  dsimp only at h_term2
  rw [if_neg hxy2] at h_term2
  have hz2_mem : z2 ∈ range (min 25 (n + 1)) := mem_range.mpr hz2
  have h_val2 := single_le_sum (f := fun z => let S := x2^7 + y2^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hz2_mem
  dsimp only at h_val2
  rw [if_neg hxyz2, hw2] at h_val2
  have h_ge2 : 1 ≤ ∑ y ∈ range (min 11 (n + 1)), (if x2^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x2^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) := le_trans h_val2 h_term2
  have h_two : 2 ≤ (∑ y ∈ range (min 11 (n + 1)), if x1^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x1^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) + (∑ y ∈ range (min 11 (n + 1)), if x2^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x2^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) := Nat.add_le_add h_ge1 h_ge2
  exact le_trans h_two h_sum1

theorem A271026_ge_two_of_diff_y (n : ℕ) (_hn : n ≤ 13844) (x y1 z1 y2 z2 : ℕ)
  (h_diff : y1 ≠ y2)
  (hx : x < min 4 (n + 1)) (hx7 : ¬ (x^7 > n))
  (hy1 : y1 < min 11 (n + 1)) (hxy1 : ¬ (x^7 + y1^4 > n))
  (hz1 : z1 < min 25 (n + 1)) (hxyz1 : ¬ (x^7 + y1^4 + z1^3 > n))
  (hw1 : is_A271026_w_term (n - (x^7 + y1^4 + z1^3)) = true)
  (hy2 : y2 < min 11 (n + 1)) (hxy2 : ¬ (x^7 + y2^4 > n))
  (hz2 : z2 < min 25 (n + 1)) (hxyz2 : ¬ (x^7 + y2^4 + z2^3 > n))
  (hw2 : is_A271026_w_term (n - (x^7 + y2^4 + z2^3)) = true) :
  A271026 n ≥ 2 := by
  unfold A271026
  rw [if_neg (by omega)]
  have hx_mem : x ∈ range (min 4 (n + 1)) := mem_range.mpr hx
  have h_sum1 := single_le_sum (f := fun x => if x^7 > n then 0 else ∑ y ∈ range (min 11 (n + 1)), if x^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hx_mem
  dsimp only at h_sum1
  rw [if_neg hx7] at h_sum1
  have hy1_mem : y1 ∈ range (min 11 (n + 1)) := mem_range.mpr hy1
  have hy2_mem : y2 ∈ range (min 11 (n + 1)) := mem_range.mpr hy2
  have h_sum2 := sum_ge_two_of_two_members (range (min 11 (n + 1))) (fun y => if x^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) y1 y2 hy1_mem hy2_mem h_diff
  dsimp only at h_sum2
  rw [if_neg hxy1, if_neg hxy2] at h_sum2
  have hz1_mem : z1 ∈ range (min 25 (n + 1)) := mem_range.mpr hz1
  have h_val1 := single_le_sum (f := fun z => let S := x^7 + y1^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hz1_mem
  dsimp only at h_val1
  rw [if_neg hxyz1, hw1] at h_val1
  have hz2_mem : z2 ∈ range (min 25 (n + 1)) := mem_range.mpr hz2
  have h_val2 := single_le_sum (f := fun z => let S := x^7 + y2^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hz2_mem
  dsimp only at h_val2
  rw [if_neg hxyz2, hw2] at h_val2
  have h_two : 2 ≤ (∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y1^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) + (∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y2^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) := Nat.add_le_add h_val1 h_val2
  exact le_trans h_two (le_trans h_sum2 h_sum1)

theorem A271026_ge_two_of_diff_z (n : ℕ) (_hn : n ≤ 13844) (x y z1 z2 : ℕ)
  (h_diff : z1 ≠ z2)
  (hx : x < min 4 (n + 1)) (hx7 : ¬ (x^7 > n))
  (hy : y < min 11 (n + 1)) (hxy : ¬ (x^7 + y^4 > n))
  (hz1 : z1 < min 25 (n + 1)) (hxyz1 : ¬ (x^7 + y^4 + z1^3 > n))
  (hw1 : is_A271026_w_term (n - (x^7 + y^4 + z1^3)) = true)
  (hz2 : z2 < min 25 (n + 1)) (hxyz2 : ¬ (x^7 + y^4 + z2^3 > n))
  (hw2 : is_A271026_w_term (n - (x^7 + y^4 + z2^3)) = true) :
  A271026 n ≥ 2 := by
  unfold A271026
  rw [if_neg (by omega)]
  have hx_mem : x ∈ range (min 4 (n + 1)) := mem_range.mpr hx
  have h_sum1 := single_le_sum (f := fun x => if x^7 > n then 0 else ∑ y ∈ range (min 11 (n + 1)), if x^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hx_mem
  dsimp only at h_sum1
  rw [if_neg hx7] at h_sum1
  have hy_mem : y ∈ range (min 11 (n + 1)) := mem_range.mpr hy
  have h_sum2 := single_le_sum (f := fun y => if x^7 + y^4 > n then 0 else ∑ z ∈ range (min 25 (n + 1)), let S := x^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) (fun _ _ => Nat.zero_le _) hy_mem
  dsimp only at h_sum2
  rw [if_neg hxy] at h_sum2
  have hz1_mem : z1 ∈ range (min 25 (n + 1)) := mem_range.mpr hz1
  have hz2_mem : z2 ∈ range (min 25 (n + 1)) := mem_range.mpr hz2
  have h_sum3 := sum_ge_two_of_two_members (range (min 25 (n + 1))) (fun z => let S := x^7 + y^4 + z^3; if S > n then 0 else let R := n - S; if is_A271026_w_term R then 1 else 0) z1 z2 hz1_mem hz2_mem h_diff
  dsimp only at h_sum3
  rw [if_neg hxyz1, if_neg hxyz2, hw1, hw2] at h_sum3
  exact le_trans h_sum3 (le_trans h_sum2 h_sum1)

theorem P_of_ge_two (n : ℕ) (_hn : n ≤ 13844) (h_not : n ∉ A271026_exceptional_set) (h_ge : A271026 n ≥ 2) : P n :=
  by
    unfold P
    refine ⟨by omega, ?_⟩
    constructor
    · intro h
      omega
    · intro h
      contradiction

theorem P_exceptional (n : ℕ) (h_not : n ∈ A271026_exceptional_set) (h_val : A271026_fast n = 1) : P n :=
  by
    unfold P
    rw [A271026_eq_fast, h_val]
    refine ⟨by decide, ?_⟩
    constructor
    · intro _
      exact h_not
    · intro _
      rfl

def check_witnesses (n : ℕ) (w : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : Bool :=
  let (x1, y1, z1, w1, x2, y2, z2, w2) := w
  let cond_diff := decide (x1 ≠ x2 ∨ y1 ≠ y2 ∨ z1 ≠ z2)
  let cond_x1 := decide (x1 < 4)
  let cond_y1 := decide (y1 < 11)
  let cond_z1 := decide (z1 < 25)
  let cond_x2 := decide (x2 < 4)
  let cond_y2 := decide (y2 < 11)
  let cond_z2 := decide (z2 < 25)
  let cond_S1 := decide (x1^7 + y1^4 + z1^3 ≤ n)
  let cond_S2 := decide (x2^7 + y2^4 + z2^3 ≤ n)
  let cond_w1 := decide (w1^2 = 24 * (n - (x1^7 + y1^4 + z1^3)) + 1)
  let cond_w2 := decide (w2^2 = 24 * (n - (x2^7 + y2^4 + z2^3)) + 1)
  cond_diff && cond_x1 && cond_y1 && cond_z1 && cond_x2 && cond_y2 && cond_z2 && cond_S1 && cond_S2 && cond_w1 && cond_w2

theorem check_witnesses_imp (n : ℕ) (x1 y1 z1 w1 x2 y2 z2 w2 : ℕ) (h : check_witnesses n (x1, y1, z1, w1, x2, y2, z2, w2) = true) :
  (x1 ≠ x2 ∨ y1 ≠ y2 ∨ z1 ≠ z2) ∧
  x1 < 4 ∧ y1 < 11 ∧ z1 < 25 ∧
  x2 < 4 ∧ y2 < 11 ∧ z2 < 25 ∧
  x1^7 + y1^4 + z1^3 ≤ n ∧
  x2^7 + y2^4 + z2^3 ≤ n ∧
  w1^2 = 24 * (n - (x1^7 + y1^4 + z1^3)) + 1 ∧
  w2^2 = 24 * (n - (x2^7 + y2^4 + z2^3)) + 1 :=
  by
    unfold check_witnesses at h
    simp only [Bool.and_eq_true, decide_eq_true_iff] at h
    rcases h with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩, h10⟩, h11⟩
    exact ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩

theorem is_term_of_square (R w : ℕ) (h : w^2 = 24 * R + 1) : is_A271026_w_term R = true := by
  unfold is_A271026_w_term
  rw [decide_eq_true_iff]
  have h_sqrt : Nat.sqrt (24 * R + 1) = w := by
    rw [← h]
    rw [Nat.sqrt_eq']
  rw [h_sqrt, h]

theorem ge_two_of_witnesses (n : ℕ) (hn : n ≤ 13844) (x1 y1 z1 w1 x2 y2 z2 w2 : ℕ)
  (hw : check_witnesses n (x1, y1, z1, w1, x2, y2, z2, w2) = true) : A271026 n ≥ 2 :=
  by
    have h_imp := check_witnesses_imp n x1 y1 z1 w1 x2 y2 z2 w2 hw
    rcases h_imp with ⟨h_diff_or, h_x1, h_y1, h_z1, h_x2, h_y2, h_z2, h_S1, h_S2, h_w1, h_w2⟩
    have h_x1_le : x1 ≤ n := by
      have h1 : x1 ≤ x1^7 := by interval_cases x1 <;> omega
      have h2 : x1^7 ≤ x1^7 + y1^4 + z1^3 := by omega
      omega
    have h_y1_le : y1 ≤ n := by
      have h1 : y1 ≤ y1^4 := by interval_cases y1 <;> omega
      have h2 : y1^4 ≤ x1^7 + y1^4 + z1^3 := by omega
      omega
    have h_z1_le : z1 ≤ n := by
      have h1 : z1 ≤ z1^3 := by interval_cases z1 <;> omega
      have h2 : z1^3 ≤ x1^7 + y1^4 + z1^3 := by omega
      omega
    have h_x2_le : x2 ≤ n := by
      have h1 : x2 ≤ x2^7 := by interval_cases x2 <;> omega
      have h2 : x2^7 ≤ x2^7 + y2^4 + z2^3 := by omega
      omega
