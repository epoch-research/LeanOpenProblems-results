def verify_all_witnesses_aux (n : ℕ) : Bool :=
  match n with
  | 0 => true
  | n' + 1 =>
    let verified : Bool :=
      if is_exceptional n' then
        decide (A271026_fast n' = 1)
      else
        check_witnesses n' (get_witnesses n')
    verified && verify_all_witnesses_aux n'

theorem verify_all_ok : verify_all_witnesses_aux 13845 = true :=
  by decide

theorem verify_ok_of_lt (n : ℕ) (limit : ℕ) (h_all : verify_all_witnesses_aux limit = true) (hn : n < limit) :
  if n ∈ A271026_exceptional_set then A271026_fast n = 1 else check_witnesses n (get_witnesses n) = true :=
  by
    induction limit generalizing n with
    | zero => omega
    | succ l ih =>
      unfold verify_all_witnesses_aux at h_all
      rw [Bool.and_eq_true] at h_all
      rcases h_all with ⟨h_curr, h_prev⟩
      have hn_cases : n < l ∨ n = l := by omega
      rcases hn_cases with hn_lt | rfl
      · exact ih n h_prev hn_lt
      · have h_exc_eq : (n ∈ A271026_exceptional_set) ↔ (is_exceptional n = true) := by
          rw [is_exceptional_iff]
        by_cases h_exceptional : n ∈ A271026_exceptional_set
        · have h_exc : is_exceptional n = true := h_exc_eq.mp h_exceptional
          rw [if_pos h_exc] at h_curr
          rw [if_pos h_exceptional]
          rwa [decide_eq_true_iff] at h_curr
        · have h_exc : is_exceptional n = false := by
            cases h_e : is_exceptional n with
            | false => rfl
            | true =>
              have : n ∈ A271026_exceptional_set := h_exc_eq.mpr h_e
              contradiction
          rw [if_neg h_exc] at h_curr
          rw [if_neg h_exceptional]
          exact h_curr

theorem oeis_A271026_conjecture_i (n : ℕ) :
  A271026 n > 0 ∧ (A271026 n = 1 ↔ n ∈ A271026_exceptional_set) :=
  by
    by_cases h : n > 13844
    · unfold A271026
      rw [if_pos h]
      refine ⟨by decide, ?_⟩
      constructor
      · intro h2; contradiction
      · intro h2
        unfold A271026_exceptional_set at h2
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h2
        rcases h2 with h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2 | h2
        all_goals (subst h2; revert h; decide)
    · have hn : n < 13845 := Nat.lt_succ_of_le (Nat.le_of_not_lt h)
      have h_ok := verify_ok_of_lt n 13845 verify_all_ok hn
      by_cases h_exceptional : n ∈ A271026_exceptional_set
      · rw [if_pos h_exceptional] at h_ok
        exact P_exceptional n h_exceptional h_ok
      · rw [if_neg h_exceptional] at h_ok
        have h_ge : A271026 n ≥ 2 := by
          let w := get_witnesses n
          have h_w_eq : w = (get_witnesses n) := rfl
          rcases w with ⟨x1, y1, z1, w1, x2, y2, z2, w2⟩
          rw [← h_w_eq] at h_ok
          exact ge_two_of_witnesses n (by omega) x1 y1 z1 w1 x2 y2 z2 w2 h_ok
        exact P_of_ge_two n (by omega) h_exceptional h_ge