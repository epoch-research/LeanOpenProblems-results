def phi {P p : ℕ} (h : p ∣ P) (x : R P) : R p :=
  ⟨ZMod.castHom h (ZMod p) x.re, ZMod.castHom h (ZMod p) x.im⟩

theorem phi_one {P p : ℕ} (h : p ∣ P) : phi h 1 = 1 := by
  ext
  · change ZMod.castHom h (ZMod p) 1 = 1
    rw [map_one]
  · change ZMod.castHom h (ZMod p) 0 = 0
    rw [map_zero]

theorem phi_mul {P p : ℕ} (h : p ∣ P) (x y : R P) : phi h (x * y) = phi h x * phi h y := by
  ext
  · change ZMod.castHom h (ZMod p) (x.re * y.re + 3 * x.im * y.im) =
      (ZMod.castHom h (ZMod p) x.re * ZMod.castHom h (ZMod p) y.re + 3 * ZMod.castHom h (ZMod p) x.im * ZMod.castHom h (ZMod p) y.im)
    simp only [map_add, map_mul, map_ofNat]
  · change ZMod.castHom h (ZMod p) (x.re * y.im + x.im * y.re) =
      (ZMod.castHom h (ZMod p) x.re * ZMod.castHom h (ZMod p) y.im + ZMod.castHom h (ZMod p) x.im * ZMod.castHom h (ZMod p) y.re)
    simp only [map_add, map_mul]

theorem phi_pow {P p : ℕ} (h : p ∣ P) (x : R P) (n : ℕ) : phi h (x ^ n) = (phi h x) ^ n := by
  induction n with
  | zero =>
    rw [pow_zero, pow_zero, phi_one]
  | succ n ih =>
    rw [pow_succ, pow_succ, phi_mul, ih]

theorem phi_sub {P p : ℕ} (h : p ∣ P) (x y : R P) : phi h (x - y) = phi h x - phi h y := by
  ext
  · change ZMod.castHom h (ZMod p) (x.re - y.re) = ZMod.castHom h (ZMod p) x.re - ZMod.castHom h (ZMod p) y.re
    rw [map_sub]
  · change ZMod.castHom h (ZMod p) (x.im - y.im) = ZMod.castHom h (ZMod p) x.im - ZMod.castHom h (ZMod p) y.im
    rw [map_sub]

theorem ne_zero_of_invertible {p : ℕ} (hp : 1 < p) (x y : R p) (h : x * y = 1) : x ≠ 0 := by
  intro hx
  subst hx
  change mul ⟨0, 0⟩ y = ⟨1, 0⟩ at h
  dsimp [mul] at h
  simp only [zero_mul, add_zero, mul_zero] at h
  have h1 : (0 : ZMod p) = 1 := congr_arg R.re h
  have : Fact (1 < p) := ⟨hp⟩
  have h_val := congr_arg ZMod.val h1
  rw [ZMod.val_zero, ZMod.val_one p] at h_val
  contradiction

def units_to_nonzero {p : ℕ} (hp : 1 < p) (u : (R p)  ˣ) : { x : R p // x ≠ 0 } :=
  ⟨u.val, ne_zero_of_invertible hp u.val u.inv u.val_inv⟩

theorem card_units_le {p : ℕ} (hp : 1 < p) : Fintype.card (R p)ˣ ≤ p ^ 2 - 1 := by
  have h_inj : Function.Injective (units_to_nonzero hp) := by
    intro u v h
    ext
    exact Subtype.mk.inj h
  have h_le := Fintype.card_le_of_injective _ h_inj
  have h_card_subtype : Fintype.card { x : R p // x ≠ 0 } = Fintype.card (R p) - 1 := by
    have h_compl := Fintype.card_subtype_compl (fun x : R p ↦ x = 0)
    rw [h_compl, Fintype.card_subtype_eq 0]
  have h_card_R : Fintype.card (R p) = p ^ 2 := by
    change Fintype.card (ZMod p × ZMod p) = p ^ 2
    rw [Fintype.card_prod, ZMod.card p, sq]
  rw [h_card_subtype, h_card_R] at h_le
  exact h_le

theorem eq_of_prime_dvd_P_plus_one (q : ℕ) (hq : Nat.Prime q) (hdvd : q ∣ P + 1) :
    q = 2 ∨ q = 3 ∨ q = 100943 := by
  have h_E0 : P + 1 = 2 * 100943 * 3 ^ 39101 := rfl
  rw [h_E0] at hdvd
  have h_prime_100943 : Nat.Prime 100943 := by decide
  have h_dvd_or : q ∣ 2 * 100943 ∨ q ∣ 3 ^ 39101 := by
    apply hq.dvd_or_dvd hdvd
  rcases h_dvd_or with h_dvd_prod | h_dvd_pow
  · have h_dvd_or_2 := hq.dvd_or_dvd h_dvd_prod
    rcases h_dvd_or_2 with hd2 | hd_100943
    · left
      exact (Nat.Prime.dvd_iff_eq hq Nat.prime_two).mp hd2
    · right; right
      exact (Nat.Prime.dvd_iff_eq hq h_prime_100943).mp hd_100943
  · right; left
    have hd3 : q ∣ 3 := hq.dvd_of_dvd_pow h_dvd_pow
    exact (Nat.Prime.dvd_iff_eq hq Nat.prime_three).mp hd3

theorem P_is_prime : Nat.Prime P := by
  have h_P_gt : 1 < P := by decide
  by_contra h_not_prime
  have h_minfac_sq := Nat.minFac_sq_le_self (by decide) h_not_prime
  let p := Nat.minFac P
