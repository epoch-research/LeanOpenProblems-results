        rw [ZMod.val_zero, ZMod.val_one p] at h_val
        contradiction
      exact h_zero_ne_one h_phi_inv
    · 
      have h_inv : (omega ^ ((P + 1) / 100943) - 1) * ⟨⟨, by decide⟩, ⟨, by decide⟩⟩ = 1 := by
        rw [omega_E3_eq]
        decide
      have h_phi_inv := congr_arg (phi hp_dvd) h_inv
