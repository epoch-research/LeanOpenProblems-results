      rw [h_one_val] at h_phi_inv
      have h_zero : (1 : R p) - 1 = 0 := by ext <;> rfl
      rw [h_zero, zero_mul] at h_phi_inv
      have h_zero_ne_one : (0 : R p) ≠ 1 := by
        intro hc
        have h_re := congr_arg R.re hc
        have : Fact (1 < p) := ⟨hp1⟩
        have h_val := congr_arg ZMod.val h_re
        rw [ZMod.val_zero, ZMod.val_one p] at h_val
        contradiction
      exact h_zero_ne_one h_phi_inv
    · 
      have h_inv : (omega ^ ((P + 1) / 3) - 1) * ⟨⟨, by decide⟩, ⟨, by decide⟩⟩ = 1 := by
        rw [omega_E2_eq]
        decide
      have h_phi_inv := congr_arg (phi hp_dvd) h_inv
      rw [phi_mul, phi_sub, phi_pow, phi_one] at h_phi_inv
      rw [h_one_val] at h_phi_inv
      have h_zero : (1 : R p) - 1 = 0 := by ext <;> rfl
      rw [h_zero, zero_mul] at h_phi_inv
      have h_zero_ne_one : (0 : R p) ≠ 1 := by
