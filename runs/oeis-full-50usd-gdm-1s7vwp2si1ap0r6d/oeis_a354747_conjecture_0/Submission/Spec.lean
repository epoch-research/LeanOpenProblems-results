    by rw [← pow_succ, tsub_add_cancel_of_le (by linarith), h_g_pow_E0],
    by rw [mul_comm, ← pow_succ, tsub_add_cancel_of_le (by linarith), h_g_pow_E0]⟩

  have h_order : orderOf g = P + 1 := by
    apply orderOf_eq_of_pow_and_pow_div_prime (by linarith) (by ext; exact h_g_pow_E0)
    intro q hq hdvd
    have hq_cases := eq_of_prime_dvd_P_plus_one q hq hdvd
    intro h_one
    have h_one_val : g_val ^ ((P + 1) / q) = 1 := congr_arg Units.val h_one
    rcases hq_cases with rfl | rfl | rfl
    · 
      have h_inv : (omega ^ ((P + 1) / 2) - 1) * ⟨⟨, by decide⟩, ⟨0, by decide⟩⟩ = 1 := by
        rw [omega_E1_eq]
