lemma A217317_n0_eq_zero : A217317 4765516 = 0 := by
  dsimp [A217317]
  have h_ne : 4765516 ≠ 0 := by decide
  rw [if_neg h_ne]
  have h_le : Nat.primeCounting (Int.toNat (Int.floor ((4765516 : ℝ)^2 + (Real.logb 2 4765516)^2))) ≤ Nat.primeCounting (22710142746748) := by
    exact Nat.monotone_primeCounting upper_bound_le_n0
  rw [primeCounting_eq_of_no_primes_n0] at h_le
  omega

theorem oeis_A217317_conjecture.disproof : ¬ (∀ n : ℕ, n > 4765516 → A217317 n > 0) := by
  intro h
  have h1 : A217317 4765516 > 0 := h 4765516 (by decide)
  have h2 : A217317 4765516 = 0 := A217317_n0_eq_zero
  omega

