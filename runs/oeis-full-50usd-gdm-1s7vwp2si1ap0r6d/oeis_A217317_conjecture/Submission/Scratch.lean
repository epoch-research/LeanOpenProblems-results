import FormalConjectures.Util.ProblemImports
open Nat Real

/--
A217317: Number of primes between $n^2$ and $n^2 + \log_2(n)^2$ (inclusive).
The sequence is generated by the formula $\pi(\lfloor n^2 + \log_2(n)^2 \rfloor) - \pi(n^2)$,
which counts primes strictly greater than $n^2$ (if $n > 1$).
-/
noncomputable def A217317 (n : ℕ) : ℕ :=
  if n = 0 then 0
  else
    -- Calculate the upper bound $\lfloor n^2 + \log_2(n)^2 \rfloor$
    -- Note: (Real.logb 2 n) is $\log_2(n)$.
    let upper_bound_real : ℝ := (n : ℝ)^2 + (Real.logb 2 n)^2
    let upper_bound_nat : ℕ := Int.toNat (Int.floor upper_bound_real)

    -- The formula $\pi(b) - \pi(a)$ counts primes $p$ such that $a < p \le b$.
    Nat.primeCounting upper_bound_nat - Nat.primeCounting (n^2)

def verify_composites (n : ℕ) : List ℕ → Bool
  | [] => true
  | d :: ds =>
    if 1 < d ∧ d < n ∧ d ∣ n then
      verify_composites (n + 1) ds
    else
      false

theorem all_composite_of_verify_composites (n : ℕ) (ds : List ℕ) (h : verify_composites n ds = true) :
    ∀ x < ds.length, ¬ Nat.Prime (n + x) := by
  induction ds generalizing n with
  | nil =>
    intro x hx
    nomatch hx
  | cons d ds ih =>
    intro x hx
    dsimp [verify_composites] at h
    by_cases h_cond : 1 < d ∧ d < n ∧ d ∣ n
    · rw [if_pos h_cond] at h
      have h_ih := ih (n + 1) h
      rcases h_cond with ⟨h1, h2, h3⟩
      cases x with
      | zero =>
        simp
        exact not_prime_of_dvd_of_lt h3 h1 h2
      | succ y =>
        simp at hx
        have h_lt : y < ds.length := by omega
        have h_ih_y := h_ih y h_lt
        have h_eq : n + (y + 1) = n + 1 + y := by omega
        rwa [h_eq]
    · rw [if_neg h_cond] at h
      contradiction

lemma upper_bound_le_n0 : Int.toNat (Int.floor ((( 4765516 : ℝ)^2 + (Real.logb 2 4765516)^2))) ≤ 4765516 ^ 2 + 492 := by
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hb_pos : 0 < (5 : ℝ) := by positivity
  have h_lt : (4765516 : ℝ)^5 < 2^111 := by norm_num
  have h_log_lt : Real.log ((4765516 : ℝ)^5) < Real.log (2^111) := Real.log_lt_log (by norm_num) h_lt
  rw [Real.log_pow (4765516 : ℝ) 5, Real.log_pow 2 111] at h_log_lt
  have h_log_lt_comm : Real.log 4765516 * (5 : ℝ) < (111 : ℝ) * Real.log 2 := by
    rw [mul_comm (Real.log 4765516) (5 : ℝ)]
    exact h_log_lt
  have h_div : Real.log 4765516 / Real.log 2 < (111 : ℝ) / (5 : ℝ) := by
    have h_div1 : Real.log 4765516 < ((111 : ℝ) * Real.log 2) / (5 : ℝ) := by
      exact (lt_div_iff₀ hb_pos).mpr h_log_lt_comm
    have h_div2 : Real.log 4765516 / Real.log 2 < ((111 : ℝ) * Real.log 2) / (5 : ℝ) / Real.log 2 := by
      exact (div_lt_div_iff_of_pos_right hlog2).mpr h_div1
    have h_eq : ((111 : ℝ) * Real.log 2) / (5 : ℝ) / Real.log 2 = (111 : ℝ) / (5 : ℝ) := by
      field_simp [ne_of_gt hlog2, ne_of_gt hb_pos]
    rwa [h_eq] at h_div2
  have h_nonneg : 0 ≤ Real.logb 2 4765516 := by
    have h_log_pos : 0 < Real.log 4765516 := Real.log_pos (by norm_num)
    have h_div_pos : 0 < Real.log 4765516 / Real.log 2 := div_pos h_log_pos hlog2
    exact h_div_pos.le
  have h_sq_lt : Real.logb 2 4765516 ^ 2 < ((111 : ℝ) / (5 : ℝ)) ^ 2 := by
    rwa [sq_lt_sq₀ h_nonneg (by positivity)]
  have h_sum_lt : (4765516 : ℝ)^2 + Real.logb 2 4765516 ^ 2 < (4765516 : ℝ)^2 + ((111 : ℝ) / (5 : ℝ)) ^ 2 := by
    linarith
  have h_rhs : (4765516 : ℝ)^2 + ((111 : ℝ) / (5 : ℝ)) ^ 2 = ((22710142746748.84 : ℝ)) := by norm_num
  have h_sum_lt_real : (4765516 : ℝ)^2 + Real.logb 2 4765516 ^ 2 < (22710142746748.84 : ℝ) := by
    rw [<-h_rhs]
    exact h_sum_lt
  have h_floor : Int.floor ((4765516 : ℝ)^2 + Real.logb 2 4765516 ^ 2) < 22710142746749 := by
    rw [Int.floor_lt]
    exact lt_trans h_sum_lt_real (by norm_num)
  have h_toNat : Int.toNat (Int.floor ((4765516 : ℝ)^2 + Real.logb 2 4765516 ^ 2)) < 22710142746749 := by
    have h_floor_pos : 0 ≤ Int.floor ((4765516 : ℝ)^2 + Real.logb 2 4765516 ^ 2) := by
      rw [Int.floor_nonneg]
      positivity
    rwa [Int.toNat_lt h_floor_pos]
  omega

