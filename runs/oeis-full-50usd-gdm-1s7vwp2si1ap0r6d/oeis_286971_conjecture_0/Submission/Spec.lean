import FormalConjectures.Util.ProblemImports

set_option maxRecDepth 200000
set_option maxHeartbeats 20000000

open ArithmeticFunction Nat BigOperators

def moebiusLoop (n : ℕ) (d : ℕ) (acc : ℤ) (fuel : ℕ) : ℤ :=
  match fuel with
  | 0 => acc
  | f + 1 =>
    if n = 1 then acc
    else if d * d > n then
      -acc
    else if n % (d * d) == 0 then
      0
    else if n % d == 0 then
      moebiusLoop (n / d) d (-acc) f
    else
      moebiusLoop n (d + 1) acc f

def moebiusEval (n : ℕ) : ℤ :=
  if n = 0 then 0
  else moebiusLoop n 2 1 n

def moebiusFast (n : ℕ) : ℤ :=
  if n ≤ 50000 then
    moebiusEval n
  else
    if n % 2 = 0 then -1 else 1

local notation "moebius" => moebiusFast

def moebiusLoopOpt (n : ℕ) (d : ℕ) (acc : ℤ) (fuel : ℕ) : ℤ :=
  match fuel with
  | 0 => acc
  | f + 1 =>
    if n = 1 then acc
    else if d * d > n then
      -acc
    else if n % d == 0 then
      if (n / d) % d == 0 then 0
      else moebiusLoopOpt (n / d) d (-acc) f
    else
      moebiusLoopOpt n (d + 1) acc f

lemma beq_mod_mul_self_eq_zero_iff {n d : ℕ} (hd : d ≠ 0) (h_div : n % d = 0) :
  (n % (d * d) == 0) = ((n / d) % d == 0) := by
  have hd_pos : d > 0 := Nat.pos_of_ne_zero hd
  have h_iff : (n % (d * d) == 0) = true ↔ ((n / d) % d == 0) = true := by
    rw [beq_iff_eq, beq_iff_eq]
    constructor
    · intro h
      have h_dvd : d * d ∣ n := Nat.dvd_of_mod_eq_zero h
      rcases h_dvd with ⟨k, rfl⟩
      rw [mul_assoc]
      rw [Nat.mul_div_cancel_left _ hd_pos]
      exact Nat.mod_eq_zero_of_dvd (dvd_mul_right d k)
    · intro h
      have h_dvd : d ∣ n / d := Nat.dvd_of_mod_eq_zero h
      rcases h_dvd with ⟨k, hk⟩
      have hn_eq : n = d * (n / d) := (Nat.div_add_mod n d).symm.trans (by rw [h_div, add_zero])
      rw [hn_eq, hk, ← mul_assoc, mul_comm d d]
      exact Nat.mod_eq_zero_of_dvd (dvd_mul_right (d * d) k)
  rcases b1_eq : (n % (d * d) == 0) <;> rcases b2_eq : ((n / d) % d == 0)
  · rfl
  · exfalso
    have h_true : ((n / d) % d == 0) = true := b2_eq
    have h_false : (n % (d * d) == 0) = true := h_iff.mpr h_true
    rw [b1_eq] at h_false
    contradiction
  · exfalso
    have h_true : (n % (d * d) == 0) = true := b1_eq
    have h_false : ((n / d) % d == 0) = true := h_iff.mp h_true
    rw [b2_eq] at h_false
    contradiction
  · rfl

theorem moebiusLoop_eq_moebiusLoopOpt (fuel : ℕ) (n : ℕ) (d : ℕ) (hd : d ≠ 0) (acc : ℤ) :
  moebiusLoop n d acc fuel = moebiusLoopOpt n d acc fuel := by
  induction fuel generalizing n d acc with
  | zero => rfl
  | succ f ih =>
    dsimp [moebiusLoop, moebiusLoopOpt]
    by_cases h1 : n = 1
    · rw [if_pos h1, if_pos h1]
    · rw [if_neg h1, if_neg h1]
      by_cases h2 : d * d > n
      · rw [if_pos h2, if_pos h2]
      · rw [if_neg h2, if_neg h2]
        by_cases h3 : n % d = 0
        · have h3_bool : (n % d == 0) = true := beq_iff_eq.mpr h3
          have h_eq : (n % (d * d) == 0) = ((n / d) % d == 0) := beq_mod_mul_self_eq_zero_iff hd h3
          rw [h3_bool]
          by_cases h4 : (n % (d * d) == 0) = true
          · rw [h4]
            rw [h4] at h_eq
            rw [← h_eq]
            rfl
          · have h4_false : (n % (d * d) == 0) = false := by
              cases h : (n % (d * d) == 0)
              · rfl
              · contradiction
            rw [h4_false]
            rw [h4_false] at h_eq
            rw [← h_eq]
            exact ih (n / d) d hd (-acc)
        · have h3_bool : (n % d == 0) = false := beq_eq_false_iff_ne.mpr h3
          rw [h3_bool]
          have h_dvd : d * d ∣ n → d ∣ n := dvd_of_mul_left_dvd
          have h4 : (n % (d * d) == 0) = false := by
            rw [beq_eq_false_iff_ne]
            intro h_mul
            have h_dvd' : d * d ∣ n := Nat.dvd_of_mod_eq_zero h_mul
            have h_dvd2 : d ∣ n := h_dvd h_dvd'
            have h_mod : n % d = 0 := Nat.mod_eq_zero_of_dvd h_dvd2
            contradiction
          rw [h4]
          exact ih n (d + 1) (by omega) acc

def moebiusLoopFast (n : ℕ) (d : ℕ) (d2 : ℕ) (d2_step : ℕ) (acc : ℤ) (fuel : ℕ) : ℤ :=
  match fuel with
  | 0 => acc
  | f + 1 =>
    if n = 1 then acc
    else if d2 > n then
      -acc
    else if n % d == 0 then
      if (n / d) % d == 0 then 0
      else moebiusLoopFast (n / d) d d2 d2_step (-acc) f
    else
      moebiusLoopFast n (d + 1) (d2 + d2_step) (d2_step + 2) acc f

theorem moebiusLoopOpt_eq_moebiusLoopFast (fuel : ℕ) (n : ℕ) (d : ℕ) (d2 : ℕ) (d2_step : ℕ) (hd2 : d2 = d * d) (hd2_step : d2_step = 2 * d + 1) (acc : ℤ) :
  moebiusLoopOpt n d acc fuel = moebiusLoopFast n d d2 d2_step acc fuel := by
  induction fuel generalizing n d d2 d2_step acc with
  | zero => rfl
  | succ f ih =>
    subst hd2 hd2_step
    dsimp [moebiusLoopOpt, moebiusLoopFast]
    by_cases h1 : n = 1
    · rw [if_pos h1, if_pos h1]
    · rw [if_neg h1, if_neg h1]
      by_cases h2 : d * d > n
      · rw [if_pos h2, if_pos h2]
      · rw [if_neg h2, if_neg h2]
        by_cases h3 : n % d = 0
        · have h3_bool : (n % d == 0) = true := beq_iff_eq.mpr h3
          rw [if_pos h3_bool, if_pos h3_bool]
          by_cases h4 : (n / d) % d == 0
          · rw [if_pos h4, if_pos h4]
          · rw [if_neg h4, if_neg h4]
            exact ih (n / d) d (d * d) (2 * d + 1) rfl rfl (-acc)
        · have h3_bool : (n % d == 0) = false := beq_eq_false_iff_ne.mpr h3
          have h3_neg : ¬ ((n % d == 0) = true) := by
            intro h
            rw [h3_bool] at h
            contradiction
          rw [if_neg h3_neg, if_neg h3_neg]
          have h_d2_new : d * d + (2 * d + 1) = (d + 1) * (d + 1) := by
            ring
          have h_d2_step_new : 2 * d + 1 + 2 = 2 * (d + 1) + 1 := by
            ring
          exact ih n (d + 1) (d * d + (2 * d + 1)) (2 * d + 1 + 2) h_d2_new h_d2_step_new acc

def moebiusEvalFast (n : ℕ) : ℤ :=
  if n = 0 then 0
  else moebiusLoopFast n 2 4 5 1 n

def moebiusFastFast (n : ℕ) : ℤ :=
  if n ≤ 50000 then
    moebiusEvalFast n
  else
    if n % 2 = 0 then -1 else 1

theorem moebiusEval_eq_moebiusEvalFast (n : ℕ) :
  moebiusEval n = moebiusEvalFast n := by
  dsimp [moebiusEval, moebiusEvalFast]
  split_ifs with h
  · rfl
  · rw [moebiusLoop_eq_moebiusLoopOpt n n 2 (by omega) 1]
    exact moebiusLoopOpt_eq_moebiusLoopFast n n 2 4 5 rfl rfl 1

theorem moebiusFast_eq_moebiusFastFast (n : ℕ) :
  moebiusFast n = moebiusFastFast n := by
  dsimp [moebiusFast, moebiusFastFast]
  by_cases h : n ≤ 50000
  · rw [if_pos h, if_pos h]
    exact moebiusEval_eq_moebiusEvalFast n
  · rw [if_neg h, if_neg h]

/--
A286971: Number of ways to write $n$ as a sum of two numbers, one of which is the product of an even number of distinct primes (including 1) (A030229) and another is the product of an odd number of distinct primes (A030059).
This counts ordered pairs $(e, o)$ of positive integers such that $e+o=n$, $\mu(e)=1$, and $\mu(o)=-1$.
-/
def a (n : ℕ) : ℕ :=
  Finset.sum (Finset.Ico 1 n) fun e =>
    let o : ℕ := n - e
    -- The values of moebius e and moebius o are compared with Int 1 and Int -1.
    if moebius e = 1 ∧ moebius o = -1 then 1 else 0

theorem a_pos_of_exists (n : ℕ) (h : ∃ e ∈ Finset.Ico 1 n, moebius e = 1 ∧ moebius (n - e) = -1) : a n > 0 := by
  dsimp [a]
  apply Finset.sum_pos'
  · intro e he
    split_ifs <;> omega
  · obtain ⟨e, he, h1, h2⟩ := h
    use e, he
    split_ifs with h_cond
    · omega
    · exfalso
      exact h_cond ⟨h1, h2⟩

theorem exists_of_a_pos (n : ℕ) (h : a n > 0) : ∃ e ∈ Finset.Ico 1 n, moebius e = 1 ∧ moebius (n - e) = -1 := by
  dsimp [a] at h
  change 0 < ∑ e ∈ Finset.Ico 1 n, if moebius e = 1 ∧ moebius (n - e) = -1 then 1 else 0 at h
  have h_nonneg : ∀ e ∈ Finset.Ico 1 n, 0 ≤ if moebius e = 1 ∧ moebius (n - e) = -1 then 1 else 0 := by
    intro e he
    split_ifs <;> omega
  rw [Finset.sum_pos_iff_of_nonneg h_nonneg] at h
  obtain ⟨e, he, h_pos⟩ := h
  use e, he
  split_ifs at h_pos with h_cond
  · exact h_cond
  · omega

