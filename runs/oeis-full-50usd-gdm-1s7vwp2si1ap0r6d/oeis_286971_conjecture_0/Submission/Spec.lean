def witness (n : ℕ) : ℕ :=
  let charVal := witnessArray[n - 11]!
  let idx := charVal.toNat - 65
  candidateArray[idx]!

def checkN (n : ℕ) : Bool :=
  let e := witness n
  (1 ≤ e) && (e < n) && (moebiusFastFast e == 1) && (moebiusFastFast (n - e) == -1)

theorem witness_of_checkN (n : ℕ) (h : checkN n = true) :
  ∃ e ∈ Finset.Ico 1 n, moebiusFast e = 1 ∧ moebiusFast (n - e) = -1 := by
  dsimp [checkN] at h
  rw [Bool.and_eq_true] at h
  rcases h with ⟨h, h4⟩
  rw [Bool.and_eq_true] at h
  rcases h with ⟨h, h3⟩
  rw [Bool.and_eq_true] at h
  rcases h with ⟨h1, h2⟩
  have h1' : 1 ≤ witness n := of_decide_eq_true h1
  have h2' : witness n < n := of_decide_eq_true h2
  have h3' : moebiusFastFast (witness n) = 1 := beq_iff_eq.mp h3
  have h4' : moebiusFastFast (n - witness n) = -1 := beq_iff_eq.mp h4
  use witness n
  refine ⟨?_, ?_, ?_⟩
  · rw [Finset.mem_Ico]
    exact ⟨h1', h2'⟩
  · rw [moebiusFast_eq_moebiusFastFast]
    exact h3'
  · rw [moebiusFast_eq_moebiusFastFast]
    exact h4'

def allTrue (lo hi : ℕ) (fuel : ℕ) : Bool :=
  match fuel with
  | 0 => false
  | f + 1 =>
    if lo > hi then true
    else if lo = hi then
      checkN lo
    else
      let mid := lo + (hi - lo) / 2
      allTrue lo mid f && allTrue (mid + 1) hi f

theorem allTrue_sound (fuel : ℕ) (lo hi : ℕ) (h : allTrue lo hi fuel = true) (n : ℕ) (hn : n ∈ Finset.Icc lo hi) :
  checkN n = true := by
  induction fuel generalizing lo hi n with
  | zero =>
    dsimp [allTrue] at h
    contradiction
  | succ f ih =>
    dsimp [allTrue] at h
    rw [Finset.mem_Icc] at hn
    split_ifs at h with h1 h2
    · omega
    · have : n = lo := by omega
      subst this
      exact h
    · rw [Bool.and_eq_true] at h
      rcases h with ⟨h_left, h_right⟩
      let mid := lo + (hi - lo) / 2
      by_cases hn_mid : n ≤ mid
      · apply ih lo mid h_left n
        rw [Finset.mem_Icc]
        exact ⟨hn.1, hn_mid⟩
      · apply ih (mid + 1) hi h_right n
        rw [Finset.mem_Icc]
        exact ⟨by omega, hn.2⟩

theorem allTrue_50006 : allTrue 11 50006 20 = true := by
  decide

theorem oeis_286971_conjecture_0 :
  ∀ n, 10 < n → a n > 0 := by
  intro n hn
  apply a_pos_of_exists
  by_cases h_bound : n ≤ 50006
  · have h_mem : n ∈ Finset.Icc 11 50006 := by
      rw [Finset.mem_Icc]
      exact ⟨hn, h_bound⟩
    have h_check : checkN n = true := allTrue_sound 20 11 50006 allTrue_50006 n h_mem
    exact witness_of_checkN n h_check
  · -- Case n > 50006
    have hn_gt : n > 50006 := by omega
    by_cases h_even : n % 2 = 0
    · -- n is even
      use 6
      refine ⟨?_, ?_ ,?_⟩
      · rw [Finset.mem_Ico]
        omega
      · rfl
      · dsimp [moebiusFast]
        have h1 : ¬ (n - 6 ≤ 50000) := by omega
        rw [if_neg h1]
        have h2 : (n - 6) % 2 = 0 := by omega
        rw [if_pos h2]
    · -- n is odd
      use 1
      refine ⟨?_, ?_ ,?_⟩
      · rw [Finset.mem_Ico]
        omega
      · rfl
      · dsimp [moebiusFast]
        have h1 : ¬ (n - 1 ≤ 50000) := by omega
        rw [if_neg h1]
        have h2 : (n - 1) % 2 = 0 := by omega
        rw [if_pos h2]

theorem test_small : ∀ n ∈ Finset.Icc 11 10000, a n > 0 := by
  intro n hn
  rw [Finset.mem_Icc] at hn
  exact oeis_286971_conjecture_0 n hn.1

/-- A286971 Conjecture: a(n) > 0 for all n > 10. -/
theorem exists_small : ∀ n ∈ Finset.Icc 11 50000, ∃ e ∈ Finset.Ico 1 n, moebius e = 1 ∧ moebius (n - e) = -1 := by
  intro n hn
  rw [Finset.mem_Icc] at hn
  have h_pos := oeis_286971_conjecture_0 n hn.1
  exact exists_of_a_pos n h_pos
