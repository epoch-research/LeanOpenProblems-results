import Mathlib

set_option maxRecDepth 200000

def mod_pow_fuel (base : ℕ) (exp : ℕ) (modulus : ℕ) : ℕ :=
  let rec loop (fuel : ℕ) (acc : ℕ) (b : ℕ) (e : ℕ) : ℕ :=
    match fuel with
    | 0 => acc
    | fuel' + 1 =>
      if e = 0 then acc
      else
        let acc' := if e % 2 = 1 then (acc * b) % modulus else acc
        let b' := (b * b) % modulus
        let e' := e / 2
        loop fuel' acc' b' e'
  loop 1050 1 (base % modulus) exp

