import Mathlib.Data.ZMod.Basic

set_option exponentiation.threshold 100000
set_option maxRecDepth 200000

open Nat

def val : ℕ := 2 ^ 32768 + 32767

def tail_pow (base : ZMod val) (exp : ℕ) : ZMod val :=
  let rec loop (acc : ZMod val) (b : ZMod val) (e : ℕ) : ZMod val :=
    if e = 0 then acc
    else
      let acc' := if e % 2 = 1 then acc * b else acc
      let b' := b * b
      let e' := e / 2
      loop acc' b' e'
  loop 1 base exp

theorem test_decide : tail_pow 3 (2 ^ 32768 + 32766) =  := by
  decide

