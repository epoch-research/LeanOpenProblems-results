theorem oeis_53067_conjecture_0 : ∀ n : ℕ, Nat.Prime (a n) ↔ n = 2 := by
  intro n
  constructor
  · intro hp
    by_contra hn
    have h_cases : n = 0 ∨ n = 1 ∨ n = 2 ∨ (3 ≤ n ∧ n ≤ 100) ∨ 100 < n := by omega
