theorem a_zero : a 0 = 0 := by rfl
theorem a_one : a 1 = 1 := by rfl
theorem a_two : a 2 = 23 := by rfl

theorem not_prime_of_mul {n a b : ℕ} (h : n = a * b) (ha : 1 < a) (hb : 1 < b) : ¬ Nat.Prime n := by
  intro hp
  have hd : a ∣ n := by rw [h]; exact dvd_mul_right a b
  have h_eq := (Nat.Prime.eq_one_or_self_of_dvd hp a hd).resolve_left (Nat.ne_of_gt ha)
  subst h_eq
  have hn : a > 0 := Nat.Prime.pos hp
  have h1 : a * 1 = a * b := by
    rw [mul_one]
    exact h
  have hb1 : 1 = b := Nat.mul_left_cancel hn h1
  omega

/--
Conjecture (OEIS A053067): $a(n)$ is prime if and only if $n = 2$.
-/
