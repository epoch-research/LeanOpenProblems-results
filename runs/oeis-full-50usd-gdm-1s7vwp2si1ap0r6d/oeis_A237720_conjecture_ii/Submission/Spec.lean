lemma case_covered (n : ℕ) (q : ℕ) (hq : q.Prime) (h1 : q * q ≤ n + 2 * q) (h2 : n + 2 ≤ q * q) (hq7 : q ≥ 7) :
    ∃ p, p.Prime ∧ p < n ∧ (Nat.sqrt (n+p)).Prime := by
  let qq := q * q
  have h_qq_def : qq = q * q := rfl
  have h_x_pos : qq - n ≥ 2 := by omega
  obtain ⟨p, hp_prime, h_xp, hp_2x⟩ := Nat.exists_prime_lt_and_le_two_mul (qq - n) (by omega)
  use p
  refine ⟨hp_prime, ?_, ?_⟩
  · have hq_nlin : 2 * qq + 6 * q < 3 * qq := by
      change 2 * (q * q) + 6 * q < 3 * (q * q)
      nlinarith
    have h_3n : 2 * qq < 3 * n := by omega
    omega
  · have hq_ring : (q+1) * (q+1) = qq + 2 * q + 1 := by
      change (q+1) * (q+1) = q * q + 2 * q + 1
      ring
    have h_sqrt : q = Nat.sqrt (n+p) := by
      apply Nat.eq_sqrt.mpr
      constructor
      · omega
      · omega
    rw [← h_sqrt]
    exact hq

lemma case_covered_2 (n : ℕ) (q : ℕ) (hq : q.Prime) (h1 : q * q ≤ n + 1) (h2 : n + 4 ≤ q * q + 2 * q) (hq7 : q ≥ 7) :
    ∃ p, p.Prime ∧ p < n ∧ (Nat.sqrt (n+p)).Prime := by
  let qq := q * q
  have h_qq_def : qq = q * q := rfl
  obtain ⟨p, hp_prime, h_xp, hp_2x⟩ := Nat.exists_prime_lt_and_le_two_mul 2 (by decide)
  use p
  refine ⟨hp_prime, ?_, ?_⟩
  · have : qq ≥ 49 := by
      change q * q ≥ 49
      nlinarith
    omega
  · have hq_ring : (q+1) * (q+1) = qq + 2 * q + 1 := by
      change (q+1) * (q+1) = q * q + 2 * q + 1
      ring
    have h_sqrt : q = Nat.sqrt (n+p) := by
      apply Nat.eq_sqrt.mpr
      constructor
      · have : qq ≥ 49 := by
          change q * q ≥ 49
          nlinarith
        omega
      · omega
    rw [← h_sqrt]
    exact hq


