import FormalConjectures.Util.ProblemImports

set_option maxRecDepth 100000000
set_option maxHeartbeats 100000000

open Nat Finset

def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

def sqrt_iter (n guess fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => guess
  | f + 1 =>
    let next := (guess + n / guess) / 2
    if next >= guess then
      guess
    else
      sqrt_iter n next f

def my_sqrt (n : ℕ) : ℕ :=
  if n <= 1 then
    n
  else
    sqrt_iter n (n / 2) 100

def min_fac_loop (n : Nat) (d : Nat) (fuel : Nat) : Nat :=
  match fuel with
  | 0 => n
  | f + 1 =>
    if d * d > n then
      n
    else if n % d == 0 then
      d
    else
      min_fac_loop n (d + 1) f

def my_min_fac (n : Nat) : Nat :=
  if n <= 1 then n
  else min_fac_loop n 2 n

def prime_factors_loop (n : Nat) (fuel : Nat) : List Nat :=
  match fuel with
  | 0 => []
  | f + 1 =>
    if n <= 1 then []
    else
      let m := my_min_fac n
      m :: prime_factors_loop (n / m) f

def group_factors (L : List Nat) : List (Nat × Nat) :=
  match L with
  | [] => []
  | p :: ps =>
    match group_factors ps with
    | [] => [(p, 1)]
    | (q, k) :: qs =>
      if p == q then
        (q, k + 1) :: qs
      else
        (p, 1) :: (q, k) :: qs

def totient_from_grouped (L : List (Nat × Nat)) : Nat :=
  match L with
  | [] => 1
  | (p, k) :: ps => p^(k - 1) * (p - 1) * totient_from_grouped ps

def totient_via_factors (n : Nat) : Nat :=
  if n == 0 then 0
  else if n == 1 then 1
  else totient_from_grouped (group_factors (prime_factors_loop n n))

@[implemented_by totient_via_factors]
def my_totient (n : Nat) : Nat := totient n

theorem my_totient_eq (n : Nat) : my_totient n = totient n := rfl

def decode_char (c : Char) : Nat :=
  let val := c.toNat
  if val < 90 then
    val - 35
  else
    val - 38

