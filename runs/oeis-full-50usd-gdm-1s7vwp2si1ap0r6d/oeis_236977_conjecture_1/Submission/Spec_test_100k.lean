def verify_witness (n : Nat) : Bool :=
  let k := get_witness n
  let limit := (n - 1) / 2
  if (1 <= k) && (k <= limit) then
    let m := my_totient k * my_totient (n - k)
    my_sqrt m ^ 2 == m
  else
    false

def verify_range (low high : Nat) : Nat → Bool
  | 0 => false
  | f + 1 =>
    if low > high then
      true
    else if low == high then
      verify_witness low
    else
      let mid := (low + high) / 2
      verify_range low mid f && verify_range (mid + 1) high f

theorem verify_all : verify_range 9 100000 18 = true := by decide
