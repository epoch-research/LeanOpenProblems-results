lemma get?_eq_some_getD {α : Type} [Inhabited α] (l : List α) (i : ℕ) (h_len : i < l.length) :
    l[i]? = some (l.getD i default) := by
  have h_opt : l[i]?.isSome := by
    rw [List.isSome_getElem?_iff]
    exact h_len
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp h_opt
  rw [hv]
  have h_getD : l.getD i default = v := by
    rw [List.getD_eq_getElem?_getD, hv, Option.getD_some]
  rw [h_getD]

def check_exponents (limit : ℕ) : Bool :=
  match limit with
  | 0 => true
  | l' + 1 => decide (get_exponent (l' + 1) == Nat.totient (1408 - (l' + 1)) / 2) && check_exponents l'

lemma exponents_eq_of_check_exponents {limit : ℕ} (h : check_exponents limit = true) (k : ℕ) (hk1 : 1 ≤ k) (hk2 : k ≤ limit) :
    get_exponent k = Nat.totient (1408 - k) / 2 := by
  induction limit with
  | zero => omega
  | succ l ih =>
    unfold check_exponents at h
    rw [Bool.and_eq_true] at h
    have h_curr := h.1
    have h_prev := h.2
    rcases Nat.eq_or_lt_of_le hk2 with rfl | h_lt
    · exact Nat.eq_of_beq_eq_true (of_decide_eq_true h_curr)
    · have : k ≤ l := by omega
      exact ih h_prev (by omega) this

