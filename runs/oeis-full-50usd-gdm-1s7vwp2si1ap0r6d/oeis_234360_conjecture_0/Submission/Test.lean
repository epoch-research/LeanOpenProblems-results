inductive DivResult where
  | le_one : DivResult
  | divisor (d : ℕ) : DivResult
  | Fermat : DivResult

def get_divisor (k : ℕ) : DivResult :=
  match divisors_list[k - 1]? with
  | some 0 => .le_one
  | some 1 => .Fermat
  | some d => .divisor d
  | none => .le_one

def get_exponent (k : ℕ) : ℕ :=
  match exponents_list[k - 1]? with
  | some e => e
  | none => 0

def powMod (b e m : ℕ) : ℕ :=
  if h : e = 0 then 1
  else if e % 2 = 1 then
    have : e / 2 < e := Nat.div_lt_self (Nat.pos_of_ne_zero h) (by decide)
    (powMod b (e / 2) m) ^ 2 * b % m
  else
    have : e / 2 < e := Nat.div_lt_self (Nat.pos_of_ne_zero h) (by decide)
    (powMod b (e / 2) m) ^ 2 % m

theorem powMod_eq (b e m : ℕ) (hm : 1 < m) : powMod b e m = b ^ e % m := by
  induction e using powMod.induct with
  | case1 =>
    unfold powMod
    simp only [↓reduceDIte]
    rw [pow_zero, Nat.mod_eq_of_lt hm]
  | case2 x hx h_odd h_lt ih =>
    unfold powMod
    simp only [hx, h_odd, ↓reduceDIte]
    rw [if_pos True.intro]
    have h_arith : (x / 2) * 2 + 1 = x := by omega
    have h_pow : (b ^ (x / 2)) ^ 2 * b = b ^ x := by
      rw [show b ^ x = b ^ ((x / 2) * 2 + 1) by rw [h_arith]]
      rw [Nat.pow_add, Nat.pow_mul, Nat.pow_one]
    rw [ih, Nat.mul_mod, ← Nat.pow_mod, ← Nat.mul_mod, h_pow]
  | case3 x hx h_even h_lt ih =>
    unfold powMod
    simp only [hx, h_even, ↓reduceDIte]
    rw [if_neg not_false]
    have h_arith : (x / 2) * 2 = x := by omega
    have h_pow : (b ^ (x / 2)) ^ 2 = b ^ x := by
      rw [show b ^ x = b ^ ((x / 2) * 2) by rw [h_arith]]
      rw [Nat.pow_mul]
    rw [ih, ← Nat.pow_mod, h_pow]

lemma coprime_two_of_prime_ne_two {p : ℕ} (hp : p.Prime) (h2 : p ≠ 2) : Coprime 2 p := by
  have h_dvd : ¬ p ∣ 2 := by
    intro hd
    have : p ≤ 2 := Nat.le_of_dvd (by decide) hd
    have : 2 ≤ p := hp.two_le
    have : p = 2 := by omega
    exact h2 this
  have h_cop : Coprime p 2 := hp.coprime_iff_not_dvd.mpr h_dvd
  exact h_cop.symm

lemma not_prime_of_fermat_test_failed {p : ℕ} (hp2 : p ≠ 2) (h_pow : powMod 2 (p - 1) p % p ≠ 1) : ¬ p.Prime := by
  intro hp
  have hp1 : 1 < p := hp.one_lt
  have h_cop : Coprime 2 p := coprime_two_of_prime_ne_two hp hp2
  have h_fermat := Nat.ModEq.pow_card_sub_one_eq_one hp h_cop
  unfold Nat.ModEq at h_fermat
  rw [Nat.mod_eq_of_lt hp1] at h_fermat
  have h_powMod := powMod_eq 2 (p - 1) p hp1
  rw [h_fermat] at h_powMod
  have h_mod2 : powMod 2 (p - 1) p % p = 1 % p := by rw [h_powMod]
  rw [Nat.mod_eq_of_lt hp1] at h_mod2
  exact h_pow h_mod2

lemma not_prime_of_dvd {p m : ℕ} (hm : 2 ≤ m) (hmp : m < p) (hdvd : m ∣ p) : ¬ Nat.Prime p := by
  intro hp
  rw [prime_def_lt'] at hp
  exact hp.2 m hm hmp hdvd

def isComposite (n k : ℕ) : Bool :=
  let v := (k + 1) ^ (get_exponent k) - k
  match get_divisor k with
  | .le_one => decide (v <= 1)
  | .divisor d => decide (v % d == 0) && decide (1 < d) && decide (d < v)
  | .Fermat => decide (powMod 2 (v - 1) v % v != 1) && decide (v != 2)

theorem isComposite_correct (n k : ℕ) (h_comp : isComposite n k = true) : ¬ Nat.Prime ((k + 1) ^ (get_exponent k) - k) := by
  set v := (k + 1) ^ (get_exponent k) - k
  unfold isComposite at h_comp
  split at h_comp
  · -- le_one
    intro hp
    have hp1 : 1 < v := hp.one_lt
    have : v ≤ 1 := of_decide_eq_true h_comp
    omega
  · -- divisor
    intro hp
    rw [Bool.and_eq_true] at h_comp
    have h_and2 := h_comp.1
    rw [Bool.and_eq_true] at h_and2
    have hd_dvd : v % _ = 0 := of_decide_eq_true h_and2.1
    have hd_gt1 : 1 < _ := of_decide_eq_true h_and2.2
    have hd_ltv : _ < v := of_decide_eq_true h_comp.2
    have hd_dvd_v : _ ∣ v := Nat.dvd_of_mod_eq_zero hd_dvd
    have hd_ge2 : 2 ≤ _ := hd_gt1
    exact not_prime_of_dvd hd_ge2 hd_ltv hd_dvd_v hp
  · -- Fermat
    intro hp
    rw [Bool.and_eq_true] at h_comp
    have hp2 : v ≠ 2 := of_decide_eq_true h_comp.2
    have h_pow : powMod 2 (v - 1) v % v ≠ 1 := of_decide_eq_true h_comp.1
    exact not_prime_of_fermat_test_failed hp2 h_pow hp

def check_range (start len : ℕ) : Bool :=
  match len with
  | 0 => true
  | l' + 1 => isComposite 1408 (start + l') && check_range start l'

lemma isComposite_of_check_range {k start len : ℕ} (h_all : check_range start len = true) (hk1 : start ≤ k) (hk2 : k < start + len) : isComposite 1408 k = true := by
  induction len with
  | zero => omega
  | succ l ih =>
    unfold check_range at h_all
    rw [Bool.and_eq_true] at h_all
    have h_curr := h_all.1
    have h_prev := h_all.2
    rcases Nat.eq_or_lt_of_le (by omega : k ≤ start + l) with rfl | h_lt
    · exact h_curr
    · exact ih h_prev (by omega)

