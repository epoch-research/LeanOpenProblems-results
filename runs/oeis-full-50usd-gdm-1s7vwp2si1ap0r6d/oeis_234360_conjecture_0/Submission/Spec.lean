inductive DivResult where
  | le_one : DivResult
  | divisor (d : ℕ) : DivResult
  | Fermat : DivResult

def get_divisor (k : ℕ) : DivResult :=
  let d := get_divisor_val k
  if d = 0 then .le_one
  else if d = 1 then .Fermat
  else .divisor d

def powMod_step (r b m : ℕ) (is_odd : Bool) : ℕ :=
  if is_odd then
    r * r * b % m
  else
    r * r % m

def powMod_aux (fuel : ℕ) (b e m : ℕ) : ℕ :=
  match fuel with
  | 0 => 1
  | fuel' + 1 =>
    if e = 0 then 1
    else
      powMod_step (powMod_aux fuel' b (e / 2) m) b m (decide (e % 2 = 1))

def powMod (b e m : ℕ) : ℕ := powMod_aux 10000 b e m

lemma powMod_aux_eq (fuel : ℕ) (b e m : ℕ) (h_fuel : e < 2 ^ fuel) (hm : 1 < m) :
  powMod_aux fuel b e m = b ^ e % m := by
  induction fuel generalizing e with
  | zero =>
    simp only [pow_zero] at h_fuel
    have : e = 0 := by omega
    subst this
    simp [powMod_aux]
    rw [Nat.mod_eq_of_lt hm]
  | succ fuel' ih =>
    by_cases he : e = 0
    · subst he
      simp [powMod_aux]
      rw [Nat.mod_eq_of_lt hm]
    · have h_div : e / 2 < e := Nat.div_lt_self (Nat.pos_of_ne_zero he) (by decide)
      have h_pow_succ : 2 ^ (fuel' + 1) = 2 ^ fuel' * 2 := by rw [pow_succ]
      rw [h_pow_succ] at h_fuel
      have h_fuel' : e / 2 < 2 ^ fuel' := by omega
      by_cases h_odd : e % 2 = 1
      · have h_dec : decide (e % 2 = 1) = true := decide_eq_true h_odd
        unfold powMod_aux
        simp only [he, ↓reduceIte]
        unfold powMod_step
        simp only [h_dec, ↓reduceIte]
        rw [ih (e / 2) h_fuel']
        have h_arith : (e / 2) * 2 + 1 = e := by omega
        have h_pow : (b ^ (e / 2)) ^ 2 * b = b ^ e := by
          rw [show b ^ e = b ^ ((e / 2) * 2 + 1) by rw [h_arith]]
          rw [Nat.pow_add, Nat.pow_mul, Nat.pow_one]
        rw [Nat.mul_mod]
        rw [show (b ^ (e / 2) % m * (b ^ (e / 2) % m)) % m = (b ^ (e / 2) % m) ^ 2 % m by
          rw [Nat.pow_two]
        ]
        rw [← Nat.pow_mod (b ^ (e / 2)) 2 m]
        rw [← Nat.mul_mod]
        rw [h_pow]
      · have h_even : e % 2 = 0 := by
          have := Nat.mod_two_eq_zero_or_one e
          omega
        have h_dec : decide (e % 2 = 1) = false := decide_eq_false h_odd
        unfold powMod_aux
        simp only [he, ↓reduceIte]
        unfold powMod_step
        simp only [h_dec]
        rw [if_neg (by decide)]
        rw [ih (e / 2) h_fuel']
        have h_arith : (e / 2) * 2 = e := by omega
        have h_pow : (b ^ (e / 2)) ^ 2 = b ^ e := by
          rw [show b ^ e = b ^ ((e / 2) * 2) by rw [h_arith]]
          rw [Nat.pow_mul]
        rw [show b ^ (e / 2) % m * (b ^ (e / 2) % m) % m = (b ^ (e / 2) % m) ^ 2 % m by
          rw [Nat.pow_two]
        ]
        rw [← Nat.pow_mod (b ^ (e / 2)) 2 m]
        rw [h_pow]

theorem powMod_eq (b e m : ℕ) (h_fuel : e < 2 ^ 10000) (hm : 1 < m) : powMod b e m = b ^ e % m := by
  unfold powMod
  exact powMod_aux_eq 10000 b e m h_fuel hm

lemma coprime_two_of_prime_ne_two {p : ℕ} (hp : p.Prime) (h2 : p ≠ 2) : Coprime 2 p := by
  have h_dvd : ¬ p ∣ 2 := by
    intro hd
    have : p ≤ 2 := Nat.le_of_dvd (by decide) hd
    have : 2 ≤ p := hp.two_le
    have : p = 2 := by omega
    exact h2 this
  have h_cop : Coprime p 2 := hp.coprime_iff_not_dvd.mpr h_dvd
  exact h_cop.symm

lemma not_prime_of_fermat_test_failed {p : ℕ} (hp2 : p ≠ 2) (h_fuel : p - 1 < 2 ^ 10000) (h_pow : powMod 2 (p - 1) p % p ≠ 1) : ¬ p.Prime := by
  intro hp
  have hp1 : 1 < p := hp.one_lt
  have h_cop : Coprime 2 p := coprime_two_of_prime_ne_two hp hp2
  have h_fermat := Nat.ModEq.pow_card_sub_one_eq_one hp h_cop
  unfold Nat.ModEq at h_fermat
  rw [Nat.mod_eq_of_lt hp1] at h_fermat
  have h_powMod := powMod_eq 2 (p - 1) p h_fuel hp1
  rw [h_fermat] at h_powMod
  have h_mod2 : powMod 2 (p - 1) p % p = 1 % p := by rw [h_powMod]
  rw [Nat.mod_eq_of_lt hp1] at h_mod2
  exact h_pow h_mod2

lemma not_prime_of_dvd {p : ℕ} (m : ℕ) (hm : 2 ≤ m) (hmp : m < p) (hdvd : m ∣ p) : ¬ Nat.Prime p := by
  intro hp
  rw [prime_def_lt'] at hp
  exact hp.2 m hm hmp hdvd

def isComposite (k : ℕ) : Bool :=
  let v := (k + 1) ^ (get_exponent k) - k
  match get_divisor k with
  | .le_one => decide (v <= 1)
  | .divisor d => decide (v % d = 0) && decide (1 < d) && decide (d < v)
  | .Fermat => decide (powMod 2 (v - 1) v % v ≠ 1) && decide (v ≠ 2) && decide (v - 1 < 2 ^ 10000)

theorem isComposite_correct (k : ℕ) (h_comp : isComposite k = true) : ¬ Nat.Prime ((k + 1) ^ (get_exponent k) - k) := by
  unfold isComposite at h_comp
  split at h_comp
  · intro hp
    have hp1 : 1 < ((k + 1) ^ (get_exponent k) - k) := hp.one_lt
    have : ((k + 1) ^ (get_exponent k) - k) ≤ 1 := of_decide_eq_true h_comp
    omega
  · intro hp
    rw [Bool.and_eq_true] at h_comp
    have h_and2 := h_comp.1
    rw [Bool.and_eq_true] at h_and2
    have hd_dvd : ((k + 1) ^ (get_exponent k) - k) % _ = 0 := of_decide_eq_true h_and2.1
    have hd_gt1 : 1 < _ := of_decide_eq_true h_and2.2
    have hd_ltv : _ < ((k + 1) ^ (get_exponent k) - k) := of_decide_eq_true h_comp.2
    have hd_dvd_v : _ ∣ ((k + 1) ^ (get_exponent k) - k) := Nat.dvd_of_mod_eq_zero hd_dvd
    have hd_ge2 : 2 ≤ _ := hd_gt1
    exact not_prime_of_dvd _ hd_ge2 hd_ltv hd_dvd_v hp
  · intro hp
    rw [Bool.and_eq_true] at h_comp
    have h_and2 := h_comp.1
    rw [Bool.and_eq_true] at h_and2
    have h_pow : powMod 2 (((k + 1) ^ (get_exponent k) - k) - 1) ((k + 1) ^ (get_exponent k) - k) % ((k + 1) ^ (get_exponent k) - k) ≠ 1 := of_decide_eq_true h_and2.1
    have hp2 : ((k + 1) ^ (get_exponent k) - k) ≠ 2 := of_decide_eq_true h_and2.2
    have h_fuel : ((k + 1) ^ (get_exponent k) - k) - 1 < 2 ^ 10000 := of_decide_eq_true h_comp.2
    exact not_prime_of_fermat_test_failed hp2 h_fuel h_pow hp

def check_range (start len : ℕ) : Bool :=
  match len with
  | 0 => true
  | l' + 1 => isComposite (start + l') && check_range start l'

lemma isComposite_of_check_range {k start len : ℕ} (h_all : check_range start len = true) (hk1 : start ≤ k) (hk2 : k < start + len) : isComposite k = true := by
  induction len with
  | zero => omega
  | succ l ih =>
    unfold check_range at h_all
    rw [Bool.and_eq_true] at h_all
    have h_curr := h_all.1
    have h_prev := h_all.2
    rcases Nat.eq_or_lt_of_le (by omega : k ≤ start + l) with rfl | h_lt
    · exact h_curr
    · exact ih h_prev (by omega)

def check_exponents_range (start len : ℕ) : Bool :=
  match len with
  | 0 => true
  | l' + 1 => decide (get_exponent (start + l') = Nat.totient (1408 - (start + l')) / 2) && check_exponents_range start l'

lemma exponents_eq_of_check_exponents_range {k start len : ℕ} (h : check_exponents_range start len = true) (hk1 : start ≤ k) (hk2 : k < start + len) :
    get_exponent k = Nat.totient (1408 - k) / 2 := by
  induction len with
  | zero => omega
  | succ l ih =>
    unfold check_exponents_range at h
    rw [Bool.and_eq_true] at h
    have h_curr := h.1
    have h_prev := h.2
    rcases Nat.eq_or_lt_of_le (by omega : k ≤ start + l) with rfl | h_lt
    · exact of_decide_eq_true h_curr
    · exact ih h_prev (by omega)

