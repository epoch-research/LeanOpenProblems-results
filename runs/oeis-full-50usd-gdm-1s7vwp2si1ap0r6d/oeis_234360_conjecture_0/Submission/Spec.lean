theorem oeis_234360_conjecture_0_disproof_helper (k : ℕ) (hk0 : 0 < k) (hkn : k < 1408) (hkp : Nat.Prime ((k + 1) ^ (Nat.totient (1408 - k) / 2) - k)) : False := by
  have hk0' : 1 ≤ k := hk0
  have h_comp := isComposite_all k hk0' hkn
  have h_not_prime := isComposite_correct k h_comp
  have h_tot_eq := exponents_eq k hk0' hkn
  rw [h_tot_eq] at h_not_prime
  exact h_not_prime hkp

