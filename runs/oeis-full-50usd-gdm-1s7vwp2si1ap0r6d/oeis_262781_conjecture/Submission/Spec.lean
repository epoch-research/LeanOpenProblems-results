def is_sol_bool (n : ℕ) (p : ℕ × ℕ × ℕ) : Bool :=
  let x := p.1
  let y := p.2.1
  let z := p.2.2
  (x < Nat.sqrt n + 1) &&
  (y < n + 1) &&
  (z < n + 1) &&
  (0 < y) &&
  (y ≤ z) &&
  (isPrime y || isPrime z) &&
  (x^2 + totient (y ^ 2) + totient (z ^ 2) == n)

lemma is_sol_of_is_sol_bool (n : ℕ) (p : ℕ × ℕ × ℕ) (h : is_sol_bool n p = true) : is_sol n p := by
  unfold is_sol
  unfold is_sol_bool at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_iff, beq_iff_eq] at h
  rcases h with ⟨⟨⟨⟨⟨⟨hx, hy⟩, hz⟩, hy_pos⟩, h_yz⟩, h_prime⟩, h_eq⟩
  refine ⟨hx, hy, hz, hy_pos, h_yz, ?_, h_eq⟩
  rcases h_prime with h_prime_y | h_prime_z
  · left; rw [← isPrime_eq_prime]; exact h_prime_y
  · right; rw [← isPrime_eq_prime]; exact h_prime_z

def sol2_valid_bool (n : ℕ) : Bool :=
  is_sol_bool n (sol2 n) && !(sol1 n == sol2 n)

lemma sol2_valid_of_sol2_valid_bool (n : ℕ) (h : sol2_valid_bool n = true) :
    is_sol n (sol2 n) ∧ sol1 n ≠ sol2 n := by
  unfold sol2_valid_bool at h
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at h
  rcases h with ⟨h1, h2⟩
  refine ⟨is_sol_of_is_sol_bool n (sol2 n) h1, ?_⟩
  intro h_eq
  rw [h_eq] at h2
  simp only [beq_self_eq_true] at h2
  revert h2; decide

-- Tighter bounds helper lemmas
lemma totient_ge_two (w : ℕ) (hw : w ≥ 3) : totient w ≥ 2 := by
  let S := (Finset.range w).filter (w.Coprime ·)
  have h1 : 1 ∈ S := by
    rw [Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, coprime_one_right w⟩
  have h2 : w - 1 ∈ S := by
    rw [Finset.mem_filter, Finset.mem_range]
    refine ⟨by omega, ?_⟩
    have h_eq : w = 1 + (w - 1) := by omega
    nth_rw 1 [h_eq]
    rw [Nat.coprime_add_self_left]
    exact Nat.coprime_one_left (w - 1)
  have h_sub : {1, w - 1} ⊆ S := by
    rw [Finset.insert_subset_iff, Finset.singleton_subset_iff]
    exact ⟨h1, h2⟩
  have h_card : ({1, w - 1} : Finset ℕ).card = 2 := by
    have h_ne : 1 ≠ w - 1 := by omega
    exact Finset.card_pair h_ne
  have h_le := Finset.card_le_card h_sub
  rw [h_card] at h_le
  exact h_le

lemma totient_sq (y : ℕ) (hy : 0 < y) : totient (y ^ 2) = y * totient y := by
  have h1 : totient (y.gcd y) * totient (y * y) = totient y * totient y * y.gcd y := totient_gcd_mul_totient_mul y y
  rw [gcd_self] at h1
  rw [sq]
  have h_pos : 0 < totient y := totient_pos.mpr hy
  have h2 : totient y * totient (y * y) = totient y * (y * totient y) := by
    calc
      totient y * totient (y * y) = totient y * totient y * y := h1
      _ = totient y * (y * totient y) := by ring
  exact Nat.eq_of_mul_eq_mul_left h_pos h2

lemma totient_sq_ge_two_mul (z : ℕ) (hz : z ≥ 3) : totient (z ^ 2) ≥ 2 * z := by
  have hz_pos : 0 < z := by omega
  rw [totient_sq z hz_pos]
  have h_tot := totient_ge_two z hz
  have : z * 2 ≤ z * totient z := Nat.mul_le_mul_left z h_tot
  omega

lemma z_bound (z : ℕ) (hz_leq : totient (z ^ 2) ≤ 1000) : z < 501 := by
  by_contra! h_gt
  have hz_ge_three : z ≥ 3 := by omega
  have h_ge := totient_sq_ge_two_mul z hz_ge_three
  omega

