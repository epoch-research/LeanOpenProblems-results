lemma mem_filter_iff_is_sol (n : ℕ) (p : ℕ × ℕ × ℕ) :
    p ∈ ((Finset.range (Nat.sqrt n + 1)).product ((Finset.range (n + 1)).product (Finset.range (n + 1)))).filter (fun p =>
      let x := p.fst
      let y := p.snd.fst
      let z := p.snd.snd

      0 < y ∧ y ≤ z ∧
      (y.Prime ∨ z.Prime) ∧
      x^2 + totient (y ^ 2) + totient (z ^ 2) = n
    ) ↔ is_sol n p := by
  unfold is_sol
  rw [Finset.mem_filter]
  rw [Finset.product_eq_sprod, Finset.product_eq_sprod]
  rw [Finset.mem_product, Finset.mem_product]
  simp only [Finset.mem_range]
  constructor
  · rintro ⟨⟨hx, hy, hz⟩, h_cond⟩
    exact ⟨hx, hy, hz, h_cond⟩
  · rintro ⟨hx, hy, hz, h_cond⟩
    exact ⟨⟨hx, hy, hz⟩, h_cond⟩

