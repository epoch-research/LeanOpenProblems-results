lemma card_pos_of_mem {α : Type*} [DecidableEq α] {S : Finset α} {p : α} (hp : p ∈ S) : S.card > 0 := by
  have : S.Nonempty := ⟨p, hp⟩
  exact Finset.card_pos.mpr this

lemma card_ge_two_of_mem {α : Type*} [DecidableEq α] {S : Finset α} {p1 p2 : α} (hp1 : p1 ∈ S) (hp2 : p2 ∈ S) (hne : p1 ≠ p2) : S.card ≥ 2 := by
  have h_sub : {p1, p2} ⊆ S := by
    rw [Finset.insert_subset_iff, Finset.singleton_subset_iff]
    exact ⟨hp1, hp2⟩
  have h_card : ({p1, p2} : Finset α).card = 2 := Finset.card_pair hne
  have h_le := Finset.card_le_card h_sub
  omega

lemma filter_subset_of_cond {α : Type*} [DecidableEq α] {A B : Finset α} {cond : α → Prop} [DecidablePred cond]
    (hAB : A ⊆ B) (h : ∀ t ∈ B, cond t → t ∈ A) :
    B.filter cond = A.filter cond := by
  ext t
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨htB, ht_cond⟩
    exact ⟨h t htB ht_cond, ht_cond⟩
  · rintro ⟨htA, ht_cond⟩
    exact ⟨hAB htA, ht_cond⟩

def A262781_fast (n : ℕ) : ℕ :=
  if n > 1000 then 2
  else
    let R_x := Finset.range (Nat.sqrt n + 1)
    let R_y_z := (Finset.range (bound n)).product (Finset.range (bound n))

    Finset.card $
    (R_x.product R_y_z)
    |>.filter (fun p =>
      let x := p.fst
      let y := p.snd.fst
      let z := p.snd.snd

      0 < y ∧ y ≤ z ∧
      (y.Prime ∨ z.Prime) ∧
      x^2 + totient (y ^ 2) + totient (z ^ 2) = n
    )

def sqrt_fuel (fuel : ℕ) (n : ℕ) (r : ℕ) : ℕ :=
  match fuel with
  | 0 => r
  | fuel' + 1 =>
    if (r + 1) * (r + 1) ≤ n then
      sqrt_fuel fuel' n (r + 1)
    else
      r

def kernel_sqrt (n : ℕ) : ℕ :=
  sqrt_fuel n n 0

lemma Nat_sqrt_eq_kernel_sqrt (n : ℕ) (hn : n ≤ 1000) : Nat.sqrt n = kernel_sqrt n := by
  rw [eq_comm, eq_sqrt]
  interval_cases n <;> decide

def A262781_kernel (n : ℕ) : ℕ :=
  if n > 1000 then 2
  else
    let R_x := Finset.range (kernel_sqrt n + 1)
    let R_y_z := (Finset.range (bound n)).product (Finset.range (bound n))

    Finset.card $
    (R_x.product R_y_z)
    |>.filter (fun p =>
      let x := p.fst
      let y := p.snd.fst
      let z := p.snd.snd

      0 < y ∧ y ≤ z ∧
      (isPrime y = true ∨ isPrime z = true) ∧
      x^2 + totient (y ^ 2) + totient (z ^ 2) = n
    )

