def is_sol (n : ℕ) (p : ℕ × ℕ × ℕ) : Prop :=
  let x := p.1
  let y := p.2.1
  let z := p.2.2
  x < Nat.sqrt n + 1 ∧ y < n + 1 ∧ z < n + 1 ∧
  0 < y ∧ y ≤ z ∧
  (y.Prime ∨ z.Prime) ∧
  x^2 + totient (y ^ 2) + totient (z ^ 2) = n

