import FormalConjectures.Util.ProblemImports

set_option exponentiation.threshold 10000

/--
A248802: Smallest prime factor of $2^{(2^n+2)} + 3$.
-/
def a (n : ℕ) : ℕ := (2 ^ (2 ^ n + 2) + 3).minFac

theorem eq_division : ∃ (q : ℕ), 2 ^ 7044 + 2 = 1398 * q + 672 := by
  use 
  decide

theorem test_dvd : 1399 ∣ 2 ^ (2 ^ 7044 + 2) + 3 := by
  rcases eq_division with ⟨k, hk⟩
  rw [hk]
  rw [Nat.pow_add]
  rw [Nat.pow_mul]
  rw [← Nat.modEq_zero_iff_dvd]
  have h1 : 2 ^ 1398 ≡ 1 [MOD 1399] := by decide
  have h2 : (2 ^ 1398) ^ k ≡ 1 ^ k [MOD 1399] := Nat.ModEq.pow k h1
  have h3 : (2 ^ 1398) ^ k ≡ 1 [MOD 1399] := by
    rw [Nat.one_pow] at h2
    exact h2
  have h4 : (2 ^ 1398) ^ k * 2 ^ 672 ≡ 1 * 2 ^ 672 [MOD 1399] := Nat.ModEq.mul_right (2 ^ 672) h3
  have h5 : (2 ^ 1398) ^ k * 2 ^ 672 ≡ 2 ^ 672 [MOD 1399] := by
    rw [Nat.one_mul] at h4
    exact h4
  have h6 : (2 ^ 1398) ^ k * 2 ^ 672 + 3 ≡ 2 ^ 672 + 3 [MOD 1399] := Nat.ModEq.add_right 3 h5
  have h7 : 2 ^ 672 + 3 ≡ 0 [MOD 1399] := by decide
  exact h6.trans h7

/--
Conjecture 5: a(138n+6) = 1669 for n >= 0 and n <> 2 mod 5.
-/
theorem oeis_248802_conjecture_5.disproof : ¬ (∀ (n : ℕ), n % 5 ≠ 2 → a (138 * n + 6) = 1669) := by
  intro h_all
  have h_spec : a (138 * 51 + 6) = 1669 := by
    apply h_all 51
    decide
  have h_7044 : 138 * 51 + 6 = 7044 := by rfl
  rw [h_7044] at h_spec
  have h_le : (2 ^ (2 ^ 7044 + 2) + 3).minFac ≤ 1399 := by
    apply Nat.minFac_le_of_dvd
    · decide
    · exact test_dvd
  have h_a_7044 : a 7044 = (2 ^ (2 ^ 7044 + 2) + 3).minFac := rfl
  rw [h_a_7044] at h_spec
  rw [h_spec] at h_le
  revert h_le
  decide

