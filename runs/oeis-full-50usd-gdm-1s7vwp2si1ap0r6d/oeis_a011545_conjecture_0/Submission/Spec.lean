            _ < 315 * Real.arctan (1 / 100) := by gcongr
        have h_div : Real.pi / Real.arctan (1 / 100) < 315 := by
          rw [div_lt_iff₀ (Real.arctan_pos.mpr (by norm_num))]
          exact h315
        have h_k_lt : (k : ℝ) < 315 := h2.trans h_div
        have h_k_gt_real : (314 : ℝ) < (k : ℝ) := by
          calc (314 : ℝ) < 314.15 := by norm_num
            _ < Real.pi * 100 := by linarith [hpi_gt]
            _ < (k : ℝ) := h1
        norm_cast at h_k_lt h_k_gt_real
        omega
      · rcases n with _ | n
        · -- n = 3
          norm_num at h1 h2
          have hpi_lt : Real.pi < 3.141593 := Real.pi_lt_d6
