open Real Int

lemma arctan_gt_div_one_add_sq (x : ℝ) (hx : 0 < x) : x / (1 + x ^ 2) < Real.arctan x := by
  let y := Real.arctan x
  have hy_pos : 0 < y := Real.arctan_pos.mpr hx
  have h_sin_lt : sin (2 * y) < 2 * y := Real.sin_lt (by linarith)
  have h_double : sin (2 * y) = 2 * sin y * cos y := sin_two_mul y
  have h_prod : sin y * cos y < y := by
    linarith [h_sin_lt, h_double]
  have h_sin : sin y = x / √(1 + x ^ 2) := Real.sin_arctan x
  have h_cos : cos y = 1 / √(1 + x ^ 2) := Real.cos_arctan x
  have h_sqrt_pos : 0 < √(1 + x ^ 2) := by
    apply sqrt_pos_of_pos
    positivity
  have h_mul : sin y * cos y = x / (1 + x ^ 2) := by
    rw [h_sin, h_cos]
    have h_div : x / √(1 + x ^ 2) * (1 / √(1 + x ^ 2)) = (x * 1) / (√(1 + x ^ 2) * √(1 + x ^ 2)) := by
      exact div_mul_div_comm x (√(1 + x ^ 2)) 1 (√(1 + x ^ 2))
    rw [h_div]
    rw [mul_one]
    rw [← sq, sq_sqrt (by positivity)]
  linarith [h_prod, h_mul]

lemma pi_div_arctan_lt (n : ℕ) (hn : 1 ≤ n) : Real.pi / Real.arctan (1 / (10 : ℝ) ^ (n : ℝ)) < Real.pi * (10 : ℝ) ^ (n : ℝ) + 1 := by
  let x := 1 / (10 : ℝ) ^ (n : ℝ)
  have h10 : 0 < (10 : ℝ) := by norm_num
  have h_pow_pos : 0 < (10 : ℝ) ^ (n : ℝ) := rpow_pos_of_pos h10 _
  have hx_pos : 0 < x := div_pos (by norm_num) h_pow_pos
  have h_recip : 1 / x = (10 : ℝ) ^ (n : ℝ) := by
    dsimp [x]
    rw [one_div_one_div]
  have h_arctan_gt : x / (1 + x ^ 2) < Real.arctan x := arctan_gt_div_one_add_sq x hx_pos
  have h_arctan_pos : 0 < Real.arctan x := Real.arctan_pos.mpr hx_pos
  have h_div_pos : 0 < x / (1 + x ^ 2) := by
    apply div_pos hx_pos
    positivity
  -- Now we take the reciprocal using inv_lt_inv₀
  have h_rec_inv : (Real.arctan x)⁻¹ < (x / (1 + x ^ 2))⁻¹ := by
    rwa [inv_lt_inv₀ h_arctan_pos h_div_pos]
  have h_rec : 1 / Real.arctan x < (1 + x ^ 2) / x := by
    rwa [← one_div, inv_div] at h_rec_inv
  -- (1 + x^2) / x = 1/x + x
  have h_split : (1 + x ^ 2) / x = 1 / x + x := by
    rw [add_div]
    have : x ^ 2 / x = x := by
      rw [sq, mul_div_cancel_right₀ _ (ne_of_gt hx_pos)]
    rw [this]
  rw [h_split] at h_rec
  rw [h_recip] at h_rec
  -- Multiply by pi
  have h_pi_mul : Real.pi / Real.arctan x < Real.pi * ((10 : ℝ) ^ (n : ℝ) + x) := by
    rw [div_eq_mul_one_div, mul_comm]
    have : 1 / Real.arctan x * Real.pi = Real.pi * (1 / Real.arctan x) := by ring
    rw [this]
    gcongr
  have h_pi_lt : Real.pi < 4 := Real.pi_lt_four
  -- We want to prove Real.pi * x < 1
  have hn_real : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have h_pow_ge : (10 : ℝ) ^ (1 : ℝ) ≤ (10 : ℝ) ^ (n : ℝ) := by
    apply rpow_le_rpow_of_exponent_le (by norm_num) hn_real
  have h_pow_ge_10 : 10 ≤ (10 : ℝ) ^ (n : ℝ) := by
    rw [rpow_one] at h_pow_ge
    exact h_pow_ge
  have hx_le : x ≤ 1 / 10 := by
    dsimp [x]
    rw [div_le_div_iff₀ h_pow_pos (by norm_num)]
    linarith
  have h_pi_mul_x : Real.pi * x < 1 := by
    have hpi_pos : 0 < Real.pi := Real.pi_pos
    nlinarith
  calc Real.pi / Real.arctan x < Real.pi * ((10 : ℝ) ^ (n : ℝ) + x) := h_pi_mul
    _ = Real.pi * (10 : ℝ) ^ (n : ℝ) + Real.pi * x := by ring
    _ < Real.pi * (10 : ℝ) ^ (n : ℝ) + 1 := by linarith

