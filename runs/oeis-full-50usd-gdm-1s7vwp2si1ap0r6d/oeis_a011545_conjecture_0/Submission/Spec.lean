/--
A011545: $a(n)$ is the integer whose decimal digits are the first $n+1$ decimal digits of $\pi$.
This is equivalent to $a(n) = \lfloor \pi \cdot 10^n \rfloor$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  (floor (Real.pi * (10 : ℝ) ^ n.cast)).toNat

theorem oeis_a011545_conjecture_0 (n : ℕ) :
    ¬ ∃ (k : ℤ),
      (Real.pi * (10 : ℝ) ^ n.cast < k.cast) ∧
      (k.cast < Real.pi / Real.arctan (1 / (10 : ℝ) ^ n.cast)) := by
  intro ⟨k, h1, h2⟩
  rcases n with _ | n
  · -- n = 0
    simp at h1 h2
    have h4 : (3 : ℝ) < Real.pi := Real.pi_gt_three
    have h5 : (3 : ℝ) < k.cast := h4.trans h1
    norm_cast at h5 h2
    omega
  · rcases n with _ | n
    · -- n = 1
      norm_num at h1 h2
      have hpi_lt : Real.pi < 3.15 := Real.pi_lt_d2
      have hpi_gt : 3.14 < Real.pi := Real.pi_gt_d2
      have h_at : 10 / 101 < Real.arctan (1 / 10) := by
        have h_gt := arctan_gt_div_one_add_sq (1 / 10) (by norm_num)
        have : (1 / 10 : ℝ) / (1 + (1 / 10) ^ 2) = 10 / 101 := by norm_num
        rwa [this] at h_gt
      have h32 : Real.pi < 32 * Real.arctan (1 / 10) := by
        calc Real.pi < 3.15 := hpi_lt
          _ < 320 / 101 := by norm_num
          _ = 32 * (10 / 101) := by norm_num
          _ < 32 * Real.arctan (1 / 10) := by gcongr
      have h_div : Real.pi / Real.arctan (1 / 10) < 32 := by
        rw [div_lt_iff₀ (Real.arctan_pos.mpr (by norm_num))]
        exact h32
      have h_k_lt : (k : ℝ) < 32 := h2.trans h_div
      have h_k_gt_real : (31 : ℝ) < (k : ℝ) := by
        calc (31 : ℝ) < 31.4 := by norm_num
          _ < Real.pi * 10 := by linarith [hpi_gt]
          _ < (k : ℝ) := h1
      norm_cast at h_k_lt h_k_gt_real
      omega
    · rcases n with _ | n
      · -- n = 2
        norm_num at h1 h2
        have hpi_lt : Real.pi < 3.1416 := Real.pi_lt_d4
        have hpi_gt : 3.1415 < Real.pi := Real.pi_gt_d4
        have h_at : 100 / 10001 < Real.arctan (1 / 100) := by
