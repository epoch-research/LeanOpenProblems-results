lemma scaling_reduction (n : ℕ)
    (h : ∃ x y z w : ℕ,
      x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
      x ≥ y ∧
      (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt =
        x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2) :
    ∃ x y z w : ℕ,
      x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = 4 * n ∧
      x ≥ y ∧
      (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt =
        x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2 := by
  rcases h with ⟨x, y, z, w, h1, h2, h3⟩
  use 2 * x, 2 * y, 2 * z, 2 * w
  refine ⟨?_, ?_, ?_⟩
  · calc
      (2 * x) ^ 2 + (2 * y) ^ 2 + (2 * z) ^ 2 + (2 * w) ^ 2 = 4 * (x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2) := by ring
      _ = 4 * n := by rw [h1]
  · omega
  · have h_sq : (2 * x) ^ 2 + 8 * (2 * y) ^ 2 + 16 * (2 * z) ^ 2 = 4 * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2) := by ring
    rw [h_sq]
    have h_sqrt_prop : 4 * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2) =
        (2 * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt) * (2 * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt) := by
      have h_alg : 4 * ((x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt) =
          (2 * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt) * (2 * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt) := by ring
      rw [← h_alg]
      rw [h3]
    rw [h_sqrt_prop]
    rw [Nat.sqrt_eq]

theorem oeis_A271510_conjecture_i_positive :
  ∀ n : ℕ, 0 < A271510 n
  := by
    intro n
    dsimp [A271510]
    rw [Finset.card_pos]
    have H : ∃ x y z w : ℕ,
      x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
      x ≥ y ∧
      (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt =
        x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2 := by
      induction' n using Nat.strong_induction_on with n ih
      have h_cases : n < 1100 ∨ n ≥ 1100 := by omega
      rcases h_cases with h_lt | h_ge
      · have h_corr := get_sol_witness_correct n h_lt
        let p := get_sol_witness n
        use p.1, p.2.1, p.2.2.1, p.2.2.2.1
        refine ⟨h_corr.1, h_corr.2.1, ?_⟩
        have h_S : p.1 ^ 2 + 8 * p.2.1 ^ 2 + 16 * p.2.2.1 ^ 2 = p.2.2.2.2 ^ 2 := h_corr.2.2
        rw [h_S]
        exact sqrt_square_prop p.2.2.2.2
      · by_cases h4 : n % 4 = 0
        · have h_lt : n / 4 < n := by omega
          have ih_sol := ih (n / 4) h_lt
          have h_eq : 4 * (n / 4) = n := by omega
          have scaled := scaling_reduction (n / 4) ih_sol
          rw [h_eq] at scaled
          exact scaled
        · sorry
    rcases H with ⟨x, y, z, w, h1, h2, h3⟩
    refine ⟨(((x, y), z), w), ?_⟩
    simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range]
    refine ⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, h1, h2, h3⟩
    · rw [Nat.lt_succ_iff, Nat.le_sqrt']
      omega
    · rw [Nat.lt_succ_iff, Nat.le_sqrt']
      omega
    · rw [Nat.lt_succ_iff, Nat.le_sqrt']
      omega
    · rw [Nat.lt_succ_iff, Nat.le_sqrt']
      omega
