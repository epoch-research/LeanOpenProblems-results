import FormalConjectures.Util.ProblemImports

open Nat

/--
A271510: Number of ordered ways to write $ as ^2 + y^2 + z^2 + w^2$ with  \ge y \ge 0$,  \ge 0$ and  \ge 0$ such that ^2 + 8y^2 + 16z^2$ is a square.
-/
def A271510 (n : ℕ) : ℕ :=
  let is_square (k : ℕ) : Prop := k.sqrt * k.sqrt = k
  let bound := n.sqrt
  let R : Finset ℕ := Finset.range (bound + 1)
  let search_space : Finset (((ℕ × ℕ) × ℕ) × ℕ) := R.product R |>.product R |>.product R
  Finset.card $ search_space.filter fun p =>
    let x := p.fst.fst.fst
    let y := p.fst.fst.snd
    let z := p.fst.snd
    let w := p.snd
    x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
    x ≥ y ∧
    is_square (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2)

lemma sqrt_square_prop (m : ℕ) : (m ^ 2).sqrt * (m ^ 2).sqrt = m ^ 2 := by
  have h1 : (m ^ 2).sqrt = m := by
    have h_sq : m ^ 2 = m * m := by ring
    rw [h_sq]
    exact Nat.sqrt_eq m
  rw [h1]
  ring

