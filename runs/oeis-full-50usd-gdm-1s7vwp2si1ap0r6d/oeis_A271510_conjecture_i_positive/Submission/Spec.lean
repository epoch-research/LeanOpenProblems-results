def get_sol_witness (n : ℕ) : ℕ × ℕ × ℕ × ℕ × ℕ :=
  if n < 100 then get_sol_witness_0 (n - 0)
  else  if n < 200 then get_sol_witness_1 (n - 100)
  else  if n < 300 then get_sol_witness_2 (n - 200)
  else  if n < 400 then get_sol_witness_3 (n - 300)
  else  if n < 500 then get_sol_witness_4 (n - 400)
  else  if n < 600 then get_sol_witness_5 (n - 500)
  else  if n < 700 then get_sol_witness_6 (n - 600)
  else  if n < 800 then get_sol_witness_7 (n - 700)
  else  if n < 900 then get_sol_witness_8 (n - 800)
  else  if n < 1000 then get_sol_witness_9 (n - 900)
  else get_sol_witness_10 (n - 1000)

