  let x := p.1
  let y := p.2.1
  let z := p.2.2.1
  let w := p.2.2.2.1
  let S := p.2.2.2.2
  x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
  x ≥ y ∧
  x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2 = S ^ 2 := by
  intro n hn
  by_cases h0 : n < 100
  · rw [get_sol_witness_eq_0 n h0]
    have h_corr := get_sol_witness_0_correct (n - 0) (by omega)
    have h_sub : 0 * 100 + (n - 0) = n := by omega
