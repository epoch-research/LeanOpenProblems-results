set_option maxRecDepth 200000
theorem get_sol_correct : ∀ n < 200,
  let p := get_sol n
  let x := p.1
  let y := p.2.1
  let z := p.2.2.1
  let w := p.2.2.2
  x ^ 2 + y ^ 2 + z ^ 2 + w ^ 2 = n ∧
  x ≥ y ∧
  (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt * (x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2).sqrt =
    x ^ 2 + 8 * y ^ 2 + 16 * z ^ 2 := by
  decide
