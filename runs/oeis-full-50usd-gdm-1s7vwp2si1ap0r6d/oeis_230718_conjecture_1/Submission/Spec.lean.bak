lemma no_sol_n_14 (N : ℕ) (hN1 : 19 ≤ N) (hN2 : N ≤ 41) :
    ¬ ∃ k : ℕ, 1 ≤ k ∧ k ≤ N - 2 ∧ (Ico k N).sum (fun i => i ^ 14) = N ^ 14 := by
  intro h
