lemma no_sol_n_92 (N : ℕ) (hN1 : 97 ≤ N) (hN2 : N ≤ 275) :
    ¬ ∃ k : ℕ, 1 ≤ k ∧ k ≤ N - 2 ∧ (Ico k N).sum (fun i => i ^ 92) = N ^ 92 := by
  intro h
