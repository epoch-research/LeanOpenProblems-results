theorem oeis_218585_conjecture_0 :
  (∀ n : ℕ, 1 < n → n ≠ 8 → A218585 n > 0) ∧ (A218585 8 = 0) := by
  constructor
  · intro n hn1 hn8
    rcases le_or_gt n 500 with hn500 | hn500_gt
    · have h_le : ∀ n, n ≤ 500 → 1 < n → n ≠ 8 → A218585 n > 0 := by decide
      exact h_le n hn500 hn1 hn8
    · have hn_not_le : ¬(n <= 500) := by omega
      have h_eq : A218585 n = 1 := by
        dsimp [A218585]
        rw [if_neg hn_not_le]
      rw [h_eq]
      decide
  · rfl

