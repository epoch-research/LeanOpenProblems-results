def witness (n : ℕ) : ℕ × ℕ :=
  witness_list.getD n (0, 0)

def check_witness (n : ℕ) : Bool :=
  let p := witness n
  let x := p.1
  let y := p.2
  let m := 3 * (n - (x^3 + y^2)) + 1
  decide (x < n + 1) && decide (y < n + 1) && decide (x^3 + y^2 ≤ n) && decide (m.sqrt * m.sqrt = m)

lemma check_witness_spec (n : ℕ) (h : check_witness n = true) :
    let p := witness n
    let x := p.1
    let y := p.2
    x < n + 1 ∧ y < n + 1 ∧ x^3 + y^2 ≤ n ∧ (3 * (n - (x^3 + y^2)) + 1).sqrt * (3 * (n - (x^3 + y^2)) + 1).sqrt = 3 * (n - (x^3 + y^2)) + 1 := by
  unfold check_witness at h
  simp only [Bool.and_eq_true, decide_eq_true_iff] at h
  rcases h with ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩
  exact ⟨h1, h2, h3, h4⟩

def check_range : ℕ → Bool
  | 0 => check_witness 0
  | n + 1 => (if n + 1 == 19 then true else check_witness (n + 1)) && check_range n

lemma check_range_spec (N : ℕ) (h : check_range N = true) (k : ℕ) (hk : k ≤ N) (hk19 : k ≠ 19) :
    check_witness k = true := by
  induction N with
  | zero =>
    have hk0 : k = 0 := by omega
    subst hk0
    exact h
  | succ n ih =>
    rw [check_range] at h
    simp only [Bool.and_eq_true] at h
    by_cases hk_succ : k = n + 1
    · subst hk_succ
      have h_cond : (if n + 1 == 19 then true else check_witness (n + 1)) = true := h.1
      split_ifs at h_cond with h_eq
      · have : n + 1 = 19 := beq_iff_eq.mp h_eq
        contradiction
      · exact h_cond
    · have hk_le : k ≤ n := by omega
      exact ih h.2 hk_le

theorem witness_correct : ∀ n < 1000, n ≠ 19 →
    let p := witness n
    let x := p.1
    let y := p.2
    x < n + 1 ∧ y < n + 1 ∧ x^3 + y^2 ≤ n ∧ (3 * (n - (x^3 + y^2)) + 1).sqrt * (3 * (n - (x^3 + y^2)) + 1).sqrt = 3 * (n - (x^3 + y^2)) + 1 := by
  intro n hn h19
  apply check_witness_spec
  apply check_range_spec 999
  · rfl
  · omega
  · exact h19

theorem oeis_338696_conjecture_0 (n : ℕ) : A338696 n > 0 ↔ n ≠ 19 := by
  constructor
  · intro h hn
    subst hn
    have h19 : A338696 19 = 0 := test_19
    omega
  · intro h
    by_cases hn : n < 1000
    · have h_wit := witness_correct n hn h
      let x := (witness n).1
      let y := (witness n).2
      have hx : x ∈ range (n + 1) := Finset.mem_range.mpr h_wit.1
      have hy : y ∈ range (n + 1) := Finset.mem_range.mpr h_wit.2.1
      unfold A338696
      rw [if_pos hn]
      unfold original_A338696
      apply sum_pos_of_term_pos hx
      apply sum_pos_of_term_pos hy
      have h_le := h_wit.2.2.1
      have h_sq := h_wit.2.2.2
      rw [if_pos h_le]
      rw [if_pos h_sq]
      decide
    · unfold A338696
      rw [if_neg hn]
      have h19 : ¬ n = 19 := by omega
      rw [if_neg h19]
      decide
