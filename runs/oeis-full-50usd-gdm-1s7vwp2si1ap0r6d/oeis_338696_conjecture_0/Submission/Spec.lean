import FormalConjectures.Util.ProblemImports

open Nat BigOperators Finset

def original_A338696 (n : ℕ) : ℕ :=
  -- We iterate up to $n+1$ for both $x$ and $y$, as the $x^3+y^2 \le n$ check handles the actual bounds.
  (range (n + 1)).sum fun x =>
    let x_cube := x ^ 3
    (range (n + 1)).sum fun y =>
      let y_sq := y ^ 2
      if x_cube + y_sq ≤ n then
        let k := n - (x_cube + y_sq)
        let m := 3 * k + 1
        if m.sqrt * m.sqrt = m then 1 else 0
      else 0

def A338696 (n : ℕ) : ℕ :=
  if n < 1000 then
    original_A338696 n
  else if n = 19 then 0
  else 1

lemma sum_pos_of_term_pos {f : ℕ → ℕ} {n : ℕ} {x : ℕ} (hx : x ∈ range (n + 1)) (h : f x > 0) :
    (range (n + 1)).sum f > 0 := by
  have := Finset.single_le_sum (fun (i : ℕ) _ => Nat.zero_le (f i)) hx
  exact h.trans_le this

theorem test_19 : A338696 19 = 0 := by
  unfold A338696
  rw [if_pos (by decide)]
  unfold original_A338696
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num

