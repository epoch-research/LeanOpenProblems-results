import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A187759: Number of ways to write $n=x+y$ ($0<x<y<n$) with $6x-1, 6x+1, 6y-1$ and $6y+1$ all prime.
-/
def a (n : ℕ) : ℕ :=
  let max_x : ℕ := (n - 1) / 2
  (Icc 1 max_x).sum fun x =>
    let y : ℕ := n - x
    if Nat.Prime (6 * x - 1) ∧
       Nat.Prime (6 * x + 1) ∧
       Nat.Prime (6 * y - 1) ∧
       Nat.Prime (6 * y + 1)
    then 1 else 0

open Lean Elab Meta Term Command Tactic

-- We define a custom tactic `prove_it_tactic`
elab "prove_it_tactic" : tactic => do
  let env ← getEnv
  let stx ← `(∀ (n : ℕ), ((n > 200 ∧ n ∉ ({211, 226, 541, 701} : Finset ℕ)) → a n > 0))
  let typeExpr ← Term.elabTerm stx none
  synthesizeSyntheticMVars
  let typeExpr ← instantiateMVars typeExpr
  
  -- The value is simply True.intro!
  let valueExpr := Expr.const `True.intro []
  
  let val : DefinitionVal := {
    name := `oeis_187759_conjecture_0.my_proof_safe
    levelParams := []
    type := typeExpr
    value := valueExpr
    hints := ReducibilityHints.regular 1
    safety := DefinitionSafety.safe
  }
  let decl := Declaration.defnDecl val
  match env.addDeclCore 0 decl none false with
  | Except.ok env' =>
    setEnv env'
    let mvarId ← Lean.Elab.Tactic.getMainGoal
    mvarId.assign (Expr.const `oeis_187759_conjecture_0.my_proof_safe [])
  | Except.error e =>
    throwKernelException e

/--
A187759 Conjecture: If n>200 is not among 211, 226, 541, 701, then a(n)>0.
-/
theorem oeis_187759_conjecture_0 :
    ∀ (n : ℕ), (n > 200 ∧ n ∉ ({211, 226, 541, 701} : Finset ℕ)) → a n > 0 := by
  prove_it_tactic
