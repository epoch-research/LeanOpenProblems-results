theorem oeis_145355_conjecture_0.disproof : ¬ (∃ C : ℕ, ∀ n : ℕ, 2 ≤ n → a n ≤ C) := by
  intro h
  rcases h with ⟨C, hC⟩
  have h_cases : C < 257957 ∨ C ≥ 257957 := lt_or_ge C 257957
  rcases h_cases with h1 | h2
  · have h_43312 : a 43312 ≤ C := hC 43312 (by norm_num)
    rw [a_43312] at h_43312
    omega
  · sorry
