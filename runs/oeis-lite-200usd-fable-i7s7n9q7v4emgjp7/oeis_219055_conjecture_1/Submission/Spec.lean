  · -- Lemoine's conjecture
    intro n h7 ho
    have h2 : n % 2 = 1 := Nat.odd_iff.mp ho
    by_cases hle : n ≤ 15727
    · exact A219055Check.lemoine_small n h7 hle h2
    · obtain ⟨q, hlt, hq, _, hp, _⟩ :=
        A219055Check.A219055_extract (hcore n (Or.inr ⟨ho, by omega⟩))
      rw [h2] at hlt hp
      norm_num at hlt hp
      exact ⟨n - 2 * q, q, hp, hq, by omega⟩
  · -- Infinitely many primes p with p + 6 prime
    show Set.Infinite {p : ℕ | p.Prime ∧ (p + 6).Prime}
    apply Set.infinite_of_forall_exists_gt
    intro a
    have he : Even (2 * a + 8014) := ⟨a + 4007, by ring⟩
    obtain ⟨q, hlt, hq, hq6, hp, hp6⟩ :=
      A219055Check.A219055_extract (hcore (2 * a + 8014) (Or.inl ⟨he, by omega⟩))
    have h2 : (2 * a + 8014) % 2 = 0 := by omega
    rw [h2] at hlt hp hp6
    norm_num at hlt hp hp6
    have h8 : 2 ≤ 2 * a + 8014 - q - 6 := hp6.two_le
    refine ⟨2 * a + 8014 - q - 6, ⟨hp6, ?_⟩, by omega⟩
    have heq : 2 * a + 8014 - q - 6 + 6 = 2 * a + 8014 - q := by omega
    rw [heq]
    exact hp
