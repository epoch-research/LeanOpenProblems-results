import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A219055: Number of ways to write $n = p+q(3-(-1)^n)/2$ with $p>q$ and $p, q, p-6, q+6$ all prime.
-/
def A219055 (n : ℕ) : ℕ :=
  Finset.card $ Finset.filter (fun q : ℕ =>
    -- c = 1 + n % 2. The condition p > q is equivalent to (c + 1) * q < n.
    ((1 + n % 2) + 1) * q < n ∧

    -- Primality conditions for q and derived terms
    q.Prime ∧
    (q + 6).Prime ∧

    -- Primality conditions for p = n - c * q and p - 6
    (n - (1 + n % 2) * q).Prime ∧        -- p must be prime
    (n - (1 + n % 2) * q - 6).Prime      -- p - 6 must be prime
  ) (Finset.range n)

-- Formal definition of Goldbach's Conjecture
def goldbach_conjecture : Prop :=
  ∀ n : ℕ, 4 ≤ n → Even n → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + q

-- Formal definition of Lemoine's Conjecture (or Levy's Conjecture)
def lemoine_conjecture : Prop :=
  ∀ n : ℕ, 7 ≤ n → Odd n → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ n = p + 2 * q

-- Formalization of the conjecture that there are infinitely many cousin primes (p, p+6)
def six_prime_gap_conjecture : Prop :=
  Set.Infinite {p : ℕ | p.Prime ∧ (p + 6).Prime}

/--
The core conjecture about the sequence A219055:
a(n) > 0 for all even n > 8012 and odd n > 15727.
-/
def a219055_core_conjecture : Prop :=
  ∀ n : ℕ,
    (Even n ∧ 8012 < n) ∨ (Odd n ∧ 15727 < n)
      → A219055 n > 0

namespace A219055Check

/-- Trial division loop: returns `true` if `n` has no divisor `m` with
`d ≤ m ≤ sqrt n`, provided enough fuel. -/
def noDivAux (n : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | fuel+1, d =>
    if n < d * d then true
    else if n % d = 0 then false
    else noDivAux n fuel (d+1)

/-- A `Bool`-valued primality test by trial division, suitable for kernel reduction. -/
def isPrimeB (n : ℕ) : Bool :=
  if n < 2 then false else noDivAux n n 2

lemma noDivAux_sound (n : ℕ) : ∀ fuel d, n.sqrt < d + fuel →
    noDivAux n fuel d = true → ∀ m, d ≤ m → m ≤ n.sqrt → ¬ m ∣ n := by
  intro fuel
  induction fuel with
  | zero =>
    intro d hlt _ m hdm hm
    omega
  | succ fuel ih =>
    intro d hlt h m hdm hm hdvd
    rw [noDivAux] at h
    by_cases h1 : n < d * d
    · have h2 : m * m ≤ n := Nat.le_sqrt.mp hm
      have h3 : d * d ≤ m * m := Nat.mul_le_mul hdm hdm
      omega
    · rw [if_neg h1] at h
      by_cases h2 : n % d = 0
      · rw [if_pos h2] at h; exact absurd h (by simp)
      · rw [if_neg h2] at h
        rcases Nat.eq_or_lt_of_le hdm with rfl | hlt2
        · exact h2 (Nat.dvd_iff_mod_eq_zero.mp hdvd)
        · exact ih (d+1) (by omega) h m hlt2 hm hdvd

lemma noDivAux_complete (n : ℕ) (hn : ∀ m, 2 ≤ m → m ≤ n.sqrt → ¬ m ∣ n) :
    ∀ fuel d, 2 ≤ d → noDivAux n fuel d = true := by
  intro fuel
  induction fuel with
  | zero => intro d _; rfl
  | succ fuel ih =>
    intro d hd
    rw [noDivAux]
    by_cases h1 : n < d * d
    · rw [if_pos h1]
    · rw [if_neg h1]
      have hdd : d * d ≤ n := Nat.le_of_not_lt h1
      have hds : d ≤ n.sqrt := Nat.le_sqrt.mpr hdd
      have hmod : ¬ n % d = 0 := fun hh =>
        hn d hd hds (Nat.dvd_iff_mod_eq_zero.mpr hh)
      rw [if_neg hmod]
      exact ih (d+1) (by omega)

lemma isPrimeB_iff (n : ℕ) : isPrimeB n = true ↔ n.Prime := by
  constructor
  · intro h
    rw [isPrimeB] at h
    by_cases h2 : n < 2
    · rw [if_pos h2] at h; exact absurd h (by simp)
    · rw [if_neg h2] at h
      rw [Nat.prime_def_le_sqrt]
      refine ⟨by omega, fun m hm hms => ?_⟩
      have hs := Nat.sqrt_le_self n
      exact noDivAux_sound n n 2 (by omega) h m hm hms
  · intro hp
    rw [isPrimeB, if_neg (by have := hp.two_le; omega : ¬ n < 2)]
    apply noDivAux_complete
    · intro m hm hms
      exact (Nat.prime_def_le_sqrt.mp hp).2 m hm hms
    · omega

/-- Checker for Goldbach witnesses: entry `i` of `ws` is a prime `p` such that
`n₀ + 2*i - p` is also prime. -/
def gCheck : ℕ → List ℕ → Bool
  | _, [] => true
  | n, p :: ps => (isPrimeB p && (isPrimeB (n - p) && Nat.ble p n)) && gCheck (n + 2) ps

/-- Checker for Lemoine witnesses: entry `i` of `ws` is a prime `q` such that
`n₀ + 2*i - 2*q` is also prime. -/
def lCheck : ℕ → List ℕ → Bool
  | _, [] => true
  | n, q :: qs => (isPrimeB q && (isPrimeB (n - 2*q) && Nat.ble (2*q) n)) && lCheck (n + 2) qs

lemma gCheck_sound : ∀ (ws : List ℕ) (n₀ : ℕ), gCheck n₀ ws = true →
    ∀ i, i < ws.length → ∃ p q, p.Prime ∧ q.Prime ∧ n₀ + 2 * i = p + q := by
  intro ws
  induction ws with
  | nil => intro n₀ _ i hi; simp at hi
  | cons w ws ih =>
    intro n₀ h i hi
    rw [gCheck, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
    obtain ⟨⟨hw, hnw, hle⟩, hrest⟩ := h
    have hle' : w ≤ n₀ := Nat.le_of_ble_eq_true hle
    match i with
    | 0 =>
      exact ⟨w, n₀ - w, (isPrimeB_iff _).mp hw, (isPrimeB_iff _).mp hnw, by omega⟩
    | Nat.succ i =>
      obtain ⟨p, q, hp, hq, he⟩ := ih (n₀+2) hrest i (by simp at hi ⊢; omega)
      exact ⟨p, q, hp, hq, by omega⟩

lemma lCheck_sound : ∀ (ws : List ℕ) (n₀ : ℕ), lCheck n₀ ws = true →
    ∀ i, i < ws.length → ∃ p q, p.Prime ∧ q.Prime ∧ n₀ + 2 * i = p + 2 * q := by
  intro ws
  induction ws with
  | nil => intro n₀ _ i hi; simp at hi
  | cons w ws ih =>
    intro n₀ h i hi
    rw [lCheck, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
    obtain ⟨⟨hw, hnw, hle⟩, hrest⟩ := h
    have hle' : 2 * w ≤ n₀ := Nat.le_of_ble_eq_true hle
    match i with
    | 0 =>
      exact ⟨n₀ - 2 * w, w, (isPrimeB_iff _).mp hnw, (isPrimeB_iff _).mp hw, by omega⟩
    | Nat.succ i =>
      obtain ⟨p, q, hp, hq, he⟩ := ih (n₀+2) hrest i (by simp at hi ⊢; omega)
      exact ⟨p, q, hp, hq, by omega⟩

lemma gCheck_range (ws : List ℕ) (n₀ len : ℕ) (hlen : ws.length = len)
    (h : gCheck n₀ ws = true) (n : ℕ) (h1 : n₀ ≤ n) (h2 : n < n₀ + 2 * len)
    (h3 : (n - n₀) % 2 = 0) : ∃ p q, p.Prime ∧ q.Prime ∧ n = p + q := by
  obtain ⟨p, q, hp, hq, he⟩ := gCheck_sound ws n₀ h ((n - n₀) / 2) (by omega)
  exact ⟨p, q, hp, hq, by omega⟩

lemma lCheck_range (ws : List ℕ) (n₀ len : ℕ) (hlen : ws.length = len)
    (h : lCheck n₀ ws = true) (n : ℕ) (h1 : n₀ ≤ n) (h2 : n < n₀ + 2 * len)
    (h3 : (n - n₀) % 2 = 0) : ∃ p q, p.Prime ∧ q.Prime ∧ n = p + 2 * q := by
  obtain ⟨p, q, hp, hq, he⟩ := lCheck_sound ws n₀ h ((n - n₀) / 2) (by omega)
  exact ⟨p, q, hp, hq, by omega⟩

