/-! ### The majorant Ξ and associated sums -/

def pval (P : ℚ × ℚ) (n : ℕ) : ℚ := 2 * P.1 ^ nuu n * P.2 ^ rq n

def pmin (n : ℕ) : ℚ :=
  (planes.map (fun P => pval P n)).foldr min (pval ((17:ℚ)/10, (1:ℚ)) n)

def Xi (n : ℕ) : ℚ := if n ≤ 527 then XTL.getD n 1 else pmin n

def sh (n : ℕ) : ℚ :=
  if nuu n = 0 ∨ blk n - nuu n ≤ 1 then 1
  else 1 - Xi (T (blk n - nuu n - 1) - 1) / ((blk n - nuu n : ℕ) + 1 : ℚ)

def termQ (n Kp : ℕ) : ℚ := Bq (n - Kp) * Xi (n - Kp) / ((Kp)! : ℚ)

def SO (K n : ℕ) : ℚ :=
  ∑ Kp ∈ Ioc (K0 n) K, if Kp ≤ n ∧ (blk (n-Kp) + blk n) % 2 = 1 then termQ n Kp else 0

def SE (K n : ℕ) : ℚ :=
  ∑ Kp ∈ Ioc (K0 n) K, if Kp ≤ n ∧ (blk (n-Kp) + blk n) % 2 = 0 then termQ n Kp else 0

def StepP (n : ℕ) : Prop := Bq n + SO n n ≤ Xi n * Bq n

def G2P (n : ℕ) : Prop := SE n n < sh n * Bq n

/-! ### Fast kernel checker with dyadic upper-rounded relative weights -/

def r45 (x : ℚ) : ℚ := ((⌊x * 2^45⌋ + 1 : ℤ) : ℚ) / 2^45

/-- exact value of Bq (c-1) / Bq c, computed from c and p = blk c -/
def fdefFrom (c p : ℕ) : ℚ :=
  if 2 ≤ c - p*(p+1)/2 then (((p+1)*(p+2)/2 + 1 - c : ℕ) : ℚ)
  else if c - p*(p+1)/2 = 1 then ((p + 1 : ℕ) : ℚ) else 1

/-- iterate K' = Kp, Kp+1, ..., Kp+steps-1 accumulating tau * Xi(n-K') by parity;
    the lists are suffixes of XTLR/PRLR aligned so the head is index c = n - Kp. -/
def SOE2 (n pn : ℕ) : List ℚ → List ℕ → ℕ → ℕ → ℚ → ℚ → ℚ → ℚ × ℚ
  | _, _, 0, _, _, so, se => (so, se)
  | x::xs, p::ps, steps+1, Kp, tau, so, se =>
      if (p + pn) % 2 = 1 then
        SOE2 n pn xs ps steps (Kp+1) (r45 (tau * fdefFrom (n-Kp) p / ((Kp+1:ℕ):ℚ))) (so + tau * x) se
      else
        SOE2 n pn xs ps steps (Kp+1) (r45 (tau * fdefFrom (n-Kp) p / ((Kp+1:ℕ):ℚ))) so (se + tau * x)
  | _, _, _+1, _, _, so, se => (so, se)

def chk (n : ℕ) : Bool :=
  let k0 := K0 n
  if n ≤ k0 then
    decide ((1:ℚ) ≤ XTL.getD n 1) && decide ((0:ℚ) < sh n)
  else
    let tau0 := r45 (fdefFrom (n - k0) (blk (n - k0)) / ((k0+1 : ℕ) : ℚ))
    let r := SOE2 n (blk n) (XTLR.drop (528 - (n - k0))) (PRLR.drop (528 - (n - k0)))
              (n - k0) (k0+1) tau0 0 0
    decide (1 + r.1 ≤ XTL.getD n 1) && decide (r.2 < sh n)

