  cond (Nat.ble N r8) true
    ((allB (leafY9 N r8) fy 0).and (Nat.ble N (Nat.add r8 (c6 (Nat.pow 2 fy)))))

theorem link9_spec : ∀ a, a < 225 → linkA9 a = true := by
  intro a ha
  have h := allB_sound _ 0 linkall9_true a (Nat.zero_le _) (by omega)
  simp only [linkG9] at h
  have hble : Nat.ble 225 a = false := by
    cases hb : Nat.ble 225 a with
    | true => rw [Nat.ble_eq] at hb; omega
    | false => rfl
  rw [hble, cond_false] at h
  exact h

/-- extract the value-slot equality for a real (non-sentinel) slot in period `k`. -/
theorem link9_at {a i e k : Nat} (ha : a < 225) (hi : i < 2 ^ fla a)
    (hs : slotC (cbof a) i = e) (he : e < 2700) (hk : k < 5) :
    slotW (cbw k a) i = c4 (2700 * k + e) := by
  have h := link9_spec a ha
  simp only [linkA9] at h
  have hb := allI2_sound _ _ _ h k (Nat.zero_le _) (by omega)
  have hl := allBH_sound _ 0 hb i (Nat.zero_le _) (by omega)
  simp only [hs] at hl
  have hble : Nat.ble 2700 e = false := by
    cases hb2 : Nat.ble 2700 e with
    | true => rw [Nat.ble_eq] at hb2; omega
    | false => rfl
  rw [hble, cond_false, Nat.beq_eq] at hl
  simp only [add_eqn, mul_eqn] at hl
  exact hl

theorem field52_0 (CBV j : Nat) :
    Nat.land (Nat.land (Nat.shiftRight CBV (Nat.mul 208 j))
        411376139330301510538742295639337626245683966408394965837152255) 4503599627370495
      = slotW CBV (4 * j + 0) := by
  rw [slotW]
  show ((CBV >>> (208 * j)) &&& (2 ^ 208 - 1)) &&& (2 ^ 52 - 1)
      = (CBV >>> (52 * (4 * j + 0))) &&& (2 ^ 52 - 1)
  simp only [Nat.and_two_pow_sub_one_eq_mod, Nat.shiftRight_eq_div_pow]
  rw [Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 2 (by norm_num : 52 ≤ 208))]
  have h : 208 * j = 52 * (4 * j + 0) := by ring
  rw [h]

theorem field52_1 (CBV j : Nat) :
    Nat.land (Nat.shiftRight (Nat.land (Nat.shiftRight CBV (Nat.mul 208 j))
        411376139330301510538742295639337626245683966408394965837152255) 52) 4503599627370495
      = slotW CBV (4 * j + 1) := by
  rw [slotW]
  show (((CBV >>> (208 * j)) &&& (2 ^ 208 - 1)) >>> 52) &&& (2 ^ 52 - 1)
      = (CBV >>> (52 * (4 * j + 1))) &&& (2 ^ 52 - 1)
  simp only [Nat.and_two_pow_sub_one_eq_mod, Nat.shiftRight_eq_div_pow]
  rw [show (2:Nat) ^ 208 = 2 ^ 52 * 2 ^ 156 by norm_num]
  rw [Nat.mod_mul_right_div_self]
  rw [Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 2 (by norm_num : 52 ≤ 156))]
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  have h : 208 * j + 52 = 52 * (4 * j + 1) := by ring
  rw [h]

theorem field52_2 (CBV j : Nat) :
    Nat.land (Nat.shiftRight (Nat.land (Nat.shiftRight CBV (Nat.mul 208 j))
        411376139330301510538742295639337626245683966408394965837152255) 104) 4503599627370495
      = slotW CBV (4 * j + 2) := by
  rw [slotW]
  show (((CBV >>> (208 * j)) &&& (2 ^ 208 - 1)) >>> 104) &&& (2 ^ 52 - 1)
      = (CBV >>> (52 * (4 * j + 2))) &&& (2 ^ 52 - 1)
  simp only [Nat.and_two_pow_sub_one_eq_mod, Nat.shiftRight_eq_div_pow]
  rw [show (2:Nat) ^ 208 = 2 ^ 104 * 2 ^ 104 by norm_num]
  rw [Nat.mod_mul_right_div_self]
  rw [Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 2 (by norm_num : 52 ≤ 104))]
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  have h : 208 * j + 104 = 52 * (4 * j + 2) := by ring
  rw [h]

theorem field52_3 (CBV j : Nat) :
    Nat.shiftRight (Nat.land (Nat.shiftRight CBV (Nat.mul 208 j))
        411376139330301510538742295639337626245683966408394965837152255) 156
      = slotW CBV (4 * j + 3) := by
  rw [slotW]
  show ((CBV >>> (208 * j)) &&& (2 ^ 208 - 1)) >>> 156
      = (CBV >>> (52 * (4 * j + 3))) &&& (2 ^ 52 - 1)
  simp only [Nat.and_two_pow_sub_one_eq_mod, Nat.shiftRight_eq_div_pow]
  rw [show (2:Nat) ^ 208 = 2 ^ 156 * 2 ^ 52 by norm_num]
  rw [Nat.mod_mul_right_div_self]
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  have h : 208 * j + 156 = 52 * (4 * j + 3) := by ring
  rw [h]

theorem leafX9_at {A8 CBV j : Nat} (h : leafX9 A8 CBV j = true) :
    ∀ r, r < 4 → tst7 (Nat.sub A8 (Nat.mul 8 (slotW CBV (4 * j + r)))) = true := by
  intro r hr
  simp only [leafX9] at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨h0, h1, h2, h3⟩ := h
  rw [field52_0] at h0
  rw [field52_1] at h1
  rw [field52_2] at h2
  rw [field52_3] at h3
  rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3) with rfl | rfl | rfl | rfl
  · exact h0
  · exact h1
  · exact h2
  · exact h3

theorem leafX9_sound {W CBV i x : Nat}
    (h : tst7 (Nat.sub (8*W+1) (Nat.mul 8 (slotW CBV i))) = true)
    (hval : slotW CBV i = c4 x) :
    ∀ w, t2 w + c4 x ≠ W := by
  intro w heq
  have ht := t2_ge_one w
  rw [hval] at h
  simp only [tst7] at h
  cases hb : Nat.ble (Nat.sub (8*W+1) (Nat.mul 8 (c4 x))) 1 with
  | true =>
    rw [Nat.ble_eq] at hb
    simp only [sub_eqn, mul_eqn] at hb
    omega
  | false =>
    rw [hb, cond_false] at h
    have hlt : ¬ (Nat.sub (8*W+1) (Nat.mul 8 (c4 x)) ≤ 1) := by
      rw [← Nat.ble_eq, hb]; simp
    simp only [sub_eqn, mul_eqn] at hlt
    have hv : Nat.sub (8*W+1) (Nat.mul 8 (c4 x)) = (2*w+3)*(2*w+3) := by
      simp only [sub_eqn, mul_eqn]
      have h8 := eight_t2 w
      have : t2 w = W - c4 x := by omega
      omega
    rw [hv] at h
    exact sqTest2_sound h (2*w+3) rfl

theorem xtreeOK9_sound {W : Nat} (h : xtreeOK9 W = true) : ∀ w x, t2 w + c4 x ≠ W := by
  intro w x heq
  have ht := t2_ge_one w
  have hh : xtreeOK9 W = true := h
  simp only [xtreeOK9, add_eqn, mul_eqn, mod_eqn] at hh
  rw [Bool.and_eq_true] at hh
  obtain ⟨hcap, hbr⟩ := hh
  rw [Nat.blt_eq] at hcap
  set a := (8*W+1) % 225 with hadef
  set f := fla a with hfdef
  have hc4W : c4 x < W := by omega
  have hx : x < 13500 := by
    by_contra hgt
    have : c4 13500 ≤ c4 x := c4_mono (by omega)
    omega
  set e := x % 2700 with hedef
  set k := x / 2700 with hkdef
  have helt : e < 2700 := by omega
  have hkb : k < 5 := by omega
  have ha : a < 225 := Nat.mod_lt _ (by norm_num)
  cases hcf : colFree a e with
  | true => exact colfree_case hcf hc4W w heq
  | false =>
    have hbs := comp_spec a ha e helt hcf
    obtain ⟨i, hi0, hilt, hslot⟩ := bsA_sound _ _ _ hbs
    have hilt2 : i < 2 ^ f := by
      rw [hfdef]
      simpa only [pow_eqn] using hilt
    have hslot' : slotC (cbof a) i = e := by
      rw [slotC]
      exact hslot
    have hxval : slotW (cbw k a) i = c4 x := by
      rw [link9_at ha (by rw [hfdef] at hilt2; exact hilt2) hslot' helt hkb]
      congr 1
      omega
    have hsort := sortA_sound (sortall_spec a ha)
    rw [← hfdef] at hsort
    have hb := allI2_sound _ _ _ hbr k (Nat.zero_le _) (by omega)
    simp only [branch9, add_eqn, pow_eqn, div_eqn] at hb
    rw [Bool.and_eq_true] at hb
    obtain ⟨hchk, htree⟩ := hb
    set i0 := cutW (cbw k a) W (f+2) 0 (2^f) with hi0def
    rcases Nat.lt_or_ge i i0 with hin | hout
    · have hj := allI2_sound _ _ _ htree (i / 4) (Nat.zero_le _) (by omega)
      have hcov := leafX9_at hj (i % 4) (by omega)
      have hidx : 4 * (i / 4) + i % 4 = i := by omega
      rw [hidx] at hcov
      exact leafX9_sound hcov hxval w heq
    · cases hq : Nat.beq i0 (2^f) with
      | true => rw [Nat.beq_eq] at hq; omega
      | false =>
        rw [hq, cond_false, Nat.blt_eq] at hchk
        have hs0 : slotC (cbof a) i0 ≤ slotC (cbof a) i := hsort i0 i hout hilt2
        have hs0lt : slotC (cbof a) i0 < 2700 := by
          rw [hslot'] at hs0; omega
        have hl0 := link9_at ha (by rw [← hfdef]; omega) rfl hs0lt hkb
        have hmono : slotW (cbw k a) i0 ≤ slotW (cbw k a) i := by
          rw [hl0, hxval]
          have : c4 (2700 * k + slotC (cbof a) i0) ≤ c4 (2700 * k + e) := by
            apply c4_mono
            rw [hslot'] at hs0
            omega
          have hxe : c4 x = c4 (2700 * k + e) := by congr 1; omega
          omega
        omega

theorem leafY9_sound {N r8 y : Nat} (h : leafY9 N r8 y = true) :
    ∀ w x, t2 w + c4 x + c6 y + r8 ≠ N := by
  intro w x heq
  have ht := t2_ge_one w
  cases hb : Nat.ble N (Nat.add r8 (c6 y)) with
  | true =>
    rw [Nat.ble_eq, add_eqn] at hb
    omega
  | false =>
    have hnb : ¬ (N ≤ r8 + c6 y) := by rw [← add_eqn, ← Nat.ble_eq, hb]; simp
    simp only [leafY9, hb, cond_false] at h
    have : t2 w + c4 x = Nat.sub N (Nat.add r8 (c6 y)) := by
      simp only [sub_eqn, add_eqn]; omega
    exact xtreeOK9_sound h w x this

theorem ytree9_parts {N fy r8 : Nat} (h1 : allB (leafY9 N r8) fy 0 = true)
    (h2 : Nat.ble N (Nat.add r8 (c6 (Nat.pow 2 fy))) = true) :
    ∀ w x y, t2 w + c4 x + c6 y + r8 ≠ N := by
  intro w x y heq
  rw [Nat.ble_eq, add_eqn] at h2
  have ht := t2_ge_one w
  rcases Nat.lt_or_ge y (2 ^ fy) with hy | hy
  · exact leafY9_sound (allB_sound _ 0 h1 y (Nat.zero_le _) (by omega)) w x heq
  · have hc : c6 (Nat.pow 2 fy) ≤ c6 y := by
      apply c6_mono; rw [pow_eqn]; exact hy
    omega

theorem leafZ9_sound {N fy z : Nat} (h : leafZ9 N fy z = true) :
    ∀ w x y, t2 w + c4 x + c6 y + c8 z ≠ N := by
  intro w x y heq
  have ht := t2_ge_one w
  cases hb : Nat.ble N (c8 z) with
  | true => rw [Nat.ble_eq] at hb; omega
  | false =>
    simp only [leafZ9, hb, cond_false, Bool.and_eq_true] at h
    exact ytree9_parts h.1 h.2 w x y heq

theorem master9 {N fy fz : Nat}
    (h : allB (leafZ9 N fy) fz 0 = true)
    (htop : Nat.ble N (c8 (Nat.pow 2 fz)) = true) :
    ∀ w x y z, t2 w + c4 x + c6 y + c8 z ≠ N := by
  intro w x y z heq
  have ht := t2_ge_one w
  rcases Nat.lt_or_ge z (2 ^ fz) with hz | hz
  · exact leafZ9_sound (allB_sound _ 0 h z (Nat.zero_le _) (by omega)) w x y heq
  · rw [Nat.ble_eq] at htop
    have hc : c8 (Nat.pow 2 fz) ≤ c8 z := by
      apply c8_mono; rw [pow_eqn]; exact hz
    omega

