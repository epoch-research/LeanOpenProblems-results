/-! ### Binary modular exponentiation (kernel-friendly) -/

def pm (m a : Nat) : Nat → Nat → Nat
  | 0, _ => 1 % m
  | fuel+1, e =>
    cond (Nat.beq e 0) (1 % m) <|
    cond (Nat.beq (e % 2) 1)
      (a * pm m ((a*a) % m) fuel (e/2) % m)
      (pm m ((a*a) % m) fuel (e/2))

theorem pm_sound (m : Nat) : ∀ fuel a e, e < 2^fuel → pm m a fuel e = a^e % m := by
  intro fuel
  induction fuel with
  | zero =>
    intro a e he
    have h0 : e = 0 := by simpa using he
    subst h0
    simp [pm]
  | succ f ih =>
    intro a e he
    rw [pm]
    cases h0 : Nat.beq e 0 with
    | true =>
      have : e = 0 := Nat.eq_of_beq_eq_true h0
      subst this
      simp
    | false =>
      have he0 : e ≠ 0 := Nat.ne_of_beq_eq_false h0
      simp only [h0, cond_false]
      have hdiv : e/2 < 2^f := by
        have h2f : 2^(f+1) = 2*2^f := by rw [Nat.pow_succ]; ring
        omega
      have hrec := ih ((a*a) % m) (e/2) hdiv
      have hpowmod : ((a*a) % m)^(e/2) % m = (a*a)^(e/2) % m := (Nat.pow_mod _ _ _).symm
      set k := e/2 with hk
      cases h1 : Nat.beq (e % 2) 1 with
      | false =>
        simp only [h1, cond_false]
        rw [hrec, hpowmod]
        have h2 : e % 2 = 0 := by
          have := Nat.ne_of_beq_eq_false h1
          omega
        have hae : a^e = (a*a)^k := by
          have hek : e = 2*k := by omega
          rw [hek, Nat.pow_mul, Nat.pow_two]
        rw [hae]
      | true =>
        simp only [h1, cond_true]
        rw [hrec, hpowmod]
        have h2 : e % 2 = 1 := Nat.eq_of_beq_eq_true h1
        have hek : e = 2*k + 1 := by omega
        have hmm : a * ((a*a)^k % m) % m = a * (a*a)^k % m := by
          conv_lhs => rw [Nat.mul_mod]
          conv_rhs => rw [Nat.mul_mod]
          rw [Nat.mod_mod_of_dvd _ (dvd_refl m)]
        rw [hmm]
        congr 1
        rw [hek]
        rw [Nat.pow_succ' (n := 2*k)]
        congr 1
        rw [Nat.pow_mul, Nat.pow_two]

/-! ### Bridging Nat modular arithmetic to ZMod -/

theorem cast_pow_eq_one {p a e : Nat} (h : a^e % p = 1 % p) : (a : ZMod p)^e = 1 := by
  have h2 : ((a^e : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) :=
    (ZMod.natCast_eq_natCast_iff' _ _ _).mpr h
  push_cast at h2
  exact h2

theorem cast_pow_ne_one {p a e : Nat} (h : ¬(a^e % p = 1 % p)) : (a : ZMod p)^e ≠ 1 := by
  intro hc
  apply h
  apply (ZMod.natCast_eq_natCast_iff' (a^e) 1 p).mp
  push_cast
  exact hc

/-! ### Pratt certificates -/

def prodPows : List (Nat × Nat) → Nat
  | [] => 1
  | qe :: t => qe.1 ^ qe.2 * prodPows t

def Fprimes : List (Nat × Nat) → Prop
  | [] => True
  | qe :: t => Nat.Prime qe.1 ∧ Fprimes t

def pchk (p a : Nat) (F : List (Nat × Nat)) : Bool :=
  Nat.blt 1 p &&
  (Nat.blt (p-1) (2^64) &&
  (Nat.beq (prodPows F) (p-1) &&
  (Nat.beq (pm p (a % p) 64 (p-1)) (1 % p) &&
   F.all (fun qe => !(Nat.beq (pm p (a % p) 64 ((p-1)/qe.1)) (1 % p))))))

theorem prime_mem_of_dvd_prodPows {q : Nat} (hq : q.Prime) :
    ∀ {F : List (Nat × Nat)}, Fprimes F → q ∣ prodPows F → ∃ qe ∈ F, qe.1 = q := by
  intro F
  induction F with
  | nil =>
    intro _ hd
    rw [prodPows] at hd
    exact absurd (Nat.dvd_one.mp hd) hq.ne_one
  | cons qe t ih =>
    intro hF hd
    rw [prodPows] at hd
    rcases (Nat.Prime.dvd_mul hq).mp hd with h | h
    · have h2 : q ∣ qe.1 := hq.dvd_of_dvd_pow h
      have h3 : q = qe.1 := (Nat.prime_dvd_prime_iff_eq hq hF.1).mp h2
      exact ⟨qe, List.mem_cons_self, h3.symm⟩
    · obtain ⟨qe', hm, hh⟩ := ih hF.2 h
      exact ⟨qe', List.mem_cons_of_mem _ hm, hh⟩

theorem pchk_sound (p a : Nat) (F : List (Nat × Nat)) (hF : Fprimes F)
    (h : pchk p a F = true) : Nat.Prime p := by
  unfold pchk at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  rw [Nat.blt_eq] at h1 h2
  have hprod : prodPows F = p - 1 := Nat.eq_of_beq_eq_true h3
  have hmain : a^(p-1) % p = 1 % p := by
    rw [Nat.pow_mod, ← pm_sound p 64 (a % p) (p-1) h2]
    exact Nat.eq_of_beq_eq_true h4
  apply lucas_primality p (a : ZMod p) (cast_pow_eq_one hmain)
  intro q hq hqd
  rw [← hprod] at hqd
  obtain ⟨qe, hmem, rfl⟩ := prime_mem_of_dvd_prodPows hq hF hqd
  have h5' := (List.all_eq_true.mp h5) qe hmem
  rw [Bool.not_eq_true'] at h5'
  have hne : pm p (a % p) 64 ((p-1)/qe.1) ≠ 1 % p := by
    intro hcon
    rw [hcon] at h5'
    simp at h5'
  have hlt : (p-1)/qe.1 < 2^64 := Nat.lt_of_le_of_lt (Nat.div_le_self _ _) h2
  apply cast_pow_ne_one
  intro hcon
  apply hne
  rw [pm_sound p 64 (a % p) _ hlt, ← Nat.pow_mod]
  exact hcon

/-! ### -3 is not a square mod p when p ≡ 2 mod 3, p odd prime -/

theorem not_sq_neg3 {p : Nat} (hp : p.Prime) (h3 : p % 3 = 2) (h2 : p % 2 = 1) :
    ¬ IsSquare (-3 : ZMod p) := by
  haveI : Fact p.Prime := ⟨hp⟩
  rintro ⟨r, hr⟩
  have hp2 : (2 : ZMod p) ≠ 0 := by
    intro h0
    have hc : ((2:ℕ) : ZMod p) = 0 := by exact_mod_cast h0
    have hd := (ZMod.natCast_eq_zero_iff 2 p).mp hc
    have hle := Nat.le_of_dvd (by norm_num) hd
    have h2le := hp.two_le
    omega
  set ω : ZMod p := (r - 1) * (2 : ZMod p)⁻¹ with hω
  have h2inv : (2:ZMod p) * (2:ZMod p)⁻¹ = 1 := mul_inv_cancel₀ hp2
  have h2ω : 2 * ω = r - 1 := by
    rw [hω]
    calc (2:ZMod p) * ((r - 1) * (2:ZMod p)⁻¹)
        = (r-1) * ((2:ZMod p) * (2:ZMod p)⁻¹) := by ring
      _ = r - 1 := by rw [h2inv, mul_one]
  have hkey : ω^2 + ω + 1 = 0 := by
    have h4 : (2:ZMod p) * 2 * (ω^2 + ω + 1) = (2*ω+1)^2 + 3 := by ring
    have h5 : (2*ω+1) = r := by rw [h2ω]; ring
    have h6 : (2:ZMod p) * 2 * (ω^2+ω+1) = 0 := by
      rw [h4, h5, sq, ← hr]; ring
    rcases mul_eq_zero.mp h6 with h | h
    · exact absurd h (mul_ne_zero hp2 hp2)
    · exact h
  have hω1 : ω ≠ 1 := by
    intro h1
    rw [h1] at hkey
    have h30 : (3 : ZMod p) = 0 := by linear_combination hkey
    have hc : ((3:ℕ) : ZMod p) = 0 := by exact_mod_cast h30
    have hd := (ZMod.natCast_eq_zero_iff 3 p).mp hc
    have hle := Nat.le_of_dvd (by norm_num) hd
    have h2le := hp.two_le
    omega
  have hω3 : ω^3 = 1 := by
    have h7 : ω^3 - 1 = (ω - 1)*(ω^2+ω+1) := by ring
    have h8 : ω^3 - 1 = 0 := by rw [h7, hkey, mul_zero]
    exact sub_eq_zero.mp h8
  have hω0 : ω ≠ 0 := by
    intro h0
    rw [h0] at hω3
    simp at hω3
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hord : orderOf ω = 3 := orderOf_eq_prime hω3 hω1
  have hfer : ω^(p-1) = 1 := ZMod.pow_card_sub_one_eq_one hω0
  have hdvd : 3 ∣ p - 1 := by
    rw [← hord]
    exact orderOf_dvd_of_pow_eq_one hfer
  obtain ⟨k, hk⟩ := hdvd
  have h2le := hp.two_le
  omega

/-! ### Descent: if v_p(M) is odd for inert p then 3s²+v² ≠ M -/

theorem inert_step {p : Nat} (hp : p.Prime) (h3 : p % 3 = 2) (h2 : p % 2 = 1)
    {M s v : Nat} (hM : p ∣ M) (heq : 3*s*s + v*v = M) : p ∣ s ∧ p ∣ v := by
  haveI : Fact p.Prime := ⟨hp⟩
  by_cases hs : p ∣ s
  · refine ⟨hs, ?_⟩
    have h3s : p ∣ 3*s*s := Dvd.dvd.mul_left hs (3*s)
    have h3le : 3*s*s ≤ M := by omega
    have hvv : p ∣ v*v := by
      have hsub : v*v = M - 3*s*s := by omega
      rw [hsub]
      exact Nat.dvd_sub hM h3s
    exact ((Nat.Prime.dvd_mul hp).mp hvv).elim id id
  · exfalso
    apply not_sq_neg3 hp h3 h2
    have hM0 : ((M : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff M p).mpr hM
    have hc : (3 : ZMod p)*(s:ZMod p)*(s:ZMod p) + (v:ZMod p)*(v:ZMod p) = 0 := by
      have hcast : ((3*s*s + v*v : ℕ) : ZMod p) = 0 := by rw [heq]; exact hM0
      push_cast at hcast
      exact hcast
    have hsne : (s : ZMod p) ≠ 0 := fun h0 => hs ((ZMod.natCast_eq_zero_iff s p).mp h0)
    have hss : (s:ZMod p) * (s:ZMod p)⁻¹ = 1 := mul_inv_cancel₀ hsne
    refine ⟨(v:ZMod p) * (s:ZMod p)⁻¹, ?_⟩
    have hv2 : (v:ZMod p)*(v:ZMod p) = -3 * ((s:ZMod p)*(s:ZMod p)) := by
      linear_combination hc
    calc (-3 : ZMod p)
        = -3 * (((s:ZMod p) * (s:ZMod p)⁻¹) * ((s:ZMod p) * (s:ZMod p)⁻¹)) := by
          rw [hss]; ring
      _ = ((v:ZMod p)*(v:ZMod p)) * ((s:ZMod p)⁻¹ * (s:ZMod p)⁻¹) := by
          rw [hv2]; ring
      _ = ((v:ZMod p) * (s:ZMod p)⁻¹) * ((v:ZMod p) * (s:ZMod p)⁻¹) := by ring

theorem inert_key {p : Nat} (hp : p.Prime) (h3 : p % 3 = 2) (h2 : p % 2 = 1) :
    ∀ j M s v, p^(2*j+1) ∣ M → ¬ p^(2*j+2) ∣ M → 3*s*s + v*v ≠ M := by
  intro j
  induction j with
  | zero =>
    intro M s v h1 h1n heq
    have hpM : p ∣ M := by
      have h1' := h1
      norm_num at h1'
      exact h1'
    obtain ⟨hs, hv⟩ := inert_step hp h3 h2 hpM heq
    obtain ⟨s', rfl⟩ := hs
    obtain ⟨v', rfl⟩ := hv
    apply h1n
    refine ⟨3*s'*s' + v'*v', ?_⟩
    rw [← heq]
    ring
  | succ j ih =>
    intro M s v h1 h1n heq
    have hpM : p ∣ M := dvd_trans (dvd_pow_self p (by omega : 2*(j+1)+1 ≠ 0)) h1
    obtain ⟨hs, hv⟩ := inert_step hp h3 h2 hpM heq
    obtain ⟨s', rfl⟩ := hs
    obtain ⟨v', rfl⟩ := hv
    have hppos : 0 < p^2 := pow_pos hp.pos 2
    have hM' : M = p^2 * (3*s'*s' + v'*v') := by rw [← heq]; ring
    apply ih (3*s'*s' + v'*v') s' v' ?_ ?_ rfl
    · have hstep : p^2 * p^(2*j+1) ∣ p^2 * (3*s'*s'+v'*v') := by
        rw [← hM', ← pow_add]
        have hee : 2 + (2*j+1) = 2*(j+1)+1 := by ring
        rw [hee]
        exact h1
      exact (Nat.mul_dvd_mul_iff_left hppos).mp hstep
    · intro hc
      apply h1n
      rw [hM']
      have hee : p^(2*(j+1)+2) = p^2 * p^(2*j+2) := by
        rw [← pow_add]
        congr 1
        ring
      rw [hee]
      exact Nat.mul_dvd_mul_left _ hc

/-! ### 24·C(x+3,4)+1 is a perfect square -/

theorem quart24 (x : Nat) : 24 * ((x+3).choose 4) + 1 = (x*x + 3*x + 1) * (x*x + 3*x + 1) := by
  have h1 : (x+3).descFactorial 4 = 24 * ((x+3).choose 4) := by
    rw [Nat.descFactorial_eq_factorial_mul_choose]
    norm_num [Nat.factorial]
  have h2 : (x+3).descFactorial 4 = x*(x+1)*(x+2)*(x+3) := by
    simp only [Nat.descFactorial]
    have e3 : x+3-3 = x := by omega
    have e2 : x+3-2 = x+1 := by omega
    have e1 : x+3-1 = x+2 := by omega
    have e0 : x+3-0 = x+3 := by omega
    rw [e3, e2, e1, e0]
    ring
  have h3 : 24*((x+3).choose 4) = x*(x+1)*(x+2)*(x+3) := by rw [← h1, h2]
  calc 24 * ((x+3).choose 4) + 1 = x*(x+1)*(x+2)*(x+3) + 1 := by rw [h3]
    _ = (x*x+3*x+1)*(x*x+3*x+1) := by ring

/-! ### Inert-prime certificate check for one (z,y) pair -/

def ichk (n z y p j : Nat) : Bool :=
  Nat.beq (p % 3) 2 &&
  (Nat.beq (p % 2) 1 &&
  (Nat.beq ((24*(n - (c6v (y+5) + c8v (z+7))) + 4) % p^(2*j+1)) 0 &&
   !(Nat.beq ((24*(n - (c6v (y+5) + c8v (z+7))) + 4) % p^(2*j+2)) 0)))

theorem ichk_sound {n z y p j : Nat} (hp : p.Prime) (h : ichk n z y p j = true) :
    ∀ x w, (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  unfold ichk at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨h3, h2, hd1, hd2⟩ := h
  intro x w heq
  have h3' : p % 3 = 2 := Nat.eq_of_beq_eq_true h3
  have h2' : p % 2 = 1 := Nat.eq_of_beq_eq_true h2
  set cd := c6v (y+5) + c8v (z+7) with hcd
  have hyz : (y+5).choose 6 + (z+7).choose 8 = cd := by rw [hcd, c6v_eq, c8v_eq]
  have hM1 : p^(2*j+1) ∣ 24*(n-cd)+4 := Nat.dvd_of_mod_eq_zero (Nat.eq_of_beq_eq_true hd1)
  have hM2 : ¬ p^(2*j+2) ∣ 24*(n-cd)+4 := by
    intro hdd
    obtain ⟨c, hc⟩ := hdd
    rw [hc, Nat.mul_mod_right] at hd2
    simp at hd2
  have t8 := tri8 w
  have q24 := quart24 x
  have hMM : 3*(2*w+3)*(2*w+3) + (x*x+3*x+1)*(x*x+3*x+1) = 24*(n-cd)+4 := by
    have hg : 3*(2*w+3)*(2*w+3) = 3*((2*w+3)*(2*w+3)) := by ring
    rw [hg]
    generalize hA : (2*w+3)*(2*w+3) = A at t8 ⊢
    generalize hB : (x*x+3*x+1)*(x*x+3*x+1) = B at q24 ⊢
    omega
  exact inert_key hp h3' h2' j (24*(n-cd)+4) (2*w+3) (x*x+3*x+1) hM1 hM2 hMM

/-! ### Prime table lookup -/

def getP (tp i : Nat) : Nat := (tp >>> (48*i)) &&& 0xffffffffffff

/-! ### Unified per-y record check: scan (tag 1) or inert cert (tag 0) -/

def urec (n z xcnt tp tlen y W : Nat) : Bool :=
  cond (Nat.beq (W &&& 1) 1)
    (chkPair n z xcnt y (W >>> 1))
    (Nat.blt (W >>> 9) tlen && ichk n z y (getP tp (W >>> 9)) ((W >>> 1) &&& 255))

theorem urec_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {tp tlen : Nat} (HT : ∀ i, i < tlen → Nat.Prime (getP tp i))
    {n z xcnt y W : Nat} (h : urec n z xcnt tp tlen y W = true) :
    ∀ x w, (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  unfold urec at h
  rcases htag : Nat.beq (W &&& 1) 1 with _ | _
  · rw [htag, cond_false, Bool.and_eq_true] at h
    have hlt : (W >>> 9) < tlen := by
      have := h.1
      rwa [Nat.blt_eq] at this
    exact ichk_sound (HT _ hlt) h.2
  · rw [htag, cond_true] at h
    exact chkPair_sound hM1 hM25 hM17 hM19 hM23 hM29 h

/-! ### Unified balanced block check over a y-range -/

def uchk (n z xcnt L tp tlen : Nat) : Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _ => false
  | fuel+1, y, cnt, W =>
    cond (Nat.beq cnt 0) true <|
    cond (Nat.beq cnt 1) (urec n z xcnt tp tlen y W) <|
    (uchk n z xcnt L tp tlen fuel y (cnt/2) (W &&& (1 <<< (L * (cnt/2)) - 1)) &&
     uchk n z xcnt L tp tlen fuel (y + cnt/2) (cnt - cnt/2) (W >>> (L * (cnt/2))))

theorem uchk_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {tp tlen : Nat} (HT : ∀ i, i < tlen → Nat.Prime (getP tp i))
    {n z xcnt L : Nat} : ∀ fuel y cnt W, uchk n z xcnt L tp tlen fuel y cnt W = true →
    ∀ j, j < cnt → ∀ x w,
      (w+2).choose 2 + (x+3).choose 4 + (y+j+5).choose 6 + (z+7).choose 8 ≠ n := by
  intro fuel
  induction fuel with
  | zero => intro y cnt W h; simp [uchk] at h
  | succ fuel ih =>
    intro y cnt W h j hj
    unfold uchk at h
    rcases hc0 : Nat.beq cnt 0 with _ | _
    · rcases hc1 : Nat.beq cnt 1 with _ | _
      · simp only [hc0, hc1, cond_false] at h
        rw [Bool.and_eq_true] at h
        rcases Nat.lt_or_ge j (cnt/2) with hj2 | hj2
        · exact ih y (cnt/2) _ h.1 j hj2
        · have := ih (y + cnt/2) (cnt - cnt/2) _ h.2 (j - cnt/2) (by omega)
          rwa [show y + cnt/2 + (j - cnt/2) = y + j by omega] at this
      · simp only [hc0, hc1, cond_false, cond_true] at h
        have hc : cnt = 1 := Nat.eq_of_beq_eq_true hc1
        have hj0 : j = 0 := by omega
        subst hj0
        rw [Nat.add_zero]
        exact urec_sound hM1 hM25 hM17 hM19 hM23 hM29 HT h
    · have : cnt = 0 := Nat.eq_of_beq_eq_true hc0
      omega



set_option linter.unusedVariables false


/-! ### Square filter chain for a single value u (masks then witnesses) -/

def sq1 (u ent : Nat) : Bool :=
  cond (bitset M1v (u % 45045))
   (cond (bitset M25v (u % 25))
    (cond (bitset M17v (u % 17))
     (cond (bitset M19v (u % 19))
      (cond (bitset M23v (u % 23))
       (cond (bitset M29v (u % 29))
        (entChk u 4096 ent)
        true) true) true) true) true)
   true

theorem sq1_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {u ent : Nat} (h : sq1 u ent = true) : ∀ s, s*s ≠ u := by
  intro s heq
  subst heq
  unfold sq1 at h
  rw [hM1 s, cond_true, hM25 s, cond_true, hM17 s, cond_true, hM19 s, cond_true,
      hM23 s, cond_true, hM29 s, cond_true] at h
  exact entChk_sound 4096 _ h s rfl

/-! ### Sequential x-scan with incremental binomials -/

def scf (U0 ent : Nat) : Nat → Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _, _ => true
  | fuel+1, b4, b3, b2, b1 =>
    sq1 (8*(U0 - b4) + 1) ent && scf U0 ent fuel (b4+b3) (b3+b2) (b2+b1) (b1+1)

theorem scf_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {U0 ent : Nat} : ∀ fuel x,
    scf U0 ent fuel ((x+3).choose 4) ((x+3).choose 3) ((x+3).choose 2) (x+3) = true →
    ∀ i, i < fuel → ∀ w, (w+2).choose 2 + (x+i+3).choose 4 ≠ U0 := by
  intro fuel
  induction fuel with
  | zero => intro x h i hi; omega
  | succ fuel ih =>
    intro x h i hi
    rw [scf, Bool.and_eq_true] at h
    obtain ⟨h1, h2⟩ := h
    rcases Nat.eq_zero_or_pos i with rfl | hipos
    · intro w heq
      rw [show x+0+3 = x+3 by omega] at heq
      have hle : (x+3).choose 4 ≤ U0 := by
        have := Nat.choose_pos (show 2 ≤ w+2 by omega)
        omega
      have hu : (2*w+3)*(2*w+3) = 8*(U0 - (x+3).choose 4) + 1 := by
        rw [← tri8 w]
        omega
      exact sq1_sound hM1 hM25 hM17 hM19 hM23 hM29 h1 (2*w+3) hu
    · have hp4 : (x+3).choose 4 + (x+3).choose 3 = (x+1+3).choose 4 := by
        have e := Nat.choose_succ_succ' (x+3) 3
        simp only [show x+3+1 = x+1+3 by omega] at e
        norm_num at e
        omega
      have hp3 : (x+3).choose 3 + (x+3).choose 2 = (x+1+3).choose 3 := by
        have e := Nat.choose_succ_succ' (x+3) 2
        simp only [show x+3+1 = x+1+3 by omega] at e
        norm_num at e
        omega
      have hp2 : (x+3).choose 2 + (x+3) = (x+1+3).choose 2 := by
        have e := Nat.choose_succ_succ' (x+3) 1
        simp only [show x+3+1 = x+1+3 by omega] at e
        norm_num at e
        have h1r : (x+3).choose 1 = x+3 := Nat.choose_one_right _
        omega
      have hp1 : (x+3) + 1 = (x+1)+3 := by omega
      rw [hp4, hp3, hp2, hp1] at h2
      have := ih (x+1) h2 (i-1) (by omega)
      intro w heq
      apply this w
      rwa [show x+1+(i-1)+3 = x+i+3 by omega]

/-! ### Fast pair check -/

def chkPairF (n z xcnt y ent : Nat) : Bool :=
  let cd := c6v (y+5) + c8v (z+7)
  Nat.ble n (cd + c4v (xcnt+3)) && scf (n - cd) ent xcnt 0 1 3 3

theorem chkPairF_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {n z xcnt y ent : Nat} (h : chkPairF n z xcnt y ent = true) :
    ∀ x w, (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  unfold chkPairF at h
  rw [Bool.and_eq_true] at h
  obtain ⟨hbnd, hscf⟩ := h
  have hscf' : scf (n - (c6v (y+5) + c8v (z+7))) ent xcnt
      ((0+3).choose 4) ((0+3).choose 3) ((0+3).choose 2) (0+3) = true := by
    have e4 : (0+3).choose 4 = 0 := by decide
    have e3 : (0+3).choose 3 = 1 := by decide
    have e2 : (0+3).choose 2 = 3 := by decide
    rw [e4, e3, e2]
    exact hscf
  intro x w heq
  set cd := c6v (y+5) + c8v (z+7) with hcd
  have hyz : (y+5).choose 6 + (z+7).choose 8 = cd := by rw [hcd, c6v_eq, c8v_eq]
  rcases Nat.lt_or_ge x xcnt with hx | hx
  · have hl := scf_sound hM1 hM25 hM17 hM19 hM23 hM29 xcnt 0 hscf' x hx w
    rw [Nat.zero_add] at hl
    apply hl
    omega
  · rw [Nat.ble_eq] at hbnd
    have hmono : c4v (xcnt+3) ≤ c4v (x+3) := c4v_mono (by omega)
    have hT : 0 < (w+2).choose 2 := Nat.choose_pos (by omega)
    rw [c4v_eq (x+3)] at heq
    omega

/-! ### Fast unified record / block checks -/

def urecF (n z tp tlen y W : Nat) : Bool :=
  cond (Nat.beq (W &&& 1) 1)
    (chkPairF n z ((W >>> 1) &&& 16383) y (W >>> 15))
    (Nat.blt (W >>> 9) tlen && ichk n z y (getP tp (W >>> 9)) ((W >>> 1) &&& 255))

theorem urecF_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {tp tlen : Nat} (HT : ∀ i, i < tlen → Nat.Prime (getP tp i))
    {n z y W : Nat} (h : urecF n z tp tlen y W = true) :
    ∀ x w, (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  unfold urecF at h
  rcases htag : Nat.beq (W &&& 1) 1 with _ | _
  · rw [htag, cond_false, Bool.and_eq_true] at h
    have hlt : (W >>> 9) < tlen := by
      have := h.1
      rwa [Nat.blt_eq] at this
    exact ichk_sound (HT _ hlt) h.2
  · rw [htag, cond_true] at h
    exact chkPairF_sound hM1 hM25 hM17 hM19 hM23 hM29 h

def uchkF (n z L tp tlen : Nat) : Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _ => false
  | fuel+1, y, cnt, W =>
    cond (Nat.beq cnt 0) true <|
    cond (Nat.beq cnt 1) (urecF n z tp tlen y W) <|
    (uchkF n z L tp tlen fuel y (cnt/2) (W &&& (1 <<< (L * (cnt/2)) - 1)) &&
     uchkF n z L tp tlen fuel (y + cnt/2) (cnt - cnt/2) (W >>> (L * (cnt/2))))

theorem uchkF_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {tp tlen : Nat} (HT : ∀ i, i < tlen → Nat.Prime (getP tp i))
    {n z L : Nat} : ∀ fuel y cnt W, uchkF n z L tp tlen fuel y cnt W = true →
    ∀ j, j < cnt → ∀ x w,
      (w+2).choose 2 + (x+3).choose 4 + (y+j+5).choose 6 + (z+7).choose 8 ≠ n := by
  intro fuel
  induction fuel with
  | zero => intro y cnt W h; simp [uchkF] at h
  | succ fuel ih =>
    intro y cnt W h j hj
    unfold uchkF at h
    rcases hc0 : Nat.beq cnt 0 with _ | _
    · rcases hc1 : Nat.beq cnt 1 with _ | _
      · simp only [hc0, hc1, cond_false] at h
        rw [Bool.and_eq_true] at h
        rcases Nat.lt_or_ge j (cnt/2) with hj2 | hj2
        · exact ih y (cnt/2) _ h.1 j hj2
        · have := ih (y + cnt/2) (cnt - cnt/2) _ h.2 (j - cnt/2) (by omega)
          rwa [show y + cnt/2 + (j - cnt/2) = y + j by omega] at this
      · simp only [hc0, hc1, cond_false, cond_true] at h
        have hc : cnt = 1 := Nat.eq_of_beq_eq_true hc1
        have hj0 : j = 0 := by omega
        subst hj0
        rw [Nat.add_zero]
        exact urecF_sound hM1 hM25 hM17 hM19 hM23 hM29 HT h
    · have : cnt = 0 := Nat.eq_of_beq_eq_true hc0
      omega

theorem uchkF_sound2
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {tp tlen : Nat} (HT : ∀ i, i < tlen → Nat.Prime (getP tp i))
    {n z L : Nat} (fuel y0 cnt W : Nat)
    (h : uchkF n z L tp tlen fuel y0 cnt W = true)
    (y : Nat) (hlo : y0 ≤ y) (hhi : y < y0 + cnt) :
    ∀ x w, (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  intro x w
  have hs := uchkF_sound hM1 hM25 hM17 hM19 hM23 hM29 HT fuel y0 cnt W h (y - y0) (by omega) x w
  rwa [show y0 + (y - y0) + 5 = y + 5 by omega] at hs



