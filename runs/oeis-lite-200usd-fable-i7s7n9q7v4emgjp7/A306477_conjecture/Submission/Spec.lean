/-! ### Product formulas for binomial coefficients (kernel-fast) -/

def c4v (x : Nat) : Nat := x*(x-1)*(x-2)*(x-3)/24
def c6v (y : Nat) : Nat := y*(y-1)*(y-2)*(y-3)*(y-4)*(y-5)/720
def c8v (z : Nat) : Nat := z*(z-1)*(z-2)*(z-3)*(z-4)*(z-5)*(z-6)*(z-7)/40320

theorem c4v_eq (x : Nat) : x.choose 4 = c4v x := by
  rw [Nat.choose_eq_descFactorial_div_factorial]
  simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, c4v]
  norm_num
  ring_nf

theorem c6v_eq (y : Nat) : y.choose 6 = c6v y := by
  rw [Nat.choose_eq_descFactorial_div_factorial]
  simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, c6v]
  norm_num
  ring_nf

theorem c8v_eq (z : Nat) : z.choose 8 = c8v z := by
  rw [Nat.choose_eq_descFactorial_div_factorial]
  simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, c8v]
  norm_num
  ring_nf

/-! ### Triangular squeeze -/

theorem tri8 (w : Nat) : 8 * ((w+2).choose 2) + 1 = (2*w+3)*(2*w+3) := by
  rw [Nat.choose_two_right]
  obtain ⟨r, hr⟩ := Nat.even_mul_succ_self (w+1)
  have h1 : (w+2) * (w+2-1) = r + r := by
    rw [show w+2-1 = w+1 from rfl, Nat.mul_comm]; exact hr
  rw [h1]
  have h2 : (r + r)/2 = r := by omega
  rw [h2]
  nlinarith [hr]

def nsq (u k : Nat) : Bool := Nat.blt (k*k) u && Nat.blt u ((k+1)*(k+1))

theorem nsq_sound {u k : Nat} (h : nsq u k = true) (s : Nat) : s*s ≠ u := by
  unfold nsq at h
  rw [Bool.and_eq_true, Nat.blt_eq, Nat.blt_eq] at h
  obtain ⟨h1, h2⟩ := h
  intro he
  subst he
  have hk : k < s := by
    by_contra hle
    exact absurd (Nat.mul_le_mul (Nat.le_of_not_lt hle) (Nat.le_of_not_lt hle)) (Nat.not_le_of_lt h1)
  have : (k+1)*(k+1) ≤ s*s := Nat.mul_le_mul hk hk
  omega


/-! ### Generic balanced Boolean range check -/

def ball (f : Nat → Bool) : Nat → Nat → Nat → Bool
  | 0, _, _ => false
  | fuel+1, lo, cnt =>
    cond (Nat.beq cnt 0) true <|
    cond (Nat.beq cnt 1) (f lo) <|
    (ball f fuel lo (cnt/2) && ball f fuel (lo + cnt/2) (cnt - cnt/2))

theorem ball_sound {f : Nat → Bool} : ∀ fuel lo cnt, ball f fuel lo cnt = true →
    ∀ j, j < cnt → f (lo + j) = true := by
  intro fuel
  induction fuel with
  | zero => intro lo cnt h; simp [ball] at h
  | succ fuel ih =>
    intro lo cnt h j hj
    unfold ball at h
    rcases hc0 : Nat.beq cnt 0 with _ | _
    · rcases hc1 : Nat.beq cnt 1 with _ | _
      · simp only [hc0, hc1, cond_false] at h
        rw [Bool.and_eq_true] at h
        rcases Nat.lt_or_ge j (cnt/2) with hj2 | hj2
        · exact ih lo (cnt/2) h.1 j hj2
        · have := ih (lo + cnt/2) (cnt - cnt/2) h.2 (j - cnt/2) (by omega)
          rwa [show lo + cnt/2 + (j - cnt/2) = lo + j by omega] at this
      · simp only [hc0, hc1, cond_false, cond_true] at h
        have : cnt = 1 := Nat.eq_of_beq_eq_true hc1
        have : j = 0 := by omega
        subst this
        simpa using h
    · have : cnt = 0 := Nat.eq_of_beq_eq_true hc0
      omega

/-! ### Bit-mask square filters -/

def bitset (m r : Nat) : Bool := Nat.beq (Nat.land (m >>> r) 1) 1

/-! ### Witness entry scan: entries are 24-bit sqrt witnesses packed in `es` -/

def entChk (u : Nat) : Nat → Nat → Bool
  | 0, _ => false
  | fuel+1, es =>
    cond (Nat.beq es 0) false <|
    (nsq u (es &&& 268435455) || entChk u fuel (es >>> 28))

theorem entChk_sound {u : Nat} : ∀ fuel es, entChk u fuel es = true → ∀ s, s*s ≠ u := by
  intro fuel
  induction fuel with
  | zero => intro es h; simp [entChk] at h
  | succ fuel ih =>
    intro es h s
    unfold entChk at h
    rcases he : Nat.beq es 0 with _ | _
    · simp only [he, cond_false] at h
      rw [Bool.or_eq_true] at h
      rcases h with h | h
      · exact nsq_sound h s
      · exact ih _ h s
    · simp [he] at h


/-! ### Square-filter masks: bit r of Mm set iff r is a square mod m -/

def M1v : Nat := 
def M25v : Nat := 0x1294a53
def M17v : Nat := 0x1a317
def M19v : Nat := 0x30af3
def M23v : Nat := 0x5335f
def M29v : Nat := 0x13d122f3

theorem mask_sound {M m : Nat} (hm : 0 < m)
    (hb : ball (fun s => bitset M ((s*s) % m)) 32 0 m = true) :
    ∀ s : Nat, bitset M ((s*s) % m) = true := by
  intro s
  have h := ball_sound 32 0 m hb (s % m) (Nat.mod_lt _ hm)
  rw [Nat.zero_add] at h
  rw [Nat.mul_mod]
  exact h

/-! ### Monotonicity helper -/

theorem c4v_mono {a b : Nat} (h : a ≤ b) : c4v a ≤ c4v b := by
  rw [← c4v_eq, ← c4v_eq]
  exact Nat.choose_le_choose 4 h

/-! ### Leaf check for one (pair, x-index) -/

def leafX (n cd ent i : Nat) : Bool :=
  let b := c4v (i+3)
  cond (Nat.ble n (cd + b)) true <|
  (let u := 8*(n - (cd + b)) + 1
   cond (bitset M1v (u % 45045))
    (cond (bitset M25v (u % 25))
     (cond (bitset M17v (u % 17))
      (cond (bitset M19v (u % 19))
       (cond (bitset M23v (u % 23))
        (cond (bitset M29v (u % 29))
         (entChk u 4096 ent)
         true) true) true) true) true)
    true)

theorem leafX_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {n cd ent i : Nat} (h : leafX n cd ent i = true) :
    ∀ w, (w+2).choose 2 + (c4v (i+3) + cd) ≠ n := by
  intro w heq
  simp only [leafX] at h
  by_cases hble : n ≤ cd + c4v (i+3)
  · have hT : 0 < (w+2).choose 2 := Nat.choose_pos (by omega)
    omega
  · have hble' : Nat.ble n (cd + c4v (i+3)) = false := by
      rw [← Bool.not_eq_true, Nat.ble_eq]; exact hble
    rw [hble'] at h
    simp only [cond_false] at h
    have hu : (2*w+3)*(2*w+3) = 8*(n - (cd + c4v (i+3))) + 1 := by
      rw [← tri8 w]; omega
    set u := 8*(n - (cd + c4v (i+3))) + 1 with hudef
    rcases h1 : bitset M1v (u % 45045) with _ | _
    · have := hM1 (2*w+3); rw [hu] at this; rw [h1] at this; exact Bool.false_ne_true this
    rw [h1, cond_true] at h
    rcases h2 : bitset M25v (u % 25) with _ | _
    · have := hM25 (2*w+3); rw [hu] at this; rw [h2] at this; exact Bool.false_ne_true this
    rw [h2, cond_true] at h
    rcases h3 : bitset M17v (u % 17) with _ | _
    · have := hM17 (2*w+3); rw [hu] at this; rw [h3] at this; exact Bool.false_ne_true this
    rw [h3, cond_true] at h
    rcases h4 : bitset M19v (u % 19) with _ | _
    · have := hM19 (2*w+3); rw [hu] at this; rw [h4] at this; exact Bool.false_ne_true this
    rw [h4, cond_true] at h
    rcases h5 : bitset M23v (u % 23) with _ | _
    · have := hM23 (2*w+3); rw [hu] at this; rw [h5] at this; exact Bool.false_ne_true this
    rw [h5, cond_true] at h
    rcases h6 : bitset M29v (u % 29) with _ | _
    · have := hM29 (2*w+3); rw [hu] at this; rw [h6] at this; exact Bool.false_ne_true this
    rw [h6, cond_true] at h
    exact entChk_sound 4096 _ h (2*w+3) hu

/-! ### Pair check: x-scan with boundary -/

def chkPair (n z xcnt : Nat) (y ent : Nat) : Bool :=
  let cd := c6v (y+5) + c8v (z+7)
  Nat.ble n (cd + c4v (xcnt+3)) && ball (leafX n cd ent) 64 0 xcnt

theorem chkPair_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {n z xcnt y ent : Nat} (h : chkPair n z xcnt y ent = true) :
    ∀ x w, (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  unfold chkPair at h
  rw [Bool.and_eq_true] at h
  obtain ⟨hbnd, hball⟩ := h
  intro x w heq
  rcases Nat.lt_or_ge x xcnt with hx | hx
  · have hl := ball_sound 64 0 xcnt hball x hx
    rw [Nat.zero_add] at hl
    have := leafX_sound hM1 hM25 hM17 hM19 hM23 hM29 hl w
    rw [c4v_eq (x+3), c6v_eq (y+5), c8v_eq (z+7)] at heq
    omega
  · rw [Nat.ble_eq] at hbnd
    have hmono : c4v (xcnt+3) ≤ c4v (x+3) := c4v_mono (by omega)
    have hT : 0 < (w+2).choose 2 := Nat.choose_pos (by omega)
    rw [c4v_eq (x+3), c6v_eq (y+5), c8v_eq (z+7)] at heq
    omega

/-! ### Block check over a y-range with packed records -/

def chkB (n z xcnt L : Nat) : Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _ => false
  | fuel+1, y, cnt, W =>
    cond (Nat.beq cnt 0) true <|
    cond (Nat.beq cnt 1) (chkPair n z xcnt y W) <|
    (chkB n z xcnt L fuel y (cnt/2) (W &&& (1 <<< (L * (cnt/2)) - 1)) &&
     chkB n z xcnt L fuel (y + cnt/2) (cnt - cnt/2) (W >>> (L * (cnt/2))))

theorem chkB_sound
    (hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true)
    (hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true)
    (hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true)
    (hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true)
    (hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true)
    (hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true)
    {n z xcnt L : Nat} : ∀ fuel y cnt W, chkB n z xcnt L fuel y cnt W = true →
    ∀ j, j < cnt → ∀ x w,
      (w+2).choose 2 + (x+3).choose 4 + (y+j+5).choose 6 + (z+7).choose 8 ≠ n := by
  intro fuel
  induction fuel with
  | zero => intro y cnt W h; simp [chkB] at h
  | succ fuel ih =>
    intro y cnt W h j hj
    unfold chkB at h
    rcases hc0 : Nat.beq cnt 0 with _ | _
    · rcases hc1 : Nat.beq cnt 1 with _ | _
      · simp only [hc0, hc1, cond_false] at h
        rw [Bool.and_eq_true] at h
        rcases Nat.lt_or_ge j (cnt/2) with hj2 | hj2
        · exact ih y (cnt/2) _ h.1 j hj2
        · have := ih (y + cnt/2) (cnt - cnt/2) _ h.2 (j - cnt/2) (by omega)
          rwa [show y + cnt/2 + (j - cnt/2) = y + j by omega] at this
      · simp only [hc0, hc1, cond_false, cond_true] at h
        have hc : cnt = 1 := Nat.eq_of_beq_eq_true hc1
        have hj0 : j = 0 := by omega
        subst hj0
        rw [Nat.add_zero]
        exact chkPair_sound hM1 hM25 hM17 hM19 hM23 hM29 h
    · have : cnt = 0 := Nat.eq_of_beq_eq_true hc0
      omega

/-! ### Tail lemmas -/

theorem ytail {n z yb : Nat} (hb : Nat.ble n (c6v (yb+5) + c8v (z+7)) = true) :
    ∀ y, yb ≤ y → ∀ x w,
      (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  intro y hy x w heq
  rw [Nat.ble_eq] at hb
  have h6 : c6v (yb+5) ≤ c6v (y+5) := by
    rw [← c6v_eq, ← c6v_eq]; exact Nat.choose_le_choose 6 (by omega)
  have hT : 0 < (w+2).choose 2 := Nat.choose_pos (by omega)
  rw [c4v_eq (x+3), c6v_eq (y+5), c8v_eq (z+7)] at heq
  omega

theorem ztail {n zb : Nat} (hb : Nat.ble n (c8v (zb+7)) = true) :
    ∀ z, zb ≤ z → ∀ y x w,
      (w+2).choose 2 + (x+3).choose 4 + (y+5).choose 6 + (z+7).choose 8 ≠ n := by
  intro z hz y x w heq
  rw [Nat.ble_eq] at hb
  have h8 : c8v (zb+7) ≤ c8v (z+7) := by
    rw [← c8v_eq, ← c8v_eq]; exact Nat.choose_le_choose 8 (by omega)
  have hT : 0 < (w+2).choose 2 := Nat.choose_pos (by omega)
  rw [c4v_eq (x+3), c6v_eq (y+5), c8v_eq (z+7)] at heq
  omega


theorem M1_ball : ball (fun s => bitset M1v ((s*s) % 45045)) 32 0 45045 = true := sorry
theorem M25_ball : ball (fun s => bitset M25v ((s*s) % 25)) 32 0 25 = true := sorry
theorem M17_ball : ball (fun s => bitset M17v ((s*s) % 17)) 32 0 17 = true := sorry
theorem M19_ball : ball (fun s => bitset M19v ((s*s) % 19)) 32 0 19 = true := sorry
theorem M23_ball : ball (fun s => bitset M23v ((s*s) % 23)) 32 0 23 = true := sorry
theorem M29_ball : ball (fun s => bitset M29v ((s*s) % 29)) 32 0 29 = true := sorry

theorem hM1 : ∀ s : Nat, bitset M1v ((s*s) % 45045) = true := mask_sound (by norm_num) M1_ball
theorem hM25 : ∀ s : Nat, bitset M25v ((s*s) % 25) = true := mask_sound (by norm_num) M25_ball
theorem hM17 : ∀ s : Nat, bitset M17v ((s*s) % 17) = true := mask_sound (by norm_num) M17_ball
theorem hM19 : ∀ s : Nat, bitset M19v ((s*s) % 19) = true := mask_sound (by norm_num) M19_ball
theorem hM23 : ∀ s : Nat, bitset M23v ((s*s) % 23) = true := mask_sound (by norm_num) M23_ball
theorem hM29 : ∀ s : Nat, bitset M29v ((s*s) % 29) = true := mask_sound (by norm_num) M29_ball



