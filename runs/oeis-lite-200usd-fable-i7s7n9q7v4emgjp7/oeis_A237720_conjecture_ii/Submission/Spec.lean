import FormalConjectures.Util.ProblemImports

open Nat Finset
open scoped Nat.Prime

/--
A237720: Number of primes $p \le \lfloor (n+1)/2 \rfloor$ with $\lfloor \sqrt{n-p} \rfloor$ prime.
-/
noncomputable def a (n : ℕ) : ℕ :=
  Finset.card (Finset.filter (fun p : ℕ =>
    p.Prime ∧
    2 * p ≤ n + 1 ∧
    (Nat.sqrt (n - p)).Prime
  ) (Finset.range (n + 1)))

/-!
The statement `oeis_A237720_conjecture_ii` below asserts: for every `n > 2` there is a
prime `p < n` with `⌊√(n+p)⌋` prime, i.e. `n + p ∈ [q², q² + 2q]` for some prime `q`.

The proof strategy implemented here:
* for `3 ≤ n ≤ 1441`, a kernel-checked table of explicit witnesses `(p, ⌊√(n+p)⌋)`;
* for `n ≥ 1442`, a double application of the short-interval lemma
  `prime_in_sqrt_window`: first at `y = m + 2` (where `m = ⌊√(n+2)⌋ ≥ 38`) to obtain a
  prime `s ≤ m + 2 + 2⌊√(m+2)⌋`, then at `y = s² - n` to obtain a prime
  `P ∈ [s² - n, s² - n + 2⌊√(s² - n)⌋] ⊆ [s² - n, s² + 2s - n]`, so that
  `⌊√(n + P)⌋ = s` and `P < n`.

The single remaining `sorry` is `prime_in_sqrt_window`: every interval
`[y, y + 2⌊√y⌋]` contains a prime.  This is an Oppermann/Andrica-strength statement:
it is true (it holds up to `4·10¹⁸` by the known prime-gap records, and the present
conjecture has been verified computationally far beyond the table range), but it is
an open problem: it requires prime gaps `O(√y)`, while the best known bounds are
`O(y^{0.525})` (Baker–Harman–Pintz, resting on zero-density estimates for `ζ`).
-/

/-- Helper: exhibit an explicit witness `p` together with the value `v = ⌊√(n+p)⌋`. -/
private lemma witness (n p v : ℕ) (hp : p.Prime) (hlt : p < n)
    (h1 : v * v ≤ n + p) (h2 : n + p < (v + 1) * (v + 1)) (hv : v.Prime) :
    ∃ p, p.Prime ∧ p < n ∧ (Nat.sqrt (n + p)).Prime :=
  ⟨p, hp, hlt, by rw [← Nat.eq_sqrt.mpr ⟨h1, h2⟩]; exact hv⟩

/-- A boolean primality test by trial division, designed to reduce well in the kernel. -/
private def isP (n : ℕ) : Bool :=
  decide (2 ≤ n) && (List.range' 2 (n - 2)).all fun d => decide (n % d ≠ 0)

private lemma isP_sound {n : ℕ} (h : isP n = true) : n.Prime := by
  rw [isP, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨h2, hall⟩ := h
  refine Nat.prime_def_lt'.mpr ⟨h2, fun d hd2 hdlt hdvd => ?_⟩
  have hmem : d ∈ List.range' 2 (n - 2) := List.mem_range'_1.mpr ⟨hd2, by omega⟩
  have hd := hall d hmem
  rw [decide_eq_true_eq] at hd
  exact hd (Nat.mod_eq_zero_of_dvd hdvd)

/-- Check a table of witnesses `(p, v)` for consecutive values of `n` starting at `n₀`. -/
private def chkAll : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | n, (p, v) :: r =>
      (decide (p < n) && isP p && decide (v * v ≤ n + p) &&
        decide (n + p < (v + 1) * (v + 1)) && isP v) && chkAll (n + 1) r

private lemma chkAll_sound (L : List (ℕ × ℕ)) :
    ∀ (n₀ : ℕ), chkAll n₀ L = true →
      ∀ n, n₀ ≤ n → n < n₀ + L.length →
        ∃ p, p.Prime ∧ p < n ∧ (Nat.sqrt (n + p)).Prime := by
  induction L with
  | nil =>
      intro n₀ _ n h1 h2
      simp only [List.length_nil] at h2
      omega
  | cons hd tl ih =>
      intro n₀ hchk n h1 h2
      obtain ⟨p, v⟩ := hd
      simp only [chkAll, Bool.and_eq_true, decide_eq_true_eq] at hchk
      obtain ⟨⟨⟨⟨⟨c1, c2⟩, c3⟩, c4⟩, c5⟩, crest⟩ := hchk
      rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · exact witness n₀ p v (isP_sound c2) c1 c3 c4 (isP_sound c5)
      · refine ih (n₀ + 1) crest n hlt ?_
        simp only [List.length_cons] at h2
        omega

