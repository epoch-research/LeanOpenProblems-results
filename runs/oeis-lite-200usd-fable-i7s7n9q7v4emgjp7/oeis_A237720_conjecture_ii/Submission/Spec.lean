private lemma WTable_check : chkAll 3 WTable = true := by decide

set_option maxRecDepth 20000 in
private lemma WTable_length : WTable.length = 1439 := by decide

/-- **(The open core.)**  Every interval `[y, y + 2⌊√y⌋]` contains a prime.

This is the only unproven ingredient of the main theorem below.  It is an
Oppermann/Andrica-strength short-interval statement: true far beyond any range
relevant to computation (equivalent to prime gaps being at most `2√y`, which holds
for all `y ≤ 4·10¹⁸` by the tabulated prime-gap records and is predicted by Cramér's
model with huge margin), but open: the best unconditional prime-gap bound is
`O(y^{0.525})` (Baker–Harman–Pintz). -/
private lemma prime_in_sqrt_window (y : ℕ) (hy : 2 ≤ y) :
    ∃ P, P.Prime ∧ y ≤ P ∧ P ≤ y + 2 * Nat.sqrt y := by
  sorry

/-- OEIS A237720 Conjecture (ii): For any integer $n > 2$, there is a prime $p < n$ with $\lfloor\sqrt{n+p}\rfloor$ prime. -/
theorem oeis_A237720_conjecture_ii (n : ℕ) (hn : n > 2) :
    ∃ p, p.Prime ∧ p < n ∧ (Nat.sqrt (n + p)).Prime := by
  by_cases hsmall : n ≤ 1441
  · -- `3 ≤ n ≤ 1441`: use the kernel-checked witness table.
    exact chkAll_sound WTable 3 WTable_check n (by omega)
      (by rw [WTable_length]; omega)
  · -- `n ≥ 1442`, so `m = ⌊√(n+2)⌋ ≥ 38`.
    have hbig : 1441 < n := by omega
    obtain ⟨m, hmdef⟩ : ∃ m, m = Nat.sqrt (n + 2) := ⟨_, rfl⟩
    have hm38 : 38 ≤ m := hmdef ▸ Nat.le_sqrt.mpr (by omega)
    have hml : m * m ≤ n + 2 := hmdef ▸ Nat.sqrt_le (n + 2)
    have hmr : n + 2 < m * m + 2 * m + 1 := by
      have h := Nat.lt_succ_sqrt (n + 2)
      rw [← hmdef] at h
      calc n + 2 < (m + 1) * (m + 1) := h
        _ = m * m + 2 * m + 1 := by ring
    have hm38m : 38 * m ≤ m * m := Nat.mul_le_mul_right m hm38
    -- `t = ⌊√(m+2)⌋`
    obtain ⟨t, htdef⟩ : ∃ t, t = Nat.sqrt (m + 2) := ⟨_, rfl⟩
    have ht1 : t * t ≤ m + 2 := htdef ▸ Nat.sqrt_le (m + 2)
    -- First application of the core lemma: a prime `s` with `m + 2 ≤ s ≤ m + 2 + 2t`.
    obtain ⟨s, hsP, hs1, hs2⟩ := prime_in_sqrt_window (m + 2) (by omega)
    rw [← htdef] at hs2
    -- `s²` is trapped between `(m+1)²` and `(m+2+2t)²`.
    have hsl : m * m + 2 * m + 1 ≤ s * s := by
      calc m * m + 2 * m + 1 = (m + 1) * (m + 1) := by ring
        _ ≤ s * s := Nat.mul_le_mul (by omega) (by omega)
    have hsu : s * s ≤ m * m + 4 * (m * t) + 4 * (t * t) + 4 * m + 8 * t + 4 := by
      calc s * s ≤ (m + 2 + 2 * t) * (m + 2 + 2 * t) := Nat.mul_le_mul hs2 hs2
        _ = m * m + 4 * (m * t) + 4 * (t * t) + 4 * m + 8 * t + 4 := by ring
    -- The window position `A = s² - n ≥ 3`.
    obtain ⟨A, hA⟩ : ∃ A, s * s = n + A := ⟨s * s - n, by omega⟩
    have hA2 : 2 ≤ A := by omega
    -- Second application of the core lemma: a prime `P ∈ [A, A + 2⌊√A⌋]`.
    obtain ⟨P, hPP, hP1, hP2⟩ := prime_in_sqrt_window A hA2
    obtain ⟨u, hudef⟩ : ∃ u, u = Nat.sqrt A := ⟨_, rfl⟩
    have hu1 : u * u ≤ A := hudef ▸ Nat.sqrt_le A
    rw [← hudef] at hP2
    -- `⌊√A⌋ < s`
    have hus : u < s := by
      by_contra hc
      push_neg at hc
      have : s * s ≤ u * u := Nat.mul_le_mul hc hc
      omega
    -- The produced prime is smaller than `n`.
    have hbound : P < n := by
      by_cases h6 : t ≤ 6
      · have hmt : m * t ≤ m * 6 := Nat.mul_le_mul_left m h6
        omega
      · have h7 : 6 < t := by omega
        have h7t : 7 * t ≤ t * t := Nat.mul_le_mul_right t (by omega)
        have h7le : 7 * t ≤ m + 2 := le_trans h7t ht1
        have h7m : 4 * m * (7 * t) ≤ 4 * m * (m + 2) :=
          Nat.mul_le_mul_left (4 * m) h7le
        have e28 : 4 * m * (7 * t) = 28 * (m * t) := by ring
        have e4m : 4 * m * (m + 2) = 4 * (m * m) + 8 * m := by ring
        rw [e28, e4m] at h7m
        omega
    -- Conclude: `⌊√(n+P)⌋ = s`, a prime.
    refine witness n P s hPP hbound (by omega) ?_ hsP
    have e : (s + 1) * (s + 1) = s * s + 2 * s + 1 := by ring
    rw [e]
    omega
