/-- The open core. True (computationally verified up to `10⁹`, with
`a n` in fact `≥ 5` and growing), but a proof is a Goldbach-strength open problem:
any `q` counted by `a n` yields a Goldbach partition `2n = (n - q) + (n + q)`. -/
private lemma a_ne_four_tail (n : ℕ) (h6 : 6 ∣ n) (hgt : 10008 < n) : a n ≠ 4 := by
  sorry

/-- OEIS A275768 conjecture 0: Does a(n) = 4 occur for any n? -/
theorem oeis_275768_conjecture_0 : ¬ ∃ n : ℕ, a n = 4 := by
  rintro ⟨n, h4⟩
  have h6 : 6 ∣ n := six_dvd_of_a_eq_four n h4
  rcases Nat.lt_or_ge n 24 with hlt | hge
  · interval_cases n <;> revert h4 <;> decide +kernel
  · rcases Nat.lt_or_ge n 10009 with hle | hgt
    · have h5 := five_le_a_of_table n h6 hge (by omega)
      omega
    · exact a_ne_four_tail n h6 (by omega) h4
