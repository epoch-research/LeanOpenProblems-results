import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A275768: $a(n)$ is the number of ways to express $n = \frac{\operatorname{prime}(i) + \operatorname{prime}(j)}{2}$ when $\frac{|\operatorname{prime}(i) - \operatorname{prime}(j)|}{2}$ also is prime.
This is equivalent to counting the number of primes $q$ such that $n - q$ and $n + q$ are also prime.
-/
def a (n : ℕ) : ℕ :=
  Finset.card (Finset.filter (fun q : ℕ =>
    Nat.Prime q ∧ Nat.Prime (n - q) ∧ Nat.Prime (n + q)
  ) (Finset.range n))

/-- For odd `n`, the only candidate is `q = 2`, hence `a n ≤ 1`. -/
private lemma a_le_one_of_odd (n : ℕ) (hn : Odd n) : a n ≤ 1 := by
  unfold a
  have h : (Finset.filter (fun q : ℕ =>
      Nat.Prime q ∧ Nat.Prime (n - q) ∧ Nat.Prime (n + q)) (Finset.range n)) ⊆ {2} := by
    intro q hq
    simp only [Finset.mem_filter, Finset.mem_range] at hq
    obtain ⟨hqn, hq, hnq, hnq'⟩ := hq
    simp only [Finset.mem_singleton]
    by_contra h2
    have hodd : Odd q := hq.odd_of_ne_two h2
    have : Even (n + q) := Odd.add_odd hn hodd
    have h2eq := (Nat.Prime.even_iff hnq').mp this
    have := hq.two_le
    omega
  calc (Finset.filter _ _).card ≤ ({2} : Finset ℕ).card := Finset.card_le_card h
    _ = 1 := rfl

/-- For even `n` not divisible by `3`, the only candidates are `q = 3` and `q = n - 3`,
hence `a n ≤ 2`. -/
private lemma a_le_two_of_even (n : ℕ) (h2 : 2 ∣ n) (h3 : ¬ 3 ∣ n) : a n ≤ 2 := by
  unfold a
  have h : (Finset.filter (fun q : ℕ =>
      Nat.Prime q ∧ Nat.Prime (n - q) ∧ Nat.Prime (n + q)) (Finset.range n)) ⊆ {3, n - 3} := by
    intro q hq
    simp only [Finset.mem_filter, Finset.mem_range] at hq
    obtain ⟨hqn, hq, hnq, hnq'⟩ := hq
    simp only [Finset.mem_insert, Finset.mem_singleton]
    have hq2 := hq.two_le
    by_cases hq2' : q = 2
    · -- then `n + 2` is even and `≥ 4`, contradiction
      exfalso
      subst hq2'
      have heven : 2 ∣ (n + 2) := by omega
      have := (Nat.Prime.even_iff hnq').mp (even_iff_two_dvd.mpr heven)
      omega
    · by_cases hq3 : q = 3
      · left; exact hq3
      · have hq3d : ¬ 3 ∣ q := fun hd =>
          hq3 ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hq).mp hd).symm
        by_cases hd1 : 3 ∣ (n - q)
        · have : 3 = n - q := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hnq).mp hd1
          right; omega
        · by_cases hd2 : 3 ∣ (n + q)
          · exfalso
            have : 3 = n + q := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hnq').mp hd2
            omega
          · exfalso
            have hn3 : n % 3 = 1 ∨ n % 3 = 2 := by
              rw [Nat.dvd_iff_mod_eq_zero] at h3; omega
            have hqq3 : q % 3 = 1 ∨ q % 3 = 2 := by
              rw [Nat.dvd_iff_mod_eq_zero] at hq3d; omega
            rcases hn3 with h | h <;> rcases hqq3 with h' | h'
            · exact hd1 (by omega)
            · exact hd2 (by omega)
            · exact hd2 (by omega)
            · exact hd1 (by omega)
  calc (Finset.filter _ _).card ≤ ({3, n - 3} : Finset ℕ).card := Finset.card_le_card h
    _ ≤ 2 := Finset.card_insert_le _ _ |>.trans (by simp)

/-- If `a n = 4` then `n` must be a multiple of `6`. -/
private lemma six_dvd_of_a_eq_four (n : ℕ) (h : a n = 4) : 6 ∣ n := by
  have h2 : 2 ∣ n := by
    rcases Nat.even_or_odd n with he | ho
    · exact he.two_dvd
    · exfalso; have := a_le_one_of_odd n ho; omega
  have h3 : 3 ∣ n := by
    by_contra h3
    have := a_le_two_of_even n h2 h3
    omega
  omega


def noDivFrom (n : ℕ) : ℕ → ℕ → Bool
  | _, 0 => true
  | d, fuel + 1 =>
    if n < d * d then true
    else decide (n % d ≠ 0) && noDivFrom n (d + 1) fuel

def isPrime (n : ℕ) : Bool := decide (2 ≤ n) && noDivFrom n 2 n

lemma noDivFrom_sound (n : ℕ) : ∀ (fuel d : ℕ), noDivFrom n d fuel = true →
    n < (d + fuel) * (d + fuel) →
    ∀ m, d ≤ m → m * m ≤ n → ¬ m ∣ n := by
  intro fuel
  induction fuel with
  | zero =>
      intro d _ hbig m hdm hm
      exfalso
      have : m * m < m * m := lt_of_le_of_lt hm (by
        simpa using Nat.lt_of_lt_of_le hbig (Nat.mul_le_mul (by omega) (by omega)))
      omega
  | succ f ih =>
      intro d h hbig m hdm hm
      unfold noDivFrom at h
      by_cases hc : n < d * d
      · exfalso
        have : m * m ≥ d * d := Nat.mul_le_mul hdm hdm
        omega
      · simp only [hc, if_false, Bool.and_eq_true, decide_eq_true_eq] at h
        obtain ⟨hnd, hrec⟩ := h
        rcases Nat.eq_or_lt_of_le hdm with rfl | hlt
        · rw [Nat.dvd_iff_mod_eq_zero]; exact hnd
        · refine ih (d + 1) hrec ?_ m (by omega) hm
          have hh : d + (f + 1) = d + 1 + f := by omega
          rw [hh] at hbig
          exact hbig

lemma isPrime_sound (n : ℕ) (h : isPrime n = true) : Nat.Prime n := by
  unfold isPrime at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨h2, hnd⟩ := h
  rw [Nat.prime_def_le_sqrt]
  refine ⟨h2, fun m hm hle => ?_⟩
  have hmm : m * m ≤ n := by
    have hs := Nat.sqrt_le' n
    rw [pow_two] at hs
    have h1 : m * m ≤ Nat.sqrt n * Nat.sqrt n := Nat.mul_le_mul hle hle
    exact le_trans h1 hs
  exact noDivFrom_sound n n 2 hnd (by nlinarith) m hm hmm

lemma five_le_a (n q1 q2 q3 q4 q5 : ℕ)
    (h12 : q1 < q2) (h23 : q2 < q3) (h34 : q3 < q4) (h45 : q4 < q5) (h5n : q5 < n)
    (hp1 : Nat.Prime q1) (hm1 : Nat.Prime (n - q1)) (hl1 : Nat.Prime (n + q1))
    (hp2 : Nat.Prime q2) (hm2 : Nat.Prime (n - q2)) (hl2 : Nat.Prime (n + q2))
    (hp3 : Nat.Prime q3) (hm3 : Nat.Prime (n - q3)) (hl3 : Nat.Prime (n + q3))
    (hp4 : Nat.Prime q4) (hm4 : Nat.Prime (n - q4)) (hl4 : Nat.Prime (n + q4))
    (hp5 : Nat.Prime q5) (hm5 : Nat.Prime (n - q5)) (hl5 : Nat.Prime (n + q5)) :
    5 ≤ a n := by
  have hsub : ({q1, q2, q3, q4, q5} : Finset ℕ) ⊆ Finset.filter (fun q : ℕ =>
      Nat.Prime q ∧ Nat.Prime (n - q) ∧ Nat.Prime (n + q)) (Finset.range n) := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp1, hm1, hl1⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp2, hm2, hl2⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp3, hm3, hl3⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp4, hm4, hl4⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hp5, hm5, hl5⟩
  have hcard : ({q1, q2, q3, q4, q5} : Finset ℕ).card = 5 := by
    rw [Finset.card_insert_of_notMem (by simp; omega),
        Finset.card_insert_of_notMem (by simp; omega),
        Finset.card_insert_of_notMem (by simp; omega),
        Finset.card_insert_of_notMem (by simp; omega),
        Finset.card_singleton]
  calc (5 : ℕ) = ({q1, q2, q3, q4, q5} : Finset ℕ).card := hcard.symm
    _ ≤ _ := Finset.card_le_card hsub

def checkEntry : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ → Bool
  | (n, q1, q2, q3, q4, q5) =>
    decide (q1 < q2) && (decide (q2 < q3) && (decide (q3 < q4) && (decide (q4 < q5) &&
    (decide (q5 < n) &&
    (isPrime q1 && (isPrime (n - q1) && (isPrime (n + q1) &&
    (isPrime q2 && (isPrime (n - q2) && (isPrime (n + q2) &&
    (isPrime q3 && (isPrime (n - q3) && (isPrime (n + q3) &&
    (isPrime q4 && (isPrime (n - q4) && (isPrime (n + q4) &&
    (isPrime q5 && (isPrime (n - q5) && isPrime (n + q5)))))))))))))))))))

lemma checkEntry_sound (e : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) (h : checkEntry e = true) :
    5 ≤ a e.1 := by
  obtain ⟨n, q1, q2, q3, q4, q5⟩ := e
  simp only [checkEntry, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨h12, h23, h34, h45, h5n, p1, m1, l1, p2, m2, l2, p3, m3, l3, p4, m4, l4, p5, m5, l5⟩ := h
  exact five_le_a n q1 q2 q3 q4 q5 h12 h23 h34 h45 h5n
    (isPrime_sound _ p1) (isPrime_sound _ m1) (isPrime_sound _ l1)
    (isPrime_sound _ p2) (isPrime_sound _ m2) (isPrime_sound _ l2)
    (isPrime_sound _ p3) (isPrime_sound _ m3) (isPrime_sound _ l3)
    (isPrime_sound _ p4) (isPrime_sound _ m4) (isPrime_sound _ l4)
    (isPrime_sound _ p5) (isPrime_sound _ m5) (isPrime_sound _ l5)


