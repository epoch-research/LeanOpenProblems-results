/-- Integer square-root guess: initial estimate from `lg42` plus four Newton
steps.  Only used inside the sound test `isSquare'`, so needs no correctness
proof. -/
def isqrt4 (M : ℕ) : ℕ :=
  (fun s => (fun g0 => (fun g1 => (fun g2 => (fun g3 =>
      Nat.div (Nat.add g3 (Nat.div M g3)) 2)
      (Nat.div (Nat.add g2 (Nat.div M g2)) 2))
      (Nat.div (Nat.add g1 (Nat.div M g1)) 2))
      (Nat.div (Nat.add g0 (Nat.div M g0)) 2))
      (Nat.add (Nat.div (Nat.add (Nat.pow 2 s) (Nat.shiftRight M s)) 2) 1))
    (Nat.div (lg42 M) 2)

/-- Perfect square test: sound by construction. -/
def isSquare' (M : ℕ) : Bool :=
  (fun r => Nat.beq (Nat.mul r r) M) (isqrt4 M)

theorem isSquare'_sound {M : ℕ} (h : isSquare' M = true) : ∃ r, r * r = M := by
  refine ⟨isqrt4 M, ?_⟩
  have h' : Nat.beq (Nat.mul (isqrt4 M) (isqrt4 M)) M = true := h
  exact Nat.eq_of_beq_eq_true h'

