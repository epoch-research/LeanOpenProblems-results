import FormalConjectures.Util.ProblemImports

open Nat Finset

set_option Elab.async true

/--
A236998: a(n) = |{0 < k < n/2: phi(k)*phi(n-k) is a square}|, where phi(.) is Euler's totient function.
-/
def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

namespace A236998Aux

/-- `Bool.rec` with constant motive is `cond` with swapped branches. -/
theorem br_eq_cond {α : Type} (f t : α) (b : Bool) :
    (Bool.rec f t b : α) = cond b t f := by cases b <;> rfl

/-- Product of all odd primes below 1415. -/
def PP : ℕ := 

/-- Small-odd-factor detector (walker); only the `true` direction is used. -/
def hasF (fuel : ℕ) : ℕ → ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → ℕ → Bool)
    (fun _ _ => false)
    (fun _ ih q e =>
      cond (Nat.ble (e * e) q)
        (cond (Nat.beq (q % e) 0) true (ih q (e + 2)))
        false)
    fuel

theorem hasF_sound : ∀ (fuel q e : ℕ), hasF fuel q e = true →
    ∃ c, e ≤ c ∧ c * c ≤ q ∧ q % c = 0 := by
  intro fuel
  induction fuel with
  | zero => intro q e h; exact absurd h (by simp [hasF])
  | succ f ih =>
    intro q e h
    have h' : (cond (Nat.ble (e * e) q)
        (cond (Nat.beq (q % e) 0) true (hasF f q (e + 2))) false) = true := h
    cases hble : Nat.ble (e * e) q with
    | false => rw [hble, cond_false] at h'; exact absurd h' (by simp)
    | true =>
      rw [hble, cond_true] at h'
      cases hbeq : Nat.beq (q % e) 0 with
      | true => exact ⟨e, le_refl e, by simpa using hble, by simpa using hbeq⟩
      | false =>
        rw [hbeq, cond_false] at h'
        obtain ⟨c, h1, h2, h3⟩ := ih q (e + 2) h'
        exact ⟨c, by omega, h2, h3⟩

/-- Walker checking that every odd prime in `[q, 1415)` divides `PP`. -/
def covCheck (fuel : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool)
    (fun _ => false)
    (fun _ ih q =>
      cond (Nat.ble 1415 q) true
        ((hasF q q 3 || Nat.beq (PP % q) 0) && ih (q + 2)))
    fuel

theorem covCheck_sound : ∀ (fuel q : ℕ), 3 ≤ q → q % 2 = 1 → covCheck fuel q = true →
    ∀ p, p.Prime → q ≤ p → p < 1415 → p ∣ PP := by
  intro fuel
  induction fuel with
  | zero => intro q _ _ h; exact absurd h (by simp [covCheck])
  | succ f ih =>
    intro q hq3 hq2 h p pp hqp hp
    have h' : (cond (Nat.ble 1415 q) true
        ((hasF q q 3 || Nat.beq (PP % q) 0) && covCheck f (q + 2))) = true := h
    cases hble : Nat.ble 1415 q with
    | true =>
      rw [Nat.ble_eq] at hble; omega
    | false =>
      rw [hble, cond_false, Bool.and_eq_true, Bool.or_eq_true] at h'
      obtain ⟨h1, h2⟩ := h'
      rcases Nat.lt_or_ge q p with hlt | hge
      · have hpodd : p % 2 = 1 := by
          have h2le := pp.two_le
          rcases Nat.even_or_odd p with he | ho
          · have := (Nat.Prime.even_iff pp).mp he
            omega
          · exact Nat.odd_iff.mp ho
        exact ih (q + 2) (by omega) (by omega) h2 p pp (by omega) hp
      · have hpq : p = q := by omega
        rcases h1 with h1 | h1
        · exfalso
          obtain ⟨c, hc1, hc2, hc3⟩ := hasF_sound q q 3 h1
          have hcdvd : c ∣ q := Nat.dvd_of_mod_eq_zero hc3
          have h3c : 3 * c ≤ c * c := Nat.mul_le_mul_right c hc1
          have hclt : c < q := by omega
          have hqprime : Nat.Prime q := hpq ▸ pp
          rcases hqprime.eq_one_or_self_of_dvd c hcdvd with h | h <;> omega
        · rw [hpq]
          exact Nat.dvd_of_mod_eq_zero (by simpa using h1)

theorem PP_covers : ∀ p, p.Prime → 3 ≤ p → p < 1415 → p ∣ PP := by
  have hcov : covCheck 1000 3 = true := by decide +kernel
  exact covCheck_sound 1000 3 (by norm_num) (by norm_num) hcov

/-- Odd numbers `≤ 1415² - 1` coprime to `PP` are prime. -/
theorem prime_of_coprime_PP {m : ℕ} (h2 : 2 ≤ m) (hB : m ≤ 2002224) (hodd : ¬ 2 ∣ m)
    (hg : Nat.gcd m PP = 1) : m.Prime := by
  by_contra hnp
  have hf := Nat.minFac_prime (by omega : m ≠ 1)
  have hsq := Nat.minFac_sq_le_self (by omega) hnp
  rw [pow_two] at hsq
  have hlt : m.minFac < 1415 := by
    by_contra hge
    push_neg at hge
    have : 1415 * 1415 ≤ m.minFac * m.minFac := Nat.mul_le_mul hge hge
    omega
  have hmf2 : m.minFac ≠ 2 := fun he => hodd (he ▸ Nat.minFac_dvd m)
  have h3 : 3 ≤ m.minFac := by
    have := hf.two_le
    omega
  have hdvdPP : m.minFac ∣ PP := PP_covers _ hf h3 hlt
  have hdg : m.minFac ∣ Nat.gcd m PP := Nat.dvd_gcd (Nat.minFac_dvd m) hdvdPP
  rw [hg] at hdg
  have := Nat.le_of_dvd (by norm_num) hdg
  omega

/-- Fuel-based totient computation for odd numbers by trial division with odd
candidate divisors.  `phiAux2 fuel m d` computes `φ(m)` (for `m ≤ 2002224`)
assuming `d` is odd and all prime factors of `m` are `≥ d ≥ 3`. -/
def phiAux2 (fuel : ℕ) : ℕ → ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ → ℕ)
    (fun _ _ => 1)
    (fun _ ih m d =>
      Bool.rec (motive := fun _ => ℕ)
        (Bool.rec (motive := fun _ => ℕ)
          (Nat.sub m 1)
          (Bool.rec (motive := fun _ => ℕ)
            (Bool.rec (motive := fun _ => ℕ)
              (ih m (Nat.add d 2))
              (Bool.rec (motive := fun _ => ℕ)
                (Nat.mul (Nat.sub d 1) (ih (Nat.div m d) (Nat.add d 2)))
                (Nat.mul d (ih (Nat.div m d) d))
                (Nat.beq (Nat.mod (Nat.div m d) d) 0))
              (Nat.beq (Nat.mod m d) 0))
            (Nat.sub m 1)
            (Nat.beq (Nat.gcd m PP) 1))
          (Nat.ble (Nat.mul d d) m))
        1
        (Nat.beq m 1))
    fuel

theorem phiAux2_succ (f m d : ℕ) : phiAux2 (f + 1) m d =
    if m = 1 then 1
    else if d * d ≤ m then
      (if Nat.gcd m PP = 1 then m - 1
       else
        (if m % d = 0 then
          (if m / d % d = 0 then d * phiAux2 f (m / d) d
           else (d - 1) * phiAux2 f (m / d) (d + 2))
         else phiAux2 f m (d + 2)))
    else m - 1 := by
  show (Bool.rec (motive := fun _ => ℕ)
      (Bool.rec (motive := fun _ => ℕ)
        (m - 1)
        (Bool.rec (motive := fun _ => ℕ)
          (Bool.rec (motive := fun _ => ℕ)
            (phiAux2 f m (d + 2))
            (Bool.rec (motive := fun _ => ℕ)
              ((d - 1) * phiAux2 f (m / d) (d + 2))
              (d * phiAux2 f (m / d) d)
              (Nat.beq (m / d % d) 0))
            (Nat.beq (m % d) 0))
          (m - 1)
          (Nat.beq (Nat.gcd m PP) 1))
        (Nat.ble (d * d) m))
      1
      (Nat.beq m 1)) = _
  simp only [br_eq_cond, cond_eq_ite, Nat.beq_eq, Nat.ble_eq]

theorem phiAux2_eq (fuel : ℕ) : ∀ m d : ℕ, 1 ≤ fuel → 1 ≤ m → m ≤ 2002224 → 3 ≤ d → d % 2 = 1 →
    (∀ p, p.Prime → p ∣ m → d ≤ p) → m + 2 ≤ 2 * fuel + d →
    phiAux2 fuel m d = Nat.totient m := by
  induction fuel with
  | zero => intro m d h; omega
  | succ fuel ih =>
    intro m d _ hm hmB hd hodd hinv hfuel
    rw [phiAux2_succ]
    by_cases h1 : m = 1
    · rw [if_pos h1, h1, Nat.totient_one]
    rw [if_neg h1]
    have hm2 : 2 ≤ m := by omega
    by_cases h2 : d * d ≤ m
    swap
    · rw [if_neg h2]
      push_neg at h2
      have hp : m.Prime := by
        by_contra hnp
        have hf := Nat.minFac_prime h1
        have hd1 := hinv _ hf (Nat.minFac_dvd m)
        have hsq := Nat.minFac_sq_le_self (by omega) hnp
        rw [pow_two] at hsq
        have : d * d ≤ m.minFac * m.minFac := Nat.mul_le_mul hd1 hd1
        omega
      rw [Nat.totient_prime hp]
    rw [if_pos h2]
    have hdd : 3 * d ≤ d * d := Nat.mul_le_mul_right d hd
    by_cases hg : Nat.gcd m PP = 1
    · rw [if_pos hg]
      have hp : m.Prime := by
        by_contra hnp
        have hf := Nat.minFac_prime h1
        have hd1 := hinv _ hf (Nat.minFac_dvd m)
        have hsq := Nat.minFac_sq_le_self (by omega) hnp
        rw [pow_two] at hsq
        have hlt : m.minFac < 1415 := by
          by_contra hge
          push_neg at hge
          have : 1415 * 1415 ≤ m.minFac * m.minFac := Nat.mul_le_mul hge hge
          omega
        have hdvdPP : m.minFac ∣ PP := PP_covers _ hf (by omega) hlt
        have : m.minFac ∣ Nat.gcd m PP := Nat.dvd_gcd (Nat.minFac_dvd m) hdvdPP
        rw [hg] at this
        have := Nat.le_of_dvd (by norm_num) this
        have := hf.two_le
        omega
      rw [Nat.totient_prime hp]
    rw [if_neg hg]
    by_cases h3 : m % d = 0
    · rw [if_pos h3]
      have hdvd : d ∣ m := Nat.dvd_of_mod_eq_zero h3
      have hdp : d.Prime := by
        have hne : d ≠ 1 := by omega
        have h1' : Nat.minFac d ∣ m := (Nat.minFac_dvd d).trans hdvd
        have hge : d ≤ Nat.minFac d := hinv _ (Nat.minFac_prime hne) h1'
        have hle : Nat.minFac d ≤ d := Nat.minFac_le (by omega)
        exact Nat.prime_def_minFac.mpr ⟨by omega, le_antisymm hle hge⟩
      have hmd : m / d ∣ m := ⟨d, (Nat.div_mul_cancel hdvd).symm⟩
      have hddle : d ≤ m := by
        have : d ≤ d * d := Nat.le_mul_of_pos_left d (by omega)
        omega
      have hmd1 : 1 ≤ m / d := (Nat.one_le_div_iff (by omega)).mpr hddle
      have hmdle : m / d ≤ m / 3 := Nat.div_le_div_left hd (by norm_num)
      have hmdB : m / d ≤ 2002224 := le_trans (Nat.div_le_self m d) hmB
      have hm9 : 9 ≤ m := by omega
      have hminv : ∀ p, p.Prime → p ∣ m / d → d ≤ p := fun p pp hpd => hinv p pp (hpd.trans hmd)
      have hmeq : m = d * (m / d) := (Nat.mul_div_cancel' hdvd).symm
      by_cases h4 : (m / d) % d = 0
      · rw [if_pos h4]
        rw [ih (m / d) d (by omega) hmd1 hmdB hd hodd hminv (by omega)]
        conv_rhs => rw [hmeq]
        rw [Nat.totient_mul_of_prime_of_dvd hdp (Nat.dvd_of_mod_eq_zero h4)]
      · rw [if_neg h4]
        have hnd : ¬ d ∣ m / d := fun hc => h4 (Nat.dvd_iff_mod_eq_zero.mp hc)
        have hminv' : ∀ p, p.Prime → p ∣ m / d → d + 2 ≤ p := by
          intro p pp hpd
          have hle := hminv p pp hpd
          have hne : p ≠ d := fun he => hnd (he ▸ hpd)
          have hne2 : p ≠ d + 1 := by
            intro he
            have hpe : Even p := by
              rcases Nat.even_or_odd p with h | h
              · exact h
              · exfalso; rw [Nat.odd_iff] at h; omega
            have := (Nat.Prime.even_iff pp).mp hpe
            omega
          omega
        rw [ih (m / d) (d + 2) (by omega) hmd1 hmdB (by omega) (by omega) hminv' (by omega)]
        have hcop : Nat.Coprime d (m / d) := (Nat.Prime.coprime_iff_not_dvd hdp).mpr hnd
        conv_rhs => rw [hmeq]
        rw [Nat.totient_mul hcop, Nat.totient_prime hdp]
    · rw [if_neg h3]
      have hnd : ¬ d ∣ m := fun hc => h3 (Nat.dvd_iff_mod_eq_zero.mp hc)
      have hinv' : ∀ p, p.Prime → p ∣ m → d + 2 ≤ p := by
        intro p pp hpd
        have hle := hinv p pp hpd
        have hne : p ≠ d := fun he => hnd (he ▸ hpd)
        have hne2 : p ≠ d + 1 := by
          intro he
          have hpe : Even p := by
            rcases Nat.even_or_odd p with h | h
            · exact h
            · exfalso; rw [Nat.odd_iff] at h; omega
          have := (Nat.Prime.even_iff pp).mp hpe
          omega
        omega
      exact ih m (d + 2) (by omega) hm hmB (by omega) (by omega) hinv' (by omega)

/- ### Straight-line totient via prime-power extraction by `gcd` -/

theorem extract_step {p P m : ℕ} (pp : p.Prime) (hm : 1 ≤ m) (E : ℕ) (hP : P = p ^ E)
    (hlt : m < p * P) :
    Nat.totient m = Nat.totient (Nat.gcd m P) * Nat.totient (m / Nat.gcd m P) ∧
    1 ≤ m / Nat.gcd m P ∧ ¬ p ∣ (m / Nat.gcd m P) ∧ (m / Nat.gcd m P) ∣ m := by
  have hgdvd : Nat.gcd m P ∣ m := Nat.gcd_dvd_left m P
  have hgP : Nat.gcd m P ∣ p ^ E := hP ▸ Nat.gcd_dvd_right m P
  obtain ⟨j, hjle, hj⟩ := (Nat.dvd_prime_pow pp).mp hgP
  have hgpos : 0 < Nat.gcd m P := Nat.gcd_pos_of_pos_left P (by omega)
  have hqpos : 1 ≤ m / Nat.gcd m P :=
    (Nat.one_le_div_iff hgpos).mpr (Nat.le_of_dvd (by omega) hgdvd)
  have hmeq : m = Nat.gcd m P * (m / Nat.gcd m P) := (Nat.mul_div_cancel' hgdvd).symm
  have hltE : m < p ^ (E + 1) := by
    rw [hP, Nat.mul_comm, ← pow_succ] at hlt
    exact hlt
  have hnd : ¬ p ∣ (m / Nat.gcd m P) := by
    intro hpd
    obtain ⟨c, hc⟩ := hpd
    have hdvd1 : p ^ (j + 1) ∣ m := by
      refine ⟨c, ?_⟩
      rw [pow_succ, ← hj]
      calc m = Nat.gcd m P * (m / Nat.gcd m P) := hmeq
        _ = Nat.gcd m P * (p * c) := by rw [hc]
        _ = Nat.gcd m P * p * c := by ring
    have hle1 : p ^ (j + 1) ≤ m := Nat.le_of_dvd (by omega) hdvd1
    have hj1E : j + 1 ≤ E := by
      by_contra hgt
      push_neg at hgt
      have : p ^ (E + 1) ≤ p ^ (j + 1) := Nat.pow_le_pow_right pp.pos (by omega)
      omega
    have hdvd2 : p ^ (j + 1) ∣ Nat.gcd m P := by
      rw [hP]
      exact Nat.dvd_gcd hdvd1 (pow_dvd_pow p hj1E)
    rw [hj] at hdvd2
    have hle2 : p ^ (j + 1) ≤ p ^ j := Nat.le_of_dvd (pow_pos pp.pos j) hdvd2
    have hlt2 : p ^ j < p ^ (j + 1) := Nat.pow_lt_pow_right pp.one_lt (by omega)
    omega
  have hcop : Nat.Coprime (Nat.gcd m P) (m / Nat.gcd m P) := by
    have hc := Nat.Coprime.pow_left j ((Nat.Prime.coprime_iff_not_dvd pp).mpr hnd)
    rwa [← hj] at hc
  refine ⟨?_, hqpos, hnd, ⟨Nat.gcd m P, by rw [Nat.mul_comm]; exact hmeq⟩⟩
  conv_lhs => rw [hmeq]
  exact Nat.totient_mul hcop

theorem totient_gcd_pow {p P m : ℕ} (pp : p.Prime) (E : ℕ) (hP : P = p ^ E)
    (hne : Nat.gcd m P ≠ 1) :
    Nat.totient (Nat.gcd m P) = (p - 1) * (Nat.gcd m P / p) := by
  have hgP : Nat.gcd m P ∣ p ^ E := hP ▸ Nat.gcd_dvd_right m P
  obtain ⟨j, hjle, hj⟩ := (Nat.dvd_prime_pow pp).mp hgP
  cases j with
  | zero => rw [pow_zero] at hj; exact absurd hj hne
  | succ i =>
    rw [hj, Nat.totient_prime_pow pp (Nat.succ_pos i), pow_succ,
      Nat.mul_div_cancel _ pp.pos, Nat.succ_sub_one, Nat.mul_comm]

/-- One straight-line extraction step for prime `p` with power cap `P`. -/
def phiStep (p P : ℕ) (k : ℕ → ℕ) (m : ℕ) : ℕ :=
  (fun g => Nat.mul (Bool.rec (Nat.mul (Nat.sub p 1) (Nat.div g p)) 1 (Nat.beq g 1))
      (k (Nat.div m g)))
    (Nat.gcd m P)

theorem phiStep_def (p P : ℕ) (k : ℕ → ℕ) (m : ℕ) :
    phiStep p P k m = (if Nat.gcd m P = 1 then 1 else (p - 1) * (Nat.gcd m P / p)) *
      k (m / Nat.gcd m P) := by
  show ((fun g => (Bool.rec (motive := fun _ => ℕ) ((p - 1) * (g / p)) 1 (Nat.beq g 1)) * k (m / g))
      (Nat.gcd m P)) = _
  simp only [br_eq_cond, cond_eq_ite, Nat.beq_eq]

/-- Totient of the 2-3-5-7-free residual: `1`, or certified prime via `PP`,
or fallback trial division from `11`. -/
def phiRest (m : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ)
      (phiAux2 m m 11)
      (Nat.sub m 1)
      (Nat.beq (Nat.gcd m PP) 1))
    1
    (Nat.beq m 1)

theorem phiRest_def (m : ℕ) : phiRest m =
    (if m = 1 then 1 else (if Nat.gcd m PP = 1 then m - 1 else phiAux2 m m 11)) := by
  show (Bool.rec (motive := fun _ => ℕ)
      (Bool.rec (motive := fun _ => ℕ) (phiAux2 m m 11) (m - 1) (Nat.beq (Nat.gcd m PP) 1))
      1 (Nat.beq m 1) : ℕ) = _
  simp only [br_eq_cond, cond_eq_ite, Nat.beq_eq]

theorem phiRest_eq {m : ℕ} (hm : 1 ≤ m) (hB : m ≤ 2002224) (h2 : ¬ 2 ∣ m) (h3 : ¬ 3 ∣ m)
    (h5 : ¬ 5 ∣ m) (h7 : ¬ 7 ∣ m) : phiRest m = Nat.totient m := by
  rw [phiRest_def]
  by_cases h1 : m = 1
  · rw [if_pos h1, h1, Nat.totient_one]
  rw [if_neg h1]
  by_cases hg : Nat.gcd m PP = 1
  · rw [if_pos hg, Nat.totient_prime (prime_of_coprime_PP (by omega) hB h2 hg)]
  · rw [if_neg hg]
    refine phiAux2_eq m m 11 hm hm hB (by norm_num) (by norm_num) ?_ (by omega)
    intro q hq hqd
    rcases Nat.lt_or_ge q 11 with hlt | hge
    · exfalso
      interval_cases q
      · exact absurd hq (by norm_num)
      · exact absurd hq (by norm_num)
      · exact h2 hqd
      · exact h3 hqd
      · exact absurd hq (by norm_num)
      · exact h5 hqd
      · exact absurd hq (by norm_num)
      · exact h7 hqd
      · exact absurd hq (by norm_num)
      · exact absurd hq (by norm_num)
      · exact absurd hq (by norm_num)
    · exact hge

/-- Straight-line totient (fast path): extract the 2,3,5,7-parts with `gcd`s
against prime-power caps, then handle the residual. -/
def phiFast (m : ℕ) : ℕ :=
  phiStep 2 2097152 (phiStep 3 1594323 (phiStep 5 1953125 (phiStep 7 823543 phiRest))) m

theorem phiFast_eq {m : ℕ} (hm : 1 ≤ m) (hB : m ≤ 2002224) : phiFast m = Nat.totient m := by
  obtain ⟨ht2, hp2, hnd2, hdvd2⟩ :=
    extract_step (P := 2097152) Nat.prime_two hm 21 (by norm_num) (by omega)
  have hle2 : m / Nat.gcd m 2097152 ≤ m := Nat.le_of_dvd (by omega) hdvd2
  obtain ⟨ht3, hp3, hnd3, hdvd3⟩ :=
    extract_step (P := 1594323) (m := m / Nat.gcd m 2097152)
      (by norm_num : Nat.Prime 3) hp2 13 (by norm_num) (by omega)
  set m2 := m / Nat.gcd m 2097152 with hm2d
  have hle3 : m2 / Nat.gcd m2 1594323 ≤ m2 := Nat.le_of_dvd (by omega) hdvd3
  obtain ⟨ht5, hp5, hnd5, hdvd5⟩ :=
    extract_step (P := 1953125) (m := m2 / Nat.gcd m2 1594323)
      (by norm_num : Nat.Prime 5) hp3 9 (by norm_num) (by omega)
  set m3 := m2 / Nat.gcd m2 1594323 with hm3d
  have hle5 : m3 / Nat.gcd m3 1953125 ≤ m3 := Nat.le_of_dvd (by omega) hdvd5
  obtain ⟨ht7, hp7, hnd7, hdvd7⟩ :=
    extract_step (P := 823543) (m := m3 / Nat.gcd m3 1953125)
      (by norm_num : Nat.Prime 7) hp5 7 (by norm_num) (by omega)
  set m5 := m3 / Nat.gcd m3 1953125 with hm5d
  have hle7 : m5 / Nat.gcd m5 823543 ≤ m5 := Nat.le_of_dvd (by omega) hdvd7
  set m7 := m5 / Nat.gcd m5 823543 with hm7d
  have hnd2' : ¬ 2 ∣ m7 := fun hd => hnd2 (hd.trans (hdvd7.trans (hdvd5.trans hdvd3)))
  have hnd3' : ¬ 3 ∣ m7 := fun hd => hnd3 (hd.trans (hdvd7.trans hdvd5))
  have hnd5' : ¬ 5 ∣ m7 := fun hd => hnd5 (hd.trans hdvd7)
  have e2 : (if Nat.gcd m 2097152 = 1 then (1:ℕ) else (2 - 1) * (Nat.gcd m 2097152 / 2))
      = Nat.totient (Nat.gcd m 2097152) := by
    by_cases hg : Nat.gcd m 2097152 = 1
    · rw [if_pos hg, hg, Nat.totient_one]
    · rw [if_neg hg, totient_gcd_pow Nat.prime_two 21 (by norm_num) hg]
  have e3 : (if Nat.gcd m2 1594323 = 1 then (1:ℕ) else (3 - 1) * (Nat.gcd m2 1594323 / 3))
