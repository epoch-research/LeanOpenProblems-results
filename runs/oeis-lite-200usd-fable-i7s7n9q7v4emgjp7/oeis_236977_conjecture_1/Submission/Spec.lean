/-- If `k` is a valid witness then `a n > 0`. -/
theorem a_pos_of_witness {n : ℕ} (k : ℕ) (h1 : 1 ≤ k) (h2 : k ≤ (n - 1) / 2)
    (r : ℕ) (hr : r * r = Nat.totient k * Nat.totient (n - k)) : 0 < a n := by
  have hk : k ∈ Ico 1 ((n - 1) / 2 + 1) := mem_Ico.mpr ⟨h1, by omega⟩
  unfold a
  refine Finset.sum_pos' (fun i _ => Nat.zero_le _) ⟨k, hk, ?_⟩
  have hsq : Nat.sqrt (Nat.totient k * Nat.totient (n - k)) ^ 2
      = Nat.totient k * Nat.totient (n - k) := by
    rw [← hr, Nat.sqrt_eq, pow_two]
  show 0 < if Nat.sqrt (Nat.totient k * Nat.totient (n - k)) ^ 2
      = Nat.totient k * Nat.totient (n - k) then 1 else 0
  rw [if_pos hsq]
  norm_num

/- ### Algebraic witness families -/


/-- Coprimality of a prime `q` with `m` from a mod test. -/
theorem cop_helper {q m : ℕ} (hq : Nat.Prime q) (h : ¬ (m % q = 0)) : Nat.Coprime q m := by
  refine (Nat.Prime.coprime_iff_not_dvd hq).mpr (fun hd => h ?_)
  obtain ⟨t, rfl⟩ := hd
  simp [Nat.mul_mod_right]

/-- Generic algebraic family: `n = (c+d)m` with witness `k = cm`, valid whenever
`φ(c)φ(d)` is a perfect square and `m` is coprime to `c` and `d`. -/
theorem family_gen {n m c d E : ℕ} (h9 : 9 ≤ n) (hm : 1 ≤ m)
    (hn : n = (c + d) * m) (hc : 1 ≤ c) (hcd : c < d)
    (hcop1 : Nat.Coprime c m) (hcop2 : Nat.Coprime d m)
    (hE : Nat.totient c * Nat.totient d = E * E) : 0 < a n := by
  have h1 : (2 * c + 1) * m ≤ (c + d) * m := Nat.mul_le_mul_right m (by omega)
  have e1 : (2 * c + 1) * m = 2 * (c * m) + m := by ring
  rw [e1, ← hn] at h1
  have hkb : c * m ≤ (n - 1) / 2 := by omega
  have hnk : n - c * m = d * m := by
    have e : (c + d) * m = c * m + d * m := by ring
    omega
  have hk1 : 1 ≤ c * m := by
    have := Nat.mul_le_mul hc hm
    simpa using this
  refine a_pos_of_witness (c * m) hk1 hkb (E * Nat.totient m) ?_
  rw [hnk, Nat.totient_mul hcop1, Nat.totient_mul hcop2]
  calc E * Nat.totient m * (E * Nat.totient m)
      = (Nat.totient c * Nat.totient d) * (Nat.totient m * Nat.totient m) := by rw [hE]; ring
    _ = Nat.totient c * Nat.totient m * (Nat.totient d * Nat.totient m) := by ring

/-- Family: `n ≡ 3 (mod 6)`, witness `k = n/3`, since `φ(k)φ(2k) = φ(k)²` for odd `k`. -/
theorem family_odd3 {n : ℕ} (h9 : 9 ≤ n) (h : n % 6 = 3) : 0 < a n := by
  obtain ⟨t, ht, hodd⟩ : ∃ t, n = 3 * t ∧ t % 2 = 1 := ⟨n / 3, by omega, by omega⟩
  have h2t : n - t = 2 * t := by omega
  have hcop : Nat.Coprime 2 t := Nat.coprime_two_left.mpr (Nat.odd_iff.mpr hodd)
  have hphi : Nat.totient (n - t) = Nat.totient t := by
    rw [h2t, Nat.totient_mul hcop, Nat.totient_two, one_mul]
  exact a_pos_of_witness t (by omega) (by omega) (Nat.totient t) (by rw [hphi])

/-- Family: `n ≡ 0 (mod 6)` with `5 ∤ n/6`, witness `k = n/6`. -/
theorem family_six {n : ℕ} (h9 : 9 ≤ n) (h6 : n % 6 = 0) (h5 : (n / 6) % 5 ≠ 0) : 0 < a n := by
  obtain ⟨b, hb⟩ : ∃ b, n = 6 * b := ⟨n / 6, by omega⟩
  have h5' : ¬ (5 ∣ b) := by
    intro hd
    exact h5 (by omega)
  have hcop : Nat.Coprime 5 b := (Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr h5'
  have hnb : n - b = 5 * b := by omega
  have hphi : Nat.totient (n - b) = 4 * Nat.totient b := by
    rw [hnb, Nat.totient_mul hcop]
    norm_num [Nat.totient_prime (by norm_num : Nat.Prime 5)]
  refine a_pos_of_witness b (by omega) (by omega) (2 * Nat.totient b) ?_
  rw [hphi]; ring

/-- Family: `n ≡ 0 (mod 10)`, witness `k = n/5` (which is even). -/
theorem family_ten {n : ℕ} (h9 : 9 ≤ n) (h10 : n % 10 = 0) : 0 < a n := by
  obtain ⟨c, hc⟩ : ∃ c, n = 10 * c := ⟨n / 10, by omega⟩
  have h8 : n - 2 * c = 2 * (2 * (2 * c)) := by omega
  have hphi : Nat.totient (n - 2 * c) = 4 * Nat.totient (2 * c) := by
    rw [h8, Nat.totient_mul_of_prime_of_dvd Nat.prime_two ⟨2 * c, by ring⟩,
        Nat.totient_mul_of_prime_of_dvd Nat.prime_two ⟨c, rfl⟩]
    ring
  refine a_pos_of_witness (2 * c) (by omega) (by omega) (2 * Nat.totient (2 * c)) ?_
  rw [hphi]; ring

theorem family_mod3 {n : ℕ} (h9 : 9 ≤ n) (h3 : n % 3 = 0) : 0 < a n := by
  have h6 : n % 6 = 3 ∨ n % 6 = 0 := by omega
  rcases h6 with h6 | h6
  · exact family_odd3 h9 h6
  · by_cases h5 : (n / 6) % 5 = 0
    · exact family_ten h9 (by omega)
    · exact family_six h9 h6 h5

/-- Family: `n = 7m` with `m` odd and `3 ∤ m`, witness `k = 3m`. -/
theorem family_seven_odd {n : ℕ} (h9 : 9 ≤ n) (h7 : n % 7 = 0)
    (hodd : (n / 7) % 2 = 1) (h3 : (n / 7) % 3 ≠ 0) : 0 < a n := by
  obtain ⟨m, hm, hmo, hm3⟩ : ∃ m, n = 7 * m ∧ m % 2 = 1 ∧ m % 3 ≠ 0 :=
