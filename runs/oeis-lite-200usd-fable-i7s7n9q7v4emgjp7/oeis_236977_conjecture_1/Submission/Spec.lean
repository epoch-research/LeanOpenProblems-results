def PPtwo : ℕ := 

theorem PPtwo_eq : PPtwo = 2 * PP := by decide +kernel

/-- Early-exit wrapper: totient of `m` is `1` for `m = 1`, `m - 1` when `m` is
certified prime by coprimality with `PPtwo` (which also certifies oddness),
otherwise defer to the continuation `k`. -/
def phiExit (k : ℕ → ℕ) (m : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ)
    (Bool.rec (motive := fun _ => ℕ)
      (k m)
      (Nat.sub m 1)
      (Nat.beq (Nat.gcd m PPtwo) 1))
    1
    (Nat.beq m 1)

theorem phiExit_def (k : ℕ → ℕ) (m : ℕ) : phiExit k m =
    (if m = 1 then 1 else if Nat.gcd m PPtwo = 1 then m - 1 else k m) := by
  show (Bool.rec (motive := fun _ => ℕ)
      (Bool.rec (motive := fun _ => ℕ) (k m) (m - 1) (Nat.beq (Nat.gcd m PPtwo) 1))
      1 (Nat.beq m 1) : ℕ) = _
  simp only [br_eq_cond, cond_eq_ite, Nat.beq_eq]

theorem phiExit_eq {m : ℕ} (k : ℕ → ℕ) (hm : 1 ≤ m) (hB : m ≤ 2002224)
    (hk : k m = Nat.totient m) : phiExit k m = Nat.totient m := by
  rw [phiExit_def]
  by_cases h1 : m = 1
  · rw [if_pos h1, h1, Nat.totient_one]
  rw [if_neg h1]
  by_cases hg : Nat.gcd m PPtwo = 1
  · rw [if_pos hg]
    have hodd : ¬ (2 ∣ m) := by
      intro hd
      have h2g : (2:ℕ) ∣ Nat.gcd m PPtwo := Nat.dvd_gcd hd ⟨PP, PPtwo_eq⟩
      rw [hg] at h2g
      norm_num at h2g
    have hdd : Nat.gcd m PP ∣ Nat.gcd m PPtwo :=
      Nat.dvd_gcd (Nat.gcd_dvd_left _ _)
        ((Nat.gcd_dvd_right _ _).trans ⟨2, by rw [PPtwo_eq]; ring⟩)
    rw [hg] at hdd
    exact (Nat.totient_prime
      (prime_of_coprime_PP (by omega) hB hodd (Nat.dvd_one.mp hdd))).symm
  · rw [if_neg hg]; exact hk

/-- Adaptive straight-line totient: like `phiFast` but with early prime/one
