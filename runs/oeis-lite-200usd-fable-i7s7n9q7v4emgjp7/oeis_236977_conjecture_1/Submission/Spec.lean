/- ### Witness check and chunk verification -/


def checkW (n w : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool)
    false
    (Bool.rec (motive := fun _ => Bool)
      false
      (isSquare' (Nat.mul (phiFlat w) (phiFlat (Nat.sub n w))))
      (Nat.ble w (Nat.div (Nat.sub n 1) 2)))
    (Nat.ble 1 w)

theorem checkW_sound {n w : ℕ} (hn : n ≤ 2002224) (h : checkW n w = true) : 0 < a n := by
  have h' : (Bool.rec (motive := fun _ => Bool)
      false
      (Bool.rec (motive := fun _ => Bool)
        false
        (isSquare' (phiFlat w * phiFlat (n - w)))
        (Nat.ble w ((n - 1) / 2)))
      (Nat.ble 1 w)) = true := h
  simp only [br_eq_cond, cond_eq_ite, Nat.ble_eq] at h'
  by_cases hw : 1 ≤ w
  swap
  · rw [if_neg hw] at h'; exact absurd h' Bool.false_ne_true
  rw [if_pos hw] at h'
  by_cases hle : w ≤ (n - 1) / 2
  swap
  · rw [if_neg hle] at h'; exact absurd h' Bool.false_ne_true
  rw [if_pos hle] at h'
  have hnw : 1 ≤ n - w := by omega
  obtain ⟨r, hr⟩ := isSquare'_sound h'
  rw [phiFlat_eq hw (by omega), phiFlat_eq hnw (by omega)] at hr
  exact a_pos_of_witness w hw hle r hr

/-- Check `f` consecutive values starting at `n`; witness bits are consumed
only at non-free positions. -/
def checkChunk (f : ℕ) : ℕ → ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → ℕ → Bool)
    (fun _ _ => true)
    (fun _ ih n w =>
      Bool.rec (motive := fun _ => Bool)
        (Bool.rec (motive := fun _ => Bool)
          false
          (ih (Nat.add n 1) (Nat.shiftRight w 13))
          (checkW n (Nat.land w 8191)))
        (ih (Nat.add n 1) w)
        (isFree n))
    f

theorem checkChunk_succ (f n w : ℕ) : checkChunk (f + 1) n w =
    (Bool.rec (motive := fun _ => Bool)
      (Bool.rec (motive := fun _ => Bool)
        false
        (checkChunk f (n + 1) (Nat.shiftRight w 13))
        (checkW n (Nat.land w 8191)))
      (checkChunk f (n + 1) w)
      (isFree n)) := rfl

theorem checkChunk_sound : ∀ (f n w : ℕ), 9 ≤ n → n + f ≤ 2002225 → checkChunk f n w = true →
    ∀ i, i < f → 0 < a (n + i) := by
  intro f
  induction f with
  | zero => intro n w _ _ _ i hi; omega
  | succ f ih =>
    intro n w h9 hb h i hi
    rw [checkChunk_succ] at h
    cases hf : isFree n with
    | true =>
      rw [hf] at h
      have h2 : checkChunk f (n + 1) w = true := h
      cases i with
      | zero => simpa using isFree_sound h9 hf
      | succ i =>
        have := ih (n + 1) w (by omega) (by omega) h2 i (by omega)
        simpa [show n + 1 + i = n + (i + 1) by omega] using this
    | false =>
      rw [hf] at h
      cases hcw : checkW n (Nat.land w 8191) with
      | false => rw [hcw] at h; exact absurd h Bool.false_ne_true
      | true =>
        rw [hcw] at h
        have h2 : checkChunk f (n + 1) (Nat.shiftRight w 13) = true := h
        cases i with
        | zero => simpa using checkW_sound (by omega) hcw
        | succ i =>
          have := ih (n + 1) (Nat.shiftRight w 13) (by omega) (by omega) h2 i (by omega)
          simpa [show n + 1 + i = n + (i + 1) by omega] using this


theorem combine_step {B C : ℕ} (f : ∀ n, 9 ≤ n → n < B → 0 < a n)
    (g : ∀ n, B ≤ n → n < C → 0 < a n) : ∀ n, 9 ≤ n → n < C → 0 < a n :=
  fun n h1 h2 => match Nat.lt_or_ge n B with
    | .inl h => f n h1 h
    | .inr h => g n h h2


/-- `Imp b p` is `True → p` if `b = true`, else `True`.  The `True →` guard
routes kernel checking of chunk facts through the fast `whnf` path
(`ensure_pi`) rather than the slower lazy-delta `isDefEq` path, and avoids
the double evaluation done by `decide`. -/
def Imp (b : Bool) (p : Prop) : Prop :=
  Bool.rec (motive := fun _ => Prop) True (True → p) b

/-- Bounds check plus chunk check, all inside `Bool`. -/
def chunkOK (f n0 C w : ℕ) : Bool :=
  Bool.rec (motive := fun _ => Bool) false
    (Bool.rec (motive := fun _ => Bool) false
      (Bool.rec (motive := fun _ => Bool) false
        (checkChunk f n0 w)
        (Nat.beq C (Nat.add n0 f)))
      (Nat.ble (Nat.add n0 f) 2002225))
    (Nat.ble 9 n0)

theorem chunkImp (f n0 C w : ℕ) :
    Imp (chunkOK f n0 C w) (∀ n, n0 ≤ n → n < C → 0 < a n) := by
  cases hc : chunkOK f n0 C w with
  | false => exact True.intro
  | true =>
    intro _
    unfold chunkOK at hc
    simp only [br_eq_cond, cond_eq_ite, Nat.beq_eq, Nat.ble_eq, Nat.add_eq] at hc
    by_cases h9 : 9 ≤ n0
    swap
    · rw [if_neg h9] at hc; exact absurd hc Bool.false_ne_true
    rw [if_pos h9] at hc
    by_cases hb : n0 + f ≤ 2002225
    swap
    · rw [if_neg hb] at hc; exact absurd hc Bool.false_ne_true
    rw [if_pos hb] at hc
    by_cases hC : C = n0 + f
    swap
    · rw [if_neg hC] at hc; exact absurd hc Bool.false_ne_true
    rw [if_pos hC] at hc
    subst hC
    intro n h1 h2
    have := checkChunk_sound f n0 w h9 hb hc (n - n0) (by omega)
    rwa [Nat.add_sub_cancel' h1] at this


/-- Generic interval covering combinator. -/
theorem combine_gen {A B C : ℕ} (f : ∀ n, A ≤ n → n < B → 0 < a n)
    (g : ∀ n, B ≤ n → n < C → 0 < a n) : ∀ n, A ≤ n → n < C → 0 < a n :=
  fun n h1 h2 => match Nat.lt_or_ge n B with
    | .inl h => f n h1 h
    | .inr h => g n h h2

section ChunkTac
open Lean Elab Tactic Meta

/-- `chunk_tacF f n0 hi w` closes a goal `∀ n, n0 ≤ n → n < hi → 0 < a n` with
the chunk fact `chunkImp f n0 hi w True.intro`, building the proof term
directly so that all numeric verification is performed by the kernel. -/
elab "chunk_tacF " f:num n0:num hi:num w:num : tactic => do
  let lit : Nat → Expr := fun n => mkNatLit n
  let chunkPf := mkApp5 (mkConst ``A236998Aux.chunkImp) (lit f.getNat)
      (lit n0.getNat) (lit hi.getNat) (lit w.getNat) (mkConst ``True.intro)
  liftMetaTactic fun g => do g.assign chunkPf; pure []

/-- `combine_chunks m` closes `∀ n, 9 ≤ n → n < 2000393 → 0 < a n` by
combining the chunk facts `chk0, …, chk(m-1)` (each covering 2048 numbers,
except a shorter final chunk) with `combine_gen` in a balanced tree. -/
elab "combine_chunks " m:num : tactic => do
  let lit : Nat → Expr := fun v => mkNatLit v
  let bound : Nat → Nat := fun g => min (9 + 2048 * g) 2000393
  let mut arr : Array (Nat × Nat × Expr) := #[]
  for g in [0:m.getNat] do
    arr := arr.push (bound g, bound (g+1), mkConst (Name.mkStr2 "A236998Aux" s!"chk{g}"))
  while arr.size > 1 do
    let mut nxt : Array (Nat × Nat × Expr) := #[]
    let mut i := 0
    while i + 1 < arr.size do
      let (A, B, e1) := arr[i]!
      let (_, C, e2) := arr[i+1]!
      nxt := nxt.push (A, C, mkApp5 (mkConst ``A236998Aux.combine_gen) (lit A) (lit B) (lit C) e1 e2)
      i := i + 2
    if i < arr.size then
      nxt := nxt.push arr[i]!
    arr := nxt
  let (_, _, value) := arr[0]!
  liftMetaTactic fun g => do g.assign value; pure []

end ChunkTac

