open Nat Set

/--
A354747: Start with $2n-1$; repeatedly triple and add 2 until reaching a prime.
$a(n)$ = number of steps until reaching a prime $> 2n-1$, or 0 if no prime is ever reached.
Equivalently, $a(n)$ is the smallest $m \ge 1$ such that $2 \cdot n \cdot 3^m - 1$ is prime.
-/
noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

/-
The conjecture `a354747 100943 = 0` is FALSE: `2 · 100943 · 3^39101 - 1` is prime, so the set
of steps reaching a prime is nonempty and its infimum is positive.

Primality of `N = 2 · 100943 · 3^39101 - 1` (an 18662-digit number) is established by an
`N+1`-type Lucas primality test carried out in the ring `ZMod p[√3]` (Mathlib's
`LucasLehmer.X p`): we exhibit `α = 2 + √3` whose image in `X p` has order exactly
`N + 1 = 2 · 100943 · 3^39101` for every prime `p ∣ N`.  Since the unit group of `X p` has
fewer than `p²` elements, every prime factor `p` of `N` satisfies `p² > N`, whence `N` is prime.

The needed modular computations in `ℤ[√3] mod N` are certified by kernel reduction
(`decide +kernel`) of the binary-powering function `qseg` below, split into segments to
bound memory usage.
-/


/-!
# N+1 primality certificates in the ring `ZMod q[√3]`

We prove a Lucas-style (N+1) primality test using the ring `LucasLehmer.X q = ZMod q × ZMod q`
(the quadratic extension by √3), together with a kernel-computable binary powering function
`qseg` on pairs of naturals.
-/

namespace A354747

open LucasLehmer

/-- Interpret a pair of naturals in `X q = (ZMod q)[√3]`. -/
def toX (q a b : ℕ) : X q := ((a : ZMod q), (b : ZMod q))

theorem toX_fst (q a b : ℕ) : (toX q a b).1 = (a : ZMod q) := rfl
theorem toX_snd (q a b : ℕ) : (toX q a b).2 = (b : ZMod q) := rfl

theorem toX_one (q : ℕ) : toX q 1 0 = 1 := by
  apply X.ext <;> simp [toX_fst, toX_snd]

theorem natCast_mod_of_dvd {q N : ℕ} (h : q ∣ N) (a : ℕ) :
    ((a % N : ℕ) : ZMod q) = (a : ZMod q) := by
  have hN : (N : ZMod q) = 0 := (CharP.cast_eq_zero_iff (ZMod q) q N).2 h
  conv_rhs => rw [← Nat.div_add_mod a N]
  push_cast
  rw [hN]
  ring

theorem toX_mul {q N : ℕ} (h : q ∣ N) (ax ay bx bY : ℕ) :
    toX q ((ax * bx + 3 * (ay * bY)) % N) ((ax * bY + ay * bx) % N)
      = toX q ax ay * toX q bx bY := by
  apply X.ext
  · rw [toX_fst, X.mul_fst, natCast_mod_of_dvd h, toX_fst, toX_fst, toX_snd, toX_snd]
    push_cast
    ring
  · rw [toX_snd, X.mul_snd, natCast_mod_of_dvd h, toX_fst, toX_fst, toX_snd, toX_snd]
    push_cast
    ring

/-- One step of binary powering in `ℤ[√3] mod N` on ℕ-pairs; processes exactly `F` bits
of the exponent `e` (LSB first).  Returns `(base^(2^F), base^(e % 2^F) * acc)` as
`(bx', by', cx', cy')`.  Written with `Nat.rec` and `cond`-forcing for efficient
kernel reduction. -/
def qseg (N : ℕ) : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ × ℕ × ℕ × ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ → ℕ → ℕ → ℕ → ℕ × ℕ × ℕ × ℕ)
    (fun _e bx bY cx cy => (bx, bY, cx, cy))
    (fun _ ih e bx bY cx cy =>
      let cx' := cond ((e % 2).beq 1) ((bx * cx + 3 * (bY * cy)) % N) cx
      let cy' := cond ((e % 2).beq 1) ((bx * cy + bY * cx) % N) cy
      let bx' := (bx * bx + 3 * (bY * bY)) % N
      let by' := (bx * bY + bY * bx) % N
      cond ((cx' + cy' + bx' + by').beq 0)
        (ih (e / 2) bx' by' cx' cy')
        (ih (e / 2) bx' by' cx' cy'))

theorem qseg_zero (N e bx bY cx cy : ℕ) :
    qseg N 0 e bx bY cx cy = (bx, bY, cx, cy) := rfl

theorem qseg_succ (N F e bx bY cx cy : ℕ) :
    qseg N (F + 1) e bx bY cx cy =
      qseg N F (e / 2) ((bx * bx + 3 * (bY * bY)) % N) ((bx * bY + bY * bx) % N)
        (cond ((e % 2).beq 1) ((bx * cx + 3 * (bY * cy)) % N) cx)
        (cond ((e % 2).beq 1) ((bx * cy + bY * cx) % N) cy) := by
  show cond _ _ _ = _
  rw [Bool.cond_self _ _]
  rfl

theorem qseg_spec {q N : ℕ} (hq : q ∣ N) :
    ∀ (F e bx bY cx cy : ℕ),
      toX q (qseg N F e bx bY cx cy).1 (qseg N F e bx bY cx cy).2.1
          = (toX q bx bY) ^ (2 ^ F)
      ∧ toX q (qseg N F e bx bY cx cy).2.2.1 (qseg N F e bx bY cx cy).2.2.2
          = (toX q bx bY) ^ (e % 2 ^ F) * toX q cx cy := by
  intro F
  induction F with
  | zero =>
    intro e bx bY cx cy
    rw [qseg_zero]
    constructor
    · simp
    · simp [Nat.mod_one]
  | succ F ih =>
    intro e bx bY cx cy
    rw [qseg_succ]
    have hsq : toX q ((bx * bx + 3 * (bY * bY)) % N) ((bx * bY + bY * bx) % N)
        = toX q bx bY * toX q bx bY := toX_mul hq bx bY bx bY
    have hmod : e % 2 ^ (F + 1) = e % 2 + 2 * (e / 2 % 2 ^ F) := by
      rw [pow_succ']
      exact Nat.mod_mul
    obtain ⟨ihb, ihc⟩ := ih (e / 2)
      ((bx * bx + 3 * (bY * bY)) % N) ((bx * bY + bY * bx) % N)
      (cond ((e % 2).beq 1) ((bx * cx + 3 * (bY * cy)) % N) cx)
      (cond ((e % 2).beq 1) ((bx * cy + bY * cx) % N) cy)
    constructor
    · rw [ihb, hsq, ← sq, ← pow_mul, pow_succ, mul_comm (2 ^ F) 2]
    · rw [ihc, hsq, ← sq, ← pow_mul, hmod]
      rcases Nat.mod_two_eq_zero_or_one e with h | h
      · rw [h]
        have hb : ((0 : ℕ).beq 1) = false := rfl
        simp only [hb, cond_false]
        rw [pow_add, pow_mul]
        ring
      · rw [h]
        have hb : ((1 : ℕ).beq 1) = true := rfl
        simp only [hb, cond_true]
        rw [toX_mul hq, pow_add, pow_mul]
        ring

/-- Convenient form: consume a kernel-checked evaluation of `qseg`. -/
theorem qseg_spec' {q N : ℕ} (hq : q ∣ N) (F e bx bY cx cy rbx rby rcx rcy : ℕ)
    (h : qseg N F e bx bY cx cy = (rbx, rby, rcx, rcy)) :
    toX q rbx rby = (toX q bx bY) ^ (2 ^ F)
    ∧ toX q rcx rcy = (toX q bx bY) ^ (e % 2 ^ F) * toX q cx cy := by
  have hs := qseg_spec (q := q) hq F e bx bY cx cy
  rw [h] at hs
  exact hs

/-- Gluing step for chained powering, with explicit accumulated exponents. -/
theorem glue' {M : Type*} [CommMonoid M] (α b c b' c' : M) (t s F e T S : ℕ)
    (hb : b = α ^ t) (hc : c = α ^ s)
    (hb' : b' = b ^ 2 ^ F) (hc' : c' = b ^ (e % 2 ^ F) * c)
    (hT : t * 2 ^ F = T) (hS : t * (e % 2 ^ F) + s = S) :
    b' = α ^ T ∧ c' = α ^ S := by
  subst hT hS hb hc
  constructor
  · rw [hb', ← pow_mul]
  · rw [hc', ← pow_mul, ← pow_add]

/-- The (N+1)-test: if some `α = toX p P Q` has order `N+1` in every `X p` for `p ∣ N` prime
(certified by `α^(N+1) = 1` together with, for every prime `r ∣ N+1`, data `x y` with
`α^((N+1)/r) = toX p x y` and `gcd(gcd(x + (N-1), y), N) = 1`), then `N` is prime. -/
theorem prime_of_cert (N P Q : ℕ) (hN : 2 ≤ N)
    (h1 : ∀ p : ℕ, p.Prime → p ∣ N → (toX p P Q) ^ (N + 1) = 1)
    (h2 : ∀ r : ℕ, r.Prime → r ∣ N + 1 → ∃ x y : ℕ,
        (∀ p : ℕ, p.Prime → p ∣ N → (toX p P Q) ^ ((N + 1) / r) = toX p x y)
        ∧ Nat.gcd (Nat.gcd (x + (N - 1)) y) N = 1) :
    N.Prime := by
  by_contra hnp
  set p := N.minFac with hp
  have pp : p.Prime := Nat.minFac_prime (by omega)
  have pdvd : p ∣ N := Nat.minFac_dvd N
  have hpsq : p ^ 2 ≤ N := Nat.minFac_sq_le_self (by omega) hnp
  have hp1 : 1 < p := pp.one_lt
  haveI : NeZero p := ⟨by omega⟩
  -- α as a unit of X p
  have hα1 : (toX p P Q) ^ (N + 1) = 1 := h1 p pp pdvd
  have hmul : (toX p P Q) * (toX p P Q) ^ N = 1 := by
    rw [← _root_.pow_succ']
    exact hα1
  let u : (X p)ˣ := Units.mkOfMulEqOne _ _ hmul
  have hu : (u : X p) = toX p P Q := rfl
  have hu1 : u ^ (N + 1) = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, hu, hα1, Units.val_one]
  have hdiv : ∀ r : ℕ, r.Prime → r ∣ N + 1 → u ^ ((N + 1) / r) ≠ 1 := by
    intro r hr hrd heq
    obtain ⟨x, y, hxy, hg⟩ := h2 r hr hrd
    have hxy1 : toX p x y = 1 := by
      rw [← hxy p pp pdvd, ← hu, ← Units.val_pow_eq_pow_val, heq, Units.val_one]
    have hx : (x : ZMod p) = 1 := by
      have := congrArg Prod.fst hxy1
      simpa [toX] using this
    have hy : (y : ZMod p) = 0 := by
      have := congrArg Prod.snd hxy1
      simpa [toX] using this
    have hNp : (N : ZMod p) = 0 := (CharP.cast_eq_zero_iff (ZMod p) p N).2 pdvd
    have hN1 : ((N - 1 : ℕ) : ZMod p) = -1 := by
      have hadd : (N - 1) + 1 = N := by omega
      have := congrArg (Nat.cast : ℕ → ZMod p) hadd
      push_cast at this
      rw [hNp] at this
      linear_combination this
    have hx1 : ((x + (N - 1) : ℕ) : ZMod p) = 0 := by
      push_cast
      rw [hx, hN1]
      ring
    have d1 : p ∣ x + (N - 1) := (CharP.cast_eq_zero_iff (ZMod p) p _).1 hx1
    have d2 : p ∣ y := (CharP.cast_eq_zero_iff (ZMod p) p _).1 hy
    have : p ∣ 1 := hg ▸ Nat.dvd_gcd (Nat.dvd_gcd d1 d2) pdvd
    have := Nat.le_of_dvd one_pos this
    omega
  have horder : orderOf u = N + 1 :=
    orderOf_eq_of_pow_and_pow_div_prime (by omega) hu1 hdiv
  have hle : N + 1 ≤ Fintype.card (X p)ˣ := horder ▸ orderOf_le_card_univ
  have hlt : Fintype.card (X p)ˣ < p ^ 2 := X.card_units_lt hp1
  omega

