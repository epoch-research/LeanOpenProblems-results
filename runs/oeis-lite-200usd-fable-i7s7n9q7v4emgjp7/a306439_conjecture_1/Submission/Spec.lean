/-- Box bounds for coefficients of a terminal even positive definite form of det 42. -/
lemma tm_box (A0 B0 C0 D0 E0 F0 : ℤ)
    (hT1 : 4*F0^2 ≤ A0^2) (hT2e : 4*E0^2 ≤ A0^2)
    (hT2d : 4*(A0*D0 - E0*F0)^2 ≤ (A0*B0 - F0^2)^2)
    (hT3 : A0 ≤ B0) (hT4 : A0*B0 - F0^2 ≤ A0*C0 - E0^2)
    (ha : 0 < A0) (hc : 0 < C0) (hD2 : 0 < A0*B0 - F0^2)
    (ha2' : A0 % 2 = 0) (hb2' : B0 % 2 = 0) (hc2' : C0 % 2 = 0)
    (hdet : A0*B0*C0 + 2*F0*E0*D0 - A0*D0^2 - B0*E0^2 - C0*F0^2 = 42) :
    (A0 = 2 ∨ A0 = 4) ∧ 1 ≤ B0 ∧ B0 ≤ 5 ∧ 1 ≤ C0 ∧ C0 ≤ 17 ∧
    -3 ≤ D0 ∧ D0 ≤ 3 ∧ -2 ≤ E0 ∧ E0 ≤ 2 ∧ -2 ≤ F0 ∧ F0 ≤ 2 := by
  have haa : 2 ≤ A0 := by omega
  have hAB : A0*A0 ≤ A0*B0 := mul_le_mul_of_nonneg_left hT3 ha.le
  have h3a2 : 3*A0^2 ≤ 4*(A0*B0 - F0^2) := by linarith [hAB, hT1]
  have hdetid : 42*A0 = (A0*B0 - F0^2)*(A0*C0 - E0^2) - (A0*D0 - E0*F0)^2 := by
    linear_combination (-A0) * hdet
  have hPQ : (A0*B0 - F0^2)*(A0*B0 - F0^2) ≤ (A0*B0 - F0^2)*(A0*C0 - E0^2) :=
    mul_le_mul_of_nonneg_left hT4 hD2.le
  have h56 : 3*(A0*B0 - F0^2)^2 ≤ 168*A0 := by linarith [hdetid, hT2d, hPQ]
  have ha4 : A0 ≤ 4 := by
    by_contra hcon
    push_neg at hcon
    have h5 : 5 ≤ A0 := hcon
    have h9 : (3*A0^2)*(3*A0^2) ≤ (4*(A0*B0 - F0^2))*(4*(A0*B0 - F0^2)) :=
      mul_le_mul h3a2 h3a2 (by positivity) (by linarith [hD2])
    have h25 : 5*5 ≤ A0*A0 := mul_le_mul h5 h5 (by norm_num) ha.le
    have h125 : (5*5)*A0 ≤ (A0*A0)*A0 := mul_le_mul_of_nonneg_right h25 ha.le
    have hA4 : ((5*5)*A0)*A0 ≤ ((A0*A0)*A0)*A0 := mul_le_mul_of_nonneg_right h125 ha.le
    have h5A : 5*A0 ≤ A0*A0 := mul_le_mul_of_nonneg_right h5 ha.le
    linarith [h9, h56, hA4, h5A, ha]
  have hD214 : A0*B0 - F0^2 ≤ 14 := by
    by_contra hcon
    push_neg at hcon
    have h15 : (15:ℤ) ≤ A0*B0 - F0^2 := by linarith
    have hPP : 15*(A0*B0 - F0^2) ≤ (A0*B0 - F0^2)*(A0*B0 - F0^2) :=
      mul_le_mul_of_nonneg_right h15 hD2.le
    linarith [hPP, h56, ha4, h15]
  have h4A : 2*2 ≤ A0*A0 := mul_le_mul haa haa (by norm_num) ha.le
  have hD23 : 3 ≤ A0*B0 - F0^2 := by linarith [h4A, h3a2]
  have hAA16 : A0*A0 ≤ 4*4 := mul_le_mul ha4 ha4 ha.le (by norm_num)
  have hf2 : F0^2 ≤ 4 := by linarith [hT1, hAA16]
  have he2 : E0^2 ≤ 4 := by linarith [hT2e, hAA16]
  have hB0 : (0:ℤ) ≤ B0 := by linarith [hT3, haa]
  have h2B : 2*B0 ≤ A0*B0 := mul_le_mul_of_nonneg_right haa hB0
  have hb9 : B0 ≤ 9 := by linarith [h2B, hD214, hf2]
  have hPP196 : (A0*B0 - F0^2)*(A0*B0 - F0^2) ≤ 14*14 :=
    mul_le_mul hD214 hD214 hD2.le (by norm_num)
  have hadef : (A0*D0 - E0*F0)^2 ≤ 49 := by linarith [hT2d, hPP196]
  have hacepos : 0 ≤ A0*C0 - E0^2 := by linarith [hT4, hD2]
  have h3Q : 3*(A0*C0 - E0^2) ≤ (A0*B0 - F0^2)*(A0*C0 - E0^2) :=
    mul_le_mul_of_nonneg_right hD23 hacepos
  have hace : A0*C0 - E0^2 ≤ 72 := by linarith [h3Q, hdetid, hadef, ha4]
  have h2C : 2*C0 ≤ A0*C0 := mul_le_mul_of_nonneg_right haa hc.le
  have hc38 : C0 ≤ 38 := by linarith [h2C, hace, he2]
  have hfb : F0 ≤ 2 ∧ -2 ≤ F0 := by
    constructor
    · by_contra hcon; push_neg at hcon
      have h9F : 3*3 ≤ F0*F0 :=
        mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
      linarith [h9F, hf2]
    · by_contra hcon; push_neg at hcon
      have h9F : 3*3 ≤ (-F0)*(-F0) :=
        mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
      linarith [h9F, hf2]
  have heb : E0 ≤ 2 ∧ -2 ≤ E0 := by
    constructor
    · by_contra hcon; push_neg at hcon
      have h9E : 3*3 ≤ E0*E0 :=
        mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
      linarith [h9E, he2]
    · by_contra hcon; push_neg at hcon
      have h9E : 3*3 ≤ (-E0)*(-E0) :=
        mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
      linarith [h9E, he2]
  have hef : E0*F0 ≤ 4 ∧ -4 ≤ E0*F0 := by
    constructor
    · linarith [he2, hf2, sq_nonneg (E0 - F0)]
    · linarith [he2, hf2, sq_nonneg (E0 + F0)]
  have h7a : A0*D0 - E0*F0 ≤ 7 := by
    by_contra hcon; push_neg at hcon
    have h64 : 8*8 ≤ (A0*D0 - E0*F0)*(A0*D0 - E0*F0) :=
      mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
    linarith [h64, hadef]
  have h7b : -7 ≤ A0*D0 - E0*F0 := by
    by_contra hcon; push_neg at hcon
    have h64 : 8*8 ≤ (-(A0*D0 - E0*F0))*(-(A0*D0 - E0*F0)) :=
      mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
    linarith [h64, hadef]
  have had : A0*D0 ≤ 11 ∧ -11 ≤ A0*D0 := by
    constructor <;> linarith [hef.1, hef.2]
  have hd5 : D0 ≤ 5 ∧ -5 ≤ D0 := by
    constructor
    · by_contra hcon; push_neg at hcon
      have h12 : 2*6 ≤ A0*D0 := mul_le_mul haa (by linarith) (by norm_num) ha.le
      linarith [h12, had.1]
    · by_contra hcon; push_neg at hcon
      have h12 : 2*6 ≤ A0*(-D0) := mul_le_mul haa (by linarith) (by norm_num) ha.le
      linarith [h12, had.2]
  have hb1 : 1 ≤ B0 := by omega
  have hc1 : 1 ≤ C0 := by omega
  -- tighter bounds for the small enumeration box
  have ha24 : A0 = 2 ∨ A0 = 4 := by omega
  have hkey : B0 ≤ 5 ∧ C0 ≤ 17 ∧ -3 ≤ D0 ∧ D0 ≤ 3 := by
    rcases ha24 with h2 | h4
    · subst h2
      have hf1 : F0^2 ≤ 1 := by linarith [hT1]
      have he1 : E0^2 ≤ 1 := by linarith [hT2e]
      have hef1 : E0*F0 ≤ 1 ∧ -1 ≤ E0*F0 := by
        constructor
        · linarith [hf1, he1, sq_nonneg (E0 - F0)]
        · linarith [hf1, he1, sq_nonneg (E0 + F0)]
      have hP10 : 2*B0 - F0^2 ≤ 10 := by
        by_contra hcon
        push_neg at hcon
        have h11 : (11:ℤ) ≤ 2*B0 - F0^2 := by linarith
        have hP11 : 11*(2*B0 - F0^2) ≤ (2*B0 - F0^2)*(2*B0 - F0^2) :=
          mul_le_mul_of_nonneg_right h11 (by linarith [hD2])
        linarith [hP11, h56, h11]
      have hB5 : B0 ≤ 5 := by
        have h11 : 2*B0 ≤ 11 := by linarith [hf1, hP10]
        omega
      refine ⟨hB5, ?_, ?_, ?_⟩
      · -- C0 ≤ 17
        by_contra hcon
        push_neg at hcon
        have hX : 35 ≤ 2*C0 - E0^2 := by linarith [he1]
        have hQ35 : (2*B0 - F0^2)*35 ≤ (2*B0 - F0^2)*(2*C0 - E0^2) :=
          mul_le_mul_of_nonneg_left hX (by linarith [hD2])
        have hprod : 0 ≤ ((2*B0 - F0^2) - 3)*(10 - (2*B0 - F0^2)) :=
          mul_nonneg (by linarith [hD23]) (by linarith [hP10])
        linarith [hprod, hQ35, hdetid, hT2d, hD23]
      · -- -3 ≤ D0
        by_contra hcon
        push_neg at hcon
        have hZ : 2*D0 - E0*F0 ≤ -7 := by linarith [hef1.2]
        have hZZ : 0 ≤ (-(2*D0 - E0*F0) - 7)*(-(2*D0 - E0*F0) + 7) :=
          mul_nonneg (by linarith) (by linarith)
        have hprod : 0 ≤ ((2*B0 - F0^2) - 3)*(10 - (2*B0 - F0^2)) :=
          mul_nonneg (by linarith [hD23]) (by linarith [hP10])
        linarith [hT2d, hZZ, hprod, hP10, hD23]
      · -- D0 ≤ 3
        by_contra hcon
        push_neg at hcon
        have hZ : 7 ≤ 2*D0 - E0*F0 := by linarith [hef1.1]
        have hZZ : 0 ≤ ((2*D0 - E0*F0) - 7)*((2*D0 - E0*F0) + 7) :=
          mul_nonneg (by linarith) (by linarith)
        have hprod : 0 ≤ ((2*B0 - F0^2) - 3)*(10 - (2*B0 - F0^2)) :=
          mul_nonneg (by linarith [hD23]) (by linarith [hP10])
        linarith [hT2d, hZZ, hprod, hP10, hD23]
    · subst h4
      have hD212 : 12 ≤ 4*B0 - F0^2 := by linarith [h3a2]
      have hB5' : B0 ≤ 4 := by
        have h18 : 4*B0 ≤ 18 := by linarith [hD214, hf2]
        omega
      refine ⟨by omega, ?_, ?_, ?_⟩
      · -- C0 ≤ 17
        by_contra hcon
        push_neg at hcon
        have hX : 68 ≤ 4*C0 - E0^2 := by linarith [he2]
        have hprod : 0 ≤ ((4*B0 - F0^2) - 12)*((4*C0 - E0^2) - 68) :=
          mul_nonneg (by linarith [hD212]) (by linarith [hX])
        linarith [hprod, hdetid, hT2d, hPP196, hD212, hX]
      · -- -3 ≤ D0
        by_contra hcon
        push_neg at hcon
        have hZ : 4*D0 - E0*F0 ≤ -12 := by linarith [hef.2]
        have hZZ : 0 ≤ (-(4*D0 - E0*F0) - 12)*(-(4*D0 - E0*F0) + 12) :=
          mul_nonneg (by linarith) (by linarith)
        linarith [hadef, hZZ]
      · -- D0 ≤ 3
        by_contra hcon
        push_neg at hcon
        have hZ : 12 ≤ 4*D0 - E0*F0 := by linarith [hef.1]
        have hZZ : 0 ≤ ((4*D0 - E0*F0) - 12)*((4*D0 - E0*F0) + 12) :=
          mul_nonneg (by linarith) (by linarith)
        linarith [hadef, hZZ]
  obtain ⟨hb5, hc17, hd3l, hd3r⟩ := hkey
  exact ⟨ha24, hb1, hb5, hc1, hc17, hd3l, hd3r, heb.2, heb.1, hfb.2, hfb.1⟩

end TForm

