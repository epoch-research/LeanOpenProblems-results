/--
The generalized pentagonal number $k(3k+1)/2$ for $k \ge 0$.
-/
noncomputable def P3 (k : ℕ) : ℕ := k * (3 * k + 1) / 2

/--
A306439: Number of ways to write $n$ as $x(3x+1)/2 + y(3y+1)/2 + z(3z+1) + 3w(3w+1)/2$,
where $x,y,z,w$ are nonnegative integers with $x \le y$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  let B := n + 1
  let RangeB := range B

  -- The domain of search is (RangeB x RangeB) x (RangeB x RangeB).
  let search_space : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
    (RangeB.product RangeB).product (RangeB.product RangeB)

  (search_space.filter (fun p =>
    let x := p.fst.fst
    let y := p.fst.snd
    let z := p.snd.fst
    let w := p.snd.snd
    -- The equation is P3(x) + P3(y) + 2*P3(z) + 3*P3(w) = n.
    x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w
  )).card

/-- computable version of P3 -/
def p3 (k : ℕ) : ℕ := k * (3 * k + 1) / 2

lemma P3_eq_p3 : P3 = p3 := rfl

lemma p3_two_mul (k : ℕ) : 2 * p3 k = k * (3 * k + 1) := by
  have h : 2 ∣ k * (3 * k + 1) := by
    rcases Nat.even_or_odd k with h | h
    · exact Dvd.dvd.mul_right (even_iff_two_dvd.mp h) _
    · refine Dvd.dvd.mul_left ?_ _
      rcases h with ⟨j, hj⟩
      exact ⟨3 * j + 2, by omega⟩
  exact Nat.mul_div_cancel' h

lemma self_le_p3 (k : ℕ) : k ≤ p3 k := by
  have h2 : 2 * p3 k = k * (3 * k + 1) := p3_two_mul k
  nlinarith [Nat.zero_le k]

/-- Membership criterion for the filter defining `a`. -/
lemma mem_a_filter (n x y z w : ℕ) (hxy : x ≤ y)
    (h : n = P3 x + P3 y + 2 * P3 z + 3 * P3 w) :
    ((x, y), (z, w)) ∈ (((range (n+1)).product (range (n+1))).product
      ((range (n+1)).product (range (n+1)))).filter (fun p =>
        p.1.1 ≤ p.1.2 ∧ n = P3 p.1.1 + P3 p.1.2 + 2 * P3 p.2.1 + 3 * P3 p.2.2) := by
  rw [Finset.mem_filter]
  have hx : x ≤ n := by
    have := self_le_p3 x; rw [P3_eq_p3] at h; omega
  have hy : y ≤ n := by
    have := self_le_p3 y; rw [P3_eq_p3] at h; omega
  have hz : z ≤ n := by
    have := self_le_p3 z; rw [P3_eq_p3] at h; omega
  have hw : w ≤ n := by
    have := self_le_p3 w; rw [P3_eq_p3] at h; omega
  exact ⟨Finset.mem_product.mpr ⟨Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr (by omega : x < n + 1), Finset.mem_range.mpr (by omega : y < n + 1)⟩,
    Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr (by omega : z < n + 1), Finset.mem_range.mpr (by omega : w < n + 1)⟩⟩,
    hxy, h⟩

/-- One valid quadruple gives `a n > 0`. -/
lemma a_pos_of_witness (n x y z w : ℕ) (hxy : x ≤ y)
    (h : n = P3 x + P3 y + 2 * P3 z + 3 * P3 w) : 0 < a n := by
  rw [a]
  refine Finset.card_pos.mpr ⟨((x,y),(z,w)), ?_⟩
  exact mem_a_filter n x y z w hxy h

/-- Two distinct valid quadruples give `a n ≥ 2`. -/
lemma a_ge_two_of_witnesses (n x₁ y₁ z₁ w₁ x₂ y₂ z₂ w₂ : ℕ)
    (hxy₁ : x₁ ≤ y₁) (h₁ : n = P3 x₁ + P3 y₁ + 2 * P3 z₁ + 3 * P3 w₁)
    (hxy₂ : x₂ ≤ y₂) (h₂ : n = P3 x₂ + P3 y₂ + 2 * P3 z₂ + 3 * P3 w₂)
    (hne : ((x₁,y₁),(z₁,w₁)) ≠ ((x₂,y₂),(z₂,w₂)) ) : 2 ≤ a n := by
  rw [a]
  refine Finset.one_lt_card.mpr ⟨_, mem_a_filter n x₁ y₁ z₁ w₁ hxy₁ h₁,
    _, mem_a_filter n x₂ y₂ z₂ w₂ hxy₂ h₂, hne⟩

lemma p3_le_41 {x : ℕ} (h : p3 x ≤ 41) : x < 6 := by
  by_contra hx
  push_neg at hx
  have h2 : 2 * p3 x = x * (3 * x + 1) := p3_two_mul x
  nlinarith

lemma a_eq_zero_small (n : ℕ) (hn : n ≤ 41)
    (h : ∀ x < 6, ∀ y < 6, ∀ z < 6, ∀ w < 6,
      ¬(x ≤ y ∧ n = p3 x + p3 y + 2 * p3 z + 3 * p3 w)) :
    a n = 0 := by
  rw [a]
  refine Finset.card_eq_zero.mpr (Finset.filter_eq_empty_iff.mpr ?_)
  rintro ⟨⟨x, y⟩, z, w⟩ hp
  intro hc
  have hc' : x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w := hc
  obtain ⟨hxy, heq⟩ := hc'
  have heq' : n = p3 x + p3 y + 2 * p3 z + 3 * p3 w := heq
  have hx : x < 6 := p3_le_41 (by omega)
  have hy : y < 6 := p3_le_41 (by omega)
  have hz : z < 6 := p3_le_41 (by omega)
  have hw : w < 6 := p3_le_41 (by omega)
  exact h x hx y hy z hz w hw ⟨hxy, heq'⟩

lemma a_eq_one_small (n : ℕ) (hn : n ≤ 41) (x₀ y₀ z₀ w₀ : ℕ) (hxy₀ : x₀ ≤ y₀)
    (heq₀ : n = p3 x₀ + p3 y₀ + 2 * p3 z₀ + 3 * p3 w₀)
    (huniq : ∀ x < 6, ∀ y < 6, ∀ z < 6, ∀ w < 6,
      x ≤ y → n = p3 x + p3 y + 2 * p3 z + 3 * p3 w →
      x = x₀ ∧ y = y₀ ∧ z = z₀ ∧ w = w₀) :
    a n = 1 := by
  rw [a]
  refine Finset.card_eq_one.mpr ⟨((x₀, y₀), (z₀, w₀)),
    Finset.eq_singleton_iff_unique_mem.mpr ⟨mem_a_filter n x₀ y₀ z₀ w₀ hxy₀ heq₀, ?_⟩⟩
  rintro ⟨⟨x, y⟩, z, w⟩ hp
  rw [Finset.mem_filter] at hp
  have hc' : x ≤ y ∧ n = P3 x + P3 y + 2 * P3 z + 3 * P3 w := hp.2
  obtain ⟨hxy, heq⟩ := hc'
  have heq' : n = p3 x + p3 y + 2 * p3 z + 3 * p3 w := heq
  have hx : x < 6 := p3_le_41 (by omega)
  have hy : y < 6 := p3_le_41 (by omega)
  have hz : z < 6 := p3_le_41 (by omega)
  have hw : w < 6 := p3_le_41 (by omega)
  obtain ⟨ex, ey, ez, ew⟩ := huniq x hx y hy z hz w hw hxy heq'
  subst ex ey ez ew
  rfl
