theorem a_ge_two_large (n : ℕ) (hn : 42 ≤ n) : 2 ≤ a n := by
  by_cases h7 : 7 ∣ n
  · by_cases hs : n ≤ 30041
    · exact witA_cover n hn hs
    · by_cases hs2 : n ≤ 399994
      · exact witB_cover n h7 (by omega) hs2
      · obtain ⟨n', rfl⟩ := h7
        exact two_wit_7 n' (by omega)
  · by_cases hs : n ≤ 30041
    · exact witA_cover n hn hs
    · exact two_wit_not7 n h7 (by omega)

