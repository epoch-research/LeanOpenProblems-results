/-- Any terminal even positive-definite form of determinant 42 is in the list. -/
lemma terminal_mem {τ : TForm} (ht : Terminal τ) (hpd : PosDef τ) (hev : EvenD τ)
    (hdet : τ.det = 42) : τ ∈ stdForms := by
  obtain ⟨A0, B0, C0, D0, E0, F0⟩ := τ
  obtain ⟨hT1, hT2e, hT2d, hT3, hT4⟩ := ht
  have ha := posDef_a hpd
  have hc := posDef_c hpd
  have hD2 := posDef_D2 hpd
  obtain ⟨ha2, hb2, hc2⟩ := hev
  simp only [det] at hdet
  dsimp only at hT1 hT2e hT2d hT3 hT4 ha hc hD2 ha2 hb2 hc2
  have ha2' : A0 % 2 = 0 := Int.even_iff.mp ha2
  have hb2' : B0 % 2 = 0 := Int.even_iff.mp hb2
  have hc2' : C0 % 2 = 0 := Int.even_iff.mp hc2
  obtain ⟨ha24, hb1, hb5, hc1, hc17, hd3l, hd3r, hel, heu, hfl, hfu⟩ :=
    tm_box A0 B0 C0 D0 E0 F0 hT1 hT2e hT2d hT3 hT4 ha hc hD2 ha2' hb2' hc2' hdet
  have haA : 2 ≤ A0 ∧ A0 ≤ 4 := by rcases ha24 with h|h <;> exact ⟨by omega, by omega⟩
  obtain ⟨A, cA⟩ : ∃ A : ℕ, (A:ℤ) = A0 - 1 :=
    ⟨(A0 - 1).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨B, cB⟩ : ∃ B : ℕ, (B:ℤ) = B0 - 1 :=
    ⟨(B0 - 1).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨C, cC⟩ : ∃ C : ℕ, (C:ℤ) = C0 - 1 :=
    ⟨(C0 - 1).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨D, cD⟩ : ∃ D : ℕ, (D:ℤ) = D0 + 5 :=
    ⟨(D0 + 5).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨E, cE⟩ : ∃ E : ℕ, (E:ℤ) = E0 + 2 :=
    ⟨(E0 + 2).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨F, cF⟩ : ∃ F : ℕ, (F:ℤ) = F0 + 2 :=
    ⟨(F0 + 2).toNat, Int.toNat_of_nonneg (by omega)⟩
  have n1 : A % 2 = 1 := by omega
  have n2 : B % 2 = 1 := by omega
  have n3 : C % 2 = 1 := by omega
  have bA : A ≤ 3 := by omega
  have bB : B ≤ 4 := by omega
  have bC : C ≤ 16 := by omega
  have bD2 : 2 ≤ D := by omega
  have bD8 : D ≤ 8 := by omega
  have bE : E ≤ 4 := by omega
  have bF : F ≤ 4 := by omega
  have n4 : 4*F^2 + 16 ≤ A^2 + 2*A + 16*F + 1 := by
    zify
    rw [cA, cF]
    linarith [hT1]
  have n5 : 4*E^2 + 16 ≤ A^2 + 2*A + 16*E + 1 := by
    zify
    rw [cA, cE]
    linarith [hT2e]
  have n6 : 4*A^2*D^2 + 100*A^2 + 2*A*B*F^2 + 4*A*B + 8*A*D^2 + 16*A*D*E
        + 16*A*D*F + 40*A*E*F + 2*A*F^2 + 366*A + 2*B*F^2 + 6*B + 4*D^2
        + 16*D*E + 16*D*F + 4*E^2*F^2 + 16*E^2 + 104*E*F + 8*F^3 + 16*F^2
        + 24*F + 324
        ≤ A^2*B^2 + 2*A^2*B + 40*A^2*D + A^2 + 2*A*B^2 + 8*A*B*F
        + 8*A*D*E*F + 112*A*D + 80*A*E + 88*A*F + B^2 + 8*B*F + 8*D*E*F
        + 72*D + 16*E^2*F + 16*E*F^2 + 144*E + F^4 + 22*F^2 + 144*F + 9 := by
    zify
    rw [cA, cB, cD, cE, cF]
    linarith [hT2d]
  have n7 : A ≤ B := by omega
  have n8 : A*B + A + B + E^2 + 4*F + 3 ≤ A*C + A + C + 4*E + F^2 + 3 := by
    zify
    rw [cA, cB, cC, cE, cF]
    linarith [hT4]
  have n9 : A*B*C + A*B + A*C + 10*A*D + B*C + 4*B*E + 4*C*F + 2*D*E*F
        + 18*D + 24*E + 24*F
        = A*D^2 + 24*A + B*E^2 + 3*B + C*F^2 + 3*C + D^2 + 4*D*E + 4*D*F
        + E^2 + 10*E*F + F^2 + 114 := by
    zify
    rw [cA, cB, cC, cD, cE, cF]
    linear_combination hdet
  have hcodes := tm_enum A B C D E F bA bB bC bD2 bD8 bE bF n1 n2 n3 n4 n5 n6 n7 n8 n9
  clear n4 n5 n6 n7 n8 n9 hT1 hT2e hT2d hT3 hT4 hdet hpd n1 n2 n3 bA bB bC bD2 bD8 bE bF
  rcases hcodes with h|h|h|h|h|h|h|h
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 2 ∧ C0 = 14 ∧ D0 = 0 ∧ E0 = 0 ∧ F0 = -1 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 2 ∧ C0 = 14 ∧ D0 = 0 ∧ E0 = 0 ∧ F0 = 1 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 4 ∧ C0 = 6 ∧ D0 = 0 ∧ E0 = 0 ∧ F0 = -1 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 4 ∧ C0 = 6 ∧ D0 = 0 ∧ E0 = 0 ∧ F0 = 1 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 4 ∧ C0 = 6 ∧ D0 = -1 ∧ E0 = -1 ∧ F0 = 0 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 4 ∧ C0 = 6 ∧ D0 = 1 ∧ E0 = -1 ∧ F0 = 0 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 4 ∧ C0 = 6 ∧ D0 = -1 ∧ E0 = 1 ∧ F0 = 0 := by omega
    decide
  · obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ :
        A0 = 2 ∧ B0 = 4 ∧ C0 = 6 ∧ D0 = 1 ∧ E0 = 1 ∧ F0 = 0 := by omega
    decide

/-- **Classification**: an even positive definite ternary form of determinant 42
representing some value `≡ 12 (mod 18)` represents only values that `C1` represents. -/
theorem key_classification {σ : TForm} (hpd : PosDef σ) (hev : EvenD σ) (hdet : σ.det = 42)
    (hsep : ∃ u : ℤ, σ.Represents u ∧ u % 18 = 12) :
    ∀ n, σ.Represents n → C1.Represents n := by
  obtain ⟨τ, hpdτ, htermτ, hdetτ, hsv, hevτ⟩ :=
    exists_terminal (pot σ).toNat σ le_rfl hpd
  have hmem : τ ∈ stdForms :=
    terminal_mem htermτ hpdτ (hevτ hev) (by rw [hdetτ, hdet])
  obtain ⟨u, hru, hu18⟩ := hsep
  intro n hn
  exact stdForms_represent hmem ⟨u, (hsv u).mp hru, hu18⟩ n ((hsv n).mp hn)

end TForm

/-! # Construction of an auxiliary form representing 2m -/


namespace TForm

/-- The assembled form `H` with Gram matrix `[[2m,b,β₀],[b,2k,g],[β₀,g,2δ]]`. -/
def Hform (m k δ g β₀ b : ℤ) : TForm := ⟨2*m, 2*k, 2*δ, g, β₀, b⟩

lemma Hform_det (m k δ g β₀ b tq : ℤ)
    (hk : 4*m*k = tq + b^2)
    (hδ : m*g^2 - b*β₀*g + k*β₀^2 = tq*δ - 21) :
    (Hform m k δ g β₀ b).det = 42 := by
  simp only [Hform, det]
  linear_combination 2*δ*hk - 2*hδ

lemma Hform_posdef (m k δ g β₀ b tq : ℤ) (hm : 0 < m) (htq : 0 < tq)
    (hk : 4*m*k = tq + b^2)
    (hδ : m*g^2 - b*β₀*g + k*β₀^2 = tq*δ - 21) :
    PosDef (Hform m k δ g β₀ b) := by
  intro x y z hv
  have key : 2*m*tq*((Hform m k δ g β₀ b).Q x y z)
      = tq*(2*m*x + b*y + β₀*z)^2 + (tq*y + (2*m*g - b*β₀)*z)^2 + 84*m*z^2 := by
    simp only [Hform, Q]
    linear_combination (tq*y^2 + β₀^2*z^2) * hk - 4*m*z^2 * hδ
  have hmtq : 0 < 2*m*tq := by positivity
  rcases eq_or_ne z 0 with rfl | hz
  · rcases eq_or_ne y 0 with rfl | hy
    · have hx : x ≠ 0 := by tauto
      have h1 : 0 < tq*(2*m*x)^2 := by positivity
      nlinarith [sq_nonneg (tq*(0:ℤ)), key]
    · have h1 : 0 < (tq*y)^2 := by positivity
      nlinarith [sq_nonneg (2*m*x + b*y), mul_nonneg htq.le (sq_nonneg (2*m*x + b*y)), key]
  · have h1 : 0 < 84*m*z^2 := by positivity
    nlinarith [mul_nonneg htq.le (sq_nonneg (2*m*x + b*y + β₀*z)),
      sq_nonneg (tq*y + (2*m*g - b*β₀)*z), key]

lemma Hform_evenD (m k δ g β₀ b : ℤ) : EvenD (Hform m k δ g β₀ b) :=
  ⟨⟨m, by simp only [Hform]; ring⟩, ⟨k, by simp only [Hform]; ring⟩,
    ⟨δ, by simp only [Hform]; ring⟩⟩

lemma Hform_rep_2m (m k δ g β₀ b : ℤ) : (Hform m k δ g β₀ b).Represents (2*m) :=
  ⟨1, 0, 0, by simp [Hform, Q]⟩

lemma Hform_rep_2mtq (m k δ g β₀ b tq : ℤ) (hk : 4*m*k = tq + b^2) :
    (Hform m k δ g β₀ b).Represents (2*m*tq) :=
  ⟨-b, 2*m, 0, by simp only [Hform, Q]; linear_combination 2*m*hk⟩

end TForm

/-! # Number-theoretic engine: constructing a form representing 2m -/



namespace TForm

/-- Engine: given the assembled data, `C1` represents `2*m`. -/
lemma engine (m k δ g β₀ b tq : ℤ) (hm : 0 < m) (htq : 0 < tq)
    (hk : 4*m*k = tq + b^2)
    (hδ : m*g^2 - b*β₀*g + k*β₀^2 = tq*δ - 21)
    (hsep : (2*m) % 18 = 12 ∨ (2*m*tq) % 18 = 12) :
    C1.Represents (2*m) := by
  have hdet := Hform_det m k δ g β₀ b tq hk hδ
  have hpd := Hform_posdef m k δ g β₀ b tq hm htq hk hδ
  have hev := Hform_evenD m k δ g β₀ b
  have hrep := Hform_rep_2m m k δ g β₀ b
  refine key_classification hpd hev hdet ?_ _ hrep
  rcases hsep with h | h
  · exact ⟨2*m, hrep, h⟩
  · exact ⟨2*m*tq, Hform_rep_2mtq m k δ g β₀ b tq hk, h⟩

/-- Odd squares are 1 mod 8. -/
lemma nat_odd_sq_mod_eight {b : ℕ} (hb : b % 2 = 1) : b^2 % 8 = 1 := by
  have h8 : b % 8 = 1 ∨ b % 8 = 3 ∨ b % 8 = 5 ∨ b % 8 = 7 := by omega
  rw [Nat.pow_mod]
  rcases h8 with h|h|h|h <;> rw [h] <;> rfl

/-- Master construction lemma: from a prime `q` with the right congruence and
Jacobi-symbol properties, `C1` represents `2*m`. -/
lemma master (m t q : ℕ) (b β₀ : ℤ)
    (hm : 0 < m) (ht : t = 1 ∨ t = 3 ∨ t = 7 ∨ t = 21)
    (hq : q.Prime) (hco : Nat.Coprime q (84*m))
    (h7 : 7 ∣ t → (7:ℤ) ∣ (m:ℤ) ∧ (7:ℤ) ∣ β₀)
    (h3 : 3 ∣ t → ¬ 3 ∣ m)
    (hJ : J((-(84*(m:ℤ))) | q) = 1)
    (h4m : (4*(m:ℤ)) ∣ ((t:ℤ)*(q:ℤ) + b^2))
    (hsep : (2*(m:ℤ)) % 18 = 12 ∨ (2*(m:ℤ)*((t:ℤ)*(q:ℤ))) % 18 = 12) :
    C1.Represents (2*(m:ℤ)) := by
  haveI : Fact q.Prime := ⟨hq⟩
  have hnd : ¬ q ∣ 84*m := (hq.coprime_iff_not_dvd).mp hco
  -- the square root of -84m mod q
  have hne : ((-(84*(m:ℤ)) : ℤ) : ZMod q) ≠ 0 := by
    rw [Ne, ZMod.intCast_zmod_eq_zero_iff_dvd]
    intro hdvd
    rw [dvd_neg] at hdvd
    exact hnd (by exact_mod_cast hdvd)
  have hsq : IsSquare ((-(84*(m:ℤ)) : ℤ) : ZMod q) := by
    rw [← legendreSym.eq_one_iff q hne, jacobiSym.legendreSym.to_jacobiSym]
    exact hJ
  obtain ⟨ξ, hξ⟩ := hsq
  -- 2m is invertible mod q
  have hu : ((2*(m:ℤ) : ℤ) : ZMod q) ≠ 0 := by
    rw [Ne, ZMod.intCast_zmod_eq_zero_iff_dvd]
    intro hd
    have h2 : q ∣ 2*m := by exact_mod_cast hd
    exact hnd (h2.trans ⟨42, by ring⟩)
  -- construct g with the two needed congruence properties
  have hgex : ∃ g : ℤ, ((2*(m:ℤ)*g - b*β₀ : ℤ) : ZMod q) = ξ ∧
      (3 ∣ t → ((2*(m:ℤ)*g - b*β₀ : ℤ) : ZMod 3) = 0) := by
    set e : ZMod q := (ξ + ((b*β₀ : ℤ) : ZMod q)) * ((2*(m:ℤ) : ℤ) : ZMod q)⁻¹ with he
    have hue : ((2*(m:ℤ) : ℤ) : ZMod q) * e = ξ + ((b*β₀ : ℤ) : ZMod q) := by
      rw [he, mul_comm, mul_assoc, inv_mul_cancel₀ hu, mul_one]
    by_cases h3t : 3 ∣ t
    · haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
      have h3m : ¬ (3:ℕ) ∣ 2*m := by
        intro hd
        rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
        · omega
        · exact h3 h3t h
      have hv : ((2*(m:ℤ) : ℤ) : ZMod 3) ≠ 0 := by
        rw [Ne, ZMod.intCast_zmod_eq_zero_iff_dvd]
        intro hd
        exact h3m (by exact_mod_cast hd)
      have hq3 : ((q:ℕ) : ZMod 3) ≠ 0 := by
        rw [Ne, ZMod.natCast_eq_zero_iff]
        intro hd
        have hg3 : (3:ℕ) ∣ Nat.gcd q (84*m) := Nat.dvd_gcd hd ⟨28*m, by ring⟩
        rw [hco] at hg3
        omega
      set c : ZMod 3 := ((b*β₀ : ℤ) : ZMod 3) * ((2*(m:ℤ) : ℤ) : ZMod 3)⁻¹ with hc
      set j : ZMod 3 := (c - ((e.val : ℕ) : ZMod 3)) * ((q:ℕ) : ZMod 3)⁻¹ with hj
      refine ⟨(e.val : ℤ) + (q:ℤ) * (j.val : ℤ), ?_, fun _ => ?_⟩
      · push_cast
        rw [ZMod.natCast_self, zero_mul, add_zero, ZMod.natCast_zmod_val]
        push_cast at hue
        linear_combination hue
      · push_cast
        rw [ZMod.natCast_zmod_val]
        have hqj : ((q:ℕ) : ZMod 3) * j = c - ((e.val : ℕ) : ZMod 3) := by
          rw [hj, mul_comm, mul_assoc, inv_mul_cancel₀ hq3, mul_one]
        have hvc : ((2*(m:ℤ) : ℤ) : ZMod 3) * c = ((b*β₀ : ℤ) : ZMod 3) := by
          rw [hc, mul_comm, mul_assoc, inv_mul_cancel₀ hv, mul_one]
        push_cast at hqj hvc
        linear_combination 2 * (m : ZMod 3) * hqj + hvc
    · refine ⟨(e.val : ℤ), ?_, fun h => absurd h h3t⟩
      push_cast
      rw [ZMod.natCast_zmod_val]
      push_cast at hue
      linear_combination hue
  obtain ⟨g, hgq, hg3⟩ := hgex
  -- k
  obtain ⟨k, hk0⟩ := h4m
  have hk : 4*(m:ℤ)*k = (t:ℤ)*q + b^2 := hk0.symm
  -- the key identity
  have hkey : 4*(m:ℤ)*((m*g^2 - b*β₀*g + k*β₀^2) + 21)
      = ((2*(m:ℤ)*g - b*β₀)^2 + 84*m) + β₀^2*((t:ℤ)*q) := by
    linear_combination β₀^2 * hk
  -- q divides F + 21
  have hqsq : (q:ℤ) ∣ ((2*(m:ℤ)*g - b*β₀)^2 + 84*m) := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    push_cast
    push_cast at hgq
    rw [show ((2:ZMod q)*(m:ZMod q)*(g:ZMod q) - (b:ZMod q)*(β₀:ZMod q)) = ξ from hgq]
    push_cast at hξ
    linear_combination -hξ
  have hqF : (q:ℤ) ∣ ((m:ℤ)*g^2 - b*β₀*g + k*β₀^2 + 21) := by
    have h1 : (q:ℤ) ∣ 4*(m:ℤ)*((m*g^2 - b*β₀*g + k*β₀^2) + 21) := by
      rw [hkey]
      exact dvd_add hqsq ((dvd_mul_left (q:ℤ) (t:ℤ)).mul_left _)
    have hqp : Prime (q:ℤ) := Nat.prime_iff_prime_int.mp hq
    rcases hqp.dvd_mul.mp h1 with h | h
    · exfalso
      have h4 : (q:ℤ) ∣ ((4*m : ℕ) : ℤ) := by push_cast; exact h
      have h5 : q ∣ 4*m := by exact_mod_cast h4
      exact hnd (h5.trans ⟨21, by ring⟩)
    · exact h
  -- 3 divides F + 21 when 3 ∣ t
  have h3F : 3 ∣ t → (3:ℤ) ∣ ((m:ℤ)*g^2 - b*β₀*g + k*β₀^2 + 21) := by
    intro h3t
    have hx3 : (3:ℤ) ∣ (2*(m:ℤ)*g - b*β₀) := by
      have h0 : ((2*(m:ℤ)*g - b*β₀ : ℤ) : ZMod 3) = 0 := hg3 h3t
      exact_mod_cast (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp h0
    have h3sq : (3:ℤ) ∣ (2*(m:ℤ)*g - b*β₀)^2 := dvd_pow hx3 two_ne_zero
    have h3tq : (3:ℤ) ∣ (t:ℤ)*q := by
      obtain ⟨t', rfl⟩ := h3t
      push_cast
      exact ⟨t'*q, by ring⟩
    have h34 : (3:ℤ) ∣ 4*(m:ℤ)*((m*g^2 - b*β₀*g + k*β₀^2) + 21) := by
      rw [hkey]
      exact dvd_add (dvd_add h3sq ⟨28*m, by ring⟩) (h3tq.mul_left _)
    rcases Int.prime_three.dvd_mul.mp h34 with h | h
    · exfalso
      have h4 : (3:ℤ) ∣ ((4*m : ℕ) : ℤ) := by push_cast; exact h
      have h5 : (3:ℕ) ∣ 4*m := by exact_mod_cast h4
      rcases (Nat.Prime.dvd_mul (by norm_num)).mp h5 with h6 | h6
      · omega
      · exact h3 h3t h6
    · exact h
  -- 7 divides F + 21 when 7 ∣ t
  have h7F : 7 ∣ t → (7:ℤ) ∣ ((m:ℤ)*g^2 - b*β₀*g + k*β₀^2 + 21) := by
    intro h7t
    obtain ⟨hm7, hβ7⟩ := h7 h7t
    exact dvd_add (dvd_add (dvd_sub (hm7.mul_right _) ((hβ7.mul_left b).mul_right g))
      ((dvd_pow hβ7 two_ne_zero).mul_left k)) ⟨3, by norm_num⟩
  -- t divides F + 21
  have htF : (t:ℤ) ∣ ((m:ℤ)*g^2 - b*β₀*g + k*β₀^2 + 21) := by
    rcases ht with rfl | rfl | rfl | rfl
    · simpa using one_dvd _
    · simpa using h3F ⟨1, rfl⟩
    · simpa using h7F ⟨1, rfl⟩
    · rw [show ((21:ℕ):ℤ) = 3*7 by norm_num]
      exact IsCoprime.mul_dvd (Int.isCoprime_iff_gcd_eq_one.mpr (by norm_num))
        (h3F ⟨7, rfl⟩) (h7F ⟨3, rfl⟩)
  -- tq divides F + 21, define δ
  have ht84 : t ∣ 84 := by rcases ht with rfl | rfl | rfl | rfl <;> norm_num
  have hcop_tq : IsCoprime ((t:ℤ)) ((q:ℤ)) := by
    have h1 : Nat.Coprime q t :=
      Nat.Coprime.coprime_dvd_right (ht84.trans ⟨m, rfl⟩) hco
    exact Nat.isCoprime_iff_coprime.mpr h1.symm
  obtain ⟨δ, hδ0⟩ := hcop_tq.mul_dvd htF hqF
  have hδ : (m:ℤ)*g^2 - b*β₀*g + k*β₀^2 = (t:ℤ)*(q:ℤ)*δ - 21 := by linarith
  -- positivity
  have htpos : 0 < t := by rcases ht with rfl | rfl | rfl | rfl <;> norm_num
  have htq_pos : (0:ℤ) < (t:ℤ)*(q:ℤ) := by
    have := hq.two_le
    have h1 : 0 < t*q := Nat.mul_pos htpos (by omega)
    exact_mod_cast h1
  exact engine (m:ℤ) k δ g β₀ b ((t:ℤ)*(q:ℤ)) (by exact_mod_cast hm) htq_pos hk hδ hsep

end TForm

/-! # Jacobi symbol computations for the construction cases -/



namespace TForm

/-! ## Small helpers -/

private lemma odd_of_coprime_even {a n : ℕ} (h : Nat.Coprime a n) (h2 : 2 ∣ n) :
    a % 2 = 1 := by
  rcases Nat.even_or_odd a with ⟨r, rfl⟩ | ho
  · exfalso
    have hd : 2 ∣ Nat.gcd (r + r) n := Nat.dvd_gcd ⟨r, by ring⟩ h2
    rw [Nat.Coprime.gcd_eq_one h] at hd
    omega
  · exact Nat.odd_iff.mp ho

private lemma not_dvd_of_coprime {p a n : ℕ} (h : Nat.Coprime a n) (hpn : p ∣ n)
    (hp : 2 ≤ p) : ¬ p ∣ a := by
  intro hd
  have h2 := Nat.dvd_gcd hd hpn
  rw [Nat.Coprime.gcd_eq_one h] at h2
  have := Nat.le_of_dvd one_pos h2
  omega

/-- `J(-1|q)` for `q ≡ 1 mod 4`. -/
private lemma J_neg_one_1 {q : ℕ} (h : q % 4 = 1) : J((-1 : ℤ) | q) = 1 := by
  rw [jacobiSym.at_neg_one (Nat.odd_iff.mpr (by omega)), ZMod.χ₄_nat_one_mod_four h]

/-- `J(-1|q)` for `q ≡ 3 mod 4`. -/
private lemma J_neg_one_3 {q : ℕ} (h : q % 4 = 3) : J((-1 : ℤ) | q) = -1 := by
  rw [jacobiSym.at_neg_one (Nat.odd_iff.mpr (by omega)), ZMod.χ₄_nat_three_mod_four h]

/-- `J(2|q)` for `q ≡ ±1 mod 8`. -/
private lemma J_two_1 {q : ℕ} (h : q % 8 = 1 ∨ q % 8 = 7) : J((2 : ℤ) | q) = 1 := by
  rw [jacobiSym.at_two (Nat.odd_iff.mpr (by omega)), ZMod.χ₈_nat_eq_if_mod_eight,
    if_neg (by omega), if_pos h]

/-- `J(2|q)` for `q ≡ ±3 mod 8`. -/
private lemma J_two_3 {q : ℕ} (h : q % 8 = 3 ∨ q % 8 = 5) : J((2 : ℤ) | q) = -1 := by
  rw [jacobiSym.at_two (Nat.odd_iff.mpr (by omega)), ZMod.χ₈_nat_eq_if_mod_eight,
    if_neg (by omega), if_neg (by omega)]

private lemma J37 : J((3 : ℤ) | 7) = -1 := by
  have hne : ((3 : ℤ) : ZMod 7) ≠ 0 := by decide
  have hns : ¬ IsSquare ((3 : ℤ) : ZMod 7) := by decide
  have hg : Int.gcd (3 : ℤ) 7 = 1 := by decide
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have h1 : legendreSym 7 (3 : ℤ) ≠ 1 := fun hcon =>
    hns ((legendreSym.eq_one_iff 7 hne).mp hcon)
  have h2 := jacobiSym.legendreSym.to_jacobiSym 7 (3 : ℤ)
  rcases jacobiSym.eq_one_or_neg_one (a := (3:ℤ)) (b := 7) hg with h | h
  · exact absurd (h2.trans h) h1
  · exact h

private lemma J27 : J((2 : ℤ) | 7) = 1 := J_two_1 (Or.inr rfl)

/-- If `M ∣ t*q + 1` then `J(t|M) * J(q|M) = χ₄ M`. -/
private lemma J_mul_chi4 {t q M : ℕ} (hModd : M % 2 = 1) (h : M ∣ t*q + 1) :
    J((t : ℤ) | M) * J((q : ℤ) | M) = ZMod.χ₄ M := by
  rw [← jacobiSym.mul_left]
  have hmod : ((t : ℤ)*(q : ℤ)) % M = (-1 : ℤ) % M := by
    have hdvd : (M : ℤ) ∣ ((-1 : ℤ) - (t : ℤ)*(q : ℤ)) := by
      obtain ⟨c, hc⟩ := h
      refine ⟨-c, ?_⟩
      have : ((t*q + 1 : ℕ) : ℤ) = ((M*c : ℕ) : ℤ) := by exact_mod_cast hc
      push_cast at this
      linarith
    exact Int.modEq_iff_dvd.mpr hdvd
  rw [jacobiSym.mod_left' hmod, jacobiSym.at_neg_one (Nat.odd_iff.mpr hModd)]

/-- Odd numbers with equal residues mod 8 have product ≡ 1 mod 8. -/
private lemma mul_mod_eight {a b : ℕ} (ha : a % 2 = 1) (h : a % 8 = b % 8) :
    (a * b) % 8 = 1 := by
  have h8 : a % 8 = 1 ∨ a % 8 = 3 ∨ a % 8 = 5 ∨ a % 8 = 7 := by omega
  rw [Nat.mul_mod, ← h]
  rcases h8 with h'|h'|h'|h' <;> rw [h'] <;> rfl

private lemma mul_mod_three {a b : ℕ} (ha : a % 3 ≠ 0) (h : a % 3 = b % 3) :
    (a * b) % 3 = 1 := by
  have h3 : a % 3 = 1 ∨ a % 3 = 2 := by omega
  rw [Nat.mul_mod, ← h]
  rcases h3 with h'|h' <;> rw [h'] <;> rfl

/-! ## The pairing lemma for `γ = 0` -/

/-- For `m = 2^α 3^β M` with `gcd(M,42)=1`, given two primes with the same residues
mod 8, 3 and M but residues 1 and 3 mod 7, one of them has `J(-84m|q) = 1`. -/
lemma J_g0 (α β M q₁ q₂ : ℕ) (hM42 : Nat.Coprime M 42)
    (hp1 : q₁.Prime) (hp2 : q₂.Prime)
    (hco1 : Nat.Coprime q₁ (84*(2^α*(3^β*M)))) (hco2 : Nat.Coprime q₂ (84*(2^α*(3^β*M))))
    (h8 : q₁ % 8 = q₂ % 8) (h3 : q₁ % 3 = q₂ % 3) (hMq : q₁ % M = q₂ % M)
    (h71 : q₁ % 7 = 1) (h72 : q₂ % 7 = 3) :
    J((-(84*((2^α*(3^β*M) : ℕ) : ℤ))) | q₁) = 1 ∨
      J((-(84*((2^α*(3^β*M) : ℕ) : ℤ))) | q₂) = 1 := by
  set m : ℕ := 2^α*(3^β*M) with hm
  set A : ℤ := -(84*((m : ℕ) : ℤ)) with hA
  haveI : NeZero q₁ := ⟨hp1.pos.ne'⟩
  haveI : NeZero q₂ := ⟨hp2.pos.ne'⟩
  have ho1 : q₁ % 2 = 1 := odd_of_coprime_even hco1 ⟨42*m, by ring⟩
  have ho2 : q₂ % 2 = 1 := odd_of_coprime_even hco2 ⟨42*m, by ring⟩
  set Q : ℕ := q₁ * q₂ with hQ
  have hQ8 : Q % 8 = 1 := mul_mod_eight ho1 h8
  have hQodd : Odd Q := Nat.odd_iff.mpr (by omega)
  have hQ4 : Q % 4 = 1 := by omega
  have h31 : ¬ (3 ∣ q₁) := not_dvd_of_coprime hco1 ⟨28*m, by ring⟩ (by norm_num)
  have hQ3 : Q % 3 = 1 := mul_mod_three (fun hc => h31 (Nat.dvd_of_mod_eq_zero hc)) h3
  have hQ7 : Q % 7 = 3 := by rw [hQ, Nat.mul_mod, h71, h72]
  have hQM : Q % M = (q₁ * q₁) % M := Nat.ModEq.mul_left q₁ (hMq.symm : q₂ % M = q₁ % M)
  -- coprimality of q₁ with M
  have hq1M : Nat.Coprime q₁ M :=
    Nat.Coprime.coprime_dvd_right ⟨84*(2^α*3^β), by ring⟩ hco1
  -- the individual factor values at Q
  have hJ1 : J((-1 : ℤ) | Q) = 1 := J_neg_one_1 hQ4
  have hJ2 : J((2 : ℤ) | Q) = 1 := J_two_1 (Or.inl hQ8)
  have hJ3 : J((3 : ℤ) | Q) = 1 := by
    rw [show (3 : ℤ) = ((3 : ℕ) : ℤ) by norm_num,
      jacobiSym.quadratic_reciprocity_one_mod_four' (by norm_num) hQ4,
      jacobiSym.mod_left ((Q : ℕ) : ℤ) 3, ← Int.natCast_mod, hQ3]
    norm_num
  have hJ7 : J((7 : ℤ) | Q) = -1 := by
    rw [show (7 : ℤ) = ((7 : ℕ) : ℤ) by norm_num,
      jacobiSym.quadratic_reciprocity_one_mod_four' (by norm_num) hQ4,
      jacobiSym.mod_left ((Q : ℕ) : ℤ) 7, ← Int.natCast_mod, hQ7]
    exact_mod_cast J37
  have hJM : J(((M : ℕ) : ℤ) | Q) = 1 := by
    have hModd : Odd M := Nat.odd_iff.mpr (odd_of_coprime_even hM42 ⟨21, rfl⟩)
    rw [jacobiSym.quadratic_reciprocity_one_mod_four' hModd hQ4]
    have hmod : ((Q : ℕ) : ℤ) % M = ((q₁*q₁ : ℕ) : ℤ) % M := by
      rw [← Int.natCast_mod, ← Int.natCast_mod, hQM]
    rw [jacobiSym.mod_left ((Q : ℕ) : ℤ) M, hmod, ← jacobiSym.mod_left]
    have : ((q₁*q₁ : ℕ) : ℤ) = ((q₁ : ℕ) : ℤ)^2 := by push_cast; ring
    rw [this, jacobiSym.sq_one']
    rwa [Int.gcd_natCast_natCast]
  -- assemble J(A|Q) = -1
  have hfac : A = (-1) * ((2:ℤ)^(2+α) * ((3:ℤ)^(1+β) * ((7:ℤ) * ((M : ℕ) : ℤ)))) := by
    rw [hA, hm]; push_cast; ring
  have hAQ : J(A | Q) = -1 := by
    rw [hfac, jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.mul_left,
      jacobiSym.mul_left, jacobiSym.pow_left, jacobiSym.pow_left,
      hJ1, hJ2, hJ3, hJ7, hJM]
    norm_num
  -- split the product
  have hprod : J(A | q₁) * J(A | q₂) = J(A | Q) := (jacobiSym.mul_right A q₁ q₂).symm
  have hAabs : A.natAbs = 84*m := by
    rw [hA, Int.natAbs_neg,
      show (84*((m:ℕ):ℤ)) = ((84*m : ℕ) : ℤ) by push_cast; ring]
    exact Int.natAbs_natCast _
  have hgcd1 : Int.gcd A q₁ = 1 := by
    rw [Int.gcd_def, hAabs, Int.natAbs_natCast]
    exact Nat.Coprime.gcd_eq_one hco1.symm
  rcases jacobiSym.eq_one_or_neg_one hgcd1 with h1v | h1v
  · exact Or.inl h1v
  · right
    rw [h1v, hAQ] at hprod
    linarith

/-! ## Helpers for reducing the numerator mod b -/

/-- If `b ∣ q + X` then `J(q|b) = J(-X|b)`. -/
private lemma J_mod_neg {X b q : ℕ} (h : b ∣ q + X) :
    J(((q:ℕ):ℤ) | b) = J((-((X:ℕ):ℤ)) | b) := by
  apply jacobiSym.mod_left'
  have h0 : ((b:ℕ):ℤ) ∣ (((q + X : ℕ)):ℤ) := Int.natCast_dvd_natCast.mpr h
  obtain ⟨c, hc⟩ := h0
  push_cast at hc
  have hd : ((b:ℕ):ℤ) ∣ (-((X:ℕ):ℤ) - ((q:ℕ):ℤ)) := ⟨-c, by linarith⟩
  exact Int.modEq_iff_dvd.mpr hd

/-- If `q ≡ X [MOD b]` then `J(q|b) = J(X|b)`. -/
private lemma J_mod_pos {X b q : ℕ} (h : q % b = X % b) :
    J(((q:ℕ):ℤ) | b) = J(((X:ℕ):ℤ) | b) := by
  apply jacobiSym.mod_left'
  rw [← Int.natCast_mod, ← Int.natCast_mod, h]

private lemma neg_one_pow_sq (k : ℕ) : ((-1:ℤ)^k)^2 = 1 := by
  rw [← pow_mul, mul_comm, pow_mul]
  norm_num

/-! ## Direct computation for `γ = 1, β = 1` -/

lemma J_g1_b1 (α M q : ℕ) (hM42 : Nat.Coprime M 42) (hq : q.Prime)
    (hco : Nat.Coprime q (84*(2^α*(3*(7*M)))))
    (hq8 : q % 8 = 1) (hqM : M ∣ 7*q + 1)
    (H7 : J(((2^α*(3*M) : ℕ) : ℤ) | 7) = -1) :
    J((-(84*((2^α*(3*(7*M)) : ℕ) : ℤ))) | q) = 1 := by
  have hModd : M % 2 = 1 := odd_of_coprime_even hM42 ⟨21, rfl⟩
  have hModd' : Odd M := Nat.odd_iff.mpr hModd
  have hq4 : q % 4 = 1 := by omega
  -- z := J(M|7) = 1 from the hypothesis H7
  have hz : J(((M:ℕ) : ℤ) | 7) = 1 := by
    have h1 : J(((2^α*(3*M) : ℕ) : ℤ) | 7)
        = J((2:ℤ) | 7)^α * (J((3:ℤ) | 7) * J(((M:ℕ):ℤ) | 7)) := by
      rw [show ((2^α*(3*M) : ℕ) : ℤ) = (2:ℤ)^α * ((3:ℤ) * ((M:ℕ):ℤ)) by push_cast; ring,
        jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.pow_left]
    rw [h1, J27, J37, one_pow] at H7
    linarith
  -- J(q|M) = 1
  have hqMval : J(((q:ℕ) : ℤ) | M) = 1 := by
    have hE := J_mul_chi4 (t := 7) hModd hqM
    have h7M : J(((7:ℕ) : ℤ) | M) = (-1:ℤ)^(M/2) := by
      rw [jacobiSym.quadratic_reciprocity (by norm_num) hModd', hz, mul_one,
        show (7:ℕ)/2 * (M/2) = 3 * (M/2) by norm_num, pow_mul]
      norm_num
    rw [h7M, ZMod.χ₄_eq_neg_one_pow hModd] at hE
    rcases Nat.even_or_odd (M/2) with hpar | hpar
    · rw [hpar.neg_one_pow] at hE; linarith
    · rw [hpar.neg_one_pow] at hE; linarith
  -- J(M|q) = 1
  have hJM : J(((M:ℕ) : ℤ) | q) = 1 := by
    rw [jacobiSym.quadratic_reciprocity_one_mod_four' hModd' hq4]
    exact hqMval
  -- coprimality bits
  have hg3 : Int.gcd (3:ℤ) q = 1 := by
    rw [show (3:ℤ) = ((3:ℕ):ℤ) by norm_num, Int.gcd_natCast_natCast]
    exact ((hco.coprime_dvd_right ⟨28*(2^α*(3*(7*M))), by ring⟩).symm).gcd_eq_one
  have hg7 : Int.gcd (7:ℤ) q = 1 := by
    rw [show (7:ℤ) = ((7:ℕ):ℤ) by norm_num, Int.gcd_natCast_natCast]
    exact ((hco.coprime_dvd_right ⟨12*(2^α*(3*(7*M))), by ring⟩).symm).gcd_eq_one
  -- assemble
  have hfac : (-(84*((2^α*(3*(7*M)) : ℕ) : ℤ)))
      = (-1) * ((2:ℤ)^(2+α) * ((3:ℤ)^2 * ((7:ℤ)^2 * ((M:ℕ):ℤ)))) := by
    push_cast; ring
  rw [hfac, jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.mul_left,
    jacobiSym.pow_left, J_neg_one_1 hq4, J_two_1 (Or.inl hq8),
    jacobiSym.sq_one' hg3, jacobiSym.sq_one' hg7, hJM]
  norm_num

/-! ## Direct computation for `γ = 1, β = 0` -/

lemma J_g1_b0 (α M q : ℕ) (hα : α ≤ 1) (hM42 : Nat.Coprime M 42) (hq : q.Prime)
    (hco : Nat.Coprime q (84*(2^α*(7*M))))
    (hq8 : q % 8 = 3) (hq3 : 3 ∣ (q + 2^α*(7*M))) (hqM : M ∣ 21*q + 1)
    (H7 : J(((2^α*M : ℕ) : ℤ) | 7) = -1) :
    J((-(84*((2^α*(7*M) : ℕ) : ℤ))) | q) = 1 := by
  have hModd : M % 2 = 1 := odd_of_coprime_even hM42 ⟨21, rfl⟩
  have hModd' : Odd M := Nat.odd_iff.mpr hModd
  have hq4 : q % 4 = 3 := by omega
  have hqodd : Odd q := Nat.odd_iff.mpr (by omega)
  -- z := J(M|7) = -1 from the hypothesis H7
  have hz : J(((M:ℕ) : ℤ) | 7) = -1 := by
    have h1 : J(((2^α*M : ℕ) : ℤ) | 7)
        = J((2:ℤ) | 7)^α * J(((M:ℕ):ℤ) | 7) := by
      rw [show ((2^α*M : ℕ) : ℤ) = (2:ℤ)^α * ((M:ℕ):ℤ) by push_cast; ring,
        jacobiSym.mul_left, jacobiSym.pow_left]
    rw [h1, J27, one_pow, one_mul] at H7
    exact H7
  -- y := J(M|3), with y^2 = 1
  have hgM3 : Int.gcd ((M:ℕ):ℤ) 3 = 1 := by
    rw [show (3:ℤ) = ((3:ℕ):ℤ) by norm_num, Int.gcd_natCast_natCast]
    exact (hM42.coprime_dvd_right ⟨14, rfl⟩).gcd_eq_one
  have hy2 : J(((M:ℕ):ℤ) | 3) * J(((M:ℕ):ℤ) | 3) = 1 := by
    have := jacobiSym.sq_one hgM3
    nlinarith [this]
  -- J(q|3) in terms of y
  have hJq3 : J(((q:ℕ):ℤ) | 3) = -((-1:ℤ)^α * J(((M:ℕ):ℤ) | 3)) := by
    rw [J_mod_neg hq3]
    rw [show (-(((2^α*(7*M) : ℕ)):ℤ)) = (-1) * ((2:ℤ)^α * (((7:ℕ):ℤ) * ((M:ℕ):ℤ)))
      by push_cast; ring]
    rw [jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.pow_left]
    have hJ73 : J(((7:ℕ):ℤ) | 3) = 1 := by
      rw [J_mod_pos (show (7:ℕ) % 3 = 1 % 3 by norm_num)]
      simp
    rw [hJ73, J_neg_one_3 (by norm_num), J_two_3 (Or.inl (by norm_num))]
    ring
  -- J(3|q) = -J(q|3)
  have hJ3q : J((3:ℤ) | q) = (-1:ℤ)^α * J(((M:ℕ):ℤ) | 3) := by
    rw [show (3:ℤ) = ((3:ℕ):ℤ) by norm_num,
      jacobiSym.quadratic_reciprocity_three_mod_four (by norm_num) hq4, hJq3]
    ring
  -- J(q|M) from the key congruence
  have hE := J_mul_chi4 (t := 21) hModd hqM
  have h21M : J(((21:ℕ) : ℤ) | M)
      = -(((-1:ℤ)^(M/2))^2 * J(((M:ℕ):ℤ) | 3)) := by
    rw [show ((21:ℕ):ℤ) = ((3:ℕ):ℤ) * ((7:ℕ):ℤ) by norm_num, jacobiSym.mul_left]
    have h3M : J(((3:ℕ):ℤ) | M) = (-1:ℤ)^(M/2) * J(((M:ℕ):ℤ) | 3) := by
      rw [jacobiSym.quadratic_reciprocity (by norm_num) hModd',
        show (3:ℕ)/2 * (M/2) = M/2 by norm_num]
    have h7M : J(((7:ℕ):ℤ) | M) = -(-1:ℤ)^(M/2) := by
      rw [jacobiSym.quadratic_reciprocity (by norm_num) hModd', hz,
        show (7:ℕ)/2 * (M/2) = 3 * (M/2) by norm_num, pow_mul]
      norm_num
    rw [h3M, h7M]
    ring
  rw [h21M, ZMod.χ₄_eq_neg_one_pow hModd, neg_one_pow_sq, one_mul] at hE
  -- hE : -J(M|3) * J(q|M) = (-1)^(M/2)
  -- J(M|q) via reciprocity
  have hMq : J(((M:ℕ):ℤ) | q)
      = ((-1:ℤ)^(M/2))^(q/2) * J(((q:ℕ):ℤ) | M) := by
    rw [jacobiSym.quadratic_reciprocity hModd' hqodd, pow_mul]
  -- assemble
  have hg7 : Int.gcd (7:ℤ) q = 1 := by
    rw [show (7:ℤ) = ((7:ℕ):ℤ) by norm_num, Int.gcd_natCast_natCast]
    exact ((hco.coprime_dvd_right ⟨12*(2^α*(7*M)), by ring⟩).symm).gcd_eq_one
  have hfac : (-(84*((2^α*(7*M) : ℕ) : ℤ)))
      = (-1) * ((2:ℤ)^(2+α) * ((3:ℤ) * ((7:ℤ)^2 * ((M:ℕ):ℤ)))) := by
    push_cast; ring
  rw [hfac, jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.mul_left, jacobiSym.mul_left,
    jacobiSym.pow_left, J_neg_one_3 hq4, J_two_3 (Or.inl hq8),
    jacobiSym.sq_one' hg7, hJ3q, hMq]
  have hqhalf : q/2 % 2 = 1 := by omega
  have hqodd2 : Odd (q/2) := Nat.odd_iff.mpr hqhalf
  rcases Nat.even_or_odd (M/2) with hpar | hpar <;>
    rw [hpar.neg_one_pow] at hE ⊢ <;>
    interval_cases α <;>
    simp only [one_pow, pow_succ, pow_zero, one_mul, mul_one, hqodd2.neg_one_pow] <;>
    nlinarith [hE, hy2]

end TForm

/-! # The construction: choosing primes and assembling the representation -/



namespace TForm

/-! ## Helpers -/

/-- An inverse: `∃ w, t*w ≡ 1 [MOD M]`. -/
private lemma exists_inv_mod (t M : ℕ) (hM : 0 < M) (h : Nat.Coprime t M) :
    ∃ w, (t*w) % M = 1 % M := by
  haveI : NeZero M := ⟨hM.ne'⟩
  refine ⟨((t : ZMod M)⁻¹).val, ?_⟩
  have h0 : ((t * ((t : ZMod M)⁻¹).val : ℕ) : ZMod M) = ((1 : ℕ) : ZMod M) := by
    push_cast
    rw [ZMod.natCast_zmod_val]
    exact ZMod.coe_mul_inv_eq_one t h
  exact (ZMod.natCast_eq_natCast_iff' _ _ _).mp h0

/-- A negative inverse: `∃ a, M ∣ t*a + 1`. -/
private lemma exists_neg_inv (t M : ℕ) (hM : 0 < M) (h : Nat.Coprime t M) :
    ∃ a, M ∣ t*a + 1 := by
  haveI : NeZero M := ⟨hM.ne'⟩
  refine ⟨(-((t : ZMod M)⁻¹)).val, ?_⟩
  have h0 : ((t * (-((t : ZMod M)⁻¹)).val + 1 : ℕ) : ZMod M) = 0 := by
    push_cast
    rw [ZMod.natCast_zmod_val]
    have h1 : (t : ZMod M) * (t : ZMod M)⁻¹ = 1 := ZMod.coe_mul_inv_eq_one t h
    linear_combination -h1
  exact (ZMod.natCast_eq_zero_iff _ _).mp h0

private lemma coprime_of_prime_gt {q n : ℕ} (hq : q.Prime) (h0 : 0 < n) (h : n < q) :
    Nat.Coprime q n := by
  rw [hq.coprime_iff_not_dvd]
  intro hd
  exact absurd (Nat.le_of_dvd h0 hd) (by omega)

/-- Transfer coprimality along a congruence. -/
private lemma coprime_of_modeq {r a M : ℕ} (h : r % M = a % M) (ha : Nat.Coprime a M) :
    Nat.Coprime r M := by
  have hd1 : Nat.gcd r M ∣ M := Nat.gcd_dvd_right r M
  have hd2 : Nat.gcd r M ∣ r % M := (Nat.dvd_mod_iff hd1).mpr (Nat.gcd_dvd_left r M)
  rw [h] at hd2
  have hd3 : Nat.gcd r M ∣ a := (Nat.dvd_mod_iff hd1).mp hd2
  have hd4 : Nat.gcd r M ∣ Nat.gcd a M := Nat.dvd_gcd hd3 hd1
  rw [ha.gcd_eq_one] at hd4
  exact Nat.eq_one_of_dvd_one hd4

private lemma coprime_of_neg_inv {t a M : ℕ} (h : M ∣ t*a + 1) : Nat.Coprime a M := by
  have hd1 : Nat.gcd a M ∣ t*a + 1 := (Nat.gcd_dvd_right a M).trans h
  have hd2 : Nat.gcd a M ∣ t*a := (Nat.gcd_dvd_left a M).mul_left t
  have hd3 : Nat.gcd a M ∣ 1 := by
    have h4 := Nat.dvd_sub hd1 hd2
    rwa [Nat.add_sub_cancel_left] at h4
  exact Nat.eq_one_of_dvd_one hd3

/-- Divisibility transfer along a congruence. -/
private lemma dvd_of_modeq {t a q M : ℕ} (h : M ∣ t*a + 1) (hq : q % M = a % M) :
    M ∣ t*q + 1 := by
  have h1 : (t*q + 1) % M = (t*a + 1) % M :=
    Nat.ModEq.add_right 1 (Nat.ModEq.mul_left t (hq : q ≡ a [MOD M]))
  have h2 : (t*a + 1) % M = 0 := by
    obtain ⟨c, hc⟩ := h
    rw [hc, Nat.mul_mod_right]
  exact Nat.dvd_of_mod_eq_zero (h1.trans h2)

/-- Dirichlet: a prime with prescribed residues mod 8, 3 and M (with `gcd(M,42)=1`). -/
private lemma exists_prime_24 (M c₈ c₃ aM B : ℕ) (hM0 : 0 < M) (hM42 : Nat.Coprime M 42)
    (hc₈ : c₈ % 2 = 1) (hc₃ : c₃ % 3 ≠ 0) (haM : Nat.Coprime aM M) :
    ∃ q, q.Prime ∧ B < q ∧ q % 8 = c₈ % 8 ∧ q % 3 = c₃ % 3 ∧ q % M = aM % M := by
  have hco83 : Nat.Coprime 8 3 := by norm_num
  obtain ⟨r₁, hr₁⟩ := Nat.chineseRemainder hco83 c₈ c₃
  have hcoM2 : Nat.Coprime M 2 := hM42.coprime_dvd_right ⟨21, rfl⟩
  have hcoM3 : Nat.Coprime M 3 := hM42.coprime_dvd_right ⟨14, rfl⟩
  have hco24M : Nat.Coprime 24 M := by
    have h1 : Nat.Coprime M 24 := by
      have h2 := (hcoM2.pow_right 3).mul_right hcoM3
      norm_num at h2 ⊢
      exact h2
    exact h1.symm
  obtain ⟨r, hr⟩ := Nat.chineseRemainder hco24M (r₁ : ℕ) aM
  have hr8 : (r : ℕ) % 8 = c₈ % 8 := (hr.1.of_dvd ⟨3, rfl⟩).trans hr₁.1
  have hr3 : (r : ℕ) % 3 = c₃ % 3 := (hr.1.of_dvd ⟨8, rfl⟩).trans hr₁.2
  have hrM : (r : ℕ) % M = aM % M := hr.2
  have hro : (r : ℕ) % 2 = 1 := by omega
  have hrc2 : Nat.Coprime (r : ℕ) 2 :=
    (Nat.prime_two.coprime_iff_not_dvd.mpr (by omega)).symm
  have hrc3 : Nat.Coprime (r : ℕ) 3 :=
    (((by norm_num : Nat.Prime 3).coprime_iff_not_dvd).mpr (by omega)).symm
  have hrcM : Nat.Coprime (r : ℕ) M := coprime_of_modeq hrM haM
  have hrc : Nat.Coprime (r : ℕ) (24*M) := by
    have h1 : Nat.Coprime (r : ℕ) 24 := by
      have h2 := (hrc2.pow_right 3).mul_right hrc3
      norm_num at h2 ⊢
      exact h2
    exact h1.mul_right hrcM
  obtain ⟨q, hqB, hqp, hqmod⟩ := Nat.forall_exists_prime_gt_and_modEq B
    (q := 24*M) (by positivity) hrc
  refine ⟨q, hqp, hqB, ?_, ?_, ?_⟩
  · exact (hqmod.of_dvd ⟨3*M, by ring⟩).trans hr8
  · exact (hqmod.of_dvd ⟨8*M, by ring⟩).trans hr3
  · exact (hqmod.of_dvd ⟨24, by ring⟩).trans hrM

/-- Dirichlet: a prime with prescribed residues mod 8, 3, 7 and M. -/
private lemma exists_prime_168 (M c₈ c₃ c₇ aM B : ℕ) (hM0 : 0 < M)
    (hM42 : Nat.Coprime M 42) (hc₈ : c₈ % 2 = 1) (hc₃ : c₃ % 3 ≠ 0) (hc₇ : c₇ % 7 ≠ 0)
    (haM : Nat.Coprime aM M) :
    ∃ q, q.Prime ∧ B < q ∧ q % 8 = c₈ % 8 ∧ q % 3 = c₃ % 3 ∧ q % 7 = c₇ % 7 ∧
      q % M = aM % M := by
  have hco83 : Nat.Coprime 8 3 := by norm_num
  obtain ⟨r₁, hr₁⟩ := Nat.chineseRemainder hco83 c₈ c₃
  have hco247 : Nat.Coprime 24 7 := by norm_num
  obtain ⟨r₂, hr₂⟩ := Nat.chineseRemainder hco247 (r₁ : ℕ) c₇
  have hcoM2 : Nat.Coprime M 2 := hM42.coprime_dvd_right ⟨21, rfl⟩
  have hcoM3 : Nat.Coprime M 3 := hM42.coprime_dvd_right ⟨14, rfl⟩
  have hcoM7 : Nat.Coprime M 7 := hM42.coprime_dvd_right ⟨6, rfl⟩
  have hco168M : Nat.Coprime 168 M := by
    have h1 : Nat.Coprime M 168 := by
      have h2 := ((hcoM2.pow_right 3).mul_right hcoM3).mul_right hcoM7
      norm_num at h2 ⊢
      exact h2
    exact h1.symm
  obtain ⟨r, hr⟩ := Nat.chineseRemainder hco168M (r₂ : ℕ) aM
  have hr8 : (r : ℕ) % 8 = c₈ % 8 :=
    ((hr.1.of_dvd ⟨21, rfl⟩).trans (hr₂.1.of_dvd ⟨3, rfl⟩)).trans hr₁.1
  have hr3 : (r : ℕ) % 3 = c₃ % 3 :=
    ((hr.1.of_dvd ⟨56, rfl⟩).trans (hr₂.1.of_dvd ⟨8, rfl⟩)).trans hr₁.2
  have hr7 : (r : ℕ) % 7 = c₇ % 7 := (hr.1.of_dvd ⟨24, rfl⟩).trans hr₂.2
  have hrM : (r : ℕ) % M = aM % M := hr.2
  have hro : (r : ℕ) % 2 = 1 := by omega
  have hrc2 : Nat.Coprime (r : ℕ) 2 :=
    (Nat.prime_two.coprime_iff_not_dvd.mpr (by omega)).symm
  have hrc3 : Nat.Coprime (r : ℕ) 3 :=
    (((by norm_num : Nat.Prime 3).coprime_iff_not_dvd).mpr (by omega)).symm
  have hrc7 : Nat.Coprime (r : ℕ) 7 :=
    (((by norm_num : Nat.Prime 7).coprime_iff_not_dvd).mpr (by omega)).symm
  have hrcM : Nat.Coprime (r : ℕ) M := coprime_of_modeq hrM haM
  have hrc : Nat.Coprime (r : ℕ) (168*M) := by
    have h1 : Nat.Coprime (r : ℕ) 168 := by
      have h2 := ((hrc2.pow_right 3).mul_right hrc3).mul_right hrc7
      norm_num at h2 ⊢
      exact h2
    exact h1.mul_right hrcM
  obtain ⟨q, hqB, hqp, hqmod⟩ := Nat.forall_exists_prime_gt_and_modEq B
    (q := 168*M) (by positivity) hrc
  refine ⟨q, hqp, hqB, ?_, ?_, ?_, ?_⟩
  · exact (hqmod.of_dvd ⟨21*M, by ring⟩).trans hr8
  · exact (hqmod.of_dvd ⟨56*M, by ring⟩).trans hr3
  · exact (hqmod.of_dvd ⟨24*M, by ring⟩).trans hr7
  · exact (hqmod.of_dvd ⟨168, by ring⟩).trans hrM

/-- Cast a separator congruence to ℤ, left version. -/
private lemma sep_left {m : ℕ} (h : (2*m) % 18 = 12) : (2*(m:ℤ)) % 18 = 12 := by
  have h2 := congrArg (Nat.cast : ℕ → ℤ) h
  rw [Int.natCast_mod] at h2
  push_cast at h2
  exact h2

/-- Cast a separator congruence to ℤ, right version. -/
private lemma sep_right {m t q : ℕ} (h : (2*(m*(t*q))) % 18 = 12) :
    (2*(m:ℤ)*((t:ℤ)*(q:ℤ))) % 18 = 12 := by
  have h2 := congrArg (Nat.cast : ℕ → ℤ) h
  rw [Int.natCast_mod] at h2
  push_cast at h2
  rw [show (2*(m:ℤ)*((t:ℤ)*(q:ℤ))) = 2*((m:ℤ)*((t:ℤ)*(q:ℤ))) by ring]
  exact h2

/-- Cast a ℕ-divisibility to the ℤ form used by `master`. -/
private lemma h4m_cast {m t q b : ℕ} (h : 4*m ∣ t*q + b^2) :
    (4*((m:ℕ):ℤ)) ∣ (((t:ℕ):ℤ)*((q:ℕ):ℤ) + ((b:ℕ):ℤ)^2) := by
  have h2 : ((4*m : ℕ) : ℤ) ∣ ((t*q + b^2 : ℕ) : ℤ) := Int.natCast_dvd_natCast.mpr h
  push_cast at h2
  exact h2

/-! ## Case β = 1, γ = 0 : `m = 2^α·3·M` -/

lemma rep_b1_g0 (α M : ℕ) (hα : α ≤ 1) (hM42 : Nat.Coprime M 42) (hM0 : 0 < M) :
    C1.Represents (2*((2^α*(3*M) : ℕ) : ℤ)) := by
  obtain ⟨aM, haM⟩ := exists_neg_inv 1 M hM0 (Nat.coprime_one_left M)
  have hkey : ∀ q : ℕ, q.Prime → 84*(2^α*(3*M)) < q → q % 8 = (4*α+3) % 8 →
      q % 3 = 2 % 3 → q % M = aM % M →
      J((-(84*((2^α*(3*M) : ℕ) : ℤ))) | q) = 1 →
      C1.Represents (2*((2^α*(3*M) : ℕ) : ℤ)) := by
    intro q hqp hqB hq8 hq3 hqM hJ
    have hm0 : 0 < 2^α*(3*M) := by positivity
    have hco : Nat.Coprime q (84*(2^α*(3*M))) :=
      coprime_of_prime_gt hqp (by positivity) hqB
    -- 4m divides t*q + b² with t = 1, b = 1
    have hMq1 : M ∣ 1*q + 1 := dvd_of_modeq haM hqM
    have h2p : 2^(2+α) ∣ 1*q + 1^2 := by
      have hα01 : α = 0 ∨ α = 1 := by omega
      rcases hα01 with rfl | rfl
      · norm_num at hq8 ⊢
        omega
      · norm_num at hq8 ⊢
        omega
    have h3p : 3 ∣ 1*q + 1^2 := by
      have h1 : 3 ∣ q + 1 := by omega
      simpa using h1
    have hMp : M ∣ 1*q + 1^2 := by simpa using hMq1
    have h2M : Nat.Coprime 2 M := (hM42.coprime_dvd_right ⟨21, rfl⟩).symm
    have h3M : Nat.Coprime 3 M := (hM42.coprime_dvd_right ⟨14, rfl⟩).symm
    have hd23 : 2^(2+α)*3 ∣ 1*q + 1^2 :=
      (Nat.Coprime.pow_left _ (by norm_num)).mul_dvd_of_dvd_of_dvd h2p h3p
    have hdall : (2^(2+α)*3)*M ∣ 1*q + 1^2 :=
      ((h2M.pow_left _).mul h3M).mul_dvd_of_dvd_of_dvd hd23 hMp
    have h4m : 4*(2^α*(3*M)) ∣ 1*q + 1^2 := by
      have he : 4*(2^α*(3*M)) = (2^(2+α)*3)*M := by ring
      rwa [he]
    -- separator
    have hx3 : ¬ 3 ∣ 2^α*M := by
      intro hd
      rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
      · have h2 := Nat.Prime.dvd_of_dvd_pow (p := 3) (by norm_num) h
        omega
      · rw [Nat.Prime.coprime_iff_not_dvd (by norm_num)] at h3M
        exact h3M h
    have hx : (2^α*M) % 3 = 1 ∨ (2^α*M) % 3 = 2 := by omega
    have hsep : (2*((2^α*(3*M) : ℕ):ℤ)) % 18 = 12 ∨
        (2*((2^α*(3*M) : ℕ):ℤ)*(((1:ℕ):ℤ)*((q:ℕ):ℤ))) % 18 = 12 := by
      rcases hx with h | h
      · right
        apply sep_right
        have he : 2*((2^α*(3*M))*(1*q)) = 6*((2^α*M)*q) := by ring
        rw [he]
        have hmq : ((2^α*M)*q) % 3 = 2 := by
          rw [Nat.mul_mod, h, hq3]
        omega
      · left
        apply sep_left
        have he : 2*(2^α*(3*M)) = 6*(2^α*M) := by ring
        rw [he]
        omega
    exact master (2^α*(3*M)) 1 q 1 1 hm0 (Or.inl rfl) hqp hco
      (fun h7 => absurd h7 (by norm_num)) (fun h3 => absurd h3 (by norm_num))
      hJ (by exact_mod_cast h4m_cast h4m) hsep
  obtain ⟨q₁, hp1, hB1, h81, h31, h71, hM1⟩ := exists_prime_168 M (4*α+3) 2 1 aM
    (84*(2^α*(3*M))) hM0 hM42 (by omega) (by norm_num) (by norm_num)
    (coprime_of_neg_inv haM)
  obtain ⟨q₂, hp2, hB2, h82, h32, h72, hM2⟩ := exists_prime_168 M (4*α+3) 2 3 aM
    (84*(2^α*(3*M))) hM0 hM42 (by omega) (by norm_num) (by norm_num)
    (coprime_of_neg_inv haM)
  have hco1 : Nat.Coprime q₁ (84*(2^α*(3*M))) := coprime_of_prime_gt hp1 (by positivity) hB1
  have hco2 : Nat.Coprime q₂ (84*(2^α*(3*M))) := coprime_of_prime_gt hp2 (by positivity) hB2
  have hco1' : Nat.Coprime q₁ (84*(2^α*(3^1*M))) := by rwa [pow_one]
  have hco2' : Nat.Coprime q₂ (84*(2^α*(3^1*M))) := by rwa [pow_one]
  have hJor := J_g0 α 1 M q₁ q₂ hM42 hp1 hp2 hco1' hco2' (h81.trans h82.symm)
    (h31.trans h32.symm) (hM1.trans hM2.symm) (by omega) (by omega)
  rw [pow_one] at hJor
  rcases hJor with h | h
  · exact hkey q₁ hp1 hB1 h81 h31 hM1 h
  · exact hkey q₂ hp2 hB2 h82 h32 hM2 h

/-! ## Case β = 0, γ = 0 : `m = 2^α·M` -/

lemma rep_b0_g0 (α M : ℕ) (hα : α ≤ 1) (hM42 : Nat.Coprime M 42) (hM0 : 0 < M) :
    C1.Represents (2*((2^α*M : ℕ) : ℤ)) := by
  have h3M : Nat.Coprime 3 M := (hM42.coprime_dvd_right ⟨14, rfl⟩).symm
  have hx3 : ¬ 3 ∣ 2^α*M := by
    intro hd
    rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
    · have h2 := Nat.Prime.dvd_of_dvd_pow (p := 3) (by norm_num) h
      omega
    · rw [Nat.Prime.coprime_iff_not_dvd (by norm_num)] at h3M
      exact h3M h
  have hc₃ : (2*(2^α*M)) % 3 ≠ 0 := by
    intro h0
    have hd : 3 ∣ 2*(2^α*M) := Nat.dvd_of_mod_eq_zero h0
    rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
    · omega
    · exact hx3 h
  obtain ⟨aM, haM⟩ := exists_neg_inv 3 M hM0 h3M
  have hkey : ∀ q : ℕ, q.Prime → 84*(2^α*M) < q → q % 8 = (4*α+1) % 8 →
      q % 3 = (2*(2^α*M)) % 3 → q % M = aM % M →
      J((-(84*((2^α*M : ℕ) : ℤ))) | q) = 1 →
      C1.Represents (2*((2^α*M : ℕ) : ℤ)) := by
    intro q hqp hqB hq8 hq3 hqM hJ
    have hm0 : 0 < 2^α*M := by positivity
    have hco : Nat.Coprime q (84*(2^α*M)) :=
      coprime_of_prime_gt hqp (by positivity) hqB
    -- 4m divides t*q + b² with t = 3, b = 1
    have hMq1 : M ∣ 3*q + 1 := dvd_of_modeq haM hqM
    have h2p : 2^(2+α) ∣ 3*q + 1^2 := by
      have hα01 : α = 0 ∨ α = 1 := by omega
      rcases hα01 with rfl | rfl
      · norm_num at hq8 ⊢
        omega
      · norm_num at hq8 ⊢
        omega
    have hMp : M ∣ 3*q + 1^2 := by simpa using hMq1
    have h2M : Nat.Coprime 2 M := (hM42.coprime_dvd_right ⟨21, rfl⟩).symm
    have hdall : 2^(2+α)*M ∣ 3*q + 1^2 :=
      (h2M.pow_left _).mul_dvd_of_dvd_of_dvd h2p hMp
    have h4m : 4*(2^α*M) ∣ 3*q + 1^2 := by
      have he : 4*(2^α*M) = 2^(2+α)*M := by ring
      rwa [he]
    -- separator (always the right disjunct)
    have hx : (2^α*M) % 3 = 1 ∨ (2^α*M) % 3 = 2 := by omega
    have hsep : (2*((2^α*M : ℕ):ℤ)) % 18 = 12 ∨
        (2*((2^α*M : ℕ):ℤ)*(((3:ℕ):ℤ)*((q:ℕ):ℤ))) % 18 = 12 := by
      right
      apply sep_right
      have he : 2*((2^α*M)*(3*q)) = 6*((2^α*M)*q) := by ring
      rw [he]
      have hmq : ((2^α*M)*q) % 3 = 2 := by
        rcases hx with h | h
        · have h2m : (2*(2^α*M)) % 3 = 2 := by omega
          rw [Nat.mul_mod, h, hq3, h2m]
        · have h2m : (2*(2^α*M)) % 3 = 1 := by omega
          rw [Nat.mul_mod, h, hq3, h2m]
      omega
    exact master (2^α*M) 3 q 1 1 hm0 (Or.inr (Or.inl rfl)) hqp hco
      (fun h7 => absurd h7 (by norm_num)) (fun _ => hx3)
      hJ (by exact_mod_cast h4m_cast h4m) hsep
  obtain ⟨q₁, hp1, hB1, h81, h31, h71, hM1⟩ := exists_prime_168 M (4*α+1) (2*(2^α*M)) 1 aM
    (84*(2^α*M)) hM0 hM42 (by omega) hc₃ (by norm_num) (coprime_of_neg_inv haM)
  obtain ⟨q₂, hp2, hB2, h82, h32, h72, hM2⟩ := exists_prime_168 M (4*α+1) (2*(2^α*M)) 3 aM
    (84*(2^α*M)) hM0 hM42 (by omega) hc₃ (by norm_num) (coprime_of_neg_inv haM)
  have hco1 : Nat.Coprime q₁ (84*(2^α*M)) := coprime_of_prime_gt hp1 (by positivity) hB1
  have hco2 : Nat.Coprime q₂ (84*(2^α*M)) := coprime_of_prime_gt hp2 (by positivity) hB2
  have hco1' : Nat.Coprime q₁ (84*(2^α*(3^0*M))) := by
    rwa [pow_zero, one_mul]
  have hco2' : Nat.Coprime q₂ (84*(2^α*(3^0*M))) := by
    rwa [pow_zero, one_mul]
  have hJor := J_g0 α 0 M q₁ q₂ hM42 hp1 hp2 hco1' hco2' (h81.trans h82.symm)
    (h31.trans h32.symm) (hM1.trans hM2.symm) (by omega) (by omega)
  rw [pow_zero, one_mul] at hJor
  rcases hJor with h | h
  · exact hkey q₁ hp1 hB1 h81 h31 hM1 h
  · exact hkey q₂ hp2 hB2 h82 h32 hM2 h

/-! ## Case β = 1, γ = 1 : `m = 2^α·3·7·M` -/

lemma rep_b1_g1 (α M : ℕ) (hα : α ≤ 1) (hM42 : Nat.Coprime M 42) (hM0 : 0 < M)
    (H7 : J(((2^α*(3*M) : ℕ) : ℤ) | 7) = -1) :
    C1.Represents (2*((2^α*(3*(7*M)) : ℕ) : ℤ)) := by
  have h2M : Nat.Coprime 2 M := (hM42.coprime_dvd_right ⟨21, rfl⟩).symm
  have h3M : Nat.Coprime 3 M := (hM42.coprime_dvd_right ⟨14, rfl⟩).symm
  have h7M : Nat.Coprime 7 M := (hM42.coprime_dvd_right ⟨6, rfl⟩).symm
  obtain ⟨aM, haM⟩ := exists_neg_inv 7 M hM0 h7M
  -- b = 7*w, odd, ≡ 1 mod 3 and mod M, divisible by 7
  have hco7L : Nat.Coprime 7 (2*(3*M)) := by
    have h72 : Nat.Coprime 7 2 := by norm_num
    have h73 : Nat.Coprime 7 3 := by norm_num
    exact h72.mul_right (h73.mul_right h7M)
  obtain ⟨w, hw⟩ := exists_inv_mod 7 (2*(3*M)) (by positivity) hco7L
  have hb2 : (7*w) % 2 = 1 := by
    have h1 : (7*w) % 2 = 1 % 2 :=
      (Nat.ModEq.of_dvd ⟨3*M, rfl⟩ hw : _ ≡ _ [MOD 2])
    omega
  have hb3 : (7*w) % 3 = 1 := by
    have h1 : (7*w) % 3 = 1 % 3 :=
      (Nat.ModEq.of_dvd ⟨2*M, by ring⟩ hw : _ ≡ _ [MOD 3])
    omega
  have hbM : (7*w) % M = 1 % M :=
    (Nat.ModEq.of_dvd ⟨6, by ring⟩ hw : _ ≡ _ [MOD M])
  -- Dirichlet prime
  obtain ⟨q, hqp, hqB, hq8, hq3, hqM⟩ := exists_prime_24 M 1 2 aM
    (84*(2^α*(3*(7*M)))) hM0 hM42 (by norm_num) (by norm_num)
    (coprime_of_neg_inv haM)
  have hm0 : 0 < 2^α*(3*(7*M)) := by positivity
  have hco : Nat.Coprime q (84*(2^α*(3*(7*M)))) :=
    coprime_of_prime_gt hqp (by positivity) hqB
  have hMq1 : M ∣ 7*q + 1 := dvd_of_modeq haM hqM
  -- J = 1
  have hJ := J_g1_b1 α M q hM42 hqp hco (by omega) hMq1 H7
  -- 4m ∣ 7q + b²
  have hb8 : ((7*w))^2 % 8 = 1 := nat_odd_sq_mod_eight hb2
  have h2p : 2^(2+α) ∣ 7*q + (7*w)^2 := by
    have h8 : (2:ℕ)^3 ∣ 7*q + (7*w)^2 := by
      have h8' : (8:ℕ) ∣ 7*q + (7*w)^2 := by omega
      simpa using h8'
    exact (pow_dvd_pow 2 (by omega : 2+α ≤ 3)).trans h8
  have hb32 : (7*w)^2 % 3 = 1 := by
    rw [Nat.pow_mod, hb3]
  have h3p : 3 ∣ 7*q + (7*w)^2 := by omega
  have h7p : 7 ∣ 7*q + (7*w)^2 := ⟨q + 7*w^2, by ring⟩
  have hMp : M ∣ 7*q + (7*w)^2 := by
    have hsq : (7*w)^2 % M = 1 % M := by
      have h1 : (7*w)^2 ≡ 1^2 [MOD M] := Nat.ModEq.pow 2 hbM
      simpa using h1
    have h1 : (7*q + (7*w)^2) % M = (7*q + 1) % M :=
      Nat.ModEq.add_left (7*q) hsq
    have h2 : (7*q + 1) % M = 0 := by
      obtain ⟨c, hc⟩ := hMq1
      rw [hc, Nat.mul_mod_right]
    exact Nat.dvd_of_mod_eq_zero (h1.trans h2)
  have hd7M : 7*M ∣ 7*q + (7*w)^2 := h7M.mul_dvd_of_dvd_of_dvd h7p hMp
  have hd37M : 3*(7*M) ∣ 7*q + (7*w)^2 :=
    ((by norm_num : Nat.Coprime 3 7).mul_right h3M).mul_dvd_of_dvd_of_dvd h3p hd7M
  have hdall : 2^(2+α)*(3*(7*M)) ∣ 7*q + (7*w)^2 := by
    refine (Nat.Coprime.pow_left _ ?_).mul_dvd_of_dvd_of_dvd h2p hd37M
    have h23 : Nat.Coprime 2 3 := by norm_num
    have h27 : Nat.Coprime 2 7 := by norm_num
    exact h23.mul_right (h27.mul_right h2M)
  have h4m : 4*(2^α*(3*(7*M))) ∣ 7*q + (7*w)^2 := by
    have he : 4*(2^α*(3*(7*M))) = 2^(2+α)*(3*(7*M)) := by ring
    rwa [he]
  -- separator
  have hx3 : ¬ 3 ∣ 2^α*M := by
    intro hd
    rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
    · have h2 := Nat.Prime.dvd_of_dvd_pow (p := 3) (by norm_num) h
      omega
    · rw [Nat.Prime.coprime_iff_not_dvd (by norm_num)] at h3M
      exact h3M h
  have hx : (2^α*M) % 3 = 1 ∨ (2^α*M) % 3 = 2 := by omega
  have hsep : (2*((2^α*(3*(7*M)) : ℕ):ℤ)) % 18 = 12 ∨
      (2*((2^α*(3*(7*M)) : ℕ):ℤ)*(((7:ℕ):ℤ)*((q:ℕ):ℤ))) % 18 = 12 := by
    rcases hx with h | h
    · right
      apply sep_right
      have he : 2*((2^α*(3*(7*M)))*(7*q)) = 6*(49*((2^α*M)*q)) := by ring
      rw [he]
      have hmq : ((2^α*M)*q) % 3 = 2 := by
        rw [Nat.mul_mod, h, hq3]
      have h49 : (49*((2^α*M)*q)) % 3 = 2 := by
        rw [Nat.mul_mod, hmq]
      omega
    · left
      apply sep_left
      have he : 2*(2^α*(3*(7*M))) = 6*(7*(2^α*M)) := by ring
      rw [he]
      have h7x : (7*(2^α*M)) % 3 = 2 := by
        rw [Nat.mul_mod, h]
      omega
  exact master (2^α*(3*(7*M))) 7 q (7*w) 7 hm0 (Or.inr (Or.inr (Or.inl rfl))) hqp hco
    (fun _ => ⟨⟨((2^α*(3*M) : ℕ) : ℤ), by push_cast; ring⟩, dvd_refl 7⟩)
    (fun h3 => absurd h3 (by norm_num))
    hJ (by exact_mod_cast h4m_cast h4m) hsep

/-! ## Case β = 0, γ = 1 : `m = 2^α·7·M` -/

lemma rep_b0_g1 (α M : ℕ) (hα : α ≤ 1) (hM42 : Nat.Coprime M 42) (hM0 : 0 < M)
    (H7 : J(((2^α*M : ℕ) : ℤ) | 7) = -1) :
    C1.Represents (2*((2^α*(7*M) : ℕ) : ℤ)) := by
  have h2M : Nat.Coprime 2 M := (hM42.coprime_dvd_right ⟨21, rfl⟩).symm
  have h3M : Nat.Coprime 3 M := (hM42.coprime_dvd_right ⟨14, rfl⟩).symm
  have h7M : Nat.Coprime 7 M := (hM42.coprime_dvd_right ⟨6, rfl⟩).symm
  have h21M : Nat.Coprime 21 M := by
    have h73 : Nat.Coprime 3 M := h3M
    exact (Nat.Coprime.mul h73 h7M : Nat.Coprime (3*7) M)
  obtain ⟨aM, haM⟩ := exists_neg_inv 21 M hM0 h21M
  -- b = 7*w, odd, ≡ 1 mod M, divisible by 7
  have hco7L : Nat.Coprime 7 (2*M) := by
    have h72 : Nat.Coprime 7 2 := by norm_num
    exact h72.mul_right h7M
  obtain ⟨w, hw⟩ := exists_inv_mod 7 (2*M) (by positivity) hco7L
  have hb2 : (7*w) % 2 = 1 := by
    have h1 : (7*w) % 2 = 1 % 2 :=
      (Nat.ModEq.of_dvd ⟨M, rfl⟩ hw : _ ≡ _ [MOD 2])
    omega
  have hbM : (7*w) % M = 1 % M :=
    (Nat.ModEq.of_dvd ⟨2, by ring⟩ hw : _ ≡ _ [MOD M])
  -- mod-3 unit facts
  have hx3 : ¬ 3 ∣ 2^α*M := by
    intro hd
    rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
    · have h2 := Nat.Prime.dvd_of_dvd_pow (p := 3) (by norm_num) h
      omega
    · rw [Nat.Prime.coprime_iff_not_dvd (by norm_num)] at h3M
      exact h3M h
  have hxm : ¬ 3 ∣ 2^α*(7*M) := by
    intro hd
    have he : 2^α*(7*M) = 7*(2^α*M) := by ring
    rw [he] at hd
    rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
    · omega
    · exact hx3 h
  have hc₃ : (2*(2^α*(7*M))) % 3 ≠ 0 := by
    intro h0
    have hd : 3 ∣ 2*(2^α*(7*M)) := Nat.dvd_of_mod_eq_zero h0
    rcases (Nat.Prime.dvd_mul (by norm_num)).mp hd with h | h
    · omega
    · exact hxm h
  -- Dirichlet prime
  obtain ⟨q, hqp, hqB, hq8, hq3, hqM⟩ := exists_prime_24 M 3 (2*(2^α*(7*M))) aM
    (84*(2^α*(7*M))) hM0 hM42 (by norm_num) hc₃ (coprime_of_neg_inv haM)
  have hm0 : 0 < 2^α*(7*M) := by positivity
  have hco : Nat.Coprime q (84*(2^α*(7*M))) :=
    coprime_of_prime_gt hqp (by positivity) hqB
  have hMq1 : M ∣ 21*q + 1 := dvd_of_modeq haM hqM
  have hq3' : 3 ∣ (q + 2^α*(7*M)) := by omega
  -- J = 1
  have hJ := J_g1_b0 α M q hα hM42 hqp hco (by omega) hq3' hMq1 H7
  -- 4m ∣ 21q + b²
  have hb8 : ((7*w))^2 % 8 = 1 := nat_odd_sq_mod_eight hb2
  have h2p : 2^(2+α) ∣ 21*q + (7*w)^2 := by
    have h8 : (2:ℕ)^3 ∣ 21*q + (7*w)^2 := by
      have h8' : (8:ℕ) ∣ 21*q + (7*w)^2 := by omega
      simpa using h8'
    exact (pow_dvd_pow 2 (by omega : 2+α ≤ 3)).trans h8
  have h7p : 7 ∣ 21*q + (7*w)^2 := ⟨3*q + 7*w^2, by ring⟩
  have hMp : M ∣ 21*q + (7*w)^2 := by
    have hsq : (7*w)^2 % M = 1 % M := by
      have h1 : (7*w)^2 ≡ 1^2 [MOD M] := Nat.ModEq.pow 2 hbM
      simpa using h1
    have h1 : (21*q + (7*w)^2) % M = (21*q + 1) % M :=
      Nat.ModEq.add_left (21*q) hsq
    have h2 : (21*q + 1) % M = 0 := by
      obtain ⟨c, hc⟩ := hMq1
      rw [hc, Nat.mul_mod_right]
    exact Nat.dvd_of_mod_eq_zero (h1.trans h2)
  have hd7M : 7*M ∣ 21*q + (7*w)^2 := h7M.mul_dvd_of_dvd_of_dvd h7p hMp
  have hdall : 2^(2+α)*(7*M) ∣ 21*q + (7*w)^2 := by
    refine (Nat.Coprime.pow_left _ ?_).mul_dvd_of_dvd_of_dvd h2p hd7M
    have h27 : Nat.Coprime 2 7 := by norm_num
    exact h27.mul_right h2M
  have h4m : 4*(2^α*(7*M)) ∣ 21*q + (7*w)^2 := by
    have he : 4*(2^α*(7*M)) = 2^(2+α)*(7*M) := by ring
    rwa [he]
  -- separator (always right)
  have hx : (2^α*M) % 3 = 1 ∨ (2^α*M) % 3 = 2 := by omega
  have hsep : (2*((2^α*(7*M) : ℕ):ℤ)) % 18 = 12 ∨
      (2*((2^α*(7*M) : ℕ):ℤ)*(((21:ℕ):ℤ)*((q:ℕ):ℤ))) % 18 = 12 := by
    right
    apply sep_right
    have he : 2*((2^α*(7*M))*(21*q)) = 6*(49*((2^α*M)*q)) := by ring
    rw [he]
    have hm7 : (2^α*(7*M)) % 3 = (7*(2^α*M)) % 3 := by
      have he2 : 2^α*(7*M) = 7*(2^α*M) := by ring
      rw [he2]
    have hmq : ((2^α*M)*q) % 3 = 2 := by
      rcases hx with h | h
      · have hq3v : q % 3 = 2 := by
          have h7x : (7*(2^α*M)) % 3 = 1 := by rw [Nat.mul_mod, h]
          omega
        rw [Nat.mul_mod, h, hq3v]
      · have hq3v : q % 3 = 1 := by
          have h7x : (7*(2^α*M)) % 3 = 2 := by rw [Nat.mul_mod, h]
          omega
        rw [Nat.mul_mod, h, hq3v]
    have h49 : (49*((2^α*M)*q)) % 3 = 2 := by
      rw [Nat.mul_mod, hmq]
    omega
  exact master (2^α*(7*M)) 21 q (7*w) 7 hm0 (Or.inr (Or.inr (Or.inr rfl))) hqp hco
    (fun _ => ⟨⟨((2^α*M : ℕ) : ℤ), by push_cast; ring⟩, dvd_refl 7⟩)
    (fun _ => hxm)
    hJ (by exact_mod_cast h4m_cast h4m) hsep

end TForm

/-! # The ternary representation theorem -/



namespace TForm

/-- Extract the exponent of a prime from a squarefree number. -/
private lemma extract_prime (p m : ℕ) (hp : p.Prime) (hsf : Squarefree m) (h0 : 0 < m) :
    ∃ e M, m = p^e * M ∧ e ≤ 1 ∧ ¬ p ∣ M ∧ Squarefree M ∧ 0 < M := by
  by_cases hd : p ∣ m
  · obtain ⟨M, rfl⟩ := hd
    refine ⟨1, M, by ring, le_refl 1, ?_, ?_, ?_⟩
    · intro hdM
      obtain ⟨M', rfl⟩ := hdM
      exact absurd (Nat.isUnit_iff.mp (hsf p ⟨M', by ring⟩)) hp.ne_one
    · exact Squarefree.squarefree_of_dvd ⟨p, mul_comm p M⟩ hsf
    · rcases Nat.eq_zero_or_pos M with rfl | h
      · simp at h0
      · exact h
  · exact ⟨0, m, by ring, by omega, hd, hsf, h0⟩

/-- Main representation theorem: for squarefree `m` satisfying the 7-adic condition,
`C1` represents `2m`. -/
theorem main_rep (m : ℕ) (h0 : 0 < m) (hsf : Squarefree m)
    (H7 : 7 ∣ m → J(((m/7 : ℕ) : ℤ) | 7) = -1) :
    C1.Represents (2*((m:ℕ):ℤ)) := by
  obtain ⟨α, m₂, he2, hα, h2m₂, hsf₂, h0₂⟩ := extract_prime 2 m Nat.prime_two hsf h0
  obtain ⟨β, m₃, he3, hβ, h3m₃, hsf₃, h0₃⟩ := extract_prime 3 m₂ (by norm_num) hsf₂ h0₂
  obtain ⟨γ, M, he7, hγ, h7M, hsfM, h0M⟩ := extract_prime 7 m₃ (by norm_num) hsf₃ h0₃
  have hMm₃ : M ∣ m₃ := ⟨7^γ, by rw [he7]; ring⟩
  have hMm₂ : M ∣ m₂ := hMm₃.trans ⟨3^β, by rw [he3]; ring⟩
  have h2M : ¬ 2 ∣ M := fun h => h2m₂ (h.trans hMm₂)
  have h3M : ¬ 3 ∣ M := fun h => h3m₃ (h.trans hMm₃)
  have hM42 : Nat.Coprime M 42 := by
    have c2 : Nat.Coprime M 2 := (Nat.prime_two.coprime_iff_not_dvd.mpr h2M).symm
    have c3 : Nat.Coprime M 3 :=
      (((by norm_num : Nat.Prime 3).coprime_iff_not_dvd).mpr h3M).symm
    have c7 : Nat.Coprime M 7 :=
      (((by norm_num : Nat.Prime 7).coprime_iff_not_dvd).mpr h7M).symm
    have h42 : (42:ℕ) = 2*(3*7) := by norm_num
    rw [h42]
    exact c2.mul_right (c3.mul_right c7)
  interval_cases γ <;> interval_cases β
  · -- γ = 0, β = 0 : m = 2^α * M
    have hm : m = 2^α*M := by rw [he2, he3, he7]; ring
    rw [hm]
    exact rep_b0_g0 α M hα hM42 h0M
  · -- γ = 0, β = 1 : m = 2^α * (3*M)
    have hm : m = 2^α*(3*M) := by rw [he2, he3, he7]; ring
    rw [hm]
    exact rep_b1_g0 α M hα hM42 h0M
  · -- γ = 1, β = 0 : m = 2^α * (7*M)
    have hm : m = 2^α*(7*M) := by rw [he2, he3, he7]; ring
    have hm7 : m = 7*(2^α*M) := by rw [he2, he3, he7]; ring
    have h7m : 7 ∣ m := ⟨2^α*M, hm7⟩
    have hdiv : m/7 = 2^α*M := by rw [hm7, Nat.mul_div_cancel_left _ (by norm_num)]
    have H7' : J(((2^α*M : ℕ) : ℤ) | 7) = -1 := by
      have := H7 h7m
      rwa [hdiv] at this
    rw [hm]
    exact rep_b0_g1 α M hα hM42 h0M H7'
  · -- γ = 1, β = 1 : m = 2^α * (3*(7*M))
    have hm : m = 2^α*(3*(7*M)) := by rw [he2, he3, he7]; ring
    have hm7 : m = 7*(2^α*(3*M)) := by rw [he2, he3, he7]; ring
    have h7m : 7 ∣ m := ⟨2^α*(3*M), hm7⟩
    have hdiv : m/7 = 2^α*(3*M) := by rw [hm7, Nat.mul_div_cancel_left _ (by norm_num)]
    have H7' : J(((2^α*(3*M) : ℕ) : ℤ) | 7) = -1 := by
      have := H7 h7m
      rwa [hdiv] at this
    rw [hm]
    exact rep_b1_g1 α M hα hM42 h0M H7'

/-- Scaling a representation by a square. -/
lemma rep_scale (s e : ℕ) (h : C1.Represents (2*((s:ℕ):ℤ))) :
    C1.Represents (2*((e^2*s : ℕ):ℤ)) := by
  obtain ⟨x, y, z, hxyz⟩ := h
  refine ⟨e*x, e*y, e*z, ?_⟩
  simp only [Q, C1] at hxyz ⊢
  push_cast
  linear_combination ((e:ℤ))^2 * hxyz

/-- `C1` represents `2s` whenever `7 ∤ s`. -/
theorem rep_of_not_dvd7 (s : ℕ) (h0 : 0 < s) (h7 : ¬ 7 ∣ s) :
    C1.Represents (2*((s:ℕ):ℤ)) := by
  obtain ⟨a, b, ha0, hb0, hab, hsf⟩ := Nat.sq_mul_squarefree_of_pos h0
  have h7a : ¬ 7 ∣ a := fun h => h7 (by rw [← hab]; exact h.mul_left _)
  have hrep := main_rep a ha0 hsf (fun h => absurd h h7a)
  have h2 := rep_scale a b hrep
  rwa [hab] at h2

/-- `C1` represents `2·7·u` whenever `7 ∤ u` and `(u|7) = -1`. -/
theorem rep_of_seven (u : ℕ) (h0 : 0 < u) (h7 : ¬ 7 ∣ u)
    (hJ : J(((u:ℕ):ℤ) | 7) = -1) :
    C1.Represents (2*((7*u : ℕ):ℤ)) := by
  obtain ⟨a, b, ha0, hb0, hab, hsf⟩ := Nat.sq_mul_squarefree_of_pos h0
  have h7a : ¬ 7 ∣ a := fun h => h7 (by rw [← hab]; exact h.mul_left _)
  have h7b : ¬ 7 ∣ b := by
    intro h
    apply h7
    rw [← hab]
    exact dvd_mul_of_dvd_left (by simpa [pow_two] using h.mul_left b) a
  have hgb : Int.gcd ((b:ℕ):ℤ) 7 = 1 := by
    rw [show (7:ℤ) = ((7:ℕ):ℤ) by norm_num, Int.gcd_natCast_natCast]
    exact (((by norm_num : Nat.Prime 7).coprime_iff_not_dvd).mpr h7b).symm.gcd_eq_one
  have hJa : J(((a:ℕ):ℤ) | 7) = -1 := by
    have h1 : J(((u:ℕ):ℤ) | 7) = J(((a:ℕ):ℤ) | 7) := by
      rw [show ((u:ℕ):ℤ) = ((b:ℕ):ℤ)^2 * ((a:ℕ):ℤ) by rw [← hab]; push_cast; ring,
        jacobiSym.mul_left, jacobiSym.sq_one' hgb, one_mul]
    rw [← h1]
    exact hJ
  have hsf7 : Squarefree (7*a) := by
    rw [Nat.squarefree_mul_iff]
    exact ⟨((by norm_num : Nat.Prime 7).coprime_iff_not_dvd).mpr h7a,
      (by norm_num : Nat.Prime 7).squarefree, hsf⟩
  have hrep := main_rep (7*a) (by positivity) hsf7
    (fun _ => by rwa [Nat.mul_div_cancel_left a (by norm_num : 0 < 7)])
  have h2 := rep_scale (7*a) b hrep
  rwa [show b^2*(7*a) = 7*u by rw [← hab]; ring] at h2

end TForm

end TernaryForms

section BridgeWindows

open TForm
open scoped NumberTheorySymbols

/-! # Bridge: from representations by `C1` to quadruples for `a n` -/



/-- If `Q₄(v) = 2s` with `s < (t+1)²`, then `v` or `-v` has all coordinates `≥ -t`. -/
lemma sign_flip (t s v1 v2 v3 v4 : ℤ) (ht : 0 ≤ t)
    (hQ : v1^2 + v2^2 + 2*v3^2 + 3*v4^2 = 2*s)
    (hs : s < (t+1)^2) :
    (-t ≤ v1 ∧ -t ≤ v2 ∧ -t ≤ v3 ∧ -t ≤ v4) ∨
    (v1 ≤ t ∧ v2 ≤ t ∧ v3 ≤ t ∧ v4 ≤ t) := by
  have hsq : ∀ x : ℤ, x < -t ∨ t < x → (t+1)^2 ≤ x^2 := by
    intro x hx
    rcases hx with hx | hx
    · have h1 : t + 1 ≤ -x := by linarith
      have h2 : (t+1)*(t+1) ≤ (-x)*(-x) := mul_le_mul h1 h1 (by linarith) (by linarith)
      linarith [h2]
    · have h1 : t + 1 ≤ x := by linarith
      have h2 : (t+1)*(t+1) ≤ x*x := mul_le_mul h1 h1 (by linarith) (by linarith)
      linarith [h2]
  by_contra hc
  rw [not_or] at hc
  obtain ⟨hA, hB⟩ := hc
  have hex1 : v1 < -t ∨ v2 < -t ∨ v3 < -t ∨ v4 < -t := by
    by_contra h
    push_neg at h
    exact hA ⟨h.1, h.2.1, h.2.2.1, h.2.2.2⟩
  have hex2 : t < v1 ∨ t < v2 ∨ t < v3 ∨ t < v4 := by
    by_contra h
    push_neg at h
    exact hB ⟨h.1, h.2.1, h.2.2.1, h.2.2.2⟩
  rcases hex1 with h1|h1|h1|h1 <;> rcases hex2 with h2|h2|h2|h2 <;>
    linarith [hsq _ (Or.inr h2), hsq _ (Or.inl h1),
      sq_nonneg v1, sq_nonneg v2, sq_nonneg v3, sq_nonneg v4]

/-- Auxiliary: from a `Λ₀`-vector with all coordinates `≥ -t`, build a quadruple. -/
lemma exists_quadruple_aux (n t s : ℕ) (v1 v2 v3 v4 : ℤ)
    (hsum : v1 + v2 + 2*v3 + 3*v4 = 0)
    (hQ4 : v1^2 + v2^2 + 2*v3^2 + 3*v4^2 = 2*(s:ℤ))
    (hb1 : -(t:ℤ) ≤ v1) (hb2 : -(t:ℤ) ≤ v2) (hb3 : -(t:ℤ) ≤ v3) (hb4 : -(t:ℤ) ≤ v4)
    (h6 : 2*n = 21*t^2 + 7*t + 6*s) :
    ∃ x y z w : ℕ, x ≤ y ∧ n = p3 x + p3 y + 2*p3 z + 3*p3 w ∧ x + y + 2*z + 3*w = 7*t := by
  obtain ⟨x1, hx1⟩ : ∃ x : ℕ, (x:ℤ) = (t:ℤ) + v1 :=
    ⟨((t:ℤ) + v1).toNat, Int.toNat_of_nonneg (by linarith)⟩
  obtain ⟨x2, hx2⟩ : ∃ x : ℕ, (x:ℤ) = (t:ℤ) + v2 :=
    ⟨((t:ℤ) + v2).toNat, Int.toNat_of_nonneg (by linarith)⟩
  obtain ⟨x3, hx3⟩ : ∃ x : ℕ, (x:ℤ) = (t:ℤ) + v3 :=
    ⟨((t:ℤ) + v3).toNat, Int.toNat_of_nonneg (by linarith)⟩
  obtain ⟨x4, hx4⟩ : ∃ x : ℕ, (x:ℤ) = (t:ℤ) + v4 :=
    ⟨((t:ℤ) + v4).toNat, Int.toNat_of_nonneg (by linarith)⟩
  have hz1 : 2*((p3 x1 : ℕ):ℤ) = ((t:ℤ)+v1)*(3*((t:ℤ)+v1)+1) := by
    rw [← hx1]; exact_mod_cast congrArg (fun k : ℕ => (k:ℤ)) (p3_two_mul x1)
  have hz2 : 2*((p3 x2 : ℕ):ℤ) = ((t:ℤ)+v2)*(3*((t:ℤ)+v2)+1) := by
    rw [← hx2]; exact_mod_cast congrArg (fun k : ℕ => (k:ℤ)) (p3_two_mul x2)
  have hz3 : 2*((p3 x3 : ℕ):ℤ) = ((t:ℤ)+v3)*(3*((t:ℤ)+v3)+1) := by
    rw [← hx3]; exact_mod_cast congrArg (fun k : ℕ => (k:ℤ)) (p3_two_mul x3)
  have hz4 : 2*((p3 x4 : ℕ):ℤ) = ((t:ℤ)+v4)*(3*((t:ℤ)+v4)+1) := by
    rw [← hx4]; exact_mod_cast congrArg (fun k : ℕ => (k:ℤ)) (p3_two_mul x4)
  have h6' : 2*(n:ℤ) = 21*(t:ℤ)^2 + 7*(t:ℤ) + 6*(s:ℤ) := by exact_mod_cast h6
  have key2 : 2*(n:ℤ) = 2*(((p3 x1 : ℕ):ℤ) + ((p3 x2 : ℕ):ℤ)
      + 2*((p3 x3 : ℕ):ℤ) + 3*((p3 x4 : ℕ):ℤ)) := by
    linear_combination h6' - hz1 - hz2 - 2*hz3 - 3*hz4 - (6*(t:ℤ)+1)*hsum - 3*hQ4
  have key : (n:ℤ) = ((p3 x1 : ℕ):ℤ) + ((p3 x2 : ℕ):ℤ)
      + 2*((p3 x3 : ℕ):ℤ) + 3*((p3 x4 : ℕ):ℤ) := by linarith
  have hval : n = p3 x1 + p3 x2 + 2*p3 x3 + 3*p3 x4 := by exact_mod_cast key
  have hsum7' : ((x1:ℕ):ℤ) + ((x2:ℕ):ℤ) + 2*((x3:ℕ):ℤ) + 3*((x4:ℕ):ℤ) = 7*(t:ℤ) := by
    rw [hx1, hx2, hx3, hx4]; linear_combination hsum
  have hsum7 : x1 + x2 + 2*x3 + 3*x4 = 7*t := by exact_mod_cast hsum7'
  rcases le_total x1 x2 with h | h
  · exact ⟨x1, x2, x3, x4, h, hval, hsum7⟩
  · exact ⟨x2, x1, x3, x4, h, by rw [hval]; ring, by omega⟩

/-- Main bridge: a `C1`-representation of `2s` yields a quadruple at level `t`. -/
lemma exists_quadruple (n t s : ℕ)
    (h6 : 2*n = 21*t^2 + 7*t + 6*s) (hlt : s < (t+1)^2)
    (hrep : C1.Represents (2*(s:ℤ))) :
    ∃ x y z w : ℕ, x ≤ y ∧ n = p3 x + p3 y + 2*p3 z + 3*p3 w ∧ x + y + 2*z + 3*w = 7*t := by
  obtain ⟨A, B, C, hABC⟩ := hrep
  have hQ4 : (A+B-C)^2 + (-A+B)^2 + 2*(-B-C)^2 + 3*C^2 = 2*(s:ℤ) := by
    rw [← hABC]; simp only [TForm.Q, C1]; ring
  have hsum : (A+B-C) + (-A+B) + 2*(-B-C) + 3*C = 0 := by ring
  have hs' : (s:ℤ) < ((t:ℤ)+1)^2 := by exact_mod_cast hlt
  rcases sign_flip (t:ℤ) (s:ℤ) (A+B-C) (-A+B) (-B-C) C (by positivity) hQ4 hs' with
    ⟨h1,h2,h3,h4⟩ | ⟨h1,h2,h3,h4⟩
  · exact exists_quadruple_aux n t s _ _ _ _ hsum hQ4 h1 h2 h3 h4 h6
  · exact exists_quadruple_aux n t s (-(A+B-C)) (-(-A+B)) (-(-B-C)) (-C)
      (by linear_combination -hsum) (by linear_combination hQ4)
      (by linarith) (by linarith) (by linarith) (by linarith) h6

/-- Two valid `t`-levels give `a n ≥ 2`. -/
lemma a_ge_two_of_two_t (n t1 s1 t2 s2 : ℕ) (hne : t1 ≠ t2)
    (h61 : 2*n = 21*t1^2 + 7*t1 + 6*s1) (hlt1 : s1 < (t1+1)^2)
    (hrep1 : C1.Represents (2*(s1:ℤ)))
    (h62 : 2*n = 21*t2^2 + 7*t2 + 6*s2) (hlt2 : s2 < (t2+1)^2)
    (hrep2 : C1.Represents (2*(s2:ℤ))) : 2 ≤ a n := by
  obtain ⟨x1, y1, z1, w1, hxy1, hv1, hs1⟩ := exists_quadruple n t1 s1 h61 hlt1 hrep1
  obtain ⟨x2, y2, z2, w2, hxy2, hv2, hs2⟩ := exists_quadruple n t2 s2 h62 hlt2 hrep2
  refine a_ge_two_of_witnesses n x1 y1 z1 w1 x2 y2 z2 w2 hxy1
    (by rw [P3_eq_p3]; exact hv1) hxy2 (by rw [P3_eq_p3]; exact hv2) ?_
  intro h
  rw [Prod.ext_iff, Prod.ext_iff, Prod.ext_iff] at h
  obtain ⟨⟨hx, hy⟩, hz, hw⟩ := h
  simp only at hx hy hz hw
  subst hx; subst hy; subst hz; subst hw
  omega

/-! # Analytic windows: two witnesses for all large `n` -/



/-- Jacobi symbol at 7 of a non-residue value. -/
private lemma J7_of_val (a : ℤ) (h3 : a = 3 ∨ a = 5 ∨ a = 6) : J(a | 7) = -1 := by
  have hne : ((a : ℤ) : ZMod 7) ≠ 0 := by rcases h3 with rfl|rfl|rfl <;> decide
  have hns : ¬ IsSquare ((a : ℤ) : ZMod 7) := by rcases h3 with rfl|rfl|rfl <;> decide
  have hg : Int.gcd a 7 = 1 := by rcases h3 with rfl|rfl|rfl <;> decide
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have h1 : legendreSym 7 a ≠ 1 := fun hcon =>
    hns ((legendreSym.eq_one_iff 7 hne).mp hcon)
  have h2 := jacobiSym.legendreSym.to_jacobiSym 7 a
  rcases jacobiSym.eq_one_or_neg_one (a := a) (b := 7) hg with h | h
  · exact absurd (h2.trans h) h1
  · exact h

/-- Jacobi symbol at 7 from the residue of `u`. -/
lemma J7_of_mod (u : ℕ) (h : u % 7 = 3 ∨ u % 7 = 5 ∨ u % 7 = 6) :
    J(((u:ℕ):ℤ) | 7) = -1 := by
  rw [jacobiSym.mod_left ((u:ℕ):ℤ) 7, ← Int.natCast_mod]
  apply J7_of_val
  rcases h with h|h|h <;> rw [h] <;> norm_num

/-- Core witness for `7 ∤ n`: a valid level `t` gives an admissible `s`. -/
lemma wit_core_not7 (n t : ℕ) (h7 : ¬ 7 ∣ n)
    (hmod : t % 3 = (2*n) % 3)
    (hlb : 21*t^2 + 7*t ≤ 2*n)
    (hub : 2*n < 27*t^2 + 19*t + 6) :
    ∃ s, 2*n = 21*t^2 + 7*t + 6*s ∧ s < (t+1)^2 ∧ C1.Represents (2*(s:ℤ)) := by
  have hp : 2 * p3 t = 3 * t^2 + t := by rw [p3_two_mul]; ring
  have hsqe : (t+1)^2 = t^2 + 2*t + 1 := by ring
  obtain ⟨s, hs⟩ : ∃ s, 2*n = 21*t^2 + 7*t + 6*s :=
    ⟨(2*n - (21*t^2 + 7*t))/6, by omega⟩
  have hs7 : ¬ 7 ∣ s := by omega
  have hs0 : 0 < s := by omega
  exact ⟨s, hs, by omega, rep_of_not_dvd7 s hs0 hs7⟩

/-- Core witness for `n = 7n'`: a valid good level `t` gives an admissible `s`. -/
lemma wit_core_7 (n' t : ℕ)
    (hmod : t % 3 = (2*(7*n')) % 3)
    (hgood : (5*n' + 3*(t % 7)^2 + t % 7) % 7 = 3 ∨
      (5*n' + 3*(t % 7)^2 + t % 7) % 7 = 5 ∨ (5*n' + 3*(t % 7)^2 + t % 7) % 7 = 6)
    (hlb : 21*t^2 + 7*t ≤ 2*(7*n'))
    (hub : 2*(7*n') < 27*t^2 + 19*t + 6) :
    ∃ s, 2*(7*n') = 21*t^2 + 7*t + 6*s ∧ s < (t+1)^2 ∧ C1.Represents (2*(s:ℤ)) := by
  have hp : 2 * p3 t = 3 * t^2 + t := by rw [p3_two_mul]; ring
  have hsqe : (t+1)^2 = t^2 + 2*t + 1 := by ring
  have hX7 : t^2 % 7 = ((t % 7)^2) % 7 := Nat.pow_mod t 2 7
  obtain ⟨s, hs⟩ : ∃ s, 2*(7*n') = 21*t^2 + 7*t + 6*s :=
    ⟨(2*(7*n') - (21*t^2 + 7*t))/6, by omega⟩
  obtain ⟨u, hu⟩ : ∃ u, s = 7*u := ⟨s/7, by omega⟩
  subst hu
  have hu7 : u % 7 = 3 ∨ u % 7 = 5 ∨ u % 7 = 6 := by
    rcases hgood with h|h|h
    · left; omega
    · right; left; omega
    · right; right; omega
  refine ⟨7*u, hs, by omega, ?_⟩
  have h0u : 0 < u := by omega
  have h7u : ¬ 7 ∣ u := by omega
  exact rep_of_seven u h0u h7u (J7_of_mod u hu7)

/-- Window bounds: any `t` in `[S+1, S+W]` is a valid level. -/
lemma window_bounds (S t n W : ℕ)
    (hW : 42*W*S + 7*S + 21*(W*W) + 7*W ≤ 6*(S*S))
    (ht1 : S+1 ≤ t) (ht2 : t ≤ S + W)
    (hlow : 27*(S*S) ≤ 2*n) (hhigh : 2*n < 27*((S+1)*(S+1))) :
    21*t^2 + 7*t ≤ 2*n ∧ 2*n < 27*t^2 + 19*t + 6 := by
  have e : t^2 = t*t := pow_two t
  constructor
  · have h1 : t*t ≤ (S+W)*(S+W) := Nat.mul_le_mul ht2 ht2
    nlinarith [h1, hlow, hW]
  · have h1 : (S+1)*(S+1) ≤ t*t := Nat.mul_le_mul ht1 ht1
    nlinarith [h1, hhigh]

/-- For `n ≥ 29822` with `7 ∤ n` there are two witnesses: `a n ≥ 2`. -/
theorem two_wit_not7 (n : ℕ) (h7 : ¬ 7 ∣ n) (hn : 29822 ≤ n) : 2 ≤ a n := by
  obtain ⟨S, hSdef⟩ : ∃ S, Nat.sqrt (2*n/27) = S := ⟨_, rfl⟩
  have hS1 : S*S ≤ 2*n/27 := by rw [← hSdef]; exact Nat.sqrt_le _
  have hS2 : 2*n/27 < (S+1)*(S+1) := by rw [← hSdef]; exact Nat.lt_succ_sqrt _
  have h47 : 47 ≤ S := by
    rw [← hSdef]
    exact Nat.le_sqrt.mpr (by omega)
  have hlow : 27*(S*S) ≤ 2*n := by omega
  have hhigh : 2*n < 27*((S+1)*(S+1)) := by omega
  have hW : 42*6*S + 7*S + 21*(6*6) + 7*6 ≤ 6*(S*S) := by
    have h2 : 47*S ≤ S*S := Nat.mul_le_mul h47 (le_refl S)
    linarith
  obtain ⟨t1, ht1a, ht1b, ht1m⟩ : ∃ t, S+1 ≤ t ∧ t ≤ S+3 ∧ t % 3 = (2*n) % 3 :=
    ⟨S+1+((2*n)%3 + 3 - (S+1)%3) % 3, by omega, by omega, by omega⟩
  have hb1 := window_bounds S t1 n 6 hW ht1a (by omega) hlow hhigh
  have hb2 := window_bounds S (t1+3) n 6 hW (by omega) (by omega) hlow hhigh
  obtain ⟨s1, h61, hlt1, hrep1⟩ := wit_core_not7 n t1 h7 ht1m hb1.1 hb1.2
  obtain ⟨s2, h62, hlt2, hrep2⟩ := wit_core_not7 n (t1+3) h7 (by omega) hb2.1 hb2.2
  exact a_ge_two_of_two_t n t1 s1 (t1+3) s2 (by omega) h61 hlt1 hrep1 h62 hlt2 hrep2

/-- Good residue classes mod 21 exist in pairs, for every residue of `n'`. -/
lemma good_pair : ∀ ν < 21, ∃ τ1 < 21, ∃ τ2 < 21, τ1 ≠ τ2 ∧
    τ1 % 3 = (14*ν) % 3 ∧ τ2 % 3 = (14*ν) % 3 ∧
    ((5*ν + 3*(τ1 % 7)^2 + τ1 % 7) % 7 = 3 ∨ (5*ν + 3*(τ1 % 7)^2 + τ1 % 7) % 7 = 5 ∨
      (5*ν + 3*(τ1 % 7)^2 + τ1 % 7) % 7 = 6) ∧
    ((5*ν + 3*(τ2 % 7)^2 + τ2 % 7) % 7 = 3 ∨ (5*ν + 3*(τ2 % 7)^2 + τ2 % 7) % 7 = 5 ∨
      (5*ν + 3*(τ2 % 7)^2 + τ2 % 7) % 7 = 6) := by decide +kernel

private lemma pick_mod21 (S τ : ℕ) (hτ : τ < 21) :
    ∃ t, S+1 ≤ t ∧ t ≤ S+21 ∧ t % 21 = τ :=
  ⟨S+1+((21 + τ) - (S+1) % 21) % 21, by omega, by omega, by omega⟩

private lemma mod3_pin (t τ ν n' : ℕ) (ht : t % 21 = τ) (hτ : τ % 3 = (14*ν) % 3)
    (hν : n' % 21 = ν) : t % 3 = (2*(7*n')) % 3 := by omega

private lemma ne_mod21 (t1 t2 τ1 τ2 : ℕ) (h1 : t1 % 21 = τ1) (h2 : t2 % 21 = τ2)
    (hne : τ1 ≠ τ2) : t1 ≠ t2 := by omega

private lemma mod7_of_mod21 (t τ : ℕ) (h : t % 21 = τ) : t % 7 = τ % 7 := by omega

/-- For `n = 7n' ≥ 372006` there are two witnesses: `a n ≥ 2`. -/
theorem two_wit_7 (n' : ℕ) (hn : 372006 ≤ 7*n') : 2 ≤ _root_.a (7*n') := by
  obtain ⟨S, hSdef⟩ : ∃ S, Nat.sqrt (2*(7*n')/27) = S := ⟨_, rfl⟩
  have hS1 : S*S ≤ 2*(7*n')/27 := by rw [← hSdef]; exact Nat.sqrt_le _
  have hS2 : 2*(7*n')/27 < (S+1)*(S+1) := by rw [← hSdef]; exact Nat.lt_succ_sqrt _
  have h166 : 166 ≤ S := by
    rw [← hSdef]
    exact Nat.le_sqrt.mpr (by omega)
  have hlow : 27*(S*S) ≤ 2*(7*n') := by omega
  have hhigh : 2*(7*n') < 27*((S+1)*(S+1)) := by omega
  have hW : 42*22*S + 7*S + 21*(22*22) + 7*22 ≤ 6*(S*S) := by
    have h2 : 166*S ≤ S*S := Nat.mul_le_mul h166 (le_refl S)
    linarith
  obtain ⟨ν, hν⟩ : ∃ ν, n' % 21 = ν := ⟨_, rfl⟩
  obtain ⟨τ1, hτ1lt, τ2, hτ2lt, hτne, m1, m2, g1, g2⟩ := good_pair ν (by omega)
  obtain ⟨t1, ht1a, ht1b, ht1m⟩ := pick_mod21 S τ1 hτ1lt
  obtain ⟨t2, ht2a, ht2b, ht2m⟩ := pick_mod21 S τ2 hτ2lt
  have hm1 : t1 % 3 = (2*(7*n')) % 3 := mod3_pin t1 τ1 ν n' ht1m m1 hν
  have hm2 : t2 % 3 = (2*(7*n')) % 3 := mod3_pin t2 τ2 ν n' ht2m m2 hν
  have hne12 : t1 ≠ t2 := ne_mod21 t1 t2 τ1 τ2 ht1m ht2m hτne
  have hb1 := window_bounds S t1 (7*n') 22 hW ht1a (Nat.le_succ_of_le ht1b) hlow hhigh
  have hb2 := window_bounds S t2 (7*n') 22 hW ht2a (Nat.le_succ_of_le ht2b) hlow hhigh
  have e1 : t1 % 7 = τ1 % 7 := mod7_of_mod21 t1 τ1 ht1m
  have e2 : t2 % 7 = τ2 % 7 := mod7_of_mod21 t2 τ2 ht2m
  have hg1 : (5*n' + 3*(t1 % 7)^2 + t1 % 7) % 7 = 3 ∨
      (5*n' + 3*(t1 % 7)^2 + t1 % 7) % 7 = 5 ∨ (5*n' + 3*(t1 % 7)^2 + t1 % 7) % 7 = 6 := by
    rw [e1]
    rcases g1 with h|h|h
    · left; omega
    · right; left; omega
    · right; right; omega
  have hg2 : (5*n' + 3*(t2 % 7)^2 + t2 % 7) % 7 = 3 ∨
      (5*n' + 3*(t2 % 7)^2 + t2 % 7) % 7 = 5 ∨ (5*n' + 3*(t2 % 7)^2 + t2 % 7) % 7 = 6 := by
    rw [e2]
    rcases g2 with h|h|h
    · left; omega
    · right; left; omega
    · right; right; omega
  obtain ⟨s1, h61, hlt1, hrep1⟩ := wit_core_7 n' t1 hm1 hg1 hb1.1 hb1.2
  obtain ⟨s2, h62, hlt2, hrep2⟩ := wit_core_7 n' t2 hm2 hg2 hb2.1 hb2.2
  exact a_ge_two_of_two_t (7*n') t1 s1 t2 s2 hne12 h61 hlt1 hrep1 h62 hlt2 hrep2

end BridgeWindows

/-! # Packed witness checking, `Nat.rec` version for kernel evaluation -/


/-- Check a packed run of `k` records (base-1024 digits, 8 per record)
starting at `n`, step `d`; `Nat.rec` form for fast kernel reduction. -/
def checkPackR (d : ℕ) (k n data : ℕ) : Bool :=
  Nat.rec (motive := fun _ => ℕ → ℕ → Bool)
    (fun _ _ => true)
    (fun _ ih n data =>
      (let r := Nat.mod data 1208925819614629174706176
       check2f n (Nat.mod r 1024) (Nat.mod (Nat.div r 1024) 1024)
         (Nat.mod (Nat.div r 1048576) 1024)
         (Nat.mod (Nat.div r 1073741824) 1024)
         (Nat.mod (Nat.div r 1099511627776) 1024)
         (Nat.mod (Nat.div r 1125899906842624) 1024)
         (Nat.mod (Nat.div r 1152921504606846976) 1024)
         (Nat.div r 1180591620717411303424))
      && ih (Nat.add n d) (Nat.div data 1208925819614629174706176))
    k n data

lemma checkPackR_zero (d n data : ℕ) : checkPackR d 0 n data = true := rfl

lemma checkPackR_succ (d k n data : ℕ) :
    checkPackR d (k+1) n data =
      (check2 n (data % 1208925819614629174706176 % 1024)
        (data % 1208925819614629174706176 / 1024 % 1024)
        (data % 1208925819614629174706176 / 1048576 % 1024)
        (data % 1208925819614629174706176 / 1073741824 % 1024)
        (data % 1208925819614629174706176 / 1099511627776 % 1024)
        (data % 1208925819614629174706176 / 1125899906842624 % 1024)
        (data % 1208925819614629174706176 / 1152921504606846976 % 1024)
        (data % 1208925819614629174706176 / 1180591620717411303424)
      && checkPackR d k (n + d) (data / 1208925819614629174706176)) := rfl

lemma checkPackR_covers (d : ℕ) (hd : 0 < d) : ∀ (k n data : ℕ),
    checkPackR d k n data = true → ∀ m, n ≤ m → m < n + d * k →
    d ∣ (m - n) → 2 ≤ a m := by
  intro k
  induction k with
  | zero => intro n data h m h1 h2 h3; omega
  | succ k ih =>
      intro n data h m h1 h2 h3
      rw [checkPackR_succ, Bool.and_eq_true] at h
      obtain ⟨hc, hr⟩ := h
      rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · exact check2_spec hc
      · have hmn : d ≤ m - n := by
          obtain ⟨c, hc'⟩ := h3
          rcases Nat.eq_zero_or_pos c with rfl | hcpos
          · omega
          · calc d = d * 1 := by ring
              _ ≤ d * c := Nat.mul_le_mul_left d hcpos
              _ = m - n := hc'.symm
        refine ih (n + d) _ hr m (by omega) (by rw [Nat.mul_succ] at h2; omega) ?_
        obtain ⟨c, hc'⟩ := h3
        exact ⟨c - 1, by cases c with
          | zero => omega
          | succ c' => simp [Nat.mul_succ] at hc' ⊢; omega⟩

