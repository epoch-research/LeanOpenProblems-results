  simp only [enumOKF, enumOK, Nat.mul_eq, Nat.add_eq, Nat.pow_eq]

/-- Kernel-friendly version of `enumFrom`. -/
def enumFromF (s : ℕ) : ℕ → Bool :=
  Nat.rec true (fun i acc => enumOKF (2*((s+i)/3150)+1) (2*((s+i)/1575%2)+1)
    (2*((s+i)/175%9)+1) ((s+i)/25%7+2) ((s+i)/5%5) ((s+i)%5) && acc)

lemma enumFromF_succ (s i : ℕ) :
    enumFromF s (i+1) = (enumOKF (2*((s+i)/3150)+1) (2*((s+i)/1575%2)+1)
      (2*((s+i)/175%9)+1) ((s+i)/25%7+2) ((s+i)/5%5) ((s+i)%5) && enumFromF s i) := rfl

lemma enumFromF_eq (s : ℕ) : ∀ N, enumFromF s N = enumFrom s N := by
  intro N
  induction N with
  | zero => rfl
  | succ N ih => rw [enumFromF_succ, enumFrom_succ, enumOKF_eq, ih]

