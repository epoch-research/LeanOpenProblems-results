/-- Enumeration of shifted codes satisfying the terminal conditions. -/
lemma tm_enum (A B C D E F : ℕ)
    (hA : A ≤ 3) (hB : B ≤ 4) (hC : C ≤ 16) (hDl : 2 ≤ D) (hDu : D ≤ 8)
    (hE : E ≤ 4) (hF : F ≤ 4)
    (n1 : A % 2 = 1) (n2 : B % 2 = 1) (n3 : C % 2 = 1)
    (n4 : 4*F^2 + 16 ≤ A^2 + 2*A + 16*F + 1)
    (n5 : 4*E^2 + 16 ≤ A^2 + 2*A + 16*E + 1)
    (n6 : 4*A^2*D^2 + 100*A^2 + 2*A*B*F^2 + 4*A*B + 8*A*D^2 + 16*A*D*E
        + 16*A*D*F + 40*A*E*F + 2*A*F^2 + 366*A + 2*B*F^2 + 6*B + 4*D^2
        + 16*D*E + 16*D*F + 4*E^2*F^2 + 16*E^2 + 104*E*F + 8*F^3 + 16*F^2
        + 24*F + 324
        ≤ A^2*B^2 + 2*A^2*B + 40*A^2*D + A^2 + 2*A*B^2 + 8*A*B*F
        + 8*A*D*E*F + 112*A*D + 80*A*E + 88*A*F + B^2 + 8*B*F + 8*D*E*F
        + 72*D + 16*E^2*F + 16*E*F^2 + 144*E + F^4 + 22*F^2 + 144*F + 9)
    (n7 : A ≤ B)
    (n8 : A*B + A + B + E^2 + 4*F + 3 ≤ A*C + A + C + 4*E + F^2 + 3)
    (n9 : A*B*C + A*B + A*C + 10*A*D + B*C + 4*B*E + 4*C*F + 2*D*E*F
        + 18*D + 24*E + 24*F
        = A*D^2 + 24*A + B*E^2 + 3*B + C*F^2 + 3*C + D^2 + 4*D*E + 4*D*F
        + E^2 + 10*E*F + F^2 + 114) :
    (A = 1 ∧ B = 1 ∧ C = 13 ∧ D = 5 ∧ E = 2 ∧ F = 1) ∨
    (A = 1 ∧ B = 1 ∧ C = 13 ∧ D = 5 ∧ E = 2 ∧ F = 3) ∨
    (A = 1 ∧ B = 3 ∧ C = 5 ∧ D = 5 ∧ E = 2 ∧ F = 1) ∨
    (A = 1 ∧ B = 3 ∧ C = 5 ∧ D = 5 ∧ E = 2 ∧ F = 3) ∨
    (A = 1 ∧ B = 3 ∧ C = 5 ∧ D = 4 ∧ E = 1 ∧ F = 2) ∨
    (A = 1 ∧ B = 3 ∧ C = 5 ∧ D = 6 ∧ E = 1 ∧ F = 2) ∨
    (A = 1 ∧ B = 3 ∧ C = 5 ∧ D = 4 ∧ E = 3 ∧ F = 2) ∨
    (A = 1 ∧ B = 3 ∧ C = 5 ∧ D = 6 ∧ E = 3 ∧ F = 2) := by
  have hcodes := enum_check (A/2) (by omega) (B/2) (by omega) (C/2) (by omega)
    (D-2) (by omega) E (by omega) F (by omega)
  rw [show 2*(A/2)+1 = A by omega, show 2*(B/2)+1 = B by omega,
    show 2*(C/2)+1 = C by omega, show D-2+2 = D by omega] at hcodes
  simp only [enumOK] at hcodes
  rw [show ((A % 2 == 1) && (B % 2 == 1) && (C % 2 == 1)
    && decide (4*F^2 + 16 ≤ A^2 + 2*A + 16*F + 1)
    && decide (4*E^2 + 16 ≤ A^2 + 2*A + 16*E + 1)
    && decide (4*A^2*D^2 + 100*A^2 + 2*A*B*F^2 + 4*A*B + 8*A*D^2 + 16*A*D*E
        + 16*A*D*F + 40*A*E*F + 2*A*F^2 + 366*A + 2*B*F^2 + 6*B + 4*D^2
        + 16*D*E + 16*D*F + 4*E^2*F^2 + 16*E^2 + 104*E*F + 8*F^3 + 16*F^2
        + 24*F + 324
        ≤ A^2*B^2 + 2*A^2*B + 40*A^2*D + A^2 + 2*A*B^2 + 8*A*B*F
        + 8*A*D*E*F + 112*A*D + 80*A*E + 88*A*F + B^2 + 8*B*F + 8*D*E*F
        + 72*D + 16*E^2*F + 16*E*F^2 + 144*E + F^4 + 22*F^2 + 144*F + 9)
    && (A ≤ B : Bool)
    && decide (A*B + A + B + E^2 + 4*F + 3 ≤ A*C + A + C + 4*E + F^2 + 3)
    && (A*B*C + A*B + A*C + 10*A*D + B*C + 4*B*E + 4*C*F + 2*D*E*F
        + 18*D + 24*E + 24*F
        == A*D^2 + 24*A + B*E^2 + 3*B + C*F^2 + 3*C + D^2 + 4*D*E + 4*D*F
        + E^2 + 10*E*F + F^2 + 114)) = true by
      simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
      tauto] at hcodes
  simp only [Bool.not_true, Bool.false_or, Bool.or_eq_true, Bool.and_eq_true,
    beq_iff_eq] at hcodes
  have flat : ∀ {P1 P2 P3 P4 P5 P6 : Prop}, ((((P1 ∧ P2) ∧ P3) ∧ P4) ∧ P5) ∧ P6 →
      P1 ∧ P2 ∧ P3 ∧ P4 ∧ P5 ∧ P6 :=
    fun h => ⟨h.1.1.1.1.1, h.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩
  rcases hcodes with (((((((h|h)|h)|h)|h)|h)|h)|h)
  · exact Or.inl (flat h)
  · exact Or.inr (Or.inl (flat h))
  · exact Or.inr (Or.inr (Or.inl (flat h)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (flat h))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (flat h)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (flat h))))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (flat h)))))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (flat h)))))))

end TForm

