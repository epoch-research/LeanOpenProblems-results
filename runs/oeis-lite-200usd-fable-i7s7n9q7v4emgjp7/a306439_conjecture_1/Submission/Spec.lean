lemma enumAll_cover : ∀ j < 6300, enumOK (2*(j/3150)+1) (2*(j/1575%2)+1)
    (2*(j/175%9)+1) (j/25%7+2) (j/5%5) (j%5) = true := by
  intro j hj
  rcases Nat.lt_or_ge j 630 with h | h0
  · exact enumFrom_spec 630 0 enumFrom_0 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 1260 with h | h1
  · exact enumFrom_spec 630 630 enumFrom_1 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 1890 with h | h2
  · exact enumFrom_spec 630 1260 enumFrom_2 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 2520 with h | h3
  · exact enumFrom_spec 630 1890 enumFrom_3 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 3150 with h | h4
  · exact enumFrom_spec 630 2520 enumFrom_4 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 3780 with h | h5
  · exact enumFrom_spec 630 3150 enumFrom_5 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 4410 with h | h6
  · exact enumFrom_spec 630 3780 enumFrom_6 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 5040 with h | h7
  · exact enumFrom_spec 630 4410 enumFrom_7 j (by omega) (by omega)
  rcases Nat.lt_or_ge j 5670 with h | h8
  · exact enumFrom_spec 630 5040 enumFrom_8 j (by omega) (by omega)
  exact enumFrom_spec 630 5670 enumFrom_9 j (by omega) (by omega)

lemma enum_check : ∀ u < (2:ℕ), ∀ v < (2:ℕ), ∀ w < (9:ℕ), ∀ i < (7:ℕ),
    ∀ e5 < (5:ℕ), ∀ f5 < (5:ℕ),
    enumOK (2*u+1) (2*v+1) (2*w+1) (i+2) e5 f5 = true := by
  intro u hu v hv w hw i hi e5 he5 f5 hf5
  have hj : ((((u*2+v)*9+w)*7+i)*5+e5)*5+f5 < 6300 := by omega
  have h1 := enumAll_cover _ hj
  have e1 : (((((u*2+v)*9+w)*7+i)*5+e5)*5+f5) / 3150 = u := by omega
  have e2 : (((((u*2+v)*9+w)*7+i)*5+e5)*5+f5) / 1575 % 2 = v := by omega
  have e3 : (((((u*2+v)*9+w)*7+i)*5+e5)*5+f5) / 175 % 9 = w := by omega
  have e4 : (((((u*2+v)*9+w)*7+i)*5+e5)*5+f5) / 25 % 7 = i := by omega
  have e5' : (((((u*2+v)*9+w)*7+i)*5+e5)*5+f5) / 5 % 5 = e5 := by omega
  have e6 : (((((u*2+v)*9+w)*7+i)*5+e5)*5+f5) % 5 = f5 := by omega
  rw [e1, e2, e3, e4, e5', e6] at h1
  exact h1

def C1 : TForm := ⟨2,4,6,1,-1,0⟩

/-- ℕ-valued quadratic used in the mod-18 obstruction check. -/
def obBody (c1 c2 c3 cxy x y z : ℕ) : ℕ :=
  (c1*x^2 + c2*y^2 + c3*z^2 + cxy*x*y) % 18

/-- Loop over all of `(ZMod 18)³` encoded as `i = x*324 + y*18 + z < 5832`. -/
def obLoop (c1 c2 c3 cxy : ℕ) : ℕ → Bool :=
  Nat.rec true (fun i acc => (obBody c1 c2 c3 cxy (i/324) (i/18%18) (i%18) != 12) && acc)

lemma obLoop_succ (c1 c2 c3 cxy i : ℕ) :
    obLoop c1 c2 c3 cxy (i+1) = ((obBody c1 c2 c3 cxy (i/324) (i/18%18) (i%18) != 12)
      && obLoop c1 c2 c3 cxy i) := rfl

lemma obLoop_spec (c1 c2 c3 cxy : ℕ) : ∀ N, obLoop c1 c2 c3 cxy N = true →
    ∀ i < N, obBody c1 c2 c3 cxy (i/324) (i/18%18) (i%18) ≠ 12 := by
  intro N
  induction N with
  | zero => intro _ i hi; omega
  | succ N ih =>
      intro h i hi
      rw [obLoop_succ, Bool.and_eq_true] at h
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | rfl
      · exact ih h.2 i hlt
      · simpa using h.1

/-- Kernel-friendly version of `obBody` using raw accelerated `Nat` primitives. -/
def obBodyF (c1 c2 c3 cxy x y z : ℕ) : ℕ :=
  Nat.mod (Nat.add (Nat.add (Nat.add (Nat.mul c1 (Nat.mul x x)) (Nat.mul c2 (Nat.mul y y)))
    (Nat.mul c3 (Nat.mul z z))) (Nat.mul cxy (Nat.mul x y))) 18

lemma obBodyF_eq (c1 c2 c3 cxy x y z : ℕ) :
    obBodyF c1 c2 c3 cxy x y z = obBody c1 c2 c3 cxy x y z := by
  show (c1*(x*x) + c2*(y*y) + c3*(z*z) + cxy*(x*y)) % 18 = _
  rw [obBody]
  congr 1
  ring

/-- Kernel-friendly version of `obLoop`. -/
def obLoopF (c1 c2 c3 cxy : ℕ) : ℕ → Bool :=
  Nat.rec true (fun i acc => (obBodyF c1 c2 c3 cxy (Nat.div i 324)
    (Nat.mod (Nat.div i 18) 18) (Nat.mod i 18) != 12) && acc)

lemma obLoopF_succ (c1 c2 c3 cxy i : ℕ) :
    obLoopF c1 c2 c3 cxy (i+1) = ((obBodyF c1 c2 c3 cxy (i/324) (i/18%18) (i%18) != 12)
      && obLoopF c1 c2 c3 cxy i) := rfl

lemma obLoopF_eq (c1 c2 c3 cxy : ℕ) :
    ∀ N, obLoopF c1 c2 c3 cxy N = obLoop c1 c2 c3 cxy N := by
  intro N
  induction N with
  | zero => rfl
  | succ N ih => rw [obLoopF_succ, obLoop_succ, obBodyF_eq, ih]

lemma obLF_1 : obLoopF 2 2 14 16 5832 = true := by decide +kernel
lemma obLoop_1 : obLoop 2 2 14 16 5832 = true := (obLoopF_eq 2 2 14 16 5832).symm.trans obLF_1
lemma obLF_2 : obLoopF 2 2 14 2 5832 = true := by decide +kernel
lemma obLoop_2 : obLoop 2 2 14 2 5832 = true := (obLoopF_eq 2 2 14 2 5832).symm.trans obLF_2
lemma obLF_3 : obLoopF 2 4 6 16 5832 = true := by decide +kernel
lemma obLoop_3 : obLoop 2 4 6 16 5832 = true := (obLoopF_eq 2 4 6 16 5832).symm.trans obLF_3
lemma obLF_4 : obLoopF 2 4 6 2 5832 = true := by decide +kernel
lemma obLoop_4 : obLoop 2 4 6 2 5832 = true := (obLoopF_eq 2 4 6 2 5832).symm.trans obLF_4

/-- Bridge: the ℕ-loop check gives the `ZMod 18` obstruction. -/
lemma mod18_of_obLoop (c1 c2 c3 cxy : ℕ) (h : obLoop c1 c2 c3 cxy 5832 = true) :
    ∀ x y z : ZMod 18, (c1 : ZMod 18)*x^2 + (c2 : ZMod 18)*y^2 + (c3 : ZMod 18)*z^2
      + (cxy : ZMod 18)*x*y ≠ 12 := by
  intro x y z hc
  have hx := x.val_lt
  have hy := y.val_lt
  have hz := z.val_lt
  have hi : x.val*324 + y.val*18 + z.val < 5832 := by omega
  have hnat := obLoop_spec c1 c2 c3 cxy 5832 h _ hi
  have e1 : (x.val*324 + y.val*18 + z.val)/324 = x.val := by omega
  have e2 : (x.val*324 + y.val*18 + z.val)/18 % 18 = y.val := by omega
  have e3 : (x.val*324 + y.val*18 + z.val) % 18 = z.val := by omega
  rw [e1, e2, e3] at hnat
  apply hnat
  rw [obBody]
  have hS : ((c1*x.val^2 + c2*y.val^2 + c3*z.val^2 + cxy*x.val*y.val : ℕ) : ZMod 18)
      = ((12 : ℕ) : ZMod 18) := by
    push_cast
    rw [ZMod.natCast_zmod_val x, ZMod.natCast_zmod_val y, ZMod.natCast_zmod_val z]
    first
      | exact hc
      | exact_mod_cast hc
      | (convert hc using 2)
      | (convert hc using 2 <;> norm_num)
  have hmod := (ZMod.natCast_eq_natCast_iff _ _ _).mp hS
  simpa [Nat.ModEq] using hmod

lemma mod18_obstruction_1 : ∀ x y z : ZMod 18,
    2*x^2 + 2*y^2 + 14*z^2 + 2*(-1)*x*y ≠ 12 := by
  intro x y z hc
  refine mod18_of_obLoop 2 2 14 16 obLoop_1 x y z ?_
  rw [← hc]
  push_cast
  have h18 : (18 : ZMod 18) = 0 := by decide
  linear_combination (x*y) * h18

lemma mod18_obstruction_2 : ∀ x y z : ZMod 18,
    2*x^2 + 2*y^2 + 14*z^2 + 2*1*x*y ≠ 12 := by
  intro x y z hc
  refine mod18_of_obLoop 2 2 14 2 obLoop_2 x y z ?_
  rw [← hc]
  push_cast
  ring

lemma mod18_obstruction_3 : ∀ x y z : ZMod 18,
    2*x^2 + 4*y^2 + 6*z^2 + 2*(-1)*x*y ≠ 12 := by
  intro x y z hc
  refine mod18_of_obLoop 2 4 6 16 obLoop_3 x y z ?_
  rw [← hc]
  push_cast
  have h18 : (18 : ZMod 18) = 0 := by decide
  linear_combination (x*y) * h18

lemma mod18_obstruction_4 : ∀ x y z : ZMod 18,
    2*x^2 + 4*y^2 + 6*z^2 + 2*1*x*y ≠ 12 := by
  intro x y z hc
  refine mod18_of_obLoop 2 4 6 2 obLoop_4 x y z ?_
  rw [← hc]
  push_cast
  ring

/-- Cast a represented value into `ZMod 18`. -/
lemma represents_mod18 {τ : TForm} {u : ℤ} (h : τ.Represents u) :
    ∃ x y z : ZMod 18, (τ.a : ZMod 18)*x^2 + (τ.b : ZMod 18)*y^2 + (τ.c : ZMod 18)*z^2
      + 2*(τ.d : ZMod 18)*y*z + 2*(τ.e : ZMod 18)*x*z + 2*(τ.f : ZMod 18)*x*y
      = (u : ZMod 18) := by
  obtain ⟨x, y, z, hQ⟩ := h
  refine ⟨(x : ZMod 18), (y : ZMod 18), (z : ZMod 18), ?_⟩
  have := congrArg (fun m : ℤ => (m : ZMod 18)) hQ
  simp only [Q] at this
  push_cast at this ⊢
  linear_combination this

lemma mod18_val {u : ℤ} (hu : u % 18 = 12) : (u : ZMod 18) = 12 := by
  have : u = 18 * (u / 18) + 12 := by omega
  rw [this]
  push_cast
  rw [show (18 : ZMod 18) = 0 by decide, zero_mul, zero_add]

/-- Each standard form either has the mod-18 obstruction or maps into `C1`. -/
lemma stdForms_represent {τ : TForm} (hτ : τ ∈ stdForms)
    (hu : ∃ u : ℤ, τ.Represents u ∧ u % 18 = 12) :
    ∀ n, τ.Represents n → C1.Represents n := by
  obtain ⟨u, hru, hu18⟩ := hu
  fin_cases hτ
  · exfalso
    obtain ⟨x, y, z, h⟩ := represents_mod18 hru
    rw [mod18_val hu18] at h
    exact mod18_obstruction_1 x y z (by push_cast at h ⊢; linear_combination h)
  · exfalso
    obtain ⟨x, y, z, h⟩ := represents_mod18 hru
    rw [mod18_val hu18] at h
    exact mod18_obstruction_2 x y z (by push_cast at h ⊢; linear_combination h)
  · exfalso
    obtain ⟨x, y, z, h⟩ := represents_mod18 hru
    rw [mod18_val hu18] at h
    exact mod18_obstruction_3 x y z (by push_cast at h ⊢; linear_combination h)
  · exfalso
    obtain ⟨x, y, z, h⟩ := represents_mod18 hru
    rw [mod18_val hu18] at h
    exact mod18_obstruction_4 x y z (by push_cast at h ⊢; linear_combination h)
  · -- (2,4,6,-1,-1,0) : (x,y,z) ↦ (x,-y,z)
    rintro n ⟨x, y, z, rfl⟩
    exact ⟨x, -y, z, by simp only [Q, C1]; ring⟩
  · -- (2,4,6,1,-1,0) = C1
    rintro n ⟨x, y, z, rfl⟩
    exact ⟨x, y, z, by simp only [Q, C1]⟩
  · -- (2,4,6,-1,1,0) : (x,y,z) ↦ (x,y,-z)
    rintro n ⟨x, y, z, rfl⟩
    exact ⟨x, y, -z, by simp only [Q, C1]; ring⟩
  · -- (2,4,6,1,1,0) : (x,y,z) ↦ (-x,y,z)
    rintro n ⟨x, y, z, rfl⟩
    exact ⟨-x, y, z, by simp only [Q, C1]; ring⟩

