/-- Check that a single record gives two distinct witnesses for `2 ≤ a n`. -/
def check2 (n x1 y1 z1 w1 x2 y2 z2 w2 : ℕ) : Bool :=
  x1.ble y1 && x2.ble y2 &&
  (n == p3 x1 + p3 y1 + 2 * p3 z1 + 3 * p3 w1) &&
  (n == p3 x2 + p3 y2 + 2 * p3 z2 + 3 * p3 w2) &&
  !(x1 == x2 && y1 == y2 && z1 == z2 && w1 == w2)

lemma check2_spec {n x1 y1 z1 w1 x2 y2 z2 w2 : ℕ}
    (h : check2 n x1 y1 z1 w1 x2 y2 z2 w2 = true) : 2 ≤ a n := by
  simp only [check2, Bool.and_eq_true, Bool.not_eq_true', Nat.ble_eq, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := h
  refine a_ge_two_of_witnesses n x1 y1 z1 w1 x2 y2 z2 w2 h1 h3 h2 h4 ?_
  intro hcontra
  rw [Prod.ext_iff, Prod.ext_iff, Prod.ext_iff] at hcontra
  simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq] at h5
  obtain ⟨⟨hx, hy⟩, hz, hw⟩ := hcontra
  rcases h5 with ((h|h)|h)|h <;> exact h (by assumption)

/-- Kernel-friendly `p3` using raw accelerated `Nat` primitives. -/
def p3f (k : ℕ) : ℕ := Nat.div (Nat.mul k (Nat.add (Nat.mul 3 k) 1)) 2

/-- Kernel-friendly record check, definitionally equal to `check2`. -/
def check2f (n x1 y1 z1 w1 x2 y2 z2 w2 : ℕ) : Bool :=
  Nat.ble x1 y1 && Nat.ble x2 y2 &&
  (n == Nat.add (Nat.add (Nat.add (p3f x1) (p3f y1)) (Nat.mul 2 (p3f z1)))
    (Nat.mul 3 (p3f w1))) &&
  (n == Nat.add (Nat.add (Nat.add (p3f x2) (p3f y2)) (Nat.mul 2 (p3f z2)))
    (Nat.mul 3 (p3f w2))) &&
  !(x1 == x2 && y1 == y2 && z1 == z2 && w1 == w2)

/-- Check a run of records starting at `n` with step `d`. -/
def checkRun (d : ℕ) : ℕ → List ℕ → Bool
  | _, [] => true
  | n, x1 :: y1 :: z1 :: w1 :: x2 :: y2 :: z2 :: w2 :: rest =>
      check2 n x1 y1 z1 w1 x2 y2 z2 w2 && checkRun d (n + d) rest
  | _, _ => false

lemma checkRun_covers (d : ℕ) (hd : 0 < d) (l : List ℕ) (n : ℕ) :
    checkRun d n l = true → ∀ m, n ≤ m → m < n + d * (l.length / 8) →
    d ∣ (m - n) → 2 ≤ a m := by
  induction n, l using checkRun.induct d with
  | case1 n => intro h m h1 h2 h3; simp at h2; omega
  | case2 n x1 y1 z1 w1 x2 y2 z2 w2 rest ih =>
      intro h m h1 h2 h3
      rw [checkRun, Bool.and_eq_true] at h
      obtain ⟨hc, hr⟩ := h
      rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · exact check2_spec hc
      · have hmn : d ≤ m - n := by
          obtain ⟨c, hc'⟩ := h3
          rcases Nat.eq_zero_or_pos c with rfl | hcpos
          · omega
          · calc d = d * 1 := by ring
              _ ≤ d * c := Nat.mul_le_mul_left d hcpos
              _ = m - n := hc'.symm
        refine ih hr m (by omega) ?_ ?_
        · have : (x1 :: y1 :: z1 :: w1 :: x2 :: y2 :: z2 :: w2 :: rest).length / 8
              = rest.length / 8 + 1 := by
            simp only [List.length_cons]
            omega
          rw [this] at h2
          have := Nat.mul_add d (rest.length / 8) 1
          omega
        · obtain ⟨c, hc'⟩ := h3
          exact ⟨c - 1, by cases c with | zero => omega | succ c' => simp [Nat.mul_succ] at hc' ⊢; omega⟩
  | case3 t n h1 h2 =>
      intro h m hm1 hm2 hm3
      exfalso
      rcases t with _ | ⟨a1, _ | ⟨a2, _ | ⟨a3, _ | ⟨a4, _ | ⟨a5, _ | ⟨a6, _ | ⟨a7, _ | ⟨a8, rest⟩⟩⟩⟩⟩⟩⟩⟩
      · exact h1 rfl
      all_goals first
        | exact h2 _ _ _ _ _ _ _ _ _ rfl
        | simp [checkRun.eq_def] at h

/-- Check a packed run of `k` records (base-1024 digits, 8 per record) starting at `n`, step `d`. -/
def checkPack (d : ℕ) : ℕ → ℕ → ℕ → Bool
  | _, 0, _ => true
  | n, k + 1, data =>
      check2 n (data % 1024) (data / 1024 % 1024) (data / 1024 ^ 2 % 1024)
        (data / 1024 ^ 3 % 1024) (data / 1024 ^ 4 % 1024) (data / 1024 ^ 5 % 1024)
        (data / 1024 ^ 6 % 1024) (data / 1024 ^ 7 % 1024)
      && checkPack d (n + d) k (data / 1024 ^ 8)

lemma checkPack_covers (d : ℕ) (hd : 0 < d) : ∀ (k n data : ℕ),
    checkPack d n k data = true → ∀ m, n ≤ m → m < n + d * k →
    d ∣ (m - n) → 2 ≤ a m := by
  intro k
  induction k with
  | zero => intro n data h m h1 h2 h3; omega
  | succ k ih =>
      intro n data h m h1 h2 h3
      rw [checkPack, Bool.and_eq_true] at h
      obtain ⟨hc, hr⟩ := h
      rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · exact check2_spec hc
      · have hmn : d ≤ m - n := by
          obtain ⟨c, hc'⟩ := h3
          rcases Nat.eq_zero_or_pos c with rfl | hcpos
          · omega
          · calc d = d * 1 := by ring
              _ ≤ d * c := Nat.mul_le_mul_left d hcpos
              _ = m - n := hc'.symm
        refine ih (n + d) _ hr m (by omega) (by rw [Nat.mul_succ] at h2; omega) ?_
        obtain ⟨c, hc'⟩ := h3
        exact ⟨c - 1, by cases c with
          | zero => omega
          | succ c' => simp [Nat.mul_succ] at hc' ⊢; omega⟩

section TernaryForms

open scoped NumberTheorySymbols

/-! # Reduction theory for even positive definite ternary quadratic forms of determinant 42 -/


/-- A ternary quadratic form given by its Gram matrix
`[[a,f,e],[f,b,d],[e,d,c]]`. -/
structure TForm where
  a : ℤ
  b : ℤ
  c : ℤ
  d : ℤ
  e : ℤ
  f : ℤ
deriving DecidableEq, Repr

namespace TForm

/-- The value of the form on `(x,y,z)`. -/
def Q (σ : TForm) (x y z : ℤ) : ℤ :=
  σ.a*x^2 + σ.b*y^2 + σ.c*z^2 + 2*σ.d*y*z + 2*σ.e*x*z + 2*σ.f*x*y

/-- The determinant of the Gram matrix. -/
def det (σ : TForm) : ℤ :=
  σ.a*σ.b*σ.c + 2*σ.f*σ.e*σ.d - σ.a*σ.d^2 - σ.b*σ.e^2 - σ.c*σ.f^2

/-- The form represents `n`. -/
def Represents (σ : TForm) (n : ℤ) : Prop := ∃ x y z : ℤ, σ.Q x y z = n

/-- Positive definiteness (as an integral form). -/
def PosDef (σ : TForm) : Prop :=
  ∀ x y z : ℤ, ¬(x = 0 ∧ y = 0 ∧ z = 0) → 0 < σ.Q x y z

/-- Even diagonal. -/
def EvenD (σ : TForm) : Prop := Even σ.a ∧ Even σ.b ∧ Even σ.c

/-- Same set of represented values. -/
def SameValues (σ τ : TForm) : Prop := ∀ n, σ.Represents n ↔ τ.Represents n

lemma sameValues_refl (σ : TForm) : SameValues σ σ := fun _ => Iff.rfl

lemma sameValues_trans {σ τ ρ : TForm} (h1 : SameValues σ τ) (h2 : SameValues τ ρ) :
    SameValues σ ρ := fun n => (h1 n).trans (h2 n)

/-- Terminal (reduced) conditions. -/
def Terminal (τ : TForm) : Prop :=
  4*τ.f^2 ≤ τ.a^2 ∧ 4*τ.e^2 ≤ τ.a^2 ∧
  4*(τ.a*τ.d - τ.e*τ.f)^2 ≤ (τ.a*τ.b - τ.f^2)^2 ∧
  τ.a ≤ τ.b ∧ τ.a*τ.b - τ.f^2 ≤ τ.a*τ.c - τ.e^2

/-- Termination potential. -/
def pot (σ : TForm) : ℤ := σ.a * (σ.a*σ.b - σ.f^2)

/-! ## Moves -/

/-- `v₂ ← v₂ + t v₁`. -/
def red2 (t : ℤ) (σ : TForm) : TForm :=
  ⟨σ.a, σ.b + 2*t*σ.f + t^2*σ.a, σ.c, σ.d + t*σ.e, σ.e, σ.f + t*σ.a⟩

/-- `v₃ ← v₃ + s v₁ + t v₂`. -/
def red3 (s t : ℤ) (σ : TForm) : TForm :=
  ⟨σ.a, σ.b, σ.c + s^2*σ.a + t^2*σ.b + 2*(s*t*σ.f + s*σ.e + t*σ.d),
   σ.d + s*σ.f + t*σ.b, σ.e + s*σ.a + t*σ.f, σ.f⟩

/-- Swap `v₁, v₂`. -/
def swap12 (σ : TForm) : TForm := ⟨σ.b, σ.a, σ.c, σ.e, σ.d, σ.f⟩

/-- Swap `v₂, v₃`. -/
def swap23 (σ : TForm) : TForm := ⟨σ.a, σ.c, σ.b, σ.d, σ.f, σ.e⟩

/-! ### Transformation identities -/

lemma red2_val (t : ℤ) (σ : TForm) (x y z : ℤ) :
    (red2 t σ).Q x y z = σ.Q (x + t*y) y z := by
  simp only [red2, Q]; ring

lemma red3_val (s t : ℤ) (σ : TForm) (x y z : ℤ) :
    (red3 s t σ).Q x y z = σ.Q (x + s*z) (y + t*z) z := by
  simp only [red3, Q]; ring

lemma swap12_val (σ : TForm) (x y z : ℤ) : (swap12 σ).Q x y z = σ.Q y x z := by
  simp only [swap12, Q]; ring

lemma swap23_val (σ : TForm) (x y z : ℤ) : (swap23 σ).Q x y z = σ.Q x z y := by
  simp only [swap23, Q]; ring

/-! ### SameValues -/

lemma red2_sameValues (t : ℤ) (σ : TForm) : SameValues σ (red2 t σ) := by
  intro n
  constructor
  · rintro ⟨x, y, z, rfl⟩
    exact ⟨x - t*y, y, z, by rw [red2_val]; ring_nf⟩
  · rintro ⟨x, y, z, rfl⟩
    exact ⟨x + t*y, y, z, (red2_val t σ x y z).symm⟩

lemma red3_sameValues (s t : ℤ) (σ : TForm) : SameValues σ (red3 s t σ) := by
  intro n
  constructor
  · rintro ⟨x, y, z, rfl⟩
    refine ⟨x - s*z, y - t*z, z, ?_⟩
    rw [red3_val]; ring_nf
  · rintro ⟨x, y, z, rfl⟩
    exact ⟨x + s*z, y + t*z, z, (red3_val s t σ x y z).symm⟩

lemma swap12_sameValues (σ : TForm) : SameValues σ (swap12 σ) := by
  intro n
  constructor
  · rintro ⟨x, y, z, rfl⟩; exact ⟨y, x, z, swap12_val σ y x z⟩
  · rintro ⟨x, y, z, rfl⟩; exact ⟨y, x, z, (swap12_val σ x y z).symm ▸ rfl⟩

lemma swap23_sameValues (σ : TForm) : SameValues σ (swap23 σ) := by
  intro n
  constructor
  · rintro ⟨x, y, z, rfl⟩; exact ⟨x, z, y, swap23_val σ x z y⟩
  · rintro ⟨x, y, z, rfl⟩; exact ⟨x, z, y, (swap23_val σ x y z).symm ▸ rfl⟩

/-! ### Determinant preservation -/

lemma red2_det (t : ℤ) (σ : TForm) : (red2 t σ).det = σ.det := by
  simp only [red2, det]; ring

lemma red3_det (s t : ℤ) (σ : TForm) : (red3 s t σ).det = σ.det := by
  simp only [red3, det]; ring

lemma swap12_det (σ : TForm) : (swap12 σ).det = σ.det := by
  simp only [swap12, det]; ring

lemma swap23_det (σ : TForm) : (swap23 σ).det = σ.det := by
  simp only [swap23, det]; ring

/-! ### Even diagonal preservation -/

lemma red2_evenD (t : ℤ) (σ : TForm) (h : EvenD σ) : EvenD (red2 t σ) := by
  obtain ⟨ha, hb, hc⟩ := h
  refine ⟨ha, ?_, hc⟩
  have : σ.b + 2*t*σ.f + t^2*σ.a = σ.b + 2*(t*σ.f) + t^2*σ.a := by ring
  simp only [red2]
  rw [this]
  exact ((hb.add (even_two_mul _)).add (Even.mul_left ha _))

lemma red3_evenD (s t : ℤ) (σ : TForm) (h : EvenD σ) : EvenD (red3 s t σ) := by
  obtain ⟨ha, hb, hc⟩ := h
  refine ⟨ha, hb, ?_⟩
  simp only [red3]
  exact ((hc.add (Even.mul_left ha _)).add (Even.mul_left hb _)).add (even_two_mul _)

lemma swap12_evenD (σ : TForm) (h : EvenD σ) : EvenD (swap12 σ) := ⟨h.2.1, h.1, h.2.2⟩

lemma swap23_evenD (σ : TForm) (h : EvenD σ) : EvenD (swap23 σ) := ⟨h.1, h.2.2, h.2.1⟩

/-! ### PosDef preservation -/

lemma red2_posDef (t : ℤ) (σ : TForm) (h : PosDef σ) : PosDef (red2 t σ) := by
  intro x y z hv
  rw [red2_val]
  exact h _ _ _ (by rintro ⟨h1, rfl, rfl⟩; simp at h1; omega)

lemma red3_posDef (s t : ℤ) (σ : TForm) (h : PosDef σ) : PosDef (red3 s t σ) := by
  intro x y z hv
  rw [red3_val]
  exact h _ _ _ (by rintro ⟨h1, h2, rfl⟩; simp at h1 h2; omega)

lemma swap12_posDef (σ : TForm) (h : PosDef σ) : PosDef (swap12 σ) := by
  intro x y z hv
  rw [swap12_val]
  exact h _ _ _ (by tauto)

lemma swap23_posDef (σ : TForm) (h : PosDef σ) : PosDef (swap23 σ) := by
  intro x y z hv
  rw [swap23_val]
  exact h _ _ _ (by tauto)

/-! ### Facts from positive definiteness -/

lemma posDef_a {σ : TForm} (h : PosDef σ) : 0 < σ.a := by
  have := h 1 0 0 (by simp)
  simpa [Q] using this

lemma posDef_c {σ : TForm} (h : PosDef σ) : 0 < σ.c := by
  have := h 0 0 1 (by simp)
  simpa [Q] using this

lemma posDef_D2 {σ : TForm} (h : PosDef σ) : 0 < σ.a*σ.b - σ.f^2 := by
  have ha := posDef_a h
  have hv := h σ.f (-σ.a) 0 (by intro hc; omega)
  have hval : σ.Q σ.f (-σ.a) 0 = σ.a * (σ.a*σ.b - σ.f^2) := by simp only [Q]; ring
  rw [hval] at hv
  by_contra hcon
  push_neg at hcon
  have h0 : σ.a * (σ.a*σ.b - σ.f^2) ≤ σ.a * 0 := mul_le_mul_of_nonneg_left hcon ha.le
  rw [mul_zero] at h0
  linarith

/-! ### Potential -/

lemma red2_pot (t : ℤ) (σ : TForm) : pot (red2 t σ) = pot σ := by
  simp only [red2, pot]; ring

lemma red3_pot (s t : ℤ) (σ : TForm) : pot (red3 s t σ) = pot σ := by
  simp only [red3, pot]

lemma swap12_pot (σ : TForm) : pot (swap12 σ) = σ.b * (σ.a*σ.b - σ.f^2) := by
  simp only [swap12, pot]; ring

lemma swap23_pot (σ : TForm) : pot (swap23 σ) = σ.a * (σ.a*σ.c - σ.e^2) := by
  simp only [swap23, pot]

/-- Rounding helper: there is `t` with `-a ≤ 2(x + a t) < a`. -/
lemma exists_round (a x : ℤ) (ha : 0 < a) :
    ∃ t : ℤ, -a ≤ 2*(x + a*t) ∧ 2*(x + a*t) < a := by
  set q := (2*x + a) / (2*a) with hq
  set r := (2*x + a) % (2*a) with hr
  have h1 : 2*a*q + r = 2*x + a := Int.ediv_add_emod _ _
  have h2 : 0 ≤ r := Int.emod_nonneg _ (by omega)
  have h3 : r < 2*a := Int.emod_lt_of_pos _ (by omega)
  refine ⟨-q, ?_, ?_⟩ <;>
  · have key : 2 * (x + a * -q) = r - a := by linear_combination -h1
    rw [key]
    linarith

/-- Every positive definite form can be reduced to a terminal form with the
same values, determinant, evenness. -/
lemma exists_terminal : ∀ (n : ℕ) (σ : TForm), (pot σ).toNat ≤ n → PosDef σ →
    ∃ τ : TForm, PosDef τ ∧ Terminal τ ∧ τ.det = σ.det ∧ SameValues σ τ ∧
      (EvenD σ → EvenD τ) := by
  intro n
  induction n with
  | zero =>
      intro σ hn hpd
      exfalso
      have h1 := posDef_a hpd
      have h2 := posDef_D2 hpd
      have : 0 < pot σ := mul_pos h1 h2
      omega
  | succ n ih =>
      intro σ hn hpd
      -- Step 1: size-reduce v₂ against v₁
      obtain ⟨t₁, ht₁, ht₁'⟩ := exists_round σ.a σ.f (posDef_a hpd)
      set σ₁ := red2 t₁ σ with hσ₁
      have hpd₁ : PosDef σ₁ := red2_posDef t₁ σ hpd
      have hT1 : 4*σ₁.f^2 ≤ σ₁.a^2 := by
        have hf : σ₁.f = σ.f + t₁*σ.a := rfl
        have ha : σ₁.a = σ.a := rfl
        rw [hf, ha]
        have h2 : 0 ≤ (σ.a - 2*(σ.f + σ.a*t₁)) * (σ.a + 2*(σ.f + σ.a*t₁)) :=
          mul_nonneg (by linarith) (by linarith)
        linarith [h2]
      -- Step 2: size-reduce v₃ against v₂ then v₁
      have hD2₁ : 0 < σ₁.a*σ₁.b - σ₁.f^2 := posDef_D2 hpd₁
      obtain ⟨t₂, ht₂, ht₂'⟩ := exists_round (σ₁.a*σ₁.b - σ₁.f^2) (σ₁.a*σ₁.d - σ₁.e*σ₁.f) hD2₁
      obtain ⟨s₂, hs₂, hs₂'⟩ := exists_round σ₁.a (σ₁.e + t₂*σ₁.f) (posDef_a hpd₁)
      set σ₂ := red3 s₂ t₂ σ₁ with hσ₂
      have hpd₂ : PosDef σ₂ := red3_posDef s₂ t₂ σ₁ hpd₁
      have ha₂ : σ₂.a = σ₁.a := rfl
      have hb₂ : σ₂.b = σ₁.b := rfl
      have hf₂ : σ₂.f = σ₁.f := rfl
      have he₂ : σ₂.e = σ₁.e + s₂*σ₁.a + t₂*σ₁.f := rfl
      have hd₂ : σ₂.d = σ₁.d + s₂*σ₁.f + t₂*σ₁.b := rfl
      have hT1₂ : 4*σ₂.f^2 ≤ σ₂.a^2 := hT1
      have hT2e : 4*σ₂.e^2 ≤ σ₂.a^2 := by
        rw [he₂, ha₂]
        have h2 : 0 ≤ (σ₁.a - 2*(σ₁.e + t₂*σ₁.f + σ₁.a*s₂))
            * (σ₁.a + 2*(σ₁.e + t₂*σ₁.f + σ₁.a*s₂)) :=
          mul_nonneg (by linarith) (by linarith)
        linarith [h2]
      have hT2d : 4*(σ₂.a*σ₂.d - σ₂.e*σ₂.f)^2 ≤ (σ₂.a*σ₂.b - σ₂.f^2)^2 := by
        have key : σ₂.a*σ₂.d - σ₂.e*σ₂.f
            = (σ₁.a*σ₁.d - σ₁.e*σ₁.f) + (σ₁.a*σ₁.b - σ₁.f^2)*t₂ := by
          rw [ha₂, hd₂, he₂, hf₂]; ring
        have keyD : σ₂.a*σ₂.b - σ₂.f^2 = σ₁.a*σ₁.b - σ₁.f^2 := by
          rw [ha₂, hb₂, hf₂]
        rw [key, keyD]
        have h2 : 0 ≤ ((σ₁.a*σ₁.b - σ₁.f^2)
              - 2*((σ₁.a*σ₁.d - σ₁.e*σ₁.f) + (σ₁.a*σ₁.b - σ₁.f^2)*t₂))
            * ((σ₁.a*σ₁.b - σ₁.f^2)
              + 2*((σ₁.a*σ₁.d - σ₁.e*σ₁.f) + (σ₁.a*σ₁.b - σ₁.f^2)*t₂)) :=
          mul_nonneg (by linarith) (by linarith)
        linarith [h2]
      have hpot₂ : pot σ₂ = pot σ := by
        rw [hσ₂, red3_pot, hσ₁, red2_pot]
      have hsv₂ : SameValues σ σ₂ :=
        sameValues_trans (red2_sameValues t₁ σ) (red3_sameValues s₂ t₂ σ₁)
      have hdet₂ : σ₂.det = σ.det := by
        rw [hσ₂, red3_det, hσ₁, red2_det]
      have hev₂ : EvenD σ → EvenD σ₂ := fun h =>
        red3_evenD s₂ t₂ σ₁ (red2_evenD t₁ σ h)
      by_cases hb : σ₂.b < σ₂.a
      · -- swap v₁, v₂; potential decreases
        set σ₃ := swap12 σ₂ with hσ₃
        have hpd₃ : PosDef σ₃ := swap12_posDef σ₂ hpd₂
        have hpotdec : pot σ₃ < pot σ₂ := by
          rw [hσ₃, swap12_pot, pot]
          have hD := posDef_D2 hpd₂
          have h := mul_lt_mul_of_pos_right hb hD
          linarith [h]
        have hpos₃ : 0 < pot σ₃ := mul_pos (posDef_a hpd₃) (posDef_D2 hpd₃)
        obtain ⟨τ, h1, h2, h3, h4, h5⟩ := ih σ₃ (by omega) hpd₃
        refine ⟨τ, h1, h2, ?_, ?_, ?_⟩
        · rw [h3, hσ₃, swap12_det, hdet₂]
        · exact sameValues_trans hsv₂ (sameValues_trans (swap12_sameValues σ₂) h4)
        · exact fun h => h5 (swap12_evenD σ₂ (hev₂ h))
      · by_cases hc : σ₂.a*σ₂.c - σ₂.e^2 < σ₂.a*σ₂.b - σ₂.f^2
        · -- swap v₂, v₃; potential decreases
          set σ₃ := swap23 σ₂ with hσ₃
          have hpd₃ : PosDef σ₃ := swap23_posDef σ₂ hpd₂
          have hpotdec : pot σ₃ < pot σ₂ := by
            rw [hσ₃, swap23_pot, pot]
            have ha' := posDef_a hpd₂
            have h := mul_lt_mul_of_pos_left hc ha'
            linarith [h]
          have hpos₃ : 0 < pot σ₃ := mul_pos (posDef_a hpd₃) (posDef_D2 hpd₃)
          obtain ⟨τ, h1, h2, h3, h4, h5⟩ := ih σ₃ (by omega) hpd₃
          refine ⟨τ, h1, h2, ?_, ?_, ?_⟩
          · rw [h3, hσ₃, swap23_det, hdet₂]
          · exact sameValues_trans hsv₂ (sameValues_trans (swap23_sameValues σ₂) h4)
          · exact fun h => h5 (swap23_evenD σ₂ (hev₂ h))
        · -- terminal
          push_neg at hb hc
          exact ⟨σ₂, hpd₂, ⟨hT1₂, hT2e, hT2d, hb, hc⟩, hdet₂, hsv₂, hev₂⟩


/-! ## Enumeration of terminal forms -/

/-- The eight terminal even positive definite forms of determinant 42. -/
def stdForms : List TForm :=
  [⟨2,2,14,0,0,-1⟩, ⟨2,2,14,0,0,1⟩, ⟨2,4,6,0,0,-1⟩, ⟨2,4,6,0,0,1⟩,
   ⟨2,4,6,-1,-1,0⟩, ⟨2,4,6,1,-1,0⟩, ⟨2,4,6,-1,1,0⟩, ⟨2,4,6,1,1,0⟩]

/-- Pure-ℕ check used for the enumeration of terminal forms
(coordinates shifted: `a = an+1, b = bn+1, c = cn+1, d = dn-5, e = en-2, f = fn-2`). -/
def enumOK (an bn cn dn en fn : ℕ) : Bool :=
  !((an % 2 == 1) && (bn % 2 == 1) && (cn % 2 == 1)
    && decide (4*fn^2 + 16 ≤ an^2 + 2*an + 16*fn + 1)
    && decide (4*en^2 + 16 ≤ an^2 + 2*an + 16*en + 1)
    && decide (4*an^2*dn^2 + 100*an^2 + 2*an*bn*fn^2 + 4*an*bn + 8*an*dn^2 + 16*an*dn*en
        + 16*an*dn*fn + 40*an*en*fn + 2*an*fn^2 + 366*an + 2*bn*fn^2 + 6*bn + 4*dn^2
        + 16*dn*en + 16*dn*fn + 4*en^2*fn^2 + 16*en^2 + 104*en*fn + 8*fn^3 + 16*fn^2
        + 24*fn + 324
        ≤ an^2*bn^2 + 2*an^2*bn + 40*an^2*dn + an^2 + 2*an*bn^2 + 8*an*bn*fn
        + 8*an*dn*en*fn + 112*an*dn + 80*an*en + 88*an*fn + bn^2 + 8*bn*fn + 8*dn*en*fn
        + 72*dn + 16*en^2*fn + 16*en*fn^2 + 144*en + fn^4 + 22*fn^2 + 144*fn + 9)
    && (an ≤ bn : Bool)
    && decide (an*bn + an + bn + en^2 + 4*fn + 3 ≤ an*cn + an + cn + 4*en + fn^2 + 3)
    && (an*bn*cn + an*bn + an*cn + 10*an*dn + bn*cn + 4*bn*en + 4*cn*fn + 2*dn*en*fn
        + 18*dn + 24*en + 24*fn
        == an*dn^2 + 24*an + bn*en^2 + 3*bn + cn*fn^2 + 3*cn + dn^2 + 4*dn*en + 4*dn*fn
        + en^2 + 10*en*fn + fn^2 + 114))
  || ((an == 1) && (bn == 1) && (cn == 13) && (dn == 5) && (en == 2) && (fn == 1))
  || ((an == 1) && (bn == 1) && (cn == 13) && (dn == 5) && (en == 2) && (fn == 3))
  || ((an == 1) && (bn == 3) && (cn == 5) && (dn == 5) && (en == 2) && (fn == 1))
  || ((an == 1) && (bn == 3) && (cn == 5) && (dn == 5) && (en == 2) && (fn == 3))
  || ((an == 1) && (bn == 3) && (cn == 5) && (dn == 4) && (en == 1) && (fn == 2))
  || ((an == 1) && (bn == 3) && (cn == 5) && (dn == 6) && (en == 1) && (fn == 2))
  || ((an == 1) && (bn == 3) && (cn == 5) && (dn == 4) && (en == 3) && (fn == 2))
  || ((an == 1) && (bn == 3) && (cn == 5) && (dn == 6) && (en == 3) && (fn == 2))

/-- Single loop over encoded tuples:
`j = ((((u*2+v)*9+w)*7+i)*5+e5)*5+f5 < 6300` with
`an = 2u+1, bn = 2v+1, cn = 2w+1, dn = i+2, en = e5, fn = f5`. -/
def enumFrom (s : ℕ) : ℕ → Bool :=
  Nat.rec true (fun i acc => enumOK (2*((s+i)/3150)+1) (2*((s+i)/1575%2)+1)
    (2*((s+i)/175%9)+1) ((s+i)/25%7+2) ((s+i)/5%5) ((s+i)%5) && acc)

lemma enumFrom_succ (s i : ℕ) :
    enumFrom s (i+1) = (enumOK (2*((s+i)/3150)+1) (2*((s+i)/1575%2)+1)
      (2*((s+i)/175%9)+1) ((s+i)/25%7+2) ((s+i)/5%5) ((s+i)%5) && enumFrom s i) := rfl

lemma enumFrom_spec : ∀ N s, enumFrom s N = true →
    ∀ j, s ≤ j → j < s + N → enumOK (2*(j/3150)+1) (2*(j/1575%2)+1) (2*(j/175%9)+1)
      (j/25%7+2) (j/5%5) (j%5) = true := by
  intro N
  induction N with
  | zero => intro s _ j h1 h2; omega
  | succ N ih =>
      intro s h j h1 h2
      rw [enumFrom_succ, Bool.and_eq_true] at h
      rcases Nat.lt_or_ge j (s + N) with hlt | hge
      · exact ih s h.2 j h1 hlt
      · have hje : j = s + N := by omega
        subst hje
        exact h.1

