/-- Sharpness of the conjecture's threshold: `a 473 = 0`, so `474` is optimal. -/
theorem a_473_eq_zero : a 473 = 0 := by
  by_contra h
  obtain ⟨p, q, hp, hq, hpq, hsum⟩ := (a_pos_iff 473).mp (Nat.pos_of_ne_zero h)
  have hmono : next_prime p ≤ next_prime q :=
    Nat.sInf_le ⟨(next_prime_spec q).1, lt_of_le_of_lt hpq (next_prime_spec q).2⟩
  have hSle : S_sum p ≤ S_sum q := by rw [S_sum, S_sum]; omega
  have hp2 : 2 ≤ p := hp.two_le
  have hnpp : p < next_prime p := (next_prime_spec p).2
  have hb : p ≤ 236 := by
    have h2 : 2 * S_sum p ≤ 946 := by omega
    rw [S_sum] at h2
    omega
  have hmem : p ∈ List.range' 2 235 := List.mem_range'_1.mpr ⟨hp2, by omega⟩
  have hcov := List.all_eq_true.mp hzCover p hmem
  rw [Bool.or_eq_true] at hcov
  rcases hcov with hc | hc
  · exact absurd hp (compB_correct hc)
  · rw [List.any_eq_true] at hc
    obtain ⟨e, hemem, hee⟩ := hc
    obtain ⟨p1, p1', q0, q1⟩ := e
    have hep : p1 = p := by simpa using hee
    subst hep
    have hchk := List.all_eq_true.mp hzAll _ hemem
    exact checkZ_correct hchk q hq (by omega)

