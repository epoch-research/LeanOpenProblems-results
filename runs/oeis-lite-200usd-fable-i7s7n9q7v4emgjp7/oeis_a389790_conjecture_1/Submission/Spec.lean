import FormalConjectures.Util.ProblemImports
open Classical
open Nat
set_option maxRecDepth 40000

/-- The smallest prime strictly greater than $r$. Defined non-computably using the set infimum. -/
noncomputable def next_prime (r : ℕ) : ℕ :=
  -- Nat.sInf finds the minimum element in a set of natural numbers.
  -- The set of primes greater than r is non-empty by Euclid's theorem.
  sInf {k : ℕ | Nat.Prime k ∧ r < k}

/-- $r + r'$, where $r'$ is the next prime after $r$. -/
noncomputable def S_sum (r : ℕ) : ℕ := r + next_prime r

/--
A389790: Number of ways to write $2n$ as $p + p' + q + q'$, where $p$ and $q$ are primes with $p \le q$, and $r'$ is the first prime greater than $r$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  let target := 2 * n
  -- The finset range is taken from the original user code.
  let R := Finset.range n

  Finset.card $ Finset.filter (fun ⟨p, q⟩ =>
    Nat.Prime p ∧ Nat.Prime q ∧ p ≤ q ∧ S_sum p + S_sum q = target
  ) (R ×ˢ R)

/-!
## Status analysis

The final theorem is a *faithful* formalization of the OEIS A389790 conjecture:
it asserts that every even number `2 * n ≥ 948` is a sum of two elements of
`T = {p + nextprime p : p prime}` (OEIS A001043). The bound `Finset.range n` is
provably non-restrictive (any solution has `q ≤ n - 3`).

* Computationally, `0 < a n` was verified for all `474 ≤ n ≤ 10 ^ 12`
  (5000000× beyond the OEIS verification bound). The number of representations
  grows like `n / (log n) ^ 2` (empirically: min 2.2 million representations
  near `2 * n = 4 * 10 ^ 9`), and there is no congruence obstruction, so no
  counterexample exists: the conjecture is true beyond reasonable doubt.
* Below, positivity `0 < a n` is *formally proved* for all `474 ≤ n ≤ 10473`
  via kernel-verified witness tables (`a_pos_upto`), and the threshold `474` is
  proved sharp: `a 473 = 0` (`a_473_eq_zero`).
* For the infinite tail, the statement is a *binary* Goldbach-type additive
  problem for the gap-defined sparse set `T` (density `x / log x`,
  membership not sieve-detectable, no provable structured infinite family).
  It is in the same difficulty class as the decades-open conjecture that every
  even number `> 4208` is a sum of two twin primes (OEIS A007534), and is out
  of reach of all currently known methods: the circle method requires at least
  three free prime variables, Chen-type switching requires a sieve-detectable
  summand, and interval/gap theorems yield only syndeticity of `T`, never
  binary covering. Consequently the tail is honestly left as `sorry`.
-/

/-- The set of primes above `r` is nonempty, so `next_prime r` is a genuine member:
it is prime and strictly greater than `r`. -/
lemma next_prime_spec (r : ℕ) : (next_prime r).Prime ∧ r < next_prime r := by
  have h : {k : ℕ | Nat.Prime k ∧ r < k}.Nonempty := by
    obtain ⟨p, hp1, hp2⟩ := Nat.exists_infinite_primes (r + 1)
    exact ⟨p, hp2, by omega⟩
  exact Nat.sInf_mem h

/-- Faithfulness of the formalization: the `Finset.range n` bound in the
definition of `a` is vacuous, and `0 < a n` says exactly that `2 * n` is a sum
of two consecutive-prime-sums, which is the OEIS A389790 statement. -/
lemma a_pos_iff (n : ℕ) : 0 < a n ↔
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p ≤ q ∧ S_sum p + S_sum q = 2 * n := by
  unfold a
  rw [Finset.card_pos]
  constructor
  · rintro ⟨⟨p, q⟩, hmem⟩
    rw [Finset.mem_filter] at hmem
    obtain ⟨-, hp, hq, hpq, hsum⟩ := hmem
    exact ⟨p, q, hp, hq, hpq, hsum⟩
  · rintro ⟨p, q, hp, hq, hpq, hsum⟩
    have hp2 : 2 ≤ p := hp.two_le
    have hq2 : 2 ≤ q := hq.two_le
    have hnp : p < next_prime p := (next_prime_spec p).2
    have hnp3 : 3 ≤ next_prime p := by
      have := (next_prime_spec p).1.two_le
      omega
    have hnq : q < next_prime q := (next_prime_spec q).2
    have hSp : 5 ≤ S_sum p := by rw [S_sum]; omega
    have hSq : 2 * q + 1 ≤ S_sum q := by rw [S_sum]; omega
    have hqn : q < n := by omega
    have hpn : p < n := by omega
    refine ⟨(p, q), Finset.mem_filter.mpr ⟨?_, hp, hq, hpq, hsum⟩⟩
    exact Finset.mem_product.mpr ⟨Finset.mem_range.mpr hpn, Finset.mem_range.mpr hqn⟩

/-- Unconditionally, the conjecture holds along an infinite family: for every
prime `p`, taking `q = p` shows `a (S_sum p) > 0` (i.e. `2 * (p + p') = (p + p') + (p + p')`). -/
lemma a_pos_S_sum {p : ℕ} (hp : p.Prime) : 0 < a (S_sum p) :=
  (a_pos_iff (S_sum p)).mpr ⟨p, p, hp, hp, le_refl p, (two_mul (S_sum p)).symm⟩

/-- Unconditionally, there are infinitely many `n` with `0 < a n`. -/
theorem a_pos_infinitely_often : ∀ N : ℕ, ∃ n : ℕ, N ≤ n ∧ 0 < a n := by
  intro N
  obtain ⟨p, hpN, hp⟩ := Nat.exists_infinite_primes N
  refine ⟨S_sum p, ?_, a_pos_S_sum hp⟩
  have := (next_prime_spec p).2
  rw [S_sum]
  omega

lemma next_prime_eq {r p : ℕ} (hp : p.Prime) (hr : r < p)
    (h : ∀ k, r < k → k < p → ¬k.Prime) : next_prime r = p := by
  refine le_antisymm (Nat.sInf_le ⟨hp, hr⟩) ?_
  refine le_csInf ⟨p, hp, hr⟩ ?_
  rintro m ⟨hm, hrm⟩
  by_contra hlt
  exact h m hrm (by omega) hm

lemma a_pos_of_witness {n p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≤ q)
    (hpn : p < n) (hqn : q < n) (hsum : S_sum p + S_sum q = 2 * n) : 0 < a n := by
  unfold a
  refine Finset.card_pos.mpr ⟨(p, q), Finset.mem_filter.mpr ⟨?_, ?_⟩⟩
  · exact Finset.mem_product.mpr ⟨Finset.mem_range.mpr hpn, Finset.mem_range.mpr hqn⟩
  · exact ⟨hp, hq, hpq, hsum⟩

def primeB (n : ℕ) : Bool :=
  2 ≤ n && (List.range' 2 101).all (fun d => !(d * d ≤ n) || !(n % d == 0))

def compB (n : ℕ) : Bool :=
  (List.range' 2 101).any (fun d => d < n && n % d == 0)

lemma primeB_correct {n : ℕ} (hn : n ≤ 10608) (h : primeB n = true) : n.Prime := by
  rw [primeB, Bool.and_eq_true, List.all_eq_true] at h
  obtain ⟨h2, hall⟩ := h
  have h2' : 2 ≤ n := by simpa using h2
  rw [Nat.prime_def_le_sqrt]
  refine ⟨h2', fun m hm2 hms hdvd => ?_⟩
  have hmm : m * m ≤ n := by
    have := (Nat.le_sqrt.mp hms)
    nlinarith [Nat.sqrt_le' n]
  have hm102 : m < 103 := by nlinarith
  have hmem : m ∈ List.range' 2 101 := by
    rw [List.mem_range'_1]
    omega
  have := hall m hmem
  rw [Bool.or_eq_true] at this
  rcases this with h' | h'
  · simp at h'; omega
  · simp at h'
    exact h' (Nat.dvd_iff_mod_eq_zero.mp hdvd)

lemma compB_correct {n : ℕ} (h : compB n = true) : ¬n.Prime := by
  rw [compB, List.any_eq_true] at h
  obtain ⟨d, hdmem, hd⟩ := h
  rw [Bool.and_eq_true] at hd
  have hdn : d < n := by simpa using hd.1
  have hmod : n % d = 0 := by simpa using hd.2
  have hd2 : 2 ≤ d := (List.mem_range'_1.mp hdmem).1
  intro hp
  rcases (Nat.Prime.eq_one_or_self_of_dvd hp d (Nat.dvd_iff_mod_eq_zero.mpr hmod)) with h1 | h1 <;> omega

def checkW : ℕ × ℕ × ℕ × ℕ × ℕ → Bool
  | (n, p, p', q, q') =>
    primeB p && primeB p' && primeB q && primeB q' &&
    decide (p ≤ q) && decide (p < n) && decide (q < n) &&
    decide (p < p') && decide (q < q') &&
    decide (p' ≤ 10608) && decide (q' ≤ 10608) &&
    (List.range' (p + 1) (p' - p - 1)).all compB &&
    (List.range' (q + 1) (q' - q - 1)).all compB &&
    decide (p + p' + (q + q') = 2 * n)

lemma checkW_correct {n p p' q q' : ℕ} (h : checkW (n, p, p', q, q') = true) :
    0 < a n := by
  rw [checkW] at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hp, hp'⟩, hq⟩, hq'⟩, hpq⟩, hpn⟩, hqn⟩, hpp'⟩, hqq'⟩, hp's⟩, hq's⟩, hgp⟩, hgq⟩, hsum⟩ := h
  have hPp : p.Prime := primeB_correct (by omega) hp
  have hPp' : p'.Prime := primeB_correct (by omega) hp'
  have hPq : q.Prime := primeB_correct (by omega) hq
  have hPq' : q'.Prime := primeB_correct (by omega) hq'
  have hnp : next_prime p = p' := by
    refine next_prime_eq hPp' hpp' fun k hk1 hk2 => ?_
    exact compB_correct (hgp k (List.mem_range'_1.mpr ⟨by omega, by omega⟩))
  have hnq : next_prime q = q' := by
    refine next_prime_eq hPq' hqq' fun k hk1 hk2 => ?_
    exact compB_correct (hgq k (List.mem_range'_1.mpr ⟨by omega, by omega⟩))
  refine a_pos_of_witness hPp hPq hpq hpn hqn ?_
  rw [S_sum, S_sum, hnp, hnq]
  omega

/-- Driver: a verified chunk of witnesses covering `[s, s + l.length)` gives positivity there. -/
lemma chunk_covers : ∀ (l : List (ℕ × ℕ × ℕ × ℕ × ℕ)) (s : ℕ),
    l.all checkW = true →
    l.map (fun e => e.1) = List.range' s l.length →
    ∀ n, s ≤ n → n < s + l.length → 0 < a n := by
  intro l
  induction l with
  | nil => intro s _ _ n h1 h2; simp at h2; omega
  | cons e tl ih =>
    intro s hall hmap n h1 h2
    rw [List.all_cons, Bool.and_eq_true] at hall
    rw [List.length_cons, List.range'_succ, List.map_cons] at hmap
    injection hmap with hfst hmap'
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · obtain ⟨m, p, p', q, q'⟩ := e
      simp only at hfst
      rw [hfst] at hall
      exact checkW_correct hall.1
    · exact ih (s + 1) hall.2 hmap' n hlt (by simp [List.length_cons] at h2; omega)



/-- `next_prime` is monotone-compatible: if `v` cannot be written as `q + next_prime q`
for the largest prime `q0` below `v / 2`, it cannot be so written at all. -/
lemma not_in_T {v q0 : ℕ} (h0 : q0.Prime) (h2q : 2 * q0 < v) (hle : v ≤ 2 * next_prime q0)
    (hne : q0 + next_prime q0 ≠ v) : ∀ q : ℕ, q.Prime → q + next_prime q ≠ v := by
  intro q hq heq
  have hs0 := next_prime_spec q0
  have hsq := next_prime_spec q
  rcases lt_trichotomy q q0 with h | h | h
  · have : next_prime q ≤ q0 := Nat.sInf_le ⟨h0, h⟩
    omega
  · subst h; omega
  · have : next_prime q0 ≤ q := Nat.sInf_le ⟨hq, h⟩
    omega

/-- Certificate check for the sharpness proof `a 473 = 0`: entry `(p, p', q0, q1)`
witnesses that `946 - (p + p')` is not a sum of two consecutive primes. -/
def checkZ : ℕ × ℕ × ℕ × ℕ → Bool
  | (p, p', q0, q1) =>
    primeB p && primeB p' && primeB q0 && primeB q1 &&
    decide (p < p') && decide (q0 < q1) &&
    decide (p' ≤ 10608) && decide (q1 ≤ 10608) &&
    (List.range' (p + 1) (p' - p - 1)).all compB &&
    (List.range' (q0 + 1) (q1 - q0 - 1)).all compB &&
    decide (p + p' ≤ 941) &&
    decide (2 * q0 < 946 - (p + p')) && decide (946 - (p + p') ≤ 2 * q1) &&
    decide (q0 + q1 ≠ 946 - (p + p'))

lemma checkZ_correct {p p' q0 q1 : ℕ} (h : checkZ (p, p', q0, q1) = true) :
    ∀ q : ℕ, q.Prime → S_sum p + S_sum q ≠ 946 := by
  rw [checkZ] at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hp, hp'⟩, hq0⟩, hq1⟩, hpp'⟩, hq01⟩, hp's⟩, hq1s⟩, hgp⟩, hgq⟩, hb⟩, h2q⟩, hle⟩, hne⟩ := h
  have hPp : p.Prime := primeB_correct (by omega) hp
  have hPp' : p'.Prime := primeB_correct (by omega) hp'
  have hPq0 : q0.Prime := primeB_correct (by omega) hq0
  have hPq1 : q1.Prime := primeB_correct (by omega) hq1
  have hnp : next_prime p = p' := by
    refine next_prime_eq hPp' hpp' fun k hk1 hk2 => ?_
    exact compB_correct (hgp k (List.mem_range'_1.mpr ⟨by omega, by omega⟩))
  have hnq0 : next_prime q0 = q1 := by
    refine next_prime_eq hPq1 hq01 fun k hk1 hk2 => ?_
    exact compB_correct (hgq k (List.mem_range'_1.mpr ⟨by omega, by omega⟩))
  intro q hq heq
  have hnT := not_in_T hPq0 h2q (by omega) (by omega) q hq
  rw [S_sum, S_sum, hnp] at heq
  have hsq := next_prime_spec q
  omega

