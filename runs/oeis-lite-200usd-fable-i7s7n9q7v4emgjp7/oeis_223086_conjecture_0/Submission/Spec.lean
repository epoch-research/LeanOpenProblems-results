import FormalConjectures.Util.ProblemImports

open Nat

/--
A223086: Trajectory of 64 under the map $n \to A006368(n)$.
The map is $f(n)$:
$$f(n) = \begin{cases} 3n/2 & \text{if } n \equiv 0 \pmod 2 \\ (3n+1)/4 & \text{if } n \equiv 1 \pmod 4 \\ (3n-1)/4 & \text{if } n \equiv 3 \pmod 4 \end{cases}$$
-/
def A006368_map (k : ℕ) : ℕ :=
  if k % 2 = 0 then
    (3 * k) / 2
  else if k % 4 = 1 then
    (3 * k + 1) / 4
  else -- k % 4 = 3
    (3 * k - 1) / 4

/--
A223086: Trajectory of 64 under the map $n \to A006368(n)$.
The sequence $a(n)$ is 1-indexed by $a(1)=64$ and recurrence $a(n+1) = f(a(n))$.
The $n$-th term is $f^{n-1}(64)$.
-/
def a (n : ℕ) : ℕ :=
  Nat.iterate A006368_map (n - 1) 64

/--
The inverse map, OEIS A006369: `g(3n) = 2n`, `g(3n+1) = 4n+1`, `g(3n+2) = 4n+3`.
(`A006368_map` has the equivalent description `f(2n) = 3n`, `f(4n±1) = 3n±1`.)
-/
def A006369_map (n : ℕ) : ℕ :=
  if n % 3 = 0 then 2 * n / 3
  else if n % 3 = 1 then (4 * n - 1) / 3
  else (4 * n + 1) / 3

theorem A006369_left_inverse : Function.LeftInverse A006369_map A006368_map := by
  intro n
  unfold A006368_map A006369_map
  split_ifs <;> omega

theorem A006369_right_inverse : Function.RightInverse A006369_map A006368_map := by
  intro n
  unfold A006368_map A006369_map
  split_ifs <;> omega

/-- The map `A006368_map` is a permutation of ℕ (Collatz's original permutation). -/
theorem A006368_map_bijective : Function.Bijective A006368_map :=
  ⟨A006369_left_inverse.injective, A006369_right_inverse.surjective⟩

theorem A006368_map_injective : Function.Injective A006368_map :=
  A006368_map_bijective.injective

/-- The conjecture is *equivalent* to the non-periodicity of 64. -/
theorem conjecture_iff_no_cycle :
    (∀ (i j : ℕ), 0 < i → 0 < j → a i = a j → i = j) ↔
      (∀ p : ℕ, 0 < p → A006368_map^[p] 64 ≠ 64) := by
  constructor
  · intro H p hp hcyc
    have h1 : a 1 = a (p + 1) := by
      unfold a
      simp only [Nat.add_sub_cancel, Function.iterate_zero_apply, Nat.sub_self]
      exact hcyc.symm
    have := H 1 (p+1) one_pos (by omega) h1
    omega
  · intro K i j hi hj h
    by_contra hne
    rcases Nat.lt_or_ge i j with hlt | hge
    · have hd : (i - 1) + (j - i) = j - 1 := by omega
      unfold a at h
      rw [← hd, Function.iterate_add_apply] at h
      exact K (j - i) (by omega) ((A006368_map_injective.iterate (i-1)) h.symm)
    · have hlt : j < i := by omega
      have hd : (j - 1) + (i - j) = i - 1 := by omega
      unfold a at h
      rw [← hd, Function.iterate_add_apply] at h
      exact K (i - j) (by omega) ((A006368_map_injective.iterate (j-1)) h)

/-- Non-periodicity is equivalent to unboundedness of the trajectory (pigeonhole). -/
theorem no_cycle_iff_unbounded :
    (∀ p : ℕ, 0 < p → A006368_map^[p] 64 ≠ 64) ↔ (∀ B : ℕ, ∃ n : ℕ, B < A006368_map^[n] 64) := by
  constructor
  · intro K B
    by_contra hb
    push_neg at hb
    -- all iterates ≤ B: infinitely many n map into a finite set, so two iterates coincide
    have : ∃ m n : ℕ, m ≠ n ∧ A006368_map^[m] 64 = A006368_map^[n] 64 := by
      obtain ⟨m, n, hne, heq⟩ := Finite.exists_ne_map_eq_of_infinite
        (fun n : ℕ => (⟨A006368_map^[n] 64, Nat.lt_succ_of_le (hb n)⟩ : Fin (B+1)))
      exact ⟨m, n, hne, by simpa using congrArg Fin.val heq⟩
    obtain ⟨m, n, hmn, heq⟩ := this
    rcases Nat.lt_or_ge m n with hlt | hge
    · have hd : m + (n - m) = n := by omega
      rw [← hd, Function.iterate_add_apply] at heq
      exact K (n - m) (by omega) ((A006368_map_injective.iterate m) heq.symm)
    · have hlt : n < m := by omega
      have hd : n + (m - n) = m := by omega
      rw [← hd, Function.iterate_add_apply] at heq
      exact K (m - n) (by omega) ((A006368_map_injective.iterate n) heq)
  · intro U p hp hcyc
    -- if periodic with period p, all iterates lie among the first p values, hence bounded
    have hfix : ∀ d : ℕ, A006368_map^[p * d] 64 = 64 := by
      intro d
      induction d with
      | zero => simp
      | succ d ih => rw [Nat.mul_succ, Function.iterate_add_apply, hcyc, ih]
    have hper : ∀ k : ℕ, A006368_map^[k] 64 = A006368_map^[k % p] 64 := by
      intro k
      conv_lhs => rw [← Nat.mod_add_div k p]
      rw [Function.iterate_add_apply, hfix]
    set B := (Finset.range p).sup (fun r => A006368_map^[r] 64) with hB
    obtain ⟨n, hn⟩ := U B
    have : A006368_map^[n] 64 ≤ B := by
      rw [hper n]
      exact Finset.le_sup (f := fun r => A006368_map^[r] 64)
        (Finset.mem_range.mpr (Nat.mod_lt n hp))
    omega

