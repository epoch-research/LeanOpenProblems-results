  · simp only [add_re, one_re, one_im]
    rw [cast_zmod_add p hp]
    have h_one : (1 : ZMod N).val = 1 := rfl
    rw [h_one]
    push_cast
    rfl
  · simp only [add_re, one_re, one_im, add_im, zero_add]

