def val_W2_0_im : Nat := ((((((((( *  + ) *  + ) *  + ) *  + ) *  + ) *  + ) *  + ) *  + ) *  + )

def val_W2_0 : LucasRing N 5 := ⟨mkZMod val_W2_0_re, mkZMod val_W2_0_im⟩

