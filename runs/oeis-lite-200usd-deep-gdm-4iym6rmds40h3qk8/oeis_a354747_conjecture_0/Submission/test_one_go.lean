import FormalConjectures.Util.ProblemImports

set_option exponentiation.threshold 100000
set_option maxRecDepth 1000000

abbrev N : ℕ := 

structure FastLucas where
  re : ℕ
  im : ℕ
deriving DecidableEq

def fast_mul (x y : FastLucas) : FastLucas :=
  ⟨(x.re * y.re + 5 * x.im * y.im) % N, (x.re * y.im + x.im * y.re) % N⟩

def fast_pow_chunk_loop : ℕ → FastLucas → FastLucas → ℕ → FastLucas
  | 0, _, res, _ => res
  | fuel + 1, base, res, p =>
    if p = 0 then res
    else
      let next_res := if p % 2 == 1 then fast_mul res base else res
      fast_pow_chunk_loop fuel (fast_mul base base) next_res (p / 2)

def alpha_re : ℕ := 
def alpha_im : ℕ := 
def alpha : FastLucas := ⟨alpha_re, alpha_im⟩

theorem test_fast : fast_pow_chunk_loop 70000 alpha ⟨1, 0⟩ (N + 1) = ⟨1, 0⟩ := by
  decide
