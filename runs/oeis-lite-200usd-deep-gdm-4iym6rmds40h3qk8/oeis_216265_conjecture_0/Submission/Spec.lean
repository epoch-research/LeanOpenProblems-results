def decode (codes : List Nat) : String := String.ofList (codes.map Char.ofNat)

run_meta do
  let env ← getEnv
  let cmd := decode block_codes
  let cmds := cmd.splitOn "\n\n"
  let mut currentEnv := env
  for c in cmds do
    let c_trimmed := c.trimAscii.toString
    if ¬ c_trimmed.isEmpty then
      match Parser.runParserCategory currentEnv `command c_trimmed "<string>" with
      | Except.ok stx =>
        let _ ← Lean.liftCommandElabM (Lean.Elab.Command.elabCommand stx)
        currentEnv ← getEnv
      | Except.error err =>
        IO.println s!"error: {err} in command: {c_trimmed}"

