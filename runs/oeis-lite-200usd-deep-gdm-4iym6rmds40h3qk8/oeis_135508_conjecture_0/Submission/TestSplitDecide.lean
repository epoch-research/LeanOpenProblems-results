import Mathlib.Data.Nat.Prime.Defs
import Mathlib.Data.Nat.GCD.Basic
open Nat

def x_seq_loop : ℕ → ℕ → ℕ → ℕ
| 0, _, x => x
| n + 1, i, x => x_seq_loop n (i + 1) (2 * x + Nat.lcm x i)

lemma x_seq_loop_add (a b i x : ℕ) :
    x_seq_loop (a + b) i x = x_seq_loop b (i + a) (x_seq_loop a i x) := by
  induction a generalizing i x with
  | zero => simp [x_seq_loop]
  | succ a ih =>
    have h1 : a + 1 + b = (a + b) + 1 := by omega
    have h2 : i + (a + 1) = i + 1 + a := by omega
    rw [h1]
    simp [x_seq_loop]
    rw [h2]
    exact ih (i + 1) (2 * x + Nat.lcm x i)

lemma h_val1 : x_seq_loop 500 2 1 =  := by decide
lemma h_val2 : x_seq_loop 500 502  =  := by decide
lemma h_val3 : x_seq_loop 500 1002  =  := by decide
lemma h_val4 : x_seq_loop 500 1502  =  := by decide
lemma h_val5 : x_seq_loop 459 2002  =  := by decide

lemma q107_split : x_seq_loop 2459 2 1 =  := by
  have h_step1 (X : ℕ) : x_seq_loop 2459 2 X = x_seq_loop 1959 502 (x_seq_loop 500 2 X) := by
    have : 2459 = 500 + 1959 := by rfl
    rw [this, x_seq_loop_add]
  have h_step2 (X : ℕ) : x_seq_loop 1959 502 X = x_seq_loop 1459 1002 (x_seq_loop 500 502 X) := by
    have : 1959 = 500 + 1459 := by rfl
    rw [this, x_seq_loop_add]
  have h_step3 (X : ℕ) : x_seq_loop 1459 1002 X = x_seq_loop 959 1502 (x_seq_loop 500 1002 X) := by
    have : 1459 = 500 + 959 := by rfl
    rw [this, x_seq_loop_add]
  have h_step4 (X : ℕ) : x_seq_loop 959 1502 X = x_seq_loop 459 2002 (x_seq_loop 500 1502 X) := by
    have : 959 = 500 + 459 := by rfl
    rw [this, x_seq_loop_add]
  -- Now we rewrite using the h_val lemmas
  have h_eq : x_seq_loop 2459 2 1 = x_seq_loop 459 2002 (x_seq_loop 500 1502 (x_seq_loop 500 1002 (x_seq_loop 500 502 (x_seq_loop 500 2 1)))) := by
    rw [h_step1, h_step2, h_step3, h_step4]
  rw [h_eq]
  rw [h_val1, h_val2, h_val3, h_val4, h_val5]

lemma q107_div : 107 ∣ x_seq_loop 2459 2 1 := by
  rw [q107_split]
  decide