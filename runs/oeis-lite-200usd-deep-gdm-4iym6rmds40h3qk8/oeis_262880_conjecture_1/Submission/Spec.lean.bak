def get_witness (n : ℕ) (p : ℕ × ℕ) : ℕ × ℕ × ℕ × ℕ :=
  if p = (1, 2) then get_witness_1_2 n
    else if p = (1, 3) then get_witness_1_3 n
    else if p = (1, 4) then get_witness_1_4 n
    else if p = (1, 6) then get_witness_1_6 n
    else if p = (2, 2) then get_witness_2_2 n
    else if p = (2, 3) then get_witness_2_3 n
    else if p = (2, 4) then get_witness_2_4 n
    else if p = (2, 5) then get_witness_2_5 n
    else if p = (2, 6) then get_witness_2_6 n
    else if p = (2, 7) then get_witness_2_7 n
    else if p = (2, 20) then get_witness_2_20 n
    else if p = (2, 21) then get_witness_2_21 n
    else if p = (2, 34) then get_witness_2_34 n
    else if p = (3, 3) then get_witness_3_3 n
    else if p = (3, 4) then get_witness_3_4 n
    else if p = (3, 5) then get_witness_3_5 n
    else if p = (3, 6) then get_witness_3_6 n
    else if p = (4, 10) then get_witness_4_10 n
  else (1, 0, 0, 0)

theorem oeis_262880_conjecture_1 :
  ∀ n : ℕ, 0 < n →
    ∀ p : ℕ × ℕ, p ∈ A262880_Conjecture1_Pairs →
      ∃ w x y z : ℕ, w > 0 ∧ n = triangle_number w + x^3 + p.fst * y^3 + p.snd * z^3 := by
  intro n hn p hp
  rcases le_or_gt n 99 with h | h
  · -- n ≤ 99
    have h_in : n ∈ (range 100).filter (fun x => 0 < x) := by
      simp only [mem_filter, mem_range]
      omega
    have h_bounded : ∀ n ∈ (range 100).filter (fun x => 0 < x), ∀ p ∈ A262880_Conjecture1_Pairs,
        let wxyz := get_witness n p
        wxyz.1 > 0 ∧ n = triangle_number wxyz.1 + wxyz.2.1^3 + p.fst * wxyz.2.2.1^3 + p.snd * wxyz.2.2.2^3 := by
      decide
    rcases h_bounded n h_in p hp with ⟨hw0, heq⟩
    let wxyz := get_witness n p
    use wxyz.1, wxyz.2.1, wxyz.2.2.1, wxyz.2.2.2
  · -- n > 99
    use 1, 0, 0, 0
    sorry

def A262880_Conjecture2_Pairs : Finset (ℕ × ℕ) :=
  (List.toFinset (
  [ (3, 4), (3, 6), (4, 8) ]
  ))
