/--
A347865: Number of ways to write $n$ as $w^2 + 2x^2 + y^4 + 3z^4$, where $w,x,y,z$ are nonnegative integers.
-/
def a (n : ℕ) : ℕ :=
  let is_perfect_square (m : ℕ) : Bool := (Nat.sqrt m) ^ 2 = m
  let max_sq_term_root := Nat.sqrt n + 1
  let max_quad_term_root := Nat.sqrt (Nat.sqrt n) + 1
  ∑ z ∈ range (max_quad_term_root),
    ∑ y ∈ range (max_quad_term_root),
      ∑ x ∈ range (max_sq_term_root),
        let rest : ℕ := 2 * x^2 + y^4 + 3 * z^4
        if rest ≤ n ∧ is_perfect_square (n - rest) then 1 else 0

lemma a_pos_of_exists (n x y z : ℕ)
    (hz : z < Nat.sqrt (Nat.sqrt n) + 1)
    (hy : y < Nat.sqrt (Nat.sqrt n) + 1)
    (hx : x < Nat.sqrt n + 1)
    (hrest : 2 * x^2 + y^4 + 3 * z^4 ≤ n)
    (hsq : (Nat.sqrt (n - (2 * x^2 + y^4 + 3 * z^4)))^2 = n - (2 * x^2 + y^4 + 3 * z^4)) :
    a n > 0 := by
  unfold a
  dsimp only
  have hz_mem : z ∈ range (Nat.sqrt (Nat.sqrt n) + 1) := mem_range.mpr hz
  have h_sum1_nonneg : ∀ z', (0 : ℕ) ≤ ∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1),
    let rest : ℕ := 2 * x^2 + y^4 + 3 * z'^4
    if rest ≤ n ∧ decide ((Nat.sqrt (n - rest)) ^ 2 = n - rest) = true then 1 else 0 := by
    intro z'
    apply sum_nonneg
    intro y' _
    apply sum_nonneg
    intro x' _
    dsimp only
    split_ifs <;> decide
  have h1 := single_le_sum (f := fun z' => ∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1),
    let rest : ℕ := 2 * x^2 + y^4 + 3 * z'^4
    if rest ≤ n ∧ decide ((Nat.sqrt (n - rest)) ^ 2 = n - rest) = true then 1 else 0) (fun z' _ => h_sum1_nonneg z') hz_mem
  have hy_mem : y ∈ range (Nat.sqrt (Nat.sqrt n) + 1) := mem_range.mpr hy
  have h_sum2_nonneg : ∀ y', (0 : ℕ) ≤ ∑ x ∈ range (Nat.sqrt n + 1),
    let rest : ℕ := 2 * x^2 + y'^4 + 3 * z^4
    if rest ≤ n ∧ decide ((Nat.sqrt (n - rest)) ^ 2 = n - rest) = true then 1 else 0 := by
    intro y'
    apply sum_nonneg
    intro x' _
    dsimp only
    split_ifs <;> decide
  have h2 := single_le_sum (f := fun y' => ∑ x ∈ range (Nat.sqrt n + 1),
    let rest : ℕ := 2 * x^2 + y'^4 + 3 * z^4
    if rest ≤ n ∧ decide ((Nat.sqrt (n - rest)) ^ 2 = n - rest) = true then 1 else 0) (fun y' _ => h_sum2_nonneg y') hy_mem
  have hx_mem : x ∈ range (Nat.sqrt n + 1) := mem_range.mpr hx
  have h3 := single_le_sum (f := fun x' =>
    let rest : ℕ := 2 * x'^2 + y^4 + 3 * z^4
    if rest ≤ n ∧ decide ((Nat.sqrt (n - rest)) ^ 2 = n - rest) = true then 1 else 0) (fun (x' : ℕ) _ => Nat.zero_le _) hx_mem
  have h4 : 0 < let rest : ℕ := 2 * x^2 + y^4 + 3 * z^4;
    if rest ≤ n ∧ decide ((Nat.sqrt (n - rest)) ^ 2 = n - rest) = true then 1 else 0 := by
    dsimp only
    have h_cond : (2 * x^2 + y^4 + 3 * z^4 ≤ n ∧ decide ((Nat.sqrt (n - (2 * x^2 + y^4 + 3 * z^4))) ^ 2 = n - (2 * x^2 + y^4 + 3 * z^4)) = true) := by
      refine ⟨hrest, ?_⟩
      rw [decide_eq_true_iff]
      exact hsq
    rw [if_pos h_cond]
    decide
  exact lt_of_lt_of_le h4 (le_trans h3 (le_trans h2 h1))

theorem a_744_eq_zero : a 744 = 0 := by
  decide

