lemma check_witness_true (n : ℕ) (hn : n < 1001) (h : check_witness n = true) :
    let w1 := wit1 n
    let p1 := w1.1
    let w2 := wit2 n
    let p2 := w2.1
    (p1.1 ≤ p1.2 ∧ p1.1^2 + p1.2^2 ≤ n ∧ (Nat.Prime (p1.1 + 1) ∨ Nat.Prime (p1.2 + 1)) ∧ is_generalized_pentagonal (n - (p1.1^2 + p1.2^2)) ∧ p1.1 ≤ Nat.sqrt n ∧ p1.2 ≤ Nat.sqrt n) ∧
    (¬ (n = 1 ∨ n = 49 ∨ n = 608) →
      (p2.1 ≤ p2.2 ∧ p2.1^2 + p2.2^2 ≤ n ∧ (Nat.Prime (p2.1 + 1) ∨ Nat.Prime (p2.2 + 1)) ∧ is_generalized_pentagonal (n - (p2.1^2 + p2.2^2)) ∧ p2.1 ≤ Nat.sqrt n ∧ p2.2 ≤ Nat.sqrt n) ∧
      p1 ≠ p2) := by
  unfold check_witness at h
  by_cases h_special : n = 1 ∨ n = 49 ∨ n = 608
  · have h_or_eq : (n = 1 || n = 49 || n = 608) = true := by
      rcases h_special with rfl | rfl | rfl <;> decide
    rw [h_or_eq, if_pos rfl] at h
    simp only [decide_eq_true_iff, Bool.and_eq_true] at h
    have h_lt1 := lt_33_of_sq_le hn h.2.1
    have h_lt2 := lt_33_of_sq_le hn h.2.2
    have h_prime := prime_or_of_is_prime_32_or h_lt1 h_lt2 h.1.1.2
    have h_pent := is_perfect_square_of_sq_eq h.1.2
    have h_sq1 := le_sqrt_of_sq_le h.2.1
    have h_sq2 := le_sqrt_of_sq_le h.2.2
    refine ⟨⟨h.1.1.1.1, h.1.1.1.2, h_prime, h_pent, h_sq1, h_sq2⟩, fun hn_not => False.elim (hn_not h_special)⟩
  · have h_or_eq : (n = 1 || n = 49 || n = 608) = false := by
      push_neg at h_special
      have h1 : decide (n = 1) = false := decide_eq_false h_special.1
      have h2 : decide (n = 49) = false := decide_eq_false h_special.2.1
      have h3 : decide (n = 608) = false := decide_eq_false h_special.2.2
      rw [h1, h2, h3]
      rfl
    rw [h_or_eq, if_neg (by decide)] at h
    simp only [decide_eq_true_iff, Bool.and_eq_true] at h
    have h1 := h.1.1
    have h2 := h.1.2
    have h3 := h.2
    have h1_lt1 := lt_33_of_sq_le hn h1.2.1
    have h1_lt2 := lt_33_of_sq_le hn h1.2.2
    have h1_prime := prime_or_of_is_prime_32_or h1_lt1 h1_lt2 h1.1.1.2
    have h1_pent := is_perfect_square_of_sq_eq h1.1.2
    have h1_sq1 := le_sqrt_of_sq_le h1.2.1
    have h1_sq2 := le_sqrt_of_sq_le h1.2.2

    have h2_lt1 := lt_33_of_sq_le hn h2.2.1
    have h2_lt2 := lt_33_of_sq_le hn h2.2.2
    have h2_prime := prime_or_of_is_prime_32_or h2_lt1 h2_lt2 h2.1.1.2
    have h2_pent := is_perfect_square_of_sq_eq h2.1.2
    have h2_sq1 := le_sqrt_of_sq_le h2.2.1
    have h2_sq2 := le_sqrt_of_sq_le h2.2.2
    refine ⟨⟨h1.1.1.1.1, h1.1.1.1.2, h1_prime, h1_pent, h1_sq1, h1_sq2⟩, fun _ => ⟨⟨h2.1.1.1.1, h2.1.1.1.2, h2_prime, h2_pent, h2_sq1, h2_sq2⟩, h3⟩⟩



lemma length_pos_of_mem' {α : Type*} {p : α} {L : List α} (h : p ∈ L) : L.length > 0 := by
  cases L with
  | nil => contradiction
  | cons x xs => simp

lemma list_length_ge_two_of_two_distinct_mem {α : Type*} [DecidableEq α] {l : List α} {a b : α}
    (ha : a ∈ l) (hb : b ∈ l) (hne : a ≠ b) : l.length ≥ 2 := by
  induction l with
  | nil =>
    contradiction
  | cons x xs ih =>
    cases ha
    · cases hb
      · contradiction
      · have h_len : xs.length ≥ 1 := by
          cases xs with
          | nil => contradiction
          | cons y ys => simp
        simp; omega
    · cases hb
      · have h_len : xs.length ≥ 1 := by
          cases xs with
          | nil => contradiction
          | cons y ys => simp
        simp; omega
      · have ih_res := ih (by assumption) (by assumption)
        simp; omega

lemma mem_L {n : ℕ} {x y : ℕ} (hx : x ≤ Nat.sqrt n) (hy : y ≤ Nat.sqrt n) :
    (x, y) ∈ (List.range (Nat.sqrt n + 1)).flatMap fun x => (List.range (Nat.sqrt n + 1)).map fun y => (x, y) := by
  rw [List.mem_flatMap]
  exists x
  constructor
  · rw [List.mem_range]
    omega
  · rw [List.mem_map]
    exists y
    constructor
    · rw [List.mem_range]
      omega
    · rfl

lemma A270966_pos_1_1001 (n : ℕ) (h1 : 1 ≤ n) (h2 : n < 1001) : A270966 n > 0 := by
  have h_wit := check_witness_all n h1 h2
  have h_spec := check_witness_true n h2 h_wit
  have h_wit1 := h_spec.1
  unfold A270966 real_A270966
  have h_n0 : ¬ n = 0 := by omega
  have h_n1000 : ¬ n > 1000 := by omega
  simp only [if_neg h_n0, if_neg h_n1000]
  have h_mem := mem_L h_wit1.2.2.2.2.1 h_wit1.2.2.2.2.2
  have h_filt : (wit1 n).1 ∈ (List.filter (fun p =>
      p.1 ≤ p.2 ∧ p.1^2 + p.2^2 ≤ n ∧
      (Nat.Prime (p.1 + 1) ∨ Nat.Prime (p.2 + 1)) ∧
      is_generalized_pentagonal (n - (p.1^2 + p.2^2))
    ) ((List.range (Nat.sqrt n + 1)).flatMap fun x => (List.range (Nat.sqrt n + 1)).map fun y => (x, y))) := by
    rw [List.mem_filter]
    exact And.intro h_mem (decide_eq_true (And.intro h_wit1.1 (And.intro h_wit1.2.1 (And.intro h_wit1.2.2.1 h_wit1.2.2.2.1))))
  exact length_pos_of_mem' h_filt

lemma A270966_eq_one_1_1001 (n : ℕ) (h1 : 1 ≤ n) (h2 : n < 1001) :
    A270966 n = 1 ↔ n = 1 ∨ n = 49 ∨ n = 608 := by
  constructor
  · intro h
    by_cases hn1 : n = 1
    · exact Or.inl hn1
    · by_cases hn49 : n = 49
      · exact Or.inr (Or.inl hn49)
      · by_cases hn608 : n = 608
        · exact Or.inr (Or.inr hn608)
        · have h_not_special : ¬ (n = 1 ∨ n = 49 ∨ n = 608) := by
            push_neg
            exact ⟨hn1, hn49, hn608⟩
          have h_wit := check_witness_all n h1 h2
          have h_spec := check_witness_true n h2 h_wit
          have h_wit2 := (h_spec.2 h_not_special).1
          have h_dist := (h_spec.2 h_not_special).2
          have h_mem1 := mem_L h_spec.1.2.2.2.2.1 h_spec.1.2.2.2.2.2
          have h_mem2 := mem_L h_wit2.2.2.2.2.1 h_wit2.2.2.2.2.2
          have h_filt1 : (wit1 n).1 ∈ (List.filter (fun p =>
              p.1 ≤ p.2 ∧ p.1^2 + p.2^2 ≤ n ∧
              (Nat.Prime (p.1 + 1) ∨ Nat.Prime (p.2 + 1)) ∧
              is_generalized_pentagonal (n - (p.1^2 + p.2^2))
            ) ((List.range (Nat.sqrt n + 1)).flatMap fun x => (List.range (Nat.sqrt n + 1)).map fun y => (x, y))) := by
            rw [List.mem_filter]
            exact And.intro h_mem1 (decide_eq_true (And.intro h_spec.1.1 (And.intro h_spec.1.2.1 (And.intro h_spec.1.2.2.1 h_spec.1.2.2.2.1))))
          have h_filt2 : (wit2 n).1 ∈ (List.filter (fun p =>
              p.1 ≤ p.2 ∧ p.1^2 + p.2^2 ≤ n ∧
              (Nat.Prime (p.1 + 1) ∨ Nat.Prime (p.2 + 1)) ∧
              is_generalized_pentagonal (n - (p.1^2 + p.2^2))
            ) ((List.range (Nat.sqrt n + 1)).flatMap fun x => (List.range (Nat.sqrt n + 1)).map fun y => (x, y))) := by
            rw [List.mem_filter]
            exact And.intro h_mem2 (decide_eq_true (And.intro h_wit2.1 (And.intro h_wit2.2.1 (And.intro h_wit2.2.2.1 h_wit2.2.2.2.1))))
          have h_ge_two := list_length_ge_two_of_two_distinct_mem h_filt1 h_filt2 h_dist
          unfold A270966 real_A270966 at h
          have h_n0 : ¬ n = 0 := by omega
          have h_n1000 : ¬ n > 1000 := by omega
          simp only [if_neg h_n0, if_neg h_n1000] at h
          omega
  · rintro (rfl | rfl | rfl)
    · rw [A270966_eq_fast]
      decide
    · rw [A270966_eq_fast]
      decide
    · rw [A270966_eq_fast]
      decide


lemma A270966_bounded_pos : ∀ n < 1001, n > 0 → A270966 n > 0 := by
  intro n hn hn0
  have h1 : 1 ≤ n := by omega
  exact A270966_pos_1_1001 n h1 hn

lemma A270966_bounded_eq_one : ∀ n < 1001, A270966 n = 1 ↔ n = 1 ∨ n = 49 ∨ n = 608 := by
  intro n hn
  by_cases hn0 : n = 0
  · subst hn0
    constructor
    · intro h; unfold A270966 at h; contradiction
    · rintro (h | h | h) <;> contradiction
  · have h1 : 1 ≤ n := by omega
    exact A270966_eq_one_1_1001 n h1 hn

