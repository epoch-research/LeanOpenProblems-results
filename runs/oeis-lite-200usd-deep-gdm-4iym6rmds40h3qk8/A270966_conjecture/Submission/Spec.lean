lemma is_perfect_square_of_sq_eq {m s : ℕ} (h : s * s = m) : (Nat.sqrt m) ^ 2 = m := by
  have h2 : m = s ^ 2 := by
    rw [Nat.pow_two]
    exact h.symm
  rw [h2, Nat.sqrt_eq']

lemma lt_33_of_sq_le {n x : ℕ} (hn : n < 1001) (hx : x * x ≤ n) : x + 1 < 33 := by
  have h_lt : x * x < 32 * 32 := by omega
  have h_x_lt : x < 32 := by
    by_contra hc
    have : x ≥ 32 := by omega
    have : x * x ≥ 32 * 32 := Nat.mul_self_le_mul_self this
    omega
  omega

lemma le_sqrt_of_sq_le {n x : ℕ} (h : x * x ≤ n) : x ≤ Nat.sqrt n := by
  rwa [Nat.le_sqrt]

def check_witness (n : ℕ) : Bool :=
  let w1 := wit1 n
  let p1 := w1.1
  let s1 := w1.2
  let w2 := wit2 n
  let p2 := w2.1
  let s2 := w2.2
  
  let p1_x_le_y := p1.1 ≤ p1.2
  let p1_sum_sq_le_n := p1.1^2 + p1.2^2 ≤ n
  let p1_prime := is_prime_32 (p1.1 + 1) || is_prime_32 (p1.2 + 1)
  let p1_pent := decide (s1 * s1 = 24 * (n - (p1.1^2 + p1.2^2)) + 1)
  let p1_in_L := p1.1 * p1.1 ≤ n && p1.2 * p1.2 ≤ n
  let p1_ok := p1_x_le_y && p1_sum_sq_le_n && p1_prime && p1_pent && p1_in_L

  if n = 1 || n = 49 || n = 608 then
    p1_ok
  else
    let p2_x_le_y := p2.1 ≤ p2.2
    let p2_sum_sq_le_n := p2.1^2 + p2.2^2 ≤ n
    let p2_prime := is_prime_32 (p2.1 + 1) || is_prime_32 (p2.2 + 1)
    let p2_pent := decide (s2 * s2 = 24 * (n - (p2.1^2 + p2.2^2)) + 1)
    let p2_in_L := p2.1 * p2.1 ≤ n && p2.2 * p2.2 ≤ n
    let p2_ok := p2_x_le_y && p2_sum_sq_le_n && p2_prime && p2_pent && p2_in_L
    let distinct := decide (p1 ≠ p2)
    p1_ok && p2_ok && distinct



def check_witness_range_fuel (a : ℕ) (fuel : ℕ) : Bool :=
  match fuel with
  | 0 => check_witness a
  | fuel + 1 => check_witness (a + fuel + 1) && check_witness_range_fuel a fuel

lemma check_witness_range_fuel_spec (a : ℕ) (fuel : ℕ) (h : check_witness_range_fuel a fuel = true) :
    ∀ i, a ≤ i ∧ i ≤ a + fuel → check_witness i = true := by
  induction fuel with
  | zero =>
    intro i h_bounds
    have : i = a := by omega
    subst this
    unfold check_witness_range_fuel at h
    exact h
  | succ fuel ih =>
    unfold check_witness_range_fuel at h
    simp only [Bool.and_eq_true] at h
    have h_last := h.1
    have h_rec := ih h.2
    intro i h_bounds
    by_cases h_eq : i = a + fuel + 1
    · subst h_eq
      exact h_last
    · have h_lt : i ≤ a + fuel := by omega
      exact h_rec i ⟨h_bounds.1, h_lt⟩


