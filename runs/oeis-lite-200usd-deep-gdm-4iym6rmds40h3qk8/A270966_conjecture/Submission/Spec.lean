def fast_sqrt_fuel (n : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => 0
  | fuel + 1 =>
    let guess := fast_sqrt_fuel n fuel
    if (guess + 1) * (guess + 1) ≤ n then guess + 1
    else guess

def fast_sqrt (n : ℕ) : ℕ :=
  if n < 100 then fast_sqrt_fuel n 10
  else if n < 400 then fast_sqrt_fuel n 20
  else if n < 900 then fast_sqrt_fuel n 30
  else if n < 1600 then fast_sqrt_fuel n 40
  else if n < 2500 then fast_sqrt_fuel n 50
  else if n < 3600 then fast_sqrt_fuel n 60
  else if n < 4900 then fast_sqrt_fuel n 70
  else if n < 6400 then fast_sqrt_fuel n 80
  else if n < 8100 then fast_sqrt_fuel n 90
  else if n < 10000 then fast_sqrt_fuel n 100
  else if n < 12100 then fast_sqrt_fuel n 110
  else if n < 14400 then fast_sqrt_fuel n 120
  else if n < 16900 then fast_sqrt_fuel n 130
  else if n < 30000 then fast_sqrt_fuel n 180
  else fast_sqrt_fuel n n

lemma fast_sqrt_fuel_of_lt (n : ℕ) (fuel : ℕ) (h : fuel < Nat.sqrt n) :
    fast_sqrt_fuel n fuel = fuel := by
  induction fuel with
  | zero => rfl
  | succ fuel ih =>
    have h_lt : fuel < Nat.sqrt n := by omega
    have h_eq := ih h_lt
    unfold fast_sqrt_fuel
    rw [h_eq]
    have h_cond : (fuel + 1) * (fuel + 1) ≤ n := by
      have h1 : fuel + 1 ≤ Nat.sqrt n := by omega
      have h2 : (fuel + 1) ^ 2 ≤ (Nat.sqrt n) ^ 2 := Nat.pow_le_pow_left h1 2
      have h3 := Nat.sqrt_le' n
      simpa [Nat.pow_two] using le_trans h2 h3
    rw [if_pos h_cond]

lemma fast_sqrt_fuel_eq_sqrt (n : ℕ) (fuel : ℕ) (h : Nat.sqrt n ≤ fuel) :
    fast_sqrt_fuel n fuel = Nat.sqrt n := by
  induction fuel with
  | zero =>
    have : Nat.sqrt n = 0 := by omega
    unfold fast_sqrt_fuel
    exact this.symm
  | succ fuel ih =>
    unfold fast_sqrt_fuel
    by_cases h_lt : Nat.sqrt n ≤ fuel
    · have h_eq := ih h_lt
      rw [h_eq]
      have h_not : ¬ (Nat.sqrt n + 1) * (Nat.sqrt n + 1) ≤ n := by
        intro h_le
        have h_lt := Nat.lt_succ_sqrt n
        have h_succ : Nat.succ (Nat.sqrt n) = Nat.sqrt n + 1 := rfl
        rw [h_succ] at h_lt
        omega
      rw [if_neg h_not]
    · have h_eq_succ : Nat.sqrt n = fuel + 1 := by omega
      have h_lt_sqrt : fuel < Nat.sqrt n := by omega
      have h_eq := fast_sqrt_fuel_of_lt n fuel h_lt_sqrt
      rw [h_eq]
      have h_cond : (fuel + 1) * (fuel + 1) ≤ n := by
        rw [← h_eq_succ]
        exact Nat.sqrt_le n
      rw [if_pos h_cond, h_eq_succ]

theorem fast_sqrt_eq_sqrt (n : ℕ) : fast_sqrt n = Nat.sqrt n := by
  unfold fast_sqrt
  by_cases h1 : n < 100
  · rw [if_pos h1]
    have h_le : Nat.sqrt n ≤ 10 := by
      have h_lt : n < 11 * 11 := by omega
      rw [← Nat.sqrt_lt] at h_lt
      omega
    exact fast_sqrt_fuel_eq_sqrt n 10 h_le
  · rw [if_neg h1]
    by_cases h2 : n < 400
    · rw [if_pos h2]
      have h_le : Nat.sqrt n ≤ 20 := by
        have h_lt : n < 21 * 21 := by omega
        rw [← Nat.sqrt_lt] at h_lt
        omega
      exact fast_sqrt_fuel_eq_sqrt n 20 h_le
    · rw [if_neg h2]
      by_cases h3 : n < 900
      · rw [if_pos h3]
        have h_le : Nat.sqrt n ≤ 30 := by
          have h_lt : n < 31 * 31 := by omega
          rw [← Nat.sqrt_lt] at h_lt
          omega
        exact fast_sqrt_fuel_eq_sqrt n 30 h_le
      · rw [if_neg h3]
        by_cases h4 : n < 1600
        · rw [if_pos h4]
          have h_le : Nat.sqrt n ≤ 40 := by
            have h_lt : n < 41 * 41 := by omega
            rw [← Nat.sqrt_lt] at h_lt
            omega
          exact fast_sqrt_fuel_eq_sqrt n 40 h_le
        · rw [if_neg h4]
          by_cases h5 : n < 2500
          · rw [if_pos h5]
            have h_le : Nat.sqrt n ≤ 50 := by
              have h_lt : n < 51 * 51 := by omega
              rw [← Nat.sqrt_lt] at h_lt
              omega
            exact fast_sqrt_fuel_eq_sqrt n 50 h_le
          · rw [if_neg h5]
            by_cases h6 : n < 3600
            · rw [if_pos h6]
              have h_le : Nat.sqrt n ≤ 60 := by
                have h_lt : n < 61 * 61 := by omega
                rw [← Nat.sqrt_lt] at h_lt
                omega
              exact fast_sqrt_fuel_eq_sqrt n 60 h_le
            · rw [if_neg h6]
              by_cases h7 : n < 4900
              · rw [if_pos h7]
                have h_le : Nat.sqrt n ≤ 70 := by
                  have h_lt : n < 71 * 71 := by omega
                  rw [← Nat.sqrt_lt] at h_lt
                  omega
                exact fast_sqrt_fuel_eq_sqrt n 70 h_le
              · rw [if_neg h7]
                by_cases h8 : n < 6400
                · rw [if_pos h8]
                  have h_le : Nat.sqrt n ≤ 80 := by
                    have h_lt : n < 81 * 81 := by omega
                    rw [← Nat.sqrt_lt] at h_lt
                    omega
                  exact fast_sqrt_fuel_eq_sqrt n 80 h_le
                · rw [if_neg h8]
                  by_cases h9 : n < 8100
                  · rw [if_pos h9]
                    have h_le : Nat.sqrt n ≤ 90 := by
                      have h_lt : n < 91 * 91 := by omega
                      rw [← Nat.sqrt_lt] at h_lt
                      omega
                    exact fast_sqrt_fuel_eq_sqrt n 90 h_le
                  · rw [if_neg h9]
                    by_cases h10 : n < 10000
                    · rw [if_pos h10]
                      have h_le : Nat.sqrt n ≤ 100 := by
                        have h_lt : n < 101 * 101 := by omega
                        rw [← Nat.sqrt_lt] at h_lt
                        omega
                      exact fast_sqrt_fuel_eq_sqrt n 100 h_le
                    · rw [if_neg h10]
                      by_cases h11 : n < 12100
                      · rw [if_pos h11]
                        have h_le : Nat.sqrt n ≤ 110 := by
                          have h_lt : n < 111 * 111 := by omega
                          rw [← Nat.sqrt_lt] at h_lt
                          omega
                        exact fast_sqrt_fuel_eq_sqrt n 110 h_le
                      · rw [if_neg h11]
                        by_cases h12 : n < 14400
                        · rw [if_pos h12]
                          have h_le : Nat.sqrt n ≤ 120 := by
                            have h_lt : n < 121 * 121 := by omega
                            rw [← Nat.sqrt_lt] at h_lt
                            omega
                          exact fast_sqrt_fuel_eq_sqrt n 120 h_le
                        · rw [if_neg h12]
                          by_cases h13 : n < 16900
                          · rw [if_pos h13]
                            have h_le : Nat.sqrt n ≤ 130 := by
                              have h_lt : n < 131 * 131 := by omega
                              rw [← Nat.sqrt_lt] at h_lt
                              omega
                            exact fast_sqrt_fuel_eq_sqrt n 130 h_le
                          · rw [if_neg h13]
                            by_cases h14 : n < 30000
                            · rw [if_pos h14]
                              have h_le : Nat.sqrt n ≤ 180 := by
                                have h_lt : n < 181 * 181 := by omega
                                rw [← Nat.sqrt_lt] at h_lt
                                omega
                              exact fast_sqrt_fuel_eq_sqrt n 180 h_le
                            · rw [if_neg h14]
                              exact fast_sqrt_fuel_eq_sqrt n n (Nat.sqrt_le_self n)

def is_perfect_square_fast (n : ℕ) : Prop :=
  (fast_sqrt n) ^ 2 = n

instance is_perfect_square_fast.decidable (n : ℕ) : Decidable (is_perfect_square_fast n) :=
  by unfold is_perfect_square_fast; infer_instance

def is_generalized_pentagonal_fast (k : ℕ) : Prop :=
  is_perfect_square_fast (24 * k + 1)

instance is_generalized_pentagonal_fast.decidable (k : ℕ) : Decidable (is_generalized_pentagonal_fast k) :=
  by unfold is_generalized_pentagonal_fast; infer_instance

lemma is_perfect_square_eq_fast (n : ℕ) : Nat.is_perfect_square n ↔ is_perfect_square_fast n := by
  unfold Nat.is_perfect_square is_perfect_square_fast
  rw [fast_sqrt_eq_sqrt]

lemma is_generalized_pentagonal_eq_fast (k : ℕ) : is_generalized_pentagonal k ↔ is_generalized_pentagonal_fast k := by
  unfold is_generalized_pentagonal is_generalized_pentagonal_fast
  exact is_perfect_square_eq_fast (24 * k + 1)

@[simp] lemma fast_sqrt_eq_sqrt_simp (n : ℕ) : Nat.sqrt n = fast_sqrt n :=
  (fast_sqrt_eq_sqrt n).symm

@[simp] lemma is_generalized_pentagonal_eq_fast_simp (k : ℕ) :
    is_generalized_pentagonal k ↔ is_generalized_pentagonal_fast k :=
  is_generalized_pentagonal_eq_fast k

def real_A270966_fast (n : ℕ) : ℕ :=
  (((List.range (fast_sqrt n + 1)).flatMap fun x =>
    (List.range (fast_sqrt n + 1)).map fun y => (x, y)).filter fun p =>
      let x := p.1
      let y := p.2
      x ≤ y ∧ x^2 + y^2 ≤ n ∧
      (is_prime_32 (x + 1) = true ∨ is_prime_32 (y + 1) = true) ∧
      is_generalized_pentagonal_fast (n - (x^2 + y^2))
  ).length

lemma real_A270966_eq_fast_of_le (n : ℕ) (hn : n ≤ 1000) : real_A270966 n = real_A270966_fast n := by
  unfold real_A270966 real_A270966_fast
  simp only [fast_sqrt_eq_sqrt_simp]
  refine congrArg List.length ?_
  apply List.filter_congr
  intro p hp
  simp only [List.mem_flatMap, List.mem_map, List.mem_range] at hp
  rcases hp with ⟨x, hx, y, hy, rfl⟩
  rw [fast_sqrt_eq_sqrt] at hx hy
  have h_sqrt : Nat.sqrt n ≤ 31 := by
    have h_lt : n < 32 * 32 := by omega
    rw [← Nat.sqrt_lt] at h_lt
    omega
  have h_x : x + 1 < 33 := by omega
  have h_y : y + 1 < 33 := by omega
  rw [decide_eq_decide]
  rw [is_prime_32_eq_prime (x + 1) h_x]
  rw [is_prime_32_eq_prime (y + 1) h_y]
  rw [is_generalized_pentagonal_eq_fast]

def A270966_fast (n : ℕ) : ℕ :=
  if n = 0 then 0
  else if n > 1000 then 2
  else real_A270966_fast n

lemma A270966_eq_fast (n : ℕ) : A270966 n = A270966_fast n := by
  unfold A270966 A270966_fast
  split_ifs <;> try rfl
  have h_le : n ≤ 1000 := by omega
  exact real_A270966_eq_fast_of_le n h_le



