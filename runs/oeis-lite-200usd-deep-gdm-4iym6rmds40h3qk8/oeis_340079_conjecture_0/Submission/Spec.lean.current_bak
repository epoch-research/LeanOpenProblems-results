    ring
have h_LHS_eq : (A_q * k - u * m) * (q * r) + (u * m) * (q * r) = A_q * k * (q * r) := by
  rw [← Nat.add_mul]
  rw [Nat.sub_add_cancel h_le]
have h_W_eq : (A_q * k - u * m) * (q * r) = A_q * (2 * r + 2 * q - 1) - 1 := by
