  have h_k_qr' : k * (q * r) = A * (2 * r - 1) + 1 := by
    calc k * (q * r) = q * r * k := by ring
         _ = 1 + A * (2 * r - 1) := hk.symm
         _ = A * (2 * r - 1) + 1 := by omega
  rw [h_k_qr']
  have h_A_eq : A = A_q * (2 * q - 1) := by
    change (2 * p - 1) * (2 * q - 1) * P_D' = (2 * p - 1) * P_D' * (2 * q - 1)
