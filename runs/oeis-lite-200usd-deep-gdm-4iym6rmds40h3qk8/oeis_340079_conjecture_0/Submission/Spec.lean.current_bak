    have : 3 * 9 ≤ A_q * (2 * q - 1) := Nat.mul_le_mul h_Aq_ge3 (by omega)
    omega
  have h5 : 2 * q ≤ (A_q * (2 * q - 1) * (2 * r - 1) + 1) + 2 * (A_q * (2 * q - 1)) * q := by
    have h_le_mul : 2 * q ≤ 2 * (A_q * (2 * q - 1)) * q := by
