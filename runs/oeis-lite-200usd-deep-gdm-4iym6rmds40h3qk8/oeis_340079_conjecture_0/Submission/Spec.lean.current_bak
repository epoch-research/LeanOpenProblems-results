have h_final_ident : k * (q * r) + 2 * A * q - 2 * q = (2 * q - 1) * ((A_q * k - u * m) * (q * r)) := by
  have h_RHS_eq : (2 * q - 1) * ((A_q * k - u * m) * (q * r)) = (2 * q - 1) * (A_q * (2 * r + 2 * q - 1) - 1) := by
    rw [h_W_eq]
