have hq_dvd_one_add : q ∣ 1 + (Finset.Ico 1 (n + 1)).sum (fun k => Nat.gcd k n) := Nat.dvd_trans hq_dvd_n hn_dvd_sum
rw [h_sum_n] at hq_dvd_one_add
