set_option maxRecDepth 2000000
set_option maxHeartbeats 0

open Nat

theorem solve_helper (n : ℕ) (p : ℕ) (y : ℕ)
    (hp_prime : p.Prime) (hp_lt : p < n)
    (hy_prime : y.Prime)
    (h_sqrt : y * y ≤ n + p ∧ n + p < (y + 1) * (y + 1)) :
    ∃ p, p.Prime ∧ p < n ∧ (Nat.sqrt (n + p)).Prime := by
  use p
  refine ⟨hp_prime, hp_lt, ?_⟩
  have h_eq : Nat.sqrt (n + p) = y := by
    symm
    rw [Nat.eq_sqrt]
    exact h_sqrt
  rw [h_eq]
  exact hy_prime

