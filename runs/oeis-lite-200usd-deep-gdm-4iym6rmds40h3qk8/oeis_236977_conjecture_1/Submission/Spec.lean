lemma check_witness_of_check_range_fast (low high : ℕ) (fuel : ℕ) (n : ℕ) (h_range : check_range_fast low high fuel = true)
    (h_low : low ≤ n) (h_high : n ≤ high) (h_fuel : high - low < fuel) : check_witness n = true := by
  induction fuel generalizing low high n with
  | zero => omega
  | succ f ih =>
    simp only [check_range_fast] at h_range
    split_ifs at h_range with h_lh h_eq
    · omega
    · have h_eq' : low = high := beq_iff_eq.mp h_eq
      have h_n : n = low := by omega
      rw [h_n]
      exact h_range
    · rw [Bool.and_eq_true] at h_range
      have h_neq : low ≠ high := by
        intro h_eq_eq
        rw [h_eq_eq] at h_eq
        simp at h_eq
      let mid := (low + high) / 2
      by_cases h_mid : n ≤ mid
      · dsimp only [mid] at *
        apply ih low ((low + high) / 2) n h_range.1 h_low h_mid
        omega
      · dsimp only [mid] at *
        apply ih (((low + high) / 2) + 1) high n h_range.2 (by omega) h_high
        omega

/--
OEIS A236998 Conjecture (i) states that a(n) > 0 for all n > 8.
This theorem formalizes the claim about the verified range:
"For n from 9 to 2*10^6, a(n) > 0."
%C A236998 a(n) > 0 for all n > 8 has been verified for n up to 2*10^6.
-/
theorem oeis_236977_conjecture_1 (n : ℕ) (h_n : 9 ≤ n ∧ n ≤ 2000000) : a n > 0 := by
  have hn_check : check_witness n = true := by
    apply check_witness_of_check_range_fast 9 2000000 2000000 n range_ok h_n.1 h_n.2 (by omega)
  exact a_pos_of_check_witness n h_n.1 hn_check

