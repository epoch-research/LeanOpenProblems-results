  rw [check_range_fast]
  have h_gt : ¬(low > high) := by omega
  have h_eq : ¬(low == high) := by
    intro hc
    have : low = high := beq_iff_eq.mp hc
    omega
  simp only [h_gt, h_eq, Bool.and_self, ↓reduceDIte, h1, h2, Bool.and_true, Bool.true_and]

