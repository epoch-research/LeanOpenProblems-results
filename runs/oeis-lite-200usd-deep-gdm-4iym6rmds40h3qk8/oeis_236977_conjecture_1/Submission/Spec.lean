import FormalConjectures.Util.ProblemImports

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
open Nat Finset

set_option maxRecDepth 200000
set_option maxHeartbeats 0

/--
A236998: a(n) = |{0 < k < n/2: phi(k)*phi(n-k) is a square}|, where phi(.) is Euler's totient function.
-/
def a (n : ℕ) : ℕ :=
  (Ico 1 ((n - 1) / 2 + 1)).sum fun k =>
    let m := totient k * totient (n - k)
    if sqrt m ^ 2 = m then 1 else 0

lemma sqrt_sq_eq (s : ℕ) : Nat.sqrt (s * s) ^ 2 = s * s := by
  rw [Nat.sqrt_eq s, sq]

lemma a_pos_of_witness (n : ℕ) (k : ℕ)
    (hk1 : 1 ≤ k) (hk2 : k < (n - 1) / 2 + 1)
    (hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k)) :
    a n > 0 := by
  have hk : k ∈ Ico 1 ((n - 1) / 2 + 1) := mem_Ico.mpr ⟨hk1, hk2⟩
  have h_single : (fun k => if sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) then 1 else 0) k = 1 := by
    dsimp
    rw [if_pos hsq]
  have h_le := Finset.single_le_sum (f := fun k => if sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) then 1 else 0) (fun _ _ => Nat.zero_le _) hk
  rw [h_single] at h_le
  exact zero_lt_one.trans_le h_le

lemma a_pos_of_sum_coprime_sq (x y d : ℕ) (hx : 1 ≤ x) (hy : x < y) (hd : 1 ≤ d)
    (h_cop_x : Coprime x d) (h_cop_y : Coprime y d)
    (hsq : sqrt (totient x * totient y) ^ 2 = totient x * totient y) :
    a ((x + y) * d) > 0 := by
  let n := (x + y) * d
  let k := x * d
  have hk1 : 1 ≤ k := Nat.mul_le_mul hx hd
  have hk2 : k < (n - 1) / 2 + 1 := by
    dsimp [n, k]
    have h_lt : 2 * (x * d) < (x + y) * d := by
      calc
        2 * (x * d) = (2 * x) * d := by rw [← mul_assoc]
        _ < (x + y) * d := Nat.mul_lt_mul_of_pos_right (by omega) (by omega)
    omega
  have h_tot_k : totient k = totient x * totient d := Nat.totient_mul h_cop_x
  have h_nk : n - k = y * d := by
    dsimp [n, k]
    calc
      (x + y) * d - x * d = (x * d + y * d) - x * d := by rw [add_mul]
      _ = y * d := by omega
  have h_tot_nk : totient (n - k) = totient y * totient d := by
    rw [h_nk]
    exact Nat.totient_mul h_cop_y
  have h_prod : totient k * totient (n - k) = totient x * totient y * (totient d * totient d) := by
    rw [h_tot_k, h_tot_nk]
    ring
  have h_sq_prod : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod]
    let s_xy := sqrt (totient x * totient y)
    have h_s_xy : s_xy * s_xy = totient x * totient y := by
      have h_eq : s_xy ^ 2 = totient x * totient y := hsq
      rw [sq] at h_eq
      exact h_eq
    have h_prod2 : totient x * totient y * (totient d * totient d) = (s_xy * totient d) * (s_xy * totient d) := by
      rw [← h_s_xy]
      ring
    rw [h_prod2]
    exact sqrt_sq_eq (s_xy * totient d)
  exact a_pos_of_witness n k hk1 hk2 h_sq_prod


lemma case_3_div_odd (n : ℕ) (h_n : 9 ≤ n) (h_3 : 3 ∣ n) (h_odd : n % 2 = 1) : a n > 0 := by
  let k := n / 3
  have h_eq : n = 3 * k := by
    exact (Nat.mul_div_cancel' h_3).symm
  have hk1 : 1 ≤ k := by omega
  have hk2 : k < (n - 1) / 2 + 1 := by omega
  have h_odd_k : k % 2 = 1 := by
    have h_odd_mul : (3 * k) % 2 = 1 := by
      rw [← h_eq]
      exact h_odd
    omega
  have h_coprime : Nat.Coprime 2 k := by
    rw [Nat.Coprime, Nat.gcd_rec, h_odd_k]
    rfl
  have h_nk : n - k = 2 * k := by omega
  have h_totient_nk : totient (n - k) = totient k := by
    rw [h_nk]
    rw [Nat.totient_mul h_coprime]
    rw [Nat.totient_two, one_mul]
  have h_prod : totient k * totient (n - k) = totient k * totient k := by rw [h_totient_nk]
  have hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod, sqrt_sq_eq (totient k)]
  exact a_pos_of_witness n k hk1 hk2 hsq

lemma case_3_div_even_not_5 (n : ℕ) (h_n : 9 ≤ n) (h_3 : 3 ∣ n) (h_even : n % 2 = 0) (h_n5 : n % 5 ≠ 0) : a n > 0 := by
  have h_6 : 6 ∣ n := by omega
  let k := n / 6
  have h_eq : n = 6 * k := by exact (Nat.mul_div_cancel' h_6).symm
  have hk1 : 1 ≤ k := by omega
  have hk2 : k < (n - 1) / 2 + 1 := by omega
  have h_k5 : k % 5 ≠ 0 := by
    have h_n5' : (6 * k) % 5 ≠ 0 := by
      rw [← h_eq]
      exact h_n5
    omega
  have h_coprime : Nat.Coprime 5 k := by
    rw [Nat.Coprime, Nat.gcd_rec]
    have h_mod : k % 5 < 5 := Nat.mod_lt k (by decide)
    interval_cases h : k % 5
    · contradiction
    · rfl
    · rfl
    · rfl
    · rfl
  have h_nk : n - k = 5 * k := by omega
  have h_totient_nk : totient (n - k) = 4 * totient k := by
    rw [h_nk]
    rw [Nat.totient_mul h_coprime]
    rfl
  have h_prod : totient k * totient (n - k) = (2 * totient k) * (2 * totient k) := by
    rw [h_totient_nk]
    ring
  have hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod, sqrt_sq_eq (2 * totient k)]
  exact a_pos_of_witness n k hk1 hk2 hsq

lemma case_30_div (n : ℕ) (h_n : 9 ≤ n) (h_30 : 30 ∣ n) : a n > 0 := by
  have h_10 : 10 ∣ n := by omega
  let k := n / 10
  have h_eq : n = 10 * k := by exact (Nat.mul_div_cancel' h_10).symm
  have hk1 : 1 ≤ k := by omega
  have hk2 : k < (n - 1) / 2 + 1 := by omega
  have h_3k : 3 ∣ k := by omega
  have h_prime_3 : Nat.Prime 3 := by decide
  have h_nk : n - k = 9 * k := by omega
  have h_totient_3k : totient (3 * k) = 3 * totient k := Nat.totient_mul_of_prime_of_dvd h_prime_3 h_3k
  have h_totient_9k : totient (9 * k) = 9 * totient k := by
    have h_9k : 9 * k = 3 * (3 * k) := by ring
    rw [h_9k]
    have h_div : 3 ∣ 3 * k := by omega
    rw [Nat.totient_mul_of_prime_of_dvd h_prime_3 h_div, h_totient_3k]
    ring
  have h_tot_nk : totient (n - k) = 9 * totient k := by rw [h_nk, h_totient_9k]
  have h_prod : totient k * totient (n - k) = (3 * totient k) * (3 * totient k) := by
    rw [h_tot_nk]
    ring
  have hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod, sqrt_sq_eq (3 * totient k)]
  exact a_pos_of_witness n k hk1 hk2 hsq

lemma case_3_div (n : ℕ) (h_n : 9 ≤ n) (h_3 : 3 ∣ n) : a n > 0 := by
  by_cases h_odd : n % 2 = 1
  · exact case_3_div_odd n h_n h_3 h_odd
  · have h_even : n % 2 = 0 := by omega
    by_cases h_n5 : n % 5 = 0
    · have h_30 : 30 ∣ n := by omega
      exact case_30_div n h_n h_30
    · exact case_3_div_even_not_5 n h_n h_3 h_even h_n5

lemma case_10_div (n : ℕ) (h_n : 9 ≤ n) (h_10 : 10 ∣ n) : a n > 0 := by
  have h_5 : 5 ∣ n := by omega
  let k := n / 5
  have h_eq : n = 5 * k := by exact (Nat.mul_div_cancel' h_5).symm
  have hk1 : 1 ≤ k := by omega
  have hk2 : k < (n - 1) / 2 + 1 := by omega
  have h_2k : 2 ∣ k := by omega
  have h_prime_2 : Nat.Prime 2 := by decide
  have h_nk : n - k = 4 * k := by omega
  have h_totient_2k : totient (2 * k) = 2 * totient k := Nat.totient_mul_of_prime_of_dvd h_prime_2 h_2k
  have h_totient_4k : totient (4 * k) = 4 * totient k := by
    have h_4k : 4 * k = 2 * (2 * k) := by ring
    rw [h_4k]
    have h_div : 2 ∣ 2 * k := by omega
    rw [Nat.totient_mul_of_prime_of_dvd h_prime_2 h_div, h_totient_2k]
    ring
  have h_tot_nk : totient (n - k) = 4 * totient k := by rw [h_nk, h_totient_4k]
  have h_prod : totient k * totient (n - k) = (2 * totient k) * (2 * totient k) := by
    rw [h_tot_nk]
    ring
  have hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod, sqrt_sq_eq (2 * totient k)]
  exact a_pos_of_witness n k hk1 hk2 hsq

lemma coprime_three_of_not_dvd (k : ℕ) (hk : k % 3 ≠ 0) : Nat.Coprime 3 (2 * k) := by
  rw [Nat.Coprime, Nat.gcd_rec]
  have h_not : (2 * k) % 3 ≠ 0 := by omega
  have h_mod : (2 * k) % 3 < 3 := Nat.mod_lt _ (by decide)
  interval_cases h : (2 * k) % 3
  · contradiction
  · rfl
  · rfl

lemma case_14_div_not_3 (n : ℕ) (h_n : 9 ≤ n) (h_14 : 14 ∣ n) (h_n3 : n % 3 ≠ 0) : a n > 0 := by
  have h_7 : 7 ∣ n := by omega
  let k := n / 7
  have h_eq : n = 7 * k := by exact (Nat.mul_div_cancel' h_7).symm
  have hk1 : 1 ≤ k := by omega
  have hk2 : k < (n - 1) / 2 + 1 := by omega
  have h_2k : 2 ∣ k := by omega
  have h_k3 : k % 3 ≠ 0 := by
    have h_n3' : (7 * k) % 3 ≠ 0 := by
      rw [← h_eq]
      exact h_n3
    omega
  have h_prime_2 : Nat.Prime 2 := by decide
  have h_nk : n - k = 6 * k := by omega
  have h_coprime : Nat.Coprime 3 (2 * k) := coprime_three_of_not_dvd k h_k3
  have h_tot_2k : totient (2 * k) = 2 * totient k := Nat.totient_mul_of_prime_of_dvd h_prime_2 h_2k
  have h_totient_6k : totient (6 * k) = 4 * totient k := by
    have h_6k : 6 * k = 3 * (2 * k) := by ring
    rw [h_6k, Nat.totient_mul h_coprime, show totient 3 = 2 by rfl, h_tot_2k]
    ring
  have h_tot_nk : totient (n - k) = 4 * totient k := by rw [h_nk, h_totient_6k]
  have h_prod : totient k * totient (n - k) = (2 * totient k) * (2 * totient k) := by
    rw [h_tot_nk]
    ring
  have hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod, sqrt_sq_eq (2 * totient k)]
  exact a_pos_of_witness n k hk1 hk2 hsq

lemma case_34_div (n : ℕ) (h_n : 9 ≤ n) (h_34 : 34 ∣ n) : a n > 0 := by
  have h_17 : 17 ∣ n := by omega
  let k := n / 17
  have h_eq : n = 17 * k := by exact (Nat.mul_div_cancel' h_17).symm
  have hk1 : 1 ≤ k := by omega
  have hk2 : k < (n - 1) / 2 + 1 := by omega
  have h_2k : 2 ∣ k := by omega
  have h_prime_2 : Nat.Prime 2 := by decide
  have h_nk : n - k = 16 * k := by omega
  have h_tot_2k : totient (2 * k) = 2 * totient k := Nat.totient_mul_of_prime_of_dvd h_prime_2 h_2k
  have h_tot_4k : totient (4 * k) = 4 * totient k := by
    have h_4k : 4 * k = 2 * (2 * k) := by ring
    rw [h_4k]
    have h_div : 2 ∣ 2 * k := by omega
    rw [Nat.totient_mul_of_prime_of_dvd h_prime_2 h_div, h_tot_2k]
    ring
  have h_tot_8k : totient (8 * k) = 8 * totient k := by
    have h_8k : 8 * k = 2 * (4 * k) := by ring
    rw [h_8k]
    have h_div : 2 ∣ 4 * k := by omega
    rw [Nat.totient_mul_of_prime_of_dvd h_prime_2 h_div, h_tot_4k]
    ring
  have h_tot_16k : totient (16 * k) = 16 * totient k := by
    have h_16k : 16 * k = 2 * (8 * k) := by ring
    rw [h_16k]
    have h_div : 2 ∣ 8 * k := by omega
    rw [Nat.totient_mul_of_prime_of_dvd h_prime_2 h_div, h_tot_8k]
    ring
  have h_tot_nk : totient (n - k) = 16 * totient k := by rw [h_nk, h_tot_16k]
  have h_prod : totient k * totient (n - k) = (4 * totient k) * (4 * totient k) := by
    rw [h_tot_nk]
    ring
  have hsq : sqrt (totient k * totient (n - k)) ^ 2 = totient k * totient (n - k) := by
    rw [h_prod, sqrt_sq_eq (4 * totient k)]
  exact a_pos_of_witness n k hk1 hk2 hsq

lemma coprime_seven_of_not_dvd (k : ℕ) (hk : k % 7 ≠ 0) : Nat.Coprime 7 k := by
  have h_not : ¬ 7 ∣ k := by
    intro h_div
    have h_mod : k % 7 = 0 := Nat.mod_eq_zero_of_dvd h_div
    exact hk h_mod
  exact (Nat.Prime.coprime_iff_not_dvd (by decide)).mpr h_not

lemma coprime_three_of_not_dvd_simple (k : ℕ) (hk : k % 3 ≠ 0) : Nat.Coprime 3 k := by
  have h_not : ¬ 3 ∣ k := by
    intro h_div
    have h_mod : k % 3 = 0 := Nat.mod_eq_zero_of_dvd h_div
    exact hk h_mod
  exact (Nat.Prime.coprime_iff_not_dvd (by decide)).mpr h_not

lemma coprime_nine_of_not_dvd (k : ℕ) (hk : k % 3 ≠ 0) : Nat.Coprime 9 k := by
  have h3 : Nat.Coprime 3 k := coprime_three_of_not_dvd_simple k hk
  exact Nat.Coprime.pow_left 2 h3

lemma case_16_div_not_3_7 (n : ℕ) (h_n : 9 ≤ n) (h_16 : 16 ∣ n) (h_n3 : n % 3 ≠ 0) (h_n7 : n % 7 ≠ 0) : a n > 0 := by
  let d := n / 16
  have h_eq : n = 16 * d := by exact (Nat.mul_div_cancel' h_16).symm
  have hd1 : 1 ≤ d := by omega
  have hd2 : 7 * d < (n - 1) / 2 + 1 := by omega
  have h_d3 : d % 3 ≠ 0 := by
    intro h_div
    have h_div' : 3 ∣ d := Nat.dvd_of_mod_eq_zero h_div
    have h_n3' : 3 ∣ n := by
      rw [h_eq]
      exact dvd_mul_of_dvd_right h_div' 16
    have h_mod_zero : n % 3 = 0 := Nat.mod_eq_zero_of_dvd h_n3'
    exact h_n3 h_mod_zero
  have h_d7 : d % 7 ≠ 0 := by
    intro h_div
    have h_div' : 7 ∣ d := Nat.dvd_of_mod_eq_zero h_div
    have h_n7' : 7 ∣ n := by
      rw [h_eq]
      exact dvd_mul_of_dvd_right h_div' 16
    have h_mod_zero : n % 7 = 0 := Nat.mod_eq_zero_of_dvd h_n7'
    exact h_n7 h_mod_zero
  have h_cop7 : Nat.Coprime 7 d := coprime_seven_of_not_dvd d h_d7
  have h_cop9 : Nat.Coprime 9 d := coprime_nine_of_not_dvd d h_d3
  have h_nk : n - 7 * d = 9 * d := by omega
  have h_tot_7d : totient (7 * d) = 6 * totient d := by
    rw [Nat.totient_mul h_cop7]
    rfl
  have h_tot_9d : totient (9 * d) = 6 * totient d := by
    rw [Nat.totient_mul h_cop9]
    rfl
  have h_prod : totient (7 * d) * totient (n - 7 * d) = (6 * totient d) * (6 * totient d) := by
    rw [h_nk, h_tot_7d, h_tot_9d]
  have hsq : sqrt (totient (7 * d) * totient (n - 7 * d)) ^ 2 = totient (7 * d) * totient (n - 7 * d) := by
    rw [h_prod, sqrt_sq_eq (6 * totient d)]
  exact a_pos_of_witness n (7 * d) (by omega) hd2 hsq

lemma case_16_div (n : ℕ) (h_n : 9 ≤ n) (h_16 : 16 ∣ n) : a n > 0 := by
  by_cases h_3 : 3 ∣ n
  · exact case_3_div n h_n h_3
  · have h_n3 : n % 3 ≠ 0 := by
      intro h_zero
      have h_div : 3 ∣ n := Nat.dvd_of_mod_eq_zero h_zero
      exact h_3 h_div
    by_cases h_7 : 7 ∣ n
    · have h_14 : 14 ∣ n := by
        have h_even : 2 ∣ n := dvd_trans (by decide) h_16
        exact Nat.Coprime.mul_dvd_of_dvd_of_dvd (by decide) h_even h_7
      exact case_14_div_not_3 n h_n h_14 h_n3
    · have h_n7 : n % 7 ≠ 0 := by
        intro h_zero
        have h_div : 7 ∣ n := Nat.dvd_of_mod_eq_zero h_zero
        exact h_7 h_div
      exact case_16_div_not_3_7 n h_n h_16 h_n3 h_n7


def mySqrtAux (n : ℕ) (low high : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => low
  | fuel + 1 =>
    if low + 1 >= high then
      low
    else
      let mid := (low + high) / 2
      if mid * mid ≤ n then
        mySqrtAux n mid high fuel
      else
        mySqrtAux n low mid fuel

def my_sqrt (n : ℕ) : ℕ :=
  mySqrtAux n 0 (n + 1) (n + 1)

def find_factor (x : ℕ) (d : ℕ) (limit : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => x
  | fuel + 1 =>
    if d > limit then
      x
    else if x % d == 0 then
      d
    else
      find_factor x (d + 1) limit fuel

def remove_p (p : ℕ) (val : ℕ) (pk : ℕ) (fuel : ℕ) : ℕ × ℕ :=
  match fuel with
  | 0 => (val, pk)
  | fuel + 1 =>
    if val % p == 0 then
      remove_p p (val / p) (pk * p) fuel
    else
      (val, pk)

def fast_totient_aux (x : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => 1
  | fuel + 1 =>
    if x <= 1 then
      x
    else
      let s := my_sqrt x
      let p := find_factor x 2 s s
      if p == x then
        x - 1
      else
        let (y, pk) := remove_p p (x / p) p x
        (pk - pk / p) * fast_totient_aux y fuel

def fast_totient (x : ℕ) : ℕ :=
  fast_totient_aux x x

def check_all_totients (fuel : Nat) (start : Nat) : Bool :=
  match fuel with
  | 0 => true
  | fuel + 1 =>
    if start > 6188 then
      true
    else
      (fast_totient start == totient start) && check_all_totients fuel (start + 1)

lemma all_tot_ok : check_all_totients 6190 0 = true := by decide

lemma check_all_totients_sound (fuel : Nat) (start : Nat) (hx : start ≤ x) (h_lt : x < start + fuel) (h_max : x ≤ 6188)
    (h : check_all_totients fuel start = true) : totient x = fast_totient x := by
  induction fuel generalizing start with
  | zero => omega
  | succ f ih =>
    simp only [check_all_totients] at h
    split_ifs at h with h_cond
    · omega
    · rw [Bool.and_eq_true] at h
      by_cases hx_start : x = start
      · subst hx_start
        exact beq_iff_eq.mp h.1
      · have h_ge : start + 1 ≤ x := by omega
        have h_lt' : x < start + 1 + f := by omega
        exact ih (start + 1) h_ge h_lt' h_max h.2

