import FormalConjectures.Util.ProblemImports

set_option warn.sorry false
set_option maxRecDepth 300000
set_option linter.style.namespace false

open Nat Finset Int

/--
A301376: Number of ways to write n^2 as x^2 + y^2 + z^2 + w^2 with x, y, z, w nonnegative integers and z <= w such that x^2 - 9y^2 = 4^k for some k >= 0.
-/
def a (n : ℕ) : ℕ :=
  match n with
  | 0 => 0
  | n + 1 =>
    let R := Finset.range (n + 2)
    let domain : Finset ((ℕ × ℕ) × (ℕ × ℕ)) := (R.product R).product (R.product R)

    Finset.card $ domain.filter (λ p : (ℕ × ℕ) × (ℕ × ℕ) =>
      let x := p.fst.fst; let y := p.fst.snd;
      let z := p.snd.fst; let w := p.snd.snd;

      x^2 + y^2 + z^2 + w^2 = (n + 1)^2 ∧
      z ≤ w ∧
      (∃ k ∈ Finset.range (n + 2), (x^2 : ℤ) - (3 * y : ℤ)^2 = (4^k : ℤ))
    )

theorem A301376_conjecture : ∀ (n : ℕ), n > 0 → a n > 0 := by
  sorry
