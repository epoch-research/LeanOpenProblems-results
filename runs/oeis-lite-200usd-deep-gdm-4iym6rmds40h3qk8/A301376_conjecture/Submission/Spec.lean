set_option linter.style.namespace false

open Nat Finset Int

/--
A301376: Number of ways to write n^2 as x^2 + y^2 + z^2 + w^2 with x, y, z, w nonnegative integers and z <= w such that x^2 - 9y^2 = 4^k for some k >= 0.
-/
def a (n : ℕ) : ℕ :=
  match n with
  | 0 => 0
  | n + 1 =>
    let R := Finset.range (n + 2)
    let domain : Finset ((ℕ × ℕ) × (ℕ × ℕ)) := (R.product R).product (R.product R)

    Finset.card $ domain.filter (λ p : (ℕ × ℕ) × (ℕ × ℕ) =>
      let x := p.fst.fst; let y := p.fst.snd;
      let z := p.snd.fst; let w := p.snd.snd;

      x^2 + y^2 + z^2 + w^2 = (n + 1)^2 ∧
      z ≤ w ∧
      (∃ k ∈ Finset.range (n + 2), (x^2 : ℤ) - (3 * y : ℤ)^2 = (4^k : ℤ))
    )

theorem witness_is_pos (m : ℕ) (x y z w k : ℕ)
    (h_dom : (x < m + 2 ∧ y < m + 2) ∧ z < m + 2 ∧ w < m + 2)
    (h_sum : x^2 + y^2 + z^2 + w^2 = (m + 1)^2)
    (h_le : z ≤ w)
    (h_k : k < m + 2)
    (h_eq : (x^2 : ℤ) - (3 * y : ℤ)^2 = (4^k : ℤ)) :
    a (m + 1) > 0 := by
  unfold a
  dsimp
  apply Finset.card_pos.mpr
  refine ⟨((x, y), (z, w)), ?_⟩
  rw [Finset.mem_filter]
  refine ⟨?_, h_sum, h_le, ?_⟩
  · simp only [Finset.mem_product, Finset.mem_range]
    exact h_dom
  · use k
    refine ⟨?_, h_eq⟩
    rw [Finset.mem_range]
    exact h_k

theorem scaling_step {d : ℕ} (hd : a d > 0) : a (2 * d) > 0 := by
  have hd_pos : d > 0 := by
    by_contra h
    have : d = 0 := by omega
    subst this
    have h_a0 : a 0 = 0 := rfl
    rw [h_a0] at hd
    omega
  rcases d with _ | m
  · contradiction
  · -- d = m + 1. So 2 * d = 2 * m + 2
    change a (2 * m + 2) > 0
    unfold a at hd
    dsimp at hd
    rcases Finset.card_pos.mp hd with ⟨p, hp⟩
    rw [Finset.mem_filter] at hp
    rcases hp with ⟨hp_dom, hp_sum, hp_le, hp_k⟩
    rcases hp_k with ⟨k, hk_range, hk_eq⟩
    rw [Finset.mem_range] at hk_range
    -- Now unfold a (2 * m + 2)
    unfold a
    dsimp
    apply Finset.card_pos.mpr
    refine ⟨((2 * p.1.1, 2 * p.1.2), (2 * p.2.1, 2 * p.2.2)), ?_⟩
    rw [Finset.mem_filter]
    dsimp only
    refine ⟨?_, ?_, ?_, ?_⟩
    · simp only [Finset.mem_product, Finset.mem_range] at hp_dom ⊢
      rcases hp_dom with ⟨⟨h1, h2⟩, ⟨h3, h4⟩⟩
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
      · omega
      · omega
      · omega
      · omega
    · calc (2 * p.1.1)^2 + (2 * p.1.2)^2 + (2 * p.2.1)^2 + (2 * p.2.2)^2
        _ = 4 * (p.1.1^2 + p.1.2^2 + p.2.1^2 + p.2.2^2) := by ring
        _ = 4 * (m + 1)^2 := by rw [hp_sum]
        _ = (2 * m + 2)^2 := by ring
    · omega
    · use k + 1
      refine ⟨?_, ?_⟩
      · rw [Finset.mem_range]
        omega
      · push_cast
        calc ((2 * p.1.1 : ℤ))^2 - (3 * (2 * p.1.2 : ℤ))^2
          _ = 4 * ((p.1.1 : ℤ)^2 - (3 * (p.1.2 : ℤ))^2) := by ring
          _ = 4 * (4^k : ℤ) := by rw [hk_eq]
          _ = (4 : ℤ)^(k + 1) := by ring

