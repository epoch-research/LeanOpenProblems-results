import FormalConjectures.Util.ProblemImports

open Real Int

/--
A011545: $a(n)$ is the integer whose decimal digits are the first $n+1$ decimal digits of $\pi$.
This is equivalent to $a(n) = \lfloor \pi \cdot 10^n \rfloor$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  -- The calculation is $\lfloor \pi \cdot 10^n \rfloor$.
  -- We use Real.floor, which returns an Int, and convert it to a natural number.
  (floor (Real.pi * (10 : ℝ) ^ n.cast)).toNat

lemma eq_floor_add_one_of_lt_of_lt {x : ℝ} {k : ℤ} (h1 : x < k) (h2 : (k : ℝ) < x + 1) : k = ⌊x⌋ + 1 := by
  have h3 : ⌊x⌋ < k := by
    rw [Int.floor_lt]
    exact h1
  have h4 : k - 1 <= ⌊x⌋ := by
    rw [Int.le_floor]
    push_cast
    linarith
  omega

lemma arctan_gt_rational_frac (x : ℝ) (hx : 0 < x) :
    x / (1 + x ^ 2) < arctan x := by
  let y := arctan x
  have hy_pos : 0 < y := arctan_pos.mpr hx
  have hy_lt : y < π / 2 := arctan_lt_pi_div_two x
  have h2y_pos : 0 < 2 * y := by linarith
  have h_sin_lt : sin (2 * y) < 2 * y := sin_lt h2y_pos
  have h_sin_double : sin (2 * y) = 2 * sin y * cos y := sin_two_mul y
  rw [h_sin_double] at h_sin_lt
  have h_sin_cos_lt : sin y * cos y < y := by linarith
  have h_sin_y : sin y = x / √(1 + x ^ 2) := sin_arctan x
  have h_cos_y : cos y = 1 / √(1 + x ^ 2) := cos_arctan x
  have h_mul : sin y * cos y = x / (1 + x ^ 2) := by
    rw [h_sin_y, h_cos_y]
    have h_sq_pos : 0 < 1 + x ^ 2 := by positivity
    have h_sqrt_sq : √(1 + x ^ 2) * √(1 + x ^ 2) = 1 + x ^ 2 := mul_self_sqrt h_sq_pos.le
    have h_eq : (x / √(1 + x ^ 2)) * (1 / √(1 + x ^ 2)) = (x * 1) / (√(1 + x ^ 2) * √(1 + x ^ 2)) := by ring
    rw [h_eq, mul_one, h_sqrt_sq]
  rw [h_mul] at h_sin_cos_lt
  exact h_sin_cos_lt

lemma pi_div_arctan_lt_pi_mul_ten_pow_add_pi_div_ten_pow (n : ℕ) :
    π / arctan (1 / (10 : ℝ) ^ n.cast) < π * (10 : ℝ) ^ n.cast + π / (10 : ℝ) ^ n.cast := by
  let x := 1 / (10 : ℝ) ^ n.cast
  have hx : 0 < x := by positivity
  have h_rat : x / (1 + x ^ 2) < arctan x := arctan_gt_rational_frac x hx
  have h_pos : 0 < arctan x := lt_trans (by positivity) h_rat
  have h_inv : (arctan x)⁻¹ < (x / (1 + x^2))⁻¹ := (inv_lt_inv₀ h_pos (by positivity)).mpr h_rat
  have h_div : π / arctan x < π / (x / (1 + x ^ 2)) := by
    rw [div_eq_mul_inv, div_eq_mul_inv]
    exact mul_lt_mul_of_pos_left h_inv pi_pos
  have h_calc : π / (x / (1 + x ^ 2)) = π * (10 : ℝ) ^ n.cast + π / (10 : ℝ) ^ n.cast := by
    have h1 : 1 / x = (10 : ℝ) ^ n.cast := by
      dsimp [x]
      have : (10 : ℝ) ^ n.cast ≠ 0 := by positivity
      field_simp
    have h2 : (1 + x ^ 2) / x = 1 / x + x := by
      have : x ≠ 0 := hx.ne'
      field_simp
    calc
      π / (x / (1 + x ^ 2)) = π * ((1 + x ^ 2) / x) := by
        have : x / (1 + x ^ 2) ≠ 0 := by positivity
        field_simp
      _ = π * (1 / x + x) := by rw [h2]
      _ = π * (1 / x) + π * x := by ring
      _ = π * (10 : ℝ) ^ n.cast + π / (10 : ℝ) ^ n.cast := by
        rw [h1]
        dsimp [x]
        ring
  rwa [h_calc] at h_div

