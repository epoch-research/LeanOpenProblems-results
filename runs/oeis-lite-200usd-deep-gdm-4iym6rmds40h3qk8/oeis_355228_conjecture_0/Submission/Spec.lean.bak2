  have h_card : (Nat.divisors x).card < 20 := by
    have h_dec := of_decide_eq_true h_all
    by_cases h_cond : x = 240 ∨ x = 336 ∨ x = 360 ∨ x = 420 ∨ x = 432 ∨ x = 480 ∨ x = 504 ∨ x = 528 ∨ x = 540 ∨ x = 560 ∨ x = 576 ∨ x = 600 ∨ x = 624 ∨ x = 630 ∨ x = 648 ∨ x = 660
