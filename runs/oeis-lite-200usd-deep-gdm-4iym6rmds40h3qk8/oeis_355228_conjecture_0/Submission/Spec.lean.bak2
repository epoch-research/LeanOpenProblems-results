    · rintro pe_mem; rcases pe_mem with pe_eq
      · subst pe_eq; exact h_not_360 hx
      · subst pe_eq; exact h_not_240 hx
      · subst pe_eq; exact h_not_180 hx
  let C_final := S_final \ D
