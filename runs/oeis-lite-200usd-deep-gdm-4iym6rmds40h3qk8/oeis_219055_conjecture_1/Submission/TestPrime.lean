import FormalConjectures.Util.ProblemImports

def is_prime_lookup_string : String := ""

def is_prime_lookup (n : ℕ) : Bool :=
  if n < is_prime_lookup_string.length then
    is_prime_lookup_string.get ⟨n⟩ == '1'
  else
    false

def check_all_sound_aux (n : ℕ) : Bool :=
  match n with
  | 0 => true
  | i + 1 =>
    (if is_prime_lookup i then decide i.Prime else true) && check_all_sound_aux i

lemma check_all_sound_aux_sound (limit : ℕ) (h_all : check_all_sound_aux limit = true) (a : ℕ) (ha : a < limit)
    (h_lookup : is_prime_lookup a = true) : a.Prime := by
  induction limit with
  | zero => omega
  | succ l ih =>
    rw [check_all_sound_aux] at h_all
    rw [Bool.and_eq_true] at h_all
    rcases h_all with ⟨h_curr, h_prev⟩
    by_cases ha_eq : a = l
    · subst ha_eq
      rw [h_lookup] at h_curr
      simp at h_curr
      exact h_curr
    · have ha_lt : a < l := by omega
      exact ih h_prev ha_lt

theorem is_prime_lookup_sound_bounded : ∀ n < 15728, is_prime_lookup n = true → n.Prime := by
  intro n hn
  have h_all : check_all_sound_aux 15728 = true := by decide
  exact check_all_sound_aux_sound 15728 h_all n hn
