def lookup_trie (t : PrimeTrie) (n : ℕ) (depth : ℕ) : Bool :=
  match depth with
  | 0 => match t with | .t => true | _ => false
  | d + 1 => match t with
    | .f => false
    | .t => true
    | .n l r => if n % 2 == 0 then lookup_trie l (n / 2) d else lookup_trie r (n / 2) d

def check_trie_interval (a b : ℕ) (fuel : ℕ) : Bool :=
  match fuel with
  | 0 => false
  | f + 1 =>
    if b < a then true
    else if a == b then
      if lookup_trie trie a 14 then decide a.Prime else true
    else
      let mid := (a + b) / 2
      check_trie_interval a mid f && check_trie_interval (mid + 1) b f

lemma check_trie_interval_sound (fuel : ℕ) (a b x : ℕ) (h_all : check_trie_interval a b fuel = true)
    (hx1 : a ≤ x) (hx2 : x ≤ b) (h_lookup : lookup_trie trie x 14 = true) : x.Prime := by
  induction fuel generalizing a b with
  | zero =>
    unfold check_trie_interval at h_all
    contradiction
  | succ f ih =>
    rw [check_trie_interval] at h_all
    by_cases h1 : b < a
    · rw [if_pos h1] at h_all
      omega
    · rw [if_neg h1] at h_all
      by_cases h2 : a = b
      · have h2_b : (a == b) = true := beq_iff_eq.mpr h2
        rw [if_pos h2_b] at h_all
        have hx_eq : x = a := by omega
        rw [hx_eq] at h_lookup
        rw [h_lookup] at h_all
        rw [hx_eq]
        exact (decide_eq_true_iff).mp h_all
      · have h2_b : (a == b) = false := decide_eq_false h2
        have h2_b_ne : (a == b) ≠ true := by rw [h2_b]; decide
        rw [if_neg h2_b_ne] at h_all
        rw [Bool.and_eq_true] at h_all
        rcases h_all with ⟨h_left, h_right⟩
        let mid := (a + b) / 2
        by_cases hx_mid : x ≤ mid
        · exact ih a mid h_left hx1 hx_mid h_lookup
        · have hx_gt : x ≥ mid + 1 := by omega
          exact ih (mid + 1) b h_right hx_gt hx2 h_lookup

theorem is_prime_lookup_sound_bounded : ∀ n < 15728, lookup_trie trie n 14 = true → n.Prime := by
  intro n hn hp
  have h_all1 : check_trie_interval 0 1999 12 = true := by decide
  have h_all2 : check_trie_interval 2000 3999 12 = true := by decide
  have h_all3 : check_trie_interval 4000 5999 12 = true := by decide
  have h_all4 : check_trie_interval 6000 7999 12 = true := by decide
  have h_all5 : check_trie_interval 8000 9999 12 = true := by decide
  have h_all6 : check_trie_interval 10000 11999 12 = true := by decide
  have h_all7 : check_trie_interval 12000 13999 12 = true := by decide
  have h_all8 : check_trie_interval 14000 15727 12 = true := by decide
  by_cases hn1 : n ≤ 1999
  · exact check_trie_interval_sound 12 0 1999 n h_all1 (by omega) hn1 hp
  · by_cases hn2 : n ≤ 3999
    · exact check_trie_interval_sound 12 2000 3999 n h_all2 (by omega) hn2 hp
    · by_cases hn3 : n ≤ 5999
      · exact check_trie_interval_sound 12 4000 5999 n h_all3 (by omega) hn3 hp
      · by_cases hn4 : n ≤ 7999
        · exact check_trie_interval_sound 12 6000 7999 n h_all4 (by omega) hn4 hp
        · by_cases hn5 : n ≤ 9999
          · exact check_trie_interval_sound 12 8000 9999 n h_all5 (by omega) hn5 hp
          · by_cases hn6 : n ≤ 11999
            · exact check_trie_interval_sound 12 10000 11999 n h_all6 (by omega) hn6 hp
            · by_cases hn7 : n ≤ 13999
              · exact check_trie_interval_sound 12 12000 13999 n h_all7 (by omega) hn7 hp
              · exact check_trie_interval_sound 12 14000 15727 n h_all8 (by omega) (by omega) hp
