import FormalConjectures.Util.ProblemImports

open Nat Finset

def is_prime_lookup_string : String := ""

def is_prime_lookup (n : ℕ) : Bool :=
  if n < is_prime_lookup_string.length then
    is_prime_lookup_string.get ⟨n⟩ == '1'
  else
    false

theorem test_prime : ∀ n, n < 15728 → is_prime_lookup n = true → n.Prime := by decide
