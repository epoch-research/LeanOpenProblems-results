theorem composite_13 (hp : Nat.Prime m13) : False := by
  have h_coprime : Nat.Coprime 3 m13 := by
    have hp3 : Nat.Prime 3 := by decide
    have h_not_dvd : ¬ 3 ∣ m13 := by decide
    exact hp3.coprime_iff_not_dvd.mpr h_not_dvd
  have h_flt := Nat.ModEq.pow_card_sub_one_eq_one hp h_coprime
  -- h_flt is 3 ^ (m13 - 1) ≡ 1 [MOD m13]
  -- which means 3 ^ (m13 - 1) % m13 = 1 % m13
  -- since m13 >= 2, 1 % m13 = 1. So 3 ^ (m13 - 1) % m13 = 1
  have hm2 : 2 ≤ m13 := hp.two_le
  have h_flt_mod : 3 ^ (m13 - 1) % m13 = 1 := by
    have h13_1 : 1 % m13 = 1 := Nat.mod_eq_of_lt hm2
    rw [Nat.ModEq, h13_1] at h_flt
    exact h_flt
  have h_m_sub : m13 - 1 = 10 ^ 8192 := by
    unfold m13
    rfl
  rw [h_m_sub] at h_flt_mod
  -- h_flt_mod is: 3 ^ (10 ^ 8192) % m13 = 1
  have h_v32 : v13 32 = 3 ^ (10 ^ 8192) % m13 := by
    have h_eq := v13_eq_pow_mod 32
    -- i * 256 is 32 * 256 = 8192. Let's rewrite that!
    have h_exp : 32 * 256 = 8192 := rfl
    rw [h_exp] at h_eq
    exact h_eq
  rw [← h_v32] at h_flt_mod
  exact test_v13_32_ne_one h_flt_mod


