            omega
          have h_add_one : p_index n (a n + 1) = p_index n (a n) + 1 := by
            have h_p : p_index n (a n + 1) =
              if (S n (a n)).getD (p_index n (a n)) 0 % 2 == 0 then p_index n (a n) else p_index n (a n) + 1 := rfl
            rw [h_p]
            rw [ha_mem, replicate_getD]
            rw [if_pos hp_lt]
            rfl
          have h_p_le_2 : p_index n (a n) + 2 ≤ n := by omega
          have h_add_two := p_index_add n (by omega) ha_mem 2 h_p_le_2
          omega
      exact ⟨h_part1, h_part2⟩
  termination_by 3 * n + 2
  decreasing_by omega
end

lemma stable_steps_nonempty (n : ℕ) (hn : 1 ≤ n) :
  S n (a n) = replicate n 1 ∧ (stable_steps n).Nonempty := by
  exact (stable_and_bounds n hn).1

lemma p_index_bounds (n : ℕ) (hn : 2 ≤ n) :
  p_index (n - 1) (a (n - 1)) = n - 2 ∨ p_index (n - 1) (a (n - 1)) = n - 3 := by
  have h_sb := stable_and_bounds (n - 1) (by omega)
  have h2 : 2 ≤ n - 1 + 1 := by omega
  exact h_sb.2 h2

-- duplicate declarations removed

lemma p_index_lt_n_of_bounds (n : ℕ) (hn : 1 ≤ n) : p_index n (a n) < n := by
  by_cases hn2 : n = 1
  · subst hn2
    have ha1 : a 1 = 0 := a_one_eq_zero
    rw [ha1]
    unfold p_index
    omega
  · have hn1 : 2 ≤ n + 1 := by omega
    have hp := p_index_bounds (n + 1) hn1
    have hp_simp : p_index n (a n) = n - 1 ∨ p_index n (a n) = n - 2 := hp
    rcases hp_simp with h1 | h2
    · rw [h1]; omega
    · rw [h2]; omega

lemma p_index_lt_n (n t : ℕ) (hn : 1 ≤ n) (ht : t ≤ a n) : p_index n t < n := by
  have h_mono := p_index_le n t (a n) ht
  have h_bounds := p_index_lt_n_of_bounds n hn
  omega

lemma a_succ_ge (n : ℕ) (hn : 1 ≤ n) : a (n + 1) ≥ a n + 1 := by
  have h_prop : ∀ t, t ∈ stable_steps (n + 1) → t ≥ a n + 1 := by
    intro t ht
    by_contra h_lt
    have h_lt_le : t ≤ a n := by omega
    have h1 : (S (n + 1) t).getD n 0 = 1 := by
      unfold stable_steps at ht
      rw [ht, replicate_getD]
      simp
    have h2 := S_coupling n t n
    rw [h1] at h2
    have h3 : (S n t).getD n 0 = 0 := S_oob_strong n t n (by omega)
    rw [h3] at h2
    have h4 := p_index_lt_n n t hn h_lt_le
    have h5 : n ≠ p_index n t := by omega
    simp [h5] at h2
  have h_nonempty : (stable_steps (n + 1)).Nonempty := (stable_steps_nonempty (n + 1) (by omega)).2
  have ha_eq : a (n + 1) = sInf (stable_steps (n + 1)) := a_eq_sInf_stable_steps (by omega)
  have ha_mem : a (n + 1) ∈ stable_steps (n + 1) := by
    rw [ha_eq]
    exact Nat.sInf_mem h_nonempty
  exact h_prop (a (n + 1)) ha_mem

theorem oeis_a300997_finite_difference_is_one_or_two :
  ∀ n : ℕ, 1 ≤ n → a (n + 1) = a n + 1 ∨ a (n + 1) = a n + 2 := by
  intro n hn
  have h_nonempty_n := stable_steps_nonempty n hn
  rcases h_nonempty_n with ⟨h_stable, h_nonempty⟩
  have h_nonempty_succ := stable_steps_nonempty (n + 1) (by omega)
  rcases h_nonempty_succ with ⟨h_stable_succ, h_nonempty_succ⟩
  have ha_succ : a (n + 1) = sInf (stable_steps (n + 1)) := a_eq_sInf_stable_steps (by omega)
  have hn1 : 2 ≤ n + 1 := by omega
  have hp_bounds := p_index_bounds (n + 1) hn1
  have hp_bounds_simple : p_index n (a n) = n - 1 ∨ p_index n (a n) = n - 2 := by
    simp at hp_bounds
    exact hp_bounds
  generalize h_p : p_index n (a n) = p
  have hp_bounds_p : p = n - 1 ∨ p = n - 2 := by
    rw [h_p] at hp_bounds_simple
    exact hp_bounds_simple
  have h_is_one_except_two : is_one_except_two (S (n + 1) (a n)) n p := by
    intro i
    have h_eq_n : n + 1 = n + 1 := rfl
    rw [S_coupling n (a n) i]
    rw [h_stable]
    rw [replicate_getD]
    rw [h_p]
    split_ifs <;> omega
  have h_p_lt : p < n := by omega
  have h_steps := steps_to_stable (S (n + 1) (a n)) n p (n - p) h_p_lt rfl h_is_one_except_two
  rw [← S_add] at h_steps
  have h_stable_final : S (n + 1) (a n + (n - p)) = replicate (n + 1) 1 := by
    have h_t_nz : a n + (n - p) ≠ 0 := step_two_nonzero n p h_p_lt (a n)
    have h_trim := S_trim (n + 1) (a n + (n - p)) h_t_nz
    apply eq_replicate_of_getD _ (n + 1) h_trim
    intro i
    have h_steps_i := h_steps i
    rw [replicate_getD]
    exact h_steps_i
  have h_in_succ : a n + (n - p) ∈ stable_steps (n + 1) := h_stable_final
  have ha_succ_le : a (n + 1) ≤ a n + (n - p) := by
    have h_le := Nat.sInf_le h_in_succ
    rw [← ha_succ] at h_le
    exact h_le
  have h_ge := a_succ_ge n hn
  rcases hp_bounds_p with hp1 | hp2
  · rw [hp1] at ha_succ_le
    have h_diff : n - (n - 1) = 1 := by
      clear h_stable h_nonempty h_stable_succ h_nonempty_succ hp_bounds hp_bounds_simple h_is_one_except_two h_steps h_stable_final h_in_succ ha_succ ha_succ_le h_ge hp1 h_p h_p_lt p
      omega
    rw [h_diff] at ha_succ_le
    generalize ha_n : a n = an_var
    generalize ha_succ_var : a (n + 1) = a_succ_var
    rw [ha_succ_var] at ha_succ_le h_ge
    omega
  · rw [hp2] at ha_succ_le
    by_cases hn2 : n = 1
    · subst hn2
      have h_diff : 1 - (1 - 2) = 1 := rfl
      rw [h_diff] at ha_succ_le
      generalize ha_n : a 1 = an_var
      generalize ha_succ_var : a 2 = a_succ_var
      rw [ha_succ_var] at ha_succ_le h_ge
      omega
    · have hn_ge : 2 ≤ n := by omega
      have h_diff : n - (n - 2) = 2 := by
        clear h_stable h_nonempty h_stable_succ h_nonempty_succ hp_bounds hp_bounds_simple h_is_one_except_two h_steps h_stable_final h_in_succ ha_succ ha_succ_le h_ge hp2 h_p h_p_lt p hn2
        omega
      rw [h_diff] at ha_succ_le
      generalize ha_n : a n = an_var
      generalize ha_succ_var : a (n + 1) = a_succ_var
      rw [ha_succ_var] at ha_succ_le h_ge
      omega


