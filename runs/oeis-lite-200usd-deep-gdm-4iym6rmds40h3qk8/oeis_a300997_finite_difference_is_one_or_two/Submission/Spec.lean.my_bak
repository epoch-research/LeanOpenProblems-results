        rw [replicate_getD]
        have h_eq_n : n - 1 + 1 = n := by omega
        rw [h_eq_n] at h_steps_i
        exact h_steps_i
      have h_stable_mem : a (n - 1) + (n - 1 - p_index (n - 1) (a (n - 1))) ∈ stable_steps n := h_stable
      have h_nonempty : (stable_steps n).Nonempty := ⟨a (n - 1) + (n - 1 - p_index (n - 1) (a (n - 1))), h_stable_mem⟩
