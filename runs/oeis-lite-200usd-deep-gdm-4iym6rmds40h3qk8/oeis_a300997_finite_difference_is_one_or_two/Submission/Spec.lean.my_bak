      rcases h_ih with ⟨⟨h_stable_prev, h_nonempty_prev⟩, hp_bounds_prev_fn⟩
      have hp_bounds_prev := hp_bounds_prev_fn (by omega)
      have h_n2_eq : n - 1 - 1 = n - 2 := by omega
      have h_n3_eq : n - 1 - 2 = n - 3 := by omega
      rw [h_n2_eq, h_n3_eq] at hp_bounds_prev
