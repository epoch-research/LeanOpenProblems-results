      have h_part1 : S n (a n) = replicate n 1 ∧ (stable_steps n).Nonempty := ⟨ha_mem, h_nonempty⟩
      have h_part2 : 2 ≤ n + 1 → p_index n (a n) = n - 1 ∨ p_index n (a n) = n - 2 := by
