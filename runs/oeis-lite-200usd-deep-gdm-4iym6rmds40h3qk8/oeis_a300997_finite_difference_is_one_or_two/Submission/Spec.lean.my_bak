        have h_t_nz : a (n - 1) + (n - 1 - p_index (n - 1) (a (n - 1))) ≠ 0 := by omega
        have h_trim := S_trim n (a (n - 1) + (n - 1 - p_index (n - 1) (a (n - 1)))) h_t_nz
