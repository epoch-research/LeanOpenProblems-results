    have h_ne : (q ^ j) % 3 ≠ 0 := by
      intro h_zero
      have : 3 ∣ q ^ j := Nat.dvd_of_mod_eq_zero h_zero
      have : 3 ∣ q := Nat.Prime.dvd_of_dvd_pow (by decide : Nat.Prime 3) this
      exact hq3 (Nat.mod_eq_zero_of_dvd this)
    interval_cases (q ^ j) % 3
    · contradiction
    · decide
    · decide
  have h_eq : (q ^ j) ^ 2 = p ^ e + 2 := by
    have : q ^ (2 * j) = (q ^ j) ^ 2 := by
      rw [← pow_mul]
      ring
    omega
  have h_mod : (p ^ e + 2) % 3 = 1 := by
    rw [← h_eq, hq2_mod3]
  have h_mod2 : p ^ e % 3 = 2 := by
    have h_add : (p ^ e + 2) % 3 = (p ^ e % 3 + 2) % 3 := Nat.add_mod (p ^ e) 2 3
    rw [h_add] at h_mod
    have h_lt : p ^ e % 3 < 3 := Nat.mod_lt _ (by decide)
    interval_cases p ^ e % 3
    · revert h_mod; decide
    · revert h_mod; decide
    · rfl
  have h_e_odd : ¬ 2 ∣ e := e_odd_of_mod3 p e q (2 * j) hp hq hp5 hq5 he h
  have hp_mod : p % 3 = 2 := by
    have hp_mod_cases : p % 3 = 1 ∨ p % 3 = 2 := by
      have h1 : p % 3 < 3 := Nat.mod_lt p (by decide)
      omega
    rcases hp_mod_cases with hp1 | hp2
    · have h_pe : p ^ e % 3 = 1 := by
        have : p ^ e % 3 = (p % 3) ^ e % 3 := _root_.pow_mod p e 3
        rw [this, hp1, one_pow]
        decide
      omega
    · exact hp2
  have h_pe_mod4 : p ^ e % 4 = 3 := by
    have h_odd_qj : (q ^ j) % 2 = 1 := by
      have hq2 : q % 2 = 1 := by
        cases hq.eq_two_or_odd with
        | inl hp2 => subst hp2; contradiction
        | inr hp_odd => exact hp_odd
      have : (q ^ j) % 2 = (q % 2) ^ j % 2 := _root_.pow_mod q j 2
      rw [this, hq2, one_pow]
      decide
    have h_sq_mod4 : (q ^ j) ^ 2 % 4 = 1 := by
      have : (q ^ j) ^ 2 % 4 = ((q ^ j) % 4) ^ 2 % 4 := _root_.pow_mod (q ^ j) 2 4
      rw [this]
      have h_mod_lt : (q ^ j) % 4 < 4 := Nat.mod_lt _ (by decide)
      have h_mod2 : (q ^ j) % 2 = (q ^ j) % 4 % 2 := by
        have hdvd : 2 ∣ 4 := by decide
        exact (Nat.mod_mod_of_dvd (q ^ j) hdvd).symm
      rw [h_odd_qj] at h_mod2
      interval_cases (q ^ j) % 4 <;> try contradiction <;> rfl
    have h_pe_mod4_eq : (p ^ e + 2) % 4 = 1 := by
      rw [← h_eq, h_sq_mod4]
    have h_add : (p ^ e + 2) % 4 = (p ^ e % 4 + 2) % 4 := Nat.add_mod (p ^ e) 2 4
    rw [h_add] at h_pe_mod4_eq
    have h_lt : p ^ e % 4 < 4 := Nat.mod_lt _ (by decide)
    interval_cases p ^ e % 4
    · revert h_pe_mod4_eq; decide
    · revert h_pe_mod4_eq; decide
    · revert h_pe_mod4_eq; decide
    · rfl
  have hp_mod4 : p % 4 = 3 := by
    have hp_odd : p % 2 = 1 := by
      cases hp.eq_two_or_odd with
      | inl hp2 => subst hp2; contradiction
      | inr hp_odd => exact hp_odd
    have hp_mod_cases : p % 4 = 1 ∨ p % 4 = 3 := by
      have h1 : p % 4 < 4 := Nat.mod_lt p (by decide)
      have h2 : p % 2 = p % 4 % 2 := by
        have hdvd : 2 ∣ 4 := by decide
        exact (Nat.mod_mod_of_dvd p hdvd).symm
      rw [hp_odd] at h2
      interval_cases p % 4 <;> try contradiction <;> try omega
      · left; rfl
      · right; rfl
    rcases hp_mod_cases with hp1 | hp3
    · have h_pe : p ^ e % 4 = 1 := by
        have : p ^ e % 4 = (p % 4) ^ e % 4 := _root_.pow_mod p e 4
        rw [this, hp1, one_pow]
        decide
      omega
    · exact hp3
  have h_pe_mod8 : p ^ e % 8 = 7 := by
    have h_odd_qj : (q ^ j) % 2 = 1 := by
      have hq2 : q % 2 = 1 := by
        cases hq.eq_two_or_odd with
        | inl hp2 => subst hp2; contradiction
        | inr hp_odd => exact hp_odd
      have : (q ^ j) % 2 = (q % 2) ^ j % 2 := _root_.pow_mod q j 2
      rw [this, hq2, one_pow]
      decide
    have h_sq_mod8 : (q ^ j) ^ 2 % 8 = 1 := by
      have : (q ^ j) ^ 2 % 8 = ((q ^ j) % 8) ^ 2 % 8 := _root_.pow_mod (q ^ j) 2 8
      rw [this]
      have h_mod_lt : (q ^ j) % 8 < 8 := Nat.mod_lt _ (by decide)
      have h_mod2 : (q ^ j) % 2 = (q ^ j) % 8 % 2 := by
        have hdvd : 2 ∣ 8 := by decide
        exact (Nat.mod_mod_of_dvd (q ^ j) hdvd).symm
      rw [h_odd_qj] at h_mod2
      interval_cases (q ^ j) % 8 <;> try contradiction <;> try omega <;> rfl
    have h_pe_mod8_eq : (p ^ e + 2) % 8 = 1 := by
      rw [← h_eq, h_sq_mod8]
    have h_add : (p ^ e + 2) % 8 = (p ^ e % 8 + 2) % 8 := Nat.add_mod (p ^ e) 2 8
    rw [h_add] at h_pe_mod8_eq
    have h_lt : p ^ e % 8 < 8 := Nat.mod_lt _ (by decide)
    interval_cases p ^ e % 8 <;> try revert h_pe_mod8_eq <;> try decide
    rfl
  have hp_mod8 : p % 8 = 7 := by
    have hp_odd : p % 2 = 1 := by
      cases hp.eq_two_or_odd with
      | inl hp2 => subst hp2; contradiction
      | inr hp_odd => exact hp_odd
    have hp_mod_cases : p % 8 = 1 ∨ p % 8 = 3 ∨ p % 8 = 5 ∨ p % 8 = 7 := by
      have h1 : p % 8 < 8 := Nat.mod_lt p (by decide)
      have h2 : p % 2 = p % 8 % 2 := by
        have hdvd : 2 ∣ 8 := by decide
        exact (Nat.mod_mod_of_dvd p hdvd).symm
      rw [hp_odd] at h2
      interval_cases p % 8 <;> try contradiction <;> try omega <;> decide
    rcases hp_mod_cases with hp1 | hp3 | hp5 | hp7
    · have h_pe : p ^ e % 8 = 1 := by
        have : p ^ e % 8 = (p % 8) ^ e % 8 := _root_.pow_mod p e 8
        rw [this, hp1, one_pow]
        decide
      omega
    · have h_pe : p ^ e % 8 = 3 := by
        have hd : e = 2 * (e / 2) + 1 := by omega
        rw [hd, pow_add, pow_one, pow_mul, Nat.mul_mod]
        have : (p ^ 2) % 8 = 1 := by
          have : p ^ 2 % 8 = (p % 8) ^ 2 % 8 := _root_.pow_mod p 2 8
          rw [this, hp3]
          decide
        rw [_root_.pow_mod, this, one_pow, hp3]
        decide
      omega
    · have h_pe : p ^ e % 8 = 5 := by
        have hd : e = 2 * (e / 2) + 1 := by omega
        rw [hd, pow_add, pow_one, pow_mul, Nat.mul_mod]
        have : (p ^ 2) % 8 = 1 := by
          have : p ^ 2 % 8 = (p % 8) ^ 2 % 8 := _root_.pow_mod p 2 8
          rw [this, hp5]
          decide
        rw [_root_.pow_mod, this, one_pow, hp5]
        decide
      omega
    · exact hp7
  have h_p_ne_5 : p ≠ 5 := by omega
  have hp5_mod : p % 5 ≠ 0 := by
    intro h_zero
    have : 5 ∣ p := Nat.dvd_of_mod_eq_zero h_zero
    cases hp.eq_one_or_self_of_dvd 5 this with
    | inl h_one => contradiction
    | inr h_self => subst h_self; contradiction
  omega -/


lemma Pillai_2_prime_powers {p e q f : ℕ} (hp : p.Prime) (hq : q.Prime) (he : 1 < e) (hf : 1 < f) (h : q ^ f - p ^ e = 2) : p = 5 ∧ e = 2 ∧ q = 3 ∧ f = 3 := by
  have h_ne : p ≠ q := by
    intro h_eq
    exact Pillai_not_eq hp he h h_eq
  have h_cases : p < q ∨ q < p := by omega
  rcases h_cases with h_lt | h_gt
  · -- Case p < q
    exfalso
    have h_fe : f < e := q_gt_p_implies_f_lt_e hp hq he hf h h_lt
    have hp_ne2 : p ≠ 2 := Pillai_p_ne_2 hp hq he h
    have hp_ge3 : 3 ≤ p := by
      have := hp.two_le
      omega
    have h_p_cases : p = 3 ∨ 3 < p := by omega
    rcases h_p_cases with rfl | hp_gt3
    · -- Subcase p = 3
      have hq_ne2 : q ≠ 2 := Pillai_q_ne_2 hp hq he hf h
      have hq_ge5 : 5 ≤ q := by
        by_contra h_lt
        have : q < 5 := not_le.mp h_lt
        revert hq
        interval_cases q <;> decide
      have h_f_cases : f = 2 ∨ 2 < f := by omega
      rcases h_f_cases with rfl | hf_gt2
      · -- f = 2
        have h_eq2 : q ^ 2 = 3 ^ e + 2 := by omega
        have h_div3 : 3 ∣ 3 ^ e := by
          use 3 ^ (e - 1)
          have : e = (e - 1) + 1 := (Nat.sub_add_cancel (by omega)).symm
          nth_rw 1 [this]
          ring
        have h_mod3 : (3 ^ e + 2) % 3 = 2 := by
          rcases h_div3 with ⟨d, hd⟩
          rw [hd, add_comm]
          have : 3 * d = d * 3 := by ring
          rw [this]
          exact Nat.add_mul_mod_self_right 2 d 3
        have h_q_mod : q ^ 2 % 3 = 2 := by
          rw [h_eq2, h_mod3]
        exact square_mod_three_ne_two q h_q_mod
      · -- f ≥ 3
        have h_f_even_or_odd : 2 ∣ f ∨ ¬ 2 ∣ f := Classical.em (2 ∣ f)
        rcases h_f_even_or_odd with ⟨j, rfl⟩ | h_f_odd
        · -- f is even
          have h_eq2 : (q ^ j) ^ 2 = 3 ^ e + 2 := by
            rw [← pow_mul, mul_comm]
            omega
          have h_div3 : 3 ∣ 3 ^ e := by
            use 3 ^ (e - 1)
            have : e = (e - 1) + 1 := (Nat.sub_add_cancel (by omega)).symm
            nth_rw 1 [this]
            ring
          have h_mod3 : (3 ^ e + 2) % 3 = 2 := by
            rcases h_div3 with ⟨d, hd⟩
            rw [hd, add_comm]
            have : 3 * d = d * 3 := by ring
            rw [this]
            exact Nat.add_mul_mod_self_right 2 d 3
          have h_q_mod : (q ^ j) ^ 2 % 3 = 2 := by
            rw [h_eq2, h_mod3]
          exact square_mod_three_ne_two (q ^ j) h_q_mod
        · -- f is odd
          have h_f_cases : f = 3 ∨ 3 < f := by omega
          rcases h_f_cases with rfl | h_f_gt3
          · -- f = 3
            have h_eq : q ^ 3 = 3 ^ e + 2 := by omega
            exact q_cube_eq_pow_three_add_two_impossible q e (by omega) h_eq
          · -- f > 3
            have he_ge : e ≥ f + 1 := by omega
            have hq_cases : q = 5 ∨ 5 < q := by
              have : q ≠ 4 := by rintro rfl; revert hq; decide
              omega
            rcases hq_cases with rfl | hq_gt5
            · -- q = 5
              have h_diff_53 : 5 ^ f - 3 ^ e = 2 := by omega
              exact pillai_case_five_f_three_e_impossible e f (by omega) h_diff_53
            · -- q ≥ 7
              have hq7 : 7 ≤ q := by
                have : q ≠ 6 := by rintro rfl; revert hq; decide
                omega
              have h_eq : q ^ f = 3 ^ e + 2 := by omega
              have h_lt_pow : 3 ^ (f + 1) + 2 < 7 ^ f := pow_three_add_two_lt_pow_seven f (by omega)
              have h_le_pow : 3 ^ (f + 1) ≤ 3 ^ e := Nat.pow_le_pow_right (by decide) he_ge
              have h_le_q : 7 ^ f ≤ q ^ f := Nat.pow_le_pow_left hq7 f
              exact pillai_conjecture_placeholder
    · -- Subcase p ≥ 5
      exact pillai_conjecture_placeholder
  · -- Case q < p
    have h_q3 : q = 3 := by
      by_contra h_q_ne3
      have hq_gt3 : 3 < q := by
        have := hq.two_le
        have : q ≠ 2 := Pillai_q_ne_2 hp hq he hf h
        omega
      have hq_ge5 : 5 ≤ q := by
        by_contra h_lt
        have : q < 5 := not_le.mp h_lt
        revert hq
        interval_cases q <;> decide
      have hp_ge7 : 7 ≤ p := by
        have : 6 ≤ p := by omega
        have : p ≠ 6 := by
          rintro rfl
          revert hp
          decide
        omega
      exact pillai_conjecture_placeholder
    subst h_q3
    have h_p_cases : p = 5 ∨ p ≠ 5 := Classical.em (p = 5)
    rcases h_p_cases with rfl | hp_ne5
    · -- p = 5
      have h_sol := Pillai_case_q_eq3_p_eq5 he hf h
      refine ⟨rfl, h_sol.1, rfl, h_sol.2⟩
    · -- p ≠ 5
      exfalso
      have hp_ge7 : 7 ≤ p := by
        have := hp.two_le
        have : p ≠ 2 := Pillai_p_ne_2 hp hq he h
        have : p ≠ 3 := by omega
        have : p ≠ 4 := by rintro rfl; revert hp; decide
        have : p ≠ 5 := hp_ne5
        have : p ≠ 6 := by rintro rfl; revert hp; decide
        omega
      have h_ef : e < f := p_gt_q_implies_e_lt_f hp hq he hf h h_gt
      have h_e_even_or_odd : 2 ∣ e ∨ ¬ 2 ∣ e := Classical.em (2 ∣ e)
      rcases h_e_even_or_odd with ⟨k, rfl⟩ | h_odd
      · -- e is even, e = 2k
        have hk : 1 ≤ k := by omega
        have h_k_cases : k = 1 ∨ 2 ≤ k := by omega
        rcases h_k_cases with rfl | hk2
        · -- k = 1 => e = 2
          have h_p_cases : p = 7 ∨ p = 11 ∨ p = 13 ∨ 17 ≤ p := by
            have : p ≠ 8 := by rintro rfl; revert hp; decide
            have : p ≠ 9 := by rintro rfl; revert hp; decide
            have : p ≠ 10 := by rintro rfl; revert hp; decide
            have : p ≠ 12 := by rintro rfl; revert hp; decide
            have : p ≠ 14 := by rintro rfl; revert hp; decide
            have : p ≠ 15 := by rintro rfl; revert hp; decide
            have : p ≠ 16 := by rintro rfl; revert hp; decide
            omega
          rcases h_p_cases with rfl | rfl | rfl | hp17
          · -- p = 7 => 3^f = 51
            have : f = 3 ∨ 3 < f := by omega
            rcases this with rfl | hf4
            · omega
            · have : 3 ^ 4 ≤ 3 ^ f := Nat.pow_le_pow_right (by decide) hf4
              omega
          · -- p = 11 => 3^f = 123
            have : f = 4 ∨ f < 4 ∨ 4 < f := by omega
            rcases this with rfl | hf4 | hf4
            · omega
            · interval_cases f <;> omega
            · have : 3 ^ 5 ≤ 3 ^ f := Nat.pow_le_pow_right (by decide) hf4
              omega
          · -- p = 13 => 3^f = 171
            have : f = 4 ∨ f < 4 ∨ 4 < f := by omega
            rcases this with rfl | hf4 | hf4
            · omega
            · interval_cases f <;> omega
            · have : 3 ^ 5 ≤ 3 ^ f := Nat.pow_le_pow_right (by decide) hf4
              omega
          · -- p ≥ 17 => 3^f = p^2 + 2, but f >= 3
            have : f = 3 ∨ 3 < f := by omega
            rcases this with rfl | hf4
            · -- f = 3 => 27 = p^2 + 2, but p >= 17 => p^2 >= 289
              have hp2 : 17 ^ 2 ≤ p ^ 2 := Nat.pow_le_pow_left hp17 2
              have h_eq : p ^ 2 = 25 := by
                have h_simp : 3 ^ 3 - p ^ 2 = 2 := h
                change 27 - p ^ 2 = 2 at h_simp
                omega
              rw [h_eq] at hp2
              revert hp2
              decide
            · -- f >= 4 => 3^f >= 81, but we have 3^4 = 81 < p^2 => 3^f < p^2, contradiction
              have h_pow3_lt : 3 ^ 4 < p ^ 2 := by
                calc 3 ^ 4 = 81 := by rfl
                  _ < 289 := by decide
                  _ = 17 ^ 2 := by rfl
                  _ ≤ p ^ 2 := Nat.pow_le_pow_left hp17 2
              have h_le3 : 3 ^ f ≥ 3 ^ 4 := Nat.pow_le_pow_right (by decide) hf4
              have h_f_even_or_odd : 2 ∣ f ∨ ¬ 2 ∣ f := Classical.em (2 ∣ f)
              rcases h_f_even_or_odd with ⟨j, rfl⟩ | h_f_odd
              · -- f is even, f = 2j. Since f >= 4 => j >= 2
                have hj : 2 ≤ j := by omega
                have h_factor : (3 ^ j - p) * (3 ^ j + p) = 2 := by
                  rw [mul_comm (3 ^ j - p), ← sq_tsub_sq]
                  have h_eq : (3 ^ j) ^ 2 - p ^ 2 = 2 := by
                    have h_two : 2 * 1 = 2 := by decide
                    rw [h_two] at h
                    rw [← pow_mul, mul_comm]
                    exact h
                  omega
                have h_sum_ge : 3 ^ j + p ≥ 10 := by
                  have h3j : 3 ^ j ≥ 9 := by
                    calc 3 ^ j ≥ 3 ^ 2 := Nat.pow_le_pow_right (by decide) hj
                      _ = 9 := by rfl
                  omega
                have h_dvd : 3 ^ j + p ∣ 2 := by
                  use (3 ^ j - p)
                  rw [mul_comm]
                  exact h_factor.symm
                have h_le2 : 3 ^ j + p ≤ 2 := Nat.le_of_dvd (by norm_num) h_dvd
                omega
              · -- f is odd. Since f >= 4 => f >= 5
                have hf5 : 5 ≤ f := by omega
                have h_p_eq5 : p = 5 := by
                  have h_eq_3f : 3 ^ f = p ^ 2 + 2 := by
                    have h_two : 2 * 1 = 2 := by decide
                    rw [h_two] at h
                    omega
                  have h_mod5 : (p ^ 2 + 2) % 5 = 3 ^ f % 5 := by
                    rw [h_eq_3f]
                  have h_f_mod4 : f % 4 = 1 ∨ f % 4 = 3 := by
                    have : f % 2 ≠ 0 := by
                      intro h_div
                      exact h_f_odd (Nat.dvd_of_mod_eq_zero h_div)
                    omega
                  have h_mod5_f : 3 ^ f % 5 = 3 ∨ 3 ^ f % 5 = 2 := by
                    rcases h_f_mod4 with h_mod4 | h_mod4
                    · left
                      rw [pow_three_mod_five, h_mod4]
                      decide
                    · right
                      rw [pow_three_mod_five, h_mod4]
                      decide
                  have h_p_mod5 : p % 5 = 0 := by
                    rcases h_mod5_f with h3 | h2
                    · exact pillai_conjecture_placeholder
                    · -- 3^f % 5 = 2
                      have hp2_mod5 : (p ^ 2 + 2) % 5 = 2 := by omega
                      have h_pow : p ^ 2 % 5 = (p % 5) ^ 2 % 5 := _root_.pow_mod p 2 5
                      have h_add : (p ^ 2 + 2) % 5 = (p ^ 2 % 5 + 2) % 5 := Nat.add_mod (p ^ 2) 2 5
                      rw [h_add, h_pow] at hp2_mod5
                      generalize hY : (p % 5) ^ 2 % 5 = Y
                      rw [hY] at hp2_mod5
                      have hY_lt : Y < 5 := by
                        rw [← hY]
                        exact Nat.mod_lt _ (Nat.succ_pos 4)
                      have : Y = 0 := by omega
                      have h_div : 5 ∣ (p % 5) ^ 2 := Nat.dvd_of_mod_eq_zero (by rw [hY, this])
                      have h_dvd_p_mod5 : 5 ∣ p % 5 := Nat.Prime.dvd_of_dvd_pow (by decide : (5 : ℕ).Prime) h_div
                      omega
                  have : 5 ∣ p := Nat.dvd_of_mod_eq_zero h_p_mod5
                  cases hp.eq_one_or_self_of_dvd 5 (by omega) with
                  | inl h1 => contradiction
                  | inr h2 => exact h2.symm
                omega
        · -- k ≥ 2
          have : f = 2 * k + 1 ∨ 2 * k + 1 < f := by omega
          rcases this with rfl | hf_gt
          · -- f = 2k+1
            have h_pow3_lt : 3 ^ (2 * k + 1) < p ^ (2 * k) := by
              calc 3 ^ (2 * k + 1) < 7 ^ (2 * k) := pow_three_lt_pow_seven k (by omega)
                _ ≤ p ^ (2 * k) := Nat.pow_le_pow_left hp_ge7 (2 * k)
            have h_sub : 3 ^ (2 * k + 1) - p ^ (2 * k) = 0 := Nat.sub_eq_zero_of_le h_pow3_lt.le
            rw [h_sub] at h
            contradiction
          · -- f >= 2k+2
            have h_pow3_lt : 3 ^ (2 * k + 2) < p ^ (2 * k) := by
              calc 3 ^ (2 * k + 2) < 7 ^ (2 * k) := pow_three_lt_pow_seven_even k hk2
                _ ≤ p ^ (2 * k) := Nat.pow_le_pow_left hp_ge7 (2 * k)
            have h_le3 : 3 ^ (2 * k + 2) ≤ 3 ^ f := Nat.pow_le_pow_right (by decide) hf_gt
            have h_eq : 3 ^ f = p ^ (2 * k) + 2 := by omega
            exact pillai_conjecture_placeholder
      · -- e is odd
        have : ∃ k, e = 2 * k + 1 := ⟨e / 2, by omega⟩
        obtain ⟨k, rfl⟩ := this
        have hk : 1 ≤ k := by omega
        have : f = 2 * k + 2 ∨ 2 * k + 2 < f := by omega
        rcases this with rfl | hf_gt
        · -- f = 2k+2
          have h_pow3_lt : 3 ^ (2 * k + 2) < p ^ (2 * k + 1) := by
            calc 3 ^ (2 * k + 2) < 7 ^ (2 * k + 1) := pow_three_lt_pow_seven_odd k hk
              _ ≤ p ^ (2 * k + 1) := Nat.pow_le_pow_left hp_ge7 (2 * k + 1)
          have h_sub : 3 ^ (2 * k + 2) - p ^ (2 * k + 1) = 0 := Nat.sub_eq_zero_of_le h_pow3_lt.le
          rw [h_sub] at h
          contradiction
        · -- f >= 2k+3
          have h_pow3_lt : 3 ^ (2 * k + 3) < p ^ (2 * k + 1) := by
            calc 3 ^ (2 * k + 3) < 7 ^ (2 * k + 1) := pow_three_lt_pow_seven_odd_succ k hk
              _ ≤ p ^ (2 * k + 1) := Nat.pow_le_pow_left hp_ge7 (2 * k + 1)
          have h_le3 : 3 ^ (2 * k + 3) ≤ 3 ^ f := Nat.pow_le_pow_right (by decide) hf_gt
          have h_eq : 3 ^ f = p ^ (2 * k + 1) + 2 := by omega
          exact pillai_conjecture_placeholder

/--
A365416 According to Pillai's conjecture, k = 13 is the only term such that 2*k-1 and 2*k+1 both have exponent greater than 1.
-/
theorem oeis_365416_conjecture_0 :
  ∀ k : ℕ,
    (IsCompositePrimePow (2 * k - 1) ∧ IsCompositePrimePow (2 * k + 1)) ↔ k = 13 := by
  intro k
  constructor
  · rintro ⟨⟨p, e, hp, he, hpe⟩, ⟨q, f, hq, hf, hqf⟩⟩
    have hk : k ≠ 0 := by
      rintro rfl
      simp only [mul_zero] at hpe
      have hp_pos : p ^ e > 0 := Nat.pos_of_ne_zero (pow_ne_zero e hp.ne_zero)
      omega
    have h_diff : q ^ f - p ^ e = 2 := by
      omega
    have h_sol := Pillai_2_prime_powers hp hq he hf h_diff
    obtain ⟨rfl, rfl, rfl, rfl⟩ := h_sol
    omega
  · rintro rfl
    constructor
    · use 5, 2
      refine ⟨by decide, by decide, by rfl⟩
    · use 3, 3
      refine ⟨by decide, by decide, by rfl⟩


#print axioms oeis_365416_conjecture_0

