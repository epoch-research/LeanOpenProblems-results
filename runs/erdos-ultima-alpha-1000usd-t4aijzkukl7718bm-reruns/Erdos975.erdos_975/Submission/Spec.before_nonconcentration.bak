import FormalConjecturesUtil

/-!
# Erdős Problem 975

*References:*
 - [erdosproblems.com/975](https://www.erdosproblems.com/975)
 - [Va39] van der Corput, J. G., Une in\'egalit\'e{} relative au nombre des diviseurs. Nederl. Akad. Wetensch., Proc. (1939), 547--553.
 - [Er52b] Erd\"os, P., On the sum {$\sum^x_{k=1} d(f(k))$}. J. London Math. Soc. (1952), 7--15.
 - [Ho63] Hooley, Christopher, On the number of divisors of a quadratic polynomial. Acta Math. (1963), 97--114.
 - [Mc95] McKee, James, On the average number of divisors of quadratic polynomials. Math. Proc. Cambridge Philos. Soc. (1995), 389--392.
 - [Mc97] McKee, James, A note on the number of divisors of quadratic polynomials. (1997), 275--281.
 - [Mc99] McKee, James, The average number of divisors of an irreducible quadratic polynomial. Math. Proc. Cambridge Philos. Soc. (1999), 17--22.
 - [T] T. Tao, Erdos' divisor bound, https://terrytao.wordpress.com/2011/07/23/erdos-divisor-bound/
-/

open Filter Real Polynomial
open scoped ArithmeticFunction.sigma Topology

namespace Erdos975

/-- Sum of $\tau(f(n))$ from `0` to `⌊x⌋` for a polynomial $f \in \mathbb{Z}[X]$.

Here $\tau$ is the divisor counting function, which is `σ 0` in mathlib.
Also, for simplicity, we use `Nat.floor` to convert rational values to natural numbers, instead of
dealing with negative values. -/
noncomputable def Erdos975Sum (f : ℤ[X]) (x : ℝ) : ℝ :=
  ∑ n ≤ ⌊x⌋₊, σ 0 ⌊f.eval ↑n⌋₊


lemma sum_X (x : ℝ) :
    Erdos975Sum X x = ∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, (⌊x⌋₊ / n : ℕ) := by
  simp only [Erdos975Sum, eval_X, Nat.floor_natCast]
  have hI : Finset.Iic ⌊x⌋₊ = insert 0 (Finset.Ioc 0 ⌊x⌋₊) := by
    ext n
    simp only [Finset.mem_Iic, Finset.mem_insert, Finset.mem_Ioc]
    omega
  rw [hI, Finset.sum_insert (by simp)]
  simp only [ArithmeticFunction.map_zero, Nat.cast_zero, zero_add]
  exact_mod_cast ArithmeticFunction.sum_Ioc_sigma0_eq_sum_div ⌊x⌋₊

lemma Ioc_zero_eq_Icc_one (N : ℕ) : Finset.Ioc 0 N = Finset.Icc 1 N := by
  ext n
  simp only [Finset.mem_Ioc, Finset.mem_Icc]
  omega

lemma sum_div_upper (N : ℕ) :
    (∑ n ∈ Finset.Ioc 0 N, (N / n : ℕ) : ℝ) ≤ N * harmonic N := by
  have hsum : (∑ n ∈ Finset.Ioc 0 N, (N : ℝ) / n) = N * harmonic N := by
    simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast,
      Finset.mul_sum, div_eq_mul_inv, Ioc_zero_eq_Icc_one]
  rw [← hsum]
  apply Finset.sum_le_sum
  intro n hn
  exact Nat.cast_div_le

lemma sum_div_lower (N : ℕ) :
    (N : ℝ) * harmonic N - N ≤ ∑ n ∈ Finset.Ioc 0 N, (N / n : ℕ) := by
  have hsum : (∑ n ∈ Finset.Ioc 0 N, ((N : ℝ) / n - 1)) = N * harmonic N - N := by
    simp only [Finset.sum_sub_distrib, harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv,
      Rat.cast_natCast, Finset.mul_sum, div_eq_mul_inv, Ioc_zero_eq_Icc_one, Finset.sum_const, nsmul_eq_mul, mul_one]
    simp
  rw [← hsum, Nat.cast_sum]
  apply Finset.sum_le_sum
  intro n hn
  rw [← Nat.floor_div_eq_div (K := ℝ)]
  exact le_of_lt (Nat.sub_one_lt_floor _)

lemma sum_X_bounds (x : ℝ) (hx : 1 ≤ x) :
    (⌊x⌋₊ : ℝ) * (log x - 1) ≤ Erdos975Sum X x ∧
    Erdos975Sum X x ≤ (⌊x⌋₊ : ℝ) * (log x + 1) := by
  rw [sum_X, Nat.cast_sum]
  constructor
  · calc
      (⌊x⌋₊ : ℝ) * (log x - 1) ≤ (⌊x⌋₊ : ℝ) * harmonic ⌊x⌋₊ - ⌊x⌋₊ := by
        have := log_le_harmonic_floor x (by linarith)
        nlinarith [Nat.cast_nonneg (α := ℝ) ⌊x⌋₊]
      _ ≤ _ := by simpa only [Nat.cast_sum] using sum_div_lower ⌊x⌋₊
  · calc
      (∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, (⌊x⌋₊ / n : ℕ) : ℝ) ≤
        (⌊x⌋₊ : ℝ) * harmonic ⌊x⌋₊ := sum_div_upper _
      _ ≤ (⌊x⌋₊ : ℝ) * (log x + 1) := by
        have := harmonic_floor_le_one_add_log x hx
        nlinarith [Nat.cast_nonneg (α := ℝ) ⌊x⌋₊]

lemma tendsto_sum_X :
    Tendsto (fun x ↦ Erdos975Sum X x / (x * log x)) atTop (𝓝 1) := by
  have hlog : Tendsto (fun x : ℝ ↦ 1 / log x) atTop (𝓝 0) :=
    Real.tendsto_log_atTop.const_div_atTop 1
  have hlo : Tendsto (fun x : ℝ ↦ (⌊x⌋₊ : ℝ) / x * (1 - 1 / log x)) atTop (𝓝 1) := by
    simpa using tendsto_nat_floor_div_atTop.mul (tendsto_const_nhds.sub hlog)
  have hhi : Tendsto (fun x : ℝ ↦ (⌊x⌋₊ : ℝ) / x * (1 + 1 / log x)) atTop (𝓝 1) := by
    simpa using tendsto_nat_floor_div_atTop.mul (tendsto_const_nhds.add hlog)
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlo hhi
  · filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    have hp : 0 < x * log x := mul_pos (by linarith) (Real.log_pos hx)
    have h := div_le_div_of_nonneg_right (sum_X_bounds x hx.le).1 hp.le
    convert h using 1
    field_simp [ne_of_gt (Real.log_pos hx)]
  · filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    have hp : 0 < x * log x := mul_pos (by linarith) (Real.log_pos hx)
    have h := div_le_div_of_nonneg_right (sum_X_bounds x hx.le).2 hp.le
    convert h using 1
    field_simp [ne_of_gt (Real.log_pos hx)]

lemma erdos_975_X :
    ∃ c > (0 : ℝ), Tendsto (fun x ↦ Erdos975Sum X x / (x * log x)) atTop (𝓝 c) :=
  ⟨1, zero_lt_one, tendsto_sum_X⟩

lemma tendsto_erdos975Sum_iff_nat (f : ℤ[X]) (c : ℝ) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun n : ℕ ↦ Erdos975Sum f n / ((n : ℝ) * log n)) atTop (𝓝 c) := by
  constructor
  · intro h
    exact h.comp tendsto_natCast_atTop_atTop
  · intro h
    have hf := Asymptotics.isEquivalent_nat_floor (R := ℝ)
    have hd := hf.mul (hf.log tendsto_id)
    have he := (Asymptotics.IsEquivalent.refl (u := Erdos975Sum f) (l := atTop)).div hd
    apply he.tendsto_nhds_iff.mp
    simpa only [Function.comp_def, Pi.div_apply, Pi.mul_apply, Erdos975Sum,
      Nat.floor_natCast] using h.comp (tendsto_nat_floor_atTop (α := ℝ))

lemma divisors_eq_filter_Icc {a M : ℕ} (haM : a ≤ M) :
    a.divisors = (Finset.Icc 1 M).filter (fun d ↦ d ∣ a ∧ a ≠ 0) := by
  ext d
  simp only [Nat.mem_divisors, Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨hd, ha⟩
    have hpos := Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero ha)
    have hle := (Nat.le_of_dvd (Nat.pos_of_ne_zero ha) hd).trans haM
    exact ⟨⟨hpos, hle⟩, hd, ha⟩
  · exact fun h ↦ h.2

lemma divisor_sum_swap (a : ℕ → ℕ) (N M : ℕ) (hM : ∀ n ≤ N, a n ≤ M) :
    ∑ n ∈ Finset.Iic N, σ 0 (a n) =
      ∑ d ∈ Finset.Icc 1 M, ((Finset.Iic N).filter (fun n ↦ d ∣ a n ∧ a n ≠ 0)).card := by
  simp only [ArithmeticFunction.sigma_zero_apply]
  calc
    ∑ n ∈ Finset.Iic N, (a n).divisors.card =
        ∑ n ∈ Finset.Iic N,
          ((Finset.Icc 1 M).filter (fun d ↦ d ∣ a n ∧ a n ≠ 0)).card := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [divisors_eq_filter_Icc (hM n (Finset.mem_Iic.mp hn))]
    _ = _ := by
      simp only [Finset.card_eq_sum_ones, Finset.sum_filter]
      exact Finset.sum_comm

lemma erdos975Sum_swap (f : ℤ[X]) (N M : ℕ)
    (hM : ∀ n ≤ N, ⌊f.eval (n : ℤ)⌋₊ ≤ M) :
    Erdos975Sum f N =
      ∑ d ∈ Finset.Icc 1 M,
        (((Finset.Iic N).filter (fun n : ℕ ↦
          d ∣ ⌊f.eval (n : ℤ)⌋₊ ∧ ⌊f.eval (n : ℤ)⌋₊ ≠ 0)).card : ℝ) := by
  simp only [Erdos975Sum, Nat.floor_natCast]
  exact_mod_cast divisor_sum_swap (fun n ↦ ⌊f.eval (n : ℤ)⌋₊) N M hM

def polynomialRootResidues (f : ℤ[X]) (d : ℕ) : Finset ℕ :=
  (Finset.range d).filter (fun r : ℕ ↦ (d : ℤ) ∣ f.eval (r : ℤ))

lemma dvd_eval_mod_iff (f : ℤ[X]) (d n : ℕ) :
    (d : ℤ) ∣ f.eval (n : ℤ) ↔ (d : ℤ) ∣ f.eval ((n % d : ℕ) : ℤ) := by
  have harg : (d : ℤ) ∣ (n : ℤ) - ((n % d : ℕ) : ℤ) := by
    simpa only [Int.natCast_emod] using (Int.mod_modEq (n : ℤ) (d : ℤ)).dvd
  exact dvd_iff_dvd_of_dvd_sub
    (harg.trans (Polynomial.sub_dvd_eval_sub (n : ℤ) ((n % d : ℕ) : ℤ) f))

lemma polynomial_root_count (f : ℤ[X]) (d N : ℕ) (hd : 0 < d) :
    ((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card =
      N / d * (polynomialRootResidues f d).card +
        ((polynomialRootResidues f d).filter (fun r ↦ r < N % d)).card := by
  have hmap : Set.MapsTo (fun n ↦ n % d)
      ((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ)))
      (polynomialRootResidues f d) := by
    intro n hn
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range,
      polynomialRootResidues] at hn ⊢
    exact ⟨Nat.mod_lt _ hd, (dvd_eval_mod_iff f d n).mp hn.2⟩
  rw [Finset.card_eq_sum_card_fiberwise hmap]
  calc
    ∑ r ∈ polynomialRootResidues f d,
        (((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).filter
          (fun n ↦ n % d = r)).card =
      ∑ r ∈ polynomialRootResidues f d,
        ((Finset.range N).filter (fun n ↦ n ≡ r [MOD d])).card := by
      apply Finset.sum_congr rfl
      intro r hr
      have hr' := Finset.mem_filter.mp hr
      have hrd : r < d := Finset.mem_range.mp hr'.1
      congr 1
      ext n
      simp only [Finset.mem_filter, Finset.mem_range, Nat.ModEq,
        Nat.mod_eq_of_lt hrd]
      constructor
      · exact fun h ↦ ⟨h.1.1, h.2⟩
      · rintro ⟨hn, hmod⟩
        exact ⟨⟨hn, (dvd_eval_mod_iff f d n).mpr (hmod.symm ▸ hr'.2)⟩, hmod⟩
    _ = ∑ r ∈ polynomialRootResidues f d,
        (N / d + if r < N % d then 1 else 0) := by
      apply Finset.sum_congr rfl
      intro r hr
      rw [← Nat.count_eq_card_filter_range, Nat.count_modEq_card N hd,
        Nat.mod_eq_of_lt (Finset.mem_range.mp (Finset.mem_filter.mp hr).1)]
    _ = _ := by
      simp only [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul,
        ← Finset.sum_filter, Nat.cast_id, mul_one]
      rw [Nat.mul_comm]

lemma polynomial_root_count_error (f : ℤ[X]) (d N : ℕ) (hd : 0 < d) :
    |(((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ) -
      (N : ℝ) / d * (polynomialRootResidues f d).card| ≤
        (polynomialRootResidues f d).card := by
  rw [polynomial_root_count f d N hd, Nat.cast_add, Nat.cast_mul, abs_le]
  have hq : ((N / d : ℕ) : ℝ) ≤ (N : ℝ) / d := Nat.cast_div_le
  have hq' : (N : ℝ) / d - 1 ≤ ((N / d : ℕ) : ℝ) := by
    simpa only [Nat.floor_div_eq_div] using (Nat.sub_one_lt_floor ((N : ℝ) / d)).le
  have hr : (((polynomialRootResidues f d).filter (fun r ↦ r < N % d)).card : ℝ) ≤
      (polynomialRootResidues f d).card := by
    exact_mod_cast Finset.card_filter_le (polynomialRootResidues f d) _
  have hρ : (0 : ℝ) ≤ (polynomialRootResidues f d).card := by positivity
  have hr0 : (0 : ℝ) ≤ ((polynomialRootResidues f d).filter (fun r ↦ r < N % d)).card := by
    positivity
  constructor <;> nlinarith

lemma truncated_divisor_count_error (f : ℤ[X]) (D N : ℕ) :
    |(∑ d ∈ Finset.Icc 1 D,
        (((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ)) -
      (N : ℝ) * ∑ d ∈ Finset.Icc 1 D, (polynomialRootResidues f d).card / (d : ℝ)| ≤
        ∑ d ∈ Finset.Icc 1 D, ((polynomialRootResidues f d).card : ℝ) := by
  rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
  calc
    |∑ d ∈ Finset.Icc 1 D,
        ((((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ) -
          (N : ℝ) * ((polynomialRootResidues f d).card / d))| ≤
      ∑ d ∈ Finset.Icc 1 D,
        |(((Finset.range N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ) -
          (N : ℝ) * ((polynomialRootResidues f d).card / d)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ _ := by
      apply Finset.sum_le_sum
      intro d hd
      have hd' : 0 < d := (Finset.mem_Icc.mp hd).1
      simpa only [div_mul_eq_mul_div, mul_div_assoc] using polynomial_root_count_error f d N hd'


lemma sigma_zero_hyperbola (m : ℕ) :
    σ 0 m + (m.divisors.filter (fun d ↦ d ^ 2 = m)).card =
      2 * (m.divisors.filter (fun d ↦ d ≤ m.sqrt)).card := by
  let L := m.divisors.filter (fun d ↦ d ≤ m / d)
  let U := m.divisors.filter (fun d ↦ m / d ≤ d)
  have hcard : U.card = L.card := by
    simp only [U, L, Finset.card_eq_sum_ones, Finset.sum_filter]
    calc
      ∑ d ∈ m.divisors, (if m / d ≤ d then 1 else 0) =
          ∑ d ∈ m.divisors, (if m / d ≤ m / (m / d) then 1 else 0) := by
        apply Finset.sum_congr rfl
        intro d hd
        rw [Nat.div_div_self (Nat.dvd_of_mem_divisors hd) (Nat.ne_zero_of_mem_divisors hd)]
      _ = _ := Nat.sum_div_divisors m (fun d ↦ if d ≤ m / d then 1 else 0)
  have hunion : L ∪ U = m.divisors := by
    ext d
    simp only [L, U, Finset.mem_union, Finset.mem_filter]
    have := le_total d (m / d)
    tauto
  have hinter : L ∩ U = m.divisors.filter (fun d ↦ d ^ 2 = m) := by
    ext d
    simp only [L, U, Finset.mem_inter, Finset.mem_filter]
    constructor
    · rintro ⟨⟨hd, hle⟩, _, hge⟩
      have hmul := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hd)
      refine ⟨hd, ?_⟩
      nlinarith
    · rintro ⟨hd, hs⟩
      have hmul := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hd)
      have hp := Nat.pos_of_mem_divisors hd
      have heq : d = m / d := by nlinarith
      exact ⟨⟨hd, heq.le⟩, hd, heq.ge⟩
  have hsmall : L = m.divisors.filter (fun d ↦ d ≤ m.sqrt) := by
    ext d
    simp only [L, Finset.mem_filter]
    constructor
    · rintro ⟨hd, hle⟩
      refine ⟨hd, Nat.le_sqrt.mpr ?_⟩
      exact (Nat.le_div_iff_mul_le (Nat.pos_of_mem_divisors hd)).mp hle
    · rintro ⟨hd, hle⟩
      refine ⟨hd, (Nat.le_div_iff_mul_le (Nat.pos_of_mem_divisors hd)).mpr ?_⟩
      exact Nat.le_sqrt.mp hle
  have hc := Finset.card_union_add_card_inter L U
  rw [hunion, hinter, hcard, hsmall] at hc
  simpa only [ArithmeticFunction.sigma_zero_apply, two_mul] using hc

lemma card_square_divisors_le_one (m : ℕ) :
    (m.divisors.filter (fun d ↦ d ^ 2 = m)).card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro a ha b hb
  have ha' := (Finset.mem_filter.mp ha).2
  have hb' := (Finset.mem_filter.mp hb).2
  nlinarith

lemma sigma_zero_hyperbola_bounds (m : ℕ) :
    2 * (m.divisors.filter (fun d ↦ d ≤ m.sqrt)).card ≤ σ 0 m + 1 ∧
    σ 0 m ≤ 2 * (m.divisors.filter (fun d ↦ d ≤ m.sqrt)).card := by
  have he := sigma_zero_hyperbola m
  have hsmall := card_square_divisors_le_one m
  omega


noncomputable def Erdos975SmallDivisorSum (f : ℤ[X]) (x : ℝ) : ℝ :=
  ∑ n ≤ ⌊x⌋₊, (((⌊f.eval (n : ℤ)⌋₊).divisors.filter
    (fun d ↦ d ≤ (⌊f.eval (n : ℤ)⌋₊).sqrt)).card : ℝ)

noncomputable def Erdos975SquareCorrection (f : ℤ[X]) (x : ℝ) : ℝ :=
  ∑ n ≤ ⌊x⌋₊, (((⌊f.eval (n : ℤ)⌋₊).divisors.filter
    (fun d ↦ d ^ 2 = ⌊f.eval (n : ℤ)⌋₊)).card : ℝ)

lemma erdos975Sum_hyperbola (f : ℤ[X]) (x : ℝ) :
    Erdos975Sum f x + Erdos975SquareCorrection f x = 2 * Erdos975SmallDivisorSum f x := by
  simp only [Erdos975Sum, Erdos975SquareCorrection, Erdos975SmallDivisorSum,
    ← Finset.sum_add_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  exact_mod_cast sigma_zero_hyperbola ⌊f.eval (n : ℤ)⌋₊

lemma squareCorrection_bounds (f : ℤ[X]) (x : ℝ) :
    0 ≤ Erdos975SquareCorrection f x ∧ Erdos975SquareCorrection f x ≤ ⌊x⌋₊ + 1 := by
  constructor
  · exact Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)
  · calc
      Erdos975SquareCorrection f x ≤ ∑ n ∈ Finset.Iic ⌊x⌋₊, (1 : ℝ) := by
        apply Finset.sum_le_sum
        intro n hn
        exact_mod_cast card_square_divisors_le_one ⌊f.eval (n : ℤ)⌋₊
      _ = _ := by simp

lemma tendsto_squareCorrection (f : ℤ[X]) :
    Tendsto (fun x ↦ Erdos975SquareCorrection f x / (x * log x)) atTop (𝓝 0) := by
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds
    (Real.tendsto_log_atTop.const_div_atTop 2)
  · filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    exact div_nonneg (squareCorrection_bounds f x).1
      (mul_nonneg (by linarith) (Real.log_pos hx).le)
  · filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    have h0 : 0 < x := by linarith
    have hl : 0 < log x := Real.log_pos hx
    calc
      Erdos975SquareCorrection f x / (x * log x) ≤ (2 * x) / (x * log x) := by
        apply div_le_div_of_nonneg_right _ (mul_pos h0 hl).le
        have hc := (squareCorrection_bounds f x).2
        have hf := Nat.floor_le h0.le
        linarith
      _ = 2 / log x := by field_simp

lemma tendsto_erdos975Sum_iff_small (f : ℤ[X]) (c : ℝ) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun x ↦ Erdos975SmallDivisorSum f x / (x * log x)) atTop (𝓝 (c / 2)) := by
  constructor
  · intro h
    have ht := (h.add (tendsto_squareCorrection f)).div_const 2
    simp only [add_zero] at ht
    apply ht.congr
    intro x
    have he := erdos975Sum_hyperbola f x
    rw [← add_div, he]
    ring
  · intro h
    have ht := (h.const_mul 2).sub (tendsto_squareCorrection f)
    have hc : 2 * (c / 2) - 0 = c := by ring
    rw [hc] at ht
    apply ht.congr
    intro x
    have he := congrArg (fun y : ℝ ↦ y / (x * log x)) (erdos975Sum_hyperbola f x)
    simp only [add_div, mul_div_assoc] at he
    linarith

lemma small_divisors_eq_filter_Icc (m D : ℕ) (hD : m.sqrt ≤ D) :
    m.divisors.filter (fun d ↦ d ≤ m.sqrt) =
      (Finset.Icc 1 D).filter (fun d ↦ d ∣ m ∧ d ^ 2 ≤ m ∧ m ≠ 0) := by
  ext d
  simp only [Finset.mem_filter, Nat.mem_divisors, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨hd, hm⟩, hs⟩
    have hp := Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero hm)
    exact ⟨⟨hp, hs.trans hD⟩, hd, Nat.le_sqrt'.mp hs, hm⟩
  · rintro ⟨_, hd, hs, hm⟩
    exact ⟨⟨hd, hm⟩, Nat.le_sqrt'.mpr hs⟩

lemma smallDivisorSum_swap (f : ℤ[X]) (N D : ℕ)
    (hD : ∀ n ≤ N, (⌊f.eval (n : ℤ)⌋₊).sqrt ≤ D) :
    Erdos975SmallDivisorSum f N =
      ∑ d ∈ Finset.Icc 1 D,
        (((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ ⌊f.eval (n : ℤ)⌋₊ ∧
          d ^ 2 ≤ ⌊f.eval (n : ℤ)⌋₊ ∧ ⌊f.eval (n : ℤ)⌋₊ ≠ 0)).card : ℝ) := by
  simp only [Erdos975SmallDivisorSum, Nat.floor_natCast]
  calc
    ∑ n ∈ Finset.Iic N,
        (((⌊f.eval (n : ℤ)⌋₊).divisors.filter
          (fun d ↦ d ≤ (⌊f.eval (n : ℤ)⌋₊).sqrt)).card : ℝ) =
      ∑ n ∈ Finset.Iic N,
        (((Finset.Icc 1 D).filter (fun d ↦ d ∣ ⌊f.eval (n : ℤ)⌋₊ ∧
          d ^ 2 ≤ ⌊f.eval (n : ℤ)⌋₊ ∧ ⌊f.eval (n : ℤ)⌋₊ ≠ 0)).card : ℝ) := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [small_divisors_eq_filter_Icc _ D (hD n (Finset.mem_Iic.mp hn))]
    _ = _ := by
      simp only [Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
      exact Finset.sum_comm

lemma small_divisor_floor_iff (z : ℤ) (d : ℕ) (hd : 0 < d) :
    (d ∣ ⌊z⌋₊ ∧ d ^ 2 ≤ ⌊z⌋₊ ∧ ⌊z⌋₊ ≠ 0) ↔ ((d : ℤ) ∣ z ∧ (d : ℤ) ^ 2 ≤ z) := by
  by_cases hz : 0 ≤ z
  · lift z to ℕ using hz
    simp only [Nat.floor_natCast, Int.natCast_dvd_natCast, ← Nat.cast_pow, Nat.cast_le]
    constructor
    · exact fun h ↦ ⟨h.1, h.2.1⟩
    · intro h
      refine ⟨h.1, h.2, ?_⟩
      have := pow_pos hd 2
      omega
  · have hz' : z < 0 := lt_of_not_ge hz
    rw [Nat.floor_of_nonpos hz'.le]
    constructor
    · intro h
      exact False.elim (h.2.2 rfl)
    · intro h
      have := sq_nonneg (d : ℤ)
      omega

lemma smallDivisorSum_swap_int (f : ℤ[X]) (N D : ℕ)
    (hD : ∀ n ≤ N, (⌊f.eval (n : ℤ)⌋₊).sqrt ≤ D) :
    Erdos975SmallDivisorSum f N =
      ∑ d ∈ Finset.Icc 1 D,
        (((Finset.Iic N).filter (fun n : ℕ ↦
          (d : ℤ) ∣ f.eval (n : ℤ) ∧ (d : ℤ) ^ 2 ≤ f.eval (n : ℤ))).card : ℝ) := by
  rw [smallDivisorSum_swap f N D hD]
  apply Finset.sum_congr rfl
  intro d hd
  congr 2
  apply Finset.filter_congr
  intro n hn
  exact small_divisor_floor_iff (f.eval (n : ℤ)) d (Finset.mem_Icc.mp hd).1



lemma periodic_zero_sum_range (u : ℕ → ℝ) (a : ℕ) (hu : Function.Periodic u a)
    (hzero : ∑ i ∈ Finset.range a, u i = 0) (N : ℕ) :
    ∑ i ∈ Finset.range N, u i = ∑ i ∈ Finset.range (N % a), u i := by
  have hblock : ∀ q : ℕ, ∑ i ∈ Finset.range (q * a), u i = 0 := by
    intro q
    induction q with
    | zero => simp
    | succ q ih =>
      rw [Nat.succ_mul, Finset.sum_range_add, ih]
      have hshift : ∀ i, u (q * a + i) = u i := by
        intro i
        simpa only [Nat.cast_id, Nat.add_comm] using hu.nat_mul q i
      simp_rw [hshift]
      exact zero_add _ |>.trans hzero
  have hN : N / a * a + N % a = N := by
    simpa only [Nat.add_comm] using Nat.mod_add_div' N a
  calc
    ∑ i ∈ Finset.range N, u i =
        ∑ i ∈ Finset.range (N / a * a + N % a), u i := by rw [hN]
    _ = (∑ i ∈ Finset.range (N / a * a), u i) +
        ∑ i ∈ Finset.range (N % a), u (N / a * a + i) := Finset.sum_range_add ..
    _ = ∑ i ∈ Finset.range (N % a), u i := by
      rw [hblock, zero_add]
      apply Finset.sum_congr rfl
      intro i hi
      simpa only [Nat.cast_id, Nat.add_comm] using hu.nat_mul (N / a) i

lemma periodic_zero_sum_bound (u : ℕ → ℝ) (a : ℕ) (ha : 0 < a)
    (hu : Function.Periodic u a) (hzero : ∑ i ∈ Finset.range a, u i = 0) (N : ℕ) :
    ‖∑ i ∈ Finset.range N, u i‖ ≤ ∑ i ∈ Finset.range a, ‖u i‖ := by
  rw [periodic_zero_sum_range u a hu hzero N]
  calc
    ‖∑ i ∈ Finset.range (N % a), u i‖ ≤
        ∑ i ∈ Finset.range (N % a), ‖u i‖ := norm_sum_le ..
    _ ≤ ∑ i ∈ Finset.range a, ‖u i‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.range_mono (Nat.mod_lt N ha).le) (fun i _ _ ↦ norm_nonneg (u i))

lemma tendsto_harmonic_div_log :
    Tendsto (fun N : ℕ ↦ (harmonic N : ℝ) / log N) atTop (𝓝 1) := by
  have ht := (Real.tendsto_harmonic_sub_log.div_atTop
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)).add_const 1
  simp only [zero_add, Function.comp_def] at ht
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN
  have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN)
  field_simp
  ring

lemma periodic_harmonic_limit (u : ℕ → ℝ) (a : ℕ) (ha : 0 < a)
    (hu : Function.Periodic u a) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.range N, u (n + 1) / (n + 1 : ℝ)) / log N)
      atTop (𝓝 ((∑ n ∈ Finset.range a, u (n + 1)) / a)) := by
  let c : ℝ := (∑ n ∈ Finset.range a, u (n + 1)) / a
  let z : ℕ → ℝ := fun n ↦ u (n + 1) - c
  have hzper : Function.Periodic z a := by
    intro n
    change u (n + a + 1) - c = u (n + 1) - c
    rw [show n + a + 1 = (n + 1) + a by omega, hu (n + 1)]
  have hzsum : ∑ n ∈ Finset.range a, z n = 0 := by
    simp only [z, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    dsimp [c]
    field_simp
    ring
  have hanti : Antitone (fun n : ℕ ↦ (n + 1 : ℝ)⁻¹) := by
    intro n m hnm
    apply inv_anti₀ (by positivity)
    exact_mod_cast Nat.add_le_add_right hnm 1
  have hlim : Tendsto (fun n : ℕ ↦ (n + 1 : ℝ)⁻¹) atTop (𝓝 0) := by
    apply tendsto_inv_atTop_zero.comp
    exact tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds
  obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete
    (hanti.cauchySeq_series_mul_of_tendsto_zero_of_bounded hlim
      (periodic_zero_sum_bound z a ha hzper hzsum))
  have hL' : Tendsto (fun N : ℕ ↦
      (∑ n ∈ Finset.range N, u (n + 1) / (n + 1 : ℝ)) - c * harmonic N)
      atTop (𝓝 L) := by
    apply hL.congr
    intro N
    simp only [smul_eq_mul, z, mul_sub, Finset.sum_sub_distrib, Finset.mul_sum,
      harmonic, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast, Nat.cast_add, Nat.cast_one,
      Rat.cast_add, Rat.cast_one]
    simp only [div_eq_mul_inv, mul_comm]
  have ht := (hL'.div_atTop (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)).add
    (tendsto_harmonic_div_log.const_mul c)
  simp only [zero_add, mul_one, Function.comp_def] at ht
  apply ht.congr
  intro N
  ring

lemma sum_Icc_one_eq_sum_range_succ (g : ℕ → ℝ) (N : ℕ) :
    (∑ n ∈ Finset.Icc 1 N, g n) = ∑ n ∈ Finset.range N, g (n + 1) := by
  rw [Finset.range_eq_Ico, Finset.sum_Ico_add' g 0 N (c := 1)]
  simp only [Nat.zero_add, Finset.Ico_add_one_right_eq_Icc]

lemma coprime_harmonic_limit (a : ℕ) (ha : 0 < a) :
    ∃ c > (0 : ℝ), Tendsto
      (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N, if a.Coprime d then (1 : ℝ) / d else 0) / log N)
      atTop (𝓝 c) := by
  let u : ℕ → ℝ := fun d ↦ if a.Coprime d then 1 else 0
  let c : ℝ := (∑ n ∈ Finset.range a, u (n + 1)) / a
  have hu : Function.Periodic u a := by
    intro n
    simp only [u, Nat.coprime_add_self_right]
  have hc : 0 < c := by
    apply div_pos _ (Nat.cast_pos.mpr ha)
    apply Finset.sum_pos'
    · intro i hi
      dsimp [u]
      positivity
    · refine ⟨0, Finset.mem_range.mpr ha, ?_⟩
      simp [u]
  refine ⟨c, hc, ?_⟩
  apply (periodic_harmonic_limit u a ha hu).congr
  intro N
  rw [sum_Icc_one_eq_sum_range_succ]
  congr 1
  apply Finset.sum_congr rfl
  intro n hn
  dsimp [u]
  split_ifs <;> simp

lemma linear_root_card (a b d : ℕ) (hab : a.Coprime b) (hd : 0 < d) :
    ((Finset.range d).filter (fun r ↦ d ∣ a * r + b)).card =
      if a.Coprime d then 1 else 0 := by
  haveI : NeZero d := ⟨hd.ne'⟩
  by_cases had : a.Coprime d
  · rw [if_pos had]
    let r : ZMod d := -((a : ZMod d)⁻¹ * b)
    have hsol : (a : ZMod d) * r + b = 0 := by
      dsimp [r]
      rw [mul_neg, ← mul_assoc, ZMod.coe_mul_inv_eq_one a had]
      simp
    have heq : ∀ n : ℕ, d ∣ a * n + b ↔ (a : ZMod d) * n + b = 0 := by
      intro n
      rw [← Nat.cast_mul, ← Nat.cast_add, ZMod.natCast_eq_zero_iff]
    have hset : (Finset.range d).filter (fun n ↦ d ∣ a * n + b) = {r.val} := by
      ext n
      simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_singleton]
      constructor
      · rintro ⟨hn, hdiv⟩
        have hmul : (a : ZMod d) * n = (a : ZMod d) * r :=
          add_right_cancel ((heq n).mp hdiv |>.trans hsol.symm)
        have hnZ : (n : ZMod d) = r :=
          (ZMod.isUnit_iff_coprime a d |>.mpr had).mul_right_injective hmul
        have hmod : n ≡ r.val [MOD d] :=
          (ZMod.natCast_eq_natCast_iff n r.val d).mp (hnZ.trans (ZMod.natCast_zmod_val r).symm)
        exact hmod.eq_of_lt_of_lt hn (ZMod.val_lt r)
      · rintro rfl
        exact ⟨ZMod.val_lt r, (heq r.val).mpr (by simpa using hsol)⟩
    simp [hset]
  · rw [if_neg had]
    apply Finset.card_eq_zero.mpr
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro r hr
    have hdiv := (Finset.mem_filter.mp hr).2
    have hg : a.gcd d ∣ a * r + b := (Nat.gcd_dvd_right a d).trans hdiv
    have hgb : a.gcd d ∣ b :=
      (Nat.dvd_add_right (dvd_mul_of_dvd_left (Nat.gcd_dvd_left a d) r)).mp hg
    exact had (Nat.eq_one_of_dvd_coprimes hab (Nat.gcd_dvd_left a d) hgb)


lemma sigma_zero_fixed_hyperbola (m D : ℕ) (hD : m.sqrt ≤ D) :
    σ 0 m + (m.divisors.filter (fun d ↦ d ≤ D ∧ m / d ≤ D)).card =
      2 * (m.divisors.filter (fun d ↦ d ≤ D)).card := by
  let L := m.divisors.filter (fun d ↦ d ≤ D)
  let U := m.divisors.filter (fun d ↦ m / d ≤ D)
  have hcard : U.card = L.card := by
    simp only [U, L, Finset.card_eq_sum_ones, Finset.sum_filter]
    exact Nat.sum_div_divisors m (fun d ↦ if d ≤ D then 1 else 0)
  have hunion : L ∪ U = m.divisors := by
    ext d
    simp only [L, U, Finset.mem_union, Finset.mem_filter]
    constructor
    · rintro (h | h) <;> exact h.1
    · intro hd
      have hm := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hd)
      rcases Nat.le_sqrt_of_eq_mul hm.symm with h | h
      · exact Or.inl ⟨hd, h.trans hD⟩
      · exact Or.inr ⟨hd, h.trans hD⟩
  have hinter : L ∩ U = m.divisors.filter (fun d ↦ d ≤ D ∧ m / d ≤ D) := by
    ext d
    simp only [L, U, Finset.mem_inter, Finset.mem_filter]
    tauto
  have hc := Finset.card_union_add_card_inter L U
  rw [hunion, hinter, hcard] at hc
  simpa only [ArithmeticFunction.sigma_zero_apply, L, two_mul] using hc

lemma card_divisors_both_le (m D : ℕ) :
    (m.divisors.filter (fun d ↦ d ≤ D ∧ m / d ≤ D)).card =
      (((Finset.Icc 1 D) ×ˢ (Finset.Icc 1 D)).filter (fun p : ℕ × ℕ ↦ p.1 * p.2 = m)).card := by
  have hset : (((Finset.Icc 1 D) ×ˢ (Finset.Icc 1 D)).filter
      (fun p : ℕ × ℕ ↦ p.1 * p.2 = m)) =
      m.divisorsAntidiagonal.filter (fun p ↦ p.1 ≤ D ∧ p.2 ≤ D) := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_Icc,
      Nat.mem_divisorsAntidiagonal]
    constructor
    · rintro ⟨⟨⟨h1, h1D⟩, ⟨h2, h2D⟩⟩, he⟩
      refine ⟨⟨he, ?_⟩, h1D, h2D⟩
      have hp1 : 0 < p.1 := by omega
      have hp2 : 0 < p.2 := by omega
      have := Nat.mul_pos hp1 hp2
      omega
    · rintro ⟨⟨he, hm⟩, h1D, h2D⟩
      have hprod : p.1 ≠ 0 ∧ p.2 ≠ 0 := mul_ne_zero_iff.mp (he ▸ hm)
      exact ⟨⟨⟨Nat.pos_of_ne_zero hprod.1, h1D⟩, ⟨Nat.pos_of_ne_zero hprod.2, h2D⟩⟩, he⟩
  rw [hset, ← Nat.map_div_right_divisors, Finset.filter_map, Finset.card_map]
  rfl

lemma sum_card_product_fibers_le (g : ℕ → ℕ) (hg : Function.Injective g)
    (s : Finset ℕ) (D : ℕ) :
    ∑ n ∈ s, ((((Finset.Icc 1 D) ×ˢ (Finset.Icc 1 D)).filter
      (fun p : ℕ × ℕ ↦ p.1 * p.2 = g n)).card) ≤ D ^ 2 := by
  simp only [Finset.card_eq_sum_ones, Finset.sum_filter]
  rw [Finset.sum_comm]
  calc
    ∑ p ∈ (Finset.Icc 1 D) ×ˢ (Finset.Icc 1 D),
        ∑ n ∈ s, (if p.1 * p.2 = g n then 1 else 0) ≤
      ∑ _p ∈ (Finset.Icc 1 D) ×ˢ (Finset.Icc 1 D), 1 := by
      apply Finset.sum_le_sum
      intro p hp
      rw [← Finset.sum_filter, ← Finset.card_eq_sum_ones]
      apply Finset.card_le_one.mpr
      intro n hn k hk
      apply hg
      exact (Finset.mem_filter.mp hn).2.symm.trans (Finset.mem_filter.mp hk).2
    _ = _ := by simp [pow_two]

lemma divisors_filter_le_eq (m D : ℕ) (hm : m ≠ 0) :
    m.divisors.filter (fun d ↦ d ≤ D) = (Finset.Icc 1 D).filter (fun d ↦ d ∣ m) := by
  ext d
  simp only [Finset.mem_filter, Nat.mem_divisors, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨hd, _⟩, hD⟩
    exact ⟨⟨Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero hm), hD⟩, hd⟩
  · exact fun h ↦ ⟨⟨h.2, hm⟩, h.1.2⟩

lemma sum_sigma_fixed_hyperbola_bounds (g : ℕ → ℕ) (hg : Function.Injective g)
    (s : Finset ℕ) (D : ℕ) (hpos : ∀ n ∈ s, g n ≠ 0)
    (hD : ∀ n ∈ s, (g n).sqrt ≤ D) :
    (∑ n ∈ s, σ 0 (g n)) ≤
        2 * ∑ d ∈ Finset.Icc 1 D, (s.filter (fun n ↦ d ∣ g n)).card ∧
    2 * (∑ d ∈ Finset.Icc 1 D, (s.filter (fun n ↦ d ∣ g n)).card) ≤
        (∑ n ∈ s, σ 0 (g n)) + D ^ 2 := by
  have he : (∑ n ∈ s, σ 0 (g n)) +
      (∑ n ∈ s, ((g n).divisors.filter (fun d ↦ d ≤ D ∧ g n / d ≤ D)).card) =
      2 * ∑ d ∈ Finset.Icc 1 D, (s.filter (fun n ↦ d ∣ g n)).card := by
    rw [← Finset.sum_add_distrib]
    calc
      ∑ n ∈ s, (σ 0 (g n) + ((g n).divisors.filter (fun d ↦ d ≤ D ∧ g n / d ≤ D)).card) =
          ∑ n ∈ s, 2 * ((g n).divisors.filter (fun d ↦ d ≤ D)).card := by
        apply Finset.sum_congr rfl
        exact fun n hn ↦ sigma_zero_fixed_hyperbola (g n) D (hD n hn)
      _ = 2 * ∑ d ∈ Finset.Icc 1 D, (s.filter (fun n ↦ d ∣ g n)).card := by
        rw [← Finset.mul_sum]
        congr 1
        calc
          ∑ n ∈ s, ((g n).divisors.filter (fun d ↦ d ≤ D)).card =
              ∑ n ∈ s, ((Finset.Icc 1 D).filter (fun d ↦ d ∣ g n)).card := by
            apply Finset.sum_congr rfl
            intro n hn
            rw [divisors_filter_le_eq _ D (hpos n hn)]
          _ = _ := by
            simp only [Finset.card_eq_sum_ones, Finset.sum_filter]
            exact Finset.sum_comm
  have hb : (∑ n ∈ s, ((g n).divisors.filter (fun d ↦ d ≤ D ∧ g n / d ≤ D)).card) ≤ D ^ 2 := by
    simp only [card_divisors_both_le]
    exact sum_card_product_fibers_le g hg s D
  omega


noncomputable def linearPolynomial (a b : ℕ) : ℤ[X] := C (a : ℤ) * X + C (b : ℤ)

lemma eval_linearPolynomial (a b n : ℕ) :
    (linearPolynomial a b).eval (n : ℤ) = (a * n + b : ℕ) := by
  simp [linearPolynomial]

lemma root_card_linearPolynomial (a b d : ℕ) (hab : a.Coprime b) (hd : 0 < d) :
    (polynomialRootResidues (linearPolynomial a b) d).card = if a.Coprime d then 1 else 0 := by
  simp only [polynomialRootResidues, eval_linearPolynomial, Int.natCast_dvd_natCast]
  exact linear_root_card a b d hab hd

noncomputable def linearHarmonic (a D : ℕ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D, if a.Coprime d then (1 : ℝ) / d else 0

noncomputable def linearTruncatedSum (a b N D : ℕ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D,
    (((Finset.Iic N).filter (fun n ↦ d ∣ a * n + b)).card : ℝ)

lemma linear_truncated_error (a b N D : ℕ) (hab : a.Coprime b) :
    |linearTruncatedSum a b N D - (N + 1 : ℝ) * linearHarmonic a D| ≤ D := by
  have hρ : (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootResidues (linearPolynomial a b) d).card / (d : ℝ)) =
      linearHarmonic a D := by
    apply Finset.sum_congr rfl
    intro d hd
    rw [root_card_linearPolynomial a b d hab (Finset.mem_Icc.mp hd).1]
    split_ifs <;> simp
  have hρb : (∑ d ∈ Finset.Icc 1 D,
      ((polynomialRootResidues (linearPolynomial a b) d).card : ℝ)) ≤ D := by
    calc
      _ ≤ ∑ _d ∈ Finset.Icc 1 D, (1 : ℝ) := by
        apply Finset.sum_le_sum
        intro d hd
        rw [root_card_linearPolynomial a b d hab (Finset.mem_Icc.mp hd).1]
        split_ifs <;> norm_num
      _ = _ := by simp
  have h := (truncated_divisor_count_error (linearPolynomial a b) D (N + 1)).trans hρb
  rw [hρ] at h
  have hI : Finset.range (N + 1) = Finset.Iic N := by
    ext n
    simp
  simp only [hI, eval_linearPolynomial, Int.natCast_dvd_natCast] at h
  simpa only [Nat.cast_add, Nat.cast_one, linearTruncatedSum] using h

lemma sum_linearPolynomial (a b N : ℕ) :
    Erdos975Sum (linearPolynomial a b) N =
      ∑ n ∈ Finset.Iic N, (σ 0 (a * n + b) : ℝ) := by
  simp only [Erdos975Sum, Nat.floor_natCast, eval_linearPolynomial]

lemma linear_divisor_approx (a b N : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) :
    |Erdos975Sum (linearPolynomial a b) N -
      2 * (N + 1 : ℝ) * linearHarmonic a (a * N + b).sqrt| ≤ 3 * (a * N + b : ℕ) := by
  let D := (a * N + b).sqrt
  have hinj : Function.Injective (fun n ↦ a * n + b) := by
    intro n m h
    exact mul_left_cancel₀ ha.ne' (add_right_cancel h)
  have hpos : ∀ n ∈ Finset.Iic N, a * n + b ≠ 0 := by
    intro n hn
    omega
  have hD : ∀ n ∈ Finset.Iic N, (a * n + b).sqrt ≤ D := by
    intro n hn
    apply Nat.sqrt_le_sqrt
    exact Nat.add_le_add_right (Nat.mul_le_mul_left a (Finset.mem_Iic.mp hn)) b
  have hs := sum_sigma_fixed_hyperbola_bounds (fun n ↦ a * n + b) hinj (Finset.Iic N) D hpos hD
  have hs1 : Erdos975Sum (linearPolynomial a b) N ≤ 2 * linearTruncatedSum a b N D := by
    rw [sum_linearPolynomial]
    simp only [linearTruncatedSum]
    exact_mod_cast hs.1
  have hs2 : 2 * linearTruncatedSum a b N D ≤
      Erdos975Sum (linearPolynomial a b) N + (D : ℝ) ^ 2 := by
    rw [sum_linearPolynomial]
    simp only [linearTruncatedSum]
    exact_mod_cast hs.2
  have he := linear_truncated_error a b N D hab
  rw [abs_le] at he ⊢
  have hDsq : (D : ℝ) ^ 2 ≤ (a * N + b : ℕ) := by
    exact_mod_cast Nat.sqrt_le' (a * N + b)
  have hDle : (D : ℝ) ≤ (a * N + b : ℕ) := by
    exact_mod_cast Nat.sqrt_le_self (a * N + b)
  constructor <;> dsimp only [D] at * <;> nlinarith

lemma tendsto_linear_nat_value (a b : ℕ) (ha : 0 < a) :
    Tendsto (fun N : ℕ ↦ (a * N + b : ℕ) : ℕ → ℝ) atTop atTop := by
  have haR : (0 : ℝ) < a := Nat.cast_pos.mpr ha
  have h : Tendsto (fun N : ℕ ↦ (a : ℝ) * N + b) atTop atTop :=
    (tendsto_natCast_atTop_atTop.const_mul_atTop haR).atTop_add tendsto_const_nhds
  simpa only [Nat.cast_add, Nat.cast_mul] using h

lemma tendsto_sqrt_linear_nat_value (a b : ℕ) (ha : 0 < a) :
    Tendsto (fun N : ℕ ↦ (a * N + b).sqrt) atTop atTop := by
  have h := (tendsto_nat_floor_atTop (α := ℝ)).comp
    (Real.tendsto_sqrt_atTop.comp (tendsto_linear_nat_value a b ha))
  simpa only [Function.comp_def, Real.nat_floor_real_sqrt_eq_nat_sqrt] using h

lemma tendsto_log_linear_nat_value (a b : ℕ) (ha : 0 < a) :
    Tendsto (fun N : ℕ ↦ log (a * N + b : ℕ) / log N) atTop (𝓝 1) := by
  have hN : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hq : Tendsto (fun N : ℕ ↦ (a * N + b : ℕ) / (N : ℝ)) atTop (𝓝 (a : ℝ)) := by
    have ht : Tendsto (fun N : ℕ ↦ (a : ℝ) + b / N) atTop (𝓝 ((a : ℝ) + 0)) :=
      tendsto_const_nhds.add (hN.const_div_atTop (b : ℝ))
    simp only [add_zero] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
    push_cast
    field_simp
  have haR : (0 : ℝ) < a := Nat.cast_pos.mpr ha
  have ht := ((hq.log haR.ne').div_atTop (Real.tendsto_log_atTop.comp hN)).add_const 1
  simp only [zero_add, Function.comp_def] at ht
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN1
  have hN0 : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hM0 : (0 : ℝ) < (a * N + b : ℕ) := by
    exact_mod_cast Nat.add_pos_left (Nat.mul_pos ha (by omega)) b
  have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN1)
  rw [Real.log_div hM0.ne' hN0.ne']
  field_simp
  ring

lemma tendsto_log_sqrt_linear_nat_value (a b : ℕ) (ha : 0 < a) :
    Tendsto (fun N : ℕ ↦ log ((a * N + b).sqrt : ℝ) / log N) atTop (𝓝 (1 / 2 : ℝ)) := by
  have hM := tendsto_linear_nat_value a b ha
  have hs := Real.tendsto_sqrt_atTop.comp hM
  have he := Asymptotics.isEquivalent_nat_floor (R := ℝ) |>.comp_tendsto hs
  have he' := he.log hs
  have he'' := he'.div (Asymptotics.IsEquivalent.refl (u := fun N : ℕ ↦ log (N : ℝ)))
  simp only [Function.comp_def, Real.nat_floor_real_sqrt_eq_nat_sqrt] at he''
  apply he''.tendsto_nhds_iff.mpr
  apply ((tendsto_log_linear_nat_value a b ha).div_const 2).congr
  intro N
  change _ = log (Real.sqrt (a * N + b : ℕ)) / log (N : ℝ)
  rw [Real.log_sqrt (Nat.cast_nonneg _)]
  ring

lemma tendsto_linear_divisor_error (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) :
    Tendsto (fun N : ℕ ↦
      (Erdos975Sum (linearPolynomial a b) N -
        2 * (N + 1 : ℝ) * linearHarmonic a (a * N + b).sqrt) / ((N : ℝ) * log N))
      atTop (𝓝 0) := by
  have hlog := Real.tendsto_log_atTop.comp
    (tendsto_natCast_atTop_atTop : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop)
  apply squeeze_zero_norm' _ (hlog.const_div_atTop (3 * (a + b : ℕ)))
  filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN
  have hN0 : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN)
  have hp : 0 < (N : ℝ) * log N := mul_pos hN0 hl
  rw [Real.norm_eq_abs, abs_div, abs_of_pos hp]
  have hM : (a * N + b : ℕ) ≤ (a + b) * N := by
    have := Nat.le_mul_of_pos_right b (show 0 < N by omega)
    nlinarith
  calc
    _ ≤ (3 * (a * N + b : ℕ)) / ((N : ℝ) * log N) :=
      div_le_div_of_nonneg_right (linear_divisor_approx a b N ha hb hab) hp.le
    _ ≤ (3 * ((a + b : ℕ) * N)) / ((N : ℝ) * log N) := by
      apply div_le_div_of_nonneg_right _ hp.le
      have hM' : ((a * N + b : ℕ) : ℝ) ≤ ((a + b : ℕ) : ℝ) * N := by exact_mod_cast hM
      linarith
    _ = (3 * (a + b : ℕ)) / log N := by field_simp

lemma erdos975_linear_nat (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) :
    ∃ c > (0 : ℝ),
      Tendsto (fun x ↦ Erdos975Sum (linearPolynomial a b) x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨c, hc, hH⟩ := coprime_harmonic_limit a ha
  change Tendsto (fun N : ℕ ↦ linearHarmonic a N / log N) atTop (𝓝 c) at hH
  have hD := tendsto_sqrt_linear_nat_value a b ha
  have hprod := (hH.comp hD).mul (tendsto_log_sqrt_linear_nat_value a b ha)
  have hH' : Tendsto (fun N : ℕ ↦ linearHarmonic a (a * N + b).sqrt / log N)
      atTop (𝓝 (c / 2)) := by
    have hc' : c * (1 / 2) = c / 2 := by ring
    rw [hc'] at hprod
    apply hprod.congr'
    filter_upwards [hD.eventually_gt_atTop 1] with N hDN
    have hl : 0 < log ((a * N + b).sqrt : ℝ) := Real.log_pos (by exact_mod_cast hDN)
    dsimp only [Function.comp_def]
    field_simp
  have hpref : Tendsto (fun N : ℕ ↦ (N + 1 : ℝ) / N) atTop (𝓝 1) := by
    have ht := (tendsto_natCast_atTop_atTop : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop).const_div_atTop 1
    have ht' := ht.const_add 1
    norm_num only [add_zero] at ht'
    apply ht'.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
    field_simp
  have hmain : Tendsto (fun N : ℕ ↦
      (2 * (N + 1 : ℝ) * linearHarmonic a (a * N + b).sqrt) / ((N : ℝ) * log N))
      atTop (𝓝 c) := by
    have ht := (hpref.const_mul 2).mul hH'
    have hc' : 2 * 1 * (c / 2) = c := by ring
    rw [hc'] at ht
    apply ht.congr
    intro N
    simp only [div_eq_mul_inv, mul_inv_rev]
    ring
  refine ⟨c, hc, (tendsto_erdos975Sum_iff_nat (linearPolynomial a b) c).mpr ?_⟩
  have ht := (tendsto_linear_divisor_error a b ha hb hab).add hmain
  simp only [zero_add] at ht
  apply ht.congr
  intro N
  ring

lemma erdos975Sum_nat_range (f : ℤ[X]) (N : ℕ) :
    Erdos975Sum f N = ∑ n ∈ Finset.range (N + 1), (σ 0 ⌊f.eval (n : ℤ)⌋₊ : ℝ) := by
  simp only [Erdos975Sum, Nat.floor_natCast]
  congr 1
  ext n
  simp

lemma erdos975Sum_shift_nat (f : ℤ[X]) (k N : ℕ) :
    Erdos975Sum f (N + k : ℕ) =
      Erdos975Sum (f.comp (X + C (k : ℤ))) N +
        ∑ n ∈ Finset.range k, (σ 0 ⌊f.eval (n : ℤ)⌋₊ : ℝ) := by
  simp only [erdos975Sum_nat_range, eval_comp, eval_add, eval_X, eval_C]
  have h := Finset.sum_range_add (fun n : ℕ ↦ (σ 0 ⌊f.eval (n : ℤ)⌋₊ : ℝ)) k (N + 1)
  simpa only [Nat.cast_add, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc,
    Int.add_comm, add_comm] using h

lemma erdos975_shift_iff (f : ℤ[X]) (k : ℕ) (c : ℝ) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun x ↦ Erdos975Sum (f.comp (X + C (k : ℤ))) x / (x * log x)) atTop (𝓝 c) := by
  rw [tendsto_erdos975Sum_iff_nat, tendsto_erdos975Sum_iff_nat]
  let P : ℝ := ∑ n ∈ Finset.range k, (σ 0 ⌊f.eval (n : ℤ)⌋₊ : ℝ)
  have hN : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hlogN := Real.tendsto_log_atTop.comp hN
  have hquot : Tendsto (fun N : ℕ ↦ (N + k : ℕ) / (N : ℝ)) atTop (𝓝 1) := by
    have ht := (hN.const_div_atTop (k : ℝ)).const_add 1
    simp only [add_zero] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
    push_cast
    field_simp
  have he : Asymptotics.IsEquivalent atTop
      (fun N : ℕ ↦ ((N + k : ℕ) : ℝ)) (fun N : ℕ ↦ (N : ℝ)) :=
    (Asymptotics.isEquivalent_iff_tendsto_one (hN.eventually_ne_atTop 0)).mpr hquot
  have hd := he.mul (he.log hN)
  have hr := (Asymptotics.IsEquivalent.refl (u := fun N : ℕ ↦ Erdos975Sum f (N + k : ℕ))).div hd
  have hz : Tendsto (fun N : ℕ ↦ P / ((N : ℝ) * log N)) atTop (𝓝 0) := by
    have ht := (hN.const_div_atTop P).div_atTop hlogN
    simpa only [Function.comp_def, div_div] using ht
  have heq : ∀ N : ℕ, Erdos975Sum f (N + k : ℕ) / ((N : ℝ) * log N) =
      Erdos975Sum (f.comp (X + C (k : ℤ))) N / ((N : ℝ) * log N) + P / ((N : ℝ) * log N) := by
    intro N
    rw [erdos975Sum_shift_nat, add_div]
  constructor
  · intro h
    have ht := hr.tendsto_nhds_iff.mp (h.comp (tendsto_add_atTop_nat k))
    have ht' := ht.sub hz
    simp only [sub_zero] at ht'
    apply ht'.congr
    intro N
    change Erdos975Sum f (N + k : ℕ) / ((N : ℝ) * log N) - P / ((N : ℝ) * log N) = _
    rw [heq]
    ring
  · intro h
    have ht := h.add hz
    simp only [add_zero] at ht
    have ht' : Tendsto (fun N : ℕ ↦ Erdos975Sum f (N + k : ℕ) / ((N : ℝ) * log N)) atTop (𝓝 c) :=
      ht.congr (fun N ↦ (heq N).symm)
    exact (tendsto_add_atTop_iff_nat k).mp (hr.tendsto_nhds_iff.mpr ht')

lemma linear_coprime_of_irreducible (a b : ℕ) (ha : 0 < a)
    (hirr : Irreducible (linearPolynomial a b)) : a.Coprime b := by
  have hdeg : (linearPolynomial a b).natDegree = 1 :=
    Polynomial.natDegree_eq_one.mpr ⟨(a : ℤ), by exact_mod_cast ha.ne', (b : ℤ), rfl⟩
  have hCdvd : C ((a.gcd b : ℕ) : ℤ) ∣ linearPolynomial a b := by
    change C ((a.gcd b : ℕ) : ℤ) ∣ C (a : ℤ) * X + C (b : ℤ)
    apply dvd_add
    · apply dvd_mul_of_dvd_left
      exact map_dvd C (show ((a.gcd b : ℕ) : ℤ) ∣ (a : ℤ) by exact_mod_cast Nat.gcd_dvd_left a b)
    · exact map_dvd C (show ((a.gcd b : ℕ) : ℤ) ∣ (b : ℤ) by exact_mod_cast Nat.gcd_dvd_right a b)
  have hu := hirr.isPrimitive (by omega) ((a.gcd b : ℕ) : ℤ) hCdvd
  simpa only [Int.natAbs_natCast] using Int.isUnit_iff_natAbs_eq.mp hu

lemma linear_slope_pos (a b : ℤ) (ha : a ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ a * n + b) : 0 < a := by
  by_contra h
  have ha' : a ≤ -1 := by omega
  obtain ⟨n, hn, hn1, hnb⟩ :=
    (hpos.and ((eventually_ge_atTop (1 : ℤ)).and (eventually_ge_atTop (b + 1)))).exists
  have hmul := mul_le_mul_of_nonneg_right ha' (show 0 ≤ n by omega)
  linarith

lemma erdos975_degree_one (f : ℤ[X]) (hdeg : f.natDegree = 1) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ c > (0 : ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨a, ha, b, rfl⟩ := Polynomial.natDegree_eq_one.mp hdeg
  have hpos' : ∀ᶠ n : ℤ in atTop, 1 ≤ a * n + b := by
    simpa only [eval_add, eval_mul, eval_C, eval_X] using hpos
  have haP := linear_slope_pos a b ha hpos'
  lift a to ℕ using haP.le
  have haNat : 0 < a := by exact_mod_cast haP
  have hposNat : ∀ᶠ k : ℕ in atTop, 1 ≤ (a : ℤ) * k + b :=
    (tendsto_natCast_atTop_atTop : Tendsto (fun k : ℕ ↦ (k : ℤ)) atTop atTop).eventually hpos'
  obtain ⟨k, hk⟩ := hposNat.exists
  let B := ((a : ℤ) * k + b).toNat
  have hB : (B : ℤ) = (a : ℤ) * k + b := Int.toNat_of_nonneg (by omega)
  have hBP : 0 < B := by
    have h : (0 : ℤ) < (B : ℤ) := by rw [hB]; omega
    exact_mod_cast h
  have hshift : (C (a : ℤ) * X + C b).comp (X + C (k : ℤ)) = linearPolynomial a B := by
    simp only [linearPolynomial, add_comp, mul_comp, C_comp, X_comp, hB, map_add, map_mul]
    ring
  have hirshift : Irreducible ((C (a : ℤ) * X + C b).comp (X + C (k : ℤ))) := by
    simpa only [Polynomial.coe_taylorEquiv, Polynomial.taylor_apply] using
      (Irreducible.map (Polynomial.taylorEquiv (k : ℤ)) hirr)
  rw [hshift] at hirshift
  have hab := linear_coprime_of_irreducible a B haNat hirshift
  obtain ⟨c, hc, hlim⟩ := erdos975_linear_nat a B haNat hBP hab
  refine ⟨c, hc, (erdos975_shift_iff (C (a : ℤ) * X + C b) k c).mpr ?_⟩
  simpa only [hshift] using hlim


abbrev ModularRoot (f : ℤ[X]) (d : ℕ) :=
  {x : ZMod d // f.eval₂ (Int.castRingHom (ZMod d)) x = 0}

lemma eval_mod_natCast (f : ℤ[X]) (d n : ℕ) :
    f.eval₂ (Int.castRingHom (ZMod d)) (n : ZMod d) = ((f.eval (n : ℤ) : ℤ) : ZMod d) := by
  simpa only [Int.coe_castRingHom, Int.cast_natCast] using
    Polynomial.eval₂_at_apply (p := f) (Int.castRingHom (ZMod d)) (n : ℤ)

lemma dvd_eval_iff_eval_mod (f : ℤ[X]) (d n : ℕ) :
    (d : ℤ) ∣ f.eval (n : ℤ) ↔ f.eval₂ (Int.castRingHom (ZMod d)) (n : ZMod d) = 0 := by
  rw [eval_mod_natCast, ZMod.intCast_zmod_eq_zero_iff_dvd]

noncomputable def polynomialRootResiduesEquiv (f : ℤ[X]) (d : ℕ) [NeZero d] :
    ↥(polynomialRootResidues f d) ≃ ModularRoot f d where
  toFun r := ⟨(r.val : ZMod d),
    (dvd_eval_iff_eval_mod f d r.val).mp (Finset.mem_filter.mp r.property).2⟩
  invFun x := ⟨x.val.val, Finset.mem_filter.mpr
    ⟨Finset.mem_range.mpr (ZMod.val_lt x.val),
      (dvd_eval_iff_eval_mod f d x.val.val).mpr (by simpa using x.property)⟩⟩
  left_inv r := Subtype.ext (ZMod.val_natCast_of_lt (Finset.mem_range.mp (Finset.mem_filter.mp r.property).1))
  right_inv x := Subtype.ext (ZMod.natCast_zmod_val x.val)

lemma rootResidues_card_eq_modularRoot (f : ℤ[X]) (d : ℕ) [NeZero d] :
    (polynomialRootResidues f d).card = Nat.card (ModularRoot f d) := by
  simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using
    Nat.card_congr (polynomialRootResiduesEquiv f d)

lemma hom_eval₂_int {R S : Type*} [Ring R] [Ring S] (g : R →+* S) (f : ℤ[X]) (x : R) :
    g (f.eval₂ (Int.castRingHom R) x) = f.eval₂ (Int.castRingHom S) (g x) := by
  rw [Polynomial.hom_eval₂, RingHom.ext_int (g.comp (Int.castRingHom R)) (Int.castRingHom S)]

noncomputable def modularRootMulEquiv (f : ℤ[X]) (m n : ℕ) (hmn : m.Coprime n) :
    ModularRoot f (m * n) ≃ ModularRoot f m × ModularRoot f n := by
  let e := ZMod.chineseRemainder hmn
  refine (Equiv.subtypeEquiv e.toEquiv ?_).trans Equiv.subtypeProdEquivProd
  intro x
  change f.eval₂ (Int.castRingHom (ZMod (m * n))) x = 0 ↔
    f.eval₂ (Int.castRingHom (ZMod m)) (e x).1 = 0 ∧
    f.eval₂ (Int.castRingHom (ZMod n)) (e x).2 = 0
  rw [← e.map_eq_zero_iff, Prod.ext_iff]
  have h1 := hom_eval₂_int ((RingHom.fst (ZMod m) (ZMod n)).comp e.toRingHom) f x
  have h2 := hom_eval₂_int ((RingHom.snd (ZMod m) (ZMod n)).comp e.toRingHom) f x
  change (e (f.eval₂ (Int.castRingHom (ZMod (m * n))) x)).1 =
    f.eval₂ (Int.castRingHom (ZMod m)) (e x).1 at h1
  change (e (f.eval₂ (Int.castRingHom (ZMod (m * n))) x)).2 =
    f.eval₂ (Int.castRingHom (ZMod n)) (e x).2 at h2
  rw [h1, h2]
  rfl

lemma rootResidues_card_mul (f : ℤ[X]) (m n : ℕ) [NeZero m] [NeZero n] (hmn : m.Coprime n) :
    (polynomialRootResidues f (m * n)).card =
      (polynomialRootResidues f m).card * (polynomialRootResidues f n).card := by
  rw [rootResidues_card_eq_modularRoot, rootResidues_card_eq_modularRoot,
    rootResidues_card_eq_modularRoot]
  simpa only [Nat.card_prod] using Nat.card_congr (modularRootMulEquiv f m n hmn)

noncomputable def polynomialRootCount (f : ℤ[X]) : ArithmeticFunction ℕ where
  toFun d := (polynomialRootResidues f d).card
  map_zero' := by simp [polynomialRootResidues]

lemma polynomialRootCount_multiplicative (f : ℤ[X]) : (polynomialRootCount f).IsMultiplicative := by
  rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
  constructor
  · simp [polynomialRootCount, polynomialRootResidues]
  · intro m n hm hn hmn
    haveI : NeZero m := ⟨hm⟩
    haveI : NeZero n := ⟨hn⟩
    exact rootResidues_card_mul f m n hmn

lemma cyclic_sq_eq_involution_iff {G : Type*} [Group G] [Fintype G] [IsCyclic G]
    (a : G) (ha : a ^ 2 = 1) (ha1 : a ≠ 1) (x : G) : x ^ 2 = a ↔ orderOf x = 4 := by
  classical
  have ht : (Finset.univ.filter fun y : G ↦ y ^ 2 = 1) = ({1, a} : Finset G) := by
    symm
    apply Finset.eq_of_subset_of_card_le
    · intro y hy
      simp only [Finset.mem_insert, Finset.mem_singleton] at hy
      rcases hy with rfl | rfl <;> simp [ha]
    · rw [Finset.card_pair ha1.symm]
      exact IsCyclic.card_pow_eq_one_le (by norm_num)
  constructor
  · intro hx
    apply orderOf_eq_prime_pow (p := 2) (n := 1)
    · simpa [hx] using ha1
    · change x ^ (2 * 2) = 1
      rw [pow_mul, hx, ha]
  · intro hx
    have hs : (x ^ 2) ^ 2 = 1 := by
      rw [← pow_mul]
      simpa [hx] using pow_orderOf_eq_one x
    have hn : x ^ 2 ≠ 1 := by
      intro h
      have hd := orderOf_dvd_of_pow_eq_one h
      rw [hx] at hd
      norm_num at hd
    have hm : x ^ 2 ∈ ({1, a} : Finset G) := by
      rw [← ht]
      simpa using hs
    simpa [hn] using hm

lemma cyclic_card_sq_eq_involution {G : Type*} [Group G] [Fintype G] [IsCyclic G]
    (a : G) (ha : a ^ 2 = 1) (ha1 : a ≠ 1) :
    Nat.card {x : G // x ^ 2 = a} = if 4 ∣ Nat.card G then 2 else 0 := by
  classical
  simp only [Nat.card_eq_fintype_card, Fintype.card_subtype,
    cyclic_sq_eq_involution_iff a ha ha1]
  split_ifs with h
  · simpa using (IsCyclic.card_orderOf_eq_totient (α := G) h)
  · have he : (Finset.univ.filter fun x : G ↦ orderOf x = 4) = (∅ : Finset G) := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro x hx
      have ho : orderOf x = 4 := by simpa using hx
      exact h (ho ▸ orderOf_dvd_card (x := x))
    rw [he, Finset.card_empty]

noncomputable def sqrtNegOneUnitsEquiv (R : Type*) [CommRing R] :
    {x : R // x ^ 2 = -1} ≃ {u : Rˣ // u ^ 2 = -1} where
  toFun x := ⟨Units.mkOfMulEqOne x.val (-x.val) (by rw [mul_neg, ← pow_two, x.property]; simp), by
    apply Units.ext
    simpa using x.property⟩
  invFun u := ⟨u.val.val, by simpa using congrArg Units.val u.property⟩
  left_inv x := rfl
  right_inv u := by apply Subtype.ext; apply Units.ext; rfl

lemma card_sqrt_neg_one_of_cyclic (R : Type*) [CommRing R] [Fintype Rˣ] [IsCyclic Rˣ]
    (h : (-1 : R) ≠ 1) :
    Nat.card {x : R // x ^ 2 = -1} = if 4 ∣ Nat.card Rˣ then 2 else 0 := by
  rw [Nat.card_congr (sqrtNegOneUnitsEquiv R)]
  apply cyclic_card_sq_eq_involution
  · simp
  · intro he
    exact h (congrArg Units.val he)

lemma card_sqrt_neg_one_odd_prime_pow (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (k : ℕ) :
    Nat.card {x : ZMod (p ^ (k + 1)) // x ^ 2 = -1} = if p % 4 = 1 then 2 else 0 := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  haveI : Fact (2 < p ^ (k + 1)) := ⟨lt_of_lt_of_le (by have := hp.two_le; omega)
    (Nat.le_pow (by omega))⟩
  haveI := ZMod.isCyclic_units_of_prime_pow p hp hp2 (k + 1)
  rw [card_sqrt_neg_one_of_cyclic _ ZMod.neg_one_ne_one, Nat.card_eq_fintype_card,
    ZMod.card_units_eq_totient, Nat.totient_prime_pow_succ hp]
  have ho : Odd p := Nat.odd_iff.mpr (hp.eq_two_or_odd.resolve_left hp2)
  have hc : Nat.Coprime 4 (p ^ k) := by
    exact ho.coprime_two_left.pow 2 k
  have he : 4 ∣ p - 1 ↔ p % 4 = 1 := by
    rw [Nat.dvd_iff_mod_eq_zero]
    have := hp.one_lt
    omega
  simp only [hc.dvd_mul_left, he]

lemma rootResidues_X_sq_add_one_odd_prime_pow (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (k : ℕ) :
    (polynomialRootResidues (X ^ 2 + 1) (p ^ (k + 1))).card =
      if p % 4 = 1 then 2 else 0 := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  rw [rootResidues_card_eq_modularRoot]
  simpa only [ModularRoot, eval₂_add, eval₂_pow, eval₂_X, eval₂_one, add_eq_zero_iff_eq_neg]
    using card_sqrt_neg_one_odd_prime_pow p hp hp2 k

lemma rootResidues_X_sq_add_one_two : (polynomialRootResidues (X ^ 2 + 1) 2).card = 1 := by
  norm_num [polynomialRootResidues, Finset.range_add_one, Finset.filter_insert, Finset.filter_singleton]

lemma card_sqrt_neg_one_two_pow (k : ℕ) :
    Nat.card {x : ZMod (2 ^ (k + 2)) // x ^ 2 = -1} = 0 := by
  have h4 : ∀ x : ZMod 4, x ^ 2 ≠ -1 := by decide
  have hd : 4 ∣ 2 ^ (k + 2) := by
    exact pow_dvd_pow 2 (show 2 ≤ k + 2 by omega)
  let g : ZMod (2 ^ (k + 2)) →+* ZMod 4 := ZMod.castHom hd (ZMod 4)
  haveI : IsEmpty {x : ZMod (2 ^ (k + 2)) // x ^ 2 = -1} := ⟨by
    intro x
    apply h4 (g x.val)
    simpa using congrArg g x.property⟩
  simp

lemma rootResidues_X_sq_add_one_two_pow (k : ℕ) :
    (polynomialRootResidues (X ^ 2 + 1) (2 ^ (k + 2))).card = 0 := by
  rw [rootResidues_card_eq_modularRoot]
  simpa only [ModularRoot, eval₂_add, eval₂_pow, eval₂_X, eval₂_one, add_eq_zero_iff_eq_neg]
    using card_sqrt_neg_one_two_pow k

noncomputable def chiFour : ArithmeticFunction ℤ where
  toFun n := ZMod.χ₄ (n : ZMod 4)
  map_zero' := by simp

lemma chiFour_apply (n : ℕ) : chiFour n = ZMod.χ₄ (n : ZMod 4) := rfl

lemma chiFour_multiplicative : chiFour.IsMultiplicative := by
  constructor
  · simp [chiFour]
  · intro m n _
    simp only [chiFour_apply, Nat.cast_mul, map_mul]

lemma chiFour_prime_pow (p k : ℕ) : chiFour (p ^ k) = chiFour p ^ k := by
  simp only [chiFour_apply, Nat.cast_pow, map_pow]

lemma moebius_sq_convolution_prime_pow (g : ArithmeticFunction ℤ) (p k : ℕ) (hp : p.Prime) :
    (ArithmeticFunction.moebius.ppow 2 * g) (p ^ (k + 1)) =
      g (p ^ (k + 1)) + g (p ^ k) := by
  rw [ArithmeticFunction.mul_apply, Nat.sum_divisorsAntidiagonal (fun i j ↦ ArithmeticFunction.moebius.ppow 2 i * g j), Nat.sum_divisors_prime_pow hp]
  have hs : ∑ j ∈ Finset.range (k + 1 + 1),
      ArithmeticFunction.moebius.ppow 2 (p ^ j) * g (p ^ (k + 1) / p ^ j) =
    ∑ j ∈ Finset.range 2,
      ArithmeticFunction.moebius.ppow 2 (p ^ j) * g (p ^ (k + 1) / p ^ j) := by
    symm
    apply Finset.sum_subset (Finset.range_mono (by omega))
    intro j hj hj2
    have h0 : j ≠ 0 := by simp only [Finset.mem_range] at hj2; omega
    have h1 : j ≠ 1 := by simp only [Finset.mem_range] at hj2; omega
    simp [ArithmeticFunction.ppow_apply (by norm_num : 0 < 2),
      ArithmeticFunction.moebius_apply_prime_pow hp h0, h1]
  rw [hs]
  simp [Finset.sum_range_succ, ArithmeticFunction.ppow_apply (by norm_num : 0 < 2),
    ArithmeticFunction.moebius_apply_prime hp, pow_succ, hp.ne_zero]

lemma rootCount_X_sq_add_one_convolution :
    (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℤ) =
      ArithmeticFunction.moebius.ppow 2 * chiFour := by
  apply (ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers _
    (polynomialRootCount_multiplicative _).natCast _
    (ArithmeticFunction.isMultiplicative_moebius.ppow.mul chiFour_multiplicative)).mpr
  intro p k hp
  rcases k with _ | k
  · simp [polynomialRootCount, polynomialRootResidues, chiFour]
  rw [moebius_sq_convolution_prime_pow _ _ _ hp, chiFour_prime_pow, chiFour_prime_pow]
  by_cases hp2 : p = 2
  · subst p
    have hc : chiFour 2 = 0 := by rw [chiFour_apply, ZMod.χ₄_nat_eq_if_mod_four]; norm_num
    rcases k with _ | k
    · norm_num [hc, ArithmeticFunction.natCoe_apply, polynomialRootCount,
        rootResidues_X_sq_add_one_two]
    · simp only [ArithmeticFunction.natCoe_apply]
      change ((polynomialRootResidues (X ^ 2 + 1) (2 ^ (k + 1 + 1))).card : ℤ) = _
      rw [rootResidues_X_sq_add_one_two_pow]
      simp [hc]
  · simp only [ArithmeticFunction.natCoe_apply]
    change ((polynomialRootResidues (X ^ 2 + 1) (p ^ (k + 1))).card : ℤ) = _
    rw [rootResidues_X_sq_add_one_odd_prime_pow p hp hp2]
    have hpodd : p % 2 = 1 := hp.eq_two_or_odd.resolve_left hp2
    by_cases h4 : p % 4 = 1
    · simp only [chiFour_apply, ZMod.χ₄_nat_eq_if_mod_four, hpodd, h4]
      norm_num
    · simp only [chiFour_apply, ZMod.χ₄_nat_eq_if_mod_four, hpodd, h4]
      simp [pow_succ]

noncomputable def harmonicWeightSum (u : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 N, u d / d

lemma sum_le_harmonic_split (u : ℕ → ℝ) (hu : ∀ d, 0 ≤ u d)
    (N M : ℕ) (hMN : M ≤ N) :
    (∑ d ∈ Finset.Icc 1 N, u d) ≤
      M * harmonicWeightSum u M + N * (harmonicWeightSum u N - harmonicWeightSum u M) := by
  have hsub : Finset.Icc 1 M ⊆ Finset.Icc 1 N := Finset.Icc_subset_Icc le_rfl hMN
  have hs := Finset.sum_sdiff hsub (f := fun d ↦ u d / (d : ℝ))
  have hsr := Finset.sum_sdiff hsub (f := u)
  dsimp [harmonicWeightSum]
  rw [← hsr]
  have hm : ∑ d ∈ Finset.Icc 1 M, u d ≤ M * ∑ d ∈ Finset.Icc 1 M, u d / d := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro d hd
    have hd0 : (0 : ℝ) < d := by exact_mod_cast (Finset.mem_Icc.mp hd).1
    have hdM : (d : ℝ) ≤ M := by exact_mod_cast (Finset.mem_Icc.mp hd).2
    calc
      u d = (d : ℝ) * (u d / d) := by field_simp
      _ ≤ M * (u d / d) := mul_le_mul_of_nonneg_right hdM (div_nonneg (hu d) hd0.le)
  have hn : ∑ d ∈ Finset.Icc 1 N \ Finset.Icc 1 M, u d ≤
      N * ∑ d ∈ Finset.Icc 1 N \ Finset.Icc 1 M, u d / d := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro d hd
    have hdN := Finset.mem_Icc.mp (Finset.mem_sdiff.mp hd).1
    have hd0 : (0 : ℝ) < d := by exact_mod_cast hdN.1
    have hdN' : (d : ℝ) ≤ N := by exact_mod_cast hdN.2
    calc
      u d = (d : ℝ) * (u d / d) := by field_simp
      _ ≤ N * (u d / d) := mul_le_mul_of_nonneg_right hdN' (div_nonneg (hu d) hd0.le)
  nlinarith

lemma tendsto_log_nat_floor_scaled_div_log (a : ℝ) (ha : 0 < a) :
    Tendsto (fun N : ℕ ↦ log (⌊a * N⌋₊ : ℝ) / log N) atTop (𝓝 1) := by
  have hN : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hM := hN.const_mul_atTop ha
  have he := (Asymptotics.isEquivalent_nat_floor (R := ℝ)).comp_tendsto hM
  have he' := (he.log hM).div (Asymptotics.IsEquivalent.refl (u := fun N : ℕ ↦ log (N : ℝ)))
  apply he'.tendsto_nhds_iff.mpr
  have hl := (Real.tendsto_log_atTop.comp hN).const_div_atTop (log a)
  have hl' := hl.add_const 1
  simp only [zero_add] at hl'
  apply hl'.congr'
  filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN1
  have hN0 : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlog : log (N : ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN1)).ne'
  simp only [Function.comp_def, Pi.div_apply]
  rw [Real.log_mul ha.ne' hN0.ne', add_div, div_self hlog]

lemma tendsto_harmonic_scaled (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N) atTop (𝓝 c))
    (a : ℝ) (ha : 0 < a) :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum u ⌊a * N⌋₊ / log N) atTop (𝓝 c) := by
  have hM := tendsto_nat_floor_mul_atTop a ha
  have ht := (h.comp hM).mul (tendsto_log_nat_floor_scaled_div_log a ha)
  simp only [mul_one] at ht
  apply ht.congr'
  filter_upwards [hM.eventually_gt_atTop 1] with N hMN
  have hl : log (⌊a * N⌋₊ : ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hMN)).ne'
  dsimp only [Function.comp_def]
  field_simp

lemma tendsto_sum_div_mul_log_of_harmonic (u : ℕ → ℝ) (hu : ∀ d, 0 ≤ u d) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N) atTop (𝓝 c)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N, u d) / ((N : ℝ) * log N))
      atTop (𝓝 0) := by
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  obtain ⟨k, hk⟩ := exists_nat_gt (max 1 ((|c| + 1) / ε))
  have hk1 : (1 : ℝ) < k := (le_max_left _ _).trans_lt hk
  have hk0 : (0 : ℝ) < k := lt_trans zero_lt_one hk1
  have hkε : |c| + 1 < ε * k := by
    have := (div_lt_iff₀ hε).mp ((le_max_right _ _).trans_lt hk)
    linarith
  let a : ℝ := 1 / k
  have ha : 0 < a := one_div_pos.mpr hk0
  have ha1 : a ≤ 1 := (div_le_one hk0).mpr hk1.le
  have hcε : a * c < ε := by
    dsimp [a]
    rw [one_div_mul_eq_div, div_lt_iff₀ hk0]
    linarith [le_abs_self c]
  have hB : Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N +
      (a - 1) * (harmonicWeightSum u ⌊a * N⌋₊ / log N)) atTop (𝓝 (a * c)) := by
    have ht := h.add ((tendsto_harmonic_scaled u c h a ha).const_mul (a - 1))
    have he : c + (a - 1) * c = a * c := by ring
    simpa only [he] using ht
  have hbound : ∀ᶠ N : ℕ in atTop,
      (∑ d ∈ Finset.Icc 1 N, u d) / ((N : ℝ) * log N) ≤
      harmonicWeightSum u N / log N +
      (a - 1) * (harmonicWeightSum u ⌊a * N⌋₊ / log N) := by
    filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN1
    have hN0 : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
    have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN1)
    have hM : (⌊a * N⌋₊ : ℝ) ≤ a * N := Nat.floor_le (by positivity)
    have hMN : ⌊a * N⌋₊ ≤ N := by
      exact_mod_cast hM.trans (mul_le_of_le_one_left hN0.le ha1)
    have hs := sum_le_harmonic_split u hu N ⌊a * N⌋₊ hMN
    have hH0 : 0 ≤ harmonicWeightSum u ⌊a * N⌋₊ := by
      exact Finset.sum_nonneg (fun d _ ↦ div_nonneg (hu d) (Nat.cast_nonneg d))
    apply (div_le_iff₀ (mul_pos hN0 hl)).mpr
    have he : (harmonicWeightSum u N / log N +
        (a - 1) * (harmonicWeightSum u ⌊a * N⌋₊ / log N)) * ((N : ℝ) * log N) =
        N * harmonicWeightSum u N + (a - 1) * N * harmonicWeightSum u ⌊a * N⌋₊ := by
      field_simp
    rw [he]
    nlinarith [mul_le_mul_of_nonneg_right hM hH0]
  have hsmall := hB.eventually (gt_mem_nhds hcε)
  obtain ⟨N0, hN0⟩ := eventually_atTop.mp
    (hbound.and (hsmall.and (eventually_gt_atTop (1 : ℕ))))
  refine ⟨N0, fun N hN ↦ ?_⟩
  obtain ⟨hb, hlt, hN1⟩ := hN0 N hN
  rw [Real.dist_eq, sub_zero, abs_of_nonneg]
  · exact hb.trans_lt hlt
  · apply div_nonneg (Finset.sum_nonneg (fun d _ ↦ hu d))
    exact mul_nonneg (Nat.cast_nonneg N) (Real.log_nonneg (by exact_mod_cast hN1.le))

lemma eval_X_sq_add_one_nat (n : ℕ) :
    (X ^ 2 + 1 : ℤ[X]).eval (n : ℤ) = ((n ^ 2 + 1 : ℕ) : ℤ) := by simp

lemma small_mod_count_partition_X_sq_add_one (d N : ℕ) (hd : 0 < d) (hdN : d ≤ N) :
    (((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1 ∧ d ^ 2 ≤ n ^ 2 + 1)).card : ℝ) +
      (polynomialRootResidues (X ^ 2 + 1) d).card =
    (((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1)).card : ℝ) +
      if d = 1 then 1 else 0 := by
  by_cases hd1 : d = 1
  · subst d
    simp [polynomialRootResidues]
  · have hs : ∀ n : ℕ, d ^ 2 ≤ n ^ 2 + 1 ↔ d ≤ n := by
      intro n
      constructor
      · intro h
        by_contra hdn
        have hnd : n + 1 ≤ d := by omega
        have hsq := Nat.mul_self_le_mul_self hnd
        have hd2 : 2 ≤ d := by omega
        nlinarith
      · intro hdn
        have hsq := Nat.mul_self_le_mul_self hdn
        nlinarith
    have hnot : (((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1)).filter
        (fun n ↦ ¬d ≤ n)) = polynomialRootResidues (X ^ 2 + 1) d := by
      ext n
      simp only [polynomialRootResidues, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range,
        eval_X_sq_add_one_nat, Int.natCast_dvd_natCast]
      omega
    have hc := Finset.card_filter_add_card_filter_not (s := (Finset.Iic N).filter
      (fun n : ℕ ↦ d ∣ n ^ 2 + 1)) (fun n ↦ d ≤ n)
    rw [hnot, Finset.filter_filter] at hc
    simp only [hs, if_neg hd1, add_zero]
    exact_mod_cast hc

lemma small_sum_X_sq_add_one (N : ℕ) (hN : 0 < N) :
    Erdos975SmallDivisorSum (X ^ 2 + 1) N +
      (∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues (X ^ 2 + 1) d).card : ℝ)) =
    (∑ d ∈ Finset.Icc 1 N,
      (((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1)).card : ℝ)) + 1 := by
  have hD : ∀ n ≤ N, (⌊(X ^ 2 + 1 : ℤ[X]).eval (n : ℤ)⌋₊).sqrt ≤ N := by
    intro n hn
    simp only [eval_X_sq_add_one_nat, Nat.floor_natCast]
    apply Nat.lt_succ_iff.mp
    apply Nat.sqrt_lt.mpr
    have hsq := Nat.mul_self_le_mul_self hn
    nlinarith
  rw [smallDivisorSum_swap_int _ N N hD, ← Finset.sum_add_distrib]
  have he : ∀ d : ℕ,
      (Finset.Iic N).filter (fun n : ℕ ↦
        (d : ℤ) ∣ (X ^ 2 + 1 : ℤ[X]).eval (n : ℤ) ∧
          (d : ℤ) ^ 2 ≤ (X ^ 2 + 1 : ℤ[X]).eval (n : ℤ)) =
      (Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1 ∧ d ^ 2 ≤ n ^ 2 + 1) := by
    intro d
    ext n
    simp only [Finset.mem_filter, eval_X_sq_add_one_nat, ← Nat.cast_pow,
      Int.natCast_dvd_natCast, Nat.cast_le]
  simp_rw [he]
  calc
    _ = ∑ d ∈ Finset.Icc 1 N,
        ((((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1)).card : ℝ) +
          if d = 1 then 1 else 0) := by
      apply Finset.sum_congr rfl
      intro d hd
      exact small_mod_count_partition_X_sq_add_one d N
        (Finset.mem_Icc.mp hd).1 (Finset.mem_Icc.mp hd).2
    _ = _ := by simp [Finset.sum_add_distrib, hN.ne']

lemma small_sum_X_sq_add_one_error (N : ℕ) (hN : 0 < N) :
    |Erdos975SmallDivisorSum (X ^ 2 + 1) N -
      (N + 1 : ℝ) * harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N| ≤
      2 * (∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues (X ^ 2 + 1) d).card : ℝ)) + 1 := by
  have he := truncated_divisor_count_error (X ^ 2 + 1) N (N + 1)
  have hs := small_sum_X_sq_add_one N hN
  have hI : Finset.range (N + 1) = Finset.Iic N := by ext n; simp
  simp only [hI, eval_X_sq_add_one_nat, Int.natCast_dvd_natCast] at he
  change |(∑ d ∈ Finset.Icc 1 N,
      (((Finset.Iic N).filter (fun n : ℕ ↦ d ∣ n ^ 2 + 1)).card : ℝ)) -
      (N + 1 : ℕ) * harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N| ≤ _ at he
  rw [abs_le] at he ⊢
  have hR : 0 ≤ ∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues (X ^ 2 + 1) d).card : ℝ) := by
    positivity
  push_cast at he
  constructor <;> linarith

lemma erdos975_X_sq_add_one_of_harmonic (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N / log N)
        atTop (𝓝 c)) :
    Tendsto (fun x ↦ Erdos975Sum (X ^ 2 + 1) x / (x * log x)) atTop (𝓝 (2 * c)) := by
  let u : ℕ → ℝ := fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card
  have hR := tendsto_sum_div_mul_log_of_harmonic u (fun _ ↦ Nat.cast_nonneg _) c h
  have hN : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hlog := Real.tendsto_log_atTop.comp hN
  have hz : Tendsto (fun N : ℕ ↦ 1 / ((N : ℝ) * log N)) atTop (𝓝 0) := by
    simpa only [Function.comp_def, div_div] using (hN.const_div_atTop (1 : ℝ)).div_atTop hlog
  have hErr : Tendsto (fun N : ℕ ↦
      (Erdos975SmallDivisorSum (X ^ 2 + 1) N - (N + 1 : ℝ) * harmonicWeightSum u N) /
        ((N : ℝ) * log N)) atTop (𝓝 0) := by
    have hb := (hR.const_mul 2).add hz
    simp only [mul_zero, add_zero] at hb
    apply squeeze_zero_norm' _ hb
    filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN1
    have hN0 : 0 < N := by omega
    have hden : 0 < (N : ℝ) * log N := mul_pos (Nat.cast_pos.mpr hN0)
      (Real.log_pos (by exact_mod_cast hN1))
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hden]
    calc
      _ ≤ (2 * (∑ d ∈ Finset.Icc 1 N, u d) + 1) / ((N : ℝ) * log N) :=
        div_le_div_of_nonneg_right (small_sum_X_sq_add_one_error N hN0) hden.le
      _ = _ := by ring
  have hq : Tendsto (fun N : ℕ ↦ (N + 1 : ℝ) / N) atTop (𝓝 1) := by
    have ht := (hN.const_div_atTop (1 : ℝ)).const_add 1
    simp only [add_zero] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN0
    have hNne : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN0.ne'
    field_simp
  have hMain := hq.mul h
  simp only [one_mul] at hMain
  have hsmall : Tendsto (fun N : ℕ ↦ Erdos975SmallDivisorSum (X ^ 2 + 1) N /
      ((N : ℝ) * log N)) atTop (𝓝 c) := by
    have ht := hErr.add hMain
    simp only [zero_add] at ht
    apply ht.congr
    intro N
    dsimp only [u]
    ring
  have hcorr := (tendsto_squareCorrection (X ^ 2 + 1)).comp hN
  have ht := (hsmall.const_mul 2).sub hcorr
  simp only [sub_zero] at ht
  apply (tendsto_erdos975Sum_iff_nat _ _).mpr
  apply ht.congr
  intro N
  have he := erdos975Sum_hyperbola (X ^ 2 + 1) (N : ℝ)
  dsimp only [Function.comp_def]
  rw [← mul_div_assoc, ← sub_div]
  congr 1
  linarith


open scoped ArithmeticFunction.Moebius

lemma sq_dvd_sq_mul_squarefree_iff (a b k : ℕ) (ha : Squarefree a) (hb : b ≠ 0) :
    k ^ 2 ∣ b ^ 2 * a ↔ k ∣ b := by
  constructor
  · intro h
    have hn0 : b ^ 2 * a ≠ 0 := mul_ne_zero (pow_ne_zero _ hb) ha.ne_zero
    have hk : k ≠ 0 := by intro hk; simp [hk, hn0] at h
    have hf := (Nat.factorization_le_iff_dvd (pow_ne_zero _ hk) hn0).mpr h
    apply (Nat.factorization_le_iff_dvd hk hb).mp
    intro p
    have hp := hf p
    rw [Nat.factorization_mul (pow_ne_zero _ hb) ha.ne_zero,
      Nat.factorization_pow, Nat.factorization_pow] at hp
    simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul] at hp
    have := ha.natFactorization_le_one p
    omega
  · intro h
    exact (pow_dvd_pow_of_dvd h 2).trans (dvd_mul_right _ _)

lemma moebius_square_sum (n : ℕ) (hn : 0 < n) :
    μ n ^ 2 = ∑ k ∈ (Finset.Icc 1 n.sqrt).filter (fun k ↦ k ^ 2 ∣ n), μ k := by
  obtain ⟨a, b, ha0, hb0, hba, ha⟩ := Nat.sq_mul_squarefree_of_pos hn
  have he : (Finset.Icc 1 n.sqrt).filter (fun k ↦ k ^ 2 ∣ n) = b.divisors := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_Icc, Nat.mem_divisors]
    constructor
    · rintro ⟨_, hk⟩
      exact ⟨(sq_dvd_sq_mul_squarefree_iff a b k ha hb0.ne').mp (hba ▸ hk), hb0.ne'⟩
    · rintro ⟨hk, _⟩
      have hk0 : 0 < k := Nat.pos_of_dvd_of_pos hk hb0
      have hkn : k ^ 2 ∣ n := hba ▸ (sq_dvd_sq_mul_squarefree_iff a b k ha hb0.ne').mpr hk
      exact ⟨⟨hk0, Nat.le_sqrt'.mpr (Nat.le_of_dvd hn hkn)⟩, hkn⟩
  rw [he, ← ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.moebius_mul_coe_zeta,
    ArithmeticFunction.one_apply, ArithmeticFunction.moebius_sq]
  have hbiff : Squarefree n ↔ b = 1 := by
    constructor
    · intro h
      have hb : b * b ∣ n := by rw [← hba, ← pow_two]; exact dvd_mul_right _ _
      exact Nat.isUnit_iff.mp (h b hb)
    · intro hb
      rw [← hba, hb, one_pow, one_mul]
      exact ha
  simp only [hbiff]

lemma moebius_square_sum_to_bound (N n : ℕ) (hn : 0 < n) (hnN : n ≤ N) :
    μ n ^ 2 = ∑ k ∈ Finset.Icc 1 N, if k ^ 2 ∣ n then μ k else 0 := by
  rw [← Finset.sum_filter, moebius_square_sum n hn]
  apply Finset.sum_congr
  · ext k
    simp only [Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨hk1, hks⟩, hk⟩
      exact ⟨⟨hk1, hks.trans ((Nat.sqrt_le_self n).trans hnN)⟩, hk⟩
    · rintro ⟨⟨hk1, _⟩, hk⟩
      exact ⟨⟨hk1, Nat.le_sqrt'.mpr (Nat.le_of_dvd hn hk)⟩, hk⟩
  · intro k hk; rfl

lemma sum_harmonic_multiples (q N : ℕ) (hq : 0 < q) :
    (∑ n ∈ (Finset.Icc 1 N).filter (fun n ↦ q ∣ n), (1 : ℝ) / n) =
      (harmonic (N / q) : ℝ) / q := by
  rw [harmonic_eq_sum_Icc, Rat.cast_sum, Finset.sum_div]
  symm
  apply Finset.sum_nbij (fun j ↦ q * j)
  · intro j hj
    obtain ⟨hj1, hjN⟩ := Finset.mem_Icc.mp hj
    refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by nlinarith, ?_⟩, dvd_mul_right _ _⟩
    simpa [Nat.mul_comm] using (Nat.le_div_iff_mul_le hq).mp hjN
  · intro i hi j hj hij
    exact Nat.eq_of_mul_eq_mul_left hq hij
  · intro n hn
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at hn
    obtain ⟨⟨hn1, hnN⟩, hqn⟩ := hn
    refine ⟨n / q, Finset.mem_Icc.mpr ⟨?_, Nat.div_le_div_right hnN⟩, Nat.mul_div_cancel' hqn⟩
    have hqle := Nat.le_of_dvd hn1 hqn
    exact (Nat.le_div_iff_mul_le hq).mpr (by simpa using hqle)
  · intro j hj
    simp only [Rat.cast_inv, Rat.cast_natCast, Nat.cast_mul, div_eq_mul_inv,
      mul_inv_rev, one_mul]

lemma squarefree_harmonic_expansion (N : ℕ) :
    (∑ n ∈ Finset.Icc 1 N, (μ n : ℝ) ^ 2 / n) =
      ∑ k ∈ Finset.Icc 1 N, (μ k : ℝ) / (k : ℝ) ^ 2 * harmonic (N / k ^ 2) := by
  calc
    _ = ∑ n ∈ Finset.Icc 1 N, ∑ k ∈ Finset.Icc 1 N,
        (if k ^ 2 ∣ n then (μ k : ℝ) else 0) / n := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [← Finset.sum_div]
      congr 1
      exact_mod_cast moebius_square_sum_to_bound N n (Finset.mem_Icc.mp hn).1
        (Finset.mem_Icc.mp hn).2
    _ = ∑ k ∈ Finset.Icc 1 N, ∑ n ∈ Finset.Icc 1 N,
        (if k ^ 2 ∣ n then (μ k : ℝ) else 0) / n := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro k hk
      have hk0 : 0 < k := (Finset.mem_Icc.mp hk).1
      calc
        _ = (μ k : ℝ) * ∑ n ∈ (Finset.Icc 1 N).filter (fun n ↦ k ^ 2 ∣ n), (1 : ℝ) / n := by
          rw [Finset.mul_sum, Finset.sum_filter]
          apply Finset.sum_congr rfl
          intro n hn
          split_ifs <;> simp [div_eq_mul_inv]
        _ = _ := by
          rw [sum_harmonic_multiples _ N (pow_pos hk0 2), Nat.cast_pow]
          ring

lemma harmonic_real_nonneg (N : ℕ) : (0 : ℝ) ≤ harmonic N := by
  simp only [harmonic, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
  exact Finset.sum_nonneg (fun _ _ ↦ by positivity)

lemma harmonic_real_mono : Monotone (fun N : ℕ ↦ (harmonic N : ℝ)) := by
  intro M N hMN
  simp only [harmonic, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hMN) (fun _ _ _ ↦ by positivity)

lemma tendsto_harmonic_nat_div_log (q : ℕ) (hq : 0 < q) :
    Tendsto (fun N : ℕ ↦ (harmonic (N / q) : ℝ) / log N) atTop (𝓝 1) := by
  have hD := Nat.tendsto_div_const_atTop hq.ne'
  have hl := tendsto_log_nat_floor_scaled_div_log (1 / q) (by positivity)
  simp only [one_div_mul_eq_div, Nat.floor_div_eq_div] at hl
  have ht := (tendsto_harmonic_div_log.comp hD).mul hl
  simp only [mul_one] at ht
  apply ht.congr'
  filter_upwards [hD.eventually_gt_atTop 1] with N hN
  have hlog : log ((N / q : ℕ) : ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  dsimp only [Function.comp_def]
  field_simp

lemma moebius_div_sq_norm_le (k : ℕ) : ‖(μ k : ℝ) / (k : ℝ) ^ 2‖ ≤ 1 / (k : ℝ) ^ 2 := by
  rw [Real.norm_eq_abs, abs_div, abs_of_nonneg (sq_nonneg (k : ℝ))]
  apply div_le_div_of_nonneg_right _ (sq_nonneg _)
  exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n := k)

lemma summable_moebius_div_sq : Summable (fun k : ℕ ↦ (μ k : ℝ) / (k : ℝ) ^ 2) := by
  exact (Real.summable_one_div_nat_pow.mpr (by norm_num : 1 < 2)).of_norm_bounded moebius_div_sq_norm_le

lemma tendsto_squarefree_harmonic :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.Icc 1 N, (μ n : ℝ) ^ 2 / n) / log N) atTop
      (𝓝 (∑' k : ℕ, (μ k : ℝ) / (k : ℝ) ^ 2)) := by
  let F : ℕ → ℕ → ℝ := fun N k ↦ (μ k : ℝ) / (k : ℝ) ^ 2 *
    ((harmonic (N / k ^ 2) : ℝ) / log N)
  have hs : Summable (fun k : ℕ ↦ 2 / (k : ℝ) ^ 2) := by
    simpa only [mul_one_div] using
      (Real.summable_one_div_nat_pow.mpr (by norm_num : 1 < 2)).mul_left (2 : ℝ)
  have ht := tendsto_tsum_of_dominated_convergence (𝓕 := atTop) hs
    (f := F) (g := fun k : ℕ ↦ (μ k : ℝ) / (k : ℝ) ^ 2) ?_ ?_
  · apply ht.congr
    intro N
    rw [tsum_eq_sum (s := Finset.Icc 1 N) ?_, squarefree_harmonic_expansion N, Finset.sum_div]
    · apply Finset.sum_congr rfl
      intro k hk
      dsimp [F]
      ring
    · intro k hk
      by_cases hk0 : k = 0
      · simp [F, hk0]
      · have hkN : N < k := by simp only [Finset.mem_Icc] at hk; omega
        have hq : N / k ^ 2 = 0 := Nat.div_eq_of_lt (hkN.trans_le (Nat.le_self_pow (by norm_num) k))
        simp [F, hq]
  · intro k
    by_cases hk0 : k = 0
    · simp [F, hk0]
    · simpa only [F, mul_one] using
        (tendsto_harmonic_nat_div_log (k ^ 2) (pow_pos (Nat.pos_of_ne_zero hk0) 2)).const_mul
          ((μ k : ℝ) / (k : ℝ) ^ 2)
  · filter_upwards [tendsto_harmonic_div_log.eventually (gt_mem_nhds (by norm_num : (1 : ℝ) < 2)),
        eventually_gt_atTop (1 : ℕ)] with N hNhar hN1
    intro k
    have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN1)
    have hH0 := div_nonneg (harmonic_real_nonneg (N / k ^ 2)) hl.le
    have hH2 : (harmonic (N / k ^ 2) : ℝ) / log N ≤ 2 :=
      (div_le_div_of_nonneg_right (harmonic_real_mono (Nat.div_le_self N _)) hl.le).trans hNhar.le
    calc
      ‖F N k‖ = ‖(μ k : ℝ) / (k : ℝ) ^ 2‖ * ((harmonic (N / k ^ 2) : ℝ) / log N) := by
        dsimp only [F]
        rw [norm_mul, Real.norm_of_nonneg hH0]
      _ ≤ (1 / (k : ℝ) ^ 2) * 2 := mul_le_mul (moebius_div_sq_norm_le k) hH2 hH0 (by positivity)
      _ = _ := by ring

lemma moebius_div_sq_tsum_pos : 0 < ∑' k : ℕ, (μ k : ℝ) / (k : ℝ) ^ 2 := by
  have hs := summable_moebius_div_sq
  have hs2 := hasSum_zeta_two.summable
  have htail : ‖∑' k : ℕ, (μ (k + 2) : ℝ) / ((k + 2 : ℕ) : ℝ) ^ 2‖ ≤
      ∑' k : ℕ, 1 / ((k + 2 : ℕ) : ℝ) ^ 2 := by
    have h := (summable_nat_add_iff 2).mpr hs
    exact (norm_tsum_le_tsum_norm h.norm).trans
      (h.norm.tsum_le_tsum (fun k ↦ moebius_div_sq_norm_le (k + 2)) ((summable_nat_add_iff 2).mpr hs2))
  have he := hs.sum_add_tsum_nat_add 2
  have he2 := hs2.sum_add_tsum_nat_add 2
  rw [hasSum_zeta_two.tsum_eq] at he2
  norm_num [Finset.sum_range_succ] at he he2
  simp only [Nat.cast_add, Nat.cast_ofNat, one_div] at htail
  have hpi : Real.pi ^ 2 / 6 < 2 := by nlinarith [Real.pi_pos, Real.pi_lt_d2]
  rw [Real.norm_eq_abs] at htail
  have hlo := neg_abs_le (∑' k : ℕ, (μ (k + 2) : ℝ) / ((k + 2 : ℕ) : ℝ) ^ 2)
  simp only [Nat.cast_add, Nat.cast_ofNat] at hlo
  linarith

lemma alternating_error_of_tendsto (v : ℕ → ℝ) (hv : Antitone v) (hv0 : ∀ n, 0 ≤ v n)
    (L : ℝ) (hL : Tendsto (fun N ↦ ∑ i ∈ Finset.range N, (-1 : ℝ) ^ i * v i) atTop (𝓝 L))
    (n : ℕ) : |L - (∑ i ∈ Finset.range n, (-1 : ℝ) ^ i * v i)| ≤ v n := by
  have upper := Antitone.alternating_series_le_tendsto hL hv
  have lower := Antitone.tendsto_le_alternating_series hL hv
  obtain (h | h) := Nat.even_or_odd n
  · obtain ⟨n, rfl⟩ := even_iff_exists_two_mul.mp h
    specialize upper n
    specialize lower n
    simp only [Finset.sum_range_succ, even_two, Even.mul_right, Even.neg_pow, one_pow, one_mul] at lower
    rw [abs_sub_le_iff]
    constructor
    · rwa [sub_le_iff_le_add, add_comm]
    · rw [sub_le_iff_le_add, add_comm]
      exact upper.trans (le_add_of_nonneg_right (hv0 (2 * n)))
  · obtain ⟨n, rfl⟩ := odd_iff_exists_bit1.mp h
    specialize upper (n + 1)
    specialize lower n
    rw [Nat.mul_add, Finset.sum_range_succ] at upper
    rw [abs_sub_le_iff]
    constructor
    · rw [sub_le_iff_le_add, add_comm]
      exact lower.trans (le_add_of_nonneg_right (hv0 (2 * n + 1)))
    · simpa [Finset.sum_range_succ, add_comm, pow_add] using upper

lemma chiFour_harmonic_eq_alternating (N : ℕ) :
    harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) N =
      ∑ j ∈ Finset.range ((N + 1) / 2), (-1 : ℝ) ^ j * (1 / (2 * j + 1 : ℝ)) := by
  rw [harmonicWeightSum, sum_Icc_one_eq_sum_range_succ]
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, ih]
    have hmod : (N + 1) % 2 = 0 ∨ (N + 1) % 2 = 1 := by omega
    rcases hmod with heven | hodd
    · have hc : chiFour (N + 1) = 0 := by
        rw [chiFour_apply, ZMod.χ₄_nat_eq_if_mod_four, if_pos heven]
      have hidx : (N + 1 + 1) / 2 = (N + 1) / 2 := by omega
      simp [hc, hidx]
    · have hc : (chiFour (N + 1) : ℝ) = (-1 : ℝ) ^ ((N + 1) / 2) := by
        rw [chiFour_apply, ZMod.χ₄_eq_neg_one_pow hodd]
        simp only [Int.cast_pow, Int.cast_neg, Int.cast_one]
      have hidx : (N + 1 + 1) / 2 = (N + 1) / 2 + 1 := by omega
      have hden : (2 * ((N + 1) / 2) + 1 : ℕ) = N + 1 := by omega
      rw [hidx, Finset.sum_range_succ, hc]
      congr 1
      have hdenR : (2 * ((N + 1) / 2 : ℕ) + 1 : ℝ) = (N + 1 : ℝ) := by exact_mod_cast hden
      rw [hdenR]
      push_cast
      ring

lemma chiFour_harmonic_limit_with_error :
    ∃ L > (0 : ℝ), ∀ N : ℕ,
      |harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) N - L| ≤ 1 / (N + 1 : ℝ) := by
  let v : ℕ → ℝ := fun j ↦ 1 / (2 * j + 1 : ℝ)
  have hv : Antitone v := by
    intro j k hjk
    apply one_div_le_one_div_of_le (by positivity)
    dsimp [v]
    exact_mod_cast (show 2 * j + 1 ≤ 2 * k + 1 by omega)
  have hvlim : Tendsto v atTop (𝓝 0) := by
    simp only [v, one_div]
    apply tendsto_inv_atTop_zero.comp
    exact ((tendsto_natCast_atTop_atTop : Tendsto (fun j : ℕ ↦ (j : ℝ)) atTop atTop).const_mul_atTop
      (by norm_num : (0 : ℝ) < 2)).atTop_add tendsto_const_nhds
  obtain ⟨L, hL⟩ := hv.tendsto_alternating_series_of_tendsto_zero hvlim
  have hLpos : 0 < L := by
    have hlo := Antitone.alternating_series_le_tendsto hL hv 1
    norm_num [Finset.sum_range_succ, v] at hlo
    linarith
  refine ⟨L, hLpos, fun N ↦ ?_⟩
  rw [chiFour_harmonic_eq_alternating, abs_sub_comm]
  have he := alternating_error_of_tendsto v hv (fun n ↦ by dsimp [v]; positivity) L hL ((N + 1) / 2)
  apply he.trans
  dsimp [v]
  apply one_div_le_one_div_of_le (by positivity)
  have : N + 1 ≤ 2 * ((N + 1) / 2) + 1 := by omega
  exact_mod_cast this

lemma sum_multiples_weighted (v : ℕ → ℝ) (q N : ℕ) (hq : 0 < q) :
    (∑ n ∈ (Finset.Icc 1 N).filter (fun n ↦ q ∣ n), v n) =
      ∑ j ∈ Finset.Icc 1 (N / q), v (q * j) := by
  symm
  apply Finset.sum_nbij (fun j ↦ q * j)
  · intro j hj
    obtain ⟨hj1, hjN⟩ := Finset.mem_Icc.mp hj
    refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by nlinarith, ?_⟩, dvd_mul_right _ _⟩
    simpa [Nat.mul_comm] using (Nat.le_div_iff_mul_le hq).mp hjN
  · intro i hi j hj hij
    exact Nat.eq_of_mul_eq_mul_left hq hij
  · intro n hn
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at hn
    obtain ⟨⟨hn1, hnN⟩, hqn⟩ := hn
    refine ⟨n / q, Finset.mem_Icc.mpr ⟨?_, Nat.div_le_div_right hnN⟩, Nat.mul_div_cancel' hqn⟩
    have hqle := Nat.le_of_dvd hn1 hqn
    exact (Nat.le_div_iff_mul_le hq).mpr (by simpa using hqle)
  · intro j hj; rfl

lemma harmonicWeightSum_convolution (g h : ArithmeticFunction ℝ) (N : ℕ) :
    harmonicWeightSum (g * h : ArithmeticFunction ℝ) N =
      ∑ a ∈ Finset.Icc 1 N, g a / a * harmonicWeightSum h (N / a) := by
  unfold harmonicWeightSum
  calc
    _ = ∑ n ∈ Finset.Icc 1 N, ∑ a ∈ Finset.Icc 1 N,
        if a ∣ n then g a * h (n / a) / n else 0 := by
      apply Finset.sum_congr rfl
      intro n hn
      obtain ⟨hn1, hnN⟩ := Finset.mem_Icc.mp hn
      have hdiv : n.divisors = (Finset.Icc 1 N).filter (fun a ↦ a ∣ n) := by
        ext a
        simp only [Nat.mem_divisors, Finset.mem_filter, Finset.mem_Icc]
        constructor
        · rintro ⟨ha, _⟩
          exact ⟨⟨Nat.pos_of_dvd_of_pos ha hn1, (Nat.le_of_dvd hn1 ha).trans hnN⟩, ha⟩
        · exact fun ha ↦ ⟨ha.2, by omega⟩
      rw [ArithmeticFunction.mul_apply, Nat.sum_divisorsAntidiagonal (fun a b ↦ g a * h b),
        Finset.sum_div, hdiv, Finset.sum_filter]
    _ = ∑ a ∈ Finset.Icc 1 N, ∑ n ∈ Finset.Icc 1 N,
        if a ∣ n then g a * h (n / a) / n else 0 := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro a ha
      have ha0 : 0 < a := (Finset.mem_Icc.mp ha).1
      rw [← Finset.sum_filter, sum_multiples_weighted _ a N ha0, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro b hb
      simp only [Nat.mul_div_cancel_left b ha0, Nat.cast_mul]
      ring

lemma root_harmonic_X_sq_add_one_expansion (N : ℕ) :
    harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N =
      ∑ a ∈ Finset.Icc 1 N, (μ a : ℝ) ^ 2 / a *
        harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) (N / a) := by
  let g : ArithmeticFunction ℝ := ArithmeticFunction.moebius.ppow 2
  let h : ArithmeticFunction ℝ := chiFour
  have hg : ∀ a, g a = (μ a : ℝ) ^ 2 := by
    intro a
    simp only [g, ArithmeticFunction.intCoe_apply, ArithmeticFunction.ppow_apply (by norm_num : 0 < 2),
      Int.cast_pow]
  have he : ∀ a, (g * h) a = ((polynomialRootResidues (X ^ 2 + 1) a).card : ℝ) := by
    intro a
    have hc := congrArg (fun t : ArithmeticFunction ℤ ↦ t a) rootCount_X_sq_add_one_convolution
    have hcast := congrArg (fun z : ℤ ↦ (z : ℝ)) hc
    simp only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk,
      Int.cast_natCast] at hcast
    have hmul : g * h = ((ArithmeticFunction.moebius.ppow 2 * chiFour : ArithmeticFunction ℤ) :
      ArithmeticFunction ℝ) := by rw [ArithmeticFunction.intCoe_mul]
    rw [hmul, ArithmeticFunction.intCoe_apply]
    exact hcast.symm
  rw [show (fun d ↦ ((polynomialRootResidues (X ^ 2 + 1) d).card : ℝ)) = ((g * h : ArithmeticFunction ℝ) : ℕ → ℝ) from
    funext (fun d ↦ (he d).symm), harmonicWeightSum_convolution]
  simp only [hg]
  rfl

lemma root_harmonic_X_sq_add_one_error (L : ℝ)
    (hL : ∀ N : ℕ, |harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) N - L| ≤ 1 / (N + 1 : ℝ))
    (N : ℕ) (hN : 0 < N) :
    |harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N -
      L * (∑ a ∈ Finset.Icc 1 N, (μ a : ℝ) ^ 2 / a)| ≤ 1 := by
  rw [root_harmonic_X_sq_add_one_expansion, Finset.mul_sum, ← Finset.sum_sub_distrib]
  calc
    _ ≤ ∑ a ∈ Finset.Icc 1 N,
        |(μ a : ℝ) ^ 2 / a * harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) (N / a) -
          L * ((μ a : ℝ) ^ 2 / a)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _a ∈ Finset.Icc 1 N, 1 / (N : ℝ) := by
      apply Finset.sum_le_sum
      intro a ha
      have ha0 : 0 < a := (Finset.mem_Icc.mp ha).1
      have haR : (0 : ℝ) < a := Nat.cast_pos.mpr ha0
      have hNR : (0 : ℝ) < N := Nat.cast_pos.mpr hN
      have hμ : (μ a : ℝ) ^ 2 ≤ 1 := by
        have he := ArithmeticFunction.moebius_sq (n := a)
        exact_mod_cast (show (μ a : ℤ) ^ 2 ≤ 1 by rw [he]; split_ifs <;> norm_num)
      have hweight0 : 0 ≤ (μ a : ℝ) ^ 2 / a := div_nonneg (sq_nonneg _) haR.le
      have hweight1 : (μ a : ℝ) ^ 2 / a ≤ 1 / a := div_le_div_of_nonneg_right hμ haR.le
      have hq : N < a * (N / a + 1) := by
        have hm := Nat.mod_lt N ha0
        have he := Nat.mod_add_div' N a
        nlinarith
      have hqR : (N : ℝ) < a * ((N / a : ℕ) + 1 : ℝ) := by exact_mod_cast hq
      calc
        _ = (μ a : ℝ) ^ 2 / a * |harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) (N / a) - L| := by
          calc
            _ = |((μ a : ℝ) ^ 2 / a) *
                (harmonicWeightSum (fun d ↦ (chiFour d : ℝ)) (N / a) - L)| := by
              congr 1; ring
            _ = _ := by rw [abs_mul, abs_of_nonneg hweight0]
        _ ≤ (1 / a : ℝ) * (1 / ((N / a : ℕ) + 1 : ℝ)) :=
          mul_le_mul hweight1 (hL (N / a)) (abs_nonneg _) (by positivity)
        _ ≤ 1 / (N : ℝ) := by
          rw [one_div_mul_one_div]
          exact one_div_le_one_div_of_le hNR hqR.le
    _ = _ := by simp [hN.ne']

lemma erdos975_X_sq_add_one :
    ∃ c > (0 : ℝ), Tendsto (fun x ↦ Erdos975Sum (X ^ 2 + 1) x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨L, hLpos, hL⟩ := chiFour_harmonic_limit_with_error
  let c : ℝ := L * ∑' k : ℕ, (μ k : ℝ) / (k : ℝ) ^ 2
  have hc : 0 < c := mul_pos hLpos moebius_div_sq_tsum_pos
  refine ⟨2 * c, mul_pos (by norm_num) hc, erdos975_X_sq_add_one_of_harmonic c ?_⟩
  have hlog : Tendsto (fun N : ℕ ↦ log (N : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hErr : Tendsto (fun N : ℕ ↦
      (harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N -
        L * (∑ a ∈ Finset.Icc 1 N, (μ a : ℝ) ^ 2 / a)) / log N) atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ (hlog.const_div_atTop 1)
    filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN
    have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN)
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hl]
    exact div_le_div_of_nonneg_right (root_harmonic_X_sq_add_one_error L hL N (by omega)) hl.le
  have ht := hErr.add (tendsto_squarefree_harmonic.const_mul L)
  simp only [zero_add] at ht
  apply ht.congr
  intro N
  ring

noncomputable def polynomialTruncatedSum (f : ℤ[X]) (N D : ℕ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D,
    (((Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ)

lemma polynomialTruncatedSum_error (f : ℤ[X]) (N D : ℕ) :
    |polynomialTruncatedSum f N D - (N + 1 : ℝ) *
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) D| ≤
      ∑ d ∈ Finset.Icc 1 D, ((polynomialRootResidues f d).card : ℝ) := by
  have hI : Finset.range (N + 1) = Finset.Iic N := by ext n; simp
  simpa only [hI, Nat.cast_add, Nat.cast_one] using truncated_divisor_count_error f D (N + 1)

lemma smallDivisorSum_truncated_bounds (f : ℤ[X]) (N D : ℕ)
    (hlower : ∀ n ≤ N, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    (hD : ∀ n ≤ N, (⌊f.eval (n : ℤ)⌋₊).sqrt ≤ D) :
    Erdos975SmallDivisorSum f N ≤ polynomialTruncatedSum f N D ∧
    polynomialTruncatedSum f N D ≤ Erdos975SmallDivisorSum f N +
      ∑ d ∈ Finset.Icc 1 D, ((polynomialRootResidues f d).card : ℝ) := by
  have hp : ∀ d ∈ Finset.Icc 1 D,
      ((Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ) ∧
        (d : ℤ) ^ 2 ≤ f.eval (n : ℤ))).card ≤
        ((Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card ∧
      ((Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card ≤
        ((Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ) ∧
          (d : ℤ) ^ 2 ≤ f.eval (n : ℤ))).card + (polynomialRootResidues f d).card := by
    intro d hd
    let S := (Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))
    let good := S.filter (fun n : ℕ ↦ (d : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    let bad := S.filter (fun n : ℕ ↦ ¬(d : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    have hcount : good.card + bad.card = S.card := Finset.card_filter_add_card_filter_not _
    have hbad : bad ⊆ polynomialRootResidues f d := by
      intro n hn
      obtain ⟨hnS, hnB⟩ := Finset.mem_filter.mp hn
      obtain ⟨hnN, hdiv⟩ := Finset.mem_filter.mp hnS
      have hnN' : n ≤ N := Finset.mem_Iic.mp hnN
      have hnd : n < d := by
        by_contra h
        have hdn : (d : ℤ) ≤ n := by exact_mod_cast (show d ≤ n by omega)
        have hsq : (d : ℤ) ^ 2 ≤ (n : ℤ) ^ 2 := by gcongr
        exact hnB (hsq.trans (hlower n hnN'))
      exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hnd, hdiv⟩
    have hb := Finset.card_le_card hbad
    have hg := Finset.card_filter_le S (fun n : ℕ ↦ (d : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    have hgood : good = (Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ) ∧
        (d : ℤ) ^ 2 ≤ f.eval (n : ℤ)) := Finset.filter_filter ..
    rw [← hgood]
    change good.card ≤ S.card ∧ S.card ≤ good.card + (polynomialRootResidues f d).card
    omega
  rw [smallDivisorSum_swap_int f N D hD]
  constructor
  · exact Finset.sum_le_sum (fun d hd ↦ by exact_mod_cast (hp d hd).1)
  · rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum (fun d hd ↦ by exact_mod_cast (hp d hd).2)

lemma smallDivisorSum_truncated_error (f : ℤ[X]) (N D : ℕ)
    (hlower : ∀ n ≤ N, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    (hD : ∀ n ≤ N, (⌊f.eval (n : ℤ)⌋₊).sqrt ≤ D) :
    |Erdos975SmallDivisorSum f N - (N + 1 : ℝ) *
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) D| ≤
      2 * ∑ d ∈ Finset.Icc 1 D, ((polynomialRootResidues f d).card : ℝ) := by
  have hb := smallDivisorSum_truncated_bounds f N D hlower hD
  have he := polynomialTruncatedSum_error f N D
  rw [abs_le] at he ⊢
  have hR : 0 ≤ ∑ d ∈ Finset.Icc 1 D, ((polynomialRootResidues f d).card : ℝ) := by positivity
  constructor <;> linarith

noncomputable def quadraticPolynomial (a b c : ℕ) : ℤ[X] :=
  C (a : ℤ) * X ^ 2 + C (b : ℤ) * X + C (c : ℤ)

lemma eval_quadraticPolynomial (a b c n : ℕ) :
    (quadraticPolynomial a b c).eval (n : ℤ) = ((a * n ^ 2 + b * n + c : ℕ) : ℤ) := by
  simp [quadraticPolynomial]

lemma quadraticPolynomial_lower (a b c n : ℕ) (ha : 0 < a) :
    (n : ℤ) ^ 2 ≤ (quadraticPolynomial a b c).eval (n : ℤ) := by
  rw [eval_quadraticPolynomial, ← Nat.cast_pow, Nat.cast_le]
  have h := Nat.le_mul_of_pos_left (n ^ 2) ha
  omega

lemma quadraticPolynomial_sqrt_bound (a b c N n : ℕ) (ha : 0 < a) (hN : 0 < N) (hn : n ≤ N) :
    (⌊(quadraticPolynomial a b c).eval (n : ℤ)⌋₊).sqrt ≤ (a + b + c) * N := by
  rw [eval_quadraticPolynomial, Nat.floor_natCast]
  have hn2 : n ^ 2 ≤ N ^ 2 := by gcongr
  have hN2 : N ≤ N ^ 2 := Nat.le_self_pow (by norm_num) N
  have hC : 1 ≤ a + b + c := by omega
  have hb : b * n ≤ b * N ^ 2 := Nat.mul_le_mul_left b (hn.trans hN2)
  have hc : c ≤ c * N ^ 2 := Nat.le_mul_of_pos_right c (pow_pos hN 2)
  have hval : a * n ^ 2 + b * n + c ≤ (a + b + c) * N ^ 2 := by
    nlinarith [Nat.mul_le_mul_left a hn2]
  have hval' : a * n ^ 2 + b * n + c ≤ ((a + b + c) * N) ^ 2 := by
    have h := Nat.mul_le_mul_left (N ^ 2) (Nat.le_self_pow (n := 2) (by norm_num) (a + b + c))
    nlinarith
  exact (Nat.sqrt_le_sqrt hval').trans (by simp [Nat.sqrt_eq'])

lemma tendsto_root_sum_scaled (u : ℕ → ℝ) (hu : ∀ d, 0 ≤ u d) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N) atTop (𝓝 c))
    (C : ℕ) (hC : 0 < C) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 (C * N), u d) / ((N : ℝ) * log N))
      atTop (𝓝 0) := by
  have hD : Tendsto (fun N : ℕ ↦ C * N) atTop atTop :=
    tendsto_atTop_mono (fun N ↦ Nat.le_mul_of_pos_left N hC) tendsto_id
  have hR := (tendsto_sum_div_mul_log_of_harmonic u hu c h).comp hD
  have hlog := tendsto_log_linear_nat_value C 0 hC
  simp only [Nat.add_zero] at hlog
  have ht := hR.mul (hlog.const_mul (C : ℝ))
  simp only [zero_mul] at ht
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (1 : ℕ), hD.eventually_gt_atTop 1] with N hN hDN
  have hlogD : log (C * N : ℕ) ≠ 0 := (Real.log_pos (by exact_mod_cast hDN)).ne'
  have hC0 : (C : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hC.ne'
  dsimp only [Function.comp_def]
  push_cast at hlogD ⊢
  field_simp

lemma erdos975_quadratic_nat_of_harmonic (a b c : ℕ) (ha : 0 < a) (κ : ℝ)
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues (quadraticPolynomial a b c) d).card) N /
        log N) atTop (𝓝 κ)) :
    Tendsto (fun x ↦ Erdos975Sum (quadraticPolynomial a b c) x / (x * log x)) atTop (𝓝 (2 * κ)) := by
  let f := quadraticPolynomial a b c
  let C := a + b + c
  let u : ℕ → ℝ := fun d ↦ (polynomialRootResidues f d).card
  have hC : 0 < C := by dsimp [C]; omega
  have hR := tendsto_root_sum_scaled u (fun _ ↦ Nat.cast_nonneg _) κ h C hC
  have hH : Tendsto (fun N : ℕ ↦ harmonicWeightSum u (C * N) / log N) atTop (𝓝 κ) := by
    have ht := tendsto_harmonic_scaled u κ h (C : ℝ) (Nat.cast_pos.mpr hC)
    simpa only [← Nat.cast_mul, Nat.floor_natCast] using ht
  have hErr : Tendsto (fun N : ℕ ↦
      (Erdos975SmallDivisorSum f N - (N + 1 : ℝ) * harmonicWeightSum u (C * N)) /
        ((N : ℝ) * log N)) atTop (𝓝 0) := by
    have hb := hR.const_mul 2
    simp only [mul_zero] at hb
    apply squeeze_zero_norm' _ hb
    filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN
    have hN0 : 0 < N := by omega
    have hden : 0 < (N : ℝ) * log N := mul_pos (Nat.cast_pos.mpr hN0)
      (Real.log_pos (by exact_mod_cast hN))
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hden]
    have he := smallDivisorSum_truncated_error f N (C * N)
      (fun n _ ↦ quadraticPolynomial_lower a b c n ha)
      (fun n hn ↦ quadraticPolynomial_sqrt_bound a b c N n ha hN0 hn)
    exact (div_le_div_of_nonneg_right he hden.le).trans_eq (by ring)
  have hNreal : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hq : Tendsto (fun N : ℕ ↦ (N + 1 : ℝ) / N) atTop (𝓝 1) := by
    have ht := (hNreal.const_div_atTop (1 : ℝ)).const_add 1
    simp only [add_zero] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hNne : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
    field_simp
  have hsmall : Tendsto (fun N : ℕ ↦ Erdos975SmallDivisorSum f N / ((N : ℝ) * log N))
      atTop (𝓝 κ) := by
    have ht := hErr.add (hq.mul hH)
    simp only [one_mul, zero_add] at ht
    apply ht.congr
    intro N
    ring
  have ht := (hsmall.const_mul 2).sub ((tendsto_squareCorrection f).comp hNreal)
  simp only [sub_zero] at ht
  apply (tendsto_erdos975Sum_iff_nat f _).mpr
  apply ht.congr
  intro N
  have he := erdos975Sum_hyperbola f (N : ℝ)
  dsimp only [Function.comp_def]
  rw [← mul_div_assoc, ← sub_div]
  congr 1
  linarith

noncomputable def modularRootShiftEquiv (f : ℤ[X]) (d : ℕ) (k : ℤ) :
    ModularRoot (f.comp (X + C k)) d ≃ ModularRoot f d := by
  apply Equiv.subtypeEquiv (Equiv.addRight (k : ZMod d))
  intro x
  simp only [eval₂_comp, eval₂_add, eval₂_X, eval₂_C, Int.coe_castRingHom]
  rfl

lemma rootResidues_card_shift (f : ℤ[X]) (d : ℕ) (k : ℤ) :
    (polynomialRootResidues (f.comp (X + C k)) d).card = (polynomialRootResidues f d).card := by
  by_cases hd : d = 0
  · simp [hd, polynomialRootResidues]
  · haveI : NeZero d := ⟨hd⟩
    rw [rootResidues_card_eq_modularRoot, rootResidues_card_eq_modularRoot]
    exact Nat.card_congr (modularRootShiftEquiv f d k)

lemma quadratic_slope_pos (a b c : ℤ) (ha : a ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ a * n ^ 2 + b * n + c) : 0 < a := by
  by_contra h
  have ha' : a ≤ -1 := by omega
  obtain ⟨n, hnpos, hn1, hnb, hnc⟩ :=
    (hpos.and ((eventually_ge_atTop (1 : ℤ)).and
      ((eventually_ge_atTop (b + 1)).and (eventually_ge_atTop (c + 1))))).exists
  have hn0 : 0 ≤ n := by omega
  have haineq := mul_le_mul_of_nonneg_right ha' (sq_nonneg n)
  have hbineq := mul_le_mul_of_nonneg_right hnb hn0
  nlinarith

lemma quadratic_natDegree_eq_two (f : ℤ[X]) (hdeg : f.natDegree = 2) :
    ∃ a b c : ℤ, a ≠ 0 ∧ f = C a * X ^ 2 + C b * X + C c := by
  refine ⟨f.coeff 2, f.coeff 1, f.coeff 0, ?_, ?_⟩
  · rw [← hdeg, coeff_natDegree]
    apply leadingCoeff_ne_zero.mpr
    intro hf
    simp [hf] at hdeg
  · have he := f.as_sum_range_C_mul_X_pow
    rw [hdeg] at he
    norm_num [Finset.sum_range_succ] at he
    conv_lhs => rw [he]
    simp only [← Polynomial.C_eq_intCast, Int.cast_id]
    ring

lemma quadratic_shift_to_nat (f : ℤ[X]) (hdeg : f.natDegree = 2)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ k a b c : ℕ, 0 < a ∧ f.comp (X + C (k : ℤ)) = quadraticPolynomial a b c := by
  obtain ⟨a, b, c, ha, hf⟩ := quadratic_natDegree_eq_two f hdeg
  have hpos' : ∀ᶠ n : ℤ in atTop, 1 ≤ a * n ^ 2 + b * n + c := by
    simpa only [hf, eval_add, eval_mul, eval_pow, eval_C, eval_X] using hpos
  have haP := quadratic_slope_pos a b c ha hpos'
  lift a to ℕ using haP.le
  have haNat : 0 < a := by exact_mod_cast haP
  have hposNat : ∀ᶠ k : ℕ in atTop, 1 ≤ (a : ℤ) * k ^ 2 + b * k + c :=
    (tendsto_natCast_atTop_atTop : Tendsto (fun k : ℕ ↦ (k : ℤ)) atTop atTop).eventually hpos'
  obtain ⟨k, hkpos, hkb⟩ := (hposNat.and (eventually_ge_atTop (-b).toNat)).exists
  have hkb' : -b ≤ (k : ℤ) := (Int.self_le_toNat (-b)).trans (by exact_mod_cast hkb)
  have hk0 : (0 : ℤ) ≤ k := Int.natCast_nonneg k
  have ha1 : (1 : ℤ) ≤ a := by exact_mod_cast haNat
  have hB : 0 ≤ b + 2 * (a : ℤ) * k := by
    have hm := mul_le_mul_of_nonneg_right ha1 hk0
    nlinarith
  let B := (b + 2 * (a : ℤ) * k).toNat
  let C₀ := ((a : ℤ) * k ^ 2 + b * k + c).toNat
  have hBcast : (B : ℤ) = b + 2 * (a : ℤ) * k := Int.toNat_of_nonneg hB
  have hCcast : (C₀ : ℤ) = (a : ℤ) * k ^ 2 + b * k + c := Int.toNat_of_nonneg (by omega)
  refine ⟨k, a, B, C₀, haNat, ?_⟩
  simp only [hf, quadraticPolynomial, add_comp, mul_comp, pow_comp, C_comp, X_comp,
    hBcast, hCcast, map_add, map_mul, map_pow, map_ofNat]
  ring

lemma erdos975_degree_two_of_harmonic (f : ℤ[X]) (hdeg : f.natDegree = 2)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (h : Tendsto (fun N : ℕ ↦ harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N /
      log N) atTop (𝓝 κ)) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 (2 * κ)) := by
  obtain ⟨k, a, b, c, ha, hshift⟩ := quadratic_shift_to_nat f hdeg hpos
  have hH : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues (f.comp (X + C (k : ℤ))) d).card) N /
        log N) atTop (𝓝 κ) := by
    simpa only [rootResidues_card_shift] using h
  rw [hshift] at hH
  apply (erdos975_shift_iff f k (2 * κ)).mpr
  rw [hshift]
  exact erdos975_quadratic_nat_of_harmonic a b c ha κ hH

lemma erdos975_shift_int_iff (f : ℤ[X]) (k : ℤ) (c : ℝ) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun x ↦ Erdos975Sum (f.comp (X + C k)) x / (x * log x)) atTop (𝓝 c) := by
  by_cases hk : 0 ≤ k
  · lift k to ℕ using hk
    exact erdos975_shift_iff f k c
  · let n := (-k).toNat
    have hn : (n : ℤ) = -k := Int.toNat_of_nonneg (by omega)
    have hcomp : (f.comp (X + C k)).comp (X + C (n : ℤ)) = f := by
      rw [comp_assoc]
      have he : (X + C k : ℤ[X]).comp (X + C (n : ℤ)) = X := by
        simp only [add_comp, X_comp, C_comp, hn, map_neg]
        ring
      rw [he, comp_X]
    have hi := erdos975_shift_iff (f.comp (X + C k)) n c
    rw [hcomp] at hi
    exact hi.symm

lemma erdos975_X_sq_add_one_translate (k : ℤ) :
    ∃ c > (0 : ℝ),
      Tendsto (fun x ↦ Erdos975Sum ((X ^ 2 + 1).comp (X + C k)) x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨c, hc, hlim⟩ := erdos975_X_sq_add_one
  exact ⟨c, hc, (erdos975_shift_int_iff (X ^ 2 + 1) k c).mp hlim⟩

lemma power_fiber_map_bijective {G H : Type*} [CommGroup G] [CommGroup H]
    (φ : G →* H) (hφ : Function.Surjective φ) (n : ℕ)
    (hpow : Function.Bijective (fun z : φ.ker ↦ z ^ n)) (a : G) :
    Function.Bijective (fun x : {x : G // x ^ n = a} ↦
      (⟨φ x.val, by simpa using congrArg φ x.property⟩ : {y : H // y ^ n = φ a})) := by
  constructor
  · intro x y hxy
    have hxy' : φ x.val = φ y.val := congrArg Subtype.val hxy
    let t : φ.ker := ⟨x.val / y.val, by simp [MonoidHom.mem_ker, hxy']⟩
    have ht : t ^ n = 1 := by
      apply Subtype.ext
      change (x.val / y.val) ^ n = 1
      rw [div_pow, x.property, y.property]
      simp
    have ht1 : t = 1 := hpow.injective (ht.trans (one_pow n).symm)
    have he : x.val / y.val = 1 := congrArg Subtype.val ht1
    exact Subtype.ext (div_eq_one.mp he)
  · intro y
    obtain ⟨x, hx⟩ := hφ y.val
    let t : φ.ker := ⟨a / x ^ n, by simp [MonoidHom.mem_ker, hx, y.property]⟩
    obtain ⟨z, hz⟩ := hpow.surjective t
    have hz' : z.val ^ n = a / x ^ n := congrArg Subtype.val hz
    refine ⟨⟨z.val * x, ?_⟩, ?_⟩
    · rw [mul_pow, hz', div_mul_cancel]
    · apply Subtype.ext
      change φ (z.val * x) = y.val
      rw [map_mul, z.property, one_mul, hx]

lemma card_power_fiber_map {G H : Type*} [CommGroup G] [CommGroup H]
    (φ : G →* H) (hφ : Function.Surjective φ) (n : ℕ)
    (hpow : Function.Bijective (fun z : φ.ker ↦ z ^ n)) (a : G) :
    Nat.card {x : G // x ^ n = a} = Nat.card {y : H // y ^ n = φ a} := by
  exact Nat.card_congr (Equiv.ofBijective _ (power_fiber_map_bijective φ hφ n hpow a))

lemma card_power_fiber_map_coprime {G H : Type*} [CommGroup G] [CommGroup H]
    (φ : G →* H) (hφ : Function.Surjective φ) (n : ℕ)
    (hcop : (Nat.card φ.ker).Coprime n) (a : G) :
    Nat.card {x : G // x ^ n = a} = Nat.card {y : H // y ^ n = φ a} := by
  exact card_power_fiber_map φ hφ n hcop.pow_left_bijective a

lemma unitsMap_prime_pow_card_ker (p k : ℕ) (hp : p.Prime) :
    Nat.card (ZMod.unitsMap (show p ∣ p ^ (k + 1) by exact dvd_pow_self p (by omega))).ker = p ^ k := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  let φ := ZMod.unitsMap (show p ∣ p ^ (k + 1) by exact dvd_pow_self p (by omega))
  have hs : Function.Surjective φ := ZMod.unitsMap_surjective _
  have hc := φ.ker.card_mul_index
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hs, Subgroup.card_top] at hc
  simp only [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient, Nat.totient_prime hp,
    Nat.totient_prime_pow_succ hp] at hc
  simpa only [Nat.card_eq_fintype_card] using
    Nat.eq_of_mul_eq_mul_right (Nat.sub_pos_of_lt hp.one_lt) hc

lemma card_units_power_prime_pow (p k m : ℕ) (hp : p.Prime) (hcop : p.Coprime m)
    (a : (ZMod (p ^ (k + 1)))ˣ) :
    Nat.card {x : (ZMod (p ^ (k + 1)))ˣ // x ^ m = a} =
      Nat.card {y : (ZMod p)ˣ // y ^ m =
        ZMod.unitsMap (show p ∣ p ^ (k + 1) by exact dvd_pow_self p (by omega)) a} := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  apply card_power_fiber_map_coprime _ (ZMod.unitsMap_surjective _) m
  rw [unitsMap_prime_pow_card_ker p k hp]
  exact hcop.pow_left k

noncomputable def unitSquareRootsEquiv (R : Type*) [CommRing R] (a : Rˣ) :
    {x : R // x ^ 2 = a.val} ≃ {u : Rˣ // u ^ 2 = a} where
  toFun x := ⟨Units.mkOfMulEqOne x.val (x.val * (a⁻¹).val) (by
    rw [← mul_assoc, ← pow_two, x.property, Units.mul_inv]), by
    apply Units.ext
    simpa using x.property⟩
  invFun u := ⟨u.val.val, by simpa using congrArg Units.val u.property⟩
  left_inv x := rfl
  right_inv u := by apply Subtype.ext; apply Units.ext; rfl

lemma card_square_roots_prime_pow_units (p k : ℕ) (hp : p.Prime) (hp2 : p ≠ 2)
    (a : (ZMod (p ^ (k + 1)))ˣ) :
    Nat.card {x : ZMod (p ^ (k + 1)) // x ^ 2 = a.val} =
      Nat.card {y : ZMod p // y ^ 2 =
        (ZMod.unitsMap (show p ∣ p ^ (k + 1) by exact dvd_pow_self p (by omega)) a).val} := by
  rw [Nat.card_congr (unitSquareRootsEquiv _ a),
    Nat.card_congr (unitSquareRootsEquiv _ (ZMod.unitsMap _ a))]
  apply card_units_power_prime_pow p k 2 hp
  exact Nat.coprime_comm.mp (Nat.prime_two.coprime_iff_not_dvd.mpr
    (by have := hp.eq_two_or_odd.resolve_left hp2; omega))

lemma zmod_isUnit_intCast_of_coprime (a : ℤ) (n : ℕ) (h : a.natAbs.Coprime n) :
    IsUnit (a : ZMod n) := by
  have hu := (ZMod.isUnit_iff_coprime a.natAbs n).mpr h
  cases a with
  | ofNat a => simpa using hu
  | negSucc a => simpa using hu.neg

lemma card_square_roots_prime_pow_int (p k : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (a : ℤ) (ha : ¬(p : ℤ) ∣ a) :
    (Nat.card {x : ZMod (p ^ (k + 1)) // x ^ 2 = (a : ZMod (p ^ (k + 1)))} : ℤ) =
      legendreSym p a + 1 := by
  have hp : p.Prime := Fact.out
  have hcop : a.natAbs.Coprime p :=
    (hp.coprime_iff_not_dvd.mpr (by simpa only [← Int.natCast_dvd] using ha)).symm
  have hu := zmod_isUnit_intCast_of_coprime a (p ^ (k + 1)) (hcop.pow_right (k + 1))
  let hd : p ∣ p ^ (k + 1) := dvd_pow_self p (by omega)
  have hmap : (ZMod.unitsMap hd hu.unit).val = (a : ZMod p) := by
    rw [ZMod.unitsMap_val, hu.unit_spec, ZMod.cast_intCast hd a]
  have hlift := card_square_roots_prime_pow_units p k hp hp2 hu.unit
  rw [hu.unit_spec, hmap] at hlift
  rw [hlift]
  have hc := legendreSym.card_sqrts p hp2 a
  rw [Set.toFinset_card] at hc
  simpa only [Nat.card_eq_fintype_card] using hc

noncomputable def affineUnitEquiv {R : Type*} [CommRing R] (u : Rˣ) (b : R) : R ≃ R where
  toFun x := u.val * x + b
  invFun y := (u⁻¹).val * (y - b)
  left_inv x := by simp [← mul_assoc]
  right_inv y := by simp [← mul_assoc]

noncomputable def quadraticRootSquareEquiv {R : Type*} [CommRing R]
    (a b c : R) (hu : IsUnit (2 * a)) :
    {x : R // a * x ^ 2 + b * x + c = 0} ≃ {y : R // y ^ 2 = b ^ 2 - 4 * a * c} := by
  apply Equiv.subtypeEquiv (affineUnitEquiv hu.unit b)
  intro x
  change (a * x ^ 2 + b * x + c = 0) ↔ (hu.unit.val * x + b) ^ 2 = b ^ 2 - 4 * a * c
  rw [hu.unit_spec]
  have h4a : IsUnit (4 * a) := by
    have h2 := ((Commute.all (2 : R) a).isUnit_mul_iff.mp hu).1
    convert h2.mul hu using 1
    ring
  constructor
  · intro h
    linear_combination 4 * a * h
  · intro h
    apply h4a.mul_left_cancel
    linear_combination h

lemma quadratic_root_card_good_prime_pow (a b c : ℤ) (p k : ℕ) [Fact p.Prime]
    (hp2 : p ≠ 2) (ha : ¬(p : ℤ) ∣ a) (hdisc : ¬(p : ℤ) ∣ b ^ 2 - 4 * a * c) :
    ((polynomialRootResidues (C a * X ^ 2 + C b * X + C c) (p ^ (k + 1))).card : ℤ) =
      legendreSym p (b ^ 2 - 4 * a * c) + 1 := by
  have hp : p.Prime := Fact.out
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have hacop : a.natAbs.Coprime p :=
    (hp.coprime_iff_not_dvd.mpr (by simpa only [← Int.natCast_dvd] using ha)).symm
  have h2cop : Nat.Coprime 2 p := Nat.prime_two.coprime_iff_not_dvd.mpr
    (by have := hp.eq_two_or_odd.resolve_left hp2; omega)
  have hua := zmod_isUnit_intCast_of_coprime a (p ^ (k + 1)) (hacop.pow_right (k + 1))
  have hu2 : IsUnit (2 : ZMod (p ^ (k + 1))) := by
    simpa using zmod_isUnit_intCast_of_coprime (2 : ℤ) (p ^ (k + 1))
      (by simpa using h2cop.pow_right (k + 1))
  rw [rootResidues_card_eq_modularRoot]
  simp only [ModularRoot, eval₂_add, eval₂_mul, eval₂_pow, eval₂_C, eval₂_X, Int.coe_castRingHom]
  rw [Nat.card_congr (quadraticRootSquareEquiv (a : ZMod (p ^ (k + 1))) b c (hu2.mul hua))]
  have hcast : ((b ^ 2 - 4 * a * c : ℤ) : ZMod (p ^ (k + 1))) =
      (b : ZMod (p ^ (k + 1))) ^ 2 - 4 * a * c := by push_cast; rfl
  rw [← hcast]
  exact card_square_roots_prime_pow_int p k hp2 _ hdisc

lemma harmonicWeightSum_nonneg (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n) (N : ℕ) :
    0 ≤ harmonicWeightSum u N := Finset.sum_nonneg fun d _ ↦ div_nonneg (hu d) (Nat.cast_nonneg d)

lemma harmonicWeightSum_mono (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n) : Monotone (harmonicWeightSum u) := by
  intro M N hMN
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.Icc_subset_Icc le_rfl hMN)
    (fun d _ _ ↦ div_nonneg (hu d) (Nat.cast_nonneg d))

lemma tendsto_harmonicWeightSum_nat_div (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N) atTop (𝓝 c))
    (q : ℕ) (hq : 0 < q) :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum u (N / q) / log N) atTop (𝓝 c) := by
  have hD := Nat.tendsto_div_const_atTop hq.ne'
  have hl := tendsto_log_nat_floor_scaled_div_log (1 / q) (by positivity)
  simp only [one_div_mul_eq_div, Nat.floor_div_eq_div] at hl
  have ht := (h.comp hD).mul hl
  simp only [mul_one] at ht
  apply ht.congr'
  filter_upwards [hD.eventually_gt_atTop 1] with N hN
  have hlog : log ((N / q : ℕ) : ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  dsimp only [Function.comp_def]
  field_simp

lemma tendsto_harmonicWeightSum_convolution (u v : ArithmeticFunction ℝ)
    (hu : ∀ n, 0 ≤ u n) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N) atTop (𝓝 c))
    (hv : Summable (fun n : ℕ ↦ ‖v n / (n : ℝ)‖)) :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum (v * u : ArithmeticFunction ℝ) N / log N)
      atTop (𝓝 ((∑' n : ℕ, v n / (n : ℝ)) * c)) := by
  let F : ℕ → ℕ → ℝ := fun N n ↦ v n / (n : ℝ) * (harmonicWeightSum u (N / n) / log N)
  have hb : Summable (fun n : ℕ ↦ ‖v n / (n : ℝ)‖ * (|c| + 1)) := hv.mul_right _
  have ht := tendsto_tsum_of_dominated_convergence (𝓕 := atTop) hb
    (f := F) (g := fun n : ℕ ↦ v n / (n : ℝ) * c) ?_ ?_
  · rw [tsum_mul_right] at ht
    apply ht.congr
    intro N
    rw [tsum_eq_sum (s := Finset.Icc 1 N) ?_, harmonicWeightSum_convolution, Finset.sum_div]
    · apply Finset.sum_congr rfl
      intro n hn
      dsimp [F]
      ring
    · intro n hn
      by_cases hn0 : n = 0
      · simp [F, hn0]
      · have hnN : N < n := by simp only [Finset.mem_Icc] at hn; omega
        simp [F, Nat.div_eq_of_lt hnN, harmonicWeightSum]
  · intro n
    by_cases hn0 : n = 0
    · simp [F, hn0]
    · exact (tendsto_harmonicWeightSum_nat_div u c h n (Nat.pos_of_ne_zero hn0)).const_mul _
  · have hc : c < |c| + 1 := by linarith [le_abs_self c]
    filter_upwards [h.eventually (gt_mem_nhds hc), eventually_gt_atTop (1 : ℕ)] with N hNH hN1
    intro n
    have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN1)
    have h0 := div_nonneg (harmonicWeightSum_nonneg u hu (N / n)) hl.le
    have h1 : harmonicWeightSum u (N / n) / log N ≤ |c| + 1 :=
      (div_le_div_of_nonneg_right (harmonicWeightSum_mono u hu (Nat.div_le_self N n)) hl.le).trans hNH.le
    dsimp only [F]
    rw [norm_mul, Real.norm_of_nonneg h0]
    exact mul_le_mul_of_nonneg_left h1 (norm_nonneg _)

lemma convolution_prime_pow (u v : ArithmeticFunction ℝ) (p k : ℕ) (hp : p.Prime) :
    (u * v) (p ^ k) = ∑ j ∈ Finset.range (k + 1), u (p ^ j) * v (p ^ (k - j)) := by
  rw [ArithmeticFunction.mul_apply, Nat.sum_divisorsAntidiagonal (fun a b ↦ u a * v b),
    Nat.sum_divisors_prime_pow hp]
  apply Finset.sum_congr rfl
  intro j hj
  rw [Nat.pow_div (by simpa using Finset.mem_range.mp hj) hp.pos]

open scoped Classical

noncomputable def primePowerSequence (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) : ArithmeticFunction ℝ where
  toFun n := if ∃ k : ℕ, n = p ^ k then v (Nat.log p n) else 0
  map_zero' := by simp [eq_comm, hp.ne_zero]

lemma primePowerSequence_apply_pow (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) (k : ℕ) :
    primePowerSequence p hp v (p ^ k) = v k := by
  have h : ∃ j : ℕ, p ^ k = p ^ j := ⟨k, rfl⟩
  simp only [primePowerSequence, ArithmeticFunction.coe_mk, if_pos h, Nat.log_pow hp.one_lt]

lemma primePowerSequence_apply_one (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) :
    primePowerSequence p hp v 1 = v 0 := by
  simpa only [pow_zero] using primePowerSequence_apply_pow p hp v 0

lemma primePowerSequence_apply_not_pow (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) (n : ℕ)
    (hn : ¬∃ k : ℕ, n = p ^ k) : primePowerSequence p hp v n = 0 := if_neg hn

lemma dvd_prime_of_dvd_prime_pow_ne_one (p k m : ℕ) (hp : p.Prime) (hm : m ∣ p ^ k) (hm1 : m ≠ 1) :
    p ∣ m := by
  obtain ⟨j, hj, rfl⟩ := (Nat.dvd_prime_pow hp).mp hm
  have hj0 : j ≠ 0 := by intro hj0; simp [hj0] at hm1
  exact dvd_pow_self p hj0

lemma primePowerSequence_multiplicative (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) (hv : v 0 = 1) :
    (primePowerSequence p hp v).IsMultiplicative := by
  constructor
  · rw [primePowerSequence_apply_one, hv]
  · intro m n hmn
    by_cases hm1 : m = 1
    · simp [hm1, primePowerSequence_apply_one, hv]
    by_cases hn1 : n = 1
    · simp [hn1, primePowerSequence_apply_one, hv]
    have hprod : ¬∃ k : ℕ, m * n = p ^ k := by
      rintro ⟨k, hk⟩
      have hpm := dvd_prime_of_dvd_prime_pow_ne_one p k m hp (hk ▸ dvd_mul_right m n) hm1
      have hpn := dvd_prime_of_dvd_prime_pow_ne_one p k n hp (hk ▸ dvd_mul_left n m) hn1
      exact hp.ne_one (Nat.eq_one_of_dvd_coprimes hmn hpm hpn)
    rw [primePowerSequence_apply_not_pow p hp v _ hprod]
    by_cases hm : ∃ i : ℕ, m = p ^ i
    · have hn : ¬∃ j : ℕ, n = p ^ j := by
        rintro ⟨j, rfl⟩
        obtain ⟨i, rfl⟩ := hm
        exact hprod ⟨i + j, (pow_add p i j).symm⟩
      rw [primePowerSequence_apply_not_pow p hp v _ hn, mul_zero]
    · rw [primePowerSequence_apply_not_pow p hp v _ hm, zero_mul]

lemma primePowerSequence_apply_other_prime_pow (p q k : ℕ) (hp : p.Prime) (hq : q.Prime)
    (hpq : p ≠ q) (hk : k ≠ 0) (v : ℕ → ℝ) : primePowerSequence p hp v (q ^ k) = 0 := by
  apply primePowerSequence_apply_not_pow
  rintro ⟨j, he⟩
  have hdiv : q ∣ p ^ j := he ▸ dvd_pow_self q hk
  exact hpq (((Nat.dvd_prime hp).mp (hq.dvd_of_dvd_pow hdiv)).resolve_left hq.ne_one).symm

lemma primePowerSequence_summable_div_iff (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) :
    Summable (fun n : ℕ ↦ primePowerSequence p hp v n / (n : ℝ)) ↔
      Summable (fun k : ℕ ↦ v k / (p : ℝ) ^ k) := by
  have he := (Nat.pow_right_injective hp.two_le).summable_iff
    (f := fun n : ℕ ↦ primePowerSequence p hp v n / (n : ℝ)) (fun n hn ↦ ?_)
  · simpa only [Function.comp_def, primePowerSequence_apply_pow, Nat.cast_pow] using he.symm
  · have hn' : ¬∃ k : ℕ, n = p ^ k := by simpa only [Set.mem_range, eq_comm] using hn
    dsimp only
    rw [primePowerSequence_apply_not_pow p hp v n hn', zero_div]

lemma primePowerSequence_tsum_div (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ) :
    (∑' n : ℕ, primePowerSequence p hp v n / (n : ℝ)) = ∑' k : ℕ, v k / (p : ℝ) ^ k := by
  have he := (Nat.pow_right_injective hp.two_le).tsum_eq
    (f := fun n : ℕ ↦ primePowerSequence p hp v n / (n : ℝ)) ?_
  · simpa only [primePowerSequence_apply_pow, Nat.cast_pow] using he.symm
  · intro n hn
    by_contra hr
    have hn' : ¬∃ k : ℕ, n = p ^ k := by simpa only [Set.mem_range, eq_comm] using hr
    simp only [Function.mem_support, primePowerSequence_apply_not_pow p hp v n hn', zero_div,
      ne_eq, not_true_eq_false] at hn

lemma primePowerSequence_summable_div_of_bounded (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ)
    (C : ℝ) (hC : ∀ k, ‖v k‖ ≤ C) :
    Summable (fun n : ℕ ↦ primePowerSequence p hp v n / (n : ℝ)) := by
  apply (primePowerSequence_summable_div_iff p hp v).mpr
  have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr hp.pos
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hgeom : Summable (fun k : ℕ ↦ (1 / (p : ℝ)) ^ k) := by
    apply summable_geometric_of_norm_lt_one
    rw [Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr hp0)]
    exact (div_lt_one hp0).mpr hp1
  apply (hgeom.mul_left C).of_norm_bounded
  intro k
  rw [norm_div, Real.norm_of_nonneg (pow_pos hp0 k).le]
  calc
    ‖v k‖ / (p : ℝ) ^ k ≤ C / (p : ℝ) ^ k := div_le_div_of_nonneg_right (hC k) (pow_pos hp0 k).le
    _ = _ := by simp [div_eq_mul_inv]

lemma primePowerSequence_tsum_pos (p : ℕ) (hp : p.Prime) (v : ℕ → ℝ)
    (hv : ∀ k, 0 ≤ v k) (hv0 : 0 < v 0)
    (hs : Summable (fun k : ℕ ↦ v k / (p : ℝ) ^ k)) :
    0 < ∑' n : ℕ, primePowerSequence p hp v n / (n : ℝ) := by
  rw [primePowerSequence_tsum_div]
  exact lt_of_lt_of_le (by simpa using hv0) (hs.le_tsum 0 (fun k _ ↦ div_nonneg (hv k) (by positivity)))

lemma primePowerSequence_convolution_other_prime_pow (u : ArithmeticFunction ℝ)
    (p q k : ℕ) (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) (v : ℕ → ℝ) (hv : v 0 = 1) :
    (primePowerSequence p hp v * u) (q ^ k) = u (q ^ k) := by
  rw [convolution_prime_pow _ _ q k hq, Finset.sum_eq_single 0]
  · simp [primePowerSequence_apply_one, hv]
  · intro j hj hj0
    rw [primePowerSequence_apply_other_prime_pow p q j hp hq hpq hj0 v, zero_mul]
  · simp

noncomputable def unitScaleSquareEquiv {R : Type*} [CommRing R] (u : Rˣ) (a : R) :
    {x : R // x ^ 2 = a} ≃ {y : R // y ^ 2 = u.val ^ 2 * a} := by
  apply Equiv.subtypeEquiv (affineUnitEquiv u 0)
  intro x
  change x ^ 2 = a ↔ (u.val * x + 0) ^ 2 = u.val ^ 2 * a
  rw [add_zero, mul_pow]
  exact ⟨fun h ↦ congrArg (fun z ↦ u.val ^ 2 * z) h, (u.isUnit.pow 2).mul_left_cancel⟩

lemma rootResidues_X_sq_add_four_odd_prime_pow (p k : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) :
    (polynomialRootResidues (X ^ 2 + C 4) (p ^ (k + 1))).card =
      (polynomialRootResidues (X ^ 2 + 1) (p ^ (k + 1))).card := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have hcop : Nat.Coprime 2 p := Nat.prime_two.coprime_iff_not_dvd.mpr
    (by have := hp.eq_two_or_odd.resolve_left hp2; omega)
  have hu : IsUnit (2 : ZMod (p ^ (k + 1))) := by
    exact (ZMod.isUnit_iff_coprime 2 (p ^ (k + 1))).mpr (hcop.pow_right (k + 1))
  rw [rootResidues_card_eq_modularRoot, rootResidues_card_eq_modularRoot]
  have he := Nat.card_congr (unitScaleSquareEquiv hu.unit (-1))
  rw [hu.unit_spec] at he
  norm_num only [mul_neg, mul_one, OfNat.ofNat] at he
  simpa only [ModularRoot, eval₂_add, eval₂_pow, eval₂_X, eval₂_C, eval₂_one,
    Int.coe_castRingHom, Int.cast_ofNat, add_eq_zero_iff_eq_neg] using he.symm

lemma rootResidues_X_sq_add_four_two :
    (polynomialRootResidues (X ^ 2 + C 4) 2).card = 1 := by
  norm_num [polynomialRootResidues, Finset.range_add_one, Finset.filter_insert, Finset.filter_singleton]

lemma rootResidues_X_sq_add_four_four :
    (polynomialRootResidues (X ^ 2 + C 4) 4).card = 2 := by
  norm_num [polynomialRootResidues, Finset.range_add_one, Finset.filter_insert, Finset.filter_singleton]

lemma rootResidues_X_sq_add_four_eight :
    (polynomialRootResidues (X ^ 2 + C 4) 8).card = 2 := by
  norm_num [polynomialRootResidues, Finset.range_add_one, Finset.filter_insert, Finset.filter_singleton]

lemma rootResidues_X_sq_add_four_two_pow (k : ℕ) :
    (polynomialRootResidues (X ^ 2 + C 4) (2 ^ (k + 4))).card = 0 := by
  have h16 : ∀ x : ZMod 16, x ^ 2 ≠ -4 := by decide
  have hd : 16 ∣ 2 ^ (k + 4) := pow_dvd_pow 2 (show 4 ≤ k + 4 by omega)
  let g : ZMod (2 ^ (k + 4)) →+* ZMod 16 := ZMod.castHom hd (ZMod 16)
  haveI : IsEmpty {x : ZMod (2 ^ (k + 4)) // x ^ 2 = -4} := ⟨by
    intro x
    apply h16 (g x.val)
    simpa only [map_pow, map_neg, map_ofNat] using congrArg g x.property⟩
  rw [rootResidues_card_eq_modularRoot]
  simp only [ModularRoot, eval₂_add, eval₂_pow, eval₂_X, eval₂_C, Int.coe_castRingHom,
    Int.cast_ofNat, add_eq_zero_iff_eq_neg]
  simp

noncomputable def fourKernel : ArithmeticFunction ℝ :=
  primePowerSequence 2 Nat.prime_two (fun k ↦ if k = 0 then 1 else if k = 2 then 2 else 0)

lemma fourKernel_multiplicative : fourKernel.IsMultiplicative := by
  apply primePowerSequence_multiplicative
  simp

lemma fourKernel_pow (k : ℕ) : fourKernel (2 ^ k) = if k = 0 then 1 else if k = 2 then 2 else 0 :=
  primePowerSequence_apply_pow _ _ _ k

lemma fourKernel_summable : Summable (fun n : ℕ ↦ fourKernel n / (n : ℝ)) := by
  apply primePowerSequence_summable_div_of_bounded _ _ _ 2
  intro k
  split_ifs <;> norm_num

lemma fourKernel_tsum_pos : 0 < ∑' n : ℕ, fourKernel n / (n : ℝ) := by
  apply primePowerSequence_tsum_pos
  · intro k; split_ifs <;> norm_num
  · norm_num
  · exact (primePowerSequence_summable_div_iff _ _ _).mp fourKernel_summable

lemma rootCount_X_sq_add_one_two_pow_real (k : ℕ) :
    (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ) (2 ^ k) = if k ≤ 1 then 1 else 0 := by
  rcases k with _ | k
  · simp [polynomialRootCount, polynomialRootResidues]
  rcases k with _ | k
  · simpa only [Nat.reducePow, ArithmeticFunction.natCoe_apply, polynomialRootCount,
      ArithmeticFunction.coe_mk, Nat.reduceLeDiff, if_true, Nat.cast_one] using
      congrArg (fun n : ℕ ↦ (n : ℝ)) rootResidues_X_sq_add_one_two
  · simp only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk,
      rootResidues_X_sq_add_one_two_pow, Nat.cast_zero]
    rw [if_neg (by omega)]

lemma rootCount_X_sq_add_four_convolution :
    (polynomialRootCount (X ^ 2 + C 4) : ArithmeticFunction ℝ) =
      fourKernel * (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ) := by
  apply (ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers _
    (polynomialRootCount_multiplicative _).natCast _
    (fourKernel_multiplicative.mul (polynomialRootCount_multiplicative _).natCast)).mpr
  intro p k hp
  by_cases hp2 : p = 2
  · subst p
    by_cases hk : k < 4
    · interval_cases k
      all_goals rw [convolution_prime_pow _ _ 2 _ Nat.prime_two]
      all_goals simp only [Finset.sum_range_succ, Finset.sum_range_zero, fourKernel_pow,
        rootCount_X_sq_add_one_two_pow_real]
      all_goals norm_num [ArithmeticFunction.natCoe_apply, polynomialRootCount,
        rootResidues_X_sq_add_four_two, rootResidues_X_sq_add_four_four, rootResidues_X_sq_add_four_eight,
        polynomialRootResidues, Finset.range_add_one, Finset.filter_insert, Finset.filter_singleton]
    · obtain ⟨j, rfl⟩ : ∃ j, k = j + 4 := ⟨k - 4, by omega⟩
      simp only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk,
        rootResidues_X_sq_add_four_two_pow, Nat.cast_zero]
      change (0 : ℝ) = (fourKernel * (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ)) (2 ^ (j + 4))
      rw [convolution_prime_pow _ _ 2 _ Nat.prime_two]
      symm
      apply Finset.sum_eq_zero
      intro i hi
      rw [fourKernel_pow]
      split_ifs with hi0 hi2
      · subst i
        rw [one_mul, rootCount_X_sq_add_one_two_pow_real, if_neg (by omega)]
      · subst i
        rw [rootCount_X_sq_add_one_two_pow_real, if_neg (by omega), mul_zero]
      · rw [zero_mul]
  · unfold fourKernel
    rw [primePowerSequence_convolution_other_prime_pow _ 2 p k Nat.prime_two hp (Ne.symm hp2) (fun k ↦ if k = 0 then 1 else if k = 2 then 2 else 0) (by simp)]
    rcases k with _ | k
    · simp [polynomialRootCount, polynomialRootResidues]
    · simp only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk,
        rootResidues_X_sq_add_four_odd_prime_pow p k hp hp2]

lemma root_harmonic_X_sq_add_one_limit :
    ∃ κ > (0 : ℝ), Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N / log N)
        atTop (𝓝 κ) := by
  obtain ⟨L, hLpos, hL⟩ := chiFour_harmonic_limit_with_error
  refine ⟨L * ∑' k : ℕ, (μ k : ℝ) / (k : ℝ) ^ 2, mul_pos hLpos moebius_div_sq_tsum_pos, ?_⟩
  have hlog : Tendsto (fun N : ℕ ↦ log (N : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hErr : Tendsto (fun N : ℕ ↦
      (harmonicWeightSum (fun d ↦ (polynomialRootResidues (X ^ 2 + 1) d).card) N -
        L * (∑ a ∈ Finset.Icc 1 N, (μ a : ℝ) ^ 2 / a)) / log N) atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ (hlog.const_div_atTop 1)
    filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN
    have hl : 0 < log (N : ℝ) := Real.log_pos (by exact_mod_cast hN)
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hl]
    exact div_le_div_of_nonneg_right (root_harmonic_X_sq_add_one_error L hL N (by omega)) hl.le
  have ht := hErr.add (tendsto_squarefree_harmonic.const_mul L)
  simp only [zero_add] at ht
  apply ht.congr
  intro N
  ring

lemma erdos975_X_sq_add_four :
    ∃ c > (0 : ℝ), Tendsto (fun x ↦ Erdos975Sum (X ^ 2 + C 4) x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨κ, hκ, hH⟩ := root_harmonic_X_sq_add_one_limit
  let u : ArithmeticFunction ℝ := polynomialRootCount (X ^ 2 + 1)
  let c : ℝ := (∑' n : ℕ, fourKernel n / (n : ℝ)) * κ
  have hc : 0 < c := mul_pos fourKernel_tsum_pos hκ
  have hu : ∀ n, 0 ≤ u n := fun n ↦ Nat.cast_nonneg _
  have hlim := tendsto_harmonicWeightSum_convolution u fourKernel hu κ hH fourKernel_summable.norm
  change Tendsto (fun N : ℕ ↦ harmonicWeightSum
    (fourKernel * (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ) : ArithmeticFunction ℝ) N / log N) atTop (𝓝 c) at hlim
  rw [← rootCount_X_sq_add_four_convolution] at hlim
  refine ⟨2 * c, mul_pos (by norm_num) hc, ?_⟩
  have ht := erdos975_quadratic_nat_of_harmonic 1 0 4 (by norm_num) c ?_
  ·     simpa only [quadraticPolynomial, Nat.cast_one, map_one, one_mul, Nat.cast_zero, map_zero,
      zero_mul, add_zero, Nat.cast_ofNat] using ht
  ·     simpa only [quadraticPolynomial, Nat.cast_one, map_one, one_mul, Nat.cast_zero, map_zero,
      zero_mul, add_zero, Nat.cast_ofNat, ArithmeticFunction.natCoe_apply, polynomialRootCount,
      ArithmeticFunction.coe_mk] using hlim

lemma eval_X_sq_add_C_nat (A n : ℕ) :
    (X ^ 2 + C (A : ℤ) : ℤ[X]).eval (n : ℤ) = ((n ^ 2 + A : ℕ) : ℤ) := by simp

lemma rootResidues_X_sq_add_C_nat (A d : ℕ) :
    polynomialRootResidues (X ^ 2 + C (A : ℤ)) d =
      (Finset.range d).filter (fun n ↦ d ∣ n ^ 2 + A) := by
  simp only [polynomialRootResidues, eval_X_sq_add_C_nat, Int.natCast_dvd_natCast]

lemma scaled_square_congruence (p A k y : ℕ) (hp : 0 < p) :
    p ^ (k + 2) ∣ (p * y) ^ 2 + p ^ 2 * A ↔ p ^ k ∣ y ^ 2 + A := by
  have hmod : p ^ (k + 2) = p ^ 2 * p ^ k := by rw [pow_add]; ring
  have hval : (p * y) ^ 2 + p ^ 2 * A = p ^ 2 * (y ^ 2 + A) := by ring
  rw [hmod, hval, Nat.mul_dvd_mul_iff_left (pow_pos hp 2)]

lemma rootResidues_square_scale_prime_pow (p A k : ℕ) (hp : p.Prime) :
    (polynomialRootResidues (X ^ 2 + C ((p ^ 2 * A : ℕ) : ℤ)) (p ^ (k + 2))).card =
      p * (polynomialRootResidues (X ^ 2 + C (A : ℤ)) (p ^ k)).card := by
  have hbij : ((Finset.range (p ^ (k + 1))).filter (fun y ↦ p ^ k ∣ y ^ 2 + A)).card =
      ((Finset.range (p ^ (k + 2))).filter (fun x ↦ p ^ (k + 2) ∣ x ^ 2 + p ^ 2 * A)).card := by
    apply Finset.card_nbij (fun y ↦ p * y)
    · intro y hy
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hy
      obtain ⟨hylt, hyd⟩ := hy
      have hpow : p ^ (k + 2) = p * p ^ (k + 1) := by rw [pow_succ']
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range]
      refine ⟨?_, (scaled_square_congruence p A k y hp.pos).mpr hyd⟩
      rw [hpow]
      exact Nat.mul_lt_mul_of_pos_left hylt hp.pos
    · intro x hx y hy hxy
      exact Nat.eq_of_mul_eq_mul_left hp.pos hxy
    · intro x hx
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hx
      have hdiv : p ∣ x ^ 2 + p ^ 2 * A := (dvd_pow_self p (by omega)).trans hx.2
      have hpA : p ∣ p ^ 2 * A := dvd_mul_of_dvd_left (dvd_pow_self p (by norm_num)) A
      have hpx : p ∣ x := hp.dvd_of_dvd_pow ((Nat.dvd_add_iff_left hpA).mpr hdiv)
      obtain ⟨y, rfl⟩ := hpx
      refine ⟨y, ?_, rfl⟩
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range]
      refine ⟨?_, (scaled_square_congruence p A k y hp.pos).mp hx.2⟩
      have hpow : p ^ (k + 2) = p * p ^ (k + 1) := by rw [pow_succ']
      rw [hpow, Nat.mul_lt_mul_left hp.pos] at hx
      exact hx.1
  rw [rootResidues_X_sq_add_C_nat, ← hbij]
  have hc := polynomial_root_count (X ^ 2 + C (A : ℤ)) (p ^ k) (p ^ (k + 1)) (pow_pos hp.pos k)
  simp only [eval_X_sq_add_C_nat, Int.natCast_dvd_natCast] at hc
  rw [Nat.pow_div (by omega) hp.pos, (show k + 1 - k = 1 by omega), pow_one,
    Nat.mod_eq_zero_of_dvd (pow_dvd_pow p (Nat.le_succ k))] at hc
  simpa only [Nat.not_lt_zero, Finset.filter_false, Finset.card_empty, add_zero] using hc

lemma rootResidues_X_sq_add_four_pow_two (m : ℕ) :
    (polynomialRootResidues (X ^ 2 + C ((4 ^ (m + 1) : ℕ) : ℤ)) 2).card = 1 := by
  have hd : 2 ∣ 4 ^ (m + 1) := (by decide : 2 ∣ 4).trans (dvd_pow_self 4 (by omega))
  have hnot : ¬2 ∣ 1 + 4 ^ (m + 1) := by
    intro h
    have h1 := (Nat.dvd_add_iff_left hd).mpr h
    norm_num at h1
  rw [rootResidues_X_sq_add_C_nat]
  norm_num [Finset.range_add_one, Finset.filter_insert, Finset.filter_singleton, hd, hnot]

lemma rootResidues_X_sq_add_four_pow_two_pow (m k : ℕ) :
    (polynomialRootResidues (X ^ 2 + C ((4 ^ m : ℕ) : ℤ)) (2 ^ k)).card =
      if k ≤ 2 * m + 1 then 2 ^ (k / 2) else 0 := by
  induction m generalizing k with
  | zero =>
    have he : (polynomialRootResidues (X ^ 2 + 1) (2 ^ k)).card = if k ≤ 1 then 1 else 0 := by
      have h := rootCount_X_sq_add_one_two_pow_real k
      change ((polynomialRootResidues (X ^ 2 + 1) (2 ^ k)).card : ℝ) = _ at h
      exact_mod_cast h
    simp only [pow_zero, Nat.cast_one, map_one, mul_zero, zero_add, he]
    split_ifs with hk
    · have hkdiv : k / 2 = 0 := by omega
      simp [hkdiv]
    · rfl
  | succ m ih =>
    rcases k with _ | k
    · simp [polynomialRootResidues]
    rcases k with _ | k
    · rw [show 2 ^ (0 + 1) = 2 by decide, rootResidues_X_sq_add_four_pow_two]
      norm_num
    · have he : 4 ^ (m + 1) = 2 ^ 2 * 4 ^ m := by rw [pow_succ']; rfl
      rw [he, rootResidues_square_scale_prime_pow 2 (4 ^ m) k Nat.prime_two, ih]
      have hbound : k + 1 + 1 ≤ 2 * (m + 1) + 1 ↔ k ≤ 2 * m + 1 := by omega
      have hexp : (k + 1 + 1) / 2 = k / 2 + 1 := by omega
      simp only [hbound, hexp, pow_succ']
      split_ifs <;> simp

lemma rootResidues_X_sq_add_four_pow_odd_prime_pow (m p k : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) :
    (polynomialRootResidues (X ^ 2 + C ((4 ^ m : ℕ) : ℤ)) (p ^ (k + 1))).card =
      (polynomialRootResidues (X ^ 2 + 1) (p ^ (k + 1))).card := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have hcop : Nat.Coprime 2 p := Nat.prime_two.coprime_iff_not_dvd.mpr
    (by have := hp.eq_two_or_odd.resolve_left hp2; omega)
  have hu : IsUnit (2 : ZMod (p ^ (k + 1))) :=
    (ZMod.isUnit_iff_coprime 2 (p ^ (k + 1))).mpr (hcop.pow_right (k + 1))
  rw [rootResidues_card_eq_modularRoot, rootResidues_card_eq_modularRoot]
  have he := Nat.card_congr (unitScaleSquareEquiv (hu.unit ^ m) (-1))
  have hpow : ((hu.unit ^ m).val) ^ 2 * (-1) = -((4 : ZMod (p ^ (k + 1))) ^ m) := by
    simp only [Units.val_pow_eq_pow_val, hu.unit_spec]
    rw [← pow_mul, mul_comm m 2, pow_mul]
    norm_num
  rw [hpow] at he
  simpa only [ModularRoot, eval₂_add, eval₂_pow, eval₂_X, eval₂_C, eval₂_one,
    Int.coe_castRingHom, Int.cast_natCast, Int.cast_pow, Int.cast_ofNat, Nat.cast_pow, Nat.cast_ofNat, add_eq_zero_iff_eq_neg] using he.symm

noncomputable def fourPowerKernel (m : ℕ) : ArithmeticFunction ℝ :=
  primePowerSequence 2 Nat.prime_two
    (fun k ↦ if k % 2 = 0 ∧ k / 2 ≤ m then (2 : ℝ) ^ (k / 2) else 0)

lemma fourPowerKernel_multiplicative (m : ℕ) : (fourPowerKernel m).IsMultiplicative := by
  apply primePowerSequence_multiplicative
  simp

lemma fourPowerKernel_pow (m k : ℕ) :
    fourPowerKernel m (2 ^ k) = if k % 2 = 0 ∧ k / 2 ≤ m then (2 : ℝ) ^ (k / 2) else 0 :=
  primePowerSequence_apply_pow _ _ _ k

lemma fourPowerKernel_summable (m : ℕ) : Summable (fun n : ℕ ↦ fourPowerKernel m n / (n : ℝ)) := by
  apply primePowerSequence_summable_div_of_bounded _ _ _ ((2 : ℝ) ^ m)
  intro k
  split_ifs with hk
  · rw [Real.norm_of_nonneg (by positivity)]
    exact pow_le_pow_right₀ (by norm_num) hk.2
  · simp only [norm_zero]; positivity

lemma fourPowerKernel_tsum_pos (m : ℕ) : 0 < ∑' n : ℕ, fourPowerKernel m n / (n : ℝ) := by
  apply primePowerSequence_tsum_pos
  · intro k; split_ifs <;> positivity
  · norm_num
  · exact (primePowerSequence_summable_div_iff _ _ _).mp (fourPowerKernel_summable m)

lemma fourPowerKernel_pair (m k : ℕ) :
    fourPowerKernel m (2 ^ (k + 1)) + fourPowerKernel m (2 ^ k) =
      if k + 1 ≤ 2 * m + 1 then (2 : ℝ) ^ ((k + 1) / 2) else 0 := by
  rw [fourPowerKernel_pow, fourPowerKernel_pow]
  by_cases hk : k % 2 = 0
  · have hk1 : (k + 1) % 2 = 1 := by omega
    have hdiv : (k + 1) / 2 = k / 2 := by omega
    have hbound : k / 2 ≤ m ↔ k + 1 ≤ 2 * m + 1 := by omega
    simp only [hk, hk1, hdiv, hbound]
    norm_num
  · have hk1 : (k + 1) % 2 = 0 := by omega
    have hbound : (k + 1) / 2 ≤ m ↔ k + 1 ≤ 2 * m + 1 := by omega
    simp only [hk, hk1, hbound]
    simp

lemma convolution_base_two_pow_succ (v : ArithmeticFunction ℝ) (k : ℕ) :
    (v * (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ)) (2 ^ (k + 1)) =
      v (2 ^ (k + 1)) + v (2 ^ k) := by
  rw [convolution_prime_pow _ _ 2 _ Nat.prime_two, Finset.sum_range_succ]
  have hsum : (∑ j ∈ Finset.range (k + 1), v (2 ^ j) *
      (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ) (2 ^ (k + 1 - j))) = v (2 ^ k) := by
    rw [Finset.sum_eq_single k]
    · rw [rootCount_X_sq_add_one_two_pow_real]
      have he : k + 1 - k = 1 := by omega
      simp [he]
    · intro j hj hjk
      rw [rootCount_X_sq_add_one_two_pow_real, if_neg (by simp only [Finset.mem_range] at hj; omega), mul_zero]
    · simp
  rw [hsum, rootCount_X_sq_add_one_two_pow_real]
  simp [add_comm]

lemma rootCount_X_sq_add_four_pow_convolution (m : ℕ) :
    (polynomialRootCount (X ^ 2 + C ((4 ^ m : ℕ) : ℤ)) : ArithmeticFunction ℝ) =
      fourPowerKernel m * (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ) := by
  apply (ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers _
    (polynomialRootCount_multiplicative _).natCast _
    ((fourPowerKernel_multiplicative m).mul (polynomialRootCount_multiplicative _).natCast)).mpr
  intro p k hp
  by_cases hp2 : p = 2
  · subst p
    rcases k with _ | k
    · rw [pow_zero, ArithmeticFunction.mul_apply_one, (fourPowerKernel_multiplicative m).map_one]
      simp [ArithmeticFunction.natCoe_apply, polynomialRootCount, polynomialRootResidues]
    · rw [convolution_base_two_pow_succ, fourPowerKernel_pair]
      change ((polynomialRootResidues (X ^ 2 + C ((4 ^ m : ℕ) : ℤ)) (2 ^ (k + 1))).card : ℝ) = _
      rw [rootResidues_X_sq_add_four_pow_two_pow]
      split_ifs <;> norm_cast
  · unfold fourPowerKernel
    rw [primePowerSequence_convolution_other_prime_pow _ 2 p k Nat.prime_two hp (Ne.symm hp2)
      (fun j ↦ if j % 2 = 0 ∧ j / 2 ≤ m then (2 : ℝ) ^ (j / 2) else 0) (by simp)]
    rcases k with _ | k
    · simp [polynomialRootCount, polynomialRootResidues]
    · simp only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk,
        rootResidues_X_sq_add_four_pow_odd_prime_pow m p k hp hp2]

lemma erdos975_X_sq_add_four_pow (m : ℕ) :
    ∃ c > (0 : ℝ),
      Tendsto (fun x ↦ Erdos975Sum (X ^ 2 + C ((4 ^ m : ℕ) : ℤ)) x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨κ, hκ, hH⟩ := root_harmonic_X_sq_add_one_limit
  let u : ArithmeticFunction ℝ := polynomialRootCount (X ^ 2 + 1)
  let c : ℝ := (∑' n : ℕ, fourPowerKernel m n / (n : ℝ)) * κ
  have hc : 0 < c := mul_pos (fourPowerKernel_tsum_pos m) hκ
  have hu : ∀ n, 0 ≤ u n := fun n ↦ Nat.cast_nonneg _
  have hlim := tendsto_harmonicWeightSum_convolution u (fourPowerKernel m) hu κ hH
    (fourPowerKernel_summable m).norm
  change Tendsto (fun N : ℕ ↦ harmonicWeightSum
    (fourPowerKernel m * (polynomialRootCount (X ^ 2 + 1) : ArithmeticFunction ℝ) : ArithmeticFunction ℝ)
      N / log N) atTop (𝓝 c) at hlim
  rw [← rootCount_X_sq_add_four_pow_convolution] at hlim
  refine ⟨2 * c, mul_pos (by norm_num) hc, ?_⟩
  have ht := erdos975_quadratic_nat_of_harmonic 1 0 (4 ^ m) (by norm_num) c ?_
  · simpa only [quadraticPolynomial, Nat.cast_one, map_one, one_mul, Nat.cast_zero, map_zero,
      zero_mul, add_zero] using ht
  · simpa only [quadraticPolynomial, Nat.cast_one, map_one, one_mul, Nat.cast_zero, map_zero,
      zero_mul, add_zero, ArithmeticFunction.natCoe_apply, polynomialRootCount,
      ArithmeticFunction.coe_mk] using hlim

lemma erdos975_X_sq_add_four_pow_translate (m : ℕ) (k : ℤ) :
    ∃ c > (0 : ℝ), Tendsto (fun x ↦
      Erdos975Sum ((X ^ 2 + C ((4 ^ m : ℕ) : ℤ)).comp (X + C k)) x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨c, hc, hlim⟩ := erdos975_X_sq_add_four_pow m
  exact ⟨c, hc, (erdos975_shift_int_iff _ k c).mp hlim⟩


/- The general-degree obstruction: divisors between `n` and `sqrt (f n)`. -/

noncomputable def polynomialInitialDivisorSum (f : ℤ[X]) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Iic N,
    (((Finset.Icc 1 n).filter (fun d : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ)

lemma polynomialInitialDivisorSum_swap (f : ℤ[X]) (N : ℕ) :
    polynomialInitialDivisorSum f N =
      ∑ d ∈ Finset.Icc 1 N,
        (((Finset.Iic N).filter (fun n : ℕ ↦ d ≤ n ∧ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ) := by
  unfold polynomialInitialDivisorSum
  have hs : ∀ n ∈ Finset.Iic N,
      (Finset.Icc 1 n).filter (fun d : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ)) =
        (Finset.Icc 1 N).filter (fun d : ℕ ↦ d ≤ n ∧ (d : ℤ) ∣ f.eval (n : ℤ)) := by
    intro n hn
    have hnN := Finset.mem_Iic.mp hn
    ext d
    simp only [Finset.mem_filter, Finset.mem_Icc]
    omega
  calc
    _ = ∑ n ∈ Finset.Iic N,
        (((Finset.Icc 1 N).filter (fun d : ℕ ↦ d ≤ n ∧ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ) := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [hs n hn]
    _ = _ := by
      simp only [Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
      exact Finset.sum_comm

lemma polynomialTruncatedSum_initial_identity (f : ℤ[X]) (N : ℕ) :
    polynomialTruncatedSum f N N = polynomialInitialDivisorSum f N +
      ∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues f d).card : ℝ) := by
  rw [polynomialInitialDivisorSum_swap, ← Finset.sum_add_distrib]
  unfold polynomialTruncatedSum
  apply Finset.sum_congr rfl
  intro d hd
  have hdN := (Finset.mem_Icc.mp hd).2
  let S := (Finset.Iic N).filter (fun n : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))
  have hgood : S.filter (fun n ↦ d ≤ n) =
      (Finset.Iic N).filter (fun n : ℕ ↦ d ≤ n ∧ (d : ℤ) ∣ f.eval (n : ℤ)) := by
    ext n
    simp only [S, Finset.mem_filter]
    tauto
  have hbad : S.filter (fun n ↦ ¬d ≤ n) = polynomialRootResidues f d := by
    ext n
    simp only [S, polynomialRootResidues, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range]
    omega
  have hc := Finset.card_filter_add_card_filter_not (s := S) (fun n ↦ d ≤ n)
  rw [hgood, hbad] at hc
  exact_mod_cast hc.symm

lemma polynomialInitialDivisorSum_error (f : ℤ[X]) (N : ℕ) :
    |polynomialInitialDivisorSum f N - (N + 1 : ℝ) *
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N| ≤
      2 * ∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues f d).card : ℝ) := by
  have he := polynomialTruncatedSum_error f N N
  rw [polynomialTruncatedSum_initial_identity, abs_le] at he
  have hR : 0 ≤ ∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues f d).card : ℝ) := by positivity
  rw [abs_le]
  constructor <;> linarith

lemma tendsto_polynomialInitialDivisorSum (f : ℤ[X]) (κ : ℝ)
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 κ)) :
    Tendsto (fun N : ℕ ↦ polynomialInitialDivisorSum f N / ((N : ℝ) * log N))
      atTop (𝓝 κ) := by
  let u : ℕ → ℝ := fun d ↦ (polynomialRootResidues f d).card
  have hR := tendsto_sum_div_mul_log_of_harmonic u (fun _ ↦ Nat.cast_nonneg _) κ h
  have hErr : Tendsto (fun N : ℕ ↦
      (polynomialInitialDivisorSum f N - (N + 1 : ℝ) * harmonicWeightSum u N) /
        ((N : ℝ) * log N)) atTop (𝓝 0) := by
    have hb := hR.const_mul 2
    simp only [mul_zero] at hb
    apply squeeze_zero_norm' _ hb
    filter_upwards [eventually_gt_atTop (1 : ℕ)] with N hN
    have hden : 0 < (N : ℝ) * log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
      (Real.log_pos (by exact_mod_cast hN))
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hden]
    exact (div_le_div_of_nonneg_right (polynomialInitialDivisorSum_error f N) hden.le).trans_eq
      (by ring)
  have hNreal : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hq : Tendsto (fun N : ℕ ↦ (N + 1 : ℝ) / N) atTop (𝓝 1) := by
    have ht := (hNreal.const_div_atTop (1 : ℝ)).const_add 1
    simp only [add_zero] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hNne : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
    field_simp
  have ht := hErr.add (hq.mul h)
  simp only [one_mul, zero_add] at ht
  apply ht.congr
  intro N
  ring

noncomputable def Erdos975BalancedDivisorSum (f : ℤ[X]) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Iic N, (((⌊f.eval (n : ℤ)⌋₊).divisors.filter
    (fun d ↦ n < d ∧ d ≤ (⌊f.eval (n : ℤ)⌋₊).sqrt)).card : ℝ)

lemma balancedDivisorSum_nonneg (f : ℤ[X]) (N : ℕ) :
    0 ≤ Erdos975BalancedDivisorSum f N := by
  exact Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)

lemma small_divisors_initial_split (z : ℤ) (n : ℕ) (hz : (n : ℤ) ^ 2 ≤ z) :
    (⌊z⌋₊.divisors.filter (fun d ↦ d ≤ ⌊z⌋₊.sqrt)).card =
      ((Finset.Icc 1 n).filter (fun d : ℕ ↦ (d : ℤ) ∣ z)).card +
        (⌊z⌋₊.divisors.filter (fun d ↦ n < d ∧ d ≤ ⌊z⌋₊.sqrt)).card := by
  let S := ⌊z⌋₊.divisors.filter (fun d ↦ d ≤ ⌊z⌋₊.sqrt)
  have hgood : S.filter (fun d ↦ d ≤ n) =
      (Finset.Icc 1 n).filter (fun d : ℕ ↦ (d : ℤ) ∣ z) := by
    have hz0 : 0 ≤ z := (sq_nonneg _).trans hz
    lift z to ℕ using hz0
    ext d
    simp only [S, Nat.floor_natCast, Finset.mem_filter, Nat.mem_divisors, Finset.mem_Icc,
      Int.natCast_dvd_natCast]
    constructor
    · rintro ⟨⟨⟨hd, hz⟩, hs⟩, hdn⟩
      exact ⟨⟨Nat.pos_of_mem_divisors (Nat.mem_divisors.mpr ⟨hd, hz⟩), hdn⟩, hd⟩
    · rintro ⟨⟨hdpos, hdn⟩, hd⟩
      have hsq : n ^ 2 ≤ z := by exact_mod_cast hz
      have hd2 : d ^ 2 ≤ z := (Nat.pow_le_pow_left hdn 2).trans hsq
      have hzpos : 0 < z := lt_of_lt_of_le (pow_pos hdpos 2) hd2
      exact ⟨⟨⟨hd, hzpos.ne'⟩, Nat.le_sqrt'.mpr hd2⟩, hdn⟩
  have hbad : S.filter (fun d ↦ ¬d ≤ n) =
      ⌊z⌋₊.divisors.filter (fun d ↦ n < d ∧ d ≤ ⌊z⌋₊.sqrt) := by
    ext d
    simp only [S, Finset.mem_filter, not_le]
    tauto
  have hc := Finset.card_filter_add_card_filter_not (s := S) (fun d ↦ d ≤ n)
  rw [hgood, hbad] at hc
  exact hc.symm

lemma smallDivisorSum_initial_split (f : ℤ[X]) (N : ℕ)
    (hlower : ∀ n ≤ N, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ)) :
    Erdos975SmallDivisorSum f N =
      polynomialInitialDivisorSum f N + Erdos975BalancedDivisorSum f N := by
  simp only [Erdos975SmallDivisorSum, polynomialInitialDivisorSum, Erdos975BalancedDivisorSum,
    Nat.floor_natCast, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  exact_mod_cast small_divisors_initial_split (f.eval (n : ℤ)) n (hlower n (Finset.mem_Iic.mp hn))


lemma tendsto_sum_Iic_div_mul_log_of_eventually_zero (u : ℕ → ℝ)
    (hu : ∀ᶠ n in atTop, u n = 0) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.Iic N, u n) / ((N : ℝ) * log N))
      atTop (𝓝 0) := by
  obtain ⟨K, hK⟩ := eventually_atTop.mp hu
  have he : ∀ᶠ N : ℕ in atTop, (∑ n ∈ Finset.Iic N, u n) = ∑ n ∈ Finset.range K, u n := by
    filter_upwards [eventually_ge_atTop K] with N hN
    symm
    apply Finset.sum_subset
    · intro n hn
      exact Finset.mem_Iic.mpr (le_trans (Finset.mem_range.mp hn).le hN)
    · intro n hn hnK
      exact hK n (by simpa using hnK)
  have hN : Tendsto (fun N : ℕ ↦ (N : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hden := hN.atTop_mul_atTop₀ (Real.tendsto_log_atTop.comp hN)
  apply (hden.const_div_atTop (∑ n ∈ Finset.range K, u n)).congr'
  filter_upwards [he] with N hN
  simp only [hN, Function.comp_apply]

lemma tendsto_smallDivisorSum_initial_error (f : ℤ[X])
    (hlower : ∀ᶠ n : ℕ in atTop, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ)) :
    Tendsto (fun N : ℕ ↦
      (Erdos975SmallDivisorSum f N - polynomialInitialDivisorSum f N -
        Erdos975BalancedDivisorSum f N) / ((N : ℝ) * log N)) atTop (𝓝 0) := by
  let u : ℕ → ℝ := fun n ↦
    (((⌊f.eval (n : ℤ)⌋₊).divisors.filter (fun d ↦ d ≤ (⌊f.eval (n : ℤ)⌋₊).sqrt)).card : ℝ) -
    (((Finset.Icc 1 n).filter (fun d : ℕ ↦ (d : ℤ) ∣ f.eval (n : ℤ))).card : ℝ) -
    (((⌊f.eval (n : ℤ)⌋₊).divisors.filter
      (fun d ↦ n < d ∧ d ≤ (⌊f.eval (n : ℤ)⌋₊).sqrt)).card : ℝ)
  have hu : ∀ᶠ n in atTop, u n = 0 := by
    filter_upwards [hlower] with n hn
    have he := small_divisors_initial_split (f.eval (n : ℤ)) n hn
    dsimp only [u]
    rw [he, Nat.cast_add]
    ring
  simpa only [u, Erdos975SmallDivisorSum, polynomialInitialDivisorSum, Erdos975BalancedDivisorSum,
    Nat.floor_natCast, Finset.sum_sub_distrib] using tendsto_sum_Iic_div_mul_log_of_eventually_zero u hu

lemma tendsto_erdos975Sum_iff_small_nat (f : ℤ[X]) (c : ℝ) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun N : ℕ ↦ Erdos975SmallDivisorSum f N / ((N : ℝ) * log N))
      atTop (𝓝 (c / 2)) := by
  rw [tendsto_erdos975Sum_iff_nat]
  have hs := (tendsto_squareCorrection f).comp tendsto_natCast_atTop_atTop
  constructor
  · intro h
    have ht := (h.add hs).div_const 2
    simp only [add_zero] at ht
    apply ht.congr
    intro N
    have he := erdos975Sum_hyperbola f (N : ℝ)
    dsimp only [Function.comp_def]
    rw [← add_div, he]
    ring
  · intro h
    have ht := (h.const_mul 2).sub hs
    have hc : 2 * (c / 2) - 0 = c := by ring
    rw [hc] at ht
    apply ht.congr
    intro N
    have he := congrArg (fun y : ℝ ↦ y / ((N : ℝ) * log N)) (erdos975Sum_hyperbola f N)
    simp only [add_div, mul_div_assoc] at he
    dsimp only [Function.comp_def]
    linarith

/-- Given the modular-root harmonic asymptotic, the remaining obstruction in degree at
least three is convergence of the contribution of divisors `n < d ≤ sqrt (f n)`. -/
lemma erdos975_iff_balanced_of_harmonic (f : ℤ[X]) (κ c : ℝ)
    (hlower : ∀ᶠ n : ℕ in atTop, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 κ)) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun N : ℕ ↦ Erdos975BalancedDivisorSum f N / ((N : ℝ) * log N))
      atTop (𝓝 (c / 2 - κ)) := by
  rw [tendsto_erdos975Sum_iff_small_nat]
  have hA := tendsto_polynomialInitialDivisorSum f κ h
  have hE := tendsto_smallDivisorSum_initial_error f hlower
  constructor
  · intro hS
    have ht := (hS.sub hA).sub hE
    simp only [sub_zero] at ht
    apply ht.congr
    intro N
    ring
  · intro hB
    have ht := (hA.add hB).add hE
    have hc : κ + (c / 2 - κ) + 0 = c / 2 := by ring
    rw [hc] at ht
    apply ht.congr
    intro N
    ring

lemma erdos975_limit_ge_of_harmonic (f : ℤ[X]) (κ c : ℝ)
    (hlower : ∀ᶠ n : ℕ in atTop, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ))
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 κ))
    (hc : Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c)) :
    2 * κ ≤ c := by
  have hB := (erdos975_iff_balanced_of_harmonic f κ c hlower h).mp hc
  have hnonneg : ∀ᶠ N : ℕ in atTop,
      0 ≤ Erdos975BalancedDivisorSum f N / ((N : ℝ) * log N) := by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with N hN
    exact div_nonneg (balancedDivisorSum_nonneg f N)
      (mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg (by exact_mod_cast hN)))
  have h0 := ge_of_tendsto hB hnonneg
  linarith


lemma leadingCoeff_pos_of_eventually_positive (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) : 0 < f.leadingCoeff := by
  let P : ℝ[X] := f.map (Int.castRingHom ℝ)
  have hPdeg : P.natDegree = f.natDegree := natDegree_map_eq_of_injective Int.cast_injective f
  have hPlead : P.leadingCoeff = (f.leadingCoeff : ℝ) :=
    leadingCoeff_map_of_injective Int.cast_injective f
  have heval : ∀ n : ℕ, P.eval (n : ℝ) = (↑(f.eval (n : ℤ)) : ℝ) := by
    intro n
    simpa only [P, eval_map, Int.coe_castRingHom, Int.cast_natCast] using
      (eval₂_at_apply (Int.castRingHom ℝ) (n : ℤ) (p := f))
  have hPdeg0 : 0 < P.degree := natDegree_pos_iff_degree_pos.mp (by omega)
  by_contra hneg
  have hlead : P.leadingCoeff ≤ 0 := by rw [hPlead]; exact_mod_cast (le_of_not_gt hneg)
  have hbot := (P.tendsto_atBot_of_leadingCoeff_nonpos hPdeg0 hlead).comp
    (tendsto_natCast_atTop_atTop (R := ℝ))
  have hposN := (tendsto_natCast_atTop_atTop (R := ℤ)).eventually hpos
  obtain ⟨n, hnneg, hnpos⟩ := ((hbot.eventually_lt_atBot 0).and hposN).exists
  have hnneg' : (↑(f.eval (n : ℤ)) : ℝ) < 0 := by simpa only [Function.comp_def, heval] using hnneg
  have hnpos' : (1 : ℝ) ≤ ↑(f.eval (n : ℤ)) := by exact_mod_cast hnpos
  linarith

lemma eventually_eval_ge_square_of_degree_gt_two (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∀ᶠ n : ℕ in atTop, (n : ℤ) ^ 2 ≤ f.eval (n : ℤ) := by
  let P : ℝ[X] := f.map (Int.castRingHom ℝ)
  have hPdeg : P.natDegree = f.natDegree := natDegree_map_eq_of_injective Int.cast_injective f
  have hPlead : P.leadingCoeff = (f.leadingCoeff : ℝ) :=
    leadingCoeff_map_of_injective Int.cast_injective f
  have heval : ∀ n : ℕ, P.eval (n : ℝ) = (↑(f.eval (n : ℤ)) : ℝ) := by
    intro n
    simpa only [P, eval_map, Int.coe_castRingHom, Int.cast_natCast] using
      (eval₂_at_apply (Int.castRingHom ℝ) (n : ℤ) (p := f))
  have hlead : 0 < P.leadingCoeff := by
    rw [hPlead]
    exact_mod_cast leadingCoeff_pos_of_eventually_positive f (by omega) hpos
  have hdegrees : (X ^ 2 : ℝ[X]).degree < P.degree := by
    apply degree_lt_degree
    simpa only [natDegree_X_pow, hPdeg] using hdeg
  have hQdeg : 0 < (P - X ^ 2).degree := by
    rw [degree_sub_eq_left_of_degree_lt hdegrees]
    apply natDegree_pos_iff_degree_pos.mp
    omega
  have hQlead : 0 ≤ (P - X ^ 2).leadingCoeff := by
    rw [leadingCoeff_sub_of_degree_lt hdegrees]
    exact hlead.le
  have ht := ((P - X ^ 2).tendsto_atTop_of_leadingCoeff_nonneg hQdeg hQlead).comp
    (tendsto_natCast_atTop_atTop (R := ℝ))
  filter_upwards [ht.eventually_ge_atTop 0] with n hn
  simp only [Function.comp_def, eval_sub, eval_pow, eval_X, heval, sub_nonneg] at hn
  exact_mod_cast hn

lemma erdos975_degree_gt_two_iff_balanced (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ c : ℝ)
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 κ)) :
    Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) ↔
    Tendsto (fun N : ℕ ↦ Erdos975BalancedDivisorSum f N / ((N : ℝ) * log N))
      atTop (𝓝 (c / 2 - κ)) :=
  erdos975_iff_balanced_of_harmonic f κ c
    (eventually_eval_ge_square_of_degree_gt_two f hdeg hpos) h


lemma erdos975_degree_gt_two_of_balanced_limit (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ) (hκ : 0 < κ)
    (h : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 κ))
    (hbalanced : ∃ β : ℝ,
      Tendsto (fun N : ℕ ↦ Erdos975BalancedDivisorSum f N / ((N : ℝ) * log N))
        atTop (𝓝 β)) :
    ∃ c > (0 : ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨β, hβ⟩ := hbalanced
  have hnonneg : ∀ᶠ N : ℕ in atTop,
      0 ≤ Erdos975BalancedDivisorSum f N / ((N : ℝ) * log N) := by
    filter_upwards [eventually_ge_atTop (1 : ℕ)] with N hN
    exact div_nonneg (balancedDivisorSum_nonneg f N)
      (mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg (by exact_mod_cast hN)))
  have hβ0 : 0 ≤ β := ge_of_tendsto hβ hnonneg
  refine ⟨2 * (κ + β), by linarith, ?_⟩
  apply (erdos975_degree_gt_two_iff_balanced f hdeg hpos κ _ h).mpr
  have he : 2 * (κ + β) / 2 - κ = β := by ring
  rwa [he]


/- Number-field root-count infrastructure. -/

lemma tendsto_logarithmic_average (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto u atTop (𝓝 c)) :
    Tendsto (fun N : ℕ ↦ (∑ k ∈ Finset.range N, u k / (k + 1 : ℝ)) / log N)
      atTop (𝓝 c) := by
  let w : ℕ → ℝ := fun k ↦ 1 / (k + 1 : ℝ)
  have hw : ∀ N, (∑ k ∈ Finset.range N, w k) = (harmonic N : ℝ) := by
    intro N
    simp [w, harmonic, Rat.cast_sum, Rat.cast_inv]
  have he : (fun k ↦ (u k - c) * w k) =o[atTop] w := by
    have hzero := (Asymptotics.isLittleO_one_iff ℝ).mpr (tendsto_sub_nhds_zero_iff.mpr h)
    simpa only [one_mul] using hzero.mul_isBigO (Asymptotics.isBigO_refl w atTop)
  have hes := he.sum_range (fun k ↦ by dsimp [w]; positivity)
    Real.tendsto_sum_range_one_div_nat_succ_atTop
  have heh := hes.tendsto_div_nhds_zero
  simp only [hw] at heh
  have he0 := heh.mul tendsto_harmonic_div_log
  simp only [zero_mul] at he0
  have hErr : Tendsto (fun N : ℕ ↦ (∑ k ∈ Finset.range N, (u k - c) * w k) / log N)
      atTop (𝓝 0) := by
    apply he0.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hH : (harmonic N : ℝ) ≠ 0 := by
      have hp : 0 < harmonic N := harmonic_pos hN.ne'
      exact_mod_cast hp.ne'
    field_simp
  have ht := hErr.add (tendsto_harmonic_div_log.const_mul c)
  simp only [mul_one, zero_add] at ht
  apply ht.congr
  intro N
  rw [← hw]
  simp only [w, div_eq_mul_inv, one_mul, sub_mul, Finset.sum_sub_distrib, ← Finset.mul_sum]
  ring

lemma harmonicWeightSum_partial_summation (u : ℕ → ℝ) (N : ℕ) :
    harmonicWeightSum u N =
      (∑ n ∈ Finset.Icc 1 N, u n) / (N + 1 : ℝ) +
        ∑ k ∈ Finset.range N, (∑ n ∈ Finset.Icc 1 (k + 1), u n) /
          ((k + 1 : ℝ) * (k + 2 : ℝ)) := by
  induction N with
  | zero => simp [harmonicWeightSum]
  | succ N ih =>
    rw [harmonicWeightSum, Finset.sum_Icc_succ_top (by omega), ← harmonicWeightSum, ih,
      Finset.sum_range_succ, Finset.sum_Icc_succ_top (by omega)]
    push_cast
    have hN1 : (N + 1 : ℝ) ≠ 0 := by positivity
    have hN2 : (N + 2 : ℝ) ≠ 0 := by positivity
    field_simp
    ring

lemma tendsto_nat_div_succ :
    Tendsto (fun N : ℕ ↦ (N : ℝ) / (N + 1)) atTop (𝓝 1) := by
  have hN : Tendsto (fun N : ℕ ↦ (N : ℝ) + 1) atTop atTop :=
    tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds
  have ht := (hN.const_div_atTop (1 : ℝ)).const_sub 1
  simp only [sub_zero] at ht
  apply ht.congr
  intro N
  have hN1 : (N + 1 : ℝ) ≠ 0 := by positivity
  field_simp
  ring

lemma tendsto_harmonicWeightSum_of_sum_div (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.Icc 1 N, u n) / (N : ℝ)) atTop (𝓝 c)) :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum u N / log N) atTop (𝓝 c) := by
  let A : ℕ → ℝ := fun N ↦ ∑ n ∈ Finset.Icc 1 N, u n
  have hA : Tendsto (fun N : ℕ ↦ A N / (N + 1 : ℝ)) atTop (𝓝 c) := by
    have ht := h.mul tendsto_nat_div_succ
    simp only [mul_one] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
    dsimp [A]
    field_simp
  have hAl : Tendsto (fun k : ℕ ↦ A (k + 1) / (k + 2 : ℝ)) atTop (𝓝 c) := by
    simpa only [Function.comp_def, Nat.cast_add, Nat.cast_one, add_assoc, one_add_one_eq_two]
      using hA.comp (tendsto_add_atTop_nat 1)
  have hmean := tendsto_logarithmic_average _ c hAl
  have hB := hA.div_atTop (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)
  have ht := hB.add hmean
  simp only [zero_add] at ht
  apply ht.congr
  intro N
  rw [harmonicWeightSum_partial_summation, add_div]
  congr 1
  congr 1
  apply Finset.sum_congr rfl
  intro k hk
  dsimp only [A]
  rw [div_div, mul_comm]

open scoped NumberField

lemma ideal_count_sum_div_limit (K : Type*) [Field K] [NumberField K] :
    Tendsto (fun N : ℕ ↦
      (∑ n ∈ Finset.Icc 1 N, (Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = n} : ℝ)) / N)
      atTop (𝓝 (NumberField.dedekindZeta_residue K)) := by
  refine ((NumberField.Ideal.tendsto_norm_le_div_atTop₀ K).comp
    tendsto_natCast_atTop_atTop).congr fun N ↦ ?_
  simp only [Function.comp_apply, Nat.cast_le, ← Nat.cast_sum]
  congr 1
  norm_cast
  rw [← add_left_inj 1, ← Ideal.card_norm_le_eq_card_norm_le_add_one,
    show Finset.Icc 1 N = Finset.Ioc 0 N from Finset.Icc_succ_left_eq_Ioc _ _,
    show 1 = Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = 0} by simp [Ideal.absNorm_eq_zero_iff],
    Finset.sum_Ioc_add_eq_sum_Icc (N.zero_le),
    ← Finset.card_preimage_eq_sum_card_image_eq (fun k _ ↦ Ideal.finite_setOf_absNorm_eq k)]
  simp [Set.coe_eq_subtype]

lemma ideal_count_harmonic_limit (K : Type*) [Field K] [NumberField K] :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum
      (fun n ↦ (Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = n} : ℝ)) N / log N)
      atTop (𝓝 (NumberField.dedekindZeta_residue K)) :=
  tendsto_harmonicWeightSum_of_sum_div _ _ (ideal_count_sum_div_limit K)


noncomputable def monicLinearFactorEquivRoot {F : Type*} [Field F] [DecidableEq F]
    (f : F[X]) (hf : f ≠ 0) :
    {q : (UniqueFactorizationMonoid.normalizedFactors f).toFinset // (q : F[X]).natDegree = 1} ≃
      {x : F // f.eval x = 0} where
  toFun q := ⟨-q.val.val.coeff 0, by
    have hq := (Polynomial.mem_normalizedFactors_iff (p := q.val.val) hf).mp
      (by simpa only [Multiset.mem_toFinset] using q.val.property)
    have he : q.val.val = X - C (-q.val.val.coeff 0) := by
      simpa using hq.2.1.eq_X_add_C q.property
    exact dvd_iff_isRoot.mp (he ▸ hq.2.2)⟩
  invFun x := ⟨⟨X - C x.val, by
    simpa only [Multiset.mem_toFinset] using (Polynomial.mem_normalizedFactors_iff hf).mpr
      ⟨irreducible_X_sub_C x.val, monic_X_sub_C x.val, dvd_iff_isRoot.mpr x.property⟩⟩,
    natDegree_X_sub_C x.val⟩
  left_inv q := by
    apply Subtype.ext
    apply Subtype.ext
    have hq := (Polynomial.mem_normalizedFactors_iff (p := q.val.val) hf).mp
      (by simpa only [Multiset.mem_toFinset] using q.val.property)
    simpa using (hq.2.1.eq_X_add_C q.property).symm
  right_inv x := by
    apply Subtype.ext
    simp

noncomputable def idealNormPrimeEquivPrimeOverDegreeOne
    (K : Type*) [Field K] [NumberField K] (p : ℕ) (hp : p.Prime) :
    {I : Ideal (𝓞 K) // Ideal.absNorm I = p} ≃
      {P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K) //
        (Ideal.span {(p : ℤ)}).inertiaDeg (P : Ideal (𝓞 K)) = 1} where
  toFun I := by
    have hnormprime : (Ideal.absNorm I.val).Prime := by rwa [I.property]
    have hprime : I.val.IsPrime := Ideal.isPrime_of_irreducible_absNorm
      ((Nat.irreducible_iff_nat_prime _).mpr hnormprime)
    have hlies : I.val.LiesOver (Ideal.span {(p : ℤ)}) := by
      apply Ideal.LiesOver.mk
      simpa only [I.property, Ideal.under_def] using Ideal.span_singleton_absNorm hnormprime
    let P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K) := ⟨I.val, hprime, hlies⟩
    refine ⟨P, ?_⟩
    haveI := hlies
    have he := Ideal.absNorm_eq_pow_inertiaDeg' I.val hp
    apply Nat.pow_right_injective hp.two_le
    simpa only [pow_one, I.property] using he.symm
  invFun P := ⟨P.val.val, by
    rw [Ideal.absNorm_eq_pow_inertiaDeg' _ hp, P.property, pow_one]⟩
  left_inv I := by rfl
  right_inv P := by rfl

lemma rootResidues_minpoly_prime_eq_ideal_count
    (K : Type*) [Field K] [NumberField K] (θ : 𝓞 K) (p : ℕ) [Fact p.Prime]
    (hp : ¬p ∣ RingOfIntegers.exponent θ) :
    (polynomialRootResidues (minpoly ℤ θ) p).card =
      Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = p} := by
  let E := NumberField.Ideal.primesOverSpanEquivMonicFactorsMod hp
  have hdegree : ∀ P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K),
      (Ideal.span {(p : ℤ)}).inertiaDeg (P : Ideal (𝓞 K)) = 1 ↔
        ((E P : RingOfIntegers.monicFactorsMod θ p) : (ZMod p)[X]).natDegree = 1 := by
    intro P
    have he := NumberField.Ideal.inertiaDeg_primesOverSpanEquivMonicFactorsMod_symm_apply'
      hp (E P).property
    change (Ideal.span {(p : ℤ)}).inertiaDeg (E.symm (E P) : Ideal (𝓞 K)) =
      ((E P : RingOfIntegers.monicFactorsMod θ p) : (ZMod p)[X]).natDegree at he
    rw [Equiv.symm_apply_apply] at he
    rw [he]
  let E' : {P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K) //
      (Ideal.span {(p : ℤ)}).inertiaDeg (P : Ideal (𝓞 K)) = 1} ≃
      {q : RingOfIntegers.monicFactorsMod θ p // (q : (ZMod p)[X]).natDegree = 1} :=
    E.subtypeEquiv hdegree
  let f : (ZMod p)[X] := (minpoly ℤ θ).map (Int.castRingHom (ZMod p))
  have hf : f ≠ 0 := map_monic_ne_zero (minpoly.monic θ.isIntegral)
  rw [rootResidues_card_eq_modularRoot]
  calc
    Nat.card (ModularRoot (minpoly ℤ θ) p) = Nat.card {x : ZMod p // f.eval x = 0} := by
      simp only [f, ModularRoot, eval_map]
    _ = Nat.card {q : (UniqueFactorizationMonoid.normalizedFactors f).toFinset //
        (q : (ZMod p)[X]).natDegree = 1} := (Nat.card_congr (monicLinearFactorEquivRoot f hf)).symm
    _ = Nat.card {P : (Ideal.span {(p : ℤ)}).primesOver (𝓞 K) //
        (Ideal.span {(p : ℤ)}).inertiaDeg (P : Ideal (𝓞 K)) = 1} := (Nat.card_congr E').symm
    _ = _ := (Nat.card_congr (idealNormPrimeEquivPrimeOverDegreeOne K p (Fact.out : p.Prime))).symm


lemma ideal_sup_product_of_coprime {R : Type*} [CommRing R] (I A B : Ideal R)
    (hAB : A ⊔ B = ⊤) (hprod : A * B ≤ I) : (I ⊔ A) * (I ⊔ B) = I := by
  apply le_antisymm
  · rw [Ideal.mul_sup, Ideal.sup_mul, Ideal.sup_mul]
    exact sup_le (sup_le Ideal.mul_le_right Ideal.mul_le_left)
      (sup_le Ideal.mul_le_right hprod)
  · calc
      I = I * (A ⊔ B) := by rw [hAB, Ideal.mul_top]
      _ = I * A ⊔ I * B := Ideal.mul_sup _ _ _
      _ ≤ (I ⊔ A) * (I ⊔ B) := by
        apply sup_le
        · rw [mul_comm I A]
          exact Ideal.mul_mono le_sup_right le_sup_left
        · exact Ideal.mul_mono le_sup_left le_sup_right

lemma ideal_absNorm_span_nat (K : Type*) [Field K] [NumberField K] (a : ℕ) :
    Ideal.absNorm (Ideal.span {(a : 𝓞 K)}) = a ^ Module.finrank ℤ (𝓞 K) := by
  rw [Ideal.absNorm_span_singleton]
  have he := Algebra.norm_algebraMap_of_basis (Module.Free.chooseBasis ℤ (𝓞 K)) (a : ℤ)
  rw [← Module.finrank_eq_card_basis (Module.Free.chooseBasis ℤ (𝓞 K))] at he
  simpa only [map_natCast, Int.natAbs_pow, Int.natAbs_natCast] using congrArg Int.natAbs he

lemma ideal_eq_of_le_of_norm_eq (K : Type*) [Field K] [NumberField K]
    (I J : Ideal (𝓞 K)) (hIJ : I ≤ J) (h : Ideal.absNorm I = Ideal.absNorm J)
    (hJ : Ideal.absNorm J ≠ 0) : I = J := by
  obtain ⟨L, hL⟩ := Ideal.dvd_iff_le.mpr hIJ
  have hn : Ideal.absNorm L = 1 := by
    have he : Ideal.absNorm J * Ideal.absNorm L = Ideal.absNorm J * 1 := by
      rw [← map_mul, ← hL, h, mul_one]
    exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hJ) he
  rw [Ideal.absNorm_eq_one_iff] at hn
  rw [hL, hn, Ideal.mul_top]

lemma ideal_absNorm_sup_span_of_coprime (K : Type*) [Field K] [NumberField K]
    (I : Ideal (𝓞 K)) (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b)
    (hI : Ideal.absNorm I = a * b) :
    Ideal.absNorm (I ⊔ Ideal.span {(a : 𝓞 K)}) = a ∧
      Ideal.absNorm (I ⊔ Ideal.span {(b : 𝓞 K)}) = b := by
  let A : Ideal (𝓞 K) := Ideal.span {(a : 𝓞 K)}
  let B : Ideal (𝓞 K) := Ideal.span {(b : 𝓞 K)}
  have hAB : A ⊔ B = ⊤ := by
    apply Ideal.isCoprime_iff_sup_eq.mp
    apply (Ideal.isCoprime_span_singleton_iff _ _).mpr
    simpa only [map_natCast] using hab.isCoprime.map (Int.castRingHom (𝓞 K))
  have hprod : A * B ≤ I := by
    change Ideal.span {(a : 𝓞 K)} * Ideal.span {(b : 𝓞 K)} ≤ I
    rw [Ideal.span_singleton_mul_span_singleton, ← Nat.cast_mul, ← hI]
    exact Ideal.span_singleton_absNorm_le I
  have he := congrArg Ideal.absNorm (ideal_sup_product_of_coprime I A B hAB hprod)
  rw [map_mul, hI] at he
  have hA : Ideal.absNorm (I ⊔ A) ∣ a ^ Module.finrank ℤ (𝓞 K) := by
    rw [← ideal_absNorm_span_nat K a]
    exact Ideal.absNorm_dvd_absNorm_of_le le_sup_right
  have hB : Ideal.absNorm (I ⊔ B) ∣ b ^ Module.finrank ℤ (𝓞 K) := by
    rw [← ideal_absNorm_span_nat K b]
    exact Ideal.absNorm_dvd_absNorm_of_le le_sup_right
  have hAa : Ideal.absNorm (I ⊔ A) ∣ a :=
    (Nat.Coprime.of_dvd_left hA (hab.pow_left _)).dvd_of_dvd_mul_right
      (he ▸ dvd_mul_right _ _)
  have hBb : Ideal.absNorm (I ⊔ B) ∣ b :=
    (Nat.Coprime.of_dvd_left hB (hab.symm.pow_left _)).dvd_of_dvd_mul_left
      (he ▸ dvd_mul_left _ _)
  have hAp : 0 < Ideal.absNorm (I ⊔ A) := by
    have hm : 0 < Ideal.absNorm (I ⊔ A) * Ideal.absNorm (I ⊔ B) := he.symm ▸ Nat.mul_pos ha hb
    exact Nat.pos_of_mul_pos_right hm
  have hBp : 0 < Ideal.absNorm (I ⊔ B) := by
    have hm : 0 < Ideal.absNorm (I ⊔ A) * Ideal.absNorm (I ⊔ B) := he.symm ▸ Nat.mul_pos ha hb
    exact Nat.pos_of_mul_pos_left hm
  have hAle := Nat.le_of_dvd ha hAa
  have hBle := Nat.le_of_dvd hb hBb
  constructor <;> change _ = _ <;> nlinarith

noncomputable def idealNormMulEquiv (K : Type*) [Field K] [NumberField K]
    (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) :
    {I : Ideal (𝓞 K) // Ideal.absNorm I = a * b} ≃
      {I : Ideal (𝓞 K) // Ideal.absNorm I = a} × {I : Ideal (𝓞 K) // Ideal.absNorm I = b} where
  toFun I :=
    ⟨⟨I.val ⊔ Ideal.span {(a : 𝓞 K)},
        (ideal_absNorm_sup_span_of_coprime K I.val a b ha hb hab I.property).1⟩,
      ⟨I.val ⊔ Ideal.span {(b : 𝓞 K)},
        (ideal_absNorm_sup_span_of_coprime K I.val a b ha hb hab I.property).2⟩⟩
  invFun J := ⟨J.1.val * J.2.val, by rw [map_mul, J.1.property, J.2.property]⟩
  left_inv I := by
    apply Subtype.ext
    apply ideal_sup_product_of_coprime
    · apply Ideal.isCoprime_iff_sup_eq.mp
      apply (Ideal.isCoprime_span_singleton_iff _ _).mpr
      simpa only [map_natCast] using hab.isCoprime.map (Int.castRingHom (𝓞 K))
    · rw [Ideal.span_singleton_mul_span_singleton, ← Nat.cast_mul]
      simpa only [I.property] using Ideal.span_singleton_absNorm_le I.val
  right_inv J := by
    apply Prod.ext
    · apply Subtype.ext
      apply ideal_eq_of_le_of_norm_eq K
      · apply sup_le Ideal.mul_le_right
        simpa only [J.1.property] using Ideal.span_singleton_absNorm_le J.1.val
      · rw [J.1.property]
        apply (ideal_absNorm_sup_span_of_coprime K _ a b ha hb hab ?_).1
        rw [map_mul, J.1.property, J.2.property]
      · rw [J.1.property]
        exact ha.ne'
    · apply Subtype.ext
      apply ideal_eq_of_le_of_norm_eq K
      · apply sup_le Ideal.mul_le_left
        simpa only [J.2.property] using Ideal.span_singleton_absNorm_le J.2.val
      · rw [J.2.property]
        apply (ideal_absNorm_sup_span_of_coprime K _ a b ha hb hab ?_).2
        rw [map_mul, J.1.property, J.2.property]
      · rw [J.2.property]
        exact hb.ne'

lemma ideal_count_mul (K : Type*) [Field K] [NumberField K]
    (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) :
    Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = a * b} =
      Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = a} *
        Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = b} := by
  rw [Nat.card_congr (idealNormMulEquiv K a b ha hb hab), Nat.card_prod]


noncomputable def idealNormCount (K : Type*) [Field K] [NumberField K] : ArithmeticFunction ℕ where
  toFun n := if n = 0 then 0 else Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = n}
  map_zero' := by simp

lemma idealNormCount_apply (K : Type*) [Field K] [NumberField K] (n : ℕ) (hn : n ≠ 0) :
    idealNormCount K n = Nat.card {I : Ideal (𝓞 K) // Ideal.absNorm I = n} := by
  simp [idealNormCount, hn]

lemma idealNormCount_multiplicative (K : Type*) [Field K] [NumberField K] :
    (idealNormCount K).IsMultiplicative := by
  rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
  constructor
  · simp [idealNormCount, Ideal.absNorm_eq_one_iff]
  · intro a b ha hb hab
    rw [idealNormCount_apply K _ (Nat.mul_ne_zero ha hb), idealNormCount_apply K _ ha,
      idealNormCount_apply K _ hb]
    exact ideal_count_mul K a b (Nat.pos_of_ne_zero ha) (Nat.pos_of_ne_zero hb) hab

lemma idealNormCount_harmonic_limit (K : Type*) [Field K] [NumberField K] :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum (idealNormCount K : ArithmeticFunction ℝ) N / log N)
      atTop (𝓝 (NumberField.dedekindZeta_residue K)) := by
  apply (ideal_count_harmonic_limit K).congr
  intro N
  congr 1
  apply Finset.sum_congr rfl
  intro n hn
  rw [ArithmeticFunction.natCoe_apply,
    idealNormCount_apply K n (by have := (Finset.mem_Icc.mp hn).1; omega)]

lemma root_harmonic_limit_of_ideal_convolution (f : ℤ[X])
    (K : Type*) [Field K] [NumberField K] (v : ArithmeticFunction ℝ)
    (heq : (polynomialRootCount f : ArithmeticFunction ℝ) =
      v * (idealNormCount K : ArithmeticFunction ℝ))
    (hv : Summable (fun n : ℕ ↦ ‖v n / (n : ℝ)‖)) :
    Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 ((∑' n : ℕ, v n / (n : ℝ)) * NumberField.dedekindZeta_residue K)) := by
  have ht := tendsto_harmonicWeightSum_convolution (idealNormCount K : ArithmeticFunction ℝ) v
    (fun _ ↦ Nat.cast_nonneg _) _ (idealNormCount_harmonic_limit K) hv
  rw [← heq] at ht
  exact ht

lemma polynomial_root_map_bijective_of_square_zero
    {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (hφ : Function.Surjective φ)
    (hker : ∀ x : R, φ x = 0 → x ^ 2 = 0) (f : R[X])
    (hsimple : ∀ x : R, φ (f.eval x) = 0 → IsUnit (f.derivative.eval x)) :
    Function.Bijective (fun x : {x : R // f.eval x = 0} ↦
      (⟨φ x.val, by rw [eval_map, eval₂_at_apply, x.property, map_zero]⟩ :
        {y : S // (f.map φ).eval y = 0})) := by
  constructor
  · intro x y hxy
    have hφxy : φ x.val = φ y.val := congrArg Subtype.val hxy
    have hδ : (y.val - x.val) ^ 2 = 0 := hker _ (by rw [map_sub, hφxy, sub_self])
    have he := f.eval_add_of_sq_eq_zero x.val (y.val - x.val) hδ
    rw [add_sub_cancel, x.property, y.property, zero_add] at he
    have hu := hsimple x.val (by rw [x.property, map_zero])
    have hd : y.val - x.val = 0 := (hu.mul_right_eq_zero.mp he.symm)
    exact Subtype.ext (sub_eq_zero.mp hd).symm
  · intro y
    obtain ⟨a, ha⟩ := hφ y.val
    have hfa : φ (f.eval a) = 0 := by
      rw [← eval₂_at_apply, ← eval_map, ha]
      exact y.property
    obtain ⟨u, hu⟩ := hsimple a hfa
    let δ : R := -(f.eval a) * ↑u⁻¹
    have hφδ : φ δ = 0 := by simp [δ, hfa]
    have hroot : f.eval (a + δ) = 0 := by
      rw [f.eval_add_of_sq_eq_zero a δ (hker δ hφδ), ← hu]
      dsimp [δ]
      rw [mul_left_comm, Units.mul_inv, mul_one]
      ring
    refine ⟨⟨a + δ, hroot⟩, ?_⟩
    apply Subtype.ext
    simp only [map_add, hφδ, add_zero, ha]


lemma eval_int_map_naturality {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : ℤ[X]) (x : R) :
    φ ((f.map (Int.castRingHom R)).eval x) =
      (f.map (Int.castRingHom S)).eval (φ x) := by
  rw [← eval₂_at_apply, ← eval_map, Polynomial.map_map,
    RingHom.ext_int (φ.comp (Int.castRingHom R)) (Int.castRingHom S)]

lemma zmod_castHom_prime_pow_kernel_sq (p k : ℕ) (hp : p ≠ 0) (hk : 0 < k)
    (x : ZMod (p ^ (k + 1)))
    (hx : ZMod.castHom (pow_dvd_pow p (by omega : k ≤ k + 1)) (ZMod (p ^ k)) x = 0) :
    x ^ 2 = 0 := by
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp⟩
  have hx' : (x.val : ZMod (p ^ k)) = 0 := by
    rw [← ZMod.natCast_zmod_val x] at hx
    simpa only [map_natCast] using hx
  have hdiv := (ZMod.natCast_eq_zero_iff _ _).mp hx'
  rw [← ZMod.natCast_zmod_val x, ← Nat.cast_pow, ZMod.natCast_eq_zero_iff]
  have hpow : p ^ (k + 1) ∣ (p ^ k) ^ 2 := by
    rw [← pow_mul]
    exact pow_dvd_pow p (by omega)
  exact hpow.trans (pow_dvd_pow_of_dvd hdiv 2)

lemma zmod_prime_pow_isUnit_of_mod_prime_ne_zero (p e : ℕ) (hp : p.Prime)
    (he : e ≠ 0) (x : ZMod (p ^ e))
    (hx : ZMod.castHom (dvd_pow_self p he) (ZMod p) x ≠ 0) : IsUnit x := by
  haveI : NeZero (p ^ e) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have hx' : (x.val : ZMod p) ≠ 0 := by
    rw [← ZMod.natCast_zmod_val x] at hx
    simpa only [map_natCast] using hx
  have hd : ¬p ∣ x.val := fun h ↦ hx' ((ZMod.natCast_eq_zero_iff _ _).mpr h)
  have hc : x.val.Coprime (p ^ e) := ((hp.coprime_iff_not_dvd.mpr hd).symm).pow_right e
  simpa only [ZMod.natCast_zmod_val] using (ZMod.isUnit_iff_coprime x.val (p ^ e)).mpr hc

lemma rootResidues_prime_pow_succ_of_simple (f : ℤ[X]) (p k : ℕ) [Fact p.Prime]
    (hk : 0 < k)
    (hsimple : ∀ x : ZMod p, f.eval₂ (Int.castRingHom (ZMod p)) x = 0 →
      f.derivative.eval₂ (Int.castRingHom (ZMod p)) x ≠ 0) :
    (polynomialRootResidues f (p ^ (k + 1))).card =
      (polynomialRootResidues f (p ^ k)).card := by
  let R := ZMod (p ^ (k + 1))
  let S := ZMod (p ^ k)
  let φ : R →+* S := ZMod.castHom (pow_dvd_pow p (by omega : k ≤ k + 1)) S
  let ψ : S →+* ZMod p := ZMod.castHom (dvd_pow_self p hk.ne') (ZMod p)
  let τ : R →+* ZMod p := ZMod.castHom (dvd_pow_self p (by omega : k + 1 ≠ 0)) (ZMod p)
  let F : R[X] := f.map (Int.castRingHom R)
  have hcomp : ψ.comp φ = τ := Subsingleton.elim _ _
  have hφsimple : ∀ x : R, φ (F.eval x) = 0 → IsUnit (F.derivative.eval x) := by
    intro x hx
    have hroot : (f.map (Int.castRingHom (ZMod p))).eval (τ x) = 0 := by
      rw [← eval_int_map_naturality τ f x, ← hcomp, RingHom.comp_apply, hx, map_zero]
    have hder : τ (F.derivative.eval x) ≠ 0 := by
      change τ ((f.map (Int.castRingHom R)).derivative.eval x) ≠ 0
      rw [derivative_map, eval_int_map_naturality, eval_map]
      exact hsimple (τ x) (by simpa only [eval_map] using hroot)
    exact zmod_prime_pow_isUnit_of_mod_prime_ne_zero p (k + 1) Fact.out (by omega) _ hder
  have hbij := polynomial_root_map_bijective_of_square_zero φ (ZMod.castHom_surjective _)
    (zmod_castHom_prime_pow_kernel_sq p k (Fact.out : p.Prime).ne_zero hk) F hφsimple
  have hcard := Nat.card_congr (Equiv.ofBijective _ hbij)
  have hmap : F.map φ = f.map (Int.castRingHom S) := by
    dsimp only [F]
    rw [Polynomial.map_map, RingHom.ext_int (φ.comp (Int.castRingHom R)) (Int.castRingHom S)]
  rw [hmap] at hcard
  haveI : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  haveI : NeZero (p ^ k) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  rw [rootResidues_card_eq_modularRoot, rootResidues_card_eq_modularRoot]
  simpa only [F, ModularRoot, eval_map] using hcard

lemma rootResidues_prime_pow_of_simple (f : ℤ[X]) (p k : ℕ) [Fact p.Prime]
    (hsimple : ∀ x : ZMod p, f.eval₂ (Int.castRingHom (ZMod p)) x = 0 →
      f.derivative.eval₂ (Int.castRingHom (ZMod p)) x ≠ 0) :
    (polynomialRootResidues f (p ^ (k + 1))).card = (polynomialRootResidues f p).card := by
  induction k with
  | zero => simp only [zero_add, pow_one]
  | succ k ih =>
    rw [rootResidues_prime_pow_succ_of_simple f p (k + 1) (by omega) hsimple]
    exact ih


lemma resultant_derivative_ne_zero_of_irreducible (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) : f.resultant f.derivative ≠ 0 := by
  have hirrQ : Irreducible (f.map (Int.castRingHom ℚ)) :=
    ((hirr.isPrimitive hdeg).irreducible_iff_irreducible_map_fraction_map (K := ℚ)).mp hirr
  have hsep : IsCoprime (f.map (Int.castRingHom ℚ))
      (f.map (Int.castRingHom ℚ)).derivative := hirrQ.separable
  have hres := Polynomial.resultant_ne_zero _ _ hsep
  rw [derivative_map] at hres
  simp only [natDegree_map_eq_of_injective (f := Int.castRingHom ℚ) Int.cast_injective] at hres
  rw [resultant_map_map] at hres
  intro hz
  exact hres (by rw [hz, map_zero])

lemma simple_roots_of_not_dvd_resultant (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p : ℕ) (hp : ¬(p : ℤ) ∣ f.resultant f.derivative) :
    ∀ x : ZMod p, f.eval₂ (Int.castRingHom (ZMod p)) x = 0 →
      f.derivative.eval₂ (Int.castRingHom (ZMod p)) x ≠ 0 := by
  obtain ⟨a, b, _, _, hab⟩ :=
    Polynomial.exists_mul_add_mul_eq_C_resultant f f.derivative le_rfl le_rfl (Or.inl hdeg)
  intro x hx hd
  have he := congrArg (fun g : ℤ[X] ↦ g.eval₂ (Int.castRingHom (ZMod p)) x) hab
  simp only [eval₂_add, eval₂_mul, eval₂_C, Int.coe_castRingHom, hx, hd,
    zero_mul, zero_add] at he
  exact hp ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp he.symm)

lemma rootResidues_prime_pow_of_not_dvd_resultant (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p k : ℕ) [Fact p.Prime] (hp : ¬(p : ℤ) ∣ f.resultant f.derivative) :
    (polynomialRootResidues f (p ^ (k + 1))).card = (polynomialRootResidues f p).card :=
  rootResidues_prime_pow_of_simple f p k (simple_roots_of_not_dvd_resultant f hdeg p hp)

lemma exists_finite_exception_prime_pow_roots (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ D : ℕ, 0 < D ∧
      ∀ p : ℕ, p.Prime → ¬p ∣ D → ∀ k : ℕ,
        (polynomialRootResidues f (p ^ (k + 1))).card = (polynomialRootResidues f p).card := by
  refine ⟨(f.resultant f.derivative).natAbs, ?_, ?_⟩
  · exact Int.natAbs_pos.mpr (resultant_derivative_ne_zero_of_irreducible f hdeg hirr)
  · intro p hp hD k
    haveI : Fact p.Prime := ⟨hp⟩
    apply rootResidues_prime_pow_of_not_dvd_resultant f hdeg p k
    intro h
    exact hD (by simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr h)

lemma rootResidues_minpoly_good_prime_pow_eq_ideal_count
    (K : Type*) [Field K] [NumberField K] (θ : 𝓞 K) (p k : ℕ) [Fact p.Prime]
    (hdeg : (minpoly ℤ θ).natDegree ≠ 0)
    (hexponent : ¬p ∣ RingOfIntegers.exponent θ)
    (hresultant : ¬(p : ℤ) ∣ (minpoly ℤ θ).resultant (minpoly ℤ θ).derivative) :
    (polynomialRootResidues (minpoly ℤ θ) (p ^ (k + 1))).card = idealNormCount K p := by
  rw [rootResidues_prime_pow_of_not_dvd_resultant _ hdeg p k hresultant,
    rootResidues_minpoly_prime_eq_ideal_count K θ p hexponent,
    idealNormCount_apply K p (Fact.out : p.Prime).ne_zero]


lemma rootResidues_prime_le_natDegree_of_simple (f : ℤ[X]) (p : ℕ) [Fact p.Prime]
    (hsimple : ∀ x : ZMod p, f.eval₂ (Int.castRingHom (ZMod p)) x = 0 →
      f.derivative.eval₂ (Int.castRingHom (ZMod p)) x ≠ 0) :
    (polynomialRootResidues f p).card ≤ f.natDegree := by
  let F : (ZMod p)[X] := f.map (Int.castRingHom (ZMod p))
  have hF : F ≠ 0 := by
    intro hf
    have hx : f.eval₂ (Int.castRingHom (ZMod p)) 0 = 0 := by
      rw [← eval_map]
      change F.eval 0 = 0
      rw [hf]
      simp
    have hd := hsimple 0 hx
    apply hd
    rw [← eval_map, ← derivative_map]
    change F.derivative.eval 0 = 0
    rw [hf]
    simp
  let e : ModularRoot f p ≃ F.roots.toFinset := Equiv.subtypeEquivRight (fun x ↦ by
    simp only [Multiset.mem_toFinset, mem_roots hF, IsRoot.def,
      F, eval_map])
  rw [rootResidues_card_eq_modularRoot, Nat.card_congr e, Nat.card_eq_fintype_card,
    Fintype.card_coe]
  exact (Multiset.toFinset_card_le _).trans (F.card_roots'.trans (natDegree_map_le ..))

lemma exists_finite_exception_bounded_prime_pow_roots (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ D : ℕ, 0 < D ∧
      ∀ p : ℕ, p.Prime → ¬p ∣ D → ∀ k : ℕ,
        (polynomialRootResidues f (p ^ (k + 1))).card = (polynomialRootResidues f p).card ∧
          (polynomialRootResidues f (p ^ (k + 1))).card ≤ f.natDegree := by
  refine ⟨(f.resultant f.derivative).natAbs, ?_, ?_⟩
  · exact Int.natAbs_pos.mpr (resultant_derivative_ne_zero_of_irreducible f hdeg hirr)
  · intro p hp hD k
    haveI : Fact p.Prime := ⟨hp⟩
    have hR : ¬(p : ℤ) ∣ f.resultant f.derivative := by
      intro h
      exact hD (by simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr h)
    have he := rootResidues_prime_pow_of_not_dvd_resultant f hdeg p k hR
    exact ⟨he, he ▸ rootResidues_prime_le_natDegree_of_simple f p
      (simple_roots_of_not_dvd_resultant f hdeg p hR)⟩


/- Local inverse factors of ideal-counting series. -/

noncomputable def dirichletAtom (m : ℕ) : ArithmeticFunction ℝ where
  toFun n := if n = m ∧ n ≠ 0 then 1 else 0
  map_zero' := by simp

lemma dirichletAtom_mul_apply (m : ℕ) (u : ArithmeticFunction ℝ) (n : ℕ) (hn : n ≠ 0) :
    (dirichletAtom m * u) n = if m ∣ n then u (n / m) else 0 := by
  rw [ArithmeticFunction.mul_apply,
    Nat.sum_divisorsAntidiagonal (fun a b ↦ dirichletAtom m a * u b)]
  have he : ∀ d ∈ n.divisors, dirichletAtom m d * u (n / d) =
      if m = d then u (n / d) else 0 := by
    intro d hd
    have hd0 := (Nat.pos_of_mem_divisors hd).ne'
    change (if d = m ∧ d ≠ 0 then 1 else 0) * u (n / d) = _
    by_cases hdm : d = m
    · rw [if_pos ⟨hdm, hd0⟩, if_pos hdm.symm, one_mul]
    · rw [if_neg (fun h ↦ hdm h.1), if_neg (Ne.symm hdm), zero_mul]
  rw [Finset.sum_congr rfl he, Finset.sum_ite_eq]
  by_cases hmn : m ∣ n
  · rw [if_pos (Nat.mem_divisors.mpr ⟨hmn, hn⟩), if_pos hmn]
  · rw [if_neg (fun h ↦ hmn (Nat.mem_divisors.mp h).1), if_neg hmn]

lemma dirichletAtom_one : dirichletAtom 1 = 1 := by
  ext n
  by_cases hn : n = 1
  · simp [dirichletAtom, hn]
  · simp [dirichletAtom, hn]

noncomputable def idealAvoidingFiber (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (n : ℕ) : Finset (Ideal (𝓞 K)) :=
  (Ideal.finite_setOf_absNorm_eq n).toFinset.filter (fun I ↦ ∀ P ∈ s, ¬P ∣ I)

lemma mem_idealAvoidingFiber (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (n : ℕ) (I : Ideal (𝓞 K)) :
    I ∈ idealAvoidingFiber K s n ↔ Ideal.absNorm I = n ∧ ∀ P ∈ s, ¬P ∣ I := by
  simp [idealAvoidingFiber]

noncomputable def idealAvoidCount (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) : ArithmeticFunction ℝ where
  toFun n := if n = 0 then 0 else (idealAvoidingFiber K s n).card
  map_zero' := by simp

lemma idealAvoidCount_apply (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (n : ℕ) (hn : n ≠ 0) :
    idealAvoidCount K s n = ((idealAvoidingFiber K s n).card : ℝ) := by
  simp [idealAvoidCount, hn]

lemma idealAvoidCount_empty (K : Type*) [Field K] [NumberField K] :
    idealAvoidCount K ∅ = (idealNormCount K : ArithmeticFunction ℝ) := by
  ext n
  by_cases hn : n = 0
  · simp [hn]
  rw [idealAvoidCount_apply K _ n hn, ArithmeticFunction.natCoe_apply, idealNormCount_apply K n hn]
  congr 1
  simp only [idealAvoidingFiber, Finset.notMem_empty, IsEmpty.forall_iff, implies_true,
    Finset.filter_true_of_mem]
  change _ = Nat.card ↥{I : Ideal (𝓞 K) | Ideal.absNorm I = n}
  rw [Nat.card_coe_set_eq, Set.ncard_eq_toFinset_card _ (Ideal.finite_setOf_absNorm_eq n)]

lemma idealAvoidingFiber_divisible_card (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (P : Ideal (𝓞 K)) (hP : Prime P) (hPs : P ∉ s)
    (hs : ∀ Q ∈ s, Prime Q) (n : ℕ) (hdiv : Ideal.absNorm P ∣ n) :
    ((idealAvoidingFiber K s n).filter (fun I ↦ P ∣ I)).card =
      (idealAvoidingFiber K s (n / Ideal.absNorm P)).card := by
  have hNP : Ideal.absNorm P ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]
    exact hP.ne_zero
  symm
  apply Finset.card_nbij (fun J ↦ P * J)
  · intro J hJ
    obtain ⟨hJn, hJs⟩ := (mem_idealAvoidingFiber K _ _ _).mp hJ
    refine Finset.mem_filter.mpr ⟨(mem_idealAvoidingFiber K _ _ _).mpr ⟨?_, ?_⟩,
      dvd_mul_right _ _⟩
    · rw [map_mul, hJn, Nat.mul_div_cancel' hdiv]
    · intro Q hQs hQ
      rcases (hs Q hQs).dvd_mul.mp hQ with hQP | hQJ
      · have hQP' : Q = P := associated_iff_eq.mp (((hs Q hQs).dvd_prime_iff_associated hP).mp hQP)
        exact hPs (hQP' ▸ hQs)
      · exact hJs Q hQs hQJ
  · intro I hI J hJ he
    exact mul_left_cancel₀ hP.ne_zero he
  · intro I hI
    obtain ⟨hI, Pdiv⟩ := Finset.mem_filter.mp hI
    obtain ⟨hIn, hIs⟩ := (mem_idealAvoidingFiber K _ _ _).mp hI
    obtain ⟨J, hJ⟩ := Pdiv
    refine ⟨J, (mem_idealAvoidingFiber K _ _ _).mpr ⟨?_, ?_⟩, hJ.symm⟩
    · apply Nat.eq_div_of_mul_eq_right hNP
      rw [← map_mul, ← hJ, hIn]
    · intro Q hQs hQJ
      apply hIs Q hQs
      rw [hJ]
      exact dvd_mul_of_dvd_right hQJ P

lemma idealAvoidCount_insert (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (P : Ideal (𝓞 K)) (hP : Prime P) (hPs : P ∉ s)
    (hs : ∀ Q ∈ s, Prime Q) :
    idealAvoidCount K (insert P s) = (1 - dirichletAtom (Ideal.absNorm P)) * idealAvoidCount K s := by
  ext n
  by_cases hn : n = 0
  · simp [hn]
  rw [sub_mul, one_mul, ZeroHom.sub_apply, dirichletAtom_mul_apply _ _ n hn,
    idealAvoidCount_apply K _ n hn, idealAvoidCount_apply K _ n hn]
  have hset : (idealAvoidingFiber K s n).filter (fun I ↦ ¬P ∣ I) =
      idealAvoidingFiber K (insert P s) n := by
    ext I
    simp only [Finset.mem_filter, mem_idealAvoidingFiber, Finset.mem_insert,
      forall_eq_or_imp]
    tauto
  have hc := Finset.card_filter_add_card_filter_not (s := idealAvoidingFiber K s n) (fun I ↦ P ∣ I)
  rw [hset] at hc
  by_cases hdiv : Ideal.absNorm P ∣ n
  · rw [if_pos hdiv]
    have hquot : n / Ideal.absNorm P ≠ 0 := by
      exact (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hn) hdiv)
        (Nat.pos_of_dvd_of_pos hdiv (Nat.pos_of_ne_zero hn))).ne'
    rw [idealAvoidCount_apply K _ _ hquot]
    rw [idealAvoidingFiber_divisible_card K s P hP hPs hs n hdiv] at hc
    have hcR : ((idealAvoidingFiber K s (n / Ideal.absNorm P)).card : ℝ) +
        (idealAvoidingFiber K (insert P s) n).card = (idealAvoidingFiber K s n).card := by
      exact_mod_cast hc
    linarith
  · rw [if_neg hdiv, sub_zero]
    have hempty : ((idealAvoidingFiber K s n).filter (fun I ↦ P ∣ I)) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro I hI
      obtain ⟨hI, hPI⟩ := Finset.mem_filter.mp hI
      have hIn := ((mem_idealAvoidingFiber K _ _ _).mp hI).1
      exact hdiv (hIn ▸ map_dvd Ideal.absNorm hPI)
    rw [hempty, Finset.card_empty, zero_add] at hc
    exact_mod_cast hc

lemma idealAvoidCount_eq_product (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (hs : ∀ P ∈ s, Prime P) :
    idealAvoidCount K s =
      (∏ P ∈ s, (1 - dirichletAtom (Ideal.absNorm P))) * (idealNormCount K : ArithmeticFunction ℝ) := by
  induction s using Finset.induction with
  | empty => simp [idealAvoidCount_empty]
  | @insert P s hPs ih =>
    have hP : Prime P := hs P (Finset.mem_insert_self _ _)
    have hs' : ∀ Q ∈ s, Prime Q := fun Q hQ ↦ hs Q (Finset.mem_insert_of_mem hQ)
    rw [idealAvoidCount_insert K s P hP hPs hs', ih hs', Finset.prod_insert hPs, mul_assoc]


noncomputable def rationalPrimeIdeals (K : Type*) [Field K] [NumberField K] (p : ℕ) :
    Finset (Ideal (𝓞 K)) := _root_.primesOverFinset (Ideal.span {(p : ℤ)}) (𝓞 K)

lemma mem_rationalPrimeIdeals (K : Type*) [Field K] [NumberField K] (p : ℕ) [Fact p.Prime]
    (P : Ideal (𝓞 K)) : P ∈ rationalPrimeIdeals K p ↔
      P.IsPrime ∧ P.LiesOver (Ideal.span {(p : ℤ)}) := by
  haveI := Int.ideal_span_isMaximal_of_prime p
  exact _root_.mem_primesOverFinset_iff
    (by simp [(Fact.out : p.Prime).ne_zero]) (𝓞 K)

lemma prime_of_mem_rationalPrimeIdeals (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) (hP : P ∈ rationalPrimeIdeals K p) : Prime P := by
  obtain ⟨hprime, hlies⟩ := (mem_rationalPrimeIdeals K p P).mp hP
  haveI := hlies
  exact Ideal.prime_of_isPrime
    (Ideal.ne_bot_of_liesOver_of_ne_bot (p := Ideal.span {(p : ℤ)})
      (by simp [(Fact.out : p.Prime).ne_zero]) P) hprime

lemma norm_of_mem_rationalPrimeIdeals (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) (hP : P ∈ rationalPrimeIdeals K p) :
    Ideal.absNorm P = p ^ (Ideal.span {(p : ℤ)}).inertiaDeg P := by
  haveI := ((mem_rationalPrimeIdeals K p P).mp hP).2
  exact Ideal.absNorm_eq_pow_inertiaDeg' P Fact.out

lemma prime_ideal_liesOver_of_mem_nat (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) (hP : P.IsPrime) (hpP : (p : 𝓞 K) ∈ P) :
    P.LiesOver (Ideal.span {(p : ℤ)}) := by
  refine ⟨(Int.ideal_span_isMaximal_of_prime p).eq_of_le
    (Ideal.comap_ne_top _ hP.ne_top) ?_⟩
  rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
  simpa only [map_natCast] using hpP

lemma idealAvoidCount_prime_pow_succ (K : Type*) [Field K] [NumberField K]
    (p k : ℕ) [Fact p.Prime] : idealAvoidCount K (rationalPrimeIdeals K p) (p ^ (k + 1)) = 0 := by
  have hp : p.Prime := Fact.out
  rw [idealAvoidCount_apply K _ _ (pow_ne_zero _ hp.ne_zero)]
  have hempty : idealAvoidingFiber K (rationalPrimeIdeals K p) (p ^ (k + 1)) = ∅ := by
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro I hI
    obtain ⟨hIn, havoid⟩ := (mem_idealAvoidingFiber K _ _ _).mp hI
    have hI0 : I ≠ 0 := by
      intro h
      rw [h, map_zero] at hIn
      exact (pow_ne_zero _ hp.ne_zero) hIn.symm
    have hIunit : ¬IsUnit I := by
      intro h
      have h1 : Ideal.absNorm I = 1 := by rw [Ideal.isUnit_iff.mp h, Ideal.absNorm_top]
      exact (Nat.one_lt_pow (by omega : k + 1 ≠ 0) hp.one_lt).ne' (hIn ▸ h1)
    obtain ⟨P, hPirr, hPI⟩ := WfDvdMonoid.exists_irreducible_factor hIunit hI0
    have hP : Prime P := (UniqueFactorizationMonoid.irreducible_iff_prime).mp hPirr
    have hPprime := Ideal.isPrime_of_prime hP
    have hpP : (p : 𝓞 K) ∈ P := by
      apply hPprime.mem_of_pow_mem (k + 1)
      have hN := Ideal.absNorm_mem I
      rw [hIn, Nat.cast_pow] at hN
      exact (Ideal.dvd_iff_le.mp hPI) hN
    have hPs : P ∈ rationalPrimeIdeals K p := (mem_rationalPrimeIdeals K p P).mpr
      ⟨hPprime, prime_ideal_liesOver_of_mem_nat K p P hPprime hpP⟩
    exact havoid P hPs hPI
  rw [hempty, Finset.card_empty, Nat.cast_zero]

lemma idealAvoidCount_one (K : Type*) [Field K] [NumberField K]
    (s : Finset (Ideal (𝓞 K))) (hs : ∀ P ∈ s, Prime P) : idealAvoidCount K s 1 = 1 := by
  rw [idealAvoidCount_apply K s 1 one_ne_zero]
  have hset : idealAvoidingFiber K s 1 = {⊤} := by
    ext I
    rw [mem_idealAvoidingFiber, Finset.mem_singleton, Ideal.absNorm_eq_one_iff]
    constructor
    · exact fun h ↦ h.1
    · intro hI
      refine ⟨hI, ?_⟩
      intro P hP hPI
      apply (hs P hP).not_unit
      apply isUnit_of_dvd_one
      simpa only [hI, Ideal.one_eq_top] using hPI
  rw [hset, Finset.card_singleton, Nat.cast_one]

noncomputable def idealLocalInverse (K : Type*) [Field K] [NumberField K] (p : ℕ) :
    ArithmeticFunction ℝ :=
  ∏ P ∈ rationalPrimeIdeals K p, (1 - dirichletAtom (Ideal.absNorm P))

lemma idealLocalInverse_mul_idealNormCount (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    idealLocalInverse K p * (idealNormCount K : ArithmeticFunction ℝ) =
      idealAvoidCount K (rationalPrimeIdeals K p) :=
  (idealAvoidCount_eq_product K _ (prime_of_mem_rationalPrimeIdeals K p)).symm

lemma idealLocalInverse_prime_pow (K : Type*) [Field K] [NumberField K]
    (p k : ℕ) [Fact p.Prime] :
    (idealLocalInverse K p * (idealNormCount K : ArithmeticFunction ℝ)) (p ^ k) =
      if k = 0 then 1 else 0 := by
  rw [idealLocalInverse_mul_idealNormCount]
  cases k with
  | zero =>
    rw [pow_zero, if_pos rfl]
    exact idealAvoidCount_one K _ (prime_of_mem_rationalPrimeIdeals K p)
  | succ k => rw [idealAvoidCount_prime_pow_succ]; simp


lemma dirichletAtom_zero : dirichletAtom 0 = 0 := by
  ext n
  simp [dirichletAtom]

lemma dirichletAtom_mul (m n : ℕ) : dirichletAtom m * dirichletAtom n = dirichletAtom (m * n) := by
  by_cases hm : m = 0
  · simp [hm, dirichletAtom_zero]
  by_cases hn : n = 0
  · simp [hn, dirichletAtom_zero]
  ext k
  by_cases hk : k = 0
  · simp [hk]
  rw [dirichletAtom_mul_apply m _ k hk]
  by_cases hd : m ∣ k
  · rw [if_pos hd]
    have hq : k / m ≠ 0 := (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hk) hd)
      (Nat.pos_of_ne_zero hm)).ne'
    have he : k / m = n ↔ k = m * n := by
      constructor
      · intro h
        rw [← h, Nat.mul_div_cancel' hd]
      · intro h
        rw [h, Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero hm)]
    simp [dirichletAtom, he, hq, hk]
  · rw [if_neg hd]
    have he : k ≠ m * n := by intro h; exact hd (h ▸ dvd_mul_right _ _)
    simp [dirichletAtom, he]

lemma dirichletAtom_prod {ι : Type*} (s : Finset ι) (m : ι → ℕ) :
    ∏ i ∈ s, dirichletAtom (m i) = dirichletAtom (∏ i ∈ s, m i) := by
  classical
  induction s using Finset.induction with
  | empty => simp [dirichletAtom_one]
  | @insert i s hi ih => rw [Finset.prod_insert hi, Finset.prod_insert hi, ih, dirichletAtom_mul]

lemma signed_dirichletAtom_apply (r : ℕ) (a n : ℕ) :
    (((-1 : ArithmeticFunction ℝ) ^ r) * dirichletAtom a : ArithmeticFunction ℝ) n =
      (-1 : ℝ) ^ r * dirichletAtom a n := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ', mul_assoc]
    have he : (-1 : ArithmeticFunction ℝ) * ((-1 : ArithmeticFunction ℝ) ^ r * dirichletAtom a) =
        -((-1 : ArithmeticFunction ℝ) ^ r * dirichletAtom a) := by ring
    rw [he]
    change -(((-1 : ArithmeticFunction ℝ) ^ r * dirichletAtom a : ArithmeticFunction ℝ) n) = _
    rw [ih, pow_succ']
    ring

def arithmeticEvaluation (n : ℕ) : ArithmeticFunction ℝ →+ ℝ where
  toFun u := u n
  map_zero' := rfl
  map_add' _ _ := rfl

lemma arithmeticFunction_sum_apply {ι : Type*} (s : Finset ι) (u : ι → ArithmeticFunction ℝ) (n : ℕ) :
    (∑ i ∈ s, u i) n = ∑ i ∈ s, u i n :=
  map_sum (arithmeticEvaluation n) u s

lemma finite_local_inverse_powerset {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (m : ι → ℕ) (n : ℕ) :
    (∏ i ∈ s, (1 - dirichletAtom (m i)) : ArithmeticFunction ℝ) n =
      ∑ t ∈ s.powerset, (-1 : ℝ) ^ t.card * dirichletAtom (∏ i ∈ t, m i) n := by
  rw [Finset.prod_sub]
  simp only [Finset.prod_const_one, mul_one, dirichletAtom_prod]
  rw [arithmeticFunction_sum_apply]
  apply Finset.sum_congr rfl
  intro t ht
  exact signed_dirichletAtom_apply _ _ _

lemma rationalPrimeIdeals_inertia_pos (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) (hP : P ∈ rationalPrimeIdeals K p) :
    0 < (Ideal.span {(p : ℤ)}).inertiaDeg P := by
  haveI := Int.ideal_span_isMaximal_of_prime p
  haveI := ((mem_rationalPrimeIdeals K p P).mp hP).2
  exact Ideal.inertiaDeg_pos _ _

lemma rationalPrimeIdeals_inertia_sum_le (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    ∑ P ∈ rationalPrimeIdeals K p, (Ideal.span {(p : ℤ)}).inertiaDeg P ≤ Module.finrank ℚ K := by
  haveI := Int.ideal_span_isMaximal_of_prime p
  have hp0 : Ideal.span {(p : ℤ)} ≠ ⊥ := by simp [(Fact.out : p.Prime).ne_zero]
  rw [← Ideal.sum_ramification_inertia (𝓞 K) ℚ K hp0]
  apply Finset.sum_le_sum
  intro P hP
  haveI := ((mem_rationalPrimeIdeals K p P).mp hP).2
  haveI := ((mem_rationalPrimeIdeals K p P).mp hP).1
  exact Nat.le_mul_of_pos_left _ (Nat.pos_of_ne_zero
    (Ideal.IsDedekindDomain.ramificationIdx_ne_zero_of_liesOver P hp0))

lemma rationalPrimeIdeals_card_le (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] : (rationalPrimeIdeals K p).card ≤ Module.finrank ℚ K := by
  calc
    (rationalPrimeIdeals K p).card = ∑ P ∈ rationalPrimeIdeals K p, 1 := by simp
    _ ≤ ∑ P ∈ rationalPrimeIdeals K p, (Ideal.span {(p : ℤ)}).inertiaDeg P :=
      Finset.sum_le_sum (fun P hP ↦ rationalPrimeIdeals_inertia_pos K p P hP)
    _ ≤ _ := rationalPrimeIdeals_inertia_sum_le K p

lemma idealLocalInverse_powerset (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (n : ℕ) :
    idealLocalInverse K p n = ∑ t ∈ (rationalPrimeIdeals K p).powerset,
      (-1 : ℝ) ^ t.card * dirichletAtom
        (p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P)) n := by
  rw [idealLocalInverse, finite_local_inverse_powerset]
  apply Finset.sum_congr rfl
  intro t ht
  have hsub := Finset.mem_powerset.mp ht
  have he : (∏ P ∈ t, Ideal.absNorm P) = p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P) := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Finset.prod_congr rfl (fun P hP ↦ norm_of_mem_rationalPrimeIdeals K p P (hsub hP))
  rw [he]

lemma idealLocalInverse_apply_not_prime_pow (K : Type*) [Field K] [NumberField K]
    (p n : ℕ) [Fact p.Prime] (hn : ¬∃ k : ℕ, n = p ^ k) : idealLocalInverse K p n = 0 := by
  rw [idealLocalInverse_powerset]
  apply Finset.sum_eq_zero
  intro t ht
  have he : n ≠ p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P) := fun h ↦ hn ⟨_, h⟩
  simp [dirichletAtom, he]

lemma idealLocalInverse_prime_pow_eq_zero (K : Type*) [Field K] [NumberField K]
    (p k : ℕ) [Fact p.Prime] (hk : Module.finrank ℚ K < k) : idealLocalInverse K p (p ^ k) = 0 := by
  rw [idealLocalInverse_powerset]
  apply Finset.sum_eq_zero
  intro t ht
  have hsub := Finset.mem_powerset.mp ht
  have hsum : (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P) ≤ Module.finrank ℚ K :=
    (Finset.sum_le_sum_of_subset hsub).trans (rationalPrimeIdeals_inertia_sum_le K p)
  have he : p ^ k ≠ p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P) := by
    intro h
    have := (Nat.pow_right_injective (Fact.out : p.Prime).two_le) h
    omega
  simp [dirichletAtom, he]

lemma idealLocalInverse_abs_le (K : Type*) [Field K] [NumberField K]
    (p n : ℕ) [Fact p.Prime] : |idealLocalInverse K p n| ≤ (2 : ℝ) ^ Module.finrank ℚ K := by
  rw [idealLocalInverse_powerset]
  calc
    |∑ t ∈ (rationalPrimeIdeals K p).powerset, (-1 : ℝ) ^ t.card *
        dirichletAtom (p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P)) n| ≤
        ∑ t ∈ (rationalPrimeIdeals K p).powerset, (1 : ℝ) := by
      apply (Finset.abs_sum_le_sum_abs _ _).trans
      apply Finset.sum_le_sum
      intro t ht
      simp only [dirichletAtom, ArithmeticFunction.coe_mk]
      split_ifs <;> simp
    _ = (2 : ℝ) ^ (rationalPrimeIdeals K p).card := by simp
    _ ≤ (2 : ℝ) ^ Module.finrank ℚ K := pow_le_pow_right₀ (by norm_num) (rationalPrimeIdeals_card_le K p)


lemma rationalPrimeIdeals_nonempty (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] : (rationalPrimeIdeals K p).Nonempty := by
  haveI := Int.ideal_span_isMaximal_of_prime p
  obtain ⟨P⟩ := (inferInstance : Nonempty ((Ideal.span {(p : ℤ)}).primesOver (𝓞 K)))
  exact ⟨P.val, (mem_rationalPrimeIdeals K p P.val).mpr P.property⟩

lemma sum_dirichletAtom_prime_pow (p d e : ℕ) (hp : p.Prime) (he : e ≤ d) :
    ∑ j ∈ Finset.range (d + 1), dirichletAtom (p ^ e) (p ^ j) = (1 : ℝ) := by
  have hterm : ∀ j : ℕ, dirichletAtom (p ^ e) (p ^ j) = if e = j then 1 else 0 := by
    intro j
    have hz := pow_ne_zero j hp.ne_zero
    have hpow : p ^ j = p ^ e ↔ e = j :=
      (Nat.pow_right_injective hp.two_le).eq_iff.trans eq_comm
    simp [dirichletAtom, hpow, hp.ne_zero]
  simp_rw [hterm]
  rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr (by omega))]

lemma idealLocalInverse_sum_eq_zero (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    ∑ j ∈ Finset.range (Module.finrank ℚ K + 1), idealLocalInverse K p (p ^ j) = (0 : ℝ) := by
  simp_rw [idealLocalInverse_powerset]
  rw [Finset.sum_comm]
  have hterm : ∀ t ∈ (rationalPrimeIdeals K p).powerset,
      ∑ j ∈ Finset.range (Module.finrank ℚ K + 1), (-1 : ℝ) ^ t.card *
        dirichletAtom (p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P)) (p ^ j) =
          (-1 : ℝ) ^ t.card := by
    intro t ht
    rw [← Finset.mul_sum, sum_dirichletAtom_prime_pow p _ _ Fact.out ?_, mul_one]
    exact (Finset.sum_le_sum_of_subset (Finset.mem_powerset.mp ht)).trans
      (rationalPrimeIdeals_inertia_sum_le K p)
  rw [Finset.sum_congr rfl hterm]
  have he := Finset.prod_sub (fun _ : Ideal (𝓞 K) ↦ (1 : ℝ)) (fun _ ↦ (1 : ℝ))
    (rationalPrimeIdeals K p)
  simp only [sub_self, Finset.prod_const_one, mul_one] at he
  rw [← he]
  exact Finset.prod_eq_zero (rationalPrimeIdeals_nonempty K p).choose_spec rfl

lemma idealLocalInverse_sum_abs_le (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    ∑ j ∈ Finset.range (Module.finrank ℚ K + 1), |idealLocalInverse K p (p ^ j)| ≤
      (2 : ℝ) ^ Module.finrank ℚ K := by
  have hbound : ∀ n, |idealLocalInverse K p n| ≤
      ∑ t ∈ (rationalPrimeIdeals K p).powerset,
        dirichletAtom (p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P)) n := by
    intro n
    rw [idealLocalInverse_powerset]
    apply (Finset.abs_sum_le_sum_abs _ _).trans
    apply Finset.sum_le_sum
    intro t ht
    simp only [dirichletAtom, ArithmeticFunction.coe_mk]
    split_ifs <;> simp
  calc
    _ ≤ ∑ j ∈ Finset.range (Module.finrank ℚ K + 1),
        ∑ t ∈ (rationalPrimeIdeals K p).powerset,
          dirichletAtom (p ^ (∑ P ∈ t, (Ideal.span {(p : ℤ)}).inertiaDeg P)) (p ^ j) :=
      Finset.sum_le_sum (fun j _ ↦ hbound (p ^ j))
    _ = ∑ t ∈ (rationalPrimeIdeals K p).powerset, (1 : ℝ) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro t ht
      exact sum_dirichletAtom_prime_pow p _ _ Fact.out
        ((Finset.sum_le_sum_of_subset (Finset.mem_powerset.mp ht)).trans
          (rationalPrimeIdeals_inertia_sum_le K p))
    _ = (2 : ℝ) ^ (rationalPrimeIdeals K p).card := by simp
    _ ≤ _ := pow_le_pow_right₀ (by norm_num) (rationalPrimeIdeals_card_le K p)

lemma idealLocalInverse_apply_one (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] : idealLocalInverse K p 1 = 1 := by
  have he := idealLocalInverse_prime_pow K p 0
  rw [pow_zero, ArithmeticFunction.mul_apply_one,
    (idealNormCount_multiplicative K).natCast.map_one, mul_one, if_pos rfl] at he
  exact he

lemma idealLocalInverse_apply_prime (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    idealLocalInverse K p p = -(idealNormCount K p : ℝ) := by
  have he := idealLocalInverse_prime_pow K p 1
  rw [convolution_prime_pow _ _ p 1 Fact.out] at he
  norm_num only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one, Nat.sub_zero,
    Nat.sub_self, zero_add, if_neg Nat.one_ne_zero] at he
  rw [idealLocalInverse_apply_one, (idealNormCount_multiplicative K).natCast.map_one,
    one_mul, mul_one] at he
  simp only [ite_false, ArithmeticFunction.natCoe_apply] at he
  linarith

lemma idealLocalCorrection_apply_one (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (u : ArithmeticFunction ℝ) (hu : u 1 = 1) :
    (idealLocalInverse K p * u) 1 = 1 := by
  rw [ArithmeticFunction.mul_apply_one, idealLocalInverse_apply_one, hu, mul_one]

lemma idealLocalCorrection_apply_prime (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (u : ArithmeticFunction ℝ) (hu : u 1 = 1)
    (hup : u p = idealNormCount K p) : (idealLocalInverse K p * u) p = 0 := by
  have he := convolution_prime_pow (idealLocalInverse K p) u p 1 (Fact.out : p.Prime)
  norm_num only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one, Nat.sub_zero,
    Nat.sub_self, zero_add] at he
  rw [he, idealLocalInverse_apply_one, idealLocalInverse_apply_prime, hu, hup]
  ring

lemma idealLocalCorrection_prime_pow_eq_zero (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (u : ArithmeticFunction ℝ) (r : ℝ)
    (hu : ∀ j : ℕ, u (p ^ (j + 1)) = r) (k : ℕ) (hk : Module.finrank ℚ K < k) :
    (idealLocalInverse K p * u) (p ^ k) = 0 := by
  rw [convolution_prime_pow _ _ p k Fact.out]
  have htrunc : (∑ j ∈ Finset.range (k + 1), idealLocalInverse K p (p ^ j) * u (p ^ (k - j))) =
      ∑ j ∈ Finset.range (Module.finrank ℚ K + 1), idealLocalInverse K p (p ^ j) * u (p ^ (k - j)) := by
    symm
    apply Finset.sum_subset (Finset.range_mono (by omega))
    intro j hj hjD
    rw [idealLocalInverse_prime_pow_eq_zero K p j (by simpa using hjD), zero_mul]
  rw [htrunc]
  have hterm : ∀ j ∈ Finset.range (Module.finrank ℚ K + 1),
      idealLocalInverse K p (p ^ j) * u (p ^ (k - j)) = idealLocalInverse K p (p ^ j) * r := by
    intro j hj
    have hjk : 0 < k - j := by have := Finset.mem_range.mp hj; omega
    rw [show k - j = (k - j - 1) + 1 by omega, hu]
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, idealLocalInverse_sum_eq_zero, zero_mul]

lemma idealLocalCorrection_abs_le (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] (u : ArithmeticFunction ℝ) (B : ℝ) (hB : 0 ≤ B)
    (hu : ∀ j : ℕ, |u (p ^ j)| ≤ B) (k : ℕ) :
    |(idealLocalInverse K p * u) (p ^ k)| ≤ (2 : ℝ) ^ Module.finrank ℚ K * B := by
  rw [convolution_prime_pow _ _ p k Fact.out]
  calc
    _ ≤ ∑ j ∈ Finset.range (k + 1), |idealLocalInverse K p (p ^ j)| * B := by
      apply (Finset.abs_sum_le_sum_abs _ _).trans
      apply Finset.sum_le_sum
      intro j hj
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_left (hu _) (abs_nonneg _)
    _ = (∑ j ∈ Finset.range (k + 1), |idealLocalInverse K p (p ^ j)|) * B :=
      (Finset.sum_mul ..).symm
    _ ≤ (2 : ℝ) ^ Module.finrank ℚ K * B := by
      apply mul_le_mul_of_nonneg_right _ hB
      calc
        _ ≤ ∑ j ∈ Finset.range (Module.finrank ℚ K + 1), |idealLocalInverse K p (p ^ j)| := by
          by_cases hk : k ≤ Module.finrank ℚ K
          · exact Finset.sum_le_sum_of_subset_of_nonneg
              (Finset.range_mono (by omega)) (fun _ _ _ ↦ abs_nonneg _)
          · apply le_of_eq
            symm
            apply Finset.sum_subset (Finset.range_mono (by omega))
            intro j hj hjD
            rw [idealLocalInverse_prime_pow_eq_zero K p j (by simpa using hjD), abs_zero]
        _ ≤ _ := idealLocalInverse_sum_abs_le K p


noncomputable def multiplicativeExtension (w : ℕ → ℕ → ℝ) : ArithmeticFunction ℝ where
  toFun n := if n = 0 then 0 else n.factorization.prod w
  map_zero' := by simp

lemma multiplicativeExtension_multiplicative (w : ℕ → ℕ → ℝ) :
    (multiplicativeExtension w).IsMultiplicative := by
  rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
  constructor
  · simp [multiplicativeExtension]
  · intro m n hm hn hmn
    simp only [multiplicativeExtension, ArithmeticFunction.coe_mk,
      if_neg hm, if_neg hn, if_neg (Nat.mul_ne_zero hm hn), Nat.factorization_mul hm hn]
    exact Finsupp.prod_add_index_of_disjoint (by simpa using hmn.disjoint_primeFactors) w

lemma multiplicativeExtension_prime_pow (w : ℕ → ℕ → ℝ) (p k : ℕ) (hp : p.Prime)
    (hw : w p 0 = 1) : multiplicativeExtension w (p ^ k) = w p k := by
  cases k with
  | zero => simp [multiplicativeExtension, hw]
  | succ k =>
    simp [multiplicativeExtension, hp.ne_zero, Nat.factorization_pow,
      hp.factorization, Finsupp.prod, Nat.support_factorization, Finsupp.smul_single,
      Nat.primeFactors_pow p (by omega : k + 1 ≠ 0), hp.primeFactors]

noncomputable def idealCorrection (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  multiplicativeExtension (fun p k ↦ (idealLocalInverse K p * u) (p ^ k))

lemma idealCorrection_multiplicative (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) : (idealCorrection K u).IsMultiplicative :=
  multiplicativeExtension_multiplicative _

lemma idealCorrection_prime_pow (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (p k : ℕ) [Fact p.Prime] :
    idealCorrection K u (p ^ k) = (idealLocalInverse K p * u) (p ^ k) := by
  apply multiplicativeExtension_prime_pow _ p k Fact.out
  rw [pow_zero, idealLocalCorrection_apply_one K p u hu.map_one]

lemma convolution_prime_pow_congr_left (u v w : ArithmeticFunction ℝ)
    (p k : ℕ) (hp : p.Prime) (h : ∀ j, u (p ^ j) = v (p ^ j)) :
    (u * w) (p ^ k) = (v * w) (p ^ k) := by
  rw [convolution_prime_pow _ _ p k hp, convolution_prime_pow _ _ p k hp]
  apply Finset.sum_congr rfl
  intro j hj
  rw [h]

lemma mul_idealLocalInverse_local_identity (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (p k : ℕ) [Fact p.Prime] :
    (u * (idealLocalInverse K p * (idealNormCount K : ArithmeticFunction ℝ))) (p ^ k) = u (p ^ k) := by
  rw [convolution_prime_pow _ _ p k Fact.out]
  rw [Finset.sum_eq_single k]
  · rw [Nat.sub_self, idealLocalInverse_prime_pow, if_pos rfl, mul_one]
  · intro j hj hjk
    have hkj : k - j ≠ 0 := by have := Finset.mem_range.mp hj; omega
    rw [idealLocalInverse_prime_pow, if_neg hkj, mul_zero]
  · simp

lemma idealCorrection_mul_idealNormCount (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) :
    idealCorrection K u * (idealNormCount K : ArithmeticFunction ℝ) = u := by
  apply (ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers _
    ((idealCorrection_multiplicative K u).mul (idealNormCount_multiplicative K).natCast) _ hu).mpr
  intro p k hp
  haveI : Fact p.Prime := ⟨hp⟩
  rw [convolution_prime_pow_congr_left _ (idealLocalInverse K p * u) _ p k hp
    (fun j ↦ idealCorrection_prime_pow K u hu p j)]
  have he : (idealLocalInverse K p * u) * (idealNormCount K : ArithmeticFunction ℝ) =
      u * (idealLocalInverse K p * (idealNormCount K : ArithmeticFunction ℝ)) := by ring
  rw [he, mul_idealLocalInverse_local_identity]

lemma rootCount_idealCorrection_identity (f : ℤ[X])
    (K : Type*) [Field K] [NumberField K] :
    (polynomialRootCount f : ArithmeticFunction ℝ) =
      idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) *
        (idealNormCount K : ArithmeticFunction ℝ) :=
  (idealCorrection_mul_idealNormCount K _ (polynomialRootCount_multiplicative f).natCast).symm

lemma root_harmonic_limit_of_idealCorrection_summable (f : ℤ[X])
    (K : Type*) [Field K] [NumberField K]
    (hv : Summable (fun n : ℕ ↦
      ‖idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) n / (n : ℝ)‖)) :
    Tendsto (fun N : ℕ ↦ harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 ((∑' n : ℕ, idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) n /
        (n : ℝ)) * NumberField.dedekindZeta_residue K)) :=
  root_harmonic_limit_of_ideal_convolution f K _ (rootCount_idealCorrection_identity f K) hv


lemma summable_of_multiplicative_local_bound (f : ℕ → ℝ)
    (hf0 : f 0 = 0) (hf1 : f 1 = 1) (hf : ∀ n, 0 ≤ f n)
    (hmul : ∀ m n, m.Coprime n → f (m * n) = f m * f n)
    (C : ℕ → ℝ) (hC : Summable C) (hCpos : ∀ n, 0 ≤ C n)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ f (p ^ k)))
    (hbound : ∀ p : ℕ, p.Prime → (∑' k : ℕ, f (p ^ k)) ≤ 1 + C p) : Summable f := by
  apply summable_of_sum_range_le hf (c := Real.exp (∑' p, C p))
  intro N
  have hlocalnorm : ∀ {p : ℕ}, p.Prime → Summable (fun k : ℕ ↦ ‖f (p ^ k)‖) := by
    intro p hp
    exact (hlocal p hp).norm
  have hS := EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_tsum hf1
    (fun {m n} hmn ↦ hmul m n hmn) hlocalnorm (Finset.range N)
  have hInd : Summable ((Nat.factoredNumbers (Finset.range N)).indicator f) :=
    summable_subtype_iff_indicator.mp hS.1.of_norm
  have hsum : (∑ i ∈ Finset.range N, f i) =
      ∑ i ∈ Finset.range N, (Nat.factoredNumbers (Finset.range N)).indicator f i := by
    apply Finset.sum_congr rfl
    intro i hi
    by_cases hi0 : i = 0
    · simp [hi0, hf0, Set.indicator]
    · have hmem := Nat.mem_smoothNumbers_of_lt (Nat.pos_of_ne_zero hi0) (Finset.mem_range.mp hi)
      rw [Nat.smoothNumbers_eq_factoredNumbers] at hmem
      exact (Set.indicator_of_mem hmem f).symm
  rw [hsum]
  calc
    _ ≤ ∑' i : ℕ, (Nat.factoredNumbers (Finset.range N)).indicator f i :=
      hInd.sum_le_tsum _ (fun i _ ↦ Set.indicator_nonneg (fun i _ ↦ hf i) i)
    _ = ∑' i : Nat.factoredNumbers (Finset.range N), f i := (tsum_subtype _ _).symm
    _ = ∏ p ∈ (Finset.range N).filter Nat.Prime, ∑' k : ℕ, f (p ^ k) := hS.2.tsum_eq
    _ ≤ ∏ p ∈ (Finset.range N).filter Nat.Prime, (1 + C p) := by
      apply Finset.prod_le_prod
      · intro p hp
        exact tsum_nonneg (fun k ↦ hf _)
      · intro p hp
        exact hbound p (Finset.mem_filter.mp hp).2
    _ ≤ ∏ p ∈ (Finset.range N).filter Nat.Prime, Real.exp (C p) := by
      apply Finset.prod_le_prod
      · intro p hp
        linarith [hCpos p]
      · intro p hp
        simpa only [add_comm] using Real.add_one_le_exp (C p)
    _ = Real.exp (∑ p ∈ (Finset.range N).filter Nat.Prime, C p) := (Real.exp_sum _ _).symm
    _ ≤ _ := Real.exp_le_exp.mpr (hC.sum_le_tsum _ (fun p _ ↦ hCpos p))

lemma summable_weighted_multiplicative_of_local_bound (u : ArithmeticFunction ℝ)
    (hu : u.IsMultiplicative) (C : ℕ → ℝ) (hC : Summable C) (hCpos : ∀ n, 0 ≤ C n)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ |u (p ^ k) / (p : ℝ) ^ k|))
    (hbound : ∀ p : ℕ, p.Prime → (∑' k : ℕ, |u (p ^ k) / (p : ℝ) ^ k|) ≤ 1 + C p) :
    Summable (fun n : ℕ ↦ ‖u n / (n : ℝ)‖) := by
  simp only [Real.norm_eq_abs]
  apply summable_of_multiplicative_local_bound (fun n ↦ |u n / (n : ℝ)|)
    (by simp) (by dsimp only; rw [hu.map_one]; norm_num) (fun _ ↦ abs_nonneg _) ?_ C hC hCpos
  · simpa only [Nat.cast_pow] using hlocal
  · simpa only [Nat.cast_pow] using hbound
  · intro m n hmn
    dsimp only
    rw [hu.map_mul_of_coprime hmn, Nat.cast_mul, mul_div_mul_comm, abs_mul]


lemma convolution_prime_pow_weighted (u v : ArithmeticFunction ℝ) (p k : ℕ) (hp : p.Prime) :
    (u * v) (p ^ k) / (p : ℝ) ^ k =
      ∑ j ∈ Finset.range (k + 1), (u (p ^ j) / (p : ℝ) ^ j) *
        (v (p ^ (k - j)) / (p : ℝ) ^ (k - j)) := by
  rw [convolution_prime_pow _ _ p k hp, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro j hj
  rw [div_mul_div_comm, ← pow_add, Nat.add_sub_of_le (by simpa using Finset.mem_range.mp hj)]

lemma idealLocalInverse_weighted_summable (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    Summable (fun k : ℕ ↦ ‖idealLocalInverse K p (p ^ k) / (p : ℝ) ^ k‖) := by
  apply summable_of_ne_finset_zero (s := Finset.range (Module.finrank ℚ K + 1))
  intro k hk
  rw [idealLocalInverse_prime_pow_eq_zero K p k (by simpa using hk), zero_div, norm_zero]

lemma idealCorrection_local_summable (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (p : ℕ) [Fact p.Prime]
    (hlocal : Summable (fun k : ℕ ↦ ‖u (p ^ k) / (p : ℝ) ^ k‖)) :
    Summable (fun k : ℕ ↦ ‖idealCorrection K u (p ^ k) / (p : ℝ) ^ k‖) := by
  have hs := summable_norm_sum_mul_range_of_summable_norm
    (idealLocalInverse_weighted_summable K p) hlocal
  apply hs.congr
  intro k
  rw [idealCorrection_prime_pow K u hu p k, convolution_prime_pow_weighted _ _ p k Fact.out]

lemma idealCorrection_local_good_summable (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (p : ℕ) [Fact p.Prime]
    (r : ℝ) (hr : ∀ j : ℕ, u (p ^ (j + 1)) = r) :
    Summable (fun k : ℕ ↦ ‖idealCorrection K u (p ^ k) / (p : ℝ) ^ k‖) := by
  apply summable_of_ne_finset_zero (s := Finset.range (Module.finrank ℚ K + 1))
  intro k hk
  rw [idealCorrection_prime_pow K u hu p k,
    idealLocalCorrection_prime_pow_eq_zero K p u r hr k (by simpa using hk), zero_div, norm_zero]

lemma idealCorrection_local_good_bound (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (p : ℕ) [Fact p.Prime]
    (r B : ℝ) (hB : 0 ≤ B) (hup : u p = idealNormCount K p)
    (hr : ∀ j : ℕ, u (p ^ (j + 1)) = r) (huB : ∀ j : ℕ, |u (p ^ j)| ≤ B) :
    (∑' k : ℕ, ‖idealCorrection K u (p ^ k) / (p : ℝ) ^ k‖) ≤
      1 + (Module.finrank ℚ K : ℝ) * ((2 : ℝ) ^ Module.finrank ℚ K * B) / (p : ℝ) ^ 2 := by
  have hs := idealCorrection_local_good_summable K u hu p r hr
  rw [hs.tsum_eq_zero_add]
  have h1 : idealCorrection K u 1 = 1 := (idealCorrection_multiplicative K u).map_one
  simp only [pow_zero, h1, div_one, norm_one]
  apply add_le_add le_rfl
  rw [tsum_eq_sum (s := Finset.range (Module.finrank ℚ K)) ?_]
  · calc
      _ ≤ ∑ _k ∈ Finset.range (Module.finrank ℚ K),
          ((2 : ℝ) ^ Module.finrank ℚ K * B) / (p : ℝ) ^ 2 := by
        apply Finset.sum_le_sum
        intro k hk
        rw [idealCorrection_prime_pow K u hu p (k + 1)]
        by_cases hk0 : k = 0
        · subst k
          rw [zero_add, pow_one, idealLocalCorrection_apply_prime K p u hu.map_one hup,
            zero_div, norm_zero]
          positivity
        · have hpR : (1 : ℝ) ≤ p := by exact_mod_cast (Fact.out : p.Prime).one_lt.le
          have hden : 0 < (p : ℝ) ^ 2 := by positivity
          have hpows : (p : ℝ) ^ 2 ≤ (p : ℝ) ^ (k + 1) :=
            pow_le_pow_right₀ hpR (by omega)
          have hdenabs : |(p : ℝ) ^ (k + 1)| = (p : ℝ) ^ (k + 1) := abs_of_nonneg (by positivity)
          rw [Real.norm_eq_abs, abs_div, hdenabs]
          calc
            _ ≤ ((2 : ℝ) ^ Module.finrank ℚ K * B) / (p : ℝ) ^ (k + 1) :=
              div_le_div_of_nonneg_right (idealLocalCorrection_abs_le K p u B hB huB (k + 1))
                (by positivity)
            _ ≤ _ := div_le_div_of_nonneg_left (by positivity) hden hpows
      _ = _ := by simp; ring
  · intro k hk
    rw [idealCorrection_prime_pow K u hu p (k + 1),
      idealLocalCorrection_prime_pow_eq_zero K p u r hr (k + 1) (by simpa using hk),
      zero_div, norm_zero]


lemma idealCorrection_summable_of_finite_good_primes (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (s : Finset ℕ)
    (B : ℝ) (hB : 0 ≤ B)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖u (p ^ k) / (p : ℝ) ^ k‖))
    (hgood : ∀ p : ℕ, p.Prime → p ∉ s →
      u p = idealNormCount K p ∧ (∀ j : ℕ, u (p ^ (j + 1)) = u p) ∧
        ∀ j : ℕ, |u (p ^ j)| ≤ B) :
    Summable (fun n : ℕ ↦ ‖idealCorrection K u n / (n : ℝ)‖) := by
  let A : ℝ := (Module.finrank ℚ K : ℝ) * ((2 : ℝ) ^ Module.finrank ℚ K * B)
  let C : ℕ → ℝ := fun n ↦ if n ∈ s then
    ∑' k : ℕ, ‖idealCorrection K u (n ^ k) / (n : ℝ) ^ k‖ else A / (n : ℝ) ^ 2
  have hCpos : ∀ n, 0 ≤ C n := by
    intro n
    dsimp [C, A]
    split_ifs
    · exact tsum_nonneg (fun _ ↦ abs_nonneg _)
    · positivity
  have hbase : Summable (fun n : ℕ ↦ A / (n : ℝ) ^ 2) := by
    simpa only [div_eq_mul_inv] using
      (Real.summable_nat_pow_inv.mpr (by norm_num : 1 < (2 : ℕ))).mul_left A
  have hC : Summable C := hbase.congr_cofinite ?_
  · apply summable_weighted_multiplicative_of_local_bound (idealCorrection K u)
      (idealCorrection_multiplicative K u) C hC hCpos
    · intro p hp
      haveI : Fact p.Prime := ⟨hp⟩
      simpa only [Real.norm_eq_abs] using idealCorrection_local_summable K u hu p (hlocal p hp)
    · intro p hp
      haveI : Fact p.Prime := ⟨hp⟩
      by_cases hps : p ∈ s
      · simp only [C, if_pos hps, Real.norm_eq_abs]
        linarith
      · obtain ⟨hup, hr, hbound⟩ := hgood p hp hps
        simpa only [C, if_neg hps, A, Real.norm_eq_abs] using
          idealCorrection_local_good_bound K u hu p (u p) B hB hup hr hbound
  · filter_upwards [s.finite_toSet.compl_mem_cofinite] with n hn
    exact (if_neg hn).symm

lemma rootCorrection_summable_of_prime_agreement (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (K : Type*) [Field K] [NumberField K] (s : Finset ℕ)
    (hagree : ∀ p : ℕ, p.Prime → p ∉ s →
      (polynomialRootResidues f p).card = idealNormCount K p)
    (hlocal : ∀ p : ℕ, p.Prime → Summable
      (fun k : ℕ ↦ (polynomialRootResidues f (p ^ k)).card / (p : ℝ) ^ k)) :
    Summable (fun n : ℕ ↦ ‖idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) n /
      (n : ℝ)‖) := by
  let D := (f.resultant f.derivative).natAbs
  have hD0 : D ≠ 0 := Int.natAbs_ne_zero.mpr (resultant_derivative_ne_zero_of_irreducible f hdeg hirr)
  apply idealCorrection_summable_of_finite_good_primes K
    (polynomialRootCount f : ArithmeticFunction ℝ) (polynomialRootCount_multiplicative f).natCast
    (s ∪ D.primeFactors) (f.natDegree + 1 : ℝ) (by positivity)
  · intro p hp
    simpa only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk]
      using (hlocal p hp).norm
  · intro p hp hps
    haveI : Fact p.Prime := ⟨hp⟩
    have hps' : p ∉ s := fun h ↦ hps (Finset.mem_union_left _ h)
    have hnotdiv : ¬p ∣ D := fun h ↦ hps
      (Finset.mem_union_right _ (Nat.mem_primeFactors.mpr ⟨hp, h, hD0⟩))
    have hres : ¬(p : ℤ) ∣ f.resultant f.derivative := by
      intro h
      exact hnotdiv (by simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr h)
    refine ⟨?_, ?_, ?_⟩
    · change ((polynomialRootResidues f p).card : ℝ) = (idealNormCount K p : ℝ)
      exact_mod_cast hagree p hp hps' 
    · intro j
      change ((polynomialRootResidues f (p ^ (j + 1))).card : ℝ) = (polynomialRootResidues f p).card
      exact_mod_cast rootResidues_prime_pow_of_not_dvd_resultant f hdeg p j hres
    · intro j
      rw [ArithmeticFunction.natCoe_apply, abs_of_nonneg (Nat.cast_nonneg _)]
      cases j with
      | zero => simp [pow_zero, (polynomialRootCount_multiplicative f).map_one]
      | succ j =>
        change ((polynomialRootResidues f (p ^ (j + 1))).card : ℝ) ≤ _
        rw [rootResidues_prime_pow_of_not_dvd_resultant f hdeg p j hres]
        have hb := rootResidues_prime_le_natDegree_of_simple f p
          (simple_roots_of_not_dvd_resultant f hdeg p hres)
        have hbR : ((polynomialRootResidues f p).card : ℝ) ≤ f.natDegree := by exact_mod_cast hb
        linarith

lemma eval_sub_factor_derivative {R : Type*} [CommRing R] (f : R[X]) (x y : R) :
    ∃ q : R, f.eval x - f.eval y = (x-y) * (f.derivative.eval y + (x-y)*q) := by
  obtain ⟨g, hg⟩ := X_sub_C_dvd_sub_C_eval (p := f) (a := y)
  have hder := congrArg (fun F : R[X] ↦ F.derivative.eval y) hg
  simp only [derivative_sub, derivative_C, sub_zero, derivative_mul, derivative_X,
    eval_add, eval_mul, one_mul, eval_sub, eval_X, eval_C, sub_self,
    zero_mul, add_zero] at hder
  obtain ⟨q, hq⟩ := sub_dvd_eval_sub x y g
  refine ⟨q, ?_⟩
  have he := congrArg (fun F : R[X] ↦ F.eval x) hg
  simp only [eval_sub, eval_C, eval_mul, eval_X] at he
  rw [he, hder]
  congr 1
  linear_combination hq

lemma prime_pow_dvd_left_of_bounded_right {R : Type*} [CommRing R] [IsDomain R]
    (p : R) (hp : Prime p) (k e : ℕ) (a b : R)
    (hab : p ^ (k + e) ∣ a * b) (hb : ¬p ^ e ∣ b) : p ^ k ∣ a := by
  induction e generalizing b with
  | zero => exact (hb (by simp)).elim
  | succ e ih =>
    by_cases hd : p ∣ b
    · obtain ⟨c, rfl⟩ := hd
      apply ih c
      · apply (mul_dvd_mul_iff_left hp.ne_zero).mp
        simpa only [Nat.add_succ, pow_succ, mul_assoc, mul_comm, mul_left_comm] using hab
      · intro h
        exact hb (by simpa only [pow_succ, mul_comm] using mul_dvd_mul_left p h)
    · exact (pow_dvd_pow p (by omega : k ≤ k + (e + 1))).trans
        (hp.pow_dvd_of_dvd_mul_right _ hd hab)

lemma root_derivative_not_dvd (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (m : ℤ) (hm : ¬m ∣ f.resultant f.derivative) (x : ℤ) (hx : m ∣ f.eval x) :
    ¬m ∣ f.derivative.eval x := by
  obtain ⟨a, b, _, _, hab⟩ :=
    Polynomial.exists_mul_add_mul_eq_C_resultant f f.derivative le_rfl le_rfl (Or.inl hdeg)
  intro hd
  apply hm
  have he := congrArg (fun g : ℤ[X] ↦ g.eval x) hab
  simp only [eval_add, eval_mul, eval_C] at he
  rw [← he]
  exact dvd_add (dvd_mul_of_dvd_left hx _) (dvd_mul_of_dvd_left hd _)

lemma root_difference_dvd_of_congruent (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p : ℕ) (hp : p.Prime) (e k : ℕ) (hek : e ≤ k)
    (hres : ¬(p : ℤ) ^ e ∣ f.resultant f.derivative)
    (x y : ℤ) (hx : (p : ℤ) ^ k ∣ f.eval x) (hy : (p : ℤ) ^ k ∣ f.eval y)
    (hxy : (p : ℤ) ^ e ∣ x - y) : (p : ℤ) ^ (k-e) ∣ x - y := by
  have hd := root_derivative_not_dvd f hdeg ((p : ℤ) ^ e) hres y
    ((pow_dvd_pow (p : ℤ) hek).trans hy)
  obtain ⟨q, hq⟩ := eval_sub_factor_derivative f x y
  apply prime_pow_dvd_left_of_bounded_right (p : ℤ) (Nat.prime_iff_prime_int.mp hp)
    (k-e) e (x-y) (f.derivative.eval y + (x-y)*q)
  · rw [Nat.sub_add_cancel hek, ← hq]
    exact dvd_sub hx hy
  · intro h
    apply hd
    exact (dvd_add_left (dvd_mul_of_dvd_left hxy q)).mp h

lemma rootResidues_prime_pow_card_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p : ℕ) (hp : p.Prime) (e : ℕ)
    (hres : ¬(p : ℤ) ^ e ∣ f.resultant f.derivative) (k : ℕ) :
    (polynomialRootResidues f (p ^ k)).card ≤ p ^ (2*e) := by
  by_cases hek : e ≤ k
  · let φ : ℕ → ℕ × ℕ := fun x ↦ (x % p^e, x / p^(k-e))
    have hcard := Finset.card_le_card_of_injOn φ
      (s := polynomialRootResidues f (p^k))
      (t := (Finset.range (p^e)) ×ˢ (Finset.range (p^e)))
    have heq : p^e * p^(k-e) = p^k := by rw [← pow_add, Nat.add_sub_of_le hek]
    have hmaps : Set.MapsTo φ (polynomialRootResidues f (p^k))
        (↑((Finset.range (p^e)) ×ˢ (Finset.range (p^e))) : Set (ℕ × ℕ)) := by
      intro x hx
      obtain ⟨hx, _⟩ := (Finset.mem_filter.mp (show x ∈ (Finset.range (p^k)).filter _ from hx))
      change (x % p^e, x / p^(k-e)) ∈ (Finset.range (p^e)) ×ˢ (Finset.range (p^e))
      simp only [Finset.mem_product, Finset.mem_range]
      refine ⟨Nat.mod_lt _ (pow_pos hp.pos _), ?_⟩
      apply (Nat.div_lt_iff_lt_mul (pow_pos hp.pos _)).mpr
      rw [heq]
      exact Finset.mem_range.mp hx
    have hinj : (↑(polynomialRootResidues f (p^k)) : Set ℕ).InjOn φ := by
      intro x hx y hy hxy
      obtain ⟨hxlt, hx⟩ := (Finset.mem_filter.mp (show x ∈ (Finset.range (p^k)).filter _ from hx))
      obtain ⟨hylt, hy⟩ := (Finset.mem_filter.mp (show y ∈ (Finset.range (p^k)).filter _ from hy))
      have hlo : x % p^e = y % p^e := congrArg Prod.fst hxy
      have hhi : x / p^(k-e) = y / p^(k-e) := congrArg Prod.snd hxy
      have hd : (p : ℤ)^(k-e) ∣ (x : ℤ) - y :=
        root_difference_dvd_of_congruent f hdeg p hp e k hek hres x y
          (by simpa only [Nat.cast_pow] using hx)
          (by simpa only [Nat.cast_pow] using hy)
          (by simpa only [Nat.cast_pow] using (Nat.modEq_iff_dvd.mp hlo.symm))
      have hemod : y % p^(k-e) = x % p^(k-e) :=
        Nat.modEq_iff_dvd.mpr (by simpa only [Nat.cast_pow] using hd)
      have hxdiv := Nat.mod_add_div x (p^(k-e))
      have hydiv := Nat.mod_add_div y (p^(k-e))
      rw [← hhi, hemod] at hydiv
      omega
    simpa only [Finset.card_product, Finset.card_range, ← pow_add,
      ← two_mul] using hcard hmaps hinj
  · have hsub : polynomialRootResidues f (p^k) ⊆ Finset.range (p^k) :=
      Finset.filter_subset _ _
    exact (Finset.card_le_card hsub).trans (by
      rw [Finset.card_range]
      exact Nat.pow_le_pow_right hp.pos (by omega))

lemma exists_bound_prime_pow_rootResidues_of_resultant_ne_zero (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hres : f.resultant f.derivative ≠ 0)
    (p : ℕ) (hp : p.Prime) :
    ∃ B : ℕ, ∀ k : ℕ, (polynomialRootResidues f (p^k)).card ≤ B := by
  let e := (f.resultant f.derivative).natAbs
  have he : ¬(p : ℤ)^e ∣ f.resultant f.derivative := by
    intro h
    have hd : p^e ∣ e := by
      simpa only [Int.natAbs_pow, Int.natAbs_natCast, e] using Int.natAbs_dvd_natAbs.mpr h
    exact (Nat.lt_pow_self hp.one_lt).not_ge
      (Nat.le_of_dvd (Int.natAbs_pos.mpr hres) hd)
  exact ⟨p^(2*e), rootResidues_prime_pow_card_bound f hdeg p hp e he⟩

lemma rootResidues_prime_pow_weighted_summable_of_resultant_ne_zero (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hres : f.resultant f.derivative ≠ 0)
    (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ (polynomialRootResidues f (p^k)).card / (p:ℝ)^k) := by
  obtain ⟨B, hB⟩ := exists_bound_prime_pow_rootResidues_of_resultant_ne_zero f hdeg hres p hp
  have hgeom : Summable (fun k : ℕ ↦ (B:ℝ) / (p:ℝ)^k) := by
    simp_rw [div_eq_mul_inv, ← inv_pow]
    exact (summable_geometric_of_lt_one (r := (p:ℝ)⁻¹) (by positivity)
      (inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt))).mul_left (B:ℝ)
  apply Summable.of_nonneg_of_le (fun _ ↦ by positivity) _ hgeom
  intro k
  apply div_le_div_of_nonneg_right _ (by positivity)
  exact_mod_cast hB k


lemma rootResidues_prime_pow_weighted_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ (polynomialRootResidues f (p^k)).card / (p:ℝ)^k) :=
  rootResidues_prime_pow_weighted_summable_of_resultant_ne_zero f hdeg
    (resultant_derivative_ne_zero_of_irreducible f hdeg hirr) p hp

lemma rootCorrection_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (K : Type*) [Field K] [NumberField K] (s : Finset ℕ)
    (hagree : ∀ p : ℕ, p.Prime → p ∉ s →
      (polynomialRootResidues f p).card = idealNormCount K p) :
    Summable (fun n : ℕ ↦ ‖idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) n /
      (n : ℝ)‖) :=
  rootCorrection_summable_of_prime_agreement f hdeg hirr K s hagree
    (rootResidues_prime_pow_weighted_summable f hdeg hirr)


lemma weighted_atom_prime_pow (p : ℕ) (hp : p.Prime) (e k : ℕ) :
    dirichletAtom (p^e) (p^k) / (p:ℝ)^k =
      if k = e then ((p:ℝ)^e)⁻¹ else 0 := by
  have hpow : p^k = p^e ↔ k = e := (Nat.pow_right_injective hp.two_le).eq_iff
  by_cases hk : k = e
  · simp [dirichletAtom, hk, hp.ne_zero, div_eq_mul_inv]
  · simp [dirichletAtom, hpow, hk]

lemma idealLocalInverse_weighted_tsum (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    (∑' k : ℕ, idealLocalInverse K p (p^k) / (p:ℝ)^k) =
      ∏ P ∈ rationalPrimeIdeals K p, (1 - (Ideal.absNorm P : ℝ)⁻¹) := by
  classical
  let e := fun P : Ideal (𝓞 K) ↦ (Ideal.span {(p:ℤ)}).inertiaDeg P
  have hs : ∀ t ∈ (rationalPrimeIdeals K p).powerset,
      Summable (fun k : ℕ ↦ (-1:ℝ)^t.card * dirichletAtom (p^(∑ P ∈ t, e P)) (p^k) /
        (p:ℝ)^k) := by
    intro t ht
    simp_rw [mul_div_assoc, weighted_atom_prime_pow p Fact.out]
    exact (hasSum_ite_eq (∑ P ∈ t, e P) ((p:ℝ)^(∑ P ∈ t, e P))⁻¹).summable.mul_left _
  simp_rw [idealLocalInverse_powerset, Finset.sum_div]
  rw [Summable.tsum_finsetSum hs]
  rw [Finset.prod_sub]
  apply Finset.sum_congr rfl
  intro t ht
  simp only [Finset.prod_const_one, mul_one]
  have he : (∏ P ∈ t, (Ideal.absNorm P : ℝ)⁻¹) = ((p:ℝ)^(∑ P ∈ t, e P))⁻¹ := by
    rw [Finset.prod_inv_distrib]
    congr 1
    rw [← Finset.prod_pow_eq_pow_sum]
    apply Finset.prod_congr rfl
    intro P hP
    exact_mod_cast norm_of_mem_rationalPrimeIdeals K p P ((Finset.mem_powerset.mp ht) hP)
  rw [he]
  simp_rw [mul_div_assoc, weighted_atom_prime_pow p Fact.out]
  rw [tsum_mul_left, tsum_ite_eq]

lemma idealLocalInverse_weighted_tsum_pos (K : Type*) [Field K] [NumberField K]
    (p : ℕ) [Fact p.Prime] :
    0 < ∑' k : ℕ, idealLocalInverse K p (p^k) / (p:ℝ)^k := by
  rw [idealLocalInverse_weighted_tsum]
  apply Finset.prod_pos
  intro P hP
  apply sub_pos.mpr
  apply inv_lt_one_of_one_lt₀
  rw [norm_of_mem_rationalPrimeIdeals K p P hP, Nat.cast_pow]
  exact one_lt_pow₀ (by exact_mod_cast (Fact.out : p.Prime).one_lt)
    (rationalPrimeIdeals_inertia_pos K p P hP).ne'

lemma convolution_prime_pow_weighted_tsum (u v : ArithmeticFunction ℝ)
    (p : ℕ) (hp : p.Prime)
    (hu : Summable (fun k : ℕ ↦ ‖u (p^k) / (p:ℝ)^k‖))
    (hv : Summable (fun k : ℕ ↦ ‖v (p^k) / (p:ℝ)^k‖)) :
    (∑' k : ℕ, (u*v) (p^k) / (p:ℝ)^k) =
      (∑' k : ℕ, u (p^k) / (p:ℝ)^k) * (∑' k : ℕ, v (p^k) / (p:ℝ)^k) := by
  rw [tsum_mul_tsum_eq_tsum_sum_range_of_summable_norm hu hv]
  apply tsum_congr
  intro k
  exact convolution_prime_pow_weighted u v p k hp

lemma idealCorrection_local_tsum_pos (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (hu0 : ∀ n, 0 ≤ u n)
    (p : ℕ) [Fact p.Prime]
    (hs : Summable (fun k : ℕ ↦ ‖u (p^k) / (p:ℝ)^k‖)) :
    0 < ∑' k : ℕ, idealCorrection K u (p^k) / (p:ℝ)^k := by
  simp_rw [idealCorrection_prime_pow K u hu p]
  rw [convolution_prime_pow_weighted_tsum _ _ p Fact.out
    (idealLocalInverse_weighted_summable K p) hs]
  apply mul_pos (idealLocalInverse_weighted_tsum_pos K p)
  have h1 := hs.of_norm.le_tsum 0 (fun k _ ↦ div_nonneg (hu0 _) (by positivity))
  simp only [pow_zero, hu.map_one, div_one] at h1
  exact zero_lt_one.trans_le h1


lemma prime_power_pair_injective :
    Function.Injective (fun z : Nat.Primes × ℕ ↦ (z.1 : ℕ) ^ (z.2 + 1)) := by
  intro x y h
  obtain ⟨hp, hk⟩ := x.1.property.pow_inj y.1.property h
  exact Prod.ext (Subtype.ext hp) hk

lemma tsum_pos_of_multiplicative_local_pos (f : ℕ → ℝ)
    (hf0 : f 0 = 0) (hf1 : f 1 = 1)
    (hmul : ∀ {m n}, m.Coprime n → f (m*n) = f m * f n)
    (hs : Summable (fun n ↦ ‖f n‖))
    (hlocal : ∀ p : Nat.Primes, 0 < ∑' k : ℕ, f ((p:ℕ)^k)) :
    0 < ∑' n : ℕ, f n := by
  let F : Nat.Primes → ℝ := fun p ↦ ∑' k : ℕ, f ((p:ℕ)^k)
  let C : Nat.Primes → ℝ := fun p ↦ ∑' k : ℕ, f ((p:ℕ)^(k+1))
  have hprime : Summable (fun z : Nat.Primes × ℕ ↦ ‖f ((z.1:ℕ)^(z.2+1))‖) :=
    hs.comp_injective prime_power_pair_injective
  have hC : Summable (fun p ↦ ‖C p‖) :=
    Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) (fun p ↦
      norm_tsum_le_tsum_norm (hprime.prod_factor p)) hprime.prod
  have hFC : F = fun p ↦ 1 + C p := by
    funext p
    have hsp := hs.comp_injective (Nat.pow_right_injective p.property.two_le)
    have he := hsp.of_norm.tsum_eq_zero_add
    simpa only [pow_zero, hf1, F, C] using he
  have hnz : (∏' p : Nat.Primes, F p) ≠ 0 := by
    rw [hFC]
    apply tprod_one_add_ne_zero_of_summable _ hC
    intro p
    rw [← congrFun hFC p]
    exact (hlocal p).ne'
  have he := EulerProduct.eulerProduct_hasProd hf1 hmul hs hf0
  have hnonneg : 0 ≤ ∑' n : ℕ, f n := by
    apply ge_of_tendsto he
    exact Filter.Eventually.of_forall (fun s : Finset Nat.Primes ↦
      Finset.prod_nonneg (fun p _ ↦ (hlocal p).le))
  exact lt_of_le_of_ne hnonneg (by rw [← he.tprod_eq]; exact hnz.symm)

lemma idealCorrection_tsum_pos (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (hu0 : ∀ n, 0 ≤ u n)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖u (p^k) / (p:ℝ)^k‖))
    (hs : Summable (fun n : ℕ ↦ ‖idealCorrection K u n / (n:ℝ)‖)) :
    0 < ∑' n : ℕ, idealCorrection K u n / (n:ℝ) := by
  refine tsum_pos_of_multiplicative_local_pos
    (fun n ↦ idealCorrection K u n / (n:ℝ)) (by simp)
    (by simp [(idealCorrection_multiplicative K u).map_one]) ?_ hs ?_
  · intro m n hmn
    dsimp only
    rw [(idealCorrection_multiplicative K u).map_mul_of_coprime hmn, Nat.cast_mul,
      div_mul_div_comm]
  · intro p
    haveI : Fact (p:ℕ).Prime := ⟨p.property⟩
    simpa only [Nat.cast_pow] using idealCorrection_local_tsum_pos K u hu hu0 p
      (hlocal p p.property)

lemma root_harmonic_positive_limit_of_prime_agreement (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (K : Type*) [Field K] [NumberField K] (s : Finset ℕ)
    (hagree : ∀ p : ℕ, p.Prime → p ∉ s →
      (polynomialRootResidues f p).card = idealNormCount K p) :
    ∃ c > (0:ℝ), Tendsto
      (fun N : ℕ ↦ harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 c) := by
  have hs := rootCorrection_summable f hdeg hirr K s hagree
  refine ⟨_, mul_pos ?_ (NumberField.dedekindZeta_residue_pos K),
    root_harmonic_limit_of_idealCorrection_summable f K hs⟩
  apply idealCorrection_tsum_pos K _ (polynomialRootCount_multiplicative f).natCast
    (fun _ ↦ Nat.cast_nonneg _) _ hs
  intro p hp
  simpa only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk]
    using (rootResidues_prime_pow_weighted_summable f hdeg hirr p hp).norm

lemma ringOfIntegers_exponent_ne_zero (K : Type*) [Field K] [NumberField K]
    (θ : 𝓞 K) (htop : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    RingOfIntegers.exponent θ ≠ 0 := by
  let B := PowerBasis.ofAdjoinEqTop θ.isIntegral_coe.tower_top htop
  have hB : B.gen = (θ : K) := rfl
  have hdiscint : IsIntegral ℤ (Algebra.discr ℚ B.basis) :=
    Algebra.discr_isIntegral ℚ (fun i ↦ by
      rw [B.basis_eq_pow i, hB]
      exact θ.isIntegral_coe.pow _)
  obtain ⟨d, hd⟩ := IsIntegrallyClosed.isIntegral_iff.mp hdiscint
  have hd0 : d ≠ 0 := by
    intro hz
    exact Algebra.discr_not_zero_of_basis ℚ B.basis (by simpa [hz] using hd.symm)
  have hcond : (d : 𝓞 K) ∈ conductor ℤ θ := by
    rw [mem_conductor_iff]
    intro z
    have hz := Algebra.discr_mul_isIntegral_mem_adjoin ℚ
      (show IsIntegral ℤ B.gen from θ.isIntegral_coe) z.isIntegral_coe
    rw [hB, ← hd, algebraMap_smul, Algebra.smul_def] at hz
    have himage : Algebra.adjoin ℤ {(θ : K)} =
        (Algebra.adjoin ℤ {θ}).map (IsScalarTower.toAlgHom ℤ (𝓞 K) K) := by
      rw [AlgHom.map_adjoin, Set.image_singleton]
      rfl
    rw [himage] at hz
    obtain ⟨y, hy, he⟩ := hz
    have hyz : y = (d : 𝓞 K) * z := by
      apply NumberField.RingOfIntegers.ext
      simpa using he
    rwa [hyz] at hy
  intro hz
  have hbot : Ideal.under ℤ (conductor ℤ θ) = ⊥ := Ideal.absNorm_eq_zero_iff.mp hz
  have hdmem : d ∈ Ideal.under ℤ (conductor ℤ θ) := hcond
  rw [hbot, Ideal.mem_bot] at hdmem
  exact hd0 hdmem

lemma integralNormalization_minpoly_of_primitive_root (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (K : Type*) [Field K] [NumberField K]
    (α : K) (hroot : f.aeval α = 0) (htop : Algebra.adjoin ℚ {α} = ⊤)
    (hdim : Module.finrank ℚ K = f.natDegree) :
    ∃ θ : 𝓞 K, minpoly ℤ θ = f.integralNormalization ∧
      Algebra.adjoin ℚ {(θ : K)} = ⊤ := by
  have hf : f ≠ 0 := by intro h; simp [h] at hdeg
  have hlc : (f.leadingCoeff : K) ≠ 0 := by
    exact_mod_cast leadingCoeff_ne_zero.mpr hf
  let z : K := (f.leadingCoeff : K) * α
  have hz : f.integralNormalization.aeval z = 0 := by
    exact integralNormalization_aeval_eq_zero hroot (fun x hx ↦ (FaithfulSMul.algebraMap_injective ℤ K) (hx.trans (map_zero _).symm))
  have hint : IsIntegral ℤ z := ⟨f.integralNormalization, monic_integralNormalization hf, hz⟩
  let θ : 𝓞 K := ⟨z, hint⟩
  have hztop : Algebra.adjoin ℚ {z} = ⊤ := by
    apply top_unique
    rw [← htop]
    apply Algebra.adjoin_le
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    have hzmem : z ∈ Algebra.adjoin ℚ {z} := Algebra.subset_adjoin (Set.mem_singleton _)
    have hm := (Algebra.adjoin ℚ {z}).smul_mem hzmem ((f.leadingCoeff : ℚ)⁻¹)
    simpa only [Algebra.smul_def, map_inv₀, map_intCast, z, inv_mul_cancel_left₀ hlc] using hm
  let B := PowerBasis.ofAdjoinEqTop hint.tower_top hztop
  have hmin_deg : (minpoly ℤ θ).natDegree = f.natDegree := by
    have he := minpoly.isIntegrallyClosed_eq_field_fractions ℚ K θ.isIntegral
    have hd := congrArg Polynomial.natDegree he
    rw [(minpoly.monic θ.isIntegral).natDegree_map] at hd
    rw [← hd]
    change (minpoly ℚ B.gen).natDegree = _
    rw [B.natDegree_minpoly, ← B.finrank, hdim]
  refine ⟨θ, ?_, hztop⟩
  apply (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic θ.isIntegral)
    (monic_integralNormalization hf) ?_ ?_).symm
  · apply minpoly.isIntegrallyClosed_dvd θ.isIntegral
    apply (FaithfulSMul.algebraMap_injective (𝓞 K) K)
    rw [map_zero, ← aeval_algebraMap_apply]
    exact hz
  · simp only [natDegree_integralNormalization, hmin_deg, le_refl]


lemma rootResidues_integralNormalization_prime (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p : ℕ) [Fact p.Prime] (hp : ¬(p:ℤ) ∣ f.leadingCoeff) :
    (polynomialRootResidues f p).card =
      (polynomialRootResidues f.integralNormalization p).card := by
  have ha : (f.leadingCoeff : ZMod p) ≠ 0 :=
    fun h ↦ hp ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h)
  let e : ModularRoot f p ≃ ModularRoot f.integralNormalization p :=
    Equiv.subtypeEquiv (Equiv.mulLeft₀ (f.leadingCoeff : ZMod p) ha) (fun x ↦ by
      change f.eval₂ (Int.castRingHom (ZMod p)) x = 0 ↔
        f.integralNormalization.eval₂ (Int.castRingHom (ZMod p))
          ((f.leadingCoeff : ZMod p) * x) = 0
      have he := integralNormalization_eval₂_leadingCoeff_mul (p := f) (by omega)
        (Int.castRingHom (ZMod p)) x
      simp only [Int.coe_castRingHom] at he
      rw [he]
      simp only [mul_eq_zero, pow_ne_zero _ ha, false_or])
  rw [rootResidues_card_eq_modularRoot, rootResidues_card_eq_modularRoot]
  exact Nat.card_congr e

lemma exists_numberField_prime_root_agreement (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ (K : Type) (_ : Field K) (_ : NumberField K) (s : Finset ℕ),
      ∀ p : ℕ, p.Prime → p ∉ s →
        (polynomialRootResidues f p).card = idealNormCount K p := by
  classical
  let F : ℚ[X] := f.map (Int.castRingHom ℚ)
  have hirrQ : Irreducible F :=
    ((hirr.isPrimitive hdeg).irreducible_iff_irreducible_map_fraction_map (K := ℚ)).mp hirr
  letI : Fact (Irreducible F) := ⟨hirrQ⟩
  let K := AdjoinRoot F
  let α : K := AdjoinRoot.root F
  have hroot : f.aeval α = 0 := by
    rw [← aeval_map_algebraMap ℚ]
    exact (AdjoinRoot.aeval_eq F).trans AdjoinRoot.mk_self
  have htop : Algebra.adjoin ℚ {α} = ⊤ := AdjoinRoot.adjoinRoot_eq_top
  have hdim : Module.finrank ℚ K = f.natDegree := by
    rw [(AdjoinRoot.powerBasis hirrQ.ne_zero).finrank]
    exact natDegree_map_eq_of_injective Int.cast_injective f
  obtain ⟨θ, hmin, hθ⟩ :=
    integralNormalization_minpoly_of_primitive_root f hdeg K α hroot htop hdim
  have hexp := ringOfIntegers_exponent_ne_zero K θ hθ
  have hlc : f.leadingCoeff.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr (leadingCoeff_ne_zero.mpr hirr.ne_zero)
  refine ⟨K, inferInstance, inferInstance,
    f.leadingCoeff.natAbs.primeFactors ∪ (RingOfIntegers.exponent θ).primeFactors, ?_⟩
  intro p hp hps
  haveI : Fact p.Prime := ⟨hp⟩
  have hplc : ¬(p:ℤ) ∣ f.leadingCoeff := by
    intro h
    apply hps
    apply Finset.mem_union_left
    apply Nat.mem_primeFactors.mpr
    exact ⟨hp, by simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr h, hlc⟩
  have hpexp : ¬p ∣ RingOfIntegers.exponent θ := by
    intro h
    exact hps (Finset.mem_union_right _ (Nat.mem_primeFactors.mpr ⟨hp, h, hexp⟩))
  rw [rootResidues_integralNormalization_prime f hdeg p hplc, ← hmin,
    rootResidues_minpoly_prime_eq_ideal_count K θ p hpexp, idealNormCount_apply K p hp.ne_zero]


lemma polynomialRootCount_positive_harmonic_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ c > (0:ℝ), Tendsto
      (fun N : ℕ ↦ harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / log N)
      atTop (𝓝 c) := by
  obtain ⟨K, hK, hNF, s, hagree⟩ := exists_numberField_prime_root_agreement f hdeg hirr
  letI := hK
  letI := hNF
  exact root_harmonic_positive_limit_of_prime_agreement f hdeg hirr K s hagree


lemma erdos975_degree_two (f : ℤ[X]) (hdeg : f.natDegree = 2) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ c > (0:ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) := by
  obtain ⟨κ, hκ, hH⟩ := polynomialRootCount_positive_harmonic_limit f (by omega) hirr
  exact ⟨2 * κ, mul_pos (by norm_num) hκ, erdos975_degree_two_of_harmonic f hdeg hpos κ hH⟩

lemma erdos975_degree_le_two (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hle : f.natDegree ≤ 2) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ c > (0:ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) := by
  by_cases h1 : f.natDegree = 1
  · exact erdos975_degree_one f h1 hirr hpos
  · exact erdos975_degree_two f (by omega) hirr hpos

lemma erdos975_degree_gt_two_iff_balanced_converges (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    (∃ c > (0:ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c)) ↔
    (∃ β : ℝ, Tendsto
      (fun N : ℕ ↦ Erdos975BalancedDivisorSum f N / ((N:ℝ) * log N)) atTop (𝓝 β)) := by
  obtain ⟨κ, hκ, hH⟩ := polynomialRootCount_positive_harmonic_limit f (by omega) hirr
  constructor
  · rintro ⟨c, _, hc⟩
    exact ⟨c/2-κ, (erdos975_degree_gt_two_iff_balanced f hdeg hpos κ c hH).mp hc⟩
  · exact erdos975_degree_gt_two_of_balanced_limit f hdeg hpos κ hκ hH


noncomputable def summatoryWeightSum (u : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 N, u n

lemma summatoryWeightSum_convolution (g h : ArithmeticFunction ℝ) (N : ℕ) :
    summatoryWeightSum (g * h : ArithmeticFunction ℝ) N =
      ∑ a ∈ Finset.Icc 1 N, g a * summatoryWeightSum h (N / a) := by
  unfold summatoryWeightSum
  calc
    _ = ∑ n ∈ Finset.Icc 1 N, ∑ a ∈ Finset.Icc 1 N,
        if a ∣ n then g a * h (n / a) else 0 := by
      apply Finset.sum_congr rfl
      intro n hn
      obtain ⟨hn1, hnN⟩ := Finset.mem_Icc.mp hn
      have hdiv : n.divisors = (Finset.Icc 1 N).filter (fun a ↦ a ∣ n) := by
        ext a
        simp only [Nat.mem_divisors, Finset.mem_filter, Finset.mem_Icc]
        constructor
        · rintro ⟨ha, _⟩
          exact ⟨⟨Nat.pos_of_dvd_of_pos ha hn1, (Nat.le_of_dvd hn1 ha).trans hnN⟩, ha⟩
        · exact fun ha ↦ ⟨ha.2, by omega⟩
      rw [ArithmeticFunction.mul_apply, Nat.sum_divisorsAntidiagonal (fun a b ↦ g a * h b),
        hdiv, Finset.sum_filter]
    _ = ∑ a ∈ Finset.Icc 1 N, ∑ n ∈ Finset.Icc 1 N,
        if a ∣ n then g a * h (n / a) else 0 := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro a ha
      have ha0 : 0 < a := (Finset.mem_Icc.mp ha).1
      rw [← Finset.sum_filter, sum_multiples_weighted _ a N ha0, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro b hb
      simp only [Nat.mul_div_cancel_left b ha0]

lemma tendsto_nat_div_nat_div (n : ℕ) :
    Tendsto (fun N : ℕ ↦ ((N / n : ℕ) : ℝ) / N) atTop (𝓝 (1 / n)) := by
  have h := (tendsto_nat_floor_mul_div_atTop (a := (1:ℝ) / n) (by positivity)).comp
    (tendsto_natCast_atTop_atTop (R := ℝ))
  simpa only [Function.comp_def, one_div_mul_eq_div, Nat.floor_div_eq_div] using h

lemma summatoryWeightSum_nonneg (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n) (N : ℕ) :
    0 ≤ summatoryWeightSum u N := Finset.sum_nonneg (fun n _ ↦ hu n)

lemma summatoryWeightSum_le_linear_of_mean (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ summatoryWeightSum u N / N) atTop (𝓝 c)) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ N : ℕ, summatoryWeightSum u N ≤ B * N := by
  obtain ⟨B, hB⟩ := h.bddAbove_range
  have hb : ∀ N : ℕ, summatoryWeightSum u N / N ≤ B := fun N ↦ hB ⟨N, rfl⟩
  have hB0 : 0 ≤ B := (div_nonneg (summatoryWeightSum_nonneg u hu 0) (by positivity)).trans (hb 0)
  refine ⟨B, hB0, fun N ↦ ?_⟩
  by_cases hN : N = 0
  · simp [hN, summatoryWeightSum]
  · exact (div_le_iff₀ (Nat.cast_pos.mpr (Nat.pos_of_ne_zero hN))).mp (hb N)

lemma tendsto_summatoryWeightSum_div_div (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ summatoryWeightSum u N / N) atTop (𝓝 c))
    (n : ℕ) (hn : n ≠ 0) :
    Tendsto (fun N : ℕ ↦ summatoryWeightSum u (N / n) / N) atTop (𝓝 (c / n)) := by
  have hD := Nat.tendsto_div_const_atTop hn
  have ht := (h.comp hD).mul (tendsto_nat_div_nat_div n)
  rw [mul_one_div] at ht
  apply ht.congr'
  filter_upwards [hD.eventually_gt_atTop 0] with N hN
  have hD0 : ((N / n : ℕ) : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
  dsimp only [Function.comp_def]
  field_simp

lemma tendsto_summatoryWeightSum_convolution (u v : ArithmeticFunction ℝ)
    (hu : ∀ n, 0 ≤ u n) (c : ℝ)
    (h : Tendsto (fun N : ℕ ↦ summatoryWeightSum u N / N) atTop (𝓝 c))
    (hv : Summable (fun n : ℕ ↦ ‖v n / (n:ℝ)‖)) :
    Tendsto (fun N : ℕ ↦ summatoryWeightSum (v*u : ArithmeticFunction ℝ) N / N)
      atTop (𝓝 ((∑' n : ℕ, v n / (n:ℝ)) * c)) := by
  obtain ⟨B, hB0, hB⟩ := summatoryWeightSum_le_linear_of_mean u hu c h
  let F : ℕ → ℕ → ℝ := fun N n ↦ v n * summatoryWeightSum u (N / n) / N
  have ht := tendsto_tsum_of_dominated_convergence (𝓕 := atTop) (hv.mul_right B)
    (f := F) (g := fun n : ℕ ↦ v n / (n:ℝ) * c) ?_ ?_
  · rw [tsum_mul_right] at ht
    apply ht.congr
    intro N
    rw [tsum_eq_sum (s := Finset.Icc 1 N) ?_, summatoryWeightSum_convolution, Finset.sum_div]
    intro n hn
    by_cases hn0 : n = 0
    · simp [F, hn0]
    · have hnN : N < n := by simp only [Finset.mem_Icc] at hn; omega
      simp [F, Nat.div_eq_of_lt hnN, summatoryWeightSum]
  · intro n
    by_cases hn0 : n = 0
    · simp [F, hn0]
    · have ht := (tendsto_summatoryWeightSum_div_div u c h n hn0).const_mul (v n)
      have hc : v n * (c / (n:ℝ)) = v n / (n:ℝ) * c := by ring
      rw [hc] at ht
      exact ht.congr (fun N ↦ by dsimp only [F]; ring)
  · filter_upwards [eventually_gt_atTop (0 : ℕ)] with N hN
    intro n
    have hN0 : 0 < (N:ℝ) := Nat.cast_pos.mpr hN
    have hA0 := summatoryWeightSum_nonneg u hu (N/n)
    have hA : summatoryWeightSum u (N/n) ≤ B * ((N:ℝ) / n) :=
      (hB _).trans (mul_le_mul_of_nonneg_left Nat.cast_div_le hB0)
    dsimp only [F]
    rw [norm_div, norm_mul, Real.norm_of_nonneg hA0, Real.norm_of_nonneg hN0.le,
      norm_div, Real.norm_of_nonneg (Nat.cast_nonneg n)]
    calc
      _ ≤ ‖v n‖ * (B * ((N:ℝ) / n)) / N := by gcongr
      _ = _ := by field_simp

lemma idealNormCount_mean_limit (K : Type*) [Field K] [NumberField K] :
    Tendsto (fun N : ℕ ↦ summatoryWeightSum (idealNormCount K : ArithmeticFunction ℝ) N / N)
      atTop (𝓝 (NumberField.dedekindZeta_residue K)) := by
  apply (ideal_count_sum_div_limit K).congr
  intro N
  congr 1
  apply Finset.sum_congr rfl
  intro n hn
  rw [ArithmeticFunction.natCoe_apply,
    idealNormCount_apply K n (by have := (Finset.mem_Icc.mp hn).1; omega)]

lemma root_mean_limit_of_idealCorrection_summable (f : ℤ[X])
    (K : Type*) [Field K] [NumberField K]
    (hv : Summable (fun n : ℕ ↦
      ‖idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) n / (n:ℝ)‖)) :
    Tendsto (fun N : ℕ ↦ summatoryWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / N)
      atTop (𝓝 ((∑' n : ℕ, idealCorrection K (polynomialRootCount f : ArithmeticFunction ℝ) n /
        (n:ℝ)) * NumberField.dedekindZeta_residue K)) := by
  have ht := tendsto_summatoryWeightSum_convolution (idealNormCount K : ArithmeticFunction ℝ)
    _ (fun _ ↦ Nat.cast_nonneg _) _ (idealNormCount_mean_limit K) hv
  rw [idealCorrection_mul_idealNormCount K _ (polynomialRootCount_multiplicative f).natCast] at ht
  exact ht


lemma polynomialRootCount_positive_mean_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ c > (0:ℝ), Tendsto
      (fun N : ℕ ↦ summatoryWeightSum (fun d ↦ (polynomialRootResidues f d).card) N / N)
      atTop (𝓝 c) := by
  obtain ⟨K, hK, hNF, s, hagree⟩ := exists_numberField_prime_root_agreement f hdeg hirr
  letI := hK
  letI := hNF
  have hs := rootCorrection_summable f hdeg hirr K s hagree
  refine ⟨_, mul_pos ?_ (NumberField.dedekindZeta_residue_pos K),
    root_mean_limit_of_idealCorrection_summable f K hs⟩
  apply idealCorrection_tsum_pos K _ (polynomialRootCount_multiplicative f).natCast
    (fun _ ↦ Nat.cast_nonneg _) _ hs
  intro p hp
  simpa only [ArithmeticFunction.natCoe_apply, polynomialRootCount, ArithmeticFunction.coe_mk]
    using (rootResidues_prime_pow_weighted_summable f hdeg hirr p hp).norm

lemma polynomialRootCount_sum_le_linear (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ N : ℕ,
      (∑ d ∈ Finset.Icc 1 N, ((polynomialRootResidues f d).card : ℝ)) ≤ B * N := by
  obtain ⟨c, _, hc⟩ := polynomialRootCount_positive_mean_limit f hdeg hirr
  exact summatoryWeightSum_le_linear_of_mean _ (fun _ ↦ Nat.cast_nonneg _) c hc


noncomputable def boundedBalancedDivisorSum (f : ℤ[X]) (N D : ℕ) : ℝ :=
  ∑ n ∈ Finset.Iic N, (((⌊f.eval (n:ℤ)⌋₊).divisors.filter
    (fun d ↦ n < d ∧ d ≤ (⌊f.eval (n:ℤ)⌋₊).sqrt ∧ d ≤ D)).card : ℝ)

noncomputable def polynomialRootBoundarySum (f : ℤ[X]) (N D : ℕ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D, (((polynomialRootResidues f d).filter
    (fun r ↦ r ≤ N ∧ (d:ℤ)^2 ≤ f.eval (r:ℤ))).card : ℝ)

lemma boundedBalancedDivisors_eq_Icc (z : ℤ) (n D : ℕ) :
    (⌊z⌋₊.divisors.filter (fun d ↦ n < d ∧ d ≤ ⌊z⌋₊.sqrt ∧ d ≤ D)) =
      (Finset.Icc 1 D).filter (fun d : ℕ ↦ (d:ℤ) ∣ z ∧ (d:ℤ)^2 ≤ z ∧ n < d) := by
  ext d
  simp only [Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨hd, hnd, hsq, hD⟩
    have hd0 := Nat.pos_of_mem_divisors hd
    have he := (small_divisor_floor_iff z d hd0).mp
      ⟨Nat.dvd_of_mem_divisors hd, Nat.le_sqrt'.mp hsq, Nat.ne_zero_of_mem_divisors hd⟩
    exact ⟨⟨hd0, hD⟩, he.1, he.2, hnd⟩
  · rintro ⟨⟨hd0, hD⟩, hd, hsq, hnd⟩
    have he := (small_divisor_floor_iff z d hd0).mpr ⟨hd, hsq⟩
    exact ⟨Nat.mem_divisors.mpr ⟨he.1, he.2.2⟩, hnd, Nat.le_sqrt'.mpr he.2.1, hD⟩

lemma boundedBalancedDivisorSum_eq_rootBoundary (f : ℤ[X]) (N D : ℕ) :
    boundedBalancedDivisorSum f N D = polynomialRootBoundarySum f N D := by
  unfold boundedBalancedDivisorSum polynomialRootBoundarySum
  simp_rw [boundedBalancedDivisors_eq_Icc]
  have hswap : (∑ n ∈ Finset.Iic N,
      (((Finset.Icc 1 D).filter (fun d : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧
        (d:ℤ)^2 ≤ f.eval (n:ℤ) ∧ n < d)).card : ℝ)) =
      ∑ d ∈ Finset.Icc 1 D, (((Finset.Iic N).filter
        (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧ (d:ℤ)^2 ≤ f.eval (n:ℤ) ∧ n < d)).card : ℝ) := by
    simp only [Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
    exact Finset.sum_comm
  rw [hswap]
  apply Finset.sum_congr rfl
  intro d hd
  congr 2
  ext r
  simp only [polynomialRootResidues, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range]
  tauto

lemma polynomialRootBoundarySum_nonneg (f : ℤ[X]) (N D : ℕ) :
    0 ≤ polynomialRootBoundarySum f N D := by
  exact Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)

lemma polynomialRootBoundarySum_le (f : ℤ[X]) (N D : ℕ) :
    polynomialRootBoundarySum f N D ≤
      summatoryWeightSum (fun d ↦ (polynomialRootResidues f d).card) D := by
  apply Finset.sum_le_sum
  intro d hd
  have hc := Finset.card_filter_le
    (polynomialRootResidues f d) (fun r ↦ r ≤ N ∧ (d:ℤ)^2 ≤ f.eval (r:ℤ))
  exact Nat.cast_le.mpr hc

noncomputable def Erdos975LargeDivisorSum (f : ℤ[X]) (N D : ℕ) : ℝ :=
  ∑ n ∈ Finset.Iic N, (((⌊f.eval (n:ℤ)⌋₊).divisors.filter
    (fun d ↦ D < d ∧ d ≤ (⌊f.eval (n:ℤ)⌋₊).sqrt)).card : ℝ)

lemma balancedDivisorSum_split_at_cutoff (f : ℤ[X]) (N D : ℕ) (hND : N ≤ D) :
    Erdos975BalancedDivisorSum f N =
      polynomialRootBoundarySum f N D + Erdos975LargeDivisorSum f N D := by
  rw [← boundedBalancedDivisorSum_eq_rootBoundary]
  unfold Erdos975BalancedDivisorSum boundedBalancedDivisorSum Erdos975LargeDivisorSum
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  have hnN : n ≤ N := Finset.mem_Iic.mp hn
  let S := (⌊f.eval (n:ℤ)⌋₊).divisors.filter
    (fun d ↦ n < d ∧ d ≤ (⌊f.eval (n:ℤ)⌋₊).sqrt)
  have hlow : S.filter (fun d ↦ d ≤ D) = (⌊f.eval (n:ℤ)⌋₊).divisors.filter
      (fun d ↦ n < d ∧ d ≤ (⌊f.eval (n:ℤ)⌋₊).sqrt ∧ d ≤ D) := by
    ext d
    simp only [S, Finset.mem_filter]
    tauto
  have hhigh : S.filter (fun d ↦ ¬d ≤ D) = (⌊f.eval (n:ℤ)⌋₊).divisors.filter
      (fun d ↦ D < d ∧ d ≤ (⌊f.eval (n:ℤ)⌋₊).sqrt) := by
    ext d
    simp only [S, Finset.mem_filter, not_le]
    constructor
    · tauto
    · rintro ⟨hd, hDd, hsq⟩
      exact ⟨⟨hd, (hnN.trans hND).trans_lt hDd, hsq⟩, hDd⟩
  have he := Finset.card_filter_add_card_filter_not (s := S) (fun d ↦ d ≤ D)
  rw [hlow, hhigh] at he
  exact_mod_cast he.symm

lemma tendsto_polynomialRootBoundarySum_scaled (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) (C : ℕ) :
    Tendsto (fun N : ℕ ↦ polynomialRootBoundarySum f N (C*N) / ((N:ℝ)*log N))
      atTop (𝓝 0) := by
  obtain ⟨B, hB0, hB⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  have hlog := Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))
  have hbound : Tendsto (fun N : ℕ ↦ B * C / log N) atTop (𝓝 0) := hlog.const_div_atTop _
  apply squeeze_zero' _ _ hbound
  · filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    exact div_nonneg (polynomialRootBoundarySum_nonneg f N _)
      (mul_nonneg (Nat.cast_nonneg N) (Real.log_nonneg (by exact_mod_cast hN.le)))
  · filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    have hN0 : 0 < (N:ℝ) := by exact_mod_cast (show 0 < N by omega)
    have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
    calc
      _ ≤ B * (C*N:ℕ) / ((N:ℝ)*log N) := div_le_div_of_nonneg_right
        ((polynomialRootBoundarySum_le f N (C*N)).trans (hB (C*N))) (by positivity)
      _ = _ := by push_cast; field_simp

lemma balanced_limit_iff_largeDivisor_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) (C : ℕ) (hC : 0 < C) (β : ℝ) :
    Tendsto (fun N : ℕ ↦ Erdos975BalancedDivisorSum f N / ((N:ℝ)*log N)) atTop (𝓝 β) ↔
    Tendsto (fun N : ℕ ↦ Erdos975LargeDivisorSum f N (C*N) / ((N:ℝ)*log N)) atTop (𝓝 β) := by
  have hz := tendsto_polynomialRootBoundarySum_scaled f hdeg hirr C
  have he : ∀ N, Erdos975BalancedDivisorSum f N / ((N:ℝ)*log N) =
      polynomialRootBoundarySum f N (C*N) / ((N:ℝ)*log N) +
      Erdos975LargeDivisorSum f N (C*N) / ((N:ℝ)*log N) := by
    intro N
    rw [balancedDivisorSum_split_at_cutoff f N (C*N) (Nat.le_mul_of_pos_left N hC), add_div]
  constructor
  · intro h
    have ht := h.sub hz
    rw [sub_zero] at ht
    exact ht.congr (fun N ↦ by rw [he]; ring)
  · intro h
    have ht := hz.add h
    rw [zero_add] at ht
    exact ht.congr (fun N ↦ (he N).symm)


lemma boundedBalancedDivisorSum_eq_full (f : ℤ[X]) (N M : ℕ)
    (hM : ∀ n ≤ N, (⌊f.eval (n:ℤ)⌋₊).sqrt ≤ M) :
    boundedBalancedDivisorSum f N M = Erdos975BalancedDivisorSum f N := by
  apply Finset.sum_congr rfl
  intro n hn
  congr 2
  ext d
  simp only [Finset.mem_filter]
  have hbound := hM n (Finset.mem_Iic.mp hn)
  constructor
  · tauto
  · rintro ⟨hd, hnd, hds⟩
    exact ⟨hd, hnd, hds, hds.trans hbound⟩

lemma rootBoundarySum_add_tail (f : ℤ[X]) (N D M : ℕ) (hDM : D ≤ M) :
    polynomialRootBoundarySum f N D +
      (∑ d ∈ Finset.Ioc D M, (((polynomialRootResidues f d).filter
        (fun r ↦ r ≤ N ∧ (d:ℤ)^2 ≤ f.eval (r:ℤ))).card : ℝ)) =
      polynomialRootBoundarySum f N M := by
  have hdis : Disjoint (Finset.Icc 1 D) (Finset.Ioc D M) := by
    apply Finset.disjoint_left.mpr
    intro d hd he
    simp only [Finset.mem_Icc, Finset.mem_Ioc] at hd he
    omega
  have heq : Finset.Icc 1 D ∪ Finset.Ioc D M = Finset.Icc 1 M := by
    ext d
    simp only [Finset.mem_union, Finset.mem_Icc, Finset.mem_Ioc]
    omega
  unfold polynomialRootBoundarySum
  rw [← Finset.sum_union hdis, heq]

lemma largeDivisorSum_eq_root_tail (f : ℤ[X]) (N D M : ℕ) (hND : N ≤ D) (hDM : D ≤ M)
    (hM : ∀ n ≤ N, (⌊f.eval (n:ℤ)⌋₊).sqrt ≤ M) :
    Erdos975LargeDivisorSum f N D =
      ∑ d ∈ Finset.Ioc D M, (((polynomialRootResidues f d).filter
        (fun r ↦ r ≤ N ∧ (d:ℤ)^2 ≤ f.eval (r:ℤ))).card : ℝ) := by
  have hs := balancedDivisorSum_split_at_cutoff f N D hND
  have he := rootBoundarySum_add_tail f N D M hDM
  rw [← boundedBalancedDivisorSum_eq_rootBoundary f N M,
    boundedBalancedDivisorSum_eq_full f N M hM] at he
  linarith

noncomputable def polynomialSqrtEnvelope (f : ℤ[X]) (N D : ℕ) : ℕ :=
  max D ((Finset.Iic N).sup (fun n ↦ (⌊f.eval (n:ℤ)⌋₊).sqrt))

lemma polynomialSqrtEnvelope_bound (f : ℤ[X]) (N D : ℕ) (n : ℕ) (hn : n ≤ N) :
    (⌊f.eval (n:ℤ)⌋₊).sqrt ≤ polynomialSqrtEnvelope f N D :=
  (Finset.le_sup (f := fun n : ℕ ↦ (⌊f.eval (n:ℤ)⌋₊).sqrt)
    (Finset.mem_Iic.mpr hn)).trans (le_max_right _ _)

noncomputable def polynomialLargeRootSum (f : ℤ[X]) (N D : ℕ) : ℝ :=
  ∑ d ∈ Finset.Ioc D (polynomialSqrtEnvelope f N D),
    (((polynomialRootResidues f d).filter
      (fun r ↦ r ≤ N ∧ (d:ℤ)^2 ≤ f.eval (r:ℤ))).card : ℝ)

lemma polynomialLargeRootSum_eq_largeDivisorSum (f : ℤ[X]) (N D : ℕ) (hND : N ≤ D) :
    polynomialLargeRootSum f N D = Erdos975LargeDivisorSum f N D :=
  (largeDivisorSum_eq_root_tail f N D _ hND (le_max_left _ _)
    (polynomialSqrtEnvelope_bound f N D)).symm

lemma polynomialLargeRootSum_nonneg (f : ℤ[X]) (N D : ℕ) :
    0 ≤ polynomialLargeRootSum f N D := Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)

lemma erdos975_degree_gt_two_iff_large_root_sum (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (C : ℕ) (hC : 0 < C) :
    (∃ c > (0:ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x*log x)) atTop (𝓝 c)) ↔
      ∃ β : ℝ, Tendsto
        (fun N : ℕ ↦ polynomialLargeRootSum f N (C*N) / ((N:ℝ)*log N)) atTop (𝓝 β) := by
  rw [erdos975_degree_gt_two_iff_balanced_converges f hdeg hirr hpos]
  apply exists_congr
  intro β
  simp_rw [polynomialLargeRootSum_eq_largeDivisorSum f _ _
    (Nat.le_mul_of_pos_left _ hC)]
  exact balanced_limit_iff_largeDivisor_limit f (by omega) hirr C hC β

lemma erdos975_small_modulus_asymptotic (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ κ > (0:ℝ), ∀ C : ℕ, 0 < C → Tendsto
      (fun N : ℕ ↦ (Erdos975Sum f N - 2 * polynomialLargeRootSum f N (C*N)) /
        ((N:ℝ)*log N)) atTop (𝓝 (2*κ)) := by
  obtain ⟨κ, hκ, hH⟩ := polynomialRootCount_positive_harmonic_limit f (by omega) hirr
  refine ⟨κ, hκ, fun C hC ↦ ?_⟩
  have hA := tendsto_polynomialInitialDivisorSum f κ hH
  have hE := tendsto_smallDivisorSum_initial_error f
    (eventually_eval_ge_square_of_degree_gt_two f hdeg hpos)
  have hB := tendsto_polynomialRootBoundarySum_scaled f (by omega) hirr C
  have hQ := (tendsto_squareCorrection f).comp (tendsto_natCast_atTop_atTop (R := ℝ))
  have ht := (((hA.add hE).add hB).const_mul 2).sub hQ
  simp only [add_zero, sub_zero] at ht
  apply ht.congr
  intro N
  dsimp only [Function.comp_def]
  rw [polynomialLargeRootSum_eq_largeDivisorSum f N (C*N) (Nat.le_mul_of_pos_left N hC)]
  have hs := balancedDivisorSum_split_at_cutoff f N (C*N) (Nat.le_mul_of_pos_left N hC)
  have he := erdos975Sum_hyperbola f (N:ℝ)
  rw [hs]
  have he' : Erdos975Sum f N = 2 * Erdos975SmallDivisorSum f N - Erdos975SquareCorrection f N := by
    linarith
  rw [he']
  ring


lemma erdos975_eventual_nat_lower_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ c > (0:ℝ), ∀ᶠ N : ℕ in atTop, c ≤ Erdos975Sum f N / ((N:ℝ)*log N) := by
  by_cases hle : f.natDegree ≤ 2
  · obtain ⟨c, hc, hlim⟩ := erdos975_degree_le_two f hdeg hle hirr hpos
    refine ⟨c/2, by linarith, ?_⟩
    exact ((tendsto_erdos975Sum_iff_nat f c).mp hlim).eventually_const_le (by linarith)
  · obtain ⟨κ, hκ, hmain⟩ := erdos975_small_modulus_asymptotic f (by omega) hirr hpos
    refine ⟨κ, hκ, ?_⟩
    have ht := (hmain 1 (by norm_num)).eventually_const_le (show κ < 2*κ by linarith)
    filter_upwards [ht, eventually_gt_atTop (1:ℕ)] with N hN hN1
    have hp := polynomialLargeRootSum_nonneg f N (1*N)
    have hden : 0 ≤ (N:ℝ)*log N := mul_nonneg (Nat.cast_nonneg _)
      (Real.log_nonneg (by exact_mod_cast hN1.le))
    exact hN.trans (div_le_div_of_nonneg_right (by linarith) hden)

lemma erdos975_eventual_lower_bound_of_nat (f : ℤ[X]) (c : ℝ) (hc : 0 < c)
    (h : ∀ᶠ N : ℕ in atTop, c ≤ Erdos975Sum f N / ((N:ℝ)*log N)) :
    ∀ᶠ x : ℝ in atTop, c/2 ≤ Erdos975Sum f x / (x*log x) := by
  have hf := Asymptotics.isEquivalent_nat_floor (R := ℝ)
  have hd := hf.mul (hf.log tendsto_id)
  have hnz : ∀ᶠ x : ℝ in atTop, x * log x ≠ 0 := by
    filter_upwards [eventually_gt_atTop (1:ℝ)] with x hx
    exact (mul_pos (by linarith : 0 < x) (Real.log_pos hx)).ne'
  have hratio := (Asymptotics.isEquivalent_iff_tendsto_one hnz).mp hd
  have hratio' := hratio.eventually_const_le (by norm_num : (1:ℝ)/2 < 1)
  have hfloor := (tendsto_nat_floor_atTop (α := ℝ)).eventually h
  have hfloor2 := (tendsto_nat_floor_atTop (α := ℝ)).eventually_gt_atTop 1
  filter_upwards [hratio', hfloor, hfloor2] with x hxratio hxlower hx2
  have hden : (⌊x⌋₊:ℝ) * log (⌊x⌋₊:ℝ) ≠ 0 := (mul_pos
    (by exact_mod_cast (show 0 < ⌊x⌋₊ by omega)) (Real.log_pos (by exact_mod_cast hx2))).ne'
  have hs : Erdos975Sum f (⌊x⌋₊ : ℝ) = Erdos975Sum f x := by
    simp only [Erdos975Sum, Nat.floor_natCast]
  have hprod := mul_le_mul hxlower hxratio (by norm_num : (0:ℝ) ≤ 1/2)
    (hc.le.trans hxlower)
  change c * (1/2) ≤ (Erdos975Sum f (⌊x⌋₊:ℝ) / ((⌊x⌋₊:ℝ)*log (⌊x⌋₊:ℝ))) *
    (((⌊x⌋₊:ℝ)*log (⌊x⌋₊:ℝ)) / (x*log x)) at hprod
  rw [div_mul_div_cancel₀ hden, hs] at hprod
  simpa only [mul_one_div] using hprod

lemma erdos975_eventual_positive_lower_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ c > (0:ℝ), ∀ᶠ x : ℝ in atTop, c * (x*log x) ≤ Erdos975Sum f x := by
  obtain ⟨c, hc, h⟩ := erdos975_eventual_nat_lower_bound f hdeg hirr hpos
  refine ⟨c/2, by linarith, ?_⟩
  filter_upwards [erdos975_eventual_lower_bound_of_nat f c hc h,
    eventually_gt_atTop (1:ℝ)] with x hx hx1
  exact (le_div_iff₀ (mul_pos (by linarith : 0 < x) (Real.log_pos hx1))).mp hx

lemma nat_succ_le_const_geometric (a : ℝ) (ha : 1 < a) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ k : ℕ, (k+1:ℝ) ≤ B * a^k := by
  have ha0 : 0 < a := zero_lt_one.trans ha
  have hratio : ‖a⁻¹‖ < 1 := by
    rw [Real.norm_of_nonneg (inv_nonneg.mpr ha0.le)]
    exact inv_lt_one_of_one_lt₀ ha
  have hs : Summable (fun k : ℕ ↦ (k+1:ℝ) * (a⁻¹)^k) := by
    simpa using summable_choose_mul_geometric_of_norm_lt_one 1 hratio
  let B := ∑' k : ℕ, (k+1:ℝ) * (a⁻¹)^k
  have hB : ∀ k : ℕ, (k+1:ℝ) * (a⁻¹)^k ≤ B :=
    fun k ↦ hs.le_tsum k (fun i _ ↦ by positivity)
  refine ⟨B, by simpa using hB 0, fun k ↦ ?_⟩
  apply (div_le_iff₀ (pow_pos ha0 k)).mp
  simpa only [div_eq_mul_inv, inv_pow] using hB k

lemma sigma_zero_subpolynomial_bound (ε : ℝ) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ n : ℕ, (σ 0 n : ℝ) ≤ C * (n:ℝ)^ε := by
  classical
  obtain ⟨B, hB1, hB⟩ := nat_succ_le_const_geometric ((2:ℝ)^ε)
    (Real.one_lt_rpow (by norm_num) hε)
  have hB0 : 0 < B := zero_lt_one.trans_le hB1
  obtain ⟨P, hP⟩ := eventually_atTop.mp
    (((tendsto_rpow_atTop hε).comp (tendsto_natCast_atTop_atTop (R := ℝ))).eventually_ge_atTop 2)
  have hlocal : ∀ p : ℕ, p.Prime → ∀ k : ℕ,
      (k+1:ℝ) ≤ (if p < P then B else 1) * ((p:ℝ)^ε)^k := by
    intro p hp k
    by_cases hpp : p < P
    · rw [if_pos hpp]
      refine (hB k).trans (mul_le_mul_of_nonneg_left ?_ hB0.le)
      apply pow_le_pow_left₀ (by positivity)
      exact Real.rpow_le_rpow (by norm_num) (by exact_mod_cast hp.two_le) hε.le
    · rw [if_neg hpp, one_mul]
      have hk : (k+1:ℝ) ≤ (2:ℝ)^k := by exact_mod_cast (show k+1 ≤ 2^k from Nat.lt_two_pow_self)
      exact hk.trans (pow_le_pow_left₀ (by norm_num) (hP p (by omega)) k)
  refine ⟨B^P, pow_pos hB0 _, fun n ↦ ?_⟩
  by_cases hn : n = 0
  · simp [hn, Real.zero_rpow hε.ne']
  have hnprod : (∏ p ∈ n.primeFactors, p ^ n.factorization p) = n := by
    simpa only [Finsupp.prod, n.support_factorization] using Nat.factorization_prod_pow_eq_self hn
  have hpow : (∏ p ∈ n.primeFactors, ((p:ℝ)^ε)^n.factorization p) = (n:ℝ)^ε := by
    have he : ∀ p : ℕ, ((p:ℝ)^ε)^n.factorization p = ((p:ℝ)^n.factorization p)^ε := by
      intro p
      rw [← Real.rpow_mul_natCast (Nat.cast_nonneg p), mul_comm ε,
        Real.rpow_natCast_mul (Nat.cast_nonneg p)]
    simp_rw [he]
    rw [Real.finset_prod_rpow _ _ (fun p _ ↦ by positivity)]
    simp_rw [← Nat.cast_pow]
    rw [← Nat.cast_prod]
    exact congrArg (fun m : ℕ ↦ (m:ℝ)^ε) hnprod
  have hBprod : (∏ p ∈ n.primeFactors, if p < P then B else 1) ≤ B^P := by
    rw [Finset.prod_ite]
    simp only [Finset.prod_const_one, mul_one, Finset.prod_const]
    apply pow_le_pow_right₀ hB1
    have hs : n.primeFactors.filter (fun p ↦ p < P) ⊆ Finset.range P := by
      intro p hp
      exact Finset.mem_range.mpr (Finset.mem_filter.mp hp).2
    simpa only [Finset.card_range] using Finset.card_le_card hs
  rw [ArithmeticFunction.sigma_zero_apply, Nat.card_divisors hn, Nat.cast_prod]
  calc
    _ ≤ ∏ p ∈ n.primeFactors, (if p < P then B else 1) * ((p:ℝ)^ε)^n.factorization p := by
      apply Finset.prod_le_prod
      · intro p hp; positivity
      · intro p hp
        simpa only [Nat.cast_add, Nat.cast_one] using
          hlocal p (Nat.prime_of_mem_primeFactors hp) (n.factorization p)
    _ = (∏ p ∈ n.primeFactors, if p < P then B else 1) * (n:ℝ)^ε := by
      rw [Finset.prod_mul_distrib, hpow]
    _ ≤ _ := mul_le_mul_of_nonneg_right hBprod (Real.rpow_nonneg (Nat.cast_nonneg n) ε)


lemma polynomial_eval_abs_le_coeff_sum (P : ℝ[X]) (r : ℝ) (hr : 0 ≤ r) :
    |P.eval r| ≤ (∑ i ∈ Finset.range (P.natDegree+1), |P.coeff i|) * (r+1)^P.natDegree := by
  rw [Polynomial.eval_eq_sum_range, Finset.sum_mul]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum ?_)
  intro i hi
  rw [abs_mul, abs_of_nonneg (pow_nonneg hr _)]
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
  calc
    r^i ≤ (r+1)^i := pow_le_pow_left₀ hr (by linarith) i
    _ ≤ _ := pow_le_pow_right₀ (by linarith) (by simpa using Finset.mem_range.mp hi)

lemma floor_int_cast_le_abs (z : ℤ) : (⌊z⌋₊:ℝ) ≤ |(z:ℝ)| := by
  by_cases hz : 0 ≤ z
  · lift z to ℕ using hz
    simp
  · rw [Nat.floor_of_nonpos (le_of_not_ge hz), Nat.cast_zero]
    exact abs_nonneg (z:ℝ)

lemma polynomial_floor_eval_power_bound (f : ℤ[X]) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ n : ℕ,
      (⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ A * (n+1:ℝ)^f.natDegree := by
  let P : ℝ[X] := f.map (Int.castRingHom ℝ)
  let A : ℝ := 1 + ∑ i ∈ Finset.range (P.natDegree+1), |P.coeff i|
  have hA : 1 ≤ A := le_add_of_nonneg_right (Finset.sum_nonneg (fun _ _ ↦ abs_nonneg _))
  have hdeg : P.natDegree = f.natDegree := natDegree_map_eq_of_injective Int.cast_injective f
  have heval : ∀ n : ℕ, P.eval (n:ℝ) = (↑(f.eval (n:ℤ)):ℝ) := by
    intro n
    simpa only [P, eval_map, Int.coe_castRingHom, Int.cast_natCast] using
      (eval₂_at_apply (Int.castRingHom ℝ) (n:ℤ) (p := f))
  refine ⟨A, hA, fun n ↦ ?_⟩
  calc
    _ ≤ |(↑(f.eval (n:ℤ)):ℝ)| := floor_int_cast_le_abs _
    _ = |P.eval (n:ℝ)| := congrArg abs (heval n).symm
    _ ≤ _ := polynomial_eval_abs_le_coeff_sum P n (Nat.cast_nonneg n)
    _ ≤ A * (n+1:ℝ)^f.natDegree := by
      rw [hdeg]
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      dsimp only [A]
      rw [hdeg]
      linarith

lemma sigma_zero_polynomial_subpolynomial_bound (f : ℤ[X]) (ε : ℝ) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ n : ℕ, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ C * (n+1:ℝ)^ε := by
  let δ : ℝ := ε / (f.natDegree+1:ℝ)
  have hδ : 0 < δ := div_pos hε (by positivity)
  have hδε : (f.natDegree:ℝ)*δ ≤ ε := by
    dsimp only [δ]
    rw [← mul_div_assoc, div_le_iff₀ (by positivity : 0 < (f.natDegree:ℝ)+1)]
    nlinarith
  obtain ⟨B, hB0, hB⟩ := sigma_zero_subpolynomial_bound δ hδ
  obtain ⟨A, hA1, hA⟩ := polynomial_floor_eval_power_bound f
  have hA0 : 0 < A := zero_lt_one.trans_le hA1
  refine ⟨B*A^δ, mul_pos hB0 (Real.rpow_pos_of_pos hA0 _), fun n ↦ ?_⟩
  calc
    _ ≤ B * (⌊f.eval (n:ℤ)⌋₊:ℝ)^δ := hB _
    _ ≤ B * (A * (n+1:ℝ)^f.natDegree)^δ :=
      mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) (hA n) hδ.le) hB0.le
    _ = B * A^δ * (n+1:ℝ)^((f.natDegree:ℝ)*δ) := by
      rw [Real.mul_rpow hA0.le (by positivity), ← Real.rpow_natCast_mul (by positivity)]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le (by linarith [Nat.cast_nonneg (α := ℝ) n]) hδε)
      (by positivity)


lemma erdos975Sum_subpower_nat_bound (f : ℤ[X]) (ε : ℝ) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ N : ℕ, Erdos975Sum f N ≤ C * (N+1:ℝ)^(1+ε) := by
  obtain ⟨C, hC, hbound⟩ := sigma_zero_polynomial_subpolynomial_bound f ε hε
  refine ⟨C, hC, fun N ↦ ?_⟩
  rw [Erdos975Sum, Nat.floor_natCast]
  calc
    _ ≤ ∑ _n ∈ Finset.Iic N, C * (N+1:ℝ)^ε := by
      apply Finset.sum_le_sum
      intro n hn
      refine (hbound n).trans (mul_le_mul_of_nonneg_left ?_ hC.le)
      apply Real.rpow_le_rpow (by positivity) _ hε.le
      exact_mod_cast Nat.add_le_add_right (Finset.mem_Iic.mp hn) 1
    _ = C * (N+1:ℝ)^(1+ε) := by
      rw [Real.rpow_add (by positivity), Real.rpow_one]
      simp only [Finset.sum_const, Nat.card_Iic, nsmul_eq_mul, Nat.cast_add, Nat.cast_one]
      ring

lemma erdos975Sum_subpower_bound (f : ℤ[X]) (ε : ℝ) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ x : ℝ, 1 ≤ x → Erdos975Sum f x ≤ C * x^(1+ε) := by
  obtain ⟨C, hC, hbound⟩ := erdos975Sum_subpower_nat_bound f ε hε
  refine ⟨C * (2:ℝ)^(1+ε), mul_pos hC (by positivity), fun x hx ↦ ?_⟩
  have hx0 : 0 ≤ x := zero_le_one.trans hx
  have hf : (⌊x⌋₊:ℝ)+1 ≤ 2*x := by linarith [Nat.floor_le hx0]
  have hs : Erdos975Sum f (⌊x⌋₊:ℝ) = Erdos975Sum f x := by
    simp only [Erdos975Sum, Nat.floor_natCast]
  calc
    Erdos975Sum f x ≤ C * (⌊x⌋₊+1:ℝ)^(1+ε) := hs ▸ hbound ⌊x⌋₊
    _ ≤ C * (2*x)^(1+ε) := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow (by positivity) hf (by linarith)) hC.le
    _ = _ := by rw [Real.mul_rpow (by norm_num) hx0]; ring

lemma erdos975Sum_nonneg (f : ℤ[X]) (x : ℝ) : 0 ≤ Erdos975Sum f x :=
  Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)

lemma erdos975Sum_div_rpow_tendsto_zero (f : ℤ[X]) (ε : ℝ) (hε : 0 < ε) :
    Tendsto (fun x : ℝ ↦ Erdos975Sum f x / x^(1+ε)) atTop (𝓝 0) := by
  obtain ⟨C, hC, hbound⟩ := erdos975Sum_subpower_bound f (ε/2) (by linarith)
  have ht := (tendsto_rpow_neg_atTop (show 0 < ε/2 by linarith)).const_mul C
  rw [mul_zero] at ht
  apply squeeze_zero' _ _ ht
  · filter_upwards [eventually_ge_atTop (1:ℝ)] with x hx
    exact div_nonneg (erdos975Sum_nonneg f x) (Real.rpow_nonneg (by linarith) _)
  · filter_upwards [eventually_ge_atTop (1:ℝ)] with x hx
    have hx0 : 0 < x := zero_lt_one.trans_le hx
    calc
      _ ≤ C * x^(1+ε/2) / x^(1+ε) := div_le_div_of_nonneg_right
        (hbound x hx) (Real.rpow_nonneg hx0.le _)
      _ = C * x^(-(ε/2)) := by
        rw [mul_div_assoc, ← Real.rpow_sub hx0]
        congr 2
        ring

lemma erdos975Sum_eventually_ge_self (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∀ᶠ x : ℝ in atTop, x ≤ Erdos975Sum f x := by
  obtain ⟨c, hc, h⟩ := erdos975_eventual_positive_lower_bound f hdeg hirr hpos
  have hlog := (Real.tendsto_log_atTop.const_mul_atTop hc).eventually_ge_atTop 1
  filter_upwards [h, hlog, eventually_ge_atTop (0:ℝ)] with x hx hxlog hx0
  have hmul := mul_le_mul_of_nonneg_left hxlog hx0
  nlinarith

lemma erdos975Sum_log_growth (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    Tendsto (fun x : ℝ ↦ log (Erdos975Sum f x) / log x) atTop (𝓝 1) := by
  have hlower := erdos975Sum_eventually_ge_self f hdeg hirr hpos
  apply tendsto_order.mpr
  constructor
  · intro a ha
    filter_upwards [hlower, eventually_gt_atTop (1:ℝ)] with x hx hx1
    have hx0 : 0 < x := zero_lt_one.trans hx1
    have hlog : log x ≤ log (Erdos975Sum f x) := Real.log_le_log hx0 hx
    have hratio : 1 ≤ log (Erdos975Sum f x) / log x :=
      (le_div_iff₀ (Real.log_pos hx1)).mpr (by simpa only [one_mul] using hlog)
    exact ha.trans_le hratio
  · intro a ha
    let ε : ℝ := (a-1)/2
    have hε : 0 < ε := by dsimp [ε]; linarith
    have hupper := (erdos975Sum_div_rpow_tendsto_zero f ε hε).eventually_lt_const
      (show (0:ℝ) < 1 by norm_num)
    filter_upwards [hlower, hupper, eventually_gt_atTop (1:ℝ)] with x hx hxupper hx1
    have hx0 : 0 < x := zero_lt_one.trans hx1
    have hS0 : 0 < Erdos975Sum f x := hx0.trans_le hx
    have hS : Erdos975Sum f x ≤ x^(1+ε) := by
      simpa only [one_mul] using
        (div_le_iff₀ (Real.rpow_pos_of_pos hx0 _)).mp hxupper.le
    have hlog := Real.log_le_log hS0 hS
    rw [Real.log_rpow hx0] at hlog
    have hratio : log (Erdos975Sum f x) / log x ≤ 1+ε :=
      (div_le_iff₀ (Real.log_pos hx1)).mpr hlog
    exact hratio.trans_lt (by dsimp [ε]; linarith)


lemma int_nat_lcm_dvd_iff (d e : ℕ) (z : ℤ) :
    ((d.lcm e : ℕ) : ℤ) ∣ z ↔ (d:ℤ) ∣ z ∧ (e:ℤ) ∣ z := by
  rw [← Int.dvd_natAbs, Int.natCast_dvd_natCast, Nat.lcm_dvd_iff,
    ← Int.natCast_dvd_natCast, ← Int.natCast_dvd_natCast, Int.dvd_natAbs, Int.dvd_natAbs]

noncomputable def polynomialSieveWeight (f : ℤ[X]) (D : ℕ) (w : ℕ → ℝ) (n : ℕ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D, if (d:ℤ) ∣ f.eval (n:ℤ) then w d else 0

noncomputable def polynomialSieveQuadratic (f : ℤ[X]) (D : ℕ) (w : ℕ → ℝ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D,
    w d * w e * (polynomialRootResidues f (d.lcm e)).card / (d.lcm e)

noncomputable def polynomialSieveError (f : ℤ[X]) (D : ℕ) (w : ℕ → ℝ) : ℝ :=
  ∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D,
    |w d * w e| * (polynomialRootResidues f (d.lcm e)).card

lemma polynomialSieveWeight_square (f : ℤ[X]) (D n : ℕ) (w : ℕ → ℝ) :
    polynomialSieveWeight f D w n ^ 2 =
      ∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D,
        if ((d.lcm e:ℕ):ℤ) ∣ f.eval (n:ℤ) then w d * w e else 0 := by
  rw [polynomialSieveWeight, pow_two, Finset.sum_mul_sum]
  apply Finset.sum_congr rfl
  intro d hd
  apply Finset.sum_congr rfl
  intro e he
  simp only [int_nat_lcm_dvd_iff]
  split_ifs <;> simp_all

lemma polynomialSieveWeight_second_moment (f : ℤ[X]) (D N : ℕ) (w : ℕ → ℝ) :
    (∑ n ∈ Finset.range N, polynomialSieveWeight f D w n ^ 2) =
      ∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D,
        w d * w e * (((Finset.range N).filter
          (fun n : ℕ ↦ ((d.lcm e:ℕ):ℤ) ∣ f.eval (n:ℤ))).card : ℝ) := by
  simp_rw [polynomialSieveWeight_square]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro d hd
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e he
  rw [← Finset.sum_filter, Finset.sum_const]
  simp only [nsmul_eq_mul]
  ring

lemma polynomialSieveWeight_second_moment_error (f : ℤ[X]) (D N : ℕ) (w : ℕ → ℝ) :
    |(∑ n ∈ Finset.range N, polynomialSieveWeight f D w n ^ 2) -
      (N:ℝ) * polynomialSieveQuadratic f D w| ≤ polynomialSieveError f D w := by
  rw [polynomialSieveWeight_second_moment]
  unfold polynomialSieveQuadratic polynomialSieveError
  simp_rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro d hd
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro e he
  have hde : 0 < d.lcm e := Nat.lcm_pos (Finset.mem_Icc.mp hd).1 (Finset.mem_Icc.mp he).1
  have he := polynomial_root_count_error f (d.lcm e) N hde
  calc
    _ = |w d * w e| * |(((Finset.range N).filter
        (fun n : ℕ ↦ ((d.lcm e:ℕ):ℤ) ∣ f.eval (n:ℤ))).card : ℝ) -
          (N:ℝ) / (d.lcm e) * (polynomialRootResidues f (d.lcm e)).card| := by
      rw [← abs_mul]
      congr 1
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left he (abs_nonneg _)

lemma polynomialSieveWeight_eq_one_of_rough (f : ℤ[X]) (D n : ℕ) (w : ℕ → ℝ)
    (s : Finset ℕ) (hD : 1 ≤ D) (hw1 : w 1 = 1)
    (hw : ∀ d ∈ Finset.Icc 1 D, w d ≠ 0 → d.primeFactors ⊆ s)
    (hrough : ∀ p ∈ s, ¬(p:ℤ) ∣ f.eval (n:ℤ)) :
    polynomialSieveWeight f D w n = 1 := by
  unfold polynomialSieveWeight
  rw [Finset.sum_eq_single 1]
  · simp [hw1]
  · intro d hd hd1
    by_cases hwd : w d = 0
    · simp [hwd]
    · obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd hd1
      have hd0 : d ≠ 0 := by have := (Finset.mem_Icc.mp hd).1; omega
      have hps := hw d hd hwd (Nat.mem_primeFactors.mpr ⟨hp, hpd, hd0⟩)
      have hdf : ¬(d:ℤ) ∣ f.eval (n:ℤ) := by
        intro h
        exact hrough p hps ((Int.natCast_dvd_natCast.mpr hpd).trans h)
      exact if_neg hdf
  · intro hnot
    exact (hnot (Finset.mem_Icc.mpr ⟨le_rfl, hD⟩)).elim

lemma polynomial_rough_count_le_sieve (f : ℤ[X]) (D N : ℕ) (w : ℕ → ℝ)
    (s : Finset ℕ) (hD : 1 ≤ D) (hw1 : w 1 = 1)
    (hw : ∀ d ∈ Finset.Icc 1 D, w d ≠ 0 → d.primeFactors ⊆ s) :
    (((Finset.range N).filter
      (fun n : ℕ ↦ ∀ p ∈ s, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        (N:ℝ) * polynomialSieveQuadratic f D w + polynomialSieveError f D w := by
  have hcount : (((Finset.range N).filter
      (fun n : ℕ ↦ ∀ p ∈ s, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        ∑ n ∈ Finset.range N, polynomialSieveWeight f D w n ^ 2 := by
    rw [Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
    apply Finset.sum_le_sum
    intro n hn
    split_ifs with hrough
    · rw [polynomialSieveWeight_eq_one_of_rough f D n w s hD hw1 hw hrough]
      norm_num
    · exact sq_nonneg _
  have herr := le_abs_self _ |>.trans (polynomialSieveWeight_second_moment_error f D N w)
  linarith


open scoped ArithmeticFunction

noncomputable def arithmeticReciprocal (u : ArithmeticFunction ℝ) : ArithmeticFunction ℝ where
  toFun n := (u n)⁻¹
  map_zero' := by simp

lemma arithmeticReciprocal_multiplicative (u : ArithmeticFunction ℝ)
    (hu : u.IsMultiplicative) : (arithmeticReciprocal u).IsMultiplicative := by
  constructor
  · change (u 1)⁻¹ = 1
    rw [hu.map_one, inv_one]
  · intro m n hmn
    change (u (m*n))⁻¹ = (u m)⁻¹ * (u n)⁻¹
    rw [hu.map_mul_of_coprime hmn, mul_inv_rev, mul_comm]

noncomputable def selbergDiagonal (ν : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  arithmeticReciprocal ν * (μ : ArithmeticFunction ℝ)

lemma selbergDiagonal_multiplicative (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative) :
    (selbergDiagonal ν).IsMultiplicative :=
  (arithmeticReciprocal_multiplicative ν hν).mul ArithmeticFunction.isMultiplicative_moebius.intCast

lemma selbergDiagonal_sum_divisors (ν : ArithmeticFunction ℝ) (n : ℕ) :
    (∑ d ∈ n.divisors, selbergDiagonal ν d) = (ν n)⁻¹ := by
  rw [← ArithmeticFunction.coe_mul_zeta_apply, selbergDiagonal, mul_assoc,
    ArithmeticFunction.coe_moebius_mul_coe_zeta, mul_one]
  rfl

lemma selbergDiagonal_apply_prime (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (p : ℕ) (hp : p.Prime) : selbergDiagonal ν p = (ν p)⁻¹ - 1 := by
  have he := convolution_prime_pow (arithmeticReciprocal ν) (μ : ArithmeticFunction ℝ) p 1 hp
  simpa [selbergDiagonal, arithmeticReciprocal, Finset.sum_range_succ, hν.map_one,
    ArithmeticFunction.moebius_apply_prime hp, sub_eq_add_neg, add_comm] using he

lemma multiplicative_pos_of_squarefree_divisor (ν : ArithmeticFunction ℝ)
    (hν : ν.IsMultiplicative) (P : ℕ) (hP : Squarefree P)
    (hpos : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p)
    (d : ℕ) (hd : d ∣ P) : 0 < ν d := by
  rw [← hν.prod_primeFactors (Squarefree.squarefree_of_dvd hd hP)]
  exact Finset.prod_pos (fun p hp ↦ hpos p (Nat.prime_of_mem_primeFactors hp)
    ((Nat.dvd_of_mem_primeFactors hp).trans hd))

lemma selbergDiagonal_pos (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (d : ℕ) (hd : d ∣ P) : 0 < selbergDiagonal ν d := by
  apply multiplicative_pos_of_squarefree_divisor _ (selbergDiagonal_multiplicative ν hν) P hP _ d hd
  intro p hp hpd
  rw [selbergDiagonal_apply_prime ν hν p hp]
  exact sub_pos.mpr ((one_lt_inv₀ (hνprime p hp hpd).1).mpr (hνprime p hp hpd).2)

lemma selberg_lcm_kernel (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνpos : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p)
    (d e : ℕ) (hd : d ∣ P) (he : e ∣ P) :
    ν (d.lcm e) = ν d * ν e *
      (∑ r ∈ P.divisors, if r ∣ d ∧ r ∣ e then selbergDiagonal ν r else 0) := by
  have hg : d.gcd e ∣ P := (Nat.gcd_dvd_left d e).trans hd
  have hνg := (multiplicative_pos_of_squarefree_divisor ν hν P hP hνpos _ hg).ne'
  have hsum : (∑ r ∈ P.divisors, if r ∣ d ∧ r ∣ e then selbergDiagonal ν r else 0) =
      (ν (d.gcd e))⁻¹ := by
    simp_rw [← Nat.dvd_gcd_iff]
    rw [← Finset.sum_filter, Nat.divisors_filter_dvd_of_dvd hP.ne_zero hg,
      selbergDiagonal_sum_divisors]
  rw [hsum, hν.map_lcm hνg]
  ring

lemma selberg_quadratic_diagonalization (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνpos : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p) (w : ℕ → ℝ) :
    (∑ d ∈ P.divisors, ∑ e ∈ P.divisors, w d * w e * ν (d.lcm e)) =
      ∑ r ∈ P.divisors, selbergDiagonal ν r *
        (∑ d ∈ P.divisors, if r ∣ d then w d * ν d else 0)^2 := by
  let F : ℕ → ℕ → ℕ → ℝ := fun r d e ↦ selbergDiagonal ν r *
    (if r ∣ d then w d * ν d else 0) * (if r ∣ e then w e * ν e else 0)
  calc
    _ = ∑ d ∈ P.divisors, ∑ e ∈ P.divisors, ∑ r ∈ P.divisors, F r d e := by
      apply Finset.sum_congr rfl
      intro d hd
      apply Finset.sum_congr rfl
      intro e he
      rw [selberg_lcm_kernel ν hν P hP hνpos d e
        (Nat.dvd_of_mem_divisors hd) (Nat.dvd_of_mem_divisors he), ← mul_assoc, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro r hr
      dsimp only [F]
      split_ifs <;> simp_all <;> ring
    _ = ∑ d ∈ P.divisors, ∑ r ∈ P.divisors, ∑ e ∈ P.divisors, F r d e :=
      Finset.sum_congr rfl (fun d _ ↦ Finset.sum_comm)
    _ = ∑ r ∈ P.divisors, ∑ d ∈ P.divisors, ∑ e ∈ P.divisors, F r d e := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro r hr
      rw [pow_two, Finset.sum_mul_sum]
      simp_rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro d hd
      apply Finset.sum_congr rfl
      intro e he
      dsimp only [F]
      ring


lemma sum_moebius_divisors_real (n : ℕ) :
    (∑ d ∈ n.divisors, (μ d:ℝ)) = if n = 1 then 1 else 0 := by
  have he := congrArg (fun u : ArithmeticFunction ℝ ↦ u n)
    (ArithmeticFunction.coe_moebius_mul_coe_zeta (R := ℝ))
  simpa only [ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.intCoe_apply,
    ArithmeticFunction.one_apply] using he

lemma sum_divisors_multiple (r q : ℕ) (hr : r ≠ 0) (hq : q ∣ r) (F : ℕ → ℝ) :
    (∑ d ∈ r.divisors with q ∣ d, F d) = ∑ t ∈ (r/q).divisors, F (q*t) := by
  have hq0 : 0 < q := Nat.pos_of_dvd_of_pos hq (Nat.pos_of_ne_zero hr)
  have hdiv0 : r/q ≠ 0 := (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hr) hq) hq0).ne'
  symm
  apply Finset.sum_nbij (fun t ↦ q*t)
  · intro t ht
    refine Finset.mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨?_, hr⟩, dvd_mul_right _ _⟩
    exact (Nat.dvd_div_iff_mul_dvd hq).mp (Nat.dvd_of_mem_divisors ht)
  · intro t ht u hu he
    exact Nat.eq_of_mul_eq_mul_left hq0 he
  · intro d hd
    change d ∈ r.divisors.filter (fun d ↦ q ∣ d) at hd
    obtain ⟨hd, hqd⟩ := Finset.mem_filter.mp hd
    refine ⟨d/q, Nat.mem_divisors.mpr ⟨?_, hdiv0⟩, Nat.mul_div_cancel' hqd⟩
    exact Nat.div_dvd_div hqd (Nat.dvd_of_mem_divisors hd)
  · intro t ht; rfl

lemma sum_moebius_over_multiples (r q : ℕ) (hr : Squarefree r) :
    (∑ d ∈ r.divisors, if q ∣ d then (μ d:ℝ) else 0) =
      if q = r then (μ q:ℝ) else 0 := by
  by_cases hqr : q ∣ r
  · rw [← Finset.sum_filter, sum_divisors_multiple r q hr.ne_zero hqr]
    have hm : ∀ t ∈ (r/q).divisors, (μ (q*t):ℝ) = (μ q:ℝ) * (μ t:ℝ) := by
      intro t ht
      have hqt : q*t ∣ r := (Nat.dvd_div_iff_mul_dvd hqr).mp (Nat.dvd_of_mem_divisors ht)
      have hc := Nat.coprime_of_squarefree_mul (Squarefree.squarefree_of_dvd hqt hr)
      exact_mod_cast ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hc
    simp_rw [Finset.sum_congr rfl hm, ← Finset.mul_sum, sum_moebius_divisors_real]
    by_cases he : q = r
    · subst q
      simp [Nat.div_self (Nat.pos_of_ne_zero hr.ne_zero)]
    · have hqdiv : r/q ≠ 1 := by
        intro h
        have hm := Nat.mul_div_cancel' hqr
        rw [h, mul_one] at hm
        exact he hm
      simp [he, hqdiv]
  · have he : q ≠ r := by rintro rfl; exact hqr (dvd_refl _)
    rw [if_neg he]
    apply Finset.sum_eq_zero
    intro d hd
    exact if_neg (fun h ↦ hqr (h.trans (Nat.dvd_of_mem_divisors hd)))

lemma selberg_upper_mobius_transform (P : ℕ) (hP : Squarefree P) (b : ℕ → ℝ)
    (q : ℕ) (hq : q ∣ P) :
    (∑ d ∈ P.divisors, if q ∣ d then
      (μ d:ℝ) * (∑ r ∈ P.divisors, if d ∣ r then b r else 0) else 0) =
      (μ q:ℝ) * b q := by
  have hqmem : q ∈ P.divisors := Nat.mem_divisors.mpr ⟨hq, hP.ne_zero⟩
  calc
    _ = ∑ d ∈ P.divisors, ∑ r ∈ P.divisors,
        b r * (if q ∣ d ∧ d ∣ r then (μ d:ℝ) else 0) := by
      apply Finset.sum_congr rfl
      intro d hd
      by_cases hqd : q ∣ d
      · simp only [hqd, true_and, if_true, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro r hr
        by_cases hdr : d ∣ r <;> simp [hdr, mul_comm]
      · simp [hqd]
    _ = ∑ r ∈ P.divisors, b r *
        (∑ d ∈ P.divisors, if q ∣ d ∧ d ∣ r then (μ d:ℝ) else 0) := by
      rw [Finset.sum_comm]
      simp only [Finset.mul_sum]
    _ = ∑ r ∈ P.divisors, b r * (if q = r then (μ q:ℝ) else 0) := by
      apply Finset.sum_congr rfl
      intro r hr
      congr 1
      have hf : (∑ d ∈ P.divisors, if q ∣ d ∧ d ∣ r then (μ d:ℝ) else 0) =
          ∑ d ∈ P.divisors with d ∣ r, if q ∣ d then (μ d:ℝ) else 0 := by
        rw [Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro d hd
        split_ifs <;> simp_all
      rw [hf, Nat.divisors_filter_dvd_of_dvd hP.ne_zero (Nat.dvd_of_mem_divisors hr),
        sum_moebius_over_multiples r q (Squarefree.squarefree_of_dvd
          (Nat.dvd_of_mem_divisors hr) hP)]
    _ = _ := by
      simp only [mul_ite, mul_zero]
      rw [Finset.sum_ite_eq P.divisors q, if_pos hqmem]
      ring


noncomputable def selbergCutoff (ν : ArithmeticFunction ℝ) (D n : ℕ) : ℝ :=
  if n ≤ D then (selbergDiagonal ν n)⁻¹ else 0

noncomputable def selbergDenominator (ν : ArithmeticFunction ℝ) (P D : ℕ) : ℝ :=
  ∑ r ∈ P.divisors, selbergCutoff ν D r

noncomputable def selbergOptimalWeight (ν : ArithmeticFunction ℝ) (P D d : ℕ) : ℝ :=
  (μ d:ℝ) / (ν d * selbergDenominator ν P D) *
    (∑ r ∈ P.divisors, if d ∣ r then selbergCutoff ν D r else 0)

lemma selbergCutoff_nonneg (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D r : ℕ) (hr : r ∣ P) : 0 ≤ selbergCutoff ν D r := by
  unfold selbergCutoff
  split_ifs
  · exact inv_nonneg.mpr (selbergDiagonal_pos ν hν P hP hνprime r hr).le
  · exact le_rfl

lemma selbergDenominator_ge_one (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D : ℕ) (hD : 1 ≤ D) : 1 ≤ selbergDenominator ν P D := by
  have hb : selbergCutoff ν D 1 = 1 := by
    simp [selbergCutoff, hD, (selbergDiagonal_multiplicative ν hν).map_one]
  rw [← hb]
  exact Finset.single_le_sum (fun r hr ↦ selbergCutoff_nonneg ν hν P hP hνprime D r
    (Nat.dvd_of_mem_divisors hr)) (Nat.one_mem_divisors.mpr hP.ne_zero)

lemma selbergOptimalWeight_one (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D : ℕ) (hD : 1 ≤ D) : selbergOptimalWeight ν P D 1 = 1 := by
  have hG : selbergDenominator ν P D ≠ 0 :=
    (zero_lt_one.trans_le (selbergDenominator_ge_one ν hν P hP hνprime D hD)).ne'
  unfold selbergOptimalWeight
  simp only [ArithmeticFunction.moebius_apply_one, Int.cast_one, hν.map_one, one_mul,
    one_dvd, ite_true]
  change 1 / selbergDenominator ν P D * selbergDenominator ν P D = 1
  field_simp

lemma selbergOptimalWeight_eq_zero_of_not_dvd (ν : ArithmeticFunction ℝ) (P D d : ℕ)
    (hd : ¬d ∣ P) : selbergOptimalWeight ν P D d = 0 := by
  unfold selbergOptimalWeight
  suffices (∑ r ∈ P.divisors, if d ∣ r then selbergCutoff ν D r else 0) = 0 by rw [this, mul_zero]
  apply Finset.sum_eq_zero
  intro r hr
  exact if_neg (fun h ↦ hd (h.trans (Nat.dvd_of_mem_divisors hr)))

lemma selbergOptimalWeight_eq_zero_of_gt (ν : ArithmeticFunction ℝ) (P D d : ℕ)
    (hd : D < d) : selbergOptimalWeight ν P D d = 0 := by
  unfold selbergOptimalWeight
  suffices (∑ r ∈ P.divisors, if d ∣ r then selbergCutoff ν D r else 0) = 0 by rw [this, mul_zero]
  apply Finset.sum_eq_zero
  intro r hr
  by_cases hdr : d ∣ r
  · have hdrle : d ≤ r := Nat.le_of_dvd (Nat.pos_of_mem_divisors hr) hdr
    simp [hdr, selbergCutoff, show ¬r ≤ D by omega]
  · exact if_neg hdr

lemma selbergOptimalWeight_upper_transform (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D : ℕ) (hD : 1 ≤ D) (q : ℕ) (hq : q ∣ P) :
    (∑ d ∈ P.divisors, if q ∣ d then selbergOptimalWeight ν P D d * ν d else 0) =
      (μ q:ℝ) * selbergCutoff ν D q / selbergDenominator ν P D := by
  have hG : selbergDenominator ν P D ≠ 0 :=
    (zero_lt_one.trans_le (selbergDenominator_ge_one ν hν P hP hνprime D hD)).ne'
  calc
    _ = (∑ d ∈ P.divisors, if q ∣ d then (μ d:ℝ) *
        (∑ r ∈ P.divisors, if d ∣ r then selbergCutoff ν D r else 0) else 0) /
          selbergDenominator ν P D := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro d hd
      have hνd : ν d ≠ 0 := (multiplicative_pos_of_squarefree_divisor ν hν P hP
        (fun p hp hpP ↦ (hνprime p hp hpP).1) d (Nat.dvd_of_mem_divisors hd)).ne'
      split_ifs
      · unfold selbergOptimalWeight
        field_simp
      · simp
    _ = _ := by rw [selberg_upper_mobius_transform P hP _ q hq]

lemma selbergOptimalWeight_abs_le (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D : ℕ) (hD : 1 ≤ D) (d : ℕ) (hd : d ∣ P) :
    |selbergOptimalWeight ν P D d| ≤ (ν d)⁻¹ := by
  have hG : 0 < selbergDenominator ν P D :=
    zero_lt_one.trans_le (selbergDenominator_ge_one ν hν P hP hνprime D hD)
  have hνd := multiplicative_pos_of_squarefree_divisor ν hν P hP
    (fun p hp hpP ↦ (hνprime p hp hpP).1) d hd
  have hμ : |(μ d:ℝ)| = 1 := by
    exact_mod_cast ArithmeticFunction.abs_moebius_eq_one_of_squarefree
      (Squarefree.squarefree_of_dvd hd hP)
  have hsum0 : 0 ≤ ∑ r ∈ P.divisors, if d ∣ r then selbergCutoff ν D r else 0 := by
    apply Finset.sum_nonneg
    intro r hr
    split_ifs
    · exact selbergCutoff_nonneg ν hν P hP hνprime D r (Nat.dvd_of_mem_divisors hr)
    · exact le_rfl
  have hsumle : (∑ r ∈ P.divisors, if d ∣ r then selbergCutoff ν D r else 0) ≤
      selbergDenominator ν P D := by
    apply Finset.sum_le_sum
    intro r hr
    split_ifs
    · exact le_rfl
    · exact selbergCutoff_nonneg ν hν P hP hνprime D r (Nat.dvd_of_mem_divisors hr)
  unfold selbergOptimalWeight
  rw [abs_mul, abs_div, hμ, abs_of_pos (mul_pos hνd hG), abs_of_nonneg hsum0]
  calc
    _ ≤ 1 / (ν d * selbergDenominator ν P D) * selbergDenominator ν P D :=
      mul_le_mul_of_nonneg_left hsumle (by positivity)
    _ = _ := by field_simp

lemma selbergOptimalWeight_quadratic (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D : ℕ) (hD : 1 ≤ D) :
    (∑ d ∈ P.divisors, ∑ e ∈ P.divisors,
      selbergOptimalWeight ν P D d * selbergOptimalWeight ν P D e * ν (d.lcm e)) =
        1 / selbergDenominator ν P D := by
  have hG : selbergDenominator ν P D ≠ 0 :=
    (zero_lt_one.trans_le (selbergDenominator_ge_one ν hν P hP hνprime D hD)).ne'
  rw [selberg_quadratic_diagonalization ν hν P hP
    (fun p hp hpP ↦ (hνprime p hp hpP).1)]
  calc
    _ = ∑ r ∈ P.divisors, selbergCutoff ν D r / selbergDenominator ν P D ^ 2 := by
      apply Finset.sum_congr rfl
      intro r hr
      have hrP := Nat.dvd_of_mem_divisors hr
      have hhr := (selbergDiagonal_pos ν hν P hP hνprime r hrP).ne'
      have hμ : (μ r:ℝ)^2 = 1 := by
        exact_mod_cast ArithmeticFunction.moebius_sq_eq_one_of_squarefree
          (Squarefree.squarefree_of_dvd hrP hP)
      rw [selbergOptimalWeight_upper_transform ν hν P hP hνprime D hD r hrP,
        div_pow, mul_pow, hμ, one_mul]
      unfold selbergCutoff
      split_ifs
      · field_simp
      · simp
    _ = selbergDenominator ν P D / selbergDenominator ν P D ^ 2 := by
      rw [← Finset.sum_div]
      rfl
    _ = _ := by field_simp


lemma selberg_sum_interval_eq_divisors (ν : ArithmeticFunction ℝ) (P D : ℕ) (hP : P ≠ 0)
    (F : ℕ → ℝ) (hF : ∀ d : ℕ, selbergOptimalWeight ν P D d = 0 → F d = 0) :
    (∑ d ∈ Finset.Icc 1 D, F d) = ∑ d ∈ P.divisors, F d := by
  apply Finset.sum_congr_of_eq_on_inter
  · intro d hd hnot
    apply hF
    apply selbergOptimalWeight_eq_zero_of_not_dvd
    intro hdP
    exact hnot (Nat.mem_divisors.mpr ⟨hdP, hP⟩)
  · intro d hd hnot
    apply hF
    apply selbergOptimalWeight_eq_zero_of_gt
    have hdpos := Nat.pos_of_mem_divisors hd
    simp only [Finset.mem_Icc] at hnot
    omega
  · intro d hd he; rfl

lemma selbergOptimalWeight_interval_quadratic (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (D : ℕ) (hD : 1 ≤ D) :
    (∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D,
      selbergOptimalWeight ν P D d * selbergOptimalWeight ν P D e * ν (d.lcm e)) =
        1 / selbergDenominator ν P D := by
  rw [selberg_sum_interval_eq_divisors ν P D hP.ne_zero _ (by
    intro d hd; simp only [hd, zero_mul, Finset.sum_const_zero])]
  have he : ∀ d : ℕ, (∑ e ∈ Finset.Icc 1 D,
      selbergOptimalWeight ν P D d * selbergOptimalWeight ν P D e * ν (d.lcm e)) =
      ∑ e ∈ P.divisors,
        selbergOptimalWeight ν P D d * selbergOptimalWeight ν P D e * ν (d.lcm e) := by
    intro d
    apply selberg_sum_interval_eq_divisors ν P D hP.ne_zero
    intro e he
    simp only [he, mul_zero, zero_mul]
  simp_rw [he]
  exact selbergOptimalWeight_quadratic ν hν P hP hνprime D hD

noncomputable def polynomialRootDensity (f : ℤ[X]) : ArithmeticFunction ℝ where
  toFun n := (polynomialRootCount f n:ℝ) / n
  map_zero' := by simp

lemma polynomialRootDensity_apply (f : ℤ[X]) (n : ℕ) :
    polynomialRootDensity f n = (polynomialRootResidues f n).card / (n:ℝ) := rfl

lemma polynomialRootDensity_multiplicative (f : ℤ[X]) :
    (polynomialRootDensity f).IsMultiplicative := by
  constructor
  · simp only [polynomialRootDensity, ArithmeticFunction.coe_mk,
      (polynomialRootCount_multiplicative f).map_one, Nat.cast_one, div_one]
  · intro m n hmn
    change (polynomialRootCount f (m*n):ℝ) / (m*n:ℕ) =
      (polynomialRootCount f m:ℝ) / m * ((polynomialRootCount f n:ℝ) / n)
    rw [(polynomialRootCount_multiplicative f).map_mul_of_coprime hmn, Nat.cast_mul,
      Nat.cast_mul, div_mul_div_comm]

lemma rootCount_pos_of_density_pos (f : ℤ[X]) (n : ℕ) (h : 0 < polynomialRootDensity f n) :
    1 ≤ polynomialRootCount f n := by
  by_contra hn
  have hz : polynomialRootCount f n = 0 := by omega
  change 0 < (polynomialRootCount f n:ℝ) / n at h
  simp [hz] at h

lemma polynomialSieveQuadratic_selberg (f : ℤ[X]) (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P →
      0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1)
    (D : ℕ) (hD : 1 ≤ D) :
    polynomialSieveQuadratic f D (selbergOptimalWeight (polynomialRootDensity f) P D) =
      1 / selbergDenominator (polynomialRootDensity f) P D := by
  rw [← selbergOptimalWeight_interval_quadratic _ (polynomialRootDensity_multiplicative f)
    P hP hνprime D hD]
  unfold polynomialSieveQuadratic
  apply Finset.sum_congr rfl
  intro d hd
  apply Finset.sum_congr rfl
  intro e he
  rw [polynomialRootDensity_apply]
  ring

lemma polynomialSieveError_selberg (f : ℤ[X]) (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P →
      0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1)
    (D : ℕ) (hD : 1 ≤ D) :
    polynomialSieveError f D (selbergOptimalWeight (polynomialRootDensity f) P D) ≤ (D:ℝ)^4 := by
  let ν := polynomialRootDensity f
  let w := selbergOptimalWeight ν P D
  have hν := polynomialRootDensity_multiplicative f
  have hw : ∀ d : ℕ, w d ≠ 0 → d ∣ P := by
    intro d hd
    by_contra hnot
    exact hd (selbergOptimalWeight_eq_zero_of_not_dvd ν P D d hnot)
  have hb : ∀ d ∈ Finset.Icc 1 D, ∀ e ∈ Finset.Icc 1 D,
      |w d * w e| * (polynomialRootResidues f (d.lcm e)).card ≤ (D:ℝ)^2 := by
    intro d hd e he
    by_cases hd0 : w d = 0
    · simp only [hd0, zero_mul, abs_zero]
      positivity
    by_cases he0 : w e = 0
    · simp only [he0, mul_zero, abs_zero, zero_mul]
      positivity
    have hdP := hw d hd0
    have heP := hw e he0
    have hgP : d.gcd e ∣ P := (Nat.gcd_dvd_left d e).trans hdP
    have hpos : ∀ r : ℕ, r ∣ P → 0 < ν r := fun r hr ↦
      multiplicative_pos_of_squarefree_divisor ν hν P hP
        (fun p hp hpP ↦ (hνprime p hp hpP).1) r hr
    have hrd : (polynomialRootCount f d:ℝ) ≠ 0 := by
      exact_mod_cast (show polynomialRootCount f d ≠ 0 from by
        have := rootCount_pos_of_density_pos f d (hpos d hdP); omega)
    have hre : (polynomialRootCount f e:ℝ) ≠ 0 := by
      exact_mod_cast (show polynomialRootCount f e ≠ 0 from by
        have := rootCount_pos_of_density_pos f e (hpos e heP); omega)
    have hrg1 : (1:ℝ) ≤ polynomialRootCount f (d.gcd e) := by
      exact_mod_cast rootCount_pos_of_density_pos f (d.gcd e) (hpos (d.gcd e) hgP)
    have hrg : (polynomialRootCount f (d.gcd e):ℝ) ≠ 0 := (zero_lt_one.trans_le hrg1).ne'
    have hroot : (polynomialRootCount f (d.lcm e):ℝ) * polynomialRootCount f (d.gcd e) =
        (polynomialRootCount f d:ℝ) * polynomialRootCount f e := by
      exact_mod_cast (polynomialRootCount_multiplicative f).lcm_apply_mul_gcd_apply (x := d) (y := e)
    have habs : |w d| * |w e| ≤ (ν d)⁻¹ * (ν e)⁻¹ :=
      mul_le_mul (selbergOptimalWeight_abs_le ν hν P hP hνprime D hD d hdP)
        (selbergOptimalWeight_abs_le ν hν P hP hνprime D hD e heP)
        (abs_nonneg _) (inv_nonneg.mpr (hpos d hdP).le)
    calc
      _ ≤ (ν d)⁻¹ * (ν e)⁻¹ * (polynomialRootCount f (d.lcm e):ℝ) := by
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_right habs (Nat.cast_nonneg _)
      _ = (d:ℝ) * e / (polynomialRootCount f (d.gcd e):ℝ) := by
        change ((polynomialRootCount f d:ℝ) / d)⁻¹ *
          ((polynomialRootCount f e:ℝ) / e)⁻¹ * (polynomialRootCount f (d.lcm e):ℝ) = _
        rw [inv_div, inv_div]
        field_simp
        linear_combination (d:ℝ) * e * hroot
      _ ≤ (d:ℝ) * e := div_le_self (by positivity) hrg1
      _ ≤ (D:ℝ)^2 := by
        have hdD : (d:ℝ) ≤ D := by exact_mod_cast (Finset.mem_Icc.mp hd).2
        have heD : (e:ℝ) ≤ D := by exact_mod_cast (Finset.mem_Icc.mp he).2
        simpa only [pow_two] using mul_le_mul hdD heD (Nat.cast_nonneg e) (Nat.cast_nonneg D)
  calc
    _ ≤ ∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D, (D:ℝ)^2 :=
      Finset.sum_le_sum (fun d hd ↦ Finset.sum_le_sum (fun e he ↦ hb d hd e he))
    _ = _ := by simp only [Finset.sum_const, Nat.card_Icc, Nat.add_sub_cancel, nsmul_eq_mul]; ring

lemma polynomial_rough_count_le_selberg (f : ℤ[X]) (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P →
      0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1)
    (D N : ℕ) (hD : 1 ≤ D) :
    (((Finset.range N).filter (fun n : ℕ ↦
      ∀ p ∈ P.primeFactors, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        (N:ℝ) / selbergDenominator (polynomialRootDensity f) P D + (D:ℝ)^4 := by
  let ν := polynomialRootDensity f
  have hν := polynomialRootDensity_multiplicative f
  have hcount := polynomial_rough_count_le_sieve f D N (selbergOptimalWeight ν P D)
    P.primeFactors hD (selbergOptimalWeight_one ν hν P hP hνprime D hD) (by
      intro d hd hne
      apply Nat.primeFactors_mono _ hP.ne_zero
      by_contra hnot
      exact hne (selbergOptimalWeight_eq_zero_of_not_dvd ν P D d hnot))
  rw [polynomialSieveQuadratic_selberg f P hP hνprime D hD, mul_one_div] at hcount
  exact hcount.trans (add_le_add le_rfl (polynomialSieveError_selberg f P hP hνprime D hD))


lemma selbergDiagonal_inv_ge_density (ν : ArithmeticFunction ℝ) (hν : ν.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P → 0 < ν p ∧ ν p < 1)
    (d : ℕ) (hd : d ∣ P) : ν d ≤ (selbergDiagonal ν d)⁻¹ := by
  have hdiag := selbergDiagonal_pos ν hν P hP hνprime d hd
  have hd0 : d ≠ 0 :=
    (Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero hP.ne_zero)).ne'
  have hle : selbergDiagonal ν d ≤ (ν d)⁻¹ := by
    rw [← selbergDiagonal_sum_divisors]
    apply Finset.single_le_sum
    · intro r hr
      exact (selbergDiagonal_pos ν hν P hP hνprime r
        ((Nat.dvd_of_mem_divisors hr).trans hd)).le
    · exact Nat.mem_divisors.mpr ⟨dvd_refl d, hd0⟩
  simpa only [one_div, inv_inv] using one_div_le_one_div_of_le hdiag hle

lemma polynomial_selberg_denominator_lower (f : ℤ[X]) (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P →
      0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1) (D : ℕ) :
    (∑ d ∈ (Finset.Icc 1 D).filter (fun d ↦ d ∣ P),
      (polynomialRootResidues f d).card / (d:ℝ)) ≤
        selbergDenominator (polynomialRootDensity f) P D := by
  have he : (Finset.Icc 1 D).filter (fun d ↦ d ∣ P) =
      P.divisors.filter (fun d ↦ d ≤ D) := by
    ext d
    simp only [Finset.mem_filter, Finset.mem_Icc, Nat.mem_divisors]
    constructor
    · rintro ⟨⟨_, hD⟩, hd⟩
      exact ⟨⟨hd, hP.ne_zero⟩, hD⟩
    · rintro ⟨⟨hd, _⟩, hD⟩
      exact ⟨⟨Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero hP.ne_zero), hD⟩, hd⟩
  rw [he, Finset.sum_filter]
  apply Finset.sum_le_sum
  intro d hd
  unfold selbergCutoff
  split_ifs
  · exact selbergDiagonal_inv_ge_density _ (polynomialRootDensity_multiplicative f)
      P hP hνprime d (Nat.dvd_of_mem_divisors hd)
  · exact le_rfl

lemma polynomial_rough_count_le_harmonic_sieve (f : ℤ[X]) (P : ℕ) (hP : Squarefree P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P →
      0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1)
    (D N : ℕ) (hD : 1 ≤ D) :
    (((Finset.range N).filter (fun n : ℕ ↦
      ∀ p ∈ P.primeFactors, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        (N:ℝ) / (∑ d ∈ (Finset.Icc 1 D).filter (fun d ↦ d ∣ P),
          (polynomialRootResidues f d).card / (d:ℝ)) + (D:ℝ)^4 := by
  have hroot1 : (polynomialRootResidues f 1).card = 1 :=
    (polynomialRootCount_multiplicative f).map_one
  have hH : (1:ℝ) ≤ ∑ d ∈ (Finset.Icc 1 D).filter (fun d ↦ d ∣ P),
      (polynomialRootResidues f d).card / (d:ℝ) := by
    have hmem : 1 ∈ (Finset.Icc 1 D).filter (fun d ↦ d ∣ P) := by simp [hD]
    have hsum := Finset.single_le_sum
      (f := fun d : ℕ ↦ (polynomialRootResidues f d).card / (d:ℝ))
      (fun d _ ↦ by positivity) hmem
    simpa only [hroot1, Nat.cast_one, div_one] using hsum
  apply (polynomial_rough_count_le_selberg f P hP hνprime D N hD).trans
  refine add_le_add ?_ le_rfl
  exact div_le_div_of_nonneg_left (Nat.cast_nonneg N) (zero_lt_one.trans_le hH)
    (polynomial_selberg_denominator_lower f P hP hνprime D)


lemma idealCorrection_local_bounded_good_bound (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (p : ℕ) [Fact p.Prime]
    (B : ℝ) (hB : 0 ≤ B) (hup : u p = idealNormCount K p)
    (huB : ∀ j : ℕ, |u (p ^ j)| ≤ B)
    (hs : Summable (fun k : ℕ ↦ ‖idealCorrection K u (p ^ k) / (p : ℝ) ^ k‖)) :
    (∑' k : ℕ, ‖idealCorrection K u (p ^ k) / (p : ℝ) ^ k‖) ≤
      1 + 2 * ((2 : ℝ) ^ Module.finrank ℚ K * B) / (p : ℝ) ^ 2 := by
  have hp2 : (2:ℝ) ≤ p := by exact_mod_cast (Fact.out : p.Prime).two_le
  have hp0 : (0:ℝ) < p := by linarith
  have hq0 : 0 ≤ (p:ℝ)⁻¹ := inv_nonneg.mpr hp0.le
  have hq : (p:ℝ)⁻¹ ≤ 1/2 := by
    simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 2) hp2
  have hq1 : (p:ℝ)⁻¹ < 1 := by linarith
  let M : ℝ := (2 : ℝ) ^ Module.finrank ℚ K * B
  have hM : 0 ≤ M := mul_nonneg (by positivity) hB
  have hg := (summable_geometric_of_lt_one hq0 hq1).mul_left (M / (p:ℝ)^2)
  have hs1 := (summable_nat_add_iff 1).mpr hs
  rw [hs.tsum_eq_zero_add, hs1.tsum_eq_zero_add]
  have hone : idealCorrection K u 1 = 1 := (idealCorrection_multiplicative K u).map_one
  have hprime : idealCorrection K u p = 0 := by
    simpa only [pow_one] using (idealCorrection_prime_pow K u hu p 1).trans
      (by simpa only [pow_one] using idealLocalCorrection_apply_prime K p u hu.map_one hup)
  simp only [pow_zero, hone, div_one, norm_one, zero_add, pow_one, hprime, zero_div, norm_zero]
  refine add_le_add le_rfl ?_
  calc
    _ ≤ ∑' k : ℕ, M / (p:ℝ)^2 * ((p:ℝ)⁻¹)^k := by
      apply ((summable_nat_add_iff 2).mpr hs).tsum_le_tsum _ hg
      intro k
      rw [idealCorrection_prime_pow K u hu p (k+2), Real.norm_eq_abs, abs_div,
        abs_of_pos (pow_pos hp0 _)]
      calc
        _ ≤ M / (p:ℝ)^(k+2) :=
          div_le_div_of_nonneg_right (idealLocalCorrection_abs_le K p u B hB huB _) (by positivity)
        _ = _ := by rw [pow_add, inv_pow]; ring
    _ = M / (p:ℝ)^2 * (1-(p:ℝ)⁻¹)⁻¹ := by
      rw [tsum_mul_left, tsum_geometric_of_lt_one hq0 hq1]
    _ ≤ M / (p:ℝ)^2 * 2 := by
      apply mul_le_mul_of_nonneg_left _ (div_nonneg hM (by positivity))
      have ht : 1/2 ≤ 1-(p:ℝ)⁻¹ := by linarith
      have hh := one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 1/2) ht
      norm_num only [one_div, inv_div, inv_one, div_one] at hh
      exact hh
    _ = _ := by dsimp [M]; ring

lemma idealCorrection_summable_of_bounded_good_primes (K : Type*) [Field K] [NumberField K]
    (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (s : Finset ℕ)
    (B : ℝ) (hB : 0 ≤ B)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖u (p ^ k) / (p : ℝ) ^ k‖))
    (hgood : ∀ p : ℕ, p.Prime → p ∉ s →
      u p = idealNormCount K p ∧ ∀ j : ℕ, |u (p ^ j)| ≤ B) :
    Summable (fun n : ℕ ↦ ‖idealCorrection K u n / (n : ℝ)‖) := by
  let A : ℝ := 2 * ((2 : ℝ) ^ Module.finrank ℚ K * B)
  let C : ℕ → ℝ := fun n ↦ if n ∈ s then
    ∑' k : ℕ, ‖idealCorrection K u (n ^ k) / (n : ℝ) ^ k‖ else A / (n : ℝ) ^ 2
  have hCpos : ∀ n, 0 ≤ C n := by
    intro n
    dsimp [C, A]
    split_ifs
    · exact tsum_nonneg (fun _ ↦ abs_nonneg _)
    · positivity
  have hbase : Summable (fun n : ℕ ↦ A / (n : ℝ) ^ 2) := by
    simpa only [div_eq_mul_inv] using
      (Real.summable_nat_pow_inv.mpr (by norm_num : 1 < (2 : ℕ))).mul_left A
  have hC : Summable C := hbase.congr_cofinite (by
    filter_upwards [s.finite_toSet.compl_mem_cofinite] with n hn
    exact (if_neg hn).symm)
  apply summable_weighted_multiplicative_of_local_bound (idealCorrection K u)
    (idealCorrection_multiplicative K u) C hC hCpos
  · intro p hp
    haveI : Fact p.Prime := ⟨hp⟩
    simpa only [Real.norm_eq_abs] using idealCorrection_local_summable K u hu p (hlocal p hp)
  · intro p hp
    haveI : Fact p.Prime := ⟨hp⟩
    have hs := idealCorrection_local_summable K u hu p (hlocal p hp)
    by_cases hps : p ∈ s
    · simp only [C, if_pos hps, Real.norm_eq_abs]
      linarith
    · obtain ⟨hup, hbound⟩ := hgood p hp hps
      simpa only [C, if_neg hps, A, Real.norm_eq_abs] using
        idealCorrection_local_bounded_good_bound K u hu p B hB hup hbound hs


/-- Squarefree root counts, with all prime factors of `Q` removed. -/
noncomputable def squarefreeRootCount (f : ℤ[X]) (Q : ℕ) : ArithmeticFunction ℝ where
  toFun n := if Squarefree n ∧ n.Coprime Q then (polynomialRootCount f n : ℝ) else 0
  map_zero' := by simp

lemma squarefreeRootCount_nonneg (f : ℤ[X]) (Q n : ℕ) :
    0 ≤ squarefreeRootCount f Q n := by
  unfold squarefreeRootCount
  simp only [ArithmeticFunction.coe_mk]
  split_ifs <;> positivity

lemma squarefreeRootCount_multiplicative (f : ℤ[X]) (Q : ℕ) :
    (squarefreeRootCount f Q).IsMultiplicative := by
  rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
  constructor
  · simp [squarefreeRootCount, (polynomialRootCount_multiplicative f).map_one]
  · intro a b ha hb hab
    simp only [squarefreeRootCount, ArithmeticFunction.coe_mk,
      Nat.squarefree_mul hab, Nat.coprime_mul_iff_left,
      (polynomialRootCount_multiplicative f).map_mul_of_coprime hab, Nat.cast_mul]
    split_ifs <;> simp_all


lemma squarefreeRootCount_prime (f : ℤ[X]) (Q p : ℕ) (hp : p.Prime) :
    squarefreeRootCount f Q p = if p ∣ Q then 0 else (polynomialRootCount f p : ℝ) := by
  simp only [squarefreeRootCount, ArithmeticFunction.coe_mk, hp.squarefree, true_and,
    hp.coprime_iff_not_dvd]
  split_ifs <;> rfl

lemma squarefreeRootCount_prime_pow_eq_zero (f : ℤ[X]) (Q p k : ℕ)
    (hp : p.Prime) (hk : 2 ≤ k) : squarefreeRootCount f Q (p^k) = 0 := by
  have hns : ¬Squarefree (p^k) := by
    rw [Nat.squarefree_pow_iff hp.ne_one (by omega)]
    omega
  simp [squarefreeRootCount, hns]

lemma squarefreeRootCount_local_summable (f : ℤ[X]) (Q p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖squarefreeRootCount f Q (p^k) / (p:ℝ)^k‖) := by
  apply summable_of_ne_finset_zero (s := Finset.range 2)
  intro k hk
  rw [squarefreeRootCount_prime_pow_eq_zero f Q p k hp (by simpa using hk), zero_div, norm_zero]

lemma squarefreeRootCount_positive_harmonic_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) (Q : ℕ) (hQ : Q ≠ 0) :
    ∃ c > (0:ℝ), Tendsto
      (fun N : ℕ ↦ harmonicWeightSum (squarefreeRootCount f Q) N / log N)
      atTop (𝓝 c) := by
  obtain ⟨K, hK, hNF, s, hagree⟩ := exists_numberField_prime_root_agreement f hdeg hirr
  letI := hK
  letI := hNF
  let u := squarefreeRootCount f Q
  have hu := squarefreeRootCount_multiplicative f Q
  let R := (f.resultant f.derivative).natAbs
  have hR0 : R ≠ 0 := Int.natAbs_ne_zero.mpr (resultant_derivative_ne_zero_of_irreducible f hdeg hirr)
  have hs : Summable (fun n : ℕ ↦ ‖idealCorrection K u n / (n:ℝ)‖) := by
    apply idealCorrection_summable_of_bounded_good_primes K u hu
      (s ∪ (Q*R).primeFactors) (f.natDegree + 1 : ℝ) (by positivity)
      (squarefreeRootCount_local_summable f Q)
    intro p hp hps
    haveI : Fact p.Prime := ⟨hp⟩
    have hps' : p ∉ s := fun h ↦ hps (Finset.mem_union_left _ h)
    have hnotdiv : ¬p ∣ Q*R := fun h ↦ hps
      (Finset.mem_union_right _ (Nat.mem_primeFactors.mpr ⟨hp, h, Nat.mul_ne_zero hQ hR0⟩))
    have hpQ : ¬p ∣ Q := fun h ↦ hnotdiv (dvd_mul_of_dvd_left h _)
    have hpR : ¬p ∣ R := fun h ↦ hnotdiv (dvd_mul_of_dvd_right h _)
    have hres : ¬(p:ℤ) ∣ f.resultant f.derivative := by
      intro h
      exact hpR (by simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr h)
    have hpval : u p = (polynomialRootResidues f p).card := by
      simp only [u, squarefreeRootCount_prime f Q p hp, if_neg hpQ]
      rfl
    refine ⟨hpval.trans (by exact_mod_cast hagree p hp hps'), ?_⟩
    intro j
    rcases j with _ | (_ | j)
    · rw [pow_zero, hu.map_one, abs_one]
      have := Nat.cast_nonneg (α := ℝ) f.natDegree
      linarith
    · rw [pow_one, hpval, abs_of_nonneg (Nat.cast_nonneg _)]
      have hb := rootResidues_prime_le_natDegree_of_simple f p
        (simple_roots_of_not_dvd_resultant f hdeg p hres)
      have hbR : ((polynomialRootResidues f p).card : ℝ) ≤ f.natDegree := by exact_mod_cast hb
      linarith
    · rw [squarefreeRootCount_prime_pow_eq_zero f Q p (j+2) hp (by omega), abs_zero]
      positivity
  refine ⟨_, mul_pos (idealCorrection_tsum_pos K u hu
      (squarefreeRootCount_nonneg f Q) (squarefreeRootCount_local_summable f Q) hs)
      (NumberField.dedekindZeta_residue_pos K), ?_⟩
  have ht := tendsto_harmonicWeightSum_convolution (idealNormCount K : ArithmeticFunction ℝ)
    (idealCorrection K u) (fun _ ↦ Nat.cast_nonneg _) _ (idealNormCount_harmonic_limit K) hs
  rw [idealCorrection_mul_idealNormCount K u hu] at ht
  exact ht


lemma squarefree_prod_of_primes (s : Finset ℕ) (hs : ∀ p ∈ s, p.Prime) :
    Squarefree (∏ p ∈ s, p) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert p s hp ih =>
    have hprime := hs p (Finset.mem_insert_self _ _)
    have hs' : ∀ q ∈ s, q.Prime := fun q hq ↦ hs q (Finset.mem_insert_of_mem hq)
    rw [Finset.prod_insert hp]
    apply (Nat.squarefree_mul ?_).mpr ⟨hprime.squarefree, ih hs'⟩
    apply Nat.coprime_prod_right_iff.mpr
    intro q hq
    rw [hprime.coprime_iff_not_dvd, (hs' q hq).dvd_iff_eq hprime.ne_one]
    intro h
    exact hp (h ▸ hq)

noncomputable def polynomialSievePrimes (f : ℤ[X]) (Q D : ℕ) : Finset ℕ :=
  (Finset.range (D+1)).filter
    (fun p ↦ p.Prime ∧ ¬p ∣ Q ∧ 0 < polynomialRootCount f p)

noncomputable def polynomialSieveProduct (f : ℤ[X]) (Q D : ℕ) : ℕ :=
  ∏ p ∈ polynomialSievePrimes f Q D, p

lemma mem_polynomialSievePrimes (f : ℤ[X]) (Q D p : ℕ) :
    p ∈ polynomialSievePrimes f Q D ↔
      p ≤ D ∧ p.Prime ∧ ¬p ∣ Q ∧ 0 < polynomialRootCount f p := by
  simp [polynomialSievePrimes]

lemma polynomialSieveProduct_squarefree (f : ℤ[X]) (Q D : ℕ) :
    Squarefree (polynomialSieveProduct f Q D) :=
  squarefree_prod_of_primes _ (fun p hp ↦ (mem_polynomialSievePrimes f Q D p).mp hp |>.2.1)

lemma polynomialSieveProduct_primeFactors (f : ℤ[X]) (Q D : ℕ) :
    (polynomialSieveProduct f Q D).primeFactors = polynomialSievePrimes f Q D :=
  Nat.primeFactors_prod (fun p hp ↦ (mem_polynomialSievePrimes f Q D p).mp hp |>.2.1)

lemma polynomialSieveProduct_coprime (f : ℤ[X]) (Q D : ℕ) :
    (polynomialSieveProduct f Q D).Coprime Q := by
  apply Nat.Coprime.prod_left
  intro p hp
  obtain ⟨_, hprime, hQ, _⟩ := (mem_polynomialSievePrimes f Q D p).mp hp
  exact hprime.coprime_iff_not_dvd.mpr hQ

lemma squarefreeRootCount_eq_of_dvd_sieveProduct (f : ℤ[X]) (Q D d : ℕ)
    (hd : d ∣ polynomialSieveProduct f Q D) :
    squarefreeRootCount f Q d = (polynomialRootCount f d : ℝ) := by
  have hS := Squarefree.squarefree_of_dvd hd (polynomialSieveProduct_squarefree f Q D)
  have hQ := Nat.Coprime.of_dvd_left hd (polynomialSieveProduct_coprime f Q D)
  simp [squarefreeRootCount, hS, hQ]

lemma dvd_sieveProduct_of_squarefreeRootCount_ne_zero (f : ℤ[X]) (Q D d : ℕ)
    (hdD : d ≤ D) (hd : squarefreeRootCount f Q d ≠ 0) :
    d ∣ polynomialSieveProduct f Q D := by
  have hcond : Squarefree d ∧ d.Coprime Q := by
    by_contra hc
    exact hd (by simp [squarefreeRootCount, hc])
  have hroot : polynomialRootCount f d ≠ 0 := by
    intro hz
    exact hd (by simp [squarefreeRootCount, hcond, hz])
  have hprod := (polynomialRootCount_multiplicative f).prod_primeFactors hcond.1
  have hrootp : ∀ p ∈ d.primeFactors, polynomialRootCount f p ≠ 0 :=
    Finset.prod_ne_zero_iff.mp (hprod ▸ hroot)
  rw [← Nat.prod_primeFactors_of_squarefree hcond.1]
  apply Finset.prod_dvd_prod_of_subset
  intro p hp
  obtain ⟨hprime, hpd, _⟩ := Nat.mem_primeFactors.mp hp
  apply (mem_polynomialSievePrimes f Q D p).mpr
  refine ⟨(Nat.le_of_dvd (Nat.pos_of_ne_zero hcond.1.ne_zero) hpd).trans hdD,
    hprime, ?_, Nat.pos_of_ne_zero (hrootp p hp)⟩
  exact hprime.coprime_iff_not_dvd.mp (Nat.Coprime.of_dvd_left hpd hcond.2)

lemma squarefreeRootCount_harmonic_eq_sieve_sum (f : ℤ[X]) (Q D : ℕ) :
    harmonicWeightSum (squarefreeRootCount f Q) D =
      ∑ d ∈ (Finset.Icc 1 D).filter (fun d ↦ d ∣ polynomialSieveProduct f Q D),
        (polynomialRootResidues f d).card / (d:ℝ) := by
  unfold harmonicWeightSum
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro d hd
  by_cases hdP : d ∣ polynomialSieveProduct f Q D
  · rw [if_pos hdP, squarefreeRootCount_eq_of_dvd_sieveProduct f Q D d hdP]
    rfl
  · rw [if_neg hdP]
    have hz : squarefreeRootCount f Q d = 0 := by
      by_contra hne
      exact hdP (dvd_sieveProduct_of_squarefreeRootCount_ne_zero f Q D d
        (Finset.mem_Icc.mp hd).2 hne)
    rw [hz, zero_div]

noncomputable def polynomialSieveBadProduct (f : ℤ[X]) : ℕ :=
  f.natDegree.factorial * (f.resultant f.derivative).natAbs

lemma polynomialSieveBadProduct_ne_zero (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : polynomialSieveBadProduct f ≠ 0 :=
  Nat.mul_ne_zero (Nat.factorial_ne_zero _) (Int.natAbs_ne_zero.mpr
    (resultant_derivative_ne_zero_of_irreducible f hdeg hirr))

lemma polynomialRootDensity_lt_one_of_not_dvd_badProduct (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (p : ℕ) (hp : p.Prime)
    (hnot : ¬p ∣ polynomialSieveBadProduct f) : polynomialRootDensity f p < 1 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hfact : ¬p ∣ f.natDegree.factorial := fun h ↦ hnot (dvd_mul_of_dvd_left h _)
  have hdp : f.natDegree < p := by
    have := (Nat.Prime.dvd_factorial hp).not.mp hfact
    omega
  have hres : ¬(p:ℤ) ∣ f.resultant f.derivative := by
    intro h
    have hd : p ∣ (f.resultant f.derivative).natAbs := by
      simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr h
    exact hnot (dvd_mul_of_dvd_right hd _)
  have hroot := rootResidues_prime_le_natDegree_of_simple f p
    (simple_roots_of_not_dvd_resultant f hdeg p hres)
  rw [polynomialRootDensity_apply]
  apply (div_lt_one (by exact_mod_cast hp.pos : (0:ℝ) < p)).mpr
  exact_mod_cast hroot.trans_lt hdp

lemma polynomialSieveProduct_density_bounds (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (D p : ℕ) (hp : p.Prime) (hpd : p ∣ polynomialSieveProduct f (polynomialSieveBadProduct f) D) :
    0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1 := by
  have hmem : p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f) D := by
    rw [← polynomialSieveProduct_primeFactors]
    exact Nat.mem_primeFactors.mpr ⟨hp, hpd,
      (polynomialSieveProduct_squarefree f (polynomialSieveBadProduct f) D).ne_zero⟩
  obtain ⟨_, _, hbad, hroot⟩ := (mem_polynomialSievePrimes _ _ _ _).mp hmem
  refine ⟨?_, polynomialRootDensity_lt_one_of_not_dvd_badProduct f hdeg p hp hbad⟩
  change 0 < (polynomialRootCount f p:ℝ) / (p:ℝ)
  exact div_pos (by exact_mod_cast hroot) (by exact_mod_cast hp.pos)

lemma polynomial_rough_count_le_squarefree_harmonic_sieve (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (D N : ℕ) (hD : 1 ≤ D) :
    (((Finset.range N).filter (fun n : ℕ ↦
      ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f) D,
        ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
      (N:ℝ) / harmonicWeightSum (squarefreeRootCount f (polynomialSieveBadProduct f)) D + (D:ℝ)^4 := by
  have h := polynomial_rough_count_le_harmonic_sieve f
    (polynomialSieveProduct f (polynomialSieveBadProduct f) D)
    (polynomialSieveProduct_squarefree f (polynomialSieveBadProduct f) D)
    (polynomialSieveProduct_density_bounds f hdeg D) D N hD
  rwa [polynomialSieveProduct_primeFactors, ← squarefreeRootCount_harmonic_eq_sieve_sum] at h


lemma squarefreeRootCount_harmonic_eventual_lower (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) (Q : ℕ) (hQ : Q ≠ 0) :
    ∃ c > (0:ℝ), ∀ᶠ D : ℕ in atTop,
      c * log D ≤ harmonicWeightSum (squarefreeRootCount f Q) D := by
  obtain ⟨κ, hκ, ht⟩ := squarefreeRootCount_positive_harmonic_limit f hdeg hirr Q hQ
  refine ⟨κ/2, by positivity, ?_⟩
  have he := ht.eventually_const_lt (show κ/2 < κ by linarith)
  filter_upwards [he, eventually_gt_atTop (1:ℕ)] with D hD hD1
  exact ((lt_div_iff₀ (Real.log_pos (by exact_mod_cast hD1))).mp hD).le

lemma polynomial_rough_count_log_sieve (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ A > (0:ℝ), ∃ D₀ : ℕ, ∀ D : ℕ, D₀ ≤ D → ∀ N : ℕ,
      (((Finset.range N).filter (fun n : ℕ ↦
        ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f) D,
          ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        A * N / log D + (D:ℝ)^4 := by
  obtain ⟨c, hc, hH⟩ := squarefreeRootCount_harmonic_eventual_lower f hdeg hirr
    (polynomialSieveBadProduct f) (polynomialSieveBadProduct_ne_zero f hdeg hirr)
  obtain ⟨D₀, hD₀⟩ := eventually_atTop.mp hH
  refine ⟨c⁻¹, inv_pos.mpr hc, max 2 D₀, ?_⟩
  intro D hD N
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have hlog : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < D by omega))
  calc
    _ ≤ (N:ℝ) / harmonicWeightSum (squarefreeRootCount f (polynomialSieveBadProduct f)) D +
        (D:ℝ)^4 := polynomial_rough_count_le_squarefree_harmonic_sieve f hdeg D N (by omega)
    _ ≤ (N:ℝ) / (c * log D) + (D:ℝ)^4 :=
      add_le_add (div_le_div_of_nonneg_left (Nat.cast_nonneg N) (mul_pos hc hlog) (hD₀ D hDD)) le_rfl
    _ = _ := by ring


lemma polynomial_rough_count_log_bound (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ A > (0:ℝ), ∃ D₀ : ℕ, ∀ D N : ℕ, D₀ ≤ D → D^5 ≤ N →
      (((Finset.range N).filter (fun n : ℕ ↦
        ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f) D,
          ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤ A * N / log D := by
  obtain ⟨A, hA, D₀, hb⟩ := polynomial_rough_count_log_sieve f hdeg hirr
  refine ⟨A+1, by linarith, max 2 D₀, ?_⟩
  intro D N hD hDN
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have hDpos : (0:ℝ) < D := by exact_mod_cast (show 0 < D by omega)
  have hlog : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < D by omega))
  have herror : (D:ℝ)^4 ≤ (N:ℝ)/log D := by
    apply (le_div_iff₀ hlog).mpr
    calc
      _ ≤ (D:ℝ)^4 * D := mul_le_mul_of_nonneg_left (Real.log_le_self hDpos.le) (by positivity)
      _ = (D:ℝ)^5 := by ring
      _ ≤ N := by exact_mod_cast hDN
  calc
    _ ≤ A*N/log D + (D:ℝ)^4 := hb D hDD N
    _ ≤ A*N/log D + (N:ℝ)/log D := add_le_add le_rfl herror
    _ = _ := by ring


lemma polynomialSieveWeight_restricted_second_moment (f : ℤ[X]) (a D N : ℕ) (w : ℕ → ℝ) :
    (∑ n ∈ (Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ)),
      polynomialSieveWeight f D w n ^ 2) =
      ∑ d ∈ Finset.Icc 1 D, ∑ e ∈ Finset.Icc 1 D,
        w d * w e * (((Finset.range N).filter
          (fun n : ℕ ↦ ((a.lcm (d.lcm e):ℕ):ℤ) ∣ f.eval (n:ℤ))).card : ℝ) := by
  simp_rw [polynomialSieveWeight_square]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro d hd
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e he
  rw [← Finset.sum_filter, Finset.filter_filter, Finset.sum_const]
  simp only [int_nat_lcm_dvd_iff, nsmul_eq_mul]
  ring

lemma polynomialSieveWeight_restricted_second_moment_error (f : ℤ[X])
    (a D N P : ℕ) (ha : 0 < a) (haP : a.Coprime P) (w : ℕ → ℝ)
    (hw : ∀ d ∈ Finset.Icc 1 D, w d ≠ 0 → d ∣ P) :
    |(∑ n ∈ (Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ)),
        polynomialSieveWeight f D w n ^ 2) -
      ((N:ℝ) * (polynomialRootResidues f a).card / a) * polynomialSieveQuadratic f D w| ≤
        (polynomialRootResidues f a).card * polynomialSieveError f D w := by
  rw [polynomialSieveWeight_restricted_second_moment]
  unfold polynomialSieveQuadratic polynomialSieveError
  simp_rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro d hd
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro e he
  by_cases hwd : w d = 0
  · simp [hwd]
  by_cases hwe : w e = 0
  · simp [hwe]
  have hde : 0 < d.lcm e := Nat.lcm_pos (Finset.mem_Icc.mp hd).1 (Finset.mem_Icc.mp he).1
  have hac : a.Coprime (d.lcm e) := haP.of_dvd_right (Nat.lcm_dvd (hw d hd hwd) (hw e he hwe))
  have hρ : (polynomialRootResidues f (a * d.lcm e)).card =
      (polynomialRootResidues f a).card * (polynomialRootResidues f (d.lcm e)).card :=
    (polynomialRootCount_multiplicative f).map_mul_of_coprime hac
  rw [hac.lcm_eq_mul]
  have herr := polynomial_root_count_error f (a * d.lcm e) N (Nat.mul_pos ha hde)
  simp only [hρ, Nat.cast_mul] at herr
  calc
    _ = |w d * w e| * |(((Finset.range N).filter
        (fun n : ℕ ↦ ((a * d.lcm e:ℕ):ℤ) ∣ f.eval (n:ℤ))).card : ℝ) -
          (N:ℝ) / ((a:ℝ) * (d.lcm e:ℝ)) *
            ((polynomialRootResidues f a).card * (polynomialRootResidues f (d.lcm e)).card)| := by
      rw [← abs_mul]
      congr 1
      ring
    _ ≤ |w d * w e| * ((polynomialRootResidues f a).card *
        (polynomialRootResidues f (d.lcm e)).card) :=
      by simpa only [Nat.cast_mul] using mul_le_mul_of_nonneg_left herr (abs_nonneg _)
    _ = _ := by ring

lemma polynomial_restricted_rough_count_le_sieve (f : ℤ[X])
    (a D N P : ℕ) (ha : 0 < a) (haP : a.Coprime P) (w : ℕ → ℝ)
    (hD : 1 ≤ D) (hw1 : w 1 = 1)
    (hw : ∀ d ∈ Finset.Icc 1 D, w d ≠ 0 → d ∣ P) (hP : P ≠ 0) :
    (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ) ∧
      ∀ p ∈ P.primeFactors, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        ((N:ℝ) * (polynomialRootResidues f a).card / a) * polynomialSieveQuadratic f D w +
          (polynomialRootResidues f a).card * polynomialSieveError f D w := by
  have hcount : (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ) ∧
      ∀ p ∈ P.primeFactors, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
      ∑ n ∈ (Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ)),
        polynomialSieveWeight f D w n ^ 2 := by
    rw [← Finset.filter_filter, Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
    apply Finset.sum_le_sum
    intro n hn
    split_ifs with hrough
    · rw [polynomialSieveWeight_eq_one_of_rough f D n w P.primeFactors hD hw1
        (fun d hd hne ↦ Nat.primeFactors_mono (hw d hd hne) hP) hrough]
      norm_num
    · exact sq_nonneg _
  have herr := le_abs_self _ |>.trans
    (polynomialSieveWeight_restricted_second_moment_error f a D N P ha haP w hw)
  linarith

lemma polynomial_restricted_rough_count_le_selberg (f : ℤ[X])
    (a P : ℕ) (ha : 0 < a) (hP : Squarefree P) (haP : a.Coprime P)
    (hνprime : ∀ p : ℕ, p.Prime → p ∣ P →
      0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1)
    (D N : ℕ) (hD : 1 ≤ D) :
    (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ) ∧
      ∀ p ∈ P.primeFactors, ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        (N:ℝ) * (polynomialRootResidues f a).card /
          (a * selbergDenominator (polynomialRootDensity f) P D) +
          (polynomialRootResidues f a).card * (D:ℝ)^4 := by
  let ν := polynomialRootDensity f
  have hν := polynomialRootDensity_multiplicative f
  have hcount := polynomial_restricted_rough_count_le_sieve f a D N P ha haP
    (selbergOptimalWeight ν P D) hD (selbergOptimalWeight_one ν hν P hP hνprime D hD)
    (by
      intro d hd hne
      by_contra hnot
      exact hne (selbergOptimalWeight_eq_zero_of_not_dvd ν P D d hnot)) hP.ne_zero
  rw [polynomialSieveQuadratic_selberg f P hP hνprime D hD] at hcount
  have herr := mul_le_mul_of_nonneg_left (polynomialSieveError_selberg f P hP hνprime D hD)
    (Nat.cast_nonneg (α := ℝ) (polynomialRootResidues f a).card)
  refine hcount.trans ((add_le_add le_rfl herr).trans_eq ?_)
  ring


noncomputable def squarefreeRootDivisorPart (f : ℤ[X]) (Q a : ℕ) : ArithmeticFunction ℝ where
  toFun n := if n ∣ a then squarefreeRootCount f Q n else 0
  map_zero' := by simp

lemma squarefreeRootDivisorPart_nonneg (f : ℤ[X]) (Q a n : ℕ) :
    0 ≤ squarefreeRootDivisorPart f Q a n := by
  change 0 ≤ if n ∣ a then squarefreeRootCount f Q n else 0
  split_ifs
  · exact squarefreeRootCount_nonneg f Q n
  · exact le_rfl

lemma squarefreeRootDivisorPart_multiplicative (f : ℤ[X]) (Q a : ℕ) :
    (squarefreeRootDivisorPart f Q a).IsMultiplicative := by
  constructor
  · simp [squarefreeRootDivisorPart, (squarefreeRootCount_multiplicative f Q).map_one]
  · intro m n hmn
    have hdiv : m*n ∣ a ↔ m ∣ a ∧ n ∣ a :=
      ⟨fun h ↦ ⟨(dvd_mul_right m n).trans h, (dvd_mul_left n m).trans h⟩,
        fun h ↦ hmn.mul_dvd_of_dvd_of_dvd h.1 h.2⟩
    simp only [squarefreeRootDivisorPart, ArithmeticFunction.coe_mk,
      hdiv, (squarefreeRootCount_multiplicative f Q).map_mul_of_coprime hmn]
    split_ifs <;> simp_all

lemma squarefreeRootCount_prime_pow_eq_zero_of_prime_dvd (f : ℤ[X]) (Q p k : ℕ)
    (hp : p.Prime) (hpQ : p ∣ Q) (hk : k ≠ 0) : squarefreeRootCount f Q (p^k) = 0 := by
  by_cases hk1 : k = 1
  · simp [hk1, squarefreeRootCount_prime f Q p hp, hpQ]
  · exact squarefreeRootCount_prime_pow_eq_zero f Q p k hp (by omega)

lemma squarefreeRootCount_mul_cutoff_prime_pow (f : ℤ[X]) (Q a p k : ℕ)
    (hp : p.Prime) (hpa : ¬p ∣ a) :
    squarefreeRootCount f (Q*a) (p^k) = squarefreeRootCount f Q (p^k) := by
  by_cases hk0 : k = 0
  · simp [hk0, (squarefreeRootCount_multiplicative f (Q*a)).map_one,
      (squarefreeRootCount_multiplicative f Q).map_one]
  by_cases hk1 : k = 1
  · simp [hk1, squarefreeRootCount_prime f (Q*a) p hp,
      squarefreeRootCount_prime f Q p hp, hp.dvd_mul, hpa]
  · rw [squarefreeRootCount_prime_pow_eq_zero f (Q*a) p k hp (by omega),
      squarefreeRootCount_prime_pow_eq_zero f Q p k hp (by omega)]

lemma squarefreeRootDivisorPart_mul_cutoff (f : ℤ[X]) (Q a : ℕ) :
    squarefreeRootDivisorPart f Q a * squarefreeRootCount f (Q*a) = squarefreeRootCount f Q := by
  apply (ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers _
    ((squarefreeRootDivisorPart_multiplicative f Q a).mul
      (squarefreeRootCount_multiplicative f (Q*a))) _
        (squarefreeRootCount_multiplicative f Q)).mpr
  intro p k hp
  rw [convolution_prime_pow _ _ p k hp]
  by_cases hpa : p ∣ a
  · rw [Finset.sum_eq_single k]
    · rw [Nat.sub_self, pow_zero, (squarefreeRootCount_multiplicative f (Q*a)).map_one, mul_one]
      change (if p^k ∣ a then squarefreeRootCount f Q (p^k) else 0) = _
      by_cases hk0 : k = 0
      · simp [hk0]
      by_cases hk1 : k = 1
      · simp [hk1, hpa]
      · simp [squarefreeRootCount_prime_pow_eq_zero f Q p k hp (by omega)]
    · intro j hj hjk
      have hkj : k-j ≠ 0 := by have := Finset.mem_range.mp hj; omega
      rw [squarefreeRootCount_prime_pow_eq_zero_of_prime_dvd f (Q*a) p (k-j) hp
        (dvd_mul_of_dvd_right hpa _) hkj, mul_zero]
    · simp
  · rw [Finset.sum_eq_single 0]
    · rw [pow_zero, (squarefreeRootDivisorPart_multiplicative f Q a).map_one, one_mul,
        Nat.sub_zero, squarefreeRootCount_mul_cutoff_prime_pow f Q a p k hp hpa]
    · intro j hj hj0
      have hnot : ¬p^j ∣ a := by
        intro h
        have hpj : p ∣ p^j := by simpa using pow_dvd_pow p (show 1 ≤ j by omega)
        exact hpa (hpj.trans h)
      simp [squarefreeRootDivisorPart, hnot]
    · simp

noncomputable def squarefreeRootDivisorFactor (f : ℤ[X]) (Q a : ℕ) : ℝ :=
  ∑ b ∈ a.divisors, squarefreeRootCount f Q b / (b:ℝ)

lemma squarefreeRootDivisorFactor_ge_one (f : ℤ[X]) (Q a : ℕ) (ha : a ≠ 0) :
    1 ≤ squarefreeRootDivisorFactor f Q a := by
  have hs := Finset.single_le_sum (s := a.divisors)
    (f := fun b : ℕ ↦ squarefreeRootCount f Q b / (b:ℝ))
    (fun b _ ↦ div_nonneg (squarefreeRootCount_nonneg f Q b) (Nat.cast_nonneg b))
    (Nat.mem_divisors.mpr ⟨one_dvd a, ha⟩)
  simpa only [(squarefreeRootCount_multiplicative f Q).map_one, Nat.cast_one, div_one] using hs

lemma squarefreeRootDivisorPart_harmonic_le (f : ℤ[X]) (Q a N : ℕ) (ha : a ≠ 0) :
    harmonicWeightSum (squarefreeRootDivisorPart f Q a) N ≤ squarefreeRootDivisorFactor f Q a := by
  unfold harmonicWeightSum squarefreeRootDivisorPart
  simp only [ArithmeticFunction.coe_mk, ite_div, zero_div]
  rw [← Finset.sum_filter]
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro b hb
    exact Nat.mem_divisors.mpr ⟨(Finset.mem_filter.mp hb).2, ha⟩
  · intro b hb hnot
    exact div_nonneg (squarefreeRootCount_nonneg f Q b) (Nat.cast_nonneg b)

lemma squarefreeRootCount_harmonic_remove_primes (f : ℤ[X]) (Q a N : ℕ) (ha : a ≠ 0) :
    harmonicWeightSum (squarefreeRootCount f Q) N ≤
      squarefreeRootDivisorFactor f Q a * harmonicWeightSum (squarefreeRootCount f (Q*a)) N := by
  rw [← squarefreeRootDivisorPart_mul_cutoff f Q a, harmonicWeightSum_convolution]
  calc
    _ ≤ ∑ b ∈ Finset.Icc 1 N, squarefreeRootDivisorPart f Q a b / b *
        harmonicWeightSum (squarefreeRootCount f (Q*a)) N := by
      apply Finset.sum_le_sum
      intro b hb
      apply mul_le_mul_of_nonneg_left
        (harmonicWeightSum_mono _ (squarefreeRootCount_nonneg f (Q*a)) (Nat.div_le_self N b))
        (div_nonneg (squarefreeRootDivisorPart_nonneg f Q a b) (Nat.cast_nonneg b))
    _ = harmonicWeightSum (squarefreeRootDivisorPart f Q a) N *
        harmonicWeightSum (squarefreeRootCount f (Q*a)) N := by rw [← Finset.sum_mul]; rfl
    _ ≤ _ := mul_le_mul_of_nonneg_right (squarefreeRootDivisorPart_harmonic_le f Q a N ha)
      (harmonicWeightSum_nonneg _ (squarefreeRootCount_nonneg f (Q*a)) N)


lemma polynomialSieveProduct_density_bounds_mul_bad (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (a D p : ℕ) (hp : p.Prime)
    (hpd : p ∣ polynomialSieveProduct f (polynomialSieveBadProduct f * a) D) :
    0 < polynomialRootDensity f p ∧ polynomialRootDensity f p < 1 := by
  have hmem : p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D := by
    rw [← polynomialSieveProduct_primeFactors]
    exact Nat.mem_primeFactors.mpr ⟨hp, hpd,
      (polynomialSieveProduct_squarefree f (polynomialSieveBadProduct f * a) D).ne_zero⟩
  obtain ⟨_, _, hbad, hroot⟩ := (mem_polynomialSievePrimes _ _ _ _).mp hmem
  refine ⟨?_, polynomialRootDensity_lt_one_of_not_dvd_badProduct f hdeg p hp
    (fun h ↦ hbad (dvd_mul_of_dvd_left h _))⟩
  change 0 < (polynomialRootCount f p:ℝ) / (p:ℝ)
  exact div_pos (by exact_mod_cast hroot) (by exact_mod_cast hp.pos)

lemma polynomial_restricted_rough_count_log_sieve (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ A > (0:ℝ), ∃ D₀ : ℕ, ∀ a D N : ℕ, 0 < a → D₀ ≤ D →
      (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ) ∧
        ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
          ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
        A * N * (polynomialRootResidues f a).card *
          squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) a / (a * log D) +
            (polynomialRootResidues f a).card * (D:ℝ)^4 := by
  let Q := polynomialSieveBadProduct f
  obtain ⟨c, hc, hH⟩ := squarefreeRootCount_harmonic_eventual_lower f hdeg hirr Q
    (polynomialSieveBadProduct_ne_zero f hdeg hirr)
  obtain ⟨D₀, hD₀⟩ := eventually_atTop.mp hH
  refine ⟨c⁻¹, inv_pos.mpr hc, max 2 D₀, ?_⟩
  intro a D N ha hD
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have hlog : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < D by omega))
  let P := polynomialSieveProduct f (Q*a) D
  let F := squarefreeRootDivisorFactor f Q a
  let G := selbergDenominator (polynomialRootDensity f) P D
  have hP : Squarefree P := polynomialSieveProduct_squarefree f (Q*a) D
  have haP : a.Coprime P :=
    ((polynomialSieveProduct_coprime f (Q*a) D).of_dvd_right (dvd_mul_left a Q)).symm
  have hν := polynomialSieveProduct_density_bounds_mul_bad f hdeg a D
  have hFG : c*log D ≤ F*G := by
    apply (hD₀ D hDD).trans
    apply (squarefreeRootCount_harmonic_remove_primes f Q a D ha.ne').trans
    apply mul_le_mul_of_nonneg_left _ (zero_le_one.trans
      (squarefreeRootDivisorFactor_ge_one f Q a ha.ne'))
    rw [squarefreeRootCount_harmonic_eq_sieve_sum]
    exact polynomial_selberg_denominator_lower f P hP hν D
  have hFpos : 0 < F := zero_lt_one.trans_le (squarefreeRootDivisorFactor_ge_one f Q a ha.ne')
  have hlower : c*log D/F ≤ G := (div_le_iff₀ hFpos).mpr (by simpa only [mul_comm] using hFG)
  have haR : (0:ℝ) < a := by exact_mod_cast ha
  have hlowpos : 0 < c*log D/F := div_pos (mul_pos hc hlog) hFpos
  have hcount := polynomial_restricted_rough_count_le_selberg f a P ha hP haP hν D N (by omega)
  rw [polynomialSieveProduct_primeFactors] at hcount
  calc
    _ ≤ (N:ℝ) * (polynomialRootResidues f a).card / (a * G) +
        (polynomialRootResidues f a).card * (D:ℝ)^4 := hcount
    _ ≤ (N:ℝ) * (polynomialRootResidues f a).card / (a * (c*log D/F)) +
        (polynomialRootResidues f a).card * (D:ℝ)^4 := by
      apply add_le_add _ le_rfl
      exact div_le_div_of_nonneg_left (by positivity) (mul_pos haR hlowpos)
        (mul_le_mul_of_nonneg_left hlower haR.le)
    _ = _ := by
      change (N:ℝ) * (polynomialRootResidues f a).card / (a * (c*log D/F)) +
        (polynomialRootResidues f a).card * (D:ℝ)^4 =
        c⁻¹*N*(polynomialRootResidues f a).card*F/(a*log D) +
          (polynomialRootResidues f a).card*(D:ℝ)^4
      field_simp


lemma polynomialRootCount_pos_of_dvd (f : ℤ[X]) (a b : ℕ) (ha : 0 < a) (hab : a ∣ b)
    (hb : 0 < polynomialRootCount f b) : 0 < polynomialRootCount f a := by
  change 0 < (polynomialRootResidues f b).card at hb
  change 0 < (polynomialRootResidues f a).card
  obtain ⟨r, hr⟩ := Finset.card_pos.mp hb
  apply Finset.card_pos.mpr
  refine ⟨r % a, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.mod_lt r ha), ?_⟩⟩
  apply (dvd_eval_mod_iff f a r).mp
  exact (Int.natCast_dvd_natCast.mpr hab).trans (Finset.mem_filter.mp hr).2

lemma polynomialRootCount_convolution_square_nonneg (f : ℤ[X]) (n : ℕ) :
    0 ≤ ((polynomialRootCount f : ArithmeticFunction ℝ)^2) n := by
  rw [pow_two, ArithmeticFunction.mul_apply]
  exact Finset.sum_nonneg (fun _ _ ↦ mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))

lemma polynomialRootCount_tau_prime_pow_good (f : ℤ[X]) (p : ℕ) (hp : p.Prime)
    (hstable : ∀ j : ℕ, polynomialRootCount f (p^(j+1)) = polynomialRootCount f p) (k : ℕ) :
    (polynomialRootCount f (p^k):ℝ) * (k+1:ℝ) ≤
      ((polynomialRootCount f : ArithmeticFunction ℝ)^2) (p^k) := by
  let u : ArithmeticFunction ℝ := polynomialRootCount f
  have hu : u.IsMultiplicative := (polynomialRootCount_multiplicative f).natCast
  have hstable' : ∀ j : ℕ, j ≠ 0 → u (p^j) = u p := by
    intro j hj
    change (polynomialRootCount f (p^j):ℝ) = (polynomialRootCount f p:ℝ)
    exact_mod_cast (by simpa only [Nat.sub_add_cancel (show 1 ≤ j by omega)] using hstable (j-1))
  change u (p^k) * (k+1:ℝ) ≤ (u^2) (p^k)
  rw [pow_two, convolution_prime_pow _ _ p k hp]
  calc
    _ = ∑ _j ∈ Finset.range (k+1), u (p^k) := by simp; ring
    _ ≤ _ := by
      apply Finset.sum_le_sum
      intro j hj
      have hjk : j ≤ k := by simpa using Finset.mem_range.mp hj
      by_cases hj0 : j = 0
      · simp [hj0, hu.map_one]
      by_cases hjk0 : k-j = 0
      · have he : j = k := by omega
        simp [he, hu.map_one]
      rw [hstable' k (by omega), hstable' j hj0, hstable' (k-j) hjk0]
      change (polynomialRootCount f p:ℝ) ≤
        (polynomialRootCount f p:ℝ)*(polynomialRootCount f p:ℝ)
      exact_mod_cast Nat.le_mul_self (polynomialRootCount f p)

lemma polynomialRootCount_tau_prime_pow_bounded (f : ℤ[X]) (p : ℕ) (hp : p.Prime)
    (B : ℕ) (hB : ∀ k : ℕ, polynomialRootCount f (p^k) ≤ B) (k : ℕ) :
    (polynomialRootCount f (p^k):ℝ) * (k+1:ℝ) ≤
      (B:ℝ) * ((polynomialRootCount f : ArithmeticFunction ℝ)^2) (p^k) := by
  by_cases hr : polynomialRootCount f (p^k) = 0
  · rw [hr, Nat.cast_zero, zero_mul]
    exact mul_nonneg (Nat.cast_nonneg _) (polynomialRootCount_convolution_square_nonneg f _)
  have hroot : ∀ j : ℕ, j ≤ k → (1:ℝ) ≤ (polynomialRootCount f (p^j):ℝ) := by
    intro j hj
    exact_mod_cast polynomialRootCount_pos_of_dvd f (p^j) (p^k) (pow_pos hp.pos j)
      (pow_dvd_pow p hj) (Nat.pos_of_ne_zero hr)
  have hconv : (k+1:ℝ) ≤ ((polynomialRootCount f : ArithmeticFunction ℝ)^2) (p^k) := by
    rw [pow_two, convolution_prime_pow _ _ p k hp]
    calc
      _ = ∑ _j ∈ Finset.range (k+1), (1:ℝ) := by simp
      _ ≤ _ := by
        apply Finset.sum_le_sum
        intro j hj
        have hjk : j ≤ k := by simpa using Finset.mem_range.mp hj
        have hmul := mul_le_mul (hroot j hjk) (hroot (k-j) (Nat.sub_le _ _))
          (by norm_num : (0:ℝ) ≤ 1) (by positivity : (0:ℝ) ≤ (polynomialRootCount f (p^j):ℝ))
        simpa only [one_mul] using hmul
  calc
    _ ≤ (B:ℝ)*(k+1:ℝ) := mul_le_mul_of_nonneg_right (by exact_mod_cast hB k) (by positivity)
    _ ≤ _ := mul_le_mul_of_nonneg_left hconv (Nat.cast_nonneg _)

lemma polynomialRootCount_tau_le_convolution_square (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ n : ℕ,
      (polynomialRootCount f n:ℝ) * (σ 0 n:ℝ) ≤
        C * ((polynomialRootCount f : ArithmeticFunction ℝ)^2) n := by
  let u : ArithmeticFunction ℝ := polynomialRootCount f
  let t : ArithmeticFunction ℝ := σ 0
  have hu : u.IsMultiplicative := (polynomialRootCount_multiplicative f).natCast
  have ht : t.IsMultiplicative := ArithmeticFunction.isMultiplicative_sigma.natCast
  have hv : (u^2).IsMultiplicative := by simpa only [pow_two] using hu.mul hu
  have hres := resultant_derivative_ne_zero_of_irreducible f hdeg hirr
  let R := (f.resultant f.derivative).natAbs
  have hR : R ≠ 0 := Int.natAbs_ne_zero.mpr hres
  have hbound : ∀ p : ℕ, ∃ B : ℕ, 1 ≤ B ∧
      (p.Prime → ∀ k : ℕ, polynomialRootCount f (p^k) ≤ B) := by
    intro p
    by_cases hp : p.Prime
    · obtain ⟨B, hB⟩ := exists_bound_prime_pow_rootResidues_of_resultant_ne_zero f hdeg hres p hp
      refine ⟨max 1 B, le_max_left _ _, fun _ k ↦ (hB k).trans (le_max_right _ _)⟩
    · exact ⟨1, le_rfl, fun h ↦ (hp h).elim⟩
  choose B hB1 hB using hbound
  let C : ℝ := ∏ p ∈ R.primeFactors, (B p:ℝ)
  have hC : 0 < C := Finset.prod_pos (fun p _ ↦ by exact_mod_cast zero_lt_one.trans_le (hB1 p))
  have hlocal : ∀ p : ℕ, p.Prime → ∀ k : ℕ,
      u (p^k)*t (p^k) ≤ (if p ∈ R.primeFactors then (B p:ℝ) else 1) * (u^2) (p^k) := by
    intro p hp k
    have hτ : t (p^k) = (k+1:ℝ) := by
      change (σ 0 (p^k):ℝ) = _
      rw [ArithmeticFunction.sigma_zero_apply_prime_pow hp]
      push_cast
      rfl
    rw [hτ]
    by_cases hpr : p ∈ R.primeFactors
    · rw [if_pos hpr]
      exact polynomialRootCount_tau_prime_pow_bounded f p hp (B p) (hB p hp) k
    · rw [if_neg hpr, one_mul]
      apply polynomialRootCount_tau_prime_pow_good f p hp _ k
      intro j
      haveI : Fact p.Prime := ⟨hp⟩
      apply rootResidues_prime_pow_of_not_dvd_resultant f hdeg p j
      intro hd
      apply hpr
      exact Nat.mem_primeFactors.mpr ⟨hp,
        by simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hd, hR⟩
  refine ⟨C, hC, fun n ↦ ?_⟩
  change u n*t n ≤ C*(u^2) n
  by_cases hn : n = 0
  · simp [hn]
  have hprod : (∏ p ∈ n.primeFactors, if p ∈ R.primeFactors then (B p:ℝ) else 1) ≤ C := by
    rw [Finset.prod_ite]
    simp only [Finset.prod_const_one, mul_one]
    have hb : (∏ p ∈ n.primeFactors.filter (fun p ↦ p ∈ R.primeFactors), B p) ≤
        ∏ p ∈ R.primeFactors, B p := by
      apply Finset.prod_le_prod_of_subset_of_one_le'
      · intro p hp
        exact (Finset.mem_filter.mp hp).2
      · intro p hp hnot
        exact hB1 p
    change (∏ p ∈ n.primeFactors.filter (fun p ↦ p ∈ R.primeFactors), (B p:ℝ)) ≤
      ∏ p ∈ R.primeFactors, (B p:ℝ)
    exact_mod_cast hb

  rw [ArithmeticFunction.IsMultiplicative.multiplicative_factorization u hu hn,
    ArithmeticFunction.IsMultiplicative.multiplicative_factorization t ht hn,
    ArithmeticFunction.IsMultiplicative.multiplicative_factorization (u^2) hv hn]
  simp only [Finsupp.prod, Nat.support_factorization]
  rw [← Finset.prod_mul_distrib]
  calc
    _ ≤ ∏ p ∈ n.primeFactors,
        (if p ∈ R.primeFactors then (B p:ℝ) else 1) * (u^2) (p^n.factorization p) := by
      apply Finset.prod_le_prod
      · intro p hp
        exact mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
      · intro p hp
        exact hlocal p (Nat.prime_of_mem_primeFactors hp) _
    _ = (∏ p ∈ n.primeFactors, if p ∈ R.primeFactors then (B p:ℝ) else 1) *
        ∏ p ∈ n.primeFactors, (u^2) (p^n.factorization p) := Finset.prod_mul_distrib
    _ ≤ _ := mul_le_mul_of_nonneg_right hprod (Finset.prod_nonneg (fun p _ ↦
      polynomialRootCount_convolution_square_nonneg f _))


lemma harmonicWeightSum_convolution_le (u v : ArithmeticFunction ℝ)
    (hu : ∀ n, 0 ≤ u n) (hv : ∀ n, 0 ≤ v n) (N : ℕ) :
    harmonicWeightSum (u*v : ArithmeticFunction ℝ) N ≤
      harmonicWeightSum u N * harmonicWeightSum v N := by
  rw [harmonicWeightSum_convolution]
  calc
    _ ≤ ∑ a ∈ Finset.Icc 1 N, u a / a * harmonicWeightSum v N := by
      apply Finset.sum_le_sum
      intro a ha
      exact mul_le_mul_of_nonneg_left (harmonicWeightSum_mono v hv (Nat.div_le_self N a))
        (div_nonneg (hu a) (Nat.cast_nonneg _))
    _ = _ := by rw [← Finset.sum_mul]; rfl

lemma summatoryWeightSum_convolution_le (u v : ArithmeticFunction ℝ)
    (hu : ∀ n, 0 ≤ u n) (B : ℝ) (hB : 0 ≤ B)
    (hv : ∀ N, summatoryWeightSum v N ≤ B*N) (N : ℕ) :
    summatoryWeightSum (u*v : ArithmeticFunction ℝ) N ≤
      B*N*harmonicWeightSum u N := by
  rw [summatoryWeightSum_convolution]
  calc
    _ ≤ ∑ a ∈ Finset.Icc 1 N, u a * (B * ((N/a:ℕ):ℝ)) :=
      Finset.sum_le_sum (fun a _ ↦ mul_le_mul_of_nonneg_left (hv (N/a)) (hu a))
    _ ≤ ∑ a ∈ Finset.Icc 1 N, u a * (B * ((N:ℝ)/a)) := by
      apply Finset.sum_le_sum
      intro a ha
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left Nat.cast_div_le hB) (hu a)
    _ = _ := by
      unfold harmonicWeightSum
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a ha
      ring

lemma polynomialRootCount_harmonic_eventual_upper (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ B > (0:ℝ), ∀ᶠ N : ℕ in atTop,
      harmonicWeightSum (polynomialRootCount f : ArithmeticFunction ℝ) N ≤ B*log N := by
  obtain ⟨κ, hκ, hH⟩ := polynomialRootCount_positive_harmonic_limit f hdeg hirr
  refine ⟨κ+1, by linarith, ?_⟩
  filter_upwards [hH.eventually_le_const (show κ < κ+1 by linarith), eventually_gt_atTop (1:ℕ)]
    with N hN hN1
  exact (div_le_iff₀ (Real.log_pos (by exact_mod_cast hN1))).mp hN

lemma polynomialRootCount_tau_harmonic_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ᶠ N : ℕ in atTop,
      (∑ n ∈ Finset.Icc 1 N, (polynomialRootCount f n:ℝ)*(σ 0 n:ℝ)/n) ≤ C*(log N)^2 := by
  obtain ⟨A, hA, hpoint⟩ := polynomialRootCount_tau_le_convolution_square f hdeg hirr
  obtain ⟨B, hB, hH⟩ := polynomialRootCount_harmonic_eventual_upper f hdeg hirr
  refine ⟨A*B^2, by positivity, ?_⟩
  filter_upwards [hH, eventually_ge_atTop (1:ℕ)] with N hN hN1
  let u : ArithmeticFunction ℝ := polynomialRootCount f
  have hu : ∀ n, 0 ≤ u n := fun _ ↦ Nat.cast_nonneg _
  have hHN := harmonicWeightSum_nonneg u hu N
  calc
    _ ≤ ∑ n ∈ Finset.Icc 1 N, A*(u^2) n/n :=
      Finset.sum_le_sum (fun n hn ↦ div_le_div_of_nonneg_right (hpoint n) (Nat.cast_nonneg _))
    _ = A * harmonicWeightSum (u^2 : ArithmeticFunction ℝ) N := by
      unfold harmonicWeightSum
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      ring
    _ ≤ A * (harmonicWeightSum u N)^2 := by
      apply mul_le_mul_of_nonneg_left _ hA.le
      simpa only [pow_two] using harmonicWeightSum_convolution_le u u hu hu N
    _ ≤ A * (B*log N)^2 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hHN hN 2) hA.le
    _ = _ := by ring

lemma polynomialRootCount_tau_summatory_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ᶠ N : ℕ in atTop,
      (∑ n ∈ Finset.Icc 1 N, (polynomialRootCount f n:ℝ)*(σ 0 n:ℝ)) ≤ C*N*log N := by
  obtain ⟨A, hA, hpoint⟩ := polynomialRootCount_tau_le_convolution_square f hdeg hirr
  obtain ⟨B, hB, hH⟩ := polynomialRootCount_harmonic_eventual_upper f hdeg hirr
  obtain ⟨M, hM, hmean⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  refine ⟨A*(M+1)*B, by positivity, ?_⟩
  filter_upwards [hH] with N hN
  let u : ArithmeticFunction ℝ := polynomialRootCount f
  have hu : ∀ n, 0 ≤ u n := fun _ ↦ Nat.cast_nonneg _
  have hmean' : ∀ N, summatoryWeightSum u N ≤ (M+1)*N := by
    intro N
    exact (hmean N).trans (by nlinarith [Nat.cast_nonneg (α := ℝ) N])
  calc
    _ ≤ ∑ n ∈ Finset.Icc 1 N, A*(u^2) n := Finset.sum_le_sum (fun n _ ↦ hpoint n)
    _ = A * summatoryWeightSum (u^2 : ArithmeticFunction ℝ) N := (Finset.mul_sum ..).symm
    _ ≤ A * ((M+1)*N*harmonicWeightSum u N) := by
      apply mul_le_mul_of_nonneg_left _ hA.le
      simpa only [pow_two] using summatoryWeightSum_convolution_le u u hu (M+1) (by positivity) hmean' N
    _ ≤ A * ((M+1)*N*(B*log N)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hN (by positivity)) hA.le
    _ = _ := by ring


noncomputable def arithmeticHarmonicWeight (u : ArithmeticFunction ℝ) : ArithmeticFunction ℝ where
  toFun n := u n / (n:ℝ)
  map_zero' := by simp

lemma arithmeticHarmonicWeight_multiplicative (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) :
    (arithmeticHarmonicWeight u).IsMultiplicative := by
  constructor
  · simp [arithmeticHarmonicWeight, hu.map_one]
  · intro m n hmn
    simp only [arithmeticHarmonicWeight, ArithmeticFunction.coe_mk,
      hu.map_mul_of_coprime hmn, Nat.cast_mul, div_mul_div_comm]

noncomputable def squarefreeRootDivisorArithmetic (f : ℤ[X]) (Q : ℕ) : ArithmeticFunction ℝ :=
  arithmeticHarmonicWeight (squarefreeRootCount f Q) * ArithmeticFunction.zeta

lemma squarefreeRootDivisorArithmetic_apply (f : ℤ[X]) (Q n : ℕ) :
    squarefreeRootDivisorArithmetic f Q n = squarefreeRootDivisorFactor f Q n := by
  rw [squarefreeRootDivisorArithmetic, ArithmeticFunction.coe_mul_zeta_apply]
  rfl

lemma squarefreeRootDivisorArithmetic_multiplicative (f : ℤ[X]) (Q : ℕ) :
    (squarefreeRootDivisorArithmetic f Q).IsMultiplicative :=
  (arithmeticHarmonicWeight_multiplicative _ (squarefreeRootCount_multiplicative f Q)).mul
    ArithmeticFunction.isMultiplicative_zeta.natCast

lemma squarefreeRootDivisorFactor_prime_pow (f : ℤ[X]) (Q p k : ℕ) (hp : p.Prime) :
    squarefreeRootDivisorFactor f Q (p^(k+1)) = 1 + squarefreeRootCount f Q p / (p:ℝ) := by
  induction k with
  | zero =>
    rw [squarefreeRootDivisorFactor, Nat.sum_divisors_prime_pow hp]
    norm_num [Finset.sum_range_succ, (squarefreeRootCount_multiplicative f Q).map_one]
  | succ k ih =>
    simp only [squarefreeRootDivisorFactor, Nat.sum_divisors_prime_pow hp] at ih ⊢
    rw [Finset.sum_range_succ,
      squarefreeRootCount_prime_pow_eq_zero f Q p (k+2) hp (by omega), zero_div, add_zero]
    exact ih

noncomputable def rootSieveCorrection (f : ℤ[X]) (Q : ℕ) : ArithmeticFunction ℝ :=
  multiplicativeExtension (fun p k ↦ if k = 0 then 1 else if k = 1 then
    2 * (squarefreeRootCount f Q p)^2 / (p:ℝ) else 0)

lemma rootSieveCorrection_multiplicative (f : ℤ[X]) (Q : ℕ) :
    (rootSieveCorrection f Q).IsMultiplicative := multiplicativeExtension_multiplicative _

lemma rootSieveCorrection_prime_pow (f : ℤ[X]) (Q p k : ℕ) (hp : p.Prime) :
    rootSieveCorrection f Q (p^k) =
      if k = 0 then 1 else if k = 1 then 2*(squarefreeRootCount f Q p)^2/(p:ℝ) else 0 :=
  multiplicativeExtension_prime_pow _ p k hp (by simp)

lemma rootSieveCorrection_nonneg (f : ℤ[X]) (Q n : ℕ) : 0 ≤ rootSieveCorrection f Q n := by
  unfold rootSieveCorrection multiplicativeExtension
  simp only [ArithmeticFunction.coe_mk]
  split_ifs
  · exact le_rfl
  · simp only [Finsupp.prod]
    apply Finset.prod_nonneg
    intro p hp
    split_ifs <;> positivity

lemma squarefreeRootCount_prime_le_degree (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p : ℕ) (hp : p.Prime) : squarefreeRootCount f (polynomialSieveBadProduct f) p ≤ f.natDegree := by
  rw [squarefreeRootCount_prime f (polynomialSieveBadProduct f) p hp]
  split_ifs with hbad
  · exact Nat.cast_nonneg _
  · haveI : Fact p.Prime := ⟨hp⟩
    have hres : ¬(p:ℤ) ∣ f.resultant f.derivative := by
      intro hd
      apply hbad
      apply dvd_mul_of_dvd_right
      simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hd
    exact_mod_cast rootResidues_prime_le_natDegree_of_simple f p
      (simple_roots_of_not_dvd_resultant f hdeg p hres)

lemma rootSieveCorrection_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) :
    Summable (fun n : ℕ ↦ ‖rootSieveCorrection f (polynomialSieveBadProduct f) n / (n:ℝ)‖) := by
  let Q := polynomialSieveBadProduct f
  let w := rootSieveCorrection f Q
  let C : ℕ → ℝ := fun p ↦ 2*(f.natDegree:ℝ)^2/(p:ℝ)^2
  have hw1 : w 1 = 1 := (rootSieveCorrection_multiplicative f Q).map_one
  have hsC : Summable C := by
    simpa only [C, div_eq_mul_inv] using
      (Real.summable_nat_pow_inv.mpr (by norm_num : 1 < (2:ℕ))).mul_left (2*(f.natDegree:ℝ)^2)
  have hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ |w (p^k)/(p:ℝ)^k|) := by
    intro p hp
    apply summable_of_ne_finset_zero (s := Finset.range 2)
    intro k hk
    have hk2 : 2 ≤ k := by simpa using hk
    simp [w, rootSieveCorrection_prime_pow f Q p k hp, show k ≠ 0 by omega, show k ≠ 1 by omega]
  apply summable_weighted_multiplicative_of_local_bound w (rootSieveCorrection_multiplicative f Q)
    C hsC (fun _ ↦ by dsimp [C]; positivity) hlocal
  intro p hp
  rw [tsum_eq_sum (s := Finset.range 2) ?_]
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero,
      hw1, div_one, abs_one, pow_one]
    rw [show w p = 2*(squarefreeRootCount f Q p)^2/(p:ℝ) by
      simpa only [pow_one] using rootSieveCorrection_prime_pow f Q p 1 hp]
    rw [abs_of_nonneg (by positivity)]
    apply add_le_add le_rfl
    dsimp [C]
    rw [div_div, ← pow_two]
    apply div_le_div_of_nonneg_right _ (by positivity)
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (squarefreeRootCount_nonneg f Q p)
      (squarefreeRootCount_prime_le_degree f hdeg p hp) 2) (by norm_num)
  · intro k hk
    have hk2 : 2 ≤ k := by simpa using hk
    simp [w, rootSieveCorrection_prime_pow f Q p k hp, show k ≠ 0 by omega, show k ≠ 1 by omega]

lemma convolution_prime_pow_of_left_linear (u v : ArithmeticFunction ℝ) (p : ℕ) (hp : p.Prime)
    (hu1 : u 1 = 1) (hu : ∀ k : ℕ, 2 ≤ k → u (p^k) = 0) (k : ℕ) :
    (u*v) (p^(k+1)) = v (p^(k+1)) + u p * v (p^k) := by
  rw [convolution_prime_pow _ _ p (k+1) hp, Finset.sum_range_succ']
  rw [Finset.sum_eq_single 0]
  · simp only [zero_add, pow_one, Nat.add_sub_cancel, pow_zero, hu1, Nat.sub_zero, one_mul]
    ring
  · intro j hj hj0
    rw [hu (j+1) (by omega), zero_mul]
  · simp

lemma multiplicative_le_of_prime_powers (u v : ArithmeticFunction ℝ)
    (hu : u.IsMultiplicative) (hv : v.IsMultiplicative) (hu0 : ∀ n, 0 ≤ u n)
    (hle : ∀ p : ℕ, p.Prime → ∀ k : ℕ, u (p^k) ≤ v (p^k)) : ∀ n, u n ≤ v n := by
  intro n
  by_cases hn : n = 0
  · simp [hn]
  rw [ArithmeticFunction.IsMultiplicative.multiplicative_factorization u hu hn,
    ArithmeticFunction.IsMultiplicative.multiplicative_factorization v hv hn]
  simp only [Finsupp.prod, Nat.support_factorization]
  exact Finset.prod_le_prod (fun p _ ↦ hu0 _) (fun p hp ↦ hle p (Nat.prime_of_mem_primeFactors hp) _)


noncomputable def polynomialRootTau (f : ℤ[X]) : ArithmeticFunction ℝ :=
  (polynomialRootCount f : ArithmeticFunction ℝ).pmul (σ 0 : ArithmeticFunction ℝ)

lemma polynomialRootTau_apply (f : ℤ[X]) (n : ℕ) :
    polynomialRootTau f n = (polynomialRootCount f n:ℝ)*(σ 0 n:ℝ) := rfl

lemma polynomialRootTau_nonneg (f : ℤ[X]) (n : ℕ) : 0 ≤ polynomialRootTau f n := by
  rw [polynomialRootTau_apply]
  positivity

lemma polynomialRootTau_multiplicative (f : ℤ[X]) : (polynomialRootTau f).IsMultiplicative :=
  (polynomialRootCount_multiplicative f).natCast.pmul ArithmeticFunction.isMultiplicative_sigma.natCast

lemma polynomialRootTau_prime_pow (f : ℤ[X]) (p k : ℕ) (hp : p.Prime) :
    polynomialRootTau f (p^k) = (polynomialRootCount f (p^k):ℝ)*(k+1:ℝ) := by
  rw [polynomialRootTau_apply, ArithmeticFunction.sigma_zero_apply_prime_pow hp, Nat.cast_add, Nat.cast_one]

lemma polynomialRootTau_sieve_prime_pow (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (p k : ℕ) (hp : p.Prime) :
    polynomialRootTau f (p^k) * squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) (p^k) ≤
      (rootSieveCorrection f (polynomialSieveBadProduct f) * polynomialRootTau f) (p^k) := by
  let Q := polynomialSieveBadProduct f
  let v := polynomialRootTau f
  let w := rootSieveCorrection f Q
  have hv1 : v 1 = 1 := (polynomialRootTau_multiplicative f).map_one
  have hw1 : w 1 = 1 := (rootSieveCorrection_multiplicative f Q).map_one
  have hF1 : squarefreeRootDivisorFactor f Q 1 = 1 := by
    rw [← squarefreeRootDivisorArithmetic_apply]
    exact (squarefreeRootDivisorArithmetic_multiplicative f Q).map_one
  change v (p^k) * squarefreeRootDivisorFactor f Q (p^k) ≤ (w*v) (p^k)
  cases k with
  | zero => simp [hv1, hw1, hF1]
  | succ k =>
    rw [squarefreeRootDivisorFactor_prime_pow f Q p k hp,
      convolution_prime_pow_of_left_linear w v p hp hw1 (by
        intro j hj
        simp [w, rootSieveCorrection_prime_pow f Q p j hp, show j ≠ 0 by omega, show j ≠ 1 by omega]) k]
    have hwp : w p = 2*(squarefreeRootCount f Q p)^2/(p:ℝ) := by
      simpa only [pow_one] using rootSieveCorrection_prime_pow f Q p 1 hp
    rw [hwp, squarefreeRootCount_prime f Q p hp]
    by_cases hpQ : p ∣ Q
    · simp [hpQ]
    rw [if_neg hpQ]
    haveI : Fact p.Prime := ⟨hp⟩
    have hres : ¬(p:ℤ) ∣ f.resultant f.derivative := by
      intro hd
      apply hpQ
      apply dvd_mul_of_dvd_right
      simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hd
    let r : ℝ := polynomialRootCount f p
    have hvval : ∀ j : ℕ, v (p^(j+1)) = r*(j+2:ℝ) := by
      intro j
      rw [polynomialRootTau_prime_pow f p (j+1) hp]
      have he : polynomialRootCount f (p^(j+1)) = polynomialRootCount f p :=
        rootResidues_prime_pow_of_not_dvd_resultant f hdeg p j hres
      rw [he]
      push_cast
      ring
    change v (p^(k+1)) * (1+r/(p:ℝ)) ≤ v (p^(k+1)) + (2*r^2/(p:ℝ))*v (p^k)
    cases k with
    | zero =>
      rw [hvval 0, pow_zero, hv1]
      norm_num
      ring_nf
      exact le_rfl
    | succ k =>
      rw [hvval (k+1), hvval k]
      push_cast
      by_cases hr0 : polynomialRootCount f p = 0
      · have hr : r = 0 := by simp [r, hr0]
        simp [hr]
      have hr1 : (1:ℝ) ≤ r := by
        change (1:ℝ) ≤ (polynomialRootCount f p:ℝ)
        exact_mod_cast (show 1 ≤ polynomialRootCount f p from Nat.pos_of_ne_zero hr0)
      have hfac : (k:ℝ)+1+2 ≤ 2*((k:ℝ)+2)*r := by
        have hm := mul_le_mul_of_nonneg_left hr1 (show 0 ≤ 2*((k:ℝ)+2) by positivity)
        nlinarith [Nat.cast_nonneg (α := ℝ) k]
      have hpoly : ((k:ℝ)+1+2)*r^2 ≤ 2*((k:ℝ)+2)*r^3 := by
        nlinarith [mul_le_mul_of_nonneg_right hfac (sq_nonneg r)]
      calc
        _ = r*((k:ℝ)+1+2) + (((k:ℝ)+1+2)*r^2)/(p:ℝ) := by ring
        _ ≤ r*((k:ℝ)+1+2) + (2*((k:ℝ)+2)*r^3)/(p:ℝ) :=
          add_le_add le_rfl (div_le_div_of_nonneg_right hpoly (Nat.cast_nonneg p))
        _ = _ := by ring

lemma polynomialRootTau_sieve_le_convolution (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) (n : ℕ) :
    polynomialRootTau f n * squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) n ≤
      (rootSieveCorrection f (polynomialSieveBadProduct f) * polynomialRootTau f) n := by
  let Q := polynomialSieveBadProduct f
  have h := multiplicative_le_of_prime_powers
    ((polynomialRootTau f).pmul (squarefreeRootDivisorArithmetic f Q))
    (rootSieveCorrection f Q * polynomialRootTau f)
    ((polynomialRootTau_multiplicative f).pmul (squarefreeRootDivisorArithmetic_multiplicative f Q))
    ((rootSieveCorrection_multiplicative f Q).mul (polynomialRootTau_multiplicative f))
    (by
      intro m
      rw [ArithmeticFunction.pmul_apply, squarefreeRootDivisorArithmetic_apply]
      exact mul_nonneg (polynomialRootTau_nonneg f m)
        (Finset.sum_nonneg (fun b _ ↦ div_nonneg (squarefreeRootCount_nonneg f Q b) (Nat.cast_nonneg _))))
    (by
      intro p hp k
      rw [ArithmeticFunction.pmul_apply, squarefreeRootDivisorArithmetic_apply]
      exact polynomialRootTau_sieve_prime_pow f hdeg p k hp) n
  simpa only [ArithmeticFunction.pmul_apply, squarefreeRootDivisorArithmetic_apply] using h

lemma harmonicWeightSum_convolution_le_tsum (u v : ArithmeticFunction ℝ)
    (hu : ∀ n, 0 ≤ u n) (hv : ∀ n, 0 ≤ v n)
    (hs : Summable (fun n : ℕ ↦ u n/(n:ℝ))) (N : ℕ) :
    harmonicWeightSum (u*v : ArithmeticFunction ℝ) N ≤
      (∑' n : ℕ, u n/(n:ℝ)) * harmonicWeightSum v N := by
  apply (harmonicWeightSum_convolution_le u v hu hv N).trans
  apply mul_le_mul_of_nonneg_right _ (harmonicWeightSum_nonneg v hv N)
  exact hs.sum_le_tsum _ (fun n _ ↦ div_nonneg (hu n) (Nat.cast_nonneg _))

lemma polynomialRootTau_sieve_harmonic_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ᶠ N : ℕ in atTop,
      (∑ n ∈ Finset.Icc 1 N, (polynomialRootCount f n:ℝ)*(σ 0 n:ℝ)*
        squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) n/n) ≤ C*(log N)^2 := by
  obtain ⟨A, hA, hH⟩ := polynomialRootCount_tau_harmonic_bound f hdeg hirr
  let Q := polynomialSieveBadProduct f
  let w := rootSieveCorrection f Q
  let W := ∑' n : ℕ, w n/(n:ℝ)
  have hs : Summable (fun n : ℕ ↦ w n/(n:ℝ)) := (rootSieveCorrection_summable f hdeg).of_norm
  have hW : 1 ≤ W := by
    have hh := hs.le_tsum 1 (fun n _ ↦ div_nonneg (rootSieveCorrection_nonneg f Q n) (Nat.cast_nonneg _))
    have hw1 : w 1 = 1 := (rootSieveCorrection_multiplicative f Q).map_one
    simpa only [hw1, Nat.cast_one, div_one] using hh
  refine ⟨W*A, mul_pos (zero_lt_one.trans_le hW) hA, ?_⟩
  filter_upwards [hH] with N hN
  calc
    _ ≤ ∑ n ∈ Finset.Icc 1 N, (w*polynomialRootTau f) n/n := by
      apply Finset.sum_le_sum
      intro n hn
      exact div_le_div_of_nonneg_right (polynomialRootTau_sieve_le_convolution f hdeg n) (Nat.cast_nonneg n)
    _ = harmonicWeightSum (w*polynomialRootTau f : ArithmeticFunction ℝ) N := rfl
    _ ≤ W * harmonicWeightSum (polynomialRootTau f) N :=
      harmonicWeightSum_convolution_le_tsum w (polynomialRootTau f)
        (rootSieveCorrection_nonneg f Q) (polynomialRootTau_nonneg f) hs N
    _ ≤ W*(A*(log N)^2) := mul_le_mul_of_nonneg_left hN (zero_le_one.trans hW)
    _ = _ := by ring


/-- The weighted count of candidate small parts, with the remaining permitted primes sifted. -/
noncomputable def Erdos975SiftedSmallPartSum (f : ℤ[X]) (A D N : ℕ) : ℝ :=
  ∑ a ∈ Finset.Icc 1 A, (σ 0 a:ℝ) *
    (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ) ∧
      ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
        ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ)

lemma Erdos975SiftedSmallPartSum_swap (f : ℤ[X]) (A D N : ℕ) :
    Erdos975SiftedSmallPartSum f A D N =
      ∑ n ∈ Finset.range N, ∑ a ∈ Finset.Icc 1 A,
        if (a:ℤ) ∣ f.eval (n:ℤ) ∧
            (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
              ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
  unfold Erdos975SiftedSmallPartSum
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a ha
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]

lemma erdos975_sifted_small_part_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∃ A₀ D₀ : ℕ, ∀ A D N : ℕ, A₀ ≤ A → D₀ ≤ D →
      Erdos975SiftedSmallPartSum f A D N ≤
        C * ((N:ℝ)*(log A)^2/log D + A*log A*(D:ℝ)^4) := by
  obtain ⟨B, hB, D₀, hsieve⟩ := polynomial_restricted_rough_count_log_sieve f hdeg hirr
  obtain ⟨H, hH, hHbound⟩ := polynomialRootTau_sieve_harmonic_bound f hdeg hirr
  obtain ⟨E, hE, hEbound⟩ := polynomialRootCount_tau_summatory_bound f hdeg hirr
  obtain ⟨A₀, hA₀⟩ := eventually_atTop.mp (hHbound.and hEbound)
  refine ⟨B*H+E, by positivity, max 2 A₀, max 2 D₀, ?_⟩
  intro A D N hA hD
  have hA2 : 2 ≤ A := (le_max_left _ _).trans hA
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hAA : A₀ ≤ A := (le_max_right _ _).trans hA
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have hlogA : 0 ≤ log (A:ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ A by omega))
  have hlogD : 0 ≤ log (D:ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ D by omega))
  obtain ⟨hHA, hEA⟩ := hA₀ A hAA
  let F := squarefreeRootDivisorFactor f (polynomialSieveBadProduct f)
  have hraw : Erdos975SiftedSmallPartSum f A D N ≤
      (B*N/log D) * (∑ a ∈ Finset.Icc 1 A, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)*F a/a) +
        (D:ℝ)^4 * (∑ a ∈ Finset.Icc 1 A, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)) := by
    unfold Erdos975SiftedSmallPartSum
    calc
      _ ≤ ∑ a ∈ Finset.Icc 1 A, (σ 0 a:ℝ) *
          (B*N*(polynomialRootResidues f a).card*F a/(a*log D) +
            (polynomialRootResidues f a).card*(D:ℝ)^4) := by
        apply Finset.sum_le_sum
        intro a ha
        exact mul_le_mul_of_nonneg_left (hsieve a D N (Finset.mem_Icc.mp ha).1 hDD) (Nat.cast_nonneg _)
      _ = _ := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro a ha
        change (σ 0 a:ℝ) * (B*N*(polynomialRootCount f a:ℝ)*F a/(a*log D) +
          (polynomialRootCount f a:ℝ)*(D:ℝ)^4) = _
        ring
  calc
    _ ≤ (B*N/log D) * (∑ a ∈ Finset.Icc 1 A, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)*F a/a) +
        (D:ℝ)^4 * (∑ a ∈ Finset.Icc 1 A, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)) := hraw
    _ ≤ (B*N/log D)*(H*(log A)^2) + (D:ℝ)^4*(E*A*log A) :=
      add_le_add (mul_le_mul_of_nonneg_left hHA (by positivity))
        (mul_le_mul_of_nonneg_left hEA (by positivity))
    _ ≤ (B*H+E) * ((N:ℝ)*(log A)^2/log D + A*log A*(D:ℝ)^4) := by
      have hx : 0 ≤ (N:ℝ)*(log A)^2/log D := by positivity
      have hy : 0 ≤ (A:ℝ)*log A*(D:ℝ)^4 := by positivity
      have hh := add_nonneg (mul_nonneg hE.le hx) (mul_nonneg (mul_nonneg hB.le hH.le) hy)
      linear_combination hh

lemma erdos975_sifted_small_part_diagonal_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∃ D₀ : ℕ, ∀ D N : ℕ, D₀ ≤ D → D^5 ≤ N →
      Erdos975SiftedSmallPartSum f D D N ≤ C*N*log D := by
  obtain ⟨C, hC, A₀, D₀, hb⟩ := erdos975_sifted_small_part_bound f hdeg hirr
  refine ⟨2*C, by positivity, max 2 (max A₀ D₀), ?_⟩
  intro D N hD hDN
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDA : A₀ ≤ D := (le_max_left _ _).trans ((le_max_right _ _).trans hD)
  have hDD : D₀ ≤ D := (le_max_right _ _).trans ((le_max_right _ _).trans hD)
  have hlog : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < D by omega))
  have he : (D:ℝ)*log D*(D:ℝ)^4 ≤ (N:ℝ)*log D := by
    calc
      _ = (D:ℝ)^5*log D := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (by exact_mod_cast hDN) hlog.le
  calc
    _ ≤ C*((N:ℝ)*(log D)^2/log D + (D:ℝ)*log D*(D:ℝ)^4) := hb D D N hDA hDD
    _ = C*((N:ℝ)*log D + (D:ℝ)*log D*(D:ℝ)^4) := by
      field_simp
    _ ≤ C*((N:ℝ)*log D + (N:ℝ)*log D) :=
      mul_le_mul_of_nonneg_left (add_le_add le_rfl he) hC.le
    _ = _ := by ring


open scoped ArithmeticFunction.Omega

lemma sigma_zero_le_two_pow_cardFactors (n : ℕ) : σ 0 n ≤ 2^(Ω n) := by
  by_cases hn : n = 0
  · simp [hn]
  rw [ArithmeticFunction.sigma_zero_apply, Nat.card_divisors hn,
    ArithmeticFunction.cardFactors_eq_sum_factorization]
  simp only [Finsupp.sum, Nat.support_factorization]
  rw [← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_le_prod (fun _ _ ↦ Nat.zero_le _) (fun _ _ ↦ Nat.lt_two_pow_self)

lemma sigma_zero_rough_bound (n D k : ℕ) (hn : n ≠ 0) (hD : 2 ≤ D) (hnD : n ≤ D^k)
    (hrough : ∀ p : ℕ, p.Prime → p ∣ n → D ≤ p) : σ 0 n ≤ 2^k := by
  have hpow : D^(Ω n) ≤ n := by
    rw [ArithmeticFunction.cardFactors_eq_sum_factorization]
    simp only [Finsupp.sum, Nat.support_factorization]
    rw [← Finset.prod_pow_eq_pow_sum]
    calc
      _ ≤ ∏ p ∈ n.primeFactors, p^n.factorization p := by
        apply Finset.prod_le_prod (fun _ _ ↦ Nat.zero_le _)
        intro p hp
        exact Nat.pow_le_pow_left (hrough p (Nat.prime_of_mem_primeFactors hp)
          (Nat.dvd_of_mem_primeFactors hp)) _
      _ = n := by
        simpa only [Finsupp.prod, Nat.support_factorization] using Nat.factorization_prod_pow_eq_self hn
  have hΩ : Ω n ≤ k := (Nat.pow_le_pow_iff_right (by omega)).mp (hpow.trans hnD)
  exact (sigma_zero_le_two_pow_cardFactors n).trans (Nat.pow_le_pow_right (by norm_num) hΩ)

/-- A positive integer has small smooth part if it splits into a small factor and a coprime
factor all of whose prime divisors exceed the sifting threshold. -/
def HasSmallSmoothPart (z : ℤ) (A D : ℕ) : Prop :=
  ∃ a b : ℕ, 0 < a ∧ a ≤ A ∧ 0 < b ∧ a.Coprime b ∧ z = (a*b:ℕ) ∧
    ∀ p : ℕ, p.Prime → p ∣ b → D < p

noncomputable def Erdos975SmallSmoothPartSum (f : ℤ[X]) (A D N : ℕ) : ℝ :=
  ∑ n ∈ (Finset.range N).filter (fun n : ℕ ↦ HasSmallSmoothPart (f.eval (n:ℤ)) A D),
    (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)

lemma polynomial_small_smooth_part_pointwise (f : ℤ[X]) (n A D k : ℕ)
    (hD : 2 ≤ D) (hbound : ⌊f.eval (n:ℤ)⌋₊ ≤ D^k)
    (hsmall : HasSmallSmoothPart (f.eval (n:ℤ)) A D) :
    (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ (2:ℝ)^k *
      ∑ a ∈ Finset.Icc 1 A, if (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
  obtain ⟨a, b, ha, haA, hb, hab, heq, hrough⟩ := hsmall
  have hfloor : ⌊f.eval (n:ℤ)⌋₊ = a*b := by rw [heq, Nat.floor_natCast]
  have hτb : σ 0 b ≤ 2^k := sigma_zero_rough_bound b D k hb.ne' hD
    ((Nat.le_mul_of_pos_left b ha).trans (hfloor ▸ hbound))
    (fun p hp hpb ↦ (hrough p hp hpb).le)
  have hmem : a ∈ Finset.Icc 1 A := Finset.mem_Icc.mpr ⟨ha, haA⟩
  have haeval : (a:ℤ) ∣ f.eval (n:ℤ) := by
    rw [heq]
    exact Int.natCast_dvd_natCast.mpr (dvd_mul_right a b)
  have hsift : ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
      ¬(p:ℤ) ∣ f.eval (n:ℤ) := by
    intro p hp hpeval
    obtain ⟨hpD, hprime, hpQa, _⟩ := (mem_polynomialSievePrimes _ _ _ _).mp hp
    have hpa : ¬p ∣ a := fun h ↦ hpQa (dvd_mul_of_dvd_right h _)
    have hpab : p ∣ a*b := by
      apply Int.natCast_dvd_natCast.mp
      rwa [heq] at hpeval
    have hpb := (hprime.dvd_mul.mp hpab).resolve_left hpa
    exact (hrough p hprime hpb).not_ge hpD
  have hsum : (σ 0 a:ℝ) ≤ ∑ a ∈ Finset.Icc 1 A, if (a:ℤ) ∣ f.eval (n:ℤ) ∧
      (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
        ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
    have hs := Finset.single_le_sum
      (f := fun a : ℕ ↦ if (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0)
      (fun _ _ ↦ by dsimp only; split_ifs <;> positivity) hmem
    have hcond : (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) D,
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) := ⟨haeval, hsift⟩
    simpa only [if_pos hcond] using hs
  rw [hfloor, ArithmeticFunction.isMultiplicative_sigma.map_mul_of_coprime hab, Nat.cast_mul]
  calc
    _ ≤ (σ 0 a:ℝ)*(2:ℝ)^k :=
      mul_le_mul_of_nonneg_left (by exact_mod_cast hτb) (Nat.cast_nonneg _)
    _ ≤ _ := by simpa only [mul_comm] using mul_le_mul_of_nonneg_left hsum (by positivity : (0:ℝ) ≤ 2^k)

lemma erdos975_small_smooth_part_le_sifted (f : ℤ[X]) (A D N k : ℕ)
    (hD : 2 ≤ D) (hbound : ∀ n < N, ⌊f.eval (n:ℤ)⌋₊ ≤ D^k) :
    Erdos975SmallSmoothPartSum f A D N ≤ (2:ℝ)^k * Erdos975SiftedSmallPartSum f A D N := by
  rw [Erdos975SmallSmoothPartSum, Finset.sum_filter, Erdos975SiftedSmallPartSum_swap, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  split_ifs with hsmall
  · exact polynomial_small_smooth_part_pointwise f n A D k hD (hbound n (Finset.mem_range.mp hn)) hsmall
  · apply mul_nonneg (by positivity)
    apply Finset.sum_nonneg
    intro a ha
    split_ifs <;> positivity

lemma erdos975_small_smooth_part_log_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (k : ℕ) :
    ∃ C > (0:ℝ), ∃ D₀ : ℕ, ∀ D N : ℕ, D₀ ≤ D → D^5 ≤ N →
      (∀ n < N, ⌊f.eval (n:ℤ)⌋₊ ≤ D^k) →
        Erdos975SmallSmoothPartSum f D D N ≤ C*N*log D := by
  obtain ⟨C, hC, D₀, hb⟩ := erdos975_sifted_small_part_diagonal_bound f hdeg hirr
  refine ⟨(2:ℝ)^k*C, by positivity, max 2 D₀, ?_⟩
  intro D N hD hDN hbound
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  calc
    _ ≤ (2:ℝ)^k * Erdos975SiftedSmallPartSum f D D N :=
      erdos975_small_smooth_part_le_sifted f D D N k hD2 hbound
    _ ≤ (2:ℝ)^k*(C*N*log D) := mul_le_mul_of_nonneg_left (hb D N hDD hDN) (by positivity)
    _ = _ := by ring


lemma erdos975_small_smooth_part_fifth_power_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∃ D₀ : ℕ, ∀ D : ℕ, D₀ ≤ D →
      Erdos975SmallSmoothPartSum f D D (D^5) ≤ C*(D:ℝ)^5*log D := by
  obtain ⟨M, hM1, hM⟩ := polynomial_floor_eval_power_bound f
  obtain ⟨M₀, hM₀⟩ := exists_nat_ge M
  obtain ⟨C, hC, D₀, hbound⟩ := erdos975_small_smooth_part_log_bound f hdeg hirr (5*f.natDegree+1)
  refine ⟨C, hC, max M₀ D₀, ?_⟩
  intro D hD
  have hMD : M ≤ (D:ℝ) := hM₀.trans (by exact_mod_cast (le_max_left M₀ D₀).trans hD)
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have hpoly : ∀ n < D^5, ⌊f.eval (n:ℤ)⌋₊ ≤ D^(5*f.natDegree+1) := by
    intro n hn
    have hnR : (n+1:ℝ) ≤ (D:ℝ)^5 := by exact_mod_cast (show n+1 ≤ D^5 by omega)
    have hb : (⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ (D:ℝ)^(5*f.natDegree+1) := by
      calc
        _ ≤ M*(n+1:ℝ)^f.natDegree := hM n
        _ ≤ (D:ℝ)*((D:ℝ)^5)^f.natDegree :=
          mul_le_mul hMD (pow_le_pow_left₀ (by positivity) hnR _) (by positivity) (Nat.cast_nonneg _)
        _ = _ := by rw [← pow_mul, pow_succ, mul_comm]
    exact_mod_cast hb
  simpa only [Nat.cast_pow] using hbound D (D^5) hDD le_rfl hpoly


/-- The full prime-power part of `n` supported on primes at most `D`. -/
def smoothPrimePart (n D : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors.filter (fun p ↦ p ≤ D), p^n.factorization p

/-- The complementary prime-power part, supported on primes greater than `D`. -/
def roughPrimePart (n D : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors.filter (fun p ↦ ¬p ≤ D), p^n.factorization p

lemma smoothPrimePart_pos (n D : ℕ) : 0 < smoothPrimePart n D := by
  apply Finset.prod_pos
  intro p hp
  exact pow_pos (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1).pos _

lemma roughPrimePart_pos (n D : ℕ) : 0 < roughPrimePart n D := by
  apply Finset.prod_pos
  intro p hp
  exact pow_pos (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1).pos _

lemma smoothPrimePart_mul_roughPrimePart (n D : ℕ) (hn : n ≠ 0) :
    smoothPrimePart n D * roughPrimePart n D = n := by
  unfold smoothPrimePart roughPrimePart
  rw [Finset.prod_filter_mul_prod_filter_not]
  simpa only [Finsupp.prod, Nat.support_factorization] using Nat.factorization_prod_pow_eq_self hn

lemma smoothPrimePart_dvd (n D : ℕ) (hn : n ≠ 0) : smoothPrimePart n D ∣ n :=
  ⟨roughPrimePart n D, (smoothPrimePart_mul_roughPrimePart n D hn).symm⟩

lemma prime_dvd_smoothPrimePart_le (n D p : ℕ) (hp : p.Prime)
    (hpd : p ∣ smoothPrimePart n D) : p ≤ D := by
  obtain ⟨q, hq, hpq⟩ := (hp.prime.dvd_finset_prod_iff _).mp hpd
  have hqprime := Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hq).1
  have heq : q = p := (hqprime.dvd_iff_eq hp.ne_one).mp (hp.dvd_of_dvd_pow hpq)
  exact heq ▸ (Finset.mem_filter.mp hq).2

lemma prime_dvd_roughPrimePart_gt (n D p : ℕ) (hp : p.Prime)
    (hpd : p ∣ roughPrimePart n D) : D < p := by
  obtain ⟨q, hq, hpq⟩ := (hp.prime.dvd_finset_prod_iff _).mp hpd
  have hqprime := Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hq).1
  have heq : q = p := (hqprime.dvd_iff_eq hp.ne_one).mp (hp.dvd_of_dvd_pow hpq)
  exact heq ▸ Nat.lt_of_not_ge (Finset.mem_filter.mp hq).2

lemma smoothPrimePart_coprime_of_rough (n D b : ℕ)
    (hb : ∀ p : ℕ, p.Prime → p ∣ b → D < p) : (smoothPrimePart n D).Coprime b := by
  apply Nat.coprime_of_dvd
  intro p hp hps hpb
  exact (hb p hp hpb).not_ge (prime_dvd_smoothPrimePart_le n D p hp hps)

lemma smoothPrimePart_coprime_roughPrimePart (n D : ℕ) :
    (smoothPrimePart n D).Coprime (roughPrimePart n D) :=
  smoothPrimePart_coprime_of_rough n D _ (prime_dvd_roughPrimePart_gt n D)

lemma smoothPrimePart_dvd_small_factor (n D a b : ℕ) (hn : n ≠ 0) (heq : n = a*b)
    (hb : ∀ p : ℕ, p.Prime → p ∣ b → D < p) : smoothPrimePart n D ∣ a := by
  apply (smoothPrimePart_coprime_of_rough n D b hb).dvd_of_dvd_mul_right
  rw [← heq]
  exact smoothPrimePart_dvd n D hn

lemma hasSmallSmoothPart_nat_iff (n A D : ℕ) :
    HasSmallSmoothPart (n:ℤ) A D ↔ 0 < n ∧ smoothPrimePart n D ≤ A := by
  constructor
  · rintro ⟨a, b, ha, haA, hb, hab, heq, hrough⟩
    have hn : n = a*b := by exact_mod_cast heq
    have hn0 : 0 < n := hn ▸ Nat.mul_pos ha hb
    refine ⟨hn0, ?_⟩
    exact (Nat.le_of_dvd ha (smoothPrimePart_dvd_small_factor n D a b hn0.ne' hn hrough)).trans haA
  · rintro ⟨hn, hA⟩
    refine ⟨smoothPrimePart n D, roughPrimePart n D, smoothPrimePart_pos n D, hA,
      roughPrimePart_pos n D, smoothPrimePart_coprime_roughPrimePart n D, ?_,
        prime_dvd_roughPrimePart_gt n D⟩
    exact_mod_cast (smoothPrimePart_mul_roughPrimePart n D hn.ne').symm

lemma hasSmallSmoothPart_iff (z : ℤ) (A D : ℕ) :
    HasSmallSmoothPart z A D ↔ 1 ≤ z ∧ smoothPrimePart ⌊z⌋₊ D ≤ A := by
  by_cases hz : 0 ≤ z
  · lift z to ℕ using hz
    rw [hasSmallSmoothPart_nat_iff, Nat.floor_natCast]
    norm_cast
  · constructor
    · rintro ⟨a, b, ha, haA, hb, hab, heq, hrough⟩
      exact (hz (heq ▸ Int.natCast_nonneg (a*b))).elim
    · rintro ⟨h, _⟩
      omega

noncomputable def Erdos975LargeSmoothPartSum (f : ℤ[X]) (A D N : ℕ) : ℝ :=
  ∑ n ∈ (Finset.range N).filter
    (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D),
      (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)

lemma erdos975_smooth_part_split (f : ℤ[X]) (A D N : ℕ) :
    (∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) =
      Erdos975SmallSmoothPartSum f A D N + Erdos975LargeSmoothPartSum f A D N := by
  unfold Erdos975SmallSmoothPartSum Erdos975LargeSmoothPartSum
  rw [Finset.sum_filter, Finset.sum_filter, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  by_cases hz : 1 ≤ f.eval (n:ℤ)
  · rw [hasSmallSmoothPart_iff]
    simp only [hz, true_and]
    split_ifs <;> simp_all <;> omega
  · have hzero : ⌊f.eval (n:ℤ)⌋₊ = 0 := by
      have := Nat.floor_pos.not.mpr hz
      omega
    simp only [hzero, ArithmeticFunction.map_zero, Nat.cast_zero, ite_self, add_zero]

lemma erdos975Sum_smooth_part_split (f : ℤ[X]) (A D N : ℕ) :
    Erdos975Sum f N = Erdos975SmallSmoothPartSum f A D (N+1) +
      Erdos975LargeSmoothPartSum f A D (N+1) := by
  rw [erdos975Sum_nat_range]
  exact erdos975_smooth_part_split f A D (N+1)


lemma exists_smooth_divisor_in_band (m A D : ℕ) (hA : 0 < A) (hAm : A < m)
    (hsm : ∀ p : ℕ, p.Prime → p ∣ m → p ≤ D) :
    ∃ a : ℕ, a ∣ m ∧ A < a ∧ a ≤ A*D ∧ (∀ p : ℕ, p.Prime → p ∣ a → p ≤ D) := by
  induction m using Nat.strong_induction_on generalizing A D with
  | h m ih =>
    obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd (show m ≠ 1 by omega)
    have hm0 : 0 < m := hA.trans hAm
    have hq : m/p < m := Nat.div_lt_self hm0 hp.one_lt
    by_cases hAq : A < m/p
    · obtain ⟨a, haq, hAa, haD, hsa⟩ := ih (m/p) hq A D hA hAq
        (fun q hq hqd ↦ hsm q hq (hqd.trans (Nat.div_dvd_of_dvd hpm)))
      exact ⟨a, haq.trans (Nat.div_dvd_of_dvd hpm), hAa, haD, hsa⟩
    · refine ⟨m, dvd_refl m, hAm, ?_, hsm⟩
      calc
        m = m/p*p := (Nat.div_mul_cancel hpm).symm
        _ ≤ A*D := Nat.mul_le_mul (by omega) (hsm p hp hpm)

noncomputable def smoothModuliBand (A B D : ℕ) : Finset ℕ :=
  (Finset.Ioc A B).filter (fun a ↦ a ∈ Nat.smoothNumbers (D+1))

lemma mem_smoothModuliBand (A B D a : ℕ) :
    a ∈ smoothModuliBand A B D ↔ A < a ∧ a ≤ B ∧
      (∀ p : ℕ, p.Prime → p ∣ a → p ≤ D) := by
  simp only [smoothModuliBand, Finset.mem_filter, Finset.mem_Ioc, Nat.mem_smoothNumbers',
    Nat.lt_succ_iff, and_assoc]

lemma large_smooth_part_has_band_divisor (f : ℤ[X]) (n A D : ℕ) (hA : 0 < A)
    (hlarge : A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D) :
    ∃ a ∈ smoothModuliBand A (A*D) D, (a:ℤ) ∣ f.eval (n:ℤ) := by
  let m := ⌊f.eval (n:ℤ)⌋₊
  have hm : m ≠ 0 := by
    intro hm0
    have hs : smoothPrimePart m D = 1 := by simp [smoothPrimePart, hm0]
    change A < smoothPrimePart m D at hlarge
    rw [hs] at hlarge
    omega
  obtain ⟨a, ha, hAa, haD, hsa⟩ := exists_smooth_divisor_in_band (smoothPrimePart m D) A D
    hA hlarge (prime_dvd_smoothPrimePart_le m D)
  have ham : a ∣ m := ha.trans (smoothPrimePart_dvd m D hm)
  refine ⟨a, (mem_smoothModuliBand A (A*D) D a).mpr ⟨hAa, haD, hsa⟩, ?_⟩
  have hzpos : 1 ≤ f.eval (n:ℤ) := Nat.floor_pos.mp (Nat.pos_of_ne_zero hm)
  have he : (m:ℤ) = f.eval (n:ℤ) := by
    change (⌊f.eval (n:ℤ)⌋₊:ℤ) = f.eval (n:ℤ)
    rw [Nat.floor_int]
    exact Int.toNat_of_nonneg (by omega)
  rw [← he]
  exact Int.natCast_dvd_natCast.mpr ham

lemma large_smooth_part_count_le_band (f : ℤ[X]) (A D N : ℕ) (hA : 0 < A) :
    (((Finset.range N).filter
      (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D)).card : ℝ) ≤
      ∑ a ∈ smoothModuliBand A (A*D) D,
        (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) := by
  have hsubset : (Finset.range N).filter (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D) ⊆
      (smoothModuliBand A (A*D) D).biUnion
        (fun a ↦ (Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ))) := by
    intro n hn
    obtain ⟨a, ha, han⟩ := large_smooth_part_has_band_divisor f n A D hA (Finset.mem_filter.mp hn).2
    exact Finset.mem_biUnion.mpr ⟨a, ha, Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hn).1, han⟩⟩
  exact_mod_cast (Finset.card_le_card hsubset).trans Finset.card_biUnion_le

lemma polynomial_divisibility_count_le (f : ℤ[X]) (a N : ℕ) (ha : 0 < a) :
    (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) ≤
      (N:ℝ)*(polynomialRootCount f a:ℝ)/a + (polynomialRootCount f a:ℝ) := by
  have he := le_abs_self _ |>.trans (polynomial_root_count_error f a N ha)
  change (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ))).card : ℝ) -
    (N:ℝ)/a*(polynomialRootCount f a:ℝ) ≤ (polynomialRootCount f a:ℝ) at he
  linear_combination he

lemma large_smooth_part_count_le_root_tail (f : ℤ[X]) (A D N : ℕ) (hA : 0 < A) :
    (((Finset.range N).filter
      (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D)).card : ℝ) ≤
      ((N:ℝ)+(A:ℝ)*D) *
        ∑ a ∈ smoothModuliBand A (A*D) D, (polynomialRootCount f a:ℝ)/a := by
  apply (large_smooth_part_count_le_band f A D N hA).trans
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro a ha
  obtain ⟨hAa, haAD, _⟩ := (mem_smoothModuliBand _ _ _ _).mp ha
  have ha0 : 0 < a := hA.trans hAa
  have haR : (0:ℝ) < a := by exact_mod_cast ha0
  have hadR : (a:ℝ) ≤ (A:ℝ)*D := by exact_mod_cast haAD
  apply (polynomial_divisibility_count_le f a N ha0).trans
  have hρ : (polynomialRootCount f a:ℝ) ≤
      ((A:ℝ)*D)*(polynomialRootCount f a:ℝ)/a := by
    apply (le_div_iff₀ haR).mpr
    nlinarith [mul_le_mul_of_nonneg_right hadR (Nat.cast_nonneg (α := ℝ) (polynomialRootCount f a))]
  calc
    _ ≤ (N:ℝ)*(polynomialRootCount f a:ℝ)/a +
        ((A:ℝ)*D)*(polynomialRootCount f a:ℝ)/a := add_le_add le_rfl hρ
    _ = _ := by ring


noncomputable def arithmeticRpowWeight (u : ArithmeticFunction ℝ) (t : ℝ) : ArithmeticFunction ℝ where
  toFun n := u n/(n:ℝ)^t
  map_zero' := by simp

lemma arithmeticRpowWeight_nonneg (u : ArithmeticFunction ℝ) (hu : ∀ n, 0 ≤ u n) (t : ℝ) (n : ℕ) :
    0 ≤ arithmeticRpowWeight u t n := div_nonneg (hu n) (Real.rpow_nonneg (Nat.cast_nonneg n) t)

lemma arithmeticRpowWeight_multiplicative (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative) (t : ℝ) :
    (arithmeticRpowWeight u t).IsMultiplicative := by
  constructor
  · simp [arithmeticRpowWeight, hu.map_one]
  · intro m n hmn
    simp only [arithmeticRpowWeight, ArithmeticFunction.coe_mk, hu.map_mul_of_coprime hmn,
      Nat.cast_mul, Real.mul_rpow (Nat.cast_nonneg m) (Nat.cast_nonneg n), div_mul_div_comm]

lemma arithmeticRpowWeight_prime_pow (u : ArithmeticFunction ℝ) (t : ℝ) (p k : ℕ) :
    arithmeticRpowWeight u t (p^k) = u (p^k) / ((p:ℝ)^t)^k := by
  change u (p^k) / ((p^k:ℕ):ℝ)^t = _
  rw [Nat.cast_pow, ← Real.rpow_natCast_mul (Nat.cast_nonneg p), mul_comm (k:ℝ),
    Real.rpow_mul_natCast (Nat.cast_nonneg p)]

lemma arithmeticRpowWeight_local_summable (u : ArithmeticFunction ℝ) (t : ℝ) (ht : 0 < t)
    (p : ℕ) (hp : p.Prime) (B : ℝ) (hB : 0 ≤ B)
    (hbound : ∀ k : ℕ, ‖u (p^k)‖ ≤ B*(k+1:ℝ)) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖) := by
  have hp1 : (1:ℝ) < p := by exact_mod_cast hp.one_lt
  have hp0 : (0:ℝ) < p := zero_lt_one.trans hp1
  have hq : ‖((p:ℝ)^t)⁻¹‖ < 1 := by
    rw [Real.norm_of_nonneg (by positivity)]
    exact inv_lt_one_of_one_lt₀ (Real.one_lt_rpow hp1 ht)
  have hgeom : Summable (fun k : ℕ ↦ B*(k+1:ℝ)/((p:ℝ)^t)^k) := by
    have hs : Summable (fun k : ℕ ↦ (k+1:ℝ)*(((p:ℝ)^t)⁻¹)^k) := by
      simpa using summable_choose_mul_geometric_of_norm_lt_one 1 hq
    simpa only [div_eq_mul_inv, inv_pow, mul_assoc] using hs.mul_left B
  apply Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) _ hgeom
  intro k
  rw [arithmeticRpowWeight_prime_pow, norm_div,
    Real.norm_of_nonneg (show 0 ≤ ((p:ℝ)^t)^k by positivity)]
  exact div_le_div_of_nonneg_right (hbound k) (by positivity)

noncomputable def smoothWeightedSum (u : ArithmeticFunction ℝ) (t : ℝ) (D : ℕ) : ℝ :=
  ∑' n : ℕ, (Nat.smoothNumbers (D+1)).indicator (arithmeticRpowWeight u t) n

lemma smooth_weighted_summable_and_euler (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (t : ℝ) (D : ℕ)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖)) :
    Summable ((Nat.smoothNumbers (D+1)).indicator (arithmeticRpowWeight u t)) ∧
      smoothWeightedSum u t D = ∏ p ∈ (Finset.range (D+1)).filter Nat.Prime,
        ∑' k : ℕ, arithmeticRpowWeight u t (p^k) := by
  have hv := arithmeticRpowWeight_multiplicative u hu t
  have he := EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_tsum hv.map_one
    (fun {_ _} hmn ↦ hv.map_mul_of_coprime hmn) (fun {p} hp ↦ hlocal p hp) (Finset.range (D+1))
  have hs := summable_subtype_iff_indicator.mp he.1.of_norm
  rw [← Nat.smoothNumbers_eq_factoredNumbers] at hs
  refine ⟨hs, ?_⟩
  rw [smoothWeightedSum, Nat.smoothNumbers_eq_factoredNumbers, ← tsum_subtype]
  exact he.2.tsum_eq

lemma smoothWeightedSum_ge_one (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (hu0 : ∀ n, 0 ≤ u n) (t : ℝ) (D : ℕ)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖)) :
    1 ≤ smoothWeightedSum u t D := by
  have hs := (smooth_weighted_summable_and_euler u hu t D hlocal).1
  have hmem : 1 ∈ Nat.smoothNumbers (D+1) := by simp [Nat.mem_smoothNumbers]
  have hh := hs.le_tsum 1 (fun n _ ↦ Set.indicator_nonneg
    (fun n _ ↦ arithmeticRpowWeight_nonneg u hu0 t n) n)
  simpa only [Set.indicator_of_mem hmem, (arithmeticRpowWeight_multiplicative u hu t).map_one] using hh

lemma smoothModuliBand_rankin_bound (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (hu0 : ∀ n, 0 ≤ u n) (s : ℝ) (hs : 0 ≤ s)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u (1-s) (p^k)‖))
    (A B D : ℕ) (hA : 0 < A) :
    (∑ a ∈ smoothModuliBand A B D, u a/(a:ℝ)) ≤ smoothWeightedSum u (1-s) D / (A:ℝ)^s := by
  have hApos : (0:ℝ) < A := by exact_mod_cast hA
  have hpA : 0 < (A:ℝ)^s := Real.rpow_pos_of_pos hApos s
  have hterm : ∀ a ∈ smoothModuliBand A B D,
      u a/(a:ℝ) ≤ arithmeticRpowWeight u (1-s) a/(A:ℝ)^s := by
    intro a ha
    have hAa := (mem_smoothModuliBand A B D a).mp ha |>.1
    have ha0 : (0:ℝ) < a := by exact_mod_cast hA.trans hAa
    apply (le_div_iff₀ hpA).mpr
    have hpow : (A:ℝ)^s ≤ (a:ℝ)^s :=
      Real.rpow_le_rpow hApos.le (by exact_mod_cast hAa.le) hs
    calc
      _ ≤ (u a/(a:ℝ))*(a:ℝ)^s :=
        mul_le_mul_of_nonneg_left hpow (div_nonneg (hu0 a) ha0.le)
      _ = arithmeticRpowWeight u (1-s) a := by
        change u a/(a:ℝ)*(a:ℝ)^s = u a/(a:ℝ)^(1-s)
        rw [Real.rpow_sub ha0, Real.rpow_one]
        field_simp
  have hsum : (∑ a ∈ smoothModuliBand A B D, arithmeticRpowWeight u (1-s) a) ≤
      smoothWeightedSum u (1-s) D := by
    have hsum := (smooth_weighted_summable_and_euler u hu (1-s) D hlocal).1
    have heq : (∑ a ∈ smoothModuliBand A B D, arithmeticRpowWeight u (1-s) a) =
        ∑ a ∈ smoothModuliBand A B D,
          (Nat.smoothNumbers (D+1)).indicator (arithmeticRpowWeight u (1-s)) a := by
      apply Finset.sum_congr rfl
      intro a ha
      exact (Set.indicator_of_mem (Finset.mem_filter.mp ha).2 _).symm
    rw [heq]
    exact hsum.sum_le_tsum _ (fun n _ ↦ Set.indicator_nonneg
      (fun n _ ↦ arithmeticRpowWeight_nonneg u hu0 (1-s) n) n)
  calc
    _ ≤ ∑ a ∈ smoothModuliBand A B D, arithmeticRpowWeight u (1-s) a/(A:ℝ)^s :=
      Finset.sum_le_sum hterm
    _ = (∑ a ∈ smoothModuliBand A B D, arithmeticRpowWeight u (1-s) a)/(A:ℝ)^s :=
      (Finset.sum_div ..).symm
    _ ≤ _ := div_le_div_of_nonneg_right hsum hpA.le

lemma rootCount_positive_rpow_local_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 0 < t) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (polynomialRootCount f : ArithmeticFunction ℝ) t (p^k)‖) := by
  obtain ⟨B, hB⟩ := exists_bound_prime_pow_rootResidues_of_resultant_ne_zero f hdeg
    (resultant_derivative_ne_zero_of_irreducible f hdeg hirr) p hp
  apply arithmeticRpowWeight_local_summable _ t ht p hp (B:ℝ) (Nat.cast_nonneg B)
  intro k
  change ‖(polynomialRootCount f (p^k):ℝ)‖ ≤ (B:ℝ)*(k+1:ℝ)
  rw [Real.norm_of_nonneg (Nat.cast_nonneg _)]
  have hbound : (polynomialRootCount f (p^k):ℝ) ≤ (B:ℝ) := by exact_mod_cast hB k
  nlinarith [Nat.cast_nonneg (α := ℝ) k, Nat.cast_nonneg (α := ℝ) B]

lemma polynomial_large_smooth_count_rankin (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (s : ℝ) (hs : 0 ≤ s) (hs1 : s < 1) (A D N : ℕ) (hA : 0 < A) :
    (((Finset.range N).filter
      (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D)).card : ℝ) ≤
        ((N:ℝ)+(A:ℝ)*D) * smoothWeightedSum (polynomialRootCount f : ArithmeticFunction ℝ) (1-s) D /
          (A:ℝ)^s := by
  apply (large_smooth_part_count_le_root_tail f A D N hA).trans
  have hRankin := smoothModuliBand_rankin_bound (polynomialRootCount f : ArithmeticFunction ℝ)
    (polynomialRootCount_multiplicative f).natCast (fun _ ↦ Nat.cast_nonneg _) s hs
    (rootCount_positive_rpow_local_summable f hdeg hirr (1-s) (by linarith)) A (A*D) D hA
  simpa only [mul_div_assoc] using mul_le_mul_of_nonneg_left hRankin
    (show 0 ≤ (N:ℝ)+(A:ℝ)*D by positivity)


lemma polynomial_large_smooth_sum_rankin (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (D : ℕ) (s ε : ℝ) (hs : 0 ≤ s) (hs1 : s < 1) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ A N : ℕ, 0 < A →
      Erdos975LargeSmoothPartSum f A D N ≤ C*(N:ℝ)^ε*((N:ℝ)+(A:ℝ)*D)/(A:ℝ)^s := by
  obtain ⟨B, hB, hpoint⟩ := sigma_zero_polynomial_subpolynomial_bound f ε hε
  let W := smoothWeightedSum (polynomialRootCount f : ArithmeticFunction ℝ) (1-s) D
  have hW : 1 ≤ W := smoothWeightedSum_ge_one _ (polynomialRootCount_multiplicative f).natCast
    (fun _ ↦ Nat.cast_nonneg _) (1-s) D
    (rootCount_positive_rpow_local_summable f hdeg hirr (1-s) (by linarith))
  refine ⟨B*W, mul_pos hB (zero_lt_one.trans_le hW), ?_⟩
  intro A N hA
  have hcount := polynomial_large_smooth_count_rankin f hdeg hirr s hs hs1 A D N hA
  calc
    Erdos975LargeSmoothPartSum f A D N ≤
        ∑ _n ∈ (Finset.range N).filter
          (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D), B*(N:ℝ)^ε := by
      apply Finset.sum_le_sum
      intro n hn
      apply (hpoint n).trans
      apply mul_le_mul_of_nonneg_left _ hB.le
      apply Real.rpow_le_rpow (by positivity) _ hε.le
      exact_mod_cast (show n+1 ≤ N by have := Finset.mem_range.mp (Finset.mem_filter.mp hn).1; omega)
    _ = B*(N:ℝ)^ε * (((Finset.range N).filter
          (fun n : ℕ ↦ A < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ D)).card : ℝ) := by
      rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
    _ ≤ B*(N:ℝ)^ε * (((N:ℝ)+(A:ℝ)*D)*W/(A:ℝ)^s) :=
      mul_le_mul_of_nonneg_left hcount (by positivity)
    _ = _ := by ring

lemma polynomial_large_smooth_sum_rankin_normalized (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (D : ℕ) (s ε : ℝ) (hs : 0 ≤ s) (hs1 : s < 1) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ A N : ℕ, 0 < A → A ≤ N →
      Erdos975LargeSmoothPartSum f A D N/(N:ℝ) ≤ C*(N:ℝ)^ε/(A:ℝ)^s := by
  obtain ⟨C, hC, hb⟩ := polynomial_large_smooth_sum_rankin f hdeg hirr D s ε hs hs1 hε
  refine ⟨C*(1+D:ℝ), by positivity, ?_⟩
  intro A N hA hAN
  have hN : (0:ℝ) < N := by exact_mod_cast hA.trans_le hAN
  have hANR : (A:ℝ) ≤ N := by exact_mod_cast hAN
  have hnum : (N:ℝ)+(A:ℝ)*D ≤ (1+D:ℝ)*N := by nlinarith [Nat.cast_nonneg (α := ℝ) D]
  apply (div_le_iff₀ hN).mpr
  calc
    _ ≤ C*(N:ℝ)^ε*((N:ℝ)+(A:ℝ)*D)/(A:ℝ)^s := hb A N hA
    _ ≤ C*(N:ℝ)^ε*((1+D:ℝ)*N)/(A:ℝ)^s :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hnum (by positivity)) (by positivity)
    _ = _ := by ring

lemma fixed_prime_smooth_tail_negligible (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (D : ℕ) (α : ℝ) (hα : 0 < α) (hα1 : α ≤ 1) :
    Tendsto (fun N : ℕ ↦ Erdos975LargeSmoothPartSum f ⌊(N:ℝ)^α⌋₊ D N/(N:ℝ))
      atTop (𝓝 0) := by
  obtain ⟨C, hC, hb⟩ := polynomial_large_smooth_sum_rankin_normalized f hdeg hirr D (1/2) (α/4)
    (by norm_num) (by norm_num) (by positivity)
  have hNpow := (tendsto_rpow_atTop hα).comp (tendsto_natCast_atTop_atTop (R := ℝ))
  have hlim := ((tendsto_rpow_neg_atTop (show 0 < α/4 by positivity)).comp
    (tendsto_natCast_atTop_atTop (R := ℝ))).const_mul (C*(2:ℝ)^(1/2:ℝ))
  simp only [mul_zero] at hlim
  apply squeeze_zero' (Filter.Eventually.of_forall (fun N ↦
    div_nonneg (Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)) (Nat.cast_nonneg N))) _ hlim
  filter_upwards [hNpow.eventually_ge_atTop 2, eventually_ge_atTop (1:ℕ)] with N hNpow hN1
  change 2 ≤ (N:ℝ)^α at hNpow
  let A := ⌊(N:ℝ)^α⌋₊
  have hNpos : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hNone : (1:ℝ) ≤ N := by exact_mod_cast hN1
  have hAp : 0 < A := Nat.floor_pos.mpr (by linarith)
  have hAN : A ≤ N := by
    have hf := Nat.floor_le (Real.rpow_nonneg (Nat.cast_nonneg N) α)
    have hp := Real.rpow_le_rpow_of_exponent_le hNone hα1
    rw [Real.rpow_one] at hp
    exact_mod_cast hf.trans hp
  have hAfloor : (N:ℝ)^α/2 ≤ (A:ℝ) := by
    have hf := Nat.lt_floor_add_one ((N:ℝ)^α)
    change (N:ℝ)^α < (A:ℝ)+1 at hf
    linarith
  have hApow : (N:ℝ)^(α/2)/(2:ℝ)^(1/2:ℝ) ≤ (A:ℝ)^(1/2:ℝ) := by
    have hh := Real.rpow_le_rpow (by positivity : 0 ≤ (N:ℝ)^α/2) hAfloor
      (by norm_num : (0:ℝ) ≤ 1/2)
    rw [Real.div_rpow (by positivity) (by norm_num), ← Real.rpow_mul hNpos.le] at hh
    simpa only [mul_one_div] using hh
  calc
    _ ≤ C*(N:ℝ)^(α/4)/(A:ℝ)^(1/2:ℝ) := hb A N hAp hAN
    _ ≤ C*(N:ℝ)^(α/4) / ((N:ℝ)^(α/2)/(2:ℝ)^(1/2:ℝ)) :=
      div_le_div_of_nonneg_left (by positivity) (by positivity) hApow
    _ = C*(2:ℝ)^(1/2:ℝ)*(N:ℝ)^(-(α/4)) := by
      have he : -(α/4) = α/4-α/2 := by ring
      rw [he, Real.rpow_sub hNpos]
      field_simp


lemma harmonicWeightSum_succ (u : ℕ → ℝ) (N : ℕ) :
    harmonicWeightSum u (N+1) = harmonicWeightSum u N + u (N+1)/(N+1:ℝ) := by
  unfold harmonicWeightSum
  rw [Finset.sum_Icc_succ_top (by omega)]
  push_cast
  rfl

lemma summatoryWeightSum_succ (u : ℕ → ℝ) (N : ℕ) :
    summatoryWeightSum u (N+1) = summatoryWeightSum u N + u (N+1) := by
  unfold summatoryWeightSum
  exact Finset.sum_Icc_succ_top (by omega) u

lemma harmonicWeightSum_discrete_abel (u : ℕ → ℝ) (N : ℕ) :
    harmonicWeightSum u (N+1) = summatoryWeightSum u (N+1)/(N+1:ℝ) +
      ∑ k ∈ Finset.Icc 1 N, summatoryWeightSum u k/((k:ℝ)*(k+1:ℝ)) := by
  induction N with
  | zero => simp [harmonicWeightSum, summatoryWeightSum]
  | succ N ih =>
    rw [harmonicWeightSum_succ u (N+1), ih, summatoryWeightSum_succ u (N+1),
      Finset.sum_Icc_succ_top (by omega)]
    push_cast
    field_simp
    <;> ring

lemma sum_one_div_succ_eq_harmonic (N : ℕ) :
    (∑ k ∈ Finset.Icc 1 N, (1:ℝ)/(k+1:ℝ)) = (harmonic (N+1):ℝ)-1 := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih, harmonic_succ (N+1)]
    push_cast
    ring

lemma harmonicWeightSum_le_harmonic_of_summatory_bound (u : ℕ → ℝ) (M : ℝ)
    (hM : ∀ N, summatoryWeightSum u N ≤ M*N) (N : ℕ) :
    harmonicWeightSum u N ≤ M*(harmonic N:ℝ) := by
  cases N with
  | zero => simp [harmonicWeightSum]
  | succ N =>
    rw [harmonicWeightSum_discrete_abel]
    have htop : summatoryWeightSum u (N+1)/(N+1:ℝ) ≤ M := by
      apply (div_le_iff₀ (by positivity : (0:ℝ) < N+1)).mpr
      simpa only [Nat.cast_add, Nat.cast_one] using hM (N+1)
    have hterms : ∀ k ∈ Finset.Icc 1 N,
        summatoryWeightSum u k/((k:ℝ)*(k+1:ℝ)) ≤ M*((1:ℝ)/(k+1:ℝ)) := by
      intro k hk
      have hkpos : (0:ℝ) < k := by exact_mod_cast (Finset.mem_Icc.mp hk).1
      calc
        _ ≤ M*k/((k:ℝ)*(k+1:ℝ)) := div_le_div_of_nonneg_right (hM k) (by positivity)
        _ = _ := by field_simp
    calc
      _ ≤ M + ∑ k ∈ Finset.Icc 1 N, M*((1:ℝ)/(k+1:ℝ)) :=
        add_le_add htop (Finset.sum_le_sum hterms)
      _ = M + M*((harmonic (N+1):ℝ)-1) := by
        rw [← Finset.mul_sum, sum_one_div_succ_eq_harmonic]
      _ = _ := by ring

lemma harmonicWeightSum_le_log_of_summatory_bound (u : ℕ → ℝ) (M : ℝ) (hM0 : 0 ≤ M)
    (hM : ∀ N, summatoryWeightSum u N ≤ M*N) (N : ℕ) :
    harmonicWeightSum u N ≤ M*(1+log N) :=
  (harmonicWeightSum_le_harmonic_of_summatory_bound u M hM N).trans
    (mul_le_mul_of_nonneg_left (harmonic_le_one_add_log N) hM0)

lemma prime_log_harmonic_bound : ∃ C > (0:ℝ), ∀ D : ℕ, 2 ≤ D →
    (∑ p ∈ (Finset.range (D+1)).filter Nat.Prime, log p/(p:ℝ)) ≤ C*log D := by
  let u : ℕ → ℝ := fun n ↦ if n.Prime then log n else 0
  have hmean : ∀ N, summatoryWeightSum u N ≤ log 4 * N := by
    intro N
    have he : summatoryWeightSum u N = Chebyshev.theta N := by
      unfold summatoryWeightSum u Chebyshev.theta
      rw [← Finset.sum_filter, Nat.floor_natCast]
      congr 1
    rw [he]
    exact Chebyshev.theta_le_log4_mul_x (Nat.cast_nonneg N)
  have hlog2 : 0 < log 2 := Real.log_pos (by norm_num)
  have hlog4 : 0 < log 4 := Real.log_pos (by norm_num)
  refine ⟨log 4 * (1+(log 2)⁻¹), by positivity, ?_⟩
  intro D hD
  have he : (∑ p ∈ (Finset.range (D+1)).filter Nat.Prime, log p/(p:ℝ)) = harmonicWeightSum u D := by
    unfold harmonicWeightSum u
    simp_rw [ite_div, zero_div]
    rw [← Finset.sum_filter]
    apply Finset.sum_congr
    · ext p
      simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Icc]
      constructor
      · rintro ⟨hpD, hp⟩
        exact ⟨⟨hp.pos, by omega⟩, hp⟩
      · rintro ⟨⟨_, hpD⟩, hp⟩
        exact ⟨by omega, hp⟩
    · intro p hp; rfl
  rw [he]
  have hl : log 2 ≤ log (D:ℝ) := Real.log_le_log (by norm_num) (by exact_mod_cast hD)
  have hratio : 1 ≤ log (D:ℝ)/log 2 := (one_le_div hlog2).mpr hl
  calc
    _ ≤ log 4*(1+log D) := harmonicWeightSum_le_log_of_summatory_bound u _ hlog4.le hmean D
    _ ≤ log 4*(log D/log 2+log D) := mul_le_mul_of_nonneg_left (add_le_add hratio le_rfl) hlog4.le
    _ = _ := by ring


lemma log_eq_sum_primeFactors_of_squarefree (n : ℕ) (hn : Squarefree n) :
    log (n:ℝ) = ∑ p ∈ n.primeFactors, log p := by
  have he := Nat.prod_primeFactors_of_squarefree hn
  rw [← he, Nat.cast_prod, Real.log_prod]
  · congr 1
    exact (Nat.primeFactors_prod (fun p hp ↦ Nat.prime_of_mem_primeFactors hp)).symm
  · intro p hp
    exact_mod_cast (Nat.prime_of_mem_primeFactors hp).ne_zero

lemma primeFactors_filter_dvd (P d : ℕ) (hP : P ≠ 0) (hd : d ∣ P) :
    P.primeFactors.filter (fun p ↦ p ∣ d) = d.primeFactors := by
  have hd0 : d ≠ 0 := (Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero hP)).ne'
  ext p
  simp only [Finset.mem_filter, Nat.mem_primeFactors_of_ne_zero hP,
    Nat.mem_primeFactors_of_ne_zero hd0]
  exact ⟨fun h ↦ ⟨h.1.1, h.2⟩, fun h ↦ ⟨⟨h.1, h.2.trans hd⟩, h.2⟩⟩

lemma sum_divisors_multiple_le (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (hu0 : ∀ n, 0 ≤ u n) (P : ℕ) (hP : Squarefree P) (p : ℕ) (hpP : p ∣ P) :
    (∑ d ∈ P.divisors with p ∣ d, u d) ≤ u p * ∑ d ∈ P.divisors, u d := by
  rw [sum_divisors_multiple P p hP.ne_zero hpP]
  have heq : (∑ d ∈ (P/p).divisors, u (p*d)) = u p * ∑ d ∈ (P/p).divisors, u d := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro d hd
    have hpd : p*d ∣ P := (Nat.dvd_div_iff_mul_dvd hpP).mp (Nat.dvd_of_mem_divisors hd)
    exact hu.map_mul_of_coprime (Nat.coprime_of_squarefree_mul (Squarefree.squarefree_of_dvd hpd hP))
  rw [heq]
  apply mul_le_mul_of_nonneg_left _ (hu0 p)
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro d hd
    exact Nat.mem_divisors.mpr ⟨(Nat.dvd_of_mem_divisors hd).trans (Nat.div_dvd_of_dvd hpP), hP.ne_zero⟩
  · intro d hd hnot
    exact hu0 d

lemma divisor_log_moment_le (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (hu0 : ∀ n, 0 ≤ u n) (P : ℕ) (hP : Squarefree P) :
    (∑ d ∈ P.divisors, u d*log d) ≤
      (∑ d ∈ P.divisors, u d) * ∑ p ∈ P.primeFactors, u p*log p := by
  have hterm : ∀ d ∈ P.divisors,
      u d*log d = ∑ p ∈ P.primeFactors, if p ∣ d then u d*log p else 0 := by
    intro d hd
    rw [log_eq_sum_primeFactors_of_squarefree d (Squarefree.squarefree_of_dvd (Nat.dvd_of_mem_divisors hd) hP)]
    rw [← Finset.sum_filter, primeFactors_filter_dvd P d hP.ne_zero (Nat.dvd_of_mem_divisors hd),
      Finset.mul_sum]
  rw [Finset.sum_congr rfl hterm, Finset.sum_comm, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro p hp
  rw [← Finset.sum_filter, ← Finset.sum_mul]
  have hlog : 0 ≤ log (p:ℝ) := Real.log_nonneg
    (by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_lt.le)
  calc
    _ ≤ (u p * ∑ d ∈ P.divisors, u d) * log p :=
      mul_le_mul_of_nonneg_right (sum_divisors_multiple_le u hu hu0 P hP p (Nat.dvd_of_mem_primeFactors hp)) hlog
    _ = _ := by ring

lemma divisor_weight_truncation_bound (u : ℕ → ℝ) (hu0 : ∀ n, 0 ≤ u n)
    (P X : ℕ) (hP : P ≠ 0) (hX : 2 ≤ X) :
    (∑ d ∈ P.divisors, u d) ≤ (∑ d ∈ Finset.Icc 1 X, u d) +
      (∑ d ∈ P.divisors, u d*log d)/log X := by
  have hlogX : 0 < log (X:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < X by omega))
  have hsmall : (∑ d ∈ P.divisors with d ≤ X, u d) ≤ ∑ d ∈ Finset.Icc 1 X, u d := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro d hd
      exact Finset.mem_Icc.mpr ⟨Nat.pos_of_mem_divisors (Finset.mem_filter.mp hd).1, (Finset.mem_filter.mp hd).2⟩
    · intro d hd hnot
      exact hu0 d
  calc
    _ ≤ (∑ d ∈ P.divisors with d ≤ X, u d) + (∑ d ∈ P.divisors, u d*log d)/log X := by
      rw [Finset.sum_filter, Finset.sum_div, ← Finset.sum_add_distrib]
      apply Finset.sum_le_sum
      intro d hd
      have hdpos : (0:ℝ) < d := by exact_mod_cast Nat.pos_of_mem_divisors hd
      have hlogd : 0 ≤ log (d:ℝ) := Real.log_nonneg (by exact_mod_cast Nat.pos_of_mem_divisors hd)
      by_cases hdX : d ≤ X
      · rw [if_pos hdX]
        have hnonneg := div_nonneg (mul_nonneg (hu0 d) hlogd) hlogX.le
        linarith
      · rw [if_neg hdX, zero_add]
        apply (le_div_iff₀ hlogX).mpr
        apply mul_le_mul_of_nonneg_left _ (hu0 d)
        exact Real.log_le_log (by exact_mod_cast (show 0 < X by omega)) (by exact_mod_cast (show X ≤ d by omega))
    _ ≤ _ := add_le_add hsmall le_rfl

lemma polynomial_sieve_log_moment_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) :
    ∃ C > (0:ℝ), ∀ D : ℕ, 2 ≤ D →
      (∑ d ∈ (polynomialSieveProduct f (polynomialSieveBadProduct f) D).divisors,
        polynomialRootDensity f d * log d) ≤
      C * log D * ∑ d ∈ (polynomialSieveProduct f (polynomialSieveBadProduct f) D).divisors,
        polynomialRootDensity f d := by
  obtain ⟨B, hB, hprime⟩ := prime_log_harmonic_bound
  refine ⟨(f.natDegree:ℝ)*B, mul_pos (by exact_mod_cast Nat.pos_of_ne_zero hdeg) hB, ?_⟩
  intro D hD
  let P := polynomialSieveProduct f (polynomialSieveBadProduct f) D
  have hu0 : ∀ n, 0 ≤ polynomialRootDensity f n := fun n ↦ div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg n)
  have hpr : (∑ p ∈ P.primeFactors, polynomialRootDensity f p * log p) ≤
      (f.natDegree:ℝ) * (B*log D) := by
    rw [polynomialSieveProduct_primeFactors]
    calc
      _ ≤ ∑ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f) D,
          (f.natDegree:ℝ)*(log p/(p:ℝ)) := by
        apply Finset.sum_le_sum
        intro p hp
        obtain ⟨hpD, hpp, hpQ, _⟩ := (mem_polynomialSievePrimes _ _ _ _).mp hp
        have hval : (polynomialRootCount f p:ℝ) ≤ f.natDegree := by
          have hb := squarefreeRootCount_prime_le_degree f hdeg p hpp
          rwa [squarefreeRootCount_prime f (polynomialSieveBadProduct f) p hpp, if_neg hpQ] at hb
        have hlog : 0 ≤ log (p:ℝ) := Real.log_nonneg (by exact_mod_cast hpp.one_lt.le)
        calc
          _ ≤ (f.natDegree:ℝ)/(p:ℝ)*log p :=
            mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hval (Nat.cast_nonneg p)) hlog
          _ = _ := by ring
      _ ≤ ∑ p ∈ (Finset.range (D+1)).filter Nat.Prime, (f.natDegree:ℝ)*(log p/(p:ℝ)) := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro p hp
          obtain ⟨hpD, hpp, _⟩ := (mem_polynomialSievePrimes _ _ _ _).mp hp
          exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hpp⟩
        · intro p hp hnot
          have hlog : 0 ≤ log (p:ℝ) := Real.log_nonneg
            (by exact_mod_cast (Finset.mem_filter.mp hp).2.one_lt.le)
          positivity
      _ ≤ _ := by
        rw [← Finset.mul_sum]
        exact mul_le_mul_of_nonneg_left (hprime D hD) (Nat.cast_nonneg _)
  have he := divisor_log_moment_le (polynomialRootDensity f) (polynomialRootDensity_multiplicative f)
    hu0 P (polynomialSieveProduct_squarefree f (polynomialSieveBadProduct f) D)
  apply he.trans
  have hsum0 : 0 ≤ ∑ d ∈ P.divisors, polynomialRootDensity f d := Finset.sum_nonneg (fun d _ ↦ hu0 d)
  calc
    _ ≤ (∑ d ∈ P.divisors, polynomialRootDensity f d) * ((f.natDegree:ℝ)*(B*log D)) :=
      mul_le_mul_of_nonneg_left hpr hsum0
    _ = _ := by ring


lemma polynomial_sieve_divisor_sum_log_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∃ D₀ : ℕ, ∀ D : ℕ, D₀ ≤ D →
      (∑ d ∈ (polynomialSieveProduct f (polynomialSieveBadProduct f) D).divisors,
        polynomialRootDensity f d) ≤ C*log D := by
  obtain ⟨M, hM, hmoment⟩ := polynomial_sieve_log_moment_bound f hdeg
  obtain ⟨K, hK⟩ := exists_nat_ge (2*M+1)
  have hKpos : (0:ℝ) < K := by linarith
  have hK1 : 1 ≤ K := by exact_mod_cast hKpos
  obtain ⟨B, hB, hH⟩ := polynomialRootCount_harmonic_eventual_upper f hdeg hirr
  obtain ⟨X₀, hX₀⟩ := eventually_atTop.mp hH
  refine ⟨2*B*K, by positivity, max 2 X₀, ?_⟩
  intro D hD
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDX : X₀ ≤ D := (le_max_right _ _).trans hD
  have hDpow : D ≤ D^K := by
    simpa only [pow_one] using Nat.pow_le_pow_right (show 1 ≤ D by omega) hK1
  have hHpow := hX₀ (D^K) (hDX.trans hDpow)
  have hlogD : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < D by omega))
  let P := polynomialSieveProduct f (polynomialSieveBadProduct f) D
  let E := ∑ d ∈ P.divisors, polynomialRootDensity f d
  have hu0 : ∀ n, 0 ≤ polynomialRootDensity f n := fun n ↦ div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg n)
  have hE : 0 ≤ E := Finset.sum_nonneg (fun d _ ↦ hu0 d)
  have htrunc := divisor_weight_truncation_bound (polynomialRootDensity f) hu0 P (D^K)
    (polynomialSieveProduct_squarefree f (polynomialSieveBadProduct f) D).ne_zero (hD2.trans hDpow)
  have hlogpow : log ((D^K:ℕ):ℝ) = (K:ℝ)*log D := by rw [Nat.cast_pow, Real.log_pow]
  have hlogpos : 0 < log ((D^K:ℕ):ℝ) := by rw [hlogpow]; positivity
  have hhalf : (M*log D*E)/log ((D^K:ℕ):ℝ) ≤ E/2 := by
    apply (div_le_iff₀ hlogpos).mpr
    rw [hlogpow]
    have hkM : M ≤ (K:ℝ)/2 := by linarith
    have hh := mul_le_mul_of_nonneg_right hkM (mul_nonneg hlogD.le hE)
    nlinarith only [hh]
  have htrunc' : E ≤ harmonicWeightSum (polynomialRootCount f : ArithmeticFunction ℝ) (D^K) + E/2 := by
    apply htrunc.trans
    apply add_le_add le_rfl
    exact (div_le_div_of_nonneg_right (hmoment D hD2) hlogpos.le).trans hhalf
  rw [hlogpow] at hHpow
  change E ≤ 2*B*(K:ℝ)*log D
  nlinarith only [htrunc', hHpow]

lemma sum_divisors_eq_product_of_squarefree (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (P : ℕ) (hP : Squarefree P) :
    (∑ d ∈ P.divisors, u d) = ∏ p ∈ P.primeFactors, (1+u p) := by
  rw [← ArithmeticFunction.coe_mul_zeta_apply,
    ← (hu.mul ArithmeticFunction.isMultiplicative_zeta.natCast).prod_primeFactors hP]
  apply Finset.prod_congr rfl
  intro p hp
  rw [ArithmeticFunction.coe_mul_zeta_apply, (Nat.prime_of_mem_primeFactors hp).divisors]
  simp [hu.map_one, (Nat.prime_of_mem_primeFactors hp).ne_one.symm]

lemma squarefreeRootCount_rpow_local_summable (f : ℤ[X]) (Q : ℕ) (t : ℝ) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (squarefreeRootCount f Q) t (p^k)‖) := by
  apply summable_of_ne_finset_zero (s := Finset.range 2)
  intro k hk
  rw [arithmeticRpowWeight_prime_pow,
    squarefreeRootCount_prime_pow_eq_zero f Q p k hp (by simpa using hk), zero_div, norm_zero]

lemma squarefreeRootCount_smoothWeightedSum_product (f : ℤ[X]) (Q : ℕ) (t : ℝ) (D : ℕ) :
    smoothWeightedSum (squarefreeRootCount f Q) t D =
      ∏ p ∈ (Finset.range (D+1)).filter Nat.Prime, (1+squarefreeRootCount f Q p/(p:ℝ)^t) := by
  rw [(smooth_weighted_summable_and_euler _ (squarefreeRootCount_multiplicative f Q) t D
    (squarefreeRootCount_rpow_local_summable f Q t)).2]
  apply Finset.prod_congr rfl
  intro p hp
  have hpp := (Finset.mem_filter.mp hp).2
  rw [tsum_eq_sum (s := Finset.range 2) ?_]
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero, pow_one]
    rw [(arithmeticRpowWeight_multiplicative _ (squarefreeRootCount_multiplicative f Q) t).map_one]
    rfl
  · intro k hk
    rw [arithmeticRpowWeight_prime_pow,
      squarefreeRootCount_prime_pow_eq_zero f Q p k hpp (by simpa using hk), zero_div]

lemma squarefreeRootCount_smoothWeightedSum_eq_sieve_divisors (f : ℤ[X]) (Q D : ℕ) :
    smoothWeightedSum (squarefreeRootCount f Q) 1 D =
      ∑ d ∈ (polynomialSieveProduct f Q D).divisors, polynomialRootDensity f d := by
  rw [squarefreeRootCount_smoothWeightedSum_product, sum_divisors_eq_product_of_squarefree _
    (polynomialRootDensity_multiplicative f) _ (polynomialSieveProduct_squarefree f Q D),
    polynomialSieveProduct_primeFactors]
  simp only [Real.rpow_one]
  have hsub : polynomialSievePrimes f Q D ⊆ (Finset.range (D+1)).filter Nat.Prime := by
    intro p hp
    obtain ⟨hpD, hpp, _⟩ := (mem_polynomialSievePrimes f Q D p).mp hp
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hpp⟩
  calc
    _ = ∏ p ∈ polynomialSievePrimes f Q D, (1+squarefreeRootCount f Q p/(p:ℝ)) := by
      symm
      apply Finset.prod_subset hsub
      intro p hp hnot
      obtain ⟨hpD, hpp⟩ := Finset.mem_filter.mp hp
      have hz : squarefreeRootCount f Q p = 0 := by
        rw [squarefreeRootCount_prime f Q p hpp]
        by_cases hpQ : p ∣ Q
        · simp [hpQ]
        · have hroot : polynomialRootCount f p = 0 := by
            by_contra hne
            apply hnot
            apply (mem_polynomialSievePrimes f Q D p).mpr
            exact ⟨by have := Finset.mem_range.mp hpD; omega, hpp, hpQ, Nat.pos_of_ne_zero hne⟩
          simp [hpQ, hroot]
      rw [hz, zero_div, add_zero]
    _ = _ := by
      apply Finset.prod_congr rfl
      intro p hp
      obtain ⟨_, hpp, hpQ, _⟩ := (mem_polynomialSievePrimes f Q D p).mp hp
      rw [squarefreeRootCount_prime f Q p hpp, if_neg hpQ]
      rfl

lemma squarefreeRootCount_smoothWeightedSum_log_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∃ D₀ : ℕ, ∀ D : ℕ, D₀ ≤ D →
      smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) 1 D ≤ C*log D := by
  obtain ⟨C, hC, D₀, hb⟩ := polynomial_sieve_divisor_sum_log_bound f hdeg hirr
  refine ⟨C, hC, D₀, fun D hD ↦ ?_⟩
  rw [squarefreeRootCount_smoothWeightedSum_eq_sieve_divisors]
  exact hb D hD


lemma rpow_sub_one_le_log_chord (p D s : ℝ) (hp : 1 ≤ p) (hpD : p ≤ D) (hD : 1 < D) :
    p^s-1 ≤ (log p/log D)*(D^s-1) := by
  have hp0 : 0 < p := zero_lt_one.trans_le hp
  have hD0 : 0 < D := zero_lt_one.trans hD
  have hlogD : 0 < log D := Real.log_pos hD
  let a := log p/log D
  have ha0 : 0 ≤ a := div_nonneg (Real.log_nonneg hp) hlogD.le
  have ha1 : a ≤ 1 := (div_le_one hlogD).mpr (Real.log_le_log hp0 hpD)
  have he := convexOn_exp.2 (Set.mem_univ (0:ℝ)) (Set.mem_univ (log D*s))
    (show 0 ≤ 1-a by linarith) ha0 (show (1-a)+a=1 by ring)
  simp only [smul_eq_mul, mul_zero, zero_add, Real.exp_zero, mul_one] at he
  have harg : a*(log D*s) = log p*s := by dsimp [a]; field_simp
  rw [harg, ← Real.rpow_def_of_pos hp0, ← Real.rpow_def_of_pos hD0] at he
  change p^s-1 ≤ a*(D^s-1)
  nlinarith only [he]

lemma squarefree_root_prime_tilt_sum_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) :
    ∃ C > (0:ℝ), ∀ D : ℕ, 2 ≤ D → ∀ s : ℝ, 0 ≤ s →
      (∑ p ∈ (Finset.range (D+1)).filter Nat.Prime,
        (squarefreeRootCount f (polynomialSieveBadProduct f) p/(p:ℝ))*((p:ℝ)^s-1)) ≤
          C*((D:ℝ)^s-1) := by
  obtain ⟨B, hB, hprime⟩ := prime_log_harmonic_bound
  refine ⟨(f.natDegree:ℝ)*B, mul_pos (by exact_mod_cast Nat.pos_of_ne_zero hdeg) hB, ?_⟩
  intro D hD s hs
  have hD1 : (1:ℝ) < D := by exact_mod_cast (show 1 < D by omega)
  have hlogD : 0 < log (D:ℝ) := Real.log_pos hD1
  have hDs : 0 ≤ (D:ℝ)^s-1 := sub_nonneg.mpr (Real.one_le_rpow hD1.le hs)
  let c := (f.natDegree:ℝ)*((D:ℝ)^s-1)/log D
  have hc : 0 ≤ c := div_nonneg (mul_nonneg (Nat.cast_nonneg _) hDs) hlogD.le
  calc
    _ ≤ ∑ p ∈ (Finset.range (D+1)).filter Nat.Prime, c*(log p/(p:ℝ)) := by
      apply Finset.sum_le_sum
      intro p hp
      obtain ⟨hpD, hpp⟩ := Finset.mem_filter.mp hp
      have hp1 : (1:ℝ) ≤ p := by exact_mod_cast hpp.one_lt.le
      have hpDR : (p:ℝ) ≤ D := by exact_mod_cast (show p ≤ D by have := Finset.mem_range.mp hpD; omega)
      have hps : 0 ≤ (p:ℝ)^s-1 := sub_nonneg.mpr (Real.one_le_rpow hp1 hs)
      have hval := squarefreeRootCount_prime_le_degree f hdeg p hpp
      have hh := mul_le_mul (div_le_div_of_nonneg_right hval (Nat.cast_nonneg p))
        (rpow_sub_one_le_log_chord p D s hp1 hpDR hD1) hps
        (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg p))
      exact hh.trans_eq (by dsimp [c]; ring)
    _ = c * ∑ p ∈ (Finset.range (D+1)).filter Nat.Prime, log p/(p:ℝ) := (Finset.mul_sum ..).symm
    _ ≤ c*(B*log D) := mul_le_mul_of_nonneg_left (hprime D hD) hc
    _ = _ := by dsimp [c]; field_simp

lemma one_add_div_rpow_tilt_bound (r p s : ℝ) (hr : 0 ≤ r) (hp : 1 ≤ p) (hs : 0 ≤ s) :
    1+r/p^(1-s) ≤ (1+r/p)*Real.exp ((r/p)*(p^s-1)) := by
  have hp0 : 0 < p := zero_lt_one.trans_le hp
  have hps : 0 ≤ p^s-1 := sub_nonneg.mpr (Real.one_le_rpow hp hs)
  have ha : 0 ≤ r/p := div_nonneg hr hp0.le
  have hb : 0 ≤ (r/p)*(p^s-1) := mul_nonneg ha hps
  have he := Real.add_one_le_exp ((r/p)*(p^s-1))
  have hstart : 1+r/p^(1-s) = 1+(r/p)*p^s := by
    rw [Real.rpow_sub hp0, Real.rpow_one]
    field_simp
  rw [hstart]
  calc
    _ ≤ (1+r/p)*(1+(r/p)*(p^s-1)) := by
      nlinarith only [mul_nonneg ha hb]
    _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith only [he]) (by positivity)

lemma squarefreeRootCount_smoothWeightedSum_tilt_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) :
    ∃ C > (0:ℝ), ∀ D : ℕ, 2 ≤ D → ∀ s : ℝ, 0 ≤ s →
      smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) (1-s) D ≤
        smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) 1 D *
          Real.exp (C*((D:ℝ)^s-1)) := by
  obtain ⟨C, hC, htilt⟩ := squarefree_root_prime_tilt_sum_bound f hdeg
  refine ⟨C, hC, ?_⟩
  intro D hD s hs
  let Q := polynomialSieveBadProduct f
  rw [squarefreeRootCount_smoothWeightedSum_product, squarefreeRootCount_smoothWeightedSum_product]
  simp only [Real.rpow_one]
  calc
    _ ≤ ∏ p ∈ (Finset.range (D+1)).filter Nat.Prime,
        (1+squarefreeRootCount f Q p/(p:ℝ)) *
          Real.exp ((squarefreeRootCount f Q p/(p:ℝ))*((p:ℝ)^s-1)) := by
      apply Finset.prod_le_prod
      · intro p hp
        exact add_nonneg zero_le_one (div_nonneg (squarefreeRootCount_nonneg f Q p) (by positivity))
      · intro p hp
        exact one_add_div_rpow_tilt_bound _ p s (squarefreeRootCount_nonneg f Q p)
          (by exact_mod_cast (Finset.mem_filter.mp hp).2.one_lt.le) hs
    _ = (∏ p ∈ (Finset.range (D+1)).filter Nat.Prime, (1+squarefreeRootCount f Q p/(p:ℝ))) *
        Real.exp (∑ p ∈ (Finset.range (D+1)).filter Nat.Prime,
          (squarefreeRootCount f Q p/(p:ℝ))*((p:ℝ)^s-1)) := by
      rw [Finset.prod_mul_distrib, Real.exp_sum]
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (htilt D hD s hs))
      exact Finset.prod_nonneg (fun p _ ↦ add_nonneg zero_le_one
        (div_nonneg (squarefreeRootCount_nonneg f Q p) (Nat.cast_nonneg p)))

lemma squarefree_root_smooth_rankin_uniform (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C₁ > (0:ℝ), ∃ C₂ > (0:ℝ), ∃ D₀ : ℕ, ∀ D A B : ℕ, D₀ ≤ D → 0 < A →
      ∀ s : ℝ, 0 ≤ s →
      (∑ a ∈ smoothModuliBand A B D, squarefreeRootCount f (polynomialSieveBadProduct f) a/(a:ℝ)) ≤
        C₁*log D*Real.exp (C₂*((D:ℝ)^s-1))/(A:ℝ)^s := by
  obtain ⟨C₁, hC₁, D₀, hbase⟩ := squarefreeRootCount_smoothWeightedSum_log_bound f hdeg hirr
  obtain ⟨C₂, hC₂, htilt⟩ := squarefreeRootCount_smoothWeightedSum_tilt_bound f hdeg
  refine ⟨C₁, hC₁, C₂, hC₂, max 2 D₀, ?_⟩
  intro D A B hD hA s hs
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  let Q := polynomialSieveBadProduct f
  apply (smoothModuliBand_rankin_bound _ (squarefreeRootCount_multiplicative f Q)
    (squarefreeRootCount_nonneg f Q) s hs (squarefreeRootCount_rpow_local_summable f Q (1-s)) A B D hA).trans
  apply div_le_div_of_nonneg_right _ (by positivity)
  exact (htilt D hD2 s hs).trans (mul_le_mul_of_nonneg_right (hbase D hDD) (Real.exp_nonneg _))


lemma arithmeticRpowWeight_local_gap_bound (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (p : ℕ) (hp : p.Prime) (t : ℝ) (ht : 0 < t) (B : ℝ) (hB : 0 ≤ B)
    (hup : u p = 0) (huB : ∀ k : ℕ, ‖u (p^k)‖ ≤ B)
    (hs : Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖)) :
    (∑' k : ℕ, ‖arithmeticRpowWeight u t (p^k)‖) ≤
      1 + (B/(1-((2:ℝ)^t)⁻¹))/(p:ℝ)^(2*t) := by
  have hp2 : (2:ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hp0 : (0:ℝ) < p := by linarith
  have hpt : 0 < (p:ℝ)^t := Real.rpow_pos_of_pos hp0 t
  have h2t : 0 < (2:ℝ)^t := by positivity
  have hq0 : 0 ≤ ((p:ℝ)^t)⁻¹ := by positivity
  have hq1 : ((p:ℝ)^t)⁻¹ < 1 := inv_lt_one_of_one_lt₀
    (Real.one_lt_rpow (by exact_mod_cast hp.one_lt) ht)
  have hq2 : ((2:ℝ)^t)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (Real.one_lt_rpow (by norm_num) ht)
  have hqle : ((p:ℝ)^t)⁻¹ ≤ ((2:ℝ)^t)⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le h2t
      (Real.rpow_le_rpow (by norm_num) hp2 ht.le)
  have hg := (summable_geometric_of_lt_one hq0 hq1).mul_left (B/((p:ℝ)^t)^2)
  have hs1 := (summable_nat_add_iff 1).mpr hs
  rw [hs.tsum_eq_zero_add, hs1.tsum_eq_zero_add]
  have hone : arithmeticRpowWeight u t 1 = 1 := (arithmeticRpowWeight_multiplicative u hu t).map_one
  have hprime : arithmeticRpowWeight u t p = 0 := by
    change u p/(p:ℝ)^t = 0
    rw [hup, zero_div]
  simp only [pow_zero, hone, norm_one, zero_add, pow_one, hprime, norm_zero]
  refine add_le_add le_rfl ?_
  calc
    _ ≤ ∑' k : ℕ, B/((p:ℝ)^t)^2 * (((p:ℝ)^t)⁻¹)^k := by
      apply ((summable_nat_add_iff 2).mpr hs).tsum_le_tsum _ hg
      intro k
      rw [arithmeticRpowWeight_prime_pow, norm_div,
        Real.norm_of_nonneg (show 0 ≤ ((p:ℝ)^t)^(k+2) by positivity)]
      calc
        _ ≤ B/((p:ℝ)^t)^(k+2) := div_le_div_of_nonneg_right (huB _) (by positivity)
        _ = _ := by rw [pow_add, inv_pow]; ring
    _ = B/((p:ℝ)^t)^2 * (1-((p:ℝ)^t)⁻¹)⁻¹ := by
      rw [tsum_mul_left, tsum_geometric_of_lt_one hq0 hq1]
    _ ≤ B/((p:ℝ)^t)^2 * (1-((2:ℝ)^t)⁻¹)⁻¹ := by
      apply mul_le_mul_of_nonneg_left _ (div_nonneg hB (by positivity))
      simpa only [one_div] using one_div_le_one_div_of_le (by linarith : 0 < 1-((2:ℝ)^t)⁻¹)
        (show 1-((2:ℝ)^t)⁻¹ ≤ 1-((p:ℝ)^t)⁻¹ by linarith)
    _ = _ := by
      have he : ((p:ℝ)^t)^2 = (p:ℝ)^(2*t) := by
        rw [← Real.rpow_mul_natCast (Nat.cast_nonneg p)]
        congr 1
        push_cast
        ring
      rw [he]
      ring

lemma arithmeticRpowWeight_summable_of_good_gap (u : ArithmeticFunction ℝ) (hu : u.IsMultiplicative)
    (t : ℝ) (ht : 1/2 < t) (S : Finset ℕ) (B : ℝ) (hB : 0 ≤ B)
    (hlocal : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖))
    (hgood : ∀ p : ℕ, p.Prime → p ∉ S → u p = 0 ∧ ∀ k : ℕ, ‖u (p^k)‖ ≤ B) :
    Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight u t n‖) := by
  let A : ℝ := B/(1-((2:ℝ)^t)⁻¹)
  have ht0 : 0 < t := by linarith
  have hq : ((2:ℝ)^t)⁻¹ < 1 := inv_lt_one_of_one_lt₀ (Real.one_lt_rpow (by norm_num) ht0)
  have hA : 0 ≤ A := div_nonneg hB (by linarith)
  let C : ℕ → ℝ := fun p ↦ if p ∈ S then
    ∑' k : ℕ, ‖arithmeticRpowWeight u t (p^k)‖ else A/(p:ℝ)^(2*t)
  have hCpos : ∀ p, 0 ≤ C p := by
    intro p
    dsimp [C]
    split_ifs
    · exact tsum_nonneg (fun _ ↦ abs_nonneg _)
    · exact div_nonneg hA (by positivity)
  have hbase : Summable (fun p : ℕ ↦ A/(p:ℝ)^(2*t)) := by
    simpa only [div_eq_mul_inv] using
      (Real.summable_nat_rpow_inv.mpr (show 1 < 2*t by linarith)).mul_left A
  have hC : Summable C := hbase.congr_cofinite (by
    filter_upwards [S.finite_toSet.compl_mem_cofinite] with p hp
    exact (if_neg hp).symm)
  have hv := arithmeticRpowWeight_multiplicative u hu t
  apply summable_of_multiplicative_local_bound (fun n ↦ ‖arithmeticRpowWeight u t n‖)
    (by simp) (by dsimp only; rw [hv.map_one, norm_one]) (fun _ ↦ norm_nonneg _) _ C hC hCpos hlocal
  · intro p hp
    by_cases hpS : p ∈ S
    · simp only [C, if_pos hpS]
      linarith
    · obtain ⟨hup, hbound⟩ := hgood p hp hpS
      simpa only [C, if_neg hpS, A] using
        arithmeticRpowWeight_local_gap_bound u hu p hp t ht0 B hB hup hbound (hlocal p hp)
  · intro m n hmn
    dsimp only
    rw [hv.map_mul_of_coprime hmn, norm_mul]


/-- A positive majorant correction from squarefree roots to arbitrary roots. -/
noncomputable def rootSquarefreeCorrection (f : ℤ[X]) (Q : ℕ) : ArithmeticFunction ℝ :=
  multiplicativeExtension (fun p k ↦ if k = 0 then 1 else
    if k = 1 ∧ ¬p ∣ Q then 0 else (polynomialRootCount f (p^k):ℝ))

lemma rootSquarefreeCorrection_multiplicative (f : ℤ[X]) (Q : ℕ) :
    (rootSquarefreeCorrection f Q).IsMultiplicative := multiplicativeExtension_multiplicative _

lemma rootSquarefreeCorrection_prime_pow (f : ℤ[X]) (Q p k : ℕ) (hp : p.Prime) :
    rootSquarefreeCorrection f Q (p^k) = if k = 0 then 1 else
      if k = 1 ∧ ¬p ∣ Q then 0 else (polynomialRootCount f (p^k):ℝ) :=
  multiplicativeExtension_prime_pow _ p k hp (by simp)

lemma rootSquarefreeCorrection_nonneg (f : ℤ[X]) (Q n : ℕ) : 0 ≤ rootSquarefreeCorrection f Q n := by
  unfold rootSquarefreeCorrection multiplicativeExtension
  simp only [ArithmeticFunction.coe_mk]
  split_ifs
  · exact le_rfl
  · simp only [Finsupp.prod]
    apply Finset.prod_nonneg
    intro p hp
    split_ifs <;> positivity

lemma rootSquarefreeCorrection_prime_pow_le (f : ℤ[X]) (Q p k : ℕ) (hp : p.Prime) :
    rootSquarefreeCorrection f Q (p^k) ≤ (polynomialRootCount f (p^k):ℝ) := by
  rw [rootSquarefreeCorrection_prime_pow f Q p k hp]
  by_cases hk0 : k = 0
  · simp [hk0, (polynomialRootCount_multiplicative f).map_one]
  · rw [if_neg hk0]
    split_ifs
    · exact Nat.cast_nonneg _
    · exact le_rfl

lemma rootSquarefreeCorrection_local_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (Q : ℕ) (t : ℝ) (ht : 0 < t) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (rootSquarefreeCorrection f Q) t (p^k)‖) := by
  apply Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) _
    (rootCount_positive_rpow_local_summable f hdeg hirr t ht p hp)
  intro k
  rw [Real.norm_of_nonneg (arithmeticRpowWeight_nonneg _ (rootSquarefreeCorrection_nonneg f Q) t _),
    Real.norm_of_nonneg (arithmeticRpowWeight_nonneg _ (fun _ ↦ Nat.cast_nonneg _) t _)]
  exact div_le_div_of_nonneg_right (rootSquarefreeCorrection_prime_pow_le f Q p k hp) (by positivity)

lemma rootSquarefreeCorrection_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 1/2 < t) :
    Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight
      (rootSquarefreeCorrection f (polynomialSieveBadProduct f)) t n‖) := by
  let Q := polynomialSieveBadProduct f
  have hQ : Q ≠ 0 := polynomialSieveBadProduct_ne_zero f hdeg hirr
  apply arithmeticRpowWeight_summable_of_good_gap _ (rootSquarefreeCorrection_multiplicative f Q)
    t ht Q.primeFactors (f.natDegree:ℝ) (Nat.cast_nonneg _)
    (rootSquarefreeCorrection_local_summable f hdeg hirr Q t (by linarith))
  intro p hp hpQ
  have hnot : ¬p ∣ Q := fun h ↦ hpQ (Nat.mem_primeFactors.mpr ⟨hp, h, hQ⟩)
  have hres : ¬(p:ℤ) ∣ f.resultant f.derivative := by
    intro hd
    apply hnot
    apply dvd_mul_of_dvd_right
    simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hd
  haveI : Fact p.Prime := ⟨hp⟩
  refine ⟨?_, ?_⟩
  · simpa only [pow_one] using (rootSquarefreeCorrection_prime_pow f Q p 1 hp).trans (by simp [hnot])
  · intro k
    rw [Real.norm_of_nonneg (rootSquarefreeCorrection_nonneg f Q _)]
    apply (rootSquarefreeCorrection_prime_pow_le f Q p k hp).trans
    cases k with
    | zero =>
      rw [pow_zero, (polynomialRootCount_multiplicative f).map_one, Nat.cast_one]
      exact_mod_cast (show 1 ≤ f.natDegree from Nat.pos_of_ne_zero hdeg)
    | succ k =>
      change ((polynomialRootResidues f (p^(k+1))).card:ℝ) ≤ f.natDegree
      rw [rootResidues_prime_pow_of_not_dvd_resultant f hdeg p k hres]
      exact_mod_cast rootResidues_prime_le_natDegree_of_simple f p
        (simple_roots_of_not_dvd_resultant f hdeg p hres)

lemma polynomialRootCount_le_squarefree_convolution (f : ℤ[X]) (Q n : ℕ) :
    (polynomialRootCount f n:ℝ) ≤
      (squarefreeRootCount f Q * rootSquarefreeCorrection f Q) n := by
  let v := squarefreeRootCount f Q
  let w := rootSquarefreeCorrection f Q
  apply multiplicative_le_of_prime_powers (polynomialRootCount f : ArithmeticFunction ℝ) (v*w)
    (polynomialRootCount_multiplicative f).natCast
    ((squarefreeRootCount_multiplicative f Q).mul (rootSquarefreeCorrection_multiplicative f Q))
    (fun _ ↦ Nat.cast_nonneg _) _ n
  intro p hp k
  rw [convolution_prime_pow v w p k hp]
  have hnonneg : ∀ j : ℕ, 0 ≤ v (p^j)*w (p^(k-j)) := fun j ↦
    mul_nonneg (squarefreeRootCount_nonneg f Q _) (rootSquarefreeCorrection_nonneg f Q _)
  by_cases hgap : k = 1 ∧ ¬p ∣ Q
  · obtain ⟨rfl, hpQ⟩ := hgap
    have hsingle := Finset.single_le_sum (s := Finset.range (1+1))
      (f := fun j ↦ v (p^j)*w (p^(1-j))) (fun j _ ↦ hnonneg j) (show 1 ∈ Finset.range (1+1) by simp)
    have hw1 : w 1 = 1 := (rootSquarefreeCorrection_multiplicative f Q).map_one
    have hvp : v p = (polynomialRootCount f p:ℝ) := by
      rw [squarefreeRootCount_prime f Q p hp, if_neg hpQ]
    simpa only [pow_one, Nat.sub_self, pow_zero, hw1, hvp, mul_one] using hsingle
  · have hwp : w (p^k) = (polynomialRootCount f (p^k):ℝ) := by
      rw [rootSquarefreeCorrection_prime_pow f Q p k hp]
      by_cases hk0 : k = 0
      · simp [hk0, (polynomialRootCount_multiplicative f).map_one]
      · rw [if_neg hk0, if_neg hgap]
    have hsingle := Finset.single_le_sum (s := Finset.range (k+1))
      (f := fun j ↦ v (p^j)*w (p^(k-j))) (fun j _ ↦ hnonneg j) (show 0 ∈ Finset.range (k+1) by simp)
    have hv1 : v 1 = 1 := (squarefreeRootCount_multiplicative f Q).map_one
    simpa only [pow_zero, hv1, Nat.sub_zero, hwp, one_mul] using hsingle


lemma arithmeticRpowWeight_mul (u v : ArithmeticFunction ℝ) (t : ℝ) :
    arithmeticRpowWeight (u*v) t = arithmeticRpowWeight u t * arithmeticRpowWeight v t := by
  ext n
  change (u*v) n/(n:ℝ)^t = _
  rw [ArithmeticFunction.mul_apply, Finset.sum_div, ArithmeticFunction.mul_apply]
  apply Finset.sum_congr rfl
  intro d hd
  have hdN : d.1*d.2 = n := (Nat.mem_divisorsAntidiagonal.mp hd).1
  change u d.1*v d.2/(n:ℝ)^t = (u d.1/(d.1:ℝ)^t)*(v d.2/(d.2:ℝ)^t)
  rw [← hdN, Nat.cast_mul, Real.mul_rpow (Nat.cast_nonneg _) (Nat.cast_nonneg _), div_mul_div_comm]

lemma arithmeticRpowWeight_mul_local_summable (u v : ArithmeticFunction ℝ) (t : ℝ) (p : ℕ) (hp : p.Prime)
    (hu : Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖))
    (hv : Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight v t (p^k)‖)) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (u*v) t (p^k)‖) := by
  have hs := summable_norm_sum_mul_range_of_summable_norm hu hv
  apply hs.congr
  intro k
  rw [arithmeticRpowWeight_mul, convolution_prime_pow _ _ p k hp]

lemma smoothWeightedSum_mul (u v : ArithmeticFunction ℝ)
    (hu : u.IsMultiplicative) (hv : v.IsMultiplicative) (t : ℝ) (D : ℕ)
    (hlocalu : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖))
    (hlocalv : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight v t (p^k)‖)) :
    smoothWeightedSum (u*v) t D = smoothWeightedSum u t D * smoothWeightedSum v t D := by
  rw [(smooth_weighted_summable_and_euler (u*v) (hu.mul hv) t D
      (fun p hp ↦ arithmeticRpowWeight_mul_local_summable u v t p hp (hlocalu p hp) (hlocalv p hp))).2,
    (smooth_weighted_summable_and_euler u hu t D hlocalu).2,
    (smooth_weighted_summable_and_euler v hv t D hlocalv).2, ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro p hp
  have hpp := (Finset.mem_filter.mp hp).2
  rw [tsum_mul_tsum_eq_tsum_sum_range_of_summable_norm (hlocalu p hpp) (hlocalv p hpp)]
  apply tsum_congr
  intro k
  rw [arithmeticRpowWeight_mul, convolution_prime_pow _ _ p k hpp]

lemma smoothWeightedSum_nonneg (u : ArithmeticFunction ℝ) (hu0 : ∀ n, 0 ≤ u n) (t : ℝ) (D : ℕ) :
    0 ≤ smoothWeightedSum u t D :=
  tsum_nonneg (fun n ↦ Set.indicator_nonneg (fun n _ ↦ arithmeticRpowWeight_nonneg u hu0 t n) n)

lemma arithmeticRpowWeight_antitone_exponent (u : ArithmeticFunction ℝ) (hu0 : ∀ n, 0 ≤ u n)
    (t s : ℝ) (hts : t ≤ s) (n : ℕ) : arithmeticRpowWeight u s n ≤ arithmeticRpowWeight u t n := by
  by_cases hn : n = 0
  · simp [hn]
  have hn1 : (1:ℝ) ≤ n := by exact_mod_cast (show 1 ≤ n from Nat.pos_of_ne_zero hn)
  have hnpos : (0:ℝ) < n := zero_lt_one.trans_le hn1
  exact div_le_div_of_nonneg_left (hu0 n) (Real.rpow_pos_of_pos hnpos t)
    (Real.rpow_le_rpow_of_exponent_le hn1 hts)

lemma arithmeticRpowWeight_summable_mono (u : ArithmeticFunction ℝ) (hu0 : ∀ n, 0 ≤ u n)
    (t s : ℝ) (hts : t ≤ s) (hs : Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight u t n‖)) :
    Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight u s n‖) := by
  apply Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) _ hs
  intro n
  rw [Real.norm_of_nonneg (arithmeticRpowWeight_nonneg u hu0 s n),
    Real.norm_of_nonneg (arithmeticRpowWeight_nonneg u hu0 t n)]
  exact arithmeticRpowWeight_antitone_exponent u hu0 t s hts n

lemma arithmeticRpowWeight_local_of_global (u : ArithmeticFunction ℝ) (t : ℝ)
    (hs : Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight u t n‖)) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖) :=
  hs.comp_injective (Nat.pow_right_injective hp.two_le)

lemma smoothWeightedSum_le_full_of_exponent_le (u : ArithmeticFunction ℝ) (hu0 : ∀ n, 0 ≤ u n)
    (t s : ℝ) (hts : t ≤ s) (hs : Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight u t n‖)) (D : ℕ) :
    smoothWeightedSum u s D ≤ ∑' n : ℕ, arithmeticRpowWeight u t n := by
  have hnonneg : ∀ n : ℕ, 0 ≤ (Nat.smoothNumbers (D+1)).indicator (arithmeticRpowWeight u s) n :=
    fun n ↦ Set.indicator_nonneg (fun n _ ↦ arithmeticRpowWeight_nonneg u hu0 s n) n
  have hpoint : ∀ n : ℕ, (Nat.smoothNumbers (D+1)).indicator (arithmeticRpowWeight u s) n ≤
      arithmeticRpowWeight u t n := by
    intro n
    by_cases hn : n ∈ Nat.smoothNumbers (D+1)
    · rw [Set.indicator_of_mem hn]
      exact arithmeticRpowWeight_antitone_exponent u hu0 t s hts n
    · rw [Set.indicator_of_notMem hn]
      exact arithmeticRpowWeight_nonneg u hu0 t n
  have hsum := Summable.of_nonneg_of_le hnonneg hpoint hs.of_norm
  exact hsum.tsum_le_tsum hpoint hs.of_norm

lemma smoothWeightedSum_le_mul_of_pointwise (u v : ArithmeticFunction ℝ)
    (hu : u.IsMultiplicative) (hv : v.IsMultiplicative) (C t : ℝ) (D : ℕ)
    (hpoint : ∀ n, u n ≤ C*v n)
    (hlocalu : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖))
    (hlocalv : ∀ p : ℕ, p.Prime → Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight v t (p^k)‖)) :
    smoothWeightedSum u t D ≤ C*smoothWeightedSum v t D := by
  have hsu := (smooth_weighted_summable_and_euler u hu t D hlocalu).1
  have hsv := (smooth_weighted_summable_and_euler v hv t D hlocalv).1
  rw [smoothWeightedSum, smoothWeightedSum, ← tsum_mul_left]
  apply hsu.tsum_le_tsum _ (hsv.mul_left C)
  intro n
  by_cases hn : n ∈ Nat.smoothNumbers (D+1)
  · rw [Set.indicator_of_mem hn, Set.indicator_of_mem hn]
    change u n/(n:ℝ)^t ≤ C*(v n/(n:ℝ)^t)
    have hh := div_le_div_of_nonneg_right (hpoint n) (Real.rpow_nonneg (Nat.cast_nonneg n) t)
    simpa only [mul_div_assoc] using hh
  · rw [Set.indicator_of_notMem hn, Set.indicator_of_notMem hn, mul_zero]

lemma polynomialRootCount_smoothWeightedSum_le_squarefree (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ t : ℝ, 3/4 ≤ t → ∀ D : ℕ,
      smoothWeightedSum (polynomialRootCount f : ArithmeticFunction ℝ) t D ≤
        C*smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) t D := by
  let Q := polynomialSieveBadProduct f
  let u := squarefreeRootCount f Q
  let w := rootSquarefreeCorrection f Q
  let C := ∑' n : ℕ, arithmeticRpowWeight w (3/4) n
  have hsC := rootSquarefreeCorrection_summable f hdeg hirr (3/4) (by norm_num)
  have hC1 : 1 ≤ C := by
    have hh := hsC.of_norm.le_tsum 1 (fun n _ ↦ arithmeticRpowWeight_nonneg w (rootSquarefreeCorrection_nonneg f Q) (3/4) n)
    change arithmeticRpowWeight w (3/4) 1 ≤ C at hh
    rwa [(arithmeticRpowWeight_multiplicative w (rootSquarefreeCorrection_multiplicative f Q) (3/4)).map_one] at hh
  refine ⟨C, zero_lt_one.trans_le hC1, ?_⟩
  intro t ht D
  have ht0 : 0 < t := by linarith
  have hlu := squarefreeRootCount_rpow_local_summable f Q t
  have hlw := rootSquarefreeCorrection_local_summable f hdeg hirr Q t ht0
  have hmul := smoothWeightedSum_le_mul_of_pointwise (polynomialRootCount f : ArithmeticFunction ℝ) (u*w)
    (polynomialRootCount_multiplicative f).natCast
    ((squarefreeRootCount_multiplicative f Q).mul (rootSquarefreeCorrection_multiplicative f Q)) 1 t D
    (by intro n; simpa only [one_mul] using polynomialRootCount_le_squarefree_convolution f Q n)
    (rootCount_positive_rpow_local_summable f hdeg hirr t ht0)
    (fun p hp ↦ arithmeticRpowWeight_mul_local_summable u w t p hp (hlu p hp) (hlw p hp))
  rw [one_mul, smoothWeightedSum_mul u w (squarefreeRootCount_multiplicative f Q)
    (rootSquarefreeCorrection_multiplicative f Q) t D hlu hlw] at hmul
  calc
    _ ≤ smoothWeightedSum u t D * smoothWeightedSum w t D := hmul
    _ ≤ smoothWeightedSum u t D * C := mul_le_mul_of_nonneg_left
      (smoothWeightedSum_le_full_of_exponent_le w (rootSquarefreeCorrection_nonneg f Q) (3/4) t ht hsC D)
      (smoothWeightedSum_nonneg u (squarefreeRootCount_nonneg f Q) t D)
    _ = _ := mul_comm _ _

lemma root_smooth_rankin_uniform (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) :
    ∃ C₁ > (0:ℝ), ∃ C₂ > (0:ℝ), ∃ D₀ : ℕ, ∀ D A B : ℕ, D₀ ≤ D → 0 < A →
      ∀ s : ℝ, 0 ≤ s → s ≤ 1/4 →
      (∑ a ∈ smoothModuliBand A B D, (polynomialRootCount f a:ℝ)/(a:ℝ)) ≤
        C₁*log D*Real.exp (C₂*((D:ℝ)^s-1))/(A:ℝ)^s := by
  obtain ⟨K, hK, hcomp⟩ := polynomialRootCount_smoothWeightedSum_le_squarefree f hdeg hirr
  obtain ⟨C₁, hC₁, D₀, hbase⟩ := squarefreeRootCount_smoothWeightedSum_log_bound f hdeg hirr
  obtain ⟨C₂, hC₂, htilt⟩ := squarefreeRootCount_smoothWeightedSum_tilt_bound f hdeg
  refine ⟨K*C₁, mul_pos hK hC₁, C₂, hC₂, max 2 D₀, ?_⟩
  intro D A B hD hA s hs hs1
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have ht0 : 0 < 1-s := by linarith
  have hRs := smoothModuliBand_rankin_bound (polynomialRootCount f : ArithmeticFunction ℝ)
    (polynomialRootCount_multiplicative f).natCast (fun _ ↦ Nat.cast_nonneg _) s hs
    (rootCount_positive_rpow_local_summable f hdeg hirr (1-s) ht0) A B D hA
  apply hRs.trans
  apply div_le_div_of_nonneg_right _ (by positivity)
  calc
    _ ≤ K*smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) (1-s) D :=
      hcomp (1-s) (by linarith) D
    _ ≤ K*(smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) 1 D *
        Real.exp (C₂*((D:ℝ)^s-1))) := mul_le_mul_of_nonneg_left (htilt D hD2 s hs) hK.le
    _ ≤ K*(C₁*log D*Real.exp (C₂*((D:ℝ)^s-1))) := mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right (hbase D hDD) (Real.exp_nonneg _)) hK.le
    _ = _ := by ring


lemma rootSieveCorrection_rpow_local_summable (f : ℤ[X]) (Q : ℕ) (t : ℝ) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (rootSieveCorrection f Q) t (p^k)‖) := by
  apply summable_of_ne_finset_zero (s := Finset.range 2)
  intro k hk
  have hk2 : 2 ≤ k := by simpa using hk
  rw [arithmeticRpowWeight_prime_pow, rootSieveCorrection_prime_pow f Q p k hp,
    if_neg (by omega), if_neg (by omega), zero_div, norm_zero]

lemma rootSieveCorrection_rpow_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) (t : ℝ) (ht : 0 < t) :
    Summable (fun n : ℕ ↦ ‖arithmeticRpowWeight (rootSieveCorrection f (polynomialSieveBadProduct f)) t n‖) := by
  let Q := polynomialSieveBadProduct f
  let w := rootSieveCorrection f Q
  let v := arithmeticRpowWeight w t
  let C : ℕ → ℝ := fun p ↦ 2*(f.natDegree:ℝ)^2/(p:ℝ)^(1+t)
  have hv : v.IsMultiplicative := arithmeticRpowWeight_multiplicative w (rootSieveCorrection_multiplicative f Q) t
  have hC : Summable C := by
    simpa only [C, div_eq_mul_inv] using
      (Real.summable_nat_rpow_inv.mpr (show 1 < 1+t by linarith)).mul_left (2*(f.natDegree:ℝ)^2)
  apply summable_of_multiplicative_local_bound (fun n ↦ ‖v n‖) (by simp)
    (by dsimp only; rw [hv.map_one, norm_one]) (fun _ ↦ norm_nonneg _)
    (by intro m n hmn; dsimp only; rw [hv.map_mul_of_coprime hmn, norm_mul])
    C hC (fun _ ↦ by dsimp [C]; positivity) (rootSieveCorrection_rpow_local_summable f Q t)
  intro p hp
  have hp0 : (0:ℝ) < p := by exact_mod_cast hp.pos
  rw [tsum_eq_sum (s := Finset.range 2) ?_]
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero, hv.map_one, norm_one, pow_one]
    have hwp : w p = 2*(squarefreeRootCount f Q p)^2/(p:ℝ) := by
      simpa only [pow_one] using rootSieveCorrection_prime_pow f Q p 1 hp
    have hval : v p = 2*(squarefreeRootCount f Q p)^2/(p:ℝ)^(1+t) := by
      change w p/(p:ℝ)^t = _
      rw [hwp, div_div, Real.rpow_add hp0, Real.rpow_one]
    rw [hval, Real.norm_of_nonneg (by positivity)]
    apply add_le_add le_rfl
    dsimp [C]
    apply div_le_div_of_nonneg_right _ (by positivity)
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (squarefreeRootCount_nonneg f Q p)
      (squarefreeRootCount_prime_le_degree f hdeg p hp) 2) (by norm_num)
  · intro k hk
    have hk2 : 2 ≤ k := by simpa using hk
    change ‖arithmeticRpowWeight w t (p^k)‖ = 0
    rw [arithmeticRpowWeight_prime_pow, rootSieveCorrection_prime_pow f Q p k hp,
      if_neg (by omega), if_neg (by omega), zero_div, norm_zero]

lemma arithmeticFunction_mul_nonneg (u v : ArithmeticFunction ℝ)
    (hu0 : ∀ n, 0 ≤ u n) (hv0 : ∀ n, 0 ≤ v n) (n : ℕ) : 0 ≤ (u*v) n := by
  rw [ArithmeticFunction.mul_apply]
  exact Finset.sum_nonneg (fun d _ ↦ mul_nonneg (hu0 d.1) (hv0 d.2))

lemma arithmeticRpowWeight_local_summable_of_le (u v : ArithmeticFunction ℝ)
    (hu0 : ∀ n, 0 ≤ u n) (hv0 : ∀ n, 0 ≤ v n) (C : ℝ)
    (hpoint : ∀ n, u n ≤ C*v n) (t : ℝ) (p : ℕ)
    (hs : Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight v t (p^k)‖)) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight u t (p^k)‖) := by
  apply Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) _ (hs.mul_left C)
  intro k
  rw [Real.norm_of_nonneg (arithmeticRpowWeight_nonneg u hu0 t _),
    Real.norm_of_nonneg (arithmeticRpowWeight_nonneg v hv0 t _)]
  exact (div_le_div_of_nonneg_right (hpoint (p^k)) (by positivity)).trans_eq (by
    change C*v (p^k)/((p^k:ℕ):ℝ)^t = C*(v (p^k)/((p^k:ℕ):ℝ)^t)
    ring)

lemma polynomialRootTau_rpow_local_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 0 < t) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (polynomialRootTau f) t (p^k)‖) := by
  obtain ⟨B, hB⟩ := exists_bound_prime_pow_rootResidues_of_resultant_ne_zero f hdeg
    (resultant_derivative_ne_zero_of_irreducible f hdeg hirr) p hp
  apply arithmeticRpowWeight_local_summable _ t ht p hp (B:ℝ) (Nat.cast_nonneg B)
  intro k
  rw [Real.norm_of_nonneg (polynomialRootTau_nonneg f _), polynomialRootTau_prime_pow f p k hp]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast hB k) (by positivity)

noncomputable def polynomialRootTauSieve (f : ℤ[X]) : ArithmeticFunction ℝ :=
  (polynomialRootTau f).pmul (squarefreeRootDivisorArithmetic f (polynomialSieveBadProduct f))

lemma polynomialRootTauSieve_apply (f : ℤ[X]) (n : ℕ) : polynomialRootTauSieve f n =
    (polynomialRootCount f n:ℝ)*(σ 0 n:ℝ)*squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) n := by
  rw [polynomialRootTauSieve, ArithmeticFunction.pmul_apply, squarefreeRootDivisorArithmetic_apply,
    polynomialRootTau_apply]

lemma polynomialRootTauSieve_multiplicative (f : ℤ[X]) : (polynomialRootTauSieve f).IsMultiplicative :=
  (polynomialRootTau_multiplicative f).pmul (squarefreeRootDivisorArithmetic_multiplicative f _)

lemma polynomialRootTauSieve_nonneg (f : ℤ[X]) (n : ℕ) : 0 ≤ polynomialRootTauSieve f n := by
  rw [polynomialRootTauSieve_apply]
  apply mul_nonneg (by positivity)
  exact Finset.sum_nonneg (fun d _ ↦ div_nonneg (squarefreeRootCount_nonneg f _ d) (Nat.cast_nonneg d))

lemma polynomialRootTauSieve_le_convolution (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) (n : ℕ) :
    polynomialRootTauSieve f n ≤ (rootSieveCorrection f (polynomialSieveBadProduct f)*polynomialRootTau f) n := by
  rw [polynomialRootTauSieve, ArithmeticFunction.pmul_apply, squarefreeRootDivisorArithmetic_apply]
  exact polynomialRootTau_sieve_le_convolution f hdeg n

lemma polynomialRootTauSieve_rpow_local_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 0 < t) (p : ℕ) (hp : p.Prime) :
    Summable (fun k : ℕ ↦ ‖arithmeticRpowWeight (polynomialRootTauSieve f) t (p^k)‖) := by
  apply arithmeticRpowWeight_local_summable_of_le (polynomialRootTauSieve f)
    (rootSieveCorrection f (polynomialSieveBadProduct f)*polynomialRootTau f)
    (polynomialRootTauSieve_nonneg f)
    (arithmeticFunction_mul_nonneg _ _ (rootSieveCorrection_nonneg f _) (polynomialRootTau_nonneg f)) 1
    (by intro n; simpa only [one_mul] using polynomialRootTauSieve_le_convolution f hdeg n) t p
  exact arithmeticRpowWeight_mul_local_summable _ _ t p hp (rootSieveCorrection_rpow_local_summable f _ t p hp)
    (polynomialRootTau_rpow_local_summable f hdeg hirr t ht p hp)


lemma polynomialRootTau_smoothWeightedSum_le_square (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ t : ℝ, 0 < t → ∀ D : ℕ,
      smoothWeightedSum (polynomialRootTau f) t D ≤
        C*(smoothWeightedSum (polynomialRootCount f : ArithmeticFunction ℝ) t D)^2 := by
  obtain ⟨C, hC, hpoint⟩ := polynomialRootCount_tau_le_convolution_square f hdeg hirr
  refine ⟨C, hC, ?_⟩
  intro t ht D
  let r : ArithmeticFunction ℝ := polynomialRootCount f
  have hr : r.IsMultiplicative := (polynomialRootCount_multiplicative f).natCast
  have hrl := rootCount_positive_rpow_local_summable f hdeg hirr t ht
  have hh := smoothWeightedSum_le_mul_of_pointwise (polynomialRootTau f) (r*r)
    (polynomialRootTau_multiplicative f) (hr.mul hr) C t D
    (by intro n; simpa only [pow_two] using hpoint n)
    (polynomialRootTau_rpow_local_summable f hdeg hirr t ht)
    (fun p hp ↦ arithmeticRpowWeight_mul_local_summable r r t p hp (hrl p hp) (hrl p hp))
  rwa [smoothWeightedSum_mul r r hr hr t D hrl hrl, ← pow_two] at hh

lemma polynomialRootTauSieve_smoothWeightedSum_le_squarefree (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ t : ℝ, 3/4 ≤ t → ∀ D : ℕ,
      smoothWeightedSum (polynomialRootTauSieve f) t D ≤
        C*(smoothWeightedSum (squarefreeRootCount f (polynomialSieveBadProduct f)) t D)^2 := by
  obtain ⟨A, hA, hτ⟩ := polynomialRootTau_smoothWeightedSum_le_square f hdeg hirr
  obtain ⟨B, hB, hroot⟩ := polynomialRootCount_smoothWeightedSum_le_squarefree f hdeg hirr
  let Q := polynomialSieveBadProduct f
  let w := rootSieveCorrection f Q
  let K := ∑' n : ℕ, arithmeticRpowWeight w (3/4) n
  have hsK := rootSieveCorrection_rpow_summable f hdeg (3/4) (by norm_num)
  have hK1 : 1 ≤ K := by
    have hh := hsK.of_norm.le_tsum 1 (fun n _ ↦ arithmeticRpowWeight_nonneg w (rootSieveCorrection_nonneg f Q) (3/4) n)
    change arithmeticRpowWeight w (3/4) 1 ≤ K at hh
    rwa [(arithmeticRpowWeight_multiplicative w (rootSieveCorrection_multiplicative f Q) (3/4)).map_one] at hh
  have hK : 0 < K := zero_lt_one.trans_le hK1
  refine ⟨K*A*B^2, by positivity, ?_⟩
  intro t ht D
  have ht0 : 0 < t := by linarith
  have hwlocal := rootSieveCorrection_rpow_local_summable f Q t
  have hvlocal := polynomialRootTau_rpow_local_summable f hdeg hirr t ht0
  have hh := smoothWeightedSum_le_mul_of_pointwise (polynomialRootTauSieve f) (w*polynomialRootTau f)
    (polynomialRootTauSieve_multiplicative f)
    ((rootSieveCorrection_multiplicative f Q).mul (polynomialRootTau_multiplicative f)) 1 t D
    (by intro n; simpa only [one_mul] using polynomialRootTauSieve_le_convolution f hdeg n)
    (polynomialRootTauSieve_rpow_local_summable f hdeg hirr t ht0)
    (fun p hp ↦ arithmeticRpowWeight_mul_local_summable w (polynomialRootTau f) t p hp (hwlocal p hp) (hvlocal p hp))
  rw [one_mul, smoothWeightedSum_mul w (polynomialRootTau f)
    (rootSieveCorrection_multiplicative f Q) (polynomialRootTau_multiplicative f) t D hwlocal hvlocal] at hh
  calc
    _ ≤ smoothWeightedSum w t D * smoothWeightedSum (polynomialRootTau f) t D := hh
    _ ≤ K*smoothWeightedSum (polynomialRootTau f) t D := mul_le_mul_of_nonneg_right
      (smoothWeightedSum_le_full_of_exponent_le w (rootSieveCorrection_nonneg f Q) (3/4) t ht hsK D)
      (smoothWeightedSum_nonneg _ (polynomialRootTau_nonneg f) t D)
    _ ≤ K*(A*(smoothWeightedSum (polynomialRootCount f : ArithmeticFunction ℝ) t D)^2) :=
      mul_le_mul_of_nonneg_left (hτ t ht0 D) hK.le
    _ ≤ K*(A*(B*smoothWeightedSum (squarefreeRootCount f Q) t D)^2) := by
      apply mul_le_mul_of_nonneg_left _ hK.le
      apply mul_le_mul_of_nonneg_left _ hA.le
      exact pow_le_pow_left₀ (smoothWeightedSum_nonneg _ (fun _ ↦ Nat.cast_nonneg _) t D) (hroot t ht D) 2
    _ = _ := by ring

lemma divisor_weighted_root_smooth_rankin_uniform (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C₁ > (0:ℝ), ∃ C₂ > (0:ℝ), ∃ D₀ : ℕ, ∀ D A B : ℕ, D₀ ≤ D → 0 < A →
      ∀ s : ℝ, 0 ≤ s → s ≤ 1/4 →
      (∑ a ∈ smoothModuliBand A B D, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)*
          squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) a/(a:ℝ)) ≤
        C₁*(log D)^2*Real.exp (C₂*((D:ℝ)^s-1))/(A:ℝ)^s := by
  obtain ⟨K, hK, hcomp⟩ := polynomialRootTauSieve_smoothWeightedSum_le_squarefree f hdeg hirr
  obtain ⟨C₁, hC₁, D₀, hbase⟩ := squarefreeRootCount_smoothWeightedSum_log_bound f hdeg hirr
  obtain ⟨C₂, hC₂, htilt⟩ := squarefreeRootCount_smoothWeightedSum_tilt_bound f hdeg
  refine ⟨K*C₁^2, by positivity, 2*C₂, by positivity, max 2 D₀, ?_⟩
  intro D A B hD hA s hs hs1
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_right _ _).trans hD
  have ht0 : 0 < 1-s := by linarith
  let Q := polynomialSieveBadProduct f
  have hsq := (htilt D hD2 s hs).trans
    (mul_le_mul_of_nonneg_right (hbase D hDD) (Real.exp_nonneg _))
  have hR := smoothModuliBand_rankin_bound (polynomialRootTauSieve f)
    (polynomialRootTauSieve_multiplicative f) (polynomialRootTauSieve_nonneg f) s hs
    (polynomialRootTauSieve_rpow_local_summable f hdeg hirr (1-s) ht0) A B D hA
  simp only [polynomialRootTauSieve_apply] at hR
  apply hR.trans
  apply div_le_div_of_nonneg_right _ (by positivity)
  calc
    _ ≤ K*(smoothWeightedSum (squarefreeRootCount f Q) (1-s) D)^2 := hcomp (1-s) (by linarith) D
    _ ≤ K*(C₁*log D*Real.exp (C₂*((D:ℝ)^s-1)))^2 := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (smoothWeightedSum_nonneg _ (squarefreeRootCount_nonneg f Q) (1-s) D) hsq 2) hK.le
    _ = _ := by
      have he : (Real.exp (C₂*((D:ℝ)^s-1)))^2 = Real.exp ((2*C₂)*((D:ℝ)^s-1)) := by
        rw [pow_two, ← Real.exp_add]
        congr 1
        ring
      rw [mul_pow, mul_pow, he]
      ring


/-- Sifted candidate small parts restricted to a smooth interval.  The smoothness
cutoff `D` and the sifting cutoff `Z` are independent. -/
noncomputable def Erdos975SiftedBandSum (f : ℤ[X]) (A B D Z N : ℕ) : ℝ :=
  ∑ a ∈ smoothModuliBand A B D, (σ 0 a:ℝ) *
    (((Finset.range N).filter (fun n : ℕ ↦ (a:ℤ) ∣ f.eval (n:ℤ) ∧
      ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
        ¬(p:ℤ) ∣ f.eval (n:ℤ))).card : ℝ)

lemma erdos975_sifted_band_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∃ Z₀ : ℕ, ∀ A B D Z N : ℕ, Z₀ ≤ Z →
      Erdos975SiftedBandSum f A B D Z N ≤
        (C*N/log Z + (B:ℝ)*(Z:ℝ)^4) *
          ∑ a ∈ smoothModuliBand A B D, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)*
            squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) a/(a:ℝ) := by
  obtain ⟨C, hC, Z₀, hb⟩ := polynomial_restricted_rough_count_log_sieve f hdeg hirr
  refine ⟨C, hC, Z₀, ?_⟩
  intro A B D Z N hZ
  unfold Erdos975SiftedBandSum
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro a ha
  obtain ⟨hAa, haB, _⟩ := (mem_smoothModuliBand A B D a).mp ha
  have ha0 : 0 < a := lt_of_le_of_lt (Nat.zero_le _) hAa
  have haR : (0:ℝ) < a := by exact_mod_cast ha0
  let F := squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) a
  have hF : 1 ≤ F := squarefreeRootDivisorFactor_ge_one f _ a ha0.ne'
  have haBF : (a:ℝ) ≤ B*F := calc
    (a:ℝ) ≤ B := by exact_mod_cast haB
    _ = (B:ℝ)*1 := (mul_one _).symm
    _ ≤ (B:ℝ)*F := mul_le_mul_of_nonneg_left hF (Nat.cast_nonneg _)
  have herr : (polynomialRootCount f a:ℝ)*(Z:ℝ)^4 ≤
      ((B:ℝ)*(Z:ℝ)^4)*((polynomialRootCount f a:ℝ)*F/(a:ℝ)) := by
    rw [← mul_div_assoc]
    apply (le_div_iff₀ haR).mpr
    have hh := mul_le_mul_of_nonneg_left haBF
      (show 0 ≤ (polynomialRootCount f a:ℝ)*(Z:ℝ)^4 by positivity)
    convert hh using 1 <;> ring
  calc
    _ ≤ (σ 0 a:ℝ)*(C*N*(polynomialRootResidues f a).card*F/(a*log Z) +
        (polynomialRootResidues f a).card*(Z:ℝ)^4) :=
      mul_le_mul_of_nonneg_left (hb a Z N ha0 hZ) (Nat.cast_nonneg _)
    _ = (σ 0 a:ℝ)*(C*N*(polynomialRootCount f a:ℝ)*F/(a*log Z) +
        (polynomialRootCount f a:ℝ)*(Z:ℝ)^4) := rfl
    _ ≤ (σ 0 a:ℝ)*(C*N*(polynomialRootCount f a:ℝ)*F/(a*log Z) +
        ((B:ℝ)*(Z:ℝ)^4)*((polynomialRootCount f a:ℝ)*F/a)) :=
      mul_le_mul_of_nonneg_left (add_le_add le_rfl herr) (Nat.cast_nonneg _)
    _ = _ := by ring

lemma erdos975_sifted_band_rankin (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C₀ > (0:ℝ), ∃ C₁ > (0:ℝ), ∃ C₂ > (0:ℝ), ∃ D₀ Z₀ : ℕ,
      ∀ A B D Z N : ℕ, 0 < A → D₀ ≤ D → Z₀ ≤ Z →
      ∀ s : ℝ, 0 ≤ s → s ≤ 1/4 →
      Erdos975SiftedBandSum f A B D Z N ≤
        (C₀*N/log Z+(B:ℝ)*(Z:ℝ)^4) *
          (C₁*(log D)^2*Real.exp (C₂*((D:ℝ)^s-1))/(A:ℝ)^s) := by
  obtain ⟨C₀, hC₀, Z₀, hsieve⟩ := erdos975_sifted_band_bound f hdeg hirr
  obtain ⟨C₁, hC₁, C₂, hC₂, D₀, htail⟩ := divisor_weighted_root_smooth_rankin_uniform f hdeg hirr
  refine ⟨C₀, hC₀, C₁, hC₁, C₂, hC₂, D₀, max 2 Z₀, ?_⟩
  intro A B D Z N hA hD hZ s hs hs1
  have hZZ : Z₀ ≤ Z := (le_max_right _ _).trans hZ
  have hZ2 : 2 ≤ Z := (le_max_left _ _).trans hZ
  have hlog : 0 ≤ log (Z:ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ Z by omega))
  apply (hsieve A B D Z N hZZ).trans
  exact mul_le_mul_of_nonneg_left (htail D A B hD hA s hs hs1) (by positivity)

lemma polynomialRootCount_prime_pow_uniform_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C : ℕ, 0 < C ∧
      ∀ p : ℕ, p.Prime → ∀ k : ℕ, polynomialRootCount f (p^k) ≤ C := by
  obtain ⟨D, hD, hgood⟩ := exists_finite_exception_bounded_prime_pow_roots f hdeg hirr
  have hbound : ∀ p : ℕ, ∃ B : ℕ, 1 ≤ B ∧
      (p.Prime → ∀ k : ℕ, polynomialRootCount f (p^k) ≤ B) := by
    intro p
    by_cases hp : p.Prime
    · obtain ⟨B, hB⟩ := exists_bound_prime_pow_rootResidues_of_resultant_ne_zero f hdeg
        (resultant_derivative_ne_zero_of_irreducible f hdeg hirr) p hp
      exact ⟨max 1 B, le_max_left _ _, fun _ k ↦ (hB k).trans (le_max_right _ _)⟩
    · exact ⟨1, le_rfl, fun hp' ↦ (hp hp').elim⟩
  choose B _hB1 hB using hbound
  refine ⟨max 1 (max f.natDegree (D.primeFactors.sup B)), by omega, ?_⟩
  intro p hp k
  by_cases hpd : p ∣ D
  · have hpD : p ∈ D.primeFactors := Nat.mem_primeFactors.mpr ⟨hp, hpd, hD.ne'⟩
    exact (hB p hp k).trans ((Finset.le_sup hpD).trans
      ((le_max_right _ _).trans (le_max_right _ _)))
  · cases k with
    | zero => simpa only [pow_zero, (polynomialRootCount_multiplicative f).map_one] using
        le_max_left 1 (max f.natDegree (D.primeFactors.sup B))
    | succ k => exact (hgood p hp hpd k).2.trans ((le_max_left _ _).trans (le_max_right _ _))

/-- Inputs where a prime at most `Y` divides the polynomial to a power at least `T`. -/
noncomputable def largePrimePowerExceptionalSet (f : ℤ[X]) (Y T N : ℕ) : Finset ℕ :=
  (Finset.range N).filter (fun n : ℕ ↦ ∃ p ∈ Finset.Icc 1 Y,
    p.Prime ∧ ((p ^ Nat.clog p T : ℕ):ℤ) ∣ f.eval (n:ℤ))

lemma mem_largePrimePowerExceptionalSet_of_pow_dvd (f : ℤ[X]) (Y T N n p k : ℕ)
    (hn : n < N) (hp : p.Prime) (hpY : p ≤ Y) (hTk : T ≤ p^k)
    (hdiv : ((p^k:ℕ):ℤ) ∣ f.eval (n:ℤ)) :
    n ∈ largePrimePowerExceptionalSet f Y T N := by
  refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hn, p,
    Finset.mem_Icc.mpr ⟨hp.pos, hpY⟩, hp, ?_⟩
  apply dvd_trans _ hdiv
  exact Int.natCast_dvd_natCast.mpr (pow_dvd_pow p (Nat.clog_le_of_le_pow hTk))

lemma largePrimePowerExceptionalSet_card_bound (f : ℤ[X]) (C Y T N : ℕ)
    (hT : 0 < T) (hC : ∀ p : ℕ, p.Prime → ∀ k : ℕ, polynomialRootCount f (p^k) ≤ C) :
    ((largePrimePowerExceptionalSet f Y T N).card:ℝ) ≤ (C:ℝ)*Y*((N:ℝ)/T+1) := by
  let P := (Finset.Icc 1 Y).filter Nat.Prime
  let S := fun p : ℕ ↦ (Finset.range N).filter
    (fun n : ℕ ↦ ((p ^ Nat.clog p T : ℕ):ℤ) ∣ f.eval (n:ℤ))
  have hsub : largePrimePowerExceptionalSet f Y T N ⊆ P.biUnion S := by
    intro n hn
    obtain ⟨hnN, p, hpY, hp, hdiv⟩ := Finset.mem_filter.mp hn
    exact Finset.mem_biUnion.mpr ⟨p, Finset.mem_filter.mpr ⟨hpY, hp⟩,
      Finset.mem_filter.mpr ⟨hnN, hdiv⟩⟩
  have hlocal : ∀ p ∈ P, ((S p).card:ℝ) ≤ (C:ℝ)*((N:ℝ)/T+1) := by
    intro p hpP
    have hp : p.Prime := (Finset.mem_filter.mp hpP).2
    have hpow : 0 < p ^ Nat.clog p T := pow_pos hp.pos _
    have hTR : (0:ℝ) < T := by exact_mod_cast hT
    have hTP : (T:ℝ) ≤ (p ^ Nat.clog p T:ℕ) := by exact_mod_cast Nat.le_pow_clog hp.one_lt T
    have hρ : (polynomialRootCount f (p ^ Nat.clog p T):ℝ) ≤ C := by exact_mod_cast hC p hp _
    calc
      _ ≤ (N:ℝ)*(polynomialRootCount f (p ^ Nat.clog p T):ℝ)/(p ^ Nat.clog p T:ℕ) +
          (polynomialRootCount f (p ^ Nat.clog p T):ℝ) := polynomial_divisibility_count_le f _ N hpow
      _ ≤ (N:ℝ)*(C:ℝ)/(p ^ Nat.clog p T:ℕ) + C := add_le_add
        (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hρ (Nat.cast_nonneg _))
          (Nat.cast_nonneg _)) hρ
      _ ≤ (N:ℝ)*(C:ℝ)/T+C := add_le_add
        (div_le_div_of_nonneg_left (by positivity) hTR hTP) le_rfl
      _ = _ := by ring
  have hcard : P.card ≤ Y := by
    apply (Finset.card_filter_le _ _).trans
    simp
  calc
    _ ≤ ((P.biUnion S).card:ℝ) := by exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ p ∈ P, ((S p).card:ℝ) := by exact_mod_cast Finset.card_biUnion_le (s := P) (t := S)
    _ ≤ ∑ _p ∈ P, (C:ℝ)*((N:ℝ)/T+1) := Finset.sum_le_sum hlocal
    _ = (P.card:ℝ)*((C:ℝ)*((N:ℝ)/T+1)) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (Y:ℝ)*((C:ℝ)*((N:ℝ)/T+1)) := mul_le_mul_of_nonneg_right
      (by exact_mod_cast hcard) (by positivity)
    _ = _ := by ring

lemma largePrimePowerExceptionalSet_square_card_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : ∃ C > (0:ℝ), ∀ Y N : ℕ, 0 < Y →
      ((largePrimePowerExceptionalSet f Y (Y^2) N).card:ℝ) ≤ C*((N:ℝ)/Y+Y) := by
  obtain ⟨C, hC, hb⟩ := polynomialRootCount_prime_pow_uniform_bound f hdeg hirr
  refine ⟨C, by exact_mod_cast hC, ?_⟩
  intro Y N hY
  have hYR : (Y:ℝ) ≠ 0 := by exact_mod_cast hY.ne'
  convert largePrimePowerExceptionalSet_card_bound f C Y (Y^2) N (pow_pos hY _) hb using 1
  push_cast
  field_simp
  <;> ring


noncomputable def Erdos975ExceptionalPrimePowerSum (f : ℤ[X]) (Y T N : ℕ) : ℝ :=
  ∑ n ∈ largePrimePowerExceptionalSet f Y T N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)

lemma exceptional_prime_power_sum_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (ε : ℝ) (hε : 0 < ε) :
    ∃ C > (0:ℝ), ∀ Y N : ℕ, 0 < Y →
      Erdos975ExceptionalPrimePowerSum f Y (Y^2) N ≤ C*(N:ℝ)^ε*((N:ℝ)/Y+Y) := by
  obtain ⟨B, hB, hpoint⟩ := sigma_zero_polynomial_subpolynomial_bound f ε hε
  obtain ⟨C, hC, hcount⟩ := largePrimePowerExceptionalSet_square_card_bound f hdeg hirr
  refine ⟨B*C, mul_pos hB hC, ?_⟩
  intro Y N hY
  calc
    _ ≤ ∑ _n ∈ largePrimePowerExceptionalSet f Y (Y^2) N, B*(N:ℝ)^ε := by
      apply Finset.sum_le_sum
      intro n hn
      apply (hpoint n).trans
      apply mul_le_mul_of_nonneg_left _ hB.le
      apply Real.rpow_le_rpow (by positivity) _ hε.le
      have hnN := Finset.mem_range.mp (Finset.mem_filter.mp hn).1
      exact_mod_cast (show n+1 ≤ N by omega)
    _ = B*(N:ℝ)^ε*((largePrimePowerExceptionalSet f Y (Y^2) N).card:ℝ) := by
      rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
    _ ≤ B*(N:ℝ)^ε*(C*((N:ℝ)/Y+Y)) := mul_le_mul_of_nonneg_left (hcount Y N hY) (by positivity)
    _ = _ := by ring

lemma exceptional_prime_power_sum_on_powers (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (M : ℕ) (hM : 2 ≤ M) :
    ∃ C > (0:ℝ), ∀ Y : ℕ, 0 < Y →
      Erdos975ExceptionalPrimePowerSum f Y (Y^2) (Y^M) ≤ C*(Y:ℝ)^M := by
  have hMR : (0:ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  obtain ⟨C, hC, hb⟩ := exceptional_prime_power_sum_bound f hdeg hirr (1/(M:ℝ)) (by positivity)
  refine ⟨2*C, by positivity, ?_⟩
  intro Y hY
  have hYR : (0:ℝ) < Y := by exact_mod_cast hY
  have hpow : ((Y^M:ℕ):ℝ)^(1/(M:ℝ)) = Y := by
    rw [Nat.cast_pow, ← Real.rpow_natCast_mul (Nat.cast_nonneg Y), mul_one_div_cancel hMR.ne', Real.rpow_one]
  have hYY : (Y:ℝ)^2 ≤ (Y:ℝ)^M := by exact_mod_cast Nat.pow_le_pow_right hY hM
  calc
    _ ≤ C*((Y^M:ℕ):ℝ)^(1/(M:ℝ))*(((Y^M:ℕ):ℝ)/Y+Y) := hb Y (Y^M) hY
    _ = C*((Y:ℝ)^M+(Y:ℝ)^2) := by rw [hpow, Nat.cast_pow]; field_simp
    _ ≤ (2*C)*(Y:ℝ)^M := by nlinarith

lemma smoothPrimePart_zero (n : ℕ) : smoothPrimePart n 0 = 1 := by
  apply Finset.prod_eq_one
  intro p hp
  have hprime := Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1
  have hle := (Finset.mem_filter.mp hp).2
  exact (hprime.pos.not_ge hle).elim

lemma smoothPrimePart_mono (n : ℕ) : Monotone (smoothPrimePart n) := by
  intro D E hDE
  unfold smoothPrimePart
  apply Finset.prod_le_prod_of_subset_of_one_le'
  · intro p hp
    exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hp).1, ((Finset.mem_filter.mp hp).2).trans hDE⟩
  · intro p hp _
    exact Nat.one_le_pow _ _ (Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1).pos

lemma smoothPrimePart_succ (n D : ℕ) :
    smoothPrimePart n (D+1) = smoothPrimePart n D * (D+1)^n.factorization (D+1) := by
  by_cases hmem : D+1 ∈ n.primeFactors
  · have hfilter : n.primeFactors.filter (fun p ↦ p ≤ D+1) =
        insert (D+1) (n.primeFactors.filter (fun p ↦ p ≤ D)) := by
      ext p
      simp only [Finset.mem_filter, Finset.mem_insert]
      constructor
      · rintro ⟨hp, hple⟩
        by_cases hEq : p = D+1
        · exact Or.inl hEq
        · exact Or.inr ⟨hp, by omega⟩
      · rintro (rfl | ⟨hp, hpD⟩)
        · exact ⟨hmem, le_rfl⟩
        · exact ⟨hp, by omega⟩
    rw [smoothPrimePart, hfilter, Finset.prod_insert (by simp)]
    exact mul_comm _ _
  · have hexp : n.factorization (D+1) = 0 := by
      simpa only [← Nat.support_factorization, Finsupp.notMem_support_iff] using hmem
    have hfilter : n.primeFactors.filter (fun p ↦ p ≤ D+1) =
        n.primeFactors.filter (fun p ↦ p ≤ D) := by
      ext p
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨hp, hpD⟩
        have hpne : p ≠ D+1 := fun h ↦ hmem (h ▸ hp)
        exact ⟨hp, by omega⟩
      · exact fun ⟨hp, hpD⟩ ↦ ⟨hp, by omega⟩
    simp only [smoothPrimePart, hfilter, hexp, pow_zero, mul_one]

lemma smoothPrimePart_first_crossing (m A Y : ℕ) (hA : 0 < A)
    (hlarge : A < smoothPrimePart m Y) :
    ∃ p : ℕ, p.Prime ∧ p ≤ Y ∧ smoothPrimePart m (p-1) ≤ A ∧
      A < smoothPrimePart m p := by
  have he : ∃ p : ℕ, A < smoothPrimePart m p := ⟨Y, hlarge⟩
  let p := Nat.find he
  have hcross : A < smoothPrimePart m p := Nat.find_spec he
  have hpY : p ≤ Y := Nat.find_min' he hlarge
  have hp0 : 0 < p := by
    by_contra h
    have hzero : p = 0 := by omega
    rw [hzero, smoothPrimePart_zero] at hcross
    omega
  have hprev : smoothPrimePart m (p-1) ≤ A := by
    exact le_of_not_gt (Nat.find_min he (show p-1 < p by omega))
  have heq : smoothPrimePart m p = smoothPrimePart m (p-1)*p^m.factorization p := by
    have hh := smoothPrimePart_succ m (p-1)
    simpa only [Nat.sub_add_cancel hp0] using hh
  have hp : p.Prime := by
    by_contra hprime
    rw [heq, Nat.factorization_eq_zero_of_not_prime m hprime, pow_zero, mul_one] at hcross
    omega
  exact ⟨p, hp, hpY, hprev, hcross⟩

lemma first_crossing_band_of_small_prime_power (m Y p : ℕ) (hp : p.Prime)
    (hprev : smoothPrimePart m (p-1) ≤ Y^4)
    (hcross : Y^4 < smoothPrimePart m p) (hpower : p^m.factorization p < Y^2) :
    Y^2 < smoothPrimePart m (p-1) ∧ smoothPrimePart m (p-1) ≤ Y^4 := by
  refine ⟨?_, hprev⟩
  have heq : smoothPrimePart m p = smoothPrimePart m (p-1)*p^m.factorization p := by
    simpa only [Nat.sub_add_cancel hp.pos] using smoothPrimePart_succ m (p-1)
  rw [heq] at hcross
  by_contra h
  have hle : smoothPrimePart m (p-1) ≤ Y^2 := by omega
  have hh := Nat.mul_le_mul hle hpower.le
  nlinarith [show Y^2*Y^2 = Y^4 by ring]


lemma polynomial_first_crossing_outside_exceptional (f : ℤ[X]) (Y N n : ℕ)
    (hY : 0 < Y) (hn : n < N)
    (hlarge : Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ Y)
    (hnot : n ∉ largePrimePowerExceptionalSet f Y (Y^2) N) :
    ∃ p : ℕ, p.Prime ∧ p ≤ Y ∧
      Y^2 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (p-1) ∧
      smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (p-1) ≤ Y^4 ∧
      Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ p := by
  let m := ⌊f.eval (n:ℤ)⌋₊
  have hm : m ≠ 0 := by
    intro hm0
    have hs : smoothPrimePart m Y = 1 := by simp [smoothPrimePart, hm0]
    change Y^4 < smoothPrimePart m Y at hlarge
    rw [hs] at hlarge
    have := pow_pos hY 4
    omega
  have hzpos : 1 ≤ f.eval (n:ℤ) := Nat.floor_pos.mp (Nat.pos_of_ne_zero hm)
  have he : (m:ℤ) = f.eval (n:ℤ) := by
    rw [show m = ⌊f.eval (n:ℤ)⌋₊ from rfl, Nat.floor_int]
    exact Int.toNat_of_nonneg (by omega)
  obtain ⟨p, hp, hpY, hprev, hcross⟩ := smoothPrimePart_first_crossing m (Y^4) Y (pow_pos hY _) hlarge
  have hpower : p^m.factorization p < Y^2 := by
    by_contra h
    apply hnot
    apply mem_largePrimePowerExceptionalSet_of_pow_dvd f Y (Y^2) N n p (m.factorization p)
      hn hp hpY (by omega)
    rw [← he]
    exact Int.natCast_dvd_natCast.mpr (Nat.ordProj_dvd m p)
  exact ⟨p, hp, hpY, (first_crossing_band_of_small_prime_power m Y p hp hprev hcross hpower).1,
    hprev, hcross⟩

lemma Erdos975SiftedBandSum_swap (f : ℤ[X]) (A B D Z N : ℕ) :
    Erdos975SiftedBandSum f A B D Z N =
      ∑ n ∈ Finset.range N, ∑ a ∈ smoothModuliBand A B D,
        if (a:ℤ) ∣ f.eval (n:ℤ) ∧
            (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
              ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
  unfold Erdos975SiftedBandSum
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a ha
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]

lemma polynomial_smooth_band_part_pointwise (f : ℤ[X]) (n A B D Z k a b : ℕ)
    (ha : a ∈ smoothModuliBand A B D) (hab : a.Coprime b)
    (heq : f.eval (n:ℤ) = (a*b:ℕ)) (hτb : σ 0 b ≤ 2^k)
    (hrough : ∀ p : ℕ, p.Prime → p ∣ b → Z < p) :
    (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ (2:ℝ)^k *
      ∑ a ∈ smoothModuliBand A B D, if (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
  have hfloor : ⌊f.eval (n:ℤ)⌋₊ = a*b := by rw [heq, Nat.floor_natCast]
  have haeval : (a:ℤ) ∣ f.eval (n:ℤ) := by
    rw [heq]
    exact Int.natCast_dvd_natCast.mpr (dvd_mul_right a b)
  have hsift : ∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
      ¬(p:ℤ) ∣ f.eval (n:ℤ) := by
    intro p hp hpeval
    obtain ⟨hpZ, hprime, hpQa, _⟩ := (mem_polynomialSievePrimes _ _ _ _).mp hp
    have hpa : ¬p ∣ a := fun h ↦ hpQa (dvd_mul_of_dvd_right h _)
    have hpab : p ∣ a*b := by
      apply Int.natCast_dvd_natCast.mp
      rwa [heq] at hpeval
    have hpb := (hprime.dvd_mul.mp hpab).resolve_left hpa
    exact (hrough p hprime hpb).not_ge hpZ
  have hsum : (σ 0 a:ℝ) ≤ ∑ a ∈ smoothModuliBand A B D, if (a:ℤ) ∣ f.eval (n:ℤ) ∧
      (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
        ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
    have hs := Finset.single_le_sum
      (f := fun a : ℕ ↦ if (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0)
      (fun _ _ ↦ by dsimp only; split_ifs <;> positivity) ha
    have hcond : (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) := ⟨haeval, hsift⟩
    simpa only [if_pos hcond] using hs
  rw [hfloor, ArithmeticFunction.isMultiplicative_sigma.map_mul_of_coprime hab, Nat.cast_mul]
  calc
    _ ≤ (σ 0 a:ℝ)*(2:ℝ)^k :=
      mul_le_mul_of_nonneg_left (by exact_mod_cast hτb) (Nat.cast_nonneg _)
    _ ≤ _ := by simpa only [mul_comm] using mul_le_mul_of_nonneg_left hsum (by positivity : (0:ℝ) ≤ 2^k)

lemma polynomial_crossing_band_pointwise (f : ℤ[X]) (n Y p D Z j K : ℕ)
    (hp : p.Prime) (hpD : p ≤ D) (hZp : Z < p) (hYp : Y ≤ p^(j+1))
    (hz : 1 ≤ f.eval (n:ℤ)) (hbound : ⌊f.eval (n:ℤ)⌋₊ ≤ Y^K)
    (hprev0 : Y^2 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (p-1))
    (hprev1 : smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (p-1) ≤ Y^4) :
    (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ (2:ℝ)^(K*(j+1)) *
      ∑ a ∈ smoothModuliBand (Y^2) (Y^4) D, if (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ q ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) Z,
          ¬(q:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0 := by
  let m := ⌊f.eval (n:ℤ)⌋₊
  have hm : 0 < m := Nat.floor_pos.mpr hz
  have he : (m:ℤ) = f.eval (n:ℤ) := by
    rw [show m = ⌊f.eval (n:ℤ)⌋₊ from rfl, Nat.floor_int]
    exact Int.toNat_of_nonneg (by omega)
  let a := smoothPrimePart m (p-1)
  let b := roughPrimePart m (p-1)
  have hprod : a*b = m := smoothPrimePart_mul_roughPrimePart m (p-1) hm.ne'
  have hrough : ∀ q : ℕ, q.Prime → q ∣ b → p ≤ q := by
    intro q hq hqb
    have hh := prime_dvd_roughPrimePart_gt m (p-1) q hq hqb
    omega
  apply polynomial_smooth_band_part_pointwise f n (Y^2) (Y^4) D Z (K*(j+1)) a b
  · apply (mem_smoothModuliBand _ _ _ _).mpr
    exact ⟨hprev0, hprev1, fun q hq hqa ↦
      (prime_dvd_smoothPrimePart_le m (p-1) q hq hqa).trans ((Nat.sub_le _ _).trans hpD)⟩
  · exact smoothPrimePart_coprime_roughPrimePart m (p-1)
  · rw [hprod, he]
  · apply sigma_zero_rough_bound b p (K*(j+1)) (roughPrimePart_pos m (p-1)).ne' hp.two_le
    · calc
        b ≤ m := by rw [← hprod]; exact Nat.le_mul_of_pos_left _ (smoothPrimePart_pos _ _)
        _ ≤ Y^K := hbound
        _ ≤ (p^(j+1))^K := Nat.pow_le_pow_left hYp _
        _ = p^(K*(j+1)) := by rw [← pow_mul, Nat.mul_comm]
    · exact hrough
  · exact fun q hq hqb ↦ hZp.trans_le (hrough q hq hqb)



lemma fixed_tilt_exp_identity (K j : ℕ) :
    (2:ℝ)^(K*(j+1)) * Real.exp (-((K:ℝ)+1)*log 2*j) =
      (2:ℝ)^K * (1/2:ℝ)^j := by
  have htwo : (2:ℝ)^(K*(j+1)) = Real.exp ((K*(j+1):ℕ)*log 2) := by
    rw [Real.exp_nat_mul, Real.exp_log (by norm_num)]
  have htwoK : (2:ℝ)^K = Real.exp ((K:ℝ)*log 2) := by
    rw [Real.exp_nat_mul, Real.exp_log (by norm_num)]
  have hhalf : (1/2:ℝ)^j = Real.exp ((j:ℝ)*(-log 2)) := by
    rw [Real.exp_nat_mul, Real.exp_neg, Real.exp_log (by norm_num), one_div]
  rw [htwo, htwoK, hhalf, ← Real.exp_add, ← Real.exp_add]
  congr 1
  push_cast
  ring

lemma fixed_tilt_rankin_denominator (Y D j : ℕ) (L : ℝ) (hY : 0 < Y)
    (hD : 1 < D) (hL : 0 ≤ L) (hpow : D^j ≤ Y) :
    Real.exp (2*L*j) ≤ ((Y^2:ℕ):ℝ)^(L/log D) := by
  have hYR : (0:ℝ) < Y := by exact_mod_cast hY
  have hDR : (0:ℝ) < D := by exact_mod_cast (show 0 < D by omega)
  have hlogD : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast hD)
  have hlogpow : (j:ℝ)*log D ≤ log (Y:ℝ) := by
    have h := Real.log_le_log (pow_pos hDR j) (show (D:ℝ)^j ≤ Y by exact_mod_cast hpow)
    rwa [Real.log_pow] at h
  rw [Nat.cast_pow, Real.rpow_def_of_pos (pow_pos hYR 2), Real.log_pow]
  apply Real.exp_le_exp.mpr
  have hh := mul_le_mul_of_nonneg_right hlogpow (show 0 ≤ 2*L/log (D:ℝ) by positivity)
  convert hh using 1 <;> push_cast <;> field_simp <;> ring

lemma divisor_weighted_root_smooth_geometric (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (K : ℕ) :
    ∃ C > (0:ℝ), ∃ D₀ : ℕ, ∀ Y D j : ℕ, 0 < Y → D₀ ≤ D → D^j ≤ Y →
      (2:ℝ)^(K*(j+1)) *
        (∑ a ∈ smoothModuliBand (Y^2) (Y^4) D, (polynomialRootCount f a:ℝ)*(σ 0 a:ℝ)*
          squarefreeRootDivisorFactor f (polynomialSieveBadProduct f) a/(a:ℝ)) ≤
        C*(log D)^2*(1/2:ℝ)^j := by
  obtain ⟨C₁, hC₁, C₂, hC₂, D₀, hb⟩ := divisor_weighted_root_smooth_rankin_uniform f hdeg hirr
  let L : ℝ := ((K:ℝ)+1)*log 2/2
  have hlog2 : 0 < log (2:ℝ) := Real.log_pos (by norm_num)
  have hL : 0 < L := by dsimp [L]; positivity
  obtain ⟨D₁, hD₁⟩ := eventually_atTop.mp
    ((Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))).eventually_ge_atTop (4*L))
  let E := Real.exp (C₂*(Real.exp L-1))
  refine ⟨C₁*E*(2:ℝ)^K, by dsimp [E]; positivity, max 2 (max D₀ D₁), ?_⟩
  intro Y D j hY hD hpow
  have hD2 : 2 ≤ D := (le_max_left _ _).trans hD
  have hDD : D₀ ≤ D := (le_max_left _ _).trans ((le_max_right _ _).trans hD)
  have hDD₁ : D₁ ≤ D := (le_max_right _ _).trans ((le_max_right _ _).trans hD)
  have hlogD : 0 < log (D:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < D by omega))
  have hLD : 4*L ≤ log (D:ℝ) := hD₁ D hDD₁
  let s : ℝ := L/log D
  have hs : 0 ≤ s := div_nonneg hL.le hlogD.le
  have hs1 : s ≤ 1/4 := by
    apply (div_le_iff₀ hlogD).mpr
    linarith
  have hDs : (D:ℝ)^s = Real.exp L := by
    rw [Real.rpow_def_of_pos (show (0:ℝ) < D by exact_mod_cast (show 0 < D by omega))]
    congr 1
    dsimp [s]
    field_simp
  have hden := fixed_tilt_rankin_denominator Y D j L hY (by omega) hL.le hpow
  have htail := hb D (Y^2) (Y^4) hDD (pow_pos hY _) s hs hs1
  rw [hDs] at htail
  have hE : 0 < E := Real.exp_pos _
  calc
    _ ≤ (2:ℝ)^(K*(j+1))*(C₁*(log D)^2*E/((Y^2:ℕ):ℝ)^s) :=
      mul_le_mul_of_nonneg_left htail (by positivity)
    _ ≤ (2:ℝ)^(K*(j+1))*(C₁*(log D)^2*E/Real.exp (2*L*j)) :=
      mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_left (by positivity) (Real.exp_pos _) hden) (by positivity)
    _ = (C₁*E)*(log D)^2*((2:ℝ)^(K*(j+1))*Real.exp (-((K:ℝ)+1)*log 2*j)) := by
      rw [div_eq_mul_inv, ← Real.exp_neg]
      have he : -(2*L*(j:ℝ)) = -((K:ℝ)+1)*log 2*j := by dsimp [L]; ring
      rw [he]
      ring
    _ = _ := by rw [fixed_tilt_exp_identity]; ring

lemma erdos975_sifted_band_geometric (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (K : ℕ) :
    ∃ C₀ > (0:ℝ), ∃ C₁ > (0:ℝ), ∃ D₀ Z₀ : ℕ,
      ∀ Y D Z N j : ℕ, 0 < Y → D₀ ≤ D → Z₀ ≤ Z → D^j ≤ Y →
      (2:ℝ)^(K*(j+1))*Erdos975SiftedBandSum f (Y^2) (Y^4) D Z N ≤
        C₁*(C₀*N/log Z+(Y:ℝ)^4*(Z:ℝ)^4)*(log D)^2*(1/2:ℝ)^j := by
  obtain ⟨C₀, hC₀, Z₀, hb⟩ := erdos975_sifted_band_bound f hdeg hirr
  obtain ⟨C₁, hC₁, D₀, ht⟩ := divisor_weighted_root_smooth_geometric f hdeg hirr K
  refine ⟨C₀, hC₀, C₁, hC₁, D₀, max 2 Z₀, ?_⟩
  intro Y D Z N j hY hD hZ hpow
  have hZZ : Z₀ ≤ Z := (le_max_right _ _).trans hZ
  have hZ2 : 2 ≤ Z := (le_max_left _ _).trans hZ
  have hlog : 0 ≤ log (Z:ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ Z by omega))
  apply (mul_le_mul_of_nonneg_left (hb (Y^2) (Y^4) D Z N hZZ) (by positivity : (0:ℝ) ≤ 2^(K*(j+1)))).trans
  have hh := mul_le_mul_of_nonneg_left (ht Y D j hY hD hpow)
    (show 0 ≤ C₀*N/log Z+(Y:ℝ)^4*(Z:ℝ)^4 by positivity)
  convert hh using 1 <;> push_cast <;> ring



/-- Integer cutoff for the reciprocal-power prime-size bands. -/
noncomputable def rootSieveCutoff (Y j : ℕ) : ℕ := ⌊(Y:ℝ)^((j:ℝ)⁻¹)⌋₊

lemma rootSieveCutoff_pow_le (Y j : ℕ) (hj : 0 < j) : (rootSieveCutoff Y j)^j ≤ Y := by
  have hjR : (0:ℝ) < j := by exact_mod_cast hj
  have hfloor := Nat.floor_le (Real.rpow_nonneg (Nat.cast_nonneg Y) ((j:ℝ)⁻¹))
  have hh := (Real.le_rpow_inv_iff_of_pos (Nat.cast_nonneg (rootSieveCutoff Y j))
    (Nat.cast_nonneg Y) hjR).mp hfloor
  rw [Real.rpow_natCast] at hh
  exact_mod_cast hh

lemma pow_le_iff_le_rootSieveCutoff (Y j p : ℕ) (hj : 0 < j) :
    p^j ≤ Y ↔ p ≤ rootSieveCutoff Y j := by
  have hjR : (0:ℝ) < j := by exact_mod_cast hj
  rw [rootSieveCutoff, Nat.le_floor_iff (Real.rpow_nonneg (Nat.cast_nonneg Y) _),
    Real.le_rpow_inv_iff_of_pos (Nat.cast_nonneg _) (Nat.cast_nonneg _) hjR,
    Real.rpow_natCast]
  exact_mod_cast Iff.rfl

lemma rootSieveCutoff_lt_of_lt_pow (Y j p : ℕ) (hj : 0 < j) (h : Y < p^j) :
    rootSieveCutoff Y j < p := by
  by_contra hnot
  have hh := (Nat.pow_le_pow_left (show p ≤ rootSieveCutoff Y j by omega) j).trans
    (rootSieveCutoff_pow_le Y j hj)
  omega

lemma lt_rootSieveCutoff_add_one_pow (Y j : ℕ) (hj : 0 < j) :
    Y < (rootSieveCutoff Y j+1)^j := by
  by_contra hnot
  have hh := (pow_le_iff_le_rootSieveCutoff Y j (rootSieveCutoff Y j+1) hj).mp (by omega)
  omega

lemma rootSieveCutoff_le (Y j : ℕ) (hY : 0 < Y) (hj : 0 < j) : rootSieveCutoff Y j ≤ Y := by
  have hYR : (1:ℝ) ≤ Y := by exact_mod_cast hY
  have hjR : (1:ℝ) ≤ j := by exact_mod_cast hj
  have hh := Nat.floor_le (Real.rpow_nonneg (Nat.cast_nonneg Y) ((j:ℝ)⁻¹))
  have hh' := Real.rpow_le_rpow_of_exponent_le hYR (inv_le_one_of_one_le₀ hjR)
  rw [Real.rpow_one] at hh'
  exact_mod_cast hh.trans hh'

lemma rootSieveCutoff_log_comparison (Y j : ℕ) (hj : 0 < j)
    (hZ : 2 ≤ rootSieveCutoff Y (j+1)) (hD : 0 < rootSieveCutoff Y j) :
    log (rootSieveCutoff Y j:ℝ) ≤ 4*log (rootSieveCutoff Y (j+1):ℝ) := by
  let D := rootSieveCutoff Y j
  let Z := rootSieveCutoff Y (j+1)
  have hDj := rootSieveCutoff_pow_le Y j hj
  have hYj := lt_rootSieveCutoff_add_one_pow Y (j+1) (by omega)
  have hDR : (0:ℝ) < D := by exact_mod_cast hD
  have hZR : (0:ℝ) < Z := by exact_mod_cast (show 0 < Z by omega)
  have hZsq : (Z:ℝ)+1 ≤ (Z:ℝ)^2 := by
    have hZ2 : (2:ℝ) ≤ Z := by exact_mod_cast hZ
    nlinarith
  have hlogZ : 0 ≤ log (Z:ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ Z by omega))
  have hlogs : log ((Z:ℝ)+1) ≤ 2*log Z := by
    have hh := Real.log_le_log (by positivity : 0 < (Z:ℝ)+1) hZsq
    simpa only [Real.log_pow, Nat.cast_ofNat] using hh
  have hlogp : (j:ℝ)*log D ≤ (j+1:ℝ)*log ((Z:ℝ)+1) := by
    have hpow : (D:ℝ)^j ≤ ((Z:ℝ)+1)^(j+1) := by exact_mod_cast hDj.trans hYj.le
    have hh := Real.log_le_log (pow_pos hDR j) hpow
    simpa only [Real.log_pow, Nat.cast_add, Nat.cast_one] using hh
  have hjR : (1:ℝ) ≤ j := by exact_mod_cast hj
  have hh := mul_le_mul_of_nonneg_left hlogs (show 0 ≤ (j+1:ℝ) by positivity)
  have hh' : (j+1:ℝ)*(2*log Z) ≤ (j:ℝ)*(4*log Z) := by nlinarith
  exact (mul_le_mul_iff_right₀ (show (0:ℝ) < j by positivity)).mp
    (hlogp.trans (hh.trans hh'))

noncomputable def rootSieveBandIndices (Y T : ℕ) : Finset ℕ :=
  (Finset.Icc 1 (Nat.log 2 Y)).filter (fun j ↦
    T ≤ rootSieveCutoff Y j ∧ T ≤ rootSieveCutoff Y (j+1))

lemma prime_rootSieveBand_index (Y T p : ℕ) (hT : 0 < T) (hp : p.Prime)
    (hpY : p ≤ Y) (hTp : T^2 < p) :
    Nat.log p Y ∈ rootSieveBandIndices Y T ∧
      p ≤ rootSieveCutoff Y (Nat.log p Y) ∧
      rootSieveCutoff Y (Nat.log p Y+1) < p := by
  let j := Nat.log p Y
  have hj : 0 < j := Nat.log_pos hp.one_lt hpY
  have hY : Y ≠ 0 := (hp.pos.trans_le hpY).ne'
  have hpj : p^j ≤ Y := Nat.pow_log_le_self p hY
  have hYp : Y < p^(j+1) := Nat.lt_pow_succ_log_self hp.one_lt Y
  have hj2 : j ≤ Nat.log 2 Y := Nat.log_antitone_left (by norm_num) hp.one_lt hp.two_le
  have hpD : p ≤ rootSieveCutoff Y j := (pow_le_iff_le_rootSieveCutoff Y j p hj).mp hpj
  have hTp' : T ≤ p := calc
    T ≤ T^2 := by nlinarith
    _ ≤ p := hTp.le
  have hTZ : T ≤ rootSieveCutoff Y (j+1) := by
    apply (pow_le_iff_le_rootSieveCutoff Y (j+1) T (by omega)).mp
    calc
      T^(j+1) ≤ T^(2*j) := Nat.pow_le_pow_right hT (by omega)
      _ = (T^2)^j := pow_mul T 2 j
      _ ≤ p^j := Nat.pow_le_pow_left hTp.le _
      _ ≤ Y := hpj
  exact ⟨Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hj, hj2⟩, hTp'.trans hpD, hTZ⟩,
    hpD, rootSieveCutoff_lt_of_lt_pow Y (j+1) p (by omega) hYp⟩



lemma sifted_band_coefficient_bound (C : ℝ) (hC : 0 ≤ C) (Y D Z : ℕ)
    (hY : 1 ≤ Y) (hD : 2 ≤ D) (hZ : 2 ≤ Z) (hDY : D ≤ Y) (hZY : Z ≤ Y)
    (hlogs : log (D:ℝ) ≤ 4*log (Z:ℝ)) :
    (C*(Y:ℝ)^12/log Z+(Y:ℝ)^4*(Z:ℝ)^4)*(log D)^2 ≤
      (4*C+1)*(Y:ℝ)^12*(log Y+1) := by
  have hYR : (1:ℝ) ≤ Y := by exact_mod_cast hY
  have hDR : (1:ℝ) < D := by exact_mod_cast (show 1 < D by omega)
  have hZR : (1:ℝ) < Z := by exact_mod_cast (show 1 < Z by omega)
  have hlogD : 0 < log (D:ℝ) := Real.log_pos hDR
  have hlogZ : 0 < log (Z:ℝ) := Real.log_pos hZR
  have hlogY : 0 ≤ log (Y:ℝ) := Real.log_nonneg hYR
  have hlogDY : log (D:ℝ) ≤ log Y := Real.log_le_log (by linarith) (by exact_mod_cast hDY)
  have hfrac : (log (D:ℝ))^2/log Z ≤ 4*log Y := by
    calc
      _ ≤ 4*log D := by
        apply (div_le_iff₀ hlogZ).mpr
        nlinarith [mul_le_mul_of_nonneg_right hlogs hlogD.le]
      _ ≤ 4*log Y := by linarith
  have hmain : C*(Y:ℝ)^12/log Z*(log D)^2 ≤ 4*C*(Y:ℝ)^12*log Y := by
    have hh := mul_le_mul_of_nonneg_left hfrac (show 0 ≤ C*(Y:ℝ)^12 by positivity)
    convert hh using 1 <;> ring
  have hlogDY' : log (D:ℝ) ≤ Y := hlogDY.trans
    ((Real.log_le_sub_one_of_pos (by linarith : (0:ℝ) < Y)).trans (by linarith))
  have herr : (Y:ℝ)^4*(Z:ℝ)^4*(log D)^2 ≤ (Y:ℝ)^12 := by
    calc
      _ ≤ (Y:ℝ)^4*(Y:ℝ)^4*(Y:ℝ)^2 := mul_le_mul
        (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg Z) (by exact_mod_cast hZY) 4) (by positivity))
        (pow_le_pow_left₀ hlogD.le hlogDY' 2) (by positivity) (by positivity)
      _ = (Y:ℝ)^10 := by ring
      _ ≤ (Y:ℝ)^12 := pow_le_pow_right₀ hYR (by norm_num)
  calc
    _ = C*(Y:ℝ)^12/log Z*(log D)^2+(Y:ℝ)^4*(Z:ℝ)^4*(log D)^2 := by ring
    _ ≤ 4*C*(Y:ℝ)^12*log Y+(Y:ℝ)^12 := add_le_add hmain herr
    _ ≤ _ := by
      have hh := add_nonneg (mul_nonneg (mul_nonneg (by positivity : 0 ≤ 4*C) (by positivity : 0 ≤ (Y:ℝ)^12)) zero_le_one)
        (mul_nonneg (by positivity : 0 ≤ (Y:ℝ)^12) hlogY)
      nlinarith

lemma erdos975_geometric_band_sum_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (K : ℕ) :
    ∃ C > (0:ℝ), ∃ T₀ : ℕ, 2 ≤ T₀ ∧ ∀ T Y : ℕ, T₀ ≤ T → 0 < Y →
      (∑ j ∈ rootSieveBandIndices Y T, (2:ℝ)^(K*(j+1))*
        Erdos975SiftedBandSum f (Y^2) (Y^4) (rootSieveCutoff Y j)
          (rootSieveCutoff Y (j+1)) (Y^12)) ≤ C*(Y:ℝ)^12*(log Y+1) := by
  obtain ⟨C₀, hC₀, C₁, hC₁, D₀, Z₀, hb⟩ := erdos975_sifted_band_geometric f hdeg hirr K
  refine ⟨2*C₁*(4*C₀+1), by positivity, max 2 (max D₀ Z₀), le_max_left _ _, ?_⟩
  intro T Y hT hY
  have hYlog : 0 ≤ log (Y:ℝ) := Real.log_nonneg (by exact_mod_cast hY)
  have hpoint : ∀ j ∈ rootSieveBandIndices Y T,
      (2:ℝ)^(K*(j+1))*Erdos975SiftedBandSum f (Y^2) (Y^4) (rootSieveCutoff Y j)
        (rootSieveCutoff Y (j+1)) (Y^12) ≤ C₁*(4*C₀+1)*(Y:ℝ)^12*(log Y+1)*(1/2:ℝ)^j := by
    intro j hjmem
    obtain ⟨hjI, hDT, hZT⟩ := Finset.mem_filter.mp hjmem
    obtain ⟨hj, _⟩ := Finset.mem_Icc.mp hjI
    have hD2 : 2 ≤ rootSieveCutoff Y j := ((le_max_left _ _).trans hT).trans hDT
    have hZ2 : 2 ≤ rootSieveCutoff Y (j+1) := ((le_max_left _ _).trans hT).trans hZT
    have hDD : D₀ ≤ rootSieveCutoff Y j :=
      ((le_max_left _ _).trans ((le_max_right _ _).trans hT)).trans hDT
    have hZZ : Z₀ ≤ rootSieveCutoff Y (j+1) :=
      ((le_max_right _ _).trans ((le_max_right _ _).trans hT)).trans hZT
    have hg := hb Y _ _ (Y^12) j hY hDD hZZ (rootSieveCutoff_pow_le Y j hj)
    have hc := sifted_band_coefficient_bound C₀ hC₀.le Y _ _ hY hD2 hZ2
      (rootSieveCutoff_le Y j hY hj) (rootSieveCutoff_le Y (j+1) hY (by omega))
      (rootSieveCutoff_log_comparison Y j hj hZ2 (by omega))
    apply hg.trans
    have hh := mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right hc (show 0 ≤ (1/2:ℝ)^j by positivity)) hC₁.le
    convert hh using 1 <;> push_cast <;> ring
  have hsum : (∑ j ∈ rootSieveBandIndices Y T, (1/2:ℝ)^j) ≤ 2 := by
    apply (Summable.sum_le_tsum _ (fun _ _ ↦ by positivity)
      (summable_geometric_of_lt_one (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num))).trans
    rw [tsum_geometric_of_lt_one (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num)]
    norm_num
  calc
    _ ≤ ∑ j ∈ rootSieveBandIndices Y T, C₁*(4*C₀+1)*(Y:ℝ)^12*(log Y+1)*(1/2:ℝ)^j :=
      Finset.sum_le_sum hpoint
    _ = (C₁*(4*C₀+1)*(Y:ℝ)^12*(log Y+1))*∑ j ∈ rootSieveBandIndices Y T, (1/2:ℝ)^j :=
      (Finset.mul_sum ..).symm
    _ ≤ (C₁*(4*C₀+1)*(Y:ℝ)^12*(log Y+1))*2 :=
      mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = _ := by ring

lemma polynomial_floor_eval_on_powers (f : ℤ[X]) (M : ℕ) :
    ∃ Y₀ : ℕ, ∀ Y n : ℕ, Y₀ ≤ Y → n < Y^M →
      ⌊f.eval (n:ℤ)⌋₊ ≤ Y^(M*f.natDegree+1) := by
  obtain ⟨C, hC, hb⟩ := polynomial_floor_eval_power_bound f
  obtain ⟨Y₀, hY₀⟩ := exists_nat_ge C
  refine ⟨Y₀, ?_⟩
  intro Y n hY hn
  have hCY : C ≤ (Y:ℝ) := hY₀.trans (by exact_mod_cast hY)
  have hpoint := hb n
  have hnR : (n+1:ℝ) ≤ (Y:ℝ)^M := by exact_mod_cast (show n+1 ≤ Y^M by omega)
  have hh : (⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ (Y:ℝ)^(M*f.natDegree+1) := calc
    _ ≤ C*(n+1:ℝ)^f.natDegree := hpoint
    _ ≤ (Y:ℝ)*((Y:ℝ)^M)^f.natDegree := mul_le_mul hCY
      (pow_le_pow_left₀ (by positivity) hnR _) (by positivity) (Nat.cast_nonneg _)
    _ = _ := by rw [← pow_mul, pow_succ, mul_comm]
  exact_mod_cast hh

lemma erdos975_primary_smooth_on_powers (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (K : ℕ) :
    ∃ C > (0:ℝ), ∃ Y₀ : ℕ, ∀ Y : ℕ, Y₀ ≤ Y →
      (∀ n < Y^12, ⌊f.eval (n:ℤ)⌋₊ ≤ Y^K) →
      Erdos975SmallSmoothPartSum f (Y^4) Y (Y^12) ≤ C*(Y:ℝ)^12*log Y := by
  obtain ⟨C, hC, A₀, D₀, hb⟩ := erdos975_sifted_small_part_bound f hdeg hirr
  refine ⟨20*(2:ℝ)^K*C, by positivity, max 2 (max A₀ D₀), ?_⟩
  intro Y hY hpoint
  have hY2 : 2 ≤ Y := (le_max_left _ _).trans hY
  have hYA : A₀ ≤ Y^4 := ((le_max_left _ _).trans ((le_max_right _ _).trans hY)).trans (Nat.le_pow (by norm_num))
  have hYD : D₀ ≤ Y := (le_max_right _ _).trans ((le_max_right _ _).trans hY)
  have hYR : (1:ℝ) ≤ Y := by exact_mod_cast (show 1 ≤ Y by omega)
  have hlog : 0 < log (Y:ℝ) := Real.log_pos (by exact_mod_cast (show 1 < Y by omega))
  have hpow : (Y:ℝ)^8 ≤ (Y:ℝ)^12 := pow_le_pow_right₀ hYR (by norm_num)
  apply (erdos975_small_smooth_part_le_sifted f (Y^4) Y (Y^12) K hY2 hpoint).trans
  apply (mul_le_mul_of_nonneg_left (hb (Y^4) Y (Y^12) hYA hYD) (by positivity : (0:ℝ) ≤ 2^K)).trans
  push_cast
  rw [Real.log_pow]
  norm_num only [Nat.cast_ofNat]
  have he : (Y:ℝ)^12*(4*log Y)^2/log Y+(Y:ℝ)^4*(4*log Y)*(Y:ℝ)^4 =
      16*(Y:ℝ)^12*log Y+4*(Y:ℝ)^8*log Y := by field_simp; ring
  rw [he]
  have hh := mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_right hpow hlog.le) (show 0 ≤ 4*(2:ℝ)^K*C by positivity)
  nlinarith

lemma erdos975_fixed_prime_smooth_on_powers (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (D : ℕ) :
    ∃ C > (0:ℝ), ∀ Y : ℕ, 0 < Y →
      Erdos975LargeSmoothPartSum f (Y^4) D (Y^12) ≤ C*(Y:ℝ)^12 := by
  obtain ⟨C, hC, hb⟩ := polynomial_large_smooth_sum_rankin f hdeg hirr D (1/2) (1/12)
    (by norm_num) (by norm_num) (by norm_num)
  refine ⟨C*(1+D:ℝ), by positivity, ?_⟩
  intro Y hY
  have hYR : (0:ℝ) < Y := by exact_mod_cast hY
  have hYone : (1:ℝ) ≤ Y := by exact_mod_cast hY
  have hroot12 : ((Y^12:ℕ):ℝ)^(1/12:ℝ) = Y := by
    rw [Nat.cast_pow, ← Real.rpow_natCast_mul hYR.le]
    norm_num
  have hroot4 : ((Y^4:ℕ):ℝ)^(1/2:ℝ) = (Y:ℝ)^2 := by
    rw [Nat.cast_pow, ← Real.rpow_natCast_mul hYR.le]
    norm_num
  have hpow3 : (Y:ℝ)^3 ≤ (Y:ℝ)^12 := pow_le_pow_right₀ hYone (by norm_num)
  have hpow11 : (Y:ℝ)^11 ≤ (Y:ℝ)^12 := pow_le_pow_right₀ hYone (by norm_num)
  calc
    _ ≤ C*((Y^12:ℕ):ℝ)^(1/12:ℝ)*(((Y^12:ℕ):ℝ)+(Y^4:ℕ)*D)/((Y^4:ℕ):ℝ)^(1/2:ℝ) :=
      hb (Y^4) (Y^12) (pow_pos hY _)
    _ = C*((Y:ℝ)^11+(Y:ℝ)^3*D) := by rw [hroot12, hroot4]; push_cast; field_simp
    _ ≤ _ := by nlinarith [mul_le_mul_of_nonneg_right hpow3 (Nat.cast_nonneg (α := ℝ) D)]


lemma erdos975_large_smooth_part_band_cover (f : ℤ[X]) (Y T N K : ℕ)
    (hY : 0 < Y) (hT : 0 < T) (hbound : ∀ n < N, ⌊f.eval (n:ℤ)⌋₊ ≤ Y^K) :
    Erdos975LargeSmoothPartSum f (Y^4) Y N ≤
      Erdos975ExceptionalPrimePowerSum f Y (Y^2) N +
      Erdos975LargeSmoothPartSum f (Y^4) (T^2) N +
      ∑ j ∈ rootSieveBandIndices Y T, (2:ℝ)^(K*(j+1))*
        Erdos975SiftedBandSum f (Y^2) (Y^4) (rootSieveCutoff Y j)
          (rootSieveCutoff Y (j+1)) N := by
  let τ := fun n : ℕ ↦ (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)
  let E := fun n : ℕ ↦ ∃ p ∈ Finset.Icc 1 Y,
    p.Prime ∧ ((p ^ Nat.clog p (Y^2):ℕ):ℤ) ∣ f.eval (n:ℤ)
  let g := fun (n j : ℕ) ↦ (2:ℝ)^(K*(j+1))*
    ∑ a ∈ smoothModuliBand (Y^2) (Y^4) (rootSieveCutoff Y j),
      if (a:ℤ) ∣ f.eval (n:ℤ) ∧
        (∀ p ∈ polynomialSievePrimes f (polynomialSieveBadProduct f * a) (rootSieveCutoff Y (j+1)),
          ¬(p:ℤ) ∣ f.eval (n:ℤ)) then (σ 0 a:ℝ) else 0
  have hg : ∀ n j, 0 ≤ g n j := by
    intro n j
    apply mul_nonneg (by positivity)
    apply Finset.sum_nonneg
    intro a ha
    split_ifs <;> positivity
  have hg_sum : ∀ n, 0 ≤ ∑ j ∈ rootSieveBandIndices Y T, g n j :=
    fun n ↦ Finset.sum_nonneg (fun j _ ↦ hg n j)
  have hτ : ∀ n, 0 ≤ τ n := fun n ↦ Nat.cast_nonneg _
  have hband : (∑ j ∈ rootSieveBandIndices Y T, (2:ℝ)^(K*(j+1))*
        Erdos975SiftedBandSum f (Y^2) (Y^4) (rootSieveCutoff Y j)
          (rootSieveCutoff Y (j+1)) N) =
      ∑ n ∈ Finset.range N, ∑ j ∈ rootSieveBandIndices Y T, g n j := by
    simp_rw [Erdos975SiftedBandSum_swap, Finset.mul_sum]
    rw [Finset.sum_comm]
    simp only [g, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n hn
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro a ha
    split_ifs <;> rfl
  have hcover : ∀ n ∈ Finset.range N,
      (if Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ Y then τ n else 0) ≤
        (if E n then τ n else 0) +
        (if Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (T^2) then τ n else 0) +
        ∑ j ∈ rootSieveBandIndices Y T, g n j := by
    intro n hn
    have hnN := Finset.mem_range.mp hn
    have hnE : 0 ≤ if E n then τ n else 0 := by split_ifs <;> positivity
    have hnF : 0 ≤ if Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (T^2) then τ n else 0 := by
      split_ifs <;> positivity
    by_cases hl : Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ Y
    · rw [if_pos hl]
      by_cases he : E n
      · rw [if_pos he]
        linarith [hg_sum n]
      · rw [if_neg he, zero_add]
        by_cases hf : Y^4 < smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ (T^2)
        · rw [if_pos hf]
          linarith [hg_sum n]
        · rw [if_neg hf, zero_add]
          have hnot : n ∉ largePrimePowerExceptionalSet f Y (Y^2) N := by
            intro hmem
            exact he (Finset.mem_filter.mp hmem).2
          obtain ⟨p, hp, hpY, hprev0, hprev1, hcross⟩ :=
            polynomial_first_crossing_outside_exceptional f Y N n hY hnN hl hnot
          have hTp : T^2 < p := by
            by_contra h
            exact hf (hcross.trans_le (smoothPrimePart_mono _ (show p ≤ T^2 by omega)))
          obtain ⟨hj, hpD, hZp⟩ := prime_rootSieveBand_index Y T p hT hp hpY hTp
          have hz : 1 ≤ f.eval (n:ℤ) := by
            by_contra hz
            have hm : ⌊f.eval (n:ℤ)⌋₊ = 0 := by
              have := Nat.floor_pos.not.mpr hz
              omega
            have hs : smoothPrimePart ⌊f.eval (n:ℤ)⌋₊ Y = 1 := by simp [hm, smoothPrimePart]
            rw [hs] at hl
            have := pow_pos hY 4
            omega
          have hpoint := polynomial_crossing_band_pointwise f n Y p _ _ (Nat.log p Y) K
            hp hpD hZp (Nat.lt_pow_succ_log_self hp.one_lt Y).le hz (hbound n hnN) hprev0 hprev1
          apply hpoint.trans
          convert (Finset.single_le_sum (fun j _ ↦ hg n j) hj) using 1
          dsimp only [g]
          congr 1
          apply Finset.sum_congr rfl
          intro a ha
          split_ifs <;> rfl
    · rw [if_neg hl]
      exact add_nonneg (add_nonneg hnE hnF) (hg_sum n)
  have hsum := Finset.sum_le_sum hcover
  simp only [Finset.sum_add_distrib] at hsum
  rw [hband]
  simpa only [Erdos975LargeSmoothPartSum, Erdos975ExceptionalPrimePowerSum,
    largePrimePowerExceptionalSet, Finset.sum_filter, τ, E] using hsum

lemma erdos975_range_sum_on_twelfth_powers (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∃ Y₀ : ℕ, ∀ Y : ℕ, Y₀ ≤ Y →
      (∑ n ∈ Finset.range (Y^12), (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) ≤
        C*(Y:ℝ)^12*(log Y+1) := by
  let K := 12*f.natDegree+1
  obtain ⟨Y₁, hpoint⟩ := polynomial_floor_eval_on_powers f 12
  obtain ⟨A, hA, Y₂, hprimary⟩ := erdos975_primary_smooth_on_powers f hdeg hirr K
  obtain ⟨B, hB, hexcept⟩ := exceptional_prime_power_sum_on_powers f hdeg hirr 12 (by norm_num)
  obtain ⟨C, hC, T, hT, hbands⟩ := erdos975_geometric_band_sum_bound f hdeg hirr K
  obtain ⟨D, hD, hfixed⟩ := erdos975_fixed_prime_smooth_on_powers f hdeg hirr (T^2)
  refine ⟨A+B+D+C, by positivity, max 1 (max Y₁ Y₂), ?_⟩
  intro Y hY
  have hYpos : 0 < Y := (le_max_left _ _).trans hY
  have hY₁ : Y₁ ≤ Y := (le_max_left _ _).trans ((le_max_right _ _).trans hY)
  have hY₂ : Y₂ ≤ Y := (le_max_right _ _).trans ((le_max_right _ _).trans hY)
  have hlogY : 0 ≤ log (Y:ℝ) := Real.log_nonneg (by exact_mod_cast hYpos)
  have hmain := hprimary Y hY₂ (fun n hn ↦ hpoint Y n hY₁ hn)
  have htail := erdos975_large_smooth_part_band_cover f Y T (Y^12) K hYpos (by omega)
    (fun n hn ↦ hpoint Y n hY₁ hn)
  have he := hexcept Y hYpos
  have hf := hfixed Y hYpos
  have hg := hbands T Y le_rfl hYpos
  rw [erdos975_smooth_part_split f (Y^4) Y (Y^12)]
  have hp : 0 ≤ (Y:ℝ)^12 := by positivity
  have hAB := mul_nonneg (show 0 ≤ A+B+D by positivity) hp
  have hBDlog := mul_nonneg (mul_nonneg (show 0 ≤ B+D by positivity) hp) hlogY
  nlinarith



lemma erdos975_range_sum_log_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
      (∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) ≤ C*N*(log N+1) := by
  obtain ⟨C, hC, Y₀, hb⟩ := erdos975_range_sum_on_twelfth_powers f hdeg hirr
  have hlog2 : 0 ≤ log (2:ℝ) := Real.log_nonneg (by norm_num)
  refine ⟨C*(2:ℝ)^12*(log 2+2), by positivity, max 1 (Y₀^12), ?_⟩
  intro N hN
  have hN1 : 1 ≤ N := (le_max_left _ _).trans hN
  have hNY₀ : Y₀^12 ≤ N := (le_max_right _ _).trans hN
  let D := rootSieveCutoff N 12
  let Y := D+1
  have hD1 : 1 ≤ D := (pow_le_iff_le_rootSieveCutoff N 12 1 (by norm_num)).mp (by simpa using hN1)
  have hY₀ : Y₀ ≤ Y := ((pow_le_iff_le_rootSieveCutoff N 12 Y₀ (by norm_num)).mp hNY₀).trans
    (Nat.le_succ _)
  have hNY : N ≤ Y^12 := (lt_rootSieveCutoff_add_one_pow N 12 (by norm_num)).le
  have hDp : D^12 ≤ N := rootSieveCutoff_pow_le N 12 (by norm_num)
  have hYp : (Y:ℝ)^12 ≤ (2:ℝ)^12*N := by
    have hYD : (Y:ℝ) ≤ 2*D := by dsimp [Y]; push_cast; exact_mod_cast (show D+1 ≤ 2*D by omega)
    calc
      _ ≤ (2*(D:ℝ))^12 := pow_le_pow_left₀ (Nat.cast_nonneg Y) hYD _
      _ = (2:ℝ)^12*(D:ℝ)^12 := mul_pow _ _ _
      _ ≤ _ := mul_le_mul_of_nonneg_left (by exact_mod_cast hDp) (by positivity)
  have hNlog : 0 ≤ log (N:ℝ) := Real.log_nonneg (by exact_mod_cast hN1)
  have hY1 : 0 < Y := Nat.succ_pos _
  have hYlog : 0 ≤ log (Y:ℝ) := Real.log_nonneg (by exact_mod_cast hY1)
  have hYN : (Y:ℝ) ≤ 2*N := by
    have hDN := rootSieveCutoff_le N 12 hN1 (by norm_num)
    exact_mod_cast (show Y ≤ 2*N by dsimp [Y, D]; omega)
  have hYlogN : log (Y:ℝ)+1 ≤ (log 2+2)*(log N+1) := by
    have hh := Real.log_le_log (show (0:ℝ) < Y by exact_mod_cast hY1) hYN
    rw [Real.log_mul (by norm_num) (by exact_mod_cast (show N ≠ 0 by omega))] at hh
    nlinarith [mul_nonneg hlog2 hNlog]
  calc
    _ ≤ ∑ n ∈ Finset.range (Y^12), (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hNY) (fun _ _ _ ↦ Nat.cast_nonneg _)
    _ ≤ C*(Y:ℝ)^12*(log Y+1) := hb Y hY₀
    _ ≤ C*((2:ℝ)^12*N)*((log 2+2)*(log N+1)) := mul_le_mul
      (mul_le_mul_of_nonneg_left hYp hC.le) hYlogN (by positivity) (by positivity)
    _ = _ := by ring

lemma erdos975_eventual_log_upper_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) :
    ∃ C > (0:ℝ), ∀ᶠ x : ℝ in atTop, Erdos975Sum f x ≤ C*(x*log x) := by
  obtain ⟨C, hC, N₀, hb⟩ := erdos975_range_sum_log_bound f hdeg hirr
  have hlog2 : 0 ≤ log (2:ℝ) := Real.log_nonneg (by norm_num)
  refine ⟨2*C*(log 2+2), by positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (N₀:ℝ), eventually_ge_atTop (1:ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop 1] with x hxN hx1 hxlog
  let N := ⌊x⌋₊+1
  have hx0 : 0 < x := zero_lt_one.trans_le hx1
  have hN₀ : N₀ ≤ N := ((Nat.le_floor_iff hx0.le).mpr hxN).trans (Nat.le_succ _)
  have hNpos : (0:ℝ) < N := by dsimp [N]; positivity
  have hNx : (N:ℝ) ≤ 2*x := by
    dsimp [N]
    push_cast
    linarith [Nat.floor_le hx0.le]
  have hlogN : log (N:ℝ)+1 ≤ (log 2+2)*log x := by
    have hh := Real.log_le_log hNpos hNx
    rw [Real.log_mul (by norm_num) hx0.ne'] at hh
    nlinarith [mul_le_mul_of_nonneg_left hxlog hlog2]
  have hs : Erdos975Sum f x = ∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) := by
    unfold Erdos975Sum
    congr 1
    ext n
    simp [N]
  have hlogN0 : 0 ≤ log (N:ℝ)+1 := by
    have hn1 : (1:ℝ) ≤ N := by exact_mod_cast (Nat.succ_pos ⌊x⌋₊)
    linarith [Real.log_nonneg hn1]
  calc
    _ ≤ C*N*(log N+1) := hs ▸ hb N hN₀
    _ ≤ C*(2*x)*((log 2+2)*log x) := mul_le_mul
      (mul_le_mul_of_nonneg_left hNx hC.le) hlogN hlogN0 (by positivity)
    _ = _ := by ring

lemma erdos975Sum_isBigO_mul_log (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) : Erdos975Sum f =O[atTop] (fun x : ℝ ↦ x*log x) := by
  obtain ⟨C, hC, hb⟩ := erdos975_eventual_log_upper_bound f hdeg hirr
  apply Asymptotics.IsBigO.of_bound C
  filter_upwards [hb, eventually_ge_atTop (1:ℝ)] with x hx hx1
  simpa only [Real.norm_of_nonneg (erdos975Sum_nonneg f x),
    Real.norm_of_nonneg (mul_nonneg (zero_le_one.trans hx1) (Real.log_nonneg hx1))] using hx

lemma erdos975_two_sided_log_bounds (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ᶠ x : ℝ in atTop,
      c ≤ Erdos975Sum f x/(x*log x) ∧ Erdos975Sum f x/(x*log x) ≤ C := by
  obtain ⟨c, hc, hl⟩ := erdos975_eventual_positive_lower_bound f hdeg hirr hpos
  obtain ⟨C, hC, hu⟩ := erdos975_eventual_log_upper_bound f hdeg hirr
  refine ⟨c, C, hc, hC, ?_⟩
  filter_upwards [hl, hu, eventually_gt_atTop (1:ℝ)] with x hxl hxu hx1
  have hden : 0 < x*log x := mul_pos (by linarith) (Real.log_pos hx1)
  exact ⟨(le_div_iff₀ hden).mpr hxl, (div_le_iff₀ hden).mpr hxu⟩



lemma erdos975_positive_subsequence_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (u : ℕ → ℝ) (hu : Tendsto u atTop atTop) :
    ∃ c > (0:ℝ), ∃ φ : ℕ → ℕ, StrictMono φ ∧
      Tendsto (fun n ↦ Erdos975Sum f (u (φ n))/(u (φ n)*log (u (φ n)))) atTop (𝓝 c) := by
  obtain ⟨a, b, ha, _hb, hbounds⟩ := erdos975_two_sided_log_bounds f hdeg hirr hpos
  have hmem : ∀ᶠ n in atTop, Erdos975Sum f (u n)/(u n*log (u n)) ∈ Set.Icc a b :=
    hu.eventually hbounds
  obtain ⟨c, hc, φ, hφ, hlim⟩ := isCompact_Icc.tendsto_subseq' hmem.frequently
  exact ⟨c, ha.trans_le hc.1, φ, hφ, hlim⟩

lemma erdos975_liminf_positive (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    0 < Filter.liminf (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop := by
  obtain ⟨a, b, ha, _hb, hbounds⟩ := erdos975_two_sided_log_bounds f hdeg hirr hpos
  have hl := hbounds.mono (fun _ h ↦ h.1)
  have hu := hbounds.mono (fun _ h ↦ h.2)
  exact ha.trans_le (le_liminf_of_le
    (isBoundedUnder_of_eventually_le hu).isCoboundedUnder_ge hl)

lemma erdos975_liminf_le_limsup (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    Filter.liminf (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop ≤
      Filter.limsup (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop := by
  obtain ⟨a, b, _ha, _hb, hbounds⟩ := erdos975_two_sided_log_bounds f hdeg hirr hpos
  exact liminf_le_limsup
    (isBoundedUnder_of_eventually_le (hbounds.mono (fun _ h ↦ h.2)))
    (isBoundedUnder_of_eventually_ge (hbounds.mono (fun _ h ↦ h.1)))

lemma erdos975_convergence_iff_liminf_eq_limsup (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    (∃ c > (0:ℝ), Tendsto (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop (𝓝 c)) ↔
      Filter.liminf (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop =
        Filter.limsup (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop := by
  constructor
  · rintro ⟨c, _hc, hlim⟩
    exact hlim.liminf_eq.trans hlim.limsup_eq.symm
  · intro heq
    obtain ⟨a, b, _ha, _hb, hbounds⟩ := erdos975_two_sided_log_bounds f hdeg hirr hpos
    refine ⟨_, erdos975_liminf_positive f hdeg hirr hpos, ?_⟩
    exact tendsto_of_liminf_eq_limsup rfl heq.symm
      (isBoundedUnder_of_eventually_le (hbounds.mono (fun _ h ↦ h.2)))
      (isBoundedUnder_of_eventually_ge (hbounds.mono (fun _ h ↦ h.1)))




lemma sum_log_succ_eq_log_factorial (N : ℕ) :
    (∑ n ∈ Finset.range N, log (n+1:ℝ)) = log (N.factorial:ℝ) := by
  rw [Nat.factorial_eq_prod_range_add_one, Nat.cast_prod, Real.log_prod (by intro n hn; positivity)]
  simp only [Nat.cast_add, Nat.cast_one]

lemma sum_log_succ_bounds (N : ℕ) (hN : 1 ≤ N) :
    (N:ℝ)*log N-N ≤ (∑ n ∈ Finset.range N, log (n+1:ℝ)) ∧
      (∑ n ∈ Finset.range N, log (n+1:ℝ)) ≤ (N:ℝ)*log N := by
  have hlogN : 0 ≤ log (N:ℝ) := Real.log_nonneg (by exact_mod_cast hN)
  constructor
  · rw [sum_log_succ_eq_log_factorial]
    have hs := Stirling.le_log_factorial_stirling (show N ≠ 0 by omega)
    have hp : 0 ≤ log (2*Real.pi) := Real.log_nonneg (by linarith [Real.pi_gt_three])
    linarith
  · calc
      _ ≤ ∑ _n ∈ Finset.range N, log (N:ℝ) := by
        apply Finset.sum_le_sum
        intro n hn
        apply Real.log_le_log (by positivity)
        exact_mod_cast (show n+1 ≤ N by have := Finset.mem_range.mp hn; omega)
      _ = _ := by simp

lemma tendsto_sum_log_succ_div_mul_log :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.range N, log (n+1:ℝ))/((N:ℝ)*log N))
      atTop (𝓝 1) := by
  have hN : Tendsto (fun N : ℕ ↦ (N:ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hlog := Real.tendsto_log_atTop.comp hN
  have hl := (hlog.const_div_atTop (1:ℝ)).const_sub 1
  simp only [sub_zero] at hl
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hl tendsto_const_nhds
  · filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN1
    have hNR : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
    have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN1)
    have hh := div_le_div_of_nonneg_right (sum_log_succ_bounds N (by omega)).1
      (mul_nonneg hNR.le hlogN.le)
    dsimp only [Function.comp_def]
    convert hh using 1 <;> field_simp <;> ring
  · filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN1
    have hden : 0 < (N:ℝ)*log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
      (Real.log_pos (by exact_mod_cast hN1))
    exact (div_le_one hden).mpr (sum_log_succ_bounds N (by omega)).2

lemma tendsto_sum_log_succ_atTop :
    Tendsto (fun N : ℕ ↦ ∑ n ∈ Finset.range N, log (n+1:ℝ)) atTop atTop := by
  have hN : Tendsto (fun N : ℕ ↦ (N:ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hprod := Tendsto.atTop_mul_pos (by norm_num : (0:ℝ) < 1)
    (hN.atTop_mul_atTop₀ (Real.tendsto_log_atTop.comp hN)) tendsto_sum_log_succ_div_mul_log
  apply hprod.congr'
  filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN1
  have hden : (N:ℝ)*log N ≠ 0 := (mul_pos (by exact_mod_cast (show 0 < N by omega))
    (Real.log_pos (by exact_mod_cast hN1))).ne'
  exact mul_div_cancel₀ _ hden

lemma tendsto_sum_range_div_mul_log_of_pointwise (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto (fun n : ℕ ↦ u n/log (n+1:ℝ)) atTop (𝓝 c)) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.range N, u n)/((N:ℝ)*log N)) atTop (𝓝 c) := by
  let w := fun n : ℕ ↦ log (n+1:ℝ)
  have hzero : Tendsto (fun n : ℕ ↦ (u n-c*w n)/w n) atTop (𝓝 0) := by
    have ht := h.sub_const c
    rw [sub_self] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (0:ℕ)] with n hn
    have hw : w n ≠ 0 := (Real.log_pos (show (1:ℝ) < n+1 by exact_mod_cast (show 1 < n+1 by omega))).ne'
    dsimp only [w] at hw ⊢
    field_simp
  have ho : (fun n ↦ u n-c*w n) =o[atTop] w := by
    apply (Asymptotics.isLittleO_iff_tendsto' ?_).mpr hzero
    filter_upwards [eventually_gt_atTop (0:ℕ)] with n hn
    have hw : w n ≠ 0 := (Real.log_pos (show (1:ℝ) < n+1 by exact_mod_cast (show 1 < n+1 by omega))).ne'
    exact fun hz ↦ (hw hz).elim
  have hs := ho.sum_range (fun n ↦ Real.log_nonneg (by linarith [Nat.cast_nonneg (α := ℝ) n])) tendsto_sum_log_succ_atTop
  have he := hs.tendsto_div_nhds_zero.mul tendsto_sum_log_succ_div_mul_log
  simp only [zero_mul] at he
  have herr : Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.range N, (u n-c*w n))/((N:ℝ)*log N))
      atTop (𝓝 0) := by
    apply he.congr'
    filter_upwards [tendsto_sum_log_succ_atTop.eventually_gt_atTop 0] with N hN
    change 0 < ∑ n ∈ Finset.range N, w n at hN
    change ((∑ n ∈ Finset.range N, (u n-c*w n))/(∑ n ∈ Finset.range N, w n))*
      ((∑ n ∈ Finset.range N, w n)/((N:ℝ)*log N)) = _
    exact div_mul_div_cancel₀ hN.ne'
  have ht := herr.add (tendsto_sum_log_succ_div_mul_log.const_mul c)
  simp only [zero_add, mul_one] at ht
  apply ht.congr
  intro N
  dsimp only
  simp only [Finset.sum_sub_distrib, ← Finset.mul_sum, w]
  ring

lemma tendsto_sum_Iic_div_mul_log_of_pointwise (u : ℕ → ℝ) (c : ℝ)
    (h : Tendsto (fun n : ℕ ↦ u n/log n) atTop (𝓝 c)) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.Iic N, u n)/((N:ℝ)*log N)) atTop (𝓝 c) := by
  have hshift := h.comp (tendsto_add_atTop_nat 1)
  simp only [Function.comp_def, Nat.cast_add, Nat.cast_one] at hshift
  have hs := tendsto_sum_range_div_mul_log_of_pointwise (fun n ↦ u (n+1)) c hshift
  have hN : Tendsto (fun N : ℕ ↦ (N:ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hz := (hN.atTop_mul_atTop₀ (Real.tendsto_log_atTop.comp hN)).const_div_atTop (u 0)
  have ht := hz.add hs
  rw [zero_add] at ht
  apply ht.congr
  intro N
  dsimp only [Function.comp_def]
  rw [← add_div]
  congr 1
  have heq : Finset.Iic N = Finset.range (N+1) := by ext n; simp
  rw [heq, Finset.sum_range_succ']
  ring

lemma polynomial_floor_eval_real_tendsto (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    Tendsto (fun n : ℕ ↦ (⌊f.eval (n:ℤ)⌋₊:ℝ)) atTop atTop := by
  let P : ℝ[X] := f.map (Int.castRingHom ℝ)
  have hPdeg : P.natDegree = f.natDegree := natDegree_map_eq_of_injective Int.cast_injective f
  have hlead : 0 < P.leadingCoeff := by
    rw [leadingCoeff_map_of_injective Int.cast_injective f]
    change 0 < (f.leadingCoeff:ℝ)
    exact_mod_cast leadingCoeff_pos_of_eventually_positive f hdeg hpos
  have ht := (P.tendsto_atTop_of_leadingCoeff_nonneg
    (natDegree_pos_iff_degree_pos.mp (by omega)) hlead.le).comp (tendsto_natCast_atTop_atTop (R := ℝ))
  apply ht.congr'
  filter_upwards [(tendsto_natCast_atTop_atTop (R := ℤ)).eventually hpos] with n hn
  have heval : P.eval (n:ℝ) = (↑(f.eval (n:ℤ)):ℝ) := by
    simpa only [P, eval_map, Int.coe_castRingHom, Int.cast_natCast] using
      (eval₂_at_apply (Int.castRingHom ℝ) (n:ℤ) (p := f))
  change P.eval (n:ℝ) = _
  rw [heval, Nat.floor_int]
  norm_cast
  exact (Int.toNat_of_nonneg (by omega)).symm

lemma polynomial_floor_eval_log_growth (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    Tendsto (fun n : ℕ ↦ log (⌊f.eval (n:ℤ)⌋₊:ℝ)/log n) atTop (𝓝 (f.natDegree:ℝ)) := by
  let P : ℝ[X] := f.map (Int.castRingHom ℝ)
  have hPdeg : P.natDegree = f.natDegree := natDegree_map_eq_of_injective Int.cast_injective f
  have hlead : 0 < P.leadingCoeff := by
    rw [leadingCoeff_map_of_injective Int.cast_injective f]
    change 0 < (f.leadingCoeff:ℝ)
    exact_mod_cast leadingCoeff_pos_of_eventually_positive f hdeg hpos
  have hN : Tendsto (fun n : ℕ ↦ (n:ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hmodel := (tendsto_const_mul_pow_atTop (show P.natDegree ≠ 0 by omega) hlead).comp hN
  have he := ((P.isEquivalent_atTop_lead.comp_tendsto hN).log hmodel).div
    (Asymptotics.IsEquivalent.refl (u := fun n : ℕ ↦ log (n:ℝ)))
  have hmain : Tendsto (fun n : ℕ ↦ log (P.leadingCoeff*(n:ℝ)^P.natDegree)/log n)
      atTop (𝓝 (f.natDegree:ℝ)) := by
    have ht := ((Real.tendsto_log_atTop.comp hN).const_div_atTop (log P.leadingCoeff)).add_const (f.natDegree:ℝ)
    rw [zero_add] at ht
    apply ht.congr'
    filter_upwards [eventually_gt_atTop (1:ℕ)] with n hn
    have hnR : (0:ℝ) < n := by exact_mod_cast (show 0 < n by omega)
    have hl : log (n:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hn)).ne'
    rw [Real.log_mul hlead.ne' (pow_ne_zero _ hnR.ne'), Real.log_pow, hPdeg]
    dsimp only [Function.comp_def]
    field_simp
  have ht := he.tendsto_nhds_iff.mpr hmain
  apply ht.congr'
  filter_upwards [(tendsto_natCast_atTop_atTop (R := ℤ)).eventually hpos] with n hn
  have heval : P.eval (n:ℝ) = (↑(f.eval (n:ℤ)):ℝ) := by
    simpa only [P, eval_map, Int.coe_castRingHom, Int.cast_natCast] using
      (eval₂_at_apply (Int.castRingHom ℝ) (n:ℤ) (p := f))
  change log (P.eval (n:ℝ))/log n = _
  rw [heval]
  congr 2
  rw [Nat.floor_int]
  norm_cast
  exact (Int.toNat_of_nonneg (by omega)).symm


lemma polynomial_sqrt_floor_eval_tendsto (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    Tendsto (fun n : ℕ ↦ (⌊f.eval (n:ℤ)⌋₊).sqrt) atTop atTop := by
  have ht := (tendsto_nat_floor_atTop (α := ℝ)).comp
    (Real.tendsto_sqrt_atTop.comp (polynomial_floor_eval_real_tendsto f hdeg hpos))
  simpa only [Function.comp_def, Real.nat_floor_real_sqrt_eq_nat_sqrt] using ht

lemma polynomial_sqrt_floor_eval_log_growth (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    Tendsto (fun n : ℕ ↦ log ((⌊f.eval (n:ℤ)⌋₊).sqrt:ℝ)/log n)
      atTop (𝓝 ((f.natDegree:ℝ)/2)) := by
  have hM := polynomial_floor_eval_real_tendsto f hdeg hpos
  have hs := Real.tendsto_sqrt_atTop.comp hM
  have he := Asymptotics.isEquivalent_nat_floor (R := ℝ) |>.comp_tendsto hs
  have he' := he.log hs
  have he'' := he'.div (Asymptotics.IsEquivalent.refl (u := fun n : ℕ ↦ log (n:ℝ)))
  simp only [Function.comp_def, Real.nat_floor_real_sqrt_eq_nat_sqrt] at he''
  apply he''.tendsto_nhds_iff.mpr
  apply ((polynomial_floor_eval_log_growth f hdeg hpos).div_const 2).congr
  intro n
  change _ = log (Real.sqrt (⌊f.eval (n:ℤ)⌋₊:ℝ))/log n
  rw [Real.log_sqrt (Nat.cast_nonneg _)]
  ring

/-- Main term obtained by replacing each divisibility indicator by its root density. -/
noncomputable def polynomialRootDensityMainTerm (f : ℤ[X]) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Iic N,
    harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) (⌊f.eval (n:ℤ)⌋₊).sqrt

lemma polynomialRootDensityMainTerm_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hκ : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N/log N) atTop (𝓝 κ)) :
    Tendsto (fun N : ℕ ↦ polynomialRootDensityMainTerm f N/((N:ℝ)*log N))
      atTop (𝓝 (κ*f.natDegree/2)) := by
  apply tendsto_sum_Iic_div_mul_log_of_pointwise
  have hs := polynomial_sqrt_floor_eval_tendsto f hdeg hpos
  have hH := hκ.comp hs
  have hl := polynomial_sqrt_floor_eval_log_growth f hdeg hpos
  have ht := hH.mul hl
  rw [← mul_div_assoc] at ht
  apply ht.congr'
  filter_upwards [hs.eventually_gt_atTop 1] with n hn
  have hlog : log ((⌊f.eval (n:ℤ)⌋₊).sqrt:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hn)).ne'
  dsimp only [Function.comp_def]
  exact div_mul_div_cancel₀ hlog

/-- Signed discrepancy between the actual small-divisor count and its residue-density model. -/
noncomputable def polynomialRootDensityDiscrepancy (f : ℤ[X]) (N : ℕ) : ℝ :=
  Erdos975SmallDivisorSum f N - polynomialRootDensityMainTerm f N

lemma small_divisors_eq_sqrt_filter (m : ℕ) :
    m.divisors.filter (fun d ↦ d ≤ m.sqrt) = (Finset.Icc 1 m.sqrt).filter (fun d ↦ d ∣ m) := by
  ext d
  simp only [Finset.mem_filter, Nat.mem_divisors, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨hd, hm⟩, hs⟩
    exact ⟨⟨Nat.pos_of_dvd_of_pos hd (Nat.pos_of_ne_zero hm), hs⟩, hd⟩
  · rintro ⟨⟨hd0, hs⟩, hd⟩
    refine ⟨⟨hd, ?_⟩, hs⟩
    intro hm
    simp [hm] at hs
    omega

lemma polynomialRootDensityDiscrepancy_as_sum (f : ℤ[X]) (N : ℕ) :
    polynomialRootDensityDiscrepancy f N =
      ∑ n ∈ Finset.Iic N, ∑ d ∈ Finset.Icc 1 (⌊f.eval (n:ℤ)⌋₊).sqrt,
        ((if d ∣ ⌊f.eval (n:ℤ)⌋₊ then (1:ℝ) else 0) - (polynomialRootCount f d:ℝ)/d) := by
  unfold polynomialRootDensityDiscrepancy polynomialRootDensityMainTerm Erdos975SmallDivisorSum
  simp only [Nat.floor_natCast, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  rw [small_divisors_eq_sqrt_filter, Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
  simp only [Nat.cast_one, harmonicWeightSum, Finset.sum_sub_distrib]
  rfl

lemma erdos975_expected_constant_iff_density_discrepancy (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hκ : Tendsto (fun N : ℕ ↦
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) N/log N) atTop (𝓝 κ)) :
    Tendsto (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop (𝓝 (κ*f.natDegree)) ↔
      Tendsto (fun N : ℕ ↦ polynomialRootDensityDiscrepancy f N/((N:ℝ)*log N)) atTop (𝓝 0) := by
  rw [tendsto_erdos975Sum_iff_small_nat]
  have hmain := polynomialRootDensityMainTerm_limit f hdeg hpos κ hκ
  constructor
  · intro hs
    have ht := hs.sub hmain
    rw [sub_self] at ht
    simpa only [polynomialRootDensityDiscrepancy, sub_div] using ht
  · intro hd
    have ht := hd.add hmain
    rw [zero_add] at ht
    apply ht.congr
    intro N
    dsimp only [polynomialRootDensityDiscrepancy]
    ring

lemma erdos975_density_discrepancy_isBigO (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    (fun N : ℕ ↦ polynomialRootDensityDiscrepancy f N) =O[atTop] (fun N : ℕ ↦ (N:ℝ)*log N) := by
  obtain ⟨κ, _hκ0, hκ⟩ := polynomialRootCount_positive_harmonic_limit f hdeg hirr
  have hmain := polynomialRootDensityMainTerm_limit f hdeg hpos κ hκ
  have hmainO : (fun N : ℕ ↦ polynomialRootDensityMainTerm f N) =O[atTop]
      (fun N : ℕ ↦ (N:ℝ)*log N) := by
    apply Asymptotics.isBigO_of_div_tendsto_nhds _ _ hmain
    filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    have hden : (N:ℝ)*log N ≠ 0 := (mul_pos (by exact_mod_cast (show 0 < N by omega))
      (Real.log_pos (by exact_mod_cast hN))).ne'
    exact fun hz ↦ (hden hz).elim
  have hfull := (erdos975Sum_isBigO_mul_log f hdeg hirr).comp_tendsto
    (tendsto_natCast_atTop_atTop (R := ℝ))
  have hsmall : (fun N : ℕ ↦ Erdos975SmallDivisorSum f N) =O[atTop]
      (fun N : ℕ ↦ Erdos975Sum f N) := by
    apply Asymptotics.IsBigO.of_bound 1
    apply Filter.Eventually.of_forall
    intro N
    simp only [one_mul, Real.norm_of_nonneg (erdos975Sum_nonneg f _)]
    have hspos : 0 ≤ Erdos975SmallDivisorSum f N := Finset.sum_nonneg (fun _ _ ↦ Nat.cast_nonneg _)
    rw [Real.norm_of_nonneg hspos]
    unfold Erdos975SmallDivisorSum Erdos975Sum
    apply Finset.sum_le_sum
    intro n hn
    rw [ArithmeticFunction.sigma_zero_apply]
    exact_mod_cast Finset.card_filter_le _ _
  exact (hsmall.trans hfull).sub hmainO



lemma le_sqrt_floor_iff (z : ℤ) (d : ℕ) (hd : 0 < d) :
    d ≤ (⌊z⌋₊).sqrt ↔ (d:ℤ)^2 ≤ z := by
  by_cases hz : 0 ≤ z
  · lift z to ℕ using hz
    rw [Nat.floor_natCast, Nat.le_sqrt']
    exact_mod_cast Iff.rfl
  · rw [Nat.floor_of_nonpos (le_of_not_ge hz)]
    simp only [Nat.sqrt_zero]
    have hs : ¬(d:ℤ)^2 ≤ z := by have := sq_nonneg (d:ℤ); omega
    simp only [show ¬d ≤ 0 by omega, hs]

noncomputable def polynomialRootDensityEligible (f : ℤ[X]) (d N : ℕ) : Finset ℕ :=
  (Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ)^2 ≤ f.eval (n:ℤ))

/-- Single-modulus discrepancy, with the hyperbola cutoff retained. -/
noncomputable def polynomialRootDiscrepancyAt (f : ℤ[X]) (d N : ℕ) : ℝ :=
  (((Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧
    (d:ℤ)^2 ≤ f.eval (n:ℤ))).card:ℝ) -
      (polynomialRootCount f d:ℝ)/d * ((polynomialRootDensityEligible f d N).card:ℝ)

lemma polynomialRootDensityMainTerm_swap (f : ℤ[X]) (N D : ℕ)
    (hD : ∀ n ≤ N, (⌊f.eval (n:ℤ)⌋₊).sqrt ≤ D) :
    polynomialRootDensityMainTerm f N =
      ∑ d ∈ Finset.Icc 1 D, (polynomialRootCount f d:ℝ)/d *
        ((polynomialRootDensityEligible f d N).card:ℝ) := by
  have he : ∀ n ∈ Finset.Iic N,
      harmonicWeightSum (fun d ↦ (polynomialRootResidues f d).card) (⌊f.eval (n:ℤ)⌋₊).sqrt =
        ∑ d ∈ Finset.Icc 1 D, if (d:ℤ)^2 ≤ f.eval (n:ℤ) then
          (polynomialRootCount f d:ℝ)/d else 0 := by
    intro n hn
    have hset : (Finset.Icc 1 D).filter (fun d : ℕ ↦ (d:ℤ)^2 ≤ f.eval (n:ℤ)) =
        Finset.Icc 1 (⌊f.eval (n:ℤ)⌋₊).sqrt := by
      ext d
      simp only [Finset.mem_filter, Finset.mem_Icc]
      constructor
      · rintro ⟨⟨hd, hdD⟩, hs⟩
        exact ⟨hd, (le_sqrt_floor_iff _ _ hd).mpr hs⟩
      · rintro ⟨hd, hs⟩
        exact ⟨⟨hd, hs.trans (hD n (Finset.mem_Iic.mp hn))⟩, (le_sqrt_floor_iff _ _ hd).mp hs⟩
    rw [← Finset.sum_filter, hset]
    rfl
  unfold polynomialRootDensityMainTerm
  rw [Finset.sum_congr rfl he, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro d hd
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]
  rfl

lemma polynomialRootDensityDiscrepancy_swap (f : ℤ[X]) (N D : ℕ)
    (hD : ∀ n ≤ N, (⌊f.eval (n:ℤ)⌋₊).sqrt ≤ D) :
    polynomialRootDensityDiscrepancy f N =
      ∑ d ∈ Finset.Icc 1 D, polynomialRootDiscrepancyAt f d N := by
  unfold polynomialRootDensityDiscrepancy
  rw [smallDivisorSum_swap_int f N D hD, polynomialRootDensityMainTerm_swap f N D hD,
    ← Finset.sum_sub_distrib]
  rfl

lemma polynomialRootDiscrepancyAt_large_modulus (f : ℤ[X]) (d N : ℕ) (hNd : N < d) :
    polynomialRootDiscrepancyAt f d N =
      (((polynomialRootResidues f d).filter (fun n : ℕ ↦ n ≤ N ∧ (d:ℤ)^2 ≤ f.eval (n:ℤ))).card:ℝ) -
        (polynomialRootCount f d:ℝ)/d*((polynomialRootDensityEligible f d N).card:ℝ) := by
  unfold polynomialRootDiscrepancyAt
  congr 3
  ext n
  simp only [polynomialRootResidues, Finset.mem_filter, Finset.mem_Iic, Finset.mem_range]
  constructor
  · rintro ⟨hn, hd, hs⟩
    exact ⟨⟨hn.trans_lt hNd, hd⟩, hn, hs⟩
  · tauto

lemma polynomialRootDiscrepancyAt_bound (f : ℤ[X]) (K d N : ℕ) (hd : 0 < d)
    (hK : ∀ n : ℕ, K ≤ n → (n:ℤ)^2 ≤ f.eval (n:ℤ)) :
    |polynomialRootDiscrepancyAt f d N| ≤ (K+2:ℝ)*(polynomialRootCount f d:ℝ)+K := by
  let F := (Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ))
  let E := polynomialRootDensityEligible f d N
  let B := F.filter (fun n : ℕ ↦ ¬(d:ℤ)^2 ≤ f.eval (n:ℤ))
  let R := (Finset.Iic N).filter (fun n : ℕ ↦ ¬(d:ℤ)^2 ≤ f.eval (n:ℤ))
  have hbad : B ⊆ polynomialRootResidues f d ∪ Finset.range K := by
    intro n hn
    obtain ⟨hnF, hnB⟩ := Finset.mem_filter.mp hn
    have hdiv := (Finset.mem_filter.mp hnF).2
    by_cases hnK : n < K
    · exact Finset.mem_union_right _ (Finset.mem_range.mpr hnK)
    · apply Finset.mem_union_left
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_range.mpr ?_, hdiv⟩
      by_contra hnd
      have hdn : (d:ℤ) ≤ n := by exact_mod_cast (show d ≤ n by omega)
      have hsq : (d:ℤ)^2 ≤ (n:ℤ)^2 := by nlinarith [Int.natCast_nonneg d]
      exact hnB (hsq.trans (hK n (by omega)))
  have hbadcard : (B.card:ℝ) ≤ (polynomialRootCount f d:ℝ)+K := by
    have hh := (Finset.card_le_card hbad).trans (Finset.card_union_le _ _)
    simpa only [Finset.card_range, Nat.cast_add] using (Nat.cast_le (α := ℝ)).mpr hh
  have hrsub : R ⊆ Finset.range (d+K) := by
    intro n hn
    have hnR := (Finset.mem_filter.mp hn).2
    apply Finset.mem_range.mpr
    by_contra h
    have hnd : d ≤ n := by omega
    have hnK : K ≤ n := by omega
    have hdn : (d:ℤ) ≤ n := by exact_mod_cast hnd
    have hsq : (d:ℤ)^2 ≤ (n:ℤ)^2 := by nlinarith [Int.natCast_nonneg d]
    exact hnR (hsq.trans (hK n hnK))
  have hrCard : (R.card:ℝ) ≤ d+K := by
    simpa only [Finset.card_range, Nat.cast_add] using
      (Nat.cast_le (α := ℝ)).mpr (Finset.card_le_card hrsub)
  have hρ : 0 ≤ (polynomialRootCount f d:ℝ) := Nat.cast_nonneg _
  have hdR : (0:ℝ) < d := by exact_mod_cast hd
  have hd1 : (1:ℝ) ≤ d := by exact_mod_cast hd
  have hmodel : (polynomialRootCount f d:ℝ)/d*(R.card:ℝ) ≤
      (K+1:ℝ)*(polynomialRootCount f d:ℝ) := by
    calc
      _ ≤ (polynomialRootCount f d:ℝ)/d*(d+K) :=
        mul_le_mul_of_nonneg_left hrCard (div_nonneg hρ hdR.le)
      _ ≤ (K+1:ℝ)*(polynomialRootCount f d:ℝ) := by
        rw [div_mul_eq_mul_div, div_le_iff₀ hdR]
        nlinarith [mul_le_mul_of_nonneg_left hd1
          (mul_nonneg (Nat.cast_nonneg (α := ℝ) K) hρ)]
  have hsplit : (((Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧
      (d:ℤ)^2 ≤ f.eval (n:ℤ))).card:ℝ)+(B.card:ℝ) = F.card := by
    have hh := Finset.card_filter_add_card_filter_not (s := F) (fun n : ℕ ↦ (d:ℤ)^2 ≤ f.eval (n:ℤ))
    rw [show F.filter (fun n : ℕ ↦ (d:ℤ)^2 ≤ f.eval (n:ℤ)) =
      (Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧
        (d:ℤ)^2 ≤ f.eval (n:ℤ)) from Finset.filter_filter ..] at hh
    exact_mod_cast hh
  have hesplit : (E.card:ℝ)+(R.card:ℝ) = N+1 := by
    have hh := Finset.card_filter_add_card_filter_not (s := Finset.Iic N)
      (fun n : ℕ ↦ (d:ℤ)^2 ≤ f.eval (n:ℤ))
    simpa only [Nat.card_Iic, Nat.cast_add, Nat.cast_one] using congrArg (fun n : ℕ ↦ (n:ℝ)) hh
  have hfull : |(F.card:ℝ)-(N+1:ℝ)*(polynomialRootCount f d:ℝ)/d| ≤ (polynomialRootCount f d:ℝ) := by
    have hh := polynomial_root_count_error f d (N+1) hd
    have he : Finset.range (N+1) = Finset.Iic N := by ext n; simp
    simpa only [he, Nat.cast_add, Nat.cast_one, div_mul_eq_mul_div] using hh
  have hid : polynomialRootDiscrepancyAt f d N =
      ((F.card:ℝ)-(N+1:ℝ)*(polynomialRootCount f d:ℝ)/d) - B.card +
        (polynomialRootCount f d:ℝ)/d*(R.card:ℝ) := by
    unfold polynomialRootDiscrepancyAt
    change _ - (polynomialRootCount f d:ℝ)/d*(E.card:ℝ) = _
    rw [← hesplit]
    linear_combination hsplit
  rw [abs_le] at hfull ⊢
  rw [hid]
  have hB0 : (0:ℝ) ≤ B.card := Nat.cast_nonneg _
  have hR0 : 0 ≤ (polynomialRootCount f d:ℝ)/d*(R.card:ℝ) := by positivity
  have hKρ : 0 ≤ (K:ℝ)*(polynomialRootCount f d:ℝ) := by positivity
  constructor <;> nlinarith

lemma polynomialRootDiscrepancyAt_small_sum_bound (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ C > (0:ℝ), ∀ N D : ℕ,
      (∑ d ∈ Finset.Icc 1 D, |polynomialRootDiscrepancyAt f d N|) ≤ C*D := by
  obtain ⟨K, hK⟩ := eventually_atTop.mp (eventually_eval_ge_square_of_degree_gt_two f hdeg hpos)
  obtain ⟨B, hB, hb⟩ := polynomialRootCount_sum_le_linear f (by omega) hirr
  refine ⟨(K+2:ℝ)*B+K+1, by positivity, ?_⟩
  intro N D
  calc
    _ ≤ ∑ d ∈ Finset.Icc 1 D, ((K+2:ℝ)*(polynomialRootCount f d:ℝ)+K) := by
      apply Finset.sum_le_sum
      intro d hd
      exact polynomialRootDiscrepancyAt_bound f K d N (Finset.mem_Icc.mp hd).1 hK
    _ = (K+2:ℝ)*(∑ d ∈ Finset.Icc 1 D, (polynomialRootCount f d:ℝ))+(D:ℝ)*K := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul]
      simp
    _ ≤ (K+2:ℝ)*(B*D)+(D:ℝ)*K := add_le_add
      (mul_le_mul_of_nonneg_left (hb D) (by positivity)) le_rfl
    _ ≤ _ := by nlinarith [Nat.cast_nonneg (α := ℝ) D]


lemma polynomialRootDiscrepancyAt_sum_tendsto_zero (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (D : ℕ → ℕ)
    (hD : Tendsto (fun N : ℕ ↦ (D N:ℝ)/((N:ℝ)*log N)) atTop (𝓝 0)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 (D N), polynomialRootDiscrepancyAt f d N)/
      ((N:ℝ)*log N)) atTop (𝓝 0) := by
  obtain ⟨C, hC, hb⟩ := polynomialRootDiscrepancyAt_small_sum_bound f hdeg hirr hpos
  have ht := hD.const_mul C
  rw [mul_zero] at ht
  apply squeeze_zero_norm' _ ht
  filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
  have hden : 0 < (N:ℝ)*log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
    (Real.log_pos (by exact_mod_cast hN))
  rw [Real.norm_eq_abs, abs_div, abs_of_pos hden]
  calc
    _ ≤ (∑ d ∈ Finset.Icc 1 (D N), |polynomialRootDiscrepancyAt f d N|)/((N:ℝ)*log N) :=
      div_le_div_of_nonneg_right (Finset.abs_sum_le_sum_abs _ _) hden.le
    _ ≤ C*(D N:ℝ)/((N:ℝ)*log N) := div_le_div_of_nonneg_right (hb N (D N)) hden.le
    _ = _ := by ring

lemma polynomialRootDiscrepancyAt_linear_cutoff_tendsto_zero (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (C : ℕ) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 (C*N), polynomialRootDiscrepancyAt f d N)/
      ((N:ℝ)*log N)) atTop (𝓝 0) := by
  apply polynomialRootDiscrepancyAt_sum_tendsto_zero f hdeg hirr hpos
  have ht := (Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))).const_div_atTop (C:ℝ)
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (0:ℕ)] with N hN
  have hNne : (N:ℝ) ≠ 0 := by exact_mod_cast hN.ne'
  dsimp only [Function.comp_def]
  push_cast
  field_simp

noncomputable def polynomialLargeRootDensityDiscrepancy (f : ℤ[X]) (N : ℕ) : ℝ :=
  ∑ d ∈ Finset.Ioc N (polynomialSqrtEnvelope f N N), polynomialRootDiscrepancyAt f d N

lemma polynomialRootDensityDiscrepancy_split (f : ℤ[X]) (N : ℕ) :
    polynomialRootDensityDiscrepancy f N =
      (∑ d ∈ Finset.Icc 1 N, polynomialRootDiscrepancyAt f d N) +
        polynomialLargeRootDensityDiscrepancy f N := by
  rw [polynomialRootDensityDiscrepancy_swap f N (polynomialSqrtEnvelope f N N)
    (polynomialSqrtEnvelope_bound f N N)]
  unfold polynomialLargeRootDensityDiscrepancy
  have hNM : N ≤ polynomialSqrtEnvelope f N N := le_max_left _ _
  have hdis : Disjoint (Finset.Icc 1 N) (Finset.Ioc N (polynomialSqrtEnvelope f N N)) := by
    apply Finset.disjoint_left.mpr
    intro d hd he
    simp only [Finset.mem_Icc, Finset.mem_Ioc] at hd he
    omega
  have hset : Finset.Icc 1 N ∪ Finset.Ioc N (polynomialSqrtEnvelope f N N) =
      Finset.Icc 1 (polynomialSqrtEnvelope f N N) := by
    ext d
    simp only [Finset.mem_union, Finset.mem_Icc, Finset.mem_Ioc]
    omega
  rw [← Finset.sum_union hdis, hset]

lemma polynomialLargeRootDensityDiscrepancy_as_roots (f : ℤ[X]) (N : ℕ) :
    polynomialLargeRootDensityDiscrepancy f N =
      ∑ d ∈ Finset.Ioc N (polynomialSqrtEnvelope f N N),
        ((((polynomialRootResidues f d).filter (fun n : ℕ ↦ n ≤ N ∧ (d:ℤ)^2 ≤ f.eval (n:ℤ))).card:ℝ) -
          (polynomialRootCount f d:ℝ)/d*((polynomialRootDensityEligible f d N).card:ℝ)) := by
  apply Finset.sum_congr rfl
  intro d hd
  exact polynomialRootDiscrepancyAt_large_modulus f d N (Finset.mem_Ioc.mp hd).1

lemma polynomialRootDensityDiscrepancy_limit_iff_large (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (β : ℝ) :
    Tendsto (fun N : ℕ ↦ polynomialRootDensityDiscrepancy f N/((N:ℝ)*log N)) atTop (𝓝 β) ↔
      Tendsto (fun N : ℕ ↦ polynomialLargeRootDensityDiscrepancy f N/((N:ℝ)*log N)) atTop (𝓝 β) := by
  have hz := polynomialRootDiscrepancyAt_linear_cutoff_tendsto_zero f hdeg hirr hpos 1
  simp only [one_mul] at hz
  constructor
  · intro h
    have ht := h.sub hz
    rw [sub_zero] at ht
    apply ht.congr
    intro N
    rw [polynomialRootDensityDiscrepancy_split]
    ring
  · intro h
    have ht := hz.add h
    rw [zero_add] at ht
    apply ht.congr
    intro N
    rw [polynomialRootDensityDiscrepancy_split]
    ring

lemma erdos975_expected_constant_iff_large_density_discrepancy (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ κ > (0:ℝ),
      (Tendsto (fun x : ℝ ↦ Erdos975Sum f x/(x*log x)) atTop (𝓝 (κ*f.natDegree)) ↔
        Tendsto (fun N : ℕ ↦ polynomialLargeRootDensityDiscrepancy f N/((N:ℝ)*log N))
          atTop (𝓝 0)) := by
  obtain ⟨κ, hκ0, hκ⟩ := polynomialRootCount_positive_harmonic_limit f (by omega) hirr
  exact ⟨κ, hκ0, (erdos975_expected_constant_iff_density_discrepancy f (by omega) hpos κ hκ).trans
    (polynomialRootDensityDiscrepancy_limit_iff_large f hdeg hirr hpos 0)⟩



lemma zmod_fourier_pairing (d : ℕ) [NeZero d] (u v : ZMod d → ℂ) :
    (∑ x : ZMod d, u x*v x) = (d:ℂ)⁻¹ *
      ∑ h : ZMod d, ZMod.dft u h * ZMod.dft v (-h) := by
  have hinv : ∀ x : ZMod d, u x = (d:ℂ)⁻¹ *
      ∑ h : ZMod d, ZMod.stdAddChar (h*x)*ZMod.dft u h := by
    intro x
    have hh := congr_fun (ZMod.dft.symm_apply_apply u) x
    rw [ZMod.invDFT_apply] at hh
    simpa only [smul_eq_mul] using hh.symm
  calc
    _ = ∑ x : ZMod d, (d:ℂ)⁻¹ *
        ∑ h : ZMod d, ZMod.dft u h*(ZMod.stdAddChar (h*x)*v x) := by
      apply Finset.sum_congr rfl
      intro x hx
      rw [hinv, mul_assoc, Finset.sum_mul]
      congr 1
      apply Finset.sum_congr rfl
      intro h hh
      ring
    _ = (d:ℂ)⁻¹ * ∑ h : ZMod d, ZMod.dft u h *
        ∑ x : ZMod d, ZMod.stdAddChar (h*x)*v x := by
      rw [← Finset.mul_sum, Finset.sum_comm]
      simp only [Finset.mul_sum]
    _ = _ := by
      congr 1
      apply Finset.sum_congr rfl
      intro h hh
      congr 1
      simp only [ZMod.dft_apply, smul_eq_mul, mul_neg, neg_neg, mul_comm h]

lemma zmod_fourier_pairing_sub_mean (d : ℕ) [NeZero d] (u v : ZMod d → ℂ) :
    (∑ x : ZMod d, u x*v x) - (d:ℂ)⁻¹*(∑ x : ZMod d, u x)*(∑ x : ZMod d, v x) =
      (d:ℂ)⁻¹ * ∑ h ∈ (Finset.univ : Finset (ZMod d)).erase 0,
        ZMod.dft u h * ZMod.dft v (-h) := by
  rw [zmod_fourier_pairing]
  have hh := Finset.sum_erase_add (Finset.univ : Finset (ZMod d))
    (fun h ↦ ZMod.dft u h*ZMod.dft v (-h)) (Finset.mem_univ 0)
  dsimp only at hh
  rw [neg_zero, ZMod.dft_apply_zero, ZMod.dft_apply_zero] at hh
  rw [← hh]
  ring

/-- Counting function of the image of a finite set of integers in a residue ring. -/
noncomputable def finiteResidueWindow (d : ℕ) (s : Finset ℕ) (x : ZMod d) : ℂ :=
  ∑ n ∈ s, if (n:ZMod d) = x then 1 else 0

lemma finiteResidueWindow_pairing (d : ℕ) [NeZero d] (s : Finset ℕ) (u : ZMod d → ℂ) :
    (∑ x : ZMod d, u x*finiteResidueWindow d s x) = ∑ n ∈ s, u (n:ZMod d) := by
  simp only [finiteResidueWindow, Finset.mul_sum, mul_ite, mul_one, mul_zero]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro n hn
  simp

lemma finiteResidueWindow_sum (d : ℕ) [NeZero d] (s : Finset ℕ) :
    (∑ x : ZMod d, finiteResidueWindow d s x) = (s.card:ℂ) := by
  simpa only [one_mul, Finset.sum_const, nsmul_eq_mul, mul_one] using
    finiteResidueWindow_pairing d s (fun _ ↦ (1:ℂ))

lemma finiteResidueWindow_fourier (d : ℕ) [NeZero d] (s : Finset ℕ) (h : ZMod d) :
    ZMod.dft (finiteResidueWindow d s) h =
      ∑ n ∈ s, ZMod.stdAddChar (-((n:ZMod d)*h)) := by
  rw [ZMod.dft_apply]
  simp only [smul_eq_mul]
  exact finiteResidueWindow_pairing d s (fun x ↦ ZMod.stdAddChar (-(x*h)))

noncomputable def polynomialModularRootIndicator (f : ℤ[X]) (d : ℕ) (x : ZMod d) : ℂ :=
  if f.eval₂ (Int.castRingHom (ZMod d)) x = 0 then 1 else 0

lemma polynomialModularRootIndicator_natCast (f : ℤ[X]) (d n : ℕ) :
    polynomialModularRootIndicator f d (n:ZMod d) =
      if (d:ℤ) ∣ f.eval (n:ℤ) then (1:ℂ) else 0 := by
  simp only [polynomialModularRootIndicator, ← dvd_eval_iff_eval_mod]

lemma polynomialModularRootIndicator_sum (f : ℤ[X]) (d : ℕ) [NeZero d] :
    (∑ x : ZMod d, polynomialModularRootIndicator f d x) = (polynomialRootCount f d:ℂ) := by
  unfold polynomialModularRootIndicator
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_one]
  congr 1
  change _ = (polynomialRootResidues f d).card
  rw [rootResidues_card_eq_modularRoot, Nat.card_eq_fintype_card]
  exact (Fintype.card_subtype _).symm

/-- Additive Fourier coefficient of the modular root set. -/
noncomputable def polynomialRootFourier (f : ℤ[X]) (d : ℕ) [NeZero d] (h : ZMod d) : ℂ :=
  ZMod.dft (polynomialModularRootIndicator f d) h

lemma polynomialRootFourier_zero (f : ℤ[X]) (d : ℕ) [NeZero d] :
    polynomialRootFourier f d 0 = (polynomialRootCount f d:ℂ) := by
  rw [polynomialRootFourier, ZMod.dft_apply_zero, polynomialModularRootIndicator_sum]

lemma polynomialRootFourier_norm_le (f : ℤ[X]) (d : ℕ) [NeZero d] (h : ZMod d) :
    ‖polynomialRootFourier f d h‖ ≤ (polynomialRootCount f d:ℝ) := by
  unfold polynomialRootFourier
  rw [ZMod.dft_apply]
  calc
    _ ≤ ∑ x : ZMod d, ‖ZMod.stdAddChar (-(x*h)) • polynomialModularRootIndicator f d x‖ := norm_sum_le ..
    _ = ∑ x : ZMod d, if f.eval₂ (Int.castRingHom (ZMod d)) x = 0 then (1:ℝ) else 0 := by
      apply Finset.sum_congr rfl
      intro x hx
      simp only [polynomialModularRootIndicator, smul_eq_mul, norm_mul, AddChar.norm_apply,
        one_mul]
      split_ifs <;> simp
    _ = _ := by
      have hh := congrArg Complex.re (polynomialModularRootIndicator_sum f d)
      simpa only [Complex.re_sum, polynomialModularRootIndicator, apply_ite, Complex.one_re,
        Complex.zero_re, Complex.natCast_re] using hh

lemma polynomialRootDiscrepancyAt_fourier (f : ℤ[X]) (d N : ℕ) [NeZero d] :
    (polynomialRootDiscrepancyAt f d N:ℂ) =
      (d:ℂ)⁻¹ * ∑ h ∈ (Finset.univ : Finset (ZMod d)).erase 0,
        polynomialRootFourier f d h *
          ∑ n ∈ polynomialRootDensityEligible f d N, ZMod.stdAddChar ((n:ZMod d)*h) := by
  have hp := zmod_fourier_pairing_sub_mean d (polynomialModularRootIndicator f d)
    (finiteResidueWindow d (polynomialRootDensityEligible f d N))
  rw [finiteResidueWindow_pairing, polynomialModularRootIndicator_sum, finiteResidueWindow_sum] at hp
  have hc : (∑ n ∈ polynomialRootDensityEligible f d N, polynomialModularRootIndicator f d (n:ZMod d)) =
      (((Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧
        (d:ℤ)^2 ≤ f.eval (n:ℤ))).card:ℂ) := by
    simp only [polynomialModularRootIndicator_natCast, polynomialRootDensityEligible,
      Finset.sum_filter, Finset.card_eq_sum_ones, Nat.cast_sum, Nat.cast_one]
    apply Finset.sum_congr rfl
    intro n hn
    split_ifs <;> simp_all
  rw [hc] at hp
  have he : (polynomialRootDiscrepancyAt f d N:ℂ) =
      (((Finset.Iic N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ) ∧
        (d:ℤ)^2 ≤ f.eval (n:ℤ))).card:ℂ) -
      (d:ℂ)⁻¹*(polynomialRootCount f d:ℂ)*((polynomialRootDensityEligible f d N).card:ℂ) := by
    unfold polynomialRootDiscrepancyAt
    push_cast
    ring
  rw [he, hp]
  congr 1
  apply Finset.sum_congr rfl
  intro h hh
  rw [finiteResidueWindow_fourier]
  simp only [mul_neg, neg_neg]
  rfl


lemma zmod_stdAddChar_neg_conj (d : ℕ) [NeZero d] (x : ZMod d) :
    ZMod.stdAddChar (-x) = (starRingEnd ℂ) (ZMod.stdAddChar x) := by
  rw [AddChar.map_neg_eq_inv, Complex.inv_eq_conj (AddChar.norm_apply _ _)]

lemma zmod_dft_conj_neg (d : ℕ) [NeZero d] (u : ZMod d → ℂ) (h : ZMod d) :
    ZMod.dft (fun x ↦ (starRingEnd ℂ) (u x)) (-h) = (starRingEnd ℂ) (ZMod.dft u h) := by
  simp only [ZMod.dft_apply, smul_eq_mul, map_sum, map_mul, mul_neg, neg_neg]
  apply Finset.sum_congr rfl
  intro x hx
  rw [← zmod_stdAddChar_neg_conj, neg_neg]

lemma zmod_dft_parseval (d : ℕ) [NeZero d] (u : ZMod d → ℂ) :
    (∑ h : ZMod d, ‖ZMod.dft u h‖^2) = (d:ℝ)*∑ x : ZMod d, ‖u x‖^2 := by
  have hh := zmod_fourier_pairing d u (fun x ↦ (starRingEnd ℂ) (u x))
  simp only [zmod_dft_conj_neg, Complex.mul_conj, Complex.normSq_eq_norm_sq,
    ← Complex.ofReal_sum] at hh
  have hdc : (d:ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne d)
  have he : (∑ h : ZMod d, ((‖ZMod.dft u h‖^2:ℝ):ℂ)) =
      (d:ℂ)*∑ x : ZMod d, ((‖u x‖^2:ℝ):ℂ) := by
    rw [← Complex.ofReal_sum, ← Complex.ofReal_sum]
    rw [hh]
    field_simp
  exact_mod_cast he

lemma polynomialModularRootIndicator_sq_norm_sum (f : ℤ[X]) (d : ℕ) [NeZero d] :
    (∑ x : ZMod d, ‖polynomialModularRootIndicator f d x‖^2) = (polynomialRootCount f d:ℝ) := by
  have hh := congrArg Complex.re (polynomialModularRootIndicator_sum f d)
  simp only [Complex.re_sum, polynomialModularRootIndicator, apply_ite, Complex.one_re,
    Complex.zero_re, Complex.natCast_re] at hh
  rw [← hh]
  apply Finset.sum_congr rfl
  intro x hx
  simp only [polynomialModularRootIndicator]
  split_ifs <;> simp

lemma polynomialRootFourier_energy (f : ℤ[X]) (d : ℕ) [NeZero d] :
    (∑ h : ZMod d, ‖polynomialRootFourier f d h‖^2) = (d:ℝ)*(polynomialRootCount f d:ℝ) := by
  simp only [polynomialRootFourier]
  rw [zmod_dft_parseval, polynomialModularRootIndicator_sq_norm_sum]

lemma polynomialRootFourier_nonzero_energy (f : ℤ[X]) (d : ℕ) [NeZero d] :
    (∑ h ∈ (Finset.univ : Finset (ZMod d)).erase 0, ‖polynomialRootFourier f d h‖^2) =
      (d:ℝ)*(polynomialRootCount f d:ℝ)-(polynomialRootCount f d:ℝ)^2 := by
  have hh := Finset.sum_erase_add (Finset.univ : Finset (ZMod d))
    (fun h ↦ ‖polynomialRootFourier f d h‖^2) (Finset.mem_univ 0)
  dsimp only at hh
  rw [polynomialRootFourier_zero, _root_.norm_natCast, polynomialRootFourier_energy] at hh
  linarith

lemma polynomialRootDiscrepancyAt_fourier_bound (f : ℤ[X]) (d N : ℕ) [NeZero d] :
    |polynomialRootDiscrepancyAt f d N| ≤ (d:ℝ)⁻¹ *
      ∑ h ∈ (Finset.univ : Finset (ZMod d)).erase 0,
        ‖polynomialRootFourier f d h‖ *
          ‖∑ n ∈ polynomialRootDensityEligible f d N, ZMod.stdAddChar ((n:ZMod d)*h)‖ := by
  have hh := congrArg norm (polynomialRootDiscrepancyAt_fourier f d N)
  rw [Complex.norm_real, Real.norm_eq_abs, norm_mul, norm_inv, _root_.norm_natCast] at hh
  rw [hh]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  exact (norm_sum_le ..).trans_eq (by simp only [norm_mul])


lemma polynomialModularRootIndicator_pairing (f : ℤ[X]) (d : ℕ) [NeZero d] (u : ZMod d → ℂ) :
    (∑ x : ZMod d, polynomialModularRootIndicator f d x*u x) =
      ∑ r ∈ polynomialRootResidues f d, u (r:ZMod d) := by
  simp only [polynomialModularRootIndicator, ite_mul, one_mul, zero_mul]
  rw [← Finset.sum_filter]
  apply Finset.sum_bij (fun x _ ↦ x.val)
  · intro x hx
    have hroot := (Finset.mem_filter.mp hx).2
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_range.mpr (ZMod.val_lt x), ?_⟩
    apply (dvd_eval_iff_eval_mod f d x.val).mpr
    rwa [ZMod.natCast_zmod_val]
  · intro x hx y hy hxy
    exact ZMod.val_injective d hxy
  · intro r hr
    obtain ⟨hrD, hdiv⟩ := Finset.mem_filter.mp hr
    refine ⟨(r:ZMod d), Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      (dvd_eval_iff_eval_mod f d r).mp hdiv⟩, ?_⟩
    exact ZMod.val_natCast_of_lt (Finset.mem_range.mp hrD)
  · intro x hx
    rw [ZMod.natCast_zmod_val]

lemma polynomialRootFourier_as_residues (f : ℤ[X]) (d : ℕ) [NeZero d] (h : ZMod d) :
    polynomialRootFourier f d h =
      ∑ r ∈ polynomialRootResidues f d, ZMod.stdAddChar (-((r:ZMod d)*h)) := by
  unfold polynomialRootFourier
  rw [ZMod.dft_apply]
  simp only [smul_eq_mul, mul_comm _ (polynomialModularRootIndicator f d _)]
  exact polynomialModularRootIndicator_pairing f d (fun x ↦ ZMod.stdAddChar (-(x*h)))

/-- The nonzero-frequency expression, extended by zero at modulus zero. -/
noncomputable def polynomialRootFourierDiscrepancy (f : ℤ[X]) (d N : ℕ) : ℂ :=
  if hd : d = 0 then 0 else
    letI : NeZero d := ⟨hd⟩
    (d:ℂ)⁻¹ * ∑ h ∈ (Finset.univ : Finset (ZMod d)).erase 0,
      polynomialRootFourier f d h *
        ∑ n ∈ polynomialRootDensityEligible f d N, ZMod.stdAddChar ((n:ZMod d)*h)

lemma polynomialRootFourierDiscrepancy_eq (f : ℤ[X]) (d N : ℕ) (hd : 0 < d) :
    polynomialRootFourierDiscrepancy f d N = (polynomialRootDiscrepancyAt f d N:ℂ) := by
  haveI : NeZero d := ⟨hd.ne'⟩
  rw [polynomialRootFourierDiscrepancy, dif_neg hd.ne']
  exact (polynomialRootDiscrepancyAt_fourier f d N).symm

lemma polynomialLargeRootDensityDiscrepancy_fourier (f : ℤ[X]) (N : ℕ) :
    (polynomialLargeRootDensityDiscrepancy f N:ℂ) =
      ∑ d ∈ Finset.Ioc N (polynomialSqrtEnvelope f N N), polynomialRootFourierDiscrepancy f d N := by
  unfold polynomialLargeRootDensityDiscrepancy
  rw [Complex.ofReal_sum]
  apply Finset.sum_congr rfl
  intro d hd
  exact (polynomialRootFourierDiscrepancy_eq f d N
    (lt_of_le_of_lt (Nat.zero_le N) (Finset.mem_Ioc.mp hd).1)).symm


lemma zmod_stdAddChar_crt_int (m n : ℕ) [NeZero m] [NeZero n]
    (a b : ℤ) (hab : (m:ℤ)*a + (n:ℤ)*b = 1) (z : ℤ) :
    ZMod.stdAddChar (z : ZMod (m*n)) =
      ZMod.stdAddChar ((b*z : ℤ) : ZMod m) *
        ZMod.stdAddChar ((a*z : ℤ) : ZMod n) := by
  have hm : (m:ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne m)
  have hn : (n:ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne n)
  have hab' : (m:ℂ)*a + (n:ℂ)*b = 1 := by exact_mod_cast hab
  rw [ZMod.stdAddChar_coe, ZMod.stdAddChar_coe, ZMod.stdAddChar_coe]
  simp only [Int.cast_mul, Nat.cast_mul, ← Complex.exp_add]
  congr 1
  field_simp
  linear_combination -(z:ℂ)*hab'

lemma polynomialModularRootIndicator_crt (f : ℤ[X]) (m n : ℕ)
    (hmn : m.Coprime n) (x : ZMod (m*n)) :
    polynomialModularRootIndicator f (m*n) x =
      polynomialModularRootIndicator f m (ZMod.chineseRemainder hmn x).1 *
        polynomialModularRootIndicator f n (ZMod.chineseRemainder hmn x).2 := by
  let e := ZMod.chineseRemainder hmn
  have hroot : f.eval₂ (Int.castRingHom (ZMod (m*n))) x = 0 ↔
      f.eval₂ (Int.castRingHom (ZMod m)) (e x).1 = 0 ∧
      f.eval₂ (Int.castRingHom (ZMod n)) (e x).2 = 0 := by
    rw [← e.map_eq_zero_iff, Prod.ext_iff]
    have h1 := hom_eval₂_int ((RingHom.fst (ZMod m) (ZMod n)).comp e.toRingHom) f x
    have h2 := hom_eval₂_int ((RingHom.snd (ZMod m) (ZMod n)).comp e.toRingHom) f x
    change (e (f.eval₂ (Int.castRingHom (ZMod (m*n))) x)).1 =
      f.eval₂ (Int.castRingHom (ZMod m)) (e x).1 at h1
    change (e (f.eval₂ (Int.castRingHom (ZMod (m*n))) x)).2 =
      f.eval₂ (Int.castRingHom (ZMod n)) (e x).2 at h2
    rw [h1, h2]
    rfl
  change (if _ then (1:ℂ) else 0) = (if _ then 1 else 0)*(if _ then 1 else 0)
  dsimp only [e] at hroot
  simp only [hroot]
  split_ifs <;> simp_all

lemma zmod_stdAddChar_crt (m n : ℕ) [NeZero m] [NeZero n]
    (hmn : m.Coprime n) (a b : ℤ) (hab : (m:ℤ)*a + (n:ℤ)*b = 1)
    (x : ZMod (m*n)) :
    ZMod.stdAddChar x =
      ZMod.stdAddChar ((b:ZMod m)*(ZMod.chineseRemainder hmn x).1) *
        ZMod.stdAddChar ((a:ZMod n)*(ZMod.chineseRemainder hmn x).2) := by
  have hx : (((x.val:ℤ):ZMod (m*n))) = x := by simp
  have he : ZMod.chineseRemainder hmn (((x.val:ℤ):ZMod (m*n))) =
      (((x.val:ℤ):ZMod m), ((x.val:ℤ):ZMod n)) := by
    rw [map_intCast]
    rfl
  have hh := zmod_stdAddChar_crt_int m n a b hab (x.val:ℤ)
  rw [hx] at he
  rw [he]
  simpa only [Int.cast_mul, hx] using hh

lemma polynomialRootFourier_crt (f : ℤ[X]) (m n : ℕ) [NeZero m] [NeZero n]
    (hmn : m.Coprime n) (a b : ℤ) (hab : (m:ℤ)*a + (n:ℤ)*b = 1)
    (h : ZMod (m*n)) :
    polynomialRootFourier f (m*n) h =
      polynomialRootFourier f m ((b:ZMod m)*(ZMod.chineseRemainder hmn h).1) *
        polynomialRootFourier f n ((a:ZMod n)*(ZMod.chineseRemainder hmn h).2) := by
  let e := ZMod.chineseRemainder hmn
  simp only [polynomialRootFourier, ZMod.dft_apply, smul_eq_mul]
  rw [Finset.sum_mul_sum]
  rw [← Fintype.sum_prod_type']
  apply Fintype.sum_equiv e.toEquiv
  intro x
  rw [polynomialModularRootIndicator_crt f m n hmn x,
    zmod_stdAddChar_crt m n hmn a b hab (-(x*h))]
  simp only [map_neg, map_mul, Prod.fst_neg, Prod.snd_neg, Prod.fst_mul, Prod.snd_mul]
  have hmphase : (b:ZMod m)*(-((e x).1*(e h).1)) = -((e x).1*((b:ZMod m)*(e h).1)) := by ring
  have hnphase : (a:ZMod n)*(-((e x).2*(e h).2)) = -((e x).2*((a:ZMod n)*(e h).2)) := by ring
  change _ = (ZMod.stdAddChar (-((e x).1*((b:ZMod m)*(e h).1))) *
    polynomialModularRootIndicator f m (e x).1) *
      (ZMod.stdAddChar (-((e x).2*((a:ZMod n)*(e h).2))) *
        polynomialModularRootIndicator f n (e x).2)
  rw [hmphase, hnphase]
  ring

/-- CRT factorization with the canonical Bézout coefficients. -/
lemma polynomialRootFourier_crt_gcd (f : ℤ[X]) (m n : ℕ) [NeZero m] [NeZero n]
    (hmn : m.Coprime n) (h : ZMod (m*n)) :
    polynomialRootFourier f (m*n) h =
      polynomialRootFourier f m ((m.gcdB n:ZMod m)*(ZMod.chineseRemainder hmn h).1) *
        polynomialRootFourier f n ((m.gcdA n:ZMod n)*(ZMod.chineseRemainder hmn h).2) := by
  apply polynomialRootFourier_crt
  simpa only [hmn.gcd_eq_one, Nat.cast_one] using (Nat.gcd_eq_gcd_ab m n).symm

/-- At integer frequency `h`, coprime factorization twists the two frequencies by
`n⁻¹ mod m` and `m⁻¹ mod n`, respectively. -/
lemma polynomialRootFourier_crt_int (f : ℤ[X]) (m n : ℕ) [NeZero m] [NeZero n]
    (hmn : m.Coprime n) (h : ℤ) :
    polynomialRootFourier f (m*n) (h:ZMod (m*n)) =
      polynomialRootFourier f m ((m.gcdB n*h:ℤ):ZMod m) *
        polynomialRootFourier f n ((m.gcdA n*h:ℤ):ZMod n) := by
  rw [polynomialRootFourier_crt_gcd f m n hmn]
  simp only [map_intCast, Int.cast_mul, Prod.fst_intCast, Prod.snd_intCast]


lemma zmod_bezout_inv_left (m n : ℕ) (a b : ℤ)
    (hab : (m:ℤ)*a + (n:ℤ)*b = 1) : (n:ZMod m)*(b:ZMod m) = 1 := by
  have h := congrArg (Int.castRingHom (ZMod m)) hab
  simpa only [map_add, map_mul, map_one, Int.coe_castRingHom, Int.cast_natCast,
    ZMod.natCast_self, zero_mul, zero_add] using h

lemma zmod_bezout_inv_right (m n : ℕ) (a b : ℤ)
    (hab : (m:ℤ)*a + (n:ℤ)*b = 1) : (m:ZMod n)*(a:ZMod n) = 1 := by
  have h := congrArg (Int.castRingHom (ZMod n)) hab
  simpa only [map_add, map_mul, map_one, Int.coe_castRingHom, Int.cast_natCast,
    ZMod.natCast_self, zero_mul, add_zero] using h

/-- The CRT frequency twists form a bijection of frequency spaces. -/
noncomputable def crtFourierFrequencyEquiv (m n : ℕ) (hmn : m.Coprime n)
    (a b : ℤ) (hab : (m:ℤ)*a + (n:ℤ)*b = 1) :
    ZMod (m*n) ≃ ZMod m × ZMod n :=
  (ZMod.chineseRemainder hmn).toEquiv.trans
    (Equiv.prodCongr
      (Units.mulLeft ⟨(b:ZMod m), (n:ZMod m),
        by rw [mul_comm]; exact zmod_bezout_inv_left m n a b hab,
        zmod_bezout_inv_left m n a b hab⟩)
      (Units.mulLeft ⟨(a:ZMod n), (m:ZMod n),
        by rw [mul_comm]; exact zmod_bezout_inv_right m n a b hab,
        zmod_bezout_inv_right m n a b hab⟩))

lemma crtFourierFrequencyEquiv_apply (m n : ℕ) (hmn : m.Coprime n)
    (a b : ℤ) (hab : (m:ℤ)*a + (n:ℤ)*b = 1) (h : ZMod (m*n)) :
    crtFourierFrequencyEquiv m n hmn a b hab h =
      ((b:ZMod m)*(ZMod.chineseRemainder hmn h).1,
        (a:ZMod n)*(ZMod.chineseRemainder hmn h).2) := rfl

noncomputable def polynomialRootFourierNormSum (f : ℤ[X]) (d : ℕ) [NeZero d] : ℝ :=
  ∑ h : ZMod d, ‖polynomialRootFourier f d h‖

lemma polynomialRootFourierNormSum_nonneg (f : ℤ[X]) (d : ℕ) [NeZero d] :
    0 ≤ polynomialRootFourierNormSum f d := Finset.sum_nonneg (fun _ _ ↦ norm_nonneg _)

lemma polynomialRootFourierNormSum_mul (f : ℤ[X]) (m n : ℕ) [NeZero m] [NeZero n]
    (hmn : m.Coprime n) :
    polynomialRootFourierNormSum f (m*n) =
      polynomialRootFourierNormSum f m * polynomialRootFourierNormSum f n := by
  have hab : (m:ℤ)*m.gcdA n + (n:ℤ)*m.gcdB n = 1 := by
    simpa only [hmn.gcd_eq_one, Nat.cast_one] using (Nat.gcd_eq_gcd_ab m n).symm
  unfold polynomialRootFourierNormSum
  rw [Finset.sum_mul_sum, ← Fintype.sum_prod_type']
  apply Fintype.sum_equiv (crtFourierFrequencyEquiv m n hmn (m.gcdA n) (m.gcdB n) hab)
  intro h
  rw [polynomialRootFourier_crt_gcd f m n hmn, norm_mul]
  rfl

lemma polynomialRootFourierNormSum_one (f : ℤ[X]) :
    polynomialRootFourierNormSum f 1 = 1 := by
  have h : ∀ h : ZMod 1, polynomialRootFourier f 1 h = 1 := by
    intro h
    rw [Subsingleton.elim h 0, polynomialRootFourier_zero]
    have hr := (polynomialRootCount_multiplicative f).map_one
    exact_mod_cast hr
  simp only [polynomialRootFourierNormSum, h, norm_one, Finset.sum_const,
    Finset.card_univ, ZMod.card, nsmul_eq_mul, Nat.cast_one, mul_one]

lemma polynomialRootFourierNormSum_le (f : ℤ[X]) (d : ℕ) [NeZero d] :
    polynomialRootFourierNormSum f d ≤ (d:ℝ)*Real.sqrt (polynomialRootCount f d) := by
  have hh := Finset.sum_mul_sq_le_sq_mul_sq (Finset.univ : Finset (ZMod d))
    (fun h ↦ ‖polynomialRootFourier f d h‖) (fun _ ↦ (1:ℝ))
  simp only [mul_one, one_pow, Finset.sum_const, Finset.card_univ, ZMod.card,
    nsmul_eq_mul, polynomialRootFourier_energy] at hh
  apply (sq_le_sq₀ (polynomialRootFourierNormSum_nonneg f d) (by positivity)).mp
  rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg _)]
  change (∑ h : ZMod d, ‖polynomialRootFourier f d h‖)^2 ≤ _
  nlinarith

/-- Normalized full-frequency Fourier mass, extended by zero at modulus zero. -/
noncomputable def polynomialRootFourierMass (f : ℤ[X]) : ArithmeticFunction ℝ where
  toFun d := if hd : d = 0 then 0 else
    letI : NeZero d := ⟨hd⟩
    polynomialRootFourierNormSum f d / d
  map_zero' := by simp

lemma polynomialRootFourierMass_apply (f : ℤ[X]) (d : ℕ) [NeZero d] :
    polynomialRootFourierMass f d = polynomialRootFourierNormSum f d / d := by
  simp [polynomialRootFourierMass, NeZero.ne d]

lemma polynomialRootFourierMass_nonneg (f : ℤ[X]) (d : ℕ) :
    0 ≤ polynomialRootFourierMass f d := by
  by_cases hd : d = 0
  · simp [hd]
  · haveI : NeZero d := ⟨hd⟩
    rw [polynomialRootFourierMass_apply]
    exact div_nonneg (polynomialRootFourierNormSum_nonneg f d) (Nat.cast_nonneg _)

lemma polynomialRootFourierMass_le_sqrt (f : ℤ[X]) (d : ℕ) :
    polynomialRootFourierMass f d ≤ Real.sqrt (polynomialRootCount f d) := by
  by_cases hd : d = 0
  · simp [hd]
  · haveI : NeZero d := ⟨hd⟩
    rw [polynomialRootFourierMass_apply]
    apply (div_le_iff₀ (by exact_mod_cast Nat.pos_of_ne_zero hd)).mpr
    simpa only [mul_comm] using polynomialRootFourierNormSum_le f d

lemma polynomialRootFourierMass_multiplicative (f : ℤ[X]) :
    (polynomialRootFourierMass f).IsMultiplicative := by
  rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
  constructor
  · rw [polynomialRootFourierMass_apply, polynomialRootFourierNormSum_one]
    norm_num
  · intro m n hm hn hmn
    haveI : NeZero m := ⟨hm⟩
    haveI : NeZero n := ⟨hn⟩
    simp only [polynomialRootFourierMass_apply, polynomialRootFourierNormSum_mul f m n hmn,
      Nat.cast_mul, mul_div_mul_comm]

lemma polynomialRootFourierMass_le_rootCount (f : ℤ[X]) (d : ℕ) :
    polynomialRootFourierMass f d ≤ (polynomialRootCount f d:ℝ) := by
  by_cases hd : d = 0
  · simp [hd]
  · haveI : NeZero d := ⟨hd⟩
    rw [polynomialRootFourierMass_apply]
    apply (div_le_iff₀ (by exact_mod_cast Nat.pos_of_ne_zero hd)).mpr
    unfold polynomialRootFourierNormSum
    have h := Finset.sum_le_card_nsmul (Finset.univ : Finset (ZMod d))
      (fun h ↦ ‖polynomialRootFourier f d h‖) (polynomialRootCount f d:ℝ)
      (fun _ _ ↦ polynomialRootFourier_norm_le f d _)
    simpa only [Finset.card_univ, ZMod.card, nsmul_eq_mul, mul_comm] using h

lemma one_le_polynomialRootFourierMass (f : ℤ[X]) (d : ℕ) [NeZero d]
    (hr : 0 < polynomialRootCount f d) : 1 ≤ polynomialRootFourierMass f d := by
  change 0 < (polynomialRootResidues f d).card at hr
  obtain ⟨r, hr⟩ := Finset.card_pos.mp hr
  have he : polynomialModularRootIndicator f d (r:ZMod d) = 1 := by
    rw [polynomialModularRootIndicator_natCast, if_pos (Finset.mem_filter.mp hr).2]
  have hi := congr_fun (ZMod.dft.symm_apply_apply (polynomialModularRootIndicator f d))
    (r:ZMod d)
  rw [ZMod.invDFT_apply, he] at hi
  have hnorm := congrArg norm hi
  simp only [smul_eq_mul, norm_mul, norm_inv, _root_.norm_natCast, norm_one] at hnorm
  rw [polynomialRootFourierMass_apply, div_eq_mul_inv, mul_comm]
  rw [← hnorm]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  calc
    ‖∑ h : ZMod d, ZMod.stdAddChar (h*(r:ZMod d)) *
        ZMod.dft (polynomialModularRootIndicator f d) h‖ ≤
      ∑ h : ZMod d, ‖ZMod.stdAddChar (h*(r:ZMod d)) *
        ZMod.dft (polynomialModularRootIndicator f d) h‖ := norm_sum_le ..
    _ = polynomialRootFourierNormSum f d := by
      simp only [norm_mul, AddChar.norm_apply, one_mul, polynomialRootFourierNormSum,
        polynomialRootFourier]

lemma polynomialRootFourierMass_eq_zero_of_rootCount_eq_zero (f : ℤ[X]) (d : ℕ)
    (hr : polynomialRootCount f d = 0) : polynomialRootFourierMass f d = 0 := by
  apply le_antisymm _ (polynomialRootFourierMass_nonneg f d)
  simpa only [hr, Nat.cast_zero] using polynomialRootFourierMass_le_rootCount f d

lemma polynomialRootFourierMass_eq_one_of_rootCount_eq_one (f : ℤ[X]) (d : ℕ)
    (hr : polynomialRootCount f d = 1) : polynomialRootFourierMass f d = 1 := by
  have hd : d ≠ 0 := by intro hd; simpa [hd] using hr
  haveI : NeZero d := ⟨hd⟩
  apply le_antisymm
  · simpa only [hr, Nat.cast_one] using polynomialRootFourierMass_le_rootCount f d
  · apply one_le_polynomialRootFourierMass
    omega

lemma polynomialRootFourierMass_lt_rootCount (f : ℤ[X]) (d : ℕ)
    (hr : 1 < polynomialRootCount f d) :
    polynomialRootFourierMass f d < (polynomialRootCount f d:ℝ) := by
  apply (polynomialRootFourierMass_le_sqrt f d).trans_lt
  have hr' : 1 < (polynomialRootCount f d:ℝ) := by exact_mod_cast hr
  have hs := Real.sq_sqrt (Nat.cast_nonneg (α := ℝ) (polynomialRootCount f d))
  nlinarith [Real.sqrt_nonneg (polynomialRootCount f d)]


lemma mem_floor_divisors_iff (z : ℤ) (d : ℕ) (hd : 0 < d) :
    d ∈ (⌊z⌋₊).divisors ↔ (d:ℤ) ∣ z ∧ 1 ≤ z := by
  by_cases hz : 1 ≤ z
  · have hcast : ((⌊z⌋₊:ℕ):ℤ) = z := by
      rw [Nat.floor_int, Int.toNat_of_nonneg (by omega)]
    have hne : (⌊z⌋₊:ℕ) ≠ 0 := by intro he; rw [he] at hcast; norm_num at hcast; omega
    rw [Nat.mem_divisors, and_iff_left hne, and_iff_left hz]
    exact_mod_cast (show (d:ℤ) ∣ (⌊z⌋₊:ℕ) ↔ (d:ℤ) ∣ z by rw [hcast])
  · have he : (⌊z⌋₊:ℕ) = 0 := by rw [Nat.floor_int]; exact Int.toNat_eq_zero.mpr (by omega)
    simp [he, hz]

noncomputable def polynomialFloorDivisorCount (f : ℤ[X]) (d N : ℕ) : ℕ :=
  ((Finset.range N).filter (fun n : ℕ ↦ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors)).card

lemma polynomialFloorDivisorCount_error (f : ℤ[X]) (K : ℕ)
    (hpos : ∀ n : ℕ, K ≤ n → 1 ≤ f.eval (n:ℤ)) (d N : ℕ) (hd : 0 < d) :
    |(polynomialFloorDivisorCount f d N:ℝ) - (N:ℝ)/d*(polynomialRootCount f d:ℝ)| ≤
      (polynomialRootCount f d:ℝ) + K := by
  let S := (Finset.range N).filter (fun n : ℕ ↦ (d:ℤ) ∣ f.eval (n:ℤ))
  let T := (Finset.range N).filter (fun n : ℕ ↦ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors)
  have hTS : T ⊆ S := by
    intro n hn
    obtain ⟨hnN, hn⟩ := Finset.mem_filter.mp hn
    exact Finset.mem_filter.mpr ⟨hnN, ((mem_floor_divisors_iff _ d hd).mp hn).1⟩
  have hST : S ⊆ T ∪ Finset.range K := by
    intro n hn
    obtain ⟨hnN, hn⟩ := Finset.mem_filter.mp hn
    by_cases hnK : n < K
    · exact Finset.mem_union_right _ (Finset.mem_range.mpr hnK)
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hnN,
        (mem_floor_divisors_iff _ d hd).mpr ⟨hn, hpos n (by omega)⟩⟩)
  have hcard1 : (T.card:ℝ) ≤ S.card := by exact_mod_cast Finset.card_le_card hTS
  have hcard2 : (S.card:ℝ) ≤ T.card + K := by
    have hh := (Finset.card_le_card hST).trans (Finset.card_union_le _ _)
    simp only [Finset.card_range] at hh
    exact_mod_cast hh
  have herr : |(T.card:ℝ)-(S.card:ℝ)| ≤ K := by rw [abs_le]; constructor <;> linarith
  have hroot := polynomial_root_count_error f d N hd
  change |(S.card:ℝ)-(N:ℝ)/d*(polynomialRootCount f d:ℝ)| ≤
    (polynomialRootCount f d:ℝ) at hroot
  change |(T.card:ℝ)-_| ≤ _
  calc
    _ ≤ |(T.card:ℝ)-(S.card:ℝ)| + |(S.card:ℝ)-(N:ℝ)/d*(polynomialRootCount f d:ℝ)| :=
      abs_sub_le _ _ _
    _ ≤ _ := by linarith

noncomputable def polynomialWeightedDivisorSum (f : ℤ[X]) (w : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.range N, ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors, w d

noncomputable def polynomialWeightedDivisorTrunc (f : ℤ[X]) (w : ℕ → ℝ) (N D : ℕ) : ℝ :=
  ∑ n ∈ Finset.range N, ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter (fun d ↦ d ≤ D), w d

lemma polynomialWeightedDivisorTrunc_swap (f : ℤ[X]) (w : ℕ → ℝ) (N D : ℕ) :
    polynomialWeightedDivisorTrunc f w N D =
      ∑ d ∈ Finset.Icc 1 D, w d*(polynomialFloorDivisorCount f d N:ℝ) := by
  have he : ∀ n : ℕ, (⌊f.eval (n:ℤ)⌋₊).divisors.filter (fun d ↦ d ≤ D) =
      (Finset.Icc 1 D).filter (fun d ↦ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors) := by
    intro n
    ext d
    simp only [Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro ⟨hd, hD⟩
      exact ⟨⟨Nat.pos_of_mem_divisors hd, hD⟩, hd⟩
    · tauto
  unfold polynomialWeightedDivisorTrunc polynomialFloorDivisorCount
  simp only [he, Finset.sum_filter, Finset.card_eq_sum_ones, Nat.cast_sum, Nat.cast_one,
    Finset.mul_sum, mul_ite, mul_one, mul_zero]
  rw [Finset.sum_comm]
  simp only [Nat.cast_ite, Nat.cast_one, Nat.cast_zero, mul_ite, mul_one, mul_zero]

lemma polynomialWeightedDivisorTrunc_error (f : ℤ[X]) (K : ℕ)
    (hpos : ∀ n : ℕ, K ≤ n → 1 ≤ f.eval (n:ℤ))
    (w : ℕ → ℝ) (hw : ∀ d, 0 ≤ w d) (N D : ℕ) :
    |polynomialWeightedDivisorTrunc f w N D -
      (N:ℝ)*∑ d ∈ Finset.Icc 1 D, (polynomialRootCount f d:ℝ)/d*w d| ≤
        ∑ d ∈ Finset.Icc 1 D, ((polynomialRootCount f d:ℝ)+K)*w d := by
  rw [polynomialWeightedDivisorTrunc_swap, Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum ?_)
  intro d hd
  have he := polynomialFloorDivisorCount_error f K hpos d N (Finset.mem_Icc.mp hd).1
  calc
    |w d*(polynomialFloorDivisorCount f d N:ℝ)-
        (N:ℝ)*((polynomialRootCount f d:ℝ)/d*w d)| =
      |(polynomialFloorDivisorCount f d N:ℝ)-(N:ℝ)/d*(polynomialRootCount f d:ℝ)| * w d := by
      conv_rhs => rw [← abs_of_nonneg (hw d), ← abs_mul]
      congr 1
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_right he (hw d)

lemma polynomialWeightedDivisorSum_sub_trunc_bounds (f : ℤ[X]) (w : ℕ → ℝ)
    (hw : ∀ d, 0 ≤ w d) (N D : ℕ) (hmono : ∀ d : ℕ, D < d → w d ≤ w D) :
    0 ≤ polynomialWeightedDivisorSum f w N - polynomialWeightedDivisorTrunc f w N D ∧
    polynomialWeightedDivisorSum f w N - polynomialWeightedDivisorTrunc f w N D ≤
      w D*Erdos975Sum f N := by
  have he : polynomialWeightedDivisorSum f w N - polynomialWeightedDivisorTrunc f w N D =
      ∑ n ∈ Finset.range N,
        ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter (fun d ↦ D < d), w d := by
    unfold polynomialWeightedDivisorSum polynomialWeightedDivisorTrunc
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro n hn
    have hh := Finset.sum_filter_add_sum_filter_not (s := (⌊f.eval (n:ℤ)⌋₊).divisors)
      (p := fun d ↦ d ≤ D) (f := w)
    simp only [not_le] at hh
    linarith
  rw [he]
  constructor
  · exact Finset.sum_nonneg (fun _ _ ↦ Finset.sum_nonneg (fun _ _ ↦ hw _))
  · calc
      _ ≤ ∑ n ∈ Finset.range N, w D * (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) := by
        apply Finset.sum_le_sum
        intro n hn
        calc
          _ ≤ ∑ _d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter (fun d ↦ D < d), w D := by
            exact Finset.sum_le_sum (fun d hd ↦ hmono d (Finset.mem_filter.mp hd).2)
          _ ≤ w D * (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) := by
            rw [Finset.sum_const, nsmul_eq_mul, mul_comm, ArithmeticFunction.sigma_zero_apply]
            exact mul_le_mul_of_nonneg_left (by exact_mod_cast Finset.card_filter_le _ _) (hw D)
      _ ≤ w D*Erdos975Sum f N := by
        rw [← Finset.mul_sum]
        apply mul_le_mul_of_nonneg_left _ (hw D)
        simp only [Erdos975Sum, Nat.floor_natCast]
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro n hn
          exact Finset.mem_Iic.mpr (Nat.le_of_lt (Finset.mem_range.mp hn))
        · exact fun _ _ _ ↦ Nat.cast_nonneg _

lemma polynomialWeightedDivisorSum_error (f : ℤ[X]) (K : ℕ)
    (hpos : ∀ n : ℕ, K ≤ n → 1 ≤ f.eval (n:ℤ))
    (w : ℕ → ℝ) (hw : ∀ d, 0 ≤ w d) (N D : ℕ)
    (hmono : ∀ d : ℕ, D < d → w d ≤ w D) :
    |polynomialWeightedDivisorSum f w N -
      (N:ℝ)*∑ d ∈ Finset.Icc 1 D, (polynomialRootCount f d:ℝ)/d*w d| ≤
        (∑ d ∈ Finset.Icc 1 D, ((polynomialRootCount f d:ℝ)+K)*w d) +
          w D*Erdos975Sum f N := by
  obtain ⟨hlo, hhi⟩ := polynomialWeightedDivisorSum_sub_trunc_bounds f w hw N D hmono
  have ht := polynomialWeightedDivisorTrunc_error f K hpos w hw N D
  have hh := abs_sub_le (polynomialWeightedDivisorSum f w N)
    (polynomialWeightedDivisorTrunc f w N D)
    ((N:ℝ)*∑ d ∈ Finset.Icc 1 D, (polynomialRootCount f d:ℝ)/d*w d)
  rw [abs_of_nonneg hlo] at hh
  linarith

lemma weighted_mean_tendsto_zero_of_bounded_mean (u w : ℕ → ℝ)
    (hu : ∀ d, 0 ≤ u d) (hw : ∀ d, 0 ≤ w d)
    (B : ℝ) (hB : 0 ≤ B) (hbound : ∀ N : ℕ, ∑ d ∈ Finset.Icc 1 N, u d ≤ B*N)
    (hlim : Tendsto w atTop (𝓝 0)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N, u d*w d)/(N:ℝ)) atTop (𝓝 0) := by
  apply tendsto_order.mpr
  constructor
  · intro a ha
    exact Eventually.of_forall (fun N ↦ ha.trans_le
      (div_nonneg (Finset.sum_nonneg (fun d _ ↦ mul_nonneg (hu d) (hw d))) (Nat.cast_nonneg _)))
  · intro ε hε
    let δ := ε/(2*(B+1))
    have hδ : 0 < δ := by dsimp [δ]; positivity
    have hδB : δ*B ≤ ε/2 := by
      have he : δ*(B+1) = ε/2 := by dsimp [δ]; field_simp <;> ring
      nlinarith
    obtain ⟨K, hK⟩ := eventually_atTop.mp (hlim.eventually_lt_const hδ)
    let A := ∑ d ∈ Finset.Icc 1 K, u d*w d
    have hAN : Tendsto (fun N : ℕ ↦ A/(N:ℝ)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
    filter_upwards [hAN.eventually_lt_const (show 0 < ε/2 by linarith),
      eventually_ge_atTop (1:ℕ)] with N hNA hN
    have hsum : (∑ d ∈ Finset.Icc 1 N, u d*w d) ≤ A+δ*(B*N) := by
      have he := Finset.sum_filter_add_sum_filter_not (s := Finset.Icc 1 N)
        (p := fun d ↦ d ≤ K) (f := fun d ↦ u d*w d)
      rw [← he]
      apply add_le_add
      · apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro d hd
          obtain ⟨hdN, hdK⟩ := Finset.mem_filter.mp hd
          exact Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hdN).1, hdK⟩
        · exact fun d _ _ ↦ mul_nonneg (hu d) (hw d)
      · calc
          _ ≤ ∑ d ∈ (Finset.Icc 1 N).filter (fun d ↦ ¬d ≤ K), δ*u d := by
            apply Finset.sum_le_sum
            intro d hd
            have hdK := (Finset.mem_filter.mp hd).2
            exact (mul_le_mul_of_nonneg_left (hK d (by omega)).le (hu d)).trans_eq (mul_comm _ _)
          _ ≤ ∑ d ∈ Finset.Icc 1 N, δ*u d :=
            Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
              (fun d _ _ ↦ mul_nonneg hδ.le (hu d))
          _ ≤ δ*(B*N) := by
            rw [← Finset.mul_sum]
            exact mul_le_mul_of_nonneg_left (hbound N) hδ.le
    have hNp : (0:ℝ) < N := by exact_mod_cast hN
    calc
      _ ≤ (A+δ*(B*N))/(N:ℝ) := div_le_div_of_nonneg_right hsum hNp.le
      _ = A/(N:ℝ)+δ*B := by field_simp <;> ring
      _ < ε := by linarith

lemma polynomialRootCount_rpow_summable (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 0 < t) :
    Summable (fun d : ℕ ↦ (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t)) := by
  obtain ⟨B, hB, hb⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  have hO : (fun N : ℕ ↦ ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))
      =O[atTop] (fun N : ℕ ↦ (N:ℝ)^(1:ℝ)) := by
    apply Asymptotics.IsBigO.of_bound B
    filter_upwards [] with N
    simp only [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg
      (fun d _ ↦ Nat.cast_nonneg (α := ℝ) (polynomialRootCount f d))), Real.rpow_one,
      abs_of_nonneg (Nat.cast_nonneg (α := ℝ) N)]
    exact hb N
  have hs := LSeriesSummable_of_sum_norm_bigO_and_nonneg (s := ((1+t:ℝ):ℂ)) hO
    (fun d ↦ Nat.cast_nonneg (α := ℝ) (polynomialRootCount f d)) (by norm_num)
    (by simp only [Complex.ofReal_re]; linarith)
  apply Complex.summable_ofReal.mp
  apply hs.congr
  intro d
  rw [LSeries.term_def₀ (by simp)]
  by_cases hd : d = 0
  · simp [hd]
  · have hdp : (0:ℝ) < d := by exact_mod_cast Nat.pos_of_ne_zero hd
    have he : (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t) =
        (polynomialRootCount f d:ℝ)*(d:ℝ)^(-(1+t)) := by
      rw [neg_add, Real.rpow_add hdp, Real.rpow_neg_one]
      ring
    rw [he, Complex.ofReal_mul, Complex.ofReal_cpow hdp.le]
    simp only [Complex.ofReal_neg, Complex.ofReal_natCast]

lemma tendsto_sum_Icc_of_summable (u : ℕ → ℝ) (hu : Summable u) (hu0 : u 0 = 0) :
    Tendsto (fun N : ℕ ↦ ∑ d ∈ Finset.Icc 1 N, u d) atTop (𝓝 (∑' d, u d)) := by
  have ht := hu.hasSum.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
  apply ht.congr
  intro N
  dsimp only [Function.comp_def]
  rw [Nat.range_succ_eq_Icc_zero, ← Finset.insert_Icc_add_one_left_eq_Icc (Nat.zero_le N),
    Finset.sum_insert (by simp), hu0, zero_add]
  rfl

noncomputable def polynomialRootWeightedMean (f : ℤ[X]) (t : ℝ) : ℝ :=
  ∑' d : ℕ, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t)

lemma polynomialRootWeightedMean_pos (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 0 < t) :
    0 < polynomialRootWeightedMean f t := by
  have hs := polynomialRootCount_rpow_summable f hdeg hirr t ht
  have hh := hs.le_tsum (1:ℕ) (fun d _ ↦ by positivity)
  have hρ := (polynomialRootCount_multiplicative f).map_one
  simp only [hρ, Nat.cast_one, div_one, Real.one_rpow, one_mul] at hh
  exact lt_of_lt_of_le zero_lt_one hh

lemma polynomialWeightedDivisorSum_rpow_error_tendsto_zero
    (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (t : ℝ) (ht : 0 < t) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N / N -
      ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t)) atTop (𝓝 0) := by
  have hposN : ∀ᶠ n : ℕ in atTop, 1 ≤ f.eval (n:ℤ) :=
    tendsto_natCast_atTop_atTop.eventually hpos
  obtain ⟨K, hK⟩ := eventually_atTop.mp hposN
  obtain ⟨B, hB, hb⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  have hb' : ∀ N : ℕ, (∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)) ≤
      (B+K)*N := by
    intro N
    have hc : (∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)) =
        (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) + (N:ℝ)*K := by
      simp only [Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc,
        Nat.add_sub_cancel, nsmul_eq_mul]
    rw [hc]
    have hh := hb N
    change (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) ≤ B*N at hh
    nlinarith
  have hw : ∀ d : ℕ, 0 ≤ (d:ℝ)^(-t) := fun d ↦ Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hwlim : Tendsto (fun d : ℕ ↦ (d:ℝ)^(-t)) atTop (𝓝 0) :=
    (tendsto_rpow_neg_atTop ht).comp tendsto_natCast_atTop_atTop
  have hsmall := weighted_mean_tendsto_zero_of_bounded_mean
    (fun d ↦ (polynomialRootCount f d:ℝ)+K) (fun d ↦ (d:ℝ)^(-t))
    (fun d ↦ by positivity) hw (B+K) (by positivity) hb' hwlim
  have htail : Tendsto (fun N : ℕ ↦ (N:ℝ)^(-t)*Erdos975Sum f N/(N:ℝ)) atTop (𝓝 0) := by
    apply ((erdos975Sum_div_rpow_tendsto_zero f t ht).comp tendsto_natCast_atTop_atTop).congr'
    filter_upwards [eventually_ge_atTop (1:ℕ)] with N hN
    have hNp : (0:ℝ) < N := by exact_mod_cast hN
    dsimp only [Function.comp_def]
    rw [Real.rpow_add hNp, Real.rpow_one, Real.rpow_neg hNp.le]
    field_simp
  have htotal := hsmall.add htail
  rw [zero_add] at htotal
  apply squeeze_zero_norm' _ htotal
  filter_upwards [eventually_ge_atTop (1:ℕ)] with N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  have he := polynomialWeightedDivisorSum_error f K hK (fun d ↦ (d:ℝ)^(-t)) hw N N
    (fun d hd ↦ Real.rpow_le_rpow_of_exponent_nonpos hNp (by exact_mod_cast hd.le) (by linarith))
  rw [Real.norm_eq_abs]
  have heq : polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N / (N:ℝ) -
      ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t) =
      (polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N -
        (N:ℝ)*∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t))/(N:ℝ) := by
    field_simp
  rw [heq, abs_div, abs_of_pos hNp]
  simpa only [add_div] using div_le_div_of_nonneg_right he hNp.le

/-- For every fixed positive exponent, the weighted divisor average has a positive limit. -/
lemma polynomialWeightedDivisorSum_rpow_limit
    (f : ℤ[X]) (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (t : ℝ) (ht : 0 < t) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N / N)
      atTop (𝓝 (polynomialRootWeightedMean f t)) := by
  have hm := tendsto_sum_Icc_of_summable _
    (polynomialRootCount_rpow_summable f hdeg hirr t ht) (by simp)
  have he := polynomialWeightedDivisorSum_rpow_error_tendsto_zero f hdeg hirr hpos t ht
  have hh := he.add hm
  simpa only [sub_add_cancel, zero_add, polynomialRootWeightedMean] using hh

lemma polynomialRootWeightedMean_eq_LSeries (f : ℤ[X]) (t : ℝ) :
    (polynomialRootWeightedMean f t:ℂ) =
      LSeries (fun d : ℕ ↦ ((polynomialRootCount f d:ℝ):ℂ)) ((1+t:ℝ):ℂ) := by
  unfold polynomialRootWeightedMean LSeries
  rw [Complex.ofReal_tsum]
  apply tsum_congr
  intro d
  rw [LSeries.term_def₀ (by simp)]
  by_cases hd : d = 0
  · simp [hd]
  · have hdp : (0:ℝ) < d := by exact_mod_cast Nat.pos_of_ne_zero hd
    have he : (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t) =
        (polynomialRootCount f d:ℝ)*(d:ℝ)^(-(1+t)) := by
      rw [neg_add, Real.rpow_add hdp, Real.rpow_neg_one]
      ring
    rw [he, Complex.ofReal_mul, Complex.ofReal_cpow hdp.le]
    simp only [Complex.ofReal_neg, Complex.ofReal_natCast]

lemma polynomialRootWeightedMean_residue (f : ℤ[X]) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ)) :
    Tendsto (fun t : ℝ ↦ t*polynomialRootWeightedMean f t) (𝓝[>] 0) (𝓝 κ) := by
  have hL := LSeries_tendsto_sub_mul_nhds_one_of_tendsto_sum_div_and_nonneg
    (fun d : ℕ ↦ (polynomialRootCount f d:ℝ)) hmean (fun d ↦ Nat.cast_nonneg _)
  have hshift : Tendsto (fun t : ℝ ↦ 1+t) (𝓝[>] 0) (𝓝[>] 1) := by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have hi : Tendsto (fun t : ℝ ↦ t) (𝓝[>] 0) (𝓝 0) :=
        tendsto_id.mono_right nhdsWithin_le_nhds
      simpa only [add_zero] using hi.const_add 1
    · filter_upwards [self_mem_nhdsWithin] with t ht
      change 1 < 1+t
      change 0 < t at ht
      linarith
  have hR := Complex.continuous_re.continuousAt.tendsto.comp (hL.comp hshift)
  simp only [Complex.ofReal_re] at hR
  apply hR.congr
  intro t
  dsimp only [Function.comp_def]
  rw [← polynomialRootWeightedMean_eq_LSeries]
  simp only [Complex.ofReal_add, Complex.ofReal_one, add_sub_cancel_left,
    ← Complex.ofReal_mul, Complex.ofReal_re]

lemma polynomialWeightedDivisorSum_nonneg (f : ℤ[X]) (w : ℕ → ℝ)
    (hw : ∀ d, 0 ≤ w d) (N : ℕ) : 0 ≤ polynomialWeightedDivisorSum f w N :=
  Finset.sum_nonneg (fun _ _ ↦ Finset.sum_nonneg (fun d _ ↦ hw d))

lemma polynomialWeightedDivisorSum_rpow_le (f : ℤ[X]) (t : ℝ) (ht : 0 ≤ t) (N : ℕ) :
    polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N ≤ Erdos975Sum f N := by
  unfold polynomialWeightedDivisorSum
  calc
    _ ≤ ∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) := by
      apply Finset.sum_le_sum
      intro n hn
      calc
        _ ≤ ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors, (1:ℝ) := by
          apply Finset.sum_le_sum
          intro d hd
          exact Real.rpow_le_one_of_one_le_of_nonpos
            (by exact_mod_cast Nat.pos_of_mem_divisors hd) (by linarith)
        _ = _ := by simp [ArithmeticFunction.sigma_zero_apply]
    _ ≤ Erdos975Sum f N := by
      simp only [Erdos975Sum, Nat.floor_natCast]
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro n hn
        exact Finset.mem_Iic.mpr (Nat.le_of_lt (Finset.mem_range.mp hn))
      · exact fun _ _ _ ↦ Nat.cast_nonneg _

lemma polynomialWeightedDivisorSum_diagonal_tendsto_zero (f : ℤ[X]) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorSum f
      (fun d ↦ (d:ℝ)^(-(1/(N:ℝ)))) N / (N:ℝ)^2) atTop (𝓝 0) := by
  have hs := (erdos975Sum_div_rpow_tendsto_zero f 1 (by norm_num)).comp
    (tendsto_natCast_atTop_atTop (R := ℝ))
  simp only [Function.comp_def, one_add_one_eq_two, Real.rpow_two] at hs
  apply squeeze_zero' _ _ hs
  · exact Eventually.of_forall (fun N ↦ div_nonneg
      (polynomialWeightedDivisorSum_nonneg f _ (fun d ↦ by positivity) N) (sq_nonneg _))
  · exact Eventually.of_forall (fun N ↦ div_le_div_of_nonneg_right
      (polynomialWeightedDivisorSum_rpow_le f (1/(N:ℝ)) (by positivity) N) (sq_nonneg _))

lemma polynomialRootWeightedMean_reciprocal_limit (f : ℤ[X]) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ)) :
    Tendsto (fun N : ℕ ↦ polynomialRootWeightedMean f (1/(N:ℝ))/(N:ℝ)) atTop (𝓝 κ) := by
  have hinv : Tendsto (fun N : ℕ ↦ 1/(N:ℝ)) atTop (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨tendsto_const_div_atTop_nhds_zero_nat 1, ?_⟩
    filter_upwards [eventually_ge_atTop (1:ℕ)] with N hN
    change 0 < 1/(N:ℝ)
    exact one_div_pos.mpr (by exact_mod_cast (show 0 < N by omega))
  apply ((polynomialRootWeightedMean_residue f κ hmean).comp hinv).congr
  intro N
  dsimp only [Function.comp_def]
  ring

/-- The fixed-positive-exponent asymptotic is not uniform down to exponent `1/N`.
The discrepancy along this diagonal is of order `N`, after the usual mean normalization. -/
lemma polynomialWeightedDivisorSum_diagonal_error_limit (f : ℤ[X]) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ)) :
    Tendsto (fun N : ℕ ↦
      (polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-(1/(N:ℝ)))) N/(N:ℝ) -
        polynomialRootWeightedMean f (1/(N:ℝ)))/(N:ℝ)) atTop (𝓝 (-κ)) := by
  have ht := (polynomialWeightedDivisorSum_diagonal_tendsto_zero f).sub
    (polynomialRootWeightedMean_reciprocal_limit f κ hmean)
  rw [zero_sub] at ht
  apply ht.congr
  intro N
  ring


lemma sum_range_succ_eq_sum_Icc_of_zero (u : ℕ → ℝ) (hu0 : u 0 = 0) (N : ℕ) :
    (∑ d ∈ Finset.range (N+1), u d) = ∑ d ∈ Finset.Icc 1 N, u d := by
  rw [Nat.range_succ_eq_Icc_zero, ← Finset.insert_Icc_add_one_left_eq_Icc (Nat.zero_le N),
    Finset.sum_insert (by simp), hu0, zero_add]
  rfl

lemma polynomialRootWeightedMean_tail_bounds (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℝ) (ht : 0 < t) (N : ℕ) (hN : 0 < N) :
    0 ≤ polynomialRootWeightedMean f t -
      ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t) ∧
    polynomialRootWeightedMean f t -
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t)) ≤
        (N:ℝ)^(-(t/2))*polynomialRootWeightedMean f (t/2) := by
  let a : ℝ → ℕ → ℝ := fun u d ↦ (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-u)
  have ha0 : ∀ u d, 0 ≤ a u d := fun _ _ ↦ by dsimp [a]; positivity
  have hs := polynomialRootCount_rpow_summable f hdeg hirr t ht
  have hs2 := polynomialRootCount_rpow_summable f hdeg hirr (t/2) (by linarith)
  change Summable (a t) at hs
  change Summable (a (t/2)) at hs2
  have hsum (u : ℝ) (hu : Summable (a u)) :
      polynomialRootWeightedMean f u - (∑ d ∈ Finset.Icc 1 N, a u d) =
        ∑' i : ℕ, a u (i+(N+1)) := by
    have hh := Summable.sum_add_tsum_nat_add (N+1) hu
    rw [sum_range_succ_eq_sum_Icc_of_zero (a u) (by simp [a])] at hh
    change _ = polynomialRootWeightedMean f u at hh
    linarith
  change 0 ≤ polynomialRootWeightedMean f t - (∑ d ∈ Finset.Icc 1 N, a t d) ∧
    polynomialRootWeightedMean f t - (∑ d ∈ Finset.Icc 1 N, a t d) ≤ _
  rw [hsum t hs]
  constructor
  · exact tsum_nonneg (fun i ↦ ha0 t _)
  · have htail2 : (∑' i : ℕ, a (t/2) (i+(N+1))) ≤ polynomialRootWeightedMean f (t/2) := by
      rw [← hsum (t/2) hs2]
      exact sub_le_self _ (Finset.sum_nonneg (fun d _ ↦ ha0 _ _))
    calc
      _ ≤ ∑' i : ℕ, (N:ℝ)^(-(t/2))*a (t/2) (i+(N+1)) := by
        apply Summable.tsum_le_tsum _ ((summable_nat_add_iff (N+1)).mpr hs)
          (((summable_nat_add_iff (N+1)).mpr hs2).mul_left _)
        intro i
        let d := i+(N+1)
        have hd : 0 < d := by dsimp [d]; omega
        have hdp : (0:ℝ) < d := by exact_mod_cast hd
        have hpow : (d:ℝ)^(-(t/2)) ≤ (N:ℝ)^(-(t/2)) :=
          Real.rpow_le_rpow_of_nonpos (by exact_mod_cast hN) (by exact_mod_cast (show N ≤ d by dsimp [d]; omega))
            (by linarith)
        have he : (d:ℝ)^(-t) = (d:ℝ)^(-(t/2))*(d:ℝ)^(-(t/2)) := by
          rw [← Real.rpow_add hdp]
          congr 1
          ring
        change a t d ≤ (N:ℝ)^(-(t/2))*a (t/2) d
        dsimp only [a]
        rw [he]
        have hc : 0 ≤ (polynomialRootCount f d:ℝ)/(d:ℝ)*(d:ℝ)^(-(t/2)) := by positivity
        nlinarith [mul_le_mul_of_nonneg_right hpow hc]
      _ = (N:ℝ)^(-(t/2))*(∑' i : ℕ, a (t/2) (i+(N+1))) := tsum_mul_left
      _ ≤ _ := mul_le_mul_of_nonneg_left htail2 (by positivity)

lemma moving_rpow_half_tendsto_zero (t : ℕ → ℝ)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop atTop) :
    Tendsto (fun N : ℕ ↦ (N:ℝ)^(-(t N/2))) atTop (𝓝 0) := by
  have hh := Real.tendsto_exp_neg_atTop_nhds_zero.comp (hz.const_mul_atTop (show 0 < (1/2:ℝ) by norm_num))
  apply hh.congr'
  filter_upwards [eventually_ge_atTop (1:ℕ)] with N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  dsimp only [Function.comp_def]
  rw [Real.rpow_def_of_pos hNp]
  congr 1
  ring

lemma polynomialRootWeightedMean_moving_tail_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (ht0 : Tendsto t atTop (𝓝 0))
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop atTop) :
    Tendsto (fun N : ℕ ↦ t N*(polynomialRootWeightedMean f (t N) -
      ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t N))) atTop (𝓝 0) := by
  have ht2 : Tendsto (fun N ↦ t N/2) atTop (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨by simpa using ht0.div_const 2, ?_⟩
    filter_upwards [ht] with N hN
    exact half_pos hN
  have hres := (polynomialRootWeightedMean_residue f κ hmean).comp ht2
  have hbound := ((moving_rpow_half_tendsto_zero t hz).mul hres).const_mul 2
  simp only [zero_mul, mul_zero] at hbound
  apply squeeze_zero' _ _ hbound
  · filter_upwards [ht, eventually_ge_atTop (1:ℕ)] with N htN hN
    exact mul_nonneg htN.le (polynomialRootWeightedMean_tail_bounds f hdeg hirr (t N) htN N hN).1
  · filter_upwards [ht, eventually_ge_atTop (1:ℕ)] with N htN hN
    have hh := mul_le_mul_of_nonneg_left
      (polynomialRootWeightedMean_tail_bounds f hdeg hirr (t N) htN N hN).2 htN.le
    dsimp only [Function.comp_def]
    nlinarith

lemma polynomialRootWeightedMean_moving_trunc_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (ht0 : Tendsto t atTop (𝓝 0))
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop atTop) :
    Tendsto (fun N : ℕ ↦ t N*∑ d ∈ Finset.Icc 1 N,
      (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t N)) atTop (𝓝 κ) := by
  have ht' : Tendsto t atTop (𝓝[>] 0) := tendsto_nhdsWithin_iff.mpr ⟨ht0, ht⟩
  have hfull := (polynomialRootWeightedMean_residue f κ hmean).comp ht'
  have hh := hfull.sub (polynomialRootWeightedMean_moving_tail_limit f hdeg hirr κ hmean t ht ht0 hz)
  rw [sub_zero] at hh
  apply hh.congr
  intro N
  dsimp only [Function.comp_def]
  ring

lemma polynomialWeightedDivisorSum_uniform_rpow_error (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ C ≥ (0:ℝ), ∀ N : ℕ, 0 < N → ∀ t : ℝ, 0 ≤ t →
      |t*polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N/N -
        t*∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t)| ≤
          C*t + t*(N:ℝ)^(-t)*Erdos975Sum f N/N := by
  have hposN : ∀ᶠ n : ℕ in atTop, 1 ≤ f.eval (n:ℤ) :=
    tendsto_natCast_atTop_atTop.eventually hpos
  obtain ⟨K, hK⟩ := eventually_atTop.mp hposN
  obtain ⟨B, hB, hb⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  refine ⟨B+K, by positivity, ?_⟩
  intro N hN t ht
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  have herr := polynomialWeightedDivisorSum_error f K hK (fun d ↦ (d:ℝ)^(-t))
    (fun d ↦ by positivity) N N
    (fun d hd ↦ Real.rpow_le_rpow_of_nonpos hNp (by exact_mod_cast hd.le) (by linarith))
  have hsmall : (∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*(d:ℝ)^(-t)) ≤
      (B+K)*N := by
    calc
      _ ≤ ∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*1 := by
        apply Finset.sum_le_sum
        intro d hd
        exact mul_le_mul_of_nonneg_left (Real.rpow_le_one_of_one_le_of_nonpos
          (by exact_mod_cast (Finset.mem_Icc.mp hd).1) (by linarith)) (by positivity)
      _ = (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) + (N:ℝ)*K := by
        simp only [mul_one, Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc,
          Nat.add_sub_cancel, nsmul_eq_mul]
      _ ≤ _ := by
        have hh := hb N
        change (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) ≤ B*N at hh
        nlinarith
  have heq : t*polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N/(N:ℝ) -
      t*(∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t)) =
      t*(polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N -
        (N:ℝ)*∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t))/(N:ℝ) := by
    field_simp
  rw [heq, abs_div, abs_mul, abs_of_nonneg ht, abs_of_pos hNp]
  calc
    _ ≤ t*((∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*(d:ℝ)^(-t)) +
        (N:ℝ)^(-t)*Erdos975Sum f N)/(N:ℝ) :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left herr ht) hNp.le
    _ ≤ t*((B+K)*N + (N:ℝ)^(-t)*Erdos975Sum f N)/(N:ℝ) := by
      gcongr
    _ = _ := by field_simp <;> ring

lemma polynomialWeightedDivisorSum_moving_error_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 ≤ t N) (ht0 : Tendsto t atTop (𝓝 0))
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop atTop) :
    Tendsto (fun N : ℕ ↦ t N*polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N/N -
      t N*∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t N)) atTop (𝓝 0) := by
  obtain ⟨C, hC, hc⟩ := polynomialWeightedDivisorSum_uniform_rpow_error f hdeg hirr hpos
  obtain ⟨B, hB, hb⟩ := erdos975_eventual_log_upper_bound f hdeg hirr
  have hbN : ∀ᶠ N : ℕ in atTop, Erdos975Sum f N ≤ B*((N:ℝ)*log N) :=
    tendsto_natCast_atTop_atTop.eventually hb
  have hexp := (Real.tendsto_pow_mul_exp_neg_atTop_nhds_zero 1).comp hz
  simp only [pow_one] at hexp
  have hlim := (ht0.const_mul C).add (hexp.const_mul B)
  simp only [mul_zero, zero_add] at hlim
  apply squeeze_zero_norm' _ hlim
  filter_upwards [ht, hbN, eventually_ge_atTop (1:ℕ)] with N htN hbN hN
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  rw [Real.norm_eq_abs]
  refine (hc N hN (t N) htN).trans ?_
  dsimp only [Function.comp_def]
  apply add_le_add le_rfl
  calc
    t N*(N:ℝ)^(-t N)*Erdos975Sum f N/(N:ℝ) ≤
        t N*(N:ℝ)^(-t N)*(B*((N:ℝ)*log N))/(N:ℝ) := by
      apply div_le_div_of_nonneg_right _ hNp.le
      exact mul_le_mul_of_nonneg_left hbN (mul_nonneg htN (by positivity))
    _ = B*(t N*log (N:ℝ)*Real.exp (-(t N*log (N:ℝ)))) := by
      rw [Real.rpow_def_of_pos hNp]
      have he : log (N:ℝ)*(-t N) = -(t N*log (N:ℝ)) := by ring
      rw [he]
      field_simp

lemma polynomialWeightedDivisorSum_subcritical_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 ≤ t N)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 0)) :
    Tendsto (fun N : ℕ ↦ t N*polynomialWeightedDivisorSum f
      (fun d ↦ (d:ℝ)^(-t N)) N/N) atTop (𝓝 0) := by
  obtain ⟨B, hB, hb⟩ := erdos975_eventual_log_upper_bound f hdeg hirr
  have hbN : ∀ᶠ N : ℕ in atTop, Erdos975Sum f N ≤ B*((N:ℝ)*log N) :=
    tendsto_natCast_atTop_atTop.eventually hb
  have hlim := hz.const_mul B
  rw [mul_zero] at hlim
  apply squeeze_zero' _ _ hlim
  · filter_upwards [ht] with N htN
    exact div_nonneg (mul_nonneg htN
      (polynomialWeightedDivisorSum_nonneg f _ (fun d ↦ by positivity) N)) (Nat.cast_nonneg _)
  · filter_upwards [ht, hbN, eventually_ge_atTop (1:ℕ)] with N htN hbN hN
    have hNp : (0:ℝ) < N := by exact_mod_cast hN
    calc
      _ ≤ t N*Erdos975Sum f N/(N:ℝ) := div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left (polynomialWeightedDivisorSum_rpow_le f _ htN N) htN) hNp.le
      _ ≤ t N*(B*((N:ℝ)*log N))/(N:ℝ) :=
        div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hbN htN) hNp.le
      _ = B*(t N*log (N:ℝ)) := by field_simp <;> ring

/-- The regularized mean has its root-density residue limit above the transition scale. -/
lemma polynomialWeightedDivisorSum_supercritical_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (ht0 : Tendsto t atTop (𝓝 0))
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop atTop) :
    Tendsto (fun N : ℕ ↦ t N*polynomialWeightedDivisorSum f
      (fun d ↦ (d:ℝ)^(-t N)) N/N) atTop (𝓝 κ) := by
  have he := polynomialWeightedDivisorSum_moving_error_limit f hdeg hirr hpos t
    (ht.mono (fun N hN ↦ hN.le)) ht0 hz
  have hm := polynomialRootWeightedMean_moving_trunc_limit f hdeg hirr κ hmean t ht ht0 hz
  have hh := he.add hm
  simpa only [sub_add_cancel, zero_add] using hh

lemma tendsto_weight_zero_of_log_product_zero (t : ℕ → ℝ)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 0)) :
    Tendsto t atTop (𝓝 0) := by
  have hlog : Tendsto (fun N : ℕ ↦ log (N:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  apply (hz.div_atTop hlog).congr'
  filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
  have hL : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  exact mul_div_cancel_right₀ (t N) hL

/-- Below the transition scale the regularized density approximation has a nonzero limiting error.
This is an obstruction to a uniform regularization argument, not a disproof of Erdős 975. -/
lemma polynomialWeightedDivisorSum_subcritical_error_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (κ : ℝ)
    (hmean : Tendsto (fun N : ℕ ↦
      (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ))/(N:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 0)) :
    Tendsto (fun N : ℕ ↦ t N*(polynomialWeightedDivisorSum f
      (fun d ↦ (d:ℝ)^(-t N)) N/N - polynomialRootWeightedMean f (t N))) atTop (𝓝 (-κ)) := by
  have ht0 := tendsto_weight_zero_of_log_product_zero t hz
  have ht' : Tendsto t atTop (𝓝[>] 0) := tendsto_nhdsWithin_iff.mpr ⟨ht0, ht⟩
  have hres := (polynomialRootWeightedMean_residue f κ hmean).comp ht'
  have hw := polynomialWeightedDivisorSum_subcritical_limit f hdeg hirr t
    (ht.mono (fun N hN ↦ hN.le)) hz
  have hh := hw.sub hres
  rw [zero_sub] at hh
  apply hh.congr
  intro N
  dsimp only [Function.comp_def]
  ring

/-- A positive residue exists for each polynomial in the conjecture, and every sequence of
exponents tending to zero above the logarithmic transition has that same normalized limit. -/
lemma polynomialWeightedDivisorSum_supercritical_positive_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ κ > (0:ℝ), ∀ t : ℕ → ℝ,
      (∀ᶠ N in atTop, 0 < t N) → Tendsto t atTop (𝓝 0) →
      Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop atTop →
      Tendsto (fun N : ℕ ↦ t N*polynomialWeightedDivisorSum f
        (fun d ↦ (d:ℝ)^(-t N)) N/N) atTop (𝓝 κ) := by
  obtain ⟨κ, hκ, hmean⟩ := polynomialRootCount_positive_mean_limit f hdeg hirr
  refine ⟨κ, hκ, ?_⟩
  intro t ht ht0 hz
  exact polynomialWeightedDivisorSum_supercritical_limit f hdeg hirr hpos κ hmean t ht ht0 hz

lemma one_sub_rpow_neg_le_log (x t : ℝ) (hx : 0 < x) :
    1-x^(-t) ≤ t*log x := by
  rw [Real.rpow_def_of_pos hx]
  have hh := Real.add_one_le_exp (log x*(-t))
  nlinarith

lemma polynomialWeightedDivisorSum_gap_bound (f : ℤ[X]) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ N : ℕ, 0 < N → ∀ t : ℝ, 0 ≤ t →
      0 ≤ Erdos975Sum f N-polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N ∧
      Erdos975Sum f N-polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N ≤
        (σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ) +
          (t*log A + (f.natDegree:ℝ)*(t*log (N:ℝ)))*Erdos975Sum f N := by
  obtain ⟨A, hA, hb⟩ := polynomial_floor_eval_power_bound f
  refine ⟨A, hA, ?_⟩
  intro N hN t ht
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  have hAp : 0 < A := zero_lt_one.trans_le hA
  let L : ℝ := t*log A + (f.natDegree:ℝ)*(t*log (N:ℝ))
  have hL : 0 ≤ L := by
    dsimp [L]
    exact add_nonneg (mul_nonneg ht (Real.log_nonneg hA))
      (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg ht (Real.log_nonneg (by exact_mod_cast hN))))
  have he : Erdos975Sum f N =
      (∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) + (σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ) := by
    have hI : Finset.Iic N = Finset.range (N+1) := by ext n; simp
    rw [Erdos975Sum, Nat.floor_natCast, hI]
    exact Finset.sum_range_succ _ _
  constructor
  · exact sub_nonneg.mpr (polynomialWeightedDivisorSum_rpow_le f t ht N)
  · have hlocal : ∀ n ∈ Finset.range N,
        (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) - (∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors, (d:ℝ)^(-t)) ≤
          L*(σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) := by
      intro n hn
      have hnN : n+1 ≤ N := Finset.mem_range.mp hn
      have hcount : (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) = ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors, (1:ℝ) := by
        simp [ArithmeticFunction.sigma_zero_apply]
      rw [hcount, ← Finset.sum_sub_distrib, Finset.mul_sum]
      apply Finset.sum_le_sum
      intro d hd
      have hdp : (0:ℝ) < d := by exact_mod_cast Nat.pos_of_mem_divisors hd
      have hdm : (d:ℝ) ≤ (⌊f.eval (n:ℤ)⌋₊:ℝ) := by
        exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hd))
          (Nat.dvd_of_mem_divisors hd)
      have hdA : (d:ℝ) ≤ A*(N:ℝ)^f.natDegree := hdm.trans ((hb n).trans
        (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) (by exact_mod_cast hnN) _) hAp.le))
      have hlog := Real.log_le_log hdp hdA
      rw [Real.log_mul hAp.ne' (pow_ne_zero _ hNp.ne'), Real.log_pow] at hlog
      have hh := mul_le_mul_of_nonneg_left hlog ht
      have hgap := one_sub_rpow_neg_le_log (d:ℝ) t hdp
      dsimp only [L]
      nlinarith
    have hsum : (∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) -
        polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N ≤
        L*(∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) := by
      unfold polynomialWeightedDivisorSum
      rw [← Finset.sum_sub_distrib, Finset.mul_sum]
      exact Finset.sum_le_sum hlocal
    have hτ : 0 ≤ (σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ) := Nat.cast_nonneg _
    change _ ≤ (σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ)+L*Erdos975Sum f N
    rw [he]
    nlinarith

lemma polynomial_sigma_div_mul_log_tendsto_zero (f : ℤ[X]) :
    Tendsto (fun N : ℕ ↦ (σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ)/((N:ℝ)*log N)) atTop (𝓝 0) := by
  obtain ⟨C, hC, hb⟩ := sigma_zero_polynomial_subpolynomial_bound f (1/2) (by norm_num)
  have hlim := ((tendsto_rpow_neg_atTop (show 0 < (1/2:ℝ) by norm_num)).comp
    tendsto_natCast_atTop_atTop).const_mul (C*(2:ℝ)^(1/2:ℝ))
  rw [mul_zero] at hlim
  have hlog : ∀ᶠ N : ℕ in atTop, 1 ≤ log (N:ℝ) :=
    (Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))).eventually_ge_atTop 1
  apply squeeze_zero' _ _ hlim
  · filter_upwards [hlog] with N hN
    exact div_nonneg (Nat.cast_nonneg _) (mul_nonneg (Nat.cast_nonneg _) (by linarith))
  · filter_upwards [hlog, eventually_ge_atTop (1:ℕ)] with N hlogN hN
    have hNp : (0:ℝ) < N := by exact_mod_cast hN
    have hN1 : (1:ℝ) ≤ N := by exact_mod_cast hN
    calc
      _ ≤ (σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ)/(N:ℝ) := by
        apply div_le_div_of_nonneg_left (Nat.cast_nonneg _) hNp
        nlinarith
      _ ≤ C*(N+1:ℝ)^(1/2:ℝ)/(N:ℝ) := div_le_div_of_nonneg_right (hb N) hNp.le
      _ ≤ C*(2*(N:ℝ))^(1/2:ℝ)/(N:ℝ) := by
        apply div_le_div_of_nonneg_right _ hNp.le
        apply mul_le_mul_of_nonneg_left _ hC.le
        exact Real.rpow_le_rpow (by positivity) (by nlinarith) (by norm_num)
      _ = C*(2:ℝ)^(1/2:ℝ)*(N:ℝ)^(-(1/2:ℝ)) := by
        rw [Real.mul_rpow (by norm_num) hNp.le, mul_assoc, mul_div_assoc]
        have hp : (N:ℝ)^(1/2:ℝ)/(N:ℝ) = (N:ℝ)^(-(1/2:ℝ)) := by
          have hh := (Real.rpow_sub hNp (1/2:ℝ) 1).symm
          norm_num at hh ⊢
          exact hh
        rw [mul_div_assoc, hp]

/-- Weights below the logarithmic transition are uniformly close to the ordinary divisor sum
on the conjecture's normalization. This does not prove either sum converges. -/
lemma polynomialWeightedDivisorSum_subcritical_approximation (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 ≤ t N)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 0)) :
    Tendsto (fun N : ℕ ↦ (Erdos975Sum f N -
      polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N)/((N:ℝ)*log N)) atTop (𝓝 0) := by
  obtain ⟨A, hA, hb⟩ := polynomialWeightedDivisorSum_gap_bound f
  obtain ⟨C, hC, hupper⟩ := erdos975_eventual_log_upper_bound f hdeg hirr
  have hupperN : ∀ᶠ N : ℕ in atTop, Erdos975Sum f N ≤ C*((N:ℝ)*log N) :=
    tendsto_natCast_atTop_atTop.eventually hupper
  have ht0 := tendsto_weight_zero_of_log_product_zero t hz
  have hL := (ht0.mul_const (log A)).add (hz.const_mul (f.natDegree:ℝ))
  simp only [zero_mul, mul_zero, zero_add] at hL
  have hlim := (polynomial_sigma_div_mul_log_tendsto_zero f).add (hL.const_mul C)
  simp only [mul_zero, zero_add] at hlim
  apply squeeze_zero' _ _ hlim
  · filter_upwards [ht, eventually_gt_atTop (1:ℕ)] with N htN hN
    exact div_nonneg (hb N (by omega) (t N) htN).1
      (mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg (by exact_mod_cast hN.le)))
  · filter_upwards [ht, hupperN, eventually_gt_atTop (1:ℕ)] with N htN hupperN hN
    have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
    have hlog : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
    have hden : 0 < (N:ℝ)*log N := mul_pos hNp hlog
    have hLp : 0 ≤ t N*log A+(f.natDegree:ℝ)*(t N*log (N:ℝ)) :=
      add_nonneg (mul_nonneg htN (Real.log_nonneg hA))
        (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg htN hlog.le))
    have hg := (hb N (by omega) (t N) htN).2
    calc
      _ ≤ ((σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ)+
          (t N*log A+(f.natDegree:ℝ)*(t N*log (N:ℝ)))*Erdos975Sum f N)/((N:ℝ)*log N) :=
        div_le_div_of_nonneg_right hg hden.le
      _ ≤ ((σ 0 ⌊f.eval (N:ℤ)⌋₊:ℝ)+
          (t N*log A+(f.natDegree:ℝ)*(t N*log (N:ℝ)))*(C*((N:ℝ)*log N)))/((N:ℝ)*log N) := by
        apply div_le_div_of_nonneg_right _ hden.le
        exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hupperN hLp)
      _ = _ := by field_simp <;> ring


/- Critical logarithmic weights: only the truncated contribution has a proved limit. -/

lemma weighted_sum_partial_summation (a w : ℕ → ℝ) (N : ℕ) :
    (∑ d ∈ Finset.Icc 1 N, a d*w d) =
      (∑ d ∈ Finset.Icc 1 N, a d)*w (N+1) +
        ∑ k ∈ Finset.range N, (∑ d ∈ Finset.Icc 1 (k+1), a d)*(w (k+1)-w (k+2)) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih, Finset.sum_range_succ,
      Finset.sum_Icc_succ_top (by omega)]
    ring

lemma weighted_sum_abs_le_of_partial_sum_bound (a w : ℕ → ℝ) (B ε : ℝ)
    (_hB : 0 ≤ B) (hw : ∀ d, 0 ≤ w d)
    (hm : AntitoneOn w (Set.Ici 1))
    (ha : ∀ D : ℕ, |∑ d ∈ Finset.Icc 1 D, a d| ≤ B + ε*D) (N : ℕ) :
    |∑ d ∈ Finset.Icc 1 N, a d*w d| ≤ B*w 1 + ε*∑ d ∈ Finset.Icc 1 N, w d := by
  have ht : w (N+1) + (∑ k ∈ Finset.range N, (w (k+1)-w (k+2))) = w 1 := by
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Finset.sum_range_succ]
      linear_combination ih
  have ht2 := weighted_sum_partial_summation (fun _ ↦ (1:ℝ)) w N
  simp only [one_mul, Finset.sum_const, Nat.card_Icc, Nat.add_sub_cancel,
    nsmul_eq_mul, mul_one, Nat.cast_add, Nat.cast_one] at ht2
  rw [weighted_sum_partial_summation]
  calc
    _ ≤ |(∑ d ∈ Finset.Icc 1 N, a d)*w (N+1)| +
        ∑ k ∈ Finset.range N, |(∑ d ∈ Finset.Icc 1 (k+1), a d)*(w (k+1)-w (k+2))| :=
      (abs_add_le _ _).trans (add_le_add le_rfl (Finset.abs_sum_le_sum_abs _ _))
    _ ≤ (B+ε*N)*w (N+1) +
        ∑ k ∈ Finset.range N, (B+ε*(k+1))*(w (k+1)-w (k+2)) := by
      apply add_le_add
      · rw [abs_mul, abs_of_nonneg (hw _)]
        exact mul_le_mul_of_nonneg_right (ha N) (hw _)
      · apply Finset.sum_le_sum
        intro k hk
        have hdiff : 0 ≤ w (k+1)-w (k+2) := sub_nonneg.mpr (hm (by simp) (by simp) (by omega))
        rw [abs_mul, abs_of_nonneg hdiff]
        exact mul_le_mul_of_nonneg_right (by simpa using ha (k+1)) hdiff
    _ = B*w 1 + ε*∑ d ∈ Finset.Icc 1 N, w d := by
      rw [ht2, ← ht]
      simp only [add_mul, mul_assoc, Finset.sum_add_distrib, ← Finset.mul_sum]
      ring

lemma partial_sum_affine_bound_of_mean (a : ℕ → ℝ) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)) atTop (𝓝 κ))
    (ε : ℝ) (hε : 0 < ε) :
    ∃ B ≥ (0:ℝ), ∀ D : ℕ, |∑ d ∈ Finset.Icc 1 D, (a d-κ)| ≤ B+ε*D := by
  obtain ⟨K, hK⟩ := Metric.tendsto_atTop.mp hmean ε hε
  let B := ∑ D ∈ Finset.range K, |∑ d ∈ Finset.Icc 1 D, (a d-κ)|
  have hB : 0 ≤ B := Finset.sum_nonneg (fun _ _ ↦ abs_nonneg _)
  refine ⟨B, hB, fun D ↦ ?_⟩
  by_cases hD : D < K
  · have hh : |∑ d ∈ Finset.Icc 1 D, (a d-κ)| ≤ B := by
      apply Finset.single_le_sum (fun d _ ↦ abs_nonneg _) (Finset.mem_range.mpr hD)
    exact hh.trans (le_add_of_nonneg_right (mul_nonneg hε.le (Nat.cast_nonneg _)))
  · by_cases hD0 : D = 0
    · simp [hD0, hB]
    have hDp : (0:ℝ) < D := by exact_mod_cast (Nat.pos_of_ne_zero hD0)
    have hh : |(∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)-κ| < ε := by
      simpa only [Real.dist_eq] using hK D (by omega)
    have heq : (∑ d ∈ Finset.Icc 1 D, (a d-κ)) =
        ((∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)-κ)*(D:ℝ) := by
      simp only [Finset.sum_sub_distrib, Finset.sum_const, Nat.card_Icc,
        Nat.add_sub_cancel, nsmul_eq_mul]
      field_simp
    rw [heq, abs_mul, abs_of_pos hDp]
    exact (mul_le_mul_of_nonneg_right hh.le hDp.le).trans (le_add_of_nonneg_left hB)

lemma rpow_sum_le_harmonic (N : ℕ) (t : ℝ) (ht : 0 ≤ t) :
    (∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t))) ≤ (harmonic N:ℝ) := by
  simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
  apply Finset.sum_le_sum
  intro d hd
  rw [← Real.rpow_neg_one]
  exact Real.rpow_le_rpow_of_exponent_le
    (by exact_mod_cast (Finset.mem_Icc.mp hd).1) (by linarith)

lemma moving_rpow_sum_error_of_mean (a : ℕ → ℝ) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 ≤ t N) :
    Tendsto (fun N : ℕ ↦ ((∑ d ∈ Finset.Icc 1 N, a d*(d:ℝ)^(-(1+t N))) -
      κ*∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N)))/log N) atTop (𝓝 0) := by
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  obtain ⟨B, hB, hb⟩ := partial_sum_affine_bound_of_mean a κ hmean (ε/4) (by linarith)
  have hBlog : Tendsto (fun N : ℕ ↦ B/log (N:ℝ)) atTop (𝓝 0) :=
    (Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))).const_div_atTop B
  filter_upwards [ht, hBlog.eventually_lt_const (show 0 < ε/2 by linarith),
    tendsto_harmonic_div_log.eventually_lt_const (show (1:ℝ) < 2 by norm_num),
    eventually_gt_atTop (1:ℕ)] with N htN hBN hHN hN
  have hlog : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
  have hw : ∀ d : ℕ, 0 ≤ (d:ℝ)^(-(1+t N)) := fun _ ↦ by positivity
  have hm : AntitoneOn (fun d : ℕ ↦ (d:ℝ)^(-(1+t N))) (Set.Ici 1) := by
    intro d hd e he hde
    exact Real.rpow_le_rpow_of_nonpos (by exact_mod_cast hd) (by exact_mod_cast hde) (by linarith)
  have hh := weighted_sum_abs_le_of_partial_sum_bound (fun d ↦ a d-κ)
    (fun d : ℕ ↦ (d:ℝ)^(-(1+t N))) B (ε/4) hB hw hm hb N
  simp only [Nat.cast_one, Real.one_rpow, mul_one] at hh
  have heq : (∑ d ∈ Finset.Icc 1 N, a d*(d:ℝ)^(-(1+t N))) -
      κ*∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N)) =
      ∑ d ∈ Finset.Icc 1 N, (a d-κ)*(d:ℝ)^(-(1+t N)) := by
    simp only [sub_mul, Finset.sum_sub_distrib, Finset.mul_sum]
  rw [Real.dist_eq, sub_zero, heq, abs_div, abs_of_pos hlog]
  calc
    _ ≤ (B+(ε/4)*∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N)))/log N :=
      div_le_div_of_nonneg_right hh hlog.le
    _ ≤ (B+(ε/4)*(harmonic N:ℝ))/log N := by
      apply div_le_div_of_nonneg_right _ hlog.le
      exact add_le_add le_rfl (mul_le_mul_of_nonneg_left (rpow_sum_le_harmonic N (t N) htN) (by linarith))
    _ = B/log N+(ε/4)*((harmonic N:ℝ)/log N) := by ring
    _ < ε := by nlinarith

lemma rpow_sum_integral_error (N : ℕ) (hN : 1 ≤ N) (t : ℝ) (ht : 0 < t) :
    |(∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t))) - (1-(N:ℝ)^(-t))/t| ≤ 1 := by
  have hNr : (1:ℝ) ≤ N := by exact_mod_cast hN
  have hm : AntitoneOn (fun x : ℝ ↦ x^(-(1+t))) (Set.Icc 1 (N:ℝ)) := by
    intro x hx y hy hxy
    exact Real.rpow_le_rpow_of_nonpos (by linarith [hx.1]) hxy (by linarith)
  have hlo := AntitoneOn.integral_le_sum_Ico (f := fun x : ℝ ↦ x^(-(1+t))) hN
    (by simpa only [Nat.cast_one] using hm)
  have hhi := AntitoneOn.sum_le_integral_Ico (f := fun x : ℝ ↦ x^(-(1+t))) hN
    (by simpa only [Nat.cast_one] using hm)
  simp only [Nat.cast_one] at hlo hhi
  have hint : (∫ x : ℝ in (1:ℝ)..(N:ℝ), x^(-(1+t))) = (1-(N:ℝ)^(-t))/t := by
    rw [integral_rpow (Or.inr ⟨by linarith, by rw [Set.uIcc_of_le hNr]; simp⟩)]
    have he : -(1+t)+1 = -t := by ring
    rw [he, Real.one_rpow]
    field_simp
    ring
  rw [hint] at hlo hhi
  rw [Finset.sum_Ico_add' (fun d : ℕ ↦ (d:ℝ)^(-(1+t))) 1 N 1,
    Finset.Ico_add_one_right_eq_Icc] at hhi
  have hsum : (∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t))) =
      (∑ d ∈ Finset.Ico 1 N, (d:ℝ)^(-(1+t))) + (N:ℝ)^(-(1+t)) := by
    rw [← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_succ_top hN]
  have hsum' : (∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t))) =
      1 + ∑ d ∈ Finset.Icc 2 N, (d:ℝ)^(-(1+t)) := by
    rw [← Finset.insert_Icc_add_one_left_eq_Icc hN, Finset.sum_insert (by simp)]
    simp
  have hnpos : 0 ≤ (N:ℝ)^(-(1+t)) := by positivity
  rw [abs_le]
  constructor <;> linarith

lemma moving_rpow_sum_critical_limit (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N)
    (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N)))/log N)
      atTop (𝓝 ((1-Real.exp (-z))/z)) := by
  have he := ((Real.continuous_exp.tendsto (-z)).comp hz.neg).const_sub 1
  have hmain := he.div hz hzpos.ne'
  have hlog := Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))
  have herr : Tendsto (fun N : ℕ ↦
      ((∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N))) - (1-(N:ℝ)^(-t N))/t N)/log N)
      atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ (hlog.const_div_atTop (1:ℝ))
    filter_upwards [ht, eventually_gt_atTop (1:ℕ)] with N htN hN
    have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hlogN]
    exact div_le_div_of_nonneg_right (rpow_sum_integral_error N hN.le (t N) htN) hlogN.le
  have hh := hmain.add herr
  rw [add_zero] at hh
  apply hh.congr'
  filter_upwards [ht, eventually_gt_atTop (1:ℕ)] with N htN hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlogN : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  dsimp only [Function.comp_def, Pi.div_apply]
  rw [Real.rpow_def_of_pos hNp]
  have heq : log (N:ℝ)*(-t N) = -(t N*log (N:ℝ)) := by ring
  rw [heq]
  field_simp
  <;> ring

lemma moving_weighted_rpow_sum_critical_limit (a : ℕ → ℝ) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N, a d*(d:ℝ)^(-(1+t N)))/log N)
      atTop (𝓝 (κ*((1-Real.exp (-z))/z))) := by
  have he := moving_rpow_sum_error_of_mean a κ hmean t (ht.mono (fun _ h ↦ h.le))
  have hu := (moving_rpow_sum_critical_limit t ht z hzpos hz).const_mul κ
  have hh := he.add hu
  rw [zero_add] at hh
  exact hh.congr (fun N ↦ by ring)

lemma polynomialWeightedDivisorTrunc_bounded_error_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (w : ℕ → ℕ → ℝ) (hw : ∀ᶠ N in atTop, ∀ d, 0 ≤ w N d)
    (hw1 : ∀ᶠ N in atTop, ∀ d : ℕ, 1 ≤ d → w N d ≤ 1) :
    Tendsto (fun N : ℕ ↦ (polynomialWeightedDivisorTrunc f (w N) N N -
      (N:ℝ)*∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*w N d)/
        ((N:ℝ)*log N)) atTop (𝓝 0) := by
  obtain ⟨K, hK⟩ := eventually_atTop.mp (tendsto_natCast_atTop_atTop.eventually hpos)
  obtain ⟨B, hB, hb⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  have hlim := (Real.tendsto_log_atTop.comp
    (tendsto_natCast_atTop_atTop (R := ℝ))).const_div_atTop (B+K)
  apply squeeze_zero_norm' _ hlim
  filter_upwards [hw, hw1, eventually_gt_atTop (1:ℕ)] with N hwN hw1N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
  have herr := polynomialWeightedDivisorTrunc_error f K hK (w N) hwN N N
  have he : (∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*w N d) ≤
      (B+K)*N := by
    calc
      _ ≤ ∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*1 := by
        apply Finset.sum_le_sum
        intro d hd
        exact mul_le_mul_of_nonneg_left (hw1N d (Finset.mem_Icc.mp hd).1) (by positivity)
      _ = (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) + (N:ℝ)*K := by
        simp only [mul_one, Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc,
          Nat.add_sub_cancel, nsmul_eq_mul]
      _ ≤ (B+K)*N := by
        have hh := hb N
        change (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) ≤ B*N at hh
        nlinarith
  rw [Real.norm_eq_abs, abs_div, abs_of_pos (mul_pos hNp hlogN)]
  calc
    _ ≤ ((B+K)*N)/((N:ℝ)*log N) := div_le_div_of_nonneg_right (herr.trans he) (by positivity)
    _ = (B+K)/log N := by field_simp

lemma polynomialWeightedDivisorTrunc_critical_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootCount f d:ℝ))/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorTrunc f
      (fun d ↦ (d:ℝ)^(-t N)) N N/((N:ℝ)*log N)) atTop (𝓝 (κ*((1-Real.exp (-z))/z))) := by
  have he := polynomialWeightedDivisorTrunc_bounded_error_limit f hdeg hirr hpos
    (fun N d ↦ (d:ℝ)^(-t N)) (Filter.Eventually.of_forall (fun _ _ ↦ by positivity))
    (ht.mono (fun N htN d hd ↦ Real.rpow_le_one_of_one_le_of_nonpos
      (by exact_mod_cast hd) (by linarith)))
  have hm := moving_weighted_rpow_sum_critical_limit
    (fun d ↦ (polynomialRootCount f d:ℝ)) κ hmean t ht z hzpos hz
  have hh := he.add hm
  rw [zero_add] at hh
  apply hh.congr'
  filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlogN : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  have heq : (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*(d:ℝ)^(-t N)) =
      ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)*(d:ℝ)^(-(1+t N)) := by
    apply Finset.sum_congr rfl
    intro d hd
    have hdp : (0:ℝ) < d := by exact_mod_cast (Finset.mem_Icc.mp hd).1
    rw [neg_add, Real.rpow_add hdp, Real.rpow_neg_one]
    ring
  rw [heq]
  field_simp
  <;> ring

/-- The root-density prediction is valid for the truncated divisor sum even at the critical
logarithmic weight scale. The contribution of divisors larger than `N` is not included. -/
lemma polynomialWeightedDivisorTrunc_logscale_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ κ > (0:ℝ), ∀ z > (0:ℝ),
      Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorTrunc f
        (fun d ↦ (d:ℝ)^(-(z/log (N:ℝ)))) N N/((N:ℝ)*log N))
        atTop (𝓝 (κ*((1-Real.exp (-z))/z))) := by
  obtain ⟨κ, hκ, hmean⟩ := polynomialRootCount_positive_mean_limit f hdeg hirr
  refine ⟨κ, hκ, fun z hz ↦ ?_⟩
  have ht : ∀ᶠ N : ℕ in atTop, 0 < z/log (N:ℝ) := by
    filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    exact div_pos hz (Real.log_pos (by exact_mod_cast hN))
  have hz' : Tendsto (fun N : ℕ ↦ z/log (N:ℝ)*log (N:ℝ)) atTop (𝓝 z) := by
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    have hlogN : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
    exact (div_mul_cancel₀ z hlogN).symm
  exact polynomialWeightedDivisorTrunc_critical_limit f hdeg hirr hpos κ hmean
    (fun N ↦ z/log (N:ℝ)) ht z hz hz'

lemma polynomialWeightedDivisorSum_critical_envelope (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootCount f d:ℝ))/(D:ℝ)) atTop (𝓝 κ))
    (C : ℝ) (hC : ∀ᶠ N : ℕ in atTop, Erdos975Sum f N ≤ C*((N:ℝ)*log N))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    ∀ ε > (0:ℝ), ∀ᶠ N : ℕ in atTop,
      κ*((1-Real.exp (-z))/z)-ε ≤ polynomialWeightedDivisorSum f
        (fun d ↦ (d:ℝ)^(-t N)) N/((N:ℝ)*log N) ∧
      polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N/((N:ℝ)*log N) ≤
        κ*((1-Real.exp (-z))/z)+C*Real.exp (-z)+ε := by
  have htrunc := polynomialWeightedDivisorTrunc_critical_limit f hdeg hirr hpos κ hmean t ht z hzpos hz
  have hpow : Tendsto (fun N : ℕ ↦ (N:ℝ)^(-t N)) atTop (𝓝 (Real.exp (-z))) := by
    apply ((Real.continuous_exp.tendsto (-z)).comp hz.neg).congr'
    filter_upwards [eventually_gt_atTop (0:ℕ)] with N hN
    rw [Real.rpow_def_of_pos (by exact_mod_cast hN)]
    dsimp only [Function.comp_def]
    congr 1
    ring
  have hupper := htrunc.add (hpow.const_mul C)
  intro ε hε
  filter_upwards [ht, hC,
    htrunc.eventually_const_lt (sub_lt_self _ hε),
    hupper.eventually_lt_const (lt_add_of_pos_right _ hε),
    eventually_gt_atTop (1:ℕ)] with N htN hCN hlo hhi hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hden : 0 < (N:ℝ)*log N := mul_pos hNp (Real.log_pos (by exact_mod_cast hN))
  obtain ⟨hsub0, hsub⟩ := polynomialWeightedDivisorSum_sub_trunc_bounds f
    (fun d ↦ (d:ℝ)^(-t N)) (fun _ ↦ by positivity) N N
    (fun d hd ↦ Real.rpow_le_rpow_of_nonpos hNp (by exact_mod_cast hd.le) (by linarith))
  constructor
  · exact hlo.le.trans (div_le_div_of_nonneg_right (by linarith :
      polynomialWeightedDivisorTrunc f (fun d ↦ (d:ℝ)^(-t N)) N N ≤
        polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N) hden.le)
  · refine (le_trans ?_ hhi.le)
    have hh := hsub.trans (mul_le_mul_of_nonneg_left hCN (by positivity : 0 ≤ (N:ℝ)^(-t N)))
    have he := div_le_div_of_nonneg_right hh hden.le
    have heq : ((N:ℝ)^(-t N)*(C*((N:ℝ)*log N)))/((N:ℝ)*log N) = C*(N:ℝ)^(-t N) := by
      rw [← mul_assoc, mul_div_cancel_right₀ _ hden.ne', mul_comm]
    rw [heq, sub_div] at he
    linarith


/- Complementary critical weights: the central divisor range is not estimated here. -/

lemma divisor_rpow_reflection (m : ℕ) (t : ℝ) :
    (∑ d ∈ m.divisors, (d:ℝ)^(-t)) =
      (m:ℝ)^(-t)*∑ d ∈ m.divisors, (d:ℝ)^t := by
  rw [← Nat.sum_div_divisors m (fun d ↦ (d:ℝ)^(-t)), Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro d hd
  have hdp : (0:ℝ) < d := by exact_mod_cast Nat.pos_of_mem_divisors hd
  rw [Nat.cast_div (Nat.dvd_of_mem_divisors hd) hdp.ne',
    Real.div_rpow (Nat.cast_nonneg _) (Nat.cast_nonneg _),
    Real.rpow_neg (Nat.cast_nonneg (α := ℝ) d), div_eq_mul_inv, inv_inv]

lemma divisor_rpow_trunc_reflection (m D : ℕ) (t : ℝ) :
    (∑ d ∈ m.divisors.filter (fun d ↦ m/d ≤ D), (d:ℝ)^(-t)) =
      (m:ℝ)^(-t)*∑ d ∈ m.divisors.filter (fun d ↦ d ≤ D), (d:ℝ)^t := by
  simp only [Finset.sum_filter, Finset.mul_sum]
  rw [← Nat.sum_div_divisors m (fun d ↦ if m/d ≤ D then (d:ℝ)^(-t) else 0)]
  apply Finset.sum_congr rfl
  intro d hd
  have hdp : (0:ℝ) < d := by exact_mod_cast Nat.pos_of_mem_divisors hd
  rw [Nat.div_div_self (Nat.dvd_of_mem_divisors hd) (Nat.ne_zero_of_mem_divisors hd)]
  split_ifs with hD
  · rw [Nat.cast_div (Nat.dvd_of_mem_divisors hd) hdp.ne',
      Real.div_rpow (Nat.cast_nonneg _) (Nat.cast_nonneg _),
      Real.rpow_neg (Nat.cast_nonneg (α := ℝ) d), div_eq_mul_inv, inv_inv]
  · simp

lemma polynomialWeightedDivisorSum_rpow_reflection (f : ℤ[X]) (N : ℕ) (t : ℝ) :
    polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N =
      ∑ n ∈ Finset.range N, (⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)*
        ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors, (d:ℝ)^t := by
  unfold polynomialWeightedDivisorSum
  exact Finset.sum_congr rfl (fun n _ ↦ divisor_rpow_reflection _ t)

lemma moving_monotone_weighted_sum_error_of_mean (a : ℕ → ℝ) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)) atTop (𝓝 κ))
    (w : ℕ → ℕ → ℝ)
    (hw : ∀ᶠ N in atTop, (∀ d, 0 ≤ w N d) ∧ AntitoneOn (w N) (Set.Ici 1) ∧
      (∀ d : ℕ, 1 ≤ d → d ≤ N → w N d ≤ (d:ℝ)⁻¹)) :
    Tendsto (fun N : ℕ ↦ ((∑ d ∈ Finset.Icc 1 N, a d*w N d) -
      κ*∑ d ∈ Finset.Icc 1 N, w N d)/log N) atTop (𝓝 0) := by
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  obtain ⟨B, hB, hb⟩ := partial_sum_affine_bound_of_mean a κ hmean (ε/4) (by linarith)
  have hBlog : Tendsto (fun N : ℕ ↦ B/log (N:ℝ)) atTop (𝓝 0) :=
    (Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))).const_div_atTop B
  filter_upwards [hw, hBlog.eventually_lt_const (show 0 < ε/2 by linarith),
    tendsto_harmonic_div_log.eventually_lt_const (show (1:ℝ) < 2 by norm_num),
    eventually_gt_atTop (1:ℕ)] with N hwN hBN hHN hN
  have hlog : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
  have hh := weighted_sum_abs_le_of_partial_sum_bound (fun d ↦ a d-κ) (w N)
    B (ε/4) hB hwN.1 hwN.2.1 hb N
  have hw1 : w N 1 ≤ 1 := by simpa using hwN.2.2 1 (by omega) hN.le
  have hsum : (∑ d ∈ Finset.Icc 1 N, w N d) ≤ (harmonic N:ℝ) := by
    simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
    exact Finset.sum_le_sum (fun d hd ↦ hwN.2.2 d (Finset.mem_Icc.mp hd).1 (Finset.mem_Icc.mp hd).2)
  have heq : (∑ d ∈ Finset.Icc 1 N, a d*w N d) - κ*∑ d ∈ Finset.Icc 1 N, w N d =
      ∑ d ∈ Finset.Icc 1 N, (a d-κ)*w N d := by
    simp only [sub_mul, Finset.sum_sub_distrib, Finset.mul_sum]
  rw [Real.dist_eq, sub_zero, heq, abs_div, abs_of_pos hlog]
  calc
    _ ≤ (B*w N 1+(ε/4)*∑ d ∈ Finset.Icc 1 N, w N d)/log N :=
      div_le_div_of_nonneg_right hh hlog.le
    _ ≤ (B+(ε/4)*(harmonic N:ℝ))/log N := by
      apply div_le_div_of_nonneg_right _ hlog.le
      exact add_le_add (by nlinarith) (mul_le_mul_of_nonneg_left hsum (by linarith))
    _ = B/log N+(ε/4)*((harmonic N:ℝ)/log N) := by ring
    _ < ε := by nlinarith

lemma reflected_rpow_weight_le_inv (N d : ℕ) (hd : 1 ≤ d) (hdN : d ≤ N)
    (t : ℝ) (ht : 0 ≤ t) :
    (N:ℝ)^(-t)*(d:ℝ)^(-(1-t)) ≤ (d:ℝ)⁻¹ := by
  have hdp : (0:ℝ) < d := by exact_mod_cast hd
  calc
    _ ≤ (d:ℝ)^(-t)*(d:ℝ)^(-(1-t)) :=
      mul_le_mul_of_nonneg_right (Real.rpow_le_rpow_of_nonpos hdp
        (by exact_mod_cast hdN) (by linarith)) (by positivity)
    _ = (d:ℝ)⁻¹ := by
      rw [← Real.rpow_add hdp]
      convert Real.rpow_neg_one (d:ℝ) using 1 <;> congr 1 <;> ring

lemma reflected_rpow_sum_integral_error (N : ℕ) (hN : 1 ≤ N) (t : ℝ)
    (ht : 0 < t) (ht1 : t ≤ 1) :
    |(∑ d ∈ Finset.Icc 1 N, (N:ℝ)^(-t)*(d:ℝ)^(-(1-t))) -
      (1-(N:ℝ)^(-t))/t| ≤ 1 := by
  have hNr : (1:ℝ) ≤ N := by exact_mod_cast hN
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  let w : ℝ → ℝ := fun x ↦ (N:ℝ)^(-t)*x^(-(1-t))
  have hm : AntitoneOn w (Set.Icc 1 (N:ℝ)) := by
    intro x hx y hy hxy
    exact mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow_of_nonpos (by linarith [hx.1]) hxy (by linarith)) (by positivity)
  have hlo := AntitoneOn.integral_le_sum_Ico (f := w) hN
    (by simpa only [Nat.cast_one] using hm)
  have hhi := AntitoneOn.sum_le_integral_Ico (f := w) hN
    (by simpa only [Nat.cast_one] using hm)
  simp only [Nat.cast_one] at hlo hhi
  have hint : (∫ x : ℝ in (1:ℝ)..(N:ℝ), w x) = (1-(N:ℝ)^(-t))/t := by
    dsimp only [w]
    rw [intervalIntegral.integral_const_mul, integral_rpow (Or.inl (by linarith))]
    have he : -(1-t)+1 = t := by ring
    rw [he, Real.one_rpow]
    have hp : (N:ℝ)^(-t)*(N:ℝ)^t = 1 := by rw [← Real.rpow_add hNp]; simp
    field_simp
    nlinarith
  rw [hint] at hlo hhi
  rw [Finset.sum_Ico_add' (fun d : ℕ ↦ w d) 1 N 1,
    Finset.Ico_add_one_right_eq_Icc] at hhi
  have hsum : (∑ d ∈ Finset.Icc 1 N, w d) =
      (∑ d ∈ Finset.Ico 1 N, w d) + w N := by
    rw [← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_succ_top hN]
  have hsum' : (∑ d ∈ Finset.Icc 1 N, w d) =
      w 1 + ∑ d ∈ Finset.Icc 2 N, w d := by
    rw [← Finset.insert_Icc_add_one_left_eq_Icc hN, Finset.sum_insert (by simp)]
    norm_num
  have hwN : 0 ≤ w N := by dsimp [w]; positivity
  have hw1 : w 1 ≤ 1 := by
    dsimp [w]
    rw [Real.one_rpow, mul_one]
    exact Real.rpow_le_one_of_one_le_of_nonpos hNr (by linarith)
  change |(∑ d ∈ Finset.Icc 1 N, w d) - _| ≤ 1
  rw [abs_le]
  constructor <;> linarith

lemma tendsto_weight_zero_of_log_product_limit (t : ℕ → ℝ) (z : ℝ)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto t atTop (𝓝 0) := by
  have hh := hz.div_atTop (Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ)))
  apply hh.congr'
  filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
  have hlog : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  exact mul_div_cancel_right₀ (t N) hlog

lemma reflected_rpow_sum_critical_limit (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N)
    (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N, (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N)))/log N)
      atTop (𝓝 ((1-Real.exp (-z))/z)) := by
  have ht0 := tendsto_weight_zero_of_log_product_limit t z hz
  have herr : Tendsto (fun N : ℕ ↦
      ((∑ d ∈ Finset.Icc 1 N, (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N))) -
        (∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N))))/log N) atTop (𝓝 0) := by
    have hlog := Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))
    apply squeeze_zero_norm' _ (hlog.const_div_atTop (2:ℝ))
    filter_upwards [ht, ht0.eventually_le_const (by norm_num : (0:ℝ) < 1),
      eventually_gt_atTop (1:ℕ)] with N htN htN1 hN
    have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
    have h1 := reflected_rpow_sum_integral_error N hN.le (t N) htN htN1
    have h2 := rpow_sum_integral_error N hN.le (t N) htN
    have hh := abs_sub_le (∑ d ∈ Finset.Icc 1 N, (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N)))
      ((1-(N:ℝ)^(-t N))/t N) (∑ d ∈ Finset.Icc 1 N, (d:ℝ)^(-(1+t N)))
    rw [abs_sub_comm ((1-(N:ℝ)^(-t N))/t N)] at hh
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hlogN]
    exact div_le_div_of_nonneg_right (by linarith) hlogN.le
  have hh := herr.add (moving_rpow_sum_critical_limit t ht z hzpos hz)
  rw [zero_add] at hh
  exact hh.congr (fun N ↦ by ring)

lemma reflected_weighted_rpow_sum_critical_limit (a : ℕ → ℝ) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D, a d)/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (∑ d ∈ Finset.Icc 1 N,
      a d*((N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N))))/log N)
      atTop (𝓝 (κ*((1-Real.exp (-z))/z))) := by
  have ht0 := tendsto_weight_zero_of_log_product_limit t z hz
  have hw : ∀ᶠ N : ℕ in atTop,
      (∀ d : ℕ, 0 ≤ (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N))) ∧
      AntitoneOn (fun d : ℕ ↦ (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N))) (Set.Ici 1) ∧
      (∀ d : ℕ, 1 ≤ d → d ≤ N → (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N)) ≤ (d:ℝ)⁻¹) := by
    filter_upwards [ht, ht0.eventually_le_const (by norm_num : (0:ℝ) < 1)] with N htN htN1
    refine ⟨fun _ ↦ by positivity, ?_, fun d hd hdN ↦ reflected_rpow_weight_le_inv N d hd hdN (t N) htN.le⟩
    intro d hd e he hde
    exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_nonpos
      (by exact_mod_cast hd) (by exact_mod_cast hde) (by linarith)) (by positivity)
  have herr := moving_monotone_weighted_sum_error_of_mean a κ hmean
    (fun N d ↦ (N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N))) hw
  have hh := herr.add ((reflected_rpow_sum_critical_limit t ht z hzpos hz).const_mul κ)
  rw [zero_add] at hh
  exact hh.congr (fun N ↦ by ring)

lemma polynomialWeightedDivisorTrunc_bounded_on_cutoff_error_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (w : ℕ → ℕ → ℝ) (hw : ∀ᶠ N in atTop, ∀ d, 0 ≤ w N d)
    (hw1 : ∀ᶠ N in atTop, ∀ d : ℕ, 1 ≤ d → d ≤ N → w N d ≤ 1) :
    Tendsto (fun N : ℕ ↦ (polynomialWeightedDivisorTrunc f (w N) N N -
      (N:ℝ)*∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*w N d)/
        ((N:ℝ)*log N)) atTop (𝓝 0) := by
  obtain ⟨K, hK⟩ := eventually_atTop.mp (tendsto_natCast_atTop_atTop.eventually hpos)
  obtain ⟨B, hB, hb⟩ := polynomialRootCount_sum_le_linear f hdeg hirr
  have hlim := (Real.tendsto_log_atTop.comp
    (tendsto_natCast_atTop_atTop (R := ℝ))).const_div_atTop (B+K)
  apply squeeze_zero_norm' _ hlim
  filter_upwards [hw, hw1, eventually_gt_atTop (1:ℕ)] with N hwN hw1N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
  have herr := polynomialWeightedDivisorTrunc_error f K hK (w N) hwN N N
  have he : (∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*w N d) ≤
      (B+K)*N := by
    calc
      _ ≤ ∑ d ∈ Finset.Icc 1 N, ((polynomialRootCount f d:ℝ)+K)*1 := by
        apply Finset.sum_le_sum
        intro d hd
        exact mul_le_mul_of_nonneg_left (hw1N d (Finset.mem_Icc.mp hd).1 (Finset.mem_Icc.mp hd).2) (by positivity)
      _ = (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) + (N:ℝ)*K := by
        simp only [mul_one, Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc,
          Nat.add_sub_cancel, nsmul_eq_mul]
      _ ≤ (B+K)*N := by
        have hh := hb N
        change (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)) ≤ B*N at hh
        nlinarith
  rw [Real.norm_eq_abs, abs_div, abs_of_pos (mul_pos hNp hlogN)]
  calc
    _ ≤ ((B+K)*N)/((N:ℝ)*log N) := div_le_div_of_nonneg_right (herr.trans he) (by positivity)
    _ = (B+K)/log N := by field_simp

lemma polynomialWeightedDivisorTrunc_reflected_critical_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootCount f d:ℝ))/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorTrunc f
      (fun d ↦ (N:ℝ)^(-t N)*(d:ℝ)^(t N)) N N/((N:ℝ)*log N))
        atTop (𝓝 (κ*((1-Real.exp (-z))/z))) := by
  have hw1 : ∀ᶠ N : ℕ in atTop, ∀ d : ℕ, 1 ≤ d → d ≤ N →
      (N:ℝ)^(-t N)*(d:ℝ)^(t N) ≤ 1 := by
    filter_upwards [ht, eventually_ge_atTop (1:ℕ)] with N htN hN
    intro d hd hdN
    have hNp : (0:ℝ) < N := by exact_mod_cast hN
    calc
      _ ≤ (N:ℝ)^(-t N)*(N:ℝ)^(t N) := mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hdN) htN.le) (by positivity)
      _ = 1 := by rw [← Real.rpow_add hNp]; simp
  have he := polynomialWeightedDivisorTrunc_bounded_on_cutoff_error_limit f hdeg hirr hpos
    (fun N d ↦ (N:ℝ)^(-t N)*(d:ℝ)^(t N)) (Filter.Eventually.of_forall (fun _ _ ↦ by positivity)) hw1
  have hm := reflected_weighted_rpow_sum_critical_limit
    (fun d ↦ (polynomialRootCount f d:ℝ)) κ hmean t ht z hzpos hz
  have hh := he.add hm
  rw [zero_add] at hh
  apply hh.congr'
  filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlogN : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
  have heq : (∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)/d*((N:ℝ)^(-t N)*(d:ℝ)^(t N))) =
      ∑ d ∈ Finset.Icc 1 N, (polynomialRootCount f d:ℝ)*((N:ℝ)^(-t N)*(d:ℝ)^(-(1-t N))) := by
    apply Finset.sum_congr rfl
    intro d hd
    have hdp : (0:ℝ) < d := by exact_mod_cast (Finset.mem_Icc.mp hd).1
    have hs : -(1-t N) = -1+t N := by ring
    rw [hs, Real.rpow_add hdp, Real.rpow_neg_one]
    ring
  rw [heq]
  field_simp <;> ring

lemma polynomial_floor_eval_power_lower_bound (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) :
    ∃ a > (0:ℝ), ∀ᶠ n : ℕ in atTop, a*(n:ℝ)^f.natDegree ≤ (⌊f.eval (n:ℤ)⌋₊:ℝ) := by
  let P : ℝ[X] := f.map (Int.castRingHom ℝ)
  have hPdeg : P.natDegree = f.natDegree := natDegree_map_eq_of_injective Int.cast_injective f
  have hlead : 0 < P.leadingCoeff := by
    rw [leadingCoeff_map_of_injective Int.cast_injective f]
    change 0 < (f.leadingCoeff:ℝ)
    exact_mod_cast leadingCoeff_pos_of_eventually_positive f hdeg hpos
  obtain ⟨C, hC, hb⟩ := P.isEquivalent_atTop_lead.symm.isBigO.exists_pos
  have hbN := (tendsto_natCast_atTop_atTop (R := ℝ)).eventually hb.bound
  refine ⟨P.leadingCoeff/C, div_pos hlead hC, ?_⟩
  filter_upwards [hbN, (tendsto_natCast_atTop_atTop (R := ℤ)).eventually hpos] with n hn hfn
  have heval : P.eval (n:ℝ) = (↑(f.eval (n:ℤ)):ℝ) := by
    simpa only [P, eval_map, Int.coe_castRingHom, Int.cast_natCast] using
      (eval₂_at_apply (Int.castRingHom ℝ) (n:ℤ) (p := f))
  have hfreal : 0 ≤ P.eval (n:ℝ) := by rw [heval]; exact_mod_cast (show 0 ≤ f.eval (n:ℤ) by omega)
  simp only [Real.norm_of_nonneg (mul_nonneg hlead.le (pow_nonneg (Nat.cast_nonneg _) _)),
    Real.norm_of_nonneg hfreal, hPdeg] at hn
  have he : P.eval (n:ℝ) = (⌊f.eval (n:ℤ)⌋₊:ℝ) := by
    rw [heval, Nat.floor_int]
    norm_cast
    exact (Int.toNat_of_nonneg (by omega)).symm
  rw [he] at hn
  rw [div_mul_eq_mul_div, div_le_iff₀ hC]
  nlinarith

lemma tendsto_log_nat_div_div_log (q : ℕ) (hq : 0 < q) :
    Tendsto (fun N : ℕ ↦ log ((N/q:ℕ):ℝ)/log (N:ℝ)) atTop (𝓝 1) := by
  have hl := tendsto_log_nat_floor_scaled_div_log (1/q) (by positivity)
  simpa only [one_div_mul_eq_div, Nat.floor_div_eq_div] using hl

lemma moving_model_rpow_limit (a : ℝ) (ha : 0 < a) (k q : ℕ) (hq : 0 < q)
    (t : ℕ → ℝ) (z : ℝ)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (a*((N/q:ℕ):ℝ)^k)^(-t N)) atTop (𝓝 (Real.exp (-((k:ℝ)*z)))) := by
  have ht0 := tendsto_weight_zero_of_log_product_limit t z hz
  have hlogq := tendsto_log_nat_div_div_log q hq
  have hprod : Tendsto (fun N : ℕ ↦ t N*log ((N/q:ℕ):ℝ)) atTop (𝓝 z) := by
    have hh := hz.mul hlogq
    rw [mul_one] at hh
    apply hh.congr'
    filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    have hlogN : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
    field_simp
  have hlim := ((ht0.mul_const (log a)).add (hprod.const_mul (k:ℝ))).neg
  simp only [zero_mul, zero_add, neg_mul] at hlim
  have hh := (Real.continuous_exp.tendsto _).comp hlim
  apply hh.congr'
  filter_upwards [(Nat.tendsto_div_const_atTop hq.ne').eventually_gt_atTop 0] with N hN
  have hQp : (0:ℝ) < (N/q:ℕ) := by exact_mod_cast hN
  rw [Real.rpow_def_of_pos (mul_pos ha (pow_pos hQp _)),
    Real.log_mul ha.ne' (pow_ne_zero _ hQp.ne'), Real.log_pow]
  dsimp only [Function.comp_def]
  congr 1
  ring

lemma polynomial_moving_rpow_uniform_on_tail (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (t : ℕ → ℝ)
    (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z))
    (q : ℕ) (hq : 0 < q) :
    ∀ ε > (0:ℝ), ∀ᶠ N : ℕ in atTop, ∀ n : ℕ, N/q ≤ n → n < N →
      |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t N)-Real.exp (-((f.natDegree:ℝ)*z))| < ε := by
  obtain ⟨a, ha, hfa⟩ := polynomial_floor_eval_power_lower_bound f hdeg hpos
  obtain ⟨K, hK⟩ := eventually_atTop.mp hfa
  obtain ⟨A, hA, hfA⟩ := polynomial_floor_eval_power_bound f
  have hAp : 0 < A := zero_lt_one.trans_le hA
  have hL := moving_model_rpow_limit A hAp f.natDegree 1 (by omega) t z hz
  simp only [Nat.div_one] at hL
  have hU := moving_model_rpow_limit a ha f.natDegree q hq t z hz
  intro ε hε
  filter_upwards [ht, hL.eventually_const_lt (sub_lt_self _ hε),
    hU.eventually_lt_const (lt_add_of_pos_right _ hε),
    (Nat.tendsto_div_const_atTop hq.ne').eventually_ge_atTop (max K 1)] with N htN hLN hUN hQ
  intro n hQn hnN
  have hQ1 : 1 ≤ N/q := (le_max_right K 1).trans hQ
  have hQp : (0:ℝ) < (N/q:ℕ) := by exact_mod_cast hQ1
  have hlow : a*((N/q:ℕ):ℝ)^f.natDegree ≤ (⌊f.eval (n:ℤ)⌋₊:ℝ) := by
    calc
      _ ≤ a*(n:ℝ)^f.natDegree := mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (by positivity) (by exact_mod_cast hQn) _) ha.le
      _ ≤ _ := hK n (((le_max_left K 1).trans hQ).trans hQn)
  have hhigh : (⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ A*(N:ℝ)^f.natDegree := by
    exact (hfA n).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (by positivity) (by exact_mod_cast hnN) _) hAp.le)
  have hmp : 0 < (⌊f.eval (n:ℤ)⌋₊:ℝ) := (mul_pos ha (pow_pos hQp _)).trans_le hlow
  have hleL := Real.rpow_le_rpow_of_nonpos hmp hhigh (by linarith : -t N ≤ 0)
  have hleU := Real.rpow_le_rpow_of_nonpos (mul_pos ha (pow_pos hQp _)) hlow (by linarith : -t N ≤ 0)
  rw [abs_lt]
  constructor <;> linarith

lemma nat_rpow_neg_le_one (m : ℕ) (t : ℝ) (ht : 0 < t) : (m:ℝ)^(-t) ≤ 1 := by
  by_cases hm : m = 0
  · rw [hm, Nat.cast_zero, Real.zero_rpow (neg_ne_zero.mpr ht.ne')]
    norm_num
  · exact Real.rpow_le_one_of_one_le_of_nonpos
      (by exact_mod_cast (Nat.one_le_iff_ne_zero.mpr hm)) (by linarith)

lemma polynomial_sigma_range_sum_le (f : ℤ[X]) (N : ℕ) :
    (∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) ≤ Erdos975Sum f N := by
  rw [Erdos975Sum, Nat.floor_natCast]
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro n hn
    exact Finset.mem_Iic.mpr (Finset.mem_range.mp hn).le
  · exact fun _ _ _ ↦ Nat.cast_nonneg _

lemma polynomial_moving_rpow_sigma_error_limit (f : ℤ[X]) (hdeg : f.natDegree ≠ 0)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 ≤ z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)*
      |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t N)-Real.exp (-((f.natDegree:ℝ)*z))|)/((N:ℝ)*log N))
      atTop (𝓝 0) := by
  obtain ⟨C, hC, hupper⟩ := erdos975_eventual_log_upper_bound f hdeg hirr
  have hCN : ∀ᶠ N : ℕ in atTop, Erdos975Sum f N ≤ C*((N:ℝ)*log N) :=
    tendsto_natCast_atTop_atTop.eventually hupper
  let c := Real.exp (-((f.natDegree:ℝ)*z))
  have hc0 : 0 ≤ c := (Real.exp_pos _).le
  have hc1 : c ≤ 1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr (mul_nonneg (Nat.cast_nonneg _) hzpos))
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  obtain ⟨q, hq⟩ := exists_nat_gt (4*C/ε)
  have hqR : (0:ℝ) < q := (by positivity : 0 < 4*C/ε).trans hq
  have hqpos : 0 < q := by exact_mod_cast hqR
  have hCq : C/(q:ℝ) < ε/4 := by
    have hh := (div_lt_iff₀ hε).mp hq
    apply (div_lt_iff₀ hqR).mpr
    nlinarith
  let δ := ε/(4*C)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hδC : δ*C = ε/4 := by dsimp [δ]; field_simp
  have hkernel := polynomial_moving_rpow_uniform_on_tail f hdeg hpos t ht z hz q hqpos δ hδ
  filter_upwards [ht, hCN, (Nat.tendsto_div_const_atTop hqpos.ne').eventually hCN,
    hkernel, (Nat.tendsto_div_const_atTop hqpos.ne').eventually_ge_atTop 1,
    eventually_gt_atTop (1:ℕ)] with N htN hNupper hQupper hker hQ hN
  have hNp : (0:ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hlogN : 0 < log (N:ℝ) := Real.log_pos (by exact_mod_cast hN)
  have hden : 0 < (N:ℝ)*log N := mul_pos hNp hlogN
  let b : ℕ → ℝ := fun n ↦ (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)
  let e : ℕ → ℝ := fun n ↦ |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t N)-c|
  have hb0 : ∀ n, 0 ≤ b n := fun _ ↦ Nat.cast_nonneg _
  have he0 : ∀ n, 0 ≤ e n := fun _ ↦ abs_nonneg _
  have he1 : ∀ n, e n ≤ 1 := by
    intro n
    have hh := nat_rpow_neg_le_one ⌊f.eval (n:ℤ)⌋₊ (t N) htN
    have hp : 0 ≤ (⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t N) := by positivity
    dsimp only [e]
    rw [abs_le]
    constructor <;> linarith
  have hsum : (∑ n ∈ Finset.range N, b n*e n) ≤ Erdos975Sum f (N/q:ℕ) + δ*Erdos975Sum f N := by
    rw [← Finset.sum_filter_add_sum_filter_not (s := Finset.range N)
      (p := fun n ↦ n < N/q) (f := fun n ↦ b n*e n)]
    apply add_le_add
    · calc
        _ ≤ ∑ n ∈ (Finset.range N).filter (fun n ↦ n < N/q), b n :=
          Finset.sum_le_sum (fun n hn ↦ by nlinarith [he1 n, hb0 n])
        _ ≤ ∑ n ∈ Finset.range (N/q), b n := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro n hn
            exact Finset.mem_range.mpr (Finset.mem_filter.mp hn).2
          · exact fun n _ _ ↦ hb0 n
        _ ≤ Erdos975Sum f (N/q:ℕ) := polynomial_sigma_range_sum_le f _
    · calc
        _ ≤ ∑ n ∈ (Finset.range N).filter (fun n ↦ ¬n < N/q), δ*b n := by
          apply Finset.sum_le_sum
          intro n hn
          have heδ := hker n (by have := (Finset.mem_filter.mp hn).2; omega)
            (Finset.mem_range.mp (Finset.mem_filter.mp hn).1)
          change e n < δ at heδ
          nlinarith [hb0 n]
        _ ≤ ∑ n ∈ Finset.range N, δ*b n := Finset.sum_le_sum_of_subset_of_nonneg
          (Finset.filter_subset _ _) (fun n _ _ ↦ mul_nonneg hδ.le (hb0 n))
        _ ≤ δ*Erdos975Sum f N := by
          rw [← Finset.mul_sum]
          exact mul_le_mul_of_nonneg_left (polynomial_sigma_range_sum_le f _) hδ.le
  have hQp : (0:ℝ) < (N/q:ℕ) := by exact_mod_cast hQ
  have hlogQ : log ((N/q:ℕ):ℝ) ≤ log (N:ℝ) :=
    Real.log_le_log hQp (by exact_mod_cast Nat.div_le_self N q)
  have hQbound : Erdos975Sum f (N/q:ℕ) ≤ (C/(q:ℝ))*((N:ℝ)*log N) := by
    calc
      _ ≤ C*((N/q:ℕ):ℝ)*log ((N/q:ℕ):ℝ) := by simpa only [mul_assoc] using hQupper
      _ ≤ C*((N/q:ℕ):ℝ)*log (N:ℝ) := mul_le_mul_of_nonneg_left hlogQ (by positivity)
      _ ≤ C*((N:ℝ)/(q:ℝ))*log (N:ℝ) := by gcongr; exact Nat.cast_div_le
      _ = _ := by ring
  have htotal : (∑ n ∈ Finset.range N, b n*e n) ≤
      (C/(q:ℝ)+δ*C)*((N:ℝ)*log N) := by
    have hh := hsum.trans (add_le_add hQbound (mul_le_mul_of_nonneg_left hNupper hδ.le))
    convert hh using 1 <;> ring
  change dist ((∑ n ∈ Finset.range N, b n*e n)/((N:ℝ)*log N)) 0 < ε
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (div_nonneg
    (Finset.sum_nonneg (fun n _ ↦ mul_nonneg (hb0 n) (he0 n))) hden.le)]
  calc
    _ ≤ C/(q:ℝ)+δ*C := (div_le_iff₀ hden).mpr htotal
    _ < ε := by rw [hδC]; linarith

lemma polynomialWeightedDivisorTrunc_const_mul (f : ℤ[X]) (w : ℕ → ℝ) (N D : ℕ) (a : ℝ) :
    polynomialWeightedDivisorTrunc f (fun d ↦ a*w d) N D = a*polynomialWeightedDivisorTrunc f w N D := by
  simp only [polynomialWeightedDivisorTrunc, Finset.mul_sum]

lemma moving_nat_rpow_limit (t : ℕ → ℝ) (z : ℝ)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ (N:ℝ)^(t N)) atTop (𝓝 (Real.exp z)) := by
  apply ((Real.continuous_exp.tendsto z).comp hz).congr'
  filter_upwards [eventually_gt_atTop (0:ℕ)] with N hN
  rw [Real.rpow_def_of_pos (by exact_mod_cast hN)]
  dsimp only [Function.comp_def]
  congr 1
  ring

lemma polynomialWeightedDivisorTrunc_positive_critical_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootCount f d:ℝ))/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorTrunc f
      (fun d ↦ (d:ℝ)^(t N)) N N/((N:ℝ)*log N))
        atTop (𝓝 (Real.exp z*(κ*((1-Real.exp (-z))/z)))) := by
  have hh := (moving_nat_rpow_limit t z hz).mul
    (polynomialWeightedDivisorTrunc_reflected_critical_limit f hdeg hirr hpos κ hmean t ht z hzpos hz)
  apply hh.congr'
  filter_upwards [eventually_gt_atTop (0:ℕ)] with N hN
  have hNp : (0:ℝ) < N := by exact_mod_cast hN
  rw [polynomialWeightedDivisorTrunc_const_mul, ← mul_div_assoc, ← mul_assoc,
    ← Real.rpow_add hNp]
  simp

noncomputable def polynomialWeightedComplementaryDivisorSum (f : ℤ[X]) (w : ℕ → ℝ) (N D : ℕ) : ℝ :=
  ∑ n ∈ Finset.range N, ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter
    (fun d ↦ ⌊f.eval (n:ℤ)⌋₊/d ≤ D), w d

lemma divisor_positive_rpow_trunc_le (m D : ℕ) (t : ℝ) (ht : 0 ≤ t) :
    (∑ d ∈ m.divisors.filter (fun d ↦ d ≤ D), (d:ℝ)^t) ≤ (D:ℝ)^t*(σ 0 m:ℝ) := by
  calc
    _ ≤ ∑ _d ∈ m.divisors.filter (fun d ↦ d ≤ D), (D:ℝ)^t := by
      apply Finset.sum_le_sum
      intro d hd
      exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast (Finset.mem_filter.mp hd).2) ht
    _ ≤ (D:ℝ)^t*(σ 0 m:ℝ) := by
      rw [Finset.sum_const, nsmul_eq_mul, ArithmeticFunction.sigma_zero_apply, mul_comm]
      exact mul_le_mul_of_nonneg_left (by exact_mod_cast Finset.card_filter_le _ _) (by positivity)

lemma polynomialWeightedComplementaryDivisorSum_rpow_error (f : ℤ[X]) (N : ℕ)
    (t c : ℝ) (ht : 0 ≤ t) :
    |polynomialWeightedComplementaryDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N N -
      c*polynomialWeightedDivisorTrunc f (fun d ↦ (d:ℝ)^t) N N| ≤
      (N:ℝ)^t*∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)*
        |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)-c| := by
  have hx : polynomialWeightedComplementaryDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N N =
      ∑ n ∈ Finset.range N, (⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)*
        ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter (fun d ↦ d ≤ N), (d:ℝ)^t := by
    unfold polynomialWeightedComplementaryDivisorSum
    exact Finset.sum_congr rfl (fun _ _ ↦ divisor_rpow_trunc_reflection _ N t)
  rw [hx, polynomialWeightedDivisorTrunc, Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  let B := ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter (fun d ↦ d ≤ N), (d:ℝ)^t
  have hB0 : 0 ≤ B := Finset.sum_nonneg (fun _ _ ↦ by positivity)
  have hB := divisor_positive_rpow_trunc_le ⌊f.eval (n:ℤ)⌋₊ N t ht
  change B ≤ _ at hB
  change |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)*B-c*B| ≤ _
  rw [← sub_mul, abs_mul, abs_of_nonneg hB0]
  calc
    _ ≤ |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)-c| * ((N:ℝ)^t*(σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) :=
      mul_le_mul_of_nonneg_left hB (abs_nonneg _)
    _ = _ := by ring

lemma polynomialWeightedComplementaryDivisorSum_critical_limit (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootCount f d:ℝ))/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedComplementaryDivisorSum f
      (fun d ↦ (d:ℝ)^(-t N)) N N/((N:ℝ)*log N))
        atTop (𝓝 (Real.exp (-(((f.natDegree:ℝ)-1)*z))*(κ*((1-Real.exp (-z))/z)))) := by
  let c := Real.exp (-((f.natDegree:ℝ)*z))
  have he := polynomial_moving_rpow_sigma_error_limit f hdeg hirr hpos t ht z hzpos.le hz
  have hb := (moving_nat_rpow_limit t z hz).mul he
  rw [mul_zero] at hb
  have herr : Tendsto (fun N : ℕ ↦
      (polynomialWeightedComplementaryDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N N -
        c*polynomialWeightedDivisorTrunc f (fun d ↦ (d:ℝ)^(t N)) N N)/((N:ℝ)*log N))
        atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ hb
    filter_upwards [ht, eventually_gt_atTop (1:ℕ)] with N htN hN
    have hden : 0 < (N:ℝ)*log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
      (Real.log_pos (by exact_mod_cast hN))
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hden]
    have hh := div_le_div_of_nonneg_right
      (polynomialWeightedComplementaryDivisorSum_rpow_error f N (t N) c htN.le) hden.le
    convert hh using 1 <;> ring
  have htrunc := (polynomialWeightedDivisorTrunc_positive_critical_limit f hdeg hirr hpos κ hmean t ht z hzpos hz).const_mul c
  have hh := herr.add htrunc
  rw [zero_add] at hh
  have hce : c*Real.exp z = Real.exp (-(((f.natDegree:ℝ)-1)*z)) := by
    dsimp only [c]
    rw [← Real.exp_add]
    congr 1
    ring
  rw [← mul_assoc, hce] at hh
  exact hh.congr (fun N ↦ by ring)


/- Full critical reflection; no convergence of either full transform is assumed. -/

lemma divisor_positive_rpow_le (m : ℕ) (t : ℝ) (ht : 0 ≤ t) :
    (∑ d ∈ m.divisors, (d:ℝ)^t) ≤ (m:ℝ)^t*(σ 0 m:ℝ) := by
  have hf : m.divisors.filter (fun d ↦ d ≤ m) = m.divisors := by
    apply Finset.filter_eq_self.mpr
    intro d hd
    exact Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hd))
      (Nat.dvd_of_mem_divisors hd)
  simpa only [hf] using divisor_positive_rpow_trunc_le m m t ht

lemma polynomialWeightedDivisorSum_full_reflection_error (f : ℤ[X]) (A : ℝ)
    (hA : 0 ≤ A)
    (hbound : ∀ n : ℕ, (⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ A*(n+1:ℝ)^f.natDegree)
    (N : ℕ) (t c : ℝ) (ht : 0 ≤ t) :
    |polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t)) N -
      c*polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^t) N| ≤
      (A*(N:ℝ)^f.natDegree)^t*∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)*
        |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)-c| := by
  rw [polynomialWeightedDivisorSum_rpow_reflection, polynomialWeightedDivisorSum,
    Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  let B := ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors, (d:ℝ)^t
  have hB0 : 0 ≤ B := Finset.sum_nonneg (fun _ _ ↦ by positivity)
  have hB := divisor_positive_rpow_le ⌊f.eval (n:ℤ)⌋₊ t ht
  change B ≤ _ at hB
  have hval : (⌊f.eval (n:ℤ)⌋₊:ℝ) ≤ A*(N:ℝ)^f.natDegree :=
    (hbound n).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (by positivity) (by exact_mod_cast Finset.mem_range.mp hn) _) hA)
  have hp := Real.rpow_le_rpow (Nat.cast_nonneg _) hval ht
  have hB' : B ≤ (A*(N:ℝ)^f.natDegree)^t*(σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ) :=
    hB.trans (mul_le_mul_of_nonneg_right hp (Nat.cast_nonneg _))
  change |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)*B-c*B| ≤ _
  rw [← sub_mul, abs_mul, abs_of_nonneg hB0]
  calc
    _ ≤ |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t)-c| *
        ((A*(N:ℝ)^f.natDegree)^t*(σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)) :=
      mul_le_mul_of_nonneg_left hB' (abs_nonneg _)
    _ = _ := by ring

/-- A critical-scale functional equation for the full weighted divisor sums.
It is a relation between two potentially nonconvergent sequences, not a convergence theorem
for the unweighted divisor sum. -/
lemma polynomialWeightedDivisorSum_critical_reflection (f : ℤ[X])
    (hdeg : f.natDegree ≠ 0) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 ≤ z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    Tendsto (fun N : ℕ ↦
      (polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N -
        Real.exp (-((f.natDegree:ℝ)*z))*polynomialWeightedDivisorSum f
          (fun d ↦ (d:ℝ)^(t N)) N)/((N:ℝ)*log N)) atTop (𝓝 0) := by
  obtain ⟨A, hA, hbound⟩ := polynomial_floor_eval_power_bound f
  have hAp : 0 < A := zero_lt_one.trans_le hA
  have hzneg : Tendsto (fun N : ℕ ↦ (-t N)*log (N:ℝ)) atTop (𝓝 (-z)) := by
    simpa only [neg_mul] using hz.neg
  have hmodel := moving_model_rpow_limit A hAp f.natDegree 1 (by norm_num)
    (fun N ↦ -t N) (-z) hzneg
  simp only [Nat.div_one, neg_neg, mul_neg] at hmodel
  have herr := polynomial_moving_rpow_sigma_error_limit f hdeg hirr hpos t ht z hzpos hz
  have hh := hmodel.mul herr
  rw [mul_zero] at hh
  apply squeeze_zero_norm' _ hh
  filter_upwards [ht, eventually_gt_atTop (1:ℕ)] with N htN hN
  have hden : 0 < (N:ℝ)*log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
    (Real.log_pos (by exact_mod_cast hN))
  rw [Real.norm_eq_abs, abs_div, abs_of_pos hden]
  have hb := div_le_div_of_nonneg_right
    (polynomialWeightedDivisorSum_full_reflection_error f A hAp.le hbound N (t N)
      (Real.exp (-((f.natDegree:ℝ)*z))) htN.le) hden.le
  convert hb using 1 <;> ring



noncomputable def polynomialWeightedDivisorOverlap (f : ℤ[X]) (w : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.range N, ∑ d ∈ (⌊f.eval (n:ℤ)⌋₊).divisors.filter
    (fun d ↦ d ≤ N ∧ ⌊f.eval (n:ℤ)⌋₊/d ≤ N), w d

lemma divisor_overlap_empty (m N : ℕ) (hm : N^2 < m) :
    m.divisors.filter (fun d ↦ d ≤ N ∧ m/d ≤ N) = ∅ := by
  apply Finset.filter_eq_empty_iff.mpr
  intro d hd hcond
  have he : m/d*d = m := Nat.div_mul_cancel (Nat.dvd_of_mem_divisors hd)
  have hb := Nat.mul_le_mul hcond.2 hcond.1
  rw [he, ← pow_two] at hb
  omega

lemma divisor_overlap_weight_le (m N : ℕ) (w : ℕ → ℝ)
    (hw : ∀ d : ℕ, 1 ≤ d → w d ≤ 1) :
    (∑ d ∈ m.divisors.filter (fun d ↦ d ≤ N ∧ m/d ≤ N), w d) ≤ (σ 0 m:ℝ) := by
  calc
    _ ≤ ∑ _d ∈ m.divisors.filter (fun d ↦ d ≤ N ∧ m/d ≤ N), (1:ℝ) := by
      apply Finset.sum_le_sum
      intro d hd
      exact hw d (Nat.pos_of_mem_divisors (Finset.mem_filter.mp hd).1)
    _ ≤ (σ 0 m:ℝ) := by
      rw [Finset.sum_const, nsmul_eq_mul, mul_one, ArithmeticFunction.sigma_zero_apply]
      exact_mod_cast Finset.card_filter_le m.divisors _

lemma polynomialWeightedDivisorOverlap_nonneg (f : ℤ[X]) (w : ℕ → ℝ) (N : ℕ)
    (hw : ∀ d, 0 ≤ w d) : 0 ≤ polynomialWeightedDivisorOverlap f w N := by
  exact Finset.sum_nonneg (fun _ _ ↦ Finset.sum_nonneg (fun d _ ↦ hw d))

/-- Divisors counted by both endpoints have negligible total weight.
The result is uniform over all nonnegative weights bounded by one. -/
lemma polynomialWeightedDivisorOverlap_limit (f : ℤ[X]) (hdeg : 2 < f.natDegree)
    (hirr : Irreducible f) (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n)
    (w : ℕ → ℕ → ℝ) (hw : ∀ᶠ N in atTop, ∀ d, 0 ≤ w N d)
    (hw1 : ∀ᶠ N in atTop, ∀ d : ℕ, 1 ≤ d → w N d ≤ 1) :
    Tendsto (fun N : ℕ ↦ polynomialWeightedDivisorOverlap f (w N) N / ((N:ℝ)*log N))
      atTop (𝓝 0) := by
  let t : ℕ → ℝ := fun N ↦ 1/log (N:ℝ)
  have ht : ∀ᶠ N in atTop, 0 < t N := by
    filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    exact one_div_pos.mpr (Real.log_pos (by exact_mod_cast hN))
  have hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 (1:ℝ)) := by
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_gt_atTop (1:ℕ)] with N hN
    have hp : log (N:ℝ) ≠ 0 := (Real.log_pos (by exact_mod_cast hN)).ne'
    dsimp [t]
    field_simp
  let c : ℝ := Real.exp (-(f.natDegree:ℝ))
  let δ : ℝ := (Real.exp (-2)-c)/2
  have hce : c < Real.exp (-2) := by
    apply Real.exp_lt_exp.mpr
    have hh : (2:ℝ) < f.natDegree := by exact_mod_cast hdeg
    linarith
  have hδ : 0 < δ := by dsimp [δ]; linarith
  have hδc : c+δ < Real.exp (-2) := by dsimp [δ]; linarith
  have hbase := moving_model_rpow_limit 1 (by norm_num) 2 1 (by norm_num) t 1 hz
  simp only [Nat.div_one, one_mul, Nat.cast_ofNat, mul_one] at hbase
  have herr := polynomial_moving_rpow_sigma_error_limit f (by omega) hirr hpos t ht 1 (by norm_num) hz
  simp only [mul_one] at herr
  have hlim := herr.div_const δ
  rw [zero_div] at hlim
  apply squeeze_zero_norm' _ hlim
  filter_upwards [hw, hw1, ht, hbase.eventually_const_lt hδc,
    eventually_gt_atTop (1:ℕ)] with N hwN hw1N htN hbaseN hN
  have hden : 0 < (N:ℝ)*log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
    (Real.log_pos (by exact_mod_cast hN))
  have hsum : δ*polynomialWeightedDivisorOverlap f (w N) N ≤
      ∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)*
        |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t N)-c| := by
    rw [polynomialWeightedDivisorOverlap, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro n hn
    let m := ⌊f.eval (n:ℤ)⌋₊
    change δ*(∑ d ∈ m.divisors.filter (fun d ↦ d ≤ N ∧ m/d ≤ N), w N d) ≤
      (σ 0 m:ℝ)*|(m:ℝ)^(-t N)-c|
    by_cases hm0 : m = 0
    · simp [hm0]
    by_cases hm : m ≤ N^2
    · have hmp : (0:ℝ) < m := by exact_mod_cast Nat.pos_of_ne_zero hm0
      have hp := Real.rpow_le_rpow_of_nonpos hmp
        (show (m:ℝ) ≤ (N:ℝ)^2 by exact_mod_cast hm) (by linarith : -t N ≤ 0)
      have he : δ ≤ |(m:ℝ)^(-t N)-c| := by
        have hh := le_abs_self ((m:ℝ)^(-t N)-c)
        linarith
      have hb := divisor_overlap_weight_le m N (w N) hw1N
      calc
        _ ≤ δ*(σ 0 m:ℝ) := mul_le_mul_of_nonneg_left hb hδ.le
        _ ≤ _ := by nlinarith [Nat.cast_nonneg (α := ℝ) (σ 0 m)]
    · rw [divisor_overlap_empty m N (by omega), Finset.sum_empty, mul_zero]
      positivity
  rw [Real.norm_of_nonneg (div_nonneg (polynomialWeightedDivisorOverlap_nonneg f (w N) N hwN) hden.le)]
  change polynomialWeightedDivisorOverlap f (w N) N / ((N:ℝ)*log N) ≤
    ((∑ n ∈ Finset.range N, (σ 0 ⌊f.eval (n:ℤ)⌋₊:ℝ)*
      |(⌊f.eval (n:ℤ)⌋₊:ℝ)^(-t N)-c|)/((N:ℝ)*log N))/δ
  apply (le_div_iff₀ hδ).mpr
  rw [div_mul_eq_mul_div]
  apply (div_le_div_iff_of_pos_right hden).mpr
  convert hsum using 1
  ring

lemma polynomialWeightedDivisor_endpoints_le (f : ℤ[X]) (w : ℕ → ℝ) (N : ℕ)
    (hw : ∀ d, 0 ≤ w d) :
    polynomialWeightedDivisorTrunc f w N N + polynomialWeightedComplementaryDivisorSum f w N N -
      polynomialWeightedDivisorOverlap f w N ≤ polynomialWeightedDivisorSum f w N := by
  unfold polynomialWeightedDivisorTrunc polynomialWeightedComplementaryDivisorSum
    polynomialWeightedDivisorOverlap polynomialWeightedDivisorSum
  rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_le_sum
  intro n hn
  simp only [Finset.sum_filter]
  rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_le_sum
  intro d hd
  split_ifs <;> simp_all

/-- Both endpoint contributions can be added when bounding the full
critical-scale weighted divisor sum from below. No convergence of the
remaining middle contribution is asserted. -/
lemma polynomialWeightedDivisorSum_critical_two_end_lower (f : ℤ[X])
    (hdeg : 2 < f.natDegree) (hirr : Irreducible f)
    (hpos : ∀ᶠ n in atTop, 1 ≤ f.eval n) (κ : ℝ)
    (hmean : Tendsto (fun D : ℕ ↦ (∑ d ∈ Finset.Icc 1 D,
      (polynomialRootCount f d:ℝ))/(D:ℝ)) atTop (𝓝 κ))
    (t : ℕ → ℝ) (ht : ∀ᶠ N in atTop, 0 < t N) (z : ℝ) (hzpos : 0 < z)
    (hz : Tendsto (fun N : ℕ ↦ t N*log (N:ℝ)) atTop (𝓝 z)) :
    ∀ ε > (0:ℝ), ∀ᶠ N : ℕ in atTop,
      (1+Real.exp (-(((f.natDegree:ℝ)-1)*z)))*(κ*((1-Real.exp (-z))/z))-ε ≤
        polynomialWeightedDivisorSum f (fun d ↦ (d:ℝ)^(-t N)) N/((N:ℝ)*log N) := by
  have hs := polynomialWeightedDivisorTrunc_critical_limit f (by omega) hirr hpos κ hmean t ht z hzpos hz
  have hc := polynomialWeightedComplementaryDivisorSum_critical_limit f (by omega) hirr hpos κ hmean t ht z hzpos hz
  have ho := polynomialWeightedDivisorOverlap_limit f hdeg hirr hpos
    (fun N d ↦ (d:ℝ)^(-t N)) (Filter.Eventually.of_forall (fun _ _ ↦ by positivity))
    (ht.mono (fun N htN d _ ↦ nat_rpow_neg_le_one d (t N) htN))
  have hh := (hs.add hc).sub ho
  simp only [sub_zero] at hh
  have he : κ*((1-Real.exp (-z))/z) +
      Real.exp (-(((f.natDegree:ℝ)-1)*z))*(κ*((1-Real.exp (-z))/z)) =
      (1+Real.exp (-(((f.natDegree:ℝ)-1)*z)))*(κ*((1-Real.exp (-z))/z)) := by ring
  rw [he] at hh
  intro ε hε
  filter_upwards [hh.eventually_const_lt (sub_lt_self _ hε), eventually_gt_atTop (1:ℕ)] with N hN hN1
  have hden : 0 < (N:ℝ)*log N := mul_pos (by exact_mod_cast (show 0 < N by omega))
    (Real.log_pos (by exact_mod_cast hN1))
  apply hN.le.trans
  have hb := div_le_div_of_nonneg_right (polynomialWeightedDivisor_endpoints_le f
    (fun d ↦ (d:ℝ)^(-t N)) N (fun _ ↦ by positivity)) hden.le
  convert hb using 1
  ring


/- Conjecture. -/

/--
For an irreducible polynomial $f \in \mathbb{Z}[x]$ with $f(n) \ge 1$ for sufficiently large $n$,
does there exists a constant $c = c(f) > 0$ such that
$\sum_{n \le x} \tau(f(n)) \approx c \cdot x \log x$?

Note that it is unclear whether the polynomial should have integer coefficients or merely be
integer-valued. We assume the former. -/
theorem erdos_975 : 
    ∀ f : ℤ[X], f.natDegree ≠ 0 → Irreducible f → (∀ᶠ n in atTop, 1 ≤ f.eval n) →
    ∃ c > (0 : ℝ), Tendsto (fun x ↦ Erdos975Sum f x / (x * log x)) atTop (𝓝 c) := by
  intro f hdeg hirr hpos
  by_cases hle : f.natDegree ≤ 2
  · exact erdos975_degree_le_two f hdeg hle hirr hpos
  · apply (erdos975_degree_gt_two_iff_large_root_sum f (by omega) hirr hpos 1 (by norm_num)).mpr
    simp only [one_mul]
    sorry

end Erdos975
