import Submission.DoubledPetersenCircuits

/-!
Fractional cost is not submodular, even on the Boolean algebra generated by
one MINIMUM Petersen circuit partition. This file proves the exact statement
in the complete multiplicity model. The subdivision-to-SimpleGraph transport
is not asserted here. This is not a disproof of Erdős 184.
-/
open scoped BigOperators
namespace Erdos184.PetersenSubfamilyFractional
open DoubledPetersenCertificate
set_option maxHeartbeats 2000000
set_option maxRecDepth 20000

abbrev E := Fin 15
abbrev I := Fin 72

def pieces : Fin 5 → I := ![0,11,37,56,61]
def state (S : Finset (Fin 5)) (e : E) : ℕ := ∑ j ∈ S, digit (pieces j) e

def S : Finset (Fin 5) := {0,1,2,4}
def T : Finset (Fin 5) := {0,1,3,4}

lemma union_eq : S ∪ T = Finset.univ := by decide
lemma inter_eq : S ∩ T = {0,1,4} := by decide
lemma state_full (e : E) : state Finset.univ e = 2 := by revert e; decide
lemma minimum_partition : IsPartition [pieces 0,pieces 1,pieces 2,pieces 3,pieces 4] := by
  unfold IsPartition; decide
lemma partition_minimal (D : List I) (hD : IsPartition D) : 5 ≤ D.length :=
  partition_length_lower D hD
lemma semantic_minimum (D : List Multiplicity) (hD : IsCircuitPartition D) :
    5 ≤ D.length := circuitPartition_length_lower D hD

/-- Replacement in the complete five-piece minimum proves minimum cardinality
for EVERY subfamily, not only for the full state used in the certificate. -/
lemma subfamily_minimal (R : Finset (Fin 5)) (D : List I)
    (hD : ∀ e : E, (D.map (fun i => digit i e)).sum = state R e) :
    R.card ≤ D.length := by
  let L : List I := ((Finset.univ \ R).toList).map pieces
  have hs (e : E) : (L.map (fun i => digit i e)).sum =
      ∑ j ∈ Finset.univ \ R, digit (pieces j) e := by
    simp only [L,List.map_map]
    rw [← List.sum_toFinset _ (Finset.nodup_toList _)]
    simp
  have hp : IsPartition (D ++ L) := by
    intro e
    simp only [List.map_append,List.sum_append,hD e,hs e]
    have hh := Finset.sum_sdiff (f := fun j => digit (pieces j) e)
      (Finset.subset_univ R)
    change (∑ j ∈ Finset.univ \ R, digit (pieces j) e) + state R e =
      state Finset.univ e at hh
    rw [state_full] at hh
    omega
  have hn := partition_length_lower (D ++ L) hp
  have hlen : L.length = 5 - R.card := by
    simp [L,Finset.card_sdiff]
  rw [List.length_append,hlen] at hn
  have hR : R.card ≤ 5 := by
    simpa using Finset.card_le_card (Finset.subset_univ R)
  omega

/-- Availability matters: a digon is unavailable at demand one. -/
def FractionalCover (m : Multiplicity) (w : I → ℝ) : Prop :=
  (∀ i, 0 ≤ w i) ∧ (∀ i, w i ≠ 0 → ∀ e, digit i e ≤ m e) ∧
    ∀ e, ∑ i, w i * (digit i e : ℝ) = m e

def ExactCost (m : Multiplicity) (c : ℝ) : Prop :=
  (∃ w, FractionalCover m w ∧ ∑ i, w i = c) ∧
    ∀ w, FractionalCover m w → c ≤ ∑ i, w i

lemma weak_duality (m : Multiplicity) (w : I → ℝ) (hw : FractionalCover m w)
    (d : E → ℝ) (hd : ∀ i, ∑ e, d e * (digit i e : ℝ) ≤ 1) :
    (∑ e, d e * (m e : ℝ)) ≤ ∑ i, w i := by
  calc
    (∑ e, d e * (m e : ℝ)) = ∑ e, d e * ∑ i, w i * (digit i e : ℝ) := by
      simp_rw [hw.2.2]
    _ = ∑ i, w i * ∑ e, d e * (digit i e : ℝ) := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro e _
      ring
    _ ≤ ∑ i, w i := Finset.sum_le_sum fun i _ => by
      simpa using mul_le_mul_of_nonneg_left (hd i) (hw.1 i)

noncomputable def uniform (A : Finset I) (q : ℕ) (i : I) : ℝ :=
  if i ∈ A then 1 / q else 0

lemma uniform_cover (m : Multiplicity) (A : Finset I) (q : ℕ) (hq : 0 < q)
    (hA : ∀ i ∈ A, ∀ e, digit i e ≤ m e)
    (hc : ∀ e, ∑ i ∈ A, digit i e = q * m e) :
    FractionalCover m (uniform A q) := by
  have hqr : (0 : ℝ) < q := by exact_mod_cast hq
  refine ⟨?_,?_,?_⟩
  · intro i
    unfold uniform
    split_ifs <;> positivity
  · intro i hi
    have hm : i ∈ A := by
      by_contra hn
      exact hi (by simp [uniform,hn])
    exact hA i hm
  · intro e
    have hr : (∑ i ∈ A, (digit i e : ℝ)) = (q : ℝ) * m e := by
      exact_mod_cast hc e
    calc
      (∑ i, uniform A q i * (digit i e : ℝ)) =
          (1 / (q : ℝ)) * ∑ i ∈ A, (digit i e : ℝ) := by
        simp [uniform,ite_mul,Finset.mul_sum]
      _ = m e := by rw [hr]; field_simp

lemma uniform_cost (A : Finset I) (q : ℕ) :
    (∑ i, uniform A q i) = (A.card : ℝ) / q := by
  simp [uniform,div_eq_mul_inv]

def coverS : Finset I := {0,11,15,22,33,35}
def coverT : Finset I := {0,11,18,27,43,49}
def coverU : Finset I := {1,4,6,15,22,27,31,33,39,46}
def coverJ : Finset I := {0,11,61}

def star : Finset E := {0,3,4}
lemma star_bound (i : I) : ∑ e ∈ star, digit i e ≤ 2 := by revert i; decide
lemma length_bound (i : I) : ∑ e : E, digit i e ≤ 9 := by revert i; decide

noncomputable def starDual (e : E) : ℝ := if e ∈ star then 1/2 else 0
lemma starDual_feasible (i : I) : ∑ e, starDual e * (digit i e : ℝ) ≤ 1 := by
  have hh : (∑ e ∈ star, (digit i e : ℝ)) ≤ 2 := by exact_mod_cast star_bound i
  have heq : (∑ e, starDual e * (digit i e : ℝ)) =
      (1/2 : ℝ) * ∑ e ∈ star, (digit i e : ℝ) := by
    simp [starDual,ite_mul,Finset.mul_sum]
  rw [heq]
  linarith

lemma star_lower (R : Finset (Fin 5)) (hR : ∑ e ∈ star, state R e = 6)
    (w : I → ℝ) (hw : FractionalCover (state R) w) : 3 ≤ ∑ i, w i := by
  have hd := weak_duality (state R) w hw starDual starDual_feasible
  have hh : (∑ e ∈ star, (state R e : ℝ)) = 6 := by exact_mod_cast hR
  have heq : (∑ e, starDual e * (state R e : ℝ)) = 3 := by
    calc
      _ = (1/2 : ℝ) * ∑ e ∈ star, (state R e : ℝ) := by
        simp [starDual,ite_mul,Finset.mul_sum]
      _ = 3 := by rw [hh]; norm_num
  rwa [heq] at hd

lemma exact_S : ExactCost (state S) 3 := by
  constructor
  · refine ⟨uniform coverS 2,uniform_cover _ _ _ (by decide) ?_ ?_,?_⟩
    · decide
    · decide
    · rw [uniform_cost,show coverS.card = 6 from by decide]; norm_num
  · exact fun w hw => star_lower S (by decide) w hw

lemma exact_T : ExactCost (state T) 3 := by
  constructor
  · refine ⟨uniform coverT 2,uniform_cover _ _ _ (by decide) ?_ ?_,?_⟩
    · decide
    · decide
    · rw [uniform_cost,show coverT.card = 6 from by decide]; norm_num
  · exact fun w hw => star_lower T (by decide) w hw

lemma exact_inter : ExactCost (state (S ∩ T)) 3 := by
  constructor
  · refine ⟨uniform coverJ 1,uniform_cover _ _ _ (by decide) ?_ ?_,?_⟩
    · decide
    · decide
    · rw [uniform_cost,show coverJ.card = 3 from by decide]; norm_num
  · exact fun w hw => star_lower (S ∩ T) (by decide) w hw

lemma exact_union : ExactCost (state (S ∪ T)) (10/3) := by
  rw [union_eq]
  constructor
  · refine ⟨uniform coverU 3,uniform_cover _ _ _ (by decide) ?_ ?_,?_⟩
    · decide
    · decide
    · rw [uniform_cost,show coverU.card = 10 from by decide]; norm_num
  · intro w hw
    have hd := weak_duality (state Finset.univ) w hw (fun _ => 1/9) (by
      intro i
      have hh : (∑ e : E, (digit i e : ℝ)) ≤ 9 := by exact_mod_cast length_bound i
      rw [← Finset.mul_sum]
      linarith)
    norm_num [state_full] at hd
    exact hd

lemma ExactCost.unique {m : Multiplicity} {a b : ℝ}
    (ha : ExactCost m a) (hb : ExactCost m b) : a = b := by
  obtain ⟨w,hw,hwa⟩ := ha.1
  obtain ⟨z,hz,hzb⟩ := hb.1
  have hab := ha.2 z hz
  have hba := hb.2 w hw
  rw [hwa] at hba
  rw [hzb] at hab
  exact le_antisymm hab hba

/-- Every exact-cost function has the displayed strict violation. The four
attained costs, not a conditional existence assumption, are proved above. -/
theorem not_submodular (f : Finset (Fin 5) → ℝ)
    (hf : ∀ R, ExactCost (state R) (f R)) :
    ¬ f (S ∪ T) + f (S ∩ T) ≤ f S + f T := by
  have hs := (hf S).unique exact_S
  have ht := (hf T).unique exact_T
  have hu := (hf (S ∪ T)).unique exact_union
  have hj := (hf (S ∩ T)).unique exact_inter
  rw [hs,ht,hu,hj]
  norm_num

/-- All four fractional optima are attained, and their explicit values
violate submodularity on this minimum five-piece partition. -/
theorem exact_counterexample :
    IsPartition [pieces 0,pieces 1,pieces 2,pieces 3,pieces 4] ∧
    (∀ D : List I, IsPartition D → 5 ≤ D.length) ∧
    ExactCost (state S) 3 ∧ ExactCost (state T) 3 ∧
    ExactCost (state (S ∪ T)) (10/3) ∧ ExactCost (state (S ∩ T)) 3 ∧
    (3 : ℝ) + 3 < 10/3 + 3 := by
  exact ⟨minimum_partition,partition_minimal,exact_S,exact_T,exact_union,
    exact_inter,by norm_num⟩

end Erdos184.PetersenSubfamilyFractional
