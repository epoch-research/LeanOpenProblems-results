import Submission.CyclePairCertificate

/-! Explicit two-cycle certificates for normalized count-three attachment cases.
Finite data only; arbitrary-graph classification and transport are separate. -/
open SimpleGraph
namespace Erdos184.CountThreeAttachmentData
open CyclePairCertificate

set_option maxHeartbeats 10000000
set_option maxRecDepth 50000

structure Model where
  girth : ℕ
  outsideOrder : ℕ
  base : Finset (Sym2 (Fin 11))
  outsidePairs : List (ℕ × ℕ)
  options : List (List (Finset (Fin 4)))

structure CycleData where
  size : ℕ
  vertex : Fin (size+3) → Fin 11

structure Certificate where
  config : List (Finset (Fin 4))
  first : CycleData
  second : CycleData

