def fullEdges (m : Model) (config : List (Finset (Fin 4))) : Finset (Sym2 (Fin 11)) :=
  m.base ∪ (Finset.range m.outsideOrder).biUnion (fun i =>
    (config.getD i ∅).image (fun c => s((Fin.ofNat 11 c.val),(Fin.ofNat 11 (m.girth+i)))))

def valid (m : Model) (config : List (Finset (Fin 4))) : Bool :=
  (List.range m.girth).all (fun c => decide ((config.countP (fun r => decide ((Fin.ofNat 4 c) ∈ r))) = 2)) &&
  (if m.girth = 4 then m.outsidePairs.all (fun e =>
    decide (Disjoint (config.getD e.1 ∅) (config.getD e.2 ∅))) else true)

def enumerate (m : Model) (pre : List (Finset (Fin 4))) :
    List (List (Finset (Fin 4))) → List (List (Finset (Fin 4)))
  | [] => if valid m pre.reverse then [pre.reverse] else []
  | choices :: rest => choices.flatMap (fun row => enumerate m (row :: pre) rest)

def configs (m : Model) := enumerate m [] m.options

def checkCertificate (m : Model) (c : Certificate) : Bool :=
  decide (Function.Injective c.first.vertex ∧ Function.Injective c.second.vertex ∧
    Disjoint (cycleEdges c.first.vertex) (cycleEdges c.second.vertex) ∧
    cycleEdges c.first.vertex ∪ cycleEdges c.second.vertex = fullEdges m c.config)

end Erdos184.CountThreeAttachmentData
