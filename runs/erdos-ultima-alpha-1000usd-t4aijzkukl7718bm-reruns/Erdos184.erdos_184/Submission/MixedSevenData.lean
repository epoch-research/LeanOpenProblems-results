/- The 32768 choices, packed into fourteen-bit fields. -/
def table : Nat := 

def encode (S : Finset E) : Nat := ∑ e ∈ S, 2^e.val

def decode (n : Nat) : Finset I :=
  if n = 0 then ∅ else
  if h : n ≤ 103 then {⟨n-1,by omega⟩} else
  {⟨((n-104)/103)%103,Nat.mod_lt _ (by decide)⟩,
   ⟨(n-104)%103,Nat.mod_lt _ (by decide)⟩}

def pack (S : Finset E) : Finset I := decode ((table >>> (14 * encode S)) % 16384)

def Valid (S : Finset E) : Prop :=
  (∀ i ∈ pack S, cyc i ⊆ S) ∧
  (∀ i ∈ pack S, ∀ j ∈ pack S, i ≠ j → Disjoint (cyc i) (cyc j)) ∧
  S.card ≤ 6 + ∑ i ∈ pack S, ((cyc i).card-1)

instance (S : Finset E) : Decidable (Valid S) := inferInstanceAs (Decidable (_ ∧ _ ∧ _))

