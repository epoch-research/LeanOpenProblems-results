/-- In the nonzero reflected-slope branch, the coefficient equations force
an impossible rational fifth root of eight. -/
private theorem coefficients_force_eighth (a c d e u : ℚ) (hu : u ≠ 0)
    (h0 : f0 a c d e u = 0) (h1 : f1 a c d e u = 0)
    (h2 : f2 a c d e u = 0) (h3 : f3 a c d e u = 0)
    (h4 : f4 a c d e u = 0) (h5 : f5 a c d e u = 0) : e^5 = 8 := by
  have hd : d = 0 := (mul_eq_zero.mp (force_zero_d a c d e u h0 h1 h2 h3 h4 h5)).resolve_right
    (pow_ne_zero 2 hu)
  subst d
  dsimp only [f0, f1, f2, f3, f4, f5] at h0 h1 h2 h3 h4 h5
  have ha5 : a^5 = (2 : ℚ)^5 := by norm_num at h5 ⊢; linarith
  have ha : a = 2 := (show Odd 5 by decide).pow_injective ha5
  subst a
  norm_num at h0 h1 h2 h3 h4 h5
  have hcu : c + u - 3 = 0 := by linarith [h4]
  have hc3 : c^3 = (-1 : ℚ)^3 := by
    norm_num
    linear_combination h1 / 60 - c^3 * hcu / 3
  have hc : c = -1 := (show Odd 3 by decide).pow_injective hc3
  subst c
  norm_num at h0
  linarith

private theorem no_fifth_eight (e : ℚ) : e^5 ≠ 8 := by
  intro he
  have he0 : e ≠ 0 := by intro hz; simp [hz] at he
  have hv := congrArg (padicValRat 2) he
  have htwo : padicValRat 2 (2 : ℚ) = 1 := padicValRat.self (by decide)
  have hv8 : padicValRat 2 (8 : ℚ) = 3 := by
    rw [show (8 : ℚ) = 2^3 by norm_num,
      padicValRat.pow (by norm_num : (2 : ℚ) ≠ 0), htwo]
    norm_num
  rw [padicValRat.pow he0, hv8] at hv
  omega

private instance : Fact (Nat.Prime 3) := ⟨by decide⟩

private theorem no_fifth_three_six (x : ℚ) : x^5 ≠ 3 ∧ x^5 ≠ 6 := by
  have hv3 : padicValRat 3 (3 : ℚ) = 1 := padicValRat.self (by decide)
  have hv2 : padicValRat 3 (2 : ℚ) = 0 := by
    change padicValRat 3 (↑(2 : ℕ) : ℚ) = 0
    rw [padicValRat.of_nat, padicValNat.eq_zero_of_not_dvd (by decide : ¬3 ∣ 2)]
    rfl
  have hv6 : padicValRat 3 (6 : ℚ) = 1 := by
    rw [show (6 : ℚ) = 2*3 by norm_num,
      padicValRat.mul (by norm_num : (2 : ℚ) ≠ 0) (by norm_num : (3 : ℚ) ≠ 0),
      hv2, hv3]
    norm_num
  constructor
  · intro h
    have hx : x ≠ 0 := by intro hz; simp [hz] at h
    have hv := congrArg (padicValRat 3) h
    rw [padicValRat.pow hx, hv3] at hv
    omega
  · intro h
    have hx : x ≠ 0 := by intro hz; simp [hz] at h
    have hv := congrArg (padicValRat 3) h
    rw [padicValRat.pow hx, hv6] at hv
    omega

private theorem even_coefficients_impossible (a c d e : ℚ)
    (h0 : f0 a c d e 0 = 0) (h1 : f1 a c d e 0 = 0)
    (h2 : f2 a c d e 0 = 0) (h5 : f5 a c d e 0 = 0) : False := by
  dsimp only [f0, f1, f2, f5] at h0 h1 h2 h5
  norm_num at h0 h1 h2 h5
  have g0 : 2*c^4*(a+2*c)+e^4*(d+2*e) = 0 := by
    linear_combination 2*h0+h1/5
  have g1 : 2*a*c^3*(a+2*c)+d*e^3*(d+2*e) = 0 := by
    linear_combination (4*h1+h2)/10
  have hdet : a*e-c*d ≠ 0 := by
    intro hz
    have ha : a+2*c = 0 := by
      linear_combination (c*g0-(a+2*c)*h0+e^4*hz)/6
    have hd : d+2*e = 0 := by
      linear_combination (e*g0-(d+2*e)*h0-2*c^4*hz)/6
    have ha' : a = -2*c := by linarith
    have hd' : d = -2*e := by linarith
    rw [ha', hd'] at h5
    have hbad : (256 : ℚ) = 0 := by linear_combination -h5 - 32*h0
    norm_num at hbad
  have hce : c = 0 ∨ e = 0 := by
    by_contra h
    push_neg at h
    have hdprod : e^3*(d+2*e)*(a*e-c*d) = 0 := by
      linear_combination a*g0-c*g1
    have haprod : (2*c^3)*(a+2*c)*(a*e-c*d) = 0 := by
      linear_combination e*g1-d*g0
    have hd : d+2*e = 0 :=
      (mul_eq_zero.mp ((mul_eq_zero.mp hdprod).resolve_right hdet)).resolve_left
        (pow_ne_zero 3 h.2)
    have ha : a+2*c = 0 :=
      (mul_eq_zero.mp ((mul_eq_zero.mp haprod).resolve_right hdet)).resolve_left
        (mul_ne_zero (by norm_num) (pow_ne_zero 3 h.1))
    apply hdet
    linear_combination e*ha-c*hd
  rcases hce with hc | he
  · rw [hc] at h0
    norm_num at h0
    exact (no_fifth_three_six e).2 (by linarith)
  · rw [he] at h0
    norm_num at h0
    exact (no_fifth_three_six c).1 (by linarith)

private def residual (a b c d e : ℚ) : ℚ[X] :=
  (C a*X^2+C b*X+C c)^5+(C a*X^2-C b*X+C c)^5+
    (C d*X^2+C e)^5-6*(1-2*X^2)^5-8*(2*X^2)^5

private theorem residual_expansion (a b c d e : ℚ) :
    residual a b c d e =
      C (f0 a c d e (b^2)) + C (f1 a c d e (b^2))*X^2 +
      C (f2 a c d e (b^2))*X^4 + C (f3 a c d e (b^2))*X^6 +
      C (f4 a c d e (b^2))*X^8 + C (f5 a c d e (b^2))*X^10 := by
  simp only [residual, f0, f1, f2, f3, f4, f5, map_add, map_sub, map_mul,
    map_pow, map_ofNat]
  ring

/-- The two weighted terms cannot jointly be replaced by a rational reflected
pair and an even quadratic. Zero reflected slopes are included. No positivity
assumption is needed, and the other coefficient patterns are not covered. -/
theorem no_reflected_joint_identity (a b c d e : ℚ) :
    ¬ (∀ t : ℚ, (a*t^2+b*t+c)^5+(a*t^2-b*t+c)^5+(d*t^2+e)^5 =
      6*(1-2*t^2)^5+8*(2*t^2)^5) := by
  intro h
  have hp : residual a b c d e = 0 := by
    apply Polynomial.funext
    intro t
    simpa [residual, sub_sub] using sub_eq_zero.mpr (h t)
  have hh (j : ℕ) := congrArg (fun p : ℚ[X] => p.coeff j) hp
  have h0 := hh 0
  have h1 := hh 2
  have h2 := hh 4
  have h3 := hh 6
  have h4 := hh 8
  have h5 := hh 10
  dsimp only at h0 h1 h2 h3 h4 h5
  rw [residual_expansion] at h0 h1 h2 h3 h4 h5
  simp only [coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, coeff_zero]
    at h0 h1 h2 h3 h4 h5
  norm_num at h0 h1 h2 h3 h4 h5
  by_cases hb : b = 0
  · subst b
    norm_num only [zero_pow (by decide : 2 ≠ 0)] at h0 h1 h2 h5
    exact even_coefficients_impossible a c d e h0 h1 h2 h5
  · exact no_fifth_eight e (coefficients_force_eighth a c d e (b^2)
      (pow_ne_zero 2 hb) h0 h1 h2 h3 h4 h5)

end
