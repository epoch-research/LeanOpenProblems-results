def dense {R : Type*} [CommRing R] {m : ℕ} (a : Fin m → R) : R[X] :=
  ∑ i : Fin m, monomial (i : ℕ) (a i)

theorem dense_mul_coeff {R : Type*} [CommRing R] {m n : ℕ}
    (a : Fin m → R) (b : Fin n → R) (k : ℕ) :
    (dense a * dense b).coeff k =
      ∑ i : Fin m, ∑ j : Fin n, if (i : ℕ)+(j : ℕ)=k then a i*b j else 0 := by
  simp [dense, Finset.sum_mul, Finset.mul_sum, finset_sum_coeff, monomial_mul_monomial,
    coeff_monomial, eq_comm]
  rw [Finset.sum_comm]


def conv {R : Type*} [CommRing R] (a : Fin 9 → R) (f : Fin 11 → R)
    (b g : Fin 10 → R) (k : ℕ) : R :=
  (∑ i : Fin 9, ∑ j : Fin 11, if (i : ℕ)+(j : ℕ)=k then a i*f j else 0)+
  (∑ i : Fin 10, ∑ j : Fin 10, if (i : ℕ)+(j : ℕ)=k then b i*g j else 0)


theorem combine {R : Type*} [CommRing R] (a : Fin 9 → R) (f : Fin 11 → R)
    (b g : Fin 10 → R) (T v : R)
    (h : ∀ k : Fin 19, conv a f b g k = if (k : ℕ)=0 then T else 0) :
    (∑ i, a i*v^(i : ℕ))*(∑ j, f j*v^(j : ℕ))+
      (∑ i, b i*v^(i : ℕ))*(∑ j, g j*v^(j : ℕ)) = T := by
  have hp : dense a*dense f+dense b*dense g = C T := by
    ext k
    rw [coeff_add, dense_mul_coeff, dense_mul_coeff, coeff_C]
    by_cases hk : k < 19
    · exact h ⟨k,hk⟩
    · have ha : ∀ (i : Fin 9) (j : Fin 11), (i : ℕ)+(j : ℕ)≠k := by
        intro i j; omega
      have hb : ∀ (i j : Fin 10), (i : ℕ)+(j : ℕ)≠k := by
        intro i j; omega
      have hk0 : k ≠ 0 := by omega
      simp [ha, hb, hk0]
  have he := congrArg (Polynomial.eval v) hp
  simpa [dense, eval_finset_sum, eval_monomial] using he


