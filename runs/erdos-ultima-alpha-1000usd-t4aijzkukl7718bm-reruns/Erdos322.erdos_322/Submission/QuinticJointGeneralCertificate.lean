/-- The eleven coefficient equations force an even quadratic. -/
theorem one_linear_coefficient_zero (a0 b0 c0 a1 b1 c1 a2 b2 c2 : ℚ)
    (h0 : f0 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h1 : f1 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h2 : f2 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h3 : f3 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h4 : f4 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h5 : f5 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h6 : f6 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h7 : f7 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h8 : f8 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h9 : f9 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    (h10 : f10 a0 b0 c0 a1 b1 c1 a2 b2 c2 = 0)
    : b0 = 0 ∨ b1 = 0 ∨ b2 = 0 := by
  have hf (q : Fin 11) : g q (a0,b0,c0) + g q (a1,b1,c1) + g q (a2,b2,c2) + w q = 0 := by
    fin_cases q
    · change g 0 (a0,b0,c0) + g 0 (a1,b1,c1) + g 0 (a2,b2,c2) + w 0 = 0
      simp only [g_0, w_0]
      dsimp only [f0] at h0
      linear_combination h0
    · change g 1 (a0,b0,c0) + g 1 (a1,b1,c1) + g 1 (a2,b2,c2) + w 1 = 0
      simp only [g_1, w_1]
      dsimp only [f1] at h1
      linear_combination h1
    · change g 2 (a0,b0,c0) + g 2 (a1,b1,c1) + g 2 (a2,b2,c2) + w 2 = 0
      simp only [g_2, w_2]
      dsimp only [f2] at h2
      linear_combination h2
    · change g 3 (a0,b0,c0) + g 3 (a1,b1,c1) + g 3 (a2,b2,c2) + w 3 = 0
      simp only [g_3, w_3]
      dsimp only [f3] at h3
      linear_combination h3
    · change g 4 (a0,b0,c0) + g 4 (a1,b1,c1) + g 4 (a2,b2,c2) + w 4 = 0
      simp only [g_4, w_4]
      dsimp only [f4] at h4
      linear_combination h4
    · change g 5 (a0,b0,c0) + g 5 (a1,b1,c1) + g 5 (a2,b2,c2) + w 5 = 0
      simp only [g_5, w_5]
      dsimp only [f5] at h5
      linear_combination h5
    · change g 6 (a0,b0,c0) + g 6 (a1,b1,c1) + g 6 (a2,b2,c2) + w 6 = 0
      simp only [g_6, w_6]
      dsimp only [f6] at h6
      linear_combination h6
    · change g 7 (a0,b0,c0) + g 7 (a1,b1,c1) + g 7 (a2,b2,c2) + w 7 = 0
      simp only [g_7, w_7]
      dsimp only [f7] at h7
      linear_combination h7
    · change g 8 (a0,b0,c0) + g 8 (a1,b1,c1) + g 8 (a2,b2,c2) + w 8 = 0
      simp only [g_8, w_8]
      dsimp only [f8] at h8
      linear_combination h8
    · change g 9 (a0,b0,c0) + g 9 (a1,b1,c1) + g 9 (a2,b2,c2) + w 9 = 0
      simp only [g_9, w_9]
      dsimp only [f9] at h9
      linear_combination h9
    · change g 10 (a0,b0,c0) + g 10 (a1,b1,c1) + g 10 (a2,b2,c2) + w 10 = 0
      simp only [g_10, w_10]
      dsimp only [f10] at h10
      linear_combination h10
  have hz := JointFramework.certificate coeff mon g w D (4 : Fin 15)
    coeff_swap01 coeff_swap12 high_all low_all (a0,b0,c0) (a1,b1,c1) (a2,b2,c2) hf
  have he : D * mon 4 (a0,b0,c0) * mon 4 (a1,b1,c1) * mon 4 (a2,b2,c2) = D*(b0*b1*b2)^4 := by
    simp only [mon_4]
    ring
  rw [he] at hz
  have hp : (b0*b1*b2)^4 = 0 := (mul_eq_zero.mp hz).resolve_left (by norm_num [D])
  have hb : b0*b1*b2 = 0 := pow_eq_zero hp
  simpa only [mul_eq_zero, or_assoc] using hb

end Erdos322Research.QuinticJointGeneralCertificate
