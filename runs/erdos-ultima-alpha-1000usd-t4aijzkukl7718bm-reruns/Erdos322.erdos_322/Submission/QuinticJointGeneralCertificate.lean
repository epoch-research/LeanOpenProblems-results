import FormalConjecturesUtil

/-! A tensor-structured exact certificate for the three-quadratic quintic absorption model.
This is a restricted construction obstruction, not a representation-count bound. -/
namespace Erdos322Research.QuinticJointGeneralCertificate
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
namespace JointFramework
open Finset
variable {I J V : Type*} [Fintype I] [Fintype J]

def contract (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (q : J) (x y z : V) : ℚ :=
  ∑ i, ∑ j, ∑ k, c q i j k * m i x * m j y * m k z

theorem contract_swap01 (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (hc : ∀ q i j k, c q i j k = c q j i k) (q : J) (x y z : V) :
    contract c m q x y z = contract c m q y x z := by
  unfold contract
  rw [sum_comm]
  apply sum_congr rfl
  intro j _
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro k _
  rw [hc q i j k]
  ring

theorem contract_swap12 (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (hc : ∀ q i j k, c q i j k = c q i k j) (q : J) (x y z : V) :
    contract c m q x y z = contract c m q x z y := by
  unfold contract
  apply sum_congr rfl
  intro i _
  rw [sum_comm]
  apply sum_congr rfl
  intro j _
  apply sum_congr rfl
  intro k _
  rw [hc q i k j]
  ring

theorem contract_mul_sum (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (w : J → ℚ) (x y z : V) :
    (∑ q, contract c m q x y z * w q) =
      ∑ j, ∑ k, (∑ q, ∑ i, c q i j k * m i x * w q) * m j y * m k z := by
  unfold contract
  simp_rw [sum_mul]
  rw [sum_comm]
  conv_lhs =>
    arg 2
    ext i
    rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro j _
  conv_lhs =>
    arg 2
    ext i
    rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro k _
  rw [sum_comm]
  apply sum_congr rfl
  intro q _
  apply sum_congr rfl
  intro i _
  ring

theorem contract_g_zero (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (g : J → V → ℚ)
    (h : ∀ j k x, (∑ q, ∑ i, c q i j k * m i x * g q x) = 0)
    (x y z : V) : (∑ q, contract c m q x y z * g q x) = 0 := by
  rw [contract_mul_sum]
  simp_rw [h]
  simp

theorem contract_const (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (w : J → ℚ) (D : ℚ) (b : I) [DecidableEq I]
    (h : ∀ j k x, (∑ q, ∑ i, c q i j k * m i x * w q) =
      if j = b ∧ k = b then D * m b x else 0)
    (x y z : V) : (∑ q, contract c m q x y z * w q) =
      D * m b x * m b y * m b z := by
  rw [contract_mul_sum]
  simp_rw [h]
  simp only [ite_and, ite_mul, zero_mul]
  simp

/-- A finite tensor certificate, checked one contraction at a time. -/
theorem certificate (c : J → I → I → I → ℚ) (m : I → V → ℚ)
    (g : J → V → ℚ) (w : J → ℚ) (D : ℚ) (b : I) [DecidableEq I]
    (hc01 : ∀ q i j k, c q i j k = c q j i k)
    (hc12 : ∀ q i j k, c q i j k = c q i k j)
    (hg : ∀ j k x, (∑ q, ∑ i, c q i j k * m i x * g q x) = 0)
    (hw : ∀ j k x, (∑ q, ∑ i, c q i j k * m i x * w q) =
      if j = b ∧ k = b then D * m b x else 0)
    (x y z : V)
    (hf : ∀ q, g q x + g q y + g q z + w q = 0) :
    D * m b x * m b y * m b z = 0 := by
  have H : (∑ q, contract c m q x y z *
      (g q x + g q y + g q z + w q)) = 0 := by
    simp_rw [hf, mul_zero]
    simp
  simp only [mul_add, sum_add_distrib] at H
  have h0 := contract_g_zero c m g hg x y z
  have h1 : (∑ q, contract c m q x y z * g q y) = 0 := by
    conv_lhs =>
      arg 2
      ext q
      rw [contract_swap01 c m hc01 q x y z]
    exact contract_g_zero c m g hg y x z
  have h2 : (∑ q, contract c m q x y z * g q z) = 0 := by
    conv_lhs =>
      arg 2
      ext q
      rw [contract_swap12 c m hc12 q x y z, contract_swap01 c m hc01 q x z y]
    exact contract_g_zero c m g hg z x y
  rw [h0, h1, h2, contract_const c m w D b hw] at H
  simpa using H

end JointFramework

