set_option maxRecDepth 2000000
set_option maxHeartbeats 0
def my_nats : Array Nat := #[
,
0]

def fast_sqrt (n : Nat) : Nat :=
  let rec loop (low high : Nat) (fuel : Nat) : Nat :=
    match fuel with
    | 0 => low
    | f + 1 =>
      if low <= high then
        let mid := (low + high) >>> 1
        let sq := mid * mid
        if sq == n then mid
        else if sq < n then loop (mid + 1) high f
        else if mid == 0 then 0 else loop low (mid - 1) f
      else high
  loop 0 7746 14

def process_tree (n : Nat) (bits : Nat) (fuel : Nat) : Nat :=
  match fuel with
  | 0 => n
  | f + 1 =>
    if bits <= 1 then
      let val := (n &&& 0xFF) * 10000
      fast_sqrt val
    else
      let half := bits / 2
      let mask := (1 <<< (half * 8)) - 1
      let low := n &&& mask
      let high := n >>> (half * 8)
      process_tree low half f + process_tree high (bits - half) f

def test_arr : Bool :=
  let rec loop (i : Nat) (acc : Nat) (fuel : Nat) : Nat :=
    match fuel with
    | 0 => acc
    | f + 1 =>
      if h : i < my_nats.size then
        loop (i + 1) (acc + process_tree my_nats[i] 5000 20) f
      else acc
  loop 0 0 2 == loop 0 0 2

theorem test : test_arr = true := by decide
