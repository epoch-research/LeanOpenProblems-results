def check_chunk (n : Nat) : Bool :=
  let rec loop (chunk : Nat) (acc : Nat) (fuel : Nat) : Nat :=
    match fuel with
    | 0 => acc
    | f + 1 => loop (chunk >>> 30) (acc + (chunk &&& 0x3FFFFFFF)) f
  loop n 0 100 == loop n 0 100
