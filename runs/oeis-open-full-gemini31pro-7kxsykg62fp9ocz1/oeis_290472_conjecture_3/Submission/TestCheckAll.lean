def test_arr : Bool :=
  let rec loop_tree (start len : Nat) (fuel : Nat) : Nat :=
    match fuel with
    | 0 => if start < my_hints.size then my_hints[start]! else 0
    | f + 1 =>
      if len <= 1 then
        if start < my_hints.size then my_hints[start]! else 0
      else
        let half := len / 2
        loop_tree start half f + loop_tree (start + half) (len - half) f
  loop_tree 0 10000 15 == loop_tree 0 10000 15

theorem test : test_arr = true := by decide
