def my_huge_nat : Nat := 

def process_tree (n : Nat) (bits : Nat) (fuel : Nat) : Nat :=
  match fuel with
  | 0 => n
  | f + 1 =>
    if bits <= 1 then
      n &&& 0xF
    else
      let half := bits / 2
      let mask := (1 <<< (half * 4)) - 1
      let low := n &&& mask
      let high := n >>> (half * 4)
      process_tree low half f + process_tree high (bits - half) f

def test_nat : Bool :=
  process_tree my_huge_nat 65536 20 == process_tree my_huge_nat 65536 20

theorem test : test_nat = true := by decide
