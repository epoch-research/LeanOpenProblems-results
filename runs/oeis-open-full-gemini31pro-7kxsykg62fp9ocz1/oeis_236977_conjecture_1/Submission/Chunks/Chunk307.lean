def check_chunk_307 (n : Nat) : Bool :=
  let k := get_k_307 k_data_bytes_307 (n - 1535009)
  k ≥ 1 && k < (n - 1) / 2 + 1 && exact_a_307 n k

def check_rec_307 (n stop : Nat) : Bool :=
  if h : n < stop then
    check_chunk_307 n && check_rec_307 (n + 1) stop
  else true
termination_by stop - n

lemma check_rec_307_implies (d : Nat) (n stop : Nat) (hd : stop - n = d) :
  check_rec_307 n stop = true → ∀ i, n ≤ i → i < stop → check_chunk_307 i = true := by
  intro h i h1 h2
  induction d generalizing n i
  case zero =>
    omega
  case succ d ih =>
    unfold check_rec_307 at h
    split_ifs at h with hn
    · simp only [Bool.and_eq_true] at h
      rcases h with ⟨hfn, hrec⟩
      rcases eq_or_lt_of_le h1 with rfl | hi
      · exact hfn
      · apply ih (n + 1)
        · omega
        · exact hrec
        · exact hi
        · exact h2
    · omega

lemma chunk_307_test : check_rec_307 1535009 1540009 = true := by native_decide

lemma chunk_307_pos : ∀ n ∈ Ico 1535009 1540009, a n > 0 := by
  intro n hn
  rw [mem_Ico] at hn
  have h := check_rec_307_implies (1540009 - 1535009) 1535009 1540009 rfl chunk_307_test n hn.1 hn.2
  unfold check_chunk_307 at h
  simp only [Bool.and_eq_true] at h
  rcases h with ⟨⟨h1, h2⟩, h3⟩
  apply a_pos_of_witness n (get_k_307 k_data_bytes_307 (n - 1535009))
  · rw [mem_Ico]
    exact ⟨of_decide_eq_true h1, of_decide_eq_true h2⟩
  · exact h3
