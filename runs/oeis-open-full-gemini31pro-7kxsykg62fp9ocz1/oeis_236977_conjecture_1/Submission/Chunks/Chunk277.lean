def check_rec_277 (n stop : Nat) : Bool :=
  if h : n < stop then
    check_chunk_277 n && check_rec_277 (n + 1) stop
  else true
termination_by stop - n

lemma check_rec_277_implies (d : Nat) (n stop : Nat) (hd : stop - n = d) :
  check_rec_277 n stop = true → ∀ i, n ≤ i → i < stop → check_chunk_277 i = true := by
  intro h i h1 h2
  induction d generalizing n i
  case zero =>
    omega
  case succ d ih =>
    unfold check_rec_277 at h
    split_ifs at h with hn
    · simp only [Bool.and_eq_true] at h
      rcases h with ⟨hfn, hrec⟩
      rcases eq_or_lt_of_le h1 with rfl | hi
      · exact hfn
      · apply ih (n + 1)
        · omega
        · exact hrec
        · exact hi
        · exact h2
    · omega

