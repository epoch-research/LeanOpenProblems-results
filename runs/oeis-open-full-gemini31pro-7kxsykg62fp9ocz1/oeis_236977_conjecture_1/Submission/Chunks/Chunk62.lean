def k_data_bytes_62 : ByteArray := k_data_62.toUTF8

def check_chunk_62 (n : Nat) : Bool :=
  let k := get_k_62 k_data_bytes_62 (n - 310009)
  k ≥ 1 && k < (n - 1) / 2 + 1 && exact_a_62 n k

def check_rec_62 (n stop : Nat) : Bool :=
  if h : n < stop then
    check_chunk_62 n && check_rec_62 (n + 1) stop
  else true
termination_by stop - n

lemma check_rec_62_implies (d : Nat) (n stop : Nat) (hd : stop - n = d) :
  check_rec_62 n stop = true → ∀ i, n ≤ i → i < stop → check_chunk_62 i = true := by
  intro h i h1 h2
  induction d generalizing n i
  case zero =>
    omega
  case succ d ih =>
    unfold check_rec_62 at h
    split_ifs at h with hn
    · simp only [Bool.and_eq_true] at h
      rcases h with ⟨hfn, hrec⟩
      rcases eq_or_lt_of_le h1 with rfl | hi
      · exact hfn
      · apply ih (n + 1)
        · omega
        · exact hrec
        · exact hi
        · exact h2
    · omega

lemma chunk_62_test : check_rec_62 310009 315009 = true := by native_decide

lemma chunk_62_pos : ∀ n ∈ Ico 310009 315009, a n > 0 := by
  intro n hn
  rw [mem_Ico] at hn
  have h := check_rec_62_implies (315009 - 310009) 310009 315009 rfl chunk_62_test n hn.1 hn.2
  unfold check_chunk_62 at h
  simp only [Bool.and_eq_true] at h
  rcases h with ⟨⟨h1, h2⟩, h3⟩
  apply a_pos_of_witness n (get_k_62 k_data_bytes_62 (n - 310009))
  · rw [mem_Ico]
    exact ⟨of_decide_eq_true h1, of_decide_eq_true h2⟩
  · exact h3
