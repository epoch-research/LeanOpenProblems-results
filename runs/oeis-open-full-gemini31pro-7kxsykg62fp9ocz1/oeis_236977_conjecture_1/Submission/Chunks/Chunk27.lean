def k_data_bytes_27 : ByteArray := k_data_27.toUTF8

def check_chunk_27 (n : Nat) : Bool :=
  let k := get_k_27 k_data_bytes_27 (n - 135009)
  k ≥ 1 && k < (n - 1) / 2 + 1 && exact_a_27 n k

def check_rec_27 (n stop : Nat) : Bool :=
  if h : n < stop then
    check_chunk_27 n && check_rec_27 (n + 1) stop
  else true
termination_by stop - n

lemma check_rec_27_implies (d : Nat) (n stop : Nat) (hd : stop - n = d) :
  check_rec_27 n stop = true → ∀ i, n ≤ i → i < stop → check_chunk_27 i = true := by
  intro h i h1 h2
  induction d generalizing n i
  case zero =>
    omega
  case succ d ih =>
    unfold check_rec_27 at h
    split_ifs at h with hn
    · simp only [Bool.and_eq_true] at h
      rcases h with ⟨hfn, hrec⟩
      rcases eq_or_lt_of_le h1 with rfl | hi
      · exact hfn
      · apply ih (n + 1)
        · omega
        · exact hrec
        · exact hi
        · exact h2
    · omega

lemma chunk_27_test : check_rec_27 135009 140009 = true := by native_decide

lemma chunk_27_pos : ∀ n ∈ Ico 135009 140009, a n > 0 := by
  intro n hn
  rw [mem_Ico] at hn
  have h := check_rec_27_implies (140009 - 135009) 135009 140009 rfl chunk_27_test n hn.1 hn.2
  unfold check_chunk_27 at h
  simp only [Bool.and_eq_true] at h
  rcases h with ⟨⟨h1, h2⟩, h3⟩
  apply a_pos_of_witness n (get_k_27 k_data_bytes_27 (n - 135009))
  · rw [mem_Ico]
    exact ⟨of_decide_eq_true h1, of_decide_eq_true h2⟩
  · exact h3
