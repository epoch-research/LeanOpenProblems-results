  rw [mem_Ico] at hn
  have h := check_rec_69_implies (350009 - 345009) 345009 350009 rfl chunk_69_test n hn.1 hn.2
  unfold check_chunk_69 at h
  simp only [Bool.and_eq_true] at h
  rcases h with ⟨⟨h1, h2⟩, h3⟩
  apply a_pos_of_witness n (get_k_69 k_data_bytes_69 (n - 345009))
  · rw [mem_Ico]
    exact ⟨of_decide_eq_true h1, of_decide_eq_true h2⟩
  · exact h3
