  have h := check_rec_226_implies (1135009 - 1130009) 1130009 1135009 rfl chunk_226_test n hn.1 hn.2
  unfold check_chunk_226 at h
  simp only [Bool.and_eq_true] at h
  rcases h with ⟨⟨h1, h2⟩, h3⟩
  apply a_pos_of_witness n (get_k_226 k_data_bytes_226 (n - 1130009))
  · rw [mem_Ico]
    exact ⟨of_decide_eq_true h1, of_decide_eq_true h2⟩
  · exact h3
