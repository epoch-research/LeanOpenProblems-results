def check_chunk_226 (n : Nat) : Bool :=
  let k := get_k_226 k_data_bytes_226 (n - 1130009)
  k ≥ 1 && k < (n - 1) / 2 + 1 && exact_a_226 n k

def check_rec_226 (n stop : Nat) : Bool :=
  if h : n < stop then
    check_chunk_226 n && check_rec_226 (n + 1) stop
  else true
termination_by stop - n

lemma check_rec_226_implies (d : Nat) (n stop : Nat) (hd : stop - n = d) :
  check_rec_226 n stop = true → ∀ i, n ≤ i → i < stop → check_chunk_226 i = true := by
  intro h i h1 h2
  induction d generalizing n i
  case zero =>
    omega
  case succ d ih =>
    unfold check_rec_226 at h
    split_ifs at h with hn
    · simp only [Bool.and_eq_true] at h
      rcases h with ⟨hfn, hrec⟩
      rcases eq_or_lt_of_le h1 with rfl | hi
      · exact hfn
      · apply ih (n + 1)
        · omega
        · exact hrec
        · exact hi
        · exact h2
    · omega

lemma chunk_226_test : check_rec_226 1130009 1135009 = true := by native_decide

lemma chunk_226_pos : ∀ n ∈ Ico 1130009 1135009, a n > 0 := by
