open Nat Finset

def decode_char_52 (v : UInt8) : UInt64 :=
  if v >= 65 && v <= 90 then v.toUInt64 - 65
  else if v >= 97 && v <= 122 then v.toUInt64 - 97 + 26
  else if v >= 48 && v <= 57 then v.toUInt64 - 48 + 52
  else if v == 43 then 62
  else if v == 45 then 63
  else 0

def get_k_52 (b : ByteArray) (i : Nat) : Nat :=
  let c1 := decode_char_52 (b.get! (3 * i))
  let c2 := decode_char_52 (b.get! (3 * i + 1))
  let c3 := decode_char_52 (b.get! (3 * i + 2))
  (c1 * 4096 + c2 * 64 + c3).toNat

def exact_a_52 (n k : ℕ) : Bool :=
  let m := totient k * totient (n - k)
  let s := sqrt m
  s * s == m

