  (y1*y2*y3*y4 + y1*y2*y3*y5 + y1*y2*y3*y6 + y1*y2*y4*y5 + y1*y2*y4*y6 + y1*y2*y5*y6 + y1*y3*y4*y5 + y1*y3*y4*y6 + y1*y3*y5*y6 + y1*y4*y5*y6 + y2*y3*y4*y5 + y2*y3*y4*y6 + y2*y3*y5*y6 + y2*y4*y5*y6 + y3*y4*y5*y6) * X^4 +
