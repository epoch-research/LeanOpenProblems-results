noncomputable def w : ℂ := exp (2 * Real.pi * I / 13)

lemma exp_mul (z : ℂ) (k : ℕ) : exp (k * z) = (exp z)^k := by
  induction k with
  | zero => simp
  | succ n ih =>
    have : (n.succ : ℂ) * z = n * z + z := by
      push_cast
      ring
    rw [this, exp_add, ih, pow_succ]

lemma w_pow (k : ℕ) : w^k = exp (k * 2 * Real.pi * I / 13) := by
  have : (k : ℂ) * (2 * ↑Real.pi * I / 13) = ↑k * 2 * ↑Real.pi * I / 13 := by ring
  rw [w, ← exp_mul, this]

lemma w_pow_13 : w^13 = 1 := by
  rw [w_pow]
  have : (13 : ℂ) * 2 * Real.pi * I / 13 = 2 * Real.pi * I := by ring
  have h_cast : (13 : ℂ) = (13 : ℕ) := by norm_num
  rw [← h_cast]
  rw [this]
  exact Complex.exp_two_pi_mul_I

lemma w_ne_zero : w ≠ 0 := exp_ne_zero _

lemma w_inv_pow_eq (k : ℕ) (h : k ≤ 13) : (w^k)⁻¹ = w^(13 - k) := by
  have H : w^k * w^(13 - k) = 1 := by
    calc w^k * w^(13 - k) = w^(k + (13 - k)) := by rw [← pow_add]
    _ = w^13 := by congr 1; omega
    _ = 1 := w_pow_13
  calc (w^k)⁻¹ = (w^k)⁻¹ * 1 := by ring
  _ = (w^k)⁻¹ * (w^k * w^(13 - k)) := by rw [← H]
  _ = ((w^k)⁻¹ * w^k) * w^(13 - k) := by ring
  _ = 1 * w^(13 - k) := by rw [inv_mul_cancel₀ (pow_ne_zero _ w_ne_zero)]
  _ = w^(13 - k) := by ring

lemma exp_sq (z : ℂ) : (exp z)^2 = exp (2 * z) := by
  have : 2 * z = z + z := by ring
  rw [this, exp_add, sq]

lemma exp_inv_sq (z : ℂ) : (exp z)⁻¹^2 = exp (-2 * z) := by
  have : -2 * z = -z + -z := by ring
  rw [this, exp_add, sq, ← exp_neg]

lemma cos_sq_eq2 (t : ℝ) :
  (4 : ℂ) * (Real.cos t : ℂ)^2 =
  exp (2 * t * I) + exp (-2 * t * I) + 2 := by
  have H1 : (Real.cos t : ℂ) = cos (t : ℂ) := Complex.ofReal_cos t
  rw [H1, Complex.cos]
  have H2 : - (t : ℂ) * I = - (t * I) := by ring
  rw [H2, exp_neg]
  have H3 : exp (↑t * I) * (exp (↑t * I))⁻¹ = 1 := mul_inv_cancel₀ (exp_ne_zero _)
  calc
    4 * ((exp (↑t * I) + (exp (↑t * I))⁻¹) / 2) ^ 2
      = (exp (↑t * I) + (exp (↑t * I))⁻¹) ^ 2 := by ring
    _ = (exp (↑t * I)) ^ 2 + (exp (↑t * I))⁻¹ ^ 2 + 2 * (exp (↑t * I) * (exp (↑t * I))⁻¹) := by ring
    _ = (exp (↑t * I)) ^ 2 + (exp (↑t * I))⁻¹ ^ 2 + 2 := by rw [H3]; ring
    _ = exp (2 * ↑t * I) + exp (-2 * ↑t * I) + 2 := by
      rw [exp_sq, exp_inv_sq]
      have E1 : 2 * (↑t * I) = 2 * ↑t * I := by ring
      have E2 : -2 * (↑t * I) = -2 * ↑t * I := by ring
      rw [E1, E2]

lemma cos_k_eq (k : ℕ) (h : k ≤ 13) :
  (4 : ℂ) * (Real.cos (Real.pi * (k : ℝ) / 13) : ℂ)^2 = w^k + w^(13 - k) + 2 := by
  have := cos_sq_eq2 (Real.pi * (k : ℝ) / 13)
  rw [this]
  have H1 : 2 * (↑(Real.pi * (k : ℝ) / 13) : ℂ) * I = (k : ℂ) * 2 * Real.pi * I / 13 := by
    push_cast
    ring
  have H2 : -2 * (↑(Real.pi * (k : ℝ) / 13) : ℂ) * I = -((k : ℂ) * 2 * Real.pi * I / 13) := by
    push_cast
    ring
  rw [H1, H2]
  rw [← w_pow k]
  have : exp (-((k : ℂ) * 2 * ↑Real.pi * I / 13)) = (exp ((k : ℂ) * 2 * ↑Real.pi * I / 13))⁻¹ := exp_neg _
  rw [this, ← w_pow k]
  rw [w_inv_pow_eq k h]


lemma ofReal_poly_eq {P Q : ℝ[X]} (h : P.map (algebraMap ℝ ℂ) = Q.map (algebraMap ℝ ℂ)) : P = Q :=
  Polynomial.map_injective (algebraMap ℝ ℂ) Complex.ofReal_injective h

lemma w_sub_one_ne_zero : w - 1 ≠ 0 := by
  intro h
  have h1 : w = 1 := sub_eq_zero.mp h
  rw [w, Complex.exp_eq_one_iff] at h1
  rcases h1 with ⟨n, hn⟩
  have hz : 2 * (Real.pi : ℂ) * I ≠ 0 := by
    intro hc
    simp [Complex.I_ne_zero, Real.pi_ne_zero] at hc
  have H : (2 * Real.pi * I / 13) / (2 * Real.pi * I) = ↑n := by
    rw [hn, mul_div_cancel_right₀ _ hz]
  have H2 : (2 * Real.pi * I / 13) / (2 * Real.pi * I) = (1 / 13 : ℂ) := by
    have : 2 * ↑Real.pi * I / 13 = (1 / 13 : ℂ) * (2 * ↑Real.pi * I) := by ring
    rw [this, mul_div_cancel_right₀ _ hz]
  rw [H2] at H
  have H4 : (1 / 13 : ℂ).re = (n : ℂ).re := by rw [H]
  simp at H4
  have H5 : (13⁻¹ : ℝ) = (n : ℝ) := H4
  have H6 : (0 : ℝ) < 13⁻¹ := by norm_num
  have H7 : (13⁻¹ : ℝ) < 1 := by norm_num
  rw [H5] at H6 H7
  have H8 : (0 : ℤ) < n := by exact_mod_cast H6
  have H9 : n < (1 : ℤ) := by exact_mod_cast H7
  linarith

lemma w_sum_12 : w^12 + w^11 + w^10 + w^9 + w^8 + w^7 + w^6 + w^5 + w^4 + w^3 + w^2 + w + 1 = 0 := by
  have h : w^13 - 1 = (w - 1) * (w^12 + w^11 + w^10 + w^9 + w^8 + w^7 + w^6 + w^5 + w^4 + w^3 + w^2 + w + 1) := by ring
  have h2 : w^13 - 1 = 0 := by rw [w_pow_13, sub_self]
  rw [h2] at h
  cases mul_eq_zero.mp h.symm with
  | inl h3 => exact False.elim (w_sub_one_ne_zero h3)
  | inr h4 => exact h4

