def check_all : Bool := Id.run do
  let mut ok := true
  for F_nat in [91:1672] do
    let F : ℤ := F_nat
    let min_C : ℤ := - (3 * F) / 7
    let max_C : ℤ := (3 * F) / 5
    let rng : List ℤ := List.range (Int.toNat (max_C - min_C + 1))
    for i in rng do
      let C : ℤ := min_C + i
      if C != 0 then
        if not (in_bad_set F C) then
          let mut F_next : ℤ := 0
          let mut C_next : ℤ := 0
          if C % 2 != 0 then
            F_next := 2 * F - C
            C_next := F - C
          else
            F_next := F - C / 2
            C_next := - C / 2
          if in_bad_set F_next C_next then
            ok := false
  return ok

