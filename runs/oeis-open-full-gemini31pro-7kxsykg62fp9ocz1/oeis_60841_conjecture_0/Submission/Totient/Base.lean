def v3_fast (n : ℕ) (fuel : ℕ) : ℕ :=
  match fuel with
  | 0 => 0
  | f + 1 =>
    if n = 0 then 0
    else if n % 3 = 0 then 1 + v3_fast (n / 3) f
    else 0

