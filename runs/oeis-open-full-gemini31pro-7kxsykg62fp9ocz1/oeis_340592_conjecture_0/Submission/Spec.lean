import FormalConjectures.Util.ProblemImports

open Nat List Mathlib.Meta.Simproc

def chain_le : List ℕ → Bool
| [] => true
| [_] => true
| a :: b :: rest => decide (a ≤ b) && chain_le (b :: rest)

theorem chain_le_implies_isChain (l : List ℕ) : chain_le l = true → l.IsChain (· ≤ ·) := by
  induction l with
  | nil => intro _; exact List.isChain_nil
  | cons a rest ih =>
    match rest with
    | [] => intro _; exact List.isChain_singleton a
    | b :: rest2 =>
      intro h
      unfold chain_le at h
      simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      rcases h with ⟨hab, hrest⟩
      apply List.IsChain.cons
      · exact ih hrest
      · intro y hy
        simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hy
        rcases hy with rfl
        exact hab

def check_helper_bool (n p : ℕ) (l : List ℕ) : Bool :=
  chain_le (p :: l) && l.all (fun a => decide (Nat.Prime a)) && (l.prod == n)

theorem check_helper_bool_implies (n p : ℕ) (l : List ℕ)
    (h : check_helper_bool n p l = true) : FactorsHelper n p l := by
  intro hp
  unfold check_helper_bool at h
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  rcases h with ⟨⟨hchain, hprimes⟩, hprod⟩
  refine ⟨?_, ?_, ?_⟩
  · exact chain_le_implies_isChain _ hchain
  · intro a ha
    have h1 := List.all_eq_true.mp hprimes a ha
    exact of_decide_eq_true h1
  · exact hprod

def my_a (n : ℕ) : ℕ :=
  if n < 2 then 0
  else
    let factors_list := n.primeFactorsList
    let pow10_len (k : ℕ) : ℕ := 10 ^ (Nat.digits 10 k).length
    let concat_op (acc factor : ℕ) : ℕ := acc * pow10_len factor + factor
    (factors_list.foldl concat_op 0) % n

def my_composite (n : ℕ) : Prop := ¬ (Nat.Prime n) ∧ 1 < n

open Mathlib.Meta.Simproc

set_option maxHeartbeats 10000000
set_option maxRecDepth 10000000
set_option linter.unusedVariables false

theorem check_4 (hcomp : my_composite 4) : my_a 4 ≠ 0 := by
  have h_bool : check_helper_bool 4 2 [2, 2] = true := by norm_num [check_helper_bool, chain_le, List.all, List.prod, beq_iff_eq]
  have h_factors : Nat.primeFactorsList 4 = [2, 2] := FactorsHelper.primeFactorsList_eq (check_helper_bool_implies _ _ _ h_bool)
  unfold my_a; rw [h_factors]; simp

