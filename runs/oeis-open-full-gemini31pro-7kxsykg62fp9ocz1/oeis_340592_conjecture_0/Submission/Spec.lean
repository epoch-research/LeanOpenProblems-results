theorem check_10000 (hcomp : my_composite 10000) : my_a 10000 ≠ 0 := by
  have h_bool : check_helper_bool 10000 2 [2, 2, 2, 2, 5, 5, 5, 5] = true := by norm_num [check_helper_bool, chain_le, List.all, List.prod, beq_iff_eq]
  have h_factors : Nat.primeFactorsList 10000 = [2, 2, 2, 2, 5, 5, 5, 5] := FactorsHelper.primeFactorsList_eq (check_helper_bool_implies _ _ _ h_bool)
  unfold my_a; rw [h_factors]; simp

