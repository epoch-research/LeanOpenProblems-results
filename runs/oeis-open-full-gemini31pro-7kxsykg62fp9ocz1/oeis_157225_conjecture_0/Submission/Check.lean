def check (x y : ℕ) : Bool :=
  if x < 1 ∨ y < 1 then true
  else
    if 2 ^ x + 7 * 2 ^ y ≥ 1433987797 then true
    else
      if (1433987797 - (2 ^ x + 7 * 2 ^ y)) % 6 ≠ 5 then true
      else
        let p := 1433987797 - (2 ^ x + 7 * 2 ^ y)
        let d := divisors[x * 31 + y]!
        p % d == 0 ∧ 1 < d ∧ d < p

set_option maxRecDepth 1000000
set_option maxHeartbeats 10000000

theorem all_checks : (List.range 31).all (fun x => (List.range 31).all (fun y => check x y)) = true := by
  decide

theorem check_eq_true (x y : ℕ) (hx : x < 31) (hy : y < 31) : check x y = true := by
  have h1 := all_checks
  rw [List.all_eq_true] at h1
  have h2 := h1 x (List.mem_range.mpr hx)
  rw [List.all_eq_true] at h2
  exact h2 y (List.mem_range.mpr hy)

lemma not_prime_of_dvd (p d : ℕ) (hd : p % d = 0) (h1 : 1 < d) (hp : d < p) : ¬ p.Prime := by
  intro h
  have hdvd : d ∣ p := Nat.dvd_of_mod_eq_zero hd
  exact (Nat.Prime.eq_one_or_self_of_dvd h d hdvd).elim (fun heq => by omega) (fun heq => by omega)

theorem counterexample_x_y (x y : ℕ) (hx : x < 31) (hy : y < 31) :
  ¬ (1 ≤ x ∧ 1 ≤ y ∧
     2 ^ x + 7 * 2 ^ y < 1433987797 ∧
     Nat.Prime (1433987797 - (2 ^ x + 7 * 2 ^ y)) ∧
     (1433987797 - (2 ^ x + 7 * 2 ^ y)) % 6 = 5) := by
  intro ⟨hx1, hy1, hterm, hprime, hmod⟩
  have hc := check_eq_true x y hx hy
  unfold check at hc
  split at hc
  · omega
  split at hc
  · omega
  split at hc
  · omega
  · simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hc
    rcases hc with ⟨hdvd, h1, hp⟩
    exact not_prime_of_dvd _ _ hdvd h1 hp hprime


