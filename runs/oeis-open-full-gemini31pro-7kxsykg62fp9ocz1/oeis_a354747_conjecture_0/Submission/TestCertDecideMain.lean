  rw [show 39101 = 10000 + 29101 by rfl, cube_pow_add, chain_M2_part_0_eq, ←chain_M2_link_1]
  rw [show 29101 = 10000 + 19101 by rfl, cube_pow_add, chain_M2_part_1_eq, ←chain_M2_link_2]
  rw [show 19101 = 10000 + 9101 by rfl, cube_pow_add, chain_M2_part_2_eq, ←chain_M2_link_3]
