import FormalConjectures.Util.ProblemImports


open Real Int

/--
A011545: $a(n)$ is the integer whose decimal digits are the first $n+1$ decimal digits of $\pi$.
This is equivalent to $a(n) = \lfloor \pi \cdot 10^n \rfloor$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  -- The calculation is $\lfloor \pi \cdot 10^n \rfloor$.
  -- We use Real.floor, which returns an Int, and convert it to a natural number.
  (floor (Real.pi * (10 : ℝ) ^ n.cast)).toNat

lemma unique_integer (x : ℝ) (k : ℤ) (h1 : x < (k : ℝ)) (h2 : (k : ℝ) < x + 1) : k = ⌊x⌋ + 1 := by
  have h_floor : ⌊x⌋ = k - 1 := by
    rw [Int.floor_eq_iff]
    push_cast
    constructor
    · linarith [h2]
    · linarith [h1]
  omega

theorem arctan_gt_rational_bound (x : ℝ) (hx : 0 < x) :
    x / (1 + x ^ 2) < Real.arctan x := by
  let z := Real.arctan x
  have h_pos : 0 < z := by
    rw [← arctan_zero]
    exact arctan_strictMono hx
  have h_lt : z < π / 2 := arctan_lt_pi_div_two x
  have h_two_z_pos : 0 < 2 * z := mul_pos zero_lt_two h_pos
  have h_sin := sin_lt h_two_z_pos
  have h_sin_double : sin (2 * z) = 2 * sin z * cos z := sin_two_mul z
  rw [h_sin_double] at h_sin
  have h_div : sin z * cos z < z := by
    linarith [h_sin]
  have h_sin_eq : sin z = x / √(1 + x ^ 2) := sin_arctan x
  have h_cos_eq : cos z = 1 / √(1 + x ^ 2) := cos_arctan x
  have h_mul : sin z * cos z = x / (1 + x ^ 2) := by
    rw [h_sin_eq, h_cos_eq]
    have h_sqrt_pos : 0 ≤ 1 + x ^ 2 := by positivity
    rw [div_mul_div_comm, mul_one, mul_self_sqrt h_sqrt_pos]
  rw [h_mul] at h_div
  exact h_div

theorem pi_div_arctan_lt (x : ℝ) (hx : 0 < x) :
    Real.pi / Real.arctan x < Real.pi / x + Real.pi * x := by
  have h_arctan_pos : 0 < Real.arctan x := by
    rw [← Real.arctan_zero]
    exact Real.arctan_strictMono hx
  have h_bound := arctan_gt_rational_bound x hx
  have h_rational_pos : 0 < x / (1 + x ^ 2) := by positivity
  have h_inv : (Real.arctan x)⁻¹ < (x / (1 + x ^ 2))⁻¹ := by
    rwa [inv_lt_inv₀ h_arctan_pos h_rational_pos]
  have h_inv_eq : (x / (1 + x ^ 2))⁻¹ = 1 / x + x := by
    rw [inv_div]
    have hx_ne : x ≠ 0 := ne_of_gt hx
    field_simp
  rw [h_inv_eq] at h_inv
  have h_pi_pos : 0 < Real.pi := Real.pi_pos
  have h_mul : (Real.arctan x)⁻¹ * Real.pi < (1 / x + x) * Real.pi := by
    exact mul_lt_mul_of_pos_right h_inv h_pi_pos
  rw [div_eq_mul_inv, mul_comm]
  have h_target : (1 / x + x) * Real.pi = Real.pi / x + Real.pi * x := by
    rw [add_mul, one_div, mul_comm x, mul_comm (x⁻¹)]
    rfl
  rw [h_target] at h_mul
  exact h_mul

lemma pi_div_arctan_lt_pi_mul_add_one (n : ℕ) (hn : 1 ≤ n) :
    Real.pi / Real.arctan (1 / (10 : ℝ) ^ (n : ℝ)) < Real.pi * (10 : ℝ) ^ (n : ℝ) + 1 := by
  let x := (1 / (10 : ℝ) ^ (n : ℝ))
  have hx_pos : 0 < x := by positivity
  have h_bound := pi_div_arctan_lt x hx_pos
  have h_div_x : Real.pi / x = Real.pi * (10 : ℝ) ^ (n : ℝ) := by
    rw [div_eq_mul_one_div]
    have h_one_div : 1 / x = (10 : ℝ) ^ (n : ℝ) := by
      rw [one_div_one_div]
    rw [h_one_div]
  rw [h_div_x] at h_bound
  have h_mul_x : Real.pi * x = Real.pi / (10 : ℝ) ^ (n : ℝ) := by
    rw [mul_one_div]
  rw [h_mul_x] at h_bound
  have h_pi_div_lt : Real.pi / (10 : ℝ) ^ (n : ℝ) < 1 := by
    have h_ten_pow : 10 ≤ (10 : ℝ) ^ (n : ℝ) := by
      have h_cast : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
      have h_mono : (10 : ℝ) ^ (1 : ℝ) ≤ (10 : ℝ) ^ (n : ℝ) := by
        exact rpow_le_rpow_of_exponent_le (x := 10) (by norm_num) h_cast
      rwa [rpow_one] at h_mono
    have h_pi_lt : Real.pi < 10 := by
      have h_four : Real.pi < 4 := Real.pi_lt_four
      linarith
    have h_pi_lt_ten_pow : Real.pi < (10 : ℝ) ^ (n : ℝ) := by
      linarith
    exact (div_lt_one (by positivity)).mpr h_pi_lt_ten_pow
  linarith [h_bound, h_pi_div_lt]

/--
A property which is equivalent to the conjecture that the number of collisions
in the described physical system (with mass ratio $10^{2n}$) is $a(n)$:
the interval $(\pi \cdot 10^n, \pi / \arctan(1/10^n))$ does not contain an integer.
The mass ratio $m$ in the comment is interpreted as $\frac{M}{m}$ in the physics setup,
which is $10^{2n}$, so $\sqrt{m}=10^n$.

Note: The OEIS comment uses $m=10^n$ for the $R^2$ term where $R=10^n$ in the physics formula.
We formalize the statement $\forall n \in \mathbb{N}, \nexists k \in \mathbb{Z}$ such that
$\pi \cdot 10^n < k < \pi / \arctan(1/10^n)$.
-/
lemma hasDerivAt_poly (x : ℝ) : HasDerivAt (fun x => x - x ^ 3 / 3) (1 - x ^ 2) x := by
  have h1 : HasDerivAt (fun x => x) 1 x := hasDerivAt_id x
  have h2 : HasDerivAt (fun x => x ^ 3) (3 * x ^ 2) x := by
    simpa using hasDerivAt_pow 3 x
  have h3 : HasDerivAt (fun x => x ^ 3 / 3) (3 * x ^ 2 / 3) x := by
    exact HasDerivAt.div_const h2 (3 : ℝ)
  have h4 : HasDerivAt (fun x => x - x ^ 3 / 3) (1 - 3 * x ^ 2 / 3) x := by
    exact HasDerivAt.sub h1 h3
  have h_eq : 1 - 3 * x ^ 2 / 3 = 1 - x ^ 2 := by
    ring
  rw [h_eq] at h4
  exact h4

lemma hasDerivAt_f (x : ℝ) : HasDerivAt (fun x => Real.arctan x - (x - x ^ 3 / 3)) (x ^ 4 / (1 + x ^ 2)) x := by
  have h1 : HasDerivAt Real.arctan (1 / (1 + x ^ 2)) x := hasDerivAt_arctan x
  have h2 : HasDerivAt (fun x => x - x ^ 3 / 3) (1 - x ^ 2) x := hasDerivAt_poly x
  have h3 : HasDerivAt (fun x => Real.arctan x - (x - x ^ 3 / 3)) (1 / (1 + x ^ 2) - (1 - x ^ 2)) x := by
    exact HasDerivAt.sub h1 h2
  have h_eq : 1 / (1 + x ^ 2) - (1 - x ^ 2) = x ^ 4 / (1 + x ^ 2) := by
    have h_denom : 1 + x ^ 2 ≠ 0 := by positivity
    field_simp
    ring
  rw [h_eq] at h3
  exact h3

lemma strictMonoOn_f : StrictMonoOn (fun x => Real.arctan x - (x - x ^ 3 / 3)) (Set.Ici 0) := by
  have h_convex : Convex ℝ (Set.Ici (0 : ℝ)) := convex_Ici 0
  have h_cont : ContinuousOn (fun x => Real.arctan x - (x - x ^ 3 / 3)) (Set.Ici 0) := by
    apply Continuous.continuousOn
    continuity
  have h_deriv : ∀ x ∈ interior (Set.Ici (0 : ℝ)),
      HasDerivWithinAt (fun x => Real.arctan x - (x - x ^ 3 / 3)) (x ^ 4 / (1 + x ^ 2)) (interior (Set.Ici 0)) x := by
    intro x _
    exact (hasDerivAt_f x).hasDerivWithinAt
  have h_pos : ∀ x ∈ interior (Set.Ici (0 : ℝ)), 0 < x ^ 4 / (1 + x ^ 2) := by
    intro x hx
    rw [interior_Ici] at hx
    have hx_pos : 0 < x := hx
    have hx4 : 0 < x ^ 4 := by positivity
    have h_denom : 0 < 1 + x ^ 2 := by positivity
    exact div_pos hx4 h_denom
  exact strictMonoOn_of_hasDerivWithinAt_pos h_convex h_cont h_deriv h_pos

lemma arctan_gt_cubic_bound (x : ℝ) (hx : 0 < x) : x - x ^ 3 / 3 < Real.arctan x := by
  have h_mono := strictMonoOn_f
  have h_zero_mem : (0 : ℝ) ∈ Set.Ici (0 : ℝ) := Set.self_mem_Ici
  have h_x_mem : x ∈ Set.Ici (0 : ℝ) := by
    rw [Set.mem_Ici]
    exact le_of_lt hx
  have h_lt : 0 < x := hx
  have h_img := h_mono h_zero_mem h_x_mem h_lt
  simp only [arctan_zero, zero_sub] at h_img
  linarith

lemma pi_div_arctan_lt_tight (x : ℝ) (hx_pos : 0 < x) (hx_lt : x < 1) :
    Real.pi / Real.arctan x < Real.pi / x + Real.pi * x / (3 - x ^ 2) := by
  have h_arctan_pos : 0 < Real.arctan x := by
    rw [← Real.arctan_zero]
    exact Real.arctan_strictMono hx_pos
  have h_bound := arctan_gt_cubic_bound x hx_pos
  have h_poly_pos : 0 < x - x ^ 3 / 3 := by
    have : 0 < 1 - x ^ 2 / 3 := by
      have : x ^ 2 < 1 := by
        nlinarith
      linarith
    nlinarith
  have h_inv : (Real.arctan x)⁻¹ < (x - x ^ 3 / 3)⁻¹ := by
    rwa [inv_lt_inv₀ h_arctan_pos h_poly_pos]
  have h_inv_eq : (x - x ^ 3 / 3)⁻¹ = 1 / x + x / (3 - x ^ 2) := by
    have hx_ne : x ≠ 0 := ne_of_gt hx_pos
    have h_denom : 3 - x ^ 2 ≠ 0 := by
      have : x ^ 2 < 1 := by nlinarith
      linarith
    have h_denom2 : x - x ^ 3 / 3 ≠ 0 := ne_of_gt h_poly_pos
    field_simp
    ring
  rw [h_inv_eq] at h_inv
  have h_pi_pos : 0 < Real.pi := Real.pi_pos
  have h_mul : (Real.arctan x)⁻¹ * Real.pi < (1 / x + x / (3 - x ^ 2)) * Real.pi := by
    exact mul_lt_mul_of_pos_right h_inv h_pi_pos
  rw [div_eq_mul_inv, mul_comm]
  have h_target : (1 / x + x / (3 - x ^ 2)) * Real.pi = Real.pi / x + Real.pi * x / (3 - x ^ 2) := by
    field_simp
  rw [h_target] at h_mul
  exact h_mul

theorem tight_bound_for_pow (M : ℕ) (hM : 1 ≤ M) :
    Real.pi / Real.arctan (1 / (10 : ℝ) ^ (M : ℝ)) < Real.pi * (10 : ℝ) ^ (M : ℝ) + 1.1 / (10 : ℝ) ^ (M : ℝ) := by
  let x := (1 / (10 : ℝ) ^ (M : ℝ))
  have hx_pos : 0 < x := by positivity
  have h_ten_pow_ge : 10 ≤ (10 : ℝ) ^ (M : ℝ) := by
    have h_cast : (1 : ℝ) ≤ (M : ℝ) := by exact_mod_cast hM
    have h_mono : (10 : ℝ) ^ (1 : ℝ) ≤ (10 : ℝ) ^ (M : ℝ) := by
      exact rpow_le_rpow_of_exponent_le (by norm_num) h_cast
    rwa [rpow_one] at h_mono
  have hx_lt : x < 1 := by
    rw [one_div_lt (by positivity) (by norm_num)]
    linarith
  have h_tight := pi_div_arctan_lt_tight x hx_pos hx_lt
  have h_div_x : Real.pi / x = Real.pi * (10 : ℝ) ^ (M : ℝ) := by
    rw [div_eq_mul_one_div, one_div_one_div]
  rw [h_div_x] at h_tight
  have h_mul_x : Real.pi * x / (3 - x ^ 2) = (Real.pi / (3 - x ^ 2)) * x := by
    ring
  rw [h_mul_x] at h_tight
  have h_factor : (Real.pi / (3 - x ^ 2)) * x < 1.1 * x := by
    have h_pi_lt : Real.pi < 3.141593 := pi_lt_d6
    have h_x_le : x ≤ 1 / 10 := by
      rw [one_div_le (by positivity) (by norm_num)]
      have : (1 / (1 / 10 : ℝ)) = 10 := by norm_num
      rwa [this]
    have h_x2_le : x ^ 2 ≤ 1 / 100 := by
      have hx2 : x ^ 2 = x * x := by ring
      have h100 : (1 / 10 : ℝ) * (1 / 10) = 1 / 100 := by norm_num
      rw [hx2]
      rw [← h100]
      exact mul_le_mul h_x_le h_x_le (by positivity) (by norm_num)
    have h_denom : 299 / 100 ≤ 3 - x ^ 2 := by
      linarith
    have h_denom_pos : 0 < (299 / 100 : ℝ) := by norm_num
    have h_div : Real.pi / (3 - x ^ 2) < 1.1 := by
      have h1 : Real.pi / (3 - x ^ 2) ≤ Real.pi / (299 / 100) := by
        exact div_le_div_of_nonneg_left (by positivity) h_denom_pos h_denom
      have h2 : Real.pi / (299 / 100) < 1.1 := by
        rw [div_lt_iff₀ (by norm_num)]
        linarith [h_pi_lt]
      exact lt_of_le_of_lt h1 h2
    exact mul_lt_mul_of_pos_right h_div hx_pos
  have h_x_eq : 1.1 / (10 : ℝ) ^ (M : ℝ) = 1.1 * x := by ring
  rw [h_x_eq]
  linarith [h_tight, h_factor]

