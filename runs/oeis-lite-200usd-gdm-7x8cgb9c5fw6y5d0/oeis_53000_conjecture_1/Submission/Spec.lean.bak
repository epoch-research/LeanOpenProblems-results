import FormalConjectures.Util.ProblemImports

open Nat Set

/--
A053000: $a(n) = (\text{smallest prime} > n^2) - n^2$.
-/
noncomputable def A053000 (n : ℕ) : ℕ :=
  (sInf {p | Nat.Prime p ∧ p > n ^ 2}) - n ^ 2

set_option warn.sorry false

/--
Conjecture: a(n) <= 1+phi(n) = 1+A000010(n), for n>0. This improves on Oppermann's conjecture, which says a(n) < n.
-/
@[category research open, AMS 11]
theorem oeis_53000_conjecture_1 (n : ℕ) (hn : n > 0) : A053000 n ≤ 1 + Nat.totient n := by
  rcases eq_or_ne n 1 with rfl | hn1
  · unfold A053000
    have h2 : 2 ∈ {p | Nat.Prime p ∧ p > 1 ^ 2} := by
      simp
      exact Nat.prime_two
    have h_le := Nat.sInf_le h2
    have h_pos : {p : ℕ | Nat.Prime p ∧ p > 1 ^ 2}.Nonempty := ⟨2, h2⟩
    have h_mem := Nat.sInf_mem h_pos
    simp only [Set.mem_setOf_eq] at h_mem
    have h_prime := h_mem.1
    have h_gt_one := h_mem.2
    have h_ge_two : sInf {p | Nat.Prime p ∧ p > 1 ^ 2} ≥ 2 := by
      exact Nat.Prime.two_le h_prime
    have h_eq : sInf {p | Nat.Prime p ∧ p > 1 ^ 2} = 2 := by
      omega
    rw [h_eq]
    decide
  · sorry

