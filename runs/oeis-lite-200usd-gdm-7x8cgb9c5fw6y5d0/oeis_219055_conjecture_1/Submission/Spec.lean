  · push_neg at hn
    have hc_even : (Even n ∧ 8012 < n) ∨ (Odd n ∧ 15727 < n) := Or.inl ⟨heven, hn⟩
    have h_pos : A219055 n > 0 := hc n hc_even
    rw [A219055] at h_pos
    rcases Finset.card_pos.mp h_pos with ⟨q, hq_mem⟩
    rw [Finset.mem_filter] at hq_mem
    rcases hq_mem with ⟨_, h_cond⟩
    have hn2 : n % 2 = 0 := Nat.even_iff.mp heven
    rw [hn2] at h_cond
    simp at h_cond
    rcases h_cond with ⟨hq_bound, hq_prime, _, hp_prime, _⟩
    have h_qn : q < n := by omega
    use n - q, q
    refine ⟨hp_prime, hq_prime, ?_⟩
    omega

