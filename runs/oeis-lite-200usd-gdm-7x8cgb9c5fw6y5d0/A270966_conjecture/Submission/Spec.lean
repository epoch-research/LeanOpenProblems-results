  have h_card := Finset.card_le_card h_sub
  unfold A270966
  have h_card_set : Finset.card {(0, 1), (1, 1)} = 2 := by
    rfl
  omega

def check_witness_at_true {n : ℕ} {xy : ℕ × ℕ} (h : check_witness_at n xy = true) :
  let x := xy.fst
  let y := xy.snd
  let x_sq_y_sq := x * x + y * y
  x_sq_y_sq ≤ n ∧
  x ≤ y ∧
  (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
  is_generalized_pentagonal (n - x_sq_y_sq) := by
  unfold check_witness_at at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_iff] at h
  rcases h with ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩
  refine ⟨h1, h2, h3, h4⟩

def witness_mem_filter {n : ℕ} (hn1 : n > 0) (hn2 : n < 650) :
  (witness n) ∈ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter fun xy : ℕ × ℕ =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y
    x_sq_y_sq ≤ n ∧
    x ≤ y ∧
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    is_generalized_pentagonal (n - x_sq_y_sq) := by
  have h_all : check_all_witnesses = true := check_all_witnesses_eq_true
  unfold check_all_witnesses at h_all
  rw [List.all_eq_true] at h_all
  have h_mem : n ∈ List.range 650 := by
    rw [List.mem_range]
    exact hn2
  have h_spec := h_all n h_mem
  have h_ne0 : (n == 0) = false := by
    exact decide_eq_false hn1.ne'
  simp only [h_ne0] at h_spec
  unfold check_witness at h_spec
  have h_spec_at := check_witness_at_true h_spec
  rw [Finset.mem_filter]
  constructor
  · rw [Finset.product_eq_sprod, Finset.mem_product, Finset.mem_range, Finset.mem_range]
    have h1 : (witness n).fst * (witness n).fst + (witness n).snd * (witness n).snd ≤ n := h_spec_at.left
    have h_x_sq : (witness n).fst * (witness n).fst ≤ n := by omega
    have h_y_sq : (witness n).snd * (witness n).snd ≤ n := by omega
    constructor
    · nlinarith
    · nlinarith
  · exact h_spec_at

def witness_pair_spec {n : ℕ} (hn1 : n > 0) (hn2 : n < 650) (hn3 : n ≠ 1) (hn4 : n ≠ 49) (hn5 : n ≠ 608) :
  let pair := witness_pair n
  pair.fst ≠ pair.snd ∧
  pair.fst ∈ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter (fun xy =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y
    x_sq_y_sq ≤ n ∧
    x ≤ y ∧
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    is_generalized_pentagonal (n - x_sq_y_sq)
  ) ∧
  pair.snd ∈ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter (fun xy =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y
    x_sq_y_sq ≤ n ∧
    x ≤ y ∧
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    is_generalized_pentagonal (n - x_sq_y_sq)
  ) := by
  have h_all : check_all_witness_pairs = true := check_all_witness_pairs_eq_true
  unfold check_all_witness_pairs at h_all
  rw [List.all_eq_true] at h_all
  have h_mem : n ∈ List.range 650 := by
    rw [List.mem_range]
    exact hn2
  have h_spec := h_all n h_mem
  have h_cond : (n == 0 || n == 1 || n == 49 || n == 608) = false := by
    have h1 : ¬ (n = 0) := by omega
    have h2 : ¬ (n = 1) := by omega
    have h3 : ¬ (n = 49) := by omega
    have h4 : ¬ (n = 608) := by omega
    rw [Bool.or_eq_false_iff, Bool.or_eq_false_iff, Bool.or_eq_false_iff]
    refine ⟨⟨⟨decide_eq_false h1, decide_eq_false h2⟩, decide_eq_false h3⟩, decide_eq_false h4⟩
  simp only [h_cond] at h_spec
  unfold check_witness_pair at h_spec
  dsimp only at h_spec
  simp at h_spec
  rcases h_spec with ⟨⟨h_ne, h1⟩, h2⟩
  have h1_spec := check_witness_at_true h1
  have h2_spec := check_witness_at_true h2
  refine ⟨h_ne, ?_, ?_⟩
  · rw [Finset.mem_filter]
    constructor
    · rw [Finset.product_eq_sprod, Finset.mem_product, Finset.mem_range, Finset.mem_range]
      have h_x_sq : (witness_pair n).fst.fst * (witness_pair n).fst.fst ≤ n := by omega
      have h_y_sq : (witness_pair n).fst.snd * (witness_pair n).fst.snd ≤ n := by omega
      constructor
      · nlinarith
      · nlinarith
    · exact h1_spec
  · rw [Finset.mem_filter]
    constructor
    · rw [Finset.product_eq_sprod, Finset.mem_product, Finset.mem_range, Finset.mem_range]
      have h_x_sq : (witness_pair n).snd.fst * (witness_pair n).snd.fst ≤ n := by omega
      have h_y_sq : (witness_pair n).snd.snd * (witness_pair n).snd.snd ≤ n := by omega
      constructor
      · nlinarith
      · nlinarith
    · exact h2_spec

end Submission

/-- The A270966 conjecture. -/
@[category research solved, AMS 11]
theorem A270966_conjecture :
  (∀ n : ℕ, n > 0 → A270966 n > 0) ∧
  (∀ n : ℕ, A270966 n = 1 ↔ n = 1 ∨ n = 49 ∨ n = 608) := by
  constructor
  · intro n hn
    by_cases hn_ge : n ≥ 650
    · have h_ge := Submission.A270966_ge_two_of_ge_650 n hn_ge
      omega
    · have hn_lt : n < 650 := by omega
      have h_mem := Submission.witness_mem_filter hn hn_lt
      have h_sub : {Submission.witness n} ⊆ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter (fun xy =>
        let x := xy.fst
        let y := xy.snd
        let x_sq_y_sq := x * x + y * y
        x_sq_y_sq ≤ n ∧ x ≤ y ∧ (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧ is_generalized_pentagonal (n - x_sq_y_sq)
      ) := by
        rw [Finset.singleton_subset_iff]
        exact h_mem
      have h_le := Finset.card_le_card h_sub
      have h_card_set : Finset.card {Submission.witness n} = 1 := by rfl
      unfold A270966
      omega
  · intro n
    constructor
    · intro h_card
      by_contra h_not
      push_neg at h_not
      rcases h_not with ⟨hn1, hn2, hn3⟩
      by_cases h0 : n = 0
      · subst h0
        have h_empty : (Finset.product (Finset.range (0 + 1)) (Finset.range (0 + 1))).filter (fun xy : ℕ × ℕ =>
          let x := xy.fst
          let y := xy.snd
          let x_sq_y_sq := x * x + y * y
          x_sq_y_sq ≤ 0 ∧ x ≤ y ∧ (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧ is_generalized_pentagonal (0 - x_sq_y_sq)
        ) = ∅ := by
          ext ⟨x, y⟩
          simp only [Finset.mem_filter, Finset.product_eq_sprod, Finset.mem_product, Finset.mem_range]
          simp
          rintro rfl rfl -
          decide
        unfold A270966 at h_card
        rw [h_empty] at h_card
        contradiction
      · have hn_gt : n > 0 := by omega
        by_cases hn_ge : n ≥ 650
        · have h_ge := Submission.A270966_ge_two_of_ge_650 n hn_ge
          omega
        · have hn_lt : n < 650 := by omega
          have h_spec := Submission.witness_pair_spec hn_gt hn_lt hn1 hn2 hn3
          rcases h_spec with ⟨h_ne, h_mem1, h_mem2⟩
          have h_sub : {Submission.witness_pair n |>.fst, Submission.witness_pair n |>.snd} ⊆ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter (fun xy =>
            let x := xy.fst
            let y := xy.snd
            let x_sq_y_sq := x * x + y * y
            x_sq_y_sq ≤ n ∧ x ≤ y ∧ (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧ is_generalized_pentagonal (n - x_sq_y_sq)
          ) := by
            rw [Finset.insert_subset_iff, Finset.singleton_subset_iff]
            exact ⟨h_mem1, h_mem2⟩
          have h_le := Finset.card_le_card h_sub
          have h_card_set : Finset.card {Submission.witness_pair n |>.fst, Submission.witness_pair n |>.snd} = 2 := by
            simp [h_ne]
          unfold A270966 at h_card
          omega
    · rintro (rfl | rfl | rfl)
      · unfold A270966
        decide
      · unfold A270966
        decide
      · unfold A270966
        have h_eq1 : (Finset.product (Finset.range 609) (Finset.range 609)).filter (fun xy : ℕ × ℕ =>
          let x := xy.fst
          let y := xy.snd
          let x_sq_y_sq := x * x + y * y
          x_sq_y_sq ≤ 608 ∧ x ≤ y ∧ (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧ is_generalized_pentagonal (608 - x_sq_y_sq)
        ) = (Finset.product (Finset.range 25) (Finset.range 25)).filter (fun xy : ℕ × ℕ =>
          let x := xy.fst
          let y := xy.snd
          let x_sq_y_sq := x * x + y * y
          x_sq_y_sq ≤ 608 ∧ x ≤ y ∧ (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧ is_generalized_pentagonal (608 - x_sq_y_sq)
        ) := by
          ext ⟨x, y⟩
          simp only [Finset.product_eq_sprod, Finset.mem_filter, Finset.mem_product, Finset.mem_range]
          constructor
          · rintro ⟨_, h_pred⟩
            have h_bound : x * x + y * y ≤ 608 := h_pred.left
            have h_x_lt : x < 25 := by
              by_contra h_ge
              have : x ≥ 25 := by omega
              have : x * x ≥ 625 := by nlinarith
              omega
            have h_y_lt : y < 25 := by
              by_contra h_ge
              have : y ≥ 25 := by omega
              have : y * y ≥ 625 := by nlinarith
              omega
            exact ⟨⟨h_x_lt, h_y_lt⟩, h_pred⟩
          · rintro ⟨_, h_pred⟩
            refine ⟨⟨by omega, by omega⟩, h_pred⟩
        rw [h_eq1]
        decide
