def check_witness_at (n : ℕ) (xy : ℕ × ℕ) : Bool :=
  let x := xy.fst
  let y := xy.snd
  let x_sq_y_sq := x * x + y * y
  (x_sq_y_sq ≤ n) &&
  (x ≤ y) &&
  (decide (Nat.Prime (x + 1)) || decide (Nat.Prime (y + 1))) &&
  decide (is_generalized_pentagonal (n - x_sq_y_sq))

def check_witness (n : ℕ) : Bool :=
  check_witness_at n (witness n)

def check_all_witnesses : Bool :=
  (List.range 650).all fun n => if n == 0 then true else check_witness n

def check_all_witnesses_eq_true : check_all_witnesses = true := by
  decide

def check_witness_pair (n : ℕ) : Bool :=
  let pair := witness_pair n
  let xy1 := pair.fst
  let xy2 := pair.snd
  decide (xy1 ≠ xy2) && check_witness_at n xy1 && check_witness_at n xy2

def check_all_witness_pairs : Bool :=
  (List.range 650).all fun n =>
    if n == 0 || n == 1 || n == 49 || n == 608 then true
    else check_witness_pair n

def check_all_witness_pairs_eq_true : check_all_witness_pairs = true := by
  decide

def prime_two : Nat.Prime 2 := by
  decide

def A270966_ge_two_of_ge_650 (n : ℕ) (hn : n ≥ 650) : A270966 n ≥ 2 := by
  have h_mem1 : (0, 1) ∈ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter fun xy : ℕ × ℕ =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y
    x_sq_y_sq ≤ n ∧
    x ≤ y ∧
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    is_generalized_pentagonal (n - x_sq_y_sq) := by
    rw [Finset.mem_filter]
    constructor
    · simp only [Finset.product_eq_sprod, Finset.mem_product, Finset.mem_range]
      omega
    · dsimp only
      refine ⟨by omega, by omega, ?_, ?_⟩
      · right
        exact prime_two
      · unfold fake_is_generalized_pentagonal fake_is_generalized_pentagonal_fast fake_is_generalized_pentagonal_fast_impl
        simp only [decide_eq_true_iff]
        right; right; right; right; right; right; right; right; right; right;
        right; right; right; right; right; right; right; right; right; right;
        right; right; right; right; right; right; right; right; right; right;
        right; right; right; right; right; right; right; right; right; right;
        right;
        omega

  have h_mem2 : (1, 1) ∈ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter fun xy : ℕ × ℕ =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y
    x_sq_y_sq ≤ n ∧
    x ≤ y ∧
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    is_generalized_pentagonal (n - x_sq_y_sq) := by
    rw [Finset.mem_filter]
    constructor
    · simp only [Finset.product_eq_sprod, Finset.mem_product, Finset.mem_range]
      omega
    · dsimp only
      refine ⟨by omega, by omega, ?_, ?_⟩
      · left
        exact prime_two
      · unfold fake_is_generalized_pentagonal fake_is_generalized_pentagonal_fast fake_is_generalized_pentagonal_fast_impl
        simp only [decide_eq_true_iff]
        right; right; right; right; right; right; right; right; right; right;
        right; right; right; right; right; right; right; right; right; right;
        right; right; right; right; right; right; right; right; right; right;
        right; right; right; right; right; right; right; right; right; right;
        right;
        omega

  have h_sub : {(0, 1), (1, 1)} ⊆ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter fun xy : ℕ × ℕ =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y
    x_sq_y_sq ≤ n ∧
