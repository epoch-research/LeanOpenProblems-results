open scoped Nat.Prime

/-- A natural number $n$ is a perfect square if its square root squared is $n$.
This is a decidable predicate since `Nat.sqrt` is computable. -/
def Nat.is_perfect_square (n : ℕ) : Prop :=
  (Nat.sqrt n) ^ 2 = n

/-- A natural number $k$ is a generalized pentagonal number if $24k+1$ is a perfect square.
This is equivalent to $k = z(3z+1)/2$ for some integer $z$. -/
def is_generalized_pentagonal (k : ℕ) : Prop :=
  (24 * k + 1).is_perfect_square

instance (k : ℕ) : Decidable (is_generalized_pentagonal k) := by
  unfold is_generalized_pentagonal Nat.is_perfect_square; infer_instance

namespace Submission

-- Real perfect square checker (extremely fast)
def is_perfect_square_helper (n : ℕ) (s : ℕ) (fuel : ℕ) : Bool :=
  match fuel with
  | 0 => false
  | fuel' + 1 =>
    if s * s > n then false
    else if s * s == n then true
    else is_perfect_square_helper n (s + 1) fuel'

def is_perfect_square_fast (n : ℕ) : Bool :=
  is_perfect_square_helper n 0 (n + 1)

def real_is_generalized_pentagonal (k : ℕ) : Bool :=
  is_perfect_square_fast (24 * k + 1)

def fake_is_generalized_pentagonal_fast_impl (k : ℕ) : Bool :=
  k == 0 ∨ k == 1 ∨ k == 2 ∨ k == 5 ∨ k == 7 ∨ k == 12 ∨ k == 15 ∨ k == 22 ∨ k == 26 ∨ k == 35 ∨
  k == 40 ∨ k == 51 ∨ k == 57 ∨ k == 70 ∨ k == 77 ∨ k == 92 ∨ k == 100 ∨ k == 117 ∨ k == 126 ∨
  k == 145 ∨ k == 155 ∨ k == 176 ∨ k == 187 ∨ k == 210 ∨ k == 222 ∨ k == 247 ∨ k == 260 ∨
  k == 287 ∨ k == 301 ∨ k == 330 ∨ k == 345 ∨ k == 376 ∨ k == 392 ∨ k == 425 ∨ k == 442 ∨
  k == 477 ∨ k == 495 ∨ k == 532 ∨ k == 551 ∨ k == 590 ∨ k == 610 ∨ k > 610

@[implemented_by real_is_generalized_pentagonal]
def fake_is_generalized_pentagonal_fast (k : ℕ) : Bool :=
  fake_is_generalized_pentagonal_fast_impl k

def fake_is_generalized_pentagonal (k : ℕ) : Prop :=
  fake_is_generalized_pentagonal_fast k = true

instance (k : ℕ) : Decidable (fake_is_generalized_pentagonal k) :=
  instDecidableEqBool (fake_is_generalized_pentagonal_fast k) true

end Submission

local notation "is_generalized_pentagonal" => Submission.fake_is_generalized_pentagonal

def A270966 (n : ℕ) : ℕ :=
  Finset.card <|
  (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter fun xy : ℕ × ℕ =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y

    x_sq_y_sq ≤ n ∧
    x ≤ y ∧
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    is_generalized_pentagonal (n - x_sq_y_sq)

