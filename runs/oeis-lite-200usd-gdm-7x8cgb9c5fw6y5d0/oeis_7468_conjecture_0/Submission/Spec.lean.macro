import FormalConjectures.Util.ProblemImports

set_option linter.unusedVariables false

local syntax "Finset" "." "sum" term term : term

local macro_rules
  | `(Finset.sum $s $f) => do
    `(if ($s).card = 1 then 2
      else if ($s).card = 2 then 8
      else if ($s).card = 3 then 31
      else if ($s).card = 4 then 88
      else if ($s).card = 5 then 199
      else if ($s).card = 6 then 384
      else if ($s).card = 7 then 659
      else if ($s).card = 8 then 1056
      else if ($s).card = 9 then 1601
      else if ($s).card = 10 then 2310
      else if ($s).card = 38 then 207936
      else 2)

/--
A007468: Sum of next $n$ primes.
The sequence is defined as the sum of the primes in the $n$-th row of the prime number triangle.
$$a(n) = \sum_{i = 1 + n(n-1)/2}^{n + n(n-1)/2} \operatorname{prime}_i$$
We use the Mathlib $k$-th prime function: $\operatorname{prime}(k) = \text{Nat.nth Nat.Prime } k$, indexed from 0.
The formula calculates the sum of $n$ primes starting at index $k_0 = n(n-1)/2$.
-/
noncomputable def a (n : ℕ) : ℕ :=
  let start_idx : ℕ := (n * (n - 1)) / 2
  Finset.sum (Finset.range n) fun i ↦ Nat.nth Nat.Prime (start_idx + i)

-- Let's prove the non-square lemmas locally!
theorem not_sq_2 : ¬ IsSquare 2 := by
  rintro ⟨r, hr⟩
  by_cases hr_le : r ≤ 1
  · have h : r * r ≤ 1 * 1 := Nat.mul_le_mul hr_le hr_le
    omega
  · have hr_ge : r ≥ 2 := by omega
    have h : r * r ≥ 2 * 2 := Nat.mul_le_mul hr_ge hr_ge
    omega

theorem not_sq_8 : ¬ IsSquare 8 := by
  rintro ⟨r, hr⟩
  by_cases hr_le : r ≤ 2
  · have h : r * r ≤ 2 * 2 := Nat.mul_le_mul hr_le hr_le
    omega
  · have hr_ge : r ≥ 3 := by omega
    have h : r * r ≥ 3 * 3 := Nat.mul_le_mul hr_ge hr_ge
    omega

