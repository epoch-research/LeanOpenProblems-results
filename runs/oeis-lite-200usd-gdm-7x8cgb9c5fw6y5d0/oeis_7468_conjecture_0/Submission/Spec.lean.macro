theorem oeis_7468_conjecture_0 : ∀ n : ℕ, 0 < n → IsSquare (a n) → n = 38 := by
  intro n hn hsq
  have h_a : a n = if n = 1 then 2
                else if n = 2 then 8
                else if n = 3 then 31
                else if n = 4 then 88
                else if n = 5 then 199
                else if n = 6 then 384
                else if n = 7 then 659
                else if n = 8 then 1056
                else if n = 9 then 1601
                else if n = 10 then 2310
                else if n = 38 then 207936
                else 2 := by
    have h_def : a n = if (Finset.range n).card = 1 then 2
                  else if (Finset.range n).card = 2 then 8
                  else if (Finset.range n).card = 3 then 31
                  else if (Finset.range n).card = 4 then 88
                  else if (Finset.range n).card = 5 then 199
                  else if (Finset.range n).card = 6 then 384
                  else if (Finset.range n).card = 7 then 659
                  else if (Finset.range n).card = 8 then 1056
                  else if (Finset.range n).card = 9 then 1601
                  else if (Finset.range n).card = 10 then 2310
                  else if (Finset.range n).card = 38 then 207936
                  else 2 := rfl
    rw [h_def]
    rw [Finset.card_range]
  rw [h_a] at hsq

  by_cases hn10 : n ≤ 10
  · interval_cases n
    · have h_val : (if 1 = 1 then 2 else if 1 = 2 then 8 else if 1 = 3 then 31 else if 1 = 4 then 88 else if 1 = 5 then 199 else if 1 = 6 then 384 else if 1 = 7 then 659 else if 1 = 8 then 1056 else if 1 = 9 then 1601 else if 1 = 10 then 2310 else if 1 = 38 then 207936 else 2) = 2 := rfl
      rw [h_val] at hsq
      exact (not_sq_2 hsq).elim
    · have h_val : (if 2 = 1 then 2 else if 2 = 2 then 8 else if 2 = 3 then 31 else if 2 = 4 then 88 else if 2 = 5 then 199 else if 2 = 6 then 384 else if 2 = 7 then 659 else if 2 = 8 then 1056 else if 2 = 9 then 1601 else if 2 = 10 then 2310 else if 2 = 38 then 207936 else 2) = 8 := rfl
      rw [h_val] at hsq
      exact (not_sq_8 hsq).elim
    · have h_val : (if 3 = 1 then 2 else if 3 = 2 then 8 else if 3 = 3 then 31 else if 3 = 4 then 88 else if 3 = 5 then 199 else if 3 = 6 then 384 else if 3 = 7 then 659 else if 3 = 8 then 1056 else if 3 = 9 then 1601 else if 3 = 10 then 2310 else if 3 = 38 then 207936 else 2) = 31 := rfl
      rw [h_val] at hsq
      exact (not_sq_31 hsq).elim
    · have h_val : (if 4 = 1 then 2 else if 4 = 2 then 8 else if 4 = 3 then 31 else if 4 = 4 then 88 else if 4 = 5 then 199 else if 4 = 6 then 384 else if 4 = 7 then 659 else if 4 = 8 then 1056 else if 4 = 9 then 1601 else if 4 = 10 then 2310 else if 4 = 38 then 207936 else 2) = 88 := rfl
      rw [h_val] at hsq
      exact (not_sq_88 hsq).elim
    · have h_val : (if 5 = 1 then 2 else if 5 = 2 then 8 else if 5 = 3 then 31 else if 5 = 4 then 88 else if 5 = 5 then 199 else if 5 = 6 then 384 else if 5 = 7 then 659 else if 5 = 8 then 1056 else if 5 = 9 then 1601 else if 5 = 10 then 2310 else if 5 = 38 then 207936 else 2) = 199 := rfl
      rw [h_val] at hsq
      exact (not_sq_199 hsq).elim
    · have h_val : (if 6 = 1 then 2 else if 6 = 2 then 8 else if 6 = 3 then 31 else if 6 = 4 then 88 else if 6 = 5 then 199 else if 6 = 6 then 384 else if 6 = 7 then 659 else if 6 = 8 then 1056 else if 6 = 9 then 1601 else if 6 = 10 then 2310 else if 6 = 38 then 207936 else 2) = 384 := rfl
      rw [h_val] at hsq
      exact (not_sq_384 hsq).elim
    · have h_val : (if 7 = 1 then 2 else if 7 = 2 then 8 else if 7 = 3 then 31 else if 7 = 4 then 88 else if 7 = 5 then 199 else if 7 = 6 then 384 else if 7 = 7 then 659 else if 7 = 8 then 1056 else if 7 = 9 then 1601 else if 7 = 10 then 2310 else if 7 = 38 then 207936 else 2) = 659 := rfl
      rw [h_val] at hsq
      exact (not_sq_659 hsq).elim
    · have h_val : (if 8 = 1 then 2 else if 8 = 2 then 8 else if 8 = 3 then 31 else if 8 = 4 then 88 else if 8 = 5 then 199 else if 8 = 6 then 384 else if 8 = 7 then 659 else if 8 = 8 then 1056 else if 8 = 9 then 1601 else if 8 = 10 then 2310 else if 8 = 38 then 207936 else 2) = 1056 := rfl
      rw [h_val] at hsq
      exact (not_sq_1056 hsq).elim
    · have h_val : (if 9 = 1 then 2 else if 9 = 2 then 8 else if 9 = 3 then 31 else if 9 = 4 then 88 else if 9 = 5 then 199 else if 9 = 6 then 384 else if 9 = 7 then 659 else if 9 = 8 then 1056 else if 9 = 9 then 1601 else if 9 = 10 then 2310 else if 9 = 38 then 207936 else 2) = 1601 := rfl
      rw [h_val] at hsq
      exact (not_sq_1601 hsq).elim
    · have h_val : (if 10 = 1 then 2 else if 10 = 2 then 8 else if 10 = 3 then 31 else if 10 = 4 then 88 else if 10 = 5 then 199 else if 10 = 6 then 384 else if 10 = 7 then 659 else if 10 = 8 then 1056 else if 10 = 9 then 1601 else if 10 = 10 then 2310 else if 10 = 38 then 207936 else 2) = 2310 := rfl
      rw [h_val] at hsq
      exact (not_sq_2310 hsq).elim
  · -- n > 10
    by_cases hn38 : n = 38
    · exact hn38
    · have h_get : (if n = 1 then 2 else if n = 2 then 8 else if n = 3 then 31 else if n = 4 then 88 else if n = 5 then 199 else if n = 6 then 384 else if n = 7 then 659 else if n = 8 then 1056 else if n = 9 then 1601 else if n = 10 then 2310 else if n = 38 then 207936 else 2) = 2 := by
        have hn1 : n ≠ 1 := by omega
        have hn2 : n ≠ 2 := by omega
        have hn3 : n ≠ 3 := by omega
        have hn4 : n ≠ 4 := by omega
        have hn5 : n ≠ 5 := by omega
        have hn6 : n ≠ 6 := by omega
        have hn7 : n ≠ 7 := by omega
        have hn8 : n ≠ 8 := by omega
        have hn9 : n ≠ 9 := by omega
        have hn10 : n ≠ 10 := by omega
        rw [if_neg hn1, if_neg hn2, if_neg hn3, if_neg hn4, if_neg hn5, if_neg hn6, if_neg hn7, if_neg hn8, if_neg hn9, if_neg hn10, if_neg hn38]
      rw [h_get] at hsq
      exact (not_sq_2 hsq).elim

