import FormalConjectures.Util.ProblemImports

open Nat Set

set_option linter.unusedVariables false
set_option maxRecDepth 200000
set_option exponentiation.threshold 100000

def fast_pow_fuel (fuel : Nat) (base : Nat) (n : Nat) : Nat :=
  match fuel with
  | 0 => 1
  | f + 1 =>
    if n = 0 then 1
    else if n = 1 then base
    else if n % 2 == 0 then
      let half := fast_pow_fuel f base (n / 2)
      half * half
    else
      base * fast_pow_fuel f base (n - 1)

def fast_pow (base n : Nat) : Nat :=
  fast_pow_fuel 40 base n

def p_def : Nat := 2 * 100943 * 3^39101 - 1
def p : Nat := 2 * 100943 * fast_pow 3 39101 - 1

theorem p_eq : p = p_def := by decide

abbrev R (n : Nat) := ZMod n × ZMod n

namespace R
def mul {n : ℕ} (x y : R n) : R n :=
  (x.1 * y.1 + 3 * x.2 * y.2, x.1 * y.2 + x.2 * y.1)

def pow {n : ℕ} (x : R n) : ℕ → R n
  | 0 => (1, 0)
  | k + 1 => mul x (pow x k)

def map_R {p r : ℕ} (h : r ∣ p) (x : R p) : R r :=
  (ZMod.castHom h (ZMod r) x.1, ZMod.castHom h (ZMod r) x.2)

theorem map_R_mul {p r : ℕ} (h : r ∣ p) (x y : R p) :
    map_R h (mul x y) = mul (map_R h x) (map_R h y) := by
  rcases x with ⟨a, b⟩
  rcases y with ⟨c, e⟩
  simp only [map_R, mul, map_add, map_mul, map_ofNat]

theorem map_R_pow {p r : ℕ} (h : r ∣ p) (x : R p) (i : ℕ) :
    map_R h (pow x i) = pow (map_R h x) i := by
  induction i with
  | zero =>
    simp only [pow, map_R, map_one, map_zero]
  | succ i ih =>
    simp only [pow, map_R_mul]
    rw [ih]

def IsUnit {n : ℕ} (x : R n) : Prop :=
  ∃ y : R n, mul x y = (1, 0)

theorem map_R_isUnit {p r : ℕ} (h : r ∣ p) (x : R p) (hu : IsUnit x) :
    IsUnit (map_R h x) := by
  rcases hu with ⟨y, hy⟩
  use map_R h y
  rw [← map_R_mul, hy]
  simp only [map_R, map_one, map_zero]

theorem mul_zero {n : ℕ} (x : R n) : mul (0, 0) x = (0, 0) := by
  rcases x with ⟨a, b⟩
  simp only [mul]
  apply Prod.ext <;> ring

theorem isUnit_ne_zero {n : ℕ} (hn : n > 1) (x : R n) (hu : IsUnit x) : x ≠ (0, 0) := by
  intro hx
  rcases hu with ⟨y, hy⟩
  rw [hx, mul_zero] at hy
  have h_fst : (0 : ZMod n) = 1 := by
    injection hy
  have h_ne : (1 : ZMod n) ≠ 0 := by
    intro h
    have h_val : (1 : ZMod n).val = (0 : ZMod n).val := by rw [h]
    haveI : Fact (1 < n) := ⟨hn⟩
    rw [ZMod.val_one, ZMod.val_zero] at h_val
    omega
  exact h_ne h_fst.symm

def sub {n : ℕ} (x y : R n) : R n :=
  (x.1 - y.1, x.2 - y.2)

theorem sub_map_R {p r : ℕ} (h : r ∣ p) (x y : R p) :
    map_R h (sub x y) = sub (map_R h x) (map_R h y) := by
  rcases x with ⟨a, b⟩
  rcases y with ⟨c, e⟩
  simp only [sub, map_R, map_sub]

theorem pow_div_ne_one {p r : ℕ} (hr : r > 1) (h : r ∣ p)
    (u v : R p) (k q : ℕ) (h_unit : IsUnit (sub (pow u (k / q)) (1, 0))) :
    pow (map_R h u) (k / q) ≠ (1, 0) := by
  intro h_eq
  have h_unit_r := map_R_isUnit h (sub (pow u (k / q)) (1, 0)) h_unit
  rw [sub_map_R, map_R_pow, h_eq] at h_unit_r
  have h_one : map_R h (1, 0) = (1, 0) := by
    simp only [map_R, map_one, map_zero]
  rw [h_one] at h_unit_r
  have h_zero : sub ((1, 0) : R r) (1, 0) = (0, 0) := by
    simp only [sub, sub_self]
  rw [h_zero] at h_unit_r
  exact isUnit_ne_zero hr (0, 0) h_unit_r rfl

theorem mul_comm {n : ℕ} (x y : R n) : mul x y = mul y x := by
  rcases x with ⟨a, b⟩
  rcases y with ⟨c, e⟩
  simp only [mul]
  apply Prod.ext <;> ring

theorem one_mul {n : ℕ} (x : R n) : mul (1, 0) x = x := by
  rcases x with ⟨a, b⟩
  simp only [mul]
  apply Prod.ext <;> ring

theorem mul_one {n : ℕ} (x : R n) : mul x (1, 0) = x := by
  rw [mul_comm, one_mul]

theorem mul_assoc {n : ℕ} (x y z : R n) : mul x (mul y z) = mul (mul x y) z := by
  rcases x with ⟨a, b⟩
  rcases y with ⟨c, e⟩
  rcases z with ⟨g, h⟩
  simp only [mul]
  apply Prod.ext <;> ring
end R

theorem pow_add_R {n : ℕ} (x : R n) (a b : ℕ) : R.pow x (a + b) = R.mul (R.pow x a) (R.pow x b) := by
  induction a with
  | zero => simp only [Nat.zero_add, R.pow, R.one_mul]
  | succ a ih => simp only [Nat.succ_add, R.pow]; rw [ih, R.mul_assoc]

theorem pow_mul_R {n : ℕ} (x : R n) (a b : ℕ) : R.pow x (a * b) = R.pow (R.pow x a) b := by
  induction b with
  | zero => simp only [Nat.mul_zero, R.pow]
  | succ b ih =>
    have h_add : a * (b + 1) = a * b + a := by ring
    rw [h_add, pow_add_R, ih, R.pow, R.mul_comm]

theorem R_pow_one {n : ℕ} (c : ℕ) : R.pow ((1, 0) : R n) c = (1, 0) := by
  induction c with
  | zero => rfl
  | succ c ih => simp only [R.pow, R.one_mul, ih]

def mul_nat (x y : Nat × Nat) : Nat × Nat :=
  ((x.1 * y.1 + 3 * x.2 * y.2) % p, (x.1 * y.2 + x.2 * y.1) % p)

def triple_nat (x : Nat × Nat) : Nat × Nat :=
  mul_nat x (mul_nat x x)

def triple_loop : Nat → Nat × Nat → Nat × Nat
  | 0, x => x
  | n + 1, x => triple_loop n (triple_nat x)

def to_R (x : Nat × Nat) : R p :=
  (x.1, x.2)

theorem to_R_mul (x y : Nat × Nat) : to_R (mul_nat x y) = R.mul (to_R x) (to_R y) := by
  rcases x with ⟨a, b⟩
  rcases y with ⟨c, e⟩
  simp [to_R, mul_nat, R.mul]

theorem to_R_triple (x : Nat × Nat) : to_R (triple_nat x) = R.pow (to_R x) 3 := by
  simp only [triple_nat, to_R_mul]
  have h_pow3 : R.pow (to_R x) 3 = R.mul (to_R x) (R.mul (to_R x) (R.mul (to_R x) (1, 0))) := rfl
  rw [h_pow3, R.mul_one]

theorem to_R_triple_loop (n : Nat) (x : Nat × Nat) :
    to_R (triple_loop n x) = R.pow (to_R x) (3^n) := by
  induction n generalizing x with
  | zero =>
    simp only [triple_loop, Nat.pow_zero]
    have h1 : R.pow (to_R x) 1 = R.mul (to_R x) (1, 0) := rfl
    rw [h1, R.mul_one]
  | succ n ih =>
    simp only [triple_loop]
    rw [ih (triple_nat x), to_R_triple]
    have h_pow : 3^(n + 1) = 3 * 3^n := by ring
    rw [h_pow, ← pow_mul_R]

theorem triple_loop_add (a b : Nat) (x : Nat × Nat) :
    triple_loop (a + b) x = triple_loop a (triple_loop b x) := by
  induction b generalizing x with
  | zero => rfl
  | succ b ih =>
    exact ih (triple_nat x)

def bin_pow_fuel (fuel : Nat) (x : Nat × Nat) (n : Nat) : Nat × Nat :=
  match fuel with
  | 0 => (1, 0)
  | f + 1 =>
    if n = 0 then (1, 0)
    else if n = 1 then x
    else if n % 2 = 0 then
      let half := bin_pow_fuel f x (n / 2)
      mul_nat half half
    else
      mul_nat x (bin_pow_fuel f x (n - 1))

def bin_pow_nat (x : Nat × Nat) (n : Nat) : Nat × Nat :=
  bin_pow_fuel 40 x n

def z_start : Nat × Nat := (2, 1)
def z_0 : Nat × Nat := (2, 1)
def z_final : Nat × Nat := (, ) :
def w_final : Nat × Nat := (, )
def u_39_100 : Nat × Nat := (, )

theorem z_start_39101 : triple_loop 39101 (2, 1) = z_final := rfl

def u_start : Nat × Nat := bin_pow_nat (2, 1) 201886
def v_start : Nat × Nat := bin_pow_nat (2, 1) 100943
def w_start : Nat × Nat := bin_pow_nat (2, 1) 2

theorem u_start_39101_eq_one : triple_loop 39101 u_start = (1, 0) := rfl
theorem v_start_39101 : triple_loop 39101 v_start = (p - 1, 0) := rfl
theorem w_start_39101 : triple_loop 39101 w_start = w_final := rfl

theorem u_39100_eq : triple_loop 39100 u_start = u_39_100 := rfl

-- Unit theorems
def u_half_sub_one : Nat × Nat := (p - 2, 0)
def u_half_sub_one_inv : Nat × Nat := (, 0)
theorem unit_2 : R.IsUnit (to_R u_half_sub_one) := ⟨to_R u_half_sub_one_inv, by rfl⟩

def u_39_100_sub_one : Nat × Nat := (u_39_100.1 - 1, u_39_100.2)
def u_39_100_sub_one_inv : Nat × Nat := (, )
theorem unit_3 : R.IsUnit (to_R u_39_100_sub_one) := ⟨to_R u_39_100_sub_one_inv, by rfl⟩

def w_final_sub_one : Nat × Nat := (w_final.1 - 1, w_final.2)
def w_final_sub_one_inv : Nat × Nat := (, )
theorem unit_100943 : R.IsUnit (to_R w_final_sub_one) := ⟨to_R w_final_sub_one_inv, by rfl⟩

theorem prime_100943 : Nat.Prime 100943 := by
  rw [Nat.prime_def_le_sqrt]
  refine ⟨by decide, ?_⟩
  intro m hm_2 hm_sqrt
  have h_sqrt_eq : Nat.sqrt 100943 = 317 := by
    rw [eq_comm, Nat.eq_sqrt]
    decide
  rw [h_sqrt_eq] at hm_sqrt
  have h_dec : ∀ m : ℕ, 2 ≤ m → m ≤ 317 → ¬ m ∣ 100943 := by decide
  exact h_dec m hm_2 hm_sqrt

theorem prime_divisors_of_K {q : ℕ} (hq : Nat.Prime q) (hdvd : q ∣ 2 * 100943 * 3^39101) : q = 2 ∨ q = 3 ∨ q = 100943 := by
  have hq_prime : q.Prime := hq
  have h_dvd : q ∣ 2 * 100943 ∨ q ∣ 3^39101 := (Nat.Prime.dvd_mul hq_prime).mp hdvd
  rcases h_dvd with h1 | h2
  · have hq_dvd : q ∣ 2 ∨ q ∣ 100943 := (Nat.Prime.dvd_mul hq_prime).mp h1
    rcases hq_dvd with h2_dvd | h100943_dvd
    · left
      have h_or := Nat.prime_two.eq_one_or_self_of_dvd q h2_dvd
      rcases h_or with h_one | h_self
      · exfalso; exact hq_prime.ne_one h_one
      · exact h_self
    · right; right
      have h_or := prime_100943.eq_one_or_self_of_dvd q h100943_dvd
      rcases h_or with h_one | h_self
      · exfalso; exact hq_prime.ne_one h_one
      · exact h_self
  · right; left
    have hq_dvd_3 : q ∣ 3 := hq_prime.dvd_of_dvd_pow h2
    have h_or := Nat.prime_three.eq_one_or_self_of_dvd q hq_dvd_3
    rcases h_or with h_one | h_self
    · exfalso; exact hq_prime.ne_one h_one
    · exact h_self

theorem pow_mod_eq_one {n : ℕ} (u v : R n) (h_inv : R.mul u v = (1, 0)) (b : ℕ) (hb : b > 0)
    (hb_pow : R.pow u b = (1, 0)) : ∀ a : ℕ, R.pow u a = (1, 0) → R.pow u (a % b) = (1, 0) := by
  intro a
  induction a using Nat.strong_induction_on with
  | h a ih =>
    intro ha
    by_cases h_lt : a < b
    · rw [Nat.mod_eq_of_lt h_lt]
      exact ha
    · have h_ge : b ≤ a := by omega
      rw [Nat.mod_eq_sub_mod h_ge]
      apply ih (a - b) (by omega)
      have h_split : R.pow u a = R.mul (R.pow u b) (R.pow u (a - b)) := by
        have : a = b + (a - b) := by omega
        conv_lhs => rw [this]
        rw [pow_add_R]
      have h_eq : R.mul (R.pow u a) (R.pow v b) = R.mul (R.mul (R.pow u b) (R.pow u (a - b))) (R.pow v b) := by rw [h_split]
      rw [ha] at h_eq
      have h_eq3 : R.mul ((1, 0) : R n) (R.pow v b) = R.pow v b := by rw [R.one_mul]
      have h_eq4 : R.mul (R.mul (R.pow u b) (R.pow u (a - b))) (R.pow v b) = R.mul (R.mul (R.pow u b) (R.pow v b)) (R.pow u (a - b)) := by
        rcases R.pow u b with ⟨u1, u2⟩
        rcases R.pow v b with ⟨v1, v2⟩
        rcases R.pow u (a - b) with ⟨w1, w2⟩
        simp only [R.mul]
        apply Prod.ext <;> ring
      have h_inv_b : R.mul (R.pow u b) (R.pow v b) = (1, 0) := by
        induction b with
        | zero => rfl
        | succ b ih_b =>
          have h1 : R.mul (R.mul u (R.pow u b)) (R.mul v (R.pow v b)) = R.mul (R.mul u v) (R.mul (R.pow u b) (R.pow v b)) := by
            rcases u with ⟨u1, u2⟩
            rcases v with ⟨v1, v2⟩
            rcases R.pow u b with ⟨ui1, ui2⟩
            rcases R.pow v b with ⟨vi1, vi2⟩
            simp only [R.mul]
            apply Prod.ext <;> ring
          change R.mul (R.pow u (b + 1)) (R.pow v (b + 1)) = (1, 0)
          simp only [R.pow]
          rw [h1, h_inv, ih_b, R.mul_one]
      rw [h_eq4, h_inv_b, R.one_mul] at h_eq
      rw [h_eq3] at h_eq
      have hb_v : R.pow v b = (1, 0) := by
        rw [hb_pow, R.one_mul] at h_inv_b
        exact h_inv_b
      rw [hb_v] at h_eq
      exact h_eq.symm

theorem pow_dvd_of_minimal {n : ℕ} (u v : R n) (h_inv : R.mul u v = (1, 0)) (b : ℕ) (hb : b > 0) (hb_pow : R.pow u b = (1, 0)) (h_min : ∀ m : ℕ, m > 0 → R.pow u m = (1, 0) → b ≤ m) (a : ℕ) (ha_pow : R.pow u a = (1, 0)) : b ∣ a := by
  have h_mod := pow_mod_eq_one u v h_inv b hb hb_pow a ha_pow
  by_cases h_zero : a % b = 0
  · exact Nat.dvd_of_mod_eq_zero h_zero
  · have h_gt : a % b > 0 := Nat.pos_of_ne_zero h_zero
    have h_lt : a % b < b := Nat.mod_lt a hb
    have h_ge := h_min (a % b) h_gt h_mod
    omega

theorem minimal_order_from_prime_factors {n : ℕ} (u v : R n) (h_inv : R.mul u v = (1, 0))
    (k : ℕ) (hk_pos : k > 0) (hk_pow : R.pow u k = (1, 0))
    (h_prime_factors : ∀ q : ℕ, Nat.Prime q → q ∣ k → R.pow u (k / q) ≠ (1, 0)) :
    ∀ m : ℕ, m > 0 → R.pow u m = (1, 0) → k ≤ m := by
  intro m hm hm_pow
  have h_exists : ∃ d : ℕ, d > 0 ∧ R.pow u d = (1, 0) := ⟨k, hk_pos, hk_pow⟩
  let d := Nat.find h_exists
  have hd : d > 0 ∧ R.pow u d = (1, 0) := Nat.find_spec h_exists
  have h_min : ∀ x : ℕ, x > 0 → R.pow u x = (1, 0) → d ≤ x := by
    intro x hx hx_pow
    exact Nat.find_min' h_exists ⟨hx, hx_pow⟩
  have hd_dvd_k : d ∣ k := pow_dvd_of_minimal u v h_inv d hd.1 hd.2 h_min k hk_pow
  by_contra h_lt
  have h_ne : d ≠ k := by omega
  have hd_lt : d < k := Nat.lt_of_le_of_ne (Nat.le_of_dvd hk_pos hd_dvd_k) h_ne
  have h_div_ne : k / d ≠ 1 := by
    intro hc
    apply h_ne
    have h_mul := Nat.div_mul_cancel hd_dvd_k
    rw [hc, Nat.mul_one] at h_mul
    exact h_mul.symm
  obtain ⟨q, hq_prime, hq_dvd⟩ := Nat.exists_prime_and_dvd h_div_ne
  obtain ⟨c, hc⟩ := hq_dvd
  have h_k_eq : k = q * (d * c) := by
    have h_mul := Nat.div_mul_cancel hd_dvd_k
    rw [hc] at h_mul
    rw [← h_mul]
    ring
  have h_div_q : k / q = d * c := by
    rw [h_k_eq]
    exact Nat.mul_div_cancel_left _ hq_prime.pos
  have h_pow_q : R.pow u (k / q) = R.pow (R.pow u d) c := by
    rw [h_div_q, pow_mul_R]
  rw [hd.2, pow_one] at h_pow_q
  have hq_dvd_k : q ∣ k := by
    obtain ⟨c, hc⟩ := hq_dvd
    have h_mul := Nat.div_mul_cancel hd_dvd_k
    rw [hc] at h_mul
    rw [← h_mul]
    rw [Nat.mul_comm d, Nat.mul_assoc]
    exact dvd_mul_right q (d * c)
  have h_not := h_prime_factors q hq_prime hq_dvd_k
  exact h_not h_pow_q

theorem card_R (n : ℕ) [NeZero n] : Fintype.card (R n) = n * n := by
  simp only [R, Fintype.card_prod, ZMod.card]

theorem card_R_nonzero (n : ℕ) [NeZero n] :
    Fintype.card { x : R n // x ≠ (0, 0) } = n * n - 1 := by
  classical
  have h_eq : Fintype.card { x : R n // x = (0, 0) } = 1 :=
    Fintype.card_subtype_eq ((0, 0) : R n)
  have h_compl := Fintype.card_subtype_compl (fun x : R n => x ≠ (0, 0))
  simp only [not_not] at h_compl
  omega

theorem pow_inj_of_minimal {n : ℕ} (u v : R n) (h_inv : R.mul u v = (1, 0))
    (k : ℕ) (hk_pow : R.pow u k = (1, 0))
    (h_min : ∀ m : ℕ, m > 0 → R.pow u m = (1, 0) → k ≤ m) :
    ∀ i < k, ∀ j < k, R.pow u i = R.pow u j → i = j := by
  intro i hi j hj h_eq
  rcases lt_trichotomy i j with h_lt | rfl | h_gt
  · have h_diff : j - i > 0 := by omega
    have h_diff_lt : j - i < k := by omega
    have h_split : R.pow u j = R.mul (R.pow u i) (R.pow u (j - i)) := by
      have : j = i + (j - i) := by omega
      conv_lhs => rw [this]
      rw [pow_add_R]
    have h_eq2 : R.mul (R.pow u j) (R.pow v i) = R.mul (R.mul (R.pow u i) (R.pow u (j - i))) (R.pow v i) := by
      rw [h_split]
    have h_eq3 : R.mul (R.pow u j) (R.pow v i) = R.mul (R.pow u i) (R.pow v i) := by
      rw [← h_eq]
    have h_inv_i : R.mul (R.pow u i) (R.pow v i) = (1, 0) := by
      induction i with
      | zero => rfl
      | succ i ih_i =>
        have h1 : R.mul (R.mul u (R.pow u i)) (R.mul v (R.pow v i)) = R.mul (R.mul u v) (R.mul (R.pow u i) (R.pow v i)) := by
          rcases u with ⟨u1, u2⟩
          rcases v with ⟨v1, v2⟩
          rcases R.pow u i with ⟨ui1, ui2⟩
          rcases R.pow v i with ⟨vi1, vi2⟩
          simp only [R.mul]
          apply Prod.ext <;> ring
        change R.mul (R.pow u (i + 1)) (R.pow v (i + 1)) = (1, 0)
        simp only [R.pow]
        rw [h1, h_inv, ih_i, R.mul_one]
    rw [h_inv_i] at h_eq3
    have h_eq4 : R.mul (R.mul (R.pow u i) (R.pow u (j - i))) (R.pow v i) = R.mul (R.mul (R.pow u i) (R.pow v i)) (R.pow u (j - i)) := by
      rcases R.pow u i with ⟨u1, u2⟩
      rcases R.pow v i with ⟨v1, v2⟩
      rcases R.pow u (j - i) with ⟨w1, w2⟩
      simp only [R.mul]
      apply Prod.ext <;> ring
    rw [h_eq4, h_inv_i, R.one_mul] at h_eq2
    rw [h_eq3] at h_eq2
    have h_ge := h_min (j - i) h_diff h_eq2.symm
    omega
  · rfl
  · have h_diff : i - j > 0 := by omega
    have h_diff_lt : i - j < k := by omega
    have h_split : R.pow u i = R.mul (R.pow u j) (R.pow u (i - j)) := by
      have : i = j + (i - j) := by omega
      conv_lhs => rw [this]
      rw [pow_add_R]
    have h_eq2 : R.mul (R.pow u i) (R.pow v j) = R.mul (R.mul (R.pow u j) (R.pow u (i - j))) (R.pow v j) := by
      rw [h_split]
    have h_eq3 : R.mul (R.pow u i) (R.pow v j) = R.mul (R.pow u j) (R.pow v j) := by
      rw [h_eq]
    have h_inv_j : R.mul (R.pow u j) (R.pow v j) = (1, 0) := by
      induction j with
      | zero => rfl
      | succ j ih_j =>
        have h1 : R.mul (R.mul u (R.pow u j)) (R.mul v (R.pow v j)) = R.mul (R.mul u v) (R.mul (R.pow u j) (R.pow v j)) := by
          rcases u with ⟨u1, u2⟩
          rcases v with ⟨v1, v2⟩
          rcases R.pow u j with ⟨ui1, ui2⟩
          rcases R.pow v j with ⟨vi1, vi2⟩
          simp only [R.mul]
          apply Prod.ext <;> ring
        change R.mul (R.pow u (j + 1)) (R.pow v (j + 1)) = (1, 0)
        simp only [R.pow]
        rw [h1, h_inv, ih_j, R.mul_one]
    rw [h_inv_j] at h_eq3
    have h_eq4 : R.mul (R.mul (R.pow u j) (R.pow u (i - j))) (R.pow v j) = R.mul (R.mul (R.pow u j) (R.pow v j)) (R.pow u (i - j)) := by
      rcases R.pow u j with ⟨u1, u2⟩
      rcases R.pow v j with ⟨v1, v2⟩
      rcases R.pow u (i - j) with ⟨w1, w2⟩
      simp only [R.mul]
      apply Prod.ext <;> ring
    rw [h_eq4, h_inv_j, R.one_mul] at h_eq2
    rw [h_eq3] at h_eq2
    have h_ge := h_min (i - j) h_diff h_eq2.symm
    omega

theorem pow_ne_zero {n : ℕ} (hn : n > 1) (u v : R n) (h_inv : R.mul u v = (1, 0))
    (k : ℕ) (hk_pow : R.pow u k = (1, 0))
    (i : ℕ) (hi : i < k) : R.pow u i ≠ (0, 0) := by
  intro h_zero
  have h_eq2 : R.mul (R.pow u i) (R.pow v i) = R.mul (0, 0) (R.pow v i) := by rw [h_zero]
  have h_inv_i : R.mul (R.pow u i) (R.pow v i) = (1, 0) := by
    induction i with
    | zero => rfl
    | succ i ih_i =>
      have h1 : R.mul (R.mul u (R.pow u i)) (R.mul v (R.pow v i)) = R.mul (R.mul u v) (R.mul (R.pow u i) (R.pow v i)) := by
        rcases u with ⟨u1, u2⟩
        rcases v with ⟨v1, v2⟩
        rcases R.pow u i with ⟨ui1, ui2⟩
        rcases R.pow v i with ⟨vi1, vi2⟩
        simp only [R.mul]
        apply Prod.ext <;> ring
      change R.mul (R.pow u (i + 1)) (R.pow v (i + 1)) = (1, 0)
      simp only [R.pow]
      rw [h1, h_inv, ih_i, R.mul_one]
  rw [h_inv_i, R.mul_zero] at h_eq2
  have h_fst : (0 : ZMod n) = 1 := by
    injection h_eq2
  have h_ne : (1 : ZMod n) ≠ 0 := by
    intro h
    have h_val : (1 : ZMod n).val = (0 : ZMod n).val := by rw [h]
    haveI : Fact (1 < n) := ⟨hn⟩
    rw [ZMod.val_one, ZMod.val_zero] at h_val
    omega
  exact h_ne h_fst.symm

theorem primality_of_order {p : ℕ} (hp1 : p > 1) (u v : R p) (h_inv : R.mul u v = (1, 0))
    (k : ℕ) (hk_pow : R.pow u k = (1, 0))
    (h_min : ∀ m : ℕ, m > 0 → R.pow u m = (1, 0) → k ≤ m)
    (r : ℕ) (hr : Nat.Prime r) (h_dvd : r ∣ p) :
    k ≤ r * r - 1 := by
  have hr1 : r > 1 := hr.one_lt
  haveI : NeZero r := ⟨by omega⟩
  let ur := R.map_R h_dvd u
  let vr := R.map_R h_dvd v
  have h_inv_r : R.mul ur vr = (1, 0) := by
    dsimp [ur, vr]
    rw [← R.map_R_mul, h_inv]
    simp only [R.map_R, map_one, map_zero]
  have h_min_r : ∀ m : ℕ, m > 0 → R.pow ur m = (1, 0) → k ≤ m := by
    intro m hm hm_pow
    apply h_min m hm
    have h_pow : R.map_R h_dvd (R.pow u m) = R.pow ur m := R.map_R_pow h_dvd u m
    rw [hm_pow] at h_pow
    have h_one : R.map_R h_dvd (1, 0) = (1, 0) := by
      simp only [R.map_R, map_one, map_zero]
    rw [← h_one] at h_pow
    rcases R.pow u m with ⟨a, b⟩
    simp only [R.map_R, Prod.mk.injEq] at h_pow
    have h1 : ZMod.castHom h_dvd (ZMod r) a = ZMod.castHom h_dvd (ZMod r) 1 := h_pow.1
    have h2 : ZMod.castHom h_dvd (ZMod r) b = ZMod.castHom h_dvd (ZMod r) 0 := h_pow.2
    ext
    · change a = 1
      exact ZMod.castHom_injective h_dvd h1
    · change b = 0
      exact ZMod.castHom_injective h_dvd h2
  have h_inj := pow_inj_of_minimal ur vr h_inv_r k (R.map_R_pow h_dvd u k ▸ congr_arg (R.map_R h_dvd) hk_pow) h_min_r
  have h_pow_nonzero : ∀ i < k, R.pow ur i ≠ (0, 0) := by
    intro i hi
    apply pow_ne_zero hr1 ur vr h_inv_r k (R.map_R_pow h_dvd u k ▸ congr_arg (R.map_R h_dvd) hk_pow) i hi
  let f : Fin k → { x : R r // x ≠ (0, 0) } := fun i => ⟨R.pow ur i.val, h_pow_nonzero i.val i.is_lt⟩
  have h_f_inj : Function.Injective f := by
    intro x y hxy
    simp only [f, Subtype.mk.injEq] at hxy
    have h_eq_val := h_inj x.val x.is_lt y.val y.is_lt hxy
    ext
    exact h_eq_val
  have h_le := Fintype.card_le_of_injective f h_f_inj
  rw [Fintype.card_fin, card_R_nonzero r] at h_le
  exact h_le

theorem prime_p : Nat.Prime p := by
  have hp_gt : p > 1 := by
    unfold p
    have : 2 * 100943 * 3^39101 > 2 := by
      have : 3^39101 >= 3 := by
        have : 3^39101 = 3 * 3^39100 := by rfl
        rw [this]
        omega
      omega
    omega
  have hu_final_eq_one : R.pow ((2, 1) : R p) (p + 1) = (1, 0) := by
    have h_k : p + 1 = 2 * 100943 * 3^39101 := by
      unfold p
      omega
    have h_pow : R.pow ((2, 1) : R p) (2 * 100943 * 3^39101) = to_R (triple_loop 39101 u_start) := by
      rw [to_R_triple_loop, to_R]
      rfl
    rw [h_k, h_pow, u_start_39101_eq_one]
    rfl
  have h_prime_factors : ∀ q : ℕ, Nat.Prime q → q ∣ p + 1 → R.pow ((2, 1) : R p) ((p + 1) / q) ≠ (1, 0) := by
    intro q hq hdvd
    have h_k : p + 1 = 2 * 100943 * 3^39101 := by
      unfold p
      omega
    rw [h_k] at hdvd
    have h_divs := prime_divisors_of_K hq hdvd
    rcases h_divs with h_2 | h_3 | h_100943
    · -- q = 2
      rw [h_2]
      have h_div : (p + 1) / 2 = 100943 * 3^39101 := by
        rw [h_k]
        omega
      have h_pow_half : R.pow ((2, 1) : R p) ((p + 1) / 2) = to_R (p - 1, 0) := by
        rw [h_k, to_R_triple_loop, to_R]
        have h_eq : triple_loop 39101 v_start = (p - 1, 0) := v_start_39101
        rw [h_eq]
      rw [h_pow_half]
      intro hc
      simp only [to_R, Prod.mk.injEq] at hc
      have h_ne : (p - 1 : ZMod p) ≠ 1 := by
        intro hc2
        have h_val : (p - 1 : ZMod p).val = (1 : ZMod p).val := congr_arg ZMod.val hc2
        haveI : Fact (1 < p) := ⟨hp_gt⟩
        rw [ZMod.val_one] at h_val
        have h_val_p : (p - 1 : ZMod p).val = p - 1 := by
          rw [ZMod.val_cast_of_lt]
          omega
        rw [h_val_p] at h_val
        omega
      exact h_ne hc.1
    · -- q = 3
      rw [h_3]
      have h_div : (p + 1) / 3 = 2 * 100943 * 3^39100 := by
        rw [h_k]
        omega
      have h_pow_3 : R.pow ((2, 1) : R p) ((p + 1) / 3) = to_R u_39_100 := by
        rw [h_k, to_R_triple_loop, to_R]
        rfl
      rw [h_pow_3]
      apply R.pow_div_ne_one hp_gt (by rfl) (2, 1) (2, p-1) (by rfl) (p+1) 3 unit_3
    · -- q = 100943
      rw [h_100943]
      have h_div : (p + 1) / 100943 = 2 * 3^39101 := by
        rw [h_k]
        omega
      have h_pow_100943 : R.pow ((2, 1) : R p) ((p + 1) / 100943) = to_R w_final := by
        rw [h_k, to_R_triple_loop, to_R]
        rfl
      rw [h_pow_100943]
      apply R.pow_div_ne_one hp_gt (by rfl) (2, 1) (2, p-1) (by rfl) (p+1) 100943 unit_100943
  have h_min := minimal_order_from_prime_factors ((2, 1) : R p) (2, p-1) (by rfl) (p + 1) (by omega) hu_final_eq_one h_prime_factors
  by_contra h_composite
  have h_le_sq : minFac p * minFac p ≤ p := by
    have h_sq := minFac_sq_le_self (by omega) h_composite
    rwa [sq] at h_sq
  have h_le := primality_of_order hp_gt ((2, 1) : R p) (2, p-1) (by rfl) (p + 1) hu_final_eq_one h_min (minFac p) (minFac_prime (by omega)) (minFac_dvd p)
  omega

noncomputable def a354747 (n : ℕ) : ℕ :=
  let prime_steps : Set ℕ :=
    { m : ℕ | m > 0 ∧ Nat.Prime (2 * n * 3 ^ m - 1) }
  sInf prime_steps

theorem oeis_a354747_conjecture_0.disproof : ¬ (a354747 100943 = 0) := by
  intro h
  have hp : Nat.Prime (2 * 100943 * 3^39101 - 1) := by
    have hp_p : Nat.Prime p := prime_p
    rwa [p_eq] at hp_p
  have h_39101_gt : 39101 > 0 := by decide
  have h_in_s : 39101 ∈ { m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) } := by
    exact ⟨h_39101_gt, hp⟩
  have h_nonempty : { m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) }.Nonempty := by
    exact ⟨39101, h_in_s⟩
  have h_mem := Nat.sInf_mem h_nonempty
  simp only [mem_setOf_eq] at h_mem
  have h_gt_zero : sInf { m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) } > 0 := h_mem.1
  change sInf { m : ℕ | m > 0 ∧ Nat.Prime (2 * 100943 * 3 ^ m - 1) } = 0 at h
  rw [h] at h_gt_zero
  exact Nat.lt_irrefl 0 h_gt_zero
