def get_witness_from_tree (chunk_idx : Nat) (offset : Nat) : UInt32 :=
  if chunk_idx == 0 then (shiftRight huge_nat_0 (16 * offset) % 65536).toUInt32
  else (shiftRight huge_nat_1 (16 * offset) % 65536).toUInt32

def get_uncovered_index (n : Nat) : Nat :=
  n - (n / 3 + n / 10 - n / 30) - 6

def get_witness_final (n : Nat) : UInt32 :=
  if n % 6 == 3 then (n / 3).toUInt32
  else if n % 10 == 0 then (n / 5).toUInt32
  else if n % 6 == 0 then
    if n % 30 == 0 then (n / 10).toUInt32 else (n / 6).toUInt32
  else
    let idx := get_uncovered_index n - 1
    get_witness_from_tree (idx / 5000) (idx % 5000)

def check_all_loop : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | fuel + 1, L, R =>
    if L > R then true
    else if L == R then
      if L % 6 == 3 ∨ L % 10 == 0 ∨ L % 6 == 0 then true
      else
        let k := get_witness_final L
        if k == 0 then false
        else if k.toNat > (L - 1) / 2 then false
        else
          let tot1 := totient_fast k
          let tot2 := totient_fast (L.toUInt32 - k)
          is_square_fast (tot1 * tot2)
    else
      let mid := (L + R) / 2
      check_all_loop fuel L mid && check_all_loop fuel (mid + 1) R


