def get_witness_from_string (idx : Nat) : Nat :=
  let c1 := String.Pos.Raw.get big_str (String.Pos.Raw.mk (2 * idx))
  let c2 := String.Pos.Raw.get big_str (String.Pos.Raw.mk (2 * idx + 1))
  (c1.toNat - 32) * 90 + (c2.toNat - 32)

def get_uncovered_index (n : Nat) : Nat :=
  n - (n / 3 + n / 10 - n / 30) - 6

def get_witness_final (n : Nat) : Nat :=
  let idx := get_uncovered_index n - 1
  get_witness_from_string idx

def check_all_loop (primes : List Nat) : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | fuel + 1, L, R =>
    if L > R then true
    else if L == R then
      if L % 6 == 3 ∨ L % 10 == 0 ∨ L % 6 == 0 then true
      else
        let k := get_witness_final L
        let prod := totient_fast primes k * totient_fast primes (L - k)
        is_square_fast prod
    else
      let mid := (L + R) / 2
      check_all_loop primes fuel L mid && check_all_loop primes fuel (mid + 1) R

theorem test_10k : check_all_loop primes_1414 25 9 16676 = true := by
  decide
