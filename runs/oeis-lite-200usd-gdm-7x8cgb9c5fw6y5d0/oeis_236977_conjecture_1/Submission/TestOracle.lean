def check_all_loop : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | fuel + 1, n, max_n =>
    if n > max_n then true
    else
      let k := get_witness n
      if k == 0 then false
      else if k > (n - 1) / 2 then false
      else if ¬ is_square_fast (totient_fast k * totient_fast (n - k)) then false
      else check_all_loop fuel (n + 1) max_n

theorem test_decide : check_all_loop 1000 9 1000 = true := by
  decide