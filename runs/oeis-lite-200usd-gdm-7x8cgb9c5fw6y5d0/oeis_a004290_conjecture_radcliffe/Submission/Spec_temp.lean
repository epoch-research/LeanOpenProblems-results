  obtain ⟨i, hi⟩ := mem_digits_iff_getD (by decide) hd'
  rw [hi, Nat.getD_digits 1011011111011011 i (by decide)]
  rcases lt_or_ge i 16 with hi_len | hi_len
  · interval_cases i <;> decide
  · have h_pow : 10 ^ i ≥ 10000000000000000 := by
      calc 10 ^ i ≥ 10 ^ 16 := Nat.pow_le_pow_right (by decide) hi_len
      _ = 10000000000000000 := by decide
    have h_div : 1011011111011011 / 10 ^ i = 0 := by
      apply Nat.div_eq_of_lt
      omega
    rw [h_div]
    decide


