import FormalConjectures.Util.ProblemImports

open Nat Set

/--
A004290: Least positive multiple of $n$ that when written in base 10 uses only 0's and 1's.
-/
noncomputable def A004290 (n : ℕ) : ℕ :=
  -- The set of positive multiples of $n$ that are composed only of 0's and 1's in base 10.
  let S := { m : ℕ | 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 }
  sInf S

theorem mem_digits_iff_getD {b n d : ℕ} (_hb : 2 ≤ b) (h : d ∈ Nat.digits b n) :
    ∃ i, d = (Nat.digits b n).getD i 0 := by
  obtain ⟨i, hi⟩ := List.mem_iff_getElem.mp h
  obtain ⟨h_lt, h_eq⟩ := hi
  use i
  rw [List.getD_eq_getElem (Nat.digits b n) 0 h_lt]
  exact h_eq.symm

theorem digits_pow_10 (k : ℕ) : ∀ d ∈ Nat.digits 10 (10 ^ k), d = 0 ∨ d = 1 := by
  intro d hd
  obtain ⟨i, hi⟩ := mem_digits_iff_getD (by decide) hd
  rw [hi, Nat.getD_digits (10 ^ k) i (by decide)]
  rcases lt_trichotomy i k with hik | rfl | hki
  · have h_sub : k = i + (k - i) := (Nat.add_sub_of_le (Nat.le_of_lt hik)).symm
    nth_rw 1 [h_sub]
    rw [pow_add, Nat.mul_div_cancel_left _ (pow_pos (by decide) i)]
    have h_ge : k - i ≥ 1 := by omega
    rcases h_ki : k - i with _ | m
    · omega
    · rw [pow_succ, mul_comm, Nat.mul_mod_right]
      left; rfl
  · have h_pos : 0 < 10 ^ i := Nat.pow_pos (by decide)
    rw [Nat.div_self h_pos]
    right; rfl
  · rw [Nat.div_eq_of_lt (Nat.pow_lt_pow_right (by decide) hki)]
    rw [Nat.zero_mod]
    left; rfl

theorem A004290_pow_10 (k : ℕ) : A004290 (10 ^ k) = 10 ^ k := by
  have h_le : A004290 (10 ^ k) ≤ 10 ^ k := by
    have h1 : 0 < 10 ^ k := Nat.pow_pos (by decide)
    have h2 : 10 ^ k ∣ 10 ^ k := dvd_rfl
    have h3 := digits_pow_10 k
    have hS : 10 ^ k ∈ { m : ℕ | 0 < m ∧ 10 ^ k ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := ⟨h1, h2, h3⟩
    exact Nat.sInf_le hS
  have h_ge : 10 ^ k ≤ A004290 (10 ^ k) := by
    have h_ne : { m : ℕ | 0 < m ∧ 10 ^ k ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 }.Nonempty := by
      use 10 ^ k
      have h1 : 0 < 10 ^ k := Nat.pow_pos (by decide)
      have h2 : 10 ^ k ∣ 10 ^ k := dvd_rfl
      have h3 := digits_pow_10 k
      exact ⟨h1, h2, h3⟩
    have h_mem := Nat.sInf_mem h_ne
    obtain ⟨h_pos, h_dvd, _⟩ := h_mem
    exact Nat.le_of_dvd h_pos h_dvd
  exact le_antisymm h_le h_ge

theorem dvd_9_pow_10_sub_1 (m : ℕ) : 9 ∣ 10 ^ m - 1 := by
  induction m with
  | zero =>
    decide
  | succ m ih =>
    have h : 10 ^ (m + 1) - 1 = 10 * (10 ^ m - 1) + 9 := by
      have h2 : 10 ^ m ≥ 1 := Nat.pow_pos (by decide)
      omega
    rw [h]
    exact dvd_add (dvd_mul_of_dvd_right ih 10) (by decide)

theorem div_9_identity (X : ℕ) (hX : X ≥ 1) (h_dvd : 9 ∣ X - 1) :
    (10 * X - 1) / 9 = 10 * ((X - 1) / 9) + 1 := by
  omega

theorem ring_poly_identity (Y : ℕ) :
    (9 * Y + 1) ^ 9 = 81 * Y * (
      4782969 * Y ^ 8 +
      4782969 * Y ^ 7 +
      2125764 * Y ^ 6 +
      551124 * Y ^ 5 +
      91854 * Y ^ 4 +
      10206 * Y ^ 3 +
      756 * Y ^ 2 +
      36 * Y + 1
    ) + 1 := by
  ring

theorem dvd_pow_10_sub_1_pow_10_mul (k : ℕ) :
    10 ^ k - 1 ∣ (10 ^ (9 * k) - 1) / 9 := by
  obtain ⟨Y, hY⟩ := dvd_9_pow_10_sub_1 k
  have h_eq : 10 ^ k = 9 * Y + 1 := by
    have h2 : 10 ^ k ≥ 1 := Nat.pow_pos (by decide)
    omega
  have h_id : (10 ^ (9 * k) - 1) / 9 = (10 ^ k - 1) * (
    4782969 * Y ^ 8 +
    4782969 * Y ^ 7 +
    2125764 * Y ^ 6 +
    551124 * Y ^ 5 +
    91854 * Y ^ 4 +
    10206 * Y ^ 3 +
    756 * Y ^ 2 +
    36 * Y + 1
  ) := by
    have h_pow : 10 ^ (9 * k) = (10 ^ k) ^ 9 := by
      rw [← pow_mul, mul_comm, pow_mul]
    rw [h_pow, h_eq]
    have h_ring := ring_poly_identity Y
    rw [h_ring]
    have h_cancel : 81 * Y * (
      4782969 * Y ^ 8 +
      4782969 * Y ^ 7 +
      2125764 * Y ^ 6 +
      551124 * Y ^ 5 +
      91854 * Y ^ 4 +
      10206 * Y ^ 3 +
      756 * Y ^ 2 +
      36 * Y + 1
    ) + 1 - 1 = 81 * Y * (
      4782969 * Y ^ 8 +
      4782969 * Y ^ 7 +
      2125764 * Y ^ 6 +
      551124 * Y ^ 5 +
      91854 * Y ^ 4 +
      10206 * Y ^ 3 +
      756 * Y ^ 2 +
      36 * Y + 1
    ) := by omega
    rw [h_cancel]
    have h_div : 81 * Y * (
      4782969 * Y ^ 8 +
      4782969 * Y ^ 7 +
      2125764 * Y ^ 6 +
      551124 * Y ^ 5 +
      91854 * Y ^ 4 +
      10206 * Y ^ 3 +
      756 * Y ^ 2 +
      36 * Y + 1
    ) / 9 = (9 * Y) * (
      4782969 * Y ^ 8 +
      4782969 * Y ^ 7 +
      2125764 * Y ^ 6 +
      551124 * Y ^ 5 +
      91854 * Y ^ 4 +
      10206 * Y ^ 3 +
      756 * Y ^ 2 +
      36 * Y + 1
    ) := by
      have h_mul : 81 * Y * (
        4782969 * Y ^ 8 +
        4782969 * Y ^ 7 +
        2125764 * Y ^ 6 +
        551124 * Y ^ 5 +
        91854 * Y ^ 4 +
        10206 * Y ^ 3 +
        756 * Y ^ 2 +
        36 * Y + 1
      ) = 9 * ((9 * Y) * (
        4782969 * Y ^ 8 +
        4782969 * Y ^ 7 +
        2125764 * Y ^ 6 +
        551124 * Y ^ 5 +
        91854 * Y ^ 4 +
        10206 * Y ^ 3 +
        756 * Y ^ 2 +
        36 * Y + 1
      )) := by ring
      rw [h_mul]
      exact Nat.mul_div_cancel_left _ (by decide)
    rw [h_div]
    rw [← hY]
    simp
  rw [h_id]
  exact dvd_mul_right (10 ^ k - 1) _

theorem digits_ones (m : ℕ) : Nat.digits 10 ((10 ^ m - 1) / 9) = List.replicate m 1 := by
  induction m with
  | zero =>
    simp
  | succ m ih =>
    have h_eq : (10 ^ (m + 1) - 1) / 9 = 1 + 10 * ((10 ^ m - 1) / 9) := by
      rw [pow_succ']
      rw [add_comm]
      congr 1
      exact div_9_identity (10 ^ m) (Nat.pow_pos (by decide)) (dvd_9_pow_10_sub_1 m)
    rw [h_eq]
    rw [Nat.digits_add 10 (by decide) 1 ((10 ^ m - 1) / 9) (by decide) (Or.inl (by decide))]
    rw [ih]
    rfl

theorem A004290_pow_10_sub_1_le (k : ℕ) (hk : k > 0) :
    A004290 (10 ^ k - 1) ≤ (10 ^ (9 * k) - 1) / 9 := by
  have h1 : 0 < (10 ^ (9 * k) - 1) / 9 := by
    have h_digits := digits_ones (9 * k)
    have h_len : (Nat.digits 10 ((10 ^ (9 * k) - 1) / 9)).length = 9 * k := by
      rw [h_digits]
      simp
    have h_pos : (Nat.digits 10 ((10 ^ (9 * k) - 1) / 9)).length > 0 := by
      omega
    by_contra hc
    have hc2 : (10 ^ (9 * k) - 1) / 9 = 0 := by omega
    rw [hc2] at h_len
    simp [Nat.digits_zero] at h_len
    omega
  have h2 : 10 ^ k - 1 ∣ (10 ^ (9 * k) - 1) / 9 := dvd_pow_10_sub_1_pow_10_mul k
  have h3 : ∀ d ∈ Nat.digits 10 ((10 ^ (9 * k) - 1) / 9), d = 0 ∨ d = 1 := by
    rw [digits_ones]
    intro d hd
    have h_eq : d = 1 := List.eq_of_mem_replicate hd
    right; exact h_eq
  have hS : (10 ^ (9 * k) - 1) / 9 ∈ { m : ℕ | 0 < m ∧ 10 ^ k - 1 ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := ⟨h1, h2, h3⟩
  exact Nat.sInf_le hS

noncomputable def S (n : ℕ) : ℕ := (Nat.digits 10 n).sum

theorem S_def (n : ℕ) (hn : n > 0) : S n = n % 10 + S (n / 10) := by
  simp [S]
  rw [Nat.digits_def' (by decide) hn]
  simp

theorem digits_pow_10_sub_1 (k : ℕ) : Nat.digits 10 (10 ^ k - 1) = List.replicate k 9 := by
  induction k with
  | zero =>
    simp
  | succ k ih =>
    have h : 10 ^ (k + 1) - 1 = 9 + 10 * (10 ^ k - 1) := by
      have h2 : 10 ^ k ≥ 1 := Nat.pow_pos (by decide)
      omega
    rw [h]
    rw [Nat.digits_add 10 (by decide) 9 (10 ^ k - 1) (by decide) (Or.inl (by decide))]
    rw [ih]
    rfl

theorem S_pow_10_sub_1 (k : ℕ) : S (10 ^ k - 1) = 9 * k := by
  simp [S, digits_pow_10_sub_1 k]
  rw [mul_comm]

theorem S_succ_le (x : ℕ) : S (x + 1) ≤ S x + 1 := by
  induction x using Nat.strong_induction_on with
  | h x ih =>
    by_cases hx : x = 0
    · subst hx
      simp [S]
    · have hx_pos : x > 0 := by omega
      have hx1_pos : x + 1 > 0 := by omega
      rw [S_def (x + 1) hx1_pos]
      rw [S_def x hx_pos]
      by_cases h_mod : (x + 1) % 10 = 0
      · have h_x_mod : x % 10 = 9 := by omega
        have h_div : (x + 1) / 10 = x / 10 + 1 := by omega
        rw [h_mod, h_x_mod, h_div]
        simp
        have h_lt : x / 10 < x := Nat.div_lt_self hx_pos (by decide)
        have ih_div := ih (x / 10) h_lt
        omega
      · have h_x_mod : (x + 1) % 10 = x % 10 + 1 := by omega
        have h_div : (x + 1) / 10 = x / 10 := by omega
        rw [h_x_mod, h_div]
        omega

theorem S_add_le (x y : ℕ) : S (x + y) ≤ S x + S y := by
  have h_ind : ∀ N, ∀ x y, x + y = N → S (x + y) ≤ S x + S y := by
    intro N
    induction N using Nat.strong_induction_on with
    | h N ih =>
      intro x y h_sum
      by_cases hx : x = 0
      · subst hx
        simp [S]
      · by_cases hy : y = 0
        · subst hy
          simp [S]
        · -- x > 0, y > 0
          have hx_pos : x > 0 := by omega
          have hy_pos : y > 0 := by omega
          have h_sum_pos : x + y > 0 := by omega
          rw [S_def (x + y) h_sum_pos]
          rw [S_def x hx_pos]
          rw [S_def y hy_pos]
          by_cases h_carry : (x % 10) + (y % 10) < 10
          · -- Case 1: No carry
            have h_mod : (x + y) % 10 = x % 10 + y % 10 := by omega
            have h_div : (x + y) / 10 = x / 10 + y / 10 := by omega
            rw [h_mod, h_div]
            have h_lt : x / 10 + y / 10 < N := by
              have h_lt_x2 : x / 10 < x := Nat.div_lt_self hx_pos (by decide)
              have h_lt_y2 : y / 10 < y := Nat.div_lt_self hy_pos (by decide)
              omega
            have ih_div := ih (x / 10 + y / 10) h_lt (x / 10) (y / 10) rfl
            omega
          · -- Case 2: Carry
            have h_mod : (x + y) % 10 = x % 10 + y % 10 - 10 := by omega
            have h_div : (x + y) / 10 = x / 10 + y / 10 + 1 := by omega
            rw [h_mod, h_div]
            have h_lt : x / 10 + (y / 10 + 1) < N := by
              have h_lt_x2 : x / 10 < x := Nat.div_lt_self hx_pos (by decide)
              have h_lt_y2 : y / 10 < y := Nat.div_lt_self hy_pos (by decide)
              omega
            have ih_div := ih (x / 10 + (y / 10 + 1)) h_lt (x / 10) (y / 10 + 1) rfl
            have h_succ := S_succ_le (y / 10)
            have h_assoc : x / 10 + (y / 10 + 1) = x / 10 + y / 10 + 1 := by rw [← add_assoc]
            rw [h_assoc] at ih_div
            omega
  exact h_ind (x + y) x y rfl

theorem S_mul_pow_10_add (k : ℕ) : ∀ Y B, B < 10 ^ k → S (Y * 10 ^ k + B) = S Y + S B := by
  induction k with
  | zero =>
    intro Y B hB
    have hB0 : B = 0 := by omega
    subst hB0
    simp [S]
  | succ k ih =>
    intro Y B hB
    have h_div_mod : B = 10 * (B / 10) + B % 10 := (Nat.div_add_mod B 10).symm
    let q := B / 10
    let r := B % 10
    have hr : r < 10 := Nat.mod_lt B (by decide)
    have hq : q < 10 ^ k := by
      have h_pow : 10 ^ (k + 1) = 10 * 10 ^ k := by
        rw [pow_succ', mul_comm]
      rw [h_pow] at hB
      exact Nat.div_lt_of_lt_mul hB
    have h_expr : Y * 10 ^ (k + 1) + B = (Y * 10 ^ k + q) * 10 + r := by
      calc Y * 10 ^ (k + 1) + B = Y * (10 ^ k * 10) + (10 * q + r) := by congr 1
      _ = (Y * 10 ^ k + q) * 10 + r := by ring
    by_cases h_zero : (Y * 10 ^ k + q) * 10 + r = 0
    · have hr0 : r = 0 := by omega
      have h_sum0 : Y * 10 ^ k + q = 0 := by omega
      have hq0 : q = 0 := by omega
      have hY0 : Y = 0 := by
        by_contra hc
        have h_pos_Y : Y > 0 := by omega
        have h_pow_pos : 10 ^ k > 0 := Nat.pow_pos (by decide)
        have h_mul_pos : Y * 10 ^ k > 0 := Nat.mul_pos h_pos_Y h_pow_pos
        omega
      have hB0 : B = 0 := by omega
      rw [hB0, hY0]
      simp [S]
    · have h_pos2 : (Y * 10 ^ k + q) * 10 + r > 0 := by omega
      rw [h_expr]
      rw [S_def ((Y * 10 ^ k + q) * 10 + r) h_pos2]
      have h_mod : ((Y * 10 ^ k + q) * 10 + r) % 10 = r := by omega
      have h_div : ((Y * 10 ^ k + q) * 10 + r) / 10 = Y * 10 ^ k + q := by omega
      rw [h_mod, h_div]
      rw [ih Y q hq]
      have hSB : S B = S q + r := by
        by_cases hB0 : B = 0
        · dsimp [q, r]
          rw [hB0]
          simp [S]
        · rw [S_def B (by omega)]
          dsimp [q, r]
          rw [add_comm]
      omega

theorem pow_10_ge_10 (k : ℕ) (hk : k > 0) : 10 ^ k ≥ 10 := by
  rcases k with _ | k
  · omega
  · have : 10 ^ k ≥ 1 := Nat.pow_pos (by decide)
    omega

theorem alg_identity (A B Z : ℕ) (hZ : Z ≥ A) : A + B = Z + B - (Z - A) := by
  omega

theorem S_mul_ge (k : ℕ) (hk : k > 0) (X : ℕ) :
    X > 0 → 10 ^ k - 1 ∣ X → S X ≥ 9 * k := by
  induction X using Nat.strong_induction_on with
  | h X ih =>
    intro hX hdvd
    by_cases h_lt : X < 10 ^ k
    · have h_eq : X = 10 ^ k - 1 := by
        obtain ⟨m, hm⟩ := hdvd
        have hm_pos : m > 0 := by
          by_contra hc
          have : m = 0 := by omega
          subst this
          omega
        have h_le1 : 10 ^ k - 1 ≤ X := by
          calc 10 ^ k - 1 = (10 ^ k - 1) * 1 := by ring
          _ ≤ (10 ^ k - 1) * m := Nat.mul_le_mul_left _ hm_pos
          _ = X := hm.symm
        have h_le2 : X ≤ 10 ^ k - 1 := by omega
        omega
      rw [h_eq]
      rw [S_pow_10_sub_1 k]
    · -- X >= 10^k
      have h_ge : X ≥ 10 ^ k := by omega
      let A := X / 10 ^ k
      let B := X % 10 ^ k
      have h_pow_pos : 10 ^ k > 0 := Nat.pow_pos (by decide)
      have hA : A ≥ 1 := by
        dsimp [A]
        have h_div_self : 10 ^ k / 10 ^ k = 1 := Nat.div_self h_pow_pos
        rw [← h_div_self]
        exact Nat.div_le_div_right h_ge
      have hB : B < 10 ^ k := Nat.mod_lt X h_pow_pos
      have h_expr : X = A * 10 ^ k + B := by
        have h_eq_div : X = 10 ^ k * A + B := (Nat.div_add_mod X (10 ^ k)).symm
        rw [h_eq_div]
        ring
      have h_sub : 10 ^ k = (10 ^ k - 1) + 1 := by
        have : 10 ^ k ≥ 1 := by omega
        omega
      have h_id_div : X = A * (10 ^ k - 1) + (A + B) := by
        have h_ring : A * 10 ^ k + B = A * (10 ^ k - 1) + A + B := by
          nth_rw 1 [h_sub]
          ring
        omega
      have hdvd_X' : 10 ^ k - 1 ∣ A + B := by
        obtain ⟨m1, hm1⟩ := hdvd
        use m1 - A
        have h_le : (10 ^ k - 1) * A ≤ (10 ^ k - 1) * m1 := by
          have : A * (10 ^ k - 1) ≤ X := by omega
          rw [mul_comm]
          rw [← hm1]
          exact this
        have h_pos_N : 10 ^ k - 1 > 0 := by
          have : 10 ^ k ≥ 10 := pow_10_ge_10 k hk
          omega
        have h_mul_le : A ≤ m1 := Nat.le_of_mul_le_mul_left h_le h_pos_N
        have h_dist : (10 ^ k - 1) * (m1 - A) = (10 ^ k - 1) * m1 - A * (10 ^ k - 1) := by
          rw [Nat.mul_sub_left_distrib, mul_comm A]
        have h_mul_sub : A * (10 ^ k - 1) = A * 10 ^ k - A := by
          rw [Nat.mul_sub_left_distrib]
          simp
        have h_alg : A + B = A * 10 ^ k + B - (A * 10 ^ k - A) := by
          apply alg_identity A B (A * 10 ^ k)
          have h_pow_ge1 : 10 ^ k ≥ 1 := by
            have : 10 ^ k ≥ 10 := pow_10_ge_10 k hk
            omega
          calc A * 10 ^ k ≥ A * 1 := Nat.mul_le_mul_left A h_pow_ge1
          _ = A := by ring
        rw [h_dist]
        rw [← hm1]
        rw [h_expr]
        rw [h_mul_sub]
        exact h_alg
      have h_lt_X' : A + B < X := by
        have h_pow_ge10 : 10 ^ k ≥ 10 := pow_10_ge_10 k hk
        have h_mul_lt : A < A * 10 ^ k := by
          calc A = A * 1 := by ring
          _ < A * 10 := Nat.mul_lt_mul_of_pos_left (by decide) hA
          _ ≤ A * 10 ^ k := Nat.mul_le_mul_left A h_pow_ge10
        omega
      have h_pos_X' : A + B > 0 := by omega
      have ih_X' := ih (A + B) h_lt_X' h_pos_X' hdvd_X'
      rw [h_expr]
      rw [S_mul_pow_10_add k A B hB]
      have h_add_le := S_add_le A B
      omega

theorem ge_ones_of_S (X : ℕ) :
    (∀ d ∈ Nat.digits 10 X, d = 0 ∨ d = 1) → X ≥ (10 ^ (S X) - 1) / 9 := by
  induction X using Nat.strong_induction_on with
  | h X ih =>
    intro hd
    by_cases h0 : X = 0
    · subst h0
      simp [S]
    · have h_pos : X > 0 := by omega
      let q := X / 10
      let r := X % 10
      have hr : r < 10 := Nat.mod_lt X (by decide)
      have hd_r : r = 0 ∨ r = 1 := by
        have h_mem : r ∈ Nat.digits 10 X := by
          rw [Nat.digits_def' (by decide) h_pos]
          exact List.Mem.head _
        exact hd r h_mem
      have hq_lt : q < X := Nat.div_lt_self h_pos (by decide)
      have hd_q : ∀ d ∈ Nat.digits 10 q, d = 0 ∨ d = 1 := by
        intro d hd_d
        have h_mem2 : d ∈ Nat.digits 10 X := by
          rw [Nat.digits_def' (by decide) h_pos]
          exact List.Mem.tail _ hd_d
        exact hd d h_mem2
      have ih_q := ih q hq_lt hd_q
      have h_sum : S X = S q + r := by
        rw [S_def X h_pos]
        rw [add_comm]
      have h_div_mod : X = 10 * q + r := (Nat.div_add_mod X 10).symm
      rcases hd_r with hr0 | hr1
      · -- r = 0
        have hX_eq : X = 10 * q := by omega
        rw [h_sum, hr0]
        simp
        calc X = 10 * q := hX_eq
        _ ≥ q := by
          have : q ≤ 10 * q := by omega
          exact this
        _ ≥ (10 ^ S q - 1) / 9 := ih_q
      · -- r = 1
        have hX_eq : X = 10 * q + 1 := by omega
        rw [h_sum, hr1]
        have h_id : (10 ^ (S q + 1) - 1) / 9 = 10 * ((10 ^ S q - 1) / 9) + 1 := by
          have h_pow : 10 ^ (S q + 1) = 10 * 10 ^ S q := by ring
          rw [h_pow]
          exact div_9_identity (10 ^ S q) (Nat.pow_pos (by decide)) (dvd_9_pow_10_sub_1 (S q))
        rw [h_id]
        calc X = 10 * q + 1 := hX_eq
        _ ≥ 10 * ((10 ^ S q - 1) / 9) + 1 := by
          have : 10 * q ≥ 10 * ((10 ^ S q - 1) / 9) := Nat.mul_le_mul_left 10 ih_q
          omega

theorem div_9_mono (a b : ℕ) (h : a ≥ b) : (10 ^ a - 1) / 9 ≥ (10 ^ b - 1) / 9 := by
  have : 10 ^ a - 1 ≥ 10 ^ b - 1 := by
    have h_pow : 10 ^ a ≥ 10 ^ b := Nat.pow_le_pow_right (by decide) h
    omega
  exact Nat.div_le_div_right this

theorem A004290_pow_10_sub_1_ge (k : ℕ) (hk : k > 0) :
    A004290 (10 ^ k - 1) ≥ (10 ^ (9 * k) - 1) / 9 := by
  have h_ne : { m : ℕ | 0 < m ∧ 10 ^ k - 1 ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 }.Nonempty := by
    use (10 ^ (9 * k) - 1) / 9
    have h1 : 0 < (10 ^ (9 * k) - 1) / 9 := by
      have h_digits := digits_ones (9 * k)
      have h_len : (Nat.digits 10 ((10 ^ (9 * k) - 1) / 9)).length = 9 * k := by
        rw [h_digits]
        simp
      have h_pos : (Nat.digits 10 ((10 ^ (9 * k) - 1) / 9)).length > 0 := by
        omega
      by_contra hc
      have hc2 : (10 ^ (9 * k) - 1) / 9 = 0 := by omega
      rw [hc2] at h_len
      simp [Nat.digits_zero] at h_len
      omega
    have h2 : 10 ^ k - 1 ∣ (10 ^ (9 * k) - 1) / 9 := dvd_pow_10_sub_1_pow_10_mul k
    have h3 : ∀ d ∈ Nat.digits 10 ((10 ^ (9 * k) - 1) / 9), d = 0 ∨ d = 1 := by
      rw [digits_ones]
      intro d hd
      have h_eq : d = 1 := List.eq_of_mem_replicate hd
      right; exact h_eq
    exact ⟨h1, h2, h3⟩
  have h_mem := Nat.sInf_mem h_ne
  obtain ⟨h_pos, h_dvd, h_digits⟩ := h_mem
  have hS := S_mul_ge k hk (A004290 (10 ^ k - 1)) h_pos h_dvd
  have h_ones := ge_ones_of_S (A004290 (10 ^ k - 1)) h_digits
  have h_mono := div_9_mono (S (A004290 (10 ^ k - 1))) (9 * k) hS
  omega

theorem A004290_pow_10_sub_1 (k : ℕ) (hk : k > 0) :
    A004290 (10 ^ k - 1) = (10 ^ (9 * k) - 1) / 9 :=
  le_antisymm (A004290_pow_10_sub_1_le k hk) (A004290_pow_10_sub_1_ge k hk)


theorem pow_10_sub_1_identity (i j : ℕ) (hij : i < j) :
    (10 ^ j - 1) / 9 - (10 ^ i - 1) / 9 = 10 ^ i * ((10 ^ (j - i) - 1) / 9) := by
  have h1 : 9 ∣ 10 ^ j - 1 := dvd_9_pow_10_sub_1 j
  have h2 : 9 ∣ 10 ^ i - 1 := dvd_9_pow_10_sub_1 i
  have h3 : 9 ∣ 10 ^ (j - i) - 1 := dvd_9_pow_10_sub_1 (j - i)
  have h_pow_ge : 10 ^ j ≥ 10 ^ i := Nat.pow_le_pow_right (by decide) (Nat.le_of_lt hij)
  have h_ge1 : 10 ^ i ≥ 1 := Nat.pow_pos (by decide)
  have h_eq : 10 ^ j - 1 - (10 ^ i - 1) = 10 ^ i * (10 ^ (j - i) - 1) := by
    have h_sub : j = i + (j - i) := (Nat.add_sub_of_le (Nat.le_of_lt hij)).symm
    nth_rw 1 [h_sub]
    rw [pow_add]
    have h_mul_sub : 10 ^ i * 10 ^ (j - i) - 10 ^ i = 10 ^ i * (10 ^ (j - i) - 1) := by
      rw [Nat.mul_sub_left_distrib, mul_one]
    omega
  have h_eq2 : 9 * ((10 ^ j - 1) / 9 - (10 ^ i - 1) / 9) = 9 * (10 ^ i * ((10 ^ (j - i) - 1) / 9)) := by
    rw [Nat.mul_sub_left_distrib]
    rw [Nat.mul_div_cancel' h1, Nat.mul_div_cancel' h2]
    rw [h_eq]
    rw [← mul_assoc, mul_comm 9, mul_assoc]
    rw [Nat.mul_div_cancel' h3]
  exact Nat.eq_of_mul_eq_mul_left (by decide) h_eq2

theorem dvd_sub_of_mod_eq_mod {a b n : ℕ} (h : a % n = b % n) (hab : a ≥ b) : n ∣ a - b := by
  use a / n - b / n
  have h_eq : a - b = n * (a / n - b / n) := by
    rw [Nat.mul_sub_left_distrib]
    have h1 := Nat.div_add_mod a n
    have h2 := Nat.div_add_mod b n
    omega
  omega

theorem exists_digits_le (n : ℕ) (hn : n > 0) :
    ∃ m, 0 < m ∧ n ∣ m ∧ (∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1) ∧ m ≤ (10 ^ n - 1) / 9 := by
  let g : Fin (n + 1) → Fin n := fun i => ⟨((10 ^ i.val - 1) / 9) % n, Nat.mod_lt _ hn⟩
  have h_card : Fintype.card (Fin n) < Fintype.card (Fin (n + 1)) := by
    simp
  obtain ⟨i, j, hne, heq⟩ := Fintype.exists_ne_map_eq_of_card_lt g h_card
  have h_swap : ∃ i j, i < j ∧ g i = g j := by
    rcases lt_or_gt_of_ne hne with hij | hji
    · exact ⟨i, j, hij, heq⟩
    · exact ⟨j, i, hji, heq.symm⟩
  obtain ⟨i, j, hij_val, heq⟩ := h_swap
  have h_le : (10 ^ i.val - 1) / 9 ≤ (10 ^ j.val - 1) / 9 := by
    apply div_9_mono _ _ (Nat.le_of_lt hij_val)
  have heq_val : ((10 ^ j.val - 1) / 9) % n = ((10 ^ i.val - 1) / 9) % n := by
    injection heq with heq_inner
    exact heq_inner.symm
  use (10 ^ j.val - 1) / 9 - (10 ^ i.val - 1) / 9
  have h_sub_pos : j.val - i.val > 0 := by omega
  have h_pos2 : (10 ^ (j.val - i.val) - 1) / 9 > 0 := by
    have h_div_9 : 9 ∣ 10 ^ (j.val - i.val) - 1 := dvd_9_pow_10_sub_1 _
    have h_ge_9 : 10 ^ (j.val - i.val) - 1 ≥ 9 := by
      rcases h_sub_pos_eq : j.val - i.val with _ | m
      · omega
      · have : 10 ^ m ≥ 1 := Nat.pow_pos (by decide)
        rw [pow_succ]
        omega
    have h_cancel : 9 * ((10 ^ (j.val - i.val) - 1) / 9) = 10 ^ (j.val - i.val) - 1 := Nat.mul_div_cancel' h_div_9
    omega
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [pow_10_sub_1_identity i.val j.val hij_val]
    have h_pos1 : 10 ^ i.val > 0 := Nat.pow_pos (by decide)
    exact Nat.mul_pos h_pos1 h_pos2
  · exact dvd_sub_of_mod_eq_mod heq_val h_le
  · rw [pow_10_sub_1_identity i.val j.val hij_val]
    rw [digits_base_pow_mul (by decide) h_pos2]
    intro d hd
    rw [List.mem_append] at hd
    rcases hd with hd_zero | hd_m
    · have : d = 0 := List.eq_of_mem_replicate hd_zero
      left; exact this
    · rw [digits_ones] at hd_m
      have : d = 1 := List.eq_of_mem_replicate hd_m
      right; exact this
  · have h_le_j : j.val ≤ n := by omega
    have h_mono_j := div_9_mono n j.val h_le_j
    omega

theorem A004290_zero : A004290 0 = 0 := by
  have hS : { m : ℕ | 0 < m ∧ 0 ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } = ∅ := by
    ext x
    simp
    intro hx_pos hdvd
    obtain ⟨c, hc⟩ := hdvd
    omega
  rw [A004290, hS]
  exact sInf_empty

theorem A004290_le_ones (n : ℕ) (hn : n > 0) : A004290 n ≤ (10 ^ n - 1) / 9 := by
  obtain ⟨m, hm_pos, hm_dvd, hm_digits, hm_le⟩ := exists_digits_le n hn
  have h_mem : m ∈ { m : ℕ | 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := ⟨hm_pos, hm_dvd, hm_digits⟩
  have h_le_m : A004290 n ≤ m := Nat.sInf_le h_mem
  exact le_trans h_le_m hm_le


theorem digits_mul_10 (M : ℕ) (hM : 0 < M) :
    Nat.digits 10 (10 * M) = 0 :: Nat.digits 10 M := by
  have h_eq : 10 * M = 10 ^ 1 * M := by ring
  rw [h_eq]
  rw [digits_base_pow_mul (by decide) hM]
  rfl

theorem A004290_even_le (n : ℕ) (hn : n > 0) (heven : 2 ∣ n) :
    A004290 n ≤ 10 * A004290 (n / 2) := by
  let q := n / 2
  have hq_pos : q > 0 := Nat.div_pos (Nat.le_of_dvd hn heven) (by decide)
  have h_eq : n = 2 * q := (Nat.mul_div_cancel' heven).symm
  let M := A004290 q
  have h_ne : { m : ℕ | 0 < m ∧ q ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 }.Nonempty := by
    obtain ⟨m, hm_pos, hm_dvd, hm_digits, _⟩ := exists_digits_le q hq_pos
    exact ⟨m, hm_pos, hm_dvd, hm_digits⟩
  have h_mem := Nat.sInf_mem h_ne
  obtain ⟨hM_pos, hM_dvd, hM_digits⟩ := h_mem
  change 0 < M at hM_pos
  change q ∣ M at hM_dvd
  change ∀ d ∈ Nat.digits 10 M, d = 0 ∨ d = 1 at hM_digits
  have h_10M_pos : 0 < 10 * M := Nat.mul_pos (by decide) hM_pos
  have h_10M_dvd : n ∣ 10 * M := by
    rw [h_eq]
    obtain ⟨k, hk⟩ := hM_dvd
    use 5 * k
    calc 10 * M = 10 * (q * k) := by rw [hk]
    _ = (2 * q) * (5 * k) := by ring
  have h_10M_digits : ∀ d ∈ Nat.digits 10 (10 * M), d = 0 ∨ d = 1 := by
    rw [digits_mul_10 M hM_pos]
    intro d hd
    rcases List.mem_cons.mp hd with rfl | hd_mem
    · left; rfl
    · exact hM_digits d hd_mem
  have h_10M_S : 10 * M ∈ { m : ℕ | 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := ⟨h_10M_pos, h_10M_dvd, h_10M_digits⟩
  exact Nat.sInf_le h_10M_S

theorem A004290_mul_5_le (n : ℕ) (hn : n > 0) (h5 : 5 ∣ n) :
    A004290 n ≤ 10 * A004290 (n / 5) := by
  let q := n / 5
  have hq_pos : q > 0 := Nat.div_pos (Nat.le_of_dvd hn h5) (by decide)
  have h_eq : n = 5 * q := (Nat.mul_div_cancel' h5).symm
  let M := A004290 q
  have h_ne : { m : ℕ | 0 < m ∧ q ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 }.Nonempty := by
    obtain ⟨m, hm_pos, hm_dvd, hm_digits, _⟩ := exists_digits_le q hq_pos
    exact ⟨m, hm_pos, hm_dvd, hm_digits⟩
  have h_mem := Nat.sInf_mem h_ne
  obtain ⟨hM_pos, hM_dvd, hM_digits⟩ := h_mem
  change 0 < M at hM_pos
  change q ∣ M at hM_dvd
  change ∀ d ∈ Nat.digits 10 M, d = 0 ∨ d = 1 at hM_digits
  have h_10M_pos : 0 < 10 * M := Nat.mul_pos (by decide) hM_pos
  have h_10M_dvd : n ∣ 10 * M := by
    rw [h_eq]
    obtain ⟨k, hk⟩ := hM_dvd
    use 2 * k
    calc 10 * M = 10 * (q * k) := by rw [hk]
    _ = (5 * q) * (2 * k) := by ring
  have h_10M_digits : ∀ d ∈ Nat.digits 10 (10 * M), d = 0 ∨ d = 1 := by
    rw [digits_mul_10 M hM_pos]
    intro d hd
    rcases List.mem_cons.mp hd with rfl | hd_mem
    · left; rfl
    · exact hM_digits d hd_mem
  have h_10M_S : 10 * M ∈ { m : ℕ | 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := ⟨h_10M_pos, h_10M_dvd, h_10M_digits⟩
  exact Nat.sInf_le h_10M_S


theorem A004290_le_coprime_part (n : ℕ) (hn : n > 0) :
    ∃ d : ℕ, d > 0 ∧ Nat.Coprime d 10 ∧ ∃ c : ℕ, A004290 n ≤ 10 ^ c * A004290 d ∧ d * 2 ^ c ≤ n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases h2 : 2 ∣ n
    · have h_pos : n / 2 > 0 := Nat.div_pos (Nat.le_of_dvd hn h2) (by decide)
      have h_lt : n / 2 < n := Nat.div_lt_self hn (by decide)
      obtain ⟨d, hd1, hd2, c, hc1, hc2⟩ := ih (n / 2) h_lt h_pos
      use d, hd1, hd2, c + 1
      refine ⟨?_, ?_⟩
      · calc A004290 n ≤ 10 * A004290 (n / 2) := A004290_even_le n hn h2
        _ ≤ 10 * (10 ^ c * A004290 d) := Nat.mul_le_mul_left 10 hc1
        _ = 10 ^ (c + 1) * A004290 d := by
          rw [pow_add, pow_one]
          ring
      · have : d * 2 ^ (c + 1) = 2 * (d * 2 ^ c) := by
          rw [pow_add, pow_one]
          ring
        rw [this]
        have h_mul : 2 * (d * 2 ^ c) ≤ 2 * (n / 2) := Nat.mul_le_mul_left 2 hc2
        have h_cancel : 2 * (n / 2) = n := Nat.mul_div_cancel' h2
        omega
    · by_cases h5 : 5 ∣ n
      · have h_pos : n / 5 > 0 := Nat.div_pos (Nat.le_of_dvd hn h5) (by decide)
        have h_lt : n / 5 < n := Nat.div_lt_self hn (by decide)
        obtain ⟨d, hd1, hd2, c, hc1, hc2⟩ := ih (n / 5) h_lt h_pos
        use d, hd1, hd2, c + 1
        refine ⟨?_, ?_⟩
        · calc A004290 n ≤ 10 * A004290 (n / 5) := A004290_mul_5_le n hn h5
          _ ≤ 10 * (10 ^ c * A004290 d) := Nat.mul_le_mul_left 10 hc1
          _ = 10 ^ (c + 1) * A004290 d := by
            rw [pow_add, pow_one]
            ring
        · have : d * 2 ^ (c + 1) = 2 * (d * 2 ^ c) := by
            rw [pow_add, pow_one]
            ring
          rw [this]
          have h_mul : 2 * (d * 2 ^ c) ≤ 2 * (n / 5) := Nat.mul_le_mul_left 2 hc2
          have h_div : 2 * (n / 5) ≤ 5 * (n / 5) := by omega
          have h_cancel : 5 * (n / 5) = n := Nat.mul_div_cancel' h5
          omega
      · -- Coprime case!
        use n, hn, ?_, 0
        · refine ⟨by simp, by simp⟩
        · have hp2 : Nat.Prime 2 := Nat.prime_two
          have hp5 : Nat.Prime 5 := by decide
          have h_eq : 10 = 2 * 5 := by decide
          rw [h_eq, Nat.coprime_mul_iff_right]
          refine ⟨?_, ?_⟩
          · rw [Nat.coprime_comm]
            rwa [Nat.Prime.coprime_iff_not_dvd hp2]
          · rw [Nat.coprime_comm]
            rwa [Nat.Prime.coprime_iff_not_dvd hp5]


theorem A004290_lt_pow_10 (n : ℕ) (hn : n > 0) : A004290 n < 10 ^ n := by
  have h1 := A004290_le_ones n hn
  have h2 : (10 ^ n - 1) / 9 < 10 ^ n := by
    have h_mul : 9 * ((10 ^ n - 1) / 9) ≤ 10 ^ n - 1 := Nat.mul_div_le _ _
    have h_lt : 10 ^ n - 1 < 9 * 10 ^ n := by
      have : 10 ^ n > 0 := Nat.pow_pos (by decide)
      omega
    by_contra hc
    have hc2 : (10 ^ n - 1) / 9 ≥ 10 ^ n := by omega
    have h3 : 9 * ((10 ^ n - 1) / 9) ≥ 9 * 10 ^ n := Nat.mul_le_mul_left 9 hc2
    omega
  exact lt_of_le_of_lt h1 h2


theorem lemma_max_ones (L : ℕ) : ∀ X : ℕ, (∀ d ∈ Nat.digits 10 X, d = 0 ∨ d = 1) → X < 10 ^ L → X ≤ (10 ^ L - 1) / 9 := by
  induction L with
  | zero =>
    intro X h_digits h_lt
    have hX : X = 0 := by omega
    subst hX
    simp
  | succ m ih =>
    intro X h_digits h_lt
    by_cases h0 : X = 0
    · subst h0
      simp
    · have h_pos : X > 0 := by omega
      let q := X / 10
      let r := X % 10
      have hr : r < 10 := Nat.mod_lt X (by decide)
      have hd_r : r = 0 ∨ r = 1 := by
        have h_mem : r ∈ Nat.digits 10 X := by
          rw [Nat.digits_def' (by decide) h_pos]
          exact List.Mem.head _
        exact h_digits r h_mem
      have hq_lt : q < 10 ^ m := by
        have h_pow : 10 ^ (m + 1) = 10 * 10 ^ m := by ring
        rw [h_pow] at h_lt
        exact Nat.div_lt_of_lt_mul h_lt
      have hd_q : ∀ d ∈ Nat.digits 10 q, d = 0 ∨ d = 1 := by
        intro d hd_d
        have h_mem2 : d ∈ Nat.digits 10 X := by
          rw [Nat.digits_def' (by decide) h_pos]
          exact List.Mem.tail _ hd_d
        exact h_digits d h_mem2
      have ih_q := ih q hd_q hq_lt
      have h_div_mod : X = 10 * q + r := (Nat.div_add_mod X 10).symm
      have h_id : (10 ^ (m + 1) - 1) / 9 = 10 * ((10 ^ m - 1) / 9) + 1 := by
        have h_pow : 10 ^ (m + 1) = 10 * 10 ^ m := by ring
        rw [h_pow]
        exact div_9_identity (10 ^ m) (Nat.pow_pos (by decide)) (dvd_9_pow_10_sub_1 m)
      rcases hd_r with hr0 | hr1
      · have hX_eq : X = 10 * q := by omega
        rw [hX_eq]
        rw [h_id]
        have : 10 * q ≤ 10 * ((10 ^ m - 1) / 9) := Nat.mul_le_mul_left 10 ih_q
        omega
      · have hX_eq : X = 10 * q + 1 := by omega
        rw [hX_eq]
        rw [h_id]
        have : 10 * q ≤ 10 * ((10 ^ m - 1) / 9) := Nat.mul_le_mul_left 10 ih_q
        omega


theorem ten_pow_lt_two_pow (k : ℕ) (hk : k ≥ 2) : 10 ^ k < 2 ^ (9 * k - 1) := by
  induction k, hk using Nat.le_induction with
  | base =>
    decide
  | succ m hm ih =>
    have h1 : 9 * (m + 1) - 1 = (9 * m - 1) + 9 := by omega
    have h_pow : 2 ^ (9 * (m + 1) - 1) = 2 ^ (9 * m - 1) * 2 ^ 9 := by
      rw [h1, pow_add]
    rw [h_pow]
    have h2 : 10 ^ (m + 1) = 10 * 10 ^ m := by ring
    rw [h2]
    have h3 : 10 * 10 ^ m < 10 * 2 ^ (9 * m - 1) := Nat.mul_lt_mul_of_pos_left ih (by decide)
    have h4 : 10 * 2 ^ (9 * m - 1) < 2 ^ 9 * 2 ^ (9 * m - 1) := by
      have : 10 < 2 ^ 9 := by decide
      exact Nat.mul_lt_mul_of_pos_right this (Nat.pow_pos (by decide))
    have h5 : 10 * 10 ^ m < 2 ^ 9 * 2 ^ (9 * m - 1) := lt_trans h3 h4
    rw [mul_comm (2 ^ 9) (2 ^ (9 * m - 1))] at h5
    exact h5

theorem d_lt_two_pow (k : ℕ) (hk : k ≥ 2) (c d : ℕ) (h_mul : d * 2 ^ c < 10 ^ k) :
    d < 2 ^ (9 * k - c - 1) := by
  rcases eq_or_ne d 0 with rfl | hd_pos
  · exact Nat.pow_pos (by decide)
  · have hd_pos : d ≥ 1 := Nat.pos_of_ne_zero hd_pos
    have h_ten := ten_pow_lt_two_pow k hk
    have h_trans : d * 2 ^ c < 2 ^ (9 * k - 1) := lt_trans h_mul h_ten
    have h_eq : 9 * k - 1 = (9 * k - c - 1) + c := by
      have h_pow_le : 2 ^ c ≤ d * 2 ^ c := by
        calc 2 ^ c = 1 * 2 ^ c := by ring
        _ ≤ d * 2 ^ c := Nat.mul_le_mul_right (2 ^ c) hd_pos
      have h_pow_lt : 2 ^ c < 2 ^ (9 * k - 1) := lt_of_le_of_lt h_pow_le h_trans
      have : c < 9 * k - 1 := Nat.pow_lt_pow_iff_right (by decide) |>.mp h_pow_lt
      omega
    rw [h_eq, pow_add] at h_trans
    exact Nat.lt_of_mul_lt_mul_right h_trans


theorem dvd_of_modeq_one {a n : ℕ} (hn : n > 1) (h : a ≡ 1 [MOD n]) : n ∣ a - 1 := by
  have h1 : a % n = 1 % n := h
  rw [Nat.mod_eq_of_lt hn] at h1
  have h_eq : a = n * (a / n) + 1 := by
    rw [← h1]
    exact (Nat.div_add_mod a n).symm
  have h_sub : a - 1 = n * (a / n) := by
    omega
  rw [h_sub]
  exact dvd_mul_right n (a / n)

theorem A004290_coprime_le (d : ℕ) (hd_pos : d > 0) (hd_cop : Nat.Coprime d 10) :
    ∃ T : ℕ, T > 0 ∧ d ∣ (10 ^ T - 1) / 9 := by
  have h9d_cop : Nat.Coprime 10 (9 * d) := by
    have h10_9 : Nat.Coprime 10 9 := by decide
    have h10_d : Nat.Coprime 10 d := hd_cop.symm
    exact Nat.Coprime.mul_right h10_9 h10_d
  let T := Nat.totient (9 * d)
  have hT_pos : T > 0 := Nat.totient_pos.mpr (Nat.mul_pos (by decide) hd_pos)
  use T, hT_pos
  have h_modeq := Nat.ModEq.pow_totient h9d_cop
  have h9_ge1 : 9 * d > 1 := by
    calc 9 * d ≥ 9 * 1 := Nat.mul_le_mul_left 9 hd_pos
    _ > 1 := by decide
  have hdvd := dvd_of_modeq_one h9_ge1 h_modeq
  obtain ⟨m, hm⟩ := hdvd
  have hm_eq : 10 ^ T - 1 = 9 * (d * m) := by
    calc 10 ^ T - 1 = 9 * d * m := hm
    _ = 9 * (d * m) := by ring
  have h_div : (10 ^ T - 1) / 9 = d * m := by
    rw [hm_eq]
    exact Nat.mul_div_cancel_left _ (by decide)
  exact ⟨m, h_div⟩

theorem A004290_le_coprime_totient (d : ℕ) (hd_pos : d > 0) (hd_cop : Nat.Coprime d 10) :
    ∃ T : ℕ, T > 0 ∧ A004290 d ≤ (10 ^ T - 1) / 9 := by
  obtain ⟨T, hT_pos, hdvd⟩ := A004290_coprime_le d hd_pos hd_cop
  use T, hT_pos
  have h_S : (10 ^ T - 1) / 9 ∈ { m : ℕ | 0 < m ∧ d ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := by
    refine ⟨?_, hdvd, ?_⟩
    · have h_div_9 : 9 ∣ 10 ^ T - 1 := dvd_9_pow_10_sub_1 T
      have h_ge : 10 ^ T - 1 ≥ 9 := by
        rcases hT_pos_eq : T with _ | m
        · omega
        · have : 10 ^ m ≥ 1 := Nat.pow_pos (by decide)
          rw [pow_succ]
          omega
      have h_cancel : 9 * ((10 ^ T - 1) / 9) = 10 ^ T - 1 := Nat.mul_div_cancel' h_div_9
      omega
    · rw [digits_ones]
      intro d hd
      have : d = 1 := List.eq_of_mem_replicate hd
      right; exact this
  exact Nat.sInf_le h_S



/--
Conjecture from A004290 by David Radcliffe:
a(10^k) = 10^k and a(10^k - 1) = (10^(9k) - 1) / 9 for all k.
Is a(n) < a(10^k - 1) for all n < 10^k - 1?
We formalize the second, unproven part. The first two parts are stated as assumptions
to establish the right-hand side of the inequality.
-/


theorem ten_pow_lt_two_pow_factor (k : ℕ) (hk : k ≥ 2) : 1310 * 10 ^ k < 2 ^ (9 * k - 1) := by
  induction k with
  | zero => omega
  | succ k ih =>
    rcases k with _ | k
    · omega
    · rcases k with _ | k
      · decide
      · have h_step : 1310 * 10 ^ (k + 3) = 10 * (1310 * 10 ^ (k + 2)) := by
          calc 1310 * 10 ^ (k + 3) = 1310 * (10 ^ (k + 2) * 10) := by rfl
          _ = 10 * (1310 * 10 ^ (k + 2)) := by ring
        rw [h_step]
        have ih_inst := ih (by omega)
        have h_mul : 10 * (1310 * 10 ^ (k + 2)) < 10 * 2 ^ (9 * (k + 2) - 1) := by
          exact Nat.mul_lt_mul_of_pos_left ih_inst (by decide)
        have h_le : 10 * 2 ^ (9 * (k + 2) - 1) < 2 ^ (9 * (k + 3) - 1) := by
          have h_pow_eq : 9 * (k + 3) - 1 = (9 * (k + 2) - 1) + 9 := by omega
          rw [h_pow_eq, pow_add]
          have h_pow9 : 2 ^ 9 = 512 := by decide
          rw [h_pow9]
          have : 10 < 512 := by decide
          exact Nat.mul_lt_mul_of_pos_right this (Nat.pow_pos (by decide))
        exact lt_trans h_mul h_le

theorem d_lt_two_pow_factor (k c d L : ℕ) (hk2 : k ≥ 2) (h_lt : d * 2 ^ c < 10 ^ k) (h_L : 9 * k - 1 = L + c) :
    1310 * d < 2 ^ L := by
  have h1 : 1310 * (d * 2 ^ c) < 1310 * 10 ^ k := Nat.mul_lt_mul_of_pos_left h_lt (by decide)
  have h2 := ten_pow_lt_two_pow_factor k hk2
  have h3 : 1310 * (d * 2 ^ c) < 2 ^ (9 * k - 1) := lt_trans h1 h2
  have h4 : 1310 * (d * 2 ^ c) = (1310 * d) * 2 ^ c := by ring
  rw [h4] at h3
  rw [h_L] at h3
  rw [pow_add] at h3
  have h5 : 2 ^ c > 0 := Nat.pow_pos (by decide)
  exact Nat.lt_of_mul_lt_mul_right h3

theorem d_le_L_of_L_lt_15 (d L : ℕ) (hd_pos : d > 0) (h_L15 : L < 15) (h_lt : 1310 * d < 2 ^ L) :
    d ≤ L := by
  interval_cases L <;> omega

theorem digits_member (M : ℕ) (h_pos : 0 < M) (d : ℕ) (h_dvd : d ∣ M) (h_digits : ∀ x ∈ Nat.digits 10 M, x = 0 ∨ x = 1) :
    A004290 d ≤ M := by
  have hS : M ∈ { m : ℕ | 0 < m ∧ d ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 } := ⟨h_pos, h_dvd, h_digits⟩
  exact Nat.sInf_le hS

theorem pow_contradiction (k : ℕ) (hk : k ≥ 5) : 10000 * 2 ^ (9 * k - 40) ≥ 10 ^ k := by
  induction k with
  | zero => omega
  | succ k ih =>
    rcases k with _ | k
    · omega
    · rcases k with _ | k
      · omega
      · rcases k with _ | k
        · omega
        · rcases k with _ | k
          · omega
          · rcases k with _ | k
            · decide
            · have h_step : 10000 * 2 ^ (9 * (k + 2) - 40) = 512 * (10000 * 2 ^ (9 * (k + 1) - 40)) := by
                have : 9 * (k + 2) - 40 = (9 * (k + 1) - 40) + 9 := by omega
                rw [this, pow_add]
                ring
              rw [h_step]
              have ih_inst := ih (by omega)
              have h_mul : 512 * (10000 * 2 ^ (9 * (k + 1) - 40)) ≥ 512 * 10 ^ (k + 2) := by
                gcongr
              have h_le : 512 * 10 ^ (k + 2) ≥ 10 ^ (k + 3) := by
                have : 10 ^ (k + 3) = 10 * 10 ^ (k + 2) := by rfl
                rw [this]
                gcongr
                decide
              exact le_trans h_le h_mul


theorem digits_1 : ∀ d' ∈ Nat.digits 10 1, d' = 0 ∨ d' = 1 := by
  intro d' hd'
  obtain ⟨i, hi⟩ := mem_digits_iff_getD (by decide) hd'
  rw [hi, Nat.getD_digits 1 i (by decide)]
  rcases lt_or_ge i 1 with hi_len | hi_len
  · interval_cases i <;> decide
  · have h_pow : 10 ^ i ≥ 10 := by
      calc 10 ^ i ≥ 10 ^ 1 := Nat.pow_le_pow_right (by decide) hi_len
      _ = 10 := by decide
    have h_div : 1 / 10 ^ i = 0 := by
      apply Nat.div_eq_of_lt
      omega
    rw [h_div]
    decide


