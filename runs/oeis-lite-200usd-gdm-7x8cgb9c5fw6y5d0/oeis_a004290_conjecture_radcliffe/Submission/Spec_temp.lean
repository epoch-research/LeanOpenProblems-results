  obtain ⟨i, hi⟩ := mem_digits_iff_getD (by decide) hd'
  rw [hi, Nat.getD_digits 10100000001 i (by decide)]
  rcases lt_or_ge i 11 with hi_len | hi_len
  · interval_cases i <;> decide
  · have h_pow : 10 ^ i ≥ 100000000000 := by
      calc 10 ^ i ≥ 10 ^ 11 := Nat.pow_le_pow_right (by decide) hi_len
      _ = 100000000000 := by decide
    have h_div : 10100000001 / 10 ^ i = 0 := by
      apply Nat.div_eq_of_lt
      omega
    rw [h_div]
    decide


