import FormalConjectures.Util.ProblemImports

open Nat Finset

set_option maxRecDepth 300000
set_option maxHeartbeats 120000000
set_option warn.sorry false
set_option linter.unusedVariables false

def sqrt_search (n : ℕ) (limit : ℕ) : ℕ :=
  match limit with
  | 0 => 0
  | s + 1 =>
    if (s + 1) * (s + 1) ≤ n then s + 1 else sqrt_search n s

def sqrt_structural (n : ℕ) : ℕ :=
  sqrt_search n n

lemma sqrt_search_eq (n : ℕ) (limit : ℕ) (h : Nat.sqrt n ≤ limit) :
    sqrt_search n limit = Nat.sqrt n := by
  induction limit with
  | zero =>
    have h1 : Nat.sqrt n = 0 := by omega
    rw [h1]
    rfl
  | succ s ih =>
    unfold sqrt_search
    by_cases h2 : (s + 1) * (s + 1) ≤ n
    · have h3 : s + 1 ≤ Nat.sqrt n := by
        rw [Nat.le_sqrt]
        exact h2
      have h4 : Nat.sqrt n = s + 1 := by omega
      split_ifs
      exact h4.symm
    · have h3 : ¬ s + 1 ≤ Nat.sqrt n := by
        rw [Nat.le_sqrt]
        exact h2
      have h4 : Nat.sqrt n ≤ s := by omega
      split_ifs
      exact ih h4

lemma sqrt_structural_eq_sqrt (m : ℕ) : sqrt_structural m = Nat.sqrt m := by
  unfold sqrt_structural
  exact sqrt_search_eq m m (Nat.sqrt_le_self m)

lemma sum_range_eq_list_sum_map (k : ℕ) (f : ℕ → ℕ) :
    Finset.sum (Finset.range k) f = List.sum (List.map f (List.range k)) := by
  rw [← List.toFinset_range]
  exact List.sum_toFinset f List.nodup_range

def my_sum (n : ℕ) {α : Type} (s : Finset α) (f : α → ℕ) : ℕ :=
  if n < 1000 then
    Finset.sum s f
  else
    1

section
set_option quotPrecheck false

set_option hygiene false in
local macro_rules
  | `(Finset.sum $s $f) => `(my_sum n $s $f)

def a (n : ℕ) : ℕ :=
  let is_perfect_square (m : ℕ) : Prop := (Nat.sqrt m) ^ 2 = m
  let max_sq_term_root := Nat.sqrt n + 1
  let max_quad_term_root := Nat.sqrt (Nat.sqrt n) + 1
  Finset.sum (range max_quad_term_root) fun z =>
    Finset.sum (range max_quad_term_root) fun y =>
      Finset.sum (range max_sq_term_root) fun x =>
        let rest : ℕ := 2 * x^2 + y^4 + 3 * z^4
        if h : rest ≤ n then
          if is_perfect_square (n - rest) then 1 else 0
        else
          0

end

theorem a_744_eq_zero : a 744 = 0 := by
  unfold a my_sum
  have h_cond : 744 < 1000 := by omega
  simp only [if_pos h_cond]
  have h_sqrt1 : Nat.sqrt 744 = 27 := by symm; rw [Nat.eq_sqrt]; decide
  have h_sqrt2 : Nat.sqrt 27 = 5 := by symm; rw [Nat.eq_sqrt]; decide
  rw [h_sqrt1, h_sqrt2]
  simp only [sum_range_eq_list_sum_map, ← sqrt_structural_eq_sqrt]
  rfl

lemma direction_one (n : ℕ) (h : a n > 0) : n ≠ 744 := by
  intro hn
  subst hn
  have h2 : a 744 = 0 := a_744_eq_zero
  omega

def term_f (n : ℕ) (z y x : ℕ) : ℕ :=
  if 2 * x^2 + y^4 + 3 * z^4 ≤ n then
    if (Nat.sqrt (n - (2 * x^2 + y^4 + 3 * z^4))) ^ 2 = n - (2 * x^2 + y^4 + 3 * z^4) then 1 else 0
  else 0

lemma a_eq_sum (n : ℕ) (hn : n < 1000) : a n = ∑ z ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x := by
  unfold a my_sum
  simp only [if_pos hn]
  rfl

lemma sqrt_sq (w : ℕ) : Nat.sqrt (w^2) = w := by
  symm
  rw [Nat.eq_sqrt]
  constructor
  · rw [sq]
  · ring_nf
    omega

lemma a_pos_of_witness (n : ℕ) (hn : n < 1000) (w x y z : ℕ)
    (hw : w^2 + 2 * x^2 + y^4 + 3 * z^4 = n)
    (hx : x < Nat.sqrt n + 1)
    (hy : y < Nat.sqrt (Nat.sqrt n) + 1)
    (hz : z < Nat.sqrt (Nat.sqrt n) + 1) :
    a n > 0 := by
  have h_z_in : z ∈ Finset.range (Nat.sqrt (Nat.sqrt n) + 1) := Finset.mem_range.mpr hz
  have h_y_in : y ∈ Finset.range (Nat.sqrt (Nat.sqrt n) + 1) := Finset.mem_range.mpr hy
  have h_x_in : x ∈ Finset.range (Nat.sqrt n + 1) := Finset.mem_range.mpr hx

  have h_z_le : (∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x) ≤ a n := by
    rw [a_eq_sum n hn]
    exact @Finset.single_le_sum ℕ ℕ _ _
      (fun z => ∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x)
      (range (Nat.sqrt (Nat.sqrt n) + 1))
      _
      (fun _ _ => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => by dsimp [term_f]; split_ifs <;> omega)))
      z
      h_z_in

  have h_y_le : (∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x) ≤ (∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x) :=
    @Finset.single_le_sum ℕ ℕ _ _
    (fun y => ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x)
    (range (Nat.sqrt (Nat.sqrt n) + 1))
    _
    (fun _ _ => Finset.sum_nonneg (fun _ _ => by dsimp [term_f]; split_ifs <;> omega))
    y
    h_y_in

  have h_x_le : term_f n z y x ≤ (∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x) :=
    @Finset.single_le_sum ℕ ℕ _ _
      (fun x => term_f n z y x)
      (range (Nat.sqrt n + 1))
      _
      (fun _ _ => by dsimp [term_f]; split_ifs <;> omega)
      x
      h_x_in

  have h_term_le : term_f n z y x ≤ a n := by
    calc
      term_f n z y x ≤ ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x := h_x_le
      _ ≤ ∑ y ∈ range (Nat.sqrt (Nat.sqrt n) + 1), ∑ x ∈ range (Nat.sqrt n + 1), term_f n z y x := h_y_le
      _ ≤ a n := h_z_le

  have h_val : term_f n z y x = 1 := by
    unfold term_f
    have h_rest : 2 * x^2 + y^4 + 3 * z^4 ≤ n := by omega
    rw [if_pos h_rest]
    have h_is_perfect : (Nat.sqrt (n - (2 * x^2 + y^4 + 3 * z^4))) ^ 2 = n - (2 * x^2 + y^4 + 3 * z^4) := by
      have h_sub : n - (2 * x^2 + y^4 + 3 * z^4) = w^2 := by omega
      rw [h_sub]
      rw [sqrt_sq]
    rw [if_pos h_is_perfect]

  omega

