-- Combining theorems
theorem sol_witness_correct (n : ℕ) (hn : n < 1000) (hn744 : n ≠ 744) :
    let sol := sol_witness n
    sol.1^2 + 2 * sol.2.1^2 + sol.2.2.1^4 + 3 * sol.2.2.2^4 = n := by
  by_cases h0 : n < 200
  · exact sol_witness_correct_chunk0 n h0 hn744
  · by_cases h1 : n < 400
    · have h_ge : n ≥ 200 := by omega
      exact sol_witness_correct_chunk1 n h1 h_ge hn744
    · by_cases h2 : n < 600
      · have h_ge : n ≥ 400 := by omega
        exact sol_witness_correct_chunk2 n h2 h_ge hn744
      · by_cases h3 : n < 800
        · have h_ge : n ≥ 600 := by omega
          exact sol_witness_correct_chunk3 n h3 h_ge hn744
        · have h_ge : n ≥ 800 := by omega
          exact sol_witness_correct_chunk4 n hn h_ge hn744

theorem sol_witness_bounds (n : ℕ) (hn : n < 1000) (hn744 : n ≠ 744) :
  let sol := sol_witness n
  sol.2.1 < sqrt_structural n + 1 ∧
  sol.2.2.1 < sqrt_structural (sqrt_structural n) + 1 ∧
  sol.2.2.2 < sqrt_structural (sqrt_structural n) + 1 := by
  by_cases h0 : n < 200
  · exact sol_witness_bounds_chunk0 n h0 hn744
  · by_cases h1 : n < 400
    · have h_ge : n ≥ 200 := by omega
      exact sol_witness_bounds_chunk1 n h1 h_ge hn744
    · by_cases h2 : n < 600
      · have h_ge : n ≥ 400 := by omega
        exact sol_witness_bounds_chunk2 n h2 h_ge hn744
      · by_cases h3 : n < 800
        · have h_ge : n ≥ 600 := by omega
          exact sol_witness_bounds_chunk3 n h3 h_ge hn744
        · have h_ge : n ≥ 800 := by omega
          exact sol_witness_bounds_chunk4 n hn h_ge hn744

