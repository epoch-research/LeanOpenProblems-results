def get_witness : List (ℕ × ℕ × ℕ × ℕ) → ℕ → ℕ × ℕ × ℕ × ℕ
  | [], _ => (0, 0, 0, 0)
  | x :: _, 0 => x
  | _ :: xs, n + 1 => get_witness xs n

def sol_witness (n : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  get_witness sol_witness_list n

-- Chunked decide correctness proofs
theorem sol_witness_correct_chunk0 : ∀ n < 200, n ≠ 744 →
    let sol := sol_witness n
    sol.1^2 + 2 * sol.2.1^2 + sol.2.2.1^4 + 3 * sol.2.2.2^4 = n := by decide

theorem sol_witness_correct_chunk1 : ∀ n < 400, n ≥ 200 → n ≠ 744 →
    let sol := sol_witness n
    sol.1^2 + 2 * sol.2.1^2 + sol.2.2.1^4 + 3 * sol.2.2.2^4 = n := by decide

