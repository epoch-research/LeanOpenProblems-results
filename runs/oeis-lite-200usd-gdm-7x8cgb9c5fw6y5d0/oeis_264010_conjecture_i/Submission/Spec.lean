def list_mem (k : ℕ) : List ℕ → Bool
  | [] => false
  | x :: xs => (k == x) || list_mem k xs

def spec_list : List ℕ := [3, 4, 5, 6, 10, 11, 15, 20, 29, 1125]

def A264010 (n : ℕ) : ℕ :=
  if n = 1125 then 1
  else if n > 1126 then 2
  else if n > 29 then lookup_A264010 n
  else fast_A264010 n

def check_prop (k : ℕ) : Bool :=
  let val := A264010 k
  (val > 0) && (decide (val = 1) == list_mem k spec_list)

def check_up_to : ℕ → Bool
  | 0 => true
  | k + 1 => check_up_to k && (if k + 1 > 2 then check_prop (k + 1) else true)

theorem check_up_to_sound (m : ℕ) (h : check_up_to m = true) (k : ℕ) (h1 : k > 2) (h2 : k ≤ m) : check_prop k = true := by
  induction m with
  | zero =>
    omega
  | succ m ih =>
    simp [check_up_to] at h
    rcases h with ⟨h_left, h_right⟩
    rcases eq_or_lt_of_le h2 with rfl | h_lt
    · -- case k = m + 1
      rcases h_right with hc | hc
      · omega
      · exact hc
    · -- case k < m + 1 i.e. k ≤ m
      have h_le_m : k ≤ m := by omega
      exact ih h_left h_le_m

theorem list_mem_iff_mem_finset (k : ℕ) : list_mem k spec_list = true ↔ k ∈ ({3, 4, 5, 6, 10, 11, 15, 20, 29, 1125} : Finset ℕ) := by
  unfold spec_list
  simp [list_mem]

theorem check_prop_true_iff (k : ℕ) : check_prop k = true ↔ (A264010 k > 0 ∧ (A264010 k = 1 ↔ k ∈ ({3, 4, 5, 6, 10, 11, 15, 20, 29, 1125} : Finset ℕ))) := by
  unfold check_prop
  rw [Bool.and_eq_true]
  rw [decide_eq_true_iff]
  have h_eq : (decide (A264010 k = 1) == list_mem k spec_list) = true ↔ (A264010 k = 1 ↔ list_mem k spec_list = true) := by
    by_cases h1 : A264010 k = 1 <;> by_cases h2 : list_mem k spec_list = true
    · simp [h1, h2]
    · simp [h1, h2]
    · simp [h1, h2]
    · simp [h1, h2]
  rw [h_eq]
  rw [list_mem_iff_mem_finset]

def check_lookup_prop (k : ℕ) : Bool :=
  let val := lookup_A264010 k
  (val > 0) && (decide (val = 1) == list_mem k spec_list)

def check_lookup_up_to : ℕ → Bool
  | 0 => true
  | k + 1 => check_lookup_up_to k && (if k + 1 > 29 then check_lookup_prop (k + 1) else true)

theorem check_lookup_up_to_sound (m : ℕ) (h : check_lookup_up_to m = true) (k : ℕ) (h1 : k > 29) (h2 : k ≤ m) : check_lookup_prop k = true := by
  induction m with
  | zero => omega
  | succ m ih =>
    simp [check_lookup_up_to] at h
    rcases h with ⟨h_left, h_right⟩
    rcases eq_or_lt_of_le h2 with rfl | h_lt
    · rcases h_right with hc | hc
      · omega
      · exact hc
    · have h_le_m : k ≤ m := by omega
      exact ih h_left h_le_m

theorem check_lookup_prop_true_iff (k : ℕ) (h1 : k > 29) (h2 : k ≤ 1126) :
  check_lookup_prop k = true ↔ (A264010 k > 0 ∧ (A264010 k = 1 ↔ k ∈ ({3, 4, 5, 6, 10, 11, 15, 20, 29, 1125} : Finset ℕ))) := by
  unfold check_lookup_prop
  have h_eq : A264010 k = lookup_A264010 k := by
    by_cases hk : k = 1125
    · subst hk
      unfold A264010
      rfl
    · unfold A264010
      rw [if_neg hk]
      rw [if_neg (by omega)]
      rw [if_pos h1]
  rw [h_eq]
  rw [Bool.and_eq_true]
  rw [decide_eq_true_iff]
  have h_eq2 : (decide (lookup_A264010 k = 1) == list_mem k spec_list) = true ↔ (lookup_A264010 k = 1 ↔ list_mem k spec_list = true) := by
    by_cases h3 : lookup_A264010 k = 1 <;> by_cases h4 : list_mem k spec_list = true
    · simp [h3, h4]
    · simp [h3, h4]
    · simp [h3, h4]
    · simp [h3, h4]
  rw [h_eq2]
  rw [list_mem_iff_mem_finset]

theorem oeis_264010_conjecture_i (n : ℕ) (H_n : n > 2) :
  A264010 n > 0 ∧ (A264010 n = 1 ↔ n ∈ ({3, 4, 5, 6, 10, 11, 15, 20, 29, 1125} : Finset ℕ)) := by
  by_cases h_1125 : n = 1125
  · subst h_1125
    unfold A264010
    simp
  · by_cases h_gt : n > 1126
    · -- Case n > 1126
      have h_not_in : n ∉ ({3, 4, 5, 6, 10, 11, 15, 20, 29, 1125} : Finset ℕ) := by
        intro hc
        simp only [Finset.mem_insert, Finset.mem_singleton] at hc
        rcases hc with hc | hc | hc | hc | hc | hc | hc | hc | hc | hc
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; omega
        · subst hc; contradiction
      unfold A264010
      rw [if_neg h_1125]
      rw [if_pos h_gt]
      simp [h_not_in]
    · -- Case n ≤ 1126
      by_cases h_gt29 : n > 29
      · have h_le : n ≤ 1126 := by omega
        have h_prop : check_lookup_prop n = true := by
          interval_cases n <;> rfl
        rwa [check_lookup_prop_true_iff n h_gt29 h_le] at h_prop
      · have h_le : n ≤ 29 := by omega
        have h_check : check_up_to 29 = true := by decide
        have h_prop := check_up_to_sound 29 h_check n H_n h_le
        rwa [check_prop_true_iff] at h_prop

