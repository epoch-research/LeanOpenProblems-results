import FormalConjectures.Util.ProblemImports

open Nat Finset

set_option maxHeartbeats 0
set_option maxRecDepth 200000

def my_div2 (n : ℕ) : ℕ :=
  match n with
  | 0 => 0
  | 1 => 0
  | k + 2 => my_div2 k + 1

def my_sqrt_fuel (fuel : ℕ) (n : ℕ) (i : ℕ) : ℕ :=
  match fuel with
  | 0 => i
  | f + 1 =>
    if i * i > n then i - 1
    else my_sqrt_fuel f n (i + 1)

def my_sqrt (n : ℕ) : ℕ :=
  my_sqrt_fuel n n 0

def my_prime_aux (fuel : ℕ) (n : ℕ) (i : ℕ) : Bool :=
  match fuel with
  | 0 => true
  | f + 1 =>
    if i * i > n then true
    else if n % i == 0 then false
    else my_prime_aux f n (i + 1)

def my_prime (n : ℕ) : Bool :=
  if n < 2 then false
  else if n == 2 then true
  else if n % 2 == 0 then false
  else my_prime_aux n n 3

def prime_cond_bool (k : ℕ) : Bool :=
  my_prime k || my_prime (k + 1)

def sum_z (n : ℕ) (y : ℕ) (py : Bool) (B_z : ℕ) : ℕ :=
  match B_z with
  | 0 => 0
  | z + 1 =>
    sum_z n y py z +
      let T_z := my_div2 (z * (z + 1))
      let Y_y := y * (y + 1)
      if (Y_y + T_z ≤ n) then
        let rem := n - Y_y - T_z
        let x := my_sqrt rem
        if (x * x == rem) && py && prime_cond_bool z then 1 else 0
      else 0

def sum_y (n : ℕ) (B_y B_z : ℕ) : ℕ :=
  match B_y with
  | 0 => 0
  | y + 1 => sum_y n y B_z + sum_z n y (prime_cond_bool y) B_z

def fast_A264010 (n : ℕ) : ℕ :=
  let B_y := my_sqrt n + 1
  let B_z := my_sqrt (2 * n) + 1
  sum_y n B_y B_z

