lemma card_divisors_le_60_of_le_5040 (L : ℕ) (h_le : L ≤ 5040) : (divisors L).card ≤ 60 := by
  by_cases hL0 : L = 0
  · subst hL0; simp
  · have hL_ge : 1 ≤ L := Nat.succ_le_of_lt (Nat.pos_of_ne_zero hL0)
    have h1 : 1 ≤ L ∧ L ≤ 1 + 5039 := by omega
    have h_int_0 : ∀ x, 1 ≤ x ∧ x ≤ 4001 → (divisors x).card < 61 := by
      apply check_div_card_interval_range 61 1 4000
      decide
    have h_int_1 : ∀ x, 4002 ≤ x ∧ x ≤ 5040 → (divisors x).card < 61 := by
      apply check_div_card_interval_range 61 4002 1038
