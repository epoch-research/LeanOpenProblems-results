  have h_L_le : L ≤ 22680 := by omega
  have h_div_card : (divisors L).card ≤ 84 := card_divisors_le_84_of_le_22680 L h_L_le
  have h_L_pos : L ≠ 0 := by
    by_contra! hL_zero
    subst hL_zero
    have : D.lcm id = 0 := hL_lcm.symm
    have h_nonempty : D.Nonempty := by
      by_contra! h_empty
      rw [Finset.Nonempty, not_not] at h_empty
      have : D.card = 0 := Finset.card_eq_zero.mpr h_empty
      omega
    have h_lcm_pos := Finset.lcm_pos (f := id) (s := D) h_nonempty (by
