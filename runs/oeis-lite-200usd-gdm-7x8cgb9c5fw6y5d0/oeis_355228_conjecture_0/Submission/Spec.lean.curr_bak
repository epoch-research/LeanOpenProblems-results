    have h_int_0 : ∀ x, 1 ≤ x ∧ x ≤ 180 → (divisors x).card < 19 := by
      apply check_div_card_interval_range 19 1 179
      decide
    have h_prop := h_int_0 L ⟨by omega, by omega⟩
    omega

