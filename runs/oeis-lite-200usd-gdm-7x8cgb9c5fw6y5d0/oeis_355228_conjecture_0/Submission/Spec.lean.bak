lemma a_le_a081512_of_lemma {k : ℕ} (h_lem : ∀ m, P_a08 k m → ∃ m' ≤ m, P_a k m') : a k ≤ a081512 k := by
  rw [a081512_def_eq, a_def_eq]
  by_cases h_empty : { m : ℕ | P_a08 k m } = ∅
  · rw [h_empty]
    have h_sub : { m : ℕ | P_a k m } ⊆ { m : ℕ | P_a08 k m } := by
      intro x hx
      simp only [mem_setOf_eq] at hx ⊢
      rcases hx with ⟨hx1, D, hD, hcard, hsum, hlcm⟩
      refine ⟨hx1, D, hD, hcard, hsum⟩
    have h_empty_a : { m : ℕ | P_a k m } = ∅ := by
      rw [h_empty] at h_sub
      exact Set.subset_empty_iff.mp h_sub
    rw [h_empty_a]
  · have h_nonempty : { m : ℕ | P_a08 k m }.Nonempty := Set.nonempty_iff_ne_empty.mpr h_empty
    have h_mem := Nat.sInf_mem h_nonempty
    simp only [mem_setOf_eq] at h_mem
    rcases h_lem (sInf { m : ℕ | P_a08 k m }) h_mem with ⟨m', hm'_le, hm'_Pa⟩
    have h_mem_a : m' ∈ { x : ℕ | P_a k x } := by
      simp only [mem_setOf_eq]
      exact hm'_Pa
    have h_le := Nat.sInf_le h_mem_a
    exact le_trans h_le hm'_le

lemma lcm_dvd_of_subset_divisors {D : Finset ℕ} {m : ℕ} (hD : D ⊆ divisors m) :
    D.lcm id ∣ m := by
  apply Finset.lcm_dvd
  intro b hb
  have h_b_div := hD hb
  exact Nat.dvd_of_mem_divisors h_b_div

-- Memory-efficient range checking via tail-recursive loops over intervals
def check_div_card_interval (k : ℕ) (start : ℕ) (len : ℕ) (fuel : ℕ) : Bool :=
  match fuel with
  | 0 => false
  | fuel + 1 =>
    if len = 0 then
      decide ((divisors start).card < k)
    else
      let mid := len / 2
      check_div_card_interval k start mid fuel && check_div_card_interval k (start + mid + 1) (len - mid - 1) fuel

lemma check_div_card_interval_prop (k : ℕ) (start : ℕ) (len : ℕ) (fuel : ℕ) (h : check_div_card_interval k start len fuel = true) :
    ∀ x, start ≤ x ∧ x ≤ start + len → (divisors x).card < k := by
  induction fuel generalizing start len with
  | zero => simp [check_div_card_interval] at h
  | succ fuel ih =>
    rw [check_div_card_interval] at h
    by_cases h_zero : len = 0
    · simp [h_zero] at h
      intro x hx
      have : x = start := by omega
      subst this
      exact h
    · simp [h_zero] at h
      rcases h with ⟨h1, h2⟩
      intro x hx
      let mid := len / 2
      by_cases h_le : x ≤ start + mid
      · exact ih start mid h1 x ⟨hx.1, h_le⟩
      · have h_ge : start + mid + 1 ≤ x := by omega
        have h_le_right : x ≤ start + mid + 1 + (len - mid - 1) := by omega
        exact ih (start + mid + 1) (len - mid - 1) h2 x ⟨h_ge, h_le_right⟩

lemma check_div_card_interval_range (k : ℕ) (start : ℕ) (len : ℕ) (h : check_div_card_interval k start len (len + 1) = true) :
    ∀ x, start ≤ x ∧ x ≤ start + len → (divisors x).card < k := by
  exact check_div_card_interval_prop k start len (len + 1) h

-- Let's define the 4 non-overlapping interval lemmas
lemma card_divisors_le_108_of_le_55439 (L : ℕ) (h_le : L ≤ 55439) : (divisors L).card ≤ 108 := by
  have h_int_0 : ∀ x, 0 ≤ x ∧ x ≤ 3000 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 0 3000
    decide
  have h_int_1 : ∀ x, 3001 ≤ x ∧ x ≤ 6001 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 3001 3000
    decide
  have h_int_2 : ∀ x, 6002 ≤ x ∧ x ≤ 9002 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 6002 3000
    decide
  have h_int_3 : ∀ x, 9003 ≤ x ∧ x ≤ 12003 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 9003 3000
    decide
  have h_int_4 : ∀ x, 12004 ≤ x ∧ x ≤ 15004 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 12004 3000
    decide
  have h_int_5 : ∀ x, 15005 ≤ x ∧ x ≤ 18005 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 15005 3000
    decide
  have h_int_6 : ∀ x, 18006 ≤ x ∧ x ≤ 21006 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 18006 3000
    decide
  have h_int_7 : ∀ x, 21007 ≤ x ∧ x ≤ 24007 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 21007 3000
    decide
  have h_int_8 : ∀ x, 24008 ≤ x ∧ x ≤ 27008 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 24008 3000
    decide
  have h_int_9 : ∀ x, 27009 ≤ x ∧ x ≤ 30009 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 27009 3000
    decide
  have h_int_10 : ∀ x, 30010 ≤ x ∧ x ≤ 33010 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 30010 3000
    decide
  have h_int_11 : ∀ x, 33011 ≤ x ∧ x ≤ 36011 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 33011 3000
    decide
  have h_int_12 : ∀ x, 36012 ≤ x ∧ x ≤ 39012 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 36012 3000
    decide
  have h_int_13 : ∀ x, 39013 ≤ x ∧ x ≤ 42013 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 39013 3000
    decide
  have h_int_14 : ∀ x, 42014 ≤ x ∧ x ≤ 45014 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 42014 3000
    decide
  have h_int_15 : ∀ x, 45015 ≤ x ∧ x ≤ 48015 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 45015 3000
    decide
  have h_int_16 : ∀ x, 48016 ≤ x ∧ x ≤ 51016 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 48016 3000
    decide
  have h_int_17 : ∀ x, 51017 ≤ x ∧ x ≤ 54017 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 51017 3000
    decide
  have h_int_18 : ∀ x, 54018 ≤ x ∧ x ≤ 55439 → (divisors x).card < 109 := by
    apply check_div_card_interval_range 109 54018 1421
    decide
  by_cases h_le_3000 : L ≤ 3000
  · exact h_int_0 L ⟨by omega, h_le_3000⟩
  · 
    by_cases h_le_6001 : L ≤ 6001
    · exact h_int_1 L ⟨by omega, h_le_6001⟩
    · 
      by_cases h_le_9002 : L ≤ 9002
      · exact h_int_2 L ⟨by omega, h_le_9002⟩
      · 
        by_cases h_le_12003 : L ≤ 12003
        · exact h_int_3 L ⟨by omega, h_le_12003⟩
        · 
          by_cases h_le_15004 : L ≤ 15004
          · exact h_int_4 L ⟨by omega, h_le_15004⟩
          · 
            by_cases h_le_18005 : L ≤ 18005
            · exact h_int_5 L ⟨by omega, h_le_18005⟩
            · 
              by_cases h_le_21006 : L ≤ 21006
              · exact h_int_6 L ⟨by omega, h_le_21006⟩
              · 
                by_cases h_le_24007 : L ≤ 24007
                · exact h_int_7 L ⟨by omega, h_le_24007⟩
                · 
                  by_cases h_le_27008 : L ≤ 27008
                  · exact h_int_8 L ⟨by omega, h_le_27008⟩
                  · 
                    by_cases h_le_30009 : L ≤ 30009
                    · exact h_int_9 L ⟨by omega, h_le_30009⟩
                    · 
                      by_cases h_le_33010 : L ≤ 33010
                      · exact h_int_10 L ⟨by omega, h_le_33010⟩
                      · 
                        by_cases h_le_36011 : L ≤ 36011
                        · exact h_int_11 L ⟨by omega, h_le_36011⟩
                        · 
                          by_cases h_le_39012 : L ≤ 39012
