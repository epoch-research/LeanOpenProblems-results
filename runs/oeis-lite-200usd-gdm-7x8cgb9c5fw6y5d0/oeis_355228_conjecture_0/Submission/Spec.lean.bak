lemma helper (k : ℕ) (hk : 6 ≤ k) (m : ℕ) : P_a08 k m → ∃ m' ≤ m, P_a k m' := by
  induction' m using Nat.strong_induction_on with m ih
  intro hm
  by_cases h_exists : ∃ m' < m, P_a08 k m'
  · rcases h_exists with ⟨m', hm'_lt, hm'_Pa08⟩
    rcases ih m' hm'_lt hm'_Pa08 with ⟨m'', hm''_le, hm''_Pa⟩
    use m''
    refine ⟨by omega, hm''_Pa⟩
  · have hm_copy := hm
    rcases hm with ⟨h_pos, D, hD, hcard, hsum⟩
    rw [Finset.mem_powerset] at hD
    let L := D.lcm id
    have hL_dvd : L ∣ m := lcm_dvd_of_subset_divisors hD
    have hL_le : L ≤ m := Nat.le_of_dvd h_pos hL_dvd
    by_cases hL : L = m
    · use m
      refine ⟨le_rfl, ?_⟩
      rw [← P_a_eq]
      exact ⟨h_pos, D, hD, hcard, hsum, hL⟩
    · have hL_lt : L < m := lt_of_le_of_ne hL_le hL
      by_cases hk_le_160 : k ≤ 160
      · -- Block level split
        by_cases hk_le_85 : k ≤ 85
        · by_cases hk_le_45 : k ≤ 45
          · by_cases hk_le_25 : k ≤ 25
            · exact helper_block_0 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl hk hk_le_25
            · exact helper_block_1 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_45
          · by_cases hk_le_65 : k ≤ 65
            · exact helper_block_2 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_65
            · exact helper_block_3 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_85
        · by_cases hk_le_125 : k ≤ 125
          · by_cases hk_le_105 : k ≤ 105
            · exact helper_block_4 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_105
            · exact helper_block_5 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_125
          · by_cases hk_le_145 : k ≤ 145
            · exact helper_block_6 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_145
            · exact helper_block_7 m hm_copy h_exists h_pos D hD hcard hsum L hL_dvd hL_lt rfl (by omega) hk_le_160
      · -- k >= 161
        sorry

lemma a_le_a081512_of_helper {k : ℕ} (hk : 6 ≤ k) : a k ≤ a081512 k := by
  apply a_le_a081512_of_lemma
  intro m hm
  exact helper k hk m hm

theorem oeis_355228_conjecture_0 (n : ℕ) :
  (a n > a081512 n) ↔ (n = 4 ∨ n = 5) := by
  rcases n with _ | _ | _ | _ | _ | _ | n
  · simp only [a_zero, a081512_zero]
    omega
  · simp only [a_one, a081512_one]
    omega
  · simp only [a_two, a081512_two]
    omega
  · simp only [a_three, a081512_three]
    omega
  · simp only [a_four, a081512_four]
    omega
  · simp only [a_five, a081512_five]
    omega
  · -- n >= 6
    have hn : 6 ≤ n + 6 := by omega
    have h_le := a_le_a081512_of_helper hn
    omega
