lemma helper_spec_6 (m : ℕ) (hm_copy : P_a08 6 m) (h_exists : ¬ ∃ m' < m, P_a08 6 m')
    (h_pos : 0 < m) (D : Finset ℕ) (hD : D ⊆ divisors m) (hcard : D.card = 6)
    (hsum : D.sum id = m) (L : ℕ) (hL_dvd : L ∣ m) (hL_lt : L < m) (hL_lcm : L = D.lcm id) :
    ∃ m' ≤ m, P_a 6 m' := by
  have h_le : m ≤ 24 := by
    by_contra! h_gt
    have h_lt : 24 < m := h_gt
    have h_P : P_a08 6 24 := by decide
    exact h_exists ⟨24, h_lt, h_P⟩
  have h_L_le : L ≤ 12 := by omega
  have h_cases : L = 12 ∨ (L ≤ 12 ∧ L ≠ 12) := by
    by_cases h12 : L = 12
    · left; exact h12
    · right;
      refine ⟨by omega, by symm; exact h12⟩
  rcases h_cases with rfl | ⟨h_L_le', h_L_ne_12⟩
  · -- L = 12
    have h_m_eq : m = 24 := by
      by_contra h_ne
      have h_lt : m < 24 := lt_of_le_of_ne h_le h_ne
      have h_no : ∀ m' < 24, ¬ ∃ D ∈ powersetCard 6 (divisors 12), D.sum id = m' := by decide
      exact h_no m h_lt D (by rw [mem_powersetCard]; exact ⟨hD, hcard⟩) hsum
    subst h_m_eq
    use 24
    refine ⟨le_rfl, ?_⟩
    rw [← P_a_eq]
    refine ⟨by omega, {1, 2, 3, 4, 6, 8}, ?_, ?_, ?_, ?_⟩
    · intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl|rfl|rfl|rfl|rfl|rfl
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
    · decide
    · decide
    · decide
  · have h_card_lt : (divisors L).card < 6 := by
      have h_lt_lim : L < 12 := lt_of_le_of_ne h_L_le' h_L_ne_12
      exact check_div_card_interval_range 6 0 11 (by decide) L ⟨by omega, (by omega)⟩
    have h_card_ge := Finset.card_le_card hD
    omega

