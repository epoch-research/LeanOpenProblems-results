lemma smallPrimes_complete {p : ℕ} (hp : Nat.Prime p) (hple : p ≤ 997) :
    p ∈ smallPrimes := by
  have hp2 : 2 ≤ p := hp.two_le
  if h : p ≤ 51 then
    exact complete_2_51 p hp2 h hp
  else if h : p ≤ 101 then
    exact complete_52_101 p (by omega) h hp
  else if h : p ≤ 151 then
    exact complete_102_151 p (by omega) h hp
  else if h : p ≤ 201 then
    exact complete_152_201 p (by omega) h hp
  else if h : p ≤ 251 then
    exact complete_202_251 p (by omega) h hp
  else if h : p ≤ 301 then
    exact complete_252_301 p (by omega) h hp
  else if h : p ≤ 351 then
    exact complete_302_351 p (by omega) h hp
  else if h : p ≤ 401 then
    exact complete_352_401 p (by omega) h hp
  else if h : p ≤ 451 then
    exact complete_402_451 p (by omega) h hp
  else if h : p ≤ 501 then
    exact complete_452_501 p (by omega) h hp
  else if h : p ≤ 551 then
    exact complete_502_551 p (by omega) h hp
  else if h : p ≤ 601 then
    exact complete_552_601 p (by omega) h hp
  else if h : p ≤ 651 then
    exact complete_602_651 p (by omega) h hp
  else if h : p ≤ 701 then
    exact complete_652_701 p (by omega) h hp
  else if h : p ≤ 751 then
    exact complete_702_751 p (by omega) h hp
  else if h : p ≤ 801 then
    exact complete_752_801 p (by omega) h hp
  else if h : p ≤ 851 then
    exact complete_802_851 p (by omega) h hp
  else if h : p ≤ 901 then
    exact complete_852_901 p (by omega) h hp
  else if h : p ≤ 951 then
    exact complete_902_951 p (by omega) h hp
  else
    exact complete_952_997 p (by omega) hple hp


lemma isPS_iff (n : ℕ) : isPS n = true ↔ Nat.Prime n := by
  unfold isPS
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true_eq_eq_false,
    Bool.eq_false_iff]
  constructor
  · intro ⟨⟨hn, hsp⟩, hdiv⟩
    have hsp' : ¬ ∃ p ∈ smallPrimes, p ∣ n ∧ p * p ≤ n := by
      rw [← hasPrimeDiv_eq_true_iff]; exact hsp
    rw [Nat.prime_def_le_sqrt]
    refine ⟨hn, fun m hm2 hms hmd => ?_⟩
    have hmsq : m * m ≤ n := Nat.le_sqrt.mp hms
    by_cases hm998 : m < 998
    · have h1 : 1 < m := by omega
      have hpp : Nat.Prime m.minFac := Nat.minFac_prime (ne_of_gt h1)
      have hpd : m.minFac ∣ m := Nat.minFac_dvd m
      have hpn : m.minFac ∣ n := dvd_trans hpd hmd
      have hle : m.minFac ≤ m := Nat.minFac_le (by omega)
      have hp2 : m.minFac * m.minFac ≤ n :=
        le_trans (Nat.mul_le_mul hle hle) hmsq
      have hple : m.minFac ≤ 997 := by omega
      exact hsp' ⟨m.minFac, smallPrimes_complete hpp hple, hpn, hp2⟩
    · have hmge : 998 ≤ m := Nat.not_lt.mp hm998
      have h4le : 2 * 2 ≤ n := by
        have h4m : 4 ≤ m := by omega
        have hmm : m ≤ m * m :=
          Nat.le_mul_of_pos_right m (lt_of_lt_of_le (by decide : (0 : ℕ) < 2) hm2)
        exact le_trans h4m (le_trans hmm hmsq)
      by_cases hme : Even m
      · have h2n : 2 ∣ n :=
          dvd_trans (even_iff_two_dvd.mp hme) hmd
        exact hsp' ⟨2, by decide, h2n, h4le⟩
      · have hmodd : Odd m := Nat.not_even_iff_odd.mp hme
        have hm999 : 999 ≤ m := by
          have : m ≠ 998 := by
            intro h
            have : Even (998 : ℕ) := by decide
            exact hme (h ▸ this)
          omega
        have h999odd : Odd (999 : ℕ) := ⟨499, by norm_num⟩
        have hev : Even (m - 999) := Nat.Odd.sub_odd hmodd h999odd
        have : m ≤ n := le_trans hms (Nat.sqrt_le_self n)
        by_cases hsmall : n < 2097152
        · have hdiv' : ¬ ∃ d, 999 ≤ d ∧ d < 999 + 2 * 256 ∧ Even (d - 999) ∧
              d * d ≤ n ∧ 2 ≤ d ∧ d ∣ n := by
            have hf : hasDivFrom n 999 256 = false := by
              simpa [hsmall] using hdiv
            rw [← hasDivFrom_eq_true_iff]
            exact Bool.eq_false_iff.mp hf
          have hmbound : m < 999 + 2 * 256 := by
            have : m ≤ 1448 := by
              have h1449 : 1449 * 1449 = 2099601 := by norm_num
              have : m * m < 2097152 := lt_of_le_of_lt hmsq hsmall
              nlinarith
            omega
          exact hdiv' ⟨m, hm999, hmbound, hev, hmsq, by omega, hmd⟩
        · have hdiv' : ¬ ∃ d, 999 ≤ d ∧ d < 999 + 2 * n ∧ Even (d - 999) ∧
              d * d ≤ n ∧ 2 ≤ d ∧ d ∣ n := by
            have hf : hasDivFrom n 999 n = false := by
              simpa [hsmall] using hdiv
            rw [← hasDivFrom_eq_true_iff]
            exact Bool.eq_false_iff.mp hf
          have hmbound : m < 999 + 2 * n := by omega
          exact hdiv' ⟨m, hm999, hmbound, hev, hmsq, by omega, hmd⟩
  · intro hp
    have hn : 2 ≤ n := hp.two_le
    have hsqrt := (Nat.prime_def_le_sqrt.mp hp).2
    refine ⟨⟨hn, ?_⟩, ?_⟩
    · intro hpd
      rw [hasPrimeDiv_eq_true_iff] at hpd
      rcases hpd with ⟨p, hpin, hpdvd, hp2⟩
      exact hsqrt p (smallPrimes_prime p hpin).two_le (Nat.le_sqrt.mpr hp2) hpdvd
    · by_cases hsmall : n < 2097152
      · have hne : hasDivFrom n 999 256 ≠ true := by
          intro hdd
          rw [hasDivFrom_eq_true_iff] at hdd
          rcases hdd with ⟨d, hd999, _, _, hd2, _, hddvd⟩
          exact hsqrt d (by omega) (Nat.le_sqrt.mpr hd2) hddvd
        simpa [hsmall] using hne
      · have hne : hasDivFrom n 999 n ≠ true := by
          intro hdd
          rw [hasDivFrom_eq_true_iff] at hdd
          rcases hdd with ⟨d, hd999, _, _, hd2, _, hddvd⟩
          exact hsqrt d (by omega) (Nat.le_sqrt.mpr hd2) hddvd
        simpa [hsmall] using hne

lemma isSqAux_false_of_empty (n lo hi fuel : ℕ) (hle : hi ≤ lo) :
    isSqAux n lo hi fuel = false := by
  cases fuel with
  | zero => rfl
  | succ f => simp [isSqAux, hle]

lemma isSqAux_succ (n lo hi f : ℕ) :
    isSqAux n lo hi (f + 1) =
      if lo ≥ hi then false
      else
        let mid := lo + (hi - lo) / 2
        if mid * mid = n then true
        else if mid * mid < n then isSqAux n (mid + 1) hi f
        else isSqAux n lo mid f := rfl

lemma isSqAux_eq_true_iff (n lo hi fuel : ℕ) (hfuel : hi - lo ≤ fuel) :
    isSqAux n lo hi fuel = true ↔ ∃ t, lo ≤ t ∧ t < hi ∧ t * t = n := by
  induction fuel generalizing lo hi with
  | zero =>
    constructor
    · intro h; simp [isSqAux] at h
    · rintro ⟨t, h1, h2, _⟩; omega
  | succ f ih =>
    rw [isSqAux_succ]
    by_cases hempty : hi ≤ lo
    · rw [if_pos (show lo ≥ hi from hempty)]
      constructor
      · intro h; cases h
      · rintro ⟨t, h1, h2, _⟩; omega
    · have hlohi : lo < hi := Nat.not_le.mp hempty
      rw [if_neg (fun h : lo ≥ hi => hempty h)]
      set mid := lo + (hi - lo) / 2
      have hmid_lt : mid < hi := by
        have : (hi - lo) / 2 < hi - lo := Nat.div_lt_self (by omega) (by decide)
        omega
      have hmid_ge : lo ≤ mid := by omega
      by_cases heq : mid * mid = n
      · rw [if_pos heq]
        constructor
        · intro _; exact ⟨mid, hmid_ge, hmid_lt, heq⟩
        · intro _; rfl
      · rw [if_neg heq]
        by_cases hlt : mid * mid < n
        · rw [if_pos hlt]
          have hfuel' : hi - (mid + 1) ≤ f := by omega
          rw [ih (mid + 1) hi hfuel']
          constructor
          · rintro ⟨t, h1, h2, h3⟩; exact ⟨t, by omega, h2, h3⟩
          · rintro ⟨t, h1, h2, h3⟩
            refine ⟨t, ?_, h2, h3⟩
            have : ¬ t ≤ mid := fun ht => by
              have : t * t ≤ mid * mid := Nat.mul_le_mul ht ht
              omega
            omega
        · rw [if_neg hlt]
          have hfuel' : mid - lo ≤ f := by omega
          rw [ih lo mid hfuel']
          constructor
          · rintro ⟨t, h1, h2, h3⟩; exact ⟨t, h1, by omega, h3⟩
          · rintro ⟨t, h1, h2, h3⟩
            refine ⟨t, h1, ?_, h3⟩
            have : ¬ mid ≤ t := fun ht => by
              have : mid * mid ≤ t * t := Nat.mul_le_mul ht ht
              omega
            omega

lemma isSqAux_true_imp (n lo hi fuel : ℕ) :
    isSqAux n lo hi fuel = true → ∃ t, lo ≤ t ∧ t < hi ∧ t * t = n := by
  induction fuel generalizing lo hi with
  | zero => intro h; simp [isSqAux] at h
  | succ f ih =>
    rw [isSqAux_succ]
    by_cases hempty : hi ≤ lo
    · rw [if_pos (show lo ≥ hi from hempty)]; intro h; cases h
    · have hlohi : lo < hi := Nat.not_le.mp hempty
      rw [if_neg (fun h : lo ≥ hi => hempty h)]
      set mid := lo + (hi - lo) / 2
      have hmid_lt : mid < hi := by
        have : (hi - lo) / 2 < hi - lo := Nat.div_lt_self (by omega) (by decide)
        omega
      have hmid_ge : lo ≤ mid := by omega
      by_cases heq : mid * mid = n
      · rw [if_pos heq]; intro _; exact ⟨mid, hmid_ge, hmid_lt, heq⟩
      · rw [if_neg heq]
        by_cases hlt : mid * mid < n
        · rw [if_pos hlt]
          intro h
          rcases ih (mid + 1) hi h with ⟨t, h1, h2, h3⟩
          exact ⟨t, by omega, h2, h3⟩
        · rw [if_neg hlt]
          intro h
          rcases ih lo mid h with ⟨t, h1, h2, h3⟩
          exact ⟨t, h1, by omega, h3⟩

lemma isSqAux_of_exists_pow (n lo hi fuel : ℕ)
    (hpow : hi - lo < 2 ^ fuel)
    (ht : ∃ t, lo ≤ t ∧ t < hi ∧ t * t = n) :
    isSqAux n lo hi fuel = true := by
  induction fuel generalizing lo hi with
  | zero =>
    rcases ht with ⟨t, h1, h2, _⟩
    simp only [pow_zero] at hpow
    omega
  | succ f ih =>
    rw [isSqAux_succ]
    by_cases hempty : hi ≤ lo
    · rcases ht with ⟨t, h1, h2, _⟩; omega
    · have hlohi : lo < hi := Nat.not_le.mp hempty
      rw [if_neg (fun h : lo ≥ hi => hempty h)]
      set mid := lo + (hi - lo) / 2
      have hmid_lt : mid < hi := by
        have : (hi - lo) / 2 < hi - lo := Nat.div_lt_self (by omega) (by decide)
        omega
      have hmid_ge : lo ≤ mid := by omega
      by_cases heq : mid * mid = n
      · rw [if_pos heq]
      · rw [if_neg heq]
        have hhalf : (hi - lo) / 2 < 2 ^ f := by
          have hmul : 2 ^ (f + 1) = 2 * 2 ^ f := by rw [pow_succ, mul_comm]
          omega
        by_cases hlt : mid * mid < n
        · rw [if_pos hlt]
          apply ih (mid + 1) hi
          · have hmiddef : mid = lo + (hi - lo) / 2 := rfl
            omega
          · rcases ht with ⟨t, h1, h2, h3⟩
            refine ⟨t, ?_, h2, h3⟩
            have : ¬ t ≤ mid := fun htm => by
              have : t * t ≤ mid * mid := Nat.mul_le_mul htm htm
              omega
            omega
        · rw [if_neg hlt]
          apply ih lo mid
          · have hmiddef : mid = lo + (hi - lo) / 2 := rfl
            omega
          · rcases ht with ⟨t, h1, h2, h3⟩
            refine ⟨t, h1, ?_, h3⟩
            have : ¬ mid ≤ t := fun hmt => by
              have : mid * mid ≤ t * t := Nat.mul_le_mul hmt hmt
              omega
            omega

lemma isSqB_iff (n : ℕ) : isSqB n = true ↔ IsSquare n := by
  unfold isSqB
  have hex : (∃ t, 0 ≤ t ∧ t < n + 1 ∧ t * t = n) ↔ IsSquare n := by
    constructor
    · rintro ⟨t, _, _, ht⟩; exact ⟨t, ht.symm⟩
    · rintro ⟨t, ht⟩
      refine ⟨t, Nat.zero_le _, ?_, ht.symm⟩
      cases t with
      | zero => omega
      | succ t =>
        have : (t + 1) * (t + 1) = n := ht.symm
        nlinarith
  by_cases hsmall : n < 2 ^ 64
  · rw [if_pos hsmall]
    constructor
    · intro h
      exact hex.mp (isSqAux_true_imp n 0 (n + 1) 65 h)
    · intro hsq
      apply isSqAux_of_exists_pow
      · have : n + 1 ≤ 2 ^ 64 := by omega
        have : n + 1 < 2 ^ 65 := Nat.lt_of_le_of_lt this (by
          have : (2 : ℕ) ^ 64 < 2 ^ 65 := by decide
          exact this)
        simpa using this
      · exact hex.mpr hsq
  · rw [if_neg hsmall]
    have hfuel : (n + 1) - 0 ≤ n + 1 := by omega
    rw [isSqAux_eq_true_iff n 0 (n + 1) (n + 1) hfuel]
    exact hex

def startIdx (row : ℕ) : ℕ := row * (row - 1) / 2

lemma startIdx_succ (row : ℕ) : startIdx (row + 1) = startIdx row + row := by
  simp only [startIdx, Nat.add_sub_cancel]
  have h1 : 2 ∣ row * (row + 1) := (Nat.even_mul_succ_self row).two_dvd
  have h2 : 2 ∣ row * (row - 1) := by
    rcases Nat.even_or_odd row with h | h
    · exact (h.mul_right _).two_dvd
    · cases row with
      | zero => simp
      | succ r =>
        rw [Nat.succ_sub_one]
        have : Even r := by
          rw [Nat.even_iff, Nat.odd_iff] at *
          omega
        exact (this.mul_left _).two_dvd
  apply Nat.mul_left_cancel (n := 2) (by norm_num)
  rw [Nat.mul_add, Nat.mul_div_cancel' (by simpa [mul_comm] using h1),
      Nat.mul_div_cancel' h2]
  cases row with | zero => simp | succ r => simp; ring

noncomputable def rowPartial (row col : ℕ) : ℕ :=
  (Finset.range col).sum fun i ↦ Nat.nth Nat.Prime (startIdx row + i)

lemma rowPartial_succ (row col : ℕ) :
    rowPartial row (col + 1) =
      rowPartial row col + Nat.nth Nat.Prime (startIdx row + col) :=
  Finset.sum_range_succ _ _

lemma a_eq (n : ℕ) : a n = rowPartial n n := by
  unfold a rowPartial startIdx
  rfl

def RowsOK (N row : ℕ) (ok : Bool) : Prop :=
  ok = true ↔ ∀ r, 1 ≤ r → r < row → r ≤ N → (IsSquare (a r) ↔ r = 38)

lemma rowsOK_initial (N : ℕ) : RowsOK N 1 true := by
  unfold RowsOK
  constructor
  · intro _ r hr1 hrlt _; omega
  · intro; rfl

def ScanInv (N k : ℕ) : St → Prop
  | (ok, row, col, sm) =>
    1 ≤ row ∧
    (row ≤ N → col < row) ∧
    (row ≤ N → Nat.count Nat.Prime k = startIdx row + col) ∧
    (row ≤ N → sm = rowPartial row col) ∧
    (N < row → startIdx (N + 1) ≤ Nat.count Nat.Prime k) ∧
    RowsOK N row ok

lemma step_done (N k : ℕ) (ok : Bool) (row col sm : ℕ)
    (h : N < row) (hI : ScanInv N k (ok, row, col, sm)) :
    ScanInv N (k + 1) (ok, row, col, sm) := by
  rcases hI with ⟨h1, h2, h3, h4, h5, h6⟩
  refine ⟨h1, fun hle => (not_le.mpr h hle).elim, fun hle => (not_le.mpr h hle).elim,
    fun hle => (not_le.mpr h hle).elim, ?_, h6⟩
  intro _
  exact le_trans (h5 h) (Nat.count_monotone Nat.Prime (Nat.le_succ k))

lemma step_composite (N k : ℕ) (ok : Bool) (row col sm : ℕ)
    (hrow : row ≤ N) (hk : ¬ Nat.Prime k)
    (hI : ScanInv N k (ok, row, col, sm)) :
    ScanInv N (k + 1) (ok, row, col, sm) := by
  rcases hI with ⟨h1, h2, h3, h4, h5, h6⟩
  refine ⟨h1, h2, ?_, h4, ?_, h6⟩
  · intro hr
    rw [Nat.count_succ, if_neg hk, h3 hr]; rfl
  · intro hlt; omega

lemma step_prime_mid (N k : ℕ) (ok : Bool) (row col sm : ℕ)
    (hrow : row ≤ N) (hk : Nat.Prime k) (hneq : col + 1 ≠ row)
    (hI : ScanInv N k (ok, row, col, sm)) :
    ScanInv N (k + 1) (ok, row, col + 1, sm + k) := by
  rcases hI with ⟨h1, h2, h3, h4, h5, h6⟩
  have hclt : col + 1 < row := Nat.lt_of_le_of_ne (Nat.succ_le_of_lt (h2 hrow)) hneq
  refine ⟨h1, fun _ => hclt, ?_, ?_, fun hlt => by omega, h6⟩
  · intro _
    rw [Nat.count_succ, if_pos hk, h3 hrow, Nat.add_assoc]
  · intro _
    rw [rowPartial_succ, h4 hrow]
    have : Nat.nth Nat.Prime (startIdx row + col) = k := by
      rw [← h3 hrow, Nat.nth_count hk]
    rw [this]

lemma sq_flag_true (sm row : ℕ) :
    ((if isSqB sm then decide (row = 38) else !decide (row = 38)) = true) ↔
      (IsSquare sm ↔ row = 38) := by
  cases hsq : isSqB sm
  · have hns : ¬ IsSquare sm := by
      rw [← isSqB_iff, hsq]; simp
    simp [hns]
  · have hs : IsSquare sm := (isSqB_iff _).mp hsq
    simp [hs]

lemma step_prime_finish (N k : ℕ) (ok : Bool) (row col sm : ℕ)
    (hrow : row ≤ N) (hk : Nat.Prime k) (heq : col + 1 = row)
    (hI : ScanInv N k (ok, row, col, sm)) :
    ScanInv N (k + 1)
      (ok && (if isSqB (sm + k) then decide (row = 38) else !decide (row = 38)),
        row + 1, 0, 0) := by
  rcases hI with ⟨h1, h2, h3, h4, h5, h6⟩
  have hcnt1 : Nat.count Nat.Prime (k + 1) = startIdx (row + 1) := by
    rw [Nat.count_succ, if_pos hk, h3 hrow, startIdx_succ, Nat.add_assoc,
      Nat.add_left_cancel_iff, heq]
  have hnth : Nat.nth Nat.Prime (startIdx row + col) = k := by
    rw [← h3 hrow, Nat.nth_count hk]
  have hA : sm + k = a row := by
    have hs : sm + k = rowPartial row (col + 1) := by
      rw [rowPartial_succ, h4 hrow, hnth]
    rw [a_eq, hs, heq]
  refine ⟨by omega, fun hle => by omega, ?_, ?_, ?_, ?_⟩
  · intro hle
    rw [hcnt1]
    rfl
  · intro _; simp [rowPartial]
  · intro hlt
    have : row = N := by omega
    subst this
    exact hcnt1.ge
  · unfold RowsOK at h6 ⊢
    have hflag := sq_flag_true (sm + k) row
    simp only [Bool.and_eq_true]
    constructor
    · intro ⟨hokt, hch⟩
      intro r hr1 hrlt hrN
      have hch' : (IsSquare (sm + k) ↔ row = 38) := hflag.mp (by
        simpa using hch)
      rw [hA] at hch'
      rcases lt_or_eq_of_le (Nat.le_of_lt_succ hrlt) with hrt | rfl
      · exact (h6.mp hokt) r hr1 hrt (le_trans (Nat.le_of_lt hrt) hrow)
      · exact hch'
    · intro hall
      constructor
      · apply h6.mpr
        intro r hr1 hrt hrN
        exact hall r hr1 (lt_trans hrt (Nat.lt_succ_self _)) hrN
      · apply hflag.mpr
        rw [hA]
        exact hall row h1 (Nat.lt_succ_self _) hrow

lemma step_preserves (N k : ℕ) (s : St) (hI : ScanInv N k s) :
    ScanInv N (k + 1) (step N k s) := by
  rcases s with ⟨ok, row, col, sm⟩
  unfold step
  by_cases hR : N < row
  · simp [hR]
    exact step_done N k ok row col sm hR hI
  · have hrow : row ≤ N := Nat.not_lt.mp hR
    simp [hR]
    by_cases hP : isPS k = true
    · have hk : Nat.Prime k := (isPS_iff k).mp hP
      simp [hP]
      by_cases hD : col + 1 = row
      · simp [hD]
        exact step_prime_finish N k ok row col sm hrow hk hD hI
      · simp [hD]
        exact step_prime_mid N k ok row col sm hrow hk hD hI
    · have hk : ¬ Nat.Prime k := by
        rw [← isPS_iff k]; exact hP
      simp [hP]
      exact step_composite N k ok row col sm hrow hk hI

lemma scanFuel_preserves (N fuel k : ℕ) (s : St) (hI : ScanInv N k s) :
    ScanInv N (k + fuel) (scanFuel N fuel k s) := by
  induction fuel generalizing k s with
  | zero =>
    simp only [scanFuel, Nat.add_zero]
    exact hI
  | succ f ih =>
    have h1 := step_preserves N k s hI
    change ScanInv N (k + (f + 1)) (scanFuel N f (k + 1) (step N k s))
    have eqk : k + (f + 1) = (k + 1) + f := by omega
    rw [eqk]
    exact ih (k + 1) (step N k s) h1

lemma count_prime_two : Nat.count Nat.Prime 2 = 0 := by decide

lemma startIdx_one : startIdx 1 = 0 := rfl

lemma scanInv_initial (N : ℕ) : ScanInv N 2 (true, 1, 0, 0) := by
  refine ⟨le_rfl, fun _ => Nat.zero_lt_one, ?_, ?_, ?_, rowsOK_initial N⟩
  · intro _
    rw [count_prime_two, startIdx_one]
  · intro _; simp [rowPartial]
  · intro hN
    have : N = 0 := by omega
    subst this
    rw [startIdx_one, count_prime_two]



