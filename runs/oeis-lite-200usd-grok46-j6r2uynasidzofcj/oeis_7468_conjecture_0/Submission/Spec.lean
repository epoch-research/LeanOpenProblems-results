lemma a_ge (n : ℕ) :
    n * (n * (n - 1) / 2 + 2) ≤ a n := by
  unfold a
  have hterm : ∀ i ∈ Finset.range n,
      n * (n - 1) / 2 + 2 ≤ Nat.nth Nat.Prime (n * (n - 1) / 2 + i) := by
    intro i hi
    have := Nat.add_two_le_nth_prime (n * (n - 1) / 2 + i)
    omega
  have hsum : ∑ _i ∈ Finset.range n, (n * (n - 1) / 2 + 2) =
      n * (n * (n - 1) / 2 + 2) := by
    simp [Finset.sum_const, Finset.card_range]
  rw [← hsum]
  exact Finset.sum_le_sum hterm

/--
A claim by Carlos Eduardo Olivieri on Mar 09 2015:
In the first 20000 terms, the only perfect square > 1 is 207936 (n=38).
Is it the only one?

Conjecture: The only positive integer $n$ such that $a(n)$ is a perfect square is $n=38$.
-/
theorem oeis_7468_conjecture_0 : ∀ n : ℕ, 0 < n → IsSquare (a n) → n = 38 := by
  intro n hn hsq
  by_cases hle : n ≤ 400
  · exact (rowsOK_400 n hn hle).mp hsq
  · have hnN : 401 ≤ n := by omega
    have hge := a_ge n
    obtain ⟨k, hk⟩ := hsq
    sorry
