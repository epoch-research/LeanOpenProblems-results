        ((143 : ℝ) / 1000) ^ 6 * (6 + 1) / (Nat.factorial 6 * 6)
      = (1 : ℝ) + (143 / 1000) + (143 / 1000) ^ 2 / 2 + (143 / 1000) ^ 3 / 6
        + (143 / 1000) ^ 4 / 24 + (143 / 1000) ^ 5 / 120
        + (143 / 1000) ^ 6 * 7 / (720 * 6) := by
    repeat rw [Finset.sum_range_succ]
    rw [Finset.sum_range_zero]
