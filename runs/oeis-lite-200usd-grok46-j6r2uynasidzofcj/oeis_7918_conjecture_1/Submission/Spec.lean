import FormalConjectures.Util.ProblemImports

/-! Monotonicity of `x^{x^{1/x}}` on `(1, ∞)`. Kept in a section that does
not `open Nat`, because `Nat.log` otherwise poisons real-analysis instances. -/
section BoundMono
open Real Set

lemma two_mul_lt_exp {v : ℝ} (hv : 0 ≤ v) : 2 * v < exp v := by
  have hquad : 1 + v + v ^ 2 / 2 ≤ exp v := quadratic_le_exp_of_nonneg hv
  have hstrict : 2 * v < 1 + v + v ^ 2 / 2 := by
    nlinarith [sq_nonneg (v - 1)]
  exact hstrict.trans_le hquad

lemma log_lt_half {u : ℝ} (hu : 1 < u) : log u < u / 2 := by
  have hu0 : 0 < u := lt_trans (by norm_num) hu
  have : 2 * (u / 2) < exp (u / 2) := two_mul_lt_exp (by positivity)
  have : u < exp (u / 2) := by linarith
  exact (log_lt_iff_lt_exp hu0).2 this

lemma log_lt_sqrt {x : ℝ} (hx : 1 < x) : log x < √x := by
  have hx0 : 0 < x := lt_trans (by norm_num) hx
  have hs : 1 < √x := (lt_sqrt (by norm_num)).2 (by nlinarith)
  have hlog : log x = 2 * log (√x) := by
    have h : log ((√x) ^ (2 : ℕ)) = (2 : ℝ) * log (√x) := by
      simp [log_pow]
    rwa [sq_sqrt hx0.le] at h
  have hhalf : log (√x) < √x / 2 := log_lt_half hs
  linarith

lemma log_sq_lt_self {x : ℝ} (hx : 1 < x) : (log x) ^ 2 < x := by
  have h := log_lt_sqrt hx
  have hl : 0 < log x := log_pos hx
  have : (log x) ^ 2 < (√x) ^ 2 := pow_lt_pow_left₀ h hl.le (by decide : (2 : ℕ) ≠ 0)
  rwa [sq_sqrt (lt_trans (by norm_num : (0 : ℝ) < 1) hx).le] at this

lemma log_sq_lt_add {x : ℝ} (hx : 1 < x) : (log x) ^ 2 < x + log x := by
  have : 0 < log x := log_pos hx
  linarith [log_sq_lt_self hx]

noncomputable def gBound (x : ℝ) : ℝ := exp (log x / x) * log x

lemma gBound_hasDerivAt {x : ℝ} (hx : 1 < x) :
    HasDerivAt gBound (exp (log x / x) * ((1 - log x) / x ^ 2 * log x + x⁻¹)) x := by
  have hx0 : 0 < x := lt_trans (by norm_num) hx
  have hlog : HasDerivAt log x⁻¹ x := hasDerivAt_log (ne_of_gt hx0)
  have hdiv : HasDerivAt (fun t => log t / t) ((1 - log x) / x ^ 2) x := by
    have h := hlog.div (hasDerivAt_id x) (ne_of_gt hx0)
    convert h using 1
    simp [id]
    field_simp
  have hexp : HasDerivAt (fun t => exp (log t / t))
      (exp (log x / x) * ((1 - log x) / x ^ 2)) x :=
    (hasDerivAt_exp _).comp x hdiv
  have hmul := hexp.mul hlog
  convert hmul using 1
  ring

lemma gBound_deriv_pos {x : ℝ} (hx : 1 < x) :
    0 < exp (log x / x) * ((1 - log x) / x ^ 2 * log x + x⁻¹) := by
  have hx0 : 0 < x := lt_trans (by norm_num) hx
  have : (1 - log x) / x ^ 2 * log x + x⁻¹
      = (log x - (log x) ^ 2 + x) / x ^ 2 := by
    field_simp
  rw [this]
  have hnum : 0 < log x - (log x) ^ 2 + x := by
    linarith [log_sq_lt_add hx]
  positivity

lemma continuousOn_gBound : ContinuousOn gBound (Ioi 1) := by
  intro x hx
  exact (gBound_hasDerivAt hx).continuousAt.continuousWithinAt

lemma strictMonoOn_gBound : StrictMonoOn gBound (Ioi 1) := by
  apply strictMonoOn_of_deriv_pos (convex_Ioi 1) continuousOn_gBound
  intro x hx
  have hx' : 1 < x := by
    rw [interior_Ioi] at hx
    exact hx
  rw [(gBound_hasDerivAt hx').deriv]
  exact gBound_deriv_pos hx'

lemma gBound_eq_log_bound {x : ℝ} (hx : 1 < x) :
    gBound x = log (x ^ (x ^ ((1 : ℝ) / x))) := by
  have hx0 : 0 < x := lt_trans (by norm_num) hx
  unfold gBound
  rw [log_rpow hx0]
  have : x ^ ((1 : ℝ) / x) = exp (log x / x) := by
    rw [rpow_def_of_pos hx0]
    simp [div_eq_mul_inv]
  rw [this]

lemma strictMonoOn_bound :
    StrictMonoOn (fun x : ℝ => x ^ (x ^ ((1 : ℝ) / x))) (Ioi 1) := by
  intro x hx y hy hxy
  have hx0 : 0 < x := lt_trans (by norm_num : (0 : ℝ) < 1) hx
  have hy0 : 0 < y := lt_trans (by norm_num : (0 : ℝ) < 1) hy
  have hposx : 0 < x ^ (x ^ ((1 : ℝ) / x)) := rpow_pos_of_pos hx0 _
  have hposy : 0 < y ^ (y ^ ((1 : ℝ) / y)) := rpow_pos_of_pos hy0 _
  rw [← log_lt_log_iff hposx hposy, ← gBound_eq_log_bound hx, ← gBound_eq_log_bound hy]
  exact strictMonoOn_gBound hx hy hxy

/-- The key expansion: `x^{x^{1/x}} > x + (log x)^2`. -/
lemma bound_gt_add_log_sq {x : ℝ} (hx : 1 < x) :
    x + (log x) ^ 2 < x ^ (x ^ ((1 : ℝ) / x)) := by
  have hx0 : 0 < x := lt_trans (by norm_num) hx
  have hlog : 0 < log x := log_pos hx
  have hu : 0 < log x / x := div_pos hlog hx0
  have hexp_form : x ^ ((1 : ℝ) / x) = exp (log x / x) := by
    rw [rpow_def_of_pos hx0, one_div, div_eq_mul_inv]
  have h1 : log x / x + 1 < x ^ ((1 : ℝ) / x) := by
    rw [hexp_form]
    exact add_one_lt_exp hu.ne'
  have h2 : log x + (log x) ^ 2 / x < (x ^ ((1 : ℝ) / x)) * log x := by
    have := (mul_lt_mul_iff_of_pos_right hlog).2 h1
    convert this using 1
    ring
  have h3 :
      exp (log x + (log x) ^ 2 / x) < exp ((x ^ ((1 : ℝ) / x)) * log x) :=
    exp_lt_exp.2 h2
  have h3L : exp (log x + (log x) ^ 2 / x) = x * exp ((log x) ^ 2 / x) := by
    rw [exp_add, exp_log hx0]
  have h3R : exp ((x ^ ((1 : ℝ) / x)) * log x) = x ^ (x ^ ((1 : ℝ) / x)) := by
    rw [hexp_form, mul_comm, rpow_def_of_pos hx0, div_eq_mul_inv]
  have hv : 0 < (log x) ^ 2 / x := div_pos (sq_pos_of_pos hlog) hx0
  have h4 : x + (log x) ^ 2 < x * exp ((log x) ^ 2 / x) := by
    have h := add_one_lt_exp hv.ne'
    have := (mul_lt_mul_iff_of_pos_left hx0).2 h
    calc
      x + (log x) ^ 2 = x * ((log x) ^ 2 / x + 1) := by field_simp; ring
      _ < x * exp ((log x) ^ 2 / x) := this
  calc
    x + (log x) ^ 2 < x * exp ((log x) ^ 2 / x) := h4
    _ = exp (log x + (log x) ^ 2 / x) := h3L.symm
    _ < exp ((x ^ ((1 : ℝ) / x)) * log x) := h3
    _ = x ^ (x ^ ((1 : ℝ) / x)) := h3R

lemma exp_two_lt_eight : exp 2 < 8 := by
  have h : exp 1 < 2.7182818286 := exp_one_lt_d9
  have hpos : 0 < exp 1 := exp_pos _
  have h2 : exp 2 = exp 1 * exp 1 := by
    rw [← exp_add]; norm_num
  rw [h2]
  have hmul : exp 1 * exp 1 < 2.7182818286 * 2.7182818286 :=
    mul_lt_mul h (le_of_lt h) hpos (by norm_num)
  have : (2.7182818286 : ℝ) * 2.7182818286 < 8 := by norm_num
  linarith

lemma exp_three_lt_twentyone : exp 3 < 21 := by
  have h : exp 1 < 2.7182818286 := exp_one_lt_d9
  have hpos : 0 < exp 1 := exp_pos _
  have he2 : exp 1 * exp 1 < 2.7182818286 * 2.7182818286 :=
    mul_lt_mul h (le_of_lt h) hpos (by norm_num)
  have h3 : exp 3 = (exp 1 * exp 1) * exp 1 := by
    rw [← exp_add, ← exp_add]; norm_num
  rw [h3]
  have : (exp 1 * exp 1) * exp 1 <
      (2.7182818286 * 2.7182818286) * 2.7182818286 :=
    mul_lt_mul he2 (le_of_lt h) hpos (by positivity)
  have : (2.7182818286 : ℝ) * 2.7182818286 * 2.7182818286 < 21 := by norm_num
  linarith

lemma exp_four_lt_fiftyfive : exp 4 < 55 := by
  have h : exp 1 < 2.7182818286 := exp_one_lt_d9
  have hpos : 0 < exp 1 := exp_pos _
  have he2 : exp 1 * exp 1 < 2.7182818286 * 2.7182818286 :=
    mul_lt_mul h (le_of_lt h) hpos (by norm_num)
  have h4 : exp 4 = (exp 1 * exp 1) * (exp 1 * exp 1) := by
    calc
      exp 4 = exp (2 + 2) := by norm_num
      _ = exp 2 * exp 2 := exp_add 2 2
      _ = (exp 1 * exp 1) * (exp 1 * exp 1) := by
        have : exp 2 = exp 1 * exp 1 := by rw [← exp_add]; norm_num
        rw [this]
  rw [h4]
  have : (exp 1 * exp 1) * (exp 1 * exp 1) <
      (2.7182818286 * 2.7182818286) * (2.7182818286 * 2.7182818286) :=
    mul_lt_mul he2 (le_of_lt he2) (by positivity) (by positivity)
  have : (2.7182818286 : ℝ) * 2.7182818286 * (2.7182818286 * 2.7182818286) < 55 :=
    by norm_num
  linarith

lemma exp_six_lt_fivehundredtwelve : exp 6 < 512 := by
  have h2 : exp 2 < 8 := exp_two_lt_eight
  have h6 : exp 6 = exp 2 * exp 2 * exp 2 := by
    calc
      exp 6 = exp (2 + 2 + 2) := by norm_num
      _ = exp (2 + 2) * exp 2 := exp_add (2 + 2) 2
      _ = (exp 2 * exp 2) * exp 2 := by rw [exp_add]
  rw [h6]
  have hpos : 0 < exp 2 := exp_pos _
  have he4 : exp 2 * exp 2 < 8 * 8 :=
    mul_lt_mul h2 (le_of_lt h2) hpos (by norm_num)
  have : (exp 2 * exp 2) * exp 2 < (8 * 8) * 8 :=
    mul_lt_mul he4 (le_of_lt h2) hpos (by norm_num)
  have : (8 : ℝ) * 8 * 8 = 512 := by norm_num
  linarith

lemma exp_eight_lt_4096 : exp 8 < 4096 := by
  have h2 : exp 2 < 8 := exp_two_lt_eight
  have h8 : exp 8 = (exp 2 * exp 2) * (exp 2 * exp 2) := by
    calc
      exp 8 = exp (4 + 4) := by norm_num
      _ = exp 4 * exp 4 := exp_add 4 4
      _ = (exp 2 * exp 2) * (exp 2 * exp 2) := by
        have : exp 4 = exp 2 * exp 2 := by
          calc
            exp 4 = exp (2 + 2) := by norm_num
            _ = exp 2 * exp 2 := exp_add 2 2
        rw [this]
  rw [h8]
  have hpos : 0 < exp 2 := exp_pos _
  have he4 : exp 2 * exp 2 < 8 * 8 :=
    mul_lt_mul h2 (le_of_lt h2) hpos (by norm_num)
  have : (exp 2 * exp 2) * (exp 2 * exp 2) < (8 * 8) * (8 * 8) :=
    mul_lt_mul he4 (le_of_lt he4) (by positivity) (by positivity)
  have : (8 : ℝ) * 8 * (8 * 8) = 4096 := by norm_num
  linarith

