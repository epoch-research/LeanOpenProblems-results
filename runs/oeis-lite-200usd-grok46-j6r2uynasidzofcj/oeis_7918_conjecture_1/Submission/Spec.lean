/-- Rational sandwich: if `a/b < n^{1/n}` and `p < n^{a/b}` then
`p < n^{n^{1/n}}`. -/
lemma rpow_lt_of_rat_bounds
    {n p a b : ℕ} (hn : 1 < n) (hp : 0 < p) (ha : 0 < a) (hb : 0 < b)
    (h_exp : a ^ n < n * b ^ n) (h_val : p ^ b < n ^ a) :
    (p : ℝ) < (n : ℝ) ^ ((n : ℝ) ^ ((1 : ℝ) / n)) := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast Nat.zero_lt_of_lt hn
  have hn1 : (1 : ℝ) < n := by exact_mod_cast hn
  have hb0 : (0 : ℝ) < b := by exact_mod_cast hb
  have ha0 : (0 : ℝ) < a := by exact_mod_cast ha
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp
  have hbN : (0 : ℝ) < (b : ℝ) ^ n := pow_pos hb0 _
  have habn : ((a : ℝ) / b) ^ n < (n : ℝ) := by
    have h1 : (a : ℝ) ^ n < (n : ℝ) * (b : ℝ) ^ n := by exact_mod_cast h_exp
    rw [div_pow]
    exact (div_lt_iff₀ hbN).2 (by linarith)
  have hfrac : (a : ℝ) / b < (n : ℝ) ^ ((1 : ℝ) / n) := by
    have hnonneg : (0 : ℝ) ≤ a / b := div_nonneg ha0.le hb0.le
    have hnonneg' : (0 : ℝ) ≤ (n : ℝ) ^ ((1 : ℝ) / n) :=
      Real.rpow_nonneg hn0.le _
    have : ((a : ℝ) / b) ^ (n : ℝ) < ((n : ℝ) ^ ((1 : ℝ) / n)) ^ (n : ℝ) := by
      have lhs : ((a : ℝ) / b) ^ (n : ℝ) = ((a : ℝ) / b) ^ n := Real.rpow_natCast _ _
      have rhs : ((n : ℝ) ^ ((1 : ℝ) / n)) ^ (n : ℝ) = n := by
        rw [← Real.rpow_mul hn0.le]
        rw [one_div_mul_cancel (ne_of_gt hn0)]
        exact Real.rpow_one _
      rw [lhs, rhs]
      exact habn
    exact (Real.rpow_lt_rpow_iff hnonneg hnonneg' hn0).1 this
  have hpow : (p : ℝ) < (n : ℝ) ^ ((a : ℝ) / b) := by
    have hpN : (0 : ℝ) ≤ p := hp0.le
    have hnab : (0 : ℝ) ≤ (n : ℝ) ^ ((a : ℝ) / b) := Real.rpow_nonneg hn0.le _
    have : (p : ℝ) ^ (b : ℝ) < ((n : ℝ) ^ ((a : ℝ) / b)) ^ (b : ℝ) := by
      have lhs : (p : ℝ) ^ (b : ℝ) = (p : ℝ) ^ b := Real.rpow_natCast _ _
      have rhs : ((n : ℝ) ^ ((a : ℝ) / b)) ^ (b : ℝ) = (n : ℝ) ^ a := by
        rw [← Real.rpow_mul hn0.le]
        rw [div_mul_cancel₀ _ (ne_of_gt hb0)]
        exact Real.rpow_natCast _ _
      rw [lhs, rhs]
      exact_mod_cast h_val
    exact (Real.rpow_lt_rpow_iff hpN hnab hb0).1 this
  have hchain : (n : ℝ) ^ ((a : ℝ) / b) < (n : ℝ) ^ ((n : ℝ) ^ ((1 : ℝ) / n)) :=
    (Real.rpow_lt_rpow_left_iff hn1).2 hfrac
  exact hpow.trans hchain

lemma composite_case {n p aa b : ℕ}
    (hn : 1 < n) (hp : p.Prime) (hnp : n ≤ p)
    (hmin : ∀ m < p, ¬ (m.Prime ∧ n ≤ m))
    (ha : 0 < aa) (hb : 0 < b)
    (h_exp : aa ^ n < n * b ^ n) (h_val : p ^ b < n ^ aa) :
    (a n : ℝ) < (n : ℝ) ^ ((n : ℝ) ^ (1 / (n : ℝ))) := by
  have : a n = p := a_eq_of_next n p hp hnp hmin
  rw [this]
  exact rpow_lt_of_rat_bounds hn hp.pos ha hb h_exp h_val

lemma gap_le_four_of_lt_twentyone {n : ℕ} (h8 : 8 ≤ n) (h21 : n < 21) :
    a n ≤ n + 4 := by
  interval_cases n
  · rw [a_eq_of_next 8 11 (by decide) (by decide) (by decide)]; decide
  · rw [a_eq_of_next 9 11 (by decide) (by decide) (by decide)]; decide
  · rw [a_eq_of_next 10 11 (by decide) (by decide) (by decide)]; decide
  · rw [a_eq_self_of_prime (by decide)]; decide
  · rw [a_eq_of_next 12 13 (by decide) (by decide) (by decide)]; decide
