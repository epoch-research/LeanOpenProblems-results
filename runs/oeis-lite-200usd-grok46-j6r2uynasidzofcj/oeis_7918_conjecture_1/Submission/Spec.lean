lemma conjecture_gap_le_four {n : ℕ} (hn : 8 ≤ n) (hgap : a n ≤ n + 4) :
    (a n : ℝ) < (n : ℝ) ^ ((n : ℝ) ^ (1 / (n : ℝ))) := by
  have hn1 : 1 < n := lt_of_lt_of_le (by decide : 1 < 8) hn
