lemma conjecture_of_small_gap {n k : ℕ} (hn : 1 < n)
    (hgap : a n ≤ n + k)
    (hk : (k : ℝ) ≤ (Real.log n) ^ 2) :
    (a n : ℝ) < (n : ℝ) ^ ((n : ℝ) ^ (1 / (n : ℝ))) := by
  apply conjecture_of_gap_le_log_sq hn
  have : (a n : ℝ) ≤ (n : ℝ) + k := by exact_mod_cast hgap
  linarith

