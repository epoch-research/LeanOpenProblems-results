lemma exp_107_lt : exp (107 / 1000) < 1113 / 1000 := by
  have hx0 : (0 : ℝ) ≤ 107 / 1000 := by norm_num
  have hx1 : (107 : ℝ) / 1000 ≤ 1 := by norm_num
  have h := exp_bound' (x := (107 : ℝ) / 1000) hx0 hx1 (n := 6) (by decide)
  have hexp :
      (∑ m ∈ Finset.range 6, ((107 : ℝ) / 1000) ^ m / m.factorial) +
        ((107 : ℝ) / 1000) ^ 6 * (6 + 1) / (Nat.factorial 6 * 6)
      = (1 : ℝ) + (107 / 1000) + (107 / 1000) ^ 2 / 2 + (107 / 1000) ^ 3 / 6
        + (107 / 1000) ^ 4 / 24 + (107 / 1000) ^ 5 / 120
        + (107 / 1000) ^ 6 * 7 / (720 * 6) := by
    repeat rw [Finset.sum_range_succ]
    rw [Finset.sum_range_zero]
    simp [Nat.factorial]
    ring
  have hnum :
      (1 : ℝ) + (107 / 1000) + (107 / 1000) ^ 2 / 2 + (107 / 1000) ^ 3 / 6
        + (107 / 1000) ^ 4 / 24 + (107 / 1000) ^ 5 / 120
        + (107 / 1000) ^ 6 * 7 / (720 * 6)
      < 1113 / 1000 := by norm_num
  calc
    exp (107 / 1000)
        ≤ (∑ m ∈ Finset.range 6, ((107 : ℝ) / 1000) ^ m / m.factorial) +
            ((107 : ℝ) / 1000) ^ 6 * (6 + 1) / (Nat.factorial 6 * 6) := h
    _ = (1 : ℝ) + (107 / 1000) + (107 / 1000) ^ 2 / 2 + (107 / 1000) ^ 3 / 6
        + (107 / 1000) ^ 4 / 24 + (107 / 1000) ^ 5 / 120
        + (107 / 1000) ^ 6 * 7 / (720 * 6) := hexp
    _ < 1113 / 1000 := hnum

