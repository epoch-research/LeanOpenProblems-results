open Nat Real

/--
A007918: Least prime $\ge n$ (version 1 of the "next prime" function).
-/
noncomputable def a (n : ℕ) : ℕ :=
  @Nat.find (fun p => Nat.Prime p ∧ n ≤ p) (by infer_instance) (by
    rcases Nat.exists_infinite_primes n with ⟨p, h_le, h_prime⟩
    exact ⟨p, h_prime, h_le⟩
  )

lemma a_eq_self_of_prime {n : ℕ} (hp : n.Prime) : a n = n := by
  refine (Nat.find_eq_iff _).2 ⟨⟨hp, le_rfl⟩, ?_⟩
  intro m hm ⟨_, hnm⟩
  omega

lemma a_eq_iff (n p : ℕ) :
    a n = p ↔ (p.Prime ∧ n ≤ p) ∧ ∀ m < p, ¬ (m.Prime ∧ n ≤ m) :=
  Nat.find_eq_iff _

lemma a_eq_of_next (n p : ℕ) (hp : p.Prime) (hn : n ≤ p)
    (hmin : ∀ m < p, ¬ (m.Prime ∧ n ≤ m)) : a n = p :=
  (a_eq_iff n p).2 ⟨⟨hp, hn⟩, hmin⟩

lemma a_pos (n : ℕ) : 0 < a n :=
  (Nat.find_spec (p := fun p => Nat.Prime p ∧ n ≤ p)
    (H := by
      rcases Nat.exists_infinite_primes n with ⟨p, h_le, h_prime⟩
      exact ⟨p, h_prime, h_le⟩)).1.pos

lemma a_prime (n : ℕ) : (a n).Prime :=
  (Nat.find_spec (p := fun p => Nat.Prime p ∧ n ≤ p)
    (H := by
      rcases Nat.exists_infinite_primes n with ⟨p, h_le, h_prime⟩
      exact ⟨p, h_prime, h_le⟩)).1

lemma a_ge (n : ℕ) : n ≤ a n :=
  (Nat.find_spec (p := fun p => Nat.Prime p ∧ n ≤ p)
    (H := by
      rcases Nat.exists_infinite_primes n with ⟨p, h_le, h_prime⟩
      exact ⟨p, h_prime, h_le⟩)).2

lemma a_min {n m : ℕ} (hp : m.Prime) (hm : n ≤ m) : a n ≤ m :=
  Nat.find_min' _ ⟨hp, hm⟩

lemma a_succ_eq_of_not_prime {n : ℕ} (hn : ¬ n.Prime) :
    a n = a (n + 1) := by
  refine le_antisymm ?_ ?_
  · exact a_min (a_prime (n + 1)) (Nat.le_of_succ_le (a_ge (n + 1)))
  · have : n ≠ a n := fun h => hn (h ▸ a_prime n)
    exact a_min (a_prime n) (by have := a_ge n; omega)

lemma one_lt_rpow_n_one_div {n : ℕ} (hn : 1 < n) :
    (1 : ℝ) < (n : ℝ) ^ ((1 : ℝ) / n) := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast Nat.zero_lt_of_lt hn
  have hn1 : (1 : ℝ) < n := by exact_mod_cast hn
  have hnonneg : (0 : ℝ) ≤ 1 := by norm_num
  have hnonneg' : (0 : ℝ) ≤ (n : ℝ) ^ ((1 : ℝ) / n) := Real.rpow_nonneg hn0.le _
  have : (1 : ℝ) ^ (n : ℝ) < ((n : ℝ) ^ ((1 : ℝ) / n)) ^ (n : ℝ) := by
    have lhs : (1 : ℝ) ^ (n : ℝ) = 1 := by simp
    have rhs : ((n : ℝ) ^ ((1 : ℝ) / n)) ^ (n : ℝ) = n := by
      rw [← Real.rpow_mul hn0.le, one_div_mul_cancel (ne_of_gt hn0), Real.rpow_one]
    rw [lhs, rhs]
    exact hn1
  exact (Real.rpow_lt_rpow_iff hnonneg hnonneg' hn0).1 this

lemma lt_bound_of_prime {n : ℕ} (hn : 1 < n) (hp : n.Prime) :
    (a n : ℝ) < (n : ℝ) ^ ((n : ℝ) ^ (1 / (n : ℝ))) := by
  rw [a_eq_self_of_prime hp]
  have hn1 : (1 : ℝ) < n := by exact_mod_cast hn
  have hexp : (1 : ℝ) < (n : ℝ) ^ ((1 : ℝ) / n) := one_lt_rpow_n_one_div hn
  calc
    (n : ℝ) = (n : ℝ) ^ (1 : ℝ) := (Real.rpow_one _).symm
    _ < (n : ℝ) ^ ((n : ℝ) ^ ((1 : ℝ) / n)) :=
      (Real.rpow_lt_rpow_left_iff hn1).2 hexp

/-- If the prime gap from `n` is at most `(log n)^2`, the conjecture holds. -/
lemma conjecture_of_gap_le_log_sq {n : ℕ} (hn : 1 < n)
    (hgap : (a n : ℝ) ≤ (n : ℝ) + (Real.log n) ^ 2) :
    (a n : ℝ) < (n : ℝ) ^ ((n : ℝ) ^ (1 / (n : ℝ))) :=
  hgap.trans_lt (bound_gt_add_log_sq (by exact_mod_cast hn))

lemma log_n_ge_two {n : ℕ} (hn : 8 ≤ n) : (2 : ℝ) ≤ Real.log n := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (Nat.zero_lt_of_lt (lt_of_lt_of_le (by decide : 0 < 8) hn))
  have : exp 2 ≤ (n : ℝ) := by
    have : (8 : ℝ) ≤ n := by exact_mod_cast hn
    linarith [exp_two_lt_eight]
  exact (le_log_iff_exp_le hn0).2 this

