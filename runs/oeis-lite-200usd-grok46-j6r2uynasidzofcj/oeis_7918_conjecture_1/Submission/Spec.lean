/- Fuel-style trial division and leftover coverings. -/

def notDivN : ℕ → ℕ → Bool
  | 0, _ => true
  | k + 1, n => (decide (k + 1 < 2) || (n % (k + 1) != 0)) && notDivN k n

lemma notDivN_spec {k n : ℕ} :
    notDivN k n = true ↔ ∀ d, 2 ≤ d → d ≤ k → ¬ d ∣ n := by
  induction k with
  | zero =>
    simp [notDivN]; intro d h2 hle; omega
  | succ k ih =>
    simp only [notDivN, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq]
    constructor
    · intro ⟨hstep, hrest⟩ d hd2 hdk
      rw [Nat.le_succ_iff] at hdk
      rcases hdk with hdk | rfl
      · exact (ih.mp hrest) d hd2 hdk
      · intro hdvd
        rcases hstep with hlt | hmod
        · omega
        · exact hmod (Nat.mod_eq_zero_of_dvd hdvd)
    · intro h
      constructor
      · by_cases hlt : k + 1 < 2
        · exact Or.inl hlt
        · right
          intro hz
          have : 2 ≤ k + 1 := Nat.le_of_not_lt hlt
          exact h (k + 1) this le_rfl (Nat.dvd_of_mod_eq_zero hz)
      · exact ih.mpr fun d hd2 hdk => h d hd2 (le_trans hdk (Nat.le_succ _))

lemma prime_of_notDiv1823 {n : ℕ} (h2 : 2 ≤ n) (hn : n ≤ 1823 * 1823)
    (h : notDivN 1823 n = true) : n.Prime := by
  rw [Nat.prime_def_le_sqrt]
  refine ⟨h2, fun m hm2 hms hmd => ?_⟩
  have : m ≤ 1823 := by
    have := Nat.sqrt_le_sqrt hn
    have : (1823 * 1823).sqrt = 1823 := Nat.sqrt_eq 1823
    omega
  exact (notDivN_spec (k := 1823)).mp h m hm2 this hmd

def ConsecutiveGaps (k : ℕ) : List {p : ℕ // p.Prime} → Prop
  | [] => True
  | [_] => True
  | p :: q :: ps => p.val < q.val ∧ q.val ≤ p.val + k ∧ ConsecutiveGaps k (q :: ps)

def checkGaps (k : ℕ) : List ℕ → Bool
  | [] => true
  | [_] => true
  | p :: q :: ps => decide (p < q ∧ q ≤ p + k) && checkGaps k (q :: ps)

lemma consecutiveGaps_of_check {k : ℕ} :
    ∀ (ps : List {p : ℕ // p.Prime}),
      checkGaps k (ps.map Subtype.val) = true → ConsecutiveGaps k ps := by
  intro ps
  induction ps with
  | nil => intro; trivial
  | cons p ps ih =>
    cases ps with
    | nil => intro; trivial
    | cons q qs =>
      intro h
      simp only [checkGaps, List.map, Bool.and_eq_true, decide_eq_true_eq] at h
      exact ⟨h.1.1, h.1.2, ih h.2⟩

lemma consecutiveGaps_cons {k : ℕ} {p q : {p : ℕ // p.Prime}}
    {ps : List {p : ℕ // p.Prime}}
    (h : ConsecutiveGaps k (p :: q :: ps)) :
    p.val < q.val ∧ q.val ≤ p.val + k ∧ ConsecutiveGaps k (q :: ps) :=
  h

lemma a_le_add_from (k : ℕ) (p : {p : ℕ // p.Prime}) :
    ∀ (rest : List {p : ℕ // p.Prime}),
      ConsecutiveGaps k (p :: rest) →
      ∀ n, p.val ≤ n → (hrest : rest ≠ []) →
        n < (rest.getLast hrest).val → a n ≤ n + k := by
  intro rest
  induction rest generalizing p with
  | nil =>
    intro _ n _ hrest
    exact (hrest rfl).elim
  | cons q qs ih =>
    intro hgaps n hn_lo hrest hn_hi
    obtain ⟨hpq, hqgap, hrestg⟩ :=
      consecutiveGaps_cons (k := k) (p := p) (q := q) (ps := qs) hgaps
    by_cases hnq : n < q.val
    · exact a_le_of_prime_window q.property hnq (by omega)
    · cases qs with
      | nil =>
        simp at hn_hi
        omega
      | cons r rs =>
        refine ih q hrestg n (Nat.le_of_not_lt hnq) (List.cons_ne_nil _ _) ?_
        simpa [List.getLast_cons_cons] using hn_hi

lemma a_le_add_of_cert (k : ℕ) (p : {p : ℕ // p.Prime})
    (rest : List {p : ℕ // p.Prime})
    (hgaps : ConsecutiveGaps k (p :: rest))
    (hrest : rest ≠ [])
    (n : ℕ) (hlo : p.val ≤ n) (hhi : n < (rest.getLast hrest).val) :
    a n ≤ n + k :=
  a_le_add_from k p rest hgaps n hlo hrest hhi

