lemma represents_of_is5Form {n : ℕ} (h : Is5Form n) : Represents 3 (sunC 3) n := by
  obtain ⟨u, v, x, y, z, hn⟩ := h
  refine ⟨fun i => match i.val with | 0 => u | 1 => v | 2 => x | 3 => y | _ => z, ?_⟩
  rw [Fin.sum_univ_five]
  have c0 : sunC 3 0 = 1 := by decide
  have c1 : sunC 3 1 = 1 := by decide
  have c2 : sunC 3 2 = 2 := by decide
  have c3 : sunC 3 3 = 2 := by decide
  have c4 : sunC 3 4 = 3 := by decide
  rw [c0, c1, c2, c3, c4]
  simp only [Fin.val_zero, Fin.val_one]
  have h2 : (⟨2, by decide⟩ : Fin 5).val = 2 := rfl
  have h3 : (⟨3, by decide⟩ : Fin 5).val = 3 := rfl
  have h4 : (⟨4, by decide⟩ : Fin 5).val = 4 := rfl
  simp [h2, h3, h4, hn]

lemma is5Form_of_is4Form_succ {n : ℕ} (h : Is4Form n) : Is5Form (n + 1) := by
  obtain ⟨v, x, y, z, hz⟩ := h
  exact ⟨1, v, x, y, z, by rw [hz]; ring⟩

lemma is5Form_of_is4Form_or_pred {n : ℕ}
    (h : Is4Form n ∨ (0 < n ∧ Is4Form (n - 1))) : Is5Form n := by
  rcases h with h | ⟨_, h⟩
  · exact is5Form_of_is4Form h
  · have : n = (n - 1) + 1 := by omega
    rw [this]
    exact is5Form_of_is4Form_succ h

lemma part_iii_of {k : ℕ} {c : Fin (2 * k - 1) → ℕ}
    (hpos : ∀ i, c i > 0) (hsum : ∑ i, c i = waring_g k)
    (hall : ∀ n, Represents k c n) :
    ∃ c : Fin (2 * k - 1) → ℕ,
      (∀ i, c i > 0) ∧
      (Set.range (fun x : Fin (2 * k - 1) → ℕ =>
        ∑ i, c i * (x i) ^ k) = Set.univ) ∧
      (∑ i, c i = waring_g k) :=
  ⟨c, hpos, (represents_all_iff_range c).mp hall, hsum⟩

/-- A single ordered witness in range implies `count5 n ≥ 1`. -/
lemma count5_pos_of_wit {n u v x y z : ℕ}
    (hle : u ≤ v ∧ x ≤ y)
    (heq : u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n)
    (hu : u ≤ Nat.nthRoot 3 n) (hv : v ≤ Nat.nthRoot 3 n)
    (hx : x ≤ Nat.nthRoot 3 n) (hy : y ≤ Nat.nthRoot 3 n)
    (hz : z ≤ Nat.nthRoot 3 n) :
    1 ≤ count5 n := by
  unfold count5
  set B := Nat.nthRoot 3 n + 1
  have hmem : ∀ t, t ≤ Nat.nthRoot 3 n → t ∈ range B := by
    intro t ht; exact Finset.mem_range.mpr (Nat.lt_succ_of_le ht)
  have hterm :
      (if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n
        then (1 : ℕ) else 0) = 1 := by
    simp [hle, heq]
  have hz_sum :
      1 ≤ (range B).sum fun z' =>
        if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    have := Finset.single_le_sum
      (f := fun z' : ℕ =>
        if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) (hmem z hz)
    simpa [hterm] using this
  have hy_sum :
      1 ≤ (range B).sum fun y' => (range B).sum fun z' =>
        if u ≤ v ∧ x ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine le_trans hz_sum ?_
    have := Finset.single_le_sum
      (f := fun y' : ℕ => (range B).sum fun z' =>
        if u ≤ v ∧ x ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) (hmem y hy)
    simpa using this
  have hx_sum :
      1 ≤ (range B).sum fun x' => (range B).sum fun y' => (range B).sum fun z' =>
        if u ≤ v ∧ x' ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine le_trans hy_sum ?_
    have := Finset.single_le_sum
      (f := fun x' : ℕ => (range B).sum fun y' => (range B).sum fun z' =>
        if u ≤ v ∧ x' ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) (hmem x hx)
    simpa using this
  have hv_sum :
      1 ≤ (range B).sum fun v' => (range B).sum fun x' => (range B).sum fun y' =>
        (range B).sum fun z' =>
        if u ≤ v' ∧ x' ≤ y' ∧ u ^ 3 + v' ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine le_trans hx_sum ?_
    have := Finset.single_le_sum
      (f := fun v' : ℕ => (range B).sum fun x' => (range B).sum fun y' =>
        (range B).sum fun z' =>
        if u ≤ v' ∧ x' ≤ y' ∧ u ^ 3 + v' ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) (hmem v hv)
    simpa using this
  refine le_trans hv_sum ?_
  have := Finset.single_le_sum
    (f := fun u' : ℕ => (range B).sum fun v' => (range B).sum fun x' =>
      (range B).sum fun y' => (range B).sum fun z' =>
      if u' ≤ v' ∧ x' ≤ y' ∧ u' ^ 3 + v' ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
      then (1 : ℕ) else 0)
    (fun _ _ => Nat.zero_le _) (hmem u hu)
  simpa using this

lemma is5Form_of_wit {n u v x y z : ℕ}
    (heq : n = u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3) :
    Is5Form n :=
  ⟨u, v, x, y, z, heq⟩

lemma part_iii_sunC_of {k : ℕ} (hk : 2 ≤ k) (hall : ∀ n, Represents k (sunC k) n) :
    ∃ c : Fin (2 * k - 1) → ℕ,
      (∀ i, c i > 0) ∧
      (Set.range (fun x : Fin (2 * k - 1) → ℕ =>
        ∑ i, c i * (x i) ^ k) = Set.univ) ∧
      (∑ i, c i = waring_g k) :=
  part_iii_of (sunC_pos hk) (sunC_sum_waring hk) hall

/-- Two distinct in-range ordered witnesses give `count5 n ≥ 2`. -/
lemma count5_ge_two_of_wits {n u₁ v₁ x₁ y₁ z₁ u₂ v₂ x₂ y₂ z₂ : ℕ}
    (hle₁ : u₁ ≤ v₁ ∧ x₁ ≤ y₁)
    (heq₁ : u₁ ^ 3 + v₁ ^ 3 + 2 * x₁ ^ 3 + 2 * y₁ ^ 3 + 3 * z₁ ^ 3 = n)
    (hle₂ : u₂ ≤ v₂ ∧ x₂ ≤ y₂)
    (heq₂ : u₂ ^ 3 + v₂ ^ 3 + 2 * x₂ ^ 3 + 2 * y₂ ^ 3 + 3 * z₂ ^ 3 = n)
    (hne : ¬ (u₁ = u₂ ∧ v₁ = v₂ ∧ x₁ = x₂ ∧ y₁ = y₂ ∧ z₁ = z₂))
    (hu₁ : u₁ ≤ Nat.nthRoot 3 n) (hv₁ : v₁ ≤ Nat.nthRoot 3 n)
    (hx₁ : x₁ ≤ Nat.nthRoot 3 n) (hy₁ : y₁ ≤ Nat.nthRoot 3 n)
    (hz₁ : z₁ ≤ Nat.nthRoot 3 n)
    (hu₂ : u₂ ≤ Nat.nthRoot 3 n) (hv₂ : v₂ ≤ Nat.nthRoot 3 n)
    (hx₂ : x₂ ≤ Nat.nthRoot 3 n) (hy₂ : y₂ ≤ Nat.nthRoot 3 n)
    (hz₂ : z₂ ≤ Nat.nthRoot 3 n) :
    2 ≤ count5 n := by
  unfold count5
  set B := Nat.nthRoot 3 n + 1
  have hmem : ∀ t, t ≤ Nat.nthRoot 3 n → t ∈ range B := by
    intro t ht; exact Finset.mem_range.mpr (Nat.lt_succ_of_le ht)
  let f : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ := fun u v x y z =>
    if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n then 1 else 0
  have hf1 : f u₁ v₁ x₁ y₁ z₁ = 1 := by simp [f, hle₁, heq₁]
  have hf2 : f u₂ v₂ x₂ y₂ z₂ = 1 := by simp [f, hle₂, heq₂]
  -- Fall back to two single_le_sum applications if the pairs are distinct.
  have hpos1 : 1 ≤ count5 n :=
    count5_pos_of_wit hle₁ heq₁ hu₁ hv₁ hx₁ hy₁ hz₁
  -- Directly add the two indicator terms.
  have :
      f u₁ v₁ x₁ y₁ z₁ + f u₂ v₂ x₂ y₂ z₂ ≤
        ∑ u ∈ range B, ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, f u v x y z := by
    have h1 := Finset.single_le_sum
      (f := fun u => ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, f u v x y z)
      (fun _ _ => Nat.zero_le _) (hmem u₁ hu₁)
    have s1 : f u₁ v₁ x₁ y₁ z₁ ≤
        ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, f u₁ v x y z := by
      refine le_trans ?_ (Finset.single_le_sum
        (f := fun v => ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, f u₁ v x y z)
        (fun _ _ => Nat.zero_le _) (hmem v₁ hv₁))
      refine le_trans ?_ (Finset.single_le_sum
        (f := fun x => ∑ y ∈ range B, ∑ z ∈ range B, f u₁ v₁ x y z)
        (fun _ _ => Nat.zero_le _) (hmem x₁ hx₁))
      refine le_trans ?_ (Finset.single_le_sum
        (f := fun y => ∑ z ∈ range B, f u₁ v₁ x₁ y z)
        (fun _ _ => Nat.zero_le _) (hmem y₁ hy₁))
      exact (Finset.single_le_sum (f := fun z => f u₁ v₁ x₁ y₁ z)
        (fun _ _ => Nat.zero_le _) (hmem z₁ hz₁)).trans_eq (by simp [hf1])
    -- If the two 5-tuples coincide we contradict `hne`.
    by_cases hsame : u₁ = u₂ ∧ v₁ = v₂ ∧ x₁ = x₂ ∧ y₁ = y₂ ∧ z₁ = z₂
    · exact False.elim (hne hsame)
    · -- Bound by twice a positive term via adding the second witness similarly.
      have h2 : 1 ≤ ∑ u ∈ range B, ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B,
          f u v x y z := by
        simpa [count5, B, f] using hpos1
      -- Use that both indicators appear as distinct summands: compare via filter.
      have := hpos1
      -- We'll prove 2 ≤ sum by noting the sum is at least the sum over a 2-element image.
      have hmem1 : u₁ ∈ range B ∧ v₁ ∈ range B ∧ x₁ ∈ range B ∧ y₁ ∈ range B ∧ z₁ ∈ range B :=
        ⟨hmem u₁ hu₁, hmem v₁ hv₁, hmem x₁ hx₁, hmem y₁ hy₁, hmem z₁ hz₁⟩
      have hmem2 : u₂ ∈ range B ∧ v₂ ∈ range B ∧ x₂ ∈ range B ∧ y₂ ∈ range B ∧ z₂ ∈ range B :=
        ⟨hmem u₂ hu₂, hmem v₂ hv₂, hmem x₂ hx₂, hmem y₂ hy₂, hmem z₂ hz₂⟩
      -- Expand as a sum of indicators over the product and use two-point subset.
      change f u₁ v₁ x₁ y₁ z₁ + f u₂ v₂ x₂ y₂ z₂ ≤
        ∑ u ∈ range B, ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, f u v x y z
      have hsum :
          ∑ u ∈ range B, ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, f u v x y z =
            ∑ p ∈ range B ×ˢ range B ×ˢ range B ×ˢ range B ×ˢ range B,
              f p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2 := by
        simp [Finset.sum_product]
      rw [hsum]
      let p1 := (u₁, v₁, x₁, y₁, z₁)
      let p2 := (u₂, v₂, x₂, y₂, z₂)
      have hp1 : p1 ∈ range B ×ˢ range B ×ˢ range B ×ˢ range B ×ˢ range B := by
        simp [p1, hmem1]
      have hp2 : p2 ∈ range B ×ˢ range B ×ˢ range B ×ˢ range B ×ˢ range B := by
        simp [p2, hmem2]
      have hpne : p1 ≠ p2 := by
        intro h; simp [p1, p2] at h; exact hsame h
      have hle : f p1.1 p1.2.1 p1.2.2.1 p1.2.2.2.1 p1.2.2.2.2 +
          f p2.1 p2.2.1 p2.2.2.1 p2.2.2.2.1 p2.2.2.2.2 ≤
          ∑ p ∈ ({p1, p2} : Finset _),
            f p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2 := by
        simp [Finset.sum_pair hpne]
      refine le_trans (le_of_eq ?_) (le_trans hle ?_)
      · simp [p1, p2]
      · exact Finset.sum_le_sum_of_subset_of_nonneg
          (by intro p hp; simp at hp; rcases hp with rfl | rfl <;> assumption)
          (fun _ _ _ => Nat.zero_le _)
  simpa [hf1, hf2, count5, B, f] using this

lemma nthRoot_three_of_le_cube {t n : ℕ} (h : t ^ 3 ≤ n) : t ≤ Nat.nthRoot 3 n :=
  cube_le_of_mem_repr h

lemma is4Form_implies_is5_zero {n : ℕ} (h : Is4Form n) :
    ∃ v x y z, v ≤ Nat.nthRoot 3 n ∧ x ≤ Nat.nthRoot 3 n ∧ y ≤ Nat.nthRoot 3 n ∧
      z ≤ Nat.nthRoot 3 n ∧ x ≤ y ∧ n = v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by
  obtain ⟨v0, x0, y0, z, hn⟩ := h
  let x := min x0 y0
  let y := max x0 y0
  have hxy : x ≤ y := min_le_max
  have hn' : n = v0 ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by
    simp [x, y]
    rcases le_total x0 y0 with h1 | h1 <;> simp [h1, hn] <;> ring
  refine ⟨v0, x, y, z, ?_, ?_, ?_, ?_, hxy, hn'⟩
  · exact cube_le_of_mem_repr (by rw [hn']; omega)
  · exact cube_le_of_mem_repr (by
      have : x ^ 3 ≤ 2 * x ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
      rw [hn']; omega)
  · exact cube_le_of_mem_repr (by
      have : y ^ 3 ≤ 2 * y ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
      rw [hn']; omega)
  · exact cube_le_of_mem_repr (by
      have : z ^ 3 ≤ 3 * z ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 3)
      rw [hn']; omega)

/-- If both `n` and `n-1` are 4-forms, witnessed by data that produce two distinct
ordered 5-tuples, then `count5 n ≥ 2`.  The degenerate case
`n = 1 + 2x³+2y³+3z³` with the 4-form of `n` equal to `1³+2x³+2y³+3z³`
is excluded by `hne`. -/
lemma count5_ge_two_of_is4_succ {n : ℕ} (hn : 1 ≤ n)
    (h0 : Is4Form n) (h1 : Is4Form (n - 1))
    (hnondeg : ¬ (∃ x y z : ℕ, n = 1 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 ∧
      n - 1 = 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 ∧
      n = 1 ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3)) :
    2 ≤ count5 n := by
  obtain ⟨v0, x0, y0, z0, hv0, hx0, hy0, hz0, hxy0, he0⟩ := is4Form_implies_is5_zero h0
  obtain ⟨v1, x1, y1, z1, hv1, hx1, hy1, hz1, hxy1, he1⟩ := is4Form_implies_is5_zero h1
  have he0' : 0 ^ 3 + v0 ^ 3 + 2 * x0 ^ 3 + 2 * y0 ^ 3 + 3 * z0 ^ 3 = n := by
    simpa using he0.symm
  have hn1 : n = (n - 1) + 1 := by omega
  have he1' : 1 ^ 3 + v1 ^ 3 + 2 * x1 ^ 3 + 2 * y1 ^ 3 + 3 * z1 ^ 3 = n := by
    have hcube : 1 ^ 3 = 1 := by decide
    calc
      1 ^ 3 + v1 ^ 3 + 2 * x1 ^ 3 + 2 * y1 ^ 3 + 3 * z1 ^ 3
        = 1 + (v1 ^ 3 + 2 * x1 ^ 3 + 2 * y1 ^ 3 + 3 * z1 ^ 3) := by
          rw [hcube]; ring
      _ = 1 + (n - 1) := by rw [he1]
      _ = n := by omega
  have hle0 : 0 ≤ v0 ∧ x0 ≤ y0 := ⟨Nat.zero_le _, hxy0⟩
  have h1le : 1 ≤ Nat.nthRoot 3 n := cube_le_of_mem_repr (by omega)
  by_cases hv1z : 1 ≤ v1
  · have hle1 : 1 ≤ v1 ∧ x1 ≤ y1 := ⟨hv1z, hxy1⟩
    have hne : ¬ (0 = 1 ∧ v0 = v1 ∧ x0 = x1 ∧ y0 = y1 ∧ z0 = z1) := by
      intro h; exact Nat.zero_ne_one h.1
    have hv1n : v1 ≤ Nat.nthRoot 3 n := by
      have : v1 ^ 3 ≤ n - 1 :=
        (Nat.pow_le_pow_left hv1 3).trans (nthRoot_three (n - 1)).1
      exact cube_le_of_mem_repr (by omega)
    refine count5_ge_two_of_wits hle0 he0' hle1 he1' hne
      (Nat.zero_le _) hv0 hx0 hy0 hz0 h1le hv1n ?_ ?_ ?_
    · exact cube_le_of_mem_repr (by
        have : x1 ^ 3 ≤ 2 * x1 ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
        omega)
    · exact cube_le_of_mem_repr (by
        have : y1 ^ 3 ≤ 2 * y1 ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
        omega)
    · exact cube_le_of_mem_repr (by
        have : z1 ^ 3 ≤ 3 * z1 ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 3)
        omega)
  · have hv1eq : v1 = 0 := by omega
    have he1s : 0 ^ 3 + 1 ^ 3 + 2 * x1 ^ 3 + 2 * y1 ^ 3 + 3 * z1 ^ 3 = n := by
      simpa [hv1eq] using he1'
    have hle1 : 0 ≤ 1 ∧ x1 ≤ y1 := ⟨Nat.zero_le _, hxy1⟩
    have hne : ¬ (0 = 0 ∧ v0 = 1 ∧ x0 = x1 ∧ y0 = y1 ∧ z0 = z1) := by
      intro h
      apply hnondeg
      refine ⟨x1, y1, z1, ?_, ?_, ?_⟩
      · have : 1 ^ 3 = 1 := by decide
        omega
      · simpa [hv1eq] using he1
      · simpa [hv1eq] using he1'.symm
    refine count5_ge_two_of_wits hle0 he0' hle1 he1s hne
      (Nat.zero_le _) hv0 hx0 hy0 hz0 (Nat.zero_le _) h1le ?_ ?_ ?_
    · exact cube_le_of_mem_repr (by
        have : x1 ^ 3 ≤ 2 * x1 ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
        omega)
    · exact cube_le_of_mem_repr (by
        have : y1 ^ 3 ≤ 2 * y1 ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
        omega)
    · exact cube_le_of_mem_repr (by
        have : z1 ^ 3 ≤ 3 * z1 ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 3)
        omega)

lemma is4Form_double {m : ℕ} (h : Is4Form m) : Is4Form (8 * m) := by
  obtain ⟨v, x, y, z, hz⟩ := h
  refine ⟨2 * v, 2 * x, 2 * y, 2 * z, ?_⟩
  calc 8 * m = 8 * (v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3) := by rw [hz]
    _ = (2 * v) ^ 3 + 2 * (2 * x) ^ 3 + 2 * (2 * y) ^ 3 + 3 * (2 * z) ^ 3 := by ring

lemma is5Form_double {m : ℕ} (h : Is5Form m) : Is5Form (8 * m) := by
  obtain ⟨u, v, x, y, z, hz⟩ := h
  refine ⟨2 * u, 2 * v, 2 * x, 2 * y, 2 * z, ?_⟩
  calc 8 * m = 8 * (u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3) := by rw [hz]
    _ = (2 * u) ^ 3 + (2 * v) ^ 3 + 2 * (2 * x) ^ 3 + 2 * (2 * y) ^ 3 + 3 * (2 * z) ^ 3 := by ring

lemma is5Form_of_sub_cube_is4 {n u : ℕ} (h : Is4Form (n - u ^ 3))
    (hle : u ^ 3 ≤ n) : Is5Form n := by
  obtain ⟨v, x, y, z, hz⟩ := h
  refine ⟨u, v, x, y, z, ?_⟩
  have := Nat.sub_add_cancel hle
  omega


