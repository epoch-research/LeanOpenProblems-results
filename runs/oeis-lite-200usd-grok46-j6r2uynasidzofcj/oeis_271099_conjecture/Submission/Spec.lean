import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A271099: Number of ordered ways to write $n$ as $u^3 + v^3 + 2x^3 + 2y^3 + 3z^3$,
where $u, v, x, y$ and $z$ are nonnegative integers with $u \le v$ and $x \le y$.
-/
def A271099 (n : ℕ) : ℕ :=
  let R := range (n + 1)

  -- Sum over all 5-tuples of natural numbers. We use a loose upper bound R for simplicity.
  Finset.sum R fun u =>
  Finset.sum R fun v =>
  Finset.sum R fun x =>
  Finset.sum R fun y =>
  Finset.sum R fun z =>
    if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n then
      1
    else
      0

open Real

/-- Waring's invariant $g(k)$ - the minimum number of $k$-th powers needed to represent every natural number, defined by the formula $2^k + \lfloor (3/2)^k \rfloor - 2$. -/
noncomputable def waring_g (k : ℕ) : ℕ :=
  if k < 2 then 0
  else
    let k_re : ℝ := k
    let three_half_pow_k_real : ℝ := (3 / 2) ^ k_re
    let floor_val : ℕ := Int.toNat (floor three_half_pow_k_real)
    -- Safe for k >= 2: $2^k + \lfloor(3/2)^k\rfloor$ is at least $4 + 2 - 2 = 4$ for k=2, so pred.pred is safe.
    (2 ^ k + floor_val).pred.pred

namespace A271099

/-! ### Auxiliary lemmas -/

lemma three_halves_pow (k : ℕ) :
    ((3 : ℝ) / 2) ^ k = (3 : ℝ) ^ k / (2 : ℝ) ^ k :=
  div_pow (3 : ℝ) (2 : ℝ) k

lemma nat_floor_three_halves (k : ℕ) :
    Nat.floor (((3 : ℝ) / 2) ^ k) = 3 ^ k / 2 ^ k := by
  have hpos : (0 : ℝ) ≤ ((3 : ℝ) / 2) ^ k := by positivity
  refine (Nat.floor_eq_iff hpos).2 ⟨?_, ?_⟩
  · rw [three_halves_pow]
    have h := Nat.cast_div_le (m := 3 ^ k) (n := 2 ^ k) (α := ℝ)
    rwa [Nat.cast_pow, Nat.cast_pow] at h
  · rw [three_halves_pow]
    have h2n : 0 < 2 ^ k := pow_pos (by decide : (0 : ℕ) < 2) k
    have hlt : 3 ^ k < (3 ^ k / 2 ^ k + 1) * 2 ^ k := by
      have := Nat.lt_div_mul_add (a := 3 ^ k) h2n
      rw [add_mul, one_mul]
      exact this
    have h2pos : (0 : ℝ) < (2 : ℝ) ^ k := by positivity
    rw [div_lt_iff₀ h2pos]
    refine lt_of_eq_of_lt (Nat.cast_pow (α := ℝ) 3 k).symm ?_
    refine lt_of_lt_of_eq (Nat.cast_lt.mpr hlt) ?_
    push_cast
    rfl

lemma floor_three_halves_rpow (k : ℕ) :
    Int.toNat (⌊((3 : ℝ) / 2) ^ (k : ℝ)⌋₊) = 3 ^ k / 2 ^ k := by
  have hrpow : ((3 : ℝ) / 2) ^ (k : ℝ) = ((3 : ℝ) / 2) ^ k := Real.rpow_natCast _ _
  rw [hrpow, nat_floor_three_halves, Int.toNat_natCast]

lemma waring_g_of_ge_two {k : ℕ} (hk : 2 ≤ k) :
    waring_g k = (2 ^ k + 3 ^ k / 2 ^ k).pred.pred := by
  unfold waring_g
  simp only [Nat.not_lt.mpr hk, ↓reduceIte]
  rw [floor_three_halves_rpow]

lemma pred_pred_eq_sub_two {n : ℕ} (h : 2 ≤ n) : n.pred.pred = n - 2 := by
  cases n with
  | zero => omega
  | succ n =>
    cases n with
    | zero => omega
    | succ m => simp

lemma waring_g_eq {k : ℕ} (hk : 2 ≤ k) :
    waring_g k = 2 ^ k + 3 ^ k / 2 ^ k - 2 := by
  have hpow : 4 ≤ 2 ^ k := Nat.pow_le_pow_right (by decide : (0 : ℕ) < 2) hk
  have h2 : 2 ≤ 2 ^ k + 3 ^ k / 2 ^ k :=
    le_trans (le_trans (by decide : (2 : ℕ) ≤ 4) hpow) (Nat.le_add_right _ _)
  rw [waring_g_of_ge_two hk, pred_pred_eq_sub_two h2]

lemma waring_g_three : waring_g 3 = 9 := by
  rw [waring_g_eq (by decide : (2 : ℕ) ≤ 3)]
  decide

lemma waring_g_four : waring_g 4 = 19 := by
  rw [waring_g_eq (by decide : (2 : ℕ) ≤ 4)]
  decide

lemma waring_g_five : waring_g 5 = 37 := by
  rw [waring_g_eq (by decide : (2 : ℕ) ≤ 5)]
  decide

/-- The unordered 5-variable cubic form. -/
def Is5Form (n : ℕ) : Prop :=
  ∃ u v x y z : ℕ, n = u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3

/-- The 4-variable form obtained by dropping one coefficient-1 variable. -/
def Is4Form (n : ℕ) : Prop :=
  ∃ v x y z : ℕ, n = v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3

lemma is5Form_of_is4Form {n : ℕ} (h : Is4Form n) : Is5Form n := by
  obtain ⟨v, x, y, z, hz⟩ := h
  exact ⟨0, v, x, y, z, by simpa using hz⟩

lemma is4Form_zero : Is4Form 0 := ⟨0, 0, 0, 0, by simp⟩
lemma is5Form_zero : Is5Form 0 := ⟨0, 0, 0, 0, 0, by simp⟩

lemma succ_cube (k : ℕ) : (k + 1) ^ 3 = k ^ 3 + 3 * k ^ 2 + 3 * k + 1 := by ring

lemma nthRoot_three (n : ℕ) :
    Nat.nthRoot 3 n ^ 3 ≤ n ∧ n < (Nat.nthRoot 3 n + 1) ^ 3 :=
  ⟨pow_nthRoot_le (Or.inl (by decide : (3 : ℕ) ≠ 0)),
   lt_pow_nthRoot_add_one (by decide : (3 : ℕ) ≠ 0) n⟩

/-- Any interval `[a, b]` whose length is at least the last cubic gap contains a cube. -/
lemma exists_cube_in_interval {a b : ℕ} (hle : a ≤ b)
    (hgap : 3 * (Nat.nthRoot 3 b) ^ 2 + 3 * (Nat.nthRoot 3 b) + 1 ≤ b - a) :
    ∃ z : ℕ, a ≤ z ^ 3 ∧ z ^ 3 ≤ b := by
  set k := Nat.nthRoot 3 b
  have hk : k ^ 3 ≤ b := (nthRoot_three b).1
  have hk' : b < (k + 1) ^ 3 := (nthRoot_three b).2
  refine ⟨k, ?_, hk⟩
  have hdiff : b - k ^ 3 < 3 * k ^ 2 + 3 * k + 1 := by
    have : b < k ^ 3 + (3 * k ^ 2 + 3 * k + 1) := by
      calc b < (k + 1) ^ 3 := hk'
        _ = k ^ 3 + 3 * k ^ 2 + 3 * k + 1 := succ_cube k
        _ = k ^ 3 + (3 * k ^ 2 + 3 * k + 1) := by ring
    exact Nat.sub_lt_left_of_lt_add hk this
  have : b - k ^ 3 ≤ b - a := by
    have : b - k ^ 3 < 3 * k ^ 2 + 3 * k + 1 := hdiff
    have : 3 * k ^ 2 + 3 * k + 1 ≤ b - a := hgap
    omega
  exact Nat.le_of_sub_le_sub_left hle this

/-- A tight bound: any variable in a representation of `n` is at most `Nat.nthRoot 3 n`. -/
lemma cube_le_of_mem_repr {u n : ℕ} (h : u ^ 3 ≤ n) : u ≤ Nat.nthRoot 3 n := by
  have := (nthRoot_three n).2
  by_contra hne
  have hlt : Nat.nthRoot 3 n < u := Nat.lt_of_not_ge hne
  have : (Nat.nthRoot 3 n + 1) ^ 3 ≤ u ^ 3 := Nat.pow_le_pow_left (Nat.succ_le_of_lt hlt) 3
  omega

/-- Fast counter matching `A271099`, looping only up to the cube root. -/
def count5 (n : ℕ) : ℕ :=
  let B := Nat.nthRoot 3 n + 1
  (Finset.range B).sum fun u =>
  (Finset.range B).sum fun v =>
  (Finset.range B).sum fun x =>
  (Finset.range B).sum fun y =>
  (Finset.range B).sum fun z =>
    if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n then 1 else 0

lemma pow_three_gt_of_nthRoot {u n : ℕ} (h : Nat.nthRoot 3 n < u) : n < u ^ 3 := by
  have := (nthRoot_three n).2
  have : (Nat.nthRoot 3 n + 1) ^ 3 ≤ u ^ 3 := Nat.pow_le_pow_left (Nat.succ_le_of_lt h) 3
  omega

private def ind5 (n u v x y z : ℕ) : ℕ :=
  if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n then 1 else 0

lemma ind5_eq_zero_of_large {n u v x y z : ℕ}
    (h : Nat.nthRoot 3 n < u ∨ Nat.nthRoot 3 n < v ∨ Nat.nthRoot 3 n < x ∨
         Nat.nthRoot 3 n < y ∨ Nat.nthRoot 3 n < z) :
    ind5 n u v x y z = 0 := by
  unfold ind5
  split_ifs with hif
  · have hsum := hif.2.2
    have h2x : x ^ 3 ≤ 2 * x ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
    have h2y : y ^ 3 ≤ 2 * y ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
    have h3z : z ^ 3 ≤ 3 * z ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 3)
    rcases h with hu | hv | hx | hy | hz
    · have : n < u ^ 3 := pow_three_gt_of_nthRoot hu
      have : u ^ 3 ≤ n := by
        have := Nat.le_add_right (u ^ 3) (v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3)
        rw [← hsum]; ring_nf at this ⊢; exact this
      omega
    · have : n < v ^ 3 := pow_three_gt_of_nthRoot hv
      have : v ^ 3 ≤ n := by
        calc v ^ 3 ≤ u ^ 3 + v ^ 3 := Nat.le_add_left _ _
          _ ≤ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by omega
          _ = n := hsum
      omega
    · have : n < x ^ 3 := pow_three_gt_of_nthRoot hx
      have : x ^ 3 ≤ n := by
        calc x ^ 3 ≤ 2 * x ^ 3 := h2x
          _ ≤ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by omega
          _ = n := hsum
      omega
    · have : n < y ^ 3 := pow_three_gt_of_nthRoot hy
      have : y ^ 3 ≤ n := by
        calc y ^ 3 ≤ 2 * y ^ 3 := h2y
          _ ≤ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by omega
          _ = n := hsum
      omega
    · have : n < z ^ 3 := pow_three_gt_of_nthRoot hz
      have : z ^ 3 ≤ n := by
        calc z ^ 3 ≤ 3 * z ^ 3 := h3z
          _ ≤ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by omega
          _ = n := hsum
      omega
  · rfl

lemma nthRoot_three_lt_succ (n : ℕ) : Nat.nthRoot 3 n + 1 ≤ n + 1 := by
  have : Nat.nthRoot 3 n ≤ n := by
    by_cases h : n = 0
    · subst h; simp
    · have hpos : 0 < n := Nat.pos_of_ne_zero h
      have := (nthRoot_three n).1
      have h1 : 1 ≤ Nat.nthRoot 3 n ∨ Nat.nthRoot 3 n = 0 := by omega
      cases h1 with
      | inl h1 =>
        have : Nat.nthRoot 3 n ≤ (Nat.nthRoot 3 n) ^ 3 := by
          have : Nat.nthRoot 3 n * Nat.nthRoot 3 n * Nat.nthRoot 3 n = (Nat.nthRoot 3 n) ^ 3 := by ring
          have : 1 ≤ Nat.nthRoot 3 n := h1
          nlinarith
        omega
      | inr h0 => omega
  omega

lemma count5_eq_A271099 (n : ℕ) : count5 n = A271099 n := by
  unfold count5 A271099
  set B := Nat.nthRoot 3 n + 1 with hB
  have hBle : B ≤ n + 1 := nthRoot_three_lt_succ n
  have hsub : range B ⊆ range (n + 1) := by
    intro t ht
    simp only [Finset.mem_range] at ht ⊢
    omega
  -- Expand both as sums of `ind5`
  change ∑ u ∈ range B, ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z =
    ∑ u ∈ range (n + 1), ∑ v ∈ range (n + 1), ∑ x ∈ range (n + 1), ∑ y ∈ range (n + 1),
      ∑ z ∈ range (n + 1), ind5 n u v x y z
  -- Extra terms vanish
  have hz_ext : ∀ u v x y, ∑ z ∈ range (n + 1), ind5 n u v x y z =
      ∑ z ∈ range B, ind5 n u v x y z := by
    intro u v x y
    refine (Finset.sum_subset hsub ?_).symm
    intro z hz hzB
    have : B ≤ z := by
      simp only [Finset.mem_range] at hzB hz
      omega
    apply ind5_eq_zero_of_large
    refine Or.inr (Or.inr (Or.inr (Or.inr ?_)))
    omega
  have hy_ext : ∀ u v x, ∑ y ∈ range (n + 1), ∑ z ∈ range (n + 1), ind5 n u v x y z =
      ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z := by
    intro u v x
    have : ∑ y ∈ range (n + 1), ∑ z ∈ range (n + 1), ind5 n u v x y z =
        ∑ y ∈ range (n + 1), ∑ z ∈ range B, ind5 n u v x y z := by
      apply Finset.sum_congr rfl; intro y _; exact hz_ext u v x y
    rw [this]
    refine (Finset.sum_subset hsub ?_).symm
    intro y hy hyB
    have : B ≤ y := by
      simp only [Finset.mem_range] at hyB hy
      omega
    apply Finset.sum_eq_zero
    intro z _
    apply ind5_eq_zero_of_large
    exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
  have hx_ext : ∀ u v, ∑ x ∈ range (n + 1), ∑ y ∈ range (n + 1), ∑ z ∈ range (n + 1), ind5 n u v x y z =
      ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z := by
    intro u v
    have : ∑ x ∈ range (n + 1), ∑ y ∈ range (n + 1), ∑ z ∈ range (n + 1), ind5 n u v x y z =
        ∑ x ∈ range (n + 1), ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z := by
      apply Finset.sum_congr rfl; intro x _; exact hy_ext u v x
    rw [this]
    refine (Finset.sum_subset hsub ?_).symm
    intro x hx hxB
    have : B ≤ x := by
      simp only [Finset.mem_range] at hxB hx
      omega
    apply Finset.sum_eq_zero
    intro y _
    apply Finset.sum_eq_zero
    intro z _
    apply ind5_eq_zero_of_large
    exact Or.inr (Or.inr (Or.inl (by omega)))
  have hv_ext : ∀ u, ∑ v ∈ range (n + 1), ∑ x ∈ range (n + 1), ∑ y ∈ range (n + 1),
      ∑ z ∈ range (n + 1), ind5 n u v x y z =
      ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z := by
    intro u
    have : ∑ v ∈ range (n + 1), ∑ x ∈ range (n + 1), ∑ y ∈ range (n + 1),
        ∑ z ∈ range (n + 1), ind5 n u v x y z =
        ∑ v ∈ range (n + 1), ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z := by
      apply Finset.sum_congr rfl; intro v _; exact hx_ext u v
    rw [this]
    refine (Finset.sum_subset hsub ?_).symm
    intro v hv hvB
    have : B ≤ v := by
      simp only [Finset.mem_range] at hvB hv
      omega
    apply Finset.sum_eq_zero
    intro x _
    apply Finset.sum_eq_zero
    intro y _
    apply Finset.sum_eq_zero
    intro z _
    apply ind5_eq_zero_of_large
    exact Or.inr (Or.inl (by omega))
  have : ∑ u ∈ range (n + 1), ∑ v ∈ range (n + 1), ∑ x ∈ range (n + 1), ∑ y ∈ range (n + 1),
      ∑ z ∈ range (n + 1), ind5 n u v x y z =
      ∑ u ∈ range (n + 1), ∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B,
        ind5 n u v x y z := by
    apply Finset.sum_congr rfl; intro u _; exact hv_ext u
  rw [this]
  refine (Finset.sum_subset (s₁ := range B) (s₂ := range (n + 1)) (f := fun u =>
      (∑ v ∈ range B, ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z : ℕ))
      hsub ?_)
  intro u hu huB
  have : B ≤ u := by
    simp only [Finset.mem_range] at huB hu
    omega
  refine @Finset.sum_eq_zero ℕ ℕ (range B) _ (fun v =>
    ∑ x ∈ range B, ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z) ?_
  intro v _
  refine @Finset.sum_eq_zero ℕ ℕ (range B) _ (fun x =>
    ∑ y ∈ range B, ∑ z ∈ range B, ind5 n u v x y z) ?_
  intro x _
  refine @Finset.sum_eq_zero ℕ ℕ (range B) _ (fun y =>
    ∑ z ∈ range B, ind5 n u v x y z) ?_
  intro y _
  refine @Finset.sum_eq_zero ℕ ℕ (range B) _ (fun z => ind5 n u v x y z) ?_
  intro z _
  apply ind5_eq_zero_of_large
  exact Or.inl (by omega)

/- Geometric coefficients for part (iii) -/

/-- `⌊(3/2)^k⌋`. -/
def qfloor (k : ℕ) : ℕ := 3 ^ k / 2 ^ k

lemma qfloor_pos {k : ℕ} (_hk : 2 ≤ k) : 0 < qfloor k := by
  unfold qfloor
  apply Nat.div_pos
  · exact Nat.pow_le_pow_left (by decide : (2 : ℕ) ≤ 3) k
  · exact pow_pos (by decide : (0 : ℕ) < 2) k

lemma two_le_pow_two (n : ℕ) (hn : 1 ≤ n) : 2 ≤ 2 ^ n := by
  calc 2 = 2 ^ 1 := by simp
    _ ≤ 2 ^ n := Nat.pow_le_pow_right (by decide : 0 < 2) hn

/-- Two copies of `2^0,...,2^{k-2}` followed by `qfloor k`. -/
def sunC (k : ℕ) (i : Fin (2 * k - 1)) : ℕ :=
  if i.val + 1 = 2 * k - 1 then qfloor k else 2 ^ (i.val / 2)

lemma sunC_pos {k : ℕ} (hk : 2 ≤ k) (i : Fin (2 * k - 1)) : sunC k i > 0 := by
  unfold sunC
  split_ifs
  · exact qfloor_pos hk
  · exact pow_pos (by decide : (0 : ℕ) < 2) _

lemma div_two_even (m : ℕ) : (2 * m) / 2 = m :=
  Nat.mul_div_cancel_left m (by decide : 0 < 2)

lemma div_two_odd (m : ℕ) : (2 * m + 1) / 2 = m := by omega

lemma sum_pair_pow (m : ℕ) :
    ∑ i ∈ range (2 * m), (2 : ℕ) ^ (i / 2) = 2 ^ (m + 1) - 2 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [show 2 * m.succ = 2 * m + 2 from by simp [Nat.succ_eq_add_one]; ring]
    rw [sum_range_succ, sum_range_succ, ih, div_two_even, div_two_odd]
    have hm : 2 ≤ 2 ^ (m + 1) := two_le_pow_two (m + 1) (Nat.succ_pos _)
    have hm' : 2 ≤ 2 ^ (m + 2) := two_le_pow_two (m + 2) (by omega)
    have : 2 ^ (m + 1) - 2 + 2 ^ m + 2 ^ m = 2 ^ (m + 2) - 2 := by
      zify [hm, hm']
      ring
    simpa [Nat.succ_eq_add_one] using this

lemma sunC_sum {k : ℕ} (hk : 2 ≤ k) :
    ∑ i : Fin (2 * k - 1), sunC k i = 2 ^ k + qfloor k - 2 := by
  have hcard : 2 * k - 1 = 2 * (k - 1) + 1 := by omega
  have hsum : ∑ i : Fin (2 * k - 1), sunC k i =
      ∑ i ∈ range (2 * k - 1),
        (if i + 1 = 2 * k - 1 then qfloor k else 2 ^ (i / 2)) := by
    rw [Finset.sum_fin_eq_sum_range]
    apply Finset.sum_congr rfl
    intro i hi
    simp only [mem_range] at hi
    simp [sunC, hi]
  rw [hsum, hcard, sum_range_succ]
  have hlast :
      (if 2 * (k - 1) + 1 = 2 * (k - 1) + 1 then qfloor k else (2 : ℕ) ^ ((2 * (k - 1)) / 2)) =
        qfloor k := if_pos rfl
  rw [hlast]
  have hrange :
      ∑ i ∈ range (2 * (k - 1)),
        (if i + 1 = 2 * (k - 1) + 1 then qfloor k else 2 ^ (i / 2)) =
      ∑ i ∈ range (2 * (k - 1)), 2 ^ (i / 2) := by
    apply Finset.sum_congr rfl
    intro i hi
    simp only [mem_range] at hi
    split_ifs with hif
    · omega
    · rfl
  rw [hrange, sum_pair_pow]
  have hkm : k - 1 + 1 = k := by omega
  rw [hkm]
  have h2 : 2 ≤ 2 ^ k := two_le_pow_two k (le_trans (by decide : 1 ≤ 2) hk)
  omega

lemma sunC_sum_waring {k : ℕ} (hk : 2 ≤ k) :
    ∑ i : Fin (2 * k - 1), sunC k i = waring_g k := by
  rw [sunC_sum hk, waring_g_eq hk]
  simp [qfloor]

lemma pair_binary_subset_sums (m n : ℕ) (hn : n ≤ 2 ^ (m + 1) - 2) :
    ∃ d : Fin m → Fin 3, ∑ i : Fin m, (d i).val * 2 ^ i.val = n := by
  induction m generalizing n with
  | zero =>
    have : n = 0 := by simp at hn; omega
    subst this
    refine ⟨fun i => i.elim0, ?_⟩
    simp
  | succ m ih =>
    have hmax : n ≤ 2 ^ (m + 2) - 2 := by simpa [Nat.succ_eq_add_one] using hn
    have hpow : 2 ^ (m + 2) - 2 = (2 ^ (m + 1) - 2) + 2 * 2 ^ m := by
      have hA : 2 ≤ 2 ^ (m + 2) := two_le_pow_two (m + 2) (by omega)
      have hB : 2 ≤ 2 ^ (m + 1) := two_le_pow_two (m + 1) (by omega)
      have heq : 2 ^ (m + 2) = 2 ^ (m + 1) * 2 := pow_succ _ _
      have heq' : 2 ^ (m + 1) = 2 ^ m * 2 := pow_succ _ _
      omega
    have hcast : ∀ (d0 : Fin m → Fin 3),
        ∑ x : Fin m, (d0 x).val * 2 ^ x.castSucc.val =
        ∑ x : Fin m, (d0 x).val * 2 ^ x.val := by
      intro d0
      apply Finset.sum_congr rfl
      intro x _
      rw [Fin.val_castSucc]
    have hlast : (Fin.last m).val = m := rfl
    by_cases h2 : 2 * 2 ^ m ≤ n
    · have hn' : n - 2 * 2 ^ m ≤ 2 ^ (m + 1) - 2 := by omega
      obtain ⟨d0, hd0⟩ := ih (n - 2 * 2 ^ m) hn'
      refine ⟨Fin.snoc d0 2, ?_⟩
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last]
      rw [hcast, hd0, hlast]
      omega
    · by_cases h1 : 2 ^ m ≤ n
      · have hn' : n - 2 ^ m ≤ 2 ^ (m + 1) - 2 := by omega
        obtain ⟨d0, hd0⟩ := ih (n - 2 ^ m) hn'
        refine ⟨Fin.snoc d0 1, ?_⟩
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.snoc_castSucc, Fin.snoc_last]
        rw [hcast, hd0, hlast]
        omega
      · have hn' : n ≤ 2 ^ (m + 1) - 2 := by omega
        obtain ⟨d0, hd0⟩ := ih n hn'
        refine ⟨Fin.snoc d0 0, ?_⟩
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.snoc_castSucc, Fin.snoc_last]
        rw [hcast, hd0, hlast]
        simp

/-- The weighted form with coefficients `c` represents `n`. -/
def Represents (k : ℕ) (c : Fin (2 * k - 1) → ℕ) (n : ℕ) : Prop :=
  ∃ x : Fin (2 * k - 1) → ℕ,
    ∑ i : Fin (2 * k - 1), c i * (x i) ^ k = n

/-- 0-1 assignment from pair-digits; last variable unused (0). -/
def pairVars (k : ℕ) (d : Fin (k - 1) → Fin 3) (i : Fin (2 * k - 1)) : ℕ :=
  if i.val + 1 = 2 * k - 1 then 0
  else
    let j := i.val / 2
    if hj : j < k - 1 then
      if i.val % 2 = 0 then (if 1 ≤ (d ⟨j, hj⟩).val then 1 else 0)
      else (if 2 ≤ (d ⟨j, hj⟩).val then 1 else 0)
    else 0

/-- Like `pairVars` but the last variable is set to `last`. -/
def pairVars' (k : ℕ) (d : Fin (k - 1) → Fin 3) (last : ℕ) (i : Fin (2 * k - 1)) : ℕ :=
  if i.val + 1 = 2 * k - 1 then last else pairVars k d i

lemma zero_pow_of_pos {k : ℕ} (hk : 0 < k) : (0 : ℕ) ^ k = 0 :=
  zero_pow (Nat.ne_zero_of_lt hk)

lemma pairVars_mul {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → Fin 3) (j : ℕ)
    (hj : j < k - 1) :
    sunC k ⟨2 * j, by omega⟩ * pairVars k d ⟨2 * j, by omega⟩ ^ k +
    sunC k ⟨2 * j + 1, by omega⟩ * pairVars k d ⟨2 * j + 1, by omega⟩ ^ k =
    (d ⟨j, hj⟩).val * 2 ^ j := by
  have h0ne : ¬ (2 * j + 1 = 2 * k - 1) := by omega
  have h1ne : ¬ (2 * j + 1 + 1 = 2 * k - 1) := by omega
  have hdiv0 : (2 * j) / 2 = j := Nat.mul_div_cancel_left j (by decide : 0 < 2)
  have hdiv1 : (2 * j + 1) / 2 = j := by omega
  have hmod0 : (2 * j) % 2 = 0 := by omega
  have hmod1 : (2 * j + 1) % 2 = 1 := by omega
  have hkpos : 0 < k := by omega
  unfold sunC pairVars
  simp only [h0ne, h1ne, ↓reduceIte, hdiv0, hdiv1, hj, ↓reduceDIte, hmod0, hmod1]
  set dj := (d ⟨j, hj⟩).val with hdjdef
  have hdj : dj ≤ 2 := Fin.is_le _
  match hdjc : dj with
  | 0 =>
    simp [zero_pow_of_pos hkpos]
  | 1 =>
    simp [zero_pow_of_pos hkpos]
  | 2 =>
    simp [one_pow]
    ring
  | n+3 =>
    omega

lemma sum_range_pairs (m : ℕ) (f : ℕ → ℕ) :
    ∑ i ∈ range (2 * m), f i = ∑ j ∈ range m, (f (2 * j) + f (2 * j + 1)) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [show 2 * m.succ = 2 * m + 2 from by simp [Nat.succ_eq_add_one]; ring]
    rw [sum_range_succ, sum_range_succ, ih, sum_range_succ]
    ac_rfl

lemma pairVars_last {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → Fin 3) :
    pairVars k d ⟨2 * (k - 1), by omega⟩ = 0 := by
  unfold pairVars
  have : 2 * (k - 1) + 1 = 2 * k - 1 := by omega
  simp [this]

lemma pairVars_sum {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → Fin 3) :
    ∑ i : Fin (2 * k - 1), sunC k i * pairVars k d i ^ k =
    ∑ j : Fin (k - 1), (d j).val * 2 ^ j.val := by
  let f : ℕ → ℕ := fun i =>
    if hi : i < 2 * k - 1 then sunC k ⟨i, hi⟩ * pairVars k d ⟨i, hi⟩ ^ k else 0
  have hlhs : ∑ i : Fin (2 * k - 1), sunC k i * pairVars k d i ^ k =
      ∑ i ∈ range (2 * k - 1), f i := by
    rw [Finset.sum_fin_eq_sum_range]
  have hrhs : ∑ j : Fin (k - 1), (d j).val * 2 ^ j.val =
      ∑ j ∈ range (k - 1),
        if hj : j < k - 1 then (d ⟨j, hj⟩).val * 2 ^ j else 0 :=
    Finset.sum_fin_eq_sum_range _
  rw [hlhs, hrhs]
  have hcard : 2 * k - 1 = 2 * (k - 1) + 1 := by omega
  rw [hcard, sum_range_succ]
  have hlast : f (2 * (k - 1)) = 0 := by
    unfold f
    have hlt : 2 * (k - 1) < 2 * k - 1 := by omega
    simp only [hlt, ↓reduceDIte, pairVars_last hk]
    simp [zero_pow (Nat.ne_zero_of_lt (show 0 < k by omega))]
  rw [hlast, add_zero, sum_range_pairs]
  apply Finset.sum_congr rfl
  intro j hj
  simp only [mem_range] at hj
  have h0 : 2 * j < 2 * k - 1 := by omega
  have h1 : 2 * j + 1 < 2 * k - 1 := by omega
  unfold f
  simp only [h0, h1, hj, ↓reduceDIte]
  exact pairVars_mul hk d j hj

lemma pairVars'_eq_pairVars {k : ℕ} (_hk : 2 ≤ k) (d : Fin (k - 1) → Fin 3)
    (i : Fin (2 * k - 1)) (h : i.val + 1 ≠ 2 * k - 1) :
    pairVars' k d 1 i = pairVars k d i := by
  unfold pairVars'
  simp [h]

lemma pairVars'_last {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → Fin 3) :
    pairVars' k d 1 ⟨2 * (k - 1), by omega⟩ = 1 := by
  unfold pairVars'
  have : 2 * (k - 1) + 1 = 2 * k - 1 := by omega
  simp [this]

lemma sunC_last {k : ℕ} (hk : 2 ≤ k) :
    sunC k ⟨2 * (k - 1), by omega⟩ = qfloor k := by
  unfold sunC
  have : 2 * (k - 1) + 1 = 2 * k - 1 := by omega
  simp [this]

lemma pairVars'_sum {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → Fin 3) :
    ∑ i : Fin (2 * k - 1), sunC k i * pairVars' k d 1 i ^ k =
    ∑ j : Fin (k - 1), (d j).val * 2 ^ j.val + qfloor k := by
  have hdiff : ∀ i : Fin (2 * k - 1),
      sunC k i * pairVars' k d 1 i ^ k =
        sunC k i * pairVars k d i ^ k +
          if i.val + 1 = 2 * k - 1 then qfloor k else 0 := by
    intro i
    by_cases h : i.val + 1 = 2 * k - 1
    · have hi : i = ⟨2 * (k - 1), by omega⟩ := by
        apply Fin.ext
        have : i.val = 2 * (k - 1) := by omega
        exact this
      rw [hi]
      rw [pairVars'_last hk, pairVars_last hk, sunC_last hk]
      have hif : (⟨2 * (k - 1), by omega⟩ : Fin (2 * k - 1)).val + 1 = 2 * k - 1 := by
        simp; omega
      rw [if_pos hif]
      simp [one_pow, zero_pow (Nat.ne_zero_of_lt (show 0 < k by omega))]
    · rw [pairVars'_eq_pairVars hk d i h]
      simp [h]
  rw [Finset.sum_congr rfl (fun i _ => hdiff i), Finset.sum_add_distrib]
  rw [pairVars_sum hk]
  have hlastsum :
      ∑ i : Fin (2 * k - 1), (if i.val + 1 = 2 * k - 1 then qfloor k else 0) = qfloor k := by
    have hcard : 2 * k - 1 = 2 * (k - 1) + 1 := by omega
    let g : ℕ → ℕ := fun i => if i + 1 = 2 * k - 1 then qfloor k else 0
    have : ∑ i : Fin (2 * k - 1), (if i.val + 1 = 2 * k - 1 then qfloor k else 0) =
        ∑ i ∈ range (2 * k - 1), g i := by
      rw [Finset.sum_fin_eq_sum_range]
      apply Finset.sum_congr rfl
      intro i hi
      simp only [mem_range] at hi
      simp [g, hi]
    rw [this, hcard, sum_range_succ]
    have h0 : ∀ i ∈ range (2 * (k - 1)), g i = 0 := by
      intro i hi
      simp only [mem_range] at hi
      unfold g
      have : i + 1 ≠ 2 * k - 1 := by omega
      simp [this]
    rw [sum_eq_zero h0, zero_add]
    unfold g
    have : 2 * (k - 1) + 1 = 2 * k - 1 := by omega
    simp [this]
  rw [hlastsum]

lemma qfloor_le_two_pow_sub_one {k : ℕ} (hk : 1 ≤ k) : qfloor k ≤ 2 ^ k - 1 := by
  unfold qfloor
  have h2 : 0 < 2 ^ k := pow_pos (by decide : (0 : ℕ) < 2) k
  have hlt : 3 ^ k < 2 ^ k * 2 ^ k := by
    have : 3 ^ k < 4 ^ k := Nat.pow_lt_pow_left (by decide : (3 : ℕ) < 4) (Nat.ne_zero_of_lt hk)
    have h4 : 4 ^ k = (2 ^ 2) ^ k := by simp
    have h22 : (2 ^ 2) ^ k = 2 ^ (2 * k) := (Nat.pow_mul 2 2 k).symm
    have hmul : 2 ^ (2 * k) = 2 ^ k * 2 ^ k := by
      rw [two_mul, pow_add]
    calc 3 ^ k < 4 ^ k := this
      _ = 2 ^ k * 2 ^ k := by rw [h4, h22, hmul]
  have : 3 ^ k / 2 ^ k < 2 ^ k := (Nat.div_lt_iff_lt_mul h2).2 hlt
  omega

/-- Every `n < 2^k` is represented by the geometric coefficients (digits 0 or 1). -/
lemma represents_sunC_of_lt_two_pow {k n : ℕ} (hk : 2 ≤ k) (hn : n < 2 ^ k) :
    Represents k (sunC k) n := by
  have h2 : 2 ≤ 2 ^ k := two_le_pow_two k (by omega)
  by_cases h : n ≤ 2 ^ k - 2
  · have hm : n ≤ 2 ^ ((k - 1) + 1) - 2 := by
      simpa [Nat.sub_add_cancel (show 1 ≤ k by omega)] using h
    obtain ⟨d, hd⟩ := pair_binary_subset_sums (k - 1) n hm
    refine ⟨pairVars k d, ?_⟩
    rw [pairVars_sum hk, hd]
  · have hn' : n = 2 ^ k - 1 := by omega
    subst hn'
    have hq1 : 1 ≤ qfloor k := qfloor_pos hk
    have hq2 : qfloor k ≤ 2 ^ k - 1 := qfloor_le_two_pow_sub_one (by omega)
    have hrem : 2 ^ k - 1 - qfloor k ≤ 2 ^ ((k - 1) + 1) - 2 := by
      simpa [Nat.sub_add_cancel (show 1 ≤ k by omega)] using
        (by omega : 2 ^ k - 1 - qfloor k ≤ 2 ^ k - 2)
    obtain ⟨d, hd⟩ := pair_binary_subset_sums (k - 1) (2 ^ k - 1 - qfloor k) hrem
    refine ⟨pairVars' k d 1, ?_⟩
    rw [pairVars'_sum hk, hd]
    omega


/- P(2): representation of all n < 3^k by geometric coefficients -/

lemma exists_pair_LH (m L H : ℕ) (hsum : L + H ≤ 2 ^ (m + 1) - 2) :
    ∃ d : Fin m → ℕ × ℕ,
      (∀ j, (d j).1 + (d j).2 ≤ 2 ∧ (d j).1 ≤ 2 ∧ (d j).2 ≤ 2) ∧
      ∑ j : Fin m, (d j).1 * 2 ^ j.val = L ∧
      ∑ j : Fin m, (d j).2 * 2 ^ j.val = H := by
  induction m generalizing L H with
  | zero =>
    have hLH : L = 0 ∧ H = 0 := by simp at hsum; omega
    refine ⟨fun i => i.elim0, ?_, ?_, ?_⟩
    · intro j; exact j.elim0
    · simp [hLH.1]
    · simp [hLH.2]
  | succ m ih =>
    have hex : ∃ a b : ℕ, a ≤ 2 ∧ b ≤ 2 ∧ a + b ≤ 2 ∧
        a * 2 ^ m ≤ L ∧ b * 2 ^ m ≤ H ∧
        (L - a * 2 ^ m) + (H - b * 2 ^ m) ≤ 2 ^ (m + 1) - 2 := by
      by_cases hA : L + H ≤ 2 ^ (m + 1) - 2
      · exact ⟨0, 0, by omega, by omega, by omega, by omega, by omega, by simpa using hA⟩
      · by_cases hB : L + H ≤ 3 * 2 ^ m - 2
        · have : 2 ^ m ≤ L ∨ 2 ^ m ≤ H := by
            by_contra h; push_neg at h
            have hm : 1 ≤ 2 ^ m := Nat.one_le_two_pow
            omega
          cases this with
          | inl hL =>
            refine ⟨1, 0, by omega, by omega, by omega, by simpa using hL, by omega, ?_⟩; omega
          | inr hH =>
            refine ⟨0, 1, by omega, by omega, by omega, by omega, by simpa using hH, ?_⟩; omega
        · by_cases hL2 : 2 ^ m ≤ L
          · by_cases hH2 : 2 ^ m ≤ H
            · refine ⟨1, 1, by omega, by omega, by omega, by simpa using hL2, by simpa using hH2, ?_⟩
              have : 2 * 2 ^ m = 2 ^ (m + 1) := by rw [pow_succ, mul_comm]
              omega
            · refine ⟨2, 0, by omega, by omega, by omega, ?_, by omega, ?_⟩
              · omega
              · have : 2 * 2 ^ m = 2 ^ (m + 1) := by rw [pow_succ, mul_comm]
                omega
          · refine ⟨0, 2, by omega, by omega, by omega, by omega, ?_, ?_⟩
            · omega
            · have : 2 * 2 ^ m = 2 ^ (m + 1) := by rw [pow_succ, mul_comm]
              omega
    obtain ⟨a, b, ha2, hb2, hab, haL, hbH, hIH⟩ := hex
    obtain ⟨d0, hd0, hd0L, hd0H⟩ := ih (L - a * 2 ^ m) (H - b * 2 ^ m) hIH
    refine ⟨Fin.snoc d0 (a, b), ?_, ?_, ?_⟩
    · intro j
      refine Fin.lastCases ?_ ?_ j
      · simp [Fin.snoc_last, ha2, hb2, hab]
      · intro i; simp [Fin.snoc_castSucc]; exact hd0 i
    · have hcast : ∑ x : Fin m, (d0 x).1 * 2 ^ x.castSucc.val =
          ∑ x : Fin m, (d0 x).1 * 2 ^ x.val := by
        apply Finset.sum_congr rfl; intro x _; rw [Fin.val_castSucc]
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last]
      rw [hcast, hd0L]; simp [Fin.last]; omega
    · have hcast : ∑ x : Fin m, (d0 x).2 * 2 ^ x.castSucc.val =
          ∑ x : Fin m, (d0 x).2 * 2 ^ x.val := by
        apply Finset.sum_congr rfl; intro x _; rw [Fin.val_castSucc]
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last]
      rw [hcast, hd0H]; simp [Fin.last]; omega

def lhVars (k : ℕ) (d : Fin (k - 1) → ℕ × ℕ) (last : ℕ) (i : Fin (2 * k - 1)) : ℕ :=
  if i.val + 1 = 2 * k - 1 then last
  else
    let j := i.val / 2
    if hj : j < k - 1 then
      let a := (d ⟨j, hj⟩).1
      let b := (d ⟨j, hj⟩).2
      if i.val % 2 = 0 then
        if 1 ≤ a then 1 else if 1 ≤ b then 2 else 0
      else
        if 2 ≤ a then 1 else if 2 ≤ a + b then 2 else 0
    else 0

lemma lhVars_mul {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → ℕ × ℕ) (last : ℕ)
    (j : ℕ) (hj : j < k - 1)
    (hbound : (d ⟨j, hj⟩).1 + (d ⟨j, hj⟩).2 ≤ 2 ∧ (d ⟨j, hj⟩).1 ≤ 2 ∧ (d ⟨j, hj⟩).2 ≤ 2) :
    sunC k ⟨2 * j, by omega⟩ * lhVars k d last ⟨2 * j, by omega⟩ ^ k +
    sunC k ⟨2 * j + 1, by omega⟩ * lhVars k d last ⟨2 * j + 1, by omega⟩ ^ k =
    2 ^ j * ((d ⟨j, hj⟩).1 + (d ⟨j, hj⟩).2 * 2 ^ k) := by
  have h0ne : ¬ (2 * j + 1 = 2 * k - 1) := by omega
  have h1ne : ¬ (2 * j + 1 + 1 = 2 * k - 1) := by omega
  have hdiv0 : (2 * j) / 2 = j := Nat.mul_div_cancel_left j (by decide : 0 < 2)
  have hdiv1 : (2 * j + 1) / 2 = j := by omega
  have hmod0 : (2 * j) % 2 = 0 := by omega
  have hmod1 : (2 * j + 1) % 2 = 1 := by omega
  have hkpos : 0 < k := by omega
  set a := (d ⟨j, hj⟩).1 with ha
  set b := (d ⟨j, hj⟩).2 with hb
  have sc0 : sunC k ⟨2 * j, by omega⟩ = 2 ^ j := by unfold sunC; simp [h0ne, hdiv0]
  have sc1 : sunC k ⟨2 * j + 1, by omega⟩ = 2 ^ j := by unfold sunC; simp [h1ne, hdiv1]
  have v0 : lhVars k d last ⟨2 * j, by omega⟩ =
      if 1 ≤ a then 1 else if 1 ≤ b then 2 else 0 := by
    unfold lhVars; simp [h0ne, hdiv0, hj, hmod0, ha, hb]
  have v1 : lhVars k d last ⟨2 * j + 1, by omega⟩ =
      if 2 ≤ a then 1 else if 2 ≤ a + b then 2 else 0 := by
    unfold lhVars; simp [h1ne, hdiv1, hj, hmod1, ha, hb]
  rw [sc0, sc1, v0, v1]
  match ha' : a, hb' : b with
  | 0, 0 => simp [zero_pow (Nat.ne_zero_of_lt hkpos)]
  | 0, 1 => simp [zero_pow (Nat.ne_zero_of_lt hkpos)]
  | 0, 2 => simp; ring
  | 1, 0 => simp [one_pow, zero_pow (Nat.ne_zero_of_lt hkpos)]
  | 1, 1 => simp [one_pow]; ring
  | 1, 2 => omega
  | 2, 0 => simp [one_pow]; ring
  | 2, 1 => omega
  | 2, 2 => omega
  | n+3, _ => omega
  | _, n+3 => omega


lemma lhVars_last {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → ℕ × ℕ) (last : ℕ) :
    lhVars k d last ⟨2 * (k - 1), by omega⟩ = last := by
  unfold lhVars
  have : 2 * (k - 1) + 1 = 2 * k - 1 := by omega
  simp [this]


lemma lhVars_sum {k : ℕ} (hk : 2 ≤ k) (d : Fin (k - 1) → ℕ × ℕ) (last : ℕ)
    (hbound : ∀ j, (d j).1 + (d j).2 ≤ 2 ∧ (d j).1 ≤ 2 ∧ (d j).2 ≤ 2) :
    ∑ i : Fin (2 * k - 1), sunC k i * lhVars k d last i ^ k =
    (∑ j : Fin (k - 1), 2 ^ j.val * ((d j).1 + (d j).2 * 2 ^ k)) +
      qfloor k * last ^ k := by
  let f : ℕ → ℕ := fun i =>
    if hi : i < 2 * k - 1 then sunC k ⟨i, hi⟩ * lhVars k d last ⟨i, hi⟩ ^ k else 0
  have hlhs : ∑ i : Fin (2 * k - 1), sunC k i * lhVars k d last i ^ k =
      ∑ i ∈ range (2 * k - 1), f i := by
    rw [Finset.sum_fin_eq_sum_range]
  rw [hlhs]
  have hcard : 2 * k - 1 = 2 * (k - 1) + 1 := by omega
  rw [hcard, sum_range_succ]
  have hlast : f (2 * (k - 1)) = qfloor k * last ^ k := by
    unfold f
    have hlt : 2 * (k - 1) < 2 * k - 1 := by omega
    simp only [hlt, ↓reduceDIte, lhVars_last hk, sunC_last hk]
  rw [hlast]
  have hrest : ∑ i ∈ range (2 * (k - 1)), f i =
      ∑ j : Fin (k - 1), 2 ^ j.val * ((d j).1 + (d j).2 * 2 ^ k) := by
    rw [sum_range_pairs]
    have hrhs : ∑ j : Fin (k - 1), 2 ^ j.val * ((d j).1 + (d j).2 * 2 ^ k) =
        ∑ j ∈ range (k - 1),
          if hj : j < k - 1 then 2 ^ j * ((d ⟨j, hj⟩).1 + (d ⟨j, hj⟩).2 * 2 ^ k) else 0 :=
      Finset.sum_fin_eq_sum_range _
    rw [hrhs]
    apply Finset.sum_congr rfl
    intro j hj
    simp only [mem_range] at hj
    have h0 : 2 * j < 2 * k - 1 := by omega
    have h1 : 2 * j + 1 < 2 * k - 1 := by omega
    unfold f
    simp only [h0, h1, hj, ↓reduceDIte]
    exact lhVars_mul hk d last j hj (hbound ⟨j, hj⟩)
  rw [hrest]

lemma three_pow_lt_two_pow_double {k : ℕ} (hk : 3 ≤ k) : 3 ^ k < 2 ^ (2 * k - 1) := by
  induction k, hk using Nat.le_induction with
  | base => decide
  | succ k hk ih =>
    have h3s : 3 ^ (k + 1) = 3 * 3 ^ k := by rw [pow_succ, mul_comm]
    have h2s : 2 ^ (2 * (k + 1) - 1) = 4 * 2 ^ (2 * k - 1) := by
      have e1 : 2 * (k + 1) - 1 = (2 * k - 1) + 2 := by omega
      rw [e1, pow_add]
      norm_num
      ac_rfl
    rw [h3s, h2s]
    have := Nat.mul_lt_mul_of_pos_left ih (by decide : 0 < 3)
    exact lt_of_lt_of_le this (Nat.mul_le_mul_right _ (by decide : (3 : ℕ) ≤ 4))

lemma qfloor_le_two_pow_pred {k : ℕ} (hk : 3 ≤ k) : qfloor k ≤ 2 ^ (k - 1) - 1 := by
  unfold qfloor
  have h2 : 0 < 2 ^ k := pow_pos (by decide : (0 : ℕ) < 2) k
  have hmul : 2 ^ (k - 1) * 2 ^ k = 2 ^ (2 * k - 1) := by
    have : (k - 1) + k = 2 * k - 1 := by omega
    rw [← pow_add, this]
  have hlt : 3 ^ k < 2 ^ (k - 1) * 2 ^ k := by
    rw [hmul]; exact three_pow_lt_two_pow_double hk
  have : 3 ^ k / 2 ^ k < 2 ^ (k - 1) := (Nat.div_lt_iff_lt_mul h2).2 hlt
  omega


lemma represents_of_LH {k L H last : ℕ} (hk : 2 ≤ k)
    (hsum : L + H ≤ 2 ^ k - 2) :
    Represents k (sunC k) (L + 2 ^ k * H + qfloor k * last ^ k) := by
  have hm : L + H ≤ 2 ^ ((k - 1) + 1) - 2 := by
    simpa [Nat.sub_add_cancel (show 1 ≤ k by omega)] using hsum
  obtain ⟨d, hd, hdL, hdH⟩ := exists_pair_LH (k - 1) L H hm
  refine ⟨lhVars k d last, ?_⟩
  rw [lhVars_sum hk d last hd]
  have : ∑ j : Fin (k - 1), 2 ^ j.val * ((d j).1 + (d j).2 * 2 ^ k) =
      ∑ j : Fin (k - 1), ((d j).1 * 2 ^ j.val + (d j).2 * 2 ^ j.val * 2 ^ k) := by
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [this, Finset.sum_add_distrib]
  have hL : ∑ j : Fin (k - 1), (d j).1 * 2 ^ j.val = L := hdL
  have hH : ∑ j : Fin (k - 1), (d j).2 * 2 ^ j.val * 2 ^ k =
      (∑ j : Fin (k - 1), (d j).2 * 2 ^ j.val) * 2 ^ k := by
    rw [Finset.sum_mul]
  rw [hL, hH, hdH]
  ring

lemma n1_le_qfloor {k n : ℕ} (hn : n < 3 ^ k) :
    n / 2 ^ k ≤ qfloor k := by
  have h2 : 0 < 2 ^ k := pow_pos (by decide : (0 : ℕ) < 2) k
  have : n ≤ 3 ^ k - 1 := by omega
  have : n / 2 ^ k ≤ (3 ^ k - 1) / 2 ^ k := Nat.div_le_div_right this
  have : (3 ^ k - 1) / 2 ^ k ≤ 3 ^ k / 2 ^ k := Nat.div_le_div_right (Nat.sub_le _ _)
  unfold qfloor
  omega

lemma represents_sunC_of_eq_LH {k n L H last : ℕ} (hk : 2 ≤ k)
    (hsum : L + H ≤ 2 ^ k - 2)
    (heq : n = L + 2 ^ k * H + qfloor k * last ^ k) :
    Represents k (sunC k) n := by
  rw [heq]
  exact represents_of_LH hk hsum

lemma two_mul_pow_pred (k : ℕ) (hk : 1 ≤ k) : 2 * 2 ^ (k - 1) = 2 ^ k := by
  rw [mul_comm, ← pow_succ, Nat.sub_add_cancel hk]

lemma not_two_pow_dvd_three_pow {k : ℕ} (hk : 1 ≤ k) : ¬ 2 ^ k ∣ 3 ^ k := by
  intro h
  have h2 : 2 ∣ 3 ^ k := by
    have : 2 ^ k = 2 * 2 ^ (k - 1) := (two_mul_pow_pred k hk).symm
    exact dvd_trans ⟨2 ^ (k - 1), this⟩ h
  have hodd : Odd (3 ^ k) := Odd.pow (by decide : Odd 3)
  exact hodd.not_two_dvd_nat h2

lemma three_pow_mod_pos {k : ℕ} (hk : 1 ≤ k) : 0 < 3 ^ k % 2 ^ k := by
  apply Nat.pos_of_ne_zero
  intro hz
  exact not_two_pow_dvd_three_pow hk (Nat.dvd_iff_mod_eq_zero.mpr hz)

lemma two_mul_pred_pow (k : ℕ) (hk : 1 ≤ k) : 2 * (2 ^ (k - 1) - 1) = 2 ^ k - 2 := by
  have h2pred : 2 * 2 ^ (k - 1) = 2 ^ k := two_mul_pow_pred k hk
  rw [Nat.mul_sub_left_distrib, h2pred]

lemma qfloor_le_two_pow (k : ℕ) (hk : 3 ≤ k) : qfloor k ≤ 2 ^ k - 1 := by
  have := qfloor_le_two_pow_pred hk
  have : 2 ^ (k - 1) - 1 ≤ 2 ^ k - 1 := by
    have : 2 ^ (k - 1) ≤ 2 ^ k := Nat.pow_le_pow_right (by decide : 0 < 2) (Nat.sub_le _ _)
    omega
  omega

lemma two_mul_qfloor_le (k : ℕ) (hk : 3 ≤ k) : 2 * qfloor k ≤ 2 ^ k - 2 := by
  have h1 : qfloor k ≤ 2 ^ (k - 1) - 1 := qfloor_le_two_pow_pred hk
  have h2 : 2 * (2 ^ (k - 1) - 1) = 2 ^ k - 2 := two_mul_pred_pow k (by omega)
  have h3 : 2 * qfloor k ≤ 2 * (2 ^ (k - 1) - 1) := Nat.mul_le_mul_left 2 h1
  omega

/-- Every `n < 3^k` is represented by geometric coefficients (digits 0,1,2). -/
lemma represents_sunC_of_lt_three_pow {k n : ℕ} (hk : 3 ≤ k) (hn : n < 3 ^ k) :
    Represents k (sunC k) n := by
  have hk2 : 2 ≤ k := by omega
  generalize hT : (2 ^ k) = T
  generalize hq : qfloor k = q
  generalize hn0e : (n % 2 ^ k) = n0
  generalize hn1e : (n / 2 ^ k) = n1
  have hTpos : 0 < T := by rw [← hT]; exact pow_pos (by decide : (0 : ℕ) < 2) k
  have h2le : 2 ≤ T := by rw [← hT]; exact two_le_pow_two k (by omega)
  have hqpos : 0 < q := by rw [← hq]; exact qfloor_pos hk2
  have hqT : q ≤ T - 1 := by rw [← hq, ← hT]; exact qfloor_le_two_pow k hk
  have hq2 : 2 * q ≤ T - 2 := by rw [← hq, ← hT]; exact two_mul_qfloor_le k hk
  have hn1 : n1 ≤ q := by rw [← hn1e, ← hq]; exact n1_le_qfloor hn
  have hn0lt : n0 < T := by
    rw [← hn0e, ← hT]; exact Nat.mod_lt n (pow_pos (by decide : (0 : ℕ) < 2) k)
  have hdecomp : n = n0 + T * n1 := by
    rw [← hn0e, ← hn1e, ← hT]; exact (Nat.mod_add_div n (2 ^ k)).symm
  have hmodpos : 0 < 3 ^ k % T := by
    rw [← hT]; exact three_pow_mod_pos (by omega)
  have hmodlt : 3 ^ k % T < T := Nat.mod_lt _ hTpos
  by_cases h1eq : n1 = q
  · -- last = 2, L = n0, H = 0
    have hn0le : n0 ≤ T - 2 := by
      have hsplit : 3 ^ k = T * q + 3 ^ k % T := by
        rw [← hT, ← hq]
        simp [qfloor]
        exact (Nat.div_add_mod (3 ^ k) (2 ^ k)).symm
      have : n0 + T * q < T * q + 3 ^ k % T := by
        calc n0 + T * q
            = n := by rw [← h1eq, ← hdecomp]
          _ < 3 ^ k := hn
          _ = T * q + 3 ^ k % T := hsplit
      omega
    refine represents_sunC_of_eq_LH hk2 (L := n0) (H := 0) (last := 2) ?_ ?_
    · omega
    · calc n = n0 + T * n1 := hdecomp
        _ = n0 + T * q := by rw [h1eq]
        _ = n0 + 2 ^ k * 0 + qfloor k * 2 ^ k := by
            rw [← hT, ← hq]; ring
  · have hn1lt : n1 + 1 ≤ q := Nat.succ_le_of_lt (lt_of_le_of_ne hn1 h1eq)
    by_cases hz : n1 = 0
    · by_cases htop : n0 = T - 1
      · -- last = 1, L = T-1-q, H = 0
        refine represents_sunC_of_eq_LH hk2 (L := T - 1 - q) (H := 0) (last := 1) ?_ ?_
        · omega
        · simp only [one_pow, mul_one, mul_zero, add_zero]
          rw [hdecomp, htop, hz, mul_zero, add_zero, ← hq]
          omega
      · -- last = 0, L = n0, H = 0
        have : n0 ≤ T - 2 := by omega
        refine represents_sunC_of_eq_LH hk2 (L := n0) (H := 0) (last := 0) ?_ ?_
        · omega
        · simp only [zero_pow (show k ≠ 0 by omega), mul_zero, add_zero]
          rw [hdecomp, hz, mul_zero, add_zero]
    · have hn1pos : 1 ≤ n1 := by omega
      by_cases hge : q ≤ n0
      · -- last = 1, L = n0-q, H = n1
        have hsum : n0 - q + n1 ≤ T - 2 := by
          have : n0 ≤ T - 1 := by omega
          omega
        refine represents_sunC_of_eq_LH hk2 (L := n0 - q) (H := n1) (last := 1) ?_ ?_
        · rw [hT]; exact hsum
        · simp only [one_pow, mul_one]
          calc n = n0 + T * n1 := hdecomp
            _ = n0 - q + q + T * n1 := by omega
            _ = n0 - q + 2 ^ k * n1 + qfloor k := by
                rw [← hT, ← hq]; ring
      · have hn0ltq : n0 + 1 ≤ q := Nat.succ_le_of_lt (Nat.not_le.mp hge)
        by_cases hsmall : n0 + n1 < q
        · -- last = 1, L = n0+T-q, H = n1-1
          have hsum : n0 + T - q + (n1 - 1) ≤ T - 2 := by omega
          refine represents_sunC_of_eq_LH hk2 (L := n0 + T - q) (H := n1 - 1) (last := 1) ?_ ?_
          · rw [hT]; exact hsum
          · simp only [one_pow, mul_one]
            have hsplit : T * n1 = T * (n1 - 1) + T := by
              have hn1eq' : n1 = n1 - 1 + 1 := by omega
              conv_lhs => rw [hn1eq']
              ring
            calc n = n0 + T * n1 := hdecomp
              _ = n0 + T * (n1 - 1) + T := by rw [hsplit]; ring
              _ = n0 + T - q + T * (n1 - 1) + q := by omega
              _ = n0 + T - q + 2 ^ k * (n1 - 1) + qfloor k := by
                  rw [← hT, ← hq]
        · -- last = 0, L = n0, H = n1
          have hsum : n0 + n1 ≤ T - 2 := by omega
          refine represents_sunC_of_eq_LH hk2 (L := n0) (H := n1) (last := 0) ?_ ?_
          · rw [hT]; exact hsum
          · simp only [zero_pow (show k ≠ 0 by omega), mul_zero, add_zero]
            rw [hdecomp, hT]

lemma represents_iff_mem_range {k : ℕ} (c : Fin (2 * k - 1) → ℕ) (n : ℕ) :
    Represents k c n ↔
      n ∈ Set.range (fun x : Fin (2 * k - 1) → ℕ =>
        ∑ i : Fin (2 * k - 1), c i * (x i) ^ k) := by
  constructor
  · intro ⟨x, hx⟩; exact ⟨x, hx⟩
  · intro ⟨x, hx⟩; exact ⟨x, hx⟩

lemma represents_all_iff_range {k : ℕ} (c : Fin (2 * k - 1) → ℕ) :
    (∀ n, Represents k c n) ↔
      (Set.range (fun x : Fin (2 * k - 1) → ℕ =>
        ∑ i : Fin (2 * k - 1), c i * (x i) ^ k) = Set.univ) := by
  constructor
  · intro h
    ext n
    simp [Set.mem_range]
    exact represents_iff_mem_range c n |>.mp (h n)
  · intro h n
    have : n ∈ Set.univ := trivial
    rw [← h] at this
    exact (represents_iff_mem_range c n).mpr this

lemma sunC_three : ∀ i : Fin 5, sunC 3 i = if i.val < 2 then 1 else if i.val < 4 then 2 else 3 := by
  decide

lemma is5Form_of_represents {n : ℕ} (h : Represents 3 (sunC 3) n) : Is5Form n := by
  obtain ⟨x, hx⟩ := h
  refine ⟨x 0, x 1, x 2, x 3, x 4, ?_⟩
  have hsum := hx
  rw [Fin.sum_univ_five] at hsum
  have c0 : sunC 3 0 = 1 := by decide
  have c1 : sunC 3 1 = 1 := by decide
  have c2 : sunC 3 2 = 2 := by decide
  have c3 : sunC 3 3 = 2 := by decide
  have c4 : sunC 3 4 = 3 := by decide
  rw [c0, c1, c2, c3, c4] at hsum
  linear_combination (norm := ring) hsum.symm

lemma a271099_pos_of_is5Form {n : ℕ} (h : Is5Form n) : A271099 n > 0 := by
  obtain ⟨u0, v0, x0, y0, z, hn⟩ := h
  let u := min u0 v0
  let v := max u0 v0
  let x := min x0 y0
  let y := max x0 y0
  have huv : u ≤ v := min_le_max
  have hxy : x ≤ y := min_le_max
  have hn' : n = u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 := by
    simp [u, v, x, y]
    rcases le_total u0 v0 with h1 | h1 <;> rcases le_total x0 y0 with h2 | h2 <;>
      simp [h1, h2, hn] <;> ring
  rw [← count5_eq_A271099]
  unfold count5
  set B := Nat.nthRoot 3 n + 1 with hB
  have hle : ∀ t : ℕ, t ^ 3 ≤ n → t < B := by
    intro t ht
    have := cube_le_of_mem_repr ht
    omega
  have huB : u < B := hle u (by rw [hn']; omega)
  have hvB : v < B := hle v (by rw [hn']; omega)
  have hxB : x < B := hle x (by
    have : x ^ 3 ≤ 2 * x ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
    rw [hn']; omega)
  have hyB : y < B := hle y (by
    have : y ^ 3 ≤ 2 * y ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 2)
    rw [hn']; omega)
  have hzB : z < B := hle z (by
    have : z ^ 3 ≤ 3 * z ^ 3 := Nat.le_mul_of_pos_left _ (by decide : 0 < 3)
    rw [hn']; omega)
  have hu : u ∈ range B := Finset.mem_range.mpr huB
  have hv : v ∈ range B := Finset.mem_range.mpr hvB
  have hx : x ∈ range B := Finset.mem_range.mpr hxB
  have hy : y ∈ range B := Finset.mem_range.mpr hyB
  have hz : z ∈ range B := Finset.mem_range.mpr hzB
  have hterm :
      (if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z ^ 3 = n
        then (1 : ℕ) else 0) = 1 := by
    simp [huv, hxy, hn']
  -- one positive summand implies the whole sum is positive
  have hz_sum :
      0 < (range B).sum fun z' =>
        if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine lt_of_lt_of_le (by decide : (0 : ℕ) < 1) ?_
    have := Finset.single_le_sum
      (f := fun z' : ℕ =>
        if u ≤ v ∧ x ≤ y ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) hz
    simpa [hterm] using this
  have hy_sum :
      0 < (range B).sum fun y' => (range B).sum fun z' =>
        if u ≤ v ∧ x ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine lt_of_lt_of_le hz_sum ?_
    have := Finset.single_le_sum
      (f := fun y' : ℕ => (range B).sum fun z' =>
        if u ≤ v ∧ x ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) hy
    simpa using this
  have hx_sum :
      0 < (range B).sum fun x' => (range B).sum fun y' => (range B).sum fun z' =>
        if u ≤ v ∧ x' ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine lt_of_lt_of_le hy_sum ?_
    have := Finset.single_le_sum
      (f := fun x' : ℕ => (range B).sum fun y' => (range B).sum fun z' =>
        if u ≤ v ∧ x' ≤ y' ∧ u ^ 3 + v ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) hx
    simpa using this
  have hv_sum :
      0 < (range B).sum fun v' => (range B).sum fun x' => (range B).sum fun y' =>
        (range B).sum fun z' =>
        if u ≤ v' ∧ x' ≤ y' ∧ u ^ 3 + v' ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then 1 else 0 := by
    refine lt_of_lt_of_le hx_sum ?_
    have := Finset.single_le_sum
      (f := fun v' : ℕ => (range B).sum fun x' => (range B).sum fun y' =>
        (range B).sum fun z' =>
        if u ≤ v' ∧ x' ≤ y' ∧ u ^ 3 + v' ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
        then (1 : ℕ) else 0)
      (fun _ _ => Nat.zero_le _) hv
    simpa using this
  refine lt_of_lt_of_le hv_sum ?_
  have := Finset.single_le_sum
    (f := fun u' : ℕ => (range B).sum fun v' => (range B).sum fun x' =>
      (range B).sum fun y' => (range B).sum fun z' =>
      if u' ≤ v' ∧ x' ≤ y' ∧ u' ^ 3 + v' ^ 3 + 2 * x' ^ 3 + 2 * y' ^ 3 + 3 * z' ^ 3 = n
      then (1 : ℕ) else 0)
    (fun _ _ => Nat.zero_le _) hu
  simpa using this

lemma is5Form_of_lt_27 {n : ℕ} (hn : n < 27) : Is5Form n := by
  have h := represents_sunC_of_lt_three_pow (k := 3) (n := n) (by decide) (by
    have : 3 ^ 3 = 27 := by decide
    rwa [this])
  exact is5Form_of_represents h

