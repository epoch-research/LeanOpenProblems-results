theorem oeis_135508_conjecture_0 :
  ∀ p : ℕ, Nat.Prime p → ¬ (Nat.Prime (p - 2)) → A135508 (p - 1) = p := by
  intro p
  induction p using Nat.strong_induction_on with
  | h p ih =>
    intro hp hnp
    have hp2 : 2 ≤ p := hp.two_le
    rcases lt_or_ge p 5 with hlt | hp5
    · -- `p = 2` or `p = 3`
      rcases hp.eq_two_or_odd with rfl | hodd
      · exact A135508_one
      · have : p = 3 := by
          have : p ≠ 4 := fun h => by subst h; exact (by decide : ¬ Nat.Prime 4) hp
          omega
        subst this
        exact A135508_two
    -- `p ≥ 5`, `p-2` not prime ⇒ `p-2` is composite (since `p-2 ≥ 3`).
    apply A135508_eq_self_of_prime hp
    intro hA1
    have hpred : A135508 (p - 3) = p - 2 := (A135508_eq_one_iff_pred hp hp5).mp hA1
    -- So `gcd(x(p-3), p-2) = 1`. We derive a contradiction by finding a prime
    -- factor of `p-2` that already divides `x(p-3)`.
    have hp2pos : 0 < p - 2 := by omega
    have hgcd1 : Nat.gcd (x_seq (p - 3)) (p - 2) = 1 := by
      have hmul := A135508_mul_gcd (p - 3) (by omega)
      have hn : p - 3 + 1 = p - 2 := by omega
      rw [hpred, hn] at hmul
      apply Nat.eq_of_mul_eq_mul_left hp2pos
      simpa using hmul
    have hcomp : ¬ (p - 2).Prime := hnp
    have hne1 : p - 2 ≠ 1 := by omega
    set m := p - 2
    have hq : m.minFac.Prime := minFac_prime hne1
    have hqdiv : m.minFac ∣ m := minFac_dvd m
    have hq2le : m.minFac ^ 2 ≤ m := Nat.minFac_sq_le_self hp2pos hcomp
    set q := m.minFac
    -- `q` does not divide `x(p-3)` because the gcd is 1.
    have hqn : ¬ q ∣ x_seq (p - 3) := by
      intro hqx
      have : q ∣ Nat.gcd (x_seq (p - 3)) m := Nat.dvd_gcd hqx hqdiv
      rw [hgcd1] at this
      exact hq.not_dvd_one this
    -- But `q` does divide `x(p-3)`.
    have : q ∣ x_seq (p - 3) := by
      rcases lt_or_ge q 5 with hql | hq5
      · have hq234 : q = 2 ∨ q = 3 ∨ q = 4 := by
          have := hq.two_le
          omega
        rcases hq234 with hq2 | hq3 | hq4
        · have hn2 : 2 ≤ p - 3 := by
            rw [hq2, pow_two] at hq2le; omega
          rw [hq2]
          exact x_seq_two_dvd.trans (x_seq_dvd_of_le (by omega) hn2)
        · have hn4 : 4 ≤ p - 3 := by
            rw [hq3, pow_two] at hq2le; omega
          rw [hq3]
          exact x_seq_four_dvd_three.trans (x_seq_dvd_of_le (by omega) hn4)
        · rw [hq4] at hq; exact (by decide : ¬ Nat.Prime 4).elim hq
      · -- `q ≥ 5`. Produce a smaller prime `r = t*q-2` to which the IH applies.
        obtain ⟨t, htq, htodd, hrtp, hrtnp⟩ := exists_odd_t_prime_sub_two q hq hq5
        set r := t * q - 2
        have h2le : 2 ≤ t * q := two_le_mul_of_odd_t htodd hq.two_le
        have hr2 : r + 2 = t * q := by omega
        have htq_le : t * q ≤ q ^ 2 := by
          have := Nat.mul_le_mul_right q htq
          simpa [pow_two, mul_comm] using this
        have hr_le_q2 : r ≤ q ^ 2 - 2 := by
          have : t * q - 2 ≤ q ^ 2 - 2 := Nat.sub_le_sub_right htq_le 2
          simpa [r] using this
        have hrle : r ≤ p - 3 := by
          have : q ^ 2 ≤ m := hq2le
          have : q ^ 2 - 2 ≤ m - 2 := Nat.sub_le_sub_right this 2
          have : r ≤ m - 2 := le_trans hr_le_q2 this
          have : m - 2 = p - 4 := by
            simp [m]
            omega
          omega
        have hrlt : r < p := by omega
        -- IH at the smaller prime `r`: since `r-2` is not prime, `A(r-1) = r`.
        have hAr : A135508 (r - 1) = r := ih r hrlt hrtp hrtnp
        have hqdivA : q ∣ A135508 (r - 1) + 2 := by
          rw [hAr, hr2]
          exact dvd_mul_left q t
        have hqx : q ∣ x_seq r := by
          rw [dvd_x_seq_iff hq hrtp.pos]
          refine ⟨r - 1, ?_, hqdivA⟩
          simp only [mem_Icc]
          have : 2 ≤ r := hrtp.two_le
          omega
        exact hqx.trans (x_seq_dvd_of_le hrtp.pos hrle)
    exact hqn this
