/-- Finite verification for `5 ≤ q < 50000`. -/
lemma exists_odd_t_lt_50000 (q : ℕ) (hq : q.Prime) (hq5 : 5 ≤ q) (hlt : q < 50000) :
    ∃ t, t ≤ q ∧ t % 2 = 1 ∧ (t * q - 2).Prime ∧ ¬ (t * q - 4).Prime := by
  have hlo0 : 5 ≤ q := hq5
  rcases lt_or_ge q 500 with hlt0 | hge0
  · exact exists_t_range_5_500 q hq hlo0 hlt0
