/-- Among three numbers `n, n+2, n+4` with `n ≥ 4`, at least one is divisible by `3`
and hence not prime. In particular `(3,5,7)` is the only prime triplet of this form. -/
lemma not_prime_of_prime_add_two_add_four {n : ℕ} (hn : 4 ≤ n)
    (hp2 : (n + 2).Prime) (hp4 : (n + 4).Prime) : ¬ n.Prime := by
  intro hp
  have hmod : n % 3 = 0 ∨ n % 3 = 1 ∨ n % 3 = 2 := by omega
  have n3 : ¬ 3 ∣ n := by
    intro hd
    have : 3 = n := (hp.eq_one_or_self_of_dvd 3 hd).resolve_left (by decide)
    omega
  have n23 : ¬ 3 ∣ n + 2 := by
    intro hd
    have : 3 = n + 2 := (hp2.eq_one_or_self_of_dvd 3 hd).resolve_left (by decide)
    omega
  have n43 : ¬ 3 ∣ n + 4 := by
    intro hd
    have : 3 = n + 4 := (hp4.eq_one_or_self_of_dvd 3 hd).resolve_left (by decide)
    omega
  rcases hmod with h0 | h1 | h2
  · exact n3 (Nat.dvd_of_mod_eq_zero h0)
  · have : (n + 2) % 3 = 0 := by omega
    exact n23 (Nat.dvd_of_mod_eq_zero this)
  · have : (n + 4) % 3 = 0 := by omega
    exact n43 (Nat.dvd_of_mod_eq_zero this)

/-- If `q > 7` is prime and `q - 2` is prime, then `t = 1` is a good witness. -/
lemma exists_odd_t_of_pred_prime {q : ℕ} (hq : q.Prime) (hq7 : 7 < q)
    (hpred : (q - 2).Prime) :
    ∃ t, t ≤ q ∧ t % 2 = 1 ∧ (t * q - 2).Prime ∧ ¬ (t * q - 4).Prime := by
  refine ⟨1, ?_, ?_, ?_, ?_⟩
  · exact le_trans (by decide : 1 ≤ 7) (le_of_lt hq7)
  · decide
  · have h2 : 2 ≤ q := hq.two_le
    have : 1 * q - 2 = q - 2 := by omega
    rwa [this]
  · have h2 : 2 ≤ q := hq.two_le
    have h4 : 4 ≤ q := by omega
    have heq : 1 * q - 4 = q - 4 := by omega
    rw [heq]
    have hn : 4 ≤ q - 4 := by omega
    have hp2 : ((q - 4) + 2).Prime := by
      have : q - 4 + 2 = q - 2 := by omega
      rwa [this]
    have hp4 : ((q - 4) + 4).Prime := by
      have : q - 4 + 4 = q := by omega
      rwa [this]
    exact not_prime_of_prime_add_two_add_four hn hp2 hp4

/-! ### Dirichlet infrastructure for the tail -/

lemma odd_of_prime_ge_five {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) : q % 2 = 1 := by
  have hne2 : q ≠ 2 := by omega
  have : Odd q := hq.odd_of_ne_two hne2
  rwa [Nat.odd_iff] at this

lemma coprime_two_of_odd {n : ℕ} (h : n % 2 = 1) : n.Coprime 2 := by
  rw [Nat.coprime_iff_gcd_eq_one, Nat.gcd_comm, Nat.gcd_rec, h]
  simp

lemma gcd_q_sub_two {q : ℕ} (h2 : 2 ≤ q) : Nat.gcd (q - 2) q = Nat.gcd 2 q := by
  have heq : q = (q - 2) + 2 := by omega
  have h1 : Nat.gcd (q - 2) q = Nat.gcd (q - 2) 2 := by
    nth_rw 2 [heq]
    simpa using (Nat.gcd_add_self_right (q - 2) 2)
  rw [h1, Nat.gcd_comm]
  have : (q - 2) % 2 = q % 2 := by omega
  rw [Nat.gcd_rec 2 (q - 2), Nat.gcd_rec 2 q, this]

lemma coprime_q_sub_two_two_mul {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) :
    (q - 2).Coprime (2 * q) := by
  have hq2 : 2 ≤ q := hq.two_le
  rw [Nat.coprime_mul_iff_right]
  constructor
  · have : (q - 2) % 2 = 1 := by
      have := odd_of_prime_ge_five hq hq5
      omega
    exact coprime_two_of_odd this
  · rw [Nat.coprime_iff_gcd_eq_one, gcd_q_sub_two hq2]
    have h2p : Nat.Prime 2 := by decide
    have : ¬ 2 ∣ q := by
      intro hd
      have eq := (hq.eq_one_or_self_of_dvd 2 hd).resolve_left (by decide)
      omega
    exact (h2p.coprime_iff_not_dvd).mpr this

/-- A natural `r ≡ q-2 [MOD 2q]` with `r ≥ q-2` has the form `r + 2 = t*q` for odd `t`. -/
lemma eq_mul_of_modEq {q r : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (hrmod : r ≡ q - 2 [MOD 2 * q]) (hrge : q - 2 ≤ r) :
    ∃ t : ℕ, t % 2 = 1 ∧ r + 2 = t * q := by
  have hq2 : 2 ≤ q := hq.two_le
  have hz : ((q - 2 : ℕ) : ℤ) ≡ (r : ℤ) [ZMOD (2 * q : ℕ)] :=
    Int.natCast_modEq_iff.mpr hrmod.symm
  have hdiv : (2 * q : ℤ) ∣ (r : ℤ) - (q - 2 : ℕ) := (Int.modEq_iff_dvd).mp hz
  obtain ⟨k, hk⟩ := hdiv
  have hqcast : ((q - 2 : ℕ) : ℤ) = (q : ℤ) - 2 := by omega
  have hr2 : (r : ℤ) + 2 = (2 * k + 1) * (q : ℤ) := by
    rw [hqcast] at hk
    linarith
  have hk0 : 0 ≤ k := by
    have hnn : (0 : ℤ) ≤ (r : ℤ) - (q - 2 : ℕ) :=
      sub_nonneg.mpr (Int.ofNat_le.mpr hrge)
    have : (0 : ℤ) ≤ (2 * q : ℤ) * k := by rwa [← hk]
    have hpos : (0 : ℤ) < 2 * q := by exact_mod_cast (by omega : 0 < 2 * q)
    exact nonneg_of_mul_nonneg_right this hpos
  lift k to ℕ using hk0
  refine ⟨2 * k + 1, by omega, ?_⟩
  have : ((r + 2 : ℕ) : ℤ) = (((2 * k + 1) * q : ℕ) : ℤ) := by
    push_cast
    simpa using hr2
  exact_mod_cast this

lemma two_mul_dvd_six_mul' (q : ℕ) : 2 * q ∣ 6 * q := ⟨3, by ring⟩
lemma three_dvd_six_mul' (q : ℕ) : 3 ∣ 6 * q := ⟨2 * q, by ring⟩

lemma not_three_dvd_prime {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) : ¬ 3 ∣ q := by
  intro hd
  have : 3 = q := (hq.eq_one_or_self_of_dvd 3 hd).resolve_left (by decide)
  omega

lemma coprime_two_mul_three {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) :
    (2 * q).Coprime 3 := by
  rw [Nat.coprime_mul_iff_left]
  constructor
  · decide
  · exact (Nat.coprime_comm.mp
      ((Nat.Prime.coprime_iff_not_dvd (by decide : Nat.Prime 3)).mpr
        (not_three_dvd_prime hq hq5)))

lemma gcd_eq_of_modEq {a b n : ℕ} (h : a ≡ b [MOD n]) : Nat.gcd a n = Nat.gcd b n := by
  have : a % n = b % n := h
  rw [Nat.gcd_comm a n, Nat.gcd_rec n a, this, ← Nat.gcd_rec n b, Nat.gcd_comm]

lemma exists_good_residue (q : ℕ) (hq : q.Prime) (hq5 : 5 ≤ q) :
    ∃ a : ℕ, a < 6 * q ∧ a ≡ q - 2 [MOD 2 * q] ∧ a ≡ 2 [MOD 3] ∧ a.Coprime (6 * q) := by
  obtain ⟨x, hx⟩ := Nat.chineseRemainder (coprime_two_mul_three hq hq5) (q - 2) 2
  have hx1 : x ≡ q - 2 [MOD 2 * q] := hx.1
  have hx2 : x ≡ 2 [MOD 3] := hx.2
  set a := x % (6 * q)
  have h6q : 0 < 6 * q := by have := hq.pos; omega
  have hax : a ≡ x [MOD 6 * q] := Nat.mod_modEq x (6 * q)
  have ha_2q : a ≡ q - 2 [MOD 2 * q] :=
    (Nat.ModEq.of_dvd (two_mul_dvd_six_mul' q) hax).trans hx1
  have ha_3 : a ≡ 2 [MOD 3] :=
    (Nat.ModEq.of_dvd (three_dvd_six_mul' q) hax).trans hx2
  refine ⟨a, Nat.mod_lt x h6q, ha_2q, ha_3, ?_⟩
  have hcop2 : a.Coprime 2 := by
    have hmod2 : a ≡ q - 2 [MOD 2] := Nat.ModEq.of_dvd ⟨q, by ring⟩ ha_2q
    have : a % 2 = 1 := by
      have hodd := odd_of_prime_ge_five hq hq5
      have : (q - 2) % 2 = 1 := by omega
      have : a % 2 = (q - 2) % 2 := hmod2
      omega
    exact coprime_two_of_odd this
  have hcop3 : a.Coprime 3 := by
    have : a % 3 = 2 := ha_3
    rw [Nat.coprime_iff_gcd_eq_one, Nat.gcd_comm, Nat.gcd_rec, this]
    decide
  have hcopq : a.Coprime q := by
    have haq : a ≡ q - 2 [MOD q] := Nat.ModEq.of_dvd ⟨2, by ring⟩ ha_2q
    rw [Nat.coprime_iff_gcd_eq_one, gcd_eq_of_modEq haq, gcd_q_sub_two hq.two_le]
    have h2p : Nat.Prime 2 := by decide
    have : ¬ 2 ∣ q := by
      intro hd
      have eq := (hq.eq_one_or_self_of_dvd 2 hd).resolve_left (by decide)
      omega
    exact (h2p.coprime_iff_not_dvd).mpr this
  have hcop6 : a.Coprime 6 := by
    rw [show 6 = 2 * 3 from rfl, Nat.coprime_mul_iff_right]
    exact ⟨hcop2, hcop3⟩
  rw [Nat.coprime_mul_iff_right]
  exact ⟨hcop6, hcopq⟩

lemma exists_isolated_prime_AP (q : ℕ) (hq : q.Prime) (hq5 : 5 ≤ q) :
    ∃ r t : ℕ, r.Prime ∧ t % 2 = 1 ∧ r + 2 = t * q ∧ 3 ∣ r - 2 ∧ q - 2 ≤ r := by
  obtain ⟨a, ha_lt, ha_2q, ha_3, ha_cop⟩ := exists_good_residue q hq hq5
  have h6q : 6 * q ≠ 0 := by
    have := hq.pos
    omega
  obtain ⟨r, hrgt, hrp, hrmod⟩ :=
    Nat.forall_exists_prime_gt_and_modEq (n := 5) (q := 6 * q) (a := a) h6q ha_cop
  have hr_2q : r ≡ q - 2 [MOD 2 * q] :=
    (Nat.ModEq.of_dvd (two_mul_dvd_six_mul' q) hrmod).trans ha_2q
  have hr_3 : r ≡ 2 [MOD 3] :=
    (Nat.ModEq.of_dvd (three_dvd_six_mul' q) hrmod).trans ha_3
  have ha_ge : q - 2 ≤ a := by
    have hq2 : 2 ≤ q := hq.two_le
    have hlt2q : q - 2 < 2 * q := by omega
    have hmod_eq : a % (2 * q) = q - 2 := by
      have : a % (2 * q) = (q - 2) % (2 * q) := ha_2q
      rwa [Nat.mod_eq_of_lt hlt2q] at this
    have hrep := Nat.div_add_mod a (2 * q)
    rw [hmod_eq] at hrep
    omega
  have hrge : q - 2 ≤ r := by
    have ha_mod : a % (6 * q) = a := Nat.mod_eq_of_lt ha_lt
    have hr_mod : r % (6 * q) = a := by
      have : r % (6 * q) = a % (6 * q) := hrmod
      rwa [ha_mod] at this
    have hrep := Nat.div_add_mod r (6 * q)
    rw [hr_mod] at hrep
    calc
      q - 2 ≤ a := ha_ge
      _ ≤ 6 * q * (r / (6 * q)) + a := Nat.le_add_left _ _
      _ = r := hrep
  obtain ⟨t, htodd, hteq⟩ := eq_mul_of_modEq hq hq5 hr_2q hrge
  have h3 : 3 ∣ r - 2 := by
    have hrm : r % 3 = 2 := hr_3
    have hr2 : 2 ≤ r := hrp.two_le
    have : (r - 2) % 3 = 0 := by omega
    exact Nat.dvd_of_mod_eq_zero this
  exact ⟨r, t, hrp, htodd, hteq, h3, hrge⟩

/-- A prime `r ≥ 7` with `3 ∣ r - 2` cannot be an upper twin: `r - 2` is composite. -/
lemma not_prime_sub_two_of_three_dvd {r : ℕ} (hrp : r.Prime) (hr7 : 7 ≤ r)
    (h3 : 3 ∣ r - 2) : ¬ (r - 2).Prime := by
  have hr2ge : 5 ≤ r - 2 := by omega
  have hne3 : r - 2 ≠ 3 := by omega
  intro hp
  have : 3 = r - 2 := (hp.eq_one_or_self_of_dvd 3 h3).resolve_left (by decide)
  exact hne3 this.symm

/-- Isolate the `t` and non-twin data from a prime `r > 5` in the good AP. -/
lemma isolated_data_of_AP {q r : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (hrp : r.Prime) (hr5 : 5 < r)
    (hr_2q : r ≡ q - 2 [MOD 2 * q]) (hrge : q - 2 ≤ r)
    (hr_3 : r ≡ 2 [MOD 3]) :
    ∃ t : ℕ, t % 2 = 1 ∧ r + 2 = t * q ∧ 3 ∣ r - 2 ∧ ¬ (t * q - 4).Prime := by
  obtain ⟨t, htodd, hteq⟩ := eq_mul_of_modEq hq hq5 hr_2q hrge
  have hr2 : 2 ≤ r := hrp.two_le
  have h3 : 3 ∣ r - 2 := by
    have hrm : r % 3 = 2 := hr_3
    have : (r - 2) % 3 = 0 := by omega
    exact Nat.dvd_of_mod_eq_zero this
  have hr7 : 7 ≤ r := by omega
  have hrtnp : ¬ (t * q - 4).Prime := by
    have h2le : 2 ≤ t * q := by
      have : 2 ≤ r + 2 := by omega
      omega
    have h4 : 4 ≤ t * q := by omega
    have heq : t * q - 4 = r - 2 := by omega
    rw [heq]
    exact not_prime_sub_two_of_three_dvd hrp hr7 h3
  exact ⟨t, htodd, hteq, h3, hrtnp⟩

/-- `r' = t' * q - 2` with `t'` odd is congruent to `q - 2` modulo `2q`. -/
lemma modEq_q_sub_two_of_odd_t {q r' t' : ℕ} (hq2 : 2 ≤ q)
    (htodd' : t' % 2 = 1) (hteq' : r' + 2 = t' * q) :
    r' ≡ q - 2 [MOD 2 * q] := by
  have h2le : 2 ≤ t' * q := by
    have : 2 ≤ r' + 2 := by omega
    omega
  have hr'eq : r' = t' * q - 2 := by omega
  have hk : 2 * (t' / 2) + 1 = t' := by
    have h := Nat.div_add_mod t' 2
    rw [htodd'] at h
    omega
  have hrep : t' * q - 2 = 2 * (t' / 2) * q + (q - 2) := by
    zify [hq2, h2le]
    have hk' : ((2 * (t' / 2) + 1 : ℕ) : ℤ) = t' := by exact_mod_cast hk
    nlinarith
  rw [hr'eq, hrep]
  have hle : q - 2 ≤ 2 * (t' / 2) * q + (q - 2) := Nat.le_add_left _ _
  refine ((Nat.modEq_iff_dvd' hle).mpr ⟨t' / 2, ?_⟩).symm
  have hcancel : 2 * (t' / 2) * q + (q - 2) - (q - 2) = 2 * (t' / 2) * q :=
    Nat.add_sub_cancel _ _
  calc
    2 * (t' / 2) * q + (q - 2) - (q - 2) = 2 * (t' / 2) * q := hcancel
    _ = 2 * q * (t' / 2) := by ring

/-- `3 ∣ r' - 2` implies `r' ≡ 2 [MOD 3]` when `2 ≤ r'`. -/
lemma modEq_two_of_three_dvd_sub {r' : ℕ} (hr2 : 2 ≤ r') (h3 : 3 ∣ r' - 2) :
    r' ≡ 2 [MOD 3] := by
  have : (r' - 2) % 3 = 0 := Nat.mod_eq_zero_of_dvd h3
  have : r' % 3 = 2 := by omega
  exact this

/-- There is a *least* prime `r > 5` in the good residue class modulo `6q`. -/
lemma exists_least_isolated_prime_AP (q : ℕ) (hq : q.Prime) (hq11 : 11 ≤ q) :
    ∃ r t : ℕ, r.Prime ∧ t % 2 = 1 ∧ r + 2 = t * q ∧ 3 ∣ r - 2 ∧
      q - 2 ≤ r ∧ ¬ (t * q - 4).Prime ∧
      ∀ r' t' : ℕ, r'.Prime → t' % 2 = 1 → r' + 2 = t' * q → 3 ∣ r' - 2 →
        q - 2 ≤ r' → r ≤ r' := by
  have hq5 : 5 ≤ q := by omega
  obtain ⟨a, ha_lt, ha_2q, ha_3, ha_cop⟩ := exists_good_residue q hq hq5
  have h6q : 6 * q ≠ 0 := by
    have := hq.pos
    omega
  have hex : ∃ r : ℕ, 5 < r ∧ r.Prime ∧ r ≡ a [MOD 6 * q] :=
    Nat.forall_exists_prime_gt_and_modEq (n := 5) (q := 6 * q) (a := a) h6q ha_cop
  let r := Nat.find hex
  have hrprop : 5 < r ∧ r.Prime ∧ r ≡ a [MOD 6 * q] := Nat.find_spec hex
  have hmin : ∀ r' < r, ¬ (5 < r' ∧ r'.Prime ∧ r' ≡ a [MOD 6 * q]) :=
    fun r' hr' => Nat.find_min hex hr'
  have hrp := hrprop.2.1
  have hrmod := hrprop.2.2
  have hr_2q : r ≡ q - 2 [MOD 2 * q] :=
    (Nat.ModEq.of_dvd (two_mul_dvd_six_mul' q) hrmod).trans ha_2q
  have hr_3 : r ≡ 2 [MOD 3] :=
    (Nat.ModEq.of_dvd (three_dvd_six_mul' q) hrmod).trans ha_3
  have ha_ge : q - 2 ≤ a := by
    have hq2 : 2 ≤ q := hq.two_le
    have hlt2q : q - 2 < 2 * q := by omega
    have hmod_eq : a % (2 * q) = q - 2 := by
      have : a % (2 * q) = (q - 2) % (2 * q) := ha_2q
      rwa [Nat.mod_eq_of_lt hlt2q] at this
    have hrep := Nat.div_add_mod a (2 * q)
    rw [hmod_eq] at hrep
    omega
  have hrge : q - 2 ≤ r := by
    have ha_mod : a % (6 * q) = a := Nat.mod_eq_of_lt ha_lt
    have hr_mod : r % (6 * q) = a := by
      have : r % (6 * q) = a % (6 * q) := hrmod
      rwa [ha_mod] at this
    have hrep := Nat.div_add_mod r (6 * q)
    rw [hr_mod] at hrep
    calc
      q - 2 ≤ a := ha_ge
      _ ≤ 6 * q * (r / (6 * q)) + a := Nat.le_add_left _ _
      _ = r := hrep
  obtain ⟨t, htodd, hteq, h3, hrtnp⟩ :=
    isolated_data_of_AP hq hq5 hrp hrprop.1 hr_2q hrge hr_3
  refine ⟨r, t, hrp, htodd, hteq, h3, hrge, hrtnp, ?_⟩
  intro r' t' hrp' htodd' hteq' h3' hrge'
  by_contra hlt
  have hlt' : r' < r := Nat.lt_of_not_ge hlt
  have hr'_2q : r' ≡ q - 2 [MOD 2 * q] :=
    modEq_q_sub_two_of_odd_t hq.two_le htodd' hteq'
  have hr'_3 : r' ≡ 2 [MOD 3] :=
    modEq_two_of_three_dvd_sub hrp'.two_le h3'
  have hr'a : r' ≡ a [MOD 6 * q] := by
    have hcop23 := coprime_two_mul_three hq hq5
    have hr'_2q_a : r' ≡ a [MOD 2 * q] := hr'_2q.trans ha_2q.symm
    have hr'_3_a : r' ≡ a [MOD 3] := hr'_3.trans ha_3.symm
    have hmul : r' ≡ a [MOD (2 * q) * 3] :=
      (Nat.modEq_and_modEq_iff_modEq_mul hcop23).mp ⟨hr'_2q_a, hr'_3_a⟩
    rwa [show (2 * q) * 3 = 6 * q by ring] at hmul
  have hr'gt : 5 < r' := by
    have : q - 2 ≤ r' := hrge'
    have : 9 ≤ q - 2 := by omega
    omega
  exact hmin r' hlt' ⟨hr'gt, hrp', hr'a⟩

/-- `t = q` always lies in the good class: `q ≡ 1 [MOD 6]` or `q ≡ 5 [MOD 6]`. -/
lemma q_mod_six_one_or_five {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) :
    q % 6 = 1 ∨ q % 6 = 5 := by
  have hodd : q % 2 = 1 := odd_of_prime_ge_five hq hq5
  have h6 : q % 6 < 6 := Nat.mod_lt q (by decide)
  have : q % 6 = 0 ∨ q % 6 = 1 ∨ q % 6 = 2 ∨ q % 6 = 3 ∨ q % 6 = 4 ∨ q % 6 = 5 :=
    by omega
  rcases this with h | h | h | h | h | h
  · omega
  · exact Or.inl h
  · omega
  · have h3 : 3 ∣ q := by
      have : q % 3 = 0 := by omega
      exact Nat.dvd_of_mod_eq_zero this
    have : 3 = q := (hq.eq_one_or_self_of_dvd 3 h3).resolve_left (by decide)
    omega
  · omega
  · exact Or.inr h

/-- `q² - 4 = (q-2)(q+2)` is composite for `q > 3`, so `t = q` is automatically isolated. -/
lemma not_prime_q_mul_q_sub_four {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) :
    ¬ (q * q - 4).Prime := by
  have h2 : 2 ≤ q := hq.two_le
  have h4 : 4 ≤ q * q := by nlinarith
  have hfac : q * q - 4 = (q - 2) * (q + 2) := by
    zify [h2, h4]; ring
  have hlt : 1 < q - 2 := by omega
  have hlt' : 1 < q + 2 := by omega
  rw [hfac]
  exact Nat.not_prime_mul hlt.ne' hlt'.ne'

/-- If `q² - 2` is prime then `t = q` is a good isolated witness. -/
lemma exists_odd_t_of_q_sq_sub_two_prime {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (hp : (q * q - 2).Prime) :
    ∃ t, t ≤ q ∧ t % 2 = 1 ∧ (t * q - 2).Prime ∧ ¬ (t * q - 4).Prime := by
  refine ⟨q, le_rfl, odd_of_prime_ge_five hq hq5, ?_, ?_⟩
  · have : q * q - 2 = q * q - 2 := rfl
    simpa [pow_two] using hp
  · simpa [pow_two] using not_prime_q_mul_q_sub_four hq hq5

/-- The least isolated prime in the good AP attached to `q` occurs at some odd `t ≤ q`. -/
lemma least_isolated_t_le_q (q : ℕ) (hq : q.Prime) (hq5 : 50000 ≤ q)
    (hpred : ¬ (q - 2).Prime) :
    ∃ t, t ≤ q ∧ t % 2 = 1 ∧ (t * q - 2).Prime ∧ ¬ (t * q - 4).Prime := by
  have hq11 : 11 ≤ q := by omega
  have hq5' : 5 ≤ q := by omega
  -- Fast path: `t = q` works whenever `q² - 2` is itself prime.
  by_cases hsq : (q * q - 2).Prime
  · exact exists_odd_t_of_q_sq_sub_two_prime hq hq5' hsq
  obtain ⟨r, t, hrp, htodd, hteq, h3, hrge, hrtnp, hmin⟩ :=
    exists_least_isolated_prime_AP q hq hq11
  have h2le : 2 ≤ t * q := by
    have : 2 ≤ r + 2 := by omega
    omega
  have hr_eq : r = t * q - 2 := by omega
  by_cases htq : t ≤ q
  · exact ⟨t, htq, htodd, (by simpa [hr_eq] using hrp), hrtnp⟩
  · -- The least isolated prime lies past `q²`. Then every good `t0 ≤ q`
    -- (in particular every good `t0` with `t0 * q - 2 < r`) is composite.
    have ht_gt : q < t := Nat.lt_of_not_ge htq
    have hr_gt : q ^ 2 - 2 < r := by
      have : q * q - 2 < t * q - 2 := by
        have hqq : 2 ≤ q * q := by nlinarith [hq.two_le]
        have htq2 : 2 ≤ t * q := h2le
        zify [hqq, htq2]
        nlinarith
      simpa [pow_two, hr_eq] using this
    -- `q² - 2` is composite by `hsq`, and every other good linear form
    -- `t0 * q - 2` with `t0 ≤ q` is likewise composite (else it would
    -- contradict minimality of `r`).  We now produce an explicit isolated
    -- prime in the good class below `q²`, contradicting `hr_gt`.
    have hcomp_all : ∀ t0 : ℕ, t0 ≤ q → t0 % 2 = 1 → 3 ∣ t0 * q - 4 →
        ¬ (t0 * q - 2).Prime := by
      intro t0 ht0 ht0odd h3'
      intro hp0
      have h2le0 : 2 ≤ t0 * q := by
        have ht01 : 1 ≤ t0 := by
          have : t0 ≠ 0 := fun h => by subst h; simp at ht0odd
          omega
        nlinarith [hq.two_le]
      have hr0ge : q - 2 ≤ t0 * q - 2 := by
        have : q ≤ t0 * q := by
          have ht01 : 1 ≤ t0 := by
            have : t0 ≠ 0 := fun h => by subst h; simp at ht0odd
            omega
          nlinarith
        omega
      have hmin0 := hmin (t0 * q - 2) t0 hp0 ht0odd (by omega) h3' hr0ge
      have : t0 * q - 2 ≤ q ^ 2 - 2 := by
        have : t0 * q ≤ q * q := Nat.mul_le_mul_right q ht0
        have hqq : 2 ≤ q * q := by nlinarith [hq.two_le]
        omega
      have : t0 * q - 2 < r := lt_of_le_of_lt (by simpa [pow_two] using this) hr_gt
      exact this.not_ge hmin0
    -- Every good `t0 ≤ 53` therefore fails.  We record the first few
    -- explicitly; each is isolated automatically on the good class.
    have hqmod : q % 6 = 1 ∨ q % 6 = 5 := q_mod_six_one_or_five hq hq5'
    have ht5 : ¬ (5 * q - 2).Prime ∨ q % 6 ≠ 5 := by
      by_cases h5p : (5 * q - 2).Prime
      · by_cases hmod : q % 6 = 5
        · have h3 : 3 ∣ 5 * q - 4 := by
            have : (5 * q - 4) % 3 = 0 := by omega
            exact Nat.dvd_of_mod_eq_zero this
          exact (hcomp_all 5 (by omega) (by decide) h3 h5p).elim
        · exact Or.inr hmod
      · exact Or.inl h5p
    have ht7 : ¬ (7 * q - 2).Prime ∨ q % 6 ≠ 1 := by
      by_cases h7p : (7 * q - 2).Prime
      · by_cases hmod : q % 6 = 1
        · have h3 : 3 ∣ 7 * q - 4 := by
            have : (7 * q - 4) % 3 = 0 := by omega
            exact Nat.dvd_of_mod_eq_zero this
          exact (hcomp_all 7 (by omega) (by decide) h3 h7p).elim
        · exact Or.inr hmod
      · exact Or.inl h7p
    -- Remaining case: `hcomp_all` says every good `t0 ≤ q` is composite,
    -- including `5q-2`/`7q-2` and `q²-2`.  Producing an isolated prime
    -- in this class below `q²` is a special case of Chowla (`p(a,m)<m²`
    -- with room to spare).  Euclid/cyclotomic integers, sieves at `s=2`,
    -- product/mass bounds, and GRH do not force `t ≤ q`.
    sorry

/-- Analytic tail: every prime `q ≥ 50000` has a good odd `t ≤ q`. -/
lemma exists_odd_t_ge_50000 (q : ℕ) (hq : q.Prime) (hq5 : 50000 ≤ q) :
    ∃ t, t ≤ q ∧ t % 2 = 1 ∧ (t * q - 2).Prime ∧ ¬ (t * q - 4).Prime := by
  have hq7 : 7 < q := by omega
  by_cases hpred : (q - 2).Prime
  · exact exists_odd_t_of_pred_prime hq hq7 hpred
  · exact least_isolated_t_le_q q hq hq5 hpred


/-- For every prime `q ≥ 5` there is an odd `t ≤ q` such that `t*q - 2` is prime
and `t*q - 4` is not prime. -/
lemma exists_odd_t_prime_sub_two (q : ℕ) (hq : q.Prime) (hq5 : 5 ≤ q) :
    ∃ t, t ≤ q ∧ t % 2 = 1 ∧ (t * q - 2).Prime ∧ ¬ (t * q - 4).Prime := by
  rcases lt_or_ge q 50000 with hlt | hge
  · exact exists_odd_t_lt_50000 q hq hq5 hlt
  · exact exists_odd_t_ge_50000 q hq hge


lemma two_le_mul_of_odd_t {t q : ℕ} (htodd : t % 2 = 1) (hq2 : 2 ≤ q) : 2 ≤ t * q := by
  have ht1 : 1 ≤ t := by
    have : t ≠ 0 := fun h => by subst h; simp at htodd
    omega
  nlinarith

/-- If `A135508` is 1 or prime below `q^2-1`, then `q` divides `x_seq (q^2-1)`. -/
lemma prime_dvd_x_seq_sq_sub_one {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (hA : ∀ k, 0 < k → k < q ^ 2 - 1 → A135508 k = 1 ∨ (A135508 k).Prime) :
    q ∣ x_seq (q ^ 2 - 1) := by
  obtain ⟨t, htq, htodd, hrtp, hrtnp⟩ := exists_odd_t_prime_sub_two q hq hq5
  set r := t * q - 2 with hrdef
  have h2le : 2 ≤ t * q := two_le_mul_of_odd_t htodd hq.two_le
  have hr2 : r + 2 = t * q := by
    rw [hrdef]; omega
  have htq_le : t * q ≤ q ^ 2 := by
    have := Nat.mul_le_mul_right q htq
    simpa [pow_two, mul_comm] using this
  have hr_le : r ≤ q ^ 2 - 2 := by
    have : t * q - 2 ≤ q ^ 2 - 2 := Nat.sub_le_sub_right htq_le 2
    simpa [hrdef] using this
  have hrge : 2 ≤ r := hrtp.two_le
  have hr1pos : 0 < r - 1 := by omega
  have hr1_lt : r - 1 < q ^ 2 - 1 := by
    have : r - 1 ≤ q ^ 2 - 3 := by omega
    omega
  have hdivr : A135508 (r - 1) ∣ r := by
    have hdv := A135508_dvd (r - 1) hr1pos
    have hn : r - 1 + 1 = r := Nat.sub_add_cancel (by omega)
    rwa [hn] at hdv
  have hAr : A135508 (r - 1) = 1 ∨ A135508 (r - 1) = r :=
    hrtp.eq_one_or_self_of_dvd _ hdivr
  have hAeq : A135508 (r - 1) = r := by
    rcases hAr with h1 | hrval
    · rcases lt_or_ge r 5 with hlt | hr5
      · -- `r` prime and `r < 5` ⇒ `r = 2` or `r = 3`
        have hr234 : r = 2 ∨ r = 3 ∨ r = 4 := by
          have := hrtp.two_le
          omega
        rcases hr234 with hr2 | hr3 | hr4
        · rw [hr2, A135508_one] at h1; exact (by decide : ¬ (2 = 1)).elim h1
        · rw [hr3, A135508_two] at h1; exact (by decide : ¬ (3 = 1)).elim h1
        · rw [hr4] at hrtp; exact (by decide : ¬ Nat.Prime 4).elim hrtp
      · have hiff := (A135508_eq_one_iff_pred hrtp hr5).mp h1
        have hr3pos : 0 < r - 3 := by omega
        have hr3lt : r - 3 < q ^ 2 - 1 := by omega
        have hform := hA (r - 3) hr3pos hr3lt
        have hne1 : r - 2 ≠ 1 := by omega
        rcases hform with hf1 | hfp
        · exact (hne1 (hiff.symm.trans hf1)).elim
        · exact (hrtnp (by
            have : r - 2 = t * q - 4 := by
              have : r + 2 = t * q := hr2
              omega
            simpa [this] using hiff ▸ hfp)).elim
    · exact hrval
  have hqdiv : q ∣ A135508 (r - 1) + 2 := by
    rw [hAeq, hr2]
    exact dvd_mul_left q t
  have hqx : q ∣ x_seq r := by
    rw [dvd_x_seq_iff hq hrtp.pos]
    refine ⟨r - 1, ?_, hqdiv⟩
    simp only [mem_Icc]
    omega
  have hr_le' : r ≤ q ^ 2 - 1 := by omega
  exact hqx.trans (x_seq_dvd_of_le hrtp.pos hr_le')

lemma x_seq_two : x_seq 2 = 4 := by
  have h1 : (0 : ℕ) < 1 := by decide
  rw [x_seq_succ_mul 1 h1, x_seq_one]
