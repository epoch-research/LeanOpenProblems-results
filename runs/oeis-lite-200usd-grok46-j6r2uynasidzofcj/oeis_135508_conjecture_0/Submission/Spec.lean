import FormalConjectures.Util.ProblemImports

open Nat Finset

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/--
The auxiliary sequence $x(n)$, where $x(1)=1$ and $x(n) = 2 \cdot x(n-1) + \mathrm{lcm}(x(n-1), n)$ for $n > 1$.
`x_seq n` corresponds to the OEIS term $x(n)$.
This definition is set up for `n : ℕ` where $n=0$ and $n=1$ are base cases for $x(0)$ and $x(1)$.
Note: Mathlib's `lcm` is `Nat.lcm`.
-/
def x_seq : ℕ → ℕ
| 0 => 0
| 1 => 1
| n + 1 => 2 * (x_seq n) + Nat.lcm (x_seq n) (n + 1)

/--
A135508: $a(n) = x(n+1)/x(n) - 2$ where $x(1)=1$ and $x(n) = 2*x(n-1) + \operatorname{lcm}(x(n-1),n)$.
-/
def A135508 (n : ℕ) : ℕ :=
  if n = 0 then 0
  else
    -- We rely on the fact that x_seq n divides x_seq (n+1), which is a known property of the sequence.
    -- Since n : ℕ, the division is integer division.
    let x_n_plus_1 := x_seq (n + 1)
    let x_n := x_seq n

    -- The fact that x_seq n divides x_seq (n+1) means that the division is exact.
    -- The final result is always a natural number.
    (x_n_plus_1 / x_n) - 2

/-! ### Basic properties of `x_seq` -/

lemma x_seq_zero : x_seq 0 = 0 := rfl

lemma x_seq_one : x_seq 1 = 1 := rfl

lemma x_seq_succ (n : ℕ) (hn : 0 < n) :
    x_seq (n + 1) = 2 * x_seq n + Nat.lcm (x_seq n) (n + 1) := by
  match n, hn with
  | n + 1, _ => rfl

lemma x_seq_pos : ∀ n, 0 < n → 0 < x_seq n
  | 1, _ => by simp [x_seq]
  | n + 2, _ => by
    rw [x_seq_succ _ (Nat.succ_pos _)]
    have hpos : 0 < x_seq (n + 1) := x_seq_pos (n + 1) (Nat.succ_pos _)
    have : 0 < 2 * x_seq (n + 1) := Nat.mul_pos (by decide) hpos
    exact Nat.add_pos_left this _

lemma lcm_eq_mul_div_gcd (a b : ℕ) : Nat.lcm a b = a * (b / Nat.gcd a b) := by
  rw [Nat.lcm_eq_mul_div, Nat.mul_div_assoc _ (Nat.gcd_dvd_right a b)]

lemma x_seq_succ_mul (n : ℕ) (hn : 0 < n) :
    x_seq (n + 1) = x_seq n * (2 + (n + 1) / Nat.gcd (x_seq n) (n + 1)) := by
  rw [x_seq_succ n hn, lcm_eq_mul_div_gcd]
  ring

lemma x_seq_dvd_succ (n : ℕ) (hn : 0 < n) : x_seq n ∣ x_seq (n + 1) := by
  rw [x_seq_succ_mul n hn]
  exact dvd_mul_right _ _

lemma A135508_eq (n : ℕ) (hn : 0 < n) :
    A135508 n = (n + 1) / Nat.gcd (x_seq n) (n + 1) := by
  have hx : 0 < x_seq n := x_seq_pos n hn
  unfold A135508
  simp only [hn.ne']
  rw [x_seq_succ_mul n hn, Nat.mul_div_cancel_left _ hx]
  simp

lemma x_seq_succ_A (n : ℕ) (hn : 0 < n) :
    x_seq (n + 1) = x_seq n * (A135508 n + 2) := by
  rw [x_seq_succ_mul n hn, A135508_eq n hn, add_comm]

lemma A135508_dvd (n : ℕ) (hn : 0 < n) : A135508 n ∣ n + 1 := by
  rw [A135508_eq n hn]
  exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_right _ _)

lemma A135508_mul_gcd (n : ℕ) (hn : 0 < n) :
    A135508 n * Nat.gcd (x_seq n) (n + 1) = n + 1 := by
  rw [A135508_eq n hn]
  exact Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)

lemma A135508_le (n : ℕ) (hn : 0 < n) : A135508 n ≤ n + 1 :=
  Nat.le_of_dvd (by omega) (A135508_dvd n hn)

lemma A135508_pos (n : ℕ) (hn : 0 < n) : 0 < A135508 n := by
  have h := A135508_mul_gcd n hn
  have : 0 < A135508 n * Nat.gcd (x_seq n) (n + 1) := by
    rw [h]; omega
  exact Nat.pos_of_mul_pos_right this

lemma x_seq_eq_prod : ∀ n, 0 < n →
    x_seq n = ∏ k ∈ Icc 1 (n - 1), (A135508 k + 2)
  | 1, _ => by simp [x_seq]
  | n + 2, _ => by
    have hpos : 0 < n + 1 := Nat.succ_pos _
    rw [x_seq_succ_A (n + 1) hpos, x_seq_eq_prod (n + 1) hpos]
    simp only [add_tsub_cancel_right, show n + 2 - 1 = n + 1 by omega]
    have hI : Icc 1 (n + 1) = Icc 1 n ∪ {n + 1} := by
      ext k
      simp only [mem_union, mem_Icc, mem_singleton]
      omega
    rw [hI, prod_union]
    · simp
    · simp only [disjoint_singleton_right, mem_Icc]; omega

lemma A135508_eq_one_or_self_of_prime {p : ℕ} (hp : p.Prime) :
    A135508 (p - 1) = 1 ∨ A135508 (p - 1) = p := by
  have hp2 : 2 ≤ p := hp.two_le
  have hpos : 0 < p - 1 := by omega
  have hdiv := A135508_dvd (p - 1) hpos
  have : p - 1 + 1 = p := by omega
  rw [this] at hdiv
  exact hp.eq_one_or_self_of_dvd _ hdiv

lemma dvd_x_seq_iff {p n : ℕ} (hp : p.Prime) (hn : 0 < n) :
    p ∣ x_seq n ↔ ∃ k ∈ Icc 1 (n - 1), p ∣ A135508 k + 2 := by
  rw [x_seq_eq_prod n hn]
  exact hp.prime.dvd_finset_prod_iff _

lemma A135508_eq_one_iff_dvd {p : ℕ} (hp : p.Prime) :
    A135508 (p - 1) = 1 ↔ p ∣ x_seq (p - 1) := by
  have hp2 : 2 ≤ p := hp.two_le
  have hpos : 0 < p - 1 := by omega
  have hpval : p - 1 + 1 = p := by omega
  constructor
  · intro h
    have heq : Nat.gcd (x_seq (p - 1)) p = p := by
      have hmul := A135508_mul_gcd (p - 1) hpos
      rw [h, hpval, one_mul] at hmul
      exact hmul
    have hgd := Nat.gcd_dvd_left (x_seq (p - 1)) p
    rwa [heq] at hgd
  · intro hdiv
    rw [A135508_eq (p - 1) hpos, hpval, Nat.gcd_eq_right hdiv, Nat.div_self hp.pos]

lemma A135508_add_two_le (n : ℕ) (hn : 0 < n) : A135508 n + 2 ≤ n + 3 := by
  have := A135508_le n hn
  omega

lemma A135508_add_two_ge (n : ℕ) (hn : 0 < n) : 3 ≤ A135508 n + 2 := by
  have := A135508_pos n hn
  omega

/-- For a prime `p ≥ 5`, `A135508 (p-1) = 1` if and only if `A135508 (p-3) = p-2`. -/
lemma A135508_eq_one_iff_pred {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) :
    A135508 (p - 1) = 1 ↔ A135508 (p - 3) = p - 2 := by
  have hp2 : 2 ≤ p := hp.two_le
  have hpos : 0 < p - 1 := by omega
  rw [A135508_eq_one_iff_dvd hp, dvd_x_seq_iff hp hpos]
  have hI : Icc 1 (p - 1 - 1) = Icc 1 (p - 2) := by
    simp only [show p - 1 - 1 = p - 2 by omega]
  rw [hI]
  constructor
  · intro ⟨k, hk, hdv⟩
    simp only [mem_Icc] at hk
    have hkpos : 0 < k := by omega
    have hle : A135508 k + 2 ≤ p + 1 := by
      have := A135508_add_two_le k hkpos
      omega
    have hge : 3 ≤ A135508 k + 2 := A135508_add_two_ge k hkpos
    obtain ⟨t, ht⟩ := hdv
    -- `ht : A135508 k + 2 = p * t`
    have ht1 : t = 1 := by
      have hle' : p * t ≤ p + 1 := by
        rw [← ht]; exact hle
      have htpos : 0 < t := by
        have : 0 < p * t := by
          rw [← ht]; omega
        exact Nat.pos_of_mul_pos_left this
      have : t ≤ 1 := by
        by_contra ht1
        have ht2 : 2 ≤ t := by omega
        have : p * 2 ≤ p * t := Nat.mul_le_mul_left p ht2
        omega
      omega
    have heq : A135508 k + 2 = p := by
      rw [ht1, mul_one] at ht
      exact ht
    have hAeq : A135508 k = p - 2 := by omega
    have hdivk : p - 2 ∣ k + 1 := by
      have hdk := A135508_dvd k hkpos
      rwa [hAeq] at hdk
    obtain ⟨s, hs⟩ := hdivk
    -- `hs : k + 1 = (p - 2) * s`
    have hs1 : s = 1 := by
      have hle'' : (p - 2) * s ≤ p - 1 := by
        rw [← hs]; omega
      have hspos : 0 < s := by
        have : 0 < (p - 2) * s := by
          rw [← hs]; omega
        exact Nat.pos_of_mul_pos_left this
      have : s ≤ 1 := by
        by_contra hs1
        have hs2 : 2 ≤ s := by omega
        have : (p - 2) * 2 ≤ (p - 2) * s := Nat.mul_le_mul_left _ hs2
        omega
      omega
    have hk1 : k + 1 = p - 2 := by
      rw [hs1, mul_one] at hs
      exact hs
    have hk : k = p - 3 := by omega
    rwa [hk] at hAeq
  · intro h
    refine ⟨p - 3, ?_, ?_⟩
    · simp only [mem_Icc]; omega
    · rw [h]
      have : p - 2 + 2 = p := by omega
      rw [this]

lemma A135508_eq_self_of_prime {p : ℕ} (hp : p.Prime) (hne : A135508 (p - 1) ≠ 1) :
    A135508 (p - 1) = p :=
  (A135508_eq_one_or_self_of_prime hp).resolve_left hne

/--
Conjecture: For prime p such that p-2 is not a prime, a(p-1) = p.
p-2 in natural numbers is $\max(0, p-2)$.
A prime $p$ such that $p-2$ is not a prime means $p$ is not the larger element of a twin prime pair, except for $p=3$ where $p-2=1$ (not prime) and $p=2$ where $p-2=0$ (not prime).
-/
lemma x_seq_dvd_of_le {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) : x_seq a ∣ x_seq b := by
  obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hab
  rw [hk]
  clear hab hk b
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show a + (k + 1) = (a + k) + 1 by omega]
    exact ih.trans (x_seq_dvd_succ (a + k) (by omega))

lemma A135508_one : A135508 1 = 2 := by
  have hpos : (0 : ℕ) < 1 := by decide
  rw [A135508_eq 1 hpos]
  simp [x_seq_one]

lemma A135508_two : A135508 2 = 3 := by
  have hpos : (0 : ℕ) < 2 := by decide
  rw [A135508_eq 2 hpos]
  have hx2 : x_seq 2 = 4 := by
    have h1 : (0 : ℕ) < 1 := by decide
    rw [x_seq_succ_mul 1 h1, x_seq_one]
    decide
  rw [hx2]
  decide

/-- If `A135508 k` is `1` or prime for all `k < p-1`, the conjecture holds at `p`. -/
lemma A135508_ne_composite_implies_conjecture {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (hnp : ¬ (p - 2).Prime)
    (hA : ∀ k, 0 < k → k < p - 1 → A135508 k = 1 ∨ (A135508 k).Prime) :
    A135508 (p - 1) = p := by
  apply A135508_eq_self_of_prime hp
  intro h1
  have hpred : A135508 (p - 3) = p - 2 := (A135508_eq_one_iff_pred hp hp5).mp h1
  have hk : p - 3 < p - 1 := by omega
  have hkpos : 0 < p - 3 := by omega
  have hform := hA (p - 3) hkpos hk
  have hne1 : p - 2 ≠ 1 := by omega
  rcases hform with h1' | hp'
  · exact hne1 (hpred.symm.trans h1')
  · exact hnp (hpred ▸ hp')

