  have hx : x * x % 4 = (x % 4) * (x % 4) % 4 := Int.mul_emod _ _ _
  rcases this with h | h | h | h <;> simp [hx, h]

lemma sq_mod_eight (x : ℤ) : x * x % 8 = 0 ∨ x * x % 8 = 1 ∨ x * x % 8 = 4 := by
  have : x % 8 = 0 ∨ x % 8 = 1 ∨ x % 8 = 2 ∨ x % 8 = 3 ∨
         x % 8 = 4 ∨ x % 8 = 5 ∨ x % 8 = 6 ∨ x % 8 = 7 := by omega
  have hx : x * x % 8 = (x % 8) * (x % 8) % 8 := Int.mul_emod _ _ _
  rcases this with h | h | h | h | h | h | h | h <;> simp [hx, h]

lemma sq_mod_twenty_four (z : ℤ) :
    z * z % 24 = 0 ∨ z * z % 24 = 1 ∨ z * z % 24 = 4 ∨
    z * z % 24 = 9 ∨ z * z % 24 = 12 ∨ z * z % 24 = 13 ∨
    z * z % 24 = 16 := by
  have : z % 24 = 0 ∨ z % 24 = 1 ∨ z % 24 = 2 ∨ z % 24 = 3 ∨
         z % 24 = 4 ∨ z % 24 = 5 ∨ z % 24 = 6 ∨ z % 24 = 7 ∨
         z % 24 = 8 ∨ z % 24 = 9 ∨ z % 24 = 10 ∨ z % 24 = 11 ∨
         z % 24 = 12 ∨ z % 24 = 13 ∨ z % 24 = 14 ∨ z % 24 = 15 ∨
         z % 24 = 16 ∨ z % 24 = 17 ∨ z % 24 = 18 ∨ z % 24 = 19 ∨
         z % 24 = 20 ∨ z % 24 = 21 ∨ z % 24 = 22 ∨ z % 24 = 23 := by omega
  rcases this with t | t | t | t | t | t | t | t | t | t | t | t |
                   t | t | t | t | t | t | t | t | t | t | t | t <;>
