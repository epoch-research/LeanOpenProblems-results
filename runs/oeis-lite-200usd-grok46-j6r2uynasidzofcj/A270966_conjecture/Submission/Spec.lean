lemma form_mul_int (u v s t : ℤ) :
    (u * u + 24 * v * v) * (s * s + 24 * t * t) =
      (u * s + 24 * v * t) * (u * s + 24 * v * t) +
        24 * (u * t - v * s) * (u * t - v * s) := by ring

lemma represented_mul {A B : ℕ}
    (hA : ∃ u v : ℕ, u * u + 24 * (v * v) = A)
    (hB : ∃ s t : ℕ, s * s + 24 * (t * t) = B) :
    ∃ u v : ℕ, u * u + 24 * (v * v) = A * B := by
  obtain ⟨u, v, hu⟩ := hA
  obtain ⟨s, t, hs⟩ := hB
  let U : ℤ := (u : ℤ) * s + 24 * v * t
  let V : ℤ := (u : ℤ) * t - v * s
  have hu' : (u : ℤ) * u + 24 * v * v = A := by
    have : (u : ℤ) * u + 24 * (v * v) = A := by exact_mod_cast hu
    convert this using 1; ring
  have hs' : (s : ℤ) * s + 24 * t * t = B := by
    have : (s : ℤ) * s + 24 * (t * t) = B := by exact_mod_cast hs
    convert this using 1; ring
  have hUV : U * U + 24 * V * V = (A : ℤ) * B := by
    simpa [U, V, hu', hs'] using (form_mul_int (u : ℤ) v s t).symm
  refine ⟨U.natAbs, V.natAbs, ?_⟩
  have hU : 0 ≤ U * U := mul_self_nonneg U
  have hVnonneg : 0 ≤ (24 : ℤ) * V * V := by nlinarith [mul_self_nonneg V]
  have hsum : (U * U + 24 * V * V).natAbs =
      (U * U).natAbs + (24 * V * V).natAbs :=
    Int.natAbs_add_of_nonneg hU hVnonneg
  have h24 : (24 * V * V : ℤ).natAbs = 24 * (V.natAbs * V.natAbs) := by
    have : (24 * V * V : ℤ) = (24 : ℤ) * (V * V) := by ring
    rw [this, Int.natAbs_mul, Int.natAbs_mul]; ring
  have hL : U.natAbs * U.natAbs + 24 * (V.natAbs * V.natAbs) =
      (U * U + 24 * V * V).natAbs := by
    rw [hsum, Int.natAbs_mul U U, h24]
  have hR : ((A : ℤ) * B).natAbs = A * B := by simp [Int.natAbs_mul]
  have := congrArg Int.natAbs hUV
  rw [← hL, hR] at this
  exact this

