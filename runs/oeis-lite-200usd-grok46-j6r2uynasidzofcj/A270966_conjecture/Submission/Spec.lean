/-! ### Automatic goodness of small `M` and two-prime existence -/

lemma twenty_four_Mx_mod (n x : ℕ) (_hx : x * x ≤ n) :
    (24 * (n - x * x) + 1) % 24 = 1 := by
  have : (24 * (n - x * x) + 1) % 24 = 1 % 24 := by
    rw [Nat.add_mod, Nat.mul_mod]
    simp
  simpa using this

lemma isGood_of_lt_169 {N : ℕ} (h24 : N % 24 = 1) (hN : N < 169) :
    A270966Rep.IsGoodNat N := by
  apply isGood_of_no_small_bad h24
  intro q hq hb
  have hqP : Nat.Prime q := Nat.prime_of_mem_primeFactors hq
  have hq13 : 13 ≤ q := by
    unfold A270966Rep.IsBadPrimeRes at hb
    have : q % 24 = 13 ∨ q % 24 = 17 ∨ q % 24 = 19 ∨ q % 24 = 23 := hb
    have hq2 : 2 ≤ q := hqP.two_le
    rcases this with h | h | h | h
    · have : 13 ≤ q := by
        have hlt : q % 24 < 24 := Nat.mod_lt _ (by decide)
        omega
      exact this
    · omega
    · omega
    · omega
  have : 169 ≤ q * q := by
    have : 13 ≤ q := hq13
    nlinarith
  omega

lemma exists_pred_of_small_M {n x : ℕ}
    (hxle : x * x ≤ n) (hp : Nat.Prime (x + 1))
    (hM : 24 * (n - x * x) + 1 < 169) :
    ∃ y, A270966.Pred n (if x ≤ y then (x, y) else (y, x)) := by
  apply exists_pred_of_good hxle hp
  exact isGood_of_lt_169 (twenty_four_Mx_mod n x hxle) hM

lemma ge_one_of_good_x {n x : ℕ}
    (hxle : x * x ≤ n) (hp : Nat.Prime (x + 1))
    (hg : A270966Rep.IsGoodNat (24 * (n - x * x) + 1)) :
    1 ≤ A270966 n := by
  obtain ⟨y, hy⟩ := exists_pred_of_good hxle hp hg
  set xy := if x ≤ y then (x, y) else (y, x)
  have hsum : xy.1 * xy.1 + xy.2 * xy.2 ≤ n := by
    simpa [xy] using hy.1
  exact A270966.ge_one_of_pred
    (lt_succ_of_sq_le (le_trans (Nat.le_add_right _ _) hsum))
    (lt_succ_of_sq_le (le_trans (Nat.le_add_left _ _) hsum))
    (by simpa [xy] using hy)

lemma exists_prime_in_half {n : ℕ} (hn : 4 ≤ n) :
    ∃ p : ℕ, Nat.Prime p ∧ n / 2 < p ∧ p ≤ n := by
  have h0 : n / 2 ≠ 0 := by omega
  obtain ⟨p, hp, hgt, hle⟩ := exists_prime_lt_and_le_two_mul (n / 2) h0
  refine ⟨p, hp, hgt, hle.trans (Nat.mul_div_le n 2)⟩

lemma exists_prime_x_of_ge_16 {n : ℕ} (hn : 16 ≤ n) :
    ∃ x : ℕ, Nat.Prime (x + 1) ∧ x * x ≤ n := by
  have hsq : 4 ≤ Nat.sqrt n := by
    rw [Nat.le_sqrt]
    exact hn
  obtain ⟨p, hp, _, hle⟩ := exists_prime_in_half (n := Nat.sqrt n) hsq
  have hp1 : 1 ≤ p := le_trans (by decide : (1 : ℕ) ≤ 2) hp.two_le
  refine ⟨p - 1, ?_, ?_⟩
  · rwa [Nat.sub_add_cancel hp1]
  · have hpp : p * p ≤ n := Nat.le_sqrt.mp hle
    exact le_trans (Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)) hpp

lemma exists_two_prime_x {n : ℕ} (hn : 64 ≤ n) :
    ∃ x₁ x₂ : ℕ, x₁ ≠ x₂ ∧ Nat.Prime (x₁ + 1) ∧ Nat.Prime (x₂ + 1) ∧
      x₁ * x₁ ≤ n ∧ x₂ * x₂ ≤ n := by
  have h8 : 8 ≤ Nat.sqrt n := by
    rw [Nat.le_sqrt]
    exact hn
  have h4 : 4 ≤ Nat.sqrt n / 2 := by omega
  obtain ⟨p1, hp1, hgt1, hle1⟩ := exists_prime_in_half (n := Nat.sqrt n) (by omega)
  obtain ⟨p2, hp2, hgt2, hle2⟩ := exists_prime_in_half (n := Nat.sqrt n / 2) h4
  have hp1_1 : 1 ≤ p1 := le_trans (by decide : (1 : ℕ) ≤ 2) hp1.two_le
  have hp2_1 : 1 ≤ p2 := le_trans (by decide : (1 : ℕ) ≤ 2) hp2.two_le
  refine ⟨p1 - 1, p2 - 1, ?_, ?_, ?_, ?_, ?_⟩
  · intro heq
    have : p1 = p2 := by
      have := congrArg (· + 1) heq
      simp [Nat.sub_add_cancel hp1_1, Nat.sub_add_cancel hp2_1] at this
      exact this
    have hlt : p2 ≤ Nat.sqrt n / 2 := hle2
    have hgt : Nat.sqrt n / 2 < p1 := hgt1
    omega
  · rwa [Nat.sub_add_cancel hp1_1]
  · rwa [Nat.sub_add_cancel hp2_1]
  · exact le_trans (Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)) (Nat.le_sqrt.mp hle1)
  · have hle' : p2 ≤ Nat.sqrt n := le_trans hle2 (Nat.div_le_self _ _)
    exact le_trans (Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)) (Nat.le_sqrt.mp hle')


lemma pos_of_prime_Mx {n x : ℕ}
    (hxle : x * x ≤ n) (hp : Nat.Prime (x + 1))
    (hP : Nat.Prime (24 * (n - x * x) + 1)) :
    1 ≤ A270966 n := by
  have h24 : (24 * (n - x * x) + 1) % 24 = 1 := twenty_four_Mx_mod n x hxle
  have : A270966Rep.IsGoodNat (24 * (n - x * x) + 1) := by
    refine ⟨h24, ?_⟩
    intro q hq hb
    have hqP : Nat.Prime q := Nat.prime_of_mem_primeFactors hq
    have hdiv : q ∣ 24 * (n - x * x) + 1 := Nat.dvd_of_mem_primeFactors hq
    have hqeq : q = 24 * (n - x * x) + 1 :=
      (Nat.dvd_prime hP).mp hdiv |>.resolve_left (fun h1 => hqP.ne_one h1)
    have hbad : q % 24 = 13 ∨ q % 24 = 17 ∨ q % 24 = 19 ∨ q % 24 = 23 := hb
    rw [hqeq, h24] at hbad
    exfalso
    rcases hbad with h | h | h | h <;> cases h
  exact ge_one_of_good_x hxle hp this

lemma pos_of_x1_prime_M {n : ℕ} (hn : 1 ≤ n)
    (hP : Nat.Prime (24 * n - 23)) : 1 ≤ A270966 n := by
  have hxle : (1 : ℕ) * 1 ≤ n := by omega
  have hp : Nat.Prime (1 + 1) := by decide
  have hM : 24 * (n - 1) + 1 = 24 * n - 23 := by omega
  rw [← hM] at hP
  exact pos_of_prime_Mx hxle hp hP


/-! ### Improved automatic goodness: every `N ≡ 1 (mod 24)` below `481` is good -/

lemma primeFactors_prime_sq {p : ℕ} (hp : Nat.Prime p) :
    (p * p).primeFactors = {p} := by
  rw [Nat.primeFactors_mul (Nat.Prime.ne_zero hp) (Nat.Prime.ne_zero hp),
      Nat.Prime.primeFactors hp, Finset.union_idempotent]

lemma padicValNat_prime_sq {p : ℕ} (hp : Nat.Prime p) :
    padicValNat p (p * p) = 2 := by
  have hinst : Fact (Nat.Prime p) := ⟨hp⟩
  rw [padicValNat.mul (Nat.Prime.ne_zero hp) (Nat.Prime.ne_zero hp),
      padicValNat.self hp.one_lt]

lemma isGood_sq_of_bad {p : ℕ} (hp : Nat.Prime p)
    (hb : A270966Rep.IsBadPrimeRes p) (h24 : (p * p) % 24 = 1) :
    A270966Rep.IsGoodNat (p * p) := by
  refine ⟨h24, ?_⟩
  intro q hq hqbad
  have : q = p := by
    rw [primeFactors_prime_sq hp, Finset.mem_singleton] at hq
    exact hq
  subst this
  rw [padicValNat_prime_sq hp]
  exact even_two

lemma isGood_169 : A270966Rep.IsGoodNat 169 := by
  have : (13 : ℕ) * 13 = 169 := by decide
  rw [← this]
  exact isGood_sq_of_bad (by decide) (Or.inl rfl) (by decide)

lemma isGood_289 : A270966Rep.IsGoodNat 289 := by
  have : (17 : ℕ) * 17 = 289 := by decide
  rw [← this]
  exact isGood_sq_of_bad (by decide) (Or.inr (Or.inl rfl)) (by decide)

lemma isGood_361 : A270966Rep.IsGoodNat 361 := by
  have : (19 : ℕ) * 19 = 361 := by decide
  rw [← this]
  exact isGood_sq_of_bad (by decide) (Or.inr (Or.inr (Or.inl rfl))) (by decide)

lemma isGood_of_lt_481 {N : ℕ} (h24 : N % 24 = 1) (hN : N < 481) :
    A270966Rep.IsGoodNat N := by
  rcases lt_or_ge N 169 with h169 | h169
  · exact isGood_of_lt_169 h24 h169
  rcases eq_or_ne N 169 with rfl | n169
  · exact isGood_169
  rcases eq_or_ne N 289 with rfl | n289
  · exact isGood_289
  rcases eq_or_ne N 361 with rfl | n361
  · exact isGood_361
  apply isGood_of_no_small_bad h24
  intro q hq hb
  have hqP : Nat.Prime q := Nat.prime_of_mem_primeFactors hq
  have hqN : q ∣ N := Nat.dvd_of_mem_primeFactors hq
  have hN0 : N ≠ 0 := (Nat.mem_primeFactors.mp hq).2.2
  have hNpos : 0 < N := Nat.pos_of_ne_zero hN0
  have hq13 : 13 ≤ q := by
    unfold A270966Rep.IsBadPrimeRes at hb
    have : 2 ≤ q := hqP.two_le
    rcases hb with h | h | h | h <;> omega
  by_contra hle
  have hq2N : q * q ≤ N := Nat.not_lt.mp hle
  have : q < 22 := by
    have : q * q < 481 := lt_of_le_of_lt hq2N hN
    nlinarith
  have hqlist : q = 13 ∨ q = 17 ∨ q = 19 := by
    have hqle : q ≤ 21 := by omega
    have hmod : q % 24 = q := Nat.mod_eq_of_lt (by omega)
    unfold A270966Rep.IsBadPrimeRes at hb
    rw [hmod] at hb
    rcases hb with h | h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr h)
    · omega -- q = 23 contradicts q ≤ 21
  obtain ⟨k, hk⟩ := hqN
  have hkpos : 0 < k := by
    have : 0 < q * k := by rw [← hk]; exact hNpos
    exact Nat.pos_of_mul_pos_left this
  have hb' : IsBadRes q := hb
  have hkmod : k % 24 = q % 24 := bad_mul_eq_of_sq h24 hb' hk
  rcases hqlist with rfl | rfl | rfl
  · have : k < 37 := by
      have : 13 * k < 481 := by rw [← hk]; exact hN
      omega
    have : k % 24 = 13 := hkmod
    have : k = 13 := by omega
    exact n169 (by rw [hk, this])
  · have : k < 29 := by
      have : 17 * k < 481 := by rw [← hk]; exact hN
      omega
    have : k % 24 = 17 := hkmod
    have : k = 17 := by omega
    exact n289 (by rw [hk, this])
  · have : k < 26 := by
      have : 19 * k < 481 := by rw [← hk]; exact hN
      omega
    have : k % 24 = 19 := hkmod
    have : k = 19 := by omega
    exact n361 (by rw [hk, this])

lemma exists_pred_of_M_lt_481 {n x : ℕ}
    (hxle : x * x ≤ n) (hp : Nat.Prime (x + 1))
    (hM : 24 * (n - x * x) + 1 < 481) :
    ∃ y, A270966.Pred n (if x ≤ y then (x, y) else (y, x)) := by
  apply exists_pred_of_good hxle hp
  exact isGood_of_lt_481 (twenty_four_Mx_mod n x hxle) hM

lemma pos_of_M_lt_481 {n x : ℕ}
    (hxle : x * x ≤ n) (hp : Nat.Prime (x + 1))
    (hM : 24 * (n - x * x) + 1 < 481) :
    1 ≤ A270966 n :=
  ge_one_of_good_x hxle hp (isGood_of_lt_481 (twenty_four_Mx_mod n x hxle) hM)

/-- If `n` lies in `[k^2, k^2 + 19]` with `k + 1` prime, then `a(n) ≥ 1`. -/
lemma pos_of_near_prime_sq {n k : ℕ} (hp : Nat.Prime (k + 1))
    (hle : k * k ≤ n) (hnear : n ≤ k * k + 19) :
    1 ≤ A270966 n := by
  have hM : 24 * (n - k * k) + 1 < 481 := by
    have : n - k * k ≤ 19 := Nat.sub_le_iff_le_add.mpr (by omega)
    have : 24 * (n - k * k) + 1 ≤ 24 * 19 + 1 := by
      have := Nat.mul_le_mul_left 24 this
      omega
    omega
  exact pos_of_M_lt_481 hle hp hM

lemma exists_three_prime_x {n : ℕ} (hn : 256 ≤ n) :
    ∃ x₁ x₂ x₃ : ℕ, x₁ ≠ x₂ ∧ x₁ ≠ x₃ ∧ x₂ ≠ x₃ ∧
      Nat.Prime (x₁ + 1) ∧ Nat.Prime (x₂ + 1) ∧ Nat.Prime (x₃ + 1) ∧
      x₁ * x₁ ≤ n ∧ x₂ * x₂ ≤ n ∧ x₃ * x₃ ≤ n := by
  have h16 : 16 ≤ Nat.sqrt n := by
    rw [Nat.le_sqrt]
    exact hn
  have h8 : 8 ≤ Nat.sqrt n / 2 := by omega
  have h4 : 4 ≤ Nat.sqrt n / 4 := by omega
  obtain ⟨p1, hp1, hgt1, hle1⟩ := exists_prime_in_half (n := Nat.sqrt n) (by omega)
  obtain ⟨p2, hp2, hgt2, hle2⟩ := exists_prime_in_half (n := Nat.sqrt n / 2) (by omega)
  obtain ⟨p3, hp3, hgt3, hle3⟩ := exists_prime_in_half (n := Nat.sqrt n / 4) h4
  have hp1_1 : 1 ≤ p1 := le_trans (by decide : (1 : ℕ) ≤ 2) hp1.two_le
  have hp2_1 : 1 ≤ p2 := le_trans (by decide : (1 : ℕ) ≤ 2) hp2.two_le
  have hp3_1 : 1 ≤ p3 := le_trans (by decide : (1 : ℕ) ≤ 2) hp3.two_le
  refine ⟨p1 - 1, p2 - 1, p3 - 1, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro heq
    have : p1 = p2 := by
      have := congrArg (· + 1) heq
      simp [Nat.sub_add_cancel hp1_1, Nat.sub_add_cancel hp2_1] at this
      exact this
    have : Nat.sqrt n / 2 < p1 := hgt1
    have : p2 ≤ Nat.sqrt n / 2 := hle2
    omega
  · intro heq
    have : p1 = p3 := by
      have := congrArg (· + 1) heq
      simp [Nat.sub_add_cancel hp1_1, Nat.sub_add_cancel hp3_1] at this
      exact this
    have : Nat.sqrt n / 2 < p1 := hgt1
    have : p3 ≤ Nat.sqrt n / 4 := hle3
    omega
  · intro heq
    have : p2 = p3 := by
      have := congrArg (· + 1) heq
      simp [Nat.sub_add_cancel hp2_1, Nat.sub_add_cancel hp3_1] at this
      exact this
    have : Nat.sqrt n / 2 / 2 < p2 := hgt2
    have : p3 ≤ Nat.sqrt n / 4 := hle3
    have : Nat.sqrt n / 4 = Nat.sqrt n / 2 / 2 := by omega
    omega
  · rwa [Nat.sub_add_cancel hp1_1]
  · rwa [Nat.sub_add_cancel hp2_1]
  · rwa [Nat.sub_add_cancel hp3_1]
  · exact le_trans (Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)) (Nat.le_sqrt.mp hle1)
  · have hle' : p2 ≤ Nat.sqrt n := le_trans hle2 (Nat.div_le_self _ _)
    exact le_trans (Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)) (Nat.le_sqrt.mp hle')
  · have hle' : p3 ≤ Nat.sqrt n := le_trans hle3 (Nat.div_le_self (Nat.sqrt n) 4)
    exact le_trans (Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)) (Nat.le_sqrt.mp hle')

/-- Three distinct good prime-`x` yield at least two ordered pairs, hence `a(n) ≥ 2`. -/
lemma ge2_of_three_good_x {n x1 x2 x3 : ℕ}
    (hd12 : x1 ≠ x2) (hd13 : x1 ≠ x3) (hd23 : x2 ≠ x3)
    (h1 : x1 * x1 ≤ n) (hp1 : Nat.Prime (x1 + 1))
    (g1 : A270966Rep.IsGoodNat (24 * (n - x1 * x1) + 1))
    (h2 : x2 * x2 ≤ n) (hp2 : Nat.Prime (x2 + 1))
    (g2 : A270966Rep.IsGoodNat (24 * (n - x2 * x2) + 1))
    (h3 : x3 * x3 ≤ n) (hp3 : Nat.Prime (x3 + 1))
    (g3 : A270966Rep.IsGoodNat (24 * (n - x3 * x3) + 1)) :
    2 ≤ A270966 n := by
  obtain ⟨y1, hy1⟩ := exists_pred_of_good h1 hp1 g1
  obtain ⟨y2, hy2⟩ := exists_pred_of_good h2 hp2 g2
  obtain ⟨y3, hy3⟩ := exists_pred_of_good h3 hp3 g3
  set p1 := if x1 ≤ y1 then (x1, y1) else (y1, x1)
  set p2 := if x2 ≤ y2 then (x2, y2) else (y2, x2)
  set p3 := if x3 ≤ y3 then (x3, y3) else (y3, x3)
  have mem1 : p1.1 = x1 ∨ p1.2 = x1 := by
    by_cases h : x1 ≤ y1 <;> simp [p1, h]
  have mem2 : p2.1 = x2 ∨ p2.2 = x2 := by
    by_cases h : x2 ≤ y2 <;> simp [p2, h]
  have mem3 : p3.1 = x3 ∨ p3.2 = x3 := by
    by_cases h : x3 ≤ y3 <;> simp [p3, h]
  have hsum1 : p1.1 * p1.1 + p1.2 * p1.2 ≤ n := by simpa [p1] using hy1.1
  have hsum2 : p2.1 * p2.1 + p2.2 * p2.2 ≤ n := by simpa [p2] using hy2.1
  have hx1 : p1.1 < n + 1 := lt_succ_of_sq_le (le_trans (Nat.le_add_right _ _) hsum1)
  have hy1' : p1.2 < n + 1 := lt_succ_of_sq_le (le_trans (Nat.le_add_left _ _) hsum1)
  have hx2 : p2.1 < n + 1 := lt_succ_of_sq_le (le_trans (Nat.le_add_right _ _) hsum2)
  have hy2' : p2.2 < n + 1 := lt_succ_of_sq_le (le_trans (Nat.le_add_left _ _) hsum2)
  have hp1p : A270966.Pred n p1 := by simpa [p1] using hy1
  have hp2p : A270966.Pred n p2 := by simpa [p2] using hy2
  have hp3p : A270966.Pred n p3 := by simpa [p3] using hy3
  have hsum3 : p3.1 * p3.1 + p3.2 * p3.2 ≤ n := by simpa [p3] using hy3.1
  have hx3 : p3.1 < n + 1 := lt_succ_of_sq_le (le_trans (Nat.le_add_right _ _) hsum3)
  have hy3' : p3.2 < n + 1 := lt_succ_of_sq_le (le_trans (Nat.le_add_left _ _) hsum3)
  have in_pair1 : x1 = p1.1 ∨ x1 = p1.2 := by rcases mem1 with h | h <;> simp [h]
  have in_pair2 : x2 = p2.1 ∨ x2 = p2.2 := by rcases mem2 with h | h <;> simp [h]
  have in_pair3 : x3 = p3.1 ∨ x3 = p3.2 := by rcases mem3 with h | h <;> simp [h]
  by_cases h12 : p1 = p2
  · by_cases h13 : p1 = p3
    · exfalso
      have a2 : x2 = p1.1 ∨ x2 = p1.2 := by rw [h12]; exact in_pair2
      have a3 : x3 = p1.1 ∨ x3 = p1.2 := by rw [h13]; exact in_pair3
      have : x1 = x2 ∨ x1 = x3 ∨ x2 = x3 := by
        rcases in_pair1 with a | a <;> rcases a2 with b | b <;> rcases a3 with c | c
        · exact Or.inl (a.trans b.symm)
        · exact Or.inl (a.trans b.symm)
        · exact Or.inr (Or.inl (a.trans c.symm))
        · exact Or.inr (Or.inr (b.trans c.symm))
        · exact Or.inr (Or.inr (b.trans c.symm))
        · exact Or.inr (Or.inl (a.trans c.symm))
        · exact Or.inl (a.trans b.symm)
        · exact Or.inl (a.trans b.symm)
      rcases this with h | h | h <;> contradiction
    · exact A270966.ge_two_of_pred hx1 hy1' hp1p hx3 hy3' hp3p h13
  · exact A270966.ge_two_of_pred hx1 hy1' hp1p hx2 hy2' hp2p h12
