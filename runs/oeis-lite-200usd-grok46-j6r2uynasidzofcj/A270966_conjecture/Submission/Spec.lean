  apply le_antisymm
  · apply Finset.card_le_one.mpr
    intro a ha b hb
    have ha' := (Finset.mem_filter.mp ha).2
    have hb' := (Finset.mem_filter.mp hb).2
    have ea := pred_608_unique ha'
    have eb := pred_608_unique hb'
    apply Prod.ext
