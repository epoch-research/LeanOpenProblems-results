    (hle : x ≤ y) (hs : x * x + y * y ≤ n)
    (hp : Nat.Prime (x + 1) ∨ Nat.Prime (y + 1))
    (hm : m * m = 24 * (n - (x * x + y * y)) + 1) :
    A270966.Pred n (x, y) :=
  ⟨hs, hle, hp, is_gp_of_sq hm⟩

lemma A270966.pred_of_form {n x y m : ℕ}
    (hle : x ≤ y) (hp : Nat.Prime (x + 1) ∨ Nat.Prime (y + 1))
    (hN : m * m + 24 * x * x + 24 * y * y = 24 * n + 1) :
    A270966.Pred n (x, y) := by
  have hN' : m * m + 24 * (x * x + y * y) = 24 * n + 1 := by
    linear_combination hN
  have hs : x * x + y * y ≤ n := by
    have : 24 * (x * x + y * y) ≤ 24 * n := by omega
    omega
  have hm : m * m = 24 * (n - (x * x + y * y)) + 1 := by
    have hsub : 24 * (n - (x * x + y * y)) = 24 * n - 24 * (x * x + y * y) :=
      Nat.mul_sub_left_distrib _ _ _
    have : 24 * (x * x + y * y) ≤ 24 * n := by omega
    omega
  exact pred_of_rep hle hs hp hm

