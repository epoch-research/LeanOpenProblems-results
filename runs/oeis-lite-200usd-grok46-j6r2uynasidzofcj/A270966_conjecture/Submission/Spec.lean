import FormalConjectures.Util.ProblemImports

set_option maxRecDepth 10000

open scoped Nat.Prime

/-- A natural number $n$ is a perfect square if its square root squared is $n$.
This is a decidable predicate since `Nat.sqrt` is computable. -/
def Nat.is_perfect_square (n : ℕ) : Prop :=
  (Nat.sqrt n) ^ 2 = n

/-- A natural number $k$ is a generalized pentagonal number if $24k+1$ is a perfect square.
This is equivalent to $k = z(3z+1)/2$ for some integer $z$. -/
def is_generalized_pentagonal (k : ℕ) : Prop :=
  (24 * k + 1).is_perfect_square

/-- Decidability instance for `is_generalized_pentagonal`. -/
instance is_generalized_pentagonal.decidable (k : ℕ) : Decidable (is_generalized_pentagonal k) :=
  by unfold is_generalized_pentagonal Nat.is_perfect_square; infer_instance

/--
A270966: Number of ways to write $n$ as $x^2 + y^2 + z(3z+1)/2$, where $x, y$ and $z$ are integers with $0 \le x \le y$ such that $x$ or $y$ has the form $p-1$ with $p$ prime.
The number of ways is the count of valid pairs $(x, y)$ because for each such pair, $k = n - x^2 - y^2$ is a generalized pentagonal number, which corresponds uniquely to an integer $z$.
-/
def A270966 (n : ℕ) : ℕ :=
  Finset.card <|
  -- We only need to iterate $x$ and $y$ up to $n$, since $x^2+y^2 \le n$.
  (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter fun xy : ℕ × ℕ =>
    let x := xy.fst
    let y := xy.snd
    let x_sq_y_sq := x * x + y * y

    -- 1. $x^2 + y^2 \le n$ to ensure the remainder is non-negative.
    x_sq_y_sq ≤ n ∧
    -- 2. $x \le y$.
    x ≤ y ∧
    -- 3. Primality constraint: $x$ or $y$ is $p-1$, meaning $x+1$ or $y+1$ is prime.
    (Nat.Prime (x + 1) ∨ Nat.Prime (y + 1)) ∧
    -- 4. The remainder $n - (x^2 + y^2)$ must be a generalized pentagonal number.
    is_generalized_pentagonal (n - x_sq_y_sq)

/-! ### Helper lemmas -/

/-- `24k+1 = m^2` implies `k` is generalized pentagonal. -/
lemma is_gp_of_sq {k m : ℕ} (h : m * m = 24 * k + 1) : is_generalized_pentagonal k := by
  unfold is_generalized_pentagonal Nat.is_perfect_square
  have : Nat.sqrt (24 * k + 1) = m := by
    rw [← h, Nat.sqrt_eq]
  rw [this, Nat.pow_two, h]

/-- If `24k+1` lies strictly between two consecutive squares, then `k` is not generalized pentagonal. -/
lemma not_gp_of_between {k s : ℕ}
    (h1 : s * s < 24 * k + 1) (h2 : 24 * k + 1 < (s + 1) * (s + 1)) :
    ¬ is_generalized_pentagonal k := by
  unfold is_generalized_pentagonal Nat.is_perfect_square
  intro h
  have hle : Nat.sqrt (24 * k + 1) ≤ s := by
    rw [Nat.lt_succ_iff.symm, Nat.sqrt_lt]
    exact h2
  have hge : s ≤ Nat.sqrt (24 * k + 1) := by
    rw [Nat.le_sqrt]
    exact Nat.le_of_lt h1
  have hs : Nat.sqrt (24 * k + 1) = s := le_antisymm hle hge
  have : s ^ 2 = 24 * k + 1 := by rw [← hs, h]
  rw [Nat.pow_two] at this
  omega

/-- The filtering predicate underlying `A270966`. -/
def A270966.Pred (n : ℕ) (xy : ℕ × ℕ) : Prop :=
  xy.1 * xy.1 + xy.2 * xy.2 ≤ n ∧ xy.1 ≤ xy.2 ∧
    (Nat.Prime (xy.1 + 1) ∨ Nat.Prime (xy.2 + 1)) ∧
    is_generalized_pentagonal (n - (xy.1 * xy.1 + xy.2 * xy.2))

instance (n : ℕ) : DecidablePred (A270966.Pred n) := fun _ => by
  unfold A270966.Pred is_generalized_pentagonal Nat.is_perfect_square
  infer_instance

lemma A270966.eq_filter (n : ℕ) :
    A270966 n =
      ((Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter
        (A270966.Pred n)).card := rfl

lemma A270966.mem_of_pred {n x y : ℕ}
    (hx : x < n + 1) (hy : y < n + 1) (hp : A270966.Pred n (x, y)) :
    (x, y) ∈ (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter
      (A270966.Pred n) :=
  Finset.mem_filter.mpr
    ⟨Finset.mem_product.mpr ⟨Finset.mem_range.mpr hx, Finset.mem_range.mpr hy⟩, hp⟩

lemma A270966.ge_one_of_pred {n x y : ℕ}
    (hx : x < n + 1) (hy : y < n + 1) (hp : A270966.Pred n (x, y)) :
    1 ≤ A270966 n := by
  rw [A270966.eq_filter]
  exact Nat.succ_le_iff.mpr (Finset.card_pos.mpr ⟨_, mem_of_pred hx hy hp⟩)

lemma A270966.ge_two_of_pred {n x1 y1 x2 y2 : ℕ}
    (hx1 : x1 < n + 1) (hy1 : y1 < n + 1) (hp1 : A270966.Pred n (x1, y1))
    (hx2 : x2 < n + 1) (hy2 : y2 < n + 1) (hp2 : A270966.Pred n (x2, y2))
    (hne : (x1, y1) ≠ (x2, y2)) :
    2 ≤ A270966 n := by
  rw [A270966.eq_filter]
  have h1 := mem_of_pred hx1 hy1 hp1
  have h2 := mem_of_pred hx2 hy2 hp2
  have : {(x1, y1), (x2, y2)} ⊆
      (Finset.product (Finset.range (n + 1)) (Finset.range (n + 1))).filter (A270966.Pred n) := by
    intro z hz
    simp only [Finset.mem_insert, Finset.mem_singleton] at hz
    rcases hz with rfl | rfl <;> assumption
  have hcard : ({(x1, y1), (x2, y2)} : Finset (ℕ × ℕ)).card = 2 := by
    rw [Finset.card_insert_of_notMem, Finset.card_singleton]
    simpa [Finset.mem_singleton] using hne
  have := Finset.card_le_card this
  omega

