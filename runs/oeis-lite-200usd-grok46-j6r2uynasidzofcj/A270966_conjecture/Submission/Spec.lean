  have h := (Int.mul_emod (6 : ℤ) (y * y % n) n).symm
  simpa using h

lemma two_ne_sq_add_six_of_mod24 {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1 ∨ p % 24 = 7) {x y : ℤ}
    (heq : x * x + 6 * y * y = 2 * (p : ℤ)) : False := by
  have hodd : p % 2 = 1 := by omega
  have h2p4 := two_mul_p_mod4 hodd
  have hsum4 : (x * x + 6 * y * y) % 4 = 2 := by rw [heq, h2p4]
  have hxeven : x % 2 = 0 := by
    have : x % 2 = 0 ∨ x % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hx1 := odd_sq_mod4 t
      have : (x * x + 6 * y * y) % 4 = (1 + (6 * y * y) % 4) % 4 := by
        rw [Int.add_emod, hx1]
      rw [this] at hsum4
      have hy4 := sq_mod_four y
      rcases hy4 with hy0 | hy1
      · have h6 : (6 * y * y) % 4 = 0 := by rw [six_y_sq_mod4, hy0]; norm_num
        rw [h6] at hsum4; norm_num at hsum4
      · have h6 : (6 * y * y) % 4 = 2 := by rw [six_y_sq_mod4, hy1]; norm_num
        rw [h6] at hsum4; norm_num at hsum4
  have hyodd : y % 2 = 1 := by
    have : y % 2 = 0 ∨ y % 2 = 1 := by omega
    rcases this with t | t
    · have hx0 := even_sq_mod4 hxeven
      have hy0 := even_sq_mod4 t
      have h6 : (6 * y * y) % 4 = 0 := by rw [six_y_sq_mod4, hy0]; norm_num
      have : (x * x + 6 * y * y) % 4 = 0 := by
        rw [Int.add_emod, hx0, h6]; norm_num
      omega
    · exact t
  have hxeq : x = 2 * (x / 2) := by omega
  set z := x / 2
  have hpform : 2 * z * z + 3 * y * y = (p : ℤ) := by
    have : 4 * z * z + 6 * y * y = 2 * (p : ℤ) := by
      rw [hxeq] at heq
      convert heq using 1
      ring
    nlinarith
  have hy24 := odd_sq_mod_twenty_four hyodd
  have hz24 := sq_mod_twenty_four z
  have hp24val : (2 * z * z + 3 * y * y) % 24 = 1 ∨
                 (2 * z * z + 3 * y * y) % 24 = 7 := by
    rw [hpform]
    rcases h with t | t
    · left; exact nat_mod_int t
    · right; exact nat_mod_int t
  have hcontra : (2 * z * z + 3 * y * y) % 24 ≠ 1 ∧
                 (2 * z * z + 3 * y * y) % 24 ≠ 7 := by
    rcases hz24 with hz | hz | hz | hz | hz | hz | hz <;>
      rcases hy24 with hy | hy
    all_goals
      have h2 : (2 * z * z) % 24 = (2 * (z * z % 24)) % 24 := two_z_sq_mod _ _
      have h3 : (3 * y * y) % 24 = (3 * (y * y % 24)) % 24 := three_y_sq_mod _ _
      rw [hz] at h2; rw [hy] at h3
      have hsum : (2 * z * z + 3 * y * y) % 24 =
          ((2 * z * z) % 24 + (3 * y * y) % 24) % 24 := Int.add_emod _ _ _
      rw [h2, h3] at hsum
      constructor <;> (intro h'; rw [hsum] at h'; norm_num at h')
  rcases hp24val with hp | hp
  · exact hcontra.1 hp
  · exact hcontra.2 hp

lemma three_ne_sq_add_six_of_mod24 {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1 ∨ p % 24 = 7) {x y : ℤ}
    (heq : x * x + 6 * y * y = 3 * (p : ℤ)) : False := by
  have hp3nat : p % 3 = 1 := by omega
  have hp3 : (p : ℤ) % 3 = 1 := nat_mod_int hp3nat
  have hsum : (x * x + 6 * y * y) % 3 = 0 := by
    rw [heq, Int.mul_emod, hp3]; norm_num
  have h6 : (6 * y * y) % 3 = 0 := by
    rw [six_mul_assoc, Int.mul_emod]; norm_num
  have hx3 : x * x % 3 = 0 := by
    have := hsum
    rw [Int.add_emod, h6] at this
    simpa using this
  have hx0 : x % 3 = 0 := by
    have : x % 3 = 0 ∨ x % 3 = 1 ∨ x % 3 = 2 := by omega
    rcases this with u | u | u
    · exact u
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
  obtain ⟨t, rfl⟩ : ∃ t, x = 3 * t := ⟨x / 3, by omega⟩
  have hpform : 3 * t * t + 2 * y * y = (p : ℤ) := by
    have : 9 * t * t + 6 * y * y = 3 * (p : ℤ) := by
      convert heq using 1
      ring
    nlinarith
  have hy2 : (2 * (y * y)) % 3 = 1 := by
    have hsum' : (3 * t * t + 2 * (y * y)) % 3 = 1 := by
      have : 3 * t * t + 2 * y * y = 3 * t * t + 2 * (y * y) := by ring
      rw [← this, hpform]; exact hp3
    have h3 : (3 * t * t) % 3 = 0 := by
      have : (3 * t * t : ℤ) = 3 * (t * t) := by ring
      rw [this, Int.mul_emod]; norm_num
    have := hsum'
    rw [Int.add_emod, h3] at this
    simpa using this
  rcases sq_mod_three y with hy | hy
  · have : (2 * (y * y)) % 3 = 0 := by rw [Int.mul_emod, hy]; norm_num
    omega
  · have : (2 * (y * y)) % 3 = 2 := by rw [Int.mul_emod, hy]; norm_num
    omega

lemma five_ne_sq_add_six_of_mod24 {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1 ∨ p % 24 = 7) {x y : ℤ}
    (heq : x * x + 6 * y * y = 5 * (p : ℤ)) : False := by
  have hp3nat : p % 3 = 1 := by omega
  have hp3 : (p : ℤ) % 3 = 1 := nat_mod_int hp3nat
  have hsum : (x * x + 6 * y * y) % 3 = 2 := by
    rw [heq, Int.mul_emod, hp3]; norm_num
  have h6 : (6 * y * y) % 3 = 0 := by
    rw [six_mul_assoc, Int.mul_emod]; norm_num
  have : x * x % 3 = 2 := by
    have := hsum
    rw [Int.add_emod, h6] at this
    simpa using this
  rcases sq_mod_three x with t | t <;> omega

lemma not_prime_of_eq_sq {p : ℕ} [hp : Fact p.Prime] {x : ℤ}
    (hxeq : x * x = (p : ℤ)) : False := by
  have hnat : p = x.natAbs * x.natAbs := by
    have := congrArg Int.natAbs hxeq
    simpa [Int.natAbs_mul, Int.natAbs_natCast] using this.symm
  have hdvd : x.natAbs ∣ p := ⟨x.natAbs, hnat⟩
  rcases hp.out.eq_one_or_self_of_dvd x.natAbs hdvd with h1 | hp'
  · have : p = 1 := by rw [hnat, h1]
    exact Nat.not_prime_one (this ▸ hp.out)
  · have hpeq : p = p * p := by
      calc p = x.natAbs * x.natAbs := hnat
        _ = p * p := by rw [hp']
    have h1p : 1 < p := Nat.Prime.one_lt hp.out
    have : p < p * p := Nat.lt_mul_self_iff.mpr h1p
    exact (ne_of_lt this) hpeq

lemma seven_ne_sq_add_six {p : ℕ} [hp : Fact p.Prime] {x y : ℤ}
    (hx : x.natAbs * x.natAbs ≤ p) (hy : y.natAbs * y.natAbs ≤ p)
    (heq : x * x + 6 * y * y = 7 * (p : ℤ)) : False := by
  have hx' := int_sq_le_of_natAbs hx
  have hy' := int_sq_le_of_natAbs hy
  have hxeq : x * x = (p : ℤ) := by nlinarith
  exact not_prime_of_eq_sq hxeq

lemma four_reduces {p : ℕ} {x y : ℤ}
    (heq : x * x + 6 * y * y = 4 * (p : ℤ)) :
    ∃ x1 y1 : ℤ, x1 * x1 + 6 * y1 * y1 = (p : ℤ) := by
  have hsum4 : (x * x + 6 * y * y) % 4 = 0 := by
    rw [heq, Int.mul_emod]; norm_num
  have hxeven : x % 2 = 0 := by
    have : x % 2 = 0 ∨ x % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hx1 := odd_sq_mod4 t
      have hy4 := sq_mod_four y
      have h6y : (6 * y * y) % 4 = (2 * (y * y % 4)) % 4 := six_y_sq_mod4 y
      rcases hy4 with hy0 | hy1
      · have h6 : (6 * y * y) % 4 = 0 := by rw [h6y, hy0]; norm_num
        have : (x * x + 6 * y * y) % 4 = 1 := by
          rw [Int.add_emod, hx1, h6]; norm_num
        omega
      · have h6 : (6 * y * y) % 4 = 2 := by rw [h6y, hy1]; norm_num
        have : (x * x + 6 * y * y) % 4 = 3 := by
          rw [Int.add_emod, hx1, h6]; norm_num
        omega
  have hyeven : y % 2 = 0 := by
    have : y % 2 = 0 ∨ y % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hy1 := odd_sq_mod4 t
      have hx0 := even_sq_mod4 hxeven
      have h6 : (6 * y * y) % 4 = 2 := by rw [six_y_sq_mod4, hy1]; norm_num
      have : (x * x + 6 * y * y) % 4 = 2 := by
        rw [Int.add_emod, hx0, h6]; norm_num
      omega
  refine ⟨x / 2, y / 2, ?_⟩
  set x1 := x / 2
  set y1 := y / 2
  have hxeq : x = 2 * x1 := by omega
  have hyeq : y = 2 * y1 := by omega
  have h4 : 4 * (x1 * x1 + 6 * y1 * y1) = 4 * (p : ℤ) := by
    calc 4 * (x1 * x1 + 6 * y1 * y1)
        = (2 * x1) * (2 * x1) + 6 * (2 * y1) * (2 * y1) := by ring
      _ = x * x + 6 * y * y := by rw [← hxeq, ← hyeq]
      _ = 4 * (p : ℤ) := heq
  nlinarith

lemma six_reduces {p : ℕ} {x y : ℤ}
    (heq : x * x + 6 * y * y = 6 * (p : ℤ)) :
    ∃ x1 y1 : ℤ, x1 * x1 + 6 * y1 * y1 = (p : ℤ) := by
  have hxeven : x % 2 = 0 := by
    have : x % 2 = 0 ∨ x % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hx1 : x * x % 2 = 1 := by simp [Int.mul_emod, t]
      have h6 : (6 * y * y) % 2 = 0 := by
        rw [six_mul_assoc, Int.mul_emod]; norm_num
      have hsum : (x * x + 6 * y * y) % 2 = 1 := by
        rw [Int.add_emod, hx1, h6]; norm_num
      have hr : (6 * (p : ℤ)) % 2 = 0 := by rw [Int.mul_emod]; norm_num
      rw [heq, hr] at hsum
      exact absurd hsum (by decide)
  have hx3 : x % 3 = 0 := by
    have hsum : (x * x + 6 * y * y) % 3 = 0 := by
      rw [heq, Int.mul_emod]; norm_num
    have h6 : (6 * y * y) % 3 = 0 := by
      rw [six_mul_assoc, Int.mul_emod]; norm_num
    have hxsq0 : x * x % 3 = 0 := by
      have := hsum
      rw [Int.add_emod, h6] at this
      simpa using this
    have : x % 3 = 0 ∨ x % 3 = 1 ∨ x % 3 = 2 := by omega
    rcases this with u | u | u
    · exact u
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
  have hx6 : x % 6 = 0 := by omega
  obtain ⟨z, rfl⟩ : ∃ z, x = 6 * z := ⟨x / 6, by omega⟩
  refine ⟨y, z, ?_⟩
  have : 36 * z * z + 6 * y * y = 6 * (p : ℤ) := by
    convert heq using 1
    ring
  nlinarith

lemma exists_sq_add_six_eq_kp {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1 ∨ p % 24 = 7) :
    ∃ (x y : ℤ) (k : ℕ), y ≠ 0 ∧ 1 ≤ k ∧ k ≤ 7 ∧
      x.natAbs * x.natAbs ≤ p ∧ y.natAbs * y.natAbs ≤ p ∧
      x * x + 6 * y * y = k * (p : ℤ) := by
  obtain ⟨a, ha⟩ := exists_sq_eq_neg_six h
  obtain ⟨x, y, hy0, hxle, hyle, hcong⟩ := thue_lemma p a
  have hdiv := dvd_sq_add_six_of_thue ha hcong
  have hpos := pos_sq_add_six (x := x) hy0
  have hle := sq_add_six_le (p := p) hxle hyle
  obtain ⟨k', hk'⟩ := hdiv
  have hk'pos : 0 < k' := by
    have : 0 < (p : ℤ) * k' := by
      rwa [← hk']
    have hppos : (0 : ℤ) < p := by exact_mod_cast Nat.Prime.pos (Fact.out : Nat.Prime p)
    nlinarith
  set kn := k'.toNat
  have k'n : k' = (kn : ℤ) := (Int.toNat_of_nonneg (le_of_lt hk'pos)).symm
  have hkn : x * x + 6 * y * y = (kn : ℤ) * (p : ℤ) := by
    rw [hk', k'n, mul_comm]
  have hk1 : 1 ≤ kn := by
    have : (1 : ℤ) ≤ k' := by omega
    have : (1 : ℤ) ≤ (kn : ℤ) := by rwa [← k'n]
    exact_mod_cast this
  have hk7 : kn ≤ 7 := by
    have : (kn : ℤ) * (p : ℤ) ≤ 7 * (p : ℤ) := by
      rwa [← hkn]
    have hppos : (0 : ℤ) < p := by exact_mod_cast Nat.Prime.pos (Fact.out : Nat.Prime p)
    have : (kn : ℤ) ≤ 7 := by nlinarith
    exact_mod_cast this
  exact ⟨x, y, kn, hy0, hk1, hk7, hxle, hyle, hkn⟩

lemma prime_eq_sq_add_six_sq {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1 ∨ p % 24 = 7) :
    ∃ x y : ℤ, y ≠ 0 ∧ x * x + 6 * y * y = (p : ℤ) := by
  obtain ⟨x, y, k, hy0, hk1, hk7, hxle, hyle, heq⟩ := exists_sq_add_six_eq_kp h
  interval_cases k
  · exact ⟨x, y, hy0, by simpa using heq⟩
  · exact (two_ne_sq_add_six_of_mod24 h heq).elim
  · exact (three_ne_sq_add_six_of_mod24 h heq).elim
  · obtain ⟨x1, y1, h1⟩ := four_reduces heq
    have hy1 : y1 ≠ 0 := by
      intro h0
      rw [h0] at h1
      exact not_prime_of_eq_sq (by simpa using h1)
    exact ⟨x1, y1, hy1, h1⟩
  · exact (five_ne_sq_add_six_of_mod24 h heq).elim
  · obtain ⟨x1, y1, h1⟩ := six_reduces heq
    have hy1 : y1 ≠ 0 := by
      intro h0
      rw [h0] at h1
      exact not_prime_of_eq_sq (by simpa using h1)
    exact ⟨x1, y1, hy1, h1⟩
  · exact (seven_ne_sq_add_six hxle hyle heq).elim

lemma y_even_of_sq_add_six_mod24 {p : ℕ} {x y : ℤ}
    (h : p % 24 = 1) (heq : x * x + 6 * y * y = (p : ℤ)) :
    y % 2 = 0 := by
  have : y % 2 = 0 ∨ y % 2 = 1 := by omega
  rcases this with t | t
  · exact t
  · have hy24 := odd_sq_mod_twenty_four t
    have hx24 := sq_mod_twenty_four x
    have hp24 : (x * x + 6 * (y * y)) % 24 = 1 := by
      have : x * x + 6 * y * y = x * x + 6 * (y * y) := by ring
      rw [← this, heq]
      exact nat_mod_int h
    have hcontra : (x * x + 6 * (y * y)) % 24 ≠ 1 := by
      rcases hx24 with hx | hx | hx | hx | hx | hx | hx <;>
        rcases hy24 with hy | hy
      all_goals
        have h6 : (6 * (y * y)) % 24 = (6 * (y * y % 24)) % 24 := by
          rw [Int.mul_emod]
          have hh := (Int.mul_emod (6 : ℤ) (y * y % 24) 24).symm
          simpa using hh
        rw [hy] at h6
        have hsum : (x * x + 6 * (y * y)) % 24 =
            (x * x % 24 + (6 * (y * y)) % 24) % 24 := Int.add_emod _ _ _
        rw [hsum, hx, h6]
        norm_num
    exact (hcontra hp24).elim

lemma prime_eq_sq_add_twenty_four_sq {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1) :
    ∃ u v : ℤ, v ≠ 0 ∧ u * u + 24 * v * v = (p : ℤ) := by
  obtain ⟨x, y, hy0, heq⟩ := prime_eq_sq_add_six_sq (Or.inl h)
  have hye := y_even_of_sq_add_six_mod24 h heq
  have hyeq : y = 2 * (y / 2) := by omega
  refine ⟨x, y / 2, ?_, ?_⟩
  · intro hv
    have : y = 0 := by omega
    exact hy0 this
  · rw [hyeq] at heq
    convert heq using 1
    ring

lemma int_sq_add_twenty_four_to_nat {u v : ℤ} {p : ℕ}
    (h : u * u + 24 * v * v = (p : ℤ)) :
    u.natAbs * u.natAbs + 24 * v.natAbs * v.natAbs = p := by
  have hu : (u * u).natAbs = u.natAbs * u.natAbs := Int.natAbs_mul u u
  have hv24 : (24 * v * v : ℤ).natAbs = 24 * v.natAbs * v.natAbs := by
    have : (24 * v * v : ℤ) = (24 : ℤ) * (v * v) := by ring
    rw [this, Int.natAbs_mul, Int.natAbs_mul]
    ring
  have hsum : 0 ≤ u * u := mul_self_nonneg u
  have h24n : 0 ≤ (24 * v * v : ℤ) := by
    have : (24 * v * v : ℤ) = 24 * (v * v) := by ring
    rw [this]; nlinarith [mul_self_nonneg v]
  have hL : (u * u + 24 * v * v).natAbs =
      u.natAbs * u.natAbs + 24 * v.natAbs * v.natAbs := by
    rw [Int.natAbs_add_of_nonneg hsum h24n, hu, hv24]
  have hR : (p : ℤ).natAbs = p := Int.natAbs_natCast p
  have := congrArg Int.natAbs h
  rw [hL, hR] at this
  exact this

lemma prime_eq_sq_add_twenty_four_sq_nat {p : ℕ} [Fact p.Prime]
    (h : p % 24 = 1) :
    ∃ u v : ℕ, v ≠ 0 ∧ u * u + 24 * v * v = p := by
  obtain ⟨u, v, hv, heq⟩ := prime_eq_sq_add_twenty_four_sq h
  refine ⟨u.natAbs, v.natAbs, ?_, int_sq_add_twenty_four_to_nat heq⟩
  intro h0
  have : v = 0 := by
    have : v.natAbs = 0 := h0
    exact Int.natAbs_eq_zero.mp this
  exact hv this



/- Connecting the binary form to A270966. -/

lemma pred_of_u24v {n u v : ℕ}
    (hN : u * u + 24 * v * v = 24 * n + 1)
    (hv : Nat.Prime (v + 1)) :
    A270966.Pred n (0, v) :=
  A270966.pred_of_form (Nat.zero_le v) (Or.inr hv) (by
    simpa [Nat.mul_zero, Nat.add_zero] using hN)

lemma twenty_four_n_add_one_mod :
    ∀ n : ℕ, (24 * n + 1) % 24 = 1 := by
  intro n
  omega


lemma exists_rep_of_prime_N {n : ℕ} (hN : Nat.Prime (24 * n + 1)) :
    ∃ u v : ℕ, v ≠ 0 ∧ u * u + 24 * v * v = 24 * n + 1 := by
  have : Fact (Nat.Prime (24 * n + 1)) := ⟨hN⟩
  exact prime_eq_sq_add_twenty_four_sq_nat (twenty_four_n_add_one_mod n)


/-! ### Pairs from representations M_x = u^2 + 24 v^2 -/

lemma twenty_four_mul_sq (a : ℕ) : 24 * a * a = 24 * (a * a) := by ring

lemma pred_of_x_u24v {n x u v : ℕ}
    (hxle : x * x ≤ n)
    (hp : Nat.Prime (x + 1))
    (hM : u * u + 24 * (v * v) = 24 * (n - x * x) + 1) :
    A270966.Pred n (if x ≤ v then (x, v) else (v, x)) := by
  have hsum : 24 * (n - x * x) + 24 * (x * x) = 24 * n := by
    rw [← Nat.mul_add, Nat.sub_add_cancel hxle]
  have hform' : u * u + 24 * (x * x) + 24 * (v * v) = 24 * n + 1 := by
    omega
  by_cases hxv : x ≤ v
  · have hpair : A270966.Pred n (x, v) :=
      A270966.pred_of_form hxv (Or.inl hp) (by
        rw [twenty_four_mul_sq x, twenty_four_mul_sq v]; exact hform')
    simpa [hxv] using hpair
  · have hvx : v ≤ x := Nat.le_of_not_ge hxv
    have hpair : A270966.Pred n (v, x) :=
      A270966.pred_of_form hvx (Or.inr hp) (by
        rw [twenty_four_mul_sq v, twenty_four_mul_sq x, add_right_comm (u * u), hform'])
    simpa [hxv] using hpair

lemma pred_of_x_rep {n x u v : ℕ}
    (hxle : x * x ≤ n)
    (hp : Nat.Prime (x + 1))
    (hM : u * u + 24 * (v * v) + 24 * (x * x) = 24 * n + 1) :
    A270966.Pred n (if x ≤ v then (x, v) else (v, x)) := by
  have : u * u + 24 * (v * v) = 24 * (n - x * x) + 1 := by
    have : 24 * (x * x) ≤ 24 * n := Nat.mul_le_mul_left _ hxle
    omega
  exact pred_of_x_u24v hxle hp this

/-- If `24n-23` is represented by `u^2+24v^2`, we get a valid pair (using `x=1`). -/
lemma pred_of_x1 {n u v : ℕ} (hn : 1 ≤ n)
    (hM : u * u + 24 * (v * v) = 24 * n - 23) :
    A270966.Pred n (if 1 ≤ v then (1, v) else (v, 1)) := by
  have hxle : (1 : ℕ) * 1 ≤ n := by omega
  have hp : Nat.Prime (1 + 1) := by decide
  have h24 : 24 * n - 23 = 24 * (n - 1) + 1 := by
    omega
  have hM' : u * u + 24 * (v * v) = 24 * (n - 1) + 1 := by
    rwa [h24] at hM
  simpa using pred_of_x_u24v (n := n) (x := 1) hxle hp hM'

lemma A270966_pos_of_le_2000 {n : ℕ} (hn : 0 < n) (hn' : n ≤ 2000) :
    0 < A270966 n := by
  rcases eq_or_ne n 1 with rfl | h1
