lemma three_prime : Nat.Prime 3 := by decide

instance : Fact (Nat.Prime 3) := ⟨three_prime⟩

lemma not_two_of_mod24 {p : ℕ} (h : p % 24 = 1 ∨ p % 24 = 7) : p ≠ 2 := by
  intro h2; subst h2; rcases h with h | h <;> simp at h

lemma not_three_of_mod24 {p : ℕ} (h : p % 24 = 1 ∨ p % 24 = 7) : p ≠ 3 := by
  intro h3; subst h3; rcases h with h | h <;> simp at h

lemma neg_six_ne_zero_mod {p : ℕ} [Fact p.Prime] (h : p % 24 = 1 ∨ p % 24 = 7) :
    ((-6 : ℤ) : ZMod p) ≠ 0 := by
  intro hz
  have hdiv : (p : ℤ) ∣ 6 := by
    have := (ZMod.intCast_zmod_eq_zero_iff_dvd (-6) p).mp hz
    exact (Int.dvd_natAbs.mp (by simpa using this))
  have : p ∣ 6 := Int.ofNat_dvd.mp (by exact_mod_cast hdiv)
  have hp23 : p = 2 ∨ p = 3 := by
    have h6 : 6 = 2 * 3 := rfl
    rw [h6] at this
    exact (Nat.Prime.dvd_mul Fact.out).mp this |>.elim
      (fun h2 => Or.inl ((Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).mp h2))
      (fun h3 => Or.inr ((Nat.prime_dvd_prime_iff_eq Fact.out three_prime).mp h3))
  rcases hp23 with h2 | h3
  · exact not_two_of_mod24 h h2
  · exact not_three_of_mod24 h h3

lemma chi8_of_mod24 {p : ℕ} (h : p % 24 = 1 ∨ p % 24 = 7) : ZMod.χ₈ p = 1 := by
  rw [ZMod.χ₈_nat_eq_if_mod_eight]
  have h8 : p % 8 = 1 ∨ p % 8 = 7 := by omega
  have hodd : p % 2 ≠ 0 := by omega
  simp [hodd, h8]

lemma legendre_p_mod_three {p : ℕ} [Fact p.Prime] (h : p % 24 = 1 ∨ p % 24 = 7) :
    legendreSym 3 p = 1 := by
  have hp3m : p % 3 = 1 := by omega
  have hne : ((p : ℤ) : ZMod 3) ≠ 0 := by
    intro hz
    have : 3 ∣ p := (ZMod.natCast_eq_zero_iff p 3).mp (by simpa using hz)
    have : p = 3 := ((Nat.prime_dvd_prime_iff_eq three_prime Fact.out).mp this).symm
    exact not_three_of_mod24 h this
  have hsq : IsSquare ((p : ℤ) : ZMod 3) := by
    have hp1 : (p : ZMod 3) = (1 : ZMod 3) := by
      apply (ZMod.natCast_eq_natCast_iff p 1 3).mpr
      exact hp3m
    refine ⟨(1 : ZMod 3), ?_⟩
    simp [hp1]
  exact (legendreSym.eq_one_iff (p := 3) hne).2 hsq

lemma legendre_three_of_mod24 {p : ℕ} [Fact p.Prime] (h : p % 24 = 1 ∨ p % 24 = 7) :
    legendreSym p 3 = ZMod.χ₄ p := by
  have hp2 : p ≠ 2 := not_two_of_mod24 h
  rcases h with h | h
  · have hp4 : p % 4 = 1 := by omega
    have hr := legendreSym.quadratic_reciprocity_one_mod_four (p := p) (q := 3) hp4
      (by decide : (3 : ℕ) ≠ 2)
    have hχ : ZMod.χ₄ p = 1 := ZMod.χ₄_nat_one_mod_four hp4
    have h13 := legendre_p_mod_three (Or.inl h)
    calc
      legendreSym p 3 = legendreSym p (3 : ℕ) := rfl
      _ = legendreSym 3 p := hr.symm
      _ = 1 := h13
      _ = ZMod.χ₄ p := hχ.symm
  · have hp4 : p % 4 = 3 := by omega
    have hr := legendreSym.quadratic_reciprocity_three_mod_four (p := p) (q := 3) hp4
      (by decide : (3 : ℕ) % 4 = 3)
    have hχ : ZMod.χ₄ p = -1 := ZMod.χ₄_nat_three_mod_four hp4
    have h13 := legendre_p_mod_three (Or.inr h)
    calc
      legendreSym p 3 = legendreSym p (3 : ℕ) := rfl
      _ = -legendreSym 3 p := by
        have := congrArg Neg.neg hr
        simpa using this.symm
      _ = -1 := by rw [h13]
      _ = ZMod.χ₄ p := hχ.symm

lemma legendre_neg_six_eq_one {p : ℕ} [Fact p.Prime] (h : p % 24 = 1 ∨ p % 24 = 7) :
    legendreSym p (-6) = 1 := by
  have hp2 : p ≠ 2 := not_two_of_mod24 h
  have hfac : (-6 : ℤ) = (-1) * (2 * 3) := by norm_num
  rw [hfac, legendreSym.mul, legendreSym.mul]
  rw [legendreSym.at_neg_one hp2, legendreSym.at_two hp2, legendre_three_of_mod24 h]
  rw [chi8_of_mod24 h]
  rcases h with h | h
  · rw [ZMod.χ₄_nat_one_mod_four (by omega : p % 4 = 1)]; norm_num
  · rw [ZMod.χ₄_nat_three_mod_four (by omega : p % 4 = 3)]; norm_num

lemma exists_sq_eq_neg_six {p : ℕ} [hp : Fact p.Prime] (h : p % 24 = 1 ∨ p % 24 = 7) :
    ∃ a : ℤ, a * a ≡ -6 [ZMOD p] := by
  have hne6 := neg_six_ne_zero_mod h
  have his : IsSquare ((-6 : ℤ) : ZMod p) :=
    (legendreSym.eq_one_iff (p := p) hne6).1 (legendre_neg_six_eq_one h)
  obtain ⟨t, ht⟩ := his
  refine ⟨(t.val : ℤ), ?_⟩
  rw [← ZMod.intCast_eq_intCast_iff, Int.cast_mul]
  have : ((t.val : ℤ) : ZMod p) = t := by simp
  rw [this, ht.symm]

lemma int_sq_le_of_natAbs {x : ℤ} {p : ℕ} (h : x.natAbs * x.natAbs ≤ p) :
    x * x ≤ (p : ℤ) := by
  have : (x.natAbs * x.natAbs : ℤ) ≤ p := Nat.cast_le.mpr h
  rwa [Int.natAbs_mul_self'] at this

lemma dvd_sq_add_six_of_thue {p : ℕ} [Fact p.Prime] {a x y : ℤ}
    (ha : a * a ≡ -6 [ZMOD p]) (hcong : a * y ≡ x [ZMOD p]) :
    (p : ℤ) ∣ x * x + 6 * y * y := by
  have hx2 : x * x ≡ (a * y) * (a * y) [ZMOD p] :=
    Int.ModEq.mul hcong.symm hcong.symm
  have hx2' : x * x ≡ (a * a) * (y * y) [ZMOD p] := by
    have : (a * y) * (a * y) = (a * a) * (y * y) := by ring
    rwa [this] at hx2
  have h6 : (a * a) * (y * y) ≡ (-6) * (y * y) [ZMOD p] :=
    Int.ModEq.mul ha rfl
  have : x * x ≡ -6 * (y * y) [ZMOD p] := hx2'.trans h6
  have : x * x + 6 * y * y ≡ 0 [ZMOD p] := by
    convert Int.ModEq.add_right (6 * y * y) this
    ring
  exact Int.modEq_zero_iff_dvd.mp this

lemma pos_sq_add_six {x y : ℤ} (hy : y ≠ 0) : 0 < x * x + 6 * y * y := by
  have : 0 < y * y := mul_self_pos.mpr hy
  nlinarith

lemma sq_add_six_le {x y : ℤ} {p : ℕ}
    (hx : x.natAbs * x.natAbs ≤ p) (hy : y.natAbs * y.natAbs ≤ p) :
    x * x + 6 * y * y ≤ 7 * (p : ℤ) := by
  have hx' := int_sq_le_of_natAbs hx
  have hy' := int_sq_le_of_natAbs hy
  nlinarith


lemma nat_mod_int {p r m : ℕ} (h : p % m = r) : (p : ℤ) % (m : ℤ) = (r : ℤ) :=
