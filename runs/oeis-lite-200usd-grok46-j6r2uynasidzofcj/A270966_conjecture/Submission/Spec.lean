lemma two_mul_p_mod4 {p : ℕ} (h : p % 2 = 1) : (2 * (p : ℤ)) % 4 = 2 := by
  have : p % 4 = 1 ∨ p % 4 = 3 := by omega
  rcases this with t | t
  · have hp : (p : ℤ) % 4 = 1 := nat_mod_int t
