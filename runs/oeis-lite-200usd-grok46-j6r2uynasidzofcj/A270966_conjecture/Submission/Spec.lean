/-! ### The three unique values -/

lemma pred_1 : A270966.Pred 1 (0, 1) :=
  ⟨by norm_num, by norm_num, Or.inr (by norm_num : Nat.Prime 2), gp_0⟩

lemma pred_49 : A270966.Pred 49 (1, 6) :=
  ⟨by norm_num, by norm_num, Or.inl (by norm_num : Nat.Prime 2), gp_12⟩

lemma pred_608 : A270966.Pred 608 (6, 14) :=
  ⟨by norm_num, by norm_num, Or.inl (by norm_num : Nat.Prime 7),
    is_gp_of_sq (by norm_num : 95 * 95 = 24 * 376 + 1)⟩

lemma A270966_one_ge : 1 ≤ A270966 1 :=
  A270966.ge_one_of_pred (by norm_num) (by norm_num) pred_1

lemma A270966_49_ge : 1 ≤ A270966 49 :=
  A270966.ge_one_of_pred (by norm_num) (by norm_num) pred_49

lemma A270966_608_ge : 1 ≤ A270966 608 :=
  A270966.ge_one_of_pred (by norm_num) (by norm_num) pred_608

lemma not_pred_1_00 : ¬ A270966.Pred 1 (0, 0) := by
  intro h
  exact h.2.2.1.elim Nat.not_prime_one Nat.not_prime_one

lemma not_pred_1_10 : ¬ A270966.Pred 1 (1, 0) := fun h => Nat.not_succ_le_self 0 h.2.1

lemma not_pred_1_11 : ¬ A270966.Pred 1 (1, 1) := by
  intro h
  exact (lt_irrefl (1 : ℕ)) (lt_of_lt_of_le (by norm_num : (1 : ℕ) < 2) h.1)

lemma A270966_one : A270966 1 = 1 := by
  rw [A270966.eq_filter]
  apply le_antisymm
  · apply Finset.card_le_one.mpr
    intro a ha b hb
    have ha' := (Finset.mem_filter.mp ha).2
    have hb' := (Finset.mem_filter.mp hb).2
    have har := (Finset.mem_filter.mp ha).1
    have hbr := (Finset.mem_filter.mp hb).1
    have hxa : a.1 < 2 := Finset.mem_range.mp (Finset.mem_product.mp har).1
    have hya : a.2 < 2 := Finset.mem_range.mp (Finset.mem_product.mp har).2
    have hxb : b.1 < 2 := Finset.mem_range.mp (Finset.mem_product.mp hbr).1
    have hyb : b.2 < 2 := Finset.mem_range.mp (Finset.mem_product.mp hbr).2
    have ea : a = (0, 1) := by
      match a with
      | (0, 0) => exact (not_pred_1_00 ha').elim
      | (0, 1) => rfl
      | (1, 0) => exact (not_pred_1_10 ha').elim
      | (1, 1) => exact (not_pred_1_11 ha').elim
      | (x + 2, _) => omega
      | (_, y + 2) => omega
    have eb : b = (0, 1) := by
      match b with
      | (0, 0) => exact (not_pred_1_00 hb').elim
      | (0, 1) => rfl
      | (1, 0) => exact (not_pred_1_10 hb').elim
      | (1, 1) => exact (not_pred_1_11 hb').elim
      | (x + 2, _) => omega
      | (_, y + 2) => omega
    simp [ea, eb]
  · exact A270966_one_ge

lemma pred_49_unique {x y : ℕ} (h : A270966.Pred 49 (x, y)) : x = 1 ∧ y = 6 := by
  have hxy : x * x + y * y ≤ 49 := h.1
  have hxley : x ≤ y := h.2.1
  have hy : y ≤ 7 := by
    have : y * y ≤ 49 := le_trans (Nat.le_add_left _ _) hxy
    nlinarith
  interval_cases y
  · -- y = 0 ⇒ x = 0
    have : x = 0 := by omega
    subst this
    exact (h.2.2.1.elim Nat.not_prime_one Nat.not_prime_one).elim
  · -- y = 1
    interval_cases x
    · exact (not_gp_of_between (k := 48) (s := 33) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 47) (s := 33) (by norm_num) (by norm_num) h.2.2.2).elim
  · -- y = 2
    interval_cases x
    · exact (not_gp_of_between (k := 45) (s := 32) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 44) (s := 32) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 41) (s := 31) (by norm_num) (by norm_num) h.2.2.2).elim
  · -- y = 3
    interval_cases x
    · exact (h.2.2.1.elim Nat.not_prime_one (by norm_num : ¬ Nat.Prime 4)).elim
    · exact (not_gp_of_between (k := 39) (s := 30) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 36) (s := 29) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (h.2.2.1.elim (by norm_num : ¬ Nat.Prime 4) (by norm_num : ¬ Nat.Prime 4)).elim
  · -- y = 4
    interval_cases x
    · exact (not_gp_of_between (k := 33) (s := 28) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 32) (s := 27) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 29) (s := 26) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 24) (s := 24) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 17) (s := 20) (by norm_num) (by norm_num) h.2.2.2).elim
  · -- y = 5
    interval_cases x
    · exact (h.2.2.1.elim Nat.not_prime_one (by norm_num : ¬ Nat.Prime 6)).elim
    · exact (not_gp_of_between (k := 23) (s := 23) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 20) (s := 21) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (h.2.2.1.elim (by norm_num : ¬ Nat.Prime 4) (by norm_num : ¬ Nat.Prime 6)).elim
    · exact (not_gp_of_between (k := 8) (s := 13) (by norm_num) (by norm_num) h.2.2.2).elim
    · omega -- 25+25 > 49
  · -- y = 6
    interval_cases x
    · exact (not_gp_of_between (k := 13) (s := 17) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact ⟨rfl, rfl⟩
    · exact (not_gp_of_between (k := 9) (s := 14) (by norm_num) (by norm_num) h.2.2.2).elim
    · exact (not_gp_of_between (k := 4) (s := 9) (by norm_num) (by norm_num) h.2.2.2).elim
    · omega
    · omega
    · omega
  · -- y = 7
    interval_cases x
    · exact (h.2.2.1.elim Nat.not_prime_one (by norm_num : ¬ Nat.Prime 8)).elim
    · omega
    · omega
    · omega
    · omega
    · omega
    · omega
    · omega

lemma A270966_49 : A270966 49 = 1 := by
  rw [A270966.eq_filter]
  apply le_antisymm
  · apply Finset.card_le_one.mpr
    intro a ha b hb
    have ha' := (Finset.mem_filter.mp ha).2
    have hb' := (Finset.mem_filter.mp hb).2
    have ea := pred_49_unique ha'
    have eb := pred_49_unique hb'
    apply Prod.ext
    · simp [ea.1, eb.1]
    · simp [ea.2, eb.2]
  · exact A270966_49_ge

