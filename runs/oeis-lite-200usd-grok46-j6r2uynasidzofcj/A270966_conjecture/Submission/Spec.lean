lemma A270966_zero : A270966 0 = 0 := by
  rw [A270966.eq_filter]
  apply Finset.card_eq_zero.mpr
  apply Finset.filter_eq_empty_iff.mpr
  intro xy hxy
  have hxy0 : xy = (0, 0) := by
    simpa [Finset.mem_product, Finset.mem_range] using hxy
  intro hp
  rw [hxy0] at hp
  unfold A270966.Pred at hp
  rcases hp.2.2.1 with h | h
  · exact Nat.not_prime_one h
  · exact Nat.not_prime_one h

lemma A270966_zero_ne_one : A270966 0 ≠ 1 := by
  rw [A270966_zero]; decide

