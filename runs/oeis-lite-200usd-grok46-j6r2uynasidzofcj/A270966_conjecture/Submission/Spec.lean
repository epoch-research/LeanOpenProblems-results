/- ### Representation by u^2 + 24 v^2 for good numbers -/ 

namespace A270966Rep



/-!
Sufficiency: a number N ≡ 1 [MOD 24] with even valuations at all
primes ≡ 13,17,19,23 [MOD 24] is represented by u^2 + 24 v^2.
-/

lemma sqrt_mul_le' (n : ℕ) : Nat.sqrt n * Nat.sqrt n ≤ n := by
  simpa [pow_two] using Nat.sqrt_le' n

lemma lt_succ_sqrt_mul' (n : ℕ) : n < (Nat.sqrt n + 1) * (Nat.sqrt n + 1) := by
  simpa [pow_two, Nat.succ_eq_add_one] using Nat.lt_succ_sqrt' n

lemma natAbs_sub_le_of_le' {a b m : ℕ} (ha : a ≤ m) (hb : b ≤ m) :
    ((a : ℤ) - b).natAbs ≤ m := by
  have ha' : (a : ℤ) ≤ m := Nat.cast_le.mpr ha
  have hb' : (b : ℤ) ≤ m := Nat.cast_le.mpr hb
  have : |(a : ℤ) - b| ≤ (m : ℤ) := by
    rw [abs_le]
    constructor <;> omega
  rwa [Int.abs_eq_natAbs, Nat.cast_le] at this

lemma natAbs_mul_le_of_le' {x : ℤ} {m n : ℕ}
    (h : x.natAbs ≤ m) (hm : m * m ≤ n) : x.natAbs * x.natAbs ≤ n :=
  (Nat.mul_le_mul h h).trans hm

lemma thue_lemma_of_one_lt (n : ℕ) (hn : 1 < n) (a : ℤ) :
    ∃ x y : ℤ, y ≠ 0 ∧
      x.natAbs * x.natAbs ≤ n ∧ y.natAbs * y.natAbs ≤ n ∧
      a * y ≡ x [ZMOD n] := by
  have : NeZero n := ⟨by omega⟩
  set m := Nat.sqrt n
  have hm_le : m * m ≤ n := sqrt_mul_le' n
  have hm_lt : n < (m + 1) * (m + 1) := lt_succ_sqrt_mul' n
  let S := Finset.range (m + 1)
  let f : ℕ × ℕ → ZMod n := fun rs => (rs.1 : ZMod n) - (a : ZMod n) * (rs.2 : ZMod n)
  have hS : (S ×ˢ S).card = (m + 1) * (m + 1) := by
    simp [S, Finset.card_product, Finset.card_range]
  have hlt : Fintype.card (ZMod n) < (S ×ˢ S).card := by
    simp [ZMod.card, hS]; exact hm_lt
  have hmap : ∀ t ∈ S ×ˢ S, f t ∈ (Finset.univ : Finset (ZMod n)) := fun _ _ => Finset.mem_univ _
  obtain ⟨p1, hp1, p2, hp2, hne, hf⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hlt hmap
  obtain ⟨r1, s1⟩ := p1
  obtain ⟨r2, s2⟩ := p2
  have hr1 : r1 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp1; omega
  have hs1 : s1 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp1; omega
  have hr2 : r2 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp2; omega
  have hs2 : s2 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp2; omega
  set x : ℤ := (r1 : ℤ) - r2
  set y : ℤ := (s1 : ℤ) - s2
  have hxle : x.natAbs ≤ m := natAbs_sub_le_of_le' hr1 hr2
  have hyle : y.natAbs ≤ m := natAbs_sub_le_of_le' hs1 hs2
  have hcong : a * y ≡ x [ZMOD n] := by
    rw [← ZMod.intCast_eq_intCast_iff]
    simp only [x, y, Int.cast_sub, Int.cast_natCast, Int.cast_mul]
    have h' : (r1 : ZMod n) - (a : ZMod n) * (s1 : ZMod n) =
              (r2 : ZMod n) - (a : ZMod n) * (s2 : ZMod n) := by
      simpa [f] using hf
    rw [sub_eq_sub_iff_sub_eq_sub] at h'
    calc (a : ZMod n) * ((s1 : ZMod n) - s2)
        = (a : ZMod n) * s1 - (a : ZMod n) * s2 := by ring
      _ = (r1 : ZMod n) - r2 := h'.symm
  have hsqrt_lt : m < n := Nat.sqrt_lt_self hn
  have hy0 : y ≠ 0 := by
    intro hy
    have hxmod : (x : ZMod n) = 0 := by
      have : a * 0 ≡ x [ZMOD n] := by simpa [hy] using hcong
      rw [← ZMod.intCast_eq_intCast_iff] at this
      simpa using this.symm
    have hxdvd : (n : ℤ) ∣ x := (ZMod.intCast_zmod_eq_zero_iff_dvd x n).mp hxmod
    have hxlt : x.natAbs < n := lt_of_le_of_lt hxle hsqrt_lt
    have hx00 : x = 0 :=
      Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hxdvd (by simpa [Int.natAbs_natCast] using hxlt)
    have hr : r1 = r2 := by
      have : (r1 : ℤ) = r2 := by simp [x] at hx00; omega
      exact Nat.cast_injective this
    have hs : s1 = s2 := by
      have : (s1 : ℤ) = s2 := by simp [y] at hy; omega
      exact Nat.cast_injective this
    exact hne (Prod.ext hr hs)
  exact ⟨x, y, hy0, natAbs_mul_le_of_le' hxle hm_le, natAbs_mul_le_of_le' hyle hm_le, hcong⟩

lemma nat_mod_int' {p r m : ℕ} (h : p % m = r) : (p : ℤ) % (m : ℤ) = (r : ℤ) :=
  by exact_mod_cast h


def IsGoodPrimeRes (p : ℕ) : Prop :=
  p % 24 = 1 ∨ p % 24 = 5 ∨ p % 24 = 7 ∨ p % 24 = 11

def IsBadPrimeRes (p : ℕ) : Prop :=
  p % 24 = 13 ∨ p % 24 = 17 ∨ p % 24 = 19 ∨ p % 24 = 23

lemma goodRes_ne_two {p : ℕ} (h : IsGoodPrimeRes p) : p ≠ 2 := by
  intro h2; subst h2; rcases h with h | h | h | h <;> simp at h

lemma goodRes_ne_three {p : ℕ} (h : IsGoodPrimeRes p) : p ≠ 3 := by
  intro h3; subst h3; rcases h with h | h | h | h <;> simp at h

lemma zmod3_sq_ne_two (t : ZMod 3) : t * t ≠ 2 := by
  fin_cases t <;> decide

lemma neg_six_ne_zero_mod_good {p : ℕ} [Fact p.Prime] (h : IsGoodPrimeRes p) :
    ((-6 : ℤ) : ZMod p) ≠ 0 := by
  intro hz
  have hdiv : (p : ℤ) ∣ 6 := by
    have := (ZMod.intCast_zmod_eq_zero_iff_dvd (-6) p).mp hz
    exact (Int.dvd_natAbs.mp (by simpa using this))
  have : p ∣ 6 := Int.ofNat_dvd.mp (by exact_mod_cast hdiv)
  have hp23 : p = 2 ∨ p = 3 := by
    have h6 : 6 = 2 * 3 := rfl
    rw [h6] at this
    exact (Nat.Prime.dvd_mul Fact.out).mp this |>.elim
      (fun h2 => Or.inl ((Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).mp h2))
      (fun h3 => Or.inr ((Nat.prime_dvd_prime_iff_eq Fact.out three_prime).mp h3))
  rcases hp23 with h2 | h3
  · exact goodRes_ne_two h h2
  · exact goodRes_ne_three h h3

lemma legendre_three_of_goodRes {p : ℕ} [Fact p.Prime] (h : IsGoodPrimeRes p) :
    legendreSym p 3 = ZMod.χ₄ p * legendreSym 3 p := by
  have h4 : p % 4 = 1 ∨ p % 4 = 3 := by rcases h with h | h | h | h <;> omega
  rcases h4 with h4 | h4
  · have hr := legendreSym.quadratic_reciprocity_one_mod_four (p := p) (q := 3) h4
      (by decide : (3 : ℕ) ≠ 2)
    have hχ : ZMod.χ₄ p = 1 := ZMod.χ₄_nat_one_mod_four h4
    rw [hχ, one_mul]
    simpa using hr.symm
  · have hr := legendreSym.quadratic_reciprocity_three_mod_four (p := p) (q := 3) h4
      (by decide : (3 : ℕ) % 4 = 3)
    have hχ : ZMod.χ₄ p = -1 := ZMod.χ₄_nat_three_mod_four h4
    rw [hχ]
    have := congrArg Neg.neg hr
    simpa [neg_mul, mul_comm] using this.symm

lemma legendre_neg_six_eq_one_good {p : ℕ} [Fact p.Prime] (h : IsGoodPrimeRes p) :
    legendreSym p (-6) = 1 := by
  have hp2 : p ≠ 2 := goodRes_ne_two h
  have hfac : (-6 : ℤ) = (-1) * (2 * 3) := by norm_num
  rw [hfac, legendreSym.mul, legendreSym.mul]
  rw [legendreSym.at_neg_one hp2, legendreSym.at_two hp2, legendre_three_of_goodRes h]
  have hχ4sq : ZMod.χ₄ p * ZMod.χ₄ p = 1 := by
    have h4 : p % 4 = 1 ∨ p % 4 = 3 := by rcases h with h | h | h | h <;> omega
    rcases h4 with h4 | h4
    · simp [ZMod.χ₄_nat_one_mod_four h4]
    · simp [ZMod.χ₄_nat_three_mod_four h4]
  have hrearr : ZMod.χ₄ p * ZMod.χ₈ p * (ZMod.χ₄ p * legendreSym 3 p) =
      ZMod.χ₈ p * legendreSym 3 p := by
    calc ZMod.χ₄ p * ZMod.χ₈ p * (ZMod.χ₄ p * legendreSym 3 p)
        = (ZMod.χ₄ p * ZMod.χ₄ p) * ZMod.χ₈ p * legendreSym 3 p := by ring
      _ = 1 * ZMod.χ₈ p * legendreSym 3 p := by rw [hχ4sq]
      _ = ZMod.χ₈ p * legendreSym 3 p := by ring
  convert hrearr using 1
  · ring
  · rcases h with h | h | h | h
    · have h8 : ZMod.χ₈ p = 1 := by
        rw [ZMod.χ₈_nat_eq_if_mod_eight]
        have hodd : p % 2 ≠ 0 := by omega
        have : p % 8 = 1 := by omega
        simp [hodd, this]
      have h3 : legendreSym 3 p = 1 := by
        have hp3m : p % 3 = 1 := by omega
        have hne : ((p : ℤ) : ZMod 3) ≠ 0 := by
          intro hz
          have : 3 ∣ p := (ZMod.natCast_eq_zero_iff p 3).mp (by simpa using hz)
          have : p = 3 := ((Nat.prime_dvd_prime_iff_eq three_prime Fact.out).mp this).symm
          exact goodRes_ne_three (Or.inl h) this
        have hsq : IsSquare ((p : ℤ) : ZMod 3) := by
          have hp1 : (p : ZMod 3) = 1 := (ZMod.natCast_eq_natCast_iff p 1 3).mpr hp3m
          exact ⟨1, by simp [hp1]⟩
        exact (legendreSym.eq_one_iff (p := 3) hne).2 hsq
      simp [h8, h3]
    · have h8 : ZMod.χ₈ p = -1 := by
        rw [ZMod.χ₈_nat_eq_if_mod_eight]
        have hodd : p % 2 ≠ 0 := by omega
        have : p % 8 = 5 := by omega
        simp [hodd, this]
      have h3 : legendreSym 3 p = -1 := by
        have hp3m : p % 3 = 2 := by omega
        have hns : ¬ IsSquare ((p : ℤ) : ZMod 3) := by
          have hp2' : (p : ZMod 3) = 2 := (ZMod.natCast_eq_natCast_iff p 2 3).mpr hp3m
          intro ⟨t, ht⟩
          exact zmod3_sq_ne_two t (by simpa [hp2'] using ht.symm)
        exact (legendreSym.eq_neg_one_iff (p := 3)).2 hns
      simp [h8, h3]
    · have h8 : ZMod.χ₈ p = 1 := by
        rw [ZMod.χ₈_nat_eq_if_mod_eight]
        have hodd : p % 2 ≠ 0 := by omega
        have : p % 8 = 7 := by omega
        simp [hodd, this]
      have h3 : legendreSym 3 p = 1 := by
        have hp3m : p % 3 = 1 := by omega
        have hne : ((p : ℤ) : ZMod 3) ≠ 0 := by
          intro hz
          have : 3 ∣ p := (ZMod.natCast_eq_zero_iff p 3).mp (by simpa using hz)
          have : p = 3 := ((Nat.prime_dvd_prime_iff_eq three_prime Fact.out).mp this).symm
          exact goodRes_ne_three (Or.inr (Or.inr (Or.inl h))) this
        have hsq : IsSquare ((p : ℤ) : ZMod 3) := by
          have hp1 : (p : ZMod 3) = 1 := (ZMod.natCast_eq_natCast_iff p 1 3).mpr hp3m
          exact ⟨1, by simp [hp1]⟩
        exact (legendreSym.eq_one_iff (p := 3) hne).2 hsq
      simp [h8, h3]
    · have h8 : ZMod.χ₈ p = -1 := by
        rw [ZMod.χ₈_nat_eq_if_mod_eight]
        have hodd : p % 2 ≠ 0 := by omega
        have : p % 8 = 3 := by omega
        simp [hodd, this]
      have h3 : legendreSym 3 p = -1 := by
        have hp3m : p % 3 = 2 := by omega
        have hns : ¬ IsSquare ((p : ℤ) : ZMod 3) := by
          have hp2' : (p : ZMod 3) = 2 := (ZMod.natCast_eq_natCast_iff p 2 3).mpr hp3m
          intro ⟨t, ht⟩
          exact zmod3_sq_ne_two t (by simpa [hp2'] using ht.symm)
        exact (legendreSym.eq_neg_one_iff (p := 3)).2 hns
      simp [h8, h3]

lemma exists_sq_eq_neg_six_good {p : ℕ} [Fact p.Prime] (h : IsGoodPrimeRes p) :
    ∃ a : ℤ, a * a ≡ -6 [ZMOD p] := by
  have hne6 := neg_six_ne_zero_mod_good h
  have his : IsSquare ((-6 : ℤ) : ZMod p) :=
    (legendreSym.eq_one_iff (p := p) hne6).1 (legendre_neg_six_eq_one_good h)
  obtain ⟨t, ht⟩ := his
  refine ⟨(t.val : ℤ), ?_⟩
  rw [← ZMod.intCast_eq_intCast_iff, Int.cast_mul]
  have : ((t.val : ℤ) : ZMod p) = t := by simp
  rw [this, ht.symm]

lemma int_modEq_mul {n m : ℕ} (hnm : Nat.Coprime n m) {a b : ℤ}
    (hn : a ≡ b [ZMOD n]) (hm : a ≡ b [ZMOD m]) :
    a ≡ b [ZMOD (n * m : ℕ)] := by
  have hnd : (n : ℤ) ∣ b - a := Int.modEq_iff_dvd.1 hn
  have hmd : (m : ℤ) ∣ b - a := Int.modEq_iff_dvd.1 hm
  have : ((n : ℤ) * m) ∣ b - a :=
    (Nat.Coprime.isCoprime hnm).mul_dvd hnd hmd
  exact Int.modEq_iff_dvd.2 (by simpa [Nat.cast_mul] using this)

lemma crt_sq_neg_six {p q : ℕ} [NeZero p] [NeZero q] (hpq : Nat.Coprime p q)
    {a b : ℤ} (ha : a * a ≡ -6 [ZMOD p]) (hb : b * b ≡ -6 [ZMOD q]) :
    ∃ c : ℤ, c * c ≡ -6 [ZMOD (p * q : ℕ)] := by
  let a0 := (a : ZMod p).val
  let b0 := (b : ZMod q).val
  let k := (Nat.chineseRemainder hpq a0 b0).1
  refine ⟨(k : ℤ), ?_⟩
  have hkp : k ≡ a0 [MOD p] := (Nat.chineseRemainder hpq a0 b0).2.1
  have hkq : k ≡ b0 [MOD q] := (Nat.chineseRemainder hpq a0 b0).2.2
  have hcp : (k : ℤ) ≡ a [ZMOD p] := by
    rw [← ZMod.intCast_eq_intCast_iff]
    have : (k : ZMod p) = (a0 : ZMod p) :=
      (ZMod.natCast_eq_natCast_iff k a0 p).mpr hkp
    simpa [a0] using this
  have hcq : (k : ℤ) ≡ b [ZMOD q] := by
    rw [← ZMod.intCast_eq_intCast_iff]
    have : (k : ZMod q) = (b0 : ZMod q) :=
      (ZMod.natCast_eq_natCast_iff k b0 q).mpr hkq
    simpa [b0] using this
  have h1 : (k : ℤ) * k ≡ -6 [ZMOD p] := (hcp.mul hcp).trans ha
  have h2 : (k : ℤ) * k ≡ -6 [ZMOD q] := (hcq.mul hcq).trans hb
  exact int_modEq_mul hpq h1 h2

def IsGoodNat (N : ℕ) : Prop :=
  N % 24 = 1 ∧ ∀ q ∈ N.primeFactors, IsBadPrimeRes q → Even (padicValNat q N)

lemma isGood_one : IsGoodNat 1 := by
  refine ⟨by decide, ?_⟩
  intro q hq
  have : q ∈ Nat.primeFactors 1 := hq
  simp at this

lemma form_mul_int (u v s t : ℤ) :
    (u * u + 24 * v * v) * (s * s + 24 * t * t) =
      (u * s + 24 * v * t) * (u * s + 24 * v * t) +
        24 * (u * t - v * s) * (u * t - v * s) := by ring

lemma represented_mul {A B : ℕ}
    (hA : ∃ u v : ℕ, u * u + 24 * v * v = A)
    (hB : ∃ s t : ℕ, s * s + 24 * t * t = B) :
    ∃ u v : ℕ, u * u + 24 * v * v = A * B := by
  obtain ⟨u, v, hu⟩ := hA
  obtain ⟨s, t, hs⟩ := hB
  let U : ℤ := u * s + 24 * v * t
  let V : ℤ := u * t - v * s
  have hUV : U * U + 24 * V * V = (A : ℤ) * B := by
    have := form_mul_int (u : ℤ) (v : ℤ) (s : ℤ) (t : ℤ)
    have hA' : ((u : ℤ) * u + 24 * v * v) = A := by exact_mod_cast hu
    have hB' : ((s : ℤ) * s + 24 * t * t) = B := by exact_mod_cast hs
    simpa [U, V, hA', hB'] using this.symm
  refine ⟨U.natAbs, V.natAbs, ?_⟩
  have hL : (U.natAbs * U.natAbs + 24 * V.natAbs * V.natAbs : ℕ) =
      (U * U + 24 * V * V).natAbs := by
    have hU : 0 ≤ U * U := mul_self_nonneg U
    have hV : 0 ≤ 24 * V * V := by nlinarith [mul_self_nonneg V]
    have : (U * U + 24 * V * V).natAbs = (U * U).natAbs + (24 * V * V).natAbs :=
      Int.natAbs_add_of_nonneg hU (by nlinarith [mul_self_nonneg V])
    have h24 : (24 * V * V : ℤ).natAbs = 24 * V.natAbs * V.natAbs := by
      have : (24 * V * V : ℤ) = (24 : ℤ) * (V * V) := by ring
      rw [this, Int.natAbs_mul, Int.natAbs_mul]
      ring
    rw [this, Int.natAbs_mul U U, h24]
  have hR : ((A : ℤ) * B).natAbs = A * B := by
    simp [Int.natAbs_mul]
  have := congrArg Int.natAbs hUV
  rw [← hL, hR] at this
  exact this

lemma represented_one : ∃ u v : ℕ, u * u + 24 * v * v = 1 :=
  ⟨1, 0, by decide⟩

lemma represented_sq (k : ℕ) : ∃ u v : ℕ, u * u + 24 * v * v = k * k :=
  ⟨k, 0, by ring⟩

-- Helpers for modular arithmetic of squares
lemma sq_mod_three (x : ℤ) : x * x % 3 = 0 ∨ x * x % 3 = 1 := by
  have : x % 3 = 0 ∨ x % 3 = 1 ∨ x % 3 = 2 := by omega
  have hx : x * x % 3 = (x % 3) * (x % 3) % 3 := Int.mul_emod _ _ _
  rcases this with h | h | h <;> simp [hx, h]

lemma sq_mod_four (x : ℤ) : x * x % 4 = 0 ∨ x * x % 4 = 1 := by
  have : x % 4 = 0 ∨ x % 4 = 1 ∨ x % 4 = 2 ∨ x % 4 = 3 := by omega
  have hx : x * x % 4 = (x % 4) * (x % 4) % 4 := Int.mul_emod _ _ _
  rcases this with h | h | h | h <;> simp [hx, h]

lemma sq_mod_twenty_four (z : ℤ) :
    z * z % 24 = 0 ∨ z * z % 24 = 1 ∨ z * z % 24 = 4 ∨
    z * z % 24 = 9 ∨ z * z % 24 = 12 ∨ z * z % 24 = 13 ∨
    z * z % 24 = 16 := by
  have : z % 24 = 0 ∨ z % 24 = 1 ∨ z % 24 = 2 ∨ z % 24 = 3 ∨
         z % 24 = 4 ∨ z % 24 = 5 ∨ z % 24 = 6 ∨ z % 24 = 7 ∨
         z % 24 = 8 ∨ z % 24 = 9 ∨ z % 24 = 10 ∨ z % 24 = 11 ∨
         z % 24 = 12 ∨ z % 24 = 13 ∨ z % 24 = 14 ∨ z % 24 = 15 ∨
         z % 24 = 16 ∨ z % 24 = 17 ∨ z % 24 = 18 ∨ z % 24 = 19 ∨
         z % 24 = 20 ∨ z % 24 = 21 ∨ z % 24 = 22 ∨ z % 24 = 23 := by omega
  rcases this with t | t | t | t | t | t | t | t | t | t | t | t |
                   t | t | t | t | t | t | t | t | t | t | t | t <;>
    simp [Int.mul_emod, t]

lemma odd_sq_mod_twenty_four {y : ℤ} (h : y % 2 = 1) :
    y * y % 24 = 1 ∨ y * y % 24 = 9 := by
  have : y % 24 = 1 ∨ y % 24 = 3 ∨ y % 24 = 5 ∨ y % 24 = 7 ∨
         y % 24 = 9 ∨ y % 24 = 11 ∨ y % 24 = 13 ∨ y % 24 = 15 ∨
         y % 24 = 17 ∨ y % 24 = 19 ∨ y % 24 = 21 ∨ y % 24 = 23 := by omega
  rcases this with t | t | t | t | t | t | t | t | t | t | t | t <;>
    simp [Int.mul_emod, t]

lemma even_sq_mod4 {x : ℤ} (h : x % 2 = 0) : x * x % 4 = 0 := by
  rw [Int.mul_emod]
  have : x % 4 = 0 ∨ x % 4 = 2 := by omega
  rcases this with t | t <;> simp [t]

lemma odd_sq_mod4 {x : ℤ} (h : x % 2 = 1) : x * x % 4 = 1 := by
  have : x % 4 = 1 ∨ x % 4 = 3 := by omega
  rcases this with u | u <;> simp [Int.mul_emod, u]

lemma six_mul_assoc (y : ℤ) : (6 * y * y : ℤ) = 6 * (y * y) := by ring

lemma six_y_sq_mod4 (y : ℤ) : (6 * y * y) % 4 = (2 * (y * y % 4)) % 4 := by
  rw [six_mul_assoc, Int.mul_emod]
  norm_num

lemma two_z_sq_mod (z n : ℤ) :
    (2 * z * z) % n = (2 * (z * z % n)) % n := by
  have : (2 * z * z : ℤ) = 2 * (z * z) := by ring
  rw [this, Int.mul_emod]
  have h := (Int.mul_emod (2 : ℤ) (z * z % n) n).symm
  simpa using h

lemma three_y_sq_mod (y n : ℤ) :
    (3 * y * y) % n = (3 * (y * y % n)) % n := by
  have : (3 * y * y : ℤ) = 3 * (y * y) := by ring
  rw [this, Int.mul_emod]
  have h := (Int.mul_emod (3 : ℤ) (y * y % n) n).symm
  simpa using h

lemma two_mul_N_mod4 {N : ℕ} (h : N % 2 = 1) : (2 * (N : ℤ)) % 4 = 2 := by
  have : N % 4 = 1 ∨ N % 4 = 3 := by omega
  rcases this with t | t
  · have hN : (N : ℤ) % 4 = 1 := nat_mod_int' t
    rw [Int.mul_emod, hN]; norm_num
  · have hN : (N : ℤ) % 4 = 3 := nat_mod_int' t
    rw [Int.mul_emod, hN]; norm_num

lemma four_reduces {N : ℕ} {x y : ℤ}
    (heq : x * x + 6 * y * y = 4 * (N : ℤ)) :
    ∃ x1 y1 : ℤ, x1 * x1 + 6 * y1 * y1 = (N : ℤ) := by
  have hsum4 : (x * x + 6 * y * y) % 4 = 0 := by
    rw [heq, Int.mul_emod]; norm_num
  have hxeven : x % 2 = 0 := by
    have : x % 2 = 0 ∨ x % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hx1 := odd_sq_mod4 t
      have hy4 := sq_mod_four y
      have h6y : (6 * y * y) % 4 = (2 * (y * y % 4)) % 4 := six_y_sq_mod4 y
      rcases hy4 with hy0 | hy1
      · have h6 : (6 * y * y) % 4 = 0 := by rw [h6y, hy0]; norm_num
        have : (x * x + 6 * y * y) % 4 = 1 := by
          rw [Int.add_emod, hx1, h6]; norm_num
        omega
      · have h6 : (6 * y * y) % 4 = 2 := by rw [h6y, hy1]; norm_num
        have : (x * x + 6 * y * y) % 4 = 3 := by
          rw [Int.add_emod, hx1, h6]; norm_num
        omega
  have hyeven : y % 2 = 0 := by
    have : y % 2 = 0 ∨ y % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hy1 := odd_sq_mod4 t
      have hx0 := even_sq_mod4 hxeven
      have h6 : (6 * y * y) % 4 = 2 := by rw [six_y_sq_mod4, hy1]; norm_num
      have : (x * x + 6 * y * y) % 4 = 2 := by
        rw [Int.add_emod, hx0, h6]; norm_num
      omega
  refine ⟨x / 2, y / 2, ?_⟩
  set x1 := x / 2
  set y1 := y / 2
  have hxeq : x = 2 * x1 := by omega
  have hyeq : y = 2 * y1 := by omega
  have h4 : 4 * (x1 * x1 + 6 * y1 * y1) = 4 * (N : ℤ) := by
    calc 4 * (x1 * x1 + 6 * y1 * y1)
        = (2 * x1) * (2 * x1) + 6 * (2 * y1) * (2 * y1) := by ring
      _ = x * x + 6 * y * y := by rw [← hxeq, ← hyeq]
      _ = 4 * (N : ℤ) := heq
  nlinarith

lemma six_reduces {N : ℕ} {x y : ℤ}
    (heq : x * x + 6 * y * y = 6 * (N : ℤ)) :
    ∃ x1 y1 : ℤ, x1 * x1 + 6 * y1 * y1 = (N : ℤ) := by
  have hxeven : x % 2 = 0 := by
    have : x % 2 = 0 ∨ x % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hx1 : x * x % 2 = 1 := by simp [Int.mul_emod, t]
      have h6 : (6 * y * y) % 2 = 0 := by
        rw [six_mul_assoc, Int.mul_emod]; norm_num
      have hsum : (x * x + 6 * y * y) % 2 = 1 := by
        rw [Int.add_emod, hx1, h6]; norm_num
      have hr : (6 * (N : ℤ)) % 2 = 0 := by rw [Int.mul_emod]; norm_num
      rw [heq, hr] at hsum
      exact absurd hsum (by decide)
  have hx3 : x % 3 = 0 := by
    have hsum : (x * x + 6 * y * y) % 3 = 0 := by
      rw [heq, Int.mul_emod]; norm_num
    have h6 : (6 * y * y) % 3 = 0 := by
      rw [six_mul_assoc, Int.mul_emod]; norm_num
    have hxsq0 : x * x % 3 = 0 := by
      have := hsum
      rw [Int.add_emod, h6] at this
      simpa using this
    have : x % 3 = 0 ∨ x % 3 = 1 ∨ x % 3 = 2 := by omega
    rcases this with u | u | u
    · exact u
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
  have hx6 : x % 6 = 0 := by omega
  obtain ⟨z, rfl⟩ : ∃ z, x = 6 * z := ⟨x / 6, by omega⟩
  refine ⟨y, z, ?_⟩
  have : 36 * z * z + 6 * y * y = 6 * (N : ℤ) := by
    convert heq using 1
    ring
  nlinarith

lemma two_ne_of_mod24_one {N : ℕ} (h : N % 24 = 1) {x y : ℤ}
    (heq : x * x + 6 * y * y = 2 * (N : ℤ)) : False := by
  have hodd : N % 2 = 1 := by omega
  have h2N4 := two_mul_N_mod4 hodd
  have hsum4 : (x * x + 6 * y * y) % 4 = 2 := by rw [heq, h2N4]
  have hxeven : x % 2 = 0 := by
    have : x % 2 = 0 ∨ x % 2 = 1 := by omega
    rcases this with t | t
    · exact t
    · have hx1 := odd_sq_mod4 t
      have : (x * x + 6 * y * y) % 4 = (1 + (6 * y * y) % 4) % 4 := by
        rw [Int.add_emod, hx1]
      rw [this] at hsum4
      have hy4 := sq_mod_four y
      rcases hy4 with hy0 | hy1
      · have h6 : (6 * y * y) % 4 = 0 := by rw [six_y_sq_mod4, hy0]; norm_num
        rw [h6] at hsum4; norm_num at hsum4
      · have h6 : (6 * y * y) % 4 = 2 := by rw [six_y_sq_mod4, hy1]; norm_num
        rw [h6] at hsum4; norm_num at hsum4
  have hyodd : y % 2 = 1 := by
    have : y % 2 = 0 ∨ y % 2 = 1 := by omega
    rcases this with t | t
    · have hx0 := even_sq_mod4 hxeven
      have hy0 := even_sq_mod4 t
      have h6 : (6 * y * y) % 4 = 0 := by rw [six_y_sq_mod4, hy0]; norm_num
      have : (x * x + 6 * y * y) % 4 = 0 := by
        rw [Int.add_emod, hx0, h6]; norm_num
      omega
    · exact t
  have hxeq : x = 2 * (x / 2) := by omega
  set z := x / 2
  have hNform : 2 * z * z + 3 * y * y = (N : ℤ) := by
    have : 4 * z * z + 6 * y * y = 2 * (N : ℤ) := by
      rw [hxeq] at heq
      convert heq using 1
      ring
    nlinarith
  have hy24 := odd_sq_mod_twenty_four hyodd
  have hz24 := sq_mod_twenty_four z
  have hN24val : (2 * z * z + 3 * y * y) % 24 = 1 := by
    rw [hNform]; exact nat_mod_int' h
  have hcontra : (2 * z * z + 3 * y * y) % 24 ≠ 1 := by
    rcases hz24 with hz | hz | hz | hz | hz | hz | hz <;>
      rcases hy24 with hy | hy
    all_goals
      have h2 : (2 * z * z) % 24 = (2 * (z * z % 24)) % 24 := two_z_sq_mod _ _
      have h3 : (3 * y * y) % 24 = (3 * (y * y % 24)) % 24 := three_y_sq_mod _ _
      rw [hz] at h2; rw [hy] at h3
      have hsum : (2 * z * z + 3 * y * y) % 24 =
          ((2 * z * z) % 24 + (3 * y * y) % 24) % 24 := Int.add_emod _ _ _
      rw [h2, h3] at hsum
      intro h'; rw [hsum] at h'; norm_num at h'
  exact hcontra hN24val

lemma three_ne_of_mod24_one {N : ℕ} (h : N % 24 = 1) {x y : ℤ}
    (heq : x * x + 6 * y * y = 3 * (N : ℤ)) : False := by
  have hN3nat : N % 3 = 1 := by omega
  have hN3 : (N : ℤ) % 3 = 1 := nat_mod_int' hN3nat
  have hsum : (x * x + 6 * y * y) % 3 = 0 := by
    rw [heq, Int.mul_emod, hN3]; norm_num
  have h6 : (6 * y * y) % 3 = 0 := by
    rw [six_mul_assoc, Int.mul_emod]; norm_num
  have hx3 : x * x % 3 = 0 := by
    have := hsum
    rw [Int.add_emod, h6] at this
    simpa using this
  have hx0 : x % 3 = 0 := by
    have : x % 3 = 0 ∨ x % 3 = 1 ∨ x % 3 = 2 := by omega
    rcases this with u | u | u
    · exact u
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
    · have : x * x % 3 = 1 := by simp [Int.mul_emod, u]
      omega
  obtain ⟨t, rfl⟩ : ∃ t, x = 3 * t := ⟨x / 3, by omega⟩
  have hNform : 3 * t * t + 2 * y * y = (N : ℤ) := by
    have : 9 * t * t + 6 * y * y = 3 * (N : ℤ) := by
      convert heq using 1
      ring
    nlinarith
  have hy2 : (2 * (y * y)) % 3 = 1 := by
    have hsum' : (3 * t * t + 2 * (y * y)) % 3 = 1 := by
      have : 3 * t * t + 2 * y * y = 3 * t * t + 2 * (y * y) := by ring
      rw [← this, hNform]; exact hN3
    have h3 : (3 * t * t) % 3 = 0 := by
      have : (3 * t * t : ℤ) = 3 * (t * t) := by ring
      rw [this, Int.mul_emod]; norm_num
    have := hsum'
    rw [Int.add_emod, h3] at this
    simpa using this
  rcases sq_mod_three y with hy | hy
  · have : (2 * (y * y)) % 3 = 0 := by rw [Int.mul_emod, hy]; norm_num
    omega
  · have : (2 * (y * y)) % 3 = 2 := by rw [Int.mul_emod, hy]; norm_num
    omega

lemma five_ne_of_mod24_one {N : ℕ} (h : N % 24 = 1) {x y : ℤ}
    (heq : x * x + 6 * y * y = 5 * (N : ℤ)) : False := by
  have hN3nat : N % 3 = 1 := by omega
  have hN3 : (N : ℤ) % 3 = 1 := nat_mod_int' hN3nat
  have hsum : (x * x + 6 * y * y) % 3 = 2 := by
    rw [heq, Int.mul_emod, hN3]; norm_num
  have h6 : (6 * y * y) % 3 = 0 := by
    rw [six_mul_assoc, Int.mul_emod]; norm_num
  have : x * x % 3 = 2 := by
    have := hsum
    rw [Int.add_emod, h6] at this
    simpa using this
  rcases sq_mod_three x with t | t <;> omega

lemma int_sq_le_of_natAbs {x : ℤ} {n : ℕ} (h : x.natAbs * x.natAbs ≤ n) :
    x * x ≤ (n : ℤ) := by
  have : (x.natAbs * x.natAbs : ℤ) ≤ n := Nat.cast_le.mpr h
  rwa [Int.natAbs_mul_self'] at this

lemma dvd_sq_add_six_of_thue {n : ℕ} {a x y : ℤ}
    (ha : a * a ≡ -6 [ZMOD n]) (hcong : a * y ≡ x [ZMOD n]) :
    (n : ℤ) ∣ x * x + 6 * y * y := by
  have hx2 : x * x ≡ (a * y) * (a * y) [ZMOD n] :=
    Int.ModEq.mul hcong.symm hcong.symm
  have hx2' : x * x ≡ (a * a) * (y * y) [ZMOD n] := by
    have : (a * y) * (a * y) = (a * a) * (y * y) := by ring
    rwa [this] at hx2
  have h6 : (a * a) * (y * y) ≡ (-6) * (y * y) [ZMOD n] :=
    Int.ModEq.mul ha rfl
  have : x * x ≡ -6 * (y * y) [ZMOD n] := hx2'.trans h6
  have : x * x + 6 * y * y ≡ 0 [ZMOD n] := by
    convert Int.ModEq.add_right (6 * y * y) this
    ring
  exact Int.modEq_zero_iff_dvd.mp this

lemma pos_sq_add_six {x y : ℤ} (hy : y ≠ 0) : 0 < x * x + 6 * y * y := by
  have : 0 < y * y := mul_self_pos.mpr hy
  nlinarith

lemma sq_add_six_le {x y : ℤ} {n : ℕ}
    (hx : x.natAbs * x.natAbs ≤ n) (hy : y.natAbs * y.natAbs ≤ n) :
    x * x + 6 * y * y ≤ 7 * (n : ℤ) := by
  have hx' := int_sq_le_of_natAbs hx
  have hy' := int_sq_le_of_natAbs hy
  nlinarith

lemma not_unit_of_mem_primeFactors {q N : ℕ} (hq : q ∈ N.primeFactors) : ¬ IsUnit q := by
  have hp := Nat.prime_of_mem_primeFactors hq
  intro hu
  have : q = 1 := Nat.isUnit_iff.mp hu
  exact Nat.not_prime_one (this ▸ hp)

/-- A squarefree good number has no bad prime factors. -/
lemma squarefree_good_no_bad {N : ℕ} (hg : IsGoodNat N) (hsf : Squarefree N) :
    ∀ q ∈ N.primeFactors, ¬ IsBadPrimeRes q := by
  intro q hq hb
  have he := hg.2 q hq hb
  have hp := Nat.prime_of_mem_primeFactors hq
  have hN0 : N ≠ 0 := fun h => by simp [h] at hq
  have hqN : q ∣ N := Nat.dvd_of_mem_primeFactors hq
  have : Fact q.Prime := ⟨hp⟩
  have h1 : padicValNat q N = 1 := by
    have hpos : 1 ≤ padicValNat q N := one_le_padicValNat_of_dvd hN0 hqN
    have hle : padicValNat q N ≤ 1 := by
      by_contra hgt
      have h2 : 2 ≤ padicValNat q N := by omega
      have hdvd : q ^ 2 ∣ N := (padicValNat_dvd_iff_le hN0).mpr h2
      have : q * q ∣ N := by simpa [pow_two] using hdvd
      exact not_unit_of_mem_primeFactors hq (hsf q this)
    omega
  have : ¬ Even (1 : ℕ) := by decide
  rw [h1] at he
  exact this he

lemma prime_coprime_twenty_four {q : ℕ} (hp : Nat.Prime q) (hne2 : q ≠ 2) (hne3 : q ≠ 3) :
    q % 24 = 1 ∨ q % 24 = 5 ∨ q % 24 = 7 ∨ q % 24 = 11 ∨
    q % 24 = 13 ∨ q % 24 = 17 ∨ q % 24 = 19 ∨ q % 24 = 23 := by
  have h2 : ¬ 2 ∣ q := by
    intro hd
    exact hne2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp hd).symm
  have h3 : ¬ 3 ∣ q := by
    intro hd
    exact hne3 ((Nat.prime_dvd_prime_iff_eq three_prime hp).mp hd).symm
  have h2mod : q % 2 ≠ 0 := fun h => h2 (Nat.dvd_of_mod_eq_zero h)
  have h3mod : q % 3 ≠ 0 := fun h => h3 (Nat.dvd_of_mod_eq_zero h)
  omega

lemma primeFactors_good_of_squarefree_good {N : ℕ} (hg : IsGoodNat N)
    (hsf : Squarefree N) {q : ℕ} (hq : q ∈ N.primeFactors) :
    IsGoodPrimeRes q := by
  have hp := Nat.prime_of_mem_primeFactors hq
  have hN1 : N % 24 = 1 := hg.1
  have hqN : q ∣ N := Nat.dvd_of_mem_primeFactors hq
  have hq_ne2 : q ≠ 2 := by
    intro h2; subst h2
    have : 2 ∣ N := hqN
    omega
  have hq_ne3 : q ≠ 3 := by
    intro h3; subst h3
    have : 3 ∣ N := hqN
    omega
  have hnb : ¬ IsBadPrimeRes q := squarefree_good_no_bad hg hsf q hq
  have hmod := prime_coprime_twenty_four hp hq_ne2 hq_ne3
  unfold IsGoodPrimeRes
  unfold IsBadPrimeRes at hnb
  rcases hmod with h | h | h | h | h | h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr h))
  · exact (hnb (Or.inl h)).elim
  · exact (hnb (Or.inr (Or.inl h))).elim
  · exact (hnb (Or.inr (Or.inr (Or.inl h)))).elim
  · exact (hnb (Or.inr (Or.inr (Or.inr h)))).elim

lemma exists_sq_neg_six_of_prime_factor {N q : ℕ} [Fact q.Prime]
    (hg : IsGoodNat N) (hsf : Squarefree N) (hq : q ∈ N.primeFactors) :
    ∃ a : ℤ, a * a ≡ -6 [ZMOD q] :=
  exists_sq_eq_neg_six_good (primeFactors_good_of_squarefree_good hg hsf hq)

/-- `-6` is a square modulo a squarefree good number. -/
lemma exists_sq_neg_six_of_squarefree_good {N : ℕ} (hg : IsGoodNat N)
    (hsf : Squarefree N) (hN0 : N ≠ 0) :
    ∃ a : ℤ, a * a ≡ -6 [ZMOD N] := by
  have hprod : (∏ p ∈ N.primeFactors, p) = N := Nat.prod_primeFactors_of_squarefree hsf
  suffices ∀ s : Finset ℕ, (∀ q ∈ s, q ∈ N.primeFactors) →
      ∃ a : ℤ, a * a ≡ -6 [ZMOD (∏ p ∈ s, p : ℕ)] by
    have := this N.primeFactors (fun q hq => hq)
    rwa [hprod] at this
  intro s
  induction s using Finset.induction_on with
  | empty =>
    intro _
    refine ⟨0, ?_⟩
    simp [Int.modEq_iff_dvd]
  | insert q s hqs ih =>
    intro hs
    have hqN : q ∈ N.primeFactors := hs q (Finset.mem_insert_self _ _)
    have hsN : ∀ p ∈ s, p ∈ N.primeFactors := fun p hp =>
      hs p (Finset.mem_insert_of_mem hp)
    obtain ⟨b, hb⟩ := ih hsN
    have hpq : Nat.Prime q := Nat.prime_of_mem_primeFactors hqN
    have : Fact q.Prime := ⟨hpq⟩
    obtain ⟨a, ha⟩ := exists_sq_neg_six_of_prime_factor hg hsf hqN
    have hcop : Nat.Coprime q (∏ p ∈ s, p) := by
      rw [Nat.coprime_prod_right_iff]
      intro p hp
      have hpp : Nat.Prime p := Nat.prime_of_mem_primeFactors (hsN p hp)
      have hne : q ≠ p := fun h => hqs (h ▸ hp)
      exact (Nat.coprime_primes hpq hpp).2 hne
    have : NeZero q := ⟨hpq.ne_zero⟩
    have hprod0 : (∏ p ∈ s, p) ≠ 0 := by
      intro h0
      obtain ⟨p, hp, hp0⟩ := Finset.prod_eq_zero_iff.mp h0
      exact (Nat.prime_of_mem_primeFactors (hsN p hp)).ne_zero hp0
    have : NeZero (∏ p ∈ s, p) := ⟨hprod0⟩
    obtain ⟨c, hc⟩ := crt_sq_neg_six hcop ha hb
    refine ⟨c, ?_⟩
    simpa [Finset.prod_insert hqs] using hc

lemma exists_sq_add_six_eq_kN {N : ℕ} (hg : IsGoodNat N) (hsf : Squarefree N)
    (hN1 : 1 < N) :
    ∃ (x y : ℤ) (k : ℕ), y ≠ 0 ∧ 1 ≤ k ∧ k ≤ 7 ∧
      x.natAbs * x.natAbs ≤ N ∧ y.natAbs * y.natAbs ≤ N ∧
      x * x + 6 * y * y = k * (N : ℤ) := by
  have hN0 : N ≠ 0 := by omega
  obtain ⟨a, ha⟩ := exists_sq_neg_six_of_squarefree_good hg hsf hN0
  obtain ⟨x, y, hy0, hxle, hyle, hcong⟩ := thue_lemma_of_one_lt N hN1 a
  have hdiv := dvd_sq_add_six_of_thue ha hcong
  have hpos := pos_sq_add_six (x := x) hy0
  have hle := sq_add_six_le (n := N) hxle hyle
  obtain ⟨k', hk'⟩ := hdiv
  have hk'pos : 0 < k' := by
    have : 0 < (N : ℤ) * k' := by rwa [← hk']
    have hNpos : (0 : ℤ) < N := by exact_mod_cast (Nat.zero_lt_of_lt hN1)
    nlinarith
  set kn := k'.toNat
  have k'n : k' = (kn : ℤ) := (Int.toNat_of_nonneg (le_of_lt hk'pos)).symm
  have hkn : x * x + 6 * y * y = (kn : ℤ) * (N : ℤ) := by
    rw [hk', k'n, mul_comm]
  have hk1 : 1 ≤ kn := by
    have : (1 : ℤ) ≤ k' := by omega
    have : (1 : ℤ) ≤ (kn : ℤ) := by rwa [← k'n]
    exact_mod_cast this
  have hk7 : kn ≤ 7 := by
    have : (kn : ℤ) * (N : ℤ) ≤ 7 * (N : ℤ) := by rwa [← hkn]
    have hNpos : (0 : ℤ) < N := by exact_mod_cast (Nat.zero_lt_of_lt hN1)
    have : (kn : ℤ) ≤ 7 := by nlinarith
    exact_mod_cast this
  exact ⟨x, y, kn, hy0, hk1, hk7, hxle, hyle, hkn⟩

lemma not_square_of_squarefree {N a : ℕ} (hsf : Squarefree N) (hN1 : 1 < N)
    (hNsq : N = a * a) : False := by
  have ha0 : a ≠ 0 := by
    intro h; subst h; subst hNsq; exact (lt_irrefl 0 (lt_trans Nat.zero_lt_one hN1))
  have ha1 : a ≠ 1 := by
    intro h; subst h; rw [one_mul] at hNsq; exact (ne_of_gt hN1) hNsq
  have : ¬ IsUnit a := fun hu => ha1 (Nat.isUnit_iff.mp hu)
  exact this (hsf a (by rw [hNsq]))

lemma eq_natAbs_mul_of_sq {x : ℤ} {N : ℕ} (h : (N : ℤ) = x * x) :
    N = x.natAbs * x.natAbs := by
  have := congrArg Int.natAbs h
  simpa [Int.natAbs_mul, Int.natAbs_natCast] using this

lemma seven_ne_of_squarefree {N : ℕ} (hsf : Squarefree N) (hN1 : 1 < N)
    {x y : ℤ} (hx : x.natAbs * x.natAbs ≤ N) (hy : y.natAbs * y.natAbs ≤ N)
    (heq : x * x + 6 * y * y = 7 * (N : ℤ)) : False := by
  have hx' := int_sq_le_of_natAbs hx
  have hy' := int_sq_le_of_natAbs hy
  have hxeq : x * x = (N : ℤ) := by nlinarith
  exact not_square_of_squarefree hsf hN1 (eq_natAbs_mul_of_sq hxeq.symm)

lemma y_even_of_sq_add_six_mod24_one {N : ℕ} {x y : ℤ}
    (h : N % 24 = 1) (heq : x * x + 6 * y * y = (N : ℤ)) :
    y % 2 = 0 := by
  have : y % 2 = 0 ∨ y % 2 = 1 := by omega
  rcases this with t | t
  · exact t
  · have hy24 := odd_sq_mod_twenty_four t
    have hx24 := sq_mod_twenty_four x
    have hN24 : (x * x + 6 * (y * y)) % 24 = 1 := by
      have : x * x + 6 * y * y = x * x + 6 * (y * y) := by ring
      rw [← this, heq]
      exact nat_mod_int' h
    have hcontra : (x * x + 6 * (y * y)) % 24 ≠ 1 := by
      rcases hx24 with hx | hx | hx | hx | hx | hx | hx <;>
        rcases hy24 with hy | hy
      all_goals
        have h6 : (6 * (y * y)) % 24 = (6 * (y * y % 24)) % 24 := by
          rw [Int.mul_emod]
          have hh := (Int.mul_emod (6 : ℤ) (y * y % 24) 24).symm
          simpa using hh
        rw [hy] at h6
        have hsum : (x * x + 6 * (y * y)) % 24 =
            (x * x % 24 + (6 * (y * y)) % 24) % 24 := Int.add_emod _ _ _
        rw [hsum, hx, h6]
        norm_num
    exact (hcontra hN24).elim

lemma int_sq_add_six_to_nat {x y : ℤ} {N : ℕ}
    (h : x * x + 6 * y * y = (N : ℤ)) :
    x.natAbs * x.natAbs + 6 * y.natAbs * y.natAbs = N := by
  have hx : (x * x).natAbs = x.natAbs * x.natAbs := Int.natAbs_mul x x
  have hy6 : (6 * y * y : ℤ).natAbs = 6 * y.natAbs * y.natAbs := by
    have : (6 * y * y : ℤ) = (6 : ℤ) * (y * y) := by ring
    rw [this, Int.natAbs_mul, Int.natAbs_mul]
    ring
  have hsum : 0 ≤ x * x := mul_self_nonneg x
  have h6n : 0 ≤ (6 * y * y : ℤ) := by
    have : (6 * y * y : ℤ) = 6 * (y * y) := by ring
    rw [this]; nlinarith [mul_self_nonneg y]
  have hL : (x * x + 6 * y * y).natAbs =
      x.natAbs * x.natAbs + 6 * y.natAbs * y.natAbs := by
    rw [Int.natAbs_add_of_nonneg hsum h6n, hx, hy6]
  have hR : (N : ℤ).natAbs = N := Int.natAbs_natCast N
  have := congrArg Int.natAbs h
  rw [hL, hR] at this
  exact this

lemma squarefree_good_eq_sq_add_six {N : ℕ} (hg : IsGoodNat N)
    (hsf : Squarefree N) (hN1 : 1 < N) :
    ∃ x y : ℤ, y ≠ 0 ∧ x * x + 6 * y * y = (N : ℤ) := by
  obtain ⟨x, y, k, hy0, hk1, hk7, hxle, hyle, heq⟩ :=
    exists_sq_add_six_eq_kN hg hsf hN1
  have h24 : N % 24 = 1 := hg.1
  interval_cases k
  · exact ⟨x, y, hy0, by simpa using heq⟩
  · exact (two_ne_of_mod24_one h24 heq).elim
  · exact (three_ne_of_mod24_one h24 heq).elim
  · obtain ⟨x1, y1, h1⟩ := four_reduces heq
    have hy1 : y1 ≠ 0 := by
      intro h0
      rw [h0] at h1
      have hNsq : (N : ℤ) = x1 * x1 := by simpa using h1.symm
      exact not_square_of_squarefree hsf hN1 (eq_natAbs_mul_of_sq hNsq)
    exact ⟨x1, y1, hy1, h1⟩
  · exact (five_ne_of_mod24_one h24 heq).elim
  · obtain ⟨x1, y1, h1⟩ := six_reduces heq
    have hy1 : y1 ≠ 0 := by
      intro h0
      rw [h0] at h1
      have hNsq : (N : ℤ) = x1 * x1 := by simpa using h1.symm
      exact not_square_of_squarefree hsf hN1 (eq_natAbs_mul_of_sq hNsq)
    exact ⟨x1, y1, hy1, h1⟩
  · exact (seven_ne_of_squarefree hsf hN1 hxle hyle heq).elim

lemma squarefree_good_eq_u24v {N : ℕ} (hg : IsGoodNat N)
    (hsf : Squarefree N) (hN1 : 1 < N) :
    ∃ u v : ℕ, u * u + 24 * v * v = N := by
  obtain ⟨x, y, hy0, heq⟩ := squarefree_good_eq_sq_add_six hg hsf hN1
  have hye := y_even_of_sq_add_six_mod24_one hg.1 heq
  have hyeq : y = 2 * (y / 2) := by omega
  have heq' : x * x + 24 * (y / 2) * (y / 2) = (N : ℤ) := by
    rw [hyeq] at heq
    convert heq using 1
    ring
  refine ⟨x.natAbs, (y / 2).natAbs, ?_⟩
  have hU : 0 ≤ x * x := mul_self_nonneg x
  have hV : 0 ≤ (24 : ℤ) * (y / 2) * (y / 2) := by nlinarith [mul_self_nonneg (y / 2)]
  have hsum := Int.natAbs_add_of_nonneg hU hV
  have hx : (x * x).natAbs = x.natAbs * x.natAbs := Int.natAbs_mul x x
  have h24 : ((24 : ℤ) * (y / 2) * (y / 2)).natAbs =
      24 * (y / 2).natAbs * (y / 2).natAbs := by
    have : (24 * (y / 2) * (y / 2) : ℤ) = (24 : ℤ) * ((y / 2) * (y / 2)) := by ring
    rw [this, Int.natAbs_mul, Int.natAbs_mul]; ring
  have := congrArg Int.natAbs heq'
  have hL : (x * x + 24 * (y / 2) * (y / 2)).natAbs =
      x.natAbs * x.natAbs + 24 * (y / 2).natAbs * (y / 2).natAbs := by
    rw [hsum, hx, h24]
  have hR : (N : ℤ).natAbs = N := Int.natAbs_natCast N
  rw [hL, hR] at this
  exact this

lemma sq_mod_twenty_four_of_coprime_six {s : ℕ} (h2 : ¬ 2 ∣ s) (h3 : ¬ 3 ∣ s) :
    (s * s) % 24 = 1 := by
  have hs2 : s % 2 = 1 := by
    have : s % 2 = 0 ∨ s % 2 = 1 := by omega
    rcases this with t | t
    · exact absurd (Nat.dvd_of_mod_eq_zero t) h2
    · exact t
  have hs3 : s % 3 ≠ 0 := fun t => h3 (Nat.dvd_of_mod_eq_zero t)
  -- s odd and not multiple of 3 ⇒ s % 24 ∈ {1,5,7,11,13,17,19,23}
  have : s % 24 = 1 ∨ s % 24 = 5 ∨ s % 24 = 7 ∨ s % 24 = 11 ∨
         s % 24 = 13 ∨ s % 24 = 17 ∨ s % 24 = 19 ∨ s % 24 = 23 := by omega
  rcases this with t | t | t | t | t | t | t | t <;> simp [Nat.mul_mod, t]

lemma not_two_dvd_of_mod24_one {N : ℕ} (h : N % 24 = 1) : ¬ 2 ∣ N := by
  intro hd
  have : N % 2 = 0 := Nat.mod_eq_zero_of_dvd hd
  omega

lemma not_three_dvd_of_mod24_one {N : ℕ} (h : N % 24 = 1) : ¬ 3 ∣ N := by
  intro hd
  have : N % 3 = 0 := Nat.mod_eq_zero_of_dvd hd
  omega

lemma isGood_mul_of_sq {s M : ℕ} (hM0 : M ≠ 0)
    (hg : IsGoodNat (s * s * M)) : IsGoodNat M := by
  have hN24 : (s * s * M) % 24 = 1 := hg.1
  have hN2 : ¬ 2 ∣ s * s * M := not_two_dvd_of_mod24_one hN24
  have hN3 : ¬ 3 ∣ s * s * M := not_three_dvd_of_mod24_one hN24
  have hs2 : ¬ 2 ∣ s := fun h => hN2 (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left h _) _)
  have hs3 : ¬ 3 ∣ s := fun h => hN3 (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left h _) _)
  have hs24 : (s * s) % 24 = 1 := sq_mod_twenty_four_of_coprime_six hs2 hs3
  have hM24 : M % 24 = 1 := by
    have : (s * s * M) % 24 = ((s * s) % 24 * (M % 24)) % 24 := Nat.mul_mod _ _ _
    rw [this, hs24] at hN24
    have : (1 * (M % 24)) % 24 = 1 := hN24
    simpa using this
  refine ⟨hM24, ?_⟩
  intro q hq hb
  have hp := Nat.prime_of_mem_primeFactors hq
  have hqM : q ∣ M := Nat.dvd_of_mem_primeFactors hq
  have hqN : q ∣ s * s * M := dvd_mul_of_dvd_right hqM _
  have hN0 : s * s * M ≠ 0 := mul_ne_zero (mul_ne_zero (by
    intro h; subst h; simp at hs24) (by
    intro h; subst h; simp at hs24)) hM0
  have hq_in : q ∈ (s * s * M).primeFactors := by
    exact Nat.mem_primeFactors.mpr ⟨hp, hqN, hN0⟩
  have he := hg.2 q hq_in hb
  -- padicValNat q (s² M) = padicValNat q (s²) + padicValNat q M
  -- padicValNat q (s²) is even, so even-ness of the sum iff even-ness of padicValNat q M
  have : Fact q.Prime := ⟨hp⟩
  have hsum : padicValNat q (s * s * M) =
      padicValNat q (s * s) + padicValNat q M := by
    have hs20 : s * s ≠ 0 := by
      intro h
      have : s = 0 := Nat.mul_eq_zero.mp h |>.elim id id
      subst this; simp at hs24
    exact padicValNat.mul hs20 hM0
  have heven_sq : Even (padicValNat q (s * s)) := by
    have : padicValNat q (s * s) = padicValNat q s + padicValNat q s := by
      have hs0 : s ≠ 0 := fun h => by subst h; simp at hs24
      rw [padicValNat.mul hs0 hs0]
    exact ⟨padicValNat q s, this⟩
  have hab : Even (padicValNat q (s * s) + padicValNat q M) := by
    rwa [← hsum]
  exact (Nat.even_add.mp hab).mp heven_sq

lemma good_implies_represented {N : ℕ} (hg : IsGoodNat N) :
    ∃ u v : ℕ, u * u + 24 * v * v = N := by
  rcases Nat.eq_zero_or_pos N with rfl | hpos
  · have : (0 : ℕ) % 24 = 1 := hg.1
    exact absurd this (by decide)
  obtain ⟨M, s, hMpos, _hspos, hfac, hsf⟩ := Nat.sq_mul_squarefree_of_pos hpos
  -- hfac : s ^ 2 * M = N
  have hNeq : s * s * M = N := by
    rw [← hfac, pow_two]
  have hM0 : M ≠ 0 := Nat.pos_iff_ne_zero.mp hMpos
  have hgM : IsGoodNat M := by
    have hg' : IsGoodNat (s * s * M) := by rwa [hNeq]
    exact isGood_mul_of_sq hM0 hg'
  have hMrep : ∃ u v : ℕ, u * u + 24 * v * v = M := by
    rcases eq_or_ne M 1 with rfl | hMne
    · exact represented_one
    · have hM1 : 1 < M := by
        have : 0 < M := hMpos
        omega
      exact squarefree_good_eq_u24v hgM hsf hM1
  have hsrep : ∃ u v : ℕ, u * u + 24 * v * v = s * s := represented_sq s
  obtain ⟨u, v, h⟩ := represented_mul hsrep hMrep
  refine ⟨u, v, ?_⟩
  rw [h, hNeq]

#check good_implies_represented





end A270966Rep

/- ### No small bad prime factor implies good -/

def IsGoodRes (n : ℕ) : Prop :=
  n % 24 = 1 ∨ n % 24 = 5 ∨ n % 24 = 7 ∨ n % 24 = 11

def IsBadRes (n : ℕ) : Prop :=
  n % 24 = 13 ∨ n % 24 = 17 ∨ n % 24 = 19 ∨ n % 24 = 23

lemma goodRes_mul {a b : ℕ} (ha : IsGoodRes a) (hb : IsGoodRes b) :
    IsGoodRes (a * b) := by
  unfold IsGoodRes at *
  rcases ha with ha | ha | ha | ha <;> rcases hb with hb | hb | hb | hb <;>
    simp [Nat.mul_mod, ha, hb]

lemma goodRes_one : IsGoodRes 1 := Or.inl (by decide)

lemma goodRes_pow {a : ℕ} (ha : IsGoodRes a) (e : ℕ) : IsGoodRes (a ^ e) := by
  induction e with
  | zero => simpa using goodRes_one
  | succ e ih =>
    rw [pow_succ]
    exact goodRes_mul ih ha

lemma prime_mod24_of_ne_two_three {p : ℕ} (hp : Nat.Prime p) (hne2 : p ≠ 2) (hne3 : p ≠ 3) :
    IsGoodRes p ∨ IsBadRes p := by
  have hodd : p % 2 = 1 := by
    rcases hp.eq_two_or_odd with rfl | ho
    · exact absurd rfl hne2
    · exact ho
  have h3 : p % 3 ≠ 0 := by
    intro h0
    have : 3 ∣ p := Nat.dvd_of_mod_eq_zero h0
    have : p = 3 := ((Nat.prime_dvd_prime_iff_eq (by decide : Nat.Prime 3) hp).1 this).symm
    exact hne3 this
  have : p % 24 = 1 ∨ p % 24 = 5 ∨ p % 24 = 7 ∨ p % 24 = 11 ∨
         p % 24 = 13 ∨ p % 24 = 17 ∨ p % 24 = 19 ∨ p % 24 = 23 := by omega
  unfold IsGoodRes IsBadRes
  tauto

lemma prod_goodRes {s : Finset ℕ} {f : ℕ → ℕ} (h : ∀ p ∈ s, IsGoodRes (f p)) :
    IsGoodRes (s.prod f) := by
  induction s using Finset.induction with
  | empty => simpa using goodRes_one
  | insert a s ha ih =>
    rw [Finset.prod_insert ha]
    exact goodRes_mul (h a (Finset.mem_insert_self a s))
      (ih fun p hp => h p (Finset.mem_insert_of_mem hp))

lemma exists_bad_factor_of_bad_mod24 {k : ℕ} (hkpos : 0 < k)
    (h2 : ¬ 2 ∣ k) (h3 : ¬ 3 ∣ k) (hbad : IsBadRes k) :
    ∃ q ∈ k.primeFactors, A270966Rep.IsBadPrimeRes q := by
  by_contra! hall
  have hne1 : 1 < k := by
    apply lt_of_le_of_ne (Nat.succ_le_of_lt hkpos)
    intro h; subst h; unfold IsBadRes at hbad; simp at hbad
  have hgood : ∀ p ∈ k.primeFactors, IsGoodRes p := by
    intro p hp
    have hpp : Nat.Prime p := Nat.prime_of_mem_primeFactors hp
    have hp2 : p ≠ 2 := fun h => h2 (h ▸ Nat.dvd_of_mem_primeFactors hp)
    have hp3 : p ≠ 3 := fun h => h3 (h ▸ Nat.dvd_of_mem_primeFactors hp)
    rcases prime_mod24_of_ne_two_three hpp hp2 hp3 with hg | hb
    · exact hg
    · exact absurd hb (hall p hp)
  have : IsGoodRes k := by
    have hfac : k.factorization.prod (· ^ ·) = k :=
      Nat.factorization_prod_pow_eq_self (ne_of_gt hkpos)
    rw [Finsupp.prod, Nat.support_factorization] at hfac
    rw [← hfac]
    refine prod_goodRes ?_
    intro p hp
    exact goodRes_pow (hgood p hp) _
  unfold IsGoodRes at this
  unfold IsBadRes at hbad
  rcases this with h | h | h | h <;> rcases hbad with hb | hb | hb | hb <;> omega

lemma badRes_sq {q : ℕ} (h : IsBadRes q) : (q * q) % 24 = 1 := by
  unfold IsBadRes at h
  rcases h with h | h | h | h <;> simp [Nat.mul_mod, h]

lemma inv_unique_mod24 {q k : ℕ} (hqs : (q * q) % 24 = 1)
    (hqk : (q * k) % 24 = 1) : k % 24 = q % 24 := by
  have h1 : (q % 24 * (q % 24)) % 24 = 1 := by rwa [← Nat.mul_mod]
  have h2 : (q % 24 * (k % 24)) % 24 = 1 := by rwa [← Nat.mul_mod]
  set a := q % 24
  set b := k % 24
  have ha : a < 24 := Nat.mod_lt _ (by decide)
  have hb : b < 24 := Nat.mod_lt _ (by decide)
  interval_cases a <;> simp at h1 <;> interval_cases b <;> simp at h2 <;> rfl

lemma bad_mul_eq_of_sq {q k N : ℕ} (hN : N % 24 = 1) (hq : IsBadRes q)
    (hdiv : N = q * k) : k % 24 = q % 24 := by
  have hqq : (q * q) % 24 = 1 := badRes_sq hq
  have hqk : (q * k) % 24 = 1 := by rw [← hdiv]; exact hN
  exact inv_unique_mod24 hqq hqk

lemma isGood_of_no_small_bad {N : ℕ} (h24 : N % 24 = 1)
    (hsmall : ∀ q ∈ N.primeFactors, A270966Rep.IsBadPrimeRes q → N < q * q) :
    A270966Rep.IsGoodNat N := by
  refine ⟨h24, ?_⟩
  intro q hq hb
  exfalso
  have hqP : Nat.Prime q := Nat.prime_of_mem_primeFactors hq
  have hqN : q ∣ N := Nat.dvd_of_mem_primeFactors hq
  have hN0 : N ≠ 0 := (Nat.mem_primeFactors.mp hq).2.2
  have hNpos : 0 < N := Nat.pos_of_ne_zero hN0
  obtain ⟨k, hk⟩ := hqN
  have hkpos : 0 < k := by
    have : 0 < q * k := by rw [← hk]; exact hNpos
    exact Nat.pos_of_mul_pos_left this
  have hqlt : N < q * q := hsmall q hq hb
  have hklt : k < q := by
    have : q * k < q * q := by rwa [← hk]
    exact Nat.lt_of_mul_lt_mul_left this
  have h2N : ¬ 2 ∣ N := A270966Rep.not_two_dvd_of_mod24_one h24
  have h3N : ¬ 3 ∣ N := A270966Rep.not_three_dvd_of_mod24_one h24
  have h2k : ¬ 2 ∣ k := fun h => h2N (hk ▸ dvd_mul_of_dvd_right h q)
  have h3k : ¬ 3 ∣ k := fun h => h3N (hk ▸ dvd_mul_of_dvd_right h q)
  have hb' : IsBadRes q := hb
  have hkmod : k % 24 = q % 24 := bad_mul_eq_of_sq h24 hb' hk
  have hkbd : IsBadRes k := by
    unfold IsBadRes at hb' ⊢
    rcases hb' with h | h | h | h <;> simp [hkmod, h]
  obtain ⟨r, hr, hrb⟩ := exists_bad_factor_of_bad_mod24 hkpos h2k h3k hkbd
  have hrN : r ∈ N.primeFactors := by
    have hrP : Nat.Prime r := Nat.prime_of_mem_primeFactors hr
    have hrk : r ∣ k := Nat.dvd_of_mem_primeFactors hr
    have hrN' : r ∣ N := by
      rw [hk]; exact dvd_mul_of_dvd_right hrk q
    exact Nat.mem_primeFactors.mpr ⟨hrP, hrN', hN0⟩
  have hrr : N < r * r := hsmall r hrN hrb
  have hrle : r ≤ k := Nat.le_of_dvd hkpos (Nat.dvd_of_mem_primeFactors hr)
  have hqgt : r < q := lt_of_le_of_lt hrle hklt
  have hr2 : 2 ≤ r := Nat.Prime.two_le (Nat.prime_of_mem_primeFactors hr)
  have hposr : 0 < r := lt_of_lt_of_le (by decide : (0:ℕ) < 2) hr2
  have h1 : r * r < q * r := Nat.mul_lt_mul_of_pos_right hqgt hposr
  have h2 : r * r < q * k := lt_of_lt_of_le h1 (Nat.mul_le_mul_left q hrle)
  have hfinal : r * r < N := hk ▸ h2
  exact lt_irrefl _ (lt_trans hfinal hrr)

lemma exists_pred_of_good {n x : ℕ}
    (hxle : x * x ≤ n) (hp : Nat.Prime (x + 1))
    (hg : A270966Rep.IsGoodNat (24 * (n - x * x) + 1)) :
    ∃ y, A270966.Pred n (if x ≤ y then (x, y) else (y, x)) := by
  obtain ⟨u, v, h⟩ := A270966Rep.good_implies_represented hg
  refine ⟨v, pred_of_x_u24v (u := u) hxle hp ?_⟩
  convert h using 1
  ring

lemma A270966_pos_of_le_2100 {n : ℕ} (hn : 0 < n) (hn' : n ≤ 2100) :
    0 < A270966 n := by
  rcases le_or_gt n 2000 with h2000 | h2000
  · exact A270966_pos_of_le_2000 hn h2000
  rcases eq_or_ne n 1 with rfl | _
  · exact lt_of_lt_of_le (by decide : (0 : ℕ) < 1) A270966_one_ge
  have : 2001 ≤ n := by omega
  exact lt_of_lt_of_le (by decide : (0 : ℕ) < 2) (ge2_2001_2100 this hn')

lemma A270966_eq_one_imp_of_le_2100 {n : ℕ} (hn : n ≤ 2100)
    (h : A270966 n = 1) : n = 1 ∨ n = 49 ∨ n = 608 := by
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · exact absurd h A270966_zero_ne_one
  rcases le_or_gt n 2000 with h2000 | h2000
  · rcases eq_or_ne n 1 with rfl | h1
    · exact Or.inl rfl
    rcases eq_or_ne n 49 with rfl | h49
    · exact Or.inr (Or.inl rfl)
    rcases eq_or_ne n 608 with rfl | h608
    · exact Or.inr (Or.inr rfl)
    have hn2 : 2 ≤ n := by omega
    have : 2 ≤ A270966 n := ge2_of_le_2000 hn2 h2000 h49 h608
    omega
  · have : 2001 ≤ n := by omega
    have : 2 ≤ A270966 n := ge2_2001_2100 this hn
    omega

/- Chebyshev lower bound on π. -/

open scoped Nat.Prime Chebyshev
open Chebyshev Finset Real Nat
open ArithmeticFunction hiding log

lemma natLog_mul_log_le {p n : ℕ} (hp : 1 < p) (_hn : n ≠ 0) :
    (Nat.log p n : ℝ) * Real.log p ≤ Real.log n := by
  have hle : (Nat.log p n : ℝ) ≤ Real.logb p n := natLog_le_logb n p
  have hplog : 0 < Real.log p := log_pos (Nat.one_lt_cast.mpr hp)
  calc
    (Nat.log p n : ℝ) * Real.log p ≤ Real.logb p n * Real.log p := by gcongr
    _ = Real.log n := by
      rw [Real.logb, div_mul_cancel₀ _ hplog.ne']

lemma log_choose_le_pi_mul_log {n k : ℕ} (hn : 1 < n) :
    Real.log (n.choose k : ℝ) ≤ (π n : ℝ) * Real.log (n : ℝ) := by
  rw [Real.log_nat_eq_sum_factorization (n.choose k)]
  unfold Finsupp.sum
  set sPrimes := (Finset.range (n + 1)).filter Nat.Prime
  have hsup : ((n.choose k).factorization).support ⊆ sPrimes := by
    intro p hp
    have hp0 : (n.choose k).factorization p ≠ 0 := Finsupp.mem_support_iff.mp hp
    have hpp : p.Prime := Nat.prime_of_mem_primeFactors (by
      rwa [← Nat.support_factorization])
    have : ¬ n < p := fun hlt => hp0 (Nat.factorization_choose_eq_zero_of_lt hlt)
    simp [sPrimes, Finset.mem_filter, Finset.mem_range, hpp]
    omega
  refine (Finset.sum_le_sum_of_subset_of_nonneg hsup ?_).trans ?_
  · intro p _ _
    apply mul_nonneg
    · exact Nat.cast_nonneg _
    · by_cases h : p ≤ 1
      · rcases (show p = 0 ∨ p = 1 by omega) with rfl | rfl <;> simp
      · exact log_nonneg (by norm_cast; omega)
  · have hterm : ∀ p ∈ sPrimes,
        ((n.choose k).factorization p : ℝ) * Real.log p ≤ Real.log (n : ℝ) := by
      intro p hp
      have hpp : p.Prime := (Finset.mem_filter.mp hp).2
      have hp1 : 1 < p := hpp.one_lt
      have hle := Nat.factorization_choose_le_log (p := p) (n := n) (k := k)
      have hn0 : n ≠ 0 := by omega
      have hlogp : 0 ≤ Real.log p := log_nonneg (by norm_cast; omega)
      calc
        ((n.choose k).factorization p : ℝ) * Real.log p
            ≤ (Nat.log p n : ℝ) * Real.log p := by gcongr
        _ ≤ Real.log n := natLog_mul_log_le hp1 hn0
    refine (Finset.sum_le_sum hterm).trans ?_
    simp only [Finset.sum_const, nsmul_eq_mul]
    have hcard : (sPrimes.card : ℝ) = (π n : ℝ) := by
      simp [sPrimes, Nat.primeCounting, Nat.primeCounting',
        Nat.count_eq_card_filter_range]
    rw [hcard]

lemma log_central_binom_lower {n : ℕ} (hn : 0 < n) :
    (n : ℝ) * Real.log 4 - Real.log ((2 * n + 1 : ℕ) : ℝ) ≤
      Real.log ((2 * n).choose n : ℝ) := by
  have hCpos : (0 : ℝ) < ((2 * n).choose n : ℝ) :=
    Nat.cast_pos.mpr (Nat.choose_pos (by nlinarith))
  have h4pos : (0 : ℝ) < (4 : ℝ) ^ n := pow_pos (by norm_num) _
  have hLpos : (0 : ℝ) < ((2 * n + 1 : ℕ) : ℝ) := Nat.cast_pos.mpr (Nat.succ_pos _)
  have hineq : (4 : ℝ) ^ n ≤ ((2 * n + 1 : ℕ) : ℝ) * ((2 * n).choose n : ℝ) :=
    mod_cast Nat.four_pow_le_two_mul_add_one_mul_central_binom n
  have hlog : Real.log ((4 : ℝ) ^ n) ≤
      Real.log (((2 * n + 1 : ℕ) : ℝ) * ((2 * n).choose n : ℝ)) :=
    log_le_log h4pos hineq
  rw [Real.log_pow, Real.log_mul hLpos.ne' hCpos.ne'] at hlog
  linarith

lemma primeCounting_two_mul_ge {n : ℕ} (hn : 2 ≤ n) :
    ((n : ℝ) * Real.log 4 - Real.log ((2 * n + 1 : ℕ) : ℝ)) /
      Real.log ((2 * n : ℕ) : ℝ) ≤ (π (2 * n) : ℝ) := by
  have hn1 : 1 < 2 * n := by nlinarith
  have hlogC := log_choose_le_pi_mul_log (n := 2 * n) (k := n) hn1
  have hlow := log_central_binom_lower (n := n) (by omega)
  have hlogpos : 0 < Real.log ((2 * n : ℕ) : ℝ) :=
    log_pos (by exact_mod_cast hn1)
  have hcomb := hlow.trans hlogC
  exact (div_le_iff₀ hlogpos).2 hcomb



/-! ### Lower bounds for `π` used in the large-`n` analysis -/

lemma log4_eq_two_log2 : Real.log 4 = 2 * Real.log 2 := by
  have h : (4 : ℝ) = (2 : ℝ) ^ (2 : ℕ) := by norm_num
  rw [h, Real.log_pow]
  ring

lemma two_mul_add_one_le_two_pow {m : ℕ} (hm : 3 ≤ m) : 2 * m + 1 ≤ 2 ^ m := by
  induction m, hm using Nat.le_induction with
  | base => decide
  | succ k hk ih =>
    rw [pow_succ]
    have hstep : 2 * (k + 1) + 1 ≤ 2 * (2 * k + 1) := by omega
    have hmul : 2 * (2 * k + 1) ≤ 2 * 2 ^ k := Nat.mul_le_mul_left _ ih
    omega

lemma pi_two_mul_ge_simple {m : ℕ} (hm : 3 ≤ m) :
    (Real.log 2) * (m : ℝ) / Real.log ((2 * m : ℕ) : ℝ) ≤ (π (2 * m) : ℝ) := by
  have h := primeCounting_two_mul_ge (by omega : 2 ≤ m)
  have hlog4 := log4_eq_two_log2
  have hden : 0 < Real.log ((2 * m : ℕ) : ℝ) :=
    log_pos (by exact_mod_cast (by nlinarith : 1 < 2 * m))
  have hpow := two_mul_add_one_le_two_pow hm
  have hcmp : Real.log ((2 * m + 1 : ℕ) : ℝ) ≤ (m : ℝ) * Real.log 2 := by
    have hpos : (0 : ℝ) < (2 * m + 1 : ℕ) := by exact_mod_cast Nat.succ_pos _
    have hle : ((2 * m + 1 : ℕ) : ℝ) ≤ (2 : ℝ) ^ m := by exact_mod_cast hpow
    have hlogle := log_le_log hpos hle
    have hlogpow : Real.log ((2 : ℝ) ^ m) = (m : ℝ) * Real.log 2 := Real.log_pow _ _
    linarith
  have hnum : (m : ℝ) * Real.log 4 - Real.log ((2 * m + 1 : ℕ) : ℝ) ≥
      (m : ℝ) * Real.log 2 := by
    rw [hlog4]; linarith
  have hdiv := div_le_div_of_nonneg_right hnum (le_of_lt hden)
  have hA : (Real.log 2) * (m : ℝ) / Real.log ((2 * m : ℕ) : ℝ) =
      (m : ℝ) * Real.log 2 / Real.log ((2 * m : ℕ) : ℝ) := by ring
  linarith [h, hA]

lemma pi_ge_log2_div_four {n : ℕ} (hn : 6 ≤ n) :
    (Real.log 2) * (n : ℝ) / (4 * Real.log (n : ℝ)) ≤ (π n : ℝ) := by
  have hlog2 : 0 < Real.log 2 := log_pos (by norm_num)
  rcases Nat.even_or_odd' n with ⟨m, hm | hm⟩
  · have hm3 : 3 ≤ m := by omega
    have h := pi_two_mul_ge_simple hm3
    rw [show n = 2 * m from hm]
    have hden : 0 < Real.log ((2 * m : ℕ) : ℝ) :=
      log_pos (by exact_mod_cast (by nlinarith : 1 < 2 * m))
    have hcast : ((2 * m : ℕ) : ℝ) = (2 : ℝ) * m := by norm_cast
    calc
      (Real.log 2) * ((2 * m : ℕ) : ℝ) / (4 * Real.log ((2 * m : ℕ) : ℝ))
          = (Real.log 2) * ((2 : ℝ) * m) / (4 * Real.log ((2 * m : ℕ) : ℝ)) := by
            rw [hcast]
      _ = (1 / 2) * ((Real.log 2) * (m : ℝ) / Real.log ((2 * m : ℕ) : ℝ)) := by
            field_simp [hden.ne']; ring
      _ ≤ 1 * ((Real.log 2) * (m : ℝ) / Real.log ((2 * m : ℕ) : ℝ)) := by
            apply mul_le_mul_of_nonneg_right (by norm_num : (1 / 2 : ℝ) ≤ 1)
            exact div_nonneg (mul_nonneg hlog2.le (Nat.cast_nonneg _)) hden.le
      _ = (Real.log 2) * (m : ℝ) / Real.log ((2 * m : ℕ) : ℝ) := by ring
      _ ≤ (π (2 * m) : ℝ) := h
  · have hm3 : 3 ≤ m := by omega
    have h := pi_two_mul_ge_simple hm3
    rw [show n = 2 * m + 1 from hm]
    have hmono : (π (2 * m) : ℝ) ≤ (π (2 * m + 1) : ℝ) :=
      Nat.cast_le.mpr (Nat.monotone_primeCounting (by omega))
    have hden : 0 < Real.log ((2 * m + 1 : ℕ) : ℝ) :=
      log_pos (by exact_mod_cast (by nlinarith : 1 < 2 * m + 1))
    have hden' : 0 < Real.log ((2 * m : ℕ) : ℝ) :=
      log_pos (by exact_mod_cast (by nlinarith : 1 < 2 * m))
    have hlog_mono : Real.log ((2 * m : ℕ) : ℝ) ≤ Real.log ((2 * m + 1 : ℕ) : ℝ) :=
      log_le_log (by exact_mod_cast (by omega : 0 < 2 * m))
        (by exact_mod_cast (by omega : (2 * m : ℕ) ≤ 2 * m + 1))
    have hnm : ((2 * m + 1 : ℕ) : ℝ) ≤ (4 : ℝ) * m := by
      have : (2 * m + 1 : ℕ) ≤ 4 * m := by nlinarith
      exact_mod_cast this
    have hprod : ((2 * m + 1 : ℕ) : ℝ) * Real.log ((2 * m : ℕ) : ℝ) ≤
        (4 : ℝ) * m * Real.log ((2 * m + 1 : ℕ) : ℝ) := by
      refine le_trans (mul_le_mul_of_nonneg_right hnm hden'.le) ?_
      exact mul_le_mul_of_nonneg_left hlog_mono (by positivity)
    calc
      (Real.log 2) * ((2 * m + 1 : ℕ) : ℝ) / (4 * Real.log ((2 * m + 1 : ℕ) : ℝ))
          ≤ (Real.log 2) * (m : ℝ) / Real.log ((2 * m : ℕ) : ℝ) := by
            rw [div_le_div_iff₀ (by positivity) hden']
            nlinarith [hlog2, hprod]
      _ ≤ (π (2 * m) : ℝ) := h
      _ ≤ (π (2 * m + 1) : ℝ) := hmono

/- Möbius square identity and related estimates. -/
lemma sum_moebius_divisors (n : ℕ) :
    ∑ d ∈ n.divisors, (moebius d : ℝ) = if n = 1 then 1 else 0 := by
  calc
    ∑ d ∈ n.divisors, (moebius d : ℝ)
        = ((moebius : ArithmeticFunction ℝ) * ArithmeticFunction.zeta) n :=
          (coe_mul_zeta_apply (f := (moebius : ArithmeticFunction ℝ)) (x := n)).symm
    _ = (1 : ArithmeticFunction ℝ) n := by rw [coe_moebius_mul_coe_zeta]
    _ = if n = 1 then 1 else 0 := by simp [one_apply]

/-- If `M` is squarefree then `d² ∣ s² M` iff `d ∣ s`. -/
lemma sq_dvd_sq_mul_squarefree {s M d : ℕ} (hM : Squarefree M) :
    d * d ∣ s * s * M ↔ d ∣ s := by
  rcases eq_or_ne s 0 with rfl | hs0
  · simp
  rcases eq_or_ne d 0 with rfl | hd0
  · constructor
    · intro h
      have h0 : s * s * M = 0 := Nat.eq_zero_of_zero_dvd (by simpa using h)
      rcases Nat.mul_eq_zero.mp h0 with hss | hMz
      · exact (hs0 (by simp at hss; exact hss)).elim
      · exact (hM.ne_zero hMz).elim
    · intro h
      exact (hs0 (eq_zero_of_zero_dvd h)).elim
  have hM0 : M ≠ 0 := hM.ne_zero
  have hdd0 : d * d ≠ 0 := mul_ne_zero hd0 hd0
  have hss0 : s * s ≠ 0 := mul_ne_zero hs0 hs0
  have hssM0 : s * s * M ≠ 0 := mul_ne_zero hss0 hM0
  constructor
  · intro h
    rw [← factorization_le_iff_dvd hd0 hs0]
    intro p
    have hle := (factorization_le_iff_dvd hdd0 hssM0).mpr h p
    have hL : (d * d).factorization p = 2 * d.factorization p := by
      rw [Nat.factorization_mul hd0 hd0, Finsupp.coe_add, Pi.add_apply, two_mul]
    have hR : (s * s * M).factorization p =
        2 * s.factorization p + M.factorization p := by
      rw [Nat.factorization_mul hss0 hM0, Nat.factorization_mul hs0 hs0,
        Finsupp.coe_add, Finsupp.coe_add, Pi.add_apply, Pi.add_apply, two_mul]
    have hMle : M.factorization p ≤ 1 := hM.natFactorization_le_one p
    rw [hL, hR] at hle
    have : 2 * d.factorization p ≤ 2 * s.factorization p + 1 := le_trans hle (by omega)
    omega
  · intro h
    exact (Nat.mul_dvd_mul h h).trans (dvd_mul_right _ _)

lemma moebius_sq_eq_sum_mu_sq_dvd (n : ℕ) :
    (moebius n : ℝ) ^ 2 =
      ∑ d ∈ n.divisors with d * d ∣ n, (moebius d : ℝ) := by
  rcases n.eq_zero_or_pos with rfl | hn
  · simp
  obtain ⟨M, s, hMpos, hspos, hfac, hsf⟩ := Nat.sq_mul_squarefree_of_pos hn
  have hfac' : s * s * M = n := by rw [← hfac, pow_two]
  have hset : n.divisors.filter (fun d => d * d ∣ n) = s.divisors := by
    ext d
    constructor
    · intro hd
      have hdd := (mem_filter.mp hd).2
      have hds : d ∣ s :=
        (sq_dvd_sq_mul_squarefree (M := M) (s := s) (d := d) hsf).1 (by rwa [hfac'])
      exact Nat.mem_divisors.mpr ⟨hds, hspos.ne'⟩
    · intro hd
      have hds : d ∣ s := Nat.dvd_of_mem_divisors hd
      have hdd : d * d ∣ n := by
        rw [← hfac']
        exact (sq_dvd_sq_mul_squarefree hsf).2 hds
      have hdn : d ∣ n := (dvd_mul_right d d).trans hdd
      exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨hdn, hn.ne'⟩, hdd⟩
  rw [hset, sum_moebius_divisors]
  have hL : (moebius n : ℝ) ^ 2 = if Squarefree n then 1 else 0 := by
    rw [← Int.cast_pow, moebius_sq, apply_ite ((↑) : ℤ → ℝ)]
    simp
  rw [hL]
  have hiff : Squarefree n ↔ s = 1 := by
    constructor
    · intro hN
      by_contra hsne
      have hs1 : 1 < s := Nat.lt_of_le_of_ne (Nat.succ_le_of_lt hspos) (Ne.symm hsne)
      obtain ⟨p, hp, hps⟩ := Nat.exists_prime_and_dvd (Nat.ne_of_gt hs1)
      have hp2 : p ^ 2 ∣ n := by
        have : p ^ 2 ∣ s * s := by simpa [pow_two] using Nat.mul_dvd_mul hps hps
        exact this.trans (by rw [← hfac']; exact dvd_mul_right _ _)
      have hunit : IsUnit p := hN p (by simpa [pow_two] using hp2)
      exact hp.not_isUnit hunit
    · intro hs1
      subst hs1
      have hMn : M = n := by simpa using hfac'
      exact hMn ▸ hsf
  simp [hiff]

lemma abs_moebius_cast_le (n : ℕ) : |(moebius n : ℝ)| ≤ 1 := by
  have := abs_moebius_le_one (n := n)
  exact_mod_cast this

lemma filter_sq_dvd_iff {n d : ℕ} (hn : 0 < n) :
    d ∈ n.divisors.filter (fun t => t * t ∣ n) ↔ d * d ∣ n := by
  constructor
  · intro h; exact (mem_filter.mp h).2
  · intro hdd
    exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨(dvd_mul_right d d).trans hdd, hn.ne'⟩, hdd⟩

lemma pos_of_sq_dvd {n d : ℕ} (hn : 0 < n) (hdd : d * d ∣ n) : 0 < d := by
  rcases eq_or_ne d 0 with rfl | hd0
  · have : n = 0 := eq_zero_of_zero_dvd ((dvd_mul_right 0 0).trans (by simpa using hdd))
    exact (hn.ne' this).elim
  · exact Nat.pos_of_ne_zero hd0

lemma sum_mu_on_sq_dvd_eq_sum_Icc (N n : ℕ) (hn : n ∈ Icc 1 N)
    (μdiv : ℕ → ℝ) :
    ∑ d ∈ n.divisors.filter (fun t => t * t ∣ n), μdiv d =
      ∑ d ∈ Icc 1 N, if d * d ∣ n then μdiv d else 0 := by
  have hn0 : 0 < n := lt_of_lt_of_le (by decide : (0 : ℕ) < 1) (mem_Icc.mp hn).1
  have hN : n ≤ N := (mem_Icc.mp hn).2
  have hsub : n.divisors.filter (fun t => t * t ∣ n) ⊆ Icc 1 N := by
    intro d hd
    have hdd : d * d ∣ n := (mem_filter.mp hd).2
    have hdpos := pos_of_sq_dvd hn0 hdd
    have hdle : d ≤ n := Nat.le_of_dvd hn0 ((dvd_mul_right d d).trans hdd)
    exact mem_Icc.mpr ⟨Nat.succ_le_of_lt hdpos, hdle.trans hN⟩
  let f : ℕ → ℝ := fun d => if d * d ∣ n then μdiv d else 0
  have hsum : ∑ d ∈ Icc 1 N, f d = ∑ d ∈ n.divisors.filter (fun t => t * t ∣ n), f d :=
    (sum_subset hsub (fun d _ hdnot => by
      have : ¬ d * d ∣ n := fun hdd => hdnot ((filter_sq_dvd_iff hn0).2 hdd)
      simp [f, this])).symm
  have hf : ∀ d ∈ n.divisors.filter (fun t => t * t ∣ n), f d = μdiv d := by
    intro d hd
    have : d * d ∣ n := (mem_filter.mp hd).2
    simp [f, this]
  calc
    ∑ d ∈ n.divisors.filter (fun t => t * t ∣ n), μdiv d
        = ∑ d ∈ n.divisors.filter (fun t => t * t ∣ n), f d :=
          (sum_congr rfl hf).symm
    _ = ∑ d ∈ Icc 1 N, f d := hsum.symm
    _ = ∑ d ∈ Icc 1 N, if d * d ∣ n then μdiv d else 0 := rfl

lemma Icc_filter_dvd_image (N k : ℕ) (hk : 0 < k) :
    (Icc 1 N).filter (fun n => k ∣ n) =
      (Icc 1 (N / k)).image (fun m => k * m) := by
  ext n
  simp only [mem_filter, mem_image, mem_Icc]
  constructor
  · rintro ⟨⟨hn1, hnN⟩, hkn⟩
    refine ⟨n / k, ?_, Nat.mul_div_cancel' hkn⟩
    constructor
    · have hk_le : k ≤ n := Nat.le_of_dvd (by omega) hkn
      exact (Nat.le_div_iff_mul_le hk).2 (by nlinarith)
    · exact Nat.div_le_div_right hnN
  · rintro ⟨m, ⟨hm1, hmle⟩, rfl⟩
    constructor
    · constructor
      · nlinarith
      · have : m * k ≤ N := (Nat.le_div_iff_mul_le hk).1 hmle
        simpa [mul_comm] using this
    · exact dvd_mul_right _ _

lemma sum_over_multiples (N k : ℕ) (hk : 0 < k) (f : ℕ → ℝ) :
    ∑ n ∈ (Icc 1 N).filter (fun n => k ∣ n), f n =
      ∑ m ∈ Icc 1 (N / k), f (k * m) := by
  rw [Icc_filter_dvd_image N k hk, sum_image]
  intro x _ y _ hxy
  exact Nat.eq_of_mul_eq_mul_left hk hxy

lemma sum_indicator_sq_dvd_div (N d : ℕ) (hd : 0 < d) :
    ∑ n ∈ Icc 1 N, (if d * d ∣ n then (1 : ℝ) / (n : ℝ) else 0) =
      (1 : ℝ) / ((d : ℝ) * d) * (harmonic (N / (d * d)) : ℝ) := by
  have hdd : 0 < d * d := Nat.mul_pos hd hd
  have hddR : ((d : ℝ) * d) ≠ 0 := by exact_mod_cast hdd.ne'
  rw [← sum_filter]
  rw [sum_over_multiples N (d * d) hdd (fun n => (1 : ℝ) / (n : ℝ))]
  have hcast : ∑ m ∈ Icc 1 (N / (d * d)), (1 : ℝ) / ((d * d * m : ℕ) : ℝ) =
      ∑ m ∈ Icc 1 (N / (d * d)), (1 : ℝ) / ((d : ℝ) * d * (m : ℝ)) := by
    refine sum_congr rfl fun m hm => ?_
    have : ((d * d * m : ℕ) : ℝ) = (d : ℝ) * d * (m : ℝ) := by norm_cast
    rw [this]
  rw [hcast]
  have hsplit : ∑ m ∈ Icc 1 (N / (d * d)), (1 : ℝ) / ((d : ℝ) * d * (m : ℝ)) =
      ∑ m ∈ Icc 1 (N / (d * d)), ((1 : ℝ) / ((d : ℝ) * d)) * ((1 : ℝ) / (m : ℝ)) := by
    refine sum_congr rfl fun m hm => ?_
    have hm0 : (m : ℝ) ≠ 0 := by
      have : 0 < m := lt_of_lt_of_le (by decide : (0 : ℕ) < 1) (mem_Icc.mp hm).1
      exact_mod_cast this.ne'
    field_simp [hddR, hm0]
  rw [hsplit, ← mul_sum]
  have hharm : (harmonic (N / (d * d)) : ℝ) =
      ∑ m ∈ Icc 1 (N / (d * d)), (1 : ℝ) / (m : ℝ) := by
    simp [harmonic_eq_sum_Icc, one_div]
  rw [hharm]

lemma sum_mu_sq_div_eq (N : ℕ) :
    ∑ n ∈ Icc 1 N, (moebius n : ℝ) ^ 2 / (n : ℝ) =
      ∑ d ∈ Icc 1 N,
        (moebius d : ℝ) / ((d : ℝ) * d) * (harmonic (N / (d * d)) : ℝ) := by
  have h1 : ∑ n ∈ Icc 1 N, (moebius n : ℝ) ^ 2 / (n : ℝ) =
      ∑ n ∈ Icc 1 N,
        ∑ d ∈ n.divisors.filter (fun t => t * t ∣ n), (moebius d : ℝ) / (n : ℝ) := by
    refine sum_congr rfl fun n hn => ?_
    have hn0 : 0 < n := lt_of_lt_of_le (by decide : (0 : ℕ) < 1) (mem_Icc.mp hn).1
    rw [moebius_sq_eq_sum_mu_sq_dvd, sum_div]
  rw [h1]
  have h2 :=
    sum_congr rfl (fun n hn =>
      sum_mu_on_sq_dvd_eq_sum_Icc N n hn (fun d => (moebius d : ℝ) / (n : ℝ)))
  rw [h2, sum_comm]
  refine sum_congr rfl fun d hd => ?_
  have hdpos : 0 < d := lt_of_lt_of_le (by decide : (0 : ℕ) < 1) (mem_Icc.mp hd).1
  have hddR : ((d : ℝ) * d) ≠ 0 := by
    have : 0 < d * d := Nat.mul_pos hdpos hdpos
    exact_mod_cast this.ne'
  have hmul :
      ∑ n ∈ Icc 1 N, (if d * d ∣ n then (moebius d : ℝ) / (n : ℝ) else 0) =
        (moebius d : ℝ) *
          ∑ n ∈ Icc 1 N, (if d * d ∣ n then (1 : ℝ) / (n : ℝ) else 0) := by
    rw [mul_sum]
    refine sum_congr rfl fun n hn => ?_
    split_ifs <;> ring
  rw [hmul, sum_indicator_sq_dvd_div N d hdpos]
  field_simp [hddR]

lemma two_sub_pi_sq_div_six_nonneg : 0 ≤ 2 - Real.pi ^ 2 / 6 := by
  have hpi : Real.pi < (315 : ℝ) / 100 := by
    have := Real.pi_lt_d2
    have h315 : (315 : ℝ) / 100 = (3.15 : ℝ) := by norm_num
    rw [h315]
    exact this
  have hpos : 0 < Real.pi := Real.pi_pos
  have hsq : Real.pi ^ 2 < ((315 : ℝ) / 100) ^ 2 := by nlinarith
  have hnum : ((315 : ℝ) / 100) ^ 2 / 6 < 2 := by norm_num
  linarith

lemma erase_one_Icc {N : ℕ} (_hN : 1 ≤ N) : (Icc 1 N).erase 1 = Icc 2 N := by
  ext x
  simp only [mem_erase, mem_Icc]
  constructor
  · intro ⟨hne, hx1, hxN⟩
    exact ⟨by omega, hxN⟩
  · intro ⟨hx2, hxN⟩
    exact ⟨by omega, by omega, hxN⟩

lemma harmonic_nonneg (N : ℕ) : 0 ≤ (harmonic N : ℝ) := by
  simp [harmonic_eq_sum_Icc]
  exact Finset.sum_nonneg fun i hi => by positivity

lemma harmonic_mono {a b : ℕ} (h : a ≤ b) :
    (harmonic a : ℝ) ≤ (harmonic b : ℝ) := by
  simp [harmonic_eq_sum_Icc]
  exact Finset.sum_le_sum_of_subset_of_nonneg
    (Icc_subset_Icc le_rfl h) (fun i _ _ => by positivity)

lemma sum_one_div_sq_tail (N : ℕ) :
    ∑ n ∈ Icc 2 N, (1 : ℝ) / ((n : ℝ) ^ 2) ≤ Real.pi ^ 2 / 6 - 1 := by
  have hsum : HasSum (fun n : ℕ => (1 : ℝ) / (n : ℝ) ^ 2) (Real.pi ^ 2 / 6) :=
    hasSum_zeta_two
  have hs : Summable (fun n : ℕ => (1 : ℝ) / (n : ℝ) ^ 2) := hsum.summable
  have hz : ∑' n : ℕ, (1 : ℝ) / (n : ℝ) ^ 2 = Real.pi ^ 2 / 6 := hsum.tsum_eq
  rcases lt_or_ge N 2 with hN | hN
  · have hempty : Icc 2 N = ∅ := by
      ext x; simp [mem_Icc]; omega
    rw [hempty, sum_empty]
    have : (1 : ℝ) ≤ Real.pi ^ 2 / 6 := by
      have : (3 : ℝ) ≤ Real.pi := le_of_lt Real.pi_gt_three
      nlinarith
    linarith
  · have h1mem : 1 ∈ Icc 1 N := mem_Icc.mpr ⟨le_rfl, by omega⟩
    have hpart := hs.sum_le_tsum (Icc 1 N)
      (fun _ _ => div_nonneg (by norm_num) (sq_nonneg _))
    have hsplit : ∑ n ∈ Icc 1 N, (1 : ℝ) / (n : ℝ) ^ 2 =
        (1 : ℝ) + ∑ n ∈ Icc 2 N, (1 : ℝ) / (n : ℝ) ^ 2 := by
      rw [← sum_erase_add (Icc 1 N) (fun n => (1 : ℝ) / (n : ℝ) ^ 2) h1mem,
          erase_one_Icc (by omega : 1 ≤ N)]
      simp [add_comm]
    linarith [hz]
lemma abs_moebius_real_le (d : ℕ) : -1 ≤ (moebius d : ℝ) ∧ (moebius d : ℝ) ≤ 1 := by
  have h := abs_moebius_le_one (n := d)
  have : |(moebius d : ℝ)| ≤ 1 := by exact_mod_cast h
  exact abs_le.mp this

lemma sum_mu_sq_div_ge (N : ℕ) (hN : 1 ≤ N) :
    (2 - Real.pi ^ 2 / 6) * (harmonic N : ℝ) ≤
      ∑ n ∈ Icc 1 N, (moebius n : ℝ) ^ 2 / (n : ℝ) := by
  rw [sum_mu_sq_div_eq]
  have h1mem : 1 ∈ Icc 1 N := mem_Icc.mpr ⟨le_rfl, hN⟩
  rw [← sum_erase_add _ _ h1mem, erase_one_Icc hN]
  have h1simp :
      (moebius (1 : ℕ) : ℝ) / ((1 : ℝ) * (1 : ℝ)) * (harmonic (N / (1 * 1)) : ℝ) =
        (harmonic N : ℝ) := by
    simp
  convert_to
    (2 - Real.pi ^ 2 / 6) * (harmonic N : ℝ) ≤
      ∑ d ∈ Icc 2 N,
          (moebius d : ℝ) / ((d : ℝ) * d) * (harmonic (N / (d * d)) : ℝ) +
        (harmonic N : ℝ) using 1
  · simp
  have hrest :
      ∑ d ∈ Icc 2 N,
          (moebius d : ℝ) / ((d : ℝ) * d) * (harmonic (N / (d * d)) : ℝ) ≥
        - (harmonic N : ℝ) * ∑ d ∈ Icc 2 N, (1 : ℝ) / ((d : ℝ) ^ 2) := by
    have hterm :
        ∑ d ∈ Icc 2 N,
            (moebius d : ℝ) / ((d : ℝ) * d) * (harmonic (N / (d * d)) : ℝ) ≥
          ∑ d ∈ Icc 2 N, (- (1 : ℝ) / ((d : ℝ) * d)) * (harmonic N : ℝ) := by
      refine sum_le_sum fun d hd => ?_
      have hdpos : 0 < d := by have := (mem_Icc.mp hd).1; omega
      have hddpos : 0 < d * d := Nat.mul_pos hdpos hdpos
      have hHle : (harmonic (N / (d * d)) : ℝ) ≤ (harmonic N : ℝ) :=
        harmonic_mono (Nat.div_le_self _ _)
      have ⟨hlo, _hhi⟩ := abs_moebius_real_le d
      have hden : 0 < (d : ℝ) * d := by exact_mod_cast hddpos
      have hcoeff : - (1 : ℝ) / ((d : ℝ) * d) ≤ (moebius d : ℝ) / ((d : ℝ) * d) := by
        exact div_le_div_of_nonneg_right hlo hden.le
      have hH' := harmonic_nonneg (N / (d * d))
      have hHN := harmonic_nonneg N
      -- (-1/d²)*H_N ≤ (μ(d)/d²)*H_{N/d²}
      have h1 : (- (1 : ℝ) / ((d : ℝ) * d)) * (harmonic N : ℝ) ≤
          (- (1 : ℝ) / ((d : ℝ) * d)) * (harmonic (N / (d * d)) : ℝ) := by
        have hneg : - (1 : ℝ) / ((d : ℝ) * d) ≤ 0 :=
          div_nonpos_of_nonpos_of_nonneg (by norm_num) hden.le
        exact mul_le_mul_of_nonpos_left hHle hneg
      have h2 : (- (1 : ℝ) / ((d : ℝ) * d)) * (harmonic (N / (d * d)) : ℝ) ≤
          (moebius d : ℝ) / ((d : ℝ) * d) * (harmonic (N / (d * d)) : ℝ) :=
        mul_le_mul_of_nonneg_right hcoeff hH'
      linarith
    have hrewrite :
        ∑ d ∈ Icc 2 N, (- (1 : ℝ) / ((d : ℝ) * d)) * (harmonic N : ℝ) =
          - (harmonic N : ℝ) * ∑ d ∈ Icc 2 N, (1 : ℝ) / ((d : ℝ) ^ 2) := by
      rw [← sum_mul]
      have hs : ∑ d ∈ Icc 2 N, (- (1 : ℝ) / ((d : ℝ) * d)) =
          - ∑ d ∈ Icc 2 N, (1 : ℝ) / ((d : ℝ) ^ 2) := by
        rw [← sum_neg_distrib]
        refine sum_congr rfl fun d hd => ?_
        ring
      rw [hs]
      ring
    linarith
  have htail := sum_one_div_sq_tail N
  nlinarith [htail, harmonic_nonneg N, two_sub_pi_sq_div_six_nonneg]

lemma sum_mu_sq_div_ge_log (N : ℕ) (hN : 1 ≤ N) :
    (2 - Real.pi ^ 2 / 6) * Real.log (N + 1 : ℝ) ≤
      ∑ n ∈ Icc 1 N, (moebius n : ℝ) ^ 2 / (n : ℝ) := by
  have hH := log_add_one_le_harmonic N
  have hc := two_sub_pi_sq_div_six_nonneg
  have hmain := sum_mu_sq_div_ge N hN
  have hmul := mul_le_mul_of_nonneg_left hH hc
  have hlog : Real.log (N + 1 : ℝ) = Real.log ((N + 1 : ℕ) : ℝ) := by norm_cast
  rw [hlog]
  linarith


/- Mertens-type bound from Chebyshev: ∑_{p≤n} log p / p ≤ log 4 * (2 + log n). -/
lemma theta_at_nat (n : ℕ) :
    θ (n : ℝ) = ∑ p ∈ Icc 0 n with p.Prime, Real.log p := by
  rw [theta_eq_sum_Icc]
  simp

lemma theta_succ_sub {k : ℕ} (hk : 1 ≤ k) :
    θ (k : ℝ) - θ ((k - 1 : ℕ) : ℝ) = if k.Prime then Real.log k else 0 := by
  rw [theta_at_nat, theta_at_nat]
  by_cases hp : k.Prime
  · have hI :
        (Icc 0 k).filter Nat.Prime =
          insert k ((Icc 0 (k - 1)).filter Nat.Prime) := by
      ext p
      simp only [mem_insert, mem_filter, mem_Icc]
      constructor
      · intro ⟨⟨h0, hle⟩, hpp⟩
        rcases eq_or_lt_of_le hle with rfl | hlt
        · exact Or.inl rfl
        · exact Or.inr ⟨⟨h0, Nat.le_sub_one_of_lt hlt⟩, hpp⟩
      · rintro (rfl | ⟨⟨h0, hle⟩, hpp⟩)
        · exact ⟨⟨Nat.zero_le _, le_rfl⟩, hp⟩
        · exact ⟨⟨h0, hle.trans (Nat.sub_le _ _)⟩, hpp⟩
    have hnotin : k ∉ (Icc 0 (k - 1)).filter Nat.Prime := by
      intro h
      have := (mem_Icc.mp (mem_filter.mp h).1).2
      omega
    rw [if_pos hp, hI, sum_insert hnotin]
    ring
  · have hI :
        (Icc 0 k).filter Nat.Prime = (Icc 0 (k - 1)).filter Nat.Prime := by
      ext p
      simp only [mem_filter, mem_Icc]
      constructor
      · intro ⟨⟨h0, hle⟩, hpp⟩
        have hne : p ≠ k := fun h => hp (h ▸ hpp)
        exact ⟨⟨h0, Nat.le_sub_one_of_lt (lt_of_le_of_ne hle hne)⟩, hpp⟩
      · intro ⟨⟨h0, hle⟩, hpp⟩
        exact ⟨⟨h0, hle.trans (Nat.sub_le _ _)⟩, hpp⟩
    rw [if_neg hp, hI, sub_self]

lemma primes_range_eq_Icc (n : ℕ) :
    (range (n + 1)).filter Nat.Prime = (Icc 2 n).filter Nat.Prime := by
  ext p
  simp only [mem_filter, mem_range, mem_Icc]
  constructor
  · intro ⟨hp, hpp⟩
    exact ⟨⟨hpp.two_le, Nat.le_of_lt_succ hp⟩, hpp⟩
  · intro ⟨⟨_, hpn⟩, hpp⟩
    exact ⟨Nat.lt_succ_of_le hpn, hpp⟩

lemma sum_log_div_p_as_diff (n : ℕ) (_hn : 2 ≤ n) :
    ∑ p ∈ range (n + 1) with p.Prime, Real.log p / p =
      ∑ k ∈ Icc 2 n, (θ (k : ℝ) - θ ((k - 1 : ℕ) : ℝ)) / k := by
  rw [primes_range_eq_Icc, sum_filter]
  refine sum_congr rfl fun k hk => ?_
  have hk1 : 1 ≤ k := by
    have := (Finset.mem_Icc.mp hk).1; omega
  rw [theta_succ_sub hk1]
  split_ifs <;> simp

lemma Icc_image_pred (n : ℕ) (hn : 2 ≤ n) :
    (Icc 2 n).image (fun k => k - 1) = Icc 1 (n - 1) := by
  ext m
  simp only [mem_image, mem_Icc]
  constructor
  · rintro ⟨k, ⟨hk2, hkn⟩, rfl⟩
    constructor <;> omega
  · rintro ⟨hm1, hm⟩
    refine ⟨m + 1, ⟨?_, ?_⟩, ?_⟩ <;> omega

lemma Icc_image_succ (n : ℕ) :
    (Icc 2 (n - 1)).image (fun k => k + 1) = Icc 3 n := by
  ext m
  simp only [mem_image, mem_Icc]
  constructor
  · rintro ⟨k, ⟨hk2, hkn⟩, rfl⟩
    constructor <;> omega
  · rintro ⟨hm3, hmn⟩
    refine ⟨m - 1, ⟨?_, ?_⟩, ?_⟩ <;> omega

lemma sum_log_div_p_eq (n : ℕ) (hn : 2 ≤ n) :
    ∑ p ∈ range (n + 1) with p.Prime, Real.log p / p =
      θ (n : ℝ) / n +
        ∑ k ∈ Icc 2 (n - 1), θ (k : ℝ) / (k * (k + 1) : ℝ) := by
  rw [sum_log_div_p_as_diff n hn]
  have hsplit :
      ∑ k ∈ Icc 2 n, (θ (k : ℝ) - θ ((k - 1 : ℕ) : ℝ)) / k =
        ∑ k ∈ Icc 2 n, θ (k : ℝ) / k -
          ∑ k ∈ Icc 2 n, θ ((k - 1 : ℕ) : ℝ) / k := by
    simp [sub_div, sum_sub_distrib]
  rw [hsplit]
  have hshift :
      ∑ k ∈ Icc 2 n, θ ((k - 1 : ℕ) : ℝ) / k =
        ∑ k ∈ Icc 1 (n - 1), θ (k : ℝ) / (k + 1 : ℝ) := by
    have hinj : Set.InjOn (fun k : ℕ => k - 1) (Icc 2 n) := by
      intro a ha b hb h
      have ha' : a ∈ Icc 2 n := by simpa using ha
      have hb' : b ∈ Icc 2 n := by simpa using hb
      have ha2 : 2 ≤ a := (Finset.mem_Icc.mp ha').1
      have hb2 : 2 ≤ b := (Finset.mem_Icc.mp hb').1
      have ha1 : 1 ≤ a := le_trans (by decide : (1 : ℕ) ≤ 2) ha2
      have hb1 : 1 ≤ b := le_trans (by decide : (1 : ℕ) ≤ 2) hb2
      have hab : a - 1 = b - 1 := h
      rw [← Nat.sub_add_cancel ha1, ← Nat.sub_add_cancel hb1, hab]
    rw [← Icc_image_pred n hn, sum_image hinj]
    refine sum_congr rfl fun k hk => ?_
    have hk2 : 2 ≤ k := (Finset.mem_Icc.mp hk).1
    have hkeq : (k : ℝ) = ((k - 1 : ℕ) : ℝ) + 1 := by
      have : 1 ≤ k := le_trans (by decide : (1:ℕ) ≤ 2) hk2
      simp [Nat.cast_sub this]
    rw [hkeq]
  rw [hshift]
  have hIcc_n : Icc 2 n = insert n (Icc 2 (n - 1)) := by
    ext x; simp [mem_insert, mem_Icc]; omega
  have hIcc_1 : Icc 1 (n - 1) = insert 1 (Icc 2 (n - 1)) := by
    ext x; simp [mem_insert, mem_Icc]; omega
  have n_notin : n ∉ Icc 2 (n - 1) := by
    intro h; have := (Finset.mem_Icc.mp h).2; omega
  have one_notin : 1 ∉ Icc 2 (n - 1) := by
    intro h; have := (Finset.mem_Icc.mp h).1; omega
  rw [hIcc_n, sum_insert n_notin, hIcc_1, sum_insert one_notin]
  have hθ1 : θ ((1 : ℕ) : ℝ) = 0 := theta_eq_zero_of_lt_two (by norm_num)
  simp only [hθ1, zero_div, zero_add]
  have hcomb :
      ∑ k ∈ Icc 2 (n - 1), θ (k : ℝ) / k -
          ∑ k ∈ Icc 2 (n - 1), θ (k : ℝ) / (k + 1 : ℝ) =
        ∑ k ∈ Icc 2 (n - 1), θ (k : ℝ) / (k * (k + 1) : ℝ) := by
    rw [← sum_sub_distrib]
    refine sum_congr rfl fun k hk => ?_
    have hkpos : (0 : ℝ) < k := by
      have : 2 ≤ k := (Finset.mem_Icc.mp hk).1
      exact_mod_cast (lt_of_lt_of_le (by decide : (0 : ℕ) < 2) this)
    have : (k : ℝ) ≠ 0 := hkpos.ne'
    have : (k : ℝ) + 1 ≠ 0 := by positivity
    field_simp
    ring
  linarith

lemma sum_log_div_p_le (n : ℕ) (hn : 2 ≤ n) :
    ∑ p ∈ range (n + 1) with p.Prime, Real.log p / p ≤
      Real.log 4 * (2 + Real.log n) := by
  rw [sum_log_div_p_eq n hn]
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (lt_of_lt_of_le (by decide : (0:ℕ) < 2) hn)
  have hθn : θ (n : ℝ) / n ≤ Real.log 4 := by
    have := theta_le_log4_mul_x (show (0 : ℝ) ≤ n by positivity)
    exact (div_le_iff₀ hn0).mpr (by linarith)
  have h4 : 0 ≤ Real.log 4 := log_nonneg (by norm_num)
  have hrest :
      ∑ k ∈ Icc 2 (n - 1), θ (k : ℝ) / (k * (k + 1) : ℝ) ≤
        Real.log 4 * (1 + Real.log n) := by
    have hterm : ∀ k ∈ Icc 2 (n - 1),
        θ (k : ℝ) / (k * (k + 1) : ℝ) ≤ Real.log 4 * (1 / (k + 1 : ℝ)) := by
      intro k hk
      have hk2 : 2 ≤ k := (Finset.mem_Icc.mp hk).1
      have hk0 : (0 : ℝ) < k := by exact_mod_cast (lt_of_lt_of_le (by decide : (0:ℕ) < 2) hk2)
      have hθ := theta_le_log4_mul_x (show (0 : ℝ) ≤ k by positivity)
      have hden : (0 : ℝ) ≤ k * (k + 1) := by positivity
      have : θ (k : ℝ) / (k * (k + 1) : ℝ) ≤
          (Real.log 4 * (k : ℝ)) / (k * (k + 1) : ℝ) :=
        div_le_div_of_nonneg_right hθ hden
      have hsimp : (Real.log 4 * (k : ℝ)) / (k * (k + 1) : ℝ) =
          Real.log 4 * (1 / (k + 1 : ℝ)) := by
        field_simp; try ring
      rwa [hsimp] at this
    have hsum := sum_le_sum hterm
    have hreind :
        ∑ k ∈ Icc 2 (n - 1), (1 : ℝ) / (k + 1 : ℝ) =
          ∑ j ∈ Icc 3 n, (1 : ℝ) / (j : ℝ) := by
      have hinj : Set.InjOn (fun k : ℕ => k + 1) (Icc 2 (n - 1)) := by
        intro a _ b _ h
        exact Nat.succ_injective h
      rw [← Icc_image_succ n, sum_image hinj]
      simp
    have hsub : ∑ j ∈ Icc 3 n, (1 : ℝ) / j ≤
        ∑ j ∈ Icc 1 n, (1 : ℝ) / j :=
      sum_le_sum_of_subset_of_nonneg
        (Icc_subset_Icc (by decide : (1:ℕ) ≤ 3) le_rfl)
        (fun _ _ _ => by positivity)
    have hharm : ∑ j ∈ Icc 1 n, (1 : ℝ) / j ≤ 1 + Real.log n := by
      simpa [harmonic_eq_sum_Icc, one_div] using harmonic_le_one_add_log n
    have : ∑ k ∈ Icc 2 (n - 1), Real.log 4 * (1 / (k + 1 : ℝ)) =
        Real.log 4 * ∑ k ∈ Icc 2 (n - 1), (1 : ℝ) / (k + 1 : ℝ) := by
      rw [mul_sum]
    have hlogn : 0 ≤ Real.log n := log_nonneg (by exact_mod_cast (show (1:ℕ) ≤ n by omega))
    calc
      ∑ k ∈ Icc 2 (n - 1), θ (k : ℝ) / (k * (k + 1) : ℝ)
          ≤ ∑ k ∈ Icc 2 (n - 1), Real.log 4 * (1 / (k + 1 : ℝ)) := hsum
      _ = Real.log 4 * ∑ k ∈ Icc 2 (n - 1), (1 : ℝ) / (k + 1 : ℝ) := this
      _ = Real.log 4 * ∑ j ∈ Icc 3 n, (1 : ℝ) / j := by rw [hreind]
      _ ≤ Real.log 4 * ∑ j ∈ Icc 1 n, (1 : ℝ) / j :=
            mul_le_mul_of_nonneg_left hsub h4
      _ ≤ Real.log 4 * (1 + Real.log n) :=
            mul_le_mul_of_nonneg_left hharm h4
  linarith



/-! ### Kernel-reducing primality test and reflection certificates -/

def noDiv (n d fuel : ℕ) : Bool :=
  match fuel with
  | 0 => false
  | fuel + 1 =>
    if n < d * d then true
    else if n % d = 0 then false
    else noDiv n (d + 2) fuel

def trialPrime (n : ℕ) : Bool :=
  if n < 2 then false
  else if n = 2 then true
  else if n % 2 = 0 then false
  else noDiv n 3 n

lemma noDiv_spec {n d fuel : ℕ} (h : noDiv n d fuel = true) :
    ∀ k, d ≤ k → k * k ≤ n → k % 2 = d % 2 → ¬ k ∣ n := by
  induction fuel generalizing d with
  | zero =>
    simp [noDiv] at h
  | succ fuel ih =>
    intro k hk hkk hpar hdiv
    rw [noDiv] at h
    by_cases hlt : n < d * d
    · simp [hlt] at h
      have : d * d ≤ k * k := Nat.mul_le_mul hk hk
      omega
    · simp [hlt] at h
      by_cases hmod : n % d = 0
      · simp [hmod] at h
      · simp [hmod] at h
        by_cases hkd : k = d
        · subst hkd
          exact hmod (Nat.mod_eq_zero_of_dvd hdiv)
        · have hne1 : k ≠ d + 1 := by
            intro hke; subst hke
            have : (d + 1) % 2 = d % 2 := hpar
            omega
          have hk2 : d + 2 ≤ k := by omega
          have hpar' : k % 2 = (d + 2) % 2 := by omega
          exact ih h k hk2 hkk hpar' hdiv

lemma trialPrime_ge_two {n : ℕ} (h : trialPrime n = true) : 2 ≤ n := by
  unfold trialPrime at h
  by_cases h2 : n < 2
  · simp [h2] at h
  · omega

lemma trialPrime_no_dvd {n : ℕ} (h : trialPrime n = true) {k : ℕ}
    (hk2 : 2 ≤ k) (hkk : k * k ≤ n) : ¬ k ∣ n := by
  unfold trialPrime at h
  by_cases h2 : n < 2
  · simp [h2] at h
  · by_cases hn2 : n = 2
    · subst hn2
      have : k = 2 := by nlinarith
      subst this
      omega
    · simp [h2, hn2] at h
      obtain ⟨hodd, hnd⟩ := h
      by_cases hkpar : k % 2 = 0
      · intro hdiv
        have : 2 ∣ k := Nat.dvd_of_mod_eq_zero hkpar
        have : 2 ∣ n := Nat.dvd_trans this hdiv
        have : n % 2 = 0 := Nat.mod_eq_zero_of_dvd this
        omega
      · intro hdiv
        have : k ≠ 2 := by intro hk; subst hk; simp at hkpar
        have h3 : 3 ≤ k := by omega
        exact noDiv_spec hnd k h3 hkk (by omega) hdiv

lemma trialPrime_prime {n : ℕ} (h : trialPrime n = true) : Nat.Prime n := by
  refine Nat.prime_def_le_sqrt.mpr ⟨trialPrime_ge_two h, ?_⟩
  intro m hm2 hms
  have hkk : m * m ≤ n := (Nat.le_sqrt).1 hms
  exact trialPrime_no_dvd h hm2 hkk

structure ACert where
  n : ℕ
  x1 : ℕ
  y1 : ℕ
  m1 : ℕ
  x2 : ℕ
  y2 : ℕ
  m2 : ℕ

def ACert.check (c : ACert) : Bool :=
  decide (c.x1 ≤ c.y1) && decide (c.x2 ≤ c.y2) &&
  decide (c.x1 * c.x1 + c.y1 * c.y1 ≤ c.n) &&
  decide (c.x2 * c.x2 + c.y2 * c.y2 ≤ c.n) &&
  decide ((c.x1, c.y1) ≠ (c.x2, c.y2)) &&
  decide (c.m1 * c.m1 = 24 * (c.n - (c.x1 * c.x1 + c.y1 * c.y1)) + 1) &&
  decide (c.m2 * c.m2 = 24 * (c.n - (c.x2 * c.x2 + c.y2 * c.y2)) + 1) &&
  (trialPrime (c.x1 + 1) || trialPrime (c.y1 + 1)) &&
  (trialPrime (c.x2 + 1) || trialPrime (c.y2 + 1))

lemma cert_check_parts (c : ACert) (h : c.check = true) :
    c.x1 ≤ c.y1 ∧ c.x2 ≤ c.y2 ∧
    c.x1 * c.x1 + c.y1 * c.y1 ≤ c.n ∧
    c.x2 * c.x2 + c.y2 * c.y2 ≤ c.n ∧
    (c.x1, c.y1) ≠ (c.x2, c.y2) ∧
    c.m1 * c.m1 = 24 * (c.n - (c.x1 * c.x1 + c.y1 * c.y1)) + 1 ∧
    c.m2 * c.m2 = 24 * (c.n - (c.x2 * c.x2 + c.y2 * c.y2)) + 1 ∧
    (trialPrime (c.x1 + 1) = true ∨ trialPrime (c.y1 + 1) = true) ∧
    (trialPrime (c.x2 + 1) = true ∨ trialPrime (c.y2 + 1) = true) := by
  unfold ACert.check at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq] at h
  tauto

lemma cert_pred (c : ACert) (h : c.check = true) :
    A270966.Pred c.n (c.x1, c.y1) ∧ A270966.Pred c.n (c.x2, c.y2) ∧
      (c.x1, c.y1) ≠ (c.x2, c.y2) := by
  obtain ⟨hxley1, hxley2, hsum1, hsum2, hne, hm1, hm2, hp1, hp2⟩ := cert_check_parts c h
  refine ⟨⟨hsum1, hxley1, ?_, ?_⟩, ⟨hsum2, hxley2, ?_, ?_⟩, hne⟩
  · exact hp1.imp trialPrime_prime trialPrime_prime
  · exact is_gp_of_sq hm1
  · exact hp2.imp trialPrime_prime trialPrime_prime
  · exact is_gp_of_sq hm2

lemma lt_succ_of_sq_le {x n : ℕ} (h : x * x ≤ n) : x < n + 1 :=
  Nat.lt_succ_of_le (le_trans (Nat.le_mul_self x) h)

lemma cert_ge2 (c : ACert) (h : c.check = true) : 2 ≤ A270966 c.n := by
  obtain ⟨hp1, hp2, hne⟩ := cert_pred c h
  obtain ⟨hxley1, hxley2, hsum1, hsum2, _, _, _, _, _⟩ := cert_check_parts c h
  exact A270966.ge_two_of_pred
    (lt_succ_of_sq_le (le_trans (Nat.le_add_right _ _) hsum1))
    (lt_succ_of_sq_le (le_trans (Nat.le_add_left _ _) hsum1))
    hp1
    (lt_succ_of_sq_le (le_trans (Nat.le_add_right _ _) hsum2))
    (lt_succ_of_sq_le (le_trans (Nat.le_add_left _ _) hsum2))
    hp2 hne

