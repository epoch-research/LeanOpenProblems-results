/- Thue's lemma and the representation p = x^2 + 6 y^2 for p ≡ 1,7 [MOD 24]. -/

lemma sqrt_mul_le (p : ℕ) : Nat.sqrt p * Nat.sqrt p ≤ p := by
  simpa [pow_two] using Nat.sqrt_le' p

lemma lt_succ_sqrt_mul (p : ℕ) : p < (Nat.sqrt p + 1) * (Nat.sqrt p + 1) := by
  simpa [pow_two, Nat.succ_eq_add_one] using Nat.lt_succ_sqrt' p

lemma natAbs_sub_le_of_le {a b m : ℕ} (ha : a ≤ m) (hb : b ≤ m) :
    ((a : ℤ) - b).natAbs ≤ m := by
  have ha' : (a : ℤ) ≤ m := Nat.cast_le.mpr ha
  have hb' : (b : ℤ) ≤ m := Nat.cast_le.mpr hb
  have : |(a : ℤ) - b| ≤ (m : ℤ) := by
    rw [abs_le]
    constructor <;> omega
  rwa [Int.abs_eq_natAbs, Nat.cast_le] at this

lemma natAbs_mul_le_of_le {x : ℤ} {m p : ℕ}
    (h : x.natAbs ≤ m) (hm : m * m ≤ p) : x.natAbs * x.natAbs ≤ p :=
  (Nat.mul_le_mul h h).trans hm

lemma thue_lemma (p : ℕ) [hp : Fact p.Prime] (a : ℤ) :
    ∃ x y : ℤ, y ≠ 0 ∧
      x.natAbs * x.natAbs ≤ p ∧ y.natAbs * y.natAbs ≤ p ∧
      a * y ≡ x [ZMOD p] := by
  set m := Nat.sqrt p
  have hm_le : m * m ≤ p := sqrt_mul_le p
  have hm_lt : p < (m + 1) * (m + 1) := lt_succ_sqrt_mul p
  let S := Finset.range (m + 1)
  let f : ℕ × ℕ → ZMod p := fun rs => (rs.1 : ZMod p) - (a : ZMod p) * (rs.2 : ZMod p)
  have hS : (S ×ˢ S).card = (m + 1) * (m + 1) := by
    simp [S, Finset.card_product, Finset.card_range]
  have hlt : Fintype.card (ZMod p) < (S ×ˢ S).card := by
    simp [ZMod.card, hS]; exact hm_lt
  have hmap : ∀ t ∈ S ×ˢ S, f t ∈ (Finset.univ : Finset (ZMod p)) := fun _ _ => Finset.mem_univ _
  obtain ⟨p1, hp1, p2, hp2, hne, hf⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hlt hmap
  obtain ⟨r1, s1⟩ := p1
  obtain ⟨r2, s2⟩ := p2
  have hr1 : r1 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp1; omega
  have hs1 : s1 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp1; omega
  have hr2 : r2 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp2; omega
  have hs2 : s2 ≤ m := by simp [S, Finset.mem_product, Finset.mem_range] at hp2; omega
  set x : ℤ := (r1 : ℤ) - r2
  set y : ℤ := (s1 : ℤ) - s2
  have hxle : x.natAbs ≤ m := natAbs_sub_le_of_le hr1 hr2
  have hyle : y.natAbs ≤ m := natAbs_sub_le_of_le hs1 hs2
  have hcong : a * y ≡ x [ZMOD p] := by
    rw [← ZMod.intCast_eq_intCast_iff]
    simp only [x, y, Int.cast_sub, Int.cast_natCast, Int.cast_mul]
    have h' : (r1 : ZMod p) - (a : ZMod p) * (s1 : ZMod p) =
              (r2 : ZMod p) - (a : ZMod p) * (s2 : ZMod p) := by
      simpa [f] using hf
    rw [sub_eq_sub_iff_sub_eq_sub] at h'
    calc (a : ZMod p) * ((s1 : ZMod p) - s2)
        = (a : ZMod p) * s1 - (a : ZMod p) * s2 := by ring
      _ = (r1 : ZMod p) - r2 := h'.symm
  have hsqrt_lt : m < p := Nat.sqrt_lt_self (Nat.Prime.one_lt hp.out)
  have hy0 : y ≠ 0 := by
    intro hy
    have hxmod : (x : ZMod p) = 0 := by
      have : a * 0 ≡ x [ZMOD p] := by simpa [hy] using hcong
      rw [← ZMod.intCast_eq_intCast_iff] at this
      simpa using this.symm
    have hxdvd : (p : ℤ) ∣ x := (ZMod.intCast_zmod_eq_zero_iff_dvd x p).mp hxmod
    have hxlt : x.natAbs < p := lt_of_le_of_lt hxle hsqrt_lt
    have hx00 : x = 0 :=
      Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hxdvd (by simpa [Int.natAbs_natCast] using hxlt)
    have hr : r1 = r2 := by
      have : (r1 : ℤ) = r2 := by simp [x] at hx00; omega
      exact Nat.cast_injective this
    have hs : s1 = s2 := by
      have : (s1 : ℤ) = s2 := by simp [y] at hy; omega
      exact Nat.cast_injective this
    exact hne (Prod.ext hr hs)
  exact ⟨x, y, hy0, natAbs_mul_le_of_le hxle hm_le, natAbs_mul_le_of_le hyle hm_le, hcong⟩

lemma sq_mod_three (x : ℤ) : x * x % 3 = 0 ∨ x * x % 3 = 1 := by
  have : x % 3 = 0 ∨ x % 3 = 1 ∨ x % 3 = 2 := by omega
  have hx : x * x % 3 = (x % 3) * (x % 3) % 3 := Int.mul_emod _ _ _
  rcases this with h | h | h <;> simp [hx, h]

