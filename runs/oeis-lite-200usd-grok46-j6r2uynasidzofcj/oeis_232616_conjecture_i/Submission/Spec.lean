lemma pg_ok_0 : checkPGR 20 50 gapPacked_0 2857 = true := rfl

lemma pg_last_0 : lastPGR 20 50 gapPacked_0 2857 = 11807 := rfl

lemma pg_ge_0 :
    Nat.count Nat.Prime (2857 + 1) + 20 * 50 ≤ Nat.count Nat.Prime (11807 + 1) := by
  have h := checkPGR_ge 20 50 gapPacked_0 2857 pg_ok_0
  rw [pg_last_0] at h
  exact h

lemma pg_acc_0 :
    Nat.count Nat.Prime (2857 + 1) + 1000 ≤ Nat.count Nat.Prime (11807 + 1) := by
  have h := pg_ge_0
  have hs : 20 * 50 = 1000 := rfl
  rwa [hs] at h

