def checkPG : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | fuel + 1, packed, prev =>
      let g := packed % GAP_BASE
      let p := prev + g
      decide (0 < g) && decide (2857 < p) && (Nat.gcd P2857 p == 1) &&
        decide (p ≤ lastPrime0) && checkPG fuel (packed / GAP_BASE) p

def lastPG : ℕ → ℕ → ℕ → ℕ
  | 0, _, prev => prev
  | fuel + 1, packed, prev =>
      lastPG fuel (packed / GAP_BASE) (prev + packed % GAP_BASE)

private lemma checkPG_and5 {a b c d e : Bool}
    (h : (a && b && c && d && e) = true) :
    a = true ∧ b = true ∧ c = true ∧ d = true ∧ e = true := by
  have h1 := Bool.and_eq_true_iff.1 h
  have h2 := Bool.and_eq_true_iff.1 h1.1
  have h3 := Bool.and_eq_true_iff.1 h2.1
  have h4 := Bool.and_eq_true_iff.1 h3.1
  exact ⟨h4.1, h4.2, h3.2, h2.2, h1.2⟩

lemma checkPG_ge (fuel packed prev : ℕ)
    (h : checkPG fuel packed prev = true) :
    Nat.count Nat.Prime (prev + 1) + fuel ≤
      Nat.count Nat.Prime (lastPG fuel packed prev + 1) := by
  induction fuel generalizing packed prev with
  | zero =>
      change Nat.count Nat.Prime (prev + 1) + 0 ≤
        Nat.count Nat.Prime (prev + 1)
      omega
  | succ fuel ih =>
      have hunf : checkPG (fuel + 1) packed prev =
          (decide (0 < packed % GAP_BASE) &&
            decide (2857 < prev + packed % GAP_BASE) &&
            (Nat.gcd P2857 (prev + packed % GAP_BASE) == 1) &&
            decide (prev + packed % GAP_BASE ≤ lastPrime0) &&
            checkPG fuel (packed / GAP_BASE) (prev + packed % GAP_BASE)) := rfl
      have h5 := checkPG_and5 (hunf ▸ h)
      have hgpos : 0 < packed % GAP_BASE := decide_eq_true_eq.mp h5.1
      have hbig : 2857 < prev + packed % GAP_BASE := decide_eq_true_eq.mp h5.2.1
      have hgcd : (Nat.gcd P2857 (prev + packed % GAP_BASE) == 1) = true := h5.2.2.1
      have hple : prev + packed % GAP_BASE ≤ lastPrime0 := decide_eq_true_eq.mp h5.2.2.2.1
      have hrest : checkPG fuel (packed / GAP_BASE)
          (prev + packed % GAP_BASE) = true := h5.2.2.2.2
      have hfast : fastPrime (prev + packed % GAP_BASE) = true := by
        unfold fastPrime
        exact Bool.and_eq_true_iff.2 ⟨decide_eq_true_eq.mpr hbig, hgcd⟩
      have hp : Nat.Prime (prev + packed % GAP_BASE) := prime_of_fast hfast hple
      have hlo : prev + 1 ≤ prev + packed % GAP_BASE :=
        Nat.succ_le_iff.mpr (Nat.lt_add_of_pos_right hgpos)
      have hcnt : Nat.count Nat.Prime (prev + 1) + 1 ≤
          Nat.count Nat.Prime (prev + packed % GAP_BASE + 1) :=
        count_succ_prime hp hlo
      have ih' := ih (packed / GAP_BASE) (prev + packed % GAP_BASE) hrest
      change Nat.count Nat.Prime (prev + 1) + (fuel + 1) ≤
          Nat.count Nat.Prime (lastPG fuel (packed / GAP_BASE)
            (prev + packed % GAP_BASE) + 1)
      omega

def checkPGR : ℕ → ℕ → ℕ → ℕ → Bool
  | 0, _, _, _ => true
  | r + 1, inner, packed, prev =>
      checkPG inner packed prev &&
        checkPGR r inner (packed / GAP_BASE ^ inner) (lastPG inner packed prev)

def lastPGR : ℕ → ℕ → ℕ → ℕ → ℕ
  | 0, _, _, prev => prev
  | r + 1, inner, packed, prev =>
      lastPGR r inner (packed / GAP_BASE ^ inner) (lastPG inner packed prev)

lemma checkPGR_ge (rounds inner packed prev : ℕ)
    (h : checkPGR rounds inner packed prev = true) :
    Nat.count Nat.Prime (prev + 1) + rounds * inner ≤
      Nat.count Nat.Prime (lastPGR rounds inner packed prev + 1) := by
  induction rounds generalizing packed prev with
  | zero =>
      change Nat.count Nat.Prime (prev + 1) + 0 * inner ≤
        Nat.count Nat.Prime (prev + 1)
      omega
  | succ rounds ih =>
      have hunf : checkPGR (rounds + 1) inner packed prev =
          (checkPG inner packed prev &&
            checkPGR rounds inner (packed / GAP_BASE ^ inner)
              (lastPG inner packed prev)) := rfl
      have h' : checkPG inner packed prev = true ∧
          checkPGR rounds inner (packed / GAP_BASE ^ inner)
            (lastPG inner packed prev) = true :=
        Bool.and_eq_true_iff.1 (hunf ▸ h)
      have h1 := checkPG_ge inner packed prev h'.1
      have h2 := ih (packed / GAP_BASE ^ inner)
        (lastPG inner packed prev) h'.2
      change Nat.count Nat.Prime (prev + 1) + (rounds + 1) * inner ≤
          Nat.count Nat.Prime (lastPGR rounds inner (packed / GAP_BASE ^ inner)
            (lastPG inner packed prev) + 1)
      have hmul : (rounds + 1) * inner = inner + rounds * inner := by ring
      rw [hmul]
      omega

lemma count_mono {a b : ℕ} (h : a ≤ b) :
    Nat.count Nat.Prime a ≤ Nat.count Nat.Prime b := by
  simp only [Nat.count_eq_card_filter_range]
  refine Finset.card_le_card ?_
  intro x hx
  have hx' := Finset.mem_filter.mp hx
  exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr
    (lt_of_lt_of_le (Finset.mem_range.mp hx'.1) h), hx'.2⟩

