lemma two_le_pow_mod_eq (k : ℕ) (hk : 2 ≤ k)
    (b c : ℕ) (hb : b = 2 ^ k % 343) (hc : c = 2 ^ k % 401) :
    recon b c = 2 ^ k % n0 := by
  have hb343 : b < 343 := by rw [hb]; exact Nat.mod_lt _ (by decide)
  have hc401 : c < 401 := by rw [hc]; exact Nat.mod_lt _ (by decide)
  have hx4 : recon b c % 4 = 0 := recon_mod4 b c
  have hk4 : 2 ^ k % 4 = 0 := two_pow_mod4_of_two hk
  have hx343 : recon b c % 343 = 2 ^ k % 343 := by rw [recon_mod343 b c hb343, hb]
  have hx401 : recon b c % 401 = 2 ^ k % 401 := by rw [recon_mod401 b c hb343 hc401, hc]
  have h137 : recon b c ≡ 2 ^ k [MOD 137543] := by
    have h343 : recon b c ≡ 2 ^ k [MOD 343] := hx343
    have h401 : recon b c ≡ 2 ^ k [MOD 401] := hx401
    have := (Nat.modEq_and_modEq_iff_modEq_mul coprime_343_401).1 ⟨h343, h401⟩
    simpa [m137543_eq] using this
  have h4 : recon b c ≡ 2 ^ k [MOD 4] := by
    change recon b c % 4 = 2 ^ k % 4
    rw [hx4, hk4]
  have hn0 : recon b c ≡ 2 ^ k [MOD n0] := by
    have := (Nat.modEq_and_modEq_iff_modEq_mul coprime_4_137543).1 ⟨h4, h137⟩
    simpa [n0_fact, Nat.mul_comm 4] using this
  have hlt : recon b c < n0 := recon_lt b c
  have : recon b c % n0 = 2 ^ k % n0 := hn0
  rwa [Nat.mod_eq_of_lt hlt] at this

def pow2mod (k : ℕ) : ℕ :=
  if k ≤ 1 then 2 ^ k % n0
  else recon (2 ^ (k % 147) % 343) (2 ^ (k % 200) % 401)

lemma pow2mod_spec (k : ℕ) : pow2mod k = 2 ^ k % n0 := by
  unfold pow2mod
  split_ifs with h
  · rfl
  · have hk : 2 ≤ k := by omega
    apply two_le_pow_mod_eq k hk
    · exact (two_pow_mod_343 k).symm
    · exact (two_pow_mod_401 k).symm

def HIT_BASE : ℕ := 33554432
def GAP_BASE : ℕ := 256

def checkOne (k r : ℕ) : Bool :=
  decide (1 ≤ k) && decide (k ≤ cover0) && (pow2mod k == (r + k) % n0)

lemma checkOne_iff (k r : ℕ) :
    checkOne k r = true ↔
      1 ≤ k ∧ k ≤ cover0 ∧ pow2mod k = (r + k) % n0 := by
  constructor
  · intro h
    have h' : (decide (1 ≤ k) = true ∧ decide (k ≤ cover0) = true) ∧
        (pow2mod k == (r + k) % n0) = true := by
      simpa [checkOne, Bool.and_eq_true] using h
    exact ⟨decide_eq_true_eq.mp h'.1.1, decide_eq_true_eq.mp h'.1.2,
      beq_iff_eq.mp h'.2⟩
  · intro h
    refine Bool.and_eq_true_iff.2 ⟨Bool.and_eq_true_iff.2 ⟨?_, ?_⟩, ?_⟩
    · exact decide_eq_true_eq.mpr h.1
    · exact decide_eq_true_eq.mpr h.2.1
    · exact beq_iff_eq.mpr h.2.2

def checkHits : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | fuel + 1, packed, start =>
      checkOne (packed % HIT_BASE) start &&
        checkHits fuel (packed / HIT_BASE) (start + 1)

lemma exists_of_checkHits (fuel packed start : ℕ)
    (h : checkHits fuel packed start = true)
    (r : ℕ) (h1 : start ≤ r) (h2 : r < start + fuel) :
    ∃ k, 1 ≤ k ∧ k ≤ cover0 ∧ pow2mod k = (r + k) % n0 := by
  induction fuel generalizing packed start r with
  | zero => omega
  | succ fuel ih =>
      have hunf : checkHits (fuel + 1) packed start =
          (checkOne (packed % HIT_BASE) start &&
            checkHits fuel (packed / HIT_BASE) (start + 1)) := rfl
      have h' : checkOne (packed % HIT_BASE) start = true ∧
          checkHits fuel (packed / HIT_BASE) (start + 1) = true :=
        Bool.and_eq_true_iff.1 (hunf ▸ h)
      rcases eq_or_lt_of_le h1 with heq | hlt
      · subst heq
        refine ⟨packed % HIT_BASE, (checkOne_iff (packed % HIT_BASE) start).1 h'.1⟩
      · exact ih (packed / HIT_BASE) (start + 1) h'.2 r hlt (by omega)

def checkHitsR : ℕ → ℕ → ℕ → ℕ → Bool
  | 0, _, _, _ => true
  | r + 1, inner, packed, start =>
      checkHits inner packed start &&
        checkHitsR r inner (packed / HIT_BASE ^ inner) (start + inner)

lemma exists_of_checkHitsR (rounds inner packed start : ℕ)
    (h : checkHitsR rounds inner packed start = true)
    (r : ℕ) (h1 : start ≤ r) (h2 : r < start + rounds * inner) :
    ∃ k, 1 ≤ k ∧ k ≤ cover0 ∧ pow2mod k = (r + k) % n0 := by
  induction rounds generalizing packed start r with
  | zero => omega
  | succ rounds ih =>
      have hunf : checkHitsR (rounds + 1) inner packed start =
          (checkHits inner packed start &&
            checkHitsR rounds inner (packed / HIT_BASE ^ inner) (start + inner)) := rfl
      have h' : checkHits inner packed start = true ∧
          checkHitsR rounds inner (packed / HIT_BASE ^ inner) (start + inner) = true :=
        Bool.and_eq_true_iff.1 (hunf ▸ h)
      by_cases hlt : r < start + inner
      · exact exists_of_checkHits inner packed start h'.1 r h1 hlt
      · have hge : start + inner ≤ r := Nat.le_of_not_lt hlt
        have h2' : r < (start + inner) + rounds * inner := by
          have : start + (rounds + 1) * inner = start + inner + rounds * inner := by
            ring
          omega
        exact ih (packed / HIT_BASE ^ inner) (start + inner) h'.2 r hge h2'

def checkMiss (i t : ℕ) : Bool :=
  let k := baseOf i + period0 * t
  decide (bound0 ≤ k) || !(pow2mod k == (missR + k) % n0)

lemma checkMiss_spec (i t : ℕ) (h : checkMiss i t = true) :
    bound0 ≤ baseOf i + period0 * t ∨
      pow2mod (baseOf i + period0 * t) ≠
        (missR + (baseOf i + period0 * t)) % n0 := by
  dsimp [checkMiss] at h
  cases hb : decide (bound0 ≤ baseOf i + period0 * t) with
  | true =>
    left
    exact decide_eq_true_eq.mp hb
  | false =>
    right
    have hne : (pow2mod (baseOf i + period0 * t) ==
        (missR + (baseOf i + period0 * t)) % n0) = false := by
      simpa [hb] using h
    exact beq_eq_false_iff_ne.mp hne

def checkMissRow (i : ℕ) : Bool :=
  (List.range 204).all (fun t => checkMiss i t)

lemma checkMissRow_spec (i : ℕ) (h : checkMissRow i = true) :
    ∀ t, t ≤ 203 → checkMiss i t = true := by
  intro t ht
  have : t ∈ List.range 204 := by
    simp [List.mem_range]
    omega
  exact List.all_eq_true.mp h t this

def noDiv : ℕ → ℕ → ℕ → Bool
  | _, _, 0 => true
  | p, d, fuel + 1 => (p % d != 0) && noDiv p (d + 1) fuel

def sqrtFuel : ℕ → ℕ → ℕ → ℕ
  | _, guess, 0 => guess
  | n, guess, fuel + 1 =>
      let next := (guess + n / guess) / 2
      if next < guess then sqrtFuel n next fuel else guess

def sqrtRed (n : ℕ) : ℕ :=
  if n ≤ 1 then n else sqrtFuel n n 40

def trialPrime (p : ℕ) : Bool :=
  let s := sqrtRed p
  decide (2 ≤ p) && decide (s * s ≤ p) && decide (p < (s + 1) * (s + 1)) &&
    noDiv p 2 (s - 1)

lemma noDiv_spec :
    ∀ (fuel p d : ℕ), noDiv p d fuel = true →
      ∀ x, d ≤ x → x < d + fuel → p % x ≠ 0
  | 0, p, d, _, x, h1, h2 => by omega
  | fuel + 1, p, d, h, x, h1, h2 => by
      have h' : (p % d != 0) = true ∧ noDiv p (d + 1) fuel = true := by
        simpa [noDiv, Bool.and_eq_true] using h
      have hd : p % d ≠ 0 := bne_iff_ne.mp h'.1
      rcases Nat.eq_or_lt_of_le h1 with heq | hlt
      · subst heq; exact hd
      · exact noDiv_spec fuel p (d + 1) h'.2 x hlt (by omega)

lemma next_pos {n guess : ℕ} (hn : 1 ≤ n) (hg : 1 ≤ guess) :
    1 ≤ (guess + n / guess) / 2 := by
  by_cases hle : guess ≤ n
  · have hdiv : 1 ≤ n / guess :=
      (Nat.le_div_iff_mul_le (by omega : 0 < guess)).2 (by omega)
    omega
  · have : n / guess = 0 := Nat.div_eq_of_lt (by omega)
    rw [this, Nat.add_zero]
    exact (Nat.le_div_iff_mul_le (by decide : 0 < 2)).2 (by omega)

lemma sqrtFuel_pos :
    ∀ (fuel guess n : ℕ), 1 ≤ n → 1 ≤ guess → 1 ≤ sqrtFuel n guess fuel
  | 0, guess, n, _, hg => hg
  | fuel + 1, guess, n, hn, hg => by
      change 1 ≤
        (let next := (guess + n / guess) / 2
         if next < guess then sqrtFuel n next fuel else guess)
      dsimp
      split_ifs with hlt
      · exact sqrtFuel_pos fuel ((guess + n / guess) / 2) n hn (next_pos hn hg)
      · exact hg

lemma sqrtRed_pos {n : ℕ} (h : 2 ≤ n) : 1 ≤ sqrtRed n := by
  unfold sqrtRed
  split_ifs with h1
  · omega
  · exact sqrtFuel_pos 40 n n (by omega) (by omega)

lemma sqrt_eq (p s : ℕ) (h1 : s * s ≤ p) (h2 : p < (s + 1) * (s + 1)) :
    Nat.sqrt p = s := by
  refine le_antisymm ?_ (Nat.le_sqrt.2 h1)
  exact Nat.lt_succ_iff.mp (Nat.sqrt_lt.2 h2)

lemma prime_of_nodiv {p s : ℕ} (hp2 : 2 ≤ p)
    (hs : Nat.sqrt p = s) (hs1 : 1 ≤ s)
    (hnd : (List.range (s - 1)).all (fun i => p % (i + 2) != 0) = true) :
    Nat.Prime p := by
  rw [Nat.prime_def_le_sqrt]
  refine ⟨hp2, ?_⟩
  intro m hm2 hms
  rw [hs] at hms
  have hi : m - 2 < s - 1 := by omega
  have hbool : (p % (m - 2 + 2) != 0) = true :=
    List.all_eq_true.mp hnd (m - 2) (List.mem_range.mpr hi)
  have hm : m - 2 + 2 = m := by omega
  rw [hm] at hbool
  have hne : p % m ≠ 0 := bne_iff_ne.mp hbool
  exact fun hdiv => hne (Nat.mod_eq_zero_of_dvd hdiv)

lemma trialPrime_spec {p : ℕ} (h : trialPrime p = true) : Nat.Prime p := by
  have h' :
      ((decide (2 ≤ p) = true ∧ decide (sqrtRed p * sqrtRed p ≤ p) = true) ∧
        decide (p < (sqrtRed p + 1) * (sqrtRed p + 1)) = true) ∧
        noDiv p 2 (sqrtRed p - 1) = true := by
    simpa [trialPrime, Bool.and_eq_true] using h
  have hp2 : 2 ≤ p := decide_eq_true_eq.mp h'.1.1.1
  have hs1 : sqrtRed p * sqrtRed p ≤ p := decide_eq_true_eq.mp h'.1.1.2
  have hs2 : p < (sqrtRed p + 1) * (sqrtRed p + 1) := decide_eq_true_eq.mp h'.1.2
  have hnd : noDiv p 2 (sqrtRed p - 1) = true := h'.2
  have hsqrt : Nat.sqrt p = sqrtRed p := sqrt_eq p (sqrtRed p) hs1 hs2
  have hspos : 1 ≤ sqrtRed p := sqrtRed_pos hp2
  refine prime_of_nodiv hp2 hsqrt hspos ?_
  refine List.all_eq_true.mpr ?_
  intro i hi
  have hi' : i < sqrtRed p - 1 := List.mem_range.mp hi
  have hne : p % (i + 2) ≠ 0 :=
    noDiv_spec (sqrtRed p - 1) p 2 hnd (i + 2) (by omega) (by omega)
  exact bne_iff_ne.mpr hne

lemma lastPrime_sqrt_bound : Nat.sqrt 8165753 ≤ 2857 := by
  have : Nat.sqrt 8165753 < 2858 := by
    rw [Nat.sqrt_lt]
    decide
