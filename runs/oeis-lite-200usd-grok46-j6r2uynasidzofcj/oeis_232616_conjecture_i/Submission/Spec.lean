lemma p_divides_P {q : ℕ} (hq : q ∈ smallPrimes) : q ∣ P2857 :=
  Nat.dvd_of_mod_eq_zero (beq_iff_eq.mp (List.all_eq_true.mp all_div q hq))

lemma sqrtRed_eq_sqrt {n : ℕ} (hn : n < 2858) : Nat.sqrt n = sqrtRed n := by
  have h := List.all_eq_true.mp sqrtRed_ok_below n (List.mem_range.mpr hn)
  have h' : decide (sqrtRed n * sqrtRed n ≤ n) = true ∧
      decide (n < (sqrtRed n + 1) * (sqrtRed n + 1)) = true :=
    Bool.and_eq_true_iff.1 h
  exact sqrt_eq n (sqrtRed n) (decide_eq_true_eq.mp h'.1) (decide_eq_true_eq.mp h'.2)

lemma trialPrime_of_prime {p : ℕ} (hp : Nat.Prime p) (hle : p ≤ 2857) :
    trialPrime p = true := by
  have hp2 : 2 ≤ p := hp.two_le
  have hlt : p < 2858 := Nat.lt_succ_of_le hle
  have hs : Nat.sqrt p = sqrtRed p := sqrtRed_eq_sqrt hlt
  have h1 : decide (2 ≤ p) = true := decide_eq_true_eq.mpr hp2
  have h2 : decide (sqrtRed p * sqrtRed p ≤ p) = true :=
    decide_eq_true_eq.mpr (by rw [← hs]; exact Nat.sqrt_le p)
  have h3 : decide (p < (sqrtRed p + 1) * (sqrtRed p + 1)) = true :=
    decide_eq_true_eq.mpr (by rw [← hs]; exact Nat.lt_succ_sqrt p)
  have hnd : noDiv p 2 (sqrtRed p - 1) = true := by
    refine noDiv_of (sqrtRed p - 1) p 2 ?_
    intro x hx1 hx2 hmod
    have hdvd : x ∣ p := Nat.dvd_of_mod_eq_zero hmod
    have hxle : x ≤ sqrtRed p := by omega
    have hxlt : x < p :=
      lt_of_le_of_lt (hxle.trans_eq hs.symm) (Nat.sqrt_lt_self hp.one_lt)
    exact Nat.not_prime_of_dvd_of_lt hdvd hx1 hxlt hp
  unfold trialPrime
  change (decide (2 ≤ p) && decide (sqrtRed p * sqrtRed p ≤ p) &&
      decide (p < (sqrtRed p + 1) * (sqrtRed p + 1)) &&
      noDiv p 2 (sqrtRed p - 1)) = true
  refine Bool.and_eq_true_iff.2 ⟨Bool.and_eq_true_iff.2 ⟨Bool.and_eq_true_iff.2 ⟨h1, h2⟩, h3⟩, hnd⟩

