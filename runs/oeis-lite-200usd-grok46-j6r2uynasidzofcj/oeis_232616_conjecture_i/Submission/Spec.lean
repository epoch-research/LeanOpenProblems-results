def fastPrime (p : ℕ) : Bool :=
  decide (2857 < p) && (Nat.gcd P2857 p == 1)

lemma prime_of_fast {p : ℕ} (h : fastPrime p = true) (hle : p ≤ lastPrime0) :
    Nat.Prime p := by
  have h' : decide (2857 < p) = true ∧ (Nat.gcd P2857 p == 1) = true := by
    simpa [fastPrime, Bool.and_eq_true] using h
  have hbig : 2857 < p := decide_eq_true_eq.mp h'.1
  have hgcd : Nat.gcd P2857 p = 1 := beq_iff_eq.mp h'.2
  rw [Nat.prime_def_le_sqrt]
  refine ⟨by omega, ?_⟩
  intro m hm2 hmsqrt hdvd
  have hmle : m ≤ 2857 := le_trans hmsqrt (sqrt_le_of_le_last hle)
  have hmf_prime : Nat.Prime (Nat.minFac m) := Nat.minFac_prime (by omega)
  have hmf_dvd : Nat.minFac m ∣ p := Nat.dvd_trans (Nat.minFac_dvd m) hdvd
  have hmf_le : Nat.minFac m ≤ 2857 :=
    le_trans (Nat.minFac_le (by omega : 0 < m)) hmle
  have hmf_in : Nat.minFac m ∈ smallPrimes :=
    smallPrimes_complete hmf_le hmf_prime
  have hmf_dvd_P : Nat.minFac m ∣ P2857 := p_divides_P hmf_in
  have hdivg : Nat.minFac m ∣ Nat.gcd P2857 p := Nat.dvd_gcd hmf_dvd_P hmf_dvd
  rw [hgcd] at hdivg
  have h2 : 2 ≤ Nat.minFac m := hmf_prime.two_le
  have : Nat.minFac m = 1 := Nat.eq_one_of_dvd_one hdivg
  omega

