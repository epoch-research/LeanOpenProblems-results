lemma noDiv_of :
    ∀ (fuel p d : ℕ),
      (∀ x, d ≤ x → x < d + fuel → p % x ≠ 0) →
      noDiv p d fuel = true
  | 0, p, d, _ => rfl
  | fuel + 1, p, d, h => by
      have hd : p % d ≠ 0 := h d le_rfl (by omega)
      have hb : (p % d != 0) = true := bne_iff_ne.mpr hd
      have ih : noDiv p (d + 1) fuel = true :=
        noDiv_of fuel p (d + 1) (fun x h1 h2 => h x (by omega) (by omega))
      simpa [noDiv, hb] using ih

lemma count_succ_prime {q lo : ℕ} (hp : Nat.Prime q) (hlo : lo ≤ q) :
    Nat.count Nat.Prime lo + 1 ≤ Nat.count Nat.Prime (q + 1) := by
  rw [Nat.count_eq_card_filter_range, Nat.count_eq_card_filter_range]
  set s := (Finset.range lo).filter Nat.Prime
  set t := (Finset.range (q + 1)).filter Nat.Prime
  have hmem : q ∈ t := by
    simp [t, Finset.mem_filter, Finset.mem_range, hp]
  have hnotin : q ∉ s := by
    intro hq
    have hql : q < lo := Finset.mem_range.mp (Finset.mem_filter.mp hq).1
    exact (not_lt_of_ge hlo) hql
  have hsub : s ⊆ t.erase q := by
    intro x hx
    have hx' : x ∈ t := by
      have hx2 := Finset.mem_filter.mp hx
      refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ?_, hx2.2⟩
      exact lt_trans (Finset.mem_range.mp hx2.1) (Nat.lt_succ_of_le hlo)
    exact Finset.mem_erase.2 ⟨fun heq => hnotin (heq ▸ hx), hx'⟩
  have hle := Finset.card_le_card hsub
  rw [Finset.card_erase_of_mem hmem] at hle
  have htpos : 1 ≤ t.card := Finset.card_pos.2 ⟨q, hmem⟩
  omega

