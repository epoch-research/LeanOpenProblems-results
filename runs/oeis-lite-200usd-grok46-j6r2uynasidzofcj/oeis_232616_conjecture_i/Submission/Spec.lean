lemma mul_mod_cancel (a x m : ℕ) : a * (x % m) % m = a * x % m := by
  rw [Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]

lemma x0_mod401 (b c : ℕ) (hb : b < 343) (hc : c < 401) :
    x0Of b c % 401 = c := by
  unfold x0Of
  rw [m137543_eq, Nat.mod_mul_left_mod]
  have hb401 : b % 401 = b := Nat.mod_eq_of_lt (lt_trans hb (by decide : 343 < 401))
  rw [hb401]
  have hle : b ≤ c + 401 := by omega
  have hpull :
      (b + 343 * (((c + 401 - b) * 159) % 401)) % 401 =
        (b + 343 * ((c + 401 - b) * 159)) % 401 := by
    rw [Nat.add_mod, Nat.add_mod b (343 * ((c + 401 - b) * 159))]
    congr 2
    exact mul_mod_cancel 343 ((c + 401 - b) * 159) 401
  rw [hpull]
  have hdistrib : 343 * ((c + 401 - b) * 159) = (343 * 159) * (c + 401 - b) := by
    ring
  rw [hdistrib]
  have hfac : 343 * 159 = 401 * 136 + 1 := by decide
  rw [hfac]
  have hrep :
      b + (401 * 136 + 1) * (c + 401 - b) =
        c + 401 * (1 + 136 * (c + 401 - b)) := by
    have hsum : b + (c + 401 - b) = c + 401 := Nat.add_sub_of_le hle
    calc
      b + (401 * 136 + 1) * (c + 401 - b)
          = b + (c + 401 - b) + 401 * 136 * (c + 401 - b) := by ring
      _ = c + 401 + 401 * 136 * (c + 401 - b) := by rw [hsum]
      _ = c + 401 * (1 + 136 * (c + 401 - b)) := by ring
  rw [hrep, Nat.add_mul_mod_self_left]
  exact Nat.mod_eq_of_lt hc

