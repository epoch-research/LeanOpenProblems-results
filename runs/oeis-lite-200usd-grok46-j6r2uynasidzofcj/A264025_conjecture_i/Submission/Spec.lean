lemma exists_rep_of_allowed_z {n z : ℕ}
    (hz : Nat.Prime z ∨ Nat.Prime (z + 1))
    (hle : z * (z + 1) / 2 ≤ n)
    (hS : InS (n - z * (z + 1) / 2)) :
    ∃ x y, IsA264025Rep n x y z :=
  exists_rep_of_inS hz hle hS

lemma exists_rep_of_prime_inS {n p : ℕ}
    (hp : Nat.Prime p)
    (hle : p * (p + 1) / 2 ≤ n)
    (hS : InS (n - p * (p + 1) / 2)) :
    ∃ x y z, IsA264025Rep n x y z := by
  obtain ⟨x, y, hrep⟩ := exists_rep_of_inS (Or.inl hp) hle hS
  exact ⟨x, y, p, hrep⟩

lemma exists_rep_of_pred_prime_inS {n p : ℕ}
    (hp : Nat.Prime p) (hp0 : 0 < p)
    (hle : (p - 1) * p / 2 ≤ n)
    (hS : InS (n - (p - 1) * p / 2)) :
    ∃ x y z, IsA264025Rep n x y z := by
  have hp1 : p - 1 + 1 = p := Nat.sub_add_cancel hp0
  have hle' : (p - 1) * ((p - 1) + 1) / 2 ≤ n := by simpa [hp1] using hle
  have hS' : InS (n - (p - 1) * ((p - 1) + 1) / 2) := by simpa [hp1] using hS
  have hz : Nat.Prime (p - 1) ∨ Nat.Prime (p - 1 + 1) := by
    rw [hp1]; exact Or.inr hp
  obtain ⟨x, y, hrep⟩ := exists_rep_of_inS (z := p - 1) hz hle' hS'
  exact ⟨x, y, p - 1, hrep⟩

/-- Algebraic pairing: a representation yields a 3-square identity for `4n+1`. -/
lemma pairing_expand (x y z : ℕ) :
    (2 * y + z + 1 : ℤ) ^ 2 + (2 * y - z : ℤ) ^ 2 + (2 * x : ℤ) ^ 2
      = 4 * (x : ℤ) ^ 2 + 8 * (y : ℤ) ^ 2 + 4 * y + 2 * (z : ℤ) ^ 2 + 2 * z + 1 := by
  ring

lemma four_mul_tri (z : ℕ) :
    (4 : ℤ) * (z * (z + 1) / 2 : ℕ) = 2 * (z : ℤ) ^ 2 + 2 * z := by
  have h : (2 : ℕ) * (z * (z + 1) / 2) = z * (z + 1) :=
    Nat.mul_div_cancel' (even_iff_two_dvd.mp (Nat.even_mul_succ_self z))
  have h4 : (4 : ℕ) * (z * (z + 1) / 2) = 2 * z ^ 2 + 2 * z := by
    have := congrArg (· * 2) h
    nlinarith
  exact_mod_cast h4

lemma pairing_int_n (x y z : ℕ) :
    (2 * y + z + 1 : ℤ) ^ 2 + (2 * y - z : ℤ) ^ 2 + (2 * x : ℤ) ^ 2
      = 4 * ((x : ℤ) ^ 2 + (y : ℤ) * (2 * y + 1) + (z * (z + 1) / 2 : ℕ)) + 1 := by
  rw [pairing_expand]
  have ht := four_mul_tri z
  have hy : (4 : ℤ) * ((y : ℤ) * (2 * y + 1)) = 8 * (y : ℤ) ^ 2 + 4 * y := by ring
  linarith

lemma pairing_nat (n x y z : ℕ)
    (h : x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n) :
    (2 * y + z + 1) ^ 2 + (2 * y - z : ℤ).natAbs ^ 2 + (2 * x) ^ 2
      = 4 * n + 1 := by
  have him := pairing_int_n x y z
  have hn : (x : ℤ) ^ 2 + (y : ℤ) * (2 * y + 1) + (z * (z + 1) / 2 : ℕ) = (n : ℤ) :=
    by exact_mod_cast h
  rw [hn] at him
  have ha : ((2 * y - z : ℤ).natAbs : ℤ) ^ 2 = (2 * y - z : ℤ) ^ 2 :=
    Int.natAbs_sq _
  have : ((2 * y + z + 1 : ℕ) : ℤ) ^ 2
      + ((2 * y - z : ℤ).natAbs : ℤ) ^ 2
      + ((2 * x : ℕ) : ℤ) ^ 2
      = 4 * (n : ℤ) + 1 := by
    simpa [ha] using him
  exact_mod_cast this

/-- Recover a representation from the eight-square form with the prime condition. -/
lemma exists_rep_of_eight_form {n A B C : ℕ}
    (h : A ^ 2 + B ^ 2 + 8 * C ^ 2 = 8 * n + 2)
    (hA : A % 4 = 1) (hB : Odd B)
    (hp : Nat.Prime ((B - 1) / 2) ∨ Nat.Prime ((B - 1) / 2 + 1)) :
    ∃ x y z, IsA264025Rep n x y z := by
  obtain ⟨y, hy⟩ : ∃ y, A = 4 * y + 1 := ⟨A / 4, by omega⟩
  obtain ⟨z, hz⟩ : ∃ z, B = 2 * z + 1 := by
    have : B % 2 = 1 := Nat.odd_iff.mp hB
    exact ⟨B / 2, by omega⟩
  have h' : (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * C ^ 2 = 8 * n + 2 := by
    simpa [hy, hz] using h
  have hz1 : (B - 1) / 2 = z := by
    have : B - 1 = 2 * z := by omega
    simp [this]
  refine ⟨C, y, z, isRep_of_form h' (by simpa [hz1] using hp)⟩

