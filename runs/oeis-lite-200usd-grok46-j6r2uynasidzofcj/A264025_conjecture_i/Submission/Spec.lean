  by_cases hident10 : (p₃ + 1) ^ 2 ≤ n ∧ IsSquare (n - (p₃ + 1) ^ 2)
  · exact exists_rep_of_sq_add_succ_prime_sq_of_le hp₃_prime hp₃_ne2 hident10.1 hident10.2
  by_cases hident11 : p₃ * (p₃ - 1) ≤ n ∧ IsSquare (n - p₃ * (p₃ - 1))
