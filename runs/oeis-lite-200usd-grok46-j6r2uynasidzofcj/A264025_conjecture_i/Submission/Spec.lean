import FormalConjectures.Util.ProblemImports

open Nat Finset

/--
A264025: Number of ways to write $n$ as $x^2 + y(2y+1) + \frac{z(z+1)}{2}$
where $x, y$ and $z$ are nonnegative integers with $z$ or $z+1$ prime.
-/
noncomputable def A264025 (n : ℕ) : ℕ :=
  Nat.card { p : ℕ × ℕ × ℕ //
    let (x, y, z) := p
    x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
    (Nat.Prime z ∨ Nat.Prime (z + 1))
  }

def IsA264025Rep (n x y z : ℕ) : Prop :=
  x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
  (Nat.Prime z ∨ Nat.Prime (z + 1))

instance (n x y z : ℕ) : Decidable (IsA264025Rep n x y z) := by
  dsimp [IsA264025Rep]; infer_instance

def isRep (n x y z : ℕ) : Bool :=
  decide (x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n) &&
  (decide (Nat.Prime z) || decide (Nat.Prime (z + 1)))

lemma isRep_iff (n x y z : ℕ) : isRep n x y z = true ↔ IsA264025Rep n x y z := by
  simp [isRep, IsA264025Rep, Bool.and_eq_true, Bool.or_eq_true]

lemma le_parts (n x y z : ℕ) (h : IsA264025Rep n x y z) :
    x * x ≤ n ∧ y * (2 * y + 1) ≤ n ∧ z * (z + 1) / 2 ≤ n := by
  obtain ⟨heq, _⟩ := h
  have hx : x ^ 2 ≤ n := by
    have := Nat.le_add_right (x ^ 2) (y * (2 * y + 1) + z * (z + 1) / 2)
    rw [← Nat.add_assoc] at this
    exact this.trans heq.le
  exact ⟨by simpa [pow_two] using hx, by omega, by omega⟩

lemma xyz_le_of_rep (n x y z : ℕ) (h : IsA264025Rep n x y z) :
    x ≤ n ∧ y ≤ n ∧ z ≤ n := by
  have ⟨hx2, hy2, hz2⟩ := le_parts n x y z h
  refine ⟨?_, ?_, ?_⟩
  · cases x with
    | zero => exact Nat.zero_le _
    | succ k =>
      have : k + 1 ≤ (k + 1) * (k + 1) := Nat.le_mul_of_pos_right _ (Nat.succ_pos _)
      omega
  · cases y with
    | zero => exact Nat.zero_le _
    | succ k =>
      have : k + 1 ≤ (k + 1) * (2 * (k + 1) + 1) := Nat.le_mul_of_pos_right _ (by omega)
      omega
  · cases z with
    | zero => exact Nat.zero_le _
    | succ k =>
      have hle : k + 1 ≤ (k + 1) * (k + 2) / 2 := by
        have hmul : (k + 1) * 2 ≤ (k + 1) * (k + 2) := Nat.mul_le_mul_left _ (by omega)
        have hdiv := Nat.div_le_div_right hmul (c := 2)
        simpa [Nat.mul_div_right] using hdiv
      exact hle.trans hz2

lemma finite_reps (n : ℕ) :
    Finite { p : ℕ × ℕ × ℕ //
      let (x, y, z) := p
      x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
      (Nat.Prime z ∨ Nat.Prime (z + 1)) } := by
  refine Finite.of_injective
    (fun p : { p : ℕ × ℕ × ℕ //
        let (x, y, z) := p
        x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
        (Nat.Prime z ∨ Nat.Prime (z + 1)) } =>
      (⟨p.1.1, ?hx⟩, ⟨p.1.2.1, ?hy⟩, ⟨p.1.2.2, ?hz⟩) :
        _ → Fin (n + 1) × Fin (n + 1) × Fin (n + 1)) ?hinj
  case hx =>
    exact Nat.lt_succ_of_le (xyz_le_of_rep n p.1.1 p.1.2.1 p.1.2.2 (by simpa [IsA264025Rep] using p.2)).1
  case hy =>
    exact Nat.lt_succ_of_le (xyz_le_of_rep n p.1.1 p.1.2.1 p.1.2.2 (by simpa [IsA264025Rep] using p.2)).2.1
  case hz =>
    exact Nat.lt_succ_of_le (xyz_le_of_rep n p.1.1 p.1.2.1 p.1.2.2 (by simpa [IsA264025Rep] using p.2)).2.2
  case hinj =>
    intro p q hpq
    apply Subtype.ext
    have hx : p.1.1 = q.1.1 := by
      simpa using congrArg (fun t : Fin (n + 1) × Fin (n + 1) × Fin (n + 1) => t.1.val) hpq
    have hy : p.1.2.1 = q.1.2.1 := by
      simpa using congrArg (fun t : Fin (n + 1) × Fin (n + 1) × Fin (n + 1) => t.2.1.val) hpq
    have hz : p.1.2.2 = q.1.2.2 := by
      simpa using congrArg (fun t : Fin (n + 1) × Fin (n + 1) × Fin (n + 1) => t.2.2.val) hpq
    ext <;> simp [hx, hy, hz]

lemma A264025_pos_of_rep {n x y z : ℕ} (h : IsA264025Rep n x y z) :
    0 < A264025 n := by
  haveI := finite_reps n
  have : Nonempty { p : ℕ × ℕ × ℕ //
      let (x, y, z) := p
      x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n ∧
      (Nat.Prime z ∨ Nat.Prime (z + 1)) } := ⟨⟨(x, y, z), h⟩⟩
  exact Nat.card_pos

lemma A264025_ne_one_of_two {n x₁ y₁ z₁ x₂ y₂ z₂ : ℕ}
    (h1 : IsA264025Rep n x₁ y₁ z₁) (h2 : IsA264025Rep n x₂ y₂ z₂)
    (hne : (x₁, y₁, z₁) ≠ (x₂, y₂, z₂)) :
    A264025 n ≠ 1 := by
  haveI := finite_reps n
  intro hc
  obtain ⟨p, hp⟩ := Nat.card_eq_one_iff_exists.mp hc
  have h1' := hp ⟨(x₁, y₁, z₁), h1⟩
  have h2' := hp ⟨(x₂, y₂, z₂), h2⟩
  have : (x₁, y₁, z₁) = (x₂, y₂, z₂) := by
    simpa using congrArg Subtype.val (h1'.trans h2'.symm)
  exact hne this

def triplesOf (n xm ym zm : ℕ) : Finset (ℕ × ℕ × ℕ) :=
  (Finset.range xm).biUnion fun x =>
    (Finset.range ym).biUnion fun y =>
      ((Finset.range zm).filter (fun z => isRep n x y z)).image fun z => (x, y, z)

lemma mem_triplesOf_of_lt {n xm ym zm x y z : ℕ}
    (hx : x < xm) (hy : y < ym) (hz : z < zm) :
    (x, y, z) ∈ triplesOf n xm ym zm ↔ IsA264025Rep n x y z := by
  simp [triplesOf, mem_biUnion, mem_image, mem_filter, mem_range, isRep_iff, hx, hy, hz]

lemma of_mem_triplesOf {n xm ym zm : ℕ} {t : ℕ × ℕ × ℕ}
    (h : t ∈ triplesOf n xm ym zm) :
    IsA264025Rep n t.1 t.2.1 t.2.2 ∧ t.1 < xm ∧ t.2.1 < ym ∧ t.2.2 < zm := by
  simp [triplesOf, mem_biUnion, mem_image, mem_filter, mem_range, isRep_iff] at h
  obtain ⟨x, hx, y, hy, z, hzh, rfl⟩ := h
  exact ⟨hzh.2, hx, hy, hzh.1⟩

lemma A264025_eq_triples {n xm ym zm : ℕ}
    (H : ∀ x y z, IsA264025Rep n x y z → x < xm ∧ y < ym ∧ z < zm) :
    A264025 n = (triplesOf n xm ym zm).card := by
  let α := { p : ℕ × ℕ × ℕ //
      p.1 ^ 2 + p.2.1 * (2 * p.2.1 + 1) + p.2.2 * (p.2.2 + 1) / 2 = n ∧
      (Nat.Prime p.2.2 ∨ Nat.Prime (p.2.2 + 1)) }
  let β := { t : ℕ × ℕ × ℕ // t ∈ triplesOf n xm ym zm }
  have e : α ≃ β :=
  { toFun := fun p =>
      ⟨p.1, by
        have h : IsA264025Rep n p.1.1 p.1.2.1 p.1.2.2 := p.2
        have ⟨hx, hy, hz⟩ := H p.1.1 p.1.2.1 p.1.2.2 h
        exact (mem_triplesOf_of_lt hx hy hz).2 h⟩
    invFun := fun t =>
      ⟨t.1, (of_mem_triplesOf t.2).1⟩
    left_inv := fun p => rfl
    right_inv := fun t => rfl }
  change Nat.card α = (triplesOf n xm ym zm).card
  rw [Nat.card_congr e, Nat.card_eq_fintype_card]
  exact Fintype.card_coe (triplesOf n xm ym zm)

lemma pow2_le_imp {a b : ℕ} (h : a * a ≤ b) {k : ℕ} (hk : k * k > b) : a < k := by
  by_contra h'
  have : k ≤ a := Nat.not_lt.mp h'
  have : k * k ≤ a * a := Nat.mul_le_mul this this
  omega

lemma y_bound_of_le {n y : ℕ} (hy : y * (2 * y + 1) ≤ n) {k : ℕ}
    (hk : k * (2 * k + 1) > n) : y < k := by
  by_contra h'
  have : k ≤ y := Nat.not_lt.mp h'
  have : k * (2 * k + 1) ≤ y * (2 * y + 1) := Nat.mul_le_mul this (by omega)
  omega

lemma z_bound_of_le {n z : ℕ} (hz : z * (z + 1) / 2 ≤ n) {k : ℕ}
    (hk : k * (k + 1) / 2 > n) : z < k := by
  by_contra h'
  have : k ≤ z := Nat.not_lt.mp h'
  have hmul : k * (k + 1) ≤ z * (z + 1) := Nat.mul_le_mul this (by omega)
  have : k * (k + 1) / 2 ≤ z * (z + 1) / 2 := Nat.div_le_div_right hmul
  omega

lemma bounds_of_rep (n x y z : ℕ) (h : IsA264025Rep n x y z) :
    x < n.sqrt + 1 ∧ y < n.sqrt + 1 ∧ z < 2 * n.sqrt + 3 := by
  have ⟨hx, hy, hz⟩ := le_parts n x y z h
  refine ⟨?hx, ?hy, ?hz⟩
  · exact Nat.lt_succ_of_le (Nat.le_sqrt.mpr (by simpa [pow_two] using hx))
  · have hsq : y ≤ n.sqrt := by
      by_contra h'
      have yle : n.sqrt + 1 ≤ y := Nat.succ_le_of_lt (Nat.not_le.mp h')
      have h1 : (n.sqrt + 1) * (2 * (n.sqrt + 1) + 1) ≤ y * (2 * y + 1) :=
        Nat.mul_le_mul yle (by omega)
      have hn : n < (n.sqrt + 1) * (n.sqrt + 1) := Nat.lt_succ_sqrt n
      have : (n.sqrt + 1) * (n.sqrt + 1) ≤ (n.sqrt + 1) * (2 * (n.sqrt + 1) + 1) := by
        apply Nat.mul_le_mul_left
        omega
      omega
    omega
  · by_contra h'
    have hz' : 2 * n.sqrt + 3 ≤ z := Nat.not_lt.mp h'
    have hmul : (2 * n.sqrt + 3) * (2 * n.sqrt + 4) ≤ z * (z + 1) :=
      Nat.mul_le_mul hz' (by omega)
    have hdiv : (2 * n.sqrt + 3) * (2 * n.sqrt + 4) / 2 ≤ z * (z + 1) / 2 :=
      Nat.div_le_div_right hmul
    have hn : n < (n.sqrt + 1) ^ 2 := Nat.lt_succ_sqrt' n
    have hcmp : (n.sqrt + 1) ^ 2 ≤ (2 * n.sqrt + 3) * (2 * n.sqrt + 4) / 2 := by
      have : (n.sqrt + 1) ^ 2 * 2 ≤ (2 * n.sqrt + 3) * (2 * n.sqrt + 4) := by
        nlinarith
      exact (Nat.le_div_iff_mul_le (by decide : 0 < 2)).mpr this
    omega

lemma A264025_eq_triples_sqrt (n : ℕ) :
    A264025 n = (triplesOf n (n.sqrt + 1) (n.sqrt + 1) (2 * n.sqrt + 3)).card :=
  A264025_eq_triples (fun x y z h => bounds_of_rep n x y z h)

lemma A264025_zero : A264025 0 ≠ 1 := by
  haveI := finite_reps 0
  intro h
  obtain ⟨p, hp⟩ := Nat.card_eq_one_iff_exists.mp h
  have hr : IsA264025Rep 0 p.1.1 p.1.2.1 p.1.2.2 := by simpa [IsA264025Rep] using p.2
  have ⟨hx, hy, hz⟩ := xyz_le_of_rep 0 p.1.1 p.1.2.1 p.1.2.2 hr
  have hz0 : p.1.2.2 = 0 := by omega
  cases hr.2 with
  | inl hp => exact Nat.not_prime_zero (hz0 ▸ hp)
  | inr hp =>
    have : p.1.2.2 + 1 = 1 := by omega
    exact Nat.not_prime_one (this ▸ hp)

/-! Uniqueness of the twelve special values. -/

lemma bounds_num {n x y z xm ym zm : ℕ} (h : IsA264025Rep n x y z)
    (hx : xm * xm > n) (hy : ym * (2 * ym + 1) > n) (hz : zm * (zm + 1) / 2 > n) :
    x < xm ∧ y < ym ∧ z < zm := by
  have ⟨h1, h2, h3⟩ := le_parts n x y z h
  exact ⟨pow2_le_imp h1 hx, y_bound_of_le h2 hy, z_bound_of_le h3 hz⟩

