  by_cases hident8 : p₂ ^ 2 + p₂ + 1 ≤ n ∧ IsSquare (n - (p₂ ^ 2 + p₂ + 1))
  · exact exists_rep_of_sq_add_prime_sq_add_prime_succ_of_le hp₂_prime hp₂_ne2 hident8.1 hident8.2
  -- A third Bertrand prime near √(2n).
  have h2pos : 0 < (2 * n).sqrt := Nat.sqrt_pos.mpr (by omega)
  obtain ⟨p₃, hp₃_prime, hp₃_gt, hp₃_le⟩ :=
    Nat.exists_prime_lt_and_le_two_mul (2 * n).sqrt (ne_of_gt h2pos)
