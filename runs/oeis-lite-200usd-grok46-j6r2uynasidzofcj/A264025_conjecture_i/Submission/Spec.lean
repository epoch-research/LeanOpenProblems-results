lemma A264025_pos_of_gt_1500 {n : ℕ} (h : 1500 < n) : 0 < A264025 n := by
  obtain ⟨x, y, z, hx⟩ := exists_rep_of_gt_1500 h
  exact A264025_pos_of_rep hx

lemma two_reps_of_inS_ne {n x y z z' : ℕ}
    (hr : IsA264025Rep n x y z)
    (hz' : Nat.Prime z' ∨ Nat.Prime (z' + 1))
    (hle : z' * (z' + 1) / 2 ≤ n)
    (hS : InS (n - z' * (z' + 1) / 2))
    (hne : z ≠ z') :
    ∃ x₁ y₁ z₁ x₂ y₂ z₂,
      IsA264025Rep n x₁ y₁ z₁ ∧ IsA264025Rep n x₂ y₂ z₂ ∧
      (x₁, y₁, z₁) ≠ (x₂, y₂, z₂) := by
  obtain ⟨x', y', hrep'⟩ := exists_rep_of_inS hz' hle hS
  refine ⟨x, y, z, x', y', z', hr, hrep', ?_⟩
  intro hEq
  exact hne (congrArg (fun t : ℕ × ℕ × ℕ => t.2.2) hEq)

