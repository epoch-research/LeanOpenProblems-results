lemma A264025_ne_one_of_gt_1500 {n : ℕ} (h : 1500 < n) : A264025 n ≠ 1 := by
  obtain ⟨x₁, y₁, z₁, x₂, y₂, z₂, h1, h2, hne⟩ := exists_two_reps_of_gt_1500 h
  exact A264025_ne_one_of_two h1 h2 hne

theorem A264025_conjecture_i :
  (∀ (n : ℕ), n > 0 → A264025 n > 0) ∧
  (∀ (n : ℕ), A264025 n = 1 ↔ n ∈ ({1, 2, 3, 8, 9, 23, 30, 44, 48, 198, 219, 1344} : Finset ℕ)) := by
  constructor
  · intro n hn
    rcases le_or_gt n 1500 with hle | hgt
    · exact A264025_pos_of_le_1500 hn hle
    · exact A264025_pos_of_gt_1500 hgt
  · intro n
    constructor
    · intro hcard
      by_contra hsp
      rcases le_or_gt n 1500 with hle | hgt
      · exact A264025_ne_one_of_le_1500_not_special hle hsp hcard
      · exact A264025_ne_one_of_gt_1500 hgt hcard
    · exact A264025_of_mem_specials
