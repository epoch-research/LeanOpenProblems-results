      simpa [Finset.mem_insert, Finset.mem_singleton] using hsp
  obtain ⟨t, ht, ht1⟩ := List.mem_map.mp hmem
  have hall := (List.all_eq_true.mp twoAll_ok) t ht
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hall
  obtain ⟨⟨h1, h2⟩, hne⟩ := hall
  rw [ht1] at h1 h2
  exact A264025_ne_one_of_two ((isRep_iff _ _ _ _).1 h1) ((isRep_iff _ _ _ _).1 h2) hne

/-! ### Conversion between representations and the form A² + B² + 8C² -/

lemma eight_mul_add_two_of_rep {n x y z : ℕ}
    (h : x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n) :
    (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * x ^ 2 = 8 * n + 2 := by
  have hz : 2 ∣ z * (z + 1) := even_iff_two_dvd.mp (Nat.even_mul_succ_self z)
  have hdiv : 2 * (z * (z + 1) / 2) = z * (z + 1) := Nat.mul_div_cancel' hz
  have hz' : 4 * z * (z + 1) = 8 * (z * (z + 1) / 2) := by
    calc
      4 * z * (z + 1) = 4 * (z * (z + 1)) := by ring
      _ = 4 * (2 * (z * (z + 1) / 2)) := by rw [hdiv]
      _ = 8 * (z * (z + 1) / 2) := by ring
  have lhs :
      (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * x ^ 2
        = 8 * x ^ 2 + 8 * (y * (2 * y + 1)) + 4 * z * (z + 1) + 2 := by ring
  rw [lhs, hz']
  have : 8 * x ^ 2 + 8 * (y * (2 * y + 1)) + 8 * (z * (z + 1) / 2) + 2
      = 8 * (x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2) + 2 := by ring
  rw [this, h]

lemma eq_of_eight_mul_add_two {n x y z : ℕ}
    (h : (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * x ^ 2 = 8 * n + 2) :
    x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2 = n := by
  have hz : 2 ∣ z * (z + 1) := even_iff_two_dvd.mp (Nat.even_mul_succ_self z)
  have hdiv : 2 * (z * (z + 1) / 2) = z * (z + 1) := Nat.mul_div_cancel' hz
  have hz' : 4 * z * (z + 1) = 8 * (z * (z + 1) / 2) := by
    calc
      4 * z * (z + 1) = 4 * (z * (z + 1)) := by ring
      _ = 4 * (2 * (z * (z + 1) / 2)) := by rw [hdiv]
      _ = 8 * (z * (z + 1) / 2) := by ring
  have lhs :
      (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * x ^ 2
        = 8 * (x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2) + 2 := by
    have : (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * x ^ 2
        = 8 * x ^ 2 + 8 * (y * (2 * y + 1)) + 4 * z * (z + 1) + 2 := by ring
    rw [this, hz']; ring
  have h8 : 8 * (x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2) + 2 = 8 * n + 2 := by
    rw [← lhs, h]
  have : 8 * (x ^ 2 + y * (2 * y + 1) + z * (z + 1) / 2) = 8 * n := by omega
  exact Nat.eq_of_mul_eq_mul_left (by decide : 0 < 8) this

lemma isRep_of_form {n x y z : ℕ}
    (h : (4 * y + 1) ^ 2 + (2 * z + 1) ^ 2 + 8 * x ^ 2 = 8 * n + 2)
    (hp : Nat.Prime z ∨ Nat.Prime (z + 1)) :
    IsA264025Rep n x y z :=
  ⟨eq_of_eight_mul_add_two h, hp⟩

/-- `m` lies in the companion set `S` when `m = x² + y(2y+1)`. -/
def InS (m : ℕ) : Prop := ∃ x y : ℕ, x ^ 2 + y * (2 * y + 1) = m

lemma inS_sq (x : ℕ) : InS (x ^ 2) := ⟨x, 0, by ring⟩
lemma inS_zero : InS 0 := ⟨0, 0, by simp⟩
lemma inS_one : InS 1 := ⟨1, 0, by simp⟩
lemma inS_three : InS 3 := ⟨0, 1, by simp⟩
lemma inS_four : InS 4 := ⟨2, 0, by simp⟩

lemma eight_form_of_inS {m x y : ℕ} (h : x ^ 2 + y * (2 * y + 1) = m) :
    (4 * y + 1) ^ 2 + 8 * x ^ 2 = 8 * m + 1 := by
  calc
    (4 * y + 1) ^ 2 + 8 * x ^ 2 = 16 * y ^ 2 + 8 * y + 1 + 8 * x ^ 2 := by ring
    _ = 8 * (x ^ 2 + y * (2 * y + 1)) + 1 := by ring
    _ = 8 * m + 1 := by rw [h]

lemma inS_of_eight_form {m a b : ℕ} (ha : a % 4 = 1)
    (h : a ^ 2 + 8 * b ^ 2 = 8 * m + 1) : InS m := by
  have ⟨y, hy⟩ : ∃ y, a = 4 * y + 1 := ⟨a / 4, by omega⟩
  refine ⟨b, y, ?_⟩
  have hz : (4 * y + 1) ^ 2 + 8 * b ^ 2 = 8 * (b ^ 2 + y * (2 * y + 1)) + 1 := by ring
  have : 8 * (b ^ 2 + y * (2 * y + 1)) + 1 = 8 * m + 1 := by
    rw [← hz, ← hy, h]
  have : 8 * (b ^ 2 + y * (2 * y + 1)) = 8 * m := by omega
  exact Nat.eq_of_mul_eq_mul_left (by decide : 0 < 8) this

lemma exists_rep_of_inS {n z : ℕ}
    (hz : Nat.Prime z ∨ Nat.Prime (z + 1))
    (hle : z * (z + 1) / 2 ≤ n)
    (h : InS (n - z * (z + 1) / 2)) :
    ∃ x y, IsA264025Rep n x y z := by
  obtain ⟨x, y, hxy⟩ := h
  refine ⟨x, y, ⟨?_, hz⟩⟩
  omega

lemma exists_rep_z_one {n : ℕ} (hn : 1 ≤ n) (h : InS (n - 1)) :
    ∃ x y z, IsA264025Rep n x y z := by
  obtain ⟨x, y, hrep⟩ := exists_rep_of_inS (z := 1) (Or.inr Nat.prime_two) (by simp) h
  exact ⟨x, y, 1, hrep⟩

